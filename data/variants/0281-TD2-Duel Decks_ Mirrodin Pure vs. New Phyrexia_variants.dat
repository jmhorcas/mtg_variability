type: ['Artifact', 'Artifact Creature — Angel', 'Artifact Creature — Construct', 'Artifact Creature — Gargoyle', 'Artifact Creature — Golem', 'Artifact Creature — Myr', 'Artifact Creature — Phyrexian Juggernaut', 'Artifact Creature — Phyrexian Myr', 'Artifact Creature — Shapeshifter', 'Artifact Creature — Wall', 'Artifact Land', 'Artifact — Equipment', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Beast', 'Creature — Elemental', 'Creature — Elemental Shaman', 'Creature — Elf', 'Creature — Elk', 'Creature — Human Soldier', 'Creature — Human Wizard', 'Creature — Ooze', 'Creature — Phyrexian Beast', 'Creature — Phyrexian Carrier', 'Creature — Phyrexian Elf Scout', 'Creature — Phyrexian Elf Shaman', 'Creature — Phyrexian Horror', 'Creature — Phyrexian Imp', 'Creature — Phyrexian Wolf', 'Creature — Phyrexian Zombie', 'Creature — Serpent', 'Creature — Sphinx', 'Creature — Vedalken Artificer', 'Creature — Vedalken Wizard', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Sorcery']
