rulings: ['[{\'date\': \'2004-10-04\', \'text\': "If the spell is not countered (because the spell it targets can\'t be countered), then it does not get exiled."}, {\'date\': \'2004-10-04\', \'text\': \'The card does not go to the graveyard before being exiled.\'}]', "[{'date': '2004-10-04', 'text': 'Aura of Silence affects all opponents in a multiplayer game.'}]", "[{'date': '2004-10-04', 'text': 'Cost reducers can be used to reduce the X part of the mana cost.'}, {'date': '2004-10-04', 'text': 'You may gain up to the total toughness of the creature even if it was already damaged.'}]", "[{'date': '2016-06-08', 'text': 'Once Mogg Fanatic has dealt and been dealt combat damage, it’s too late to activate its ability before it’s destroyed.'}]", "[{'date': '2021-03-19', 'text': 'If an attacking creature has multiple evasion abilities, such as shadow and flying, a creature can block it only if that creature satisfies all of the appropriate evasion abilities.'}, {'date': '2021-03-19', 'text': 'Multiple instances of shadow on the same creature are redundant.'}, {'date': '2021-03-19', 'text': 'Once a creature has been blocked, that creature remains blocked and will deal and be dealt combat damage even if it gains or loses shadow or if the blocking creature gains or loses shadow.'}]"]
