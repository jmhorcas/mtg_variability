name: ['Batterskull', 'Call of the Herd', 'Chrome Mox', 'Griselbrand', 'Maelstrom Pulse', 'Mutavault', 'Progenitus', 'Spiritmonger', 'Stoneforge Mystic', "Umezawa's Jitte"]
