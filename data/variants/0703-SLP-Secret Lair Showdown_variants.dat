name: ["An Offer You Can't Refuse", 'Brainstorm', 'Dark Ritual', "Death's Shadow", 'Dragonlord Silumgar', 'Eldritch Evolution', 'Explore', 'Expressive Iteration', 'Fatal Push', 'Goblin Guide', 'Murktide Regent', 'Ponder', 'Ragavan, Nimble Pilferer', 'Relentless Rats', 'Seasoned Pyromancer', 'Spell Pierce', 'Springleaf Drum', 'Swords to Plowshares', 'Ugin, the Spirit Dragon', 'Unholy Heat', 'Valakut, the Molten Pinnacle', 'Wrenn and Six']
multiverse_id: []
layout: ['normal']
names: []
mana_cost: ['{1}', '{1}{B}{B}', '{1}{G}', '{1}{G}{G}', '{1}{R}{R}', '{4}{U}{B}', '{5}{U}{U}', '{8}', '{B}', '{R}', '{R}{G}', '{U}', '{U}{R}', '{W}']
cmc: ['0.0', '1.0', '2.0', '3.0', '6.0', '7.0', '8.0']
colors: ['B', 'G', 'R', 'U', 'W']
