vor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288152&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '715e92d7-08f1-4e13-89c6-82ba910cfdc5', 'multiverseId': 288152}, 'multiverseid': 288152}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287840&type=card', 'language': 'French', 'identifiers': {'scryfallId': '543e802b-752f-40df-a199-55a9d549f3fb', 'multiverseId': 287840}, 'multiverseid': 287840}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288308&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ba11fe12-ecde-4256-98bb-55c299fd91e9', 'multiverseId': 288308}, 'multiverseid': 288308}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288464&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '49f41b77-22d4-4151-8f50-24f4407807d3', 'multiverseId': 288464}, 'multiverseid': 288464}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287997&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b96ae2ce-10e2-464b-972c-7176d40f3539', 'multiverseId': 287997}, 'multiverseid': 287997}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288153&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '993bb682-25b3-44da-9be3-445af1e8ae74', 'multiverseId': 288153}, 'multiverseid': 288153}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287841&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6834728f-8927-4792-b540-5fe4f370ca5d', 'multiverseId': 287841}, 'multiverseid': 287841}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288309&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cd0efee0-6fcd-4bcd-b279-492cfc84ca11', 'multiverseId': 288309}, 'multiverseid': 288309}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288465&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b3bb3add-54f1-46fb-ba20-2fb84dff9cbb', 'multiverseId': 288465}, 'multiverseid': 288465}]", '[{\'name\': \'Wandernder Sceada\', \'text\': \'Fliegend\\nWenn der Wandernde Sceada ins Spiel kommt, enttappe bis zu fünf Länder.\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Dass sich die Nebel von Tolaria teilten, um die Sceadas durchzulassen, war eigentlich Warnung genug.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287922&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52c2ae3c-5126-4885-b3be-baab05f8309c\', \'multiverseId\': 287922}, \'multiverseid\': 287922}, {\'name\': \'Draco peregrino\', \'text\': \'Vuela.\\nCuando el Draco peregrino entre al campo de batalla, endereza hasta cinco tierras.\', \'type\': \'Criatura — Draco\', \'flavor\': \'Que las nieblas tolarianas abrieran paso a los dracos era suficiente aviso para mantenerse alejados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288078&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2253e391-de49-43ff-adad-5f432c816abf\', \'multiverseId\': 288078}, \'multiverseid\': 288078}, {\'name\': \'Drakôn pèlerin\', \'text\': "Vol\\nQuand le Drakôn pèlerin arrive sur le champ de bataille, dégagez jusqu\'à cinq terrains.", \'type\': \'Créature : drakôn\', \'flavor\': \'Même les brumes de Tolaria se levaient pour laisser passer les drakôns.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1be97300-bd3f-4f5a-84ff-8af4bed2fe6e\', \'multiverseId\': 287766}, \'multiverseid\': 287766}, {\'name\': \'Draghetto Pellegrino\', \'text\': \'Volare\\nQuando il Draghetto Pellegrino entra nel campo di battaglia, STAPpa fino a cinque terre.\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'Che le nebbie di Tolaria si fossero dissipate per i draghetti era un chiaro avvertimento di stare alla larga.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288234&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ca523a9-653f-4ab1-a2c9-5f1f58d1ee41\', \'multiverseId\': 288234}, \'multiverseid\': 288234}, {\'name\': \'流浪のドレイク\', \'text\': \'飛行\\n流浪のドレイクが戦場に出たとき、土地を最大５枚までアンタップする。\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'ドレイクのためにできたトレイリアの霞の切れ目は、、近づくなという明らかな警告になった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288390&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3be81718-0f8f-4739-9aa1-a65bcd477fdf\', \'multiverseId\': 288390}, \'multiverseid\': 288390}]', "[{'name': 'Wasserwirbelkrieger', 'text': 'Wenn der Wasserwirbelkrieger ins Spiel kommt, mische die Karten aus deiner Hand in deine Bibliothek und ziehe dann entsprechend viele Karten.\\n{R}, opfere den Wasserwirbelkrieger: Jeder Spieler mischt die Karten aus seiner Hand in seine Bibliothek und zieht dann entsprechend viele Karten.', 'type': 'Kreatur — Meervolk, Krieger', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287900&type=card', 'language': 'German', 'identifiers': {'scryfallId': '74c17060-761d-4a0e-bec1-6f6e3e3652bd', 'multiverseId': 287900}, 'multiverseid': 287900}, {'name': 'Guerrera Remolino', 'text': 'Cuando la Guerrera Remolino entre al campo de batalla, baraja las cartas de tu mano en tu biblioteca, luego roba ese mismo número de cartas.\\n{R}, sacrificar la Guerrera Remolino: Cada jugador baraja las cartas de su mano en su biblioteca, luego roba ese mismo número de cartas.', 'type': 'Criatura — Guerrero tritón', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288056&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f95c58b3-7c32-42fa-89ae-ff32914a6c4b', 'multiverseId': 288056}, 'multiverseid': 288056}, {'name': 'Guerrière des tourbillons', 'text': 'Quand la Guerrière des tourbillons arrive sur le champ de bataille, mélangez les cartes de votre main dans votre bibliothèque, puis piochez autant de cartes.\\n{R}, sacrifiez la Guerrière des tourbillons : Chaque joueur mélange les cartes de sa main dans sa bibliothèque, puis pioche autant de cartes.', 'type': 'Créature : ondin et guerrier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287744&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0646367a-5e14-40cc-946b-d9c3f89bbf6d', 'multiverseId': 287744}, 'multiverseid': 287744}, {'name': 'Guerriero dei Vortici', 'text': 'Quando il Guerriero dei Vortici entra nel campo di battaglia, rimescola nel tuo grimorio le carte della tua mano, poi pesca altrettante carte.\\n{R}, Sacrifica il Guerriero dei Vortici: Ogni giocatore rimescola le carte della propria mano nel proprio grimorio, poi pesca altrettante carte.', 'type': 'Creatura — Guerriero Tritone', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288212&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '68caac1f-6183-4599-885b-22c253e5b312', 'multiverseId': 288212}, 'multiverseid': 288212}, {'name': '渦巻き戦士', 'text': '渦巻き戦士が戦場に出たとき、あなたの手札のカードをあなたのライブラリーに加えて切り直し、その後、その枚数のカードを引く。{R}, 渦巻き戦士を生け贄に捧げる：各プレイヤーは、自分の手札のカードを自分のライブラリーに加えて切り直し、その後、その枚数のカードを引く。', 'type': 'クリーチャー — マーフォーク・戦士', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288368&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '07004b87-d05d-4331-8fee-397a45b0d116', 'multiverseId': 288368}, 'multiverseid': 288368}]", '[{\'name\': \'Weissagungseule\', \'text\': \'Fliegend\\nWenn die Weissagungseule ins Spiel kommt, Hellsicht 3. (Betrachte für Hellsicht 3 die obersten drei Karten deiner Bibliothek und lege dann eine beliebige Anzahl davon unter deine Bibliothek und den Rest in beliebiger Reihenfolge oben darauf.)\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287924&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bbb08dce-cf2a-40ab-88e8-26a44eb51ba0\', \'multiverseId\': 287924}, \'multiverseid\': 287924}, {\'name\': \'Búho del augurio\', \'text\': \'Vuela.\\nCuando el Búho del augurio entre al campo de batalla, adivina 3. (Para adivinar 3, mira las tres primeras cartas de tu biblioteca, luego pon cualquier número de ellas en la parte inferior de tu biblioteca y el resto en la parte superior en cualquier orden.)\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288080&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ad58db5-432b-45d8-9c26-e8b3efc53f38\', \'multiverseId\': 288080}, \'multiverseid\': 288080}, {\'name\': "Hibou de l\'augure", \'text\': "Vol\\nQuand le Hibou de l\'augure arrive sur le champ de bataille, regard 3. (Pour appliquer regard 3, regardez les trois cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles au-dessous de votre bibliothèque et le reste, au-dessus, dans n\'importe quel ordre.)", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44457c06-2ffb-4e24-a1ba-e1d995c270f7\', \'multiverseId\': 287768}, \'multiverseid\': 287768}, {\'name\': \'Gufo dei Presagi\', \'text\': \'Volare\\nQuando il Gufo dei Presagi entra nel campo di battaglia, profetizzare 3. (Per profetizzare 3, guarda le prime tre carte del tuo grimorio, poi mettine un qualsiasi numero in fondo al tuo grimorio e le altre in cima in qualsiasi ordine.)\', \'type\': \'Creatura — Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288236&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'808b4ce3-96d6-4c6b-8d93-fa7113212811\', \'multiverseId\': 288236}, \'multiverseid\': 288236}, {\'name\': \'占いフクロウ\', \'text\': \'飛行\\n占いフクロウが戦場に出たとき、占術３を行う。 （占術３を行うには、あなたのライブラリーの一番上から３枚のカードを見て、そのうちの望む枚数のカードをあなたのライブラリーの一番下に置き、残りを望む順番で一番上に置く。）\', \'type\': \'クリーチャー — 鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'551abf0e-1356-4659-80e2-461fe60dcfaa\', \'multiverseId\': 288392}, \'multiverseid\': 288392}]', '[{\'name\': \'Wünschelruten-Schamane\', \'text\': \'{2}{G}, {T}: Bringe eine Verzauberungskarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Zentaur, Schamane\', \'flavor\': \'Er durchkämmt die Straßen auf der Suche nach dem verlorenen Licht, den verloren gegangenen Rätseln der Stadt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4622b9c5-5f72-471e-9e85-71fccee1205b\', \'multiverseId\': 287940}, \'multiverseid\': 287940}, {\'name\': \'Chamán rabdomante\', \'text\': \'{2}{G}, {T}: Regresa la carta de encantamiento objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Chamán centauro\', \'flavor\': \'Escudriña las calles buscando la luz perdida, los enigmas abandonados de la ciudad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288096&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3293ee22-b129-47d3-8065-f0af9c36b88a\', \'multiverseId\': 288096}, \'multiverseid\': 288096}, {\'name\': \'Shamane sourcier\', \'text\': "{2}{G}, {T} : Renvoyez la carte d\'enchantement ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : centaure et shamane\', \'flavor\': \'Il parcourt les rues en quête de lumière perdue et des énigmes oubliées de la cité.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7097496-5cd5-468b-8c2c-ce2f03d91f60\', \'multiverseId\': 287784}, \'multiverseid\': 287784}, {\'name\': \'Sciamano Rabdomante\', \'text\': \'{2}{G}, {T}: Riprendi in mano una carta incantesimo bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Sciamano Centauro\', \'flavor\': "Perlustra le strade alla ricerca della luce perduta, l\'enigma abbandonato della città.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288252&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a129227-6375-4c7f-92f7-7af7b55c38c1\', \'multiverseId\': 288252}, \'multiverseid\': 288252}, {\'name\': \'占い棒使いのシャーマン\', \'text\': \'{2}{G}, {T}：あなたの墓地にあるエンチャント・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — ケンタウルス・シャーマン\', \'flavor\': \'彼は道々の失われた光を探し続けている。それは打ち捨てられた都市の謎なのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288408&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'039ee528-c951-4550-ac14-b0f1f9b16e09\', \'multiverseId\': 288408}, \'multiverseid\': 288408}]', '[{\'name\': \'Zeichen der Meuterei\', \'text\': \'Übernimm die Kontrolle über eine Kreatur deiner Wahl bis zum Ende des Zuges. Lege eine +1/+1-Marke auf sie und enttappe sie. Diese Kreatur erhält Eile bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Die Flammen der Wut sind schwer zu löschen, sobald sie sich erst einmal entzündet haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287872&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e470386-cf1b-4b9b-9685-6bb6c03624e4\', \'multiverseId\': 287872}, \'multiverseid\': 287872}, {\'name\': \'Marca de sedición\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Pon un contador +1/+1 sobre ella y enderézala. Esa criatura gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'Las llamas de la ira son difíciles de apagar una vez encendidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288028&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc3efb0f-0e15-42fa-98e8-2d956ad5a69d\', \'multiverseId\': 288028}, \'multiverseid\': 288028}, {\'name\': \'Marque de mutinerie\', \'text\': "Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Mettez un marqueur +1/+1 sur elle et dégagez-la. Cette créature acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'La flamme de la colère est difficile à étouffer une fois allumée.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287716&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bab9285e-b6bf-4abf-846b-59117c3ff2ba\', \'multiverseId\': 287716}, \'multiverseid\': 287716}, {\'name\': "Marchio dell\'Ammutinamento", \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. Metti un segnalino +1/+1 su di essa e STAPpala. Quella creatura ha rapidità fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': "La fiamma dell\'ira è difficile da spegnere una volta accesa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288184&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'08c764b3-6ee9-4a01-a77c-a01dcff93f7e\', \'multiverseId\': 288184}, \'multiverseid\': 288184}, {\'name\': \'反逆の印\', \'text\': \'クリーチャー１体を対象とし、ターン終了時までそれのコントロールを得る。 それの上に＋１/＋１カウンターを１個置き、それをアンタップする。 そのクリーチャーはターン終了時まで速攻を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'怒りの炎は、一度火がついたら簡単には消せない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b47ac35-8a2f-40cf-abf8-b040cf3287d2\', \'multiverseId\': 288340}, \'multiverseid\': 288340}]', '[{\'name\': \'Zischender Leguan\', \'text\': \'Immer wenn eine andere Kreatur stirbt, kannst du den Zischenden Leguan einem Spieler deiner Wahl 1 Schadenspunkt zufügen lassen.\', \'type\': \'Kreatur — Eidechse\', \'flavor\': \'Viashino-Banden halten sich Leguane als Jagdbegleiter und geben ihnen verwundete Gefangene als Spielzeug.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287895&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2037de2-a235-4d07-8a1a-0029b95f2667\', \'multiverseId\': 287895}, \'multiverseid\': 287895}, {\'name\': \'Iguanar siseante\', \'text\': \'Siempre que otra criatura muera, puedes hacer que el Iguanar siseante le haga 1 punto de daño al jugador objetivo.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'Las azotadas viashino llevan iguanares como compañeros de cacería, dándoles los cautivos heridos para que jueguen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288051&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f6b448f-7876-4721-8bc2-d56b9a0f289b\', \'multiverseId\': 288051}, \'multiverseid\': 288051}, {\'name\': \'Iguanar sifflant\', \'text\': "À chaque fois qu\'une autre créature meurt, vous pouvez faire que l\'Iguanar sifflant inflige 1 blessure au joueur ciblé.", \'type\': \'Créature : lézard\', \'flavor\': "Les rosses viashinos se servent des iguanars comme compagnons de chasse et leur donnent les blessés pour s\'amuser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287739&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88fc756d-7e45-46bf-826c-d508595f6307\', \'multiverseId\': 287739}, \'multiverseid\': 287739}, {\'name\': \'Iguanar Sibilante\', \'text\': "Ogniqualvolta un\'altra creatura muore, puoi fare infliggere dall\'Iguanar Sibilante 1 danno a un giocatore bersaglio.", \'type\': \'Creatura — Lucertola\', \'flavor\': \'Le batoste dei viashino tengono gli iguanar come compagni di caccia, dando loro prigionieri feriti come giocattoli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288207&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'641c0605-0d76-4d91-9f9b-5bf2160fc451\', \'multiverseId\': 288207}, \'multiverseid\': 288207}, {\'name\': \'風切るイグアナール\', \'text\': \'他のクリーチャーが１体死亡するたび、プレイヤー１人を対象とする。あなたは「風切るイグアナールはそのプレイヤーに１点のダメージを与える。」を選んでもよい。\', \'type\': \'クリーチャー — トカゲ\', \'flavor\': \'ヴィーアシーノの襲撃団はイグアナールを狩りの友として飼い、傷ついた獲物をおもちゃとして与えてやる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288363&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb6becf6-e522-43df-853f-f16bff9b172d\', \'multiverseId\': 288363}, \'multiverseid\': 288363}]', '[{\'name\': \'Zone des Erwachens\', \'text\': \'Zu Beginn deines Versorgungssegments kannst du einen 0/1 farblosen (Eldrazi, Ausgeburt)-Kreaturenspielstein ins Spiel bringen. Er hat „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Verzauberung\', \'flavor\': \'Der Boden erbebte im Takt mit dem Surren des Polyeders, es war wie eine Totenklage der letzten Tage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287892&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11a2d023-8651-46cf-86e7-62a7d72a8039\', \'multiverseId\': 287892}, \'multiverseid\': 287892}, {\'name\': \'Zona del despertar\', \'text\': \'Al comienzo de tu mantenimiento, puedes poner en el campo de batalla una ficha de criatura Engendro Eldrazi incolora 0/1. Tiene "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Encantamiento\', \'flavor\': \'El suelo brotó con el retumbar del edro, un canto fúnebre de los últimos días.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288048&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2693387-1164-4084-b2ae-cc21bdbc3eb7\', \'multiverseId\': 288048}, \'multiverseid\': 288048}, {\'name\': "Zone d\'éveil", \'text\': \'Au début de votre entretien, vous pouvez mettre sur le champ de bataille un jeton de créature 0/1 incolore Eldrazi et Engeance. Il a « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »\', \'type\': \'Enchantement\', \'flavor\': "Le sol se fendit au rythme des raclements de l\'Hèdron, un glas annonçant les derniers jours.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'169e6f8a-137c-4d37-a14f-57c64135271d\', \'multiverseId\': 287736}, \'multiverseid\': 287736}, {\'name\': \'Zona del Risveglio\', \'text\': \'All\\\'inizio del tuo mantenimento, puoi mettere sul campo di battaglia una pedina creatura Progenie Eldrazi 0/1 incolore. Ha "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Incantesimo\', \'flavor\': "Il suolo esplose a tempo col tamburellare dell\'edro, una nenia dei giorni passati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288204&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f48ff2e-87ea-48e9-8e23-8446dc4e6177\', \'multiverseId\': 288204}, \'multiverseid\': 288204}, {\'name\': \'目覚めの領域\', \'text\': \'あなたのアップキープの開始時に、あなたは無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを１体戦場に出してもよい。 それは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'エンチャント\', \'flavor\': \'大地は面晶体の音に答えて噴火し、最後の日の葬送曲を奏でた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288360&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d7129d2-9eeb-489b-b5cf-66531075ba62\', \'multiverseId\': 288360}, \'multiverseid\': 288360}]', '[{\'name\': \'Zuzzelzungen-Thallid\', \'text\': \'Wenn der Zuzzelzungen-Thallid stirbt, bringe einen 1/1 grünen Saproling-Kreaturenspielstein ins Spiel.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': \'Thallide in Jund versuchen zu verbergen, dass sie köstlich schmecken, indem sie sich in Stacheln hüllen, die sie vom Zuzzelzungenbaum abklauben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287880&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7717f3f7-b0e4-43dc-a832-12e221108da9\', \'multiverseId\': 287880}, \'multiverseid\': 287880}, {\'name\': \'Tálido tukatong\', \'text\': \'Cuando el Tálido tukatong muera, pon en el campo de batalla una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Hongo\', \'flavor\': \'Los tálidos de Jund tratan de disfrazar su sabor delicioso cubriéndose de espinas recolectadas del árbol tukatong.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288036&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4821313-0af2-4758-b7de-e701106df20c\', \'multiverseId\': 288036}, \'multiverseid\': 288036}, {\'name\': \'Thallidé tukalanguier\', \'text\': \'Quand le Thallidé tukalanguier meurt, mettez sur le champ de bataille un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : fongus\', \'flavor\': "Les thallidés de Jund tentèrent de dissimuler leur saveur en se recouvrant d\'épines récoltées sur le tukalanguier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287724&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a14b4bc-9709-4cee-85c7-90fe4004715e\', \'multiverseId\': 287724}, \'multiverseid\': 287724}, {\'name\': \'Thallid del Linguatuka\', \'text\': \'Quando il Thallid del Linguatuka muore, metti sul campo di battaglia una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Creatura — Fungus\', \'flavor\': \'I thallid di Jund cercarono di nascondere la loro squisitezza ricoprendosi di spine raccolte dagli alberi di linguatuka.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288192&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'935b24e3-bc69-4f36-924b-0493452d4098\', \'multiverseId\': 288192}, \'multiverseid\': 288192}, {\'name\': \'ツカタンのサリッド\', \'text\': \'ツカタンのサリッドが死亡したとき、緑の１/１の苗木・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': \'ジャンドのサリッドは、ツカタンの樹から取った棘で自らを覆うことで、自分たちが美味であることを隠そうとする。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288348&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f1227afc-8303-4fb0-9b62-6de2bcb38df9\', \'multiverseId\': 288348}, \'multiverseid\': 288348}]', '[{\'name\': \'Ältester der Donnerbande\', \'text\': \'Verschlingen 3 (Sowie diese Karte ins Spiel kommt, kannst du eine beliebige Anzahl an Kreaturen opfern. Diese Kreatur kommt mit dreimal so vielen +1/+1-Marken ins Spiel.)\', \'type\': \'Kreatur — Viashino, Krieger\', \'flavor\': \'Viashino-Banden werden von älteren Kriegern angeführt, die schon etliche Herausforderungen überlebt haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287898&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57f1befa-652d-46a5-86a6-ebb78d45cdac\', \'multiverseId\': 287898}, \'multiverseid\': 287898}, {\'name\': \'Anciano de la azotada del trueno\', \'text\': \'Devorar 3. (En cuanto esto entra al campo de batalla puedes sacrificar cualquier cantidad de criaturas. Esta criatura entra al campo de batalla con el triple de esa cantidad de contadores +1/+1 sobre ella.)\', \'type\': \'Criatura — Guerrero viashino\', \'flavor\': \'Las azotadas viashinas son lideradas por ancianos que sobrevivieron incontables desafíos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288054&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ee538377-e736-4f08-bb4c-55e15d47e6c1\', \'multiverseId\': 288054}, \'multiverseid\': 288054}, {\'name\': \'Doyen rosse-éclair\', \'text\': \'Dévorement 3 (Au moment où cette créature arrive sur le champ de bataille, vous pouvez sacrifier le nombre de créatures de votre choix. Cette créature arrive sur le champ de bataille avec trois fois ce nombre de marqueurs +1/+1 sur elle.)\', \'type\': \'Créature : viashino et guerrier\', \'flavor\': "Les rosses viashinos sont dirigés par des anciens qui ont survécu à d\'innombrables défis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287742&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f16696e7-5bb2-4696-beba-5743dfa07a53\', \'multiverseId\': 287742}, \'multiverseid\': 287742}, {\'name\': \'Anziano di Batosta Tonante\', \'text\': \'Divorare 3 (Mentre questa creatura entra nel campo di battaglia, puoi sacrificare un qualsiasi numero di creature. Entra nel campo di battaglia con il triplo di segnalini +1/+1.)\', \'type\': \'Creatura — Guerriero Viashino\', \'flavor\': \'Le batoste dei viashino sono guidate da anziani sopravvissuti a innumerevoli sfide.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288210&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b1db2bc-2d22-4309-8ce3-5421cc98c5a7\', \'multiverseId\': 288210}, \'multiverseid\': 288210}, {\'name\': \'雷団の古老\', \'text\': \'貪食 ３ （これが戦場に出るに際し、あなたは望む数のクリーチャーを生け贄に捧げてもよい。 このクリーチャーは、その数に等しい数の３倍に等しい＋１/＋１カウンターが置かれた状態で戦場に出る。）\', \'type\': \'クリーチャー — ヴィーアシーノ・戦士\', \'flavor\': \'ヴィーアシーノの襲撃団は、数多くの試練を乗り越えてきた古老に導かれている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288366&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a0797aa-0231-43d7-956c-eb986b7e973f\', \'multiverseId\': 288366}, \'multiverseid\': 288366}]', '[{\'name\': \'Ätheriumhorn-Hexer\', \'text\': \'{1}{U}{R}: Bringe den Ätheriumhorn-Hexer auf die Hand seines Besitzers zurück.\\nKaskade (Wenn du diesen Zauberspruch wirkst, schicke solange die oberste Karte deiner Bibliothek ins Exil, bis du eine Karte aufdeckst, die weniger kostet als diese und die kein Land ist. Du kannst sie wirken, ohne ihre Manakosten zu bezahlen. Lege die so ins Exil geschickten Karten in zufälliger Reihenfolge unter deine Bibliothek.)\', \'type\': \'Artefaktkreatur — Minotaurus, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287850&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f89254ee-dee1-48ba-a480-2763b1951a90\', \'multiverseId\': 287850}, \'multiverseid\': 287850}, {\'name\': \'Hechicero cuernos de eterium\', \'text\': \'{1}{U}{R}: Regresa al Hechicero cuernos de eterium a la mano de su propietario.\\nCascada. (Cuando lances este hechizo, exilia las primeras cartas de tu biblioteca hasta que exilies una carta que no sea tierra que cueste menos. Puedes lanzar esa carta sin pagar su coste de maná. Pon las cartas exiliadas en el fondo de tu biblioteca en un orden aleatorio.)\', \'type\': \'Criatura artefacto — Hechicero minotauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288006&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26c6a4f3-6581-432c-ab32-69eea6b3057b\', \'multiverseId\': 288006}, \'multiverseid\': 288006}, {\'name\': "Sorcier à cornes d\'étherium", \'text\': "{1}{U}{R} : Renvoyez le Sorcier à cornes d\'étherium dans la main de son propriétaire.\\nCascade (Quand vous lancez ce sort, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain d\'un coût inférieur. Vous pouvez la lancer sans payer son coût de mana. Mettez les cartes exilées au-dessous de la bibliothèque dans un ordre aléatoire.)", \'type\': \'Créature-artefact : minotaure et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287694&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db319287-7b7a-40b7-9b90-e265d49e3401\', \'multiverseId\': 287694}, \'multiverseid\': 287694}, {\'name\': \'Stregone Corna di Eterium\', \'text\': \'{1}{U}{R}: Fai tornare lo Stregone Corna di Eterium in mano al suo proprietario.\\nCascata (Quando lanci questa magia, esilia carte dalla cima del tuo grimorio finché non esili una carta non terra che costa meno. Puoi lanciarla senza pagare il suo costo di mana. Metti le carte esiliate in fondo al tuo grimorio in ordine casuale.)\', \'type\': \'Creatura Artefatto — Mago Minotauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288162&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d20c9a89-f4c7-4992-8e3d-95c2dc21f9c0\', \'multiverseId\': 288162}, \'multiverseid\': 288162}, {\'name\': \'エーテリウム角の魔術師\', \'text\': \'{1}{U}{R}：エーテリウム角の魔術師をオーナーの手札に戻す。\\n続唱 （あなたがこの呪文を唱えたとき、あなたのライブラリーの一番上のカードを、コストがより低い土地でないカードが追放されるまで追放する。 あなたはそれをそのマナ・コストを支払うことなく唱えてもよい。その追放したカードを、無作為の順番で一番下に置く。）\', \'type\': \'アーティファクト・クリーチャー — ミノタウルス・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288318&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2c0201e-abb5-4b3b-aa68-c3d69b89956b\', \'multiverseId\': 288318}, \'multiverseid\': 288318}]', '[{\'name\': \'Überrennen\', \'text\': \'Bis zum Ende des Zuges erhalten Kreaturen, die du kontrollierst, +3/+3 und verursachen Trampelschaden.\', \'type\': \'Hexerei\', \'flavor\': \'Die Natur geht nicht spazieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287932&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'74b6c985-634e-4a5d-a620-f0ecedf577ba\', \'multiverseId\': 287932}, \'multiverseid\': 287932}, {\'name\': \'Sobrepasar\', \'text\': \'Las criaturas que controles obtienen +3/+3 y ganan la habilidad de arrollar hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'La naturaleza no camina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288088&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97c29851-10e0-46ad-b96d-31695cd7568a\', \'multiverseId\': 288088}, \'multiverseid\': 288088}, {\'name\': \'Envahissement\', \'text\': "Les créatures que vous contrôlez gagnent +3/+3 et acquièrent le piétinement jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'« La nature ne fait pas de sauts. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=287776&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d529a49e-b061-435c-bdb8-c9318be392fc\', \'multiverseId\': 287776}, \'multiverseid\': 287776}, {\'name\': \'Sopraffare\', \'text\': \'Le creature che controlli prendono +3/+3 e hanno travolgere fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'La natura non cammina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288244&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d53b06be-ab13-4ba4-b028-9fb81a05aa53\', \'multiverseId\': 288244}, \'multiverseid\': 288244}, {\'name\': \'踏み荒らし\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで＋３/＋３の修整を受けるとともにトランプルを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'自然は歩まない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=288400&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b76d6bdd-385b-4382-b88c-96d08c16eb4e\', \'multiverseId\': 288400}, \'multiverseid\': 288400}]']
