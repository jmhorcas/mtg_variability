alian', 'identifiers': {'scryfallId': '222f6907-5f9d-430a-bd51-c3d0860f5006'}, 'multiverseid': None}, {'name': '反目', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ce691a8f-b48e-4961-8096-17520dab8275'}, 'multiverseid': None}, {'name': 'Antagonismo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '458616dc-d98b-4903-bc15-09a75e259c3c'}, 'multiverseid': None}]", "[{'name': 'Anwesenheit des Meisters', 'text': 'Immer wenn ein Spieler eine Verzauberung spricht, wird diese neutralisiert.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '76d38c66-2b4b-4a83-b8e0-6383655e389e'}, 'multiverseid': None}, {'name': 'Presencia de la señora', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f74b9ebe-140a-491a-9b92-000bd0cb3a89'}, 'multiverseid': None}, {'name': 'Présence du mentor', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c65dce4b-7fb9-4fca-b504-761cda42eb7e'}, 'multiverseid': None}, {'name': 'Presenza del Maestro', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e92a3369-1160-4c01-aa38-064749af5d0a'}, 'multiverseid': None}, {'name': '主の存在', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3a7ee58d-73aa-4ae4-9367-a3ff7c562c06'}, 'multiverseid': None}, {'name': 'Presença do Mestre', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '966e5251-6311-4f50-be2a-e1868d77d4c3'}, 'multiverseid': None}]", "[{'name': 'Apostel der Gnade', 'text': 'Schutz vor Schwarz\\nUmwandlung 2', 'type': 'Beschwörung einer Klerikerin', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8cf39982-cbfc-408d-bd4e-c8d69ad44c56'}, 'multiverseid': None}, {'name': 'Discípulo de la Gracia', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0611f9d4-e6bd-4626-9e75-75056d4fdf86'}, 'multiverseid': None}, {'name': 'Disciple de la grâce', 'flavor': None, 'lan