': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '97b84e7d-258f-46dc-baef-4b1eb6f28d4d'}, 'multiverseid': None}, {'name': 'De vuelta a lo fundamental', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2b59493c-0df9-4a71-b9b3-28f6cb3cffe8'}, 'multiverseid': None}, {'name': 'Retour aux notions de base', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3099cc2b-f8d4-4eee-a3a9-73205687093a'}, 'multiverseid': None}, {'name': 'Ritorno alle Origini', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '46cbe0ee-35b8-4ff6-9700-82ef4765f24f'}, 'multiverseid': None}, {'name': '基本に帰れ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '877c3023-cc91-48ed-acaf-d32bc293bbd6'}, 'multiverseid': None}, {'name': 'Retorno ao Básico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '173db1b4-8e32-4642-9356-527167a4e161'}, 'multiverseid': None}]", "[{'name': 'Größeres Wohl', 'text': 'Opfere eine Kreatur: Ziehe so viele Karten, wie die geopferte Kreatur Stärke hatte. Wähle dann drei Karten aus Deiner Hand und wirf diese ab.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5438a694-de18-4318-b7aa-af27cd3c0021'}, 'multiverseid': None}, {'name': 'Beneficio superior', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e119a6ac-f97d-439e-b793-a637b3862554'}, 'multiverseid': None}, {'name': 'Pour le plus grand bien', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '55b0ac53-a582-409e-93b8-98ac07904c6d'}, 'multiverseid': None}, {'name': 'Bene Supremo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'bc4d3db2-8eda-444d-995c-032385912f9a'}, 'multiverseid': None}, {'name': 'よりよい品物', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '79f7629d-0949-4e70-b2c0-cfbab34d8d7f'}, 'multiverseid': None}, {'name': 'Bem Maior', 'flavor':