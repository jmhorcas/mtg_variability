avor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a90058a5-bdfb-45cf-a887-fb683382eea6'}, 'multiverseid': None}, {'name': 'Guadagni Illeciti', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c1a3c471-e9a4-47f6-8840-ea532cb8f5c1'}, 'multiverseid': None}, {'name': '不正利得', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '263dd34c-509e-48ac-b84c-eff4fff072b0'}, 'multiverseid': None}, {'name': 'Ganhos Mal Adquiridos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd564cdd3-fa93-4fa2-822f-2bf23744c5b9'}, 'multiverseid': None}]", '[{\'name\': \'Urzas Rüstung\', \'text\': \'Immer wenn Dir eine Quelle Schaden zufügt, wird dieser Schaden um 1 reduziert.\', \'type\': \'Artefakt\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3ca934b-435c-4d31-bdae-435bc92bee9b\'}, \'multiverseid\': None}, {\'name\': \'Armadura de Urza\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26601a33-252a-4af7-bba9-4f352edb7bda\'}, \'multiverseid\': None}, {\'name\': "Armure d\'Urza", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0fc136fe-8dac-4e04-8b31-d4a4d738fbcd\'}, \'multiverseid\': None}, {\'name\': \'Armatura di Urza\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c04fbf24-af76-4e0c-8bfa-a593678b2094\'}, \'multiverseid\': None}, {\'name\': \'ウルザの鎧\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61deae0d-1263-4973-a7f0-992b6210b3a4\'}, \'multiverseid\': None}, {\'name\': \'Armadura de Urza\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3cead2fd-d726-44c1-80dd-030ce3682477\'}, \'multiverseid\': None}]', "[{'name': 'Vebulid', 'text': 'Der Vebulid kommt mit einer +1/+1-Marke auf ihm ins Spiel.\\nDu kannst während Deiner Versorgungsphase eine +1/+1-Marke auf den Vebulid legen.\\nZerst