 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8b7f88e2-bd2e-427b-bcc0-6a4763ad8ef5'}, 'multiverseid': None}]", '[{\'name\': \'Säubernde Sense\', \'text\': \'Die Säubernde Sense fügt während Deiner Versorgungsphase der Kreatur mit der geringsten Widerstandskraft 2 Schadenspunkte zu. Wenn zwei oder mehr Kreaturen dieselbe geringste Widerstandskraft haben, entscheidest Du, welche Kreatur den Schaden erhält.\', \'type\': \'Artefakt\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0efa0216-5db5-463e-a4e4-4b237379cc6c\'}, \'multiverseid\': None}, {\'name\': \'Guadaña purgadora\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ba9a5f4-a871-4939-b2b2-fbabbb896fbf\'}, \'multiverseid\': None}, {\'name\': \'Faux purgatrice\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58832b41-27c6-499a-8ae8-d4b62e23cec9\'}, \'multiverseid\': None}, {\'name\': "Falce dell\'Espiazione", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b261ed7-a40b-46b3-bf46-f217be462165\'}, \'multiverseid\': None}, {\'name\': \'粛清の大鎌\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fa4ab705-e56e-47ec-86e6-05fa93496db3\'}, \'multiverseid\': None}, {\'name\': \'Foice Expurgadora\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff6af10f-092c-4ab7-9efd-0ad8562517a9\'}, \'multiverseid\': None}]', "[{'name': 'Telepathie', 'text': 'Alle Deine Gegner spielen mit offenen Karten.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8dea9dfe-ef68-412a-ade2-2e30836f7538'}, 'multiverseid': None}, {'name': 'Telepatía', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3676c184-1685-4e14-b537-5c37959b2167'}, 'multiverseid': None}, {'name': 'Télépathie', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '12ace9a1-7906-454