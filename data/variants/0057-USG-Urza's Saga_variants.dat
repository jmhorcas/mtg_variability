, 'identifiers': {'scryfallId': '6bb14fa8-eab2-4ba3-a593-dae764bd4220'}, 'multiverseid': None}, {'name': '隠れたる雄ジカ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2cbcd026-b684-457f-aaf7-41454ed36c15'}, 'multiverseid': None}, {'name': 'Cervo Escondido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'da65bbf3-2316-4727-ba1e-3656930131e7'}, 'multiverseid': None}]", "[{'name': 'Verbrannte Steppe', 'text': 'Jeder Spieler opfert vier Länder. Dann fügt die Verbrannte Steppe jeder Kreatur 4 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c4461981-826d-4322-919d-decaa2d9b8df'}, 'multiverseid': None}, {'name': 'Incendio destructor', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd25596c7-85a9-4fb4-9b5c-b263ab07e98f'}, 'multiverseid': None}, {'name': 'Feu dévastateur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '99c8d81b-69b8-41a0-927a-9cf03e121677'}, 'multiverseid': None}, {'name': 'Fuoco Selvaggio', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e56e55db-a52a-46f4-914e-252a1337ad4a'}, 'multiverseid': None}, {'name': '燎原の火', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '6f3629c6-04ea-4752-beee-1a9f88b947f2'}, 'multiverseid': None}, {'name': 'Fogo Grego', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e6a2441d-3f7c-4bcb-9de9-f2fc680714bb'}, 'multiverseid': None}]", "[{'name': 'Verbrühung', 'text': 'Immer wenn ein Spieler eine Insel für Mana tappt, fügt ihm die Verbrühung 1 Schadenspunkt zu.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '72ebc422-c8c2-4b35-ac82-8f56135212d5'}, 'multiverseid': None}, {'name': 'Escaldar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ea500fb9-a5f3-4d88-841e-7350f0738ddc'}, 'multiverseid': None}, {'name': 'Brûlure', 'flavor': Non