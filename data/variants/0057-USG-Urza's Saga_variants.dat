iverseid': None}]", "[{'name': 'Wunschtier', 'text': 'Wenn Du während Deiner Versorgungsphase eine Karte auf Deiner Hand hast, bringe das Wunschtier auf die Hand ihres Besitzers zurück.', 'type': 'Beschwörung einer Illusion', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '217d3baf-fd43-4010-b770-5fcbb1998fab'}, 'multiverseid': None}, {'name': 'Mascota imaginaria', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1f3686d6-c25d-4f2b-bb31-d1710879b1e7'}, 'multiverseid': None}, {'name': 'Animal imaginaire', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '7d336858-8ae1-4a06-bdef-239ba8af00e4'}, 'multiverseid': None}, {'name': 'Cucciolo Immaginario', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '70ebdcb1-e8e1-4f5a-bdd4-0241278666ef'}, 'multiverseid': None}, {'name': '想像上のペット', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9efa3424-5aed-4d6e-a5fc-ac093ebdbee5'}, 'multiverseid': None}, {'name': 'Mascote Imaginário', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '507d113c-5c38-4880-aa37-13b14a900446'}, 'multiverseid': None}]", "[{'name': 'Wächter des Heiligtums', 'text': 'Opfere den Wächter des Heiligtums: Verhindere allen Schaden, der einer Kreatur oder einem Spieler aus einer Quelle zugefügt wird. (Weiterer Schaden aus dieser Quelle wird normal behandelt.)', 'type': 'Beschwörung eines Schützers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'cb06a44e-398d-49cd-9b29-1dfd77f179bb'}, 'multiverseid': None}, {'name': 'Guardián del lugar sagrado', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'b46b3a22-7613-4dc5-96c5-cf16647a600f'}, 'multiverseid': None}, {'name': 'Vigile du sanctuaire', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a46e874c-30bb-4487-b967-330614c55a9e'}, 'multiverseid': None}, {'name': 'Guardiano del Santuario', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '22ddfe0d-52e0-4f7c-8386-6c0cbb700835'}, 'multiverseid': None}, {'name': '聖域の守護者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '00e89e03-2f5f-4e84-82f7-d4aba8bde033'}, 'multiverseid': None}, {'name': 'Guardião do Santuário', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '926c83c8-4590-4c27-ad22-0d98198530e5'}, 'multiverseid': None}]", "[{'name': 'Yawgmoths Edikt', 'text': 'Immer wenn einer Deiner Gegner erfolgreich einen weißen Zauberspruch spricht, verliert dieser Spieler 1 Lebenspunkt und Du erhältst 1 Lebenspunkt dazu.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'ef54a201-11c8-43f1-bb05-6e0762daee1c'}, 'multiverseid': None}, {'name': 'Edicto de Yawgmoth', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '208fcc1c-53a5-4a7b-84ad-7ac19f47fe5b'}, 'multiverseid': None}, {'name': 'Edit de Yaugzebul', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '7e647f4f-60b4-400c-b55e-bc0782b4c8ef'}, 'multiverseid': None}, {'name': 'Editto di Yawgmoth', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd022626d-c3fe-4810-b199-bb64c9ed7908'}, 'multiverseid': None}, {'name': 'ヨーグモスの勅令', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'cb8277f4-4147-488f-a920-19d9142324d3'}, 'multiverseid': None}, {'name': 'édito de Yawgmoth', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '69d2c00f-fd16-4108-8a0b-aadb417a2411'}, 'multiverseid': None}]", "[{'name': 'Yawgmoths Wille', 'text': 'Bis zum Ende des Zuges kannst Du Karten aus Deinem Friedhof spielen, als ob sie auf Deiner Hand wären. Karten, die in diesem Zug auf Deinem Friedhof landen, werden stattdessen ganz aus dem Spiel entfernt.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e6f5f75b-1a66-4bb4-90ac-83a6095087fd'}, 'multiverseid': None}, {'name': 'Voluntad de Yawgmoth', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1c577aab-8209-4aef-916d-811368b7330d'}, 'multiverseid': None}, {'name': 'Volonté de Yaugzebul', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '910db3b2-9406-44bd-9178-e0a6d15cc836'}, 'multiverseid': None}, {'name': 'Volontà di Yawgmoth', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5d68c7d6-71c9-4627-b1df-01f3ad9a5b42'}, 'multiverseid': None}, {'name': 'ヨーグモスの意志', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'bc10f425-17c3-4121-b778-2334faa6ac90'}, 'multiverseid': None}, {'name': 'Determinação de Yawgmoth', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ba43ea53-57d1-4bb7-a877-4710d6640e73'}, 'multiverseid': None}]", "[{'name': 'Zapfenstreich', 'text': 'Jeder Spieler bestimmt eine Kreatur, die er kontrolliert und bringt diese auf die Hand ihres Besitzers zurück.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '93d36200-6f47-4167-90b8-a53dae6f7226'}, 'multiverseid': None}, {'name': 'Toque de queda', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7993d780-1e6f-4d2c-a6e4-a20d5375e794'}, 'multiverseid': None}, {'name': 'Couvre-feu', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0d09caf4-5b1b-44b8-8b41-79f6410fa4c9'}, 'multiverseid': None}, {'name': 'Coprifuoco', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b749f5e9-eae4-4890-8851-9ff0b92d19e0'}, 'multiverseid': None}, {'name': '消灯', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '21545515-1b69-45dc-a139-26c8b6c2f82a'}, 'multiverseid': None}, {'name': 'Toque de Recolher', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '76efd699-61c4-4454-903f-4b3d52e5105a'}, 'multiverseid': None}]", "[{'name': 'Zauberlehrer', 'text': '{T}: Bringe den Zauberlehrer und eine Kreatur Deiner Wahl, die du kontrollierst, auf die Hand ihrer Besitzer zurück.', 'type': 'Beschwörung eines Zauberers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c7934654-918c-4c9f-9ba3-9ba904b54218'}, 'multiverseid': None}, {'name': 'Mentor mago', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8a07bad8-0816-4373-b5f4-e732867bf693'}, 'multiverseid': None}, {'name': 'Mentor sorcier', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '1d106451-f17d-4b31-b55f-ef195847cd77'}, 'multiverseid': None}, {'name': 'Mago Mentore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '47dff731-4158-45fb-a038-a42fca75757a'}, 'multiverseid': None}, {'name': '魔術師の導師', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '57e2954c-9282-4cc7-8051-1cc97de9f826'}, 'multiverseid': None}, {'name': 'Mago Mentor', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8d0fb24c-936d-458e-b1c3-6a474fd85663'}, 'multiverseid': None}]", "[{'name': 'Zauberwaage', 'text': 'Bringe während der Versorgungsphase eines Spielers jede Kreatur, die dieser Spieler kontrolliert und deren Stärke größer als die Anzahl an Karten auf seiner Hand ist, auf die Hand ihres Besitzers zurück.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2172dd1a-96c6-4e02-810e-0336059249cf'}, 'multiverseid': None}, {'name': 'Balanza noética', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0058bd60-48ed-4c14-ae7f-c5ab58694429'}, 'multiverseid': None}, {'name': 'Balance Noétique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bba49b8a-c412-4e4d-b58a-55c232dfbcd2'}, 'multiverseid': None}, {'name': 'Bilancia Noetica', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0e2a43a7-5c77-418b-9a26-512dc3b27f2a'}, 'multiverseid': None}, {'name': '認識のはかり', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4d5b31d7-78c1-4c84-a0c4-6b5b41935c46'}, 'multiverseid': None}, {'name': 'Escalas Poéticas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4742b5ad-8058-4d3b-ab9d-c44a3e9e5b4f'}, 'multiverseid': None}]", "[{'name': 'Zauberwerkstatt', 'text': 'Jeder Spieler kann pro Zug höchstens einen Zauberspruch sprechen.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'fc59b4f0-6217-4c5b-a95a-0b7aff2c5ff6'}, 'multiverseid': None}, {'name': 'Laboratorio arcano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'bbd11e44-7e68-44fe-ac0c-1a0e0a8b0fac'}, 'multiverseid': None}, {'name': 'Laboratoire ésotérique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '099c1982-7f9b-4093-acba-f2fb94e8697e'}, 'multiverseid': None}, {'name': 'Laboratorio Arcano', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '67db52cb-e2e5-4c45-ad07-7fb5117fcbf4'}, 'multiverseid': None}, {'name': '秘儀の研究室', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '800bf9c0-1f17-4323-af74-6c061c73afa5'}, 'multiverseid': None}, {'name': 'Laboratório Arcano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '141b2c8b-0082-47a6-bfae-708fcbce2bdf'}, 'multiverseid': None}]", "[{'name': 'Zeitloch', 'text': '5, {T}: Mische Deine Bibliothek und decke die oberste Karte auf. Du kannst bis zum Ende des Zuges, solange diese Karte oben auf der Bibliothek liegt, diese Karte ausspielen, als ob sie auf Deine Hand wäre, ohne ihre Spruchkosten zu bezahlen. Wenn der Zauberspruch X in seinem Spruchkosten hat, so ist X gleich 0.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0fc24c7e-a890-4e68-9428-107e615cbd35'}, 'multiverseid': None}, {'name': 'Abertura temporal', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '099c1d49-8be4-4c52-a877-5883ab1af1d8'}, 'multiverseid': None}, {'name': 'Ouverture temporelle', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6587dd9a-61c1-404b-8606-b1115a5bde33'}, 'multiverseid': None}, {'name': 'Fessura Temporale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'fbd3d3ed-a179-4d18-b148-cbe1aa928577'}, 'multiverseid': None}, {'name': '束の間の開口', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4a644c1e-f918-48b4-bec7-1ecd0c1cf065'}, 'multiverseid': None}, {'name': 'Abertura Temporal', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '95e20847-cea3-4943-b91a-3979721b2c28'}, 'multiverseid': None}]", "[{'name': 'Zeitspirale', 'text': 'Entferne die Zeitspirale ganz aus dem Spiel. Jeder Spieler mischt seine Karten auf der Hand und seinem Friedhof in die Bibliothek und zieht dann sieben Karten.\\nEnttappe bis zu sechs Länder.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8f1bfd88-f3ed-420d-bc86-8b7313589104'}, 'multiverseid': None}, {'name': 'Espiral del tiempo', 'text': 'Retira del juego la Espiral del tiempo. Cada jugador baraja su cementerio y su mano en su biblioteca, luego roba siete cartas. Tú enderezas hasta seis tierras.', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '59914fc9-c458-4e98-9052-177b533e0f69'}, 'multiverseid': None}, {'name': 'Spirale temporelle', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6c956f69-d613-48d3-bca5-f1d7f226b4f7'}, 'multiverseid': None}, {'name': 'Spirale Temporale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '674dc346-c21f-40e6-a7f3-0fa8b9754218'}, 'multiverseid': None}, {'name': '時のらせん', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9e594f76-f0e7-4665-b244-74363c44e905'}, 'multiverseid': None}, {'name': 'Espiral Temporal', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e87dd924-2e68-4849-97d2-02eeadeb3c4d'}, 'multiverseid': None}]", "[{'name': 'Zephid', 'text': 'Fliegend\\nDer Zephid kann nicht Ziel von Zaubersprüchen oder Fähigkeiten sein.', 'type': 'Beschwörung einer Illusion', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '20d647ea-b699-4ab6-a2ab-e8f803cbe533'}, 'multiverseid': None}, {'name': 'Céfido', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3409ee91-7b26-4536-b36c-7029622dd011'}, 'multiverseid': None}, {'name': 'Zéphide', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'cc13ab3d-27f8-4487-8a65-9df5dcab6316'}, 'multiverseid': None}, {'name': 'Zephid', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2c994fdd-ca68-44b4-a0d6-adee2efd79be'}, 'multiverseid': None}, {'name': 'ゼフィド', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f2302a3c-863a-49df-8e2c-9f97ab8e52c7'}, 'multiverseid': None}, {'name': 'Zephid', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b130f336-413f-4356-b7f0-ce88ee38a255'}, 'multiverseid': None}]", "[{'name': 'Zephids Umarmung', 'text': 'Die verzauberte Kreatur erhält +2/+2 und Flugfähigkeit und kann nicht Ziel von Zaubersprüchen oder Fähigkeiten sein.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '367eb509-c2c7-42e5-9006-f6187edd5622'}, 'multiverseid': None}, {'name': 'Abrazo del céfido', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '998d1d44-ef41-4902-afa0-0980dc997c68'}, 'multiverseid': None}, {'name': 'Etreinte du Zéphide', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd34e41c1-6350-4f84-93cf-39c117c14a16'}, 'multiverseid': None}, {'name': 'Abbraccio degli Zephid', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7bc405b4-1a88-4327-b8c2-e3189c0d3f99'}, 'multiverseid': None}, {'name': 'ゼフィドの抱擁', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e78ba4d6-9d8d-4757-8927-d57601bc4e29'}, 'multiverseid': None}, {'name': 'Abraço de Zephid', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ca86becd-00fe-4a95-86b3-8615b9e5516c'}, 'multiverseid': None}]", "[{'name': 'Zermürbung', 'text': 'Jeder Deiner Gegner bestimmt zwei Karten aus seiner Hand und wirft diese ab.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8e5104df-4384-4593-b235-b3734eead3c3'}, 'multiverseid': None}, {'name': 'Desconcertar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '25c2115f-2d5f-4734-9813-4b9627bf34c9'}, 'multiverseid': None}, {'name': 'Trouble intense', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'dd18f598-4b0d-418c-b759-5f12fcc9c4f3'}, 'multiverseid': None}, {'name': 'Snervare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '66f23aeb-0a14-46df-aac6-87854cdbb417'}, 'multiverseid': None}, {'name': 'やり込め', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5c0725ae-0c0e-4bf9-9f3b-fdcf2abadf7c'}, 'multiverseid': None}, {'name': 'Acovardar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '54f394d7-2011-482e-85b8-61e3c3f03c0f'}, 'multiverseid': None}]", "[{'name': 'Zerstörungsdrang', 'text': 'Immer wenn die verzauberte Kreatur einem Spieler erfolgreich Kampfschaden zufügt, opfert dieser Spieler ein Land.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '6e2383dc-ee8e-4b85-a3c1-1eda1890d5c0'}, 'multiverseid': None}, {'name': 'Instinto destructivo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0496ab9e-64f1-493b-a2bf-2521c63733a8'}, 'multiverseid': None}, {'name': 'Pulsion destructrice', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b093b671-c1b1-49fe-9be3-4bcceafc2f26'}, 'multiverseid': None}, {'name': 'Impulso Distruttivo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'dca0053c-2f41-403c-b135-918ec0d4ea2c'}, 'multiverseid': None}, {'name': '破壊の衝動', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e9ce7836-50b6-4eae-834e-b0e630cd53f9'}, 'multiverseid': None}, {'name': 'ímpeto Destrutivo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7c58234c-1040-4c0f-b7e3-fc03eca8641f'}, 'multiverseid': None}]", "[{'name': 'Zurückdrehen', 'text': 'Neutralisiere einen Zauberspruch Deiner Wahl. Enttappe bis zu vier Länder.', 'type': 'Unterbrechungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0ccb124a-2afc-4bcd-b665-9e42c3771a56'}, 'multiverseid': None}, {'name': 'Retroceder', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ae3984af-32aa-4ea4-847d-d175eec5158c'}, 'multiverseid': None}, {'name': 'Rembobinage', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'fbaf495d-1a13-4f3e-a2e6-dd568055ad3f'}, 'multiverseid': None}, {'name': 'Rifare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4be85d42-1974-451d-baf7-65af3da1af2b'}, 'multiverseid': None}, {'name': '巻き直し', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '21ba22dc-581c-405b-8aea-32e2afcf95ed'}, 'multiverseid': None}, {'name': 'Retroceder', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '76bab520-5bcd-46f2-b3db-8b1d4f4b7044'}, 'multiverseid': None}]", "[{'name': 'Zusammenkunft', 'text': 'Ein Spieler Deiner Wahl erhält für jede Kreatur, die im Spiel ist, 2 Lebenspunkte dazu.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b7292db7-1a4b-48bd-bac6-5150d5a2fa23'}, 'multiverseid': None}, {'name': 'Congregar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd4cd8709-895c-44a5-8c5e-8beea6acf8ca'}, 'multiverseid': None}, {'name': 'Assemblée des fidèles', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5c975fd5-01c1-46e4-8d54-ef16c9391c98'}, 'multiverseid': None}, {'name': 'Radunarsi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e23a8f83-f818-423f-bc20-5f4b88ac7d45'}, 'multiverseid': None}, {'name': '集い', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '698feb4c-e90c-42a6-9b7c-c007155b384f'}, 'multiverseid': None}, {'name': 'Congregar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '64e9ea42-3e61-4e65-a775-6fe50645a8ae'}, 'multiverseid': None}]", '[{\'name\': \'Zwang\', \'text\': \'Schaue Dir die Karten auf der Hand eines Gegners Deiner Wahl an und bestimme davon eine Nichtkreaturenkarte und Nichtlandkarte. Der Spieler wirft die bestimmte Karte ab.\', \'type\': \'Hexerei\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0bca78d9-487c-4ef7-891f-62b6a9115612\'}, \'multiverseid\': None}, {\'name\': \'Coacción\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0cadd16a-7601-4810-b1ee-e4ef0f0dc4f2\'}, \'multiverseid\': None}, {\'name\': \'Contrainte\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'626b8434-7357-4807-bd1d-342ad7745029\'}, \'multiverseid\': None}, {\'name\': \'Costrizione\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84de6761-c235-49de-acc8-7c6e4d2025fc\'}, \'multiverseid\': None}, {\'name\': \'強迫\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b6ed1d0a-db5e-4293-a63e-19e26a8fa097\'}, \'multiverseid\': None}, {\'name\': \'Coergir\', \'text\': \'Olhe a mão do oponente alvo e escolha uma carta que não seja um terreno nem uma criatura. Aquele jogador descarta aquela carta.\', \'type\': \'Feitiço\', \'flavor\': \'"Nós decidimos quem merece nossos serviços."\\n—Gix, pretor de Yawgmoth\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3390c7e0-5674-4c05-ac36-ef6aada16fba\'}, \'multiverseid\': None}]', "[{'name': 'Zweifelnder Mönch', 'text': 'Wenn der Zweifelnde Mönch ins Spiel kommt, zerstöre eine Verzauberung Deiner Wahl.', 'type': 'Beschwörung eines Klerikers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '191022e3-0288-4214-9925-ee3e66e382e2'}, 'multiverseid': None}, {'name': 'Realista monje', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3de399a5-23d8-40f2-8543-8ebdf417a770'}, 'multiverseid': None}, {'name': 'Moine réaliste', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5a036c35-65cb-4c42-bf67-21dd8af712a0'}, 'multiverseid': None}, {'name': 'Monaco Realista', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b8aac2d6-3122-4df4-b0fd-1e7e430f5214'}, 'multiverseid': None}, {'name': '現実主義の修道士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ab2e8bbf-432b-43e9-ac89-55c8188b0ebb'}, 'multiverseid': None}, {'name': 'Monge Realista', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'be56f28d-63fc-46f3-9e26-ac1f3f0bc1ac'}, 'multiverseid': None}]", "[{'name': 'Ätzender Boden', 'text': 'Der Ätzende Boden fügt jedem Spieler für jedes Land, das er kontrolliert, 1 Schadenspunkt zu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'cb643383-71ec-4d89-ae0e-3fe50aab36b5'}, 'multiverseid': None}, {'name': 'Suelo ácido', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2374047c-c2c8-4e89-9742-ca51224a2cf0'}, 'multiverseid': None}, {'name': 'Terre acide', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '9767446b-b523-493b-8bb9-d832044c8d9f'}, 'multiverseid': None}, {'name': 'Suolo Acido', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'edbaac1a-c90d-419c-a9ff-d7c55206002b'}, 'multiverseid': None}, {'name': '酸性土', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e7f961e5-ece4-44ec-863b-90e0e91af63c'}, 'multiverseid': None}, {'name': 'Solo Ácido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0fb9719a-cef1-459f-8c44-9d51173312c2'}, 'multiverseid': None}]", "[{'name': 'Überfluß', 'text': 'Anstatt eine Karte zu ziehen, kannst Du Land oder Nicht-Land wählen und dann Karten von Deiner Bibliothek aufdecken, bis eine Karte des gewählten Typs erscheint. Nimm diese Karte auf Deine Hand und lege die übrigen aufgedeckten Karten in beliebiger Reihenfolge unter Deine Bibliothek.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '66578ee0-2ce0-409e-a66a-f6875b8ca753'}, 'multiverseid': None}, {'name': 'Abundancia', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'be6b041f-fbd9-4d9b-8376-6744341cc327'}, 'multiverseid': None}, {'name': 'Abondance', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3db7b453-43b8-498d-b4cf-5cd1dd38b5dd'}, 'multiverseid': None}, {'name': 'Abbondanza', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2d2a8adb-64b7-4c6c-8cb4-d1d3443ac99d'}, 'multiverseid': None}, {'name': '豊穣', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '83b24b98-5852-4230-9c82-caaccff29ee6'}, 'multiverseid': None}, {'name': 'Abundância', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e308f866-018a-48db-9fa5-4ba34a2324e7'}, 'multiverseid': None}]"]
