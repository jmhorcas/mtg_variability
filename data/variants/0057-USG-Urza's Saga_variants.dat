': 'Draco de oropel', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3135a4cb-e644-4e4a-8d97-5a348f397aa4'}, 'multiverseid': None}, {'name': 'Drakôn clinquant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a12a281c-95c8-4b7c-a6b1-18387a54bcf1'}, 'multiverseid': None}, {'name': 'Draghetto Dorato', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '334643ca-5883-457d-81f9-8b7ac1ff53a9'}, 'multiverseid': None}, {'name': '金粉のドレイク', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8c84a228-835b-4a18-afd5-8b28ae7a41d7'}, 'multiverseid': None}, {'name': 'Dragonete Engalanado', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '48206b50-9d16-44fe-876a-a6a75178d940'}, 'multiverseid': None}]", '[{\'name\': \'Hartnäckigkeit\', \'text\': \'Wenn die Hartnäckigkeit aus dem Spiel auf dem Friedhof landet, bringe die Hartnäckigkeit auf die Hand ihres Besitzers zurück.\\nOpfere einen Wald: Regeneriere die verzauberte Kreatur.\', \'type\': \'Verzaubere Kreatur\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ca9aeec-5100-4a0b-8e71-e0e2243ec603\'}, \'multiverseid\': None}, {\'name\': \'Entereza\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79510a0d-8843-485b-bc26-0ac05b7d6d73\'}, \'multiverseid\': None}, {\'name\': \'Fortitude\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b20867c5-916f-439a-afa9-cefa954b272f\'}, \'multiverseid\': None}, {\'name\': "Forza d\'Animo", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'93b2569c-7ae0-4e6a-be0d-61b4cd841e4b\'}, \'multiverseid\': None}, {\'name\': \'堅忍不屈\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7fa28622-5707-4b23-86d5-d25c09b15ddd\'}, \'multiverseid\': None}, {\'name\': \'Fortitude\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'id