nguage': 'German', 'identifiers': {'scryfallId': '6875dfa8-6278-4412-b316-ee10f16b9199'}, 'multiverseid': None}, {'name': 'Tumulario solitario', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '04acf649-c522-4d7c-a54f-13be3fb8cdcb'}, 'multiverseid': None}, {'name': 'Nécrophage reclus', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'ac154d29-cbfb-4384-bfe5-e45e9703690f'}, 'multiverseid': None}, {'name': 'Presenza Solitaria', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a867bede-0c6e-41c9-a898-36ffc01ce887'}, 'multiverseid': None}, {'name': '隠遁者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ad865bb0-e410-440c-8c76-fe60d1d7aeb9'}, 'multiverseid': None}, {'name': 'Avantesma Recluso', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3cda8888-c154-497b-a0f1-55012e26b982'}, 'multiverseid': None}]", "[{'name': 'Vereinsamung', 'text': 'Immer wenn eine grüne Kreatur aus dem Spiel auf dem Friedhof landet, bestimmt ihr Beherrscher eine Karte aus seiner Hand und wirft diese ab.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '122337b9-f58b-46c5-966f-df2fdf6c5aee'}, 'multiverseid': None}, {'name': 'Desconsuelo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '279c079f-a6a0-4cb1-b739-5ba656bae926'}, 'multiverseid': None}, {'name': 'Deuil', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e74d6c9e-fa1b-4c9a-9671-8ca12ece3273'}, 'multiverseid': None}, {'name': 'Lutto', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'eca9f0f9-a98a-4d24-b1bb-edbe21d3b760'}, 'multiverseid': None}, {'name': '死別', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '1a575b7b-d1b4-447b-a9b3-97963a70d481'}, 'multiverseid': None}, {'name': 'Privação', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fb7d2308-1504-4c61-aed1-ae912047b089'}, 'multiverseid': None}]", "[{'name': 'Verfolgung', 'text': 'Bestimme eine Farbe. Schaue Dir die Karten auf der Hand eines Spieler Deiner Wahl an. Der Spieler wirft alle Karten der bestimmten Farbe ab.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0ec1ecfd-782c-4a9a-8b48-c088b4c07399'}, 'multiverseid': None}, {'name': 'Perseguir', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4b0425e2-3489-410c-b964-d056eb7a05dd'}, 'multiverseid': None}, {'name': 'Persécution', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5d527138-f757-4294-9edb-e194bf6e7e3b'}, 'multiverseid': None}, {'name': 'Perseguitare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd4631eb2-57ad-42bb-b2c9-2e3a00b97f40'}, 'multiverseid': None}, {'name': '迫害', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'a8561305-d213-4c05-bc62-75913e57b4e3'}, 'multiverseid': None}, {'name': 'Perseguir', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '89a6c779-7f16-4d01-ba21-278089134831'}, 'multiverseid': None}]", "[{'name': 'Verjüngung', 'text': 'Du erhältst 6 Lebenspunkte dazu.\\nUmwandlung 2', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'bd43f534-010d-40dc-922d-bae123dc4a62'}, 'multiverseid': None}, {'name': 'Rejuvenecer', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '41ff0630-391a-4ea1-aebd-3b378f0b8ab7'}, 'multiverseid': None}, {'name': 'Rajeunissement', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8380c956-08d2-4696-8aff-27281daae272'}, 'multiverseid': None}, {'name': 'Ringiovanire', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2fd166a9-1804-4b1d-9bcc-59dabffee4c9'}, 'multiverseid': None}, {'name': '回春', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '12ae57e8-9226-4c9f-8adb-eda959e8874f'}, 'multiverseid': None}, {'name': 'Rejuvenescer', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cfba0fd6-77ee-49af-bb08-337c63eadd6e'}, 'multiverseid': None}]", "[{'name': 'Verrückter Skirg', 'text': 'Fliegend\\nFür den Verrückten Skirg gilt die Einsatzverzögerung nicht.', 'type': 'Beschwörung von Bolds', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7142070a-9945-4184-a27d-2ca051d7fd5e'}, 'multiverseid': None}, {'name': 'Esquirge enloquecido', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5cd88e49-1442-4ef4-bf0d-fb044fc0f569'}, 'multiverseid': None}, {'name': 'Scrige affolé', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5c8d3f46-57eb-41c8-971f-113661e25a49'}, 'multiverseid': None}, {'name': 'Skirge Impazzito', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f0d881ad-81e2-41dc-acab-a761f94c62cf'}, 'multiverseid': None}, {'name': '狂ったスカージ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '41b39208-dbe3-48ec-bb8c-5f4c3b37301b'}, 'multiverseid': None}, {'name': 'Eskirge Enlouquecido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '94a944d5-fb6d-4708-a760-ac700451a935'}, 'multiverseid': None}]", '[{\'name\': \'Verschleierte Erscheinung\', \'text\': \'Wenn einer Deiner Gegner erfolgreich einen Zauberspruch spricht und die Verschleierte Erscheinung eine Verzauberung ist, wird die Verschleierte Erscheinung zu einer fliegenden 3/3 Kreatur, die als Illusion zählt und für die „Bezahle während Deiner Versorgungsphase 1U oder opfere die Verschleierte Erscheinung" gilt.\', \'type\': \'Verzauberung\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f34df213-044b-4410-ae07-dd3dc805d445\'}, \'multiverseid\': None}, {\'name\': \'Aparición velada\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2070755-1d34-4d66-a54b-051b257a0c11\'}, \'multiverseid\': None}, {\'name\': \'Revenant voilé\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6d73ca2-1e5f-4145-915d-8f9125e83694\'}, \'multiverseid\': None}, {\'name\': \'Apparizione Velata\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4376d63c-f5af-4054-a8d1-10bd79d4b885\'}, \'multiverseid\': None}, {\'name\': \'仮装の亡霊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6469e12c-4ed9-4762-a135-c007c59e9725\'}, \'multiverseid\': None}, {\'name\': \'Aparição Velada\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e104198c-a7ad-4708-bb0c-3c9dc25496ca\'}, \'multiverseid\': None}]', "[{'name': 'Verschleierte Schlange', 'text': 'Wenn einer Deiner Gegner erfolgreich einen Zauberspruch spricht und die Verschleierte Schlange eine Verzauberung ist, wird die Verschleierte Schlange zu einer 4/4 Kreatur, die als Schlange zählt und die nicht angreifen kann, wenn der verteidigende Spieler nicht mindestens eine Insel kontrolliert.\\nUmwandlung 2', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5e42cdfa-d624-4c4d-95c1-390712c1db61'}, 'multiverseid': None}, {'name': 'Serpiente velada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2bda3904-97ed-45a4-b820-c8e25a4e491a'}, 'multiverseid': None}, {'name': 'Grand serpent voilé', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '1c7ecd78-f56e-4285-9ab7-15236238ec31'}, 'multiverseid': None}, {'name': 'Serpente Velato', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e9b4b371-b573-4581-b655-42635f9443b5'}, 'multiverseid': None}, {'name': '仮装の大海蛇', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2cf2e4eb-336a-4b56-ac9e-d38866388c56'}, 'multiverseid': None}, {'name': 'Serpente Velada', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4e43cb64-dc84-4174-aeaa-d628b2523d5b'}, 'multiverseid': None}]", "[{'name': 'Verschleierter Wächter', 'text': 'Wenn einer Deiner Gegner erfolgreich einen Zauberspruch spricht und der Verschleierte Wächter eine Verzauberung ist, wird der Verschleierte Wächter zu einer Kreatur, die als Illusion zählt und deren Stärke und Widerstandskraft gleich der Gesamtspruchkosten jenes Zauberspruchs sind.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3ad3a799-a762-4995-b299-e1e51be06297'}, 'multiverseid': None}, {'name': 'Centinela velado', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd62b6bed-076a-4a87-b498-fbde576b49b3'}, 'multiverseid': None}, {'name': 'Sentinelle voilée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3b195058-331f-43da-b8a1-65333cd7ded3'}, 'multiverseid': None}, {'name': 'Sentinella Velata', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'ad4ad865-a1fb-4d1c-9acb-04fc65c268d3'}, 'multiverseid': None}, {'name': '仮装の歩哨', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '423c6a02-13ad-4e11-a7be-49fc8395a70c'}, 'multiverseid': None}, {'name': 'Sentinela Velada', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0dd33071-430e-4567-abbc-523cc0c6b751'}, 'multiverseid': None}]", "[{'name': 'Verseuchung', 'text': 'Opfere während Deiner Versorgungsphase eine Kreatur oder opfere die Verseuchung.\\nImmer wenn ein Land für Mana getappt wird, produziert es {B} statt des normalen Typs und der normalen Anzahl.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'abcb4fd9-7398-402e-a227-2ecd37265347'}, 'multiverseid': None}, {'name': 'Contaminación', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a7837c54-25b5-4c91-8745-f464895b3fa9'}, 'multiverseid': None}, {'name': 'Contamination', 'flavor': None, 'language': 'French', 'identifiers': {'scry