alian', 'identifiers': {'scryfallId': 'f0ee2044-6948-477c-b747-16f4ae90d146', 'multiverseId': 428036}, 'multiverseid': 428036}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428305&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a7ef768a-7d1d-4a98-a9dc-8f48cc501e20', 'multiverseId': 428305}, 'multiverseid': 428305}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428574&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4bec4e3d-84d8-41cb-9c20-052890da3304', 'multiverseId': 428574}, 'multiverseid': 428574}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428843&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd5563c2f-e1c8-4f67-b03f-2f54e22467f9', 'multiverseId': 428843}, 'multiverseid': 428843}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429112&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f3535d94-6162-4a23-8863-b0e3b1a53ecd', 'multiverseId': 429112}, 'multiverseid': 429112}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429381&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6e2a655b-2924-495f-af1c-b3490803ebf4', 'multiverseId': 429381}, 'multiverseid': 429381}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429650&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '73b6fef0-c191-4605-b468-885d9b06d4d9', 'multiverseId': 429650}, 'multiverseid': 429650}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427230&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cd9208a8-57bd-4177-b930-bf13eda923e6', 'multiverseId': 427230}, 'multiverseid': 427230}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427499&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6a2bc171-6119-4aa0-a37c-9b553bd1f027', 'multiverseId': 427499}, 'multiverseid': 427499}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427768&type=card', 'language': 'French', 'identifiers': {'scryfallId': '693f58d4-535d-4b9d-85a8-c6282e00d869', 'multiverseId': 427768}, 'multiverseid': 427768}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428037&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6f312d4e-32e1-4acd-b827-1ca248818ba5', 'multiverseId': 428037}, 'multiverseid': 428037}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428306&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2d89c61e-f70c-45d7-953f-1b9bb0cf5c6a', 'multiverseId': 428306}, 'multiverseid': 428306}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428575&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1c97f717-a4ec-4bbf-8771-5f37bfb1093e', 'multiverseId': 428575}, 'multiverseid': 428575}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428844&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '917c70c8-00f3-4cc4-89b7-d30d176b0aa0', 'multiverseId': 428844}, 'multiverseid': 428844}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429113&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '73c36f06-c47a-4b3d-9f03-135675b5df89', 'multiverseId': 429113}, 'multiverseid': 429113}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429382&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '66a0f38c-9a53-4a14-8c10-c6ecc71358ba', 'multiverseId': 429382}, 'multiverseid': 429382}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429651&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'bd218d6e-214a-490c-b012-3dbb51f7c1b8', 'multiverseId': 429651}, 'multiverseid': 429651}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427231&type=card', 'language': 'German', 'identifiers': {'scryfallId': '85e7e83b-89e2-471c-96ed-1b0a1e8e43b9', 'multiverseId': 427231}, 'multiverseid': 427231}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427500&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '43802663-fcef-40e7-ac53-0e78cad58c62', 'multiverseId': 427500}, 'multiverseid': 427500}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427769&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b4b0ecad-b7ed-4e15-b8e9-7bb849baeaee', 'multiverseId': 427769}, 'multiverseid': 427769}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428038&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c7c9f729-8a1f-4c4f-a3bf-9c1185c764c3', 'multiverseId': 428038}, 'multiverseid': 428038}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428307&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a36d70b2-3896-462a-a037-85f60a5f0af1', 'multiverseId': 428307}, 'multiverseid': 428307}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428576&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b95564dd-5c01-4689-bf95-983b8f39b356', 'multiverseId': 428576}, 'multiverseid': 428576}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428845&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '313228e4-a7a8-4ad5-9d6b-f330627df966', 'multiverseId': 428845}, 'multiverseid': 428845}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429114&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c095371c-e22f-4d58-933b-f766aabaf7df', 'multiverseId': 429114}, 'multiverseid': 429114}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429383&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b1909786-4f30-49cb-9507-3060ce203e96', 'multiverseId': 429383}, 'multiverseid': 429383}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429652&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f36fc657-28f7-467d-b168-85445371167b', 'multiverseId': 429652}, 'multiverseid': 429652}]", '[{\'name\': \'Kampf-Zelebrant\', \'text\': \'Falls der Kampf-Zelebrant in diesem Zug noch nicht erschöpft wurde, kannst du ihn erschöpfen, sowie er angreift. Wenn du dies tust, enttappe alle anderen Kreaturen, die du kontrollierst, und es gibt nach dieser Phase eine zusätzliche Kampfphase. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427096&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'76d836b6-4460-4d11-8606-06eb4caa875e\', \'multiverseId\': 427096}, \'multiverseid\': 427096}, {\'name\': \'Celebrante del combate\', \'text\': \'Si el Celebrante del combate no fue espoleado este turno, puedes espolearlo en cuanto ataque. Cuando lo hagas, endereza todas las otras criaturas que controlas y después de esta fase hay una fase de combate adicional. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427365&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bb2eb9bd-5407-4490-8ab1-6c291e1b8552\', \'multiverseId\': 427365}, \'multiverseid\': 427365}, {\'name\': \'Célébrant de combat\', \'text\': "Si le Célébrant de combat n\'a pas été surmené ce tour-ci, vous pouvez le surmener au moment où il attaque. Quand vous faites ainsi, dégagez toutes les autres créatures que vous contrôlez et cette phase est suivie d\'une phase de combat supplémentaire. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427634&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2760727d-d26a-4532-93b5-3bdf95995a0c\', \'multiverseId\': 427634}, \'multiverseid\': 427634}, {\'name\': \'Celebrante da Battaglia\', \'text\': "Se il Celebrante da Battaglia non è stato stremato in questo turno, puoi stremarlo mentre attacca. Quando lo fai, STAPpa tutte le altre creature che controlli e, dopo questa fase, c\'è una fase di combattimento aggiuntiva. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427903&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8900d601-b148-4813-bfff-0010fa6f6fbd\', \'multiverseId\': 427903}, \'multiverseid\': 427903}, {\'name\': \'戦闘の祝賀者\', \'text\': \'戦闘の祝賀者がこのターンに督励されていなかったなら、これが攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、あなたがコントロールする他のクリーチャーをすべてアンタップし、このフェイズの後に追加の戦闘フェイズを１つ加える。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428172&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d60279af-6eb5-4c39-b13a-41535a674c66\', \'multiverseId\': 428172}, \'multiverseid\': 428172}, {\'name\': \'전투 사제\', \'text\': \'이 턴에 전투 사제를 분전시키지 않았다면, 당신은 전투 사제로 공격을 선언하면서 전투 사제를 분전시킬 수 있다. 그렇게 할 때, 당신이 조종하는 다른 생물들을 모두 언탭하고, 추가 전투단계가 생긴다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428441&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'40ab8baa-a802-4b86-af33-ff960478922c\', \'multiverseId\': 428441}, \'multiverseid\': 428441}, {\'name\': \'Celebrante do Combate\', \'text\': \'Se Celebrante do Combate não tiver sido exaurido neste turno, você pode exauri-lo conforme ele ataca. Quando fizer isso, desvire todas as outras criaturas que você controla e, após esta fase, há uma fase adicional de combate. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428710&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'40f5cab1-2177-48d4-917b-526b7c53c433\', \'multiverseId\': 428710}, \'multiverseid\': 428710}, {\'name\': \'Торжествующий Боец\', \'text\': \'Если Торжествующий Боец не был подстегнут в этом ходу, вы можете подстегнуть его в момент его атаки. Когда вы это делаете, разверните все другие существа под вашим контролем, и после этой фазы идет дополнительная фаза боя. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428979&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f4637671-407c-4697-b1ef-86d8f213c3b6\', \'multiverseId\': 428979}, \'multiverseid\': 428979}, {\'name\': \'战斗主祭\', \'text\': \'如果本回合尚未耗竭战斗主祭，则你可以于其攻击时耗竭之。当你如此作时，重置所有由你操控的其他生物，且在此阶段后，额外多出一个战斗阶段。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429248&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90ec66e4-a1b1-452c-a15f-13741ee5bd73\', \'multiverseId\': 429248}, \'multiverseid\': 429248}, {\'name\': \'戰鬥主祭\', \'text\': \'如果本回合尚未耗竭戰鬥主祭，則你可以於其攻擊時耗竭之。當你如此作時，重置所有由你操控的其他生物，且在此階段後，額外多出一個戰鬥階段。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429517&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'71f3b8f7-11b8-4f0c-a088-151b69e26b7f\', \'multiverseId\': 429517}, \'multiverseid\': 429517}]', '[{\'name\': \'Kartusche der Stärke\', \'text\': \'Verzaubert eine Kreatur, die du kontrollierst\\nWenn die Kartusche der Stärke ins Spiel kommt, kannst du die verzauberte Kreatur gegen eine Kreatur deiner Wahl, die ein Gegner kontrolliert, kämpfen lassen. (Jede dieser Kreaturen fügt der anderen Schadenspunkte in Höhe ihrer Stärke zu.)\\nDie verzauberte Kreatur erhält +1/+1 und verursacht Trampelschaden.\', \'type\': \'Verzauberung — Aura, Kartusche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427129&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8eecc636-b29b-4f7e-ae37-38fb83718bd7\', \'multiverseId\': 427129}, \'multiverseid\': 427129}, {\'name\': \'Cartucho de fuerza\', \'text\': \'Encantar criatura que controlas.\\nCuando el Cartucho de fuerza entre al campo de batalla, puedes hacer que la criatura encantada luche contra la criatura objetivo que controla un oponente. (Cada una hace una cantidad de daño igual a su fuerza a la otra.)\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de arrollar.\', \'type\': \'Encantamiento — Aura cartucho\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e61adb77-a9ad-4617-ac19-987de4ef2f5e\', \'multiverseId\': 427398}, \'multiverseid\': 427398}, {\'name\': \'Cartouche de force\', \'text\': "Enchanter : une créature que vous contrôlez\\nQuand le Cartouche de force arrive sur le champ de bataille, vous pouvez faire que la créature enchantée se batte contre une créature ciblée qu\'un adversaire contrôle. (Chacune inflige un nombre de blessures égal à sa force à l\'autre.)\\nLa créature enchantée gagne +1/+1 et a le piétinement.", \'type\': \'Enchantement : aura et cartouche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427667&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23ed1b8c-836f-40e4-b542-c1f52c5afead\', \'multiverseId\': 427667}, \'multiverseid\': 427667}, {\'name\': \'Cartiglio della Forza\', \'text\': "Incanta creatura che controlli\\nQuando il Cartiglio della Forza entra nel campo di battaglia, puoi far lottare la creatura incantata con una creatura bersaglio controllata da un avversario. (Ogni creatura infligge all\'altra danno pari alla propria forza.)\\nLa creatura incantata prende +1/+1 e ha travolgere.", \'type\': \'Incantesimo — Cartiglio Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427936&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b97f92f6-8bfd-47ae-b046-7df74fb990c7\', \'multiverseId\': 427936}, \'multiverseid\': 427936}, {\'name\': \'活力のカルトーシュ\', \'text\': \'エンチャント（あなたがコントロールするクリーチャー）\\n活力のカルトーシュが戦場に出たとき、対戦相手がコントロールするクリーチャー１体を対象とする。あなたは「エンチャントされているクリーチャーはそれと格闘を行う。」を選んでもよい。（それぞれはもう一方に自身のパワーに等しい点数のダメージを与える。）\\nエンチャントされているクリーチャーは、＋１/＋１の修整を受けるとともにトランプルを持つ。\', \'type\': \'エンチャント — オーラ・カルトーシュ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428205&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'599dda9c-3bb0-4eb6-8721-2c78307dda30\', \'multiverseId\': 428205}, \'multiverseid\': 428205}, {\'name\': \'힘의 카르투슈\', \'text\': \'당신이 조종하는 생물에게 부여\\n힘의 카르투슈가 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 당신은 부여된 생물과 그 생물이 서로 싸우도록 할 수 있다. (각 생물은 서로에게 각자의 공격력만큼의 피해를 입힌다.)\\n부여된 생물은 +1/+1을 받고 돌진 능력을 가진다.\', \'type\': \'부여마법 — 마법진 카르투슈\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428474&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1c1b954c-7920-4e12-b53a-75bf5ec837b9\', \'multiverseId\': 428474}, \'multiverseid\': 428474}, {\'name\': \'Cártula da Força\', \'text\': \'Encantar criatura que você controla\\nQuando Cártula da Força entra no campo de batalha, você pode fazer com que a criatura encantada lute contra a criatura alvo que um oponente controla. (Cada uma causa à outra uma quantidade de dano igual ao seu poder.)\\nA criatura encantada recebe +1/+1 e tem atropelar.\', \'type\': \'Encantamento — Aura Cártula\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428743&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ae39371e-093a-4533-bb32-36c0fb91e5cc\', \'multiverseId\': 428743}, \'multiverseid\': 428743}, {\'name\': \'Картуш Силы\', \'text\': \'Зачаровать существо под вашим контролем\\nКогда Картуш Силы выходит на поле битвы, вы можете заставить зачарованное существо драться с целевым существом под контролем оппонента. (Они наносят друг другу повреждения, равные своей силе.)\\nЗачарованное существо получает +1/+1 и имеет Пробивной удар.\', \'type\': \'Чары — Аура Картуш\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429012&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d50def1-46eb-45de-ad9b-fdfc946f2e3f\', \'multiverseId\': 429012}, \'multiverseid\': 429012}, {\'name\': \'力量魔符\', \'text\': \'结附于由你操控的生物\\n当力量魔符进战场时，你可以让所结附的生物与目标由对手操控的生物互斗。（它们各向对方造成等同于本身力量的伤害。）\\n所结附的生物得+1/+1且具有践踏异能。\', \'type\': \'结界～灵气／魔符\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429281&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd912936-4fae-460e-9693-0c20903ad212\', \'multiverseId\': 429281}, \'multiverseid\': 429281}, {\'name\': \'力量魔符\', \'text\': \'結附於由你操控的生物\\n當力量魔符進戰場時，你可以讓所結附的生物與目標由對手操控的生物互鬥。（它們各向對方造成等同於本身力量的傷害。）\\n所結附的生物得+1/+1且具有踐踏異能。\', \'type\': \'結界～靈氣／魔符\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429550&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d0e62838-ab99-4aac-bf4c-eefa9ff52242\', \'multiverseId\': 429550}, \'multiverseid\': 429550}]', '[{\'name\': \'Kartusche des Ehrgeizes\', \'text\': \'Verzaubert eine Kreatur, die du kontrollierst\\nWenn die Kartusche des Ehrgeizes ins Spiel kommt, kannst du eine -1/-1-Marke auf eine Kreatur deiner Wahl legen.\\nDie verzauberte Kreatur erhält +1/+1 und hat Lebensverknüpfung.\', \'type\': \'Verzauberung — Aura, Kartusche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427054&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7204d790-cffe-40ee-9b9c-ae45464aba4e\', \'multiverseId\': 427054}, \'multiverseid\': 427054}, {\'name\': \'Cartucho de ambición\', \'text\': \'Encantar criatura que controlas.\\nCuando el Cartucho de ambición entre al campo de batalla, puedes poner un contador -1/-1 sobre la criatura objetivo.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de vínculo vital.\', \'type\': \'Encantamiento — Aura cartucho\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427323&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44451c3c-6f9f-4c53-aef5-99a8f4a9d04f\', \'multiverseId\': 427323}, \'multiverseid\': 427323}, {\'name\': "Cartouche d\'ambition", \'text\': "Enchanter : une créature que vous contrôlez\\nQuand le Cartouche d\'ambition arrive sur le champ de bataille, vous pouvez mettre un marqueur -1/-1 sur une créature ciblée.\\nLa créature enchantée gagne +1/+1 et a le lien de vie.", \'type\': \'Enchantement : aura et cartouche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427592&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15a04d23-8af0-42ee-be83-689e82a8b689\', \'multiverseId\': 427592}, \'multiverseid\': 427592}, {\'name\': "Cartiglio dell\'Ambizione", \'text\': "Incanta creatura che controlli\\nQuando il Cartiglio dell\'Ambizione entra nel campo di battaglia, puoi mettere un segnalino -1/-1 su una creatura bersaglio.\\nLa creatura incantata prende +1/+1 e ha legame vitale.", \'type\': \'Incantesimo — Cartiglio Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427861&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53095fef-5769-4d9c-af31-72eaffe18407\', \'multiverseId\': 427861}, \'multiverseid\': 427861}, {\'name\': \'野望のカルトーシュ\', \'text\': \'エンチャント（あなたがコントロールするクリーチャー）\\n野望のカルトーシュが戦場に出たとき、クリーチャー１体を対象とする。あなたはそれの上に－１/－１カウンターを１個置いてもよい。\\nエンチャントされているクリーチャーは、＋１/＋１の修整を受けるとともに絆魂を持つ。\', \'type\': \'エンチャント — オーラ・カルトーシュ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428130&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9100db91-c167-4bd9-9251-10df6cdbe2ef\', \'multiverseId\': 428130}, \'multiverseid\': 428130}, {\'name\': \'야망의 카르투슈\', \'text\': \'당신이 조종하는 생물에게 부여\\n야망의 카르투슈가 전장에 들어올 때, 생물을 목표로 정한다. 당신은 그 생물에 -1/-1 카운터 한 개를 올려놓을 수 있다.\\n부여된 생물은 +1/+1을 받고 생명연결 능력을 가진다.\', \'type\': \'부여마법 — 마법진 카르투슈\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428399&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d1bd371e-c8b6-4fae-9a4d-0cd390b4dbb6\', \'multiverseId\': 428399}, \'multiverseid\': 428399}, {\'name\': \'Cártula da Ambição\', \'text\': \'Encantar criatura que você controla\\nQuando Cártula da Ambição entra no campo de batalha, você pode colocar um marcador -1/-1 na criatura alvo.\\nA criatura encantada recebe +1/+1 e tem vínculo com a vida.\', \'type\': \'Encantamento — Aura Cártula\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428668&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7da41850-7229-450c-8509-cc18db71b374\', \'multiverseId\': 428668}, \'multiverseid\': 428668}, {\'name\': \'Картуш Устремленности\', \'text\': \'Зачаровать существо под вашим контролем\\nКогда Картуш Устремленности выходит на поле битвы, вы можете положить один жетон -1/-1 на целевое существо.\\nЗачарованное существо получает +1/+1 и имеет Цепь жизни.\', \'type\': \'Чары — Аура Картуш\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428937&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ab143bd9-7d2f-4362-82d3-c4080610ad4f\', \'multiverseId\': 428937}, \'multiverseid\': 428937}, {\'name\': \'野心魔符\', \'text\': \'结附于由你操控的生物\\n当野心魔符进战场时，你可以在目标生物上放置一个-1/-1指示物。\\n所结附的生物得+1/+1且具有系命异能。\', \'type\': \'结界～灵气／魔符\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429206&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6a4a02a-bee9-4d3e-962d-1ad7806da026\', \'multiverseId\': 429206}, \'multiverseid\': 429206}, {\'name\': \'野心魔符\', \'text\': \'結附於由你操控的生物\\n當野心魔符進戰場時，你可以在目標生物上放置一個-1/-1指示物。\\n所結附的生物得+1/+1且具有繫命異能。\', \'type\': \'結界～靈氣／魔符\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429475&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c982ae77-cb4b-4cff-bb91-1639f203158d\', \'multiverseId\': 429475}, \'multiverseid\': 429475}]', "[{'name': 'Kartusche des Eifers', 'text': 'Verzaubert eine Kreatur, die du kontrollierst\\nWenn die Kartusche des Eifers ins Spiel kommt, kann eine Kreatur deiner Wahl in diesem Zug nicht blocken.\\nDie verzauberte Kreatur erhält +1/+1 und hat Eile.', 'type': 'Verzauberung — Aura, Kartusche', 'flavor': 'Die fünfte Kartusche ist das abschließende Zeichen des Ruhms, und wird nur den würdigen Toten verliehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427095&type=card', 'language': 'German', 'identifiers': {'scryfallId': '954476cb-57ef-46f9-a701-2fc3fb827223', 'multiverseId': 427095}, 'multiverseid': 427095}, {'name': 'Cartucho de fervor', 'text': 'Encantar criatura que controlas.\\nCuando el Cartucho de fervor entre al campo de batalla, la criatura objetivo no puede bloquear este turno.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de prisa.', 'type': 'Encantamiento — Aura cartucho', 'flavor': 'El quinto cartucho es la confirmación definitiva de la gloria, otorgado únicamente a los que mueren con dignidad.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427364&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'be88b177-e4c2-4e8b-afd3-52038d622da3', 'multiverseId': 427364}, 'multiverseid': 427364}, {'name': 'Cartouche de zèle', 'text': 'Enchanter : une créature que vous contrôlez\\nQuand le Cartouche de zèle arrive sur le champ de bataille, la créature ciblée ne peut pas bloquer ce tour-ci.\\nLa créature enchantée gagne +1/+1 et a la célérité.', 'type': 'Enchantement : aura et cartouche', 'flavor': 'Le cinquième cartouche est la dernière attestation de gloire, accordée uniquement aux morts valeureux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427633&type=card', 'language': 'French', 'identifiers': {'scryfallId': '540c391b-22a4-4e4e-a777-57b644ed818f', 'multiverseId': 427633}, 'multiverseid': 427633}, {'name': 'Cartiglio dello Zelo', 'text': 'Incanta creatura che controlli\\nQuando il Cartiglio dello Zelo entra nel campo di battaglia, una creatura bersaglio non può bloccare in questo turno.\\nLa creatura incantata prende +1/+1 e ha rapidità.', 'type': 'Incantesimo — Cartiglio Aura', 'flavor': 'Il quinto cartiglio è la convalida solenne della gloria e viene concesso solo ai caduti prescelti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427902&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e1051c9d-7cbc-4de9-bf3a-1a59daab45ab', 'multiverseId': 427902}, 'multiverseid': 427902}, {'name': '激情のカルトーシュ', 'text': 'エンチャント（あなたがコントロールするクリーチャー）\\n激情のカルトーシュが戦場に出たとき、クリーチャー１体を対象とする。このターン、それではブロックできない。\\nエンチャントされているクリーチャーは、＋１/＋１の修整を受けるとともに速攻を持つ。', 'type': 'エンチャント — オーラ・カルトーシュ', 'flavor': '第五のカルトーシュは栄光の最終的な確約であり、死んだ英雄のみに授けられる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428171&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fba00097-aed0-4360-904e-564044c1ccb8', 'multiverseId': 428171}, 'multiverseid': 428171}, {'name': '열성의 카르투슈', 'text': '당신이 조종하는 생물에게 부여\\n열성의 카르투슈가 전장에 들어올 때, 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\\n부여된 생물은 +1/+1을 받고 신속을 가진다.', 'type': '부여마법 — 마법진 카르투슈', 'flavor': '다섯 번째 카르투슈는 자격있는 망자들만 받을 수 있는 최종적인 영광의 증표다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428440&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f04c4dd8-f9dd-4750-9ee8-e501c85d2cdf', 'multiverseId': 428440}, 'multiverseid': 428440}, {'name': 'Cártula do Zelo', 'text': 'Encantar criatura que você controla\\nQuando Cártula do Zelo entra no campo de batalha, a criatura alvo não pode bloquear neste turno.\\nA criatura encantada recebe +1/+1 e tem ímpeto.', 'type': 'Encantamento — Aura Cártula', 'flavor': 'A quinta cártula é a afirmação final de glória, concedida apenas aos mortos dignos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428709&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '447c0c87-e3de-4161-afea-840de3e6d079', 'multiverseId': 428709}, 'multiverseid': 428709}, {'name': 'Картуш Рвения', 'text': 'Зачаровать существо под вашим контролем\\nКогда Картуш Рвения выходит на поле битвы, целевое существо не может блокировать в этом ходу.\\nЗачарованное существо получает +1/+1 и имеет Ускорение.', 'type': 'Чары — Аура Картуш', 'flavor': 'Пятый картуш — окончательное свидетельство славы, и его получают лишь достойные мертвецы.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428978&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6b1cfcfd-bf06-4652-a8c0-7446a0cd35a4', 'multiverseId': 428978}, 'multiverseid': 428978}, {'name': '热忱魔符', 'text': '结附于由你操控的生物\\n当热忱魔符进战场时，目标生物本回合不能进行阻挡。\\n所结附的生物得+1/+1且具有敏捷异能。', 'type': '结界～灵气／魔符', 'flavor': '第五个魔符是最后一个荣誉证明，只有光荣成仁者才能获得。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429247&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '50b50ec2-88e6-4810-87ec-5fa914fd326b', 'multiverseId': 429247}, 'multiverseid': 429247}, {'name': '熱忱魔符', 'text': '結附於由你操控的生物\\n當熱忱魔符進戰場時，目標生物本回合不能進行阻擋。\\n所結附的生物得+1/+1且具有敏捷異能。', 'type': '結界～靈氣／魔符', 'flavor': '第五個魔符是最後一個榮譽證明，只有光榮成仁者才能獲得。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429516&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1c2f4ec0-2b88-4bd2-a848-e94adebd5435', 'multiverseId': 429516}, 'multiverseid': 429516}]", "[{'name': 'Kartusche des Wissens', 'text': 'Verzaubert eine Kreatur, die du kontrollierst\\nWenn die Kartusche des Wissens ins Spiel kommt, ziehe eine Karte.\\nDie verzauberte Kreatur erhält +1/+1 und hat Flugfähigkeit.', 'type': 'Verzauberung — Aura, Kartusche', 'flavor': 'Die Kartuschen spiegeln die Erfolge der Geweihten in den Prüfungen wider.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427016&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fbbb4bd5-b234-4861-a869-8cf0b7fb0ae2', 'multiverseId': 427016}, 'multiverseid': 427016}, {'name': 'Cartucho de conocimiento', 'text': 'Encantar criatura que controlas.\\nCuando el Cartucho de conocimiento entre al campo de batalla, roba una carta.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de volar.', 'type': 'Encantamiento — Aura cartucho', 'flavor': 'En los cartuchos se registran los logros que los iniciados consiguen en las pruebas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427285&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '36a0d013-b976-4100-a2bb-ef11d9817f12', 'multiverseId': 427285}, 'multiverseid': 427285}, {'name': 'Cartouche de connaissance', 'text': 'Enchanter : une créature que vous contrôlez\\nQuand le Cartouche de connaissance arrive sur le champ de bataille, piochez une carte.\\nLa créature enchantée gagne +1/+1 et a le vol.', 'type': 'Enchantement : aura et cartouche', 'flavor': 'Les cartouches chroniquent les accomplissements des adeptes pendant les épreuves.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427554&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c59ed4af-fe65-4e97-8685-3f4620b23ea9', 'multiverseId': 427554}, 'multiverseid': 427554}, {'name': 'Cartiglio della Conoscenza', 'text': 'Incanta creatura che controlli\\nQuando il Cartiglio della Conoscenza entra nel campo di battaglia, pesca una carta.\\nLa creatura incantata prende +1/+1 e ha volare.', 'type': 'Incantesimo — Cartiglio Aura', 'flavor': 'I cartigli narrano le prodezze degli iniziati nelle ordalie.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427823&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5190bbf4-2c04-4bc4-9f3d-85fd7fa7c775', 'multiverseId': 427823}, 'multiverseid': 427823}, {'name': '知識のカルトーシュ', 'text': 'エンチャント（あなたがコントロールするクリーチャー）\\n知識のカルトーシュが戦場に出たとき、カードを１枚引く。\\nエンチャントされているクリーチャーは、＋１/＋１の修整を受けるとともに飛行を持つ。', 'type': 'エンチャント — オーラ・カルトーシュ', 'flavor': 'カルトーシュには試練での修練者の実績が記されている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428092&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'adda19c2-be11-499c-82bb-ad1d97e859a9', 'multiverseId': 428092}, 'multiverseid': 428092}, {'name': '지식의 카르투슈', 'text': '당신이 조종하는 생물에게 부여\\n지식의 카르투슈가 전장에 들어올 때, 카드 한 장을 뽑는다.\\n부여된 생물은 +1/+1을 받고 비행을 가진다.', 'type': '부여마법 — 마법진 카르투슈', 'flavor': '카르투슈는 시험에 든 입회자의 성적을 기록한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428361&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0e0d34ea-509f-4009-b874-7ad3a65d827b', 'multiverseId': 428361}, 'multiverseid': 428361}, {'name': 'Cártula do Conhecimento', 'text': 'Encantar criatura que você controla\\nQuando Cártula do Conhecimento entrar no campo de batalha, compre um card.\\nA criatura encantada recebe +1/+1 e tem voar.', 'type': 'Encantamento — Aura Cártula', 'flavor': 'As cártulas registram as conquistas dos iniciados durante as provas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428630&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'de437d28-3007-4571-bc22-7fa7fd7079da', 'multiverseId': 428630}, 'multiverseid': 428630}, {'name': 'Картуш Знаний', 'text': 'Зачаровать существо под вашим контролем\\nКогда Картуш Знаний выходит на поле битвы, возьмите карту.\\nЗачарованное существо получает +1/+1 и имеет Полет.', 'type': 'Чары — Аура Картуш', 'flavor': 'Картуши записывают достижения послушников в испытаниях.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428899&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '01e6832e-8d22-4356-8af4-934ae7a39387', 'multiverseId': 428899}, 'multiverseid': 428899}, {'name': '知识魔符', 'text': '结附于由你操控的生物\\n当知识魔符进战场时，抓一张牌。\\n所结附的生物得+1/+1且具有飞行异能。', 'type': '结界～灵气／魔符', 'flavor': '魔符记录着祀徒在祀炼中的各项成就。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429168&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7036e9c1-74cf-4519-bc52-da24be4273ad', 'multiverseId': 429168}, 'multiverseid': 429168}, {'name': '知識魔符', 'text': '結附於由你操控的生物\\n當知識魔符進戰場時，抽一張牌。\\n所結附的生物得+1/+1且具有飛行異能。', 'type': '結界～靈氣／魔符', 'flavor': '魔符記錄著祀徒在祀煉中的各項成就。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429437&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2c56a81d-b100-4641-8e62-6c52e26c703c', 'multiverseId': 429437}, 'multiverseid': 429437}]", '[{\'name\': \'Kartusche des Zusammenhalts\', \'text\': \'Verzaubert eine Kreatur, die du kontrollierst\\nWenn die Kartusche des Zusammenhalts ins Spiel kommt, erzeuge einen 1/1 weißen Krieger-Kreaturenspielstein mit Wachsamkeit.\\nDie verzauberte Kreatur erhält +1/+1 und hat Erstschlag.\', \'type\': \'Verzauberung — Aura, Kartusche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426978&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5b57023d-bd74-4ce6-99df-e9a84439eea7\', \'multiverseId\': 426978}, \'multiverseid\': 426978}, {\'name\': \'Cartucho de solidaridad\', \'text\': \'Encantar criatura que controlas.\\nCuando el Cartucho de solidaridad entre al campo de batalla, crea una ficha de criatura Guerrero blanca 1/1 con la habilidad de vigilancia.\\nLa criatura encantada obtiene +1/+1 y tiene la habilidad de dañar primero.\', \'type\': \'Encantamiento — Aura cartucho\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427247&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86716b34-3442-4e1a-b75f-a980a8f5c60e\', \'multiverseId\': 427247}, \'multiverseid\': 427247}, {\'name\': \'Cartouche de solidarité\', \'text\': "Enchanter : une créature que vous contrôlez\\nQuand le Cartouche de solidarité arrive sur le champ de bataille, créez un jeton de créature 1/1 blanche Guerrier avec la vigilance.\\nLa créature enchantée gagne +1/+1 et a l\'initiative.", \'type\': \'Enchantement : aura et cartouche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427516&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42f91a5d-d7a8-4603-9168-e80da27bee8f\', \'multiverseId\': 427516}, \'multiverseid\': 427516}, {\'name\': \'Cartiglio della Fratellanza\', \'text\': \'Incanta creatura che controlli\\nQuando il Cartiglio della Fratellanza entra nel campo di battaglia, crea una pedina creatura Guerriero 1/1 bianca con cautela.\\nLa creatura incantata prende +1/+1 e ha attacco improvviso.\', \'type\': \'Incantesimo — Cartiglio Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427785&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4c16925-49e2-4537-8b34-cebe29765bf3\', \'multiverseId\': 427785}, \'multiverseid\': 427785}, {\'name\': \'結束のカルトーシュ\', \'text\': \'エンチャント（あなたがコントロールするクリーチャー）\\n結束のカルトーシュが戦場に出たとき、警戒を持つ白の１/１の戦士・クリーチャー・トークンを１体生成する。\\nエンチャントされているクリーチャーは＋１/＋１の修整を受けるとともに先制攻撃を持つ。\', \'type\': \'エンチャント — オーラ・カルトーシュ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428054&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5f3f3eb-3416-43b3-a5c2-2b7faf68b1c1\', \'multiverseId\': 428054}, \'multiverseid\': 428054}, {\'name\': \'결속의 카르투슈\', \'text\': \'당신이 조종하는 생물에게 부여\\n결속의 카르투슈가 전장에 들어올 때, 경계를 가진 1/1 백색 전사 생물 토큰 한 개를 만든다.\\n부여된 생물은 +1/+1을 받고 선제공격을 가진다.\', \'type\': \'부여마법 — 마법진 카르투슈\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428323&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ab260f01-66c2-4abc-a32e-705af873f7eb\', \'multiverseId\': 428323}, \'multiverseid\': 428323}, {\'name\': \'Cártula da Solidariedade\', \'text\': \'Encantar criatura que você controla\\nQuando Cártula da Solidariedade entrar no campo de batalha, crie uma ficha de criatura branca 1/1 do tipo Guerreiro com vigilância.\\nA criatura encantada recebe +1/+1 e tem iniciativa.\', \'type\': \'Encantamento — Aura Cártula\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428592&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23d192ea-029f-4646-82de-6134158c1cf1\', \'multiverseId\': 428592}, \'multiverseid\': 428592}, {\'name\': \'Картуш Сплоченности\', \'text\': \'Зачаровать существо под вашим контролем\\nКогда Картуш Сплоченности выходит на поле битвы, создайте одну фишку существа 1/1 белый Воин с Бдительностью.\\nЗачарованное существо получает +1/+1 и имеет Первый удар.\', \'type\': \'Чары — Аура Картуш\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428861&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6f373b1-4c66-4d98-a97c-4d816addc64d\', \'multiverseId\': 428861}, \'multiverseid\': 428861}, {\'name\': \'团结魔符\', \'text\': \'结附于由你操控的生物\\n当团结魔符进战场时，派出一个1/1白色，具警戒异能的战士衍生生物。\\n所结附的生物得+1/+1且具有先攻异能。\', \'type\': \'结界～灵气／魔符\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429130&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e20c655-0ded-44a2-bc45-463f439da6c8\', \'multiverseId\': 429130}, \'multiverseid\': 429130}, {\'name\': \'團結魔符\', \'text\': \'結附於由你操控的生物\\n當團結魔符進戰場時，派出一個1/1白色，具警戒異能的戰士衍生生物。\\n所結附的生物得+1/+1且具有先攻異能。\', \'type\': \'結界～靈氣／魔符\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429399&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2565366a-c04a-4720-ac9c-f157f943c0ab\', \'multiverseId\': 429399}, \'multiverseid\': 429399}]', '[{\'name\': \'Kefnet der Achtsame\', \'text\': \'Fliegend, Unzerstörbar\\nKefnet der Achtsame kann nicht angreifen oder blocken, es sei denn, du hast sieben oder mehr Karten auf deiner Hand.\\n{3}{U}: Ziehe eine Karte, dann kannst du ein Land, das du kontrollierst, auf die Hand seines Besitzers zurückbringen.\', \'type\': \'Legendäre Kreatur — Gott\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427030&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ac6fff1-5e4a-44e0-91b8-98d245a7591e\', \'multiverseId\': 427030}, \'multiverseid\': 427030}, {\'name\': \'Kefnet, el Conocedor\', \'text\': \'Vuela, indestructible.\\nKefnet, el Conocedor no puede atacar ni bloquear a menos que tengas siete cartas o más en tu mano.\\n{3}{U}: Roba una carta. Luego, puedes regresar una tierra que controlas a la mano de su propietario.\', \'type\': \'Criatura legendaria — Deidad\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427299&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd32c734-131e-44c1-be6f-b16669bf3c1d\', \'multiverseId\': 427299}, \'multiverseid\': 427299}, {\'name\': \'Kefnet le Clairvoyant\', \'text\': "Vol, indestructible\\nKefnet le Clairvoyant ne peut ni attaquer ni bloquer à moins que vous n\'ayez au moins sept cartes en main.\\n{3}{U} : Piochez une carte, puis vous pouvez renvoyer un terrain que vous contrôlez dans la main de son propriétaire.", \'type\': \'Créature légendaire : dieu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427568&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65675715-30d8-4a49-9644-25f50a13b90e\', \'multiverseId\': 427568}, \'multiverseid\': 427568}, {\'name\': \'Kefnet il Ponderante\', \'text\': \'Volare, indistruttibile\\nKefnet il Ponderante non può attaccare o bloccare a meno che tu non abbia sette o più carte in mano.\\n{3}{U}: Pesca una carta, poi puoi far tornare una terra che controlli in mano al suo proprietario.\', \'type\': \'Creatura Leggendaria — Dio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427837&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'88a08b38-7283-4988-9b73-98beb870a13a\', \'multiverseId\': 427837}, \'multiverseid\': 427837}, {\'name\': \'周到の神ケフネト\', \'text\': \'飛行、破壊不能\\nあなたの手札のカードが７枚以上でないかぎり、周到の神ケフネトでは攻撃したりブロックしたりできない。\\n{3}{U}：カードを１枚引く。その後、あなたはあなたがコントロールする土地１つをオーナーの手札に戻してもよい。\', \'type\': \'伝説のクリーチャー — 神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428106&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ee66df90-3383-4dbc-86cd-24b6890266f7\', \'multiverseId\': 428106}, \'multiverseid\': 428106}, {\'name\': \'신중의 케프넷\', \'text\': \'비행, 무적\\n당신의 손에 카드가 일곱 장 이상 있지 않다면, 신중의 케프넷은 공격하거나 방어할 수 없다.\\n{3}{U}: 카드 한 장을 뽑는다. 그 후, 당신은 당신이 조종하는 대지 한 개를 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'전설적 생물 — 신\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428375&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'028901ea-6526-4203-a646-ab62cd246e2a\', \'multiverseId\': 428375}, \'multiverseid\': 428375}, {\'name\': \'Kefnet, o Consciente\', \'text\': \'Voar, indestrutível\\nKefnet, o Consciente, não pode atacar nem bloquear, a menos que você tenha sete ou mais cards na mão.\\n{3}{U}: Compre um card; em seguida, você pode devolver um terreno que você controla para a mão de seu dono.\', \'type\': \'Criatura Lendária — Deus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428644&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79c0b6f2-d496-4054-b01c-89d2631d3627\', \'multiverseId\': 428644}, \'multiverseid\': 428644}, {\'name\': \'Кефнет Всеведущий\', \'text\': \'Полет, Неразрушимость\\nКефнет Всеведущий не может атаковать или блокировать, если у вас в руке меньше семи карт.\\n{3}{U}: возьмите карту, затем вы можете вернуть землю под вашим контролем в руку ее владельца.\', \'type\': \'Легендарное Существо — Бог\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428913&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a1a10e61-e08e-468f-94c1-9f33ec7b2771\', \'multiverseId\': 428913}, \'multiverseid\': 428913}, {\'name\': \'心智神刻法涅\', \'text\': \'飞行，不灭\\n除非你的手牌有七张或更多，否则心智神刻法涅不能进行攻击或阻挡。\\n{3}{U}：抓一张牌，然后你可以将一个由你操控的地移回其拥有者的手上。\', \'type\': \'传奇生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429182&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7c86e2e4-3e97-40de-abc8-6f6e2f40cb2f\', \'multiverseId\': 429182}, \'multiverseid\': 429182}, {\'name\': \'心智神刻法涅\', \'text\': \'飛行，不滅\\n除非你的手牌有七張或更多，否則心智神刻法涅不能進行攻擊或阻擋。\\n{3}{U}：抽一張牌，然後你可以將一個由你操控的地移回其擁有者的手上。\', \'type\': \'傳奇生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429451&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'630bf9e8-597b-4b1e-a270-21c2bb7d5145\', \'multiverseId\': 429451}, \'multiverseid\': 429451}]', '[{\'name\': \'Kefnets Monument\', \'text\': \'Blaue Kreaturenzauber, die du wirkst, kosten beim Wirken {1} weniger.\\nImmer wenn du einen Kreaturenzauber wirkst, bestimme eine Kreatur deiner Wahl, die ein Gegner kontrolliert. Sie enttappt nicht während des nächsten Enttappsegments ihres Beherrschers.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Die Auserwählten sollen ihren Verstand öffnen, um die glorreichen Wunder des Jenseits zu begreifen." —Inschrift am Monument\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427202&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d8d8284-dc0e-4621-9baa-b98cb43ef905\', \'multiverseId\': 427202}, \'multiverseid\': 427202}, {\'name\': \'Monumento a Kefnet\', \'text\': \'Te cuesta {1} menos lanzar los hechizos de criatura azules.\\nSiempre que lances un hechizo de criatura, la criatura objetivo que controla un oponente no se endereza durante el próximo paso de enderezar de su controlador.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"Los dignos cultivarán una mente ágil para percibir las gloriosas maravillas que les esperan". —Inscripción en el monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427471&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bea9f927-c8ea-4e1c-a64d-11384bfacb21\', \'multiverseId\': 427471}, \'multiverseid\': 427471}, {\'name\': \'Monument de Kefnet\', \'text\': "Les sorts de créature bleus que vous lancez coûtent {1} de moins à lancer.\\nÀ chaque fois que vous lancez un sort de créature, une créature ciblée qu\'un adversaire contrôle ne se dégage pas pendant la prochaine étape de dégagement de son contrôleur.", \'type\': \'Artefact légendaire\', \'flavor\': "« Les valeureux cultiveront leur vivacité d\'esprit pour percevoir les glorieuses merveilles qui les attendent. » —Inscription sur le monument", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427740&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0ccf94a-5786-4f36-8fe1-f9974c259733\', \'multiverseId\': 427740}, \'multiverseid\': 427740}, {\'name\': \'Monumento a Kefnet\', \'text\': \'Le magie creatura blu che lanci costano {1} in meno per essere lanciate.\\nOgniqualvolta lanci una magia creatura, una creatura bersaglio controllata da un avversario non STAPpa durante il prossimo STAP del suo controllore.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'"I prescelti dovranno sviluppare una mente agile, in grado di percepire le gloriose meraviglie che li attendono." —Iscrizione sul monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6804a701-5c4a-4ed5-968d-ca65e7278d41\', \'multiverseId\': 428009}, \'multiverseid\': 428009}, {\'name\': \'ケフネトの碑\', \'text\': \'あなたが青のクリーチャー・呪文を唱えるためのコストは{1}少なくなる。\\nあなたがクリーチャー・呪文を１つ唱えるたび、対戦相手がコントロールするクリーチャー１体を対象とする。それは、それのコントローラーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'「蓋世の英雄は自身を待つ栄光の驚異を察知する明敏な心を育てねばならぬ。」 ――碑文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428278&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5072c38-cf67-4cb5-9d87-6487d2e19ba6\', \'multiverseId\': 428278}, \'multiverseid\': 428278}, {\'name\': \'케프넷 기념비\', \'text\': \'당신이 발동하는 청색 생물 주문들은 발동하는 데 {1}이 덜 든다.\\n당신이 생물 주문을 발동할 때마다, 상대가 조종하는 생물을 목표로 정한다. 그 생물은 조종자의 다음 언탭단에 언탭되지 않는다.\', \'type\': \'전설적 마법물체\', \'flavor\': \'"자격있는 자들은 예리한 정신을 수양해 그들을 기다리는 영광의 건축물들을 알아볼 수 있어야 한다." —기념비 비문\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428547&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5ebfdfaf-e758-479c-8706-d783b3c48767\', \'multiverseId\': 428547}, \'multiverseid\': 428547}, {\'name\': \'Monumento de Kefnet\', \'text\': \'As mágicas de criatura azuis que você conjura custam {1} a menos para serem conjuradas.\\nToda vez que você conjura uma mágica de criatura, a criatura alvo que um oponente controla não é desvirada durante a próxima etapa de desvirar de seu controlador.\', \'type\': \'Artefato Lendário\', \'flavor\': \'"Os dignos devem cultivar uma mente ágil para perceber as gloriosas maravilhas que os aguardam." — Inscrição no monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428816&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98ce48c4-ef7e-4ed9-a2a2-882a671be9ce\', \'multiverseId\': 428816}, \'multiverseid\': 428816}, {\'name\': \'Монумент Кефнета\', \'text\': \'Разыгрываемые вами заклинания синих существ стоят на {1} меньше.\\nКаждый раз, когда вы разыгрываете заклинание существа, целевое существо под контролем оппонента не разворачивается во время следующего шага разворота контролирующего его игрока.\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'«Достойные должны воспитывать гибкость ума, дабы постичь великие чудеса, что ожидают их». — надпись на монументе\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429085&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1cb80671-af6a-4fab-9fcd-9a9e487847b5\', \'multiverseId\': 429085}, \'multiverseid\': 429085}, {\'name\': \'刻法涅纪念碑\', \'text\': \'你施放的蓝色生物咒语减少{1}来施放。\\n每当你施放生物咒语时，目标由对手操控的生物于其操控者的下一个重置步骤中不能重置。\', \'type\': \'传奇神器\', \'flavor\': \'「豪英应机敏好学，留待身后通晓荣耀妙闻。」 ～纪念碑铭文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429354&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c0c13163-d16e-47d0-a530-afd739362929\', \'multiverseId\': 429354}, \'multiverseid\': 429354}, {\'name\': \'刻法涅紀念碑\', \'text\': \'你施放的藍色生物咒語減少{1}來施放。\\n每當你施放生物咒語時，目標由對手操控的生物於其操控者的下一個重置步驟中不能重置。\', \'type\': \'傳奇神器\', \'flavor\': \'「豪英應機敏好學，留待身後通曉榮耀妙聞。」 ～紀念碑銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429623&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ec9c2eea-b2ff-43e2-9e16-da662989d086\', \'multiverseId\': 429623}, \'multiverseid\': 429623}]', '[{\'name\': \'Khenra-Streitwagenlenker\', \'text\': \'Verursacht Trampelschaden\\nAndere Kreaturen, die du kontrollierst, verursachen Trampelschaden.\', \'type\': \'Kreatur — Schakal, Krieger\', \'flavor\': \'„Wir werden erst zu Füßen des Gott-Pharaos zum Stehen kommen." —Motto der Streitwagenlenker der Tah-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427172&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'27b98b05-5549-4008-a9c1-cd27843bc272\', \'multiverseId\': 427172}, \'multiverseid\': 427172}, {\'name\': \'Auriga khenra\', \'text\': \'Arrolla.\\nLas otras criaturas que controlas tienen la habilidad de arrollar.\', \'type\': \'Criatura — Guerrero chacal\', \'flavor\': \'"Nosotros mantenemos el rumbo". —Lema de los aurigas de la simiente Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427441&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'143b740c-1cf6-4f5e-ad5c-467ab09b9e85\', \'multiverseId\': 427441}, \'multiverseid\': 427441}, {\'name\': \'Aurige khenra\', \'text\': \'Piétinement\\nLes autres créatures que vous contrôlez ont le piétinement.\', \'type\': \'Créature : chacal et guerrier\', \'flavor\': \'« Nous ne faisons aucun écart. » —Devise des auriges de la moisson Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'48373faf-aba0-493a-805a-a385bfd2abee\', \'multiverseId\': 427710}, \'multiverseid\': 427710}, {\'name\': \'Auriga Khenra\', \'text\': \'Travolgere\\nLe altre creature che controlli hanno travolgere.\', \'type\': \'Creatura — Guerriero Sciacallo\', \'flavor\': \'"Non ci fermeremo." —Motto degli aurighi della messe Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427979&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0cb9d4d-25a5-4fe0-9696-877aca7c149e\', \'multiverseId\': 427979}, \'multiverseid\': 427979}, {\'name\': \'ケンラの戦車乗り\', \'text\': \'トランプル\\nあなたがコントロールする他のクリーチャーはトランプルを持つ。\', \'type\': \'クリーチャー — ジャッカル・戦士\', \'flavor\': \'「我ら逸れることなし。」 ――ター一門の戦車乗りの心得\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428248&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb06672a-a95a-46f7-8992-2db0723e7af6\', \'multiverseId\': 428248}, \'multiverseid\': 428248}, {\'name\': \'켄라 전차대\', \'text\': \'돌진\\n당신이 조종하는 다른 생물들은 돌진을 가진다.\', \'type\': \'생물 — 자칼 전사\', \'flavor\': \'"우린 방향을 바꾸지 않아." —타 입문자 전차대 신조\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428517&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e5882b0e-6f6b-4dcd-ad68-326d545faed4\', \'multiverseId\': 428517}, \'multiverseid\': 428517}, {\'name\': \'Auriga Khenra\', \'text\': \'Atropelar\\nAs outras criaturas que você controla têm atropelar.\', \'type\': \'Criatura — Chacal Guerreiro\', \'flavor\': \'"Nós não desviamos." — Lema dos aurigas da safra Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428786&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'189e4462-b753-40b4-855c-c7bcff88eac4\', \'multiverseId\': 428786}, \'multiverseid\': 428786}, {\'name\': \'Хенра-Колесничий\', \'text\': \'Пробивной удар\\nДругие существа под вашим контролем имеют Пробивной удар.\', \'type\': \'Существо — Шакал Воин\', \'flavor\': \'«Мы не сворачиваем». — девиз колесничих снопа Тах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429055&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e42a9ed-3d61-44f1-9e9c-b6ae33cf3e8d\', \'multiverseId\': 429055}, \'multiverseid\': 429055}, {\'name\': \'胡狼人御夫\', \'text\': \'践踏\\n由你操控的其他生物具有践踏异能。\', \'type\': \'生物～豺狼／战士\', \'flavor\': \'「行不改道。」 ～塔哈祀群御夫座右铭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429324&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4a60b28-2513-465c-a2fc-92e2a1430d39\', \'multiverseId\': 429324}, \'multiverseid\': 429324}, {\'name\': \'胡狼人御夫\', \'text\': \'踐踏\\n由你操控的其他生物具有踐踏異能。\', \'type\': \'生物～豺狼／戰士\', \'flavor\': \'「行不改道。」 ～塔哈祀群御夫座右銘\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429593&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'66922815-0e75-4c9b-8e90-8c2e01fbb1ab\', \'multiverseId\': 429593}, \'multiverseid\': 429593}]', '[{\'name\': \'Knochenpicker\', \'text\': \'Der Knochenpicker kostet beim Wirken {3} weniger, falls in diesem Zug eine Kreatur gestorben ist.\\nFliegend, Todesberührung\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Sie sind das Begrüßungskomitee, das jeden Abtrünnigen auf seinem Weg ins Exil empfängt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427052&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f01029e-4deb-45d7-86f0-2e1cb01f4962\', \'multiverseId\': 427052}, \'multiverseid\': 427052}, {\'name\': \'Buscadespojos\', \'text\': \'Te cuesta {3} menos lanzar el Buscadespojos si una criatura murió este turno.\\nVuela, toque mortal.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Son los primeros en dar la bienvenida a los disidentes en su camino al exilio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427321&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'91141bed-7711-4dc4-b329-ecd201a49e0b\', \'multiverseId\': 427321}, \'multiverseid\': 427321}, {\'name\': "Glaneur d\'os", \'text\': "Le Glaneur d\'os coûte {3} de moins à lancer si une créature est morte ce tour-ci.\\nVol, contact mortel", \'type\': \'Créature : oiseau\', \'flavor\': "Ils sont les premiers à accueillir les dissidents sur la route de l\'exil.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427590&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'daeb4e08-3f05-43d9-a2db-3c959ecffa14\', \'multiverseId\': 427590}, \'multiverseid\': 427590}, {\'name\': \'Spolpaossa\', \'text\': \'Lo Spolpaossa costa {3} in meno per essere lanciato se è morta una creatura in questo turno.\\nVolare, tocco letale\', \'type\': \'Creatura — Uccello\', \'flavor\': "Sono i primi ad accogliere i dissenzienti in viaggio verso l\'esilio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427859&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2efd7cd3-b60c-4207-bf02-62965966d0d0\', \'multiverseId\': 427859}, \'multiverseid\': 427859}, {\'name\': \'ホネツツキ\', \'text\': \'このターンにクリーチャーが死亡していたなら、ホネツツキを唱えるためのコストは{3}少なくなる。\\n飛行、接死\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'流刑地への旅で造反者を最初に出迎えるのはホネツツキだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428128&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'304f2ab4-64a3-4137-af07-3556187833ef\', \'multiverseId\': 428128}, \'multiverseid\': 428128}, {\'name\': \'뼈 청소부\', \'text\': \'이 턴에 생물이 죽었다면, 뼈 청소부의 발동 비용이 {3} 감소한다.\\n비행, 치명타\', \'type\': \'생물 — 조류\', \'flavor\': \'이 놈들이 추방된 반대자들을 가장 먼저 맞아준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428397&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'242857e2-1f61-4e76-88f4-038cda12988e\', \'multiverseId\': 428397}, \'multiverseid\': 428397}, {\'name\': \'Pega-ossos\', \'text\': \'Pega-ossos custa {3} a menos para ser conjurado se uma criatura morreu neste turno.\\nVoar, toque mortífero\', \'type\': \'Criatura — Ave\', \'flavor\': \'Eles são os primeiros a receber os dissidentes em sua jornada para o exílio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428666&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50309f34-d223-449c-8f6c-887d589bc4d3\', \'multiverseId\': 428666}, \'multiverseid\': 428666}, {\'name\': \'Трупоед\', \'text\': \'Разыгрывание Трупоеда стоит на {3} меньше, если в этом ходу умерло существо.\\nПолет, Смертельное касание\', \'type\': \'Существо — Птица\', \'flavor\': \'Они первыми встречают инакомыслящих на пути в изгнание.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428935&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57b45f41-7894-43cb-acd9-1bcc561c0e50\', \'multiverseId\': 428935}, \'multiverseid\': 428935}, {\'name\': \'食骨鸟\', \'text\': \'如果本回合有生物死去，则食骨鸟减少{3}来施放。\\n飞行，死触\', \'type\': \'生物～鸟\', \'flavor\': \'它们是逆徒在流放路途中的首批访客。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429204&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d0a2e116-2f7b-4774-a09f-1e4a5be78d12\', \'multiverseId\': 429204}, \'multiverseid\': 429204}, {\'name\': \'食骨鳥\', \'text\': \'如果本回合有生物死去，則食骨鳥減少{3}來施放。\\n飛行，死觸\', \'type\': \'生物～鳥\', \'flavor\': \'牠們是逆徒在流放路途中的首批訪客。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429473&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'940a81b5-4e5c-441e-9669-8535aa35d559\', \'multiverseId\': 429473}, \'multiverseid\': 429473}]', '[{\'name\': \'Kolossoped\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'„Ist der Feind größer, musst du schneller sein. Ist er stärker, musst du gewitzter sein. Gelingt dir das nicht, hast du keinen Platz im Jenseits unseres Gott-Pharaos verdient." —Rhonas, Gott der Stärke\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427132&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c13b335e-4f23-458f-a247-73a07863bc74\', \'multiverseId\': 427132}, \'multiverseid\': 427132}, {\'name\': \'Colosópodo\', \'type\': \'Criatura — Insecto\', \'flavor\': \'"Si es más grande, debes ser más rápido. Si es más fuerte, debes ser más listo. Si no, jamás conseguirás tener tu lugar en el perfecto más allá del Dios Faraón". —Rhonas, dios de la fuerza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427401&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98b681fb-e8e1-4846-89ac-052921d9e04a\', \'multiverseId\': 427401}, \'multiverseid\': 427401}, {\'name\': \'Colossapède\', \'type\': \'Créature : insecte\', \'flavor\': "« Si la cible est plus grosse, soyez plus rapide. Si elle est plus forte, soyez plus agile. N\'acceptez pas la médiocrité où vous n\'aurez jamais votre place dans l\'au-delà idéal de notre Dieu-Pharaon. » —Rhonas, dieu de la Force", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427670&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74ba640c-e327-4cdf-a211-8c19c65f07f6\', \'multiverseId\': 427670}, \'multiverseid\': 427670}, {\'name\': \'Colossipede\', \'type\': \'Creatura — Insetto\', \'flavor\': \'"Se è più grande di voi, siate più rapidi. Se è più forte di voi, siate più astuti. Altrimenti non conquisterete mai un posto nell\\\'idilliaco aldilà del nostro Dio Faraone." —Rhonas, dio della forza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427939&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e47fe016-ca89-42ed-a0a0-b6c4d7daa708\', \'multiverseId\': 427939}, \'multiverseid\': 427939}, {\'name\': \'巨大百足\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'「大きさで負けるなら素早さで勝ち、力で負けるなら切れ味で勝つ。さもなくば、王神の完璧な来世に名を連ねることはできぬ。」 ――活力の神、ロナス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428208&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1aca1fda-0356-4b15-bf4e-051171b048ff\', \'multiverseId\': 428208}, \'multiverseid\': 428208}, {\'name\': \'거대지네\', \'type\': \'생물 — 곤충\', \'flavor\': \'"상대가 더 크다면 넌 더 민첩해야 한다. 상대가 더 강하다면 넌 더 영리해야 한다. 그렇지 않으면 신 파라오가 지배하는 완벽한 사후 세계에 들어가지 못한다." —힘의 신 로나스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428477&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'53c8e538-a948-4ac6-98b3-a13612c9cffa\', \'multiverseId\': 428477}, \'multiverseid\': 428477}, {\'name\': \'Colossópode\', \'type\': \'Criatura — Inseto\', \'flavor\': \'"Se ele for maior, você precisará ser mais rápido. Se for mais forte, você precisará ser mais esperto. Qualquer coisa menos que isso e você jamais conquistará um lugar na perfeita vida após a morte de nosso Faraó-Deus." — Rhonas, deus da força\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428746&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'03b1d168-c914-4ddd-8dde-4b80d909614f\', \'multiverseId\': 428746}, \'multiverseid\': 428746}, {\'name\': \'Колоссоножка\', \'type\': \'Существо — Насекомое\', \'flavor\': \'«Если она больше, тебе нужно быть быстрее. Если она сильнее, тебе нужно быть хитрее. Не справишься — и тебе не видать места в идеальной загробной жизни Бога-Фараона». — Ронас, бог силы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429015&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fc272b96-401f-4178-b663-d0bad891ef99\', \'multiverseId\': 429015}, \'multiverseid\': 429015}, {\'name\': \'庞巨蜈蚣\', \'type\': \'生物～昆虫\', \'flavor\': \'「如果它比你更大，你就要更灵活。如果它比你更强，你就要更专注。稍一松懈，你就无法在法老神完美来世中赢得一席之地。」 ～力量之神罗纳斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429284&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'69d3a32e-f127-4fe6-9522-1fcb220c99e5\', \'multiverseId\': 429284}, \'multiverseid\': 429284}, {\'name\': \'龐巨蜈蚣\', \'type\': \'生物～昆蟲\', \'flavor\': \'「如果他比你更大，你就要更靈活。如果他比你更強，你就要更專注。稍一鬆懈，你就無法在法老神完美來世中贏得一席之地。」 ～力量之神羅納斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429553&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3353bae3-818d-41c2-8b83-e33fa2d353a3\', \'multiverseId\': 429553}, \'multiverseid\': 429553}]', '[{\'name\': \'Koordinierter Schlag\', \'text\': \'Enttappe bis zu zwei Kreaturen deiner Wahl. Jede von ihnen erhält +2/+2 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Khenra kommen fast immer als Zwillinge zur Welt. Ihre instinktive Vertrautheit miteinander macht sie zu perfekten Kameraden im Kampf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427161&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6fd6a8a1-fb25-4b44-9330-852bcdc6e458\', \'multiverseId\': 427161}, \'multiverseid\': 427161}, {\'name\': \'Ataque sincronizado\', \'text\': \'Endereza hasta dos criaturas objetivo. Cada una obtiene +2/+2 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Los khenra casi siempre nacen por parejas. Su conexión instintiva favorece su estilo de lucha preferido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc90b9ef-4764-4531-9c2b-fb2d40bb538f\', \'multiverseId\': 427430}, \'multiverseid\': 427430}, {\'name\': \'Frappe synchronisée\', \'text\': "Dégagez jusqu\'à deux créatures ciblées. Chacune d\'elles gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'Les khenras naissent presque toujours par deux. Leur connexion jumelle se prête à merveille à leur style de combat préféré.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427699&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc4675f5-c255-4fd2-99bc-9102dacdaef1\', \'multiverseId\': 427699}, \'multiverseid\': 427699}, {\'name\': \'Colpo Sincronizzato\', \'text\': \'STAPpa fino a due creature bersaglio. Ognuna di esse prende +2/+2 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Quasi tutti i khenra nascono come gemelli. Il loro legame istintivo si adatta alla perfezione al loro stile di combattimento preferito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427968&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'425e8247-58d2-45ce-b53c-c46d6bec1bb1\', \'multiverseId\': 427968}, \'multiverseid\': 427968}, {\'name\': \'同期した一撃\', \'text\': \'クリーチャー最大２体を対象とし、それらをアンタップする。ターン終了時まで、それらはそれぞれ＋２/＋２の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'ほとんどのケンラは双子で生まれる。ケンラが得意とする戦術では、その本能的な繋がりがものをいう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428237&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f61206f6-ab61-464b-bc9d-929e0c5e493e\', \'multiverseId\': 428237}, \'multiverseid\': 428237}, {\'name\': \'동시 공격\', \'text\': \'생물을 최대 두 개까지 목표로 정한다. 그 생물들을 언탭한다. 그 생물들은 턴종료까지 +2/+2를 받는다.\', \'type\': \'순간마법\', \'flavor\': \'켄라는 항상 쌍둥이로 태어난다. 이들은 본능적 유대감을 통해 원하는 전투 방식을 보여준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428506&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e58eb44e-7dad-4afa-8f78-fe06340ad79f\', \'multiverseId\': 428506}, \'multiverseid\': 428506}, {\'name\': \'Golpe Sincronizado\', \'text\': \'Desvire até duas criaturas alvo. Cada uma recebe +2/+2 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os khenras quase sempre nascem gêmeos. Sua conexão instintiva se adequa bem a seu estilo de luta preferido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428775&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'826dddfa-c0f7-4853-81f5-6198c9864e5d\', \'multiverseId\': 428775}, \'multiverseid\': 428775}, {\'name\': \'Одновременный Удар\', \'text\': \'Разверните не более двух целевых существ. Каждое из них получает +2/+2 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Хенра почти всегда рождаются близнецами. Их природная связь лежит в основе их любимого стиля боя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429044&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4cd691f7-48ed-4e44-8bf6-77f2e8cfdd45\', \'multiverseId\': 429044}, \'multiverseid\': 429044}, {\'name\': \'协同攻击\', \'text\': \'重置至多两个目标生物。它们各得+2/+2直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'胡狼人几乎都是成对出生。彼此之间的天生联系让们能够自如施展擅长的格斗方式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429313&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b14990b-619c-4cfe-9455-35cbfd374372\', \'multiverseId\': 429313}, \'multiverseid\': 429313}, {\'name\': \'協同攻擊\', \'text\': \'重置至多兩個目標生物。它們各得+2/+2直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'胡狼人幾乎都是成對出生。彼此之間的天生聯繫讓們能夠自如施展擅長的格鬥方式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429582&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'458f2cac-abc9-44b0-8ec4-f5df8c37aac8\', \'multiverseId\': 429582}, \'multiverseid\': 429582}]', '[{\'name\': \'Kriegsfeuer-Speerschleuderer\', \'text\': \'Wenn der Kriegsfeuer-Speerschleuderer ins Spiel kommt, fügt er einer Kreatur deiner Wahl, die ein Gegner kontrolliert, X Schadenspunkte zu, wobei X gleich der Anzahl an Spontanzauber- und Hexereikarten in deinem Friedhof ist.\', \'type\': \'Kreatur — Minotaurus, Krieger\', \'flavor\': \'Minotauren bevorzugen Magie, die sich in flammenumhüllten Waffen manifestiert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427126&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'59c0e35d-b53b-4255-857b-b4c5418279e0\', \'multiverseId\': 427126}, \'multiverseid\': 427126}, {\'name\': \'Jabalinero fuegobélico\', \'text\': \'Cuando el Jabalinero fuegobélico entre al campo de batalla, hace X puntos de daño a la criatura objetivo que controla un oponente, donde X es la cantidad de cartas de instantáneo y de conjuro en tu cementerio.\', \'type\': \'Criatura — Guerrero minotauro\', \'flavor\': \'Los minotauros prefieren la magia que se manifiesta en forma de armas llameantes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427395&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3928de18-9f39-4d76-a4f8-b7f222a02532\', \'multiverseId\': 427395}, \'multiverseid\': 427395}, {\'name\': \'Javelinier au feu de guerre\', \'text\': "Quand le Javelinier au feu de guerre arrive sur le champ de bataille, il inflige X blessures à une créature ciblée qu\'un adversaire contrôle, X étant le nombre de cartes d\'éphémère et de rituel dans votre cimetière.", \'type\': \'Créature : minotaure et guerrier\', \'flavor\': \'Les minotaures préfèrent la magie qui matérialise des armes nimbées de feu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427664&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0959c568-903a-4b92-9d21-6842d1bb5efa\', \'multiverseId\': 427664}, \'multiverseid\': 427664}, {\'name\': \'Giavellottiere Infiammaguerre\', \'text\': \'Quando il Giavellottiere Infiammaguerre entra nel campo di battaglia, infligge X danni a una creatura bersaglio controllata da un avversario, dove X è il numero di carte istantaneo e stregoneria nel tuo cimitero.\', \'type\': \'Creatura — Guerriero Minotauro\', \'flavor\': \'I minotauri prediligono la magia che si manifesta sotto forma di armi avvolte nelle fiamme.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427933&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'924a594c-9bd7-48de-b0da-704c25deb01d\', \'multiverseId\': 427933}, \'multiverseid\': 427933}, {\'name\': \'戦炎の投槍手\', \'text\': \'戦炎の投槍手が戦場に出たとき、対戦相手がコントロールするクリーチャー１体を対象とする。戦炎の投槍手はそれにＸ点のダメージを与える。Ｘはあなたの墓地にあるインスタントかソーサリーであるカードの総数に等しい。\', \'type\': \'クリーチャー — ミノタウルス・戦士\', \'flavor\': \'ミノタウルスが好むのは炎に包まれた武器のような魔法である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428202&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24ae070e-47eb-4252-b202-86e51056497a\', \'multiverseId\': 428202}, \'multiverseid\': 428202}, {\'name\': \'전쟁화염 투창병\', \'text\': \'전쟁화염 투창병이 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 전쟁화염 투창병은 그 생물에게 피해 X점을 입힌다. X는 당신의 무덤에 있는 순간마법과 집중마법 카드의 개수다.\', \'type\': \'생물 — 미노타우로스 전사\', \'flavor\': \'미노타우로스는 화염에 휩싸인 무기를 소환하는 마법을 즐겨 쓴다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428471&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bf2fd7c3-03ac-4202-86ff-890ee3c61e2b\', \'multiverseId\': 428471}, \'multiverseid\': 428471}, {\'name\': \'Zagaieiro Belígneo\', \'text\': \'Quando Zagaieiro Belígneo entra no campo de batalha, ele causa X pontos de dano à criatura alvo que um oponente controla, sendo X o número de cards de mágica instantânea ou feitiço em seu cemitério.\', \'type\': \'Criatura — Minotauro Guerreiro\', \'flavor\': \'Os minotauros preferem magias que se manifestem na forma de armas envoltas em chamas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428740&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c74be5c6-2c87-4bfb-b050-b5c54b3fc139\', \'multiverseId\': 428740}, \'multiverseid\': 428740}, {\'name\': \'Копьеносец Огня Войны\', \'text\': \'Когда Копьеносец Огня Войны выходит на поле битвы, он наносит X повреждений целевому существу под контролем оппонента, где X — количество карт мгновенных заклинаний и заклинаний волшебства на вашем кладбище.\', \'type\': \'Существо — Минотавр Воин\', \'flavor\': \'Минотаврам нравится магия, проявляющаяся в виде охваченного пламенем оружия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429009&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9582b76e-3755-466f-a6e8-c973d571d365\', \'multiverseId\': 429009}, \'multiverseid\': 429009}, {\'name\': \'火矛掷手\', \'text\': \'当火矛掷手进战场时，它向目标由对手操控的生物造成X点伤害，X为你坟墓场中瞬间与法术牌的数量加总。\', \'type\': \'生物～牛头怪／战士\', \'flavor\': \'牛头怪偏好可具现为炽焰武器的魔法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429278&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3f6f345-f550-4d6e-853d-adfc54a3e955\', \'multiverseId\': 429278}, \'multiverseid\': 429278}, {\'name\': \'火矛擲手\', \'text\': \'當火矛擲手進戰場時，它向目標由對手操控的生物造成X點傷害，X為你墳墓場中瞬間與巫術牌的數量加總。\', \'type\': \'生物～牛頭怪／戰士\', \'flavor\': \'牛頭怪偏好可具現為熾焰武器的魔法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429547&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7012cebb-9b30-42c0-9e80-06840490b3ae\', \'multiverseId\': 429547}, \'multiverseid\': 429547}]', '[{\'name\': \'Krokodil des Scheidewegs\', \'text\': \'Eile\\nWenn das Krokodil des Scheidewegs ins Spiel kommt, lege eine -1/-1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Krokodil\', \'flavor\': \'„Alles, was einem in der Prüfung begegnet, hat Reißzähne und nichts davon will nur spielen." —Rhonas, Gott der Stärke\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427133&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4654e13-e39b-4d0c-bb2a-5832164b8841\', \'multiverseId\': 427133}, \'multiverseid\': 427133}, {\'name\': \'Cocodrilo de La Encrucijada\', \'text\': \'Prisa.\\nCuando el Cocodrilo de La Encrucijada entre al campo de batalla, pon un contador -1/-1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Cocodrilo\', \'flavor\': \'"Todo lo que compone la prueba tiene dientes. O los superas, o los alimentas". —Rhonas, dios de la fuerza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0288dc05-3fd1-42fc-a78b-06b81acc5f73\', \'multiverseId\': 427402}, \'multiverseid\': 427402}, {\'name\': \'Crocodile de la Traversée\', \'text\': \'Célérité\\nQuand le Crocodile de la Traversée arrive sur le champ de bataille, mettez un marqueur -1/-1 sur une créature ciblée que vous contrôlez.\', \'type\': \'Créature : crocodile\', \'flavor\': \'« Pendant les épreuves, tous les dangers ont des dents. Surmontez-les, ou nourrissez-les. » —Rhonas, dieu de la Force\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427671&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a47c6f5-f222-4f58-821a-91841361995b\', \'multiverseId\': 427671}, \'multiverseid\': 427671}, {\'name\': \'Coccodrillo del Guado\', \'text\': \'Rapidità\\nQuando il Coccodrillo del Guado entra nel campo di battaglia, metti un segnalino -1/-1 su una creatura bersaglio che controlli.\', \'type\': \'Creatura — Coccodrillo\', \'flavor\': \'"Nell\\\'ordalia vi ritroverete denti ovunque. Spezzateli o saranno loro a spezzare voi." —Rhonas, dio della forza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427940&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d33930fa-9e08-4d60-8453-e6972bbd501a\', \'multiverseId\': 427940}, \'multiverseid\': 427940}, {\'name\': \'横断地のクロコダイル\', \'text\': \'速攻\\n横断地のクロコダイルが戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'クリーチャー — クロコダイル\', \'flavor\': \'「試練は過酷である。襲い来るものに勝たねば餌となるのみ。」 ――活力の神、ロナス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428209&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b8445914-0d82-486a-a34a-3f2ee2af2293\', \'multiverseId\': 428209}, \'multiverseid\': 428209}, {\'name\': \'횡단 길목의 악어\', \'text\': \'신속\\n횡단 길목의 악어가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 악어\', \'flavor\': \'"시험에 등장하는 모든 괴수는 날카로운 이를 가졌다. 이 놈들을 처치하지 못다면 먹잇감이 될 것이다." —힘의 신 로나스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428478&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'22d61c67-2d5c-4b5f-8565-137051531a24\', \'multiverseId\': 428478}, \'multiverseid\': 428478}, {\'name\': \'Crocodilo do Vau\', \'text\': \'Ímpeto\\nQuando Crocodilo do Vau entrar no campo de batalha, coloque um marcador -1/-1 na criatura alvo que você controla.\', \'type\': \'Criatura — Crocodilo\', \'flavor\': \'"Tudo na prova tem dentes. Supere-os ou alimente-os." — Rhonas, deus da força\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428747&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a73a1807-8f23-4cd8-8299-f8caf9fcf45c\', \'multiverseId\': 428747}, \'multiverseid\': 428747}, {\'name\': \'Крокодил Переправы\', \'text\': \'Ускорение\\nКогда Крокодил Переправы выходит на поле битвы, положите один жетон -1/-1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Крокодил\', \'flavor\': \'«В этом испытании у каждого есть зубы. Ты или победишь, или станешь пищей». — Ронас, бог силы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429016&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'222af4f7-6f21-40fc-98c9-d8a12ee7d5f8\', \'multiverseId\': 429016}, \'multiverseid\': 429016}, {\'name\': \'分岔口鳄鱼\', \'text\': \'敏捷\\n当分岔口鳄鱼进战场时，在目标由你操控的生物上放置一个-1/-1指示物。\', \'type\': \'生物～鳄鱼\', \'flavor\': \'「这祀炼中你所面对的一切都有尖牙利齿。赢不了的话，你就会成为盘中美餐。」 ～力量之神罗纳斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429285&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'31b9b2ad-fec8-401a-85f3-3e1d5b32af2c\', \'multiverseId\': 429285}, \'multiverseid\': 429285}, {\'name\': \'分岔口鱷魚\', \'text\': \'敏捷\\n當分岔口鱷魚進戰場時，在目標由你操控的生物上放置一個-1/-1指示物。\', \'type\': \'生物～鱷魚\', \'flavor\': \'「這祀煉中你所面對的一切都有尖牙利齒。贏不了的話，你就會成為盤中美餐。」 ～力量之神羅納斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429554&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7bb33cae-1740-4a3b-9cbf-5da6adbfad7e\', \'multiverseId\': 429554}, \'multiverseid\': 429554}]', '[{\'name\': \'Kryptische Schlange\', \'text\': \'Die Kryptische Schlange kostet beim Wirken für jede Spontanzauber- und Hexerei-Karte in deinem Friedhof {1} weniger.\', \'type\': \'Kreatur — Schlange\', \'flavor\': \'Sie schlängelt sich durch die Sinne, umschlingt das Unterbewusstsein und vergiftet den Verstand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427019&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4373f150-825a-4b79-a0ea-29a4480d3a96\', \'multiverseId\': 427019}, \'multiverseid\': 427019}, {\'name\': \'Serpiente críptica\', \'text\': \'Te cuesta {1} menos lanzar la Serpiente críptica por cada carta de instantáneo y de conjuro en tu cementerio.\', \'type\': \'Criatura — Serpiente\', \'flavor\': \'Se desliza por los sentidos, corrompiendo la conciencia y envenenando la percepción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427288&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59357666-80c4-4a52-9e3b-8ac435849031\', \'multiverseId\': 427288}, \'multiverseid\': 427288}, {\'name\': \'Serpent cryptique\', \'text\': "Le Serpent cryptique coûte {1} de moins à lancer pour chaque carte d\'éphémère et de rituel dans votre cimetière.", \'type\': \'Créature : grand serpent\', \'flavor\': \'Il ondule dans votre esprit, entravant votre conscience et empoisonnant vos sens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427557&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'35f04749-7d68-4712-8a50-d74b6d2c8a9d\', \'multiverseId\': 427557}, \'multiverseid\': 427557}, {\'name\': \'Serpe Criptica\', \'text\': \'La Serpe Criptica costa {1} in meno per essere lanciata per ogni carta istantaneo e stregoneria nel tuo cimitero.\', \'type\': \'Creatura — Serpe\', \'flavor\': \'Inibisce i sensi sinuosamente, soffocando la consapevolezza e avvelenando la percezione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427826&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c768f2f9-0e37-4d3f-af8a-8e909d2a337c\', \'multiverseId\': 427826}, \'multiverseid\': 427826}, {\'name\': \'謎めいた海蛇\', \'text\': \'謎めいた海蛇を唱えるためのコストは、あなたの墓地にあるインスタントかソーサリーであるカード１枚につき{1}少なくなる。\', \'type\': \'クリーチャー — 海蛇\', \'flavor\': \'そいつは感覚を這い進み、意識を押さえつけ知覚を毒す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428095&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3d042aa3-78be-432c-92d2-eb7082dbcc6d\', \'multiverseId\': 428095}, \'multiverseid\': 428095}, {\'name\': \'불가사의 이무기\', \'text\': \'불가사의 이무기는 당신의 무덤에 있는 순간마법 및 집중마법 카드 한 장당 발동 비용이 {1} 감소한다.\', \'type\': \'생물 — 이무기\', \'flavor\': \'이무기는 감각을 파고들어 의식을 옥죄고 지각을 마비시킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428364&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b7358dd0-cc28-4121-89c5-54de91d8d636\', \'multiverseId\': 428364}, \'multiverseid\': 428364}, {\'name\': \'Serpente Críptica\', \'text\': \'Serpente Críptica custa {1} a menos para ser conjurada para cada card de mágica instantânea e feitiço no seu cemitério.\', \'type\': \'Criatura — Serpente\', \'flavor\': \'Ela se insinua nos sentidos, sufocando a consciência e envenenando as percepções.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428633&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a8bcc56e-1f83-4e5c-879c-d65223bc7d57\', \'multiverseId\': 428633}, \'multiverseid\': 428633}, {\'name\': \'Таинственный Змей\', \'text\': \'Стоимость разыгрывания Таинственного Змея уменьшается на {1} за каждую карту мгновенного заклинания и волшебства на вашем кладбище.\', \'type\': \'Существо — Змей\', \'flavor\': \'Он вползает в восприятие, стискивает сознание и отравляет ощущения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428902&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'338edfaa-fa60-4433-b485-74385493a7d4\', \'multiverseId\': 428902}, \'multiverseid\': 428902}, {\'name\': \'隐密巨蛇\', \'text\': \'你坟墓场中每有一张瞬间与法术牌，隐密巨蛇便减少{1}来施放。\', \'type\': \'生物～巨蛇\', \'flavor\': \'它能绕过感官，束缩感觉并毒害感知。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429171&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0edcd71d-449f-4ebb-8e94-db1eacc662ae\', \'multiverseId\': 429171}, \'multiverseid\': 429171}, {\'name\': \'隱密巨蛇\', \'text\': \'你墳墓場中每有一張瞬間與巫術牌，隱密巨蛇便減少{1}來施放。\', \'type\': \'生物～巨蛇\', \'flavor\': \'牠能繞過感官，束縮感覺並毒害感知。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429440&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9bf209b1-893e-43f4-bfe2-4f108e61c842\', \'multiverseId\': 429440}, \'multiverseid\': 429440}]', '[{\'name\': \'Kurator der Mysterien\', \'text\': \'Fliegend\\nImmer wenn du eine andere Karte umwandelst oder abwirfst, wende Hellsicht 1 an.\\nUmwandlung {U} ({U}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Sphinx\', \'flavor\': \'Eine Sphinx um Rat zu bitten, ist eine Frage der Geduld. Vielleicht ist das auch die einzige Frage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427020&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'45b3aa11-8b48-4a60-a0d8-5186b28469f4\', \'multiverseId\': 427020}, \'multiverseid\': 427020}, {\'name\': \'Custodio de misterios\', \'text\': \'Vuela.\\nSiempre que actives una habilidad de ciclo o descartes otra carta, adivina 1.\\nCiclo {U}. ({U}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'Consultar a una esfinge es una prueba de paciencia. Quizás de eso se trata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427289&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cce8ce06-941e-4c56-a47f-971690351328\', \'multiverseId\': 427289}, \'multiverseid\': 427289}, {\'name\': \'Conservateur de mystères\', \'text\': "Vol\\nÀ chaque fois que vous recyclez ou vous défaussez d\'une autre carte, regard 1.\\nRecyclage {U} ({U}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Créature : sphinx\', \'flavor\': "Consulter un sphinx met la patience à l\'épreuve. C\'est peut-être là l\'intérêt.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427558&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7b7e73d-5d0d-476c-ae81-0fec0af1d540\', \'multiverseId\': 427558}, \'multiverseid\': 427558}, {\'name\': \'Sovrintendente dei Misteri\', \'text\': "Volare\\nOgniqualvolta cicli o scarti un\'altra carta, profetizza 1.\\nCiclo {U} ({U}, Scarta questa carta: Pesca una carta.)", \'type\': \'Creatura — Sfinge\', \'flavor\': \'Chiedere consiglio a una sfinge significa mettere alla prova la propria pazienza. Forse è proprio questo il punto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427827&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32b9ac46-033d-4b7b-8165-c70fbe6ba780\', \'multiverseId\': 427827}, \'multiverseid\': 427827}, {\'name\': \'秘法の管理者\', \'text\': \'飛行\\nあなたが他のカードを１枚サイクリングするか捨てるたび、占術１を行う。\\nサイクリング{U}（{U}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': \'スフィンクスに物事を尋ねるには忍耐がいる。恐らくそれが重要なのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428096&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc76506c-e40e-4f39-a05c-adffc3208814\', \'multiverseId\': 428096}, \'multiverseid\': 428096}, {\'name\': \'수수께끼의 관장\', \'text\': \'비행\\n당신이 다른 카드를 순환하거나 버릴 때마다, 점술 1을 한다.\\n순환 {U} ({U}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 스핑크스\', \'flavor\': \'스핑크스와의 대담은 인내력 시험과도 같다. 어쩌면 그게 핵심일지도.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428365&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2c73d2f-4122-4961-ac56-94e543962afe\', \'multiverseId\': 428365}, \'multiverseid\': 428365}, {\'name\': \'Curador de Mistérios\', \'text\': \'Voar\\nToda vez que você reciclar ou descartar outro card, use vidência 1.\\nReciclar {U} ({U}, Descarte este card: Compre um card.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'Consultar uma esfinge é um teste de paciência. Talvez seja essa a ideia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428634&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f61a5fd-cb22-4ffd-a549-025ef2bac38c\', \'multiverseId\': 428634}, \'multiverseid\': 428634}, {\'name\': \'Хранитель Загадок\', \'text\': \'Полет\\nКаждый раз, когда вы совершаете Цикл другой карты или сбрасываете другую карту, предскажите 1.\\nЦикл {U} ({U}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Сфинкс\', \'flavor\': \'Обратиться за советом к сфинксу — настоящее испытание терпения. Может быть, в этом и есть суть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428903&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a82b5ea-2d22-4fb1-a667-d81c1ccb7a39\', \'multiverseId\': 428903}, \'multiverseid\': 428903}, {\'name\': \'护谜史芬斯\', \'text\': \'飞行\\n每当你循环或弃另一张牌时，占卜1。\\n循环{U}（{U}，弃掉此牌：抓一张牌。）\', \'type\': \'生物～史芬斯\', \'flavor\': \'咨询史芬斯要考验耐心。或许这便是其意义所在。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429172&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a224ae1c-4bcf-42eb-baad-edd77e75b1ac\', \'multiverseId\': 429172}, \'multiverseid\': 429172}, {\'name\': \'護謎史芬斯\', \'text\': \'飛行\\n每當你循環或棄另一張牌時，占卜1。\\n循環{U}（{U}，棄掉此牌：抽一張牌。）\', \'type\': \'生物～史芬斯\', \'flavor\': \'諮詢史芬斯要考驗耐心。或許這便是其意義所在。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429441&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1bc30cd1-1d0f-40b6-a5c9-924ca2d54c93\', \'multiverseId\': 429441}, \'multiverseid\': 429441}]', '[{\'name\': \'Labyrinth-Wache\', \'text\': \'Wenn die Labyrinth-Wache das Ziel eines Zauberspruchs wird, opfere sie.\\nEinbalsamieren {3}{U} ({3}{U}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Illusion-Krieger ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Illusion, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427031&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7dd8b33a-7a45-4166-8fe6-c52c975631ef\', \'multiverseId\': 427031}, \'multiverseid\': 427031}, {\'name\': \'Guardián del laberinto\', \'text\': \'Cuando el Guardián del laberinto sea objetivo de un hechizo, sacrifícalo.\\nEmbalsamar {3}{U}. ({3}{U}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Guerrero Ilusión Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Guerrero ilusión\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427300&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e6e1379-66c7-49af-a377-88db4386ff0d\', \'multiverseId\': 427300}, \'multiverseid\': 427300}, {\'name\': \'Vigile du labyrinthe\', \'text\': "Quand le Vigile du labyrinthe devient la cible d\'un sort, sacrifiez-le.\\nEmbaumement {3}{U} ({3}{U}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et illusion et guerrier blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : illusion et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427569&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'43cf7c94-3dc2-4ec9-acb9-f0deedf2044e\', \'multiverseId\': 427569}, \'multiverseid\': 427569}, {\'name\': \'Guardiano del Dedalo\', \'text\': \'Quando il Guardiano del Dedalo diventa bersaglio di una magia, sacrificalo.\\nImbalsamare {3}{U} ({3}{U}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Guerriero Illusione Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Guerriero Illusione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427838&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84fc9761-931b-400c-af3f-39ea70d1225b\', \'multiverseId\': 427838}, \'multiverseid\': 427838}, {\'name\': \'迷宮の守護者\', \'text\': \'迷宮の守護者が呪文の対象になったとき、これを生け贄に捧げる。\\n不朽{3}{U}（{3}{U}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・イリュージョン・戦士であることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — イリュージョン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428107&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a6201f95-362a-44ff-9fe6-adad9a2f5411\', \'multiverseId\': 428107}, \'multiverseid\': 428107}, {\'name\': \'미궁 수호자\', \'text\': \'미궁 수호자가 주문이나 능력의 목표가 될 때, 미궁 수호자를 희생한다.\\n방부처리 {3}{U} ({3}{U}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 환영 전사다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 환영 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428376&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'24ee10c5-403b-4e37-bd81-c1d1c6a8be7a\', \'multiverseId\': 428376}, \'multiverseid\': 428376}, {\'name\': \'Guardião do Labirinto\', \'text\': \'Quando Guardião do Labirinto se tornar alvo de uma mágica, sacrifique-o.\\nEmbalsamar {3}{U} ({3}{U}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Ilusão Guerreiro branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Ilusão Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428645&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cda96146-3b11-47b5-9ef4-4b67682efb43\', \'multiverseId\': 428645}, \'multiverseid\': 428645}, {\'name\': \'Охранник Лабиринта\', \'text\': \'Когда Охранник Лабиринта становится целью заклинания, пожертвуйте его.\\nБальзамирование {3}{U} ({3}{U}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Иллюзией Воином без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Иллюзия Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428914&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c2bf7c5-5371-4957-a9a5-13ce7c2e7601\', \'multiverseId\': 428914}, \'multiverseid\': 428914}, {\'name\': \'迷宫守护者\', \'text\': \'当迷宫守护者成为咒语的目标时，将它牺牲。\\n遗存{3}{U}（{3}{U}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／虚影／战士，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～虚影／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429183&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02361736-11fa-49a3-ac6e-f74a36338fa5\', \'multiverseId\': 429183}, \'multiverseid\': 429183}, {\'name\': \'迷宮守護者\', \'text\': \'當迷宮守護者成為咒語的目標時，將它犧牲。\\n遺存{3}{U}（{3}{U}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／虛影／戰士，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～虛影／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429452&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c6ed6096-0280-4f8b-aec8-dbac12f37b03\', \'multiverseId\': 429452}, \'multiverseid\': 429452}]', "[{'name': 'Lauernder Serpopard', 'text': 'Der Lauernde Serpopard kann nicht neutralisiert werden.\\nKreaturenzauber, die du kontrollierst, können nicht neutralisiert werden.', 'type': 'Kreatur — Katze, Ophis', 'flavor': 'Die Wesire von Rhonas, dem Gott der Stärke, füttern und trainieren die Tiere, die während seiner Prüfung zum Einsatz kommen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427151&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b94ca00d-7725-4828-9823-a4d70ee37429', 'multiverseId': 427151}, 'multiverseid': 427151}, {'name': 'Leopardo de coral emboscado', 'text': 'El Leopardo de coral emboscado no puede ser contrarrestado.\\nLos hechizos de criatura que controlas no pueden ser contrarrestados.', 'type': 'Criatura — Víbora felino', 'flavor': 'Los visires que sirven a Rhonas, el dios de la fuerza, cuidan a los diversos animales empleados durante su prueba.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427420&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b2ea8319-6c1f-40aa-982e-0484821ddca8', 'multiverseId': 427420}, 'multiverseid': 427420}, {'name': 'Serpopard rôdeur', 'text': 'Le Serpopard rôdeur ne peut pas être contrecarré.\\nLes sorts de créature que vous contrôlez ne peuvent pas être contrecarrés.', 'type': 'Créature : chat et serpent', 'flavor': 'Les vizirs au service de Rhonas, le dieu de la Force, prennent soin de la ménagerie mise à contribution pendant son épreuve.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427689&type=card', 'language': 'French', 'identifiers': {'scryfallId': '29d4bf5e-a092-406e-a762-50f4a2e205e8', 'multiverseId': 427689}, 'multiverseid': 427689}, {'name': 'Serpopardo in Agguato', 'text': 'Il Serpopardo in Agguato non può essere neutralizzato.\\nLe magie creatura che controlli non possono essere neutralizzate.', 'type': 'Creatura — Serpente Felino', 'flavor': 'I visir al servizio di Rhonas, il dio della forza, sono addetti alla manutenzione del serraglio che accoglie gli animali da affrontare nella sua ordalia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427958&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd47d0a1c-d83b-481a-afdc-d542a7e890af', 'multiverseId': 427958}, 'multiverseid': 427958}, {'name': 'うろつく蛇豹', 'text': 'うろつく蛇豹は打ち消されない。\\nあなたがコントロールするクリーチャー・呪文は打ち消されない。', 'type': 'クリーチャー — 猫・蛇', 'flavor': '活力の神ロナスに仕える侍臣は、試練に用いる獣を管理している。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428227&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '57e33c13-313d-4d35-8d14-98952ed94867', 'multiverseId': 428227}, 'multiverseid': 428227}, {'name': '배회하는 세르포파드', 'text': '배회하는 세르포파드는 무효화될 수 없다.\\n당신이 조종하는 생물 주문들은 무효화될 수 없다.', 'type': '생물 — 고양이 뱀', 'flavor': '힘의 신 로나스를 섬기는 고관들은 로나스의 시험에 사용되는 각종 야생 동물을 관리한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428496&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a00738a3-9d87-49b7-9324-5170080d0dbe', 'multiverseId': 428496}, 'multiverseid': 428496}, {'name': 'Serpopardo Espreitador', 'text': 'Serpopardo Espreitador não pode ser anulado.\\nAs mágicas de criatura que você controla não podem ser anuladas.', 'type': 'Criatura — Felino Cobra', 'flavor': 'Os vizires que servem a Rhonas, deus da força, são encarregados dos cuidados com o bestiário de animais usados durante sua prova.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428765&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '48bf35fa-53f8-4605-8f61-1f7f5f428ce4', 'multiverseId': 428765}, 'multiverseid': 428765}, {'name': 'Охотничий Змеепард', 'text': 'Охотничий Змеепард не может быть отменен.\\nЗаклинания существ под вашим контролем не могут быть отменены.', 'type': 'Существо — Кошка Змея', 'flavor': 'Визири на службе у бога силы Ронаса ухаживают за его зверинцем, где содержатся животные для испытаний.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429034&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b236ee0f-8522-44f3-ba9b-43b3dad2bb0f', 'multiverseId': 429034}, 'multiverseid': 429034}, {'name': '觅食蛇豹', 'text': '觅食蛇豹不能被反击。\\n由你操控的生物咒语不能被反击。', 'type': '生物～猫／蛇', 'flavor': '侍奉力量之神罗纳斯的维齐尔负责饲养会在祀炼中出现的各类猛兽。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429303&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '489e68d6-decb-48fc-bd2d-b20ad7845db4', 'multiverseId': 429303}, 'multiverseid': 429303}, {'name': '覓食蛇豹', 'text': '覓食蛇豹不能被反擊。\\n由你操控的生物咒語不能被反擊。', 'type': '生物～貓／蛇', 'flavor': '侍奉力量之神羅納斯的維齊爾負責飼養會在祀煉中出現的各類猛獸。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429572&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7a8397d5-a9e8-4777-a858-9b0e9bbd20f5', 'multiverseId': 429572}, 'multiverseid': 429572}]", "[{'name': 'Liliana, Regentin des Todes', 'text': '+1: Erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein. Lege die obersten zwei Karten deiner Bibliothek auf deinen Friedhof.\\n−3: Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück. Die Kreatur ist zusätzlich zu ihren anderen Farben und Typen ein schwarzer Zombie.\\n−7: Zerstöre alle Nicht-Zombie-Kreaturen.', 'type': 'Planeswalker — Liliana', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427068&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e825e3cb-2da4-4eb1-a23e-3889707979b5', 'multiverseId': 427068}, 'multiverseid': 427068}, {'name': 'Liliana, majestad de la muerte', 'text': '+1: Crea una ficha de criatura Zombie negra 2/2. Pon las dos primeras cartas de tu biblioteca en tu cementerio.\\n−3: Regresa la carta de criatura objetivo de tu cementerio al campo de batalla. Esa criatura es un Zombie negro además de sus otros colores y tipos.\\n−7: Destruye todas las criaturas que no sean Zombies.', 'type': 'Planeswalker — Liliana', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427337&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7b5ab051-2048-4741-9539-82726498c7f3', 'multiverseId': 427337}, 'multiverseid': 427337}, {'name': 'Liliana, majesté de la mort', 'text': '+1 : Créez un jeton de créature 2/2 noire Zombie. Mettez les deux cartes du dessus de votre bibliothèque dans votre cimetière.\\n-3 : Renvoyez une carte de créature ciblée sur le champ de bataille depuis votre cimetière. Cette créature est un zombie noir en plus de ses autres couleurs et de ses autres types.\\n-7 : Détruisez toutes les créatures non-Zombie.', 'type': 'Planeswalker : Liliana', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427606&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8433e6cc-e1d3-431e-b5ab-0ed5149869b5', 'multiverseId': 427606}, 'multiverseid': 427606}, {'name': 'Liliana, Maestà della Morte', 'text': '+1: Crea una pedina creatura Zombie 2/2 nera. Metti nel tuo cimitero le prime due carte del tuo grimorio.\\n-3: Rimetti sul campo di battaglia una carta creatura bersaglio dal tuo cimitero. Quella creatura è uno Zombie nero in aggiunta ai suoi altri tipi e colori.\\n-7: Distruggi tutte le creature non Zombie.', 'type': 'Planeswalker — Liliana', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427875&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ee864ef8-5817-48bf-9975-bf2cad8e4018', 'multiverseId': 427875}, 'multiverseid': 427875}, {'name': '死の権威、リリアナ', 'text': '+1：黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。あなたのライブラリーの一番上からカードを２枚あなたの墓地に置く。\\n−3：あなたの墓地からクリーチャー・カード１枚を対象とし、それを戦場に戻す。そのクリーチャーは、それの他の色やタイプに加えて黒のゾンビでもある。\\n−7：ゾンビでないクリーチャーをすべて破壊する。', 'type': 'プレインズウォーカー — リリアナ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428144&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '45790f98-88bb-4c91-9e66-5d0bc2aec639', 'multiverseId': 428144}, 'multiverseid': 428144}, {'name': '죽음의 위엄 릴리아나', 'text': '+1: 2/2 흑색 좀비 생물 토큰 한 개를 만든다. 당신의 서고 맨 위의 카드 두 장을 당신의 무덤에 넣는다.\\n−3: 당신의 무덤에 있는 생물 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다. 그 생물은 자신의 원래 색에 더불어 흑색이며, 자신의 원래 유형에 더불어 좀비다.\\n−7: 좀비가 아닌 생물을 모두 파괴한다.', 'type': '플레인즈워커 — 릴리아나', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428413&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '864c9f8b-4824-4ea4-b416-7e6bfe09b386', 'multiverseId': 428413}, 'multiverseid': 428413}, {'name': 'Liliana, Majestade da Morte', 'text': '+1: Crie uma ficha de criatura preta 2/2 do tipo Zumbi. Coloque os dois cards do topo do seu grimório no seu cemitério.\\n−3: Devolva o card de criatura alvo de seu cemitério para o campo de batalha. Aquela criatura é um Zumbi preto além de suas outras cores e tipos.\\n−7: Destrua todas as criaturas que não sejam Zumbis.', 'type': 'Planeswalker — Liliana', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428682&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dc484e23-62fe-4ced-8b72-be09a5c1e60f', 'multiverseId': 428682}, 'multiverseid': 428682}, {'name': 'Лилиана, Величие Смерти', 'text': '+1: создайте одну фишку существа 2/2 черный Зомби. Положите две верхние карты вашей библиотеки на ваше кладбище.\\n−3: верните целевую карту существа из вашего кладбища на поле битвы. То существо является черным Зомби в дополнение к своим другим цветам и типам.\\n−7: уничтожьте все не являющиеся Зомби существа.', 'type': 'Planeswalker — Лилиана', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428951&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '49abe082-443a-432f-ba5f-ed516d120c91', 'multiverseId': 428951}, 'multiverseid': 428951}, {'name': '亡者女王莉莲娜', 'text': '+1：派出一个2/2黑色灵俑衍生生物。将你牌库顶的两张牌置入你的坟墓场。\\n−3：将目标生物牌从你的坟墓场移回战场。该生物额外具有黑色此颜色与灵俑此类别。\\n−7：消灭所有非灵俑的生物。', 'type': '鹏洛客～莉莲娜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429220&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9da098a0-b2d7-496d-8bf0-716645ab68d3', 'multiverseId': 429220}, 'multiverseid': 429220}, {'name': '亡者女王莉蓮娜', 'text': '+1：派出一個2/2黑色殭屍衍生生物。將你牌庫頂的兩張牌置入你的墳墓場。\\n−3：將目標生物牌從你的墳墓場移回戰場。該生物額外具有黑色此顏色與殭屍此類別。\\n−7：消滅所有非殭屍的生物。', 'type': '鵬洛客～莉蓮娜', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429489&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b17f7fcd-27f6-4205-9665-e444a84840c5', 'multiverseId': 429489}, 'multiverseid': 429489}]", '[{\'name\': \'Liliana, Todesverbreiterin\', \'text\': \'+2: Lege eine -1/-1-Marke auf bis zu eine Kreatur deiner Wahl.\\n−3: Zerstöre eine Kreatur deiner Wahl, auf der mindestens eine -1/-1-Marke liegt.\\n−10: Bringe alle Kreaturenkarten aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429721&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'53d11112-a393-45ca-9151-cc09485aaa67\', \'multiverseId\': 429721}, \'multiverseid\': 429721}, {\'name\': \'Liliana, sometedora de la muerte\', \'text\': \'+2: Pon un contador -1/-1 sobre hasta una criatura objetivo.\\n−3: Destruye la criatura objetivo con un contador -1/-1 sobre ella.\\n−10: Regresa todas las cartas de criatura de tu cementerio al campo de batalla.\', \'type\': \'Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429847&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'584821f2-f48a-4080-b75d-f52eaee9fdf5\', \'multiverseId\': 429847}, \'multiverseid\': 429847}, {\'name\': \'Liliana, porteuse de mort\', \'text\': "+2 : Ciblez jusqu\'à une créature. Mettez un marqueur -1/-1 sur elle.\\n-3 : Détruisez une créature ciblée avec un marqueur -1/-1 sur elle.\\n-10 : Renvoyez sur le champ de bataille toutes les cartes de créature de votre cimetière.", \'type\': \'Planeswalker : Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429739&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83f5480d-f0d8-4a03-bbd6-d5e180d5a5e3\', \'multiverseId\': 429739}, \'multiverseid\': 429739}, {\'name\': \'Liliana, Manipolatrice di Morte\', \'text\': \'+2: Scegli fino a una creatura bersaglio. Metti un segnalino -1/-1 su di essa.\\n-3: Distruggi una creatura bersaglio con un segnalino -1/-1.\\n-10: Rimetti sul campo di battaglia tutte le carte creatura dal tuo cimitero.\', \'type\': \'Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429757&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca7cefb5-ef05-4f0e-be37-4748c7fb64ef\', \'multiverseId\': 429757}, \'multiverseid\': 429757}, {\'name\': \'死の使い手、リリアナ\', \'text\': \'+2：クリーチャー最大１体を対象とし、それの上に－１/－１カウンターを１個置く。\\n-3：－１/－１カウンターが置かれているクリーチャー１体を対象とし、それを破壊する。\\n-10：あなたの墓地からすべてのクリーチャー・カードを戦場に戻す。\', \'type\': \'プレインズウォーカー — リリアナ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429775&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f151d95c-531f-44fd-8fc3-8755c18a0676\', \'multiverseId\': 429775}, \'multiverseid\': 429775}, {\'name\': \'죽음을 다스리는 릴리아나\', \'text\': \'+2: 최대 한 개까지의 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다.\\n-3: -1/-1 카운터를 가진 생물을 목표로 정한다. 그 생물을 파괴한다.\\n−10: 당신의 무덤에 있는 모든 생물 카드를 전장으로 되돌린다.\', \'type\': \'플레인즈워커 — 릴리아나\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429793&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1b4a8e28-4ac7-4345-9d0a-79202f8ccdad\', \'multiverseId\': 429793}, \'multiverseid\': 429793}, {\'name\': \'Liliana, Manipuladora da Morte\', \'text\': \'+2: Coloque um marcador -1/-1 em até uma criatura alvo.\\n−3: Destrua a criatura alvo com um marcador -1/-1.\\n−10: Devolva todos os cards de criatura de seu cemitério para o campo de batalha.\', \'type\': \'Planeswalker — Liliana\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429811&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73c926d0-f23c-4f74-bc68-391cb3b81b1c\', \'multiverseId\': 429811}, \'multiverseid\': 429811}, {\'name\': \'Лилиана, Несущая Гибель\', \'text\': \'+2: положите один жетон -1/-1 на не более чем одно целевое существо.\\n—3: уничтожьте целевое существо с жетоном -1/-1 на нем.\\n—10: верните все карты существ из вашего кладбища на поле битвы.\', \'type\': \'Planeswalker — Лилиана\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429829&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c445088d-8451-4ae3-8e72-463626256e64\', \'multiverseId\': 429829}, \'multiverseid\': 429829}, {\'name\': \'召亡大师莉莲娜\', \'text\': \'+2：在至多一个目标生物上放置一个-1/-1指示物。\\n-3：消灭目标其上有-1/-1指示物的生物。\\n-10：将所有生物牌从你的坟墓场移回战场。\', \'type\': \'鹏洛客～莉莲娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429685&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'be9c421d-83b3-45a5-8e9b-c34ac08feac9\', \'multiverseId\': 429685}, \'multiverseid\': 429685}, {\'name\': \'召亡大師莉蓮娜\', \'text\': \'+2：在至多一個目標生物上放置一個-1/-1指示物。\\n−3：消滅目標其上有-1/-1指示物的生物。\\n−10：將所有生物牌從你的墳墓場移回戰場。\', \'type\': \'鵬洛客～莉蓮娜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429703&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'99f31c86-7720-440a-8a9b-00cdde6fdbec\', \'multiverseId\': 429703}, \'multiverseid\': 429703}]', "[{'name': 'Lilianas Einfluss', 'text': 'Lege eine -1/-1-Marke auf jede Kreatur, die du nicht kontrollierst. Du kannst deine Bibliothek und/oder deinen Friedhof nach einer Karte namens Liliana, Todesverbreiterin, durchsuchen, sie offen vorzeigen und auf deine Hand nehmen. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429723&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e353aaef-433b-439d-8c9a-3b27ced5f8e3', 'multiverseId': 429723}, 'multiverseid': 429723}, {'name': 'Influencia de Liliana', 'text': 'Pon un contador -1/-1 sobre cada criatura que no controlas. Puedes buscar en tu biblioteca y/o cementerio una carta llamada Liliana, sometedora de la muerte, mostrarla y ponerla en tu mano. Si buscas en tu biblioteca de esta manera, barájala.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429849&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '60eff646-a759-435e-9e1b-41aa68d2e8f9', 'multiverseId': 429849}, 'multiverseid': 429849}, {'name': 'Influence de Liliana', 'text': 'Mettez un marqueur -1/-1 sur chaque créature que vous ne contrôlez pas. Vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte appelée Liliana, porteuse de mort, la révéler et la mettre dans votre main. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429741&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f4432c14-ead1-4c21-adfc-637ed473715b', 'multiverseId': 429741}, 'multiverseid': 429741}, {'name': 'Influenza di Liliana', 'text': 'Metti un segnalino -1/-1 su ogni creatura che non controlli. Puoi passare in rassegna il tuo grimorio e/o il tuo cimitero per una carta chiamata Liliana, Manipolatrice di Morte, rivelarla e aggiungerla alla tua mano. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429759&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e5f8c9a5-f085-4db0-b9d7-da251b92cdc4', 'multiverseId': 429759}, 'multiverseid': 429759}, {'name': 'リリアナの影響', 'text': 'あなたがコントロールしていない各クリーチャーの上に－１/－１カウンターをそれぞれ１個置く。あなたはあなたのライブラリーやあなたの墓地から「死の使い手、リリアナ」という名前のカード１枚を探し、それを公開してあなたの手札に加えてもよい。これによりあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429777&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4e3c2db3-01b1-486a-885a-cfdde674abe7', 'multiverseId': 429777}, 'multiverseid': 429777}, {'name': '릴리아나의 영향력', 'text': '당신이 조종하지 않는 각 생물에 -1/-1 카운터를 올려놓는다. 당신은 당신의 서고 그리고/또는 무덤에서 이름이 죽음을 다스리는 릴리아나인 카드 한 장을 찾아 공개한 후 당신의 손으로 가져갈 수 있다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다.', 'type': '집중마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429795&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c9a991dc-b55c-49cb-bd1f-42ce238b9eef', 'multiverseId': 429795}, 'multiverseid': 429795}, {'name': 'Influência de Liliana', 'text': 'Coloque um marcador -1/-1 em cada criatura que você não controla. Você pode procurar um card com o nome Liliana, Manipuladora da Morte, em seu grimório e/ou cemitério, revelá-lo e colocá-lo em sua mão. Se procurar em seu grimório desta maneira, embaralhe-o.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429813&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8608e26c-6c19-4cf8-9cba-5ce3d886c324', 'multiverseId': 429813}, 'multiverseid': 429813}, {'name': 'Влияние Лилианы', 'text': 'Положите один жетон -1/-1 на каждое существо не под вашим контролем. Вы можете найти в вашей библиотеке и (или) на вашем кладбище карту с именем Лилиана, Несущая Гибель, показать ее и положить в вашу руку. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429831&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4ae15998-de05-4bb7-b06c-078e3b5a55d8', 'multiverseId': 429831}, 'multiverseid': 429831}, {'name': '莉莲娜的威能', 'text': '在每个不由你操控的生物上各放置一个-1/-1指示物。你可以从你的牌库和／或坟墓场中搜寻一张名称为召亡大师莉莲娜的牌，展示该牌，并将它置于你手上。如果你以此法搜寻你的牌库，则将它洗牌。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429687&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '502b5c7a-c7d0-48e7-b46f-4132b42aeff4', 'multiverseId': 429687}, 'multiverseid': 429687}, {'name': '莉蓮娜的威能', 'text': '在每個不由你操控的生物上各放置一個-1/-1指示物。你可以從你的牌庫和／或墳墓場中搜尋一張名稱為召亡大師莉蓮娜的牌，展示該牌，並將它置於你手上。如果你以此法搜尋你的牌庫，則將它洗牌。', 'type': '巫術', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429705&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0c1f3623-3f69-49a8-aaf1-6e7a55250839', 'multiverseId': 429705}, 'multiverseid': 429705}]", '[{\'name\': \'Lilianas Regentschaft\', \'text\': \'Zombies, die du kontrollierst, erhalten +1/+1.\\nWenn Lilianas Regentschaft ins Spiel kommt, erzeuge zwei 2/2 schwarze Zombie-Kreaturenspielsteine.\', \'type\': \'Verzauberung\', \'flavor\': \'„Es sind so viele … Als hätten sie nur darauf gewartet, jemandem dienen zu dürfen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427069&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c46eb7d1-518b-409a-824a-1b461e8ef9ad\', \'multiverseId\': 427069}, \'multiverseid\': 427069}, {\'name\': \'Dominio de Liliana\', \'text\': \'Los Zombies que controlas obtienen +1/+1.\\nCuando el Dominio de Liliana entre al campo de batalla, crea dos fichas de criatura Zombie negras 2/2.\', \'type\': \'Encantamiento\', \'flavor\': \'"Hay muchísimos. Parece que esperaban a alguien a quien servir".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427338&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e8a694d-7368-4979-ab14-ac1cdbf391da\', \'multiverseId\': 427338}, \'multiverseid\': 427338}, {\'name\': \'Maîtrise de Liliana\', \'text\': \'Les zombies que vous contrôlez gagnent +1/+1.\\nQuand la Maîtrise de Liliana arrive sur le champ de bataille, créez deux jetons de créature 2/2 noires Zombies.\', \'type\': \'Enchantement\', \'flavor\': "« Il y en a tellement. On croirait qu\'ils attendaient simplement que quelqu\'un les commande. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427607&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20ae6fcd-54f5-4649-89a2-7623cc6bacb6\', \'multiverseId\': 427607}, \'multiverseid\': 427607}, {\'name\': \'Maestria di Liliana\', \'text\': \'Gli Zombie che controlli prendono +1/+1.\\nQuando la Maestria di Liliana entra nel campo di battaglia, crea due pedine creatura Zombie 2/2 nere.\', \'type\': \'Incantesimo\', \'flavor\': \'"Ce ne sono così tanti, come se fossero in attesa di qualcuno da servire."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427876&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'224b899f-9f27-47a5-ac84-392b13298ed6\', \'multiverseId\': 427876}, \'multiverseid\': 427876}, {\'name\': \'リリアナの支配\', \'text\': \'あなたがコントロールするゾンビは＋１/＋１の修整を受ける。\\nリリアナの支配が戦場に出たとき、黒の２/２のゾンビ・クリーチャー・トークンを２体生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「数えきれないほどいるわ。主人を待っているようね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428145&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35eb2fb2-16eb-40a7-8658-de28cf8b06b5\', \'multiverseId\': 428145}, \'multiverseid\': 428145}, {\'name\': \'릴리아나의 숙련\', \'text\': \'당신이 조종하는 좀비들은 +1/+1을 받는다.\\n릴리아나의 숙련이 전장에 들어올 때, 2/2 흑색 좀비 생물 토큰 두 개를 만든다.\', \'type\': \'부여마법\', \'flavor\': \'"좀비들의 수가 엄청나게 많다. 마치 누군가의 명령을 기다리는 듯 보인다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428414&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ad124b73-2294-4f35-86bc-1dddc5338f93\', \'multiverseId\': 428414}, \'multiverseid\': 428414}, {\'name\': \'Maestria de Liliana\', \'text\': \'Os Zumbis que você controla recebem +1/+1.\\nQuando Maestria de Liliana entrar no campo de batalha, crie duas fichas de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Encantamento\', \'flavor\': \'"Há tantos deles. Parece que eles estavam só esperando alguém a quem servir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428683&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e6fc13ad-665a-4eb0-80d0-7614347b5091\', \'multiverseId\': 428683}, \'multiverseid\': 428683}, {\'name\': \'Мастерство Лилианы\', \'text\': \'Зомби под вашим контролем получают +1/+1.\\nКогда Мастерство Лилианы выходит на поле битвы, создайте две фишки существа 2/2 черный Зомби.\', \'type\': \'Чары\', \'flavor\': \'«Их так много... Они все словно ждали кого-то, кому могут служить».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428952&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ab528d5-b7bc-40ac-a00f-e0da0195700a\', \'multiverseId\': 428952}, \'multiverseid\': 428952}, {\'name\': \'莉莲娜的掌控\', \'text\': \'由你操控的灵俑得+1/+1。\\n当莉莲娜的掌控进战场时，派出两个2/2黑色灵俑衍生生物。\', \'type\': \'结界\', \'flavor\': \'「数量可真多。它们好像正等着服侍人。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429221&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2909cc88-f95d-4824-8ed6-3ad7054655c7\', \'multiverseId\': 429221}, \'multiverseid\': 429221}, {\'name\': \'莉蓮娜的掌控\', \'text\': \'由你操控的殭屍得+1/+1。\\n當莉蓮娜的掌控進戰場時，派出兩個2/2黑色殭屍衍生生物。\', \'type\': \'結界\', \'flavor\': \'「數量可真多。它們好像正等著服侍人。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429490&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dfa65845-1386-449f-ad46-b4db863023a5\', \'multiverseId\': 429490}, \'multiverseid\': 429490}]', '[{\'name\': \'Luxa-Flussschrein\', \'text\': \'{1}, {T}: Du erhältst 1 Lebenspunkt dazu. Lege eine Ziegelmarke auf den Luxa-Flussschrein.\\n{T}: Du erhältst 2 Lebenspunkte dazu. Aktiviere diese Fähigkeit nur, falls sich drei oder mehr Ziegelmarken auf dem Luxa-Flussschrein befinden.\', \'type\': \'Artefakt\', \'flavor\': \'Ohne den Gott-Pharao gäbe es keinen Luxa. Ohne den Luxa gäbe es kein Leben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427203&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'73b7ec6f-fe8a-4cb0-b74b-d3ab8316f2e8\', \'multiverseId\': 427203}, \'multiverseid\': 427203}, {\'name\': \'Santuario al río Luxa\', \'text\': \'{1}, {T}: Ganas 1 vida. Pon un contador de bloque sobre el Santuario al río Luxa.\\n{T}: Ganas 2 vidas. Activa esta habilidad solo si hay tres o más contadores de bloque sobre el Santuario al río Luxa.\', \'type\': \'Artefacto\', \'flavor\': \'Sin el Dios Faraón, no existiría el Luxa. Sin el Luxa, no existiría la vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e8dc335-283d-4fc2-8356-ac6def57de58\', \'multiverseId\': 427472}, \'multiverseid\': 427472}, {\'name\': \'Reliquaire du fleuve Luxa\', \'text\': "{1}, {T} : Vous gagnez 1 point de vie. Mettez un marqueur « brique » sur le Reliquaire du fleuve Luxa.\\n{T} : Vous gagnez 2 points de vie. N\'activez cette capacité que s\'il y a au moins trois marqueurs « brique » sur le Reliquaire du fleuve Luxa.", \'type\': \'Artefact\', \'flavor\': "Sans le Dieu-Pharaon, il n\'y aurait pas de fleuve. Sans le Luxa, il n\'y aurait pas de vie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427741&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67e08085-803a-438b-aea3-2afd58f251a8\', \'multiverseId\': 427741}, \'multiverseid\': 427741}, {\'name\': \'Santuario del Fiume Luxa\', \'text\': \'{1}, {T}: Guadagni 1 punto vita. Metti un segnalino mattone sul Santuario del Fiume Luxa.\\n{T}: Guadagni 2 punti vita. Attiva questa abilità solo se ci sono tre o più segnalini mattone sul Santuario del Fiume Luxa.\', \'type\': \'Artefatto\', \'flavor\': \'Senza il Dio Faraone, non esisterebbe il fiume Luxa. Senza il fiume Luxa, non esisterebbe la vita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428010&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4cb558d9-1226-457f-baea-9b4a4bf9e62d\', \'multiverseId\': 428010}, \'multiverseid\': 428010}, {\'name\': \'ルクサ川の祭殿\', \'text\': \'{1}, {T}：あなたは１点のライフを得る。ルクサ川の祭殿の上に石材カウンターを１個置く。\\n{T}：あなたは２点のライフを得る。この能力は、ルクサ川の祭殿の上に石材カウンターが３個以上置かれているときにのみ起動できる。\', \'type\': \'アーティファクト\', \'flavor\': \'王神がいなければルクサ川もない。ルクサ川がなければ生命もない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428279&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'30ea20eb-a1e7-49a5-aa40-846b060598a3\', \'multiverseId\': 428279}, \'multiverseid\': 428279}, {\'name\': \'럭사 강 신전\', \'text\': \'{1}, {T}: 당신은 생명 1점을 얻는다. 럭사 강 신전에 벽돌 카운터 한 개를 올려놓는다.\\n{T}: 당신은 생명 2점을 얻는다. 럭사 강 신전에 벽돌 카운터가 세 개 이상 있는 경우에만 이 능력을 활성화할 수 있다.\', \'type\': \'마법물체\', \'flavor\': \'신 파라오가 없었다면 럭사도 없었을 것이다. 럭사가 없었다면 어떤 생명도 없었을 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428548&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7e52cc26-fc40-4871-ba57-b3a499bcee2d\', \'multiverseId\': 428548}, \'multiverseid\': 428548}, {\'name\': \'Santuário do Rio Luxa\', \'text\': \'{1}, {T}: Você ganha 1 ponto de vida. Coloque um marcador de tijolo em Santuário do Rio Luxa.\\n{T}: Você ganha 2 pontos de vida. Ative esta habilidade somente se houver três ou mais marcadores de tijolo em Santuário do Rio Luxa.\', \'type\': \'Artefato\', \'flavor\': \'Sem o Faraó-Deus, não haveria o Luxa. Sem o Luxa, não haveria vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d71aef79-08f4-4a96-ae37-a5d8c36c572a\', \'multiverseId\': 428817}, \'multiverseid\': 428817}, {\'name\': \'Храм на Реке Лукса\', \'text\': \'{1}, {T}: вы получаете 1 жизнь. Положите один жетон кирпича на Храм на Реке Лукса.\\n{T}: Вы получаете 2 жизни. Активируйте эту способность, только если на Храме на Реке Лукса есть не менее трех жетонов кирпича.\', \'type\': \'Артефакт\', \'flavor\': \'Без Бога-Фараона не было бы Луксы. Без Луксы не было бы жизни.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429086&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2ef0f2b0-55d2-4a4e-8bcc-b7f1fe1b0b42\', \'multiverseId\': 429086}, \'multiverseid\': 429086}, {\'name\': \'罗夏河祭祠\', \'text\': \'{1}，{T}：你获得1点生命。在罗夏河祭祠上放置一个石砖指示物。\\n{T}：你获得2点生命。只能于罗夏河祭祠上有三个或更多石砖指示物时起动此异能。\', \'type\': \'神器\', \'flavor\': \'没有法老神，就不会有罗夏河；没有罗夏河，也就不会有生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429355&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8f50bb5-5a4a-45b9-866e-22eef2d26310\', \'multiverseId\': 429355}, \'multiverseid\': 429355}, {\'name\': \'羅夏河祭祠\', \'text\': \'{1}，{T}：你獲得1點生命。在羅夏河祭祠上放置一個石磚指示物。\\n{T}：你獲得2點生命。只能於羅夏河祭祠上有三個或更多石磚指示物時起動此異能。\', \'type\': \'神器\', \'flavor\': \'沒有法老神，就不會有羅夏河；沒有羅夏河，也就不會有生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429624&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'86eb8236-9a36-47c4-9abd-836a030cbf4b\', \'multiverseId\': 429624}, \'multiverseid\': 429624}]', '[{\'name\': \'Magmagischt\', \'text\': \'Die Magmagischt fügt einer Kreatur deiner Wahl 2 Schadenspunkte zu. Falls die Kreatur in diesem Zug sterben würde, schicke sie stattdessen ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Asche lässt sich nicht einbalsamieren." —Neheb, Geweihter der Ahn-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427112&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1d6799f-0807-4e9f-8272-07f124c1ea51\', \'multiverseId\': 427112}, \'multiverseid\': 427112}, {\'name\': \'Rocío de magma\', \'text\': \'El Rocío de magma hace 2 puntos de daño a la criatura objetivo. Si esa criatura fuese a morir este turno, en vez de eso, exíliala.\', \'type\': \'Instantáneo\', \'flavor\': \'"No se puede embalsamar las cenizas". —Neheb, iniciado de la simiente Ahn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427381&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c365717e-4ef8-41a8-b195-7a39bf065685\', \'multiverseId\': 427381}, \'multiverseid\': 427381}, {\'name\': \'Giclée de magma\', \'text\': \'La Giclée de magma inflige 2 blessures à la créature ciblée. Si cette créature devait mourir ce tour-ci, exilez-la à la place.\', \'type\': \'Éphémère\', \'flavor\': \'« Les cendres ne peuvent pas être embaumées. » —Neheb, adepte de la moisson Ahn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427650&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'513f7d82-d587-49d8-8646-7c4b583bfc8b\', \'multiverseId\': 427650}, \'multiverseid\': 427650}, {\'name\': \'Spruzzo di Magma\', \'text\': \'Lo Spruzzo di Magma infligge 2 danni a una creatura bersaglio. Se quella creatura sta per morire in questo turno, invece esiliala.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le ceneri non possono essere imbalsamate." —Neheb, iniziato della messe Ahn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427919&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bfb12fad-7638-4730-959c-9c782fd58ff0\', \'multiverseId\': 427919}, \'multiverseid\': 427919}, {\'name\': \'マグマのしぶき\', \'text\': \'クリーチャー１体を対象とする。マグマのしぶきはそれに２点のダメージを与える。そのクリーチャーがこのターンに死亡するなら、代わりにそれを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「灰には不朽を行えない。」 ――アン一門の修練者、ネヘブ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428188&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fcb71665-0a05-489f-8e3e-57df58944b86\', \'multiverseId\': 428188}, \'multiverseid\': 428188}, {\'name\': \'용암 분사\', \'text\': \'생물을 목표로 정한다. 용암 분사는 그 생물에 피해 2점을 입힌다. 그 생물이 이 턴에 죽게 된다면, 대신 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"재가 되면 방부처리를 할 수 없다." —안 입문자의 입회자 네헵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428457&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9eae3bcc-818d-453a-8bc8-f232b4a24b67\', \'multiverseId\': 428457}, \'multiverseid\': 428457}, {\'name\': \'Esguicho de Magma\', \'text\': \'Esguicho de Magma causa 2 pontos de dano à criatura alvo. Se aquela criatura for morrer neste turno, em vez disso, exile-a.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Cinzas não podem ser embalsamadas." — Neheb, iniciado da safra Ahn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428726&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f51cb524-1ccf-40af-9dfb-8d4b88d39e5c\', \'multiverseId\': 428726}, \'multiverseid\': 428726}, {\'name\': \'Выброс Магмы\', \'text\': \'Выброс Магмы наносит 2 повреждения целевому существу. Если то существо должно умереть в этом ходу, изгоните его вместо этого.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Пепел уже не забальзамировать». — Нехеб, послушник снопа Ан\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428995&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fe99081b-4cb7-45b6-a9a6-653242d2f211\', \'multiverseId\': 428995}, \'multiverseid\': 428995}, {\'name\': \'岩浆喷散\', \'text\': \'岩浆喷散对目标生物造成2点伤害。如果本回合中该生物将死去，则改为将它放逐。\', \'type\': \'瞬间\', \'flavor\': \'「烧成灰就没法留下来了。」 ～阿恩祀群祀徒内赫布\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429264&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa8bfd8d-c364-4e9d-b956-851e20ba17aa\', \'multiverseId\': 429264}, \'multiverseid\': 429264}, {\'name\': \'岩漿噴散\', \'text\': \'岩漿噴散對目標生物造成2點傷害。如果本回合中該生物將死去，則改為將它放逐。\', \'type\': \'瞬間\', \'flavor\': \'「燒成灰就沒法留下來了。」 ～阿恩祀群祀徒內赫布\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429533&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8066f3d1-2d66-477f-a080-6b1837c1bd43\', \'multiverseId\': 429533}, \'multiverseid\': 429533}]', '[{\'name\': \'Malmhorn\', \'text\': \'Wenn das Malmhorn ins Spiel kommt, kannst du ein Artefakt deiner Wahl zerstören.\\nArtefakte, die deine Gegner kontrollieren, kommen getappt ins Spiel.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Verlasse dich zu sehr auf deine Waffen und du riskierst, irgendwann mit leeren Händen dazustehen." —Rhonas, Gott der Stärke\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427146&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d1ebb12-d16a-4f92-969e-f1d8aa6e1d4b\', \'multiverseId\': 427146}, \'multiverseid\': 427146}, {\'name\': \'Pulverizador astado\', \'text\': \'Cuando el Pulverizador astado entre al campo de batalla, puedes destruir el artefacto objetivo.\\nLos artefactos que controlan tus oponentes entran al campo de batalla girados.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Si dependes demasiado de tus armas, verás cómo tus sueños se despedazan en las manos". —Rhonas, dios de la fuerza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427415&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a7127965-158e-4a21-918e-0cb8446b27f1\', \'multiverseId\': 427415}, \'multiverseid\': 427415}, {\'name\': \'Déchiqueteur cornu\', \'text\': \'Quand le Déchiqueteur cornu arrive sur le champ de bataille, vous pouvez détruire un artefact ciblé.\\nLes artefacts que vos adversaires contrôlent arrivent sur le champ de bataille engagés.\', \'type\': \'Créature : bête\', \'flavor\': "« Ne vous fiez qu\'à vos armes et vous verrez vos rêves se briser entre vos mains. » —Rhonas, dieu de la Force", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427684&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b07641a0-0285-45b2-8e33-13c2d10575f9\', \'multiverseId\': 427684}, \'multiverseid\': 427684}, {\'name\': \'Squartacorno\', \'text\': \'Quando lo Squartacorno entra nel campo di battaglia, puoi distruggere un artefatto bersaglio.\\nGli artefatti controllati dai tuoi avversari entrano nel campo di battaglia TAPpati.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"Non affidatevi troppo alle armi se non volete che i vostri sogni si infrangano." —Rhonas, dio della forza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427953&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2577ebf3-f309-4e1a-90de-e68ba2e1d402\', \'multiverseId\': 427953}, \'multiverseid\': 427953}, {\'name\': \'刻み角\', \'text\': \'刻み角が戦場に出たとき、アーティファクト１つを対象とする。あなたはそれを破壊してもよい。\\n対戦相手がコントロールするアーティファクトはタップ状態で戦場に出る。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「武器に頼り過ぎる者は、自らの掌中で夢が砕けるさまを見ることになろう。」 ――活力の神、ロナス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428222&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b34bb29-2925-4de1-8ad6-9643d4c1298c\', \'multiverseId\': 428222}, \'multiverseid\': 428222}, {\'name\': \'난도질뿔\', \'text\': \'난도질뿔이 전장에 들어올 때, 마법물체를 목표로 정한다. 당신은 그 마법물체를 파괴할 수 있다.\\n당신의 상대들이 조종하는 마법물체는 탭된 채로 전장에 들어온다.\', \'type\': \'생물 — 야수\', \'flavor\': \'"무기에만 너무 의지하면 네 손으로 꿈을 산산조각낼 수도 있다." —힘의 신 로나스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428491&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1f28cd0-ce1f-4a26-853c-f5f2c4ac8147\', \'multiverseId\': 428491}, \'multiverseid\': 428491}, {\'name\': \'Mutilador-de-chifre\', \'text\': \'Quando Mutilador-de-chifre entra no campo de batalha, você pode destruir o artefato alvo.\\nOs artefatos que seus oponentes controlam entram no campo de batalha virados.\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Não confie demais nas próprias armas se não quiser ver seus sonhos se despedaçarem em suas mãos." — Rhonas, deus da força\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac008d4c-0409-43af-a1c7-b162e63c188f\', \'multiverseId\': 428760}, \'multiverseid\': 428760}, {\'name\': \'Разломорог\', \'text\': \'Когда Разломорог выходит на поле битвы, вы можете уничтожить целевой артефакт.\\nАртефакты под контролем ваших оппонентов выходят на поле битвы повернутыми.\', \'type\': \'Существо — Зверь\', \'flavor\': \'«Если слишком полагаться на оружие, то твои мечты могут рассыпаться у тебя в руках». — Ронас, бог силы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429029&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7bc41c1f-c8c2-4b6c-a372-807d01fe180e\', \'multiverseId\': 429029}, \'multiverseid\': 429029}, {\'name\': \'蛮角兽\', \'text\': \'当蛮角兽进战场时，你可以消灭目标神器。\\n由对手操控的神器须横置进战场。\', \'type\': \'生物～野兽\', \'flavor\': \'「若是过于依靠武器，你就只能眼睁睁地看着你的梦想在手中破碎。」 ～力量之神罗纳斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429298&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a25f0d33-c575-415b-82af-03911d06536b\', \'multiverseId\': 429298}, \'multiverseid\': 429298}, {\'name\': \'蠻角獸\', \'text\': \'當蠻角獸進戰場時，你可以消滅目標神器。\\n由對手操控的神器須橫置進戰場。\', \'type\': \'生物～野獸\', \'flavor\': \'「若是過於依靠武器，你就只能眼睜睜地看著你的夢想在手中破碎。」 ～力量之神羅納斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429567&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'13347dcf-c11b-4069-91d1-ca486c5f02b3\', \'multiverseId\': 429567}, \'multiverseid\': 429567}]', '[{\'name\': \'Mantikor der Arena\', \'text\': \'Wenn der Mantikor der Arena ins Spiel kommt, lege eine -1/-1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst. Der Mantikor der Arena fügt einem Gegner deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Mantikor\', \'flavor\': \'In der Arena werden nur die gefährlichsten und riskantesten Kampftechniken geübt — und oft nur einmal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427113&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c7900bb-7ee4-4024-83ad-93780452fe1f\', \'multiverseId\': 427113}, \'multiverseid\': 427113}, {\'name\': \'Mantícora de la Palestra\', \'text\': \'Cuando la Mantícora de la Palestra entre al campo de batalla, pon un contador -1/-1 sobre la criatura objetivo que controlas. La Mantícora de la Palestra hace 3 puntos de daño al oponente objetivo.\', \'type\': \'Criatura — Mantícora\', \'flavor\': \'En la zona de entrenamiento conocida como la Palestra, se empuja a los iniciados a poner en práctica técnicas más destructivas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427382&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2c68b046-f6ac-4ee0-9426-ae9d93a37c8b\', \'multiverseId\': 427382}, \'multiverseid\': 427382}, {\'name\': \'Manticore de la Géhenne\', \'text\': "Quand la Manticore de la Géhenne arrive sur le champ de bataille, mettez un marqueur -1/-1 sur une créature ciblée que vous contrôlez. La Manticore de la Géhenne inflige 3 blessures à l\'adversaire ciblé.", \'type\': \'Créature : manticore\', \'flavor\': "Au centre d\'entraînement de la Géhenne, les adeptes sont incités à se familiariser avec des techniques plus destructrices.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e674a5a-e77b-43a1-86c1-50b206811908\', \'multiverseId\': 427651}, \'multiverseid\': 427651}, {\'name\': \'Manticora del Cimento\', \'text\': \'Quando la Manticora del Cimento entra nel campo di battaglia, metti un segnalino -1/-1 su una creatura bersaglio che controlli. La Manticora del Cimento infligge 3 danni a un avversario bersaglio.\', \'type\': \'Creatura — Manticora\', \'flavor\': \'Nella zona di addestramento chiamata Cimento, gli iniziati vengono spronati a esercitarsi con tecniche più distruttive.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427920&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a284ca0f-f05a-4ba5-9a05-87ba8ecdf676\', \'multiverseId\': 427920}, \'multiverseid\': 427920}, {\'name\': \'打擲場のマンティコア\', \'text\': \'打擲場のマンティコアが戦場に出たとき、あなたがコントロールするクリーチャー１体と対戦相手１人を対象とし、その前者の上に－１/－１カウンターを１個置く。打擲場のマンティコアはその後者に３点のダメージを与える。\', \'type\': \'クリーチャー — マンティコア\', \'flavor\': \'打擲場と呼ばれる訓練場で、修練者たちは一段と破壊的な戦術を学ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428189&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f550c0f5-0c41-41b3-8753-2a5c1bc5c195\', \'multiverseId\': 428189}, \'multiverseid\': 428189}, {\'name\': \'장갑의 만티코어\', \'text\': \'장갑의 만티코어가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다. 상대를 목표로 정한다. 장갑의 만티코어는 그 상대에게 피해 3점을 입힌다.\', \'type\': \'생물 — 만티코어\', \'flavor\': \'건틀릿이라고 알려진 훈련장에서 입회자들은 더욱 파괴적인 기술을 연마해야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428458&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0d86161c-1252-457c-b6ac-c2d3f4148f42\', \'multiverseId\': 428458}, \'multiverseid\': 428458}, {\'name\': \'Mantícora da Arena\', \'text\': \'Quando Mantícora da Arena entrar no campo de batalha, coloque um marcador -1/-1 na criatura alvo que você controla. Mantícora da Arena causa 3 pontos de dano ao oponente alvo.\', \'type\': \'Criatura — Mantícora\', \'flavor\': \'Na área de treinamento conhecida como a Arena, os iniciados são compelidos a praticar técnicas mais destrutivas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428727&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9fe98e27-b21f-4829-8202-261894b492fb\', \'multiverseId\': 428727}, \'multiverseid\': 428727}, {\'name\': \'Мантикора Круга Битв\', \'text\': \'Когда Мантикора Круга Битв выходит на поле битвы, положите один жетон -1/-1 на целевое существо под вашим контролем. Мантикора Круга Битв наносит 3 повреждения целевому оппоненту.\', \'type\': \'Существо — Мантикора\', \'flavor\': \'Тренируясь в Круге Битв, послушники невольно осваивают самые смертоносные приемы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428996&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'48ecb489-2272-4503-b114-6852507254e5\', \'multiverseId\': 428996}, \'multiverseid\': 428996}, {\'name\': \'挑战场蝎狮\', \'text\': \'当挑战场蝎狮进战场时，在目标由你操控的生物上放置一个-1/-1指示物。挑战场蝎狮向目标对手造成3点伤害。\', \'type\': \'生物～翼狮\', \'flavor\': \'祀徒被迫在挑战场中练习更具破坏性的招式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429265&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c55790a-b8c0-408a-995c-f1df162d845f\', \'multiverseId\': 429265}, \'multiverseid\': 429265}, {\'name\': \'挑戰場蠍獅\', \'text\': \'當挑戰場蠍獅進戰場時，在目標由你操控的生物上放置一個-1/-1指示物。挑戰場蠍獅向目標對手造成3點傷害。\', \'type\': \'生物～翼獅\', \'flavor\': \'祀徒被迫在挑戰場中練習更具破壞性的招式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429534&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bbecc3fe-387b-4074-ba24-8245176b20c1\', \'multiverseId\': 429534}, \'multiverseid\': 429534}]', "[{'name': 'Maul // Fütterung', 'text': 'Erzeuge einen 3/3 grünen Flusspferd-Kreaturenspielstein.', 'type': 'Hexerei', 'flavor': None, 'faceName': 'Maul', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427185&type=card', 'language': 'German', 'identifiers': {'scryfallId': '496c9ec7-4a84-47ff-985d-4f9a199d95cd', 'multiverseId': 427185}, 'multiverseid': 427185}, {'name': 'Boca // Alimentar', 'text': 'Crea una ficha de criatura Hipopótamo verde 3/3.', 'type': 'Conjuro', 'flavor': None, 'faceName': 'Boca', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427454&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8262a6ac-775a-4735-9bf5-41ee974965e1', 'multiverseId': 427454}, 'multiverseid': 427454}, {'name': 'Bouche // Nourrir', 'text': 'Créez un jeton de créature 3/3 verte Hippopotame.', 'type': 'Rituel', 'flavor': None, 'faceName': 'Bouche', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427723&type=card', 'language': 'French', 'identifiers': {'scryfallId': '02ba9441-8c45-467e-9f49-be2cbc173844', 'multiverseId': 427723}, 'multiverseid': 427723}, {'name': 'Bocca // Sfamare', 'text': 'Crea una pedina creatura Ippopotamo 3/3 verde.', 'type': 'Stregoneria', 'flavor': None, 'faceName': 'Bocca', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427992&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9aebdaf8-095b-4ab2-821a-cd4ba65ab8cf', 'multiverseId': 427992}, 'multiverseid': 427992}, {'name': '食餌 // 給餌', 'text': '緑の３/３のカバ・クリーチャー・トークンを１体生成する。', 'type': 'ソーサリー', 'flavor': None, 'faceName': '食餌', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428261&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f3de5ada-6699-430b-95af-fefb505b2322', 'multiverseId': 428261}, 'multiverseid': 428261}, {'name': '입 // 먹기', 'text': '3/3 녹색 하마 생물 토큰 한 개를 만든다.', 'type': '집중마법', 'flavor': None, 'faceName': '입', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428530&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4d610b94-e8d0-42ea-86ac-e835be6da689', 'multiverseId': 428530}, 'multiverseid': 428530}, {'name': 'Boca // Alimentar', 'text': 'Crie uma ficha de criatura verde 3/3 do tipo Hipopótamo.', 'type': 'Feitiço', 'flavor': None, 'faceName': 'Boca', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428799&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '96438e74-2088-4a78-ad42-e7c0a6020bb9', 'multiverseId': 428799}, 'multiverseid': 428799}, {'name': 'Пасть // На Прокорм', 'text': 'Создайте фишку существа 3/3 зеленый Бегемот.', 'type': 'Волшебство', 'flavor': None, 'faceName': 'Пасть', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429068&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c2c97518-8e08-4c82-a636-11aed4b7a270', 'multiverseId': 429068}, 'multiverseid': 429068}, {'name': '张口 // 待哺', 'text': '派出一个3/3绿色河马衍生生物。', 'type': '法术', 'flavor': None, 'faceName': '张口', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429337&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0e99b15f-ed08-43c3-8386-ada4944d04aa', 'multiverseId': 429337}, 'multiverseid': 429337}, {'name': '張口 // 待哺', 'text': '派出一個3/3綠色河馬衍生生物。', 'type': '巫術', 'flavor': None, 'faceName': '張口', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429606&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '8eb32ee2-7d50-4bf5-88fa-97b4c41992fb', 'multiverseId': 429606}, 'multiverseid': 429606}]", '[{\'name\': \'Minotauren-Scharfschützin\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\n{1}{R}: Die Minotauren-Scharfschützin erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Minotaurus, Bogenschütze\', \'flavor\': \'„Was helfen dir zwei Flügel, wenn ich zwei Dutzend Pfeile habe?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427114&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d114e2a4-2ed0-435a-aa21-d025d9e57f35\', \'multiverseId\': 427114}, \'multiverseid\': 427114}, {\'name\': \'Minotauro tirocertero\', \'text\': \'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\\n{1}{R}: La Minotauro tirocertero obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Arquero minotauro\', \'flavor\': \'"Esas alas no son una ventaja. Las clavaré en el techo de la Hekma".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427383&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4df7e86b-97e9-43b0-962f-61c1e33d6811\', \'multiverseId\': 427383}, \'multiverseid\': 427383}, {\'name\': \'Buteuse minotaure\', \'text\': "Portée (Cette créature peut bloquer les créatures avec le vol.)\\n{1}{R} : La Buteuse minotaure gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : minotaure et archer\', \'flavor\': "« Ces ailes ne vous avantagent pas. Je les épinglerai à la voûte de l\'Hekma. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427652&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f59d6781-3a87-457b-b116-f7e49b771c55\', \'multiverseId\': 427652}, \'multiverseid\': 427652}, {\'name\': \'Minotaura Colposicuro\', \'text\': \'Raggiungere (Questa creatura può bloccare le creature con volare.)\\n{1}{R}: La Minotaura Colposicuro prende +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Arciere Minotauro\', \'flavor\': \'"Quelle ali non sono un\\\'arma vincente. Le inchioderò alla volta dell\\\'Hekma."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427921&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfd0af54-ab91-4377-9ea9-fa4675b6a769\', \'multiverseId\': 427921}, \'multiverseid\': 427921}, {\'name\': \'ミノタウルスの名射手\', \'text\': \'到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\\n{1}{R}：ターン終了時まで、ミノタウルスの名射手は＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ミノタウルス・射手\', \'flavor\': \'「翼があろうと有利ではない。ヘクマの天井に串刺しにしてやろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428190&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b59e163-d8a0-418f-a9fd-843399aea8ab\', \'multiverseId\': 428190}, \'multiverseid\': 428190}, {\'name\': \'일발필중 미노타우로스\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n{1}{R}: 일발필중 미노타우로스는 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 미노타우로스 궁수\', \'flavor\': \'"저 날개는 아무 소용이 없어. 헤크마 천장에 박제해 주지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428459&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f4e1a42c-3a8e-41cf-8e5d-267897b7d117\', \'multiverseId\': 428459}, \'multiverseid\': 428459}, {\'name\': \'Minotauro Tiro-certo\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\\n{1}{R}: Minotauro Tiro-certo recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Minotauro Arqueiro\', \'flavor\': \'"Aquelas asas não são nenhuma vantagem. Vou pregá-las no teto da Hekma."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428728&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b0ed3933-0d78-4404-a743-4efc8ceb2ffd\', \'multiverseId\': 428728}, \'multiverseid\': 428728}, {\'name\': \'Меткий Минотавр\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\\n{1}{R}: Меткий Минотавр получает +1/+0 до конца хода.\', \'type\': \'Существо — Минотавр Лучник\', \'flavor\': \'«Эти крылья — вовсе не преимущество. Я пришпилю их к своду Хекмы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428997&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9e6bb99f-fb27-42c3-bd07-4eabd9faf37f\', \'multiverseId\': 428997}, \'multiverseid\': 428997}, {\'name\': \'善射牛头怪\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\\n{1}{R}：善射牛头怪得+1/+0直到回合结束。\', \'type\': \'生物～牛头怪／弓箭手\', \'flavor\': \'「有翅膀会飞算不上什么优势。瞧我把它们都钉在避世帘顶上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429266&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1e8e157-446d-4c7b-a141-f2d4fcbfb89f\', \'multiverseId\': 429266}, \'multiverseid\': 429266}, {\'name\': \'善射牛頭怪\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\\n{1}{R}：善射牛頭怪得+1/+0直到回合結束。\', \'type\': \'生物～牛頭怪／弓箭手\', \'flavor\': \'「有翅膀會飛算不上什麼優勢。瞧我把牠們都釘在避世簾頂上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429535&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a145ee8a-e01b-43b6-a082-54faef08f8c7\', \'multiverseId\': 429535}, \'multiverseid\': 429535}]', '[{\'name\': \'Mit Gewalt\', \'text\': \'Zerstöre X Artefakte deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'„Abtrünnig? Eure Götter haben keine Ahnung, was für Abtrünnigkeiten hier gleich stattfinden werden!" —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427094&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b9bb331-a3d2-4882-adf0-e8fb304ce836\', \'multiverseId\': 427094}, \'multiverseid\': 427094}, {\'name\': \'A la fuerza\', \'text\': \'Destruye X artefactos objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"¿Disidencia? ¡Sus dioses ni siquiera empiezan a comprender la disidencia que está a punto de crearse aquí! —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427363&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f8ddc798-8d77-46f3-a048-9cad3b337da5\', \'multiverseId\': 427363}, \'multiverseid\': 427363}, {\'name\': \'Par la force\', \'text\': \'Détruisez X artefacts ciblés.\', \'type\': \'Rituel\', \'flavor\': "« Sédition ? Vos dieux ne peuvent même pas imaginer l\'ampleur de la sédition qui se fomente ici ! » —Chandra Nalaàr", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427632&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ca30313-58d8-46aa-be4a-1466dcc4cc0a\', \'multiverseId\': 427632}, \'multiverseid\': 427632}, {\'name\': \'Con la Forza\', \'text\': \'Distruggi X artefatti bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Dissenso? Le vostre divinità non hanno la minima idea del dissenso che sta per scatenarsi qui!" —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427901&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e37f826-72c4-4223-9d15-253c1d6eb224\', \'multiverseId\': 427901}, \'multiverseid\': 427901}, {\'name\': \'力ずく\', \'text\': \'アーティファクトＸ個を対象とし、それらを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'「造反？ あんたたちの神々はこの造反を少しも理解できそうにないじゃない！」 ――チャンドラ・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428170&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bdbdd92a-1e20-42ac-9aad-4704ebb798ba\', \'multiverseId\': 428170}, \'multiverseid\': 428170}, {\'name\': \'무력 사용\', \'text\': \'마법물체 X개를 목표로 정한다. 그 마법물체들을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'"반대? 너희의 신들은 이곳에서 일어나려는 반대 세력을 전혀 이해하지 못해!" —찬드라 날라르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428439&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7842e841-22cd-4104-9cf9-c93962389d99\', \'multiverseId\': 428439}, \'multiverseid\': 428439}, {\'name\': \'Pela Força\', \'text\': \'Destrua X artefatos alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Dissensão? Os seus deuses não são capazes de sequer começar a compreender a dissensão que está prestes a acontecer aqui!" — Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428708&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc723086-ae07-4ce9-984c-49be7a1afdd2\', \'multiverseId\': 428708}, \'multiverseid\': 428708}, {\'name\': \'Силовое Решение\', \'text\': \'Уничтожьте X целевых артефактов.\', \'type\': \'Волшебство\', \'flavor\': \'«Инакомыслие? Вашим богам и не снилось такое инакомыслие, которое сейчас здесь начнется». — Чандра Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428977&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6d896fd6-5fa9-4d97-8cf4-7b378cd0186c\', \'multiverseId\': 428977}, \'multiverseid\': 428977}, {\'name\': \'蛮力破坏\', \'text\': \'消灭X个目标神器。\', \'type\': \'法术\', \'flavor\': \'「逆徒？这里都快要变天了，你们的神却都还蒙在鼓里！」 ～茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429246&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8deebb8-3a61-494d-9645-f46d7a4fa2f0\', \'multiverseId\': 429246}, \'multiverseid\': 429246}, {\'name\': \'蠻力破壞\', \'text\': \'消滅X個目標神器。\', \'type\': \'巫術\', \'flavor\': \'「逆徒？這裡都快要變天了，你們的神卻都還蒙在鼓裡！」 ～茜卓納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429515&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'feaa9823-7823-40cb-8933-cd3e38c1ba70\', \'multiverseId\': 429515}, \'multiverseid\': 429515}]', '[{\'name\': \'Musterbeispiel an Stärke\', \'text\': \'Wenn das Musterbeispiel an Stärke ins Spiel kommt, lege drei -1/-1-Marken auf eine Kreatur deiner Wahl, die du kontrollierst.\\nImmer wenn das Musterbeispiel an Stärke angreift, entferne eine -1/-1-Marke von ihm. Falls du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Niemand wird als Auserwählter geboren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427136&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4215dc6a-3a42-441c-8185-8b8133a3a2fe\', \'multiverseId\': 427136}, \'multiverseid\': 427136}, {\'name\': \'Modelo de fuerza\', \'text\': \'Cuando la Modelo de fuerza entre al campo de batalla, pon tres contadores -1/-1 sobre la criatura objetivo que controlas.\\nSiempre que la Modelo de fuerza ataque, remueve un contador -1/-1 de ella. Si lo haces, ganas 1 vida.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Nadie nace siendo digno".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427405&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1bf3776a-bc1e-45ff-8428-037f2935729c\', \'multiverseId\': 427405}, \'multiverseid\': 427405}, {\'name\': \'Archétype de force\', \'text\': "Quand l\'Archétype de force arrive sur le champ de bataille, mettez trois marqueurs -1/-1 sur une créature ciblée que vous contrôlez.\\nÀ chaque fois que l\'Archétype de force attaque, retirez-lui un marqueur -1/-1. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'« Personne ne naît valeureux. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427674&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1949bbda-2976-4002-8de8-fd91b24c96b7\', \'multiverseId\': 427674}, \'multiverseid\': 427674}, {\'name\': \'Esempio di Forza\', \'text\': "Quando l\'Esempio di Forza entra nel campo di battaglia, metti tre segnalini -1/-1 su una creatura bersaglio che controlli.\\nOgniqualvolta l\'Esempio di Forza attacca, rimuovi un segnalino -1/-1 da esso. Se lo fai, guadagni 1 punto vita.", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Non si nasce prescelti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af23f682-b25b-475f-b15a-11ee787945ee\', \'multiverseId\': 427943}, \'multiverseid\': 427943}, {\'name\': \'活力の模範\', \'text\': \'活力の模範が戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを３個置く。\\n活力の模範が攻撃するたび、これの上から－１/－１カウンターを１個取り除く。そうしたなら、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「生まれながらの蓋世の英雄などいない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428212&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'548aa880-39e7-4add-a5bc-11fe136a8031\', \'multiverseId\': 428212}, \'multiverseid\': 428212}, {\'name\': \'힘의 귀감\', \'text\': \'힘의 귀감이 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 세 개를 올려놓는다.\\n힘의 귀감이 공격할 때마다, 힘의 귀감에서 -1/-1 카운터 한 개를 제거한다. 그렇게 한다면, 당신은 생명 1점을 얻는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"자격을 갖추고 태어난 자는 아무도 없다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428481&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cc07e968-93c2-4525-97e5-d38260378845\', \'multiverseId\': 428481}, \'multiverseid\': 428481}, {\'name\': \'Exemplo de Força\', \'text\': \'Quando Exemplo de Força entrar no campo de batalha, coloque três marcadores -1/-1 na criatura alvo que você controla.\\nToda vez que Exemplo de Força atacar, remova um marcador -1/-1 dela. Se fizer isso, você ganhará 1 ponto de vida.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Ninguém nasce digno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428750&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5980e353-f686-4ba9-bf4d-5afdcd00ad4e\', \'multiverseId\': 428750}, \'multiverseid\': 428750}, {\'name\': \'Образец Силы\', \'text\': \'Когда Образец Силы выходит на поле битвы, положите три жетона -1/-1 на целевое существо под вашим контролем.\\nКаждый раз, когда Образец Силы атакует, удалите с него один жетон -1/-1. Если вы это делаете, вы получаете 1 жизнь.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Никто не рождается достойным».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429019&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'07704f0a-17d3-4e99-b6ac-88a54f1f97c7\', \'multiverseId\': 429019}, \'multiverseid\': 429019}, {\'name\': \'力量模范\', \'text\': \'当力量模范进战场时，在目标由你操控的生物上放置三个-1/-1指示物。\\n每当力量模范攻击时，从其上移去一个-1/-1指示物。若你如此作，你获得1点生命。\', \'type\': \'生物～人类／战士\', \'flavor\': \'「人非皆生即豪英。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429288&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'06b49253-227b-48cf-ad86-667bc72844e8\', \'multiverseId\': 429288}, \'multiverseid\': 429288}, {\'name\': \'力量模範\', \'text\': \'當力量模範進戰場時，在目標由你操控的生物上放置三個-1/-1指示物。\\n每當力量模範攻擊時，從其上移去一個-1/-1指示物。若你如此作，你獲得1點生命。\', \'type\': \'生物～人類／戰士\', \'flavor\': \'「人非皆生即豪英。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429557&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dabe7a4c-5c35-4abd-b455-a19e4984c5af\', \'multiverseId\': 429557}, \'multiverseid\': 429557}]', '[{\'name\': \'Mäanderstrom\', \'text\': \'Der Mäanderstrom kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {U}.\', \'type\': \'Land\', \'flavor\': \'Der Strom teilt sich in zahllose Arme, die alle ins Halimar-Meer münden. Nur wenige Reisende finden zweimal denselben Weg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429729&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0939695b-4233-4cda-a6d6-1a39b4784085\', \'multiverseId\': 429729}, \'multiverseid\': 429729}, {\'name\': \'Río serpenteante\', \'text\': \'El Río serpenteante entra al campo de batalla girado.\\n{T}: Agrega {W} o {U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'El río se bifurcaba en muchos canales hasta llegar al mar de Halimar. Pocos eran los viajeros que podían seguir el mismo canal dos veces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429855&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'21babe14-da51-4198-8203-e6304992c109\', \'multiverseId\': 429855}, \'multiverseid\': 429855}, {\'name\': \'Rivière sinueuse\', \'text\': \'La Rivière sinueuse arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W} ou {U} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "La rivière se scindait en plusieurs canaux en s\'écoulant vers la mer d\'Halimar. Peu de voyageurs parvenaient à suivre le même deux fois.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'701a24df-712d-4afc-8aa7-b8d731470a39\', \'multiverseId\': 429747}, \'multiverseid\': 429747}, {\'name\': \'Fiume Serpeggiante\', \'text\': \'Il Fiume Serpeggiante entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W} o {U} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Il fiume si divideva in molti canali fluendo verso il Mare di Halimar. Pochi viaggiatori sapevano percorrere lo stesso due volte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429765&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25260e2c-fcd0-4164-85a4-0f4261057892\', \'multiverseId\': 429765}, \'multiverseid\': 429765}, {\'name\': \'曲がりくねる川\', \'text\': \'曲がりくねる川はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{U}を加える。\', \'type\': \'土地\', \'flavor\': \'川は幾度も分岐を繰り返しハリマーの海に注ぎ込む。旅人が同じ川筋をふたたび辿ることは難しかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429783&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48bce435-a7b3-48c5-80ec-6bef02723150\', \'multiverseId\': 429783}, \'multiverseid\': 429783}, {\'name\': \'굽이치는 강\', \'text\': \'굽이치는 강은 탭된 채로 전장에 들어온다.\\n{T}: {W} 또는 {U}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'강은 수많은 줄기로 갈라져 할리마르해로 흘러갔다. 같은 강줄기를 다시 따라가는 것은 불가능하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429801&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3696f310-d11a-40c0-8da4-ca6f3a4eba9b\', \'multiverseId\': 429801}, \'multiverseid\': 429801}, {\'name\': \'Rio Sinuoso\', \'text\': \'Rio Sinuoso entra no campo de batalha virado.\\n{T}: Adicione {W} ou {U} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'O rio dividia-se em vários canais ao fluir para o Mar de Halimar. Poucos viajantes conseguiam seguir o mesmo canal duas vezes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429819&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3f4b76f9-15c9-4426-a755-c5aa75829029\', \'multiverseId\': 429819}, \'multiverseid\': 429819}, {\'name\': \'Извилистая Река\', \'text\': \'Извилистая Река выходит на поле битвы повернутой.\\n{T}: добавьте {W} или {U} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Впадая в Халимарское море, река разделяется на множество рукавов. Немногим путешественникам удавалось пройти одним и тем же путем дважды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429837&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'54a517d2-871b-4fb5-8077-2348810fbbd9\', \'multiverseId\': 429837}, \'multiverseid\': 429837}, {\'name\': \'蜿蜒河流\', \'text\': \'蜿蜒河流须横置进战场。\\n{T}：加{W}或{U}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'河流奔向哈利玛海途中折出众多支流。鲜有旅人能循着同一条支流走两次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429693&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5c56abd-d1a2-4dc6-894c-2045cdc3eeff\', \'multiverseId\': 429693}, \'multiverseid\': 429693}, {\'name\': \'蜿蜒河流\', \'text\': \'蜿蜒河流須橫置進戰場。\\n{T}：加{W}或{U}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'河流奔向哈利瑪海途中折出眾多支流。鮮有旅人能循著同一條支流走兩次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429711&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'96d61398-424d-463a-b121-c7410f6fad92\', \'multiverseId\': 429711}, \'multiverseid\': 429711}]', '[{\'name\': \'Mächtiger Sprung\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 und Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich spüre in der zweiten Sonne die Herrlichkeit des Gott-Pharaos und erhebe mich auf ihren Strahlen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426991&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2eb420c0-b767-4b68-a759-c4faf513bb1c\', \'multiverseId\': 426991}, \'multiverseid\': 426991}, {\'name\': \'Salto formidable\', \'text\': \'La criatura objetivo obtiene +2/+2 y gana la habilidad de volar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Percibo la presencia del Dios Faraón en el Segundo Sol, y sus rayos me elevan".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427260&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed495ee3-ad95-4bc1-b008-fe1b6359043a\', \'multiverseId\': 427260}, \'multiverseid\': 427260}, {\'name\': \'Sacré saut\', \'text\': "La créature ciblée gagne +2/+2 et acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "« Je sens la présence du Dieu-Pharaon dans le Second Soleil et je m\'élève, portée par ses rayons. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427529&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f61a7785-185b-4a6f-a37b-cf0b661737e1\', \'multiverseId\': 427529}, \'multiverseid\': 427529}, {\'name\': \'Balzo Possente\', \'text\': \'Una creatura bersaglio prende +2/+2 e ha volare fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Avverto la presenza del Dio Faraone nel secondo sole e mi innalzo dinanzi ai suoi raggi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427798&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f4f2ac4-4b13-4cde-b477-7bf9bc701990\', \'multiverseId\': 427798}, \'multiverseid\': 427798}, {\'name\': \'力強い跳躍\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受けるとともに飛行を得る。\', \'type\': \'インスタント\', \'flavor\': \'「副陽に王神の存在を感じる。私はその光に向かうわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428067&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29416e1b-6819-416e-8349-ef6370669645\', \'multiverseId\': 428067}, \'multiverseid\': 428067}, {\'name\': \'힘찬 도약\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받고 비행을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"두 번째 태양에서 신 파라오의 존재가 느껴진다. 난 그 빛을 받고 일어서리라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428336&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'63f448bc-ce71-408c-ba9d-955db7c9f8dd\', \'multiverseId\': 428336}, \'multiverseid\': 428336}, {\'name\': \'Salto Poderoso\', \'text\': \'A criatura alvo recebe +2/+2 e ganha voar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Sinto a presença do Faraó-Deus no Segundo Sol, e seus raios me elevam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428605&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c251bd2-76bf-4a3d-8dfb-ca5baf21c67a\', \'multiverseId\': 428605}, \'multiverseid\': 428605}, {\'name\': \'Мощный Прыжок\', \'text\': \'Целевое существо получает +2/+2 и Полет до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я чувствую Бога-Фараона во Втором Солнце — и поднимаюсь на его лучах».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428874&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec44fa61-67e1-4453-b3d4-e314a10a9ac0\', \'multiverseId\': 428874}, \'multiverseid\': 428874}, {\'name\': \'大步飞跃\', \'text\': \'直到回合结束，目标生物得+2/+2且获得飞行异能。\', \'type\': \'瞬间\', \'flavor\': \'「我感受到神日中法老神的存在，我朝其光芒而起。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429143&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8117ef18-fd5b-47ee-a980-2a1cbf88a289\', \'multiverseId\': 429143}, \'multiverseid\': 429143}, {\'name\': \'大步飛躍\', \'text\': \'直到回合結束，目標生物得+2/+2且獲得飛行異能。\', \'type\': \'瞬間\', \'flavor\': \'「我感受到神日中法老神的存在，我朝其光芒而起。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429412&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3d148ca9-2e4d-4c61-8b10-51a06b919be6\', \'multiverseId\': 429412}, \'multiverseid\': 429412}]', '[{\'name\': \'Naga-Orakel\', \'text\': \'Wenn das Naga-Orakel ins Spiel kommt, schaue dir die obersten drei Karten deiner Bibliothek an. Lege eine beliebige Anzahl davon auf deinen Friedhof und den Rest in beliebiger Reihenfolge oben auf deine Bibliothek.\', \'type\': \'Kreatur — Naga, Kleriker\', \'flavor\': \'„Alle unsere Fragen werden in der Stunde der Offenbarung beantwortet werden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427033&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f3b9efa-c8c1-4ac1-a579-6d8825016a31\', \'multiverseId\': 427033}, \'multiverseid\': 427033}, {\'name\': \'Oráculo naga\', \'text\': \'Cuando el Oráculo naga entre al campo de batalla, mira las tres primeras cartas de tu biblioteca. Pon cualquier cantidad de ellas en tu cementerio y el resto en la parte superior de tu biblioteca en cualquier orden.\', \'type\': \'Criatura — Clérigo naga\', \'flavor\': \'"Todas las preguntas tendrán su respuesta en la Hora de la Revelación."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427302&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'77e2b384-5797-4703-80ae-febd2c48893e\', \'multiverseId\': 427302}, \'multiverseid\': 427302}, {\'name\': \'Oracle naga\', \'text\': "Quand l\'Oracle naga arrive sur le champ de bataille, regardez les trois cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles dans votre cimetière et remettez ensuite le reste au-dessus de votre bibliothèque, dans l\'ordre de votre choix.", \'type\': \'Créature : naga et clerc\', \'flavor\': "« Les réponses à toutes vos questions seront révélées à l\'Âge de la Révélation. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427571&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0ae5dd6-64ae-48ee-9566-4bb251738ddd\', \'multiverseId\': 427571}, \'multiverseid\': 427571}, {\'name\': \'Oracolo Naga\', \'text\': "Quando l\'Oracolo Naga entra nel campo di battaglia, guarda le prime tre carte del tuo grimorio. Mettine un qualsiasi numero nel tuo cimitero e le altre in cima al tuo grimorio in qualsiasi ordine.", \'type\': \'Creatura — Chierico Naga\', \'flavor\': \'"Tutte le domande troveranno risposta nell\\\'Era della rivelazione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427840&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1b9f464-877d-4031-9a2a-6e1b882104f0\', \'multiverseId\': 427840}, \'multiverseid\': 427840}, {\'name\': \'ナーガの神託者\', \'text\': \'ナーガの神託者が戦場に出たとき、あなたのライブラリーの一番上からカードを３枚見る。そのうちの望む枚数をあなたの墓地に置き、残りをあなたのライブラリーの一番上に望む順番で戻す。\', \'type\': \'クリーチャー — ナーガ・クレリック\', \'flavor\': \'「すべての疑問は、啓示の刻に解けるだろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428109&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a6c066da-5c78-4081-886e-b6b864f33d7f\', \'multiverseId\': 428109}, \'multiverseid\': 428109}, {\'name\': \'나가 예언자\', \'text\': \'나가 예언자가 전장에 들어올 때, 당신의 서고 맨 위의 카드 세 장을 본다. 그중 원하는 만큼을 당신의 무덤에 넣고 나머지 카드들은 당신의 서고 맨 위에 원하는 순서로 놓는다.\', \'type\': \'생물 — 나가 성직자\', \'flavor\': \'"계시의 시간 동안 모든 질문에 대한 답을 얻을 수 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428378&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d204e1b1-089b-4f15-81e1-abb36e0581aa\', \'multiverseId\': 428378}, \'multiverseid\': 428378}, {\'name\': \'Oráculo Naga\', \'text\': \'Quando Oráculo Naga entrar no campo de batalha, olhe os três cards do topo de seu grimório. Coloque qualquer quantidade deles no seu cemitério e o restante no topo do seu grimório em qualquer ordem.\', \'type\': \'Criatura — Naga Clérigo\', \'flavor\': \'"Todas as perguntas serão respondidas durante a Hora da Revelação."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428647&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc0f5f1c-c5f5-41e5-8d28-7ed365236941\', \'multiverseId\': 428647}, \'multiverseid\': 428647}, {\'name\': \'Нага-Оракул\', \'text\': \'Когда Нага-Оракул выходит на поле битвы, посмотрите три верхние карты вашей библиотеки. Положите любое количество из них на ваше кладбище, а остальные — обратно на верх вашей библиотеки в любом порядке.\', \'type\': \'Существо — Нага Священник\', \'flavor\': \'«Час Откровения даст ответ на все вопросы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428916&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7b86e7c6-f2c7-44ae-aaa0-b235eca08c4f\', \'multiverseId\': 428916}, \'multiverseid\': 428916}, {\'name\': \'那伽先知\', \'text\': \'当那伽先知进战场时，检视你牌库顶的三张牌。将其中任意数量的牌置入你的坟墓场，其余则以任意顺序放回你的牌库顶。\', \'type\': \'生物～那伽／僧侣\', \'flavor\': \'「所有疑问都将在预示时刻得到解答。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429185&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'412f26be-89c2-4d73-be4f-c4e4635e403a\', \'multiverseId\': 429185}, \'multiverseid\': 429185}, {\'name\': \'那伽先知\', \'text\': \'當那伽先知進戰場時，檢視你牌庫頂的三張牌。將其中任意數量的牌置入你的墳墓場，其餘則以任意順序放回你的牌庫頂。\', \'type\': \'生物～那伽／僧侶\', \'flavor\': \'「所有疑問都將在預示時刻得到解答。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429454&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'31a60330-9f06-46d3-ba69-3ade055e3440\', \'multiverseId\': 429454}, \'multiverseid\': 429454}]', '[{\'name\': \'Naga-Vitalistin\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana eines beliebigen Typs, das ein Land, das du kontrollierst, produzieren könnte.\', \'type\': \'Kreatur — Naga, Druide\', \'flavor\': \'„Die Erde selbst ist mit der Essenz des Gott-Pharaos durchzogen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427147&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8d8e390-48a6-4088-a84b-664bb093c26f\', \'multiverseId\': 427147}, \'multiverseid\': 427147}, {\'name\': \'Vitalista naga\', \'text\': \'{T}: Agrega a tu reserva de maná un maná de cualquier tipo que pueda producir una tierra que controlas.\', \'type\': \'Criatura — Druida naga\', \'flavor\': \'"Las tierras del Dios Faraón están bañadas por su aliento".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427416&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ce05316-98d8-4f01-80af-8f528cc16318\', \'multiverseId\': 427416}, \'multiverseid\': 427416}, {\'name\': \'Vitaliste naga\', \'text\': "{T} : Ajoutez à votre réserve un mana de n\'importe quel type qu\'un terrain que vous contrôlez pourrait produire.", \'type\': \'Créature : naga et druide\', \'flavor\': \'« Les terres du Dieu-Pharaon sont empreintes de son souffle. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427685&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e40e89d1-ff52-4138-a916-c62510a61136\', \'multiverseId\': 427685}, \'multiverseid\': 427685}, {\'name\': \'Naga Vitalista\', \'text\': \'{T}: Aggiungi alla tua riserva di mana un mana di un qualsiasi tipo che una terra che controlli potrebbe produrre.\', \'type\': \'Creatura — Druido Naga\', \'flavor\': \'"Le terre del Dio Faraone sono pervase dal suo respiro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427954&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'797aedc1-0a89-4875-b6f3-557654e2033a\', \'multiverseId\': 427954}, \'multiverseid\': 427954}, {\'name\': \'ナーガの生気論者\', \'text\': \'{T}：あなたのマナ・プールに、あなたがコントロールする土地が生み出すことのできるタイプのうち望むタイプのマナ１点を加える。\', \'type\': \'クリーチャー — ナーガ・ドルイド\', \'flavor\': \'「王神の土地は王神の生気で満ちている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428223&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ee295ddf-d850-4b48-96af-039e5900752d\', \'multiverseId\': 428223}, \'multiverseid\': 428223}, {\'name\': \'나가 활력자\', \'text\': \'{T}: 당신이 조종하는 대지가 생산할 수 있는 유형의 마나 한 개를 당신의 마나풀에 담는다.\', \'type\': \'생물 — 나가 드루이드\', \'flavor\': \'"신 파라오의 대지는 그의 숨결로 가득하다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428492&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05ef8965-63bd-47bf-815d-86d5c07a49d3\', \'multiverseId\': 428492}, \'multiverseid\': 428492}, {\'name\': \'Vitalista Naga\', \'text\': \'{T}: Adicione à sua reserva de mana um mana de qualquer tipo que um terreno que você controla possa gerar.\', \'type\': \'Criatura — Naga Druida\', \'flavor\': \'"As terras do Faraó-Deus estão impregnadas com seu hálito."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428761&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'903398f6-5b62-4660-ab4d-cb4b29aa9016\', \'multiverseId\': 428761}, \'multiverseid\': 428761}, {\'name\': \'Нага-Жизнеродительница\', \'text\': \'{T}: добавьте в ваше хранилище маны одну ману любого типа, который могла бы произвести земля под вашим контролем.\', \'type\': \'Существо — Нага Друид\', \'flavor\': \'«Земли Бога-Фараона наполнены его дыханием».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429030&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'92059f3e-eb75-46fe-b35e-95beabc452bd\', \'multiverseId\': 429030}, \'multiverseid\': 429030}, {\'name\': \'活力那伽\', \'text\': \'{T}：加一点法术力到你的法术力池中，其类别为由你操控的地能产生之任一类别。\', \'type\': \'生物～那伽／德鲁伊\', \'flavor\': \'「法老神的土地上也弥漫着法老神的吐息。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429299&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b026a111-7a6c-4e2c-b8ab-55bba6512479\', \'multiverseId\': 429299}, \'multiverseid\': 429299}, {\'name\': \'活力那伽\', \'text\': \'{T}：加一點魔法力到你的魔法力池中，其類別為由你操控的地能產生之任一類別。\', \'type\': \'生物～那伽／德魯伊\', \'flavor\': \'「法老神的土地上也瀰漫著法老神的吐息。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429568&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'26b718de-4986-4a0e-80bb-ffb804faf16a\', \'multiverseId\': 429568}, \'multiverseid\': 429568}]', '[{\'name\': \'Neheb der Ehrenhafte\', \'text\': \'Erstschlag\\nAndere Minotauren, die du kontrollierst, haben Erstschlag.\\nSolange du eine oder weniger Karten auf deiner Hand hast, erhalten Minotauren, die du kontrollierst, +2/+0.\\nImmer wenn Neheb der Ehrenhafte einem Spieler Kampfschaden zufügt, wirft jeder Spieler eine Karte ab.\', \'type\': \'Legendäre Kreatur — Minotaurus, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427174&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1725bceb-a51a-4fa7-b109-07463c07b48e\', \'multiverseId\': 427174}, \'multiverseid\': 427174}, {\'name\': \'Neheb, el Digno\', \'text\': \'Daña primero.\\nLos otros Minotauros que controlas tienen la habilidad de dañar primero.\\nMientras tengas una carta o menos en tu mano, los Minotauros que controlas obtienen +2/+0.\\nSiempre que Neheb, el Digno haga daño de combate a un jugador, cada jugador descarta una carta.\', \'type\': \'Criatura legendaria — Guerrero minotauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427443&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db8751a0-b507-4137-93d3-1590811e94ec\', \'multiverseId\': 427443}, \'multiverseid\': 427443}, {\'name\': \'Neheb, le Valeureux\', \'text\': "Initiative\\nLes autres minotaures que vous contrôlez ont l\'initiative.\\nTant que vous avez une carte ou moins en main, les minotaures que vous contrôlez gagnent +2/+0.\\nÀ chaque fois que Neheb, le Valeureux inflige des blessures de combat à un joueur, chaque joueur se défausse d\'une carte.", \'type\': \'Créature légendaire : minotaure et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427712&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'577efe0a-76d3-424f-9b3c-f444b93f6f1b\', \'multiverseId\': 427712}, \'multiverseid\': 427712}, {\'name\': \'Neheb, il Prescelto\', \'text\': \'Attacco improvviso\\nGli altri Minotauri che controlli hanno attacco improvviso.\\nFintanto che hai una o meno carte in mano, i Minotauri che controlli prendono +2/+0.\\nOgniqualvolta Neheb, il Prescelto infligge danno da combattimento a un giocatore, ogni giocatore scarta una carta.\', \'type\': \'Creatura Leggendaria — Guerriero Minotauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427981&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f5bd347-0083-4470-9ce7-dd9c8004e69e\', \'multiverseId\': 427981}, \'multiverseid\': 427981}, {\'name\': \'蓋世の英雄、ネヘブ\', \'text\': \'先制攻撃\\nあなたがコントロールする他のミノタウルスは先制攻撃を持つ。\\nあなたの手札のカードが１枚以下であるかぎり、あなたがコントロールするミノタウルスは＋２/＋０の修整を受ける。\\n蓋世の英雄、ネヘブがプレイヤー１人に戦闘ダメージを与えるたび、各プレイヤーはそれぞれカード１枚を捨てる。\', \'type\': \'伝説のクリーチャー — ミノタウルス・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428250&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5336988d-9022-4810-ba5e-f295743380d2\', \'multiverseId\': 428250}, \'multiverseid\': 428250}, {\'name\': \'가치 있는 자 네헵\', \'text\': \'선제공격\\n당신이 조종하는 다른 미노타우로스들은 선제공격을 가진다.\\n당신의 손에 있는 카드가 한 장 이하인 한, 당신이 조종하는 미노타우로스는 +2/+0을 받는다.\\n가치 있는 자 네헵이 플레이어에게 전투피해를 입힐 때마다, 각 플레이어는 카드 한 장을 버린다.\', \'type\': \'전설적 생물 — 미노타우로스 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428519&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'536a1dcc-c4a0-4f58-8241-d27949e22663\', \'multiverseId\': 428519}, \'multiverseid\': 428519}, {\'name\': \'Neheb, o Digno\', \'text\': \'Iniciativa\\nOs outros Minotauros que você controla têm iniciativa.\\nEnquanto você tiver um card ou menos na mão, os Minotauros que você controla recebem +2/+0.\\nToda vez que Neheb, o Digno, causa dano de combate a um jogador, cada jogador descarta um card.\', \'type\': \'Criatura Lendária — Minotauro Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428788&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f5ff8e4c-2161-4543-b7d6-d76d3ad864e6\', \'multiverseId\': 428788}, \'multiverseid\': 428788}, {\'name\': \'Нехеб, Достойный\', \'text\': \'Первый удар\\nДругие Минотавры под вашим контролем имеют Первый удар.\\nПока у вас не больше одной карты в руке, Минотавры под вашим контролем получают +2/+0.\\nКаждый раз, когда Нехеб, Достойный наносит боевые повреждения игроку, каждый игрок сбрасывает карту.\', \'type\': \'Легендарное Существо — Минотавр Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429057&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'820ea895-0b42-4c2b-8e38-e774040a7e62\', \'multiverseId\': 429057}, \'multiverseid\': 429057}, {\'name\': \'豪英内赫布\', \'text\': \'先攻\\n由你操控的其他牛头怪具有先攻异能。\\n只要你的手牌为一张或更少，由你操控的牛头怪便得+2/+0。\\n每当豪英内赫布对任一牌手造成战斗伤害时，每位牌手各弃一张牌。\', \'type\': \'传奇生物～牛头怪／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429326&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cbcda59c-f682-4bc7-926e-c127122f80c9\', \'multiverseId\': 429326}, \'multiverseid\': 429326}, {\'name\': \'豪英內赫布\', \'text\': \'先攻\\n由你操控的其他牛頭怪具有先攻異能。\\n只要你的手牌為一張或更少，由你操控的牛頭怪便得+2/+0。\\n每當豪英內赫布對任一玩家造成戰鬥傷害時，每位玩家各棄一張牌。\', \'type\': \'傳奇生物～牛頭怪／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429595&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4e64e432-ae43-4d68-ae46-df8b596aab74\', \'multiverseId\': 429595}, \'multiverseid\': 429595}]', "[{'name': 'Neue Perspektiven', 'text': 'Wenn die Neuen Perspektiven ins Spiel kommen, ziehe drei Karten.\\nSolange du sieben oder mehr Karten auf deiner Hand hast, kannst du {0} bezahlen, anstatt Umwandlungskosten zu bezahlen.', 'type': 'Verzauberung', 'flavor': 'Wissen und Unwissen sind oft nur eine Frage der Perspektive.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427034&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0b5cca00-ba38-46df-a8af-58a2fa4cb881', 'multiverseId': 427034}, 'multiverseid': 427034}, {'name': 'Nuevas perspectivas', 'text': 'Cuando las Nuevas perspectivas entren al campo de batalla, roba tres cartas.\\nMientras tengas siete cartas o más en tu mano, puedes pagar {0} en vez de pagar los costes de ciclo.', 'type': 'Encantamiento', 'flavor': 'El entendimiento es una cuestión de perspectiva.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427303&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'be55088e-095b-498b-a0dc-62e6e13f1285', 'multiverseId': 427303}, 'multiverseid': 427303}, {'name': 'Nouvelles perspectives', 'text': 'Quand les Nouvelles perspectives arrivent sur le champ de bataille, piochez trois cartes.\\nTant que vous avez au moins sept cartes en main, vous pouvez payer {0} à la place des coûts de recyclage.', 'type': 'Enchantement', 'flavor': 'La compréhension est une question de perspective.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427572&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6ceb5913-2f81-4d6b-8de3-e6e28a32e20e', 'multiverseId': 427572}, 'multiverseid': 427572}, {'name': 'Nuove Prospettive', 'text': 'Quando le Nuove Prospettive entrano nel campo di battaglia, pesca tre carte.\\nFintanto che hai sette o più carte in mano, puoi pagare {0} invece di pagare i costi di ciclo.', 'type': 'Incantesimo', 'flavor': 'La comprensione è una questione di prospettiva.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427841&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8a25af19-18ba-48de-821a-1d4a9acef503', 'multiverseId': 427841}, 'multiverseid': 427841}, {'name': '新たな視点', 'text': '新たな視点が戦場に出たとき、カードを３枚引く。\\nあなたの手札に７枚以上のカードがあるかぎり、あなたはサイクリング・コストを支払うのではなく{0}を支払ってもよい。', 'type': 'エンチャント', 'flavor': '理解とは視点の問題なのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428110&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7200c4b1-9bed-4178-835c-93a16b0b7449', 'multiverseId': 428110}, 'multiverseid': 428110}, {'name': '새로운 관점', 'text': '새로운 관점이 전장에 들어올 때, 카드 세 장을 뽑는다.\\n당신의 손에 카드가 일곱 장 이상 있는 한, 당신은 순환 비용을 지불하는 대신 {0}을 지불할 수 있다.', 'type': '부여마법', 'flavor': '이해는 관점의 문제다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428379&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '55853ad1-cc10-4be5-9f60-5960767e461d', 'multiverseId': 428379}, 'multiverseid': 428379}, {'name': 'Novas Perspectivas', 'text': 'Quando Novas Perspectivas entrar no campo de batalha, compre três cards.\\nEnquanto tiver sete ou mais cards em sua mão, você pode pagar {0} em vez de pagar custos de reciclagem.', 'type': 'Encantamento', 'flavor': 'O entendimento é questão de perspectiva.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428648&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3422315f-d740-40b2-b0ec-3125d4f03d8b', 'multiverseId': 428648}, 'multiverseid': 428648}, {'name': 'Новые Перспективы', 'text': 'Когда Новые Перспективы выходят на поле битвы, возьмите три карты.\\nПока у вас в руке не меньше семи карт, вы можете платить {0} вместо оплаты стоимостей Цикла.', 'type': 'Чары', 'flavor': 'Понимание — вопрос перспективы.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428917&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0e5df42c-42c1-4cbc-8313-561dc72f70b6', 'multiverseId': 428917}, 'multiverseid': 428917}, {'name': '全新观点', 'text': '当全新观点进战场时，抓三张牌。\\n只要你的手牌有七张或更多，你便可以支付{0}，而不支付循环费用。', 'type': '结界', 'flavor': '理解属于观点问题。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429186&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ba3d037e-7714-4008-8053-f29bfe2a29b5', 'multiverseId': 429186}, 'multiverseid': 429186}, {'name': '全新觀點', 'text': '當全新觀點進戰場時，抽三張牌。\\n只要你的手牌有七張或更多，你便可以支付{0}，而不支付循環費用。', 'type': '結界', 'flavor': '理解屬於觀點問題。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429455&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'cd334458-3f94-4d91-bbf3-8a9912a58b80', 'multiverseId': 429455}, 'multiverseid': 429455}]", "[{'name': 'Niemals // Wiederkehren', 'text': 'Zerstöre eine Kreatur oder einen Planeswalker deiner Wahl.', 'type': 'Hexerei', 'flavor': None, 'faceName': 'Niemals', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427183&type=card', 'language': 'German', 'identifiers': {'scryfallId': '767d2820-38a5-45c1-9fc5-3e7417ad0467', 'multiverseId': 427183}, 'multiverseid': 427183}, {'name': 'Jamás // Regresar', 'text': 'Destruye la criatura o planeswalker objetivo.', 'type': 'Conjuro', 'flavor': None, 'faceName': 'Jamás', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427452&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6426d085-8dcf-4c5a-a4b6-9c945a79dca5', 'multiverseId': 427452}, 'multiverseid': 427452}, {'name': 'Impossible // Retour', 'text': 'Détruisez la créature ciblée ou le planeswalker ciblé.', 'type': 'Rituel', 'flavor': None, 'faceName': 'Impossible', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427721&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cb5a38f6-6280-46ae-9cd7-f77b071df402', 'multiverseId': 427721}, 'multiverseid': 427721}, {'name': 'Mai // Tornato', 'text': 'Distruggi una creatura o un planeswalker bersaglio.', 'type': 'Stregoneria', 'flavor': None, 'faceName': 'Mai', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427990&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a117ae7a-8ece-43bc-b0f3-8ee6a151f629', 'multiverseId': 427990}, 'multiverseid': 427990}, {'name': '不帰 // 回帰', 'text': 'クリーチャー１体かプレインズウォーカー１体を対象とし、それを破壊する。', 'type': 'ソーサリー', 'flavor': None, 'faceName': '不帰', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428259&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ab09672d-e62e-45cf-bd58-6871e82b581b', 'multiverseId': 428259}, 'multiverseid': 428259}, {'name': '영영 // 귀환', 'text': '생물이나 플레인즈워커를 목표로 정한다. 그 목표를 파괴한다.', 'type': '집중마법', 'flavor': None, 'faceName': '영영', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428528&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7c025346-da92-4423-871b-a2b7c7aa3f0f', 'multiverseId': 428528}, 'multiverseid': 428528}, {'name': 'Jamais // Retornar', 'text': 'Destrua a criatura ou o planeswalker alvo.', 'type': 'Feitiço', 'flavor': None, 'faceName': 'Jamais', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428797&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f71dd2c7-9c9b-47cd-b368-2110dbd63b09', 'multiverseId': 428797}, 'multiverseid': 428797}, {'name': 'Никогда // Не Возвращаться', 'text': 'Уничтожьте целевое существо или planeswalker-а.', 'type': 'Волшебство', 'flavor': None, 'faceName': 'Никогда', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429066&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4d75ae65-dbe9-4a68-bb6a-e7073bfbaa03', 'multiverseId': 429066}, 'multiverseid': 429066}, {'name': '往生 // 复返', 'text': '消灭目标生物或鹏洛客。', 'type': '法术', 'flavor': None, 'faceName': '往生', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429335&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ae7c9ec0-1512-441c-a962-e4b7fe72f639', 'multiverseId': 429335}, 'multiverseid': 429335}, {'name': '往生 // 復返', 'text': '消滅目標生物或鵬洛客。', 'type': '巫術', 'flavor': None, 'faceName': '往生', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429604&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '8804c8db-4722-4f62-8396-887e6a0af0a2', 'multiverseId': 429604}, 'multiverseid': 429604}]", '[{\'name\': \'Nissa, Hüterin der Elemente\', \'text\': \'+2: Hellsicht 2.\\n0: Schaue dir die oberste Karte deiner Bibliothek an. Falls es eine Länderkarte oder eine Kreaturenkarte mit umgewandelten Manakosten kleiner oder gleich der Anzahl an Loyalitätsmarken auf Nissa, Hüterin der Elemente, ist, kannst du die Karte ins Spiel bringen.\\n−6: Enttappe bis zu zwei Länder deiner Wahl, die du kontrollierst. Sie werden bis zum Ende des Zuges zu 5/5 Elementarwesen-Kreaturen mit Flugfähigkeit und Eile. Sie sind auch immer noch Länder.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427175&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08e18c7d-6c8b-4c50-b8f7-bf050a7cdaf4\', \'multiverseId\': 427175}, \'multiverseid\': 427175}, {\'name\': \'Nissa, encarnación de los elementos\', \'text\': \'+2: Adivina 2.\\n0: Mira la primera carta de tu biblioteca. Si es una carta de tierra o de criatura con un coste de maná convertido menor o igual a la cantidad de contadores de lealtad sobre Nissa, encarnación de los elementos, puedes poner esa carta en el campo de batalla.\\n−6: Endereza hasta dos tierras objetivo que controlas. Se convierten en criaturas Elementales 5/5 con las habilidades de volar y prisa hasta el final del turno. Siguen siendo tierras.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427444&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'062844ed-4d06-4444-a3ce-72a60760b821\', \'multiverseId\': 427444}, \'multiverseid\': 427444}, {\'name\': \'Nissa, intendante des éléments\', \'text\': "+2 : Regard 2.\\n0 : Regardez la carte du dessus de votre bibliothèque. Si c\'est une carte de terrain ou de créature avec un coût converti de mana inférieur ou égal au nombre de marqueurs « loyauté » sur Nissa, intendante des éléments, vous pouvez mettre cette carte sur le champ de bataille.\\n-6 : Dégagez jusqu\'à deux terrains ciblés que vous contrôlez. Ils deviennent des créatures 5/5 Élémental avec le vol et la célérité jusqu\'à la fin du tour. Ce sont toujours des terrains.", \'type\': \'Planeswalker : Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427713&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a1777ffd-ccf9-48eb-adac-93ea3ed5fe75\', \'multiverseId\': 427713}, \'multiverseid\': 427713}, {\'name\': \'Nissa, Guardiana degli Elementi\', \'text\': \'+2: Profetizza 2.\\n0: Guarda la prima carta del tuo grimorio. Se è una carta terra o una carta creatura con costo di mana convertito pari o inferiore al numero di segnalini fedeltà su Nissa, Guardiana degli Elementi, puoi mettere quella carta sul campo di battaglia.\\n-6: STAPpa fino a due terre bersaglio che controlli. Diventano creature Elementale 5/5 con volare e rapidità fino alla fine del turno. Sono ancora terre.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ffa505e-4c05-464a-beda-65c7a0eee416\', \'multiverseId\': 427982}, \'multiverseid\': 427982}, {\'name\': \'自然に仕える者、ニッサ\', \'text\': \'+2：占術２を行う。\\n0：あなたのライブラリーの一番上のカードを見る。それが土地・カードであるか、点数で見たマナ・コストが自然に仕える者、ニッサの上に置かれている忠誠カウンターの総数以下であるクリーチャー・カードであるなら、あなたはそのカードを戦場に出してもよい。\\n-6：あなたがコントロールする土地最大２つを対象とし、それらをアンタップする。ターン終了時まで、それらは飛行と速攻を持つ５/５のエレメンタル・クリーチャーになる。それらは土地でもある。\', \'type\': \'プレインズウォーカー — ニッサ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428251&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac06e6d5-f75d-4e4c-a1a9-0725dbaa33d5\', \'multiverseId\': 428251}, \'multiverseid\': 428251}, {\'name\': \'원소의 관리인 니사\', \'text\': \'+2: 점술 2를 한다.\\n0: 당신의 서고 맨 위의 카드를 본다. 그 카드가 대지 카드 또는 생물 카드이고, 전환마나비용이 원소의 관리인 니사에 올려진 충성 카운터 개수보다 적거나 같다면, 당신은 그 카드를 전장에 놓을 수 있다.\\n−6: 당신이 조종하는 대지를 최대 두 개까지 목표로 정한다. 그 대지들을 언탭한다. 그 대지들은 턴종료까지 비행과 신속을 가진 5/5 정령 생물이 된다. 그 대지들은 생물이 된 이후에도 여전히 대지이다.\', \'type\': \'플레인즈워커 — 니사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428520&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'158cc9fd-179c-4a69-8c2e-ea3b30a9a082\', \'multiverseId\': 428520}, \'multiverseid\': 428520}, {\'name\': \'Nissa, Guardiã dos Elementos\', \'text\': \'+2: Use vidência 2.\\n0: Olhe o card do topo de seu grimório. Se for um card de terreno ou de criatura com custo de mana convertido igual ou inferior ao número de marcadores de lealdade em Nissa, Guardiã dos Elementos, você poderá colocar aquele card no campo de batalha.\\n−6: Desvire até dois terrenos alvo que você controla. Eles se tornam criaturas 5/5 do tipo Elemental com voar e ímpeto até o final do turno. Elas ainda são terrenos.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428789&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'189c75f3-ca30-409f-86f0-1e29cc1d9c11\', \'multiverseId\': 428789}, \'multiverseid\': 428789}, {\'name\': \'Нисса, Проводница Стихий\', \'text\': \'+2: предскажите 2.\\n0: посмотрите верхнюю карту вашей библиотеки. Если это карта земли или карта существа с конвертированной мана-стоимостью, меньшей или равной количеству жетонов верности на Ниссе, Проводнице Стихий, то вы можете положить ту карту на поле битвы.\\n−6: разверните не более двух целевых земель под вашим контролем. Они становятся существами 5/5 Элементаль с Полетом и Ускорением до конца хода. При этом они остаются землями.\', \'type\': \'Planeswalker — Нисса\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429058&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39d0f576-2614-46ff-be95-b28554e682a2\', \'multiverseId\': 429058}, \'multiverseid\': 429058}, {\'name\': \'地源守护妮莎\', \'text\': \'+2：占卜2。\\n0：检视你的牌库顶牌。如果该牌是地牌或总法术力费用等于或小于地源守护妮莎上忠诚指示物数量的生物牌，则你可以将该牌放进战场。\\n−6：重置至多两个目标由你操控的地。它们成为5/5，具飞行与敏捷异能的元素生物直到回合结束。它们仍然是地。\', \'type\': \'鹏洛客～妮莎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429327&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b193efb-1e83-453d-a6fa-0690634b28cf\', \'multiverseId\': 429327}, \'multiverseid\': 429327}, {\'name\': \'地源守護妮莎\', \'text\': \'+2：占卜2。\\n0：檢視你的牌庫頂牌。如果該牌是地牌或總魔法力費用等於或小於地源守護妮莎上忠誠指示物數量的生物牌，則你可以將該牌放進戰場。\\n−6：重置至多兩個目標由你操控的地。它們成為5/5，具飛行與敏捷異能的元素生物直到回合結束。它們仍然是地。\', \'type\': \'鵬洛客～妮莎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429596&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e820a5ec-8a73-4073-8cb3-68d104df036d\', \'multiverseId\': 429596}, \'multiverseid\': 429596}]', '[{\'name\': \'Oashra-Ackerbäuerin\', \'text\': \'{2}{G}, {T}, opfere die Oashra-Ackerbäuerin: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'„Wie das Obst im Garten, so werden auch wir aufgelesen werden, wenn die Zeit reif ist."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427148&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3542a71f-8b97-4884-8a8d-69e402f5e7c4\', \'multiverseId\': 427148}, \'multiverseid\': 427148}, {\'name\': \'Cultivadora de Oashra\', \'text\': \'{2}{G}, {T}, sacrificar la Cultivadora de Oashra: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'"Como los frutos del campo, a nosotros también se nos cosechará llegado el momento".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427417&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17c8ccbd-ce77-4faa-b0d7-6ff15917b73f\', \'multiverseId\': 427417}, \'multiverseid\': 427417}, {\'name\': "Cultivatrice d\'Oashra", \'text\': "{2}{G}, {T}, sacrifiez la Cultivatrice d\'Oashra : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque.", \'type\': \'Créature : humain et druide\', \'flavor\': "« Nous serons récoltés quand la saison sera venue, comme les fruits d\'un champ. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427686&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b911958b-e9b4-417a-8f85-7f9240ac91d0\', \'multiverseId\': 427686}, \'multiverseid\': 427686}, {\'name\': \'Coltivatrice di Oashra\', \'text\': \'{2}{G}, {T}, Sacrifica la Coltivatrice di Oashra: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': \'"Come frutti maturi, verremo colti quando la stagione sarà propizia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427955&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c24b152-4818-4dd4-998d-fa150c861ef0\', \'multiverseId\': 427955}, \'multiverseid\': 427955}, {\'name\': \'オアシュラの耕作者\', \'text\': \'{2}{G}, {T}, オアシュラの耕作者を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探してそれをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'「時期が来れば私たちも果実のように収穫されるのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428224&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad93ac01-b2dc-45e2-bbe0-c894f3c658be\', \'multiverseId\': 428224}, \'multiverseid\': 428224}, {\'name\': \'오아시라 재배자\', \'text\': \'{2}{G}, {T}, 오아시라 재배자를 희생한다: 당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'생물 — 인간 드루이드\', \'flavor\': \'"들판의 열매처럼 때가 되면 우리도 수확될 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428493&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4eb082c1-e114-4e3a-bbeb-6a45aa754039\', \'multiverseId\': 428493}, \'multiverseid\': 428493}, {\'name\': \'Cultivadora de Oashra\', \'text\': \'{2}{G}, {T}, Sacrifique Cultivadora de Oashra: Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe seu grimório.\', \'type\': \'Criatura — Humano Druida\', \'flavor\': \'"Como frutas nos campos, seremos colhidos na estação certa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428762&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aea93701-bd9e-4252-9a8d-eb541254cb49\', \'multiverseId\': 428762}, \'multiverseid\': 428762}, {\'name\': \'Возделывательница из Оашры\', \'text\': \'{2}{G}, {T}, пожертвуйте Возделывательницу из Оашры: найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'«Как плоды в поле, нас соберут, когда придет время».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429031&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2568ba42-b050-4a79-9010-10ab08506f01\', \'multiverseId\': 429031}, \'multiverseid\': 429031}, {\'name\': \'欧夏拉耕者\', \'text\': \'{2}{G}，{T}，牺牲欧夏拉耕者：从你的牌库中搜寻一张基本地牌，将之横置放进战场，然后将你的牌库洗牌。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'「我们跟田地里的水果一样，到了收获季节就会被采摘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429300&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8974226a-b76f-4179-b666-3ece5681f0fc\', \'multiverseId\': 429300}, \'multiverseid\': 429300}, {\'name\': \'歐夏拉耕者\', \'text\': \'{2}{G}，{T}，犧牲歐夏拉耕者：從你的牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後將你的牌庫洗牌。\', \'type\': \'生物～人類／德魯伊\', \'flavor\': \'「我們跟田地裡的水果一樣，到了收穫季節就會被採摘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429569&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'79161e55-ac9d-4a00-a3ca-1077c4c66e4c\', \'multiverseId\': 429569}, \'multiverseid\': 429569}]', "[{'name': 'Oketra die Treue', 'text': 'Doppelschlag, Unzerstörbar\\nOketra die Treue kann nicht angreifen oder blocken, es sei denn, du kontrollierst mindestens drei andere Kreaturen.\\n{3}{W}: Erzeuge einen 1/1 weißen Krieger-Kreaturenspielstein mit Wachsamkeit.', 'type': 'Legendäre Kreatur — Gott', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426992&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1271bd8c-313d-4522-9849-f0312d40292b', 'multiverseId': 426992}, 'multiverseid': 426992}, {'name': 'Oketra, la Leal', 'text': 'Daña dos veces, indestructible.\\nOketra, la Leal no puede atacar ni bloquear a menos que controles, como mínimo, otras tres criaturas.\\n{3}{W}: Crea una ficha de criatura Guerrero blanca 1/1 con la habilidad de vigilancia.', 'type': 'Criatura legendaria — Deidad', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427261&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bd4280fb-5874-443c-b4d4-3c4cb849040c', 'multiverseId': 427261}, 'multiverseid': 427261}, {'name': 'Oketra la Loyale', 'text': 'Double initiative, indestructible\\nOketra la Loyale ne peut ni attaquer ni bloquer à moins que vous ne contrôliez au moins trois autres créatures.\\n{3}{W} : Créez un jeton de créature 1/1 blanche Guerrier avec la vigilance.', 'type': 'Créature légendaire : dieu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427530&type=card', 'language': 'French', 'identifiers': {'scryfallId': '48f4574b-596a-4649-80f3-dc1b99ade51e', 'multiverseId': 427530}, 'multiverseid': 427530}, {'name': 'Oketra la Leale', 'text': 'Doppio attacco, indistruttibile\\nOketra la Leale non può attaccare o bloccare a meno che tu non controlli almeno altre tre creature.\\n{3}{W}: Crea una pedina creatura Guerriero 1/1 bianca con cautela.', 'type': 'Creatura Leggendaria — Dio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427799&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e8fd5bbc-abf0-4787-b073-e928d7f1e45e', 'multiverseId': 427799}, 'multiverseid': 427799}, {'name': '信義の神オケチラ', 'text': '二段攻撃、破壊不能\\nあなたが他のクリーチャーを少なくとも３体コントロールしていないかぎり、信義の神オケチラでは攻撃したりブロックしたりできない。\\n{3}{W}：警戒を持つ白の１/１の戦士・クリーチャー・トークンを１体生成する。', 'type': '伝説のクリーチャー — 神', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428068&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '02f7e68b-9872-442b-86da-2b0e73e4ef10', 'multiverseId': 428068}, 'multiverseid': 428068}, {'name': '진실의 오케트라', 'text': '이단공격, 무적\\n당신이 다른 생물을 세 개 이상 조종하지 않는 한, 진실의 오케트라는 공격하거나 방어할 수 없다.\\n{3}{W}: 경계를 가진 1/1 백색 전사 생물 토큰 한 개를 만든다.', 'type': '전설적 생물 — 신', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428337&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '684fdcac-6bc9-4520-960e-472e7a1f9298', 'multiverseId': 428337}, 'multiverseid': 428337}, {'name': 'Oketra, a Verdadeira', 'text': 'Golpe duplo, indestrutível\\nOketra, a Verdadeira, não pode atacar nem bloquear, a menos que você controle no mínimo três outras criaturas.\\n{3}{W}: Crie uma ficha de criatura branca 1/1 do tipo Guerreiro com vigilância.', 'type': 'Criatura Lendária — Deus', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428606&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7de5ced9-fe7e-456a-9883-5522d3f3e9ad', 'multiverseId': 428606}, 'multiverseid': 428606}, {'name': 'Окетра Верная', 'text': 'Двойной удар, Неразрушимость\\nОкетра Верная не может атаковать или блокировать, если вы контролируете меньше трех других существ.\\n{3}{W}: создайте одну фишку существа 1/1 белый Воин с Бдительностью.', 'type': 'Легендарное Существо — Бог', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428875&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4d9c376d-4200-49b5-a259-031748f86cc5', 'multiverseId': 428875}, 'multiverseid': 428875}, {'name': '真信神欧柯塔', 'text': '连击，不灭\\n除非你操控至少三个其他生物，否则真信神欧柯塔不能进行攻击或阻挡。\\n{3}{W}：派出一个1/1白色，具警戒异能的战士衍生生物。', 'type': '传奇生物～神', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429144&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cbada63b-60a5-4ea7-aebc-596d106ca481', 'multiverseId': 429144}, 'multiverseid': 429144}, {'name': '真信神歐柯塔', 'text': '連擊，不滅\\n除非你操控至少三個其他生物，否則真信神歐柯塔不能進行攻擊或阻擋。\\n{3}{W}：派出一個1/1白色，具警戒異能的戰士衍生生物。', 'type': '傳奇生物～神', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429413&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'df66ccf7-7db4-493c-a3b4-ae748c5cb462', 'multiverseId': 429413}, 'multiverseid': 429413}]", '[{\'name\': \'Oketras Dienerin\', \'text\': \'Fliegend\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\\nEinbalsamieren {3}{W}{W} ({3}{W}{W}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Vogel-Soldat ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Vogel, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426993&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d8f71d7-db9e-410a-beed-31ea6a025dd2\', \'multiverseId\': 426993}, \'multiverseid\': 426993}, {\'name\': \'Asistente de Oketra\', \'text\': \'Vuela.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\\nEmbalsamar {3}{W}{W}. ({3}{W}{W}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Soldado Ave Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Soldado ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427262&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6de78e5b-4b7b-4e5b-950c-314bd3940a8f\', \'multiverseId\': 427262}, \'multiverseid\': 427262}, {\'name\': "Suivante d\'Oketra", \'text\': "Vol\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\\nEmbaumement {3}{W}{W} ({3}{W}{W}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et oiseau et soldat blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : oiseau et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427531&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'988401d2-5baa-407c-93a3-65de74b3b1cb\', \'multiverseId\': 427531}, \'multiverseid\': 427531}, {\'name\': \'Ancella di Oketra\', \'text\': \'Volare\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\\nImbalsamare {3}{W}{W} ({3}{W}{W}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Soldato Uccello Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Soldato Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427800&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f7e3434b-f606-489f-84c5-d5e5c695e3f8\', \'multiverseId\': 427800}, \'multiverseid\': 427800}, {\'name\': \'オケチラの従者\', \'text\': \'飛行\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\\n不朽{3}{W}{W}（{3}{W}{W}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・鳥・兵士であることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 鳥・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428069&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6244c429-7cbe-4649-a1b7-3f01c27aa499\', \'multiverseId\': 428069}, \'multiverseid\': 428069}, {\'name\': \'오케트라 수행원\', \'text\': \'비행\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n방부처리 {3}{W}{W} ({3}{W}{W}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 조류 병사다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 조류 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428338&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f9d2fc47-da07-4ec7-a785-4805e34bdad5\', \'multiverseId\': 428338}, \'multiverseid\': 428338}, {\'name\': \'Assistente de Oketra\', \'text\': \'Voar\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\\nEmbalsamar {3}{W}{W} ({3}{W}{W}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Ave Soldado branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Ave Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428607&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88605560-de3a-4908-ae64-2a7225fad343\', \'multiverseId\': 428607}, \'multiverseid\': 428607}, {\'name\': \'Служительница Окетры\', \'text\': \'Полет\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\\nБальзамирование {3}{W}{W} ({3}{W}{W}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Птицей Солдатом без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Птица Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428876&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b0fe0ada-9f6f-44ca-ac5a-62ed05af4a9c\', \'multiverseId\': 428876}, \'multiverseid\': 428876}, {\'name\': \'欧柯塔的侍从\', \'text\': \'飞行\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\\n遗存{3}{W}{W}（{3}{W}{W}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／鸟／士兵，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～鸟／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429145&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6f2feabf-c76c-4b72-b1d0-e4a6b60d115f\', \'multiverseId\': 429145}, \'multiverseid\': 429145}, {\'name\': \'歐柯塔的侍從\', \'text\': \'飛行\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\\n遺存{3}{W}{W}（{3}{W}{W}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／鳥／士兵，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～鳥／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429414&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'674e6345-6968-4d5f-86f0-1065cd017a00\', \'multiverseId\': 429414}, \'multiverseid\': 429414}]', '[{\'name\': \'Oketras Monument\', \'text\': \'Weiße Kreaturenzauber, die du wirkst, kosten beim Wirken {1} weniger.\\nImmer wenn du einen Kreaturenzauber wirkst, erzeuge einen 1/1 weißen Krieger-Kreaturenspielstein mit Wachsamkeit.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Die Auserwählten werden sich erkennen und im Jenseits Seite an Seite stehen." —Inschrift am Monument\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427204&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d262bdda-1459-43b1-b417-adef9bf20c36\', \'multiverseId\': 427204}, \'multiverseid\': 427204}, {\'name\': \'Monumento a Oketra\', \'text\': \'Te cuesta {1} menos lanzar los hechizos de criatura blancos.\\nSiempre que lances un hechizo de criatura, crea una ficha de criatura Guerrero blanca 1/1 con la habilidad de vigilancia.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"Los dignos respetarán a los dignos. En el más allá, todos estarán unidos". —Inscripción en el monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95252ddb-048d-4b37-9598-d80ea48466d2\', \'multiverseId\': 427473}, \'multiverseid\': 427473}, {\'name\': "Monument d\'Oketra", \'text\': \'Les sorts de créature blancs que vous lancez coûtent {1} de moins à lancer.\\nÀ chaque fois que vous lancez un sort de créature, créez un jeton de créature 1/1 blanche Guerrier avec la vigilance.\', \'type\': \'Artefact légendaire\', \'flavor\': "« Les valeureux respecteront les valeureux. Dans l\'au-delà, tous seront unis. » —Inscription sur le monument", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427742&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04bbf2d7-68d0-44b8-804e-34e4a0624161\', \'multiverseId\': 427742}, \'multiverseid\': 427742}, {\'name\': \'Monumento a Oketra\', \'text\': \'Le magie creatura bianche che lanci costano {1} in meno per essere lanciate.\\nOgniqualvolta lanci una magia creatura, crea una pedina creatura Guerriero 1/1 bianca con cautela.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'"I prescelti dovranno rispettarsi a vicenda, poiché nell\\\'aldilà saranno tutti uniti." —Iscrizione sul monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b224133-dc3b-459a-b327-e5d0c3662279\', \'multiverseId\': 428011}, \'multiverseid\': 428011}, {\'name\': \'オケチラの碑\', \'text\': \'あなたが白のクリーチャー・呪文を唱えるためのコストは{1}少なくなる。\\nあなたがクリーチャー・呪文を１つ唱えるたび、警戒を持つ白の１/１の戦士・クリーチャー・トークンを１体生成する。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'「蓋世の英雄は他の英雄に敬意を払わねばならぬ。来世ではすべての者が結束する。」 ――碑文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428280&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cf1647f5-d3d2-464e-8b1c-c5c5bbc79641\', \'multiverseId\': 428280}, \'multiverseid\': 428280}, {\'name\': \'오케트라 기념비\', \'text\': \'당신이 발동하는 백색 생물 주문들은 발동하는 데 {1}이 덜 든다.\\n당신이 생물 주문을 발동할 때마다, 경계를 가진 1/1 백색 전사 생물 토큰 한 개를 만든다.\', \'type\': \'전설적 마법물체\', \'flavor\': \'"자격있는 자들은 자격있는 자들을 존경해야 한다. 사후 세계에서는 모두가 하나로 일어선다." —기념비 비문\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428549&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d565dac-2ddc-44c3-bab1-fa7cbd6270b9\', \'multiverseId\': 428549}, \'multiverseid\': 428549}, {\'name\': \'Monumento de Oketra\', \'text\': \'As mágicas de criatura brancas que você conjura custam {1} a menos para serem conjuradas.\\nToda vez que você conjurar uma mágica de criatura, crie uma ficha de criatura branca 1/1 do tipo Guerreiro com vigilância.\', \'type\': \'Artefato Lendário\', \'flavor\': \'"Os dignos devem respeitar os dignos. Após a morte, todos estaremos unidos." — Inscrição no monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'313dd3f3-c85f-4755-b0f8-af78662a4287\', \'multiverseId\': 428818}, \'multiverseid\': 428818}, {\'name\': \'Монумент Окетры\', \'text\': \'Разыгрываемые вами заклинания белых существ стоят на {1} меньше.\\nКаждый раз, когда вы разыгрываете заклинание существа, создайте одну фишку существа 1/1 белый Воин с Бдительностью.\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'«Достойные должны уважать достойных. В загробной жизни все будут едины». — надпись на монументе\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429087&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a720a8b9-d0f7-4727-a69b-ac6b176acd9c\', \'multiverseId\': 429087}, \'multiverseid\': 429087}, {\'name\': \'欧柯塔纪念碑\', \'text\': \'你施放的白色生物咒语减少{1}来施放。\\n每当你施放生物咒语时，派出一个1/1白色，具警戒异能的战士衍生生物。\', \'type\': \'传奇神器\', \'flavor\': \'「豪英应彼此敬重，来世仰仗诸位团结一心。」 ～纪念碑铭文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429356&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd8792a3-93a0-44b9-b2f3-a2807268f9f9\', \'multiverseId\': 429356}, \'multiverseid\': 429356}, {\'name\': \'歐柯塔紀念碑\', \'text\': \'你施放的白色生物咒語減少{1}來施放。\\n每當你施放生物咒語時，派出一個1/1白色，具警戒異能的戰士衍生生物。\', \'type\': \'傳奇神器\', \'flavor\': \'「豪英應彼此敬重，來世仰仗諸位團結一心。」 ～紀念碑銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429625&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8c4752a-9679-4d63-8709-e3a1d969bd98\', \'multiverseId\': 429625}, \'multiverseid\': 429625}]', '[{\'name\': \'Perfektes Timing\', \'text\': \'Perfektes Timing fügt einer angreifenden oder blockenden Kreatur deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Kaum etwas hat einen so großen Einfluss auf den Ausgang eines Kampfes wie die Geduld, auf den richtigen Moment zu warten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426989&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ffab20a-8ca2-4f73-8e5b-dee762e89298\', \'multiverseId\': 426989}, \'multiverseid\': 426989}, {\'name\': \'Llegada oportuna\', \'text\': \'La Llegada oportuna hace 3 puntos de daño a la criatura atacante o bloqueadora objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Para un guerrero curtido, hay pocas armas más poderosas que la paciencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427258&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1361dc08-ea7a-4cdd-a2ac-7743639c51a5\', \'multiverseId\': 427258}, \'multiverseid\': 427258}, {\'name\': \'Moment opportun\', \'text\': \'Le Moment opportun inflige 3 blessures à la créature attaquante ou bloqueuse ciblée.\', \'type\': \'Éphémère\', \'flavor\': "Pour un guerrier entraîné, il n\'y a pas d\'arme plus puissante que la patience.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427527&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb884698-86ed-4584-a8d2-5d1a86fd4c13\', \'multiverseId\': 427527}, \'multiverseid\': 427527}, {\'name\': \'Tempismo Impeccabile\', \'text\': \'Il Tempismo Impeccabile infligge 3 danni a una creatura attaccante o bloccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Per un guerriero addestrato, non c\'è arma più potente della pazienza.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427796&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cfe9472d-a18f-4af6-b24e-d18f25f94bfc\', \'multiverseId\': 427796}, \'multiverseid\': 427796}, {\'name\': \'絶妙なタイミング\', \'text\': \'攻撃クリーチャー１体かブロック・クリーチャー１体を対象とする。絶妙なタイミングはそれに３点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'鍛え抜かれた戦士にとって、忍耐よりも有用な武器はほとんどない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428065&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'805bf123-4b92-469a-b7cc-3d351bec1e65\', \'multiverseId\': 428065}, \'multiverseid\': 428065}, {\'name\': \'완벽한 시기\', \'text\': \'공격생물이나 방어생물을 목표로 정한다. 완벽한 시기는 그 생물에게 피해 3점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'훈련된 전사에게 인내보다 더 강력한 무기는 드물다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428334&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'138b4a99-cae0-4e28-bb3a-8636f82c6a3d\', \'multiverseId\': 428334}, \'multiverseid\': 428334}, {\'name\': \'Sincronização Impecável\', \'text\': \'Sincronização Impecável causa 3 pontos de dano à criatura atacante ou bloqueadora alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Para um guerreiro treinado, é difícil haver arma mais potente que a paciência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428603&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'49f1ff41-c41c-4130-bca6-d906258ceb6a\', \'multiverseId\': 428603}, \'multiverseid\': 428603}, {\'name\': \'Безупречный Момент\', \'text\': \'Безупречный Момент наносит 3 повреждения целевому атакующему или блокирующему существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Для искусного воина нет оружия смертоноснее терпения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428872&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'919dc1d5-c2a4-4e0d-8b94-7eb3f4fd873b\', \'multiverseId\': 428872}, \'multiverseid\': 428872}, {\'name\': \'完美时机\', \'text\': \'完美时机对目标进行攻击或阻挡的生物造成3点伤害。\', \'type\': \'瞬间\', \'flavor\': \'对于训练有素的战士而言，鲜有比耐心更为有力的武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429141&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52433c1f-5609-46ef-bd3b-5393b0961eef\', \'multiverseId\': 429141}, \'multiverseid\': 429141}, {\'name\': \'完美時機\', \'text\': \'完美時機對目標進行攻擊或阻擋的生物造成3點傷害。\', \'type\': \'瞬間\', \'flavor\': \'對於訓練有素的戰士而言，鮮有比耐心更為有力的武器。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429410&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ad73bf0d-a87e-4c6c-b3d9-7bd0449ac081\', \'multiverseId\': 429410}, \'multiverseid\': 429410}]', '[{\'name\': \'Pestspeier\', \'text\': \'Bedrohlich\\nWenn der Pestspeier ins Spiel kommt, lege zwei -1/-1-Marken auf eine Kreatur deiner Wahl, die du kontrollierst.\\nImmer wenn ein anderer Zombie, den du kontrollierst, stirbt, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Kreatur — Zombie, Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427075&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f73a29b0-bf38-4303-a418-4d4f63284647\', \'multiverseId\': 427075}, \'multiverseid\': 427075}, {\'name\': \'Escupeplagas\', \'text\': \'Amenaza.\\nCuando el Escupeplagas entre al campo de batalla, pon dos contadores -1/-1 sobre la criatura objetivo que controlas.\\nSiempre que otro Zombie que controlas muera, cada oponente pierde 1 vida.\', \'type\': \'Criatura — Bestia zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427344&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd27df34-dc5d-4ed3-a920-754df87bd6db\', \'multiverseId\': 427344}, \'multiverseid\': 427344}, {\'name\': \'Éructeur de peste\', \'text\': "Menace\\nQuand l\'Éructeur de peste arrive sur le champ de bataille, mettez deux marqueurs -1/-1 sur une créature ciblée que vous contrôlez.\\nÀ chaque fois qu\'un autre zombie que vous contrôlez meurt, chaque adversaire perd 1 point de vie.", \'type\': \'Créature : zombie et bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427613&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db804a71-3987-4119-8e5b-cf976ef8bfa6\', \'multiverseId\': 427613}, \'multiverseid\': 427613}, {\'name\': \'Vomitapeste\', \'text\': \'Minacciare\\nQuando il Vomitapeste entra nel campo di battaglia, metti due segnalini -1/-1 su una creatura bersaglio che controlli.\\nOgniqualvolta un altro Zombie che controlli muore, ogni avversario perde 1 punto vita.\', \'type\': \'Creatura — Bestia Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427882&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4986c4b6-b81e-4f8d-97b1-f7aff5b46f04\', \'multiverseId\': 427882}, \'multiverseid\': 427882}, {\'name\': \'疫病吹き\', \'text\': \'威迫\\n疫病吹きが戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを２個置く。\\nあなたがコントロールする他のゾンビが１体死亡するたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'クリーチャー — ゾンビ・ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428151&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d12aced-152a-45a0-9f36-cfb7008a73ce\', \'multiverseId\': 428151}, \'multiverseid\': 428151}, {\'name\': \'역병 발산자\', \'text\': \'호전적\\n역병 발산자가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 두 개를 올려놓는다.\\n당신이 조종하는 다른 좀비 생물이 죽을 때마다, 각 상대는 생명 1점을 잃는다.\', \'type\': \'생물 — 좀비 야수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428420&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f36f8c9a-eae4-4166-ae7c-72afaa6dcd42\', \'multiverseId\': 428420}, \'multiverseid\': 428420}, {\'name\': \'Vomitador de Peste\', \'text\': \'Ameaçar\\nQuando Vomitador de Peste entrar no campo de batalha, coloque dois marcadores -1/-1 na criatura alvo que você controla.\\nToda vez que outro Zumbi que você controla morre, cada oponente perde 1 ponto de vida.\', \'type\': \'Criatura — Zumbi Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428689&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1665d75-6e19-4838-a9e1-968dc73fff7c\', \'multiverseId\': 428689}, \'multiverseid\': 428689}, {\'name\': \'Моровый Изрыгатель\', \'text\': \'Угроза\\nКогда Моровый Изрыгатель выходит на поле битвы, положите два жетона -1/-1 на целевое существо под вашим контролем.\\nКаждый раз, когда другой Зомби под вашим контролем умирает, каждый оппонент теряет 1 жизнь.\', \'type\': \'Существо — Зомби Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428958&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88fbd4f3-c90d-4717-9073-a696899c877f\', \'multiverseId\': 428958}, \'multiverseid\': 428958}, {\'name\': \'疫病喷发兽\', \'text\': \'威慑\\n当疫病喷发兽进战场时，在目标由你操控的生物上放置两个-1/-1指示物。\\n每当另一个由你操控的灵俑死去时，每位对手各失去1点生命。\', \'type\': \'生物～灵俑／野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429227&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61156731-0211-4938-946c-81a7149ff3d8\', \'multiverseId\': 429227}, \'multiverseid\': 429227}, {\'name\': \'疫病噴發獸\', \'text\': \'威懾\\n當疫病噴發獸進戰場時，在目標由你操控的生物上放置兩個-1/-1指示物。\\n每當另一個由你操控的殭屍死去時，每位對手各失去1點生命。\', \'type\': \'生物～殭屍／野獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429496&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'505dc68e-264d-424f-804b-f2b9d915b57e\', \'multiverseId\': 429496}, \'multiverseid\': 429496}]', '[{\'name\': \'Pfadbringer-Geweihter\', \'text\': \'{T}: Eine Kreatur deiner Wahl mit Stärke 2 oder weniger kann in diesem Zug nicht geblockt werden.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Der normale Weg durch die Prüfungen ist mir viel zu anstrengend."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427117&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'226b8af0-cb9a-45ac-a378-6e5b75afe334\', \'multiverseId\': 427117}, \'multiverseid\': 427117}, {\'name\': \'Iniciada abresendas\', \'text\': \'{T}: La criatura objetivo con fuerza de 2 o menos no puede ser bloqueada este turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"El camino que se supone que hay que seguir para superar la prueba es demasiado tedioso".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427386&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5696970a-ec71-4a4d-91d9-5a6770d7d194\', \'multiverseId\': 427386}, \'multiverseid\': 427386}, {\'name\': \'Adepte ouvrevoie\', \'text\': \'{T} : La créature ciblée de force inférieure ou égale à 2 ne peut pas être bloquée ce tour-ci.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« Le chemin prévu pour traverser les épreuves est bien trop pénible. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427655&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d164a4d-61c3-4807-ba6d-d4bd96ea8b1c\', \'multiverseId\': 427655}, \'multiverseid\': 427655}, {\'name\': \'Iniziata Aprivarchi\', \'text\': \'{T}: Una creatura bersaglio con forza pari o inferiore a 2 non può essere bloccata in questo turno.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Il percorso previsto per affrontare l\\\'ordalia è decisamente monotono."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427924&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fa274c1-63b5-46f9-983e-a97c11a6a530\', \'multiverseId\': 427924}, \'multiverseid\': 427924}, {\'name\': \'道拓きの修練者\', \'text\': \'{T}：パワーが２以下のクリーチャー１体を対象とする。このターン、それはブロックされない。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「予定通りの試練の道など退屈で仕方ない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428193&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c0d07b5-2cbc-45fa-be34-71f7080b91e5\', \'multiverseId\': 428193}, \'multiverseid\': 428193}, {\'name\': \'경로창조자 입회자\', \'text\': \'{T}: 공격력이 2 이하인 생물을 목표로 정한다. 이번 턴에 그 생물은 방어될 수 없다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"시험 통과를 위해 예측된 길은 너무나 지루하다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428462&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b8dfc70e-a84d-4da6-877d-2e22934918f9\', \'multiverseId\': 428462}, \'multiverseid\': 428462}, {\'name\': \'Iniciada Abre-estrada\', \'text\': \'{T}: A criatura alvo com poder igual ou inferior a 2 não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"O caminho previsível para superar a prova é tedioso demais."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428731&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2111e49f-e071-4879-b7e8-ce99670b5209\', \'multiverseId\': 428731}, \'multiverseid\': 428731}, {\'name\': \'Прокладывающая Путь Послушница\', \'text\': \'{T}: целевое существо с силой 2 или меньше не может быть заблокировано в этом ходу.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Обычный путь через испытания слишком уж утомителен».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429000&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fad021ac-5603-4a32-b09a-2da4559b5234\', \'multiverseId\': 429000}, \'multiverseid\': 429000}, {\'name\': \'开路祀徒\', \'text\': \'{T}：目标力量等于或小于2的生物本回合不能被阻挡。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「闯通祀炼的寻常道路太过无趣。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429269&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71dfe062-a538-4a8e-a8d3-5fe7204d66a3\', \'multiverseId\': 429269}, \'multiverseid\': 429269}, {\'name\': \'開路祀徒\', \'text\': \'{T}：目標力量等於或小於2的生物本回合不能被阻擋。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'「闖通祀煉的尋常道路太過無趣。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429538&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b5abcf06-328d-46a4-83fd-71b8f86f590b\', \'multiverseId\': 429538}, \'multiverseid\': 429538}]', '[{\'name\': \'Pirschender Gepard\', \'text\': \'Aufblitzen\', \'type\': \'Kreatur — Katze\', \'flavor\': "Rhonas\' Monument ist ein Kaleidoskop der Artenvielfalt. Mehr als jeder andere Ort Naktamuns — was die wenigsten Geweihten zu schätzen wissen.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427150&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb62cc09-0a75-4e67-b810-4047d0a5162e\', \'multiverseId\': 427150}, \'multiverseid\': 427150}, {\'name\': \'Guepardo al acecho\', \'text\': \'Destello.\', \'type\': \'Criatura — Felino\', \'flavor\': \'El Monumento a Rhonas alberga la mayor variedad de criaturas de toda la ciudad de Naktamun, una característica que la mayoría de iniciados no sabe apreciar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427419&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0616536b-6c63-42d3-950b-3c24baad694b\', \'multiverseId\': 427419}, \'multiverseid\': 427419}, {\'name\': \'Guépard bondissant\', \'text\': \'Flash\', \'type\': \'Créature : chat\', \'flavor\': "Le Monument de Rhonas abrite une diversité de créatures bien plus importante qu\'ailleurs dans la ville de Naktamon, ce que peu d\'adeptes apprécient à sa juste valeur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427688&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04258204-fecb-4fc9-a0a5-2cc30f99fb8c\', \'multiverseId\': 427688}, \'multiverseid\': 427688}, {\'name\': \'Ghepardo Scattante\', \'text\': \'Lampo\', \'type\': \'Creatura — Felino\', \'flavor\': \'Il monumento a Rhonas ospita una grande varietà di creature, più di qualsiasi altro luogo della città di Naktamun: un pregio che ben pochi iniziati riescono ad apprezzare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427957&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'633c3189-cafd-47fc-8d3b-e1fd3f7c76f2\', \'multiverseId\': 427957}, \'multiverseid\': 427957}, {\'name\': \'飛びかかるチーター\', \'text\': \'瞬速\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'ロナスの碑は、ナクタムンの街中で一番の多様な生物の棲家となっている。修練者には迷惑だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428226&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da8c2467-d169-432d-8fe8-0bae8f16f0e6\', \'multiverseId\': 428226}, \'multiverseid\': 428226}, {\'name\': \'달려드는 태세의 치타\', \'text\': \'섬광\', \'type\': \'생물 — 고양이\', \'flavor\': \'로나스 기념비에는 나크타문에서 가장 다양한 종류의 생물이 살고 있다. 대부분의 입회자들은 이걸 눈여겨보지 못한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428495&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'92907880-37f3-4b1a-9956-45c4e9a73d99\', \'multiverseId\': 428495}, \'multiverseid\': 428495}, {\'name\': \'Guepardo Saltador\', \'text\': \'Lampejo\', \'type\': \'Criatura — Felino\', \'flavor\': \'O monumento de Rhonas abriga uma variedade de criaturas maior que qualquer outro lugar na cidade de Nactamon —uma característica que a maioria dos iniciados não sabe apreciar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428764&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6674eb2-e267-461f-a3dd-e584f3fbe268\', \'multiverseId\': 428764}, \'multiverseid\': 428764}, {\'name\': \'Бросающийся Гепард\', \'text\': \'Миг\', \'type\': \'Существо — Кошка\', \'flavor\': \'В монументе Ронаса проживает больше разных существ, чем где бы то ни было в Нактамуне, но большинство послушников не способны оценить это по достоинству.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429033&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2bb825e-c630-400f-b347-e20a9660fc1b\', \'multiverseId\': 429033}, \'multiverseid\': 429033}, {\'name\': \'扑击捷豹\', \'text\': \'闪现\', \'type\': \'生物～猫\', \'flavor\': \'在罗纳斯纪念碑内栖息的生物种类，远比拿塔蒙城内其他地方要多～这一点许多祀徒都欣赏不来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429302&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5793feb-c033-4dd0-83d1-696e1cff6a8c\', \'multiverseId\': 429302}, \'multiverseid\': 429302}, {\'name\': \'撲擊捷豹\', \'text\': \'閃現\', \'type\': \'生物～貓\', \'flavor\': \'在羅納斯紀念碑內棲息的生物種類，遠比拿塔蒙城內其他地方要多～這一點許多祀徒都欣賞不來。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429571&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7d5257f0-b231-4bac-a052-ed16f7682507\', \'multiverseId\': 429571}, \'multiverseid\': 429571}]', '[{\'name\': \'Plänklerin der Tah-Saat\', \'text\': \'Einbalsamieren {3}{U} ({3}{U}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Naga-Krieger ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Naga, Krieger\', \'flavor\': \'Jeder Geweihte lebt und trainiert mit seiner Saat, mit der er später die Prüfungen ablegt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427043&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26be321d-88d8-44ab-9d2b-b335da6d3d54\', \'multiverseId\': 427043}, \'multiverseid\': 427043}, {\'name\': \'Escaramuzadora de la simiente Tah\', \'text\': \'Embalsamar {3}{U}. ({3}{U}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Guerrero Naga Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Guerrero naga\', \'flavor\': \'Los iniciados viven y entrenan con su simiente, la unidad que comienza unida las pruebas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427312&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'045f4bf9-e78e-4e1e-b672-4dba95f3aaf2\', \'multiverseId\': 427312}, \'multiverseid\': 427312}, {\'name\': \'Assaillante de la moisson Tah\', \'text\': "Embaumement {3}{U} ({3}{U}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et naga et guerrier blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : naga et guerrier\', \'flavor\': "Les adeptes vivent et s\'entraînent avec leur moisson et commencent les épreuves en groupe.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427581&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e54f077-77a3-44c1-9c28-870be3b30d80\', \'multiverseId\': 427581}, \'multiverseid\': 427581}, {\'name\': \'Esploratrice della Messe Tah\', \'text\': \'Imbalsamare {3}{U} ({3}{U}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Guerriero Naga Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Guerriero Naga\', \'flavor\': "Gli iniziati vivono e si addestrano con la loro messe, l\'unità con cui cominciano ad affrontare le ordalie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427850&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03951e5c-4513-406b-9b7f-9aa2318b00a9\', \'multiverseId\': 427850}, \'multiverseid\': 427850}, {\'name\': \'ター一門の散兵\', \'text\': \'不朽{3}{U}（{3}{U}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・ナーガ・戦士であることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — ナーガ・戦士\', \'flavor\': \'修練者は一門で生活し訓練する。それが試練を共に始める仲間なのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428119&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d34e17b-65f4-420a-bda4-6458d666e6b7\', \'multiverseId\': 428119}, \'multiverseid\': 428119}, {\'name\': \'타 입문자 척후병\', \'text\': \'방부처리 {3}{U} ({3}{U}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 나가 전사다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 나가 전사\', \'flavor\': \'입회자들은 함께 시험을 시작하는 입문자와 같이 생활하고 수련한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428388&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a1575d01-d9fa-4bba-8469-4267b1d96133\', \'multiverseId\': 428388}, \'multiverseid\': 428388}, {\'name\': \'Escaramuçadora da Safra Tah\', \'text\': \'Embalsamar {3}{U} ({3}{U}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Naga Guerreiro branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Naga Guerreiro\', \'flavor\': \'Os iniciados vivem e treinam com sua safra, a unidade com a qual iniciam as provas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428657&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ba99e64-5f41-4d18-abef-ab7c5c655121\', \'multiverseId\': 428657}, \'multiverseid\': 428657}, {\'name\': \'Боец Снопа Тах\', \'text\': \'Бальзамирование {3}{U} ({3}{U}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Нагой Воином без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Нага Воин\', \'flavor\': \'Послушники живут и упражняются вместе со своим снопом — группой, начавшей испытания вместе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428926&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dbd091f8-3a16-40d2-a8ab-a603cb245540\', \'multiverseId\': 428926}, \'multiverseid\': 428926}, {\'name\': \'塔哈祀群侦卫\', \'text\': \'遗存{3}{U}（{3}{U}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／那伽／战士，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～那伽／战士\', \'flavor\': \'一同踏上祀炼征途的人组成祀群，祀徒会跟自己的祀群一起生活、训练。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429195&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'91de1103-d2cc-4f64-90b2-76f290e6bb27\', \'multiverseId\': 429195}, \'multiverseid\': 429195}, {\'name\': \'塔哈祀群偵衛\', \'text\': \'遺存{3}{U}（{3}{U}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／那伽／戰士，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～那伽／戰士\', \'flavor\': \'一同踏上祀煉征途的人組成祀群，祀徒會跟自己的祀群一起生活、訓練。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429464&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82aa1002-e9c4-4884-bc2f-f4203bf88c50\', \'multiverseId\': 429464}, \'multiverseid\': 429464}]', '[{\'name\': \'Pollennebel\', \'text\': \'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Kaum jemand hat einem Angriff von solch aggressiver Gelassenheit etwas entgegenzusetzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427142&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'689f19b4-d763-4dba-a6b5-c761e7dbe63e\', \'multiverseId\': 427142}, \'multiverseid\': 427142}, {\'name\': \'Bruma de polen\', \'text\': \'Prevén todo el daño de combate que se fuera a hacer este turno.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'Pocos pueden superar el asalto de una serenidad tan agresiva.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427411&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ea278e61-124e-426b-8075-77952d477ec1\', \'multiverseId\': 427411}, \'multiverseid\': 427411}, {\'name\': \'Brume de pollen\', \'text\': \'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Éphémère\', \'flavor\': \'Rares sont ceux capables de contrer une sérénité aussi agressive.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427680&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4cb7e9a6-69ca-4332-912f-499277968f22\', \'multiverseId\': 427680}, \'multiverseid\': 427680}, {\'name\': \'Foschia di Polline\', \'text\': \'Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': "In pochi riescono a contrastare l\'assalto di una serenità così aggressiva.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427949&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bbc2ac54-1030-451d-9fb4-abf8e10daeae\', \'multiverseId\': 427949}, \'multiverseid\': 427949}, {\'name\': \'花粉のもや\', \'text\': \'このターンに与えられる戦闘ダメージをすべて軽減する。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'このような攻撃的な平穏に耐えられる者は極めて少ない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428218&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'943eeb0b-9e24-4531-8458-d49575fd1932\', \'multiverseId\': 428218}, \'multiverseid\': 428218}, {\'name\': \'꽃가루 안개\', \'text\': \'이 턴에 입혀지려 하는 모든 전투피해를 방지한다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'그러한 치명적 평온함의 공격을 이겨낼 수 있는 자는 거의 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428487&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d3439179-dfda-4414-888d-4c9689c58872\', \'multiverseId\': 428487}, \'multiverseid\': 428487}, {\'name\': \'Bruma de Pólen\', \'text\': \'Previna todo o dano de combate que seria causado neste turno.\\nReciclar {3} ({3}, Descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Poucos conseguem resistir ao assalto de tão agressiva serenidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428756&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'20597af4-19ad-4770-ad68-3ad701771a51\', \'multiverseId\': 428756}, \'multiverseid\': 428756}, {\'name\': \'Дымка из Пыльцы\', \'text\': \'Предотвратите все боевые повреждения, которые должны быть нанесены в этом ходу.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Немногие способны устоять перед таким беспощадным натиском спокойствия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429025&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cae0e8f0-4669-45e4-8487-1ac94f339c44\', \'multiverseId\': 429025}, \'multiverseid\': 429025}, {\'name\': \'花粉迷雾\', \'text\': \'于本回合中，防止将造成的所有战斗伤害。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'安详如此袭来，几乎没人挡得住。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429294&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1d239411-5acf-4b53-9211-e2fbb14321df\', \'multiverseId\': 429294}, \'multiverseid\': 429294}, {\'name\': \'花粉迷霧\', \'text\': \'於本回合中，防止將造成的所有戰鬥傷害。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'安詳如此襲來，幾乎沒人擋得住。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429563&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2e9e3b7d-b255-425d-a755-7d4a36c34c61\', \'multiverseId\': 429563}, \'multiverseid\': 429563}]', '[{\'name\': \'Prozession der Gesalbten\', \'text\': \'Falls ein Effekt einen oder mehrere Spielsteine unter deiner Kontrolle erzeugen würde, erzeugt er stattdessen doppelt so viele Spielsteine.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Götter mögen unter den Sterblichen wandeln, aber sie interessieren sich nicht im Geringsten für sie." —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426973&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f77eee2b-6b37-4c9f-808e-38286c7a3d15\', \'multiverseId\': 426973}, \'multiverseid\': 426973}, {\'name\': \'Procesión de ungidos\', \'text\': \'Si un efecto fuera a crear una o más fichas bajo tu control, en vez de eso, crea el doble de esas fichas.\', \'type\': \'Encantamiento\', \'flavor\': \'"Puede que aquí los dioses caminen entre el pueblo, pero no están con él". —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427242&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4e0388c-baae-47a0-afce-e50ed8582e2f\', \'multiverseId\': 427242}, \'multiverseid\': 427242}, {\'name\': \'Procession consécratrice\', \'text\': \'Si un effet devait créer au moins un jeton sous votre contrôle, il crée deux fois ce nombre de jetons à la place.\', \'type\': \'Enchantement\', \'flavor\': "« Si ici les dieux évoluent parmi le peuple, ils ne s\'y mêlent cependant pas. » —Gideon Jura", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427511&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'078e7a3f-ec9d-4240-b09d-2d8ba6e1e65a\', \'multiverseId\': 427511}, \'multiverseid\': 427511}, {\'name\': \'Processione dei Consacrati\', \'text\': \'Se un effetto sta per creare una o più pedine sotto il tuo controllo, crea invece il doppio di quelle pedine.\', \'type\': \'Incantesimo\', \'flavor\': \'"Qui le divinità camminano tra i mortali, ma non si confondono con loro." —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427780&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cbf0f77-9bf5-4d2d-b9ed-4fc7d2f3fbbd\', \'multiverseId\': 427780}, \'multiverseid\': 427780}, {\'name\': \'選定された行進\', \'text\': \'効果によりあなたのコントロール下でトークンが１つ以上生成されるなら、代わりにその効果はそれらのトークンをその２倍の数生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「この地の神々は人々の間を歩き回るが、人々と共にあるわけではない。」 ――ギデオン・ジュラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428049&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38251adc-f8e9-44e4-a28f-95a5b1aa8c2f\', \'multiverseId\': 428049}, \'multiverseid\': 428049}, {\'name\': \'세례받은 자의 행렬\', \'text\': \'어떤 효과가 한 개 이상의 토큰을 당신의 조종하에 만들려고 한다면, 그 대신에 그 효과는 그 숫자의 두 배만큼의 토큰을 만든다.\', \'type\': \'부여마법\', \'flavor\': \'"이곳의 신들은 사람들 사이를 거닐 수 있지만 그들과 함께 하지는 않는다." —기디온 주라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428318&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d485d4a8-2dd5-4758-968c-f3dda5c9d218\', \'multiverseId\': 428318}, \'multiverseid\': 428318}, {\'name\': \'Procissão dos Ungidos\', \'text\': \'Se um efeito criaria uma ou mais fichas sob seu controle, em vez disso ele cria o dobro dessas fichas.\', \'type\': \'Encantamento\', \'flavor\': \'"Os deuses daqui podem caminhar em meio ao povo, mas não estão com ele." — Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428587&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5ec1de7-b935-486b-b8c3-036611983127\', \'multiverseId\': 428587}, \'multiverseid\': 428587}, {\'name\': \'Умащенная Процессия\', \'text\': \'Если эффект должен создать одну или более фишек под вашим контролем, вместо этого он создает в два раза больше таких фишек.\', \'type\': \'Чары\', \'flavor\': \'«Боги здесь ходят среди людей, но они — не с ними». — Гидеон Джура\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428856&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b65b2fe2-bff6-44c3-a3d0-43d64d914d30\', \'multiverseId\': 428856}, \'multiverseid\': 428856}, {\'name\': \'圣洗者行列\', \'text\': \'如果某效应将在你的操控下派出一个或数个衍生物，则改为它派出两倍数量的该类衍生物。\', \'type\': \'结界\', \'flavor\': \'「此地神明与民同在，但并不与民同心。」 ～基定尤拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429125&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'27c8cd1c-dd16-40ef-8362-b5f16760ff93\', \'multiverseId\': 429125}, \'multiverseid\': 429125}, {\'name\': \'聖洗者行列\', \'text\': \'如果某效應將在你的操控下派出一個或數個衍生物，則改為它派出兩倍數量的該類衍生物。\', \'type\': \'結界\', \'flavor\': \'「此地神明與民同在，但並不與民同心。」 ～基定尤拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429394&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'42e14a3e-25ff-476d-bb45-1ee3ef92068a\', \'multiverseId\': 429394}, \'multiverseid\': 429394}]', '[{\'name\': \'Prüfung der Stärke\', \'text\': \'Wenn die Prüfung der Stärke ins Spiel kommt, erzeuge einen 4/2 grünen Bestie-Kreaturenspielstein.\\nWenn eine Kartusche unter deiner Kontrolle ins Spiel kommt, bringe die Prüfung der Stärke auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': \'„Initiative durch Instinkt, Sieg durch Stärke."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427162&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b186548e-b177-4ae2-a1d8-0ff6d43729df\', \'multiverseId\': 427162}, \'multiverseid\': 427162}, {\'name\': \'Prueba de fuerza\', \'text\': \'Cuando la Prueba de fuerza entre al campo de batalla, crea una ficha de criatura Bestia verde 4/2.\\nCuando un Cartucho entre al campo de batalla bajo tu control, regresa la Prueba de fuerza a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': \'"Instintos para guiar. Fuerza para vencer".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427431&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ccfb86b4-fa69-4f62-a330-5e4475e1e5fb\', \'multiverseId\': 427431}, \'multiverseid\': 427431}, {\'name\': \'Épreuve de force\', \'text\': "Quand l\'Épreuve de force arrive sur le champ de bataille, créez un jeton de créature 4/2 verte Bête.\\nQuand un cartouche arrive sur le champ de bataille sous votre contrôle, renvoyez l\'Épreuve de force dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': "« L\'instinct pour vous guider. Et la force pour triompher. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427700&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'707f5fe8-dc96-47df-bef0-adf74e9bedb4\', \'multiverseId\': 427700}, \'multiverseid\': 427700}, {\'name\': \'Ordalia della Forza\', \'text\': "Quando l\'Ordalia della Forza entra nel campo di battaglia, crea una pedina creatura Bestia 4/2 verde.\\nQuando un Cartiglio entra nel campo di battaglia sotto il tuo controllo, fai tornare l\'Ordalia della Forza in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': \'"L\\\'istinto per guidarvi, la forza per trionfare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427969&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61c7436e-7c97-4c65-ab5e-6ec9b3e9f4f5\', \'multiverseId\': 427969}, \'multiverseid\': 427969}, {\'name\': \'活力の試練\', \'text\': \'活力の試練が戦場に出たとき、緑の４/２のビースト・クリーチャー・トークンを１体生成する。\\nカルトーシュが１つあなたのコントロール下で戦場に出たとき、活力の試練をオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': \'「直感に従い、活力で越えよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428238&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c70dd660-575e-4af3-85c6-b2df90f67872\', \'multiverseId\': 428238}, \'multiverseid\': 428238}, {\'name\': \'힘의 시험\', \'text\': \'힘의 시험이 전장에 들어올 때, 4/2 녹색 야수 생물 토큰 한 개를 만든다.\\n카르투슈가 당신의 조종하에 전장에 들어올 때, 힘의 시험을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': \'"본능에 따르고, 힘을 극복하라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428507&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c35ca24b-1b70-4186-9950-56baaafb69dd\', \'multiverseId\': 428507}, \'multiverseid\': 428507}, {\'name\': \'Prova da Força\', \'text\': \'Quando Prova da Força entrar no campo de batalha, crie uma ficha de criatura verde 4/2 do tipo Besta.\\nQuando uma Cártula entrar no campo de batalha sob seu controle, devolva Prova da Força para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': \'"Instintos para guiar. Força para superar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428776&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1263d07b-3315-4d6d-9964-04590f053496\', \'multiverseId\': 428776}, \'multiverseid\': 428776}, {\'name\': \'Испытание Силы\', \'text\': \'Когда Испытание Силы выходит на поле битвы, создайте одну фишку существа 4/2 зеленый Зверь.\\nКогда Картуш выходит на поле битвы под вашим контролем, верните Испытание Силы в руку владельца.\', \'type\': \'Чары\', \'flavor\': \'«Инстинкты — чтобы вести. Сила — чтобы преодолеть».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429045&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4f124b4a-2735-4ced-a66a-afbc1001d074\', \'multiverseId\': 429045}, \'multiverseid\': 429045}, {\'name\': \'力量祀炼\', \'text\': \'当力量祀炼进战场时，派出一个4/2绿色野兽衍生生物。\\n当一个魔符在你的操控下进战场时，将力量祀炼移回其拥有者的手上。\', \'type\': \'结界\', \'flavor\': \'「从以本能；克以膂力。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429314&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d7d749f-9d88-412f-ab9f-6e6511b7e2fb\', \'multiverseId\': 429314}, \'multiverseid\': 429314}, {\'name\': \'力量祀煉\', \'text\': \'當力量祀煉進戰場時，派出一個4/2綠色野獸衍生生物。\\n當一個魔符在你的操控下進戰場時，將力量祀煉移回其擁有者的手上。\', \'type\': \'結界\', \'flavor\': \'「從以本能；克以膂力。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429583&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8e996858-6edf-439c-944e-a60c49d907b8\', \'multiverseId\': 429583}, \'multiverseid\': 429583}]', '[{\'name\': \'Prüfung des Ehrgeizes\', \'text\': \'Wenn die Prüfung des Ehrgeizes ins Spiel kommt, opfert ein Gegner deiner Wahl eine Kreatur.\\nWenn eine Kartusche unter deiner Kontrolle ins Spiel kommt, bringe die Prüfung des Ehrgeizes auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427084&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f27b02a8-1fd3-47b6-ae31-cc863cae4feb\', \'multiverseId\': 427084}, \'multiverseid\': 427084}, {\'name\': \'Prueba de ambición\', \'text\': \'Cuando la Prueba de ambición entre al campo de batalla, el oponente objetivo sacrifica una criatura.\\nCuando un Cartucho entre al campo de batalla bajo tu control, regresa la Prueba de ambición a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427353&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dffe3743-70b6-44aa-b498-1620ed503d8a\', \'multiverseId\': 427353}, \'multiverseid\': 427353}, {\'name\': "Épreuve d\'ambition", \'text\': "Quand l\'Épreuve d\'ambition arrive sur le champ de bataille, l\'adversaire ciblé sacrifie une créature.\\nQuand un cartouche arrive sur le champ de bataille sous votre contrôle, renvoyez l\'Épreuve d\'ambition dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427622&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2569d9f3-ef0b-4108-a906-4cdce80166cd\', \'multiverseId\': 427622}, \'multiverseid\': 427622}, {\'name\': "Ordalia dell\'Ambizione", \'text\': "Quando l\'Ordalia dell\'Ambizione entra nel campo di battaglia, un avversario bersaglio sacrifica una creatura.\\nQuando un Cartiglio entra nel campo di battaglia sotto il tuo controllo, fai tornare l\'Ordalia dell\'Ambizione in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427891&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3785ad1a-3497-4c4b-955e-762b94054914\', \'multiverseId\': 427891}, \'multiverseid\': 427891}, {\'name\': \'野望の試練\', \'text\': \'野望の試練が戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーはクリーチャー１体を生け贄に捧げる。\\nカルトーシュが１つあなたのコントロール下で戦場に出たとき、野望の試練をオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428160&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10cc2f04-02eb-400d-8249-938df50c130d\', \'multiverseId\': 428160}, \'multiverseid\': 428160}, {\'name\': \'야망의 시험\', \'text\': \'야망의 시험이 전장에 들어올 때, 상대를 목표로 정한다. 그 상대는 생물 한 개를 희생한다.\\n카르투슈가 당신의 조종하에 전장에 들어올 때, 야망의 시험을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428429&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b660e0f7-682c-4f8c-93d5-eb6e4e41ef87\', \'multiverseId\': 428429}, \'multiverseid\': 428429}, {\'name\': \'Prova da Ambição\', \'text\': \'Quando Prova da Ambição entra no campo de batalha, o oponente alvo sacrifica uma criatura.\\nQuando uma Cártula entrar no campo de batalha sob seu controle, devolva Prova da Ambição para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428698&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4273cfd4-f1bb-4706-bd0e-0431ea135cfa\', \'multiverseId\': 428698}, \'multiverseid\': 428698}, {\'name\': \'Испытание Устремленности\', \'text\': \'Когда Испытание Устремленности выходит на поле битвы, целевой оппонент жертвует существо.\\nКогда Картуш выходит на поле битвы под вашим контролем, верните Испытание Устремленности в руку владельца.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428967&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'907de8be-c57d-4ac7-94b8-8af350c77b7e\', \'multiverseId\': 428967}, \'multiverseid\': 428967}, {\'name\': \'野心祀炼\', \'text\': \'当野心祀炼进战场时，目标对手牺牲一个生物。\\n当一个魔符在你的操控下进战场时，将野心祀炼移回其拥有者的手上。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429236&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'faea8619-1498-47fb-b6d5-fc553f3862a6\', \'multiverseId\': 429236}, \'multiverseid\': 429236}, {\'name\': \'野心祀煉\', \'text\': \'當野心祀煉進戰場時，目標對手犧牲一個生物。\\n當一個魔符在你的操控下進戰場時，將野心祀煉移回其擁有者的手上。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429505&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5c196669-347c-4464-b947-b37e5bccd181\', \'multiverseId\': 429505}, \'multiverseid\': 429505}]', '[{\'name\': \'Prüfung des Eifers\', \'text\': \'Wenn die Prüfung des Eifers ins Spiel kommt, fügt sie einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu.\\nWenn eine Kartusche unter deiner Kontrolle ins Spiel kommt, bringe die Prüfung des Eifers auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': \'„Mein Kind, ewiger Ruhm erwartet dich."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427123&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54a3c11c-dbbb-4afe-9b93-78883e7f3274\', \'multiverseId\': 427123}, \'multiverseid\': 427123}, {\'name\': \'Prueba de fervor\', \'text\': \'Cuando la Prueba de fervor entre al campo de batalla, hace 3 puntos de daño a la criatura o jugador objetivo.\\nCuando un Cartucho entre al campo de batalla bajo tu control, regresa la Prueba de fervor a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': \'"La gloria eterna te espera, hijo mío".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427392&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'930e2a1a-b458-4421-b29f-699aca300828\', \'multiverseId\': 427392}, \'multiverseid\': 427392}, {\'name\': \'Épreuve de zèle\', \'text\': "Quand l\'Épreuve de zèle arrive sur le champ de bataille, elle inflige 3 blessures à une cible, créature ou joueur.\\nQuand un cartouche arrive sur le champ de bataille sous votre contrôle, renvoyez l\'Épreuve de zèle dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': "« Une gloire éternelle t\'attend, mon enfant. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427661&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'134a2881-b625-403c-bcc9-8449f9779603\', \'multiverseId\': 427661}, \'multiverseid\': 427661}, {\'name\': \'Ordalia dello Zelo\', \'text\': "Quando l\'Ordalia dello Zelo entra nel campo di battaglia, infligge 3 danni a una creatura o a un giocatore bersaglio.\\nQuando un Cartiglio entra nel campo di battaglia sotto il tuo controllo, fai tornare l\'Ordalia dello Zelo in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': \'"La gloria eterna ti attende, figlio mio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427930&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ddfedf6-c325-4020-a8bc-39e2f8e3dec0\', \'multiverseId\': 427930}, \'multiverseid\': 427930}, {\'name\': \'激情の試練\', \'text\': \'激情の試練が戦場に出たとき、クリーチャー１体かプレイヤー１人を対象とする。激情の試練はそれに３点のダメージを与える。\\nカルトーシュが１つあなたのコントロール下で戦場に出たとき、激情の試練をオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': \'「我が子よ、永遠の栄光が汝を待っている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428199&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e97ac63-537c-4dc0-beeb-2b72111405d1\', \'multiverseId\': 428199}, \'multiverseid\': 428199}, {\'name\': \'열성의 시험\', \'text\': \'열성의 시험이 전장에 들어올 때, 생물이나 플레이어를 목표로 정한다. 열성의 시험은 그 목표에 피해 3점을 입힌다.\\n카르투슈가 당신의 조종하에 전장에 들어올 때, 열성의 시험을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': \'"무한한 영광이 너를 기다린다, 나의 자녀야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428468&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bb7978c4-3f32-4901-b3c1-241324e064db\', \'multiverseId\': 428468}, \'multiverseid\': 428468}, {\'name\': \'Prova do Zelo\', \'text\': \'Quando Prova do Zelo entra no campo de batalha, ele causa 3 pontos de dano à criatura ou ao jogador alvo.\\nQuando uma Cártula entrar no campo de batalha sob seu controle, devolva Prova do Zelo para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': \'"A glória eterna o espera, criança."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428737&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c61bf104-bb37-4c9d-abb2-3c3a11481d43\', \'multiverseId\': 428737}, \'multiverseid\': 428737}, {\'name\': \'Испытание Рвения\', \'text\': \'Когда Испытание Рвения выходит на поле битвы, оно наносит 3 повреждения целевому существу или игроку.\\nКогда Картуш выходит на поле битвы под вашим контролем, верните Испытание Рвения в руку владельца.\', \'type\': \'Чары\', \'flavor\': \'«Вечная слава ожидает тебя, дитя».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429006&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a33b662-11b6-4ee9-85a2-ddbfee4b050b\', \'multiverseId\': 429006}, \'multiverseid\': 429006}, {\'name\': \'热忱祀炼\', \'text\': \'当热忱祀炼进战场时，它对目标生物或牌手造成3点伤害。\\n当一个魔符在你的操控下进战场时，将热忱祀炼移回其拥有者的手上。\', \'type\': \'结界\', \'flavor\': \'「永恒的荣耀等待着你，我的孩子。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429275&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cf9780e6-edc9-47ae-9884-59538fc96f72\', \'multiverseId\': 429275}, \'multiverseid\': 429275}, {\'name\': \'熱忱祀煉\', \'text\': \'當熱忱祀煉進戰場時，它對目標生物或玩家造成3點傷害。\\n當一個魔符在你的操控下進戰場時，將熱忱祀煉移回其擁有者的手上。\', \'type\': \'結界\', \'flavor\': \'「永恆的榮耀等待著你，我的孩子。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429544&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82d8e5d6-8c19-4aaa-b909-1f70d1b8664c\', \'multiverseId\': 429544}, \'multiverseid\': 429544}]', '[{\'name\': \'Prüfung des Wissens\', \'text\': \'Wenn die Prüfung des Wissens ins Spiel kommt, ziehe drei Karten und wirf dann eine Karte ab.\\nWenn eine Kartusche unter deiner Kontrolle ins Spiel kommt, bringe die Prüfung des Wissens auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427044&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6bb59f3e-ed43-4166-96aa-7086bde7717e\', \'multiverseId\': 427044}, \'multiverseid\': 427044}, {\'name\': \'Prueba de conocimiento\', \'text\': \'Cuando la Prueba de conocimiento entre al campo de batalla, roba tres cartas, luego descarta una carta.\\nCuando un Cartucho entre al campo de batalla bajo tu control, regresa la Prueba de conocimiento a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427313&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bbcff06f-268b-4463-9622-e1a1a641bdcf\', \'multiverseId\': 427313}, \'multiverseid\': 427313}, {\'name\': \'Épreuve de connaissance\', \'text\': "Quand l\'Épreuve de connaissance arrive sur le champ de bataille, piochez trois cartes, puis défaussez-vous d\'une carte.\\nQuand un cartouche arrive sur le champ de bataille sous votre contrôle, renvoyez l\'Épreuve de connaissance dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427582&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d3d7506-22ee-4942-b82f-41511ecb0c54\', \'multiverseId\': 427582}, \'multiverseid\': 427582}, {\'name\': \'Ordalia della Conoscenza\', \'text\': "Quando l\'Ordalia della Conoscenza entra nel campo di battaglia, pesca tre carte, poi scarta una carta.\\nQuando un Cartiglio entra nel campo di battaglia sotto il tuo controllo, fai tornare l\'Ordalia della Conoscenza in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427851&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0b11b9e-e4da-46e9-a9b0-ab52202ab676\', \'multiverseId\': 427851}, \'multiverseid\': 427851}, {\'name\': \'知識の試練\', \'text\': \'知識の試練が戦場に出たとき、カードを３枚引き、その後カード１枚を捨てる。\\nカルトーシュが１つあなたのコントロール下で戦場に出たとき、知識の試練をオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428120&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2dddbcae-0bc6-42c0-a5ab-b40a300143fa\', \'multiverseId\': 428120}, \'multiverseid\': 428120}, {\'name\': \'지식의 시험\', \'text\': \'지식의 시험이 전장에 들어올 때, 카드 세 장을 뽑은 후 카드 한 장을 버린다.\\n카르투슈가 당신의 조종하에 전장에 들어올 때, 지식의 시험을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428389&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6ed18ed3-ed33-46fe-ab72-f8cd02314a87\', \'multiverseId\': 428389}, \'multiverseid\': 428389}, {\'name\': \'Prova do Conhecimento\', \'text\': \'Quando Prova do Conhecimento entrar no campo de batalha, compre três cards e, depois, descarte um card.\\nQuando uma Cártula entrar no campo de batalha sob seu controle, devolva Prova do Conhecimento para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428658&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24b805a6-6f29-4af1-9e5e-66a404713a57\', \'multiverseId\': 428658}, \'multiverseid\': 428658}, {\'name\': \'Испытание Знания\', \'text\': \'Когда Испытание Знания выходит на поле битвы, возьмите три карты, затем сбросьте карту.\\nКогда Картуш выходит на поле битвы под вашим контролем, верните Испытание Знания в руку владельца.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428927&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4773f272-8c7e-4a7d-bef6-448865fca5fe\', \'multiverseId\': 428927}, \'multiverseid\': 428927}, {\'name\': \'知识祀炼\', \'text\': \'当知识祀炼进战场时，抓三张牌，然后弃一张牌。\\n当一个魔符在你的操控下进战场时，将知识祀炼移回其拥有者的手上。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429196&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e7e2ffc-62c9-4273-8fe3-d654ffc3ab63\', \'multiverseId\': 429196}, \'multiverseid\': 429196}, {\'name\': \'知識祀煉\', \'text\': \'當知識祀煉進戰場時，抽三張牌，然後棄一張牌。\\n當一個魔符在你的操控下進戰場時，將知識祀煉移回其擁有者的手上。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429465&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'796e1af4-cf5f-4259-95b5-576da68bfe79\', \'multiverseId\': 429465}, \'multiverseid\': 429465}]', '[{\'name\': \'Prüfung des Zusammenhalts\', \'text\': \'Wenn die Prüfung des Zusammenhalts ins Spiel kommt, erhalten Kreaturen, die du kontrollierst, +2/+1 und Wachsamkeit bis zum Ende des Zuges.\\nWenn eine Kartusche unter deiner Kontrolle ins Spiel kommt, bringe die Prüfung des Zusammenhalts auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': \'„Zusammen triumphieren oder alleine scheitern — die Wahl liegt bei euch."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427005&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8539b85-bd15-4829-8a8e-7fd5f60d6bbd\', \'multiverseId\': 427005}, \'multiverseid\': 427005}, {\'name\': \'Prueba de solidaridad\', \'text\': \'Cuando la Prueba de solidaridad entre al campo de batalla, las criaturas que controlas obtienen +2/+1 y ganan la habilidad de vigilancia hasta el final del turno.\\nCuando un Cartucho entre al campo de batalla bajo tu control, regresa la Prueba de solidaridad a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': \'"Triunfarán como un solo ser, o fracasarán como colectivo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427274&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86040064-39df-43d0-956c-29277229f41b\', \'multiverseId\': 427274}, \'multiverseid\': 427274}, {\'name\': \'Épreuve de solidarité\', \'text\': "Quand l\'Épreuve de solidarité arrive sur le champ de bataille, les créatures que vous contrôlez gagnent +2/+1 et acquièrent la vigilance jusqu\'à la fin du tour.\\nQuand un cartouche arrive sur le champ de bataille sous votre contrôle, renvoyez l\'Épreuve de solidarité dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': "« Vous réussirez comme un seul homme ou échouerez en tant qu\'individus. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427543&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04f94a1d-1232-4014-9691-34501707a1cf\', \'multiverseId\': 427543}, \'multiverseid\': 427543}, {\'name\': \'Ordalia della Fratellanza\', \'text\': "Quando l\'Ordalia della Fratellanza entra nel campo di battaglia, le creature che controlli prendono +2/+1 e hanno cautela fino alla fine del turno.\\nQuando un Cartiglio entra nel campo di battaglia sotto il tuo controllo, fai tornare l\'Ordalia della Fratellanza in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': \'"Trionferete uniti o fallirete da soli."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427812&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd0a5619-2b5f-454d-a618-2183b3b2c1d2\', \'multiverseId\': 427812}, \'multiverseid\': 427812}, {\'name\': \'結束の試練\', \'text\': \'結束の試練が戦場に出たとき、ターン終了時まで、あなたがコントロールするクリーチャーは＋２/＋１の修整を受けるとともに警戒を得る。\\nカルトーシュが１つあなたのコントロール下で戦場に出たとき、結束の試練をオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': \'「団結して成功するか、ばらばらなままで失敗するか。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428081&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c677d98-c7c8-4bc6-9380-db0d72ff5664\', \'multiverseId\': 428081}, \'multiverseid\': 428081}, {\'name\': \'결속의 시험\', \'text\': \'결속의 시험이 전장에 들어올 때, 당신이 조종하는 생물들은 턴종료까지 +2/+1을 받고 경계를 얻는다.\\n카르투슈가 당신의 조종하에 전장에 들어올 때, 결속의 시험을 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': \'"뭉치면 살고 흩어지면 죽는다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428350&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f3c8eae4-83da-46a9-9e99-65aeaf691be1\', \'multiverseId\': 428350}, \'multiverseid\': 428350}, {\'name\': \'Prova da Solidariedade\', \'text\': \'Quando Prova da Solidariedade entra no campo de batalha, as criaturas que você controla recebem +2/+1 e ganham vigilância até o final do turno.\\nQuando uma Cártula entrar no campo de batalha sob seu controle, devolva Prova da Solidariedade para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': \'"Vocês triunfarão unidos ou fracassarão desunidos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428619&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc17349b-c492-429b-b875-71837c4977d8\', \'multiverseId\': 428619}, \'multiverseid\': 428619}, {\'name\': \'Испытание Сплоченности\', \'text\': \'Когда Испытание Сплоченности выходит на поле битвы, существа под вашим контролем получают +2/+1 и Бдительность до конца хода.\\nКогда Картуш выходит на поле битвы под вашим контролем, верните Испытание Сплоченности в руку владельца.\', \'type\': \'Чары\', \'flavor\': \'«Вы победите все вместе или провалитесь поодиночке».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428888&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'63e42e21-9bea-49c3-bf76-ac84e8625717\', \'multiverseId\': 428888}, \'multiverseid\': 428888}, {\'name\': \'团结祀炼\', \'text\': \'当团结祀炼进战场时，直到回合结束，由你操控的生物得+2/+1且获得警戒异能。\\n当一个魔符在你的操控下进战场时，将团结祀炼移回其拥有者的手上。\', \'type\': \'结界\', \'flavor\': \'「团结一心定能成功，各自为战必将失败。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429157&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9869c450-9d21-4504-ad63-6c6e02d19812\', \'multiverseId\': 429157}, \'multiverseid\': 429157}, {\'name\': \'團結祀煉\', \'text\': \'當團結祀煉進戰場時，直到回合結束，由你操控的生物得+2/+1且獲得警戒異能。\\n當一個魔符在你的操控下進戰場時，將團結祀煉移回其擁有者的手上。\', \'type\': \'結界\', \'flavor\': \'「團結一心定能成功，各自為戰必將失敗。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429426&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cce39104-4cbd-4799-a6cc-2d2abd8124c2\', \'multiverseId\': 429426}, \'multiverseid\': 429426}]', '[{\'name\': \'Pyramide des Pantheons\', \'text\': \'{2}, {T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe. Lege eine Ziegelmarke auf die Pyramide des Pantheons.\\n{T}: Erhöhe deinen Manavorrat um drei Mana genau einer beliebigen Farbe. Aktiviere diese Fähigkeit nur, falls sich drei oder mehr Ziegelmarken auf der Pyramide des Pantheons befinden.\', \'type\': \'Artefakt\', \'flavor\': \'Fünf Götter, ein Ziel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427206&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ae9c0dd-8ae4-47d2-9895-e7b7dfc782ba\', \'multiverseId\': 427206}, \'multiverseid\': 427206}, {\'name\': \'Pirámide del panteón\', \'text\': \'{2}, {T}: Agrega un maná de cualquier color a tu reserva de maná. Pon un contador de bloque sobre la Pirámide del panteón.\\n{T}: Agrega tres manás de un color cualquiera a tu reserva de maná. Activa esta habilidad solo si hay tres o más contadores de bloque sobre la Pirámide del panteón.\', \'type\': \'Artefacto\', \'flavor\': \'Cinco dioses, un propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427475&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b322cef-74ac-40bb-a1bd-3d2a74e940df\', \'multiverseId\': 427475}, \'multiverseid\': 427475}, {\'name\': \'Pyramide du panthéon\', \'text\': "{2}, {T} : Ajoutez un mana de la couleur de votre choix à votre réserve. Mettez un marqueur « brique » sur la Pyramide du panthéon.\\n{T} : Ajoutez trois manas d\'une seule couleur de votre choix à votre réserve. N\'activez cette capacité que s\'il y a au moins trois marqueurs « brique » sur la Pyramide du panthéon.", \'type\': \'Artefact\', \'flavor\': "Cinq dieux, une seule raison d\'être.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427744&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7af590ea-de71-40bc-81aa-3751018542bc\', \'multiverseId\': 427744}, \'multiverseid\': 427744}, {\'name\': \'Piramide del Pantheon\', \'text\': \'{2}, {T}: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana. Metti un segnalino mattone sulla Piramide del Pantheon.\\n{T}: Aggiungi tre mana di un qualsiasi colore alla tua riserva di mana. Attiva questa abilità solo se ci sono tre o più segnalini mattone sulla Piramide del Pantheon.\', \'type\': \'Artefatto\', \'flavor\': \'Cinque divinità, un solo scopo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428013&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3da0b83a-6f2f-48c8-97f9-2ef5119c27dd\', \'multiverseId\': 428013}, \'multiverseid\': 428013}, {\'name\': \'神々のピラミッド\', \'text\': \'{2}, {T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。神々のピラミッドの上に石材カウンターを１個置く。\\n{T}：あなたのマナ・プールに、好きな色１色のマナ３点を加える。この能力は、神々のピラミッドの上に石材カウンターが３個以上置かれているときにのみ起動できる。\', \'type\': \'アーティファクト\', \'flavor\': \'５柱の神々。１つの目的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428282&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'923ed440-08d9-4d4d-978e-89b1df169d7c\', \'multiverseId\': 428282}, \'multiverseid\': 428282}, {\'name\': \'신들의 피라미드\', \'text\': \'{2}, {T}: 원하는 색의 마나 한 개를 당신의 마나풀에 담는다. 신들의 피라미드에 벽돌 카운터 한 개를 올려놓는다.\\n{T}: 당신의 마나풀에 원하는 한 가지 색의 마나 세 개를 담는다. 신들의 피라미드에 벽돌 카운터가 세 개 이상 있는 경우에만 이 능력을 활성화할 수 있다.\', \'type\': \'마법물체\', \'flavor\': \'신은 다섯이지만 목적은 하나다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428551&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e0d1b9b7-6e79-49a5-9b75-a45946c7a51a\', \'multiverseId\': 428551}, \'multiverseid\': 428551}, {\'name\': \'Pirâmide do Panteão\', \'text\': \'{2}, {T}: Adicione um mana de qualquer cor à sua reserva de mana. Coloque um marcador de tijolo em Pirâmide do Panteão.\\n{T}: Adicione três manas de qualquer cor à sua reserva de mana. Ative esta habilidade somente se houver três ou mais marcadores de tijolo em Pirâmide do Panteão.\', \'type\': \'Artefato\', \'flavor\': \'Cinco deuses, um propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428820&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95ce7973-26e3-4960-86ef-3c29da0d0d6a\', \'multiverseId\': 428820}, \'multiverseid\': 428820}, {\'name\': \'Пирамида Пантеона\', \'text\': \'{2}, {T}: добавьте одну ману любого цвета в ваше хранилище маны. Положите один жетон кирпича на Пирамиду Пантеона.\\n{T}: добавьте три маны любого одного цвета в ваше хранилище маны. Активируйте эту способность, только если на Пирамиде Пантеона есть не менее трех жетонов кирпича.\', \'type\': \'Артефакт\', \'flavor\': \'Пять богов, одно предназначение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429089&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'31f01477-29e0-4955-b3e6-c4aa907e4979\', \'multiverseId\': 429089}, \'multiverseid\': 429089}, {\'name\': \'五神金字塔\', \'text\': \'{2}，{T}：加一点任意颜色的法术力到你的法术力池中。在五神金字塔上放置一个石砖指示物。\\n{T}：加三点任意颜色的单色法术力到你的法术力池中。只能于五神金字塔上有三个或更多石砖指示物时起动此异能。\', \'type\': \'神器\', \'flavor\': \'五神一心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429358&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c17b7b50-737b-4b1d-8f88-ad336b02ce71\', \'multiverseId\': 429358}, \'multiverseid\': 429358}, {\'name\': \'五神金字塔\', \'text\': \'{2}，{T}：加一點任意顏色的魔法力到你的魔法力池中。在五神金字塔上放置一個石磚指示物。\\n{T}：加三點任意顏色的單色魔法力到你的魔法力池中。只能於五神金字塔上有三個或更多石磚指示物時起動此異能。\', \'type\': \'神器\', \'flavor\': \'五神一心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429627&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3290504f-a20e-4205-b275-fcfc63315d19\', \'multiverseId\': 429627}, \'multiverseid\': 429627}]', "[{'name': 'Quelle // Verstand', 'text': 'Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische dann deine Bibliothek.', 'type': 'Hexerei', 'flavor': None, 'faceName': 'Quelle', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427190&type=card', 'language': 'German', 'identifiers': {'scryfallId': '92d8411a-8cba-483a-a23e-1e53dc6efe6b', 'multiverseId': 427190}, 'multiverseid': 427190}, {'name': 'Surgir // Ideas', 'text': 'Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': None, 'faceName': 'Surgir', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427459&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '19528ec9-0c38-4b5e-8360-6e80ff1f4f9d', 'multiverseId': 427459}, 'multiverseid': 427459}, {'name': 'Source // Savoir', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': None, 'faceName': 'Source', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427728&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b04726d2-6ce4-469a-90e0-1b7ed56a2cda', 'multiverseId': 427728}, 'multiverseid': 427728}, {'name': 'Sorgente // Idee', 'text': 'Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': None, 'faceName': 'Sorgente', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427997&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9c3f5615-7158-4f39-a87b-43867d557bfb', 'multiverseId': 427997}, 'multiverseid': 427997}, {'name': '開拓 // 精神', 'text': 'あなたのライブラリーから基本土地・カード１枚を探し、それをタップ状態で戦場に出し、その後あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': None, 'faceName': '開拓', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428266&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1bbf9fd8-d089-40e9-9b98-e2b72197a535', 'multiverseId': 428266}, 'multiverseid': 428266}, {'name': '샘 // 정신', 'text': '당신의 서고에서 기본 대지 카드를 찾아 그 카드를 전장에 탭된 채로 놓는다. 그 후 당신의 서고를 섞는다.', 'type': '집중마법', 'flavor': None, 'faceName': '샘', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428535&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'cb3f9209-858f-44a1-a7eb-dbcd196c8e00', 'multiverseId': 428535}, 'multiverseid': 428535}, {'name': 'Fonte // Ideias', 'text': 'Procure um card de terreno básico em seu grimório, coloque-o no campo de batalha virado e depois embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': None, 'faceName': 'Fonte', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428804&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b4d35824-4688-41b4-8602-c31e61de2c3d', 'multiverseId': 428804}, 'multiverseid': 428804}, {'name': 'Всплыть // В Воображении', 'text': 'Найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку.', 'type': 'Волшебство', 'flavor': None, 'faceName': 'Всплыть', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429073&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fb621cc3-a76b-40ae-b018-6aac4decc9d7', 'multiverseId': 429073}, 'multiverseid': 429073}, {'name': '涌泉 // 灵思', 'text': '从你的牌库中搜寻一张基本地牌，将之横置放进战场，然后将你的牌库洗牌。', 'type': '法术', 'flavor': None, 'faceName': '涌泉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429342&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '99d2315c-7aac-4a91-a77c-2998b9e6dfb0', 'multiverseId': 429342}, 'multiverseid': 429342}, {'name': '湧泉 // 靈思', 'text': '從你的牌庫中搜尋一張基本地牌，將之橫置放進戰場，然後將你的牌庫洗牌。', 'type': '巫術', 'flavor': None, 'faceName': '湧泉', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429611&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '949ca8cd-10ab-4022-b63a-335701d4f5c6', 'multiverseId': 429611}, 'multiverseid': 429611}]", '[{\'name\': \'Quälende Stimme\', \'text\': \'Wirf als zusätzliche Kosten, um Quälende Stimme zu wirken, eine Karte ab.\\nZiehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Du hast das Jenseits nicht verdient. Du wirst nie die Herrlichkeit des Gott-Pharaos erfahren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427122&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5b3c416f-4197-41af-a047-73da5fdc423c\', \'multiverseId\': 427122}, \'multiverseid\': 427122}, {\'name\': \'Voz del tormento\', \'text\': \'Como coste adicional para lanzar la Voz del tormento, descarta una carta.\\nRoba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"No mereces ir al más allá. Jamás sentirás el abrazo del Dios Faraón".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427391&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8085e67b-7cd1-4962-914b-1bc6c2ca5166\', \'multiverseId\': 427391}, \'multiverseid\': 427391}, {\'name\': \'Voix lancinante\', \'text\': "En tant que coût supplémentaire pour lancer la Voix lancinante, défaussez-vous d\'une carte.\\nPiochez deux cartes.", \'type\': \'Rituel\', \'flavor\': "« Vous ne méritez pas l\'au-delà. Vous ne sentirez jamais l\'étreinte du Dieu-Pharaon. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427660&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ad33f07-3201-4c50-9415-826c0678d18f\', \'multiverseId\': 427660}, \'multiverseid\': 427660}, {\'name\': \'Voce Torturante\', \'text\': \'Come costo addizionale per lanciare la Voce Torturante, scarta una carta.\\nPesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Non meriti l\\\'aldilà. Non potrai mai sentire l\\\'abbraccio del Dio Faraone."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427929&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70633f9e-a658-48d2-aa7d-80988cc919a2\', \'multiverseId\': 427929}, \'multiverseid\': 427929}, {\'name\': \'苦しめる声\', \'text\': \'苦しめる声を唱えるための追加コストとして、カード１枚を捨てる。\\nカードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「お前は来世にふさわしくない。お前は王神の受容を感じないだろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428198&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'940cd006-7095-46f1-bf00-32f6e4430623\', \'multiverseId\': 428198}, \'multiverseid\': 428198}, {\'name\': \'괴롭히는 목소리\', \'text\': \'괴롭히는 목소리를 발동하기 위한 추가비용으로, 카드 한 장을 버린다.\\n카드 두 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"넌 사후 세계로 들어갈 자격이 없어. 넌 절대 신 파라오의 은총을 누리지 못해."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428467&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f08945e-4c75-4c8e-95a6-027a649b5c65\', \'multiverseId\': 428467}, \'multiverseid\': 428467}, {\'name\': \'Voz Atormentadora\', \'text\': \'Como custo adicional para conjurar Voz Atormentadora, descarte um card.\\nCompre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Você não merece a vida após a morte. Você jamais sentirá o abraço do Faraó-Deus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428736&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c581889a-c802-4acc-ac4e-7107868990ac\', \'multiverseId\': 428736}, \'multiverseid\': 428736}, {\'name\': \'Мучающий Голос\', \'text\': \'В качестве дополнительной стоимости разыгрывания Мучающего Голоса сбросьте карту.\\nВозьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Ты не заслуживаешь загробной жизни. Тебе никогда не попасть в объятья Бога-Фараона».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429005&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5bbaa25d-aea9-4dd1-8d3a-6cee5b6d6ac9\', \'multiverseId\': 429005}, \'multiverseid\': 429005}, {\'name\': \'折磨幽声\', \'text\': \'弃一张牌，以作为施放折磨幽声的额外费用。\\n抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「你不配拥有来世。你永远无法感受法老神的恩泽。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429274&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'63524b24-a918-45a3-a553-39d1f85a1944\', \'multiverseId\': 429274}, \'multiverseid\': 429274}, {\'name\': \'折磨幽聲\', \'text\': \'棄一張牌，以作為施放折磨幽聲的額外費用。\\n抽兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「你不配擁有來世。你永遠無法感受法老神的恩澤。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429543&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1c8189c7-97fe-4493-ab1d-8c1baba1e8ae\', \'multiverseId\': 429543}, \'multiverseid\': 429543}]', "[{'name': 'Reduzieren // Geröll', 'text': 'Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {3}.', 'type': 'Spontanzauber', 'flavor': None, 'faceName': 'Reduzieren', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427187&type=card', 'language': 'German', 'identifiers': {'scryfallId': '73dd8f43-5736-478f-92be-b390251e1da0', 'multiverseId': 427187}, 'multiverseid': 427187}, {'name': 'Reducir // Escombros', 'text': 'Contrarresta el hechizo objetivo a menos que su controlador pague {3}.', 'type': 'Instantáneo', 'flavor': None, 'faceName': 'Reducir', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427456&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cd1b8a08-474b-40a1-b5b7-39e353d8bdb3', 'multiverseId': 427456}, 'multiverseid': 427456}, {'name': 'Réduire // Néant', 'text': 'Contrecarrez le sort ciblé à moins que son contrôleur ne paie {3}.', 'type': 'Éphémère', 'flavor': None, 'faceName': 'Réduire', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427725&type=card', 'language': 'French', 'identifiers': {'scryfallId': '17efb72d-4835-4eec-8b3a-fcd9c2d393c6', 'multiverseId': 427725}, 'multiverseid': 427725}, {'name': 'Attenuare // Impatto', 'text': 'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {3}.', 'type': 'Istantaneo', 'flavor': None, 'faceName': 'Attenuare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427994&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '032ed75f-9bb0-454f-8d38-dc821957fa2c', 'multiverseId': 427994}, 'multiverseid': 427994}, {'name': '粉骨 // 砕身', 'text': '呪文１つを対象とする。それのコントローラーが{3}を支払わないかぎり、それを打ち消す。', 'type': 'インスタント', 'flavor': None, 'faceName': '粉骨', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428263&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '32606589-4300-4b26-9def-b2973e09b3a1', 'multiverseId': 428263}, 'multiverseid': 428263}, {'name': '감소 // 폐허', 'text': '주문을 목표로 정한다. 그 주문의 조종자가 {3}을 지불하지 않으면 그 주문을 무효화한다.', 'type': '순간마법', 'flavor': None, 'faceName': '감소', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428532&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c4141b24-9b4a-4b07-9504-7b36c23c51f4', 'multiverseId': 428532}, 'multiverseid': 428532}, {'name': 'Reduzir // Escombros', 'text': 'Anule a mágica alvo, a menos que seu controlador pague {3}.', 'type': 'Mágica Instantânea', 'flavor': None, 'faceName': 'Reduzir', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428801&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fc13a9c2-cf5a-417f-9aa6-1308663b0e2a', 'multiverseId': 428801}, 'multiverseid': 428801}, {'name': 'Растереть // В Пыль', 'text': 'Отмените целевое заклинание, если только контролирующий его игрок не заплатит {3}.', 'type': 'Мгновенное заклинание', 'flavor': None, 'faceName': 'Растереть', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429070&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4161f05c-0200-4982-bd24-c85817a35678', 'multiverseId': 429070}, 'multiverseid': 429070}, {'name': '衰减 // 碎砾', 'text': '除非目标咒语的操控者支付{3}，否则反击之。', 'type': '瞬间', 'flavor': None, 'faceName': '衰减', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429339&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8cf4793e-e841-41e6-9ac5-bdad95aab6f4', 'multiverseId': 429339}, 'multiverseid': 429339}, {'name': '衰減 // 碎礫', 'text': '除非目標咒語的操控者支付{3}，否則反擊之。', 'type': '瞬間', 'flavor': None, 'faceName': '衰減', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429608&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd8b40bbd-ebf2-4b7d-8b11-72433b54a9c1', 'multiverseId': 429608}, 'multiverseid': 429608}]", '[{\'name\': \'Rhonas der Unbezwingbare\', \'text\': \'Todesberührung, Unzerstörbar\\nRhonas der Unbezwingbare kann nicht angreifen, es sei denn, du kontrollierst eine andere Kreatur mit Stärke 4 oder mehr.\\n{2}{G}: Eine andere Kreatur deiner Wahl erhält +2/+0 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Gott\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427153&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'494686e6-3e6b-4247-abab-4ba69e2956df\', \'multiverseId\': 427153}, \'multiverseid\': 427153}, {\'name\': \'Rhonas, el Indómito\', \'text\': \'Toque mortal, indestructible.\\nRhonas, el Indómito no puede atacar ni bloquear a menos que controles otra criatura con fuerza de 4 o más.\\n{2}{G}: Otra criatura objetivo obtiene +2/+0 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura legendaria — Deidad\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427422&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d1e02ab-6bec-42cb-9a7e-b4f2faebaf6d\', \'multiverseId\': 427422}, \'multiverseid\': 427422}, {\'name\': "Rhonas l\'Indomptable", \'text\': "Contact mortel, indestructible\\nRhonas l\'Indomptable ne peut ni attaquer ni bloquer à moins que vous ne contrôliez une autre créature de force supérieure ou égale à 4.\\n{2}{G} : Une autre créature ciblée gagne +2/+0 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : dieu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427691&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e227e35-dc64-4da4-88f8-a4a740dd27cb\', \'multiverseId\': 427691}, \'multiverseid\': 427691}, {\'name\': "Rhonas l\'Indomabile", \'text\': "Tocco letale, indistruttibile\\nRhonas l\'Indomabile non può attaccare o bloccare a meno che tu non controlli un\'altra creatura con forza pari o superiore a 4.\\n{2}{G}: Un\'altra creatura bersaglio prende +2/+0 e ha travolgere fino alla fine del turno.", \'type\': \'Creatura Leggendaria — Dio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427960&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6cafc703-c41e-484f-bbee-81a5f61da736\', \'multiverseId\': 427960}, \'multiverseid\': 427960}, {\'name\': \'不屈の神ロナス\', \'text\': \'接死、破壊不能\\nあなたがパワーが４以上の他のクリーチャーをコントロールしていないかぎり、不屈の神ロナスでは攻撃したりブロックしたりできない。\\n{2}{G}：他のクリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受けるとともにトランプルを得る。\', \'type\': \'伝説のクリーチャー — 神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428229&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d7766cf-9d79-4e43-8de3-5c15f55a31c7\', \'multiverseId\': 428229}, \'multiverseid\': 428229}, {\'name\': \'불굴의 로나스\', \'text\': \'치명타, 무적\\n당신이 공격력이 4 이상인 다른 생물을 조종하지 않는 한, 불굴의 로나스는 공격하거나 방어할 수 없다.\\n{2}{G}: 다른 생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+0을 받고 돌진을 얻는다.\', \'type\': \'전설적 생물 — 신\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428498&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bb7b8e76-55db-4d77-8e28-086894d362d2\', \'multiverseId\': 428498}, \'multiverseid\': 428498}, {\'name\': \'Rhonas, o Indômito\', \'text\': \'Toque mortífero, indestrutível\\nRhonas, o Indômito, não pode atacar nem bloquear a menos que você controle outra criatura com poder igual ou superior a 4.\\n{2}{G}: Outra criatura alvo recebe +2/+0 e ganha atropelar até o final do turno.\', \'type\': \'Criatura Lendária — Deus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428767&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bf496e63-a976-4365-89f0-8cf104a52a30\', \'multiverseId\': 428767}, \'multiverseid\': 428767}, {\'name\': \'Ронас Неукротимый\', \'text\': \'Смертельное касание, Неразрушимость\\nРонас Неукротимый не может атаковать или блокировать, если только вы не контролируете другое существо с силой не менее 4.\\n{2}{G}: другое целевое существо получает +2/+0 и Пробивной удар до конца хода.\', \'type\': \'Легендарное Существо — Бог\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429036&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8a73900c-3fa5-44f0-836d-f6b06ece651b\', \'multiverseId\': 429036}, \'multiverseid\': 429036}, {\'name\': \'无畏神罗纳斯\', \'text\': \'死触，不灭\\n除非你操控另一个力量等于或大于4的生物，否则无畏神罗纳斯不能进行攻击或阻挡。\\n{2}{G}：直到回合结束，另一个目标生物得+2/+0且获得践踏异能。\', \'type\': \'传奇生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429305&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bc5fe256-7cc1-4bee-8fb4-b96877c6b486\', \'multiverseId\': 429305}, \'multiverseid\': 429305}, {\'name\': \'無畏神羅納斯\', \'text\': \'死觸，不滅\\n除非你操控另一個力量等於或大於4的生物，否則無畏神羅納斯不能進行攻擊或阻擋。\\n{2}{G}：直到回合結束，另一個目標生物得+2/+0且獲得踐踏異能。\', \'type\': \'傳奇生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429574&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'19e461ca-f855-4f7b-862d-7a4bb18febf6\', \'multiverseId\': 429574}, \'multiverseid\': 429574}]', '[{\'name\': \'Riesenspinne\', \'text\': \'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Die Splitterwüste ist übersät mit Überbleibseln vergangener Zivilisationen und verseucht mit den Überbringern gegenwärtiger Schrecken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427137&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af034a8d-a2d2-4f97-ade0-17a6fbaa88fc\', \'multiverseId\': 427137}, \'multiverseid\': 427137}, {\'name\': \'Araña gigante\', \'text\': \'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\', \'type\': \'Criatura — Araña\', \'flavor\': \'Las Tierras Desoladas están salpicadas de civilizaciones muertas hace mucho e infestadas de horrores muy vivos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427406&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'774b6125-5768-4bdb-9f10-51df3c4a8100\', \'multiverseId\': 427406}, \'multiverseid\': 427406}, {\'name\': \'Araignée géante\', \'text\': \'Portée (Cette créature peut bloquer les créatures avec le vol.)\', \'type\': \'Créature : araignée\', \'flavor\': "Les Terres brisées sont jonchées de ruines de civilisations depuis longtemps disparues, et infestées d\'horreurs bien vivantes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427675&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2a76527-05d0-4176-b873-585a2cdf48fc\', \'multiverseId\': 427675}, \'multiverseid\': 427675}, {\'name\': \'Ragno Gigante\', \'text\': \'Raggiungere (Questa creatura può bloccare le creature con volare.)\', \'type\': \'Creatura — Ragno\', \'flavor\': "Le Terre spezzate sono cosparse di vestigia di civiltà da lungo estinte e infestate da orrori ben lungi dall\'estinzione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427944&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03388ebf-9135-46b1-a196-4e7488a50c0b\', \'multiverseId\': 427944}, \'multiverseid\': 427944}, {\'name\': \'大蜘蛛\', \'text\': \'到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'遺棄地の各所には潰えた文明の遺物が横たわり、鮮烈な恐怖が蔓延する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428213&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4222ebed-7788-4262-ba3c-fb81d7868d22\', \'multiverseId\': 428213}, \'multiverseid\': 428213}, {\'name\': \'거대한 거미\', \'text\': \'대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\', \'type\': \'생물 — 거미\', \'flavor\': \'망가진 땅에는 오래 전에 죽은 문명의 잔해가 널려 있고 활기 넘치는 괴수들이 들끓는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428482&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'15b75c8d-9bd2-4259-8a5a-454a8cbf920e\', \'multiverseId\': 428482}, \'multiverseid\': 428482}, {\'name\': \'Aranha Gigante\', \'text\': \'Alcance (Esta criatura pode bloquear criaturas com voar.)\', \'type\': \'Criatura — Aranha\', \'flavor\': \'As Terras Partidas estão repletas dos resquícios de civilizações há muito mortas, e infestadas por terrores bastante vivos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428751&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01dc6de0-8ac0-40b7-bb04-9abbc5b13f2e\', \'multiverseId\': 428751}, \'multiverseid\': 428751}, {\'name\': \'Гигантский Паук\', \'text\': \'Захват (Это существо может блокировать существа с Полетом.)\', \'type\': \'Существо — Паук\', \'flavor\': \'Смятенные Земли усеяны останками погибших цивилизаций и населены очень даже живыми кошмарами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429020&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'488b7629-2814-438a-b32a-021496ae6f15\', \'multiverseId\': 429020}, \'multiverseid\': 429020}, {\'name\': \'巨型蜘蛛\', \'text\': \'延势（此生物能阻挡具飞行异能的生物。）\', \'type\': \'生物～蜘蛛\', \'flavor\': \'毫无生气的文明残迹零星散落荒土各地，但其间充斥的各类恐怖怪物却随时可让人死于非命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429289&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3fe791e3-c697-4527-a191-89a1eecd06d3\', \'multiverseId\': 429289}, \'multiverseid\': 429289}, {\'name\': \'巨型蜘蛛\', \'text\': \'延勢（此生物能阻擋具飛行異能的生物。）\', \'type\': \'生物～蜘蛛\', \'flavor\': \'毫無生氣的文明殘跡零星散落荒土各地，但其間充斥的各類恐怖怪物卻隨時可讓人死於非命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429558&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c41bf5f7-6490-4a38-a654-2e14a4033d29\', \'multiverseId\': 429558}, \'multiverseid\': 429558}]', '[{\'name\': \'Rohe Kraft\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+1 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Oketra ließ uns einen Obelisken bauen, um uns Zusammenhalt zu lehren, aber ich bin allein stärker."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427093&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'06c683f8-898b-456e-ba52-d33e8d23404f\', \'multiverseId\': 427093}, \'multiverseid\': 427093}, {\'name\': \'Potencia bruta\', \'text\': \'La criatura objetivo obtiene +3/+1 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Oketra hizo que nuestra simiente construyera un obelisco para demostrar el poder del trabajo en equipo. Pero yo soy más fuerte sin los débiles".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427362&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'849848d3-792f-431a-ac84-0a5db25628ea\', \'multiverseId\': 427362}, \'multiverseid\': 427362}, {\'name\': \'Force brutale\', \'text\': "La créature ciblée gagne +3/+1 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "« Oketra a chargé notre moisson d\'élever un obélisque afin de témoigner de la force de la collaboration. Mais je suis plus fort sans les faibles. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427631&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc87188f-472c-480f-b48a-fe14518a5070\', \'multiverseId\': 427631}, \'multiverseid\': 427631}, {\'name\': \'Potenza Bruta\', \'text\': \'Una creatura bersaglio prende +3/+1 e ha travolgere fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Oketra chiese alla nostra messe di costruire un obelisco per dimostrare che l\\\'unione fa la forza. Ma io sono più forte senza i deboli."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427900&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'102672ef-0125-4cd4-b188-c72fc2dc6662\', \'multiverseId\': 427900}, \'multiverseid\': 427900}, {\'name\': \'凶暴な力\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋１の修整を受けるとともにトランプルを得る。\', \'type\': \'インスタント\', \'flavor\': \'「オケチラ様は共に働く力を示すため我ら一門にオベリスクの建造を命じたが、弱者などいなくても俺の方が強い。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428169&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83d6c51e-4740-4cb2-868c-d3daa5ca3486\', \'multiverseId\': 428169}, \'multiverseid\': 428169}, {\'name\': \'난폭한 힘\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +3/+1을 받고 돌진을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"오케트라는 협동의 힘을 보여주기 위해 입문자들에게 오벨리스크를 짓도록 했다. 하지만 나는 약한 자들이 없는 게 더 좋다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428438&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'18021532-0da2-42c6-a59f-1ff14162d3f0\', \'multiverseId\': 428438}, \'multiverseid\': 428438}, {\'name\': \'Força Imensa\', \'text\': \'A criatura alvo recebe +3/+1 e ganha atropelar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Oketra ordenou que nossa safra construísse um obelisco para demonstrar o poder do trabalho em equipe. Mas eu sou mais forte sem os fracos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428707&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ab06da7-5384-4fdd-8454-a56bb210214a\', \'multiverseId\': 428707}, \'multiverseid\': 428707}, {\'name\': \'Жестокая Сила\', \'text\': \'Целевое существо получает +3/+1 и Пробивной удар до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Окетра велела нашему снопу построить обелиск, чтобы показать, что сила — в единении. Но я сильнее без слабых».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428976&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'47abf5d1-057c-45b0-a386-8fe97cededbc\', \'multiverseId\': 428976}, \'multiverseid\': 428976}, {\'name\': \'粗蛮之力\', \'text\': \'直到回合结束，目标生物得+3/+1且获得践踏异能。\', \'type\': \'瞬间\', \'flavor\': \'「欧柯塔让我们祀群建造石碑，想要证明团结的力量。但倘若没有弱者拖累，我会更强。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429245&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'296f457c-3c17-4162-bd18-fbd4a8e06e6f\', \'multiverseId\': 429245}, \'multiverseid\': 429245}, {\'name\': \'粗蠻之力\', \'text\': \'直到回合結束，目標生物得+3/+1且獲得踐踏異能。\', \'type\': \'瞬間\', \'flavor\': \'「歐柯塔讓我們祀群建造石碑，想要證明團結的力量。但倘若沒有弱者拖累，我會更強。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429514&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'54524ab0-c2c6-4535-8b45-32ee24372c49\', \'multiverseId\': 429514}, \'multiverseid\': 429514}]', '[{\'name\': \'Ruheloses Umherirren\', \'text\': \'Bringe bis zu zwei Kreaturenkarten deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'Niemals ruhend. Niemals allein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427086&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'51d01919-7514-415a-a3c4-f1c31352d8ee\', \'multiverseId\': 427086}, \'multiverseid\': 427086}, {\'name\': \'Errando en la muerte\', \'text\': \'Regresa hasta dos cartas de criatura objetivo de tu cementerio a tu mano.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'Siempre en movimiento. Siempre aumentando sus filas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427355&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c6c80fa-9611-40ca-8397-f106c85165a2\', \'multiverseId\': 427355}, \'multiverseid\': 427355}, {\'name\': \'Errance dans la mort\', \'text\': "Renvoyez jusqu\'à deux cartes de créature ciblées depuis votre cimetière dans votre main.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': \'Jamais immobiles. Toujours plus nombreux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427624&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f10b1e9c-2513-4f25-98b3-fa8e7598543a\', \'multiverseId\': 427624}, \'multiverseid\': 427624}, {\'name\': \'Peregrinare nella Morte\', \'text\': \'Riprendi in mano fino a due carte creatura bersaglio dal tuo cimitero.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'Sempre irrequieti. Sempre più numerosi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427893&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ddf5fe4-df58-4978-a272-58a202010b0a\', \'multiverseId\': 427893}, \'multiverseid\': 427893}, {\'name\': \'死後の放浪\', \'text\': \'あなたの墓地からクリーチャー・カード最大２枚を対象とし、それらをあなたの手札に戻す。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'安息を知らず、未来永劫増え続ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428162&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2187d4de-6a10-4caa-b952-391a58fac0a4\', \'multiverseId\': 428162}, \'multiverseid\': 428162}, {\'name\': \'망자의 방황\', \'text\': \'당신의 무덤에 있는 생물 카드를 최대 두 장까지 목표로 정한다. 그 카드들을 당신의 무덤에서 당신의 손으로 되돌린다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'끊임없이 활동하고 끊임없이 늘어난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428431&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'79be61b5-ec86-4f30-b084-59ba7be63bc0\', \'multiverseId\': 428431}, \'multiverseid\': 428431}, {\'name\': \'Vagar na Morte\', \'text\': \'Devolva até dois cards de criatura alvo de seu cemitério para sua mão.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'Jamais em repouso. Sempre em aumento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428700&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2886498f-8020-4696-82ae-a9fe1174ed7d\', \'multiverseId\': 428700}, \'multiverseid\': 428700}, {\'name\': \'Посмертные Блуждания\', \'text\': \'Верните не более двух целевых карт существ из вашего кладбища в вашу руку.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'Вечно неупокоенные. Вечно растущие в числе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428969&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a88ad1ef-ce50-48d4-b214-dd0169706a56\', \'multiverseId\': 428969}, \'multiverseid\': 428969}, {\'name\': \'漂浪来生\', \'text\': \'将至多两张目标生物牌从你的坟墓场移回你手上。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'永不安息；永无穷尽。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429238&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ceceea1-2660-478e-b637-035d33a7e015\', \'multiverseId\': 429238}, \'multiverseid\': 429238}, {\'name\': \'漂浪來生\', \'text\': \'將至多兩張目標生物牌從你的墳墓場移回你手上。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'永不安息；永無窮盡。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429507&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dda820ec-9dfc-4cc2-9507-b7b9875e1727\', \'multiverseId\': 429507}, \'multiverseid\': 429507}]', '[{\'name\': \'Ruhmbringer\', \'text\': \'Fliegend, Eile\\nDu kannst den Ruhmbringer erschöpfen, sowie er angreift. Wenn du dies tust, fügt er einer Nicht-Drache-Kreatur deiner Wahl, die ein Gegner kontrolliert, 4 Schadenspunkte zu. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Was den Geweihten in ihrer letzten Prüfung begegnet, wird von Hazoret bestimmt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427105&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60d38fd9-ce67-42cf-92cc-98f188d0e17f\', \'multiverseId\': 427105}, \'multiverseid\': 427105}, {\'name\': \'Glorificador\', \'text\': \'Vuela, prisa.\\nPuedes espolear al Glorificador en cuanto ataque. Cuando lo hagas, hace 4 puntos de daño a la criatura objetivo que no sea Dragón que controla un oponente. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Dragón\', \'flavor\': \'A lo que los iniciados se enfrentan en la última prueba lo decide únicamente Hazoret.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427374&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8bf19dfa-d233-4521-87f4-cedfa9d2331a\', \'multiverseId\': 427374}, \'multiverseid\': 427374}, {\'name\': \'Annonciateur de gloire\', \'text\': "Vol, célérité\\nVous pouvez surmener l\'Annonciateur de gloire au moment où il attaque. Quand vous faites ainsi, il inflige 4 blessures à une créature non-Dragon ciblée qu\'un adversaire contrôle. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : dragon\', \'flavor\': "Ce que les adeptes affrontent durant la dernière épreuve est à la seule discrétion d\'Hazoret.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427643&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9f59654-e6bd-44fa-b645-9502449178c6\', \'multiverseId\': 427643}, \'multiverseid\': 427643}, {\'name\': \'Latore di Gloria\', \'text\': \'Volare, rapidità\\nPuoi stremare il Latore di Gloria mentre attacca. Quando lo fai, esso infligge 4 danni a una creatura non Drago bersaglio controllata da un avversario. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)\', \'type\': \'Creatura — Drago\', \'flavor\': "Cosa gli iniziati affrontano nell\'ordalia finale è a esclusiva discrezione di Hazoret.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427912&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'604ea415-23e6-4a66-a274-7c36f1e4c70b\', \'multiverseId\': 427912}, \'multiverseid\': 427912}, {\'name\': \'栄光をもたらすもの\', \'text\': \'飛行、速攻\\n栄光をもたらすものが攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、対戦相手がコントロールするドラゴンでないクリーチャー１体を対象とする。これはそれに４点のダメージを与える。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'最後の試練で修練者が向き合う相手はハゾレトの裁量による。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428181&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f5fd271-5496-4d45-986a-27e5eeb01825\', \'multiverseId\': 428181}, \'multiverseid\': 428181}, {\'name\': \'영광을 주는 자\', \'text\': \'비행, 신속\\n당신은 영광을 주는 자로 공격을 선언하면서 영광을 주는 자를 분전시킬 수 있다. 그렇게 할 때, 상대가 조종하는 용이 아닌 생물을 목표로 정한다. 영광을 주는 자는 그 생물에게 피해 4점을 입힌다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 용\', \'flavor\': \'입회자가 최종 시험에서 맞닥뜨리는 존재는 순전히 하조렛의 선택에 달렸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428450&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cba15bb5-9a54-4071-839e-5254fcce11d7\', \'multiverseId\': 428450}, \'multiverseid\': 428450}, {\'name\': \'Portador da Glória\', \'text\': \'Voar, ímpeto\\nVocê pode exaurir Portador da Glória conforme ele ataca. Quando você faz isso, ele causa 4 pontos de dano à criatura alvo que não seja um Dragão que um oponente controla. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Dragão\', \'flavor\': \'O que os iniciados enfrentam na última prova fica inteiramente ao critério de Hazoret.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428719&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad68e317-74e0-456e-b730-76abaef7bdea\', \'multiverseId\': 428719}, \'multiverseid\': 428719}, {\'name\': \'Несущий Славу\', \'text\': \'Полет, Ускорение\\nВы можете подстегнуть Несущего Славу в момент его атаки. Когда вы это делаете, он наносит 4 повреждения целевому не являющемуся Драконом существу под контролем оппонента. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Дракон\', \'flavor\': \'Одна лишь Хазорет решает, с чем встретятся послушники в последнем испытании.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428988&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ccbb0ae2-8763-426c-b34e-b49ef8d9b8fe\', \'multiverseId\': 428988}, \'multiverseid\': 428988}, {\'name\': \'终耀巨龙\', \'text\': \'飞行，敏捷\\n你可以于终耀巨龙攻击时耗竭之。当你如此作时，它向目标由对手操控的非龙生物造成4点伤害。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～龙\', \'flavor\': \'祀徒会在终极祀炼中面对什么，完全由哈佐蕾决定。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429257&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8fc9e8f0-3f02-430a-bad4-835de11068d1\', \'multiverseId\': 429257}, \'multiverseid\': 429257}, {\'name\': \'終耀巨龍\', \'text\': \'飛行，敏捷\\n你可以於終耀巨龍攻擊時耗竭之。當你如此作時，它向目標由對手操控的非龍生物造成4點傷害。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～龍\', \'flavor\': \'祀徒會在終極祀煉中面對什麼，完全由哈佐蕾決定。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429526&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'734e1891-bdca-4c00-9567-a9975405436d\', \'multiverseId\': 429526}, \'multiverseid\': 429526}]', '[{\'name\': \'Ruhmwürdiger Geweihter\', \'text\': \'Du kannst den Ruhmwürdigen Geweihten erschöpfen, sowie er angreift. Wenn du dies tust, erhält er +1/+3 und Lebensverknüpfung bis zum Ende des Zuges. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Möge dein Weg durch die Prüfungen frei von Zweifeln sein." —Oketra, Göttin des Zusammenhalts\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426987&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e9bdb0d-57a4-4677-9784-79ec5037ebdf\', \'multiverseId\': 426987}, \'multiverseid\': 426987}, {\'name\': \'Iniciado destinado a la gloria\', \'text\': \'Puedes espolear al Iniciado destinado a la gloria en cuanto ataque. Cuando lo hagas, obtiene +1/+3 y gana la habilidad de vínculo vital hasta el final del turno. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Vuela como una flecha por las pruebas y jamás flaquees en tu rumbo". —Oketra, diosa de la solidaridad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427256&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fa35121-7149-4307-89e1-42f802372472\', \'multiverseId\': 427256}, \'multiverseid\': 427256}, {\'name\': \'Adepte guidé par la gloire\', \'text\': "Vous pouvez surmener l\'Adepte guidé par la gloire au moment où il attaque. Quand vous faites ainsi, il gagne +1/+3 et acquiert le lien de vie jusqu\'à la fin du tour. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'« Traversez les épreuves comme une flèche et ne vacillez jamais. » —Oketra, déesse de la Solidarité\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427525&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be04f80f-3d5c-4256-b331-021c93b84200\', \'multiverseId\': 427525}, \'multiverseid\': 427525}, {\'name\': \'Iniziato Votato alla Gloria\', \'text\': "Puoi stremare l\'Iniziato Votato alla Gloria mentre attacca. Quando lo fai, prende +1/+3 e ha legame vitale fino alla fine del turno. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Superate le ordalie senza esitare, come una freccia che centra il bersaglio." —Oketra, dea della fratellanza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427794&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'934ffb2a-4358-4a75-8c84-ec518740fd31\', \'multiverseId\': 427794}, \'multiverseid\': 427794}, {\'name\': \'栄光半ばの修練者\', \'text\': \'栄光半ばの修練者が攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、ターン終了時まで、これは＋１/＋３の修整を受けるとともに絆魂を得る。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「矢のように真っすぐ、道を逸れることなく試練を突き進むがよい。」 ――結束の神、オケチラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428063&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b08e791-2774-4172-ad3a-6a8238adbe47\', \'multiverseId\': 428063}, \'multiverseid\': 428063}, {\'name\': \'영광을 좇는 입회자\', \'text\': \'당신은 영광을 좇는 입회자로 공격을 선언하면서 영광을 좇는 입회자를 분전시킬 수 있다. 그렇게 할 때, 영광을 좇는 입회자는 턴종료까지 +1/+3을 받고 생명연결을 얻는다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"화살처럼 빠르게 시험을 통과하되 절대 중도에 포기하지 마라." —결속의 신 오케트라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428332&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'83c41ffe-b100-4be0-8a42-7a203525d7b9\', \'multiverseId\': 428332}, \'multiverseid\': 428332}, {\'name\': \'Iniciado Destinado à Glória\', \'text\': \'Você pode exaurir Iniciado Destinado à Glória conforme ele ataca. Quando você faz isso, ele recebe +1/+3 e ganha vínculo com a vida até o final do turno. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Voe como uma flecha pelas provas, e jamais hesite em seu caminho." — Oketra, deusa da solidariedade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428601&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b6675b9-8d72-4308-b0de-c593ab43b536\', \'multiverseId\': 428601}, \'multiverseid\': 428601}, {\'name\': \'Стремящийся к Славе Послушник\', \'text\': \'Вы можете подстегнуть Стремящегося к Славе Послушника в момент его атаки. Когда вы это делаете, он получает +1/+3 и Цепь жизни до конца хода. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Лети через испытания, подобно стреле, и никогда не сбивайся с пути». — Окетра, богиня сплоченности\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428870&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1244fe61-7d7f-4a60-8eb7-fa5cac88d4e0\', \'multiverseId\': 428870}, \'multiverseid\': 428870}, {\'name\': \'崇耀祀徒\', \'text\': \'你可以于崇耀祀徒攻击时耗竭之。当你如此作时，直到回合结束，它得+1/+3且获得系命异能。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～人类／战士\', \'flavor\': \'「在祀炼中如离弦飞矢，勇往直前。」 ～团结之神欧柯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429139&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb2f6394-9a58-46e9-984d-b91a28d16c68\', \'multiverseId\': 429139}, \'multiverseid\': 429139}, {\'name\': \'崇耀祀徒\', \'text\': \'你可以於崇耀祀徒攻擊時耗竭之。當你如此作時，直到回合結束，它得+1/+3且獲得繫命異能。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～人類／戰士\', \'flavor\': \'「在祀煉中如離弦飛矢，勇往直前。」 ～團結之神歐柯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429408&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d18069d1-74c6-45b1-b09d-6667eddb4114\', \'multiverseId\': 429408}, \'multiverseid\': 429408}]', '[{\'name\': \'Rätselhafter Sceada\', \'text\': \'Fliegend\\nDie Stärke des Rätselhaften Sceadas ist gleich der Anzahl an Spontanzauber- und Hexerei-Karten in deinem Friedhof.\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Viele Geweihte glauben, er hüte Geheimnisse, die nur Kefnet selbst kennt. Kefnet weiß, dass dem nicht so ist, begrüßt aber die kostenlosen Fütterungen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427169&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af534884-ff28-4d68-bbeb-0531eeaf1bd6\', \'multiverseId\': 427169}, \'multiverseid\': 427169}, {\'name\': \'Draco enigma\', \'text\': \'Vuela.\\nLa fuerza del Draco enigma es igual a la cantidad de cartas de instantáneo y de conjuro en tu cementerio.\', \'type\': \'Criatura — Draco\', \'flavor\': \'Muchos iniciados creen que conoce secretos solo al alcance del mismísimo Kefnet. Muchos se convirtieron en comida tratando de averiguarlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427438&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab6eb1b5-ae82-4851-9b00-311b30945567\', \'multiverseId\': 427438}, \'multiverseid\': 427438}, {\'name\': \'Drakôn du logogriphe\', \'text\': "Vol\\nLa force du Drakôn du logogriphe est égale au nombre de cartes d\'éphémère et de rituel dans votre cimetière.", \'type\': \'Créature : drakôn\', \'flavor\': "De nombreux adeptes pensent qu\'il détient des secrets connus uniquement de Kefnet. Nombreux sont ceux à lui avoir servi de dîner en essayant de les percer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427707&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20b5b391-f56b-4b6d-986c-a957ad2adcba\', \'multiverseId\': 427707}, \'multiverseid\': 427707}, {\'name\': \'Draghetto degli Enigmi\', \'text\': \'Volare\\nLa forza del Draghetto degli Enigmi è pari al numero di carte istantaneo e stregoneria nel tuo cimitero.\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'Numerosi iniziati credono che sia a conoscenza di segreti noti solo a Kefnet. Molti di coloro che hanno tentato di carpirli sono stati trasformati in pasto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427976&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bb253bd4-6e00-400b-bad7-75cd4dd2abac\', \'multiverseId\': 427976}, \'multiverseid\': 427976}, {\'name\': \'奇怪なドレイク\', \'text\': \'飛行\\n奇怪なドレイクのパワーは、あなたの墓地にあるインスタントかソーサリーであるカードの総数に等しい。\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'多くの修練者は、そいつがケフネトのみが知る秘密を保持していると信じている。大勢がそれを知ろうとして餌食となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428245&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6d89fa8-1586-424e-a39e-a16b432d0f33\', \'multiverseId\': 428245}, \'multiverseid\': 428245}, {\'name\': \'수수께끼 드레이크\', \'text\': \'비행\\n수수께끼 드레이크의 공격력은 당신의 무덤에 있는 순간마법과 집중마법 카드의 수의 합과 같다.\', \'type\': \'생물 — 드레이크\', \'flavor\': \'많은 입회자들은 이 드레이크가 케프넷만 알고 있는 비밀을 가지고 있다고 믿는다. 하지만 대부분 이 비밀을 알아내려다 먹잇감이 되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428514&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fca8bd5c-dd27-4259-927c-59619cc58fcf\', \'multiverseId\': 428514}, \'multiverseid\': 428514}, {\'name\': \'Dragonete dos Enigmas\', \'text\': \'Voar\\nO poder de Dragonete dos Enigmas é igual ao número de cards de mágica instantânea e feitiço em seu cemitério.\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'Muitos iniciados creem que ele possui segredos conhecidos apenas pelo próprio Kefnet. Muitos viraram refeição tentando descobri-los.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428783&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d7bf830-b459-4a0b-8310-a2a908ec88ad\', \'multiverseId\': 428783}, \'multiverseid\': 428783}, {\'name\': \'Дрейк Загадок\', \'text\': \'Полет\\nСила Дрейка Загадок равна количеству карт мгновенных заклинаний и волшебства на вашем кладбище.\', \'type\': \'Существо — Дрейк\', \'flavor\': \'Многие послушники думают, что он хранит тайны, которые ведомы лишь самому Кефнету. Многие стали его пищей, пытаясь их выведать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429052&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7f026b04-a056-4af3-a726-b9fc8db9dc11\', \'multiverseId\': 429052}, \'multiverseid\': 429052}, {\'name\': \'谜翼龙兽\', \'text\': \'飞行\\n谜翼龙兽的力量等同于你坟墓场中瞬间与法术牌的数量加总。\', \'type\': \'生物～龙兽\', \'flavor\': \'祀徒相信它身上藏有刻法涅本尊才知晓的秘密。但大多数想要解开秘密的人都成了它的盘中餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429321&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1a7b7d5-2b20-41b1-bcd3-771c1cf95266\', \'multiverseId\': 429321}, \'multiverseid\': 429321}, {\'name\': \'謎翼龍獸\', \'text\': \'飛行\\n謎翼龍獸的力量等同於你墳墓場中瞬間與巫術牌的數量加總。\', \'type\': \'生物～龍獸\', \'flavor\': \'祀徒相信牠身上藏有刻法涅本尊才知曉的祕密。但大多數想要解開祕密的人都成了牠的盤中餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429590&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7fd42a75-5df1-46ef-afa4-41032ef8e613\', \'multiverseId\': 429590}, \'multiverseid\': 429590}]', '[{\'name\': \'Salbende Priesterin\', \'text\': \'Immer wenn ein Kreaturenspielstein unter deiner Kontrolle ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\nEinbalsamieren {3}{W} ({3}{W}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Mensch-Kleriker ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426974&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9502123d-cf0e-49cc-8ca5-5782c4a90845\', \'multiverseId\': 426974}, \'multiverseid\': 426974}, {\'name\': \'Sacerdotisa ungidora\', \'text\': \'Siempre que una ficha de criatura entre al campo de batalla bajo tu control, ganas 1 vida.\\nEmbalsamar {3}{W}. ({3}{W}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Clérigo Humano Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427243&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'203fa73a-a5bf-4ed1-b6eb-cac8ff286dd5\', \'multiverseId\': 427243}, \'multiverseid\': 427243}, {\'name\': \'Prêtresse consécratrice\', \'text\': "À chaque fois qu\'un jeton de créature arrive sur le champ de bataille sous votre contrôle, vous gagnez 1 point de vie.\\nEmbaumement {3}{W} ({3}{W}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et humain et clerc blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cb98e06c-229d-4342-8fb4-56a10389a9ab\', \'multiverseId\': 427512}, \'multiverseid\': 427512}, {\'name\': \'Sacerdotessa Consacratrice\', \'text\': \'Ogniqualvolta una pedina creatura entra nel campo di battaglia sotto il tuo controllo, guadagni 1 punto vita.\\nImbalsamare {3}{W} ({3}{W}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Chierico Umano Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427781&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8ed35c1-6c4d-4207-9b3f-2a055364698f\', \'multiverseId\': 427781}, \'multiverseid\': 427781}, {\'name\': \'選定の司祭\', \'text\': \'クリーチャー・トークンが１体あなたのコントロール下で戦場に出るたび、あなたは１点のライフを得る。\\n不朽{3}{W}（{3}{W}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・人間・クレリックであることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428050&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'abc1b631-0e6c-407e-a381-088f8e7be7c4\', \'multiverseId\': 428050}, \'multiverseid\': 428050}, {\'name\': \'세례자 사제\', \'text\': \'생물 토큰이 당신의 조종하에 전장에 들어올 때마다, 당신은 생명 1점을 얻는다.\\n방부처리 {3}{W} ({3}{W}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 인간 성직자다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428319&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e204a5b2-865d-40aa-9484-1e5a64f22853\', \'multiverseId\': 428319}, \'multiverseid\': 428319}, {\'name\': \'Sacerdotisa da Unção\', \'text\': \'Toda vez que uma ficha de criatura entra no campo de batalha sob seu controle, você ganha 1 ponto de vida.\\nEmbalsamar {3}{W} ({3}{W}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Humano Clérigo branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428588&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b776963f-1d11-4b6f-b755-abf654200fa3\', \'multiverseId\': 428588}, \'multiverseid\': 428588}, {\'name\': \'Жрица-Умастительница\', \'text\': \'Каждый раз, когда фишка существа выходит на поле битвы под вашим контролем, вы получаете 1 жизнь.\\nБальзамирование {3}{W} ({3}{W}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Человеком Священником без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428857&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'53d778e9-f902-48ad-ab90-3eeeaa2cf6df\', \'multiverseId\': 428857}, \'multiverseid\': 428857}, {\'name\': \'圣洗僧侣\', \'text\': \'每当一个衍生生物在你的操控下进战场时，你获得1点生命。\\n遗存{3}{W}（{3}{W}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／人类／僧侣，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429126&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02e307d3-0da0-440d-bc54-3890a13e9db9\', \'multiverseId\': 429126}, \'multiverseid\': 429126}, {\'name\': \'聖洗僧侶\', \'text\': \'每當一個衍生生物在你的操控下進戰場時，你獲得1點生命。\\n遺存{3}{W}（{3}{W}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／人類／僧侶，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429395&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f1bb2295-b4fb-40e0-989c-75b43e323f01\', \'multiverseId\': 429395}, \'multiverseid\': 429395}]', '[{\'name\': \'Samut, Stimme der Abtrünnigen\', \'text\': \'Aufblitzen\\nDoppelschlag, Wachsamkeit, Eile\\nAndere Kreaturen, die du kontrollierst, haben Eile.\\n{W}, {T}: Enttappe eine andere Kreatur deiner Wahl.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': \'„Ich werde nicht mehr um die Ehre kämpfen, sterben zu dürfen. Das Jenseits wird warten müssen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427176&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d942d14-0866-4768-9295-91bf6be2bb1c\', \'multiverseId\': 427176}, \'multiverseid\': 427176}, {\'name\': \'Samut, Voz de la Disidencia\', \'text\': \'Destello.\\nDaña dos veces, vigilancia, prisa.\\nLas otras criaturas que controlas tienen la habilidad de prisa.\\n{W}, {T}: Endereza otra criatura objetivo.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': \'"No lucharé más solo por el honor de morir. El más allá tendrá que esperar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427445&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'400de166-5cff-4bde-924c-2eaabfed1798\', \'multiverseId\': 427445}, \'multiverseid\': 427445}, {\'name\': \'Samut, voix de la sédition\', \'text\': \'Flash\\nDouble initiative, vigilance, célérité\\nLes autres créatures que vous contrôlez ont la célérité.\\n{W}, {T} : Dégagez une autre créature ciblée.\', \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': "« Je ne me battrai plus seulement pour l\'honneur de mourir. L\'au-delà devra attendre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427714&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e98776f9-4dcb-4f16-8485-968bc2d8e398\', \'multiverseId\': 427714}, \'multiverseid\': 427714}, {\'name\': \'Samut, Voce del Dissenso\', \'text\': "Lampo\\nDoppio attacco, cautela, rapidità\\nLe altre creature che controlli hanno rapidità.\\n{W}, {T}: STAPpa un\'altra creatura bersaglio.", \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': \'"Non combatterò più solo per l\\\'onore di morire. L\\\'aldilà dovrà attendere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427983&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd1c672f-92c5-46af-8a52-dfe08f34cc9f\', \'multiverseId\': 427983}, \'multiverseid\': 427983}, {\'name\': \'造反の代弁者、サムト\', \'text\': \'瞬速\\n二段攻撃、警戒、速攻\\nあなたがコントロールする他のクリーチャーは速攻を持つ。\\n{W}, {T}：他のクリーチャー１体を対象とし、それをアンタップする。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': \'「死ぬ名誉のために戦うのはもうやめるわ。来世など待たせておけばいい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428252&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e73fdc47-ee5a-4887-b066-d4d2ac31de5e\', \'multiverseId\': 428252}, \'multiverseid\': 428252}, {\'name\': \'반대자의 대변인 사무트\', \'text\': \'섬광\\n이단공격, 경계, 신속\\n당신이 조종하는 다른 생물들은 신속을 가진다.\\n{W}, {T}: 다른 생물을 목표로 정한다. 그 생물을 언탭한다.\', \'type\': \'전설적 생물 — 인간 전사\', \'flavor\': \'"난 더 이상 영광스런 죽음을 위해 싸우지 않겠다. 사후 세계가 우리를 좀 더 기다려야 할 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428521&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'98c6a426-f099-45e6-8eb3-da0af510f4b1\', \'multiverseId\': 428521}, \'multiverseid\': 428521}, {\'name\': \'Samut, Voz da Dissensão\', \'text\': \'Lampejo\\nGolpe duplo, vigilância, ímpeto\\nAs outras criaturas que você controla têm ímpeto.\\n{W}, {T}: Desvire outra criatura alvo.\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': \'"Não lutarei mais apenas pela honra de morrer. A vida após a morte terá que esperar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428790&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a7f7e0b-7262-4563-9d4f-76f57ac713d1\', \'multiverseId\': 428790}, \'multiverseid\': 428790}, {\'name\': \'Самут, Голос Инакомыслия\', \'text\': \'Миг\\nДвойной удар, Бдительность, Ускорение\\nДругие существа под вашим контролем имеют Ускорение.\\n{W}, {T}: разверните другое целевое существо.\', \'type\': \'Легендарное Существо — Человек Воин\', \'flavor\': \'«Я больше не буду сражаться за великую честь умереть. Загробная жизнь подождет».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429059&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce1cd7ba-37a0-49ef-a839-783527525dd3\', \'multiverseId\': 429059}, \'multiverseid\': 429059}, {\'name\': \'逆徒之声撒姆特\', \'text\': \'闪现\\n连击，警戒，敏捷\\n由你操控的其他生物具有敏捷异能。\\n{W}，{T}：重置另一个目标生物。\', \'type\': \'传奇生物～人类／战士\', \'flavor\': \'「我不再为光荣赴死拼命。我的来世还未到。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429328&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ef0eec5-bf76-4655-ae59-440d2bca158f\', \'multiverseId\': 429328}, \'multiverseid\': 429328}, {\'name\': \'逆徒之聲撒姆特\', \'text\': \'閃現\\n連擊，警戒，敏捷\\n由你操控的其他生物具有敏捷異能。\\n{W}，{T}：重置另一個目標生物。\', \'type\': \'傳奇生物～人類／戰士\', \'flavor\': \'「我不再為光榮赴死拚命。我的來世還未到。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429597&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8da24cff-a149-4ffb-bedb-c2162dba90d5\', \'multiverseId\': 429597}, \'multiverseid\': 429597}]', '[{\'name\': \'Sandwurm-Aufkommen\', \'text\': \'Kreaturen mit Flugfähigkeit können weder dich noch Planeswalker, die du kontrollierst, angreifen.\\nErzeuge zu Beginn deines Endsegments einen 5/5 grünen Wurm-Kreaturenspielstein.\', \'type\': \'Verzauberung\', \'flavor\': \'Es gibt nur zwei Wege, mit einer solchen Plage umzugehen: gar nicht und überhaupt nicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427154&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69f1f551-f8af-4e43-9113-35973e50bb71\', \'multiverseId\': 427154}, \'multiverseid\': 427154}, {\'name\': \'Confluencia de sierpes de arena\', \'text\': \'Las criaturas con la habilidad de volar no pueden atacarte a ti ni a un planeswalker que controlas.\\nAl comienzo de tu paso final, crea una ficha de criatura Sierpe verde 5/5.\', \'type\': \'Encantamiento\', \'flavor\': \'Irascibles y territoriales, las sierpes de arena reclaman incluso los cielos sobre sus dunas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427423&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a1d772c-dd49-41b8-94d0-2e68c7d60a01\', \'multiverseId\': 427423}, \'multiverseid\': 427423}, {\'name\': \'Convergence des guivres des sables\', \'text\': \'Les créatures avec le vol ne peuvent pas vous attaquer ou attaquer les planeswalkers que vous contrôlez.\\nAu début de votre étape de fin, créez un jeton de créature 5/5 verte Guivre.\', \'type\': \'Enchantement\', \'flavor\': \'Irascibles et territoriales, les guivres des sables revendiquent même le ciel qui surplombe leurs dunes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427692&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14722990-d2d2-4446-b3da-8576931d79f6\', \'multiverseId\': 427692}, \'multiverseid\': 427692}, {\'name\': \'Convergenza di Wurm Sabbiosi\', \'text\': "Le creature con volare non possono attaccare te o i planeswalker che controlli.\\nAll\'inizio della tua sottofase finale, crea una pedina creatura Wurm 5/5 verde.", \'type\': \'Incantesimo\', \'flavor\': \'Burberi e territoriali, i wurm sabbiosi rivendicano persino i cieli sopra le loro dune.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1537a48-1798-4a4f-8bd0-8986d01311b3\', \'multiverseId\': 427961}, \'multiverseid\': 427961}, {\'name\': \'サンドワームの収斂\', \'text\': \'飛行を持つクリーチャーでは、あなたやあなたがコントロールするプレインズウォーカーを攻撃できない。\\nあなたの終了ステップの開始時に、緑の５/５のワーム・クリーチャー・トークンを１体生成する。\', \'type\': \'エンチャント\', \'flavor\': \'喧嘩早く縄張り意識の強いサンドワームは、砂丘の上空も見張っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428230&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'65261733-165e-4859-be04-e006f482a3e4\', \'multiverseId\': 428230}, \'multiverseid\': 428230}, {\'name\': \'모래웜 결집\', \'text\': \'비행을 가진 생물은 당신 또는 당신이 조종하는 플레인즈워커를 공격할 수 없다.\\n당신의 종료단 시작에, 5/5 녹색 웜 생물 토큰 한 개를 만든다.\', \'type\': \'부여마법\', \'flavor\': \'괴팍하고 영토에 집착하는 모래웜은 모래 언덕 위의 하늘도 지배하려 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428499&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eb79f135-99fe-4aef-b664-bc43973e315e\', \'multiverseId\': 428499}, \'multiverseid\': 428499}, {\'name\': \'Convergência dos Vormes-da-areia\', \'text\': \'As criaturas com voar não podem atacar você nem os planeswalkers que você controla.\\nNo início de sua etapa final, crie uma ficha de criatura verde 5/5 do tipo Vorme.\', \'type\': \'Encantamento\', \'flavor\': \'Irritadiços e territorialistas, os vormes-da-areia reivindicam até mesmo os céus acima de suas dunas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428768&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0fcf4a49-6540-4161-97aa-26f796e42278\', \'multiverseId\': 428768}, \'multiverseid\': 428768}, {\'name\': \'Скопление Песчаных Вурмов\', \'text\': \'Существа с Полетом не могут атаковать вас или planeswalker-ов под вашим контролем.\\nВ начале вашего заключительного шага создайте одну фишку существа 5/5 зеленый Вурм.\', \'type\': \'Чары\', \'flavor\': \'Злобные и яростно защищающие свои угодья вурмы присвоили себе даже небо над дюнами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429037&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40ca5a03-92fd-4ed3-b831-1e9903b3886d\', \'multiverseId\': 429037}, \'multiverseid\': 429037}, {\'name\': \'沙丘亚龙巢群\', \'text\': \'具飞行异能的生物不能攻击你或由你操控的鹏洛客。\\n在你的结束步骤开始时，派出一个5/5绿色亚龙衍生生物。\', \'type\': \'结界\', \'flavor\': \'沙丘亚龙脾气暴躁、据地意识强烈，就连沙丘顶上的天空也不容他者涉足。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429306&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4dfd047e-e378-4f01-8db3-77acd00310aa\', \'multiverseId\': 429306}, \'multiverseid\': 429306}, {\'name\': \'沙丘亞龍巢群\', \'text\': \'具飛行異能的生物不能攻擊你或由你操控的鵬洛客。\\n在你的結束步驟開始時，派出一個5/5綠色亞龍衍生生物。\', \'type\': \'結界\', \'flavor\': \'沙丘亞龍脾氣暴躁、據地意識強烈，就連沙丘頂上的天空也不容他者涉足。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429575&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'96c06731-fc41-4593-bd5b-deefc52750f5\', \'multiverseId\': 429575}, \'multiverseid\': 429575}]', '[{\'name\': \'Sceada-Brutplatz\', \'text\': \'Immer wenn du eine Karte umwandelst oder abwirfst, kannst du {1} bezahlen. Falls du dies tust, erzeuge einen 2/2 blauen Sceada-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Verzauberung\', \'flavor\': \'„Wenn du deine Überlebenskünste testen willst, dann besuche den Obeliskenpfad, während die Sceadas jagen." —Etha, Geweihte der Rhet-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427022&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2003d0ad-c4d0-44a7-9e4b-31ae233feab1\', \'multiverseId\': 427022}, \'multiverseid\': 427022}, {\'name\': \'Refugio de dracos\', \'text\': \'Siempre que actives una habilidad de ciclo o descartes una carta, puedes pagar {1}. Si lo haces, crea una ficha de criatura Draco azul 2/2 con la habilidad de volar.\', \'type\': \'Encantamiento\', \'flavor\': \'"Si de verdad deseas poner a prueba tus habilidades de supervivencia, pasea por la Senda de los obeliscos cuando los dracos se estén alimentando". —Etha, iniciada de la simiente Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427291&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2862af94-f315-41ff-a34c-7900d9c6a0fb\', \'multiverseId\': 427291}, \'multiverseid\': 427291}, {\'name\': \'Havre de drakôns\', \'text\': "À chaque fois que vous recyclez ou vous défaussez d\'une carte, vous pouvez payer {1}. Si vous faites ainsi, créez un jeton de créature 2/2 bleue Drakôn avec le vol.", \'type\': \'Enchantement\', \'flavor\': "« Si vous souhaitez vraiment mettre vos techniques de survie à l\'épreuve, allez marcher le long de la Voie des obélisques à l\'heure du repas des drakôns. » —Etha, adepte de la moisson Rhet", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427560&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6da7be69-5bc0-48d6-b7d9-8d0b42330ae3\', \'multiverseId\': 427560}, \'multiverseid\': 427560}, {\'name\': \'Rifugio dei Draghetti\', \'text\': \'Ogniqualvolta cicli o scarti una carta, puoi pagare {1}. Se lo fai, crea una pedina creatura Draghetto 2/2 blu con volare.\', \'type\': \'Incantesimo\', \'flavor\': \'"Se volete davvero mettere alla prova il vostro istinto di sopravvivenza, percorrete la Via degli obelischi mentre i draghetti consumano il loro pasto!" —Etha, iniziata della messe Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427829&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7c6137c-bee6-49b7-b9ab-cd4537a07f69\', \'multiverseId\': 427829}, \'multiverseid\': 427829}, {\'name\': \'ドレイクの安息地\', \'text\': \'あなたがカードを１枚サイクリングするか捨てるたび、あなたは{1}を支払ってもよい。そうしたなら、飛行を持つ青の２/２のドレイク・クリーチャー・トークンを１体生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「生き残る術を試したいなら、ドレイクが餌をあさる中オベリスクの道を歩いてみるのがいいでしょうね。」 ――レト一門の修練者、イータ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428098&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'005ed910-3f4a-4bb3-94d5-6cf64a0a148e\', \'multiverseId\': 428098}, \'multiverseid\': 428098}, {\'name\': \'드레이크 안식처\', \'text\': \'당신이 카드를 순환하거나 버릴 때마다, 당신은 {1}을 지불할 수 있다. 그렇게 한다면, 비행을 가진 2/2 청색 드레이크 생물 토큰 한 개를 만든다.\', \'type\': \'부여마법\', \'flavor\': \'"생존 기술을 시험하고 싶다면 드레이크들이 한창 먹이를 먹을 때 오벨리스크 영지를 지나가라." —레트 입문자의 입회자 에타\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428367&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2fa024e1-8529-4122-8fde-f8ef4ae4222d\', \'multiverseId\': 428367}, \'multiverseid\': 428367}, {\'name\': \'Refúgio dos Dragonetes\', \'text\': \'Toda vez que recicla ou descarta um card, você pode pagar {1}. Se fizer isso, crie uma ficha de criatura azul 2/2 do tipo Dragonete com voar.\', \'type\': \'Encantamento\', \'flavor\': \'"Se você quer mesmo testar suas habilidades de sobrevivência, ande pelo Caminho dos Obeliscos quando os dragonetes estão comendo." — Etha, iniciada da safra Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428636&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13f32833-316c-4f8d-bdae-6917958398dd\', \'multiverseId\': 428636}, \'multiverseid\': 428636}, {\'name\': \'Убежище Дрейков\', \'text\': \'Каждый раз, когда вы совершаете Цикл или сбрасываете карту, вы можете заплатить {1}. Если вы это делаете, создайте одну фишку существа 2/2 синий Дрейк с Полетом.\', \'type\': \'Чары\', \'flavor\': \'«Если ты и вправду хочешь испытать свое мастерство выживания, пройди Путем Обелисков, когда дрейки вылетают на охоту». — Эта, послушница снопа Рет\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428905&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'679b8f66-98ba-419c-8153-4162e7790b2e\', \'multiverseId\': 428905}, \'multiverseid\': 428905}, {\'name\': \'龙兽庇护地\', \'text\': \'每当你循环或弃一张牌时，你可以支付{1}。若你如此作，则派出一个2/2蓝色，具飞行异能的龙兽衍生生物。\', \'type\': \'结界\', \'flavor\': \'「如果你诚心想检验自己的生存技巧，挑龙兽觅食时去石碑道走走。」 ～雷特祀群祀徒爱瑟\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429174&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7a8318b-8dd4-497b-a1a7-37a77423c86c\', \'multiverseId\': 429174}, \'multiverseid\': 429174}, {\'name\': \'龍獸庇護地\', \'text\': \'每當你循環或棄一張牌時，你可以支付{1}。若你如此作，則派出一個2/2藍色，具飛行異能的龍獸衍生生物。\', \'type\': \'結界\', \'flavor\': \'「如果你誠心想檢驗自己的生存技巧，挑龍獸覓食時去石碑道走走。」 ～雷特祀群祀徒愛瑟\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429443&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8afaf207-575f-47df-9522-afda5cc1c0df\', \'multiverseId\': 429443}, \'multiverseid\': 429443}]', '[{\'name\': \'Schatten des Grabes\', \'text\': \'Bringe alle Karten, die du in diesem Zug umgewandelt oder abgeworfen hast, aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Diese Welt ist vom Tod zerfressen. Ich spüre ihn im Sand auf meiner Haut und im Staub auf meiner Zunge." —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427078&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'da311b11-50d6-405f-a5dd-b3c8b786d6d2\', \'multiverseId\': 427078}, \'multiverseid\': 427078}, {\'name\': \'Sombra de la tumba\', \'text\': \'Regresa a tu mano todas las cartas en tu cementerio que hayas descartado o cuya habilidad de ciclo hayas activado este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"En este plano, la muerte se ha infiltrado por todas partes. La siento sobre mi piel, y noto su sabor como arena en la boca". —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427347&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'abdcaae4-a560-46fb-8214-f91983bc6b3e\', \'multiverseId\': 427347}, \'multiverseid\': 427347}, {\'name\': \'Ombre de la tombe\', \'text\': \'Renvoyez dans votre main toutes les cartes de votre cimetière que vous avez recyclées ou qui ont été défaussées ce tour-ci.\', \'type\': \'Éphémère\', \'flavor\': "« La mort s\'est insinuée partout sur ce plan. Je la sens sur ma peau et dans ma bouche, comme le sable. » —Nissa Revane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'81052d47-296e-4317-b5e9-57d82c43af51\', \'multiverseId\': 427616}, \'multiverseid\': 427616}, {\'name\': \'Ombra del Sepolcro\', \'text\': \'Riprendi in mano dal tuo cimitero tutte le carte che hai ciclato o scartato in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Questo piano è pervaso dalla morte. La avverto sulla pelle e ne sento il sapore, simile a quello della sabbia." —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427885&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'544752c9-3ec3-4d3c-9177-70b1f39fd162\', \'multiverseId\': 427885}, \'multiverseid\': 427885}, {\'name\': \'葬送の影\', \'text\': \'あなたの墓地にある、あなたがこのターンにサイクリングしたか捨てたカードをすべてあなたの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'「この次元の隅々にまで死が浸潤している。肌で感じるわ。口の中の砂粒のよう。」 ――ニッサ・レヴェイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428154&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'77bec890-42ed-4045-a290-f022c7e40cf5\', \'multiverseId\': 428154}, \'multiverseid\': 428154}, {\'name\': \'무덤의 그림자\', \'text\': \'이 턴에 당신이 순환하거나 버린 당신의 무덤에 있는 모든 카드를 당신의 손으로 되돌린다.\', \'type\': \'순간마법\', \'flavor\': \'"이 차원 곳곳에 죽음이 스며들었다. 피부로도 느낄 수 있고 입 속에 모래처럼 맛도 볼 수 있다." —니사 레베인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428423&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d9b4382-6ba4-4f69-8615-1ab6ad1df21e\', \'multiverseId\': 428423}, \'multiverseid\': 428423}, {\'name\': \'Sombra do Túmulo\', \'text\': \'Devolva para sua mão todos os cards em seu cemitério que você reciclou ou descartou neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A morte está por toda parte neste plano. Sinto seu toque em minha pele e seu gosto em minha boca, como areia." — Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428692&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57d4aaae-ff2f-4afb-ac81-393afeaafdec\', \'multiverseId\': 428692}, \'multiverseid\': 428692}, {\'name\': \'Могильная Тень\', \'text\': \'Верните в вашу руку все карты из вашего кладбища, с которыми вы совершили Цикл или сбросили в этом ходу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Смерть проникла во все концы этого мира. Я чувствую ее на коже, и ее вкус — как песок на зубах». — Нисса Ревейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428961&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d4312f92-5f43-4138-8e2e-506debc38c5d\', \'multiverseId\': 428961}, \'multiverseid\': 428961}, {\'name\': \'坟场阴影\', \'text\': \'将你坟墓场中所有你于本回合中循环或弃掉的牌移回你手上。\', \'type\': \'瞬间\', \'flavor\': \'「死亡渗透了这个时空的各方面。有如污秽沾身挥之不去，又如黄沙进口苦不堪言。」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429230&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'99356c7e-e330-409e-8726-3fca10bc55af\', \'multiverseId\': 429230}, \'multiverseid\': 429230}, {\'name\': \'墳場陰影\', \'text\': \'將你墳墓場中所有你於本回合中循環或棄掉的牌移回你手上。\', \'type\': \'瞬間\', \'flavor\': \'「死亡滲透了這個時空的各方面。有如污穢沾身揮之不去，又如黃沙進口苦不堪言。」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429499&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a28db9c-f029-4204-8a3f-936a64a10dcb\', \'multiverseId\': 429499}, \'multiverseid\': 429499}]', '[{\'name\': \'Schattensturm-Wesirin\', \'text\': \'Fliegend\\nImmer wenn du eine Karte umwandelst oder abwirfst, erhält die Schattensturm-Wesirin +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Sie kann den Wind wie einen Faden um ihren Finger wickeln oder wie eine Schlinge um den Hals ihrer Feinde legen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427177&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'50c0a0a6-02a0-49bb-9031-12d0e7899a1f\', \'multiverseId\': 427177}, \'multiverseid\': 427177}, {\'name\': \'Visir tormenta espectral\', \'text\': \'Vuela.\\nSiempre que actives una habilidad de ciclo o descartes una carta, la Visir tormenta espectral obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Es capaz de enroscar una brisa como un hilo alrededor de su dedo... o convertirla en una soga.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427446&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'33a9c2da-3be4-4605-95fd-936d0ee57129\', \'multiverseId\': 427446}, \'multiverseid\': 427446}, {\'name\': \'Vizir de la tempête de distorsion\', \'text\': "Vol\\nÀ chaque fois que vous recyclez ou vous défaussez d\'une carte, le Vizir de la tempête de distorsion gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'Elle peut enrouler la brise autour de son doigt ou en faire un nœud coulant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427715&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b58d57c1-aae2-46c3-a2b5-42d0432f4561\', \'multiverseId\': 427715}, \'multiverseid\': 427715}, {\'name\': "Visir della Tempesta dell\'Ombra", \'text\': "Volare\\nOgniqualvolta cicli o scarti una carta, la Visir della Tempesta dell\'Ombra prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'Può attorcigliare il vento come un laccio attorno al dito o avvolgerlo in un cappio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427984&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2aa0b8c7-9841-4516-898f-7f64e52bcf15\', \'multiverseId\': 427984}, \'multiverseid\': 427984}, {\'name\': \'影嵐の侍臣\', \'text\': \'飛行\\nあなたがカードを１枚サイクリングするか捨てるたび、ターン終了時まで、影嵐の侍臣は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'竜巻を指に巻きつけるのも、投げ縄にするのも自由自在。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428253&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b1c3abe-1028-4445-a193-6fb959d9fd7b\', \'multiverseId\': 428253}, \'multiverseid\': 428253}, {\'name\': \'그림자폭풍 고관\', \'text\': \'비행\\n당신이 카드를 순환하거나 버릴 때마다, 그림자폭풍 고관은 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'그녀는 산들바람을 손가락에 실처럼 휘감거나 꼬아서 올가미로 만들 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428522&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'40320aa5-2e2f-4599-a23d-74ca04521b57\', \'multiverseId\': 428522}, \'multiverseid\': 428522}, {\'name\': \'Vizir da Tempestade das Sombras\', \'text\': \'Voar\\nToda vez que você recicla ou descarta um card, Vizir da Tempestade das Sombras recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'Ela é capaz de enrolar uma brisa no dedo como um fio —ou dar nela um nó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428791&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d19acf2-a74b-4599-a641-92506d8cbe08\', \'multiverseId\': 428791}, \'multiverseid\': 428791}, {\'name\': \'Визирь Темных Бурь\', \'text\': \'Полет\\nКаждый раз, когда вы совершаете Цикл или сбрасываете карту, Визирь Темных Бурь получает +1/+1 до конца хода.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Она может намотать ветер на палец, как шнурок, — или сплести в аркан.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429060&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a78df2e3-cfcb-4c17-9c2e-81902f2d1b06\', \'multiverseId\': 429060}, \'multiverseid\': 429060}, {\'name\': \'幽风维齐尔\', \'text\': \'飞行\\n每当你循环或弃一张牌时，幽风维齐尔得+1/+1直到回合结束。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'风在其手中还有更多变化～可捻清风如丝轻抚指尖，可拧旋风咆哮疾袭向前。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429329&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4f472448-b265-4333-90a1-00f5d5a0742a\', \'multiverseId\': 429329}, \'multiverseid\': 429329}, {\'name\': \'幽風維齊爾\', \'text\': \'飛行\\n每當你循環或棄一張牌時，幽風維齊爾得+1/+1直到回合結束。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'風在其手中還有更多變化～可捻清風如絲輕撫指尖，可擰旋風咆哮疾襲向前。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429598&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2858da24-5f24-4cab-a4d1-962f8c6f6e94\', \'multiverseId\': 429598}, \'multiverseid\': 429598}]', "[{'name': 'Schimmerschuppen-Sceada', 'text': 'Fliegend\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Kreatur — Sceada', 'flavor': 'Sie kommen wegen des blauen Schimmers des Lazoteps, aber bleiben wegen der Minenarbeiter.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427041&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4a6d558d-7148-4565-9b3e-4c38e4f57bd8', 'multiverseId': 427041}, 'multiverseid': 427041}, {'name': 'Draco escamafulgor', 'text': 'Vuela.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Criatura — Draco', 'flavor': 'Se sienten atraídos por el brillante resplandor azul del mineral lazotep que hay abajo en las minas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427310&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c2cc866a-df8b-4cad-9701-7db54cdd2304', 'multiverseId': 427310}, 'multiverseid': 427310}, {'name': 'Drakôn aux écailles rutilantes', 'text': 'Vol\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Créature : drakôn', 'flavor': 'Ils sont attirés par les reflets bleus des mines de lazotèpe en contrebas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427579&type=card', 'language': 'French', 'identifiers': {'scryfallId': '78d40223-8ea4-4809-93ee-b619aa45e345', 'multiverseId': 427579}, 'multiverseid': 427579}, {'name': 'Draghetto Scaglialustra', 'text': 'Volare\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Creatura — Draghetto', 'flavor': 'Sono attratti dal vivace scintillio bluastro del lazotep proveniente dalle miniere che sorvolano.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427848&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'eeab97ff-3b9c-4540-9448-56c5a1ebb769', 'multiverseId': 427848}, 'multiverseid': 427848}, {'name': '微光鱗のドレイク', 'text': '飛行\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': 'クリーチャー — ドレイク', 'flavor': '眼下の鉱山に青くきらめくラゾテプの鉱石が目当てなのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428117&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ba6f289e-b834-42b3-8142-0738ab7205d7', 'multiverseId': 428117}, 'multiverseid': 428117}, {'name': '미광비늘 드레이크', 'text': '비행\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '생물 — 드레이크', 'flavor': '이 드레이크들은 지하 광산의 광물 라조텝이 내뿜는 화려한 청색 광택에 이끌린다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428386&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '44fc60ce-617d-463f-88ac-2d9a7d94ef02', 'multiverseId': 428386}, 'multiverseid': 428386}, {'name': 'Dragonete-de-escamas-cintilantes', 'text': 'Voar\\nReciclar {2} ({2}, Descarte este card: Compre um card.)', 'type': 'Criatura — Dragonete', 'flavor': 'Eles são atraídos pelo brilhante reluzir azul do minério de lazotep nas minas abaixo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428655&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1d06d6e4-650a-4f0e-82a4-0fac2e65b144', 'multiverseId': 428655}, 'multiverseid': 428655}, {'name': 'Дрейк Мерцающей Чешуи', 'text': 'Полет\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Существо — Дрейк', 'flavor': 'Их манит ярко-синий блеск минерала лазотепа в рудниках внизу.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428924&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '158e4c0e-57bd-4ead-b697-e957b2804359', 'multiverseId': 428924}, 'multiverseid': 428924}, {'name': '蓝光鳞龙兽', 'text': '飞行\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '生物～龙兽', 'flavor': '它们被地下矿场中闪着耀眼蓝色晶光的拉佐特石吸引而来。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429193&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd3c54f80-204a-4b6f-ad76-ac3cdf4f542b', 'multiverseId': 429193}, 'multiverseid': 429193}, {'name': '藍光鱗龍獸', 'text': '飛行\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '生物～龍獸', 'flavor': '牠們被地下礦場中閃著耀眼藍色晶光的拉佐特石吸引而來。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429462&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2a6ba69c-b309-4df5-b125-0050e683fd99', 'multiverseId': 429462}, 'multiverseid': 429462}]", '[{\'name\': \'Schirmraufbold\', \'text\': \'Du kannst den Schirmraufbold erschöpfen, sowie er angreift. Wenn du dies tust, erhält er +2/+2 bis zum Ende des Zuges. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Naga, Krieger\', \'flavor\': \'Niemand verkörpert den Kampfstil der Bitterklinge so sehr wie ein Naga mit Zwillingsdolchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427144&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09db1b7d-57e0-43bf-8687-51f340b45a9d\', \'multiverseId\': 427144}, \'multiverseid\': 427144}, {\'name\': \'Pendenciero encapuchado\', \'text\': \'Puedes espolear al Pendenciero encapuchado en cuanto ataque. Cuando lo hagas, obtiene +2/+2 hasta el final del turno. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero naga\', \'flavor\': \'Los naga que empuñan dagas gemelas son expertos en una técnica de combate llamada Dentellada de Rhonas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427413&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d417f196-bf52-48a4-9ec1-1c6da4086a04\', \'multiverseId\': 427413}, \'multiverseid\': 427413}, {\'name\': \'Bagarreur cagoulard\', \'text\': "Vous pouvez surmener le Bagarreur cagoulard au moment où il attaque. Quand vous faites ainsi, il gagne +2/+2 jusqu\'à la fin du tour. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : naga et guerrier\', \'flavor\': "Les nagas maniant deux dagues excellent dans la technique de combat qu\'on appelle la Morsure de Rhonas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427682&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18dada4a-fc0d-4764-b021-10c1bbb1ed60\', \'multiverseId\': 427682}, \'multiverseid\': 427682}, {\'name\': \'Lottatore dal Cappuccio\', \'text\': \'Puoi stremare il Lottatore dal Cappuccio mentre attacca. Quando lo fai, prende +2/+2 fino alla fine del turno. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)\', \'type\': \'Creatura — Guerriero Naga\', \'flavor\': \'I naga che brandiscono due pugnali sono abilissimi nella tecnica di combattimento nota come "Il morso di Rhonas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427951&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'018df135-0a0e-4961-b791-08659557f5e3\', \'multiverseId\': 427951}, \'multiverseid\': 427951}, {\'name\': \'頭巾の喧嘩屋\', \'text\': \'頭巾の喧嘩屋が攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、ターン終了時まで、これは＋２/＋２の修整を受ける。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — ナーガ・戦士\', \'flavor\': \'短剣を二本持つナーガは、ロナス咬術という戦技に秀でている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428220&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5dca920-18e1-475d-8130-1e959c005ebc\', \'multiverseId\': 428220}, \'multiverseid\': 428220}, {\'name\': \'두건머리 싸움꾼\', \'text\': \'당신은 두건머리 싸움꾼으로 공격을 선언하면서 두건머리 싸움꾼을 분전시킬 수 있다. 그렇게 할 때, 두건머리 싸움꾼은 턴종료까지 +2/+2를 받는다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 나가 전사\', \'flavor\': \'쌍단검을 사용하는 나가들은 로나스의 맹독검이라고 알려진 전투 기술에 뛰어나다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428489&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1579ab9a-7c87-4f28-ac8a-3d87c8d196a7\', \'multiverseId\': 428489}, \'multiverseid\': 428489}, {\'name\': \'Rufião de Capelo\', \'text\': \'Você pode exaurir Rufião de Capelo conforme ele ataca. Quando você faz isso, ele recebe +2/+2 até o final do turno. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Naga Guerreiro\', \'flavor\': \'As nagas que empunham duas adagas se destacam com a técnica de luta conhecida como Picada de Rhonas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428758&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa972812-3fba-43e9-a0db-e903d3e6e50c\', \'multiverseId\': 428758}, \'multiverseid\': 428758}, {\'name\': \'Капюшонный Боец\', \'text\': \'Вы можете подстегнуть Капюшонного Бойца в момент его атаки. Когда вы это делаете, он получает +2/+2 до конца хода. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Нага Воин\', \'flavor\': \'Вооруженные двумя клинками наги мастерски владеют техникой боя, известной как «Укус Ронаса».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429027&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'996b6d94-a969-47ea-8043-9c647f280dfb\', \'multiverseId\': 429027}, \'multiverseid\': 429027}, {\'name\': \'胀颈好斗者\', \'text\': \'你可以于胀颈好斗者攻击时耗竭之。当你如此作时，它得+2/+2直到回合结束。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～那伽／战士\', \'flavor\': \'善使双匕的那伽都擅使罗纳斯之刺这一招式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429296&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52801bb7-2ac1-4d9c-807a-4c3d4666e558\', \'multiverseId\': 429296}, \'multiverseid\': 429296}, {\'name\': \'脹頸好鬥者\', \'text\': \'你可以於脹頸好鬥者攻擊時耗竭之。當你如此作時，它得+2/+2直到回合結束。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～那伽／戰士\', \'flavor\': \'善使雙匕的那伽都擅使羅納斯之刺這一招式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429565&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5eec9d9f-b55d-409b-aef8-380c05437b77\', \'multiverseId\': 429565}, \'multiverseid\': 429565}]', '[{\'name\': \'Schlachtfeld-Schurke\', \'text\': \'Du kannst den Schlachtfeld-Schurken erschöpfen, sowie er angreift. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\\nImmer wenn du eine Kreatur erschöpfst, kannst du eine Karte abwerfen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Schakal, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427089&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2f7a056-3ea6-4f41-8311-547b4b051534\', \'multiverseId\': 427089}, \'multiverseid\': 427089}, {\'name\': \'Saqueador del campo de batalla\', \'text\': \'Puedes espolear al Saqueador del campo de batalla en cuanto ataque. (No se enderezará durante tu próximo paso de enderezar.)\\nSiempre que espolees una criatura, puedes descartar una carta. Si lo haces, roba una carta.\', \'type\': \'Criatura — Bribón chacal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427358&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8ea1e943-f9cf-4011-9bc8-f836d6531341\', \'multiverseId\': 427358}, \'multiverseid\': 427358}, {\'name\': \'Charognard de campagne\', \'text\': "Vous pouvez surmener le Charognard de campagne au moment où il attaque. (Il ne se dégage pas pendant votre prochaine étape de dégagement.)\\nÀ chaque fois que vous surmenez une créature, vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : chacal et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427627&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'35a35383-7108-4fc8-8089-e9b9b2cc5b55\', \'multiverseId\': 427627}, \'multiverseid\': 427627}, {\'name\': \'Predone dei Campi di Battaglia\', \'text\': \'Puoi stremare il Predone dei Campi di Battaglia mentre attacca. (Non STAPperà durante il tuo prossimo STAP.)\\nOgniqualvolta stremi una creatura, puoi scartare una carta. Se lo fai, pesca una carta.\', \'type\': \'Creatura — Farabutto Sciacallo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427896&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd23a4ef-53f5-489b-9be0-abf088678787\', \'multiverseId\': 427896}, \'multiverseid\': 427896}, {\'name\': \'戦場のゴミあさり\', \'text\': \'戦場のゴミあさりが攻撃するに際し、あなたはこれを督励してもよい。（これはあなたの次のアンタップ・ステップにアンタップしない。）\\nあなたがクリーチャーを１体督励するたび、あなたはカード１枚を捨ててもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — ジャッカル・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428165&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57188bac-853a-4043-ae03-300343b87dfe\', \'multiverseId\': 428165}, \'multiverseid\': 428165}, {\'name\': \'전장 청소부\', \'text\': \'당신은 전장 청소부로 공격을 선언하면서 전장 청소부를 분전시킬 수 있다. (이 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\\n당신이 생물을 분전시킬 때마다, 당신은 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 자칼 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428434&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eefc71f9-fe8f-4f7c-a494-ee2eff5eba23\', \'multiverseId\': 428434}, \'multiverseid\': 428434}, {\'name\': \'Rapace dos Campos de Batalha\', \'text\': \'Você pode exaurir Rapace dos Campos de Batalha conforme ele ataca. (Ele não será desvirado durante sua próxima etapa de desvirar.)\\nToda vez que você exaure uma criatura, você pode descartar um card. Se fizer isso, compre um card.\', \'type\': \'Criatura — Chacal Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428703&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8740e632-a5e9-4827-991e-df8edf074d4e\', \'multiverseId\': 428703}, \'multiverseid\': 428703}, {\'name\': \'Мародер с Поля Битвы\', \'text\': \'Вы можете подстегнуть Мародера с Поля Битвы в момент его атаки. (Он не развернется во время вашего следующего шага разворота.)\\nКаждый раз, когда вы подстегиваете существо, вы можете сбросить карту. Если вы это делаете, возьмите карту.\', \'type\': \'Существо — Шакал Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428972&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea9e346c-5566-4f81-8573-b34dd4dfd311\', \'multiverseId\': 428972}, \'multiverseid\': 428972}, {\'name\': \'战场清理客\', \'text\': \'你可以于战场清理客攻击时耗竭之。（它于其操控者的下一个重置步骤中不能重置。）\\n每当你耗竭一个生物时，你可以弃一张牌。若你如此作，则抓一张牌。\', \'type\': \'生物～豺狼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429241&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ace135c3-51a8-43f9-9e33-08a88dedf22f\', \'multiverseId\': 429241}, \'multiverseid\': 429241}, {\'name\': \'戰場清理客\', \'text\': \'你可以於戰場清理客攻擊時耗竭之。（它於其操控者的下一個重置步驟中不能重置。）\\n每當你耗竭一個生物時，你可以棄一張牌。若你如此作，則抽一張牌。\', \'type\': \'生物～豺狼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429510&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'19b01510-0e7a-4bd4-bbd5-be1e33d550bd\', \'multiverseId\': 429510}, \'multiverseid\': 429510}]', '[{\'name\': \'Schlitterklinge\', \'text\': \'Die Schlitterklinge kann nicht geblockt werden.\', \'type\': \'Kreatur — Naga, Räuber\', \'flavor\': \'Mancher Naga-Geweihte bewegt sich so lautlos wie sein eigener Schatten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427042&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'baa753a0-cfd2-4ef9-8b7e-f7d0c52619de\', \'multiverseId\': 427042}, \'multiverseid\': 427042}, {\'name\': \'Filo reptante\', \'text\': \'El Filo reptante no puede ser bloqueado.\', \'type\': \'Criatura — Bribón naga\', \'flavor\': \'Algunos iniciados naga se mueven tan silenciosamente como los reflejos de los soles en el agua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427311&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'855dd4d4-81b7-4c46-aade-53a6ffc4665a\', \'multiverseId\': 427311}, \'multiverseid\': 427311}, {\'name\': \'Lame rampante\', \'text\': \'La Lame rampante ne peut pas être bloquée.\', \'type\': \'Créature : naga et gredin\', \'flavor\': "Certains adeptes nagas se déplacent aussi silencieusement que les rayons du soleil à la surface de l\'eau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427580&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e690034-77cf-4d3d-bc51-84f4892e7cf8\', \'multiverseId\': 427580}, \'multiverseid\': 427580}, {\'name\': \'Lama Strisciante\', \'text\': \'La Lama Strisciante non può essere bloccata.\', \'type\': \'Creatura — Farabutto Naga\', \'flavor\': "Alcuni iniziati naga sono silenziosi come i riflessi dei soli sull\'acqua.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427849&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'234dde84-187b-49de-befe-9df6960093d0\', \'multiverseId\': 427849}, \'multiverseid\': 427849}, {\'name\': \'這い寄る刃\', \'text\': \'這い寄る刃はブロックされない。\', \'type\': \'クリーチャー — ナーガ・ならず者\', \'flavor\': \'ナーガの修練者の中には、水に映る双陽のように音もなく動く者がいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428118&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f8a64c9d-1d79-4b6d-a357-2252a341a743\', \'multiverseId\': 428118}, \'multiverseid\': 428118}, {\'name\': \'기어 나아가는 검사\', \'text\': \'기어 나아가는 검사는 방어될 수 없다.\', \'type\': \'생물 — 나가 도적\', \'flavor\': \'어떤 나가 입회자는 물에 반사되는 햇빛처럼 고요하게 움직인다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428387&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3eefeb68-b5a3-49fb-8f73-eaf95a0aba31\', \'multiverseId\': 428387}, \'multiverseid\': 428387}, {\'name\': \'Lâmina Sinuosa\', \'text\': \'Lâmina Sinuosa não pode ser bloqueado.\', \'type\': \'Criatura — Naga Ladino\', \'flavor\': \'Alguns iniciados naga se movem tão silenciosamente quanto os reflexos dos sóis na água.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428656&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84756444-19c5-497a-8867-09579ad30cc5\', \'multiverseId\': 428656}, \'multiverseid\': 428656}, {\'name\': \'Скользящий Мечник\', \'text\': \'Скользящий Мечник не может быть заблокирован.\', \'type\': \'Существо — Нага Бродяга\', \'flavor\': \'Некоторые послушники-наги передвигаются бесшумно, словно отражения солнц на воде.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428925&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28db232d-d4c0-421b-8a3e-0d2195e78bc9\', \'multiverseId\': 428925}, \'multiverseid\': 428925}, {\'name\': \'蛇身刀客\', \'text\': \'蛇身刀客不能被阻挡。\', \'type\': \'生物～那伽／浪客\', \'flavor\': \'有些那伽祀徒移动时静如双日水中映影。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429194&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7fa3fa22-7d83-4383-bbf2-5cd12a15196e\', \'multiverseId\': 429194}, \'multiverseid\': 429194}, {\'name\': \'蛇身刀客\', \'text\': \'蛇身刀客不能被阻擋。\', \'type\': \'生物～那伽／浪客\', \'flavor\': \'有些那伽祀徒移動時靜如雙日水中映影。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429463&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'20ba8a9a-b05d-4836-a970-a8173b039830\', \'multiverseId\': 429463}, \'multiverseid\': 429463}]', '[{\'name\': \'Schluchtentümpel\', \'text\': \'({T}: Erhöhe deinen Manavorrat um {B} oder {R}.)\\nDer Schluchtentümpel kommt getappt ins Spiel.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Land — Sumpf, Gebirge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427210&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de6ab405-847c-4c72-b3d4-903621105086\', \'multiverseId\': 427210}, \'multiverseid\': 427210}, {\'name\': \'Cenagal del cañón\', \'text\': \'({T}: Agrega {B} o {R} a tu reserva de maná.)\\nEl Cenagal del cañón entra al campo de batalla girado.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Tierra — Pantano montaña\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427479&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b57a16f2-a487-406c-a100-589ed7b89ac5\', \'multiverseId\': 427479}, \'multiverseid\': 427479}, {\'name\': \'Canyon croupissant\', \'text\': \'({T} : Ajoutez {B} ou {R} à votre réserve.)\\nLe Canyon croupissant arrive sur le champ de bataille engagé.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Terrain : marais et montagne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427748&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e736c56b-f2fe-4c80-843e-b65ebb2b58f4\', \'multiverseId\': 427748}, \'multiverseid\': 427748}, {\'name\': \'Acquitrino del Canyon\', \'text\': "({T}: Aggiungi {B} o {R} alla tua riserva di mana.)\\nL\'Acquitrino del Canyon entra nel campo di battaglia TAPpato.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)", \'type\': \'Terra — Palude Montagna\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428017&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'571b8868-39c7-4ca3-9d2c-6777a4dc14aa\', \'multiverseId\': 428017}, \'multiverseid\': 428017}, {\'name\': \'泥濘の峡谷\', \'text\': \'（{T}：あなたのマナ・プールに{B}か{R}を加える。）\\n泥濘の峡谷はタップ状態で戦場に出る。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'土地 — 沼・山\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428286&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34d78d70-940e-4e0a-ba39-6f482edc7c15\', \'multiverseId\': 428286}, \'multiverseid\': 428286}, {\'name\': \'협곡 진창\', \'text\': \'({T}: {B}나 {R}를 당신의 마나풀에 담는다.)\\n협곡 진창은 탭된 상태로 전장에 들어온다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'대지 — 늪 산\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428555&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'64495c44-7e87-47f9-b702-cd5ae54c2ee0\', \'multiverseId\': 428555}, \'multiverseid\': 428555}, {\'name\': \'Lamaçal do Desfiladeiro\', \'text\': \'({T}: Adicione {B} ou {R} à sua reserva de mana.)\\nLamaçal do Desfiladeiro entra no campo de batalha virado.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Terreno — Pântano Montanha\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428824&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'865b32d0-5a60-44d6-950a-df93a852a77e\', \'multiverseId\': 428824}, \'multiverseid\': 428824}, {\'name\': \'Топь в Каньоне\', \'text\': \'({T}: добавьте {B} или {R} в ваше хранилище маны.)\\nТопь в Каньоне выходит на поле битвы повернутой.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Земля — Болото Гора\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429093&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dcc3b484-952a-4faf-a93a-63f604c9c835\', \'multiverseId\': 429093}, \'multiverseid\': 429093}, {\'name\': \'峡谷腐沼\', \'text\': \'（{T}：加{B}或{R}到你的法术力池中。）\\n峡谷腐沼须横置进战场。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'地～沼泽／山脉\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429362&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4ba2e6af-c12b-4063-8d05-9a9556e5506f\', \'multiverseId\': 429362}, \'multiverseid\': 429362}, {\'name\': \'峽谷腐沼\', \'text\': \'（{T}：加{B}或{R}到你的魔法力池中。）\\n峽谷腐沼須橫置進戰場。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'地～沼澤／山脈\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429631&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b58826a8-dded-48e6-8ab3-87a3d6f3a9a8\', \'multiverseId\': 429631}, \'multiverseid\': 429631}]', '[{\'name\': \'Schmerzhafte Lektion\', \'text\': \'Ein Spieler deiner Wahl zieht zwei Karten und verliert 2 Lebenspunkte.\', \'type\': \'Hexerei\', \'flavor\': \'„Du willst diese Lektion nicht vergessen? Hier, ich werde es dir aufschreiben." —Senifet, Wesir von Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427073&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc91cdae-ff34-41aa-a93e-4c5505a00ef1\', \'multiverseId\': 427073}, \'multiverseid\': 427073}, {\'name\': \'Lección dolorosa\', \'text\': \'El jugador objetivo roba dos cartas y pierde 2 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"¿Quieres recordar esta lección? La escribiré para ti". —Senifet, visir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427342&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f81cb50b-64e8-4b02-b1e3-471fa4e2d60f\', \'multiverseId\': 427342}, \'multiverseid\': 427342}, {\'name\': \'Leçon douloureuse\', \'text\': \'Le joueur ciblé pioche deux cartes et perd 2 points de vie.\', \'type\': \'Rituel\', \'flavor\': "« Vous voulez vous souvenir de cette leçon ? Je vais vous l\'écrire. » —Senifet, vizir de Bontu", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427611&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01b5b01f-9cbe-4185-b2d7-1ab8d985cb90\', \'multiverseId\': 427611}, \'multiverseid\': 427611}, {\'name\': \'Lezione Dolorosa\', \'text\': \'Un giocatore bersaglio pesca due carte e perde 2 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"Volete ricordare questa lezione? Ci penso io a scrivervela." —Senifet, visir di Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427880&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9c8f988c-fcde-4ed9-a60d-bb5a366f4941\', \'multiverseId\': 427880}, \'multiverseid\': 427880}, {\'name\': \'痛ましい教訓\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚引き、２点のライフを失う。\', \'type\': \'ソーサリー\', \'flavor\': \'「教訓を知りたいか？ならば書き付けてやろう。」 ――バントゥの侍臣、セニフェト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428149&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'99dfc55a-9c6a-4cb6-a62f-a1f1263d99dc\', \'multiverseId\': 428149}, \'multiverseid\': 428149}, {\'name\': \'고통스러운 수업\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 뽑고 생명 2점을 잃는다.\', \'type\': \'집중마법\', \'flavor\': \'"이 가르침을 기억하고 싶은가? 잊지 못하도록 적어주지." —본투의 고관 세니페트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428418&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ed3185d3-c80f-4ca9-984b-2b4d657c095e\', \'multiverseId\': 428418}, \'multiverseid\': 428418}, {\'name\': \'Lição Dolorosa\', \'text\': \'O jogador alvo compra dois cards e perde 2 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"Quer se lembrar dessa lição? Vou deixar escrito para você." — Senifet, vizir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428687&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8814a511-08de-478d-8fad-9eba6aa869dc\', \'multiverseId\': 428687}, \'multiverseid\': 428687}, {\'name\': \'Болезненный Урок\', \'text\': \'Целевой игрок берет две карты и теряет 2 жизни.\', \'type\': \'Волшебство\', \'flavor\': \'«Ты хочешь запомнить этот урок? Я запишу тебе его». — Сенифет, визирь Бонту\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428956&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1f68b71-1694-44b3-9bf2-3c0dffbbf54e\', \'multiverseId\': 428956}, \'multiverseid\': 428956}, {\'name\': \'惨痛教训\', \'text\': \'目标牌手抓两张牌且失去2点生命。\', \'type\': \'法术\', \'flavor\': \'「你想牢记这个教训？我帮你写下来。」 ～芭图维齐尔瑟尼法\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429225&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae35111f-65c2-44dd-9bd0-f6489396aeaf\', \'multiverseId\': 429225}, \'multiverseid\': 429225}, {\'name\': \'慘痛教訓\', \'text\': \'目標玩家抽兩張牌且失去2點生命。\', \'type\': \'巫術\', \'flavor\': \'「你想牢記這個教訓？我幫你寫下來。」 ～芭圖維齊爾瑟尼法\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429494&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'42d266f0-c35e-478a-98fd-3541c30b1279\', \'multiverseId\': 429494}, \'multiverseid\': 429494}]', '[{\'name\': \'Schmetterer der Ahn-Saat\', \'text\': \'Eile\\nDu kannst den Schmetterer der Ahn-Saat erschöpfen, sowie er angreift. Wenn du dies tust, kann eine Kreatur deiner Wahl in diesem Zug nicht blocken. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Minotaurus, Krieger\', \'flavor\': \'„Wer zögert, beginnt zu zweifeln. Um für das nächste Leben würdig zu sein, darf man niemals zurückblicken." —Anep, Wesir von Hazoret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427088&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'25d35cec-eceb-4c19-a1bc-42c98b62313a\', \'multiverseId\': 427088}, \'multiverseid\': 427088}, {\'name\': \'Embestidor de la simiente Ahn\', \'text\': \'Prisa.\\nPuedes espolear al Embestidor de la simiente Ahn en cuanto ataque. Cuando lo hagas, la criatura objetivo no puede bloquear este turno. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero minotauro\', \'flavor\': \'"La duda engendra disensión. Para ser digno del más allá, nunca mires atrás". —Anep, visir de Hazoret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427357&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b67814ee-ca57-41ca-8a63-e7251f2000c3\', \'multiverseId\': 427357}, \'multiverseid\': 427357}, {\'name\': \'Fracasseur de la moisson Ahn\', \'text\': \'Célérité\\nVous pouvez surmener le Fracasseur de la moisson Ahn au moment où il attaque. Quand vous faites ainsi, la créature ciblée ne peut pas bloquer ce tour-ci. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)\', \'type\': \'Créature : minotaure et guerrier\', \'flavor\': "« L\'hésitation est mère de conflits. Pour être dignes de l\'au-delà, ne regardez jamais en arrière. » —Anep, vizir d\'Hazoret", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427626&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'35cd9acd-4ee6-4fb6-8054-33b969e06557\', \'multiverseId\': 427626}, \'multiverseid\': 427626}, {\'name\': \'Distruttore della Messe Ahn\', \'text\': \'Rapidità\\nPuoi stremare il Distruttore della Messe Ahn mentre attacca. Quando lo fai, una creatura bersaglio non può bloccare in questo turno. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)\', \'type\': \'Creatura — Guerriero Minotauro\', \'flavor\': \'"L\\\'esitazione è fonte di dissenso. Se volete essere tra i prescelti per la prossima vita, non dovete mai guardarvi indietro." —Anep, visir di Hazoret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427895&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50a6657e-2286-443f-967a-485ed526fbff\', \'multiverseId\': 427895}, \'multiverseid\': 427895}, {\'name\': \'アン一門の壊し屋\', \'text\': \'速攻\\nアン一門の壊し屋が攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、クリーチャー１体を対象とする。このターン、それではブロックできない。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — ミノタウルス・戦士\', \'flavor\': \'「迷いは造反のもと。来世で英雄となりたければ振り返ってはならない。」 ――ハゾレトの侍臣、アネプ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428164&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e43b9eef-6fb4-4365-9015-551960ffc45f\', \'multiverseId\': 428164}, \'multiverseid\': 428164}, {\'name\': \'안 입문자 파괴자\', \'text\': \'신속\\n당신은 안 입문자 파괴자로 공격을 선언하면서 안 입문자 파괴자를 분전시킬 수 있다. 그렇게 할 때, 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 미노타우로스 전사\', \'flavor\': \'"망설임은 불화를 낳는다. 사후 세계에 가려면 절대 뒤돌아 보지 마라." —하조렛의 고관 아넵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428433&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b4e5f3f3-6512-434e-9594-60e3e9d6b626\', \'multiverseId\': 428433}, \'multiverseid\': 428433}, {\'name\': \'Demolidor da Safra Ahn\', \'text\': \'Ímpeto\\nVocê pode exaurir Demolidor da Safra Ahn conforme ele ataca. Quando você faz isso, a criatura alvo não pode bloquear neste turno. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Minotauro Guerreiro\', \'flavor\': \'"Hesitação gera dissensão. Para ser digno da próxima vida, você jamais deve olhar para trás." — Anep, vizir de Hazoret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428702&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4679f21-a47e-453f-a052-36acbcd78607\', \'multiverseId\': 428702}, \'multiverseid\': 428702}, {\'name\': \'Громила Снопа Ан\', \'text\': \'Ускорение\\nВы можете подстегнуть Громилу Снопа Ан в момент его атаки. Когда вы это делаете, целевое существо не может блокировать в этом ходу. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Минотавр Воин\', \'flavor\': \'«Сомнения ведут к инакомыслию. Чтобы оказаться достойным новой жизни, нельзя оглядываться назад». — Анеп, визирь Хазорет\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428971&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e56b933e-6603-4b17-b6ae-3f8846fee061\', \'multiverseId\': 428971}, \'multiverseid\': 428971}, {\'name\': \'阿恩祀群粉碎者\', \'text\': \'敏捷\\n你可以于阿恩祀群粉碎者攻击时耗竭之。当你如此作时，目标生物本回合不能进行阻挡。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～牛头怪／战士\', \'flavor\': \'「犹豫生杂议。若想配得上拥有来世，必须勇往向前。」 ～哈佐蕾维齐尔阿内普\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429240&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7badfa1c-ab6b-45da-9bb8-b33b34223f44\', \'multiverseId\': 429240}, \'multiverseid\': 429240}, {\'name\': \'阿恩祀群粉碎者\', \'text\': \'敏捷\\n你可以於阿恩祀群粉碎者攻擊時耗竭之。當你如此作時，目標生物本回合不能進行阻擋。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～牛頭怪／戰士\', \'flavor\': \'「猶豫生雜議。若想配得上擁有來世，必須勇往向前。」 ～哈佐蕾維齊爾阿內普\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429509&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'29964feb-798e-4f7b-8f61-e065724d4e1c\', \'multiverseId\': 429509}, \'multiverseid\': 429509}]', "[{'name': 'Schneiden // Stücke', 'text': 'Schneiden fügt einer Kreatur deiner Wahl 4 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': None, 'faceName': 'Schneiden', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427194&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a439603c-a0a2-49c2-930e-ef7f2da67f7d', 'multiverseId': 427194}, 'multiverseid': 427194}, {'name': 'Cortar // Trozos', 'text': 'Cortar hace 4 puntos de daño a la criatura objetivo.', 'type': 'Conjuro', 'flavor': None, 'faceName': 'Cortar', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427463&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1832a78e-3b6e-4579-9d6c-2dda99a30648', 'multiverseId': 427463}, 'multiverseid': 427463}, {'name': 'Couper // Morceaux', 'text': 'Couper inflige 4 blessures à une créature ciblée.', 'type': 'Rituel', 'flavor': None, 'faceName': 'Couper', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427732&type=card', 'language': 'French', 'identifiers': {'scryfallId': '47453680-ec29-4f1e-b53a-3d2cf887b7d2', 'multiverseId': 427732}, 'multiverseid': 427732}, {'name': 'Tagliare // Fette', 'text': 'Tagliare infligge 4 danni a una creatura bersaglio.', 'type': 'Stregoneria', 'flavor': None, 'faceName': 'Tagliare', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428001&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '35652dc1-2f73-4312-8bbd-7941bc078c00', 'multiverseId': 428001}, 'multiverseid': 428001}, {'name': '木端 // 微塵', 'text': 'クリーチャー１体を対象とする。木端はそれに４点のダメージを与える。', 'type': 'ソーサリー', 'flavor': None, 'faceName': '木端', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428270&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '29364756-57aa-438f-a73d-8f403f340df4', 'multiverseId': 428270}, 'multiverseid': 428270}, {'name': '절단 // 띠', 'text': '생물을 목표로 정한다. 절단은 그 생물에게 피해 4점을 입힌다.', 'type': '집중마법', 'flavor': None, 'faceName': '절단', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428539&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '00031562-3818-49f9-b45c-ab28a521284c', 'multiverseId': 428539}, 'multiverseid': 428539}, {'name': 'Cortar // Pedaços', 'text': 'Cortar causa 4 pontos de dano à criatura alvo.', 'type': 'Feitiço', 'flavor': None, 'faceName': 'Cortar', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428808&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '681fec87-8fee-45eb-b6dd-90240d743a5b', 'multiverseId': 428808}, 'multiverseid': 428808}, {'name': 'Изрубить // В Куски', 'text': 'Изрубить наносит 4 повреждения целевому существу.', 'type': 'Волшебство', 'flavor': None, 'faceName': 'Изрубить', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429077&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3ebd342f-405b-450f-81ba-5ac28ddae345', 'multiverseId': 429077}, 'multiverseid': 429077}, {'name': '割斩 // 碎身', 'text': '割斩对目标生物造成4点伤害。', 'type': '法术', 'flavor': None, 'faceName': '割斩', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429346&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1f690f54-00f3-40b2-abf6-6c1bddf372cb', 'multiverseId': 429346}, 'multiverseid': 429346}, {'name': '割斬 // 碎身', 'text': '割斬對目標生物造成4點傷害。', 'type': '巫術', 'flavor': None, 'faceName': '割斬', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429615&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6f197e56-2717-47c3-8fa0-36ef19496f40', 'multiverseId': 429615}, 'multiverseid': 429615}]", '[{\'name\': \'Schrecken der Splitterwüste\', \'text\': \'Immer wenn du eine andere Karte umwandelst oder abwirfst, erhält der Schrecken der Splitterwüste +2/+1 bis zum Ende des Zuges.\\nUmwandlung {B} ({B}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Es ernährt sich von den trockenen Knochen im Sand und den verzweifelten Hilfeschreien im Wind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427066&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e024ecb-ad6b-4e68-9cda-35eb34ee52ae\', \'multiverseId\': 427066}, \'multiverseid\': 427066}, {\'name\': \'Horror de las Tierras Desoladas\', \'text\': \'Siempre que actives una habilidad de ciclo o descartes otra carta, el Horror de las Tierras Desoladas obtiene +2/+1 hasta el final del turno.\\nCiclo {B}. ({B}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Horror\', \'flavor\': \'Se alimenta de los huesos secos que cubren la arena y de las súplicas desesperadas que lleva el viento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7e76b56-ee7e-4b52-8d7b-46ec11e775f0\', \'multiverseId\': 427335}, \'multiverseid\': 427335}, {\'name\': \'Horreur des terres brisées\', \'text\': "À chaque fois que vous recyclez ou vous défaussez d\'une autre carte, l\'Horreur des terres brisées gagne +2/+1 jusqu\'à la fin du tour.\\nRecyclage {B} ({B}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Créature : horreur\', \'flavor\': \'Elle se nourrit des os desséchés enfouis dans le sable et des appels désespérés portés par le vent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427604&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b4607a1-1243-42e5-bd7e-6e73bd1ca42e\', \'multiverseId\': 427604}, \'multiverseid\': 427604}, {\'name\': \'Orrore delle Terre Spezzate\', \'text\': "Ogniqualvolta cicli o scarti un\'altra carta, l\'Orrore delle Terre Spezzate prende +2/+1 fino alla fine del turno.\\nCiclo {B} ({B}, Scarta questa carta: Pesca una carta.)", \'type\': \'Creatura — Orrore\', \'flavor\': \'Si nutre di ossa disseccate sepolte nella sabbia e di suppliche disperate trasportate dal vento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427873&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'defe789c-3e32-41ab-9dca-45344df50f50\', \'multiverseId\': 427873}, \'multiverseid\': 427873}, {\'name\': \'遺棄地の恐怖\', \'text\': \'あなたが他のカードを１枚サイクリングするか捨てるたび、ターン終了時まで、遺棄地の恐怖は＋２/＋１の修整を受ける。\\nサイクリング{B}（{B}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'砂に埋もれる干からびた骨と風に紛れる断末魔の悲鳴を糧にする。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428142&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4601dd4c-fbe8-4f23-a8a5-1717f9604559\', \'multiverseId\': 428142}, \'multiverseid\': 428142}, {\'name\': \'망가진 땅의 괴수\', \'text\': \'당신이 다른 카드를 순환하거나 버릴 때마다, 망가진 땅의 괴수는 턴종료까지 +2/+1을 받는다.\\n순환 {B} ({B}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 괴수\', \'flavor\': \'이 놈의 주식은 모래에 묻힌 마른 뼈와 바람을 타고 들리는 절망적인 애원 소리다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428411&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d57f6bbd-58f5-41b6-8cd8-f49676216151\', \'multiverseId\': 428411}, \'multiverseid\': 428411}, {\'name\': \'Horror das Terras Partidas\', \'text\': \'Toda vez que você recicla ou descarta outro card, Horror das Terras Partidas recebe +2/+1 até o final do turno.\\nReciclar {B} ({B}, Descarte este card: Compre um card.)\', \'type\': \'Criatura — Horror\', \'flavor\': \'Ele se alimenta de ossos secos na areia e apelos desesperados no vento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428680&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f28b3a4-5277-4b1b-9f00-616d24f0e693\', \'multiverseId\': 428680}, \'multiverseid\': 428680}, {\'name\': \'Ужас Смятенных Земель\', \'text\': \'Каждый раз, когда вы совершаете Цикл другой карты или сбрасываете другую карту, Ужас Смятенных Земель получает +2/+1 до конца хода.\\nЦикл {B} ({B}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Ужас\', \'flavor\': \'Его пища — иссохшие кости в песке и отчаянные мольбы на ветру.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428949&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'32c43e2f-4942-4a7e-a82f-14842a812ef8\', \'multiverseId\': 428949}, \'multiverseid\': 428949}, {\'name\': \'荒土惊惧怪\', \'text\': \'每当你循环或弃另一张牌时，荒土惊惧怪得+2/+1直到回合结束。\\n循环{B}（{B}，弃掉此牌：抓一张牌。）\', \'type\': \'生物～惊惧兽\', \'flavor\': \'它以沙漠中的枯骨和风中的绝望求救为食。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429218&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'292839c9-5098-4ebd-9b10-d0e8673d523c\', \'multiverseId\': 429218}, \'multiverseid\': 429218}, {\'name\': \'荒土驚懼怪\', \'text\': \'每當你循環或棄另一張牌時，荒土驚懼怪得+2/+1直到回合結束。\\n循環{B}（{B}，棄掉此牌：抽一張牌。）\', \'type\': \'生物～驚懼獸\', \'flavor\': \'它以沙漠中的枯骨和風中的絕望求救為食。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429487&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f51b1aa5-cf6a-4d38-9dbf-20e6bd81f846\', \'multiverseId\': 429487}, \'multiverseid\': 429487}]', '[{\'name\': \'Schreiberin des Achtsamen\', \'text\': \'{1}, {T}, opfere die Schreiberin des Achtsamen: Bringe eine Spontanzauber- oder Hexerei-Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Die besten Antworten lösen mehr als nur ein Rätsel." —Kefnet, Gott des Wissens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427039&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'159b1c85-c95a-4882-9e16-0eae2e70dbe9\', \'multiverseId\': 427039}, \'multiverseid\': 427039}, {\'name\': \'Escriba del Conocedor\', \'text\': \'{1}, {T}, sacrificar a la Escriba del Conocedor: Regresa la carta de instantáneo o de conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Las mejores respuestas resuelven más de un acertijo". —Kefnet, dios del conocimiento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427308&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a6b2329-b92d-4749-a224-a17468ddad95\', \'multiverseId\': 427308}, \'multiverseid\': 427308}, {\'name\': \'Scribe du Clairvoyant\', \'text\': "{1}, {T}, sacrifiez la Scribe du Clairvoyant : Renvoyez une carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : humain et clerc\', \'flavor\': "« Les meilleures réponses résolvent plus d\'une énigme. » —Kefnet, dieu de la Connaissance", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427577&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'71d04b5f-84c5-4896-b8a8-27745794b375\', \'multiverseId\': 427577}, \'multiverseid\': 427577}, {\'name\': \'Scriba del Ponderante\', \'text\': \'{1}, {T}, Sacrifica la Scriba del Ponderante: Riprendi in mano una carta istantaneo o stregoneria bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Le risposte migliori risolvono più di un enigma." —Kefnet, dio della conoscenza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427846&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b802f69c-55b8-4af2-838a-80c55f643453\', \'multiverseId\': 427846}, \'multiverseid\': 427846}, {\'name\': \'周到の書記官\', \'text\': \'{1}, {T}, 周到の書記官を生け贄に捧げる：あなたの墓地からインスタント・カード１枚かソーサリー・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「最良の答えは多数の謎を解く。」 ――知識の神、ケフネト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428115&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7ec54c8d-b2e4-4dc6-a922-f0599ec6df04\', \'multiverseId\': 428115}, \'multiverseid\': 428115}, {\'name\': \'신중의 서기\', \'text\': \'{1}, {T}, 신중의 서기를 희생한다: 당신의 무덤에 있는 순간마법 또는 집중마법 카드를 목표로 정한다. 그 목표를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"최고의 답은 한 번에 여러 수수께끼를 해결한다." —지식의 신 케프넷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428384&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3d738a02-26f6-479b-ba06-72368a11b222\', \'multiverseId\': 428384}, \'multiverseid\': 428384}, {\'name\': \'Escriba do Consciente\', \'text\': \'{1}, {T}, Sacrifique Escriba do Consciente: Devolva o card de mágica instantânea ou feitiço alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"As melhores respostas resolvem mais de um enigma." — Kefnet, deus do conhecimento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428653&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d5ef3d2-39be-4786-b84d-942c03ebd483\', \'multiverseId\': 428653}, \'multiverseid\': 428653}, {\'name\': \'Переписчица Всеведущего\', \'text\': \'{1}, {T}, пожертвуйте Переписчицу Всеведущего: верните целевую карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Самые лучшие ответы подходят к нескольким загадкам». — Кефнет, бог знания\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428922&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9ae70c52-6c68-430b-94a0-b0d184c4c226\', \'multiverseId\': 428922}, \'multiverseid\': 428922}, {\'name\': \'心智神书吏\', \'text\': \'{1}，{T}，牺牲心智神书吏：将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「最好的谜底能解答数个谜语。」 ～知识之神刻法涅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429191&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cddf0621-c5a0-458c-985c-a5b94232fc03\', \'multiverseId\': 429191}, \'multiverseid\': 429191}, {\'name\': \'心智神書吏\', \'text\': \'{1}，{T}，犧牲心智神書吏：將目標瞬間或巫術牌從你的墳墓場移回你手上。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'「最好的謎底能解答數個謎語。」 ～知識之神刻法涅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429460&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'787f3697-bf1f-436b-96f9-f8b2e077928d\', \'multiverseId\': 429460}, \'multiverseid\': 429460}]', '[{\'name\': \'Schwäche abstreifen\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Du kannst eine -1/-1-Marke von ihr entfernen.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Naga häuten sich vor der Prüfung der Stärke und lassen damit neben ihren Narben auch ihre Zweifel und Ängste zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427156&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'da6c0302-1e74-4f2e-96be-8c84371c754a\', \'multiverseId\': 427156}, \'multiverseid\': 427156}, {\'name\': \'Debilidades erradicadas\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Puedes remover un contador -1/-1 de ella.\', \'type\': \'Instantáneo\', \'flavor\': \'Con objetivo de prepararse para la Prueba de fuerza, los naga mudan su piel, junto con sus cicatrices, sus dudas y sus miedos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427425&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84224693-cd31-4d23-aa32-35b653b6692d\', \'multiverseId\': 427425}, \'multiverseid\': 427425}, {\'name\': \'Faiblesse en mue\', \'text\': "La créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Vous pouvez lui retirer un marqueur -1/-1.", \'type\': \'Éphémère\', \'flavor\': "Pour se préparer à l\'Épreuve de force, les nagas font peau neuve, et ce faisant, se débarrassent de leurs cicatrices, de leurs doutes et de leurs peurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427694&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdc5806b-4fb5-4b14-ac2c-5d748365f67f\', \'multiverseId\': 427694}, \'multiverseid\': 427694}, {\'name\': \'Muta della Debolezza\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Puoi rimuovere un segnalino -1/-1 da essa.\', \'type\': \'Istantaneo\', \'flavor\': "Per prepararsi ad affrontare l\'Ordalia della Forza, i naga cambiano la loro vecchia pelle, insieme alla quale si liberano anche di cicatrici, dubbi e timori.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427963&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83b817c5-5744-4853-a207-ca183dd9a800\', \'multiverseId\': 427963}, \'multiverseid\': 427963}, {\'name\': \'弱さからの脱皮\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。あなたはそれの上から－１/－１カウンターを１個取り除いてもよい。\', \'type\': \'インスタント\', \'flavor\': \'活力の試練に備えてナーガは古い皮を脱ぎ捨てる。傷跡や疑念や恐怖も同時に払い落す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428232&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa6486f5-0f48-432f-bba1-bf1fc2ea9bf1\', \'multiverseId\': 428232}, \'multiverseid\': 428232}, {\'name\': \'약점 제거\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 당신은 그 생물에서 -1/-1 카운터 한 개를 제거할 수 있다.\', \'type\': \'순간마법\', \'flavor\': \'힘의 시험을 준비하기 위해 나가들은 허물과 함께 상처, 의심, 두려움을 벗는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428501&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2cb0bfd-0b86-4ee9-8357-0e04fb4c4835\', \'multiverseId\': 428501}, \'multiverseid\': 428501}, {\'name\': \'Eliminar Fraqueza\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Você pode remover um marcador -1/-1 dela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Para se preparar para a Prova da Força, as nagas descartam sua antiga pele —e com ela as cicatrizes, as dúvidas e os medos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428770&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d174c4d-392e-4810-8c6e-5ff6a7858214\', \'multiverseId\': 428770}, \'multiverseid\': 428770}, {\'name\': \'Сбросить Слабость\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Вы можете удалить с него один жетон -1/-1.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Чтобы подготовиться к испытанию силы, наги сбрасывают старую кожу, а с ней — свои шрамы, сомнения и страхи.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429039&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd7a4cf6-8cc6-4189-9c1d-bf642ee4effc\', \'multiverseId\': 429039}, \'multiverseid\': 429039}, {\'name\': \'褪去弱肤\', \'text\': \'目标生物得+2/+2直到回合结束。你可以从其上移去一个-1/-1指示物。\', \'type\': \'瞬间\', \'flavor\': \'为准备力量祀炼，那伽会将一身旧皮蜕去～一同蜕去的还有过往伤痕，心中疑虑，以及所有恐惧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429308&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d630b9e4-edf2-4dc3-b398-d6db26a1d401\', \'multiverseId\': 429308}, \'multiverseid\': 429308}, {\'name\': \'褪去弱膚\', \'text\': \'目標生物得+2/+2直到回合結束。你可以從其上移去一個-1/-1指示物。\', \'type\': \'瞬間\', \'flavor\': \'為準備力量祀煉，那伽會將一身舊皮蛻去～一同蛻去的還有過往傷痕，心中疑慮，以及所有恐懼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429577&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a18fa305-60fc-4b6b-8e4b-6e1d9e0ac3af\', \'multiverseId\': 429577}, \'multiverseid\': 429577}]', '[{\'name\': \'Sechster Sinn\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat „Immer wenn diese Kreatur einem Spieler Kampfschaden zufügt, kannst du eine Karte ziehen."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Manche Einsicht wird durch Instinkte gewonnen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427158&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29d3db82-9837-458b-b2bf-950d114221de\', \'multiverseId\': 427158}, \'multiverseid\': 427158}, {\'name\': \'Sexto sentido\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "Siempre que esta criatura haga daño de combate a un jugador, puedes robar una carta".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El instinto abre paso a la verdadera perspicacia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18a07418-f60a-4118-a30a-9277ad54613c\', \'multiverseId\': 427427}, \'multiverseid\': 427427}, {\'name\': \'Sixième sens\', \'text\': \'Enchanter : créature\\nLa créature enchantée a « À chaque fois que cette créature inflige des blessures de combat à un joueur, vous pouvez piocher une carte. »\', \'type\': \'Enchantement : aura\', \'flavor\': "L\'instinct donne lieu à l\'intuition la plus juste.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427696&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b37ee524-bb5b-45ec-befa-0dc3afb5d26e\', \'multiverseId\': 427696}, \'multiverseid\': 427696}, {\'name\': \'Sesto Senso\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "Ogniqualvolta questa creatura infligge danno da combattimento a un giocatore, puoi pescare una carta".\', \'type\': \'Incantesimo — Aura\', \'flavor\': "La miglior percezione è quella dell\'istinto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427965&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e5aec402-011d-4e09-b046-36c17f603011\', \'multiverseId\': 427965}, \'multiverseid\': 427965}, {\'name\': \'第六感\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは「このクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、あなたはカードを１枚引いてもよい。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'直感は真の洞察を生む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428234&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80d6ffcc-10dd-40ca-8119-28da77201b95\', \'multiverseId\': 428234}, \'multiverseid\': 428234}, {\'name\': \'육감\', \'text\': \'생물에게 부여\\n부여된 생물은 "이 생물이 플레이어에게 전투피해를 입힐 때마다, 당신은 카드 한 장을 뽑을 수 있다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'본능은 진정한 통찰력을 낳는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428503&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f32494e6-0aff-4be8-887a-9b75dbf1d091\', \'multiverseId\': 428503}, \'multiverseid\': 428503}, {\'name\': \'Sexto Sentido\', \'text\': \'Encantar criatura\\nA criatura encantada tem "Toda vez que esta criatura causa dano de combate a um jogador, você pode comprar um card."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Os instintos fornecem a visão mais verdadeira.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428772&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c30003d2-55e6-4539-a907-e651d7a0d13f\', \'multiverseId\': 428772}, \'multiverseid\': 428772}, {\'name\': \'Шестое Чувство\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность «Каждый раз, когда это существо наносит боевые повреждения игроку, вы можете взять карту».\', \'type\': \'Чары — Аура\', \'flavor\': \'Инстинкты порождают самые надежные озарения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429041&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de17c12c-a7a6-4573-81b2-78490b1b7b93\', \'multiverseId\': 429041}, \'multiverseid\': 429041}, {\'name\': \'第六感\', \'text\': \'结附于生物\\n所结附的生物具有「每当此生物对任一牌手造成战斗伤害时，你可以抓一张牌。」\', \'type\': \'结界～灵气\', \'flavor\': \'最真切的预示源自本能。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429310&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8367ac8c-9462-4902-9bfa-4fd207c25e01\', \'multiverseId\': 429310}, \'multiverseid\': 429310}, {\'name\': \'第六感\', \'text\': \'結附於生物\\n所結附的生物具有「每當此生物對任一玩家造成戰鬥傷害時，你可以抽一張牌。」\', \'type\': \'結界～靈氣\', \'flavor\': \'最真切的預示源自本能。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429579&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8f0e9cb-1ba6-4bf5-90cb-dea238741add\', \'multiverseId\': 429579}, \'multiverseid\': 429579}]', "[{'name': 'Seelendurchstecher', 'text': 'Wenn der Seelendurchstecher ins Spiel kommt, lege zwei -1/-1-Marken auf eine Kreatur deiner Wahl, die du kontrollierst.\\nWenn der Seelendurchstecher stirbt, kannst du für jede -1/-1-Marke auf ihm eine -1/-1-Marke auf eine Kreatur deiner Wahl legen.', 'type': 'Kreatur — Skorpion, Dämon', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427079&type=card', 'language': 'German', 'identifiers': {'scryfallId': '173521bb-0625-4bff-82b4-4d76ed5c6a40', 'multiverseId': 427079}, 'multiverseid': 427079}, {'name': 'Aguijoneador de almas', 'text': 'Cuando el Aguijoneador de almas entre al campo de batalla, pon dos contadores -1/-1 sobre la criatura objetivo que controlas.\\nCuando el Aguijoneador de almas muera, puedes poner un contador -1/-1 sobre la criatura objetivo por cada contador -1/-1 sobre el Aguijoneador de almas.', 'type': 'Criatura — Demonio escorpión', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427348&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c65cf8c1-8962-475b-966d-47ed9065ef0f', 'multiverseId': 427348}, 'multiverseid': 427348}, {'name': 'Pique-âme', 'text': 'Quand le Pique-âme arrive sur le champ de bataille, mettez deux marqueurs -1/-1 sur une créature ciblée que vous contrôlez.\\nQuand le Pique-âme meurt, vous pouvez mettre un marqueur -1/-1 sur une créature ciblée pour chaque marqueur -1/-1 sur le Pique-âme.', 'type': 'Créature : scorpion et démon', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427617&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'da1e396c-c462-4512-847f-4f861036a21d', 'multiverseId': 427617}, 'multiverseid': 427617}, {'name': 'Pungitore di Anime', 'text': 'Quando il Pungitore di Anime entra nel campo di battaglia, metti due segnalini -1/-1 su una creatura bersaglio che controlli.\\nQuando il Pungitore di Anime muore, puoi mettere un segnalino -1/-1 su una creatura bersaglio per ogni segnalino -1/-1 sul Pungitore di Anime.', 'type': 'Creatura — Demone Scorpione', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427886&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '50f9d28a-70e8-48cc-a6d6-aca71ce2d7d8', 'multiverseId': 427886}, 'multiverseid': 427886}, {'name': '魂刺し', 'text': '魂刺しが戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを２個置く。\\n魂刺しが死亡したとき、クリーチャー１体を対象とする。あなたはそれの上に－１/－１カウンターを、魂刺しの上に置かれていた－１/－１カウンター１個につき１個置いてもよい。', 'type': 'クリーチャー — 蠍・デーモン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428155&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '84fb48b7-a775-43ba-9fa7-0953d645e6eb', 'multiverseId': 428155}, 'multiverseid': 428155}, {'name': '영혼칼침꾼', 'text': '영혼칼침꾼이 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 두 개를 올려놓는다.\\n영혼칼침꾼이 죽을 때, 생물을 목표로 정한다. 당신은 영혼칼침꾼에 올려진 -1/-1 카운터 수만큼 그 생물에 -1/-1 카운터를 올려놓을 수 있다.', 'type': '생물 — 전갈 악마', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428424&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9c01c1d0-39f8-49a0-8616-f1dd656c7aa1', 'multiverseId': 428424}, 'multiverseid': 428424}, {'name': 'Picador de Almas', 'text': 'Quando Picador de Almas entrar no campo de batalha, coloque dois marcadores -1/-1 na criatura alvo que você controla.\\nQuando Picador de Almas morre, você pode colocar um marcador -1/-1 na criatura alvo para cada marcador -1/-1 em Picador de Almas.', 'type': 'Criatura — Escorpião Demônio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428693&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bc4aa39f-f52a-49b6-8726-74cc08c91876', 'multiverseId': 428693}, 'multiverseid': 428693}, {'name': 'Уязвитель Душ', 'text': 'Когда Уязвитель Душ выходит на поле битвы, положите два жетона -1/-1 на целевое существо под вашим контролем.\\nКогда Уязвитель Душ умирает, вы можете положить один жетон -1/-1 на целевое существо за каждый жетон 1/-1 на Уязвителе Душ.', 'type': 'Существо — Скорпион Демон', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428962&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd1170a7c-8186-498b-8200-8d45ccbd91a5', 'multiverseId': 428962}, 'multiverseid': 428962}, {'name': '刺灵魔', 'text': '当刺灵魔进战场时，在目标由你操控的生物上放置两个-1/-1指示物。\\n当刺灵魔死去时，你可以在目标生物上放置若干-1/-1指示物，其数量等同于刺灵魔上-1/-1指示物的数量。', 'type': '生物～蝎子／恶魔', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429231&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a35a6c93-2ce2-45ad-abe3-bcb6973c426c', 'multiverseId': 429231}, 'multiverseid': 429231}, {'name': '刺靈魔', 'text': '當刺靈魔進戰場時，在目標由你操控的生物上放置兩個-1/-1指示物。\\n當刺靈魔死去時，你可以在目標生物上放置若干-1/-1指示物，其數量等同於刺靈魔上-1/-1指示物的數量。', 'type': '生物～蠍子／惡魔', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429500&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '950ae1e1-aa07-4842-9c8e-8578139fe074', 'multiverseId': 429500}, 'multiverseid': 429500}]", '[{\'name\': \'Seelennarben-Magier\', \'text\': \'Bravour\\nFalls eine Quelle, die du kontrollierst, einer Kreatur, die ein Gegner kontrolliert, Schaden zufügen würde, der kein Kampfschaden ist, lege stattdessen entsprechend viele -1/-1-Marken auf die Kreatur.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427119&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9998d8e-21df-49cb-a5da-af28a08a0c0d\', \'multiverseId\': 427119}, \'multiverseid\': 427119}, {\'name\': \'Mago zaheridor de almas\', \'text\': \'Destreza.\\nSi una fuente que controlas fuera a hacer daño que no sea de combate a una criatura que controla un oponente, en vez de eso, pon esa misma cantidad de contadores -1/-1 sobre esa criatura.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427388&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'431a14d1-dfd3-4fe1-86f9-72359b633c7e\', \'multiverseId\': 427388}, \'multiverseid\': 427388}, {\'name\': \'Mage scarifiâme\', \'text\': "Prouesse\\nSi une source que vous contrôlez devait infliger des blessures non-combat à une créature qu\'un adversaire contrôle, mettez autant de marqueurs -1/-1 sur cette créature à la place.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427657&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55c5cc05-022d-4072-bc88-cb2c49d63a12\', \'multiverseId\': 427657}, \'multiverseid\': 427657}, {\'name\': \'Mago Sfregiaspirito\', \'text\': \'prodezza\\nSe una fonte che controlli sta per infliggere danno non da combattimento a una creatura controllata da un avversario, metti invece altrettanti segnalini -1/-1 su quella creatura.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427926&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6af559d-679d-4aca-b605-841b171fccb9\', \'multiverseId\': 427926}, \'multiverseid\': 427926}, {\'name\': \'損魂魔道士\', \'text\': \'果敢\\nあなたがコントロールする発生源が対戦相手がコントロールするクリーチャーに戦闘ダメージでないダメージを与えるなら、代わりにその点数に等しい数の－１/－１カウンターをそのクリーチャーの上に置く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428195&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e722e538-c70d-41e3-a69a-c4b098b756a8\', \'multiverseId\': 428195}, \'multiverseid\': 428195}, {\'name\': \'영혼난도 마도사\', \'text\': \'기량\\n당신이 조종하는 원천이 상대가 조종하는 생물에게 비전투피해를 입히려고 한다면, 대신에 그 생물에 그만큼의 -1/-1 카운터를 올려놓는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428464&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f680d704-467f-42a0-9d93-16ec7130a19c\', \'multiverseId\': 428464}, \'multiverseid\': 428464}, {\'name\': \'Mago Escarificador de Almas\', \'text\': \'Destreza\\nSe uma fonte que você controla causaria dano que não seja de combate a uma criatura que um oponente controla, em vez disso, coloque aquela quantidade de marcadores -1/-1 naquela criatura.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428733&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7906e5fd-728d-4a06-ae0b-b55b68258454\', \'multiverseId\': 428733}, \'multiverseid\': 428733}, {\'name\': \'Маг-Душегубитель\', \'text\': \'Искусность\\nЕсли источник под вашим контролем должен нанести небоевые повреждения существу под контролем оппонента, вместо этого положите на то существо такое же количество жетонов -1/-1.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429002&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9e2394d3-8662-4fa3-9efc-b0691440536f\', \'multiverseId\': 429002}, \'multiverseid\': 429002}, {\'name\': \'灼灵法师\', \'text\': \'灵技\\n如果由你操控的某来源将对任一由对手操控的生物造成非战斗伤害，则改为在该生物上放置等量的-1/-1指示物。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429271&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d84435f6-edb1-4adc-8b64-377ceaad80f0\', \'multiverseId\': 429271}, \'multiverseid\': 429271}, {\'name\': \'灼靈法師\', \'text\': \'靈技\\n如果由你操控的某來源將對任一由對手操控的生物造成非戰鬥傷害，則改為在該生物上放置等量的-1/-1指示物。\', \'type\': \'生物～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429540&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'68366638-6040-478c-85c4-5378d3487934\', \'multiverseId\': 429540}, \'multiverseid\': 429540}]', '[{\'name\': \'Segen des Luxa\', \'text\': \'Entferne zu Beginn deiner Hauptphase vor dem Kampf alle Flutmarken vom Segen des Luxa. Falls auf diese Weise keine Marke entfernt wurde, lege eine Flutmarke auf den Segen des Luxa und ziehe ein Karte. Erhöhe sonst deinen Manavorrat um {C}{G}{U}.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427167&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e87854a0-6bdc-40f8-8289-0488ceb4ebcc\', \'multiverseId\': 427167}, \'multiverseid\': 427167}, {\'name\': \'Abundancia del Luxa\', \'text\': \'Al comienzo de tu fase principal precombate, remueve todos los contadores de inundación de la Abundancia del Luxa. Si no se removieron contadores de esta manera, pon un contador de inundación sobre la Abundancia del Luxa y roba una carta. De lo contrario, agrega {C}{G}{U} a tu reserva de maná.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427436&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'16f8f040-9e15-472b-816d-99842b00c7e5\', \'multiverseId\': 427436}, \'multiverseid\': 427436}, {\'name\': \'Don du Luxa\', \'text\': "Au début de votre première phase principale, retirez tous les marqueurs « inondation » du Don du Luxa. Si aucun marqueur n\'a été retiré de cette manière, mettez un marqueur « inondation » sur le Don du Luxa et piochez une carte. Sinon, ajoutez {C}{G}{U} à votre réserve.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427705&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a05ff7f7-be41-47a4-9fda-f7c2912ad5b2\', \'multiverseId\': 427705}, \'multiverseid\': 427705}, {\'name\': \'Abbondanza del Luxa\', \'text\': "All\'inizio della tua fase principale pre-combattimento, rimuovi tutti i segnalini inondazione dall\'Abbondanza del Luxa. Se non è stato rimosso alcun segnalino in questo modo, metti un segnalino inondazione sull\'Abbondanza del Luxa e pesca una carta. Altrimenti, aggiungi {C}{G}{U} alla tua riserva di mana.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427974&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3bf827e6-6730-4022-b7ee-cc396e269a0c\', \'multiverseId\': 427974}, \'multiverseid\': 427974}, {\'name\': \'ルクサの恵み\', \'text\': \'あなたの戦闘前メイン・フェイズの開始時に、ルクサの恵みの上から洪水カウンターをすべて取り除く。これによりカウンターが１個も取り除かれなかったなら、ルクサの恵みの上に洪水カウンターを１個置き、カードを１枚引く。これによりカウンターが取り除かれたなら、あなたのマナ・プールに{C}{G}{U}を加える。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428243&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b6a7d2b1-87ac-4cbc-8364-f3b30652d4a8\', \'multiverseId\': 428243}, \'multiverseid\': 428243}, {\'name\': \'럭사의 풍요\', \'text\': \'당신의 전투전 본단계 시작에, 럭사의 풍요가 가진 홍수 카운터를 모두 제거한다. 이런 식으로 제거된 카운터가 없다면, 럭사의 풍요에 홍수 카운터 한 개를 올려놓고 카드 한 장을 뽑는다. 그렇지 않다면, 당신의 마나풀에 {C}{G}{U}를 담는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428512&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'97820eca-1843-4af1-af51-488061069e0f\', \'multiverseId\': 428512}, \'multiverseid\': 428512}, {\'name\': \'Dádiva do Luxa\', \'text\': \'No início da sua fase principal pré-combate, remova todos os marcadores de enchente de Dádiva do Luxa. Se nenhum marcador for removido desta forma, coloque um marcador de enchente em Dádiva do Luxa e compre um card. Caso contrário, adicione {C}{G}{U} à sua reserva de mana.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428781&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7deeeb98-29a4-444b-ab5d-dfae95aa9baf\', \'multiverseId\': 428781}, \'multiverseid\': 428781}, {\'name\': \'Щедрость Луксы\', \'text\': \'В начале вашей предбоевой главной фазы удалите все жетоны затопления с Щедрости Луксы. Если таким образом не было удалено ни одного жетона, положите один жетон затопления на Щедрость Луксы и возьмите карту. В противном случае добавьте {C}{G}{U} в ваше хранилище маны.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429050&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55d0cdfc-5f88-43a2-aabb-8b28ff0678a8\', \'multiverseId\': 429050}, \'multiverseid\': 429050}, {\'name\': \'罗夏河恩泽\', \'text\': \'在你战斗前的行动阶段开始时，移去罗夏河恩泽上所有的洪水指示物。若以此法未移去指示物，则在罗夏河恩泽上放置一个洪水指示物且抓一张牌；反之，则加{C}{G}{U}到你的法术力池中。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429319&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'108a0c39-fe78-41a7-a523-440f18e95f3e\', \'multiverseId\': 429319}, \'multiverseid\': 429319}, {\'name\': \'羅夏河恩澤\', \'text\': \'在你戰鬥前的行動階段開始時，移去羅夏河恩澤上所有的洪水指示物。若以此法未移去指示物，則在羅夏河恩澤上放置一個洪水指示物且抽一張牌；反之，則加{C}{G}{U}到你的魔法力池中。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429588&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3ff86e43-9d71-4ed0-9408-f7e84f434b50\', \'multiverseId\': 429588}, \'multiverseid\': 429588}]', '[{\'name\': \'Seraph der Sonnen\', \'text\': \'Fliegend\\nUnzerstörbar (Schaden und Effekte, die „zerstören", zerstören diese Kreatur nicht. Falls ihre Widerstandskraft 0 oder weniger beträgt, wird sie dennoch auf den Friedhof ihres Besitzers gelegt.)\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„Engel? Auf jeder Welt dasselbe …" —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426999&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9766c88-9a6d-4c98-9e56-cc68a4bb8e8d\', \'multiverseId\': 426999}, \'multiverseid\': 426999}, {\'name\': \'Serafín de los soles\', \'text\': \'Vuela.\\nIndestructible. (El daño y los efectos que dicen "destruir" no destruyen a esta criatura. Si su resistencia es 0 o menos, va al cementerio de su propietario igualmente.)\', \'type\': \'Criatura — Ángel\', \'flavor\': \'"¿Ángeles? Lo que siento por ellos sigue siendo lo mismo". —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427268&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aadca86b-1831-4e9d-8b66-260844c69776\', \'multiverseId\': 427268}, \'multiverseid\': 427268}, {\'name\': \'Séraphin des Soleils\', \'text\': \'Vol\\nIndestructible (Les blessures et les effets qui disent « détruisez » ne détruisent pas cette créature. Si son endurance est inférieure ou égale à 0, elle est toujours mise dans le cimetière de son propriétaire.)\', \'type\': \'Créature : ange\', \'flavor\': "« Des anges ? Mes sentiments n\'ont pas changé. » —Liliana Vess", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427537&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7013f6a4-95dc-40b8-8f6d-059e93a083ee\', \'multiverseId\': 427537}, \'multiverseid\': 427537}, {\'name\': \'Serafino dei Soli\', \'text\': \'Volare\\nIndistruttibile (Il danno e gli effetti che dicono "distruggi" non distruggono questa creatura. Se la sua costituzione è pari o inferiore a 0, viene comunque messa nel cimitero del suo proprietario.)\', \'type\': \'Creatura — Angelo\', \'flavor\': \'"Ancora angeli? Continuo a odiarli." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427806&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e98e68d6-aa34-4ca9-bd0e-60c944b594e6\', \'multiverseId\': 427806}, \'multiverseid\': 427806}, {\'name\': \'双陽の熾天使\', \'text\': \'飛行\\n破壊不能（ダメージや「破壊」と書かれた効果では、このクリーチャーは破壊されない。これのタフネスが０以下であるなら、これはオーナーの墓地に置かれる。）\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'「天使？ 私の気持ちは前と同じよ。」 ――リリアナ・ヴェス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428075&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3493e4c9-b4c6-4348-abfc-64673cb8f8ce\', \'multiverseId\': 428075}, \'multiverseid\': 428075}, {\'name\': \'태양의 치품천사\', \'text\': \'비행\\n무적 (이 생물은 피해나 "파괴한다" 효과에 의해 파괴당하지 않는다. 방어력이 0 이하라면 소유자의 무덤에 놓는다.)\', \'type\': \'생물 — 천사\', \'flavor\': \'"천사들이라고? 그래도 내 감정은 변하지 않아." —릴리아나 베스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428344&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'112347ad-b16b-4d04-82c6-14fff33a8133\', \'multiverseId\': 428344}, \'multiverseid\': 428344}, {\'name\': \'Serafim dos Sóis\', \'text\': \'Voar\\nIndestrutível (Dano e efeitos que dizem "destrua" não destroem esta criatura. Se a sua resistência for igual ou inferior a 0, ela ainda será colocada no cemitério de seu dono.)\', \'type\': \'Criatura — Anjo\', \'flavor\': \'"Anjos? Meus sentimentos permanecem inalterados." — Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428613&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0fafee9c-6b98-48c1-86dc-0af0e5469ec1\', \'multiverseId\': 428613}, \'multiverseid\': 428613}, {\'name\': \'Серафим Солнц\', \'text\': \'Полет\\nНеразрушимость (Повреждения и эффекты с указанием «уничтожьте» не уничтожают это существо. Однако если его выносливость равна 0 или меньше, оно отправляется на кладбище своего владельца.)\', \'type\': \'Существо — Ангел\', \'flavor\': \'«Ангелы? Мое отношение к ним нисколько не изменилось». — Лилиана Весс\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428882&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ca2e4c4d-97f2-43a2-b5c1-e14516c0815d\', \'multiverseId\': 428882}, \'multiverseid\': 428882}, {\'name\': \'诸阳炽天使\', \'text\': \'飞行\\n不灭（注明「消灭」的效应和伤害不会消灭此生物。如果其防御力降到0或更少，它仍会置入其拥有者的坟墓场。）\', \'type\': \'生物～天使\', \'flavor\': \'「天使？我的感觉丝毫未变。」 ～莉莲娜维斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429151&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c31860f-de99-4450-b97d-894b808704b0\', \'multiverseId\': 429151}, \'multiverseid\': 429151}, {\'name\': \'諸陽熾天使\', \'text\': \'飛行\\n不滅（註明「消滅」的效應和傷害不會消滅此生物。如果其防禦力降到0或更少，它仍會置入其擁有者的墳墓場。）\', \'type\': \'生物～天使\', \'flavor\': \'「天使？我的感覺絲毫未變。」 ～莉蓮娜維斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429420&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f7330098-6849-472f-a183-652967184fd7\', \'multiverseId\': 429420}, \'multiverseid\': 429420}]', "[{'name': 'Shefet-Waran', 'text': 'Umwandlung {3}{G} ({3}{G}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Shefet-Waran umwandelst, kannst du deine Bibliothek nach einer Standardland- oder Wüste-Karte durchsuchen, sie ins Spiel bringen und dann deine Bibliothek mischen. (Ziehe erst danach eine Karte.)', 'type': 'Kreatur — Eidechse', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427157&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3b2eb7e8-8716-4ccf-aff0-e9f48fa9ee6c', 'multiverseId': 427157}, 'multiverseid': 427157}, {'name': 'Saurio de Shefet', 'text': 'Ciclo {3}{G}. ({3}{G}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Saurio de Shefet, puedes buscar en tu biblioteca una carta de tierra básica o una carta de Desierto, ponerla en el campo de batalla y luego barajar tu biblioteca. (Haz esto antes de robar.)', 'type': 'Criatura — Lagarto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427426&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '61d2e816-2ac4-45d9-8c03-6533fab73859', 'multiverseId': 427426}, 'multiverseid': 427426}, {'name': 'Surveillant de Shefet', 'text': 'Recyclage {3}{G} ({3}{G}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez le Surveillant de Shefet, vous pouvez chercher dans votre bibliothèque une carte de terrain de base ou une carte de désert, la mettre sur le champ de bataille et mélanger ensuite votre bibliothèque. (Faites ceci avant de piocher.)', 'type': 'Créature : lézard', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427695&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c9134622-ddd8-4875-8ca8-776bc10c2b18', 'multiverseId': 427695}, 'multiverseid': 427695}, {'name': 'Varano di Shefet', 'text': 'Ciclo {3}{G} ({3}{G}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Varano di Shefet, puoi passare in rassegna il tuo grimorio per una carta terra base o una carta Deserto, metterla sul campo di battaglia, poi rimescolare il tuo grimorio. (Devi farlo prima di pescare.)', 'type': 'Creatura — Lucertola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427964&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f97deb2f-9585-430e-8147-d7d63b42f04c', 'multiverseId': 427964}, 'multiverseid': 427964}, {'name': 'シェフェトのオオトカゲ', 'text': 'サイクリング{3}{G}（{3}{G}, このカードを捨てる：カードを１枚引く。）\\nあなたがシェフェトのオオトカゲをサイクリングしたとき、あなたはあなたのライブラリーから基本土地・カード１枚か砂漠・カード１枚を探してもよい。そうしたなら、それを戦場に出し、その後あなたのライブラリーを切り直す。（これはあなたがカードを引く前に行う。）', 'type': 'クリーチャー — トカゲ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428233&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1e36715d-9e47-431d-8b89-06e0e0e89838', 'multiverseId': 428233}, 'multiverseid': 428233}, {'name': '셰페트 감시자', 'text': '순환 {3}{G} ({3}{G}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 셰페트 감시자를 순환할 때, 당신은 당신의 서고에서 기본 대지 카드 또는 사막 카드 한 장을 찾아 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다. (카드를 뽑기 전에 이 행동을 한다.)', 'type': '생물 — 도마뱀', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428502&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f3c7804e-cef1-4a13-9dc1-30f9438f83e4', 'multiverseId': 428502}, 'multiverseid': 428502}, {'name': 'Sáurio do Shefet', 'text': 'Reciclar {3}{G} ({3}{G}, Descarte este card: Compre um card.)\\nQuando recicla Sáurio do Shefet, você pode procurar um card de terreno básico ou Deserto em seu grimório, colocá-lo no campo de batalha e depois embaralhar seu grimório. (Faça isso antes de comprar.)', 'type': 'Criatura — Lagarto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428771&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a492affa-227b-4ce7-8093-ecaaf9c15a71', 'multiverseId': 428771}, 'multiverseid': 428771}, {'name': 'Шефетский Варан', 'text': 'Цикл {3}{G} ({3}{G}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете цикл Шефетского Варана, вы можете найти в вашей библиотеке карту базовой земли или Пустыни, положить ее на поле битвы, затем перетасовать вашу библиотеку. (Сделайте это до того, как возьмете карту.)', 'type': 'Существо — Ящер', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429040&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '75bf97be-f19c-4a38-a6a5-a384c8da17fc', 'multiverseId': 429040}, 'multiverseid': 429040}, {'name': '谢菲巨蜥', 'text': '循环{3}{G}（{3}{G}，弃掉此牌：抓一张牌。）\\n当你循环谢菲巨蜥时，你可以从你的牌库中搜寻一张基本地牌或沙漠牌，将之放进战场，然后将你的牌库洗牌。（先如此作后再抓牌。）', 'type': '生物～蜥蜴', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429309&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b8088e1b-9444-47ae-b98f-ff236d778406', 'multiverseId': 429309}, 'multiverseid': 429309}, {'name': '謝菲巨蜥', 'text': '循環{3}{G}（{3}{G}，棄掉此牌：抽一張牌。）\\n當你循環謝菲巨蜥時，你可以從你的牌庫中搜尋一張基本地牌或沙漠牌，將之放進戰場，然後將你的牌庫洗牌。（先如此作後再抽牌。）', 'type': '生物～蜥蜴', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429578&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4bfc5b34-5a3d-4ec2-830c-7b2134346426', 'multiverseId': 429578}, 'multiverseid': 429578}]", '[{\'name\': \'Sich entfaltende Wildnis\', \'text\': \'{T}, opfere die Sich entfaltende Wildnis: Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe sie getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'„Hast du dich nie gefragt, was hinter dem Hekma liegt? Hinter den Hörnern am Horizont, dort, wo selbst die Götter nicht hingelangen?" —Samut, Geweihte der Tah-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427213&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8190adf1-9cc7-446b-8420-aaebc1854ba5\', \'multiverseId\': 427213}, \'multiverseid\': 427213}, {\'name\': \'Terrenos expansivos\', \'text\': \'{T}, sacrificar los Terrenos expansivos: Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'"¿Nunca te preguntas qué hay más allá de la Hekma? ¿Más allá del alcance de los dioses? ¿Más allá de los cuernos en el horizonte?" —Samut, iniciada de la simiente Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427482&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d12688c-0166-4191-9438-8400da9bd30a\', \'multiverseId\': 427482}, \'multiverseid\': 427482}, {\'name\': \'Étendues sauvages en évolution\', \'text\': \'{T}, sacrifiez les Étendues sauvages en évolution : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.\', \'type\': \'Terrain\', \'flavor\': "« Ne vous êtes-vous jamais demandé ce qui se trouve par-delà l\'Hekma ? Par-delà l\'influence des dieux ? Par-delà les cornes de l\'horizon ? » —Samut, adepte de la moisson Tah", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7607d343-e540-42e3-81b9-8427004b5bc1\', \'multiverseId\': 427751}, \'multiverseid\': 427751}, {\'name\': \'Terre Selvagge in Evoluzione\', \'text\': \'{T}, Sacrifica le Terre Selvagge in Evoluzione: Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'"Non vi siete mai chiesti cosa si cela oltre l\\\'Hekma? Oltre la sfera di influenza delle divinità? Oltre le corna all\\\'orizzonte?" —Samut, iniziata della messe Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428020&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d098b98-cdef-4299-969b-a58a42a0047c\', \'multiverseId\': 428020}, \'multiverseid\': 428020}, {\'name\': \'進化する未開地\', \'text\': \'{T}, 進化する未開地を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、それをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'「ヘクマの向こうに何があるか考えたことがあるかしら？ 神々の手の届かない場所は？ 地平の二つ角を越えた先は？」 ――ター一門の修練者、サムト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428289&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83c030da-ac36-4d84-9984-f37eaef226d6\', \'multiverseId\': 428289}, \'multiverseid\': 428289}, {\'name\': \'진화하는 야생지\', \'text\': \'{T}, 진화하는 야생지를 희생한다: 당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓는다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'대지\', \'flavor\': \'"헤크마 너머에, 신들의 영역 너머에, 지평선의 뿔 너머에 무엇이 있는지 궁금하지 않아?" —타 입문자의 입회자 사무트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428558&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1781f470-10db-4117-aeef-b34a4a82ca60\', \'multiverseId\': 428558}, \'multiverseid\': 428558}, {\'name\': \'Terras em Desenvolvimento\', \'text\': \'{T}, Sacrifique Terras em Desenvolvimento: Procure um card de terreno básico em seu grimório e coloque-o no campo de batalha virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'"Você nunca se perguntou o que há depois da Hekma? Além do alcance dos deuses? Além dos chifres no horizonte?" — Samut, iniciada da safra Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428827&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71d193bc-5be3-4abf-8972-71a0607111a4\', \'multiverseId\': 428827}, \'multiverseid\': 428827}, {\'name\': \'Перерождающиеся Дебри\', \'text\': \'{T}, пожертвуйте Перерождающиеся Дебри: найдите в вашей библиотеке карту базовой земли и положите ее на поле битвы повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'«Ты когда-нибудь задумывался о том, что лежит за Хекмой? Далеко, куда не достает взор богов? За рогами на горизонте?» — Самут, послушница снопа Тах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429096&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ddc9c51a-1be8-483c-a689-aa366c7fe524\', \'multiverseId\': 429096}, \'multiverseid\': 429096}, {\'name\': \'成形野地\', \'text\': \'{T}，牺牲成形野地：从你的牌库中搜寻一张基本地牌，并将之横置放进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'「你们可曾好奇过，在避世帘那端，神力弗届之处，天际尊角彼方都有什么？」 ～塔哈祀群祀徒撒姆特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429365&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec2851d6-bd26-4eba-9e58-e0d1d471e667\', \'multiverseId\': 429365}, \'multiverseid\': 429365}, {\'name\': \'成形野地\', \'text\': \'{T}，犧牲成形野地：從你的牌庫中搜尋一張基本地牌，並將之橫置放進戰場。然後將你的牌庫洗牌。\', \'type\': \'地\', \'flavor\': \'「你們可曾好奇過，在避世簾那端，神力弗屆之處，天際尊角彼方都有什麼？」 ～塔哈祀群祀徒撒姆特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429634&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a2656928-6322-40d3-82ee-0c6e19616357\', \'multiverseId\': 429634}, \'multiverseid\': 429634}]', '[{\'name\': \'Skarabäen-Fraß\', \'text\': \'Schicke bis zu drei Karten deiner Wahl aus genau einem Friedhof ins Exil.\\nUmwandlung {B} ({B}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Mittelmäßigkeit endet in gesalbten Leinen. Strebt nach einem besseren Ende." —Epnokep, Wesir von Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427077&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1354874e-847a-4893-be63-b49b97cba816\', \'multiverseId\': 427077}, \'multiverseid\': 427077}, {\'name\': \'Festín de escarabajos\', \'text\': \'Exilia hasta tres cartas objetivo de un mismo cementerio.\\nCiclo {B}. ({B}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"El rostro de la mediocridad está envuelto en lino ungido. Aspira a un fin mejor". —Epnokep, visir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427346&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09981e3e-f1ac-4ecd-a55e-cb75fb8e56be\', \'multiverseId\': 427346}, \'multiverseid\': 427346}, {\'name\': \'Festin de scarabées\', \'text\': "Exilez jusqu\'à trois cartes ciblées d\'un cimetière unique.\\nRecyclage {B} ({B}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': \'« Le visage de la médiocrité est enveloppé de bandelettes consacrées. Aspirez à une fin meilleure. » —Epnokep, vizir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427615&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff48820c-098e-465b-bdb1-445e43abd995\', \'multiverseId\': 427615}, \'multiverseid\': 427615}, {\'name\': \'Banchetto degli Scarabei\', \'text\': \'Esilia fino a tre carte bersaglio da un unico cimitero.\\nCiclo {B} ({B}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Il volto del mediocre viene avvolto nel lino consacrato. Voi dovreste aspirare a una fine migliore." —Epnokep, visir di Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56b72704-8e40-4d6f-a0e9-391883dbe56e\', \'multiverseId\': 427884}, \'multiverseid\': 427884}, {\'name\': \'スカラベの饗宴\', \'text\': \'１つの墓地からカード最大３枚を対象とし、それらを追放する。\\nサイクリング{B}（{B}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「凡人は選定された帯に包まれる。そうならないことだ。」 ――バントゥの侍臣、エプノケプ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428153&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e87bc58-ec0f-4988-8450-b0dec775246d\', \'multiverseId\': 428153}, \'multiverseid\': 428153}, {\'name\': \'딱정벌레 잔치\', \'text\': \'한 무덤에 있는 카드를 최대 세 장까지 목표로 정한다. 그 카드들을 추방한다.\\n순환 {B} ({B}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"평범한 얼굴이 성유 바른 천으로 싸여 있다. 더 나은 끝을 갈망하라." —본투의 고관 엡노켑\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428422&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4a3f6e0e-a654-4826-9d6b-7242b0a45f85\', \'multiverseId\': 428422}, \'multiverseid\': 428422}, {\'name\': \'Banquete dos Escaravelhos\', \'text\': \'Exile até três cards alvo de um único cemitério.\\nReciclar {B} ({B}, Descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A face da mediocridade está envolta em linho ungido. Aspire a um fim melhor." — Epnokep, vizir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428691&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d49d2454-ac9a-4fcb-b027-16e8799ce6e6\', \'multiverseId\': 428691}, \'multiverseid\': 428691}, {\'name\': \'Пир Скарабеев\', \'text\': \'Изгоните не более трех целевых карт из одного кладбища.\\nЦикл {B} ({B}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Лицо посредственности замотано умащенными бинтами. Стремись к лучшей участи». — Эпнокеп, визирь Бонту\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428960&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e320835-cd8a-49c5-bbc6-5711949c0b59\', \'multiverseId\': 428960}, \'multiverseid\': 428960}, {\'name\': \'圣甲虫盛宴\', \'text\': \'将至多三张目标在同一坟墓场中的牌放逐。\\n循环{B}（{B}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「经圣洗的麻布包裹住凡庸面容。让人希望得到善终。」 ～芭图维齐尔埃诺科\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429229&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45616049-887e-44f9-b40b-786303aa3f03\', \'multiverseId\': 429229}, \'multiverseid\': 429229}, {\'name\': \'聖甲蟲盛宴\', \'text\': \'將至多三張目標在同一墳墓場中的牌放逐。\\n循環{B}（{B}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「經聖洗的麻布包裹住凡庸面容。讓人希望得到善終。」 ～芭圖維齊爾埃諾科\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429498&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c864601a-2bd5-46d0-9d01-d98c2c4affc6\', \'multiverseId\': 429498}, \'multiverseid\': 429498}]', '[{\'name\': \'Skarabäen-Nest\', \'text\': \'Immer wenn du eine oder mehrere -1/-1-Marken auf eine Kreatur legst, erzeuge entsprechend viele 1/1 schwarze Insekt-Kreaturenspielsteine.\', \'type\': \'Verzauberung\', \'flavor\': \'„Sie sind winzig, aber unersättlich. Lernt von ihnen." —Bontu, Göttin des Ehrgeizes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427072&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8335777c-45a4-43bb-ab7d-6bb00f7ae41d\', \'multiverseId\': 427072}, \'multiverseid\': 427072}, {\'name\': \'Nido de escarabajos\', \'text\': \'Siempre que pongas uno o más contadores -1/-1 sobre una criatura, crea esa misma cantidad de fichas de criatura Insecto negras 1/1.\', \'type\': \'Encantamiento\', \'flavor\': \'"Son pequeños, pero siempre quieren más. Aprende de ellos". —Bontu, diosa de la ambición\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427341&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3d9ebefa-9de5-4383-a7f0-0e0372ca3e4e\', \'multiverseId\': 427341}, \'multiverseid\': 427341}, {\'name\': \'Nid de scarabées\', \'text\': \'À chaque fois que vous mettez au moins un marqueur -1/-1 sur une créature, créez autant de jetons de créature 1/1 noire Insecte.\', \'type\': \'Enchantement\', \'flavor\': "« Ils sont petits, mais ne sont jamais satisfaits. Tirez-en des enseignements. » —Bontu, déesse de l\'Ambition", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427610&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f3e742bd-b140-46f9-9903-063c72b7a09e\', \'multiverseId\': 427610}, \'multiverseid\': 427610}, {\'name\': \'Nido di Scarabei\', \'text\': \'Ogniqualvolta metti uno o più segnalini -1/-1 su una creatura, crea altrettante pedine creatura Insetto 1/1 nere.\', \'type\': \'Incantesimo\', \'flavor\': \'"Sono piccoli ma insaziabili. Dovreste imparare da loro." —Bontu, dea dell\\\'ambizione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427879&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a3091cd2-d1d6-4672-853c-904547c121c0\', \'multiverseId\': 427879}, \'multiverseid\': 427879}, {\'name\': \'スカラベの巣\', \'text\': \'あなたがクリーチャー１体の上に－１/－１カウンターを１個以上置くたび、その数に等しい数の黒の１/１の昆虫・クリーチャー・トークンを生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「体は小さいが常に貪欲だ。見習うがよい。」 ――野望の神、バントゥ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428148&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9e92f9e-0b15-40ea-8379-512ca2db335b\', \'multiverseId\': 428148}, \'multiverseid\': 428148}, {\'name\': \'딱정벌레 소굴\', \'text\': \'당신이 생물에 -1/-1 카운터를 한 개 이상 올려놓을 때마다, 그만큼의 1/1 흑색 곤충 생물 토큰을 만든다.\', \'type\': \'부여마법\', \'flavor\': \'"이놈들은 작지만 언제나 더 많은 걸 원한다. 이들에게 배워라." —야망의 신 본투\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428417&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'420ad445-bb3d-4e14-9d4b-a2caf6eb6aa0\', \'multiverseId\': 428417}, \'multiverseid\': 428417}, {\'name\': \'Ninho de Escaravelhos\', \'text\': \'Toda vez que você colocar um ou mais marcadores -1/-1 em uma criatura, crie aquela quantidade de fichas de criatura preta 1/1 do tipo Inseto.\', \'type\': \'Encantamento\', \'flavor\': \'"Eles são pequenos, mas querem sempre mais. Aprenda com eles." — Bontu, deusa da ambição\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428686&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb625c38-7a9c-413f-9ffd-ad2149e9f9a6\', \'multiverseId\': 428686}, \'multiverseid\': 428686}, {\'name\': \'Гнездо Скарабеев\', \'text\': \'Каждый раз, когда вы кладете на существо один или несколько жетонов -1/-1, создайте такое же количество фишек существа 1/1 черное Насекомое.\', \'type\': \'Чары\', \'flavor\': \'«Они малы, но всегда жаждут получить больше. Учитесь у них». — Бонту, богиня устремленности\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428955&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d51bbaf5-efc6-4d5f-9253-7396aa0069dc\', \'multiverseId\': 428955}, \'multiverseid\': 428955}, {\'name\': \'圣甲虫巢穴\', \'text\': \'每当你在一个生物上放置一个或数个-1/-1指示物时，派出等量的1/1黑色昆虫衍生生物。\', \'type\': \'结界\', \'flavor\': \'「它们虽然渺小，但总是索求更多。多跟它们学学。」 ～野心之神芭图\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429224&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c609697d-7261-4db8-a316-9a7baf010d55\', \'multiverseId\': 429224}, \'multiverseid\': 429224}, {\'name\': \'聖甲蟲巢穴\', \'text\': \'每當你在一個生物上放置一個或數個-1/-1指示物時，派出等量的1/1黑色昆蟲衍生生物。\', \'type\': \'結界\', \'flavor\': \'「牠們雖然渺小，但總是索求更多。多跟牠們學學。」 ～野心之神芭圖\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429493&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f8597c48-6ec8-4916-9afe-982384e8b440\', \'multiverseId\': 429493}, \'multiverseid\': 429493}]', '[{\'name\': \'Sog der Zeit\', \'text\': \'Ziehe X Karten und wirf dann eine Karte ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich nehme mir gerne Zeit für die Dinge, die mir wichtig sind." —Etha, Geweihte der Rhet-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427036&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6df84b1-9834-4a64-8c84-d2a2253babb2\', \'multiverseId\': 427036}, \'multiverseid\': 427036}, {\'name\': \'Tomar del mañana\', \'text\': \'Roba X cartas, luego descarta una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Yo hago las cosas a mi ritmo". —Etha, iniciada de la simiente Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427305&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2df5fc19-8027-4ee8-884a-c9328d480553\', \'multiverseId\': 427305}, \'multiverseid\': 427305}, {\'name\': \'Extraction du lendemain\', \'text\': "Piochez X cartes, puis défaussez-vous d\'une carte.", \'type\': \'Éphémère\', \'flavor\': \'« Je fais les choses quand je le décide. » —Etha, adepte de la moisson Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427574&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a04a1464-a3ff-4550-bc3d-a50d7a8973e4\', \'multiverseId\': 427574}, \'multiverseid\': 427574}, {\'name\': \'Attingere al Domani\', \'text\': \'Pesca X carte, poi scarta una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Preferisco agire secondo i miei tempi." —Etha, iniziata della messe Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427843&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'978b950f-73af-4c0b-b790-4b4b5d0f6906\', \'multiverseId\': 427843}, \'multiverseid\': 427843}, {\'name\': \'明日からの引き寄せ\', \'text\': \'カードをＸ枚引き、その後カード１枚を捨てる。\', \'type\': \'インスタント\', \'flavor\': \'「都合に合わせて。」 ――レト一門の修練者、イータ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428112&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6fba240c-faf6-4683-b0d9-49595f3b2520\', \'multiverseId\': 428112}, \'multiverseid\': 428112}, {\'name\': \'미래로부터 소환\', \'text\': \'카드 X장을 뽑은 후, 카드 한 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': \'"나는 내 시간에만 일한다." —레트 입문자의 입회자 에타\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428381&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bf7f0f41-867e-4b54-91e9-d97104366778\', \'multiverseId\': 428381}, \'multiverseid\': 428381}, {\'name\': \'Puxar do Amanhã\', \'text\': \'Compre X cards e depois descarte um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Faço as coisas em meu próprio tempo." — Etha, iniciada da safra Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428650&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d0d9d678-d9eb-477f-a526-52378ccb5a58\', \'multiverseId\': 428650}, \'multiverseid\': 428650}, {\'name\': \'Трофеи из Будущего\', \'text\': \'Возьмите X карт, затем сбросьте карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я сама решаю, когда что делать». — Эта, послушница снопа Рет\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428919&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6972a7cc-ac34-49f0-aedf-0fbe4a871047\', \'multiverseId\': 428919}, \'multiverseid\': 428919}, {\'name\': \'取自明日\', \'text\': \'抓X张牌，然后弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「我用自己的时间处理事宜。」 ～雷特祀群祀徒爱瑟\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429188&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9026767-80a4-4ba8-9b95-e10b45e32ccc\', \'multiverseId\': 429188}, \'multiverseid\': 429188}, {\'name\': \'取自明日\', \'text\': \'抽X張牌，然後棄一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「我用自己的時間處理事宜。」 ～雷特祀群祀徒愛瑟\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429457&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4de650da-1a07-4d0f-995b-dd08e9cd9d6f\', \'multiverseId\': 429457}, \'multiverseid\': 429457}]', "[{'name': 'Sonnenuntergang // Sonnenaufgang', 'text': 'Zerstöre alle Kreaturen mit Stärke 3 oder mehr.', 'type': 'Hexerei', 'flavor': None, 'faceName': 'Sonnenuntergang', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427181&type=card', 'language': 'German', 'identifiers': {'scryfallId': '61b32677-cd3c-4f39-bb68-a282a7a2e482', 'multiverseId': 427181}, 'multiverseid': 427181}, {'name': 'Ocaso // Alba', 'text': 'Destruye todas las criaturas con fuerza de 3 o más.', 'type': 'Conjuro', 'flavor': None, 'faceName': 'Ocaso', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427450&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9ff745f8-8fc2-4f88-ba25-03f8b9ae4932', 'multiverseId': 427450}, 'multiverseid': 427450}, {'name': 'Crépuscule // Aube', 'text': 'Détruisez toutes les créatures de force supérieure ou égale à 3.', 'type': 'Rituel', 'flavor': None, 'faceName': 'Crépuscule', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427719&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0a698422-dec0-4083-9264-08b83e7b90f1', 'multiverseId': 427719}, 'multiverseid': 427719}, {'name': 'Tramonto // Alba', 'text': 'Distruggi tutte le creature con forza pari o superiore a 3.', 'type': 'Stregoneria', 'flavor': None, 'faceName': 'Tramonto', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427988&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3980b390-0c85-44a5-b967-9570d246abaa', 'multiverseId': 427988}, 'multiverseid': 427988}, {'name': '黄昏 // 払暁', 'text': 'パワーが３以上のクリーチャーをすべて破壊する。', 'type': 'ソーサリー', 'flavor': None, 'faceName': '黄昏', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428257&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4cffc5c9-0115-4a8f-9665-a3fbdd4179c2', 'multiverseId': 428257}, 'multiverseid': 428257}, {'name': '황혼 // 여명', 'text': '공격력이 3 이상인 모든 생물을 파괴한다.', 'type': '집중마법', 'flavor': None, 'faceName': '황혼', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428526&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e01a097b-10b3-4ccc-8119-40e9ed9814c4', 'multiverseId': 428526}, 'multiverseid': 428526}, {'name': 'Anoitecer // Alvorecer', 'text': 'Destrua todas as criaturas com poder igual ou superior a 3.', 'type': 'Feitiço', 'flavor': None, 'faceName': 'Anoitecer', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428795&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f544a7cb-217d-491b-81c4-c1d7202a79de', 'multiverseId': 428795}, 'multiverseid': 428795}, {'name': 'Закат // Рассвет', 'text': 'Уничтожьте все существа с силой 3 или больше.', 'type': 'Волшебство', 'flavor': None, 'faceName': 'Закат', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429064&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '030a358e-456a-49d9-888c-74d1d3853788', 'multiverseId': 429064}, 'multiverseid': 429064}, {'name': '暮死 // 朝生', 'text': '消灭所有力量等于或大于3的生物。', 'type': '法术', 'flavor': None, 'faceName': '暮死', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429333&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '678031e7-36e4-426a-8b7b-458c005e8e81', 'multiverseId': 429333}, 'multiverseid': 429333}, {'name': '暮死 // 朝生', 'text': '消滅所有力量等於或大於3的生物。', 'type': '巫術', 'flavor': None, 'faceName': '暮死', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429602&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3ddba5e9-5524-4de4-a6fc-e53d14d58c55', 'multiverseId': 429602}, 'multiverseid': 429602}]", '[{\'name\': \'Sonnenverbrannte Wüste\', \'text\': \'Wenn die Sonnenverbrannte Wüste ins Spiel kommt, fügt sie einem Spieler deiner Wahl 1 Schadenspunkt zu.\\n{T}: Erhöhe deinen Manavorrat um {C}.\', \'type\': \'Land — Wüste\', \'flavor\': \'Die einzige Aussicht auf Hoffnung ist eine Fata Morgana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427220&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aea32f48-9618-4abe-adf1-bbe68f392d30\', \'multiverseId\': 427220}, \'multiverseid\': 427220}, {\'name\': \'Desierto abrasador\', \'text\': \'Cuando el Desierto abrasador entre al campo de batalla, hace 1 punto de daño al jugador objetivo.\\n{T}: Agrega {C} a tu reserva de maná.\', \'type\': \'Tierra — Desierto\', \'flavor\': \'El único alivio a la vista es un espejismo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427489&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36c5f7bf-fd31-4f9d-81ae-02c65faf449a\', \'multiverseId\': 427489}, \'multiverseid\': 427489}, {\'name\': \'Désert brûlé par le soleil\', \'text\': \'Quand le Désert brûlé par le soleil arrive sur le champ de bataille, il inflige 1 blessure à un joueur ciblé.\\n{T} : Ajoutez {C} à votre réserve.\', \'type\': \'Terrain : désert\', \'flavor\': \'La seule délivrance en vue est un mirage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427758&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c69feb1-706d-412c-bd78-307b1a82f03a\', \'multiverseId\': 427758}, \'multiverseid\': 427758}, {\'name\': \'Deserto Riarso\', \'text\': \'Quando il Deserto Riarso entra nel campo di battaglia, infligge 1 danno a un giocatore bersaglio.\\n{T}: Aggiungi {C} alla tua riserva di mana.\', \'type\': \'Terra — Deserto\', \'flavor\': "L\'unico conforto che si profila all\'orizzonte è un miraggio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428027&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27f5224e-5272-42f5-a726-b9cbfbbf3355\', \'multiverseId\': 428027}, \'multiverseid\': 428027}, {\'name\': \'陽焼けした砂漠\', \'text\': \'陽焼けした砂漠が戦場に出たとき、プレイヤー１人を対象とする。これはそのプレイヤーに１点のダメージを与える。\\n{T}：あなたのマナ・プールに{C}を加える。\', \'type\': \'土地 — 砂漠\', \'flavor\': \'唯一の心休まる眺めは蜃気楼だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428296&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a8429063-8c1b-404f-a9ff-bc0444aff9bd\', \'multiverseId\': 428296}, \'multiverseid\': 428296}, {\'name\': \'폭염 사막\', \'text\': \'폭염 사막이 전장에 들어올 때, 플레이어를 목표로 정한다. 폭염 사막은 그 플레이어에게 피해 1점을 입힌다.\\n{T}: {C}를 당신의 마나풀에 담는다.\', \'type\': \'대지 — 사막\', \'flavor\': \'눈에 보이는 유일한 희망은 신기루뿐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428565&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'17ad3ab2-c1de-4939-88ce-fdf5aa34566c\', \'multiverseId\': 428565}, \'multiverseid\': 428565}, {\'name\': \'Deserto Abrasado pelo Sol\', \'text\': \'Quando Deserto Abrasado pelo Sol entra no campo de batalha, ele causa 1 ponto de dano ao jogador alvo.\\n{T}: Adicione {C} à sua reserva de mana.\', \'type\': \'Terreno — Deserto\', \'flavor\': \'O único alívio à vista é uma miragem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dcfdbff3-3a86-4292-a6aa-60765aeed861\', \'multiverseId\': 428834}, \'multiverseid\': 428834}, {\'name\': \'Выжженная Солнцем Пустыня\', \'text\': \'Когда Выжженная Пустыня выходит на поле битвы, она наносит 1 повреждение целевому игроку.\\n{T}: добавьте {C} в ваше хранилище маны.\', \'type\': \'Земля — Пустыня\', \'flavor\': \'Здесь лишь миражи услаждают взгляд.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429103&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7cd7c780-c4bb-4fb2-b323-a61ba63a1618\', \'multiverseId\': 429103}, \'multiverseid\': 429103}, {\'name\': \'日灼荒漠\', \'text\': \'当日灼荒漠进战场时，它对目标牌手造成1点伤害。\\n{T}：加{C}到你的法术力池中。\', \'type\': \'地～沙漠\', \'flavor\': \'眼前唯一的慰藉只是海市蜃楼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429372&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'301bef49-df6f-471f-ae83-cd27c0335d98\', \'multiverseId\': 429372}, \'multiverseid\': 429372}, {\'name\': \'日灼荒漠\', \'text\': \'當日灼荒漠進戰場時，它對目標玩家造成1點傷害。\\n{T}：加{C}到你的魔法力池中。\', \'type\': \'地～沙漠\', \'flavor\': \'眼前唯一的慰藉只是海市蜃樓。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429641&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fadcf13e-4655-4b30-99ff-566eb55b85dc\', \'multiverseId\': 429641}, \'multiverseid\': 429641}]', '[{\'name\': \'Speermeister der Rhet-Saat\', \'text\': \'Du kannst den Speermeister der Rhet-Saat erschöpfen, sowie er angreift. Wenn du dies tust, erhält er +1/+0 und Erstschlag bis zum Ende des Zuges. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Im Jenseits brauche ich keinen Schlaf und hier habe ich keine Zeit dafür!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426997&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'25c992f6-3f1e-433f-aa29-de66631f6b53\', \'multiverseId\': 426997}, \'multiverseid\': 426997}, {\'name\': \'Lancero de la simiente Rhet\', \'text\': \'Puedes espolear al Lancero de la simiente Rhet en cuanto ataque. Cuando lo hagas, obtiene +1/+0 y gana la habilidad de dañar primero hasta el final del turno. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"En el más allá no tendré necesidad de dormir. Hasta entonces, no tengo tiempo para ello".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9da5b800-971c-4f78-a032-a3ebe2c91940\', \'multiverseId\': 427266}, \'multiverseid\': 427266}, {\'name\': \'Maître lancier de la moisson Rhet\', \'text\': "Vous pouvez surmener le Maître lancier de la moisson Rhet au moment où il attaque. Quand vous faites ainsi, il gagne +1/+0 et acquiert l\'initiative jusqu\'à la fin du tour. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': "« Dans l\'au-delà, je n\'aurai pas besoin de dormir. Et d\'ici là, je n\'en ai pas le temps ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427535&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0e2c3c5d-1bdb-47a4-890a-8844cdb38634\', \'multiverseId\': 427535}, \'multiverseid\': 427535}, {\'name\': \'Lanciere della Messe Rhet\', \'text\': \'Puoi stremare il Lanciere della Messe Rhet mentre attacca. Quando lo fai, prende +1/+0 e ha attacco improvviso fino alla fine del turno. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Nell\\\'aldilà non avrò bisogno di dormire. E fino ad allora, non avrò tempo di farlo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427804&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'895f6ca7-4e9d-45a9-90ef-c2dcf485cb5f\', \'multiverseId\': 427804}, \'multiverseid\': 427804}, {\'name\': \'レト一門の槍の達人\', \'text\': \'レト一門の槍の達人が攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、ターン終了時まで、これは＋１/＋０の修整を受けるとともに先制攻撃を得る。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「来世では眠る必要はない。その時までは眠る暇などない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428073&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9552a6f9-496c-40ab-968c-836bdfb0a7e1\', \'multiverseId\': 428073}, \'multiverseid\': 428073}, {\'name\': \'레트 입문자 창술가\', \'text\': \'당신은 레트 입문자 창술가로 공격을 선언하면서 레트 입문자 창술가를 분전시킬 수 있다. 그렇게 할 때, 레트 입문자 창술가는 턴종료까지 +1/+0을 받고 선제공격을 얻는다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"사후 세계에서는 잠잘 필요가 없어. 그리고 거기 가기 전까진 잠잘 시간이 없고!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428342&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'08353de2-3bbe-46cd-afe9-c8b7cf761c4f\', \'multiverseId\': 428342}, \'multiverseid\': 428342}, {\'name\': \'Mestre da Lança da Safra Rhet\', \'text\': \'Você pode exaurir Mestre da Lança da Safra Rhet conforme ele ataca. Quando você faz isso, ele recebe +1/+0 e ganha iniciativa até o final do turno. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Na vida após a morte eu não vou precisar dormir. E, até lá, eu não tenho tempo para isso!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428611&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'333fbdfd-6033-4d74-a176-9abd2b8d6f16\', \'multiverseId\': 428611}, \'multiverseid\': 428611}, {\'name\': \'Копьеносец Снопа Рет\', \'text\': \'Вы можете подстегнуть Копьеносца Снопа Рет в момент его атаки. Когда вы это делаете, он получает +1/+0 и Первый удар до конца хода. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«В загробной жизни мне не нужно будет спать. А до тех пор у меня на сон нет времени».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428880&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6223b86a-8bb4-4f07-a393-fd8d64130b92\', \'multiverseId\': 428880}, \'multiverseid\': 428880}, {\'name\': \'雷特祀群矛手\', \'text\': \'你可以于雷特祀群矛手攻击时耗竭之。当你如此作时，直到回合结束，它得+1/+0且获得先攻异能。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～人类／战士\', \'flavor\': \'「到了来世，就没必要休息。还没争到来世前，我没时间休息！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429149&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1aebd7d-2e9e-4542-9f9f-520a4c379595\', \'multiverseId\': 429149}, \'multiverseid\': 429149}, {\'name\': \'雷特祀群矛手\', \'text\': \'你可以於雷特祀群矛手攻擊時耗竭之。當你如此作時，直到回合結束，它得+1/+0且獲得先攻異能。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～人類／戰士\', \'flavor\': \'「到了來世，就沒必要休息。還沒爭到來世前，我沒時間休息！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429418&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7bb19396-eef5-447f-b3e2-796aff7558b1\', \'multiverseId\': 429418}, \'multiverseid\': 429418}]', '[{\'name\': \'Spinnengriff\', \'text\': \'Enttappe eine Kreatur deiner Wahl. Sie erhält +2/+4 und Reichweite bis zum Ende des Zuges. (Sie kann fliegende Kreaturen blocken.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Es gibt keinen gefahrlosen Weg durch die Prüfung der Stärke.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427159&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'debb2fb0-5d61-429c-8fc8-2e57ba12d3d0\', \'multiverseId\': 427159}, \'multiverseid\': 427159}, {\'name\': \'Abrazo arácnido\', \'text\': \'Endereza la criatura objetivo. Obtiene +2/+4 y gana la habilidad de alcance hasta el final del turno. (Puede bloquear a criaturas con la habilidad de volar.)\', \'type\': \'Instantáneo\', \'flavor\': \'No hay caminos seguros en la Prueba de fuerza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427428&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'751006d0-8496-49a7-bae4-4456668dbc23\', \'multiverseId\': 427428}, \'multiverseid\': 427428}, {\'name\': \'Emprise arachnide\', \'text\': "Dégagez la créature ciblée. Elle gagne +2/+4 et acquiert la portée jusqu\'à la fin du tour. (Elle peut bloquer les créatures avec le vol.)", \'type\': \'Éphémère\', \'flavor\': "Aucune voie n\'est sûre pendant l\'Épreuve de force.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'47c91b4c-1bab-4acb-ab12-72c7fc8d56a7\', \'multiverseId\': 427697}, \'multiverseid\': 427697}, {\'name\': \'Aracnomorsa\', \'text\': \'STAPpa una creatura bersaglio. Prende +2/+4 e ha raggiungere fino alla fine del turno. (Può bloccare le creature con volare.)\', \'type\': \'Istantaneo\', \'flavor\': "Non esiste un percorso sicuro per superare l\'Ordalia della Forza.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427966&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'266a7135-b134-409e-8b52-35cc68e98cf3\', \'multiverseId\': 427966}, \'multiverseid\': 427966}, {\'name\': \'蜘蛛の掌握\', \'text\': \'クリーチャー１体を対象とし、それをアンタップする。ターン終了時まで、それは＋２/＋４の修整を受けるとともに到達を得る。（それは飛行を持つクリーチャーをブロックできる。）\', \'type\': \'インスタント\', \'flavor\': \'活力の試練に安全な道などない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428235&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c529b3af-52e0-46cb-96c4-f3620805584e\', \'multiverseId\': 428235}, \'multiverseid\': 428235}, {\'name\': \'거미같은 움켜쥠\', \'text\': \'생물을 목표로 정한다. 그 생물을 언탭한다. 그 생물은 턴종료까지 +2/+4를 받고 대공을 얻는다. (그 생물은 비행을 가진 생물을 방어할 수 있다.)\', \'type\': \'순간마법\', \'flavor\': \'힘의 시험을 통과하기 위한 안전한 길은 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428504&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e7035a8d-fed8-482f-867f-875e9eeb4886\', \'multiverseId\': 428504}, \'multiverseid\': 428504}, {\'name\': \'Garras Aracnoides\', \'text\': \'Desvire a criatura alvo. Ela recebe +2/+4 e ganha alcance até o final do turno. (Ela pode bloquear criaturas com voar.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Não há caminhos seguros para superar a Prova da Força.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428773&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'75236972-f4c0-469b-bcf2-43d33861b48a\', \'multiverseId\': 428773}, \'multiverseid\': 428773}, {\'name\': \'Паучья Хватка\', \'text\': \'Разверните целевое существо. Оно получает +2/+4 и Захват до конца хода. (Оно может блокировать существа с Полетом.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Через испытание силы нет безопасного пути.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429042&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'069eb3ed-bb74-4120-bd25-4be56ae621d8\', \'multiverseId\': 429042}, \'multiverseid\': 429042}, {\'name\': \'蜘蛛之攫\', \'text\': \'重置目标生物。直到回合结束，它得+2/+4且获得延势异能。（它能阻挡具飞行异能的生物。）\', \'type\': \'瞬间\', \'flavor\': \'力量祀炼没有捷径可钻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429311&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b6f5fcc-b133-487f-971d-b1e6e6271fd3\', \'multiverseId\': 429311}, \'multiverseid\': 429311}, {\'name\': \'蜘蛛之攫\', \'text\': \'重置目標生物。直到回合結束，它得+2/+4且獲得延勢異能。（它能阻擋具飛行異能的生物。）\', \'type\': \'瞬間\', \'flavor\': \'力量祀煉沒有捷徑可鑽。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429580&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae4ffa03-4b95-4d6f-9411-c9684d0e11f8\', \'multiverseId\': 429580}, \'multiverseid\': 429580}]', '[{\'name\': \'Starkherz-Duellantin\', \'text\': \'Die Starkherz-Duellantin kann in jedem Kampf eine zusätzliche Kreatur blocken.\\nEinbalsamieren {2}{W} ({2}{W}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Mensch-Krieger ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427006&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95d40323-3d73-47a7-8bac-3d2540a157de\', \'multiverseId\': 427006}, \'multiverseid\': 427006}, {\'name\': \'Duelista almafirme\', \'text\': \'La Duelista almafirme puede bloquear una criatura adicional cada combate.\\nEmbalsamar {2}{W}. ({2}{W}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Guerrero Humano Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'955fb263-e564-44d4-a4c3-1b4071406198\', \'multiverseId\': 427275}, \'multiverseid\': 427275}, {\'name\': \'Duelliste au cœur pur\', \'text\': "La Duelliste au cœur pur peut bloquer une créature supplémentaire à chaque combat.\\nEmbaumement {2}{W} ({2}{W}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et humain et guerrier blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427544&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94eaca90-1094-489c-b290-09c29203570c\', \'multiverseId\': 427544}, \'multiverseid\': 427544}, {\'name\': \'Duellante dal Cuore Saldo\', \'text\': \'La Duellante dal Cuore Saldo può bloccare una creatura addizionale in ogni combattimento.\\nImbalsamare {2}{W} ({2}{W}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Guerriero Umano Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427813&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'54790eec-f1b3-454c-8a63-40e8e03fb9f5\', \'multiverseId\': 427813}, \'multiverseid\': 427813}, {\'name\': \'信念の決闘者\', \'text\': \'各戦闘で、信念の決闘者は追加で１体のクリーチャーをブロックできる。\\n不朽{2}{W}（{2}{W}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・人間・戦士であることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428082&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cf5aa6c5-199b-483a-8fec-50f3af78c488\', \'multiverseId\': 428082}, \'multiverseid\': 428082}, {\'name\': \'순수한 정신의 결투사\', \'text\': \'순수한 정신의 결투사는 매 전투마다 생물 한 개를 추가로 방어할 수 있다.\\n방부처리 {2}{W} ({2}{W}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 인간 전사다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428351&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'87de156f-a548-4303-ba5f-bbff1a71867b\', \'multiverseId\': 428351}, \'multiverseid\': 428351}, {\'name\': \'Duelista de Coração-puro\', \'text\': \'Duelista de Coração-puro pode bloquear uma criatura adicional a cada combate.\\nEmbalsamar {2}{W} ({2}{W}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Humano Guerreiro branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428620&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c696fa96-f642-44ae-aa90-62c26c6069d9\', \'multiverseId\': 428620}, \'multiverseid\': 428620}, {\'name\': \'Непреклонная Дуэлянтка\', \'text\': \'Непреклонная Дуэлянтка может блокировать дополнительное существо в каждом бою.\\nБальзамирование {2}{W} ({2}{W}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Человеком Воином без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428889&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c6cdf2a-0b5d-4958-abc9-4e88433e1b54\', \'multiverseId\': 428889}, \'multiverseid\': 428889}, {\'name\': \'至诚斗客\', \'text\': \'至诚斗客每次战斗可以额外多阻挡一个生物。\\n遗存{2}{W}（{2}{W}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／人类／战士，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429158&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2457062b-b4c8-44d0-94ab-fa865fc0bb74\', \'multiverseId\': 429158}, \'multiverseid\': 429158}, {\'name\': \'至誠鬥客\', \'text\': \'至誠鬥客每次戰鬥可以額外多阻擋一個生物。\\n遺存{2}{W}（{2}{W}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／人類／戰士，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429427&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8f3092f-5f9b-48ee-a3d8-4696017cc869\', \'multiverseId\': 429427}, \'multiverseid\': 429427}]', '[{\'name\': \'Starkherz-Zwillinge\', \'text\': \'Du kannst die Starkherz-Zwillinge erschöpfen, sowie sie angreifen. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\\nImmer wenn du eine Kreatur erschöpfst, erhalten Kreaturen, die du kontrollierst, +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Schakal, Krieger\', \'flavor\': \'Seite an Seite, bis Klinge auf Klinge trifft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427124&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aae013e2-0d6f-4486-be70-3fe79947ff8d\', \'multiverseId\': 427124}, \'multiverseid\': 427124}, {\'name\': \'Mellizos almafirme\', \'text\': \'Puedes espolear a los Mellizos almafirme en cuanto ataquen. (No se enderezarán durante tu próximo paso de enderezar.)\\nSiempre que espolees una criatura, las criaturas que controlas obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero chacal\', \'flavor\': \'Codo con codo hasta que el filo deba volverse contra el filo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427393&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'05140c81-df2c-4244-8f17-f64ef9b15a7c\', \'multiverseId\': 427393}, \'multiverseid\': 427393}, {\'name\': \'Jumeaux au cœur pur\', \'text\': "Vous pouvez surmener les Jumeaux au cœur pur au moment où ils attaquent. (Ils ne se dégagent pas pendant votre prochaine étape de dégagement.)\\nÀ chaque fois que vous surmenez une créature, les créatures que vous contrôlez gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : chacal et guerrier\', \'flavor\': "Côte à côte jusqu\'à ce que leurs lames soient face à face.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427662&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'269eff7e-db8f-4ef1-81f8-dcbc88d4e8e9\', \'multiverseId\': 427662}, \'multiverseid\': 427662}, {\'name\': \'Gemelli dal Cuore Saldo\', \'text\': \'Puoi stremare i Gemelli dal Cuore Saldo mentre attaccano. (Non STAPperanno durante il tuo prossimo STAP.)\\nOgniqualvolta stremi una creatura, le creature che controlli prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Sciacallo\', \'flavor\': \'Fianco a fianco finché non verrà il momento di incrociare le lame.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427931&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'094bb015-9633-41d8-9e13-e2c66ad32ec7\', \'multiverseId\': 427931}, \'multiverseid\': 427931}, {\'name\': \'信念の双子\', \'text\': \'信念の双子が攻撃するに際し、あなたはこれを督励してもよい。（これはあなたの次のアンタップ・ステップにアンタップしない。）\\nあなたがクリーチャーを１体督励するたび、ターン終了時まで、あなたがコントロールするクリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ジャッカル・戦士\', \'flavor\': \'刃を向かい合わせねばならぬ日までは一心同体。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428200&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'959816d3-2d7e-4ee6-866a-b2db609566dc\', \'multiverseId\': 428200}, \'multiverseid\': 428200}, {\'name\': \'순수정신 쌍둥이\', \'text\': \'당신은 순수정신 쌍둥이로 공격을 선언하면서 순수정신 쌍둥이를 분전시킬 수 있다. (이 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\\n당신이 생물을 분전시킬 때마다, 당신이 조종하는 생물들은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 자칼 전사\', \'flavor\': \'칼날이 서로 닿을 만큼 어깨를 맞대고 함께 싸운다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428469&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f22e9839-f2a2-4580-8a7c-bfded28b146d\', \'multiverseId\': 428469}, \'multiverseid\': 428469}, {\'name\': \'Gêmeos de Coração-puro\', \'text\': \'Você pode exaurir Gêmeos de Coração-puro conforme ele ataca. (Ele não será desvirado durante sua próxima etapa de desvirar.)\\nToda vez que você exaure uma criatura, as criaturas que você controla recebem +1/+0 até o final do turno.\', \'type\': \'Criatura — Chacal Guerreiro\', \'flavor\': \'Ombro a ombro até que seja preciso voltar lâmina contra lâmina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428738&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'17f02274-c6ed-46e4-ae57-bc9c48d93f30\', \'multiverseId\': 428738}, \'multiverseid\': 428738}, {\'name\': \'Непреклонные Близнецы\', \'text\': \'Вы можете подстегнуть Непреклонных Близнецов в момент их атаки. (Они не развернутся во время вашего следующего шага разворота.)\\nКаждый раз, когда вы подстегиваете существо, существа под вашим контролем получают +1/+0 до конца хода.\', \'type\': \'Существо — Шакал Воин\', \'flavor\': \'Плечом к плечу — до тех пор, пока клинок не обратится против клинка.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429007&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d5029323-ef8f-4b10-a8ca-8eba8615f976\', \'multiverseId\': 429007}, \'multiverseid\': 429007}, {\'name\': \'赤诚双子\', \'text\': \'你可以于赤诚双子攻击时耗竭之。（它于其操控者的下一个重置步骤中不能重置。）\\n每当你耗竭一个生物时，由你操控的生物得+1/+0直到回合结束。\', \'type\': \'生物～豺狼／战士\', \'flavor\': \'齐心克敌，最后终需反目相弑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429276&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ddb9eae9-2eda-422b-864a-3094ff4e4f45\', \'multiverseId\': 429276}, \'multiverseid\': 429276}, {\'name\': \'赤誠雙子\', \'text\': \'你可以於赤誠雙子攻擊時耗竭之。（它於其操控者的下一個重置步驟中不能重置。）\\n每當你耗竭一個生物時，由你操控的生物得+1/+0直到回合結束。\', \'type\': \'生物～豺狼／戰士\', \'flavor\': \'齊心克敵，最後終需反目相弒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429545&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'44fd7ac0-536a-4c10-83bc-5fa469062017\', \'multiverseId\': 429545}, \'multiverseid\': 429545}]', '[{\'name\': \'Steinbruch\', \'text\': \'Der Steinbruch kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Ganze Berge werden von Mumien abgetragen, auf der Suche nach Lazotep für ihre Meister.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429720&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'122bc926-c4da-45fb-ab5a-e4ae9bfde8a5\', \'multiverseId\': 429720}, \'multiverseid\': 429720}, {\'name\': \'Pedrera\', \'text\': \'La Pedrera entra al campo de batalla girada.\\n{T}: Agrega {R} o {W} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Las momias crean valles enteros cuando trabajan en busca de vetas de lazotep.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429846&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c78371bc-ff8c-461d-804b-b9a5e90d827b\', \'multiverseId\': 429846}, \'multiverseid\': 429846}, {\'name\': \'Carrière de pierre\', \'text\': \'La Carrière de pierre arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {R} ou {W} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': \'Des vallées entières ont été creusées par des momies à la recherche de filons de lazotèpe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429738&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ae835e1-a980-4dd9-a04a-dbbf7defad90\', \'multiverseId\': 429738}, \'multiverseid\': 429738}, {\'name\': \'Cava di Pietra\', \'text\': \'La Cava di Pietra entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {R} o {W} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "Intere vallate sono state formate dall\'instancabile lavoro delle mummie alla ricerca di filoni di lazotep.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429756&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'854f22b2-d3ae-4165-9c5a-d9bd08360ee7\', \'multiverseId\': 429756}, \'multiverseid\': 429756}, {\'name\': \'採石場\', \'text\': \'採石場はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{R}か{W}を加える。\', \'type\': \'土地\', \'flavor\': \'この谷すべてが、ラゾテプの鉱脈を求めるミイラの労働によって出来上がった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429774&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a3bde1a6-0268-4345-bc1a-bcb8e7c53f74\', \'multiverseId\': 429774}, \'multiverseid\': 429774}, {\'name\': \'채석장\', \'text\': \'채석장은 탭된 채로 전장에 들어온다.\\n{T}: {R} 또는 {W}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'라조텝의 광맥을 찾아 노동하는 미라들이 계곡 전체를 만들었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429792&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b18b9b83-0f96-44c2-9551-1868e529cdb8\', \'multiverseId\': 429792}, \'multiverseid\': 429792}, {\'name\': \'Pedreira\', \'text\': \'Pedreira entra no campo de batalha virada.\\n{T}: Adicione {R} ou {W} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Vales inteiros foram formados por múmias trabalhando em busca de veios de lazotep.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0bf6f4b-706c-49bd-8b02-0db59009e858\', \'multiverseId\': 429810}, \'multiverseid\': 429810}, {\'name\': \'Каменоломня\', \'text\': \'Каменоломня выходит на поле битвы повернутой.\\n{T}: добавьте {R} или {W} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Мумии без устали трудятся в поисках лазотеповых жил, оставляя за собой целые долины в горах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429828&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84778e6d-0303-471a-9954-ec247ad90372\', \'multiverseId\': 429828}, \'multiverseid\': 429828}, {\'name\': \'采石场\', \'text\': \'采石场须横置进战场。\\n{T}：加{R}或{W}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'为探寻拉佐特石矿脉，木乃伊苦力已将整座山谷开辟成这般模样。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429684&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce305b40-1738-4d18-bc98-34d7b23d6609\', \'multiverseId\': 429684}, \'multiverseid\': 429684}, {\'name\': \'採石場\', \'text\': \'採石場須橫置進戰場。\\n{T}：加{R}或{W}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'為探尋拉佐特石礦脈，木乃伊苦力已將整座山谷開闢成這般模樣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429702&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ca26a591-4888-4d7d-9f05-2cd3e8c14e59\', \'multiverseId\': 429702}, \'multiverseid\': 429702}]', "[{'name': 'Steinbruch-Schlepper', 'text': 'Wenn der Steinbruch-Schlepper ins Spiel kommt, erhält eine bleibende Karte deiner Wahl für jede Sorte von Marke, die auf ihr liegt, eine weitere Marke dieser Sorte oder eine Marke dieser Sorte wird von ihr entfernt.', 'type': 'Kreatur — Kamel', 'flavor': 'Sie arbeiten Seite an Seite mit den Gesalbten, um die gigantischen Monumente Naktamuns zu errichten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427152&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2bd6c2b6-03a8-437c-b70f-7cb8da5998bd', 'multiverseId': 427152}, 'multiverseid': 427152}, {'name': 'Porteador de la cantera', 'text': 'Cuando el Porteador de la cantera entre al campo de batalla, por cada tipo de contador sobre el permanente objetivo, pon otro contador de ese tipo sobre él o remueve uno de él.', 'type': 'Criatura — Camello', 'flavor': 'Su labor junto a los ungidos es la de construir los descomunales monumentos de Naktamun.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427421&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '773794d4-c2e1-48ac-9db0-30587ddece98', 'multiverseId': 427421}, 'multiverseid': 427421}, {'name': 'Transporteur des carrières', 'text': 'Quand le Transporteur des carrières arrive sur le champ de bataille, pour chaque type de marqueur sur le permanent ciblé, mettez un autre marqueur de ce type sur lui ou retirez-lui en un.', 'type': 'Créature : chameau', 'flavor': 'Il travaille aux côtés de ceux qui ont été consacrés, érigeant les impressionnants monuments de Naktamon.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427690&type=card', 'language': 'French', 'identifiers': {'scryfallId': '46b6f3af-dae8-4528-9615-ce91ee4c5bb5', 'multiverseId': 427690}, 'multiverseid': 427690}, {'name': 'Bestia da Carico della Cava', 'text': 'Quando la Bestia da Carico della Cava entra nel campo di battaglia, per ogni tipo di segnalino su un permanente bersaglio, metti un altro segnalino di quel tipo su di esso o rimuovine uno da esso.', 'type': 'Creatura — Cammello', 'flavor': 'Lavorano a fianco dei consacrati per costruire i grandiosi monumenti di Naktamun.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427959&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8af59d43-3dff-4b19-974c-40badbbf1f26', 'multiverseId': 427959}, 'multiverseid': 427959}, {'name': '採石場の運び屋', 'text': '採石場の運び屋が戦場に出たとき、パーマネント１つを対象とし、それの上に置かれているカウンター１種類につきそれぞれ、その種類のカウンターをそれの上にもう１個置くかそれの上から１個取り除く。', 'type': 'クリーチャー — ラクダ', 'flavor': '選定された者とともに働き、ナクタムンの巨大な碑を築く。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428228&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '96eb32dd-a15e-425b-860b-f3b1e158b934', 'multiverseId': 428228}, 'multiverseid': 428228}, {'name': '채석장 운반꾼', 'text': '채석장 운반꾼이 전장에 들어올 때, 지속물을 목표로 정한다. 그 지속물에 놓여 있는 각 카운터 종류 하나당, 그 지속물에 같은 종류의 카운터 한 개를 올려놓거나 카운터 한 개를 제거한다.', 'type': '생물 — 낙타', 'flavor': '낙타들은 세례받은 자들 옆에서 일하며 나크타문의 방대한 기념비들을 건설한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428497&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '304b87a6-f0cc-4b0a-adf5-d89d938072f7', 'multiverseId': 428497}, 'multiverseid': 428497}, {'name': 'Carregador da Pedreira', 'text': 'Quando Carregador da Pedreira entrar no campo de batalha, para cada tipo de marcador na permanente alvo, coloque nela outro marcador daquele tipo ou remova um.', 'type': 'Criatura — Camelo', 'flavor': 'Eles trabalham ao lado dos ungidos, construindo os vastos monumentos de Nactamon.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428766&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '19b02d7f-191c-4d21-ab0a-ceac28cafb45', 'multiverseId': 428766}, 'multiverseid': 428766}, {'name': 'Тяжеловоз с Каменоломни', 'text': 'Когда Тяжеловоз с Каменоломни выходит на поле битвы, за каждый вид жетонов на целевом перманенте положите на него еще один жетон такого вида или удалите с него один такой жетон.', 'type': 'Существо — Верблюд', 'flavor': 'Они трудятся вместе с умащенными, возводя колоссальные монументы Нактамуна.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429035&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5617a649-1d1a-43b2-a9fb-1df4fafa0b83', 'multiverseId': 429035}, 'multiverseid': 429035}, {'name': '驮石骆驼', 'text': '当驮石骆驼进战场时，对目标永久物上每种指示物而言，在其上放置另一个该种类的指示物或从其上移去一个该种类的指示物。', 'type': '生物～骆驼', 'flavor': '拿塔蒙各处庞大纪念碑的建筑工地上，都有它们与圣洗者的劳作身影。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429304&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5c96db62-8030-48c4-9d91-c6d432a0029d', 'multiverseId': 429304}, 'multiverseid': 429304}, {'name': '馱石駱駝', 'text': '當馱石駱駝進戰場時，對目標永久物上每種指示物而言，在其上放置另一個該種類的指示物或從其上移去一個該種類的指示物。', 'type': '生物～駱駝', 'flavor': '拿塔蒙各處龐大紀念碑的建築工地上，都有牠們與聖洗者的勞作身影。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429573&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '561addb1-df02-4e86-835c-a948783e38f2', 'multiverseId': 429573}, 'multiverseid': 429573}]", '[{\'name\': \'Stille Weite\', \'text\': \'Die Stille Weite kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Fernab des Chaos von Ghirapur liegt eine pulsierende Welt, in der Äther die Natur durchströmt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429732&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bee977fe-ea65-4812-a72a-d5ad2b7e9725\', \'multiverseId\': 429732}, \'multiverseid\': 429732}, {\'name\': \'Extensión tranquila\', \'text\': \'La Extensión tranquila entra al campo de batalla girada.\\n{T}: Agrega {G} o {W} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Más allá del caos de Ghirapur existe un mundo vivo donde el éter fluye por la naturaleza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429858&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66027e7f-b36a-40c9-a14c-d70932fec06e\', \'multiverseId\': 429858}, \'multiverseid\': 429858}, {\'name\': \'Immensité tranquille\', \'text\': "L\'Immensité tranquille arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {G} ou {W} à votre réserve.", \'type\': \'Terrain\', \'flavor\': "Au-delà du chaos de Ghirapur, se trouve un monde vivant où l\'Éther circule dans la nature.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ebf68a30-7d70-4275-952d-1baeeb88064f\', \'multiverseId\': 429750}, \'multiverseid\': 429750}, {\'name\': \'Distesa Tranquilla\', \'text\': \'La Distesa Tranquilla entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {G} o {W} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "Oltre il caos di Ghirapur si estende un mondo lussureggiante dove l\'etere scorre tra la vegetazione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429768&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'748e0d24-c66e-4cd4-ab92-a03000d3c5e1\', \'multiverseId\': 429768}, \'multiverseid\': 429768}, {\'name\': \'平穏なる広野\', \'text\': \'平穏なる広野はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}か{W}を加える。\', \'type\': \'土地\', \'flavor\': \'ギラプールの混沌の背後には、自然の中に霊気が循環する鮮烈な世界が広がっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429786&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5d242fd-1ed1-427d-a4a3-859c35413e20\', \'multiverseId\': 429786}, \'multiverseid\': 429786}, {\'name\': \'평온한 광야\', \'text\': \'평온한 광야는 탭된 채로 전장에 들어온다.\\n{T}: {G} 또는 {W}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'기라푸르의 혼돈 너머에는 에테르가 자연을 통해 흐르는 생기 넘치는 세상이 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429804&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3d78f2d2-6fcb-4e00-a782-10d51b79d01e\', \'multiverseId\': 429804}, \'multiverseid\': 429804}, {\'name\': \'Vastidão Tranquila\', \'text\': \'Vastidão Tranquila entra no campo de batalha virada.\\n{T}: Adicione {G} ou {W} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Para além do caos de Ghirapur há um mundo vibrante onde o éter flui pela natureza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429822&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09a0f3b0-f5c4-4da7-8039-0ec97628c492\', \'multiverseId\': 429822}, \'multiverseid\': 429822}, {\'name\': \'Безмятежная Долина\', \'text\': \'Безмятежная Долина выходит на поле битвы повернутой.\\n{T}: добавьте {G} или {W} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'За границами шумного Гирапура раскинулся яркий, живой мир природы, пронизанный потоками эфира.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429840&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'80750150-03e2-4991-bb16-ab969e8bbd47\', \'multiverseId\': 429840}, \'multiverseid\': 429840}, {\'name\': \'静谧旷野\', \'text\': \'静谧旷野须横置进战场。\\n{T}：加{G}或{W}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'在混乱不堪的吉拉波之外，是一片生机盎然的世界，那里的乙太在自然中川流不息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429696&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0ee10d6-005f-4592-b8c5-0fc2b47c3b37\', \'multiverseId\': 429696}, \'multiverseid\': 429696}, {\'name\': \'靜謐曠野\', \'text\': \'靜謐曠野須橫置進戰場。\\n{T}：加{G}或{W}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'在混亂不堪的吉拉波之外，是一片生機盎然的世界，那裡的乙太在自然中川流不息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429714&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a59baa7e-f6e9-4b7c-89a9-792bb1d6aee2\', \'multiverseId\': 429714}, \'multiverseid\': 429714}]', '[{\'name\': \'Streben nach Ruhm\', \'text\': \'Angreifende Kreaturen erhalten +2/+0 bis zum Ende des Zuges.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Für uns ist der Kampf eine Form von Lobgesang. Jeder Hieb ein feierliches Gebet." —Pytamun, Geweihter der Nef-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427118&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b5862ae-5d99-4eb8-8138-3a5748a5785d\', \'multiverseId\': 427118}, \'multiverseid\': 427118}, {\'name\': \'Perseguir la gloria\', \'text\': \'Las criaturas atacantes obtienen +2/+0 hasta el final del turno.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"El combate es una forma de adoración; el choque del metal, una plegaria solemne". —Pytamun, iniciado de la simiente Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427387&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1845ebb5-1707-4a3b-8eca-4abd599be637\', \'multiverseId\': 427387}, \'multiverseid\': 427387}, {\'name\': \'Courir après la gloire\', \'text\': "Les créatures attaquantes gagnent +2/+0 jusqu\'à la fin du tour.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': \'« Le combat est une forme de vénération, et le fracas des armes une prière solennelle. » —Pytamon, adepte de la moisson Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427656&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9a1979c-b63e-45d1-ab36-155f089bdfba\', \'multiverseId\': 427656}, \'multiverseid\': 427656}, {\'name\': \'Perseguire la Gloria\', \'text\': \'Le creature attaccanti prendono +2/+0 fino alla fine del turno.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Il combattimento è una forma di venerazione e il clangore dell\\\'acciaio una preghiera solenne." —Pytamun, iniziato della messe Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427925&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'496452fc-184e-4952-bec7-a1d17694a1a8\', \'multiverseId\': 427925}, \'multiverseid\': 427925}, {\'name\': \'栄光の探究\', \'text\': \'ターン終了時まで、攻撃クリーチャーは＋２/＋０の修整を受ける。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「戦闘は崇拝の形、鋼の衝突は祈祷。」 ――ネフ一門の修練者、ピタムン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428194&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d38d6619-180f-4c26-b469-f43402427eae\', \'multiverseId\': 428194}, \'multiverseid\': 428194}, {\'name\': \'영광 추구\', \'text\': \'공격생물들은 턴종료까지 +2/+0을 받는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"전투는 경배의 한 양식으로, 독실한 기도자들의 무력 충돌이다." —네프 입문자의 입회자 피타문\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428463&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5e21f3f8-c29b-41c8-b3eb-2d524330cc20\', \'multiverseId\': 428463}, \'multiverseid\': 428463}, {\'name\': \'Perseguir a Glória\', \'text\': \'As criaturas atacantes recebem +2/+0 até o final do turno.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O combate é uma forma de adoração, o choque do aço, uma oração solene." — Pitamon, iniciado da safra Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428732&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fbf077c0-8b82-4407-91bb-422caf0662a3\', \'multiverseId\': 428732}, \'multiverseid\': 428732}, {\'name\': \'Погоня за Славой\', \'text\': \'Атакующие существа получают +2/+0 до конца хода.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Бой — это тоже ритуал поклонения, а звон стали — торжественная молитва». — Питамун, послушник снопа Неф\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429001&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b8fe26da-525c-4926-8f08-1e705bed0dc1\', \'multiverseId\': 429001}, \'multiverseid\': 429001}, {\'name\': \'追逐荣耀\', \'text\': \'进行攻击的生物得+2/+0直到回合结束。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「战斗是崇拜的一种形式，钢铁互击即是庄严祷告。」 ～奈法祀群祀徒拜塔蒙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429270&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fbad950-e1e9-4060-8f17-e7884e2d2614\', \'multiverseId\': 429270}, \'multiverseid\': 429270}, {\'name\': \'追逐榮耀\', \'text\': \'進行攻擊的生物得+2/+0直到回合結束。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「戰鬥是崇拜的一種形式，鋼鐵互擊即是莊嚴禱告。」 ～奈法祀群祀徒拜塔蒙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429539&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'57cfdc56-35b9-4757-9981-10ca4ed98b1a\', \'multiverseId\': 429539}, \'multiverseid\': 429539}]', '[{\'name\': \'Strömungsweberin\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {C}{C}.\', \'type\': \'Kreatur — Naga, Druide\', \'flavor\': \'„Deine Wasser erhalten die Lebenden und verschlingen die Toten. Mächtiger Luxa, lasse deine Kräfte durch mich fließen!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427180&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9281d035-b22b-4cf0-ae03-22f012dec707\', \'multiverseId\': 427180}, \'multiverseid\': 427180}, {\'name\': \'Tejedora de corrientes\', \'text\': \'{T}: Agrega {C}{C} a tu reserva de maná.\', \'type\': \'Criatura — Druida naga\', \'flavor\': \'"Tus aguas sustentan a los vivos y llevan a los muertos. ¡Poderoso Luxa, permite que tu poder fluya a través de mí!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427449&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3edf3d38-c1d1-4b73-8bb9-274fabd43722\', \'multiverseId\': 427449}, \'multiverseid\': 427449}, {\'name\': \'Tisseuse des courants\', \'text\': \'{T} : Ajoutez {C}{C} à votre réserve.\', \'type\': \'Créature : naga et druide\', \'flavor\': \'« Tes eaux cultivent la vie et transportent la mort. Ô grand Luxa, verse ta puissance en moi ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427718&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a195d186-44b8-47ad-99fa-c4867b33285a\', \'multiverseId\': 427718}, \'multiverseid\': 427718}, {\'name\': \'Tessitrice delle Correnti\', \'text\': \'{T}: Aggiungi {C}{C} alla tua riserva di mana.\', \'type\': \'Creatura — Druido Naga\', \'flavor\': \'"Le tue acque offrono sostentamento ai vivi e trasportano i morti. Impetuoso Luxa, lascia che il tuo potere fluisca dentro di me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427987&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c9d077f-2214-45cd-b64b-3539ee90f6bc\', \'multiverseId\': 427987}, \'multiverseid\': 427987}, {\'name\': \'水流織り\', \'text\': \'{T}：あなたのマナ・プールに{C}{C}を加える。\', \'type\': \'クリーチャー — ナーガ・ドルイド\', \'flavor\': \'「この水が生者を育み死者を運ぶ。偉大なるルクサよ、その力を我に流したまえ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428256&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71d1ba24-2b2d-49b3-b21c-e93a7820c978\', \'multiverseId\': 428256}, \'multiverseid\': 428256}, {\'name\': \'해류 조종자\', \'text\': \'{T}: {C}{C}를 당신의 마나풀에 담는다.\', \'type\': \'생물 — 나가 드루이드\', \'flavor\': \'"물은 산 자의 생명을 유지하고 망자를 실어 나른다. 전능한 럭사여, 당신의 힘이 내게 흐르게 하소서!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428525&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'66b4f6bc-b66d-46e0-9940-0d0fa08f887b\', \'multiverseId\': 428525}, \'multiverseid\': 428525}, {\'name\': \'Tecelã de Correntes\', \'text\': \'{T}: Adicione {C}{C} à sua reserva de mana.\', \'type\': \'Criatura — Naga Druida\', \'flavor\': \'"Suas águas sustentam os vivos e carregam os mortos. Poderoso Luxa, deixe seu poder fluir por mim!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428794&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8c8af2e5-3315-4f17-b72e-e06a31eacc7f\', \'multiverseId\': 428794}, \'multiverseid\': 428794}, {\'name\': \'Плетельщица Течений\', \'text\': \'{T}: добавьте {C}{C} в ваше хранилище маны.\', \'type\': \'Существо — Нага Друид\', \'flavor\': \'«Твои воды кормят живых и несут мертвых. Могучая Лукса, да потечет через меня твоя сила!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429063&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd52b2d5-1429-4499-9241-d539178dbdf3\', \'multiverseId\': 429063}, \'multiverseid\': 429063}, {\'name\': \'织流师\', \'text\': \'{T}：加{C}{C}到你的法术力池中。\', \'type\': \'生物～那伽／德鲁伊\', \'flavor\': \'「滔滔流水，维系生命，送走亡灵。愿罗夏河洪流之力充盈我身！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429332&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d292601c-d4ee-46e3-b735-3cb89e73b709\', \'multiverseId\': 429332}, \'multiverseid\': 429332}, {\'name\': \'織流師\', \'text\': \'{T}：加{C}{C}到你的魔法力池中。\', \'type\': \'生物～那伽／德魯伊\', \'flavor\': \'「滔滔流水，維繫生命，送走亡靈。願羅夏河洪流之力充盈我身！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429601&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0f53b1f9-cf0d-4b46-a369-0ff8dc107185\', \'multiverseId\': 429601}, \'multiverseid\': 429601}]', "[{'name': 'Sturmschlag', 'text': 'Bringe eine getappte Kreatur deiner Wahl auf die Hand ihres Besitzers zurück.\\nZiehe eine Karte.', 'type': 'Spontanzauber', 'flavor': 'Manchmal ist viel heiße Luft schon genug.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427025&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd2986e28-470f-498b-899e-ded1e0c6069d', 'multiverseId': 427025}, 'multiverseid': 427025}, {'name': 'Golpegalerna', 'text': 'Regresa la criatura girada objetivo a la mano de su propietario.\\nRoba una carta.', 'type': 'Instantáneo', 'flavor': 'Unas alas fuertes generan vientos fuertes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427294&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a5994625-80dc-4564-bb4d-bd3c4c2061d8', 'multiverseId': 427294}, 'multiverseid': 427294}, {'name': 'Frappe de la bourrasque', 'text': 'Renvoyez une créature engagée ciblée dans la main de son propriétaire.\\nPiochez une carte.', 'type': 'Éphémère', 'flavor': 'Des ailes puissantes engendrent des vents violents.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427563&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c9326384-a48b-46ef-a92b-a8d195de3190', 'multiverseId': 427563}, 'multiverseid': 427563}, {'name': 'Colpo di Vento', 'text': 'Fai tornare una creatura TAPpata bersaglio in mano al suo proprietario.\\nPesca una carta.', 'type': 'Istantaneo', 'flavor': 'Le ali forti causano forti venti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427832&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5663d109-815e-4295-b20c-7d1257741bf2', 'multiverseId': 427832}, 'multiverseid': 427832}, {'name': '突風撃', 'text': 'タップ状態のクリーチャー１体を対象とし、それをオーナーの手札に戻す。\\nカードを１枚引く。', 'type': 'インスタント', 'flavor': '強力な翼は強力な風を生む。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428101&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6b09f8c3-9fcf-40ac-a8b4-d79d42e372df', 'multiverseId': 428101}, 'multiverseid': 428101}, {'name': '돌풍공격', 'text': '탭된 생물을 목표로 정한다. 그 생물을 소유자의 손으로 되돌린다.\\n카드 한 장을 뽑는다.', 'type': '순간마법', 'flavor': '강한 날개가 강한 바람을 일으킨다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428370&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '7f8517ef-0798-4fcd-abd0-fd1761be735e', 'multiverseId': 428370}, 'multiverseid': 428370}, {'name': 'Golpe do Vendaval', 'text': 'Devolva a criatura virada alvo para a mão de seu dono.\\nCompre um card.', 'type': 'Mágica Instantânea', 'flavor': 'Asas fortes fazem ventos fortes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428639&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f4fc0660-1d67-42b4-bc29-1f6df03c430d', 'multiverseId': 428639}, 'multiverseid': 428639}, {'name': 'Порыв Бури', 'text': 'Верните целевое повернутое существо в руку его владельца.\\nВозьмите карту.', 'type': 'Мгновенное заклинание', 'flavor': 'Могучие крылья порождают могучие ветра.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428908&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '81d10285-778e-435f-bb11-b3291fcc5abe', 'multiverseId': 428908}, 'multiverseid': 428908}, {'name': '啸风击', 'text': '将目标已横置的生物移回其拥有者手上。\\n抓一张牌。', 'type': '瞬间', 'flavor': '劲翅鼓烈风。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429177&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8df6394c-3027-40c7-a8f2-042c7f9825c9', 'multiverseId': 429177}, 'multiverseid': 429177}, {'name': '嘯風擊', 'text': '將目標已橫置的生物移回其擁有者手上。\\n抽一張牌。', 'type': '瞬間', 'flavor': '勁翅鼓烈風。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429446&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '8cc5438a-7b9d-42dd-ba35-bcf26279ed95', 'multiverseId': 429446}, 'multiverseid': 429446}]", '[{\'name\': \'Störrisches Kudu\', \'text\': \'Wenn das Störrische Kudu ins Spiel kommt, lege eine -1/-1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Antilope\', \'flavor\': \'Unter den Wesiren herrscht Uneinigkeit darüber, ob der Vergleich von Kuduhörnern mit denen des Gott-Pharaos nun Blasphemie oder Ehrerbietung ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427149&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3472064f-1257-40f4-be51-61e02e70f23f\', \'multiverseId\': 427149}, \'multiverseid\': 427149}, {\'name\': \'Kudú iracundo\', \'text\': \'Cuando el Kudú iracundo entre al campo de batalla, pon un contador -1/-1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Antílope\', \'flavor\': \'Existe un acalorado debate entre los visires sobre si comparar los cuernos del kudú al Dios Faraón es blasfemia o veneración.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427418&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4afc817-3633-4549-9512-92e422cc6c84\', \'multiverseId\': 427418}, \'multiverseid\': 427418}, {\'name\': \'Koudou hargneux\', \'text\': \'Quand le Koudou hargneux arrive sur le champ de bataille, mettez un marqueur -1/-1 sur une créature ciblée que vous contrôlez.\', \'type\': \'Créature : antilope\', \'flavor\': \'Personne ne sait si comparer les cornes du koudou à celles du Dieu-Pharaon est un blasphème ou un signe de révérence, pas même les vizirs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1bf419ac-bdf2-4160-8f9d-2cfa91b67785\', \'multiverseId\': 427687}, \'multiverseid\': 427687}, {\'name\': \'Kudu Irascibile\', \'text\': \'Quando il Kudu Irascibile entra nel campo di battaglia, metti un segnalino -1/-1 su una creatura bersaglio che controlli.\', \'type\': \'Creatura — Antilope\', \'flavor\': "C\'è un acceso dibattito tra i visir: alcuni pensano che paragonare le corna del kudu a quelle del Dio Faraone sia blasfemo, altri credono che sia una forma di venerazione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427956&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8406bae1-9b25-4e64-9fe4-0a58d2cc50f5\', \'multiverseId\': 427956}, \'multiverseid\': 427956}, {\'name\': \'気性の荒いクーズー\', \'text\': \'気性の荒いクーズーが戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'クリーチャー — アンテロープ\', \'flavor\': \'クーズーの角を王神の角と比較するのは涜神にあたるかどうか、侍臣たちの間で論争が持ち上がっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428225&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4adf6a69-c4e2-469d-b54e-b2732069029a\', \'multiverseId\': 428225}, \'multiverseid\': 428225}, {\'name\': \'성질 더러운 쿠두\', \'text\': \'성질 더러운 쿠두가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 영양\', \'flavor\': \'쿠두의 뿔과 신 파라오의 뿔을 비교하는 게 신성모독인지 경배인지를 두고 고관들끼리 격론을 벌인다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428494&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'708a5dfe-7d36-441c-97ac-d2109c42c0eb\', \'multiverseId\': 428494}, \'multiverseid\': 428494}, {\'name\': \'Kudu Turrão\', \'text\': \'Quando Kudu Turrão entrar no campo de batalha, coloque um marcador -1/-1 na criatura alvo que você controla.\', \'type\': \'Criatura — Antílope\', \'flavor\': \'Os vizires têm opiniões divergentes quanto à comparação dos chifres do kudu aos do Faraó-Deus. Alguns dizem que seja uma blasfêmia, outros uma forma de reverência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428763&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5166a7f5-b745-469f-a361-798a4cf900d6\', \'multiverseId\': 428763}, \'multiverseid\': 428763}, {\'name\': \'Норовистый Куду\', \'text\': \'Когда Норовистый Куду выходит на поле битвы, положите один жетон -1/-1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Антилопа\', \'flavor\': \'Среди визирей не утихают споры о том, чем является сравнение рогов куду с рогами Бога-Фараона: богохульством или проявлением почтения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429032&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cab26d7a-742b-49bc-85cc-cd9cdb7a8ff0\', \'multiverseId\': 429032}, \'multiverseid\': 429032}, {\'name\': \'暴躁捻角羚\', \'text\': \'当暴躁捻角羚进战场时，在目标由你操控的生物上放置一个-1/-1指示物。\', \'type\': \'生物～羚羊\', \'flavor\': \'拿法老神尊角与羚羊长角相提并论到底算是亵渎还是崇敬，诸位维齐尔激烈争辩，莫衷一是。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429301&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cc178846-e775-42fa-9c65-4f2d082321e9\', \'multiverseId\': 429301}, \'multiverseid\': 429301}, {\'name\': \'暴躁捻角羚\', \'text\': \'當暴躁捻角羚進戰場時，在目標由你操控的生物上放置一個-1/-1指示物。\', \'type\': \'生物～羚羊\', \'flavor\': \'拿法老神尊角與羚羊長角相提並論到底算是褻瀆還是崇敬，諸位維齊爾激烈爭辯，莫衷一是。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429570&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f020979b-7d9c-4d44-a639-831098dd73fe\', \'multiverseId\': 429570}, \'multiverseid\': 429570}]', '[{\'name\': \'Sucher der Einsicht\', \'text\': \'{T}: Ziehe eine Karte und wirf dann eine Karte ab. Aktiviere diese Fähigkeit nur, falls du in diesem Zug einen Nichtkreatur-Zauberspruch gewirkt hast.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Die Prüfung des Wissens fordert den Verstand und erweitert den Horizont der Geweihten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427040&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b5607d85-5ce6-4260-bd67-054214a6db81\', \'multiverseId\': 427040}, \'multiverseid\': 427040}, {\'name\': \'Buscador de conocimiento\', \'text\': \'{T}: Roba una carta, luego descarta una carta. Activa esta habilidad solo si lanzaste un hechizo que no sea de criatura este turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'La Prueba de conocimiento desafía y expande las mentes de los iniciados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427309&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf652e47-0ab1-4ff6-a300-0090912b4c0a\', \'multiverseId\': 427309}, \'multiverseid\': 427309}, {\'name\': \'Chercheur de perspicacité\', \'text\': "{T} : Piochez une carte, puis défaussez-vous d\'une carte. N\'activez cette capacité que si vous avez lancé un sort non-créature ce tour-ci.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "L\'Épreuve de connaissance stimule l\'esprit des adeptes et élargit leurs horizons.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427578&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'034e7b95-e4f3-4fd3-abcf-e98de5459106\', \'multiverseId\': 427578}, \'multiverseid\': 427578}, {\'name\': \'Cercatore di Sapienza\', \'text\': \'{T}: Pesca una carta, poi scarta una carta. Attiva questa abilità solo se hai lanciato una magia non creatura in questo turno.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "L\'Ordalia della Conoscenza mette alla prova e amplia le menti degli iniziati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427847&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e34580c9-cfbe-4a65-8479-f54f4edeb13b\', \'multiverseId\': 427847}, \'multiverseid\': 427847}, {\'name\': \'洞察の探求者\', \'text\': \'{T}：カードを１枚引き、その後カード１枚を捨てる。この能力は、あなたがこのターンにクリーチャーでない呪文を唱えていたときにのみ起動できる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'知識の試練では修練者の精神が試され視野を広げる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428116&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7c38dfd-acb2-4275-90a2-eb124977a1c9\', \'multiverseId\': 428116}, \'multiverseid\': 428116}, {\'name\': \'통찰의 추구자\', \'text\': \'{T}: 카드 한 장을 뽑은 후 카드 한 장을 버린다. 당신이 이 턴에 생물이 아닌 주문을 발동한 경우에만 이 능력을 활성화할 수 있다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'지식의 시험은 입회자들의 정신을 시험하고 확장한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428385&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d946e539-f495-4569-b2a8-e763279104f9\', \'multiverseId\': 428385}, \'multiverseid\': 428385}, {\'name\': \'Buscador do Discernimento\', \'text\': \'{T}: Compre um card e depois descarte um card. Ative esta habilidade somente se você tiver conjurado uma mágica que não seja de criatura neste turno.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'A Prova do Conhecimento desafia e expande as mentes dos iniciados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428654&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a875301b-fea6-42d3-99ac-12bf318159f8\', \'multiverseId\': 428654}, \'multiverseid\': 428654}, {\'name\': \'Искатель Озарения\', \'text\': \'{T}: возьмите карту, затем сбросьте карту. Активируйте эту способность, только если в этом ходу вы уже разыграли не являющееся существом заклинание.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Испытание Знания становится проверкой разума послушника, одновременно расширяя его границы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428923&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40dd3ea4-9f75-46fa-ae36-74a84e7555f5\', \'multiverseId\': 428923}, \'multiverseid\': 428923}, {\'name\': \'探解客\', \'text\': \'{T}：抓一张牌，然后弃一张牌。只能于你施放过非生物咒语的回合中起动此异能。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'知识祀炼能挑战并拓展祀徒的心智。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429192&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5967a818-4ad6-46ec-924a-3c4e3cd7af20\', \'multiverseId\': 429192}, \'multiverseid\': 429192}, {\'name\': \'探解客\', \'text\': \'{T}：抽一張牌，然後棄一張牌。只能於你施放過非生物咒語的回合中起動此異能。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'知識祀煉能挑戰並拓展祀徒的心智。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429461&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa93c72b-7819-4c43-8b99-5132ea84b691\', \'multiverseId\': 429461}, \'multiverseid\': 429461}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427223&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e20cd4ff-dfef-49bc-98d3-c03574d287e5', 'multiverseId': 427223}, 'multiverseid': 427223}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427492&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6bfb3d6c-7ac6-4255-9582-101221200e19', 'multiverseId': 427492}, 'multiverseid': 427492}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427761&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e4eb54e1-d7a0-4d05-acd5-ddff43568b07', 'multiverseId': 427761}, 'multiverseid': 427761}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428030&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dba56335-8042-49ea-b39c-3e0e81202c71', 'multiverseId': 428030}, 'multiverseid': 428030}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428299&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3f5b2f07-dae3-445f-a974-4d5e1f2375b0', 'multiverseId': 428299}, 'multiverseid': 428299}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428568&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '5ee4113d-0801-490f-942b-c49fa01d4631', 'multiverseId': 428568}, 'multiverseid': 428568}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428837&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1c8e06e6-0333-4732-ac02-11f9fe3e52bc', 'multiverseId': 428837}, 'multiverseid': 428837}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429106&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e6520253-f9dc-4b39-85e4-4cc74c5c1327', 'multiverseId': 429106}, 'multiverseid': 429106}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429375&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fdf8396e-81c0-4f09-bd75-4ba83be3faae', 'multiverseId': 429375}, 'multiverseid': 429375}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429644&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '050e7021-9eff-4ebd-9318-26cbf7aaa652', 'multiverseId': 429644}, 'multiverseid': 429644}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427232&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4f37fe67-238c-4f73-a655-9b99cfe92f1e', 'multiverseId': 427232}, 'multiverseid': 427232}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427501&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3a6dfdca-43d7-4a75-b77c-b9d6c6aae235', 'multiverseId': 427501}, 'multiverseid': 427501}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427770&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b7719452-6599-4a59-b11a-4fa8faace67e', 'multiverseId': 427770}, 'multiverseid': 427770}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428039&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '096cff5c-86eb-4877-8c27-787d9ffd735c', 'multiverseId': 428039}, 'multiverseid': 428039}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428308&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4fb82942-ac7e-4c33-9eb8-fd3828bcd379', 'multiverseId': 428308}, 'multiverseid': 428308}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428577&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e5e86a40-c421-4dce-b4d7-6d9d7ca56964', 'multiverseId': 428577}, 'multiverseid': 428577}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428846&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2abcb217-e424-4796-81f1-f4adffbffb26', 'multiverseId': 428846}, 'multiverseid': 428846}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429115&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fdb84c25-984f-44d4-aba5-9e280c44675a', 'multiverseId': 429115}, 'multiverseid': 429115}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429384&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5d91056e-75ef-4ec3-bd05-f9cce788e343', 'multiverseId': 429384}, 'multiverseid': 429384}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429653&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '04226120-528f-460a-8cd2-e560a4193983', 'multiverseId': 429653}, 'multiverseid': 429653}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427233&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b21fbf0c-17e0-4529-a2b2-221ff3306378', 'multiverseId': 427233}, 'multiverseid': 427233}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427502&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '677b5ed8-df91-4df2-9236-8c9452aa3122', 'multiverseId': 427502}, 'multiverseid': 427502}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427771&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f0b31b7d-d37a-4440-ab3a-22bc7c992bc1', 'multiverseId': 427771}, 'multiverseid': 427771}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428040&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bcb0b9e9-47a2-4e0c-84c4-748f90076177', 'multiverseId': 428040}, 'multiverseid': 428040}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428309&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bd951c17-8bc5-4319-8d0f-29247c1cb554', 'multiverseId': 428309}, 'multiverseid': 428309}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428578&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a8b3ead6-d806-41f7-a62b-916885d18497', 'multiverseId': 428578}, 'multiverseid': 428578}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428847&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'acda0e23-8179-420b-b2a4-b6e57edc14e1', 'multiverseId': 428847}, 'multiverseid': 428847}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429116&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8b8852a3-1595-43d4-9c5a-846c36c32633', 'multiverseId': 429116}, 'multiverseid': 429116}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429385&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd7cfd9f6-da53-45c0-99d4-f68c1ee8a913', 'multiverseId': 429385}, 'multiverseid': 429385}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429654&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0d32ef00-fbbd-4bb1-a16a-35776b594b49', 'multiverseId': 429654}, 'multiverseid': 429654}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427234&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a5af39c8-4152-4c1b-ad60-d46043e04a13', 'multiverseId': 427234}, 'multiverseid': 427234}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427503&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e55f5691-311f-45f0-a05e-bb1884155c84', 'multiverseId': 427503}, 'multiverseid': 427503}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427772&type=card', 'language': 'French', 'identifiers': {'scryfallId': '716410e0-d93c-404f-8970-e2844c2a9410', 'multiverseId': 427772}, 'multiverseid': 427772}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428041&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd1c87fd0-14b1-4205-96b5-0cf840b9d928', 'multiverseId': 428041}, 'multiverseid': 428041}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428310&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '662fa537-9e71-4b0f-a019-eafa29f6d5da', 'multiverseId': 428310}, 'multiverseid': 428310}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428579&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8b3b240c-1cca-4500-b50e-8d9773cbd315', 'multiverseId': 428579}, 'multiverseid': 428579}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428848&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5dd8e3f5-25ee-45e1-8756-1053bd0dc68f', 'multiverseId': 428848}, 'multiverseid': 428848}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429117&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b9d355c7-247e-49f3-9cbe-f12248b593e7', 'multiverseId': 429117}, 'multiverseid': 429117}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429386&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6faf331c-e48f-4fbf-9968-719e341d18e3', 'multiverseId': 429386}, 'multiverseid': 429386}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429655&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '00b73e5f-296e-4846-95a0-03a56139be59', 'multiverseId': 429655}, 'multiverseid': 429655}]", '[{\'name\': \'Temmet, Wesir von Naktamun\', \'text\': \'Zu Beginn des Kampfes in deinem Zug erhält ein Kreaturenspielstein deiner Wahl, den du kontrollierst, +1/+1 bis zum Ende des Zuges und kann in diesem Zug nicht geblockt werden.\\nEinbalsamieren {3}{W}{U} ({3}{W}{U}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Mensch-Kleriker ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Legendäre Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427178&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d1b310bb-c111-4f43-a17f-9a0eddf3d655\', \'multiverseId\': 427178}, \'multiverseid\': 427178}, {\'name\': \'Temmet, visir de Naktamun\', \'text\': \'Al comienzo del combate en tu turno, la ficha de criatura objetivo que controlas obtiene +1/+1 hasta el final del turno y no puede ser bloqueada este turno.\\nEmbalsamar {3}{W}{U}. ({3}{W}{U}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Clérigo Humano Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura legendaria — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0fe06519-b49d-4718-9d03-b06b930e1831\', \'multiverseId\': 427447}, \'multiverseid\': 427447}, {\'name\': \'Temmet, vizir de Naktamon\', \'text\': "Au début du combat pendant votre tour, un jeton de créature ciblé que vous contrôlez gagne +1/+1 jusqu\'à la fin du tour et ne peut pas être bloqué ce tour-ci.\\nEmbaumement {3}{W}{U} ({3}{W}{U}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et humain et clerc blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427716&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee8f1a49-54bf-47cf-bfc3-31e602cffe7b\', \'multiverseId\': 427716}, \'multiverseid\': 427716}, {\'name\': \'Temmet, Visir di Naktamun\', \'text\': "All\'inizio del combattimento nel tuo turno, una pedina creatura bersaglio che controlli prende +1/+1 fino alla fine del turno e non può essere bloccata in questo turno.\\nImbalsamare {3}{W}{U} ({3}{W}{U}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Chierico Umano Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)", \'type\': \'Creatura Leggendaria — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427985&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6491d57d-ef61-46d8-9e61-33e8ee9da148\', \'multiverseId\': 427985}, \'multiverseid\': 427985}, {\'name\': \'ナクタムンの侍臣、テムメト\', \'text\': \'あなたのターンの戦闘の開始時に、あなたがコントロールするクリーチャー・トークン１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受けるとともに、このターン、それはブロックされない。\\n不朽{3}{W}{U}（{3}{W}{U}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・人間・クレリックであることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428254&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c241591-052d-41af-880e-32102682ecb3\', \'multiverseId\': 428254}, \'multiverseid\': 428254}, {\'name\': \'나크타문의 고관 테멧\', \'text\': \'당신의 턴 전투 시작에, 당신이 조종하는 생물 토큰을 목표로 정한다. 그 생물 토큰은 턴종료까지 +1/+1을 받고 이 턴에 방어될 수 없다.\\n방부처리 {3}{W}{U} ({3}{W}{U}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 인간 성직자다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'전설적 생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428523&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dae62eda-1c93-4c93-916a-040dd1d501bd\', \'multiverseId\': 428523}, \'multiverseid\': 428523}, {\'name\': \'Temmet, Vizir de Nactamon\', \'text\': \'No início do combate em seu turno, a ficha de criatura alvo que você controla recebe +1/+1 até o final do turno e não pode ser bloqueada neste turno.\\nEmbalsamar {3}{W}{U} ({3}{W}{U}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Humano Clérigo branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura Lendária — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428792&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'514024b7-e841-4673-bffd-9bd14ad0466c\', \'multiverseId\': 428792}, \'multiverseid\': 428792}, {\'name\': \'Теммет, Визирь Нактамуна\', \'text\': \'В начале боя во время вашего хода целевая фишка существа под вашим контролем получает +1/+1 до конца хода и не может быть заблокирована в этом ходу.\\nБальзамирование {3}{W}{U} ({3}{W}{U}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Человеком Священником без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Легендарное Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429061&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ff306697-0e6d-4e66-a603-abab9d9c13d2\', \'multiverseId\': 429061}, \'multiverseid\': 429061}, {\'name\': \'拿塔蒙维齐尔蒂穆特\', \'text\': \'在你回合的战斗开始时，目标由你操控的衍生生物得+1/+1直到回合结束，且本回合不能被阻挡。\\n遗存{3}{W}{U}（{3}{W}{U}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／人类／僧侣，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'传奇生物～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429330&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a6362c6-daef-48a3-b641-14a0eb51a8c6\', \'multiverseId\': 429330}, \'multiverseid\': 429330}, {\'name\': \'拿塔蒙維齊爾蒂穆特\', \'text\': \'在你回合的戰鬥開始時，目標由你操控的衍生生物得+1/+1直到回合結束，且本回合不能被阻擋。\\n遺存{3}{W}{U}（{3}{W}{U}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／人類／僧侶，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'傳奇生物～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429599&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'22228237-6a4b-46f5-9d9a-df4892374b32\', \'multiverseId\': 429599}, \'multiverseid\': 429599}]', '[{\'name\': \'Thron des Gott-Pharaos\', \'text\': \'Zu Beginn deines Endsegments verliert jeder Gegner so viele Lebenspunkte, wie du getappte Kreaturen kontrollierst.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Wenn die Zweite Sonne zwischen den Hörnern am Horizont zum Ruhen kommt, beginnt die Stunde der Offenbarung. Ihr folgen die Stunde des Ruhms, die Stunde der Verheißung und schließlich die Stunde der Ewigkeit." —Das Buch der Stunden\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427208&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e1491d9-395a-4745-8440-f9ddc3981e7f\', \'multiverseId\': 427208}, \'multiverseid\': 427208}, {\'name\': \'Trono del Dios Faraón\', \'text\': \'Al comienzo de tu paso final, cada oponente pierde una cantidad de vidas igual a la cantidad de criaturas giradas que controlas.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"Cuando el Segundo Sol descanse entre los cuernos en el horizonte, la Hora de la Revelación habrá llegado. A esta le seguirán la Hora de la Gloria, la Hora de la Promesa y, finalmente, la Hora de la Eternidad". —Las Revelaciones de las Horas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427477&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15c1e69a-4ddf-4482-a2d2-7381eefbaf6d\', \'multiverseId\': 427477}, \'multiverseid\': 427477}, {\'name\': \'Trône du Dieu-Pharaon\', \'text\': \'Au début de votre étape de fin, chaque adversaire perd un nombre de points de vie égal au nombre de créatures engagées que vous contrôlez.\', \'type\': \'Artefact légendaire\', \'flavor\': "« Le Second Soleil passera entre les cornes à l\'horizon, et ainsi commencera l\'Âge de la Révélation. Viendront ensuite l\'Âge de la Gloire, l\'Âge de la Promesse et enfin l\'Âge de l\'Éternité. » —Le corpus des âges", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'066387dd-38a7-47a6-9333-05027827ead5\', \'multiverseId\': 427746}, \'multiverseid\': 427746}, {\'name\': \'Trono del Dio Faraone\', \'text\': "All\'inizio della tua sottofase finale, ogni avversario perde punti vita pari al numero di creature TAPpate che controlli.", \'type\': \'Artefatto Leggendario\', \'flavor\': \'"Quando il secondo sole riposerà tra le corna all\\\'orizzonte, avrà inizio l\\\'Era della rivelazione. Poi verranno l\\\'Era della gloria, l\\\'Era della promessa e infine l\\\'Era dell\\\'eternità." —Il Conto delle Ere\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'64bfaf44-1aa4-4591-9c19-c4a87236b491\', \'multiverseId\': 428015}, \'multiverseid\': 428015}, {\'name\': \'王神の玉座\', \'text\': \'あなたの終了ステップの開始時に、各対戦相手はそれぞれあなたがコントロールするタップ状態のクリーチャーの総数に等しい点数のライフを失う。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'「副陽が地平の二つ角の間に入ったとき、啓示の刻が始まる。その後、栄光の刻、約束の刻、永遠の刻と続く。」 ――刻の書\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428284&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0529224c-15dd-4a13-a8a6-324b81d37c5a\', \'multiverseId\': 428284}, \'multiverseid\': 428284}, {\'name\': \'신 파라오의 왕좌\', \'text\': \'당신의 종료단 시작에, 각 상대는 당신이 조종하는 탭된 생물의 개수만큼 생명력을 잃는다.\', \'type\': \'전설적 마법물체\', \'flavor\': \'"두 번째 태양이 지평선의 두 뿔 사이에 머무르면 계시의 시간이 시작된다. 그런 다음 영광의 시간, 약속의 시간, 영원의 시간 순으로 이어진다." —시간의 서\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428553&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e2c71324-fea8-452b-8db2-2dc845097721\', \'multiverseId\': 428553}, \'multiverseid\': 428553}, {\'name\': \'Trono do Faraó-Deus\', \'text\': \'No início de sua etapa final, cada oponente perde uma quantidade de pontos de vida igual ao número de criaturas viradas que você controla.\', \'type\': \'Artefato Lendário\', \'flavor\': \'"Quando o Segundo Sol jazer entre os chifres no horizonte, terá início a Hora da Revelação. Essa será seguida pela Hora da Glória, pela Hora da Promessa e, por fim, pela Hora da Eternidade. — O Registro das Horas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428822&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a12bf576-5aba-4a83-b725-b71514574b91\', \'multiverseId\': 428822}, \'multiverseid\': 428822}, {\'name\': \'Трон Бога-Фараона\', \'text\': \'В начале вашего заключительного шага каждый оппонент теряет количество жизней, равное количеству повернутых существ под вашим контролем.\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'«Когда Второе Солнце окажется меж рогов на горизонте, начнется Час Откровения. За ним придет Час Славы, потом Час Завета, и наконец — Час Вечности». — «Исчисление Часов»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429091&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b5cd3aa-b656-4cc8-9f08-3874925a6d82\', \'multiverseId\': 429091}, \'multiverseid\': 429091}, {\'name\': \'法老神王座\', \'text\': \'在你的结束步骤开始时，每位对手各失去若干生命，其数量等同于由你操控且已横置的生物数量。\', \'type\': \'传奇神器\', \'flavor\': \'「神日位落天际尊角正中之时，正是预示时刻之始。继而是荣光时刻、允诺时刻，最后到永恒时刻。」 ～《时刻全志》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429360&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3aa8fd1-c550-4424-b202-4b77e862058e\', \'multiverseId\': 429360}, \'multiverseid\': 429360}, {\'name\': \'法老神王座\', \'text\': \'在你的結束步驟開始時，每位對手各失去若干生命，其數量等同於由你操控且已橫置的生物數量。\', \'type\': \'傳奇神器\', \'flavor\': \'「神日位落天際尊角正中之時，正是預示時刻之始。繼而是榮光時刻、允諾時刻，最後到永恆時刻。」 ～《時刻全志》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429629&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'49e7de9f-b1c1-429e-844f-d43e6aabf3d6\', \'multiverseId\': 429629}, \'multiverseid\': 429629}]', '[{\'name\': \'Todgeweihter Abtrünniger\', \'text\': \'Wenn der Todgeweihte Abtrünnige stirbt, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein.\', \'type\': \'Kreatur — Mensch\', \'flavor\': \'Wer aus der Stadt des Gott-Pharaos verstoßen wurde, hat nur noch einen einzigen Weg vor sich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427058&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3c1a63e-8c44-4049-9e5d-3633c78ff6b6\', \'multiverseId\': 427058}, \'multiverseid\': 427058}, {\'name\': \'Disidente condenado\', \'text\': \'Cuando el Disidente condenado muera, crea una ficha de criatura Zombie negra 2/2.\', \'type\': \'Criatura — Humano\', \'flavor\': \'Solo hay un final para los desterrados de la ciudad del Dios Faraón.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427327&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'edbe4014-1147-4bf8-a358-d535cfffba5d\', \'multiverseId\': 427327}, \'multiverseid\': 427327}, {\'name\': \'Dissident damné\', \'text\': \'Quand le Dissident damné meurt, créez un jeton de créature 2/2 noire Zombie.\', \'type\': \'Créature : humain\', \'flavor\': "Il n\'y a qu\'un sort réservé à ceux qui ont été bannis de la ville du Dieu-Pharaon.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427596&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f3db8899-fbb8-4bad-83d5-7ff294d3afcb\', \'multiverseId\': 427596}, \'multiverseid\': 427596}, {\'name\': \'Dissenziente Condannato\', \'text\': \'Quando il Dissenziente Condannato muore, crea una pedina creatura Zombie 2/2 nera.\', \'type\': \'Creatura — Umano\', \'flavor\': \'Un unico destino attende coloro che sono stati banditi dalla città del Dio Faraone.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427865&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'75955170-0e54-4b3a-aded-35bb43bb1758\', \'multiverseId\': 427865}, \'multiverseid\': 427865}, {\'name\': \'悪運尽きた造反者\', \'text\': \'悪運尽きた造反者が死亡したとき、黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — 人間\', \'flavor\': \'王神の街から追放された者を待つ運命はただ一つだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428134&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c1c443bd-d0da-43d7-a6af-3f634e66f3e3\', \'multiverseId\': 428134}, \'multiverseid\': 428134}, {\'name\': \'불운한 반대자\', \'text\': \'불운한 반대자가 죽을 때, 2/2 흑색 좀비 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 인간\', \'flavor\': \'신 파라오의 도시에서 추방된 자에게는 하나의 운명만이 기다린다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428403&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'db2013a1-2a34-4f61-a878-a31e99b989b3\', \'multiverseId\': 428403}, \'multiverseid\': 428403}, {\'name\': \'Dissidente Condenado\', \'text\': \'Quando Dissidente Condenado morrer, crie uma ficha de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Criatura — Humano\', \'flavor\': \'Aos banidos da cidade do Faraó-Deus resta apenas um destino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428672&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fef8918-f216-47c5-a1e9-b5f614f1316d\', \'multiverseId\': 428672}, \'multiverseid\': 428672}, {\'name\': \'Обреченный Инакомыслящий\', \'text\': \'Когда Обреченный Инакомыслящий умирает, создайте одну фишку существа 2/2 черный Зомби.\', \'type\': \'Существо — Человек\', \'flavor\': \'Тех, кого изгоняют из города Бога-Фараона, ожидает лишь одна участь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428941&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24a33cb5-9ed3-4ad5-9f08-b18bba4333c9\', \'multiverseId\': 428941}, \'multiverseid\': 428941}, {\'name\': \'注亡逆徒\', \'text\': \'当注亡逆徒死去时，派出一个2/2黑色灵俑衍生生物。\', \'type\': \'生物～人类\', \'flavor\': \'被逐出法老神城市的人，面前只有一种命运。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429210&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'43e00305-1572-4e18-bae5-641f64e6f51a\', \'multiverseId\': 429210}, \'multiverseid\': 429210}, {\'name\': \'註亡逆徒\', \'text\': \'當註亡逆徒死去時，派出一個2/2黑色殭屍衍生生物。\', \'type\': \'生物～人類\', \'flavor\': \'被逐出法老神城市的人，面前只有一種命運。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429479&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9e0ebfe-4bf1-4542-b951-83290219f670\', \'multiverseId\': 429479}, \'multiverseid\': 429479}]', '[{\'name\': \'Tor zum Jenseits\', \'text\': \'Immer wenn eine Nichtspielsteinkreatur, die du kontrollierst, stirbt, erhältst du 1 Lebenspunkt dazu. Dann kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\\n{2}, {T}, opfere das Tor zum Jenseits: Durchsuche deinen Friedhof, deine Hand und/oder deine Bibliothek nach einer Karte namens Gabe des Gott-Pharaos und bringe sie ins Spiel. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach. Aktiviere diese Fähigkeit nur, falls sich sechs oder mehr Kreaturenkarten in deinem Friedhof befinden.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427199&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1b120bdd-576b-4cc5-869d-7b83aab6a5ac\', \'multiverseId\': 427199}, \'multiverseid\': 427199}, {\'name\': \'Portal al más allá\', \'text\': \'Siempre que una criatura que no sea ficha que controlas muera, ganas 1 vida. Luego, puedes robar una carta. Si lo haces, descarta una carta.\\n{2}, {T}, sacrificar el Portal al más allá: Busca en tu cementerio, mano y/o biblioteca una carta llamada Obsequio del Dios Faraón y ponla en el campo de batalla. Si buscas en tu biblioteca de esta manera, barájala. Activa esta habilidad solo si hay seis o más cartas de criatura en tu cementerio.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427468&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'990983e9-5365-4d96-ad71-73b7d45d60e5\', \'multiverseId\': 427468}, \'multiverseid\': 427468}, {\'name\': "Portail vers l\'au-delà", \'text\': "À chaque fois qu\'une créature non-jeton que vous contrôlez meurt, vous gagnez 1 point de vie. Vous pouvez ensuite piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.\\n{2}, {T}, sacrifiez le Portail vers l\'au-delà : Cherchez dans votre cimetière, votre main et/ou votre bibliothèque une carte appelée Don du Dieu-Pharaon et mettez-la sur le champ de bataille. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la. N\'activez cette capacité que s\'il y a au moins six cartes de créature dans votre cimetière.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427737&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c56c1da6-0746-4ed7-8282-742906f1c65b\', \'multiverseId\': 427737}, \'multiverseid\': 427737}, {\'name\': "Cancelli dell\'Aldilà", \'text\': "Ogniqualvolta una creatura non pedina che controlli muore, guadagni 1 punto vita. Poi puoi pescare una carta. Se lo fai, scarta una carta.\\n{2}, {T}, Sacrifica i Cancelli dell\'Aldilà: Passa in rassegna il tuo cimitero, la tua mano e/o il tuo grimorio per una carta chiamata Dono del Dio Faraone e mettila sul campo di battaglia. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo. Attiva questa abilità solo se ci sono sei o più carte creatura nel tuo cimitero.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428006&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cdec8969-a0e5-42f9-b203-a7f002f22ad3\', \'multiverseId\': 428006}, \'multiverseid\': 428006}, {\'name\': \'来世への門\', \'text\': \'あなたがコントロールするトークンでないクリーチャーが１体死亡するたび、あなたは１点のライフを得る。その後あなたはカードを１枚引いてもよい。そうしたなら、カード１枚を捨てる。\\n{2}, {T}, 来世への門を生け贄に捧げる：あなたの墓地やあなたの手札やあなたのライブラリーから「王神の贈り物」という名前のカード１枚を探し、それを戦場に出す。これによりあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。この能力は、あなたの墓地にクリーチャー・カードが６枚以上あるときにのみ起動できる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428275&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57276ba7-1801-4894-9937-1bb22acf740d\', \'multiverseId\': 428275}, \'multiverseid\': 428275}, {\'name\': \'사후세계로의 관문\', \'text\': \'당신이 조종하는 토큰이 아닌 생물이 죽을 때마다, 당신은 생명 1점을 얻는다. 그 후 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\\n{2}, {T}, 사후세계로의 관문을 희생한다: 당신의 무덤, 손 및/또는 서고에서 이름이 신 파라오의 선물인 카드 한 장을 찾아 전장에 놓는다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다. 이 능력은 당신의 무덤에 생물 카드가 여섯 장 이상 있을 때에만 활성화할 수 있다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428544&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d7d09c56-5fdd-4fab-9d71-150ee9107ac8\', \'multiverseId\': 428544}, \'multiverseid\': 428544}, {\'name\': \'Portão para o Além\', \'text\': \'Toda vez que uma criatura que não seja uma ficha que você controla morre, você ganha 1 ponto de vida. Em seguida, você pode comprar um card. Se fizer isso, descarte um card.\\n{2}, {T}, Sacrifique Portão para o Além: Procure em seu cemitério, mão e/ou grimório um card com o nome Dádiva do Faraó-Deus e coloque-o no campo de batalha. Se procurar em seu grimório dessa maneira, embaralhe-o. Ative esta habilidade somente se houver seis ou mais cards de criatura em seu cemitério.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31e543c9-0d2d-4ee4-bec6-524884f2b492\', \'multiverseId\': 428813}, \'multiverseid\': 428813}, {\'name\': \'Врата в Загробную Жизнь\', \'text\': \'Каждый раз, когда не являющееся фишкой существо под вашим контролем умирает, вы получаете 1 жизнь. Затем вы можете взять карту. Если вы это делаете, сбросьте карту.\\n{2}, {T}, пожертвуйте Врата в Загробную Жизнь: найдите на вашем кладбище, в руке и (или) в библиотеке карту с именем Дар Бога-Фараона и положите ее на поле битвы. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее. Активируйте эту способность, только если на вашем кладбище есть не менее шести карт существ.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429082&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e2e8128-3576-4699-ad65-d0893fffd578\', \'multiverseId\': 429082}, \'multiverseid\': 429082}, {\'name\': \'来世之门\', \'text\': \'每当一个由你操控且非衍生物的生物死去时，你获得1点生命。然后你可以抓一张牌。若你如此作，则弃一张牌。\\n{2}，{T}，牺牲来世之门：从你的坟墓场，手牌和／或牌库中搜寻一张名称为法老神赋礼的牌，并将之放进战场。如果你以此法搜寻你的牌库，则将它洗牌。只能于你的坟墓场中有六张或更多生物牌时起动此异能。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429351&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14f5976d-b8ea-414f-8002-21d0b5f48cab\', \'multiverseId\': 429351}, \'multiverseid\': 429351}, {\'name\': \'來世之門\', \'text\': \'每當一個由你操控且非衍生物的生物死去時，你獲得1點生命。然後你可以抽一張牌。若你如此作，則棄一張牌。\\n{2}，{T}，犧牲來世之門：從你的墳墓場，手牌和／或牌庫中搜尋一張名稱為法老神賦禮的牌，並將之放進戰場。如果你以此法搜尋你的牌庫，則將它洗牌。只能於你的墳墓場中有六張或更多生物牌時起動此異能。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429620&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'07b17fb1-2ec1-4476-b1a0-83b5db4fc8ff\', \'multiverseId\': 429620}, \'multiverseid\': 429620}]', '[{\'name\': \'Totengräber\', \'text\': \'Wenn der Totengräber ins Spiel kommt, kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurückbringen.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Was der Wind nicht von allein freilegt, wird von anderer Hand wieder ausgegraben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427064&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'50cd0959-a1fd-4a80-96ba-2c7a7eb5af07\', \'multiverseId\': 427064}, \'multiverseid\': 427064}, {\'name\': \'Sepulturero\', \'text\': \'Cuando el Sepulturero entre al campo de batalla, puedes regresar la carta de criatura objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'En las arenas siempre cambiantes de Amonkhet, nada permanece enterrado mucho tiempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427333&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dec80235-75cc-4e9b-9206-a425587e517c\', \'multiverseId\': 427333}, \'multiverseid\': 427333}, {\'name\': \'Fossoyeur\', \'text\': \'Quand le Fossoyeur arrive sur le champ de bataille, vous pouvez renvoyer une carte de créature ciblée depuis votre cimetière dans votre main.\', \'type\': \'Créature : zombie\', \'flavor\': "Rien ne reste enterré bien longtemps dans les sables en perpétuel mouvement d\'Amonkhet.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427602&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bf175f61-e06b-465b-88f9-527252b35a99\', \'multiverseId\': 427602}, \'multiverseid\': 427602}, {\'name\': \'Scavatombe\', \'text\': \'Quando lo Scavatombe entra nel campo di battaglia, puoi riprendere in mano una carta creatura bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Zombie\', \'flavor\': \'Niente resta sepolto a lungo sotto le sabbie in perenne movimento di Amonkhet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427871&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1875352-ce0f-453f-9e64-168337d4c3a8\', \'multiverseId\': 427871}, \'multiverseid\': 427871}, {\'name\': \'グレイブディガー\', \'text\': \'グレイブディガーが戦場に出たとき、あなたの墓地からクリーチャー・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'アモンケットの砂は絶えず流動する。埋もれたままの物はない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428140&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'223b9fb1-fb2e-46e2-9927-e544c39bd2c9\', \'multiverseId\': 428140}, \'multiverseid\': 428140}, {\'name\': \'시체 도둑\', \'text\': \'시체 도둑이 전장에 들어올 때, 당신의 무덤에 있는 생물 카드를 목표로 정한다. 당신은 그 카드를 당신의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 좀비\', \'flavor\': \'아몬케트의 모래는 언제나 변화무쌍해서 묻혀 있던 것도 금세 모습을 드러낸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428409&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'62217609-1b3b-4d9e-8a82-10ad90409b8e\', \'multiverseId\': 428409}, \'multiverseid\': 428409}, {\'name\': \'Coveiro\', \'text\': \'Quando Coveiro entra no campo de batalha, você pode devolver o card de criatura alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Nas areias sempre em movimento de Amonkhet, nada permanece enterrado por muito tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428678&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fdd18356-5b10-4d73-9630-ab3d80eedf54\', \'multiverseId\': 428678}, \'multiverseid\': 428678}, {\'name\': \'Могильщик\', \'text\': \'Когда Могильщик выходит на поле битвы, вы можете вернуть целевую карту существа из вашего кладбища в вашу руку.\', \'type\': \'Существо — Зомби\', \'flavor\': \'В беспокойных песках Амонхета ничто не остается похороненным надолго.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428947&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f47178f0-7949-4410-bf32-85b4c7460f7b\', \'multiverseId\': 428947}, \'multiverseid\': 428947}, {\'name\': \'掘墓怪\', \'text\': \'当掘墓怪进战场时，你可以将目标生物牌从你的坟墓场移回你手上。\', \'type\': \'生物～灵俑\', \'flavor\': \'在阿芒凯的流沙之下，谁都无法长久安息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429216&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb4cba43-e0b7-426c-a796-b0ecffc7b8e1\', \'multiverseId\': 429216}, \'multiverseid\': 429216}, {\'name\': \'掘墓怪\', \'text\': \'當掘墓怪進戰場時，你可以將目標生物牌從你的墳墓場移回你手上。\', \'type\': \'生物～殭屍\', \'flavor\': \'在阿芒凱的流沙之下，誰都無法長久安息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429485&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5b1b6d0e-ef3c-4c1a-87f9-a40b7971ece2\', \'multiverseId\': 429485}, \'multiverseid\': 429485}]', '[{\'name\': \'Trotzendes Riesenmaul\', \'text\': \'Wenn das Trotzende Riesenmaul ins Spiel kommt, lege zwei -1/-1-Marken auf eine Kreatur deiner Wahl, die du kontrollierst.\\nImmer wenn du eine oder mehrere -1/-1-Marken auf das Trotzende Riesenmaul legst, entferne eine -1/-1-Marke von einer anderen Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Flusspferd\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427134&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'46955706-25c1-45a1-8d9d-fdcadcd682db\', \'multiverseId\': 427134}, \'multiverseid\': 427134}, {\'name\': \'Granfauces desafiante\', \'text\': \'Cuando el Granfauces desafiante entre al campo de batalla, pon dos contadores -1/-1 sobre la criatura objetivo que controlas.\\nSiempre que pongas uno o más contadores -1/-1 sobre el Granfauces desafiante, remueve un contador -1/-1 de otra criatura objetivo que controlas.\', \'type\': \'Criatura — Hipopótamo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60663b6a-3ca1-4bfb-8b93-b386ea19e5a9\', \'multiverseId\': 427403}, \'multiverseid\': 427403}, {\'name\': \'Gueule du fleuve provocatrice\', \'text\': "Quand la Gueule du fleuve provocatrice arrive sur le champ de bataille, mettez deux marqueurs -1/-1 sur une créature ciblée que vous contrôlez.\\nÀ chaque fois que vous mettez au moins un marqueur -1/-1 sur la Gueule du fleuve provocatrice, retirez un marqueur -1/-1 d\'une autre créature ciblée que vous contrôlez.", \'type\': \'Créature : hippopotame\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427672&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a746d93-319b-4134-9bec-077f742ce5dc\', \'multiverseId\': 427672}, \'multiverseid\': 427672}, {\'name\': \'Granfauce Sprezzante\', \'text\': "Quando il Granfauce Sprezzante entra nel campo di battaglia, metti due segnalini -1/-1 su una creatura bersaglio che controlli.\\nOgniqualvolta metti uno o più segnalini -1/-1 sul Granfauce Sprezzante, rimuovi un segnalino -1/-1 da un\'altra creatura bersaglio che controlli.", \'type\': \'Creatura — Ippopotamo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427941&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7102bfdd-b2f4-4ecb-a3d4-3a51fce7598d\', \'multiverseId\': 427941}, \'multiverseid\': 427941}, {\'name\': \'好戦的な巨口\', \'text\': \'好戦的な巨口が戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを２個置く。\\nあなたが好戦的な巨口の上に－１/－１カウンターを１個以上置くたび、あなたがコントロールする他のクリーチャー１体を対象とし、それの上から－１/－１カウンターを１個取り除く。\', \'type\': \'クリーチャー — カバ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428210&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'33afb92c-e65a-408a-90d8-8a79d484046a\', \'multiverseId\': 428210}, \'multiverseid\': 428210}, {\'name\': \'거만한 큰입하마\', \'text\': \'거만한 큰입하마가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 두 개를 올려놓는다.\\n거만한 큰입하마에 -1/-1 카운터를 한 개 이상 올려놓을 때마다, 당신이 조종하는 다른 생물을 목표로 정한다. 그 생물에서 -1/-1 카운터 한 개를 제거한다.\', \'type\': \'생물 — 하마\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428479&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c97d0d1e-f9f9-4405-a16b-2b505d243a94\', \'multiverseId\': 428479}, \'multiverseid\': 428479}, {\'name\': \'Gorja-mor Audaz\', \'text\': \'Quando Gorja-mor Audaz entrar no campo de batalha, coloque dois marcadores -1/-1 na criatura alvo que você controla.\\nToda vez que você colocar um ou mais marcadores -1/-1 em Gorja-mor Audaz, remova um marcador -1/-1 de outra criatura alvo que você controla.\', \'type\': \'Criatura — Hipopótamo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428748&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7935e1c4-ac5e-4a59-b254-21d27a80f435\', \'multiverseId\': 428748}, \'multiverseid\': 428748}, {\'name\': \'Непокорный Проглот\', \'text\': \'Когда Непокорный Проглот выходит на поле битвы, положите два жетона -1/-1 на целевое существо под вашим контролем.\\nКаждый раз, когда вы кладете один или несколько жетонов -1/-1 на Непокорного Проглота, удалите один жетон -1/-1 с другого целевого существа под вашим контролем.\', \'type\': \'Существо — Бегемот\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429017&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b38c61df-4774-4fde-95c4-7bc99de00bf1\', \'multiverseId\': 429017}, \'multiverseid\': 429017}, {\'name\': \'无畏巨河马\', \'text\': \'当无畏巨河马进战场时，在目标由你操控的生物上放置两个-1/-1指示物。\\n每当你在无畏巨河马上放置一个或数个-1/-1指示物时，从另一个目标由你操控的生物上移去一个-1/-1指示物。\', \'type\': \'生物～河马\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429286&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0edf4374-1fc4-4608-abba-25f805d2b416\', \'multiverseId\': 429286}, \'multiverseid\': 429286}, {\'name\': \'無畏巨河馬\', \'text\': \'當無畏巨河馬進戰場時，在目標由你操控的生物上放置兩個-1/-1指示物。\\n每當你在無畏巨河馬上放置一個或數個-1/-1指示物時，從另一個目標由你操控的生物上移去一個-1/-1指示物。\', \'type\': \'生物～河馬\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429555&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'13c4f99f-96f9-41ab-9e21-b72bccfd0a48\', \'multiverseId\': 429555}, \'multiverseid\': 429555}]', '[{\'name\': \'Tödliche Dünen\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {C}.\\n{1}, {T}, opfere die Tödlichen Dünen: Lege eine -1/-1-Marke auf eine Kreatur deiner Wahl. Aktiviere diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Land — Wüste\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427215&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'919b83f5-c1eb-4075-b73f-89131201c68f\', \'multiverseId\': 427215}, \'multiverseid\': 427215}, {\'name\': \'Dunas insaciables\', \'text\': \'{T}: Agrega {C} a tu reserva de maná.\\n{1}, {T}, sacrificar las Dunas insaciables: Pon un contador -1/-1 sobre la criatura objetivo. Activa esta habilidad solo cuando puedas lanzar un conjuro.\', \'type\': \'Tierra — Desierto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427484&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c7181d4-75d3-4953-bcf1-26681d1650c9\', \'multiverseId\': 427484}, \'multiverseid\': 427484}, {\'name\': \'Dunes saisissantes\', \'text\': "{T} : Ajoutez {C} à votre réserve.\\n{1}, {T}, sacrifiez les Dunes saisissantes : Mettez un marqueur -1/-1 sur la créature ciblée. N\'activez cette capacité que lorsque vous pourriez lancer un rituel.", \'type\': \'Terrain : désert\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'262d5c7b-59a2-4627-b48d-8d7c92ec863b\', \'multiverseId\': 427753}, \'multiverseid\': 427753}, {\'name\': \'Dune Avvinghianti\', \'text\': \'{T}: Aggiungi {C} alla tua riserva di mana.\\n{1}, {T}, Sacrifica le Dune Avvinghianti: Metti un segnalino -1/-1 su una creatura bersaglio. Attiva questa abilità solo quando potresti lanciare una stregoneria.\', \'type\': \'Terra — Deserto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428022&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41a41d20-6601-474d-8e22-342cd5583634\', \'multiverseId\': 428022}, \'multiverseid\': 428022}, {\'name\': \'絡みつく砂丘\', \'text\': \'{T}：あなたのマナ・プールに{C}を加える。\\n{1}, {T}, 絡みつく砂丘を生け贄に捧げる：クリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。この能力は、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'土地 — 砂漠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428291&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf50cc18-5649-4e70-97e8-f7571aabb58b\', \'multiverseId\': 428291}, \'multiverseid\': 428291}, {\'name\': \'모래귀신 사구\', \'text\': \'{T}: {C}를 당신의 마나풀에 담는다.\\n{1}, {T}, 모래귀신 사구를 희생한다: 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'대지 — 사막\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428560&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f3cf3688-aefd-4135-9466-4dd8aebabf74\', \'multiverseId\': 428560}, \'multiverseid\': 428560}, {\'name\': \'Dunas Enredantes\', \'text\': \'{T}: Adicione {C} à sua reserva de mana.\\n{1}, {T}, Sacrifique Dunas Enredantes: Coloque um marcador -1/-1 na criatura alvo. Ative esta habilidade somente nos momentos em que poderia conjurar um feitiço.\', \'type\': \'Terreno — Deserto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428829&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e4d7f8f6-cdc6-435e-a11e-7c50eccf5b2d\', \'multiverseId\': 428829}, \'multiverseid\': 428829}, {\'name\': \'Хищные Дюны\', \'text\': \'{T}: добавьте {C} в ваше хранилище маны.\\n{1}, {T}, пожертвуйте Хищные Дюны: положите один жетон -1/-1 на целевое существо. Активируйте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Земля — Пустыня\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429098&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6581db44-439c-4ab6-940d-7428fbcbcb1f\', \'multiverseId\': 429098}, \'multiverseid\': 429098}, {\'name\': \'攫陷沙丘\', \'text\': \'{T}：加{C}到你的法术力池中。\\n{1}，{T}，牺牲攫陷沙丘：在目标生物上放置一个-1/-1指示物。只可以于你能施放法术的时机下起动此异能。\', \'type\': \'地～沙漠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429367&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3bb3a777-dd26-4475-bd09-c4340c48c51e\', \'multiverseId\': 429367}, \'multiverseid\': 429367}, {\'name\': \'攫陷沙丘\', \'text\': \'{T}：加{C}到你的魔法力池中。\\n{1}，{T}，犧牲攫陷沙丘：在目標生物上放置一個-1/-1指示物。只可以於你能施放巫術的時機下起動此異能。\', \'type\': \'地～沙漠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429636&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9626a475-1a58-4572-aa33-9dbd41a33c7a\', \'multiverseId\': 429636}, \'multiverseid\': 429636}]', '[{\'name\': \'Unbarmherzige Wesirin\', \'text\': \'Immer wenn du eine Karte umwandelst oder abwirfst, erhält die Unbarmherzige Wesirin Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht. Falls ihre Widerstandskraft 0 oder weniger beträgt, wird sie dennoch auf den Friedhof ihres Besitzers gelegt.)\', \'type\': \'Kreatur — Minotaurus, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427074&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ced75f7-f43b-41c8-89f6-2cbbe9f5182d\', \'multiverseId\': 427074}, \'multiverseid\': 427074}, {\'name\': \'Visir despiadada\', \'text\': \'Siempre que actives una habilidad de ciclo o descartes una carta, la Visir despiadada gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen. Si su resistencia es 0 o menos, va al cementerio de su propietario igualmente.)\', \'type\': \'Criatura — Clérigo minotauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427343&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dab5474c-7f35-4554-b6d4-83469c1af3c6\', \'multiverseId\': 427343}, \'multiverseid\': 427343}, {\'name\': \'Vizir impitoyable\', \'text\': "À chaque fois que vous recyclez ou vous défaussez d\'une carte, le Vizir impitoyable acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne le détruisent pas. Si son endurance est inférieure ou égale à 0, il est toujours mis dans le cimetière de son propriétaire.)", \'type\': \'Créature : minotaure et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427612&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6e58b39-3cb5-4fce-a39e-f33f5d4803a5\', \'multiverseId\': 427612}, \'multiverseid\': 427612}, {\'name\': \'Visir Impietosa\', \'text\': \'Ogniqualvolta cicli o scarti una carta, la Visir Impietosa ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono. Se la sua costituzione è pari o inferiore a 0, viene comunque messa nel cimitero del suo proprietario.)\', \'type\': \'Creatura — Chierico Minotauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427881&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25ca874c-b994-4af9-825f-a9174d93780a\', \'multiverseId\': 427881}, \'multiverseid\': 427881}, {\'name\': \'冷酷な侍臣\', \'text\': \'あなたがカードを１枚サイクリングするか捨てるたび、ターン終了時まで、冷酷な侍臣は破壊不能を得る。（ダメージや「破壊」と書かれた効果では、これは破壊されない。これのタフネスが０以下であるなら、これはオーナーの墓地に置かれる。）\', \'type\': \'クリーチャー — ミノタウルス・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428150&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0e5e8c2-65b1-47f8-b852-3fcf7e49e892\', \'multiverseId\': 428150}, \'multiverseid\': 428150}, {\'name\': \'인정사정없는 고관\', \'text\': \'당신이 카드를 순환하거나 버릴 때마다, 인정사정없는 고관은 턴종료까지 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다. 방어력이 0 이하라면 소유자의 무덤에 놓는다.)\', \'type\': \'생물 — 미노타우로스 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428419&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf7c5235-d55e-4488-8c4c-c91543ec5071\', \'multiverseId\': 428419}, \'multiverseid\': 428419}, {\'name\': \'Vizir Impiedosa\', \'text\': \'Toda vez que você recicla ou descarta um card, Vizir Impiedosa ganha indestrutível até o final do turno. (Dano e efeitos que dizem "destrua" não a destroem. Se a sua resistência for igual ou inferior a 0, ela ainda será colocada no cemitério de seu dono.)\', \'type\': \'Criatura — Minotauro Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428688&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'147c3802-ba8d-4589-9a51-bc38a2b3398f\', \'multiverseId\': 428688}, \'multiverseid\': 428688}, {\'name\': \'Безжалостный Визирь\', \'text\': \'Каждый раз, когда вы совершаете Цикл или сбрасываете карту, Безжалостный Визирь получает Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его. Однако если его выносливость равна 0 или меньше, он отправляется на кладбище своего владельца.)\', \'type\': \'Существо — Минотавр Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428957&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17ef02f4-df80-4010-a461-2babadd3d928\', \'multiverseId\': 428957}, \'multiverseid\': 428957}, {\'name\': \'无情维齐尔\', \'text\': \'每当你循环或弃一张牌时，无情维齐尔获得不灭异能直到回合结束。（伤害与注明「消灭」的效应不会将它消灭。如果其防御力降到0或更少，它仍会置入其拥有者的坟墓场。）\', \'type\': \'生物～牛头怪／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429226&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ace64e17-6f82-48c2-9bea-7be01ae5c61a\', \'multiverseId\': 429226}, \'multiverseid\': 429226}, {\'name\': \'無情維齊爾\', \'text\': \'每當你循環或棄一張牌時，無情維齊爾獲得不滅異能直到回合結束。（傷害與註明「消滅」的效應不會將它消滅。如果其防禦力降到0或更少，它仍會置入其擁有者的墳墓場。）\', \'type\': \'生物～牛頭怪／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429495&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a15096aa-c178-4b32-9806-b0d1fbef97ec\', \'multiverseId\': 429495}, \'multiverseid\': 429495}]', '[{\'name\': \'Unbeirrbarer Geweihter\', \'text\': \'Wachsamkeit\\nEinbalsamieren {4}{W} ({4}{W}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Mensch-Krieger ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427007&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a700d5ec-4841-4ab8-bb78-3792e394c49e\', \'multiverseId\': 427007}, \'multiverseid\': 427007}, {\'name\': \'Iniciado inquebrantable\', \'text\': \'Vigilancia.\\nEmbalsamar {4}{W}. ({4}{W}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Guerrero Humano Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427276&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c12e59a1-5dd5-4767-bf7f-659f53fd2d71\', \'multiverseId\': 427276}, \'multiverseid\': 427276}, {\'name\': \'Adepte inébranlable\', \'text\': "Vigilance\\nEmbaumement {4}{W} ({4}{W}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et humain et guerrier blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427545&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6e650226-218a-44dd-81f4-25d7d6b418b1\', \'multiverseId\': 427545}, \'multiverseid\': 427545}, {\'name\': \'Iniziato Incrollabile\', \'text\': \'Cautela\\nImbalsamare {4}{W} ({4}{W}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Guerriero Umano Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427814&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d637a121-21ae-437d-8695-49a7c2f4f410\', \'multiverseId\': 427814}, \'multiverseid\': 427814}, {\'name\': \'断固たる修練者\', \'text\': \'警戒\\n不朽{4}{W}（{4}{W}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・人間・戦士であることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428083&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e35d3b8-fb01-417d-928c-92d1f8fd7333\', \'multiverseId\': 428083}, \'multiverseid\': 428083}, {\'name\': \'부동의 입회자\', \'text\': \'경계\\n방부처리 {4}{W} ({4}{W}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 인간 전사다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428352&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ec546d6d-523c-4659-9b93-433f69bf3d55\', \'multiverseId\': 428352}, \'multiverseid\': 428352}, {\'name\': \'Iniciado Inabalável\', \'text\': \'Vigilância\\nEmbalsamar {4}{W} ({4}{W}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Humano Guerreiro branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428621&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a1f7015-4bb0-49b4-9d82-a2457ccf16a1\', \'multiverseId\': 428621}, \'multiverseid\': 428621}, {\'name\': \'Недрогнувший Послушник\', \'text\': \'Бдительность\\nБальзамирование {4}{W} ({4}{W}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белым Зомби Человеком Воином без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428890&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7c065618-f262-4a76-8c6b-326e385687b1\', \'multiverseId\': 428890}, \'multiverseid\': 428890}, {\'name\': \'坚贞祀徒\', \'text\': \'警戒\\n遗存{4}{W}（{4}{W}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／人类／战士，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429159&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e9804f9-067c-4172-855f-a29c57cae16d\', \'multiverseId\': 429159}, \'multiverseid\': 429159}, {\'name\': \'堅貞祀徒\', \'text\': \'警戒\\n遺存{4}{W}（{4}{W}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／人類／戰士，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429428&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c020e652-c486-4e37-a36b-284f99d0dfa9\', \'multiverseId\': 429428}, \'multiverseid\': 429428}]', '[{\'name\': \'Unheilvolles Ammit\', \'text\': \'Lebensverknüpfung\\nWenn das Unheilvolle Ammit ins Spiel kommt, lege eine -1/-1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Krokodil, Dämon\', \'flavor\': \'„Nicht alle aus unserer Saat haben das Jenseits verdient. Lassen wir die Unwürdigen zurück, Samut." —Djeru, Geweihter der Tah-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427050&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be512ebb-1b19-4c34-8653-ba233f3ca4c6\', \'multiverseId\': 427050}, \'multiverseid\': 427050}, {\'name\': \'Ammit siniestra\', \'text\': \'Vínculo vital.\\nCuando la Ammit siniestra entre al campo de batalla, pon un contador -1/-1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Demonio cocodrilo\', \'flavor\': \'"No todos los miembros de nuestra simiente merecen alcanzar el más allá. Debemos dejar atrás a los indignos, Samut". —Djeru, iniciado de la simiente Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427319&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d053052e-e7c3-4fed-9b38-23dba9f4e852\', \'multiverseId\': 427319}, \'multiverseid\': 427319}, {\'name\': \'Ammout sinistre\', \'text\': "Lien de vie\\nQuand l\'Ammout sinistre arrive sur le champ de bataille, mettez un marqueur -1/-1 sur une créature ciblée que vous contrôlez.", \'type\': \'Créature : crocodile et démon\', \'flavor\': "« Certains dans notre moisson ne méritent pas l\'au-delà. Nous devons distancer ceux qui ne sont pas valeureux, Samut. » —Djeru, adepte de la moisson Tah", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427588&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'451e7246-0937-47e2-8cd0-9bf896d5d265\', \'multiverseId\': 427588}, \'multiverseid\': 427588}, {\'name\': \'Ammit Funesto\', \'text\': "Legame vitale\\nQuando l\'Ammit Funesto entra nel campo di battaglia, metti un segnalino -1/-1 su una creatura bersaglio che controlli.", \'type\': \'Creatura — Demone Coccodrillo\', \'flavor\': \'"Non tutti i membri della nostra messe meritano l\\\'aldilà. Dobbiamo abbandonare coloro che non sono prescelti, Samut." —Djeru, iniziato della messe Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427857&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f34655a-ca9e-4ead-a026-4b6acfc18186\', \'multiverseId\': 427857}, \'multiverseid\': 427857}, {\'name\': \'悪意のアムムト\', \'text\': \'絆魂\\n悪意のアムムトが戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'クリーチャー — クロコダイル・デーモン\', \'flavor\': \'「一門の全員が来世にふさわしいわけではない。サムトよ、英雄に値しない奴は置いて行くのだ。」 ――ター一門の修練者、デジェル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428126&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76c1c633-90ed-4dea-8009-6551b01b5308\', \'multiverseId\': 428126}, \'multiverseid\': 428126}, {\'name\': \'악의의 암무트\', \'text\': \'생명연결\\n악의의 암무트가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 악어 악마\', \'flavor\': \'"모든 입문자가 사후 세계에 갈 수는 없어. 자격 없는 자들은 그냥 버리고 가야 해, 사무트." —타 입문자의 입회자 제루\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428395&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'319e621e-5db1-455f-8190-bd729fd2ebbc\', \'multiverseId\': 428395}, \'multiverseid\': 428395}, {\'name\': \'Ammit Funesto\', \'text\': \'Vínculo com a vida\\nQuando Ammit Funesto entrar no campo de batalha, coloque um marcador -1/-1 na criatura alvo que você controla.\', \'type\': \'Criatura — Crocodilo Demônio\', \'flavor\': \'"Nem todos em nossa safra merecem a vida eterna. Precisamos deixar os indignos para trás, Samut." — Djeru, iniciado da safra Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428664&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6c1cc14-97a1-4724-8563-a347e8f2828c\', \'multiverseId\': 428664}, \'multiverseid\': 428664}, {\'name\': \'Гибельная Амат\', \'text\': \'Цепь жизни\\nКогда Гибельная Амат выходит на поле битвы, положите один жетон -1/-1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Крокодил Демон\', \'flavor\': \'«Не все в нашем снопе заслуживают загробной жизни. Мы должны бросить недостойных, Самут». — Джеру, послушник снопа Тах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428933&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cc7700de-b476-4533-b52e-db31e2fac29d\', \'multiverseId\': 428933}, \'multiverseid\': 428933}, {\'name\': \'恶邪阿米特\', \'text\': \'系命\\n当恶邪阿米特进战场时，在目标由你操控的生物上放置一个-1/-1指示物。\', \'type\': \'生物～鳄鱼／恶魔\', \'flavor\': \'「本祀群并非人人配得来世。撒姆特，我们得放弃配不上的人。」 ～塔哈祀群祀徒杰鲁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429202&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a1caab31-b2f5-451a-9083-28638bedd4ce\', \'multiverseId\': 429202}, \'multiverseid\': 429202}, {\'name\': \'惡邪阿米特\', \'text\': \'繫命\\n當惡邪阿米特進戰場時，在目標由你操控的生物上放置一個-1/-1指示物。\', \'type\': \'生物～鱷魚／惡魔\', \'flavor\': \'「本祀群並非人人配得來世。撒姆特，我們得放棄配不上的人。」 ～塔哈祀群祀徒傑魯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429471&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'081d01d4-a1d7-471d-9cb8-32c9fda2c9f2\', \'multiverseId\': 429471}, \'multiverseid\': 429471}]', "[{'name': 'Uralte Krabbe', 'type': 'Kreatur — Krabbe', 'flavor': 'Die Ufer des Luxa beherbergen die unterschiedlichsten Raubtiere, aber nur die zähesten und ausdauerndsten Beutetiere.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427011&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5f6848c8-a707-4789-a1df-185f01934170', 'multiverseId': 427011}, 'multiverseid': 427011}, {'name': 'Cangrejo antiguo', 'type': 'Criatura — Cangrejo', 'flavor': 'Las riberas del río Luxa atraen a todo tipo de depredadores, pero solo a las presas más resistentes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427280&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3eaaae3d-c241-4904-bc89-97f9d150d0d9', 'multiverseId': 427280}, 'multiverseid': 427280}, {'name': 'Crabe ancien', 'type': 'Créature : crabe', 'flavor': 'Les berges du fleuve Luxa attirent toutes sortes de prédateurs, mais seulement les proies les plus coriaces.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427549&type=card', 'language': 'French', 'identifiers': {'scryfallId': '80379c2e-a946-4cc9-ace4-52cb8b171a23', 'multiverseId': 427549}, 'multiverseid': 427549}, {'name': 'Granchio Antico', 'type': 'Creatura — Granchio', 'flavor': 'Le sponde del fiume Luxa attirano predatori di ogni sorta, ma solo le prede più tenaci.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427818&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '70925c85-46f6-4b93-bebd-b25406aafa7f', 'multiverseId': 427818}, 'multiverseid': 427818}, {'name': '古代ガニ', 'type': 'クリーチャー — カニ', 'flavor': 'ルクサ川の岸辺はあらゆる種類の捕食者を惹きつける。そこにいるのは捕食されても回復が早い生物のみだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428087&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd22956f4-dfc7-49ab-bb50-6624dd944462', 'multiverseId': 428087}, 'multiverseid': 428087}, {'name': '고대 게', 'type': '생물 — 게', 'flavor': '럭사 강둑은 온갖 종류의 포식자를 끌어들이지만, 이곳의 사냥감은 생존력이 극히 높다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428356&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '711ba1d7-af4e-4e58-aabd-aecfa2f3b674', 'multiverseId': 428356}, 'multiverseid': 428356}, {'name': 'Caranguejo Ancião', 'type': 'Criatura — Caranguejo', 'flavor': 'As margens do rio Luxa atraem todo tipo de predador, mas somente as presas mais resilientes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428625&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '17fb6950-22af-4d29-bcf9-300e61d42085', 'multiverseId': 428625}, 'multiverseid': 428625}, {'name': 'Древний Краб', 'type': 'Существо — Краб', 'flavor': 'Берега реки Лукса привлекают самых разнообразных хищников, но лишь самую крепкую добычу.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428894&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '24057ac9-5728-4ed0-a6fa-c73643aa0d46', 'multiverseId': 428894}, 'multiverseid': 428894}, {'name': '远古蟹', 'type': '生物～蟹', 'flavor': '罗夏河的两岸吸引了各种捕食者，但只有最顽强的猎物才会来到此地。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429163&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'daaf2786-b5e6-43cd-bdd4-0805092112ff', 'multiverseId': 429163}, 'multiverseid': 429163}, {'name': '遠古蟹', 'type': '生物～蟹', 'flavor': '羅夏河的兩岸吸引了各種捕食者，但只有最頑強的獵物才會來到此地。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429432&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'af7e92b2-d2ae-4d33-8ced-30886a9fd7ee', 'multiverseId': 429432}, 'multiverseid': 429432}]", '[{\'name\': \'Verdorrter Naga\', \'text\': \'{3}{B}: Ein Gegner deiner Wahl verliert 2 Lebenspunkte und du erhältst 2 Lebenspunkte dazu. Aktiviere diese Fähigkeit nur, falls du einen Liliana-Planeswalker kontrollierst.\', \'type\': \'Kreatur — Zombie, Naga\', \'flavor\': \'„Hier ist es fast schon zu einfach, die Toten zu beherrschen." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429722&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b676c8b7-7aa4-45ea-9e23-c76937240512\', \'multiverseId\': 429722}, \'multiverseid\': 429722}, {\'name\': \'Naga disecado\', \'text\': \'{3}{B}: El oponente objetivo pierde 2 vidas y tú ganas 2 vidas. Activa esta habilidad solo si controlas un planeswalker Liliana.\', \'type\': \'Criatura — Naga zombie\', \'flavor\': \'"La naturaleza de este plano me permite dominar a los muertos casi sin esfuerzo". —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429848&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a1180930-d08e-4400-b6f0-e05aeb2cb22d\', \'multiverseId\': 429848}, \'multiverseid\': 429848}, {\'name\': \'Naga desséché\', \'text\': "{3}{B} : L\'adversaire ciblé perd 2 points de vie et vous gagnez 2 points de vie. N\'activez cette capacité que si vous contrôlez un planeswalker Liliana.", \'type\': \'Créature : zombie et naga\', \'flavor\': \'« La nature de ce plan me rend le contrôle des morts presque trop facile. » —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429740&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'788b7473-004d-42f8-a537-a9de512ea80d\', \'multiverseId\': 429740}, \'multiverseid\': 429740}, {\'name\': \'Naga Essiccato\', \'text\': \'{3}{B}: Un avversario bersaglio perde 2 punti vita e tu guadagni 2 punti vita. Attiva questa abilità solo se controlli un planeswalker Liliana.\', \'type\': \'Creatura — Naga Zombie\', \'flavor\': \'"L\\\'essenza di questo piano mi aiuta fin troppo nel dominio sui morti." —Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429758&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3dbfa15e-801d-43fb-9e0e-fa2c9d67e564\', \'multiverseId\': 429758}, \'multiverseid\': 429758}, {\'name\': \'干からびたナーガ\', \'text\': \'{3}{B}：対戦相手１人を対象とする。そのプレイヤーは２点のライフを失い、あなたは２点のライフを得る。この能力は、あなたがリリアナ・プレインズウォーカーをコントロールしているときにのみ起動できる。\', \'type\': \'クリーチャー — ゾンビ・ナーガ\', \'flavor\': \'「この次元では、いとも簡単に死者を操れるわ。」 ――リリアナ・ヴェス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429776&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f749089-a0b2-4dbe-8e73-624b272f9eea\', \'multiverseId\': 429776}, \'multiverseid\': 429776}, {\'name\': \'건조한 나가\', \'text\': \'{3}{B}: 상대를 목표로 정한다. 그 상대는 생명 2점을 잃고 당신은 생명 2점을 얻는다. 이 능력은 당신이 릴리아나 플레인즈워커를 조종할 때에만 활성화할 수 있다.\', \'type\': \'생물 — 좀비 나가\', \'flavor\': \'"이곳 차원의 자연 환경은 내가 시체들을 조종하기에 너무나 알맞구나." —릴리아나 베스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429794&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c621bde1-79bf-46db-80ea-c698f5309d18\', \'multiverseId\': 429794}, \'multiverseid\': 429794}, {\'name\': \'Naga Desidratado\', \'text\': \'{3}{B}: O oponente alvo perde 2 pontos de vida e você ganha 2 pontos de vida. Ative esta habilidade somente se controlar uma planeswalker Liliana.\', \'type\': \'Criatura — Zumbi Naga\', \'flavor\': \'"Com a natureza deste plano, controlar os mortos é quase uma brincadeira." — Liliana Vess\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429812&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7827742d-8eb7-4f05-80a5-e3166109a9f6\', \'multiverseId\': 429812}, \'multiverseid\': 429812}, {\'name\': \'Иссохший Нага\', \'text\': \'{3}{B}: целевой оппонент теряет 2 жизни, а вы получаете 2 жизни. Активируйте эту способность, только если вы контролируете planeswalker-а Лилиану.\', \'type\': \'Существо — Зомби Нага\', \'flavor\': \'«Сама сущность этого мира такова, что управлять мертвыми мне здесь проще простого». — Лилиана Весс\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429830&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'78713b91-6048-45df-adf7-55b7f90376ee\', \'multiverseId\': 429830}, \'multiverseid\': 429830}, {\'name\': \'干枯那伽\', \'text\': \'{3}{B}：目标对手失去2点生命且你获得2点生命。只能于你操控莉莲娜鹏洛客时起动此异能。\', \'type\': \'生物～灵俑／那伽\', \'flavor\': \'「这时空的特质让我能够轻而易举地号令亡者。」 ～莉莲娜维斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'850a9c17-c955-49e9-bdf1-21fbbbc3287f\', \'multiverseId\': 429686}, \'multiverseid\': 429686}, {\'name\': \'乾枯那伽\', \'text\': \'{3}{B}：目標對手失去2點生命且你獲得2點生命。只能於你操控莉蓮娜鵬洛客時起動此異能。\', \'type\': \'生物～殭屍／那伽\', \'flavor\': \'「這時空的特質讓我能夠輕而易舉地號令亡者。」 ～莉蓮娜維斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429704&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a6fba439-561d-4c25-a570-a39a13b6eded\', \'multiverseId\': 429704}, \'multiverseid\': 429704}]', '[{\'name\': \'Verehrte Hydra\', \'text\': \'Verursacht Trampelschaden\\nEinbalsamieren {3}{G} ({3}{G}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er eine weiße Zombie-Ophis-Hydra ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Ophis, Hydra\', \'flavor\': \'Selbst die Götter besitzen Haustiere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427143&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'903ba29c-1922-4f2b-80f0-6377db72784a\', \'multiverseId\': 427143}, \'multiverseid\': 427143}, {\'name\': \'Hidra alabada\', \'text\': \'Arrolla.\\nEmbalsamar {3}{G}. ({3}{G}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es una Hidra Víbora Zombie blanca sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Hidra víbora\', \'flavor\': \'Incluso los dioses tienen mascotas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427412&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3d35c62f-80c7-4ede-a769-73de151ce0d0\', \'multiverseId\': 427412}, \'multiverseid\': 427412}, {\'name\': \'Hydre honorée\', \'text\': "Piétinement\\nEmbaumement {3}{G} ({3}{G}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et serpent et hydre blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : serpent et hydre\', \'flavor\': \'Les dieux aussi ont des animaux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427681&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f67d06d7-9ea9-4446-bcfc-49a9d0d82b19\', \'multiverseId\': 427681}, \'multiverseid\': 427681}, {\'name\': \'Idra Venerata\', \'text\': "Travolgere\\nImbalsamare {3}{G} ({3}{G}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un\'Idra Serpente Zombie bianca senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)", \'type\': \'Creatura — Idra Serpente\', \'flavor\': \'Anche le divinità hanno degli animali da compagnia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427950&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90453d78-92f0-44d4-a079-99439ba7ec7a\', \'multiverseId\': 427950}, \'multiverseid\': 427950}, {\'name\': \'名誉あるハイドラ\', \'text\': \'トランプル\\n不朽{3}{G}（{3}{G}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・蛇・ハイドラであることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 蛇・ハイドラ\', \'flavor\': \'神々にもペットがいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428219&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc1f4944-3ea6-4a8d-a6cd-5b8c0ba1eaa0\', \'multiverseId\': 428219}, \'multiverseid\': 428219}, {\'name\': \'영예로운 히드라\', \'text\': \'돌진\\n방부처리 {3}{G} ({3}{G}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 뱀 히드라다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 뱀 히드라\', \'flavor\': \'신도 애완동물을 기른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428488&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4f2f61f4-3c37-4699-b37a-606228509172\', \'multiverseId\': 428488}, \'multiverseid\': 428488}, {\'name\': \'Hidra Honrada\', \'text\': \'Atropelar\\nEmbalsamar {3}{G} ({3}{G}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Cobra Hidra branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Cobra Hidra\', \'flavor\': \'Até mesmo os deuses têm animais de estimação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'622aad88-68e7-41be-8aed-524bc225b2b0\', \'multiverseId\': 428757}, \'multiverseid\': 428757}, {\'name\': \'Почитаемая Гидра\', \'text\': \'Пробивной удар\\nБальзамирование {3}{G} ({3}{G}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белой Зомби Змеей Гидрой без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Змея Гидра\', \'flavor\': \'Даже у богов есть питомцы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429026&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d28c97cc-0fb5-4ccf-9fc1-229c9f31d844\', \'multiverseId\': 429026}, \'multiverseid\': 429026}, {\'name\': \'赐耀多头龙\', \'text\': \'践踏\\n遗存{3}{G}（{3}{G}从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／蛇／多头龙，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～蛇／多头龙\', \'flavor\': \'神也有宠物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429295&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'257aff32-45d6-4369-b60b-ea341e0dd1ed\', \'multiverseId\': 429295}, \'multiverseid\': 429295}, {\'name\': \'賜耀多頭龍\', \'text\': \'踐踏\\n遺存{3}{G}（{3}{G}從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／蛇／多頭龍，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～蛇／多頭龍\', \'flavor\': \'神也有寵物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429564&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ea887984-e698-4c1a-8183-a5e88934de1f\', \'multiverseId\': 429564}, \'multiverseid\': 429564}]', '[{\'name\': \'Verehrte Saatführerin\', \'text\': \'Immer wenn die Verehrte Saatführerin angreift, erhalten andere angreifende Kreaturen +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Ihre Worte regen zu Taten an. Ihre Taten regen zum Siegen an.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427171&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5df61171-86dd-4309-911e-6c6434e31329\', \'multiverseId\': 427171}, \'multiverseid\': 427171}, {\'name\': \'Capitana de simiente alabada\', \'text\': \'Siempre que la Capitana de simiente alabada ataque, las otras criaturas atacantes obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Sus palabras llevan a la acción. Sus acciones llevan a la victoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427440&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83b9ad2d-3534-446e-881f-7585ead6c6fa\', \'multiverseId\': 427440}, \'multiverseid\': 427440}, {\'name\': \'Capitaine de moisson honorée\', \'text\': "À chaque fois que la Capitaine de moisson honorée attaque, les autres créatures attaquantes gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et guerrier\', \'flavor\': "Ses paroles inspirent à l\'action. Ses actions inspirent à la victoire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427709&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e718342-9af2-4886-a1d2-9e2dfa996c5a\', \'multiverseId\': 427709}, \'multiverseid\': 427709}, {\'name\': \'Capomesse Venerata\', \'text\': \'Ogniqualvolta la Capomesse Venerata attacca, le altre creature attaccanti prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Le sue parole ispirano ad agire. Le sue azioni ispirano a vincere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427978&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'24772363-6665-4181-a7a8-ebab24d4eb27\', \'multiverseId\': 427978}, \'multiverseid\': 427978}, {\'name\': \'名誉ある門長\', \'text\': \'名誉ある門長が攻撃するたび、ターン終了時まで、他の攻撃クリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'彼女の言葉は行動を呼ぶ。彼女の行動は勝利を呼ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428247&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22cbc991-ecfd-464a-bd46-f96a9dff0608\', \'multiverseId\': 428247}, \'multiverseid\': 428247}, {\'name\': \'영예로운 입문자 대장\', \'text\': \'영예로운 입문자 대장이 공격할 때마다, 다른 공격생물들은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'그녀의 말은 행동을 부르고, 그녀의 행동은 승리를 부른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428516&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1e1d8a3a-704c-47bc-9c86-18f470c7d12c\', \'multiverseId\': 428516}, \'multiverseid\': 428516}, {\'name\': \'Capitã de Safra Honrada\', \'text\': \'Toda vez que Capitã de Safra Honrada ataca, as outras criaturas atacantes recebem +1/+0 até o final do turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Suas palavras levam à ação. Suas ações levam à vitória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428785&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'de4fc896-6ef0-4baa-b72d-4e92ff454992\', \'multiverseId\': 428785}, \'multiverseid\': 428785}, {\'name\': \'Почтенный Капитан Снопа\', \'text\': \'Каждый раз, когда Почтенный Капитан Снопа атакует, другие атакующие существа получают +1/+0 до конца хода.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Ее слова вдохновляют на действие. Ее действия вдохновляют на победу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429054&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ecabf08-516a-4bdb-97c0-b26cda65a549\', \'multiverseId\': 429054}, \'multiverseid\': 429054}, {\'name\': \'荣耀群长\', \'text\': \'每当荣耀群长攻击时，其他进行攻击的生物得+1/+0直到回合结束。\', \'type\': \'生物～人类／战士\', \'flavor\': \'言语励行，出击致胜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429323&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02e558dc-7945-4669-a4a7-6197c1480e7f\', \'multiverseId\': 429323}, \'multiverseid\': 429323}, {\'name\': \'榮耀群長\', \'text\': \'每當榮耀群長攻擊時，其他進行攻擊的生物得+1/+0直到回合結束。\', \'type\': \'生物～人類／戰士\', \'flavor\': \'言語勵行，出擊致勝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429592&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ba9dcdd4-f28a-4487-95d9-599e11228a78\', \'multiverseId\': 429592}, \'multiverseid\': 429592}]', "[{'name': 'Verfehlung // Nachgeben', 'text': 'Bringe einen Zauberspruch deiner Wahl auf die Hand seines Besitzers zurück.', 'type': 'Spontanzauber', 'flavor': None, 'faceName': 'Verfehlung', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427192&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4b20d999-348a-4d6c-8182-4bf2d6a71a1b', 'multiverseId': 427192}, 'multiverseid': 427192}, {'name': 'Fracaso // Acatamiento', 'text': 'Regresa el hechizo objetivo a la mano de su propietario.', 'type': 'Instantáneo', 'flavor': None, 'faceName': 'Fracaso', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427461&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '101e0b1c-616f-4680-9ad4-2f19a600acf6', 'multiverseId': 427461}, 'multiverseid': 427461}, {'name': 'Refus // Obtempérer', 'text': 'Renvoyez le sort ciblé dans la main de son propriétaire.', 'type': 'Éphémère', 'flavor': None, 'faceName': 'Refus', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427730&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd6dd4587-3e5b-4985-986b-cf50a734bfbd', 'multiverseId': 427730}, 'multiverseid': 427730}, {'name': 'Mancato // Adempimento', 'text': 'Fai tornare una magia bersaglio in mano al suo proprietario.', 'type': 'Istantaneo', 'flavor': None, 'faceName': 'Mancato', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427999&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7ea38203-7a99-44bc-95cb-41b854feb1ca', 'multiverseId': 427999}, 'multiverseid': 427999}, {'name': '腹背 // 面従', 'text': '呪文１つを対象とし、それをオーナーの手札に戻す。', 'type': 'インスタント', 'flavor': None, 'faceName': '腹背', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428268&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a3d7f1de-82f4-464b-91ad-891178e7e87a', 'multiverseId': 428268}, 'multiverseid': 428268}, {'name': '실패 // 순응', 'text': '주문을 목표로 정한다. 그 주문을 소유자의 손으로 되돌린다.', 'type': '순간마법', 'flavor': None, 'faceName': '실패', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428537&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '019cfe7d-6600-419b-8c57-7a89423dfe4a', 'multiverseId': 428537}, 'multiverseid': 428537}, {'name': 'Falha // Cumprimento', 'text': 'Devolva a mágica alvo para a mão de seu dono.', 'type': 'Mágica Instantânea', 'flavor': None, 'faceName': 'Falha', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428806&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3c644a3b-f1a5-42fe-a2f7-f27808f0b1d6', 'multiverseId': 428806}, 'multiverseid': 428806}, {'name': 'Неспособность // Подчиниться', 'text': 'Верните целевое заклинание в руку его владельца.', 'type': 'Мгновенное заклинание', 'flavor': None, 'faceName': 'Неспособность', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429075&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b49261ff-624c-443a-994c-6b3803e08110', 'multiverseId': 429075}, 'multiverseid': 429075}, {'name': '无所 // 适从', 'text': '将目标咒语移回其拥有者手上。', 'type': '瞬间', 'flavor': None, 'faceName': '无所', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429344&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '41d3d34c-be1a-4539-bc1f-d2aad22468dc', 'multiverseId': 429344}, 'multiverseid': 429344}, {'name': '無所 // 適從', 'text': '將目標咒語移回其擁有者手上。', 'type': '瞬間', 'flavor': None, 'faceName': '無所', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429613&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9f4ee359-fb8d-4c45-932f-4ca86aad3f6a', 'multiverseId': 429613}, 'multiverseid': 429613}]", '[{\'name\': \'Verfluchter Minotaurus\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\', \'type\': \'Kreatur — Zombie, Minotaurus\', \'flavor\': \'„Schaut! Das ist der Grund, warum wir niemals wanken dürfen. Das erwartet all jene, die versagen." —Djeru, Geweihter der Tah-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427056&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'abe3b57e-08ea-44c2-97b6-6437d2a284f1\', \'multiverseId\': 427056}, \'multiverseid\': 427056}, {\'name\': \'Minotauro maldito\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)\', \'type\': \'Criatura — Minotauro zombie\', \'flavor\': \'"¡Mira! Por eso no debemos flaquear nunca. Eso es lo que nos espera si fracasamos". —Djeru, iniciado de la simiente Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427325&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'142ff8cc-ce1c-4d4d-92aa-790922f0a80d\', \'multiverseId\': 427325}, \'multiverseid\': 427325}, {\'name\': \'Minotaure maudit\', \'text\': \'Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)\', \'type\': \'Créature : zombie et minotaure\', \'flavor\': \'« Regardez ! Voilà pourquoi nous ne devons jamais faiblir. Voilà ce qui nous attend si nous échouons. » —Djeru, adepte de la moisson Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427594&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d541b9dc-65c0-4b7a-aacb-b0c44501904e\', \'multiverseId\': 427594}, \'multiverseid\': 427594}, {\'name\': \'Minotauro Maledetto\', \'text\': \'Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)\', \'type\': \'Creatura — Minotauro Zombie\', \'flavor\': \'"Guardate! È questa la ragione per cui non dobbiamo mai esitare. È questo che ci attende se falliamo." —Djeru, iniziato della messe Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427863&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc5b4da2-d332-4a33-b2bd-4878acbef380\', \'multiverseId\': 427863}, \'multiverseid\': 427863}, {\'name\': \'呪われたミノタウルス\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）\', \'type\': \'クリーチャー — ゾンビ・ミノタウルス\', \'flavor\': \'「見ろ。一時たりとも気を緩めるな。失敗すればああなるのだ。」 ――ター一門の修練者、デジェル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428132&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f3605cf-0105-4d2e-8169-86e2f0dbc7b0\', \'multiverseId\': 428132}, \'multiverseid\': 428132}, {\'name\': \'저주받은 미노타우로스\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\', \'type\': \'생물 — 좀비 미노타우로스\', \'flavor\': \'"저것 봐! 우리가 절대 포기하면 안 되는 이유야. 실패하면 저 놈들이 우릴 기다릴 테니까." —타 입문자의 입회자 제루\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428401&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7d7bcbc8-74f4-43e8-8a4a-ec26b678de16\', \'multiverseId\': 428401}, \'multiverseid\': 428401}, {\'name\': \'Minotauro Amaldiçoado\', \'text\': \'Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)\', \'type\': \'Criatura — Zumbi Minotauro\', \'flavor\': \'"Olhe! É por isso que é preciso jamais vacilar. Isso é o que nos espera se falharmos." — Djeru, iniciado da safra Tah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428670&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea8057b3-7728-4505-9aff-42166aa6e0fb\', \'multiverseId\': 428670}, \'multiverseid\': 428670}, {\'name\': \'Проклятый Минотавр\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)\', \'type\': \'Существо — Зомби Минотавр\', \'flavor\': \'«Гляди! Вот почему мы не должны отступать. Вот что ожидает нас, если мы провалимся». — Джеру, послушник снопа Тах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428939&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'66f8d1be-4e34-45a9-bb9a-6bd4d81d20f7\', \'multiverseId\': 428939}, \'multiverseid\': 428939}, {\'name\': \'受诅牛头怪\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）\', \'type\': \'生物～灵俑／牛头怪\', \'flavor\': \'「看啊！这就是我们不能动摇的原因。这就是我们失败的下场。」 ～塔哈祀群祀徒杰鲁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429208&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ecb9a7f6-04a4-47c9-81ef-f9053b0e2fb7\', \'multiverseId\': 429208}, \'multiverseid\': 429208}, {\'name\': \'受詛牛頭怪\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）\', \'type\': \'生物～殭屍／牛頭怪\', \'flavor\': \'「看啊！這就是我們不能動搖的原因。這就是我們失敗的下場。」 ～塔哈祀群祀徒傑魯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429477&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6dc90e4f-f971-48ab-a0a9-c02bc010dca2\', \'multiverseId\': 429477}, \'multiverseid\': 429477}]', '[{\'name\': \'Verlassenes Heiligtum\', \'text\': \'Das Verlassene Heiligtum kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}.\', \'type\': \'Land\', \'flavor\': \'„Würden Gebete hier nicht im Halse stecken bleiben, stießen sie nur auf verrottende Ohren." —Minaldra, die Vizag Atum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2d8d37af-ab98-47c0-bd60-817242ca0249\', \'multiverseId\': 429727}, \'multiverseid\': 429727}, {\'name\': \'Santuario abandonado\', \'text\': \'El Santuario abandonado entra al campo de batalla girado.\\n{T}: Agrega {W} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"Las oraciones se cuajarán en la lengua y serán escuchadas por oídos putrefactos". —Minaldra, la Vizag Atum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429853&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa427cf5-b5e0-4e5e-88da-eb629bf816c1\', \'multiverseId\': 429853}, \'multiverseid\': 429853}, {\'name\': \'Sanctuaire abandonné\', \'text\': \'Le Sanctuaire abandonné arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {W} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': \'« Les prières ranciront sur les langues et seront entendues par les oreilles pourrissantes. » —Minaldra, la Vizag Atum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db1cc9c0-3ae9-45b1-a485-4cdf825c0f80\', \'multiverseId\': 429745}, \'multiverseid\': 429745}, {\'name\': \'Santuario Abbandonato\', \'text\': \'Il Santuario Abbandonato entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'"Le preghiere si raggeleranno sulle labbra e verranno udite da orecchie putrefatte." —Minaldra, la Vizag Atum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429763&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cdc4d94-e89d-4d44-8171-021c7678baed\', \'multiverseId\': 429763}, \'multiverseid\': 429763}, {\'name\': \'放棄された聖域\', \'text\': \'放棄された聖域はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'「祈りは舌の上で固まり、腐れる耳が聞くことでしょう。」 ――ヴィザグ・アトゥムのミナルドラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429781&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'28b6142f-81e4-4e67-8a6c-a0799ecaf825\', \'multiverseId\': 429781}, \'multiverseid\': 429781}, {\'name\': \'버려진 성역\', \'text\': \'버려진 성역은 탭된 채로 전장에 들어온다.\\n{T}: {W} 또는 {B}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'"기도는 혀 위에서 분리되어 썩어가는 귀로 들어간다." —비자그 아툼의 수장 미날드라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429799&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8a69779e-cd88-4afb-9c74-90d6c1dc57f7\', \'multiverseId\': 429799}, \'multiverseid\': 429799}, {\'name\': \'Santuário Abandonado\', \'text\': \'Santuário Abandonado entra no campo de batalha virado.\\n{T}: Adicione {W} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"As orações azedarão na língua e serão ouvidas por ouvidos putrefatos." — Minaldra, a Vizag Athum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6bc5668d-9fc3-4781-ad5e-aa53664a326b\', \'multiverseId\': 429817}, \'multiverseid\': 429817}, {\'name\': \'Заброшенное Святилище\', \'text\': \'Заброшенное Святилище выходит на поле битвы повернутым.\\n{T}: добавьте {W} или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'«Молитвы будут горчить на языке и попадут в прогнившие уши». — Миналдра, Визаг Атум\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429835&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'532bf2c5-1c4e-492e-970a-d0edb60a3a25\', \'multiverseId\': 429835}, \'multiverseid\': 429835}, {\'name\': \'遭弃圣殿\', \'text\': \'遭弃圣殿须横置进战场。\\n{T}：加{W}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'「祷告者会口齿不清，只有腐烂的耳朵才能听见。」 ～威泽腾米娜查\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429691&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1d9ea22-717f-4205-9966-e2f021ac7191\', \'multiverseId\': 429691}, \'multiverseid\': 429691}, {\'name\': \'遭棄聖殿\', \'text\': \'遭棄聖殿須橫置進戰場。\\n{T}：加{W}或{B}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'「禱告者會口齒不清，只有腐爛的耳朵才能聽見。」 ～威澤騰米娜查\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429709&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9edd5eb2-4fa2-4e3c-8e52-f7f8d34e9c3c\', \'multiverseId\': 429709}, \'multiverseid\': 429709}]', '[{\'name\': \'Versorgungskarawane\', \'text\': \'Wenn die Versorgungskarawane ins Spiel kommt und falls du eine getappte Kreatur kontrollierst, erzeuge einen 1/1 weißen Krieger-Kreaturenspielstein mit Wachsamkeit.\', \'type\': \'Kreatur — Kamel\', \'flavor\': \'„Jeder hat seinen Teil auf dem Weg ins Jenseits beizutragen." —Oketra, Göttin des Zusammenhalts\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427001&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2fba6632-1e58-4cf0-9565-9d916ab048aa\', \'multiverseId\': 427001}, \'multiverseid\': 427001}, {\'name\': \'Caravana de suministros\', \'text\': \'Cuando la Caravana de suministros entre al campo de batalla, si controlas una criatura girada, crea una ficha de criatura Guerrero blanca 1/1 con la habilidad de vigilancia.\', \'type\': \'Criatura — Camello\', \'flavor\': \'"Todos tenemos un peso que cargar en el camino al más allá". —Oketra, diosa de la solidaridad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427270&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f6da3e7e-9928-4ff0-aef0-58f18a790654\', \'multiverseId\': 427270}, \'multiverseid\': 427270}, {\'name\': \'Caravane de marchandises\', \'text\': \'Quand la Caravane de marchandises arrive sur le champ de bataille, si vous contrôlez une créature engagée, créez un jeton de créature 1/1 blanche Guerrier avec la vigilance.\', \'type\': \'Créature : chameau\', \'flavor\': "« Nous avons tous un fardeau à porter sur la route vers l\'au-delà. » —Oketra, déesse de la Solidarité", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427539&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b5f54a72-4a6d-4338-a8d3-07946118d787\', \'multiverseId\': 427539}, \'multiverseid\': 427539}, {\'name\': \'Carovana di Rifornimenti\', \'text\': \'Quando la Carovana di Rifornimenti entra nel campo di battaglia, se controlli una creatura TAPpata, crea una pedina creatura Guerriero 1/1 bianca con cautela.\', \'type\': \'Creatura — Cammello\', \'flavor\': \'"Abbiamo tutti un fardello da portare lungo il cammino che ci conduce all\\\'aldilà." —Oketra, dea della fratellanza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427808&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9f08b06-261e-4d1c-afef-c3ca9d205658\', \'multiverseId\': 427808}, \'multiverseid\': 427808}, {\'name\': \'補給の隊商\', \'text\': \'補給の隊商が戦場に出たとき、あなたがタップ状態のクリーチャーをコントロールしている場合、警戒を持つ白の１/１の戦士・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ラクダ\', \'flavor\': \'「各々、来世まで持って行く重荷があるのだ。」 ――結束の神、オケチラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428077&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9d109b0-f3fa-448e-b0f6-009b468084e8\', \'multiverseId\': 428077}, \'multiverseid\': 428077}, {\'name\': \'물자수송 대상단\', \'text\': \'물자수송 대상단이 전장에 들어올 때, 당신이 탭된 생물을 조종한다면, 경계를 가진 1/1 백색 전사 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 낙타\', \'flavor\': \'"각자에게는 사후 세계로 갈 때 짊어질 짐이 있다." —결속의 신 오케트라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428346&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9d4aa98a-2eff-4d85-a550-c59504ed8631\', \'multiverseId\': 428346}, \'multiverseid\': 428346}, {\'name\': \'Caravana de Suprimentos\', \'text\': \'Quando Caravana de Suprimentos entrar no campo de batalha, se você controlar uma criatura virada, crie uma ficha de criatura branca 1/1 do tipo Guerreiro com vigilância.\', \'type\': \'Criatura — Camelo\', \'flavor\': \'"Cada um de nós tem um peso a carregar na estrada rumo à vida após a morte." — Oketra, deusa da solidariedade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428615&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b98b2e9-35b0-4bc4-a11d-048d39031d18\', \'multiverseId\': 428615}, \'multiverseid\': 428615}, {\'name\': \'Караван с Припасами\', \'text\': \'Когда Караван с Припасами выходит на поле битвы, если под вашим контролем есть повернутое существо, создайте одну фишку существа 1/1 белый Воин с Бдительностью.\', \'type\': \'Существо — Верблюд\', \'flavor\': \'«По дороге к загробной жизни каждый из нас должен нести свое бремя». — Окетра, богиня сплоченности\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428884&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'749ce335-c62e-4d4e-afe4-b8710c427c76\', \'multiverseId\': 428884}, \'multiverseid\': 428884}, {\'name\': \'补给商队\', \'text\': \'当补给商队进战场时，若你操控已横置的生物，则派出一个1/1白色，具警戒异能的战士衍生生物。\', \'type\': \'生物～骆驼\', \'flavor\': \'「在通往来世的路上，我们都有各自的包袱。」 ～团结之神欧柯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429153&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28bc699e-9808-48e9-a4f0-f1270b26cbcf\', \'multiverseId\': 429153}, \'multiverseid\': 429153}, {\'name\': \'補給商隊\', \'text\': \'當補給商隊進戰場時，若你操控已橫置的生物，則派出一個1/1白色，具警戒異能的戰士衍生生物。\', \'type\': \'生物～駱駝\', \'flavor\': \'「在通往來世的路上，我們都有各自的包袱。」 ～團結之神歐柯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429422&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d66c1878-2bd0-4cbf-9016-6b2e27ddcc89\', \'multiverseId\': 429422}, \'multiverseid\': 429422}]', '[{\'name\': \'Verstoßen\', \'text\': \'Aufblitzen\\nWenn Verstoßen ins Spiel kommt, schicke eine bleibende Karte deiner Wahl, die kein Land ist und die ein Gegner kontrolliert, ins Exil, bis Verstoßen das Spiel verlässt.\\nUmwandlung {W} ({W}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426979&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18026b25-9dfa-47a3-8c9a-1d1bf5485665\', \'multiverseId\': 426979}, \'multiverseid\': 426979}, {\'name\': \'Expulsar\', \'text\': \'Destello.\\nCuando Expulsar entre al campo de batalla, exilia el permanente objetivo que no sea tierra que controla un oponente hasta que Expulsar deje el campo de batalla.\\nCiclo {W}. ({W}, descartar esta carta: Roba una carta.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427248&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7073d302-05ea-40c6-901c-a492c103fa51\', \'multiverseId\': 427248}, \'multiverseid\': 427248}, {\'name\': \'Proscription\', \'text\': "Flash\\nQuand la Proscription arrive sur le champ de bataille, exilez un permanent non-terrain ciblé qu\'un adversaire contrôle jusqu\'à ce que la Proscription quitte le champ de bataille.\\nRecyclage {W} ({W}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07f118db-e20b-4bee-b6cf-796a7f805dc4\', \'multiverseId\': 427517}, \'multiverseid\': 427517}, {\'name\': \'Espellere\', \'text\': \'Lampo\\nQuando Espellere entra nel campo di battaglia, esilia un permanente non terra bersaglio controllato da un avversario finché Espellere non lascia il campo di battaglia.\\nCiclo {W} ({W}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427786&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f658ebee-26fd-450c-a37b-c50d62f5fe49\', \'multiverseId\': 427786}, \'multiverseid\': 427786}, {\'name\': \'排斥\', \'text\': \'瞬速\\n排斥が戦場に出たとき、対戦相手がコントロールする土地でないパーマネント１つを対象とし、排斥が戦場を離れるまでそれを追放する。\\nサイクリング{W}（{W}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428055&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ebe463b2-6589-4599-bb02-2ce906645dcf\', \'multiverseId\': 428055}, \'multiverseid\': 428055}, {\'name\': \'몰아내기\', \'text\': \'섬광\\n몰아내기가 전장에 들어올 때, 상대가 조종하는 대지가 아닌 지속물을 목표로 정한다. 그 지속물을 몰아내기가 전장을 떠날 때까지 추방한다.\\n순환 {W} ({W}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428324&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d93dfb85-212c-4aae-8064-70b903f7200a\', \'multiverseId\': 428324}, \'multiverseid\': 428324}, {\'name\': \'Degredar\', \'text\': \'Lampejo\\nQuando Degredar entrar no campo de batalha, exile a permanente alvo que não seja terreno que um oponente controla até que Degredar deixe o campo de batalha.\\nReciclar {W} ({W}, Descarte este card: Compre um card.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428593&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e713df24-5541-4746-b056-d1f541f1e4e7\', \'multiverseId\': 428593}, \'multiverseid\': 428593}, {\'name\': \'Изгнание Прочь\', \'text\': \'Миг\\nКогда Изгнание Прочь выходит на поле битвы, изгоните целевой не являющийся землей перманент под контролем оппонента до тех пор, пока Изгнание Прочь не покинет поле битвы.\\nЦикл {W} ({W}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428862&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'013e308e-2e9e-4d2d-b538-f8557e4e13a2\', \'multiverseId\': 428862}, \'multiverseid\': 428862}, {\'name\': \'斥逐\', \'text\': \'闪现\\n当斥逐进战场时，放逐目标由对手操控的非地永久物，直到斥逐离开战场为止。\\n循环{W}（{W}，弃掉此牌：抓一张牌。）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429131&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6edf4dc0-5259-47be-856a-634ec663676c\', \'multiverseId\': 429131}, \'multiverseid\': 429131}, {\'name\': \'斥逐\', \'text\': \'閃現\\n當斥逐進戰場時，放逐目標由對手操控的非地永久物，直到斥逐離開戰場為止。\\n循環{W}（{W}，棄掉此牌：抽一張牌。）\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429400&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'41aa25ad-6d41-4158-863f-0e29ae6824ec\', \'multiverseId\': 429400}, \'multiverseid\': 429400}]', "[{'name': 'Verstreute Haine', 'text': '({T}: Erhöhe deinen Manavorrat um {G} oder {W}.)\\nDie Verstreuten Haine kommen getappt ins Spiel.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land — Wald, Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427218&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cb651e80-59d1-4e05-9d1a-c45723f2b1bb', 'multiverseId': 427218}, 'multiverseid': 427218}, {'name': 'Arboleda dispersa', 'text': '({T}: Agrega {G} o {W} a tu reserva de maná.)\\nLa Arboleda dispersa entra al campo de batalla girada.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Tierra — Bosque llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427487&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '167f4092-b6f5-4c1d-87d8-fae958adeebf', 'multiverseId': 427487}, 'multiverseid': 427487}, {'name': 'Bosquets épars', 'text': '({T} : Ajoutez {G} ou {W} à votre réserve.)\\nLes Bosquets épars arrivent sur le champ de bataille engagés.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain : forêt et plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427756&type=card', 'language': 'French', 'identifiers': {'scryfallId': '09dcc14b-24ae-45ae-a30e-90e9c908b77f', 'multiverseId': 427756}, 'multiverseid': 427756}, {'name': 'Selve Diradate', 'text': '({T}: Aggiungi {G} o {W} alla tua riserva di mana.)\\nLe Selve Diradate entrano nel campo di battaglia TAPpate.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra — Foresta Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428025&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bc972fa5-b644-40d0-8035-8b8e75dc2a3b', 'multiverseId': 428025}, 'multiverseid': 428025}, {'name': 'まばらな木立ち', 'text': '（{T}：あなたのマナ・プールに{G}か{W}を加える。）\\nまばらな木立ちはタップ状態で戦場に出る。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': '土地 — 森・平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428294&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '617162ca-8f87-44e3-bd4e-092d9ac6a37c', 'multiverseId': 428294}, 'multiverseid': 428294}, {'name': '흩어진 숲', 'text': '({T}: {G} 또는 {W}를 당신의 마나풀에 담는다.)\\n흩어진 숲은 탭된 채로 전장에 들어온다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '대지 — 숲 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428563&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '733da77f-8f21-4389-a18c-5cbcb552adea', 'multiverseId': 428563}, 'multiverseid': 428563}, {'name': 'Bosques Esparsos', 'text': '({T}: Adicione {G} ou {W} à sua reserva de mana.)\\nBosques Esparsos entra no campo de batalha virado.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)', 'type': 'Terreno — Floresta Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428832&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '56c085ad-7f4f-4f5f-89b9-081513d0b4c5', 'multiverseId': 428832}, 'multiverseid': 428832}, {'name': 'Разрозненные Рощи', 'text': '({T}: добавьте {G} или {W} в ваше хранилище маны.)\\nРазрозненные Рощи выходят на поле битвы повернутыми.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Земля — Лес Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429101&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b8585ec7-bb24-4543-97ba-9baf30d0978a', 'multiverseId': 429101}, 'multiverseid': 429101}, {'name': '星散树丛', 'text': '（{T}：加{G}或{W}到你的法术力池中。）\\n星散树丛须横置进战场。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '地～树林／平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429370&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '057b3f1e-d1e8-4f70-9cbb-e5377dca8628', 'multiverseId': 429370}, 'multiverseid': 429370}, {'name': '星散樹叢', 'text': '（{T}：加{G}或{W}到你的魔法力池中。）\\n星散樹叢須橫置進戰場。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '地～樹林／平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429639&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ce9f7bbe-14bc-4895-a543-7b3f7a76ca00', 'multiverseId': 429639}, 'multiverseid': 429639}]", '[{\'name\': \'Verstricker der Nef-Saat\', \'text\': \'Verursacht Trampelschaden\\nDu kannst den Verstricker der Nef-Saat erschöpfen, sowie er angreift. Wenn du dies tust, erhält er +1/+2 bis zum Ende des Zuges. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Wer nicht den Rausch des Kampfes in sich lodern spürt, der wird niemals triumphieren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427115&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11f9e2ba-41c1-4257-823d-330b243d2a56\', \'multiverseId\': 427115}, \'multiverseid\': 427115}, {\'name\': \'Enredador de la simiente Nef\', \'text\': \'Arrolla.\\nPuedes espolear al Enredador de la simiente Nef en cuanto ataque. Cuando lo hagas, obtiene +1/+2 hasta el final del turno. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Si no sientes la emoción de la batalla viva como una llama, jamás triunfarás".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427384&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'581582b4-c09f-4fdd-82e7-7eb42f53aebb\', \'multiverseId\': 427384}, \'multiverseid\': 427384}, {\'name\': \'Enchevêtreur de la moisson Nef\', \'text\': "Piétinement\\nVous pouvez surmener l\'Enchevêtreur de la moisson Nef au moment où il attaque. Quand vous faites ainsi, il gagne +1/+2 jusqu\'à la fin du tour. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': "« Si vous ne ressentez pas l\'ivresse de la bataille, l\'existence de la flamme, vous ne triompherez jamais. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427653&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fedeb9de-0e1f-4ffe-ba35-282b21033100\', \'multiverseId\': 427653}, \'multiverseid\': 427653}, {\'name\': \'Intrappolatore della Messe Nef\', \'text\': "Travolgere\\nPuoi stremare l\'Intrappolatore della Messe Nef mentre attacca. Quando lo fai, prende +1/+2 fino alla fine del turno. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Se non sentite il fervore della battaglia, bruciante come una fiamma, non trionferete mai."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427922&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1790e532-a728-40d6-8deb-a6a3d1f5c94a\', \'multiverseId\': 427922}, \'multiverseid\': 427922}, {\'name\': \'ネフ一門の鉄球戦士\', \'text\': \'トランプル\\nネフ一門の鉄球戦士が攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、ターン終了時まで、これは＋１/＋２の修整を受ける。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「戦いに快楽を見出し炎のように生きる者にしか勝ち目はない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428191&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'adfa74d3-3864-4808-980b-fd4d67c84287\', \'multiverseId\': 428191}, \'multiverseid\': 428191}, {\'name\': \'네프 입문자 속박병\', \'text\': \'돌진\\n당신은 네프 입문자 속박병으로 공격을 선언하면서 네프 입문자 속박병을 분전시킬 수 있다. 그렇게 할 때, 네프 입문자 속박병은 턴종료까지 +1/+2를 받는다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"불꽃처럼 살아 있는 전투의 짜릿함을 느끼지 못한다면 결코 승리할 수 없다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428460&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b3d661cc-35ec-4056-83d7-1a342384c4cf\', \'multiverseId\': 428460}, \'multiverseid\': 428460}, {\'name\': \'Emaranhador da Safra Nef\', \'text\': \'Atropelar\\nVocê pode exaurir Emaranhador da Safra Nef conforme ele ataca. Quando você faz isso, ele recebe +1/+2 até o final do turno. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Se não sentir a emoção da batalha, viva como uma chama, você jamais triunfará."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428729&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5abcb9a-61df-4b64-8a6e-7cab44d74344\', \'multiverseId\': 428729}, \'multiverseid\': 428729}, {\'name\': \'Опутыватель Снопа Неф\', \'text\': \'Пробивной удар\\nВы можете подстегнуть Опутывателя Снопа Неф в момент его атаки. Когда вы это делаете, он получает +1/+2 до конца хода. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Если ты не чувствуешь азарта битвы, горячего, словно пламя, то никогда не достигнешь триумфа».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428998&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fa3c210b-793d-4e52-bd4f-f6c2d2d80a35\', \'multiverseId\': 428998}, \'multiverseid\': 428998}, {\'name\': \'奈法祀群掷绳手\', \'text\': \'践踏\\n你可以于奈法祀群掷绳手攻击时耗竭之。当你如此作时，它得+1/+2直到回合结束。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～人类／战士\', \'flavor\': \'「如果你没有战斗时的亢奋，没有火焰般的热忱，你将无法得胜。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429267&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3f35ac2-837b-4c39-8842-a6a5e3809cb5\', \'multiverseId\': 429267}, \'multiverseid\': 429267}, {\'name\': \'奈法祀群擲繩手\', \'text\': \'踐踏\\n你可以於奈法祀群擲繩手攻擊時耗竭之。當你如此作時，它得+1/+2直到回合結束。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～人類／戰士\', \'flavor\': \'「如果你沒有戰鬥時的亢奮，沒有火焰般的熱忱，你將無法得勝。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429536&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1baac088-0ea3-4e15-895f-9315edb2e8b0\', \'multiverseId\': 429536}, \'multiverseid\': 429536}]', "[{'name': 'Verweste Tümpel', 'text': '({T}: Erhöhe deinen Manavorrat um {U} oder {B}.)\\nDie Verwesten Tümpel kommen getappt ins Spiel.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land — Insel, Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427214&type=card', 'language': 'German', 'identifiers': {'scryfallId': '27f0fa85-8473-43cc-a235-6a6f5ca9e3f8', 'multiverseId': 427214}, 'multiverseid': 427214}, {'name': 'Estanques pestilentes', 'text': '({T}: Agrega {U} o {B} a tu reserva de maná.)\\nLos Estanques pestilentes entran al campo de batalla girados.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Tierra — Isla pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427483&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ae2224fc-bcc2-4139-9015-2e23eddf5553', 'multiverseId': 427483}, 'multiverseid': 427483}, {'name': 'Bassins fétides', 'text': '({T} : Ajoutez {U} ou {B} à votre réserve.)\\nLes Bassins fétides arrivent sur le champ de bataille engagés.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain : île et marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427752&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b9618da9-d7a6-4793-9059-491bba546a9f', 'multiverseId': 427752}, 'multiverseid': 427752}, {'name': 'Pozze Fetide', 'text': '({T}: Aggiungi {U} o {B} alla tua riserva di mana.)\\nLe Pozze Fetide entrano nel campo di battaglia TAPpate.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra — Isola Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428021&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '43ef756d-4bbc-497b-8c5e-eefd92677c6c', 'multiverseId': 428021}, 'multiverseid': 428021}, {'name': '異臭の池', 'text': '（{T}：あなたのマナ・プールに{U}か{B}を加える。）\\n異臭の池はタップ状態で戦場に出る。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': '土地 — 島・沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428290&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fd343b77-ffd1-46b6-9a6c-78da59321a28', 'multiverseId': 428290}, 'multiverseid': 428290}, {'name': '악취 물웅덩이', 'text': '({T}: {U} 또는 {B}를 당신의 마나풀에 담는다.)\\n악취 물웅덩이는 탭된 채로 전장에 들어온다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '대지 — 섬 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428559&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3d0dab66-5b1e-461d-b22c-52717a144a76', 'multiverseId': 428559}, 'multiverseid': 428559}, {'name': 'Lagoas Fétidas', 'text': '({T}: Adicione {U} ou {B} à sua reserva de mana.)\\nLagoas Fétidas entra no campo de batalha virada.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)', 'type': 'Terreno — Ilha Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428828&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2b824e40-eb62-4f13-8c1a-cc9bc3ade5a3', 'multiverseId': 428828}, 'multiverseid': 428828}, {'name': 'Зловонные Озера', 'text': '({T}: добавьте {U} или {B} в ваше хранилище маны.)\\nЗловонные Озера выходят на поле битвы повернутыми.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Земля — Остров Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429097&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '070f5e4b-caee-4c17-a432-46730f267b8a', 'multiverseId': 429097}, 'multiverseid': 429097}, {'name': '恶臭水塘', 'text': '（{T}：加{U}或{B}到你的法术力池中。）\\n恶臭水塘须横置进战场。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '地～海岛／沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429366&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '07a964bb-3faa-4b74-adbb-d09ec9fc8559', 'multiverseId': 429366}, 'multiverseid': 429366}, {'name': '惡臭水塘', 'text': '（{T}：加{U}或{B}到你的魔法力池中。）\\n惡臭水塘須橫置進戰場。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '地～海島／沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429635&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '62ee413d-df31-47bc-bad3-eeee0ac8de6f', 'multiverseId': 429635}, 'multiverseid': 429635}]", '[{\'name\': \'Vorbereitung // Kampf\', \'text\': \'Enttappe eine Kreatur deiner Wahl. Sie erhält +2/+2 und Lebensverknüpfung bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'faceName\': \'Vorbereitung\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427191&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7891ced5-96e9-467e-bf83-596868d692a9\', \'multiverseId\': 427191}, \'multiverseid\': 427191}, {\'name\': \'Preparación // Lucha\', \'text\': \'Endereza la criatura objetivo. Obtiene +2/+2 y gana la habilidad de vínculo vital hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'faceName\': \'Preparación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427460&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fa991189-28ca-42ec-b108-34db3a3b3381\', \'multiverseId\': 427460}, \'multiverseid\': 427460}, {\'name\': \'Préparation // Combat\', \'text\': "Dégagez la créature ciblée. Elle gagne +2/+2 et acquiert le lien de vie jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'faceName\': \'Préparation\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427729&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'555d5fa3-c715-49ca-a5e7-5df497f1aeec\', \'multiverseId\': 427729}, \'multiverseid\': 427729}, {\'name\': \'Preparata // Combattere\', \'text\': \'STAPpa una creatura bersaglio. Prende +2/+2 e ha legame vitale fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'faceName\': \'Preparata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427998&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4f08e22-6939-41b6-937e-fdac6f6a9fe7\', \'multiverseId\': 427998}, \'multiverseid\': 427998}, {\'name\': \'枕戈 // 待旦\', \'text\': \'クリーチャー１体を対象とし、それをアンタップする。ターン終了時まで、それは＋２/＋２の修整を受けるとともに絆魂を得る。\', \'type\': \'インスタント\', \'flavor\': None, \'faceName\': \'枕戈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428267&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2d0774c-acc8-49a8-9cee-762e2d94a70f\', \'multiverseId\': 428267}, \'multiverseid\': 428267}, {\'name\': \'준비 // 전투\', \'text\': \'생물을 목표로 정한다. 그 생물을 언탭한다. 그 생물은 턴종료까지 +2/+2를 받고 생명연결을 얻는다.\', \'type\': \'순간마법\', \'flavor\': None, \'faceName\': \'준비\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428536&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d47b1687-e827-40a9-947d-a7ca06383d2d\', \'multiverseId\': 428536}, \'multiverseid\': 428536}, {\'name\': \'Preparar // Lutar\', \'text\': \'Desvire a criatura alvo. Ela recebe +2/+2 e ganha vínculo com a vida até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'faceName\': \'Preparar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428805&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8cb25905-4b40-4344-9a54-cb1ec851e9f8\', \'multiverseId\': 428805}, \'multiverseid\': 428805}, {\'name\': \'Подготовка // К Бою\', \'text\': \'Разверните целевое существо. Оно получает +2/+2 и Цепь жизни до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'faceName\': \'Подготовка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429074&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46aecc23-9dad-4cd0-aac8-4ddd0f3ad114\', \'multiverseId\': 429074}, \'multiverseid\': 429074}, {\'name\': \'备战 // 互斗\', \'text\': \'重置目标生物。直到回合结束，它得+2/+2且获得系命异能。\', \'type\': \'瞬间\', \'flavor\': None, \'faceName\': \'备战\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429343&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bff56754-e1e8-45a6-8f12-ea40bc36ae02\', \'multiverseId\': 429343}, \'multiverseid\': 429343}, {\'name\': \'備戰 // 互鬥\', \'text\': \'重置目標生物。直到回合結束，它得+2/+2且獲得繫命異能。\', \'type\': \'瞬間\', \'flavor\': None, \'faceName\': \'備戰\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429612&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c5bc8240-611f-4cb5-9971-1297edaa59ce\', \'multiverseId\': 429612}, \'multiverseid\': 429612}]', '[{\'name\': \'Vorstoß // Sieg\', \'text\': \'Eine Kreatur deiner Wahl erhält +X/+0 bis zum Ende des Zuges, wobei X gleich ihrer Stärke ist.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'faceName\': \'Vorstoß\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427189&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b409d1a2-9607-4433-9aa7-1065f82d3467\', \'multiverseId\': 427189}, \'multiverseid\': 427189}, {\'name\': \'Adelante // Victoria\', \'text\': \'La criatura objetivo obtiene +X/+0 hasta el final del turno, donde X es su fuerza.\', \'type\': \'Instantáneo\', \'flavor\': None, \'faceName\': \'Adelante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427458&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dc690fb8-795e-42d3-b85b-bf9426bd65e3\', \'multiverseId\': 427458}, \'multiverseid\': 427458}, {\'name\': \'En avant // Victoire\', \'text\': "La créature ciblée gagne +X/+0 jusqu\'à la fin du tour, X étant sa force.", \'type\': \'Éphémère\', \'flavor\': None, \'faceName\': \'En avant\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427727&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'caa57179-8f83-479a-b2a6-26044f2cc492\', \'multiverseId\': 427727}, \'multiverseid\': 427727}, {\'name\': \'Condurre // Vittoria\', \'text\': \'Una creatura bersaglio prende +X/+0 fino alla fine del turno, dove X è la sua forza.\', \'type\': \'Istantaneo\', \'flavor\': None, \'faceName\': \'Condurre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427996&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd929404-bdcd-42c9-a535-b53c01a3bf74\', \'multiverseId\': 427996}, \'multiverseid\': 427996}, {\'name\': \'先手 // 必勝\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋Ｘ/＋０の修整を受ける。Ｘはそれのパワーに等しい。\', \'type\': \'インスタント\', \'flavor\': None, \'faceName\': \'先手\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428265&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2caff08-3f58-486c-9b4f-aff750bfa5c2\', \'multiverseId\': 428265}, \'multiverseid\': 428265}, {\'name\': \'전진 // 승리\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +X/+0을 받는다. X는 그 생물의 공격력이다.\', \'type\': \'순간마법\', \'flavor\': None, \'faceName\': \'전진\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428534&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3e082b11-34d4-4e7e-9bee-40fb01d12f84\', \'multiverseId\': 428534}, \'multiverseid\': 428534}, {\'name\': \'Marcha // Vitória\', \'text\': \'A criatura alvo recebe +X/+0 até o final do turno, sendo X o seu poder.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'faceName\': \'Marcha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428803&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'177eef3b-d87a-489f-994d-8c8d00b87c32\', \'multiverseId\': 428803}, \'multiverseid\': 428803}, {\'name\': \'Вперед // К Победе\', \'text\': \'Целевое существо получает +Х/+0 до конца хода, где Х — значение его силы.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'faceName\': \'Вперед\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429072&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'796d510b-c29b-4dfa-9770-169ac529673a\', \'multiverseId\': 429072}, \'multiverseid\': 429072}, {\'name\': \'挺进 // 胜利\', \'text\': \'目标生物得+X/+0直到回合结束，X为其力量。\', \'type\': \'瞬间\', \'flavor\': None, \'faceName\': \'挺进\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429341&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9940baab-dd9b-40db-be76-6561e6a2d149\', \'multiverseId\': 429341}, \'multiverseid\': 429341}, {\'name\': \'挺進 // 勝利\', \'text\': \'目標生物得+X/+0直到回合結束，X為其力量。\', \'type\': \'瞬間\', \'flavor\': None, \'faceName\': \'挺進\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429610&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7393de9e-855e-49a7-9348-f4878870eda8\', \'multiverseId\': 429610}, \'multiverseid\': 429610}]', '[{\'name\': \'Vorzügliche Qualen\', \'text\': \'Verteile zwei -1/-1-Marken auf eine oder zwei Kreaturen deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wo man in der Stadt auch ist, man spürt die Gegenwart des Gott-Pharaos. Ist das nicht wundervoll?" —Ukhat, Wesirin der Weihe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427080&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9b9fe70-56c6-4c36-b71e-740a0d9e7728\', \'multiverseId\': 427080}, \'multiverseid\': 427080}, {\'name\': \'Agonía grandiosa\', \'text\': \'Distribuye dos contadores -1/-1 entre una o dos criaturas objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Desde cualquier parte de la ciudad, puedes sentir la presencia del Dios Faraón. Saber eso es un consuelo". —Ukhat, visir de la iniciación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427349&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd22d476-3a72-404b-a916-9f2cdf1cc2fd\', \'multiverseId\': 427349}, \'multiverseid\': 427349}, {\'name\': \'Angoisse splendide\', \'text\': \'Répartissez deux marqueurs -1/-1 entre une ou deux créatures ciblées.\', \'type\': \'Éphémère\', \'flavor\': "« Où que vous soyez dans la ville, vous pouvez sentir la présence du Dieu-Pharaon. Que cela vous rassure. » —Ukhat, vizir de l\'initiation", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427618&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9fd5793-bef3-4e2b-b3de-3d63ff159b66\', \'multiverseId\': 427618}, \'multiverseid\': 427618}, {\'name\': \'Sublime Agonia\', \'text\': \'Distribuisci due segnalini -1/-1 tra una o due creature bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Il Dio Faraone è onnipresente qui in città. Che ciò vi sia di conforto!" —Ukhat, visir dell\\\'iniziazione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'530d7b55-0110-48bc-a244-6c5d335a143d\', \'multiverseId\': 427887}, \'multiverseid\': 427887}, {\'name\': \'華麗な苦悶\', \'text\': \'クリーチャー１体か２体を対象とし、それらの上に－１/－１カウンターを２個、望むように割り振って置く。\', \'type\': \'インスタント\', \'flavor\': \'「街の中では常に王神の存在を感じるわ。慰めになさい。」 ――修練の侍臣、ウカト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428156&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6d09777-0350-42ad-b028-b04dba8647a4\', \'multiverseId\': 428156}, \'multiverseid\': 428156}, {\'name\': \'미려한 고뇌\', \'text\': \'생물 한 개 또는 두 개를 목표로 정한다. 그 생물들에 -1/-1 카운터 두 개를 배분한다.\', \'type\': \'순간마법\', \'flavor\': \'"도시에 있을 때면 언제나 신 파라오의 존재를 느낄 수 있다. 이로부터 위안을 얻어라." —입회의 고관 우카트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428425&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c1a39f2c-76ea-4fc3-bcb6-40918db38523\', \'multiverseId\': 428425}, \'multiverseid\': 428425}, {\'name\': \'Esplêndida Agonia\', \'text\': \'Distribua dois marcadores -1/-1 entre uma ou duas criaturas alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Onde quer que esteja na cidade, você consegue sentir a presença do Faraó-Deus. Conforte-se com isso." — Ukhat, vizir da iniciação\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428694&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f7a297f-d49e-4e13-8b4d-c5c034cade8e\', \'multiverseId\': 428694}, \'multiverseid\': 428694}, {\'name\': \'Блистательная Агония\', \'text\': \'Распределите два жетона -1/-1 между одним или двумя целевыми существами.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«В каждом уголке города вы можете чувствовать присутствие Бога-Фараона. Ищите в этом утешение». — Укхат, визирь посвящения\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428963&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'12a55e16-3a22-4339-bcdf-e178bea85108\', \'multiverseId\': 428963}, \'multiverseid\': 428963}, {\'name\': \'华美苦痛\', \'text\': \'将两个-1/-1指示物分配给一个或两个目标生物。\', \'type\': \'瞬间\', \'flavor\': \'「无论你在城中何处，都会感受到法老神的存在。接受这一点吧。」 ～启程维齐尔乌凯特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429232&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f186662c-b2f9-43af-90cd-9e0f00a57a6c\', \'multiverseId\': 429232}, \'multiverseid\': 429232}, {\'name\': \'華美苦痛\', \'text\': \'將兩個-1/-1指示物分配給一個或兩個目標生物。\', \'type\': \'瞬間\', \'flavor\': \'「無論你在城中何處，都會感受到法老神的存在。接受這一點吧。」 ～啟程維齊爾烏凱特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429501&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8a0cfc7d-5d38-46e9-a18d-ed728d980beb\', \'multiverseId\': 429501}, \'multiverseid\': 429501}]', '[{\'name\': \'Wachsamer Naga\', \'text\': \'Du kannst den Wachsamen Naga erschöpfen, sowie er angreift. Wenn du dies tust, ziehe eine Karte. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Naga, Zauberer\', \'flavor\': \'Die gespaltene Zunge der Naga nimmt Gerüche vergangener, gegenwärtiger und mitunter sogar zukünftiger Ereignisse wahr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427164&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26210b46-4151-4746-8ebe-9bfb00d397a4\', \'multiverseId\': 427164}, \'multiverseid\': 427164}, {\'name\': \'Naga avizor\', \'text\': \'Puedes espolear al Naga avizor en cuanto ataque. Cuando lo hagas, roba una carta. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Hechicero naga\', \'flavor\': \'La lengua bífida de los naga puede detectar rastros de olores del pasado, del presente y, a veces, incluso del futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427433&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'172958b3-de37-488e-a0df-5092014d787a\', \'multiverseId\': 427433}, \'multiverseid\': 427433}, {\'name\': \'Naga alerte\', \'text\': \'Vous pouvez surmener le Naga alerte au moment où il attaque. Quand vous faites ainsi, piochez une carte. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)\', \'type\': \'Créature : naga et sorcier\', \'flavor\': "La langue fourchue des nagas est sensible aux pistes olfactives du passé, du présent et parfois même de l\'avenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427702&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee88c85f-8fcf-49de-9ba8-34ab2f6b93a5\', \'multiverseId\': 427702}, \'multiverseid\': 427702}, {\'name\': \'Naga Osservatore\', \'text\': \'Puoi stremare il Naga Osservatore mentre attacca. Quando lo fai, pesca una carta. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)\', \'type\': \'Creatura — Mago Naga\', \'flavor\': \'La lingua biforcuta dei naga è sensibile alle tracce lasciate dagli effluvi del passato, del presente e a volte persino del futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427971&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5052255f-82fe-4680-9d99-0f44a65c4198\', \'multiverseId\': 427971}, \'multiverseid\': 427971}, {\'name\': \'用心深いナーガ\', \'text\': \'用心深いナーガが攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、カードを１枚引く。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — ナーガ・ウィザード\', \'flavor\': \'ナーガの二股の舌は風が運ぶ臭いを敏感に嗅ぎ分ける。過去や現在や、ときには未来の臭いまでも。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428240&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3173c80c-205b-43f4-89a2-48df543407bb\', \'multiverseId\': 428240}, \'multiverseid\': 428240}, {\'name\': \'경계하는 나가\', \'text\': \'당신은 경계하는 나가로 공격을 선언하면서 경계하는 나가를 분전시킬 수 있다. 그렇게 할 때, 카드 한 장을 뽑는다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 나가 마법사\', \'flavor\': \'나가의 갈라진 혀는 매우 예민해서 과거, 현재, 때로는 미래의 냄새 흔적도 찾아낼 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428509&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b3c6bfb5-1326-49eb-b3f4-d28ef5314f4e\', \'multiverseId\': 428509}, \'multiverseid\': 428509}, {\'name\': \'Naga Vigilante\', \'text\': \'Você pode exaurir Naga Vigilante conforme ele ataca. Quando fizer isso, compre um card. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Naga Mago\', \'flavor\': \'A língua bifurcada das nagas é sensível a trilhas efêmeras de aromas do passado, do presente e, às vezes, até mesmo do futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428778&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4889a93d-99a8-40eb-8820-a3ca881ecf7f\', \'multiverseId\': 428778}, \'multiverseid\': 428778}, {\'name\': \'Нага-Наблюдатель\', \'text\': \'Вы можете подстегнуть Нагу-Наблюдателя в момент его атаки. Когда вы это делаете, возьмите карту. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Нага Чародей\', \'flavor\': \'Раздвоенный язык наги способен уловить мимолетные следы запахов из прошлого, настоящего, а иногда — и из будущего.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429047&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4679f2de-3bcf-4fe5-8f00-7a4f71badb94\', \'multiverseId\': 429047}, \'multiverseid\': 429047}, {\'name\': \'警醒那伽\', \'text\': \'你可以于警醒那伽攻击时耗竭之。当你如此作时，抓一张牌。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～那伽／法术师\', \'flavor\': \'那伽的叉状蛇信对飘散在空中的气味尤其敏感，能够分辨出它是来自过去、现在甚或未来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429316&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0133330d-6ef6-4032-b76b-fa26f730a880\', \'multiverseId\': 429316}, \'multiverseid\': 429316}, {\'name\': \'警醒那伽\', \'text\': \'你可以於警醒那伽攻擊時耗竭之。當你如此作時，抽一張牌。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～那伽／魔法師\', \'flavor\': \'那伽的叉狀蛇信對飄散在空中的氣味尤其敏感，能夠分辨出它是來自過去、現在甚或未來。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429585&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6c18e708-6a67-4204-bff1-1abfa47656ac\', \'multiverseId\': 429585}, \'multiverseid\': 429585}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427225&type=card', 'language': 'German', 'identifiers': {'scryfallId': '23599d73-9fc0-4afd-b35f-212c352441b8', 'multiverseId': 427225}, 'multiverseid': 427225}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427494&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e0db9883-0e30-40f5-a8b0-2d870475629a', 'multiverseId': 427494}, 'multiverseid': 427494}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427763&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b7400b0d-394f-4e77-994d-c96247b8e745', 'multiverseId': 427763}, 'multiverseid': 427763}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428032&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '78ec7f38-4f3c-4b6a-92dd-2a31961a8324', 'multiverseId': 428032}, 'multiverseid': 428032}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428301&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6283101f-a1e8-4254-a337-5706033d4914', 'multiverseId': 428301}, 'multiverseid': 428301}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428570&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'cf25a0e7-90e3-4819-a532-088d79392ae5', 'multiverseId': 428570}, 'multiverseid': 428570}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428839&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9e278b0c-acfd-4bd4-bdd8-97c8ea05d94c', 'multiverseId': 428839}, 'multiverseid': 428839}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429108&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '008ca7d6-3224-4f25-b721-27f1e89ad573', 'multiverseId': 429108}, 'multiverseid': 429108}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429377&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8ac8adad-47f5-461c-bf4b-933788f55057', 'multiverseId': 429377}, 'multiverseid': 429377}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429646&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2bf6dce9-709b-4ba8-bcce-15c348bd0380', 'multiverseId': 429646}, 'multiverseid': 429646}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427238&type=card', 'language': 'German', 'identifiers': {'scryfallId': '207eb2d2-1642-46f3-a5d1-597547ab074a', 'multiverseId': 427238}, 'multiverseid': 427238}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427507&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9987c4b3-d2b6-4319-a3bd-3873d3083d72', 'multiverseId': 427507}, 'multiverseid': 427507}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427776&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7f6298fa-47d0-48d8-a993-ed85b396fbb5', 'multiverseId': 427776}, 'multiverseid': 427776}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428045&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '427051e2-3870-411e-80eb-1878088803a6', 'multiverseId': 428045}, 'multiverseid': 428045}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428314&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5816f513-d352-47ef-a6d5-30a6727ded76', 'multiverseId': 428314}, 'multiverseid': 428314}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428583&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '347e0369-ddf1-49c3-b60c-9a021dddc4d3', 'multiverseId': 428583}, 'multiverseid': 428583}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428852&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f550dc0a-545e-4e03-b669-95a00022b5a9', 'multiverseId': 428852}, 'multiverseid': 428852}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429121&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3ad55ec0-64f8-43cb-af56-7f7353d108d3', 'multiverseId': 429121}, 'multiverseid': 429121}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429390&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c6447f8d-3a8a-4b11-b1bd-0c49b10def2b', 'multiverseId': 429390}, 'multiverseid': 429390}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429659&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '52beb61e-20d0-449e-8875-96d21e1d1df2', 'multiverseId': 429659}, 'multiverseid': 429659}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427239&type=card', 'language': 'German', 'identifiers': {'scryfallId': '76c6b21e-7325-4718-a926-62ce66797c46', 'multiverseId': 427239}, 'multiverseid': 427239}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427508&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fec8d026-83b9-4043-ab9e-13f84ea38d65', 'multiverseId': 427508}, 'multiverseid': 427508}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427777&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ac7d19cd-4e85-48e9-b25a-dc78bd7de092', 'multiverseId': 427777}, 'multiverseid': 427777}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428046&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '81ac92a4-fa55-46eb-90ce-3e64ac6e645c', 'multiverseId': 428046}, 'multiverseid': 428046}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428315&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fa1689a3-bad7-493e-91b4-57bad0ac9556', 'multiverseId': 428315}, 'multiverseid': 428315}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428584&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '2bb72f3c-ae55-4483-b39d-c56253408902', 'multiverseId': 428584}, 'multiverseid': 428584}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428853&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '813c511f-483c-4f4f-b6ea-4e8067d23d1d', 'multiverseId': 428853}, 'multiverseid': 428853}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429122&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1b4c8881-5468-4c80-86c1-6f4a5d29b86b', 'multiverseId': 429122}, 'multiverseid': 429122}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429391&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cdb2a450-da80-4762-ae6a-786176f3b1af', 'multiverseId': 429391}, 'multiverseid': 429391}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429660&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'dbe9a23b-cb49-46db-8e32-009fc6afd5ed', 'multiverseId': 429660}, 'multiverseid': 429660}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427240&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5de2331f-ea47-4955-9d51-fdd56f50b2f0', 'multiverseId': 427240}, 'multiverseid': 427240}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427509&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '01a78edc-d07b-42b6-8ec5-b1b6b2d46f63', 'multiverseId': 427509}, 'multiverseid': 427509}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427778&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f564d2fd-7cf3-4c3c-8bf9-6729681b433f', 'multiverseId': 427778}, 'multiverseid': 427778}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428047&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'be6f595a-f089-4057-90f9-16983adc96b5', 'multiverseId': 428047}, 'multiverseid': 428047}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428316&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bf125b88-5d81-4ce5-a759-8a6b1691d741', 'multiverseId': 428316}, 'multiverseid': 428316}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428585&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd479ae9d-87ea-484c-8df3-f697fc31fc3e', 'multiverseId': 428585}, 'multiverseid': 428585}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428854&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '88fa93e3-8eaa-46b5-8a83-4e1aef00a8fd', 'multiverseId': 428854}, 'multiverseid': 428854}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429123&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'db593e33-6678-41aa-8f56-4904ad4d9938', 'multiverseId': 429123}, 'multiverseid': 429123}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429392&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5a986411-f5c2-4612-ad67-4a3cdcf2164e', 'multiverseId': 429392}, 'multiverseid': 429392}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429661&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c5fc6663-4a42-459e-8d23-5ab3b5466602', 'multiverseId': 429661}, 'multiverseid': 429661}]", '[{\'name\': \'Waldlandstrom\', \'text\': \'Der Waldlandstrom kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G} oder {U}.\', \'type\': \'Land\', \'flavor\': \'Die Wege, die sich das Wasser durch das Land bahnt, reflektieren die Wege, auf denen Ätherströme die Wolken durchdringen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afa12911-3d2b-4eb0-8f6c-a1db30eeed8d\', \'multiverseId\': 429733}, \'multiverseid\': 429733}, {\'name\': \'Arroyo forestal\', \'text\': \'El Arroyo forestal entra al campo de batalla girado.\\n{T}: Agrega {G} o {U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'El agua esculpe su camino por la tierra para reflejar el curso del éter que surca las nubes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429859&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bb6edb94-8992-4e54-9be0-94207733a147\', \'multiverseId\': 429859}, \'multiverseid\': 429859}, {\'name\': \'Ruisseau des sylves\', \'text\': \'Le Ruisseau des sylves arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G} ou {U} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Les cours d\'eau creusent leur lit dans la terre pour refléter les chemins que prennent les flux d\'Éther dans les nuages.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8f06254a-d59e-428c-80b7-8ff64f38fd36\', \'multiverseId\': 429751}, \'multiverseid\': 429751}, {\'name\': \'Ruscello nel Bosco\', \'text\': \'Il Ruscello nel Bosco entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} o {U} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "I corsi d\'acqua scavano nel terreno percorsi paralleli a quelli tracciati dai flussi d\'etere tra le nuvole.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429769&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b6902d01-60dd-40c3-8e20-802f4b8ed973\', \'multiverseId\': 429769}, \'multiverseid\': 429769}, {\'name\': \'森林地の小川\', \'text\': \'森林地の小川はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}か{U}を加える。\', \'type\': \'土地\', \'flavor\': \'霊気の流れが雲を通り抜ける道を映し出すかのように、小川もその経路を形作る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429787&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'048bd9c6-8fd7-49d6-8adf-e070484b4cf8\', \'multiverseId\': 429787}, \'multiverseid\': 429787}, {\'name\': \'삼림지 개울\', \'text\': \'삼림지 개울은 탭된 채로 전장에 들어온다.\\n{T}: {G} 또는 {U}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'대지를 뚫고 흐르는 물길은 마치 구름을 뚫고 흐르는 에테르 강을 연상시킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429805&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f6c860ff-03c7-41a9-9bcb-26f4c85980a4\', \'multiverseId\': 429805}, \'multiverseid\': 429805}, {\'name\': \'Riacho da Floresta\', \'text\': \'Riacho da Floresta entra no campo de batalha virado.\\n{T}: Adicione {G} ou {U} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': "Os cursos d\'água traçam no terreno percursos paralelos aos desenhados pelos fluxos de éter entre as nuvens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429823&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f56e9f75-f76b-4075-a4aa-3208977aa486\', \'multiverseId\': 429823}, \'multiverseid\': 429823}, {\'name\': \'Лесной Ручей\', \'text\': \'Лесной Ручей выходит на поле битвы повернутым.\\n{T}: добавьте {G} или {U} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Ручьи и реки промывают себе путь в земле, повторяя узоры, что эфирные потоки рисуют в облаках.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429841&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5c290878-028f-4c98-99ba-bb61092581ff\', \'multiverseId\': 429841}, \'multiverseid\': 429841}, {\'name\': \'林地溪流\', \'text\': \'林地溪流须横置进战场。\\n{T}：加{G}或{U}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'溪流自大地穿行而过，照映出乙太流穿越云间的路径。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429697&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'82472a03-deb3-4dba-88ba-cfb35868074f\', \'multiverseId\': 429697}, \'multiverseid\': 429697}, {\'name\': \'林地溪流\', \'text\': \'林地溪流須橫置進戰場。\\n{T}：加{G}或{U}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'溪流自大地穿行而過，照映出乙太流穿越雲間的路徑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429715&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6d69a364-21ad-4cab-abef-1740caaf0e16\', \'multiverseId\': 429715}, \'multiverseid\': 429715}]', '[{\'name\': \'Wegbereitende Geweihte\', \'text\': \'Wenn die Wegbereitende Geweihte ins Spiel kommt, lege drei -1/-1-Marken auf eine Kreatur deiner Wahl, die du kontrollierst.\\n{T}, entferne eine -1/-1-Marke von der Wegbereitenden Geweihten: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427131&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7807d128-1598-42eb-9b17-1fc5725dbc7b\', \'multiverseId\': 427131}, \'multiverseid\': 427131}, {\'name\': \'Iniciada canalizadora\', \'text\': \'Cuando la Iniciada canalizadora entre al campo de batalla, pon tres contadores -1/-1 sobre la criatura objetivo que controlas.\\n{T}, remover un contador -1/-1 de la Iniciada canalizadora: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Criatura — Druida humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427400&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d243c375-4180-4cb1-9531-297a551cfd21\', \'multiverseId\': 427400}, \'multiverseid\': 427400}, {\'name\': \'Adepte canaliseuse\', \'text\': "Quand l\'Adepte canaliseuse arrive sur le champ de bataille, mettez trois marqueurs -1/-1 sur une créature ciblée que vous contrôlez.\\n{T}, retirez un marqueur -1/-1 de l\'Adepte canaliseuse : Ajoutez un mana de la couleur de votre choix à votre réserve.", \'type\': \'Créature : humain et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427669&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa98db21-1783-4568-b5b1-9749de4791cd\', \'multiverseId\': 427669}, \'multiverseid\': 427669}, {\'name\': \'Iniziata Incanalatrice\', \'text\': "Quando l\'Iniziata Incanalatrice entra nel campo di battaglia, metti tre segnalini -1/-1 su una creatura bersaglio che controlli.\\n{T}, Rimuovi un segnalino -1/-1 dall\'Iniziata Incanalatrice: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.", \'type\': \'Creatura — Druido Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427938&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'19046f8b-24b0-4035-8717-186a675bc1cc\', \'multiverseId\': 427938}, \'multiverseid\': 427938}, {\'name\': \'媒介者の修練者\', \'text\': \'媒介者の修練者が戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に－１/－１カウンターを３個置く。\\n{T}, 媒介者の修練者の上から－１/－１カウンターを１個取り除く：あなたのマナ・プールに好きな色１色のマナ１点を加える。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428207&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb2d1091-4ffb-469d-a729-9992e42fea22\', \'multiverseId\': 428207}, \'multiverseid\': 428207}, {\'name\': \'전달사 입회자\', \'text\': \'전달사 입회자가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 세 개를 올려놓는다.\\n{T}, 전달사 입회자에서 -1/-1 카운터 한 개를 제거한다: 당신의 마나풀에 원하는 색의 마나 한 개를 담는다.\', \'type\': \'생물 — 인간 드루이드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428476&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a1931ead-d13d-46dc-8cf6-3ac7a33c52ee\', \'multiverseId\': 428476}, \'multiverseid\': 428476}, {\'name\': \'Iniciada Canalizadora\', \'text\': \'Quando Iniciada Canalizadora entrar no campo de batalha, coloque três marcadores -1/-1 na criatura alvo que você controla.\\n{T}, Remova um marcador -1/-1 de Iniciada Canalizadora: Adicione um mana de qualquer cor à sua reserva de mana.\', \'type\': \'Criatura — Humano Druida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428745&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01531334-660c-47d7-a0cd-602062afe6ef\', \'multiverseId\': 428745}, \'multiverseid\': 428745}, {\'name\': \'Преобразующая Послушница\', \'text\': \'Когда Преобразующая Послушница выходит на поле битвы, положите три жетона -1/-1 на целевое существо под вашим контролем.\\n{T}, удалите один жетон -1/-1 с Преобразующей Послушницы: добавьте одну ману любого цвета в ваше хранилище маны.\', \'type\': \'Существо — Человек Друид\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429014&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'36e3c86c-510c-447a-bf25-d142ab53b20d\', \'multiverseId\': 429014}, \'multiverseid\': 429014}, {\'name\': \'联能祀徒\', \'text\': \'当联能祀徒进战场时，在目标由你操控的生物上放置三个-1/-1指示物。\\n{T}，从联能祀徒上移去一个-1/-1指示物：加一点任意颜色的法术力到你的法术力池中。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429283&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df760492-181e-46f7-9ecd-264504bacfda\', \'multiverseId\': 429283}, \'multiverseid\': 429283}, {\'name\': \'聯能祀徒\', \'text\': \'當聯能祀徒進戰場時，在目標由你操控的生物上放置三個-1/-1指示物。\\n{T}，從聯能祀徒上移去一個-1/-1指示物：加一點任意顏色的魔法力到你的魔法力池中。\', \'type\': \'生物～人類／德魯伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429552&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a2dcabf4-8926-4d11-9cef-4289564b084c\', \'multiverseId\': 429552}, \'multiverseid\': 429552}]', '[{\'name\': \'Werkzeuge des Einbalsamierers\', \'text\': \'Aktivierte Fähigkeiten von Kreaturenkarten in deinem Friedhof kosten beim Aktivieren {1} weniger.\\nTappe einen ungetappten Zombie, den du kontrollierst: Ein Spieler deiner Wahl legt die oberste Karte seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Artefakt\', \'flavor\': \'„Sie mögen tot sein, aber diese Mumien verstehen ihr Handwerk." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427198&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eede7fd2-561a-40a3-a7ca-3f49c61384a9\', \'multiverseId\': 427198}, \'multiverseid\': 427198}, {\'name\': \'Herramientas de embalsamador\', \'text\': \'Cuesta {1} menos activar las habilidades activadas de las cartas de criatura en tu cementerio.\\nGirar un Zombie enderezado que controlas: El jugador objetivo pone la primera carta de su biblioteca en su cementerio.\', \'type\': \'Artefacto\', \'flavor\': \'"Puede que estén muertas, pero estas momias son maestras de su oficio". —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427467&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'831e131b-7bcc-42b5-862b-ebeb350c0508\', \'multiverseId\': 427467}, \'multiverseid\': 427467}, {\'name\': "Outils de l\'embaumeur", \'text\': \'Les capacités activées des cartes de créature de votre cimetière coûtent {1} de moins à activer.\\nEngagez un zombie dégagé que vous contrôlez : Le joueur ciblé met la carte du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Artefact\', \'flavor\': \'« Elles sont peut-être mortes, mais ces momies maîtrisent leur art. » —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b6359a3-4654-4f78-9b30-aaa31d700639\', \'multiverseId\': 427736}, \'multiverseid\': 427736}, {\'name\': \'Strumenti da Imbalsamatore\', \'text\': \'Le abilità attivate delle carte creatura nel tuo cimitero costano {1} in meno per essere attivate.\\nTAPpa uno Zombie STAPpato che controlli: Un giocatore bersaglio mette nel suo cimitero la prima carta del suo grimorio.\', \'type\': \'Artefatto\', \'flavor\': \'"Saranno morte, ma queste mummie sono maestre nella loro arte." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428005&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ee8ca65-1f0f-4cf1-9282-d6bcdb09b85d\', \'multiverseId\': 428005}, \'multiverseid\': 428005}, {\'name\': \'不朽処理者の道具\', \'text\': \'あなたの墓地にあるクリーチャー・カードの起動型能力を起動するためのコストは{1}少なくなる。\\nあなたがコントロールするアンタップ状態のゾンビ１体をタップする：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上のカードを自分の墓地に置く。\', \'type\': \'アーティファクト\', \'flavor\': \'「死んでいるとはいえ、このミイラたちは熟練の職人だな。」 ――ジェイス・ベレレン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428274&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fbdb723b-d393-4910-83c1-8e3df90919c2\', \'multiverseId\': 428274}, \'multiverseid\': 428274}, {\'name\': \'방부처리 도구\', \'text\': \'당신의 무덤에 있는 생물 카드의 활성화능력은 활성화하는 데 {1}이 덜 든다.\\n당신이 조종하는 언탭된 좀비를 탭한다: 플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 한 장을 자신의 무덤에 넣는다.\', \'type\': \'마법물체\', \'flavor\': \'"비록 시체 신세지만 이 미라들의 수완은 극히 뛰어나다." —제이스 벨레렌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428543&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05138c2a-1025-485b-8a5f-8974a7dc096c\', \'multiverseId\': 428543}, \'multiverseid\': 428543}, {\'name\': \'Ferramentas do Embalsamador\', \'text\': \'As habilidades ativadas de cards de criatura em seu cemitério custam {1} a menos para serem ativadas.\\nVire um Zumbi desvirado que você controla: O jogador alvo coloca o card do topo do grimório dele em seu próprio cemitério.\', \'type\': \'Artefato\', \'flavor\': \'"Elas podem estar mortas, mas essas múmias são mestres em seu ofício." — Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428812&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'396d3152-8a5b-4985-a108-ec16f65bd110\', \'multiverseId\': 428812}, \'multiverseid\': 428812}, {\'name\': \'Инструменты Бальзамировщика\', \'text\': \'Активация активируемых способностей карт существ на вашем кладбище стоит на {1} меньше.\\nПоверните неповернутого Зомби под вашим контролем: целевой игрок кладет верхнюю карту своей библиотеки на свое кладбище.\', \'type\': \'Артефакт\', \'flavor\': \'«Может, они и мертвы, но эти мумии — мастера своего дела». — Джейс Белерен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429081&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0fb7c2a-87f6-4baf-9ae3-3b779af51e64\', \'multiverseId\': 429081}, \'multiverseid\': 429081}, {\'name\': \'防腐师工具\', \'text\': \'你坟墓场中的生物牌之起动式异能减少{1}来起动。\\n横置一个由你操控且未横置的灵俑：目标牌手将其牌库顶牌置入其坟墓场。\', \'type\': \'神器\', \'flavor\': \'「这些木乃伊可能早已死去，但他们确实是个中高手。」 ～杰斯贝连\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429350&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bf3f2340-932c-4bb6-9de9-57bf890da015\', \'multiverseId\': 429350}, \'multiverseid\': 429350}, {\'name\': \'防腐師工具\', \'text\': \'你墳墓場中的生物牌之起動式異能減少{1}來起動。\\n橫置一個由你操控且未橫置的殭屍：目標玩家將其牌庫頂牌置入其墳墓場。\', \'type\': \'神器\', \'flavor\': \'「這些木乃伊可能早已死去，但他們確實是箇中高手。」 ～傑斯貝連\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429619&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2e7b76a7-9339-4428-bcc4-87e4a8c8c8ef\', \'multiverseId\': 429619}, \'multiverseid\': 429619}]', '[{\'name\': \'Wesir der fallenden Sande\', \'text\': \'{T}: Enttappe eine andere bleibende Karte deiner Wahl.\\nUmwandlung {1}{U} ({1}{U}, wirf diese Karte ab: Ziehe eine Karte.)\\nWenn du den Wesir der fallenden Sande umwandelst, enttappe eine bleibende Karte deiner Wahl.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Zeit ist wie der Luxa: Auch wenn sie nur in eine Richtung fließt, so kann sie doch umgelenkt werden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427046&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23860e5a-cce9-4a6b-81cc-af2be41d03d7\', \'multiverseId\': 427046}, \'multiverseid\': 427046}, {\'name\': \'Visir de las arenas tornadizas\', \'text\': \'{T}: Endereza otro permanente objetivo.\\nCiclo {1}{U}. ({1}{U}, descartar esta carta: Roba una carta.)\\nCuando actives la habilidad de ciclo del Visir de las arenas tornadizas, endereza el permanente objetivo.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"El tiempo es como el río Luxa: aunque fluye en una dirección, puede desviarse".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427315&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09def7c3-2602-480f-989e-42cac33fe35b\', \'multiverseId\': 427315}, \'multiverseid\': 427315}, {\'name\': \'Vizir de la chute du sable\', \'text\': \'{T} : Dégagez un autre permanent ciblé.\\nRecyclage {1}{U} ({1}{U}, défaussez-vous de cette carte : Piochez une carte.)\\nQuand vous recyclez le Vizir de la chute du sable, dégagez un permanent ciblé.\', \'type\': \'Créature : humain et clerc\', \'flavor\': "« Le temps est semblable au fleuve Luxa : même s\'il s\'écoule dans une direction, il peut être détourné. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427584&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d24ff31-99fa-4c35-9df2-a9492181f91a\', \'multiverseId\': 427584}, \'multiverseid\': 427584}, {\'name\': \'Visir delle Sabbie Cadenti\', \'text\': \'{T}: STAPpa un altro permanente bersaglio.\\nCiclo {1}{U} ({1}{U}, Scarta questa carta: Pesca una carta.)\\nQuando cicli il Visir delle Sabbie Cadenti, STAPpa un permanente bersaglio.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Il tempo è come il fiume Luxa: sebbene scorra in una direzione, può essere deviato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427853&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3af9d82-c6dd-4d65-a89f-504e5ff763bc\', \'multiverseId\': 427853}, \'multiverseid\': 427853}, {\'name\': \'砂時計の侍臣\', \'text\': \'{T}：他のパーマネント１つを対象とし、それをアンタップする。\\nサイクリング{1}{U}（{1}{U}, このカードを捨てる：カードを１枚引く。）\\nあなたが砂時計の侍臣をサイクリングしたとき、パーマネント１つを対象とし、それをアンタップする。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「時の流れはルクサ川のようなものだが、川と違い時間は逆転できる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428122&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'295e4981-5a4e-4edb-9d84-d551c32ded92\', \'multiverseId\': 428122}, \'multiverseid\': 428122}, {\'name\': \'요동치는 모래의 고관\', \'text\': \'{T}: 다른 지속물을 목표로 정한다. 그 지속물을 언탭한다.\\n순환 {1}{U} ({1}{U}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\\n당신이 요동치는 모래의 고관을 순환할 때, 지속물을 목표로 정한다. 그 지속물을 언탭한다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"시간은 럭사 강과 같다. 비록 한쪽으로 흐르지만 방향이 바뀔 수 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428391&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'db98172a-42a5-4bae-9b2f-0f88ad70730c\', \'multiverseId\': 428391}, \'multiverseid\': 428391}, {\'name\': \'Vizir das Areias Correntes\', \'text\': \'{T}: Desvire outra permanente alvo.\\nReciclar {1}{U} ({1}{U}, Descarte este card: Compre um card.)\\nQuando você reciclar Vizir das Areias Correntes, desvire a permanente alvo.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"O tempo é como o rio Luxa — embora corra em uma direção, pode ser desviado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428660&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f2ea500d-219c-4495-bf2b-7a6271b49617\', \'multiverseId\': 428660}, \'multiverseid\': 428660}, {\'name\': \'Визирь Перевернувшихся Часов\', \'text\': \'{T}: разверните другой целевой перманент.\\nЦикл {1}{U} ({1}{U}, сбросьте эту карту: возьмите карту.)\\nКогда вы совершаете цикл Визиря Перевернувшихся Часов, разверните целевой перманент.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Время подобно реке Лукса — оно течет в одном направлении, но его можно заставить свернуть в сторону».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428929&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1b471d9d-445f-4fb8-b1ad-9e9ce30266c8\', \'multiverseId\': 428929}, \'multiverseid\': 428929}, {\'name\': \'弄沙维齐尔\', \'text\': \'{T}：重置另一个目标永久物。\\n循环{1}{U}（{1}{U}，弃掉此牌：抓一张牌。）\\n当你循环弄沙维齐尔时，重置目标永久物。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「时间就像罗夏河～尽管只流向一方，但仍能牵动。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429198&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'63d1b714-375a-4e7b-ba61-c93115f25762\', \'multiverseId\': 429198}, \'multiverseid\': 429198}, {\'name\': \'弄沙維齊爾\', \'text\': \'{T}：重置另一個目標永久物。\\n循環{1}{U}（{1}{U}，棄掉此牌：抽一張牌。）\\n當你循環弄沙維齊爾時，重置目標永久物。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'「時間就像羅夏河～儘管只流向一方，但仍能牽動。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429467&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'718b6582-7e64-4851-9555-42044fd812c9\', \'multiverseId\': 429467}, \'multiverseid\': 429467}]', '[{\'name\': \'Wesirin der Heilmittel\', \'text\': \'Falls eine oder mehrere -1/-1-Marken auf eine Kreatur gelegt würden, die du kontrollierst, werden stattdessen so viele -1/-1-Marken minus einer auf sie gelegt.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Du wirst all deine Kräfte für die anstehenden Prüfungen brauchen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427009&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'daee20a5-2e8e-4865-8a90-2e38d89f3393\', \'multiverseId\': 427009}, \'multiverseid\': 427009}, {\'name\': \'Visir de los remedios\', \'text\': \'Si fueran a ponerse uno o más contadores -1/-1 sobre una criatura que controlas, en vez de eso, se pone la misma cantidad de contadores -1/-1 menos uno sobre ella.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Necesitarás todas tus fuerzas para las pruebas que vendrán".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'89a5753c-9944-4783-8f5f-c1db7076acb6\', \'multiverseId\': 427278}, \'multiverseid\': 427278}, {\'name\': \'Vizir des remèdes\', \'text\': \'Si au moins un marqueur -1/-1 devait être mis sur une créature que vous contrôlez, mettez autant de marqueurs -1/-1 moins un sur elle à la place.\', \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Vous aurez besoin de toutes vos forces pour affronter les épreuves qui vous attendent. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427547&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc85c464-45f5-4e54-85b3-a6626b2e2b6e\', \'multiverseId\': 427547}, \'multiverseid\': 427547}, {\'name\': \'Visir dei Medicamenti\', \'text\': \'Se uno o più segnalini -1/-1 stanno per essere messi su una creatura che controlli, metti invece su quella creatura altrettanti segnalini -1/-1 meno uno.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Avrete bisogno di tutte le vostre forze per le ordalie che vi attendono."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427816&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'117cc80b-afdd-4054-857f-2d4ec9b4849f\', \'multiverseId\': 427816}, \'multiverseid\': 427816}, {\'name\': \'療治の侍臣\', \'text\': \'あなたがコントロールするクリーチャーの上に－１/－１カウンターが１個以上置かれるなら、代わりに、その数から１を引いた個数の－１/－１カウンターをそれの上に置く。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「来るべき試練では全力を尽くさねばならないだろう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428085&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ee1dd8f-75b5-41e5-8bc5-2cd9259bf66e\', \'multiverseId\': 428085}, \'multiverseid\': 428085}, {\'name\': \'치료의 고관\', \'text\': \'당신이 조종하는 생물에 -1/-1 카운터가 한 개 이상 놓이려고 한다면, 대신에 그 숫자에서 하나를 뺀 만큼의 -1/-1 카운터를 놓는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"곧 다가올 시험에 온 힘을 쏟아야 한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428354&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6e2fc094-89eb-446e-9db3-f4eed4219420\', \'multiverseId\': 428354}, \'multiverseid\': 428354}, {\'name\': \'Vizir dos Remédios\', \'text\': \'Se um ou mais marcadores -1/-1 seriam colocados em uma criatura que você controla, em vez disso, coloque nela aquela quantidade menos um de marcadores -1/-1.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Você precisará de toda a sua força para as provas que virão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428623&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7352c43b-fa0d-4809-9e97-c5171f8dbed8\', \'multiverseId\': 428623}, \'multiverseid\': 428623}, {\'name\': \'Визирь Снадобий\', \'text\': \'Если на существо под вашим контролем должны быть положены один или более жетонов -1/-1, вместо этого на то существо кладется на один жетон -1/-1 меньше.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«В грядущих испытаниях тебе понадобятся все твои силы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428892&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7189828c-1d04-443b-86cf-5bea438fa0fb\', \'multiverseId\': 428892}, \'multiverseid\': 428892}, {\'name\': \'缓伤维齐尔\', \'text\': \'如果将会在某个由你操控的生物上放置一个或数个-1/-1指示物，则改为在其上放置该数量减一的-1/-1指示物。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「痊愈之后，你才能在未来祀炼中全力以赴。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429161&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'48dbc468-d95b-487a-a6f4-2f0ec2e5ff32\', \'multiverseId\': 429161}, \'multiverseid\': 429161}, {\'name\': \'緩傷維齊爾\', \'text\': \'如果將會在某個由你操控的生物上放置一個或數個-1/-1指示物，則改為在其上放置該數量減一的-1/-1指示物。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'「痊癒之後，你才能在未來祀煉中全力以赴。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429430&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f3c2db33-d8be-4fab-9646-e6c222db2d0c\', \'multiverseId\': 429430}, \'multiverseid\': 429430}]', '[{\'name\': \'Wesirin der Menagerie\', \'text\': \'Du kannst dir die oberste Karte deiner Bibliothek anschauen. (Du kannst dies jederzeit tun.)\\nDu kannst die oberste Karte deiner Bibliothek wirken, falls es eine Kreaturenkarte ist.\\nDu kannst Mana ausgeben, als wäre es Mana eines beliebigen Typs, um Kreaturenzauber zu wirken.\', \'type\': \'Kreatur — Naga, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427163&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b3043ff3-9f48-451d-ab5e-17245f227568\', \'multiverseId\': 427163}, \'multiverseid\': 427163}, {\'name\': \'Visir del bestiario\', \'text\': \'Puedes mirar la primera carta de tu biblioteca. (Puedes hacer esto en cualquier momento.)\\nPuedes lanzar la primera carta de tu biblioteca si es una carta de criatura.\\nPuedes usar maná como si fuera maná de cualquier tipo para lanzar los hechizos de criatura.\', \'type\': \'Criatura — Clérigo naga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427432&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aab5b91b-af0e-4a15-b399-537883864a54\', \'multiverseId\': 427432}, \'multiverseid\': 427432}, {\'name\': \'Vizir de la ménagerie\', \'text\': "Vous pouvez regarder la carte du dessus de votre bibliothèque. (Vous pouvez faire ceci à tout moment.)\\nVous pouvez lancer la carte du dessus de votre bibliothèque si c\'est une carte de créature.\\nVous pouvez dépenser du mana comme si c\'était du mana de n\'importe quel type pour lancer des sorts de créature.", \'type\': \'Créature : naga et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427701&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bff64c84-0672-44ad-9b36-0c93fe9ae730\', \'multiverseId\': 427701}, \'multiverseid\': 427701}, {\'name\': \'Visir del Serraglio\', \'text\': \'Puoi guardare la prima carta del tuo grimorio. (Puoi farlo in qualsiasi momento.)\\nPuoi lanciare la prima carta del tuo grimorio se è una carta creatura.\\nPuoi spendere il mana come se fosse mana di qualsiasi tipo per lanciare magie creatura.\', \'type\': \'Creatura — Chierico Naga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427970&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'149ecb01-20fa-403e-adec-f614de61ef77\', \'multiverseId\': 427970}, \'multiverseid\': 427970}, {\'name\': \'生類の侍臣\', \'text\': \'あなたはあなたのライブラリーの一番上のカードを見てもよい。（これはいつでも行ってよい。）\\nあなたのライブラリーの一番上のカードがクリーチャー・カードであるなら、あなたはそれを唱えてもよい。\\nあなたは、クリーチャー・呪文を唱えるために、任意のマナを望むタイプのマナであるかのように支払ってもよい。\', \'type\': \'クリーチャー — ナーガ・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428239&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f29de329-16cb-4158-a597-23cda026ffb0\', \'multiverseId\': 428239}, \'multiverseid\': 428239}, {\'name\': \'야생 동물의 고관\', \'text\': \'당신은 당신의 서고 맨 위의 카드를 볼 수 있다. (당신은 언제든지 이렇게 할 수 있다.)\\n당신은 서고 맨 위 카드가 생물 카드라면 그 카드를 발동할 수 있다.\\n당신은 마나를 원하는 유형의 마나인 것처럼 지불하여 생물 주문을 발동할 수 있다.\', \'type\': \'생물 — 나가 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428508&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9ab78922-21e0-4c78-9c20-451185d1055a\', \'multiverseId\': 428508}, \'multiverseid\': 428508}, {\'name\': \'Vizir do Bestiário\', \'text\': \'Você pode olhar o card do topo de seu grimório. (Você pode fazer isso a qualquer momento.)\\nVocê pode conjurar o card do topo de seu grimório se este for um card de criatura.\\nVocê pode gastar mana como se fosse de qualquer tipo para conjurar mágicas de criatura.\', \'type\': \'Criatura — Naga Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a04ea672-654e-4a42-8b31-582afefb77b2\', \'multiverseId\': 428777}, \'multiverseid\': 428777}, {\'name\': \'Визирь Зверинца\', \'text\': \'Вы можете посмотреть верхнюю карту вашей библиотеки. (Вы можете делать это в любое время.)\\nВы можете разыграть верхнюю карту вашей библиотеки, если это карта существа, не являющаяся землей.\\nВы можете тратить ману на разыгрывание заклинаний существ, как будто это мана любого типа.\', \'type\': \'Существо — Нага Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429046&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e286e1b1-bcf1-42e3-aadb-99bd0530009d\', \'multiverseId\': 429046}, \'multiverseid\': 429046}, {\'name\': \'司兽维齐尔\', \'text\': \'你可以检视你的牌库顶牌。（你随时均可如此作。）\\n如果你的牌库顶牌是生物牌，你可以施放之。\\n你可以将法术力视同任意类别的法术力来支付施放生物咒语的费用。\', \'type\': \'生物～那伽／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429315&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'694ecf89-abee-48c2-a6a7-9c85ab919dd6\', \'multiverseId\': 429315}, \'multiverseid\': 429315}, {\'name\': \'司獸維齊爾\', \'text\': \'你可以檢視你的牌庫頂牌。（你隨時均可如此作。）\\n如果你的牌庫頂牌是生物牌，你可以施放之。\\n你可以將魔法力視同任意類別的魔法力來支付施放生物咒語的費用。\', \'type\': \'生物～那伽／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429584&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d83686bb-c335-473c-aaaf-aa2f74d1d122\', \'multiverseId\': 429584}, \'multiverseid\': 429584}]', '[{\'name\': \'Wesirin der vielen Gesichter\', \'text\': \'Du kannst die Wesirin der vielen Gesichter als eine Kopie einer beliebigen Kreatur im Spiel ins Spiel kommen lassen, außer dass, falls sie einbalsamiert wurde, der Kreaturenspielstein keine Manakosten hat, weiß und zusätzlich zu seinen anderen Kreaturentypen ein Zombie ist.\\nEinbalsamieren {3}{U}{U}\', \'type\': \'Kreatur — Gestaltwandler, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427045&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6217b98-29dc-4cdb-b90c-d04dfc0d1ba2\', \'multiverseId\': 427045}, \'multiverseid\': 427045}, {\'name\': \'Visir de muchos rostros\', \'text\': \'Puedes hacer que la Visir de muchos rostros entre al campo de batalla como una copia de cualquier criatura en el campo de batalla, excepto que, si la Visir de muchos rostros fue embalsamada, la ficha no tiene coste de maná, es blanca y es un Zombie además de sus otros tipos.\\nEmbalsamar {3}{U}{U}.\', \'type\': \'Criatura — Clérigo metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427314&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3847d8f7-3a59-4d58-a0c1-f6f56f84f00b\', \'multiverseId\': 427314}, \'multiverseid\': 427314}, {\'name\': \'Vizir aux nombreux visages\', \'text\': "Vous pouvez faire que le Vizir aux nombreux visages arrive sur le champ de bataille comme une copie de n\'importe quelle créature sur le champ de bataille, excepté si le Vizir aux nombreux visages a été embaumé, le jeton n\'a pas de coût de mana, est blanc et c\'est un zombie en plus de ses autres types.\\nEmbaumement {3}{U}{U}", \'type\': \'Créature : changeforme et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427583&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a935227-8935-421b-98f7-4be816dff538\', \'multiverseId\': 427583}, \'multiverseid\': 427583}, {\'name\': \'Visir dei Molti Volti\', \'text\': \'Puoi far entrare la Visir dei Molti Volti nel campo di battaglia come una copia di qualsiasi creatura sul campo di battaglia, tranne che, se la Visir dei Molti Volti è stata imbalsamata, la pedina non ha un costo di mana, è bianca ed è uno Zombie in aggiunta ai suoi altri tipi.\\nImbalsamare {3}{U}{U}\', \'type\': \'Creatura — Chierico Polimorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427852&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5830178b-ad39-45c3-b4be-ad58259a07de\', \'multiverseId\': 427852}, \'multiverseid\': 427852}, {\'name\': \'多面相の侍臣\', \'text\': \'多面相の侍臣が不朽を行われていたなら、あなたはそのトークンを、マナ・コストを持たず、白であり、それの他のタイプに加えてゾンビであることを除き、戦場にある他のクリーチャー１体のコピーとして戦場に出してもよい。そうでないなら、あなたはこれを戦場にある他のクリーチャー１体のコピーとして戦場に出してもよい。\\n不朽{3}{U}{U}\', \'type\': \'クリーチャー — 多相の戦士・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428121&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'878e92fa-6f95-4088-ad15-a78b896b9bd9\', \'multiverseId\': 428121}, \'multiverseid\': 428121}, {\'name\': \'다면 고관\', \'text\': \'당신은 다면 고관으로 하여금 전장에 있는 생물의 복사본으로 전장에 들어오도록 할 수 있다. 다면 고관이 방부처리되었다면, 토큰은 마나 비용이 없고, 백색이며, 자신의 다른 유형에 더불어 좀비이다.\\n방부처리 {3}{U}{U}\', \'type\': \'생물 — 변신괴물 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428390&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3474f62b-c335-4271-8f34-6a3410e93dfc\', \'multiverseId\': 428390}, \'multiverseid\': 428390}, {\'name\': \'Vizir das Muitas Faces\', \'text\': \'Você pode fazer com que Vizir das Muitas Faces entre no campo de batalha como uma cópia de qualquer criatura no campo de batalha, com a exceção de que, se Vizir das Muitas Faces tiver sido embalsamado, a ficha não tem custo de mana, é branca e é um Zumbi além de seus outros tipos.\\nEmbalsamar {3}{U}{U}\', \'type\': \'Criatura — Metamorfo Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428659&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'354c6243-8f15-4715-8ff6-99701e4d66a2\', \'multiverseId\': 428659}, \'multiverseid\': 428659}, {\'name\': \'Визирь Многих Лиц\', \'text\': \'Вы можете заставить Визиря Многих Лиц выйти на поле битвы в качестве копии любого существа на поле битвы, но при этом, если Визирь Многих Лиц был забальзамирован, то у фишки нет мана-стоимости, она белая и является Зомби в дополнение к своим другим типам.\\nБальзамирование {3}{U}{U}\', \'type\': \'Существо — Имитатор Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428928&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4a448210-b72d-4ebd-98cd-31bdd4677886\', \'multiverseId\': 428928}, \'multiverseid\': 428928}, {\'name\': \'多面维齐尔\', \'text\': \'你可以使多面维齐尔当成战场上任一生物的复制品来进入战场，但如果多面维齐尔已遗存，则该衍生物没有法术力费用，是白色且额外具有灵俑此类别。\\n遗存{3}{U}{U}\', \'type\': \'生物～变形兽／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429197&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'51372665-8780-404f-bddf-863aa1298ad1\', \'multiverseId\': 429197}, \'multiverseid\': 429197}, {\'name\': \'多面維齊爾\', \'text\': \'你可以使多面維齊爾當成戰場上任一生物的複製品來進入戰場，但如果多面維齊爾已遺存，則該衍生物沒有魔法力費用，是白色且額外具有殭屍此類別。\\n遺存{3}{U}{U}\', \'type\': \'生物～變形獸／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429466&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'df014cdd-2558-41f1-a177-6049c1148ba3\', \'multiverseId\': 429466}, \'multiverseid\': 429466}]', '[{\'name\': \'Wesirin des Aufschubs\', \'text\': \'Aufblitzen\\nWenn die Wesirin des Aufschubs ins Spiel kommt, kannst du eine Kreatur deiner Wahl, die in diesem Zug angegriffen oder geblockt hat, ins Exil schicken. Bringe jene Karte zu Beginn des nächsten Endsegments unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427008&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a5fc1da7-85ea-4f79-a624-069747a53f04\', \'multiverseId\': 427008}, \'multiverseid\': 427008}, {\'name\': \'Visir de la postergación\', \'text\': \'Destello.\\nCuando la Visir de la postergación entre al campo de batalla, puedes exiliar la criatura objetivo si atacó o bloqueó este turno. Regresa esa carta al campo de batalla bajo el control de su propietario al comienzo del próximo paso final.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427277&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3062f233-26e8-447b-81c0-f5219cc34bb1\', \'multiverseId\': 427277}, \'multiverseid\': 427277}, {\'name\': \'Vizir de sursis\', \'text\': \'Flash\\nQuand le Vizir de sursis arrive sur le champ de bataille, vous pouvez exiler une créature ciblée si elle a attaqué ou bloqué ce tour-ci. Renvoyez cette carte sur le champ de bataille sous le contrôle de son propriétaire au début de la prochaine étape de fin.\', \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427546&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4544e53-a443-4a3e-82a9-9660855e37a1\', \'multiverseId\': 427546}, \'multiverseid\': 427546}, {\'name\': \'Visir della Dilazione\', \'text\': "Lampo\\nQuando la Visir della Dilazione entra nel campo di battaglia, puoi esiliare una creatura bersaglio se ha attaccato o bloccato in questo turno. Rimetti sul campo di battaglia quella carta sotto il controllo del suo proprietario all\'inizio della prossima sottofase finale.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427815&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3b01cf3-bf0d-4f44-a321-cc42e5cf7f4f\', \'multiverseId\': 427815}, \'multiverseid\': 427815}, {\'name\': \'猶予の侍臣\', \'text\': \'瞬速\\n猶予の侍臣が戦場に出たとき、クリーチャー１体を対象とする。このターンにそれが攻撃していたかブロックしていたなら、あなたはそれを追放してもよい。次の終了ステップの開始時に、そのカードをオーナーのコントロール下で戦場に戻す。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428084&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10cb4a7a-9a32-4925-8419-6939c5d94d03\', \'multiverseId\': 428084}, \'multiverseid\': 428084}, {\'name\': \'유예의 고관\', \'text\': \'섬광\\n유예의 고관이 전장에 들어올 때, 생물을 목표로 정한다. 이 턴에 그 생물이 공격하거나 방어했다면, 당신은 그 생물을 추방할 수 있다. 다음 종료단 시작에 그렇게 추방된 카드를 소유자의 조종하에 전장으로 되돌린다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428353&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'baadacf4-0ac8-472d-90b5-6317a5b1d472\', \'multiverseId\': 428353}, \'multiverseid\': 428353}, {\'name\': \'Vizir do Diferimento\', \'text\': \'Lampejo\\nQuando Vizir do Diferimento entra no campo de batalha, você pode exilar a criatura alvo se ela atacou ou bloqueou neste turno. Devolva aquele card ao campo de batalha sob o controle de seu dono no início da próxima etapa final.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428622&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9327174-c385-4d8a-aa24-d4329d47517b\', \'multiverseId\': 428622}, \'multiverseid\': 428622}, {\'name\': \'Визирь Отсрочки\', \'text\': \'Миг\\nКогда Визирь Отсрочки выходит на поле битвы, вы можете изгнать целевое существо, если оно атаковало или блокировало в этом ходу. Верните ту карту на поле битвы под контролем ее владельца в начале следующего заключительного шага.\', \'type\': \'Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428891&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0ac0320-c9ff-447f-a189-022b288fa727\', \'multiverseId\': 428891}, \'multiverseid\': 428891}, {\'name\': \'退敌维齐尔\', \'text\': \'闪现\\n当退敌维齐尔进战场时，如果目标生物本回合曾进行攻击或阻挡，你可以放逐该生物。在下一个结束步骤开始时，将所放逐的牌在其拥有者的操控下返回战场。\', \'type\': \'生物～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429160&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09850eb7-2f94-4d09-bea9-4ff75d85bb36\', \'multiverseId\': 429160}, \'multiverseid\': 429160}, {\'name\': \'退敵維齊爾\', \'text\': \'閃現\\n當退敵維齊爾進戰場時，如果目標生物本回合曾進行攻擊或阻擋，你可以放逐該生物。在下一個結束步驟開始時，將所放逐的牌在其擁有者的操控下返回戰場。\', \'type\': \'生物～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429429&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'29e5ef05-aa9f-47b4-a9d2-cc2adb6e6fb3\', \'multiverseId\': 429429}, \'multiverseid\': 429429}]', '[{\'name\': \'Wie vorhergesagt\', \'text\': \'Lege zu Beginn deines Versorgungssegments eine Zeitmarke auf Wie vorhergesagt.\\nEinmal pro Zug kannst du {0} bezahlen, anstatt die Manakosten eines Zauberspruchs mit umgewandelten Manakosten von X oder weniger zu bezahlen, den du wirkst, wobei X gleich der Anzahl an Zeitmarken auf Wie vorhergesagt ist.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427013&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7d5cdcc-9e50-4e53-8bb2-9338c32cd3af\', \'multiverseId\': 427013}, \'multiverseid\': 427013}, {\'name\': \'Según la profecía\', \'text\': \'Al comienzo de tu mantenimiento, pon un contador de tiempo sobre Según la profecía.\\nUna vez por turno, puedes pagar {0} en vez de pagar el coste de maná de un hechizo que lances con coste de maná convertido de X o menos, donde X es la cantidad de contadores de tiempo sobre Según la profecía.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427282&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2cc90d43-a6bc-4cb5-bfb4-a3a2ce39cfaa\', \'multiverseId\': 427282}, \'multiverseid\': 427282}, {\'name\': \'Conforme à la prédiction\', \'text\': "Au début de votre entretien, mettez un marqueur « temps » sur Conforme à la prédiction.\\nUne fois par tour, vous pouvez payer {0} à la place du coût de mana d\'un sort avec un coût converti de mana inférieur ou égal à X que vous lancez, X étant le nombre de marqueurs « temps » sur Conforme à la prédiction.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427551&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3604bb58-314e-4021-bc70-a2958e8d6013\', \'multiverseId\': 427551}, \'multiverseid\': 427551}, {\'name\': \'Come Predetto\', \'text\': "All\'inizio del tuo mantenimento, metti un segnalino tempo su Come Predetto.\\nUna volta per turno, puoi pagare {0} invece di pagare il costo di mana di una magia che lanci con costo di mana convertito pari o inferiore a X, dove X è il numero di segnalini tempo su Come Predetto.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427820&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3a2199b3-f957-4045-a87b-a846aa57f415\', \'multiverseId\': 427820}, \'multiverseid\': 427820}, {\'name\': \'予言により\', \'text\': \'あなたのアップキープの開始時に、予言によりの上に時間カウンターを１個置く。\\n毎ターン１回、あなたは点数で見たマナ・コストがＸ以下の呪文を、それのマナ・コストではなく{0}を支払って唱えてもよい。Ｘは予言によりの上に置かれている時間カウンターの総数に等しい。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428089&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c5d23d0a-8d4e-4481-adb2-d37da5659caf\', \'multiverseId\': 428089}, \'multiverseid\': 428089}, {\'name\': \'정해진 대로\', \'text\': \'당신의 유지단 시작에, 정해진 대로에 시간 카운터 한 개를 올려놓는다.\\n매 턴마다 한 번씩, 당신은 당신이 발동하는 전환마나비용이 X 이하인 주문의 마나 비용을 지불하는 대신에 {0}를 지불할 수 있다. X는 정해진 대로에 올려진 시간 카운터 개수이다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428358&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7c61f113-8ae6-485f-9180-54e926b7e8da\', \'multiverseId\': 428358}, \'multiverseid\': 428358}, {\'name\': \'Como Predito\', \'text\': \'No início de sua manutenção, coloque um marcador de tempo em Como Predito.\\nUma vez a cada turno, você pode pagar {0} em vez de pagar o custo de mana de uma mágica que você conjurar com custo de mana convertido igual ou inferior a X, sendo X o número de marcadores de tempo em Como Predito.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428627&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c25abb2-934f-43b7-a5aa-c24925b83b70\', \'multiverseId\': 428627}, \'multiverseid\': 428627}, {\'name\': \'Как Предсказано\', \'text\': \'В начале вашего шага поддержки положите один временной жетон на Как Предсказано.\\nОдин раз в каждом ходу вы можете заплатить {0} вместо оплаты мана-стоимости разыгрываемого вами заклинания с конвертированной мана-стоимостью X или меньше, где X — количество временных жетонов на Как Предсказано.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428896&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'765ec026-8c9c-4667-8bc7-f1dd52d51442\', \'multiverseId\': 428896}, \'multiverseid\': 428896}, {\'name\': \'预示成真\', \'text\': \'在你的维持开始时，在预示成真上放置一个计时指示物。\\n你于施放总法术力费用等于或小于X的咒语时，可以支付{0}，而不支付其法术力费用，X为预示成真上的计时指示物数量。每回合限如此作一次。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429165&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aff2a056-7d0e-475d-9d54-531a2d4f348c\', \'multiverseId\': 429165}, \'multiverseid\': 429165}, {\'name\': \'預示成真\', \'text\': \'在你的維持開始時，在預示成真上放置一個計時指示物。\\n你於施放總魔法力費用等於或小於X的咒語時，可以支付{0}，而不支付其魔法力費用，X為預示成真上的計時指示物數量。每回合限如此作一次。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429434&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'83f58766-4a2f-47dd-8604-7b8d94c1cd64\', \'multiverseId\': 429434}, \'multiverseid\': 429434}]', '[{\'name\': \'Winde der Zurechtweisung\', \'text\': \'Bringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück. Jeder Spieler legt die obersten zwei Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich weiß bereits, dass ihr meine Prüfung nicht bestehen werdet."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427047&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d7b7138-60b4-427c-ab62-681c50a9aaf6\', \'multiverseId\': 427047}, \'multiverseid\': 427047}, {\'name\': \'Vientos de reprimenda\', \'text\': \'Regresa el permanente objetivo que no sea tierra a la mano de su propietario. Cada jugador pone las dos primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'"He visto que no pasarán mi prueba".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427316&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'716e28c3-c037-4218-bca3-bdd7736aa5a4\', \'multiverseId\': 427316}, \'multiverseid\': 427316}, {\'name\': \'Vents de blâme\', \'text\': \'Renvoyez le permanent non-terrain ciblé dans la main de son propriétaire. Chaque joueur met les deux cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Éphémère\', \'flavor\': "« J\'ai prédit que vous ne réussiriez pas mon épreuve. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427585&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'80454248-9c92-429e-a777-ebc8a1e46447\', \'multiverseId\': 427585}, \'multiverseid\': 427585}, {\'name\': \'Venti di Sdegno\', \'text\': \'Fai tornare un permanente non terra bersaglio in mano al suo proprietario. Ogni giocatore mette nel proprio cimitero le prime due carte del proprio grimorio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ho avuto una visione: non supererete la mia ordalia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427854&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31719ee8-6901-4e42-a4ce-0fc12ab1d9cb\', \'multiverseId\': 427854}, \'multiverseid\': 427854}, {\'name\': \'叱責の風\', \'text\': \'土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。各プレイヤーはそれぞれ、自分のライブラリーの一番上からカードを２枚自分の墓地に置く。\', \'type\': \'インスタント\', \'flavor\': \'「お前が我の試練を突破しないことは予見していた。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428123&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc589484-0f49-4d54-8f40-a5795029606b\', \'multiverseId\': 428123}, \'multiverseid\': 428123}, {\'name\': \'질책의 바람\', \'text\': \'대지가 아닌 지속물을 목표로 정한다. 그 지속물을 소유자의 손으로 되돌린다. 각 플레이어는 자신의 서고 맨 위의 카드 두 장을 자신의 무덤에 넣는다.\', \'type\': \'순간마법\', \'flavor\': \'"난 네가 시험을 통과하지 못할 거라고 예상했다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428392&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a083973e-9107-470f-8ba6-b625f7b5b0ed\', \'multiverseId\': 428392}, \'multiverseid\': 428392}, {\'name\': \'Ventos da Repreensão\', \'text\': \'Devolva a permanente alvo que não seja terreno para a mão de seu dono. Cada jogador coloca os dois cards do topo do próprio grimório no próprio cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Previ que você não passará em minha prova."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428661&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4fcb4153-7ed9-4c93-a7b7-58d69fc15c14\', \'multiverseId\': 428661}, \'multiverseid\': 428661}, {\'name\': \'Ветра Укора\', \'text\': \'Верните целевой не являющийся землей перманент в руку его владельца. Каждый игрок кладет две верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Я предвидел, что вы не пройдете мое испытание».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428930&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1ea481df-5860-4d0b-94a4-e26fa02b569f\', \'multiverseId\': 428930}, \'multiverseid\': 428930}, {\'name\': \'驳斥狂风\', \'text\': \'将目标非地永久物移回其拥有者手上。每位牌手各将其牌库顶的两张牌置入其坟墓场。\', \'type\': \'瞬间\', \'flavor\': \'「我已预见你无法通过我的祀炼。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429199&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb236281-e38b-4395-9070-1a1610e87d79\', \'multiverseId\': 429199}, \'multiverseid\': 429199}, {\'name\': \'駁斥狂風\', \'text\': \'將目標非地永久物移回其擁有者手上。每位玩家各將其牌庫頂的兩張牌置入其墳墓場。\', \'type\': \'瞬間\', \'flavor\': \'「我已預見你無法通過我的祀煉。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429468&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fe4f3c02-ac6e-4153-a80a-4fb0fb18ae8d\', \'multiverseId\': 429468}, \'multiverseid\': 429468}]', '[{\'name\': \'Wohltat des Rhonas\', \'text\': \'Decke die obersten fünf Karten deiner Bibliothek auf. Du kannst davon eine Kreaturenkarte und/oder eine Verzauberungskarte auf deine Hand nehmen. Lege den Rest auf deinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'Es obliegt den Göttern, dafür zu sorgen, dass jeder bereit für das Jenseits ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427127&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b21bf210-110b-4228-a15d-b2d2afd5ce4f\', \'multiverseId\': 427127}, \'multiverseid\': 427127}, {\'name\': \'Gracia de Rhonas\', \'text\': \'Muestra las cinco primeras cartas de tu biblioteca. Puedes poner en tu mano una carta de criatura y/o una carta de encantamiento que se encuentre entre ellas. Pon el resto en tu cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'Son los dioses quienes deben ayudar a todos a ser dignos del más allá.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427396&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40730c46-fbe4-45b9-8856-88e3ea2febdf\', \'multiverseId\': 427396}, \'multiverseid\': 427396}, {\'name\': \'Bienfait de Rhonas\', \'text\': "Révélez les cinq cartes du dessus de votre bibliothèque. Vous pouvez mettre une carte de créature et/ou d\'enchantement parmi elles dans votre main. Mettez le reste dans votre cimetière.", \'type\': \'Rituel\', \'flavor\': "C\'est aux dieux qu\'incombe la tâche de rendre les adeptes dignes de l\'au-delà.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427665&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'231b3129-883a-4286-a368-2ad58d864deb\', \'multiverseId\': 427665}, \'multiverseid\': 427665}, {\'name\': \'Munificenza di Rhonas\', \'text\': \'Rivela le prime cinque carte del tuo grimorio. Puoi aggiungere alla tua mano una carta creatura e/o una carta incantesimo scelta tra esse. Metti le altre nel tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': "Spetta alle divinità aiutare tutti a diventare prescelti per l\'aldilà.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427934&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bed4110d-905a-40bc-85fe-025502a18272\', \'multiverseId\': 427934}, \'multiverseid\': 427934}, {\'name\': \'ロナスの施し\', \'text\': \'あなたのライブラリーの一番上からカードを５枚公開する。あなたはその中からクリーチャー・カード最大１枚とエンチャント・カード最大１枚をあなたの手札に加えてもよい。残りをあなたの墓地に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'神々の役目は、すべての人々が来世を獲得できるよう尽くすことである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428203&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a42eace9-5c2a-452f-9fa1-4e02fcaead7a\', \'multiverseId\': 428203}, \'multiverseid\': 428203}, {\'name\': \'로나스의 은혜\', \'text\': \'당신의 서고 맨 위의 카드 다섯 장을 공개한다. 당신은 그중 생물 카드 한 장 및/또는 부여마법 카드 한 장을 당신의 손으로 가져갈 수 있다. 나머지 카드는 당신의 무덤에 넣는다.\', \'type\': \'집중마법\', \'flavor\': \'모두가 사후 세계로 들어가도록 돕는 일은 신들에게 달렸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428472&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'63d47f1c-5b57-47d0-82e3-39ceb17cba97\', \'multiverseId\': 428472}, \'multiverseid\': 428472}, {\'name\': \'Beneficência de Rhonas\', \'text\': \'Revele os cinco cards do topo de seu grimório. Você pode colocar um card de criatura e/ou encantamento dentre eles em sua mão. Coloque o restante em seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'Cabe aos deuses ajudar todos a se tornarem dignos da vida após a morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428741&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'628189d4-c011-4f3d-b9e6-355c8831c783\', \'multiverseId\': 428741}, \'multiverseid\': 428741}, {\'name\': \'Благоволение Ронаса\', \'text\': \'Покажите пять верхних карт вашей библиотеки. Вы можете положить находящуюся среди них карту существа и (или) карту чар в вашу руку. Положите остальные карты на ваше кладбище.\', \'type\': \'Волшебство\', \'flavor\': \'Долг богов — помочь всякому заслужить загробную жизнь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429010&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'73d66a7f-4838-451c-8938-2820f15437ab\', \'multiverseId\': 429010}, \'multiverseid\': 429010}, {\'name\': \'罗纳斯的恩惠\', \'text\': \'展示你牌库顶的五张牌。你可以将其中一张生物牌和／或一张结界牌置于你手上。将其余的牌置入你的坟墓场。\', \'type\': \'法术\', \'flavor\': \'诸神有责任帮助众人在来世谋得一席之地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429279&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3ead6b97-38ff-4fe9-82f5-56adcb51f4b7\', \'multiverseId\': 429279}, \'multiverseid\': 429279}, {\'name\': \'羅納斯的恩惠\', \'text\': \'展示你牌庫頂的五張牌。你可以將其中一張生物牌和／或一張結界牌置於你手上。將其餘的牌置入你的墳墓場。\', \'type\': \'巫術\', \'flavor\': \'諸神有責任幫助眾人在來世謀得一席之地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429548&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6071e530-1fcd-4368-8ba0-9e879e227345\', \'multiverseId\': 429548}, \'multiverseid\': 429548}]', '[{\'name\': \'Wundersame Ankunft\', \'text\': \'X Kreaturen deiner Wahl können in diesem Zug nicht geblockt werden. Bis zum Ende des Zuges erhalten jene Kreaturen „Immer wenn diese Kreatur einem Spieler Kampfschaden zufügt, ziehe eine Karte."\', \'type\': \'Hexerei\', \'flavor\': \'Was die Wächter auf einer Welt, die von Nicol Bolas beherrscht wird, am wenigsten erwartet hatten, war Perfektion.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427035&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29781c53-67cf-46b1-a00f-f3f356fcd15c\', \'multiverseId\': 427035}, \'multiverseid\': 427035}, {\'name\': \'Llegada a la majestuosidad\', \'text\': \'X criaturas objetivo no pueden ser bloqueadas este turno. Hasta el final del turno, esas criaturas ganan "Siempre que esta criatura haga daño de combate a un jugador, roba una carta".\', \'type\': \'Conjuro\', \'flavor\': \'Si había algo que los Guardianes no esperaban encontrar en un plano gobernado por Nicol Bolas, era perfección.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427304&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a6aeb1ca-bd27-42c4-8230-d29a198a5d43\', \'multiverseId\': 427304}, \'multiverseid\': 427304}, {\'name\': \'Accès aux merveilles\', \'text\': "X créatures ciblées ne peuvent pas être bloquées ce tour-ci. Jusqu\'à la fin du tour, ces créatures gagnent « À chaque fois que cette créature inflige des blessures de combat à un joueur, piochez une carte. »", \'type\': \'Rituel\', \'flavor\': "S\'il y a une chose que les Sentinelles ne pensaient pas trouver sur un plan dirigé par Nicol Bolas, c\'était bien la perfection.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427573&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db1830e7-2181-427d-9738-d3f434c906b6\', \'multiverseId\': 427573}, \'multiverseid\': 427573}, {\'name\': \'Varco nella Meraviglia\', \'text\': \'X creature bersaglio non possono essere bloccate in questo turno. Fino alla fine del turno, quelle creature hanno "Ogniqualvolta questa creatura infligge danno da combattimento a un giocatore, pesca una carta".\', \'type\': \'Stregoneria\', \'flavor\': "L\'ultima cosa che i Guardiani si aspettavano di trovare su un piano governato da Nicol Bolas era la perfezione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427842&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d87b6c7-80fc-4e73-94f9-736842c24034\', \'multiverseId\': 427842}, \'multiverseid\': 427842}, {\'name\': \'驚異への入り口\', \'text\': \'クリーチャーＸ体を対象とする。このターン、それらはブロックされない。ターン終了時まで、それらのクリーチャーは「このクリーチャーがプレイヤー１人に戦闘ダメージを与えるたび、カードを１枚引く。」を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'ゲートウォッチがニコル・ボーラスに支配された次元で唯一予期していなかったのは完璧ということだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428111&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f17e9c8d-271d-4fd0-bc6c-4ea965c30ad5\', \'multiverseId\': 428111}, \'multiverseid\': 428111}, {\'name\': \'신비로 가는 통로\', \'text\': \'생물 X개를 목표로 정한다. 그 생물들은 이 턴에 방어될 수 없다. 그 생물들은 턴종료까지 "이 생물이 플레이어에게 전투피해를 입힐 때마다, 카드 한 장을 뽑는다."를 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'관문수호대가 니콜 볼라스가 지배하는 차원에서 볼 수 있을 거라 기대하지 않은 한 가지는 바로 완벽함이었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428380&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f66a4af0-44ae-46b3-ab69-a28ec7c694e4\', \'multiverseId\': 428380}, \'multiverseid\': 428380}, {\'name\': \'Passagem para a Maravilha\', \'text\': \'X criaturas alvo não podem ser bloqueadas neste turno. Até o final do turno, aquelas criaturas ganham "Toda vez que esta criatura causar dano de combate a um jogador, compre um card."\', \'type\': \'Feitiço\', \'flavor\': \'A única coisa que as Sentinelas não esperavam encontrar em um plano governado por Nicol Bolas era perfeição.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428649&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c5490466-afb4-4f4d-b69e-39c56c49a0f7\', \'multiverseId\': 428649}, \'multiverseid\': 428649}, {\'name\': \'Дорога к Чудесам\', \'text\': \'X целевых существ не могут быть заблокированы в этом ходу. До конца хода те существа получают способность «Каждый раз, когда это существо наносит боевые повреждения игроку, возьмите карту».\', \'type\': \'Волшебство\', \'flavor\': \'В мире, которым правил Никол Болас, Стражи не ожидали встретить только одного — совершенства.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428918&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84f2264d-b180-4255-b213-84809be38f66\', \'multiverseId\': 428918}, \'multiverseid\': 428918}, {\'name\': \'通往奇境\', \'text\': \'X个目标生物本回合不能被阻挡。这些生物获得「每当此生物对任一牌手造成战斗伤害时，抓一张牌」直到回合结束。\', \'type\': \'法术\', \'flavor\': \'在这个由尼可波拉斯统治的时空中，守护者们未曾料想会出现完美。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429187&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'acaf84c5-3df3-40af-8f46-e46996f859cd\', \'multiverseId\': 429187}, \'multiverseid\': 429187}, {\'name\': \'通往奇境\', \'text\': \'X個目標生物本回合不能被阻擋。這些生物獲得「每當此生物對任一玩家造成戰鬥傷害時，抽一張牌」直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'在這個由尼可波拉斯統治的時空中，守護者們未曾料想會出現完美。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429456&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4df308da-d86c-4fce-9684-22dd1912f406\', \'multiverseId\': 429456}, \'multiverseid\': 429456}]', "[{'name': 'Wüsten-Cerodon', 'text': 'Umwandlung {R} ({R}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Kreatur — Bestie', 'flavor': 'In den endlosen Weiten der Wüste Naktamuns entstehen manchmal Bedrohungen, derer sich die Götter selbst annehmen müssen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427099&type=card', 'language': 'German', 'identifiers': {'scryfallId': '14656617-4b75-4c1b-99ed-af079f41c7f3', 'multiverseId': 427099}, 'multiverseid': 427099}, {'name': 'Cerodonte del desierto', 'text': 'Ciclo {R}. ({R}, descartar esta carta: Roba una carta.)', 'type': 'Criatura — Bestia', 'flavor': 'La extensión sin fin del desierto que rodea Naktamun a veces da paso a amenazas que los mismos dioses deben atender.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427368&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0b8de2c7-678d-46be-8b00-f2b8ce9f18a2', 'multiverseId': 427368}, 'multiverseid': 427368}, {'name': 'Cérodon du désert', 'text': 'Recyclage {R} ({R}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Créature : bête', 'flavor': 'La vaste étendue désertique qui entoure Naktamon produit parfois des menaces auxquelles les dieux eux-mêmes doivent faire face.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427637&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ea337b74-fd59-4533-9b07-1117cf124f16', 'multiverseId': 427637}, 'multiverseid': 427637}, {'name': 'Cornodonte del Deserto', 'text': 'Ciclo {R} ({R}, Scarta questa carta: Pesca una carta.)', 'type': 'Creatura — Bestia', 'flavor': 'La sconfinata distesa desertica che circonda Naktamun a volte nasconde minacce che le divinità stesse devono placare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427906&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c0e82a52-d8ee-4fdb-ba12-bbcade0666d3', 'multiverseId': 427906}, 'multiverseid': 427906}, {'name': '砂漠セロドン', 'text': 'サイクリング{R}（{R}, このカードを捨てる：カードを１枚引く。）', 'type': 'クリーチャー — ビースト', 'flavor': 'ナクタムンの外に延々と広がる砂漠には、時折神々が自ら手を下さなければならない脅威が生まれる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428175&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b4e78c76-97bf-4e09-865b-a1e45fcd5bb9', 'multiverseId': 428175}, 'multiverseid': 428175}, {'name': '사막 세로돈', 'text': '순환 {R} ({R}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '생물 — 야수', 'flavor': '나크타문을 둘러싼 사막의 광대함은 때때로 신들만이 다룰 수 있는 괴수를 만들어 낸다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428444&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '96b83a01-c975-4658-a89b-b75c6d7a6928', 'multiverseId': 428444}, 'multiverseid': 428444}, {'name': 'Dentócero do Deserto', 'text': 'Reciclar {R} ({R}, Descarte este card: Compre um card.)', 'type': 'Criatura — Besta', 'flavor': 'A amplidão desértica interminável que cerca Nactamon às vezes traz ameaças que os próprios deuses precisam enfrentar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428713&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6a894add-e328-4e70-9835-e5c612d68786', 'multiverseId': 428713}, 'multiverseid': 428713}, {'name': 'Пустынный Рогозуб', 'text': 'Цикл {R} ({R}, сбросьте эту карту: возьмите карту.)', 'type': 'Существо — Зверь', 'flavor': 'На бескрайних просторах окружающей Нактамун пустыни иногда рождаются угрозы, на которые должны найти ответ сами боги.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428982&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '63ec8805-e569-407b-b9a8-0c1c3cc10c2a', 'multiverseId': 428982}, 'multiverseid': 428982}, {'name': '沙漠角牙兽', 'text': '循环{R}（{R}，弃掉此牌：抓一张牌。）', 'type': '生物～野兽', 'flavor': '拿塔蒙周围一片广袤无垠的沙漠中，有时也会出现这类需要神明亲自处理的威胁。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429251&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '94ebe0df-fce4-4969-85d4-921e448d6c18', 'multiverseId': 429251}, 'multiverseid': 429251}, {'name': '沙漠角牙獸', 'text': '循環{R}（{R}，棄掉此牌：抽一張牌。）', 'type': '生物～野獸', 'flavor': '拿塔蒙周圍一片廣袤無垠的沙漠中，有時也會出現這類需要神明親自處理的威脅。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429520&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7fc8135a-889e-407b-933c-c7bef23995a9', 'multiverseId': 429520}, 'multiverseid': 429520}]", "[{'name': 'Wüstenskorpion', 'text': 'Todesberührung\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Kreatur — Skorpion', 'flavor': 'Einzig die Götter fürchten sich nicht vor dem Stachel des Skorpions.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427087&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c892ff42-192a-4029-b445-0ab4a42c2f67', 'multiverseId': 427087}, 'multiverseid': 427087}, {'name': 'Escorpión del páramo', 'text': 'Toque mortal.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Criatura — Escorpión', 'flavor': 'Excepto los dioses, todo el mundo teme al aguijón del escorpión.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427356&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e9cbd8f0-db5b-4b11-81ec-e8eff0f35ab5', 'multiverseId': 427356}, 'multiverseid': 427356}, {'name': 'Scorpion des terres dévastées', 'text': 'Contact mortel\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Créature : scorpion', 'flavor': 'Seuls les dieux ne craignent pas la piqûre du scorpion.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427625&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a8f622c0-9156-47aa-89db-e3feb05fbe7c', 'multiverseId': 427625}, 'multiverseid': 427625}, {'name': 'Scorpione delle Lande Desolate', 'text': 'Tocco letale\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Creatura — Scorpione', 'flavor': 'Solo le divinità non temono il morso dello scorpione.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427894&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1463fbb5-106d-4d18-80d6-ca88ba249d5c', 'multiverseId': 427894}, 'multiverseid': 427894}, {'name': '不毛地の蠍', 'text': '接死\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': 'クリーチャー — 蠍', 'flavor': '神々以外は誰もが蠍の針を恐れる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428163&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '102b30ed-d66a-4847-8d91-736506c04cfe', 'multiverseId': 428163}, 'multiverseid': 428163}, {'name': '황무지 전갈', 'text': '치명타\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '생물 — 전갈', 'flavor': '신을 제외한 모두가 전갈의 독침을 두려워한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428432&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '089f7fce-f31e-4553-a27c-a4492566554f', 'multiverseId': 428432}, 'multiverseid': 428432}, {'name': 'Escorpião dos Ermos', 'text': 'Toque mortífero\\nReciclar {2} ({2}, Descarte este card: Compre um card.)', 'type': 'Criatura — Escorpião', 'flavor': 'Todos, exceto os deuses, temem a picada do escorpião.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428701&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7747725e-88d3-4b49-8049-0e4f91d47c29', 'multiverseId': 428701}, 'multiverseid': 428701}, {'name': 'Скорпион Пустошей', 'text': 'Смертельное касание\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Существо — Скорпион', 'flavor': 'Лишь боги не боятся укуса скорпиона.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428970&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c82b59af-44bb-4c1f-8d81-0845f58a0833', 'multiverseId': 428970}, 'multiverseid': 428970}, {'name': '荒土毒蝎', 'text': '死触\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '生物～蝎子', 'flavor': '唯神无惧蝎刺。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429239&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6526aca9-3ed7-41ca-801d-80f332e7cec5', 'multiverseId': 429239}, 'multiverseid': 429239}, {'name': '荒土毒蠍', 'text': '死觸\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '生物～蠍子', 'flavor': '唯神無懼蠍刺。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429508&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3e1de982-d631-4a97-b046-1a4742964a27', 'multiverseId': 429508}, 'multiverseid': 429508}]", '[{\'name\': \'Zehrende Inbrunst\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +3/+3 und hat „Lege zu Beginn deines Versorgungssegments eine -1/-1-Marke auf die verzauberte Kreatur."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Mit dem Kopf voran ist die einzige Art, durch das Tor zum Jenseits zu gehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427097&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'580a5c22-fcd8-4d88-aebf-caf220af55d6\', \'multiverseId\': 427097}, \'multiverseid\': 427097}, {\'name\': \'Fervor marchitante\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +3/+3 y tiene "Al comienzo de tu mantenimiento, pon un contador -1/-1 sobre esta criatura".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'La única manera de atravesar el Portal al más allá es de cabeza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427366&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69504c7b-e0e6-4cb4-a791-b050c3fbf1ee\', \'multiverseId\': 427366}, \'multiverseid\': 427366}, {\'name\': \'Ferveur dévorante\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +3/+3 et a « Au début de votre entretien, mettez un marqueur -1/-1 sur cette créature. »\', \'type\': \'Enchantement : aura\', \'flavor\': "Il n\'y a qu\'une seule façon de traverser le portail vers l\'au-delà : sans réfléchir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427635&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca4c8e05-d51e-48df-97c1-8362adacb89f\', \'multiverseId\': 427635}, \'multiverseid\': 427635}, {\'name\': \'Fervore Divorante\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +3/+3 e ha "All\\\'inizio del tuo mantenimento, metti un segnalino -1/-1 su questa creatura".\', \'type\': \'Incantesimo — Aura\', \'flavor\': "L\'unico modo per attraversare i cancelli dell\'aldilà è a capofitto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427904&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0689c2d0-b784-4d3e-bc34-5ac0aefba8ca\', \'multiverseId\': 427904}, \'multiverseid\': 427904}, {\'name\': \'焼き尽くす熱情\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋３/＋３の修整を受けるとともに「あなたのアップキープの開始時に、このクリーチャーの上に－１/－１カウンターを１個置く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'来世への門を抜ける唯一の方法は突進である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428173&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'65f4d017-466c-4960-aff9-db134d8816a0\', \'multiverseId\': 428173}, \'multiverseid\': 428173}, {\'name\': \'집어삼키는 열정\', \'text\': \'생물에게 부여\\n부여된 생물은 +3/+3을 받고 "당신의 유지단 시작에, 이 생물에 -1/-1 카운터 한 개를 올려놓는다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'무모함이야말로 사후 세계로 가는 관문의 열쇠다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428442&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e9af209a-e7c8-47d5-9b96-2cbef2d813ee\', \'multiverseId\': 428442}, \'multiverseid\': 428442}, {\'name\': \'Fervor Consumidor\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +3/+3 e tem "No início de sua manutenção, coloque um marcador -1/-1 nesta criatura.".\', \'type\': \'Encantamento — Aura\', \'flavor\': \'A única forma de atravessar o portão para a vida após a morte é de frente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428711&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee78abb1-c075-43d4-a1dd-8a0b78c4620b\', \'multiverseId\': 428711}, \'multiverseid\': 428711}, {\'name\': \'Всепоглощающий Накал\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +3/+3 и имеет способность «В начале вашего шага поддержки положите один жетон -1/-1 на это существо».\', \'type\': \'Чары — Аура\', \'flavor\': \'Единственный способ пройти через врата в загробную жизнь — сломя голову.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428980&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'609ef55e-6926-49a6-abce-ea540baabc68\', \'multiverseId\': 428980}, \'multiverseid\': 428980}, {\'name\': \'透体激情\', \'text\': \'结附于生物\\n所结附的生物得+3/+3且具有「在你的维持开始时，在此生物上放置一个-1/-1指示物。」\', \'type\': \'结界～灵气\', \'flavor\': \'若想穿过来世之门，除了义无反顾向前冲之外，别无他法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429249&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7bf6c144-e5f6-45c2-9eb7-0bf9d723956a\', \'multiverseId\': 429249}, \'multiverseid\': 429249}, {\'name\': \'透體激情\', \'text\': \'結附於生物\\n所結附的生物得+3/+3且具有「在你的維持開始時，在此生物上放置一個-1/-1指示物。」\', \'type\': \'結界～靈氣\', \'flavor\': \'若想穿過來世之門，除了義無反顧向前衝之外，別無他法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429518&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cbe616b1-4b48-485d-8a4c-86399daf1bc2\', \'multiverseId\': 429518}, \'multiverseid\': 429518}]', '[{\'name\': \'Zeit der Einkehr\', \'text\': \'Schicke eine Kreatur deiner Wahl, die in diesem Zug einen Zombie geblockt hat oder von einem Zombie geblockt wurde, ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Hin und wieder gibt es solche, die die Großzügigkeit des Gott-Pharaos einfach nicht zu schätzen wissen." —Temmet, Wesir von Naktamun\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427004&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb8dbd30-5474-4e58-90a4-742fdf40f151\', \'multiverseId\': 427004}, \'multiverseid\': 427004}, {\'name\': \'Hora de reflexionar\', \'text\': \'Exilia la criatura objetivo que bloqueó un Zombie o fue bloqueada por un Zombie este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"En ocasiones, hay quienes se niegan a apreciar todo lo que nos concede el Dios Faraón". —Temmet, visir de Naktamun\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427273&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cfe713e6-5978-46e2-a0be-1d9092fc2b1e\', \'multiverseId\': 427273}, \'multiverseid\': 427273}, {\'name\': \'Heure de réflexion\', \'text\': \'Exilez une créature ciblée qui a bloqué ou a été bloquée par un zombie ce tour-ci.\', \'type\': \'Éphémère\', \'flavor\': "« Certains refusent parfois d\'apprécier tout ce que le Dieu-Pharaon nous offre. » —Temmet, vizir de Naktamon", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427542&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3091ad37-25ec-4b45-946d-b4b34c2869e9\', \'multiverseId\': 427542}, \'multiverseid\': 427542}, {\'name\': \'Tempo per Riflettere\', \'text\': \'Esilia una creatura bersaglio che ha bloccato uno Zombie o è stata bloccata da uno Zombie in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Talvolta, alcuni si rifiutano di apprezzare tutto ciò che il Dio Faraone ci offre." —Temmet, visir di Naktamun\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427811&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df0f96b5-d0ac-45a2-ba3e-223642847930\', \'multiverseId\': 427811}, \'multiverseid\': 427811}, {\'name\': \'黙考の時間\', \'text\': \'このターンにゾンビをブロックしたかゾンビにブロックされたクリーチャー１体を対象とし、それを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「時折、王神からの授かりものすべてへの感謝を拒む者がいる。」 ――ナクタムンの侍臣、テムメト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428080&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f199f184-f656-4bcd-b41f-71695a9bd31c\', \'multiverseId\': 428080}, \'multiverseid\': 428080}, {\'name\': \'회개할 시간\', \'text\': \'이 턴에 좀비에게 방어되거나 좀비를 방어한 생물을 목표로 정한다. 그 생물을 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"때때로 신 파라오가 우리에게 베푸는 은혜에 대해 감사해 하지 않는 자들이 있다." —나크타문의 고관 테멧\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428349&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6164d37c-9fcd-4c1f-a9d8-74886846088d\', \'multiverseId\': 428349}, \'multiverseid\': 428349}, {\'name\': \'Tempo para Refletir\', \'text\': \'Exile a criatura alvo que bloqueou ou foi bloqueada por um Zumbi neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"De vez em quando, há os que se recusam a apreciar tudo que o Faraó-Deus nos provê." — Temmet, vizir de Nactamon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428618&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3285ab05-af90-4326-9c53-787048522e1d\', \'multiverseId\': 428618}, \'multiverseid\': 428618}, {\'name\': \'Время Поразмыслить\', \'text\': \'Изгоните целевое существо, которое в этом ходу блокировало или было заблокировано Зомби.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Порой встречаются те, кто отказывается ценить щедрые дары Бога-Фараона». — Теммет, визирь Нактамуна\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428887&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'933234cf-4f95-4820-8977-39412071b67a\', \'multiverseId\': 428887}, \'multiverseid\': 428887}, {\'name\': \'反思时刻\', \'text\': \'放逐目标本回合中曾阻挡灵俑或被灵俑阻挡的生物。\', \'type\': \'瞬间\', \'flavor\': \'「总有些人不愿接受法老神给予我们的种种馈赠。」 ～拿塔蒙维齐尔蒂穆特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429156&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'072ecaf1-f515-41f4-b4aa-492faecf4d54\', \'multiverseId\': 429156}, \'multiverseid\': 429156}, {\'name\': \'反思時刻\', \'text\': \'放逐目標本回合中曾阻擋殭屍或被殭屍阻擋的生物。\', \'type\': \'瞬間\', \'flavor\': \'「總有些人不願接受法老神給予我們的種種饋贈。」 ～拿塔蒙維齊爾蒂穆特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429425&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'307e7205-d82c-41e7-977d-b49d81e635aa\', \'multiverseId\': 429425}, \'multiverseid\': 429425}]', '[{\'name\': \'Zeit der Ernte\', \'text\': \'Durchsuche deine Bibliothek nach bis zu X Standardland-Karten und bringe diese getappt ins Spiel, wobei X gleich der Anzahl an getappten Kreaturen ist, die du kontrollierst. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Der Kreislauf des Lebens: Der Tod der einen fördert das Leben der anderen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427141&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ef5ecaa-7fc8-436d-8f44-28ddd200261a\', \'multiverseId\': 427141}, \'multiverseid\': 427141}, {\'name\': \'Temporada de cosecha\', \'text\': \'Busca en tu biblioteca hasta X cartas de tierra básica, donde X es la cantidad de criaturas giradas que controlas, y pon esas cartas en el campo de batalla giradas. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Un auténtico reflejo de la naturaleza: la muerte cuidando de la vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427410&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f8cec35c-bcc8-46d9-a71b-3ffff86689d3\', \'multiverseId\': 427410}, \'multiverseid\': 427410}, {\'name\': \'Saison des récoltes\', \'text\': "Cherchez dans votre bibliothèque jusqu\'à X cartes de terrain de base, X étant le nombre de créatures engagées que vous contrôlez, et mettez-les sur le champ de bataille engagées. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': \'Un miroir de la nature : la mort nourrissant la vie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95fa4992-e0a7-4492-8cc8-39c5f6cd84c8\', \'multiverseId\': 427679}, \'multiverseid\': 427679}, {\'name\': \'Stagione del Raccolto\', \'text\': \'Passa in rassegna il tuo grimorio per trovare fino a X carte terra base, dove X è il numero di creature TAPpate che controlli, e metti quelle carte sul campo di battaglia TAPpate. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'Un paradosso della natura: la morte che alimenta la vita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427948&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a6c87e4c-d976-4b9b-adb4-4b5435498287\', \'multiverseId\': 427948}, \'multiverseid\': 427948}, {\'name\': \'収穫期\', \'text\': \'あなたのライブラリーから基本土地・カード最大Ｘ枚を探し、それらのカードをタップ状態で戦場に出す。Ｘはあなたがコントロールするタップ状態のクリーチャーの総数に等しい。その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'自然の摂理。死が生を育む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428217&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bff0f311-e344-49da-bb2f-20748e0ee07d\', \'multiverseId\': 428217}, \'multiverseid\': 428217}, {\'name\': \'수확철\', \'text\': \'당신의 서고에서 최대 X장의 기본 대지 카드를 찾아 탭된 채로 전장에 놓는다. X는 당신이 조종하는 탭된 생물의 개수다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'자연의 진정한 섭리는 죽음이 생명을 키운다는 점이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428486&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1c20a12d-bf61-47c5-be76-174831fe0ec9\', \'multiverseId\': 428486}, \'multiverseid\': 428486}, {\'name\': \'Estação da Colheita\', \'text\': \'Procure em seu grimório até X cards de terreno básico, sendo X o número de criaturas viradas que você controla, e coloque aqueles cards no campo de batalha virados. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Um verdadeiro reflexo da natureza: a morte alimentando a vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428755&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'43595d0c-c444-4442-af2e-e6efa94f7429\', \'multiverseId\': 428755}, \'multiverseid\': 428755}, {\'name\': \'Сезон Жатвы\', \'text\': \'Найдите в вашей библиотеке до X карт базовых земель, где X — количество повернутых существ под вашим контролем, и положите те карты на поле битвы повернутыми. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Истинный образ природы: смерть, вскармливающая жизнь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429024&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2eb6e73e-f233-43e9-9b3c-caec8313cbae\', \'multiverseId\': 429024}, \'multiverseid\': 429024}, {\'name\': \'丰收季节\', \'text\': \'从你的牌库中搜寻至多X张基本地牌，X为由你操控且已横置的生物数量，并将这些牌横置放进战场。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'这正是自然的真实写照：死亡培育生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429293&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83c361ee-3fc6-4e12-b895-6fc52f12a598\', \'multiverseId\': 429293}, \'multiverseid\': 429293}, {\'name\': \'豐收季節\', \'text\': \'從你的牌庫中搜尋至多X張基本地牌，X為由你操控且已橫置的生物數量，並將這些牌橫置放進戰場。然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'這正是自然的真實寫照：死亡培育生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429562&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c97982f-35ac-4ccf-827b-3b45340cd5e5\', \'multiverseId\': 429562}, \'multiverseid\': 429562}]', '[{\'name\': \'Zenitsucher\', \'text\': \'Fliegend\\nImmer wenn du eine Karte umwandelst oder abwirfst, erhält eine Kreatur deiner Wahl Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Vogel, Zauberer\', \'flavor\': \'Nur aus der Luft begreift man wirklich, welche Schrecken in der Ödnis lauern und was für ein Segen das Hekma ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427048&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'74f3639b-dcb8-4ac3-ab79-74cb6602164d\', \'multiverseId\': 427048}, \'multiverseid\': 427048}, {\'name\': \'Buscador del cénit\', \'text\': \'Vuela.\\nSiempre que actives una habilidad de ciclo o descartes una carta, la criatura objetivo gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Hechicero ave\', \'flavor\': \'Solo desde los cielos se comprende realmente el horror de los yermos y la maravilla de la protección de la Hekma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427317&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8fccf83d-23a5-4123-98e7-858eb0919ab8\', \'multiverseId\': 427317}, \'multiverseid\': 427317}, {\'name\': \'Chercheur de zénith\', \'text\': "Vol\\nÀ chaque fois que vous recyclez ou vous défaussez d\'une carte, la créature ciblée acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : oiseau et sorcier\', \'flavor\': "Il n\'y a que depuis les cieux que l\'on peut concevoir l\'horreur des landes et le miracle de l\'Hekma.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427586&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f94995d5-9caf-4a74-aa9a-76e47e26aba0\', \'multiverseId\': 427586}, \'multiverseid\': 427586}, {\'name\': \'Cercatore dello Zenit\', \'text\': \'Volare\\nOgniqualvolta cicli o scarti una carta, una creatura bersaglio ha volare fino alla fine del turno.\', \'type\': \'Creatura — Mago Uccello\', \'flavor\': "Solo dal cielo si scorgono davvero gli orrori delle lande desolate e la miracolosa protezione dell\'Hekma.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427855&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f3af31e3-dd9f-4641-86e6-6530e4d257f0\', \'multiverseId\': 427855}, \'multiverseid\': 427855}, {\'name\': \'天頂の探求者\', \'text\': \'飛行\\nあなたがカードを１枚サイクリングするか捨てるたび、クリーチャー１体を対象とする。ターン終了時まで、それは飛行を得る。\', \'type\': \'クリーチャー — 鳥・ウィザード\', \'flavor\': \'不毛地の恐ろしさとヘクマの防御のありがたさをはっきりと理解できるのは、空から見たときのみだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428124&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5561b7ce-0e3d-4055-bac6-8099343818a6\', \'multiverseId\': 428124}, \'multiverseid\': 428124}, {\'name\': \'천공 추적자\', \'text\': \'비행\\n당신이 카드를 순환하거나 버릴 때마다, 생물을 목표로 정한다. 그 생물은 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 조류 마법사\', \'flavor\': \'하늘에서 봐야만 불모지의 괴수들과 헤크마가 제공하는 보호의 경이로움을 이해할 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428393&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'91b9d547-79e5-4351-9dd6-105edd4cb9b5\', \'multiverseId\': 428393}, \'multiverseid\': 428393}, {\'name\': \'Buscador do Zênite\', \'text\': \'Voar\\nToda vez que você recicla ou descarta um card, a criatura alvo ganha voar até o final do turno.\', \'type\': \'Criatura — Ave Mago\', \'flavor\': \'Somente dos céus é possível compreender plenamente os horrores dos ermos e a maravilha da proteção da Hekma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428662&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'28b6abb7-e8c5-414e-9025-74d0eef68f60\', \'multiverseId\': 428662}, \'multiverseid\': 428662}, {\'name\': \'Искатель Зенита\', \'text\': \'Полет\\nКаждый раз, когда вы совершаете Цикл или сбрасываете карту, целевое существо получает Полет до конца хода.\', \'type\': \'Существо — Птица Чародей\', \'flavor\': \'Лишь глядя с неба можно в полной мере осознать, что за кошмары бушуют в пустошах, и сколь чудесна защита Хекмы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428931&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8b394f44-79b6-4dc0-81dd-8c911be004d5\', \'multiverseId\': 428931}, \'multiverseid\': 428931}, {\'name\': \'凌日探求者\', \'text\': \'飞行\\n每当你循环或弃一张牌时，目标生物获得飞行异能直到回合结束。\', \'type\': \'生物～鸟／法术师\', \'flavor\': \'只有在空中才能彻底明白荒土的恐怖以及避世帘的神奇保护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429200&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0fb078c-f358-46bf-b4af-a0f2cfd59720\', \'multiverseId\': 429200}, \'multiverseid\': 429200}, {\'name\': \'凌日探求者\', \'text\': \'飛行\\n每當你循環或棄一張牌時，目標生物獲得飛行異能直到回合結束。\', \'type\': \'生物～鳥／魔法師\', \'flavor\': \'只有在空中才能徹底明白荒土的恐怖以及避世簾的神奇保護。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429469&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5d6b2ef8-3fa6-4e74-b9d3-aa8cfe47644e\', \'multiverseId\': 429469}, \'multiverseid\': 429469}]', '[{\'name\': \'Zensieren\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {1}.\\nUmwandlung {U} ({U}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Warum all die Fragen?" —Temmet, Wesir von Naktamun\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427017&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'838fe1f2-63a3-4b20-b4a8-8552ee904a8a\', \'multiverseId\': 427017}, \'multiverseid\': 427017}, {\'name\': \'Censurar\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {1}.\\nCiclo {U}. ({U}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Por qué tantas preguntas?" —Temmet, visir de Naktamun\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427286&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b0f4085a-fff2-44f4-a305-eb2b60af5517\', \'multiverseId\': 427286}, \'multiverseid\': 427286}, {\'name\': \'Réprobation\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paie {1}.\\nRecyclage {U} ({U}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Éphémère\', \'flavor\': \'« Pourquoi tant de questions ? » —Temmet, vizir de Naktamon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427555&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53f1ea0a-4dab-4471-b0b4-f5946bbe1009\', \'multiverseId\': 427555}, \'multiverseid\': 427555}, {\'name\': \'Censurare\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {1}.\\nCiclo {U} ({U}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Perché tutte queste domande?" —Temmet, visir di Naktamun\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427824&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'602add09-4f8f-4362-8ccb-b8808e553975\', \'multiverseId\': 427824}, \'multiverseid\': 427824}, {\'name\': \'検閲\', \'text\': \'呪文１つを対象とする。それのコントローラーが{1}を支払わないかぎり、それを打ち消す。\\nサイクリング{U}（{U}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'「質問が多いのはなぜだ？」 ――ナクタムンの侍臣、テムメト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428093&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34fe2b66-b32d-40b7-8e29-4ac781597d4e\', \'multiverseId\': 428093}, \'multiverseid\': 428093}, {\'name\': \'검열\', \'text\': \'주문을 목표로 정한다. 그 주문의 조종자가 {1}를 지불하지 않으면 그 주문을 무효화한다.\\n순환 {U} ({U}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'"왜 이렇게 질문이 많지?" —나크타문의 고관 테멧\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428362&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cc745ad0-5a75-4245-8b0d-82591fb2a30d\', \'multiverseId\': 428362}, \'multiverseid\': 428362}, {\'name\': \'Censurar\', \'text\': \'Anule a mágica alvo, a menos que seu controlador pague {1}.\\nReciclar {U} ({U}, Descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Por que tantas perguntas?" — Temmet, vizir de Nactamon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428631&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5daa7af8-71d4-45ab-a6a4-74e434feba98\', \'multiverseId\': 428631}, \'multiverseid\': 428631}, {\'name\': \'Цензура\', \'text\': \'Отмените целевое заклинание, если только контролирующий его игрок не заплатит {1}.\\nЦикл {U} ({U}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«К чему столько вопросов?» — Теммет, визирь Нактамуна\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428900&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b1f72da2-8864-4f40-a601-f8fc2357eed7\', \'multiverseId\': 428900}, \'multiverseid\': 428900}, {\'name\': \'禁言\', \'text\': \'除非目标咒语的操控者支付{1}，否则反击之。\\n循环{U}（{U}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'「怎么问题这么多？」 ～拿塔蒙维齐尔蒂穆特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429169&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'930983f5-40be-41fa-aaa7-24f5da80f8a2\', \'multiverseId\': 429169}, \'multiverseid\': 429169}, {\'name\': \'禁言\', \'text\': \'除非目標咒語的操控者支付{1}，否則反擊之。\\n循環{U}（{U}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'「怎麼問題這麼多？」 ～拿塔蒙維齊爾蒂穆特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429438&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d3f1a589-9a4a-4f28-9b27-275fe984fad0\', \'multiverseId\': 429438}, \'multiverseid\': 429438}]', '[{\'name\': \'Zerlumpte Mumie\', \'text\': \'Wenn die Zerlumpte Mumie stirbt, verliert jeder Gegner 2 Lebenspunkte.\', \'type\': \'Kreatur — Zombie, Schakal\', \'flavor\': \'Die Toten, die außerhalb der Mauern der Stadt umherwandern, haben nur noch den Wunsch, ihren Fluch weiterzugeben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429724&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc56667f-6eb7-4459-90ce-a8a90ca5a564\', \'multiverseId\': 429724}, \'multiverseid\': 429724}, {\'name\': \'Momia andrajosa\', \'text\': \'Cuando la Momia andrajosa muera, cada oponente pierde 2 vidas.\', \'type\': \'Criatura — Chacal zombie\', \'flavor\': \'Los muertos que se alejan de la seguridad de la ciudad solo buscan esparcir su maldición.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429850&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0ee3a321-b4c9-4742-95a1-59f02f4bd527\', \'multiverseId\': 429850}, \'multiverseid\': 429850}, {\'name\': \'Momie en lambeaux\', \'text\': \'Quand la Momie en lambeaux meurt, chaque adversaire perd 2 points de vie.\', \'type\': \'Créature : zombie et chacal\', \'flavor\': "Les morts qui s\'aventurent par-delà les murs protecteurs de la ville ne cherchent qu\'à répandre leur malédiction.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429742&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25f18322-be58-4ee7-9e53-15093d6b6607\', \'multiverseId\': 429742}, \'multiverseid\': 429742}, {\'name\': \'Mummia Lacera\', \'text\': \'Quando la Mummia Lacera muore, ogni avversario perde 2 punti vita.\', \'type\': \'Creatura — Sciacallo Zombie\', \'flavor\': \'I morti che abbandonano la sicurezza della città bramano solo diffondere la propria maledizione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429760&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ed56b77-63c6-4010-a45e-8cb55f01d405\', \'multiverseId\': 429760}, \'multiverseid\': 429760}, {\'name\': \'ぼろぼろのミイラ\', \'text\': \'ぼろぼろのミイラが死亡したとき、各対戦相手はそれぞれ２点のライフを失う。\', \'type\': \'クリーチャー — ゾンビ・ジャッカル\', \'flavor\': \'安全な街の外をうろつく死者たちは、自身の呪いを広めることのみを渇望する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429778&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab4a1059-fe83-4ea9-92b0-712d447db7d5\', \'multiverseId\': 429778}, \'multiverseid\': 429778}, {\'name\': \'넝마 미라\', \'text\': \'넝마 미라가 죽을 때, 각 상대는 생명 2점을 잃는다.\', \'type\': \'생물 — 좀비 자칼\', \'flavor\': \'안전한 도시를 벗어나 배회하는 망자에게는 오직 저주를 퍼뜨리려는 욕망만이 남아 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429796&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0bcb248-503b-492a-9535-6e5e069e4a4e\', \'multiverseId\': 429796}, \'multiverseid\': 429796}, {\'name\': \'Múmia Esfarrapada\', \'text\': \'Quando Múmia Esfarrapada morre, cada oponente perde 2 pontos de vida.\', \'type\': \'Criatura — Zumbi Chacal\', \'flavor\': \'Os mortos que vagam além da segurança da cidade desejam apenas propagar sua maldição.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429814&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a6b103e3-d9ea-4601-bc10-398cbb7dc946\', \'multiverseId\': 429814}, \'multiverseid\': 429814}, {\'name\': \'Растрепанная Мумия\', \'text\': \'Когда Растрепанная Мумия умирает, каждый оппонент теряет 2 жизни.\', \'type\': \'Существо — Зомби Шакал\', \'flavor\': \'Мертвецы, бродящие за безопасными пределами города, жаждут лишь заразить других своим проклятьем.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429832&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'13fb2e64-c400-4284-a9ce-0a127fbb7cb5\', \'multiverseId\': 429832}, \'multiverseid\': 429832}, {\'name\': \'褴褛木乃伊\', \'text\': \'当褴褛木乃伊死去时，每位对手各失去2点生命。\', \'type\': \'生物～灵俑 ／豺狼\', \'flavor\': \'他们死后漂浪在城市护帘之外，唯愿能有更多的人遭受这般诅咒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429688&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f931c78a-c8cb-4733-9e47-b148193196a5\', \'multiverseId\': 429688}, \'multiverseid\': 429688}, {\'name\': \'襤褸木乃伊\', \'text\': \'當襤褸木乃伊死去時，每位對手各失去2點生命。\', \'type\': \'生物～殭屍 ／豺狼\', \'flavor\': \'他們死後漂浪在城市護簾之外，唯願能有更多的人遭受這般詛咒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429706&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef9816c3-3696-48cb-8b84-5c1d46d7fd62\', \'multiverseId\': 429706}, \'multiverseid\': 429706}]', '[{\'name\': \'Zunder-Öde\', \'text\': \'Die Zunder-Öde kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {B} oder {R}.\', \'type\': \'Land\', \'flavor\': \'Ein Schlammstrom verschlang das Tiefland schon vor Jahren. Alles, was zurückblieb, ist ein bodenloser Sumpf und ein nicht enden wollender Ascheregen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429726&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d6a6bff-ba6c-44f9-b945-64512cd68b36\', \'multiverseId\': 429726}, \'multiverseid\': 429726}, {\'name\': \'Yermos de ceniza\', \'text\': \'Los Yermos de ceniza entran al campo de batalla girados.\\n{T}: Agrega {B} o {R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Una avalancha de lodo cubrió el valle hace años. Lo único que queda es una ciénaga sin fondo y lluvias continuas de ceniza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429852&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6af1f646-b042-4cbe-9886-b87c465370d1\', \'multiverseId\': 429852}, \'multiverseid\': 429852}, {\'name\': \'Landes de cendres\', \'text\': \'Les Landes de cendres arrivent sur le champ de bataille engagées.\\n{T} : Ajoutez {B} ou {R} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Il y des années, une coulée de boue a recouvert les basses terres. Il n\'y reste qu\'une fondrière insondable et une éternelle pluie de cendres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429744&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e4cfbbd7-51ab-4e68-bae0-ff1f9c248b67\', \'multiverseId\': 429744}, \'multiverseid\': 429744}, {\'name\': \'Distese di Cenere\', \'text\': \'Le Distese di Cenere entrano nel campo di battaglia TAPpate.\\n{T}: Aggiungi {B} o {R} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Una colata di fango inghiottì i bassopiani anni fa. Tutto ciò che resta sono un pantano senza fondo e una pioggia di cenere senza fine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429762&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1be85ef-620b-442f-81c8-7ab5fc598e93\', \'multiverseId\': 429762}, \'multiverseid\': 429762}, {\'name\': \'燃え殻の痩せ地\', \'text\': \'燃え殻の痩せ地はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{B}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'何年も前に低地は泥流に呑み込まれ、残っているのは底なしの沼沢に降り続ける灰の雨のみだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429780&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40427ddb-b095-4d16-9d79-c6e4b8f5dc14\', \'multiverseId\': 429780}, \'multiverseid\': 429780}, {\'name\': \'잿더미 황무지\', \'text\': \'잿더미 황무지는 탭된 채로 전장에 들어온다.\\n{T}: {B} 또는 {R}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'수년 전 잿더미 급류가 저지대를 집어 삼켰다. 남은 것이라고는 깊이를 알 수 없는 늪과 끝없이 내리는 화산비뿐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429798&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d3d4084-7e2e-434f-9b3a-08593e76c1cb\', \'multiverseId\': 429798}, \'multiverseid\': 429798}, {\'name\': \'Desolação de Cinzas\', \'text\': \'Desolação de Cinzas entra no campo de batalha virada.\\n{T}: Adicione {B} ou {R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Um gigantesco deslizamento de terra engoliu as terras baixas anos atrás. Tudo que sobrou foi um lodaçal sem fundo e uma chuva infindável de cinzas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429816&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90d219a4-6bfa-4204-8cf5-ee882d9e6a72\', \'multiverseId\': 429816}, \'multiverseid\': 429816}, {\'name\': \'Пепельные Пустоши\', \'text\': \'Пепельные Пустоши выходят на поле битвы повернутыми.\\n{T}: добавьте {B} или {R} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Много лет назад селевой поток накрыл низину. Теперь здесь лишь бездонная топь и нескончаемый пепельный дождь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429834&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4c051b2d-61aa-4057-bd8d-3ef3d5725a64\', \'multiverseId\': 429834}, \'multiverseid\': 429834}, {\'name\': \'煤烬瘠地\', \'text\': \'煤烬瘠地须横置进战场。\\n{T}：加{B}或{R}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'多年前的一股泥石流吞没了低洼地带。如今此处只余无底泥沼及不尽灰雨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429690&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ca256a1-e3bc-4309-9f1f-0e1c143faf0c\', \'multiverseId\': 429690}, \'multiverseid\': 429690}, {\'name\': \'煤燼瘠地\', \'text\': \'煤燼瘠地須橫置進戰場。\\n{T}：加{B}或{R}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'多年前的一股泥石流吞沒了低窪地帶。如今此處只餘無底泥沼及不盡灰雨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429708&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1b344d19-e18f-4422-a693-60ade64f41f6\', \'multiverseId\': 429708}, \'multiverseid\': 429708}]', '[{\'name\': \'Zwangspause\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur kann nicht angreifen oder blocken.\\nDie verzauberte Kreatur hat „{2}, opfere diese Kreatur: Du erhältst 2 Lebenspunkte dazu."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'So manch einer wünschte sich im Nachhinein, lieber im Kampf gestorben zu sein, statt als Verlierer überlebt zu haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426980&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6b51acc6-f5be-4da1-88c3-6c2fac9791b4\', \'multiverseId\': 426980}, \'multiverseid\': 426980}, {\'name\': \'Descanso obligatorio\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede atacar ni bloquear.\\nLa criatura encantada tiene "{2}, sacrificar esta criatura: Ganas 2 vidas."\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El dolor de la muerte no es nada comparado con el del fracaso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427249&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ba03c81-9e5b-4065-aab2-a94d5a40bae0\', \'multiverseId\': 427249}, \'multiverseid\': 427249}, {\'name\': \'Repos forcé\', \'text\': \'Enchanter : créature\\nLa créature enchantée ne peut ni attaquer ni bloquer.\\nLa créature enchantée a « {2}, sacrifiez cette créature : vous gagnez 2 points de vie. »\', \'type\': \'Enchantement : aura\', \'flavor\': "La souffrance dans la mort n\'est rien comparée à la souffrance dans l\'échec.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427518&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6751a4f8-19da-4f28-972e-a3a68fc14d57\', \'multiverseId\': 427518}, \'multiverseid\': 427518}, {\'name\': \'Riposo Obbligato\', \'text\': \'Incanta creatura\\nLa creatura incantata non può attaccare o bloccare.\\nLa creatura incantata ha "{2}, Sacrifica questa creatura: Guadagni 2 punti vita".\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Il dolore della morte non è nulla paragonato all\'afflizione del fallimento.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427787&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c07e82c2-ca02-42e9-9dae-694561796e55\', \'multiverseId\': 427787}, \'multiverseid\': 427787}, {\'name\': \'強制的永眠\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーでは攻撃したりブロックしたりできない。\\nエンチャントされているクリーチャーは「{2}, このクリーチャーを生け贄に捧げる：あなたは２点のライフを得る。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'死の痛みは失敗の痛みに比肩し得るものではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428056&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca8f7e73-06c1-48be-8dae-8bacc96cb9fc\', \'multiverseId\': 428056}, \'multiverseid\': 428056}, {\'name\': \'강제 휴식\', \'text\': \'생물에게 부여\\n부여된 생물은 공격하거나 방어할 수 없다.\\n부여된 생물은 "{2}, 이 생물을 희생한다: 당신은 생명 2점을 얻는다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'죽음의 고통은 실패의 고통에 비하면 아무 것도 아니다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428325&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ea6457bb-0036-4ba8-a5ce-d07b990df766\', \'multiverseId\': 428325}, \'multiverseid\': 428325}, {\'name\': \'Descanso Compulsório\', \'text\': \'Encantar criatura\\nA criatura encantada não pode atacar nem bloquear.\\nA criatura encantada tem "{2}, Sacrifique esta criatura: Você ganha 2 pontos de vida."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'A dor da morte não é nada comparada à do fracasso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428594&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'272e808d-115a-4121-9dd9-e9462bd1fd1e\', \'multiverseId\': 428594}, \'multiverseid\': 428594}, {\'name\': \'Принудительный Отдых\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может атаковать или блокировать.\\nЗачарованное существо имеет способность «{2}, пожертвуйте это существо: вы получаете 2 жизни».\', \'type\': \'Чары — Аура\', \'flavor\': \'Боль смерти — ничто по сравнению с болью поражения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428863&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b70d25c-904a-4bcc-9e01-02927ad22002\', \'multiverseId\': 428863}, \'multiverseid\': 428863}, {\'name\': \'强制安息\', \'text\': \'结附于生物\\n所结附的生物不能进行攻击或阻挡。\\n所结附的生物具有「{2}，牺牲此生物：你获得2点生命。」\', \'type\': \'结界～灵气\', \'flavor\': \'死亡之痛远不及失败之苦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429132&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e16da72-4f40-4270-8ba7-9f54383b2bd6\', \'multiverseId\': 429132}, \'multiverseid\': 429132}, {\'name\': \'強制安息\', \'text\': \'結附於生物\\n所結附的生物不能進行攻擊或阻擋。\\n所結附的生物具有「{2}，犧牲此生物：你獲得2點生命。」\', \'type\': \'結界～靈氣\', \'flavor\': \'死亡之痛遠不及失敗之苦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429401&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'21663029-8cf2-454b-9dea-0eacf1a03f3f\', \'multiverseId\': 429401}, \'multiverseid\': 429401}]', '[{\'name\': \'Ätzender Schuss\', \'text\': \'Lege drei -1/-1-Marken auf eine fliegende Kreatur deiner Wahl.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Geweihten gewöhnen sich mit immer höheren Dosen an die Gifte, die sie verwenden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427160&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ced514e5-bfb0-4d9f-bbfb-779d8b538ef1\', \'multiverseId\': 427160}, \'multiverseid\': 427160}, {\'name\': \'Disparo aguijoneador\', \'text\': \'Pon tres contadores -1/-1 sobre la criatura objetivo con la habilidad de volar.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'Los iniciados deben entrenar para resistir las toxinas naturales que usan como armas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94d11607-b992-4d6a-a0a4-26c32ff3299c\', \'multiverseId\': 427429}, \'multiverseid\': 427429}, {\'name\': \'Tir cinglant\', \'text\': \'Mettez trois marqueurs -1/-1 sur une créature avec le vol ciblée.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Éphémère\', \'flavor\': "Les adeptes doivent apprendre à résister aux toxines naturelles qu\'ils utilisent comme armes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427698&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e4f991d9-29e3-4013-8cff-69c2c8b28b0b\', \'multiverseId\': 427698}, \'multiverseid\': 427698}, {\'name\': \'Tiro Pungente\', \'text\': \'Metti tre segnalini -1/-1 su una creatura bersaglio con volare.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'Gli iniziati devono addestrarsi per sviluppare una resistenza alle tossine naturali che utilizzano come armi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427967&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'08da2add-7d34-4e35-b1e6-85d402d92f23\', \'multiverseId\': 427967}, \'multiverseid\': 427967}, {\'name\': \'苦しめる一射\', \'text\': \'飛行を持つクリーチャー１体を対象とし、それの上に－１/－１カウンターを３個置く。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'修練者は武器に使う自然の毒への免疫力を鍛えておく必要がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428236&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'23a05304-ef81-48f0-a022-f4be877fd5b2\', \'multiverseId\': 428236}, \'multiverseid\': 428236}, {\'name\': \'날카로운 일발\', \'text\': \'비행을 가진 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 세 개를 올려놓는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'순간마법\', \'flavor\': \'입회자들은 자신이 사용하는 자연 독성에 대한 저항력을 키워야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428505&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f1737fd-fe79-4e07-82df-4df6aca4ad65\', \'multiverseId\': 428505}, \'multiverseid\': 428505}, {\'name\': \'Tiro Pungente\', \'text\': \'Coloque três marcadores -1/-1 na criatura alvo com voar.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os iniciados precisam treinar para resistir às toxinas naturais que usam como arma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'82350218-918d-467a-84e6-d7c5b67f0c08\', \'multiverseId\': 428774}, \'multiverseid\': 428774}, {\'name\': \'Жалящий Выстрел\', \'text\': \'Положите три жетона -1/-1 на целевое существо с Полетом.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Послушники должны тренироваться, привыкая к естественным ядам, применяющимся в качестве оружия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429043&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8999adf7-b6cf-445f-91dc-119ca0e101c6\', \'multiverseId\': 429043}, \'multiverseid\': 429043}, {\'name\': \'螫刺箭\', \'text\': \'在目标具飞行异能的生物上放置三个-1/-1指示物。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'祀徒常把天然毒素用作克敌武器，因此必须接受抗毒训练。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429312&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bdeca5c5-13c1-4fed-be33-ed22cbe08e01\', \'multiverseId\': 429312}, \'multiverseid\': 429312}, {\'name\': \'螫刺箭\', \'text\': \'在目標具飛行異能的生物上放置三個-1/-1指示物。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'瞬間\', \'flavor\': \'祀徒常把天然毒素用作克敵武器，因此必須接受抗毒訓練。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429581&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'66f9f86a-3fe9-40d7-be63-4050f5a48ccc\', \'multiverseId\': 429581}, \'multiverseid\': 429581}]', '[{\'name\': \'Übernatürliche Ausdauer\', \'text\': \'Bis zum Ende des Zuges erhält eine Kreatur deiner Wahl +2/+0 und „Wenn diese Kreatur stirbt, bringe sie unter der Kontrolle ihres Besitzers getappt ins Spiel zurück."\', \'type\': \'Spontanzauber\', \'flavor\': \'„Nicht alle sind gleich — weder im Leben noch nach dem Tode. Bontus Auserwählte werden immer höher stehen als der Rest." —Senifet, Wesir von Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427082&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bcffddbc-b5c5-4bdb-bf42-761c2f13ec80\', \'multiverseId\': 427082}, \'multiverseid\': 427082}, {\'name\': \'Resistencia sobrenatural\', \'text\': \'Hasta el final del turno, la criatura objetivo obtiene +2/+0 y gana "Cuando esta criatura muera, regrésala al campo de batalla girada bajo el control de su propietario".\', \'type\': \'Instantáneo\', \'flavor\': \'"No somos todos iguales, ni en la vida ni en la muerte. Los favoritos de Bontu estarán en lo más alto durante toda la eternidad". —Senifet, visir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427351&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24d38a17-4d9f-4338-8872-17fed3d2f975\', \'multiverseId\': 427351}, \'multiverseid\': 427351}, {\'name\': \'Vigueur surnaturelle\', \'text\': "Jusqu\'à la fin du tour, la créature ciblée gagne +2/+0 et acquiert « Quand cette créature meurt, renvoyez-la sur le champ de bataille, engagée, sous le contrôle de son propriétaire. »", \'type\': \'Éphémère\', \'flavor\': "« Dans la vie comme dans la mort, les adeptes ne sont pas égaux. Les favoris de Bontu prévaudront même dans l\'éternité. » —Senifet, vizir de Bontu", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427620&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdbc7198-3d93-4801-9078-fc562162ce3b\', \'multiverseId\': 427620}, \'multiverseid\': 427620}, {\'name\': \'Vigore Soprannaturale\', \'text\': \'Fino alla fine del turno, una creatura bersaglio prende +2/+0 e ha "Quando questa creatura muore, rimettila sul campo di battaglia TAPpata sotto il controllo del suo proprietario".\', \'type\': \'Istantaneo\', \'flavor\': \'"Non tutti sono uguali, né in vita, né dopo la morte. I prediletti di Bontu avranno un posto d\\\'onore per l\\\'eternità." —Senifet, visir di Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427889&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5a4bd51f-d22e-447d-9e6f-900c453dd949\', \'multiverseId\': 427889}, \'multiverseid\': 427889}, {\'name\': \'超常的耐久力\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋０の修整を受けるとともに「このクリーチャーが死亡したとき、これをオーナーのコントロール下でタップ状態で戦場に戻す。」を得る。\', \'type\': \'インスタント\', \'flavor\': \'「生前も死後も、みなが平等ではない。永遠の最高位はバントゥ様の指名した者が得るのだ。」 ――バントゥの侍臣、セニフェト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428158&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'58fe6a54-cf6c-4f03-bd5e-e1ed7416b8c4\', \'multiverseId\': 428158}, \'multiverseid\': 428158}, {\'name\': \'초자연적 체력\', \'text\': \'생물을 목표로 정한다. 턴종료까지, 그 생물은 +2/+0을 받고 "이 생물이 죽을 때, 이 생물을 소유자의 조종하에 탭된 채로 전장으로 되돌린다."를 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"살아있을 때도 죽은 후에도 평등한 건 하나도 없다. 본투의 총애를 받는 자는 높은 자리에서 영생을 누린다." —본투의 고관 세니페트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428427&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2cc222ab-2633-4b75-a367-7b1c5b558416\', \'multiverseId\': 428427}, \'multiverseid\': 428427}, {\'name\': \'Resistência Sobrenatural\', \'text\': \'Até o final do turno, a criatura alvo recebe +2/+0 e ganha "Quando esta criatura morrer, devolva-a ao campo de batalha virada sob o controle de seu dono.".\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Não somos iguais —nem na vida, nem na morte. Os favoritos de Bontu estarão acima de todos na eternidade." — Senifet, vizir de Bontu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428696&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c372cef6-bc73-478f-9373-95fd3ce9e806\', \'multiverseId\': 428696}, \'multiverseid\': 428696}, {\'name\': \'Сверхъестественная Стойкость\', \'text\': \'До конца хода целевое существо получает +2/+0 и способность «Когда это существо умирает, верните его на поле битвы повернутым под контролем его владельца».\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Никто не равен — ни в жизни, ни после смерти. В вечности избранные Бонту займут свое место на вершине». — Сенифет, визирь Бонту\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428965&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0eb437f5-63f7-41f0-8dcd-a789b826a0c1\', \'multiverseId\': 428965}, \'multiverseid\': 428965}, {\'name\': \'非凡耐力\', \'text\': \'直到回合结束，目标生物得+2/+0且获得「当此生物死去时，将它在其拥有者的操控下横置移回战场。」\', \'type\': \'瞬间\', \'flavor\': \'「众生非平等～无论是生前还是死后。受芭图眷宠者会永远屹立巅峰。」 ～芭图维齐尔瑟尼法\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429234&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4df1fb5b-11f1-4e01-9ca5-12580ae57e73\', \'multiverseId\': 429234}, \'multiverseid\': 429234}, {\'name\': \'非凡耐力\', \'text\': \'直到回合結束，目標生物得+2/+0且獲得「當此生物死去時，將它在其擁有者的操控下橫置移回戰場。」\', \'type\': \'瞬間\', \'flavor\': \'「眾生非平等～無論是生前還是死後。受芭圖眷寵者會永遠屹立頂峰。」 ～芭圖維齊爾瑟尼法\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429503&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'929836ee-3585-423b-a58e-2f8b715937cd\', \'multiverseId\': 429503}, \'multiverseid\': 429503}]', '[{\'name\': \'Überschwemmter Knochenacker\', \'text\': \'Der Überschwemmte Knochenacker kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {B}.\', \'type\': \'Land\', \'flavor\': \'Die Ätherströmungen im Himmel spiegeln die Strömungen wider, die im Wasser darunter schon so manch einem das Leben gekostet haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429730&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1b4c1750-fbfd-4331-ae92-5a85f5edeeda\', \'multiverseId\': 429730}, \'multiverseid\': 429730}, {\'name\': \'Osario sumergido\', \'text\': \'El Osario sumergido entra al campo de batalla girado.\\n{T}: Agrega {U} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Las corrientes de éter que surcan los cielos reflejan las de agua, incluidos los letales rápidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429856&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f03c6617-ce4c-4259-9499-675e0ac4f0be\', \'multiverseId\': 429856}, \'multiverseid\': 429856}, {\'name\': \'Ossuaire submergé\', \'text\': "L\'Ossuaire submergé arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {U} ou {B} à votre réserve.", \'type\': \'Terrain\', \'flavor\': "Les courants d\'Éther dans le ciel reflètent les courants aquatiques, et même les rapides périlleux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429748&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8dfb634b-94ec-4834-97ae-0fb2432d5485\', \'multiverseId\': 429748}, \'multiverseid\': 429748}, {\'name\': \'Ossario Sommerso\', \'text\': "L\'Ossario Sommerso entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U} o {B} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': "Le correnti di etere nel cielo sono uno specchio dei flussi d\'acqua sottostanti, incluse le rapide letali.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429766&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9395a33-0fd9-4bf1-8e86-c40b64cc0725\', \'multiverseId\': 429766}, \'multiverseid\': 429766}, {\'name\': \'水没した骨塚\', \'text\': \'水没した骨塚はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'空中の霊気の流れは、その下の水流と対をなしている。その流れには命取りとなる奔流も含まれる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429784&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'402fc150-c4e6-4f2e-988d-906834c44f69\', \'multiverseId\': 429784}, \'multiverseid\': 429784}, {\'name\': \'물에 잠긴 납골지\', \'text\': \'물에 잠긴 납골지는 탭된 채로 전장에 들어온다.\\n{T}: {U} 또는 {B}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'하늘의 에테르 기류는 급류를 포함한 바다의 해류를 반영한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429802&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3e93e516-a0ad-43b8-a7c6-9b50fad68210\', \'multiverseId\': 429802}, \'multiverseid\': 429802}, {\'name\': \'Ossário Submerso\', \'text\': \'Ossário Submerso entra no campo de batalha virado.\\n{T}: Adicione {U} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'As correntes do éter nos céus espelham as das águas abaixo, incluindo as corredeiras mortais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429820&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4077012-cb47-4ebf-bbc8-0148a359d3f2\', \'multiverseId\': 429820}, \'multiverseid\': 429820}, {\'name\': \'Затопленное Кладбище\', \'text\': \'Затопленное Кладбище выходит на поле битвы повернутым.\\n{T}: добавьте {U} или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Потоки эфира в небе повторяют движение потоков воды внизу — даже их смертоносные течения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429838&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'33ab87d1-3ec5-4035-bf8a-0947a5de932b\', \'multiverseId\': 429838}, \'multiverseid\': 429838}, {\'name\': \'水下聚骨场\', \'text\': \'水下聚骨场须横置进战场。\\n{T}：加{U}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'苍穹的乙太流与海底洋流相仿，自然也少不了致命湍流。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429694&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1addeb71-7bdd-4ea9-afda-bf5ed24e3732\', \'multiverseId\': 429694}, \'multiverseid\': 429694}, {\'name\': \'水下聚骨場\', \'text\': \'水下聚骨場須橫置進戰場。\\n{T}：加{U}或{B}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'蒼穹的乙太流與海底洋流相仿，自然也少不了致命湍流。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429712&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'edabb2d5-ab5a-498e-a7ac-ec7c6f4eddc9\', \'multiverseId\': 429712}, \'multiverseid\': 429712}]', '[{\'name\': \'Überzeugendes Argument\', \'text\': \'Ein Spieler deiner Wahl legt die obersten fünf Karten seiner Bibliothek auf seinen Friedhof.\\nUmwandlung {U} ({U}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'„Wie kann man im Angesicht all dieser Segen noch Zweifel haben?" —Ukhat, Wesirin der Weihe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427018&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79d1e9f8-e1de-49fc-9ee0-f27de6a97cbd\', \'multiverseId\': 427018}, \'multiverseid\': 427018}, {\'name\': \'Argumento convincente\', \'text\': \'El jugador objetivo pone las cinco primeras cartas de su biblioteca en su cementerio.\\nCiclo {U}. ({U}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'"¿Cómo se puede dudar ante la presencia de tales bendiciones?" —Ukhat, visir de la iniciación\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427287&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3f006d68-2487-47a7-a483-9e893a60364f\', \'multiverseId\': 427287}, \'multiverseid\': 427287}, {\'name\': \'Argument irrésistible\', \'text\': \'Le joueur ciblé met les cinq cartes du dessus de sa bibliothèque dans son cimetière.\\nRecyclage {U} ({U}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Rituel\', \'flavor\': "« Comment peut-on avoir le moindre doute devant de telles bénédictions ? » —Ukhat, vizir de l\'initiation", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427556&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4acb011c-9d38-42d9-a25a-2f3b1d1ea851\', \'multiverseId\': 427556}, \'multiverseid\': 427556}, {\'name\': \'Argomentazione Convincente\', \'text\': \'Un giocatore bersaglio mette nel suo cimitero le prime cinque carte del suo grimorio.\\nCiclo {U} ({U}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Com\\\'è possibile dubitare dinanzi a tali benedizioni?" —Ukhat, visir dell\\\'iniziazione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427825&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ac4ad42-b9f0-411c-87d1-8fd21c9153af\', \'multiverseId\': 427825}, \'multiverseid\': 427825}, {\'name\': \'抗えない主張\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上からカードを５枚自分の墓地に置く。\\nサイクリング{U}（{U}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'「誉れの存在に疑念の余地などないわ。」 ――修練の侍臣、ウカト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428094&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47e7abb0-dde5-412f-95dc-e5a9b7e9c0e0\', \'multiverseId\': 428094}, \'multiverseid\': 428094}, {\'name\': \'그럴듯한 주장\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 다섯 장을 자신의 무덤에 넣는다.\\n순환 {U} ({U}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'"이러한 은총 앞에 어찌 의심을 품을 수 있겠는가?" —입회의 고관 우카트\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428363&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'775061e3-285a-4968-87ed-435845d867ba\', \'multiverseId\': 428363}, \'multiverseid\': 428363}, {\'name\': \'Argumento Convincente\', \'text\': \'O jogador alvo coloca os cinco cards do topo do grimório dele no próprio cemitério.\\nReciclar {U} ({U}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'"Como pode haver dúvida na presença de tais bençãos?" — Ukhat, vizir da iniciação\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428632&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff858274-f936-4c66-a8bc-9a5f501e3f6a\', \'multiverseId\': 428632}, \'multiverseid\': 428632}, {\'name\': \'Неотразимый Довод\', \'text\': \'Целевой игрок кладет пять верхних карт своей библиотеки на свое кладбище.\\nЦикл {U} ({U}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'«Как можно сомневаться, глядя на эти дары собственными глазами?» — Укхат, визирь посвящения\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428901&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24866317-a372-4404-bd7d-a5590231832b\', \'multiverseId\': 428901}, \'multiverseid\': 428901}, {\'name\': \'强言论断\', \'text\': \'目标牌手将其牌库顶的五张牌置入其坟墓场。\\n循环{U}（{U}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'「在此等福祉面前，缘何会有疑虑？」 ～启程维齐尔乌凯特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429170&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'591c69c4-90b9-4e11-ac6f-4df820320faf\', \'multiverseId\': 429170}, \'multiverseid\': 429170}, {\'name\': \'強言論斷\', \'text\': \'目標玩家將其牌庫頂的五張牌置入其墳墓場。\\n循環{U}（{U}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'「在此等福祉面前，緣何會有疑慮？」 ～啟程維齊爾烏凱特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429439&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f730120a-635c-4cc5-9098-5907ff9dcd78\', \'multiverseId\': 429439}, \'multiverseid\': 429439}]', '[{\'name\': \'Übungsmumie\', \'text\': \'Wenn die Übungsmumie ins Spiel kommt, enttappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Um ihren Platz im Jenseits zu verdienen, trainieren die Tempeldiener jeden Tag mit jenen, denen diese Ehre nicht zuteilwurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427000&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d07f69f1-86de-47f6-88ac-d67c9522cc48\', \'multiverseId\': 427000}, \'multiverseid\': 427000}, {\'name\': \'Momia de entrenamiento\', \'text\': \'Cuando la Momia de entrenamiento entre al campo de batalla, endereza la criatura objetivo.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'En su aspiración para hacerse un hueco en el más allá, los acólitos entrenan a diario contra aquellos que no alcanzaron tal gloria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427269&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0640fc2b-b487-49bb-81f0-8265930b87c9\', \'multiverseId\': 427269}, \'multiverseid\': 427269}, {\'name\': "Momie d\'entraînement", \'text\': "Quand la Momie d\'entraînement arrive sur le champ de bataille, dégagez la créature ciblée.", \'type\': \'Créature : zombie\', \'flavor\': "Aspirant à une place dans l\'au-delà, les acolytes s\'entraînent chaque jour contre ceux qui ont été indignes de cette gloire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427538&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4eb7c24c-1bdb-4021-9eaa-58ee67cd30c1\', \'multiverseId\': 427538}, \'multiverseid\': 427538}, {\'name\': \'Mummia da Addestramento\', \'text\': \'Quando la Mummia da Addestramento entra nel campo di battaglia, STAPpa una creatura bersaglio.\', \'type\': \'Creatura — Zombie\', \'flavor\': "Gli accoliti, che ambiscono a conquistarsi un posto nell\'aldilà, si addestrano tutti i giorni affrontando coloro ai quali tale privilegio è stato negato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427807&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'92caa920-7043-4d0b-a1ed-3fbfca0a528a\', \'multiverseId\': 427807}, \'multiverseid\': 427807}, {\'name\': \'演習ミイラ\', \'text\': \'演習ミイラが戦場に出たとき、クリーチャー１体を対象とし、それをアンタップする。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'来世での居場所を求める見習いたちは日々、栄達を逃した者相手の訓練にいそしむ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428076&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cae0ce6b-c237-4463-a8a1-692b87ad87f5\', \'multiverseId\': 428076}, \'multiverseid\': 428076}, {\'name\': \'연습 상대 미라\', \'text\': \'연습 상대 미라가 전장에 들어올 때, 생물을 목표로 정한다. 그 생물을 언탭한다.\', \'type\': \'생물 — 좀비\', \'flavor\': \'사후 세계에 갔을 때 영광의 자리를 차지하고 싶어하는 견습 사제들은 그러지 못한 이들을 상대로 매일 수련한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428345&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f06d92c7-88d8-46cd-bf6a-e56718bc3ef1\', \'multiverseId\': 428345}, \'multiverseid\': 428345}, {\'name\': \'Múmia de Treino\', \'text\': \'Quando Múmia de Treino entrar no campo de batalha, desvire a criatura alvo.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Aspirando à conquista de seu lugar na vida após a morte, os acólitos treinam todos os dias contra aqueles que não alcançaram essa glória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428614&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31725264-05bf-4b34-8f0c-1d0cc97563ac\', \'multiverseId\': 428614}, \'multiverseid\': 428614}, {\'name\': \'Тренировочная Мумия\', \'text\': \'Когда Тренировочная Мумия выходит на поле битвы, разверните целевое существо.\', \'type\': \'Существо — Зомби\', \'flavor\': \'Стремясь завоевать свое место в загробной жизни, непосвященные упражняются каждый день, сражаясь с теми, кому не удалось заслужить это право.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428883&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7fdec1c-7c87-4091-8984-7414a9e2ee40\', \'multiverseId\': 428883}, \'multiverseid\': 428883}, {\'name\': \'陪练木乃伊\', \'text\': \'当陪练木乃伊进战场时，重置目标生物。\', \'type\': \'生物～灵俑\', \'flavor\': \'侍僧热切希望能在来世拥有一席之地，因此每天与那些未能享受此荣耀者对练。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429152&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6595a82-a1ef-48b0-b8dd-b308da5349d1\', \'multiverseId\': 429152}, \'multiverseid\': 429152}, {\'name\': \'陪練木乃伊\', \'text\': \'當陪練木乃伊進戰場時，重置目標生物。\', \'type\': \'生物～殭屍\', \'flavor\': \'侍僧熱切希望能在來世擁有一席之地，因此每天與那些未能享受此榮耀者對練。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429421&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0f5c6305-503c-472b-b9c0-89eed23daee2\', \'multiverseId\': 429421}, \'multiverseid\': 429421}]']
