': {'scryfallId': '4e07546a-0d65-41a6-95f1-f2952205aa16', 'multiverseId': 429657}, 'multiverseid': 429657}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427237&type=card', 'language': 'German', 'identifiers': {'scryfallId': '646fa7fe-4679-41f7-bd1d-2f1631b50f1d', 'multiverseId': 427237}, 'multiverseid': 427237}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427506&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '410e9ade-8f7e-4299-ad2d-f9cbe3f69d04', 'multiverseId': 427506}, 'multiverseid': 427506}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427775&type=card', 'language': 'French', 'identifiers': {'scryfallId': '04380c0e-48a1-46ce-acfc-d3957f79384f', 'multiverseId': 427775}, 'multiverseid': 427775}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428044&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f6ffec54-55da-478c-9540-8b735cfaefef', 'multiverseId': 428044}, 'multiverseid': 428044}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428313&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1c4659cf-e747-43da-b1ff-03949d91b9d1', 'multiverseId': 428313}, 'multiverseid': 428313}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428582&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '421172dc-43ab-4f9b-abc8-a405f3ddf24a', 'multiverseId': 428582}, 'multiverseid': 428582}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428851&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '006e6ab3-7ff2-4288-b988-9fe6b8f131b7', 'multiverseId': 428851}, 'multiverseid': 428851}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429120&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7d6e935f-57be-43d4-9a49-0b60a6f858c5', 'multiverseId': 429120}, 'multiverseid': 429120}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429389&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ccdb38b1-2dea-4bed-b341-1f1a9bf20486', 'multiverseId': 429389}, 'multiverseid': 429389}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429658&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '68b0f354-5ad7-431a-9de9-c91dec39e895', 'multiverseId': 429658}, 'multiverseid': 429658}]", '[{\'name\': \'Geflügelter Hirte\', \'text\': \'Fliegend, Wachsamkeit\\nUmwandlung {W} ({W}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„Wenn die Stunde der Verheißung kommt, wird der Gott-Pharao das Hekma niederreißen und uns die Länder dahinter zum Geschenk machen." —Das Buch der Stunden\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427010&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f385565-2ac9-4656-9f0a-7b738b9b7d68\', \'multiverseId\': 427010}, \'multiverseid\': 427010}, {\'name\': \'Pastor alado\', \'text\': \'Vuela, vigilancia.\\nCiclo {W}. ({W}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Ángel\', \'flavor\': \'"Cuando llegue la Hora de la Promesa, el Dios Faraón desgarrará la Hekma, pues su protección ya no será necesaria". —Las Revelaciones de las Horas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427279&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6fc8aa47-1875-4748-b394-cb1e14018df8\', \'multiverseId\': 427279}, \'multiverseid\': 427279}, {\'name\': \'Berger ailé\', \'text\': \'Vol, vigilance\\nRecyclage {W} ({W}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : ange\', \'flavor\': "« À l\'aube de l\'Âge de la Promesse, le Dieu-Pharaon détruira l\'Hekma, car sa protection ne sera plus nécessaire. » —Le corpus des âges", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427548&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c0a6775-4851-46b5-8843-1b784a2a05d5\', \'multiverseId\': 427548}, \'multiverseid\': 427548}, {\'name\': \'Pastore Alato\', \'text\': \'Volare, cautela\\nCiclo {W} ({W}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Creatura — Angelo\', \'flavor\': \'"Al sopraggiungere dell\\\'Era della promessa, il Dio Faraone abbatterà l\\\'Hekma, poiché la sua protezione non si renderà più necessaria." —Il Conto delle Ere\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427817&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb6191e5-7f04-4133-8235-e8740ac25ada\', \'multiverseId\': 427817}, \'multiverseid\': 427817}, {\'name\': \'有翼の番人\', \'text\': \'飛行、警戒\\nサイクリング{W}（{W}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'「約束の刻が来たとき、王神はヘクマを取り壊すだろう。防御はもはや無用になるからである。」 ――刻の書\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428086&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'933e4e2c-45b3-478c-8c30-e45a8dfbaa22\', \'multiverseId\': 428086}, \'multiverseid\': 428086}, {\'name\': \'날개 달린 목동\', \'text\': \'비행, 경계\\n순환 {W} ({W}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 천사\', \'flavor\': \'"약속의 시간이 되면 신 파라오가 헤크마를 무너뜨릴 것이다. 더 이상 헤크마의 보호가 필요하지 않을 테니까." —시간의 서\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428355&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5c2b1566-b767-40fc-ade1-49cf24c2aedf\', \'multiverseId\': 428355}, \'multiverseid\': 428355}, {\'name\': \'Pastor Alado\', \'text\': \'Voar, vigilância\\nReciclar {W} ({W}, Descarte este card: Compre um card.)\', \'type\': \'Criatura — Anjo\', \'flavor\': \'"Quando a Hora da Promessa chegar, o Faraó-Deus derrubará a Hekma, pois a proteção dela não será mais necessária." — O Registro das Horas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428624&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41f7e61e-e019-4df0-a058-a39f8da79505\', \'multiverseId\': 428624}, \'multiverseid\': 428624}, {\'name\': \'Крылатый Пастух\', \'text\': \'Полет, Бдительность\\nЦикл {W} ({W}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Ангел\', \'flavor\': \'«Когда придет Час Завета, Бог-Фараон разрушит Хекму, ибо нам больше не нужна будет ее защита». — «Исчисление Часов»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428893&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bfea19fb-d693-4b89-8b3d-1e30687d8e81\', \'multiverseId\': 428893}, \'multiverseid\': 428893}, {\'name\': \'舞翼牧者\', \'text\': \'飞行，警戒\\n循环{W}（{W}，弃掉此牌：抓一张牌。）\', \'type\': \'生物～天使\', \'flavor\': \'「当允诺时刻来临时，法老神将撤下避世帘，因为我们不再需要它的保护。」 ～《时刻全志》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429162&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9234a924-06a6-47da-bcf1-67351c190f2e\', \'multiverseId\': 429162}, \'multiverseid\': 429162}, {\'name\': \'舞翼牧者\', \'text\': \'飛行，警戒\\n循環{W}（{W}，棄掉此牌：抽一張牌。）\', \'type\': \'生物～天使\', \'flavor\': \'「當允諾時刻來臨時，法老神將撤下避世簾，因為我們不再需要它的保護。」 ～《時刻全志》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429431&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cd5ceea4-571c-4a93-a5f0-6c3faaceb7ff\', \'multiverseId\': 429431}, \'multiverseid\': 429431}]', '[{\'name\': \'Gefährte der Geweihten\', \'text\': \'Immer wenn der Gefährte der Geweihten einem Spieler Kampfschaden zufügt, entappe eine Kreatur oder ein Land deiner Wahl.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'„Ich würde gerne sagen, dass er uns gehört, aber ich fürchte, es ist eher andersherum." —Ixor, Geweihte der Rhet-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427145&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39769c16-a7f6-4ac4-967c-9d5851a7ac9f\', \'multiverseId\': 427145}, \'multiverseid\': 427145}, {\'name\': \'Compañero del iniciado\', \'text\': \'Siempre que el Compañero del iniciado haga daño de combate a un jugador, endereza la criatura o tierra objetivo.\', \'type\': \'Criatura — Felino\', \'flavor\': \'"Me gustaría decir que es nuestra mascota, pero lo contrario quizás se encuentre más cerca de la verdad". —Ixor, iniciada de la simiente Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427414&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a013e57-b24c-4041-9ea9-79f2c8106404\', \'multiverseId\': 427414}, \'multiverseid\': 427414}, {\'name\': "Compagnon d\'adepte", \'text\': "À chaque fois que le Compagnon d\'adepte inflige des blessures de combat à un joueur, dégagez une créature ciblée ou un terrain ciblé.", \'type\': \'Créature : chat\', \'flavor\': "« J\'aimerais pouvoir dire que c\'est notre animal de compagnie, mais l\'inverse est plus proche de la réalité. » —Ixor, adepte de la moisson Rhet", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1e3440cf-9e61-446a-a0cf-646994be6734\', \'multiverseId\': 427683}, \'multiverseid\': 427683}, {\'name\': "Compagno dell\'Iniziato", \'text\': "Ogniqualvolta il Compagno dell\'Iniziato infligge danno da combattimento a un giocatore, STAPpa una creatura o una terra bersaglio.", \'type\': \'Creatura — Felino\', \'flavor\': \'"Vorrei poter dire che è il nostro animale domestico, ma è più plausibile il contrario." —Ixor, iniziata della messe Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427952&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2736d10f-d1ec-44c8-b548-9f2e5b09a2e1\', \'multiverseId\': 427952}, \'multiverseid\': 427952}, {\'name\': \'修練者の相棒\', \'text\': \'修練者の相棒がプレイヤー１人に戦闘ダメージを与えるたび、クリーチャー１体か土地１つを対象とし、それをアンタップする。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'「この子のことは私たちのペットだと思ってるわ。でも実際は逆なのかも。」 ――レト一門の修練者、イクソル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428221&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca342725-d887-4c8e-8d38-7e28f6b0e5d4\', \'multiverseId\': 428221}, \'multiverseid\': 428221}, {\'name\': \'입회자의 친구\', \'text\': \'입회자의 친구가 플레이어에게 전투피해를 입힐 때마다, 생물 또는 대지를 목표로 정한다. 그 목표를 언탭한다.\', \'type\': \'생물 — 고양이\', \'flavor\': \'"우리가 기르는 애완동물이라고 말하고 싶지만, 거꾸로일 수도 있다." —레트 입문자의 입회자 익소르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428490&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3a08c705-89d4-4049-8cbb-df9bcc3095b0\', \'multiverseId\': 428490}, \'multiverseid\': 428490}, {\'name\': \'Companheiro do Iniciado\', \'text\': \'Toda vez que Companheiro do Iniciado causar dano de combate a um jogador, desvire a criatura ou o terreno alvo.\', \'type\': \'Criatura — Felino\', \'flavor\': \'"Gostaria de dizer que ele é nosso bichinho de estimação, mas o contrário pode estar mais perto da verdade." — Ixor, iniciada da safra Rhet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428759&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e49b3ad-014c-438a-8ce6-f99f2d34e6b3\', \'multiverseId\': 428759}, \'multiverseid\': 428759}, {\'name\': \'Спутник Послушника\', \'text\': \'Каждый раз, когда Спутник Послушника наносит боевые повреждения игроку, разверните целевое существо или землю.\', \'type\': \'Существо — Кошка\', \'flavor\': \'«Я хотела бы сказать, что это наш питомец, но, пожалуй, обратное утверждение ближе к правде». — Иксор, послушница снопа Рет\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429028&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f50ccd5a-aca1-45fc-a667-aac4f18b9dd1\', \'multiverseId\': 429028}, \'multiverseid\': 429028}, {\'name\': \'祀徒旅伴\', \'text\': \'每当祀徒旅伴对任一牌手造成战斗伤害时，重置目标生物或地。\', \'type\': \'生物～猫\', \'flavor\': \'「我也想说这是我们的宠物，但可能倒过来说会比较符合实际。」 ～雷特祀群祀徒依瑟\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429297&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6ab71cf9-d5a5-454d-85bf-8c7912ddf12d\', \'multiverseId\': 429297}, \'multiverseid\': 429297}, {\'name\': \'祀徒旅伴\', \'text\': \'每當祀徒旅伴對任一玩家造成戰鬥傷害時，重置目標生物或地。\', \'type\': \'生物～貓\', \'flavor\': \'「我也想說這是我們的寵物，但可能倒過來說會比較符合實際。」 ～雷特祀群祀徒依瑟\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429566&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c2557c7c-b481-461f-a6a7-452ef73fb4d7\', \'multiverseId\': 429566}, \'multiverseid\': 429566}]', '[{\'name\': \'Gefährtin des Geprüften\', \'text\': \'Fliegend\\n{1}{W}: Enttappe eine Kreatur deiner Wahl. Aktiviere diese Fähigkeit nur, falls du einen Gideon-Planeswalker kontrollierst.\', \'type\': \'Kreatur — Vogel, Soldat\', \'flavor\': \'„Die stärksten Bande werden im Kampf geschmiedet." —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429717&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33af6cee-0435-4841-ac55-cbea8d5bd0c7\', \'multiverseId\': 429717}, \'multiverseid\': 429717}, {\'name\': \'Compañera de las pruebas\', \'text\': \'Vuela.\\n{1}{W}: Endereza la criatura objetivo. Activa esta habilidad solo si controlas un planeswalker Gideon.\', \'type\': \'Criatura — Soldado ave\', \'flavor\': \'"La lealtad más ferviente se forja en la batalla". —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429843&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cbbed975-c712-41b9-a854-a00160f158db\', \'multiverseId\': 429843}, \'multiverseid\': 429843}, {\'name\': \'Compagnon des Épreuves\', \'text\': "Vol\\n{1}{W} : Dégagez la créature ciblée. N\'activez cette capacité que si vous contrôlez un planeswalker Gideon.", \'type\': \'Créature : oiseau et soldat\', \'flavor\': \'« Les loyautés les plus indéfectibles se forgent au combat. » —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429735&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7af7b6b-c009-44ce-8b58-81c7a8418948\', \'multiverseId\': 429735}, \'multiverseid\': 429735}, {\'name\': \'Compagna delle Ordalie\', \'text\': \'Volare\\n{1}{W}: STAPpa una creatura bersaglio. Attiva questa abilità solo se controlli un planeswalker Gideon.\', \'type\': \'Creatura — Soldato Uccello\', \'flavor\': \'"La lealtà più agguerrita si forgia in battaglia." —Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429753&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00345333-ea8a-4166-9a67-e0a9f4e6be3a\', \'multiverseId\': 429753}, \'multiverseid\': 429753}, {\'name\': \'試練の相棒\', \'text\': \'飛行\\n{1}{W}：クリーチャー１体を対象とし、それをアンタップする。この能力は、あなたがギデオン・プレインズウォーカーをコントロールしているときにのみ起動できる。\', \'type\': \'クリーチャー — 鳥・兵士\', \'flavor\': \'「最上の忠誠心は戦いの中で生まれる。」 ――ギデオン・ジュラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429771&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc0dfc8a-664b-4349-9d58-fdb7646f0cd1\', \'multiverseId\': 429771}, \'multiverseid\': 429771}, {\'name\': \'시험의 동료\', \'text\': \'비행\\n{1}{W}: 생물을 목표로 정한다. 그 생물을 언탭한다. 이 능력은 당신이 기디온 플레인즈워커를 조종할 때에만 활성화할 수 있다.\', \'type\': \'생물 — 조류 병사\', \'flavor\': \'"가장 강렬한 충성심은 전투를 통해 생겨난다." —기디온 주라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429789&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f1caf0ad-7712-4e78-8bdf-4fb0599d2648\', \'multiverseId\': 429789}, \'multiverseid\': 429789}, {\'name\': \'Companheira das Provas\', \'text\': \'Voar\\n{1}{W}: Desvire a criatura alvo. Ative esta habilidade somente se você controlar um planeswalker Gideon.\', \'type\': \'Criatura — Ave Soldado\', \'flavor\': \'"As lealdades mais ferrenhas são conquistadas em batalha." — Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429807&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11a4e21c-2a02-4fb2-947e-102c46c31bc8\', \'multiverseId\': 429807}, \'multiverseid\': 429807}, {\'name\': \'Спутница в Испытаниях\', \'text\': \'Полет\\n{1}{W}: разверните целевое существо. Активируйте эту способность, только если вы контролируете planeswalker-а Гидеона.\', \'type\': \'Существо — Птица Солдат\', \'flavor\': \'«Самая крепкая верность рождается в битве». — Гидеон Джура\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429825&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4265213-ae72-4e88-bb9d-9f3dad9b0fb2\', \'multiverseId\': 429825}, \'multiverseid\': 429825}, {\'name\': \'祀炼旅伴\', \'text\': \'飞行\\n {1}{W}：重置目标生物。只能于你操控基定鹏洛客时起动此异能。\', \'type\': \'生物～鸟／士兵\', \'flavor\': \'「苦战见忠诚。」 ～基定尤拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429681&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66368e12-6a6d-47dd-9975-2e06e7cb76c7\', \'multiverseId\': 429681}, \'multiverseid\': 429681}, {\'name\': \'祀煉旅伴\', \'text\': \'飛行\\n{1}{W}：重置目標生物。只能於你操控基定鵬洛客時起動此異能。\', \'type\': \'生物～鳥／士兵\', \'flavor\': \'「苦戰見忠誠。」 ～基定尤拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429699&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'272b3616-3a44-47c6-acd5-4c45f8f113e9\', \'multiverseId\': 429699}, \'multiverseid\': 429699}]', '[{\'name\': \'Geschenk des Paradieses\', \'text\': \'Verzaubert ein Land\\nWenn das Geschenk des Paradieses ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\\nDas verzauberte Land hat „{T}: Erhöhe deinen Manavorrat um zwei Mana genau einer beliebigen Farbe."\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427138&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c16ea62b-c8be-4d7f-9000-0fb298218bb7\', \'multiverseId\': 427138}, \'multiverseid\': 427138}, {\'name\': \'Obsequio del paraíso\', \'text\': \'Encantar tierra.\\nCuando el Obsequio del paraíso entre al campo de batalla, ganas 3 vidas.\\nLa tierra encantada tiene "{T}: Agrega dos manás de un color cualquiera a tu reserva de maná".\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427407&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0feb0e0a-0098-4f59-a806-94bbce5a6f34\', \'multiverseId\': 427407}, \'multiverseid\': 427407}, {\'name\': \'Don de paradis\', \'text\': "Enchanter : terrain\\nQuand le Don de paradis arrive sur le champ de bataille, vous gagnez 3 points de vie.\\nLe terrain enchanté a « {T} : Ajoutez deux manas d\'une seule couleur de votre choix à votre réserve. »", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427676&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5a46ce2f-0d72-44ed-9308-dd57a5736188\', \'multiverseId\': 427676}, \'multiverseid\': 427676}, {\'name\': \'Dono del Paradiso\', \'text\': \'Incanta terra\\nQuando il Dono del Paradiso entra nel campo di battaglia, guadagni 3 punti vita.\\nLa terra incantata ha "{T}: Aggiungi due mana di un qualsiasi colore alla tua riserva di mana".\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427945&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f788abce-4751-4866-8548-51f882998ff3\', \'multiverseId\': 427945}, \'multiverseid\': 427945}, {\'name\': \'楽園の贈り物\', \'text\': \'エンチャント（土地）\\n楽園の贈り物が戦場に出たとき、あなたは３点のライフを得る。\\nエンチャントされている土地は「{T}：あなたのマナ・プールに、好きな色１色のマナ２点を加える。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428214&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22c70709-84a1-4eae-bfd2-250db943d940\', \'multiverseId\': 428214}, \'multiverseid\': 428214}, {\'name\': \'낙원의 선물\', \'text\': \'대지에 부여\\n낙원의 선물이 전장에 들어올 때, 당신은 생명 3점을 얻는다.\\n부여된 대지는 "{T}: 원하는 색의 마나 두 개를 당신의 마나풀에 담는다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428483&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3ef4fd04-f1f0-4a20-89ce-d812cd840eed\', \'multiverseId\': 428483}, \'multiverseid\': 428483}, {\'name\': \'Dádiva do Paraíso\', \'text\': \'Encantar terreno\\nQuando Dádiva do Paraíso entra no campo de batalha, você ganha 3 pontos de vida.\\nO terreno encantando tem "{T}: Adicione dois manas de qualquer cor à sua reserva de mana."\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428752&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fbb75ffe-bbce-4a60-8e30-5770bfafd711\', \'multiverseId\': 428752}, \'multiverseid\': 428752}, {\'name\': \'Дарованный Рай\', \'text\': \'Зачаровать землю\\nКогда Дарованный Рай выходит на поле битвы, вы получаете 3 жизни.\\nЗачарованная земля имеет способность «{T}: добавьте две маны любого одного цвета в ваше хранилище маны».\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429021&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'05e08b3f-07db-418d-b8b0-f9e8574c01da\', \'multiverseId\': 429021}, \'multiverseid\': 429021}, {\'name\': \'天堂赋礼\', \'text\': \'结附于地\\n当天堂赋礼进战场时，你获得3点生命。\\n所结附的地具有「{T}：加两点任意颜色的单色法术力到你的法术力池中。」\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429290&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'27808e33-df4a-4720-92f5-71362f53899f\', \'multiverseId\': 429290}, \'multiverseid\': 429290}, {\'name\': \'天堂賦禮\', \'text\': \'結附於地\\n當天堂賦禮進戰場時，你獲得3點生命。\\n所結附的地具有「{T}：加兩點任意顏色的單色魔法力到你的魔法力池中。」\', \'type\': \'結界～靈氣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429559&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'36c8896c-0c40-441b-9590-5991d1f638b6\', \'multiverseId\': 429559}, \'multiverseid\': 429559}]', '[{\'name\': \'Geschuppter Behemoth\', \'text\': \'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\', \'type\': \'Kreatur — Krokodil\', \'flavor\': \'Eine Begegnung mit ihm zu überleben, ist Beweis genug, dass ein Geweihter für die Prüfung der Stärke bereit ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427155&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be1833a1-8d2e-457a-9db0-a8add75f2dda\', \'multiverseId\': 427155}, \'multiverseid\': 427155}, {\'name\': \'Behemot con escamas\', \'text\': \'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.)\', \'type\': \'Criatura — Cocodrilo\', \'flavor\': \'Sobrevivir a un encuentro con él es señal suficiente de que un iniciado está listo para la Prueba de fuerza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427424&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf09d2d9-e167-4811-b28f-4417d76d350b\', \'multiverseId\': 427424}, \'multiverseid\': 427424}, {\'name\': \'Béhémoth écailleux\', \'text\': \'Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\', \'type\': \'Créature : crocodile\', \'flavor\': "Survivre après y avoir été confronté prouve de manière concluante qu\'un adepte est prêt à disputer l\'Épreuve de force.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427693&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3fe0accb-5341-47df-94b8-e3532fbc5a84\', \'multiverseId\': 427693}, \'multiverseid\': 427693}, {\'name\': \'Behemoth Squamato\', \'text\': \'Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\', \'type\': \'Creatura — Coccodrillo\', \'flavor\': "Se un iniziato sopravvive a un incontro con questa creatura, significa che è pronto ad affrontare l\'Ordalia della Forza.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427962&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28276b1f-0866-424e-acb0-4603f3724d19\', \'multiverseId\': 427962}, \'multiverseid\': 427962}, {\'name\': \'鱗ビヒモス\', \'text\': \'呪禁（このクリーチャーは、対戦相手がコントロールする呪文や能力の対象にならない。）\', \'type\': \'クリーチャー — クロコダイル\', \'flavor\': \'これに出会って生き残った修練者は、活力の試練を受けるのにふさわしいとみなされる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428231&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a53f5871-cfd9-46a4-a229-36586475891d\', \'multiverseId\': 428231}, \'multiverseid\': 428231}, {\'name\': \'비늘로 덮인 거대괴수\', \'text\': \'방호 (이 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\', \'type\': \'생물 — 악어\', \'flavor\': \'이 놈과 맞서 살아남은 입회자는 힘의 시험을 시작할 준비가 된 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428500&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5c13336c-127f-4e78-8b1f-bcda2e98a4d3\', \'multiverseId\': 428500}, \'multiverseid\': 428500}, {\'name\': \'Behemoth Escamoso\', \'text\': \'Resistência a magia (Esta criatura não pode ser alvo de mágicas ou habilidades controladas por seus oponentes.)\', \'type\': \'Criatura — Crocodilo\', \'flavor\': \'Sobreviver a um encontro com ele é prova suficiente de que um iniciado está pronto para a Prova da Força.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd15d8ab-55d1-438d-8945-961d2d3eaac9\', \'multiverseId\': 428769}, \'multiverseid\': 428769}, {\'name\': \'Чешуйчатый Исполин\', \'text\': \'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\', \'type\': \'Существо — Крокодил\', \'flavor\': \'Пережить встречу с этим хищником — достаточное доказательство того, что послушник готов к испытанию силы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429038&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8339c07f-3f0c-4044-8c8c-95110f153c55\', \'multiverseId\': 429038}, \'multiverseid\': 429038}, {\'name\': \'覆鳞巨鳄\', \'text\': \'辟邪（此生物不能成为由对手操控之咒语或异能的目标。）\', \'type\': \'生物～鳄鱼\', \'flavor\': \'如果祀徒遇到它还能活下来，就足证自己够格参加力量祀炼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429307&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f58ea23a-a59b-4f04-b1cb-e5312e64274a\', \'multiverseId\': 429307}, \'multiverseid\': 429307}, {\'name\': \'覆鱗巨鱷\', \'text\': \'辟邪（此生物不能成為由對手操控之咒語或異能的目標。）\', \'type\': \'生物～鱷魚\', \'flavor\': \'如果祀徒遇到牠還能活下來，就足證自己夠格參加力量祀煉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429576&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b3fdebdc-0d22-452f-a49b-21798ea27dd0\', \'multiverseId\': 429576}, \'multiverseid\': 429576}]', '[{\'name\': \'Geschützt durch das Hekma\', \'text\': \'Falls dir eine Quelle, die ein Gegner kontrolliert, Schaden zufügen würde, verhindere 1 dieser Schadenspunkte.\', \'type\': \'Verzauberung\', \'flavor\': \'Jeder Tempeldiener muss während seiner Ausbildung einmal das Hekma ablaufen und sich der Schrecken gewahr werden, die hinter der Barriere des Gott-Pharaos lauern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426994&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'361b02ef-2ab3-48cc-bf1d-c7690720efda\', \'multiverseId\': 426994}, \'multiverseid\': 426994}, {\'name\': \'Protección de la Hekma\', \'text\': \'Si una fuente que controla un oponente fuera a hacerte daño, prevén 1 punto de ese daño.\', \'type\': \'Encantamiento\', \'flavor\': \'Parte del entrenamiento de los acólitos consiste en caminar junto a la Hekma y observar los horrores voraces que la barrera del Dios Faraón mantiene a raya.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427263&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'edaabb83-0d3c-42a8-bc93-fa63210c0056\', \'multiverseId\': 427263}, \'multiverseid\': 427263}, {\'name\': "Protection de l\'Hekma", \'text\': "Si une source qu\'un adversaire contrôle devait vous infliger des blessures, prévenez 1 de ces blessures.", \'type\': \'Enchantement\', \'flavor\': "Dans le cadre de leur entraînement, les acolytes doivent longer l\'Hekma, en fixant du regard les horreurs voraces maintenues à distance par la barrière du Dieu-Pharaon.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff6a812d-a2a5-4918-b8a3-b3c9ba1a5a1a\', \'multiverseId\': 427532}, \'multiverseid\': 427532}, {\'name\': "Protezione dell\'Hekma", \'text\': \'Se una fonte controllata da un avversario ti sta per infliggere danni, previeni 1 di quei danni.\', \'type\': \'Incantesimo\', \'flavor\': "L\'addestramento degli accoliti prevede che camminino lungo l\'Hekma, osservando gli orrori famelici tenuti a bada dalla barriera del Dio Faraone.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427801&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32339878-497d-4cb0-81bd-4e2e9334250b\', \'multiverseId\': 427801}, \'multiverseid\': 427801}, {\'name\': \'ヘクマの防御\', \'text\': \'対戦相手がコントロールする発生源があなたにダメージを与えるなら、そのダメージを１点軽減する。\', \'type\': \'エンチャント\', \'flavor\': \'見習いの訓練にはヘクマに沿って歩くというものがある。訓練は王神の障壁で隔てられた貪欲な怪物の前から始まる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428070&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ed89f84-b91e-48f8-baf3-d61b7bed8246\', \'multiverseId\': 428070}, \'multiverseid\': 428070}, {\'name\': \'헤크마의 보호\', \'text\': \'상대가 조종하는 원천이 당신에게 피해를 입히려고 하면, 그 피해 중 1점을 방지한다.\', \'type\': \'부여마법\', \'flavor\': \'견습 사제는 헤크마를 따라 걸으며 신 파라오의 장벽에 막힌 굶주린 괴수들을 쳐다보는 수련을 해야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428339&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'44c4f2c4-f03d-4daa-bb21-164d8d91f226\', \'multiverseId\': 428339}, \'multiverseid\': 428339}, {\'name\': \'Proteção da Hekma\', \'text\': \'Se uma fonte controlada por um oponente for causar dano a você, previna 1 ponto daquele dano.\', \'type\': \'Encantamento\', \'flavor\': \'Parte do treinamento dos acólitos é andar ao longo da Hekma para observar os horrores vorazes afastados pela barreira do Faraó-Deus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428608&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3d5a92f-f896-41c2-8a2a-758b427b0c71\', \'multiverseId\': 428608}, \'multiverseid\': 428608}, {\'name\': \'Защита Хекмы\', \'text\': \'Если источник под контролем оппонента должен нанести вам повреждения, предотвратите 1 из тех повреждений.\', \'type\': \'Чары\', \'flavor\': \'Готовясь к испытаниям, непосвященные проходят вдоль Хекмы и разглядывают ненасытных чудовищ, которых сдерживает преграда Бога-Фараона.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428877&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0dd420a-9179-4b71-8d64-ff226fd23052\', \'multiverseId\': 428877}, \'multiverseid\': 428877}, {\'name\': \'避世帘庇护\', \'text\': \'如果由对手操控的某来源将对你造成伤害，则防止此伤害中的1点。\', \'type\': \'结界\', \'flavor\': \'侍僧训练中的一个环节便是到避世帘旁走一遭，正视被法老神屏障阻挡在外的凶残邪物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429146&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0afaa1d-44af-4338-8603-6d3088d10fc8\', \'multiverseId\': 429146}, \'multiverseid\': 429146}, {\'name\': \'避世簾庇護\', \'text\': \'如果由對手操控的某來源將對你造成傷害，則防止此傷害中的1點。\', \'type\': \'結界\', \'flavor\': \'侍僧訓練中的一個環節便是到避世簾旁走一遭，正視被法老神屏障阻擋在外的凶殘邪物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429415&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'285db77d-5141-4baf-a06d-73c7119574d4\', \'multiverseId\': 429415}, \'multiverseid\': 429415}]', "[{'name': 'Geschütztes Gestrüpp', 'text': '({T}: Erhöhe deinen Manavorrat um {R} oder {G}.)\\nDas Geschützte Gestrüpp kommt getappt ins Spiel.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land — Gebirge, Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427219&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b16e32f8-c975-4fe4-b998-7fa5cfd62f3c', 'multiverseId': 427219}, 'multiverseid': 427219}, {'name': 'Matorrales resguardados', 'text': '({T}: Agrega {R} o {G} a tu reserva de maná.)\\nLos Matorrales resguardados entran al campo de batalla girados.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Tierra — Montaña bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427488&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ca95b415-da60-48b7-8927-e857c4c020ae', 'multiverseId': 427488}, 'multiverseid': 427488}, {'name': 'Halliers protégés', 'text': '({T} : Ajoutez {R} ou {G} à votre réserve.)\\nLes Halliers protégés arrivent sur le champ de bataille engagés.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain : montagne et forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427757&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c5fd077b-e618-48c7-a5d1-b626fdd81ea7', 'multiverseId': 427757}, 'multiverseid': 427757}, {'name': 'Boschetto Riparato', 'text': '({T}: Aggiungi {R} o {G} alla tua riserva di mana.)\\nIl Boschetto Riparato entra nel campo di battaglia TAPpato.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra — Montagna Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428026&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a6be9077-de1d-432e-b690-d241caeb77be', 'multiverseId': 428026}, 'multiverseid': 428026}, {'name': '隠れた茂み', 'text': '（{T}：あなたのマナ・プールに{R}か{G}を加える。）\\n隠れた茂みはタップ状態で戦場に出る。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': '土地 — 山・森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428295&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1c995cb3-a1d5-4769-8620-bb3f74560337', 'multiverseId': 428295}, 'multiverseid': 428295}, {'name': '보호받는 덤불', 'text': '({T}: {R} 또는 {G}를 당신의 마나풀에 담는다.)\\n보호받는 덤불은 탭된 채로 전장에 들어온다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)', 'type': '대지 — 산 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428564&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '67cf864a-e201-4a35-98e9-ad7276d93519', 'multiverseId': 428564}, 'multiverseid': 428564}, {'name': 'Arvoredo Resguardado', 'text': '({T}: Adicione {R} ou {G} à sua reserva de mana.)\\nArvoredo Resguardado entra no campo de batalha virado.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)', 'type': 'Terreno — Montanha Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428833&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1f8f982e-7b7f-47f7-bc4f-692c0e0bc374', 'multiverseId': 428833}, 'multiverseid': 428833}, {'name': 'Укрытая Поросль', 'text': '({T}: добавьте {R} или {G} в ваше хранилище маны.)\\nУкрытая Поросль выходит на поле битвы повернутой.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)', 'type': 'Земля — Гора Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429102&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e9ff6654-e863-4dd5-b9de-ab38b52b92f8', 'multiverseId': 429102}, 'multiverseid': 429102}, {'name': '岩壁灌丛', 'text': '（{T}：加{R}或{G}到你的法术力池中。）\\n岩壁灌丛须横置进战场。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '地～山脉／树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429371&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '78053b96-7459-40f9-8166-1522f6c69477', 'multiverseId': 429371}, 'multiverseid': 429371}, {'name': '岩壁灌叢', 'text': '（{T}：加{R}或{G}到你的魔法力池中。）\\n岩壁灌叢須橫置進戰場。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）', 'type': '地～山脈／樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429640&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b539b7ff-9142-49f8-89c0-f8db6f0053f2', 'multiverseId': 429640}, 'multiverseid': 429640}]", '[{\'name\': \'Gewaltiger Einschlag\', \'text\': \'Zerstöre ein Artefakt oder ein Land deiner Wahl.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'Die Geweihten müssen auch in der Hitze des Gefechts noch improvisieren können.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427125&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'003a467d-a1c4-49da-a435-a46281454957\', \'multiverseId\': 427125}, \'multiverseid\': 427125}, {\'name\': \'Impacto violento\', \'text\': \'Destruye el artefacto o tierra objetivo.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'En el fragor del combate, los iniciados deben ser capaces de adaptarse a las condiciones cambiantes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427394&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c2c7242-801c-4a5b-bf37-6fc57f4b2221\', \'multiverseId\': 427394}, \'multiverseid\': 427394}, {\'name\': \'Impact violent\', \'text\': "Détruisez l\'artefact ciblé ou le terrain ciblé.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': "Les adeptes doivent être capables de s\'adapter à des situations fluctuantes en plein combat.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427663&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9e48a09-3bd7-4c6d-acef-fd9911a47faa\', \'multiverseId\': 427663}, \'multiverseid\': 427663}, {\'name\': \'Impatto Violento\', \'text\': \'Distruggi un artefatto o una terra bersaglio.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'Nel fervore della battaglia, gli iniziati devono sapersi adattare a condizioni mutevoli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427932&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2764ace4-e42a-4a27-8707-a48c3043c369\', \'multiverseId\': 427932}, \'multiverseid\': 427932}, {\'name\': \'暴力的な衝撃\', \'text\': \'アーティファクト１つか土地１つを対象とし、それを破壊する。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'戦闘中の修練者は、状況の変化に適応する必要がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428201&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae733469-c5f7-4924-98d7-8923c70831c9\', \'multiverseId\': 428201}, \'multiverseid\': 428201}, {\'name\': \'난폭한 충격\', \'text\': \'마법물체나 대지를 목표로 정한다. 그 목표를 파괴한다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'전투에 한창인 입회자들은 시시각각 바뀌는 상황에 적응해야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428470&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'47779118-030c-465a-a6c5-baf69ca173e8\', \'multiverseId\': 428470}, \'multiverseid\': 428470}, {\'name\': \'Impacto Violento\', \'text\': \'Destrua o artefato ou terreno alvo.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'Os iniciados precisam ser capazes de se adaptar às mudanças inesperadas da batalha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428739&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d111ba30-55e6-43d6-8e77-52c7112f57c6\', \'multiverseId\': 428739}, \'multiverseid\': 428739}, {\'name\': \'Жестокий Удар\', \'text\': \'Уничтожьте целевой артефакт или землю.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'Послушники должны уметь даже в пылу битвы приспосабливаться к меняющимся условиям.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429008&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fb8b4f36-f4f0-47ed-a22d-9a2962ca6fe7\', \'multiverseId\': 429008}, \'multiverseid\': 429008}, {\'name\': \'强力冲击\', \'text\': \'消灭目标神器或地。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'祀徒在激烈战斗中须能随机应变。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429277&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2af64018-55f2-45bf-9007-d0d8322f0aef\', \'multiverseId\': 429277}, \'multiverseid\': 429277}, {\'name\': \'強力衝擊\', \'text\': \'消滅目標神器或地。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'祀徒在激烈戰鬥中須能隨機應變。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429546&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0f22a72c-14af-4e87-98d3-008548cafe4c\', \'multiverseId\': 429546}, \'multiverseid\': 429546}]', '[{\'name\': \'Gewetztes Chepesch\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1.\\nAusrüsten {1} ({1}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Klinge und Mut gehen oftmals Hand in Hand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427201&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60c8e420-8b7d-4ade-906f-7846c1d57779\', \'multiverseId\': 427201}, \'multiverseid\': 427201}, {\'name\': \'Khopesh afilado\', \'text\': \'La criatura equipada obtiene +1/+1.\\nEquipar {1}. ({1}: Anexa este equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Los filos y el coraje van de la mano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427470&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3e441ef-9c94-45ba-afff-d2932a2f9a80\', \'multiverseId\': 427470}, \'multiverseid\': 427470}, {\'name\': \'Khépesh affûté\', \'text\': "La créature équipée gagne +1/+1.\\nÉquipement {1} ({1} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': \'Prenez vos armes et votre courage à deux mains.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427739&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ef1fc21-3efb-459c-994c-6fe0ae8cbaef\', \'multiverseId\': 427739}, \'multiverseid\': 427739}, {\'name\': \'Khopesh Affilato\', \'text\': \'La creatura equipaggiata prende +1/+1.\\nEquipaggiare {1} ({1}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Le armi sono inutili senza ardimento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428008&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b57322f-8ff3-4890-8cfc-85d579490479\', \'multiverseId\': 428008}, \'multiverseid\': 428008}, {\'name\': \'研ぎ澄まされたコペシュ\', \'text\': \'装備しているクリーチャーは＋１/＋１の修整を受ける。\\n装備{1}（{1}：あなたがコントロールするクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'刃と勇気は二人三脚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428277&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'617b4fcf-abc5-4414-ba1a-fb55b4c9dcc4\', \'multiverseId\': 428277}, \'multiverseid\': 428277}, {\'name\': \'날 선 코피스\', \'text\': \'장착된 생물은 +1/+1을 받는다.\\n장착 {1} ({1}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'검과 용기는 함께 간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428546&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b08280e0-5e27-49aa-8946-7ffe0a47b590\', \'multiverseId\': 428546}, \'multiverseid\': 428546}, {\'name\': \'Khopesh Afiado\', \'text\': \'A criatura equipada recebe +1/+1.\\nEquipar {1} ({1}: Anexe à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'As lâminas e a bravura andam de mãos dadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4859c282-2989-42b9-acdb-e26299aaf8d3\', \'multiverseId\': 428815}, \'multiverseid\': 428815}, {\'name\': \'Отточенный Хопеш\', \'text\': \'Снаряженное существо получает +1/+1.\\nСнарядить {1} ({1}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'Хопеш и храбрость — неразлучные спутники.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429084&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c52fb7a6-b213-4c7c-b7f0-8f19fcf6d6b0\', \'multiverseId\': 429084}, \'multiverseid\': 429084}, {\'name\': \'光亮镰刃\', \'text\': \'佩带此武具的生物得+1/+1。\\n佩带{1}（{1}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': \'与勇武般配的利刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429353&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c83b7642-d6e6-43f9-9cc1-be38f35ff682\', \'multiverseId\': 429353}, \'multiverseid\': 429353}, {\'name\': \'光亮鐮刃\', \'text\': \'佩帶此武具的生物得+1/+1。\\n佩帶{1}（{1}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': \'與勇武般配的利刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429622&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'41d61bdd-ee3d-45e6-9d96-9aaf9c2bbfa4\', \'multiverseId\': 429622}, \'multiverseid\': 429622}]', '[{\'name\': \'Gideon der Geprüfte\', \'text\': \'+1: Verhindere bis zu deinem nächsten Zug allen Schaden, den eine bleibende Karte deiner Wahl zufügen würde.\\n0: Bis zum Ende des Zuges wird Gideon der Geprüfte zu einer 4/4 Mensch-Soldat-Kreatur mit Unzerstörbarkeit, die immer noch ein Planeswalker ist. Verhindere allen Schaden, der ihm in diesem Zug zugefügt würde.\\n0: Du erhältst ein Emblem mit „Solange du einen Gideon-Planeswalker kontrollierst, kannst du die Partie nicht verlieren und deine Gegner können die Partie nicht gewinnen."\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426985&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b37d9fb3-ef6a-4e8c-ac1e-8805f052af55\', \'multiverseId\': 426985}, \'multiverseid\': 426985}, {\'name\': \'Gideon de las pruebas\', \'text\': \'+1: Hasta tu próximo turno, prevén todo el daño que el permanente objetivo fuera a hacer.\\n0: Hasta el final del turno, Gideon de las pruebas se convierte en una criatura Soldado Humano 4/4 con la habilidad de indestructible que sigue siendo un planeswalker. Prevén todo el daño que se le fuera a hacer este turno.\\n0: Obtienes un emblema con "Mientras controles un planeswalker Gideon, no puedes perder el juego y tus oponentes no pueden ganar el juego".\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4528512-0c2f-4565-83eb-d351bfdcf955\', \'multiverseId\': 427254}, \'multiverseid\': 427254}, {\'name\': \'Gideon des Épreuves\', \'text\': "+1 : Jusqu\'à votre prochain tour, prévenez toutes les blessures que le permanent ciblé devrait infliger.\\n0 : Jusqu\'à la fin du tour, Gideon des Épreuves devient une créature 4/4 Humain et Soldat avec l\'indestructible qui est toujours un planeswalker. Prévenez toutes les blessures qui devraient lui être infligées ce tour-ci.\\n0 : Vous gagnez un emblème avec « Tant que vous contrôlez un planeswalker Gideon, vous ne pouvez pas perdre la partie et vos adversaires ne peuvent pas la gagner. »", \'type\': \'Planeswalker : Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427523&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f15e0b59-8ea3-437f-857a-c7dd7cfccb94\', \'multiverseId\': 427523}, \'multiverseid\': 427523}, {\'name\': \'Gideon delle Ordalie\', \'text\': \'+1: Fino al tuo prossimo turno, previeni tutto il danno che un permanente bersaglio infliggerebbe.\\n0: Fino alla fine del turno, Gideon delle Ordalie diventa una creatura Soldato Umano 4/4 con indistruttibile che è ancora un planeswalker. Previeni tutto il danno che gli verrebbe inflitto in questo turno.\\n0: Ottieni un emblema con "Fintanto che controlli un planeswalker Gideon, non puoi perdere la partita e i tuoi avversari non possono vincere la partita".\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427792&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'646d3b64-3938-4f50-a1ce-13400ad9249d\', \'multiverseId\': 427792}, \'multiverseid\': 427792}, {\'name\': \'試練に臨むギデオン\', \'text\': \'+1：パーマネント１つを対象とする。あなたの次のターンまで、それが与えるダメージをすべて軽減する。\\n0：ターン終了時まで、試練に臨むギデオンは破壊不能を持つ４/４の人間・兵士・クリーチャーになる。これはプレインズウォーカーでもある。このターン、これに与えられるダメージをすべて軽減する。\\n0：あなたは「あなたがギデオン・プレインズウォーカーをコントロールしているかぎり、あなたはこのゲームに敗北できず、対戦相手はこのゲームに勝利できない。」を持つ紋章を得る。\', \'type\': \'プレインズウォーカー — ギデオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428061&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55725713-a2f5-4684-b72f-82b56ea772af\', \'multiverseId\': 428061}, \'multiverseid\': 428061}, {\'name\': \'시험에 든 기디온\', \'text\': \'+1: 지속물을 목표로 정한다. 당신의 다음 턴까지 그 지속물이 입히려고 하는 모든 피해를 방지한다.\\n0: 턴종료까지, 시험에 든 기디온은 무적을 가진 4/4 인간 병사 생물이 된다. 시험에 든 기디온은 여전히 플레인즈워커이다. 이 턴에 기디온이 입으려고 하는 모든 피해를 방지한다.\\n0: 당신은 "당신이 기디온 플레인즈워커를 조종하는 한, 당신은 게임에서 패배할 수 없으며 당신의 상대들은 게임에서 승리할 수 없다."를 가진 휘장을 얻는다.\', \'type\': \'플레인즈워커 — 기디온\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428330&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'01fcd326-91a5-49e0-9780-df6de110707e\', \'multiverseId\': 428330}, \'multiverseid\': 428330}, {\'name\': \'Gideon das Provas\', \'text\': \'+1: Até seu próximo turno, previna todo o dano que a permanente alvo causaria.\\n0: Até o final do turno, Gideon das Provas torna-se uma criatura 4/4 do tipo Humano Soldado com indestrutível que ainda é um planeswalker. Previna todo o dano que seria causado a ele neste turno.\\n0: Você recebe um emblema com "Enquanto você controlar um planeswalker Gideon, você não poderá perder o jogo e seus oponentes não poderão vencer o jogo.".\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428599&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b626edf5-517b-45ad-b254-4728f3f50ce2\', \'multiverseId\': 428599}, \'multiverseid\': 428599}, {\'name\': \'Гидеон, Участник Испытаний\', \'text\': \'+1: до вашего следующего хода предотвратите все повреждения, которые должен нанести целевой перманент.\\n0: до конца хода Гидеон, Участник Испытаний становится существом 4/4 Человек Солдат с Неразрушимостью, которое остается planeswalker-ом. Предотвратите все повреждения, которые должны быть нанесены ему в этом ходу.\\n0: вы получаете эмблему со способностью «Пока вы контролируете planeswalker-а Гидеона, вы не можете проиграть партию, а ваши оппоненты не могут выиграть партию».\', \'type\': \'Planeswalker — Гидеон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428868&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8d322a2-26a8-4e4d-8800-a280d571e514\', \'multiverseId\': 428868}, \'multiverseid\': 428868}, {\'name\': \'祀炼基定\', \'text\': \'+1：直到你的下一个回合，防止目标永久物将造成的所有伤害。\\n0：直到回合结束，祀炼基定成为4/4，具不灭异能的人类／士兵生物，且仍然是鹏洛客。防止本回合中将对他造成的所有伤害。\\n0：你获得具有「只要你操控基定鹏洛客，你这盘游戏不会输，对手也不会赢」的徽记。\', \'type\': \'鹏洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429137&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9ad4106d-e560-40de-b25e-f3b51b6d0285\', \'multiverseId\': 429137}, \'multiverseid\': 429137}, {\'name\': \'祀煉基定\', \'text\': \'+1：直到你的下一個回合，防止目標永久物將造成的所有傷害。\\n0：直到回合結束，祀煉基定成為4/4，具不滅異能的人類／士兵生物，且仍然是鵬洛客。防止本回合中將對他造成的所有傷害。\\n0：你獲得具有「只要你操控基定鵬洛客，你這盤遊戲不會輸，對手也不會贏」的徽記。\', \'type\': \'鵬洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429406&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'68246996-9fb2-4b48-be7d-cb2bbc3c8164\', \'multiverseId\': 429406}, \'multiverseid\': 429406}]', '[{\'name\': \'Gideon, Inbild der Kriegskunst\', \'text\': \'+2: Enttappe alle Kreaturen, die du kontrollierst. Diese Kreaturen erhalten +1/+1 bis zum Ende des Zuges.\\n0: Bis zum Ende des Zuges wird Gideon, Inbild der Kriegskunst, zu einer 5/5 Mensch-Soldat-Kreatur mit Unzerstörbarkeit, die immer noch ein Planeswalker ist. Verhindere allen Schaden, der ihm in diesem Zug zugefügt würde.\\n—10: Kreaturen, die du kontrollierst, erhalten +2/+2 bis zum Ende des Zuges. Tappe alle Kreaturen, die deine Gegner kontrollieren.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429716&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e00a9700-85d5-4448-8e52-988684b973c8\', \'multiverseId\': 429716}, \'multiverseid\': 429716}, {\'name\': \'Gideon, arquetipo marcial\', \'text\': \'+2: Endereza todas las criaturas que controlas. Esas criaturas obtienen +1/+1 hasta el final del turno.\\n0: Hasta el final del turno, Gideon, arquetipo marcial se convierte en una criatura Soldado Humano 5/5 con la habilidad de indestructible que sigue siendo un planeswalker. Prevén todo el daño que se le fuera a hacer este turno.\\n−10: Las criaturas que controlas obtienen +2/+2 hasta el final del turno. Gira todas las criaturas que controlan tus oponentes.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429842&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f1ae8768-beab-46a4-8e81-157c3f4b4430\', \'multiverseId\': 429842}, \'multiverseid\': 429842}, {\'name\': \'Gideon, parangon de soldat\', \'text\': "+2 : Dégagez toutes les créatures que vous contrôlez. Ces créatures gagnent +1/+1 jusqu\'à la fin du tour.\\n0 : Jusqu\'à la fin du tour, Gideon, parangon de soldat devient une créature 5/5 Humain et Soldat avec l\'indestructible qui est toujours un planeswalker. Prévenez toutes les blessures qui devraient lui être infligées ce tour-ci.\\n-10 : Les créatures que vous contrôlez gagnent +2/+2 jusqu\'à la fin du tour. Engagez toutes les créatures que vos adversaires contrôlent.", \'type\': \'Planeswalker : Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429734&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'10b6f21d-ddcb-42dc-b3e3-a4e2efe14ca8\', \'multiverseId\': 429734}, \'multiverseid\': 429734}, {\'name\': \'Gideon, Paradigma Marziale\', \'text\': \'+2: STAPpa tutte le creature che controlli. Quelle creature prendono +1/+1 fino alla fine del turno.\\n0: Fino alla fine del turno, Gideon, Paradigma Marziale diventa una creatura Soldato Umano 5/5 con indistruttibile che è ancora un planeswalker. Previeni tutto il danno che gli verrebbe inflitto in questo turno.\\n-10: Le creature che controlli prendono +2/+2 fino alla fine del turno. TAPpa tutte le creature controllate dai tuoi avversari.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429752&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8baed7ef-52ab-4a33-be49-71b18eceb1b7\', \'multiverseId\': 429752}, \'multiverseid\': 429752}, {\'name\': \'武芸の模範、ギデオン\', \'text\': \'+2：あなたがコントロールするすべてのクリーチャーをアンタップする。ターン終了時まで、それらのクリーチャーは＋１/＋１の修整を受ける。\\n0：ターン終了時まで、武芸の模範、ギデオンは破壊不能を持つ５/５の人間・兵士・クリーチャーになる。これはプレインズウォーカーでもある。このターン、これに与えられるすべてのダメージを軽減する。\\n-10：ターン終了時まで、あなたがコントロールするクリーチャーは＋２/＋２の修整を受ける。対戦相手がコントロールするすべてのクリーチャーをタップする。\', \'type\': \'プレインズウォーカー — ギデオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429770&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c51318f8-096f-4ace-b18f-1d8abd10c0bc\', \'multiverseId\': 429770}, \'multiverseid\': 429770}, {\'name\': \'무술의 귀감 기디온\', \'text\': \'+2: 당신이 조종하는 모든 생물을 언탭한다. 그 생물들은 턴종료까지 +1/+1을 받는다.\\n0: 턴종료까지, 무술의 귀감 기디온은 무적을 가진 5/5 인간 병사 생물이 된다. 무술의 귀감 기디온은 여전히 플레인즈워커이다. 이 턴에 무술의 귀감 기디온이 입으려고 하는 모든 피해를 방지한다.\\n−10: 당신이 조종하는 생물들은 턴종료까지 +2/+2를 받는다. 당신의 상대들이 조종하는 모든 생물을 탭한다.\', \'type\': \'플레인즈워커 — 기디온\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429788&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cfa48aec-e810-4cdb-a8f0-e4d718effbec\', \'multiverseId\': 429788}, \'multiverseid\': 429788}, {\'name\': \'Gideon, Paradigma Marcial\', \'text\': \'+2: Desvire todas as criaturas que você controla. Aquelas criaturas recebem +1/+1 até o final do turno.\\n0: Até o final do turno, Gideon, Paradigma Marcial, torna-se uma criatura 5/5 do tipo Humano Soldado com indestrutível que ainda é um planeswalker. Previna todo o dano que seria causado a ele neste turno.\\n−10: As criaturas que você controla recebem +2/+2 até o final do turno. Vire todas as criaturas que seus oponentes controlam.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429806&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'805d70e6-0a16-45e5-ae99-049c50896809\', \'multiverseId\': 429806}, \'multiverseid\': 429806}, {\'name\': \'Гидеон, Образец Воителя\', \'text\': \'+2: разверните все существа под вашим контролем. Те существа получают +1/+1 до конца хода.\\n0: до конца хода Гидеон, Образец Воителя становится существом 5/5 Человек Солдат с Неразрушимостью, которое остается planeswalker-ом. Предотвратите все повреждения, которые должны быть нанесены ему в этом ходу.\\n−10: существа под вашим контролем получают +2/+2 до конца хода. Поверните все существа под контролем ваших оппонентов.\', \'type\': \'Planeswalker — Гидеон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429824&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'19e5258e-59b4-4a1a-a94f-ebcff1241ce2\', \'multiverseId\': 429824}, \'multiverseid\': 429824}, {\'name\': \'勇武典范基定\', \'text\': \'+2：重置所有由你操控的生物。这些生物得+1/+1直到回合结束。\\n0：直到回合结束，勇武典范基定成为5/5，具不灭异能的人类／士兵生物，且仍然是鹏洛客。防止本回合中将对他造成的所有伤害。\\n-10：由你操控的生物得+2/+2直到回合结束。横置所有由对手操控的生物。\', \'type\': \'鹏洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429680&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'615b8918-2009-416d-8eeb-61fc5e48ba34\', \'multiverseId\': 429680}, \'multiverseid\': 429680}, {\'name\': \'勇武典範基定\', \'text\': \'+2：重置所有由你操控的生物。這些生物得+1/+1直到回合結束。\\n0：直到回合結束，勇武典範基定成為5/5，具不滅異能的人類／士兵生物，且仍然是鵬洛客。防止本回合中將對他造成的所有傷害。\\n−10：由你操控的生物得+2/+2直到回合結束。橫置所有由對手操控的生物。\', \'type\': \'鵬洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429698&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2801d687-9af5-4c63-8fc6-882b18962345\', \'multiverseId\': 429698}, \'multiverseid\': 429698}]', '[{\'name\': \'Gideons Eingreifen\', \'text\': \'Sowie Gideons Eingreifen ins Spiel kommt, bestimme einen Kartennamen.\\nDeine Gegner können keine Zaubersprüche mit dem bestimmten Namen wirken.\\nVerhindere allen Schaden, der dir oder bleibenden Karten, die du kontrollierst, von Quellen mit dem bestimmten Namen zugefügt würde.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426986&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47bfffb0-c72c-4cf2-8c26-34ad3f4796c5\', \'multiverseId\': 426986}, \'multiverseid\': 426986}, {\'name\': \'Intervención de Gideon\', \'text\': \'Cuando la Intervención de Gideon entre al campo de batalla, elige el nombre de una carta.\\nTus oponentes no pueden lanzar hechizos con el nombre elegido.\\nPrevén todo el daño que fueran a hacer fuentes con el nombre elegido a ti y a los permanentes que controlas.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427255&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5efbce42-262c-4f22-a58a-656ea9f93304\', \'multiverseId\': 427255}, \'multiverseid\': 427255}, {\'name\': \'Intervention de Gideon\', \'text\': "Au moment où l\'Intervention de Gideon arrive sur le champ de bataille, choisissez un nom de carte.\\nVos adversaires ne peuvent pas lancer de sorts du nom choisi.\\nPrévenez toutes les blessures qui devraient être infligées à vous et aux permanents que vous contrôlez par des sources du nom choisi.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427524&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d4d851d-4194-4c3c-8cee-d5a47881fa43\', \'multiverseId\': 427524}, \'multiverseid\': 427524}, {\'name\': \'Intervento di Gideon\', \'text\': "Mentre l\'Intervento di Gideon entra nel campo di battaglia, scegli il nome di una carta.\\nI tuoi avversari non possono lanciare magie con il nome scelto.\\nPrevieni tutto il danno che verrebbe inflitto a te e ai permanenti che controlli da fonti con il nome scelto.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427793&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bfa7d9d6-f3af-4d4a-8d62-c17f418d9334\', \'multiverseId\': 427793}, \'multiverseid\': 427793}, {\'name\': \'ギデオンの介入\', \'text\': \'ギデオンの介入が戦場に出るに際し、カード名１つを選ぶ。\\n対戦相手は選ばれた名前を持つ呪文を唱えられない。\\n選ばれた名前を持つ発生源からあなたとあなたがコントロールするパーマネントに与えられるダメージをすべて軽減する。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428062&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'967d92b3-e8bf-42ed-94e4-95099c167dfa\', \'multiverseId\': 428062}, \'multiverseid\': 428062}, {\'name\': \'기디온의 개입\', \'text\': \'기디온의 개입이 전장에 들어오면서, 카드 이름 하나를 선택한다.\\n당신의 상대들은 그 이름을 가진 주문을 발동할 수 없다.\\n당신과 당신이 조종하는 지속물이 선택한 이름을 가진 원천들로부터 입으려고 하는 모든 피해를 방지한다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428331&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d83c6610-c881-4a6d-9054-9142d5eded45\', \'multiverseId\': 428331}, \'multiverseid\': 428331}, {\'name\': \'Intervenção de Gideon\', \'text\': \'Conforme Intervenção de Gideon entrar no campo de batalha, escolha um nome de card.\\nSeus oponentes não podem conjurar mágicas com o nome escolhido.\\nPrevina todo o dano que seria causado a você e às permanentes que você controla por fontes com o nome escolhido.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428600&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a31d509-83f2-48e4-b35a-13d7efd0a487\', \'multiverseId\': 428600}, \'multiverseid\': 428600}, {\'name\': \'Вмешательство Гидеона\', \'text\': \'При выходе Вмешательства Гидеона на поле битвы выберите имя карты.\\nВаши оппоненты не могут разыгрывать заклинания с выбранным именем.\\nПредотвратите все повреждения, которые должны быть нанесены вам и перманентам под вашим контролем источниками с выбранным именем.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428869&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a186a729-4ca4-451a-9416-630e6f01b6ab\', \'multiverseId\': 428869}, \'multiverseid\': 428869}, {\'name\': \'基定的干预\', \'text\': \'于基定的干预进战场时，选择一个牌名。\\n所有对手都不能施放具该名称的咒语。\\n防止具该名称的来源将对你和由你操控之永久物造成的所有伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429138&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d959fe6-b341-4087-8ac0-9da3dc33c869\', \'multiverseId\': 429138}, \'multiverseid\': 429138}, {\'name\': \'基定的干預\', \'text\': \'於基定的干預進戰場時，選擇一個牌名。\\n所有對手都不能施放具該名稱的咒語。\\n防止具該名稱的來源將對你和由你操控之永久物造成的所有傷害。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429407&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ee39c312-98c2-4424-abfa-792b5b71af4c\', \'multiverseId\': 429407}, \'multiverseid\': 429407}]', "[{'name': 'Gideons Entschlossenheit', 'text': 'Wenn Gideons Entschlossenheit ins Spiel kommt, kannst du deine Bibliothek und/oder deinen Friedhof nach einer Karte namens Gideon, Inbild der Kriegskunst, durchsuchen, sie offen vorzeigen und auf deine Hand nehmen. Falls du auf diese Weise deine Bibliothek durchsuchst, mische sie danach.\\nKreaturen, die du kontrollierst, erhalten +1/+1.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429718&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ba2e29c5-c2dc-4506-a8c0-3d46e7b00064', 'multiverseId': 429718}, 'multiverseid': 429718}, {'name': 'Determinación de Gideon', 'text': 'Cuando la Determinación de Gideon entre al campo de batalla, puedes buscar en tu biblioteca y/o cementerio una carta llamada Gideon, arquetipo marcial, mostrarla y ponerla en tu mano. Si buscas en tu biblioteca de esta manera, barájala.\\nLas criaturas que controlas obtienen +1/+1.', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429844&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '07646c15-8c8c-4230-8155-ddd4f26003df', 'multiverseId': 429844}, 'multiverseid': 429844}, {'name': 'Résolution de Gideon', 'text': 'Quand la Résolution de Gideon arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque et/ou votre cimetière une carte appelée Gideon, parangon de soldat, la révéler et la mettre dans votre main. Si vous cherchez dans votre bibliothèque de cette manière, mélangez-la.\\nLes créatures que vous contrôlez gagnent +1/+1.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429736&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f250256b-a8bf-4b42-a356-b6be256feecc', 'multiverseId': 429736}, 'multiverseid': 429736}, {'name': 'Determinazione di Gideon', 'text': 'Quando la Determinazione di Gideon entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio e/o il tuo cimitero per una carta chiamata Gideon, Paradigma Marziale, rivelarla e aggiungerla alla tua mano. Se passi in rassegna il tuo grimorio in questo modo, rimescolalo.\\nLe creature che controlli prendono +1/+1.', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429754&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a535b1ba-77fa-4244-a7b8-02f504516a5c', 'multiverseId': 429754}, 'multiverseid': 429754}, {'name': 'ギデオンの決意', 'text': 'ギデオンの決意が戦場に出たとき、あなたはあなたのライブラリーやあなたの墓地から「武芸の模範、ギデオン」という名前のカード１枚を探し、それを公開してあなたの手札に加えてもよい。これによりあなたのライブラリーからカードを探したなら、あなたのライブラリーを切り直す。\\nあなたがコントロールするクリーチャーは＋１/＋１の修整を受ける。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429772&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5c4e5f36-e106-47f3-8a91-9a3705f2f1eb', 'multiverseId': 429772}, 'multiverseid': 429772}, {'name': '기디온의 결의', 'text': '기디온의 결의가 전장에 들어올 때, 당신은 당신의 서고 그리고/또는 무덤에서 이름이 무술의 귀감 기디온인 카드 한 장을 찾아 공개한 후 당신의 손으로 가져갈 수 있다. 당신이 이런 식으로 당신의 서고를 찾아보았다면, 당신의 서고를 섞는다.\\n당신이 조종하는 생물들은 +1/+1을 받는다.', 'type': '부여마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429790&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'dafe3d75-d2d0-4582-a6cf-ffda08d1a415', 'multiverseId': 429790}, 'multiverseid': 429790}, {'name': 'Resolução de Gideon', 'text': 'Quando Resolução de Gideon entra no campo de batalha, você pode procurar em seu grimório e/ou cemitério um card com o nome Gideon, Paradigma Marcial, revelá-lo e colocá-lo em sua mão. Se procurar em seu grimório desta maneira, embaralhe-o.\\nAs criaturas que você controla recebem +1/+1.', 'type': 'Encantamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429808&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3376f337-21a5-43b5-a88c-d7d36de13e81', 'multiverseId': 429808}, 'multiverseid': 429808}, {'name': 'Решимость Гидеона', 'text': 'Когда Решимость Гидеона выходит на поле битвы, вы можете найти в вашей библиотеке и (или) на вашем кладбище карту с именем Гидеон, Образец Воителя, показать ее и положить в вашу руку. Если вы ищете таким образом в вашей библиотеке, перетасуйте ее.\\nСущества под вашим контролем получают +1/+1.', 'type': 'Чары', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429826&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0559672e-6e0b-46b6-a943-54a5c9fff4fc', 'multiverseId': 429826}, 'multiverseid': 429826}, {'name': '基定的决心', 'text': '当基定的决心进战场时，你可以从你的牌库和／或坟墓场中搜寻一张名称为勇武典范基定的牌，展示该牌，并将它置于你手上。如果你以此法搜寻你的牌库，则将它洗牌。\\n由你操控的生物得+1/+1。', 'type': '结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429682&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1a96f60b-9190-4b33-8698-f5e49ad027d7', 'multiverseId': 429682}, 'multiverseid': 429682}, {'name': '基定的決心', 'text': '當基定的決心進戰場時，你可以從你的牌庫和／或墳墓場中搜尋一張名稱為勇武典範基定的牌，展示該牌，並將它置於你手上。如果你以此法搜尋你的牌庫，則將它洗牌。\\n由你操控的生物得+1/+1。', 'type': '結界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429700&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '58d81a13-0afe-4339-86a2-9997ffa37df7', 'multiverseId': 429700}, 'multiverseid': 429700}]", '[{\'name\': \'Glaube der Ergebenen\', \'text\': \'Immer wenn du eine Karte umwandelst oder abwirfst, kannst du {1} bezahlen. Falls du dies tust, verliert jeder Gegner 2 Lebenspunkte, und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Je mehr ich über diesen Ort erfahre, umso weniger will ich wissen." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427061&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b1ccbc6-537f-49e8-abdd-ffe2e079ba99\', \'multiverseId\': 427061}, \'multiverseid\': 427061}, {\'name\': \'Fe de los devotos\', \'text\': \'Siempre que actives una habilidad de ciclo o descartes una carta, puedes pagar {1}. Si lo haces, cada oponente pierde 2 vidas y tú ganas 2 vidas.\', \'type\': \'Encantamiento\', \'flavor\': \'"Cuánto más veo de este lugar, menos quiero ver". —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427330&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9ee6468-01e7-4db7-917a-351b41a97892\', \'multiverseId\': 427330}, \'multiverseid\': 427330}, {\'name\': \'Foi des dévoués\', \'text\': "À chaque fois que vous recyclez ou vous défaussez d\'une carte, vous pouvez payer {1}. Si vous faites ainsi, chaque adversaire perd 2 points de vie et vous gagnez 2 points de vie.", \'type\': \'Enchantement\', \'flavor\': "« Plus j\'en apprends sur cet endroit, moins je veux en savoir. » —Chandra Nalaàr", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427599&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27dc309c-9c7f-44f6-bd81-18200cc8d27e\', \'multiverseId\': 427599}, \'multiverseid\': 427599}, {\'name\': \'Fede dei Devoti\', \'text\': \'Ogniqualvolta cicli o scarti una carta, puoi pagare {1}. Se lo fai, ogni avversario perde 2 punti vita e tu guadagni 2 punti vita.\', \'type\': \'Incantesimo\', \'flavor\': \'"Più cose vedo di questo posto, meno vorrei vederne." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427868&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a72ee4ae-149b-4d94-81dd-db5f256a5168\', \'multiverseId\': 427868}, \'multiverseid\': 427868}, {\'name\': \'信者の確信\', \'text\': \'あなたがカードを１枚サイクリングするか捨てるたび、あなたは{1}を支払ってもよい。そうしたなら、各対戦相手はそれぞれ２点のライフを失い、あなたは２点のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': \'「見れば見るほどこの場所には嫌気が差すわ。」 ――チャンドラ・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428137&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'08c41e51-f09b-4858-be74-c0b882cac067\', \'multiverseId\': 428137}, \'multiverseid\': 428137}, {\'name\': \'헌신적인 믿음\', \'text\': \'당신이 카드를 순환하거나 버릴 때마다, 당신은 {1}을 지불할 수 있다. 그렇게 한다면, 각 상대는 생명 2점을 잃고 당신은 생명 2점을 얻는다.\', \'type\': \'부여마법\', \'flavor\': \'"이곳에 대해 알면 알수록 더 알고 싶지 않아." —찬드라 날라르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428406&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e1830225-4971-4efa-ae67-79cb200af299\', \'multiverseId\': 428406}, \'multiverseid\': 428406}, {\'name\': \'Fé dos Devotos\', \'text\': \'Toda vez que recicla ou descarta um card, você pode pagar {1}. Se fizer isso, cada oponente perderá 2 pontos de vida e você ganhará 2 pontos de vida.\', \'type\': \'Encantamento\', \'flavor\': \'"Quanto mais vejo deste lugar, menos eu quero ver." — Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428675&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fac646a8-78d0-41d1-95c6-d6e98f9849b1\', \'multiverseId\': 428675}, \'multiverseid\': 428675}, {\'name\': \'Вера Преданных\', \'text\': \'Каждый раз, когда вы совершаете Цикл или сбрасываете карту, вы можете заплатить {1}. Если вы это делаете, каждый оппонент теряет 2 жизни, а вы получаете 2 жизни.\', \'type\': \'Чары\', \'flavor\': \'«Чем больше я узнаю это место, тем меньше мне хочется продолжать». — Чандра Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428944&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb20b9db-1d44-487d-8131-8a271aaa933c\', \'multiverseId\': 428944}, \'multiverseid\': 428944}, {\'name\': \'虔诚者信念\', \'text\': \'每当你循环或弃一张牌时，你可以支付{1}。若你如此作，则每位对手各失去2点生命且你获得2点生命。\', \'type\': \'结界\', \'flavor\': \'「这个地方我越看越不想看。」 ～茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429213&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cdedc625-ef35-4a9b-872e-773c971cce25\', \'multiverseId\': 429213}, \'multiverseid\': 429213}, {\'name\': \'虔誠者信念\', \'text\': \'每當你循環或棄一張牌時，你可以支付{1}。若你如此作，則每位對手各失去2點生命且你獲得2點生命。\', \'type\': \'結界\', \'flavor\': \'「這個地方我越看越不想看。」 ～茜卓納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429482&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'87f37f68-8775-4857-910f-e92c2eaa45a9\', \'multiverseId\': 429482}, \'multiverseid\': 429482}]', '[{\'name\': \'Gleißende Sonnen\', \'text\': \'Die Gleißenden Sonnen fügen jeder Kreatur 3 Schadenspunkte zu.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'Das Hekma schützt die Stadt vor Sandstürmen und Monstern, aber nichts vermag die sengende Hitze der Sonnen aufzuhalten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427120&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5dbf1a21-d39f-466a-ba7c-69071e885bf5\', \'multiverseId\': 427120}, \'multiverseid\': 427120}, {\'name\': \'Soles abrasadores\', \'text\': \'Los Soles abrasadores hacen 3 puntos de daño a cada criatura.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'Puede que la Hekma repela las tormentas y los monstruos, pero nada puede mitigar el calor de los soles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427389&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7aea306e-e937-4516-8028-ff954da29b7e\', \'multiverseId\': 427389}, \'multiverseid\': 427389}, {\'name\': \'Soleils accablants\', \'text\': \'Les Soleils accablants infligent 3 blessures à chaque créature.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Rituel\', \'flavor\': "L\'Hekma peut repousser les tempêtes et les monstres, mais rien n\'arrête la chaleur des soleils.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427658&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5902e09-ae94-45cc-b209-c27783c66355\', \'multiverseId\': 427658}, \'multiverseid\': 427658}, {\'name\': \'Soli Cocenti\', \'text\': \'I Soli Cocenti infliggono 3 danni a ogni creatura.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': "L\'Hekma protegge dalle tempeste e dai mostri, ma niente può proteggere dal calore dei soli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427927&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c77f583c-f70d-4b3e-98ff-cc07cfd92dd5\', \'multiverseId\': 427927}, \'multiverseid\': 427927}, {\'name\': \'焼けつく双陽\', \'text\': \'焼けつく双陽は各クリーチャーにそれぞれ３点のダメージを与える。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'ヘクマは嵐や怪物を寄せつけないが、双陽の熱は何をもっても防げない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428196&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8fd43815-06c2-4e50-b375-77d9d5e470a9\', \'multiverseId\': 428196}, \'multiverseid\': 428196}, {\'name\': \'무더운 태양\', \'text\': \'무더운 태양은 각 생물에게 피해 3점을 입힌다.\\n순환 {3} ({3}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'헤크마가 폭풍과 괴수들을 쫓아버릴 수 있지만, 아무것도 태양의 열을 막을 수 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428465&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2e92f00-7b5f-4659-9290-6901d4ccc96e\', \'multiverseId\': 428465}, \'multiverseid\': 428465}, {\'name\': \'Sóis Escaldantes\', \'text\': \'Sóis Escaldantes causa 3 pontos de dano a cada criatura.\\nReciclar {3} ({3}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'A Hekma pode repelir tempestades e monstros, mas nada contém o calor dos sóis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428734&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07674dd6-c642-4fa5-9b0e-7634fa4a02f2\', \'multiverseId\': 428734}, \'multiverseid\': 428734}, {\'name\': \'Знойные Солнца\', \'text\': \'Знойные Солнца наносят 3 повреждения каждому существу.\\nЦикл {3} ({3}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'Хекма останавливает бури и чудовищ, но ничто не в силах сдержать жар солнц.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429003&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d3a23b7-de25-4e79-8892-c5009dab182e\', \'multiverseId\': 429003}, \'multiverseid\': 429003}, {\'name\': \'灼热双日\', \'text\': \'灼热双日对每个生物各造成3点伤害。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'避世帘或能抵御狂风与怪物，但什么都挡不住烈日热浪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429272&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c0792a47-ec4b-4ee8-86de-eb6a8ac92f08\', \'multiverseId\': 429272}, \'multiverseid\': 429272}, {\'name\': \'灼熱雙日\', \'text\': \'灼熱雙日對每個生物各造成3點傷害。\\n循環{3}（{3}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'避世簾或能抵禦狂風與怪物，但什麼都擋不住烈日熱浪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429541&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f2808194-1368-4a4f-b87a-45e6d5fc07c4\', \'multiverseId\': 429541}, \'multiverseid\': 429541}]', '[{\'name\': \'Glorreiches Ende\', \'text\': \'Beende den Zug. (Schicke alle Zaubersprüche und Fähigkeiten vom Stapel ins Exil, einschließlich dieser Karte. Der Spieler, dessen Zug es ist, wirft so viele Karten ab, bis er seine maximale Handkartenzahl erreicht hat. Schaden heilt und „In-diesem-Zug"- und „Bis-zum-Ende-des-Zuges"-Effekte enden.)\\nZu Beginn deines nächsten Endsegments verlierst du die Partie.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427104&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b2365d7c-2e31-4e14-a893-f26066657a9e\', \'multiverseId\': 427104}, \'multiverseid\': 427104}, {\'name\': \'Final glorioso\', \'text\': \'Finaliza el turno. (Exilia todos los hechizos y habilidades de la pila, incluida esta carta. El jugador al que corresponde el turno descarta hasta su tamaño máximo de mano. El daño desaparece y terminan los efectos "hasta el final del turno" y "este turno".)\\nAl comienzo de tu próximo paso final, pierdes el juego.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427373&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c3ffc71-004f-44c3-b731-3f53d4844126\', \'multiverseId\': 427373}, \'multiverseid\': 427373}, {\'name\': \'Fin glorieuse\', \'text\': "Terminez le tour. (Exilez tous les sorts et les capacités sur la pile, y compris cette carte. Le joueur dont c\'est le tour se défausse de ses cartes jusqu\'à sa taille de main maximale. Les blessures disparaissent et les effets « ce tour » et « jusqu\'à la fin du tour » se terminent.)\\nAu début de votre prochaine étape de fin, vous perdez la partie.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427642&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32dbdfc8-5eed-487f-8e6b-2c3e53a7582d\', \'multiverseId\': 427642}, \'multiverseid\': 427642}, {\'name\': \'Fine Gloriosa\', \'text\': \'Fine del turno. (Esilia tutte le magie e le abilità in pila, compresa questa carta. Il giocatore di turno scarta carte fino ad avere in mano il suo limite massimo di carte. Il danno viene rimosso e terminano gli effetti "in questo turno" e "fino alla fine del turno".)\\nAll\\\'inizio della tua prossima sottofase finale, perdi la partita.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427911&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e41ab712-6d2c-46f4-b756-14bb10def0c7\', \'multiverseId\': 427911}, \'multiverseid\': 427911}, {\'name\': \'栄光の幕切れ\', \'text\': \'ターンを終了する。（このカードを含め、スタック領域にある呪文や能力をすべて追放する。現在のターンを進行しているプレイヤーは、カードを自分の手札の上限枚数になるまで捨てる。ダメージは消え、「このターン」と「ターン終了時まで」の効果は終わる。）\\n次のあなたの終了ステップの開始時に、あなたはこのゲームに敗北する。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428180&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a212a749-b779-458b-b02c-6f77cfba12ff\', \'multiverseId\': 428180}, \'multiverseid\': 428180}, {\'name\': \'영광스런 끝\', \'text\': \'턴을 종료한다. (이 카드를 포함하여 스택에 있는 모든 주문과 능력을 추방한다. 턴을 진행하는 플레이어는 최소 자신의 최대손크기만큼 버린다. 피해는 사라지고, "이 턴에" 및 "턴종료까지" 효과가 종료된다.)\\n당신의 다음 종료단 시작에, 당신은 게임에서 패배한다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428449&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6ae700de-c2a9-4a6c-9424-314f4384d479\', \'multiverseId\': 428449}, \'multiverseid\': 428449}, {\'name\': \'Fim Glorioso\', \'text\': \'Termine o turno. (Exile todas as mágicas e habilidades que estiverem na pilha, inclusive este card. O jogador controlador do turno descarta cards até atingir o número máximo de cards permitido em sua própria mão. O dano termina e efeitos que ocorrem "neste turno" e "até o final do turno" cessam.)\\nNo início de sua próxima etapa final, você perde o jogo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428718&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba186805-c49c-44bd-ac48-69ba2798c71e\', \'multiverseId\': 428718}, \'multiverseid\': 428718}, {\'name\': \'Славный Конец\', \'text\': \'Завершите ход. (Изгоните все заклинания и способности в стеке, в том числе и эту карту. Игрок, чей ход идет в данный момент, сбрасывает карты до максимального размера своей руки. Повреждения обнуляются, а действие всех эффектов, существующих «в этом ходу» и «до конца хода», прекращается.)\\nВ начале вашего следующего заключительного шага вы проигрываете партию.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428987&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3201cfa5-d9f4-4093-aadb-bb09b4cb45d7\', \'multiverseId\': 428987}, \'multiverseid\': 428987}, {\'name\': \'光荣就义\', \'text\': \'结束本回合。（放逐堆叠中所有咒语与异能，包括这张牌。轮到此回合的牌手将手牌弃至其手牌上限。生物上的伤害消失，并且注记着「本回合」与「直到回合结束」的效应均结束。）\\n在你的下一个结束步骤开始时，你输掉这盘游戏。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429256&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'32c206c5-cb7b-40ee-802e-c490f0a51a2c\', \'multiverseId\': 429256}, \'multiverseid\': 429256}, {\'name\': \'光榮就義\', \'text\': \'結束本回合。（放逐堆疊中所有咒語與異能，包括這張牌。輪到此回合的玩家將手牌棄至其手牌上限。生物上的傷害消失，並且註記著「本回合」與「直到回合結束」的效應均結束。）\\n在你的下一個結束步驟開始時，你輸掉這盤遊戲。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429525&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8d4e152b-e786-4040-894d-d4b181485cb5\', \'multiverseId\': 429525}, \'multiverseid\': 429525}]', '[{\'name\': \'Gluthorn-Minotaurus\', \'text\': \'Du kannst den Gluthorn-Minotaurus erschöpfen, sowie er angreift. Wenn du dies tust, erhält er +1/+1 und Bedrohlichkeit bis zum Ende des Zuges. (Eine erschöpfte Kreatur enttappt nicht während deines nächsten Enttappsegments.)\', \'type\': \'Kreatur — Minotaurus, Krieger\', \'flavor\': \'„Nur die Zwillingsspitzen von Hazorets Speer selbst vermögen mir Einhalt zu gebieten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427101&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55d4e980-c313-4c70-a71b-c2977592a9a5\', \'multiverseId\': 427101}, \'multiverseid\': 427101}, {\'name\': \'Minotauro cuernolumbre\', \'text\': \'Puedes espolear al Minotauro cuernolumbre en cuanto ataque. Cuando lo hagas, obtiene +1/+1 y gana la habilidad de amenaza hasta el final del turno. (Una criatura espoleada no se enderezará durante tu próximo paso de enderezar.)\', \'type\': \'Criatura — Guerrero minotauro\', \'flavor\': \'"Mis zancadas solo se detendrán contra las puntas gemelas de la lanza de Hazoret".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427370&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'91b8c991-b836-4f2b-86cb-1dd2a81ddcb9\', \'multiverseId\': 427370}, \'multiverseid\': 427370}, {\'name\': \'Minotaure cornebraise\', \'text\': "Vous pouvez surmener le Minotaure cornebraise au moment où il attaque. Quand vous faites ainsi, il gagne +1/+1 et acquiert la menace jusqu\'à la fin du tour. (Une créature surmenée ne se dégage pas pendant votre prochaine étape de dégagement.)", \'type\': \'Créature : minotaure et guerrier\', \'flavor\': "« Ma course ne s\'interrompra que contre la double pointe de la lance d\'Hazoret. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427639&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e23728b-2b4a-46b3-935d-a9ce8fefbae9\', \'multiverseId\': 427639}, \'multiverseid\': 427639}, {\'name\': \'Minotauro Cornardente\', \'text\': \'Puoi stremare il Minotauro Cornardente mentre attacca. Quando lo fai, prende +1/+1 e ha minacciare fino alla fine del turno. (Una creatura stremata non STAPpa durante il tuo prossimo STAP.)\', \'type\': \'Creatura — Guerriero Minotauro\', \'flavor\': \'"Mi fermerò solo davanti alla lancia a due punte di Hazoret."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427908&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65f3614a-6120-46fa-9792-be63d3fe222c\', \'multiverseId\': 427908}, \'multiverseid\': 427908}, {\'name\': \'燃えさし角のミノタウルス\', \'text\': \'燃えさし角のミノタウルスが攻撃するに際し、あなたはこれを督励してもよい。そうしたとき、ターン終了時まで、これは＋１/＋１の修整を受けるとともに威迫を得る。（督励されたクリーチャーは、あなたの次のアンタップ・ステップにアンタップしない。）\', \'type\': \'クリーチャー — ミノタウルス・戦士\', \'flavor\': \'「この突進が勝てぬのはハゾレト様の双叉槍のみ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428177&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'117930f1-7db3-4e1d-8896-1384756de348\', \'multiverseId\': 428177}, \'multiverseid\': 428177}, {\'name\': \'잉걸뿔 미노타우로스\', \'text\': \'당신은 잉걸뿔 미노타우로스로 공격을 선언하면서 잉걸뿔 미노타우로스를 분전시킬 수 있다. 그렇게 할 때, 잉걸뿔 미노타우로스는 턴종료까지 +1/+1을 받고 호전적을 얻는다. (분전한 생물은 당신의 다음 언탭단에 언탭되지 않는다.)\', \'type\': \'생물 — 미노타우로스 전사\', \'flavor\': \'"하조렛 창의 두 창끝만이 나의 걸음을 멈추게 할 수 있다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428446&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dd81a6da-f58a-4500-804f-f9081c065889\', \'multiverseId\': 428446}, \'multiverseid\': 428446}, {\'name\': \'Minotauro Brasocórneo\', \'text\': \'Você pode exaurir Minotauro Brasocórneo conforme ele ataca. Quando você faz isso, ele recebe +1/+1 e ganha ameaçar até o final do turno. (Uma criatura exaurida não será desvirada durante sua próxima etapa de desvirar.)\', \'type\': \'Criatura — Minotauro Guerreiro\', \'flavor\': \'"Minha marcha só se interromperá ante as pontas gêmeas da lança de Hazoret."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428715&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5707e4b-0188-4d7d-9d51-e7fb2bbd3fa7\', \'multiverseId\': 428715}, \'multiverseid\': 428715}, {\'name\': \'Минотавр Горящего Рога\', \'text\': \'Вы можете подстегнуть Минотавра Горящего Рога в момент его атаки. Когда вы это делаете, он получает +1/+1 и Угрозу до конца хода. (Подстегнутое существо не разворачивается во время вашего следующего шага разворота.)\', \'type\': \'Существо — Минотавр Воин\', \'flavor\': \'«Сбить меня с пути способно лишь двойное острие копья Хазорет».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428984&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39862f04-7818-469c-aede-3be4cd5917c8\', \'multiverseId\': 428984}, \'multiverseid\': 428984}, {\'name\': \'烬角牛头怪\', \'text\': \'你可以于烬角牛头怪攻击时耗竭之。当你如此作时，直到回合结束，它得+1/+1且获得威慑异能。（已耗竭的生物于你的下一个重置步骤中不能重置。）\', \'type\': \'生物～牛头怪／战士\', \'flavor\': \'「只有哈佐蕾长矛的双尖能打断我的冲锋。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429253&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2dd6cbc2-7dcc-457d-99ca-d781a0852974\', \'multiverseId\': 429253}, \'multiverseid\': 429253}, {\'name\': \'燼角牛頭怪\', \'text\': \'你可以於燼角牛頭怪攻擊時耗竭之。當你如此作時，直到回合結束，它得+1/+1且獲得威慑異能。（已耗竭的生物於你的下一個重置步驟中不能重置。）\', \'type\': \'生物～牛頭怪／戰士\', \'flavor\': \'「只有哈佐蕾長矛的雙尖能打斷我的衝鋒。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429522&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8573cff2-cad7-4b7d-8c45-bfea96ab0489\', \'multiverseId\': 429522}, \'multiverseid\': 429522}]', '[{\'name\': \'Glühender Pfeilhagel\', \'text\': \'Der Glühende Pfeilhagel fügt jeder Kreatur, die deine Gegner kontrollieren, 1 Schadenspunkt zu.\', \'type\': \'Hexerei\', \'flavor\': \'Die Pfeile fielen wie feuriger Regen und für einen kurzen Moment stand der Himmel in Flammen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427090&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'782d6568-157e-4a8c-9b56-83ee878770f5\', \'multiverseId\': 427090}, \'multiverseid\': 427090}, {\'name\': \'Descarga ardiente\', \'text\': \'La Descarga ardiente hace 1 punto de daño a cada criatura que controlan tus oponentes.\', \'type\': \'Conjuro\', \'flavor\': \'Las flechas cayeron como una lluvia de fuego y, por un instante, el mismo firmamento pareció arder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427359&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c78729d0-8bf0-43b1-9f79-9f81c3ca93c0\', \'multiverseId\': 427359}, \'multiverseid\': 427359}, {\'name\': \'Volée brûlante\', \'text\': \'La Volée brûlante inflige 1 blessure à chaque créature que vos adversaires contrôlent.\', \'type\': \'Rituel\', \'flavor\': "Les flèches s\'abattaient telles une pluie de feu, et l\'espace d\'un instant, le ciel lui-même sembla s\'embraser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427628&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88c6ccfb-0d81-4e38-84d9-ebe5ce4dcfc1\', \'multiverseId\': 427628}, \'multiverseid\': 427628}, {\'name\': \'Raffica Rovente\', \'text\': \'La Raffica Rovente infligge 1 danno a ogni creatura controllata dai tuoi avversari.\', \'type\': \'Stregoneria\', \'flavor\': \'Le frecce cadevano come pioggia incandescente e, per un istante, il cielo stesso sembrò ardere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427897&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecaba2d1-4b77-4260-93d0-9ab97310aef5\', \'multiverseId\': 427897}, \'multiverseid\': 427897}, {\'name\': \'猛火の斉射\', \'text\': \'猛火の斉射は対戦相手がコントロールする各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'火の雨のように矢が降ってきた。一瞬、空が燃えているようだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428166&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd7b5568-bcf2-49b2-b284-6879b3b3f4f4\', \'multiverseId\': 428166}, \'multiverseid\': 428166}, {\'name\': \'불화살 일제사격\', \'text\': \'불화살 일제사격은 당신의 상대들이 조종하는 각 생물에게 피해 1점을 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'화살이 화염비처럼 쏟아졌고, 순간 하늘이 불타는 듯 보였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428435&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d51e4539-48be-4d8c-a28f-0536e9971c51\', \'multiverseId\': 428435}, \'multiverseid\': 428435}, {\'name\': \'Salva Incandescente\', \'text\': \'Salva Incandescente causa 1 ponto de dano a cada criatura que seus oponentes controlam.\', \'type\': \'Feitiço\', \'flavor\': \'As flechas caíram como uma chuva de fogo e, por um momento, o próprio céu pareceu queimar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'722f65a3-7999-4eac-a88c-dc62df546d7e\', \'multiverseId\': 428704}, \'multiverseid\': 428704}, {\'name\': \'Пылающий Залп\', \'text\': \'Пылающий Залп наносит 1 повреждение каждому существу под контролем ваших оппонентов.\', \'type\': \'Волшебство\', \'flavor\': \'Стрелы падали огненным дождем, и на мгновение показалось, что горит все небо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428973&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'968c84c8-1017-4d83-86f1-275b8aa99bad\', \'multiverseId\': 428973}, \'multiverseid\': 428973}, {\'name\': \'烈焰齐射\', \'text\': \'烈焰齐射向由对手操控的每个生物各造成1点伤害。\', \'type\': \'法术\', \'flavor\': \'箭如火雨，瞬时仿佛整个天空都在燃烧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429242&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'650cf7ac-c7cb-4978-a076-4cb04d749be2\', \'multiverseId\': 429242}, \'multiverseid\': 429242}, {\'name\': \'烈焰齊射\', \'text\': \'烈焰齊射向由對手操控的每個生物各造成1點傷害。\', \'type\': \'巫術\', \'flavor\': \'箭如火雨，瞬時彷彿整個天空都在燃燒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429511&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3a5c802d-8a49-463a-a904-db5aae89164a\', \'multiverseId\': 429511}, \'multiverseid\': 429511}]', '[{\'name\': \'Gnadenlose Speerschleudererin\', \'text\': \'{2}, wirf eine Karte ab: Lege eine -1/-1-Marke auf eine Kreatur deiner Wahl. Die Kreatur kann in diesem Zug nicht blocken.\', \'type\': \'Kreatur — Minotaurus, Krieger\', \'flavor\': \'„Ich bin die Ruhe im Auge des Sturms, mein Speer ist der Blitz, der die Schwachen richtet."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427173&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d83e210-0645-41a5-94db-43270c747e2c\', \'multiverseId\': 427173}, \'multiverseid\': 427173}, {\'name\': \'Jabalinera sanguinaria\', \'text\': \'{2}, descartar una carta: Pon un contador -1/-1 sobre la criatura objetivo. Esa criatura no puede bloquear este turno.\', \'type\': \'Criatura — Guerrero minotauro\', \'flavor\': \'"Mi mente es la calma en mitad de la tormenta, y mi jabalina es el rayo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427442&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2f16333-74ac-4cc5-afdf-5c4b2fde0b26\', \'multiverseId\': 427442}, \'multiverseid\': 427442}, {\'name\': \'Javelinière impitoyable\', \'text\': "{2}, défaussez-vous d\'une carte : Mettez un marqueur -1/-1 sur la créature ciblée. Cette créature ne peut pas bloquer ce tour-ci.", \'type\': \'Créature : minotaure et guerrier\', \'flavor\': "« Mon esprit est le calme au milieu de la tempête, mon javelot en est l\'éclair. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7200cf3b-8cdc-4960-975c-433b05ec08e3\', \'multiverseId\': 427711}, \'multiverseid\': 427711}, {\'name\': \'Giavellottiera Spietata\', \'text\': \'{2}, Scarta una carta: Metti un segnalino -1/-1 su una creatura bersaglio. Quella creatura non può bloccare in questo turno.\', \'type\': \'Creatura — Guerriero Minotauro\', \'flavor\': \'"La mia mente è la calma nella tempesta e il mio giavellotto è il fulmine."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c43a5c40-a53d-40aa-9e1e-5afc24bcdf0a\', \'multiverseId\': 427980}, \'multiverseid\': 427980}, {\'name\': \'無慈悲な投槍手\', \'text\': \'{2}, カード１枚を捨てる：クリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。このターン、そのクリーチャーではブロックできない。\', \'type\': \'クリーチャー — ミノタウルス・戦士\', \'flavor\': \'「嵐のさなか我が心は平穏至極。我が槍こそは稲妻。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428249&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55d0f2b3-7f6b-4a48-a5f5-3f8b6229b825\', \'multiverseId\': 428249}, \'multiverseid\': 428249}, {\'name\': \'무자비한 투창병\', \'text\': \'{2}, 카드 한 장을 버린다: 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다. 그 생물은 이 턴에 방어할 수 없다.\', \'type\': \'생물 — 미노타우로스 전사\', \'flavor\': \'"내 마음은 폭풍 속의 고요와 같고, 내 투창은 번개와 같다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428518&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6228407d-5e58-4d67-8316-ba00a55f7c5d\', \'multiverseId\': 428518}, \'multiverseid\': 428518}, {\'name\': \'Zagaieira Impiedosa\', \'text\': \'{2}, Descarte um card: Coloque um marcador -1/-1 na criatura alvo. Aquela criatura não pode bloquear neste turno.\', \'type\': \'Criatura — Minotauro Guerreiro\', \'flavor\': \'"Minha mente é a calmaria em meio à tempestade, e minha azagaia, o raio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428787&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eed47e92-2a3c-4844-9e71-7c4be53620e4\', \'multiverseId\': 428787}, \'multiverseid\': 428787}, {\'name\': \'Безжалостная Копейщица\', \'text\': \'{2}, сбросьте карту: положите один жетон -1/-1 на целевое существо. То существо не может блокировать в этом ходу.\', \'type\': \'Существо — Минотавр Воин\', \'flavor\': \'«Мой разум — оплот спокойствия среди бури, а мое копье — молния».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429056&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e358474a-08ab-4333-a4da-40b6b83267d4\', \'multiverseId\': 429056}, \'multiverseid\': 429056}, {\'name\': \'无情掷枪手\', \'text\': \'{2}，弃一张牌：在目标生物上放置一个-1/-1指示物。该生物本回合不能进行阻挡。\', \'type\': \'生物～牛头怪／战士\', \'flavor\': \'「心如止水，矛若闪电。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429325&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9871001e-e795-454e-9c07-65b6c275f16a\', \'multiverseId\': 429325}, \'multiverseid\': 429325}, {\'name\': \'無情擲槍手\', \'text\': \'{2}，棄一張牌：在目標生物上放置一個-1/-1指示物。該生物本回合不能進行阻擋。\', \'type\': \'生物～牛頭怪／戰士\', \'flavor\': \'「心如止水，矛若閃電。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429594&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b80c9a45-3007-4ba9-8a06-4dc04b932236\', \'multiverseId\': 429594}, \'multiverseid\': 429594}]', '[{\'name\': \'Gnadenloser Scharfschütze\', \'text\': \'Immer wenn du eine Karte umwandelst oder abwirfst, kannst du {1} bezahlen. Falls du dies tust, lege eine -1/-1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Bogenschütze\', \'flavor\': \'„Das könnte jetzt kurz weh tun."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427076&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e9352b7-d67f-4a21-8d7a-f92760dd4769\', \'multiverseId\': 427076}, \'multiverseid\': 427076}, {\'name\': \'Tirador implacable\', \'text\': \'Siempre que actives una habilidad de ciclo o descartes una carta, puedes pagar {1}. Si lo haces, pon un contador -1/-1 sobre la criatura objetivo.\', \'type\': \'Criatura — Arquero humano\', \'flavor\': \'"Puede que notes un pequeño pinchazo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427345&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73a07eb3-4b2f-4e8e-a346-93386562da77\', \'multiverseId\': 427345}, \'multiverseid\': 427345}, {\'name\': \'Franc-tireur impitoyable\', \'text\': "À chaque fois que vous recyclez ou vous défaussez d\'une carte, vous pouvez payer {1}. Si vous faites ainsi, mettez un marqueur -1/-1 sur la créature ciblée.", \'type\': \'Créature : humain et archer\', \'flavor\': \'« Cela risque de piquer. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427614&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1318d732-4ae3-4b40-96d3-5ac3193aaead\', \'multiverseId\': 427614}, \'multiverseid\': 427614}, {\'name\': \'Cecchino Spietato\', \'text\': \'Ogniqualvolta cicli o scarti una carta, puoi pagare {1}. Se lo fai, metti un segnalino -1/-1 su una creatura bersaglio.\', \'type\': \'Creatura — Arciere Umano\', \'flavor\': \'"Potresti avvertire un leggero pizzico."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427883&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ece6a678-f861-4cbd-bfeb-65b79adad58e\', \'multiverseId\': 427883}, \'multiverseid\': 427883}, {\'name\': \'無情な狙撃手\', \'text\': \'あなたがカードを１枚サイクリングするか捨てるたび、あなたは{1}を支払ってもよい。そうしたなら、クリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'クリーチャー — 人間・射手\', \'flavor\': \'「微かな痛みを感じるかもしれない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428152&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b4720aa7-6a77-454c-af76-446aeef8b240\', \'multiverseId\': 428152}, \'multiverseid\': 428152}, {\'name\': \'무자비한 저격수\', \'text\': \'당신이 카드를 순환하거나 버릴 때마다, 당신은 {1}을 지불할 수 있다. 그렇게 한다면, 생물을 목표로 정한다. 그 생물에 -1/-1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 궁수\', \'flavor\': \'"살짝 따끔할 거야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428421&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3f0abb27-5e3a-40f5-80e2-975e329cfe4b\', \'multiverseId\': 428421}, \'multiverseid\': 428421}, {\'name\': \'Atirador Impiedoso\', \'text\': \'Toda vez que você recicla ou descarta um card, você pode pagar {1}. Se fizer isso, coloque um marcador -1/-1 na criatura alvo.\', \'type\': \'Criatura — Humano Arqueiro\', \'flavor\': \'"Você pode sentir uma leve picada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428690&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4fe0b8d2-40c7-412a-a622-ec7dc218d907\', \'multiverseId\': 428690}, \'multiverseid\': 428690}, {\'name\': \'Безжалостный Снайпер\', \'text\': \'Каждый раз, когда вы совершаете Цикл или сбрасываете карту, вы можете заплатить {1}. Если вы это делаете, положите один жетон -1/-1 на целевое существо.\', \'type\': \'Существо — Человек Лучник\', \'flavor\': \'«Вы можете почувствовать легкий укол».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428959&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ba9bb167-f3d8-4ae4-b2ae-9602f0cc21ac\', \'multiverseId\': 428959}, \'multiverseid\': 428959}, {\'name\': \'无情神箭手\', \'text\': \'每当你循环或弃一张牌时，你可以支付{1}。若你如此作，则在目标生物上放置一个-1/-1指示物。\', \'type\': \'生物～人类／弓箭手\', \'flavor\': \'「你或许会感到轻微的刺痛。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429228&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'10e8e927-0783-4535-9c03-94cba5ea0232\', \'multiverseId\': 429228}, \'multiverseid\': 429228}, {\'name\': \'無情神箭手\', \'text\': \'每當你循環或棄一張牌時，你可以支付{1}。若你如此作，則在目標生物上放置一個-1/-1指示物。\', \'type\': \'生物～人類／弓箭手\', \'flavor\': \'「你或許會感到輕微的刺痛。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429497&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'322f68dd-7dd0-4cb6-8dc0-b274484e7d5f\', \'multiverseId\': 429497}, \'multiverseid\': 429497}]', '[{\'name\': \'Grausame Realität\', \'text\': \'Verzaubert einen Spieler\\nZu Beginn des Versorgungssegments des verzauberten Spielers opfert der Spieler eine Kreatur oder einen Planeswalker. Falls der Spieler dies nicht kann, verliert er 5 Lebenspunkte.\', \'type\': \'Verzauberung — Aura, Fluch\', \'flavor\': \'Als Gideon sah, wie der Geweihte seinen Saatgefährten ermordete, wandelte sich seine Bewunderung für die Stadt Naktamun in blankes Entsetzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427055&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89ea210a-96f3-4e25-a432-a574299f718b\', \'multiverseId\': 427055}, \'multiverseid\': 427055}, {\'name\': \'Cruda realidad\', \'text\': \'Encantar jugador.\\nAl comienzo del mantenimiento del jugador encantado, ese jugador sacrifica una criatura o un planeswalker. Si no puede, ese jugador pierde 5 vidas.\', \'type\': \'Encantamiento — Aura maldición\', \'flavor\': \'Cuando Gideon fue testigo de cómo un iniciado asesinaba a su camarada de simiente, su admiración por la ciudad de Naktamun dio paso al horror.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427324&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'19c26830-0818-44c7-ae8f-99eaf131be70\', \'multiverseId\': 427324}, \'multiverseid\': 427324}, {\'name\': \'Réalité cruelle\', \'text\': "Enchanter : joueur\\nAu début de l\'entretien du joueur enchanté, ce joueur sacrifie une créature ou un planeswalker. Si ce joueur ne peut pas faire ainsi, il perd 5 points de vie.", \'type\': \'Enchantement : aura et malédiction\', \'flavor\': "Tandis que Gideon assistait au meurtre d\'un adepte par son compagnon de moisson, son admiration pour la ville de Naktamon se transforma en dégoût.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427593&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32989aae-dc0a-4caf-b12d-172c3b450e80\', \'multiverseId\': 427593}, \'multiverseid\': 427593}, {\'name\': \'Crudele Realtà\', \'text\': "Incanta giocatore\\nAll\'inizio del mantenimento del giocatore incantato, quel giocatore sacrifica una creatura o un planeswalker. Se non può farlo, quel giocatore perde 5 punti vita.", \'type\': \'Incantesimo — Aura Anatema\', \'flavor\': "Quando Gideon vide l\'iniziato uccidere un suo comessiano, l\'ammirazione per la città di Naktamun si tramutò in orrore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427862&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a339bc4-7e81-4177-9db6-61344d5c68e3\', \'multiverseId\': 427862}, \'multiverseid\': 427862}, {\'name\': \'残酷な現実\', \'text\': \'エンチャント（プレイヤー）\\nエンチャントされているプレイヤーのアップキープの開始時に、そのプレイヤーはクリーチャー１体かプレインズウォーカー１体を生け贄に捧げる。そうできないなら、そのプレイヤーは５点のライフを失う。\', \'type\': \'エンチャント — オーラ・呪い\', \'flavor\': \'その修練者が門友を殺害する場面を目撃して、ギデオンのナクタムンの街を敬愛する気持ちは恐怖へと変わった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428131&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6fa9b794-7894-4195-8ef6-11ba7da9a2a4\', \'multiverseId\': 428131}, \'multiverseid\': 428131}, {\'name\': \'잔혹한 현실\', \'text\': \'플레이어에게 부여\\n부여된 플레이어의 유지단 시작에, 그 플레이어는 생물 또는 플레인즈워커 한 개를 희생한다. 그렇게 할 수 없다면, 그 플레이어는 생명 5점을 잃는다.\', \'type\': \'부여마법 — 마법진 저주\', \'flavor\': \'입회자가 자신의 입문자 동료를 살해하는 것을 지켜본 후 나크타문에 대한 기디온의 감탄은 공포심으로 바뀌었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428400&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'84c70aea-36bf-4ac1-8d72-c9aa23439656\', \'multiverseId\': 428400}, \'multiverseid\': 428400}, {\'name\': \'Realidade Cruel\', \'text\': \'Encantar jogador\\nNo início da manutenção do jogador encantado, aquele jogador sacrifica uma criatura ou planeswalker. Se o jogador não puder, ele perde 5 pontos de vida.\', \'type\': \'Encantamento — Aura Maldição\', \'flavor\': \'Quando Gideon viu o iniciado assassinar seu colega de safra, sua admiração pela cidade de Nactamon transformou-se em horror.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428669&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5405fd56-0fb8-4463-a3cc-342eff3fe1f2\', \'multiverseId\': 428669}, \'multiverseid\': 428669}, {\'name\': \'Жестокая Реальность\', \'text\': \'Зачаровать игрока\\nВ начале шага поддержки зачарованного игрока тот игрок приносит в жертву существо или planeswalker-а. Если тот игрок не может этого сделать, он теряет 5 жизней.\', \'type\': \'Чары — Аура Проклятие\', \'flavor\': \'Гидеон смотрел, как послушник убивает своего брата по снопу, и его восхищение городом Нактамун уступало место ужасу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428938&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e3464e5e-030d-49f3-bdf5-932e99fe7e1a\', \'multiverseId\': 428938}, \'multiverseid\': 428938}, {\'name\': \'残酷现实\', \'text\': \'结附于牌手\\n在所结附之牌手的维持开始时，该牌手牺牲一个生物或鹏洛客。若该牌手无法如此作，则他失去5点生命。\', \'type\': \'结界～灵气／诅咒\', \'flavor\': \'当基定看到祀徒亲手杀害自己的群伴时，他对拿塔蒙城的敬仰转瞬就变成了恐惧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429207&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c88e1820-df16-4657-962a-447f6ca0f9ab\', \'multiverseId\': 429207}, \'multiverseid\': 429207}, {\'name\': \'殘酷現實\', \'text\': \'結附於玩家\\n在所結附之玩家的維持開始時，該玩家犧牲一個生物或鵬洛客。若該玩家無法如此作，則他失去5點生命。\', \'type\': \'結界～靈氣／詛咒\', \'flavor\': \'當基定看到祀徒親手殺害自己的群伴時，他對拿塔蒙城的敬仰轉瞬就變成了恐懼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429476&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d3568d92-c987-4313-8435-80ae0b7e26f7\', \'multiverseId\': 429476}, \'multiverseid\': 429476}]', '[{\'name\': \'Grenzen des Zusammenhalts\', \'text\': \'Übernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl. Enttappe die Kreatur. Sie erhält Eile bis zum Ende des Zuges.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'„Nur einer von euch kann triumphieren. Wer wird es sein?" —Hazoret, Göttin des Eifers\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427111&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4241962d-f7f7-426a-a424-4874d9d386e3\', \'multiverseId\': 427111}, \'multiverseid\': 427111}, {\'name\': \'Los límites de la solidaridad\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'"Cuando llegue el momento, solo uno de ustedes será honrado con mi lanza". —Hazoret, diosa del fervor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427380&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7cacd012-139e-40a3-ae22-a74cb235da7b\', \'multiverseId\': 427380}, \'multiverseid\': 427380}, {\'name\': \'Limites de la solidarité\', \'text\': "Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': "« Le moment venu, seul l\'un d\'entre vous recevra l\'honneur de ma lance. » —Hazoret, déesse du zèle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427649&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c47c937-1a85-4a03-a982-13d4e5183706\', \'multiverseId\': 427649}, \'multiverseid\': 427649}, {\'name\': \'Limiti della Fratellanza\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Quando sarà il momento, solo uno di voi verrà onorato dalla mia lancia." —Hazoret, dea dello zelo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427918&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f013692e-de71-406e-886b-23469085afdf\', \'multiverseId\': 427918}, \'multiverseid\': 427918}, {\'name\': \'結束の限界\', \'text\': \'クリーチャー１体を対象とし、ターン終了時まで、それのコントロールを得る。そのクリーチャーをアンタップする。ターン終了時まで、それは速攻を得る。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'「時が来れば、汝らのうちただ一人が我が槍により名誉を得る。」 ――激情の神、ハゾレト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428187&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'09796ec6-130f-45e9-ba13-92f125cd62ef\', \'multiverseId\': 428187}, \'multiverseid\': 428187}, {\'name\': \'결속의 한계\', \'text\': \'생물을 목표로 정한다. 턴종료까지 그 생물의 조종권을 얻는다. 그 생물은 언탭되고 턴종료까지 신속을 얻는다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'"때가 되면 너희 중 한 명만 내 창으로부터 영예를 얻는다." —열성의 신 하조렛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428456&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'76545ae9-9c19-4451-b90d-92284381f211\', \'multiverseId\': 428456}, \'multiverseid\': 428456}, {\'name\': \'Limites da Solidariedade\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'"Quando chegar a hora, somente um de vocês será honrado por minha lança." — Hazoret, deusa do zelo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428725&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f8adb41a-c35d-4c65-b53e-494a25114fad\', \'multiverseId\': 428725}, \'multiverseid\': 428725}, {\'name\': \'Граница Сплоченности\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'«Когда придет время, мое копье удостоит чести лишь одного из вас». — Хазорет, богиня рвения\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428994&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59af2b10-f9a4-4cd1-a708-f1a40d3185d0\', \'multiverseId\': 428994}, \'multiverseid\': 428994}, {\'name\': \'同伴反目\', \'text\': \'获得目标生物的操控权直到回合结束。重置该生物。它获得敏捷异能直到回合结束。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'「到时，我手中长矛只能赐予你们其中一人荣耀。」 ～热忱之神哈佐蕾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429263&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c55993e8-f022-4fd6-8853-ce06190713a3\', \'multiverseId\': 429263}, \'multiverseid\': 429263}, {\'name\': \'同伴反目\', \'text\': \'獲得目標生物的操控權直到回合結束。重置該生物。它獲得敏捷異能直到回合結束。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'「到時，我手中長矛只能賜予你們其中一人榮耀。」 ～熱忱之神哈佐蕾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429532&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e0ec614c-4ed2-4f71-8325-c3dee067a884\', \'multiverseId\': 429532}, \'multiverseid\': 429532}]', '[{\'name\': \'Grimmiger Schreiter\', \'text\': \'Der Grimmige Schreiter erhält -1/-1 für jede Karte auf deiner Hand.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'„Als Kind sah ich etwas am Horizont, weit hinter dem Hekma — dunkel wie ein Schatten, größer als ein Gott. Es verfolgt mich bis heute in meinen Träumen." —Pytamun, Geweihter der Nef-Saat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427065&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'412b0ce3-aa64-401c-b53d-5a9ae95cfd03\', \'multiverseId\': 427065}, \'multiverseid\': 427065}, {\'name\': \'Montaraz lúgubre\', \'text\': \'El Montaraz lúgubre obtiene -1/-1 por cada carta en tu mano.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"De niño vi algo que caminaba a lo lejos, más allá de la Hekma... Algo oscuro como las sombras, y más alto que los dioses. Incluso hoy lo veo caminar en mis sueños". —Pytamun, iniciado de la simiente Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427334&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69043da4-e302-4b49-a8db-08aa81fe95d1\', \'multiverseId\': 427334}, \'multiverseid\': 427334}, {\'name\': \'Enjambeur sinistre\', \'text\': "L\'Enjambeur sinistre gagne -1/-1 pour chaque carte dans votre main.", \'type\': \'Créature : horreur\', \'flavor\': "« Enfant, j\'ai vu quelque chose marcher au loin, au-delà de l\'Hekma. C\'était une ombre bien plus grande que les dieux. Aujourd\'hui encore, il m\'arrive de la voir en rêve. » —Pytamon, adepte de la moisson Nef", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427603&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9fe1003a-b217-4703-a7f2-6020c458af94\', \'multiverseId\': 427603}, \'multiverseid\': 427603}, {\'name\': \'Ramingo Macabro\', \'text\': \'Il Ramingo Macabro prende -1/-1 per ogni carta che hai in mano.\', \'type\': \'Creatura — Orrore\', \'flavor\': \'"Da bambino vidi qualcosa che camminava in lontananza, ben oltre l\\\'Hekma: oscuro come le tenebre e più alto delle divinità. Lo vedo ancora oggi in sogno." —Pytamun, iniziato della messe Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427872&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca75525e-60c3-4519-a1c4-59c719ed87ff\', \'multiverseId\': 427872}, \'multiverseid\': 427872}, {\'name\': \'不気味な徘徊者\', \'text\': \'不気味な徘徊者は、あなたの手札にあるカード１枚につき－１/－１の修整を受ける。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'「子供の頃ヘクマの遥か向こうを何かが歩いているのを見た。影のようにおぼろで神々よりも大きかった。今でも夢に見ることがある。」 ――ネフ一門の修練者、ピタムン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428141&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e2d6c6a-b3b6-4df0-a729-669a7c72f307\', \'multiverseId\': 428141}, \'multiverseid\': 428141}, {\'name\': \'죽음의 보행자\', \'text\': \'죽음의 보행자는 당신의 손에 있는 카드 수만큼 -1/-1을 받는다.\', \'type\': \'생물 — 괴수\', \'flavor\': \'"어렸을 때 헤크마 훨씬 너머에서 걸어 다니는 무언가를 보았는데, 그림자처럼 어둡고 신들보다 더 컸다. 그게 지금도 내 꿈속에 나타난다." —네프 입문자의 입회자 피타문\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428410&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1944fc5a-08a3-407f-820c-2226bff79714\', \'multiverseId\': 428410}, \'multiverseid\': 428410}, {\'name\': \'Andarilho Sinistro\', \'text\': \'Andarilho Sinistro recebe -1/-1 para cada card em sua mão.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"Quando era criança, eu vi alguma coisa andando ao longe, muito além da Hekma —escuro como as trevas e mais alto que os deuses. Ele ainda caminha pelos meus sonhos." — Pitamon, iniciado da safra Nef\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428679&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'77b45079-c9fa-414b-896f-6b65ab638d16\', \'multiverseId\': 428679}, \'multiverseid\': 428679}, {\'name\': \'Зловещий Бродяга\', \'text\': \'Зловещий Бродяга получает -1/-1 за каждую карту в вашей руке.\', \'type\': \'Существо — Ужас\', \'flavor\': \'«Еще ребенком я видел, как кто-то проходит вдалеке, далеко за Хекмой — громадная темная тень, выше, чем сами боги. И по сей день она заходит в мои сны». — Питамун, послушник снопа Неф\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428948&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6c5a9b2-9038-497d-accd-8959fb2fc168\', \'multiverseId\': 428948}, \'multiverseid\': 428948}, {\'name\': \'狰狞神行客\', \'text\': \'你每有一张手牌，狰狞神行客便得-1/-1。\', \'type\': \'生物～惊惧兽\', \'flavor\': \'「我小时候曾看见有个物体在避世帘外的远处游走～黑如阴影，高过神明。直到现在，它依然会飘过我的梦境。」 ～奈法祀群祀徒拜塔蒙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429217&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3c5f4f4-c912-4833-8c0c-578ccb1b8777\', \'multiverseId\': 429217}, \'multiverseid\': 429217}, {\'name\': \'猙獰神行客\', \'text\': \'你每有一張手牌，猙獰神行客便得-1/-1。\', \'type\': \'生物～驚懼獸\', \'flavor\': \'「我小時候曾看見有個物體在避世簾外的遠處遊走～黑如陰影，高過神明。直到現在，它依然會飄過我的夢境。」 ～奈法祀群祀徒拜塔蒙\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429486&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'25d5ed69-b489-4f6d-b194-4349c6bb744c\', \'multiverseId\': 429486}, \'multiverseid\': 429486}]', '[{\'name\': \'Großer Sandwurm\', \'text\': \'Der Große Sandwurm kann von Kreaturen mit Stärke 2 oder weniger nicht geblockt werden.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Ein Sandwurm kann mehrere Jahre lang versteckt im Sand liegen, bis die kleinste Erschütterung ihn aufweckt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427139&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57f2fb69-7346-4618-8834-c14cbbcde06b\', \'multiverseId\': 427139}, \'multiverseid\': 427139}, {\'name\': \'Gran sierpe de arena\', \'text\': \'La Gran sierpe de arena no puede ser bloqueada por criaturas con fuerza de 2 o menos.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'Una sierpe de arena puede esperar durante años bajo la arena hasta que la más pequeña vibración la alerta de la presencia de una presa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427408&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13c231fc-3707-4db9-9835-f830ce956ef0\', \'multiverseId\': 427408}, \'multiverseid\': 427408}, {\'name\': \'Grande guivre des sables\', \'text\': \'La Grande guivre des sables ne peut pas être bloquée par les créatures de force inférieure ou égale à 2.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Créature : guivre\', \'flavor\': "Une guivre des sables peut attendre des années sous le sable avant qu\'un minuscule tremblement ne l\'informe de la présence d\'une proie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427677&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8f279e0b-f3b5-4f13-8eed-4944fa607ab0\', \'multiverseId\': 427677}, \'multiverseid\': 427677}, {\'name\': \'Wurm Sabbioso Maggiore\', \'text\': \'Il Wurm Sabbioso Maggiore non può essere bloccato da creature con forza pari o inferiore a 2.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Creatura — Wurm\', \'flavor\': \'Un wurm sabbioso può restare in attesa per anni sotto la sabbia, fino a quando il più lieve sussulto non lo avvisa della presenza di una preda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427946&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d343ee5f-7495-4127-a5d9-04152815f567\', \'multiverseId\': 427946}, \'multiverseid\': 427946}, {\'name\': \'大いなるサンドワーム\', \'text\': \'大いなるサンドワームは、パワーが２以下のクリーチャーによってはブロックされない。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'サンドワームは何年間も砂の下にじっと潜み、微かな振動が餌の到着を知らせるのを待つ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428215&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8fdb45b7-a9ce-4fe8-9876-3117dfb43c2e\', \'multiverseId\': 428215}, \'multiverseid\': 428215}, {\'name\': \'대형 모래웜\', \'text\': \'대형 모래웜은 공격력이 2 이하인 생물에게 방어될 수 없다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'생물 — 웜\', \'flavor\': \'모래웜은 모래 밑에서 수년간 기다릴 수 있으며 자그마한 진동으로도 먹잇감의 존재를 알아챈다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428484&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'879a8a69-b27a-4a78-b03d-be2397ad116f\', \'multiverseId\': 428484}, \'multiverseid\': 428484}, {\'name\': \'Grão-vorme-da-areia\', \'text\': \'Grão-vorme-da-areia não pode ser bloqueado por criaturas com poder igual ou inferior a 2.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Criatura — Vorme\', \'flavor\': \'Um vorme-da-areia pode esperar sob as areias por anos até que um suave tremor o alerte sobre a presença de uma presa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'43ee1855-de13-4490-9e61-a8b706d363bd\', \'multiverseId\': 428753}, \'multiverseid\': 428753}, {\'name\': \'Гигантский Песчаный Вурм\', \'text\': \'Гигантский Песчаный Вурм не может быть заблокирован существами с силой 2 или меньше.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Существо — Вурм\', \'flavor\': \'Песчаный вурм может годами недвижимо ждать, зарывшись в песок, пока чуть заметная дрожь земли не возвестит о приближении жертвы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429022&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0e22411a-044f-41f4-a65f-7050c4acb0e4\', \'multiverseId\': 429022}, \'multiverseid\': 429022}, {\'name\': \'高大沙丘亚龙\', \'text\': \'高大沙丘亚龙不能被力量等于或小于2的生物阻挡。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'生物～亚龙\', \'flavor\': \'沙丘亚龙可蛰伏黄沙之中长达数年之久，猎物稍有动静都能引其现身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429291&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93747781-fe09-4ee8-9922-e54182aa75a9\', \'multiverseId\': 429291}, \'multiverseid\': 429291}, {\'name\': \'高大沙丘亞龍\', \'text\': \'高大沙丘亞龍不能被力量等於或小於2的生物阻擋。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'生物～亞龍\', \'flavor\': \'沙丘亞龍可蟄伏黃沙之中長達數年之久，獵物稍有動靜都能引其現身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429560&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'afa86721-9478-48a8-a654-737e37ca3fdb\', \'multiverseId\': 429560}, \'multiverseid\': 429560}]', '[{\'name\': \'Gruft des Orakels\', \'text\': \'{2}, {T}: Schicke die oberste Karte deiner Bibliothek ins Exil. Bis zum Ende des Zuges kannst du sie spielen. Lege eine Ziegelmarke auf die Gruft des Orakels.\\n{T}: Schicke die oberste Karte deiner Bibliothek ins Exil. Bis zum Ende des Zuges kannst du sie spielen, ohne ihre Manakosten zu bezahlen. Aktiviere diese Fähigkeit nur, falls sich drei oder mehr Ziegelmarken auf der Gruft des Orakels befinden.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427205&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'62d0b548-4a80-4468-919c-5c2f9df9d428\', \'multiverseId\': 427205}, \'multiverseid\': 427205}, {\'name\': \'Cámara del oráculo\', \'text\': \'{2}, {T}: Exilia la primera carta de tu biblioteca. Hasta el final del turno, puedes jugar esa carta. Pon un contador de bloque sobre la Cámara del oráculo.\\n{T}: Exilia la primera carta de tu biblioteca. Hasta el final del turno, puedes jugar esa carta sin pagar su coste de maná. Activa esta habilidad solo si hay tres o más contadores de bloque sobre la Cámara del oráculo.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427474&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'05b9ea2d-e43b-419d-b9a4-c2f377ade617\', \'multiverseId\': 427474}, \'multiverseid\': 427474}, {\'name\': "Caveau de l\'oracle", \'text\': "{2}, {T} : Exilez la carte du dessus de votre bibliothèque. Jusqu\'à la fin du tour, vous pouvez jouer cette carte. Mettez un marqueur « brique » sur le Caveau de l\'oracle.\\n{T} : Exilez la carte du dessus de votre bibliothèque. Jusqu\'à la fin du tour, vous pouvez jouer cette carte sans payer son coût de mana. N\'activez cette capacité que s\'il y a au moins trois marqueurs « brique » sur le Caveau de l\'oracle.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427743&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b300728a-bcde-4a12-a89e-6631b067848e\', \'multiverseId\': 427743}, \'multiverseid\': 427743}, {\'name\': "Cripta dell\'Oracolo", \'text\': "{2}, {T}: Esilia la prima carta del tuo grimorio. Fino alla fine del turno, puoi giocare quella carta. Metti un segnalino mattone sulla Cripta dell\'Oracolo.\\n{T}: Esilia la prima carta del tuo grimorio. Fino alla fine del turno, puoi giocare quella carta senza pagare il suo costo di mana. Attiva questa abilità solo se ci sono tre o più segnalini mattone sulla Cripta dell\'Oracolo.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428012&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'67dcf9be-63dd-4421-a246-e328dc27045a\', \'multiverseId\': 428012}, \'multiverseid\': 428012}, {\'name\': \'神託者の大聖堂\', \'text\': \'{2}, {T}：あなたのライブラリーの一番上のカードを追放する。ターン終了時まで、あなたはそのカードをプレイしてもよい。神託者の大聖堂の上に石材カウンターを１個置く。\\n{T}：あなたのライブラリーの一番上のカードを追放する。ターン終了時まで、あなたはそのカードをそのマナ・コストを支払うことなくプレイしてもよい。この能力は、神託者の大聖堂の上に石材カウンターが３個以上置かれているときにのみ起動できる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428281&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92583df1-ea1d-4bc3-9c3c-7113e7ffce83\', \'multiverseId\': 428281}, \'multiverseid\': 428281}, {\'name\': \'예언자의 저장고\', \'text\': \'{2}, {T}: 당신의 서고 맨 위의 카드를 추방한다. 턴종료까지, 당신은 그 카드를 플레이할 수 있다. 예언자의 저장고에 벽돌 카운터 한 개를 올려놓는다.\\n{T}: 당신의 서고 맨 위의 카드를 추방한다. 당신은 턴종료까지 마나 비용을 지불하지 않고 그 카드를 플레이할 수 있다. 예언자의 저장고에 벽돌 카운터가 세 개 이상 있는 경우에만 이 능력을 활성화할 수 있다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428550&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7f28fcb1-6431-4604-a934-619eb3b79d04\', \'multiverseId\': 428550}, \'multiverseid\': 428550}, {\'name\': \'Câmara do Oráculo\', \'text\': \'{2}, {T}: Exile o card do topo de seu grimório. Até o final do turno, você pode jogar aquele card. Coloque um marcador de tijolo em Câmara do Oráculo.\\n{T}: Exile o card do topo de seu grimório. Até o final do turno, você pode jogar aquele card sem pagar seu custo de mana. Ative esta habilidade somente se houver três ou mais marcadores de tijolo em Câmara do Oráculo.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428819&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f27700dc-7da3-4a3b-abe1-161714b3ad01\', \'multiverseId\': 428819}, \'multiverseid\': 428819}, {\'name\': \'Сокровищница Оракула\', \'text\': \'{2}, {T}: изгоните верхнюю карту вашей библиотеки. До конца хода вы можете разыграть ту карту. Положите один жетон кирпича на Сокровищницу Оракула.\\n{T}: изгоните верхнюю карту вашей библиотеки. До конца хода вы можете разыграть ту карту без уплаты ее мана-стоимости. Активируйте эту способность, только если на Сокровищнице Оракула есть не менее трех жетонов кирпича.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429088&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5888ddba-b908-4de9-9de4-886d9180c7cf\', \'multiverseId\': 429088}, \'multiverseid\': 429088}, {\'name\': \'先知秘窖\', \'text\': \'{2}，{T}：放逐你的牌库顶牌。直到回合结束，你可以使用该牌。在先知秘窖上放置一个石砖指示物。\\n{T}：放逐你的牌库顶牌。直到回合结束，你可以使用该牌且不需支付其法术力费用。只能于先知秘窖上有三个或更多石砖指示物时起动此异能。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429357&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'57dadf0f-d43a-44b2-883e-ade6117ab7e3\', \'multiverseId\': 429357}, \'multiverseid\': 429357}, {\'name\': \'先知秘窖\', \'text\': \'{2}，{T}：放逐你的牌庫頂牌。直到回合結束，你可以使用該牌。在先知秘窖上放置一個石磚指示物。\\n{T}：放逐你的牌庫頂牌。直到回合結束，你可以使用該牌且不需支付其魔法力費用。只能於先知秘窖上有三個或更多石磚指示物時起動此異能。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429626&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6dbe2683-f4de-418a-a5e1-89cacdc478ab\', \'multiverseId\': 429626}, \'multiverseid\': 429626}]', '[{\'name\': \'Gunst der Hazoret\', \'text\': \'Zu Beginn des Kampfes in deinem Zug kannst du eine Kreatur deiner Wahl, die du kontrollierst, bis zum Ende des Zuges +2/+0 und Eile erhalten lassen. Falls du dies tust, opfere sie zu Beginn des nächsten Endsegments.\', \'type\': \'Verzauberung\', \'flavor\': \'Hazorets Segen erhält man nur einmal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427108&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f3069131-2bf4-446f-8275-bf0a73172f90\', \'multiverseId\': 427108}, \'multiverseid\': 427108}, {\'name\': \'Favor de Hazoret\', \'text\': \'Al comienzo del combate en tu turno, puedes hacer que la criatura objetivo que controlas obtenga +2/+0 y gane la habilidad de prisa hasta el final del turno. Si lo haces, sacrifícala al comienzo del próximo paso final.\', \'type\': \'Encantamiento\', \'flavor\': \'Hazoret solo bendice una vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427377&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f94a6f35-159b-4351-8b4e-2e47e63187d6\', \'multiverseId\': 427377}, \'multiverseid\': 427377}, {\'name\': "Faveur d\'Hazoret", \'text\': "Au début du combat pendant votre tour, vous pouvez faire qu\'une créature ciblée que vous contrôlez gagne +2/+0 et acquière la célérité jusqu\'à la fin du tour. Si vous faites ainsi, sacrifiez-la au début de la prochaine étape de fin.", \'type\': \'Enchantement\', \'flavor\': "Le don d\'Hazoret n\'est accordé qu\'une fois.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427646&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'375e2a82-d4ea-4652-8df2-885a45a6fb97\', \'multiverseId\': 427646}, \'multiverseid\': 427646}, {\'name\': \'Benevolenza di Hazoret\', \'text\': "All\'inizio del combattimento nel tuo turno, puoi far prendere +2/+0 a una creatura bersaglio che controlli e farle guadagnare rapidità fino alla fine del turno. Se lo fai, sacrificala all\'inizio della prossima sottofase finale.", \'type\': \'Incantesimo\', \'flavor\': \'Il dono di Hazoret viene conferito una sola volta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427915&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'865eb8b3-9dfa-49de-b06b-3a33f5321390\', \'multiverseId\': 427915}, \'multiverseid\': 427915}, {\'name\': \'ハゾレトの指名\', \'text\': \'あなたのターンの戦闘の開始時に、あなたがコントロールするクリーチャー１体を対象とする。あなたは「ターン終了時まで、それは＋２/＋０の修整を受けるとともに速攻を得る。」を選んでもよい。そうしたなら、次の終了ステップの開始時に、それを生け贄に捧げる。\', \'type\': \'エンチャント\', \'flavor\': \'ハゾレトの加護は一度のみである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428184&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe9769cc-af80-4b01-892f-76d34b9e2ed7\', \'multiverseId\': 428184}, \'multiverseid\': 428184}, {\'name\': \'하조렛의 편애\', \'text\': \'당신 턴의 전투 시작에, 당신이 조종하는 생물을 목표로 정한다. 당신은 그 생물이 턴종료까지 +2/+0을 받고 신속을 얻도록 할 수 있다. 그렇게 한다면, 다음 종료단 시작에 그 생물을 희생한다.\', \'type\': \'부여마법\', \'flavor\': \'하조렛의 선물은 딱 한 번만 주어진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428453&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f9772c7d-3388-4ba4-9274-993d6981e72f\', \'multiverseId\': 428453}, \'multiverseid\': 428453}, {\'name\': \'Favor de Hazoret\', \'text\': \'No início do combate em seu turno, você pode fazer com que a criatura alvo que você controla receba +2/+0 e ganhe ímpeto até o final do turno. Se fizer isso, sacrifique aquela criatura no início da próxima etapa final.\', \'type\': \'Encantamento\', \'flavor\': \'A dádiva de Hazoret é concedida uma única vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428722&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4cae6fe6-6022-4813-8237-1f1dbd6cddc1\', \'multiverseId\': 428722}, \'multiverseid\': 428722}, {\'name\': \'Милость Хазорет\', \'text\': \'В начале боя во время вашего хода вы можете дать целевому существу под вашим контролем +2/+0 и Ускорение до конца хода. Если вы это делаете, пожертвуйте его в начале следующего заключительного шага.\', \'type\': \'Чары\', \'flavor\': \'Дар Хазорет можно получить лишь один раз.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428991&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'731b47d5-1e62-41f7-b660-7a814d4d2028\', \'multiverseId\': 428991}, \'multiverseid\': 428991}, {\'name\': \'哈佐蕾的眷顾\', \'text\': \'在你回合的战斗开始时，你可以让目标由你操控的生物得+2/+0且获得敏捷异能直到回合结束。若你如此作，则在下一个结束步骤开始时，将它牺牲。\', \'type\': \'结界\', \'flavor\': \'哈佐蕾的赋礼只给一次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429260&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7bcb820d-d4de-4e53-a229-fc5fe6f2bf89\', \'multiverseId\': 429260}, \'multiverseid\': 429260}, {\'name\': \'哈佐蕾的眷顧\', \'text\': \'在你回合的戰鬥開始時，你可以讓目標由你操控的生物得+2/+0且獲得敏捷異能直到回合結束。若你如此作，則在下一個結束步驟開始時，將它犧牲。\', \'type\': \'結界\', \'flavor\': \'哈佐蕾的賦禮只給一次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429529&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'24ca9c37-431f-4449-b236-5e53acf6ef1d\', \'multiverseId\': 429529}, \'multiverseid\': 429529}]', '[{\'name\': \'Hapatra, Wesirin der Gifte\', \'text\': \'Immer wenn Hapatra, Wesirin der Gifte, einem Spieler Kampfschaden zufügt, kannst du eine -1/-1-Marke auf eine Kreatur deiner Wahl legen.\\nImmer wenn du eine oder mehrere -1/-1-Marken auf eine Kreatur legst, erzeuge einen 1/1 grünen Ophis-Kreaturenspielstein mit Todesberührung.\', \'type\': \'Legendäre Kreatur — Mensch, Kleriker\', \'flavor\': \'Ihr fast unmerkliches Lächeln ist selbst wie süßes Gift.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427170&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a936efc-e4bf-4df1-b947-4fd7f6bff2a2\', \'multiverseId\': 427170}, \'multiverseid\': 427170}, {\'name\': \'Hapatra, visir de los venenos\', \'text\': \'Siempre que Hapatra, visir de los venenos haga daño de combate a un jugador, puedes poner un contador -1/-1 sobre la criatura objetivo.\\nSiempre que pongas uno o más contadores -1/-1 sobre una criatura, crea una ficha de criatura Víbora verde 1/1 con la habilidad de toque mortal.\', \'type\': \'Criatura legendaria — Clérigo humano\', \'flavor\': \'Incluso su sutil sonrisa es ponzoñosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427439&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e8716523-6e2f-4cfe-96e7-fcfe71141e91\', \'multiverseId\': 427439}, \'multiverseid\': 427439}, {\'name\': \'Hapatra, vizir des poisons\', \'text\': "À chaque fois qu\'Hapatra, vizir des poisons inflige des blessures de combat à un joueur, vous pouvez mettre un marqueur -1/-1 sur une créature ciblée.\\nÀ chaque fois que vous mettez au moins un marqueur -1/-1 sur une créature, créez un jeton de créature 1/1 verte Serpent avec le contact mortel.", \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': \'Son léger sourire est empreint de venin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427708&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'91aae991-7e23-4af3-b762-ae1cdc644a59\', \'multiverseId\': 427708}, \'multiverseid\': 427708}, {\'name\': \'Hapatra, Visir dei Veleni\', \'text\': \'Ogniqualvolta Hapatra, Visir dei Veleni infligge danno da combattimento a un giocatore, puoi mettere un segnalino -1/-1 su una creatura bersaglio.\\nOgniqualvolta metti uno o più segnalini -1/-1 su una creatura, crea una pedina creatura Serpente 1/1 verde con tocco letale.\', \'type\': \'Creatura Leggendaria — Chierico Umano\', \'flavor\': \'Il suo impercettibile sorriso è impregnato di veleno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427977&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ad6f18c-050f-4b8e-af32-bcdda091802f\', \'multiverseId\': 427977}, \'multiverseid\': 427977}, {\'name\': \'毒物の侍臣、ハパチラ\', \'text\': \'毒物の侍臣、ハパチラがプレイヤー１人に戦闘ダメージを与えるたび、クリーチャー１体を対象とする。あなたはそれの上に－１/－１カウンターを１個置いてもよい。\\nあなたがクリーチャー１体の上に－１/－１カウンターを１個以上置くたび、接死を持つ緑の１/１の蛇・クリーチャー・トークンを１体生成する。\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': \'その謎めいた笑顔には毒気が満ちている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428246&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b4086271-1513-45fd-b5e1-914970ce6cbd\', \'multiverseId\': 428246}, \'multiverseid\': 428246}, {\'name\': \'독의 고관 하파트라\', \'text\': \'독의 고관 하파트라가 플레이어에게 전투피해를 입힐 때마다, 생물을 목표로 정한다. 당신은 그 생물에 -1/-1 카운터 한 개를 올려놓을 수 있다.\\n당신이 생물에 -1/-1 카운터를 한 개 이상 올려놓을 때마다, 치명타를 가진 1/1 녹색 뱀 생물 토큰 한 개를 만든다.\', \'type\': \'전설적 생물 — 인간 성직자\', \'flavor\': \'그녀의 미묘한 미소에는 독이 깃들어 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428515&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d4971857-e264-47f6-abec-cb3fe6593e69\', \'multiverseId\': 428515}, \'multiverseid\': 428515}, {\'name\': \'Hapatra, Vizir dos Venenos\', \'text\': \'Toda vez que Hapatra, Vizir dos Venenos, causa dano de combate a um jogador, você pode colocar um marcador -1/-1 na criatura alvo.\\nToda vez que você colocar um ou mais marcadores -1/-1 em uma criatura, crie uma ficha de criatura verde 1/1 do tipo Cobra com toque mortífero.\', \'type\': \'Criatura Lendária — Humano Clérigo\', \'flavor\': \'A peçonha impregna seu sorriso sutil.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1ec464b4-1510-4d7a-85d6-d3eea1250939\', \'multiverseId\': 428784}, \'multiverseid\': 428784}, {\'name\': \'Хапатра, Визирь Ядов\', \'text\': \'Каждый раз, когда Хапатра, Визирь Ядов наносит боевые повреждения игроку, вы можете положить один жетон -1/-1 на целевое существо.\\nКаждый раз, когда вы кладете на существо один или более жетонов -1/-1, создайте одну фишку существа 1/1 зеленая Змея со Смертельным касанием.\', \'type\': \'Легендарное Существо — Человек Священник\', \'flavor\': \'Ее едва заметная улыбка пропитана ядом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429053&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8356e4b4-d658-458f-a57b-0e2bc09624f3\', \'multiverseId\': 429053}, \'multiverseid\': 429053}, {\'name\': \'司毒维齐尔哈芭恰\', \'text\': \'每当司毒维齐尔哈芭恰对任一牌手造成战斗伤害时，你可以在目标生物上放置一个-1/-1指示物。\\n每当你在一个生物上放置一个或数个-1/-1指示物时，派出一个1/1绿色，具死触异能的蛇衍生生物。\', \'type\': \'传奇生物～人类／僧侣\', \'flavor\': \'她的诡秘笑容潜藏剧毒杀机。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429322&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'56aadd32-c430-4a4b-b2e5-410b530d7619\', \'multiverseId\': 429322}, \'multiverseid\': 429322}, {\'name\': \'司毒維齊爾哈芭恰\', \'text\': \'每當司毒維齊爾哈芭恰對任一玩家造成戰鬥傷害時，你可以在目標生物上放置一個-1/-1指示物。\\n每當你在一個生物上放置一個或數個-1/-1指示物時，派出一個1/1綠色，具死觸異能的蛇衍生生物。\', \'type\': \'傳奇生物～人類／僧侶\', \'flavor\': \'她的詭祕笑容潛藏劇毒殺機。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429591&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e424e6dd-57eb-427a-b8ce-b499ade66bd8\', \'multiverseId\': 429591}, \'multiverseid\': 429591}]', '[{\'name\': \'Hapatras Mal\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält Fluchsicherheit bis zum Ende des Zuges. Entferne alle -1/-1-Marken von ihr. (Eine Kreatur mit Fluchsicherheit kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Jedes fremde Gift ist ein Freund, den du nur noch nicht kennengelernt hast." —Hapatra, Wesirin der Gifte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427140&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6373d213-a9b0-4a13-bd08-3aee9a6b216c\', \'multiverseId\': 427140}, \'multiverseid\': 427140}, {\'name\': \'Marca de Hapatra\', \'text\': \'La criatura objetivo que controlas gana la habilidad de antimaleficio hasta el final del turno. Remueve todos los contadores -1/-1 de ella. (Una criatura con la habilidad de antimaleficio no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Si temes a los venenos es porque no los conoces bien". —Hapatra, visir de los venenos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'75b5610d-537f-4645-9586-277ee11f546e\', \'multiverseId\': 427409}, \'multiverseid\': 427409}, {\'name\': "Marque d\'Hapatra", \'text\': "La créature ciblée que vous contrôlez acquiert la défense talismanique jusqu\'à la fin du tour. Retirez tous les marqueurs -1/-1 sur elle. (Une créature avec la défense talismanique ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)", \'type\': \'Éphémère\', \'flavor\': "« Si vous craignez les poisons, c\'est que vous ne les connaissez pas. » —Hapatra, vizir des poisons", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427678&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b6ce76a-d602-4ad1-b2d2-50cbd87a3958\', \'multiverseId\': 427678}, \'multiverseid\': 427678}, {\'name\': \'Marchio di Hapatra\', \'text\': \'Una creatura bersaglio che controlli ha anti-malocchio fino alla fine del turno. Rimuovi da essa tutti i segnalini -1/-1. (Una creatura con anti-malocchio non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Se temi i veleni, significa che non li conosci." —Hapatra, visir dei veleni\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427947&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'deb0e7c7-e303-4ee6-90f6-1519b2f8c81c\', \'multiverseId\': 427947}, \'multiverseid\': 427947}, {\'name\': \'ハパチラの刻印\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とする。ターン終了時まで、それは呪禁を得る。それの上から－１/－１カウンターをすべて取り除く。（呪禁を持つクリーチャーは、対戦相手がコントロールする呪文や能力の対象にならない。）\', \'type\': \'インスタント\', \'flavor\': \'「毒を恐れるのは毒を知らないからよ。」 ――毒物の侍臣、ハパチラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428216&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b4fee13e-0283-4810-9da4-76efe2ba351f\', \'multiverseId\': 428216}, \'multiverseid\': 428216}, {\'name\': \'하파트라의 표식\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 방호를 얻는다. 그 생물에서 -1/-1 카운터를 모두 제거한다. (방호를 가진 생물은 상대가 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\', \'type\': \'순간마법\', \'flavor\': \'"독이 두려운 이유는 독에 대해 무지하기 때문이다." —독의 고관 하파트라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428485&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c055a5c-6367-4113-ad9b-5f025e9e755d\', \'multiverseId\': 428485}, \'multiverseid\': 428485}, {\'name\': \'Marca de Hapatra\', \'text\': \'A criatura alvo que você controla recebe resistência a magia até o final do turno. Remova todos os marcadores -1/-1 dela. (Uma criatura com resistência a magia não pode ser alvo de mágicas nem de habilidades controladas por seus oponentes.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Se você teme venenos é porque não os conhece bem." — Hapatra, vizir dos venenos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428754&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ae61f92-8efa-41bd-9c89-9f040b647353\', \'multiverseId\': 428754}, \'multiverseid\': 428754}, {\'name\': \'Метка Хапатры\', \'text\': \'Целевое существо под вашим контролем получает Порчеустойчивость до конца хода. Удалите с него все жетоны -1/-1. (Существо с Порчеустойчивостью не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ты боишься ядов? Это потому, что ты ничего не знаешь о них». — Хапатра, визирь ядов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429023&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c59db592-708b-4685-a7a0-f3ef2b1c7683\', \'multiverseId\': 429023}, \'multiverseid\': 429023}, {\'name\': \'哈芭恰的印记\', \'text\': \'目标由你操控的生物获得辟邪异能直到回合结束。移去其上所有的-1/-1指示物。（具辟邪异能的生物不能成为由对手操控之咒语或异能的目标。）\', \'type\': \'瞬间\', \'flavor\': \'「倘若你对毒物心存恐惧，全因你对其一无所知。」 ～司毒维齐尔哈芭恰\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429292&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7f8c49a-e937-4a15-a591-11558a255d0b\', \'multiverseId\': 429292}, \'multiverseid\': 429292}, {\'name\': \'哈芭恰的印記\', \'text\': \'目標由你操控的生物獲得辟邪異能直到回合結束。移去其上所有的-1/-1指示物。（具辟邪異能的生物不能成為由對手操控之咒語或異能的目標。）\', \'type\': \'瞬間\', \'flavor\': \'「倘若你對毒物心存恐懼，全因你對其一無所知。」 ～司毒維齊爾哈芭恰\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429561&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cb0cade7-0ad8-46f4-b155-5a2a7f16fa1a\', \'multiverseId\': 429561}, \'multiverseid\': 429561}]', '[{\'name\': \'Harscher Mentor\', \'text\': \'Immer wenn ein Gegner eine Fähigkeit eines Artefakts, einer Kreatur oder eines Landes im Spiel aktiviert und falls es keine Manafähigkeit ist, fügt der Harsche Mentor dem Spieler 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Stell dich nicht so an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427106&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f9c171cb-d7b6-42e6-b5df-c1fa00155efc\', \'multiverseId\': 427106}, \'multiverseid\': 427106}, {\'name\': \'Mentor riguroso\', \'text\': \'Siempre que un oponente active una habilidad de un artefacto, criatura o tierra en el campo de batalla, si no es una habilidad de maná, el Mentor riguroso hace 2 puntos de daño a ese jugador.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Ábrete camino".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427375&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe9656f8-92a6-4e30-a7b0-855f2d138713\', \'multiverseId\': 427375}, \'multiverseid\': 427375}, {\'name\': \'Mentor exigeant\', \'text\': "À chaque fois qu\'un adversaire active une capacité d\'un artefact, d\'une créature ou d\'un terrain sur le champ de bataille, si ce n\'est pas une capacité de mana, le Mentor exigeant inflige 2 blessures à ce joueur.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Battez-vous pour vous en sortir. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427644&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b950442-2960-46d1-a341-4782e29641e4\', \'multiverseId\': 427644}, \'multiverseid\': 427644}, {\'name\': \'Mentore Severo\', \'text\': "Ogniqualvolta un avversario attiva un\'abilità di un artefatto, una creatura o una terra sul campo di battaglia, se non è un\'abilità di mana, il Mentore Severo infligge 2 danni a quel giocatore.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Combattete fino all\\\'ultimo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427913&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'45f6daa0-64bb-4410-a8ee-6ac92103d878\', \'multiverseId\': 427913}, \'multiverseid\': 427913}, {\'name\': \'過酷な指導者\', \'text\': \'対戦相手が戦場にあるアーティファクトかクリーチャーか土地の能力を１つ起動するたび、それがマナ能力でない場合、過酷な指導者はそのプレイヤーに２点のダメージを与える。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「戦い抜け。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428182&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5d47ac3-bac3-468f-bcb7-23481e43f7dc\', \'multiverseId\': 428182}, \'multiverseid\': 428182}, {\'name\': \'가혹한 스승\', \'text\': \'상대가 전장에 있는 마법물체, 생물 또는 대지의 능력을 활성화할 때마다, 그 능력이 마나 능력이 아니라면, 가혹한 스승은 그 플레이어에게 피해 2점을 입힌다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"싸워서 통과해라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428451&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c827592a-6a3b-42f6-a26c-b4ae126822af\', \'multiverseId\': 428451}, \'multiverseid\': 428451}, {\'name\': \'Mentor Austero\', \'text\': \'Toda vez que um oponente ativa uma habilidade de um artefato, criatura ou terreno no campo de batalha, se essa não é uma habilidade de mana, Mentor Austero causa 2 pontos de dano àquele jogador.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Abra seu caminho lutando."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428720&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48c90cf4-317c-4702-81a2-b293a8de18bc\', \'multiverseId\': 428720}, \'multiverseid\': 428720}, {\'name\': \'Строгий Наставник\', \'text\': \'Каждый раз, когда оппонент активирует способность артефакта, существа или земли на поле битвы, если это не мана-способность, то Строгий Наставник наносит 2 повреждения тому игроку.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Дерись и преодолей».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428989&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec51f6a8-7d53-4805-b3d8-b0b2ff0d461a\', \'multiverseId\': 428989}, \'multiverseid\': 428989}, {\'name\': \'严厉明师\', \'text\': \'每当任一对手起动战场上任一神器、生物或地的起动式异能时，若其不是法术力异能，则严厉明师对该牌手造成2点伤害。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「熬过去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429258&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1f1d089f-9184-4fbb-8767-5fc0ff6459d4\', \'multiverseId\': 429258}, \'multiverseid\': 429258}, {\'name\': \'嚴厲明師\', \'text\': \'每當任一對手起動戰場上任一神器、生物或地的起動式異能時，若其不是魔法力異能，則嚴厲明師對該玩家造成2點傷害。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'「熬過去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429527&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'42a06814-4d4c-41b7-86e5-6ccc4fa30d4f\', \'multiverseId\': 429527}, \'multiverseid\': 429527}]', '[{\'name\': \'Hazoret die Inbrünstige\', \'text\': \'Unzerstörbar, Eile\\nHazoret die Inbrünstige kann nicht angreifen oder blocken, es sei denn, du hast eine oder weniger Karten auf deiner Hand.\\n{2}{R}, wirf eine Karte ab: Hazoret fügt jedem Gegner 2 Schadenspunkte zu.\', \'type\': \'Legendäre Kreatur — Gott\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427107&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c72402be-d09d-4707-919b-bf207560ad89\', \'multiverseId\': 427107}, \'multiverseid\': 427107}, {\'name\': \'Hazoret, la Ferviente\', \'text\': \'Indestructible, prisa.\\nHazoret, la Ferviente no puede atacar ni bloquear a menos que tengas una carta o menos en tu mano.\\n{2}{R}, descartar un carta: Hazoret hace 2 puntos de daño a cada oponente.\', \'type\': \'Criatura legendaria — Deidad\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427376&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'672cfb25-82c4-469a-ab27-ca98e1e44f64\', \'multiverseId\': 427376}, \'multiverseid\': 427376}, {\'name\': \'Hazoret la Fervente\', \'text\': "Indestructible, célérité\\nHazoret la Fervente ne peut ni attaquer ni bloquer à moins que vous n\'ayez une carte ou moins en main.\\n{2}{R}, défaussez-vous d\'une carte : Hazoret inflige 2 blessures à chaque adversaire.", \'type\': \'Créature légendaire : dieu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6ce68cc-d244-4118-b288-365c5463c201\', \'multiverseId\': 427645}, \'multiverseid\': 427645}, {\'name\': \'Hazoret la Fervente\', \'text\': \'Indistruttibile, rapidità\\nHazoret la Fervente non può attaccare o bloccare a meno che tu non abbia una o meno carte in mano.\\n{2}{R}, Scarta una carta: Hazoret infligge 2 danni a ogni avversario.\', \'type\': \'Creatura Leggendaria — Dio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427914&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28ae446e-34de-4f68-b704-f1e428b24dee\', \'multiverseId\': 427914}, \'multiverseid\': 427914}, {\'name\': \'熱烈の神ハゾレト\', \'text\': \'破壊不能、速攻\\nあなたの手札のカードが１枚以下でないかぎり、熱烈の神ハゾレトでは攻撃したりブロックしたりできない。\\n{2}{R}, カード１枚を捨てる：熱烈の神ハゾレトは各対戦相手にそれぞれ２点のダメージを与える。\', \'type\': \'伝説のクリーチャー — 神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428183&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c55def97-1148-4187-8872-3440006639d4\', \'multiverseId\': 428183}, \'multiverseid\': 428183}, {\'name\': \'열성의 하조렛\', \'text\': \'무적, 신속\\n당신의 손에 있는 카드가 한 장 이하가 아니라면, 열성의 하조렛은 공격하거나 방어할 수 없다.\\n{2}{R}, 카드 한 장을 버린다: 하조렛은 각 상대에게 피해 2점을 입힌다.\', \'type\': \'전설적 생물 — 신\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428452&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d8d401d3-0807-4956-8cc8-903da917d680\', \'multiverseId\': 428452}, \'multiverseid\': 428452}, {\'name\': \'Hazoret, a Fervorosa\', \'text\': \'Indestrutível, ímpeto\\nHazoret, a Fervorosa, não pode atacar nem bloquear, a menos que você tenha um card ou menos na mão.\\n{2}{R}, Descarte um card: Hazoret causa 2 pontos de dano a cada oponente.\', \'type\': \'Criatura Lendária — Deus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428721&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'314e144c-ab19-4021-ac01-6eaacda16c6e\', \'multiverseId\': 428721}, \'multiverseid\': 428721}, {\'name\': \'Хазорет Пылкая\', \'text\': \'Неразрушимость, Ускорение\\nХазорет Пылкая не может атаковать или блокировать, если у вас в руке больше одной карты.\\n{2}{R}, сбросьте карту: Хазорет наносит 2 повреждения каждому оппоненту.\', \'type\': \'Легендарное Существо — Бог\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428990&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41bcbece-3aa8-483e-8bee-ac3ee4463fc1\', \'multiverseId\': 428990}, \'multiverseid\': 428990}, {\'name\': \'狂热神哈佐蕾\', \'text\': \'不灭，敏捷\\n除非你的手牌为一张或更少，否则狂热神哈佐蕾不能进行攻击或阻挡。\\n{2}{R}，弃一张牌：狂热神哈佐蕾向每位对手各造成2点伤害。\', \'type\': \'传奇生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429259&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70497572-3997-4192-a619-ce5e5cd39652\', \'multiverseId\': 429259}, \'multiverseid\': 429259}, {\'name\': \'狂熱神哈佐蕾\', \'text\': \'不滅，敏捷\\n除非你的手牌為一張或更少，否則狂熱神哈佐蕾不能進行攻擊或阻擋。\\n{2}{R}，棄一張牌：狂熱神哈佐蕾向每位對手各造成2點傷害。\', \'type\': \'傳奇生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429528&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8dd3757e-1c58-4b41-b3da-2d7888280854\', \'multiverseId\': 429528}, \'multiverseid\': 429528}]', '[{\'name\': \'Hazorets Monument\', \'text\': \'Rote Kreaturenzauber, die du wirkst, kosten beim Wirken {1} weniger.\\nImmer wenn du einen Kreaturenzauber wirkst, kannst du eine Karte abwerfen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Die Auserwählten sollen mit unermüdlichem Eifer alle Hindernisse überŵinden, die zwischen ihnen und dem Gott-Pharao stehen." —Inschrift am Monument\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427200&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a011889-2ccd-464a-8dd6-494db44ea2c5\', \'multiverseId\': 427200}, \'multiverseid\': 427200}, {\'name\': \'Monumento a Hazoret\', \'text\': \'Te cuesta {1} menos lanzar los hechizos de criatura rojos.\\nSiempre que lances un hechizo de criatura, puedes descartar una carta. Si lo haces, roba una carta.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"Los dignos se apresurarán fervientemente para estar al lado del Dios Faraón, y se sobrepondrán a cualquier obstáculo". —Inscripción en el monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427469&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a0022a5-cf56-4ca8-838a-bf46c68296ba\', \'multiverseId\': 427469}, \'multiverseid\': 427469}, {\'name\': "Monument d\'Hazoret", \'text\': "Les sorts de créature rouges que vous lancez coûtent {1} de moins à lancer.\\nÀ chaque fois que vous lancez un sort de créature, vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez une carte.", \'type\': \'Artefact légendaire\', \'flavor\': "« Les valeureux se presseront aux côtés du Dieu-Pharaon avec une ardeur immuable, s\'élevant pour surmonter tous les obstacles. » —Inscription sur le monument", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427738&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'596cfb88-6c33-44f5-b3ba-d7e16da70267\', \'multiverseId\': 427738}, \'multiverseid\': 427738}, {\'name\': \'Monumento ad Hazoret\', \'text\': \'Le magie creatura rosse che lanci costano {1} in meno per essere lanciate.\\nOgniqualvolta lanci una magia creatura, puoi scartare una carta. Se lo fai, pesca una carta.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'"I prescelti dovranno presentarsi al cospetto del Dio Faraone con inarrestabile zelo, sormontando ogni ostacolo sul proprio cammino." —Iscrizione sul monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428007&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47030878-6919-467d-a9d6-05ac909181fc\', \'multiverseId\': 428007}, \'multiverseid\': 428007}, {\'name\': \'ハゾレトの碑\', \'text\': \'あなたが赤のクリーチャー・呪文を唱えるためのコストは{1}少なくなる。\\nあなたがクリーチャー・呪文を１つ唱えるたび、あなたはカード１枚を捨ててもよい。そうしたなら、カードを１枚引く。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'「蓋世の英雄は執拗な激情により王神の傍らを目指し、あらゆる障害を乗り越えねばならぬ。」 ――碑文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428276&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47bbe4a3-a2cd-48f1-b305-c9ecbcf2018c\', \'multiverseId\': 428276}, \'multiverseid\': 428276}, {\'name\': \'하조렛 기념비\', \'text\': \'당신이 발동하는 적색 생물 주문들은 발동하는 데 {1}이 덜 든다.\\n당신이 생물 주문을 발동할 때마다, 당신은 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'전설적 마법물체\', \'flavor\': \'"자격있는 자들은 끊임없는 열성을 통해 신 파라오의 곁으로 달려가 모든 장애를 극복해야 한다." —기념비 비문\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428545&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'79355123-566e-4176-bb88-3f7e23d17a99\', \'multiverseId\': 428545}, \'multiverseid\': 428545}, {\'name\': \'Monumento de Hazoret\', \'text\': \'As mágicas de criatura vermelhas que você conjura custam {1} a menos para serem conjuradas.\\nToda vez que você conjura uma mágica de criatura, você pode descartar um card. Se fizer isso, compre um card.\', \'type\': \'Artefato Lendário\', \'flavor\': \'"Os dignos devem ir ao encontro do Faraó-Deus com inabalável fervor, superando qualquer obstáculo." — Inscrição no monumento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428814&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'028ce658-ef23-43db-830e-d888a48ec603\', \'multiverseId\': 428814}, \'multiverseid\': 428814}, {\'name\': \'Монумент Хазорет\', \'text\': \'Разыгрываемые вами заклинания красных существ стоят на {1} меньше.\\nКаждый раз, когда вы разыгрываете заклинание существа, вы можете сбросить карту. Если вы это делаете, возьмите карту.\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'«Достойные должны спешить к Богу-Фараону с неслабеющей устремленностью, готовые преодолеть любое препятствие». — надпись на монументе\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429083&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'69787e87-0d25-4dbe-89d3-d02caab9465b\', \'multiverseId\': 429083}, \'multiverseid\': 429083}, {\'name\': \'哈佐蕾纪念碑\', \'text\': \'你施放的红色生物咒语减少{1}来施放。\\n每当你施放生物咒语时，你可以弃一张牌。若你如此作，则抓一张牌。\', \'type\': \'传奇神器\', \'flavor\': \'「豪英应胸怀热忱，不辞万难齐守护法老王。」 ～纪念碑铭文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429352&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fa78f57f-4131-40b3-b4c7-03882ce90b51\', \'multiverseId\': 429352}, \'multiverseid\': 429352}, {\'name\': \'哈佐蕾紀念碑\', \'text\': \'你施放的紅色生物咒語減少{1}來施放。\\n每當你施放生物咒語時，你可以棄一張牌。若你如此作，則抽一張牌。\', \'type\': \'傳奇神器\', \'flavor\': \'「豪英應胸懷熱忱，不辭萬難齊守護法老王。」 ～紀念碑銘文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429621&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a879d517-7c57-46aa-ac5d-262ffbfc8a67\', \'multiverseId\': 429621}, \'multiverseid\': 429621}]', '[{\'name\': \'Heilige Ausgrabung\', \'text\': \'Bringe bis zu zwei Karten deiner Wahl mit Umwandlung aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Angetrieben durch die Kartuschen um ihren Hals, arbeiten die Gesalbten in den Minen zu jeder Tages- und Nachtzeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427038&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9d185ca-ecbd-4789-a3d3-05447adb0577\', \'multiverseId\': 427038}, \'multiverseid\': 427038}, {\'name\': \'Excavación sagrada\', \'text\': \'Regresa hasta dos cartas objetivo con la habilidad de ciclo de tu cementerio a tu mano.\', \'type\': \'Conjuro\', \'flavor\': \'Los ungidos trabajan sin descanso en las minas, pues sus cartuchos les inculcan un propósito incansable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427307&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3e84a36c-80e2-43c1-b904-a459b75d161e\', \'multiverseId\': 427307}, \'multiverseid\': 427307}, {\'name\': \'Excavation sacrée\', \'text\': "Renvoyez jusqu\'à deux cartes avec le recyclage ciblées depuis votre cimetière dans votre main.", \'type\': \'Rituel\', \'flavor\': \'Ceux qui ont été consacrés travaillent sans relâche à la mine, leurs cartouches leur inspirant une détermination inébranlable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427576&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a822fd6-c1f7-4c44-89df-1b9915b77d26\', \'multiverseId\': 427576}, \'multiverseid\': 427576}, {\'name\': \'Scavo Sacro\', \'text\': \'Riprendi in mano fino a due carte bersaglio con ciclo dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'I consacrati lavorano senza sosta nelle miniere, spronati dai cartigli che infondono in loro una perseveranza incrollabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427845&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91ed3ede-cb2e-4d91-ba9a-df120bf76da2\', \'multiverseId\': 427845}, \'multiverseid\': 427845}, {\'name\': \'聖なる発掘\', \'text\': \'あなたの墓地からサイクリングを持つカード最大２枚を対象とし、それらをあなたの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'選定された者は休みなく発掘を続ける。カルトーシュが不断の目的を強制するのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428114&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2dd4b6b-3dd3-440a-8254-abbd60464273\', \'multiverseId\': 428114}, \'multiverseid\': 428114}, {\'name\': \'신성한 발굴\', \'text\': \'당신의 무덤에서 순환을 가진 카드를 최대 두 장까지 목표로 정한다. 그 카드들을 당신의 손으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'세례받은 자들은 광산에서 쉬지 않고 일한다. 카르투슈가 이들에게 지칠 줄 모르는 목적 의식을 불어넣었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428383&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0eaa37e0-9505-4b2e-b99a-87b6b84da077\', \'multiverseId\': 428383}, \'multiverseid\': 428383}, {\'name\': \'Escavação Sagrada\', \'text\': \'Devolva até dois cards alvo com reciclar de seu cemitério para sua mão.\', \'type\': \'Feitiço\', \'flavor\': \'Os ungidos trabalham sem descanso nas minas, impulsionados por uma determinação inabalável oriunda de suas cártulas .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428652&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'04ff8b89-c9bf-48af-b614-9142e909d26d\', \'multiverseId\': 428652}, \'multiverseid\': 428652}, {\'name\': \'Священные Раскопки\', \'text\': \'Верните не более двух целевых карт с Циклом из вашего кладбища в вашу руку.\', \'type\': \'Волшебство\', \'flavor\': \'Умащенные без устали работают в рудниках — картуши вселяют в них неутомимую целеустремленность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428921&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'20f6735d-4b97-4243-a873-1a92fbddcaac\', \'multiverseId\': 428921}, \'multiverseid\': 428921}, {\'name\': \'神圣发掘\', \'text\': \'将至多两张目标具循环异能的牌从你的坟墓场移回你手上。\', \'type\': \'法术\', \'flavor\': \'圣洗者在矿场里连续不停工作，它们的魔符向其灌输不倦意志。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429190&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'661ea1a9-d7ff-4419-b1bf-0ae19d3cc23a\', \'multiverseId\': 429190}, \'multiverseid\': 429190}, {\'name\': \'神聖發掘\', \'text\': \'將至多兩張目標具循環異能的牌從你的墳墓場移回你手上。\', \'type\': \'巫術\', \'flavor\': \'聖洗者在礦場裡連續不停工作，他們的魔符向其灌輸不倦意志。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429459&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0267d82c-3e8e-49eb-8cc4-f1497bbf032c\', \'multiverseId\': 429459}, \'multiverseid\': 429459}]', '[{\'name\': \'Heilige Katze\', \'text\': \'Lebensverknüpfung\\nEinbalsamieren {W} ({W}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er eine weiße Zombie-Katze ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Katze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426998&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4ec50f9-de45-4b82-85e1-b2b333b646cf\', \'multiverseId\': 426998}, \'multiverseid\': 426998}, {\'name\': \'Gato sagrado\', \'text\': \'Vínculo vital.\\nEmbalsamar {W}. ({W}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es un Felino Zombie blanco sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427267&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8da12024-2858-4ffd-9edf-9aa9bb83dd66\', \'multiverseId\': 427267}, \'multiverseid\': 427267}, {\'name\': \'Chat sacré\', \'text\': "Lien de vie\\nEmbaumement {W} ({W}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et chat blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : chat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427536&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d51422c-6b97-4216-828c-743ae15d36d1\', \'multiverseId\': 427536}, \'multiverseid\': 427536}, {\'name\': \'Gatto Sacro\', \'text\': \'Legame vitale\\nImbalsamare {W} ({W}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è un Felino Zombie bianco senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427805&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'42e242c3-3028-4af2-b742-d09ae8d7b332\', \'multiverseId\': 427805}, \'multiverseid\': 427805}, {\'name\': \'聖なる猫\', \'text\': \'絆魂\\n不朽{W}（{W}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・猫であることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428074&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'52ac3e3b-8a5f-488d-b969-cd46065efcc3\', \'multiverseId\': 428074}, \'multiverseid\': 428074}, {\'name\': \'신성한 고양이\', \'text\': \'생명연결\\n방부처리 {W} ({W}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 고양이다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 고양이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428343&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d53adfb-c60e-4a15-b7ee-b6032c5e4faa\', \'multiverseId\': 428343}, \'multiverseid\': 428343}, {\'name\': \'Gato Sagrado\', \'text\': \'Vínculo com a vida\\nEmbalsamar {W} ({W}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Felino branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428612&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63c41f64-686b-4cf3-b633-b23089ee124c\', \'multiverseId\': 428612}, \'multiverseid\': 428612}, {\'name\': \'Священная Кошка\', \'text\': \'Цепь жизни\\nБальзамирование {W} ({W}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белой Зомби Кошкой без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Кошка\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428881&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'be5ba106-d58a-4b34-8fe4-f1317042976e\', \'multiverseId\': 428881}, \'multiverseid\': 428881}, {\'name\': \'圣猫\', \'text\': \'系命\\n遗存{W}（{W}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／猫，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～猫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429150&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3bb77270-b2a2-4701-84ea-885bafcf8eeb\', \'multiverseId\': 429150}, \'multiverseid\': 429150}, {\'name\': \'聖貓\', \'text\': \'繫命\\n遺存{W}（{W}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／貓，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～貓\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429419&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'40b0adee-24c4-4a6e-8c79-e565d6945d14\', \'multiverseId\': 429419}, \'multiverseid\': 429419}]', '[{\'name\': \'Hekma-Wachposten\', \'text\': \'Immer wenn du eine Karte umwandelst oder abwirfst, erhalten die Hekma-Wachposten +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Das Hekma ist die liebende Umarmung des Gott-Pharaos, die uns vor den Schrecken der Außenwelt schützt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427027&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e11768b0-8128-45e6-acf0-ce19c227f0c8\', \'multiverseId\': 427027}, \'multiverseid\': 427027}, {\'name\': \'Centinelas de la Hekma\', \'text\': \'Siempre que actives una habilidad de ciclo o descartes una carta, los Centinelas de la Hekma obtienen +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"El Dios Faraón creó la Hekma para protegernos de los horrores que hay más allá y rodearnos con su amor".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427296&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'08d67214-5660-4174-95e7-117ba3aa9d8f\', \'multiverseId\': 427296}, \'multiverseid\': 427296}, {\'name\': "Sentinelles de l\'Hekma", \'text\': "À chaque fois que vous recyclez ou vous défaussez d\'une carte, les Sentinelles de l\'Hekma gagnent +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et clerc\', \'flavor\': "« Le Dieu-Pharaon a créé l\'Hekma pour nous protéger des horreurs qui se trouvent au-delà, et pour nous entourer de son amour. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427565&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1464f10c-d7c1-49b2-b3d2-fb576eb661ec\', \'multiverseId\': 427565}, \'multiverseid\': 427565}, {\'name\': "Sentinelle dell\'Hekma", \'text\': "Ogniqualvolta cicli o scarti una carta, le Sentinelle dell\'Hekma prendono +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Il Dio Faraone ha creato l\\\'Hekma per proteggerci dagli orrori che vagano oltre la barriera e per circondarci del suo amore."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427834&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'94aa82b3-8c32-4a6e-892f-d06a4f24d2ce\', \'multiverseId\': 427834}, \'multiverseid\': 427834}, {\'name\': \'ヘクマの歩哨\', \'text\': \'あなたがカードを１枚サイクリングするか捨てるたび、ターン終了時まで、ヘクマの歩哨は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「王神はヘクマをお造りになり、その外の恐怖の怪物から我々をお守りくださるとともに、その愛で我々を包み込んでくださったのです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428103&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb5e5e40-8213-456d-936e-d533278abab0\', \'multiverseId\': 428103}, \'multiverseid\': 428103}, {\'name\': \'헤크마 보초\', \'text\': \'당신이 카드를 순환하거나 버릴 때마다, 헤크마 보초는 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"신 파라오는 헤크마를 창조하시어 우리를 괴수들로부터 보호하고 우리에게 은총을 베푸셨다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428372&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8c274f53-85fb-47af-9e4e-0f92adf3ea48\', \'multiverseId\': 428372}, \'multiverseid\': 428372}, {\'name\': \'Sentinelas da Hekma\', \'text\': \'Toda vez que você recicla ou descarta um card, Sentinelas da Hekma recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"O Faraó-Deus criou a Hekma para nos proteger dos horrores além e para nos envolver em seu amor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428641&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f2cfa015-5ac1-48e7-b9ae-37d08a621c44\', \'multiverseId\': 428641}, \'multiverseid\': 428641}, {\'name\': \'Стражники Хекмы\', \'text\': \'Каждый раз, когда вы совершаете Цикл или сбрасываете карту, Стражники Хекмы получают +1/+1 до конца хода.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Бог-Фараон создал Хекму, чтобы защитить нас от ужасов пустошей и окружить своей любовью».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428910&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'90872782-8a85-4b93-8d28-0d03b7bbc363\', \'multiverseId\': 428910}, \'multiverseid\': 428910}, {\'name\': \'避世帘哨卫\', \'text\': \'每当你循环或弃一张牌时，避世帘哨卫得+1/+1直到回合结束。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「法老神架起避世帘保护我们不受外界邪物的侵扰，将我们笼罩在他的关爱之下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429179&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcdbd727-b322-424d-9ac8-eff643733226\', \'multiverseId\': 429179}, \'multiverseid\': 429179}, {\'name\': \'避世簾哨兵\', \'text\': \'每當你循環或棄一張牌時，避世簾哨兵得+1/+1直到回合結束。\', \'type\': \'生物～人類／僧侶\', \'flavor\': \'「法老神架起避世簾保護我們不受外界邪物的侵擾，將我們籠罩在他的關愛之下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429448&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fc2ebcb7-d560-4322-8aa8-e03ad4093348\', \'multiverseId\': 429448}, \'multiverseid\': 429448}]', '[{\'name\': \'Herabstürzende Katarakte\', \'text\': \'Unzerstörbar\\n{T}: Erhöhe deinen Manavorrat um {C}.\\n{5}, {T}: Erhöhe deinen Manavorrat um fünf Mana in einer beliebigen Kombination von Farben.\', \'type\': \'Land\', \'flavor\': \'„Die Kräfte, die hier wirken, sind nicht zu übersehen. Aber woher stammen sie?" —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427211&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57c0208e-76b0-4255-842d-813a49e26bb3\', \'multiverseId\': 427211}, \'multiverseid\': 427211}, {\'name\': \'Cascadas rebosantes\', \'text\': \'Indestructible.\\n{T}: Agrega {C} a tu reserva de maná.\\n{5}, {T}: Agrega cinco manás de cualquier combinación de color a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"Es innegable el poder que fluye aquí. ¿Pero de dónde procede?" —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427480&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f7cb9859-ea61-4b52-b5fa-5da114c0770a\', \'multiverseId\': 427480}, \'multiverseid\': 427480}, {\'name\': \'Cataractes iridescentes\', \'text\': \'Indestructible\\n{T} : Ajoutez {C} à votre réserve.\\n{5}, {T} : Ajoutez cinq manas de la combinaison de mana coloré de votre choix à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "« La puissance qui s\'écoule ici est indéniable. Mais quelle en est la source ? » —Nissa Revane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427749&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c9aa239-7cb3-415d-bda4-e2675652cdd1\', \'multiverseId\': 427749}, \'multiverseid\': 427749}, {\'name\': \'Cataratte Iridescenti\', \'text\': \'Indistruttibile\\n{T}: Aggiungi {C} alla tua riserva di mana.\\n{5}, {T}: Aggiungi cinque mana in qualsiasi combinazione di colori alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'"È innegabile che qui fluisca un potere di qualche tipo. Ma qual è la sua origine?" —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428018&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab320c05-f028-40bc-b30c-48cb090d7025\', \'multiverseId\': 428018}, \'multiverseid\': 428018}, {\'name\': \'大瀑布\', \'text\': \'破壊不能\\n{T}：あなたのマナ・プールに{C}を加える。\\n{5}, {T}：あなたのマナ・プールに、望む色の組み合わせのマナ５点を加える。\', \'type\': \'土地\', \'flavor\': \'「ここに力の流れがあるのは間違いない。だけど、その源はどこなの？」 ――ニッサ・レヴェイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428287&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4feb4856-189a-4989-a220-536a14e5d2ee\', \'multiverseId\': 428287}, \'multiverseid\': 428287}, {\'name\': \'쏟아지는 대폭포\', \'text\': \'무적\\n{T}: {C}를 당신의 마나풀에 담는다.\\n{5}, {T}: 원하는 색의 조합으로 마나 다섯 개를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'"여기로 흘러오는 힘을 인정하지 않을 수가 없어. 대체 이 힘의 근원은 어디지?" —니사 레베인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428556&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1bb972c0-9884-4990-b93b-1effce7d5aad\', \'multiverseId\': 428556}, \'multiverseid\': 428556}, {\'name\': \'Cataratas Cascateantes\', \'text\': \'Indestrutível\\n{T}: Adicione {C} à sua reserva de mana.\\n{5}, {T}: Adicione cinco manas em qualquer combinação de cores a sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"O poder que flui aqui é inegável. Mas onde está a fonte?" — Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f6e05e5-fb47-4906-bfa9-72a2d3771dde\', \'multiverseId\': 428825}, \'multiverseid\': 428825}, {\'name\': \'Каскад Водопадов\', \'text\': \'Неразрушимость\\n{T}: добавьте {C} в ваше хранилище маны.\\n{5}, {T}: добавьте пять ман в любой комбинации цветов в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'«Здесь течет могучая сила, это правда. Но где же ее источник?» — Нисса Ревейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429094&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f3cd9ab-72da-4c34-b755-7d4144258f0a\', \'multiverseId\': 429094}, \'multiverseid\': 429094}, {\'name\': \'飞流巨瀑\', \'text\': \'不灭\\n{T}：加{C}到你的法术力池中。\\n{5}，{T}：加五点法术力到你的法术力池中，其颜色组合由你选择。\', \'type\': \'地\', \'flavor\': \'「此处川流不息的力量令人无法抗拒。但其源头又在何处？」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429363&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'490c17e6-d0c5-45c4-8bb9-65ee66707d02\', \'multiverseId\': 429363}, \'multiverseid\': 429363}, {\'name\': \'飛流巨瀑\', \'text\': \'不滅\\n{T}：加{C}到你的魔法力池中。\\n{5}，{T}：加五點魔法力到你的魔法力池中，其顏色組合由你選擇。\', \'type\': \'地\', \'flavor\': \'「此處川流不息的力量令人無法抗拒。但其源頭又在何處？」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429632&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0fda613f-e2fb-4b63-81b1-c14d11bdaae9\', \'multiverseId\': 429632}, \'multiverseid\': 429632}]', '[{\'name\': \'Herannahen der zweiten Sonne\', \'text\': \'Falls Herannahen der zweiten Sonne aus deiner Hand gewirkt wurde und du in dieser Partie bereits einen anderen Zauberspruch namens Herannahen der zweiten Sonne gewirkt hast, gewinnst du die Partie. Anderenfalls lege Herannahen der zweiten Sonne als siebte Karte von oben in die Bibliothek ihres Besitzers und du erhältst 7 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426975&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7150a364-1915-4266-ac68-0fce3a091678\', \'multiverseId\': 426975}, \'multiverseid\': 426975}, {\'name\': \'Acercamiento del Segundo Sol\', \'text\': \'Si el Acercamiento del Segundo Sol fue lanzado de tu mano y ya lanzaste otro hechizo llamado Acercamiento del Segundo Sol en este juego, ganas el juego. De lo contrario, pon el Acercamiento del Segundo Sol en la biblioteca de su propietario en séptimo lugar desde la parte superior y tú ganas 7 vidas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427244&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99cf0431-26dd-4dab-a305-de5eb3540f77\', \'multiverseId\': 427244}, \'multiverseid\': 427244}, {\'name\': \'Approche du Second Soleil\', \'text\': "Si l\'Approche du Second Soleil a été lancée depuis votre main et que vous avez lancé un autre sort appelé Approche du Second Soleil pendant cette partie, vous gagnez la partie. Sinon, mettez l\'Approche du Second Soleil dans la bibliothèque de son propriétaire en septième position à partir du dessus et vous gagnez 7 points de vie.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89d64a05-fc78-4582-b008-6bc11cc640fd\', \'multiverseId\': 427513}, \'multiverseid\': 427513}, {\'name\': \'Avvicinamento del Secondo Sole\', \'text\': "Se l\'Avvicinamento del Secondo Sole è stato lanciato dalla tua mano e hai lanciato un\'altra magia chiamata Avvicinamento del Secondo Sole in questa partita, vinci la partita. Altrimenti, metti l\'Avvicinamento del Secondo Sole nel grimorio del suo proprietario come settima carta e guadagni 7 punti vita.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427782&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'717f5cc5-08b3-4bf0-954b-4ca885762bcc\', \'multiverseId\': 427782}, \'multiverseid\': 427782}, {\'name\': \'副陽の接近\', \'text\': \'副陽の接近があなたの手札から唱えられ、かつ、あなたがこのゲームで「副陽の接近」という名前の他の呪文を唱えていたなら、あなたはこのゲームに勝利する。そうでないなら、副陽の接近をオーナーのライブラリーの一番上から７枚目に置き、あなたは７点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428051&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb0e8334-f1ff-4ab1-af84-d64c04bf7114\', \'multiverseId\': 428051}, \'multiverseid\': 428051}, {\'name\': \'두 번째 태양의 접근\', \'text\': \'당신이 손에서 두 번째 태양의 접근을 발동했고 이 게임에서 이름이 두 번째 태양의 접근인 다른 주문을 발동했다면, 당신은 게임에서 승리한다. 그렇지 않으면, 두 번째 태양의 접근을 소유자의 서고 맨 위에서 일곱 번째에 넣고 당신은 생명 7점을 얻는다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428320&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bb80fa03-63dc-4565-8629-f0338446b081\', \'multiverseId\': 428320}, \'multiverseid\': 428320}, {\'name\': \'Aproximação do Segundo Sol\', \'text\': \'Se Aproximação do Segundo Sol foi conjurada da sua mão e você já conjurou outra mágica com o nome Aproximação do Segundo Sol neste jogo, você vence o jogo. Caso contrário, coloque Aproximação do Segundo Sol no grimório de seu dono como o sétimo card a partir do topo e ganhe 7 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428589&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb151b7d-c36e-471e-9b31-3bd69c4b3f7f\', \'multiverseId\': 428589}, \'multiverseid\': 428589}, {\'name\': \'Приближение Второго Солнца\', \'text\': \'Если Приближение Второго Солнца было разыграно из вашей руки и в этой партии вы уже разыгрывали другое заклинание с именем Приближение Второго Солнца, то вы выигрываете партию. В противном случае, положите Приближение Второго Солнца в библиотеку его владельца седьмой картой сверху, и вы получаете 7 жизней.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428858&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'913a8775-019d-484c-8197-5166b1a22f3b\', \'multiverseId\': 428858}, \'multiverseid\': 428858}, {\'name\': \'神日迫临\', \'text\': \'如果神日迫临是从你手上施放，且你在本盘游戏中曾施放过另一个名称为神日迫临的咒语，则你赢得这盘游戏。若否，则将神日迫临置于其拥有者牌库顶数来第七张的位置，且你获得7点生命。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429127&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'334f85b4-d844-4172-8b1a-1e0d79d2f010\', \'multiverseId\': 429127}, \'multiverseid\': 429127}, {\'name\': \'神日迫臨\', \'text\': \'如果神日迫臨是從你手上施放，且你在本盤遊戲中曾施放過另一個名稱為神日迫臨的咒語，則你贏得這盤遊戲。若否，則將神日迫臨置於其擁有者牌庫頂數來第七張的位置，且你獲得7點生命。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429396&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'647f312b-b239-4e72-9194-3cb29c2b8db2\', \'multiverseId\': 429396}, \'multiverseid\': 429396}]', '[{\'name\': \'Herzstecher-Mantikor\', \'text\': \'Wenn der Herzstecher-Mantikor ins Spiel kommt, kannst du eine andere Kreatur opfern. Wenn du dies tust, fügt der Herzstecher-Mantikor einer Kreatur oder einem Spieler deiner Wahl Schadenspunkte in Höhe der Stärke der geopferten Kreatur zu.\\nEinbalsamieren {5}{R} ({5}{R}, schicke diese Karte aus deinem Friedhof ins Exil: Erzeuge einen Spielstein, der eine Kopie von ihr ist, außer dass er ein weißer Zombie-Mantikor ohne Manakosten ist. Spiele Einbalsamieren wie eine Hexerei.)\', \'type\': \'Kreatur — Mantikor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427109&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d732e83-4c86-4856-9711-2f7c6385b141\', \'multiverseId\': 427109}, \'multiverseid\': 427109}, {\'name\': \'Mantícora perforacorazones\', \'text\': \'Cuando la Mantícora perforacorazones entre al campo de batalla, puedes sacrificar otra criatura. Cuando lo hagas, la Mantícora perforacorazones hace daño a la criatura o jugador objetivo igual a la fuerza de esa criatura.\\nEmbalsamar {5}{R}. ({5}{R}, exiliar esta carta de tu cementerio: Crea una ficha que es una copia de esta carta, excepto que es una Mantícora Zombie blanca sin coste de maná. Activa la habilidad de embalsamar solo como un conjuro.)\', \'type\': \'Criatura — Mantícora\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427378&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be8d4ee6-0e1f-4011-8cfd-623977eb5ad4\', \'multiverseId\': 427378}, \'multiverseid\': 427378}, {\'name\': \'Manticore perce-cœur\', \'text\': "Quand la Manticore perce-cœur arrive sur le champ de bataille, vous pouvez sacrifier une autre créature. Quand vous faites ainsi, la Manticore perce-cœur inflige à une cible, créature ou joueur, un nombre de blessures égal à la force de cette créature.\\nEmbaumement {5}{R} ({5}{R}, exilez cette carte de votre cimetière : Créez un jeton qui en est une copie, excepté que c\'est un zombie et manticore blanc sans coût de mana. N\'utilisez l\'embaumement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : manticore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427647&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d2c2157-487f-4818-aa95-46f282b6c99f\', \'multiverseId\': 427647}, \'multiverseid\': 427647}, {\'name\': \'Manticora Trafiggicuore\', \'text\': "Quando la Manticora Trafiggicuore entra nel campo di battaglia, puoi sacrificare un\'altra creatura. Quando lo fai, la Manticora Trafiggicuore infligge a una creatura o a un giocatore bersaglio danno pari alla forza di quella creatura.\\nImbalsamare {5}{R} ({5}{R}, Esilia questa carta dal tuo cimitero: Crea una pedina che è una copia della carta, tranne che è una Manticora Zombie bianca senza costo di mana. Imbalsama solo quando potresti lanciare una stregoneria.)", \'type\': \'Creatura — Manticora\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427916&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cffb8dc8-b8dd-4518-b77a-596777d9677b\', \'multiverseId\': 427916}, \'multiverseid\': 427916}, {\'name\': \'心臓貫きのマンティコア\', \'text\': \'心臓貫きのマンティコアが戦場に出たとき、あなたは他のクリーチャー１体を生け贄に捧げてもよい。そうしたとき、クリーチャー１体かプレイヤー１人を対象とする。心臓貫きのマンティコアはそれに、その生け贄に捧げたクリーチャーのパワーに等しい点数のダメージを与える。\\n不朽{5}{R}（{5}{R}, あなたの墓地からこのカードを追放する：マナ・コストを持たない白のゾンビ・マンティコアであることを除きこれのコピーであるトークンを１体生成する。不朽はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — マンティコア\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428185&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7556677-6fd6-4600-8307-3dd5e2931d0a\', \'multiverseId\': 428185}, \'multiverseid\': 428185}, {\'name\': \'심장관통수 만티코어\', \'text\': \'심장관통수 만티코어가 전장에 들어올 때, 당신은 다른 생물 한 개를 희생할 수 있다. 그렇게 할 때, 생물 또는 플레이어를 목표로 정한다. 심장관통수 만티코어는 그 목표에게 그 생물의 공격력만큼 피해를 입힌다.\\n방부처리 {5}{R} ({5}{R}, 이 카드를 당신의 무덤에서 추방한다: 이 카드의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 마나 비용이 없는 백색 좀비 만티코어다. 당신이 집중마법을 발동할 수 있는 시기에만 방부처리를 할 수 있다.)\', \'type\': \'생물 — 만티코어\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428454&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3deed9f6-3f74-469a-a62a-d5280766139e\', \'multiverseId\': 428454}, \'multiverseid\': 428454}, {\'name\': \'Mantícora Fura-coração\', \'text\': \'Quando Mantícora Fura-coração entra no campo de batalha, você pode sacrificar outra criatura. Quando você faz isso, Mantícora Fura-coração causa uma quantidade de dano igual ao poder daquela criatura à criatura ou ao jogador alvo.\\nEmbalsamar {5}{R} ({5}{R}, Exile este card de seu cemitério: Crie uma ficha que seja uma cópia dele, com a exceção de ser um Zumbi Mantícora branco sem custo de mana. Embalsame somente como um feitiço.)\', \'type\': \'Criatura — Mantícora\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428723&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ce5404c-11a1-4699-a5b2-819860c00802\', \'multiverseId\': 428723}, \'multiverseid\': 428723}, {\'name\': \'Пронзающая Сердце Мантикора\', \'text\': \'Когда Пронзающая Сердце Мантикора выходит на поле битвы, вы можете пожертвовать другое существо. Когда вы это делаете, Пронзающая Сердце Мантикора наносит повреждения, равные силе того существа, целевому существу или игроку.\\nБальзамирование {5}{R} ({5}{R}, изгоните эту карту из вашего кладбища: создайте фишку, являющуюся ее копией, но при этом являющуюся белой Зомби Мантикорой без мана-стоимости. Бальзамируйте только как волшебство.)\', \'type\': \'Существо — Мантикора\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428992&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dbef77a2-276d-48dd-9835-74a8d4146d14\', \'multiverseId\': 428992}, \'multiverseid\': 428992}, {\'name\': \'穿心蝎狮\', \'text\': \'当穿心蝎狮进战场时，你可以牺牲另一个生物。当你如此作时，穿心蝎狮对目标生物或牌手造成伤害，其数量等同于所牺牲生物的力量。\\n遗存{5}{R}（{5}{R}，从你的坟墓场放逐此牌：派出一个衍生物，且为此牌的复制品，但它是白色灵俑／翼狮，且没有法术力费用。遗存的时机视同法术。）\', \'type\': \'生物～翼狮\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429261&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2cba957d-9e0b-466b-aa9c-45d42317385f\', \'multiverseId\': 429261}, \'multiverseid\': 429261}, {\'name\': \'穿心蠍獅\', \'text\': \'當穿心蠍獅進戰場時，你可以犧牲另一個生物。當你如此作時，穿心蠍獅對目標生物或玩家造成傷害，其數量等同於所犧牲生物的力量。\\n遺存{5}{R}（{5}{R}，從你的墳墓場放逐此牌：派出一個衍生物，且為此牌的複製品，但它是白色殭屍／翼獅，且沒有魔法力費用。遺存的時機視同巫術。）\', \'type\': \'生物～翼獅\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429530&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a4365bbb-9a1a-405f-8636-b61f0e5a5b34\', \'multiverseId\': 429530}, \'multiverseid\': 429530}]', "[{'name': 'Himmel // Erde', 'text': 'Himmel fügt jeder fliegenden Kreatur X Schadenspunkte zu.', 'type': 'Spontanzauber', 'flavor': None, 'faceName': 'Himmel', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427195&type=card', 'language': 'German', 'identifiers': {'scryfallId': '858b34f5-6b60-4c78-b4c3-80c0cc357b5a', 'multiverseId': 427195}, 'multiverseid': 427195}, {'name': 'Cielo // Tierra', 'text': 'Cielo hace X puntos de daño a cada criatura que tenga la habilidad de volar.', 'type': 'Instantáneo', 'flavor': None, 'faceName': 'Cielo', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427464&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9d9bb06b-9345-4a43-9e15-f976f86e4466', 'multiverseId': 427464}, 'multiverseid': 427464}, {'name': 'Ciel // Terre', 'text': 'Le Ciel inflige X blessures à chaque créature avec le vol.', 'type': 'Éphémère', 'flavor': None, 'faceName': 'Ciel', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427733&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6d82b453-0e7b-4e0e-b014-7a1411eafd80', 'multiverseId': 427733}, 'multiverseid': 427733}, {'name': 'Cielo // Terra', 'text': 'Il Cielo infligge X danni a ogni creatura con volare.', 'type': 'Istantaneo', 'flavor': None, 'faceName': 'Cielo', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428002&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7552a7d8-5478-48c0-9dbc-26afa5f525e4', 'multiverseId': 428002}, 'multiverseid': 428002}, {'name': '驚天 // 動地', 'text': '驚天は飛行を持つ各クリーチャーにそれぞれＸ点のダメージを与える。', 'type': 'インスタント', 'flavor': None, 'faceName': '驚天', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428271&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7d07b7c5-dab8-45be-b4fe-ec5da208d9d1', 'multiverseId': 428271}, 'multiverseid': 428271}, {'name': '천상 // 지상', 'text': '천상은 비행을 가진 각 생물에게 피해 X점을 입힌다.', 'type': '순간마법', 'flavor': None, 'faceName': '천상', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428540&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '15a1f1cf-2c89-4195-9bcb-df298fcef96c', 'multiverseId': 428540}, 'multiverseid': 428540}, {'name': 'Céu // Terra', 'text': 'Céu causa X pontos de dano a cada criatura com voar.', 'type': 'Mágica Instantânea', 'flavor': None, 'faceName': 'Céu', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428809&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '66254e1b-7d5e-4a86-9bb7-da2302e8ba35', 'multiverseId': 428809}, 'multiverseid': 428809}, {'name': 'С Неба // На Землю', 'text': 'С Неба наносит Х повреждений каждому существу с Полетом.', 'type': 'Мгновенное заклинание', 'flavor': None, 'faceName': 'С Неба', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429078&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '380e63c3-1c1c-4ea7-93d4-f3af5025a9b3', 'multiverseId': 429078}, 'multiverseid': 429078}, {'name': '劈天 // 盖地', 'text': '劈天对每个具飞行异能的生物各造成X点伤害。', 'type': '瞬间', 'flavor': None, 'faceName': '劈天', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429347&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f4ce3e32-8d59-4ce7-b5f8-5a0d3c52cf3f', 'multiverseId': 429347}, 'multiverseid': 429347}, {'name': '劈天 // 蓋地', 'text': '劈天對每個具飛行異能的生物各造成X點傷害。', 'type': '瞬間', 'flavor': None, 'faceName': '劈天', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429616&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '79bc72d5-9fb1-4911-a560-8f82164436c6', 'multiverseId': 429616}, 'multiverseid': 429616}]", '[{\'name\': \'Hochlandsee\', \'text\': \'Der Hochlandsee kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {R}.\', \'type\': \'Land\', \'flavor\': \'Das Schicksal Innistrads ist ungewiss und so suchen manche Trost an abgeschiedenen Orten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fbc559de-1182-4233-b540-895f3f6e18ae\', \'multiverseId\': 429728}, \'multiverseid\': 429728}, {\'name\': \'Lago de las tierras altas\', \'text\': \'El Lago de las tierras altas entra al campo de batalla girado.\\n{T}: Agrega {U} o {R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Con el destino de Innistrad incierto, algunos buscan consuelo en zonas remotas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429854&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dc26f638-19ed-4e15-a381-edd334e70b83\', \'multiverseId\': 429854}, \'multiverseid\': 429854}, {\'name\': \'Lac des hautes terres\', \'text\': \'Le Lac des hautes terres arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {U} ou {R} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Le sort d\'Innistrad étant précaire, certains trouvent le réconfort dans des endroits reculés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ae5b85e-0278-4071-85c7-d2bb342af16a\', \'multiverseId\': 429746}, \'multiverseid\': 429746}, {\'name\': "Lago dell\'Altopiano", \'text\': "Il Lago dell\'Altopiano entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U} o {R} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': "Nell\'incertezza del destino di Innistrad, alcuni cercano conforto in aree remote.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429764&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a9a814e-4e84-4097-b16c-6ed67ab3244d\', \'multiverseId\': 429764}, \'multiverseid\': 429764}, {\'name\': \'高地の湖\', \'text\': \'高地の湖はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'イニストラードの先行きが怪しくなり、遠方の地に慰めを見出すものもいた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429782&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b639cbd-04b3-448c-b05a-e054a13f3d2c\', \'multiverseId\': 429782}, \'multiverseid\': 429782}, {\'name\': \'산악 호수\', \'text\': \'산악 호수는 탭된 채로 전장에 들어온다.\\n{T}: {U}나 {R}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'바람 앞의 등불 신세인 이니스트라드에서 어떤 사람들은 오지에서 위안을 찾는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429800&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'29af74ef-32b9-4ddf-b7c3-28d8254906bd\', \'multiverseId\': 429800}, \'multiverseid\': 429800}, {\'name\': \'Lago Montanhês\', \'text\': \'Lago Montanhês entra no campo de batalha virado.\\n{T}: Adicione {U} ou {R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Com a incerteza do destino de Innistrad, alguns buscam refúgio em áreas remotas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f614505f-ef13-46ea-a7f8-4c97ad8749d7\', \'multiverseId\': 429818}, \'multiverseid\': 429818}, {\'name\': \'Горное Озеро\', \'text\': \'Горное Озеро выходит на поле битвы повернутым.\\n{T}: добавьте {U} или {R} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Судьба Иннистрада висела на волоске, и кто-то решил укрыться подальше от людей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429836&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ed32014-7c53-46ff-8a07-ee2f04217859\', \'multiverseId\': 429836}, \'multiverseid\': 429836}, {\'name\': \'高地湖泊\', \'text\': \'高地湖泊须横置进战场。\\n{T}：加{U}或{R}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'由于依尼翠的命运不定，有些人便去偏远之地寻求安宁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429692&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bbe46989-e1b1-4299-bb20-2d268c42029c\', \'multiverseId\': 429692}, \'multiverseid\': 429692}, {\'name\': \'高地湖泊\', \'text\': \'高地湖泊須橫置進戰場。\\n{T}：加{U}或{R}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'由於依尼翠的命運不定，有些人便去偏遠之地尋求安寧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429710&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ba1af9ab-918d-4edb-938f-22b5f4d8641b\', \'multiverseId\': 429710}, \'multiverseid\': 429710}]', '[{\'name\': \'Hochwasser\', \'text\': \'Bringe bis zu zwei Kreaturen deiner Wahl auf die Hand ihrer Besitzer zurück.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'„Meist ist er ruhig, aber lass dich nicht täuschen. Der Luxa ist eine schlafende Bestie, die ihre Opfer mit Haut und Haar verschlingt." —Neponem, Wesirin von Kefnet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427024&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a6bb9f0b-8a85-44f8-8930-b897aa435582\', \'multiverseId\': 427024}, \'multiverseid\': 427024}, {\'name\': \'Riada\', \'text\': \'Regresa hasta dos criaturas objetivo a las manos de sus propietarios.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'"Suele parecer plácido, pero no te dejes engañar. El río Luxa es una serpiente que puede tragarte entero". —Neponem, visir de Kefnet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427293&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a8c4f1a-d915-4cd9-ac8e-08a8fe76f7ac\', \'multiverseId\': 427293}, \'multiverseid\': 427293}, {\'name\': \'Eaux de crue\', \'text\': "Renvoyez jusqu\'à deux créatures ciblées dans les mains de leurs propriétaires.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': "« Ces eaux sont d\'ordinaire calmes, mais ne vous y trompez pas. Le Luxa est un serpent capable de vous avaler tout entier. » —Neponem, vizir de Kefnet", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427562&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ce0f962-b7f7-4b69-9569-0f58b2d1da19\', \'multiverseId\': 427562}, \'multiverseid\': 427562}, {\'name\': \'Acque Alluvionali\', \'text\': \'Fai tornare fino a due creature bersaglio in mano ai rispettivi proprietari.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'"La sua calma apparente non è che un mero inganno: il fiume Luxa è un serpente in grado di inghiottire qualsiasi cosa." —Neponem, visir di Kefnet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427831&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'552e9ac9-8167-4309-b128-c129e0f27fa9\', \'multiverseId\': 427831}, \'multiverseid\': 427831}, {\'name\': \'大水\', \'text\': \'クリーチャー最大２体を対象とし、それらをオーナーの手札に戻す。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'「普段は静かだが騙されてはならない。ルクサ川は蛇だ。お前などひと飲みにできる。」 ――ケフネトの侍臣、ネポネム\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428100&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b0e0ef1-adc6-4756-bc09-fad9cd394cbc\', \'multiverseId\': 428100}, \'multiverseid\': 428100}, {\'name\': \'홍수\', \'text\': \'최대 두 개까지의 생물을 목표로 정한다. 그 생물들을 소유자의 손으로 되돌린다.\\n순환 {2} ({2}, 이 카드를 버린다: 카드 한 장을 뽑는다.)\', \'type\': \'집중마법\', \'flavor\': \'"평온해 보이는 평소 모습에 속지마라. 럭사 강은 뱀과 같아서 언제든 당신을 집어삼킬 수 있다." —케프넷의 고관 네포넴\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428369&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5c7bd565-2fd9-409b-9500-0d395d873d4e\', \'multiverseId\': 428369}, \'multiverseid\': 428369}, {\'name\': \'Enxurrada\', \'text\': \'Devolva até duas criaturas alvo para as mãos de seus donos.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'"Suas águas são aparentemente plácidas, mas não se deixe enganar. O rio Luxa é uma cobra, e pode engolir você por inteiro." — Neponem, vizir de Kefnet\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428638&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a5bd7be-fc2a-4a6d-94df-0f0362928773\', \'multiverseId\': 428638}, \'multiverseid\': 428638}, {\'name\': \'Разлившиеся Воды\', \'text\': \'Верните не более двух целевых существ в руки их владельцев.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'«Обычно она кажется безмятежной, но пусть тебя это не обманывает. Река Лукса — это змея, и она способна проглотить тебя заживо». — Непонем, визирь Кефнета\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428907&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'579472c9-ac90-4fdc-85d9-40285a6c0443\', \'multiverseId\': 428907}, \'multiverseid\': 428907}, {\'name\': \'洪水滔天\', \'text\': \'将至多两个目标生物移回其拥有者手上。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'「平日里，罗夏河看似宁静，但切勿被其迷惑。罗夏河是一条蛇，能将你们尽数吞没。」 ～刻法涅维齐尔奈珀内\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429176&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bbe14c61-56b3-4689-8a7d-dbecb7d03aa2\', \'multiverseId\': 429176}, \'multiverseid\': 429176}, {\'name\': \'洪水滔天\', \'text\': \'將至多兩個目標生物移回其擁有者手上。\\n循環{2}（{2}，棄掉此牌：抽一張牌。）\', \'type\': \'巫術\', \'flavor\': \'「平日裡，羅夏河看似寧靜，但切勿被其迷惑。羅夏河是一條蛇，能將你們盡數吞沒。」 ～刻法涅維齊爾奈珀內\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429445&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a8219d36-16cb-487f-9a6d-23e55c0dbe82\', \'multiverseId\': 429445}, \'multiverseid\': 429445}]', '[{\'name\': \'Hort der Verfluchten\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {C}.\\n{3}, {T}, opfere den Hort der Verfluchten: Erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein. Aktiviere diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei wirken könntest.\', \'type\': \'Land — Wüste\', \'flavor\': \'Selbst die Toten wollen in der Ödnis Ifnirs nicht alleine sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427212&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ae95a96-9ca7-47a2-808c-9942ea6e450d\', \'multiverseId\': 427212}, \'multiverseid\': 427212}, {\'name\': \'Cuna de los malditos\', \'text\': \'{T}: Agrega {C} a tu reserva de maná.\\n{3}, {T}, sacrificar la Cuna de los malditos: Crea una ficha de criatura Zombie negra 2/2. Activa esta habilidad solo cuando puedas lanzar un conjuro.\', \'type\': \'Tierra — Desierto\', \'flavor\': \'Muchos monumentos semejantes adornan el páramo conocido como Ifnir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427481&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e20e0a99-39dc-4339-9a14-c086cd0b98cb\', \'multiverseId\': 427481}, \'multiverseid\': 427481}, {\'name\': \'Berceau des maudits\', \'text\': "{T} : Ajoutez {C} à votre réserve.\\n{3}, {T}, sacrifiez le Berceau des maudits : Créez un jeton de créature 2/2 noire Zombie. N\'activez cette capacité que lorsque vous pourriez lancer un rituel.", \'type\': \'Terrain : désert\', \'flavor\': "De nombreux monuments semblables à celui-ci parsèment les terres dévastées connues sous le nom d\'Ifnir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a97b6b14-549a-4d68-98ad-6686ba595da5\', \'multiverseId\': 427750}, \'multiverseid\': 427750}, {\'name\': \'Culla dei Maledetti\', \'text\': \'{T}: Aggiungi {C} alla tua riserva di mana.\\n{3}, {T}, Sacrifica la Culla dei Maledetti: Crea una pedina creatura Zombie 2/2 nera. Attiva questa abilità solo quando potresti lanciare una stregoneria.\', \'type\': \'Terra — Deserto\', \'flavor\': \'Molti di questi monumenti sono disseminati nella landa desolata nota come Ifnir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428019&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa8b6bdb-50c5-4113-8e82-afd27cf531ba\', \'multiverseId\': 428019}, \'multiverseid\': 428019}, {\'name\': \'呪われた者の揺り籠\', \'text\': \'{T}：あなたのマナ・プールに{C}を加える。\\n{3}, {T}, 呪われた者の揺り籠を生け贄に捧げる：黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。この能力は、あなたがソーサリーを唱えられるときにのみ起動できる。\', \'type\': \'土地 — 砂漠\', \'flavor\': \'イフニルと呼ばれる不毛地には、このような建造物が点在する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428288&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4fab2338-9b12-437f-8360-a5d300d90a83\', \'multiverseId\': 428288}, \'multiverseid\': 428288}, {\'name\': \'저주받은 자들의 요람\', \'text\': \'{T}: {C}를 당신의 마나풀에 담는다.\\n{3}, {T}, 저주받은 자들의 요람을 희생한다: 2/2 흑색 좀비 생물 토큰 한 개를 만든다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'대지 — 사막\', \'flavor\': \'이러한 기념비들이 이프니어 황무지 곳곳에 세워져 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428557&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b30c35da-f598-4866-bff2-be41d6c5fbc4\', \'multiverseId\': 428557}, \'multiverseid\': 428557}, {\'name\': \'Berço dos Amaldiçoados\', \'text\': \'{T}: Adicione {C} à sua reserva de mana.\\n{3}, {T}, Sacrifique Berço dos Amaldiçoados: Crie uma ficha de criatura preta 2/2 do tipo Zumbi. Ative esta habilidade somente nos momentos em que poderia conjurar um feitiço.\', \'type\': \'Terreno — Deserto\', \'flavor\': \'Há vários monumentos como esse espalhados pelos ermos conhecidos como Ifnir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428826&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5eeccec-cb47-40ef-9d42-51dd05fdfed3\', \'multiverseId\': 428826}, \'multiverseid\': 428826}, {\'name\': \'Колыбель Проклятых\', \'text\': \'{T}: добавьте {C} в ваше хранилище маны.\\n{3}, {T}, пожертвуйте Колыбель Проклятых: создайте одну фишку существа 2/2 черный Зомби. Активируйте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Земля — Пустыня\', \'flavor\': \'В пустынных землях, зовущихся Ифниром, есть множество таких монументов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429095&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0ad6906f-d444-403d-bcef-c6fc676237c2\', \'multiverseId\': 429095}, \'multiverseid\': 429095}, {\'name\': \'遭诅者源墓\', \'text\': \'{T}：加{C}到你的法术力池中。\\n{3}，{T}，牺牲遭诅者源墓：派出一个2/2黑色灵俑衍生生物。只可以于你能施放法术的时机下起动此异能。\', \'type\': \'地～沙漠\', \'flavor\': \'荒土依法尼上这类墓碑星罗棋布，点缀其间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429364&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7c33080d-2371-41a1-bb7e-330fd35fcd4d\', \'multiverseId\': 429364}, \'multiverseid\': 429364}, {\'name\': \'遭詛者源墓\', \'text\': \'{T}：加{C}到你的魔法力池中。\\n{3}，{T}，犧牲遭詛者源墓：派出一個2/2黑色殭屍衍生生物。只可以於你能施放巫術的時機下起動此異能。\', \'type\': \'地～沙漠\', \'flavor\': \'荒土依法尼上這類墓碑星羅棋布，點綴其間。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429633&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ec8eb72b-d525-4a06-8a54-6f17af1f993a\', \'multiverseId\': 429633}, \'multiverseid\': 429633}]', '[{\'name\': \'Hyänenrudel\', \'type\': \'Kreatur — Hyäne\', \'flavor\': \'Aas ist in der Splitterwüste so selten, dass selbst die Hyänen anfangen, auf die Jagd zu gehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427110&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6cb54269-380c-4be2-b8a5-10005b32d661\', \'multiverseId\': 427110}, \'multiverseid\': 427110}, {\'name\': \'Manada de hienas\', \'type\': \'Criatura — Hiena\', \'flavor\': \'La carroña no abunda en las Tierras Desoladas, por lo que las hienas que acechan en los desiertos cazan en manadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427379&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f00e735-d6dc-4385-b2a1-464822e00466\', \'multiverseId\': 427379}, \'multiverseid\': 427379}, {\'name\': \'Meute de hyènes\', \'type\': \'Créature : hyène\', \'flavor\': "Les charognes sont rares dans les Terres brisées, c\'est pourquoi les hyènes qui arpentent le désert chassent en meute.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427648&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac9297bc-4237-4c56-a46e-ad4d690d8547\', \'multiverseId\': 427648}, \'multiverseid\': 427648}, {\'name\': \'Branco di Iene\', \'type\': \'Creatura — Iena\', \'flavor\': \'Poiché le carogne scarseggiano nelle Terre spezzate, le iene che si aggirano per i deserti cacciano in branco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427917&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'882a78bc-2fc1-4cb4-a870-e7d0afcb51fa\', \'multiverseId\': 427917}, \'multiverseid\': 427917}, {\'name\': \'ハイエナの群れ\', \'type\': \'クリーチャー — ハイエナ\', \'flavor\': \'遺棄地に稀有なる屍肉あらば、砂漠に群れ成すハイエナあり。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428186&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7bf58844-fb24-412f-8153-0265df9c7dab\', \'multiverseId\': 428186}, \'multiverseid\': 428186}, {\'name\': \'하이에나 무리\', \'type\': \'생물 — 하이에나\', \'flavor\': \'시체를 찾기 어려운 망가진 땅에서는 사막을 배회하는 하이에나들이 무리를 지어 사냥한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428455&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a123ffc0-d0fd-41df-8e6b-e91c2002440a\', \'multiverseId\': 428455}, \'multiverseid\': 428455}, {\'name\': \'Alcateia de Hienas\', \'type\': \'Criatura — Hiena\', \'flavor\': \'Como carcaças são uma raridade nas Terras Partidas, as hienas que espreitam nos desertos caçam em bando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428724&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5085eb4-081d-4aee-a457-dd92693c94e4\', \'multiverseId\': 428724}, \'multiverseid\': 428724}, {\'name\': \'Стая Гиен\', \'type\': \'Существо — Гиена\', \'flavor\': \'Падаль редко встречается в Смятенных Землях, и живущие в пустыне гиены сбиваются для охоты в стаи.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428993&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9e3c760-a082-49f7-89b0-e7bfee46e553\', \'multiverseId\': 428993}, \'multiverseid\': 428993}, {\'name\': \'鬣狗群\', \'type\': \'生物～鬣狗\', \'flavor\': \'荒土中腐肉稀缺，于沙漠中游荡的鬣狗常常成群狩猎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429262&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eda55681-5ae1-4d6d-8841-6c0594d7bad6\', \'multiverseId\': 429262}, \'multiverseid\': 429262}, {\'name\': \'鬣狗群\', \'type\': \'生物～鬣狗\', \'flavor\': \'荒土中腐肉稀缺，於沙漠中遊蕩的鬣狗常常成群狩獵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429531&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e9e91a60-653f-404c-bec3-75d1c1beb8fe\', \'multiverseId\': 429531}, \'multiverseid\': 429531}]', '[{\'name\': \'Hüter der Toten\', \'text\': \'Schicke die Hüter der Toten ins Exil: Jeder Gegner bestimmt zwei Karten in seinem Friedhof und schickt den Rest ins Exil.\', \'type\': \'Artefaktkreatur — Katze\', \'flavor\': \'Ihre Aufgabe ist es, den Eingang zu den Balsamierungskammern zu bewachen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427209&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9c7ceed6-79bd-458b-b0ce-5ae31670a477\', \'multiverseId\': 427209}, \'multiverseid\': 427209}, {\'name\': \'Vigilantes de los muertos\', \'text\': \'Exiliar los Vigilantes de los muertos: Cada oponente elige dos cartas de su cementerio y exilia el resto.\', \'type\': \'Criatura artefacto — Felino\', \'flavor\': \'Su cometido es proteger la entrada a las cámaras de embalsamamiento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427478&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2d43ec91-fa58-4a25-9502-fad82e15b0bb\', \'multiverseId\': 427478}, \'multiverseid\': 427478}, {\'name\': \'Gardiens des morts\', \'text\': \'Exilez les Gardiens des morts : Chaque adversaire choisit deux cartes dans son cimetière et exile le reste.\', \'type\': \'Créature-artefact : chat\', \'flavor\': "Leur devoir est de protéger l\'entrée des chambres d\'embaumement.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8bc6d0ab-5e88-416d-8c21-cb0943afdd85\', \'multiverseId\': 427747}, \'multiverseid\': 427747}, {\'name\': \'Sorveglianti dei Morti\', \'text\': \'Esilia i Sorveglianti dei Morti: Ogni avversario sceglie due carte dal proprio cimitero ed esilia le altre.\', \'type\': \'Creatura Artefatto — Felino\', \'flavor\': "Il loro compito è proteggere l\'accesso alle camere di imbalsamazione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428016&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e51734a-1143-4ffb-9388-9144f2f13854\', \'multiverseId\': 428016}, \'multiverseid\': 428016}, {\'name\': \'死者の番人\', \'text\': \'死者の番人を追放する：各対戦相手はそれぞれ自分の墓地にあるカード２枚を選び、残りを追放する。\', \'type\': \'アーティファクト・クリーチャー — 猫\', \'flavor\': \'彼らは不朽の玄室の入り口を守護する役目を負っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428285&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74c71a60-b71b-43e3-ab7f-984f39c1243a\', \'multiverseId\': 428285}, \'multiverseid\': 428285}, {\'name\': \'망자 주시자\', \'text\': \'망자 주시자를 추방한다: 각 상대는 자신의 무덤에서 카드 두 장을 선택하고 나머지는 추방한다.\', \'type\': \'마법물체 생물 — 고양이\', \'flavor\': \'고양이들은 방부처리실로 들어가는 입구를 지킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428554&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f5354552-59ae-49c7-9d08-875862c0adde\', \'multiverseId\': 428554}, \'multiverseid\': 428554}, {\'name\': \'Vigias dos Mortos\', \'text\': \'Exile Vigias dos Mortos: Cada oponente escolhe dois cards do próprio cemitério e exila o restante.\', \'type\': \'Criatura Artefato — Felino\', \'flavor\': \'A tarefa deles é proteger a entrada das câmaras de embalsamamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428823&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'207e7d30-668c-4485-9444-f1b7ee84c0bc\', \'multiverseId\': 428823}, \'multiverseid\': 428823}, {\'name\': \'Стражи Мертвых\', \'text\': \'Изгоните Стражей Мертвых: каждый оппонент выбирает две карты на своем кладбище и изгоняет остальные.\', \'type\': \'Артефакт Существо — Кошка\', \'flavor\': \'Им поручено охранять вход в залы бальзамирования.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429092&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'740bb512-7a53-4622-b6de-7830c3088bf5\', \'multiverseId\': 429092}, \'multiverseid\': 429092}, {\'name\': \'亡者守卫\', \'text\': \'放逐亡者守卫：每位对手各从其坟墓场中选择两张牌，并将其余的牌放逐。\', \'type\': \'神器生物～猫\', \'flavor\': \'它们负责守护通向防腐室的入口。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429361&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e563b62c-fc87-4fc0-bc1c-7a2257eaab00\', \'multiverseId\': 429361}, \'multiverseid\': 429361}, {\'name\': \'亡者守衛\', \'text\': \'放逐亡者守衛：每位對手各從其墳墓場中選擇兩張牌，並將其餘的牌放逐。\', \'type\': \'神器生物～貓\', \'flavor\': \'牠們負責守護通向防腐室的入口。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429630&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cac3f94b-c747-4310-abab-dc6b6649fc12\', \'multiverseId\': 429630}, \'multiverseid\': 429630}]', '[{\'name\': \'Illusorische Bandagen\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur hat Basis-Stärke und -Widerstandskraft 0/2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Exzessive Kraft wird dich hier nicht zum Erfolg führen. Akzeptiere die Beschränkungen des Körpers und öffne dich den unbegrenzten Möglichkeiten des Verstandes!" —Kefnet, Gott des Wissens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427029&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a461097a-1cbc-448c-afcf-065b6f8aad58\', \'multiverseId\': 427029}, \'multiverseid\': 427029}, {\'name\': \'Vendajes ilusorios\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene una fuerza y resistencia base de 0/2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Por mucha que sea tu fuerza, no te ayudará a superar mi prueba. Debes prepararte para renunciar a tu cuerpo y anteponer tu mente". —Kefnet, dios del conocimiento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427298&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8cbfe507-a044-42cb-8458-f120d4f0a41b\', \'multiverseId\': 427298}, \'multiverseid\': 427298}, {\'name\': \'Bandelettes illusoires\', \'text\': \'Enchanter : créature\\nLa créature enchantée a une force et une endurance de base de 0/2.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« La force ne vous aidera pas à surmonter mon épreuve. Vous devrez abandonner votre corps et utiliser votre esprit. » —Kefnet, dieu de la Connaissance\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427567&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'abb219da-0ac2-4311-a2ec-684573983968\', \'multiverseId\': 427567}, \'multiverseid\': 427567}, {\'name\': \'Bendaggi Illusori\', \'text\': \'Incanta creatura\\nLa creatura incantata ha forza e costituzione base 0/2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Non c\\\'è forza al mondo che vi aiuterà a superare la mia ordalia. Dovete essere pronti a sacrificare il vostro corpo a favore della mente." —Kefnet, dio della conoscenza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427836&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'757fb8d6-4b7c-4b04-bd76-cd77311106ac\', \'multiverseId\': 427836}, \'multiverseid\': 427836}, {\'name\': \'錯覚の覆い\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは基本のパワーとタフネスが０/２になる。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「どれほど力があろうと我が試練を乗り越える助けにはならぬ。身体を忘れ精神を選ぶ必要があるのだ。」 ――知識の神、ケフネト\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428105&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8939060e-1365-4af1-80b6-9a40e1d56f8d\', \'multiverseId\': 428105}, \'multiverseid\': 428105}, {\'name\': \'환영 붕대\', \'text\': \'생물에게 부여\\n부여된 생물의 기본 공격력과 방어력은 0/2이다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"힘은 내 시험을 통과하는 데 아무 도움이 안 된다. 육체의 힘을 버리고 정신의 힘을 사용해야 한다." —지식의 신 케프넷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428374&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ebfc4168-d240-4db0-8842-d30e982a2238\', \'multiverseId\': 428374}, \'multiverseid\': 428374}, {\'name\': \'Ataduras Ilusórias\', \'text\': \'Encantar criatura\\nA criatura encantada tem 0/2 de poder e resistência básicos.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Nenhuma quantidade de força pode ajudá-lo a superar minha prova. Você precisa estar pronto para renegar seu corpo e favorecer sua mente." — Kefnet, deus do conhecimento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428643&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bf09787c-833a-4dd1-9903-4367e4c3e6f6\', \'multiverseId\': 428643}, \'multiverseid\': 428643}, {\'name\': \'Иллюзорные Бинты\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет базовую силу и выносливость 0/2.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Богатырская сила не поможет тебе пройти мое испытание. Ты должен быть готов отринуть свое тело и упражнять разум». — Кефнет, бог знания\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428912&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ea39617-95df-47af-a6dd-ca021255a954\', \'multiverseId\': 428912}, \'multiverseid\': 428912}, {\'name\': \'迷纱缠绕\', \'text\': \'结附于生物\\n所结附的生物之基础力量和防御力为0/2。\', \'type\': \'结界～灵气\', \'flavor\': \'「你力量再大也无法通过我的祀炼。你必须忘却自己的肉身，专注心智。」 ～知识之神刻法涅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429181&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14954f76-d853-41a4-ad22-8ce34686d221\', \'multiverseId\': 429181}, \'multiverseid\': 429181}, {\'name\': \'迷紗纏繞\', \'text\': \'結附於生物\\n所結附的生物之基礎力量和防禦力為0/2。\', \'type\': \'結界～靈氣\', \'flavor\': \'「你力量再大也無法通過我的祀煉。你必須忘卻自己的肉身，專注心智。」 ～知識之神刻法涅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429450&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fa7e3a99-7a3a-4c6d-92cb-30afb1271419\', \'multiverseId\': 429450}, \'multiverseid\': 429450}]', '[{\'name\': \'Im Namen Oketras\', \'text\': \'Zombies, die du kontrollierst, erhalten +2/+1 bis zum Ende des Zuges. Andere Kreaturen, die du kontrollierst, erhalten +1/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein einzelnes Sandkorn ist bedeutungslos, aber ein Sandsturm kann Pyramiden zu Staub zermahlen. Steht Seite an Seite mit eurer Saat. Entfesselt einen Sturm." —Oketra, Göttin des Zusammenhalts\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=426990&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7cdc698a-b002-48e9-b41f-7daea45ba043\', \'multiverseId\': 426990}, \'multiverseid\': 426990}, {\'name\': \'En nombre de Oketra\', \'text\': \'Los Zombies que controlas obtienen +2/+1 hasta el final del turno. Las otras criaturas que controlas obtienen +1/+1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Un grano de arena es insignificante, pero una tormenta de arena puede convertir pirámides en polvo. No te separes de tu simiente. Conviértete en la tormenta". —Oketra, diosa de la solidaridad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427259&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bfc350bf-1f10-4684-8091-7b8de497c760\', \'multiverseId\': 427259}, \'multiverseid\': 427259}, {\'name\': "Au nom d\'Oketra", \'text\': "Les zombies que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour. Les autres créatures que vous contrôlez gagnent +1/+1 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Un grain de sable seul est insignifiant, mais une tempête de sable peut réduire des pyramides en poussière. Unissez-vous à votre moisson. Devenez la tempête. » —Oketra, déesse de la Solidarité\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427528&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'110e848f-dfe8-4e11-9324-35524cc21ca3\', \'multiverseId\': 427528}, \'multiverseid\': 427528}, {\'name\': \'In Nome di Oketra\', \'text\': \'Gli Zombie che controlli prendono +2/+1 fino alla fine del turno. Le altre creature che controlli prendono +1/+1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Un granello di sabbia è insignificante, ma una tempesta di sabbia può ridurre le piramidi in polvere. Non separatevi dalla messe: solo uniti sarete come la tempesta." —Oketra, dea della fratellanza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427797&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c5df8b1-fc87-4925-be59-8b8d7eccd083\', \'multiverseId\': 427797}, \'multiverseid\': 427797}, {\'name\': \'オケチラの名のもとに\', \'text\': \'ターン終了時まで、あなたがコントロールするゾンビは＋２/＋１の修整を受ける。ターン終了時まで、あなたがコントロールするゾンビでないクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「砂の一粒などたかが知れている。だが、砂嵐にはピラミッドさえも塵に還す力がある。一門とともに立ち、嵐となれ。」 ――結束の神、オケチラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428066&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc83dc3c-a9a1-4ff2-8638-7209d637a31b\', \'multiverseId\': 428066}, \'multiverseid\': 428066}, {\'name\': \'오케트라의 이름으로\', \'text\': \'당신이 조종하는 좀비들은 턴종료까지 +2/+1을 받는다. 당신이 조종하는 다른 생물들은 턴종료까지 +1/+1을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'"모래 한 알은 보잘것없지만 모래 폭풍은 피라미드도 무너뜨릴 수 있다. 입문자들과 힘을 합쳐 폭풍이 되어라." —결속의 신 오케트라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428335&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e0c36bc7-5b9b-453f-8eef-e4bf2971f14f\', \'multiverseId\': 428335}, \'multiverseid\': 428335}, {\'name\': \'Em Nome de Oketra\', \'text\': \'Os Zumbis que você controla recebem +2/+1 até o final do turno. As outras criaturas que você controla recebem +1/+1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um único grão de areia é insignificante, mas uma tempestade de areia pode reduzir pirâmides a pó. Una-se a sua safra. Torne-se a tempestade." — Oketra, deusa da solidariedade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428604&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'064fb265-760c-4d1e-933c-c13174480676\', \'multiverseId\': 428604}, \'multiverseid\': 428604}, {\'name\': \'Во Имя Окетры\', \'text\': \'Зомби под вашим контролем получают +2/+1 до конца хода. Другие существа под вашим контролем получают +1/+1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Одна песчинка ни на что не способна, но песчаная буря может даже пирамиды обратить в прах. Стой плечом к плечу со снопом. Стань бурей». — Окетра, богиня сплоченности\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428873&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1e107d75-e3ca-437f-ac19-4898e7729045\', \'multiverseId\': 428873}, \'multiverseid\': 428873}, {\'name\': \'以欧柯塔之名\', \'text\': \'由你操控的灵俑得+2/+1直到回合结束。由你操控的其他生物得+1/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「单颗沙砾虽不起眼，但一股沙暴能将金字塔化作灰土。与你们的祀群并肩而战。聚沙成暴。」 ～团结之神欧柯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429142&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'afa5a9ac-82f9-454b-9053-52f3a9e05c9e\', \'multiverseId\': 429142}, \'multiverseid\': 429142}, {\'name\': \'以歐柯塔之名\', \'text\': \'由你操控的殭屍得+2/+1直到回合結束。由你操控的其他生物得+1/+1直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「單顆沙礫雖不起眼，但一股沙暴能將金字塔化作灰土。與你們的祀群並肩而戰，聚沙成暴。」 ～團結之神歐柯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429411&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'61e6a834-b70a-4fea-9090-731be15c1337\', \'multiverseId\': 429411}, \'multiverseid\': 429411}]', '[{\'name\': \'Infizierende Mumie\', \'text\': \'Wenn die Infizierende Mumie ins Spiel kommt, wirft jeder Spieler eine Karte ab.\', \'type\': \'Kreatur — Zombie, Schakal\', \'flavor\': \'Ihr Atem geht ohne Umweg über die Nase direkt ins Gehirn und verschmutzt den Verstand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427071&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47f54110-fbf4-458c-b3d9-0672b503fd66\', \'multiverseId\': 427071}, \'multiverseid\': 427071}, {\'name\': \'Momia del miasma\', \'text\': \'Cuando la Momia del miasma entre al campo de batalla, cada jugador descarta una carta.\', \'type\': \'Criatura — Chacal zombie\', \'flavor\': \'Su hálito no ataca los sentidos, sino que contamina la mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427340&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b3bbd09-8fe1-431f-9126-0c2f1760143c\', \'multiverseId\': 427340}, \'multiverseid\': 427340}, {\'name\': \'Momie miasmatique\', \'text\': "Quand la Momie miasmatique arrive sur le champ de bataille, chaque joueur se défausse d\'une carte.", \'type\': \'Créature : zombie et chacal\', \'flavor\': "Son haleine n\'importune pas les sens. Elle pollue l\'esprit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427609&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d6149f4-7c61-4de3-b438-894e155334d1\', \'multiverseId\': 427609}, \'multiverseid\': 427609}, {\'name\': \'Mummia Mefitica\', \'text\': \'Quando la Mummia Mefitica entra nel campo di battaglia, ogni giocatore scarta una carta.\', \'type\': \'Creatura — Sciacallo Zombie\', \'flavor\': \'Il suo respiro non assale i sensi: contamina la mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=427878&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f19757b3-8aae-42f1-bfdf-4a9abbdacf97\', \'multiverseId\': 427878}, \'multiverseid\': 427878}, {\'name\': \'瘴気ミイラ\', \'text\': \'瘴気ミイラが戦場に出たとき、各プレイヤーはそれぞれカード１枚を捨てる。\', \'type\': \'クリーチャー — ゾンビ・ジャッカル\', \'flavor\': \'その息は感覚を侵さずに精神を汚染する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428147&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd5d3d87-0ed0-47e1-b042-b240fba920d7\', \'multiverseId\': 428147}, \'multiverseid\': 428147}, {\'name\': \'독기의 미라\', \'text\': \'독기의 미라가 전장에 들어올 때, 각 플레이어는 카드 한 장을 버린다.\', \'type\': \'생물 — 좀비 자칼\', \'flavor\': \'그것의 숨결은 감각을 공격하는 게 아니라 정신을 오염시킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428416&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'33af9589-961c-4011-ad33-0e814554ec72\', \'multiverseId\': 428416}, \'multiverseid\': 428416}, {\'name\': \'Múmia Miasmática\', \'text\': \'Quando Múmia Miasmática entra no campo de batalha, cada jogador descarta um card.\', \'type\': \'Criatura — Zumbi Chacal\', \'flavor\': \'Seu hálito não agride os sentidos. Ele polui a mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428685&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33384797-fef4-445b-bd7c-ff1a4d774fca\', \'multiverseId\': 428685}, \'multiverseid\': 428685}, {\'name\': \'Зловонная Мумия\', \'text\': \'Когда Зловонная Мумия выходит на поле битвы, каждый игрок сбрасывает карту.\', \'type\': \'Существо — Зомби Шакал\', \'flavor\': \'Ее дыхание не атакует чувства. Оно загрязняет разум.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=428954&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93056b78-c6b2-461b-8e0b-a864d32a2e95\', \'multiverseId\': 428954}, \'multiverseid\': 428954}, {\'name\': \'瘴气木乃伊\', \'text\': \'当瘴气木乃伊进战场时，每位牌手各弃一张牌。\', \'type\': \'生物～灵俑／豺狼\', \'flavor\': \'其气息不侵袭感官，而是污染心灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429223&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83af97ea-7726-4759-8ac0-3f34a54b0a1b\', \'multiverseId\': 429223}, \'multiverseid\': 429223}, {\'name\': \'瘴氣木乃伊\', \'text\': \'當瘴氣木乃伊進戰場時，每位玩家各棄一張牌。\', \'type\': \'生物～殭屍／豺狼\', \'flavor\': \'其氣息不侵襲感官，而是污染心靈。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=429492&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'db32a35d-686b-465e-b548-060230181d06\', \'multiverseId\': 429492}, \'multiverseid\': 429492}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None,