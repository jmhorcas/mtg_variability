rulings: ["[{'date': '2004-10-04', 'text': 'Either or both creatures can be tapped prior to using the ability and it still works.'}, {'date': '2004-10-04', 'text': 'In multiplayer games, you can choose a different opposing player each time it the ability is activated.'}, {'date': '2004-10-04', 'text': 'The power of the creatures when the effect resolves is used to determine how much damage is done.'}, {'date': '2006-09-25', 'text': 'If either target is illegal at the time the ability resolves (whether because it has left the battlefield, because it has gained Shroud or Protection, or for any other reason), the ability taps the remaining target, but no damage is dealt. If both targets are illegal, the ability doesn’t resolve.'}]", "[{'date': '2008-08-01', 'text': 'If the creature is neither an attacking creature nor a blocking creature at the time the spell resolves, it will have no effect.'}, {'date': '2008-08-01', 'text': 'This spell can target any creature. The check for whether that creature is attacking or blocking made on resolution, and it will have the appropriate effect at that time.'}]", "[{'date': '2020-08-07', 'text': 'No player may choose to take actions between determining the result of the flip and damage being dealt if you lost the flip.'}]"]
