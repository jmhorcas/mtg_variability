5172-42d7-8379-e128c95ffd9d', 'multiverseId': 422719}, 'multiverseid': 422719}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423070&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9a6b7b6b-1039-4f06-96c6-0cd5fd81acfd', 'multiverseId': 423070}, 'multiverseid': 423070}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421315&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3310c223-a172-49f1-ac67-5fb9a967c580', 'multiverseId': 421315}, 'multiverseid': 421315}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421667&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ba63429b-8818-4438-9907-9665aaf0d33d', 'multiverseId': 421667}, 'multiverseid': 421667}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423422&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9859d5a7-f0b5-4ac1-a7fe-02321017de0a', 'multiverseId': 423422}, 'multiverseid': 423422}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422018&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9bb73ae8-77f1-4ef9-9655-0e50a3f624ee', 'multiverseId': 422018}, 'multiverseid': 422018}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422369&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '470fa23f-87a4-4296-b49b-c4d4bda0b6b4', 'multiverseId': 422369}, 'multiverseid': 422369}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422720&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0c2fa822-cdd7-4d2b-a831-df0ef850ba16', 'multiverseId': 422720}, 'multiverseid': 422720}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423071&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db84a108-b92b-4e2e-86ba-07ecce2ed31e', 'multiverseId': 423071}, 'multiverseid': 423071}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421316&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f46af65b-b932-4f88-887a-866f0d792599', 'multiverseId': 421316}, 'multiverseid': 421316}]", '[{\'name\': \'Gehärtete Schuppen\', \'text\': \'Falls eine oder mehrere +1/+1-Marken auf eine Kreatur gelegt würden, die du kontrollierst, werden stattdessen so viele plus eine +1/+1-Marken auf sie gelegt.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Naga werfen ihre Schuppen ab. Wir tragen unsere mit Stolz." —Golran, Hauptmann der Drachenschuppen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421471&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de896bee-3f4a-4535-8905-3f1fe55d1bc0\', \'multiverseId\': 421471}, \'multiverseid\': 421471}, {\'name\': \'Escamas endurecidas\', \'text\': \'Si fueran a colocarse uno o más contadores +1/+1 sobre una criatura que controlas, en vez de eso, se coloca esa misma cantidad más uno de contadores +1/+1 sobre ella.\', \'type\': \'Encantamiento\', \'flavor\': \'"Los naga mudaron sus escamas. Nosotros llevamos las nuestras con orgullo". —Golran, capitana escamadragón\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423226&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'340cda60-a898-4606-a7cc-70a83f53dcb1\', \'multiverseId\': 423226}, \'multiverseid\': 423226}, {\'name\': \'Écailles renforcées\', \'text\': \'Si au moins un marqueur +1/+1 devait être placé sur une créature que vous contrôlez, autant de marqueurs +1/+1 plus un sont placés sur elle à la place.\', \'type\': \'Enchantement\', \'flavor\': \'« Les nagas perdent leurs écailles. Nous portons les nôtres avec fierté. » —Golrâne, capitaine écailledragon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421822&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42945c9b-efed-481d-a819-32dd4b87902b\', \'multiverseId\': 421822}, \'multiverseid\': 421822}, {\'name\': \'Scaglie Indurite\', \'text\': \'Se uno o più segnalini +1/+1 stanno per essere messi su una creatura che controlli, mettine invece uno in più su quella creatura.\', \'type\': \'Incantesimo\', \'flavor\': \'"I naga abbandonano le proprie scaglie. Noi indossiamo le nostre con orgoglio." —Golran, capitano della scaglia di drago\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422173&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'20f4b4c7-be0f-46b8-b58f-2a1f60a7b65f\', \'multiverseId\': 422173}, \'multiverseid\': 422173}, {\'name\': \'硬化した鱗\', \'text\': \'あなたがコントロールするクリーチャーの上に＋１/＋１カウンターが１個以上置かれるなら、代わりにその数に１を足した数の＋１/＋１カウンターをそれの上に置く。\', \'type\': \'エンチャント\', \'flavor\': \'「ナーガは鱗を脱ぎ捨てる。我々は鱗を誇りを持って身に付けている。」 ――龍鱗隊隊長、ゴルラン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422524&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2930310d-9d49-49e9-905b-178456c8cf79\', \'multiverseId\': 422524}, \'multiverseid\': 422524}, {\'name\': \'Escamas Endurecidas\', \'text\': \'Se um ou mais marcadores +1/+1 seriam colocados em uma criatura que você controla, em vez disso, será colocado aquele número de marcadores +1/+1 mais um.\', \'type\': \'Encantamento\', \'flavor\': \'"As Nagas arrancaram suas escamas. Nós vestimos as nossas com orgulho." — Golran, capitão da escama do dragão\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422875&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d053760a-b570-40e5-94ad-679f6c5d878c\', \'multiverseId\': 422875}, \'multiverseid\': 422875}, {\'name\': \'坚固鳞甲\', \'text\': \'如果将会在由你操控的生物上放置一个或数个+1/+1指示物，则改为在其上放置该数量加一的+1/+1指示物。\', \'type\': \'结界\', \'flavor\': \'「那伽视蜕鳞皮为常。我们以着鳞甲为荣。」 ～龙鳞队长高勒岚\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421120&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17f9ea5d-c624-4272-bfe2-ed756fe0ef82\', \'multiverseId\': 421120}, \'multiverseid\': 421120}]', '[{\'name\': \'Geiernder Zombie\', \'text\': \'Fliegend\\nImmer wenn eine Karte von irgendwoher auf den Friedhof eines Gegners gelegt wird, lege eine +1/+1-Marke auf den Geiernden Zombie.\', \'type\': \'Kreatur — Pflanze, Zombie\', \'flavor\': \'„Wenn etwas stirbt, profitiert alles davon. Na gut, dann halt nur unsere Sachen." —Ezoc, Golgari-Verrottungsfarmer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421547&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1be1c2e6-4860-4a01-9482-121bb875e86a\', \'multiverseId\': 421547}, \'multiverseid\': 421547}, {\'name\': \'Zombie abuitrado\', \'text\': \'Vuela.\\nSiempre que una carta vaya al cementerio de un oponente desde cualquier parte, pon un contador +1/+1 sobre el Zombie abuitrado.\', \'type\': \'Criatura — Planta zombie\', \'flavor\': \'"Cuando algo muere, todas las cosas se benefician. Bueno, es cierto, solo nuestras cosas". —Ézoc, granjero de podredumbre golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423302&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8a4539c5-f07b-4c63-b0e3-089f6a869e5b\', \'multiverseId\': 423302}, \'multiverseid\': 423302}, {\'name\': \'Zombie rapace\', \'text\': "Vol\\nÀ chaque fois qu\'une carte est mise dans le cimetière d\'un adversaire d\'où qu\'elle vienne, mettez un marqueur +1/+1 sur le Zombie rapace.", \'type\': \'Créature : plante et zombie\', \'flavor\': "« Si quelque chose meurt, tout le monde en profite. D\'accord, je l\'admets. On en profite. » —Ezoc, putré-fermier golgari", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421898&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1e44edb0-9abc-4b57-a4c6-c3d281e24f7d\', \'multiverseId\': 421898}, \'multiverseid\': 421898}, {\'name\': \'Zombie Rapace\', \'text\': \'Volare\\nOgniqualvolta una carta viene messa nel cimitero di un avversario da qualsiasi zona, metti un segnalino +1/+1 sullo Zombie Rapace.\', \'type\': \'Creatura — Zombie Pianta\', \'flavor\': \'"Quando qualcosa muore, tutto ne trae beneficio. Beh, va bene, solo le nostre cose." —Ezoc, putrificatore Golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422249&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c0d29771-c906-4077-9957-2df0989a9235\', \'multiverseId\': 422249}, \'multiverseid\': 422249}, {\'name\': \'禿鷹ゾンビ\', \'text\': \'飛行\\nカードが１枚いずれかの領域から対戦相手の墓地に置かれるたび、禿鷹ゾンビの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 植物・ゾンビ\', \'flavor\': \'「何かが死ぬと、全ての物が恵みを受けるんだ。まあ、正確には、俺らの物だけな。」 ――ゴルガリの腐敗農夫、イーゾック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422600&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d40c53a-ddce-4074-8bb7-eb0300cd0809\', \'multiverseId\': 422600}, \'multiverseid\': 422600}, {\'name\': \'Zumbi Predador\', \'text\': \'Voar\\nToda vez que um card for colocado no cemitério de um oponente vindo de qualquer lugar, coloque um marcador +1/+1 em Zumbi Predador.\', \'type\': \'Criatura — Planta Zumbi\', \'flavor\': \'"Quando algo morre, todas as coisas se beneficiam. Tudo bem, só as nossas coisas." — Ezoc, fazendeiro de podridão Golgari\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422951&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5549dfd-f861-482e-b950-ebe49e60a713\', \'multiverseId\': 422951}, \'multiverseid\': 422951}, {\'name\': \'兀鹰灵俑\', \'text\': \'飞行\\n每当一张牌从任何区域置入对手的坟墓场时，在兀鹰灵俑上放置一个+1/+1指示物。\', \'type\': \'生物～植物／灵俑\', \'flavor\': \'「不论什么死了，对所有东西都有好处。 好吧，不是所有，只有我们的东西。」 ～葛加理腐尸农夫伊作\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421196&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1f537f27-978e-44ac-b2bb-2ce734f2807d\', \'multiverseId\': 421196}, \'multiverseid\': 421196}]', '[{\'name\': \'Gemeinsame Reise\', \'text\': \'Zusammenarbeiten — Beginnend mit dir kann jeder Spieler eine beliebige Menge Mana bezahlen. Jeder Spieler durchsucht seine Bibliothek nach bis zu X Standardländern, wobei X die Summe des auf diese Weise bezahlten Manas ist, bringt sie getappt ins Spiel und mischt dann seine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421464&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d3feaec1-70f1-4e23-9644-16b50b7d4efd\', \'multiverseId\': 421464}, \'multiverseid\': 421464}, {\'name\': \'Viaje colectivo\', \'text\': \'Unir fuerzas — Comenzando contigo, cada jugador puede pagar cualquier cantidad de maná. Cada jugador busca en su biblioteca hasta X cartas de tierra básica, donde X es la cantidad total de maná pagado de esta manera, las pone en el campo de batalla giradas y luego baraja su biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423219&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d43f15fb-1359-4a50-b385-d042f789b5cb\', \'multiverseId\': 423219}, \'multiverseid\': 423219}, {\'name\': \'Voyage collectif\', \'text\': "Union des forces — En commençant par vous, chaque joueur peut payer n\'importe quelle quantité de mana. Chaque joueur cherche dans sa bibliothèque jusqu\'à X cartes de terrains de base, X étant la quantité totale de mana payée de cette manière, les met sur le champ de bataille engagées et mélange ensuite sa bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421815&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4310f7e-a939-414c-ac31-e8ec626afaaf\', \'multiverseId\': 421815}, \'multiverseid\': 421815}, {\'name\': \'Viaggio Collettivo\', \'text\': "Unire le forze — A partire da te, ogni giocatore può pagare un qualsiasi ammontare di mana. Ogni giocatore passa in rassegna il proprio grimorio per trovare fino a X carte terra base, dove X è l\'ammontare totale di mana pagato in questo modo, le mette sul campo di battaglia TAPpate, poi rimescola il proprio grimorio.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422166&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dcdc750d-44a7-44ac-b669-c5e4b0abf3cb\', \'multiverseId\': 422166}, \'multiverseid\': 422166}, {\'name\': \'集団的航海\', \'text\': \'同調 ― あなたから始めて、各プレイヤーはそれぞれ、望む点数のマナを支払ってもよい。各プレイヤーはそれぞれ、自分のライブラリーから基本土地・カード最大Ｘ枚を探し、それらをタップ状態で戦場に出し、その後自分のライブラリーを切り直す。Ｘはこれにより支払われたマナの点数の合計に等しい。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422517&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75c14fd3-40d7-4916-a648-45a11746c818\', \'multiverseId\': 422517}, \'multiverseid\': 422517}, {\'name\': \'Viagem Coletiva\', \'text\': \'Unir forças — A começar por você, cada jogador pode pagar qualquer quantidade de mana. Cada jogador procura no próprio grimório até X cards de terreno básico, sendo X o total de mana pago desta forma, coloca-os no campo de batalha virados e, em seguida, embaralha o próprio grimório.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422868&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50aa3247-273f-4cc9-8ef4-9b0cbe619c97\', \'multiverseId\': 422868}, \'multiverseid\': 422868}, {\'name\': \'集体远行\', \'text\': \'携手～从你开始，每位牌手各可以支付任意数量的法术力。每位牌手各从其牌库中搜寻至多X张基本地牌，将之横置进战场，然后将其牌库洗牌，X为以此法支付的法术力总数量。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421113&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6d3bf5c8-3b18-485a-8da7-2373500e8985\', \'multiverseId\': 421113}, \'multiverseid\': 421113}]', '[{\'name\': \'Geröll-Moloch\', \'text\': \'Stärke und Widerstandskraft des Geröll-Molochs sind gleich der Anzahl an Ländern, die du kontrollierst.\\nBlutrausch — {1}{R}{G}, wirf den Geröll-Moloch ab: Eine angreifende Kreatur deiner Wahl erhält +X/+X bis zum Ende des Zuges, wobei X gleich der Anzahl an Ländern ist, die du kontrollierst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421538&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a11fbb3e-6060-428e-bfcb-ae574b2e6b6f\', \'multiverseId\': 421538}, \'multiverseid\': 421538}, {\'name\': \'Titán de escombros\', \'text\': \'Tanto la fuerza como la resistencia del Titán de escombros son iguales el número de tierras que controlas.\\nEmpujón — {1}{R}{G}, descartar el Titán de escombros: La criatura atacante objetivo obtiene +X/+X hasta el final del turno, donde X es el número de tierras que controlas.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423293&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4bccf003-016f-45f5-b4ef-949cf37adf1e\', \'multiverseId\': 423293}, \'multiverseid\': 423293}, {\'name\': \'Carcasse de gravois\', \'text\': "La force et l\'endurance de la Carcasse de gravois sont chacune égales au nombre de terrains que vous contrôlez.\\nCoup de sang — {1}{R}{G}, défaussez-vous de la Carcasse de gravois : La créature attaquante ciblée gagne +X/+X jusqu\'à la fin du tour, X étant le nombre de terrains que vous contrôlez.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421889&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c4ba03e-cb12-4109-91bd-56a0167d42d9\', \'multiverseId\': 421889}, \'multiverseid\': 421889}, {\'name\': \'Colosso di Macerie\', \'text\': \'La forza e la costituzione del Colosso di Macerie sono pari al numero di terre che controlli.\\nImpeto sanguinario — {1}{R}{G}, Scarta il Colosso di Macerie: Una creatura attaccante bersaglio prende +X/+X fino alla fine del turno, dove X è pari al numero di terre che controlli.\', \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422240&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'245ddc7e-c638-4cb9-89ab-76e86c824eb8\', \'multiverseId\': 422240}, \'multiverseid\': 422240}, {\'name\': \'瓦礫鬼\', \'text\': \'瓦礫鬼のパワーとタフネスは、それぞれあなたがコントロールする土地の総数に等しい。\\n湧血 ― {1}{R}{G}, 瓦礫鬼を捨てる：攻撃クリーチャー１体を対象とする。ターン終了時まで、それは＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたがコントロールする土地の総数に等しい。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422591&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b152677-4caf-499b-b9e3-c008fd1b5eb4\', \'multiverseId\': 422591}, \'multiverseid\': 422591}, {\'name\': \'Brutamontes de Escombros\', \'text\': \'O poder e a resistência de Brutamontes de Escombros são ambos iguais ao número de terrenos que você controla.\\nImpulso sanguinário — {1}{R}{G}, Descarte Brutamontes de Escombros: A criatura atacante alvo recebe +X/+X até o final do turno, sendo X o número de terrenos que você controla.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422942&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a2521733-002f-4979-a780-27b9af76a212\', \'multiverseId\': 422942}, \'multiverseid\': 422942}, {\'name\': \'瓦砾巨汉\', \'text\': \'瓦砾巨汉的力量和防御力各等同于由你操控的地数量。\\n血激～{1}{R}{G}，弃掉瓦砾巨汉：目标进行攻击的生物得+X/+X直到回合结束，X等同于由你操控的地数量。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421187&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec62d04c-c7a0-4e57-ba60-a0aa23f4b3d3\', \'multiverseId\': 421187}, \'multiverseid\': 421187}]', '[{\'name\': \'Gespenstisches Gefängnis\', \'text\': \'Kreaturen können dich nicht angreifen, es sei denn, ihr Beherrscher bezahlt {2} für jede dich angreifende Kreatur, die er kontrolliert.\', \'type\': \'Verzauberung\', \'flavor\': \'„Möge die Erinnerung an unsere gefallenen Helden die ungestümen Seelen niederer Männer bändigen." —Inschrift der Großen Schwelle von Monserkat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421385&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5558f28d-cbc1-45e4-814e-358a16e10d9a\', \'multiverseId\': 421385}, \'multiverseid\': 421385}, {\'name\': \'Prisión fantasmagórica\', \'text\': \'Las criaturas no pueden atacarte a menos que su controlador pague {2} por cada criatura que controla que te está atacando.\', \'type\': \'Encantamiento\', \'flavor\': \'"Que el recuerdo de nuestros héroes caídos atrape los corazones violentos de hombres menos valientes". —Inscripción en el Gran Umbral de Monserkat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423140&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb9c5176-6ecd-448b-9f8e-9c8b9eb2abd7\', \'multiverseId\': 423140}, \'multiverseid\': 423140}, {\'name\': \'Prison fantomale\', \'text\': "Les créatures ne peuvent pas vous attaquer à moins que leur contrôleur ne paie {2} pour chaque créature qu\'il contrôle qui vous attaque.", \'type\': \'Enchantement\', \'flavor\': \'« Que la mémoire de nos héros tombés ensorcelle les cœurs violents des impurs. » —Inscription du Grand Seuil de Monserkat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aaf1b4a0-b6fd-461a-83e9-3da675028d9a\', \'multiverseId\': 421736}, \'multiverseid\': 421736}, {\'name\': \'Prigione Spettrale\', \'text\': \'Le creature non possono attaccarti a meno che il loro controllore non paghi {2} per ogni creatura che controlla che ti sta attaccando.\', \'type\': \'Incantesimo\', \'flavor\': \'"Possa il ricordo dei nostri eroi caduti intrappolare i cuori violenti degli uomini inferiori." —Iscrizione sulla Grande Soglia di Monserkat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422087&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0bf0cc26-984a-4945-9cdd-aa3da439fda2\', \'multiverseId\': 422087}, \'multiverseid\': 422087}, {\'name\': \'亡霊の牢獄\', \'text\': \'そのコントローラーが、自分がコントロールするあなたを攻撃しているクリーチャー１体につき{2}を支払わないかぎり、クリーチャーではあなたを攻撃できない。\', \'type\': \'エンチャント\', \'flavor\': \'「死せる英雄たちの記憶が、小さき者の逸る心を虜にしますように。」 ――モンザーカットの大門口に刻まれた文句\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422438&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b9c439de-3a2d-4d47-9f86-82516c5d2810\', \'multiverseId\': 422438}, \'multiverseid\': 422438}, {\'name\': \'Prisão Fantasmagórica\', \'text\': \'As criaturas não podem atacá-lo a menos que seu controlador pague {2} para cada criatura daquele controlador que está atacando você.\', \'type\': \'Encantamento\', \'flavor\': \'"Que a lembrança de nossos heróis que tombaram aprese os corações violentos dos homens inferiores." — Inscrição no Grande Limiar de Monserkat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422789&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0527bd9-dc18-46cf-baab-47d6d545e8dd\', \'multiverseId\': 422789}, \'multiverseid\': 422789}, {\'name\': \'魂魅拘禁\', \'text\': \'对每个生物而言，除非其操控者为其支付{2}，否则它不能攻击你。\', \'type\': \'结界\', \'flavor\': \'「愿吾人阵亡勇士之记忆能压服劣族狂暴内心。」 ～蒙瑟卡大门铭文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421034&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'001bbf19-7a11-427c-8901-3236fafc6bed\', \'multiverseId\': 421034}, \'multiverseid\': 421034}]', '[{\'name\': \'Gewundenes Orakel\', \'text\': \'Wenn das Gewundene Orakel ins Spiel kommt, decke die oberste Karte deiner Bibliothek auf. Falls es eine Länderkarte ist, bringe sie ins Spiel. Nimm die Karte sonst auf deine Hand.\', \'type\': \'Kreatur — Ophis, Elf, Druide\', \'flavor\': \'Das Orakel verkörpert alles, was für Simic typisch ist: Häutung bedeutet ewigen Fortschritt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421507&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'412f2d45-d90c-4a80-81fd-bedc3ad4a7bc\', \'multiverseId\': 421507}, \'multiverseid\': 421507}, {\'name\': \'Oráculo serpenteante\', \'text\': \'Cuando el Oráculo serpenteante entre al campo de batalla, muestra la primera carta de tu biblioteca. Si es una carta de tierra, ponla en el campo de batalla. De lo contrario, pon esa carta en tu mano.\', \'type\': \'Criatura — Druida elfo víbora\', \'flavor\': \'Restos serpentinos de la naturaleza dirigidos por un cuerpo de pensamiento y progreso, los oráculos son la viva representación de todo lo simic.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423262&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb1786d8-e0f3-47ef-9378-0df35c8e81b2\', \'multiverseId\': 423262}, \'multiverseid\': 423262}, {\'name\': \'Oracle annelé\', \'text\': "Quand l\'Oracle annelé arrive sur le champ de bataille, révélez la carte du dessus de votre bibliothèque. Si c\'est une carte de terrain, mettez-la sur le champ de bataille. Sinon, mettez cette carte dans votre main.", \'type\': \'Créature : serpent et elfe et druide\', \'flavor\': "Une nature reptilienne et un corps de pensées et de progrès : les oracles étaient à l\'image de Simic.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421858&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9532e1ba-762c-42b8-adc4-219cbbfe20ef\', \'multiverseId\': 421858}, \'multiverseid\': 421858}, {\'name\': \'Oracolo Acciambellato\', \'text\': "Quando l\'Oracolo Acciambellato entra nel campo di battaglia, rivela la prima carta del tuo grimorio. Se è una carta terra, mettila sul campo di battaglia. Altrimenti, aggiungi quella carta alla tua mano.", \'type\': \'Creatura — Druido Elfo Serpente\', \'flavor\': \'Sinuose vestigia della natura controllate da un corpo di pensieri e sviluppo; gli oracoli incarnano tutto ciò che è Simic.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422209&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'62a4dc8d-ed65-435b-a37c-e99adf8cb086\', \'multiverseId\': 422209}, \'multiverseid\': 422209}, {\'name\': \'とぐろ巻きの巫女\', \'text\': \'とぐろ巻きの巫女が戦場に出たとき、あなたのライブラリーの一番上のカードを公開する。それが土地・カードであるなら、それを戦場に出す。そうでないなら、そのカードをあなたの手札に加える。\', \'type\': \'クリーチャー — 蛇・エルフ・ドルイド\', \'flavor\': \'曲がりくねる自然の面影が思考と進歩へとつながっている巫女の姿は、まさしくシミックそのものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422560&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5dfd1a77-02b5-43f2-b004-b0e3eb3a1d87\', \'multiverseId\': 422560}, \'multiverseid\': 422560}, {\'name\': \'Oráculo Enroscado\', \'text\': \'Quando Oráculo Enroscado entrar no campo de batalha, revele o card do topo de seu grimório. Se for um card de terreno, coloque-o no campo de batalha. Do contrário, coloque-o em sua mão.\', \'type\': \'Criatura — Cobra Elfo Druida\', \'flavor\': \'Remanescentes anguiformes da natureza dominados por um corpo de pensamentos e progresso, os oráculos representam tudo o que é Simic.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422911&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a0a0a1fb-7381-4464-a3da-7b6cbf045e99\', \'multiverseId\': 422911}, \'multiverseid\': 422911}, {\'name\': \'盘卷先知\', \'text\': \'当盘卷先知进战场时，展示你的牌库顶牌。若该牌是地牌，则将之放进战场。若否，则将该牌置于你手上。\', \'type\': \'生物～蛇／妖精／德鲁伊\', \'flavor\': \'可思考与创造的身体引导着阴险的自然残存者；此先知正是析米克的具现。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421156&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87764913-0e5e-42f0-9081-41d59bcd0787\', \'multiverseId\': 421156}, \'multiverseid\': 421156}]', '[{\'name\': \'Geätzte Weissagung\', \'text\': \'Sonneneruption (Diese Karte kommt mit einer +1/+1-Marke ins Spiel für jede unterschiedliche Farbe von Mana, das ausgegeben wurde, um sie zu wirken.)\\n{1}, entferne vier +1/+1-Marken von der Geätzten Weissagung: Ein Spieler deiner Wahl zieht drei Karten.\', \'type\': \'Artefaktkreatur — Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421571&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d4c4cf4-e6c2-4b6f-b872-4ae72ba2c1a1\', \'multiverseId\': 421571}, \'multiverseid\': 421571}, {\'name\': \'Oráculo grabado\', \'text\': \'Estallido solar. (Esta carta entra al campo de batalla con un contador +1/+1 sobre ella por cada color de maná usado para lanzarla.)\\n{1}, remover cuatro contadores +1/+1 del Oráculo grabado: El jugador objetivo roba tres cartas.\', \'type\': \'Criatura artefacto — Hechicero\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423326&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62e10dbd-0599-4472-b17e-f46dcf37f2d9\', \'multiverseId\': 423326}, \'multiverseid\': 423326}, {\'name\': \'Oracle gravé\', \'text\': "Solarisation (Cette carte arrive sur le champ de bataille avec, sur elle, un marqueur +1/+1 pour chaque couleur de mana dépensée pour la lancer.)\\n{1}, retirez quatre marqueurs +1/+1 de l\'Oracle gravé : Le joueur ciblé pioche trois cartes.", \'type\': \'Créature-artefact : sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421922&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bff85987-041c-4aef-ace9-75e1d7fa069c\', \'multiverseId\': 421922}, \'multiverseid\': 421922}, {\'name\': \'Oracolo Inciso\', \'text\': "Solarizzazione (Questa creatura entra nel campo di battaglia con un segnalino +1/+1 per ogni colore di mana speso per lanciarla.)\\n{1}, Rimuovi quattro segnalini +1/+1 dall\'Oracolo Inciso: Un giocatore bersaglio pesca tre carte.", \'type\': \'Creatura Artefatto — Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422273&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18fafc5e-7b0d-4634-b9b9-981e683a8ab7\', \'multiverseId\': 422273}, \'multiverseid\': 422273}, {\'name\': \'刻まれた巫女\', \'text\': \'烈日（これは、これを唱えるために使われたマナの色１色につき＋１/＋１カウンターが１個置かれた状態で戦場に出る。）\\n{1}, 刻まれた巫女の上から＋１/＋１カウンターを４個取り除く：プレイヤー１人を対象とする。そのプレイヤーはカードを３枚引く。\', \'type\': \'アーティファクト・クリーチャー — ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422624&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9e4e0d4b-8c75-4196-ab63-5f08249b5882\', \'multiverseId\': 422624}, \'multiverseid\': 422624}, {\'name\': \'Oráculo Daguerreotipado\', \'text\': \'Facho solar (Este card entra no campo de batalha com um marcador +1/+1 para cada cor de mana gasto para conjurá-lo.)\\n{1}, Remova quatro marcadores +1/+1 de Oráculo Daguerreotipado: O jogador alvo compra três cards.\', \'type\': \'Criatura Artefato — Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422975&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f47ce7a7-cd7c-45b5-9cb7-e425e33d78dd\', \'multiverseId\': 422975}, \'multiverseid\': 422975}, {\'name\': \'蚀刻先知\', \'text\': \'辉映（用过几种颜色的法术力来支付其费用，它进战场时上面便有几个+1/+1指示物。）\\n{1}，从蚀刻先知上移去四个+1/+1指示物：目标牌手抓三张牌。\', \'type\': \'神器生物～法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421220&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7aa4ba61-e345-4d94-8d18-a4ad34aff1fc\', \'multiverseId\': 421220}, \'multiverseid\': 421220}]', '[{\'name\': \'Ghave, Guru der Sporen\', \'text\': \'Ghave, Guru der Sporen kommt mit fünf +1/+1-Marken ins Spiel.\\n{1}, entferne eine +1/+1-Marke von einer Kreatur, die du kontrollierst: Erzeuge einen 1/1 grünen Saproling-Kreaturenspielstein.\\n{1}, opfere eine Kreatur: Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Legendäre Kreatur — Pilzwesen, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421519&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'941bdcf8-ed16-4865-9dee-0af9a82d3b1f\', \'multiverseId\': 421519}, \'multiverseid\': 421519}, {\'name\': \'Ghave, Gurú de las Esporas\', \'text\': \'Ghave, Gurú de las Esporas entra al campo de batalla con cinco contadores +1/+1 sobre él.\\n{1}, remover un contador +1/+1 de una criatura que controlas: Crea una ficha de criatura Saprolín verde 1/1.\\n{1}, sacrificar una criatura: Pon un contador +1/+1 sobre la criatura objetivo.\', \'type\': \'Criatura legendaria — Chamán hongo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423274&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8dab2bbf-9f9d-4e18-b7f9-cedf345a647f\', \'multiverseId\': 423274}, \'multiverseid\': 423274}, {\'name\': \'Ghaveh, gourou des spores\', \'text\': "Ghaveh, gourou des spores arrive sur le champ de bataille avec cinq marqueurs +1/+1 sur lui.\\n{1}, retirez un marqueur +1/+1 d\'une créature que vous contrôlez : Créez un jeton de créature 1/1 verte Saprobionte.\\n{1}, sacrifiez une créature : Mettez un marqueur +1/+1 sur la créature équipée.", \'type\': \'Créature légendaire : fongus et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421870&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09078525-2236-4d1b-a19f-cc132794e513\', \'multiverseId\': 421870}, \'multiverseid\': 421870}, {\'name\': \'Ghave, Guru delle Spore\', \'text\': \'Ghave, Guru delle Spore entra nel campo di battaglia con cinque segnalini +1/+1.\\n{1}, Rimuovi un segnalino +1/+1 da una creatura che controlli: Crea una pedina creatura Saprolingio 1/1 verde.\\n{1}, Sacrifica una creatura: Metti un segnalino +1/+1 su una creatura bersaglio.\', \'type\': \'Creatura Leggendaria — Sciamano Fungus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422221&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0de0e080-944a-48af-9a5b-dd7747dc6770\', \'multiverseId\': 422221}, \'multiverseid\': 422221}, {\'name\': \'胞子の教祖、ゲイヴ\', \'text\': \'胞子の教祖、ゲイヴは＋１/＋１カウンターが５個置かれた状態で戦場に出る。\\n{1}, あなたがコントロールするクリーチャー１体の上から＋１/＋１カウンターを１個取り除く：緑の１/１の苗木・クリーチャー・トークンを１体生成する。\\n{1}, クリーチャー１体を生け贄に捧げる：クリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'伝説のクリーチャー — ファンガス・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422572&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'048bf5f3-81d4-468f-91bb-8c933bcde16f\', \'multiverseId\': 422572}, \'multiverseid\': 422572}, {\'name\': \'Ghave, Guru dos Esporos\', \'text\': \'Ghave, Guru dos Esporos, entra no campo de batalha com cinco marcadores +1/+1.\\n{1}, Remova um marcador +1/+1 de uma criatura que você controla: Crie uma ficha de criatura verde 1/1 do tipo Saprófita.\\n{1}, Sacrifique uma criatura: Coloque um marcador +1/+1 na criatura alvo.\', \'type\': \'Criatura Lendária — Fungo Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422923&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6971ff87-f3b4-4a57-9c95-36394cd0941a\', \'multiverseId\': 422923}, \'multiverseid\': 422923}, {\'name\': \'孢子专家凯福\', \'text\': \'孢子专家凯福进战场时上面有五个+1/+1指示物。\\n{1}，从由你操控的生物上移去一个+1/+1指示物：派出一个1/1绿色腐生物衍生生物。\\n{1}，牺牲一个生物：在目标生物上放置一个+1/+1指示物。\', \'type\': \'传奇生物～真菌／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421168&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d81b5a73-01b5-422e-b738-680f0efdb88b\', \'multiverseId\': 421168}, \'multiverseid\': 421168}]', '[{\'name\': \'Glimmender Rochen\', \'text\': \'Wenn der Glimmende Rochen ins Spiel kommt, verdopple die Anzahl an Marken jeder Sorte auf einer beliebigen Anzahl an bleibenden Karten deiner Wahl.\', \'type\': \'Kreatur — Fisch\', \'flavor\': \'Grazil gleitet er über den Meeresboden und zeichnet ein Nachleuchten darauf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421326&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5237e794-9395-45f0-ae40-6779c9ed241c\', \'multiverseId\': 421326}, \'multiverseid\': 421326}, {\'name\': \'Raya fondoluz\', \'text\': \'Cuando la Raya fondoluz entre al campo de batalla, duplica la cantidad de cada tipo de contador en cualquier cantidad de permanentes objetivo.\', \'type\': \'Criatura — Pez\', \'flavor\': \'Sus gráciles movimientos pincelan el fondo del océano con brochazos luminiscentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423081&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa8c4a18-e4e2-44e8-89e9-ebd6f4bed372\', \'multiverseId\': 423081}, \'multiverseid\': 423081}, {\'name\': \'Raie bioluminescente\', \'text\': "Quand la Raie bioluminescente arrive sur le champ de bataille, doublez le nombre de chaque sorte de marqueur sur n\'importe quel nombre de permanents ciblés.", \'type\': \'Créature : poisson\', \'flavor\': \'Son déplacement gracieux peint les fonds marins de traits luminescents.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421677&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'50a03b2d-3b11-4834-99e2-36dd30b1051f\', \'multiverseId\': 421677}, \'multiverseid\': 421677}, {\'name\': \'Manta del Bagliore Abissale\', \'text\': \'Quando la Manta del Bagliore Abissale entra nel campo di battaglia, raddoppia il numero di ogni tipo di segnalino su un qualsiasi numero di permanenti bersaglio.\', \'type\': \'Creatura — Pesce\', \'flavor\': \'Il suo aggraziato fluttuare colora il fondale oceanico con pennellate di luminescenza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422028&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d681f79-76b1-47c5-8193-4391ead59aee\', \'multiverseId\': 422028}, \'multiverseid\': 422028}, {\'name\': \'深輝エイ\', \'text\': \'深輝エイが戦場に出たとき、望む数のパーマネントを対象とし、それらの上に置かれている各種類のカウンターの個数をそれぞれ２倍にする。\', \'type\': \'クリーチャー — 魚\', \'flavor\': \'その優美な泳ぎは海底に鮮やかな輝跡を描く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422379&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'df0cac6b-a46e-449f-b819-7172426b3761\', \'multiverseId\': 422379}, \'multiverseid\': 422379}, {\'name\': \'Arraia do Brilho Abissal\', \'text\': \'Quando Arraia do Brilho Abissal entrar no campo de batalha, dobre o número de cada tipo de marcador em qualquer número de permanentes alvo.\', \'type\': \'Criatura — Peixe\', \'flavor\': \'Seu planar gracioso pinta o fundo do oceano com pinceladas de luminescência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422730&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c989d9e6-cc8c-459a-b4e7-04e0a4deda87\', \'multiverseId\': 422730}, \'multiverseid\': 422730}, {\'name\': \'渊光鳐\', \'text\': \'当渊光鳐进战场时，选择任意数量的目标永久物。将这些永久物上面的各种指示物数量加倍。\', \'type\': \'生物～鱼\', \'flavor\': \'优雅曳动，缀海床以流光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420975&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1f84e3fd-ffe4-44c5-b160-2abfdaf6891a\', \'multiverseId\': 420975}, \'multiverseid\': 420975}]', '[{\'name\': \'Glitzeraugen-Nephilim\', \'text\': \'Immer wenn der Glitzeraugen-Nephilim einem Spieler Kampfschaden zufügt, ziehe entsprechend viele Karten.\\n{1}, wirf eine Karte ab: Der Glitzeraugen-Nephilim erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Nephilim\', \'flavor\': \'Als er erwachte, erschauderte die Welt unter dem Donner seiner Begierde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3db6ab27-6003-4340-b035-8758af202c40\', \'multiverseId\': 421520}, \'multiverseid\': 421520}, {\'name\': \'Nefilim ojo iluminado\', \'text\': \'Siempre que el Nefilim ojo iluminado haga daño de combate a un jugador, roba esa misma cantidad de cartas.\\n{1}, descartar una carta: El Nefilim ojo iluminado obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Nefilim\', \'flavor\': \'Cuando despertó, sacudió todo el plano con el trueno de su ansia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3eec71e3-fbe6-4a71-9f3c-d3fc62e4316e\', \'multiverseId\': 423275}, \'multiverseid\': 423275}, {\'name\': \'Nephilim brillœil\', \'text\': "À chaque fois que le Nephilim brillœil inflige des blessures de combat à un joueur, piochez autant de cartes.\\n{1}, défaussez-vous d\'une carte : Le Nephilim brillœil gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : nephilim\', \'flavor\': \'À son réveil, sa faim résonna dans tout le plan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421871&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc0476e5-2ba7-482f-b2ce-4b6bf01e872a\', \'multiverseId\': 421871}, \'multiverseid\': 421871}, {\'name\': \'Nephilim Occhiobrillante\', \'text\': \'Ogniqualvolta il Nephilim Occhiobrillante infligge danno da combattimento a un giocatore, pesca altrettante carte.\\n{1}, Scarta una carta: Il Nephilim Occhiobrillante prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Nephilim\', \'flavor\': \'Quando si svegliò, scosse il mondo con il fragore del proprio desiderio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422222&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'702b7e1c-b3af-43a5-ab7d-1377140e4a0d\', \'multiverseId\': 422222}, \'multiverseid\': 422222}, {\'name\': \'光り眼のネフィリム\', \'text\': \'光り眼のネフィリムがプレイヤー１人に戦闘ダメージを与えるたび、その点数に等しい枚数のカードを引く。\\n{1}, カード１枚を捨てる：ターン終了時まで、光り眼のネフィリムは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — ネフィリム\', \'flavor\': \'それが目覚めたとき、自らの渇望が稲妻となって次元を揺るがした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422573&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80d939d8-ed7d-4d85-9a88-2184ac5d310f\', \'multiverseId\': 422573}, \'multiverseid\': 422573}, {\'name\': \'Nefilim Olho-brilhante\', \'text\': \'Toda vez que Nefilim Olho-brilhante causar dano de combate a um jogador, compre o mesmo número em cards.\\n{1}, Descarte um card: Nefilim Olho-brilhante recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Nefilim\', \'flavor\': \'Quando acordou, estremeceu o plano com o trovejar de seu desejo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422924&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db80e92d-0c14-4ec7-b35b-e070b7f93258\', \'multiverseId\': 422924}, \'multiverseid\': 422924}, {\'name\': \'烁目巨神灵\', \'text\': \'每当烁目巨神灵对任一牌手造成战斗伤害时，抓等量的牌。\\n{1}，弃一张牌：烁目巨神灵得+1/+1直到回合结束。\', \'type\': \'生物～巨神灵\', \'flavor\': \'醒转时，大地因其行迹而颤抖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421169&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bb99b31-c7a5-4a39-9871-e28440fee75b\', \'multiverseId\': 421169}, \'multiverseid\': 421169}]', '[{\'name\': \'Glücksfall\', \'text\': \'Jeder Spieler wirft alle Karten aus seiner Hand ab und zieht dann so viele Karten, wie der Spieler, der auf diese Weise die meisten Karten abgeworfen hat, abgeworfen hat.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421423&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a282bb26-600e-4bf2-82e5-3808b097b248\', \'multiverseId\': 421423}, \'multiverseid\': 421423}, {\'name\': \'Ganga\', \'text\': \'Cada jugador descarta su mano y luego roba una cantidad de cartas igual a la mayor cantidad de cartas que un jugador descartó de esta manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423178&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd523660-b10e-48d3-b6b4-c20e30b5444c\', \'multiverseId\': 423178}, \'multiverseid\': 423178}, {\'name\': \'Aubaine\', \'text\': "Chaque joueur se défausse de sa main, puis il pioche un nombre de cartes égal au plus grand nombre de cartes dont un joueur s\'est défaussé de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421774&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bd4c57e-2b4c-4518-8fba-d829736c7f22\', \'multiverseId\': 421774}, \'multiverseid\': 421774}, {\'name\': \'Vento Sferzante\', \'text\': \'Ogni giocatore scarta la propria mano, poi pesca carte pari al maggior numero di carte che un giocatore ha scartato in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422125&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41ee0d74-841e-4062-b60d-0364678ecbce\', \'multiverseId\': 422125}, \'multiverseid\': 422125}, {\'name\': \'意外な授かり物\', \'text\': \'各プレイヤーはそれぞれ、自分の手札を捨て、その後これによりプレイヤー１人が捨てたカードの枚数のうち最も大きいものに等しい枚数のカードを引く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422476&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1ae0d515-d638-4f25-b501-e7a89c076c59\', \'multiverseId\': 422476}, \'multiverseid\': 422476}, {\'name\': \'Sorte Inesperada\', \'text\': \'Cada jogador descarta a própria mão e depois compra uma quantidade de cards igual ao maior número de cards descartados por um jogador dessa maneira.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422827&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88ecff48-5c1f-457a-82fd-50b4a7c32e1d\', \'multiverseId\': 422827}, \'multiverseid\': 422827}, {\'name\': \'横财\', \'text\': \'每位牌手弃掉手牌，然后各抓若干牌，其数量等同于牌手中以此法弃牌的最多数量。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2bc5e76-3ba1-4174-be47-5287807cffbf\', \'multiverseId\': 421072}, \'multiverseid\': 421072}]', '[{\'name\': \'Gnadenlose Vertreibung\', \'text\': \'Bestimme eines —\\n• Schicke alle Artefakte ins Exil.\\n• Schicke alle Kreaturen ins Exil.\\n• Schicke alle Verzauberungen ins Exil.\\n• Schicke alle Planeswalker ins Exil.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421530&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8eb24c41-8727-43af-82dc-10d12ea0cb4d\', \'multiverseId\': 421530}, \'multiverseid\': 421530}, {\'name\': \'Destierro despiadado\', \'text\': \'Elige uno:\\n• Exilia todos los artefactos.\\n• Exilia todas las criaturas.\\n• Exilia todos los encantamientos.\\n• Exilia todos los planeswalkers.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423285&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f69b839-ddc2-4c03-892f-b4b43468edbd\', \'multiverseId\': 423285}, \'multiverseid\': 423285}, {\'name\': \'Expulsion impitoyable\', \'text\': "Choisissez l\'un —\\n• Exilez tous les artefacts.\\n• Exilez toutes les créatures.\\n• Exilez tous les enchantements.\\n• Exilez tous les planeswalkers.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421881&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7d73a8f-b73e-43ca-9387-f94d75be1194\', \'multiverseId\': 421881}, \'multiverseid\': 421881}, {\'name\': \'Sfratto Inesorabile\', \'text\': \'Scegli uno —\\n• Esilia tutti gli artefatti.\\n• Esilia tutte le creature.\\n• Esilia tutti gli incantesimi.\\n• Esilia tutti i planeswalker.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422232&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1318922-7a29-4338-b67f-cc0c0ebb20e1\', \'multiverseId\': 422232}, \'multiverseid\': 422232}, {\'name\': \'無慈悲な追い立て\', \'text\': \'以下から１つを選ぶ。\\n• すべてのアーティファクトを追放する。\\n• すべてのクリーチャーを追放する。\\n• すべてのエンチャントを追放する。\\n• すべてのプレインズウォーカーを追放する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422583&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eecf76c7-98e0-45bd-951b-c58e32c9a760\', \'multiverseId\': 422583}, \'multiverseid\': 422583}, {\'name\': \'Evicção Impiedosa\', \'text\': \'Escolha um —\\n• Exile todos os artefatos.\\n• Exile todas as criaturas.\\n• Exile todos os encantamentos.\\n• Exile todos os planeswalkers.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422934&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d23a25a-585c-44c1-9346-ddc48fd98f86\', \'multiverseId\': 422934}, \'multiverseid\': 422934}, {\'name\': \'无情驱赶\', \'text\': \'选择一项～\\n•放逐所有神器。\\n•放逐所有生物。\\n•放逐所有结界。\\n•放逐所有鹏洛客。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421179&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ee2fe60-51fd-48a3-b127-6cff94c8965f\', \'multiverseId\': 421179}, \'multiverseid\': 421179}]', '[{\'name\': \'Goblin-Meisterspion\', \'text\': \'Erstschlag\\nZu Beginn des Endsegments jedes Gegners erzeugt dieser Spieler einen 1/1 roten Goblin-Kreaturenspielstein mit „Kreaturen, die du kontrollierst, greifen in jedem Kampf an, falls möglich".\', \'type\': \'Kreatur — Goblin, Räuber\', \'flavor\': \'„Infiltriert sie und macht sie richtig wütend!" —Motto der Liga der Goblin-Spione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421338&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'16a12b81-feb1-4b9e-8e99-2813093f7052\', \'multiverseId\': 421338}, \'multiverseid\': 421338}, {\'name\': \'Maestro espía trasgo\', \'text\': \'Daña primero.\\nAl comienzo del paso final de cada oponente, ese jugador crea una ficha de criatura Trasgo roja 1/1 con "Las criaturas que controlas atacan cada combate si pueden".\', \'type\': \'Criatura — Bribón trasgo\', \'flavor\': \'"¡Infíltrate y enfurece!" —Lema de la liga de espionaje trasgo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423093&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34bc0091-3470-445c-ac0c-5c9efb018116\', \'multiverseId\': 423093}, \'multiverseid\': 423093}, {\'name\': \'Maître espion gobelin\', \'text\': "Initiative\\nAu début de l\'étape de fin de chaque adversaire, ce joueur crée un jeton de créature 1/1 rouge Gobelin avec « Les créatures que vous contrôlez attaquent à chaque combat si possible. »", \'type\': \'Créature : gobelin et gredin\', \'flavor\': "« Infiltrer et exaspérer ! » —Devise de la Ligue d\'espionnage gobeline", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421689&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bfdc2234-157b-43f8-a8a4-8040bacb676e\', \'multiverseId\': 421689}, \'multiverseid\': 421689}, {\'name\': \'Capospia Goblin\', \'text\': \'Attacco improvviso\\nAll\\\'inizio della sottofase finale di ogni avversario, quel giocatore crea una pedina creatura Goblin 1/1 rossa con "Le creature che controlli attaccano in ogni combattimento, se possono farlo".\', \'type\': \'Creatura — Farabutto Goblin\', \'flavor\': \'"Infiltratevi e infuriate!" —Motto della Lega delle Spie Goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422040&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e5c5fb1-e515-40ca-b955-72bcb800bb81\', \'multiverseId\': 422040}, \'multiverseid\': 422040}, {\'name\': \'ゴブリンの密偵長\', \'text\': \'先制攻撃\\n各対戦相手の終了ステップの開始時に、そのプレイヤーは「各戦闘で、あなたがコントロールするクリーチャーは可能なら攻撃する。」を持つ赤の１/１のゴブリン・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ゴブリン・ならず者\', \'flavor\': \'「潜入し扇動せよ！」 ――ゴブリン間諜連盟の標語\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422391&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4934446-b4e3-4d97-8873-eea738156004\', \'multiverseId\': 422391}, \'multiverseid\': 422391}, {\'name\': \'Espião-mestre Goblin\', \'text\': \'Iniciativa\\nNo início da etapa final de cada oponente, aquele jogador cria uma ficha de criatura vermelha 1/1 do tipo Goblin com "As criaturas que você controla atacam a cada combate se estiverem aptas."\', \'type\': \'Criatura — Goblin Ladino\', \'flavor\': \'"Infiltrar e enfurecer!" — Lema da Liga de Espionagem Goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422742&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b09b3f7c-3d5e-47d0-acc9-1d58480a80f1\', \'multiverseId\': 422742}, \'multiverseid\': 422742}, {\'name\': \'鬼怪密探长\', \'text\': \'先攻\\n在每位对手的结束步骤开始时，该牌手派出一个1/1红色鬼怪衍生生物，且具有「由你操控的生物每次战斗若能攻击，则必须攻击。」\', \'type\': \'生物～鬼怪／浪客\', \'flavor\': \'「摸进去，骂出来！」 ～鬼怪谍报团座右铭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420987&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18fe5f18-c5c8-4e82-a06a-7bb9c7ef687f\', \'multiverseId\': 420987}, \'multiverseid\': 420987}]', '[{\'name\': \'Godo, Fürst der Banditen\', \'text\': \'Wenn Godo, Fürst der Banditen, ins Spiel kommt, kannst du deine Bibliothek nach einer Ausrüstung-Karte durchsuchen und sie ins Spiel bringen. Falls du dies tust, mische danach deine Bibliothek.\\nImmer wenn Godo zum ersten Mal in einem Zug angreift, enttappe ihn und alle Samurai, die du kontrollierst. Nach dieser Phase gibt es eine zusätzliche Kampfphase.\', \'type\': \'Legendäre Kreatur — Mensch, Barbar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421444&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2d984eb-3657-4f6f-a128-4ebb7abb0e1d\', \'multiverseId\': 421444}, \'multiverseid\': 421444}, {\'name\': \'Godo, señor de la guerra de los bandidos\', \'text\': \'Cuando Godo, señor de la guerra de los bandidos entre al campo de batalla, puedes buscar en tu biblioteca una carta de equipo y ponerla en el campo de batalla. Si lo haces, baraja tu biblioteca.\\nSiempre que Godo ataque por primera vez cada turno, enderézalo a él y a todos los Samuráis que controlas. Después de esta fase, hay una fase de combate adicional.\', \'type\': \'Criatura legendaria — Bárbaro humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423199&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93f427d1-3590-45a9-be6c-f761d394d484\', \'multiverseId\': 423199}, \'multiverseid\': 423199}, {\'name\': \'Godo, seigneur de guerre bandit\', \'text\': "Quand Godo, seigneur de guerre bandit arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte d\'équipement et la mettre sur le champ de bataille. Si vous faites ainsi, mélangez votre bibliothèque.\\nÀ chaque fois que Godo attaque pour la première fois à chaque tour, dégagez-le, ainsi que tous les samouraïs que vous contrôlez. Cette phase est suivie d\'une phase de combat supplémentaire.", \'type\': \'Créature légendaire : humain et barbare\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421795&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc5d3155-9d93-4a65-86ec-808376123a3e\', \'multiverseId\': 421795}, \'multiverseid\': 421795}, {\'name\': \'Godo, Condottiero Bandito\', \'text\': "Quando Godo, Condottiero Bandito entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta Equipaggiamento e metterla sul campo di battaglia. Se lo fai, rimescola il tuo grimorio.\\nOgniqualvolta Godo attacca per la prima volta in ogni turno, STAPpa Godo e tutti i Samurai che controlli. Dopo questa fase, c\'è una fase di combattimento addizionale.", \'type\': \'Creatura Leggendaria — Barbaro Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422146&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a380e638-3ced-45d1-8b9d-9e51ae856eb1\', \'multiverseId\': 422146}, \'multiverseid\': 422146}, {\'name\': \'山賊の頭、伍堂\', \'text\': \'山賊の頭、伍堂が戦場に出たとき、あなたはあなたのライブラリーから装備品・カード１枚を探して戦場に出してもよい。そうしたなら、あなたのライブラリーを切り直す。\\n山賊の頭、伍堂が各ターン最初に攻撃するたび、これとあなたがコントロールするすべての侍をアンタップする。このフェイズの後に、追加の戦闘フェイズを１つ加える。\', \'type\': \'伝説のクリーチャー — 人間・バーバリアン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422497&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7cbe81c8-7697-4261-87e1-cfd972167cf1\', \'multiverseId\': 422497}, \'multiverseid\': 422497}, {\'name\': \'Godo, Bandido Senhor da Guerra\', \'text\': \'Quando Godo, Bandido Senhor da Guerra, entra no campo de batalha, você pode procurar em seu grimório um card de Equipamento e colocá-lo no campo de batalha. Se fizer isso, embaralhe seu grimório.\\nToda vez que Godo atacar pela primeira vez em cada turno, desvire-o e desvire todos os Samurais que você controla. Depois dessa fase, há uma fase de combate adicional.\', \'type\': \'Criatura Lendária — Humano Bárbaro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422848&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb86f15c-f054-4d4f-b4e6-f14a6087ce46\', \'multiverseId\': 422848}, \'multiverseid\': 422848}, {\'name\': \'山贼王伍堂\', \'text\': \'当山贼王伍堂进战场时，你可以从你的牌库中搜寻一张武具牌，并将之放进战场。若你如此作，则将你的牌库洗牌。\\n每当伍堂进行每回合中第一次攻击时，重置它和所有由你操控的武士。在此阶段后，额外多出一个战斗阶段。\', \'type\': \'传奇生物～人类／野蛮人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421093&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd7be935-5e66-4ec6-9eac-7b835c151771\', \'multiverseId\': 421093}, \'multiverseid\': 421093}]', "[{'name': 'Golgari-Petschaft', 'text': '{1}, {T}: Erhöhe deinen Manavorrat um {B}{G}.', 'type': 'Artefakt', 'flavor': 'Ob das Siegel eine stolze Wächterin des Naturkreislaufs darstellt oder jemanden, die ihre Seele der Dunkelheit im Ausgleich für ewiges Leben verkauft hat, hängt von der Sichtweise des Betrachters ab.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421574&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e7d64e59-af8f-4765-addf-8e0e9a076df0', 'multiverseId': 421574}, 'multiverseid': 421574}, {'name': 'Sello golgari', 'text': '{1}, {T}: Agrega {B}{G} a tu reserva de maná.', 'type': 'Artefacto', 'flavor': 'Dependiendo de tu punto de vista, el sello representa a un orgulloso guardián del ciclo natural o a alguien que ha vendido su alma a la oscuridad a cambio de vida eterna.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423329&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '593ce205-33e4-4efb-ba61-c31077c1c2c8', 'multiverseId': 423329}, 'multiverseid': 423329}, {'name': 'Cachet de Golgari', 'text': '{1}, {T} : Ajoutez {B}{G} à votre réserve.', 'type': 'Artefact', 'flavor': 'Selon les avis, le sceau représente une fière gardienne du cycle naturel ou celle qui a vendu son âme aux ténèbres en échange de la vie éternelle.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421925&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8f07fade-fed3-4161-a46c-d3089d957918', 'multiverseId': 421925}, 'multiverseid': 421925}, {'name': 'Sigillo Golgari', 'text': '{1}, {T}: Aggiungi {B}{G} alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': 'A seconda dei punti di vista, il sigillo rappresenta un fiero guardiano del ciclo naturale o uno che ha venduto la propria anima alle tenebre in cambio della vita eterna.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422276&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd6fd06e8-272f-4696-9507-dd0530628528', 'multiverseId': 422276}, 'multiverseid': 422276}, {'name': 'ゴルガリの印鑑', 'text': '{1}, {T}：あなたのマナ・プールに{B}{G}を加える。', 'type': 'アーティファクト', 'flavor': '見るものの視点により、その印章が示すものは、自然の巡りを護る名誉ある守護者にも、永遠の生命のために魂を闇に売り渡した者にもなる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422627&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bbf68c13-dcad-40ff-be71-99fefd6a8637', 'multiverseId': 422627}, 'multiverseid': 422627}, {'name': 'Sinete Golgari', 'text': '{1}, {T}: Adicione {B}{G} à sua reserva de mana.', 'type': 'Artefato', 'flavor': 'Dependendo do seu ponto de vista, o selo representa uma guardiã orgulhosa do ciclo natural ou alguém que vendeu sua alma à escuridão em troca de vida eterna.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422978&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2df2575d-6a4f-4c9f-b65a-53617600bf71', 'multiverseId': 422978}, 'multiverseid': 422978}, {'name': '葛加理印记', 'text': '{1}，{T}：加{B}{G}到你的法术力池中。', 'type': '神器', 'flavor': '这徽记的意义随你观点不同而变化：可能是足以自傲的自然循环护卫，也可能是向黑暗出卖灵魂以求永生的恶徒。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421223&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e89d3b09-27ad-475c-ae58-8cec7517abe1', 'multiverseId': 421223}, 'multiverseid': 421223}]", "[{'name': 'Golgari-Verrottungsfarm', 'text': 'Die Golgari-Verrottungsfarm kommt getappt ins Spiel.\\nWenn die Golgari-Verrottungsfarm ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {B}{G}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421617&type=card', 'language': 'German', 'identifiers': {'scryfallId': '57bdda12-1901-425c-a27b-dbbb74a6dfd1', 'multiverseId': 421617}, 'multiverseid': 421617}, {'name': 'Granja de podredumbre golgari', 'text': 'La Granja de podredumbre golgari entra al campo de batalla girada.\\nCuando la Granja de podredumbre golgari entre al campo de batalla, regresa una tierra que controlas a la mano de su propietario.\\n{T}: Agrega {B}{G} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423372&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2ec9e6a5-c248-4790-9981-8ebc2fa4e974', 'multiverseId': 423372}, 'multiverseid': 423372}, {'name': 'Ferme à putréfaction des Golgari', 'text': 'La Ferme à putréfaction des Golgari arrive sur le champ de bataille engagée.\\nQuand la Ferme à putréfaction des Golgari arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {B}{G} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421968&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4a345b67-845b-4987-9520-8b5fe4808230', 'multiverseId': 421968}, 'multiverseid': 421968}, {'name': 'Mortificio Golgari', 'text': 'Il Mortificio Golgari entra nel campo di battaglia TAPpato.\\nQuando il Mortificio Golgari entra nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {B}{G} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422319&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0b62db8f-52f8-49e2-bef3-3ef9aa9715d8', 'multiverseId': 422319}, 'multiverseid': 422319}, {'name': 'ゴルガリの腐敗農場', 'text': 'ゴルガリの腐敗農場はタップ状態で戦場に出る。\\nゴルガリの腐敗農場が戦場に出たとき、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{B}{G}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422670&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd547ec19-e456-4485-9ea9-1b1239982e16', 'multiverseId': 422670}, 'multiverseid': 422670}, {'name': 'Fazenda de Podridão Golgari', 'text': 'Fazenda de Podridão Golgari entra no campo de batalha virado.\\nQuando Fazenda de Podridão Golgari entrar no campo de batalha, devolva um terreno que você controle para a mão de seu dono.\\n{T}: Adicione {B}{G} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423021&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e29223c3-729d-4136-b4ad-421aa5f8ad3f', 'multiverseId': 423021}, 'multiverseid': 423021}, {'name': '葛加理腐尸农场', 'text': '葛加理腐尸农场须横置进战场。\\n当葛加理腐尸农场进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{B}{G}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421266&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4b6a4bb7-2243-4cf8-b42c-eaa8606fbbcf', 'multiverseId': 421266}, 'multiverseid': 421266}]", "[{'name': 'Grab-Aufruhr', 'text': 'Bringe eine Kreaturenkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel. Sie erhält Eile.\\nStandardlandumwandlung {2} ({2}, wirf diese Karte ab: Durchsuche deine Bibliothek nach einer Standardland-Karte, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421350&type=card', 'language': 'German', 'identifiers': {'scryfallId': '878bbeb0-83c3-404a-aca9-11ab8443b7a2', 'multiverseId': 421350}, 'multiverseid': 421350}, {'name': 'Alzamiento de la tumba', 'text': 'Pon en el campo de batalla bajo tu control la carta de criatura objetivo de un cementerio. Gana la habilidad de prisa.\\nCiclo de tierras básicas {2}. ({2}, descartar esta carta: Busca en tu biblioteca una carta de tierra básica, muéstrala y ponla en tu mano. Luego baraja tu biblioteca.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423105&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd5887c07-99ed-4d45-852c-2f7972f28dd8', 'multiverseId': 423105}, 'multiverseid': 423105}, {'name': 'Bouleversement grave', 'text': 'Mettez sur le champ de bataille, sous votre contrôle, une carte de créature ciblée depuis un cimetière. Elle acquiert la célérité.\\nRecyclage de terrain de base {2} ({2}, défaussez-vous de cette carte : Cherchez dans votre bibliothèque une carte de terrain de base, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421701&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd9f2ed53-7718-4463-8ddd-a581ed07a295', 'multiverseId': 421701}, 'multiverseid': 421701}, {'name': 'Sconvolgimento Sepolcrale', 'text': 'Metti sul campo di battaglia sotto il tuo controllo una carta creatura bersaglio da un cimitero. Ha rapidità.\\nCicloterra base {2} ({2}, Scarta questa carta: Passa in rassegna il tuo grimorio per una carta terra base, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.)', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422052&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '87957a74-26da-4b8d-9ccc-6d0642fe253c', 'multiverseId': 422052}, 'multiverseid': 422052}, {'name': '墓所の隆起', 'text': '墓地からクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で戦場に出す。それは速攻を得る。\\n基本土地サイクリング{2}（{2}, このカードを捨てる：あなたのライブラリーから基本土地・カード１枚を探し、それを公開してあなたの手札に加える。その後あなたのライブラリーを切り直す。）', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422403&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '45b10d29-62f6-4fd0-9b37-09148d137bbb', 'multiverseId': 422403}, 'multiverseid': 422403}, {'name': 'Sublevação Tumular', 'text': 'Coloque o card de criatura alvo de um cemitério no campo de batalha sob o seu controle. Ele ganha ímpeto.\\nReciclar terreno básico {2} ({2}, Descarte este card: Procure em seu grimório um card de terreno básico, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422754&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bfd6a111-e524-4e54-a1f9-f06b950670cb', 'multiverseId': 422754}, 'multiverseid': 422754}, {'name': '坟场动荡', 'text': '将目标生物牌在你的操控下从坟墓场放进战场。它获得敏捷异能。\\n循环基本地{2}（{2}，弃掉此牌：从你的牌库中搜寻一张基本地牌，展示该牌，并置于你手上。然后将你的牌库洗牌。）', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420999&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2a61f90b-8942-419b-bb48-6952c06399f1', 'multiverseId': 420999}, 'multiverseid': 420999}]", "[{'name': 'Grausames Schauspiel', 'text': 'Bestimme einen Spieler deiner Wahl und einen anderen Spieler deiner Wahl. Der erste Spieler kontrolliert den zweiten Spieler während des nächsten Zuges des zweiten Spielers, und der zweite Spieler kontrolliert den ersten Spieler während des nächsten Zuges des ersten Spielers.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421330&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0f138b8e-db85-4136-84f9-522b0ef0e0d7', 'multiverseId': 421330}, 'multiverseid': 421330}, {'name': 'Diversión cruel', 'text': 'Elige a un jugador objetivo y a otro jugador objetivo. El primer jugador controla al segundo jugador durante el próximo turno del segundo jugador, y el segundo jugador controla al primer jugador durante el próximo turno del primer jugador.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423085&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '01ce77a2-1263-47ed-84c9-45220f96a91d', 'multiverseId': 423085}, 'multiverseid': 423085}, {'name': 'Divertissement cruel', 'text': 'Choisissez un joueur ciblé et un autre joueur ciblé. Le premier joueur contrôle le deuxième pendant le prochain tour du deuxième joueur, et le deuxième joueur contrôle le premier pendant le prochain tour du premier joueur.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421681&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9f5c6e27-1d61-4176-8f4b-0527d1997fc2', 'multiverseId': 421681}, 'multiverseid': 421681}, {'name': 'Spettacolo Crudele', 'text': 'Scegli un giocatore bersaglio e un altro giocatore bersaglio. Il primo giocatore controlla il secondo giocatore durante il prossimo turno del secondo giocatore e il secondo giocatore controlla il primo giocatore durante il prossimo turno del primo giocatore.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422032&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e0e8f3e9-a38a-428a-afb6-79a7b3de1829', 'multiverseId': 422032}, 'multiverseid': 422032}, {'name': '残酷な見世物', 'text': 'プレイヤー１人と他のプレイヤー１人を対象とする。後者のプレイヤーの次のターン中、前者のプレイヤーは後者のプレイヤーをコントロールし、前者のプレイヤーの次のターン中、後者のプレイヤーは前者のプレイヤーをコントロールする。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422383&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '33e9e6a6-5590-468e-b647-ef0305d1284b', 'multiverseId': 422383}, 'multiverseid': 422383}, {'name': 'Entretenimento Cruel', 'text': 'Escolha um jogador alvo e outro jogador alvo. O primeiro jogador controla o segundo jogador durante o próximo turno do segundo jogador, e o segundo jogador controla o primeiro jogador durante o próximo turno do primeiro jogador.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422734&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1519dfbb-a75f-417e-b1e4-95cebd441f36', 'multiverseId': 422734}, 'multiverseid': 422734}, {'name': '苦笑言欢', 'text': '选择目标牌手和另一位目标牌手。后者牌手在其下个回合由前者牌手操控，且前者牌手在其下个回合由后者牌手操控。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420979&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e7f80a37-ab36-4115-9f66-485096f7848b', 'multiverseId': 420979}, 'multiverseid': 420979}]", '[{\'name\': \'Grausige Einberufung\', \'text\': \'Schicke alle Kreaturenkarten aus dem Friedhof eines Spielers deiner Wahl verdeckt ins Exil, mische sie und manifestiere dann diese Karten. (Um eine Karte zu manifestieren, bringe sie als eine 2/2 Kreatur verdeckt ins Spiel. Decke sie zu einem beliebigen Zeitpunkt für ihre Manakosten auf, falls es eine Kreaturenkarte ist.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421430&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bde1e55a-1040-42a3-b41c-375bc227c9b4\', \'multiverseId\': 421430}, \'multiverseid\': 421430}, {\'name\': \'Conscripción espantosa\', \'text\': \'Exilia todas las cartas de criatura del cementerio del jugador objetivo en una pila boca abajo, baraja esa pila y luego manifiesta esas cartas. (Para manifestar una carta, ponla en el campo de batalla boca abajo como una criatura 2/2. Ponla boca arriba en cualquier momento por su coste de maná si es una carta de criatura.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423185&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8f80e57-4a77-44a4-8b5d-35943e70536a\', \'multiverseId\': 423185}, \'multiverseid\': 423185}, {\'name\': \'Conscription abominable\', \'text\': "Exilez toutes les cartes de créature du cimetière du joueur ciblé dans un tas face cachée, mélangez-le, puis manifestez ces cartes. (Pour manifester une carte, mettez-la sur le champ de bataille face cachée comme une créature 2/2. Retournez-la face visible à tout moment pour son coût de mana si c\'est une carte de créature.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421781&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2933c658-bd64-4990-9f35-87ae76668d2a\', \'multiverseId\': 421781}, \'multiverseid\': 421781}, {\'name\': \'Coscrizione Spettrale\', \'text\': \'Esilia tutte le carte creatura dal cimitero di un giocatore bersaglio in una pila a faccia in giù, rimescola quella pila, poi manifesta quelle carte. (Per manifestare una carta, mettila sul campo di battaglia a faccia in giù come una creatura 2/2. Se è una carta creatura, girala a faccia in su in qualsiasi momento pagando il suo costo di mana.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422132&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'442e87f1-d899-4a22-b7d7-50611b59f1bc\', \'multiverseId\': 422132}, \'multiverseid\': 422132}, {\'name\': \'恐ろしい徴兵\', \'text\': \'プレイヤー１人を対象とし、そのプレイヤーの墓地からすべてのクリーチャー・カードを裏向きの束にして追放し、その束を切り直し、その後それらのカードを予示する。（カードを予示するとは、「それを裏向きの状態で２/２クリーチャーとして戦場に出す。それがクリーチャー・カードであるなら、そのマナ・コストで、いつでも表向きにしてよい。」ということである。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422483&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ad521b9-6904-4870-aabd-414e41180dea\', \'multiverseId\': 422483}, \'multiverseid\': 422483}, {\'name\': \'Conscrição Fantasmal\', \'text\': \'Exile todos os cards de criatura do cemitério do jogador alvo em um monte voltado para baixo, embaralhe-os e depois, manifeste-os. (Para manifestar um card, coloque-o no campo de batalha com a face voltada para baixo como uma criatura 2/2. Volte sua face para cima a qualquer momento pagando seu custo de mana se for um card de criatura.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4d6f0ce-a358-4ed5-9f47-8a313918b30a\', \'multiverseId\': 422834}, \'multiverseid\': 422834}, {\'name\': \'骇怖征召\', \'text\': \'放逐目标牌手坟墓场中的所有生物牌并牌面朝下地放作一堆，将该堆牌洗牌，然后显化这些牌。（显化某张牌的流程是，将该牌面朝下地放进战场，当成2/2生物。如果该牌是生物牌，则可随时支付其法术力费用使其翻回正面。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421079&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e5936820-8bf8-4e35-8415-4c94f97fc66f\', \'multiverseId\': 421079}, \'multiverseid\': 421079}]', '[{\'name\': \'Grenzlandbiwak\', \'text\': \'Das Grenzlandbiwak kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}, {U} oder {R}.\', \'type\': \'Land\', \'flavor\': \'„Die mächtigsten Träume kommen zu denen, die Unterschlupf im Schädel eines Drachen finden." —Chianul, Zweifach-Flüsterer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421616&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97c7aae3-2863-4522-9e9c-4b582da2f58b\', \'multiverseId\': 421616}, \'multiverseid\': 421616}, {\'name\': \'Campamento fronterizo\', \'text\': \'El Campamento fronterizo entra al campo de batalla girado.\\n{T}: Agrega {G}, {U} o {R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"A aquellos que se refugian en el cráneo de un dragón los visitan los sueños más poderosos". —Chianul, Doble susurro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423371&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1f62524-a880-41f6-8f23-20bfbce0ddf4\', \'multiverseId\': 423371}, \'multiverseid\': 423371}, {\'name\': \'Bivouac de frontière\', \'text\': \'Le Bivouac de frontière arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G}, {U} ou {R} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "« De puissants rêves apparaissent à ceux qui s\'abritent dans le crâne d\'un dragon. » —Chëanul, le Passeur de murmures", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421967&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7edc937f-1484-45bb-ad8f-0b2349f110ad\', \'multiverseId\': 421967}, \'multiverseid\': 421967}, {\'name\': \'Bivacco di Frontiera\', \'text\': \'Il Bivacco di Frontiera entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G}, {U} o {R} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'"I sogni più intensi fanno visita a chi cerca riparo nel teschio di un drago." —Chianul, Duplice Sussurro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422318&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8d1b674f-3d5e-45e7-b73f-af66abc5234b\', \'multiverseId\': 422318}, \'multiverseid\': 422318}, {\'name\': \'開拓地の野営地\', \'text\': \'開拓地の野営地はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}か{U}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'「龍の髑髏の中を住処とする者には、最も鮮明な夢が訪れるだろう。」 ――二度囁く者、チアヌル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422669&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'df019842-1091-4263-b0fe-1884927126a0\', \'multiverseId\': 422669}, \'multiverseid\': 422669}, {\'name\': \'Bivaque da Fronteira\', \'text\': \'Bivaque da Fronteira entra no campo de batalha virado.\\n{T}: Adicione {G}, {U} ou {R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"Os sonhos mais poderosos visitam aqueles que se abrigam na caveira de um dragão." — Chianul, Sussurrador Duplo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423020&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a82e624-eba6-4251-a38b-a918b48c800e\', \'multiverseId\': 423020}, \'multiverseid\': 423020}, {\'name\': \'边疆营地\', \'text\': \'边疆营地须横置进战场。\\n{T}：加{G}，{U}或{R}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'「最强力的梦境只会眷顾那些住在龙颅里的人。」 ～通灵祭师恰努尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421265&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61402166-988d-4d63-adc9-126db7e5e0c0\', \'multiverseId\': 421265}, \'multiverseid\': 421265}]', '[{\'name\': \'Griff der Phyrese\', \'text\': \'Übernimm die Kontrolle über eine Ausrüstung deiner Wahl. Erzeuge dann einen 0/0 schwarzen Keim-Kreaturenspielstein und lege sie an ihn an.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Selbst deine Klinge weiß, wer am Ende triumphieren wird." —Atraxa, Stimme der Prätoren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421328&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cfe5b41f-1e4c-4039-80a6-beae80101d63\', \'multiverseId\': 421328}, \'multiverseid\': 421328}, {\'name\': \'Aprehensión de la piresis\', \'text\': \'Gana el control del equipo objetivo, luego crea una ficha de criatura Germen negra 0/0 y anexa ese equipo a ella.\', \'type\': \'Instantáneo\', \'flavor\': \'"Incluso tu espada sabe quién triunfará". —Atraxa, voz de los magistrados\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423083&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a734dbfc-ca20-4119-9229-79d53261afc0\', \'multiverseId\': 423083}, \'multiverseid\': 423083}, {\'name\': \'Poigne de la phyrésie\', \'text\': "Acquérez le contrôle de l\'équipement ciblé, puis créez un jeton de créature 0/0 noire Germe et attachez-lui cet équipement.", \'type\': \'Éphémère\', \'flavor\': \'« Même votre lame sait qui triomphera ici. » —Atraxa, voix des praetors\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4523595-47db-4791-9c45-efadbdff2f57\', \'multiverseId\': 421679}, \'multiverseid\': 421679}, {\'name\': \'Morsa della Phyresis\', \'text\': "Prendi il controllo di un Equipaggiamento bersaglio, poi crea una pedina creatura Microbo 0/0 nera e assegnale quell\'Equipaggiamento.", \'type\': \'Istantaneo\', \'flavor\': \'"Persino la tua lama sa già chi sarà il vincitore." —Atraxa, Voce dei Pretori\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422030&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8708d0fd-250c-4f30-b0e8-246a5f51f19d\', \'multiverseId\': 422030}, \'multiverseid\': 422030}, {\'name\': \'ファイレクシア病の支配\', \'text\': \'装備品１つを対象とし、それのコントロールを得る。その後、黒の０/０の細菌・クリーチャー・トークンを１体生成し、その装備品をそれにつける。\', \'type\': \'インスタント\', \'flavor\': \'「お前の刃ですら、誰が勝利するのかわかっている。」 ――法務官の声、アトラクサ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422381&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2632b05a-bcb4-4178-95a0-2c2f89422fa0\', \'multiverseId\': 422381}, \'multiverseid\': 422381}, {\'name\': \'Garras da Phyresis\', \'text\': \'Ganhe o controle do Equipamento alvo. Em seguida, crie uma ficha de criatura preta 0/0 do tipo Germe e anexe aquele Equipamento a ela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Até mesmo sua lâmina sabe quem triunfará aqui." — Atraxa, Voz dos Pretores\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422732&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2303205-4abb-4f2c-9c83-7a069230c3ab\', \'multiverseId\': 422732}, \'multiverseid\': 422732}, {\'name\': \'非瑞化之攫\', \'text\': \'获得目标武具的操控权，然后派出一个0/0黑色病菌衍生生物，并将该武具装备于其上。\', \'type\': \'瞬间\', \'flavor\': \'「就连你的剑都知道谁会获胜。」 ～魔判官之声亚崔夏\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f938da8d-f107-41db-b508-655f7b51cfe6\', \'multiverseId\': 420977}, \'multiverseid\': 420977}]', '[{\'name\': \'Gruul-Petschaft\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {R}{G}.\', \'type\': \'Artefakt\', \'flavor\': \'Die Zeichen, mit denen die Gruul ihren Einflussbereich kennzeichnen, sind oft nicht lesbar. Das Blut, der Rotz und der Schlamm, mit denen sie gezeichnet wurden, reichen jedoch meist zur Identifikation.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421575&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47482fc8-1899-43e5-9915-3bd02632cd6e\', \'multiverseId\': 421575}, \'multiverseid\': 421575}, {\'name\': \'Sello gruul\', \'text\': \'{1}, {T}: Agrega {R}{G} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Las marcas territoriales de los gruul no necesitan ser legibles. La sangre, el moco y el barro usados para impregnarlas son indudablemente gruul.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423330&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4c397bd-4924-41c3-9bb0-23b7f5ade7c8\', \'multiverseId\': 423330}, \'multiverseid\': 423330}, {\'name\': \'Cachet de Gruul\', \'text\': \'{1}, {T} : Ajoutez {R}{G} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Les marques territoriales des Gruul n\'ont pas besoin d\'être officielles. Le sang, la morve et la crasse utilisés pour les dessiner sont tout de suite identifiables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421926&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3aa53a09-3b5b-4b0a-8aca-f9917cf75ff3\', \'multiverseId\': 421926}, \'multiverseid\': 421926}, {\'name\': \'Sigillo Gruul\', \'text\': \'{1}, {T}: Aggiungi {R}{G} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Le indicazioni territoriali dei Gruul non devono essere leggibili. Il fatto che siano tracciate con sangue, muco e sporcizia le identifica chiaramente come Gruul.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422277&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31f6459a-230c-4110-a2d0-650d99449d5c\', \'multiverseId\': 422277}, \'multiverseid\': 422277}, {\'name\': \'グルールの印鑑\', \'text\': \'{1}, {T}：あなたのマナ・プールに{R}{G}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'グルール領の境界線は明瞭である必要は無い。グルールの塗りたくられた血や鼻糞や泥は見間違いようがない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422628&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32b58847-3813-4b4d-b032-0c0f00225c40\', \'multiverseId\': 422628}, \'multiverseid\': 422628}, {\'name\': \'Sinete Gruul\', \'text\': \'{1}, {T}: Adicione {R}{G} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'As marcas territoriais dos Gruul não precisam ser legíveis. O sangue, a meleca e a podridão usadas para demarcá-las são inconfundivelmente Gruul.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422979&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'541c324b-3c8e-4a30-876d-081708db1d06\', \'multiverseId\': 422979}, \'multiverseid\': 422979}, {\'name\': \'古鲁印记\', \'text\': \'{1}，{T}：加{R}{G}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'古鲁的地界标志不需要刻意清楚标示。看到用鲜血，鼻涕，或粪便涂抹的痕迹，就晓得这边属于古鲁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421224&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2323c8a4-c1a4-4a55-adbb-dc1ba9466ca0\', \'multiverseId\': 421224}, \'multiverseid\': 421224}]', "[{'name': 'Gruulgrund', 'text': 'Der Gruulgrund kommt getappt ins Spiel.\\nWenn der Gruulgrund ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {R}{G}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421619&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c9e8c98f-9bf5-48c3-9d4d-d2f9cfa94329', 'multiverseId': 421619}, 'multiverseid': 421619}, {'name': 'Territorio gruul', 'text': 'El Territorio gruul entra al campo de batalla girado.\\nCuando el Territorio gruul entre al campo de batalla, regresa una tierra que controlas a la mano de su propietario.\\n{T}: Agrega {R}{G} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423374&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a3bc76dc-ec5c-4732-9c73-8f3b54ea56dd', 'multiverseId': 423374}, 'multiverseid': 423374}, {'name': 'Territoire des Gruul', 'text': 'Le Territoire des Gruul arrive sur le champ de bataille engagé.\\nQuand le Territoire des Gruul arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {R}{G} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421970&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd65e19f1-c502-41d1-8784-b9bcce3f7c59', 'multiverseId': 421970}, 'multiverseid': 421970}, {'name': 'Torba Gruul', 'text': 'La Torba Gruul entra nel campo di battaglia TAPpata.\\nQuando la Torba Gruul entra nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {R}{G} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422321&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fcedd16e-37a6-4986-80b7-9db94d7a294f', 'multiverseId': 422321}, 'multiverseid': 422321}, {'name': 'グルールの芝地', 'text': 'グルールの芝地はタップ状態で戦場に出る。\\nグルールの芝地が戦場に出たとき、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{R}{G}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422672&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '09a81085-69d1-4798-b5e5-5965f42ee54c', 'multiverseId': 422672}, 'multiverseid': 422672}, {'name': 'Gleba Gruul', 'text': 'Gleba Gruul entra no campo de batalha virado.\\nQuando Gleba Gruul entrar no campo de batalha, devolva um terreno que você controla para a mão de seu dono.\\n{T}: Adicione {R}{G} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423023&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0d3e02e6-2ffe-4d2d-8f62-4d15edf441b9', 'multiverseId': 423023}, 'multiverseid': 423023}, {'name': '古鲁地盘', 'text': '古鲁地盘须横置进战场。\\n当古鲁地盘进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{R}{G}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421268&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '069d1ee6-63d3-4c9f-ab62-8e9e5ce92a51', 'multiverseId': 421268}, 'multiverseid': 421268}]", '[{\'name\': \'Gwafa Hazid, der Schieber\', \'text\': \'{W}{U}, {T}: Lege eine Bestechungsmarke auf eine Kreatur deiner Wahl, die du nicht kontrollierst. Ihr Beherrscher zieht eine Karte.\\nKreaturen mit Bestechungsmarken können nicht angreifen oder blocken.\', \'type\': \'Legendäre Kreatur — Mensch, Räuber\', \'flavor\': \'„Jeder hat seinen Preis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fdf61abe-5ce3-4b4e-99eb-ec8a097e9fd5\', \'multiverseId\': 421521}, \'multiverseid\': 421521}, {\'name\': \'Gwafa Hazid, ventajista\', \'text\': \'{W}{U}, {T}: Pon un contador de soborno sobre la criatura objetivo que no controlas. Su controlador roba una carta.\\nLas criaturas con contadores de soborno sobre ellas no pueden atacar ni bloquear.\', \'type\': \'Criatura legendaria — Bribón humano\', \'flavor\': \'"Todos tienen un precio".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423276&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eac95334-deb0-4117-8385-5971f135f2ee\', \'multiverseId\': 423276}, \'multiverseid\': 423276}, {\'name\': \'Gwafa Hazid, mercanti\', \'text\': \'{W}{U}, {T} : Mettez un marqueur « pot-de-vin » sur une créature ciblée que vous ne contrôlez pas. Son contrôleur pioche une carte.\\nLes créatures avec des marqueurs « pot-de-vin » sur elles ne peuvent ni attaquer ni bloquer.\', \'type\': \'Créature légendaire : humain et gredin\', \'flavor\': \'« Tout le monde a son prix. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421872&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6d42b38-a575-47cb-9001-68153600a459\', \'multiverseId\': 421872}, \'multiverseid\': 421872}, {\'name\': \'Gwafa Hazid, Profittatore\', \'text\': \'{W}{U}, {T}: Metti un segnalino corruzione su una creatura bersaglio che non controlli. Il suo controllore pesca una carta.\\nLe creature con segnalini corruzione non possono attaccare o bloccare.\', \'type\': \'Creatura Leggendaria — Farabutto Umano\', \'flavor\': \'"Tutti hanno un prezzo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422223&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4c16b64-db88-4ba9-bbac-7719930b8a39\', \'multiverseId\': 422223}, \'multiverseid\': 422223}, {\'name\': \'成金、グヮファ・ハジード\', \'text\': \'{W}{U}, {T}：あなたがコントロールしていないクリーチャー１体を対象とし、それの上に賄賂カウンターを１個置く。それのコントローラーはカードを１枚引く。\\n賄賂カウンターが置かれているクリーチャーは攻撃もブロックもできない。\', \'type\': \'伝説のクリーチャー — 人間・ならず者\', \'flavor\': \'「誰にも値がある。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422574&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8eaf7cc6-b453-4004-989d-7c2a5013821d\', \'multiverseId\': 422574}, \'multiverseid\': 422574}, {\'name\': \'Gwafa Hazid, Especulador\', \'text\': \'{W}{U}, {T}: Coloque um marcador de suborno na criatura alvo que você não controla. Seu controlador compra um card.\\nAs criaturas com marcadores de suborno não podem atacar nem bloquear.\', \'type\': \'Criatura Lendária — Humano Ladino\', \'flavor\': \'"Todos têm um preço."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422925&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0252e78-c743-4b6f-9915-914ed83d7442\', \'multiverseId\': 422925}, \'multiverseid\': 422925}, {\'name\': \'投机客瓜法哈基\', \'text\': \'{W}{U}，{T}：在目标不由你操控的生物上放置一个贿赂指示物。其操控者抓一张牌。\\n其上有贿赂指示物的生物不能进行攻击或阻挡。\', \'type\': \'传奇生物～人类／浪客\', \'flavor\': \'「人人都有价可询。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421170&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ebe6b671-243b-45b0-b430-405cae97ad42\', \'multiverseId\': 421170}, \'multiverseid\': 421170}]', '[{\'name\': \'Handelsposten\', \'text\': \'{1}, {T}, wirf eine Karte ab: Du erhältst 4 Lebenspunkte dazu.\\n{1}, {T}, bezahle 1 Lebenspunkt: Erzeuge einen 0/1 weißen Ziege-Kreaturenspielstein.\\n{1}, {T}, opfere eine Kreatur: Bringe eine Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\n{1}, {T}, opfere ein Artefakt: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421597&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48919de2-b8b2-4dba-802d-36cb07a75f87\', \'multiverseId\': 421597}, \'multiverseid\': 421597}, {\'name\': \'Puesto comercial\', \'text\': \'{1}, {T}, descartar una carta: Ganas 4 vidas.\\n{1}, {T}, pagar 1 vida: Crea una ficha de criatura Cabra blanca 0/1.\\n{1}, {T}, sacrificar una criatura: Regresa la carta de artefacto objetivo de tu cementerio a tu mano.\\n{1}, {T}, sacrificar un artefacto: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423352&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6856f384-fbb1-4941-baad-5f9804b5986a\', \'multiverseId\': 423352}, \'multiverseid\': 423352}, {\'name\': \'Comptoir de commerce\', \'text\': "{1}, {T}, défaussez-vous d\'une carte : Vous gagnez 4 points de vie.\\n{1}, {T}, payez 1 point de vie : Créez un jeton de créature 0/1 blanche Chèvre.\\n{1}, {T}, sacrifiez une créature : Renvoyez une carte d\'artefact ciblée depuis votre cimetière dans votre main.\\n{1}, {T}, sacrifiez un artefact : Piochez une carte.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421948&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d17b32a-49e1-4fce-912d-9e8588420afe\', \'multiverseId\': 421948}, \'multiverseid\': 421948}, {\'name\': \'Stazione Commerciale\', \'text\': \'{1}, {T}, Scarta una carta: Guadagni 4 punti vita.\\n{1}, {T}, Paga 1 punto vita: Crea una pedina creatura Capra 0/1 bianca.\\n{1}, {T}, Sacrifica una creatura: Riprendi in mano una carta artefatto bersaglio dal tuo cimitero.\\n{1}, {T}, Sacrifica un artefatto: Pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422299&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'681e44d2-3109-4045-b038-491a903b0ad8\', \'multiverseId\': 422299}, \'multiverseid\': 422299}, {\'name\': \'交易所\', \'text\': \'{1}, {T}, カード１枚を捨てる：あなたは４点のライフを得る。\\n{1}, {T}, １点のライフを支払う：白の０/１のヤギ・クリーチャー・トークンを１体生成する。\\n{1}, {T}, クリーチャー１体を生け贄に捧げる：あなたの墓地からアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\\n{1}, {T}, アーティファクト１つを生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422650&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'848fe788-d768-42b8-872d-19edc22102c3\', \'multiverseId\': 422650}, \'multiverseid\': 422650}, {\'name\': \'Entreposto\', \'text\': \'{1}, {T}, Descarte um card: Você ganha 4 pontos de vida.\\n{1}, {T}, Pague 1 ponto de vida: Crie uma ficha de criatura branca 0/1 do tipo Bode.\\n{1}, {T}, Sacrifique uma criatura: Devolva o card de artefato alvo de seu cemitério para sua mão.\\n{1}, {T}, Sacrifique um artefato: Compre um card.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423001&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c870aff-210b-41f0-aefe-29f42f8e2757\', \'multiverseId\': 423001}, \'multiverseid\': 423001}, {\'name\': \'交易站\', \'text\': \'{1}，{T}，弃一张牌：你获得4点生命。\\n{1}，{T}，支付1点生命：派出一个0/1白色山羊衍生生物。\\n{1}，{T}，牺牲一个生物：将目标神器牌从你的坟墓场移回你手上。\\n{1}，{T}，牺牲一个神器：抓一张牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421246&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1dc1f97-9ad1-4860-ab27-df6ad1203b82\', \'multiverseId\': 421246}, \'multiverseid\': 421246}]', '[{\'name\': \'Hanna die Navigatorin\', \'text\': \'{1}{W}{U}, {T}: Bringe ein Artefakt oder eine Verzauberung deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': \'„Ich hätte nie gedacht, dass ich mein Leben mit Kämpfen verbringe. Ich bin eine Schafferin, keine Zerstörerin."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421522&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c51b8e0-9c5d-4a54-ae4b-101ea5e3f219\', \'multiverseId\': 421522}, \'multiverseid\': 421522}, {\'name\': \'Hanna, navegante del barco\', \'text\': \'{1}{W}{U}, {T}: Regresa la carta de artefacto o de encantamiento objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': \'"Nunca pensé que pasaría toda mi vida luchando. Soy una creadora, no una destructora".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423277&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f383776-3667-43cc-b405-239953568d16\', \'multiverseId\': 423277}, \'multiverseid\': 423277}, {\'name\': \'Hanna la navigatrice\', \'text\': "{1}{W}{U}, {T} : Renvoyez la carte d\'artefact ou d\'enchantement ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': "« Je n\'avais jamais pensé que je passerais ma vie à me battre. J\'étais faite pour bâtir, non pour détruire. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421873&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e26e786-dfe8-46e8-bda3-e33d5f09f5ae\', \'multiverseId\': 421873}, \'multiverseid\': 421873}, {\'name\': \'Hanna, Pilota della Nave\', \'text\': \'{1}{W}{U}, {T}: Riprendi in mano una carta artefatto o incantesimo bersaglio dal tuo cimitero.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': \'"Non credevo che avrei passato la mia vita a combattere. Sono un\\\'artefice, non una distruttrice."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422224&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a672b7e5-f9df-4c88-b6a7-ee418b52e84b\', \'multiverseId\': 422224}, \'multiverseid\': 422224}, {\'name\': \'航行長ハナ\', \'text\': \'{1}{W}{U}, {T}：あなたの墓地からアーティファクト・カード１枚かエンチャント・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': \'「わたし、戦いの人生を過ごすなんて思ってもいなかったわ。わたしは創造者なのよ、破壊者じゃなくてね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422575&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c865da0-ccf3-40c8-b265-9c934b9049f7\', \'multiverseId\': 422575}, \'multiverseid\': 422575}, {\'name\': \'Hanna, Navegadora\', \'text\': \'{1}{W}{U}, {T}: Devolva o card de artefato ou encantamento alvo de seu cemitério para sua mão.\', \'type\': \'Criatura Lendária — Humano Artesão\', \'flavor\': \'"Nunca pensei que passaria a minha vida lutando. Sou uma construtora, não uma destruidora."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422926&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a804f83a-61b8-4c9e-b864-396a8a282e17\', \'multiverseId\': 422926}, \'multiverseid\': 422926}, {\'name\': \'领航员哈娜\', \'text\': \'{1}{W}{U}，{T}：将目标神器或结界牌从你的坟墓场移回你手上。\', \'type\': \'传奇生物～人类／神器师\', \'flavor\': \'「我竟会将生命虚掷于战斗中。我该作的是创造，而不是破坏。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421171&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dccddbe0-deea-46a2-9749-09caefdf26db\', \'multiverseId\': 421171}, \'multiverseid\': 421171}]', '[{\'name\': \'Hauptmann der Stoßzahnwache\', \'text\': \'Standhaft {G} ({G}, {T}: Lege eine +1/+1-Marke auf diese Kreatur. Spiele Standhaft wie eine Hexerei.)\\nJede Kreatur, die du kontrollierst und auf der mindestens eine +1/+1-Marke liegt, verursacht Trampelschaden.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Ein einziges leises Wort löst die Stampede aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421492&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4684918-a2fe-402e-9e62-5ae936dcbbbe\', \'multiverseId\': 421492}, \'multiverseid\': 421492}, {\'name\': \'Capitana del cargadermo\', \'text\': \'Supervivencia {G}. ({G}, {T}: Pon un contador +1/+1 sobre esta criatura. Activa la habilidad de supervivencia solo como un conjuro.)\\nCada criatura que controlas con un contador +1/+1 sobre ella tiene la habilidad de arrollar.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Una sola palabra da comienzo a la estampida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423247&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'edbf3ab2-b21f-42d1-84ca-decbdaf74fc0\', \'multiverseId\': 423247}, \'multiverseid\': 423247}, {\'name\': "Capitaine de la garde d\'ivoire", \'text\': "Résilience {G} ({G}, {T} : Mettez un marqueur +1/+1 sur cette créature. N\'utilisez la résilience que lorsque vous pourriez lancer un rituel.)\\nChaque créature que vous contrôlez avec un marqueur +1/+1 sur elle a le piétinement.", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'Un simple mot suffit à déclencher la ruée.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421843&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3770c343-cad4-44ec-87ea-522289777460\', \'multiverseId\': 421843}, \'multiverseid\': 421843}, {\'name\': \'Capitano della Guardia di Zanne\', \'text\': \'Perdurare {G} ({G}, {T}: Metti un segnalino +1/+1 su questa creatura. Perdura solo quando potresti lanciare una stregoneria.)\\nOgni creatura con un segnalino +1/+1 che controlli ha travolgere.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Una parola mormorata lancia la carica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422194&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'24deaadf-15a9-415d-8b38-eb375334544e\', \'multiverseId\': 422194}, \'multiverseid\': 422194}, {\'name\': \'牙守りの隊長\', \'text\': \'長久{G}（{G}, {T}：このクリーチャーの上に＋１/＋１カウンターを１個置く。長久はソーサリーとしてのみ行う。）\\nあなたがコントロールする＋１/＋１カウンターが置かれている各クリーチャーはそれぞれトランプルを持つ。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'一つの静かな言葉が暴走を引き起こした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422545&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a1def39-f90f-4e98-817d-372b845029d2\', \'multiverseId\': 422545}, \'multiverseid\': 422545}, {\'name\': \'Capitão do Marfim de Guarda\', \'text\': \'Sobreviver {G} ({G}, {T}: Coloque um marcador +1/+1 nesta criatura. Use sobreviver somente como um feitiço.)\\nCada criatura que você controla com um marcador +1/+1 tem atropelar.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Basta uma palavrinha para desencadear o estouro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422896&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6109fab4-12d9-40e8-9500-2a95216f674c\', \'multiverseId\': 422896}, \'multiverseid\': 422896}, {\'name\': \'牙卫队长\', \'text\': \'延生{G}（{G}，{T}：在此生物上放置一个+1/+1指示物。延生的时机视同法术。）\\n每个由你操控且其上有+1/+1指示物的生物都具有践踏异能。\', \'type\': \'生物～人类／战士\', \'flavor\': \'低声轻语便能引领狂奔。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421141&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90ea9b2d-6d64-4ea9-8a1a-c0a87afee4bf\', \'multiverseId\': 421141}, \'multiverseid\': 421141}]', '[{\'name\': \'Hehres Aushauchen\', \'text\': \'Unverzagt (Dieser Zauberspruch kostet beim Wirken für jeden Gegner {1} weniger.)\\nZerstöre alle Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': \'Atme aus und lass deine Seele von den Winden in die Ewigkeit tragen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421324&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'411a3696-fd10-4851-8327-ab846690caac\', \'multiverseId\': 421324}, \'multiverseid\': 421324}, {\'name\': \'Exhalación sublime\', \'text\': \'Audacia. (Cuesta {1} menos lanzar este hechizo por cada oponente.)\\nDestruye todas las criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'Exhala y deja que los vientos mezan tu alma por toda la eternidad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423079&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1091704b-8d65-4be6-9797-d2a62c737941\', \'multiverseId\': 423079}, \'multiverseid\': 423079}, {\'name\': \'Expiration sublime\', \'text\': \'Témérité (Ce sort coûte {1} de moins à lancer pour chaque adversaire.)\\nDétruisez toutes les créatures.\', \'type\': \'Rituel\', \'flavor\': "Expirez, et laissez le vent emporter votre âme pour l\'éternité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421675&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2dfa9fea-29a4-4c0d-95ff-491a886092f1\', \'multiverseId\': 421675}, \'multiverseid\': 421675}, {\'name\': \'Esalazione Sublime\', \'text\': \'Impavido (Questa magia costa {1} in meno per essere lanciata per ogni avversario.)\\nDistruggi tutte le creature.\', \'type\': \'Stregoneria\', \'flavor\': "Respira e lascia che i venti trasportino la tua anima per tutta l\'eternità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65b97565-a93d-4e14-8c3b-cc207ee4bcaa\', \'multiverseId\': 422026}, \'multiverseid\': 422026}, {\'name\': \'崇高な吐露\', \'text\': \'不抜（この呪文を唱えるためのコストは対戦相手１人につき{1}少なくなる。）\\nすべてのクリーチャーを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'ゆっくり吐いて、魂が風に流れるに任せなさい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422377&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce705c07-cc10-4537-aea0-a1bd34db0a52\', \'multiverseId\': 422377}, \'multiverseid\': 422377}, {\'name\': \'Exalação Sublime\', \'text\': \'Inabalável (Esta mágica custa {1} a menos por cada oponente para ser conjurada.)\\nDestrua todas as criaturas.\', \'type\': \'Feitiço\', \'flavor\': \'Expire e deixe que os ventos carreguem sua alma por toda a eternidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422728&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c38c8f60-89b6-450b-ac7c-10a7e122119b\', \'multiverseId\': 422728}, \'multiverseid\': 422728}, {\'name\': \'升灵吐息\', \'text\': \'不屈（每有一位对手，此咒语便减少{1}来施放。）\\n消灭所有生物。\', \'type\': \'法术\', \'flavor\': \'深呼吸，令清风承灵魂往永生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420973&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'82293162-0689-4acd-9938-cefb182eaff5\', \'multiverseId\': 420973}, \'multiverseid\': 420973}]', '[{\'name\': \'Himmlischer Plattenpanzer\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1 für jede Karte auf deiner Hand.\\nAusrüsten {2}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Sein in Stahl gekleideter Körper spiegelt die Entschlossenheit des Kriegers wider.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421570&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b9240d7-5b4a-4fab-9764-8e511bf0c8e0\', \'multiverseId\': 421570}, \'multiverseid\': 421570}, {\'name\': \'Placa empírea\', \'text\': \'La criatura equipada obtiene +1/+1 por cada carta que haya en tu mano.\\nEquipar {2}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Un cuerpo cubierto de acero refleja la determinación del guerrero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423325&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'397bcad3-28af-4e55-8154-caa861278a9f\', \'multiverseId\': 423325}, \'multiverseid\': 423325}, {\'name\': \'Plaque empyrée\', \'text\': \'La créature équipée gagne +1/+1 pour chaque carte dans votre main.\\nÉquipement {2}\', \'type\': \'Artefact : équipement\', \'flavor\': "Un corps paré d\'acier reflète la volonté d\'un guerrier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421921&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09b7294e-c3af-43d3-8146-fd2bd78e153a\', \'multiverseId\': 421921}, \'multiverseid\': 421921}, {\'name\': \'Piastra Empirea\', \'text\': \'La creatura equipaggiata prende +1/+1 per ogni carta che hai in mano.\\nEquipaggiare {2}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Un corpo in una corazza di acciaio riflette la determinazione del guerriero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422272&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7d9b4f76-1c9d-4b09-bd44-235b3aaea227\', \'multiverseId\': 422272}, \'multiverseid\': 422272}, {\'name\': \'浄火の板金鎧\', \'text\': \'装備しているクリーチャーは、あなたの手札にあるカード１枚につき＋１/＋１の修整を受ける。\\n装備{2}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'鋼を纏った体には戦士の決意が顕れる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422623&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43ab36e7-b6f7-483b-8fa1-c0dce3e1c85b\', \'multiverseId\': 422623}, \'multiverseid\': 422623}, {\'name\': \'Armadura de Placas Empírica\', \'text\': \'A criatura equipada recebe +1/+1 para cada card em sua mão.\\nEquipar {2}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'Um corpo em vestes de aço reflete a determinação de um guerreiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422974&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb1eb326-cd7d-4595-9e69-aa61a923cab4\', \'multiverseId\': 422974}, \'multiverseid\': 422974}, {\'name\': \'穹光神甲\', \'text\': \'你每有一张手牌，佩带此武具的生物便得+1/+1。\\n佩带{2}\', \'type\': \'神器～武具\', \'flavor\': \'身着钢铁重甲，彰显战士决心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421219&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'859a4bd3-6b5c-4e7b-ad4b-581adc0cf9e6\', \'multiverseId\': 421219}, \'multiverseid\': 421219}]', '[{\'name\': \'Horizont-Chimäre\', \'text\': \'Aufblitzen\\nFliegend, verursacht Trampelschaden\\nImmer wenn du eine Karte ziehst, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Chimäre\', \'flavor\': \'„Versuche nicht, einen Sinn in der Chimäre zu erkennen. Die Unmöglichkeit ist ihr Lebensraum." —Kydele, Prophetin des Kruphix\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48e4d778-d3dc-4229-b81e-689459ee4f0a\', \'multiverseId\': 421523}, \'multiverseid\': 421523}, {\'name\': \'Quimera del horizonte\', \'text\': \'Destello.\\nVuela, arrolla.\\nSiempre que robes una carta, ganas 1 vida.\', \'type\': \'Criatura — Quimera\', \'flavor\': \'"No le busques explicación a la quimera. La imposibilidad es su hábitat". —Kydele, profeta de Krufix\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b8f6d5e-a01d-420c-9ded-59c8a177c337\', \'multiverseId\': 423278}, \'multiverseid\': 423278}, {\'name\': "Chimère de l\'horizon", \'text\': \'Flash\\nVol, piétinement\\nÀ chaque fois que vous piochez une carte, vous gagnez 1 point de vie.\', \'type\': \'Créature : chimère\', \'flavor\': "« N\'essayez pas de donner un sens à la chimère. L\'impossibilité est son habitat. » —Kydele, prophétesse de Kruphix", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421874&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0be887dd-43ac-4d0b-af97-dd3f4e796257\', \'multiverseId\': 421874}, \'multiverseid\': 421874}, {\'name\': "Chimera dell\'Orizzonte", \'text\': \'Lampo\\nVolare, travolgere\\nOgniqualvolta peschi una carta, guadagni 1 punto vita.\', \'type\': \'Creatura — Chimera\', \'flavor\': \'"Non cercare di attribuire un senso alla chimera. Il suo habitat è l\\\'impossibile." —Kydele, profetessa di Krufix\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422225&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23e0845b-1f5c-4df9-8f0b-956fab1432c6\', \'multiverseId\': 422225}, \'multiverseid\': 422225}, {\'name\': \'地平線のキマイラ\', \'text\': \'瞬速\\n飛行、トランプル\\nあなたがカードを１枚引くたび、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — キマイラ\', \'flavor\': \'「キマイラの行動を理解しようとは思わないことです。あれは不可能に住まうのですから。」 ――クルフィックスの預言者、キデール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422576&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca2a78d8-2016-41b7-a497-dd2a97b80910\', \'multiverseId\': 422576}, \'multiverseid\': 422576}, {\'name\': \'Quimera do Horizonte\', \'text\': \'Lampejo\\nVoar, atropelar\\nToda vez que você compra um card, você ganha 1 ponto de vida.\', \'type\': \'Criatura — Quimera\', \'flavor\': \'"Não tente encontrar sentido na quimera. A impossibilidade é seu habitat." — Quidele, profeta de Crufix\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422927&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'953f34c9-5ce2-45af-b38d-d9061a26c734\', \'multiverseId\': 422927}, \'multiverseid\': 422927}, {\'name\': \'远扬盖美拉\', \'text\': \'闪现\\n飞行，践踏\\n每当你抓一张牌时，你获得1点生命。\', \'type\': \'生物～盖美拉\', \'flavor\': \'「切勿试图理解盖美拉。它生于不可知之境。」 ～克罗芬斯的先知库黛勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421172&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6196cfe7-3c68-47cb-bc33-e93af9140688\', \'multiverseId\': 421172}, \'multiverseid\': 421172}]', '[{\'name\': \'Hufabdruck des Hirsches\', \'text\': \'Immer wenn du eine Karte ziehst, kannst du eine Hufabdruck-Marke auf den Hufabdruck des Hirsches legen.\\n{2}{W}, entferne vier Hufabdruck-Marken vom Hufabdruck des Hirsches: Erzeuge einen 4/4 weißen Elementarwesen-Kreaturenspielstein mit Flugfähigkeit. Aktiviere diese Fähigkeit nur während deines Zuges.\', \'type\': \'Stammes-Verzauberung — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421386&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'856f23d8-2cb6-47f9-a21d-8751d06da0e4\', \'multiverseId\': 421386}, \'multiverseid\': 421386}, {\'name\': \'Huellas del ciervo\', \'text\': \'Siempre que robes una carta, puedes poner un contador de huella sobre las Huellas del ciervo.\\n{2}{W}, remover cuatro contadores de huellas de las Huellas del ciervo: Crea una ficha de criatura Elemental blanca 4/4 con la habilidad de volar. Activa esta habilidad solo durante tu turno.\', \'type\': \'Encantamiento tribal — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423141&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'adeb077b-bd9b-4063-8eec-4abf534682b7\', \'multiverseId\': 423141}, \'multiverseid\': 423141}, {\'name\': \'Empreintes de sabot du cerf\', \'text\': "À chaque fois que vous piochez une carte, vous pouvez mettre un marqueur « empreinte de sabot » sur les Empreintes de sabot du cerf.\\n{2}{W}, retirez quatre marqueurs « empreinte de sabot » des Empreintes de sabot du cerf : Créez un jeton de créature 4/4 blanche Élémental avec le vol. N\'activez cette capacité que pendant votre tour.", \'type\': \'Enchantement tribal : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421737&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a846be0-9ac7-46ab-9649-2dbe38514e1c\', \'multiverseId\': 421737}, \'multiverseid\': 421737}, {\'name\': \'Impronte del Cervo\', \'text\': \'Ogniqualvolta peschi una carta, puoi mettere un segnalino impronta sulle Impronte del Cervo.\\n{2}{W}, Rimuovi quattro segnalini impronta dalle Impronte del Cervo: Crea una pedina creatura Elementale 4/4 bianca con volare. Attiva questa abilità solo durante il tuo turno.\', \'type\': \'Incantesimo Tribale — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422088&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'272004e3-ca8b-422d-8d01-f9f42eaa3f9c\', \'multiverseId\': 422088}, \'multiverseid\': 422088}, {\'name\': \'雄鹿の蹄の跡\', \'text\': \'あなたがカードを１枚引くたび、あなたは雄鹿の蹄の跡の上に蹄跡カウンターを１個置いてもよい。\\n{2}{W}, 雄鹿の蹄の跡の上から蹄跡カウンターを４個取り除く：飛行を持つ白の４/４のエレメンタル・クリーチャー・トークンを１体生成する。この能力は、あなたのターンの間にのみ起動できる。\', \'type\': \'部族・エンチャント — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7cd0ed34-48a2-4581-bdfb-2dc1c2f8fd1e\', \'multiverseId\': 422439}, \'multiverseid\': 422439}, {\'name\': \'Pegadas do Cervo\', \'text\': \'Toda vez que você compra um card, você pode colocar um marcador de pegada em Pegadas do Cervo.\\n{2}{W}, Remova quatro marcadores de pegada de Pegadas do Cervo: Crie uma ficha de criatura branca 4/4 do tipo Elemental com voar. Ative esta habilidade apenas durante o seu próprio turno.\', \'type\': \'Encantamento Tribal — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422790&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'efa2acbf-3900-4b1f-a5fc-3a8b275fae15\', \'multiverseId\': 422790}, \'multiverseid\': 422790}, {\'name\': \'雄鹿蹄印\', \'text\': \'每当你抓一张牌时，你可以在雄鹿蹄印上放置一个蹄印指示物。\\n{2}{W}，从雄鹿蹄印上移去四个蹄印指示物：派出一个4/4白色，具飞行异能的元素衍生生物。只能于你的回合中起动此异能。\', \'type\': \'部族结界～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'30003aad-e0a1-4e95-9ca3-a9d37171caf1\', \'multiverseId\': 421035}, \'multiverseid\': 421035}]', "[{'name': 'Hurtigwindhöhen', 'text': 'Refugium (Dieses Land kommt getappt ins Spiel. Wenn dies geschieht, schaue dir die obersten vier Karten deiner Bibliothek an, schicke eine davon verdeckt ins Exil und lege den Rest unter deine Bibliothek.)\\n{T}: Erhöhe deinen Manavorrat um {W}.\\n{W}, {T}: Falls du in diesem Zug mit drei oder mehr Kreaturen angegriffen hast, kannst du die ins Exil geschickte Karte wirken, ohne ihre Manakosten zu bezahlen.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421655&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e836b678-f993-4922-b40f-b8d56295b8d0', 'multiverseId': 421655}, 'multiverseid': 421655}, {'name': 'Cumbres viento vigorizante', 'text': 'Esconder. (Esta tierra entra al campo de batalla girada. Cuando lo haga, mira las cuatro primeras cartas de tu biblioteca, exilia una boca abajo y luego pon el resto en el fondo de tu biblioteca.)\\n{T}: Agrega {W} a tu reserva de maná.\\n{W}, {T}: Puedes jugar la carta exiliada sin pagar su coste de maná si atacaste con tres o más criaturas este turno.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423410&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'aeb2b2fe-e2bf-4386-96ae-768e87717fe4', 'multiverseId': 423410}, 'multiverseid': 423410}, {'name': 'Hauts de Ventabrupt', 'text': 'Cachette (Ce terrain arrive sur le champ de bataille engagé. Quand il le fait, regardez les quatre cartes du dessus de votre bibliothèque, exilez-en une face cachée, puis mettez le reste au-dessous de votre bibliothèque.)\\n{T} : Ajoutez {W} à votre réserve.\\n{W}, {T} : Vous pouvez jouer la carte exilée sans payer son coût de mana si vous avez attaqué avec au moins trois créatures ce tour-ci.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422006&type=card', 'language': 'French', 'identifiers': {'scryfallId': '51553ca9-a30a-41f3-9628-0ebc952b4730', 'multiverseId': 422006}, 'multiverseid': 422006}, {'name': 'Alture di Vento Pungente', 'text': 'Nascondiglio (Questa terra entra nel campo di battaglia TAPpata. Quando lo fa, guarda le prime quattro carte del tuo grimorio, esiliane una a faccia in giù, poi metti le altre in fondo al tuo grimorio.)\\n{T}: Aggiungi {W} alla tua riserva di mana.\\n{W}, {T}: Puoi giocare la carta esiliata senza pagare il suo costo di mana se hai attaccato con tre o più creature in questo turno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422357&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'da86d399-8a84-474b-88dc-b71d05bb0738', 'multiverseId': 422357}, 'multiverseid': 422357}, {'name': '風立ての高地', 'text': '秘匿（この土地はタップ状態で戦場に出る。そうしたとき、あなたのライブラリーの一番上から４枚のカードを見て、そのうち１枚を裏向きで追放し、残りをあなたのライブラリーの一番下に置く。）\\n{T}：あなたのマナ・プールに{W}を加える。\\n{W}, {T}：このターンにあなたが３体以上のクリーチャーで攻撃していたなら、あなたはその追放されたカードをそのマナ・コストを支払わずにプレイしてもよい。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422708&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f340fb81-eb70-411d-a08d-2e3bfd7a2e8d', 'multiverseId': 422708}, 'multiverseid': 422708}, {'name': 'Cumes dos Ventos Velozes', 'text': 'Refúgio (Este terreno entra no campo de batalha virado. Quando ele entrar, olhe os quatro cards do topo de seu grimório, exile um com a face voltada para baixo, e depois coloque o restante no fundo de seu grimório.)\\n{T}: Adicione {W} à sua reserva de mana.\\n{W}, {T}: Você pode jogar o card exilado sem pagar seu custo de mana se tiver atacado com três ou mais criaturas neste turno.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423059&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '50479549-ba13-49b2-944a-b43a2a2c7cfa', 'multiverseId': 423059}, 'multiverseid': 423059}, {'name': '迅风高地', 'text': '掩蔽（此地须横置进战场。当它进战场时，检视你牌库顶的四张牌，将其中一张牌面朝下地放逐，然后将其余的牌置于你牌库底。）\\n{T}：加{W}到你的法术力池中。\\n{W}，{T}：如果你于本回合中曾以三个或更多生物攻击，则你可以使用所放逐的牌，且不需支付其法术力费用。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421304&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '024b8f47-c1be-4617-8061-f8177067ecde', 'multiverseId': 421304}, 'multiverseid': 421304}]", "[{'name': 'Höhlen von Koilos', 'text': '{T}: Erhöhe deinen Manavorrat um {C}.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}. Die Höhlen von Koilos fügen dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421604&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0d51d2bf-6b76-47a6-a8f7-1b63a413b41a', 'multiverseId': 421604}, 'multiverseid': 421604}, {'name': 'Cuevas de Koilos', 'text': '{T}: Agrega {C} a tu reserva de maná.\\n{T}: Agrega {W} o {B} a tu reserva de maná. Las Cuevas de Koilos te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423359&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '91f58cad-435f-46d4-abf7-6e5e74ef4b25', 'multiverseId': 423359}, 'multiverseid': 423359}, {'name': 'Cavernes de Koïlos', 'text': '{T} : Ajoutez {C} à votre réserve.\\n{T} : Ajoutez {W} ou {B} à votre réserve. Les Cavernes de Koïlos vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421955&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4d9986e9-838b-43d1-a008-fb5508c1d69b', 'multiverseId': 421955}, 'multiverseid': 421955}, {'name': 'Caverne di Koilos', 'text': '{T}: Aggiungi {C} alla tua riserva di mana.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana. Le Caverne di Koilos ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422306&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3b3dc709-4862-46cb-958a-8fa973d87d90', 'multiverseId': 422306}, 'multiverseid': 422306}, {'name': 'コイロスの洞窟', 'text': '{T}：あなたのマナ・プールに{C}を加える。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。コイロスの洞窟はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422657&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3694de61-0ede-48e0-bfff-8a6ab46aac04', 'multiverseId': 422657}, 'multiverseid': 422657}, {'name': 'Cavernas de Koilos', 'text': '{T}: Adicione {C} à sua reserva de mana.\\n{T}: Adicione {W} ou {B} à sua reserva de mana. Cavernas de Koilos causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423008&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a3680bad-10d4-487a-a0f2-ce874e7e248b', 'multiverseId': 423008}, 'multiverseid': 423008}, {'name': '喀洛斯洞窟', 'text': '{T}：加{C}到你的法术力池中。\\n{T}：加{W}或{B}到你的法术力池中。喀洛斯洞窟对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421253&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9f838aa3-6c6f-49ab-b3f9-a1b7bf84dda2', 'multiverseId': 421253}, 'multiverseid': 421253}]", '[{\'name\': \'Ikra Shidiqi, die Thronräuberin\', \'text\': \'Bedrohlich\\nImmer wenn eine Kreatur, die du kontrollierst, einem Spieler Kampfschaden zufügt, erhältst du Lebenspunkte in Höhe ihrer Widerstandskraft dazu.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Naga, Zauberer\', \'flavor\': \'„Nun herrschen die Geschuppten über Tarkir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421351&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f694ae8b-7c97-4963-bee5-7bb53f00db76\', \'multiverseId\': 421351}, \'multiverseid\': 421351}, {\'name\': \'Ikra Shidiqi, la usurpadora\', \'text\': \'Amenaza.\\nSiempre que una criatura que controlas haga daño de combate a un jugador, ganas una cantidad de vidas igual a la resistencia de esa criatura.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Hechicero naga\', \'flavor\': \'"Ahora las escamas gobiernan Tarkir".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423106&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'274879c0-9fda-4e12-9fa2-1be39031050c\', \'multiverseId\': 423106}, \'multiverseid\': 423106}, {\'name\': "Ikra Shidiqi, l\'usurpatrice", \'text\': "Menace\\nÀ chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à un joueur, vous gagnez un nombre de points de vie égal à l\'endurance de cette créature.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature légendaire : naga et sorcier\', \'flavor\': \'« Ce sont les squameux qui règnent sur Tarkir désormais. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421702&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a493c13-5ed1-4ad5-94c5-652217801dc4\', \'multiverseId\': 421702}, \'multiverseid\': 421702}, {\'name\': "Ikra Shidiqi, l\'Usurpatrice", \'text\': \'Minacciare\\nOgniqualvolta una creatura che controlli infligge danno da combattimento a un giocatore, guadagni punti vita pari alla costituzione di quella creatura.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)\', \'type\': \'Creatura Leggendaria — Mago Naga\', \'flavor\': \'"Ora è la scaglia a governare Tarkir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422053&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'abc77429-ac14-4bb6-94ec-9063c19f9064\', \'multiverseId\': 422053}, \'multiverseid\': 422053}, {\'name\': \'簒奪者、イクラ・シディーキ\', \'text\': \'威迫\\nあなたがコントロールするクリーチャー１体がプレイヤー１人に戦闘ダメージを与えるたび、あなたはそのクリーチャーのタフネスに等しい点数のライフを得る。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — ナーガ・ウィザード\', \'flavor\': \'「今やタルキールは鱗ある者が支配している。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422404&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5212d47c-4ffc-4524-8ef8-afee7d44b876\', \'multiverseId\': 422404}, \'multiverseid\': 422404}, {\'name\': \'Ikra Shidiqi, a Usurpadora\', \'text\': \'Ameaçar\\nToda vez que uma criatura que você controla causa dano de combate a um jogador, você ganha uma quantidade de pontos de vida igual à resistência daquela criatura.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Naga Mago\', \'flavor\': \'"Agora, os escamados governam Tarkir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422755&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3969e851-5fd8-4bd5-949c-5d33b919bdd3\', \'multiverseId\': 422755}, \'multiverseid\': 422755}, {\'name\': \'僭位之徒依夸希迪奇\', \'text\': \'威慑\\n每当一个由你操控的生物对任一牌手造成战斗伤害时，你获得等同于该生物防御力的生命。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～那伽／法术师\', \'flavor\': \'「如今，有鳞一族统治着鞑契。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'59617115-3621-4231-913b-d6713cff40ea\', \'multiverseId\': 421000}, \'multiverseid\': 421000}]', '[{\'name\': \'Immervoller Kelch\', \'text\': \'Multibonus {2} (Du kannst zusätzlich beliebig oft {2} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nDer Immervolle Kelch kommt mit X Ladungsmarken ins Spiel, wobei X die Anzahl ist, wie oft seine Bonuskosten bezahlt wurden.\\n{T}: Erhöhe deinen Manavorrat für jede Ladungsmarke auf dem Immervollen Kelch um {C}.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421572&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82403e15-c52d-4e66-94e1-fb207126ca14\', \'multiverseId\': 421572}, \'multiverseid\': 421572}, {\'name\': \'Cáliz flujo eterno\', \'text\': \'Multiestímulo {2}. (Puedes pagar {2} adicional tantas veces como quieras al lanzar este hechizo.)\\nEl Cáliz flujo eterno entra al campo de batalla con un contador de carga sobre él por cada vez que fue estimulado.\\n{T}: Agrega {C} a tu reserva de maná por cada contador de carga sobre el Cáliz flujo eterno.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423327&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c0c89d03-430e-482b-bc8b-d017e86bb039\', \'multiverseId\': 423327}, \'multiverseid\': 423327}, {\'name\': \'Calice toujours ruisselant\', \'text\': "Multikick {2} (Vous pouvez payer {2} supplémentaires autant de fois que vous le souhaitez au moment où vous lancez ce sort.)\\nLe Calice toujours ruisselant arrive sur le champ de bataille avec, sur lui, un marqueur « charge » pour chaque fois qu\'il a été kické.\\n{T} : Ajoutez {C} à votre réserve pour chaque marqueur « charge » sur le Calice toujours ruisselant.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421923&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a63cdce8-fd98-49eb-a5f7-ce9de677c0de\', \'multiverseId\': 421923}, \'multiverseid\': 421923}, {\'name\': \'Calice Infinito\', \'text\': \'Multipotenziamento {2} (Puoi pagare {2} addizionale un qualsiasi numero di volte mentre lanci questa magia.)\\nIl Calice Infinito entra nel campo di battaglia con un segnalino carica per ogni volta che è stato potenziato.\\n{T}: Aggiungi {C} alla tua riserva di mana per ogni segnalino carica sul Calice Infinito.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422274&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7506609e-a19e-4ba4-9abc-59dc2c88eaa7\', \'multiverseId\': 422274}, \'multiverseid\': 422274}, {\'name\': \'永遠溢れの杯\', \'text\': \'多重キッカー{2}（あなたはこの呪文を唱えるに際し、追加で{2}を望む回数支払ってもよい。）\\n永遠溢れの杯は、これがキッカーされた１回につき蓄積カウンターが１個置かれた状態で戦場に出る。\\n{T}：あなたのマナ・プールに、永遠溢れの杯の上に置かれている蓄積カウンター１個につき{C}を加える。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422625&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22e127b3-da42-4b4f-aace-cc2f7ba2d1ce\', \'multiverseId\': 422625}, \'multiverseid\': 422625}, {\'name\': \'Cálice do Fluxo Perene\', \'text\': \'Multireforçar {2} (Você pode pagar um custo adicional de {2} quantas vezes quiser conforme conjura esta mágica.)\\nCálice do Fluxo Perene entra no campo de batalha com um marcador de carga para cada vez que tiver sido reforçado.\\n{T}: Adicione {C} à sua reserva de mana para cada marcador de carga em Cálice do Fluxo Perene.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422976&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c4004725-ebc4-4314-8b4f-5787becde550\', \'multiverseId\': 422976}, \'multiverseid\': 422976}, {\'name\': \'汩汩圣杯\', \'text\': \'多重增幅{2}（你施放此咒语时可以任意次数地额外支付{2}。）\\n汩汩圣杯进战场时上面有数个充电指示物，其数量为它增幅过的次数。\\n{T}：汩汩圣杯上每有一个充电指示物，便加{C}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421221&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6c5896e-c425-42b4-99e2-0eac3d00b827\', \'multiverseId\': 421221}, \'multiverseid\': 421221}]', '[{\'name\': \'Immerändernde Weite\', \'text\': \'{T}, opfere die Immerändernde Weite: Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe sie getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Zwei Schritte nach Norden führen dich in die ungewisse Zukunft, nach Süden in die unruhige Vergangenheit, nach Osten in den heutigen Tag und nach Westen in das große Durcheinander.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'205d1325-33d5-4d75-beec-50560622eaf3\', \'multiverseId\': 421651}, \'multiverseid\': 421651}, {\'name\': \'Expansión terramórfica\', \'text\': \'{T}, sacrificar la Expansión terramórfica: Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Haz dos pasos al norte hacia el futuro inestable, al sur hacia el pasado inquieto, al este hacia el presente o al oeste hacia lo desconocido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423406&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e382f6b-276a-42ed-8019-181b18953b7c\', \'multiverseId\': 423406}, \'multiverseid\': 423406}, {\'name\': \'Immensité terramorphe\', \'text\': "{T}, sacrifiez l\'Immensité terramorphe : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': "Faites deux pas au nord dans l\'avenir instable, au sud dans le passé agité, à l\'est dans le présent ou à l\'ouest dans le vaste inconnu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422002&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'713db4fe-b35d-44bd-ac20-4337c2d1a393\', \'multiverseId\': 422002}, \'multiverseid\': 422002}, {\'name\': \'Distesa Terramorfica\', \'text\': \'{T}, Sacrifica la Distesa Terramorfica: Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Fai due passi a nord nel futuro incerto, a sud nel passato inquieto, a est nel giorno attuale o a ovest nel grande ignoto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422353&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb18a4d2-997e-4aea-ab1a-8dd87b3becff\', \'multiverseId\': 422353}, \'multiverseid\': 422353}, {\'name\': \'広漠なる変幻地\', \'text\': \'{T}, 広漠なる変幻地を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、それをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'二歩北へ進めば不安定な未来、南へ進めば不穏な過去、東に進めば今日この日、西へ進めば偉大なる未知。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422704&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29946a9f-96ba-4799-bb80-4d4ca1738508\', \'multiverseId\': 422704}, \'multiverseid\': 422704}, {\'name\': \'Vastidão Morfoterrena\', \'text\': \'{T}, Sacrifique Vastidão Morfoterrena: Procure um card de terreno básico em seu grimório e coloque-o virado no campo de batalha. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Dê dois passos ao norte para o futuro incerto, ao sul para o passado inquieto, ao leste para o presente, ou ao oeste para o grande desconhecido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423055&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fcbb5e7a-9560-4b67-abb4-c04081415057\', \'multiverseId\': 423055}, \'multiverseid\': 423055}, {\'name\': \'地塑旷野\', \'text\': \'{T}，牺牲地塑旷野：从你的牌库中搜寻一张基本地牌，并将之横置放进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'迈开两步，向北迈进动荡将来，向南则为无宁过往，向东步回眼下此刻，或向西踏入未知境地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421300&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'827a8d96-8ef7-488e-9fb1-45d6fa6f4619\', \'multiverseId\': 421300}, \'multiverseid\': 421300}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421659&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a2669a5c-7114-475d-99fc-8acae26ced0a', 'multiverseId': 421659}, 'multiverseid': 421659}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423414&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '87629fce-3b3a-465f-831c-be92d9ba3565', 'multiverseId': 423414}, 'multiverseid': 423414}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422010&type=card', 'language': 'French', 'identifiers': {'scryfallId': '232c150f-8724-4f88-8f74-0871ab8ae7ba', 'multiverseId': 422010}, 'multiverseid': 422010}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422361&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5e9f449c-7c04-4e56-ba92-2f7605e639b0', 'multiverseId': 422361}, 'multiverseid': 422361}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422712&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '20432ecf-b78b-480b-80fa-65d2c3480078', 'multiverseId': 422712}, 'multiverseid': 422712}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423063&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b759a1ca-87a4-424c-a438-3c94e5d9635b', 'multiverseId': 423063}, 'multiverseid': 423063}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421308&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8707e8e3-71b1-4c16-ae20-2d11d2d92b65', 'multiverseId': 421308}, 'multiverseid': 421308}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421660&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4e2b975d-5981-4ba2-97c8-9223d617bfd2', 'multiverseId': 421660}, 'multiverseid': 421660}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423415&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f85e5160-9cc1-4c7d-89ad-24f5a1d6b44c', 'multiverseId': 423415}, 'multiverseid': 423415}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422011&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2eab2d43-0c5d-4c8d-b6d5-83500bf8bbe2', 'multiverseId': 422011}, 'multiverseid': 422011}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422362&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3cd9c267-7f4a-4381-89a8-83d4d773cf86', 'multiverseId': 422362}, 'multiverseid': 422362}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422713&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c0ac60cc-44b7-4b7d-840b-37a0c7fe06d9', 'multiverseId': 422713}, 'multiverseid': 422713}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423064&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '99fd44d0-15df-409e-a08b-4abdbfcf415a', 'multiverseId': 423064}, 'multiverseid': 423064}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421309&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5751428d-7c32-4250-bf3b-9608e4b1c253', 'multiverseId': 421309}, 'multiverseid': 421309}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421661&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd1e8a9ce-2b65-49a6-96a4-dc0233868339', 'multiverseId': 421661}, 'multiverseid': 421661}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423416&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bfc60963-71ec-4f51-a014-75e22307df4c', 'multiverseId': 423416}, 'multiverseid': 423416}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422012&type=card', 'language': 'French', 'identifiers': {'scryfallId': '24298b7f-ad6a-40af-b8ed-3d75f89400d4', 'multiverseId': 422012}, 'multiverseid': 422012}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422363&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '456f844a-950c-4620-addb-0af45cd5f075', 'multiverseId': 422363}, 'multiverseid': 422363}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422714&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2014dd71-5226-4a89-a4a7-0fc6aae3c29b', 'multiverseId': 422714}, 'multiverseid': 422714}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423065&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c5ed9c99-0fc5-42be-ad95-b52b3fda0273', 'multiverseId': 423065}, 'multiverseid': 423065}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421310&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '78f4ba58-27d5-4529-b923-55d5670efa30', 'multiverseId': 421310}, 'multiverseid': 421310}]", '[{\'name\': \'Iroas, Gott des Sieges\', \'text\': \'Unzerstörbar\\nSolange deine Hingabe zu Rot und Weiß weniger als sieben beträgt, ist Iroas keine Kreatur.\\nKreaturen, die du kontrollierst, haben Bedrohlichkeit.\\nVerhindere allen Schaden, der angreifenden Kreaturen, die du kontrollierst, zugefügt würde.\', \'type\': \'Legendäre Verzauberungskreatur — Gott\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7522aaa-eb53-4807-b703-7c7346e3b9ca\', \'multiverseId\': 421524}, \'multiverseid\': 421524}, {\'name\': \'Iroas, dios de la victoria\', \'text\': \'Indestructible.\\nMientras tu devoción al rojo y al blanco sea menor que siete, Iroas no es una criatura.\\nLas criaturas que controlas tienen la habilidad de amenaza.\\nPrevén todo el daño que se les fuera a hacer a las criaturas atacantes que controlas.\', \'type\': \'Criatura encantamiento legendaria — Deidad\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423279&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc5c268e-d853-427b-b9c3-050679105e77\', \'multiverseId\': 423279}, \'multiverseid\': 423279}, {\'name\': \'Iroas, dieu de la Victoire\', \'text\': "Indestructible\\nTant que votre dévotion au rouge et au blanc est inférieure à sept, Iroas n\'est pas une créature.\\nLes créatures que vous contrôlez ont la menace.\\nPrévenez toutes les blessures qui devraient être infligées aux créatures attaquantes que vous contrôlez.", \'type\': \'Créature-enchantement légendaire : dieu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421875&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6f62c0e-4daa-453f-b998-a62aaa1d3779\', \'multiverseId\': 421875}, \'multiverseid\': 421875}, {\'name\': \'Iroas, Dio della Vittoria\', \'text\': \'Indistruttibile\\nFintanto che la tua devozione al rosso e al bianco è inferiore a sette, Iroas non è una creatura.\\nLe creature che controlli hanno minacciare.\\nPrevieni tutto il danno che verrebbe inflitto alle creature attaccanti che controlli.\', \'type\': \'Creatura Incantesimo Leggendaria — Dio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422226&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e3e5a94-0a6f-4e84-b1d6-7f1319023b64\', \'multiverseId\': 422226}, \'multiverseid\': 422226}, {\'name\': \'勝利の神、イロアス\', \'text\': \'破壊不能\\nあなたの赤と白への信心が７未満であるかぎり、勝利の神、イロアスはクリーチャーではない。\\nあなたがコントロールするクリーチャーは威迫を持つ。\\nあなたがコントロールする攻撃クリーチャーに与えられるすべてのダメージを軽減する。\', \'type\': \'伝説のクリーチャー・エンチャント — 神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422577&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c07db248-1c5e-4647-ba71-7c36db599d4f\', \'multiverseId\': 422577}, \'multiverseid\': 422577}, {\'name\': \'Iroas, Deus da Vitória\', \'text\': \'Indestrutível\\nEnquanto sua devoção ao vermelho e ao branco for menor que sete, Iroas não será uma criatura.\\nAs criaturas que você controla têm ameaçar.\\nPrevina todo o dano que seria causado às criaturas atacantes que você controla.\', \'type\': \'Criatura Encantamento Lendária — Deus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7249180-e107-4f30-ab44-5dbcf3166278\', \'multiverseId\': 422928}, \'multiverseid\': 422928}, {\'name\': \'胜利神伊洛安斯\', \'text\': \'不灭\\n只要你的红白两色献力小于七，伊洛安斯便不是生物。\\n由你操控的生物具有威慑异能。\\n防止将对由你操控且进行攻击的生物造成的所有伤害。\', \'type\': \'传奇结界生物～神\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421173&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a36e6f77-672c-4003-ab35-75133f008123\', \'multiverseId\': 421173}, \'multiverseid\': 421173}]', '[{\'name\': \'Ishai, Ojutai-Drachensprecherin\', \'text\': \'Fliegend\\nImmer wenn ein Gegner einen Zauberspruch wirkt, lege eine +1/+1-Marke auf Ishai, Ojutai-Drachensprecherin.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Vogel, Mönch\', \'flavor\': \'„Durch mich soll diese Welt die Stimme des Großen Lehrmeisters vernehmen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421352&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'615e3c77-cfde-4d70-ab2e-abc6bd748fc1\', \'multiverseId\': 421352}, \'multiverseid\': 421352}, {\'name\': \'Ishai, dragonhablante de Ójutai\', \'text\': \'Vuela.\\nSiempre que un oponente lance un hechizo, pon un contador +1/+1 sobre Ishai, dragonhablante de Ójutai.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Monje ave\', \'flavor\': \'"La voz del Gran Maestro resonará en este mundo a través de mí".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423107&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2e91db4-c2f7-458c-a856-5db378a90758\', \'multiverseId\': 423107}, \'multiverseid\': 423107}, {\'name\': "Ishaï, languedragon d\'Ojutaï", \'text\': "Vol\\nÀ chaque fois qu\'un adversaire lance un sort, mettez un marqueur +1/+1 sur Ishaï, languedragon d\'Ojutaï.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature légendaire : oiseau et moine\', \'flavor\': \'« À travers moi, la voix du Grand précepteur secouera ce monde. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421703&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bb7cdfcc-ef73-4f6c-8e65-79eae5e805b1\', \'multiverseId\': 421703}, \'multiverseid\': 421703}, {\'name\': \'Ishai, Dracofona Ojutai\', \'text\': \'Volare\\nOgniqualvolta un avversario lancia una magia, metti un segnalino +1/+1 su Ishai, Dracofona Ojutai.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)\', \'type\': \'Creatura Leggendaria — Monaco Uccello\', \'flavor\': \'"Attraverso di me, la voce del Gran Maestro scuoterà questo mondo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422054&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b74bb20f-25fe-46f0-bb37-2df5c1b99d63\', \'multiverseId\': 422054}, \'multiverseid\': 422054}, {\'name\': \'オジュタイの龍語り、イーシャイ\', \'text\': \'飛行\\n対戦相手が呪文を１つ唱えるたび、オジュタイの龍語り、イーシャイの上に＋１/＋１カウンターを１個置く。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — 鳥・モンク\', \'flavor\': \'「我が口の語る偉大なる師の御言葉が、世の騒乱となりましょう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422405&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e82dc59a-0e7c-4786-830e-dad646233ba0\', \'multiverseId\': 422405}, \'multiverseid\': 422405}, {\'name\': \'Ishai, Porta-voz dos Dragões de Ojutai\', \'text\': \'Voar\\nToda vez que um oponente conjurar uma mágica, coloque um marcador +1/+1 em Ishai, Porta-voz dos Dragões de Ojutai.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Ave Monge\', \'flavor\': \'"Por meio de mim, a voz do Grande Professor sacudirá este mundo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422756&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc77bcd6-7986-480b-8678-17e02154fcd3\', \'multiverseId\': 422756}, \'multiverseid\': 422756}, {\'name\': \'欧祝泰族龙语者依谢\', \'text\': \'飞行\\n每当任一对手施放咒语时，在欧祝泰族龙语者依谢上放置一个+1/+1指示物。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～鸟／修行僧\', \'flavor\': \'「通过我，大宗师的声音将响彻这个世界。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421001&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04864839-934e-400e-a676-113574d9974b\', \'multiverseId\': 421001}, \'multiverseid\': 421001}]', '[{\'name\': \'Izzet-Dampfwerk\', \'text\': \'Das Izzet-Dampfwerk kommt getappt ins Spiel.\\nWenn das Izzet-Dampfwerk ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {U}{R}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421621&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'63c3b4b5-ebb2-4c89-95d5-2f3f629162e4\', \'multiverseId\': 421621}, \'multiverseid\': 421621}, {\'name\': \'Calderas ízzet\', \'text\': \'Las Calderas ízzet entran al campo de batalla giradas.\\nCuando las Calderas ízzet entren al campo de batalla, regresa una tierra que controlas a la mano de su propietario.\\n{T}: Agrega {U}{R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423376&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07a7d310-b7cf-4e00-bf06-ff8f6bcef784\', \'multiverseId\': 423376}, \'multiverseid\': 423376}, {\'name\': "Chaufferie d\'Izzet", \'text\': "La Chaufferie d\'Izzet arrive sur le champ de bataille engagée.\\nQuand la Chaufferie d\'Izzet arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {U}{R} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421972&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3e50917-8940-47a8-81e5-e37069b7992a\', \'multiverseId\': 421972}, \'multiverseid\': 421972}, {\'name\': \'Ebollitori Izzet\', \'text\': \'Gli Ebollitori Izzet entrano nel campo di battaglia TAPpati.\\nQuando gli Ebollitori Izzet entrano nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {U}{R} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422323&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50780761-c311-4481-b5f4-e6e5484c6668\', \'multiverseId\': 422323}, \'multiverseid\': 422323}, {\'name\': \'イゼットの煮沸場\', \'text\': \'イゼットの煮沸場はタップ状態で戦場に出る。\\nイゼットの煮沸場が戦場に出たとき、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{U}{R}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422674&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9383c794-6181-4d4c-9af0-893f3cd96db9\', \'multiverseId\': 422674}, \'multiverseid\': 422674}, {\'name\': \'Fábrica de Caldeira Izzet\', \'text\': \'Fábrica de Caldeira Izzet entra no campo de batalha virado.\\nQuando Fábrica de Caldeira Izzet entrar no campo de batalha, devolva um terreno que você controla para a mão de seu dono.\\n{T}: Adicione {U}{R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423025&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a7f13f1-181f-4191-875b-00bac5f6c581\', \'multiverseId\': 423025}, \'multiverseid\': 423025}, {\'name\': \'伊捷炼炉厂\', \'text\': \'伊捷炼炉厂须横置进战场。\\n当伊捷炼炉厂进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{U}{R}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421270&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d3b7b79b-78e3-47b1-9b2a-03471113c8be\', \'multiverseId\': 421270}, \'multiverseid\': 421270}]', '[{\'name\': \'Jor Kadeen der Obwalter\', \'text\': \'Erstschlag\\nMetallkunst — Kreaturen, die du kontrollierst, erhalten +3/+0, solange du drei oder mehr Artefakte kontrollierst.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': \'„Solange in meinen Händen noch ein Schwert ist, gibt es noch Hoffnung für ein wieder gereinigtes Mirrodin."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421525&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26e56296-369a-4684-8e3c-37884b57b197\', \'multiverseId\': 421525}, \'multiverseid\': 421525}, {\'name\': \'Jor Kadeen, el prevaleciente\', \'text\': \'Daña primero.\\nMetalurgia — Las criaturas que controlas obtienen +3/+0 mientras controles tres o más artefactos.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': \'"Mientras tenga una espada en mi mano, habrá esperanza de un Mirrodin puro".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423280&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db6588ff-aaf2-47d8-b984-aa23cc7bee70\', \'multiverseId\': 423280}, \'multiverseid\': 423280}, {\'name\': \'Jor Kadeen, le Triomphant\', \'text\': \'Initiative\\nArt des métaux — Les créatures que vous contrôlez gagnent +3/+0 tant que vous contrôlez au moins trois artefacts.\', \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': "« Tant que j\'ai encore une lame en main, l\'espoir d\'un Mirrodin purifié perdure. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421876&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e75b880e-4217-4a7f-98a9-124484ff0b19\', \'multiverseId\': 421876}, \'multiverseid\': 421876}, {\'name\': \'Jor Kadeen, il Trionfatore\', \'text\': \'Attacco improvviso\\nMetallurgia — Le creature che controlli prendono +3/+0 fintanto che controlli tre o più artefatti.\', \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': \'"Finché impugnerò una lama, ci sarà speranza di vedere di nuovo un Mirrodin puro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422227&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9980629f-9b8b-4428-b14b-3bf7106a4ad4\', \'multiverseId\': 422227}, \'multiverseid\': 422227}, {\'name\': \'覇者、ジョー・カディーン\', \'text\': \'先制攻撃\\n金属術 ― あなたが３つ以上のアーティファクトをコントロールしているかぎり、あなたがコントロールするクリーチャーは＋３/＋０の修整を受ける。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': \'「私の手に剣がある限り、清純なるミラディンを取戻す希望は残っている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422578&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5cabb983-10cf-405b-a582-fa2202c9e3e3\', \'multiverseId\': 422578}, \'multiverseid\': 422578}, {\'name\': \'Jor Kadeen, o Prevalente\', \'text\': \'Iniciativa\\nMaestria com metais — As criaturas que você controla receberão +3/+0 enquanto você controlar três ou mais artefatos.\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': \'"Enquanto minha mão empunhar uma espada, haverá esperança de uma Mirrodin pura novamente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422929&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0d886e2-a788-4f3b-a6d8-70670ebc6a5a\', \'multiverseId\': 422929}, \'multiverseid\': 422929}, {\'name\': \'百胜尤克定\', \'text\': \'先攻\\n金技～只要你操控三个或更多神器，由你操控的生物便得+3/+0。\', \'type\': \'传奇生物～人类／战士\', \'flavor\': \'「只要我手上握着剑，就有希望再见到纯净秘罗地。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421174&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'564a216a-f81f-4aa0-ac7c-7da37b86193d\', \'multiverseId\': 421174}, \'multiverseid\': 421174}]', '[{\'name\': \'Kalonische Hydra\', \'text\': \'Verursacht Trampelschaden\\nDie Kalonische Hydra kommt mit vier +1/+1-Marken ins Spiel.\\nImmer wenn die Kalonische Hydra angreift, verdoppele die Anzahl der +1/+1-Marken auf jeder Kreatur, die du kontrollierst.\', \'type\': \'Kreatur — Hydra\', \'flavor\': \'Selbst Baloths fürchten sie, wenn sie Hunger hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421473&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6dc59f3-6cdb-46b2-8119-47c67fce49d8\', \'multiverseId\': 421473}, \'multiverseid\': 421473}, {\'name\': \'Hidra kaloniana\', \'text\': \'Arrolla.\\nLa Hidra kaloniana entra al campo de batalla con cuatro contadores +1/+1 sobre ella.\\nSiempre que la Hidra kaloniana ataque, duplica el número de contadores +1/+1 sobre cada criatura que controles.\', \'type\': \'Criatura — Hidra\', \'flavor\': \'Incluso los báloths le temen cuando es su hora de comer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423228&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'414919ed-7555-4f61-b5bb-c088ffa019f8\', \'multiverseId\': 423228}, \'multiverseid\': 423228}, {\'name\': \'Hydre kalonienne\', \'text\': "Piétinement\\nL\'Hydre kalonienne arrive sur le champ de bataille avec quatre marqueurs +1/+1 sur elle.\\nÀ chaque fois que l\'Hydre kalonienne attaque, doublez le nombre de marqueurs +1/+1 sur chaque créature que vous contrôlez.", \'type\': \'Créature : hydre\', \'flavor\': "Même les baloths redoutent l\'heure de son repas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421824&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a76c9a6a-fa3d-4cda-9a25-cab257caf8dc\', \'multiverseId\': 421824}, \'multiverseid\': 421824}, {\'name\': \'Idra di Kalonia\', \'text\': "Travolgere\\nL\'Idra di Kalonia entra nel campo di battaglia con quattro segnalini +1/+1.\\nOgniqualvolta l\'Idra di Kalonia attacca, raddoppia il numero di segnalini +1/+1 su ogni creatura che controlli.", \'type\': \'Creatura — Idra\', \'flavor\': \'Persino i baloth la temono quando va a caccia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422175&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'92b589a2-d75a-4329-b32b-d5c2c967dfec\', \'multiverseId\': 422175}, \'multiverseid\': 422175}, {\'name\': \'カロニアのハイドラ\', \'text\': \'トランプル\\nカロニアのハイドラは＋１/＋１カウンターが４個置かれた状態で戦場に出る。\\nカロニアのハイドラが攻撃するたび、あなたがコントロールする各クリーチャーの上に置かれている＋１/＋１カウンターの数を２倍にする。\', \'type\': \'クリーチャー — ハイドラ\', \'flavor\': \'ベイロスですらそれの食事時には恐れをなす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422526&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'940e6dc5-b581-4869-8b3f-4ee96dbeed7c\', \'multiverseId\': 422526}, \'multiverseid\': 422526}, {\'name\': \'Hidra Kaloniana\', \'text\': \'Atropelar\\nHidra Kaloniana entra no campo de batalha com quatro marcadores +1/+1.\\nToda vez que Hidra Kaloniana atacar, duplique o número de marcadores +1/+1 em cada criatura que você controla.\', \'type\': \'Criatura — Hidra\', \'flavor\': \'Até mesmo baloths temem a hora da refeição dela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422877&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5a65b958-dc16-435b-90dc-0d30c42a6d28\', \'multiverseId\': 422877}, \'multiverseid\': 422877}, {\'name\': \'卡隆尼亚多头龙\', \'text\': \'践踏\\n卡隆尼亚多头龙进战场时上面有四个+1/+1指示物。\\n每当卡隆尼亚多头龙攻击时，将每个由你操控的生物上之+1/+1指示物数量加倍。\', \'type\': \'生物～多头龙\', \'flavor\': \'即使是巴洛西，也会在它的吃饭时间感到胆寒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421122&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'38240ac1-3556-453f-be8d-128db0085b93\', \'multiverseId\': 421122}, \'multiverseid\': 421122}]', '[{\'name\': \'Kampfanzug\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+2, hat Eile, kann weder dich noch einen Planeswalker, den du kontrollierst, angreifen und kann nicht geopfert werden.\\nZu Beginn des Versorgungssegments jedes Gegners kannst du diesen Spieler bis zum Ende des Zuges die Kontrolle über die ausgerüstete Kreatur übernehmen lassen. Falls du dies tust, enttappe sie.\\nAusrüsten {3}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421561&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4fef7cae-5558-49ad-9cdf-add93f3c3134\', \'multiverseId\': 421561}, \'multiverseid\': 421561}, {\'name\': \'Armadura de asalto\', \'text\': \'La criatura equipada obtiene +2/+2, tiene la habilidad de prisa, no puede atacarte a ti o a un planeswalker que controlas y no puede ser sacrificada.\\nAl comienzo del mantenimiento de cada oponente, puedes hacer que ese jugador gane el control de la criatura equipada hasta el final del turno. Si lo haces, enderézala.\\nEquipar {3}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423316&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab38256f-c750-44bb-9946-0324096404a0\', \'multiverseId\': 423316}, \'multiverseid\': 423316}, {\'name\': "Cuirasse d\'assaut", \'text\': "La créature équipée gagne +2/+2, a la célérité, ne peut pas vous attaquer ou attaquer un planeswalker que vous contrôlez et ne peut pas être sacrifiée.\\nAu début de l\'entretien de chaque adversaire, vous pouvez faire que ce joueur acquière le contrôle de la créature équipée jusqu\'à la fin du tour. Si vous faites ainsi, dégagez-la.\\nÉquipement {3}", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421912&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2920a705-069d-4a76-a32b-787c622a2de7\', \'multiverseId\': 421912}, \'multiverseid\': 421912}, {\'name\': "Corazza d\'Assalto", \'text\': "La creatura equipaggiata prende +2/+2, ha rapidità, non può attaccare te o un planeswalker che controlli e non può essere sacrificata.\\nAll\'inizio del mantenimento di ogni avversario, puoi far prendere il controllo della creatura equipaggiata a quel giocatore fino alla fine del turno. Se lo fai, STAPpala.\\nEquipaggiare {3}", \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422263&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37469b6b-7405-469f-947b-9d71970de405\', \'multiverseId\': 422263}, \'multiverseid\': 422263}, {\'name\': \'突撃鎧\', \'text\': \'装備しているクリーチャーは、＋２/＋２の修整を受け、速攻を持ち、あなたやあなたがコントロールするプレインズウォーカーを攻撃できず、生け贄に捧げることもできない。\\n各対戦相手のアップキープの開始時に、あなたは「ターン終了時まで、そのプレイヤーは装備しているクリーチャーのコントロールを得る。」を選んでもよい。そうしたなら、それをアンタップする。\\n装備{3}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422614&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca57cb4a-a147-406e-8b6e-24876eabc354\', \'multiverseId\': 422614}, \'multiverseid\': 422614}, {\'name\': \'Traje de Assalto\', \'text\': \'A criatura equipada recebe +2/+2, tem ímpeto, não pode atacar você nem um planeswalker que você controle e não pode ser sacrificada.\\nNo início da manutenção de cada oponente, você pode fazer com que aquele jogador ganhe o controle da criatura equipada até o final do turno. Se fizer isso, desvire-a.\\nEquipar {3}\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422965&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0985bfdd-e482-43fe-bec6-496ab69a6b0f\', \'multiverseId\': 422965}, \'multiverseid\': 422965}, {\'name\': \'突击装\', \'text\': \'佩带此武具的生物得+2/+2，具有敏捷异能，不能攻击你或由你操控的鹏洛客，且不能被牺牲。\\n在每位对手的维持开始时，你可以让该牌手获得佩带此武具之生物的操控权直到回合结束。若你如此作，则将它重置。\\n佩带{3}\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421210&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e60c12a2-5f0d-4bec-898d-01f160f8d95d\', \'multiverseId\': 421210}, \'multiverseid\': 421210}]', '[{\'name\': \'Kapsel des Henkers\', \'text\': \'{1}{B}, {T}, opfere die Kapsel des Henkers: Zerstöre eine nichtschwarze Kreatur deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'Es gibt immer einen kleinen Moment der Beklemmung, bevor die Kapsel mit der Nachricht geöffnet wird, da niemand das Urteil vorher kennt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421428&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6b9ccc8a-3cab-438a-8547-3374e4cf776a\', \'multiverseId\': 421428}, \'multiverseid\': 421428}, {\'name\': \'Cápsula del verdugo\', \'text\': \'{1}{B}, {T}, sacrificar la Cápsula del verdugo: Destruye la criatura objetivo que no sea negra.\', \'type\': \'Artefacto\', \'flavor\': \'Siempre hay un momento de duda antes de abrir una cápsula mensajera, por miedo al juicio que podría contener.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423183&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc17ecaa-a2fd-402c-a1b4-ec628fc6230e\', \'multiverseId\': 423183}, \'multiverseid\': 423183}, {\'name\': "Capsule de l\'exécuteur", \'text\': "{1}{B}, {T}, sacrifiez la Capsule de l\'exécuteur : Détruisez la créature non-noire ciblée.", \'type\': \'Artefact\', \'flavor\': "L\'ouverture d\'une capsule est toujours précédée d\'un instant de trépidation, de crainte du jugement qu\'elle pourrait contenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421779&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'301b1049-9b13-4434-9684-2b0f3932b9dc\', \'multiverseId\': 421779}, \'multiverseid\': 421779}, {\'name\': \'Capsula del Carnefice\', \'text\': \'{1}{B}, {T}, Sacrifica la Capsula del Carnefice: Distruggi una creatura non nera bersaglio.\', \'type\': \'Artefatto\', \'flavor\': "C\'è sempre un momento di trepidazione prima di aprire una capsula di messaggi, per timore del giudizio che potrebbe esservi all\'interno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422130&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b79cc6cf-2ac2-4110-8dae-44cd06f57076\', \'multiverseId\': 422130}, \'multiverseid\': 422130}, {\'name\': \'処刑人の薬包\', \'text\': \'{1}{B}, {T}, 処刑人の薬包を生け贄に捧げる：黒でないクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'書簡を開封する前には、いつも恐ろしい瞬間がある。その中にあるかもしれない決定に対する恐怖だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422481&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d9d63db-83b0-46b3-93ed-ad70ece11bb3\', \'multiverseId\': 422481}, \'multiverseid\': 422481}, {\'name\': \'Cápsula do Executor\', \'text\': \'{1}{B}, {T}, Sacrifique Cápsula do Executor: Destrua a criatura alvo que não seja preta.\', \'type\': \'Artefato\', \'flavor\': \'Sempre há um momento de apreensão antes de abrir uma cápsula de mensagem, pelo medo do julgamento que pode estar contido nela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422832&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f162a0f-9dc1-4d05-a52c-0ce9ee7fb0cd\', \'multiverseId\': 422832}, \'multiverseid\': 422832}, {\'name\': \'刽子手坠盒\', \'text\': \'{1}{B}，{T}，牺牲刽子手坠盒：消灭目标非黑色的生物。\', \'type\': \'神器\', \'flavor\': \'打开这坠盒之前总会不自主地颤抖，深怕其中可能承载的裁决。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421077&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e972491a-db68-44df-a5da-52412914e932\', \'multiverseId\': 421077}, \'multiverseid\': 421077}]', '[{\'name\': \'Kapsel des Verbanners\', \'text\': \'{2}{W}, {T}, opfere die Kapsel des Verbanners: Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'„Ich finde ihre Symmetrie angenehm. Sie schafft anstößigen Unrat aus der Welt und beseitigt sich selbst gleich mit." —Dolomarus, Aufsichtführender der Reinen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421383&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3bc8f8eb-c134-4438-af3d-31dba57981fd\', \'multiverseId\': 421383}, \'multiverseid\': 421383}, {\'name\': \'Cápsula del disipador\', \'text\': \'{2}{W}, {T}, sacrificar la Cápsula del disipador: Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'"Su simetría es placentera. Elimina desechos de nuestro mundo al mismo tiempo que se destruye". —Dolomarus, supervisor de los Puros\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423138&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68709d2c-d4db-40bb-8afa-9931fc3c02ba\', \'multiverseId\': 423138}, \'multiverseid\': 423138}, {\'name\': \'Capsule du dissipateur\', \'text\': "{2}{W}, {T}, sacrifiez la Capsule du dissipateur : Détruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Artefact\', \'flavor\': "« Je trouve sa symétrie agréable. Elle élimine les impuretés choquantes de notre monde tout en se débarrassant d\'elle-même. » —Dolomarus, questeur de la Pureté", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421734&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36a3ecd9-b0e6-44da-8159-9a90f7804944\', \'multiverseId\': 421734}, \'multiverseid\': 421734}, {\'name\': \'Capsula del Dissipatore\', \'text\': \'{2}{W}, {T}, Sacrifica la Capsula del Dissipatore: Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Artefatto\', \'flavor\': \'"Trovo che la sua simmetria sia piacevole. Elimina rifiuti ripugnanti dal nostro mondo mentre smaltisce se stesso." —Dolomarus, Censore della Pulizia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422085&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99d8cfc6-bb19-4b36-b428-d296178bae63\', \'multiverseId\': 422085}, \'multiverseid\': 422085}, {\'name\': \'祓い士の薬包\', \'text\': \'{2}{W}, {T}, 祓い士の薬包を生け贄に捧げる：アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'「この調和は好ましいな。自身を失いながら、この世界の有害な廃棄物を消し去るのだから。」 ――清浄の代理人、ドロマールス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'182caa9e-a39b-4f3c-b1a2-9e1702898e3d\', \'multiverseId\': 422436}, \'multiverseid\': 422436}, {\'name\': \'Cápsula do Dispersor\', \'text\': \'{2}{W}, {T}, Sacrifique Cápsula do Dispersor: Destrua o artefato ou encantamento alvo.\', \'type\': \'Artefato\', \'flavor\': \'"Eu acho sua simetria muito agradável. Ela retira do mundo a imundície ofensiva enquanto se dispersa." — Dolomarus, Inspetor da Limpeza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422787&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dcd108a1-c39e-4ddd-883b-84f59e6e2d97\', \'multiverseId\': 422787}, \'multiverseid\': 422787}, {\'name\': \'驱散者坠盒\', \'text\': \'{2}{W}，{T}，牺牲驱散者坠盒：消灭目标神器或结界。\', \'type\': \'神器\', \'flavor\': \'「这对称性相当有趣：它把带有攻击性又不该存于世上的东西与它本身一同处理掉。」 ～理净师多洛马勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b972eaf-f50d-416b-bb19-30478cb03783\', \'multiverseId\': 421032}, \'multiverseid\': 421032}]', "[{'name': 'Karplusanischer Wald', 'text': '{T}: Erhöhe deinen Manavorrat um {C}.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {G}. Der Karplusanische Wald fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421624&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1fd591a4-19a1-469b-b3df-fbe4375baf91', 'multiverseId': 421624}, 'multiverseid': 421624}, {'name': 'Foresta karplusana', 'text': '{T}: Agrega {C} a tu reserva de maná.\\n{T}: Agrega {R} o {G} a tu reserva de maná. La Foresta karplusana te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423379&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1c9fefbd-92de-4c8c-8422-f80fdd9e106a', 'multiverseId': 423379}, 'multiverseid': 423379}, {'name': 'Forêt de Karpluse', 'text': '{T} : Ajoutez {C} à votre réserve.\\n{T} : Ajoutez {R} ou {G} à votre réserve. La Forêt de Karpluse vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421975&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e3cd2389-23de-4b1a-9a63-c3793bc10218', 'multiverseId': 421975}, 'multiverseid': 421975}, {'name': 'Foresta di Karplus', 'text': '{T}: Aggiungi {C} alla tua riserva di mana.\\n{T}: Aggiungi {R} o {G} alla tua riserva di mana. La Foresta di Karplus ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422326&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'febdb306-cc1e-4913-a79e-0b18f816f121', 'multiverseId': 422326}, 'multiverseid': 422326}, {'name': 'カープルーザンの森', 'text': '{T}：あなたのマナ・プールに{C}を加える。\\n{T}：あなたのマナ・プールに{R}か{G}を加える。カープルーザンの森はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422677&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e9edd586-40f2-4e50-9ee8-6d8cdc41de7f', 'multiverseId': 422677}, 'multiverseid': 422677}, {'name': 'Floresta Karplusana', 'text': '{T}: Adicione {C} à sua reserva de mana.\\n{T}: Adicione {R} ou {G} à sua reserva de mana. Floresta Karplusana causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423028&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '01381091-9200-4b9b-b7a8-839b523095b1', 'multiverseId': 423028}, 'multiverseid': 423028}, {'name': '卡普路桑森林', 'text': '{T}：加{C}到你的法术力池中。\\n{T}：加{R}或{G}到你的法术力池中。卡普路桑森林对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421273&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f93d4ea9-2ddb-4917-86ac-af2f28596f46', 'multiverseId': 421273}, 'multiverseid': 421273}]", '[{\'name\': \'Kasteiung\', \'text\': \'Zerstöre eine Kreatur oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Viele jener, die Sorin über den Weg laufen, erleiden das gleiche, so plötzliche wie fatale Einem-Jahrtausende-alten-Vampir-im-Weg-sein-Schicksal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5c640c6e-d809-4a6a-92dc-66ade5af0964\', \'multiverseId\': 421531}, \'multiverseid\': 421531}, {\'name\': \'Mortificar\', \'text\': \'Destruye la criatura o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Muchos de los que se cruzan en el camino de Sorin mueren repentinamente debido a un caso mortal de "intromisión-en-los-asuntos-de-un-vampiro-de-un-milenio-de-edad".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423286&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8b3f40e-fca5-45af-9f3e-07f674df952b\', \'multiverseId\': 423286}, \'multiverseid\': 423286}, {\'name\': \'Mortification\', \'text\': "Détruisez la créature ciblée ou l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': "Beaucoup de ceux qui croisent le chemin de Sorin succombent à un cas soudain de « mieux vaut éviter d\'agacer un vampire millénaire ».", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421882&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b0cc8bb-d156-46b2-8e93-930be4bf1194\', \'multiverseId\': 421882}, \'multiverseid\': 421882}, {\'name\': \'Mortificare\', \'text\': \'Distruggi una creatura o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Molti di coloro che incrociano il cammino di Sorin soffrono di una condizione improvvisa e fatale: quella di trovarsi-tra-i-piedi-di-un-vampiro-millenario.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422233&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73b0659c-ba0b-4f74-bd0e-8910a17996d6\', \'multiverseId\': 422233}, \'multiverseid\': 422233}, {\'name\': \'屈辱\', \'text\': \'クリーチャー１体かエンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'ソリンの邪魔をする者の多くは、「何千年も生きた吸血鬼にとって邪魔」という突発的かつ致命的な症例に見舞われる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422584&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4edf7115-8ea2-4c92-a21a-88142ab0df3f\', \'multiverseId\': 422584}, \'multiverseid\': 422584}, {\'name\': \'Mortificar\', \'text\': \'Destrua a criatura ou o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Muitos dos que cruzam o caminho de Sorin acabam sofrendo de um mal fatal conhecido como "estar no caminho de um vampiro de mil anos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422935&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a0fac62-d6a6-4095-9089-babd2fd6096a\', \'multiverseId\': 422935}, \'multiverseid\': 422935}, {\'name\': \'羞愧\', \'text\': \'消灭目标生物或结界。\', \'type\': \'瞬间\', \'flavor\': \'许多让索霖碍事的人，很快就有了遇上千年吸血鬼注定的结局。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421180&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a9adedc-5fc0-4459-8fcc-abbb30d31c87\', \'multiverseId\': 421180}, \'multiverseid\': 421180}]', '[{\'name\': \'Kazuul, der Tyrann der Klippen\', \'text\': \'Immer wenn eine Kreatur angreift, die ein Gegner kontrolliert, und falls du der verteidigende Spieler bist, erzeuge einen 3/3 roten Oger-Kreaturenspielstein, es sei denn, der Beherrscher der angreifenden Kreatur bezahlt {3}.\', \'type\': \'Legendäre Kreatur — Oger, Krieger\', \'flavor\': \'Eine Warnung an diejenigen, die durch die Klippen klettern wollen, ohne Tribut zu zahlen: Der Weg nach unten ist lang, dauert aber nur kurz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421449&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'372a526f-4cd2-4543-a961-bcb9a78397eb\', \'multiverseId\': 421449}, \'multiverseid\': 421449}, {\'name\': \'Kazuul, tirano de los precipicios\', \'text\': \'Siempre que una criatura que controle un oponente ataque, si eres el jugador defensor, crea una ficha de criatura Ogro roja 3/3 a menos que el controlador de esa criatura pague {3}.\', \'type\': \'Criatura legendaria — Guerrero ogro\', \'flavor\': \'Advertencia a aquellos que escalan los precipicios sin pagar el peaje: es un largo camino hacia abajo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423204&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'debdc789-456c-4c18-b4be-49aa4ec5ef8c\', \'multiverseId\': 423204}, \'multiverseid\': 423204}, {\'name\': \'Kazuul, Tyran des Falaises\', \'text\': "À chaque fois qu\'une créature qu\'un adversaire contrôle attaque, si vous êtes le joueur défenseur, créez un jeton de créature 3/3 rouge Ogre à moins que le contrôleur de cette créature ne paie {3}.", \'type\': \'Créature légendaire : ogre et guerrier\', \'flavor\': \'Un avertissement à quiconque escaladerait les falaises sans payer son dû : la chute est longue.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421800&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a68aea9f-c257-4c36-a4a9-d9efe7e94906\', \'multiverseId\': 421800}, \'multiverseid\': 421800}, {\'name\': \'Kazuul, Tiranno dei Dirupi\', \'text\': \'Ogniqualvolta una creatura controllata da un avversario attacca, se sei il giocatore in difesa, crea una pedina creatura Ogre 3/3 rossa a meno che il controllore di quella creatura non paghi {3}.\', \'type\': \'Creatura Leggendaria — Guerriero Ogre\', \'flavor\': \'State attenti a scalare i dirupi senza pagarne il pedaggio a chi di dovere: la discesa è lunga.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422151&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59823372-d525-4eec-ad65-b111e02fc840\', \'multiverseId\': 422151}, \'multiverseid\': 422151}, {\'name\': \'崖の暴君、カズール\', \'text\': \'対戦相手がコントロールするクリーチャーが１体攻撃するたび、あなたが防御プレイヤーである場合、そのクリーチャーのコントローラーが{3}を支払わないかぎり、赤の３/３のオーガ・クリーチャー・トークンを１体生成する。\', \'type\': \'伝説のクリーチャー — オーガ・戦士\', \'flavor\': \'貢ぎ物を出さずに崖を登る者に警告：長い道のりになるぞ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422502&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'99d5e73d-ae04-4a81-915b-834b9fab6a7b\', \'multiverseId\': 422502}, \'multiverseid\': 422502}, {\'name\': \'Kazuul, Tirano dos Penhascos\', \'text\': \'Toda vez que uma criatura que um oponente controla ataca, se você for o jogador defensor, crie uma ficha de criatura vermelha 3/3 do tipo Ogro, a menos que o controlador daquela criatura pague {3}.\', \'type\': \'Criatura Lendária — Ogro Guerreiro\', \'flavor\': \'Aviso aos que escalam os penhascos sem pagar tributo: é uma longa descida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422853&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5b33121-fcd8-42b9-81fb-f94b7e717dcc\', \'multiverseId\': 422853}, \'multiverseid\': 422853}, {\'name\': \'山崖暴君克卒\', \'text\': \'每当一个由对手操控的生物攻击时，若你是防御牌手，则除非该生物的操控者支付{3}，否则你派出一个3/3红色食人魔衍生生物。\', \'type\': \'传奇生物～食人魔／战士\', \'flavor\': \'警告那些不付过路费就爬上山崖者：往下的路很长。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421098&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03b4536b-95f8-4e8a-ab0b-9cea8364ba5d\', \'multiverseId\': 421098}, \'multiverseid\': 421098}]', '[{\'name\': \'Kessel der Seelen\', \'text\': \'{T}: Bestimme eine beliebige Anzahl an Kreaturen deiner Wahl. Jede dieser Kreaturen erhält Beharrlichkeit bis zum Ende des Zuges. (Wenn sie stirbt und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421565&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de56b527-4832-4fe3-817a-eeb59f8755ac\', \'multiverseId\': 421565}, \'multiverseid\': 421565}, {\'name\': \'Caldero de almas\', \'text\': \'{T}: Elige cualquier cantidad de criaturas objetivo. Cada una de esas criaturas gana la habilidad de persistir hasta el final del turno. (Cuando muera, si no tenía contadores -1/-1 sobre ella, regrésala al campo de batalla bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423320&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e8b7fe3-8263-4464-aa1c-53f833de84d9\', \'multiverseId\': 423320}, \'multiverseid\': 423320}, {\'name\': \'Chaudron des âmes\', \'text\': "{T} : Choisissez n\'importe quel nombre de créatures ciblées. Chacune de ces créatures acquiert la persistance jusqu\'à la fin du tour. (Quand elle meurt, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la sur le champ de bataille sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421916&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'251ef5fb-6496-4824-ae91-47a638ee05f8\', \'multiverseId\': 421916}, \'multiverseid\': 421916}, {\'name\': \'Calderone delle Anime\', \'text\': \'{T}: Scegli un qualsiasi numero di creature bersaglio. Ognuna di quelle creature ha persistere fino alla fine del turno. (Quando questa creatura muore, se non aveva segnalini -1/-1, rimettila sul campo di battaglia sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422267&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56f43ddf-1ae7-439b-8151-a0429dedce9f\', \'multiverseId\': 422267}, \'multiverseid\': 422267}, {\'name\': \'魂の大鍋\', \'text\': \'{T}：望む数のクリーチャーを対象とする。ターン終了時まで、それらの各クリーチャーはそれぞれ頑強を得る。（それが死亡したとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で戦場に戻す。）\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422618&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1fe5a0f-053b-4d5d-bf8d-faf9b1e2dbdc\', \'multiverseId\': 422618}, \'multiverseid\': 422618}, {\'name\': \'Caldeirão de Almas\', \'text\': \'{T}: Escolha qualquer número de criaturas alvo. Cada uma daquelas criaturas ganha persistir até o final do turno. (Quando a criatura morrer, se ela não tiver nenhum marcador -1/-1, devolva-a ao campo de batalha sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422969&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb3d15e1-9aff-4df4-a184-5b1cd298dcc0\', \'multiverseId\': 422969}, \'multiverseid\': 422969}, {\'name\': \'灵魂鼎镬\', \'text\': \'{T}：选择任意数量的目标生物。这些生物均获得留存异能直到回合结束。（当它死去时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回战场，且其上有一个-1/-1指示物。）\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421214&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8ccee1a5-8610-4e3c-9498-9857f98cbad7\', \'multiverseId\': 421214}, \'multiverseid\': 421214}]', "[{'name': 'Kette des Dunstes', 'text': 'Bringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück. Dann kann der Beherrscher jener bleibenden Karte ein Land opfern. Falls er dies tut, kann er diesen Zauberspruch kopieren und kann für die Kopie ein neues Ziel bestimmen.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421403&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3321c2c6-99c5-4bd2-b353-de42342d8d72', 'multiverseId': 421403}, 'multiverseid': 421403}, {'name': 'Cadena de vapor', 'text': 'Regresa el permanente objetivo que no sea tierra a la mano de su propietario. Luego el controlador de ese permanente puede sacrificar una tierra. Si lo hace, ese jugador puede copiar este hechizo y puede elegir un objetivo nuevo para esa copia.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423158&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b2e653a9-35c1-4c01-a0ef-c5ebbebc4a7d', 'multiverseId': 423158}, 'multiverseid': 423158}, {'name': 'Chaîne de vapeur', 'text': 'Renvoyez le permanent non-terrain ciblé dans la main de son propriétaire. Le contrôleur de ce permanent peut ensuite sacrifier un terrain. Si le joueur fait ainsi, il peut copier ce sort et peut choisir une nouvelle cible pour cette copie.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421754&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a8154daf-f3d7-428b-a3a0-60111e0aa0eb', 'multiverseId': 421754}, 'multiverseid': 421754}, {'name': 'Catena di Vapore', 'text': 'Fai tornare un permanente non terra bersaglio in mano al suo proprietario. Poi il controllore di quel permanente può sacrificare una terra. Se il giocatore lo fa, può copiare questa magia e può scegliere un nuovo bersaglio per quella copia.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422105&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5e26a305-6f2e-47af-9a84-bee2365488e0', 'multiverseId': 422105}, 'multiverseid': 422105}, {'name': '蒸気の連鎖', 'text': '土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。その後、そのパーマネントのコントローラーは土地１つを生け贄に捧げてもよい。そうしたなら、そのプレイヤーはこの呪文をコピーしてもよい。そのプレイヤーはそのコピーの新しい対象を選んでもよい。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422456&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3e937598-26ac-4ddb-b0a5-01e969ccb16d', 'multiverseId': 422456}, 'multiverseid': 422456}, {'name': 'Corrente de Vapor', 'text': 'Devolva a permanente alvo que não seja terreno para a mão de seu dono. Em seguida, o controlador daquela permanente pode sacrificar um terreno. Se o jogador fizer isso, poderá copiar esta mágica e poderá escolher um novo alvo para a cópia.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422807&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4b252e4f-ff3a-46b2-ba43-c20e3d18c12f', 'multiverseId': 422807}, 'multiverseid': 422807}, {'name': '连锁蒸发', 'text': '将目标非地永久物移回其拥有者手上。然后该永久物的操控者可以牺牲一个地。如果该牌手如此作，则他可以复制此咒语，且可以为该复制品选择新的目标。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421052&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1a39c03a-3751-4edc-ab6e-f81c0852bb37', 'multiverseId': 421052}, 'multiverseid': 421052}]", '[{\'name\': \'Klagender Stein\', \'text\': \'{5}, {T}: Ein Spieler deiner Wahl legt die obersten X Karten seiner Bibliothek auf seinen Friedhof, wobei X gleich der Anzahl an Karten ist, die sich im Friedhof des Spielers befinden.\', \'type\': \'Artefakt\', \'flavor\': \'Während er sich dreht, kreischen tote Stimmen in einem immer lauter werdenden Missklang und bringen den Kopf zum Platzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421578&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8e7c5cc-af56-4d32-9e13-dd9b1dd8b3f2\', \'multiverseId\': 421578}, \'multiverseid\': 421578}, {\'name\': \'Piedra atormentadora\', \'text\': \'{5}, {T}: El jugador objetivo pone las X primeras cartas de su biblioteca en su cementerio, donde X es la cantidad de cartas en el cementerio de ese jugador.\', \'type\': \'Artefacto\', \'flavor\': \'Mientras gira, voces muertas gritan en una cacofonía creciente, desbaratando la mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423333&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5afcb339-3f13-4eab-91bd-732caa404456\', \'multiverseId\': 423333}, \'multiverseid\': 423333}, {\'name\': \'Pierre psalmodiante\', \'text\': \'{5}, {T} : Le joueur ciblé met les X cartes du dessus de sa bibliothèque dans son cimetière, X étant le nombre de cartes dans le cimetière de ce joueur.\', \'type\': \'Artefact\', \'flavor\': "Quand elle tourne sur elle-même, elle déclenche une cacophonie grandissante de voix mortes, puissante au point de déchirer l\'esprit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421929&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eefcbbea-d28d-4b72-84dd-51715dab10ed\', \'multiverseId\': 421929}, \'multiverseid\': 421929}, {\'name\': \'Pietra del Lamento\', \'text\': \'{5}, {T}: Un giocatore bersaglio mette nel suo cimitero le prime X carte del suo grimorio, dove X è il numero di carte nel cimitero di quel giocatore.\', \'type\': \'Artefatto\', \'flavor\': \'Quando gira, le voci dei morti urlano in una cacofonia crescente, facendo a pezzi la mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422280&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6956254a-928f-465f-a4b9-65397620f378\', \'multiverseId\': 422280}, \'multiverseid\': 422280}, {\'name\': \'号泣の石\', \'text\': \'{5}, {T}：プレイヤー１人を対象とする。そのプレイヤーは自分のライブラリーの一番上からカードをＸ枚自分の墓地に置く。Ｘはそのプレイヤーの墓地にあるカードの枚数に等しい。\', \'type\': \'アーティファクト\', \'flavor\': \'その回転が生み出す死の叫び声は増し続ける不協和音となり、精神をずたずたに粉砕する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422631&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb7903f1-6c91-4377-aac9-fb01f7c4f0ff\', \'multiverseId\': 422631}, \'multiverseid\': 422631}, {\'name\': \'Pedra Lamuriante\', \'text\': \'{5}, {T}: O jogador alvo coloca os X cards do topo do grimório dele no próprio cemitério, sendo X o número de cards no cemitério daquele jogador.\', \'type\': \'Artefato\', \'flavor\': \'Conforme ela gira, as vozes dos mortos gritam numa crescente cacofonia capaz de dilacerar a mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422982&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e685dae7-b25b-4476-8f62-6f833046fb9c\', \'multiverseId\': 422982}, \'multiverseid\': 422982}, {\'name\': \'恸哭石\', \'text\': \'{5}，{T}：目标牌手将其牌库顶的X张牌置入其坟墓场，X为该牌手坟墓场中牌的数量。\', \'type\': \'神器\', \'flavor\': \'它转动的尖削杂音有如不断增强的亡者之声，让心灵为之裂解。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421227&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ad88bda4-0db7-4ccf-b7ae-730ba556cab6\', \'multiverseId\': 421227}, \'multiverseid\': 421227}]', '[{\'name\': \'Knisterndes Verderben\', \'text\': \'Das Knisternde Verderben fügt jedem Gegner 2 Schadenspunkte zu. Jeder Gegner opfert eine Kreatur mit der höchsten Stärke unter den Kreaturen, die er kontrolliert.\', \'type\': \'Spontanzauber\', \'flavor\': \'Fürchte nicht die Blitze. Fürchte, wem sie gehorchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421510&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e6e00fb-e27c-4f39-899e-29ae0c23cc7e\', \'multiverseId\': 421510}, \'multiverseid\': 421510}, {\'name\': \'Fatalidad centelleante\', \'text\': \'La Fatalidad centelleante hace 2 puntos de daño a cada oponente. Cada oponente sacrifica la criatura con la mayor fuerza entre las criaturas que controla.\', \'type\': \'Instantáneo\', \'flavor\': \'No temas al relámpago. Teme a aquel a quien obedece.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'525ceead-eeb8-4f6d-9d31-b0cbc63b3f7d\', \'multiverseId\': 423265}, \'multiverseid\': 423265}, {\'name\': \'Fin crépitante\', \'text\': "La Fin crépitante inflige 2 blessures à chaque adversaire. Chaque adversaire sacrifie une créature avec la force la plus élevée parmi les créatures qu\'il contrôle.", \'type\': \'Éphémère\', \'flavor\': \'Ne crains pas la foudre. Crains celui à qui elle obéit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421861&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'939a0aaa-fb62-4579-adbe-20f4cab05605\', \'multiverseId\': 421861}, \'multiverseid\': 421861}, {\'name\': \'Destino Crepitante\', \'text\': \'Il Destino Crepitante infligge 2 danni a ogni avversario. Ogni avversario sacrifica una creatura con la forza maggiore tra le creature che controlla.\', \'type\': \'Istantaneo\', \'flavor\': \'Non temere il fulmine. Temi chi lo comanda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422212&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'343c833e-7580-4489-97e4-af2fa17986ea\', \'multiverseId\': 422212}, \'multiverseid\': 422212}, {\'name\': \'はじける破滅\', \'text\': \'はじける破滅は各対戦相手にそれぞれ２点のダメージを与える。各対戦相手はそれぞれ、自分がコントロールするクリーチャーの中で最も高いパワーを持つクリーチャー１体を生け贄に捧げる。\', \'type\': \'インスタント\', \'flavor\': \'稲妻を恐れる必要はない。それが従う者を恐れよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422563&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43a902ad-7f27-412f-8797-879b8cd4eeed\', \'multiverseId\': 422563}, \'multiverseid\': 422563}, {\'name\': \'Fim Crepitante\', \'text\': \'Fim Crepitante causa 2 pontos de dano a cada oponente. Cada oponente sacrifica uma criatura com o maior poder dentre as criaturas que ele controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Não temam os raios. Temam a quem eles obedecem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422914&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'782cbf3b-037c-4d99-be9d-689bbba6c72d\', \'multiverseId\': 422914}, \'multiverseid\': 422914}, {\'name\': \'裂响终末\', \'text\': \'裂响终末向每位对手各造成2点伤害。每位对手各牺牲一个生物，且须是由他操控的生物中力量最大者。\', \'type\': \'瞬间\', \'flavor\': \'闪电不可怕。可怕的是驱使闪电的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421159&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e8652d8-d675-4d98-beaf-67f473cc8b90\', \'multiverseId\': 421159}, \'multiverseid\': 421159}]', '[{\'name\': \'Knochenhort\', \'text\': \'Lebende Waffe (Wenn diese Ausrüstung ins Spiel kommt, erzeuge einen 0/0 schwarzen Keim-Kreaturenspielstein und lege sie dann an ihn an.)\\nDie ausgerüstete Kreatur erhält +X/+X, wobei X gleich der Anzahl an Kreaturenkarten in allen Friedhöfen ist.\\nAusrüsten {2}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421564&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95f3cb3c-6d2f-4212-8e74-b0a4b63cc4cb\', \'multiverseId\': 421564}, \'multiverseid\': 421564}, {\'name\': \'Huesotesoro\', \'text\': \'Arma viviente. (Cuando este equipo entre al campo de batalla, crea una ficha de criatura Germen negra 0/0 y luego anéxalo a ella.)\\nLa criatura equipada obtiene +X/+X, donde X es la cantidad de cartas de criatura en todos los cementerios.\\nEquipar {2}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423319&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce38d5db-59a9-4654-98a4-cd5b62a17e2d\', \'multiverseId\': 423319}, \'multiverseid\': 423319}, {\'name\': \'Récoltos\', \'text\': \'Arme vivante (Quand cet équipement arrive sur le champ de bataille, créez un jeton de créature 0/0 noire Germe, puis attachez-lui cet équipement.)\\nLa créature équipée gagne +X/+X, X étant le nombre de cartes de créature dans tous les cimetières.\\nÉquipement {2}\', \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421915&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d7f72f3-41ca-49a6-b5ac-bfe5c504c6f6\', \'multiverseId\': 421915}, \'multiverseid\': 421915}, {\'name\': "Mucchio d\'Ossa", \'text\': \'Arma vivente (Quando questo Equipaggiamento entra nel campo di battaglia, crea una pedina creatura Microbo 0/0 nera, poi assegnalo ad essa.)\\nLa creatura equipaggiata prende +X/+X, dove X è il numero di carte creatura in tutti i cimiteri.\\nEquipaggiare {2}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422266&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'224fec1c-5afc-4e0d-9554-e616e149db8a\', \'multiverseId\': 422266}, \'multiverseid\': 422266}, {\'name\': \'骨溜め\', \'text\': \'生体武器（この装備品が戦場に出たとき、黒の０/０の細菌・クリーチャー・トークンを１体生成し、その後これをそれにつける。）\\n装備しているクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはすべての墓地にあるクリーチャー・カードの総数に等しい。\\n装備{2}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422617&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2655f768-227a-4aac-aa23-21d189675ebc\', \'multiverseId\': 422617}, \'multiverseid\': 422617}, {\'name\': \'Aglomerado de Ossos\', \'text\': \'Arma viva (Quando este Equipamento entrar no campo de batalha, crie uma ficha de criatura preta 0/0 do tipo Germe e anexe-o a ela.)\\nA criatura equipada recebe +X/+X, sendo X o número de cards de criatura em todos os cemitérios.\\nEquipar {2}\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422968&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9fed066-52dc-4e03-97b1-7a827c1c6301\', \'multiverseId\': 422968}, \'multiverseid\': 422968}, {\'name\': \'聚骨装\', \'text\': \'活化武器（当此武具进战场时，派出一个0/0黑色病菌衍生生物，然后将它装备上去。）\\n佩带此武具的生物得+X/+X，X为所有坟墓场中的生物牌数量。\\n佩带{2}\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421213&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5baea5f-1aae-46d4-87d7-e573fdbd949e\', \'multiverseId\': 421213}, \'multiverseid\': 421213}]', '[{\'name\': \'Knöchelkerber\', \'text\': \'Eile\\nImmer wenn der Knöchelkerber angreift, erhalten Kreaturen, die du kontrollierst, Erstschlag und Todesberührung bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin, Berserker\', \'flavor\': \'Wichtiger als die Statur des Kämpfers ist die Tiefe des Schnitts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421497&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65e9f50e-ccfc-4be0-95ac-fa7333bc4812\', \'multiverseId\': 421497}, \'multiverseid\': 421497}, {\'name\': \'Tobillero\', \'text\': \'Prisa.\\nSiempre que el Tobillero ataque, las criaturas que controlas ganan las habilidades de dañar primero y toque mortal hasta el final del turno.\', \'type\': \'Criatura — Berserker trasgo\', \'flavor\': \'La estatura del luchador no es tan importante como la profundidad del corte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423252&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6c25f3f-8dbf-4c27-acde-6805aad65092\', \'multiverseId\': 423252}, \'multiverseid\': 423252}, {\'name\': \'Attrapeur de chevilles\', \'text\': "Célérité\\nÀ chaque fois que l\'Attrapeur de chevilles attaque, les créatures que vous contrôlez acquièrent l\'initiative et le contact mortel jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et berserker\', \'flavor\': \'La taille du combattant importe moins que la profondeur de la blessure.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421848&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5b47274-9290-454b-b2c3-cb346ba81e2c\', \'multiverseId\': 421848}, \'multiverseid\': 421848}, {\'name\': \'Trinciastinchi\', \'text\': \'Rapidità\\nOgniqualvolta il Trinciastinchi attacca, le creature che controlli hanno attacco improvviso e tocco letale fino alla fine del turno.\', \'type\': \'Creatura — Berserker Goblin\', \'flavor\': \'La statura del combattente conta meno della profondità del taglio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422199&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5036a51e-80a9-44db-ae6b-e8666eed1e56\', \'multiverseId\': 422199}, \'multiverseid\': 422199}, {\'name\': \'足首裂き\', \'text\': \'速攻\\n足首裂きが攻撃するたび、ターン終了時まで、あなたがコントロールするクリーチャーは先制攻撃と接死を得る。\', \'type\': \'クリーチャー — ゴブリン・狂戦士\', \'flavor\': \'戦士の体躯の大小は、与える傷の深さに比べればさしたる問題ではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422550&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d5c4511-0e73-4510-a525-46ed5cde64f4\', \'multiverseId\': 422550}, \'multiverseid\': 422550}, {\'name\': \'Cortador de Tornozelos\', \'text\': \'Ímpeto\\nToda vez que Cortador de Tornozelos ataca, as criaturas que você controla ganham iniciativa e toque mortífero até o final do turno.\', \'type\': \'Criatura — Goblin Amoque\', \'flavor\': \'A estatura do guerreiro importa menos do que a profundidade do corte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422901&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6da72488-d6ba-4011-917b-d91f46ec13fd\', \'multiverseId\': 422901}, \'multiverseid\': 422901}, {\'name\': \'断踝鬼怪\', \'text\': \'敏捷\\n每当断踝鬼怪攻击时，由你操控的生物获得先攻与死触异能直到回合结束。\', \'type\': \'生物～鬼怪／狂战士\', \'flavor\': \'相比刀伤的深度，斗士的身材就不那么重要了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421146&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5bd04ea5-2626-4693-bbf5-11a30ffedb9b\', \'multiverseId\': 421146}, \'multiverseid\': 421146}]', '[{\'name\': \'Korozda-Gildenmagier\', \'text\': \'{1}{B}{G}: Eine Kreatur deiner Wahl erhält +1/+1 und Einschüchtern bis zum Ende des Zuges. (Sie kann außer von Artefaktkreaturen und/oder Kreaturen, mit denen sie eine Farbe gemeinsam hat, nicht geblockt werden.)\\n{2}{B}{G}, opfere eine Nichtspielsteinkreatur: Erzeuge X 1/1 grüne Saproling-Kreaturenspielsteine, wobei X die Widerstandskraft der geopferten Kreatur ist.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421527&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'349e059e-6065-4a75-868a-cc39ec0e11af\', \'multiverseId\': 421527}, \'multiverseid\': 421527}, {\'name\': \'Mago del gremio de Korozda\', \'text\': \'{1}{B}{G}: La criatura objetivo obtiene +1/+1 y gana la habilidad de intimidar hasta el final del turno. (No puede ser bloqueada excepto por criaturas artefacto y/o criaturas que compartan un color con ella.)\\n{2}{B}{G}, sacrificar una criatura que no sea ficha: Crea X fichas de criatura Saprolín verdes 1/1, donde X es la resistencia de la criatura sacrificada.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423282&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c1d522d-ba6f-4ed1-b0ae-6db46d708578\', \'multiverseId\': 423282}, \'multiverseid\': 423282}, {\'name\': \'Ghildmage de Korozda\', \'text\': "{1}{B}{G} : La créature ciblée gagne +1/+1 et acquiert l\'intimidation jusqu\'à la fin du tour. (Elle ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures qui partagent une couleur avec elle.)\\n{2}{B}{G}, sacrifiez une créature non-jeton : Créez X jetons de créature 1/1 verte Saprobionte, X étant l\'endurance de la créature sacrifiée.", \'type\': \'Créature : elfe et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421878&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b237c57-05db-49cd-9ac4-ae6b790a3d9c\', \'multiverseId\': 421878}, \'multiverseid\': 421878}, {\'name\': \'Mago della Gilda di Korozda\', \'text\': \'{1}{B}{G}: Una creatura bersaglio prende +1/+1 e ha intimidire fino alla fine del turno. (Non può essere bloccata tranne che da creature artefatto e/o creature che condividono con essa un colore.)\\n{2}{B}{G}, Sacrifica una creatura non pedina: Crea X pedine creatura Saprolingio 1/1 verdi, dove X è la costituzione della creatura sacrificata.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422229&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'844818b6-402e-493c-a86d-641fca292dcc\', \'multiverseId\': 422229}, \'multiverseid\': 422229}, {\'name\': \'コロズダのギルド魔道士\', \'text\': \'{1}{B}{G}：クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受けるとともに威嚇を得る。（それはアーティファクト・クリーチャーかそれと共通の色を持つクリーチャー以外にはブロックされない。）\\n{2}{B}{G}, トークンでないクリーチャー１体を生け贄に捧げる：緑の１/１の苗木・クリーチャー・トークンをＸ体生成する。Ｘはその生け贄に捧げたクリーチャーのタフネスに等しい。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422580&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36bde0b8-3814-4844-be22-06ed3c3a7d02\', \'multiverseId\': 422580}, \'multiverseid\': 422580}, {\'name\': \'Mago de Guilda de Korozda\', \'text\': \'{1}{B}{G}: A criatura alvo recebe +1/+1 e ganha intimidar até o final do turno. (Esta criatura só pode ser bloqueada por criaturas artefato e/ou criaturas que compartilhem uma cor com ela.)\\n{2}{B}{G}, Sacrifique uma criatura que não seja uma ficha: Crie X fichas de criatura verde 1/1 do tipo Saprófita, sendo X a resistência da criatura sacrificada.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422931&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'483d1148-fd00-48aa-bf88-c30e877ec6e5\', \'multiverseId\': 422931}, \'multiverseid\': 422931}, {\'name\': \'柯罗札公会法师\', \'text\': \'{1}{B}{G}：直到回合结束，目标生物得+1/+1且获得威吓异能。（它只能被神器生物和／或与它有共通颜色的生物阻挡。）\\n{2}{B}{G}，牺牲一个非衍生物的生物：派出X个1/1绿色腐生物衍生生物，X为所牺牲之生物的防御力。\', \'type\': \'生物～妖精／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421176&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52e638f7-9aa1-4ce6-a7b2-acb2bc793f17\', \'multiverseId\': 421176}, \'multiverseid\': 421176}]', '[{\'name\': \'Kraum, Ludevics Opus\', \'text\': \'Fliegend, Eile\\nImmer wenn ein Gegner seinen zweiten Zauberspruch innerhalb desselben Zuges wirkt, ziehe eine Karte.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Zombie, Schrecken\', \'flavor\': \'„Es lebt … ES LEBT!" —Ludevic, Nekro-Alchemist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421353&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b06e485e-d8d9-4390-825b-5bc619284cab\', \'multiverseId\': 421353}, \'multiverseid\': 421353}, {\'name\': \'Kraum, obra de Ludevic\', \'text\': \'Vuela, prisa.\\nSiempre que un oponente lance su segundo hechizo cada turno, roba una carta.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Horror zombie\', \'flavor\': \'"Está vivo... ¡VIVO!" —Ludevic, necroalquimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423108&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b8c891bd-9d21-4536-876b-1dbec3ba1c08\', \'multiverseId\': 423108}, \'multiverseid\': 423108}, {\'name\': \'Kraum, opus de Ludevic\', \'text\': "Vol, célérité\\nÀ chaque fois qu\'un adversaire lance son deuxième sort à chaque tour, piochez une carte.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature légendaire : zombie et horreur\', \'flavor\': \'« Il est vivant... VIVANT ! » —Ludevic, nécro-alchimiste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421704&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0efa0b4-83fb-4577-a6d7-ecbc8375d7e0\', \'multiverseId\': 421704}, \'multiverseid\': 421704}, {\'name\': "Kraum, Opera d\'Arte di Ludevic", \'text\': \'Volare, rapidità\\nOgniqualvolta un avversario lancia la sua seconda magia in ogni turno, pesca una carta.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)\', \'type\': \'Creatura Leggendaria — Orrore Zombie\', \'flavor\': \'"È vivo... È VIVO!" —Ludevic, necro-alchimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422055&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a028881-b9ba-46a9-8a31-691cc6e309f4\', \'multiverseId\': 422055}, \'multiverseid\': 422055}, {\'name\': \'ルーデヴィックの名作、クラム\', \'text\': \'飛行、速攻\\n対戦相手１人が各ターンの自分の２つ目の呪文を唱えるたび、カードを１枚引く。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — ゾンビ・ホラー\', \'flavor\': \'「生きてる……こいつ生きてるぞ！」 ――屍錬金術師、ルーデヴィック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422406&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'209ad3ca-7d53-4b3e-8269-6cac54fbbc85\', \'multiverseId\': 422406}, \'multiverseid\': 422406}, {\'name\': \'Kraum, Opus de Ludevic\', \'text\': \'Voar, ímpeto\\nToda vez que um oponente conjurar sua segunda mágica em cada turno, compre um card.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Zumbi Horror\', \'flavor\': \'"Está vivo... ESTÁ VIVO!" — Ludevic, necroalquimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9bd92c9f-8ce1-4e4a-8409-28d131c74950\', \'multiverseId\': 422757}, \'multiverseid\': 422757}, {\'name\': \'卢德维佳作寇姆\', \'text\': \'飞行，敏捷\\n每当任一对手施放每回合中他的第二个咒语时，抓一张牌。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～灵俑／惊惧兽\', \'flavor\': \'「它动了. . . 它动了！」 ～死灵炼金术士卢德维\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421002&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ddd586a2-3560-494b-a3bc-e9eb33f8421c\', \'multiverseId\': 421002}, \'multiverseid\': 421002}]', '[{\'name\': \'Kreuzzug der Katharer\', \'text\': \'Immer wenn eine Kreatur unter deiner Kontrolle ins Spiel kommt, lege eine +1/+1-Marke auf jede Kreatur, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': \'Avacyns heilige Krieger gaben auch in den dunkelsten Stunden die Hoffnung nicht auf. Nun tragen sie diese Hoffnung durch Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421380&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eea512e0-6e5b-4bd6-80b6-998ce68c347a\', \'multiverseId\': 421380}, \'multiverseid\': 421380}, {\'name\': \'Cruzada de los cátaros\', \'text\': \'Siempre que una criatura entre al campo de batalla bajo tu control, pon un contador +1/+1 sobre cada criatura que controlas.\', \'type\': \'Encantamiento\', \'flavor\': \'Los guerreros sagrados de Avacyn mantuvieron viva la esperanza en los momentos más aciagos. Ahora, llevarán esa esperanza por todo Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423135&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da52a4d6-b1b1-4dd6-bb29-2795efe8c845\', \'multiverseId\': 423135}, \'multiverseid\': 423135}, {\'name\': \'Croisade cathare\', \'text\': "À chaque fois qu\'une créature arrive sur le champ de bataille sous votre contrôle, mettez un marqueur +1/+1 sur chaque créature que vous contrôlez.", \'type\': \'Enchantement\', \'flavor\': "L\'espoir entretenu par les guerriers saints d\'Avacyn aux heures les plus sombres sera désormais porté à travers Innistrad.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421731&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'026f8571-5455-4178-9a92-659f32617742\', \'multiverseId\': 421731}, \'multiverseid\': 421731}, {\'name\': \'Crociata dei Catari\', \'text\': \'Ogniqualvolta una creatura entra nel campo di battaglia sotto il tuo controllo, metti un segnalino +1/+1 su ogni creatura che controlli.\', \'type\': \'Incantesimo\', \'flavor\': \'I guerrieri sacri di Avacyn alimentarono la speranza nei suoi momenti più bui. Ora diffonderanno quella speranza in Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422082&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce3e42df-9b8d-4967-9ab9-20df9c548033\', \'multiverseId\': 422082}, \'multiverseid\': 422082}, {\'name\': \'聖戦士の進軍\', \'text\': \'クリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたがコントロールする各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。\', \'type\': \'エンチャント\', \'flavor\': \'アヴァシンの聖なる戦士達は、彼女の最も困難な時期にも希望を絶やさなかった。彼らは今、その希望をイニストラード全土にもたらすのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422433&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e3c7090-2b99-4b2a-8077-fdd4dbcf3b2d\', \'multiverseId\': 422433}, \'multiverseid\': 422433}, {\'name\': \'Cruzada dos Cátaros\', \'text\': \'Toda vez que uma criatura entrar no campo de batalha sob seu controle, coloque um marcador +1/+1 em cada criatura que você controla.\', \'type\': \'Encantamento\', \'flavor\': \'Os guerreiros sagrados de Avacyn mantiveram a esperança viva em seus momentos mais difíceis. Agora, eles levarão essa mesma esperança a toda Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c9225eac-38c3-4de2-a2ec-09aac5a873c5\', \'multiverseId\': 422784}, \'multiverseid\': 422784}, {\'name\': \'护教军圣战\', \'text\': \'每当一个生物在你的操控下进战场时，在每个由你操控的生物上各放置一个+1/+1指示物。\', \'type\': \'结界\', \'flavor\': \'艾维欣的圣战士在她最艰困的时刻依旧维系着希望。现在他们将把这份希望传遍依尼翠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421029&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'30cbad18-611b-4a02-8546-976cd6b5424d\', \'multiverseId\': 421029}, \'multiverseid\': 421029}]', "[{'name': 'Kristalliner Krabbler', 'text': 'Konvergenz — Der Kristalline Krabbler kommt mit einer +1/+1-Marke ins Spiel für jede unterschiedliche Farbe von Mana, das ausgegeben wurde, um ihn zu wirken.\\nEntferne eine +1/+1-Marke vom Kristallinen Krabbler: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\\n{T}: Lege eine +1/+1-Marke auf den Kristallinen Krabbler.', 'type': 'Artefaktkreatur — Konstrukt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421373&type=card', 'language': 'German', 'identifiers': {'scryfallId': '378e0fa2-68ad-44b3-b8d2-2530c136545d', 'multiverseId': 421373}, 'multiverseid': 421373}, {'name': 'Rondador cristalino', 'text': 'Converger — El Rondador cristalino entra al campo de batalla con un contador +1/+1 sobre él por cada color de maná usado para lanzarlo.\\nRemover un contador +1/+1 del Rondador cristalino: Agrega un maná de cualquier color a tu reserva de maná.\\n{T}: Pon un contador +1/+1 sobre el Rondador cristalino.', 'type': 'Criatura artefacto — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423128&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '648ee055-8425-49f1-83e3-12a1a06ad6be', 'multiverseId': 423128}, 'multiverseid': 423128}, {'name': 'Rampeur cristallin', 'text': 'Convergence — Le Rampeur cristallin arrive sur le champ de bataille avec, sur lui, un marqueur +1/+1 pour chaque couleur de mana dépensée pour le lancer.\\nRetirez un marqueur +1/+1 du Rampeur cristallin : Ajoutez un mana de la couleur de votre choix à votre réserve.\\n{T} : Mettez un marqueur +1/+1 sur le Rampeur cristallin.', 'type': 'Créature-artefact : construction', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421724&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e847e117-e673-4408-8c13-b06c8abfacf0', 'multiverseId': 421724}, 'multiverseid': 421724}, {'name': 'Camminatore Cristallino', 'text': 'Convergenza — Il Camminatore Cristallino entra nel campo di battaglia con un segnalino +1/+1 per ogni colore di mana speso per lanciarlo.\\nRimuovi un segnalino +1/+1 dal Camminatore Cristallino: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.\\n{T}: Metti un segnalino +1/+1 sul Camminatore Cristallino.', 'type': 'Creatura Artefatto — Costrutto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422075&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4425a8f6-a609-44a5-b89d-2b6484815410', 'multiverseId': 422075}, 'multiverseid': 422075}, {'name': '水晶の這行器', 'text': '収斂 ― 水晶の這行器は、これを唱えるために支払われたマナの色１色につき＋１/＋１カウンターが１個置かれた状態で戦場に出る。\\n水晶の這行器の上から＋１/＋１カウンターを１個取り除く：あなたのマナ・プールに好きな色１色のマナ１点を加える。\\n{T}：水晶の這行器の上に＋１/＋１カウンターを１個置く。', 'type': 'アーティファクト・クリーチャー — 構築物', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422426&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0df1ff8f-b8e1-4b7e-9818-93491056c864', 'multiverseId': 422426}, 'multiverseid': 422426}, {'name': 'Rastejador Cristalino', 'text': 'Convergir — Rastejador Cristalino entra no campo de batalha com um marcador +1/+1 para cada cor de mana gasta para conjurá-lo.\\nRemova um marcador +1/+1 de Rastejador Cristalino: Adicione um mana de qualquer cor à sua reserva de mana.\\n{T}: Coloque um marcador +1/+1 em Rastejador Cristalino.', 'type': 'Criatura Artefato — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422777&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '08dbc5aa-8420-4df8-819d-691abcd4e810', 'multiverseId': 422777}, 'multiverseid': 422777}, {'name': '晶澈匍体', 'text': '聚辉～晶澈匍体进战场时上面有数个+1/+1指示物，其数量为施放它时用来支付费用的法术力颜色数量。\\n从晶澈匍体上移去一个+1/+1指示物：加一点任意颜色的法术力到你的法术力池中。\\n{T}：在晶澈匍体上放置一个+1/+1指示物。', 'type': '神器生物～组构体', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421022&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e83a88ed-217f-4796-b9c9-a689ea86c0ca', 'multiverseId': 421022}, 'multiverseid': 421022}]", '[{\'name\': \'Krosas Waldrand\', \'text\': \'Krosas Waldrand kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {C}.\\n{2}, {T}, opfere Krosas Waldrand: Durchsuche deine Bibliothek nach einer Wald-Karte und einer Ebene-Karte und bringe beide getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421625&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6fc7271a-4cc1-4572-98ce-8cb7e54014e0\', \'multiverseId\': 421625}, \'multiverseid\': 421625}, {\'name\': \'Borde de Krosa\', \'text\': \'El Borde de Krosa entra al campo de batalla girado.\\n{T}: Agrega {C} a tu reserva de maná.\\n{2}, {T}, sacrificar el Borde de Krosa: Busca en tu biblioteca una carta de bosque y una carta de llanura y ponlas en el campo de batalla giradas. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423380&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9d683141-2256-42e6-bc9a-060cc97b0608\', \'multiverseId\': 423380}, \'multiverseid\': 423380}, {\'name\': \'Orée de la Krosia\', \'text\': "L\'Orée de la Krosia arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {C} à votre réserve.\\n{2}, {T}, sacrifiez l\'Orée de la Krosia : Cherchez dans votre bibliothèque une carte de forêt de base et une carte de plaine de base et mettez-les sur le champ de bataille engagées. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421976&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0c97fa5-8de3-4004-962f-20bd375ee023\', \'multiverseId\': 421976}, \'multiverseid\': 421976}, {\'name\': \'Confine di Krosa\', \'text\': \'Il Confine di Krosa entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {C} alla tua riserva di mana.\\n{2}, {T}, Sacrifica il Confine di Krosa: Passa in rassegna il tuo grimorio per una carta Foresta e una carta Pianura e mettile sul campo di battaglia TAPpate. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422327&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2b4183a-f183-43ed-a087-ad3e42ba988b\', \'multiverseId\': 422327}, \'multiverseid\': 422327}, {\'name\': \'クローサの境界\', \'text\': \'クローサの境界はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{C}を加える。\\n{2}, {T}, クローサの境界を生け贄に捧げる：あなたのライブラリーから森・カード１枚と平地・カード１枚を探し、それらをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422678&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c805f0c-3b25-40fb-8815-b2d5ab1fdc4f\', \'multiverseId\': 422678}, \'multiverseid\': 422678}, {\'name\': \'Orla Krosana\', \'text\': \'Orla Krosana entra no campo de batalha virada.\\n{T}: Adicione {C} à sua reserva de mana.\\n{2}, {T}, Sacrifique Orla Krosana: Procure um card de Floresta e um de Planície em seu grimório e coloque-os no campo de batalha virados. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423029&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25b91fec-d97b-4064-b8b3-f23c961078ae\', \'multiverseId\': 423029}, \'multiverseid\': 423029}, {\'name\': \'克洛萨边陲\', \'text\': \'克洛萨边陲须横置进战场。\\n{T}：加{C}到你的法术力池中。\\n{2}，{T}，牺牲克洛萨边陲：从你的牌库中搜寻一张树林牌和一张平原牌，并将它们横置放进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421274&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5f3f228-cf7a-4a09-b4fa-9af8fc1837f2\', \'multiverseId\': 421274}, \'multiverseid\': 421274}]', '[{\'name\': \'Kultivieren\', \'text\': \'Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, zeige sie offen vor, bringe eine davon getappt ins Spiel und nimm die andere auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Alle Samen haben eine Verbindung zueinander, die durch die Unendlichkeit hindurch reicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421465&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7af7ca81-5e47-461a-889b-3d72dba3a884\', \'multiverseId\': 421465}, \'multiverseid\': 421465}, {\'name\': \'Cultivar\', \'text\': \'Busca en tu biblioteca hasta dos cartas de tierra básica, muéstralas, pon una de ellas en el campo de batalla girada y la otra en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Todas las semillas comparten un lazo, llamándose entre ellas a través del infinito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423220&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e35ff35-8f52-483a-a1b6-25df448105c8\', \'multiverseId\': 423220}, \'multiverseid\': 423220}, {\'name\': \'Culture\', \'text\': "Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base, révélez ces cartes et mettez-en une sur le champ de bataille engagée, et l\'autre dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "Toutes les graines partagent un lien les reliant à travers l\'infini.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421816&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3efbb49b-8eb8-4653-90c1-4c953024b1ea\', \'multiverseId\': 421816}, \'multiverseid\': 421816}, {\'name\': \'Coltivare\', \'text\': "Passa in rassegna il tuo grimorio per trovare fino a due carte terra base, rivelale, mettine una sul campo di battaglia TAPpata e aggiungi l\'altra alla tua mano. Poi rimescola il tuo grimorio.", \'type\': \'Stregoneria\', \'flavor\': "Tutti i semi condividono un legame comune, chiamandosi l\'un l\'altro nello spazio infinito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422167&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9b54297-7de9-4626-a480-1509fc9e31c5\', \'multiverseId\': 422167}, \'multiverseid\': 422167}, {\'name\': \'耕作\', \'text\': \'あなたのライブラリーから基本土地・カード最大２枚を探し、それらのカードを公開し、１枚をタップ状態で戦場に出し、もう１枚をあなたの手札に加える。その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'全ての種には繋がりがあり、互いを無限の彼方から呼び合う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422518&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c644bf6b-d15b-4fe9-81ed-9afd9e2fff7a\', \'multiverseId\': 422518}, \'multiverseid\': 422518}, {\'name\': \'Cultivar\', \'text\': \'Procure até dois cards de terreno básico em seu grimório, revele-os e coloque um deles no campo de batalha virado e o outro na sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Todas as sementes possuem um elo em comum que as une através da eternidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4da2cf4-6cc6-4f7d-8537-bc0c103da6d5\', \'multiverseId\': 422869}, \'multiverseid\': 422869}, {\'name\': \'栽培\', \'text\': \'从你的牌库中搜寻至多两张基本地牌，展示这些牌，将一张横置放进战场，另一张则置于你手上。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'所有种子都互相连结成一体，永远地彼此呼唤着。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421114&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a82bcc0-a951-461a-93cb-f7305c215b5f\', \'multiverseId\': 421114}, \'multiverseid\': 421114}]', "[{'name': 'Kydele, Auserwählte des Kruphix', 'text': '{T}: Erhöhe deinen Manavorrat für jede Karte, die du in diesem Zug gezogen hast, um {C}.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)', 'type': 'Legendäre Kreatur — Mensch, Zauberer', 'flavor': 'Ihr wurde die größte Last aufgebürdet: die Last des Wissens.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421354&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e65003e5-ec61-4295-94ef-4e119d60680a', 'multiverseId': 421354}, 'multiverseid': 421354}, {'name': 'Kydele, elegida de Krufix', 'text': '{T}: Agrega {C} a tu reserva de maná por cada carta que robaste este turno.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)', 'type': 'Criatura legendaria — Hechicero humano', 'flavor': 'Ella soporta la mayor de las cargas: el conocimiento.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423109&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e7ea2852-8192-4816-9d3e-e8e410ae43c2', 'multiverseId': 423109}, 'multiverseid': 423109}, {'name': 'Kydele, élue de Kruphix', 'text': '{T} : Ajoutez {C} à votre réserve pour chaque carte que vous avez piochée ce tour-ci.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)', 'type': 'Créature légendaire : humain et sorcier', 'flavor': 'Elle porte le plus lourd de tous les fardeaux : celui de la connaissance.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421705&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd0def3e4-6f18-4d34-80f8-3dfcb85f304d', 'multiverseId': 421705}, 'multiverseid': 421705}, {'name': 'Kydele, Prescelta di Krufix', 'text': '{T}: Aggiungi {C} alla tua riserva di mana per ogni carta che hai pescato in questo turno.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)', 'type': 'Creatura Leggendaria — Mago Umano', 'flavor': 'Porta il fardello più gravoso di tutti: la conoscenza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422056&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c4858d64-723b-4828-92f3-bad8ac4f9ccf', 'multiverseId': 422056}, 'multiverseid': 422056}, {'name': 'クルフィックスに選ばれし者、キデール', 'text': '{T}：このターンにあなたが引いていたカード１枚につき、あなたのマナ・プールに{C}を加える。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）', 'type': '伝説のクリーチャー — 人間・ウィザード', 'flavor': '彼女は最も大きな重荷を負っている。知ることの重荷を……。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422407&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5b305acc-b809-48ed-a213-2b28a96189fe', 'multiverseId': 422407}, 'multiverseid': 422407}, {'name': 'Quidele, Escolhida de Crufix', 'text': '{T}: Adicione {C} a sua reserva de mana para cada card que você comprou neste turno.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)', 'type': 'Criatura Lendária — Humano Mago', 'flavor': 'Ela carrega o maior de todos os fardos: o de saber.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422758&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a318234c-2579-4029-890d-5a578413f413', 'multiverseId': 422758}, 'multiverseid': 422758}, {'name': '克罗芬斯眷宠库黛勒', 'text': '{T}：加若干{C}到你的法术力池中，其数量等同于你本回合已抓的牌数量。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）', 'type': '传奇生物～人类／法术师', 'flavor': '她背负着最沉重的负担：知晓之累。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421003&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2c88398f-a043-43de-ad10-1239c4f1ce7f', 'multiverseId': 421003}, 'multiverseid': 421003}]", '[{\'name\': \'Kynaios und Tiro von Meletis\', \'text\': \'Ziehe zu Beginn deines Endsegments eine Karte. Jeder Spieler kann eine Länderkarte aus seiner Hand ins Spiel bringen. Dann zieht jeder Gegner, der das nicht getan hat, eine Karte.\', \'type\': \'Legendäre Kreatur — Mensch, Soldat\', \'flavor\': \'„Schau, wofür wir gekämpft haben. Schau, was wir zusammen aufgebaut haben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421355&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f7d7372-f4c1-4ff8-ac96-113919db75e4\', \'multiverseId\': 421355}, \'multiverseid\': 421355}, {\'name\': \'Kynaios y Tiro de Meletis\', \'text\': \'Al comienzo de tu paso final, roba una carta. Cada jugador puede poner una carta de tierra de su mano en el campo de batalla, luego cada oponente que no lo hizo roba una carta.\', \'type\': \'Criatura legendaria — Soldado humano\', \'flavor\': \'"Observa por lo que luchamos. Contempla lo que construimos juntos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423110&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9d4bf38e-5c78-4ac3-b9c8-b6f8fbd22a17\', \'multiverseId\': 423110}, \'multiverseid\': 423110}, {\'name\': \'Kynaios et Tiro de Mélétis\', \'text\': "Au début de votre étape de fin, piochez une carte. Chaque joueur peut mettre sur le champ de bataille une carte de terrain de sa main, puis chaque adversaire qui n\'a pas fait ainsi pioche une carte.", \'type\': \'Créature légendaire : humain et soldat\', \'flavor\': \'« Regarde ce pour quoi nous nous sommes battus. Regarde ce que nous avons bâti ensemble. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421706&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd9acc15-9db5-42ee-bdf6-ede1956270af\', \'multiverseId\': 421706}, \'multiverseid\': 421706}, {\'name\': \'Kynaios e Tirone di Meletis\', \'text\': "All\'inizio della tua sottofase finale, pesca una carta. Ogni giocatore può mettere sul campo di battaglia una carta terra dalla propria mano, poi ogni avversario che non l\'ha fatto pesca una carta.", \'type\': \'Creatura Leggendaria — Soldato Umano\', \'flavor\': \'"Per questo abbiamo combattuto. Questo è ciò che abbiamo costruito insieme."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422057&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfc32d61-c50d-44fe-aaa8-5f7e5cff6137\', \'multiverseId\': 422057}, \'multiverseid\': 422057}, {\'name\': \'メレティスのキナイオスとティロ\', \'text\': \'あなたの終了ステップの開始時に、カードを１枚引く。各プレイヤーはそれぞれ、自分の手札から土地・カード１枚を戦場に出してもよい。その後、そうしなかった各対戦相手はカードを１枚引く。\', \'type\': \'伝説のクリーチャー — 人間・兵士\', \'flavor\': \'「戦いの大義を見てみろ。これを二人で築いたのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422408&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a191f330-cd0d-4510-a156-6e0dc9fa8483\', \'multiverseId\': 422408}, \'multiverseid\': 422408}, {\'name\': \'Quinaios e Tiro de Meletis\', \'text\': \'No início de sua etapa final, compre um card. Cada jogador pode colocar um card de terreno da própria mão no campo de batalha. Em seguida, cada oponente que não o fez compra um card.\', \'type\': \'Criatura Lendária — Humano Soldado\', \'flavor\': \'"Veja pelo que lutamos. Veja o que construímos juntos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422759&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7856ee77-2e54-4a5b-a5dd-8bc086912292\', \'multiverseId\': 422759}, \'multiverseid\': 422759}, {\'name\': \'迈勒提斯的库瑙斯与提罗\', \'text\': \'在你的结束步骤开始时，抓一张牌。每位牌手各可以将一张地牌从其手上放进战场，然后每位未如此作的对手各抓一张牌。\', \'type\': \'传奇生物～人类／士兵\', \'flavor\': \'「看看我们为之奋斗的一切。看看我们携手建造的一切。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421004&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a4df0941-1a46-4b4d-a38b-48c3679e3e77\', \'multiverseId\': 421004}, \'multiverseid\': 421004}]', '[{\'name\': \'Küstenbresche\', \'text\': \'Unverzagt (Dieser Zauberspruch kostet beim Wirken für jeden Gegner {1} weniger.)\\nBringe alle bleibenden Karten, die keine Länder sind, auf die Hand ihrer Besitzer zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Die See füllte die Netze der Dörfler bis zu jenem Tage, an dem sie selbst ihr Netz auswarf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421325&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb04d64b-95c6-433d-858a-65376c2a4ee5\', \'multiverseId\': 421325}, \'multiverseid\': 421325}, {\'name\': \'Irrupción costera\', \'text\': \'Audacia. (Cuesta {1} menos lanzar este hechizo por cada oponente.)\\nRegresa todos los permanentes que no sean tierra a las manos de sus propietarios.\', \'type\': \'Conjuro\', \'flavor\': \'El mar llenó las redes de los aldeanos hasta que él lanzó la suya.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423080&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5ce043bd-3d60-4bc7-812d-a41be343438c\', \'multiverseId\': 423080}, \'multiverseid\': 423080}, {\'name\': \'Brèche côtière\', \'text\': \'Témérité (Ce sort coûte {1} de moins à lancer pour chaque adversaire.)\\nRenvoyez tous les permanents non-terrain dans les mains de leurs propriétaires.\', \'type\': \'Rituel\', \'flavor\': "La mer remplit les filets des villageois jusqu\'au jour où elle lança le sien.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421676&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d68d95fe-41f8-4559-a2ba-a2fe3b874110\', \'multiverseId\': 421676}, \'multiverseid\': 421676}, {\'name\': \'Cataclisma Costiero\', \'text\': \'Impavido (Questa magia costa {1} in meno per essere lanciata per ogni avversario.)\\nFai tornare tutti i permanenti non terra in mano ai rispettivi proprietari.\', \'type\': \'Stregoneria\', \'flavor\': \'Il mare riempiva le reti degli abitanti del villaggio, fino al giorno in cui si decise a lanciare la propria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422027&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'abb2c5cf-ae89-4f3f-8c31-4d8d20738060\', \'multiverseId\': 422027}, \'multiverseid\': 422027}, {\'name\': \'沿岸崩壊\', \'text\': \'不抜（この呪文を唱えるためのコストは対戦相手１人につき{1}少なくなる。）\\nすべての土地でないパーマネントをオーナーの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'その村は海から豊富な漁獲を得ていた。その日、海が村を得るまでは。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'33061867-1b6a-4e00-92fa-67e7f14a3b52\', \'multiverseId\': 422378}, \'multiverseid\': 422378}, {\'name\': \'Cataclismo Costeiro\', \'text\': \'Inabalável (Esta mágica custa {1} a menos por cada oponente para ser conjurada.)\\nDevolva todas as permanentes que não sejam terrenos para as mãos de seus donos.\', \'type\': \'Feitiço\', \'flavor\': \'O mar encheu as redes dos aldeões até o dia em que jogou sua própria rede.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422729&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'226f6a0d-a58b-440f-b3df-cdb5f0a7a837\', \'multiverseId\': 422729}, \'multiverseid\': 422729}, {\'name\': \'裂岸怒涛\', \'text\': \'不屈（每有一位对手，此咒语便减少{1}来施放。）\\n将所有非地永久物移回其拥有者手上。\', \'type\': \'法术\', \'flavor\': \'村民渔网遍布海疆，怎想终有大海撒网的一天。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420974&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'abe18f39-4044-4420-92aa-2c94a8f66d88\', \'multiverseId\': 420974}, \'multiverseid\': 420974}]', '[{\'name\': \'Lauernde Raubtiere\', \'text\': \'Immer wenn ein Gegner einen Zauberspruch wirkt, decke die oberste Karte deiner Bibliothek auf. Falls es eine Kreaturenkarte ist, bringe sie ins Spiel. Anderenfalls kannst du sie unter deine Bibliothek legen.\', \'type\': \'Verzauberung\', \'flavor\': \'In den Augen der wilden Tiere ist alles Beute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421475&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1f052c4-e993-4d6b-87f2-2909f18aa291\', \'multiverseId\': 421475}, \'multiverseid\': 421475}, {\'name\': \'Depredadores furtivos\', \'text\': \'Siempre que un oponente lance un hechizo, muestra la primera carta de tu biblioteca. Si es una carta de criatura, ponla en el campo de batalla. Si no, puedes poner esa carta en el fondo de tu biblioteca.\', \'type\': \'Encantamiento\', \'flavor\': \'Todas son presas a los ojos de lo salvaje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3cf72895-7573-4a9e-95bd-dbbce7b69905\', \'multiverseId\': 423230}, \'multiverseid\': 423230}, {\'name\': \'Prédateurs en maraude\', \'text\': "À chaque fois qu\'un adversaire lance un sort, révélez la carte du dessus de votre bibliothèque. Si c\'est une carte de créature, mettez-la sur le champ de bataille. Sinon, vous pouvez mettre cette carte au-dessous de votre bibliothèque.", \'type\': \'Enchantement\', \'flavor\': \'Aux yeux de la nature, nous sommes tous des proies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421826&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b8a3ac4-6030-4a9e-a748-6fabd2ae5cd6\', \'multiverseId\': 421826}, \'multiverseid\': 421826}, {\'name\': \'Predatori in Agguato\', \'text\': \'Ogniqualvolta un avversario lancia una magia, rivela la prima carta del tuo grimorio. Se è una carta creatura, mettila sul campo di battaglia. Altrimenti, puoi metterla in fondo al tuo grimorio.\', \'type\': \'Incantesimo\', \'flavor\': \'Sono tutte prede agli occhi del selvaggio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422177&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3c58977-bc78-435e-9053-15edba760b79\', \'multiverseId\': 422177}, \'multiverseid\': 422177}, {\'name\': \'隠れ潜む捕食者\', \'text\': \'対戦相手が呪文を１つ唱えるたび、あなたは自分のライブラリーの一番上のカードを公開する。それがクリーチャー・カードであるなら、それを戦場に出す。そうでないなら、あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。\', \'type\': \'エンチャント\', \'flavor\': \'野性の目にとっては、全てが餌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422528&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16ca7f63-8b66-4be8-badb-c7a003bda054\', \'multiverseId\': 422528}, \'multiverseid\': 422528}, {\'name\': \'Predadores à Espreita\', \'text\': \'Toda vez que um oponente conjurar uma mágica, revele o card do topo de seu grimório. Se for um card de criatura, coloque-o no campo de batalha. Do contrário, você pode colocar aquele card no fundo de seu grimório.\', \'type\': \'Encantamento\', \'flavor\': \'Aos olhos da selva, tudo é caça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422879&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9a59f43-17ea-467b-a43a-39395cc3c5f0\', \'multiverseId\': 422879}, \'multiverseid\': 422879}, {\'name\': \'潜伏掠食者\', \'text\': \'每当任一对手施放咒语时，展示你的牌库顶牌。若该牌是生物牌，则将之放进战场。若否，则你可以将该牌置于你牌库底。\', \'type\': \'结界\', \'flavor\': \'在荒野之眼看来，一切都是猎物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421124&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e7dbbc58-5b26-4fbe-91ba-0cdafbd53582\', \'multiverseId\': 421124}, \'multiverseid\': 421124}]', '[{\'name\': \'Launen des Schicksals\', \'text\': \'Beginnend mit dir teilt jeder Spieler alle bleibenden Karten, die er kontrolliert, auf drei Haufen auf. Dann bestimmt jeder Spieler zufällig einen seiner Haufen und opfert die darin enthaltenen bleibenden Karten. (Haufen können auch leer sein.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421458&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9594ea4b-167f-447d-a14e-7b2fb1901053\', \'multiverseId\': 421458}, \'multiverseid\': 421458}, {\'name\': \'Caprichos de las Moiras\', \'text\': \'Comenzando contigo, cada jugador separa todos los permanentes que controla en tres montones. Luego cada jugador elige uno de sus montones al azar y sacrifica esos permanentes. (Los montones pueden estar vacíos.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423213&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ddc4fac-eaf1-45ff-9305-b21fa16b2e81\', \'multiverseId\': 423213}, \'multiverseid\': 423213}, {\'name\': \'Caprices des Moires\', \'text\': "En commençant par vous, chaque joueur sépare tous les permanents qu\'il contrôle en trois tas. Ensuite, chaque joueur choisit l\'un de ses tas au hasard et sacrifie ces permanents. (Les tas peuvent être vides.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421809&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c291f789-475e-4bd4-ac07-e69a37fbc92c\', \'multiverseId\': 421809}, \'multiverseid\': 421809}, {\'name\': \'Capricci delle Moire\', \'text\': \'A partire da te, ogni giocatore separa tutti i permanenti che controlla in tre pile. Poi ogni giocatore sceglie una delle proprie pile a caso e sacrifica quei permanenti. (Le pile possono essere vuote.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422160&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0dbb889-5f79-46d7-afd9-e186c21277fa\', \'multiverseId\': 422160}, \'multiverseid\': 422160}, {\'name\': \'運命の気まぐれ\', \'text\': \'あなたから始めて、各プレイヤーはそれぞれ、自分がコントロールするすべてのパーマネントを３つの束に分ける。その後各プレイヤーはそれぞれ、自分の束１つを無作為に選び、その束にあるすべてのパーマネントを生け贄に捧げる。（束の枚数は０でも構わない。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422511&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2158316b-3b33-4a5f-9744-7423695aeabf\', \'multiverseId\': 422511}, \'multiverseid\': 422511}, {\'name\': \'Caprichos dos Destinos\', \'text\': \'Começando com você, cada jogador separa todas as permanentes que controla em três montes. Depois, cada jogador escolhe um de seus montes aleatoriamente e sacrifica aquelas permanentes. (Os montes podem estar vazios.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5fddb9e7-e063-48de-8581-65447e820d6f\', \'multiverseId\': 422862}, \'multiverseid\': 422862}, {\'name\': \'命运无常\', \'text\': \'从你开始，每位牌手将由他操控的所有永久物分成三堆。然后每位牌手各从自己的牌堆中随机选择一堆并牺牲该些永久物。（牌堆可以是空的。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421107&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f30e88e2-8ece-47b1-b489-6e60e4fa3c37\', \'multiverseId\': 421107}, \'multiverseid\': 421107}]', '[{\'name\': \'Lavalawine\', \'text\': \'Die Lavalawine fügt einem Spieler deiner Wahl und jeder Kreatur, die er kontrolliert, X Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'Das brennende Blut Alaras kann von bloßem Stein und Erde nicht aufgehalten werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421528&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36a0db7b-aad9-42b6-a890-64c78c9c566c\', \'multiverseId\': 421528}, \'multiverseid\': 421528}, {\'name\': \'Lavalancha\', \'text\': \'La Lavalancha hace X puntos de daño al jugador objetivo y a cada criatura que controla.\', \'type\': \'Conjuro\', \'flavor\': \'La sangre hirviente de Alara no puede ser contenida simplemente con tierra y piedra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423283&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bfeb00e0-8e8d-4920-ab41-8420dc3d3611\', \'multiverseId\': 423283}, \'multiverseid\': 423283}, {\'name\': \'Lavalanche\', \'text\': "La Lavalanche inflige X blessures au joueur ciblé et à chaque créature qu\'il contrôle.", \'type\': \'Rituel\', \'flavor\': "Le sang bouillonnant d\'Alara ne peut être retenu ni par la terre ni par la pierre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421879&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2faea32c-88ce-4cde-a133-22ba9b876033\', \'multiverseId\': 421879}, \'multiverseid\': 421879}, {\'name\': \'Lavalanga\', \'text\': \'La Lavalanga infligge X danni a un giocatore bersaglio e a ogni creatura che controlla.\', \'type\': \'Stregoneria\', \'flavor\': \'Il sangue ardente di Alara non può essere contenuto da un semplice ammasso di sassi e terra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422230&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6827d563-fd09-4e35-b48f-4fe997d64e61\', \'multiverseId\': 422230}, \'multiverseid\': 422230}, {\'name\': \'溶岩崩れ\', \'text\': \'プレイヤー１人を対象とする。溶岩崩れは、そのプレイヤーとそのプレイヤーがコントロールする各クリーチャーにそれぞれＸ点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'アラーラの燃える血には、単なる土や石など含まれはしない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422581&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5f4026c5-2725-415b-8528-5a7d46cebfee\', \'multiverseId\': 422581}, \'multiverseid\': 422581}, {\'name\': \'Lavalanche\', \'text\': \'Lavalanche causa X pontos de dano ao jogador alvo e a cada criatura que ele controla.\', \'type\': \'Feitiço\', \'flavor\': \'O sangue em chamas de Alara não pode ser contido somente com terra e pedra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422932&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9383661e-d637-438b-aecb-f6460f04d17b\', \'multiverseId\': 422932}, \'multiverseid\': 422932}, {\'name\': \'岩浆崩\', \'text\': \'岩浆崩对目标牌手与每个由其操控的生物各造成X点伤害。\', \'type\': \'法术\', \'flavor\': \'阿拉若的沸腾热血无法只靠土壤与石头盛装。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421177&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'30ef6e9a-1b5c-4317-be9f-af995daa8c46\', \'multiverseId\': 421177}, \'multiverseid\': 421177}]', '[{\'name\': \'Leitstern der Unruhe\', \'text\': \'Bringe eine Artefakt- oder Kreaturenkarte deiner Wahl aus einem Friedhof unter deiner Kontrolle ins Spiel. Mische den Leitstern der Unruhe in die Bibliothek seines Besitzers.\', \'type\': \'Hexerei\', \'flavor\': \'„Das mich leitende Licht meines Meisters durchdringt alle Grenzen, selbst die zwischen Leben und Tod."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421426&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e121401-c325-4f77-b65b-7b5464695b8f\', \'multiverseId\': 421426}, \'multiverseid\': 421426}, {\'name\': \'Faro de desasosiego\', \'text\': \'Pon en el campo de batalla bajo tu control la carta de artefacto o criatura objetivo de un cementerio. Baraja el Faro de desasosiego en la biblioteca de su propietario.\', \'type\': \'Conjuro\', \'flavor\': \'"La luz que irradia el consejo de mi maestro atraviesa todas las fronteras, incluso las que separan la vida de la muerte".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423181&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24c8cd0d-7a5e-4fef-bdfe-ab4b04535061\', \'multiverseId\': 423181}, \'multiverseid\': 423181}, {\'name\': "Flambeau de l\'Inquiétude", \'text\': "Mettez sur le champ de bataille, sous votre contrôle, une carte d\'artefact ou de créature ciblée d\'un cimetière. Mélangez le Flambeau de l\'Inquiétude dans la bibliothèque de son propriétaire.", \'type\': \'Rituel\', \'flavor\': \'« La lumière de mon maître traverse toutes les frontières, même celle séparant la vie et la mort. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421777&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f937f3d-245c-4be1-b53a-1c63c5cb4601\', \'multiverseId\': 421777}, \'multiverseid\': 421777}, {\'name\': "Faro dell\'Inquietudine", \'text\': "Metti sul campo di battaglia sotto il tuo controllo una carta creatura o artefatto bersaglio da un cimitero. Rimescola il Faro dell\'Inquietudine nel grimorio del suo proprietario.", \'type\': \'Stregoneria\', \'flavor\': \'"La luce degli insegnamenti del mio maestro attraversa ogni confine, anche quello che separa la vita dalla morte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422128&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d91899c8-f3de-4c2e-ab65-823b593e140a\', \'multiverseId\': 422128}, \'multiverseid\': 422128}, {\'name\': \'不穏の標\', \'text\': \'墓地からアーティファクト・カード１枚かクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で戦場に出す。不穏の標をオーナーのライブラリーに加えて切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'我が主の導きの光は、生と死を分かつ境をも越えて届く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422479&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21f91d62-a58b-4bc1-a5f3-689618138555\', \'multiverseId\': 422479}, \'multiverseid\': 422479}, {\'name\': \'Guia da Inquietação\', \'text\': \'Coloque o card de criatura ou artefato alvo de um cemitério no campo de batalha sob o seu controle. Embaralhe Guia da Inquietação no grimório de seu dono.\', \'type\': \'Feitiço\', \'flavor\': \'"A luz da orientação de meu mestre atravessa todas as divisas, mesmo as que separam a vida e a morte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422830&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1f423fcd-568f-44d5-84c4-c832a63cb917\', \'multiverseId\': 422830}, \'multiverseid\': 422830}, {\'name\': \'不息信标\', \'text\': \'将目标神器或生物牌在你的操控下从坟墓场放进战场。将不息信标洗入其拥有者的牌库。\', \'type\': \'法术\', \'flavor\': \'「我主指引的明光遍及所有地界，即使隔绝生死的领域都能到达。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421075&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5587ac5a-a170-4611-be60-c5c1d6e8e848\', \'multiverseId\': 421075}, \'multiverseid\': 421075}]', '[{\'name\': \'Lohnende Ausfahrt\', \'text\': \'Wühlen (Mit jeder Karte, die du aus deinem Friedhof ins Exil schickst, während du diesen Zauberspruch wirkst, bezahlst du {1} seiner Kosten.)\\nZiehe drei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'Zahllose Freuden treiben auf der Oberfläche, doch darunter strömen dunkle Machenschaften.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421420&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4998305b-a2ae-47a8-99ed-c37a52340788\', \'multiverseId\': 421420}, \'multiverseid\': 421420}, {\'name\': \'Crucero del tesoro\', \'text\': \'Excavar. (Cada carta que exilies de tu cementerio al lanzar este hechizo cuenta como un pago de {1}.)\\nRoba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Incontables maravillas flotan en la superficie; mientras, en las profundidades se urden oscuras maquinaciones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423175&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9240f5c9-218d-4e3f-991a-1ebbb15596d7\', \'multiverseId\': 423175}, \'multiverseid\': 423175}, {\'name\': \'Fortune des mers\', \'text\': \'Fouille (Chaque carte que vous exilez depuis votre cimetière en lançant ce sort paie {1}.)\\nPiochez trois cartes.\', \'type\': \'Rituel\', \'flavor\': "Tandis que d\'innombrables délices dérivent à la surface, de sombres machinations se cachent dans les profondeurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421771&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'136cd3b8-fb4a-4fd9-841c-c447c162d06e\', \'multiverseId\': 421771}, \'multiverseid\': 421771}, {\'name\': \'Traversata Sfarzosa\', \'text\': \'Esumare (Ogni carta che esili dal tuo cimitero mentre lanci questa magia corrisponde al pagamento di {1}.)\\nPesca tre carte.\', \'type\': \'Stregoneria\', \'flavor\': \'Infinite delizie scivolano in superficie, sopra correnti profonde di oscuri intrighi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422122&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1dbf56ac-a9cb-44c1-919a-2c5cd073052f\', \'multiverseId\': 422122}, \'multiverseid\': 422122}, {\'name\': \'宝船の巡航\', \'text\': \'探査（この呪文を唱える段階であなたがあなたの墓地から追放した各カードは、{1}を支払う。）\\nカードを３枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'無数の歓楽が水面上に浮かぶ間も、暗き陰謀が水面下で展開されている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422473&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d43d147-2f0e-4305-a636-274ad88da442\', \'multiverseId\': 422473}, \'multiverseid\': 422473}, {\'name\': \'Cruzeiro do Tesouro\', \'text\': \'Esquadrinhar (Cada card que você exila de seu cemitério quando conjura esta mágica paga por {1}.)\\nCompre três cards.\', \'type\': \'Feitiço\', \'flavor\': \'Incontáveis prazeres flutuam na superfície enquanto planos malignos correm por baixo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422824&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d48bfc22-6aa0-4672-958f-9d923b14d45c\', \'multiverseId\': 422824}, \'multiverseid\': 422824}, {\'name\': \'宝船巡游\', \'text\': \'掘穴（你于施放此咒语时每从你坟墓场中放逐一张牌，就能为此咒语支付{1}。）\\n抓三张牌。\', \'type\': \'法术\', \'flavor\': \'金玉漂流在外，阴谋勾画其间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421069&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35b7a6ea-db67-4ab2-89fa-16533e5731aa\', \'multiverseId\': 421069}, \'multiverseid\': 421069}]', '[{\'name\': \'Loxodon-Kriegshammer\', \'text\': \'Die ausgerüstete Kreatur erhält +3/+0, hat Lebensverknüpfung und verursacht Trampelschaden.\\nAusrüsten {3}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Ein Schmied muss seine Waffe mit einem Teil seiner Seele erfüllen — dessen sind die Phyrexianer nicht fähig." —Melira, Sylvok-Ausgestoßene\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421580&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a4d9f74-4db6-48f9-9e66-af24b8ecdbd2\', \'multiverseId\': 421580}, \'multiverseid\': 421580}, {\'name\': \'Martillo de guerra loxodón\', \'text\': \'La criatura equipada obtiene +3/+0 y tiene las habilidades de arrollar y vínculo vital.\\nEquipar {3}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"Un herrero debe imbuir en su arma parte de su alma... Algo de lo que los pirexianos son incapaces". —Melira, paria sylvok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1957eb4a-ce9c-46b0-8279-0b966b69a554\', \'multiverseId\': 423335}, \'multiverseid\': 423335}, {\'name\': \'Marteau de guerre loxodon\', \'text\': \'La créature équipée gagne +3/+0 et a le piétinement et le lien de vie.\\nÉquipement {3}\', \'type\': \'Artefact : équipement\', \'flavor\': "« Un façonneur doit imprégner son arme d\'une partie de son âme — ce dont les Phyrexians sont bien incapables. » —Melira, proscrite sylvoke", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421931&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'57d38779-94f8-4bfb-b249-a577bb0a187a\', \'multiverseId\': 421931}, \'multiverseid\': 421931}, {\'name\': \'Martello da Guerra Lossodonte\', \'text\': \'La creatura equipaggiata prende +3/+0 e ha legame vitale e travolgere.\\nEquipaggiare {3}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Un\\\'artefice deve infondere nella sua arma parte della propria anima: un processo impossibile per gli orrori di Phyrexia." —Melira, reietta Sylvok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422282&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f661457-286a-4c87-8431-25bf68ceed0c\', \'multiverseId\': 422282}, \'multiverseid\': 422282}, {\'name\': \'ロクソドンの戦槌\', \'text\': \'装備しているクリーチャーは＋３/＋０の修整を受けるとともにトランプルと絆魂を持つ。\\n装備{3}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「造り士は武器に自分の魂の一部を埋め込まなくてはならないの。これはファイレクシア人にはできない芸当だけどね。」 ――シルヴォクののけ者、メリーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422633&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40de2bae-1d74-494e-a2f2-84cc29f17875\', \'multiverseId\': 422633}, \'multiverseid\': 422633}, {\'name\': \'Martelo de Batalha dos Loxodontes\', \'text\': \'A criatura equipada recebe +3/+0 e tem atropelar e vínculo com a vida.\\nEquipar {3}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Um artífice precisa imbuir sua arma com parte da própria alma, algo que os phyrexianos são incapazes de fazer." — Melira, pária silvoque\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422984&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38318410-63c5-4372-9703-0109bc921c25\', \'multiverseId\': 422984}, \'multiverseid\': 422984}, {\'name\': \'象族战锤\', \'text\': \'佩带此武具的生物得+3/+0且具有践踏与系命异能。\\n佩带{3}\', \'type\': \'神器～武具\', \'flavor\': \'「巧匠打造武器时必定会将心血甚至灵魂灌注其中～这一点非瑞克西亚人永远没法做到。」 ～希沃克黜人梅梨莱\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421229&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03d3b47c-819b-434f-824f-1d5cb131267a\', \'multiverseId\': 421229}, \'multiverseid\': 421229}]', '[{\'name\': \'Ludevic, Nekro-Alchemist\', \'text\': \'Zu Beginn des Endsegments jedes Spielers kann jener Spieler eine Karte ziehen, falls ein Spieler außer dir in diesem Zug Lebenspunkte verloren hat.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Wie man autodidaktisch zum Genie wird? Nun, man benötigt dafür ein Gehirn."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421356&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f633fe09-7b38-4011-9b80-df786f31e814\', \'multiverseId\': 421356}, \'multiverseid\': 421356}, {\'name\': \'Ludevic, necroalquimista\', \'text\': \'Al comienzo del paso final de cada jugador, ese jugador puede robar una carta si otro jugador que no seas tú perdió una o más vidas este turno.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"¿Cómo se convierte uno en un genio autodidacta? Pues con cerebro, está claro".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423111&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a0483b3-7de0-44b6-b577-cc9287d2c227\', \'multiverseId\': 423111}, \'multiverseid\': 423111}, {\'name\': \'Ludevic, nécro-alchimiste\', \'text\': "Au début de l\'étape de fin de chaque joueur, ce joueur peut piocher une carte si un joueur autre que vous a perdu des points de vie ce tour-ci.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': \'« Comment devient-on un génie autodidacte ? Naturellement, il faut avoir de la cervelle. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421707&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'de1894c1-58db-4e91-a667-b83c63d1ce5d\', \'multiverseId\': 421707}, \'multiverseid\': 421707}, {\'name\': \'Ludevic, Necro-Alchimista\', \'text\': "All\'inizio della sottofase finale di ogni giocatore, quel giocatore può pescare una carta se un giocatore diverso da te ha perso punti vita in questo turno.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)", \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"Come si diventa un genio autodidatta? Naturalmente, ci vuole cervello."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422058&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28b96994-264a-491a-89dd-a3b123051ad7\', \'multiverseId\': 422058}, \'multiverseid\': 422058}, {\'name\': \'屍錬金術師、ルーデヴィック\', \'text\': \'各プレイヤーの終了ステップの開始時に、そのプレイヤーは、あなた以外のプレイヤーがこのターンにライフを失っていたなら、カードを１枚引いてもよい。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'「どうすれば独学で天才になれるのか、だと？とりあえず脳が必要だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422409&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d31f87d7-24aa-4680-8468-11842b4388ab\', \'multiverseId\': 422409}, \'multiverseid\': 422409}, {\'name\': \'Ludevic, Necroalquimista\', \'text\': \'No início da etapa final de cada jogador, aquele jogador pode comprar um card se um jogador que não seja você perdeu pontos de vida neste turno.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Humano Mago\', \'flavor\': \'"Como alguém se torna um gênio autodidata? Usando o cérebro, naturalmente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93c851da-d6ce-4c07-8530-64d8f056dfdf\', \'multiverseId\': 422760}, \'multiverseid\': 422760}, {\'name\': \'死灵炼金术士卢德维\', \'text\': \'在每位牌手的结束步骤开始时，对该牌手而言，如果本回合中曾有你以外的牌手失去生命，则他可以抓一张牌。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～人类／法术师\', \'flavor\': \'「怎样才能自学成才？显然，需要有脑子。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421005&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8c8b1a5b-a75e-4145-91bf-8df9172e19cb\', \'multiverseId\': 421005}, \'multiverseid\': 421005}]', '[{\'name\': \'Magus des Willens\', \'text\': \'{2}{B}, {T}, schicke den Magus des Willens ins Exil: Bis zum Ende des Zuges kannst du Karten aus deinem Friedhof spielen. Falls eine Karte in diesem Zug von irgendwoher auf deinen Friedhof gelegt würde, schicke sie stattdessen ins Exil.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Diese Augen haben mir die Makel des Fleisches gezeigt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421333&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6950ca9c-e98e-4fd0-b9cc-417a89fc4f8e\', \'multiverseId\': 421333}, \'multiverseid\': 421333}, {\'name\': \'Mago de la voluntad\', \'text\': \'{2}{B}, {T}, exiliar al Mago de la voluntad: Hasta el final del turno, puedes jugar cartas desde tu cementerio. Si una carta fuera a ir a tu cementerio desde cualquier parte este turno, en vez de eso, exilia esa carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Estos ojos me mostraron los defectos de la carne".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423088&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af31faa4-cc41-4e8c-ba3c-15ad3fc26fc7\', \'multiverseId\': 423088}, \'multiverseid\': 423088}, {\'name\': \'Mage de la volonté\', \'text\': "{2}{B}, {T}, exilez le Mage de la volonté : Jusqu\'à la fin du tour, vous pouvez jouer des cartes depuis votre cimetière. Si une carte devait être mise dans votre cimetière d\'où qu\'elle vienne ce tour-ci, exilez cette carte à la place.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Ces yeux m\'ont montré les défauts de la chair. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421684&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e742803e-0589-48dc-bb74-2ec456ff9a64\', \'multiverseId\': 421684}, \'multiverseid\': 421684}, {\'name\': \'Magus della Volontà\', \'text\': \'{2}{B}, {T}, Esilia il Magus della Volontà: Fino alla fine del turno, puoi giocare carte dal tuo cimitero. Se una carta sta per essere messa nel tuo cimitero da qualsiasi zona in questo turno, invece esiliala.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Questi occhi mi hanno mostrato le imperfezioni della carne."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b77ea04-3edb-4b21-96df-8d70454dbb16\', \'multiverseId\': 422035}, \'multiverseid\': 422035}, {\'name\': \'意志の大魔術師\', \'text\': \'{2}{B}, {T}, 意志の大魔術師を追放する：ターン終了時まで、あなたはあなたの墓地からカードをプレイしてもよい。このターン、いずれかの領域からカードがあなたの墓地に置かれるなら、代わりにそのカードを追放する。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「この眼が肉体の欠陥を見せたのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422386&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4620c7bc-d086-4789-8e7f-dbd26d6189a1\', \'multiverseId\': 422386}, \'multiverseid\': 422386}, {\'name\': \'Magus da Vontade\', \'text\': \'{2}{B}, {T}, Exile Magus da Vontade: Até o final do turno, você pode jogar cards a partir do seu cemitério. Se um card seria colocado em seu cemitério a partir de qualquer lugar neste turno, em vez disso, exile aquele card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Esses olhos me mostraram as falhas da carne."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422737&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8fc91b90-c016-4555-9714-02bf1bc97a9e\', \'multiverseId\': 422737}, \'multiverseid\': 422737}, {\'name\': \'意志贤者\', \'text\': \'{2}{B}，{T}，放逐意志贤者：直到回合结束，你可以从你的坟墓场使用牌。如果本回合中某张牌将从任何区域置入你的坟墓场，则改为放逐该牌。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「这双眼睛向我展现出肉身的瑕疵。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420982&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f29f0106-dfe8-4195-8b15-3214f77886e7\', \'multiverseId\': 420982}, \'multiverseid\': 420982}]', '[{\'name\': \'Manaverschlingende Hydra\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn ein Spieler einen Zauberspruch wirkt, lege eine +1/+1-Marke auf die Manaverschlingende Hydra.\', \'type\': \'Kreatur — Hydra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421476&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e1ca05f-71d0-498d-8160-166729ecf00a\', \'multiverseId\': 421476}, \'multiverseid\': 421476}, {\'name\': \'Hidra manainsaciable\', \'text\': \'Arrolla.\\nSiempre que un jugador lance un hechizo, pon un contador +1/+1 sobre la Hidra manainsaciable.\', \'type\': \'Criatura — Hidra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423231&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f61de64-9084-45f3-b847-43df4a34aeab\', \'multiverseId\': 423231}, \'multiverseid\': 423231}, {\'name\': \'Hydre avaleuse de mana\', \'text\': "Piétinement\\nÀ chaque fois qu\'un joueur lance un sort, mettez un marqueur +1/+1 sur l\'Hydre avaleuse de mana.", \'type\': \'Créature : hydre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421827&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c756476-8468-4810-ad45-956497ac3413\', \'multiverseId\': 421827}, \'multiverseid\': 421827}, {\'name\': \'Idra Divoramana\', \'text\': "Travolgere\\nOgniqualvolta un giocatore lancia una magia, metti un segnalino +1/+1 sull\'Idra Divoramana.", \'type\': \'Creatura — Idra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422178&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'992b6f92-8d64-4817-957c-4173a8d33415\', \'multiverseId\': 422178}, \'multiverseid\': 422178}, {\'name\': \'マナ喰らいのハイドラ\', \'text\': \'トランプル\\nプレイヤーが呪文を１つ唱えるたび、マナ喰らいのハイドラの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — ハイドラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422529&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1facc798-3ef8-4ef6-91b9-ed0c01dc4123\', \'multiverseId\': 422529}, \'multiverseid\': 422529}, {\'name\': \'Hidra Devoradora de Mana\', \'text\': \'Atropelar\\nToda vez que um jogador conjurar uma mágica, coloque um marcador +1/+1 em Hidra Devoradora de Mana.\', \'type\': \'Criatura — Hidra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422880&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ab71162-de66-4cdf-a2c8-ae180ab4678a\', \'multiverseId\': 422880}, \'multiverseid\': 422880}, {\'name\': \'吞魔多头龙\', \'text\': \'践踏\\n每当任一牌手施放咒语时，在吞魔多头龙上放置一个+1/+1指示物。\', \'type\': \'生物～多头龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421125&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bdbafb70-20da-4f6b-9bd4-8e49ddb2ae4f\', \'multiverseId\': 421125}, \'multiverseid\': 421125}]', '[{\'name\': \'Mannigfaltige Landschaft\', \'text\': \'Die Mannigfaltige Landschaft kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {C}.\\n{2}, {T}, opfere die Mannigfaltige Landschaft: Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, die einen Landtyp gemeinsam haben, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421628&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a9cdfc0e-2233-49b4-ba8d-50e3d774d5db\', \'multiverseId\': 421628}, \'multiverseid\': 421628}, {\'name\': \'Paisaje infinito\', \'text\': \'El Paisaje infinito entra al campo de batalla girado.\\n{T}: Agrega {C} a tu reserva de maná.\\n{2}, {T}, sacrificar el Paisaje infinito: Busca en tu biblioteca hasta dos cartas de tierra básica que compartan un tipo de tierra, ponlas en el campo de batalla giradas y luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423383&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c7198e9-1317-48e7-9d9a-ab6e39e82c2d\', \'multiverseId\': 423383}, \'multiverseid\': 423383}, {\'name\': \'Paysage myriadaire\', \'text\': "Le Paysage myriadaire arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {C} à votre réserve.\\n{2}, {T}, sacrifiez le Paysage myriadaire : Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base qui partagent un type de terrain, mettez-les sur le champ de bataille engagées et mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421979&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd3b5e64-78ac-403d-b3c8-e0ba35718ff2\', \'multiverseId\': 421979}, \'multiverseid\': 421979}, {\'name\': \'Paesaggio delle Miriadi\', \'text\': \'Il Paesaggio delle Miriadi entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {C} alla tua riserva di mana.\\n{2}, {T}, Sacrifica il Paesaggio delle Miriadi: Passa in rassegna il tuo grimorio per trovare fino a due carte terra base che condividono un tipo di terra, mettile sul campo di battaglia TAPpate, poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422330&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef6f2fac-6d72-4d08-a513-c021ce045a8f\', \'multiverseId\': 422330}, \'multiverseid\': 422330}, {\'name\': \'無限地帯\', \'text\': \'無限地帯はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{C}を加える。\\n{2}, {T}, 無限地帯を生け贄に捧げる：あなたのライブラリーから同じ土地タイプを持つ基本土地・カード最大２枚を探し、それらをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422681&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6be2f8b-4e1c-4787-bc36-911244409b7d\', \'multiverseId\': 422681}, \'multiverseid\': 422681}, {\'name\': \'Paisagem Infinita\', \'text\': \'Paisagem Infinita entra no campo de batalha virada.\\n{T}: Adicione {C} à sua reserva de mana.\\n{2}, {T}, Sacrifique Paisagem Infinita: Procure em seu grimório até dois cards de terreno básico que compartilhem um tipo de terreno, coloque-os no campo de batalha virados e, em seguida, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423032&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f55a87d5-97a6-481a-b8ed-08fdae6ea120\', \'multiverseId\': 423032}, \'multiverseid\': 423032}, {\'name\': \'繁茂地境\', \'text\': \'繁茂地境须横置进战场。\\n{T}：加{C}到你的法术力池中。\\n{2}，{T}，牺牲繁茂地境：从你的牌库中搜寻至多两张具共通地类别的基本地牌，将它们横置放进战场，然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421277&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0ab33a0e-ea82-41bf-95ab-f360b2d11442\', \'multiverseId\': 421277}, \'multiverseid\': 421277}]', "[{'name': 'Mantel aus Flüsterseide', 'text': 'Die ausgerüstete Kreatur kann nicht geblockt werden und hat Verhülltheit. (Sie kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.)\\nAusrüsten {2}', 'type': 'Artefakt — Ausrüstung', 'flavor': 'Nicht nur Meuchler zahlen für diese Mäntel einen hohen Preis — sondern auch diejenigen, die sich vor Meuchlern fürchten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421599&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7aafb4b8-8c87-49ec-875c-cdaf269749f8', 'multiverseId': 421599}, 'multiverseid': 421599}, {'name': 'Manto de sedasusurrante', 'text': 'La criatura equipada no puede ser bloqueada y tiene la habilidad de velo. (No puede ser objetivo de hechizos o habilidades.)\\nEquipar {2}.', 'type': 'Artefacto — Equipo', 'flavor': 'Esos mantos tienen una gran demanda por los asesinos y aquellos que les temen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423354&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9a6614c7-58c4-475d-86b7-180ff8941de1', 'multiverseId': 423354}, 'multiverseid': 423354}, {'name': 'Cape de frémisoie', 'text': 'La créature équipée ne peut pas être bloquée et a le linceul. (Elle ne peut pas être la cible de sorts ou de capacités.)\\nÉquipement {2}', 'type': 'Artefact : équipement', 'flavor': 'Ces capes sont aussi populaires chez les assassins que chez leurs victimes potentielles.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421950&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3771dece-74a5-49c2-827c-8e3867af5194', 'multiverseId': 421950}, 'multiverseid': 421950}, {'name': 'Manto Setabisbiglio', 'text': 'La creatura equipaggiata non può essere bloccata e ha velo. (Non può essere bersaglio di magie o abilità.)\\nEquipaggiare {2}', 'type': 'Artefatto — Equipaggiamento', 'flavor': 'Questi mantelli sono molto richiesti sia dagli assassini che da quanti li temono.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422301&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1fdc3298-29a4-4462-9f10-06aa839f7a8b', 'multiverseId': 422301}, 'multiverseid': 422301}, {'name': '囁き絹の外套', 'text': '装備しているクリーチャーは、ブロックされなくなるとともに被覆を持つ。（それは呪文や能力の対象にならない。）\\n装備{2}', 'type': 'アーティファクト — 装備品', 'flavor': 'この手の外套は、暗殺者とともにそれを恐れる者たちにも大きな需要がある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422652&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '765eb666-d979-410c-a8f9-4902ccc8393a', 'multiverseId': 422652}, 'multiverseid': 422652}, {'name': 'Manto de Seda Ruflante', 'text': 'A criatura equipada não pode ser bloqueada e tem manto. (Ela não pode ser alvo de mágicas nem de habilidades.)\\nEquipar {2}', 'type': 'Artefato — Equipamento', 'flavor': 'Esses mantos estão tendo muita procura, tanto pelos assassinos quanto pelos que os temem.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423003&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3cb1f779-5f25-4e28-b267-b48bbe20b84e', 'multiverseId': 423003}, 'multiverseid': 423003}, {'name': '细语丝篷', 'text': '佩带此武具的生物不能被阻挡，且具有帷幕异能。（它不能成为咒语或异能的目标。）\\n佩带{2}', 'type': '神器～武具', 'flavor': '这斗篷很受杀手与担忧成其目标者欢迎。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421248&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3e9fbbf6-aae6-4ac7-8c71-3584e77524bd', 'multiverseId': 421248}, 'multiverseid': 421248}]", '[{\'name\': \'Meister des Ätheriums\', \'text\': \'Stärke und Widerstandskraft des Meisters des Ätheriums sind gleich der Anzahl an Artefakten, die du kontrollierst.\\nAndere Artefaktkreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Artefaktkreatur — Vedalken, Zauberer\', \'flavor\': \'„Nur ein Verstand, der nicht von den Sorgen eines Körpers belastet wird, kann die Welt so sehen, wie sie wirklich ist."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421411&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5756aca-04b8-4131-9d95-47eee72e572c\', \'multiverseId\': 421411}, \'multiverseid\': 421411}, {\'name\': \'Maestro de eterium\', \'text\': \'La fuerza y resistencia del Maestro de eterium son iguales a la cantidad de artefactos que controlas.\\nLas otras criaturas artefacto que controlas obtienen +1/+1.\', \'type\': \'Criatura artefacto — Hechicero vedalken\', \'flavor\': \'"Solo una mente no contaminada con las preocupaciones de la carne puede ver el mundo como realmente es".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423166&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69ca836f-8566-4a0e-a259-205f27161970\', \'multiverseId\': 423166}, \'multiverseid\': 423166}, {\'name\': "Maître de l\'étherium", \'text\': "La force et l\'endurance du Maître de l\'étherium sont chacune égales au nombre d\'artefacts que vous contrôlez.\\nLes autres créatures-artefacts que vous contrôlez gagnent +1/+1.", \'type\': \'Créature-artefact : vedalken et sorcier\', \'flavor\': "« Seul l\'esprit qui se moque des exigences de la chair peut voir le monde tel qu\'il est véritablement. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421762&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fda938a2-e4ad-486d-9814-0670d9771878\', \'multiverseId\': 421762}, \'multiverseid\': 421762}, {\'name\': \'Maestro di Eterium\', \'text\': \'La forza e la costituzione del Maestro di Eterium sono pari al numero di artefatti che controlli.\\nLe altre creature artefatto che controlli prendono +1/+1.\', \'type\': \'Creatura Artefatto — Mago Vedalken\', \'flavor\': \'"Solo una mente libera dalle preoccupazioni della carne può vedere il mondo com\\\'è realmente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422113&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b11f24d9-a338-4d32-907b-22b84e75b48e\', \'multiverseId\': 422113}, \'multiverseid\': 422113}, {\'name\': \'エーテリウムの達人\', \'text\': \'エーテリウムの達人のパワーとタフネスは、それぞれあなたがコントロールするアーティファクトの総数に等しい。\\nあなたがコントロールする他のアーティファクト・クリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — ヴィダルケン・ウィザード\', \'flavor\': \'「肉体の懸念から解き放たれた精神のみが、真の世界を見ることができる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422464&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'587a4ab7-3370-4285-a6db-28924d78abcd\', \'multiverseId\': 422464}, \'multiverseid\': 422464}, {\'name\': \'Mestre do Etherium\', \'text\': \'O poder e a resistência de Mestre do Etherium são ambos iguais ao número de artefatos que você controla.\\nAs outras criaturas artefato que você controla recebem +1/+1.\', \'type\': \'Criatura Artefato — Vedalkeano Mago\', \'flavor\': \'"Somente uma mente livre das preocupações da carne pode ver o mundo como ele realmente é."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'963b908d-4273-4242-8618-b57fb85b12a4\', \'multiverseId\': 422815}, \'multiverseid\': 422815}, {\'name\': \'乙金大师\', \'text\': \'乙金大师的力量和防御力各等同于由你操控的神器数量。\\n由你操控的其他神器生物得+1/+1。\', \'type\': \'神器生物～维多肯／法术师\', \'flavor\': \'「未受肉身束缚的心灵，才得见世界真貌。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5912bd6a-53ea-4e39-9a53-eac4ffa55bf4\', \'multiverseId\': 421060}, \'multiverseid\': 421060}]', '[{\'name\': \'Meister-Biomagier\', \'text\': \'Jede andere Kreatur, die du kontrollierst, kommt mit so vielen zusätzlichen +1/+1-Marken ins Spiel, wie die Stärke des Meister-Biomagiers beträgt, und zusätzlich zu ihren anderen Typen als Mutant.\', \'type\': \'Kreatur — Elf, Zauberer\', \'flavor\': \'„Die Natur ist ein wunderbarer Ingenieur, aber für meinen Geschmack arbeitet sie viel zu langsam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0750c807-53ae-4f54-954d-e9aa7a77a070\', \'multiverseId\': 421529}, \'multiverseid\': 421529}, {\'name\': \'Maestro biomante\', \'text\': \'Cada otra criatura que controlas entra al campo de batalla con una cantidad de contadores +1/+1 adicionales iguales a la fuerza del Maestro biomante y como un Mutante además de sus otros tipos.\', \'type\': \'Criatura — Hechicero elfo\', \'flavor\': \'"La naturaleza es una ingeniera magnífica, pero trabaja muy despacio para mi gusto".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423284&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2433d9e5-12cb-41f5-81f2-7c15ff7dfe86\', \'multiverseId\': 423284}, \'multiverseid\': 423284}, {\'name\': \'Maître biomancien\', \'text\': \'Chaque autre créature que vous contrôlez arrive sur le champ de bataille avec, sur elle, un nombre de marqueurs +1/+1 supplémentaires égal à la force du Maître biomancien et comme un mutant en plus de ses autres types.\', \'type\': \'Créature : elfe et sorcier\', \'flavor\': \'« La nature est une merveilleuse créatrice, mais elle travaille bien trop lentement à mon goût. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421880&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0cb0a45a-fbc0-48a5-b872-040a433b6b4f\', \'multiverseId\': 421880}, \'multiverseid\': 421880}, {\'name\': \'Gran Biomante\', \'text\': \'Ogni altra creatura che controlli entra nel campo di battaglia con un numero di segnalini +1/+1 addizionali pari alla forza del Gran Biomante e come Mutante in aggiunta ai suoi altri tipi.\', \'type\': \'Creatura — Mago Elfo\', \'flavor\': \'"La natura è un ingegnere meraviglioso, ma lavora troppo lentamente per i miei gusti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422231&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0ceeb10-1e02-4402-aa02-c2cc6b464809\', \'multiverseId\': 422231}, \'multiverseid\': 422231}, {\'name\': \'練達の生術師\', \'text\': \'あなたがコントロールする他の各クリーチャーはそれぞれ、練達の生術師のパワーに等しい数の追加の＋１/＋１カウンターが置かれるとともに、他のタイプに加えてミュータントでもある状態で戦場に出る。\', \'type\': \'クリーチャー — エルフ・ウィザード\', \'flavor\': \'「自然は素晴らしい技術者だが、私からすれば仕事があまりに遅すぎる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422582&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc7afac0-36c3-4c6b-8ccf-6e40d0ca30e4\', \'multiverseId\': 422582}, \'multiverseid\': 422582}, {\'name\': \'Biomante Mestre\', \'text\': \'Cada outra criatura que você controla entra no campo de batalha com uma quantidade de marcadores +1/+1 adicionais equivalente ao poder de Biomante Mestre e como Mutante além de seus outros tipos.\', \'type\': \'Criatura — Elfo Mago\', \'flavor\': \'"A natureza é uma engenheira maravilhosa, mas trabalha devagar demais para o meu gosto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422933&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0aeb0fd0-b6b6-46cc-b36c-796a38788b8f\', \'multiverseId\': 422933}, \'multiverseid\': 422933}, {\'name\': \'生机大师\', \'text\': \'每个由你操控的其他生物进战场时，上面均额外有若干+1/+1指示物，其数量等同于生机大师的力量，且均额外具有突变体此类别。\', \'type\': \'生物～妖精／法术师\', \'flavor\': \'「大自然是了不起的工程师，但其进度过慢，不符我的需求。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421178&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c2102ab5-3a14-47e3-9296-7eddfebb33c6\', \'multiverseId\': 421178}, \'multiverseid\': 421178}]', '[{\'name\': \'Mentor der Sanften\', \'text\': \'Immer wenn eine andere Kreatur mit Stärke 2 oder weniger unter deiner Kontrolle ins Spiel kommt, kannst du {1} bezahlen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„In diesen Hallen gibt es kein Bestehen oder Scheitern. Deine wahre Prüfung kommt beim nächsten Vollmond."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421388&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80ceb309-14f7-45cd-9219-557720f0a864\', \'multiverseId\': 421388}, \'multiverseid\': 421388}, {\'name\': \'Mentor de los mansos\', \'text\': \'Siempre que otra criatura con fuerza de 2 o menos entre al campo de batalla bajo tu control, puedes pagar {1}. Si lo haces, roba una carta.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"En estos salones no se aprueba o reprueba. El verdadero examen llega con la primera luna llena".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423143&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd223639-dade-415d-9757-bdef82ca5956\', \'multiverseId\': 423143}, \'multiverseid\': 423143}, {\'name\': \'Mentor des humbles\', \'text\': "À chaque fois qu\'une autre créature avec une force inférieure ou égale à 2 arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {1}. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Ici il n\'y a pas d\'échec ou de réussite. Votre véritable examen de passage, c\'est la première pleine lune. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421739&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00b39458-2c5a-44dc-9988-ef0e15b02902\', \'multiverseId\': 421739}, \'multiverseid\': 421739}, {\'name\': \'Mentore degli Umili\', \'text\': "Ogniqualvolta un\'altra creatura con forza pari o inferiore a 2 entra nel campo di battaglia sotto il tuo controllo, puoi pagare {1}. Se lo fai, pesca una carta.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"In queste sale non c\\\'è promosso o bocciato. La vostra vera prova avviene con la prima luna piena."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422090&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'973c5acb-91eb-4511-ae99-54f5bdbaeafa\', \'multiverseId\': 422090}, \'multiverseid\': 422090}, {\'name\': \'弱者の師\', \'text\': \'他のパワーが２以下のクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたは{1}を支払ってもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「これらの広間では、成功も失敗もありません。真の試練は最初の満月と共に訪れます。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422441&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'516ed641-1394-4675-9dca-cca1f419b61f\', \'multiverseId\': 422441}, \'multiverseid\': 422441}, {\'name\': \'Mentor dos Humildes\', \'text\': \'Toda vez que outra criatura com poder menor ou igual a 2 entra no campo de batalha sob o seu controle, você pode pagar {1}. Se fizer isso, compre um card.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Nestes salões não existe aprovação nem reprovação. Seu verdadeiro teste acontece na primeira lua cheia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422792&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'92a6d2e1-8d56-4221-9f2e-ff7ea3c55e37\', \'multiverseId\': 422792}, \'multiverseid\': 422792}, {\'name\': \'驯良明师\', \'text\': \'每当另一个力量等于或小于2的生物在你的操控下进战场时，你可以支付{1}。若你如此作，则抓一张牌。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「这课堂没有过不过关的问题。真正的考验会在第一次满月时到来。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421037&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb033f4d-25d7-4d29-a481-5d45d5125a55\', \'multiverseId\': 421037}, \'multiverseid\': 421037}]', "[{'name': 'Mooswurz-Brücke', 'text': 'Refugium (Dieses Land kommt getappt ins Spiel. Wenn dies geschieht, schaue dir die obersten vier Karten deiner Bibliothek an, schicke eine davon verdeckt ins Exil und lege den Rest unter deine Bibliothek.)\\n{T}: Erhöhe deinen Manavorrat um {G}.\\n{G}, {T}: Falls die Kreaturen, die du kontrollierst, eine Gesamtstärke von 10 oder mehr haben, kannst du die ins Exil geschickte Karte spielen, ohne ihre Manakosten zu bezahlen.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421626&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0862c5b8-2738-4264-aec7-88e03e1e33c4', 'multiverseId': 421626}, 'multiverseid': 421626}, {'name': 'Puente de hierba musgo', 'text': 'Esconder. (Esta tierra entra al campo de batalla girada. Cuando lo haga, mira las cuatro primeras cartas de tu biblioteca, exilia una boca abajo y luego pon el resto en el fondo de tu biblioteca.)\\n{T}: Agrega {G} a tu reserva de maná.\\n{G}, {T}: Puedes jugar la carta exiliada sin pagar su coste de maná si las criaturas que controlas tienen una fuerza total de 10 o más.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423381&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '09f57947-36d2-4b1e-9910-0fc22ba3a5d2', 'multiverseId': 423381}, 'multiverseid': 423381}, {'name': 'Pont de fangemousse', 'text': 'Cachette (Ce terrain arrive sur le champ de bataille engagé. Quand il le fait, regardez les quatre cartes du dessus de votre bibliothèque, exilez-en une face cachée, puis mettez le reste au-dessous de votre bibliothèque.)\\n{T} : Ajoutez {G} à votre réserve.\\n{G}, {T} : Vous pouvez jouer la carte exilée sans payer son coût de mana si les créatures que vous contrôlez ont une force totale supérieure ou égale à 10.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421977&type=card', 'language': 'French', 'identifiers': {'scryfallId': '17bd08e7-4ac5-40a9-bf68-ee2e97848c94', 'multiverseId': 421977}, 'multiverseid': 421977}, {'name': 'Ponte Muscoso', 'text': 'Nascondiglio (Questa terra entra nel campo di battaglia TAPpata. Quando lo fa, guarda le prime quattro carte del tuo grimorio, esiliane una a faccia in giù, poi metti le altre in fondo al tuo grimorio.)\\n{T}: Aggiungi {G} alla tua riserva di mana.\\n{G}, {T}: Puoi giocare la carta esiliata senza pagare il suo costo di mana se le creature che controlli hanno una forza totale pari o superiore a 10.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422328&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2c2893aa-6bd0-449e-b42c-df2a817d4790', 'multiverseId': 422328}, 'multiverseid': 422328}, {'name': '苔汁の橋', 'text': '秘匿（この土地はタップ状態で戦場に出る。そうしたとき、あなたのライブラリーの一番上から４枚のカードを見て、そのうち１枚を裏向きで追放し、残りをあなたのライブラリーの一番下に置く。）\\n{T}：あなたのマナ・プールに{G}を加える。\\n{G}, {T}：あなたがコントロールするクリーチャーのパワーの合計が10以上であるなら、あなたはその追放されたカードを、それのマナ・コストを支払うことなくプレイしてもよい。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422679&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7389d0f3-131b-4133-9ed2-c9aa4808138b', 'multiverseId': 422679}, 'multiverseid': 422679}, {'name': 'Ponte Musgomosto', 'text': 'Refúgio (Este terreno entra no campo de batalha virado. Quando ele entrar, olhe os quatro cards do topo de seu grimório, exile um com a face voltada para baixo, e depois coloque o restante no fundo de seu grimório.)\\n{T}: Adicione {G} à sua reserva de mana.\\n{G}, {T}: Você pode jogar o card exilado sem pagar seu custo de mana se as criaturas que você controla tiverem poder total igual ou superior a 10.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423030&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8fa93237-1325-4873-a27b-e33ed1c73185', 'multiverseId': 423030}, 'multiverseid': 423030}, {'name': '苔草桥', 'text': '掩蔽（此地须横置进战场。当它进战场时，检视你牌库顶的四张牌，将其中一张牌面朝下地放逐，然后将其余的牌置于你牌库底。）\\n{T}：加{G}到你的法术力池中。\\n{G}，{T}：如果由你操控之生物的力量总和等于或大于10，则你可以使用所放逐的牌，且不需支付其法术力费用。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421275&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c54ea6c3-27af-4dec-8c27-4fe31bad133d', 'multiverseId': 421275}, 'multiverseid': 421275}]", "[{'name': 'Murmelndes Gehölz', 'text': '({T}: Erhöhe deinen Manavorrat um {G}.)\\nSowie das Murmelnde Gehölz ins Spiel kommt, kannst du eine Baumhirte-Karte aus deiner Hand offen vorzeigen. Falls du dies nicht tust, kommt das Murmelnde Gehölz getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}. Das Murmelnde Gehölz fügt dir 1 Schadenspunkt zu.', 'type': 'Land — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421627&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b97d2c46-35c8-4781-8883-bfdd1dd0e663', 'multiverseId': 421627}, 'multiverseid': 421627}, {'name': 'Espesura murmurante', 'text': '({T}: Agrega {G} a tu reserva de maná.)\\nEn cuanto la Espesura murmurante entre al campo de batalla, puedes mostrar una carta de Pueblo-arbóreo de tu mano. Si no lo haces, la Espesura murmurante entra al campo de batalla girada.\\n{T}: Agrega {W} o {B} a tu reserva de maná. La Espesura murmurante te hace 1 punto de daño.', 'type': 'Tierra — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423382&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '09938655-fa99-4c2e-b7bf-b49fc86baf4c', 'multiverseId': 423382}, 'multiverseid': 423382}, {'name': 'Bosquet bruissant', 'text': '({T} : Ajoutez {G} à votre réserve.)\\nAu moment où le Bosquet bruissant arrive sur le champ de bataille, vous pouvez révéler une carte de sylvin de votre main. Si vous ne le faites pas, le Bosquet bruissant arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {W} ou {B} à votre réserve. Le Bosquet bruissant vous inflige 1 blessure.', 'type': 'Terrain : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421978&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c7e89a33-e287-40f1-aa6d-d5c00324aad7', 'multiverseId': 421978}, 'multiverseid': 421978}, {'name': 'Bosco Sussurrante', 'text': '({T}: Aggiungi {G} alla tua riserva di mana.)\\nMentre il Bosco Sussurrante entra nel campo di battaglia, puoi rivelare una carta Silvantropo dalla tua mano. Se non lo fai, il Bosco Sussurrante entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana. Il Bosco Sussurrante ti infligge 1 danno.', 'type': 'Terra — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422329&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6e39d98c-f330-4aa2-8e24-4ab5744dfda9', 'multiverseId': 422329}, 'multiverseid': 422329}, {'name': 'つぶやき林', 'text': '（{T}：あなたのマナ・プールに{G}を加える。）\\nつぶやき林が戦場に出るに際し、あなたはあなたの手札からツリーフォーク・カード１枚を公開してもよい。そうしないなら、つぶやき林はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。つぶやき林はあなたに１点のダメージを与える。', 'type': '土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422680&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '748c16a9-a55b-488f-b1d2-bad7a21bb0e1', 'multiverseId': 422680}, 'multiverseid': 422680}, {'name': 'Bosque Murmurante', 'text': '({T}: Adicione {G} à sua reserva de mana.)\\nConforme Bosque Murmurante entra no campo de batalha, você pode revelar um card de Ent da sua mão. Se não fizer isso, Bosque Murmurante entrará no campo de batalha virado.\\n{T}: Adicione {W} ou {B} à sua reserva de mana. Bosque Murmurante causa 1 ponto de dano a você.', 'type': 'Terreno — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423031&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e873d2a1-8857-4193-a912-8944a2ba72c3', 'multiverseId': 423031}, 'multiverseid': 423031}, {'name': '细语树丛', 'text': '（{T}：加{G}到你的法术力池中。）\\n于细语树丛进战场时，你可以从你手上展示一张树妖牌。如果你未如此作，则细语树丛须横置进战场。\\n{T}：加{W}或{B}到你的法术力池中。细语树丛对你造成1点伤害。', 'type': '地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421276&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e88897f6-623c-4bc6-b20c-9d241ba5ff27', 'multiverseId': 421276}, 'multiverseid': 421276}]", '[{\'name\': \'Muse des Windgeflüsters\', \'text\': \'Fliegend\\nKreaturen können dich nicht angreifen, es sei denn, ihr Beherrscher bezahlt {2} für jede dich angreifende Kreatur, die er kontrolliert.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Ihre Stimme ist die der Rache, kalt und unbarmherzig." —Akroma, rächender Engel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421399&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'124fb455-d802-43a6-904f-b6abc3c7489f\', \'multiverseId\': 421399}, \'multiverseid\': 421399}, {\'name\': \'Musa nacida del viento\', \'text\': \'Vuela.\\nLas criaturas no pueden atacarte a menos que su controlador pague {2} por cada criatura que controla que te está atacando.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"Su voz es justicia, clara e implacable". —Akroma, vengadora angélica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423154&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68eb06d2-9522-4335-ab93-1448d3aa3061\', \'multiverseId\': 423154}, \'multiverseid\': 423154}, {\'name\': \'Muse née des vents\', \'text\': "Vol\\nLes créatures ne peuvent pas vous attaquer à moins que leur contrôleur ne paie {2} pour chaque créature qu\'il contrôle qui vous attaque.", \'type\': \'Créature : esprit\', \'flavor\': \'« Sa voix est celle de la justice, claire et implacable. » —Akroma, vengeresse angélique\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'135a974a-76c2-434e-b3d2-cda5405b2c7b\', \'multiverseId\': 421750}, \'multiverseid\': 421750}, {\'name\': \'Musa Eologena\', \'text\': \'Volare\\nLe creature non possono attaccarti a meno che il loro controllore non paghi {2} per ogni creatura che controlla che ti sta attaccando.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"La sua voce è la giustizia, chiara e implacabile." —Akroma, vendicatrice angelica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422101&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c8d5c21-7027-41b9-b93c-bea45f87abd7\', \'multiverseId\': 422101}, \'multiverseid\': 422101}, {\'name\': \'風生まれの詩神\', \'text\': \'飛行\\nそのコントローラーが、自分がコントロールするあなたを攻撃しているクリーチャー１体につき{2}を支払わないかぎり、クリーチャーではあなたを攻撃できない。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'「彼女の声は、正義であり純潔であり冷酷なのだ。」 ――復讐の天使アクローマ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422452&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d23cdca3-e2ab-44dc-b0cb-8bcf07f3a74f\', \'multiverseId\': 422452}, \'multiverseid\': 422452}, {\'name\': \'Musa Nascida do Vento\', \'text\': \'Voar\\nAs criaturas não podem atacá-lo a menos que seu controlador pague {2} para cada criatura daquele controlador que está atacando você.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"A voz dela é a justiça, clara e incansável." — Akroma, vingadora angélica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422803&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a954c401-70cb-4de7-acfa-929f6b6d3a67\', \'multiverseId\': 422803}, \'multiverseid\': 422803}, {\'name\': \'风生谬思\', \'text\': \'飞行\\n对每个生物而言，除非其操控者为其支付{2}，否则它不能攻击你。\', \'type\': \'生物～精怪\', \'flavor\': \'「她的声音蕴含正义，清晰而不息。」 ～雪仇天使爱若玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421048&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ecb28afb-47fe-4b42-8d16-5bb3697e788a\', \'multiverseId\': 421048}, \'multiverseid\': 421048}]', '[{\'name\': \'Mycosynth-Urquell\', \'text\': \'Wenn der Mycosynth-Urquell ins Spiel kommt oder aus dem Spiel auf einen Friedhof gelegt wird, kannst du deine Bibliothek nach einer Standardland-Karte durchsuchen, sie offen vorzeigen, auf deine Hand nehmen und dann deine Bibliothek mischen.\', \'type\': \'Artefakt\', \'flavor\': \'Das Öl erzeugte das Mycosynth. Das Mycosynth erzeugte das Neue Phyrexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a9e1114-5bee-4ab3-83a6-b9a21dac3a4e\', \'multiverseId\': 421581}, \'multiverseid\': 421581}, {\'name\': \'Manantial de micosintético\', \'text\': \'Cuando el Manantial de micosintético entre al campo de batalla o vaya a un cementerio desde el campo de batalla, puedes buscar en tu biblioteca una carta de tierra básica, mostrarla, ponerla en tu mano y luego barajar tu biblioteca.\', \'type\': \'Artefacto\', \'flavor\': \'El aceite creó el micosintético. El micosintético creó Nueva Pirexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423336&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'081370cb-6833-4cfc-9d6a-8c61bbdcb500\', \'multiverseId\': 423336}, \'multiverseid\': 423336}, {\'name\': \'Source de mycosynthèse\', \'text\': \'Quand la Source de mycosynthèse arrive sur le champ de bataille ou est mise dans un cimetière depuis le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de terrain de base, la révéler, la mettre dans votre main et mélanger ensuite votre bibliothèque.\', \'type\': \'Artefact\', \'flavor\': \'Le pétrole créa la mycosynthèse. La mycosynthèse créa la Nouvelle Phyrexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421932&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'294a9f52-133c-48ad-8875-c85ab2689357\', \'multiverseId\': 421932}, \'multiverseid\': 421932}, {\'name\': \'Sorgente di Micosinti\', \'text\': \'Quando la Sorgente di Micosinti entra nel campo di battaglia o viene messa in un cimitero dal campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta terra base, rivelarla e aggiungerla alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Artefatto\', \'flavor\': "L\'olio creò i micosinti. I micosinti crearono la Nuova Phyrexia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422283&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'691d2cf3-6432-48ef-a2bb-b29bd0793681\', \'multiverseId\': 422283}, \'multiverseid\': 422283}, {\'name\': \'マイコシンスの水源\', \'text\': \'マイコシンスの水源が戦場に出たか戦場から墓地に置かれたとき、あなたはあなたのライブラリーから基本土地・カード１枚を探してもよい。そうしたなら、それを公開してあなたの手札に加え、その後あなたのライブラリーを切り直す。\', \'type\': \'アーティファクト\', \'flavor\': \'油はマイコシンスを生み出した。マイコシンスは新ファイレクシアを生み出した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422634&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e4ca9de-f184-42b0-9856-5bb60a8a7da6\', \'multiverseId\': 422634}, \'multiverseid\': 422634}, {\'name\': \'Fonte do Micossintetizador\', \'text\': \'Quando Fonte do Micossintetizador entra no campo de batalha ou é colocado num cemitério vindo do campo de batalha, você pode procurar um card de terreno básico em seu grimório, revelá-lo, colocá-lo na sua mão e depois embaralhar seu grimório.\', \'type\': \'Artefato\', \'flavor\': \'O óleo criou o micossintetizador. O micossintetizador criou a Nova Phyrexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422985&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b2bdec9-f5b5-4477-a5ad-db5dd3b4536a\', \'multiverseId\': 422985}, \'multiverseid\': 422985}, {\'name\': \'构生菌涌泉\', \'text\': \'当构生菌涌泉进战场或从战场进入坟墓场时，你可以从你的牌库中搜寻一张基本地牌，展示该牌，将它置于你手上，然后将你的牌库洗牌。\', \'type\': \'神器\', \'flavor\': \'烁油带来构生菌。构生菌带来新非瑞克西亚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421230&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'448359b0-4c9e-4d7d-9a07-30731cf9c52a\', \'multiverseId\': 421230}, \'multiverseid\': 421230}]', '[{\'name\': \'Mykoloth\', \'text\': \'Verschlingen 2 (Sowie diese Karte ins Spiel kommt, kannst du eine beliebige Anzahl an Kreaturen opfern. Diese Kreatur kommt mit doppelt so vielen +1/+1-Marken ins Spiel.)\\nErzeuge zu Beginn deines Versorgungssegments für jede +1/+1-Marke auf dem Mykoloth einen 1/1 grünen Saproling-Kreaturenspielstein.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421477&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cdb370f5-9de6-4c64-bfc6-a958958be47f\', \'multiverseId\': 421477}, \'multiverseid\': 421477}, {\'name\': \'Micolot\', \'text\': \'Devorar 2. (En cuanto esta carta entre al campo de batalla, puedes sacrificar cualquier cantidad de criaturas. Esta criatura entra al campo de batalla con el doble de esa cantidad de contadores +1/+1 sobre ella.)\\nAl comienzo de tu mantenimiento, crea una ficha de criatura Saprolín verde 1/1 por cada contador +1/+1 sobre el Micolot.\', \'type\': \'Criatura — Hongo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'54691fb3-9459-4e8e-9cf8-74e8d6c86fd3\', \'multiverseId\': 423232}, \'multiverseid\': 423232}, {\'name\': \'Mycoloth\', \'text\': "Dévorement 2 (Au moment où cette créature arrive sur le champ de bataille, vous pouvez sacrifier n\'importe quel nombre de créatures. Cette créature arrive sur le champ de bataille avec deux fois ce nombre de marqueurs +1/+1 sur elle.)\\nAu début de votre entretien, créez un jeton de créature 1/1 verte Saprobionte pour chaque marqueur +1/+1 sur le Mycoloth.", \'type\': \'Créature : fongus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421828&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e2789c0-06d4-4c4f-bda2-df1d94dea196\', \'multiverseId\': 421828}, \'multiverseid\': 421828}, {\'name\': \'Fungoloth\', \'text\': "Divorare 2 (Mentre questa creatura entra nel campo di battaglia, puoi sacrificare un qualsiasi numero di creature. Entra nel campo di battaglia con il doppio di segnalini +1/+1.)\\nAll\'inizio del tuo mantenimento, crea una pedina creatura Saprolingio 1/1 verde per ogni segnalino +1/+1 sul Fungoloth.", \'type\': \'Creatura — Fungus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422179&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dad5ee74-f59e-4882-b394-620ac5a50d1e\', \'multiverseId\': 422179}, \'multiverseid\': 422179}, {\'name\': \'マイコロス\', \'text\': \'貪食２（これが戦場に出るに際し、あなたは望む数のクリーチャーを生け贄に捧げてもよい。このクリーチャーは、その数の２倍に等しい＋１/＋１カウンターが置かれた状態で戦場に出る。）\\nあなたのアップキープの開始時に、マイコロスの上に置かれている＋１/＋１カウンター１個につき、緑の１/１の苗木・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422530&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec4602a9-44cc-474d-b1e5-5739bf5c3938\', \'multiverseId\': 422530}, \'multiverseid\': 422530}, {\'name\': \'Micoloth\', \'text\': \'Devorar 2 (Conforme esta criatura entra no campo de batalha, você pode sacrificar um número qualquer de criaturas. Esta criatura entra no campo de batalha com o dobro daquela quantidade de marcadores +1/+1.)\\nNo início de sua manutenção, crie uma ficha de criatura verde 1/1 do tipo Saprófita para cada marcador +1/+1 em Micoloth.\', \'type\': \'Criatura — Fungo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422881&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fffc19d3-5e54-45a6-91a2-a9079016790e\', \'multiverseId\': 422881}, \'multiverseid\': 422881}, {\'name\': \'真菌洛西\', \'text\': \'吞噬2（于该生物进战场时，你可以牺牲任意数量的生物。此生物进战场时上面有两倍于该数量的+1/+1指示物。）\\n在你的维持开始时，真菌洛西上每有一个+1/+1指示物，便派出一个1/1绿色腐生物衍生生物。\', \'type\': \'生物～真菌\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421126&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'752acb55-aafb-4d47-8001-b89f40987472\', \'multiverseId\': 421126}, \'multiverseid\': 421126}]', '[{\'name\': \'Myr-Kampfkugel\', \'text\': \'Wenn die Myr-Kampfkugel ins Spiel kommt, erzeuge vier 1/1 farblose Myr-Artefaktkreaturenspielsteine.\\nImmer wenn die Myr-Kampfkugel angreift, kannst du X ungetappte Myr, die du kontrollierst, tappen. Falls du dies tust, erhält die Myr-Kampfkugel +X/+0 bis zum Ende des Zuges und fügt dem verteidigenden Spieler X Schadenspunkte zu.\', \'type\': \'Artefaktkreatur — Myr, Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421582&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9df07f8d-b918-4a53-9027-fa08169b5b8a\', \'multiverseId\': 421582}, \'multiverseid\': 421582}, {\'name\': \'Esfera de batalla myr\', \'text\': \'Cuando la Esfera de batalla myr entre al campo de batalla, crea cuatro fichas de criatura artefacto Myr incoloras 1/1.\\nSiempre que la Esfera de batalla myr ataque, puedes girar X Myr enderezados que controles. Si lo haces, la Esfera de batalla myr obtiene +X/+0 hasta el final del turno y hace X puntos de daño al jugador defensor.\', \'type\': \'Criatura artefacto — Constructo myr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423337&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bacdbd48-5d55-47bb-98ff-358c37636363\', \'multiverseId\': 423337}, \'multiverseid\': 423337}, {\'name\': \'Sphère de bataille myr\', \'text\': "Quand la Sphère de bataille myr arrive sur le champ de bataille, créez quatre jetons de créature-artefact 1/1 incolore Myr.\\nÀ chaque fois que la Sphère de bataille myr attaque, vous pouvez engager X myrs dégagés que vous contrôlez. Si vous faites ainsi, la Sphère de bataille myr gagne +X/+0 jusqu\'à la fin du tour et inflige X blessures au joueur défenseur.", \'type\': \'Créature-artefact : myr et construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421933&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5ba9d520-5682-4790-b432-22eda333de88\', \'multiverseId\': 421933}, \'multiverseid\': 421933}, {\'name\': \'Sfera da Battaglia Myr\', \'text\': \'Quando la Sfera da Battaglia Myr entra nel campo di battaglia, crea quattro pedine creatura artefatto Myr 1/1 incolori.\\nOgniqualvolta la Sfera da Battaglia Myr attacca, puoi TAPpare X Myr STAPpati che controlli. Se lo fai, la Sfera da Battaglia Myr prende +X/+0 fino alla fine del turno e infligge X danni al giocatore in difesa.\', \'type\': \'Creatura Artefatto — Costrutto Myr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422284&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9c58b93-1ac3-44d0-baac-1b0375553fb4\', \'multiverseId\': 422284}, \'multiverseid\': 422284}, {\'name\': \'マイアの戦闘球\', \'text\': \'マイアの戦闘球が戦場に出たとき、無色の１/１のマイア・アーティファクト・クリーチャー・トークンを４体生成する。\\nマイアの戦闘球が攻撃するたび、あなたはあなたがコントロールするアンタップ状態のマイアをＸ体タップしてもよい。そうしたなら、ターン終了時まで、マイアの戦闘球は＋Ｘ/＋０の修整を受けるとともに、これは防御プレイヤーにＸ点のダメージを与える。\', \'type\': \'アーティファクト・クリーチャー — マイア・構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422635&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'50b5ae93-9b92-475d-8232-a52de826cf78\', \'multiverseId\': 422635}, \'multiverseid\': 422635}, {\'name\': \'Esfera de Batalha Myr\', \'text\': \'Quando Esfera de Batalha Myr entrar no campo de batalha, crie quatro fichas de criatura artefato incolores 1/1 do tipo Myr.\\nToda vez que Esfera de Batalha Myr ataca, você pode virar X Myr desvirados que você controla. Se fizer isso, Esfera de Batalha Myr recebe +X/+0 até o final do turno e causa X pontos de dano ao jogador defensor.\', \'type\': \'Criatura Artefato — Myr Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422986&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fb99cca-a934-4b1c-88cd-4112cd2ce7f8\', \'multiverseId\': 422986}, \'multiverseid\': 422986}, {\'name\': \'秘耳斗球\', \'text\': \'当秘耳斗球进战场时，派出四个1/1无色秘耳衍生神器生物。\\n每当秘耳斗球攻击时，你可以横置X个由你操控且未横置的秘耳。若你如此作，则秘耳斗球得+X/+0直到回合结束，并对防御牌手造成X点伤害。\', \'type\': \'神器生物～秘耳／组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421231&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e10a0f1a-e7f0-47fd-9463-d6db7f444ee2\', \'multiverseId\': 421231}, \'multiverseid\': 421231}]', '[{\'name\': \'Myr-Wiederholer\', \'text\': \'Wenn der Myr-Wiederholer stirbt, bringe eine andere Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Artefaktkreatur — Myr\', \'flavor\': \'Der Mephidross gibt seine Schätze gerne her … solange du deren Platz einnimmst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421583&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f53ea188-fda7-4ca5-9169-cb3442f64fca\', \'multiverseId\': 421583}, \'multiverseid\': 421583}, {\'name\': \'Recuperador myr\', \'text\': \'Cuando el Recuperador myr muera, regresa otra carta de artefacto objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura artefacto — Myr\', \'flavor\': \'El Méfidros entrega sus tesoros fácilmente... siempre que tomes su lugar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423338&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8edf8876-d7cd-49b1-8aa3-5d3cc963964a\', \'multiverseId\': 423338}, \'multiverseid\': 423338}, {\'name\': \'Récupérateur Myr\', \'text\': "Quand le Récupérateur Myr meurt, renvoyez une autre carte d\'artefact ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature-artefact : myr\', \'flavor\': \'Mephidross vous abandonne aisément ses richesses... si vous prenez leur place.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421934&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7878605b-2e71-45ce-ac59-27ffacf26096\', \'multiverseId\': 421934}, \'multiverseid\': 421934}, {\'name\': \'Myr da Riporto\', \'text\': "Quando il Myr da Riporto muore, riprendi in mano un\'altra carta artefatto bersaglio dal tuo cimitero.", \'type\': \'Creatura Artefatto — Myr\', \'flavor\': \'Mephidross cede facilmente i propri tesori... a patto che tu prenda il loro posto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422285&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34dce9fb-48a5-4ad7-99c6-096f955ea61e\', \'multiverseId\': 422285}, \'multiverseid\': 422285}, {\'name\': \'マイアの回収者\', \'text\': \'マイアの回収者が死亡したとき、あなたの墓地から他のアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'アーティファクト・クリーチャー — マイア\', \'flavor\': \'メフィドロスは宝の山だ……お前がそこにいられる間は。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422636&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f9725eb-4f77-4d9f-8cd6-d5b8be6789a8\', \'multiverseId\': 422636}, \'multiverseid\': 422636}, {\'name\': \'Myr de Busca\', \'text\': \'Quando Myr de Busca morrer, devolva outro card de artefato alvo de seu cemitério para sua mão.\', \'type\': \'Criatura Artefato — Myr\', \'flavor\': \'Mefidross desiste dos tesouros com facilidade... desde que você fique no lugar deles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422987&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9836348f-7fa4-4573-95b9-c9283a839d37\', \'multiverseId\': 422987}, \'multiverseid\': 422987}, {\'name\': \'回收秘耳\', \'text\': \'当回收秘耳死去时，将另一张目标神器牌从你的坟墓场移回你手上。\', \'type\': \'神器生物～秘耳\', \'flavor\': \'蔓非沼乐于提供宝藏. . . 只要你乐于顶替其位置。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421232&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6e9bb041-d41a-44fd-ad83-39a62f9e73e4\', \'multiverseId\': 421232}, \'multiverseid\': 421232}]', '[{\'name\': \'Mysteriöse Ablehnung\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl. Sein Beherrscher kann zu Beginn des Versorgungssegments des nächsten Zuges bis zu zwei Karten ziehen.\\nZiehe zu Beginn des Versorgungssegments des nächsten Zuges eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421402&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'98c7fe4f-75d2-4b36-abde-ed253bc35074\', \'multiverseId\': 421402}, \'multiverseid\': 421402}, {\'name\': \'Constricción arcana\', \'text\': \'Contrarresta el hechizo objetivo. Su controlador puede robar hasta dos cartas al comienzo del mantenimiento del próximo turno.\\nTú robas una carta al comienzo del mantenimiento del próximo turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423157&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ada52e9e-29d9-48dc-b128-f0d85ef55103\', \'multiverseId\': 423157}, \'multiverseid\': 423157}, {\'name\': \'Déni des arcanes\', \'text\': "Contrecarrez le sort ciblé. Son contrôleur peut piocher jusqu\'à deux cartes au début de l\'entretien du prochain tour.\\nVous piochez une carte au début de l\'entretien du prochain tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0e7dde7-dec4-4df9-aefc-f75d231573f8\', \'multiverseId\': 421753}, \'multiverseid\': 421753}, {\'name\': \'Privazione Arcana\', \'text\': "Neutralizza una magia bersaglio. Il suo controllore può pescare fino a due carte all\'inizio del mantenimento del prossimo turno.\\nPesca una carta all\'inizio del mantenimento del prossimo turno.", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422104&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da79ca73-ff5e-4cb5-805f-fd06e8e61a9e\', \'multiverseId\': 422104}, \'multiverseid\': 422104}, {\'name\': \'秘儀の否定\', \'text\': \'呪文１つを対象とし、それを打ち消す。それのコントローラーは、次のターンのアップキープの開始時に、カードを最大２枚引いてもよい。\\nあなたは、次のターンのアップキープの開始時に、カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422455&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6978550-a90b-4a7e-b06a-875f69076d8d\', \'multiverseId\': 422455}, \'multiverseid\': 422455}, {\'name\': \'Contradição Arcana\', \'text\': \'Anule a mágica alvo. Seu controlador pode comprar até dois cards no início da manutenção do próximo turno.\\nCompre um card no início da manutenção do próximo turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422806&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b5e4c6e-b307-4c6e-93e1-a79e188aa742\', \'multiverseId\': 422806}, \'multiverseid\': 422806}, {\'name\': \'玄秘否定\', \'text\': \'反击目标咒语。在下一个回合维持开始时，其操控者可以抓至多两张牌。\\n在下一个回合维持开始时，你抓一张牌。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421051&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e7de69d1-e60a-49d5-8725-31cdd47f6752\', \'multiverseId\': 421051}, \'multiverseid\': 421051}]', '[{\'name\': \'Mysteriöses Sanktum\', \'text\': \'Das Mysteriöse Sanktum kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W}, {U} oder {B}.\', \'type\': \'Land\', \'flavor\': \'„Wir müssen uns auf unser eigenes Wissen verlassen, nicht auf das Dogma der Suchenden oder das Gemurmel der Sphingen." —Tullus von Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421600&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'289d4996-29bc-4573-ab20-01c688e46d01\', \'multiverseId\': 421600}, \'multiverseid\': 421600}, {\'name\': \'Santuario arcano\', \'text\': \'El Santuario arcano entra al campo de batalla girado.\\n{T}: Agrega {W}, {U} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"Debemos confiar en nuestro conocimiento, no en el dogma de los buscadores o los balbuceos de las esfinges". —Tullus de Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423355&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a39bc2ce-709a-45b4-b750-4d1e3f78da3e\', \'multiverseId\': 423355}, \'multiverseid\': 423355}, {\'name\': \'Sanctuaire ésotérique\', \'text\': \'Le Sanctuaire ésotérique arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {W}, {U} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': \'« Nous devons nous fier à notre connaissance, pas au dogme des chercheurs ou aux murmures des sphinx. » —Tullus de Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421951&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4670727-9dd0-47ee-a4c0-b4d077f096b9\', \'multiverseId\': 421951}, \'multiverseid\': 421951}, {\'name\': \'Santuario Arcano\', \'text\': \'Il Santuario Arcano entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W}, {U} o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'"Dobbiamo confidare nelle nostre conoscenze, non nel dogma dei cercatori o nei mormorii delle sfingi." —Tullus di Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422302&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cada75af-35bd-47eb-b915-b0ad21de3468\', \'multiverseId\': 422302}, \'multiverseid\': 422302}, {\'name\': \'秘儀の聖域\', \'text\': \'秘儀の聖域はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'「我々は求道者の教義やスフィンクスのぼやきなどではなく、自らの知識を礎としなければならない。」 ――パランディウスのタラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422653&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d9d51799-c381-4ccc-87d3-77e412996ce5\', \'multiverseId\': 422653}, \'multiverseid\': 422653}, {\'name\': \'Santuário Arcano\', \'text\': \'Santuário Arcano entra no campo de batalha virado.\\n{T}: Adicione {W}, {U} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"Precisamos contar com nosso próprio conhecimento, não com o dogma dos buscadores nem com a ladainha das esfinges." — Tullus de Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423004&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'426a8af8-6554-4aae-9121-9a04465d7c38\', \'multiverseId\': 423004}, \'multiverseid\': 423004}, {\'name\': \'玄秘圣所\', \'text\': \'玄秘圣所须横置进战场。\\n{T}：加{W}，{U}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'「我们得依赖自己的知识，而不是致知者的文件、史芬斯的呢喃。」 ～帕连迪的突卢兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421249&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0d91452-fa20-495a-8d23-48db2da511d1\', \'multiverseId\': 421249}, \'multiverseid\': 421249}]', '[{\'name\': \'Mystisches Kloster\', \'text\': \'Das Mystische Kloster kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U}, {R} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Als er gefragt wurde, wie viele Wege zur Erleuchtung führen, trat der Mönch gegen einen Sandhaufen. „Zähl nach", sagte er lächelnd, „und dann finde weitere Körner."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421629&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6552993-50ca-4822-a6f7-41f98aaee87c\', \'multiverseId\': 421629}, \'multiverseid\': 421629}, {\'name\': \'Monasterio místico\', \'text\': \'El Monasterio místico entra al campo de batalla girado.\\n{T}: Agrega {U}, {R} o {W} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Cuando se le preguntó cuántos caminos llevaban a la iluminación, el monje dio una patada a un montón de arena. "Cuenta", dijo con una sonrisa, "y luego busca más granos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423384&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'865d2215-cbbf-456d-a4ae-3d2cecb2d33c\', \'multiverseId\': 423384}, \'multiverseid\': 423384}, {\'name\': \'Monastère mystique\', \'text\': \'Le Monastère mystique arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {U}, {R} ou {W} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Quand on lui demanda combien de chemins mènent à l\'illumination, le moine frappa dans un tas de sable. « Comptez, dit-il en souriant, et ajoutez d\'autres grains. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421980&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5a96d179-26c8-40af-ba22-4e0b271f2679\', \'multiverseId\': 421980}, \'multiverseid\': 421980}, {\'name\': \'Monastero Mistico\', \'text\': \'Il Monastero Mistico entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U}, {R} o {W} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Quando gli chiesero quante vie conducessero all\\\'illuminazione, il monaco calciò un mucchio di sabbia. "Conta", sorrise, "e poi cerca altri granelli."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422331&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b57ec9d-35f6-4134-a2a1-517b9f44f706\', \'multiverseId\': 422331}, \'multiverseid\': 422331}, {\'name\': \'神秘の僧院\', \'text\': \'神秘の僧院はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}か{R}か{W}を加える。\', \'type\': \'土地\', \'flavor\': \'悟りの境地に至る道の数について問われた僧侶は、砂の山を蹴った。「数えてみなさい。」と彼は微笑みながら言った。「それから、さらに多くの砂粒を用意することです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422682&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'571a0130-f4b7-41f1-9f2f-ad262fc78113\', \'multiverseId\': 422682}, \'multiverseid\': 422682}, {\'name\': \'Monastério Místico\', \'text\': \'Monastério Místico entra no campo de batalha virado.\\n{T}: Adicione {U}, {R} ou {W} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Quando lhe perguntaram quantos caminhos levam à iluminação, o monge chutou um monte de terra. "Conte", disse ele sorrindo, "e depois encontre mais grãos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423033&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f71718d0-a417-473f-9d78-fd7acaa2555b\', \'multiverseId\': 423033}, \'multiverseid\': 423033}, {\'name\': \'神秘寺院\', \'text\': \'神秘寺院须横置进战场。\\n{T}：加{U}，{R}或{W}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'「启悟之道共几何？」和尚闻言踢散跟前沙堆。「数数吧，」他微笑道，「然后找出更多沙粒。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421278&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1263f58-b215-45e8-957e-a00d0574416f\', \'multiverseId\': 421278}, \'multiverseid\': 421278}]', '[{\'name\': \'Nachahmer der Ahnen\', \'text\': \'Du kannst den Nachahmer der Ahnen als eine Kopie einer beliebigen Kreatur im Spiel ins Spiel kommen lassen, außer dass er „Zu Beginn deines Versorgungssegments und falls diese Kreatur kein Spielstein ist, erzeuge einen Spielstein, der eine Kopie dieser Kreatur ist" hat.\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7773b6fb-dd7b-452f-b2c5-7fc738165a7e\', \'multiverseId\': 421535}, \'multiverseid\': 421535}, {\'name\': \'Mímico progenitor\', \'text\': \'Puedes hacer que el Mímico progenitor entre al campo de batalla como una copia de cualquier criatura en el campo de batalla, excepto que gana "Al comienzo de tu mantenimiento, si esta criatura no es una ficha, crea una ficha que es una copia de esta criatura".\', \'type\': \'Criatura — Metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423290&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a4329d5-7456-485f-9617-54cd08c6976a\', \'multiverseId\': 423290}, \'multiverseid\': 423290}, {\'name\': \'Mimique progéniteur\', \'text\': "Vous pouvez faire que le Mimique progéniteur arrive sur le champ de bataille comme une copie de n\'importe quelle créature sur le champ de bataille, excepté qu\'il acquiert « Au début de votre entretien, si cette créature n\'est pas un jeton, créez un jeton qui est une copie de cette créature. »", \'type\': \'Créature : changeforme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421886&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b4ac01c-06b9-40eb-a174-0916d37fd10c\', \'multiverseId\': 421886}, \'multiverseid\': 421886}, {\'name\': \'Mimic Progenitore\', \'text\': \'Puoi far entrare il Mimic Progenitore nel campo di battaglia come una copia di qualsiasi creatura sul campo di battaglia, tranne che ha "All\\\'inizio del tuo mantenimento, se questa creatura non è una pedina, crea una pedina che è una copia di questa creatura".\', \'type\': \'Creatura — Polimorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422237&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'073d18ca-1a4e-43de-98b7-8a93bf13182b\', \'multiverseId\': 422237}, \'multiverseid\': 422237}, {\'name\': \'前駆ミミック\', \'text\': \'あなたは前駆ミミックを、これが「あなたのアップキープの開始時に、このクリーチャーがトークンでない場合、このクリーチャーのコピーであるトークンを１体生成する。」を得ることを除き、戦場にあるクリーチャー１体のコピーとして戦場に出してもよい。\', \'type\': \'クリーチャー — 多相の戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422588&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cdee868d-93a5-4e1f-b7f4-8f45ce9a424d\', \'multiverseId\': 422588}, \'multiverseid\': 422588}, {\'name\': \'Imitação do Progenitor\', \'text\': \'Você pode fazer com que Imitação do Progenitor entre no campo de batalha como uma cópia de qualquer criatura no campo de batalha, exceto que ela ganha "No início de sua manutenção, se esta criatura não for uma ficha, crie uma ficha que seja uma cópia desta criatura."\', \'type\': \'Criatura — Metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422939&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e53523d-5b07-42bb-897c-d7771bf4e396\', \'multiverseId\': 422939}, \'multiverseid\': 422939}, {\'name\': \'先祖拟妖\', \'text\': \'你可以使先祖拟妖当成战场上任一生物的复制品来进入战场，但它获得「在你的维持开始时，若此生物不是衍生物，则派出一个衍生物，此衍生物为此生物的复制品。」\', \'type\': \'生物～变形兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421184&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3741b9bc-7c14-46b0-8f83-5de5ac1f202e\', \'multiverseId\': 421184}, \'multiverseid\': 421184}]', "[{'name': 'Nachtstahl-Zitadelle', 'text': 'Unzerstörbar\\n{T}: Erhöhe deinen Manavorrat um {C}.', 'type': 'Artefakt, Land', 'flavor': 'Bauten aus Nachtstahl werden weder durch Angriffe noch durch Alterung geschwächt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421607&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f13c5193-ba6d-42b3-867f-80eaf6983d44', 'multiverseId': 421607}, 'multiverseid': 421607}, {'name': 'Ciudadela de acero oscuro', 'text': 'Indestructible.\\n{T}: Agrega {C} a tu reserva de maná.', 'type': 'Tierra artefacto', 'flavor': 'Las estructuras construidas con acero oscuro no ceden ante el asalto ni ante el paso del tiempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423362&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0ac94c77-57b3-4f3a-bedb-aea5eea4b3e7', 'multiverseId': 423362}, 'multiverseid': 423362}, {'name': 'Citadelle de sombracier', 'text': 'Indestructible\\n{T} : Ajoutez {C} à votre réserve.', 'type': 'Terrain-artefact', 'flavor': 'Les édifices en sombracier défient les assauts et le temps.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421958&type=card', 'language': 'French', 'identifiers': {'scryfallId': '221e2cb0-04d2-43d8-a7fd-273d9c219b8a', 'multiverseId': 421958}, 'multiverseid': 421958}, {'name': 'Roccaforte di Darksteel', 'text': 'Indistruttibile\\n{T}: Aggiungi {C} alla tua riserva di mana.', 'type': 'Terra Artefatto', 'flavor': 'Le strutture di darksteel sono impervie sia agli attacchi sia al passare del tempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422309&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b3f57bd1-0c50-4d7c-8ad2-3fe408519ac4', 'multiverseId': 422309}, 'multiverseid': 422309}, {'name': 'ダークスティールの城塞', 'text': '破壊不能\\n{T}：あなたのマナ・プールに{C}を加える。', 'type': 'アーティファクト・土地', 'flavor': 'ダークスティールで造られた構造物は、攻撃にも年月にも屈することはない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422660&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5f7895bb-882d-407e-aff2-0718cc3f792d', 'multiverseId': 422660}, 'multiverseid': 422660}, {'name': 'Cidadela de Aço Negro', 'text': 'Indestrutível\\n{T}: Adicione {C} à sua reserva de mana.', 'type': 'Terreno Artefato', 'flavor': 'As estruturas construídas de aço negro não cedem a ataques nem ao tempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423011&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f05fd172-db5f-42d2-a108-46ca2b1fdd8c', 'multiverseId': 423011}, 'multiverseid': 423011}, {'name': '玄铁殿堂', 'text': '不灭\\n{T}：加{C}到你的法术力池中。', 'type': '神器地', 'flavor': '玄铁所建之物，不受战事侵袭，不留岁月痕迹。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421256&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '31ab67c7-6cf4-42d4-b80e-c86a7e12ae94', 'multiverseId': 421256}, 'multiverseid': 421256}]", '[{\'name\': \'Nachtstahlbarren\', \'text\': \'Unzerstörbar\\n{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'„Er spiegelt die Reinheit des alten Mirrodin wider." —Koth vom Hammerclan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421569&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5ac9884-6cec-4c21-9012-da586a605f37\', \'multiverseId\': 421569}, \'multiverseid\': 421569}, {\'name\': \'Lingote de acero oscuro\', \'text\': \'Indestructible.\\n{T}: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'"Refleja la pureza de Mirrodin-de-antes". —Koth del Martillo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423324&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ca072d7-6f99-4a6e-916c-bc51215be553\', \'multiverseId\': 423324}, \'multiverseid\': 423324}, {\'name\': \'Lingot de sombracier\', \'text\': \'Indestructible\\n{T} : Ajoutez un mana de la couleur de votre choix à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "« Il reflète la pureté du Mirrodin d\'autrefois. » —Koth du Marteau", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421920&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27b627b5-690a-4a47-85ab-8c6d2dc46bcc\', \'multiverseId\': 421920}, \'multiverseid\': 421920}, {\'name\': \'Lingotto di Darksteel\', \'text\': \'Indistruttibile\\n{T}: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'"Riflette la purezza del Mirrodin-che-fu." —Koth del Martello\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422271&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea3932d3-f705-4b9e-b688-b4026fc7e516\', \'multiverseId\': 422271}, \'multiverseid\': 422271}, {\'name\': \'ダークスティールの鋳塊\', \'text\': \'破壊不能\\n{T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'「それはかつてのミラディンの清純さを表している。」 ――槌のコス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422622&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'048ae973-fc68-439e-a113-4c4a23105933\', \'multiverseId\': 422622}, \'multiverseid\': 422622}, {\'name\': \'Lingote de Aço Negro\', \'text\': \'Indestrutível\\n{T}: Adicione um mana de qualquer cor à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'"Ele reflete a pureza da \\\'Mirrodin de Outrora\\\'." — Koth do Martelo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422973&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'de19422c-970b-4438-be77-9940910ce1e4\', \'multiverseId\': 422973}, \'multiverseid\': 422973}, {\'name\': \'玄铁锭\', \'text\': \'不灭\\n{T}：加一点任意颜色的法术力到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'「它照映出过往秘罗地的纯洁。」 ～锤族的寇斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421218&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'afeea1bf-79a7-4775-8e95-6e0aa122d006\', \'multiverseId\': 421218}, \'multiverseid\': 421218}]', '[{\'name\': \'Nath aus dem Güldenlaubwald\', \'text\': \'Zu Beginn deines Versorgungssegments kannst du einen Gegner deiner Wahl eine zufällig bestimmte Karte abwerfen lassen.\\nImmer wenn ein Gegner eine Karte abwirft, kannst du einen 1/1 grünen Elf-Krieger-Kreaturspielstein erzeugen.\', \'type\': \'Legendäre Kreatur — Elf, Krieger\', \'flavor\': \'Ein wilder Jäger mit den Manieren eines Prinzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421532&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20c94d77-ac55-4972-82dd-5db30d950824\', \'multiverseId\': 421532}, \'multiverseid\': 421532}, {\'name\': \'Nath de Hojas Doradas\', \'text\': \'Al comienzo de tu mantenimiento, puedes hacer que el oponente objetivo descarte una carta al azar.\\nSiempre que un oponente descarte una carta, puedes crear una ficha de criatura Guerrero Elfo verde 1/1.\', \'type\': \'Criatura legendaria — Guerrero elfo\', \'flavor\': \'Un cazador salvaje con la semblanza de un príncipe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423287&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b0084d7-8d65-4268-956a-3867a29b946b\', \'multiverseId\': 423287}, \'multiverseid\': 423287}, {\'name\': \'Narth de Feuilledor\', \'text\': "Au début de votre entretien, vous pouvez faire que l\'adversaire ciblé se défausse d\'une carte au hasard.\\nÀ chaque fois qu\'un adversaire se défausse d\'une carte, vous pouvez créer un jeton de créature 1/1 verte Elfe et Guerrier.", \'type\': \'Créature légendaire : elfe et guerrier\', \'flavor\': "Un chasseur sauvage avec l\'attitude d\'un prince.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421883&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f10ea6b-d9c0-4bf1-b86c-3d13d543ac53\', \'multiverseId\': 421883}, \'multiverseid\': 421883}, {\'name\': \'Nath di Foglia Dorata\', \'text\': "All\'inizio del tuo mantenimento, puoi far scartare una carta a caso a un avversario bersaglio.\\nOgniqualvolta un avversario scarta una carta, puoi creare una pedina creatura Guerriero Elfo 1/1 verde.", \'type\': \'Creatura Leggendaria — Guerriero Elfo\', \'flavor\': \'Un cacciatore selvaggio col portamento di un principe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422234&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d5b1423d-eeda-4714-b3f1-41f8d8c4f964\', \'multiverseId\': 422234}, \'multiverseid\': 422234}, {\'name\': \'光り葉のナース\', \'text\': \'あなたのアップキープの開始時に、対戦相手１人を対象とする。あなたは「そのプレイヤーは、カード１枚を無作為に選んで捨てる。」を選んでもよい。\\n対戦相手がカードを１枚捨てるたび、あなたは緑の１/１のエルフ・戦士・クリーチャー・トークンを１体生成してもよい。\', \'type\': \'伝説のクリーチャー — エルフ・戦士\', \'flavor\': \'王子の辛抱を有する獰猛な狩人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422585&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b0b2f5a-127d-4f0c-88e3-c64695addbee\', \'multiverseId\': 422585}, \'multiverseid\': 422585}, {\'name\': "Nath de Folha D\'Ouro", \'text\': \'No início de sua manutenção, você pode fazer com que o oponente alvo descarte um card aleatoriamente.\\nToda vez que um oponente descarta um card, você pode criar uma ficha de criatura verde 1/1 do tipo Elfo Guerreiro.\', \'type\': \'Criatura Lendária — Elfo Guerreiro\', \'flavor\': \'Um caçador selvagem com o porte de um príncipe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422936&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6847b7f8-dee5-470c-9a92-fb7d77c36e28\', \'multiverseId\': 422936}, \'multiverseid\': 422936}, {\'name\': \'金叶的纳斯\', \'text\': \'在你的维持开始时，你可以令目标对手随机弃一张牌。\\n每当一位对手弃一张牌时，你可以派出一个1/1绿色妖精／战士衍生生物。\', \'type\': \'传奇生物～妖精／战士\', \'flavor\': \'拥有王子气度的不羁猎人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421181&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'854c870a-9be8-4a70-a472-28ec34a82fae\', \'multiverseId\': 421181}, \'multiverseid\': 421181}]', '[{\'name\': \'Necroplasma\', \'text\': \'Lege zu Beginn deines Versorgungssegments eine +1/+1-Marke auf das Necroplasma.\\nZerstöre zu Beginn deines Endsegments jede Kreatur, deren umgewandelte Manakosten gleich der Anzahl an +1/+1-Marken auf dem Necroplasma sind.\\nAusgraben 2 (Falls du eine Karte ziehen würdest, kannst du stattdessen diese Karte aus deinem Friedhof auf deine Hand zurückbringen und die obersten zwei Karten deiner Bibliothek auf deinen Friedhof legen.)\', \'type\': \'Kreatur — Schlammwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421434&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56911a31-ef22-484d-b576-d32db330081d\', \'multiverseId\': 421434}, \'multiverseid\': 421434}, {\'name\': \'Necroplasma\', \'text\': \'Al comienzo de tu mantenimiento, pon un contador +1/+1 sobre el Necroplasma.\\nAl comienzo de tu paso final, destruye cada criatura con un coste de maná convertido igual a la cantidad de contadores +1/+1 sobre el Necroplasma.\\nDragar 2. (Si fueras a robar una carta, en vez de eso puedes regresar esta carta de tu cementerio a tu mano y poner las dos primeras cartas de tu biblioteca en tu cementerio.)\', \'type\': \'Criatura — Cieno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423189&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a5919d6-b28c-404e-b4fa-f04da1335579\', \'multiverseId\': 423189}, \'multiverseid\': 423189}, {\'name\': \'Nécroplasme\', \'text\': \'Au début de votre entretien, mettez un marqueur +1/+1 sur le Nécroplasme.\\nAu début de votre étape de fin, détruisez chaque créature avec un coût converti de mana égal au nombre de marqueurs +1/+1 sur le Nécroplasme.\\nDragage 2 (Si vous deviez piocher une carte, à la place vous pouvez renvoyer cette carte depuis votre cimetière dans votre main et mettre les deux cartes du dessus de votre bibliothèque dans votre cimetière.)\', \'type\': \'Créature : limon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421785&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00c7f433-09d5-40af-b70a-8ccf1ed21531\', \'multiverseId\': 421785}, \'multiverseid\': 421785}, {\'name\': \'Necroplasma\', \'text\': "All\'inizio del tuo mantenimento, metti un segnalino +1/+1 sul Necroplasma.\\nAll\'inizio della tua sottofase finale, distruggi ogni creatura con costo di mana convertito pari al numero di segnalini +1/+1 sul Necroplasma.\\nDragare 2 (Se stai per pescare una carta, puoi invece riprendere in mano questa carta dal tuo cimitero e mettere nel tuo cimitero le prime due carte del tuo grimorio.)", \'type\': \'Creatura — Melma\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422136&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2ea61045-7855-444f-b8e4-45f4ed4f4e26\', \'multiverseId\': 422136}, \'multiverseid\': 422136}, {\'name\': \'屍の原形質\', \'text\': \'あなたのアップキープの開始時に、屍の原形質の上に＋１/＋１カウンターを１個置く。\\nあなたの終了ステップの開始時に、点数で見たマナ・コストが屍の原形質の上にある＋１/＋１カウンターの総数に等しい各クリーチャーをそれぞれ破壊する。\\n発掘２（あなたがカードを引くなら、代わりに、あなたはあなたの墓地からこのカードをあなたの手札に戻し、あなたのライブラリーの一番上から２枚のカードをあなたの墓地に置いてもよい。）\', \'type\': \'クリーチャー — ウーズ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422487&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f95c5c7b-e05b-4b92-a3f6-a9dc6fc2ce58\', \'multiverseId\': 422487}, \'multiverseid\': 422487}, {\'name\': \'Necroplasma\', \'text\': \'No início de sua manutenção, coloque um marcador +1/+1 em Necroplasma.\\nNo início da sua etapa final, destrua cada criatura com custo de mana convertido igual ao número de marcadores +1/+1 em Necroplasma.\\nEscavação 2 (Se você compraria um card, em vez disso, você pode devolver este card de seu cemitério para sua mão e colocar os dois cards do topo de seu grimório em seu cemitério.)\', \'type\': \'Criatura — Lodo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422838&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7ee9948b-cd3e-4fc1-88b3-b2fe283e46e1\', \'multiverseId\': 422838}, \'multiverseid\': 422838}, {\'name\': \'死灵原浆\', \'text\': \'在你的维持开始时，在死灵原浆上放置一个+1/+1指示物。\\n在你的结束步骤开始时，消灭所有总法术力费用等同于死灵原浆上+1/+1指示物数量的生物。\\n发掘2（若你将抓一张牌，则你可以改为将此牌从你的坟墓场移回你手上，并将你牌库顶的两张牌置入你的坟墓场。）\', \'type\': \'生物～流浆\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421083&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c44b2cb-3b33-4ffc-9167-f44158897279\', \'multiverseId\': 421083}, \'multiverseid\': 421083}]', '[{\'name\': \'Nekrogenese\', \'text\': \'{2}: Schicke eine Kreaturenkarte deiner Wahl aus einem Friedhof ins Exil. Erzeuge einen 1/1 grünen Saproling-Kreaturenspielstein.\', \'type\': \'Verzauberung\', \'flavor\': \'„Dieses Gekrümme könnte andeuten, dass ein Leben endet oder ein anderes beginnt. Jedenfalls würde ich es lieber in Ruhe lassen." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421534&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6902d24d-7366-4c1e-bf31-ba2ff8c94c68\', \'multiverseId\': 421534}, \'multiverseid\': 421534}, {\'name\': \'Necrogénesis\', \'text\': \'{2}: Exilia la carta de criatura objetivo de un cementerio. Crea una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Encantamiento\', \'flavor\': \'"Eso pueden ser los serpenteos de una vida que se acaba o una que comienza. En cualquier caso, lo dejaré tranquilo". —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423289&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e31cc6e-4508-41c3-b882-6af8f9036fb5\', \'multiverseId\': 423289}, \'multiverseid\': 423289}, {\'name\': \'Nécrogénèse\', \'text\': \'{2} : Exilez une carte de créature ciblée depuis un cimetière. Créez un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Enchantement\', \'flavor\': "« Ce sont peut-être les convulsions d\'une vie qui s\'achève ou d\'une autre qui commence. Dans les deux cas, je n\'y toucherais pas. » —Rakka Mar", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421885&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c48cb351-62d4-4e25-b4b4-6c2e650f70c4\', \'multiverseId\': 421885}, \'multiverseid\': 421885}, {\'name\': \'Necrogenesi\', \'text\': \'{2}: Esilia una carta creatura bersaglio da un cimitero. Crea una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Incantesimo\', \'flavor\': \'"Quelli potrebbero essere i contorcimenti di una vita che termina o di un\\\'altra che inizia. In entrambi i casi, preferisco lasciarla stare." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422236&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e68c6f7-84cf-4b5f-b6b2-a708a8d92d65\', \'multiverseId\': 422236}, \'multiverseid\': 422236}, {\'name\': \'屍からの発生\', \'text\': \'{2}：墓地からクリーチャー・カード１枚を対象とし、それを追放する。緑の１/１の苗木・クリーチャー・トークンを１体生成する。\', \'type\': \'エンチャント\', \'flavor\': \'「一つの生の最期のもだえなのか、新たな生命の始まりなのか。どっちにせよ、かかわらない方がいいわね。」 ――ラッカ・マー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422587&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85c7d36f-71b7-402b-b461-62bb68334dfd\', \'multiverseId\': 422587}, \'multiverseid\': 422587}, {\'name\': \'Necrogênese\', \'text\': \'{2}: Exile o card de criatura alvo de um cemitério. Crie uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Encantamento\', \'flavor\': \'"Podem ser contorções de uma vida que termina ou de outra que se inicia. De qualquer forma, é melhor não interferir." — Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422938&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66f56eb6-7ca4-4831-8eb0-170fff0f9670\', \'multiverseId\': 422938}, \'multiverseid\': 422938}, {\'name\': \'死灵创生\', \'text\': \'{2}：将目标生物牌从坟墓场放逐。派出一个1/1绿色腐生物衍生生物。\', \'type\': \'结界\', \'flavor\': \'「那些触手可能要终结某生命，也可能要开始某生命。不论如何，我都不会去管。」 ～拉卡玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421183&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ebe46e2e-5656-432c-b6d6-81b37a379eba\', \'multiverseId\': 421183}, \'multiverseid\': 421183}]', "[{'name': 'Nevinyrrals Wunderscheibe', 'text': 'Nevinyrrals Wunderscheibe kommt getappt ins Spiel.\\n{1}, {T}: Zerstöre alle Artefakte, Kreaturen und Verzauberungen.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421584&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6284caec-1b48-4abf-b7f7-3635629e9189', 'multiverseId': 421584}, 'multiverseid': 421584}, {'name': 'Disco de Nevinyrral', 'text': 'El Disco de Nevinyrral entra al campo de batalla girado.\\n{1}, {T}: Destruye todos los artefactos, criaturas y encantamientos.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423339&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ed30f9e9-eb15-480e-bed4-9af6a4871155', 'multiverseId': 423339}, 'multiverseid': 423339}, {'name': 'Disque de Nevinyrral', 'text': 'Le Disque de Nevinyrral arrive sur le champ de bataille engagé.\\n{1}, {T} : Détruisez tous les artefacts, toutes les créatures et tous les enchantements.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421935&type=card', 'language': 'French', 'identifiers': {'scryfallId': '010a0ed2-cf59-4bcc-9387-d86764ef85b3', 'multiverseId': 421935}, 'multiverseid': 421935}, {'name': 'Disco di Nevinyrral', 'text': 'Il Disco di Nevinyrral entra nel campo di battaglia TAPpato.\\n{1}, {T}: Distruggi tutti gli artefatti, le creature e gli incantesimi.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422286&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'efae7882-d587-4dae-b264-4405b89b6839', 'multiverseId': 422286}, 'multiverseid': 422286}, {'name': 'ネビニラルの円盤', 'text': 'ネビニラルの円盤はタップ状態で戦場に出る。\\n{1}, {T}：すべてのアーティファクトとすべてのクリーチャーとすべてのエンチャントを破壊する。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422637&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9eecebb7-acdf-425e-9924-e3f96c4c00c6', 'multiverseId': 422637}, 'multiverseid': 422637}, {'name': 'Disco de Nevinyrral', 'text': 'Disco de Nevinyrral entra no campo de batalha virado.\\n{1}, {T}: Destrua todos os artefatos, criaturas e encantamentos.', 'type': 'Artefato', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422988&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2c343948-4685-472c-8a4a-ccec483bf893', 'multiverseId': 422988}, 'multiverseid': 422988}, {'name': '妮维亚洛之碟', 'text': '妮维亚洛之碟须横置进战场。\\n{1}，{T}：消灭所有神器，生物和结界。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421233&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '635bf454-614a-4b79-9d61-405ab5012cd5', 'multiverseId': 421233}, 'multiverseid': 421233}]", '[{\'name\': \'Nomadenaußenposten\', \'text\': \'Der Nomadenaußenposten kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {R}, {W} oder {B}.\', \'type\': \'Land\', \'flavor\': \'„Nur die Schwachen mauern sich selbst ein. Wir leben frei unterm Wind und unsere Freiheit macht uns stark." —Zurgo, Khan der Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421630&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56a245f7-d09b-4562-b8c0-58cba0255583\', \'multiverseId\': 421630}, \'multiverseid\': 421630}, {\'name\': \'Destacamento nómada\', \'text\': \'El Destacamento nómada entra al campo de batalla girado.\\n{T}: Agrega {R}, {W} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"Solo los débiles se encierran tras los muros. Nosotros vivimos libres como el viento, y nuestra libertad es nuestra fuerza". —Zurgo, kan de los Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423385&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41b09249-47be-4bfd-911d-fefb454b153a\', \'multiverseId\': 423385}, \'multiverseid\': 423385}, {\'name\': \'Avant-poste nomade\', \'text\': "L\'Avant-poste nomade arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {R}, {W} ou {B} à votre réserve.", \'type\': \'Terrain\', \'flavor\': "« Seuls les faibles s\'enferment entre quatre murs. Nous vivons au gré du vent, et notre liberté nous renforce. » —Zurgo, khan des Mardu", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421981&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00ed1a88-dac3-4846-a940-d4be309d7e4c\', \'multiverseId\': 421981}, \'multiverseid\': 421981}, {\'name\': \'Avamposto Nomade\', \'text\': "L\'Avamposto Nomade entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {R}, {W} o {B} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': \'"Solo i deboli si rinchiudono tra mura. Noi viviamo liberi sotto il vento e la nostra libertà ci rende forti." —Zurgo, khan dei Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422332&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03276f68-f1d1-42df-8347-2ffcbd41d3cb\', \'multiverseId\': 422332}, \'multiverseid\': 422332}, {\'name\': \'遊牧民の前哨地\', \'text\': \'遊牧民の前哨地はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{R}か{W}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'「壁の向こう側に閉じこもっているのは弱者だけだ。我々は風の下で自由に生きる。自由こそが我らを強くする。」 ――マルドゥのカン、ズルゴ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422683&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d9d742f7-a32c-4ca0-bedb-68d10b06ad58\', \'multiverseId\': 422683}, \'multiverseid\': 422683}, {\'name\': \'Posto Avançado Nômade\', \'text\': \'Posto Avançado Nômade entra no campo de batalha virado.\\n{T}: Adicione {R}, {W} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"Só os fracos se aprisionam atrás de paredes. Nós vivemos livres sob o vento e nossa liberdade nos fortalece." — Zurgo, khan dos Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423034&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'47d2423c-35f6-4007-b9ed-4bc071519ce5\', \'multiverseId\': 423034}, \'multiverseid\': 423034}, {\'name\': \'游牧人哨站\', \'text\': \'游牧人哨站须横置进战场。\\n{T}：加{R}，{W}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'「只有弱者才把自己关在城墙后面。我们在风中自由地生活，而自由让我们强壮。」 ～玛尔都可汗珠高\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421279&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0b215702-fb08-4244-a221-0f8baa422207\', \'multiverseId\': 421279}, \'multiverseid\': 421279}]', '[{\'name\': \'Oberster Ingenieur\', \'text\': \'Artefaktzauber, die du wirkst, haben Einberufen. (Deine Kreaturen können dir helfen, diese Zaubersprüche zu wirken. Mit jeder Kreatur, die du tappst, während du einen Artefaktzauber wirkst, bezahlst du für {1} oder ein Mana der Farbe jener Kreatur.)\', \'type\': \'Kreatur — Vedalken, Handwerker\', \'flavor\': \'Ein Auge fürs Detail, ein Talent für Zahlen und eine Seele wie ein Uhrwerk.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421405&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1723831-927a-4d01-aef5-0691c045f355\', \'multiverseId\': 421405}, \'multiverseid\': 421405}, {\'name\': \'Ingeniero jefe\', \'text\': \'Los hechizos de artefacto que lances tienen la habilidad de convocar. (Tus criaturas pueden ayudar a lanzar esos hechizos. Cada criatura que gires al lanzar un hechizo de artefacto cuenta como un pago de {1} o de un maná del color de esa criatura.)\', \'type\': \'Criatura — Artífice vedalken\', \'flavor\': \'Atento a los detalles, una mente para los números y un alma mecánica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423160&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5dd3615-1ff3-47b9-b2f3-3628f182be24\', \'multiverseId\': 423160}, \'multiverseid\': 423160}, {\'name\': \'Ingénieur en chef\', \'text\': "Les sorts d\'artefact que vous lancez ont la convocation. (Vos créatures peuvent aider à lancer ces sorts. Chaque créature que vous engagez en lançant un sort d\'artefact paie {1} ou un mana de la couleur de cette créature.)", \'type\': \'Créature : vedalken et artificier\', \'flavor\': \'Un œil sur chaque détail, des chiffres plein la tête, une âme mécanique.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421756&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9599efb6-f305-492c-9dd0-9d2575156ffc\', \'multiverseId\': 421756}, \'multiverseid\': 421756}, {\'name\': \'Ingegnere Capo\', \'text\': \'Le magie artefatto che lanci hanno convocazione. (Le tue creature possono aiutarti a lanciare quelle magie. Ogni creatura che TAPpi mentre lanci una magia artefatto corrisponde al pagamento di {1} o di un mana del colore di quella creatura.)\', \'type\': \'Creatura — Artefice Vedalken\', \'flavor\': "Un occhio attento ai dettagli, una mente agile con i numeri, un meccanismo perfetto nell\'anima.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422107&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d96e6d8-fed7-4cc5-a7b4-d9f37d51e6e0\', \'multiverseId\': 422107}, \'multiverseid\': 422107}, {\'name\': \'主任技師\', \'text\': \'あなたが唱えるアーティファクト・呪文は召集を持つ。（あなたのクリーチャーが、それらの呪文を唱える助けとなる。アーティファクト・呪文を唱える段階であなたがタップした各クリーチャーは、{1}かそのクリーチャーの色のマナ１点を支払う。）\', \'type\': \'クリーチャー — ヴィダルケン・工匠\', \'flavor\': \'詳細を確認するための目、数字を留めるための記憶、機械仕掛けの魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422458&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ee45a43-a32a-4834-b321-21fed23f38ed\', \'multiverseId\': 422458}, \'multiverseid\': 422458}, {\'name\': \'Engenheiro-chefe\', \'text\': \'As mágicas de artefato que você conjura têm convocar. (Suas criaturas podem ajudar a conjurar aquelas mágicas. Cada criatura que você vira ao conjurar uma mágica de artefato paga {1} ou um mana da cor daquela criatura.)\', \'type\': \'Criatura — Vedalkeano Artesão\', \'flavor\': \'Um olho para detalhes, uma mente para números, uma alma para mecanismos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'406f067d-ae7b-4dda-a6fc-cc84238e3a4c\', \'multiverseId\': 422809}, \'multiverseid\': 422809}, {\'name\': \'总工程师\', \'text\': \'你施放的神器咒语具有召集异能。（这些咒语能用你的生物来协助施放。你于施放神器咒语时每横置一个生物，就能为该咒语支付{1}或一点该生物颜色之法术力。）\', \'type\': \'生物～维多肯／神器师\', \'flavor\': \'单眼究微，片思运筹，灵如械动，丝毫不差。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421054&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5c85781-fb2d-4034-8c48-484e4c2aff6d\', \'multiverseId\': 421054}, \'multiverseid\': 421054}]', '[{\'name\': \'Opalpalast\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {C}.\\n{1}, {T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe der Farbidentität deines Kommandeurs. Falls du dieses Mana verwendest, um deinen Kommandeur zu wirken, kommt er mit so vielen zusätzlichen +1/+1-Marken ins Spiel, wie er in dieser Partie aus der Kommandozone gewirkt wurde.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f34d8afb-e5c9-4a54-8658-7d5cf91de597\', \'multiverseId\': 421631}, \'multiverseid\': 421631}, {\'name\': \'Palacio de ópalo\', \'text\': \'{T}: Agrega {C} a tu reserva de maná.\\n{1}, {T}: Agrega a tu reserva de maná un maná de cualquier color en la identidad de color de tu comandante. Si usas este maná para lanzar a tu comandante, este entra al campo de batalla con una cantidad de contadores +1/+1 sobre él adicionales igual a la cantidad de veces que se lanzó desde la zona de mando este juego.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423386&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e54e23a6-7749-416c-97e1-e259e93a0637\', \'multiverseId\': 423386}, \'multiverseid\': 423386}, {\'name\': "Palais d\'opale", \'text\': "{T} : Ajoutez {C} à votre réserve.\\n{1}, {T} : Ajoutez à votre réserve un mana de n\'importe quelle couleur de l\'identité couleur de votre commandant. Si vous dépensez ce mana pour lancer votre commandant, il arrive sur le champ de bataille avec, sur lui, un nombre de marqueurs +1/+1 supplémentaires égal au nombre de fois qu\'il a été lancé depuis la zone de commandement pendant cette partie.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421982&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0557f69a-3416-4e3d-8039-e6def39cfc06\', \'multiverseId\': 421982}, \'multiverseid\': 421982}, {\'name\': "Palazzo d\'Opale", \'text\': "{T}: Aggiungi {C} alla tua riserva di mana.\\n{1}, {T}: Aggiungi alla tua riserva di mana un mana di un qualsiasi colore nell\'identità di colore del tuo comandante. Se spendi questo mana per lanciare il tuo comandante, entra nel campo di battaglia con un numero di segnalini +1/+1 addizionali pari al numero di volte che è stato lanciato dalla zona di comando in questa partita.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422333&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e54c84fc-01db-4211-a144-a513754fe3a7\', \'multiverseId\': 422333}, \'multiverseid\': 422333}, {\'name\': \'オパールの宮殿\', \'text\': \'{T}：あなたのマナ・プールに{C}を加える。\\n{1}, {T}：あなたのマナ・プールに、あなたの統率者の固有色のうち好きな色１色のマナ１点を加える。このマナであなたの統率者を唱えたなら、それはあなたがこのゲーム中にそれを統率領域から唱えた回数に等しい数の＋１/＋１カウンターが置かれた状態で戦場に出る。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422684&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5925f1f4-2226-4907-b0cd-73bfb6218ec6\', \'multiverseId\': 422684}, \'multiverseid\': 422684}, {\'name\': \'Palácio de Opala\', \'text\': \'{T}: Adicione {C} à sua reserva de mana.\\n{1}, {T}: Adicione a sua reserva de mana um mana de qualquer cor da identidade de cor de seu comandante. Se você gastar este mana para conjurar seu comandante, este entra no campo de batalha com um número de marcadores +1/+1 adicionais igual ao número de vezes em que foi conjurado a partir da zona de comando neste jogo.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423035&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9181dca-0040-40ea-aeb3-dda7f714bc57\', \'multiverseId\': 423035}, \'multiverseid\': 423035}, {\'name\': \'清辉宫殿\', \'text\': \'{T}：加{C}到你的法术力池中。\\n{1}，{T}：加一点法术力到你的法术力池中，其颜色为你指挥官标识色中的任一颜色。如果你将此法术力用来施放你的指挥官，则它进战场时上面额外有若干+1/+1指示物，其数量等同于这盘游戏中从统帅区中施放它的次数。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421280&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3daf371c-e9d3-4997-8e0f-2d2cc184e4bc\', \'multiverseId\': 421280}, \'multiverseid\': 421280}]', '[{\'name\': \'Opfergabe\', \'text\': \'Der Besitzer einer bleibenden Karte deiner Wahl, die kein Land ist, mischt diese in seine Bibliothek und zieht dann zwei Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein reicheres Volk könnte zwar mehr geben, aber nie genug."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421390&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e853ca6-7233-41b1-9148-4a4076d034dd\', \'multiverseId\': 421390}, \'multiverseid\': 421390}, {\'name\': \'Oblación\', \'text\': \'El propietario del permanente objetivo que no sea tierra lo baraja en su biblioteca, luego roba dos cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Un pueblo más rico podría dar más, pero nunca podría dar tanto".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423145&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90ea6273-306d-4408-9154-22a12b8064be\', \'multiverseId\': 423145}, \'multiverseid\': 423145}, {\'name\': \'Oblation\', \'text\': \'Le propriétaire du permanent non-terrain ciblé le mélange à sa bibliothèque et pioche ensuite deux cartes.\', \'type\': \'Éphémère\', \'flavor\': \'« Un peuple plus riche pourrait donner plus, mais il ne donnerait jamais autant de lui-même. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421741&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'716e656c-764f-4600-be58-c269cf9d003c\', \'multiverseId\': 421741}, \'multiverseid\': 421741}, {\'name\': \'Obolo\', \'text\': \'Il proprietario di un permanente non terra bersaglio lo rimescola nel suo grimorio, poi pesca due carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le persone più ricche possono dare di più, ma non potranno mai dare così tanto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422092&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'72db063b-4b3c-45d8-927b-41168499143a\', \'multiverseId\': 422092}, \'multiverseid\': 422092}, {\'name\': \'奉納\', \'text\': \'土地でないパーマネント１つを対象とする。それのオーナーは、それを自分のライブラリーに加えて切り直し、その後カードを２枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「裕福な人ほどより多く出せるはずなのに、人並みに出すことさえしない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422443&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38ed478f-b2f7-4244-a867-c9997bb7f10c\', \'multiverseId\': 422443}, \'multiverseid\': 422443}, {\'name\': \'Oblação\', \'text\': \'O dono da permanente alvo que não seja terreno a embaralha no próprio grimório e depois compra dois cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um povo rico poderia dar mais, mas jamais poderia dar tanto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422794&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7bdf83d3-4836-4f77-9932-7c82263747ee\', \'multiverseId\': 422794}, \'multiverseid\': 422794}, {\'name\': \'奉献\', \'text\': \'目标非地永久物的拥有者将其洗回牌库，然后抓两张牌。\', \'type\': \'瞬间\', \'flavor\': \'「富人能给得更多，但永无法如此慷慨。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421039&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9ae61bc3-e876-4fba-902b-ada0f4f3e220\', \'multiverseId\': 421039}, \'multiverseid\': 421039}]', "[{'name': 'Order // Chaos', 'text': 'Schicke eine angreifende Kreatur deiner Wahl ins Exil.', 'type': 'Spontanzauber', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421559&type=card', 'language': 'German', 'identifiers': {'scryfallId': '548a0c4b-db3a-4bfe-86f3-dbc0d73979a5', 'multiverseId': 421559}, 'multiverseid': 421559}, {'name': 'Order // Chaos', 'text': 'Exilia la criatura atacante objetivo.', 'type': 'Instantáneo', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423314&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fb5e5cff-8308-49d4-878a-1c2a5a4c9c7a', 'multiverseId': 423314}, 'multiverseid': 423314}, {'name': 'Order // Chaos', 'text': 'Exilez la créature attaquante ciblée.', 'type': 'Éphémère', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421910&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ccfbdad7-7200-4b22-9c3c-74d896cc76f8', 'multiverseId': 421910}, 'multiverseid': 421910}, {'name': 'Order // Chaos', 'text': 'Esilia una creatura attaccante bersaglio.', 'type': 'Istantaneo', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422261&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a55ea877-4cb8-474e-aa60-3eab20b984fb', 'multiverseId': 422261}, 'multiverseid': 422261}, {'name': 'Order // Chaos', 'text': '攻撃クリーチャー１体を対象とし、それを追放する。', 'type': 'インスタント', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422612&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '074e3a98-afef-41d7-9701-b46a7388a06e', 'multiverseId': 422612}, 'multiverseid': 422612}, {'name': 'Order // Chaos', 'text': 'Exile a criatura alvo atacante.', 'type': 'Mágica Instantânea', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422963&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '383f241a-21a4-4504-99bb-3b07313d5213', 'multiverseId': 422963}, 'multiverseid': 422963}, {'name': 'Order // Chaos', 'text': '放逐目标进行攻击的生物。', 'type': '瞬间', 'flavor': None, 'faceName': 'Order', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421208&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '83c33621-356a-4c71-bea9-7fb92c6f61c1', 'multiverseId': 421208}, 'multiverseid': 421208}]", '[{\'name\': \'Orzhov-Advokistin\', \'text\': \'Zu Beginn deines Versorgungssegments kann jeder Spieler zwei +1/+1-Marken auf eine Kreatur legen, die er kontrolliert. Falls ein Spieler dies tut, können Kreaturen, die dieser Spieler kontrolliert, bis zu deinem nächsten Zug weder dich noch einen Planeswalker, den du kontrollierst, angreifen.\', \'type\': \'Kreatur — Mensch, Berater\', \'flavor\': \'Die Orzhov sind nicht an Reue, sondern ausschließlich an Tilgung interessiert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421322&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f75782af-b4c9-40a8-94d2-3a1641d9be3e\', \'multiverseId\': 421322}, \'multiverseid\': 421322}, {\'name\': \'Abogada orzhov\', \'text\': \'Al comienzo de tu mantenimiento, cada jugador puede poner dos contadores +1/+1 sobre una criatura que controla. Si un jugador lo hace, las criaturas que controla ese jugador no pueden atacarte a ti o a un planeswalker que controlas hasta tu próximo turno.\', \'type\': \'Criatura — Consejero humano\', \'flavor\': \'Los Orzhov no buscan el arrepentimiento, solo la retribución.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423077&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f026275-745c-4f64-802d-89d7a9e7ed4d\', \'multiverseId\': 423077}, \'multiverseid\': 423077}, {\'name\': "Avoquiste d\'Orzhov", \'text\': "Au début de votre entretien, chaque joueur peut mettre deux marqueurs +1/+1 sur une créature qu\'il contrôle. Si un joueur fait ainsi, les créatures que ce joueur contrôle ne peuvent pas vous attaquer ou attaquer un planeswalker que vous contrôlez jusqu\'à votre prochain tour.", \'type\': \'Créature : humain et conseiller\', \'flavor\': "Les Orzhov se moquent du repentir, ils s\'intéressent seulement au remboursement.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421673&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6139c42b-77eb-4447-a92d-f9846ce4ddfd\', \'multiverseId\': 421673}, \'multiverseid\': 421673}, {\'name\': \'Fautrice Orzhov\', \'text\': "All\'inizio del tuo mantenimento, ogni giocatore può mettere due segnalini +1/+1 su una creatura che controlla. Se un giocatore lo fa, le creature controllate da quel giocatore non possono attaccare te o un planeswalker che controlli fino al tuo prossimo turno.", \'type\': \'Creatura — Consigliere Umano\', \'flavor\': \'Agli Orzhov non interessa il pentimento, solo il pagamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422024&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a0701fc8-4b5d-4fd6-bfde-ae4b2c61932f\', \'multiverseId\': 422024}, \'multiverseid\': 422024}, {\'name\': \'オルゾフの弁護士\', \'text\': \'あなたのアップキープの開始時に、各プレイヤーは自分がコントロールするクリーチャー１体の上に＋１/＋１カウンターを２個置いてもよい。いずれかのプレイヤーがそうしたなら、あなたの次のターンまで、そのプレイヤーがコントロールするクリーチャーではあなたやあなたがコントロールするプレインズウォーカーを攻撃できない。\', \'type\': \'クリーチャー — 人間・アドバイザー\', \'flavor\': \'オルゾフは謝罪を求めず、返済を求める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422375&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41f04d11-c169-49d8-921e-cd8792e8a31e\', \'multiverseId\': 422375}, \'multiverseid\': 422375}, {\'name\': \'Advoquista Orzhov\', \'text\': \'No início de sua manutenção, cada jogador pode colocar dois marcadores +1/+1 em uma criatura que ele controla. Se um jogador fizer isso, as criaturas que aquele jogador controle não poderão atacar você nem um planeswalker que você controle até seu próximo turno.\', \'type\': \'Criatura — Humano Conselheiro\', \'flavor\': \'Aos Orzhov não importa que alguém se arrependa, só que alguém pague.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422726&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba8e4da6-9dab-4434-a320-5706a8042b4b\', \'multiverseId\': 422726}, \'multiverseid\': 422726}, {\'name\': \'欧佐夫倡议人\', \'text\': \'在你的维持开始时，每位牌手各可以在一个由其操控的生物上放置两个+1/+1指示物。若有牌手如此作，则直到你的下一个回合，由该牌手操控的生物不能攻击你或由你操控的鹏洛客。\', \'type\': \'生物～人类／参谋\', \'flavor\': \'欧佐夫并不在乎你是否悔过，只在乎你是否赔过。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420971&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd0fb9da-19bf-480f-942e-c048a498a877\', \'multiverseId\': 420971}, \'multiverseid\': 420971}]', '[{\'name\': \'Orzhov-Basilika\', \'text\': \'Die Orzhov-Basilika kommt getappt ins Spiel.\\nWenn die Orzhov-Basilika ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {W}{B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421633&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65febf4a-f1d7-4709-9359-ce3bee926477\', \'multiverseId\': 421633}, \'multiverseid\': 421633}, {\'name\': \'Basílica orzhov\', \'text\': \'La Basílica orzhov entra al campo de batalla girada.\\nCuando la Basílica orzhov entre al campo de batalla, regresa una tierra que controlas a la mano de su propietario.\\n{T}: Agrega {W}{B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423388&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03dab286-696c-4fda-9208-cd0112228f3b\', \'multiverseId\': 423388}, \'multiverseid\': 423388}, {\'name\': "Basilique d\'Orzhov", \'text\': "La Basilique d\'Orzhov arrive sur le champ de bataille engagée.\\nQuand la Basilique d\'Orzhov arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {W}{B} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421984&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'804d0edb-75ec-4f48-a9e1-39e8cc741d85\', \'multiverseId\': 421984}, \'multiverseid\': 421984}, {\'name\': \'Basilica Orzhov\', \'text\': \'La Basilica Orzhov entra nel campo di battaglia TAPpata.\\nQuando la Basilica Orzhov entra nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {W}{B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422335&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'80688195-1140-4dd0-ad32-61ec0b3834c9\', \'multiverseId\': 422335}, \'multiverseid\': 422335}, {\'name\': \'オルゾフの聖堂\', \'text\': \'オルゾフの聖堂はタップ状態で戦場に出る。\\nオルゾフの聖堂が戦場に出たとき、あなたがコントロールする土地を１つオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{W}{B}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422686&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1203ade-2326-4a38-8162-0798b860b82d\', \'multiverseId\': 422686}, \'multiverseid\': 422686}, {\'name\': \'Basílica Orzhov\', \'text\': \'Basílica Orzhov entra no campo de batalha virado.\\nQuando Basílica Orzhov entrar no campo de batalha, devolva um terreno que você controla para a mão de seu dono.\\n{T}: Adicione {W}{B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423037&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d3977e3-53a4-4b36-9ae3-c38a3019a03c\', \'multiverseId\': 423037}, \'multiverseid\': 423037}, {\'name\': \'欧佐夫大殿\', \'text\': \'欧佐夫大殿须横置进战场。\\n当欧佐夫大殿进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{W}{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421282&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4fc77c0-8da2-4ee2-bd90-c83fb3821605\', \'multiverseId\': 421282}, \'multiverseid\': 421282}]', '[{\'name\': \'Orzhov-Petschaft\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {W}{B}.\', \'type\': \'Artefakt\', \'flavor\': \'Die Form des Siegels ist genauso wichtig wie das Siegel selbst. Wenn es als Anhänger getragen wird, ist sein Träger ein Herr. Wenn es auf den Körper tätowiert ist, ist sein Träger ein Sklave.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421585&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1994c026-0a6d-41bc-a87d-3922777fc0c2\', \'multiverseId\': 421585}, \'multiverseid\': 421585}, {\'name\': \'Sello orzhov\', \'text\': \'{1}, {T}: Agrega {W}{B} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'La forma del sello es tan importante como el sello mismo. Si se lleva en un medallón, su portador es un amo. Si está tatuado en el cuerpo, su portador es un esclavo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423340&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb84b6c4-eb20-4b2f-83a8-61e526905135\', \'multiverseId\': 423340}, \'multiverseid\': 423340}, {\'name\': "Cachet d\'Orzhov", \'text\': \'{1}, {T} : Ajoutez {W}{B} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "La forme du cachet est aussi importante que le cachet en lui-même. S\'il est sur un médaillon, son porteur est un maître. S\'il est tatoué, son porteur est un esclave.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421936&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d331335-ea2c-43ff-aeca-446dc83e3583\', \'multiverseId\': 421936}, \'multiverseid\': 421936}, {\'name\': \'Sigillo Orzhov\', \'text\': \'{1}, {T}: Aggiungi {W}{B} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'La forma del sigillo è importante quanto il sigillo stesso. Se viene portato su un medaglione, chi lo porta è un maestro. Se è tatuato sul corpo, chi lo porta è uno schiavo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422287&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d586060-a362-4dbe-8a6b-6788dd3a1e99\', \'multiverseId\': 422287}, \'multiverseid\': 422287}, {\'name\': \'オルゾフの印鑑\', \'text\': \'{1}, {T}：あなたのマナ・プールに{W}{B}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'紋章が何にあるかは、紋章自身と同じぐらい重要だ。それが大メダルにあるなら、持ち主は主だ。それが身体の刺青なら、持ち主は奴隷だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422638&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'91446c05-a395-4cc5-9f2c-46940e5b053c\', \'multiverseId\': 422638}, \'multiverseid\': 422638}, {\'name\': \'Sinete Orzhov\', \'text\': \'{1}, {T}: Adicione {W}{B} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'A forma do símbolo é tão importante quanto o próprio símbolo. Se é carregado em um medalhão, seu portador é um mestre. Se é tatuado no corpo, seu portador é um escravo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422989&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ef4b5ea3-1571-48b2-8157-fab08c337957\', \'multiverseId\': 422989}, \'multiverseid\': 422989}, {\'name\': \'欧佐夫印记\', \'text\': \'{1}，{T}：加{W}{B}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'此印记之类型与其本身一样重要。若出现在徽章上，配印者便是主人。若刺青在肉体上，背负者即是奴隶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421234&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9912bd95-5186-4684-ae4d-c7261a523d2c\', \'multiverseId\': 421234}, \'multiverseid\': 421234}]', '[{\'name\': \'Pechhaltiger Strahl\', \'text\': \'Kaskade (Wenn du diesen Zauberspruch wirkst, schicke so lange die oberste Karte deiner Bibliothek ins Exil, bis du eine Karte ins Exil schickst, die kein Land ist und die weniger kostet als dieser Zauberspruch. Du kannst sie wirken, ohne ihre Manakosten zu bezahlen. Lege die so ins Exil geschickten Karten in zufälliger Reihenfolge unter deine Bibliothek.)\\nDer Pechhaltige Strahl fügt einer Kreatur deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de5d46c4-f966-4233-9d25-fd11e907563a\', \'multiverseId\': 421501}, \'multiverseid\': 421501}, {\'name\': \'Ráfaga bituminosa\', \'text\': \'Cascada. (Cuando lances este hechizo, exilia cartas de la parte superior de tu biblioteca hasta que exilies una carta que no sea tierra y que cueste menos. Puedes lanzarla sin pagar su coste de maná. Pon las cartas exiliadas en el fondo de tu biblioteca en un orden aleatorio.)\\nLa Ráfaga bituminosa hace 4 puntos de daño a la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423256&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a3cc3a6-8154-4ed6-9674-d54c5d361157\', \'multiverseId\': 423256}, \'multiverseid\': 423256}, {\'name\': \'Salve bitumeuse\', \'text\': "Cascade (Quand vous lancez ce sort, exilez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous exiliez une carte non-terrain d\'un coût inférieur. Vous pouvez la lancer sans payer son coût de mana. Mettez les cartes exilées au-dessous de votre bibliothèque dans un ordre aléatoire.)\\nLa Salve bitumeuse inflige 4 blessures à la créature ciblée.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421852&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9fd26b54-c619-4bbb-ac4f-5495cd1157fe\', \'multiverseId\': 421852}, \'multiverseid\': 421852}, {\'name\': \'Esplosione di Bitume\', \'text\': "Cascata (Quando lanci questa magia, esilia carte dalla cima del tuo grimorio finché non esili una carta non terra che costa meno. Puoi lanciarla senza pagare il suo costo di mana. Metti le carte esiliate in fondo al tuo grimorio in ordine casuale.)\\nL\'Esplosione di Bitume infligge 4 danni a una creatura bersaglio.", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422203&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61a98f2c-c723-4cc9-9817-5bb75930b411\', \'multiverseId\': 422203}, \'multiverseid\': 422203}, {\'name\': \'瀝青破\', \'text\': \'続唱（あなたがこの呪文を唱えたとき、コストがこれより低い土地でないカードが追放されるまで、あなたのライブラリーの一番上からカードを１枚ずつ追放する。あなたはそれをそのマナ・コストを支払うことなく唱えてもよい。追放したカードをあなたのライブラリーの一番下に無作為の順番で置く。）\\nクリーチャー１体を対象とする。瀝青破はそれに４点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422554&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'adfe981a-42e1-45a6-8a7c-2dfd96d51930\', \'multiverseId\': 422554}, \'multiverseid\': 422554}, {\'name\': \'Explosão Betuminosa\', \'text\': \'Cascata (Quando conjurar esta mágica, exile os cards do topo do seu grimório até exilar um que não seja terreno e que tenha custo inferior. Você pode conjurá-lo sem pagar seu custo de mana. Coloque os cards exilados no fundo de seu grimório em ordem aleatória.)\\nExplosão Betuminosa causa 4 pontos de dano à criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422905&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d35d581-974a-4a62-8f0d-b1e730f828f2\', \'multiverseId\': 422905}, \'multiverseid\': 422905}, {\'name\': \'沥青冲击\', \'text\': \'倾曳（当你施放此咒语时，从你的牌库顶开始放逐牌，直到你放逐一张费用比此咒语低的非地牌为止。你可以施放该牌，且不需支付其法术力费用。将所放逐的牌以随机顺序置于你的牌库底。）\\n沥青冲击对目标生物造成4点伤害。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421150&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0ceeb271-8d71-4266-bed1-c3696de79396\', \'multiverseId\': 421150}, \'multiverseid\': 421150}]', "[{'name': 'Peitschlodern', 'text': 'Das Peitschlodern fügt jeder Nichtartefaktkreatur 2 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Die Schlackenarbeiter verschwendeten keine Zeit, ihren eigenen Flammenpuls zu erschaffen, um das Gebiet von den Unkompleatierten zu säubern.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421459&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0c9d6748-83a7-47cc-baea-c18c5756ae36', 'multiverseId': 421459}, 'multiverseid': 421459}, {'name': 'Llama flagelante', 'text': 'La Llama flagelante hace 2 puntos de daño a cada criatura que no sea artefacto.', 'type': 'Conjuro', 'flavor': 'Los trabajadores de la escoria no tardaron en crear sus propios pulsos de llamas para limpiar el área de los imperfectos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423214&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4932d04f-45f6-4afb-af23-da5e7d025514', 'multiverseId': 423214}, 'multiverseid': 423214}, {'name': 'Fulgurofouet', 'text': 'Le Fulgurofouet inflige 2 blessures à chaque créature non-artefact.', 'type': 'Rituel', 'flavor': 'Les ouvriers des fourneaux ne perdaient pas de temps à créer leurs propres outils pour écarter les imparachevés.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421810&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c240db6a-4e32-4f93-81fe-9e42f5e3491a', 'multiverseId': 421810}, 'multiverseid': 421810}, {'name': 'Bagliore Sferzante', 'text': 'Il Bagliore Sferzante infligge 2 danni a ogni creatura non artefatto.', 'type': 'Stregoneria', 'flavor': 'Gli operai delle scorie non persero tempo e crearono i loro bagliori pulsanti per ripulire la zona dagli incompleti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422161&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6fbd7622-e640-4377-bf3e-c9a698732e4c', 'multiverseId': 422161}, 'multiverseid': 422161}, {'name': '鞭打ち炎', 'text': '鞭打ち炎はアーティファクトでない各クリーチャーにそれぞれ２点のダメージを与える。', 'type': 'ソーサリー', 'flavor': '金屑の労働者は、完璧ならざる地を浄化するため、一刻も早く独自の炎を作り出そうとしていた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422512&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5118a6a7-bdea-4d6b-bb14-52f0e45b3309', 'multiverseId': 422512}, 'multiverseid': 422512}, {'name': 'Labareda Açoitadora', 'text': 'Labareda Açoitadora causa 2 pontos de dano a cada criatura que não seja artefato.', 'type': 'Feitiço', 'flavor': 'Os operários das escórias rapidamente criaram seus próprios pulsos de labareda para limpar a área dos incompletos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422863&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2659cddf-aceb-425c-921f-52723abb9e63', 'multiverseId': 422863}, 'multiverseid': 422863}, {'name': '鞭扫火光', 'text': '鞭扫火光对每个非神器的生物各造成2点伤害。', 'type': '法术', 'flavor': '熔渣工人很快就创出火焰脉动，用来清理未完化者的区域。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421108&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '15b6a0c7-e8dd-4edb-b901-d88813cb8474', 'multiverseId': 421108}, 'multiverseid': 421108}]", '[{\'name\': \'Phyrexianische Wiedergeburt\', \'text\': \'Zerstöre alle Kreaturen und erzeuge dann einen X/X farblosen Schrecken-Artefaktkreaturenspielstein, wobei X gleich der Anzahl an Kreaturen ist, die auf diese Weise zerstört wurden.\', \'type\': \'Hexerei\', \'flavor\': \'Solange noch ein Tropfen Öl existiert, geht es fröhlich weiter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421392&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c8db0d9-9ed0-4fc3-9384-bbc63d4508ac\', \'multiverseId\': 421392}, \'multiverseid\': 421392}, {\'name\': \'Renacimiento pirexiano\', \'text\': \'Destruye todas las criaturas, luego crea una ficha de criatura artefacto Horror incolora X/X, donde X es la cantidad de criaturas destruidas de esta manera.\', \'type\': \'Conjuro\', \'flavor\': \'Mientras exista una gota de ese aceite, la dichosa labor continúa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423147&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7edd2f82-7b80-4678-92c0-7e794508c71a\', \'multiverseId\': 423147}, \'multiverseid\': 423147}, {\'name\': \'Renaissance phyrexiane\', \'text\': \'Détruisez toutes les créatures, puis créez un jeton de créature-artefact X/X incolore Horreur, X étant le nombre de créatures détruites de cette manière.\', \'type\': \'Rituel\', \'flavor\': "Tant qu\'il subsistera une goutte de pétrole, notre mission de joie continuera.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421743&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59f39d09-de5a-48f4-a44a-e5f88f5cfd05\', \'multiverseId\': 421743}, \'multiverseid\': 421743}, {\'name\': \'Rinascita di Phyrexia\', \'text\': \'Distruggi tutte le creature, poi crea una pedina creatura artefatto Orrore X/X incolore, dove X è il numero di creature distrutte in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': "Finché esiste una goccia dell\'olio, l\'allegro lavoro continua.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422094&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'11f23656-2881-498d-abf3-3d519d36d326\', \'multiverseId\': 422094}, \'multiverseid\': 422094}, {\'name\': \'ファイレクシアの再誕\', \'text\': \'すべてのクリーチャーを破壊し、その後無色のＸ/Ｘのホラー・アーティファクト・クリーチャー・トークンを１体生成する。Ｘはこれにより破壊されたクリーチャーの総数に等しい。\', \'type\': \'ソーサリー\', \'flavor\': \'油が一滴でもあるかぎり、喜びに満ちた業は続く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422445&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5345e06-f47a-46c8-a3da-bb750dc31c4c\', \'multiverseId\': 422445}, \'multiverseid\': 422445}, {\'name\': \'Renascimento Phyrexiano\', \'text\': \'Destrua todas as criaturas. Em seguida, crie uma ficha de criatura artefato incolor X/X do tipo Horror, sendo X o número de criaturas destruídas desta forma.\', \'type\': \'Feitiço\', \'flavor\': \'Enquanto ainda houver uma gota do óleo, a obra jubilosa terá continuidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422796&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ed04452-2a4d-4807-a811-c19d34d99ca0\', \'multiverseId\': 422796}, \'multiverseid\': 422796}, {\'name\': \'非瑞克西亚再生\', \'text\': \'消灭所有生物，然后派出一个X/X无色惊惧兽衍生神器生物，X为以此法消灭的生物数量。\', \'type\': \'法术\', \'flavor\': \'只要有这样的一滴油，愉悦的工作就会继续。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421041&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49d5a779-89ab-45d6-9c7e-da4edfb20fe2\', \'multiverseId\': 421041}, \'multiverseid\': 421041}]', '[{\'name\': \'Pirschende Rache\', \'text\': \'Eile\\nImmer wenn eine andere Kreatur, die du kontrollierst, stirbt, fügt sie einem Spieler deiner Wahl Schadenspunkte in Höhe ihrer Stärke zu.\', \'type\': \'Kreatur — Avatar\', \'flavor\': \'Etwas streunt über die Schauplätze von Morden, riecht die Schuld der Täter und verfolgt sie auf eisernen Pfoten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421453&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a16b34c4-8c2c-43c6-ae6d-b2923a7e97a0\', \'multiverseId\': 421453}, \'multiverseid\': 421453}, {\'name\': \'Venganza acechante\', \'text\': \'Prisa.\\nSiempre que otra criatura que controles muera, le hace daño igual a su fuerza al jugador objetivo.\', \'type\': \'Criatura — Avatar\', \'flavor\': \'Algo vaga por las escenas de los crímenes, oliendo la culpa de los asesinos, acechándolos con garras de acero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423208&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d8cac8b-c3e3-4164-86f9-91b818f88223\', \'multiverseId\': 423208}, \'multiverseid\': 423208}, {\'name\': \'Vengeance en chasse\', \'text\': "Célérité\\nÀ chaque fois qu\'une autre créature que vous contrôlez meurt, elle inflige un nombre de blessures égal à sa force au joueur ciblé.", \'type\': \'Créature : avatar\', \'flavor\': \'Une présence rôde sur les lieux de meurtre, reniflant la culpabilité des tueurs pour les chasser ensuite sur des membres de fer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ec71aa7-0f7c-4e47-a58b-f35ddf64b506\', \'multiverseId\': 421804}, \'multiverseid\': 421804}, {\'name\': \'Vendetta in Agguato\', \'text\': "Rapidità\\nOgniqualvolta un\'altra creatura che controlli muore, infligge danno pari alla propria forza a un giocatore bersaglio.", \'type\': \'Creatura — Avatar\', \'flavor\': "Qualcosa si aggira per i luoghi di morte, annusando le colpe dei carnefici, seguendoli di soppiatto su zampe d\'acciaio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422155&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77e1982d-0df6-42f9-9443-ee2eff4a4352\', \'multiverseId\': 422155}, \'multiverseid\': 422155}, {\'name\': \'忍び寄る復讐\', \'text\': \'速攻\\nあなたがコントロールする他のクリーチャーが１体死亡するたび、プレイヤー１人を対象とする。そのクリーチャーはそのプレイヤーに自身のパワーに等しい点数のダメージを与える。\', \'type\': \'クリーチャー — アバター\', \'flavor\': \'何かが殺しの現場をうろつき、殺害者の罪の臭いを嗅ぎ、鉄の足でその後ろに忍び寄る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422506&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d7f33f4f-57e1-4de6-b470-12c2575ef9b8\', \'multiverseId\': 422506}, \'multiverseid\': 422506}, {\'name\': \'Vingança Perseguidora\', \'text\': \'Ímpeto\\nToda vez que outra criatura que você controla morre, ela causa dano igual ao seu poder ao jogador alvo.\', \'type\': \'Criatura — Avatar\', \'flavor\': \'Algo vaga pelos campos de massacres, farejando a culpa dos assassinos, perseguindo-os com patas de aço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422857&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c98601b3-900f-4d65-87b5-6c0034844ef7\', \'multiverseId\': 422857}, \'multiverseid\': 422857}, {\'name\': \'潜行报复者\', \'text\': \'敏捷\\n每当另一个由你操控的生物死去时，它对目标牌手造成等同于其力量的伤害。\', \'type\': \'生物～圣者\', \'flavor\': \'不知什么东西在杀戮场徘徊，嗅闻杀手的罪恶气息，并以铁掌袭击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421102&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bc1f17a-8956-4820-a22b-b03a0277cc0f\', \'multiverseId\': 421102}, \'multiverseid\': 421102}]', '[{\'name\': \'Plundermagier\', \'text\': \'Wenn der Plundermagier ins Spiel kommt, kannst du deine Bibliothek nach einer Artefaktkarte mit umgewandelten Manakosten von 1 oder weniger durchsuchen, diese Karte offen vorzeigen und sie auf deine Hand nehmen. Falls du dies tust, mische danach deine Bibliothek.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421421&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'818d2d85-6b60-4a1f-a589-bef3328e7b0d\', \'multiverseId\': 421421}, \'multiverseid\': 421421}, {\'name\': \'Mago de baratijas\', \'text\': \'Cuando el Mago de baratijas entre al campo de batalla, puedes buscar en tu biblioteca una carta de artefacto con coste de maná convertido de 1 o menos, mostrarla y ponerla en tu mano. Si lo haces, baraja tu biblioteca.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423176&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0149d9ac-5356-4b0f-9046-333f27635a75\', \'multiverseId\': 423176}, \'multiverseid\': 423176}, {\'name\': \'Mage aux breloques\', \'text\': "Quand le Mage aux breloques arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte d\'artefact avec un coût converti de mana inférieur ou égal à 1, révéler cette carte et la mettre dans votre main. Si vous faites ainsi, mélangez votre bibliothèque.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421772&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9491a2f2-b138-4ea7-af1a-af33a1704a6e\', \'multiverseId\': 421772}, \'multiverseid\': 421772}, {\'name\': \'Mago dei Gingilli\', \'text\': \'Quando il Mago dei Gingilli entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta artefatto con costo di mana convertito pari o inferiore a 1, rivelarla e aggiungerla alla tua mano. Se lo fai, rimescola il tuo grimorio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422123&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7686f90a-27e4-4dbe-90d6-bc9e79104315\', \'multiverseId\': 422123}, \'multiverseid\': 422123}, {\'name\': \'粗石の魔道士\', \'text\': \'粗石の魔道士が戦場に出たとき、あなたはあなたのライブラリーから点数で見たマナ・コストが１以下のアーティファクト・カード１枚を探してもよい。そうしたなら、それを公開してあなたの手札に加え、あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422474&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2851bb2-0eea-461f-a025-8622c7e0e89b\', \'multiverseId\': 422474}, \'multiverseid\': 422474}, {\'name\': \'Mago das Quinquilharias\', \'text\': \'Quando Mago das Quinquilharias entra no campo de batalha, você pode procurar um card de artefato com custo de mana convertido igual a 1 ou menos em seu grimório, revelá-lo e colocá-lo na sua mão. Se fizer isso, embaralhe seu grimório.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6969b60e-b146-4bd4-b327-7c9c7f98b339\', \'multiverseId\': 422825}, \'multiverseid\': 422825}, {\'name\': \'琐物法师\', \'text\': \'当琐物法师进战场时，你可以从你的牌库中搜寻一张总法术力费用等于或小于1的神器牌，展示该牌，并将它置于你手上。若你如此作，则将你的牌库洗牌。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421070&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2606890a-28c3-4064-a941-d548dfd50b93\', \'multiverseId\': 421070}, \'multiverseid\': 421070}]', "[{'name': 'Prismen-Geoskop', 'text': 'Das Prismen-Geoskop kommt getappt ins Spiel.\\nDomäne — {T}: Erhöhe deinen Manavorrat um X Mana in einer beliebigen Kombination von Farben, wobei X gleich der Anzahl an Standardlandtypen unter den Ländern ist, die du kontrollierst.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421374&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7472f7c6-2231-4702-9b92-c47dee0d9955', 'multiverseId': 421374}, 'multiverseid': 421374}, {'name': 'Geoscopio prismático', 'text': 'El Geoscopio prismático entra al campo de batalla girado.\\nDominio — {T}: Agrega X manás de cualquier combinación de color a tu reserva de maná, donde X es la cantidad de tipos de tierra básica entre las tierras que controlas.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423129&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '577d9815-7756-4a0c-a7d5-b45630176c51', 'multiverseId': 423129}, 'multiverseid': 423129}, {'name': 'Géoscope prismatique', 'text': 'Le Géoscope prismatique arrive sur le champ de bataille engagé.\\nDomaine — {T} : Ajoutez X manas de la combinaison de mana coloré de votre choix à votre réserve, X étant le nombre de types de terrain de base parmi les terrains que vous contrôlez.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421725&type=card', 'language': 'French', 'identifiers': {'scryfallId': '441cc64d-0d93-4deb-8b1e-3e68f0428b7e', 'multiverseId': 421725}, 'multiverseid': 421725}, {'name': 'Geoscopio Prismatico', 'text': 'Il Geoscopio Prismatico entra nel campo di battaglia TAPpato.\\nDominio — {T}: Aggiungi X mana in qualsiasi combinazione di colori alla tua riserva di mana, dove X è il numero di tipi di terra base tra le terre che controlli.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422076&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '53aab9c9-b7c3-454e-a787-f4cded4042b0', 'multiverseId': 422076}, 'multiverseid': 422076}, {'name': '虹色の大地鏡', 'text': '虹色の大地鏡はタップ状態で戦場に出る。\\n版図 ― {T}：あなたのマナ・プールに、望む色の組み合わせのマナＸ点を加える。Ｘはあなたがコントロールする土地の中の基本土地タイプの総数に等しい。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422427&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c9985bfb-51be-4717-a15e-9f8b87db4e9d', 'multiverseId': 422427}, 'multiverseid': 422427}, {'name': 'Geoscópio Prismático', 'text': 'Geoscópio Prismático entra no campo de batalha virado.\\nDominar — {T}: Adicione X manas em qualquer combinação de cores a sua reserva de mana, sendo X o número de tipos de terreno básico entre os terrenos que você controla.', 'type': 'Artefato', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422778&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b4f51265-f1b9-407f-8e89-58ad01812b38', 'multiverseId': 422778}, 'multiverseid': 422778}, {'name': '虹彩地镜', 'text': '虹彩地镜须横置进战场。\\n领土～{T}：加X点法术力到你的法术力池中，其颜色组合可任意选择，X为由你操控的地之中基本地类别的数量。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421023&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '588b7e8f-585b-4067-914e-036af15285ef', 'multiverseId': 421023}, 'multiverseid': 421023}]", '[{\'name\': \'Propaganda\', \'text\': \'Kreaturen können dich nicht angreifen, es sei denn, ihr Beherrscher bezahlt {2} für jede dich angreifende Kreatur, die er kontrolliert.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Kosten deines Widerstands werden aus deinem Verstand extrahiert." —Nekusar der Gedankenreißer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421413&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3239513-8270-48b2-a35b-933de51e3755\', \'multiverseId\': 421413}, \'multiverseid\': 421413}, {\'name\': \'Propaganda\', \'text\': \'Las criaturas no pueden atacarte a menos que su controlador pague {2} por cada criatura que controla que te está atacando.\', \'type\': \'Encantamiento\', \'flavor\': \'"El coste de tu oposición se extraerá de tu cordura". —Nekusar, el arrasamentes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423168&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ce184ff-8f78-46fa-bb6f-3bf6276fdc94\', \'multiverseId\': 423168}, \'multiverseid\': 423168}, {\'name\': \'Propagande\', \'text\': "Les créatures ne peuvent pas vous attaquer à moins que leur contrôleur ne paie {2} pour chaque créature qu\'il contrôle qui vous attaque.", \'type\': \'Enchantement\', \'flavor\': "« Le prix de votre opposition sera prélevé sur votre esprit. » —Nekusar, le terrasseur d\'esprit", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421764&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'320d3623-a2e0-45bf-85e8-bcd096c2659d\', \'multiverseId\': 421764}, \'multiverseid\': 421764}, {\'name\': \'Propaganda\', \'text\': \'Le creature non possono attaccarti a meno che il loro controllore non paghi {2} per ogni creatura che controlla che ti sta attaccando.\', \'type\': \'Incantesimo\', \'flavor\': \'"Il costo della vostra opposizione verrà estratto dalla vostre menti." —Nekusar, il Distruttore di Menti\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'80467e01-603e-40e4-9d4c-e8062042457d\', \'multiverseId\': 422115}, \'multiverseid\': 422115}, {\'name\': \'プロパガンダ\', \'text\': \'そのコントローラーが、自分がコントロールするあなたを攻撃しているクリーチャー１体につき{2}を支払わないかぎり、クリーチャーではあなたを攻撃できない。\', \'type\': \'エンチャント\', \'flavor\': \'「敵対したことの対価は、お前の機知から頂くとしよう。」 ――精神破壊者、ネクサル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422466&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d78dbe8-913e-4a84-89d4-a09ba2d34da2\', \'multiverseId\': 422466}, \'multiverseid\': 422466}, {\'name\': \'Propaganda\', \'text\': \'As criaturas não podem atacá-lo a menos que seu controlador pague {2} para cada criatura daquele controlador que está atacando você.\', \'type\': \'Encantamento\', \'flavor\': \'"O custo de sua oposição será extraído de seus pensamentos." — Nekusar, o Arrasador de Mentes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5acaa92-14d1-428f-81a9-42bf9a748802\', \'multiverseId\': 422817}, \'multiverseid\': 422817}, {\'name\': \'宣导\', \'text\': \'对每个生物而言，除非其操控者为其支付{2}，否则它不能攻击你。\', \'type\': \'结界\', \'flavor\': \'「你反抗的代价将从你的智慧中萃取。」 ～毁灵师奈库萨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12cf1e6c-c23c-4f19-a037-c3c282bacd13\', \'multiverseId\': 421062}, \'multiverseid\': 421062}]', "[{'name': 'Prunkvoller Palast', 'text': 'Der Prunkvolle Palast kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {B}, {G} oder {U}.', 'type': 'Land', 'flavor': 'Der dichte Dschungel macht einer üppigen, großzügigen Weite Platz. In ihrer Mitte ragen die Turmspitzen des Qarsi-Palasts empor.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421632&type=card', 'language': 'German', 'identifiers': {'scryfallId': '961c2855-b024-4c94-9dd5-4b4664394129', 'multiverseId': 421632}, 'multiverseid': 421632}, {'name': 'Palacio opulento', 'text': 'El Palacio opulento entra al campo de batalla girado.\\n{T}: Agrega {B}, {G} o {U} a tu reserva de maná.', 'type': 'Tierra', 'flavor': 'La densa selva deja paso a un claro exuberante y suntuoso. En el centro se alzan los chapiteles del Palacio de Qarsi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423387&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0d188646-8121-4487-ada2-d379f1d910ea', 'multiverseId': 423387}, 'multiverseid': 423387}, {'name': 'Palais opulent', 'text': 'Le Palais opulent arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {B}, {G} ou {U} à votre réserve.', 'type': 'Terrain', 'flavor': 'La jungle dense laisse la place à une étendue luxuriante et flamboyante. En son centre se trouvent les tours du Palais de Qarsi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421983&type=card', 'language': 'French', 'identifiers': {'scryfallId': '12c68b58-481d-4f08-9092-e34919dff335', 'multiverseId': 421983}, 'multiverseid': 421983}, {'name': 'Palazzo Opulento', 'text': 'Il Palazzo Opulento entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {B}, {G} o {U} alla tua riserva di mana.', 'type': 'Terra', 'flavor': 'La fitta giungla si apre in una distesa lussureggiante e sontuosa, al cui centro si serrano le spire del Palazzo di Qarsi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422334&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6ab338f1-9269-42cb-8b2d-62b494f18c77', 'multiverseId': 422334}, 'multiverseid': 422334}, {'name': '華やかな宮殿', 'text': '華やかな宮殿はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{B}か{G}か{U}を加える。', 'type': '土地', 'flavor': '鬱蒼としたジャングルは豊穣で豊かな地へと移り変わる。その中心に伸びているのがカルシ宮殿の尖塔である。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422685&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd5096562-a7a5-4a06-b255-8d18eee395e6', 'multiverseId': 422685}, 'multiverseid': 422685}, {'name': 'Palácio Opulento', 'text': 'Palácio Opulento entra no campo de batalha virado.\\n{T}: Adicione {B}, {G} ou {U} à sua reserva de mana.', 'type': 'Terreno', 'flavor': 'Uma grande área exuberante expande-se em meio à selva densa. Em seu centro, ficam as torres do Palácio Qarsi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423036&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dfa7eea9-15f6-4284-848d-a550940bc4bb', 'multiverseId': 423036}, 'multiverseid': 423036}, {'name': '奢华宫殿', 'text': '奢华宫殿须横置进战场。\\n{T}：加{B}，{G}或{U}到你的法术力池中。', 'type': '地', 'flavor': '茂密丛林当中辟出大片富饶奢绮地域，隐约可见卡尔西宫殿的尖顶耸立中央。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421281&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '29509671-3626-4eb8-b30b-4b9a8f373bec', 'multiverseId': 421281}, 'multiverseid': 421281}]", '[{\'name\': \'Psychosenkrabbler\', \'text\': \'Stärke und Widerstandskraft des Psychosenkrabblers sind gleich der Anzahl an Karten auf deiner Hand.\\nImmer wenn du eine Karte ziehst, verliert jeder Gegner 1 Lebenspunkt.\', \'type\': \'Artefaktkreatur — Schrecken\', \'flavor\': \'„Falls dieses Gehirn nicht das Geheimnis des Serums entschlüsseln kann, dann füge noch mehr Gehirn dazu." —Rhmir, Hand des Augurs\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421586&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70fb21ca-08d0-4acf-89e9-46b44988be60\', \'multiverseId\': 421586}, \'multiverseid\': 421586}, {\'name\': \'Rondador de psicosis\', \'text\': \'Tanto la fuerza como la resistencia del Rondador de psicosis son iguales a la cantidad de cartas que haya en tu mano.\\nSiempre que robes una carta, cada oponente pierde 1 vida.\', \'type\': \'Criatura artefacto — Horror\', \'flavor\': \'"Si ese cerebro no puede descubrir el secreto del suero, entonces agreguen más cerebros". —Rhmir, Mano de los presagios\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423341&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7be1bdff-1bb0-400e-9f2d-e2629fdb5d3d\', \'multiverseId\': 423341}, \'multiverseid\': 423341}, {\'name\': \'Rampeur psychotique\', \'text\': "La force et l\'endurance du Rampeur psychotique sont chacune égales au nombre de cartes dans votre main.\\nÀ chaque fois que vous piochez une carte, chaque adversaire perd 1 point de vie.", \'type\': \'Créature-artefact : horreur\', \'flavor\': "« Si ce cerveau est incapable de découvrir le secret du sérum, ajoutez-en quelques-uns de plus. » —Rhmir, Main de l\'Augure", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421937&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fef0e50b-868c-4fd5-b7d0-04e2c9d3517c\', \'multiverseId\': 421937}, \'multiverseid\': 421937}, {\'name\': \'Psicosi Strisciante\', \'text\': \'La forza e la costituzione della Psicosi Strisciante sono pari al numero di carte nella tua mano.\\nOgniqualvolta peschi una carta, ogni avversario perde 1 punto vita.\', \'type\': \'Creatura Artefatto — Orrore\', \'flavor\': \'"Se quel cervello non riesce a capire il segreto del siero, allora aggiungi altro cervello." —Rhmir, Mano dell\\\'Augure\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6de08874-2624-4bf7-a265-f4d38a8a6a32\', \'multiverseId\': 422288}, \'multiverseid\': 422288}, {\'name\': \'精神の病を這うもの\', \'text\': \'精神の病を這うもののパワーとタフネスは、それぞれあなたの手札にあるカードの枚数に等しい。\\nあなたがカードを１枚引くたび、各対戦相手はそれぞれ１点のライフを失う。\', \'type\': \'アーティファクト・クリーチャー — ホラー\', \'flavor\': \'「その脳で血清の秘密が探れぬなら、もっと脳を足してやれ。」 ――卜占の手、ルミーア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422639&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3bd08fa8-d1bb-4fbd-8a80-15c9c6d4438f\', \'multiverseId\': 422639}, \'multiverseid\': 422639}, {\'name\': \'Réptil da Psicose\', \'text\': \'O poder e a resistência de Réptil da Psicose são ambos iguais ao número de cards em sua mão.\\nToda vez que você compra um card, cada oponente perde 1 ponto de vida.\', \'type\': \'Criatura Artefato — Horror\', \'flavor\': \'"Se aquele cérebro não consegue decifrar o segredo do soro, adicione mais cérebros." — Rhmir, Mão do Áugure\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422990&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f3e72ff1-4319-4862-96f7-14da86c1060a\', \'multiverseId\': 422990}, \'multiverseid\': 422990}, {\'name\': \'变态爬虫\', \'text\': \'变态爬虫的力量和防御力各等同于你的手牌数量。\\n每当你抓一张牌时，每位对手各失去1点生命。\', \'type\': \'神器生物～惊惧兽\', \'flavor\': \'「如果那脑子无法理解浆液的秘密，就多加几个脑子。」 ～卜算手信众卢米\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421235&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'56924762-181e-47a1-852b-084c6c23cc55\', \'multiverseId\': 421235}, \'multiverseid\': 421235}]', '[{\'name\': \'Quirion-Kundschafter\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe, das ein Land, das ein Gegner kontrolliert, produzieren könnte.\', \'type\': \'Kreatur — Elf, Druide, Späher\', \'flavor\': \'Habe im Kampf stets einen Freund als Absicherung, Stahl in deinen Händen und Magie in den Adern. —Überzeugung der Quirion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421479&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80177c1d-b6f6-467e-b631-31cd1cd1cfaa\', \'multiverseId\': 421479}, \'multiverseid\': 421479}, {\'name\': \'Reconocedora quirion\', \'text\': \'{T}: Agrega a tu reserva de maná un maná de cualquier color que pudiera producir una tierra que controla un oponente.\', \'type\': \'Criatura — Druida explorador elfo\', \'flavor\': \'Pelea con un amigo detrás de ti, acero en tus manos y magia en tus venas. —Credo Quirion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423234&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc72c47e-5b12-428a-942c-995b37260805\', \'multiverseId\': 423234}, \'multiverseid\': 423234}, {\'name\': \'Exploratrice quirionaise\', \'text\': "{T} : Ajoutez à votre réserve un mana de n\'importe quelle couleur qu\'un terrain contrôlé par un adversaire pourrait produire.", \'type\': \'Créature : elfe et druide et éclaireur\', \'flavor\': "Combat avec un ami dans ton dos, de l\'acier dans tes mains et de la magie dans tes veines. —Credo quirionais", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421830&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53f6b4ed-56a0-4258-8faf-c49ac273f1fa\', \'multiverseId\': 421830}, \'multiverseid\': 421830}, {\'name\': \'Esploratore Quirion\', \'text\': \'{T}: Aggiungi alla tua riserva di mana un mana di un qualsiasi colore che una terra controllata da un avversario potrebbe produrre.\', \'type\': \'Creatura — Esploratore Druido Elfo\', \'flavor\': "Combatti con un amico alle spalle, dell\'acciaio nelle mani e la magia nelle vene. —Credo Quirion", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422181&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'55ad2e7b-d1b2-442f-8642-0cb91be1d191\', \'multiverseId\': 422181}, \'multiverseid\': 422181}, {\'name\': \'クウィリーオンの探検者\', \'text\': \'{T}：あなたのマナ・プールに、対戦相手がコントロールする土地が生み出すことのできる色のうち好きな色１色のマナ１点を加える。\', \'type\': \'クリーチャー — エルフ・ドルイド・スカウト\', \'flavor\': \'背後には友を、手には剣を、血潮には魔術をもって戦え。 ――クウィリーオンの信条\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422532&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'447c88ee-234e-42c9-a8ff-1f5fce4ed54c\', \'multiverseId\': 422532}, \'multiverseid\': 422532}, {\'name\': \'Exploradora Quirion\', \'text\': \'{T}: Adicione à sua reserva de mana um mana de qualquer cor que um terreno controlado por um oponente possa gerar.\', \'type\': \'Criatura — Elfo Druida Batedor\', \'flavor\': \'Lute com um amigo às costas, com aço nas mãos e com magia nas veias. — Credo Quirion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422883&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'126d94a3-6e2f-4ada-aff3-1795bc85218a\', \'multiverseId\': 422883}, \'multiverseid\': 422883}, {\'name\': \'奎利恩探险家\', \'text\': \'{T}：加一点法术力到你的法术力池中，其颜色为由对手操控的地能产生之任一颜色。\', \'type\': \'生物～妖精／德鲁伊／斥候\', \'flavor\': \'与你藤上的魔法、手中的钢铁与身后的朋友共同奋战。 ～奎利恩教条\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421128&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e22f684-3330-4917-8d96-1d9c3eb11237\', \'multiverseId\': 421128}, \'multiverseid\': 421128}]', '[{\'name\': \'Rakdos-Amulett\', \'text\': \'Bestimme eines —\\n• Schicke alle Karten aus dem Friedhof eines Spielers deiner Wahl ins Exil.\\n• Zerstöre ein Artefakt deiner Wahl.\\n• Jede Kreatur fügt ihrem Beherrscher 1 Schadenspunkt zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421537&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91df3364-84ac-4f5e-97bd-b4d7b3e84216\', \'multiverseId\': 421537}, \'multiverseid\': 421537}, {\'name\': \'Amuleto rakdos\', \'text\': \'Elige uno:\\n• Exilia todas las cartas del cementerio del jugador objetivo.\\n• Destruye el artefacto objetivo.\\n• Cada criatura hace 1 punto de daño a su controlador.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423292&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2067088-c231-4578-b32d-f7c55e152362\', \'multiverseId\': 423292}, \'multiverseid\': 423292}, {\'name\': \'Charme de Rakdos\', \'text\': "Choisissez l\'un —\\n• Exilez toutes les cartes depuis le cimetière du joueur ciblé.\\n• Détruisez l\'artefact ciblé.\\n• Chaque créature inflige 1 blessure à son contrôleur.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421888&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'265df2c9-71ba-4b17-9c7e-501cacf17b29\', \'multiverseId\': 421888}, \'multiverseid\': 421888}, {\'name\': \'Talismano Rakdos\', \'text\': \'Scegli uno —\\n• Esilia tutte le carte dal cimitero di un giocatore bersaglio.\\n• Distruggi un artefatto bersaglio.\\n• Ogni creatura infligge 1 danno al suo controllore.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422239&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0ce5ede-c5a1-4e3b-b313-176ecf03f170\', \'multiverseId\': 422239}, \'multiverseid\': 422239}, {\'name\': \'ラクドスの魔除け\', \'text\': \'以下から１つを選ぶ。\\n• プレイヤー１人を対象とし、そのプレイヤーの墓地からすべてのカードを追放する。\\n• アーティファクト１つを対象とし、それを破壊する。\\n• 各クリーチャーはそれぞれ、それのコントローラーに１点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422590&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6503a4d9-2c2b-49de-a258-aa3550740337\', \'multiverseId\': 422590}, \'multiverseid\': 422590}, {\'name\': \'Amuleto Rakdos\', \'text\': \'Escolha um —\\n• Exile todos os cards do cemitério do jogador alvo.\\n• Destrua o artefato alvo.\\n• Cada criatura causa 1 ponto de dano a seu controlador.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422941&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'400aae3c-1528-4b41-a4d7-6dcdc091cd86\', \'multiverseId\': 422941}, \'multiverseid\': 422941}, {\'name\': \'拉铎司护符\', \'text\': \'选择一项～\\n•放逐目标牌手坟墓场中的所有牌。\\n•消灭目标神器。\\n•每个生物各对其操控者造成1点伤害。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421186&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35e969b7-a407-47ec-acd6-1d4ca9dba092\', \'multiverseId\': 421186}, \'multiverseid\': 421186}]', '[{\'name\': \'Rakdos-Petschaft\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {B}{R}.\', \'type\': \'Artefakt\', \'flavor\': \'Es wird aus Knochen gefertigt und in Blut gesiedet, aber ein Rakdos-Petschaft gilt erst dann als vollkommen, wenn es als Mordwaffe verwendet wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421587&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f743a0f4-9336-440f-85bd-10e83c61150e\', \'multiverseId\': 421587}, \'multiverseid\': 421587}, {\'name\': \'Sello rakdos\', \'text\': \'{1}, {T}: Agrega {B}{R} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Hecho de hueso y hervido en sangre, el sello rakdos no está terminado hasta que no se usa como un arma homicida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423342&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40eabe1a-cc71-4269-a4f6-afedab27666f\', \'multiverseId\': 423342}, \'multiverseid\': 423342}, {\'name\': \'Cachet de Rakdos\', \'text\': \'{1}, {T} : Ajoutez {B}{R} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Fait d\'os bouilli dans le sang, un cachet de Rakdos est considéré comme terminé lorsqu\'il a été utilisé comme arme pour un meurtre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421938&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b50df002-3003-462d-bcc7-62852bf4b8a4\', \'multiverseId\': 421938}, \'multiverseid\': 421938}, {\'name\': \'Sigillo Rakdos\', \'text\': \'{1}, {T}: Aggiungi {B}{R} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Costruito con ossa e bollito nel sangue, un sigillo Rakdos non è considerato finito finché non viene usato come arma per un omicidio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422289&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bfa1f7a2-9e20-44f9-bd8b-fc1bb0da6e92\', \'multiverseId\': 422289}, \'multiverseid\': 422289}, {\'name\': \'ラクドスの印鑑\', \'text\': \'{1}, {T}：あなたのマナ・プールに{B}{R}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'ラクドスの印鑑は骨から作られ血で煮られ、さらに殺しの武器として用いられるまでは完成したとみなされない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422640&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ccb3d929-63f8-413b-9d79-5bb2fcf9fcf0\', \'multiverseId\': 422640}, \'multiverseid\': 422640}, {\'name\': \'Sinete Rakdos\', \'text\': \'{1}, {T}: Adicione {B}{R} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Forjado com ossos e fervido em sangue, um Sinete Rakdos não é considerado finalizado até que tenha sido usado como arma assassina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422991&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'52d86730-e553-4f5b-a250-9d548733c8f2\', \'multiverseId\': 422991}, \'multiverseid\': 422991}, {\'name\': \'拉铎司印记\', \'text\': \'{1}，{T}：加{B}{R}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'拉铎司印记以白骨制成，要拿鲜血煮过，并且用来杀生之后才能算是大功告成。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421236&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'698d740f-deac-40d7-a208-01a72a858a1a\', \'multiverseId\': 421236}, \'multiverseid\': 421236}]', "[{'name': 'Rakdos-Schlachtstätte', 'text': 'Die Rakdos-Schlachtstätte kommt getappt ins Spiel.\\nWenn die Rakdos-Schlachtstätte ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {B}{R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421634&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8ffb4286-469d-4306-9d3c-f0eea1e8c519', 'multiverseId': 421634}, 'multiverseid': 421634}, {'name': 'Carnarium rakdos', 'text': 'El Carnarium rakdos entra al campo de batalla girado.\\nCuando el Carnarium rakdos entre al campo de batalla, regresa una tierra que controles a la mano de su propietario.\\n{T}: Agrega {B}{R} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423389&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5a8aeab7-2c8e-4f71-9739-fa5da23a4a39', 'multiverseId': 423389}, 'multiverseid': 423389}, {'name': 'Carnarium de Rakdos', 'text': 'Le Carnarium de Rakdos arrive sur le champ de bataille engagé.\\nQuand le Carnarium de Rakdos arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {B}{R} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421985&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8cddcea8-7e38-4689-8fd7-1c42f2bf0dd7', 'multiverseId': 421985}, 'multiverseid': 421985}, {'name': 'Carnario Rakdos', 'text': 'Il Carnario Rakdos entra nel campo di battaglia TAPpato.\\nQuando il Carnario Rakdos entra nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {B}{R} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422336&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd11c796b-1379-4767-bb04-e80c76d34ce2', 'multiverseId': 422336}, 'multiverseid': 422336}, {'name': 'ラクドスの肉儀場', 'text': 'ラクドスの肉儀場はタップ状態で戦場に出る。\\nラクドスの肉儀場が戦場に出たとき、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{B}{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422687&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ab5e7812-3e98-41a0-b530-f4eb79a2f5e2', 'multiverseId': 422687}, 'multiverseid': 422687}, {'name': 'Carnarium Rakdos', 'text': 'Carnarium Rakdos entra no campo de batalha virado.\\nQuando Carnarium Rakdos entrar no campo de batalha, devolva um terreno que você controla para a mão de seu dono\\n{T}: Adicione {B}{R} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423038&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2b5e4809-39a0-4683-a7c7-8daa85ec1e96', 'multiverseId': 423038}, 'multiverseid': 423038}, {'name': '拉铎司剜祭场', 'text': '拉铎司剜祭场须横置进战场。\\n当拉铎司剜祭场进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{B}{R}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421283&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6ef3e6aa-ad0c-4823-8355-3a11d5dd1ba8', 'multiverseId': 421283}, 'multiverseid': 421283}]", '[{\'name\': \'Rauchende Köpfe\', \'text\': \'Zusammenarbeiten — Beginnend mit dir kann jeder Spieler eine beliebige Menge Mana bezahlen. Jeder Spieler zieht X Karten, wobei X gleich der Gesamtmenge des auf diese Weise bezahlten Manas ist.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421412&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'53166a38-7663-411b-85d8-47fbdc443e62\', \'multiverseId\': 421412}, \'multiverseid\': 421412}, {\'name\': \'Mentes que brillan\', \'text\': \'Unir fuerzas — Comenzando contigo, cada jugador puede pagar cualquier cantidad de maná. Cada jugador roba X cartas, donde X es la cantidad total de maná pagado de esta manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423167&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13e49786-c92f-4bf1-b25f-cbae1f90659f\', \'multiverseId\': 423167}, \'multiverseid\': 423167}, {\'name\': \'Brillance des esprits\', \'text\': "Union des forces — En commençant par vous, chaque joueur peut payer n\'importe quelle quantité de mana. Chaque joueur pioche X cartes, X étant la quantité totale de mana payée de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421763&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d88efc56-d7fb-4a8e-bfab-1abbcf5be0d3\', \'multiverseId\': 421763}, \'multiverseid\': 421763}, {\'name\': \'Menti Raggianti\', \'text\': "Unire le forze — A partire da te, ogni giocatore può pagare un qualsiasi ammontare di mana. Ogni giocatore pesca X carte, dove X è pari all\'ammontare totale di mana pagato in questo modo.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422114&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9dda45e5-a3f4-4c4e-8354-d7dce8ac2553\', \'multiverseId\': 422114}, \'multiverseid\': 422114}, {\'name\': \'精神の輝き\', \'text\': \'同調 ― あなたから始めて、各プレイヤーはそれぞれ、望む点数のマナを支払ってもよい。各プレイヤーはそれぞれＸ枚のカードを引く。Ｘはこれにより支払われたマナの点数の合計に等しい。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422465&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dffbdc53-6638-47ed-b4fe-f6814042eec4\', \'multiverseId\': 422465}, \'multiverseid\': 422465}, {\'name\': \'Mentes Brilhantes\', \'text\': \'Unir forças — A começar por você, cada jogador pode pagar qualquer quantidade de mana. Cada jogador compra X cards, sendo X o total de mana pago desta forma.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422816&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'438cfd0b-c2c6-4806-9e6d-01f04ed7d86e\', \'multiverseId\': 422816}, \'multiverseid\': 422816}, {\'name\': \'心神光辉\', \'text\': \'携手～从你开始，每位牌手各可以支付任意数量的法术力。每位牌手各抓X张牌，X为以此法支付之法术力总数量。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421061&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5a0034a-253c-4507-a54e-38db91682900\', \'multiverseId\': 421061}, \'multiverseid\': 421061}]', '[{\'name\': \'Ravos, Führer der Seelen\', \'text\': \'Fliegend\\nAndere Kreaturen, die du kontrollierst, erhalten +1/+1.\\nZu Beginn deines Versorgungssegments kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurückbringen.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421358&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe96632c-af17-43c5-aa16-423f11456be4\', \'multiverseId\': 421358}, \'multiverseid\': 421358}, {\'name\': \'Rafhos, cuidador de almas\', \'text\': \'Vuela.\\nLas otras criaturas que controlas obtienen +1/+1.\\nAl comienzo de tu mantenimiento, puedes regresar la carta de criatura objetivo de tu cementerio a tu mano.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423113&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d96fb97-cafe-4ef4-bb28-add2df9ba339\', \'multiverseId\': 423113}, \'multiverseid\': 423113}, {\'name\': "Ravos, veilleur d\'âmes", \'text\': \'Vol\\nLes autres créatures que vous contrôlez gagnent +1/+1.\\nAu début de votre entretien, vous pouvez renvoyer une carte de créature ciblée depuis votre cimetière dans votre main.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)\', \'type\': \'Créature légendaire : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421709&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53b6a6de-463a-4c96-a62b-222c134a9b29\', \'multiverseId\': 421709}, \'multiverseid\': 421709}, {\'name\': \'Ravos, Guardiano di Anime\', \'text\': "Volare\\nLe altre creature che controlli prendono +1/+1.\\nAll\'inizio del tuo mantenimento, puoi riprendere in mano una carta creatura bersaglio dal tuo cimitero.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)", \'type\': \'Creatura Leggendaria — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422060&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ba15745-a8fa-4712-bca8-8f001a5f5f48\', \'multiverseId\': 422060}, \'multiverseid\': 422060}, {\'name\': \'魂の守護者、ラーボス\', \'text\': \'飛行\\nあなたがコントロールする他のクリーチャーは＋１/＋１の修整を受ける。\\nあなたのアップキープの開始時に、あなたの墓地からクリーチャー・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422411&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2c9fa69-372f-4d18-a0d1-45aca2ac8e65\', \'multiverseId\': 422411}, \'multiverseid\': 422411}, {\'name\': \'Ravos, Protetor das Almas\', \'text\': \'Voar\\nAs outras criaturas que você controla recebem +1/+1.\\nNo início de sua manutenção, você pode devolver o card de criatura alvo de seu cemitério para a sua mão.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422762&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62ba8284-ae33-4003-bbd4-0ad9076734be\', \'multiverseId\': 422762}, \'multiverseid\': 422762}, {\'name\': \'护魂使剌活斯\', \'text\': \'飞行\\n由你操控的其他生物得+1/+1。\\n在你的维持开始时，你可以将目标生物牌从你的坟墓场移回你手上。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421007&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7395f56e-a1cc-4545-aeba-49ed7209baf8\', \'multiverseId\': 421007}, \'multiverseid\': 421007}]', '[{\'name\': \'Resteverwertung\', \'text\': \'Immer wenn ein Gegner eine Kreaturenkarte abwirft, erzeuge einen 2/2 schwarzen Zombie-Kreaturenspielstein.\\nImmer wenn ein Gegner eine Länderkarte abwirft, erhöhe deinen Manavorrat um {B}{B}.\\nImmer wenn ein Gegner eine Karte abwirft, die weder eine Kreatur noch ein Land ist, ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421436&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65e8aa08-bc05-4e2f-a922-c477f90dfc66\', \'multiverseId\': 421436}, \'multiverseid\': 421436}, {\'name\': \'Nada se desperdicia\', \'text\': \'Siempre que un oponente descarte una carta de criatura, crea una ficha de criatura Zombie negra 2/2.\\nSiempre que un oponente descarte una carta de tierra, agrega {B}{B} a tu reserva de maná.\\nSiempre que un oponente descarte una carta que no sea de criatura o de tierra, roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423191&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6bb7a321-f499-4457-a5cc-52eb8fff607c\', \'multiverseId\': 423191}, \'multiverseid\': 423191}, {\'name\': "Rien n\'est jamais gâché", \'text\': "À chaque fois qu\'un adversaire se défausse d\'une carte de créature, créez un jeton de créature 2/2 noire Zombie.\\nÀ chaque fois qu\'un adversaire se défausse d\'une carte de terrain, ajoutez {B}{B} à votre réserve.\\nÀ chaque fois qu\'un adversaire se défausse d\'une carte non-créature non-terrain, piochez une carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421787&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f9058230-c408-41e3-873e-4e019225fbac\', \'multiverseId\': 421787}, \'multiverseid\': 421787}, {\'name\': \'Nulla Va Sprecato\', \'text\': \'Ogniqualvolta un avversario scarta una carta creatura, crea una pedina creatura Zombie 2/2 nera.\\nOgniqualvolta un avversario scarta una carta terra, aggiungi {B}{B} alla tua riserva di mana.\\nOgniqualvolta un avversario scarta una carta non creatura, non terra, pesca una carta.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422138&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1739818-3a9a-4b44-90e0-d835e3616c2d\', \'multiverseId\': 422138}, \'multiverseid\': 422138}, {\'name\': \'無駄省き\', \'text\': \'対戦相手がクリーチャー・カードを１枚捨てるたび、黒の２/２のゾンビ・クリーチャー・トークンを１体生成する。\\n対戦相手が土地・カードを１枚捨てるたび、あなたのマナ・プールに{B}{B}を加える。\\n対戦相手がクリーチャーでも土地でもないカードを１枚捨てるたび、カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422489&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'376a25fb-bcbf-42c9-9356-1d9cc6fd2578\', \'multiverseId\': 422489}, \'multiverseid\': 422489}, {\'name\': \'Não Desperdiçar\', \'text\': \'Toda vez que um oponente descartar um card de criatura, crie uma ficha de criatura preta 2/2 do tipo Zumbi.\\nToda vez que um oponente descartar um card de terreno, adicione {B}{B} à sua reserva de mana.\\nToda vez que um oponente descartar um card que não seja terreno nem criatura, compre um card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422840&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d5a80c8-96e5-44f7-b97d-c2e8a5ae3b70\', \'multiverseId\': 422840}, \'multiverseid\': 422840}, {\'name\': \'物尽其用\', \'text\': \'每当一位对手弃一张生物牌时，派出一个2/2黑色灵俑衍生生物。\\n每当一位对手弃一张地牌时，加{B}{B}到你的法术力池中。\\n每当一位对手弃一张非生物且非地的牌时，你抓一张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421085&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'605d7477-b06a-4fbd-b522-3399cac0b9f4\', \'multiverseId\': 421085}, \'multiverseid\': 421085}]', '[{\'name\': \'Reyhan, die letzte Abzan\', \'text\': \'Reyhan, die letzte Abzan, kommt mit drei +1/+1-Marken ins Spiel.\\nImmer wenn eine Kreatur, die du kontrollierst, stirbt oder in die Kommandozone gelegt wird und falls eine oder mehrere +1/+1-Marken auf ihr lagen, kannst du entsprechend viele +1/+1-Marken auf eine Kreatur deiner Wahl legen.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421359&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b5bd3360-9406-4497-8030-6b0109598ebf\', \'multiverseId\': 421359}, \'multiverseid\': 421359}, {\'name\': \'Reyhan, última Abzan\', \'text\': \'Reyhan, última Abzan entra al campo de batalla con tres contadores +1/+1 sobre ella.\\nSiempre que una criatura que controlas muera o vaya a la zona de mando, si tenía uno o más contadores +1/+1 sobre ella, puedes poner esa misma cantidad de contadores +1/+1 sobre la criatura objetivo.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423114&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3119729b-8520-4ce5-aa63-5dab082161f4\', \'multiverseId\': 423114}, \'multiverseid\': 423114}, {\'name\': \'Reyhan, dernière des Abzans\', \'text\': "Reyhan, dernière des Abzans arrive sur le champ de bataille avec trois marqueurs +1/+1 sur elle.\\nÀ chaque fois qu\'une créature que vous contrôlez meurt ou est mise dans la zone de commandement, si elle avait au moins un marqueur +1/+1 sur elle, vous pouvez mettre autant de marqueurs +1/+1 sur la créature ciblée.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e979d9d0-672c-4b27-adf0-eef89d266303\', \'multiverseId\': 421710}, \'multiverseid\': 421710}, {\'name\': \'Reyhan, Ultima degli Abzan\', \'text\': \'Reyhan, Ultima degli Abzan entra nel campo di battaglia con tre segnalini +1/+1.\\nOgniqualvolta una creatura che controlli muore o viene messa nella zona di comando, se aveva uno o più segnalini +1/+1, puoi mettere altrettanti segnalini +1/+1 su una creatura bersaglio.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)\', \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422061&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65ec06cf-dbda-420d-9751-9105cfcfb01e\', \'multiverseId\': 422061}, \'multiverseid\': 422061}, {\'name\': \'最後のアブザン、レイハン\', \'text\': \'最後のアブザン、レイハンは、＋１/＋１カウンターが３個置かれた状態で戦場に出る。\\nあなたがコントロールするクリーチャーが１体死亡するか統率領域に置かれるたび、それの上に＋１/＋１カウンターが１個以上置かれていた場合、クリーチャー１体を対象とする。あなたはそれの上に＋１/＋１カウンターを同じ個数置いてもよい。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422412&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4477e4ca-f60f-48a3-b437-cff3e7fe04c1\', \'multiverseId\': 422412}, \'multiverseid\': 422412}, {\'name\': \'Reyhan, Última dos Abzan\', \'text\': \'Reyhan, Última dos Abzan, entra no campo de batalha com três marcadores +1/+1.\\nToda vez que uma criatura que você controla morre ou é colocada na zona de comando, se ela tiver um ou mais marcadores +1/+1, você pode colocar aquela quantidade de marcadores +1/+1 na criatura alvo.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422763&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'17a2f99a-252e-4690-9de5-addf27d9ba98\', \'multiverseId\': 422763}, \'multiverseid\': 422763}, {\'name\': \'阿布赞末代可汗蕾翰\', \'text\': \'阿布赞末代可汗蕾翰进战场时上面有三个+1/+1指示物。\\n每当一个由你操控的生物死去或置入统帅区时，若其上有一个或数个+1/+1指示物，则你可以在目标生物上放置等量的+1/+1指示物。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421008&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b0b2a42-c8c6-4a20-b31d-075fe73656d4\', \'multiverseId\': 421008}, \'multiverseid\': 421008}]', '[{\'name\': \'Riff der Schiffe des Grauens\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {C}.\\n{1}, {T}: Lege eine Speichermarke auf das Riff der Schiffe des Grauens.\\n{1}, entferne X Speichermarken vom Riff der Schiffe des Grauens: Erhöhe deinen Manavorrat um X Mana einer beliebigen Kombination aus {U} und/oder {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421612&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e4014776-179d-4c64-a6cb-b51ac3601644\', \'multiverseId\': 421612}, \'multiverseid\': 421612}, {\'name\': \'Arrecife nave pavorosa\', \'text\': \'{T}: Agrega {C} a tu reserva de maná.\\n{1}, {T}: Pon un contador de almacenaje sobre el Arrecife nave pavorosa.\\n{1}, remover X contadores de almacenaje del Arrecife nave pavorosa: Agrega X manás de cualquier combinación de {U} y/o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423367&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'242c3bbb-35f4-4ecf-a06f-58107682d569\', \'multiverseId\': 423367}, \'multiverseid\': 423367}, {\'name\': "Brisants du navire de l\'effroi", \'text\': "{T} : Ajoutez {C} à votre réserve.\\n{1}, {T} : Mettez un marqueur « stock » sur les Brisants du navire de l\'effroi.\\n{1}, retirez X marqueurs « stock » des Brisants du navire de l\'effroi : Ajoutez X manas de n\'importe quelle combinaison de {U} et/ou {B} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421963&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'adaf8212-35f6-4529-bd97-dd03415a182e\', \'multiverseId\': 421963}, \'multiverseid\': 421963}, {\'name\': \'Barriera Terrore delle Navi\', \'text\': \'{T}: Aggiungi {C} alla tua riserva di mana.\\n{1}, {T}: Metti un segnalino magazzino sulla Barriera Terrore delle Navi.\\n{1}, Rimuovi X segnalini magazzino dalla Barriera Terrore delle Navi: Aggiungi X mana in qualsiasi combinazione di {U} e/o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422314&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a51ddc1b-7a5b-4b44-a68b-8fe1f7fcc013\', \'multiverseId\': 422314}, \'multiverseid\': 422314}, {\'name\': \'戦慄艦の浅瀬\', \'text\': \'{T}：あなたのマナ・プールに{C}を加える。\\n{1}, {T}：戦慄艦の浅瀬の上に貯蔵カウンターを１個置く。\\n{1}, 戦慄艦の浅瀬の上から貯蔵カウンターをＸ個取り除く：合計Ｘ点の{U}や{B}をあなたのマナ・プールに加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422665&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'021629ec-99b5-4fc8-aa00-5ef26bf21b70\', \'multiverseId\': 422665}, \'multiverseid\': 422665}, {\'name\': \'Recifes da Nau-terror\', \'text\': \'{T}: Adicione {C} à sua reserva de mana.\\n{1}, {T}: Coloque um marcador de estocagem em Recifes da Nau-terror.\\n{1}, Remova X marcadores de estocagem de Recifes da Nau-terror: Adicione X manas em qualquer combinação de {U} e/ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423016&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5748e4de-b475-4d8a-8585-129abb9952e1\', \'multiverseId\': 423016}, \'multiverseid\': 423016}, {\'name\': \'惧舰礁岩\', \'text\': \'{T}：加{C}到你的法术力池中。\\n{1}，{T}：在惧舰礁岩上放置一个储藏指示物。\\n{1}，从惧舰礁岩上移去X个储藏指示物：加X点法术力到你的法术力池中，且为{U}和／或{B}的任意组合。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421261&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b25ef548-1a2b-448b-9dec-af26e3237218\', \'multiverseId\': 421261}, \'multiverseid\': 421261}]', '[{\'name\': \'Rituale des Gedeihens\', \'text\': \'Zu Beginn des Ziehsegments jedes Spielers zieht dieser Spieler eine zusätzliche Karte.\\nJeder Spieler darf in jedem seiner Züge ein zusätzliches Land spielen.\', \'type\': \'Verzauberung\', \'flavor\': \'„Tanzt und springt in großen Kreisen! Das Ritual verbindet uns mit Gaea und nährt uns mit den reichen Gaben der Erde."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421482&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9238155c-c1a4-404f-bbda-697b936ecade\', \'multiverseId\': 421482}, \'multiverseid\': 421482}, {\'name\': \'Ritos de florecimiento\', \'text\': \'Al comienzo del paso de robar de cada jugador, ese jugador roba una carta adicional.\\nCada jugador puede jugar una tierra adicional durante cada uno de sus turnos.\', \'type\': \'Encantamiento\', \'flavor\': \'"¡Baila, y acerca el espiral! Es un cordón umbilical a Gaia, alimentándonos con el regalo de la tierra fértil".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423237&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8357d8c8-7928-48b4-b429-073bbbf48f96\', \'multiverseId\': 423237}, \'multiverseid\': 423237}, {\'name\': "Sacres de l\'abondance", \'text\': "Au début de l\'étape de pioche de chaque joueur, ce joueur pioche une carte supplémentaire.\\nChaque joueur peut jouer un terrain supplémentaire pendant chacun de ses tours.", \'type\': \'Enchantement\', \'flavor\': "« Dansez, et apportez l\'annelure ! C\'est le cordon ombilical qui nous relie à Gaia et nous engraisse avec les trésors de la terre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421833&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'61b6565e-ee27-42a9-9414-306e4fa187f7\', \'multiverseId\': 421833}, \'multiverseid\': 421833}, {\'name\': "Rituali d\'Abbondanza", \'text\': "All\'inizio dell\'acquisizione di ogni giocatore, quel giocatore pesca una carta addizionale.\\nOgni giocatore può giocare una terra addizionale in ognuno dei propri turni.", \'type\': \'Incantesimo\', \'flavor\': \'"Danza e porta qui la corda! È un cordone ombelicale con la stessa Gea, che ci ingrassa con la ricca abbondanza della terra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422184&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b2793646-79cc-46d9-8e11-d6b4a5bd337b\', \'multiverseId\': 422184}, \'multiverseid\': 422184}, {\'name\': \'栄華の儀式\', \'text\': \'各プレイヤーのドロー・ステップの開始時に、そのプレイヤーはカードを追加で１枚引く。\\n各プレイヤーの各ターンに、そのプレイヤーは追加の土地を１つプレイしてもよい。\', \'type\': \'エンチャント\', \'flavor\': \'「踊ろう！そして螺旋を描こう！これはガイア自身の臍帯だ。我々を肥やすために大地がくれた豊かなる恵みなんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422535&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2bf443cd-e71e-4b4c-a1ee-afb103b7f10f\', \'multiverseId\': 422535}, \'multiverseid\': 422535}, {\'name\': \'Ritos de Desabrochar\', \'text\': \'No início da etapa de compra de cada jogador, aquele jogador compra um card adicional.\\nCada jogador pode jogar um terreno adicional em cada um de seus turnos.\', \'type\': \'Encantamento\', \'flavor\': \'"Dancem e tragam o cordão! Esse é o cordão umbilical da própria Geia, que nos alimenta com as ricas delícias da terra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422886&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7add5381-51cd-4bc7-b715-71bca007c63d\', \'multiverseId\': 422886}, \'multiverseid\': 422886}, {\'name\': \'茁壮仪式\', \'text\': \'在每位牌手的抓牌步骤开始时，该牌手额外抓一张牌。\\n每位牌手在自己的每个回合中均可以额外使用一个地。\', \'type\': \'结界\', \'flavor\': \'「以舞蹈引领这盘卷！它宛如盖亚赐予的脐带，以大地的丰饶滋养我们。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421131&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'974d48da-f045-449b-82c2-423af2f29410\', \'multiverseId\': 421131}, \'multiverseid\': 421131}]', '[{\'name\': \'Runenhorn-Höllendrache\', \'text\': \'Fliegend\\n{5}{R}, schicke den Runenhorn-Höllendrachen aus deinem Friedhof ins Exil: Jeder Spieler wirft alle Karten aus seiner Hand ab und zieht dann sieben Karten.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Graviert mit Runen, älter noch als der Drache selbst, sind seine Hörner von einer eigenen, uralten Macht erfüllt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421339&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f936691-46e5-4cbe-89d8-28f4ccabd8f1\', \'multiverseId\': 421339}, \'multiverseid\': 421339}, {\'name\': \'Engendro astarruna\', \'text\': \'Vuela.\\n{5}{R}, exiliar al Engendro astarruna desde tu cementerio: Cada jugador descarta su mano y luego roba siete cartas.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Grabados con runas anteriores al dragón, los cuernos poseen su propia magia antigua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423094&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2d158dc-58ea-4c3a-b95c-127c2581270d\', \'multiverseId\': 423094}, \'multiverseid\': 423094}, {\'name\': \'Escouflenfer cornerune\', \'text\': "Vol\\n{5}{R}, exilez l\'Escouflenfer cornerune depuis votre cimetière : Chaque joueur se défausse de sa main, puis pioche sept cartes.", \'type\': \'Créature : dragon\', \'flavor\': \'Ses cornes, gravées de runes plus anciennes que le dragon, possèdent leur propre magie ancestrale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421690&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2eb56b63-6952-4946-9e33-b94ba2a7c891\', \'multiverseId\': 421690}, \'multiverseid\': 421690}, {\'name\': \'Nibbio Infernale Cornorunico\', \'text\': \'Volare\\n{5}{R}, Esilia il Nibbio Infernale Cornorunico dal tuo cimitero: Ogni giocatore scarta la propria mano, poi pesca sette carte.\', \'type\': \'Creatura — Drago\', \'flavor\': \'Incise con rune più antiche del drago stesso, le corna racchiudono una propria magia arcaica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422041&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ade2ecd-2b74-4927-87bd-9d9018f7c190\', \'multiverseId\': 422041}, \'multiverseid\': 422041}, {\'name\': \'ルーン角のヘルカイト\', \'text\': \'飛行\\n{5}{R}, あなたの墓地からルーン角のヘルカイトを追放する：各プレイヤーはそれぞれ、自分の手札を捨てその後カードを７枚引く。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'ドラゴン以前の時代に遡るルーンが刻まれた角は、それ自体が太古の魔力を宿している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3cac9b1e-677b-4b3c-a2a2-030a0f1d7336\', \'multiverseId\': 422392}, \'multiverseid\': 422392}, {\'name\': \'Dragão Avérneo Cornorúnico\', \'text\': \'Voar\\n{5}{R}, Exile Dragão Avérneo Cornorúnico de seu cemitério: Cada jogador descarta a própria mão e depois compra sete cards.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'Entalhados com runas mais antigas que o dragão, os chifres possuem sua própria magia ancestral.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422743&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54d3732a-ec9a-47bd-917c-7c1f7f3fe6f5\', \'multiverseId\': 422743}, \'multiverseid\': 422743}, {\'name\': \'符角残虐者\', \'text\': \'飞行\\n{5}{R}，从你的坟墓场放逐符角残虐者：每位牌手弃掉其手牌，然后各抓七张牌。\', \'type\': \'生物～龙\', \'flavor\': \'巨龙将比自己更为古老的符文铭刻在犄角上，好让其上的远古魔法充盈其间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420988&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'94715e74-526d-440c-afb8-ba0c6bca55a1\', \'multiverseId\': 420988}, \'multiverseid\': 420988}]', '[{\'name\': \'Runenlesen\', \'text\': \'Ziehe X Karten. Für jede auf diese Weise gezogene Karte wirf entweder eine Karte aus deiner Hand ab oder opfere eine bleibende Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Welt ist ein Rätsel, und das Gedächtnis ist der Schlüssel dazu."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421414&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a35ff63-d72b-4d33-b1d0-e666a6448ed8\', \'multiverseId\': 421414}, \'multiverseid\': 421414}, {\'name\': \'Leer las runas\', \'text\': \'Roba X cartas. Por cada carta robada de esta manera, descarta una carta a menos que sacrifiques un permanente.\', \'type\': \'Instantáneo\', \'flavor\': \'"El mundo es un enigma y la mente es la clave".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423169&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a1e2182-c235-4487-9660-83c07fb172f1\', \'multiverseId\': 423169}, \'multiverseid\': 423169}, {\'name\': \'Déchiffrage des runes\', \'text\': "Piochez X cartes. Pour chaque carte piochée de cette manière, défaussez-vous d\'une carte à moins que vous ne sacrifiiez un permanent.", \'type\': \'Éphémère\', \'flavor\': "« Le monde est une énigme dont l\'esprit est la clé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421765&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'19015bc0-bbdd-4800-9e66-4d939b4096bb\', \'multiverseId\': 421765}, \'multiverseid\': 421765}, {\'name\': \'Leggere le Rune\', \'text\': \'Pesca X carte. Per ogni carta pescata in questo modo, scarta una carta a meno che non sacrifichi un permanente.\', \'type\': \'Istantaneo\', \'flavor\': \'"Il mondo è un enigma e la mente è la chiave per risolverlo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422116&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6dce279-4c54-4f30-849c-e468fc79d5b4\', \'multiverseId\': 422116}, \'multiverseid\': 422116}, {\'name\': \'ルーンの解読\', \'text\': \'カードをＸ枚引く。これにより引いたカード１枚につき、あなたがパーマネント１つを生け贄に捧げないかぎりカード１枚を捨てる。\', \'type\': \'インスタント\', \'flavor\': \'「世界は謎で、精神がそれを解く鍵だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422467&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b4d6cb72-4571-4ae0-a02d-402e4b2546a4\', \'multiverseId\': 422467}, \'multiverseid\': 422467}, {\'name\': \'Ler as Runas\', \'text\': \'Compre X cards. Para cada card comprado desta forma, descarte um card a menos que você sacrifique uma permanente.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O mundo é um enigma, e a mente é a chave."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dac0fb00-48e8-4003-ac2b-0de7bc850444\', \'multiverseId\': 422818}, \'multiverseid\': 422818}, {\'name\': \'解读符文\', \'text\': \'抓X张牌。每以此法抓一张牌，除非你牺牲一个永久物，否则便弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「世界是个谜团，心灵即其锁匙。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421063&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe7392c6-1b46-4d28-a968-60c416640505\', \'multiverseId\': 421063}, \'multiverseid\': 421063}]', "[{'name': 'Rückenfels-Hügelchen', 'text': 'Refugium (Dieses Land kommt getappt ins Spiel. Wenn dies geschieht, schaue dir die obersten vier Karten deiner Bibliothek an, schicke eine davon verdeckt ins Exil und lege den Rest unter deine Bibliothek.)\\n{T}: Erhöhe deinen Manavorrat um {R}.\\n{R}, {T}: Falls einem Gegner in diesem Zug bereits 7 oder mehr Schadenspunkte zugefügt wurden, kannst du die ins Exil geschickte Karte spielen, ohne ihre Manakosten zu bezahlen.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421646&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd2ea813f-2b2b-41c1-8d0c-095522b4a08d', 'multiverseId': 421646}, 'multiverseid': 421646}, {'name': 'Loma espina rocosa', 'text': 'Esconder. (Esta tierra entra al campo de batalla girada. Cuando lo haga, mira las cuatro primeras cartas de tu biblioteca, exilia una boca abajo y luego pon el resto en el fondo de tu biblioteca.)\\n{T}: Agrega {R} a tu reserva de maná.\\n{R}, {T}: Puedes jugar la carta exiliada sin pagar su coste de maná si un oponente recibió 7 o más puntos de daño este turno.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423401&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0914bf61-b04d-4e19-95c9-0cbeb77066b3', 'multiverseId': 423401}, 'multiverseid': 423401}, {'name': 'Tertre de Rochépine', 'text': 'Cachette (Ce terrain arrive sur le champ de bataille engagé. Quand il le fait, regardez les quatre cartes du dessus de votre bibliothèque, exilez-en une face cachée, puis mettez le reste au-dessous de votre bibliothèque.)\\n{T} : Ajoutez {R} à votre réserve.\\n{R}, {T} : Vous pouvez jouer la carte exilée sans payer son coût de mana si un adversaire a subi au moins 7 blessures ce tour-ci.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421997&type=card', 'language': 'French', 'identifiers': {'scryfallId': '514d2cc8-3ac8-40b5-9e37-32dd7290db4a', 'multiverseId': 421997}, 'multiverseid': 421997}, {'name': 'Poggio Spina Rocciosa', 'text': 'Nascondiglio (Questa terra entra nel campo di battaglia TAPpata. Quando lo fa, guarda le prime quattro carte del tuo grimorio, esiliane una a faccia in giù, poi metti le altre in fondo al tuo grimorio.)\\n{T}: Aggiungi {R} alla tua riserva di mana.\\n{R}, {T}: Puoi giocare la carta esiliata senza pagare il suo costo di mana se a un avversario sono stati inflitti 7 o più danni in questo turno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422348&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b2227db3-b7fc-4639-9c37-fcf42602a39d', 'multiverseId': 422348}, 'multiverseid': 422348}, {'name': '背骨岩の小山', 'text': '秘匿（この土地はタップ状態で戦場に出る。そうしたとき、あなたのライブラリーの一番上から４枚のカードを見て、そのうち１枚を裏向きで追放し、残りをあなたのライブラリーの一番下に置く。）\\n{T}：あなたのマナ・プールに{R}を加える。\\n{R}, {T}：このターンに対戦相手１人に７点以上のダメージが与えられていたなら、あなたはその追放されたカードをそのマナ・コストを支払うことなくプレイしてもよい。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422699&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0f5a56ce-9505-43c0-8ad8-4717bfd0a143', 'multiverseId': 422699}, 'multiverseid': 422699}, {'name': 'Colina da Rocha Espinhosa', 'text': 'Refúgio (Este terreno entra no campo de batalha virado. Quando ele entrar, olhe os quatro cards do topo de seu grimório, exile um com a face voltada para baixo, e depois coloque o restante no fundo de seu grimório.)\\n{T}: Adicione {R} à sua reserva de mana.\\n{R}, {T}: Você pode jogar o card exilado sem pagar seu custo de mana se um oponente sofreu 7 pontos de dano ou mais neste turno.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423050&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '63b9a701-dae4-4d85-ab65-55526250009d', 'multiverseId': 423050}, 'multiverseid': 423050}, {'name': '脊石圆丘', 'text': '掩蔽（此地须横置进战场。当它进战场时，检视你牌库顶的四张牌，将其中一张牌面朝下地放逐，然后将其余的牌置于你牌库底。）\\n{T}：加{R}到你的法术力池中。\\n{R}，{T}：如果某对手在本回合中受过7点或更多伤害，则你可以使用所放逐的牌，且不需支付其法术力费用。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421295&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '80873a07-3cc7-4ab5-871c-b59d02ba6b95', 'multiverseId': 421295}, 'multiverseid': 421295}]", '[{\'name\': \'Rückeroberung des Waldes\', \'text\': \'Schicke bis zu zwei Artefakte und/oder Verzauberungen deiner Wahl ins Exil.\\nStandardlandumwandlung {2} ({2}, wirf diese Karte ab: Durchsuche deine Bibliothek nach einer Standardland-Karte, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421363&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'047a1250-3aa5-4249-bd99-808a487aa8b9\', \'multiverseId\': 421363}, \'multiverseid\': 421363}, {\'name\': \'Reclamación silvana\', \'text\': \'Exilia hasta dos artefactos y/o encantamientos objetivo.\\nCiclo de tierras básicas {2}. ({2}, descartar esta carta: Busca en tu biblioteca una carta de tierra básica, muéstrala y ponla en tu mano. Luego baraja tu biblioteca.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423118&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7c934822-e111-4d1f-a04c-8aa6b012eb77\', \'multiverseId\': 423118}, \'multiverseid\': 423118}, {\'name\': \'Défrichement sylvestre\', \'text\': "Exilez jusqu\'à deux artefacts et/ou enchantements ciblés.\\nRecyclage de terrain de base {2} ({2}, défaussez-vous de cette carte : Cherchez dans votre bibliothèque une carte de terrain de base, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421714&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85424526-50c5-4a41-9ddc-31fbe4cdaff6\', \'multiverseId\': 421714}, \'multiverseid\': 421714}, {\'name\': \'Rivendicazione Silvana\', \'text\': \'Esilia fino a due artefatti e/o incantesimi bersaglio.\\nCicloterra base {2} ({2}, Scarta questa carta: Passa in rassegna il tuo grimorio per una carta terra base, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422065&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30a8aef0-b291-4965-8c77-e724d1e41771\', \'multiverseId\': 422065}, \'multiverseid\': 422065}, {\'name\': \'森の再生\', \'text\': \'アーティファクトやエンチャント最大２つを対象とし、それらを追放する。\\n基本土地サイクリング{2}（{2}, このカードを捨てる：あなたのライブラリーから基本土地・カード１枚を探し、それを公開してあなたの手札に加える。その後あなたのライブラリーを切り直す。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422416&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'617d4aa9-2196-4302-92ed-14acc882865a\', \'multiverseId\': 422416}, \'multiverseid\': 422416}, {\'name\': \'Reivindicação Silvestre\', \'text\': \'Exile até dois artefatos e/ou encantamentos alvo.\\nReciclar terreno básico {2} ({2}, Descarte este card: Procure em seu grimório um card de terreno básico, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422767&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'971e429a-8812-49ca-9cd4-d92549be2f29\', \'multiverseId\': 422767}, \'multiverseid\': 422767}, {\'name\': \'森林垦殖\', \'text\': \'放逐至多两个目标神器和／或结界。\\n循环基本地{2}（{2}，弃掉此牌：从你的牌库中搜寻一张基本地牌，展示该牌，并置于你手上。然后将你的牌库洗牌。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f28ae38c-cd8f-4c87-a6d0-1c9cc6da0843\', \'multiverseId\': 421012}, \'multiverseid\': 421012}]', '[{\'name\': \'Samen der Erneuerung\', \'text\': \'Unverzagt (Dieser Zauberspruch kostet beim Wirken für jeden Gegner {1} weniger.)\\nBringe bis zu zwei Karten deiner Wahl aus deinem Friedhof auf deine Hand zurück. Schicke die Samen der Erneuerung ins Exil.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421343&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c2ea9af-4bdd-43f2-a1ac-f1339efd118f\', \'multiverseId\': 421343}, \'multiverseid\': 421343}, {\'name\': \'Semillas de renovación\', \'text\': \'Audacia. (Cuesta {1} menos lanzar este hechizo por cada oponente.)\\nRegresa hasta dos cartas objetivo de tu cementerio a tu mano. Exilia las Semillas de renovación.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423098&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15f74a10-7083-4800-aa86-b94ece9b77ce\', \'multiverseId\': 423098}, \'multiverseid\': 423098}, {\'name\': \'Graines du renouveau\', \'text\': "Témérité (Ce sort coûte {1} de moins à lancer pour chaque adversaire.)\\nRenvoyez jusqu\'à deux cartes ciblées depuis votre cimetière dans votre main. Exilez les Graines du renouveau.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421694&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ddb14e0-5f7a-4166-860d-3fba6fb1f50b\', \'multiverseId\': 421694}, \'multiverseid\': 421694}, {\'name\': \'Semi del Rinnovamento\', \'text\': \'Impavido (Questa magia costa {1} in meno per essere lanciata per ogni avversario.)\\nRiprendi in mano fino a due carte bersaglio dal tuo cimitero. Esilia i Semi del Rinnovamento.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'45a1af42-4b16-47ac-bfdd-c934c0b99bb1\', \'multiverseId\': 422045}, \'multiverseid\': 422045}, {\'name\': \'蘇生の二粒\', \'text\': \'不抜（この呪文を唱えるためのコストは対戦相手１人につき{1}少なくなる。）\\nあなたの墓地からカード最大２枚を対象とし、それらをあなたの手札に戻す。蘇生の二粒を追放する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422396&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d383c3f9-bdfc-47c1-9a67-796bbad60d8a\', \'multiverseId\': 422396}, \'multiverseid\': 422396}, {\'name\': \'Sementes da Renovação\', \'text\': \'Inabalável (Esta mágica custa {1} a menos por cada oponente para ser conjurada.)\\nDevolva até dois cards alvo de seu cemitério para sua mão. Exile Sementes da Renovação.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422747&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d6eb608-4926-4dc6-9996-3ac7b8e2cf7b\', \'multiverseId\': 422747}, \'multiverseid\': 422747}, {\'name\': \'新生萌芽\', \'text\': \'不屈（每有一位对手，此咒语便减少{1}来施放。）\\n将至多两张目标牌从你的坟墓场移回你手上。放逐新生萌芽。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420992&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bbc49f92-6692-4752-945c-228ead8bafdb\', \'multiverseId\': 420992}, \'multiverseid\': 420992}]', '[{\'name\': \'Samtschwingen-Dommelgreif\', \'text\': \'Aufblitzen\\nFliegend\\nKreaturen, die ins Spiel kommen, lösen keine Fähigkeiten aus.\', \'type\': \'Kreatur — Hippogryph\', \'flavor\': \'Die Dommelgreife, die über den Dächern von Gaven kreisen, strahlen ein überwältigendes Gefühl der Ruhe aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421387&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'730549e7-6436-4b01-9fdf-6b0cba6dfa7d\', \'multiverseId\': 421387}, \'multiverseid\': 421387}, {\'name\': \'Gryff alas sosegadoras\', \'text\': \'Destello.\\nVuela.\\nLas criaturas no hacen que se disparen habilidades cuando entran al campo de batalla.\', \'type\': \'Criatura — Hipogrifo\', \'flavor\': \'Una sobrecogedora sensación de calma acompaña a los gryffs que sobrevuelan los tejados de Gavony.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423142&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4bef34dc-5ced-4e63-a4f5-5e3c76534bcc\', \'multiverseId\': 423142}, \'multiverseid\': 423142}, {\'name\': \'Gryff aux ailes apaisantes\', \'text\': \'Flash\\nVol\\nLes créatures qui arrivent sur le champ de bataille ne provoquent pas le déclenchement des capacités.\', \'type\': \'Créature : hippogriffe\', \'flavor\': "Un calme absolu règne sur les toits de Gavonie à l\'approche de ces gryffs majestueux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421738&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fdafcf5b-ce4a-49b4-94cb-91afa9414348\', \'multiverseId\': 421738}, \'multiverseid\': 421738}, {\'name\': \'Gryff Alaquieta\', \'text\': \'Lampo\\nVolare\\nLe creature che entrano nel campo di battaglia non fanno innescare le abilità.\', \'type\': \'Creatura — Ippogrifo\', \'flavor\': \'Un profondo senso di quiete accompagna i gryff che volano in cerchio sopra i tetti di Gavony.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422089&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c999db56-25d8-4a80-b4e2-d324aa196653\', \'multiverseId\': 422089}, \'multiverseid\': 422089}, {\'name\': \'静翼のグリフ\', \'text\': \'瞬速\\n飛行\\n戦場に出るクリーチャーは能力を誘発させない。\', \'type\': \'クリーチャー — ヒポグリフ\', \'flavor\': \'圧倒的な静けさとともに、グリフたちはガヴォニーの上空を周回する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422440&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f538f5f0-3002-4126-98ca-db6dd55648d1\', \'multiverseId\': 422440}, \'multiverseid\': 422440}, {\'name\': \'Grifino das Asas Serenas\', \'text\': \'Lampejo\\nVoar\\nAs criaturas não desencadeiam habilidades ao entrar no campo de batalha.\', \'type\': \'Criatura — Hipogrifo\', \'flavor\': \'Uma sensação de calma extrema acompanha os grifinos que sobrevoam os telhados de Gavony.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422791&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5d7df08-83f4-4cff-8119-7e682ded1e66\', \'multiverseId\': 422791}, \'multiverseid\': 422791}, {\'name\': \'肃息骏鹭\', \'text\': \'闪现\\n飞行\\n进战场的生物不会触发异能。\', \'type\': \'生物～骏鹰\', \'flavor\': \'在加渥尼房顶上空盘旋的骏鹭带有一种压倒性的静谧感。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421036&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'22bec8eb-8456-4549-a3b5-42c6a6341f24\', \'multiverseId\': 421036}, \'multiverseid\': 421036}]', "[{'name': 'Sandsteppenzitadelle', 'text': 'Die Sandsteppenzitadelle kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W}, {B} oder {G}.', 'type': 'Land', 'flavor': 'Was standhaft ist, überlebt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421639&type=card', 'language': 'German', 'identifiers': {'scryfallId': '14a87e23-2519-4fbc-99cb-3c615e38000e', 'multiverseId': 421639}, 'multiverseid': 421639}, {'name': 'Ciudadela esteparenosa', 'text': 'La Ciudadela esteparenosa entra al campo de batalla girada.\\n{T}: Agrega {W}, {B} o {G} a tu reserva de maná.', 'type': 'Tierra', 'flavor': 'Aquello que resiste, sobrevive.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423394&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '871af05e-c550-4087-8907-58dce3d9dcc6', 'multiverseId': 423394}, 'multiverseid': 423394}, {'name': 'Citadelle de la steppe de sable', 'text': 'La Citadelle de la steppe de sable arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W}, {B} ou {G} à votre réserve.', 'type': 'Terrain', 'flavor': 'Ce qui perdure survit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421990&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3a7315f6-df61-49ac-b852-7de026da9188', 'multiverseId': 421990}, 'multiverseid': 421990}, {'name': 'Roccaforte delle Steppe Sabbiose', 'text': 'La Roccaforte delle Steppe Sabbiose entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {W}, {B} o {G} alla tua riserva di mana.', 'type': 'Terra', 'flavor': 'Ciò che resiste, sopravvive.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422341&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9c0ca6cb-ea9d-40d3-b0a9-d2156f768824', 'multiverseId': 422341}, 'multiverseid': 422341}, {'name': '砂草原の城塞', 'text': '砂草原の城塞はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{B}か{G}を加える。', 'type': '土地', 'flavor': '耐久できるものだけが生き残る。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422692&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '84028d4d-0d3e-48c8-93f8-cfa317615509', 'multiverseId': 422692}, 'multiverseid': 422692}, {'name': 'Cidadela da Estepe Arenosa', 'text': 'Cidadela da Estepe Arenosa entra no campo de batalha virado.\\n{T}: Adicione {W}, {B} ou {G} à sua reserva de mana.', 'type': 'Terreno', 'flavor': 'Aquilo que resiste sobrevive.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423043&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd9b922c0-a45e-4989-aeab-96283b347e7a', 'multiverseId': 423043}, 'multiverseid': 423043}, {'name': '沙原殿堂', 'text': '沙原殿堂须横置进战场。\\n{T}：加{W}，{B}或{G}到你的法术力池中。', 'type': '地', 'flavor': '坚韧者方得生存。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421288&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b1348bf5-d2e0-4e43-bffc-b03de48f7766', 'multiverseId': 421288}, 'multiverseid': 421288}]", '[{\'name\': \'Sangumagier\', \'text\': \'Fliegend\\nImmer wenn eine Kreatur, die ein Gegner kontrolliert, stirbt, kannst du 3 Lebenspunkte dazuerhalten.\\nImmer wenn ein Gegner eine Karte abwirft, kannst du 3 Lebenspunkte dazuerhalten.\', \'type\': \'Kreatur — Vampir, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421435&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c47674d6-7b43-49f4-a665-044ac698a81c\', \'multiverseId\': 421435}, \'multiverseid\': 421435}, {\'name\': \'Sangromante\', \'text\': \'Vuela.\\nSiempre que una criatura que controla un oponente muera, puedes ganar 3 vidas.\\nSiempre que un oponente descarte una carta, puedes ganar 3 vidas.\', \'type\': \'Criatura — Chamán vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423190&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e88ab101-2e49-474f-824e-8eb305b7297d\', \'multiverseId\': 423190}, \'multiverseid\': 423190}, {\'name\': \'Sangromancienne\', \'text\': "Vol\\nÀ chaque fois qu\'une créature qu\'un adversaire contrôle meurt, vous pouvez gagner 3 points de vie.\\nÀ chaque fois qu\'un adversaire se défausse d\'une carte, vous pouvez gagner 3 points de vie.", \'type\': \'Créature : vampire et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421786&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0dde5728-80dd-48c5-9094-d9b9a01e359f\', \'multiverseId\': 421786}, \'multiverseid\': 421786}, {\'name\': \'Ematomante\', \'text\': \'Volare\\nOgniqualvolta una creatura controllata da un avversario muore, puoi guadagnare 3 punti vita.\\nOgniqualvolta un avversario scarta una carta, puoi guadagnare 3 punti vita.\', \'type\': \'Creatura — Sciamano Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422137&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eadfa3d5-e697-4095-ad0f-8be2984f0823\', \'multiverseId\': 422137}, \'multiverseid\': 422137}, {\'name\': \'吸血術士\', \'text\': \'飛行\\n対戦相手がコントロールするクリーチャーが１体死亡するたび、あなたは３点のライフを得てもよい。\\n対戦相手がカードを１枚捨てるたび、あなたは３点のライフを得てもよい。\', \'type\': \'クリーチャー — 吸血鬼・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422488&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9032aa6e-289f-4c51-a4c2-7b7e7a74c52a\', \'multiverseId\': 422488}, \'multiverseid\': 422488}, {\'name\': \'Sangromante\', \'text\': \'Voar\\nToda vez que uma criatura que um oponente controla morre, você pode ganhar 3 pontos de vida.\\nToda vez que um oponente descarta um card, você pode ganhar 3 pontos de vida.\', \'type\': \'Criatura — Vampiro Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422839&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c3f6dda-260d-4170-9f58-99ab993d296b\', \'multiverseId\': 422839}, \'multiverseid\': 422839}, {\'name\': \'鲜血术士\', \'text\': \'飞行\\n每当一个由对手操控的生物死去时，你可以获得3点生命。\\n每当一位对手弃一张牌时，你可以获得3点生命。\', \'type\': \'生物～吸血鬼／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421084&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6ef73309-5826-44be-8d5f-f5aaac7fa018\', \'multiverseId\': 421084}, \'multiverseid\': 421084}]', '[{\'name\': \'Saskia die Unbeugsame\', \'text\': \'Wachsamkeit, Eile\\nSowie Saskia die Unbeugsame ins Spiel kommt, bestimme einen Spieler.\\nImmer wenn eine Kreatur, die du kontrollierst, einem Spieler Kampfschaden zufügt, fügt sie dem bestimmten Spieler ebenso viele Schadenspunkte zu.\', \'type\': \'Legendäre Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421360&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55d82308-4cbf-46d1-bf0f-ddb29357fb85\', \'multiverseId\': 421360}, \'multiverseid\': 421360}, {\'name\': \'Saskia la Inclemente\', \'text\': \'Vigilancia, prisa.\\nEn cuanto Saskia la Inclemente entre al campo de batalla, elige un jugador.\\nSiempre que una criatura que controlas haga daño de combate a un jugador, hace esa misma cantidad de daño al jugador elegido.\', \'type\': \'Criatura legendaria — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423115&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'749fd550-64ff-40a1-a6e1-0b19eef834b2\', \'multiverseId\': 423115}, \'multiverseid\': 423115}, {\'name\': "Saskia l\'inflexible", \'text\': "Vigilance, célérité\\nAu moment où Saskia l\'inflexible arrive sur le champ de bataille, choisissez un joueur.\\nÀ chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à un joueur, elle inflige autant de blessures au joueur choisi.", \'type\': \'Créature légendaire : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b68af50-d752-4296-abd7-1c211dec9899\', \'multiverseId\': 421711}, \'multiverseid\': 421711}, {\'name\': "Saskia l\'Implacabile", \'text\': "Cautela, rapidità\\nMentre Saskia l\'Implacabile entra nel campo di battaglia, scegli un giocatore.\\nOgniqualvolta una creatura che controlli infligge danno da combattimento a un giocatore, infligge altrettanti danni al giocatore scelto.", \'type\': \'Creatura Leggendaria — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a35ebff5-7492-45c7-9310-2a0767d0206f\', \'multiverseId\': 422062}, \'multiverseid\': 422062}, {\'name\': \'不撓のサスキア\', \'text\': \'警戒、速攻\\n不撓のサスキアが戦場に出るに際し、プレイヤー１人を選ぶ。\\nあなたがコントロールするクリーチャー１体がプレイヤー１人に戦闘ダメージを与えるたび、それはその点数に等しいダメージを選ばれたプレイヤーに与える。\', \'type\': \'伝説のクリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422413&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20682900-9625-4c15-8358-bea588fe485f\', \'multiverseId\': 422413}, \'multiverseid\': 422413}, {\'name\': \'Saskia, a Inabalável\', \'text\': \'Vigilância, ímpeto\\nConforme Saskia, a Inabalável, entrar no campo de batalha, escolha um jogador.\\nToda vez que uma criatura que você controla causa dano de combate a um jogador, ela causa aquela quantidade de dano ao jogador escolhido.\', \'type\': \'Criatura Lendária — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422764&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b80ecd83-5f58-4dfe-b967-b856c981808b\', \'multiverseId\': 422764}, \'multiverseid\': 422764}, {\'name\': \'刚毅的撒姬亚\', \'text\': \'警戒，敏捷\\n当刚毅的撒姬亚进战场时，选择一位牌手。\\n每当一个由你操控的生物对任一牌手造成战斗伤害时，它对所选择的牌手造成等量的伤害。\', \'type\': \'传奇生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421009&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'994614c3-c4b0-4b1a-8ec4-870101f92e74\', \'multiverseId\': 421009}, \'multiverseid\': 421009}]', '[{\'name\': \'Satyr-Pfadfinder\', \'text\': \'Wenn der Satyr-Pfadfinder ins Spiel kommt, decke die obersten vier Karten deiner Bibliothek auf. Du kannst davon eine Länderkarte auf deine Hand nehmen. Lege den Rest auf deinen Friedhof.\', \'type\': \'Kreatur — Satyr\', \'flavor\': \'Der erste Satyr, der nach einem rauschenden Fest wieder das Bewusstsein erlangt, muss einen Ort für die nächste Feier ausfindig machen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421484&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72414276-a721-4c43-8601-288359631719\', \'multiverseId\': 421484}, \'multiverseid\': 421484}, {\'name\': \'Sátiro buscacaminos\', \'text\': \'Cuando el Sátiro buscacaminos entre al campo de batalla, muestra las primeras cuatro cartas de tu biblioteca. Puedes poner en tu mano una carta de tierra que se encuentre entre ellas. Pon el resto en tu cementerio.\', \'type\': \'Criatura — Sátiro\', \'flavor\': \'El sátiro que se despierte primero después de un festín tiene que buscar el lugar del siguiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423239&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b50bae8-9a98-4d86-9994-cc65a129c5a6\', \'multiverseId\': 423239}, \'multiverseid\': 423239}, {\'name\': \'Guidevoie satyre\', \'text\': \'Quand le Guidevoie satyre arrive sur le champ de bataille, révélez les quatre cartes du dessus de votre bibliothèque. Vous pouvez mettre une carte de terrain parmi elles dans votre main. Mettez le reste dans votre cimetière.\', \'type\': \'Créature : satyre\', \'flavor\': "Le premier satyre qui s\'éveille après une orgie doit trouver le lieu de la suivante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421835&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e493980-2904-4068-b4c8-57b8c650c594\', \'multiverseId\': 421835}, \'multiverseid\': 421835}, {\'name\': \'Satiro Apripista\', \'text\': \'Quando il Satiro Apripista entra nel campo di battaglia, rivela le prime quattro carte del tuo grimorio. Puoi aggiungere alla tua mano una carta terra scelta tra esse. Metti le altre nel tuo cimitero.\', \'type\': \'Creatura — Satiro\', \'flavor\': \'Il satiro che si sveglia per primo dopo un baccanale deve cercare il luogo che ospiterà il prossimo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422186&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb89f735-948d-4762-a703-06c0a6c346d3\', \'multiverseId\': 422186}, \'multiverseid\': 422186}, {\'name\': \'サテュロスの道探し\', \'text\': \'サテュロスの道探しが戦場に出たとき、あなたのライブラリーの一番上からカードを４枚公開する。あなたは、それらの中から土地・カード１枚をあなたの手札に加えてもよい。残りをあなたの墓地に置く。\', \'type\': \'クリーチャー — サテュロス\', \'flavor\': \'お祭りの後に目覚めた最初のサテュロスは、次のお祭りの現場を探さなければならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422537&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13e2795d-756f-4f4d-94f1-29129acec545\', \'multiverseId\': 422537}, \'multiverseid\': 422537}, {\'name\': \'Sátiro Trilheiro\', \'text\': \'Quando Sátiro Trilheiro entrar no campo de batalha, revele os quatro cards do topo de seu grimório. Você pode colocar um card de terreno dentre eles em sua mão. Coloque o restante em seu cemitério.\', \'type\': \'Criatura — Sátiro\', \'flavor\': \'O primeiro sátiro que acorda depois de uma festança deve procurar um local para a próxima.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422888&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3227e299-5ca5-489e-927b-84e62fe81403\', \'multiverseId\': 422888}, \'multiverseid\': 422888}, {\'name\': \'引路羊蹄人\', \'text\': \'当引路羊蹄人进战场时，展示你牌库顶的四张牌。你可以将其中一张地牌置于你手上。将其余的牌置入你的坟墓场。\', \'type\': \'生物～羊蹄人\', \'flavor\': \'在欢宴后第一个苏醒的羊蹄人，必须负责寻找下一场欢宴的地点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421133&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba7f82d6-fd9c-4a57-8bad-a6bc8e85ea9e\', \'multiverseId\': 421133}, \'multiverseid\': 421133}]', '[{\'name\': \'Schamanische Offenbarung\', \'text\': \'Ziehe für jede Kreatur, die du kontrollierst, eine Karte.\\nWildheit — Du erhältst für jede Kreatur mit Stärke 4 oder mehr, die du kontrollierst, 4 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Erst das Geflüster längst vergangener Tage. Dann Visionen von zukünftigen Ereignissen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1dc7292b-2fcd-4f26-a3dd-39a1c4a644d3\', \'multiverseId\': 421486}, \'multiverseid\': 421486}, {\'name\': \'Revelación chamánica\', \'text\': \'Roba una carta por cada criatura que controlas.\\nFerocidad — Ganas 4 vidas por cada criatura que controlas con fuerza de 4 o más.\', \'type\': \'Conjuro\', \'flavor\': \'Primero llegaron los susurros de los días pasados. Después, las visiones de lo que aún no había ocurrido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423241&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85aad656-ccc7-4dec-b027-d5f17a9d0189\', \'multiverseId\': 423241}, \'multiverseid\': 423241}, {\'name\': \'Révélation shamanique\', \'text\': \'Piochez une carte pour chaque créature que vous contrôlez.\\nFérocité — Vous gagnez 4 points de vie pour chaque créature de force supérieure ou égale à 4 que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "D\'abord des murmures des jours passés. Puis des visions des événements à venir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421837&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f65fe43-3db9-4e09-afd6-fa779a052745\', \'multiverseId\': 421837}, \'multiverseid\': 421837}, {\'name\': \'Rivelazione Sciamanica\', \'text\': \'Pesca una carta per ogni creatura che controlli.\\nFerocia — Guadagni 4 punti vita per ogni creatura con forza pari o superiore a 4 che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'Prima, sussurri di tempi antichi. Poi, visioni di cose a venire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422188&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b974811e-0cd6-464a-b124-004972190a39\', \'multiverseId\': 422188}, \'multiverseid\': 422188}, {\'name\': \'巫師の天啓\', \'text\': \'あなたがコントロールするクリーチャー１体につきカードを１枚引く。\\n獰猛 ― あなたはあなたがコントロールするパワーが４以上のクリーチャー１体につき４点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'最初に古き時代からの囁きあり。そして、これより起こることの幻視が続く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422539&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9016c11-d54a-4caf-921e-4f46eddce6fe\', \'multiverseId\': 422539}, \'multiverseid\': 422539}, {\'name\': \'Revelação Xamânica\', \'text\': \'Compre um card para cada criatura que você controla.\\nFeroz — Você ganha 4 pontos de vida para cada criatura que você controla com poder igual ou superior a 4.\', \'type\': \'Feitiço\', \'flavor\': \'Primeiro, sussurros dos tempos antigos. Depois, visões do porvir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422890&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8482a000-2621-4da9-b47e-76abed8b7f45\', \'multiverseId\': 422890}, \'multiverseid\': 422890}, {\'name\': \'祭师启示\', \'text\': \'你每操控一个生物，便抓一张牌。\\n威猛～你每操控一个力量等于或大于4的生物，便获得4点生命。\', \'type\': \'法术\', \'flavor\': \'先是呢喃细语述说远古过往。后有万千景象展现动荡未来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421135&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55b64a9a-b5da-423b-9716-de3346e71a0a\', \'multiverseId\': 421135}, \'multiverseid\': 421135}]', '[{\'name\': \'Schattenblut-Grat\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {B}{R}.\', \'type\': \'Land\', \'flavor\': \'Der Boden Otarias zeigt immer noch die Spuren von Gemetzeln längst vergangener Konflikte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421644&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac36edce-b33c-4f09-af02-90fc707a2f8e\', \'multiverseId\': 421644}, \'multiverseid\': 421644}, {\'name\': \'Cordillera Sangresombra\', \'text\': \'{1}, {T}: Agrega {B}{R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'La masacre de conflictos pasados aún mancha la tierra otariana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f3839b1-7f6e-42e0-9037-85d3356de803\', \'multiverseId\': 423399}, \'multiverseid\': 423399}, {\'name\': "Contreforts d\'Ombresang", \'text\': \'{1}, {T} : Ajoutez {B}{R} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Le sang des conflits d\'autrefois souille encore le sol d\'Otaria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421995&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5f311142-c7f5-4f06-817b-5c867dd8ddf8\', \'multiverseId\': 421995}, \'multiverseid\': 421995}, {\'name\': \'Costa di Sangueombra\', \'text\': \'{1}, {T}: Aggiungi {B}{R} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Le carneficine dei conflitti di tempi lontani macchiano ancora il terreno di Otaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422346&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40f53011-dfa5-4453-be93-a8af53f40cdf\', \'multiverseId\': 422346}, \'multiverseid\': 422346}, {\'name\': \'シャドーブラッドの尾根\', \'text\': \'{1}, {T}：あなたのマナ・プールに{B}{R}を加える。\', \'type\': \'土地\', \'flavor\': \'長きに渡った昔の闘争の血の痕跡が、いまだにオタリアの土にしみついている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422697&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb4721cc-8705-41eb-a2dc-36b69ef3b181\', \'multiverseId\': 422697}, \'multiverseid\': 422697}, {\'name\': \'Serra de Sanguesombra\', \'text\': \'{1}, {T}: Adicione {B}{R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'A carnificina dos conflitos há muito encerrados ainda macula o solo otariano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423048&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f6532ec-d32c-4b9c-9e1a-841f133f03c4\', \'multiverseId\': 423048}, \'multiverseid\': 423048}, {\'name\': \'暗血山脊\', \'text\': \'{1}，{T}：加{B}{R}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'昔日争战的大屠杀，至今仍污染着欧塔利亚的土地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421293&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6a723bcb-9a29-4516-ab49-99c1916a1df7\', \'multiverseId\': 421293}, \'multiverseid\': 421293}]', '[{\'name\': \'Schicksalsrad\', \'text\': \'Aussetzen 4 — {1}{R} (Statt diese Karte aus deiner Hand zu wirken, bezahle {1}{R}, schicke sie ins Exil und lege vier Zeitmarken auf sie. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn die letzte Zeitmarke entfernt wird, wirke die Karte, ohne ihre Manakosten zu bezahlen.)\\nJeder Spieler wirft alle Karten aus seiner Hand ab und zieht dann sieben Karten.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421457&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5dd3da21-1c80-418f-985b-44706c84ea86\', \'multiverseId\': 421457}, \'multiverseid\': 421457}, {\'name\': \'Rueda del destino\', \'text\': \'Suspender 4—{1}{R}. (En lugar de lanzar esta carta de tu mano, paga {1}{R} y exíliala con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, lánzala sin pagar su coste de maná.)\\nCada jugador descarta su mano, luego roba siete cartas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423212&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'481e9f7a-ecbb-4697-9c2e-c30967015eff\', \'multiverseId\': 423212}, \'multiverseid\': 423212}, {\'name\': \'Roue du destin\', \'text\': \'Suspension 4 — {1}{R} (Plutôt que lancer cette carte depuis votre main, payez {1}{R} et exilez-la avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand le dernier marqueur est retiré, lancez cette carte sans payer son coût de mana.)\\nChaque joueur se défausse de sa main, puis pioche sept cartes.\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421808&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bfb449b-0318-493e-bcee-1554fd6894ae\', \'multiverseId\': 421808}, \'multiverseid\': 421808}, {\'name\': \'Ruota del Fato\', \'text\': "Sospendere 4—{1}{R} (Invece di lanciare questa carta dalla tua mano, paga {1}{R} ed esiliala con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando l\'ultimo viene rimosso, lancia la carta senza pagare il suo costo di mana.)\\nOgni giocatore scarta la propria mano, poi pesca sette carte.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422159&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c3a8b409-132c-44e8-a080-02f994a9e8bf\', \'multiverseId\': 422159}, \'multiverseid\': 422159}, {\'name\': \'命運の輪\', \'text\': \'待機４―{1}{R}（このカードをあなたの手札から唱えるのではなく、{1}{R}を支払って時間カウンターを４個置いた状態で追放する。あなたのアップキープの開始時に、時間カウンターを１個取り除く。最後の１個を取り除いたとき、これをそのマナ・コストを支払うことなく唱える。）\\n各プレイヤーはそれぞれ、自分の手札を捨てその後カードを７枚引く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422510&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4de9047e-57cf-4238-a962-95bb5dbc8b17\', \'multiverseId\': 422510}, \'multiverseid\': 422510}, {\'name\': \'Roda do Destino\', \'text\': \'Suspender 4 — {1}{R} (Em vez de conjurar este card da sua mão, pague {1}{R} e exile-o com quatro marcadores temporais. No início de sua manutenção, remova um marcador temporal. Quando o último for removido, conjure-o sem pagar seu custo de mana.)\\nCada jogador descarta a própria mão e depois compra sete cards.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f8c4688-62e2-4234-9b22-3b857c77880b\', \'multiverseId\': 422861}, \'multiverseid\': 422861}, {\'name\': \'宿命之轮\', \'text\': \'延缓4～{1}{R}（除了从你手上施放此牌，你能支付{1}{R}并将它放逐，且上面有四个计时指示物。在你的维持开始时，从其上移去一个计时指示物。当移去最后一个时，施放它且不需支付其法术力费用。）\\n每位牌手弃掉其手牌，然后各抓七张牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421106&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9f2ac0cd-fddd-4b10-8947-c1c7f0fb50e2\', \'multiverseId\': 421106}, \'multiverseid\': 421106}]', '[{\'name\': \'Schimmernder Myr\', \'text\': \'Aufblitzen\\nDu kannst Artefaktzauber wirken, als ob sie Aufblitzen hätten.\', \'type\': \'Artefaktkreatur — Myr\', \'flavor\': \'Er entgeht den Phyrexianern, indem er sich in den Nischen zwischen Sekunden versteckt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421588&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea7790b5-9656-445d-9cc0-977329d0d58b\', \'multiverseId\': 421588}, \'multiverseid\': 421588}, {\'name\': \'Myr de espejismo\', \'text\': \'Destello.\\nPuedes lanzar los hechizos de artefacto como si tuvieran la habilidad de destello.\', \'type\': \'Criatura artefacto — Myr\', \'flavor\': \'Evade a los pirexianos escondiéndose en el espacio que hay entre los segundos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423343&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'665bebbe-f062-42de-b5c3-c20f386a575e\', \'multiverseId\': 423343}, \'multiverseid\': 423343}, {\'name\': \'Myr scintillant\', \'text\': "Flash\\nVous pouvez lancer les sorts d\'artefact comme s\'ils avaient le flash.", \'type\': \'Créature-artefact : myr\', \'flavor\': \'Il échappe aux Phyrexians en disparaissant dans les espaces entre les secondes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421939&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'382f3b1d-a088-4c75-95ad-40e4a91645e5\', \'multiverseId\': 421939}, \'multiverseid\': 421939}, {\'name\': \'Myr Scintillante\', \'text\': \'Lampo\\nPuoi lanciare magie artefatto come se avessero lampo.\', \'type\': \'Creatura Artefatto — Myr\', \'flavor\': "Sfugge ai Phyrexian nascondendosi negli spazi tra un secondo e l\'altro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422290&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af1d2985-e61d-49c8-b83a-811386d18328\', \'multiverseId\': 422290}, \'multiverseid\': 422290}, {\'name\': \'蜃気楼のマイア\', \'text\': \'瞬速\\nあなたはアーティファクト・呪文を、それが瞬速を持っているかのように唱えてもよい。\', \'type\': \'アーティファクト・クリーチャー — マイア\', \'flavor\': \'それは秒の隙間に隠れてファイレクシア人をやり過ごす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422641&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63b8e5a1-e9bd-48b1-aebe-82730913aec7\', \'multiverseId\': 422641}, \'multiverseid\': 422641}, {\'name\': \'Myr da Cintilação\', \'text\': \'Lampejo\\nVocê pode conjurar mágicas de artefato como se tivessem lampejo.\', \'type\': \'Criatura Artefato — Myr\', \'flavor\': \'Para fugir dos phyrexianos, ele se esconde nos espaços entre os segundos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422992&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b053a84-5b02-489b-aac4-7fbb76494a40\', \'multiverseId\': 422992}, \'multiverseid\': 422992}, {\'name\': \'烁光秘耳\', \'text\': \'闪现\\n你可以将神器咒语视同具有闪现异能地来施放。\', \'type\': \'神器生物～秘耳\', \'flavor\': \'它遁入秒与秒的间隙，好避开非瑞克西亚人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421237&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6f327887-6779-4e5c-ad09-b06b720f2ed2\', \'multiverseId\': 421237}, \'multiverseid\': 421237}]', '[{\'name\': \'Schlussakt\', \'text\': \'Unverzagt (Dieser Zauberspruch kostet beim Wirken für jeden Gegner {1} weniger.)\\nZerstöre zwei Kreaturen deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das Publikum soll kriegen, wonach es verlangt." —Juri, Inhaber von Juris Revue\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421332&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a1cbd4e-0d02-46ea-852a-fce05e63104b\', \'multiverseId\': 421332}, \'multiverseid\': 421332}, {\'name\': \'Ovación final\', \'text\': \'Audacia. (Cuesta {1} menos lanzar este hechizo por cada oponente.)\\nDestruye dos criaturas objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Damos al público lo que quiere". —Juri, propietario del elenco de Juri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423087&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'269784e2-e670-4dc1-9b48-1cde2691104b\', \'multiverseId\': 423087}, \'multiverseid\': 423087}, {\'name\': \'Grand numéro\', \'text\': \'Témérité (Ce sort coûte {1} de moins à lancer pour chaque adversaire.)\\nDétruisez deux créatures ciblées.\', \'type\': \'Éphémère\', \'flavor\': "« Nous donnons au public ce qu\'il veut voir. » —Juri, propriétaire de la Revue de Juri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'559a6dbc-dc98-4aa5-95cd-885c3552544e\', \'multiverseId\': 421683}, \'multiverseid\': 421683}, {\'name\': \'Cala il Sipario\', \'text\': \'Impavido (Questa magia costa {1} in meno per essere lanciata per ogni avversario.)\\nDistruggi due creature bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Diamo al pubblico ciò che desidera." —Juri, proprietario della Rivista di Juri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91139ba6-52c3-48b5-b98d-43466478ae72\', \'multiverseId\': 422034}, \'multiverseid\': 422034}, {\'name\': \'幕切れ\', \'text\': \'不抜（この呪文を唱えるためのコストは対戦相手１人につき{1}少なくなる。）\\nクリーチャー２体を対象とし、それらを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「観客が見たがってる演目をやるのさ。」 ――ジョーリ組の経営者、ジョーリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422385&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe1ad398-6b2a-4535-a5b9-04816842cd49\', \'multiverseId\': 422385}, \'multiverseid\': 422385}, {\'name\': \'Cai o Pano\', \'text\': \'Inabalável (Esta mágica custa {1} a menos por cada oponente para ser conjurada.)\\nDestrua duas criaturas alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Nós damos o que o público quer." — Juri, proprietário da Revista de Juri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422736&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb4ebca3-2083-41f8-9fcf-a90c9194b204\', \'multiverseId\': 422736}, \'multiverseid\': 422736}, {\'name\': \'谢幕演出\', \'text\': \'不屈（每有一位对手，此咒语便减少{1}来施放。）\\n消灭两个目标生物。\', \'type\': \'瞬间\', \'flavor\': \'「我们要做的就是迎合观众。」 ～裘里剧团业主裘里\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'32a4e75f-cdd9-46ca-ae4a-49b0a8821a20\', \'multiverseId\': 420981}, \'multiverseid\': 420981}]', '[{\'name\': \'Schuldeinflößer\', \'text\': \'Verursacht Furcht (Diese Kreatur kann außer von Artefaktkreaturen und/oder schwarzen Kreaturen nicht geblockt werden.)\\nImmer wenn der Schuldeinflößer angreift und nicht geblockt wird, verliert der verteidigende Spieler 1 Lebenspunkt für jede Karte in seinem Friedhof.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421431&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f1e8fb71-48ce-44ab-b932-c81ce3e864a7\', \'multiverseId\': 421431}, \'multiverseid\': 421431}, {\'name\': \'Comeculpa\', \'text\': \'Inspirar temor. (Esta criatura no puede ser bloqueada excepto por criaturas artefacto y/o criaturas negras.)\\nSiempre que el Comeculpa ataque y no sea bloqueado, el jugador defensor pierde 1 vida por cada carta en su cementerio.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423186&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'481ec298-5fd0-4f64-9d06-114151b64722\', \'multiverseId\': 423186}, \'multiverseid\': 423186}, {\'name\': \'Culpabilivore\', \'text\': "Peur (Cette créature ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures noires.)\\nÀ chaque fois que le Culpabilivore attaque et qu\'il n\'est pas bloqué, le joueur défenseur perd 1 point de vie pour chaque carte dans son cimetière.", \'type\': \'Créature : horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421782&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82823097-56b3-4e09-8789-2fcec611aad0\', \'multiverseId\': 421782}, \'multiverseid\': 421782}, {\'name\': \'Divoracolpa\', \'text\': \'Paura (Questa creatura non può essere bloccata tranne che da creature artefatto e/o creature nere.)\\nOgniqualvolta il Divoracolpa attacca e non viene bloccato, il giocatore in difesa perde 1 punto vita per ogni carta nel suo cimitero.\', \'type\': \'Creatura — Orrore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'418d5a44-7419-4420-9763-04b7ccace252\', \'multiverseId\': 422133}, \'multiverseid\': 422133}, {\'name\': \'罪を与えるもの\', \'text\': \'畏怖（このクリーチャーは、アーティファクトでも黒でもないクリーチャーによってはブロックされない。）\\n罪を与えるものが攻撃してブロックされないたび、防御プレイヤーは、自分の墓地にあるカード１枚につき１点のライフを失う。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422484&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef471c4d-1528-47e7-8a0d-2785e88c7ee0\', \'multiverseId\': 422484}, \'multiverseid\': 422484}, {\'name\': \'Comedor de Culpa\', \'text\': \'Amedrontar (Esta criatura só pode ser bloqueada por criaturas pretas e/ou criaturas artefato.)\\nToda vez que Comedor de Culpa ataca e não é bloqueado, o jogador defensor perde 1 ponto de vida para cada card no próprio cemitério.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422835&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f0aa9b0-bb66-4a79-99c2-32b6bbc6c650\', \'multiverseId\': 422835}, \'multiverseid\': 422835}, {\'name\': \'罪业啜兽\', \'text\': \'恐惧（此生物只能被神器生物和／或黑色生物阻挡。）\\n每当罪业啜兽攻击且未受阻挡时，防御牌手的坟墓场中每有一张牌，他便失去1点生命。\', \'type\': \'生物～惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421080&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'53dc671e-c6de-44fb-86b2-0bbddcccc2ac\', \'multiverseId\': 421080}, \'multiverseid\': 421080}]', '[{\'name\': \'Schuppenwächter-Elite\', \'text\': \'Wenn die Schuppenwächter-Elite ins Spiel kommt, wende Kräftigung 2 an. (Lege zwei +1/+1-Marken auf eine Kreatur mit der geringsten Widerstandskraft unter den Kreaturen, die du kontrollierst.)\\nImmer wenn eine Kreatur angreift, die du kontrollierst und auf der eine +1/+1-Marke liegt, tappe eine Kreatur deiner Wahl, die der verteidigende Spieler kontrolliert.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421384&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d989445a-141a-4ab8-9724-b02379b60d17\', \'multiverseId\': 421384}, \'multiverseid\': 421384}, {\'name\': \'Guardiascama de élite\', \'text\': \'Cuando el Guardiascama de élite entre al campo de batalla, fortalece 2. (Elige la criatura con menos resistencia entre las criaturas que controlas y pon dos contadores +1/+1 sobre ella.)\\nSiempre que una criatura que controlas con un contador +1/+1 sobre ella ataque, gira la criatura objetivo que controla el jugador defensor.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423139&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b5d7fa3-c237-4c79-bff4-220a520eba20\', \'multiverseId\': 423139}, \'multiverseid\': 423139}, {\'name\': "Garde d\'écaille d\'élite", \'text\': "Quand le Garde d\'écaille d\'élite arrive sur le champ de bataille, renforcement 2. (Choisissez une créature avec l\'endurance la plus faible parmi les créatures que vous contrôlez et mettez deux marqueurs +1/+1 sur elle.)\\nÀ chaque fois qu\'une créature que vous contrôlez avec un marqueur +1/+1 sur elle attaque, engagez une créature ciblée que le joueur défenseur contrôle.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421735&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4207f79d-2f99-4d1d-bc6a-d851b3ad0c60\', \'multiverseId\': 421735}, \'multiverseid\': 421735}, {\'name\': "Guardia Scaglia d\'Elite", \'text\': "Quando la Guardia Scaglia d\'Elite entra nel campo di battaglia, sostieni 2. (Scegli una creatura con la costituzione minore tra le creature che controlli e metti due segnalini +1/+1 su di essa.)\\nOgniqualvolta una creatura con un segnalino +1/+1 che controlli attacca, TAPpa una creatura bersaglio controllata dal giocatore in difesa.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422086&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38accecc-19a0-4ea3-a307-7c7c0257adf9\', \'multiverseId\': 422086}, \'multiverseid\': 422086}, {\'name\': \'鱗衛兵の精鋭\', \'text\': \'鱗衛兵の精鋭が戦場に出たとき、鼓舞２を行う。（あなたがコントロールするクリーチャーの中で最も小さいタフネスを持つクリーチャーを１体選び、それの上に＋１/＋１カウンターを２個置く。）\\nあなたがコントロールする＋１/＋１カウンターが置かれているクリーチャーが１体攻撃するたび、防御プレイヤーがコントロールしているクリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422437&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2800155b-a39d-4b92-98e6-e69b2c8cbd82\', \'multiverseId\': 422437}, \'multiverseid\': 422437}, {\'name\': \'Guarda Escamado de Elite\', \'text\': \'Quando Guarda Escamado de Elite entrar no campo de batalha, revigore 2. (Escolha uma criatura com a menor resistência entre as que você controla e coloque dois marcadores +1/+1 nela.)\\nToda vez que uma criatura sob seu controle com um marcador +1/+1 atacar, vire a criatura alvo que o jogador defensor controla.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422788&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'faf3a12d-8b3b-4128-893b-0896e68a9d60\', \'multiverseId\': 422788}, \'multiverseid\': 422788}, {\'name\': \'精英鳞卫\', \'text\': \'当精英鳞卫进战场时，振励2。（于由你操控的生物中选择一个防御力最小的生物，在其上放置两个+1/+1指示物。）\\n每当一个由你操控且其上有+1/+1指示物的生物攻击时，横置目标由防御牌手操控的生物。\', \'type\': \'生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421033&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c37ca030-b20f-4249-8505-0066165f6ba3\', \'multiverseId\': 421033}, \'multiverseid\': 421033}]', '[{\'name\': \'Schwanengesang\', \'text\': \'Neutralisiere einen Spontanzauber, eine Hexerei oder einen Verzauberungszauber deiner Wahl. Sein bzw. ihr Beherrscher erzeugt einen 2/2 blauen Vogel-Kreaturenspielstein mit Flugfähigkeit.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die begabtesten Magier erschaffen aus purer Gewalt ebenso pure Schönheit." —Medomai der Zeitlose\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421417&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26944e82-4acc-43d4-bc1a-cb8fa24cb6a8\', \'multiverseId\': 421417}, \'multiverseid\': 421417}, {\'name\': \'Canción del cisne\', \'text\': \'Contrarresta el hechizo objetivo de encantamiento, de instantáneo o de conjuro. Su controlador crea una ficha de criatura Ave azul 2/2 con la habilidad de volar.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los magos más iluminados crean belleza a partir de la violencia". —Medomai, el inmortal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423172&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50a96ebd-f7e1-4c35-b8f0-30cbdcf99b46\', \'multiverseId\': 423172}, \'multiverseid\': 423172}, {\'name\': \'Chant du cygne\', \'text\': "Contrecarrez le sort d\'enchantement, d\'éphémère ou de rituel ciblé. Son contrôleur crée un jeton de créature 2/2 bleue Oiseau avec le vol.", \'type\': \'Éphémère\', \'flavor\': \'« Les mages les plus éclairés créent la beauté à partir de la violence. » —Médomaï le Sans-âge\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0fe98396-923a-422d-bb5e-2fe7fbe0e79a\', \'multiverseId\': 421768}, \'multiverseid\': 421768}, {\'name\': \'Canto del Cigno\', \'text\': \'Neutralizza una magia incantesimo, istantaneo o stregoneria bersaglio. Il suo controllore crea una pedina creatura Uccello 2/2 blu con volare.\', \'type\': \'Istantaneo\', \'flavor\': \'"I maghi più illuminati creano bellezza dalla violenza." —Medomai l\\\'Eterno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422119&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c753787-6c2f-4aa5-9bbe-5e2f6ee7d536\', \'multiverseId\': 422119}, \'multiverseid\': 422119}, {\'name\': \'白鳥の歌\', \'text\': \'エンチャント・呪文１つかインスタント・呪文１つかソーサリー・呪文１つを対象とし、それを打ち消す。それのコントローラーは、飛行を持つ青の２/２の鳥・クリーチャー・トークンを１体生成する。\', \'type\': \'インスタント\', \'flavor\': \'「最も見識ある魔道士は、暴力から美を生み出すことができる。」 ――老いざるメドマイ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422470&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f9e9de1-475d-4890-83b2-88da27148855\', \'multiverseId\': 422470}, \'multiverseid\': 422470}, {\'name\': \'Canção do Cisne\', \'text\': \'Anule a mágica instantânea, de encantamento ou de feitiço alvo. Seu controlador cria uma ficha de criatura azul 2/2 do tipo Ave com voar.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os magos mais iluminados criam beleza a partir da violência." — Medomai, o Atemporal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422821&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f81e1aa2-9dd2-4d2c-a6ea-a5926b7f3132\', \'multiverseId\': 422821}, \'multiverseid\': 422821}, {\'name\': \'天鹅绝唱\', \'text\': \'反击目标结界，瞬间或法术咒语。其操控者派出一个2/2蓝色，具飞行异能的鸟衍生生物。\', \'type\': \'瞬间\', \'flavor\': \'「造诣最高的法师能够从暴力中创出美感。」 ～永生者墨冬迈\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90564dd8-79b6-4385-81e0-6f11c8ae7d32\', \'multiverseId\': 421066}, \'multiverseid\': 421066}]', '[{\'name\': \'Schwerter zu Pflugscharen\', \'text\': \'Schicke eine Kreatur deiner Wahl ins Exil. Ihr Beherrscher erhält Lebenspunkte in Höhe ihrer Stärke dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Schon ein kleiner Tropfen Bedauern kann zu einem Meer der Wiedergutmachung führen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421397&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'db2d3490-50cb-4545-a8a5-7315bd4756b5\', \'multiverseId\': 421397}, \'multiverseid\': 421397}, {\'name\': \'Espadas en guadañas\', \'text\': \'Exilia la criatura objetivo. Su controlador gana una cantidad de vidas igual a su fuerza.\', \'type\': \'Instantáneo\', \'flavor\': \'La más diminuta semilla de arrepentimiento puede germinar en redención.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423152&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8b94d9c8-e666-400f-a73b-24341d47a4eb\', \'multiverseId\': 423152}, \'multiverseid\': 423152}, {\'name\': \'Retour au pays\', \'text\': \'Exilez la créature ciblée. Son contrôleur gagne un nombre de points de vie égal à sa force.\', \'type\': \'Éphémère\', \'flavor\': "L\'embryon de regret le plus infime peut s\'épanouir dans la rédemption.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421748&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e8d3a7b-68fa-44fe-802e-fb4748041791\', \'multiverseId\': 421748}, \'multiverseid\': 421748}, {\'name\': \'Da Spade a Spighe!\', \'text\': \'Esilia una creatura bersaglio. Il suo controllore guadagna punti vita pari alla sua forza.\', \'type\': \'Istantaneo\', \'flavor\': \'La più piccola traccia di rimpianto può diventare voglia di riscatto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d00fe0cc-6766-49c3-abe1-9263232ffb55\', \'multiverseId\': 422099}, \'multiverseid\': 422099}, {\'name\': \'剣を鍬に\', \'text\': \'クリーチャー１体を対象とし、それを追放する。それのコントローラーは、それのパワーに等しい点数のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'ごく小さい後悔の種が救済の花を咲かせる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422450&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41c76e3b-bce3-4548-a0db-596b3b61a0d5\', \'multiverseId\': 422450}, \'multiverseid\': 422450}, {\'name\': \'Espadas em Arados\', \'text\': \'Exile a criatura alvo. O controlador da criatura ganha uma quantidade de pontos de vida igual ao poder dela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Da menor semente de arrependimento pode florescer a redenção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422801&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9721048f-c706-4a2e-9833-0f31d286a1e0\', \'multiverseId\': 422801}, \'multiverseid\': 422801}, {\'name\': \'化剑为犁\', \'text\': \'放逐目标生物。其操控者获得等同于其力量的生命。\', \'type\': \'瞬间\', \'flavor\': \'再小的悔恨种子也能开出救赎之花。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421046&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1db01935-0c9d-49aa-8e2e-2d33841ddf41\', \'multiverseId\': 421046}, \'multiverseid\': 421046}]', '[{\'name\': \'Schädelstrammer\', \'text\': \'Die ausgerüstete Kreatur erhält +1/-1.\\nImmer wenn die ausgerüstete Kreatur stirbt, ziehe zwei Karten.\\nAusrüsten {1}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Das Gehirn ist ein wunderbarer Schatz, der in einem langweiligen Behältnis aus Knochen versteckt ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421590&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f26e838-9dc1-4887-8900-a76ca8cd7f65\', \'multiverseId\': 421590}, \'multiverseid\': 421590}, {\'name\': \'Engrampacráneo\', \'text\': \'La criatura equipada obtiene +1/-1.\\nSiempre que la criatura equipada muera, roba dos cartas.\\nEquipar {1}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'La mente es una recompensa hermosa encerrada en un molesto contenedor óseo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423345&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25ebbb2c-cdb8-48c5-8b01-8f544b3469c7\', \'multiverseId\': 423345}, \'multiverseid\': 423345}, {\'name\': \'Pincecrâne\', \'text\': \'La créature équipée gagne +1/-1.\\nÀ chaque fois que la créature équipée meurt, piochez deux cartes.\\nÉquipement {1}\', \'type\': \'Artefact : équipement\', \'flavor\': "L\'esprit est une belle récompense enveloppée d\'une pellicule chiante en os.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421941&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'35f4f06e-626f-4470-aaf1-63cee5a6195c\', \'multiverseId\': 421941}, \'multiverseid\': 421941}, {\'name\': \'Morsa Cerebrale\', \'text\': \'La creatura equipaggiata prende +1/-1.\\nOgniqualvolta la creatura equipaggiata muore, pesca due carte.\\nEquipaggiare {1}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'La mente è un dono bellissimo racchiuso in un fastidioso contenitore osseo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422292&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7214fc4-69b0-41fc-a9d0-614589d37ce0\', \'multiverseId\': 422292}, \'multiverseid\': 422292}, {\'name\': \'頭蓋骨絞め\', \'text\': \'装備しているクリーチャーは＋１/－１の修整を受ける。\\n装備しているクリーチャーが死亡するたび、カードを２枚引く。\\n装備{1}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'精神とは、面倒臭い骨の器に閉じ込められた素晴らしい褒章だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422643&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f5964e6-937c-4190-920e-60c7deb89a8a\', \'multiverseId\': 422643}, \'multiverseid\': 422643}, {\'name\': \'Pinça Craniana\', \'text\': \'A criatura equipada recebe +1/-1.\\nToda vez que a criatura equipada morrer, compre dois cards.\\nEquipar {1}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'A mente é uma linda recompensa envolta em um recipiente ósseo irritante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422994&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'85e4a6a5-4e14-4128-9ce1-20c4e8c4a67d\', \'multiverseId\': 422994}, \'multiverseid\': 422994}, {\'name\': \'备忘夹\', \'text\': \'佩带此武具的生物得+1/-1。\\n每当佩带此武具的生物死去时，抓两张牌。\\n佩带{1}\', \'type\': \'神器～武具\', \'flavor\': \'心灵就是裹藏在无用躯骨中的曼妙恩惠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421239&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b33d2118-e8d2-4534-b854-b1abd3aa857a\', \'multiverseId\': 421239}, \'multiverseid\': 421239}]', "[{'name': 'Schädelverstärkung', 'text': 'Die ausgerüstete Kreatur erhält +1/+0 für jedes Artefakt, das du kontrollierst.\\n{B}{B}: Lege die Schädelverstärkung an eine Kreatur deiner Wahl an, die du kontrollierst.\\nAusrüsten {1}', 'type': 'Artefakt — Ausrüstung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421568&type=card', 'language': 'German', 'identifiers': {'scryfallId': '54c6ace3-8eb1-4285-8dbd-9ea525718abb', 'multiverseId': 421568}, 'multiverseid': 421568}, {'name': 'Blindaje craneano', 'text': 'La criatura equipada obtiene +1/+0 por cada artefacto que controlas.\\n{B}{B}: Anexa el Blindaje craneano a la criatura objetivo que controlas.\\nEquipar {1}.', 'type': 'Artefacto — Equipo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423323&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c4e1e61d-ec3a-4477-b7d5-2bc394209c4c', 'multiverseId': 423323}, 'multiverseid': 423323}, {'name': 'Blindage crânien', 'text': 'La créature équipée gagne +1/+0 pour chaque artefact que vous contrôlez.\\n{B}{B} : Attachez le Blindage crânien à la créature ciblée que vous contrôlez.\\nÉquipement {1}', 'type': 'Artefact : équipement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421919&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2c1203b9-bda3-4f9b-bbc7-c6debb064854', 'multiverseId': 421919}, 'multiverseid': 421919}, {'name': 'Placca Cefalica', 'text': 'La creatura equipaggiata prende +1/+0 per ogni artefatto che controlli.\\n{B}{B}: Assegna la Placca Cefalica a una creatura bersaglio che controlli.\\nEquipaggiare {1}', 'type': 'Artefatto — Equipaggiamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422270&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e644b676-27f3-4906-8586-6fa8e7387301', 'multiverseId': 422270}, 'multiverseid': 422270}, {'name': '頭蓋囲い', 'text': '装備しているクリーチャーは、あなたがコントロールするアーティファクト１つにつき＋１/＋０の修整を受ける。\\n{B}{B}：あなたがコントロールするクリーチャー１体を対象とし、それに頭蓋囲いをつける。\\n装備{1}', 'type': 'アーティファクト — 装備品', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422621&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ff544ce4-b477-4bb7-af9d-8821b71df3d3', 'multiverseId': 422621}, 'multiverseid': 422621}, {'name': 'Chapeamento Craniano', 'text': 'A criatura equipada recebe +1/+0 para cada artefato que você controla.\\n{B}{B}: Anexe Chapeamento Craniano à criatura alvo que você controla.\\nEquipar {1}', 'type': 'Artefato — Equipamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422972&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '84ef492d-55b0-4c5a-b9d2-1b2e9b640e36', 'multiverseId': 422972}, 'multiverseid': 422972}, {'name': '颅骨护甲', 'text': '你每操控一个神器，佩带此武具的生物便得+1/+0。\\n{B}{B}：将颅骨护甲装备在目标由你操控的生物上。\\n佩带{1}', 'type': '神器～武具', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421217&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6fd90073-7617-4b45-86c3-1000aaeab8eb', 'multiverseId': 421217}, 'multiverseid': 421217}]", '[{\'name\': \'Schätze aus Gerümpel\', \'text\': \'Opfere ein Artefakt als zusätzliche Kosten, um die Schätze aus Gerümpel zu wirken.\\nBringe eine Artefaktkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Goblins haben normalerweise zwei Besitztümer: eins pro Hand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421455&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'67ff4f8c-2975-4b09-90cf-e1c9ea0c165e\', \'multiverseId\': 421455}, \'multiverseid\': 421455}, {\'name\': \'Oro por baratijas\', \'text\': \'Como coste adicional para lanzar Oro por baratijas, sacrifica un artefacto.\\nRegresa la carta de artefacto objetivo de tu cementerio al campo de batalla.\', \'type\': \'Conjuro\', \'flavor\': \'Los trasgos tienen normalmente dos bienes: uno en cada mano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423210&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7409c8b5-8ebc-4542-a4fc-ef3aef177e5c\', \'multiverseId\': 423210}, \'multiverseid\': 423210}, {\'name\': \'Trésor au rebut\', \'text\': "En tant que coût supplémentaire pour lancer le Trésor au rebut, sacrifiez un artefact.\\nRenvoyez sur le champ de bataille une carte d\'artefact ciblée depuis votre cimetière.", \'type\': \'Rituel\', \'flavor\': \'Les gobelins possèdent généralement deux choses : une pour chaque main.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9daef62e-45a2-4d3e-83eb-c4eee6f8f5d0\', \'multiverseId\': 421806}, \'multiverseid\': 421806}, {\'name\': \'Da Rottami a Tesoro\', \'text\': \'Come costo addizionale per lanciare Da Rottami a Tesoro, sacrifica un artefatto.\\nRimetti sul campo di battaglia una carta artefatto bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'I goblin di solito posseggono due oggetti: uno per mano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422157&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6412ac3-03ac-4408-b686-19d00fb1be76\', \'multiverseId\': 422157}, \'multiverseid\': 422157}, {\'name\': \'財宝発掘\', \'text\': \'財宝発掘を唱えるための追加コストとして、アーティファクト１つを生け贄に捧げる。\\nあなたの墓地からアーティファクト・カード１枚を対象とし、それを戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'ゴブリンの所有物は一般に二つだけ、片手に一つずつだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422508&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'706fad87-9e87-479a-b6ac-29b06dc569ae\', \'multiverseId\': 422508}, \'multiverseid\': 422508}, {\'name\': \'Lixo por Tesouro\', \'text\': \'Como custo adicional para conjurar Lixo por Tesouro, sacrifique um artefato.\\nDevolva o card de artefato alvo de seu cemitério para o campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': \'Os goblins costumam ter dois pertences: um em cada mão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422859&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'46e15ef1-60d1-44c3-a10f-645ba9ad582b\', \'multiverseId\': 422859}, \'multiverseid\': 422859}, {\'name\': \'废物利用\', \'text\': \'牺牲一个神器，以作为施放废物利用的额外费用。\\n将目标神器牌从你的坟墓场移回战场。\', \'type\': \'法术\', \'flavor\': \'鬼怪的双手通常各有主见。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421104&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'159d490b-0234-4acd-9f90-f6f7912d3d4d\', \'multiverseId\': 421104}, \'multiverseid\': 421104}]', "[{'name': 'Seeküstenzitadelle', 'text': 'Die Seeküstenzitadelle kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}, {W} oder {U}.', 'type': 'Land', 'flavor': 'Um der Weisheit willen wurde sie hoch gebaut, um alles von oben sehen zu können. Um des Ruhmes willen wurde sie hoch gebaut, um als Dokument der Macht zu dienen. Um der Stärke willen wurde sie hoch gebaut, um alle Angriffe abzuwehren.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421641&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a4c17b05-abc9-41dc-9af3-1a6599720ffb', 'multiverseId': 421641}, 'multiverseid': 421641}, {'name': 'Ciudadela costera', 'text': 'La Ciudadela costera entra al campo de batalla girada.\\n{T}: Agrega {G}, {W} o {U} a tu reserva de maná.', 'type': 'Tierra', 'flavor': 'Para la sabiduría, fue construida bien alta para observarlo todo. Para la gloria, fue construida bien alta para ser un testimonio del poder. Para la fortaleza, fue construida bien alta para repeler todos los ataques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423396&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd3f31eac-ab37-4438-8303-53846272bce6', 'multiverseId': 423396}, 'multiverseid': 423396}, {'name': 'Citadelle maritime', 'text': 'La Citadelle maritime arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {G}, {W} ou {U} à votre réserve.', 'type': 'Terrain', 'flavor': 'Pour la sagesse, elle fut construite haute pour tout voir. Pour la gloire, elle fut construite haute en testament de la puissance. Pour la force, elle fut construite haute pour repousser toutes les attaques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421992&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e49b8a68-ecae-485c-b56f-4b0205a60d89', 'multiverseId': 421992}, 'multiverseid': 421992}, {'name': 'Cittadella sul Mare', 'text': 'La Cittadella sul Mare entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {G}, {W} o {U} alla tua riserva di mana.', 'type': 'Terra', 'flavor': 'Per la saggezza, è stata costruita in alto per contemplare ogni cosa. Per la gloria, è stata costruita in alto come testimonianza di potere. Per la potenza, è stata costruita in alto per respingere tutti gli attacchi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422343&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '65131a46-2118-4278-aff1-6055d4fe79b1', 'multiverseId': 422343}, 'multiverseid': 422343}, {'name': '海辺の城塞', 'text': '海辺の城塞はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}か{W}か{U}を加える。', 'type': '土地', 'flavor': '智のために、それはあらゆる物を見下ろすべき高さとなった。名誉のために、それは力を示す高さとなった。力のために、それはすべての攻撃を跳ね返す高さとなった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422694&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6c08fb30-cc52-468e-8a4c-20f31abee808', 'multiverseId': 422694}, 'multiverseid': 422694}, {'name': 'Cidadela à Beira-mar', 'text': 'Cidadela à Beira-mar entra no campo de batalha virado.\\n{T}: Adicione {G}, {W}, ou {U} à sua reserva de mana.', 'type': 'Terreno', 'flavor': 'Pela sabedoria, ela foi construída no alto para ver todas as coisas. Pela glória, ela foi construída no alto como um testemunho de poder. Pela força, ela foi construída no alto para repelir todos os ataques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423045&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '83712c7c-2f50-4730-bfa1-4910002a26fd', 'multiverseId': 423045}, 'multiverseid': 423045}, {'name': '海滨殿堂', 'text': '海滨殿堂须横置进战场。\\n{T}：加{G}，{W}，或{U}到你的法术力池中。', 'type': '地', 'flavor': '为了智慧，它建在高地来监看万物。为了荣誉，它建在高地以验证勇武。为了力量，它建在高地好斥退攻势。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421290&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '26e5f56c-522a-4731-b457-969d45c22349', 'multiverseId': 421290}, 'multiverseid': 421290}]", '[{\'name\': \'Seele von Neu-Phyrexia\', \'text\': \'Verursacht Trampelschaden\\n{5}: Bleibende Karten, die du kontrollierst, erhalten Unzerstörbarkeit bis zum Ende des Zuges.\\n{5}, schicke die Seele von Neu-Phyrexia aus deinem Friedhof ins Exil: Bleibende Karten, die du kontrollierst, erhalten Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421593&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'436ffa98-36dd-4f59-bb7d-ef23a4f83cf3\', \'multiverseId\': 421593}, \'multiverseid\': 421593}, {\'name\': \'Alma de Nueva Phyrexia\', \'text\': \'Arrolla.\\n{5}: Los permanentes que controlas ganan la habilidad de indestructible hasta el final del turno.\\n{5}, exiliar el Alma de Nueva Phyrexia de tu cementerio: Los permanentes que controlas ganan la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura artefacto — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423348&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6fc57c3a-c2cb-4f55-be2f-5069c542b94b\', \'multiverseId\': 423348}, \'multiverseid\': 423348}, {\'name\': \'Âme de la Nouvelle Phyrexia\', \'text\': "Piétinement\\n{5} : Les permanents que vous contrôlez acquièrent l\'indestructible jusqu\'à la fin du tour.\\n{5}, exilez l\'Âme de la Nouvelle Phyrexia depuis votre cimetière : Les permanents que vous contrôlez acquièrent l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421944&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d28d487-0a48-4fb2-96f4-81c44fbbacff\', \'multiverseId\': 421944}, \'multiverseid\': 421944}, {\'name\': \'Anima di Nuova Phyrexia\', \'text\': "Travolgere\\n{5}: I permanenti che controlli hanno indistruttibile fino alla fine del turno.\\n{5}, Esilia l\'Anima di Nuova Phyrexia dal tuo cimitero: I permanenti che controlli hanno indistruttibile fino alla fine del turno.", \'type\': \'Creatura Artefatto — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422295&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37a753a4-bcc7-4df5-af20-b8823367f451\', \'multiverseId\': 422295}, \'multiverseid\': 422295}, {\'name\': \'新たなるファイレクシアの魂\', \'text\': \'トランプル\\n{5}：ターン終了時まで、あなたがコントロールするパーマネントは破壊不能を得る。\\n{5}, あなたの墓地から新たなるファイレクシアの魂を追放する：ターン終了時まで、あなたがコントロールするパーマネントは破壊不能を得る。\', \'type\': \'アーティファクト・クリーチャー — アバター\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422646&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b19d6fcf-fab2-41e0-a976-a405f29cd00e\', \'multiverseId\': 422646}, \'multiverseid\': 422646}, {\'name\': \'Alma de Nova Phyrexia\', \'text\': \'Atropelar\\n{5}: As permanentes que você controla ganham indestrutível até o final do turno.\\n{5}, Exile Alma de Nova Phyrexia do seu cemitério: As permanentes que você controla ganham indestrutível até o final do turno.\', \'type\': \'Criatura Artefato — Avatar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422997&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b7f09bb-ad50-4a63-8e06-8679a815d08e\', \'multiverseId\': 422997}, \'multiverseid\': 422997}, {\'name\': \'新非瑞克西亚之魂\', \'text\': \'践踏\\n{5}：由你操控的永久物获得不灭异能直到回合结束。\\n{5}，从你的坟墓场放逐新非瑞克西亚之魂：由你操控的永久物获得不灭异能直到回合结束。\', \'type\': \'神器生物～圣者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421242&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'363467fb-39e5-4bac-9863-1a186861e4ae\', \'multiverseId\': 421242}, \'multiverseid\': 421242}]', '[{\'name\': \'Seelenerneuerung\', \'text\': \'Jeder Spieler wirft alle Karten aus seiner Hand ab und zieht dann sieben Karten.\\nMirakulum {1}{R} (Du kannst diese Karte für ihre Mirakulum-Kosten wirken, wenn du sie ziehst, falls es die erste Karte ist, die du in diesem Zug gezogen hast.)\', \'type\': \'Hexerei\', \'flavor\': \'In einer Welle von Zaubern, die später als „Fluchverstummer" bezeichnet wurden, reinigte Avacyn die Welt mit göttlichem Feuer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421451&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d1aaecc5-8539-43db-b6fe-998ca49df312\', \'multiverseId\': 421451}, \'multiverseid\': 421451}, {\'name\': \'Reforjar el alma\', \'text\': \'Cada jugador descarta su mano, luego roba siete cartas.\\nMilagro {1}{R}. (Puedes lanzar esta carta pagando su coste de milagro cuando la robes si es la primera carta que robaste este turno.)\', \'type\': \'Conjuro\', \'flavor\': \'Mediante una oleada de hechizos llamada la Callamaldición, Avacyn purificó el mundo con fuego divino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423206&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c77533ea-f7d7-4a98-a689-ea7694cd8109\', \'multiverseId\': 423206}, \'multiverseid\': 423206}, {\'name\': "Reforger l\'âme", \'text\': "Chaque joueur se défausse de sa main, puis pioche sept cartes.\\nMiracle {1}{R} (Vous pouvez lancer cette carte pour son coût de miracle quand vous la piochez si c\'est la première carte que vous avez piochée ce tour-ci.)", \'type\': \'Rituel\', \'flavor\': "Dans un déferlement de sorts qu\'on appela l\'Amuïssement des malédictions, Avacyn purifia le monde en recourant au feu divin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421802&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c7481680-c3c5-469f-a28b-61b19b64932b\', \'multiverseId\': 421802}, \'multiverseid\': 421802}, {\'name\': "Riplasmare l\'Anima", \'text\': \'Ogni giocatore scarta la propria mano, poi pesca sette carte.\\nMiracolo {1}{R} (Puoi lanciare questa carta pagando il suo costo di miracolo quando la peschi, se è la prima che hai pescato in questo turno.)\', \'type\': \'Stregoneria\', \'flavor\': "In un\'ondata di magie conosciuta come Smorzamaledizioni, Avacyn purificò il mondo con il fuoco divino.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422153&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79211f07-6e35-4c87-a543-7db67d30790b\', \'multiverseId\': 422153}, \'multiverseid\': 422153}, {\'name\': \'魂の再鍛\', \'text\': \'各プレイヤーはそれぞれ、自分の手札を捨て、その後カードを７枚引く。\\n奇跡{1}{R}（あなたがこのカードを引いたとき、これがこのターンに最初に引いたカードだったなら、あなたはこれの奇跡コストを支払うことでこれを唱えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': \'呪い黙らせという一連の呪文によって、アヴァシンはこの世界を神聖な炎で浄化した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422504&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43d3de99-4417-407c-acb4-3e30d6e4a687\', \'multiverseId\': 422504}, \'multiverseid\': 422504}, {\'name\': \'Reforjar a Alma\', \'text\': \'Cada jogador descarta a própria mão e depois compra sete cards.\\nMilagre {1}{R} (Você pode conjurar este card pagando seu custo de milagre ao comprá-lo se este for o primeiro card que você compra neste turno.)\', \'type\': \'Feitiço\', \'flavor\': \'Em uma onda de mágicas chamada o Calar das Maldições, Avacyn purificou o mundo com o fogo divino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422855&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cf08182f-2188-4dc2-bb7c-e4abc7bc10d0\', \'multiverseId\': 422855}, \'multiverseid\': 422855}, {\'name\': \'重塑灵魂\', \'text\': \'每位牌手弃掉其手牌，然后各抓七张牌。\\n奇迹{1}{R}（当你抓此牌时，如果它是你于本回合抓的第一张牌，你可以支付其奇迹费用来施放它。）\', \'type\': \'法术\', \'flavor\': \'藉由一波称为息怨咒的咒语，艾维欣以圣火净化世界。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421100&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'81da1ec7-afee-4b95-9251-0479a484960e\', \'multiverseId\': 421100}, \'multiverseid\': 421100}]', '[{\'name\': \'Selbstlose Junkerin\', \'text\': \'Aufblitzen\\nWenn die Selbstlose Junkerin ins Spiel kommt, verhindere allen Schaden, der dir in diesem Zug zugefügt würde.\\nImmer wenn Schaden verhindert wird, der dir zugefügt würde, lege entsprechend viele +1/+1-Marken auf die Selbstlose Junkerin.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421323&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'73046296-e4ee-4f5a-a8e0-5ef12836ac0e\', \'multiverseId\': 421323}, \'multiverseid\': 421323}, {\'name\': \'Escudera abnegada\', \'text\': \'Destello.\\nCuando la Escudera abnegada entre al campo de batalla, prevén todo el daño que se te fuera a hacer este turno.\\nSiempre que se prevenga daño que se te fuera a hacer, pon esa misma cantidad de contadores +1/+1 sobre la Escudera abnegada.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423078&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44a49320-d8ad-444a-ab03-a6d78db1a6e3\', \'multiverseId\': 423078}, \'multiverseid\': 423078}, {\'name\': \'Écuyère dévouée\', \'text\': "Flash\\nQuand l\'Écuyère dévouée arrive sur le champ de bataille, prévenez toutes les blessures qui devraient vous être infligées ce tour-ci.\\nÀ chaque fois que des blessures qui devaient vous être infligées sont prévenues, mettez autant de marqueurs +1/+1 sur l\'Écuyère dévouée.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421674&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63f12ff1-db24-4b77-aa00-518ac9bedbf0\', \'multiverseId\': 421674}, \'multiverseid\': 421674}, {\'name\': \'Scudiera Altruista\', \'text\': \'Lampo\\nQuando la Scudiera Altruista entra nel campo di battaglia, previeni tutto il danno che ti verrebbe inflitto in questo turno.\\nOgniqualvolta il danno che sta per esserti inflitto viene prevenuto, metti altrettanti segnalini +1/+1 sulla Scudiera Altruista.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422025&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0589457a-f1be-4201-b1d5-b3ec6a64cca2\', \'multiverseId\': 422025}, \'multiverseid\': 422025}, {\'name\': \'無私の従者\', \'text\': \'瞬速\\n無私の従者が戦場に出たとき、このターン、あなたに与えられるすべてのダメージを軽減する。\\nあなたに与えられるダメージが軽減されるたび、無私の従者の上にその点数に等しい数の＋１/＋１カウンターを置く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422376&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b7b1f2b-5c0a-44e7-a4ce-25adb110c04c\', \'multiverseId\': 422376}, \'multiverseid\': 422376}, {\'name\': \'Escudeira Altruísta\', \'text\': \'Lampejo\\nQuando Escudeira Altruísta entrar no campo de batalha, previna todo o dano que seria causado a você neste turno.\\nToda vez que algum dano que seria causado a você for prevenido, coloque aquela quantidade de marcadores +1/+1 em Escudeira Altruísta.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422727&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d9417d27-b108-483b-8fbd-2e5db4716408\', \'multiverseId\': 422727}, \'multiverseid\': 422727}, {\'name\': \'无私扈从\', \'text\': \'闪现\\n当无私扈从进战场时，防止本回合中将对你造成的所有伤害。\\n每当任一效应防止将对你造成的伤害时，在无私扈从上放置等量的+1/+1指示物。\', \'type\': \'生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420972&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e9aff2f-3a46-4401-b359-cef86bd0004e\', \'multiverseId\': 420972}, \'multiverseid\': 420972}]', '[{\'name\': \'Selesnija-Gildenmagier\', \'text\': \'{3}{G}: Erzeuge einen 1/1 grünen Saproling-Kreaturenspielstein.\\n{3}{W}: Kreaturen, die du kontrollierst, erhalten +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421554&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e049e71-11d0-47fc-9500-8d764bd63a60\', \'multiverseId\': 421554}, \'multiverseid\': 421554}, {\'name\': \'Mago del Gremio Selesnya\', \'text\': \'{3}{G}: Crea una ficha de criatura Saprolín verde 1/1.\\n{3}{W}: Las criaturas que controlas obtienen +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Hechicero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423309&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5590427b-903d-43b1-816d-389df0f08d16\', \'multiverseId\': 423309}, \'multiverseid\': 423309}, {\'name\': \'Ghildmage de Selesnya\', \'text\': "{3}{G} : Créez un jeton de créature 1/1 verte Saprobionte.\\n{3}{W} : Les créatures que vous contrôlez gagnent +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421905&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c3956072-ab6f-4643-bb4c-5c58894a59e2\', \'multiverseId\': 421905}, \'multiverseid\': 421905}, {\'name\': \'Mago della Gilda di Selesnya\', \'text\': \'{3}{G}: Crea una pedina creatura Saprolingio 1/1 verde.\\n{3}{W}: Le creature che controlli prendono +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Mago Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422256&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7fef6472-a013-4cff-83ce-97485a572d35\', \'multiverseId\': 422256}, \'multiverseid\': 422256}, {\'name\': \'セレズニアのギルド魔道士\', \'text\': \'{3}{G}：緑の１/１の苗木・クリーチャー・トークンを１体生成する。\\n{3}{W}：ターン終了時まで、あなたがコントロールするクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — エルフ・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422607&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c17e2a63-5ebb-4d99-b6f5-f31ec560c59d\', \'multiverseId\': 422607}, \'multiverseid\': 422607}, {\'name\': \'Mago da Guilda Selesnya\', \'text\': \'{3}{G}: Crie uma ficha de criatura verde 1/1 do tipo Saprófita.\\n{3}{W}: As criaturas que você controla recebem +1/+1 até o final do turno.\', \'type\': \'Criatura — Elfo Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422958&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8beb3a6c-ac9f-404f-b87f-0ab2c68dfd0b\', \'multiverseId\': 422958}, \'multiverseid\': 422958}, {\'name\': \'瑟雷尼亚公会法师\', \'text\': \'{3}{G}：派出一个1/1绿色腐生物衍生生物。\\n{3}{W}：由你操控的生物得+1/+1直到回合结束。\', \'type\': \'生物～妖精／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421203&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c35874a6-e053-4ee1-81c9-7e1cb8c55b54\', \'multiverseId\': 421203}, \'multiverseid\': 421203}]', "[{'name': 'Selesnija-Heiligtum', 'text': 'Das Selesnija-Heiligtum kommt getappt ins Spiel.\\nWenn das Selesnija-Heiligtum ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {G}{W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421643&type=card', 'language': 'German', 'identifiers': {'scryfallId': '194dc4ea-91ad-4e6d-b2f9-e640def86ebc', 'multiverseId': 421643}, 'multiverseid': 421643}, {'name': 'Santuario Selesnya', 'text': 'El Santuario Selesnya entra al campo de batalla girado.\\nCuando el Santuario selesnya entre al campo de batalla, regresa una tierra que controles a la mano de su propietario.\\n{T}: Agrega {G}{W} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423398&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '90daefb1-0544-463b-9e5b-ad6a0c41d285', 'multiverseId': 423398}, 'multiverseid': 423398}, {'name': 'Sanctuaire de Selesnya', 'text': 'Le Sanctuaire de Selesnya arrive sur le champ de bataille engagé.\\nQuand le Sanctuaire de Selesnya arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {G}{W} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421994&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b67e5bdc-4479-4ebd-9937-c945e55797cf', 'multiverseId': 421994}, 'multiverseid': 421994}, {'name': 'Santuario di Selesnya', 'text': 'Il Santuario di Selesnya entra nel campo di battaglia TAPpato.\\nQuando il Santuario di Selesnya entra nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {G}{W} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422345&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4b51c114-4e92-4b68-9e4e-7d82056d0aea', 'multiverseId': 422345}, 'multiverseid': 422345}, {'name': 'セレズニアの聖域', 'text': 'セレズニアの聖域はタップ状態で戦場に出る。\\nセレズニアの聖域が戦場に出たとき、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{G}{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422696&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '34badf24-bcae-4a05-b48b-d974d257c6de', 'multiverseId': 422696}, 'multiverseid': 422696}, {'name': 'Santuário Selesnya', 'text': 'Santuário Selesnya entra no campo de batalha virado.\\nQuando Santuário Selesnya entrar no campo de batalha, devolva um terreno que você controla para a mão de seu dono.\\n{T}: Adicione {G}{W} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423047&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '730c6783-1160-4535-998e-187ef85102d8', 'multiverseId': 423047}, 'multiverseid': 423047}, {'name': '瑟雷尼亚圣殿', 'text': '瑟雷尼亚圣殿须横置进战场。\\n当瑟雷尼亚圣殿进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{G}{W}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421292&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1969fb6c-2936-439c-be29-79fa863aa1a6', 'multiverseId': 421292}, 'multiverseid': 421292}]", '[{\'name\': \'Selvala, heimgekehrte Forscherin\', \'text\': \'Verhandlungen — {T}: Jeder Spieler deckt die oberste Karte seiner Bibliothek auf. Für jede Karte, die auf diese Weise aufgedeckt wurde und die kein Land ist, erhöhst du deinen Manavorrat um {G} und erhältst 1 Lebenspunkt dazu. Dann zieht jeder Spieler eine Karte.\', \'type\': \'Legendäre Kreatur — Elf, Späher\', \'flavor\': \'„Das Tiefland ist nicht bereit, unter den Launen der Oberstadt zu leiden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421539&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c8288fc-1f71-4220-92e8-c8319c40b349\', \'multiverseId\': 421539}, \'multiverseid\': 421539}, {\'name\': \'Selvala, exploradora regresada\', \'text\': \'Parlamentar — {T}: Cada jugador muestra la primera carta de su biblioteca. Por cada carta que no sea tierra mostrada de esta manera, añade {G} a tu reserva de maná y tú ganas 1 vida. Luego cada jugador roba una carta.\', \'type\': \'Criatura legendaria — Explorador elfo\', \'flavor\': \'"Las tierras bajas se niegan a sufrir al antojo de la Alta Ciudad ".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423294&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73cd17d1-2c68-441b-a2e3-6afe8d06635e\', \'multiverseId\': 423294}, \'multiverseid\': 423294}, {\'name\': \'Selvala, exploratrice sur le retour\', \'text\': \'Pourparler — {T} : Chaque joueur révèle la carte du dessus de sa bibliothèque. Pour chaque carte non-terrain révélée de cette manière, ajoutez {G} à votre réserve et gagnez 1 point de vie. Chaque joueur pioche ensuite une carte.\', \'type\': \'Créature légendaire : elfe et éclaireur\', \'flavor\': \'« Le peuple des Basses-terres refuse de souffrir les caprices de ceux de la Haute cité. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421890&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a1cc4110-6045-4e2b-a4bd-96a4991f34a8\', \'multiverseId\': 421890}, \'multiverseid\': 421890}, {\'name\': \'Selvala, Esploratrice Ritornata\', \'text\': \'Negoziato — {T}: Ogni giocatore rivela la prima carta del proprio grimorio. Per ogni carta non terra rivelata in questo modo, aggiungi {G} alla tua riserva di mana e guadagni 1 punto vita. Poi ogni giocatore pesca una carta.\', \'type\': \'Creatura Leggendaria — Esploratore Elfo\', \'flavor\': \'"I Bassopiani rifiutano di sottostare ai capricci della Città Alta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422241&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78df97cb-c585-4a92-acd4-7a737f4048e4\', \'multiverseId\': 422241}, \'multiverseid\': 422241}, {\'name\': \'帰還した探検者、セルヴァラ\', \'text\': \'協議 ― {T}：各プレイヤーはそれぞれ自分のライブラリーの一番上のカードを公開する。これにより公開された土地でないカード１枚につき、あなたのマナ・プールに{G}を加えるとともにあなたは１点のライフを得る。その後、各プレイヤーはそれぞれカードを１枚引く。\', \'type\': \'伝説のクリーチャー — エルフ・スカウト\', \'flavor\': \'「高層都市の気まぐれによって苦しめられることを下層地は認めない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422592&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9fd94b54-c2b0-4279-bd5f-51a0fab2d014\', \'multiverseId\': 422592}, \'multiverseid\': 422592}, {\'name\': \'Selvala, Exploradora Regressa\', \'text\': \'Negociação — {T}: Cada jogador revela o card do topo do próprio grimório. Para cada card que não seja terreno revelado desta forma, adicione {G} a sua reserva de mana e ganhe 1 ponto de vida. Em seguida, cada jogador compra um card.\', \'type\': \'Criatura Lendária — Elfo Batedor\', \'flavor\': \'"A Baixada se recusa a sofrer os caprichos da Cidade Alta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422943&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9ad9122-3f83-409f-9143-7704a26756c4\', \'multiverseId\': 422943}, \'multiverseid\': 422943}, {\'name\': \'复还探险家塞瓦拉\', \'text\': \'论争～{T}：每位牌手各展示其牌库顶牌。每以此法展示出一张非地牌，便加{G}到你的法术力池中，且你获得1点生命。然后每位牌手各抓一张牌。\', \'type\': \'传奇生物～妖精／斥候\', \'flavor\': \'「下城受够了上城颐指气使之苦，渴望改换一新。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421188&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8cc4573b-5752-456c-9393-c458f56f6a01\', \'multiverseId\': 421188}, \'multiverseid\': 421188}]', '[{\'name\': \'Sharuum, Sphinx-Hegemon\', \'text\': \'Fliegend\\nWenn Sharuum, Sphinx-Hegemon, ins Spiel kommt, kannst du eine Artefaktkarte deiner Wahl aus deinem Friedhof ins Spiel zurückbringen.\', \'type\': \'Legendäre Artefaktkreatur — Sphinx\', \'flavor\': \'Um eine Audienz beim Hegemonen zu erhalten, muss man ein Rätsel mitbringen, das dieser noch nicht kennt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421540&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'526785c4-453f-486a-a1b1-4b071c5cc44e\', \'multiverseId\': 421540}, \'multiverseid\': 421540}, {\'name\': \'Sharuum la Hegemón\', \'text\': \'Vuela.\\nCuando Sharuum la Hegemón entre al campo de batalla, puedes regresar la carta de artefacto objetivo de tu cementerio al campo de batalla.\', \'type\': \'Criatura artefacto legendaria — Esfinge\', \'flavor\': \'Para obtener una audiencia con la hegemón, debes traerle un acertijo que no haya escuchado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423295&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aacda1c0-e144-4cbd-bd30-b3fb315bc3d4\', \'multiverseId\': 423295}, \'multiverseid\': 423295}, {\'name\': "Sharuûm l\'Hégémon", \'text\': "Vol\\nQuand Sharuûm l\'Hégémon arrive sur le champ de bataille, vous pouvez renvoyer une carte d\'artefact ciblée depuis votre cimetière sur le champ de bataille.", \'type\': \'Créature-artefact légendaire : sphinx\', \'flavor\': "Pour obtenir audience avec l\'Hégémon, il faut pouvoir lui présenter une énigme qu\'elle n\'a jamais entendue auparavant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421891&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4c95d8a0-5233-4902-98e3-7a9f313956ae\', \'multiverseId\': 421891}, \'multiverseid\': 421891}, {\'name\': "Sharuum l\'Egemone", \'text\': "Volare\\nQuando Sharuum l\'Egemone entra nel campo di battaglia, puoi rimettere sul campo di battaglia una carta artefatto bersaglio dal tuo cimitero.", \'type\': \'Creatura Artefatto Leggendaria — Sfinge\', \'flavor\': "Perché l\'egemone dia udienza, si deve proporre un enigma che non abbia mai sentito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422242&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b6e5092b-fe38-40ed-98d9-28159ac4a893\', \'multiverseId\': 422242}, \'multiverseid\': 422242}, {\'name\': \'覇者シャルム\', \'text\': \'飛行\\n覇者シャルムが戦場に出たとき、あなたの墓地からアーティファクト・カード１枚を対象とする。あなたはそれを戦場に戻してもよい。\', \'type\': \'伝説のアーティファクト・クリーチャー — スフィンクス\', \'flavor\': \'教義を授かるためには、彼女の知らない謎を聞かせなければならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422593&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a4103c2-c3d5-4ad0-b9c7-7df244c0acee\', \'multiverseId\': 422593}, \'multiverseid\': 422593}, {\'name\': \'Sharuum, a Hegemônica\', \'text\': \'Voar\\nQuando Sharuum, a Hegemônica, entra no campo de batalha, você pode devolver ao campo de batalha o card de artefato alvo de seu cemitério.\', \'type\': \'Criatura Artefato Lendária — Esfinge\', \'flavor\': \'Para que a hegemônica lhe conceda uma audiência, é necessário trazer um enigma que ela ainda não conheça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422944&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67c5c831-b9ce-4a84-9944-4908d5b6ed2c\', \'multiverseId\': 422944}, \'multiverseid\': 422944}, {\'name\': \'支配者韶伦\', \'text\': \'飞行\\n当支配者韶伦进战场时，你可以将目标神器牌从你的坟墓场移回战场。\', \'type\': \'传奇神器生物～史芬斯\', \'flavor\': \'为了赢得支配者的青睐，必得准备一则她没听过的谜语。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421189&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87399037-2c93-4dad-9358-02ce07d45035\', \'multiverseId\': 421189}, \'multiverseid\': 421189}]', '[{\'name\': \'Sich entfaltende Wildnis\', \'text\': \'{T}, opfere die Sich entfaltende Wildnis: Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe sie getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Ohne den störenden Einfluss der Zivilisation wird sich die Natur immer nach dem eigenen Bedarf formen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421613&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'840b1d57-5806-4c7b-a327-dd807ecacab6\', \'multiverseId\': 421613}, \'multiverseid\': 421613}, {\'name\': \'Terrenos expansivos\', \'text\': \'{T}, sacrificar los Terrenos expansivos: Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Sin las entrometidas manos de la civilización, la naturaleza siempre se moldeará según sus propias necesidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423368&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d48519f5-56a4-44fc-83d2-5069e90457f5\', \'multiverseId\': 423368}, \'multiverseid\': 423368}, {\'name\': \'Étendues sauvages en évolution\', \'text\': \'{T}, sacrifiez les Étendues sauvages en évolution : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.\', \'type\': \'Terrain\', \'flavor\': "Sans interférence de la civilisation, la nature s\'adapte toujours à ses propres besoins.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421964&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'95cff037-d502-4825-b7a1-91fa78095510\', \'multiverseId\': 421964}, \'multiverseid\': 421964}, {\'name\': \'Terre Selvagge in Evoluzione\', \'text\': \'{T}, Sacrifica le Terre Selvagge in Evoluzione: Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Senza la presenza invasiva della civiltà, la natura plasmerà se stessa a seconda dei propri bisogni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422315&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'684115bf-b17b-48c3-ae39-afec92628855\', \'multiverseId\': 422315}, \'multiverseid\': 422315}, {\'name\': \'進化する未開地\', \'text\': \'{T}, 進化する未開地を生け贄に捧げる：あなたのライブラリーから基本土地・カード１枚を探し、それをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'文明の手による介入がなければ、自然は必ずその必要に応じて自らを変容させる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422666&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9790c59e-9004-4955-a3d5-1e007b027f37\', \'multiverseId\': 422666}, \'multiverseid\': 422666}, {\'name\': \'Terras em Desenvolvimento\', \'text\': \'{T}, Sacrifique Terras em Desenvolvimento: Procure um card de terreno básico em seu grimório e coloque-o no campo de batalha virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Sem a interferência das mãos da civilização, a natureza sempre se moldará às próprias necessidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423017&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'747b7e08-a5d2-47d9-a494-7be039af8000\', \'multiverseId\': 423017}, \'multiverseid\': 423017}, {\'name\': \'成形野地\', \'text\': \'{T}，牺牲成形野地：从你的牌库中搜寻一张基本地牌，并将之横置放进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'若没有文明的干预，自然将始终按照它自己的需求塑造自身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421262&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7c08466f-a372-481b-8992-ac958ba9ab00\', \'multiverseId\': 421262}, \'multiverseid\': 421262}]', '[{\'name\': \'Sicherheitssphäre\', \'text\': \'Kreaturen können dich oder einen Planeswalker, den du kontrollierst, nicht angreifen, es sei denn, ihr Beherrscher bezahlt {X} für jede dieser Kreaturen, wobei X die Anzahl an Verzauberungen ist, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Rakdos sind überzeugt, dass alle auf ihre Orgien versessen sind, selbst wenn man das Gegenteil behauptet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421396&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'929dad7d-26f8-40c1-8227-f2ab5b6364d6\', \'multiverseId\': 421396}, \'multiverseid\': 421396}, {\'name\': \'Esfera de seguridad\', \'text\': \'Las criaturas no pueden atacarte a ti ni a un planeswalker que controlas a menos que su controlador pague {X} por cada una de esas criaturas, donde X es el número de encantamientos que controlas.\', \'type\': \'Encantamiento\', \'flavor\': \'Los rakdos creen que todos están ansiosos por unirse a sus festejos, incluso cuando alguien lo niega.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423151&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'668b5e7b-8dcc-4a18-b92f-21f35606a483\', \'multiverseId\': 423151}, \'multiverseid\': 423151}, {\'name\': \'Sphère de sécurité\', \'text\': "Les créatures ne peuvent pas vous attaquer ou attaquer un planeswalker que vous contrôlez à moins que leur contrôleur ne paie {X} pour chacune de ces créatures, X étant le nombre d\'enchantements que vous contrôlez.", \'type\': \'Enchantement\', \'flavor\': \'Les Rakdos sont convaincus que tout le monde rêve de prendre part à leurs festivités, même quand on leur affirme le contraire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28da015d-7298-49c2-aa89-dd044cf32eb8\', \'multiverseId\': 421747}, \'multiverseid\': 421747}, {\'name\': \'Sfera della Sicurezza\', \'text\': \'Le creature non possono attaccare te o un planeswalker che controlli a meno che il loro controllore non paghi {X} per ciascuna di quelle creature, dove X è pari al numero di incantesimi che controlli.\', \'type\': \'Incantesimo\', \'flavor\': \'Anche se rassicurati del contrario, i Rakdos pensano che tutti siano ansiosi di partecipare alle loro gozzoviglie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422098&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ba80905-69cc-494e-9493-d7c4fa458585\', \'multiverseId\': 422098}, \'multiverseid\': 422098}, {\'name\': \'安全の領域\', \'text\': \'そのコントローラーが１体につき{X}を支払わないかぎり、クリーチャーではあなたやあなたがコントロールするプレインズウォーカーを攻撃できない。Ｘはあなたがコントロールするエンチャントの総数に等しい。\', \'type\': \'エンチャント\', \'flavor\': \'ラクドス教徒は誰もが彼らの乱痴気騒ぎに参加したがっていると信じている。たとえそうではないと告げられても、である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422449&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3aa5cbef-4ab1-4e27-bb27-22062fa9e68b\', \'multiverseId\': 422449}, \'multiverseid\': 422449}, {\'name\': \'Esfera de Segurança\', \'text\': \'As criaturas não podem atacar você nem um planeswalker que você controle a menos que seu controlador pague {X} para cada uma das criaturas, sendo X igual ao número de encantamentos que você controla.\', \'type\': \'Encantamento\', \'flavor\': \'Os Rakdos acreditam que todos estão ansiosos para participar de suas celebrações, mesmo quando são informados do contrário.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422800&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b246c414-b175-4a23-9c6b-b95d66e4258e\', \'multiverseId\': 422800}, \'multiverseid\': 422800}, {\'name\': \'安全球罩\', \'text\': \'对每个生物而言，除非其操控者为其支付{X}，否则它不能攻击你或由你操控的鹏洛客，X为由你操控的结界数量。\', \'type\': \'结界\', \'flavor\': \'拉铎司教派相信所有人都渴望加入其欢宴，就算口头拒绝者也只是言不由衷。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421045&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c7d374f-a0c8-4f92-8fce-2a4aee3207cf\', \'multiverseId\': 421045}, \'multiverseid\': 421045}]', '[{\'name\': \'Sidar Kondo von Jamuraa\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\nKreaturen ohne Flugfähigkeit oder Reichweite, die deine Gegner kontrollieren, können Kreaturen mit Stärke 2 oder weniger nicht blocken.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421361&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'726601ae-333d-4923-9aae-dc66cad2af32\', \'multiverseId\': 421361}, \'multiverseid\': 421361}, {\'name\': \'Sidar Kondo de Jamuraa\', \'text\': \'Flanquea. (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\nLas criaturas que controlan tus oponentes sin las habilidades de volar o alcance no pueden bloquear a criaturas con fuerza de 2 o menos.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423116&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'674ce3c0-152f-4e18-a4cf-36c8cea048be\', \'multiverseId\': 423116}, \'multiverseid\': 423116}, {\'name\': \'Sidar Kondo de Djamûraa\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\nLes créatures sans le vol ou la portée que vos adversaires contrôlent ne peuvent pas bloquer les créatures de force inférieure ou égale à 2.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421712&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4677fd84-2a89-4a98-b28b-7e99e72f92b4\', \'multiverseId\': 421712}, \'multiverseid\': 421712}, {\'name\': \'Sidar Kondo di Jamuraa\', \'text\': \'Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\nLe creature senza volare o raggiungere controllate dai tuoi avversari non possono bloccare creature con forza pari o inferiore a 2.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422063&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a914fb6-9a08-47c7-bf6b-4583f2d6b7bb\', \'multiverseId\': 422063}, \'multiverseid\': 422063}, {\'name\': \'ジャムーラのシダー・コンド\', \'text\': \'側面攻撃（側面攻撃を持たないクリーチャーがこのクリーチャーをブロックするたび、ターン終了時まで、そのブロックしているクリーチャーは－１/－１の修整を受ける。）\\n対戦相手がコントロールする飛行や到達を持たないクリーチャーでは、パワーが２以下のクリーチャーをブロックできない。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422414&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7fd34f1-5ea6-4c7a-8bfc-9e8edafaeb2d\', \'multiverseId\': 422414}, \'multiverseid\': 422414}, {\'name\': \'Sidar Kondo de Jamuraa\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\nAs criaturas sem voar nem alcance que seus oponentes controlam não podem bloquear criaturas com poder igual ou inferior a 2.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422765&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d25e3ef-9e46-4894-80b5-a3161e535274\', \'multiverseId\': 422765}, \'multiverseid\': 422765}, {\'name\': \'杰姆拉的西达将军刚多\', \'text\': \'侧面攻击（每当一个不具侧面攻击异能的生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n由对手操控且不具飞行或延势异能的生物不能阻挡力量等于或小于2的生物。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421010&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c0a09fb-0874-4393-9f5f-cefe162272f6\', \'multiverseId\': 421010}, \'multiverseid\': 421010}]', '[{\'name\': \'Siechen\', \'text\': \'Alle Kreaturen erhalten -4/-4 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Das Leben ist so vergänglich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421433&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7e8d457-66aa-46b3-bc2d-898e3e809b57\', \'multiverseId\': 421433}, \'multiverseid\': 421433}, {\'name\': \'Podredumbre\', \'text\': \'Todas las criaturas obtienen -4/-4 hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'Cuán frágil es la vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423188&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'91d1e81f-38ed-4799-89d7-34eebda07334\', \'multiverseId\': 423188}, \'multiverseid\': 423188}, {\'name\': \'Croupissement\', \'text\': "Toutes les créatures gagnent -4/-4 jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'La vie est si fragile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b53f9c0-b6e8-49c0-ad49-954a3c4cc597\', \'multiverseId\': 421784}, \'multiverseid\': 421784}, {\'name\': \'Languire\', \'text\': \'Tutte le creature prendono -4/-4 fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'La vita è così labile...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422135&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'adb23a0f-4ae0-48f4-9bbc-7c26bed38654\', \'multiverseId\': 422135}, \'multiverseid\': 422135}, {\'name\': \'衰滅\', \'text\': \'ターン終了時まで、すべてのクリーチャーは－４/－４の修整を受ける。\', \'type\': \'ソーサリー\', \'flavor\': \'生命とはかように脆く、儚いもの。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422486&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3472cb7a-6166-49ef-a8e7-401892f6aa5c\', \'multiverseId\': 422486}, \'multiverseid\': 422486}, {\'name\': \'Debilitar\', \'text\': \'Todas as criaturas recebem -4/-4 até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'A vida é tão frágil.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422837&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25836b24-cf1e-4004-93dd-bbab0f079302\', \'multiverseId\': 422837}, \'multiverseid\': 422837}, {\'name\': \'衰萎\', \'text\': \'所有生物得-4/-4直到回合结束。\', \'type\': \'法术\', \'flavor\': \'生命就是如此脆弱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421082&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a978cef-c526-4fcb-b4f7-3219f11d5a09\', \'multiverseId\': 421082}, \'multiverseid\': 421082}]', '[{\'name\': \'Silas Renn, Meistersucher\', \'text\': \'Todesberührung\\nImmer wenn Silas Renn, Meistersucher, einem Spieler Kampfschaden zufügt, bestimme eine Artefaktkarte deiner Wahl in deinem Friedhof. Du kannst jene Karte in diesem Zug wirken.\\nPartner (Du kannst zwei Kommandeure haben, falls beide Partner haben.)\', \'type\': \'Legendäre Artefaktkreatur — Mensch\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421362&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2854818-b284-437f-b1fc-fb926a15540f\', \'multiverseId\': 421362}, \'multiverseid\': 421362}, {\'name\': \'Silas Renn, buscador experto\', \'text\': \'Toque mortal.\\nSiempre que Silas Renn, buscador experto haga daño de combate a un jugador, elige la carta de artefacto objetivo en tu cementerio. Puedes lanzar esa carta este turno.\\nCamarada. (Puedes tener dos comandantes si ambos tienen camarada.)\', \'type\': \'Criatura artefacto legendaria — Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423117&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'19807af3-2e10-4064-8327-deddb1ebfeca\', \'multiverseId\': 423117}, \'multiverseid\': 423117}, {\'name\': \'Silas Renn, expert chercheur\', \'text\': "Contact mortel\\nÀ chaque fois que Silas Renn, expert chercheur inflige des blessures de combat à un joueur, choisissez une carte d\'artefact ciblée dans votre cimetière. Vous pouvez lancer cette carte ce tour-ci.\\nPartenariat (Vous pouvez avoir deux commandants si les deux ont le partenariat.)", \'type\': \'Créature-artefact légendaire : humain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421713&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bbd3d6c-ad43-49e6-af14-6abbeee6d726\', \'multiverseId\': 421713}, \'multiverseid\': 421713}, {\'name\': \'Silas Renn, Esperto Cercatore\', \'text\': \'Tocco letale\\nOgniqualvolta Silas Renn, Esperto Cercatore infligge danno da combattimento a un giocatore, scegli una carta artefatto bersaglio nel tuo cimitero. Puoi lanciare quella carta in questo turno.\\nPartner (Puoi avere due comandanti se entrambi hanno partner.)\', \'type\': \'Creatura Artefatto Leggendaria — Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422064&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'018b164d-3ede-4c72-868e-f8263082870e\', \'multiverseId\': 422064}, \'multiverseid\': 422064}, {\'name\': \'求道の達人、サイラス・レン\', \'text\': \'接死\\n求道の達人、サイラス・レンがプレイヤー１人に戦闘ダメージを与えるたび、あなたの墓地からアーティファクト・カード１枚を対象とする。このターン、あなたはそのカードを唱えてもよい。\\n共闘（両方が共闘を持つなら、あなたは２体の統率者を使用できる。）\', \'type\': \'伝説のアーティファクト・クリーチャー — 人間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422415&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1350f31c-feb3-4c82-abd9-ce85ddab9d93\', \'multiverseId\': 422415}, \'multiverseid\': 422415}, {\'name\': \'Silas Renn, Adepto Buscador\', \'text\': \'Toque mortífero\\nToda vez que Silas Renn, Adepto Buscador, causar dano de combate a um jogador, escolha um card de artefato alvo em seu cemitério. Você pode conjurar aquele card neste turno.\\nParceiro (Você pode ter dois comandantes se ambos tiverem parceiro.)\', \'type\': \'Criatura Artefato Lendária — Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422766&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88dc0ebb-713b-4f30-91ac-74a27ed3c3bf\', \'multiverseId\': 422766}, \'multiverseid\': 422766}, {\'name\': \'致知专家赛拉司雷恩\', \'text\': \'死触\\n每当致知专家赛拉司雷恩对任一牌手造成战斗伤害时，选择目标在你坟墓场中的神器牌。本回合中，你可以施放该牌。\\n拍档（你可将两个具有拍档异能的生物共同用作指挥官。）\', \'type\': \'传奇神器生物～人类\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421011&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af77009e-012a-4097-aa74-a1cb16ed5b94\', \'multiverseId\': 421011}, \'multiverseid\': 421011}]', '[{\'name\': \'Simic-Petschaft\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {G}{U}.\', \'type\': \'Artefakt\', \'flavor\': \'Für das Simic-Kombinat ist ihr Siegel nicht nur ein Ehrenemblem, sondern auch ihr Markenzeichen. Wenn man es auf einem biologischen Erzeugnis sieht, steht es für überragende Handwerkskunst, geniale Innovation und noch höhere Kosten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421589&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ddcc7c8-205c-4b2a-8702-ece38512e60c\', \'multiverseId\': 421589}, \'multiverseid\': 421589}, {\'name\': \'Sello simic\', \'text\': \'{1}, {T}: Agrega {G}{U} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Para el Combinado Simic su sello no solo sirve como un emblema de honor, sino como una marca registrada. Esa imagen familiar en cualquier bien biológico asegura una excelente calidad, una innovación ingeniosa y un alto precio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423344&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'63a1fe13-5ace-4bb8-ad77-70b02eea39b9\', \'multiverseId\': 423344}, \'multiverseid\': 423344}, {\'name\': \'Cachet de Simic\', \'text\': \'{1}, {T} : Ajoutez {G}{U} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Pour le Cartel de Simic, ce cachet n\'est pas un emblème d\'honneur, mais une marque déposée. Son image reconnue qui apparaît sur tout produit biologique est synonyme de savoir-faire hors du commun, d\'innovation et de prix exorbitant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421940&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af68eb76-c42c-44bf-b025-03e2613c1734\', \'multiverseId\': 421940}, \'multiverseid\': 421940}, {\'name\': \'Sigillo Simic\', \'text\': \'{1}, {T}: Aggiungi {G}{U} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': "Per l\'Alleanza Simic, il sigillo non serve come un emblema ma come un marchio di proprietà. La sua immagine consueta su qualsiasi bene biologico ne attesta la superba fattura, l\'ingegnosa originalità e il costo elevato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422291&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c553564b-f61d-49e3-925a-e9cd1d542789\', \'multiverseId\': 422291}, \'multiverseid\': 422291}, {\'name\': \'シミックの印鑑\', \'text\': \'{1}, {T}：あなたのマナ・プールに{G}{U}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'シミック連合にとって、紋章は名誉を示すものではなく商標である。この見慣れたシンボルはあらゆる生物学的な消耗品につけられていて、卓絶した技術と独創的な革新と高額な値段を意味している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422642&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cbde295d-1c9f-4829-88fc-a8f84f1b78a6\', \'multiverseId\': 422642}, \'multiverseid\': 422642}, {\'name\': \'Sinete Simic\', \'text\': \'{1}, {T}: Adicione {G}{U} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Para o Conluio Simic, seu símbolo não é um emblema de honra, mas uma marca distintiva. Sua imagem familiar em qualquer ser biológico é um atestado de suprema arte, inovação engenhosa e alto custo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422993&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'17d9a5f0-82d8-4de9-8d87-7d19f6cc43a0\', \'multiverseId\': 422993}, \'multiverseid\': 422993}, {\'name\': \'析米克印记\', \'text\': \'{1}，{T}：加{G}{U}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'对析米克联合而言，其印记并非荣誉之徽记，而是注册商标。这熟悉图像在任何生体用品上都可见到，证明了为其投资的高超技巧，精妙创意，以及昂贵费用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421238&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'08a2d6f9-a996-4ac2-a85d-027be4612d34\', \'multiverseId\': 421238}, \'multiverseid\': 421238}]', "[{'name': 'Simic-Wachstumskammer', 'text': 'Die Simic-Wachstumskammer kommt getappt ins Spiel.\\nWenn die Simic-Wachstumskammer ins Spiel kommt, bringe ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{T}: Erhöhe deinen Manavorrat um {G}{U}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421645&type=card', 'language': 'German', 'identifiers': {'scryfallId': '906a9554-03b3-4a3a-a936-acdd4e001542', 'multiverseId': 421645}, 'multiverseid': 421645}, {'name': 'Cámara de crecimiento simic', 'text': 'La Cámara de crecimiento simic entra al campo de batalla girada.\\nCuando la Cámara de crecimiento simic entre al campo de batalla, regresa una tierra que controlas a la mano de su propietario.\\n{T}: Agrega {G}{U} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423400&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '02bef1a1-eb8b-4ee2-b57f-8040d46549af', 'multiverseId': 423400}, 'multiverseid': 423400}, {'name': 'Chambre de croissance des Simic', 'text': 'La Chambre de croissance des Simic arrive sur le champ de bataille engagée.\\nQuand la Chambre de croissance des Simic arrive sur le champ de bataille, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {G}{U} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421996&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a96fdb1f-697f-4513-8775-33bb3a30c5cc', 'multiverseId': 421996}, 'multiverseid': 421996}, {'name': 'Camera di Coltura Simic', 'text': 'La Camera di Coltura Simic entra nel campo di battaglia TAPpata.\\nQuando la Camera di Coltura Simic entra nel campo di battaglia, fai tornare una terra che controlli in mano al suo proprietario.\\n{T}: Aggiungi {G}{U} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422347&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b6be9d74-cddb-4da7-9934-4fd9d68b596d', 'multiverseId': 422347}, 'multiverseid': 422347}, {'name': 'シミックの成長室', 'text': 'シミックの成長室はタップ状態で戦場に出る。\\nシミックの成長室が戦場に出たとき、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n{T}：あなたのマナ・プールに{G}{U}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422698&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7281895a-6fbf-473e-bd12-6f9f26273644', 'multiverseId': 422698}, 'multiverseid': 422698}, {'name': 'Câmara de Crescimento Simic', 'text': 'Câmara de Crescimento Simic entra no campo de batalha virado.\\nQuando Câmara de Crescimento Simic entrar no campo de batalha, devolva um terreno que você controla para a mão de seu dono.\\n{T}: Adicione {G}{U} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423049&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '294a1dc8-c5e5-4fdf-81a7-618872da996e', 'multiverseId': 423049}, 'multiverseid': 423049}, {'name': '析米克生长室', 'text': '析米克生长室须横置进战场。\\n当析米克生长室进战场时，将一个由你操控的地移回其拥有者手上。\\n{T}：加{G}{U}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421294&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '65a8060a-23d6-4b87-b0ae-2bf94b5a4985', 'multiverseId': 421294}, 'multiverseid': 421294}]", '[{\'name\': \'Sitz der Synode\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {U}.\', \'type\': \'Artefakt, Land\', \'flavor\': \'Lumengrid, Sitz des Wissensvorrats, Quelle der vedalkischen Geheimnisse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f59b0068-e790-4abe-82e7-084bebc89595\', \'multiverseId\': 421642}, \'multiverseid\': 421642}, {\'name\': \'Sede del sínodo\', \'text\': \'{T}: Agrega {U} a tu reserva de maná.\', \'type\': \'Tierra artefacto\', \'flavor\': \'Lúmengrid, sede del Pozo del conocimiento, fuente del saber vedalken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423397&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a19ef84-ac45-48cc-b5ce-e05ab83b5c35\', \'multiverseId\': 423397}, \'multiverseid\': 423397}, {\'name\': \'Siège du Synode\', \'text\': \'{T} : Ajoutez {U} à votre réserve.\', \'type\': \'Terrain-artefact\', \'flavor\': \'Lumengrid, site du Sauvoir de Connaissance, source arcane des vedalkens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421993&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2fb1f141-b4a4-443f-839b-f6afb829d397\', \'multiverseId\': 421993}, \'multiverseid\': 421993}, {\'name\': \'Sede del Sinodo\', \'text\': \'{T}: Aggiungi {U} alla tua riserva di mana.\', \'type\': \'Terra Artefatto\', \'flavor\': "Lumengrid, sito della Pozza della Conoscenza, la fonte dell\'arcana sapienza dei vedalken.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422344&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ac0be29-0607-4baa-ab46-0a88d5f6867b\', \'multiverseId\': 422344}, \'multiverseid\': 422344}, {\'name\': \'教議会の座席\', \'text\': \'{T}：あなたのマナ・プールに{U}を加える。\', \'type\': \'アーティファクト・土地\', \'flavor\': \'ルーメングリッド、ヴィダルケンの秘儀の源である、知恵の池のある場所。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422695&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'811d6f9c-2759-4fc8-a745-3687e9b118b0\', \'multiverseId\': 422695}, \'multiverseid\': 422695}, {\'name\': \'Assento do Sínodo\', \'text\': \'{T}: Adicione {U} à sua reserva de mana.\', \'type\': \'Terreno Artefato\', \'flavor\': \'Lumengrid, local do Reservatório do Conhecimento, fonte da sabedoria misteriosa dos vedalkeanos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423046&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2fb8e928-b617-4e66-919d-e21fef5cf94a\', \'multiverseId\': 423046}, \'multiverseid\': 423046}, {\'name\': \'悉诺议会宅邸\', \'text\': \'{T}：加{U}到你的法术力池中。\', \'type\': \'神器地\', \'flavor\': \'博识都，知识之池静凝之地，维多肯秘密的泉源。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421291&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ff922995-cdce-4472-b3d3-8dbd0f50aab2\', \'multiverseId\': 421291}, \'multiverseid\': 421291}]', '[{\'name\': \'Slobad, Goblin-Kesselflicker\', \'text\': \'Opfere ein Artefakt: Ein Artefakt deiner Wahl erhält Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Goblin, Handwerker\', \'flavor\': \'„Ich pflegte zu sagen, dass er verbannt wurde, weil er zu klug war. Jetzt weiß ich, warum er nie lachte." —Glissa Sonnensucher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421452&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f071cc16-4e5a-4384-a73b-e6791d37c9b0\', \'multiverseId\': 421452}, \'multiverseid\': 421452}, {\'name\': \'Slobad, chapucero trasgo\', \'text\': \'Sacrificar un artefacto: El artefacto objetivo gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura legendaria — Artífice trasgo\', \'flavor\': \'"Solía bromear diciendo que lo habían exiliado por ser demasiado listo. Ahora sé por qué nunca le causó gracia". —Glissa Buscasol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423207&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'072afd51-f261-49dc-af67-2aa6354aa838\', \'multiverseId\': 423207}, \'multiverseid\': 423207}, {\'name\': \'Slobad, rétameur gobelin\', \'text\': "Sacrifiez un artefact : L\'artefact ciblé acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : gobelin et artificier\', \'flavor\': "« Je lui disais toujours, en plaisantant, qu\'il avait été exilé parce qu\'il était trop intelligent. Je sais maintenant pourquoi cela ne le faisait pas rire. » —Glissa Cherchesoleil", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421803&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bbf6b3bb-99c3-417b-8c98-9c3ad54edc51\', \'multiverseId\': 421803}, \'multiverseid\': 421803}, {\'name\': \'Slobad, Riparatore Goblin\', \'text\': \'Sacrifica un artefatto: Un artefatto bersaglio ha indistruttibile fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Artefice Goblin\', \'flavor\': \'"L\\\'ho sempre preso in giro dicendo che lo avevano esiliato perché era troppo intelligente. Adesso capisco perché non ha mai riso." —Glissa Sunseeker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422154&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f532b46-ce56-4755-80b0-998d2c0d31bb\', \'multiverseId\': 422154}, \'multiverseid\': 422154}, {\'name\': \'ゴブリンの修繕屋スロバッド\', \'text\': \'アーティファクト１つを生け贄に捧げる：アーティファクト１つを対象とする。ターン終了時まで、それは破壊不能を得る。\', \'type\': \'伝説のクリーチャー — ゴブリン・工匠\', \'flavor\': \'「以前は、彼が賢すぎたから追放されたんだなんて、冗談で言ってたわ。やっと彼が笑わなかった理由がわかったわね。」 ――グリッサ・サンシーカー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422505&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'294b9ab3-f69e-4c3b-aee0-4550fbec0cfc\', \'multiverseId\': 422505}, \'multiverseid\': 422505}, {\'name\': \'Slobad, Funileiro Goblin\', \'text\': \'Sacrifique um artefato: O artefato alvo ganha indestrutível até o final do turno.\', \'type\': \'Criatura Lendária — Goblin Artesão\', \'flavor\': \'"Eu costumava falar brincando que ele tinha sido exilado por ser muito esperto. Agora eu sei por que ele nunca ria." — Glissa, Perscrutadora do Sol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6449f21-efab-42e4-b6c3-1ead538ddafe\', \'multiverseId\': 422856}, \'multiverseid\': 422856}, {\'name\': \'鬼怪修补匠史罗巴\', \'text\': \'牺牲一个神器：目标神器获得不灭异能直到回合结束。\', \'type\': \'传奇生物～鬼怪／神器师\', \'flavor\': \'「我之前常跟他开玩笑，说他是因为太聪明才被放逐的。现在我才知道他为什么根本不觉得好笑。」 ～寻日者格莉莎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421101&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d6387327-2665-4c04-9347-6bd04e8af959\', \'multiverseId\': 421101}, \'multiverseid\': 421101}]', "[{'name': 'Sonnenblütenhain', 'text': 'Der Sonnenblütenhain kommt getappt ins Spiel, es sei denn, du kontrollierst einen Wald oder eine Ebene.\\n{T}: Erhöhe deinen Manavorrat um {G} oder {W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421648&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b390a41c-b0b3-476b-841a-2c26744835c5', 'multiverseId': 421648}, 'multiverseid': 421648}, {'name': 'Arboleda Pétalo Solar', 'text': 'La Arboleda Pétalo Solar entra al campo de batalla girada a menos que controles un bosque o una llanura.\\n{T}: Agrega {G} o {W} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423403&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bfdb2fc6-d5be-4b7d-be77-08d7542c8eac', 'multiverseId': 423403}, 'multiverseid': 423403}, {'name': 'Bosquet de Solpétal', 'text': 'Le Bosquet de Solpétal arrive sur le champ de bataille engagé à moins que vous ne contrôliez une forêt ou une plaine.\\n{T} : Ajoutez {G} ou {W} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421999&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2c09610b-34d9-4701-a7e7-4d0aa6999c5d', 'multiverseId': 421999}, 'multiverseid': 421999}, {'name': 'Boschetto di Petali Solari', 'text': 'Il Boschetto di Petali Solari entra nel campo di battaglia TAPpato a meno che tu non controlli una Foresta o una Pianura.\\n{T}: Aggiungi {G} o {W} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422350&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bc9eae57-2a28-4274-8f01-cb1ecdd772de', 'multiverseId': 422350}, 'multiverseid': 422350}, {'name': '陽花弁の木立ち', 'text': 'あなたが森か平地をコントロールしていないかぎり、陽花弁の木立ちはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}か{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422701&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c61e1088-28fa-46a5-878a-b6d3cc487cc2', 'multiverseId': 422701}, 'multiverseid': 422701}, {'name': 'Bosque da Pétala Solar', 'text': 'Bosque da Pétala Solar entra no campo de batalha virado, a menos que você controle uma Floresta ou uma Planície.\\n{T}: Adicione {G} ou {W} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423052&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4a01d526-5e9f-47a4-9f2d-9156dc1e6d5d', 'multiverseId': 423052}, 'multiverseid': 423052}, {'name': '日瓣树丛', 'text': '除非你操控树林或平原，否则日瓣树丛须横置进战场。\\n{T}：加{G}或{W}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421297&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a8e991a8-18aa-4dc8-b363-bdb3265e4707', 'multiverseId': 421297}, 'multiverseid': 421297}]", '[{\'name\': \'Sonnengras-Prärie\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {G}{W}.\', \'type\': \'Land\', \'flavor\': \'In Otaria sind Frieden und Harmonie selten. Gegenden, in denen man beides findet, sind hochgeschätzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421647&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0dc592da-809f-41e5-9115-1a22096970ed\', \'multiverseId\': 421647}, \'multiverseid\': 421647}, {\'name\': \'Pradera Hierbasol\', \'text\': \'{1}, {T}: Agrega {G}{W} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'En Otaria, la paz y la armonía son raras. Los lugares que proveen ambas son apreciados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce81f02e-0fe8-489b-b990-54a460e3e85a\', \'multiverseId\': 423402}, \'multiverseid\': 423402}, {\'name\': \'Prairie de Solherbe\', \'text\': \'{1}, {T} : Ajoutez {G}{W} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Ils sont bien rares et très secrets, en Otaria, les lieux où règnent encore la paix et l\'harmonie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421998&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0dae782a-9946-45f9-a8c0-b6b8a3f524cc\', \'multiverseId\': 421998}, \'multiverseid\': 421998}, {\'name\': \'Prateria di Solerba\', \'text\': \'{1}, {T}: Aggiungi {G}{W} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "A Otaria la pace e l\'armonia sono rare. E i luoghi in cui è possibile trovare entrambe sono custoditi scrupolosamente.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422349&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acd04e87-8ed5-44e3-af29-e10b62626c77\', \'multiverseId\': 422349}, \'multiverseid\': 422349}, {\'name\': \'サングラスの大草原\', \'text\': \'{1}, {T}：あなたのマナ・プールに{G}{W}を加える。\', \'type\': \'土地\', \'flavor\': \'オタリアでは、平和と調和はまれにしかない。その２つがある場所は大切にされている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422700&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9805df74-76a7-40d0-a67f-853c2bc17be5\', \'multiverseId\': 422700}, \'multiverseid\': 422700}, {\'name\': \'Pradaria de Capim Solar\', \'text\': \'{1}, {T}: Adicione {G}{W} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Em Otaria, a paz e a harmonia são raras. Locais que oferecem ambas são tratados com muito zelo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423051&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9ce2eecc-be56-42e8-b57b-1bc9220a87d7\', \'multiverseId\': 423051}, \'multiverseid\': 423051}, {\'name\': \'曦草沃原\', \'text\': \'{1}，{T}：加{G}{W}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'在欧塔利亚，宁静与和谐已难寻见。少数例外的净土便格外值得珍惜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421296&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7b3de948-f2c5-4a6a-ad67-c04b94fa7375\', \'multiverseId\': 421296}, \'multiverseid\': 421296}]', '[{\'name\': \'Sonnenring\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {C}{C}.\', \'type\': \'Artefakt\', \'flavor\': \'Die Kunst, das Licht eines fernen Sterns in einem Ring aus reinem Gold einzufangen, ist mit der Zeit verlorengegangen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421591&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58da15ac-97d0-431e-8012-1c79f9e803fd\', \'multiverseId\': 421591}, \'multiverseid\': 421591}, {\'name\': \'Anillo solar\', \'text\': \'{T}: Agrega {C}{C} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Se ha perdido en el tiempo el arte del artífice de atrapar la luz de una estrella distante en un anillo del oro más puro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423346&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f5db5ad-5819-49e3-b03b-e7c60ed438f6\', \'multiverseId\': 423346}, \'multiverseid\': 423346}, {\'name\': \'Anneau solaire\', \'text\': \'{T} : Ajoutez {C}{C} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "L\'art de l\'artificier de piéger la lumière d\'un astre lointain dans un anneau d\'or le plus pur est désormais perdu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421942&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7785fced-12d5-4e2d-b31b-148d00df9acf\', \'multiverseId\': 421942}, \'multiverseid\': 421942}, {\'name\': \'Anello Solare\', \'text\': \'{T}: Aggiungi {C}{C} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': "Persa col tempo è l\'arte dell\'artefice di intrappolare la luce di una stella lontana in un anello di oro purissimo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422293&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f58f4e79-697f-4b1c-b0e8-a05e4cb3f0f2\', \'multiverseId\': 422293}, \'multiverseid\': 422293}, {\'name\': \'太陽の指輪\', \'text\': \'{T}：あなたのマナ・プールに{C}{C}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'遥かな星の光を最も純なる黄金の指輪に捕らえる工匠の技は、時の中で失われた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422644&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c753bba-8b32-473f-85f7-b4dc6fd640a2\', \'multiverseId\': 422644}, \'multiverseid\': 422644}, {\'name\': \'Anel Solar\', \'text\': \'{T}: Adicione {C}{C} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Perdida no tempo está a arte dos artífices de capturar a luz de uma estrela distante em um anel do mais puro ouro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422995&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18495f24-078e-4284-a0cb-7dae4f968897\', \'multiverseId\': 422995}, \'multiverseid\': 422995}, {\'name\': \'阳光戒\', \'text\': \'{T}：加{C}{C}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'神器师曾能利用至纯黄金打造的戒指捕获来自遥远星辰的光芒，这门技艺如今早已亡佚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421240&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88df7d68-9d53-4093-b529-4eb8c5be0432\', \'multiverseId\': 421240}, \'multiverseid\': 421240}]', '[{\'name\': \'Sonnenschmieder\', \'text\': \'Die ausgerüstete Kreatur erhält +4/+0.\\n{R}{W}, löse den Sonnenschmieder: Durchsuche deine Bibliothek nach einer roten oder weißen Spontanzauberkarte mit umgewandelten Manakosten von 4 oder weniger und wirke die Karte, ohne ihre Manakosten zu bezahlen. Mische danach deine Bibliothek.\\nAusrüsten {3}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421594&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0510e96d-ba29-4fe7-93cd-f8109622b0db\', \'multiverseId\': 421594}, \'multiverseid\': 421594}, {\'name\': \'Forjasol\', \'text\': \'La criatura equipada obtiene +4/+0.\\n{R}{W}, desanexar el Forjasol: Busca en tu biblioteca una carta de instantáneo roja o blanca con coste de maná convertido de 4 o menos y lanza esa carta sin pagar su coste de maná. Luego baraja tu biblioteca.\\nEquipar {3}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423349&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'004ddfb4-ac55-45b9-8a60-db1a2ccc6ea2\', \'multiverseId\': 423349}, \'multiverseid\': 423349}, {\'name\': \'Forgeur de soleil\', \'text\': "La créature équipée gagne +4/+0.\\n{R}{W}, détachez le Forgeur de soleil : Cherchez dans votre bibliothèque une carte d\'éphémère rouge ou blanche avec un coût converti de mana inférieur ou égal à 4 et lancez cette carte sans payer son coût de mana. Mélangez ensuite votre bibliothèque.\\nÉquipement {3}", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421945&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2054eb3-09e8-4a3c-bb51-9ae3f3af7c68\', \'multiverseId\': 421945}, \'multiverseid\': 421945}, {\'name\': \'Plasmasole\', \'text\': \'La creatura equipaggiata prende +4/+0.\\n{R}{W}, Togli il Plasmasole: Passa in rassegna il tuo grimorio per una carta istantaneo rossa o bianca con costo di mana convertito pari o inferiore a 4 e lancia quella carta senza pagare il suo costo di mana. Poi rimescola il tuo grimorio.\\nEquipaggiare {3}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422296&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41df8d64-8902-416f-866f-60ec38112285\', \'multiverseId\': 422296}, \'multiverseid\': 422296}, {\'name\': \'太陽打ちの槌\', \'text\': \'装備しているクリーチャーは＋４/＋０の修整を受ける。\\n{R}{W}, 太陽打ちの槌をはずす：あなたのライブラリーから点数で見たマナ・コストが４以下の赤か白のインスタント・カード１枚を探し、そのカードをそのマナ・コストを支払うことなく唱える。その後あなたのライブラリーを切り直す。\\n装備{3}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422647&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6885c366-4ab7-4f2c-964d-907e4eace40c\', \'multiverseId\': 422647}, \'multiverseid\': 422647}, {\'name\': \'Forjador de Sol\', \'text\': \'A criatura equipada recebe +4/+0.\\n{R}{W}, Solte Forjador de Sol: Procure em seu grimório um card de mágica instantânea vermelho ou branco com custo de mana convertido menor ou igual a 4 e conjure aquele card sem pagar seu custo de mana. Depois, embaralhe seu grimório.\\nEquipar {3}\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422998&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af8dbb19-5a41-46ac-8eff-7ad25243fb46\', \'multiverseId\': 422998}, \'multiverseid\': 422998}, {\'name\': \'铸阳锤\', \'text\': \'佩带此武具的生物得+4/+0。\\n{R}{W}，将铸阳锤卸装：从你的牌库中搜寻一张总法术力费用等于或小于4的红色或白色瞬间牌，并施放该牌，且不需支付其法术力费用。然后将你的牌库洗牌。\\n佩带{3}\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421243&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'008a749c-cade-4c3b-8bf7-f0b0bf40b6d5\', \'multiverseId\': 421243}, \'multiverseid\': 421243}]', '[{\'name\': \'Sphäre des Kommandeurs\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe der Farbidentität deines Kommandeurs.\\nOpfere die Sphäre des Kommandeurs: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Sie ist im Einklang mit der Essenz ihres Meisters.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9a0dce3-2081-4cda-b47c-03796ef77dc4\', \'multiverseId\': 421567}, \'multiverseid\': 421567}, {\'name\': \'Esfera del comandante\', \'text\': \'{T}: Agrega a tu reserva de maná un maná de cualquier color en la identidad de color de tu comandante.\\nSacrificar la Esfera del comandante: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Está en armonía con la esencia de su amo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423322&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13feeacd-d20a-46a4-9856-b2dc11c18d46\', \'multiverseId\': 423322}, \'multiverseid\': 423322}, {\'name\': \'Sphère du commandant\', \'text\': "{T} : Ajoutez à votre réserve un mana de n\'importe quelle couleur de l\'identité couleur de votre commandant.\\nSacrifiez la Sphère du commandant : Piochez une carte.", \'type\': \'Artefact\', \'flavor\': "Elle s\'harmonise avec l\'essence de son maître.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421918&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b6928976-c051-4a31-80ca-6cc17bc651e8\', \'multiverseId\': 421918}, \'multiverseid\': 421918}, {\'name\': \'Sfera del Comandante\', \'text\': "{T}: Aggiungi alla tua riserva di mana un mana di un qualsiasi colore nell\'identità di colore del tuo comandante.\\nSacrifica la Sfera del Comandante: Pesca una carta.", \'type\': \'Artefatto\', \'flavor\': "Si accorda all\'essenza del suo signore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422269&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d521c470-bdbc-4e70-98e5-845efa3cf20f\', \'multiverseId\': 422269}, \'multiverseid\': 422269}, {\'name\': \'統率者の宝球\', \'text\': \'{T}：あなたのマナ・プールに、あなたの統率者の固有色のうち好きな色１色のマナ１点を加える。\\n統率者の宝球を生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'それはその主の本質と調和する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422620&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cfbe00c1-dc4c-4cde-a3eb-367a2b964fa9\', \'multiverseId\': 422620}, \'multiverseid\': 422620}, {\'name\': \'Esfera do Comandante\', \'text\': \'{T}: Adicione a sua reserva de mana um mana de qualquer cor da identidade de cor de seu comandante.\\nSacrifique Esfera do Comandante: Compre um card.\', \'type\': \'Artefato\', \'flavor\': \'Ela se harmoniza com a essência de seu mestre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422971&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7cd1dd71-f70a-49dd-8e43-871ba94c8247\', \'multiverseId\': 422971}, \'multiverseid\': 422971}, {\'name\': \'指挥官法球\', \'text\': \'{T}：加一点法术力到你的法术力池中，其颜色为你指挥官标识色中的任一颜色。\\n牺牲指挥官法球：抓一张牌。\', \'type\': \'神器\', \'flavor\': \'它能与主人的精华同调。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421216&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2195de68-8a4b-47f7-adaa-d088e862022a\', \'multiverseId\': 421216}, \'multiverseid\': 421216}]', '[{\'name\': \'Spiegelgewebe\', \'text\': \'Alle anderen Kreaturen werden bis zum Ende des Zuges zu einer Kopie einer nichtlegendären Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Diejenigen, die nicht sind wie wir, sind unzuverlässig und unberechenbar. Lege deine Sicherheit in die Hände deines eigenen Volkes." —Bowen, Kapitän der Wache von Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421553&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5a765c59-166b-442b-a742-8e320a108fce\', \'multiverseId\': 421553}, \'multiverseid\': 421553}, {\'name\': \'Tejido especular\', \'text\': \'Cada otra criatura es una copia de la criatura objetivo que no sea legendaria hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Aquellos que son distintos no son confiables, son impredecibles. Pon tu seguridad en manos de tu propia gente". —Bowen, capitán de la guardia de Bárrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423308&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84c6b8d7-18db-4eda-997d-8e70bb497230\', \'multiverseId\': 423308}, \'multiverseid\': 423308}, {\'name\': \'Tisse-miroir\', \'text\': "Chaque autre créature devient une copie de la créature non-légendaire ciblée jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Ceux qui sont différents sont imprévisibles et traîtres. Place ta sécurité entre les mains de tes congénères. » —Bowen, capitaine de la garde de Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421904&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d224369-65d9-41ac-931c-c964d8ca6ee3\', \'multiverseId\': 421904}, \'multiverseid\': 421904}, {\'name\': \'Trama a Specchio\', \'text\': \'Ogni altra creatura diventa una copia di una creatura non leggendaria bersaglio fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Coloro che sono differenti non meritano fiducia, sono imprevedibili. Affida la tua sicurezza a quelli della tua stirpe." —Bowen, capitano delle guardie di Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422255&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d8a3df90-b921-443f-919c-2d5b696f47d3\', \'multiverseId\': 422255}, \'multiverseid\': 422255}, {\'name\': \'鏡編み\', \'text\': \'伝説でないクリーチャー１体を対象とする。ターン終了時まで、他の各クリーチャーはそれぞれ、それのコピーになる。\', \'type\': \'インスタント\', \'flavor\': \'「違ってる奴は、信頼もできないし、予想もできない。安全ってものは自分の仲間の手の中にしまっとくもんだ。」 ――バレントンの護衛長、ボウエン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422606&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0774432c-c099-4664-8a5c-d20ab9ee4d6c\', \'multiverseId\': 422606}, \'multiverseid\': 422606}, {\'name\': \'Espelho Prolífero\', \'text\': \'Cada outra criatura se torna uma cópia da criatura alvo que não seja lendária até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Aqueles que são diferentes são traiçoeiros e imprevisíveis. Coloque sua segurança nas mãos do seu próprio povo." — Bowen, capitão da guarda de Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422957&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'59c71d01-681c-4542-8fc8-5bd0f890e38b\', \'multiverseId\': 422957}, \'multiverseid\': 422957}, {\'name\': \'纺镜咒\', \'text\': \'所有其他生物成为目标非传奇生物的复制品直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「那些跟我们不一样的家伙既不可靠又难以捉摸。把安全交在自己人手上吧。」 ～八连屯卫队长伯文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421202&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b4ab22f-c311-4827-b703-84ff8d7eff04\', \'multiverseId\': 421202}, \'multiverseid\': 421202}]', '[{\'name\': \'Spiegelwesen\', \'text\': \'Wandelwicht (Diese Karte hat alle Kreaturentypen.)\\n{X}: Bis zum Ende des Zuges haben Kreaturen, die du kontrollierst, Basis-Stärke und -Widerstandskraft X/X und erhalten alle Kreaturentypen.\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': \'Es ist sich der Vielfalt an Arten in Lorwyn nicht bewusst und sieht immer nur sich, tausendfach widergespiegelt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421389&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10009718-982e-4348-ad80-fa8133a683b1\', \'multiverseId\': 421389}, \'multiverseid\': 421389}, {\'name\': \'Entidad del espejo\', \'text\': \'Cambiaformas. (Esta carta es de todos los tipos de criatura.)\\n{X}: Hasta el final del turno, las criaturas que controlas tienen una fuerza y resistencia base de X/X y ganan todos los tipos de criatura.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'Ignorante de la diversidad de Lorwyn, solo se ve a sí mismo, reflejado miles de veces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423144&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aefc9794-9b2f-432c-beda-fac76b9bc5df\', \'multiverseId\': 423144}, \'multiverseid\': 423144}, {\'name\': \'Entité miroir\', \'text\': "Changelin (Cette carte a tous les types de créature.)\\n{X} : Jusqu\'à la fin du tour, les créatures que vous contrôlez ont une force et une endurance de base de X/X et acquièrent tous les types de créature.", \'type\': \'Créature : changeforme\', \'flavor\': "Ignorant la diversité de Lorwyn, il ne voit que son propre reflet démultiplié à l\'infini.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421740&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4db78270-3ad8-456b-ba6c-ef66ccb06888\', \'multiverseId\': 421740}, \'multiverseid\': 421740}, {\'name\': \'Entità Riflettente\', \'text\': \'Cangiante (Questa carta ha tutti i tipi di creatura.)\\n{X}: Fino alla fine del turno, le creature che controlli hanno forza e costituzione base X/X e hanno tutti i tipi di creatura.\', \'type\': \'Creatura — Polimorfo\', \'flavor\': \'Inconsapevole delle diversità di Lorwyn, riesce a vedere solo se stessa, riflessa migliaia e migliaia di volte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422091&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7587231b-c782-419d-81f9-8fb4be972eed\', \'multiverseId\': 422091}, \'multiverseid\': 422091}, {\'name\': \'鏡の精体\', \'text\': \'多相（このカードは常にすべてのクリーチャー・タイプである。）\\n{X}：ターン終了時まで、あなたがコントロールするクリーチャーの基本のパワーとタフネスはＸ/Ｘになるとともにそれらはすべてのクリーチャー・タイプを得る。\', \'type\': \'クリーチャー — 多相の戦士\', \'flavor\': \'それはローウィンの多様さを気にもかけず、自分自身のみを見て、その反射を何千回も投げかける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422442&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea339b14-3b38-49d2-ac1a-e44f03746ae1\', \'multiverseId\': 422442}, \'multiverseid\': 422442}, {\'name\': \'Entidade do Espelho\', \'text\': \'Morfoloide (Este card é de todos os tipos de criatura.)\\n{X}: Até o final do turno, as criaturas que você controla têm poder e resistência básicos X/X e ganham todos os tipos de criatura.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'Alheia à diversidade de Lorwyn, ela só vê a si mesma, mil vezes refletida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422793&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'55b06b6b-8094-4264-98c3-7e5f88e68a61\', \'multiverseId\': 422793}, \'multiverseid\': 422793}, {\'name\': \'镜身灵\', \'text\': \'化形（此牌是所有生物类别。）\\n{X}：直到回合结束，由你操控的生物之基础力量与防御力为X/X且获得所有生物类别。\', \'type\': \'生物～变形兽\', \'flavor\': \'它没察觉洛温的多彩样貌，视线中只有自己投向自己、反射千遍的视线。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421038&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3b50d6e3-f4f4-4514-92e5-b9cbc9e0c8b4\', \'multiverseId\': 421038}, \'multiverseid\': 421038}]', '[{\'name\': \'Sprenghaufen\', \'text\': \'{T}: Wirf eine Münze. Falls du den Münzwurf gewinnst, zerstöre alle bleibenden Karten, die keine Länder sind.\', \'type\': \'Artefakt\', \'flavor\': \'„Lunten? Haben wir mehr als genug! Tja … welche zuerst?" —Flearan Einauge, Goblin-Ingenieur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421371&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7088a0d7-0b0f-4ef3-90bd-354ee8582784\', \'multiverseId\': 421371}, \'multiverseid\': 421371}, {\'name\': \'Bombonera\', \'text\': \'{T}: Lanza una moneda a cara o cruz. Si ganas el lanzamiento, destruye todos los permanentes que no sean tierra.\', \'type\': \'Artefacto\', \'flavor\': \'"¿Mechas? ¡Tenemos de sobra! A ver... ¿cuál era?" —Flearan el Tuerto, ingeniero trasgo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423126&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10b194d0-c09d-4928-87aa-e7bf178a9d82\', \'multiverseId\': 423126}, \'multiverseid\': 423126}, {\'name\': \'Tas-boum\', \'text\': \'{T} : Jouez à pile ou face. Si vous gagnez, détruisez tous les permanents non-terrain.\', \'type\': \'Artefact\', \'flavor\': "« Des mèches ? Il y en a plus qu\'assez ! Bon... C\'était laquelle ? » —Flearan le borgne, ingénieur gobelin", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421722&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29f3748e-6c9e-484e-b010-4765af7e110f\', \'multiverseId\': 421722}, \'multiverseid\': 421722}, {\'name\': \'Pallaboom\', \'text\': \'{T}: Lancia una moneta. Se vinci il lancio, distruggi tutti i permanenti non terra.\', \'type\': \'Artefatto\', \'flavor\': \'"Micce? Ne abbiamo a bizzeffe! Ora... qual era quella giusta?" —Flearan Monocolo, ingegnere goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d1aaef8-e668-4505-b835-b88b3cd88e6d\', \'multiverseId\': 422073}, \'multiverseid\': 422073}, {\'name\': \'爆積み\', \'text\': \'{T}：コイン投げをする。あなたがコイン投げに勝ったなら、すべての土地でないパーマネントを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'「導火線？もちろんある。たくさんな！さて……どれだったかな？」 ――ゴブリンの技師、片目のフリーラン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422424&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e2ca046-407d-4587-8eb1-fb4ac34cb82c\', \'multiverseId\': 422424}, \'multiverseid\': 422424}, {\'name\': \'Monte de Bum\', \'text\': \'{T}: Lance uma moeda. Se você vencer, destrua todas as permanentes que não sejam terrenos.\', \'type\': \'Artefato\', \'flavor\': \'"Estopins? Temos mais do que o suficiente! Agora... qual era mesmo?" — Flearan Caolho, engenheiro goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422775&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84a40167-f64d-40ca-a755-e782285dee87\', \'multiverseId\': 422775}, \'multiverseid\': 422775}, {\'name\': \'聚爆堆\', \'text\': \'{T}：掷一枚硬币。如果你赢得此掷，则消灭所有非地永久物。\', \'type\': \'神器\', \'flavor\': \'「引信？多的是！问题是. . . 哪根来着？」 ～鬼怪工程师独眼费理来\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421020&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5e8ec062-230b-4b61-96c9-5b45ebb0dcac\', \'multiverseId\': 421020}, \'multiverseid\': 421020}]', '[{\'name\': \'Starrer vom sechsten Revier\', \'text\': \'Der Starrer vom sechsten Revier erhält +1/+1 für jede Kreaturenkarte in den Friedhöfen deiner Gegner.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Selbst die Verlorenen und Untoten brauchen einen Beschützer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421437&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5346e30c-50a9-42ee-ad4d-c94591639670\', \'multiverseId\': 421437}, \'multiverseid\': 421437}, {\'name\': \'Tumulario del distrito seis\', \'text\': \'El Tumulario del distrito seis obtiene +1/+1 por cada carta de criatura en los cementerios de tus oponentes.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'Hasta los perdidos y los muertos vivientes necesitan un protector.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423192&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb257a62-0f33-465d-8d14-891292993494\', \'multiverseId\': 423192}, \'multiverseid\': 423192}, {\'name\': \'Nécrophage de la Sixième circonscription\', \'text\': \'Le Nécrophage de la Sixième circonscription gagne +1/+1 pour chaque carte de créature dans les cimetières de vos adversaires.\', \'type\': \'Créature : zombie\', \'flavor\': "Même les égarés et les morts-vivants ont besoin d\'un protecteur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421788&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2779446f-8c16-483d-a07d-2c7a3ed02669\', \'multiverseId\': 421788}, \'multiverseid\': 421788}, {\'name\': \'Presenza del Sesto Distretto\', \'text\': \'La Presenza del Sesto Distretto prende +1/+1 per ogni carta creatura nei cimiteri dei tuoi avversari.\', \'type\': \'Creatura — Zombie\', \'flavor\': \'Anche le anime perdute e i non morti hanno bisogno di un protettore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422139&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b2f63f9-9a48-4877-a634-9518d0f1a307\', \'multiverseId\': 422139}, \'multiverseid\': 422139}, {\'name\': \'第６管区のワイト\', \'text\': \'第６管区のワイトは、すべての対戦相手の墓地にあるクリーチャー・カード１枚につき＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'迷える者やアンデッドでさえ、庇護者を必要としている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422490&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9166faab-3f43-4b87-8d57-cc1b428055be\', \'multiverseId\': 422490}, \'multiverseid\': 422490}, {\'name\': \'Monstro da Jurisdição Seis\', \'text\': \'Monstro da Jurisdição Seis recebe +1/+1 para cada card de criatura no cemitério de seus oponentes.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Mesmo os perdidos e mortos-vivos precisam de proteção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422841&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9a5e3b4-4fdb-4aa4-977e-619acc04efd8\', \'multiverseId\': 422841}, \'multiverseid\': 422841}, {\'name\': \'第六城区老妖\', \'text\': \'所有对手的坟墓场中每有一张生物牌，第六城区老妖便得+1/+1。\', \'type\': \'生物～灵俑\', \'flavor\': \'就算堕落者和不死生物也需要保护者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421086&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4a1159a3-ad07-46ea-adb3-5cb31144b843\', \'multiverseId\': 421086}, \'multiverseid\': 421086}]', '[{\'name\': \'Steinhuf-Häuptling\', \'text\': \'Verursacht Trampelschaden, Unzerstörbar\\nImmer wenn eine andere Kreatur, die du kontrollierst, angreift, verursacht sie Trampelschaden und erhält Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zentaur, Krieger\', \'flavor\': \'Die Herzen seiner Anhänger schlagen so wild wie seine Hufe, ihre Rufe bilden das Echo zu seinem Gebrüll.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421344&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18f33e9a-237f-466b-a402-05a2fe485429\', \'multiverseId\': 421344}, \'multiverseid\': 421344}, {\'name\': \'Cacique pezuñadura\', \'text\': \'Arrolla, indestructible.\\nSiempre que otra criatura que controlas ataque, gana las habilidades de arrollar e indestructible hasta el final del turno.\', \'type\': \'Criatura — Guerrero centauro\', \'flavor\': \'Los corazones de sus seguidores latían al ritmo de sus cascos, y sus voces resonaban con sus bramidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423099&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f84dc28c-f085-4d39-93e3-57a5472d1887\', \'multiverseId\': 423099}, \'multiverseid\': 423099}, {\'name\': \'Chef de clan aux sabots de pierre\', \'text\': "Piétinement, indestructible\\nÀ chaque fois qu\'une autre créature que vous contrôlez attaque, elle acquiert le piétinement et l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature : centaure et guerrier\', \'flavor\': \'Le cœur de ses adeptes battait au rythme du martèlement de ses sabots, et leurs voix faisaient écho à ses mugissements.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421695&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6e873f51-741d-4bcd-b74b-2a5e39bf1ee3\', \'multiverseId\': 421695}, \'multiverseid\': 421695}, {\'name\': \'Capitano Zoccolo di Pietra\', \'text\': "Travolgere, indistruttibile\\nOgniqualvolta un\'altra creatura che controlli attacca, ha travolgere e indistruttibile fino alla fine del turno.", \'type\': \'Creatura — Guerriero Centauro\', \'flavor\': "I cuori dei suoi seguaci battevano all\'unisono con i suoi zoccoli e le loro voci riecheggiavano le sue urla.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f0d515f-b0f9-4d77-a356-423f662d9f54\', \'multiverseId\': 422046}, \'multiverseid\': 422046}, {\'name\': \'石蹄獣の酋長\', \'text\': \'トランプル、破壊不能\\nあなたがコントロールする他のクリーチャーが１体攻撃するたび、ターン終了時まで、それはトランプルと破壊不能を得る。\', \'type\': \'クリーチャー — ケンタウルス・戦士\', \'flavor\': \'その蹄音は追随者の鼓動に調和し、その怒声は追随者の声に唱和する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422397&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3fad9ce8-3cbb-437d-9429-e37e9176a93a\', \'multiverseId\': 422397}, \'multiverseid\': 422397}, {\'name\': \'Chefe Casco-de-pedra\', \'text\': \'Atropelar, indestrutível\\nToda vez que outra criatura que você controla ataca, ela ganha atropelar e indestrutível até o final do turno.\', \'type\': \'Criatura — Centauro Guerreiro\', \'flavor\': \'O troar dos corações de seus seguidores acompanhava a batida de seus cascos, e as vozes deles ecoavam seus brados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422748&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f1babc0-8ec9-4319-abe2-674ca0cd3155\', \'multiverseId\': 422748}, \'multiverseid\': 422748}, {\'name\': \'石蹄酋长\', \'text\': \'践踏，不灭\\n每当另一个由你操控的生物攻击时，它获得践踏与不灭异能直到回合结束。\', \'type\': \'生物～半人马／战士\', \'flavor\': \'疾蹄冲锋统合心脉律动，咆哮震天荡出战嚎回响。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420993&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'82928953-fec4-41d6-948f-d98bc930354b\', \'multiverseId\': 420993}, \'multiverseid\': 420993}]', '[{\'name\': \'Stierköpfiger Malmer\', \'text\': \'Wandelwicht (Diese Karte hat alle Kreaturentypen.)\\nImmer wenn ein Gegner einen Zauberspruch wirkt, kannst du eine +1/+1-Marke auf den Stierköpfigen Malmer legen.\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': \'Die Kraft eines Wasserfalls. Der Zorn einer Lawine. Der Verstand einer steifen Brise.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421454&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb6a865f-734d-4368-89ce-29a48aa4f988\', \'multiverseId\': 421454}, \'multiverseid\': 421454}, {\'name\': \'Lacerador taurino\', \'text\': \'Cambiaformas. (Esta carta es de todos los tipos de criatura.)\\nSiempre que un oponente lance un hechizo, puedes poner un contador +1/+1 sobre el Lacerador taurino.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'El poder de una cascada. La furia de una avalancha. El intelecto de un vendaval.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423209&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4dbd4e7-9d2a-4f7e-913f-08b1d00c914f\', \'multiverseId\': 423209}, \'multiverseid\': 423209}, {\'name\': \'Meurtrisseur du taureau\', \'text\': "Changelin (Cette carte a tous les types de créature.)\\nÀ chaque fois qu\'un adversaire lance un sort, vous pouvez mettre un marqueur +1/+1 sur le Meurtrisseur du taureau.", \'type\': \'Créature : changeforme\', \'flavor\': "La puissance d\'une cascade. La fureur d\'une avalanche. L\'intelligence d\'un vent de tempête.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421805&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'08372090-9328-42cc-9501-3ec662b6731b\', \'multiverseId\': 421805}, \'multiverseid\': 421805}, {\'name\': \'Mazzuolatore Taurino\', \'text\': \'Cangiante (Questa carta ha tutti i tipi di creatura.)\\nOgniqualvolta un avversario lancia una magia, puoi mettere un segnalino +1/+1 sul Mazzuolatore Taurino.\', \'type\': \'Creatura — Polimorfo\', \'flavor\': "La potenza di una cascata. La furia di una valanga. L\'astuzia di un uragano.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422156&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e553ef7-e261-4fca-a8b5-0742f29b522b\', \'multiverseId\': 422156}, \'multiverseid\': 422156}, {\'name\': \'雄牛のやっかいもの\', \'text\': \'多相（このカードは常にすべてのクリーチャー・タイプである。）\\n対戦相手が呪文を１つ唱えるたび、あなたは雄牛のやっかいものの上に＋１/＋１カウンターを１個置いてもよい。\', \'type\': \'クリーチャー — 多相の戦士\', \'flavor\': \'滝の力強さ。雪崩の怒り。強風の知性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422507&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2cee3a8-7edb-482b-a715-0c862c7b6363\', \'multiverseId\': 422507}, \'multiverseid\': 422507}, {\'name\': \'Esmagador Taurino\', \'text\': \'Morfoloide (Este card é de todos os tipos de criatura.)\\nToda vez que um oponente joga uma mágica, você pode colocar um marcador +1/+1 em Esmagador Taurino.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'O poder de uma cachoeira. A fúria de uma avalanche. O intelecto de uma borrasca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422858&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3c9d039-81cf-4357-8bb9-97b61ecb2b88\', \'multiverseId\': 422858}, \'multiverseid\': 422858}, {\'name\': \'牛身虐杀兽\', \'text\': \'化形（此牌是所有生物类别。）\\n每当任一对手施放咒语时，你可以在牛身虐杀兽上放置一个+1/+1指示物。\', \'type\': \'生物～变形兽\', \'flavor\': \'强如瀑布，怒如山崩，慧如狂风。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71489fdd-41e8-4a5d-b3cd-f37f087f7911\', \'multiverseId\': 421103}, \'multiverseid\': 421103}]', "[{'name': 'Sturzbachklippen', 'text': 'Die Sturzbachklippen kommen getappt ins Spiel.\\nWenn die Sturzbachklippen ins Spiel kommen, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421649&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2e0289c3-5fb4-48e8-ae58-c9f5c7c18483', 'multiverseId': 421649}, 'multiverseid': 421649}, {'name': 'Acantilados aguasraudas', 'text': 'Los Acantilados aguasraudas entran al campo de batalla girados.\\nCuando los Acantilados aguasraudas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {U} o {R} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423404&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c03b2642-fa85-46a9-a3b5-4ee21f58ddee', 'multiverseId': 423404}, 'multiverseid': 423404}, {'name': 'Falaises des eaux vives', 'text': 'Les Falaises des eaux vives arrivent sur le champ de bataille engagées.\\nQuand les Falaises des eaux vives arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {U} ou {R} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422000&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fd6104ca-f178-45a2-8451-d5099e57b289', 'multiverseId': 422000}, 'multiverseid': 422000}, {'name': 'Rupi di Rapidacque', 'text': 'Le Rupi di Rapidacque entrano nel campo di battaglia TAPpate.\\nQuando le Rupi di Rapidacque entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {U} o {R} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422351&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5d150907-01c6-41f5-95bc-d398cdb47a3c', 'multiverseId': 422351}, 'multiverseid': 422351}, {'name': '急流の崖', 'text': '急流の崖はタップ状態で戦場に出る。\\n急流の崖が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{U}か{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=422702&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5f1ebbe4-0841-45b7-a3ef-8ad99a33339b', 'multiverseId': 422702}, 'multiverseid': 422702}, {'name': 'Cordilheiras das Cascatas', 'text': 'Cordilheiras das Cascatas entra no campo de batalha virado.\\nQuando Cordilheiras das Cascatas entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {U} ou {R} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423053&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '55f484b6-ea83-4356-adab-90dc7d7af92f', 'multiverseId': 423053}, 'multiverseid': 423053}, {'name': '急流山崖', 'text': '急流山崖须横置进战场。\\n当急流山崖进战场时，你获得1点生命。\\n{T}：加{U}或{R}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421298&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ae99ff67-02f0-4d7f-9d39-796367bd84fe', 'multiverseId': 421298}, 'multiverseid': 421298}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=421662&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6d561193-f80b-4a8c-97cd-f8c6bfaad907', 'multiverseId': 421662}, 'multiverseid': 421662}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=423417&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4e1605b8-e7ea-4da7-a76d-