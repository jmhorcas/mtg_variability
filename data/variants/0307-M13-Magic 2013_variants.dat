6f2-bee1-fc0c2e12604b', 'multiverseId': 331511}, 'multiverseid': 331511}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332507&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '71b76e1c-e167-478a-bf8c-30dd723c8b85', 'multiverseId': 332507}, 'multiverseid': 332507}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332756&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1ca25265-c386-4f41-825e-ce78650a455b', 'multiverseId': 332756}, 'multiverseid': 332756}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330515&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'b0383406-050d-4a95-9344-5f510db4ebef', 'multiverseId': 330515}, 'multiverseid': 330515}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331262&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4395c203-6597-401e-a917-fb85c2de1f94', 'multiverseId': 331262}, 'multiverseid': 331262}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331760&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '97f6fee5-b8d6-4b3c-9768-536452d4f549', 'multiverseId': 331760}, 'multiverseid': 331760}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330266&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bd5e2298-3c81-4501-8033-dd55ac422167', 'multiverseId': 330266}, 'multiverseid': 330266}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330764&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '0e0509a6-c8e1-45f4-8b05-ff19c7978ffc', 'multiverseId': 330764}, 'multiverseid': 330764}]", '[{\'name\': \'Edelstein der Entstehung\', \'text\': \'{3}, {T}, opfere den Edelstein der Entstehung: Durchsuche deine Bibliothek nach einer Insel, einem Sumpf und einem Gebirge. Zeige die Karten offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332138&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2816f329-9350-44ae-a075-626e0ef12cd2\', \'multiverseId\': 332138}, \'multiverseid\': 332138}, {\'name\': \'Gema de Creación\', \'text\': \'{3}, {T}, sacrificar la Gema de Creación: Busca en tu biblioteca una carta de isla, una carta de pantano y una carta de montaña. Muestra esas cartas y ponlas en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332387&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'adf1a7aa-f063-4fc6-bb09-f36f0a47b94d\', \'multiverseId\': 332387}, \'multiverseid\': 332387}, {\'name\': \'Gemme de transition\', \'text\': "{3}, {T}, sacrifiez la Gemme de transition : Cherchez dans votre bibliothèque une carte d\'île, une carte de marais et une carte de montagne. Révélez ces cartes et mettez-les dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331640&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c844b6be-665b-490e-9239-ac0ba7a93f44\', \'multiverseId\': 331640}, \'multiverseid\': 331640}, {\'name\': \'Gemma del Divenire\', \'text\': \'{3}, {T}, Sacrifica la Gemma del Divenire: Passa in rassegna il tuo grimorio per una carta Isola, una carta Palude e una carta Montagna. Rivela queste carte e aggiungile alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332636&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ae6a13a2-c89d-4953-bc71-76d35a42e661\', \'multiverseId\': 332636}, \'multiverseid\': 332636}, {\'name\': \'適合の宝石\', \'text\': \'{3}, {T}, 適合の宝石を生け贄に捧げる：あなたのライブラリーから、島カード１枚と沼カード１枚と山カード１枚を探す。それらのカードを公開してあなたの手札に加える。その後あなたのライブラリーを切り直す。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332885&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61b92f59-9ada-4d1e-81a7-70e1fad25935\', \'multiverseId\': 332885}, \'multiverseid\': 332885}, {\'name\': \'생성의 보석\', \'text\': \'{3}, {T}, 생성의 보석을 희생한다: 당신의 서고에서 섬 카드 한 장, 늪 카드 한 장, 산 카드 한 장을 찾는다. 그 카드들을 공개한 후 당신의 손으로 가져간다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330644&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2f7cd681-a9b8-46e2-b32d-3bbefc6e7e3d\', \'multiverseId\': 330644}, \'multiverseid\': 330644}, {\'name\': \'Pedra da Formação\', \'text\': \'{3}, {T}, Sacrifique Pedra da Formação: Procure um card de Ilha, um card de Pântano e um card de Montanha no seu grimório. Revele-os e coloque-os em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331391&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa8eff33-97f4-4529-8f54-1d95abf9dc86\', \'multiverseId\': 331391}, \'multiverseid\': 331391}, {\'name\': \'Самоцвет Возникновения\', \'text\': \'{3}, {T}, пожертвуйте Самоцвет Возникновения: найдите в вашей библиотеке карту Острова, карту Болота и карту Горы. Покажите те карты и положите их в вашу руку. Затем перетасуйте вашу библиотеку.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331889&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'111d7cd3-9f1a-43ac-90e4-18587c78099a\', \'multiverseId\': 331889}, \'multiverseid\': 331889}, {\'name\': \'成型宝石\', \'text\': \'{3}，{T}，牺牲成型宝石：从你的牌库中搜寻一张海岛牌、一张沼泽牌、以及一张山脉牌。展示这些牌并将它们置于你手上。然后将你的牌库洗牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330395&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aaa7255f-e2f1-4576-94b6-a60e3244eb37\', \'multiverseId\': 330395}, \'multiverseid\': 330395}, {\'name\': \'成型寶石\', \'text\': \'{3}，{T}，犧牲成型寶石：從你的牌庫中搜尋一張海島牌、一張沼澤牌、以及一張山脈牌。展示這些牌並將它們置於你手上。然後將你的牌庫洗牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330893&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bf01d563-2873-4b07-89a5-f8485662853e\', \'multiverseId\': 330893}, \'multiverseid\': 330893}]', '[{\'name\': \'Eindringende Feen\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)\\nFliegend\', \'type\': \'Kreatur — Feenwesen, Räuber\', \'flavor\': \'Klein genug, um sich in noch so kleine Risse in der Schlossmauer zu zwängen, und zahlreich genug, um einen Greifen in Stücke zu hacken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332184&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10410363-7f3c-4b4a-927f-1e29dd5b680c\', \'multiverseId\': 332184}, \'multiverseid\': 332184}, {\'name\': \'Hadas invasoras\', \'text\': \'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)\\nVuela.\', \'type\': \'Criatura — Bribón hada\', \'flavor\': \'Lo bastante pequeñas para penetrar en la grieta más estrecha del muro de un castillo y lo bastante numerosas para hacer pedazos a un grifo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332433&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f281608-5ed1-4cbf-900b-86e3e732beb8\', \'multiverseId\': 332433}, \'multiverseid\': 332433}, {\'name\': \'Envahisseurs faeries\', \'text\': \'Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)\\nVol\', \'type\': \'Créature : peuple fée et gredin\', \'flavor\': "Assez petits pour s\'insinuer dans la moindre faille d\'un mur de château, assez nombreux pour tailler un griffon en pièces.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331686&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e962ba42-4522-4aa0-8b5b-35adc52a8807\', \'multiverseId\': 331686}, \'multiverseid\': 331686}, {\'name\': \'Spiritelli Invasori\', \'text\': \'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)\\nVolare\', \'type\': \'Creatura — Farabutto Spiritello\', \'flavor\': \'Abbastanza piccoli da insinuarsi nella crepa più angusta delle mura di un castello e abbastanza numerosi da squarciare un grifone.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332682&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c71f6e57-77a7-41f1-8edf-25034e6130ea\', \'multiverseId\': 332682}, \'multiverseid\': 332682}, {\'name\': \'フェアリーの侵略者\', \'text\': \'瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）\\n飛行\', \'type\': \'クリーチャー — フェアリー・ならず者\', \'flavor\': \'城壁の微小な隙間から忍び込めるほど小さく、グリフィンを八つ裂きにできるほど多い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332931&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f52522e2-60df-4d6e-995a-0af508f997ca\', \'multiverseId\': 332931}, \'multiverseid\': 332931}, {\'name\': \'침략자 페어리\', \'text\': \'섬광 (순간마법을 발동할 수 있는 시기라면 당신은 이 주문을 언제든지 발동할 수 있다.)\\n비행\', \'type\': \'생물 — 페어리 도적\', \'flavor\': \'성벽의 가장 좁은 틈도 통과할 수 있을 만큼 덩치가 작고, 그리핀 한 마리쯤은 거뜬히 해치울 만큼 숫자가 많다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330690&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e14beae0-d9be-4865-abf4-1521a921950f\', \'multiverseId\': 330690}, \'multiverseid\': 330690}, {\'name\': \'Invasores Feéricos\', \'text\': \'Lampejo (Você poderá conjurar esta mágica a qualquer momento em que puder conjurar uma mágica instantânea.)\\nVoar\', \'type\': \'Criatura — Fada Ladino\', \'flavor\': \'Pequenas o suficiente para penetrar na menor das fendas na muralha de um castelo e numerosas o suficiente para despedaçar um grifo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331437&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1896b02d-20a9-46ce-9903-cb4a5fe652c4\', \'multiverseId\': 331437}, \'multiverseid\': 331437}, {\'name\': \'Феи-Захватчики\', \'text\': \'Миг (Вы можете разыграть это заклинание при любой возможности разыгрывать мгновенные заклинания.)\\nПолет\', \'type\': \'Существо — Фея Бродяга\', \'flavor\': \'Достаточно малы, чтобы проникнуть в малейшую трещину в стенах замка, и достаточно многочисленны, чтобы разрубить на куски грифона.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331935&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f265ac6-044b-4024-992d-51c6744e33ee\', \'multiverseId\': 331935}, \'multiverseid\': 331935}, {\'name\': \'入侵仙灵\', \'text\': \'闪现（你可以于你能够施放瞬间的时机下施放此咒语。）\\n飞行\', \'type\': \'生物～浪客／仙灵\', \'flavor\': \'小到足以穿过城壁最窄的细缝，多到足以劈开整只狮鹫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330441&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90f7c336-ff92-4a5d-96d1-19dcc6ec7e23\', \'multiverseId\': 330441}, \'multiverseid\': 330441}, {\'name\': \'入侵仙靈\', \'text\': \'閃現（你可以於你能夠施放瞬間的時機下施放此咒語。）\\n飛行\', \'type\': \'生物～仙靈／浪客\', \'flavor\': \'小到足以穿過城壁最狹窄的細縫，多到足以劈開整隻獅鷲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330939&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b1a57faf-f646-4afe-8e54-68a3916987d8\', \'multiverseId\': 330939}, \'multiverseid\': 330939}]', "[{'name': 'Elfischer Erzdruide', 'text': 'Andere Elf-Kreaturen, die du kontrollierst, erhalten +1/+1.\\n{T}: Erhöhe deinen Manavorrat für jeden Elfen, den du kontrollierst, um {G}.', 'type': 'Kreatur — Elf, Druide', 'flavor': 'Er kennt den Namen jedes Elfen, der in den letzten vier Jahrhunderten geboren wurde. Bedeutender ist, dass alle seinen kennen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332023&type=card', 'language': 'German', 'identifiers': {'scryfallId': '70fc3879-e01a-4a47-bb43-571e093c67b1', 'multiverseId': 332023}, 'multiverseid': 332023}, {'name': 'Archidruida élfico', 'text': 'Las otras criaturas Elfo que controlas obtienen +1/+1.\\n{T}: Agrega {G} a tu reserva de maná por cada Elfo que controlas.', 'type': 'Criatura — Druida elfo', 'flavor': 'Sabe el nombre de todos los elfos nacidos en los últimos cuatro siglos. Más importante aún, todos conocen el suyo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332272&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4c0c992a-d508-4805-aaea-e4313632e155', 'multiverseId': 332272}, 'multiverseid': 332272}, {'name': 'Archidruide elfe', 'text': 'Les autres créatures Elfe que vous contrôlez gagnent +1/+1.\\n{T} : Ajoutez {G} à votre réserve pour chaque elfe que vous contrôlez.', 'type': 'Créature : elfe et druide', 'flavor': 'Il connaît le nom de chaque elfe né durant les quatre derniers siècles. Mais plus important, tous connaissent le sien.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331525&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e69a3d93-d146-4f03-8d92-d4717d60ee2a', 'multiverseId': 331525}, 'multiverseid': 331525}, {'name': 'Arcidruido Elfico', 'text': 'Le altre creature Elfo che controlli prendono +1/+1.\\n{T}: Aggiungi {G} alla tua riserva di mana per ogni Elfo che controlli.', 'type': 'Creatura — Druido Elfo', 'flavor': 'Conosce il nome di tutti gli elfi nati negli ultimi quattro secoli. Ma ancora più importante, loro conoscono il suo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332521&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a0d185c2-8cf0-499e-95cc-d2b4492b624e', 'multiverseId': 332521}, 'multiverseid': 332521}, {'name': 'エルフの大ドルイド', 'text': 'あなたがコントロールする他のエルフ・クリーチャーは＋１/＋１の修整を受ける。\\n{T}：あなたがコントロールするエルフ１体につき、あなたのマナ・プールに{G}を加える。', 'type': 'クリーチャー — エルフ・ドルイド', 'flavor': '彼は、ここ四世紀中に生まれた全てのエルフの名を知っている。そしてさらに重要なのは、その誰もが彼を知っていることだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332770&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '253ae8a8-4e70-4de2-a9b3-5b58dd3112ae', 'multiverseId': 332770}, 'multiverseid': 332770}, {'name': '엘프 대드루이드', 'text': '당신이 조종하는 다른 엘프 생물들은 +1/+1을 받는다.\\n{T}: 당신이 조종하는 엘프 한 개당 {G}를 당신의 마나풀에 담는다.', 'type': '생물 — 엘프 드루이드', 'flavor': '그는 지난 4세기 동안 태어난 모든 엘프의 이름을 알고 있다. 더 중요한 것은 모든 엘프 역시 그의 이름을 알고 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330529&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '78cf33c2-7e1d-48d3-82a6-9cbadd2a4958', 'multiverseId': 330529}, 'multiverseid': 330529}, {'name': 'Arqueodruida Elfo', 'text': 'As outras criaturas do tipo Elfo que você controla recebem +1/+1.\\n{T}: Adicione {G} à sua reserva de mana para cada Elfo que você controla.', 'type': 'Criatura — Elfo Druida', 'flavor': 'Ele sabe o nome de todos os elfos nascidos nos últimos quatro séculos. E o mais importante: todos eles sabem o nome dele.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331276&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5b4d0feb-5e72-48e1-bad3-84dbfe04937d', 'multiverseId': 331276}, 'multiverseid': 331276}, {'name': 'Эльфийский Архидруид', 'text': 'Другие существа-Эльфы под вашим контролем получают +1/+1.\\n{T}: добавьте {G} в ваше хранилище маны за каждого Эльфа под вашим контролем.', 'type': 'Существо — Эльф Друид', 'flavor': 'Он знает имена всех эльфов, родившихся за последние четыре столетия. Что еще более важно, все они знают его имя.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331774&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd0ee0bb0-4f91-4c7d-ba06-de7117c21d42', 'multiverseId': 331774}, 'multiverseid': 331774}, {'name': '妖精高位德鲁伊', 'text': '由你操控的其他妖精生物得+1/+1。{T}：你每操控一个妖精，便加{G}到你的法术力池中。', 'type': '生物～妖精／德鲁伊', 'flavor': '他能说出在过去四个世纪中诞生的每个妖精名字。更重要的是，他们全都认识他。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330280&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2b42f396-2b4d-4850-ac58-0c4e96c91059', 'multiverseId': 330280}, 'multiverseid': 330280}, {'name': '妖精高位德魯伊', 'text': '由你操控的其他妖精生物得+1/+1。\\n{T}：你每操控一個妖精，便加{G}到你的魔法力池中。', 'type': '生物～妖精／德魯伊', 'flavor': '他能說出在過去四個世紀中誕生的每個妖精名字。更重要的是，他們全都認識他。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330778&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f6906b54-31e2-4871-a498-c87d771a0311', 'multiverseId': 330778}, 'multiverseid': 330778}]", '[{\'name\': \'Elfischer Visionär\', \'text\': \'Wenn der Elfische Visionär ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Aus dem kleinsten Setzling sprießen und erblühen die größten Bäume. Mögen die Samen deines Geistes ebenso fruchtbar sein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332160&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f47f2ab5-ccf4-4350-8258-656ecd37ba26\', \'multiverseId\': 332160}, \'multiverseid\': 332160}, {\'name\': \'Visionaria élfica\', \'text\': \'Cuando la Visionaria élfica entre al campo de batalla, roba una carta.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"A partir de un brote diminuto crecen y florecen los árboles más grandes. Que las semillas de tu mente sean igual de fructíferas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef61203f-ca5d-4b5e-b563-b27f136046e0\', \'multiverseId\': 332409}, \'multiverseid\': 332409}, {\'name\': \'Visionnaire elfe\', \'text\': \'Quand la Visionnaire elfe arrive sur le champ de bataille, piochez une carte.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': "« D\'une graine minuscule peut naître un arbre immense et florissant. Puissent les graines de ton esprit être aussi prolifiques. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331662&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2808968-236e-464c-8e6e-a8c27448582c\', \'multiverseId\': 331662}, \'multiverseid\': 331662}, {\'name\': \'Elfa Visionaria\', \'text\': "Quando l\'Elfa Visionaria entra nel campo di battaglia, pesca una carta.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"Da un piccolo germoglio, crescono e fioriscono gli alberi più grandi. Possano i semi della tua mente rivelarsi fertili in egual misura."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332658&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6bbfe93e-874f-4a19-b61d-f36b2419c6cd\', \'multiverseId\': 332658}, \'multiverseid\': 332658}, {\'name\': \'エルフの幻想家\', \'text\': \'エルフの幻想家が戦場に出たとき、カードを１枚引く。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「この上なく立派な木々も、小さな芽から成長し、生い繁ります。あなたの精神が宿す種も等しく実りますように。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332907&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87e87a3e-8c12-4528-806f-d53c90ae6910\', \'multiverseId\': 332907}, \'multiverseid\': 332907}, {\'name\': \'엘프 선지자\', \'text\': \'엘프 선지자가 전장에 들어올 때, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': \'"아주 작은 씨앗에서 거대한 나무가 자라고 울창한 숲을 이룬다. 그대 마음의 작은 씨앗도 그와 같이 크게 자라기를..."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330666&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'390f351a-c6dc-43d0-bba0-3aa11115943d\', \'multiverseId\': 330666}, \'multiverseid\': 330666}, {\'name\': \'Visionário Élfico\', \'text\': \'Quando Visionário Élfico entrar no campo de batalha, compre um card.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"De pequenas sementes nascem e crescem as maiores árvores. Que as sementes da sua mente sejam igualmente férteis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331413&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e5f719f-4bda-4ea9-9948-2f53651eb49b\', \'multiverseId\': 331413}, \'multiverseid\': 331413}, {\'name\': \'Эльфийский Прорицатель\', \'text\': \'Когда Эльфийский Прорицатель выходит на поле битвы, возьмите карту.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«Из крохотного ростка вырастают величайшие деревья. Пусть семена твоего разума будут столь же плодородны».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331911&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e5cc88e3-2d58-48ef-87f3-716f725b3e65\', \'multiverseId\': 331911}, \'multiverseid\': 331911}, {\'name\': \'妖精幻视师\', \'text\': \'当妖精幻视师进战场时，抓一张牌。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'「最大的树木也是从一颗小芽开始生长茂盛。愿你心中的种子也如这般硕果累累。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330417&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'200671b5-4648-4994-8a98-1372c8744b33\', \'multiverseId\': 330417}, \'multiverseid\': 330417}, {\'name\': \'妖精幻視師\', \'text\': \'當妖精幻視師進戰場時，抽一張牌。\', \'type\': \'生物～妖精／祭師\', \'flavor\': \'「最大的樹木也是從一顆小芽開始生長茂盛。願你心中的種子也如這般碩果累累。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330915&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'76509b7b-688c-42b1-9c05-6305d6c72f88\', \'multiverseId\': 330915}, \'multiverseid\': 330915}]', '[{\'name\': \'Elixier der Unsterblichkeit\', \'text\': \'{2}, {T}: Du erhältst 5 Lebenspunkte dazu. Mische das Elixier der Unsterblichkeit und deinen Friedhof in die Bibliothek ihres Besitzers.\', \'type\': \'Artefakt\', \'flavor\': \'„Abgefülltes Leben. Nicht so lecker, wie ich es gerne mag, sondern abgestanden, aber es hat den gleichen Effekt." —Baron Sengir\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332178&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c3b7f5ba-a830-48d2-b65b-9b5026e6da46\', \'multiverseId\': 332178}, \'multiverseid\': 332178}, {\'name\': \'Elixir de inmortalidad\', \'text\': \'{2}, {T}: Ganas 5 vidas. Baraja el Elixir de inmortalidad y tu cementerio en la biblioteca de su propietario.\', \'type\': \'Artefacto\', \'flavor\': \'"Vida embotellada. No tan sabrosa como a la que estoy acostumbrado, más bien rancia, pero tiene el mismo efecto." —Barón Sengir\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd78e046-bc4d-421d-85c5-932b97431ecc\', \'multiverseId\': 332427}, \'multiverseid\': 332427}, {\'name\': "Élixir d\'immortalité", \'text\': "{2}, {T} : Vous gagnez 5 points de vie. Mélangez l\'Élixir d\'immortalité et votre cimetière dans la bibliothèque de leur propriétaire.", \'type\': \'Artefact\', \'flavor\': "« La vie en bouteille. Certes moins goûteux que ce à quoi je suis habitué, un peu rance, mais l\'effet est le même. » —Baron Sengir", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331680&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'64402270-9e45-4db7-b02c-8c25169644f8\', \'multiverseId\': 331680}, \'multiverseid\': 331680}, {\'name\': "Elisir dell\'Immortalità", \'text\': "{2}, {T}: Guadagni 5 punti vita. Rimescola l\'Elisir dell\'Immortalità e il tuo cimitero nei grimori dei rispettivi proprietari.", \'type\': \'Artefatto\', \'flavor\': \'"Vita in bottiglia. Non così saporita come al solito, piuttosto stantia, ma ha lo stesso effetto." —Barone Sengir\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332676&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bcca414b-6827-4bad-a631-04633ec7ac18\', \'multiverseId\': 332676}, \'multiverseid\': 332676}, {\'name\': \'不死の霊薬\', \'text\': \'{2}, {T}：あなたは５点のライフを得る。不死の霊薬とあなたの墓地を、オーナーのライブラリーに加えて切り直す。\', \'type\': \'アーティファクト\', \'flavor\': \'「瓶詰めの生命だ。かつてほど美味ではないし、むしろ味気ないが、効果は変わらぬ。」――センギア男爵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332925&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ee9b3d7a-178c-46d0-a379-c048446ad1ec\', \'multiverseId\': 332925}, \'multiverseid\': 332925}, {\'name\': \'불멸의 영약\', \'text\': \'{2}, {T}: 당신은 생명 5점을 얻는다. 불멸의 영약과 당신의 무덤을 소유자의 서고에 섞어 넣는다.\', \'type\': \'마법물체\', \'flavor\': \'"병에 든 생명이라. 내가 즐겨 먹던 것보단 맛도 떨어지고 신선하지도 않지만, 효력은 똑같군." —셍기르 남작\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330684&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'26194d92-fd6c-4031-a630-f95a1f176b96\', \'multiverseId\': 330684}, \'multiverseid\': 330684}, {\'name\': \'Elixir da Imortalidade\', \'text\': \'{2}, {T}: Você ganha 5 pontos de vida. Embaralhe Elixir da Imortalidade e seu cemitério no grimório de seus donos.\', \'type\': \'Artefato\', \'flavor\': \'"Vida engarrafada. Não é tão saborosa quanto a que estou acostumado, é um pouco rançosa, mas tem o mesmo efeito." — Barão Sengir\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331431&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f2e4f4b-1061-451b-8e5d-65f03d2edb4b\', \'multiverseId\': 331431}, \'multiverseid\': 331431}, {\'name\': \'Эликсир Бессмертия\', \'text\': \'{2}, {T}: вы получаете 5 жизней. Втасуйте Эликсир Бессмертия и ваше кладбище в библиотеку их владельца.\', \'type\': \'Артефакт\', \'flavor\': \'«Хм, жизнь из бутылки. Не так вкусно, как обычно, немного затхлый привкус, но эффект тот же самый». — Барон Сенгир\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331929&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c7a7da3-c8d3-41ff-aed8-9f9d32029e6f\', \'multiverseId\': 331929}, \'multiverseid\': 331929}, {\'name\': \'永生琼浆\', \'text\': \'{2}，{T}：你获得5点生命。将永生琼浆与你的坟墓场洗入其拥有者的牌库。\', \'type\': \'神器\', \'flavor\': \'「瓶装的生命。风味不太如我意，也不新鲜，但起码功效相同。」～辛格男爵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330435&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'85fd518c-c31d-4cd1-80b8-a190382f7648\', \'multiverseId\': 330435}, \'multiverseid\': 330435}, {\'name\': \'永生瓊漿\', \'text\': \'{2}，{T}：你獲得5點生命。將永生瓊漿與你的墳墓場洗入其擁有者的牌庫。\', \'type\': \'神器\', \'flavor\': \'「瓶裝的生命。風味不太如我意，也不新鮮，但起碼功效相同。」 ～辛格男爵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330933&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4232b35b-2120-4a68-966e-404a5cf1879a\', \'multiverseId\': 330933}, \'multiverseid\': 330933}]', '[{\'name\': \'Ende des Verstands\', \'text\': \'Ein Spieler deiner Wahl wirft alle Karten aus seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Deine armseligen Ideen liegen in Trümmern, Planeswalker. Wo ist nun dein arroganter Stolz?" —Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332159&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f700569-acc9-4e3d-9f59-474f69245306\', \'multiverseId\': 332159}, \'multiverseid\': 332159}, {\'name\': \'Fin del saber\', \'text\': \'El jugador objetivo descarta su mano.\', \'type\': \'Conjuro\', \'flavor\': \'"Tus patéticas ideas yacen desmoronadas, Planeswalker. ¿Dónde está ahora tu arrogante orgullo?" —Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332408&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'967e50da-50f4-4449-8a9d-cb2d71d7c107\', \'multiverseId\': 332408}, \'multiverseid\': 332408}, {\'name\': \'Ne plus savoir que faire\', \'text\': \'Le joueur ciblé se défausse de sa main.\', \'type\': \'Rituel\', \'flavor\': "« Tes idées pathétiques ne sont plus que ruines, Planeswalker. Qu\'est-il advenu de ta fierté arrogante ? » —Nicol Bolas", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331661&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29409bf4-89ba-4d87-925e-47aed5bc10b2\', \'multiverseId\': 331661}, \'multiverseid\': 331661}, {\'name\': \'Fine delle Furbate\', \'text\': \'Un giocatore bersaglio scarta la sua mano.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le tue patetiche idee sono in frantumi, Planeswalker. Che fine hanno fatto il tuo orgoglio e la tua arroganza?" —Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332657&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b298b06f-c6bb-4189-b73b-a22c013dc38e\', \'multiverseId\': 332657}, \'multiverseid\': 332657}, {\'name\': \'機知の終わり\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは自分の手札を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「下らない作戦もそれまでだな、プレインズウォーカーよ。身の程知らずのうぬぼれはどこへいった？」――ニコル・ボーラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332906&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'239cde78-af0e-406d-81e3-faee75afc4cd\', \'multiverseId\': 332906}, \'multiverseid\': 332906}, {\'name\': \'생각의 끝\', \'text\': \'플레이어 한 명을 목표로 정한다. 그 플레이어는 자신의 손에 있는 모든 카드를 버린다.\', \'type\': \'집중마법\', \'flavor\': \'"플레인즈워커여, 네 한심한 생각들은 전부 쓰레기 더미에 처박혔다. 그 오만방자하던 태도는 어디로 간 것인가?" —니콜 볼라스\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330665&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5f10a1a6-76b5-4ea9-95f1-93c6878a4229\', \'multiverseId\': 330665}, \'multiverseid\': 330665}, {\'name\': \'Limite da Razão\', \'text\': \'O jogador alvo descarta sua própria mão.\', \'type\': \'Feitiço\', \'flavor\': \'"Suas ideias patéticas estão em ruínas, Planeswalker. Onde está o seu orgulho arrogante agora?" — Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331412&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'22e45019-4163-4f6d-b0f6-c81dc787ecd2\', \'multiverseId\': 331412}, \'multiverseid\': 331412}, {\'name\': \'Предел Разума\', \'text\': \'Целевой игрок сбрасывает свою руку.\', \'type\': \'Волшебство\', \'flavor\': \'«Все твои жалкие замыслы спутаны, Planeswalker. Где теперь твоя заносчивая гордость?» — Никол Болас\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331910&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb77961d-9805-450c-a056-d9c1306dcc1f\', \'multiverseId\': 331910}, \'multiverseid\': 331910}, {\'name\': \'无计可施\', \'text\': \'目标牌手弃掉其手牌。\', \'type\': \'法术\', \'flavor\': \'「鹏洛客，你那些可悲的想法已一败涂地。 你的骄傲自大到哪去了？」～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330416&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61662943-8064-444a-a4bd-f4bc42adba4d\', \'multiverseId\': 330416}, \'multiverseid\': 330416}, {\'name\': \'無計可施\', \'text\': \'目標玩家棄掉其手牌。\', \'type\': \'巫術\', \'flavor\': \'「鵬洛客，你那些可悲的想法已一敗塗地。你的驕傲自大到哪去了？」～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330914&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5ef5b030-e87a-4615-83c4-91b482ab3cd0\', \'multiverseId\': 330914}, \'multiverseid\': 330914}]', '[{\'name\': \'Entzündete Wut\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+0 und Erstschlag bis zum Ende des Zuges. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Zorn ist eine gefährliche Waffe. Deine Feinde werden versuchen, deine Wut gegen dich zu verwenden. Lasse sie lieber an ihnen aus." —Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332190&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11a44c7e-665a-4a03-90f8-0bf3ab0f6b0a\', \'multiverseId\': 332190}, \'multiverseid\': 332190}, {\'name\': \'Furia encendida\', \'text\': \'La criatura objetivo obtiene +1/+0 y gana la habilidad de dañar primero hasta el final del turno. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Instantáneo\', \'flavor\': \'"La ira es un arma peligrosa. Tus enemigos intentarán usar tu furia contra ti. Úsala contra ellos antes." —Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332439&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'670d5081-04f3-4d50-bfa9-c218ce82784e\', \'multiverseId\': 332439}, \'multiverseid\': 332439}, {\'name\': \'Fureur embrasée\', \'text\': "La créature ciblée gagne +1/+0 et acquiert l\'initiative jusqu\'à la fin du tour. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Éphémère\', \'flavor\': \'« La rage est une arme dangereuse. Tes ennemis essaieront de retourner ta propre colère contre toi. Devance-les. » —Ajani Crinièredor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331692&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b250e7d-39ff-4884-aad3-bfb8e5c0ff16\', \'multiverseId\': 331692}, \'multiverseid\': 331692}, {\'name\': \'Furia Infuocata\', \'text\': \'Una creatura bersaglio prende +1/+0 e ha attacco improvviso fino alla fine del turno. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Istantaneo\', \'flavor\': \'"La rabbia è un\\\'arma pericolosa. I tuoi nemici tenteranno di usare la tua ira contro di te. Usala per primo contro di loro." —Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332688&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8166a73a-9003-4d1c-87cd-b4331a9a68e2\', \'multiverseId\': 332688}, \'multiverseid\': 332688}, {\'name\': \'火をつける怒り\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋１/＋０の修整を受けるとともに先制攻撃を得る。（それは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'インスタント\', \'flavor\': \'「怒りは危険な武器だ。敵はお前の怒りがお前に向かうようにしてくるだろう。まず奴らに対して使うことだ。」 ――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332937&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61bd60ed-6164-416a-a087-bcc79a32c125\', \'multiverseId\': 332937}, \'multiverseid\': 332937}, {\'name\': \'점화된 분노\', \'text\': \'생물 한 개를 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받고 선제공격 능력을 얻는다. (이 생물은 선제공격 능력이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'순간마법\', \'flavor\': \'"분노는 아주 위험한 무기라네. 적들은 자네의 분노를 이용해서 자네를 무너뜨리려 할 것이네. 그러기 전에 그들에게 자네의 분노를 선사해야 하네." —아자니 골드메인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330696&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1b343891-73fe-44f8-89c6-773813ea8c63\', \'multiverseId\': 330696}, \'multiverseid\': 330696}, {\'name\': \'Fúria Inflamada\', \'text\': \'A criatura alvo recebe +1/+0 e ganha iniciativa até o final do turno. (Ela causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A ira é uma arma perigosa. Seus inimigos tentarão usar a sua própria raiva contra você. Use-a contra eles primeiro." — Ajani Juba D\\\'ouro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331443&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'102c292a-c62e-4254-b00e-f913efb9dd7b\', \'multiverseId\': 331443}, \'multiverseid\': 331443}, {\'name\': \'Вспыхнувшая Ярость\', \'text\': \'Целевое существо получает +1/+0 и Первый удар до конца хода. (Оно наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ярость — опасное оружие. Враги попытаются использовать твой гнев против тебя, так что направь его против них первым». — Златогривый Аджани\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331941&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ed5ccec-410f-4b76-afc7-cf1ecc139e7d\', \'multiverseId\': 331941}, \'multiverseid\': 331941}, {\'name\': \'点燃怒火\', \'text\': \'目标生物得+1/+0且获得先攻异能直到回合结束。（它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'瞬间\', \'flavor\': \'「怒火是个危险武器。敌人会利用你的愤怒来对抗你。该先拿来对付他们。」～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330447&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6aa48d51-7621-438a-b72e-929e7cea23e8\', \'multiverseId\': 330447}, \'multiverseid\': 330447}, {\'name\': \'點燃怒火\', \'text\': \'目標生物得+1/+0且獲得先攻異能直到回合結束。（它會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'瞬間\', \'flavor\': \'「怒火是個危險武器。敵人會利用你的憤怒來對付你。該先拿來對付他們。」 ～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330945&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'24bee378-a75e-4909-a554-e62100e585c5\', \'multiverseId\': 330945}, \'multiverseid\': 330945}]', '[{\'name\': \'Erbarmen des Engels\', \'text\': \'Du erhältst 7 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Sie schwebte über mich, und in diesem Moment starb Varrik der Blutige und ich wurde geboren." —Varrik der Gerechte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332086&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'63b929d4-278b-4447-9658-bcdbe4583d92\', \'multiverseId\': 332086}, \'multiverseid\': 332086}, {\'name\': \'Piedad del ángel\', \'text\': \'Ganas 7 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Ella se alzó ante mí, y en aquel momento Varrik el Sangriento murió y yo nací." —Varrik el Justo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5c3474d-0eac-4719-af42-17084fbb02ea\', \'multiverseId\': 332335}, \'multiverseid\': 332335}, {\'name\': \'Miséricorde des anges\', \'text\': \'Vous gagnez 7 points de vie.\', \'type\': \'Éphémère\', \'flavor\': "« Elle a pris son essor. Varrik le Sanguinaire m\'a alors donné le jour en cessant de vivre. » —Varrik le Juste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331588&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'adf1ab13-a2fa-4b50-aeef-9a5b45ea78ce\', \'multiverseId\': 331588}, \'multiverseid\': 331588}, {\'name\': "Clemenza dell\'Angelo", \'text\': \'Guadagni 7 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"Si elevò sopra di me e in quel momento Varrik il Sanguinario morì e nacqui io." —Varrik il Giusto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332584&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1902835-e421-4d57-a1a7-6c149f569658\', \'multiverseId\': 332584}, \'multiverseid\': 332584}, {\'name\': \'天使の慈悲\', \'text\': \'あなたは７点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'「彼女が俺に微笑みかけた瞬間、血まみれヴァリクは死んで、俺は生まれ変わったのさ。」――義しき者ヴァリク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332833&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'223e10a7-5cbf-4654-b4f1-cd3598c566e7\', \'multiverseId\': 332833}, \'multiverseid\': 332833}, {\'name\': \'천사의 자비\', \'text\': \'당신은 생명 7점을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'"그녀가 내 위로 날아올랐을 때, 피투성이 바릭은 죽고 내가 태어났다." —정의로운 바릭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330592&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7c94df9c-4377-4ab1-9a31-2e246f16d14b\', \'multiverseId\': 330592}, \'multiverseid\': 330592}, {\'name\': \'Misericórdia de Anjo\', \'text\': \'Você ganha 7 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Ela se ergueu sobre mim, e naquele momento, Varrik, o Sanguinário, morreu e eu nasci." — Varrik, o Justo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331339&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f97ffba5-460c-480b-9bde-da222610d9fd\', \'multiverseId\': 331339}, \'multiverseid\': 331339}, {\'name\': \'Милосердие Ангела\', \'text\': \'Вы получаете 7 жизней.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Она поднялась надо мной, и в этот миг Варрик Кровавый умер, и родился я». — Варрик Праведный\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331837&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'71ef1be1-8aee-4b6d-97de-0f754d5065a3\', \'multiverseId\': 331837}, \'multiverseid\': 331837}, {\'name\': \'天使的慈悲\', \'text\': \'你获得7点生命。\', \'type\': \'瞬间\', \'flavor\': \'「就在她降临的刹那，嗜血瓦黎死去，而我就此诞生。」～正义瓦黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330343&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1be84ec0-81ce-4773-9656-62b1353f4bdc\', \'multiverseId\': 330343}, \'multiverseid\': 330343}, {\'name\': \'天使的慈悲\', \'text\': \'你獲得7點生命。\', \'type\': \'瞬間\', \'flavor\': \'「就在她降臨的刹那，嗜血瓦黎死去，而我就此誕生。」～正義瓦黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330841&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d1491185-2526-48f7-95ba-38cc086f1522\', \'multiverseId\': 330841}, \'multiverseid\': 330841}]', '[{\'name\': \'Essenzentzug\', \'text\': \'Der Essenzentzug fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu, und du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Essenz des Lebens ist ein Nektar so ungleich aller, die ich in meinem Leben als Sterblicher gekostet habe." —Zul Ashur, Lichfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332149&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c3c101d2-9f37-4a34-81df-0f95605ca279\', \'multiverseId\': 332149}, \'multiverseid\': 332149}, {\'name\': \'Drenaje de esencia\', \'text\': \'El Drenaje de esencia hace 3 puntos de daño a la criatura o jugador objetivo y tú ganas 3 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"La esencia de la vida es un néctar como no probé otro cuando viví como mortal." —Zul Ashur, señor liche\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'edd9411a-a327-4f72-b479-443f4a8f56e5\', \'multiverseId\': 332398}, \'multiverseid\': 332398}, {\'name\': "Drain d\'essence", \'text\': "Le Drain d\'essence inflige 3 blessures à une cible, créature ou joueur, et vous gagnez 3 points de vie.", \'type\': \'Rituel\', \'flavor\': "« L\'essence vitale est un nectar bien supérieur à tout ce que j\'ai pu goûter de mon vivant. » —Zul Ashur, seigneur liche", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8d08ff4-83cc-4e4f-86cd-4c89a6b08d1d\', \'multiverseId\': 331651}, \'multiverseid\': 331651}, {\'name\': \'Risucchia Essenza\', \'text\': \'Risucchia Essenza infligge 3 danni a una creatura o a un giocatore bersaglio e tu guadagni 3 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"L\\\'essenza della vita è un nettare diverso da quelli assaggiati durante la mia vita mortale." —Zul Ashur, signore dei lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332647&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d68e8b24-0a5c-4dec-b50a-3d200f492805\', \'multiverseId\': 332647}, \'multiverseid\': 332647}, {\'name\': \'本質の吸収\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。本質の吸収はそれに３点のダメージを与え、あなたは３点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'「生命の本質は、死すべき者として生きていた時に味わったどんなものも超越した聖蜜だ。」 ――死者の王、ザル・アシュール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332896&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1d554a66-3599-40f2-80c4-e7f3995df877\', \'multiverseId\': 332896}, \'multiverseid\': 332896}, {\'name\': \'정수 고갈\', \'text\': \'생물 한 개나 플레이어 한 명을 목표로 정한다. 정수 고갈은 그 목표에게 피해 3점을 입히고 당신은 생명 3점을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'"생명의 정수는 내가 살아있을 당시 한 번도 맛보지 못했던 천상의 음료다." —리치 군주 줄 아슈르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330655&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'aa9edd80-9110-4a19-9f12-7a06cf79b812\', \'multiverseId\': 330655}, \'multiverseid\': 330655}, {\'name\': \'Drenar Essência\', \'text\': \'Drenar Essência causa 3 pontos de dano à criatura ou ao jogador alvo e você ganha 3 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"A essência da vida é um néctar incomparável a qualquer coisa que eu tenha provado enquanto era mortal." — Zul Ashur, senhor lich\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331402&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ef7ae8d-3e7a-42e5-888f-89bdd40bd9b8\', \'multiverseId\': 331402}, \'multiverseid\': 331402}, {\'name\': \'Утечка Эссенции\', \'text\': \'Утечка Эссенции наносит 3 повреждения целевому существу или игроку, а вы получаете 3 жизни.\', \'type\': \'Волшебство\', \'flavor\': \'«Эссенция жизни — это божественный нектар; смертным не дано узнать и подобия его вкуса». — Зул Ашур, лорд-лич\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331900&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7f414558-17f5-4cc9-87c3-fd3dc84d1c0f\', \'multiverseId\': 331900}, \'multiverseid\': 331900}, {\'name\': \'吸取精华\', \'text\': \'吸取精华对目标生物或牌手造成3点伤害，且你获得3点生命。\', \'type\': \'法术\', \'flavor\': \'「生命精华是我凡人时期从未品味过的甘露。」～巫妖领主祝亚许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330406&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'47238b6d-edaa-4364-8a25-5a95044f9d8f\', \'multiverseId\': 330406}, \'multiverseid\': 330406}, {\'name\': \'吸取精華\', \'text\': \'吸取精華對目標生物或玩家造成3點傷害，且你獲得3點生命。\', \'type\': \'巫術\', \'flavor\': \'「生命精華是我凡人時期從未品味過的甘露。」～巫妖領主祝亞許\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330904&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a6688568-3c35-4a82-8754-728e5ddcdcac\', \'multiverseId\': 330904}, \'multiverseid\': 330904}]', '[{\'name\': \'Essenzzerstäubung\', \'text\': \'Neutralisiere einen Kreaturenzauber deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Was auch immer du aus dem Äther ziehen magst, ich lasse es vom Winde verwehen." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332143&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91201194-f654-429b-9bd4-2e7f125c5659\', \'multiverseId\': 332143}, \'multiverseid\': 332143}, {\'name\': \'Esparcir la esencia\', \'text\': \'Contrarresta el hechizo objetivo de criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'"Lo que tú tratas de extraer del éter, yo lo puedo dispersar en el viento." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332392&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9398b75c-eaa3-4e63-872c-0be4bba4e7b9\', \'multiverseId\': 332392}, \'multiverseid\': 332392}, {\'name\': "Dispersion d\'essence", \'text\': \'Contrecarrez le sort de créature ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« Ce que tu essaies d\'extraire de l\'Aether, je peux le disperser aux quatre vents. » —Jace Beleren", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d13bec37-2328-41c8-835d-3c4e78545d5a\', \'multiverseId\': 331645}, \'multiverseid\': 331645}, {\'name\': \'Disperdere Essenza\', \'text\': \'Neutralizza una magia creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Quello che cerchi di ricavare dall\\\'Etere, io posso spargerlo al vento." —Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332641&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea9d32e0-aadb-4f4a-addf-81f597b6414c\', \'multiverseId\': 332641}, \'multiverseid\': 332641}, {\'name\': \'本質の散乱\', \'text\': \'クリーチャー呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「お前が霊気から得ようとしているそれな、私なら風に乗せて飛ばせるんだが。」 ――ジェイス・ベレレン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332890&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a452a52-240b-4dc5-94ea-0cac824d47fe\', \'multiverseId\': 332890}, \'multiverseid\': 332890}, {\'name\': \'정수 흩날리기\', \'text\': \'생물 주문 한 개를 목표로 정한다. 그 주문을 무효화한다.\', \'type\': \'순간마법\', \'flavor\': \'"네가 에테르로부터 무엇을 끌어오려고 하던, 난 그것을 바람에 흩날리게 만들 수 있다." —제이스 벨레렌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330649&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'925294b5-8a23-41aa-8c49-2cb12f85c754\', \'multiverseId\': 330649}, \'multiverseid\': 330649}, {\'name\': \'Espalhar Essência\', \'text\': \'Anule a mágica de criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Aquilo que você tenta tirar do Éter, eu consigo espalhar no vento." — Jace Beleren\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331396&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'da466325-5549-4f75-8c90-884a1cffe082\', \'multiverseId\': 331396}, \'multiverseid\': 331396}, {\'name\': \'Разлет Эссенции\', \'text\': \'Отмените целевое заклинание существа.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Все, что ты попытаешься призвать из Эфира, я развею по ветру». — Джейс Белерен\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331894&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'678f88a7-1e50-4068-96ac-69a2ba6b1b05\', \'multiverseId\': 331894}, \'multiverseid\': 331894}, {\'name\': \'菁华离散\', \'text\': \'反击目标生物咒语。\', \'type\': \'瞬间\', \'flavor\': \'「我可将你力图从乙太那里收集的东西散至风中。」～杰斯贝连\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330400&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d93f9e75-d687-49eb-a391-69084e59f049\', \'multiverseId\': 330400}, \'multiverseid\': 330400}, {\'name\': \'菁華離散\', \'text\': \'反擊目標生物咒語。\', \'type\': \'瞬間\', \'flavor\': \'「我可將你力圖從乙太那裏收集的東西散至風中。」 ～傑斯貝連\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330898&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'01ee5f42-18fe-476f-8545-a67b63d5e88a\', \'multiverseId\': 330898}, \'multiverseid\': 330898}]', '[{\'name\': \'Fackelunhold\', \'text\': \'{R}, opfere den Fackelunhold: Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Kreatur — Teufel\', \'flavor\': \'Teufel dekorieren jeden Raum mit Feuer neu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332185&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'62aad9d2-8d97-4417-b45c-c668874e0d43\', \'multiverseId\': 332185}, \'multiverseid\': 332185}, {\'name\': \'Demonio de la antorcha\', \'text\': \'{R}, sacrificar el Demonio de la antorcha: Destruye el artefacto objetivo.\', \'type\': \'Criatura — Diablo\', \'flavor\': \'Los diablos redecoran cada habitación con fuego.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332434&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0671d396-aaa0-49a5-97a6-12e019a37327\', \'multiverseId\': 332434}, \'multiverseid\': 332434}, {\'name\': \'Fielleux à la torche\', \'text\': "{R}, sacrifiez le Fielleux à la torche : Détruisez l\'artefact ciblé.", \'type\': \'Créature : diable\', \'flavor\': \'Les diables redécorent chaque pièce par le feu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5c4cc12-5088-40a4-b4e2-6f63c0199054\', \'multiverseId\': 331687}, \'multiverseid\': 331687}, {\'name\': \'Immondo Torcia\', \'text\': "{R}, Sacrifica l\'Immondo Torcia: Distruggi un artefatto bersaglio.", \'type\': \'Creatura — Diavolo\', \'flavor\': \'I diavoli ridipingono ogni stanza col fuoco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332683&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5e9f2283-3c19-4e7f-b22c-c1ed9f1a25b8\', \'multiverseId\': 332683}, \'multiverseid\': 332683}, {\'name\': \'松明の悪鬼\', \'text\': \'{R}, 松明の悪鬼を生け贄に捧げる：アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — デビル\', \'flavor\': \'小悪魔はあらゆる部屋を火で飾りなおす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332932&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'09c6b5a8-f6a5-40b2-9db3-2ad0b394acb4\', \'multiverseId\': 332932}, \'multiverseid\': 332932}, {\'name\': \'횃불 마귀\', \'text\': \'{R}, 횃불 마귀를 희생한다: 마법물체 한 개를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'생물 — 악령\', \'flavor\': \'악령들은 모든 방을 불길로 장식한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330691&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf52979a-4077-4358-8d2c-8afc609a7b6b\', \'multiverseId\': 330691}, \'multiverseid\': 330691}, {\'name\': \'Diabo da Tocha\', \'text\': \'{R}, Sacrifique Diabo da Tocha: Destrua o artefato alvo.\', \'type\': \'Criatura — Diabo\', \'flavor\': \'Os diabos redecoram todos os aposentos com fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331438&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'904dd65a-9e40-46f7-9d0b-e8d7ae36e0fc\', \'multiverseId\': 331438}, \'multiverseid\': 331438}, {\'name\': \'Факельный Демон\', \'text\': \'{R}, пожертвуйте Факельного Демона: уничтожьте целевой артефакт.\', \'type\': \'Существо — Дьявол\', \'flavor\': \'Дьяволы по-новому отделывают каждую комнату — огнем.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331936&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a71a378-fcff-4932-b088-ad18fb7fb3c1\', \'multiverseId\': 331936}, \'multiverseid\': 331936}, {\'name\': \'火炬邪鬼\', \'text\': \'{R}，牺牲火炬邪鬼：消灭目标神器。\', \'type\': \'生物～恶魔\', \'flavor\': \'魔鬼用火焰重新装饰每个房间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330442&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bded5b11-0c72-4a7b-b981-eafa93038c64\', \'multiverseId\': 330442}, \'multiverseid\': 330442}, {\'name\': \'火炬邪鬼\', \'text\': \'{R}，犧牲火炬邪鬼：消滅目標神器。\', \'type\': \'生物～魔鬼\', \'flavor\': \'魔鬼用火焰重新裝飾每個房間。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330940&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b4eb12e1-4899-4a47-b196-a72a8e2bd74c\', \'multiverseId\': 330940}, \'multiverseid\': 330940}]', '[{\'name\': \'Fernsuche\', \'text\': \'Durchsuche deine Bibliothek nach einer Ebene, einer Insel, einem Sumpf oder einem Gebirge und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Diese Stadt muss wirklich riesig sein, denn ich bin weit gereist und habe doch noch keinen Ort gefunden, wo die Gebäude aufhören."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332154&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2a31198b-3482-419c-ba4d-4e876012e58e\', \'multiverseId\': 332154}, \'multiverseid\': 332154}, {\'name\': \'Visión lejana\', \'text\': \'Busca en tu biblioteca una carta de llanura, isla, pantano o montaña y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"Es realmente tan vasta esta ciudad, que con todo lo que he viajado y visto, todavía no he encontrado un lugar donde no haya edificios."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43b0d0cb-8b44-4f89-ac6c-917dc6b5f9a4\', \'multiverseId\': 332403}, \'multiverseid\': 332403}, {\'name\': \'Cherchauloin\', \'text\': "Cherchez dans votre bibliothèque une carte de plaine, d\'île, de marais ou de montagne et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': "« Que cette cité est vaste... J\'ai tant voyagé, j\'ai vu tant de choses, et pourtant, jamais je n\'ai trouvé un lieu où les constructions s\'arrêtent. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331656&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a320fa96-e61c-4cd9-a5ec-a139ab9b0f1a\', \'multiverseId\': 331656}, \'multiverseid\': 331656}, {\'name\': \'Lungosguardo\', \'text\': \'Passa in rassegna il tuo grimorio per una carta Pianura, Isola, Palude o Montagna e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Deve essere davvero vasta questa città, dato che l\\\'ho attraversata in lungo e in largo e non ho mai visto un punto in cui non ci fossero edifici."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332652&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'447bb7cf-a7b4-4e0f-a6a2-8de6c62b913d\', \'multiverseId\': 332652}, \'multiverseid\': 332652}, {\'name\': \'遥か見\', \'text\': \'あなたのライブラリーから、平地カード１枚か島カード１枚か沼カード１枚か山カード１枚を探し、それをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'この都市は本当になんて巨大なんだろう。あちこちを旅して様々な物を見てきたけれど、建物が崩れている場所は見たことがないよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332901&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d010be22-c0b1-4975-853f-3d0985592fe0\', \'multiverseId\': 332901}, \'multiverseid\': 332901}, {\'name\': \'원거리 탐사\', \'text\': \'당신의 서고에서 들, 섬, 늪 또는 산 카드 한 장을 찾아 탭된 채로 전장에 놓는다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'"이 도시를 오랫동안 돌아다녔음에도 불구하고 건물이 끝나는 곳을 본 적이 없음을 생각하면, 이 도시의 규모가 얼마나 큰지 짐작도 되지 않는다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330660&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f7a6799c-f381-49dc-bd03-298fd3600568\', \'multiverseId\': 330660}, \'multiverseid\': 330660}, {\'name\': \'Busca Longínqua\', \'text\': \'Procure um card de Planície, Ilha, Pântano ou Montanha no seu grimório e coloque-o no campo de batalha virado. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"O quão vasta pode realmente ser esta cidade? Eu já viajei para tão longe e vi tantas coisas e nunca cheguei ao lugar onde os prédios acabam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331407&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9aef6f78-e3a1-43d3-a31d-2956f1deb2c0\', \'multiverseId\': 331407}, \'multiverseid\': 331407}, {\'name\': \'Дальнее Странствие\', \'text\': \'Найдите в вашей библиотеке карту Равнины, Острова, Болота или Горы и положите ее на поле битвы повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'«Этот город должен быть воистину велик. Я много странствовал и видел немало, но ни разу еще я не встречал места в нем, где бы не было зданий».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331905&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4af9cf08-63f9-4872-9752-b786697099ed\', \'multiverseId\': 331905}, \'multiverseid\': 331905}, {\'name\': \'远眺\', \'text\': \'从你的牌库中搜寻一张平原、海岛、沼泽、或山脉牌并将它横置进战场。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'「这城市究竟广大到什么地步呢？我已旅行了那么远，看了那么多，却还没找到毫无建物的地方。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330411&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e82b240-3d8c-41cc-af4b-f82470891717\', \'multiverseId\': 330411}, \'multiverseid\': 330411}, {\'name\': \'遠眺\', \'text\': \'從你的牌庫中搜尋一張平原、海島、沼澤、或山脈牌並將它橫置進戰場。然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'「這城市究竟廣大到什麼地步呢？我已旅行了那麼遠，看了那麼多，卻還沒找到毫無建物的地方。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330909&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'284a7515-3e71-4d9b-ad39-31f0ce3fdb0c\', \'multiverseId\': 330909}, \'multiverseid\': 330909}]', '[{\'name\': \'Feuerelementar\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Zügelloses Feuer ist eine schreckliche Macht — vernichtend, erbarmungslos und immer hungrig. Wenn man es jedoch anleitet, ist es noch schlimmer." —Jeflin, Riesenholz-Schamane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332063&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5fce34a-4071-4659-88c3-9957efdbbb8b\', \'multiverseId\': 332063}, \'multiverseid\': 332063}, {\'name\': \'Elemental de fuego\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"El fuego desatado es una fuerza temible; destructivo, despiadado y siempre hambriento. Y guiado es aún peor." —Jeflin, chamán del Bosque Extenso\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332312&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8cdeef13-4b47-40a8-92c7-272ba73975a0\', \'multiverseId\': 332312}, \'multiverseid\': 332312}, {\'name\': \'Élémental de feu\', \'type\': \'Créature : élémental\', \'flavor\': "« Le feu est un phénomène redoutable : destructeur, implacable, toujours affamé. Contrôlé, c\'est encore pire. » —Jeflin, shamane de Vastebois", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331565&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f1d6d4d-3bf3-425e-8528-91aa216ed437\', \'multiverseId\': 331565}, \'multiverseid\': 331565}, {\'name\': \'Elementale del Fuoco\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Quando viene sprigionato, il fuoco è una forza terrificante—distruttivo, inesorabile, sempre affamato. Se gli viene data una direzione, è molto peggio." —Jeflin, sciamano di Boscovasto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332561&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17362729-898f-4a4e-ba1f-1f1459ee4c69\', \'multiverseId\': 332561}, \'multiverseid\': 332561}, {\'name\': \'炎の精霊\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「野放しにされた炎は恐ろしい力となる――それは破壊的で無慈悲で、常に飢えているのだ。しかし命令を聞く炎のほうがずっと厄介だ。」 ――巨森のシャーマン、ジェフリン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332810&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f1f5cc2-00f2-446d-88e4-f046e7fcf9f4\', \'multiverseId\': 332810}, \'multiverseid\': 332810}, {\'name\': \'불의 정령\', \'type\': \'생물 — 정령\', \'flavor\': \'"타오르는 불길은 강력한 무기다. 파괴력이 엄청나고 무자비하며 항상 굶주려 있지. 방향을 정해주면 그 위력은 더욱 어마어마해진다." —광활림의 주술사 제플린\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330569&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05434557-26c9-449a-80f3-a899241ceb69\', \'multiverseId\': 330569}, \'multiverseid\': 330569}, {\'name\': \'Elemental do Fogo\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"O fogo libertado é uma força temível — destrutiva, inclemente, sempre faminta. Se for direcionado, é ainda pior." — Jeflin, xamã de Matavasta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331316&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee1358cc-a65e-40a2-84fe-01f2ab40d461\', \'multiverseId\': 331316}, \'multiverseid\': 331316}, {\'name\': \'Огненный Элементаль\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Огонь, который вырвался на свободу, это устрашающая сила, — разрушительная, беспощадная, ненасытная. Огонь, который подчиняется приказам, еще хуже». — Джефлин, шаман Широколесья\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331814&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'54e2b36b-c178-4e74-bab8-71b0e34e8cdb\', \'multiverseId\': 331814}, \'multiverseid\': 331814}, {\'name\': \'火元素\', \'type\': \'生物～元素\', \'flavor\': \'「野火是一种可怕的力量～它极具毁灭性、毫不手软，并且难以满足。一旦加以引导，情况还会更糟。」～广林祭师捷伏林\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330320&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'91cb3eef-c8f2-43cd-b0e1-9a0a53ca20aa\', \'multiverseId\': 330320}, \'multiverseid\': 330320}, {\'name\': \'火元素\', \'type\': \'生物～元素\', \'flavor\': \'「野火是一種可怕的力量～它極具毀滅性、毫不手軟，並且難以滿足。一旦加以引導，情況還會更糟。」 ～廣林祭師捷伏林\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330818&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'88da69ee-0549-4511-a545-9b275499c9cb\', \'multiverseId\': 330818}, \'multiverseid\': 330818}]', '[{\'name\': \'Feuerflügel-Phoenix\', \'text\': \'Fliegend\\n{1}{R}{R}{R}: Bringe den Feuerflügel-Phoenix aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Phoenix\', \'flavor\': \'„Wir feiern, wenn ein Phoenix sein Nest in einem Vulkan baut, denn das bedeutet hundert Jahre Krieg." —Golmak, Keldonischer Kriegsfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332059&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c44aa72a-58bb-459a-b69f-73ad2b1c0dcc\', \'multiverseId\': 332059}, \'multiverseid\': 332059}, {\'name\': \'Fénix alas ardientes\', \'text\': \'Vuela.\\n{1}{R}{R}{R}: Regresa el Fénix alas ardientes de tu cementerio a tu mano.\', \'type\': \'Criatura — Fénix\', \'flavor\': \'"Cuando un fénix anida en un volcán, festejamos, porque son cien años de guerra." —Gólmak, señor guerrero keldon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332308&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50728751-ca19-439c-99a7-eacf6be7e3c5\', \'multiverseId\': 332308}, \'multiverseid\': 332308}, {\'name\': \'Phénix ailefeu\', \'text\': \'Vol\\n{1}{R}{R}{R} : Renvoyez le Phénix ailefeu depuis votre cimetière dans votre main.\', \'type\': \'Créature : phénix\', \'flavor\': "« Nous nous réjouissons lorsqu\'un phénix fait son nid dans un volcan, car cela signifie cent ans de guerre. » —Golmak, seigneur de guerre kelde", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331561&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79c9fcae-e0a3-403a-8d3d-5e6a7d15994b\', \'multiverseId\': 331561}, \'multiverseid\': 331561}, {\'name\': \'Fenice Alafiamma\', \'text\': \'Volare\\n{1}{R}{R}{R}: Riprendi in mano la Fenice Alafiamma dal tuo cimitero.\', \'type\': \'Creatura — Fenice\', \'flavor\': \'"Quando una fenice si annida in un vulcano, noi gioiamo, poiché significa cent\\\'anni di guerra." —Golmak, Signore della Guerra di Keld\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332557&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51c6e647-26ac-40ff-8732-dea75a9e976e\', \'multiverseId\': 332557}, \'multiverseid\': 332557}, {\'name\': \'火翼のフェニックス\', \'text\': \'飛行\\n{1}{R}{R}{R}：あなたの墓地にある火翼のフェニックスをあなたの手札に戻す。\', \'type\': \'クリーチャー — フェニックス\', \'flavor\': \'「フェニックスが火山に巣を作るのは吉兆だ。それは百年の戦を意味する。」 ――ケルドの大将軍、ゴルマーク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332806&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2e807b2-6cdf-4a32-8b8f-9bffaa331966\', \'multiverseId\': 332806}, \'multiverseid\': 332806}, {\'name\': \'화염날개 불사조\', \'text\': \'비행\\n{1}{R}{R}{R}: 화염날개 불사조를 당신의 무덤에서 당신의 손으로 되돌린다.\', \'type\': \'생물 — 불사조\', \'flavor\': \'"불사조가 화산 속에 둥지를 틀면 우리는 환호한다. 그것은 백 년 동안 전쟁이 일어날 것을 알리는 징조이기 때문이다." —켈드의 군웅 골막\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330565&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d09d321-2cb9-498f-bea0-088f0d5a584b\', \'multiverseId\': 330565}, \'multiverseid\': 330565}, {\'name\': \'Fênix Asas de Fogo\', \'text\': \'Voar\\n{1}{R}{R}{R}: Devolva Fênix Asas de Fogo de seu cemitério para sua mão.\', \'type\': \'Criatura — Fênix\', \'flavor\': \'"Quando uma fênix faz seu ninho num vulcão nós comemoramos, pois isso significa cem anos de guerra." — Golmak, comandante keldoniano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331312&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d550fd2c-e034-4f63-a9e1-93b8b7073cf7\', \'multiverseId\': 331312}, \'multiverseid\': 331312}, {\'name\': \'Огнекрылый Феникс\', \'text\': \'Полет\\n{1}{R}{R}{R}: верните Огнекрылого Феникса из вашего кладбища в вашу руку.\', \'type\': \'Существо — Феникс\', \'flavor\': \'«Если феникс свил гнездо в вулкане, мы ликуем, ведь это означает, что впереди сто лет войны». — Голмак, келдонский военачальник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331810&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6332f1f-c4bf-486e-8e23-e4c8a80f1191\', \'multiverseId\': 331810}, \'multiverseid\': 331810}, {\'name\': \'火翼凤凰\', \'text\': \'飞行\\n{1}{R}{R}{R}：将火翼凤凰从你的坟墓场移回你手上。\', \'type\': \'生物～凤凰\', \'flavor\': \'「我们为凤凰在火山筑巢而庆贺，因这代表了百年的战火。」～凯尔顿军头高玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330316&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2716378d-bded-4672-ba6b-4456aca6c0cb\', \'multiverseId\': 330316}, \'multiverseid\': 330316}, {\'name\': \'火翼鳳凰\', \'text\': \'飛行\\n{1}{R}{R}{R}：將火翼鳳凰從你的墳墓場移回你手上。\', \'type\': \'生物～鳳凰\', \'flavor\': \'「我們為鳳凰在火山築巢而慶賀，因這代表了百年的戰火。」 ～凱爾頓軍頭高瑪\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330814&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae916d7b-d28c-4d06-980b-68469ef03e06\', \'multiverseId\': 330814}, \'multiverseid\': 330814}]', '[{\'name\': \'Feuerwand\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\\n{R}: Die Feuerwand erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'Gnade gibt es nur für diejenigen, die Abstand halten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332131&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8aa3a625-555e-4a8a-82fa-ea859ac6745a\', \'multiverseId\': 332131}, \'multiverseid\': 332131}, {\'name\': \'Muro de fuego\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\\n{R}: El Muro de fuego obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Muro\', \'flavor\': \'La piedad es para aquellos que guardan la distancia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332380&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22207e3f-0f47-4e1c-ab66-b97fe496c772\', \'multiverseId\': 332380}, \'multiverseid\': 332380}, {\'name\': \'Mur de feu\', \'text\': "Défenseur (Cette créature ne peut pas attaquer).\\n{R} : Le Mur de feu gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : mur\', \'flavor\': \'La pitié est réservée à ceux qui gardent leurs distances.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331633&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db2618eb-24aa-42d4-97eb-b10331173c23\', \'multiverseId\': 331633}, \'multiverseid\': 331633}, {\'name\': \'Muro di Fuoco\', \'text\': \'Difensore (Questa creatura non può attaccare.)\\n{R}: Il Muro di Fuoco prende +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Muro\', \'flavor\': \'La pietà è per quelli che si mantengono a distanza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332629&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c0d98510-df59-4c7d-a7c3-940ee34593be\', \'multiverseId\': 332629}, \'multiverseid\': 332629}, {\'name\': \'炎の壁\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\\n{R}：炎の壁はターン終了時まで＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — 壁\', \'flavor\': \'慈悲は、自分なりの距離を保つ者に与えられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332878&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fde99992-6702-45d9-a144-980b8d1b37f7\', \'multiverseId\': 332878}, \'multiverseid\': 332878}, {\'name\': \'불의 벽\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\\n{R}: 불의 벽은 턴종료까지 +1/+0을 받는다.\', \'type\': \'생물 — 벽\', \'flavor\': \'벽을 멀리하는 이들에게 자비가 있으리.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330637&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'048366c5-d028-4fa5-9da4-dcb7decf93e5\', \'multiverseId\': 330637}, \'multiverseid\': 330637}, {\'name\': \'Barreira de Fogo\', \'text\': \'Defensor (Esta criatura não pode atacar.)\\n{R}: Barreira de Fogo recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Barreira\', \'flavor\': \'Misericórdia é para aqueles que se mantêm afastados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331384&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4700184e-1988-4b9e-8ec6-af241f13586a\', \'multiverseId\': 331384}, \'multiverseid\': 331384}, {\'name\': \'Стена Огня\', \'text\': \'Защитник (Это существо не может атаковать.)\\n{R}: Стена Огня получает +1/+0 до конца хода.\', \'type\': \'Существо — Стена\', \'flavor\': \'Пощада только для тех, кто держится в стороне.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331882&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7bd6e890-d596-4a74-9895-126983a0183c\', \'multiverseId\': 331882}, \'multiverseid\': 331882}, {\'name\': \'火墙\', \'text\': \'守军（此生物不能攻击。）\\n{R}：火墙得+1/+0直到回合结束。\', \'type\': \'生物～墙\', \'flavor\': \'能保持距离者就是有福。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330388&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8449a359-e0ff-4148-ac00-f3f4668d0595\', \'multiverseId\': 330388}, \'multiverseid\': 330388}, {\'name\': \'火牆\', \'text\': \'守軍（此生物不能攻擊。）\\n{R}：火牆得+1/+0直到回合結束。\', \'type\': \'生物～牆\', \'flavor\': \'能保持距離者就是有福。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330886&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'97cb260b-8f86-40bf-973a-e80af4a70350\', \'multiverseId\': 330886}, \'multiverseid\': 330886}]', '[{\'name\': \'Flammen des Hitzkopfs\', \'text\': \'Flammen des Hitzkopfs fügt 3 Schadenspunkte zu, deren Aufteilung auf ein, zwei oder drei Ziele deiner Wahl, die Kreaturen und/oder Spieler sein können, du bestimmst.\', \'type\': \'Hexerei\', \'flavor\': \'„Du hast Glück. Ich kann ein paar abgeben." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332065&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f1f586b-d723-4e66-8b56-01a6bb18b4b3\', \'multiverseId\': 332065}, \'multiverseid\': 332065}, {\'name\': \'Llamas de la instigadora\', \'text\': \'Las Llamas de la instigadora hacen 3 puntos de daño divididos como elijas entre una, dos o tres criaturas y/o jugadores objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"Tienes suerte. Traigo suficiente como para compartir." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332314&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6008a056-def8-44c0-9544-421b6e569ef6\', \'multiverseId\': 332314}, \'multiverseid\': 332314}, {\'name\': \'Flammes du brandon\', \'text\': \'Les Flammes du brandon infligent 3 blessures réparties de la manière que vous choisissez entre une, deux ou trois cibles, créatures et/ou joueurs.\', \'type\': \'Rituel\', \'flavor\': \'« Vous avez de la chance. Je suis partageuse. » —Chandra Nalaàr\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331567&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d771b239-0e37-4ccc-ac81-9f7f8ee7b3e2\', \'multiverseId\': 331567}, \'multiverseid\': 331567}, {\'name\': \'Fiamme del Tizzone Ardente\', \'text\': \'Le Fiamme del Tizzone Ardente infliggono 3 danni suddivisi a tua scelta tra una, due o tre creature e/o giocatori bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Sei fortunato. Ne ho portato abbastanza da condividere." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332563&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acb93e3d-7e3c-44be-877f-4f49bccb1b02\', \'multiverseId\': 332563}, \'multiverseid\': 332563}, {\'name\': \'炬火の炎\', \'text\': \'クリーチャーやプレイヤーを、望む組み合わせで1つまたは望む組み合わせでつか3つ対象とする。炬火の炎はそれらに、３点のダメージを好きなように分割して与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「あんたは幸せよ。私のものを分けてあげる。」 ――チャンドラ・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332812&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55ec87af-51ee-44aa-ac6f-d03594e5ffaf\', \'multiverseId\': 332812}, \'multiverseid\': 332812}, {\'name\': \'선동가의 불길\', \'text\': \'생물 및 플레이어를 대상으로 최대 세 개까지의 목표를 정한다. 선동가의 불길은 그 목표들에게 피해 3점을 당신이 나눈 대로 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'"운수도 좋군. 부족하지 않을 정도로 가져왔지." —찬드라 날라르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330571&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7166a55c-ed85-40fe-9f44-5fe9cd42a270\', \'multiverseId\': 330571}, \'multiverseid\': 330571}, {\'name\': \'Chamas da Instigadora\', \'text\': \'Chamas da Instigadora causa 3 pontos de dano distribuídos à sua escolha entre uma, duas ou três criaturas e/ou jogadores alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Você está com sorte. Eu trouxe o suficiente para compartilhar." — Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331318&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bf5b4200-27f0-4ed7-9bc6-60788882c252\', \'multiverseId\': 331318}, \'multiverseid\': 331318}, {\'name\': \'Пламя Разжигательницы\', \'text\': \'Пламя Разжигательницы наносит 3 повреждения, разделенные по вашему выбору между одним, двумя или тремя целевыми существами и (или) игроками.\', \'type\': \'Волшебство\', \'flavor\': \'«Тебе повезло — могу поделиться». — Чандра Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331816&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed991035-cdef-4161-af00-8a13835071a8\', \'multiverseId\': 331816}, \'multiverseid\': 331816}, {\'name\': \'惹事人烈焰\', \'text\': \'惹事人烈焰对一个，两个，或三个目标生物和／或牌手造成共3点伤害，你可以任意分配。\', \'type\': \'法术\', \'flavor\': \'「你走好运啦。我带来的够大家享用。」～茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330322&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d0f2ef97-8d39-4b97-b6cd-38655ec9bc63\', \'multiverseId\': 330322}, \'multiverseid\': 330322}, {\'name\': \'惹事人烈焰\', \'text\': \'惹事人烈焰對一個，兩個，或三個目標生物和／或玩家造成共3點傷害，你可以任意分配。\', \'type\': \'巫術\', \'flavor\': \'「你走好運啦。我帶來的夠大家享用。」 ～茜卓納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330820&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'16cebe77-1d99-4c8f-96c6-f688d58cd5b9\', \'multiverseId\': 330820}, \'multiverseid\': 330820}]', "[{'name': 'Furchtloser Held', 'text': '{T}: Zerstöre eine Kreatur deiner Wahl mit Stärke 4 oder größer.', 'type': 'Kreatur — Mensch, Soldat', 'flavor': 'Ein Dummkopf kennt keine Angst. Ein Held zeigt sie nicht.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332196&type=card', 'language': 'German', 'identifiers': {'scryfallId': '866cf322-a70e-4944-ad56-1ab662fdfe43', 'multiverseId': 332196}, 'multiverseid': 332196}, {'name': 'Héroe intrépido', 'text': '{T}: Destruye la criatura objetivo con fuerza de 4 o más.', 'type': 'Criatura — Soldado humano', 'flavor': 'Un tonto no conoce el miedo. Un héroe no muestra miedo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332445&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f92d8f91-b50f-428e-a265-55cfb553d2b6', 'multiverseId': 332445}, 'multiverseid': 332445}, {'name': 'Héros intrépide', 'text': '{T} : Détruisez la créature ciblée de force supérieure ou égale à 4.', 'type': 'Créature : humain et soldat', 'flavor': 'Un fou ne connaît pas la peur. Un héros ne montre pas sa peur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331698&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ad191ebd-f00c-4e63-bacc-4d0fdaece76f', 'multiverseId': 331698}, 'multiverseid': 331698}, {'name': 'Eroe Intrepido', 'text': '{T}: Distruggi una creatura bersaglio con forza pari o superiore a 4.', 'type': 'Creatura — Soldato Umano', 'flavor': 'Un folle non conosce la paura. Un eroe non la mostra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332694&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dbd60250-257d-45b4-ba0c-3f700fcd9f21', 'multiverseId': 332694}, 'multiverseid': 332694}, {'name': '剛胆な勇士', 'text': '{T}：パワーが４以上のクリーチャー１体を対象とし、それを破壊する。', 'type': 'クリーチャー — 人間・兵士', 'flavor': '愚者は恐れを知らない。勇者は恐れを見せない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332943&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'affc3e7b-9ebf-43a7-82f3-d324574fef3c', 'multiverseId': 332943}, 'multiverseid': 332943}, {'name': '용맹한 영웅', 'text': '{T}: 공격력이 4 이상인 생물 한 개를 목표로 정한다. 그 생물을 파괴한다.', 'type': '생물 — 인간 병사', 'flavor': '바보는 두려움을 모르고, 영웅은 두려움을 드러내지 않는다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330702&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bc36bd2c-0a04-4bf4-aa8e-117387cba8a8', 'multiverseId': 330702}, 'multiverseid': 330702}, {'name': 'Herói Intrépido', 'text': '{T}: Destrua a criatura alvo com poder maior ou igual a 4.', 'type': 'Criatura — Humano Soldado', 'flavor': 'Um tolo não conhece o medo. Um herói não o demonstra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331449&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e10feca0-d342-43cd-b8cd-d027bd2417af', 'multiverseId': 331449}, 'multiverseid': 331449}, {'name': 'Неустрашимый Герой', 'text': '{T}: уничтожьте целевое существо с силой 4 или больше.', 'type': 'Существо — Человек Солдат', 'flavor': 'Глупец не знает страха. Герой страха не показывает.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331947&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '881afd10-f6d8-42b1-99e3-73a43c423aa6', 'multiverseId': 331947}, 'multiverseid': 331947}, {'name': '无畏的英雄', 'text': '{T}：消灭目标力量大于或等于4的生物。', 'type': '生物～人类／士兵', 'flavor': '愚者不识恐惧；英雄无所恐惧。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330453&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c123494c-1b6f-46a7-9c31-216ab2b9dbe6', 'multiverseId': 330453}, 'multiverseid': 330453}, {'name': '無畏的英雄', 'text': '{T}：消滅力量大於或等於4的目標生物。', 'type': '生物～人類／士兵', 'flavor': '愚者不識恐懼；英雄無所恐懼。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330951&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '5ee9793e-43e8-4d9a-b1a9-e1470f091648', 'multiverseId': 330951}, 'multiverseid': 330951}]", "[{'name': 'Garruk der Urjäger', 'text': '+1: Bringe einen 3/3 grünen Bestie-Kreaturenspielstein ins Spiel.\\n-3: Ziehe so viele Karten, wie die höchste Stärke bei deinen Kreaturen beträgt.\\n-6: Bringe für jedes Land, das du kontrollierst, einen 6/6 grünen Wurm-Kreaturenspielstein ins Spiel.', 'type': 'Planeswalker — Garruk', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332018&type=card', 'language': 'German', 'identifiers': {'scryfallId': '64a19c07-8458-4461-a346-5d69bb0ab37c', 'multiverseId': 332018}, 'multiverseid': 332018}, {'name': 'Garruk, cazador primordial', 'text': '+1: Pon en el campo de batalla una ficha de criatura Bestia verde 3/3.\\n-3: Roba una cantidad de cartas igual a la mayor fuerza entre las criaturas que controlas.\\n-6: Pon en el campo de batalla una ficha de criatura Sierpe verde 6/6 por cada tierra que controles.', 'type': 'Planeswalker — Garruk', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332267&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fb82f086-bb2e-47d6-9beb-d542896f170b', 'multiverseId': 332267}, 'multiverseid': 332267}, {'name': 'Garruk, chasseur primordial', 'text': '+1 : Mettez sur le champ de bataille un jeton de créature 3/3 verte Bête.\\n-3 : Piochez un nombre de cartes égal à la force la plus élevée parmi les créatures que vous contrôlez.\\n-6 : Mettez sur le champ de bataille un jeton de créature 6/6 verte Guivre pour chaque terrain que vous contrôlez.', 'type': 'Planeswalker : Garruk', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331520&type=card', 'language': 'French', 'identifiers': {'scryfallId': '83638e94-3e49-490a-9707-58a86406f113', 'multiverseId': 331520}, 'multiverseid': 331520}, {'name': 'Garruk, Cacciatore Primitivo', 'text': '+1: Metti sul campo di battaglia una pedina creatura Bestia 3/3 verde.\\n-3: Pesca un numero di carte pari alla forza maggiore tra le creature che controlli.\\n-6: Metti sul campo di battaglia una pedina creatura Wurm 6/6 verde per ogni terra che controlli.', 'type': 'Planeswalker — Garruk', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332516&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '67620a93-a8eb-4f54-88c3-67d57698eca0', 'multiverseId': 332516}, 'multiverseid': 332516}, {'name': '原初の狩人、ガラク', 'text': '＋１：緑の３/３のビースト・クリーチャー・トークンを１体戦場に出す。\\n－３：あなたがコントロールするクリーチャーの中のパワーの最大値に等しい枚数のカードを引く。\\n－６：あなたがコントロールする土地１つにつき、緑の６/６のワーム・クリーチャー・トークンを１体戦場に出す。', 'type': 'プレインズウォーカー — ガラク', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332765&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c906935b-d58c-4031-b40b-c8a38dd7552f', 'multiverseId': 332765}, 'multiverseid': 332765}, {'name': '원시사냥꾼 개럭', 'text': '+1: 3/3 녹색 야수 생물 토큰 한 개를 전장에 놓는다.\\n-3: 당신이 조종하는 생물 중 제일 높은 공격력을 가진 생물의 공격력만큼 카드를 뽑는다.\\n-6: 당신이 조종하는 대지 한 개당 6/6 녹색 웜 생물 토큰 한 개를 전장에 놓는다.', 'type': '플레인즈워커 — - 개럭', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330524&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'fe8fc47b-e7e8-455b-b343-a3c8b6d3f2ad', 'multiverseId': 330524}, 'multiverseid': 330524}, {'name': 'Garruk, Caçador Primal', 'text': '+1: Coloque no campo de batalha uma ficha de criatura verde 3/3 do tipo Besta.\\n-3: Compre uma quantidade de cards equivalente ao maior poder entre as criaturas que você controla.\\n-6: Coloque no campo de batalha uma ficha de criatura verde 6/6 do tipo Vorme para cada terreno que você controle.', 'type': 'Planeswalker — Garruk', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331271&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '334b83ec-722f-40fd-8bb1-b7d72d8c3fe2', 'multiverseId': 331271}, 'multiverseid': 331271}, {'name': 'Гаррук, Первобытный Охотник', 'text': '+1: положите на поле битвы одну фишку существа 3/3 зеленый Зверь.\\n-3: возьмите количество карт, равное наибольшему значению силы среди существ под вашим контролем.\\n-6: положите на поле битвы одну фишку существа 6/6 зеленый Вурм за каждую землю под вашим контролем.', 'type': 'Planeswalker — Гаррук', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331769&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0630c7bc-f3a7-4a1d-aa43-af615e987aaa', 'multiverseId': 331769}, 'multiverseid': 331769}, {'name': '原初猎人贾路', 'text': '+1：将一个3/3绿色野兽衍生生物放进战场。-3：抓若干牌，其数量等同于由你操控的生物中力量最大者的数值。-6：你每操控一个地，便将一个6/6绿色亚龙衍生生物放进战场。', 'type': '鹏洛客～贾路', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330275&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2650d14d-f8ab-4be8-97b9-b60c6b830d7d', 'multiverseId': 330275}, 'multiverseid': 330275}, {'name': '原初獵人賈路', 'text': '+1：將一個3/3綠色野獸衍生生物放進戰場。\\n-3：抽若干牌，其數量等同於由你操控的生物中力量最大者的數值。\\n-6：你每操控一個地，便將一個6/6綠色亞龍衍生生物放進戰場。', 'type': '鵬洛客～賈路', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330773&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '423c3f6b-7127-4b22-b3c0-a99c73ad3177', 'multiverseId': 330773}, 'multiverseid': 330773}]", '[{\'name\': \'Garruks Rudelführer\', \'text\': \'Immer wenn eine andere Kreatur mit Stärke 3 oder mehr unter deiner Kontrolle ins Spiel kommt, kannst du eine Karte ziehen.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Er hat mit seinem hohen Alter viel gelernt. Und im Gegensatz zu den eigensüchtigen Menschen gibt er es auch gerne weiter." —Garruk Wildsprecher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332025&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'25ca70d1-a274-4358-b7d9-8061ff739d24\', \'multiverseId\': 332025}, \'multiverseid\': 332025}, {\'name\': \'Líder de manada de Garruk\', \'text\': \'Siempre que otra criatura con fuerza de 3 o más entre al campo de batalla bajo tu control, puedes robar una carta.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Ha aprendido mucho con su edad. Y al contrario que los humanos egoístas, está dispuesto a compartir." —Garruk Portavoz Salvaje\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332274&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a75fb6e-252e-42b8-a0f9-aeaa85aa79d2\', \'multiverseId\': 332274}, \'multiverseid\': 332274}, {\'name\': \'Chef de meute de Garruk\', \'text\': "À chaque fois qu\'une autre créature avec une force supérieure ou égale à 3 arrive sur le champ de bataille sous votre contrôle, vous pouvez piocher une carte.", \'type\': \'Créature : bête\', \'flavor\': \'« Il a beaucoup appris durant les longues années de sa vie. Et contrairement aux humains égoïstes, il est prêt à partager. » —Garruk Languebestion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331527&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68a6aad1-0c60-422c-9286-9e931e55c8c1\', \'multiverseId\': 331527}, \'multiverseid\': 331527}, {\'name\': \'Capobranco di Garruk\', \'text\': "Ogniqualvolta un\'altra creatura con forza pari o superiore a 3 entra nel campo di battaglia sotto il tuo controllo, puoi pescare una carta.", \'type\': \'Creatura — Bestia\', \'flavor\': \'"Ha imparato molto in tutti questi anni. E a differenza degli umani egoisti, è propenso a condividere." —Garruk Lingua Selvaggia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332523&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ebad673-9460-4bdf-a33b-26c2da8bbd4c\', \'multiverseId\': 332523}, \'multiverseid\': 332523}, {\'name\': \'ガラクの群れ率い\', \'text\': \'他のパワーが３以上のクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたはカードを１枚引いてもよい。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「長い年月でずいぶんと学んだんだろう。身勝手な人間と違うのは、それを分かち合おうとしていることだ。」 ――野生語りのガラク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332772&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'389ea42e-fa06-452e-bcd4-2f022d64a234\', \'multiverseId\': 332772}, \'multiverseid\': 332772}, {\'name\': \'개럭의 짐승대장\', \'text\': \'공격력이 3 이상인 생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 카드 한 장을 뽑을 수 있다.\', \'type\': \'생물 — 야수\', \'flavor\': \'"그는 오랜 세월 동안 많은 것을 배웠고, 이기적인 인간과 달리 그 지식을 나눌 줄 안다." —개럭 와일드스피커\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330531&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'94e576c5-5c7c-44bc-8a90-469c7f031985\', \'multiverseId\': 330531}, \'multiverseid\': 330531}, {\'name\': \'Líder de Matilha de Garruk\', \'text\': \'Toda vez que outra criatura com poder maior ou igual a 3 entra no campo de batalha sob o seu controle, você pode comprar um card.\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Ele aprendeu muito nos seus longos anos. E, ao contrário dos humanos egoístas, está disposto a compartilhar." — Garruk Falabravo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331278&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'502368a7-fbf3-452c-aa52-1026cd01a3d1\', \'multiverseId\': 331278}, \'multiverseid\': 331278}, {\'name\': \'Вожак Стаи Гаррука\', \'text\': \'Каждый раз, когда другое существо с силой 3 или больше выходит на поле битвы под вашим контролем, вы можете взять карту.\', \'type\': \'Существо — Зверь\', \'flavor\': \'«За долгие годы он многому научился. И в отличие от эгоистичных людей он готов поделиться своими знаниями». — Гаррук Дикоречивый\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331776&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0e328d0d-f642-413a-9d92-45c878f00209\', \'multiverseId\': 331776}, \'multiverseid\': 331776}, {\'name\': \'贾路的兽群长\', \'text\': \'每当另一个力量大于或等于3的生物在你的操控下进战场时，你可以抓一张牌。\', \'type\': \'生物～野兽\', \'flavor\': \'「他的长寿让他多闻。而且与自私的人类不同，他很乐于分享。」～召兽使贾路\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330282&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'de40d82f-650c-42d1-adbf-6f096a86dc9e\', \'multiverseId\': 330282}, \'multiverseid\': 330282}, {\'name\': \'賈路的獸群長\', \'text\': \'每當另一個力量大於或等於3的生物在你的操控下進戰場時，你可以抽一張牌。\', \'type\': \'生物～野獸\', \'flavor\': \'「他的長壽讓他多聞。而且與自私的人類不同，他很樂於分享。」 ～召獸使賈路\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330780&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'77f8166e-dfef-4e9b-bac4-15b030bec220\', \'multiverseId\': 330780}, \'multiverseid\': 330780}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332002&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6d5def73-f431-4ef4-9250-7914d772da21', 'multiverseId': 332002}, 'multiverseid': 332002}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332251&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5086732d-afbe-4861-902e-88e9c1cbc5f2', 'multiverseId': 332251}, 'multiverseid': 332251}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331504&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9efa5c33-42dd-4b42-903f-d21922254a3b', 'multiverseId': 331504}, 'multiverseid': 331504}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332500&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7024f3b3-4716-4499-a159-57384e7ba43c', 'multiverseId': 332500}, 'multiverseid': 332500}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332749&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '16f21160-c6be-498d-8ce1-c59c95b06410', 'multiverseId': 332749}, 'multiverseid': 332749}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330508&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3d2f9c9e-b6c9-4c20-a5fe-f2b7735b39e4', 'multiverseId': 330508}, 'multiverseid': 330508}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331255&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b5ee4727-ce43-45b8-ba63-2d69a9f124aa', 'multiverseId': 331255}, 'multiverseid': 331255}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331753&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '52cf0085-3466-4854-969b-e36246d71ed2', 'multiverseId': 331753}, 'multiverseid': 331753}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330259&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '38ae3986-8a6f-406c-b995-3244a94a5345', 'multiverseId': 330259}, 'multiverseid': 330259}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330757&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9e726c5d-e21e-4db8-9da5-76a2efe64291', 'multiverseId': 330757}, 'multiverseid': 330757}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332003&type=card', 'language': 'German', 'identifiers': {'scryfallId': '84c1953d-d9c9-43dc-a35c-324382604d14', 'multiverseId': 332003}, 'multiverseid': 332003}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332252&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2b00213c-44b4-4a4f-9c7d-e0b4e5099d28', 'multiverseId': 332252}, 'multiverseid': 332252}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331505&type=card', 'language': 'French', 'identifiers': {'scryfallId': '220f4fa6-483c-41d0-b8f3-c7253d546f54', 'multiverseId': 331505}, 'multiverseid': 331505}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332501&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bda5da78-d30b-4d1e-b14b-9b9db4a005e4', 'multiverseId': 332501}, 'multiverseid': 332501}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=332750&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '30e7a882-8485-4ee9-ab21-f30b2726d5d7', 'multiverseId': 332750}, 'multiverseid': 332750}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=330509&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8a860638-167e-4eb6-92f8-f4b216f87eb5', 'multiverseId': 330509}, 'multiverseid': 330509}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331256&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2e7cc728-c9f5-4c5e-acd8-8bc9b59865a2', 'multiverseId': 331256}, 'multiverseid': 331256}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=331754&ty