', 'RIN', 'RIX', 'RNA', 'ROE', 'RQS', 'RTR', 'RVR', 'S00', 'S99', 'SCD', 'SHM', 'SIR', 'SLC', 'SLD', 'SLP', 'SNC', 'SOI', 'SOM', 'SPG', 'SS1', 'STA', 'STX', 'SUM', 'TD0', 'TD2', 'THB', 'THS', 'TMP', 'TOR', 'TPR', 'TSB', 'TSP', 'UGL', 'UMA', 'UND', 'UNF', 'UNH', 'USG', 'UST', 'V09', 'V10', 'V13', 'V14', 'V15', 'VMA', 'VOC', 'VOW', 'W16', 'W17', 'WAR', 'WC00', 'WC01', 'WC02', 'WC03', 'WC04', 'WC97', 'WC98', 'WC99', 'WHO', 'WOC', 'WOE', 'WOT', 'XANA', 'XLN', 'YDMU', 'ZEN', 'ZNC', 'ZNR']
