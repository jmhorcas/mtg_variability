 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388836&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1e34e683-b40a-4f4e-9ff7-4a097ff09996', 'multiverseId': 388836}, 'multiverseid': 388836}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389105&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1500b8ff-e839-4822-8f55-e1c569502559', 'multiverseId': 389105}, 'multiverseid': 389105}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386953&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4c6056ef-006a-4aab-857d-a7aea52f5444', 'multiverseId': 386953}, 'multiverseid': 386953}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387222&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'bdca4e00-d663-4b00-9ef2-1df085bda5d7', 'multiverseId': 387222}, 'multiverseid': 387222}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387492&type=card', 'language': 'German', 'identifiers': {'scryfallId': '559aea97-6046-4368-a905-6d75e0ce93b4', 'multiverseId': 387492}, 'multiverseid': 387492}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389375&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '632e5e03-6ae3-4f1d-8e18-0b5d95464650', 'multiverseId': 389375}, 'multiverseid': 389375}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387761&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e7105943-217e-42ea-9d10-0ec12dbcc45d', 'multiverseId': 387761}, 'multiverseid': 387761}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388030&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bcba29d3-74a5-4bae-ac43-560b6e383b64', 'multiverseId': 388030}, 'multiverseid': 388030}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388299&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '522b2f35-6952-4c6f-903c-b2ceb8f37f07', 'multiverseId': 388299}, 'multiverseid': 388299}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388568&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '37b4b6cb-5fa7-4727-89e1-778beaf4246b', 'multiverseId': 388568}, 'multiverseid': 388568}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388837&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c366b056-78ca-4f7f-96a1-e0c130def03a', 'multiverseId': 388837}, 'multiverseid': 388837}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389106&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd9b48b04-13d8-4ff4-b4ed-59c13c3bd8a3', 'multiverseId': 389106}, 'multiverseid': 389106}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386954&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '21088d06-2eea-454f-898b-053a3931c634', 'multiverseId': 386954}, 'multiverseid': 386954}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387223&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '60368257-bbbd-470d-b860-fd90424b595a', 'multiverseId': 387223}, 'multiverseid': 387223}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387493&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0f286db7-756e-4b66-9bc8-382a6d3cafb0', 'multiverseId': 387493}, 'multiverseid': 387493}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389376&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5acaa8f4-22d3-48f4-ab11-603736b434a2', 'multiverseId': 389376}, 'multiverseid': 389376}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387762&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7e349cf0-2c44-456c-9930-91855b5c2efa', 'multiverseId': 387762}, 'multiverseid': 387762}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388031&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3ea0b1b4-aa90-4a6c-9671-d48b63c64498', 'multiverseId': 388031}, 'multiverseid': 388031}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388300&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '27f96bf8-e2f8-47be-9f8e-d9a4daa7692b', 'multiverseId': 388300}, 'multiverseid': 388300}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388569&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '0b6854dc-8ca6-4369-b048-9072b010e4a8', 'multiverseId': 388569}, 'multiverseid': 388569}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388838&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '19b9b738-a2e5-42a1-959a-efd539a2c046', 'multiverseId': 388838}, 'multiverseid': 388838}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389107&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '504c044d-f47b-4c10-8733-228145faf88f', 'multiverseId': 389107}, 'multiverseid': 389107}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386955&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '95c320b2-ebe9-4355-84a6-8a8b867494ad', 'multiverseId': 386955}, 'multiverseid': 386955}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387224&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a644813a-758e-487a-9599-ee73b9e2c216', 'multiverseId': 387224}, 'multiverseid': 387224}]", "[{'name': 'Surrak Drachenklaue', 'text': 'Aufblitzen\\nSurrak Drachenklaue kann nicht neutralisiert werden.\\nKreaturenzauber, die du kontrollierst, können nicht neutralisiert werden.\\nAndere Kreaturen, die du kontrollierst, verursachen Trampelschaden.', 'type': 'Legendäre Kreatur — Mensch, Krieger', 'flavor': 'Sowohl seinen Rang als auch seine Narben hat er sich im Einzelkampf mit einem Höhlenbären verdient.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387488&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f9fa6ff3-4a44-4d55-8498-5fb618e368b2', 'multiverseId': 387488}, 'multiverseid': 387488}, {'name': 'Surrak Garradragón', 'text': 'Destello.\\nSurrak Garradragón no puede ser contrarrestado.\\nLos hechizos de criatura que controlas no pueden ser contrarrestados.\\nLas otras criaturas que controlas tienen la habilidad de arrollar.', 'type': 'Criatura legendaria — Guerrero humano', 'flavor': 'Tanto su rango como sus cicatrices los ganó en combate singular contra un oso de las cavernas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389371&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8613d6af-4a7f-4f09-ba28-21a43374bbeb', 'multiverseId': 389371}, 'multiverseid': 389371}, {'name': 'Surrak Griffedragon', 'text': 'Flash\\nSurrak Griffedragon ne peut pas être contrecarré.\\nLes sorts de créature que vous contrôlez ne peuvent pas être contrecarrés.\\nLes autres créatures que vous contrôlez ont le piétinement.', 'type': 'Créature légendaire : humain et guerrier', 'flavor': 'Un combat singulier contre un ours des cavernes lui valut son titre et ses cicatrices.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387757&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b753d369-ec4b-4db4-96ba-f33e28f2ea73', 'multiverseId': 387757}, 'multiverseid': 387757}, {'name': 'Surrak Artiglio di Drago', 'text': 'Lampo\\nSurrak Artiglio di Drago non può essere neutralizzato.\\nLe magie creatura che controlli non possono essere neutralizzate.\\nLe altre creature che controlli hanno travolgere.', 'type': 'Creatura Leggendaria — Guerriero Umano', 'flavor': 'Si è guadagnato sia il grado sia le cicatrici nello stesso combattimento contro un orso delle caverne.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388026&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8094d8e6-c6c6-4e93-afe3-98ae9e04b937', 'multiverseId': 388026}, 'multiverseid': 388026}, {'name': '龍爪のスーラク', 'text': '瞬速\\n龍爪のスーラクは打ち消されない。\\nあなたがコントロールするクリーチャー・呪文は打ち消されない。\\nあなたがコントロールする他のクリーチャーはトランプルを持つ。', 'type': '伝説のクリーチャー — 人間・戦士', 'flavor': '彼の地位と傷はいずれも洞窟の熊との１対１の戦いで得たものである。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388295&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4520ba66-3a6d-45fc-80cb-db02c1b3e98e', 'multiverseId': 388295}, 'multiverseid': 388295}, {'name': '용발톱 서락', 'text': '섬광\\n용발톱 서락은 무효화될 수 없다.\\n당신이 조종하는 생물 주문들은 무효화될 수 없다.\\n당신이 조종하는 다른 생물들은 돌진을 가진다.', 'type': '전설적 생물 — 인간 전사', 'flavor': '그는 동굴 곰을 상대한 단 한 번의 전투를 통해 지위와 흉터를 얻었다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388564&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c09c137b-adb2-4e69-b086-2ee5465e9802', 'multiverseId': 388564}, 'multiverseid': 388564}, {'name': 'Surrak Garra de Dragão', 'text': 'Lampejo\\nSurrak Garra de Dragão não pode ser anulado.\\nAs mágicas de criatura que você controla não podem ser anuladas.\\nAs outras criaturas que você controla têm atropelar.', 'type': 'Criatura Lendária — Humano Guerreiro', 'flavor': 'Tanto sua patente quanto suas cicatrizes foram conquistadas em um único combate contra um urso das cavernas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388833&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0617c606-a022-4fef-8893-2c87c83b5a50', 'multiverseId': 388833}, 'multiverseid': 388833}, {'name': 'Суррак Коготь Дракона', 'text': 'Миг\\nСуррак Коготь Дракона не может быть отменен.\\nЗаклинания существ под вашим контролем не могут быть отменены.\\nДругие существа под вашим контролем имеют Пробивной удар.', 'type': 'Легендарное Существо — Человек Воин', 'flavor': 'И свой ранг, и свои шрамы он получил в сражении один на один с пещерным медведем.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389102&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4a7ca733-2f72-458e-b7ef-c30523ee6c41', 'multiverseId': 389102}, 'multiverseid': 389102}, {'name': '龙爪苏拉克', 'text': '闪现\\n龙爪苏拉克不能被反击。\\n由你操控的生物咒语不能被反击。\\n由你操控的其他生物具有践踏异能。', 'type': '传奇生物～人类／战士', 'flavor': '单挑穴熊之壮举造就其今日显赫地位与身上触目疤痕。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386950&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1eeb00b3-3d15-441a-952e-803ec229b094', 'multiverseId': 386950}, 'multiverseid': 386950}, {'name': '龍爪蘇拉克', 'text': '閃現\\n龍爪蘇拉克不能被反擊。\\n由你操控的生物咒語不能被反擊。\\n由你操控的其他生物具有踐踏異能。', 'type': '傳奇生物～人類／戰士', 'flavor': '單挑穴熊之壯舉造就其今日顯赫地位與身上觸目疤痕。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387219&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4c0c6fb9-69f6-432a-b89f-77ad1caada15', 'multiverseId': 387219}, 'multiverseid': 387219}]", '[{\'name\': \'Taigams Ränkespiel\', \'text\': \'Schaue dir die obersten fünf Karten deiner Bibliothek an. Lege eine beliebige Anzahl davon auf deinen Friedhof und den Rest in beliebiger Reihenfolge oben auf deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Jeskai wollen, dass ich gesenkten Hauptes Zurückhaltung übe. Also habe ich mir ein Volk gesucht, das keine Angst vor wahrer Macht hat."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387497&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b5008c8b-6881-4729-9289-ac3ddb606c08\', \'multiverseId\': 387497}, \'multiverseid\': 387497}, {\'name\': \'Maquinación de Taigam\', \'text\': \'Mira las cinco primeras cartas de tu biblioteca. Pon cualquier cantidad de ellas en tu cementerio y el resto en la parte superior de tu biblioteca en cualquier orden.\', \'type\': \'Conjuro\', \'flavor\': \'"Los Jeskai querrían verme arrodillado y sometido. Veo que he hallado a un pueblo que no teme el auténtico poder".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389380&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95b0c923-0fb3-43c5-99e5-b25fb13efccb\', \'multiverseId\': 389380}, \'multiverseid\': 389380}, {\'name\': \'Machinations de Taigam\', \'text\': "Regardez les cinq cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles dans votre cimetière et remettez ensuite le reste au-dessus de votre bibliothèque, dans l\'ordre de votre choix.", \'type\': \'Rituel\', \'flavor\': "« Les Jeskaï m\'auraient emprisonné et contraint à me prosterner. Alors j\'ai trouvé un peuple qui n\'a pas peur de la vraie puissance. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8129f2ed-256c-42cf-8c41-e444b5c48821\', \'multiverseId\': 387766}, \'multiverseid\': 387766}, {\'name\': \'Intrighi di Taigam\', \'text\': \'Guarda le prime cinque carte del tuo grimorio. Mettine un qualsiasi numero nel tuo cimitero e le altre in cima al tuo grimorio in qualsiasi ordine.\', \'type\': \'Stregoneria\', \'flavor\': \'"I Jeskai vorrebbero che mi piegassi alla moderazione, così ho trovato un popolo che non teme il vero potere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c45df5e1-70b3-45ed-a596-44dc8b2f1550\', \'multiverseId\': 388035}, \'multiverseid\': 388035}, {\'name\': \'テイガムの策謀\', \'text\': \'あなたのライブラリーの一番上から５枚のカードを見る。そのうちの望む枚数をあなたの墓地に置き、残りをあなたのライブラリーの一番上に望む順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': \'「ジェスカイの奴らは私に抑制を教えるために頭を下げさせた。だから、真の力を恐れない者たちを私は探し当てたのさ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388304&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ccc6f3e1-80eb-48ed-a09c-2da4d445ecfa\', \'multiverseId\': 388304}, \'multiverseid\': 388304}, {\'name\': \'타이감의 술책\', \'text\': \'당신의 서고 맨 위의 카드 다섯 장을 본다. 그중 원하는 만큼을 당신의 무덤에 넣고 나머지 카드들은 당신의 서고 맨 위에 원하는 순서로 놓는다.\', \'type\': \'집중마법\', \'flavor\': \'"제스카이는 나로 하여금 억압된 채로 머리를 숙이게 할 것이야. 그래서 나는 진정한 힘을 두려워하지 않는 이들을 찾았지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388573&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'575dd5a3-4cc3-4c87-87bf-196fd3e196d8\', \'multiverseId\': 388573}, \'multiverseid\': 388573}, {\'name\': \'Maquinações de Taigam\', \'text\': \'Olhe os cinco cards do topo de seu grimório. Coloque qualquer quantidade deles no seu cemitério e o restante no topo do seu grimório em qualquer ordem.\', \'type\': \'Feitiço\', \'flavor\': \'"Os Jeskai queriam que eu me curvasse em respeito. Então, encontrei um povo que não temesse o poder verdadeiro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388842&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d135ccc-a503-4170-a38d-0a54ae690e53\', \'multiverseId\': 388842}, \'multiverseid\': 388842}, {\'name\': \'Замыслы Тайгама\', \'text\': \'Посмотрите пять верхних карт вашей библиотеки. Положите любое количество из них на ваше кладбище, а остальные обратно на верх вашей библиотеки в любом порядке.\', \'type\': \'Волшебство\', \'flavor\': \'«У джескайцев мне бы пришлось согнуться в смиренном поклоне. Так что я отыскал народ, который не боится истинного могущества».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389111&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e5c8a238-07f4-4dbd-8998-46bb2a6919bf\', \'multiverseId\': 389111}, \'multiverseid\': 389111}, {\'name\': \'泰伽姆的阴谋\', \'text\': \'检视你牌库顶的五张牌。将其中任意数量的牌置入你的坟墓场，其余则以任意顺序放回你的牌库顶。\', \'type\': \'法术\', \'flavor\': \'「洁斯凯还想迫使我屈服，既然他们毫不畏惧，就让他们瞧瞧真正的力量。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386959&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'19f419c9-f16c-49be-9949-84b6b890e19b\', \'multiverseId\': 386959}, \'multiverseid\': 386959}, {\'name\': \'泰伽姆的陰謀\', \'text\': \'檢視你牌庫頂的五張牌。將其中任意數量的牌置入你的墳墓場，其餘則以任意順序放回你的牌庫頂。\', \'type\': \'巫術\', \'flavor\': \'「潔斯凱還想迫使我屈服，既然他們毫不畏懼，就讓他們瞧瞧真正的力量。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387228&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'85271a46-6704-4164-a364-58680e8bf824\', \'multiverseId\': 387228}, \'multiverseid\': 387228}]', '[{\'name\': \'Talstürmer\', \'text\': \'Eile\\nDer Talstürmer greift in jedem Zug an, falls möglich.\', \'type\': \'Kreatur — Mensch, Berserker\', \'flavor\': \'Die größte Angst der Mardu-Reiter ist, dass eine Schlacht enden könnte, bevor ihre Waffen Blut geleckt haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387519&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9fa54464-6879-4d61-b55e-2cb68ae0b91f\', \'multiverseId\': 387519}, \'multiverseid\': 387519}, {\'name\': \'Traviesavalles\', \'text\': \'Prisa.\\nEl Traviesavalles ataca cada turno si puede.\', \'type\': \'Criatura — Berserker humano\', \'flavor\': \'El mayor temor de los jinetes mardu es que una batalla termine antes de que sus armas puedan probar la sangre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d927c65a-0a0e-415e-9268-f38bebce63f9\', \'multiverseId\': 389402}, \'multiverseid\': 389402}, {\'name\': \'Fonceur des vallées\', \'text\': \'Célérité\\nLe Fonceur des vallées attaque à chaque tour si possible.\', \'type\': \'Créature : humain et berserker\', \'flavor\': "Les cavaliers marduens ne craignent qu\'une chose : que la bataille se termine avant qu\'ils n\'aient pu faire couler le sang.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387788&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'368fd51e-07fd-4969-bb08-b1d833a89fa6\', \'multiverseId\': 387788}, \'multiverseid\': 387788}, {\'name\': \'Assaltatore della Valle\', \'text\': "Rapidità\\nL\'Assaltatore della Valle attacca ogni turno, se può farlo.", \'type\': \'Creatura — Berserker Umano\', \'flavor\': \'La più grande paura dei cavalieri Mardu è che la battaglia termini prima che le loro armi possano assaporare il sangue.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388057&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f05e90f5-d92a-4331-bc1a-152ee3b3560e\', \'multiverseId\': 388057}, \'multiverseid\': 388057}, {\'name\': \'谷を駆ける者\', \'text\': \'速攻\\n毎ターン、谷を駆ける者は可能なら攻撃する。\', \'type\': \'クリーチャー — 人間・狂戦士\', \'flavor\': \'マルドゥの騎兵にとっての最大の恐怖は、自らの武器が血に染まる前に戦いが終わってしまうことである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388326&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'99dcf6e2-c132-470c-b1e1-e5a3af106a7a\', \'multiverseId\': 388326}, \'multiverseid\': 388326}, {\'name\': \'돌진하는 계곡 기수\', \'text\': \'신속\\n돌진하는 계곡 기수는 가능하면 매 턴마다 공격한다.\', \'type\': \'생물 — 인간 광전사\', \'flavor\': \'마르두 기수들은 자신의 무기에 피를 묻히기 전에 전투가 종료되는 것을 가장 두려워한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388595&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ba425d6e-5a06-40a2-9c70-fe561ac22bef\', \'multiverseId\': 388595}, \'multiverseid\': 388595}, {\'name\': \'Relâmpago do Vale\', \'text\': \'Ímpeto\\nRelâmpago do Vale ataca a cada turno se estiver apto.\', \'type\': \'Criatura — Humano Amoque\', \'flavor\': \'O maior medo dos cavaleiros Mardu é que a batalha termine antes que possam derramar sangue com suas armas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388864&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6df3252-6288-4020-9882-1f0d0044dcd5\', \'multiverseId\': 388864}, \'multiverseid\': 388864}, {\'name\': \'Всадник из Долины\', \'text\': \'Ускорение\\nВсадник из Долины атакует в каждом ходу, если может.\', \'type\': \'Существо — Человек Берсерк\', \'flavor\': \'Всадники Марду боятся лишь того, что бой закончится раньше, чем они успеют обагрить клинки кровью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389133&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de6be69c-ed86-4e23-ac45-59b9570a1936\', \'multiverseId\': 389133}, \'multiverseid\': 389133}, {\'name\': \'峡谷迅击兵\', \'text\': \'敏捷\\n峡谷迅击兵每回合若能攻击，则必须攻击。\', \'type\': \'生物～人类／狂战士\', \'flavor\': \'玛尔都劫掠者最怕的是他们的武器还没沾血，战斗就结束了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71296862-88cb-4d5b-8c59-a26cbbb85829\', \'multiverseId\': 386981}, \'multiverseid\': 386981}, {\'name\': \'峽谷迅擊兵\', \'text\': \'敏捷\\n峽谷迅擊兵每回合若能攻擊，則必須攻擊。\', \'type\': \'生物～人類／狂戰士\', \'flavor\': \'瑪爾都劫掠者最怕的是他們的武器還沒沾血，戰鬥就結束了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387250&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'76729ac7-2086-4aea-a3ce-70086f9fd398\', \'multiverseId\': 387250}, \'multiverseid\': 387250}]', '[{\'name\': \'Tapferer Widerstand\', \'text\': \'Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst. Sie erhält bis zum Ende des Zuges Schutz vor einer Farbe, die du bestimmst.\', \'type\': \'Spontanzauber\', \'flavor\': \'Auf Tarkir sind die Drachen ausgestorben, doch die Magie der Abzan eifert immer noch ihrer Standhaftigkeit nach.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387341&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6584f6bc-ad1e-4077-81d2-59c550622eef\', \'multiverseId\': 387341}, \'multiverseid\': 387341}, {\'name\': \'Hito de resistencia\', \'text\': \'Pon un contador +1/+1 sobre la criatura objetivo que controlas. Esa criatura gana protección contra el color de tu elección hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Los dragones se extinguieron en Tarkir, pero la magia abzana todavía emula su resistencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389224&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cca76531-1da1-4e31-ac98-71611ebce1a6\', \'multiverseId\': 389224}, \'multiverseid\': 389224}, {\'name\': \'Haut fait de résistance\', \'text\': "Mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez. Elle acquiert la protection contre la couleur de votre choix jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'Sur Tarkir, les dragons sont éteints, mais la magie abzane imite toujours leur endurance.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387610&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eff7970a-1232-476f-aaf2-9259e532f800\', \'multiverseId\': 387610}, \'multiverseid\': 387610}, {\'name\': \'Atto di Resistenza\', \'text\': \'Metti un segnalino +1/+1 su una creatura bersaglio che controlli. Ha protezione da un colore a tua scelta fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'I draghi sono estinti su Tarkir, ma la magia degli Abzan ne emula ancora la resistenza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387879&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8af24597-888b-48c8-8446-b5c2b1a52c56\', \'multiverseId\': 387879}, \'multiverseid\': 387879}, {\'name\': \'抵抗の妙技\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。ターン終了時まで、それはプロテクション（あなたが選んだ色１色）を得る。\', \'type\': \'インスタント\', \'flavor\': \'タルキールでは龍は絶滅してしまったが、アブザンの魔法は今もなおそれらの耐久力を模倣している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388148&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90062176-d454-4968-bb38-474363c7ed64\', \'multiverseId\': 388148}, \'multiverseid\': 388148}, {\'name\': \'저항의 묘기\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다. 그 생물은 턴종료까지 당신이 선택한 색으로부터 보호를 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'타르커의 용들은 멸종했으나, 아브잔의 마법에는 여전히 그들의 인내심이 깃들어 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388417&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'adde14ca-a5ea-4113-8608-781020442cf5\', \'multiverseId\': 388417}, \'multiverseid\': 388417}, {\'name\': \'Demonstração de Resistência\', \'text\': \'Coloque um marcador +1/+1 na criatura alvo que você controla. Ela ganha proteção contra a cor de sua escolha até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os dragões foram extintos em Tarkir, mas a mágica Abzan ainda emula sua resistência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388686&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d92183cb-d71e-44d2-a9df-597bb83636d1\', \'multiverseId\': 388686}, \'multiverseid\': 388686}, {\'name\': \'Подвиг Выносливости\', \'text\': \'Положите один жетон +1/+1 на целевое существо под вашим контролем. Оно получает Защиту от выбранного вами цвета до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Драконов в Таркире давно не осталось, но магия Абзана все еще позволяет обрести их выносливость.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388955&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d14c7eeb-f302-4b8c-a8a7-0304ec364328\', \'multiverseId\': 388955}, \'multiverseid\': 388955}, {\'name\': \'反抗技艺\', \'text\': \'在目标由你操控的生物上放置一个+1/+1指示物。选择一种颜色。该生物获得反该色保护异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'虽然龙已在鞑契绝迹，但其坚忍仍得见于阿布赞的魔法之中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386803&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7d657795-c4a6-469c-9255-de09f1985b99\', \'multiverseId\': 386803}, \'multiverseid\': 386803}, {\'name\': \'反抗技藝\', \'text\': \'在目標由你操控的生物上放置一個+1/+1指示物。選擇一種顏色。該生物獲得反該色保護異能直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'雖然龍已在韃契絕跡，但其堅忍仍得見於阿布贊的魔法之中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387072&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b176ddf-6f5e-4307-8d74-2b4de0c9a27c\', \'multiverseId\': 387072}, \'multiverseid\': 387072}]', "[{'name': 'Tausend Winde', 'text': 'Fliegend\\nMorph {5}{U}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn Tausend Winde aufgedeckt wird, bringe alle anderen getappten Kreaturen auf die Hand ihrer Besitzer zurück.', 'type': 'Kreatur — Elementarwesen', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387504&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7f9a650b-8994-49c6-a4e3-0c990acc4aaf', 'multiverseId': 387504}, 'multiverseid': 387504}, {'name': 'Mil vientos', 'text': 'Vuela.\\nMetamorfosis {5}{U}{U}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Mil vientos se ponga boca arriba, regresa todas las otras criaturas giradas a las manos de sus propietarios.', 'type': 'Criatura — Elemental', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389387&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd1c6b209-4999-4ade-84f9-cb348fcf2b73', 'multiverseId': 389387}, 'multiverseid': 389387}, {'name': 'Mille vents', 'text': 'Vol\\nMue {5}{U}{U} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand les Mille vents sont retournés face visible, renvoyez toutes les autres créatures engagées dans les mains de leurs propriétaires.', 'type': 'Créature : élémental', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387773&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1a2725ea-0314-4551-9ef6-dcd03722e53c', 'multiverseId': 387773}, 'multiverseid': 387773}, {'name': 'Mille Venti', 'text': 'Volare\\nMetamorfosi {5}{U}{U} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando il Mille Venti viene girato a faccia in su, fai tornare tutte le altre creature TAPpate in mano ai rispettivi proprietari.', 'type': 'Creatura — Elementale', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388042&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b7bc7099-8d3c-46c9-9f94-6b2b7a667e40', 'multiverseId': 388042}, 'multiverseid': 388042}, {'name': '千の風', 'text': '飛行\\n変異{5}{U}{U}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n千の風が表向きになったとき、他のタップ状態のクリーチャーをすべてオーナーの手札に戻す。', 'type': 'クリーチャー — エレメンタル', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388311&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '049149ff-62b0-40f7-822a-2b4bc44dc3bd', 'multiverseId': 388311}, 'multiverseid': 388311}, {'name': '천 개의 바람', 'text': '비행\\n변이 {5}{U}{U} (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\\n천 개의 바람이 앞면으로 뒤집히면, 다른 모든 탭된 생물들을 소유자의 손으로 되돌린다.', 'type': '생물 — 정령', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388580&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e7faa74f-5c8a-4956-a922-a24288b98338', 'multiverseId': 388580}, 'multiverseid': 388580}, {'name': 'Mil Ventos', 'text': 'Voar\\nMetamorfose {5}{U}{U} (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Mil Ventos for voltado para cima, devolva todas as outras criaturas viradas para as mãos de seus donos.', 'type': 'Criatura — Elemental', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388849&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3e0c4fbe-da30-45e0-8d03-b4164e3e80d7', 'multiverseId': 388849}, 'multiverseid': 388849}, {'name': 'Тысяча Ветров', 'text': 'Полет\\nОборотень {5}{U}{U} (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\\nКогда Тысяча Ветров переворачивается рубашкой вниз, верните все другие повернутые существа в руки их владельцев.', 'type': 'Существо — Элементаль', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389118&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f24c51c8-73d0-4474-8a49-c94bef7eead8', 'multiverseId': 389118}, 'multiverseid': 389118}, {'name': '千风灵', 'text': '飞行\\n变身{5}{U}{U}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当千风灵翻回正面时，将所有其他已横置的生物移回其拥有者手上。', 'type': '生物～元素', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386966&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5f0a003a-15c6-4664-a057-6115cb1a2102', 'multiverseId': 386966}, 'multiverseid': 386966}, {'name': '千風靈', 'text': '飛行\\n變身{5}{U}{U}（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\\n當千風靈翻回正面時，將所有其他已橫置的生物移回其擁有者手上。', 'type': '生物～元素', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387235&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7a6633b2-035e-40c3-8b58-f2debcd07754', 'multiverseId': 387235}, 'multiverseid': 387235}]", '[{\'name\': \'Temur-Amulett\', \'text\': \'Bestimme eines —\\n• Eine Kreatur deiner Wahl, die du kontrollierst, erhält +1/+1 bis zum Ende des Zuges. Sie kämpft gegen eine Kreatur deiner Wahl, die du nicht kontrollierst.\\n• Neutralisiere einen Zauberspruch deiner Wahl, falls sein Beherrscher nicht {3} bezahlt.\\n• Kreaturen mit Stärke 3 oder weniger können in diesem Zug nicht blocken.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387502&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d327d467-8609-43a1-9849-fc1439365032\', \'multiverseId\': 387502}, \'multiverseid\': 387502}, {\'name\': \'Sortilegio temur\', \'text\': \'Elige uno:\\n• La criatura objetivo que controlas obtiene +1/+1 hasta el final del turno. Esa criatura lucha contra la criatura objetivo que no controlas.\\n• Contrarresta el hechizo objetivo a menos que su controlador pague {3}.\\n• Las criaturas con fuerza de 3 o menos no pueden bloquear este turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389385&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'12897272-fb5a-43e6-9900-3f10b8246998\', \'multiverseId\': 389385}, \'multiverseid\': 389385}, {\'name\': \'Charme de Temur\', \'text\': "Choisissez l\'un —\\n• Une créature ciblée que vous contrôlez gagne +1/+1 jusqu\'à la fin du tour. Elle se bat contre une créature ciblée que vous ne contrôlez pas.\\n• Contrecarrez le sort ciblé à moins que son contrôleur ne paie {3}.\\n• Les créatures avec une force inférieure ou égale à 3 ne peuvent pas bloquer ce tour-ci.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387771&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'498c6446-1be0-4637-b5e7-85b826e39f1a\', \'multiverseId\': 387771}, \'multiverseid\': 387771}, {\'name\': \'Talismano Temur\', \'text\': \'Scegli uno —\\n• Una creatura bersaglio che controlli prende +1/+1 fino alla fine del turno. Lotta con una creatura bersaglio che non controlli.\\n• Neutralizza una magia bersaglio a meno che il suo controllore non paghi {3}.\\n• Le creature con forza pari o inferiore a 3 non possono bloccare in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388040&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56014552-9fc4-4a7b-8604-34c6b9df0716\', \'multiverseId\': 388040}, \'multiverseid\': 388040}, {\'name\': \'ティムールの魔除け\', \'text\': \'以下から１つを選ぶ。\\n・あなたがコントロールするクリーチャー１体と、あなたがコントロールしていないクリーチャー１体を対象とする。ターン終了時まで、その前者は＋１/＋１の修整を受ける。その前者はその後者と格闘を行う。\\n・呪文１つを対象とする。それのコントローラーが{3}を支払わないかぎり、それを打ち消す。\\n・このターン、パワーが３以下のクリーチャーではブロックできない。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388309&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'840a4688-60af-4b70-9d0d-5b26cac01408\', \'multiverseId\': 388309}, \'multiverseid\': 388309}, {\'name\': \'테무르 부적\', \'text\': \'하나를 선택한다 —\\n• 당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받는다. 당신이 조종하지 않는 생물을 목표로 정한다. 그 두 생물은 서로 싸운다.\\n• 주문을 목표로 정한다. 그 주문의 조종자가 {3}을 지불하지 않으면 그 주문을 무효화한다.\\n• 공격력이 3 이하인 생물들은 이 턴에 방어할 수 없다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388578&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b9a3fd20-5155-4c01-aefa-b84b24d34bb3\', \'multiverseId\': 388578}, \'multiverseid\': 388578}, {\'name\': \'Amuleto Temur\', \'text\': \'Escolha um —\\n• A criatura alvo que você controla recebe +1/+1 até o final do turno. Ela luta com a criatura alvo que você não controla.\\n• Anule a mágica alvo, a menos que seu controlador pague {3}.\\n• As criaturas com poder menor ou igual a 3 não podem bloquear neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388847&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6b100e3-0f44-4cca-be51-0bca65da71b8\', \'multiverseId\': 388847}, \'multiverseid\': 388847}, {\'name\': \'Талисман Темура\', \'text\': \'Выберите одно —\\n• Целевое существо под вашим контролем получает +1/+1 до конца хода. Оно дерется с целевым существом не под вашим контролем.\\n• Отмените целевое заклинание, если только контролирующий его игрок не заплатит {3}.\\n• Существа с силой 3 или меньше не могут блокировать в этом ходу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389116&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a095ffd1-2d59-4d23-b61e-ce9f0ac05df5\', \'multiverseId\': 389116}, \'multiverseid\': 389116}, {\'name\': \'铁木尔护符\', \'text\': \'选择一项～\\n•目标由你操控的生物得+1/+1直到回合结束。它与目标不由你操控的生物互斗。\\n•除非目标咒语的操控者支付{3}，否则反击之。\\n•力量等于或小于3的生物本回合不能进行阻挡。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386964&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54e2a857-d5f6-4bd9-af61-8320ac926d93\', \'multiverseId\': 386964}, \'multiverseid\': 386964}, {\'name\': \'鐵木爾護符\', \'text\': \'選擇一項～\\n•目標由你操控的生物得+1/+1直到回合結束。它與目標不由你操控的生物互鬥。\\n•除非目標咒語的操控者支付{3}，否則反擊之。\\n•力量等於或小於3的生物本回合不能進行阻擋。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387233&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'24d2d469-4ff5-45e7-9929-3628afe31824\', \'multiverseId\': 387233}, \'multiverseid\': 387233}]', '[{\'name\': \'Temur-Streitross\', \'text\': \'Morph—Zeige eine grüne Karte auf deiner Hand offen vor. (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn das Temur-Streitross aufgedeckt wird, verursacht eine Kreatur deiner Wahl Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Pferd\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9a83842-57e0-4b93-81d9-1eb29060833e\', \'multiverseId\': 387501}, \'multiverseid\': 387501}, {\'name\': \'Acometedor temur\', \'text\': \'Metamorfosis—Muestra una carta verde de tu mano. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Acometedor temur se ponga boca arriba, la criatura objetivo gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Caballo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389384&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e1bdae6-3a94-45de-9958-70c9647dbbce\', \'multiverseId\': 389384}, \'multiverseid\': 389384}, {\'name\': \'Batailleur temurien\', \'text\': "Mue — Révélez une carte verte de votre main. (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand le Batailleur temurien est retourné face visible, la créature ciblée acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : cheval\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387770&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d4328e6-be9c-4c81-b468-8044384abf85\', \'multiverseId\': 387770}, \'multiverseid\': 387770}, {\'name\': \'Destriero Temur\', \'text\': \'Metamorfosi—Rivela una carta verde dalla tua mano. (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando il Destriero Temur viene girato a faccia in su, una creatura bersaglio ha travolgere fino alla fine del turno.\', \'type\': \'Creatura — Cavallo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388039&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9bb00ae-981e-4bea-930d-141bc8cd7ec1\', \'multiverseId\': 388039}, \'multiverseid\': 388039}, {\'name\': \'ティムールの軍馬\', \'text\': \'変異 ― あなたの手札にある緑のカードを１枚公開する。（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\nティムールの軍馬が表向きになったとき、クリーチャー１体を対象とする。ターン終了時まで、それはトランプルを得る。\', \'type\': \'クリーチャー — 馬\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388308&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e829ac82-af4a-4583-ab4b-227151b2704b\', \'multiverseId\': 388308}, \'multiverseid\': 388308}, {\'name\': \'테무르 군마\', \'text\': \'변이—당신의 손에서 녹색 카드 한 장을 공개한다. (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\\n테무르 군마가 앞면으로 뒤집히면, 생물을 목표로 정한다. 그 생물은 턴종료까지 돌진을 얻는다.\', \'type\': \'생물 — 말\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388577&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a56d3957-b536-43df-a70f-28a9ea1705ec\', \'multiverseId\': 388577}, \'multiverseid\': 388577}, {\'name\': \'Corcel Temur\', \'text\': \'Metamorfose — Revele um card verde na sua mão. (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Corcel Temur é voltado para cima, a criatura alvo ganha atropelar até o final do turno.\', \'type\': \'Criatura — Cavalo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388846&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c6070b5-7fe7-4726-a787-fb99bc40af76\', \'multiverseId\': 388846}, \'multiverseid\': 388846}, {\'name\': \'Темурский Скакун\', \'text\': \'Оборотень — Покажите зеленую карту, находящуюся в вашей руке. (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\\nКогда Темурский Скакун переворачивается рубашкой вниз, целевое существо получает Пробивной удар до конца хода.\', \'type\': \'Существо — Лошадь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389115&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'11d03c2f-fa53-4aab-95ea-5f19551d20c0\', \'multiverseId\': 389115}, \'multiverseid\': 389115}, {\'name\': \'铁木尔战马\', \'text\': \'变身～从你手上展示一张绿色牌。（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当铁木尔战马翻回正面时，目标生物获得践踏异能直到回合结束。\', \'type\': \'生物～马\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386963&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'350a8cc3-7c18-4edd-8f03-a90c4b2e6a49\', \'multiverseId\': 386963}, \'multiverseid\': 386963}, {\'name\': \'鐵木爾戰馬\', \'text\': \'變身～從你手上展示一張綠色牌。（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\\n當鐵木爾戰馬翻回正面時，目標生物獲得踐踏異能直到回合結束。\', \'type\': \'生物～馬\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387232&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'66d618bb-ba99-4c1d-80cf-57cd28befca1\', \'multiverseId\': 387232}, \'multiverseid\': 387232}]', '[{\'name\': \'Todesrausch\', \'text\': \'Alle Kreaturen erhalten -2/-2 bis zum Ende des Zuges. Immer wenn eine Kreatur in diesem Zug stirbt, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Die fauligen Rachen der Krokodile schlucken alles außer den Schreien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387320&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b799533-13c8-4e3d-aa1e-2864f107e68c\', \'multiverseId\': 387320}, \'multiverseid\': 387320}, {\'name\': \'Frenesí de muerte\', \'text\': \'Todas las criaturas obtienen -2/-2 hasta el final del turno. Siempre que una criatura muera este turno, ganas 1 vida.\', \'type\': \'Conjuro\', \'flavor\': \'Las pútridas mandíbulas de los cocodrilos se lo tragan todo, excepto los alaridos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389203&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5cec5095-7ac3-479e-b4a9-9db274d4bcd9\', \'multiverseId\': 389203}, \'multiverseid\': 389203}, {\'name\': \'Frénésie meurtrière\', \'text\': "Toutes les créatures gagnent -2/-2 jusqu\'à la fin du tour. À chaque fois qu\'une créature meurt ce tour-ci, vous gagnez 1 point de vie.", \'type\': \'Rituel\', \'flavor\': \'Seuls les cris ne sont pas dévorés par les mâchoires putrides des crocodiles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387589&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'47da8d0c-83b0-4515-850a-c6f8201dd4ce\', \'multiverseId\': 387589}, \'multiverseid\': 387589}, {\'name\': \'Frenesia di Morte\', \'text\': \'Tutte le creature prendono -2/-2 fino alla fine del turno. Ogniqualvolta una creatura muore in questo turno, guadagni 1 punto vita.\', \'type\': \'Stregoneria\', \'flavor\': \'Le fauci putride dei coccodrilli ingoiano tutto, tranne le urla.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387858&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8fb770a0-2b73-4a29-9cab-cb6520f57463\', \'multiverseId\': 387858}, \'multiverseid\': 387858}, {\'name\': \'死の激情\', \'text\': \'ターン終了時まで、すべてのクリーチャーは－２/－２の修整を受ける。このターン、クリーチャーが１体死亡するたび、あなたは１点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'クロコダイルたちの朽ちゆく顎は、叫び声以外のすべてを飲み込む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388127&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1811104c-2b1d-4acb-83d7-b5f69efefb47\', \'multiverseId\': 388127}, \'multiverseid\': 388127}, {\'name\': \'살인의 광분\', \'text\': \'모든 생물은 턴종료까지 -2/-2를 받는다. 이 턴에 생물이 죽을 때마다, 당신은 생명 1점을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'그 악어의 구역질 나는 아가리는 비명을 제외한 모든 것을 삼킨다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388396&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8da6d444-17e7-4f17-b7df-ece56609a363\', \'multiverseId\': 388396}, \'multiverseid\': 388396}, {\'name\': \'Frenesi da Morte\', \'text\': \'Todas as criaturas recebem -2/-2 até o final do turno. Toda vez que uma criatura morre neste turno, você ganha 1 ponto de vida.\', \'type\': \'Feitiço\', \'flavor\': \'As mandíbulas pútridas dos crocodilos engolem tudo, menos os gritos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388665&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d75cbe9-9b40-44f9-9ddb-a3171d83a9f4\', \'multiverseId\': 388665}, \'multiverseid\': 388665}, {\'name\': \'Бешенство Смерти\', \'text\': \'Все существа получают -2/-2 до конца хода. Каждый раз, когда существо умирает в этом ходу, вы получаете 1 жизнь.\', \'type\': \'Волшебство\', \'flavor\': \'В зловонных глотках крокодилов исчезает все, кроме криков.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388934&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c89efea-08a9-4dfa-881e-bc69af8fe6ca\', \'multiverseId\': 388934}, \'multiverseid\': 388934}, {\'name\': \'死亡狂热\', \'text\': \'所有生物得-2/-2直到回合结束。本回合中，每当一个生物死去时，你获得1点生命。\', \'type\': \'法术\', \'flavor\': \'鳄鱼的腐臭巨口吞噬一切，空余惨叫回荡。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386782&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46d63416-24f6-42fe-b5f2-a2a18e84d9b0\', \'multiverseId\': 386782}, \'multiverseid\': 386782}, {\'name\': \'死亡狂熱\', \'text\': \'所有生物得-2/-2直到回合結束。本回合中，每當一個生物死去時，你獲得1點生命。\', \'type\': \'巫術\', \'flavor\': \'鱷魚的腐臭巨口吞噬一切，空餘慘叫迴盪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387051&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'20f4da65-844d-4fd1-9713-9202a220c8a7\', \'multiverseId\': 387051}, \'multiverseid\': 387051}]', '[{\'name\': \'Todesschuss\', \'text\': \'Zerstöre eine angreifende Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Bogenschützen der Mardu üben sich in Dakla, dem Weg des Bogens. Sie verfehlen ihr Ziel nie, egal wie klein, wie schnell oder wie fern es ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387389&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'87328b96-a325-46fe-b92d-482fce68cc99\', \'multiverseId\': 387389}, \'multiverseid\': 387389}, {\'name\': \'Disparo mortífero\', \'text\': \'Destruye la criatura atacante objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Los arqueros mardu estudian el dakla, la sabiduría del arco. Nunca fallan su objetivo: grande o pequeño, lento o veloz, próximo o lejano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71f6815d-d4fd-4ab8-b09b-26ea270ab512\', \'multiverseId\': 389272}, \'multiverseid\': 389272}, {\'name\': \'Tir mortel\', \'text\': \'Détruisez la créature attaquante ciblée.\', \'type\': \'Éphémère\', \'flavor\': "Les archers marduens pratiquent le Dakla, la voie de l\'arc. Ils ne manquent jamais leur cible, quelle que soit sa taille, sa vitesse ou sa distance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387658&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4a89e3c-bf9b-40b7-8af6-02e31c000c49\', \'multiverseId\': 387658}, \'multiverseid\': 387658}, {\'name\': \'Scoccata Letale\', \'text\': \'Distruggi una creatura attaccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Gli arcieri Mardu praticano il Dakla, la via dell\'arco. Non mancano mai il bersaglio, per quanto possa essere minuscolo, rapido o distante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387927&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'976437b6-a002-4e84-838d-b1d111ab8947\', \'multiverseId\': 387927}, \'multiverseid\': 387927}, {\'name\': \'必殺の一射\', \'text\': \'攻撃クリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'マルドゥの射手たちはダクラ式弓術を習得している。それがどれだけ小さく、どれだけ速く、どれだけ遠くにあっても、彼らは狙った的を外すことはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388196&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f478e8b1-d2d2-49ba-843e-75bd86dda217\', \'multiverseId\': 388196}, \'multiverseid\': 388196}, {\'name\': \'절명의 사격\', \'text\': \'공격생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'마르두 궁수들은 다클라라는 궁도에 따라 훈련을 받는다. 표적의 크기와 속도, 거리에 상관없이 백발백중을 자랑한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388465&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8f589861-7b68-44c2-af60-a03587fd67dc\', \'multiverseId\': 388465}, \'multiverseid\': 388465}, {\'name\': \'Tiro Mortal\', \'text\': \'Destrua a criatura alvo atacante.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os arqueiros Mardu são treinados no Dakla, o caminho do arco. Eles nunca erram o alvo, não importa o quão pequeno, o quão rápido ou o quão distante esteja.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388734&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42e0fe0a-fb51-492f-9b8e-4945f570aeee\', \'multiverseId\': 388734}, \'multiverseid\': 388734}, {\'name\': \'Смертельный Выстрел\', \'text\': \'Уничтожьте целевое атакующее существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Лучники Марду владеют искусством Дакла — мастерством стрельбы из лука. Они никогда не промахиваются мимо цели, как бы мала, стремительна или далека она ни была.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389003&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f454aca6-fd04-40de-a2cd-c22e3605d8b8\', \'multiverseId\': 389003}, \'multiverseid\': 389003}, {\'name\': \'致命箭矢\', \'text\': \'消灭目标进行攻击的生物。\', \'type\': \'瞬间\', \'flavor\': \'玛尔都弓箭手的驭弓之道称为巫箭流。不论多小、多快、多远的目标，他们都不会失手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386851&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab032c56-b1e7-4da5-8b3c-6beb2a1bca12\', \'multiverseId\': 386851}, \'multiverseid\': 386851}, {\'name\': \'致命箭矢\', \'text\': \'消滅目標進行攻擊的生物。\', \'type\': \'瞬間\', \'flavor\': \'瑪爾都弓箭手的馭弓之道稱為巫箭流。不論多小、多快、多遠的目標，他們都不會失手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387120&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dcf46fc4-2b87-409d-83af-9f99397a7227\', \'multiverseId\': 387120}, \'multiverseid\': 387120}]', '[{\'name\': \'Treuschwingen-Roc\', \'text\': \'Fliegend\\nÜberfall — Wenn der Treuschwingen-Roc ins Spiel kommt und falls du in diesem Zug mit mindestens einer Kreatur angegriffen hast, bringe einen 3/4 weißen Vogel-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\\nImmer wenn der Treuschwingen-Roc angreift, erhältst du für jede angreifende Kreatur 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387533&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'795fc613-4df7-404a-8d05-8e2d4f2ddc2f\', \'multiverseId\': 387533}, \'multiverseid\': 387533}, {\'name\': \'Volañera roc\', \'text\': \'Vuela.\\nIncursión — Cuando la Volañera roc entre al campo de batalla, si atacaste con una criatura este turno, pon en el campo de batalla una ficha de criatura Ave blanca 3/4 con la habilidad de volar.\\nSiempre que la Volañera roc ataque, ganas 1 vida por cada criatura atacante.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389416&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'119c4372-68dd-4475-989f-0ee1c15f7876\', \'multiverseId\': 389416}, \'multiverseid\': 389416}, {\'name\': \'Rokh compagnon\', \'text\': \'Vol\\nSaccage — Quand le Rokh compagnon arrive sur le champ de bataille, si vous avez attaqué avec une créature ce tour-ci, mettez sur le champ de bataille un jeton de créature 3/4 blanche Oiseau avec le vol.\\nÀ chaque fois que le Rokh compagnon attaque, vous gagnez 1 point de vie pour chaque créature attaquante.\', \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387802&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7560f6f1-1333-4e44-a1cc-6b366a813b0d\', \'multiverseId\': 387802}, \'multiverseid\': 387802}, {\'name\': "Roc Compagna d\'Ala", \'text\': "Volare\\nIncursione — Quando la Roc Compagna d\'Ala entra nel campo di battaglia, se hai attaccato con una creatura in questo turno, metti sul campo di battaglia una pedina creatura Uccello 3/4 bianca con volare.\\nOgniqualvolta la Roc Compagna d\'Ala attacca, guadagni 1 punto vita per ogni creatura attaccante.", \'type\': \'Creatura — Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388071&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'98bfaa0e-ebe0-4602-b574-29d57254334a\', \'multiverseId\': 388071}, \'multiverseid\': 388071}, {\'name\': \'風番いのロック\', \'text\': \'飛行\\n強襲 ― 風番いのロックが戦場に出たとき、このターンにあなたがクリーチャーで攻撃していた場合、飛行を持つ白の３/４の鳥・クリーチャー・トークンを１体戦場に出す。\\n風番いのロックが攻撃するたび、あなたは攻撃クリーチャー１体につき１点のライフを得る。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e7a13b5-caf3-4ed0-ae7f-e7332cc0f0f1\', \'multiverseId\': 388340}, \'multiverseid\': 388340}, {\'name\': \'짝비행 로크\', \'text\': \'비행\\n습격 — 짝비행 로크가 전장에 들어올 때, 당신이 이 턴에 생물로 공격했다면 비행을 가진 3/4 백색 조류 생물 토큰 한 개를 전장에 놓는다.\\n짝비행 로크가 공격할 때마다, 당신은 공격생물 한 개당 생명 1점을 얻는다.\', \'type\': \'생물 — 조류\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388609&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4e898522-97ce-4353-8023-9c51943a44e6\', \'multiverseId\': 388609}, \'multiverseid\': 388609}, {\'name\': \'Roca do Voo Duplo\', \'text\': \'Voar\\nRaide — Quando Roca do Voo Duplo entrar no campo de batalha, se você atacou com uma criatura neste turno, coloque no campo de batalha uma ficha de criatura branca 3/4 do tipo Ave com voar.\\nToda vez que Roca do Voo Duplo ataca, você ganha 1 ponto de vida para cada criatura atacante.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388878&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b28b19f-a437-413e-8c76-a1f7278e6ed8\', \'multiverseId\': 388878}, \'multiverseid\': 388878}, {\'name\': \'Рок, Крылатый Собрат\', \'text\': \'Полет\\nНабег — Когда Рок, Крылатый Собрат выходит на поле битвы, если в этом ходу вы атаковали существом, положите на поле битвы одну фишку существа 3/4 белая Птица с Полетом.\\nКаждый раз, когда Рок, Крылатый Собрат атакует, вы получаете 1 жизнь за каждое атакующее существо.\', \'type\': \'Существо — Птица\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389147&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'785e7b11-b1ab-409d-8ace-13038d4e4ee8\', \'multiverseId\': 389147}, \'multiverseid\': 389147}, {\'name\': \'翼伴洛克鸟\', \'text\': \'飞行\\n突击～当翼伴洛克鸟进战场时，若你于本回合中曾以生物攻击，则将一个3/4白色，具飞行异能的鸟衍生生物放进战场。\\n每当翼伴洛克鸟攻击时，每有一个进行攻击的生物，你便获得1点生命。\', \'type\': \'生物～鸟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386995&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'24549c51-fe97-4303-9c2b-4451db2c43e6\', \'multiverseId\': 386995}, \'multiverseid\': 386995}, {\'name\': \'翼伴洛克鳥\', \'text\': \'飛行\\n突擊～當翼伴洛克鳥進戰場時，若你於本回合中曾以生物攻擊，則將一個3/4白色，具飛行異能的鳥衍生生物放進戰場。\\n每當翼伴洛克鳥攻擊時，每有一個進行攻擊的生物，你便獲得1點生命。\', \'type\': \'生物～鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387264&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f68f7374-fa01-445b-bd79-0acc756d49cf\', \'multiverseId\': 387264}, \'multiverseid\': 387264}]', '[{\'name\': \'Tristes Gewässer\', \'text\': \'Das Triste Gewässer kommt getappt ins Spiel.\\nWenn das Triste Gewässer ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387327&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a8febc3-90e4-4a23-bf5c-470dd2d39d9a\', \'multiverseId\': 387327}, \'multiverseid\': 387327}, {\'name\': \'Laguna lúgubre\', \'text\': \'La Laguna lúgubre entra al campo de batalla girada.\\nCuando la Laguna lúgubre entre al campo de batalla, ganas 1 vida.\\n{T}: Agrega {U} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389210&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d32e37b-d250-442c-9ad5-21ec0b26c7f3\', \'multiverseId\': 389210}, \'multiverseid\': 389210}, {\'name\': \'Marigot lugubre\', \'text\': \'Le Marigot lugubre arrive sur le champ de bataille engagé.\\nQuand le Marigot lugubre arrive sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {U} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387596&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'713d984e-6b55-4438-b06c-562dd187f7f5\', \'multiverseId\': 387596}, \'multiverseid\': 387596}, {\'name\': \'Acquitrino Tetro\', \'text\': "L\'Acquitrino Tetro entra nel campo di battaglia TAPpato.\\nQuando l\'Acquitrino Tetro entra nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {U} o {B} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387865&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4086653a-8f96-4dd6-a68d-3f241b807fcf\', \'multiverseId\': 387865}, \'multiverseid\': 387865}, {\'name\': \'陰鬱な僻地\', \'text\': \'陰鬱な僻地はタップ状態で戦場に出る。\\n陰鬱な僻地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388134&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'276971dc-c9dd-4466-bc7b-b33635950a42\', \'multiverseId\': 388134}, \'multiverseid\': 388134}, {\'name\': \'음침한 소류\', \'text\': \'음침한 소류는 탭된 채로 전장에 들어온다.\\n음침한 소류가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {U} 또는 {B}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388403&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c4af54d9-3f9f-4361-8e2b-c428442d9b64\', \'multiverseId\': 388403}, \'multiverseid\': 388403}, {\'name\': \'Remanso Funesto\', \'text\': \'Remanso Funesto entra no campo de batalha virado.\\nQuando Remanso Funesto entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {U} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388672&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62796c79-bb65-4e47-845f-2f85faaf8ac3\', \'multiverseId\': 388672}, \'multiverseid\': 388672}, {\'name\': \'Мрачная Заводь\', \'text\': \'Мрачная Заводь выходит на поле битвы повернутой.\\nКогда Мрачная Заводь выходит на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {U} или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388941&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4c82ebec-4731-4d05-abde-4571e880195d\', \'multiverseId\': 388941}, \'multiverseid\': 388941}, {\'name\': \'阴沉死水\', \'text\': \'阴沉死水须横置进战场。\\n当阴沉死水进战场时，你获得1点生命。\\n{T}：加{U}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386789&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2402fc8-e0f3-4665-af97-f478480b6b2f\', \'multiverseId\': 386789}, \'multiverseid\': 386789}, {\'name\': \'陰沉死水\', \'text\': \'陰沉死水須橫置進戰場。\\n當陰沉死水進戰場時，你獲得1點生命。\\n{T}：加{U}或{B}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387058&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9a3487ad-fe6a-47af-a6a6-49a934606ac1\', \'multiverseId\': 387058}, \'multiverseid\': 387058}]', '[{\'name\': \'Trompetenstoß\', \'text\': \'Angreifende Kreaturen erhalten +2/+0 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Hörst du das, Sarkhan? Die Herrlichkeit der Horde! Was du aufgegeben hast, habe ich in eine Legende verwandelt." —Zurgo, Khan der Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387513&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'850de87a-15b0-4af0-bb98-9ad7c1f56ae0\', \'multiverseId\': 387513}, \'multiverseid\': 387513}, {\'name\': \'Trompetazo\', \'text\': \'Las criaturas atacantes obtienen +2/+0 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Oyes eso, Sarkhan? ¡Es la gloria de la horda! Convertí en leyenda aquello que tú abandonaste". —Zurgo, kan de los Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389396&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0ed670aa-22e8-4291-ab6f-153d0f969680\', \'multiverseId\': 389396}, \'multiverseid\': 389396}, {\'name\': \'Sonnerie de trompe\', \'text\': "Les créatures attaquantes gagnent +2/+0 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "« Entends-tu, Sarkhan ? C\'est la gloire de la horde ! J\'ai transformé en légende ce que tu as abandonné. » —Zurgo, khan des Mardu", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387782&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'003d3267-53e8-43a9-b2d9-dbe4b6b17a4d\', \'multiverseId\': 387782}, \'multiverseid\': 387782}, {\'name\': \'Squillo di Trombe\', \'text\': \'Le creature attaccanti prendono +2/+0 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"La senti, Sarkhan? È la gloria dell\\\'orda! Ho preso ciò che tu hai abbandonato e ne ho fatto leggenda." —Zurgo, khan dei Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388051&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39307f31-2b3c-4d0a-8641-9e0e70ddd75a\', \'multiverseId\': 388051}, \'multiverseid\': 388051}, {\'name\': \'ラッパの一吹き\', \'text\': \'ターン終了時まで、攻撃クリーチャーは＋２/＋０の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「サルカンよ、あれが聞こえるか？我が軍族に栄光あれ！お前が見限ったものから、俺は伝説を創りあげたのだ。」 ――マルドゥのカン、ズルゴ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388320&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2b67d664-cf2d-4ec8-8850-1a8cf004a99d\', \'multiverseId\': 388320}, \'multiverseid\': 388320}, {\'name\': \'뿔나팔 소리\', \'text\': \'공격생물들은 턴종료까지 +2/+0을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'"사르칸! 부족의 승리를 의미하는 저 소리가 들리는가! 나는 네가 버린 것으로 전설을 이룩했다." —마르두의 칸 주르고\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388589&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e71eaab0-0c7b-48c9-ba7e-c446ad460c6a\', \'multiverseId\': 388589}, \'multiverseid\': 388589}, {\'name\': \'Soar da Trombeta\', \'text\': \'As criaturas atacantes recebem +2/+0 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Está ouvindo isso, Sarkhan? A glória da horda! Eu criei uma lenda daquilo que você abandonou." — Zurgo, khan dos Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388858&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d780df87-e459-4fb9-9411-61fefadd6284\', \'multiverseId\': 388858}, \'multiverseid\': 388858}, {\'name\': \'Звук Трубы\', \'text\': \'Атакующие существа получают +2/+0 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ты слышишь, Сархан? Это трубят славу моей орде! Я сделал легенду из того, что ты бросил». — Зурго, хан Марду\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389127&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4e40107-e1e9-45c4-a97d-ff59380dcd74\', \'multiverseId\': 389127}, \'multiverseid\': 389127}, {\'name\': \'号角震天\', \'text\': \'进行攻击的生物得+2/+0直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「萨坎，你听到了吗？这是部落的荣耀！我从你放弃的东西中创造了传奇。」 ～玛尔都可汗珠高\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386975&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb183d31-9beb-4f01-80c0-52eddcc01b20\', \'multiverseId\': 386975}, \'multiverseid\': 386975}, {\'name\': \'號角震天\', \'text\': \'進行攻擊的生物得+2/+0直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「薩坎，你聽到了嗎？這是部落的榮耀！我從你放棄的東西中創造了傳奇。」 ～瑪爾都可汗珠高\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387244&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'31fe0309-6188-46e5-b1a9-ee5fd6ddc1ae\', \'multiverseId\': 387244}, \'multiverseid\': 387244}]', '[{\'name\': \'Trutziger Schlag\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+0 bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Stellt euch auf, wo euch das ganze Schlachtfeld sehen kann. Schlagt so zu, dass sie es nie vergessen werden." —Anafenza, Khan der Abzan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387322&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad5a3887-d3a2-4265-8839-016589968a6f\', \'multiverseId\': 387322}, \'multiverseid\': 387322}, {\'name\': \'Golpe desafiante\', \'text\': \'La criatura objetivo obtiene +1/+0 hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Sitúate donde todos los combatientes te vean. Ataca de forma que jamás lo olviden". —Anafenza, kan de los Abzan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389205&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5f422fa-69ee-47d5-8631-bd7ed406a8fb\', \'multiverseId\': 389205}, \'multiverseid\': 389205}, {\'name\': \'Frappe provocatrice\', \'text\': "La créature ciblée gagne +1/+0 jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "« Tiens-toi là où tous les combattants pourront te voir. Et frappe afin qu\'ils n\'oublient jamais. » —Anafenza, khan des Abzans", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387591&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0c7ef3c-65be-4644-8fcd-631ec67d686c\', \'multiverseId\': 387591}, \'multiverseid\': 387591}, {\'name\': \'Colpo Sprezzante\', \'text\': \'Una creatura bersaglio prende +1/+0 fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ergiti così che l\\\'intero campo di battaglia possa vederti. Colpisci così che nessuno possa mai dimenticare." —Anafenza, khan degli Abzan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387860&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec834833-619d-4857-89e1-7f59b80d5b71\', \'multiverseId\': 387860}, \'multiverseid\': 387860}, {\'name\': \'果敢な一撃\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受ける。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「戦場にいる者すべてから見える場所に立て。そして全員が忘れぬような一撃を振るえ。」 ――アブザンのカン、アナフェンザ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388129&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55e0c212-08a3-4f95-ac66-04d89ace1845\', \'multiverseId\': 388129}, \'multiverseid\': 388129}, {\'name\': \'반항의 일격\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받는다.\\n카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"전 병력이 너를 볼 수 있는 장소에 서서 절대 잊지 못할 일격을 내리쳐라." —아브잔의 칸 아나펜자\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388398&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e4d966cc-9d9b-4a98-b2a0-90e33159583a\', \'multiverseId\': 388398}, \'multiverseid\': 388398}, {\'name\': \'Golpe Desafiador\', \'text\': \'A criatura alvo recebe +1/+0 até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Fique onde todos na batalha possam vê-lo. Ataque de modo que eles nunca se esqueçam." — Anafenza, khan dos Abzan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388667&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'edb21614-5f93-48fd-81c6-4e0ee0824e88\', \'multiverseId\': 388667}, \'multiverseid\': 388667}, {\'name\': \'Дерзкий Удар\', \'text\': \'Целевое существо получает +1/+0 до конца хода.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Стой там, где все сражающиеся увидят тебя. Бей так, чтобы это запомнили навсегда». — Анафенза, хан Абзана\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388936&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0199af7-2aec-464f-ac2c-02c1ede67681\', \'multiverseId\': 388936}, \'multiverseid\': 388936}, {\'name\': \'无畏挥击\', \'text\': \'目标生物得+1/+0直到回合结束。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「于战场中心奋勇拼杀。让敌人闻风丧胆。」 ～阿布赞可汗阿娜芬札\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386784&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'181f7093-e689-49c2-be5b-150d43342d4f\', \'multiverseId\': 386784}, \'multiverseid\': 386784}, {\'name\': \'無畏揮擊\', \'text\': \'目標生物得+1/+0直到回合結束。\\n抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「於戰場中心奮勇拼殺。讓敵人聞風喪膽。」 ～阿布贊可汗阿娜芬札\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387053&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dde1a748-50bd-468b-bd6b-94a6c809d6ba\', \'multiverseId\': 387053}, \'multiverseid\': 387053}]', '[{\'name\': \'Ugins Nexus\', \'text\': \'Falls ein Spieler einen zusätzlichen Zug beginnen würde, überspringt er stattdessen diesen Zug.\\nFalls Ugins Nexus aus dem Spiel auf einen Friedhof gelegt würde, schicke ihn stattdessen ins Exil und du erhältst nach diesem Zug einen zusätzlichen Zug.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'Auf einmal verstummte die Stimme in Sarkhans Kopf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387516&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c29d914-70d1-413b-bacb-812319b33321\', \'multiverseId\': 387516}, \'multiverseid\': 387516}, {\'name\': \'Nexo de Ugin\', \'text\': \'Si un jugador fuera a comenzar un turno adicional, en vez de eso, ese jugador se salta ese turno.\\nSi el Nexo de Ugin fuera a ser puesto en un cementerio desde el campo de batalla, en vez de eso, exílialo y juega un turno adicional después de este.\', \'type\': \'Artefacto legendario\', \'flavor\': \'De repente, la mente de Sarkhan quedó en silencio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f019279-0a1f-4f9e-8559-8c9f6051a96a\', \'multiverseId\': 389399}, \'multiverseid\': 389399}, {\'name\': "Nexus d\'Ugin", \'text\': "Si un joueur devait commencer un tour supplémentaire, ce joueur passe ce tour à la place.\\nSi le Nexus d\'Ugin devait être mis dans un cimetière depuis le champ de bataille, à la place, exilez-le et jouez un tour supplémentaire après celui-ci.", \'type\': \'Artefact légendaire\', \'flavor\': "Tout à coup, l\'esprit de Sarkhan fut silencieux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387785&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7fb6c7b-f1ec-4487-b76d-3179b55c6d1f\', \'multiverseId\': 387785}, \'multiverseid\': 387785}, {\'name\': \'Fulcro di Ugin\', \'text\': \'Se un giocatore sta per iniziare un turno extra, quel giocatore salta invece quel turno.\\nSe il Fulcro di Ugin sta per essere messo in un cimitero dal campo di battaglia, invece esilialo e gioca un turno extra dopo questo.\', \'type\': \'Artefatto Leggendario\', \'flavor\': "D\'un tratto, nella mente di Sarkhan calò il silenzio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388054&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1f7f26f-7737-4f06-9b98-b3bb096fb853\', \'multiverseId\': 388054}, \'multiverseid\': 388054}, {\'name\': \'ウギンのきずな\', \'text\': \'プレイヤーが追加ターンを始めるなら、代わりにそのプレイヤーはそのターンを飛ばす。\\nウギンのきずなが戦場から墓地に置かれるなら、代わりにこれを追放し、このターンの直後に追加の１ターンを行う。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'突然、サルカンの精神は静寂に包まれた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388323&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c1eac626-ec07-4453-a04a-a4ab081d3264\', \'multiverseId\': 388323}, \'multiverseid\': 388323}, {\'name\': \'우진의 결합점\', \'text\': \'플레이어가 추가 턴을 시작하려고 한다면, 대신에 그 플레이어는 그 턴을 건너뛴다.\\n우진의 결합점이 전장에서 무덤으로 들어가려고 하면, 대신에 우진의 결합점을 추방하고 이번 턴 후에 추가로 턴을 얻는다.\', \'type\': \'전설적 마법물체\', \'flavor\': \'사르칸의 정신은 갑자기 침묵에 잠겼다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388592&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f1a1dc5e-1469-4248-961a-f96cfe00762d\', \'multiverseId\': 388592}, \'multiverseid\': 388592}, {\'name\': \'Nexus de Ugin\', \'text\': \'Se um jogador for começar um turno extra, em vez disso, o jogador pula aquele turno.\\nSe Nexus de Ugin seria colocado no cemitério vindo do campo de batalha, em vez disso, exile-o e jogue um turno extra após esse.\', \'type\': \'Artefato Lendário\', \'flavor\': \'De repente, a mente de Sarkhan ficou em silêncio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6e702567-e59e-4481-9a6e-af72b90481a4\', \'multiverseId\': 388861}, \'multiverseid\': 388861}, {\'name\': \'Нексус Уджина\', \'text\': \'Если игрок должен начать дополнительный ход, вместо этого тот игрок пропускает тот ход.\\nЕсли Нексус Уджина должен попасть на кладбище с поля битвы, вместо этого изгоните его и сделайте дополнительный ход вслед за этим.\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'В одно мгновение в голове у Сархана стало тихо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389130&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8b0b8b7f-6e81-479b-97fd-e70bf98e2022\', \'multiverseId\': 389130}, \'multiverseid\': 389130}, {\'name\': \'乌金连结点\', \'text\': \'如果某牌手将开始额外的一个回合，则改为该牌手略过该回合。\\n如果乌金连结点将从战场进入坟墓场，则改为将它放逐，并在本回合后进行额外的一个回合。\', \'type\': \'传奇神器\', \'flavor\': \'萨坎脑中幽声此刻全数止歇。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386978&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c9f583ec-74f3-469b-8e56-897c6c1826e6\', \'multiverseId\': 386978}, \'multiverseid\': 386978}, {\'name\': \'烏金連結點\', \'text\': \'如果某玩家將開始額外的一個回合，則改為該玩家略過該回合。\\n如果烏金連結點將從戰場進入墳墓場，則改為將它放逐，並在本回合後進行額外的一個回合。\', \'type\': \'傳奇神器\', \'flavor\': \'薩坎腦中幽聲此刻全數止歇。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387247&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b4b7ff64-95d8-4f71-9b38-d4a66a4c3d31\', \'multiverseId\': 387247}, \'multiverseid\': 387247}]', '[{\'name\': \'Unbarmherzige Schlitzerin\', \'text\': \'Todesberührung\\nMorph—Zeige eine schwarze Karte auf deiner Hand offen vor. (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn die Unbarmherzige Schlitzerin aufgedeckt wird, verliert ein Spieler deiner Wahl 2 Lebenspunkte.\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387450&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ae150d2-3bed-459c-84f9-da854e482a6d\', \'multiverseId\': 387450}, \'multiverseid\': 387450}, {\'name\': \'Desgarradora despiadada\', \'text\': \'Toque mortal.\\nMetamorfosis—Muestra una carta negra de tu mano. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando la Desgarradora despiadada se ponga boca arriba, el jugador objetivo pierde 2 vidas.\', \'type\': \'Criatura — Asesino humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389333&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'08dc3992-5e01-424c-8936-457d4321413d\', \'multiverseId\': 389333}, \'multiverseid\': 389333}, {\'name\': \'Éventreuse impitoyable\', \'text\': "Contact mortel\\nMue — Révélez une carte noire de votre main. (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand l\'Éventreuse impitoyable est retournée face visible, le joueur ciblé perd 2 points de vie.", \'type\': \'Créature : humain et assassin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387719&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53321bc0-03b6-4ebb-b53b-9252608c6bcd\', \'multiverseId\': 387719}, \'multiverseid\': 387719}, {\'name\': \'Squartatrice Spietata\', \'text\': \'Tocco letale\\nMetamorfosi—Rivela una carta nera dalla tua mano. (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando la Squartatrice Spietata viene girata a faccia in su, un giocatore bersaglio perde 2 punti vita.\', \'type\': \'Creatura — Assassino Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387988&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2edbae6e-2574-467b-a6f8-7726329e0362\', \'multiverseId\': 387988}, \'multiverseid\': 387988}, {\'name\': \'無情な切り裂き魔\', \'text\': \'接死\\n変異 ― あなたの手札にある黒のカードを１枚公開する。（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n無情な切り裂き魔が表向きになったとき、プレイヤー１人を対象とする。そのプレイヤーは２点のライフを失う。\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388257&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5caca02-cead-4bcb-a338-56023019ce0c\', \'multiverseId\': 388257}, \'multiverseid\': 388257}, {\'name\': \'무자비한 살인광\', \'text\': \'치명타\\n변이—당신의 손에서 흑색 카드 한 장을 공개한다. (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\\n무자비한 살인광이 앞면으로 뒤집히면, 플레이어를 목표로 정한다. 그 플레이어는 생명 2점을 잃는다.\', \'type\': \'생물 — 인간 암살자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388526&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'28e448b9-ed2b-42b8-b4fe-2f3fe6911bd4\', \'multiverseId\': 388526}, \'multiverseid\': 388526}, {\'name\': \'Estripadora Impiedosa\', \'text\': \'Toque mortífero\\nMetamorfose — Revele um card preto na sua mão. (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Estripadora Impiedosa é voltada para cima, o jogador alvo perde 2 pontos de vida.\', \'type\': \'Criatura — Humano Assassino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388795&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8910e1c6-cc32-46ff-ba51-047180678d20\', \'multiverseId\': 388795}, \'multiverseid\': 388795}, {\'name\': \'Безжалостная Потрошительница\', \'text\': \'Смертельное касание\\nОборотень — Покажите черную карту, находящуюся в вашей руке. (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\\nКогда Безжалостная Потрошительница переворачивается рубашкой вниз, целевой игрок теряет 2 жизни.\', \'type\': \'Существо — Человек Убийца\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389064&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b699b0d-64d0-4fe3-81a1-9a9c22f848c1\', \'multiverseId\': 389064}, \'multiverseid\': 389064}, {\'name\': \'无情夺魂客\', \'text\': \'死触\\n变身～从你手上展示一张黑色牌。（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当无情夺魂客翻回正面时，目标牌手失去2点生命。\', \'type\': \'生物～人类／杀手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386912&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88d8044e-078c-4b6e-a153-4fb9cb4e6388\', \'multiverseId\': 386912}, \'multiverseid\': 386912}, {\'name\': \'無情奪魂客\', \'text\': \'死觸\\n變身～從你手上展示一張黑色牌。（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\\n當無情奪魂客翻回正面時，目標玩家失去2點生命。\', \'type\': \'生物～人類／殺手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387181&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8a8fc349-ad69-42b9-bf85-e89f896d25cd\', \'multiverseId\': 387181}, \'multiverseid\': 387181}]', '[{\'name\': \'Unbeugsamer Krumar\', \'text\': \'{1}{W}: Der Unbeugsame Krumar erhält Erstschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Ork, Krieger\', \'flavor\': \'„Der Mann, den ich Vater nenne, hat den Ork getötet, der mich gezeugt hat, und mir im Gegenzug seine Welt und seine Klinge angeboten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5d70141-58d8-4d03-b036-54cf32eba901\', \'multiverseId\': 387517}, \'multiverseid\': 387517}, {\'name\': \'Krumar implacable\', \'text\': \'{1}{W}: El Krumar implacable gana la habilidad de dañar primero hasta el final del turno.\', \'type\': \'Criatura — Guerrero orco\', \'flavor\': \'"El hombre al que llamo padre mató al orco que me engendró, ofreciéndome su mundo y su espada a cambio".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389400&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81413fec-3e33-455a-9cba-32289d56a540\', \'multiverseId\': 389400}, \'multiverseid\': 389400}, {\'name\': \'Krumar inflexible\', \'text\': "{1}{W} : Le Krumar inflexible acquiert l\'initiative jusqu\'à la fin du tour.", \'type\': \'Créature : orque et guerrier\', \'flavor\': "« L\'homme que j\'appelle père a tué l\'orque qui m\'a engendré, offrant son monde et sa lame en retour. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387786&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24097a04-ed32-455d-81d2-170e826b1b18\', \'multiverseId\': 387786}, \'multiverseid\': 387786}, {\'name\': \'Krumar Inesorabile\', \'text\': \'{1}{W}: Il Krumar Inesorabile ha attacco improvviso fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Orco\', \'flavor\': \'"L\\\'uomo che chiamo \\\'padre\\\' ha ucciso l\\\'orco che mi ha generato, offrendomi in cambio il suo mondo e la sua spada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388055&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e8824803-dc7a-426f-90f2-b99bc0adb157\', \'multiverseId\': 388055}, \'multiverseid\': 388055}, {\'name\': \'不撓のクルーマ\', \'text\': \'{1}{W}：ターン終了時まで、不撓のクルーマは先制攻撃を得る。\', \'type\': \'クリーチャー — オーク・戦士\', \'flavor\': \'「私が父と呼ぶ男は、私を育ててくれたオークを殺し、その見返りとしてその男の世界と刃を私に提供してくれたのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388324&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4fd5f60c-45b3-439f-a153-1af8434c5594\', \'multiverseId\': 388324}, \'multiverseid\': 388324}, {\'name\': \'단호한 크루마\', \'text\': \'{1}{W}: 단호한 크루마는 턴종료까지 선제공격을 얻는다.\', \'type\': \'생물 — 오크 전사\', \'flavor\': \'"내가 아버지라 부르는 사람은 날 낳아준 오크를 죽이고 나에게 인간 세계와 검을 대신 선물해주었다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388593&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f93ed810-fb42-42b5-b855-17b7fda5352c\', \'multiverseId\': 388593}, \'multiverseid\': 388593}, {\'name\': \'Krumar Inexorável\', \'text\': \'{1}{W}: Krumar Inexorável ganha iniciativa até o final do turno.\', \'type\': \'Criatura — Orc Guerreiro\', \'flavor\': \'"O homem que eu chamo de pai matou o orc que me escravizou, oferecendo seu mundo e sua lâmina em troca."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8766becf-4543-4e7a-998c-da54f9eed055\', \'multiverseId\': 388862}, \'multiverseid\': 388862}, {\'name\': \'Несокрушимый Крумар\', \'text\': \'{1}{W}: Несокрушимый Крумар получает Первый удар до конца хода.\', \'type\': \'Существо — Орк Воин\', \'flavor\': \'«Человек, которого я называю отцом, убил породившего меня орка и предложил мне взамен свой мир и свой клинок».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389131&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f19cd6a9-6794-4996-88b5-2a97f927b668\', \'multiverseId\': 389131}, \'multiverseid\': 389131}, {\'name\': \'刚毅孑遗\', \'text\': \'{1}{W}：刚毅孑遗获得先攻异能直到回合结束。\', \'type\': \'生物～半兽人／战士\', \'flavor\': \'「我如今的父亲正是杀害我生父的元凶，为了弥补过失，他待我视同己出，传我手中巨剑。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386979&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4df9f00-3982-4c1d-aef1-f5b28534dd5d\', \'multiverseId\': 386979}, \'multiverseid\': 386979}, {\'name\': \'剛毅孑遺\', \'text\': \'{1}{W}：剛毅孑遺獲得先攻異能直到回合結束。\', \'type\': \'生物～半獸人／戰士\', \'flavor\': \'「我如今的父親正是殺害我生父的元兇，為了彌補過失，他待我視同己出，傳我手中巨劍。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387248&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'55709444-ab89-4b37-8422-b90e87481b89\', \'multiverseId\': 387248}, \'multiverseid\': 387248}]', '[{\'name\': \'Verachten\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst davon eine Kreaturen- oder Planeswalkerkarte. Dieser Spieler wirft diese Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Du bist aus dem Feuer zurückgekehrt, Verräter. Diesmal wirst du diesen Ort als Asche verlassen." —Zurgo zu Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387324&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'15edc3c0-6fc7-409d-8761-bca8e48c9a46\', \'multiverseId\': 387324}, \'multiverseid\': 387324}, {\'name\': \'Despreciar\', \'text\': \'El oponente objetivo muestra su mano. Tú eliges de ahí una carta de criatura o de planeswalker. Ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'"Has regresado del fuego, traidor. Esta vez te veré partir hecho cenizas". —Zurgo, a Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389207&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec4e9b84-2b1f-4210-9fac-af53d1408459\', \'multiverseId\': 389207}, \'multiverseid\': 389207}, {\'name\': \'Dédain\', \'text\': "L\'adversaire ciblé révèle sa main. Vous y choisissez une carte de créature ou de planeswalker. Ce joueur se défausse de cette carte.", \'type\': \'Rituel\', \'flavor\': "« Traître, le feu ne t\'a pas consumé. Cette fois, je vais m\'assurer que tu ne laisses que des cendres. » —Zurgo, à Sarkhan Vol", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387593&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15520b65-0f1d-415b-a6f1-53c71ed82a5a\', \'multiverseId\': 387593}, \'multiverseid\': 387593}, {\'name\': \'Disdegnare\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta creatura o planeswalker da quella mano. Quel giocatore scarta quella carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Hai fatto ritorno dal fuoco, traditore. Stavolta mi assicurerò che ad andarsene siano le tue ceneri." —Zurgo, a Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387862&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34deeb26-7857-426e-ae59-d755e2de13a0\', \'multiverseId\': 387862}, \'multiverseid\': 387862}, {\'name\': \'蔑み\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはその中からクリーチャー・カード１枚かプレインズウォーカー・カード１枚を選ぶ。そのプレイヤーはそのカードを捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「炎から再び戻ったか、裏切り者よ。今度は貴様が灰となって去るのを見届けてやろう。」 ――ズルゴ、サルカン・ヴォルに対し\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388131&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b55dce7-4634-4d7e-a7b0-12f14b0a4d40\', \'multiverseId\': 388131}, \'multiverseid\': 388131}, {\'name\': \'경멸\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 그 중 생물이나 플레인즈워커 카드 한 장을 선택한다. 그 플레이어는 그 카드를 버린다.\', \'type\': \'집중마법\', \'flavor\': \'"배신자여, 용케 불에서 살아 돌아왔구나. 이번엔 네가 재가 되어 바스러지는 모습을 지켜볼 것이다." —주르고가 사르칸 볼에게\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388400&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6a599373-e49b-41db-bcdf-f4fcc94ff054\', \'multiverseId\': 388400}, \'multiverseid\': 388400}, {\'name\': \'Desprezar\', \'text\': \'O oponente alvo revela a própria mão. Você escolhe um card de criatura ou planeswalker dela. Aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'"Você retornou do fogo, traidor. Desta vez, farei com que você parta como cinzas." — Zurgo, para Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388669&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5cba705-9abc-4404-8b98-bcc8c38acf9e\', \'multiverseId\': 388669}, \'multiverseid\': 388669}, {\'name\': \'Презирать\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете из нее карту существа или planeswalker-а. Тот игрок сбрасывает ту карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Ты вернулся из огня, предатель. На этот раз я прослежу, чтобы от тебя остался лишь пепел». — Зурго, обращаясь к Сархану Волю\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388938&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b6254ad6-ce45-4d63-85ef-a54a180bd5f1\', \'multiverseId\': 388938}, \'multiverseid\': 388938}, {\'name\': \'鄙视\', \'text\': \'目标对手展示其手牌。你选择其中一张生物或鹏洛客牌。该牌手弃掉该牌。\', \'type\': \'法术\', \'flavor\': \'「叛徒，那场大火也没能把你烧死。这次我一定要把你化作灰烬。」 ～珠高怒斥萨坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386786&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e3eb1335-598b-4f35-b5e6-a2110fa4d498\', \'multiverseId\': 386786}, \'multiverseid\': 386786}, {\'name\': \'鄙視\', \'text\': \'目標對手展示其手牌。你選擇其中一張生物或鵬洛客牌。該玩家棄掉該牌。\', \'type\': \'巫術\', \'flavor\': \'「叛徒，那場大火也沒能把你燒死。這次我一定要把你化作灰燼。」 ～珠高怒斥薩坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387055&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'39f73ec4-3a62-435c-8198-1accf4651aec\', \'multiverseId\': 387055}, \'multiverseid\': 387055}]', '[{\'name\': \'Vergeltung der Ahnen\', \'text\': \'{B}, entferne X +1/+1-Marken von Kreaturen, die du kontrollierst: Eine Kreatur deiner Wahl erhält -X/-X bis zum Ende des Zuges.\', \'type\': \'Verzauberung\', \'flavor\': \'Vorfahren der Abzan starben, um ihre Häuser zu beschützen, und sie beschützen sie immer noch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387442&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'45010d7b-ac87-4a2a-8f78-512cc2edcfb3\', \'multiverseId\': 387442}, \'multiverseid\': 387442}, {\'name\': \'Retribución de los antiguos\', \'text\': \'{B}, remover X contadores +1/+1 de entre las criaturas que controlas: La criatura objetivo obtiene -X/-X hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': \'Los ancestros abzanos dieron su vida por proteger sus dinastías y, aun hoy, siguen protegiéndolas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389325&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22967382-7c62-4368-8a1f-fa918c4fcbdc\', \'multiverseId\': 389325}, \'multiverseid\': 389325}, {\'name\': \'Châtiment des ancêtres\', \'text\': "{B}, retirez X marqueurs +1/+1 de créatures que vous contrôlez : La créature ciblée gagne -X/-X jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': \'Les ancêtres abzans périrent pour protéger leurs Maisons, et ils les protègent encore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'058c79fe-ed66-48b5-8447-ab393df5c4ad\', \'multiverseId\': 387711}, \'multiverseid\': 387711}, {\'name\': \'Castigo degli Antichi\', \'text\': \'{B}, Rimuovi X segnalini +1/+1 scelti tra le creature che controlli: Una creatura bersaglio prende -X/-X fino alla fine del turno.\', \'type\': \'Incantesimo\', \'flavor\': \'Gli antenati degli Abzan sono morti per proteggere le proprie Casate e continuano a farlo tuttora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0afb2f75-6e39-4255-afe5-497d8b30a97a\', \'multiverseId\': 387980}, \'multiverseid\': 387980}, {\'name\': \'古き者どもの報復\', \'text\': \'{B}, 好きな数のあなたがコントロールするクリーチャーの上から＋１/＋１カウンターをＸ個取り除く：クリーチャー１体を対象とする。ターン終了時まで、それは－Ｘ/－Ｘの修整を受ける。\', \'type\': \'エンチャント\', \'flavor\': \'アブザンの先祖たちはアブザン家を守るために命を落とし、そして今もなお一家を守っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388249&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43b6ffe5-15db-48b6-a481-99bffc58e236\', \'multiverseId\': 388249}, \'multiverseid\': 388249}, {\'name\': \'고대인의 복수\', \'text\': \'{B}, 당신이 조종하는 생물들에서 +1/+1 카운터 X개를 제거한다: 생물을 목표로 정한다. 그 생물은 턴종료까지 -X/-X를 받는다.\', \'type\': \'부여마법\', \'flavor\': \'일족을 지키고자 목숨을 바친 아브잔의 조상들은 여전히 그 임무를 다하고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388518&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2a2f9b8-e444-4f06-91d4-d06b4a89d9e6\', \'multiverseId\': 388518}, \'multiverseid\': 388518}, {\'name\': \'Retribuição dos Ancestrais\', \'text\': \'{B}, Remova X marcadores +1/+1 das criaturas que você controla: A criatura alvo recebe -X/-X até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': \'Os ancestrais Abzan morreram para proteger as Dinastias. Eles ainda as protegem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388787&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7dac3150-19bb-4fde-83e1-58e4923eb772\', \'multiverseId\': 388787}, \'multiverseid\': 388787}, {\'name\': \'Возмездие Древних\', \'text\': \'{B}, удалите X жетонов +1/+1 с существ под вашим контролем: целевое существо получает -X/-X до конца хода.\', \'type\': \'Чары\', \'flavor\': \'Предки абзанов погибли, защищая свои Семьи, и защищают их поныне.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389056&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a69eed43-813d-4bff-84cd-6387f2e8da0b\', \'multiverseId\': 389056}, \'multiverseid\': 389056}, {\'name\': \'先人报偿\', \'text\': \'{B}，从由你操控的生物上移去总共X个+1/+1指示物：目标生物得-X/-X直到回合结束。\', \'type\': \'结界\', \'flavor\': \'阿布赞祖灵因卫护眷族而捐躯，死后仍尽效保护之责。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d42bed7-45b4-4c36-a6cc-a10202074744\', \'multiverseId\': 386904}, \'multiverseid\': 386904}, {\'name\': \'先人報償\', \'text\': \'{B}，從由你操控的生物上移去總共X個+1/+1指示物：目標生物得-X/-X直到回合結束。\', \'type\': \'結界\', \'flavor\': \'阿布贊祖靈因衛護眷族而捐軀，死後仍盡效保護之責。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387173&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b642a405-3c35-4e97-b843-f7627dc3f874\', \'multiverseId\': 387173}, \'multiverseid\': 387173}]', '[{\'name\': \'Verkörperung des Frühlings\', \'text\': \'{1}{G}, {T}, opfere die Verkörperung des Frühlings: Durchsuche deine Bibliothek nach einer Standardland-Karte, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Arel träumte vom Ende des Winters. Am nächsten Morgen folgte sie einer seltsamen Spur und fand einen Spross im Schnee.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387337&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48c8f3e5-7d7c-414e-91c1-60604b5ca2ae\', \'multiverseId\': 387337}, \'multiverseid\': 387337}, {\'name\': \'Encarnación de la primavera\', \'text\': \'{1}{G}, {T}, sacrificar la Encarnación de la primavera: Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Arel soñaba con el final del invierno. Al día siguiente, siguió un extraño rastro y halló un brote entre la nieve.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389220&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a71ee1b-76b2-43f0-867a-2cd0708eacf7\', \'multiverseId\': 389220}, \'multiverseid\': 389220}, {\'name\': \'Incarnation du printemps\', \'text\': "{1}{G}, {T}, sacrifiez l\'Incarnation du printemps : Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque.", \'type\': \'Créature : élémental\', \'flavor\': "Arel rêva de la fin de l\'hiver. Au matin suivant, elle suivit d\'étranges traces et découvrit un arbrisseau dans la neige.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387606&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46308f9e-a7f6-4d98-b6e7-608e10e860f9\', \'multiverseId\': 387606}, \'multiverseid\': 387606}, {\'name\': \'Incarnazione della Primavera\', \'text\': "{1}{G}, {T}, Sacrifica l\'Incarnazione della Primavera: Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio.", \'type\': \'Creatura — Elementale\', \'flavor\': "Arel sognò la fine dell\'inverno. Il mattino seguente, seguì uno strano sentiero e trovò un germoglio nella neve.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387875&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ae82211b-a6aa-490b-bff6-482abd6c1bf9\', \'multiverseId\': 387875}, \'multiverseid\': 387875}, {\'name\': \'春の具象化\', \'text\': \'{1}{G}, {T}, 春の具象化を生け贄に捧げる：あなたのライブラリーから基本土地・カードを１枚探してそれをタップ状態で戦場に出し、その後、あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'アレルは夢で冬の終わりを見た。明くる朝、彼女は不思議な跡をたどっていくと、雪の中に芽吹いた１つの萌芽を見つけた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388144&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10d02459-fe9d-4898-a7af-082212388384\', \'multiverseId\': 388144}, \'multiverseid\': 388144}, {\'name\': \'봄의 상징\', \'text\': \'{1}{G}, {T}, 봄의 상징을 희생한다: 당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'생물 — 정령\', \'flavor\': \'아렐은 겨울이 끝나는 꿈을 꾸었다. 다음 날 아침, 낯선 흔적을 따라간 그녀는 눈 속에서 고개를 치켜든 묘목을 발견했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388413&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bfcf1a16-b5b7-4e6c-8c68-c035d69eb93a\', \'multiverseId\': 388413}, \'multiverseid\': 388413}, {\'name\': \'Encarnação da Primavera\', \'text\': \'{1}{G}, {T}, Sacrifique Encarnação da Primavera: Procure um card de terreno básico no seu grimório, coloque-o no campo de batalha virado e depois embaralhe seu grimório.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Arel sonhou com o fim do inverno. Na manhã seguinte, ela seguiu uma trilha estranha e encontrou um pequeno broto em meio a neve.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388682&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e72603dd-d032-4dc6-be98-d1bf8b0f59b1\', \'multiverseId\': 388682}, \'multiverseid\': 388682}, {\'name\': \'Воплощение Весны\', \'text\': \'{1}{G}, {T}, пожертвуйте Воплощение Весны: найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Арель приснилось, что зима закончилась. На следующее утро она пошла по странному следу и нашла в снегу росток.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388951&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77a4e351-ed3b-476c-8402-318dcfb61360\', \'multiverseId\': 388951}, \'multiverseid\': 388951}, {\'name\': \'春晓化身\', \'text\': \'{1}{G}，{T}，牺牲春晓化身：从你的牌库中搜寻一张基本地牌，将之横置进战场，然后将你的牌库洗牌。\', \'type\': \'生物～元素\', \'flavor\': \'阿瑞尔在睡梦中，看到了寒冬终结的景象。次日清晨，她循着一条莫名踪迹，在雪中寻得一株新绿。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386799&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb691eb8-b9bb-4562-8cf7-3131cb01dd00\', \'multiverseId\': 386799}, \'multiverseid\': 386799}, {\'name\': \'春曉化身\', \'text\': \'{1}{G}，{T}，犧牲春曉化身：從你的牌庫中搜尋一張基本地牌，將之橫置進戰場，然後將你的牌庫洗牌。\', \'type\': \'生物～元素\', \'flavor\': \'阿瑞爾在睡夢中，看到了寒冬終結的景象。次日清晨，她循著一條莫名蹤跡，在雪中尋得一株新綠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387068&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bf2c8b18-fe37-4a18-8e43-3e3405906527\', \'multiverseId\': 387068}, \'multiverseid\': 387068}]', "[{'name': 'Verlassene Ödnis', 'text': 'Die Verlassene Ödnis kommt getappt ins Spiel.\\nWenn die Verlassene Ödnis ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387462&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5ce245ed-41b6-4001-8998-37dde95d6f69', 'multiverseId': 387462}, 'multiverseid': 387462}, {'name': 'Yermos desérticos', 'text': 'Los Yermos desérticos entran al campo de batalla girados.\\nCuando los Yermos desérticos entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {W} o {B} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389345&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e69083e7-7e88-47f9-b0ef-53d819d0b29f', 'multiverseId': 389345}, 'multiverseid': 389345}, {'name': 'Landes érodées', 'text': 'Les Landes érodées arrivent sur le champ de bataille engagées.\\nQuand les Landes érodées arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {W} ou {B} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387731&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5ce42b63-9361-4421-86c1-a181335d0fc8', 'multiverseId': 387731}, 'multiverseid': 387731}, {'name': 'Distese Desolate', 'text': 'Le Distese Desolate entrano nel campo di battaglia TAPpate.\\nQuando le Distese Desolate entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388000&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '529390f7-b1d0-4a70-8d30-83623afbd139', 'multiverseId': 388000}, 'multiverseid': 388000}, {'name': '磨かれたやせ地', 'text': '磨かれたやせ地はタップ状態で戦場に出る。\\n磨かれたやせ地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388269&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '42d2b46e-ed2b-4366-8e45-b44c11fcb27a', 'multiverseId': 388269}, 'multiverseid': 388269}, {'name': '척박한 황무지', 'text': '척박한 황무지는 탭된 채로 전장에 들어온다.\\n척박한 황무지가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {W} 또는 {B}를 당신의 마나풀에 담는다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388538&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '76d144ea-3998-4c13-807b-ac48b67ddb06', 'multiverseId': 388538}, 'multiverseid': 388538}, {'name': 'Desertos Calcinados', 'text': 'Desertos Calcinados entra no campo de batalha virado.\\nQuando Desertos Calcinados entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {W} ou {B} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388807&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '176200ff-3bf1-4893-aa63-4406e7bcf3a3', 'multiverseId': 388807}, 'multiverseid': 388807}, {'name': 'Выжженные Пустоши', 'text': 'Выжженные Пустоши выходят на поле битвы повернутыми.\\nКогда Выжженные Пустоши выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {W} или {B} в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389076&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0d26b2c5-2789-4485-b648-17ea26329037', 'multiverseId': 389076}, 'multiverseid': 389076}, {'name': '侵蚀荒漠', 'text': '侵蚀荒漠须横置进战场。\\n当侵蚀荒漠进战场时，你获得1点生命。\\n{T}：加{W}或{B}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386924&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a556bc69-e832-41e6-94f0-0b72a2a63c0a', 'multiverseId': 386924}, 'multiverseid': 386924}, {'name': '侵蝕荒漠', 'text': '侵蝕荒漠須橫置進戰場。\\n當侵蝕荒漠進戰場時，你獲得1點生命。\\n{T}：加{W}或{B}到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387193&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e21da90d-08a2-4cf9-b0db-7cb0948d2334', 'multiverseId': 387193}, 'multiverseid': 387193}]", '[{\'name\': \'Verleugneter Vorfahr\', \'text\': \'Standhaft {1}{B} ({1}{B}, {T}: Lege eine +1/+1-Marke auf diese Kreatur. Spiele Standhaft wie eine Hexerei.)\', \'type\': \'Kreatur — Geist, Krieger\', \'flavor\': \'Noch lange nach dem Tod trachten die Geister der Verleugneten danach, wieder in ihre Abzan-Familie aufgenommen zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387328&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa1396c5-f2e7-4b01-9cd7-a7aa14472479\', \'multiverseId\': 387328}, \'multiverseid\': 387328}, {\'name\': \'Ancestro repudiado\', \'text\': \'Supervivencia {1}{B}. ({1}{B}, {T}: Pon un contador +1/+1 sobre esta criatura. Activa la habilidad de supervivencia solo como un conjuro.)\', \'type\': \'Criatura — Guerrero espíritu\', \'flavor\': \'Mucho después de morir, los espíritus de los Repudiados continúan buscando la redención ante sus hermanos abzanos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389211&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d69a7b50-8ab4-421b-a7d4-9f7e379e4907\', \'multiverseId\': 389211}, \'multiverseid\': 389211}, {\'name\': \'Ancêtre désavoué\', \'text\': "Résilience {1}{B} ({1}{B}, {T} : Mettez un marqueur +1/+1 sur cette créature. N\'utilisez la résilience que lorsque vous pourriez lancer un rituel.)", \'type\': \'Créature : esprit et guerrier\', \'flavor\': \'Les esprits des Désavoués cherchent par delà la mort à obtenir la rédemption parmi leurs semblables abzans.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387597&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b2aece1-2286-4414-8649-9006e7d900db\', \'multiverseId\': 387597}, \'multiverseid\': 387597}, {\'name\': \'Antenato Ripudiato\', \'text\': \'Perdurare {1}{B} ({1}{B}, {T}: Metti un segnalino +1/+1 su questa creatura. Perdura solo quando potresti lanciare una stregoneria.)\', \'type\': \'Creatura — Guerriero Spirito\', \'flavor\': \'A lungo dopo la morte, gli spiriti dei Ripudiati continuano a cercare redenzione presso i propri familiari tra gli Abzan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387866&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27c7682b-f925-43bf-b218-447ca88d2805\', \'multiverseId\': 387866}, \'multiverseid\': 387866}, {\'name\': \'縁切られた先祖\', \'text\': \'長久{1}{B}（{1}{B}, {T}：このクリーチャーの上に＋１/＋１カウンターを１個置く。長久はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — スピリット・戦士\', \'flavor\': \'その死から長い年月が経過してもなお、縁を切られた者たちの魂はアブザンの同族の者たちに対する贖罪を果たそうとしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388135&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'baad8620-13c7-4119-867a-3040820f35dc\', \'multiverseId\': 388135}, \'multiverseid\': 388135}, {\'name\': \'의절한 고대인\', \'text\': \'버티기 {1}{B} ({1}{B}, {T}: 이 생물에 +1/+1 카운터 한 개를 올려놓는다. 당신은 집중마법을 발동할 수 있는 시기에만 버티기를 활성화할 수 있다.)\', \'type\': \'생물 — 신령 전사\', \'flavor\': \'죽은 지 오래된 의절한 이들의 영혼은 같은 아브잔 동족으로부터 구원을 찾는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388404&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'07589ce5-64ce-42af-a796-eba75d817e56\', \'multiverseId\': 388404}, \'multiverseid\': 388404}, {\'name\': \'Ancestral Renegado\', \'text\': \'Sobreviver {1}{B}({1}{B}, {T}: Coloque um marcador +1/+1 nesta criatura. Use sobreviver somente como um feitiço.)\', \'type\': \'Criatura — Espírito Guerreiro\', \'flavor\': \'Muito depois da morte, os espíritos dos Renegados continuam buscando redenção em meio aos Abzan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388673&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18afa91d-caaf-4898-84b2-e836d4eb0ccd\', \'multiverseId\': 388673}, \'multiverseid\': 388673}, {\'name\': \'Отрешенный Предок\', \'text\': \'Стойкость {1}{B} ({1}{B}, {T}: положите один жетон +1/+1 на это существо. Используйте Стойкость только как волшебство.)\', \'type\': \'Существо — Дух Воин\', \'flavor\': \'Еще долго после смерти духи Отрешенных ищут искупления среди своих собратьев-абзанов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388942&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8401f8b9-bd70-49cc-a14a-633681971e8d\', \'multiverseId\': 388942}, \'multiverseid\': 388942}, {\'name\': \'离弃先祖\', \'text\': \'延生{1}{B}（{1}{B}，{T}：在此生物上放置一个+1/+1指示物。延生的时机视同法术。）\', \'type\': \'生物～精怪／战士\', \'flavor\': \'即使死后很久，遭弃者的灵魂仍在他们的阿布赞亲人中寻求救赎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386790&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'75365cf4-1f7b-47c9-934f-9c44b5995714\', \'multiverseId\': 386790}, \'multiverseid\': 386790}, {\'name\': \'離棄先祖\', \'text\': \'延生{1}{B}（{1}{B}，{T}：在此生物上放置一個+1/+1指示物。延生的時機視同巫術。）\', \'type\': \'生物～精靈／戰士\', \'flavor\': \'即使死後很久，遭棄者的靈魂仍在他們的阿布贊親人中尋求救贖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387059&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f9ca3956-d33b-4f84-ace7-01500763f54a\', \'multiverseId\': 387059}, \'multiverseid\': 387059}]', '[{\'name\': \'Verräterische Tat\', \'text\': \'Übernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl. Enttappe diese Kreatur. Sie erhält Eile bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Sultai rauben unsere Toten, also holen wir uns ihre Lebenden!" —Taklai, Wutsängerin der Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387277&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b143b8cb-45f5-4178-9898-ee6eb9edbe73\', \'multiverseId\': 387277}, \'multiverseid\': 387277}, {\'name\': \'Acto de traición\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'"¡Los Sultai se llevan a nuestros muertos, así que nosotros tomaremos a sus vivos!". —Taklai, azuzadora de la ira mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389160&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc7c8385-b286-48a2-af46-e72906a8d150\', \'multiverseId\': 389160}, \'multiverseid\': 389160}, {\'name\': \'Acte de trahison\', \'text\': "Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'« Puisque les Sultaï prennent nos morts, nous nous approprierons leurs vivants ! » —Taklaï, chanterage marduen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387546&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'023ee4d2-f064-49c5-aadc-3044197b37c1\', \'multiverseId\': 387546}, \'multiverseid\': 387546}, {\'name\': \'Atto di Tradimento\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Se i Sultai rubano i nostri morti, noi prenderemo i loro vivi!" —Taklai, intonafuria Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387815&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'67190456-fc62-428c-9809-8e5b38365b6a\', \'multiverseId\': 387815}, \'multiverseid\': 387815}, {\'name\': \'反逆の行動\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それのコントロールを得る。そのクリーチャーをアンタップする。ターン終了時まで、それは速攻を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'「スゥルタイは我らの死者を取っていく。だから我々は奴らの生ある者を取る！」 ――マルドゥの憤怒歌い、タクライ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388084&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8492a41c-f451-44fb-bb96-30f75c144a22\', \'multiverseId\': 388084}, \'multiverseid\': 388084}, {\'name\': \'반역 행위\', \'text\': \'생물을 목표로 정한다. 당신은 턴종료까지 그 생물의 조종권을 얻는다. 그 생물은 언탭되며 턴종료까지 신속을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'"술타이는 우리의 망자들을 지배하니, 우리는 그들의 산자들을 지배해야 한다!" —마르두 전쟁노래꾼 타클라이\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388353&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'539c42e2-1004-4779-8381-319e0cfdf822\', \'multiverseId\': 388353}, \'multiverseid\': 388353}, {\'name\': \'Ato de Traição\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'"Os Sultai levam nossos mortos, então temos que levar os vivos deles!" — Taklai, cantador do ódio Mardu\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388622&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07b74e31-fade-4c63-aa8c-5938e7aa654c\', \'multiverseId\': 388622}, \'multiverseid\': 388622}, {\'name\': \'Акт Измены\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'«Султайцы забрали наших мертвецов, а мы заберем их живых!» — Таклай, певец ярости Марду\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388891&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6affcf9c-8e27-40ce-ac4f-9a8e8e3ab6a9\', \'multiverseId\': 388891}, \'multiverseid\': 388891}, {\'name\': \'叛行\', \'text\': \'获得目标生物的操控权直到回合结束。重置该生物。它获得敏捷异能直到回合结束。\', \'type\': \'法术\', \'flavor\': \'「苏勒台夺我逝者，我们当以掠其生者为报！」 ～玛尔都咏怒者塔克莱\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386739&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f57148a9-d0db-4724-bcec-fb601eec1d9e\', \'multiverseId\': 386739}, \'multiverseid\': 386739}, {\'name\': \'叛行\', \'text\': \'獲得目標生物的操控權直到回合結束。重置該生物。它獲得敏捷異能直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'「蘇勒台奪我逝者，我們當以掠其生者為報！」 ～瑪爾都詠怒者塔克萊\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387008&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c0f86569-3935-4a5b-a8d3-b03401ac54a8\', \'multiverseId\': 387008}, \'multiverseid\': 387008}]', '[{\'name\': \'Verschmutztes Delta\', \'text\': \'{T}, bezahle 1 Lebenspunkt, opfere das Verschmutzte Delta: Durchsuche deine Bibliothek nach einer Insel- oder Sumpf-Karte und bringe sie ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Wo Drachen einst herrschten, versinken nun ihre Knochen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387434&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'055b9550-bfbf-49ef-aa44-caa9e6bae8f1\', \'multiverseId\': 387434}, \'multiverseid\': 387434}, {\'name\': \'Delta contaminado\', \'text\': \'{T}, pagar 1 vida, sacrificar el Delta contaminado: Busca en tu biblioteca una carta de isla o pantano y ponla en el campo de batalla. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Allá donde en otro tiempo dominaban los dragones, ahora se sumergen sus huesos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389317&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24c4757e-d1e9-4c95-ad4f-a22af9f7672e\', \'multiverseId\': 389317}, \'multiverseid\': 389317}, {\'name\': \'Estuaire pollué\', \'text\': "{T}, payez 1 point de vie, sacrifiez l\'Estuaire pollué : Cherchez dans votre bibliothèque une carte d\'île ou de marais et mettez-la sur le champ de bataille. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': "Là où les dragons s\'imposaient jadis, leurs os sombrent désormais.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387703&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2f3dc49-48f4-4ef2-b5b5-43bca0af57b6\', \'multiverseId\': 387703}, \'multiverseid\': 387703}, {\'name\': \'Delta Inquinato\', \'text\': \'{T}, Paga 1 punto vita, Sacrifica il Delta Inquinato: Passa in rassegna il tuo grimorio per una carta Isola o Palude e mettila sul campo di battaglia. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Dove un tempo si libravano i draghi, ora affondano le loro ossa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387972&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0f50cca-634e-41dd-bbd7-2a13120a1d00\', \'multiverseId\': 387972}, \'multiverseid\': 387972}, {\'name\': \'汚染された三角州\', \'text\': \'{T}, ライフを１点支払う,汚染された三角州を生け贄に捧げる：あなたのライブラリーから島・カードか沼・カードを１枚探し、それを戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'かつて龍たちが繁栄した場所には、今では彼らの骨が沈んでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388241&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7452419-5e4b-4d39-8b10-7f620795e1f2\', \'multiverseId\': 388241}, \'multiverseid\': 388241}, {\'name\': \'오염된 삼각주\', \'text\': \'{T}, 생명 1점을 지불한다, 오염된 삼각주를 희생한다: 당신의 서고에서 섬이나 늪 카드 한 장을 찾아 전장에 놓는다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'대지\', \'flavor\': \'한때 용들이 만연했던 이곳에는 이제 가라앉는 용의 뼈만 남아있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388510&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf05b108-45e4-4a26-a7c7-4eb5f8710627\', \'multiverseId\': 388510}, \'multiverseid\': 388510}, {\'name\': \'Delta Poluído\', \'text\': \'{T}, Pague 1 ponto de vida, Sacrifique Delta Poluído: Procure um card de Ilha ou Pântano em seu grimório e coloque-o no campo de batalha. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Onde os dragões outrora prevaleceram, hoje seus ossos afundam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388779&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d03f5d6f-bd8d-4e66-bd30-7db1e346d8eb\', \'multiverseId\': 388779}, \'multiverseid\': 388779}, {\'name\': \'Загрязненная Дельта\', \'text\': \'{T}, заплатите 1 жизнь, пожертвуйте Загрязненную Дельту: найдите в вашей библиотеке карту Острова или Болота и положите ее на поле битвы. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'Там, где когда-то господствовали драконы, теперь тонут их кости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389048&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6c3c95aa-71d4-4b8a-bf32-48a94bf49cf9\', \'multiverseId\': 389048}, \'multiverseid\': 389048}, {\'name\': \'聚污三角洲\', \'text\': \'{T}，支付1点生命，牺牲聚污三角洲：从你的牌库中搜寻一张海岛或沼泽牌，并将之放进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'群龙耀威处，空余骨沉沦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386896&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b70dc25d-e365-41fa-a54e-e775fd6f3bcf\', \'multiverseId\': 386896}, \'multiverseid\': 386896}, {\'name\': \'聚污三角洲\', \'text\': \'{T}，支付1點生命，犧牲聚污三角洲：從你的牌庫中搜尋一張海島或沼澤牌，並將之放進戰場。然後將你的牌庫洗牌。\', \'type\': \'地\', \'flavor\': \'群龍耀威處，空餘骨沉淪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387165&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'df4d8b5c-ef22-4563-9fad-3dc64385cdaa\', \'multiverseId\': 387165}, \'multiverseid\': 387165}]', "[{'name': 'Verwesendes Mastodon', 'type': 'Kreatur — Zombie, Elefant', 'flavor': 'Mastodonten sind längst ausgestorben, doch faulige Kräfte des Gurmag-Sumpfes hauchen ihren Überresten manchmal neues Leben ein. Die Sultai unterwerfen solche Kreaturen gerne, betrachten sie aber als minderwertig im Vergleich zu ihren eigenen nekromagischen Schöpfungen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387447&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2d273efa-2d5b-4ce2-8539-729a776828c2', 'multiverseId': 387447}, 'multiverseid': 387447}, {'name': 'Mastodonte putrefacto', 'type': 'Criatura — Elefante zombie', 'flavor': 'Los mastodontes se extinguieron hace mucho, pero las hediondas fuerzas del pantano Gurmag a veces reaniman sus restos putrefactos. Los Sultai no tienen reparos en aprovechar esas criaturas, pero las consideran inferiores a las creaciones de su propia nigromancia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389330&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '461d21b3-dd1c-457f-8498-4934968d8295', 'multiverseId': 389330}, 'multiverseid': 389330}, {'name': 'Mastodonte pourrissant', 'type': 'Créature : zombie et éléphant', 'flavor': 'Les mastodontes sont éteints depuis bien longtemps, mais les viles forces du marais de Gurmag réaniment parfois leurs dépouilles putréfiées. Les Sultaï exploitent bien volontiers ces créatures, mais elles sont pour eux bien inférieures à leurs créations nécromantiques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387716&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ac475586-c03b-4a9c-a0c4-02dd25a7086b', 'multiverseId': 387716}, 'multiverseid': 387716}, {'name': 'Mastodonte in Decomposizione', 'type': 'Creatura — Elefante Zombie', 'flavor': 'I mastodonti si sono estinti da tempo, ma le forze immonde della Palude di Gurmag talvolta ne rianimano i resti putrefatti. I Sultai sfruttano volentieri queste creature, ma le considerano inferiori alle proprie creazioni necromantiche.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387985&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '29dbc48b-aa78-4499-b6d4-a762ba94d253', 'multiverseId': 387985}, 'multiverseid': 387985}, {'name': '朽ちゆくマストドン', 'type': 'クリーチャー — ゾンビ・象', 'flavor': 'マストドンは大昔に絶滅したが、グルマグ沼の邪悪な力が時折その腐乱した死体を動かすことがある。スゥルタイは喜んでそのようなクリーチャーを活用するが、自分たちの屍術で生み出した創造物より低級なものであると認識している。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388254&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cbb93e42-8a47-4fc0-b972-936b3027a36a', 'multiverseId': 388254}, 'multiverseid': 388254}, {'name': '썩어가는 마스토돈', 'type': '생물 — 좀비 코끼리', 'flavor': '마스토돈은 오래전에 멸종했지만 거마그 늪의 더러운 기운이 종종 그 썩어가는 사체를 움직이곤 한다. 술타이는 이런 존재들을 달갑게 활용하면서도 자신들의 사령술로 부리는 존재들보다 못하다고 여긴다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388523&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c0676fd7-4c92-4461-b856-71e02d173c76', 'multiverseId': 388523}, 'multiverseid': 388523}, {'name': 'Mastodonte Apodrecido', 'type': 'Criatura — Zumbi Elefante', 'flavor': 'Os mastodontes foram extintos há muito tempo, mas as forças vis do Pântano Gurmag às vezes reanimam os restos pútridos deles. Os Sultai exploram prontamente essas criaturas, mas as consideram inferiores às suas próprias criações necromânticas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388792&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '21a0ea7f-f587-4360-94cd-edf06b0e14ab', 'multiverseId': 388792}, 'multiverseid': 388792}, {'name': 'Гниющий Мастодонт', 'type': 'Существо — Зомби Слон', 'flavor': 'Мастодонты давно вымерли, но темная сила болота Гурмаг иногда оживляет их гниющие останки. Султайцы с радостью пользуются такими существами, однако считают их лишь жалкими подобиями творений своих собственных некромантов.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389061&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '05ed3ab1-013b-46a0-ada6-a49fabdd33bd', 'multiverseId': 389061}, 'multiverseid': 389061}, {'name': '腐臭乳齿象', 'type': '生物～灵俑／象', 'flavor': '乳齿象很早之前就已灭绝，但谷尔玛沼泽的邪恶力量偶尔还会驱使它们的腐败残躯为己所用。苏勒台虽乐享其成，却不大以此为意；他们更偏好自己的死灵术造物。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386909&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cde1427b-ffd2-4a0e-bda3-b8ae544afbd2', 'multiverseId': 386909}, 'multiverseid': 386909}, {'name': '腐臭乳齒象', 'type': '生物～殭屍／象', 'flavor': '乳齒象很早之前就已滅絕，但谷爾瑪沼澤的邪惡力量偶爾還會驅使它們的腐敗殘軀為己所用。蘇勒台雖樂享其成，卻不大以此為意；他們更偏好自己的死靈術造物。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387178&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '84c1a042-57cb-47b9-ad07-6f3f8bd6f683', 'multiverseId': 387178}, 'multiverseid': 387178}]", '[{\'name\': \'Verächtlicher Hieb\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl mit umgewandelten Manakosten von 4 oder mehr.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Du bist der Verachtung nicht wert. Niemand wird sich an dich oder deine Ahnen erinnern."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387326&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de0f4dc5-1def-45fd-bcaa-856bf74385eb\', \'multiverseId\': 387326}, \'multiverseid\': 387326}, {\'name\': \'Golpe altanero\', \'text\': \'Contrarresta el hechizo objetivo con coste de maná convertido de 4 o más.\', \'type\': \'Instantáneo\', \'flavor\': \'"Eres peor que patético. Tu linaje caerá en el olvido".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389209&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18eba30a-4823-4a56-92b4-cee696b4f67f\', \'multiverseId\': 389209}, \'multiverseid\': 389209}, {\'name\': \'Botte dédaigneuse\', \'text\': \'Contrecarrez le sort avec un coût converti de mana supérieur ou égal à 4 ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« Tu n\'es même pas digne de mépris. Ta lignée sera oubliée. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387595&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b9650e5-228f-4645-863b-f41d6d10d478\', \'multiverseId\': 387595}, \'multiverseid\': 387595}, {\'name\': \'Fendente Sdegnoso\', \'text\': \'Neutralizza una magia bersaglio con costo di mana convertito pari o superiore a 4.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non siete degni neppure di disprezzo. La vostra stirpe sarà dimenticata."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387864&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a8941d4-c8f4-412e-89d1-c6d66fb8b67c\', \'multiverseId\': 387864}, \'multiverseid\': 387864}, {\'name\': \'軽蔑的な一撃\', \'text\': \'点数で見たマナ・コストが４以上の呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「貴様は軽蔑にも値しない。貴様の血筋は忘却される。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388133&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d645a3ce-3c4f-41f8-aae1-39ce03332555\', \'multiverseId\': 388133}, \'multiverseid\': 388133}, {\'name\': \'경멸의 일격\', \'text\': \'전환마나비용이 4 이상인 주문을 목표로 정한다. 그 주문을 무효화한다.\', \'type\': \'순간마법\', \'flavor\': \'"넌 경멸할 가치도 없다. 네 혈족은 잊혀질 것이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388402&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1914a161-dff4-41e0-b30a-55398860b41f\', \'multiverseId\': 388402}, \'multiverseid\': 388402}, {\'name\': \'Golpe Desdenhoso\', \'text\': \'Anule a mágica alvo com custo de mana convertido igual ou superior a 4.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você está abaixo de qualquer consideração. Sua linhagem será esquecida."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388671&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5d069973-60ae-4ded-b215-667cbe32498e\', \'multiverseId\': 388671}, \'multiverseid\': 388671}, {\'name\': \'Презрительный Удар\', \'text\': \'Отмените целевое заклинание с конвертированной мана-стоимостью 4 или более.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ты недостоин даже презрения. Весь твой род будет забыт».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388940&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2d363601-609e-43a2-9f44-c6e03486c72d\', \'multiverseId\': 388940}, \'multiverseid\': 388940}, {\'name\': \'倨傲击\', \'text\': \'反击目标总法术力费用等于或大于4的咒语。\', \'type\': \'瞬间\', \'flavor\': \'「你实在不值一提。你的血统也将被人遗忘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386788&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a590f146-9df9-4074-9a2a-30a767068929\', \'multiverseId\': 386788}, \'multiverseid\': 386788}, {\'name\': \'倨傲擊\', \'text\': \'反擊目標總魔法力費用等於或大於4的咒語。\', \'type\': \'瞬間\', \'flavor\': \'「你實在不值一提。你的血統也將被人遺忘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387057&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e691c880-5b91-4783-9a48-72c22e9193e1\', \'multiverseId\': 387057}, \'multiverseid\': 387057}]', '[{\'name\': \'Vormacht der Abzan\', \'text\': \'Wenn die Vormacht der Abzan ins Spiel kommt, lege eine +1/+1-Marke auf jede Kreatur, die du kontrollierst.\\nImmer wenn eine Nichtspielsteinkreatur stirbt, die du kontrollierst, bringe einen 1/1 weißen Geist-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387271&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6af32abc-2e26-4dce-8e92-22bd505d5e12\', \'multiverseId\': 387271}, \'multiverseid\': 387271}, {\'name\': \'Supremacía abzana\', \'text\': \'Cuando la Supremacía abzana entre al campo de batalla, pon un contador +1/+1 sobre cada criatura que controlas.\\nSiempre que una criatura que controlas que no sea ficha muera, pon en el campo de batalla una ficha de criatura Espíritu blanca 1/1 con la habilidad de volar.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389154&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b39a44f-5011-4271-b696-74e44caf3318\', \'multiverseId\': 389154}, \'multiverseid\': 389154}, {\'name\': \'Ascendance abzane\', \'text\': "Quand l\'Ascendance abzane arrive sur le champ de bataille, mettez un marqueur +1/+1 sur chaque créature que vous contrôlez.\\nÀ chaque fois qu\'une créature non-jeton que vous contrôlez meurt, mettez sur le champ de bataille un jeton de créature 1/1 blanche Esprit avec le vol.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387540&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54b34245-4fe7-432b-8a65-1954d3fc1d9e\', \'multiverseId\': 387540}, \'multiverseid\': 387540}, {\'name\': \'Autorità Abzan\', \'text\': "Quando l\'Autorità Abzan entra nel campo di battaglia, metti un segnalino +1/+1 su ogni creatura che controlli.\\nOgniqualvolta una creatura non pedina che controlli muore, metti sul campo di battaglia una pedina creatura Spirito 1/1 bianca con volare.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387809&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee781be4-4d86-412d-8007-0d2036e047f9\', \'multiverseId\': 387809}, \'multiverseid\': 387809}, {\'name\': \'アブザンの隆盛\', \'text\': \'アブザンの隆盛が戦場に出たとき、あなたがコントロールする各クリーチャーの上に、＋１/＋１カウンターをそれぞれ１個置く。\\nあなたがコントロールするトークンでないクリーチャーが１体死亡するたび、飛行を持つ白の１/１のスピリット・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388078&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db506f9a-7926-4b96-9315-099b358dc105\', \'multiverseId\': 388078}, \'multiverseid\': 388078}, {\'name\': \'아브잔의 지배력\', \'text\': \'아브잔의 지배력이 전장에 들어올 때, 당신이 조종하는 각 생물에 +1/+1 카운터 한 개를 올려놓는다.\\n당신이 조종하는 생물 중 토큰이 아닌 생물이 죽을 때마다, 비행을 가진 1/1 백색 신령 생물 토큰 한 개를 전장에 놓는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388347&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'112e03d4-ed93-458b-8794-ce9cd7f7b74d\', \'multiverseId\': 388347}, \'multiverseid\': 388347}, {\'name\': \'Ascendência Abzan\', \'text\': \'Quando Ascendência Abzan entrar no campo de batalha, coloque um marcador +1/+1 em cada outra criatura que você controla.\\nToda vez que uma criatura que não seja ficha que você controla morrer, coloque no campo de batalha uma ficha de criatura branca 1/1 do tipo Espírito com voar.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388616&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb5d9e0d-d517-40e5-8344-eecdec73178b\', \'multiverseId\': 388616}, \'multiverseid\': 388616}, {\'name\': \'Возвышение Абзана\', \'text\': \'Когда Возвышение Абзана выходит на поле битвы, положите один жетон +1/+1 на каждое существо под вашим контролем.\\nКаждый раз, когда не являющееся фишкой существо под вашим контролем умирает, положите на поле битвы одну фишку существа 1/1 белый Дух с Полетом.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388885&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9c3911e3-c9f7-4c07-9662-629d39a2bbbb\', \'multiverseId\': 388885}, \'multiverseid\': 388885}, {\'name\': \'阿布赞霸权\', \'text\': \'当阿布赞霸权进战场时，在每个由你操控的生物上各放置一个+1/+1指示物。\\n每当一个由你操控且非衍生物的生物死去时，将一个1/1白色，具飞行异能的精怪衍生生物放进战场。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386733&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb085416-9155-474c-b6dd-13a3dbbc495f\', \'multiverseId\': 386733}, \'multiverseid\': 386733}, {\'name\': \'阿布贊霸權\', \'text\': \'當阿布贊霸權進戰場時，在每個由你操控的生物上各放置一個+1/+1指示物。\\n每當一個由你操控且非衍生物的生物死去時，將一個1/1白色，具飛行異能的精靈衍生生物放進戰場。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387002&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f563a566-1d18-4370-bd80-7459a2049a94\', \'multiverseId\': 387002}, \'multiverseid\': 387002}]', '[{\'name\': \'Vormacht der Jeskai\', \'text\': \'Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhalten Kreaturen, die du kontrollierst, +1/+1 bis zum Ende des Zuges. Enttappe diese Kreaturen.\\nImmer wenn du einen Nichtkreatur-Zauberspruch wirkst, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387378&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb5b8073-67a7-41d4-bc87-5dc452462b42\', \'multiverseId\': 387378}, \'multiverseid\': 387378}, {\'name\': \'Supremacía jeskai\', \'text\': \'Siempre que lances un hechizo que no sea de criatura, las criaturas que controlas obtienen +1/+1 hasta el final del turno. Endereza esas criaturas.\\nSiempre que lances un hechizo que no sea de criatura, puedes robar una carta. Si lo haces, descarta una carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389261&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04d41512-8962-414a-a681-de3604ff732b\', \'multiverseId\': 389261}, \'multiverseid\': 389261}, {\'name\': \'Ascendance jeskaï\', \'text\': "À chaque fois que vous lancez un sort non-créature, les créatures que vous contrôlez gagnent +1/+1 jusqu\'à la fin du tour. Dégagez ces créatures.\\nÀ chaque fois que vous lancez un sort non-créature, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387647&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85b8024c-0557-4d00-8da7-e22c45cb4742\', \'multiverseId\': 387647}, \'multiverseid\': 387647}, {\'name\': \'Autorità Jeskai\', \'text\': \'Ogniqualvolta lanci una magia non creatura, le creature che controlli prendono +1/+1 fino alla fine del turno. STAPpa quelle creature.\\nOgniqualvolta lanci una magia non creatura, puoi pescare una carta. Se lo fai, scarta una carta.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387916&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'564008eb-b76c-4196-bb43-ca1cffa61f4c\', \'multiverseId\': 387916}, \'multiverseid\': 387916}, {\'name\': \'ジェスカイの隆盛\', \'text\': \'あなたがクリーチャーでない呪文を１つ唱えるたび、ターン終了時まで、あなたがコントロールするクリーチャーは＋１/＋１の修整を受ける。それらのクリーチャーをアンタップする。\\nあなたがクリーチャーでない呪文を１つ唱えるたび、あなたはカードを１枚引いてもよい。そうしたなら、カードを１枚捨てる。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388185&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b233aa42-b933-4f40-bb54-e1df80cefe09\', \'multiverseId\': 388185}, \'multiverseid\': 388185}, {\'name\': \'제스카이의 지배력\', \'text\': \'당신이 생물이 아닌 주문을 발동할 때마다, 당신이 조종하는 생물들은 턴종료까지 +1/+1을 받는다. 그 생물들을 언탭한다.\\n당신이 생물이 아닌 주문을 발동할 때마다, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388454&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'11171ce6-a264-4b83-86de-b8af4141df48\', \'multiverseId\': 388454}, \'multiverseid\': 388454}, {\'name\': \'Ascendência Jeskai\', \'text\': \'Toda vez que você conjura uma mágica que não seja de criatura, as criaturas que você controla recebem +1/+1 até o final do turno. Desvire aquelas criaturas.\\nToda vez que conjura uma mágica que não seja de criatura, você pode comprar um card. Se fizer isso, descarte um card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388723&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8967e3c8-9769-4a27-ac84-355e278e6194\', \'multiverseId\': 388723}, \'multiverseid\': 388723}, {\'name\': \'Возвышение Джеская\', \'text\': \'Каждый раз, когда вы разыгрываете не являющееся существом заклинание, существа под вашим контролем получают +1/+1 до конца хода. Разверните те существа.\\nКаждый раз, когда вы разыгрываете не являющееся существом заклинание, вы можете взять карту. Если вы это делаете, сбросьте карту.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388992&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ff5760ed-6b31-4dfb-9242-f44f805d0eaa\', \'multiverseId\': 388992}, \'multiverseid\': 388992}, {\'name\': \'洁斯凯霸权\', \'text\': \'每当你施放非生物咒语时，由你操控的生物得+1/+1直到回合结束。重置这些生物。\\n每当你施放非生物咒语时，你可以抓一张牌。若你如此作，则弃一张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386840&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93e3612a-d3c6-4f83-9a07-dd27c79e1134\', \'multiverseId\': 386840}, \'multiverseid\': 386840}, {\'name\': \'潔斯凱霸權\', \'text\': \'每當你施放非生物咒語時，由你操控的生物得+1/+1直到回合結束。重置這些生物。\\n每當你施放非生物咒語時，你可以抽一張牌。若你如此作，則棄一張牌。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387109&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9eda23ff-7f00-4925-bbfa-b5c4d8ec8d4a\', \'multiverseId\': 387109}, \'multiverseid\': 387109}]', '[{\'name\': \'Vormacht der Mardu\', \'text\': \'Immer wenn eine Nichtspielsteinkreatur, die du kontrollierst, angreift, bringe einen 1/1 roten Goblin-Kreaturenspielstein getappt und angreifend ins Spiel.\\nOpfere die Vormacht der Mardu: Kreaturen, die du kontrollierst, erhalten +0/+3 bis zum Ende des Zuges.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387397&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f91726b6-6d3e-4dc4-907a-572e4bcbf100\', \'multiverseId\': 387397}, \'multiverseid\': 387397}, {\'name\': \'Supremacía mardu\', \'text\': \'Siempre que una criatura que controlas que no sea ficha ataque, pon en el campo de batalla una ficha de criatura Trasgo roja 1/1 girada y atacando.\\nSacrificar la Supremacía mardu: Las criaturas que controlas obtienen +0/+3 hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389280&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d15e5e9-5a78-46c5-a9b3-50068261e111\', \'multiverseId\': 389280}, \'multiverseid\': 389280}, {\'name\': \'Ascendance marduenne\', \'text\': "À chaque fois qu\'une créature non-jeton que vous contrôlez attaque, mettez sur le champ de bataille un jeton de créature 1/1 rouge Gobelin, engagé et attaquant.\\nSacrifiez l\'Ascendance marduenne : Les créatures que vous contrôlez gagnent +0/+3 jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'269daf73-f86c-4eb1-86c5-6391cb2469b0\', \'multiverseId\': 387666}, \'multiverseid\': 387666}, {\'name\': \'Autorità Mardu\', \'text\': "Ogniqualvolta una creatura non pedina che controlli attacca, metti sul campo di battaglia una pedina creatura Goblin 1/1 rossa TAPpata e attaccante.\\nSacrifica l\'Autorità Mardu: Le creature che controlli prendono +0/+3 fino alla fine del turno.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'617dcdf6-a3dd-4811-abc0-fe8efd5a59a9\', \'multiverseId\': 387935}, \'multiverseid\': 387935}, {\'name\': \'マルドゥの隆盛\', \'text\': \'あなたがコントロールするトークンでないクリーチャーが１体攻撃するたび、赤の１/１のゴブリン・クリーチャー・トークンを１体タップ状態で攻撃している状態で戦場に出す。\\nマルドゥの隆盛を生け贄に捧げる：ターン終了時まで、あなたがコントロールするクリーチャーは＋０/＋３の修整を受ける。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388204&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'edc1cc06-c116-49d8-b2d6-d4c25873cb51\', \'multiverseId\': 388204}, \'multiverseid\': 388204}, {\'name\': \'마르두의 지배력\', \'text\': \'당신이 조종하는 생물 중 토큰이 아닌 생물이 공격할 때마다, 1/1 적색 고블린 생물 토큰 한 개를 탭되어 공격하는 상태로 전장에 놓는다.\\n마르두의 지배력을 희생한다: 당신이 조종하는 생물들은 턴종료까지 +0/+3을 받는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388473&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'447754ab-5ea2-40d2-8b9f-b8687f53243b\', \'multiverseId\': 388473}, \'multiverseid\': 388473}, {\'name\': \'Ascendência Mardu\', \'text\': \'Toda vez que uma criatura que não seja ficha que você controla atacar, coloque no campo de batalha uma ficha de criatura vermelha 1/1 do tipo Goblin virada e atacando.\\nSacrifique Ascendência Mardu: As criaturas que você controla recebem +0/+3 até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388742&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'008a37a4-eb1e-4eef-a7a1-09705699dd09\', \'multiverseId\': 388742}, \'multiverseid\': 388742}, {\'name\': \'Возвышение Марду\', \'text\': \'Каждый раз, когда не являющееся фишкой существо под вашим контролем атакует, положите на поле битвы одну фишку существа 1/1 красный Гоблин повернутой и атакующей.\\nПожертвуйте Возвышение Марду: существа под вашим контролем получают +0/+3 до конца хода.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389011&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b03faf8a-190f-40f6-a5f7-3af85ed35858\', \'multiverseId\': 389011}, \'multiverseid\': 389011}, {\'name\': \'玛尔都霸权\', \'text\': \'每当一个由你操控且非衍生物的生物攻击时，将一个1/1红色鬼怪衍生生物横置进战场且正进行攻击。\\n牺牲玛尔都霸权：由你操控的生物得+0/+3直到回合结束。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386859&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'661e8411-c79a-4c1f-9314-f80392bf417d\', \'multiverseId\': 386859}, \'multiverseid\': 386859}, {\'name\': \'瑪爾都霸權\', \'text\': \'每當一個由你操控且非衍生物的生物攻擊時，將一個1/1紅色鬼怪衍生生物橫置進戰場且正進行攻擊。\\n犧牲瑪爾都霸權：由你操控的生物得+0/+3直到回合結束。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387128&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2f0f2d9f-5c04-4455-91dc-e62e0e157da9\', \'multiverseId\': 387128}, \'multiverseid\': 387128}]', '[{\'name\': \'Vormacht der Sultai\', \'text\': \'Schaue dir zu Beginn deines Versorgungssegments die obersten zwei Karten deiner Bibliothek an. Lege eine beliebige Anzahl davon auf deinen Friedhof und den Rest in beliebiger Reihenfolge oben auf deine Bibliothek.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3123ccc5-4a3f-400e-8828-08de2696bd11\', \'multiverseId\': 387481}, \'multiverseid\': 387481}, {\'name\': \'Supremacía sultai\', \'text\': \'Al comienzo de tu mantenimiento, mira las dos primeras cartas de tu biblioteca. Pon cualquier cantidad de ellas en tu cementerio y el resto en la parte superior de tu biblioteca en cualquier orden.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389364&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e64d7d91-51f2-4095-bcc5-fb611bba8a82\', \'multiverseId\': 389364}, \'multiverseid\': 389364}, {\'name\': \'Ascendance sultaï\', \'text\': "Au début de votre entretien, regardez les deux cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles dans votre cimetière et remettez ensuite le reste au-dessus de votre bibliothèque, dans l\'ordre de votre choix.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b7566e8-cc61-400b-ba5c-8f1cc6f583f1\', \'multiverseId\': 387750}, \'multiverseid\': 387750}, {\'name\': \'Autorità Sultai\', \'text\': "All\'inizio del tuo mantenimento, guarda le prime due carte del tuo grimorio. Mettine un qualsiasi numero nel tuo cimitero e le altre in cima al tuo grimorio in qualsiasi ordine.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388019&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f18fb2f3-772a-4035-8859-5186fd291480\', \'multiverseId\': 388019}, \'multiverseid\': 388019}, {\'name\': \'スゥルタイの隆盛\', \'text\': \'あなたのアップキープの開始時に、あなたのライブラリーの一番上から２枚のカードを見る。そのうちの望む枚数をあなたの墓地に置き、残りをあなたのライブラリーの一番上に望む順番で置く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388288&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5b95868-6ce1-43d2-9cd8-c167e3257304\', \'multiverseId\': 388288}, \'multiverseid\': 388288}, {\'name\': \'술타이의 지배력\', \'text\': \'당신의 유지단 시작에, 당신의 서고 맨 위의 카드 두 장을 본다. 그 중 원하는 만큼을 당신의 무덤에 넣고 나머지 카드들은 당신의 서고 맨 위에 원하는 순서로 놓는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388557&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9a46616f-8779-4711-a061-1823af74df0a\', \'multiverseId\': 388557}, \'multiverseid\': 388557}, {\'name\': \'Ascendência Sultai\', \'text\': \'No início de sua manutenção, olhe os dois cards do topo de seu grimório. Coloque qualquer quantidade deles no seu cemitério e o restante no topo do seu grimório em qualquer ordem.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388826&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29c18447-c1d5-449e-89a8-cb37e2860e6c\', \'multiverseId\': 388826}, \'multiverseid\': 388826}, {\'name\': \'Возвышение Султая\', \'text\': \'В начале вашего шага поддержки посмотрите две верхние карты вашей библиотеки. Положите любое количество из них на ваше кладбище, а остальные обратно на верх вашей библиотеки в любом порядке.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389095&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a32ea8ac-2a4e-4f21-9ef6-1c6729238ec6\', \'multiverseId\': 389095}, \'multiverseid\': 389095}, {\'name\': \'苏勒台霸权\', \'text\': \'在你的维持开始时，检视你牌库顶的两张牌。将其中任意数量的牌置入你的坟墓场，其余则以任意顺序放回你的牌库顶。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386943&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e909f9e-e7d0-4434-9587-d9589145db81\', \'multiverseId\': 386943}, \'multiverseid\': 386943}, {\'name\': \'蘇勒台霸權\', \'text\': \'在你的維持開始時，檢視你牌庫頂的兩張牌。將其中任意數量的牌置入你的墳墓場，其餘則以任意順序放回你的牌庫頂。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387212&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b52d8a0f-1fe3-4215-ae5b-951f68102b3f\', \'multiverseId\': 387212}, \'multiverseid\': 387212}]', '[{\'name\': \'Vormacht der Temur\', \'text\': \'Kreaturen, die du kontrollierst, haben Eile.\\nImmer wenn eine Kreatur mit Stärke 4 oder mehr unter deiner Kontrolle ins Spiel kommt, kannst du eine Karte ziehen.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387499&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8a56558-f80b-4f39-8e2e-3e212e0077a2\', \'multiverseId\': 387499}, \'multiverseid\': 387499}, {\'name\': \'Supremacía temur\', \'text\': \'Las criaturas que controlas tienen la habilidad de prisa.\\nSiempre que una criatura con fuerza de 4 o más entre al campo de batalla bajo tu control, puedes robar una carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389382&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10e14be0-56ec-42d4-9758-afde83a9c102\', \'multiverseId\': 389382}, \'multiverseid\': 389382}, {\'name\': \'Ascendance temurienne\', \'text\': "Les créatures que vous contrôlez ont la célérité.\\nÀ chaque fois qu\'une créature avec une force supérieure ou égale à 4 arrive sur le champ de bataille sous votre contrôle, vous pouvez piocher une carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83929602-c8fc-48b8-bbcb-4fc558d995f7\', \'multiverseId\': 387768}, \'multiverseid\': 387768}, {\'name\': \'Autorità Temur\', \'text\': \'Le creature che controlli hanno rapidità.\\nOgniqualvolta una creatura con forza pari o superiore a 4 entra nel campo di battaglia sotto il tuo controllo, puoi pescare una carta.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388037&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1875d0b-adfd-4313-8626-ba4de2afff15\', \'multiverseId\': 388037}, \'multiverseid\': 388037}, {\'name\': \'ティムールの隆盛\', \'text\': \'あなたがコントロールするクリーチャーは速攻を持つ。\\nパワーが４以上のクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたはカードを１枚引いてもよい。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388306&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0909507e-b086-4e39-9bdf-0ac4edc29626\', \'multiverseId\': 388306}, \'multiverseid\': 388306}, {\'name\': \'테무르의 지배력\', \'text\': \'당신이 조종하는 생물들은 신속을 가진다.\\n공격력이 4 이상인 생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 카드 한 장을 뽑을 수 있다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388575&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d068352-2197-4c23-bbb2-eb868d7eee24\', \'multiverseId\': 388575}, \'multiverseid\': 388575}, {\'name\': \'Ascendência Temur\', \'text\': \'As criaturas que você controla têm ímpeto.\\nToda vez que uma criatura com poder igual ou superior a 4 entra no campo de batalha sob o seu controle, você pode comprar um card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c2731e8-176c-44c2-bb65-79b3478b2814\', \'multiverseId\': 388844}, \'multiverseid\': 388844}, {\'name\': \'Возвышение Темура\', \'text\': \'Существа под вашим контролем имеют Ускорение.\\nКаждый раз, когда существо с силой 4 или больше выходит на поле битвы под вашим контролем, вы можете взять карту.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389113&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d07c28a-cf11-44e4-9fda-e42e9d4ede85\', \'multiverseId\': 389113}, \'multiverseid\': 389113}, {\'name\': \'铁木尔霸权\', \'text\': \'由你操控的生物具有敏捷异能。\\n每当一个力量等于或大于4的生物在你的操控下进战场时，你可以抓一张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386961&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c68b7dc8-96e6-486b-bc6e-24681845ca2e\', \'multiverseId\': 386961}, \'multiverseid\': 386961}, {\'name\': \'鐵木爾霸權\', \'text\': \'由你操控的生物具有敏捷異能。\\n每當一個力量等於或大於4的生物在你的操控下進戰場時，你可以抽一張牌。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387230&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e951434c-ccdb-4578-8913-d7b27561d6fb\', \'multiverseId\': 387230}, \'multiverseid\': 387230}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387347&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cc4e3ebc-ac44-49a5-8499-ff30a55437b2', 'multiverseId': 387347}, 'multiverseid': 387347}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389230&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cb5607c0-1e06-4f2a-b9d1-e0213e91805f', 'multiverseId': 389230}, 'multiverseid': 389230}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387616&type=card', 'language': 'French', 'identifiers': {'scryfallId': '39ca107a-db70-4115-9d12-2f90a2778f2a', 'multiverseId': 387616}, 'multiverseid': 387616}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387885&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3a9c03a5-e398-49cb-8c46-cdd7b1a0aacf', 'multiverseId': 387885}, 'multiverseid': 387885}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388154&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'eff7d1df-bbaf-4714-a7a3-b1b9a49f08a3', 'multiverseId': 388154}, 'multiverseid': 388154}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Ha