'multiverseId': 386893}, 'multiverseid': 386893}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387162&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ad8bc233-7df7-4402-96ae-ad698eecb5ad', 'multiverseId': 387162}, 'multiverseid': 387162}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387432&type=card', 'language': 'German', 'identifiers': {'scryfallId': '24cc56ac-b426-4394-9d4c-e1504ffa0edd', 'multiverseId': 387432}, 'multiverseid': 387432}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389315&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ccec81db-5024-444d-93f9-42b2295f10be', 'multiverseId': 389315}, 'multiverseid': 389315}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387701&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1609a145-e55c-412f-93b9-579c55aeaff2', 'multiverseId': 387701}, 'multiverseid': 387701}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387970&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a4d9ff85-8895-4061-b1e5-7edc5d3ac7a1', 'multiverseId': 387970}, 'multiverseid': 387970}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388239&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '66cb6b5d-5e0b-4af0-89e0-242fab1aa2be', 'multiverseId': 388239}, 'multiverseid': 388239}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388508&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'eb7bfe12-7be6-47e3-aa7a-3afdc0a56871', 'multiverseId': 388508}, 'multiverseid': 388508}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388777&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '48ff5c9b-467f-4a91-9a97-02b73f7cb09c', 'multiverseId': 388777}, 'multiverseid': 388777}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389046&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3a9ca8ed-4716-4a42-81df-b59b385c58a8', 'multiverseId': 389046}, 'multiverseid': 389046}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386894&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '23f89fbb-7cea-476e-b556-276a0448d86b', 'multiverseId': 386894}, 'multiverseid': 386894}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387163&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'fb8b9720-8edc-4e48-9ded-a16b10893383', 'multiverseId': 387163}, 'multiverseid': 387163}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387433&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fa661635-7ab8-4de2-af6b-46e480328724', 'multiverseId': 387433}, 'multiverseid': 387433}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389316&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a8aafb2c-d4b9-4a1a-8e94-a73830f36165', 'multiverseId': 389316}, 'multiverseid': 389316}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387702&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6f444914-ba2c-4024-96c0-b8ec4f388719', 'multiverseId': 387702}, 'multiverseid': 387702}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387971&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5eca3921-5071-48d4-91aa-e6092a5b77e8', 'multiverseId': 387971}, 'multiverseid': 387971}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388240&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '29ec4799-c354-4924-a55f-0c122d1951b2', 'multiverseId': 388240}, 'multiverseid': 388240}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388509&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'fe390801-8e83-48f9-9ef7-b5e94312f489', 'multiverseId': 388509}, 'multiverseid': 388509}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388778&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '98868789-ddb6-41a9-af89-3bde65b63b83', 'multiverseId': 388778}, 'multiverseid': 388778}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389047&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4623b96b-b3a9-4557-bce4-9c6e8b8b3ee5', 'multiverseId': 389047}, 'multiverseid': 389047}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386895&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f1861212-2f3b-445b-9914-faffd7872118', 'multiverseId': 386895}, 'multiverseid': 386895}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387164&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '709cda41-62d7-43f1-9af7-2b126911a429', 'multiverseId': 387164}, 'multiverseid': 387164}]", '[{\'name\': \'Ehrwürdiger Lammasu\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Lammasu\', \'flavor\': \'Lammasu sind die rätselhaften Reisenden von Tarkir: Hoch in den Lüften segeln sie zu allen Jahreszeiten über das Land. Keiner kennt ihre wahre Absicht, doch oft erscheinen sie am Vorabend eines großen Konflikts oder an Wendepunkten der Geschichte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a27e9e6d-31b5-46b2-b6ea-4269cbbc1c18\', \'multiverseId\': 387520}, \'multiverseid\': 387520}, {\'name\': \'Lammasu venerable\', \'text\': \'Vuela.\', \'type\': \'Criatura — Lammasu\', \'flavor\': \'Los lammasu son los enigmáticos viajeros de Tarkir que sobrevuelan todas las tierras en todas las estaciones. Nadie conoce su auténtico propósito, pero a menudo llegan en la víspera de grandes conflictos o puntos de inflexión de la historia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebcec78e-1a0d-46d2-9929-5b9160c1fdfa\', \'multiverseId\': 389403}, \'multiverseid\': 389403}, {\'name\': \'Lamassu vénérable\', \'text\': \'Vol\', \'type\': \'Créature : lamassu\', \'flavor\': "Les lamassus sont des voyageurs énigmatiques de Tarkir, planant au-dessus des terres en toute saison. Nul ne connaît leur véritable raison d\'être, mais ils apparaissent souvent à la veille de grands conflits, ou de moments décisifs de l\'histoire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387789&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c5ee17a-c9be-4aa3-a01d-acc3722acdb2\', \'multiverseId\': 387789}, \'multiverseid\': 387789}, {\'name\': \'Lammasu Venerabile\', \'text\': \'Volare\', \'type\': \'Creatura — Lammasu\', \'flavor\': \'I lammasu, enigmatici viaggiatori di Tarkir, si librano alti sopra tutte le regioni in qualsiasi stagione. Nessuno ne conosce i veri scopi, ma giungono spesso alla vigilia di grandi battaglie o di momenti storici cruciali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388058&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'083889e4-f6e9-4fd2-a074-c026fc8174df\', \'multiverseId\': 388058}, \'multiverseid\': 388058}, {\'name\': \'尊いラマスー\', \'text\': \'飛行\', \'type\': \'クリーチャー — ラマスー\', \'flavor\': \'ラマスーは季節を通してタルキール全土の遥か上空を舞う、謎多きタルキールの放浪者である。彼らの真の目的を知る者は誰もいないが、大いなる戦乱や歴史の転換点の前にしばしば出現していると言われている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388327&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'89046334-13e5-4edf-85b8-9410df982eef\', \'multiverseId\': 388327}, \'multiverseid\': 388327}, {\'name\': \'존경받는 라마수\', \'text\': \'비행\', \'type\': \'생물 — 라마수\', \'flavor\': \'라마수는 사계절 내내 대지 위를 비행하는 타르커의 신비한 여행자다. 라마수의 진정한 목적은 아무도 모르지만, 주로 큰 전투나 역사적인 전환점의 전야에 나타난다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388596&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'401ce417-d8c1-41e1-8fe0-d3cebc3bc1f5\', \'multiverseId\': 388596}, \'multiverseid\': 388596}, {\'name\': \'Lammasu Venerável\', \'text\': \'Voar\', \'type\': \'Criatura — Lammasu\', \'flavor\': \'Os lammasu são viajantes enigmáticos de Tarkir, que sobrevoam todas as terras em todas as estações. Ninguém conhece seu verdadeiro propósito, mas eles costumam chegar às vésperas de grandes conflitos ou em momentos decisivos da história.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388865&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7bdc3e51-7561-4caa-a3ca-05993ce88f2d\', \'multiverseId\': 388865}, \'multiverseid\': 388865}, {\'name\': \'Почитаемый Ламмасу\', \'text\': \'Полет\', \'type\': \'Существо — Ламмасу\', \'flavor\': \'Ламмасу — загадочные странники Таркира, которых в любое время года можно увидеть высоко парящими над его землями. Никто не знает их истинного предназначения, но они часто становятся предвестниками яростных конфликтов или поворотных моментов в истории.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389134&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59b28e89-1b36-46a3-a578-32679f04f4dd\', \'multiverseId\': 389134}, \'multiverseid\': 389134}, {\'name\': \'高年拉玛苏\', \'text\': \'飞行\', \'type\': \'生物～拉玛苏\', \'flavor\': \'拉玛苏是鞑契的神秘旅人，终年高飞于万里长空，穿行世界。没人知道他们目的何在，不过常常能在历史剧变或转捩前夕见到他们的身影。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386982&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e4416764-4a55-4146-bdf4-e1835c567da7\', \'multiverseId\': 386982}, \'multiverseid\': 386982}, {\'name\': \'高年拉瑪蘇\', \'text\': \'飛行\', \'type\': \'生物～拉瑪蘇\', \'flavor\': \'拉瑪蘇是韃契的神秘旅人，終年高飛於萬里長空，穿行世界。沒人知道他們目的何在，不過常常能在歷史劇變或轉捩前夕見到他們的身影。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387251&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1c401274-b1e4-40f5-920c-c1ec67fe52b3\', \'multiverseId\': 387251}, \'multiverseid\': 387251}]', '[{\'name\': \'Eingeweihte des Wirbelwinds\', \'text\': \'Fluchsicher (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die deine Gegner kontrollieren.)\\nBravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\', \'type\': \'Kreatur — Dschinn, Mönch\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'679a3206-9ff2-4660-9fb0-3618a8895ab4\', \'multiverseId\': 387529}, \'multiverseid\': 387529}, {\'name\': \'Discípula de los torbellinos\', \'text\': \'Antimaleficio. (Esta criatura no puede ser objetivo de hechizos o habilidades que controlan tus oponentes.)\\nDestreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\', \'type\': \'Criatura — Monje djinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389412&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92df41e9-4def-4031-8d5d-3492e92903f4\', \'multiverseId\': 389412}, \'multiverseid\': 389412}, {\'name\': \'Adepte du tourbillon\', \'text\': "Défense talismanique (Cette créature ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.)\\nProuesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)", \'type\': \'Créature : djinn et moine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387798&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c99d7c3f-d7ba-4e45-9d97-ce2e68794237\', \'multiverseId\': 387798}, \'multiverseid\': 387798}, {\'name\': \'Esperta dei Turbini\', \'text\': \'Anti-malocchio (Questa creatura non può essere bersaglio di magie o abilità controllate dai tuoi avversari.)\\nProdezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\', \'type\': \'Creatura — Monaco Genio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388067&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e0b8c21-63ac-4017-91f5-78538d9a3aa8\', \'multiverseId\': 388067}, \'multiverseid\': 388067}, {\'name\': \'旋風の達人\', \'text\': \'呪禁（このクリーチャーは、対戦相手がコントロールする呪文や能力の対象にならない。）\\n果敢（あなたがクリーチャーでない呪文を１つ唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\', \'type\': \'クリーチャー — ジン・モンク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388336&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1fc9a1ee-470d-4c89-b7f7-cc40ba37ef45\', \'multiverseId\': 388336}, \'multiverseid\': 388336}, {\'name\': \'회오리바람 조작술사\', \'text\': \'방호 (이 생물은 당신의 상대들이 조종하는 주문이나 능력의 목표로 정해질 수 없다.)\\n기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\', \'type\': \'생물 — 지니 승려\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388605&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0aecbd1e-3a3a-4d4b-a831-9f851aae0744\', \'multiverseId\': 388605}, \'multiverseid\': 388605}, {\'name\': \'Adepto do Redemoinho\', \'text\': \'Resistência a magia (Esta criatura não pode ser alvo de mágicas nem de habilidades que seus oponentes controlam.)\\nDestreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\', \'type\': \'Criatura — Gênio Monge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388874&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'75a4e96c-de19-4db4-a497-cd4aae7f6f1a\', \'multiverseId\': 388874}, \'multiverseid\': 388874}, {\'name\': \'Адепт Вихря\', \'text\': \'Порчеустойчивость (Это существо не может быть целью заклинаний или способностей под контролем ваших оппонентов.)\\nИскусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\', \'type\': \'Существо — Джинн Монах\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389143&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f4f393b-4649-4aec-b24f-e56abde022f1\', \'multiverseId\': 389143}, \'multiverseid\': 389143}, {\'name\': \'旋风高手\', \'text\': \'辟邪（此生物不能成为由对手所操控之咒语或异能的目标。）\\n灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\', \'type\': \'生物～巨灵／修行僧\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386991&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'78c49502-6e40-4c6f-b6ba-895a96a912ea\', \'multiverseId\': 386991}, \'multiverseid\': 386991}, {\'name\': \'旋風高手\', \'text\': \'辟邪（此生物不能成為由對手所操控之咒語或異能的目標。）\\n靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\', \'type\': \'生物～巨靈／修行僧\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387260&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'926c1c69-b7f5-4dfb-843f-425f5f42d56e\', \'multiverseId\': 387260}, \'multiverseid\': 387260}]', '[{\'name\': \'Eiskalter Strahl\', \'text\': \'Tappe X Kreaturen deiner Wahl.\\nWildheit — Falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, enttappen diese Kreaturen nicht während des nächsten Enttappsegments ihrer Beherrscher.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Weder Sand noch Sonne werden den Atem des Winters fernhalten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387370&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79a175a2-078a-4f62-a357-ae84957d86c3\', \'multiverseId\': 387370}, \'multiverseid\': 387370}, {\'name\': \'Ráfaga helada\', \'text\': \'Gira X criaturas objetivo.\\nFerocidad — Si controlas una criatura con fuerza de 4 o más, esas criaturas no se enderezan durante el próximo paso de enderezar de sus controladores.\', \'type\': \'Instantáneo\', \'flavor\': \'"No crean que la arena o el sol serán capaces de contener el gélido aliento del invierno".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389253&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85cfe17d-030a-45b6-a552-8b6f385dfed1\', \'multiverseId\': 389253}, \'multiverseid\': 389253}, {\'name\': \'Salve glaciale\', \'text\': \'Engagez X créatures ciblées.\\nFérocité — Si vous contrôlez une créature avec une force supérieure ou égale à 4, ces créatures ne se dégagent pas pendant la prochaine étape de dégagement de leurs contrôleurs.\', \'type\': \'Éphémère\', \'flavor\': "« Ne croyez pas que le sable ou le soleil retiendront le souffle de l\'hiver. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387639&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'014b6c7c-39e6-4b3b-8f1a-5b92f7e8677e\', \'multiverseId\': 387639}, \'multiverseid\': 387639}, {\'name\': \'Esplosione Ghiacciata\', \'text\': \'TAPpa X creature bersaglio.\\nFerocia — Se controlli una creatura con forza pari o superiore a 4, quelle creature non STAPpano durante il prossimo STAP dei rispettivi controllori.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non illudetevi che la sabbia o il sole possano arginare il respiro dell\\\'inverno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387908&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc26d02f-1413-4328-9e21-9d5b2fbafede\', \'multiverseId\': 387908}, \'multiverseid\': 387908}, {\'name\': \'凍氷破\', \'text\': \'クリーチャーＸ体を対象とし、それらをタップする。\\n獰猛 ― あなたがパワーが４以上のクリーチャーをコントロールしているなら、それらのクリーチャーは、それらのコントローラーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'インスタント\', \'flavor\': \'「砂や太陽で冬の息吹を止められると思うな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388177&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb2b2c6a-9251-47d2-a292-1f686e56e7fb\', \'multiverseId\': 388177}, \'multiverseid\': 388177}, {\'name\': \'한기폭발\', \'text\': \'생물 X개를 목표로 정한다. 그 생물들을 탭한다.\\n흉포 — 그 생물들은 당신이 공격력이 4 이상인 생물을 조종한다면 조종자의 다음 언탭단에 언탭되지 않는다.\', \'type\': \'순간마법\', \'flavor\': \'"모래나 태양이 겨울의 숨결을 저지할 것이라 생각하지 마라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388446&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'50a5788b-ba14-4498-a943-5f0497fc8e04\', \'multiverseId\': 388446}, \'multiverseid\': 388446}, {\'name\': \'Rajada Gélida\', \'text\': \'Vire X criaturas alvo.\\nFeroz — Se você controlar uma criatura com poder igual ou superior a 4, aquelas criaturas não serão desviradas durante a próxima etapa de desvirar de seus controladores.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Não pense que a areia ou o sol impedirão o sopro do inverno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388715&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'601200cb-6927-4e49-97de-6f34b26c50c4\', \'multiverseId\': 388715}, \'multiverseid\': 388715}, {\'name\': \'Ледяной Взрыв\', \'text\': \'Поверните X целевых существ.\\nСвирепость — Если вы контролируете существо с силой не менее 4, те существа не разворачиваются во время следующего шага разворота контролирующих их игроков.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Не думай, что песок или солнце смогут сдержать дыхание зимы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388984&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d3b8210e-e13b-4a95-97c0-ace6492a3cc1\', \'multiverseId\': 388984}, \'multiverseid\': 388984}, {\'name\': \'寒冰冲击\', \'text\': \'横置X个目标生物。\\n威猛～如果你操控力量等于或大于4的生物，则受影响的生物于其操控者的下一个重置步骤中不能重置。\', \'type\': \'瞬间\', \'flavor\': \'「不要以为黄砂或烈日就能阻挡寒冬吐息。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386832&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d8f488a0-5614-44d2-8bed-6f70c9e40530\', \'multiverseId\': 386832}, \'multiverseid\': 386832}, {\'name\': \'寒冰衝擊\', \'text\': \'橫置X個目標生物。\\n威猛～如果你操控力量等於或大於4的生物，則受影響的生物於其操控者的下一個重置步驟中不能重置。\', \'type\': \'瞬間\', \'flavor\': \'「不要以為黃砂或烈日就能阻擋寒冬吐息。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387101&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9c814c3f-283b-491d-b93f-9ea8420fb02f\', \'multiverseId\': 387101}, \'multiverseid\': 387101}]', '[{\'name\': \'Ende der Feindseligkeiten\', \'text\': \'Zerstöre alle Kreaturen und alle bleibenden Karten, die an Kreaturen angelegt sind.\', \'type\': \'Hexerei\', \'flavor\': \'Ihre Handfläche flammte auf wie das Auge eines erwachenden Drachen. Dann war alles ruhig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387339&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f395a4e5-d7fd-4617-bb32-05c9c6751412\', \'multiverseId\': 387339}, \'multiverseid\': 387339}, {\'name\': \'Terminar con las hostilidades\', \'text\': \'Destruye todas las criaturas y todos los permanentes anexados a criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'La palma de su mano centelleó como el ojo de un dragón que despierta. Después solo hubo calma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389222&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d7c030a1-d7d6-4a34-9cda-dab644636e43\', \'multiverseId\': 389222}, \'multiverseid\': 389222}, {\'name\': \'Mettre fin aux hostilités\', \'text\': \'Détruisez toutes les créatures et tous les permanents attachés aux créatures.\', \'type\': \'Rituel\', \'flavor\': "Sa paume flamboya tel l\'œil incandescent d\'un dragon qui s\'éveille. Puis tout redevint calme.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387608&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e322d05-e38e-4072-96c2-36f571191bd5\', \'multiverseId\': 387608}, \'multiverseid\': 387608}, {\'name\': \'Cessare le Ostilità\', \'text\': \'Distruggi tutte le creature e tutti i permanenti assegnati alle creature.\', \'type\': \'Stregoneria\', \'flavor\': "Il suo palmo avvampò come l\'occhio di un drago al risveglio. Poi tutto fu quiete.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387877&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'826b6411-01ce-4287-943f-21660a4d414c\', \'multiverseId\': 387877}, \'multiverseid\': 387877}, {\'name\': \'対立の終結\', \'text\': \'すべてのクリーチャーと、クリーチャーにつけられているすべてのパーマネントを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'彼女の掌は目覚めた龍の目のごとく輝きだした。その後には静寂だけが残った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388146&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'092c24ad-d998-4453-9137-7067d54c4d76\', \'multiverseId\': 388146}, \'multiverseid\': 388146}, {\'name\': \'전투 종결\', \'text\': \'모든 생물과 생물에 부착된 모든 지속물을 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'깨어나는 용의 눈과 같은 섬광이 그녀의 손바닥에서 일어나자 고요함만이 남았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388415&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'56a19b0f-a560-465d-9abf-5067d9d4aaea\', \'multiverseId\': 388415}, \'multiverseid\': 388415}, {\'name\': \'Findar Hostilidades\', \'text\': \'Destrua todas as criaturas e todas as permanentes anexadas a criaturas.\', \'type\': \'Feitiço\', \'flavor\': \'A palma dela brilhou como o olho de um dragão desperto. Então, tudo ficou calmo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388684&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cfca6789-4e56-45f0-8c76-987b5002fb8c\', \'multiverseId\': 388684}, \'multiverseid\': 388684}, {\'name\': \'Прекратить Битвы\', \'text\': \'Уничтожьте все существа и все прикрепленные к существам перманенты.\', \'type\': \'Волшебство\', \'flavor\': \'Ее ладонь вспыхнула, словно глаз проснувшегося дракона. Затем стало тихо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388953&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'87e9aacd-be42-4237-a477-675d35098145\', \'multiverseId\': 388953}, \'multiverseid\': 388953}, {\'name\': \'止战宁息\', \'text\': \'消灭所有生物和所有结附或装备在生物上的永久物。\', \'type\': \'法术\', \'flavor\': \'她掌心微光闪烁，正如苏醒巨龙明澈的双目。转瞬之间一切都归于平静。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386801&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e8b60e8-8090-401c-a6eb-60e271e3aec2\', \'multiverseId\': 386801}, \'multiverseid\': 386801}, {\'name\': \'止戰寧息\', \'text\': \'消滅所有生物和所有結附或裝備在生物上的永久物。\', \'type\': \'巫術\', \'flavor\': \'她掌心微光閃爍，正如甦醒巨龍明澈的雙目。轉瞬之間一切都歸於平靜。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387070&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4b839ad3-dfb6-42bd-befd-40c42fc3cf20\', \'multiverseId\': 387070}, \'multiverseid\': 387070}]', '[{\'name\': \'Erbe der Wildnis\', \'text\': \'Todesberührung\\nWildheit — Immer wenn der Erbe der Wildnis angreift und falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, erhält der Erbe der Wildnis +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'In den hochgelegenen Höhlen der Qal-Sisma-Berge versuchen junge Jäger die Echos ihrer wilden Vorfahren zu hören.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387359&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2877d472-a207-4f26-8ef0-945f70d67953\', \'multiverseId\': 387359}, \'multiverseid\': 387359}, {\'name\': \'Heredero de las tierras salvajes\', \'text\': \'Toque mortal.\\nFerocidad — Siempre que el Heredero de las tierras salvajes ataque, si controlas una criatura con fuerza de 4 o más, el Heredero de las tierras salvajes obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'En las altas cuevas de las montañas Qal Sisma, los jóvenes cazadores se aventuran para oír los ecos de sus fieros ancestros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389242&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'56a70d5c-907d-4d16-b423-e37ac727978b\', \'multiverseId\': 389242}, \'multiverseid\': 389242}, {\'name\': \'Héritier des terres sauvages\', \'text\': "Contact mortel\\nFérocité — À chaque fois que l\'Héritier des terres sauvages attaque, si vous contrôlez une créature avec une force supérieure ou égale à 4, l\'Héritier des terres sauvages gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'Dans les hautes cavernes des montagnes de Qal Sisma, les jeunes chasseurs partent en quête des échos de leurs redoutables ancêtres.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387628&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fedaee06-8ec5-4502-82a3-5d421600e1b6\', \'multiverseId\': 387628}, \'multiverseid\': 387628}, {\'name\': \'Erede delle Terre Selvagge\', \'text\': "Tocco letale\\nFerocia — Ogniqualvolta l\'Erede delle Terre Selvagge attacca, se controlli una creatura con forza pari o superiore a 4, l\'Erede delle Terre Selvagge prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Nelle caverne sulle cime dei monti di Qal Sisma, i giovani cacciatori vanno alla ricerca degli echi dei loro fieri antenati.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387897&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe67dcc6-ab4b-4364-8171-38c518dd5b90\', \'multiverseId\': 387897}, \'multiverseid\': 387897}, {\'name\': \'荒野の後継者\', \'text\': \'接死\\n獰猛 ― 荒野の後継者が攻撃するたび、あなたがパワーが４以上のクリーチャーをコントロールしている場合、ターン終了時まで、荒野の後継者は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'カル・シスマ山脈の高い場所にある洞窟の中で、勇猛であった祖先らの残響を聞き出そうと若き狩猟者たちは探索を続ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388166&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86f46264-1c8f-4dd4-8146-f9ea3667f9ec\', \'multiverseId\': 388166}, \'multiverseid\': 388166}, {\'name\': \'야생의 계승자\', \'text\': \'치명타\\n흉포 — 야생 계승자가 공격할 때마다, 당신이 공격력이 4 이상인 생물을 조종한다면 야생 계승자는 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'어린 사냥꾼들은 칼 시스마 산맥의 고산동굴에서 맹렬한 조상들의 울림을 찾는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388435&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cc84b953-7bec-4582-89af-3180db69a4be\', \'multiverseId\': 388435}, \'multiverseid\': 388435}, {\'name\': \'Herdeiro do Mundo Selvagem\', \'text\': \'Toque mortífero\\nFeroz — Toda vez que Herdeiro do Mundo Selvagem atacar, se você controlar uma criatura com poder igual ou superior a 4, Herdeiro do Mundo Selvagem ganhará +1/+1 até o final do turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Nas cavernas altas das montanhas de Qal Sisma, jovens caçadores fazem uma jornada para ouvir os ecos de seus poderosos antecessores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a868cb79-aba7-48fe-8c52-015ab1f15b6a\', \'multiverseId\': 388704}, \'multiverseid\': 388704}, {\'name\': \'Наследник Дебрей\', \'text\': \'Смертельное касание\\nСвирепость — Каждый раз, когда Наследник Дебрей атакует, если вы контролируете существо с силой не менее 4, Наследник Дебрей получает +1/+1 до конца хода.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'В пещерах среди вершин гор Кэл-Сизма молодые охотники учатся слушать эхо голосов своих свирепых предков.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388973&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'15d53dae-d4fe-452c-96d0-da7af3744e2a\', \'multiverseId\': 388973}, \'multiverseid\': 388973}, {\'name\': \'蛮荒传人\', \'text\': \'死触\\n威猛～每当蛮荒传人攻击时，若你操控力量等于或大于4的生物，则蛮荒传人得+1/+1直到回合结束。\', \'type\': \'生物～人类／战士\', \'flavor\': \'年轻的猎人探索黑山深处的洞窟，希冀听闻凶猛祖灵的呼号回响。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386821&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87979fec-d447-4132-b20e-7960c5f5fc8d\', \'multiverseId\': 386821}, \'multiverseid\': 386821}, {\'name\': \'蠻荒傳人\', \'text\': \'死觸\\n威猛～每當蠻荒傳人攻擊時，若你操控力量等於或大於4的生物，則蠻荒傳人得+1/+1直到回合結束。\', \'type\': \'生物～人類／戰士\', \'flavor\': \'年輕的獵人探索黑山深處的洞窟，希冀聽聞凶猛祖靈的呼號迴響。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387090&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1934cba0-e3b2-47d2-81d6-3f75677e4c84\', \'multiverseId\': 387090}, \'multiverseid\': 387090}]', "[{'name': 'Erblühender Sand', 'text': 'Der Erblühende Sand kommt getappt ins Spiel.\\nWenn der Erblühende Sand ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {G} oder {W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387303&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4474b19d-a368-418d-a2f6-320786030316', 'multiverseId': 387303}, 'multiverseid': 387303}, {'name': 'Arenas florecientes', 'text': 'Las Arenas florecientes entran al campo de batalla giradas.\\nCuando las Arenas florecientes entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {G} o {W} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389186&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3d03e8ab-9ad8-46e3-b413-236367907171', 'multiverseId': 389186}, 'multiverseid': 389186}, {'name': 'Sables verdoyants', 'text': 'Les Sables verdoyants arrivent sur le champ de bataille engagés.\\nQuand les Sables verdoyants arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {G} ou {W} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387572&type=card', 'language': 'French', 'identifiers': {'scryfallId': '51e4959b-81fd-4db1-a0bf-4fabdbae8928', 'multiverseId': 387572}, 'multiverseid': 387572}, {'name': 'Sabbie Verdeggianti', 'text': 'Le Sabbie Verdeggianti entrano nel campo di battaglia TAPpate.\\nQuando le Sabbie Verdeggianti entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {G} o {W} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387841&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6081ac87-8879-4ea6-9a8c-963e3d47ac17', 'multiverseId': 387841}, 'multiverseid': 387841}, {'name': '花咲く砂地', 'text': '花咲く砂地はタップ状態で戦場に出る。\\n花咲く砂地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{G}か{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388110&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1ed2f4a4-a96d-4da0-bff3-57e711b48796', 'multiverseId': 388110}, 'multiverseid': 388110}, {'name': '꽃피는 사막', 'text': '꽃피는 사막은 탭된 채로 전장에 들어온다.\\n꽃피는 사막이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {G} 또는 {W}를 당신의 마나풀에 담는다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388379&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a680dc8a-7fd3-4f29-830f-9df80b5cce01', 'multiverseId': 388379}, 'multiverseid': 388379}, {'name': 'Areias Verdejantes', 'text': 'Areias Verdejantes entra no campo de batalha virado.\\nQuando Areias Verdejantes entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {G} ou {W} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388648&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '29d82702-3a96-4bf3-b341-edecfaf190ee', 'multiverseId': 388648}, 'multiverseid': 388648}, {'name': 'Цветущие Пески', 'text': 'Цветущие Пески выходят на поле битвы повернутыми.\\nКогда Цветущие Пески выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {G} или {W} в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388917&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2d356020-3902-444f-9b39-41fc377f925a', 'multiverseId': 388917}, 'multiverseid': 388917}, {'name': '繁花沙洲', 'text': '繁花沙洲须横置进战场。\\n当繁花沙洲进战场时，你获得1点生命。\\n{T}：加{G}或{W}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386765&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a3827028-5a84-4f87-9611-e5ab3e48f391', 'multiverseId': 386765}, 'multiverseid': 386765}, {'name': '繁花沙洲', 'text': '繁花沙洲須橫置進戰場。\\n當繁花沙洲進戰場時，你獲得1點生命。\\n{T}：加{G}或{W}到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387034&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'da84b25a-d3bf-4902-97c0-ec3fb8ced4c6', 'multiverseId': 387034}, 'multiverseid': 387034}]", '[{\'name\': \'Erdrosseln\', \'text\': \'Eine Kreatur deiner Wahl erhält -4/-4 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die besten Diener geben jene ab, die starben, ohne einen Kratzer zu nehmen." —Sidisi, Khan der Sultai\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'661de8cf-9a11-451f-9f2a-fb86b78112e3\', \'multiverseId\': 387505}, \'multiverseid\': 387505}, {\'name\': \'Estrangular\', \'text\': \'La criatura objetivo obtiene -4/-4 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los mejores sirvientes están hechos de aquellos que murieron sin un arañazo". —Sidisi, kan de los Sultai\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389388&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e39c340-1902-4f3d-8459-01133df6584c\', \'multiverseId\': 389388}, \'multiverseid\': 389388}, {\'name\': \'Étranglement\', \'text\': "La créature ciblée gagne -4/-4 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Les meilleurs serviteurs sont ceux qui ont péri sans égratignures. » —Sidisi, khan des Sultaï\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387774&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7fe9069-b773-4232-a28c-0c504f02eb1b\', \'multiverseId\': 387774}, \'multiverseid\': 387774}, {\'name\': \'Strozzare\', \'text\': \'Una creatura bersaglio prende -4/-4 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"I servi migliori si ricavano dai cadaveri morti senza un graffio." —Sidisi, khan dei Sultai\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388043&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fbbdd8a6-6c82-4c77-87aa-2e03c0c58f31\', \'multiverseId\': 388043}, \'multiverseid\': 388043}, {\'name\': \'絞首\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは－４/－４の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「かすり傷ひとつなく死んだ者が、一番良い召使の素材となる。」 ――スゥルタイのカン、シディシ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388312&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2dc99ee-a70d-4d31-8f73-044972b84cef\', \'multiverseId\': 388312}, \'multiverseid\': 388312}, {\'name\': \'목조르기\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 -4/-4를 받는다.\', \'type\': \'순간마법\', \'flavor\': \'"생채기 하나 없이 죽은 자들은 최고의 하수인으로 태어난다." —술타이의 칸 시디시\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388581&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c0d5a5ba-e18a-44cd-be7e-e9e6460f8f8e\', \'multiverseId\': 388581}, \'multiverseid\': 388581}, {\'name\': \'Estrangular\', \'text\': \'A criatura alvo recebe -4/-4 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os melhores servos são feitos daqueles que morreram sem nenhum arranhão." —Sidisi, khan dos Sultai\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388850&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7caa2bb-883f-4c1e-83cf-5ebf6ee66c51\', \'multiverseId\': 388850}, \'multiverseid\': 388850}, {\'name\': \'Удавить\', \'text\': \'Целевое существо получает -4/-4 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Лучшие слуги получаются из тех, кто умер, не получив ни царапины». — Сидиси, хан Султая\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389119&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51bab703-2a64-497e-8bd2-044ce5aa5d85\', \'multiverseId\': 389119}, \'multiverseid\': 389119}, {\'name\': \'勒杀\', \'text\': \'目标生物得-4/-4直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「留得全尸的死者才是最好的仆役。」 ～苏勒台可汗谢迪西\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386967&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'32137dfa-2133-44d2-a407-615a83fbd1b2\', \'multiverseId\': 386967}, \'multiverseid\': 386967}, {\'name\': \'勒殺\', \'text\': \'目標生物得-4/-4直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'「留得全屍的死者才是最好的僕役。」 ～蘇勒台可汗謝迪西\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387236&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e160b90d-3456-43fb-8c84-6415beb8f650\', \'multiverseId\': 387236}, \'multiverseid\': 387236}]', '[{\'name\': \'Essenz einfangen\', \'text\': \'Neutralisiere einen Kreaturenzauber deiner Wahl. Lege zwei +1/+1-Marken auf bis zu eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Fleisch erhält den Körper. Der Geist braucht andere Nahrung." —Arel die Flüsterin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7dddf27d-d42f-49ac-a272-54325a678e24\', \'multiverseId\': 387511}, \'multiverseid\': 387511}, {\'name\': \'Atrapar la esencia\', \'text\': \'Contrarresta el hechizo objetivo de criatura. Pon dos contadores +1/+1 sobre hasta una criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"La carne sustenta el cuerpo. El espíritu necesita un sustento de otra clase". —Arel la Susurradora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389394&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79e05f48-ffc6-4827-ae32-50c9e26bea91\', \'multiverseId\': 389394}, \'multiverseid\': 389394}, {\'name\': "Figer l\'essence", \'text\': "Contrecarrez le sort de créature ciblé. Mettez deux marqueurs +1/+1 sur jusqu\'à une créature ciblée.", \'type\': \'Éphémère\', \'flavor\': "« La viande nourrit le corps. L\'esprit, lui, requiert une alimentation d\'une autre nature. » —Arel la Chuchoteuse", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387780&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5bd07a4-c936-4b40-9f66-f528ab5fd3e3\', \'multiverseId\': 387780}, \'multiverseid\': 387780}, {\'name\': "Intrappolare l\'Essenza", \'text\': \'Neutralizza una magia creatura bersaglio. Scegli fino a una creatura bersaglio. Metti due segnalini +1/+1 su di essa.\', \'type\': \'Istantaneo\', \'flavor\': \'"La carne sfama il corpo. Lo spirito necessita di un diverso nutrimento." —Arel la Sussurratrice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388049&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7c568579-2e60-4e26-94a8-345410b79c3a\', \'multiverseId\': 388049}, \'multiverseid\': 388049}, {\'name\': \'本質捕らえ\', \'text\': \'クリーチャー・呪文１つと、クリーチャー最大１体までを対象とする。その前者を打ち消す。その後者の上に＋１/＋１カウンターを２個置く。\', \'type\': \'インスタント\', \'flavor\': \'「肉は体を維持します。魂は別の栄養源を必要とします。」 ――囁く者、アレル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388318&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'046684e2-1041-4878-b60d-2fc1a890300c\', \'multiverseId\': 388318}, \'multiverseid\': 388318}, {\'name\': \'정수 가두기\', \'text\': \'생물 주문을 목표로 정한다. 그 주문을 무효화한다. 최대 한 개까지의 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 두 개를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'"신체는 고기를 먹어야 유지된다. 영혼은 다른 영양분이 필요하다." —속삭이는 아렐\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388587&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bb87a1a6-f918-4d0d-ae2a-89c2a71ce695\', \'multiverseId\': 388587}, \'multiverseid\': 388587}, {\'name\': \'Prender Essência\', \'text\': \'Anule a mágica de criatura alvo. Coloque dois marcadores +1/+1 em até uma criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A carne nutre o corpo. O espírito precisa de outro tipo de nutrição." — Arel, a Sussurradora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27d81c6b-138c-4a67-9646-de771e6506ec\', \'multiverseId\': 388856}, \'multiverseid\': 388856}, {\'name\': \'Поймать Сущность\', \'text\': \'Отмените целевое заклинание существа. Положите два жетона +1/+1 на не более чем одно целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мясом питается тело. Духу нужна другая пища». — Арель Шепчущая\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389125&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3b60541c-ef47-4c5c-93ff-9f92e9638ac9\', \'multiverseId\': 389125}, \'multiverseid\': 389125}, {\'name\': \'诱捕菁华\', \'text\': \'反击目标生物咒语。在至多一个目标生物上放置两个+1/+1指示物。\', \'type\': \'瞬间\', \'flavor\': \'「躯体靠血肉维系。灵魂的寄托则有所不同。」 ～低语者阿瑞尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386973&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f23f9490-2a08-45db-b3b2-9084e351946c\', \'multiverseId\': 386973}, \'multiverseid\': 386973}, {\'name\': \'誘捕菁華\', \'text\': \'反擊目標生物咒語。在至多一個目標生物上放置兩個+1/+1指示物。\', \'type\': \'瞬間\', \'flavor\': \'「軀體靠血肉維繫。靈魂的寄託則有所不同。」 ～低語者阿瑞爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387242&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ca034b0a-31fe-4644-8a97-53332a9e48bd\', \'multiverseId\': 387242}, \'multiverseid\': 387242}]', '[{\'name\': \'Felsbeschuss\', \'text\': \'Der Felsbeschuss fügt jeder Kreatur, die du nicht kontrollierst, 1 Schadenspunkt zu.\\nWildheit — Falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, können Kreaturen in diesem Zug nicht blocken.\', \'type\': \'Hexerei\', \'flavor\': \'Primitive Taktiken können trotzdem effektiv sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387292&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8d7c0a9-ec89-4851-a193-90f572990e4d\', \'multiverseId\': 387292}, \'multiverseid\': 387292}, {\'name\': \'Bombardeo de rocas\', \'text\': \'El Bombardeo de rocas hace 1 punto de daño a cada criatura que no controlas.\\nFerocidad — Si controlas una criatura con fuerza de 4 o más, las criaturas no pueden bloquear este turno.\', \'type\': \'Conjuro\', \'flavor\': \'Las tácticas toscas pueden no obstante ser eficaces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389175&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e00aa625-f8e0-41bc-948d-ad1ffd31e0c0\', \'multiverseId\': 389175}, \'multiverseid\': 389175}, {\'name\': \'Barrage de rochers\', \'text\': \'Le Barrage de rochers inflige 1 blessure à chaque créature que vous ne contrôlez pas.\\nFérocité — Si vous contrôlez une créature avec une force supérieure ou égale à 4, les créatures ne peuvent pas bloquer ce tour-ci.\', \'type\': \'Rituel\', \'flavor\': "Les tactiques grossières n\'en sont pas moins efficaces.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387561&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3caf45c-978e-4ea0-8bed-b0b1033bbb9d\', \'multiverseId\': 387561}, \'multiverseid\': 387561}, {\'name\': \'Bombardamento di Massi\', \'text\': \'Il Bombardamento di Massi infligge 1 danno a ogni creatura che non controlli.\\nFerocia — Se controlli una creatura con forza pari o superiore a 4, le creature non possono bloccare in questo turno.\', \'type\': \'Stregoneria\', \'flavor\': \'Anche le strategie più primitive possono comunque essere efficaci.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387830&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82deea84-1754-44d9-b257-5e120846af27\', \'multiverseId\': 387830}, \'multiverseid\': 387830}, {\'name\': \'石弾の弾幕\', \'text\': \'石弾の弾幕は、あなたがコントロールしていない各クリーチャーにそれぞれ１点のダメージを与える。\\n獰猛 ― あなたがパワーが４以上のクリーチャーをコントロールしているなら、このターン、クリーチャーではブロックできない。\', \'type\': \'ソーサリー\', \'flavor\': \'洗練されていない戦略もそれなりに効果を発揮する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388099&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9606f424-b821-4459-9929-cf951f23602b\', \'multiverseId\': 388099}, \'multiverseid\': 388099}, {\'name\': \'낙석 더미\', \'text\': \'낙석 더미는 당신이 조종하지 않는 각 생물에게 피해 1점을 입힌다.\\n흉포 — 당신이 공격력이 4 이상인 생물을 조종한다면, 생물들은 이 턴에 방어할 수 없다.\', \'type\': \'집중마법\', \'flavor\': \'조잡한 전술이라도 효과적일 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388368&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3ee56462-ae1c-4e61-85fc-4fb24e3f7507\', \'multiverseId\': 388368}, \'multiverseid\': 388368}, {\'name\': \'Barragem de Pedregulhos\', \'text\': \'Barragem de Pedregulhos causa 1 ponto de dano a cada criatura que você não controla.\\nFeroz — Se você controla uma criatura com poder igual ou superior a 4, as criaturas não podem bloquear neste turno.\', \'type\': \'Feitiço\', \'flavor\': \'Táticas rudimentares podem ser eficientes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388637&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ec1af0c-ef97-4eb3-a230-7215d13322a2\', \'multiverseId\': 388637}, \'multiverseid\': 388637}, {\'name\': \'Град Булыжников\', \'text\': \'Град Булыжников наносит 1 повреждение каждому существу не под вашим контролем.\\nСвирепость — Если вы контролируете существо с силой не менее 4, существа не могут блокировать в этом ходу.\', \'type\': \'Волшебство\', \'flavor\': \'Самая грубая тактика может оказаться весьма действенной.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388906&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'94f0fe80-2d3d-46a9-8ae8-7c3c0e9b64ed\', \'multiverseId\': 388906}, \'multiverseid\': 388906}, {\'name\': \'巨石齐落\', \'text\': \'巨石齐落对每个不由你操控的生物各造成1点伤害。\\n威猛～如果你操控力量等于或大于4的生物，则生物本回合不能进行阻挡。\', \'type\': \'法术\', \'flavor\': \'战术虽然粗糙，却依然有效。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386754&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'25065dd9-e87e-4adb-80cf-deb79d51fbe9\', \'multiverseId\': 386754}, \'multiverseid\': 386754}, {\'name\': \'巨石齊落\', \'text\': \'巨石齊落對每個不由你操控的生物各造成1點傷害。\\n威猛～如果你操控力量等於或大於4的生物，則生物本回合不能進行阻擋。\', \'type\': \'巫術\', \'flavor\': \'戰術雖然粗糙，卻依然有效。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387023&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c2b9d245-ee7d-4c55-b05e-f8c380f5cd42\', \'multiverseId\': 387023}, \'multiverseid\': 387023}]', '[{\'name\': \'Feuchtlandsambar\', \'type\': \'Kreatur — Hirsch\', \'flavor\': \'Als Prüfung in Ruhe und Mitgefühl nähert sich ein Jeskai-Mönch behutsam einem grasenden Sambar und bietet ihm einen Lotus aus seiner Hand an. Wenn die Kreatur frisst, steigt der Schüler zur nächsten Ausbildungsstufe auf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387528&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'571914be-6046-43c9-987b-af530ac42f85\', \'multiverseId\': 387528}, \'multiverseid\': 387528}, {\'name\': \'Sambar del pantano\', \'type\': \'Criatura — Alce\', \'flavor\': \'Como prueba de calma y compasión, el monje jeskai se acerca suavemente a un sambar mientras pasta y le ofrece un loto de su propia mano. Si la criatura come, el estudiante asciende al siguiente nivel de entrenamiento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389411&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'28ee874b-0148-49a3-a4ba-9b96b829e6e3\', \'multiverseId\': 389411}, \'multiverseid\': 389411}, {\'name\': \'Sambar des marécages\', \'type\': \'Créature : élan\', \'flavor\': "Pour prouver son calme et sa compassion, un moine jeskaï doit s\'approcher d\'un sambar paissant et lui tendre un lotus. Si la créature le mange, l\'élève peut poursuivre l\'entraînement.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387797&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f983bd31-18b3-41b2-bb51-1fbd7b8e02b6\', \'multiverseId\': 387797}, \'multiverseid\': 387797}, {\'name\': \'Sambar degli Acquitrini\', \'type\': \'Creatura — Alce\', \'flavor\': \'Come prova di calma e compassione, i monaci Jeskai si avvicinano lentamente a un sambar al pascolo e gli offrono con la mano un loto. Se la creatura lo mangia, lo studente procede al livello successivo del noviziato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388066&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60ed5022-ad4e-48ab-ae35-19538f281fc3\', \'multiverseId\': 388066}, \'multiverseid\': 388066}, {\'name\': \'湿地帯の水鹿\', \'type\': \'クリーチャー — 大鹿\', \'flavor\': \'冷静さと慈愛の試練として、ジェスカイの僧は草を食む水鹿に静かに近づき、その手で蓮の花を差し出す。水鹿がそれを食せば、その見習いは訓練の次の段階に進むことができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388335&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5a2bf43f-912d-4da3-85bd-703ed0083fae\', \'multiverseId\': 388335}, \'multiverseid\': 388335}, {\'name\': \'습지 삼바\', \'type\': \'생물 — 엘크\', \'flavor\': \'제스카이 승려는 풀을 뜯는 삼바에게 자신의 손으로 연꽃을 내밀어 평온과 자비심을 시험받는다. 삼바가 연꽃을 먹으면 다음 수련 단계로 넘어간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388604&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0bff149d-fb84-47ad-9fcc-acaaa080edce\', \'multiverseId\': 388604}, \'multiverseid\': 388604}, {\'name\': \'Sâmbar do Charco\', \'type\': \'Criatura — Alce\', \'flavor\': \'Como um teste de calma e compaixão, um monge Jeskai se aproxima calmamente de um sâmbar que pasta e oferece a ele uma lótus em sua mão. Se a criatura comer, o estudante ascende ao próximo nível de treinamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388873&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ca335714-20e2-4c3b-a935-8e43941f0d12\', \'multiverseId\': 388873}, \'multiverseid\': 388873}, {\'name\': \'Болотный Замбар\', \'type\': \'Существо — Вапити\', \'flavor\': \'В испытании спокойствия и сопереживания джескайский монах медленно подходит к пасущемуся замбару и предлагает ему лотос из своих рук. Если зверь съедает цветок, ученик переходит на новую ступень обучения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389142&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6f0c61ea-1d37-4546-b6e5-c6cf93533faa\', \'multiverseId\': 389142}, \'multiverseid\': 389142}, {\'name\': \'湿地水鹿\', \'type\': \'生物～麋鹿\', \'flavor\': \'洁斯凯测试僧徒是否已静心向善，便是派他手持莲花蹑脚步至食草水鹿跟前喂食。如果水鹿吃下了莲花，这名僧徒就能接受下一阶段的训练。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386990&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f2f32f23-6e5d-4466-a563-62cfd6520c17\', \'multiverseId\': 386990}, \'multiverseid\': 386990}, {\'name\': \'濕地水鹿\', \'type\': \'生物～麋鹿\', \'flavor\': \'潔斯凱測試僧徒是否已靜心向善，便是派他手持蓮花躡腳步至食草水鹿跟前餵食。如果水鹿吃下了蓮花，這名僧徒就能接受下一階段的訓練。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387259&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c967fef0-a1b9-483d-8795-33de6eb539c5\', \'multiverseId\': 387259}, \'multiverseid\': 387259}]', '[{\'name\': \'Flammenhuf-Kavallerie\', \'text\': \'{3}{R}: Die Flammenhuf-Kavallerie erhält +2/+0 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Berserker\', \'flavor\': \'„Welcher Krieger, der dieses Namens wert ist, fürchtet sich, eine Spur zu hinterlassen? Wenn meine Feinde mich suchen, brauchen sie nur der Asche zu folgen, die ich hinterlasse."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387343&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d525632f-59b6-471b-b2b6-f1f80ef7da10\', \'multiverseId\': 387343}, \'multiverseid\': 387343}, {\'name\': \'Caballería cascos ardientes\', \'text\': \'{3}{R}: La Caballería cascos ardientes obtiene +2/+0 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Berserker humano\', \'flavor\': \'"¿Qué guerrero que se precie de serlo teme dejar su huella? Si mis enemigos me buscan, que sigan las cenizas que dejo a mi paso".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389226&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b6ae3d3c-47b2-429b-aa17-941e32d8370f\', \'multiverseId\': 389226}, \'multiverseid\': 389226}, {\'name\': \'Cavalerie sabots-de-feu\', \'text\': "{3}{R} : La Cavalerie sabots-de-feu gagne +2/+0 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : humain et berserker\', \'flavor\': "« Quel guerrier digne de ce nom craint de laisser des traces ? Si mes ennemis me cherchent, ils n\'ont qu\'à suivre les cendres laissées dans mon sillage. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387612&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a9650684-8299-46af-87c4-c812a1da13fe\', \'multiverseId\': 387612}, \'multiverseid\': 387612}, {\'name\': \'Cavalleria di Zoccoli Infuocati\', \'text\': \'{3}{R}: La Cavalleria di Zoccoli Infuocati prende +2/+0 e ha travolgere fino alla fine del turno.\', \'type\': \'Creatura — Berserker Umano\', \'flavor\': \'"Quale guerriero degno di tale nome teme di lasciare una traccia? Se i miei nemici mi cercano, possono seguire la scia di ceneri."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387881&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b682b40-7c0f-4f2b-8cc2-e516b61b08d2\', \'multiverseId\': 387881}, \'multiverseid\': 387881}, {\'name\': \'炎蹄の騎兵\', \'text\': \'{3}{R}：ターン終了時まで、炎蹄の騎兵は＋２/＋０の修整を受けるとともにトランプルを得る。\', \'type\': \'クリーチャー — 人間・狂戦士\', \'flavor\': \'「その名に値する戦士は、足跡を残すことを恐れない。敵が私を探しているのなら、私が通った後の灰の跡をたどって来るがいい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388150&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2e8a797-a585-4f73-b0d3-6af0a523f8c5\', \'multiverseId\': 388150}, \'multiverseid\': 388150}, {\'name\': \'불발굽 기병대\', \'text\': \'{3}{R}: 불발굽 기병대는 턴종료까지 +2/+0을 받고 돌진을 얻는다.\', \'type\': \'생물 — 인간 광전사\', \'flavor\': \'"이름난 전사가 흔적이 남는것을 두려워 할 것 같으냐? 날 찾는 적들이 있다면, 재가 된 흔적을 보고 찾아오게끔 하라고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388419&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1f095f14-64eb-428c-b680-1b6fa46f686f\', \'multiverseId\': 388419}, \'multiverseid\': 388419}, {\'name\': \'Cavalaria Casco de Fogo\', \'text\': \'{3}{R}: Cavalaria Casco de Fogo recebe +2/+0 e ganha atropelar até o final do turno.\', \'type\': \'Criatura — Humano Amoque\', \'flavor\': \'"Que guerreiro digno do próprio nome teme deixar um rastro? Que meus inimigos sigam o rastro de cinzas do meu caminho."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388688&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5280bbf-f2ef-464e-9840-57790ef662e5\', \'multiverseId\': 388688}, \'multiverseid\': 388688}, {\'name\': \'Всадница Огненных Копыт\', \'text\': \'{3}{R}: Всадница Огненных Копыт получает +2/+0 и Пробивной удар до конца хода.\', \'type\': \'Существо — Человек Берсерк\', \'flavor\': \'«Тот, кто боится оставить свой след, недостоин называться воином. Если враги хотят найти меня, пусть следуют за пеплом».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388957&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0b9128f5-7207-4289-be31-bee2efbad5e8\', \'multiverseId\': 388957}, \'multiverseid\': 388957}, {\'name\': \'焰蹄骑兵\', \'text\': \'{3}{R}：直到回合结束，焰蹄骑兵得+2/+0且获得践踏异能。\', \'type\': \'生物～人类／狂战士\', \'flavor\': \'「名副其实的战士哪里会怕留下踪迹？如果敌人要找我，尽管让他们追着我的灰迹过来。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386805&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2bca36cd-7e2a-4fd4-94fd-a2836dbbd30a\', \'multiverseId\': 386805}, \'multiverseid\': 386805}, {\'name\': \'焰蹄騎兵\', \'text\': \'{3}{R}：直到回合結束，焰蹄騎兵得+2/+0且獲得踐踏異能。\', \'type\': \'生物～人類／狂戰士\', \'flavor\': \'「名副其實的戰士哪裡會怕留下蹤跡？如果敵人要找我，儘管讓他們追著我的灰跡過來。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387074&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'24c5c390-6a8d-4266-94cb-8c896df812a9\', \'multiverseId\': 387074}, \'multiverseid\': 387074}]', '[{\'name\': \'Flinker Tritt\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält +1/+0 bis zum Ende des Zuges. Sie kämpft gegen eine Kreatur deiner Wahl, die du nicht kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'Shintan spürte die Bosheit in seinem Gegner, doch er schlug nicht zu, bis er sah, wie der Ork seine Muskeln für den Angriff anspannte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387495&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c3f9695-e48d-4780-9375-1fe6fd644c2e\', \'multiverseId\': 387495}, \'multiverseid\': 387495}, {\'name\': \'Patada repentina\', \'text\': \'La criatura objetivo que controlas obtiene +1/+0 hasta el final del turno. Esa criatura lucha contra la criatura objetivo que no controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'Shintan presintió la malicia en su oponente, pero no atacó hasta que los músculos del orco se tensaron para prepararse a lanzar el primer puñetazo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389378&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f89083c8-8acb-46c6-82ec-8ea91f03aff6\', \'multiverseId\': 389378}, \'multiverseid\': 389378}, {\'name\': \'Coup de pied imparable\', \'text\': "Une créature ciblée que vous contrôlez gagne +1/+0 jusqu\'à la fin du tour. Elle se bat contre une créature ciblée que vous ne contrôlez pas.", \'type\': \'Éphémère\', \'flavor\': "Shintan perçut la malveillance émanant de son adversaire, mais ne le frappa qu\'à l\'instant où il vit les muscles de l\'orque se contracter pour porter le premier coup.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387764&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d089669e-c30c-4508-88e6-ff622b40029b\', \'multiverseId\': 387764}, \'multiverseid\': 387764}, {\'name\': \'Calcio Repentino\', \'text\': \'Una creatura bersaglio che controlli prende +1/+0 fino alla fine del turno. Lotta con una creatura bersaglio che non controlli.\', \'type\': \'Istantaneo\', \'flavor\': "Shintan percepì l\'odio nel suo avversario, ma non colpì finché i muscoli dell\'orco non si tesero per preparare il primo pugno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28ff318a-2be5-405b-8dca-96cbf4ffaa6c\', \'multiverseId\': 388033}, \'multiverseid\': 388033}, {\'name\': \'素早い蹴り\', \'text\': \'あなたがコントロールするクリーチャー１体と、あなたがコントロールしていないクリーチャー１体を対象とする。ターン終了時まで、その前者は＋１/＋０の修整を受ける。その前者はその後者と格闘を行う。\', \'type\': \'インスタント\', \'flavor\': \'シンタンは対戦相手のオークから発する邪気に気付いていたが、相手が先制のパンチを放つべくその筋肉が張り詰めるまで攻撃をするのは控えた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388302&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce962f1a-5fd5-4d81-994e-e259c1fbf0de\', \'multiverseId\': 388302}, \'multiverseid\': 388302}, {\'name\': \'빠른 발차기\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받는다. 당신이 조종하지 않는 생물을 목표로 정한다. 그 두 생물은 서로 싸운다.\', \'type\': \'순간마법\', \'flavor\': \'신탄은 상대의 악의를 감지할 수 있었으나, 오크의 근육이 첫 주먹을 내지르기 위해 긴장할 때까지 공격하지 않았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388571&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'990da396-7e36-4769-8361-2a818e976213\', \'multiverseId\': 388571}, \'multiverseid\': 388571}, {\'name\': \'Chute Veloz\', \'text\': \'A criatura alvo que você controla recebe +1/+0 até o final do turno. Ela luta com a criatura alvo que você não controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Shintan sentiu a malevolência de seu oponente, mas não golpeou até os músculos do orc se retesarem para o primeiro soco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388840&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7355e0df-adab-453b-85ad-57102b43b0df\', \'multiverseId\': 388840}, \'multiverseid\': 388840}, {\'name\': \'Молниеносный Удар\', \'text\': \'Целевое существо под вашим контролем получает +1/+0 до конца хода. Оно дерется с целевым существом не под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Шинтан чувствовал злобу в противнике, но не бил, пока мышцы орка не напряглись, готовясь нанести удар.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389109&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'edafef2f-3a8b-4a75-9cf7-b2e837178f46\', \'multiverseId\': 389109}, \'multiverseid\': 389109}, {\'name\': \'旋风腿\', \'text\': \'目标由你操控的生物得+1/+0直到回合结束。它与目标不由你操控的生物互斗。\', \'type\': \'瞬间\', \'flavor\': \'辛坦感觉到了对手的恶意，但直到这个半兽人肌肉紧绷准备挥出第一拳时，他才发动了攻击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386957&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e9e2f1a1-0116-4da0-98fc-0fc3b2e95cf2\', \'multiverseId\': 386957}, \'multiverseid\': 386957}, {\'name\': \'旋風腿\', \'text\': \'目標由你操控的生物得+1/+0直到回合結束。它與目標不由你操控的生物互鬥。\', \'type\': \'瞬間\', \'flavor\': \'辛坦感覺到了對手的惡意，但直到這個半獸人肌肉緊繃準備揮出第一拳時，他才發動了攻擊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387226&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6a2a3367-c358-4f16-b7ff-2b10f22739c4\', \'multiverseId\': 387226}, \'multiverseid\': 387226}]', "[{'name': 'Friedliche Bucht', 'text': 'Die Friedliche Bucht kommt getappt ins Spiel.\\nWenn die Friedliche Bucht ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {U}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387510&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2c39b7b4-e1e7-480d-ad0f-8d71f05fa37a', 'multiverseId': 387510}, 'multiverseid': 387510}, {'name': 'Cala tranquila', 'text': 'La Cala tranquila entra al campo de batalla girada.\\nCuando la Cala tranquila entre al campo de batalla, ganas 1 vida.\\n{T}: Agrega {W} o {U} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389393&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7fd3282b-6043-458d-9118-dd49fab62f78', 'multiverseId': 389393}, 'multiverseid': 389393}, {'name': 'Crique tranquille', 'text': 'La Crique tranquille arrive sur le champ de bataille engagée.\\nQuand la Crique tranquille arrive sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {W} ou {U} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387779&type=card', 'language': 'French', 'identifiers': {'scryfallId': '843087cd-9c94-403d-8802-a62f8e3edfda', 'multiverseId': 387779}, 'multiverseid': 387779}, {'name': 'Baia Tranquilla', 'text': 'La Baia Tranquilla entra nel campo di battaglia TAPpata.\\nQuando la Baia Tranquilla entra nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {W} o {U} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388048&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '72a93859-98f7-48dd-be71-a9cf170411a4', 'multiverseId': 388048}, 'multiverseid': 388048}, {'name': '平穏な入り江', 'text': '平穏な入り江はタップ状態で戦場に出る。\\n平穏な入り江が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{W}か{U}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388317&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a0af0472-d33c-4c09-9f82-2778aa097af9', 'multiverseId': 388317}, 'multiverseid': 388317}, {'name': '잔잔한 만', 'text': '잔잔한 만은 탭된 채로 전장에 들어온다.\\n잔잔한 만이 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {W} 또는 {U}를 당신의 마나풀에 담는다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388586&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '64ef1369-ba2c-401c-aa18-8b7a3514d8bc', 'multiverseId': 388586}, 'multiverseid': 388586}, {'name': 'Angra Tranquila', 'text': 'Angra Tranquila entra no campo de batalha virado.\\nQuando Angra Tranquila entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {W} ou {U} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388855&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c16fe269-5cc8-4c75-8148-d2039ecbcd83', 'multiverseId': 388855}, 'multiverseid': 388855}, {'name': 'Тихая Бухта', 'text': 'Тихая Бухта выходит на поле битвы повернутой.\\nКогда Тихая Бухта выходит на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {W} или {U} в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389124&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cec1fabf-bb6c-445f-8168-240c69fe10af', 'multiverseId': 389124}, 'multiverseid': 389124}, {'name': '静谧海湾', 'text': '静谧海湾须横置进战场。\\n当静谧海湾进战场时，你获得1点生命。\\n{T}：加{W}或{U}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386972&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8086b556-6fd0-4800-9935-12207a741eb1', 'multiverseId': 386972}, 'multiverseid': 386972}, {'name': '靜謐海灣', 'text': '靜謐海灣須橫置進戰場。\\n當靜謐海灣進戰場時，你獲得1點生命。\\n{T}：加{W}或{U}到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387241&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c0179d46-a5ef-4286-970f-0d16b1a5f7f0', 'multiverseId': 387241}, 'multiverseid': 387241}]", '[{\'name\': \'Frostfeder-Avior\', \'text\': \'Fliegend\\nMorph {1}{G}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Frostfeder-Avior aufgedeckt wird, kannst du eine andere Kreatur deiner Wahl auf die Hand ihres Besitzers zurückbringen.\', \'type\': \'Kreatur — Vogel, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387369&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69c02897-d190-45ff-98e5-f9dd0ce4ad6f\', \'multiverseId\': 387369}, \'multiverseid\': 387369}, {\'name\': \'Aven plumagélida\', \'text\': \'Vuela.\\nMetamorfosis {1}{G}{U}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Aven plumagélida se ponga boca arriba, puedes regresar otra criatura objetivo a la mano de su propietario.\', \'type\': \'Criatura — Chamán ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389252&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03acf5cf-9f96-4c0b-a893-cbfbfbb5e47c\', \'multiverseId\': 389252}, \'multiverseid\': 389252}, {\'name\': \'Avemain plumeglace\', \'text\': "Vol\\nMue {1}{G}{U} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand l\'Avemain plumeglace est retourné face visible, vous pouvez renvoyer une autre créature ciblée dans la main de son propriétaire.", \'type\': \'Créature : oiseau et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387638&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e474942f-5a1d-4bf8-af73-0e50c6d084d0\', \'multiverseId\': 387638}, \'multiverseid\': 387638}, {\'name\': \'Aviano Piuma Gelata\', \'text\': "Volare\\nMetamorfosi {1}{G}{U} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando l\'Aviano Piuma Gelata viene girato a faccia in su, puoi far tornare un\'altra creatura bersaglio in mano al suo proprietario.", \'type\': \'Creatura — Sciamano Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387907&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'646b9392-cee8-492e-978c-595cbe2b0125\', \'multiverseId\': 387907}, \'multiverseid\': 387907}, {\'name\': \'氷羽のエイヴン\', \'text\': \'飛行\\n変異{1}{G}{U}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n氷羽のエイヴンが表向きになったとき、他のクリーチャー１体を対象とする。あなたはそれをオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — 鳥・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388176&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71a2eec5-86fe-4e39-92bd-7552dd85b4ad\', \'multiverseId\': 388176}, \'multiverseid\': 388176}, {\'name\': \'얼음깃털 에이븐\', \'text\': \'비행\\n변이 {1}{G}{U} (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\\n얼음깃털 에이븐이 앞면으로 뒤집히면, 다른 생물을 목표로 정한다. 당신은 그 생물을 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 조류 주술사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388445&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8048b329-818a-4eea-9614-34c6d9dc5474\', \'multiverseId\': 388445}, \'multiverseid\': 388445}, {\'name\': \'Aviano Pena Gélida\', \'text\': \'Voar\\nMetamorfose {1}{G}{U} (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Aviano Pena Gélida for voltado para cima, você pode devolver outra criatura alvo para a mão de seu dono.\', \'type\': \'Criatura — Ave Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388714&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7659dd25-e70c-4ae0-95f5-b21d673e8e07\', \'multiverseId\': 388714}, \'multiverseid\': 388714}, {\'name\': \'Снежнокрылый Авен\', \'text\': \'Полет\\nОборотень {1}{G}{U} (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\\nКогда Снежнокрылый Авен переворачивается рубашкой вниз, вы можете вернуть другое целевое существо в руку его владельца.\', \'type\': \'Существо — Птица Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388983&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'79621111-68ef-4dfe-931f-2dd93a9aff8d\', \'multiverseId\': 388983}, \'multiverseid\': 388983}, {\'name\': \'冰羽艾文\', \'text\': \'飞行\\n变身{1}{G}{U}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当冰羽艾文翻回正面时，你可以将另一个目标生物移回其拥有者手上。\', \'type\': \'生物～鸟／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386831&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba3d8844-c1c7-41a2-85ab-ec74cf33712c\', \'multiverseId\': 386831}, \'multiverseid\': 386831}, {\'name\': \'冰羽艾文\', \'text\': \'飛行\\n變身{1}{G}{U}（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\\n當冰羽艾文翻回正面時，你可以將另一個目標生物移回其擁有者手上。\', \'type\': \'生物～鳥／祭師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387100&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c608797-d0c6-4db8-9934-0afa1b1e3d8b\', \'multiverseId\': 387100}, \'multiverseid\': 387100}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387416&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ca589d1a-b52b-4d12-9914-bff8d32c206b', 'multiverseId': 387416}, 'multiverseid': 387416}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389299&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd01bc15d-8550-401b-b618-a7caa73816fc', 'multiverseId': 389299}, 'multiverseid': 389299}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387685&type=card', 'language': 'French', 'identifiers': {'scryfallId': '932383d1-810e-4bab-adc7-e55e0778dc39', 'multiverseId': 387685}, 'multiverseid': 387685}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387954&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '06636eb6-10cd-4320-a7e7-68f6001c49f4', 'multiverseId': 387954}, 'multiverseid': 387954}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388223&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c35d1409-1e1b-4351-aac6-7e7f4dfbeed9', 'multiverseId': 388223}, 'multiverseid': 388223}, {'name': '