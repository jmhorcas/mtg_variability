com/Handlers/Image.ashx?multiverseid=388425&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bef0aca4-d5e7-4ca5-84b4-d782d3983300', 'multiverseId': 388425}, 'multiverseid': 388425}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388694&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9d5745c4-af97-47c8-b0f6-f58333719f0a', 'multiverseId': 388694}, 'multiverseid': 388694}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388963&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f97f5fb7-d5b0-48d5-9446-011a2f8c2798', 'multiverseId': 388963}, 'multiverseid': 388963}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386811&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '394d20cd-f8fb-467f-b3fd-8cb62034ac12', 'multiverseId': 386811}, 'multiverseid': 386811}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387080&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e0557133-5dbd-4749-b903-357258eb07ba', 'multiverseId': 387080}, 'multiverseid': 387080}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387350&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5bb37811-90b7-404b-ae81-615005dd5144', 'multiverseId': 387350}, 'multiverseid': 387350}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389233&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fdbf275e-b37b-42b5-ba0e-2a0605a7dcb5', 'multiverseId': 389233}, 'multiverseid': 389233}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387619&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ed4d49fc-6bb0-4442-817a-c73da3961312', 'multiverseId': 387619}, 'multiverseid': 387619}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387888&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '63bd422b-7f89-4282-8de4-c688c5c0cbf9', 'multiverseId': 387888}, 'multiverseid': 387888}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388157&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5258fb55-b7d1-4aa9-8bfc-fb5a1a8ed90d', 'multiverseId': 388157}, 'multiverseid': 388157}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388426&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'cd0e27ed-b229-4a3c-b430-35715fb82cae', 'multiverseId': 388426}, 'multiverseid': 388426}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388695&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e6c391f3-2c3f-4cd1-9e69-bf6c484090ba', 'multiverseId': 388695}, 'multiverseid': 388695}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388964&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '92b41402-a874-42cb-ac4d-af8650f41991', 'multiverseId': 388964}, 'multiverseid': 388964}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386812&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '18c70ed1-aa71-4c4d-a9c1-67918e560891', 'multiverseId': 386812}, 'multiverseid': 386812}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387081&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6bfe66f5-0fab-48f3-89f7-a33f2156b703', 'multiverseId': 387081}, 'multiverseid': 387081}]", '[{\'name\': \'Wandernde Turmschildkröte\', \'text\': \'Inseltarnung (Diese Kreatur kann nicht geblockt werden, solange der verteidigende Spieler eine Insel kontrolliert.)\\nImmer wenn die Wandernde Turmschildkröte angreift, schicke sie ins Exil. Bringe sie zu Beginn des Angreifer-deklarieren-Segments in deinem nächsten Zug unter deiner Kontrolle getappt und angreifend ins Spiel zurück.\', \'type\': \'Kreatur — Schildkröte\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387409&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71ddd269-5565-47c0-8452-19021001de77\', \'multiverseId\': 387409}, \'multiverseid\': 387409}, {\'name\': \'Quelonio colosal merodeador\', \'text\': \'Cruza islas. (Esta criatura no puede ser bloqueada mientras el jugador defensor controle una isla.)\\nSiempre que el Quelonio colosal merodeador ataque, exílialo. Regrésalo al campo de batalla bajo tu control girado y atacando al comienzo del paso de declarar atacantes de tu próximo turno.\', \'type\': \'Criatura — Tortuga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389292&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'364a8793-d786-481d-a25d-158870306be9\', \'multiverseId\': 389292}, \'multiverseid\': 389292}, {\'name\': \'Carapace fortifiée errante\', \'text\': "Traversée des îles (Cette créature ne peut pas être bloquée tant que le joueur défenseur contrôle au moins une île.)\\nÀ chaque fois que la Carapace fortifiée errante attaque, exilez-la. Renvoyez-la sur le champ de bataille sous votre contrôle, engagée et attaquante, au début de l\'étape de déclaration des attaquants de votre prochain tour.", \'type\': \'Créature : tortue terrestre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387678&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e29e29b-9e01-4582-87dd-c7dca093593c\', \'multiverseId\': 387678}, \'multiverseid\': 387678}, {\'name\': \'Roccaguscio Vagante\', \'text\': "Passa-Isole (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla un\'Isola.)\\nOgniqualvolta la Roccaguscio Vagante attacca, esiliala. Rimettila sul campo di battaglia sotto il tuo controllo TAPpata e attaccante all\'inizio della sottofase di dichiarazione delle creature attaccanti del tuo prossimo turno.", \'type\': \'Creatura — Tartaruga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387947&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2727cff-edf8-422b-afd7-d706268b0ba3\', \'multiverseId\': 387947}, \'multiverseid\': 387947}, {\'name\': \'うねる塔甲羅\', \'text\': \'島渡り（このクリーチャーは防御プレイヤーが島をコントロールしているかぎりブロックされない。）\\nうねる塔甲羅が攻撃するたび、これを追放する。あなたの次のターンの攻撃クリーチャー指定ステップの開始時に、これをあなたのコントロール下でタップ状態で攻撃している状態で戦場に戻す。\', \'type\': \'クリーチャー — 海亀\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388216&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'806aabb0-dbd2-40b2-9a09-c49b5cbcc534\', \'multiverseId\': 388216}, \'multiverseid\': 388216}, {\'name\': \'배회하는 탑거북\', \'text\': \'섬잠입 (수비플레이어가 섬을 조종하는 한, 이 생물은 방어될 수 없다.)\\n배회하는 탑거북이 공격할 때마다, 배회하는 탑거북을 추방한다. 당신의 다음 턴의 공격자 지정단 시작에, 이 생물을 당신의 조종하에 탭되어 공격하는 상태로 전장으로 되돌린다.\', \'type\': \'생물 — 거북이\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388485&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b53e432a-de29-4081-b456-8570f22722f6\', \'multiverseId\': 388485}, \'multiverseid\': 388485}, {\'name\': \'Casco-torre Vagueante\', \'text\': \'Travessia de ilha (Esta criatura não poderá ser bloqueada enquanto o jogador defensor controlar uma Ilha.)\\nToda vez que Casco-torre Vagueante atacar, exile-o. Devolva-o ao campo de batalha sob seu controle virado e atacando no início da etapa de declaração de atacantes no seu próximo turno.\', \'type\': \'Criatura — Tartaruga\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388754&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9fc10801-0ba7-456a-acc0-27735e61899e\', \'multiverseId\': 388754}, \'multiverseid\': 388754}, {\'name\': \'Бродячая Гигантопаха\', \'text\': \'Знание Островов (Это существо не может быть заблокировано, пока защищающийся игрок контролирует Остров.)\\nКаждый раз, когда Бродячая Гигантопаха атакует, изгоните ее. Верните ее на поле битвы под вашим контролем повернутой и атакующей в начале шага объявления атакующих в вашем следующем ходу.\', \'type\': \'Существо — Черепаха\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389023&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'401afd89-f4c2-403d-8dc7-7833b6feabf2\', \'multiverseId\': 389023}, \'multiverseid\': 389023}, {\'name\': \'曲行塔壳龟\', \'text\': \'海岛行者（只要防御牌手操控海岛，此生物就不能被阻挡。）\\n每当曲行塔壳龟攻击时，将它放逐。在你下一个回合的宣告攻击者步骤开始时，将它在你的操控下横置移回战场且正进行攻击。\', \'type\': \'生物～龟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386871&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'57b4b034-2ac3-4cd5-ad2c-c47afcdd4237\', \'multiverseId\': 386871}, \'multiverseid\': 386871}, {\'name\': \'曲行塔殼龜\', \'text\': \'海島行者（只要防禦玩家操控海島，此生物就不能被阻擋。）\\n每當曲行塔殼龜攻擊時，將它放逐。在你下一個回合的宣告攻擊者步驟開始時，將它在你的操控下橫置移回戰場且正進行攻擊。\', \'type\': \'生物～龜\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387140&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7e131d78-4ff8-490d-9894-c50689524f2b\', \'multiverseId\': 387140}, \'multiverseid\': 387140}]', '[{\'name\': \'Wasserstrudel\', \'text\': \'Bringe bis zu zwei Kreaturen deiner Wahl auf die Hand ihrer Besitzer zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Sei wie Wasser: ungezähmt und frei und doch unaufhaltsam auf das größere Ziel zufließend." —Shensu, Mystiker der Flussradfeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387526&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cfb9aec6-3183-4dc1-a855-85dd4cb818da\', \'multiverseId\': 387526}, \'multiverseid\': 387526}, {\'name\': \'Remolino hídrico\', \'text\': \'Regresa hasta dos criaturas objetivo a las manos de sus propietarios.\', \'type\': \'Instantáneo\', \'flavor\': \'"Sé como el agua: indomable e incontenible, pero sin dejar de fluir inexorablemente hacia una meta superior". —Shensu, místico de Rueda del Río\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3d9751d-38d8-4116-b0dc-f1c74d05a6f2\', \'multiverseId\': 389409}, \'multiverseid\': 389409}, {\'name\': \'Déferlante marine\', \'text\': "Renvoyez jusqu\'à deux créatures ciblées dans les mains de leurs propriétaires.", \'type\': \'Éphémère\', \'flavor\': "« Soyez comme l\'eau : libre et sauvage, mais inéluctablement porté vers une destinée supérieure. » —Shensu, mystique de Noria", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387795&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60d186b6-9687-4e7a-993f-1fbfaee31325\', \'multiverseId\': 387795}, \'multiverseid\': 387795}, {\'name\': \'Idrovortice\', \'text\': \'Fai tornare fino a due creature bersaglio in mano ai rispettivi proprietari.\', \'type\': \'Istantaneo\', \'flavor\': \'"Sii come l\\\'acqua: indomito e senza vincoli, ma in continuo e inesorabile fluire verso una meta suprema." —Shensu, mistico di Rivo delle Ruote\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388064&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'88f36b3f-f2e0-46b6-9079-a75c9fb25e8d\', \'multiverseId\': 388064}, \'multiverseid\': 388064}, {\'name\': \'水渦\', \'text\': \'クリーチャーを最大２体まで対象とし、それらをオーナーの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'「水のようになれ。飼いならされず、束縛されず、それでいて大いなる海に向かって止めどなく流れ行くように。」 ――河水環の神秘家、シェンスー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388333&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16bfe5ce-1d51-4655-a249-d17c169339fc\', \'multiverseId\': 388333}, \'multiverseid\': 388333}, {\'name\': \'물회오리\', \'text\': \'최대 두 개까지의 생물을 목표로 정한다. 그 생물들을 소유자의 손으로 되돌린다.\', \'type\': \'순간마법\', \'flavor\': \'"흐르는 물과 같이 길들여지거나 구속되지 않고 더 위대한 목적을 향해 거침없이 흐르는 사람이 되어라." —굽이강 신비주의자 셴수\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388602&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e2ed059c-36bd-43be-a252-67885d07e081\', \'multiverseId\': 388602}, \'multiverseid\': 388602}, {\'name\': "Turbilhão D\'água", \'text\': \'Devolva até duas criaturas alvo para as mãos de seus donos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Seja como a água: livre e indomado, mas sempre correndo para um objetivo maior." — Shensu, místico de Roda D\\\'água\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388871&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84dc55b6-cc52-4238-ae42-a5dc1bf1b631\', \'multiverseId\': 388871}, \'multiverseid\': 388871}, {\'name\': \'Водоворот\', \'text\': \'Верните не более двух целевых существ в руки их владельцев.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Будь подобен воде: неукротимым, неудержимым, но без устали стремящимся к великой цели». — Шэньсу, мистик Речного Круга\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389140&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16d6e109-e4df-41e5-a3d2-e7d31d697882\', \'multiverseId\': 389140}, \'multiverseid\': 389140}, {\'name\': \'回旋急流\', \'text\': \'将至多两个目标生物移回其拥有者手上。\', \'type\': \'瞬间\', \'flavor\': \'「正如这流水：形不羁而向高远，行无常而道恒定。」 ～河轮秘教徒申苏\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386988&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16c75b75-a1cc-441b-b21c-84089c28de03\', \'multiverseId\': 386988}, \'multiverseid\': 386988}, {\'name\': \'迴旋急流\', \'text\': \'將至多兩個目標生物移回其擁有者手上。\', \'type\': \'瞬間\', \'flavor\': \'「正如這流水：形不羈而向高遠，行無常而道恆定。」 ～河輪秘教徒申蘇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387257&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'52f78cd2-d799-416f-b616-16ea173bf8ed\', \'multiverseId\': 387257}, \'multiverseid\': 387257}]', '[{\'name\': \'Wegbrennen\', \'text\': \'Wegbrennen fügt einer Kreatur deiner Wahl 6 Schadenspunkte zu. Wenn diese Kreatur in diesem Zug stirbt, schicke alle Karten aus dem Friedhof ihres Beherrschers ins Exil.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Deine Verderbtheit wird brennen, Schlange, bis dir nichts mehr zum Besudeln geblieben ist." —Asmala, Blutfeuer-Mystikerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387307&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61baa419-dad6-4927-afa7-ffb99676c441\', \'multiverseId\': 387307}, \'multiverseid\': 387307}, {\'name\': \'Quemarse\', \'text\': \'Quemarse hace 6 puntos de daño a la criatura objetivo. Cuando esa criatura muera este turno, exilia todas las cartas del cementerio de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'"Tu corrupción arderá, serpiente, hasta que no quede nada más que profanar". —Asmala, mística venardiente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389190&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f053d3c-10c3-4f09-a6d9-c8dee4580b96\', \'multiverseId\': 389190}, \'multiverseid\': 389190}, {\'name\': \'Autodafé\', \'text\': "L\'Autodafé inflige 6 blessures à une créature ciblée. Quand cette créature meurt ce tour-ci, exilez toutes les cartes du cimetière de son contrôleur.", \'type\': \'Éphémère\', \'flavor\': "« Serpent, ta corruption brûlera jusqu\'à ce qu\'il ne reste plus rien à profaner. » —Asmala, mystique hématopyre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387576&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cd3ef76c-fc3d-4f2c-af19-8123c25ad1e3\', \'multiverseId\': 387576}, \'multiverseid\': 387576}, {\'name\': \'Consumare nel Fuoco\', \'text\': \'Consumare nel Fuoco infligge 6 danni a una creatura bersaglio. Quando quella creatura muore in questo turno, esilia tutte le carte dal cimitero del suo controllore.\', \'type\': \'Istantaneo\', \'flavor\': \'"La tua depravazione brucerà, serpente, finché non rimarrà più nulla da contaminare." —Asmala, mistica del pirosangue\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387845&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'75292ae5-a286-4d91-8a07-154f037e9952\', \'multiverseId\': 387845}, \'multiverseid\': 387845}, {\'name\': \'焼き払い\', \'text\': \'クリーチャー１体を対象とする。焼き払いはそれに６点のダメージを与える。このターンにそのクリーチャーが死亡したとき、それのコントローラーの墓地にあるすべてのカードを追放する。\', \'type\': \'インスタント\', \'flavor\': \'「大蛇よ、これ以上汚すべきものが何も残らぬまで、お前の穢れは燃え続けるだろう。」 ――沸血の神秘家、アスマラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388114&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6e2c817e-376d-495a-98a0-cc575c0fb848\', \'multiverseId\': 388114}, \'multiverseid\': 388114}, {\'name\': \'태우기\', \'text\': \'생물을 목표로 정한다. 태우기는 그 생물에 피해 6점을 입힌다. 그 생물이 이 턴에 죽을 때, 소유자의 무덤에 있는 모든 카드를 추방한다.\', \'type\': \'순간마법\', \'flavor\': \'"이무기여, 너의 타락은 완전히 없어질 때까지 불타오를 것이다." —혈염술 신비주의자 아스말라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388383&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3996a92b-e5d3-4d0b-9524-686fdfb4e537\', \'multiverseId\': 388383}, \'multiverseid\': 388383}, {\'name\': \'Consumir em Chamas\', \'text\': \'Consumir em Chamas causa 6 pontos de dano à criatura alvo. Quando a criatura morrer neste turno, exile todos os cards do cemitério de seu controlador.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Sua corrupção queimará, serpente, até não restar nada mais para profanar." — Asmala, místico sangue-ígneo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388652&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d947b8bd-cb81-41d8-b1a9-7e7151402ce2\', \'multiverseId\': 388652}, \'multiverseid\': 388652}, {\'name\': \'Выжигание\', \'text\': \'Выжигание наносит 6 повреждений целевому существу. Когда то существо умирает в этом ходу, изгоните все карты из кладбища контролирующего его игрока.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Твоя гниль будет гореть, змея, пока не останется ничего, что могло бы осквернить других своим прикосновением». — Асмала, мистик огненной крови\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388921&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed42812f-9e2f-4f03-88bb-ffc01ae75036\', \'multiverseId\': 388921}, \'multiverseid\': 388921}, {\'name\': \'焚烧殆尽\', \'text\': \'焚烧殆尽对目标生物造成6点伤害。本回合中，当该生物死去时，放逐其操控者坟墓场中的所有牌。\', \'type\': \'瞬间\', \'flavor\': \'「蛇妖，你所有腐化之物都将付之一炬，再无他物为你亵渎。」 ～炽血秘教徒阿玛拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386769&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'338a7205-330f-4fb4-be8e-ee719fa73dad\', \'multiverseId\': 386769}, \'multiverseid\': 386769}, {\'name\': \'焚燒殆盡\', \'text\': \'焚燒殆盡對目標生物造成6點傷害。本回合中，當該生物死去時，放逐其操控者墳墓場中的所有牌。\', \'type\': \'瞬間\', \'flavor\': \'「蛇妖，你所有腐化之物都將付之一炬，再無他物為你褻瀆。」 ～熾血秘教徒阿瑪拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387038&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ec930a63-c3ab-4ef5-8f68-a3ca27ece167\', \'multiverseId\': 387038}, \'multiverseid\': 387038}]', '[{\'name\': \'Wegzwingen\', \'text\': \'Bringe eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück.\\nWildheit — Falls du eine Kreatur mit Stärke 4 oder mehr kontrollierst, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wo einst ein Feind ritt, bleibt nicht einmal ein Flüstern zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387346&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b66c91a3-2221-4e46-9175-cb8453a7ceb5\', \'multiverseId\': 387346}, \'multiverseid\': 387346}, {\'name\': \'Retirada forzada\', \'text\': \'Regresa la criatura objetivo a la mano de su propietario.\\nFerocidad — Si controlas una criatura con fuerza de 4 o más, puedes robar una carta. Si lo haces, descarta una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Donde antes cabalgaba un enemigo ya no queda ni un susurro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389229&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'64841356-e74f-49c7-af10-6a15f215b7ba\', \'multiverseId\': 389229}, \'multiverseid\': 389229}, {\'name\': \'Éviction\', \'text\': "Renvoyez la créature ciblée dans la main de son propriétaire.\\nFérocité — Si vous contrôlez une créature avec une force supérieure ou égale à 4, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.", \'type\': \'Éphémère\', \'flavor\': "De l\'ennemi qui rôdait, il ne resta pas même un murmure.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387615&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'080713c2-9cf4-4859-a822-5a16b162a62d\', \'multiverseId\': 387615}, \'multiverseid\': 387615}, {\'name\': \'Abbandono Forzato\', \'text\': \'Fai tornare una creatura bersaglio in mano al suo proprietario.\\nFerocia — Se controlli una creatura con forza pari o superiore a 4, puoi pescare una carta. Se lo fai, scarta una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Dove un tempo cavalcava un nemico, non resta più neppure un sussurro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23f9fe49-b072-43d2-82d2-0fdf347a4729\', \'multiverseId\': 387884}, \'multiverseid\': 387884}, {\'name\': \'引き剥がし\', \'text\': \'クリーチャー１体を対象とし、それをオーナーの手札に戻す。\\n獰猛 ― あなたがパワーが４以上のクリーチャーをコントロールしているなら、あなたはカードを１枚引いてもよい。そうしたなら、カードを１枚捨てる。\', \'type\': \'インスタント\', \'flavor\': \'敵がかつて騎乗していたが、今ではその囁きすら残されていない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388153&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e75a111b-2d46-471f-b805-e72f9f899fd3\', \'multiverseId\': 388153}, \'multiverseid\': 388153}, {\'name\': \'강제 추방\', \'text\': \'생물을 목표로 정한다. 그 생물을 소유자의 손으로 되돌린다.\\n흉포 — 당신이 공격력이 4 이상인 생물을 조종한다면, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': \'적의 발길이 닿았던 곳에는 속삭임조차 남지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388422&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6ddb5ad7-5ba9-483f-9067-f8c7c13115bd\', \'multiverseId\': 388422}, \'multiverseid\': 388422}, {\'name\': \'Rechaçar\', \'text\': \'Devolva a criatura alvo para a mão de seu dono.\\nFeroz — Se você controla uma criatura com poder igual ou superior a 4, você pode comprar um card. Se fizer isso, descarte um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Onde um inimigo outrora cavalgou, não resta sequer um sussurro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388691&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c440839c-e637-4f2d-83b4-66be1647602c\', \'multiverseId\': 388691}, \'multiverseid\': 388691}, {\'name\': \'Насильное Удаление\', \'text\': \'Верните целевое существо в руку его владельца.\\nСвирепость — Если вы контролируете существо с силой не менее 4, вы можете взять карту. Если вы это делаете, сбросьте карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Там, где однажды прошел враг, не слышно даже шороха.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388960&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40326498-b04a-4485-9aa0-0eab91c934ea\', \'multiverseId\': 388960}, \'multiverseid\': 388960}, {\'name\': \'驱离\', \'text\': \'将目标生物移回其拥有者手上。\\n威猛～如果你操控力量等于或大于4的生物，则你可以抓一张牌。如果你如此作，则弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'曾有敌军驰骋，如今悄无声息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386808&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70cb8ba6-596b-4191-876b-4a1ade40d19b\', \'multiverseId\': 386808}, \'multiverseid\': 386808}, {\'name\': \'驅離\', \'text\': \'將目標生物移回其擁有者手上。\\n威猛～如果你操控力量等於或大於4的生物，則你可以抽一張牌。如果你如此作，則棄一張牌。\', \'type\': \'瞬間\', \'flavor\': \'曾有敵軍馳騁，如今悄無聲息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387077&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d0387c64-e1a6-4478-840b-7b9e4a3d5b91\', \'multiverseId\': 387077}, \'multiverseid\': 387077}]', '[{\'name\': \'Weise des Drachenauges\', \'text\': \'Morph—Zeige eine blaue Karte auf deiner Hand offen vor. (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn die Weisen des Drachenauges aufgedeckt werden, schaue dir die Karten auf der Hand eines Gegners deiner Wahl an.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387331&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93d081b5-ef43-4c6f-b80c-ddb5b9e6e91a\', \'multiverseId\': 387331}, \'multiverseid\': 387331}, {\'name\': \'Sabios del ojo del dragón\', \'text\': \'Metamorfosis—Muestra una carta azul de tu mano. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando los Sabios del ojo del dragón se pongan boca arriba, mira la mano del oponente objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389214&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2b0e42d-19a4-4f8f-86da-14aa506f9ad7\', \'multiverseId\': 389214}, \'multiverseid\': 389214}, {\'name\': "Savants de l\'Œil du dragon", \'text\': "Mue — Révélez une carte bleue de votre main. (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand les Savants de l\'Œil du dragon sont retournés face visible, regardez la main d\'un adversaire ciblé.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387600&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'358254cf-223b-4868-a3d3-9776352c4c9c\', \'multiverseId\': 387600}, \'multiverseid\': 387600}, {\'name\': "Sapienti dell\'Occhio di Drago", \'text\': "Metamorfosi—Rivela una carta blu dalla tua mano. (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando i Sapienti dell\'Occhio di Drago vengono girati a faccia in su, guarda la mano di un avversario bersaglio.", \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387869&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ac5a851-e957-4f2e-be18-5c142955b3b1\', \'multiverseId\': 387869}, \'multiverseid\': 387869}, {\'name\': \'龍の眼の学者\', \'text\': \'変異 ― あなたの手札にある青のカードを１枚公開する。（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n龍の眼の学者が表向きになったとき、対戦相手１人を対象とし、そのプレイヤーの手札を見る。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388138&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2949b15-fb7e-43e6-9c65-40b6d8826795\', \'multiverseId\': 388138}, \'multiverseid\': 388138}, {\'name\': \'용의 눈 석학\', \'text\': \'변이—당신의 손에서 청색 카드 한 장을 공개한다. (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\\n용의 눈 석학이 앞면으로 뒤집히면, 상대를 목표로 정한다. 그 상대의 손을 본다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388407&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0e17d1ee-b7e5-487b-8c33-05e07e8e803e\', \'multiverseId\': 388407}, \'multiverseid\': 388407}, {\'name\': \'Sábios do Olho do Dragão\', \'text\': \'Metamorfose — Revele um card azul na sua mão. (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Sábios do Olho do Dragão for voltado para cima, olhe a mão do oponente alvo.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388676&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e2442b96-33cb-4d25-be0a-79a5718cd6d6\', \'multiverseId\': 388676}, \'multiverseid\': 388676}, {\'name\': \'Мудрецы Ока Дракона\', \'text\': \'Оборотень — Покажите синюю карту, находящуюся в вашей руке. (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\\nКогда Мудрецы Ока Дракона переворачиваются рубашкой вниз, посмотрите руку целевого оппонента.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388945&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a551e110-7ee5-4779-9f6f-97470cc76050\', \'multiverseId\': 388945}, \'multiverseid\': 388945}, {\'name\': \'龙目学者\', \'text\': \'变身～从你手上展示一张蓝色牌。（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当龙目学者翻回正面时，检视目标对手的手牌。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386793&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4842d617-3e58-47ca-8bf1-8fd80abecc36\', \'multiverseId\': 386793}, \'multiverseid\': 386793}, {\'name\': \'龍目學者\', \'text\': \'變身～從你手上展示一張藍色牌。（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\\n當龍目學者翻回正面時，檢視目標對手的手牌。\', \'type\': \'生物～人類／魔法師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387062&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fecb74a2-5764-412a-a51e-ef7486628bd7\', \'multiverseId\': 387062}, \'multiverseid\': 387062}]', '[{\'name\': \'Weise des Inneren Auges\', \'text\': \'Fliegend\\nImmer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhalten Kreaturen, die du kontrollierst, Lebensverknüpfung bis zum Ende des Zuges.\', \'type\': \'Kreatur — Dschinn, Zauberer\', \'flavor\': \'„Nicht das einzelne Blütenblatt macht die Schönheit des Lotus aus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387451&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff251fec-d31a-418a-a9d3-589816799d79\', \'multiverseId\': 387451}, \'multiverseid\': 387451}, {\'name\': \'Sabia del ojo interior\', \'text\': \'Vuela.\\nSiempre que lances un hechizo que no sea de criatura, las criaturas que controlas ganan la habilidad de vínculo vital hasta el final del turno.\', \'type\': \'Criatura — Hechicero djinn\', \'flavor\': \'"Ningún pétalo se atribuye en solitario el mérito de la belleza del loto".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389334&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9e9bb4e-887f-423b-bdc9-9f3aced7d10c\', \'multiverseId\': 389334}, \'multiverseid\': 389334}, {\'name\': "Sage de l\'Œil intérieur", \'text\': "Vol\\nÀ chaque fois que vous lancez un sort non-créature, les créatures que vous contrôlez acquièrent le lien de vie jusqu\'à la fin du tour.", \'type\': \'Créature : djinn et sorcier\', \'flavor\': "« Aucun pétale ne peut s\'approprier la beauté du lotus. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387720&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26bcac56-394e-4afa-977a-d821a7d3fbb3\', \'multiverseId\': 387720}, \'multiverseid\': 387720}, {\'name\': "Saggia dell\'Occhio Interiore", \'text\': \'Volare\\nOgniqualvolta lanci una magia non creatura, le creature che controlli hanno legame vitale fino alla fine del turno.\', \'type\': \'Creatura — Mago Genio\', \'flavor\': \'"Nessun singolo petalo rivendica la bellezza dell\\\'intero loto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387989&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a5e1b40-51fe-4998-8427-9b5ca644cf9c\', \'multiverseId\': 387989}, \'multiverseid\': 387989}, {\'name\': \'内向きの目の賢者\', \'text\': \'飛行\\nあなたがクリーチャーでない呪文を１つ唱えるたび、ターン終了時まで、あなたがコントロールするクリーチャーは絆魂を得る。\', \'type\': \'クリーチャー — ジン・ウィザード\', \'flavor\': \'「花びら１枚が、蓮の花全体の美しさを主張したりはしない」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388258&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7f4c6e3-8eab-419d-bfbb-1996dece20a3\', \'multiverseId\': 388258}, \'multiverseid\': 388258}, {\'name\': \'내면의 눈 현자\', \'text\': \'비행\\n당신이 생물이 아닌 주문을 발동할 때마다, 당신이 조종하는 생물들은 턴종료까지 생명연결을 얻는다.\', \'type\': \'생물 — 지니 마법사\', \'flavor\': \'"단 한 장의 꽃잎도 연꽃의 아름다움을 자신의 것이라고 주장하지 않는다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388527&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'788efed1-28fb-40f8-a5b6-6e624d58b00a\', \'multiverseId\': 388527}, \'multiverseid\': 388527}, {\'name\': \'Sábio do Olho Interior\', \'text\': \'Voar\\nToda vez que você conjura uma mágica que não seja de criatura, as criaturas que você controla ganham vínculo com a vida até o final do turno.\', \'type\': \'Criatura — Gênio Mago\', \'flavor\': \'"Nenhuma pétala se diz responsável pela beleza da lótus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388796&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee2d2de6-8bd6-49fb-89d6-8bb3be604848\', \'multiverseId\': 388796}, \'multiverseid\': 388796}, {\'name\': \'Мудрец Внутреннего Ока\', \'text\': \'Полет\\nКаждый раз, когда вы разыгрываете не являющееся существом заклинание, существа под вашим контролем получают Цепь жизни до конца хода.\', \'type\': \'Существо — Джинн Чародей\', \'flavor\': \'«Разве лепестки присваивают себе красоту всего лотоса?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'133de743-1c47-41bd-88b4-d487b503974f\', \'multiverseId\': 389065}, \'multiverseid\': 389065}, {\'name\': \'心目智者\', \'text\': \'飞行\\n每当你施放非生物咒语时，由你操控的生物获得系命异能直到回合结束。\', \'type\': \'生物～巨灵／法术师\', \'flavor\': \'「花瓣障目，不见莲华之美。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386913&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'908451e6-f5de-4ed1-805c-e76609d5b199\', \'multiverseId\': 386913}, \'multiverseid\': 386913}, {\'name\': \'心目智者\', \'text\': \'飛行\\n每當你施放非生物咒語時，由你操控的生物獲得繫命異能直到回合結束。\', \'type\': \'生物～巨靈／魔法師\', \'flavor\': \'「花瓣障目，不見蓮華之美。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387182&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6288dbac-cce2-4d54-b0e3-b58c24c3ca51\', \'multiverseId\': 387182}, \'multiverseid\': 387182}]', '[{\'name\': \'Weitblick-Habicht\', \'text\': \'Fliegend\\nMorph {3}{W} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\', \'type\': \'Kreatur — Vogel, Krieger\', \'flavor\': \'Diese gefiederten Krieger meditieren im Flug und zeichnen Mandalas in die Wolken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387452&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f89bc29f-8d7a-4b5c-b19e-1569079addad\', \'multiverseId\': 387452}, \'multiverseid\': 387452}, {\'name\': \'Hostigadora sabia\', \'text\': \'Vuela.\\nMetamorfosis {3}{W}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\', \'type\': \'Criatura — Guerrero ave\', \'flavor\': \'Estos guerreros alados meditan en pleno vuelo y trazan mandalas entre las nubes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5be249b9-8615-4f54-8c62-708ffb1f0b0b\', \'multiverseId\': 389335}, \'multiverseid\': 389335}, {\'name\': \'Busard Œilsage\', \'text\': \'Vol\\nMue {3}{W} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\', \'type\': \'Créature : oiseau et guerrier\', \'flavor\': \'Ces guerriers ailés méditent en vol, traçant des mandalas dans les nuages.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387721&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90b903de-b283-4212-a986-5e7f6af2345a\', \'multiverseId\': 387721}, \'multiverseid\': 387721}, {\'name\': "Rapace dell\'Occhio Saggio", \'text\': \'Volare\\nMetamorfosi {3}{W} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\', \'type\': \'Creatura — Guerriero Uccello\', \'flavor\': \'Questi guerrieri alati meditano in volo, disegnando mandala nelle nuvole.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387990&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1fca03e0-9de1-4695-8b47-badd94ecf414\', \'multiverseId\': 387990}, \'multiverseid\': 387990}, {\'name\': \'賢者眼の侵略者\', \'text\': \'飛行\\n変異{3}{W}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\', \'type\': \'クリーチャー — 鳥・戦士\', \'flavor\': \'この翼を持つ戦士たちは、飛行中に瞑想しながら雲海の空にその軌跡でマンダラを描く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388259&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5821fb9b-5714-46c3-8eaa-03191a573ab2\', \'multiverseId\': 388259}, \'multiverseid\': 388259}, {\'name\': \'밝은눈 사냥꾼\', \'text\': \'비행\\n변이 {3}{W} (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\', \'type\': \'생물 — 조류 전사\', \'flavor\': \'이 날개 달린 전사들은 비행 중 명상을 통해 구름 안에서 만다라를 그리며 날아간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388528&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'35cf4a1d-8db9-4c4f-ad66-c354321fbcfc\', \'multiverseId\': 388528}, \'multiverseid\': 388528}, {\'name\': \'Falcão do Olho Sábio\', \'text\': \'Voar\\nMetamorfose {3}{W} (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\', \'type\': \'Criatura — Ave Guerreiro\', \'flavor\': \'Esses guerreiros alados meditam em pleno voo, traçando mandalas nas nuvens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388797&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8200a550-8c64-4f9a-a561-85b51c1d95d3\', \'multiverseId\': 388797}, \'multiverseid\': 388797}, {\'name\': \'Лунь Мудрого Ока\', \'text\': \'Полет\\nОборотень {3}{W} (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\', \'type\': \'Существо — Птица Воин\', \'flavor\': \'Эти крылатые воины медитируют в полете, рисуя мандалы в облаках.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389066&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'be3bf21d-6830-4a28-ac87-5a2e70383e79\', \'multiverseId\': 389066}, \'multiverseid\': 389066}, {\'name\': \'慧眼鹞鹰\', \'text\': \'飞行\\n变身{3}{W}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\', \'type\': \'生物～鸟／战士\', \'flavor\': \'这些有翼战士在飞行中冥想，绘曼荼罗于云端。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386914&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a82ba9ed-117b-462c-9fda-07ef23774e76\', \'multiverseId\': 386914}, \'multiverseid\': 386914}, {\'name\': \'慧眼鷂鷹\', \'text\': \'飛行\\n變身{3}{W}（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\', \'type\': \'生物～鳥／戰士\', \'flavor\': \'這些有翼戰士在飛行中冥想，繪曼荼羅於雲端。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387183&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'90f246fc-2afe-44dd-8550-3dc523ab0b9d\', \'multiverseId\': 387183}, \'multiverseid\': 387183}]', '[{\'name\': \'Weitschuss-Trupp\', \'text\': \'Standhaft {1}{G} ({1}{G}, {T}: Lege eine +1/+1-Marke auf diese Kreatur. Spiele Standhaft wie eine Hexerei.)\\nJede Kreatur, die du kontrollierst und auf der mindestens eine +1/+1-Marke liegt, hat Reichweite. (Eine Kreatur mit Reichweite kann fliegende Kreaturen blocken.)\', \'type\': \'Kreatur — Hund, Bogenschütze\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387395&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1dccdf13-01f9-4def-a6ae-6e5c0c30cdd8\', \'multiverseId\': 387395}, \'multiverseid\': 387395}, {\'name\': \'Escuadra certera\', \'text\': \'Supervivencia {1}{G}. ({1}{G}, {T}: Pon un contador +1/+1 sobre esta criatura. Activa la habilidad de supervivencia solo como un conjuro.)\\nCada criatura que controlas con un contador +1/+1 sobre ella tiene la habilidad de alcance. (Una criatura con alcance puede bloquear a criaturas con la habilidad de volar.)\', \'type\': \'Criatura — Arquero perro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'126c56f7-d1c4-4c25-b973-4362cf818787\', \'multiverseId\': 389278}, \'multiverseid\': 389278}, {\'name\': \'Escouade de tir à longue distance\', \'text\': "Résilience {1}{G} ({1}{G}, {T} : Mettez un marqueur +1/+1 sur cette créature. N\'utilisez la résilience que lorsque vous pourriez lancer un rituel.)\\nChaque créature que vous contrôlez avec un marqueur +1/+1 sur elle a la portée. (Une créature avec la portée peut bloquer une créature avec le vol.)", \'type\': \'Créature : chien de chasse et archer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387664&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb2a7832-d459-4d94-b144-5ea8b09dd41b\', \'multiverseId\': 387664}, \'multiverseid\': 387664}, {\'name\': \'Squadra di Tiratori\', \'text\': \'Perdurare {1}{G} ({1}{G}, {T}: Metti un segnalino +1/+1 su questa creatura. Perdura solo quando potresti lanciare una stregoneria.)\\nOgni creatura con un segnalino +1/+1 che controlli ha raggiungere. (Una creatura con raggiungere può bloccare le creature con volare.)\', \'type\': \'Creatura — Arciere Segugio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387933&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a150e635-8d18-4522-87c9-6205fe28ea6e\', \'multiverseId\': 387933}, \'multiverseid\': 387933}, {\'name\': \'遠射兵団\', \'text\': \'長久{1}{G}（{1}{G}, {T}：このクリーチャーの上に＋１/＋１カウンターを１個置く。長久はソーサリーとしてのみ行う。）\\nあなたがコントロールする＋１/＋１カウンターが置かれている各クリーチャーは到達を持つ。（到達を持つクリーチャーは飛行を持つクリーチャーをブロックできる。）\', \'type\': \'クリーチャー — 猟犬・射手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388202&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'975663c3-889a-44ee-bedd-cb5146af9c70\', \'multiverseId\': 388202}, \'multiverseid\': 388202}, {\'name\': \'저격 부대\', \'text\': \'버티기 {1}{G} ({1}{G}, {T}: 이 생물에 +1/+1 카운터 한 개를 올려놓는다. 당신은 집중마법을 발동할 수 있는 시기에만 버티기를 활성화할 수 있다.)\\n당신이 조종하는 생물 중 +1/+1 카운터를 가진 각 생물은 대공을 가진다. (대공을 가진 생물은 비행을 가진 생물을 방어할 수 있다.)\', \'type\': \'생물 — 사냥개 궁수\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388471&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'20ee1cd3-5e1c-4b01-8f5a-50b2f498f887\', \'multiverseId\': 388471}, \'multiverseid\': 388471}, {\'name\': \'Esquadrão Tiro-longo\', \'text\': \'Sobreviver {1}{G}({1}{G}, {T}: Coloque um marcador +1/+1 nesta criatura. Use sobreviver somente como um feitiço.)\\nCada criatura que você controla com um marcador +1/+1 tem alcance. (Uma criatura com alcance pode bloquear criaturas com voar.)\', \'type\': \'Criatura — Sabujo Arqueiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388740&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02ad9534-c8f3-43fc-92e8-f02bb4b6e4e6\', \'multiverseId\': 388740}, \'multiverseid\': 388740}, {\'name\': \'Дальнобойный Отряд\', \'text\': \'Стойкость {1}{G} ({1}{G}, {T}: положите один жетон +1/+1 на это существо. Используйте Стойкость только как волшебство.)\\nКаждое существо под вашим контролем, на котором есть жетон +1/+1, имеет Захват. (Существо с Захватом может блокировать существа с Полетом.)\', \'type\': \'Существо — Пес Лучник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389009&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8bd5748a-943e-44ec-ae3b-46a3e23e1324\', \'multiverseId\': 389009}, \'multiverseid\': 389009}, {\'name\': \'穿杨小队\', \'text\': \'延生{1}{G}（{1}{G}，{T}：在此生物上放置一个+1/+1指示物。延生的时机视同法术。）\\n每个由你操控且其上有+1/+1指示物的生物均具有延势异能。（具延势异能的生物能阻挡具飞行异能的生物。）\', \'type\': \'生物～猎犬／弓箭手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'21cd00a3-1cf7-4547-a352-a1817178b811\', \'multiverseId\': 386857}, \'multiverseid\': 386857}, {\'name\': \'穿楊小隊\', \'text\': \'延生{1}{G}（{1}{G}，{T}：在此生物上放置一個+1/+1指示物。延生的時機視同巫術。）\\n每個由你操控且其上有+1/+1指示物的生物均具有延勢異能。（具延勢異能的生物能阻擋具飛行異能的生物。）\', \'type\': \'生物～獵犬／弓箭手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387126&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'531cf9ec-3143-4025-8d50-faec8dc20225\', \'multiverseId\': 387126}, \'multiverseid\': 387126}]', '[{\'name\': \'Wendige Meisterin\', \'text\': \'{2}{W}: Die Wendige Meisterin erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Mönch\', \'flavor\': \'„Stärke reißt Hindernisse nieder. Disziplin ignoriert sie."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387393&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4b7ec83-9717-4bc7-a5a3-7bd296dcee1d\', \'multiverseId\': 387393}, \'multiverseid\': 387393}, {\'name\': \'Maestra del salto\', \'text\': \'{2}{W}: La Maestra del salto gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Monje humano\', \'flavor\': \'"La fuerza derriba barreras. La disciplina las ignora".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389276&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6209657a-a802-4f6c-8623-b17365fa0d47\', \'multiverseId\': 389276}, \'multiverseid\': 389276}, {\'name\': \'Maîtresse du saut\', \'text\': "{2}{W} : La Maîtresse du saut acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et moine\', \'flavor\': \'« La force abat les barrières. La discipline les ignore. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387662&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6ffe2380-5d03-41ea-8d60-8bcc1a410c12\', \'multiverseId\': 387662}, \'multiverseid\': 387662}, {\'name\': \'Maestra del Balzo\', \'text\': \'{2}{W}: La Maestra del Balzo ha volare fino alla fine del turno.\', \'type\': \'Creatura — Monaco Umano\', \'flavor\': \'"La forza sfonda le barriere. La disciplina le ignora."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387931&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c981ffd-283e-4879-8166-0059cf3d99a2\', \'multiverseId\': 387931}, \'multiverseid\': 387931}, {\'name\': \'跳躍の達人\', \'text\': \'{2}{W}：ターン終了時まで、跳躍の達人は飛行を得る。\', \'type\': \'クリーチャー — 人間・モンク\', \'flavor\': \'「力は障害を打ち倒す。規律はそれらを無視する。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388200&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5bb62d70-fcc8-430b-bf14-650dbaf09f1b\', \'multiverseId\': 388200}, \'multiverseid\': 388200}, {\'name\': \'도약의 대가\', \'text\': \'{2}{W}: 도약의 대가는 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 인간 승려\', \'flavor\': \'"힘은 방어벽을 때려 부수지만, 수련은 방어벽을 무시한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388469&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d78f60c6-8107-4013-9d7f-2a3040c5074f\', \'multiverseId\': 388469}, \'multiverseid\': 388469}, {\'name\': \'Mestre Saltante\', \'text\': \'{2}{W}: Mestre Saltante ganha voar até o final do turno.\', \'type\': \'Criatura — Humano Monge\', \'flavor\': \'"A força derruba barreiras. A disciplina as ignora."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388738&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0a12ce73-9184-4cc4-b6da-019f87366fe7\', \'multiverseId\': 388738}, \'multiverseid\': 388738}, {\'name\': \'Мастер Прыжков\', \'text\': \'{2}{W}: Мастер Прыжков получает Полет до конца хода.\', \'type\': \'Существо — Человек Монах\', \'flavor\': \'«Сильный разрушает препятствия. Тренированный не замечает их».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389007&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6fbe6e8b-8a3f-4881-b11f-ce09198413e5\', \'multiverseId\': 389007}, \'multiverseid\': 389007}, {\'name\': \'跃动大师\', \'text\': \'{2}{W}：跃动大师获得飞行异能直到回合结束。\', \'type\': \'生物～人类／修行僧\', \'flavor\': \'「障壁，武勇克之，修业略之。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386855&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ce25be2-ce6f-48d0-8b96-abc34c4bd6b9\', \'multiverseId\': 386855}, \'multiverseid\': 386855}, {\'name\': \'躍動大師\', \'text\': \'{2}{W}：躍動大師獲得飛行異能直到回合結束。\', \'type\': \'生物～人類／修行僧\', \'flavor\': \'「障壁，武勇克之，修業略之。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387124&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8693ccbb-82bd-4ae6-8e67-f09989fd77c2\', \'multiverseId\': 387124}, \'multiverseid\': 387124}]', '[{\'name\': \'Wilde Stachelfaust\', \'text\': \'{2}{G}: Die Wilde Stachelfaust erhält +2/+2 bis zum Ende des Zuges. Aktiviere diese Fähigkeit nur einmal pro Zug.\\n{2}{U}: Bringe die Wilde Stachelfaust auf die Hand ihres Besitzers zurück.\\n{R}: Die Wilde Stachelfaust erhält Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387458&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ccdd8f9-8118-4324-bd67-4b6d813e9700\', \'multiverseId\': 387458}, \'multiverseid\': 387458}, {\'name\': \'Nudillos de acero salvaje\', \'text\': \'{2}{G}: El Nudillos de acero salvaje obtiene +2/+2 hasta el final del turno. Activa esta habilidad solo una vez por turno.\\n{2}{U}: Regresa el Nudillos de acero salvaje a la mano de su propietario.\\n{R}: El Nudillos de acero salvaje gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Guerrero ogro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389341&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c644f7fb-1467-4181-8c83-ccbf10f18741\', \'multiverseId\': 389341}, \'multiverseid\': 389341}, {\'name\': \'Lamepoing sauvage\', \'text\': "{2}{G} : Le Lamepoing sauvage gagne +2/+2 jusqu\'à la fin du tour. N\'activez cette capacité qu\'une seule fois par tour.\\n{2}{U} : Renvoyez le Lamepoing sauvage dans la main de son propriétaire.\\n{R} : Le Lamepoing sauvage acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387727&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b8d03d1-a01a-4383-b551-4c9553218589\', \'multiverseId\': 387727}, \'multiverseid\': 387727}, {\'name\': \'Lamapugno Selvaggio\', \'text\': \'{2}{G}: Il Lamapugno Selvaggio prende +2/+2 fino alla fine del turno. Attiva questa abilità solo una volta per turno.\\n{2}{U}: Fai tornare il Lamapugno Selvaggio in mano al suo proprietario.\\n{R}: Il Lamapugno Selvaggio ha rapidità fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Ogre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387996&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b4272d89-edb3-4b0c-9076-35c4f57f2ca8\', \'multiverseId\': 387996}, \'multiverseid\': 387996}, {\'name\': \'凶暴な拳刃\', \'text\': \'{2}{G}：ターン終了時まで、凶暴な拳刃は＋２/＋２の修整を受ける。この能力は、毎ターン１回のみ起動できる。\\n{2}{U}：凶暴な拳刃をオーナーの手札に戻す。\\n{R}：ターン終了時まで、凶暴な拳刃は速攻を得る。\', \'type\': \'クリーチャー — オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388265&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f7ea8bf-cddd-4a90-b5fe-d555af7920a0\', \'multiverseId\': 388265}, \'multiverseid\': 388265}, {\'name\': \'야만 주먹칼\', \'text\': \'{2}{G}: 야만 주먹칼은 턴종료까지 +2/+2를 받는다. 이 능력은 한 턴에 한 번씩만 활성화할 수 있다.\\n{2}{U}: 야만 주먹칼을 소유자의 손으로 되돌린다.\\n{R}: 야만 주먹칼은 턴종료까지 신속을 얻는다.\', \'type\': \'생물 — 오우거 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388534&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'180acba3-9def-4d12-b517-5e7beb7cebed\', \'multiverseId\': 388534}, \'multiverseid\': 388534}, {\'name\': \'Soqueiro Pungente Selvagem\', \'text\': \'{2}{G}: Soqueiro Pungente Selvagem recebe +2/+2 até o final do turno. Ative esta habilidade apenas uma vez a cada turno.\\n{2}{U}: Devolva Soqueiro Pungente Selvagem para a mão de seu dono.\\n{R}: Soqueiro Pungente Selvagem ganha ímpeto até o final do turno.\', \'type\': \'Criatura — Ogro Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388803&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3af4be3-32a3-43cc-b361-01dc1a97b1eb\', \'multiverseId\': 388803}, \'multiverseid\': 388803}, {\'name\': \'Дикарь с Клинками-Кастетами\', \'text\': \'{2}{G}: Дикарь с Клинками-Кастетами получает +2/+2 до конца хода. Активируйте эту способность только один раз за ход.\\n{2}{U}: верните Дикаря с Клинками-Кастетами в руку его владельца.\\n{R}: Дикарь с Клинками-Кастетами получает Ускорение до конца хода.\', \'type\': \'Существо — Огр Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389072&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'96894bf4-dfef-4e7f-aaff-0abc4819e699\', \'multiverseId\': 389072}, \'multiverseid\': 389072}, {\'name\': \'蛮野指套剑手\', \'text\': \'{2}{G}：蛮野指套剑手得+2/+2直到回合结束。此异能每回合只能起动一次。\\n{2}{U}：将蛮野指套剑手移回其拥有者手上。\\n{R}：蛮野指套剑手获得敏捷异能直到回合结束。\', \'type\': \'生物～食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386920&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'802d8267-0454-4f66-909c-a8be9c5434c2\', \'multiverseId\': 386920}, \'multiverseid\': 386920}, {\'name\': \'蠻野指套劍手\', \'text\': \'{2}{G}：蠻野指套劍手得+2/+2直到回合結束。此異能每回合只能起動一次。\\n{2}{U}：將蠻野指套劍手移回其擁有者手上。\\n{R}：蠻野指套劍手獲得敏捷異能直到回合結束。\', \'type\': \'生物～食人魔／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387189&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'def28bdb-fdd7-44bd-8d58-cac166c0f97b\', \'multiverseId\': 387189}, \'multiverseid\': 387189}]', "[{'name': 'Wildes Hochland', 'text': 'Das Wilde Hochland kommt getappt ins Spiel.\\nWenn das Wilde Hochland ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {G}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387448&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2b13a013-0837-4b48-95df-4c959db00ce7', 'multiverseId': 387448}, 'multiverseid': 387448}, {'name': 'Tierras altas escabrosas', 'text': 'Las Tierras altas escabrosas entran al campo de batalla giradas.\\nCuando las Tierras altas escabrosas entren al campo de batalla, ganas 1 vida.\\n{T}: Agrega {R} o {G} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389331&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '19020620-bbbf-4af9-bd03-f47b8e7b11f0', 'multiverseId': 389331}, 'multiverseid': 389331}, {'name': 'Hautes terres rocailleuses', 'text': 'Les Hautes terres rocailleuses arrivent sur le champ de bataille engagées.\\nQuand les Hautes terres rocailleuses arrivent sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {R} ou {G} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387717&type=card', 'language': 'French', 'identifiers': {'scryfallId': '825affdd-57ca-4784-add7-1a308c2ec0ad', 'multiverseId': 387717}, 'multiverseid': 387717}, {'name': 'Altopiani Accidentati', 'text': 'Gli Altopiani Accidentati entrano nel campo di battaglia TAPpati.\\nQuando gli Altopiani Accidentati entrano nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {R} o {G} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387986&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4651bcc4-ea53-4f7a-9ea0-51715208aef3', 'multiverseId': 387986}, 'multiverseid': 387986}, {'name': '岩だらけの高地', 'text': '岩だらけの高地はタップ状態で戦場に出る。\\n岩だらけの高地が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{R}か{G}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388255&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '33009775-cd27-4614-b9ce-752e60a0bbfd', 'multiverseId': 388255}, 'multiverseid': 388255}, {'name': '바위투성이 고산지대', 'text': '바위투성이 고산지대는 탭된 채로 전장에 들어온다.\\n바위투성이 고산지대가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {R} 또는 {G}를 당신의 마나풀에 담는다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388524&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '029296e4-896d-496f-8924-797494b684d0', 'multiverseId': 388524}, 'multiverseid': 388524}, {'name': 'Planalto Acidentado', 'text': 'Planalto Acidentado entra no campo de batalha virado.\\nQuando Planalto Acidentado entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {R} ou {G} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388793&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dd25bd47-8632-45de-8c8a-11513bbecf5f', 'multiverseId': 388793}, 'multiverseid': 388793}, {'name': 'Непроходимые Горы', 'text': 'Непроходимые Горы выходят на поле битвы повернутыми.\\nКогда Непроходимые Горы выходят на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {R} или {G} в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389062&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '569ab465-12e3-41c2-8c5c-e0d7e955a999', 'multiverseId': 389062}, 'multiverseid': 389062}, {'name': '崎岖高地', 'text': '崎岖高地须横置进战场。\\n当崎岖高地进战场时，你获得1点生命。\\n{T}：加{R}或{G}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386910&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '976cec84-8ee6-47c7-a02a-5288f83b2d8b', 'multiverseId': 386910}, 'multiverseid': 386910}, {'name': '崎嶇高地', 'text': '崎嶇高地須橫置進戰場。\\n當崎嶇高地進戰場時，你獲得1點生命。\\n{T}：加{R}或{G}到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387179&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd7c10bef-eab9-4dd1-865f-01e48be3087b', 'multiverseId': 387179}, 'multiverseid': 387179}]", "[{'name': 'Windgepeitschte Felswand', 'text': 'Die Windgepeitschte Felswand kommt getappt ins Spiel.\\nWenn die Windgepeitschte Felswand ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387530&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7e1426da-137f-4043-9ffb-a069190102fb', 'multiverseId': 387530}, 'multiverseid': 387530}, {'name': 'Risco cicatriz del viento', 'text': 'El Risco cicatriz del viento entra al campo de batalla girado.\\nCuando el Risco cicatriz del viento entre al campo de batalla, ganas 1 vida.\\n{T}: Agrega {R} o {W} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389413&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e9f829ba-c73b-4776-80c1-97dfa33ebe81', 'multiverseId': 389413}, 'multiverseid': 389413}, {'name': 'Cordillère marquée par les vents', 'text': 'La Cordillère marquée par les vents arrive sur le champ de bataille engagée.\\nQuand la Cordillère marquée par les vents arrive sur le champ de bataille, vous gagnez 1 point de vie.\\n{T} : Ajoutez {R} ou {W} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387799&type=card', 'language': 'French', 'identifiers': {'scryfallId': '428f4875-5d76-4f0b-986f-b4bfb5fa0130', 'multiverseId': 387799}, 'multiverseid': 387799}, {'name': 'Dirupo Eroso dai Venti', 'text': 'Il Dirupo Eroso dai Venti entra nel campo di battaglia TAPpato.\\nQuando il Dirupo Eroso dai Venti entra nel campo di battaglia, guadagni 1 punto vita.\\n{T}: Aggiungi {R} o {W} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388068&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9171a2d8-f3c9-449a-8ed0-cf3e7c1eaec1', 'multiverseId': 388068}, 'multiverseid': 388068}, {'name': '風に削られた岩山', 'text': '風に削られた岩山はタップ状態で戦場に出る。\\n風に削られた岩山が戦場に出たとき、あなたは１点のライフを得る。\\n{T}：あなたのマナ・プールに{R}か{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388337&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '89f5c12b-a859-4a80-a34a-5de4f6eb2f3e', 'multiverseId': 388337}, 'multiverseid': 388337}, {'name': '풍화된 암석지대', 'text': '풍화된 암석지대는 탭된 채로 전장에 들어온다.\\n풍화된 암석지대가 전장에 들어올 때, 당신은 생명 1점을 얻는다.\\n{T}: {R} 또는 {W}를 당신의 마나풀에 담는다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388606&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bf504e6f-933e-419e-908a-ecb54ae4ac6f', 'multiverseId': 388606}, 'multiverseid': 388606}, {'name': 'Penhasco Marcado pelo Vento', 'text': 'Penhasco Marcado pelo Vento entra no campo de batalha virado.\\nPenhasco Marcado pelo Vento entra no campo de batalha, você ganha 1 ponto de vida.\\n{T}: Adicione {R} ou {W} à sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388875&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fd10875c-da15-41b9-9ece-721773dd09ff', 'multiverseId': 388875}, 'multiverseid': 388875}, {'name': 'Обветренный Утес', 'text': 'Обветренный Утес выходит на поле битвы повернутым.\\nКогда Обветренный Утес выходит на поле битвы, вы получаете 1 жизнь.\\n{T}: добавьте {R} или {W} в ваше хранилище маны.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389144&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6a89a33d-ea54-4c8a-af88-6fa5bf0a9449', 'multiverseId': 389144}, 'multiverseid': 389144}, {'name': '风蚀峭壁', 'text': '风蚀峭壁须横置进战场。\\n当风蚀峭壁进战场时，你获得1点生命。\\n{T}：加{R}或{W}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386992&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c2ff1e2b-807c-4747-84bc-a9f9e46d2428', 'multiverseId': 386992}, 'multiverseid': 386992}, {'name': '風蝕峭壁', 'text': '風蝕峭壁須橫置進戰場。\\n當風蝕峭壁進戰場時，你獲得1點生命。\\n{T}：加{R}或{W}到你的魔法力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387261&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '45c9a0cb-ee93-4b79-9a55-819c0abef94f', 'multiverseId': 387261}, 'multiverseid': 387261}]", '[{\'name\': \'Windsturm\', \'text\': \'Der Windsturm fügt allen fliegenden Kreaturen X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Als der letzte Drache fiel, entfloh sein Geist als Gebrüll in den Wind." —Erzählung der Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7178708c-5310-4e2d-8ab6-3fa0358b505c\', \'multiverseId\': 387531}, \'multiverseid\': 387531}, {\'name\': \'Tormenta de viento\', \'text\': \'La Tormenta de viento hace X puntos de daño a cada criatura con la habilidad de volar.\', \'type\': \'Instantáneo\', \'flavor\': \'"Cuando cayó el último dragón, su espíritu escapó como un rugido lanzado al viento". —Cuento temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389414&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb83e845-4c1f-4899-90f5-5376a80364bb\', \'multiverseId\': 389414}, \'multiverseid\': 389414}, {\'name\': \'Trombe\', \'text\': \'La Trombe inflige X blessures à chaque créature avec le vol.\', \'type\': \'Éphémère\', \'flavor\': "« Lorsque le dernier dragon fut abattu, son esprit s\'échappa tel un rugissement dans le vent. » —Récit témurien", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387800&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d05c4e4-ccc6-4e14-b9f0-0df5db460d7a\', \'multiverseId\': 387800}, \'multiverseid\': 387800}, {\'name\': \'Tempesta di Vento\', \'text\': \'La Tempesta di Vento infligge X danni a ogni creatura con volare.\', \'type\': \'Istantaneo\', \'flavor\': \'"Quando l\\\'ultimo drago cadde, il suo spirito sfuggì come un ruggito nel vento." —Racconto Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388069&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'48466fb6-e8bc-461d-9d44-1fbca46399d1\', \'multiverseId\': 388069}, \'multiverseid\': 388069}, {\'name\': \'暴風\', \'text\': \'暴風は飛行を持つ各クリーチャーに、それぞれＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「最後の龍が倒れた時、その魂は咆哮と共に風に乗って去っていった。」 ――ティムールの物語\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388338&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47ee3ce0-d061-49d0-8066-3fd2b190c3be\', \'multiverseId\': 388338}, \'multiverseid\': 388338}, {\'name\': \'폭풍\', \'text\': \'폭풍은 비행을 가진 각 생물에게 피해 X점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"마지막 용이 쓰러졌을 때, 그 영혼은 휘몰아치는 바람의 형상으로 승천했다." —테무르 전승\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388607&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d51d1ea4-d282-4f89-af3b-e1dc75ee69e1\', \'multiverseId\': 388607}, \'multiverseid\': 388607}, {\'name\': \'Vendaval\', \'text\': \'Vendaval causa X pontos de dano a cada criatura com voar.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Quando o último dragão caiu, seu espírito escapou como um rugido ao vento." — Conto dos Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'defc45de-5b61-4764-8c28-8e57299860cb\', \'multiverseId\': 388876}, \'multiverseid\': 388876}, {\'name\': \'Штормовой Ветер\', \'text\': \'Штормовой Ветер наносит Х повреждений каждому существу с Полетом.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Когда пал последний дракон, его дух ускользнул и стал ревом ветра». — темурская легенда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389145&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'11f3a725-40de-49c1-9238-0dc1b2ff5c1c\', \'multiverseId\': 389145}, \'multiverseid\': 389145}, {\'name\': \'大风暴\', \'text\': \'大风暴对每个具飞行异能的生物各造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「当最后一条龙死去时，它的灵魂化作咆哮逃入风中。」 ～铁木尔传说\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386993&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0cefcc0f-53cb-4eae-9835-e97e3322f4a7\', \'multiverseId\': 386993}, \'multiverseid\': 386993}, {\'name\': \'大風暴\', \'text\': \'大風暴對每個具飛行異能的生物各造成X點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「當最後一條龍死去時，牠的靈魂化作咆哮逃入風中。」 ～鐵木爾傳說\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387262&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b17a6f77-53dc-46c6-96ac-358cd3bbf005\', \'multiverseId\': 387262}, \'multiverseid\': 387262}]', '[{\'name\': \'Winterflamme\', \'text\': \'Bestimme eines oder beides —\\n• Tappe eine Kreatur deiner Wahl.\\n• Die Winterflamme fügt einer Kreatur deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Berge schreien mit den Kehlen der Drachen." —Chianul, Zweifach-Flüsterer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387534&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ebed359-4832-4865-8c54-1d76aa4474b6\', \'multiverseId\': 387534}, \'multiverseid\': 387534}, {\'name\': \'Llama invernal\', \'text\': \'Elige uno o ambos:\\n• Gira la criatura objetivo.\\n• La Llama invernal hace 2 puntos de daño a la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Las montañas rugen con las gargantas de los dragones". —Chianul, Doble susurro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389417&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc77535e-1d78-4482-9883-71a44cd2da79\', \'multiverseId\': 389417}, \'multiverseid\': 389417}, {\'name\': \'Flamme hivernale\', \'text\': "Choisissez l\'un ou les deux —\\n• Engagez la créature ciblée.\\n• La Flamme hivernale inflige 2 blessures à la créature ciblée.", \'type\': \'Éphémère\', \'flavor\': \'« Le cri des montagnes émane de la gorge des dragons. » —Chëanul, le Passeur de murmures\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387803&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42b3ab4f-adf1-4e38-a2ac-7fe7d846e4aa\', \'multiverseId\': 387803}, \'multiverseid\': 387803}, {\'name\': "Fiamma d\'Inverno", \'text\': "Scegli uno o entrambi —\\n• TAPpa una creatura bersaglio.\\n• La Fiamma d\'Inverno infligge 2 danni a una creatura bersaglio.", \'type\': \'Istantaneo\', \'flavor\': \'"I monti gridano con le fauci dei draghi." —Chianul, Duplice Sussurro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388072&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7528ee36-f207-44bc-9c98-262c4eec7c32\', \'multiverseId\': 388072}, \'multiverseid\': 388072}, {\'name\': \'冬の炎\', \'text\': \'以下から１つまたは両方を選ぶ。\\n・クリーチャー１体を対象とし、それをタップする。\\n・クリーチャー１体を対象とする。冬の炎はそれに２点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「山は龍の喉から発せられる叫びを上げる。」 ――二度囁く者、チアヌル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388341&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d79e70a-fe24-4fe3-be2e-009670b1e4f5\', \'multiverseId\': 388341}, \'multiverseid\': 388341}, {\'name\': \'겨울불꽃\', \'text\': \'하나 혹은 둘 다를 선택한다 —\\n• 생물을 목표로 정한다. 그 생물을 탭한다.\\n• 생물을 목표로 정한다. 겨울불꽃은 그 생물에게 피해 2점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"산들은 용의 목구멍으로 비명을 지른다." —두 번 속삭이는 자 치아눌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388610&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dbdfdf45-1d83-4b35-ab09-aa738cea9f8e\', \'multiverseId\': 388610}, \'multiverseid\': 388610}, {\'name\': \'Chama Hibernal\', \'text\': \'Escolha um ou os dois —\\n• Vire a criatura alvo.\\n• Chama Hibernal causa 2 pontos de dano à criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As montanhas gritam com a voz dos dragões." — Chianul, Sussurrador Duplo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388879&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c2989eb6-4bb4-4a72-b356-4a7086d79eb0\', \'multiverseId\': 388879}, \'multiverseid\': 388879}, {\'name\': \'Зимнее Пламя\', \'text\': \'Выберите одно или оба —\\n• Поверните целевое существо.\\n• Зимнее Пламя наносит 2 повреждения целевому существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Горы кричат глотками драконов». — Чианул, Шепчущий Дважды\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389148&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9c1ac348-ce7f-4a5b-9551-82144a48a16d\', \'multiverseId\': 389148}, \'multiverseid\': 389148}, {\'name\': \'燃冬焰\', \'text\': \'选择一项或都选～\\n•横置目标生物。\\n•燃冬焰对目标生物造成2点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「群山经巨龙之吼尖啸。」 ～通灵祭师恰努尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386996&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e5ef18fe-1413-465f-a528-1d5ce5b45ba3\', \'multiverseId\': 386996}, \'multiverseid\': 386996}, {\'name\': \'燃冬焰\', \'text\': \'選擇一項或都選～\\n•橫置目標生物。\\n•燃冬焰對目標生物造成2點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「群山經巨龍之吼尖嘯。」 ～通靈祭師恰努爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387265&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9492e1e5-10bf-4929-9b89-d28f5d8703a9\', \'multiverseId\': 387265}, \'multiverseid\': 387265}]', '[{\'name\': \'Wollloxodon\', \'text\': \'Morph {5}{G} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\', \'type\': \'Kreatur — Elefant, Krieger\', \'flavor\': \'Selbst unter den zähesten Kriegern der Temur wird den Loxodons für ihre Anpassung an den Schnee der Berge Respekt gezollt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387537&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c71b565f-3a79-474c-a7f5-2ceb16ec9325\', \'multiverseId\': 387537}, \'multiverseid\': 387537}, {\'name\': \'Loxodón lanudo\', \'text\': \'Metamorfosis {5}{G}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\', \'type\': \'Criatura — Guerrero elefante\', \'flavor\': \'Incluso entre los guerreros más feroces de los Temur, los loxodones cuentan con gran respeto por su gran capacidad de adaptación a las nieves de las montañas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389420&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79a868f9-8870-4238-8d7c-226a52e81800\', \'multiverseId\': 389420}, \'multiverseid\': 389420}, {\'name\': \'Loxodon laineux\', \'text\': \'Mue {5}{G} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\', \'type\': \'Créature : éléphant et guerrier\', \'flavor\': "Même les plus hardis des guerriers temuriens respectent les loxodons et leur capacité d\'adaptation au climat neigeux des montagnes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6e692cd-22f5-4013-b5a4-3f99c4661769\', \'multiverseId\': 387806}, \'multiverseid\': 387806}, {\'name\': \'Lossodonte Lanuto\', \'text\': \'Metamorfosi {5}{G} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\', \'type\': \'Creatura — Guerriero Elefante\', \'flavor\': \'Persino tra i più vigorosi guerrieri dei Temur, i lossodonti sono rispettati per la loro capacità di adattarsi alle nevi montane.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388075&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'910f2049-2e77-4672-b1a7-5cfef85963f2\', \'multiverseId\': 388075}, \'multiverseid\': 388075}, {\'name\': \'長毛ロクソドン\', \'text\': \'変異{5}{G}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\', \'type\': \'クリーチャー — 象・戦士\', \'flavor\': \'その山の雪への対応力により、ロクソドンはティムールの最も頑強な戦士たちからも尊敬されている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388344&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'11930724-a232-46b5-96a5-dbc29f38951a\', \'multiverseId\': 388344}, \'multiverseid\': 388344}, {\'name\': \'털복숭이 록소돈\', \'text\': \'변이 {5}{G} (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\', \'type\': \'생물 — 코끼리 전사\', \'flavor\': \'테무르 개척민의 가장 강인한 전사들조차 설산에 적응한 록소돈에 경의를 표했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388613&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ef05bdd0-6844-4bb7-872c-27282b04da82\', \'multiverseId\': 388613}, \'multiverseid\': 388613}, {\'name\': \'Loxodonte Lanoso\', \'text\': \'Metamorfose {5}{G} (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\', \'type\': \'Criatura — Elefante Guerreiro\', \'flavor\': \'Mesmo entre os guerreiros Temur mais resistentes, os loxodontes são respeitados por sua adaptação às montanhas nevadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d45e8fec-faf2-4e9f-ba60-ee6be4f16171\', \'multiverseId\': 388882}, \'multiverseid\': 388882}, {\'name\': \'Мохнатый Локсодон\', \'text\': \'Оборотень {5}{G} (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\', \'type\': \'Существо — Слон Воин\', \'flavor\': \'Даже среди самых выносливых воинов Темура локсодоны пользуются уважением за то, как они приспособились к жизни среди снежных вершин.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389151&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99a95e35-acc6-4dd9-8700-1acab1a06acf\', \'multiverseId\': 389151}, \'multiverseid\': 389151}, {\'name\': \'粗茸象族\', \'text\': \'变身{5}{G}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\', \'type\': \'生物～象／战士\', \'flavor\': \'就连铁木尔最耐寒的战士，也对能够适应山地暴雪的象族带有几分敬意。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386999&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b7eb9ba-5d06-4694-b2c1-54bf611d2ca5\', \'multiverseId\': 386999}, \'multiverseid\': 386999}, {\'name\': \'粗茸象族\', \'text\': \'變身{5}{G}（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\', \'type\': \'生物～象／戰士\', \'flavor\': \'就連鐵木爾最耐寒的戰士，也對能夠適應山地暴雪的象族帶有幾分敬意。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387268&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'646fdbd4-719a-4648-98fe-d92834d02d3a\', \'multiverseId\': 387268}, \'multiverseid\': 387268}]', "[{'name': 'Wächter des Spähnests', 'text': 'Fliegend\\nMorph—Zeige eine weiße Karte auf deiner Hand offen vor. (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Wächter des Spähnests aufgedeckt wird, erhältst du 2 Lebenspunkte dazu.', 'type': 'Kreatur — Vogel, Soldat', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387525&type=card', 'language': 'German', 'identifiers': {'scryfallId': '68d6d321-84bf-4ee1-bd8c-cdc764dd0ee8', 'multiverseId': 387525}, 'multiverseid': 387525}, {'name': 'Vigilante del nido', 'text': 'Vuela.\\nMetamorfosis—Muestra una carta blanca de tu mano. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Vigilante del nido se ponga boca arriba, ganas 2 vidas.', 'type': 'Criatura — Soldado ave', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389408&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '358982e8-eb81-48ea-b24a-0273e5254cdf', 'multiverseId': 389408}, 'multiverseid': 389408}, {'name': 'Gardien du perchoir', 'text': 'Vol\\nMue — Révélez une carte blanche de votre main. (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand le Gardien du perchoir est retourné face visible, vous gagnez 2 points de vie.', 'type': 'Créature : oiseau et soldat', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387794&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a26f44de-770a-4f07-88fe-4dac04d10fc3', 'multiverseId': 387794}, 'multiverseid': 387794}, {'name': 'Guardiano del Trespolo', 'text': 'Volare\\nMetamorfosi—Rivela una carta bianca dalla tua mano. (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando il Guardiano del Trespolo viene girato a faccia in su, guadagni 2 punti vita.', 'type': 'Creatura — Soldato Uccello', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388063&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a59187fd-0d26-46e6-8be6-677e69754401', 'multiverseId': 388063}, 'multiverseid': 388063}, {'name': '休息地の見張り', 'text': '飛行\\n変異 ― あなたの手札にある白のカードを１枚公開する。（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n休息地の見張りが表向きになったとき、あなたは２点のライフを得る。', 'type': 'クリーチャー — 鳥・兵士', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388332&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cec50ee2-8cb3-426d-8d8a-50504453b921', 'multiverseId': 388332}, 'multiverseid': 388332}, {'name': '둥지 파수꾼', 'text': '비행\\n변이—당신의 손에서 백색 카드 한 장을 공개한다. (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\\n둥지 파수꾼이 앞면으로 뒤집히면, 당신은 생명 2점을 얻는다.', 'type': '생물 — 조류 병사', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388601&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '822d230b-596c-4ba6-8be3-e4db749c2bac', 'multiverseId': 388601}, 'multiverseid': 388601}, {'name': 'Vigia do Poleiro', 'text': 'Voar\\nMetamorfose — Revele um card branco na sua mão. (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Vigia do Poleiro é voltado para cima, você ganha 2 pontos de vida.', 'type': 'Criatura — Ave Soldado', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388870&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9654fc9e-4400-49ec-b04e-5b50a912d7c7', 'multiverseId': 388870}, 'multiverseid': 388870}, {'name': 'Дозорный Насеста', 'text': 'Полет\\nОборотень — Покажите белую карту, находящуюся в вашей руке. (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\\nКогда Дозорный Насеста переворачивается рубашкой вниз, вы получаете 2 жизни.', 'type': 'Существо — Птица Солдат', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389139&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2d4f9340-0af0-4e25-a5bd-9b10ff412f7e', 'multiverseId': 389139}, 'multiverseid': 389139}, {'name': '眺巢看守', 'text': '飞行\\n变身～从你手上展示一张白色牌。（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当眺巢看守翻回正面时，你获得2点生命。', 'type': '生物～鸟／士兵', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386987&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3e711972-8889-463c-ac66-8fcdc2b9f292', 'multiverseId': 386987}, 'multiverseid': 386987}, {'name': '眺巢看守', 'text': '飛行\\n變身～從你手上展示一張白色牌。（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\\n當眺巢看守翻回正面時，你獲得2點生命。', 'type': '生物～鳥／士兵', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387256&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c0c2a5ce-f4ad-4972-8fa4-7e0678afda34', 'multiverseId': 387256}, 'multiverseid': 387256}]", '[{\'name\': \'Zersplittern\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Oger verlor die Selbstbeherrschung. Der Bogen verlor seine Spannkraft. Gleich darauf verlor der Bogenschütze sein Leben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387470&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'698eba21-280e-41bf-b182-8c1c7a1b6fc3\', \'multiverseId\': 387470}, \'multiverseid\': 387470}, {\'name\': \'Romper\', \'text\': \'Destruye el artefacto objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'La mente del ogro se quebró; el arco fue lo siguiente, y el arquero no tardó en seguirlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389353&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'091f7ca6-1f06-4f77-99df-ebd046382125\', \'multiverseId\': 389353}, \'multiverseid\': 389353}, {\'name\': \'Fracasser\', \'text\': "Détruisez l\'artefact ciblé.", \'type\': \'Éphémère\', \'flavor\': "L\'esprit de l\'ogre se brisa. L\'arc fit de même. L\'archer suivit peu de temps après.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387739&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cb60a823-4709-462e-911d-67f0597d65c4\', \'multiverseId\': 387739}, \'multiverseid\': 387739}, {\'name\': \'Distruggi Artefatto\', \'text\': \'Distruggi un artefatto bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "La furia dell\'ogre squarciò l\'aria. La stessa sorte toccò poi all\'arco e nel giro di pochi istanti all\'arciere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388008&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fd3f993c-70e9-4ba7-b025-d9eb259c2771\', \'multiverseId\': 388008}, \'multiverseid\': 388008}, {\'name\': \'粉砕\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'オーガの堪忍袋の緒が弾け飛んだ。その次に弓も。射手もすぐその後を追った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388277&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'648a540c-c2b7-4ec2-9403-6406fabe6790\', \'multiverseId\': 388277}, \'multiverseid\': 388277}, {\'name\': \'산산조각\', \'text\': \'마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'오우거의 이성이 박살났다. 그 다음은 활. 바로 다음이 궁수의 차례였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388546&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'297754e4-2ff7-41ce-9580-400c3a506122\', \'multiverseId\': 388546}, \'multiverseid\': 388546}, {\'name\': \'Estilhaçar\', \'text\': \'Destrua o artefato alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A fúria do ogro rompeu tudo ao redor, começando pelo arco. Logo foi a vez do arqueiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9edeba5f-64ae-4276-8b56-63574f6c7166\', \'multiverseId\': 388815}, \'multiverseid\': 388815}, {\'name\': \'Раскол\', \'text\': \'Уничтожьте целевой артефакт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Разум огра не выдержал. За ним сломался лук. Следующим был сам лучник.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389084&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'44b3b9c5-e170-41c5-9a72-6774c099f856\', \'multiverseId\': 389084}, \'multiverseid\': 389084}, {\'name\': \'粉碎\', \'text\': \'消灭目标神器。\', \'type\': \'瞬间\', \'flavor\': \'食人魔理智断线，一把折断弓身，随即了结箭手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386932&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d1f4f03-cee3-4a5c-9b65-e3425afd08e8\', \'multiverseId\': 386932}, \'multiverseid\': 386932}, {\'name\': \'粉碎\', \'text\': \'消滅目標神器。\', \'type\': \'瞬間\', \'flavor\': \'食人魔理智斷線，一把折斷弓身。隨即了結箭手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387201&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a3d3716-52b8-4933-ac8b-ebc8e681977d\', \'multiverseId\': 387201}, \'multiverseid\': 387201}]', "[{'name': 'Zerzauste Heide', 'text': '{T}, bezahle 1 Lebenspunkt, opfere die Zerzauste Heide: Durchsuche deine Bibliothek nach einer Wald- oder Ebene-Karte und bringe sie ins Spiel. Mische danach deine Bibliothek.', 'type': 'Land', 'flavor': 'Wo Drachen einst brüllten, wehklagen nun ihre Knochen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387532&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e008bef5-9b4e-4701-b2ba-e81e740db9a2', 'multiverseId': 387532}, 'multiverseid': 387532}, {'name': 'Brezal azotado por el viento', 'text': '{T}, pagar 1 vida, sacrificar el Brezal azotado por el viento: Busca en tu biblioteca una carta de bosque o llanura y ponla en el campo de batalla. Luego baraja tu biblioteca.', 'type': 'Tierra', 'flavor': 'Allá donde en otro tiempo rugían los dragones, ahora se lamentan sus huesos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389415&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4734256e-9d4a-4775-84ee-fba1dc7ec93d', 'multiverseId': 389415}, 'multiverseid': 389415}, {'name': 'Lande venteuse', 'text': '{T}, payez 1 point de vie, sacrifiez la Lande venteuse : Cherchez dans votre bibliothèque une carte de forêt ou de plaine et mettez-la sur le champ de bataille. Mélangez ensuite votre bibliothèque.', 'type': 'Terrain', 'flavor': 'Là où les dragons rugirent jadis, leurs os gémissent désormais.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387801&type=card', 'language': 'French', 'identifiers': {'scryfallId': '21ddabee-3ffc-4573-9fb9-e4729ba5bb61', 'multiverseId': 387801}, 'multiverseid': 387801}, {'name': 'Landa Ventosa', 'text': '{T}, Paga 1 punto vita, Sacrifica la Landa Ventosa: Passa in rassegna il tuo grimorio per una carta Foresta o Pianura e mettila sul campo di battaglia. Poi rimescola il tuo grimorio.', 'type': 'Terra', 'flavor': 'Dove un tempo ruggivano i draghi, ora gemono le loro ossa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388070&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c717952b-eb2b-47c4-b2f2-c835bd5d354f', 'multiverseId': 388070}, 'multiverseid': 388070}, {'name': '吹きさらしの荒野', 'text': '{T}, ライフを１点支払う, 吹きさらしの荒野を生け贄に捧げる：あなたのライブラリーから森・カードか平地・カードを１枚探し、それを戦場に出す。その後あなたのライブラリーを切り直す。', 'type': '土地', 'flavor': 'かつて龍たちが咆哮を轟かせた場所は、今では彼らの骨が風を切る音が響くだけである。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388339&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '69d6c3f4-7a62-489c-80b7-e472efacc52c', 'multiverseId': 388339}, 'multiverseid': 388339}, {'name': '바람이 몰아치는 초원', 'text': '{T}, 생명 1점을 지불한다, 바람이 몰아치는 초원을 희생한다: 당신의 서고에서 숲이나 들 카드 한 장을 찾아 전장에 놓는다. 그러고 나서 당신의 서고를 섞는다.', 'type': '대지', 'flavor': '한때 용들이 포효하던 이곳에는 이제 통곡하는 용의 뼈만 남아있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388608&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'ea4f4289-b693-45c0-8a6a-4c2fc388656e', 'multiverseId': 388608}, 'multiverseid': 388608}, {'name': 'Urzal Ventoso', 'text': '{T}, Pague 1 ponto de vida, Sacrifique Urzal Ventoso: Procure um card de Floresta ou Planície em seu grimório e coloque-o no campo de batalha. Depois, embaralhe seu grimório.', 'type': 'Terreno', 'flavor': 'Onde os dragões um dia rugiram, hoje seus ossos calam.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388877&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e85f0cc6-6c76-40f7-b757-05a1737cca6b', 'multiverseId': 388877}, 'multiverseid': 388877}, {'name': 'Ветреная Пустошь', 'text': '{T}, заплатите 1 жизнь, пожертвуйте Ветреную Пустошь: найдите в вашей библиотеке карту Леса или Равнины и положите ее на поле битвы. Затем перетасуйте вашу библиотеку.', 'type': 'Земля', 'flavor': 'Там, где когда-то ревели драконы, теперь ветер шумит в их костях.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389146&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2c534cd2-61b1-4cde-b165-038c3e2c0215', 'multiverseId': 389146}, 'multiverseid': 389146}, {'name': '风袭荒地', 'text': '{T}，支付1点生命，牺牲风袭荒地：从你的牌库中搜寻一张树林或平原牌，并将之放进战场。然后将你的牌库洗牌。', 'type': '地', 'flavor': '群龙咆哮处，空余骨嘶鸣。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386994&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2090018a-981a-43e5-a46c-22fdabebf175', 'multiverseId': 386994}, 'multiverseid': 386994}, {'name': '風襲荒地', 'text': '{T}，支付1點生命，犧牲風襲荒地：從你的牌庫中搜尋一張樹林或平原牌，並將之放進戰場。然後將你的牌庫洗牌。', 'type': '地', 'flavor': '群龍咆哮處，空餘骨嘶鳴。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387263&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '69cb4b9f-cc14-4f3d-a819-1bca0f662c5b', 'multiverseId': 387263}, 'multiverseid': 387263}]", '[{\'name\': \'Zeuge der Zeitalter\', \'text\': \'Morph {5} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Er erlebte die Kämpfe der Drachen, den Fall Ugins und den Aufstieg der Khans.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e1f50c10-acca-4d9f-91a4-5064a49e9a45\', \'multiverseId\': 387535}, \'multiverseid\': 387535}, {\'name\': \'Testigo de las eras\', \'text\': \'Metamorfosis {5}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'No cesó de avanzar cuando se enfrentaron los dragones, cuando Ugin cayó ni cuando se alzaron los kans.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389418&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3fd67238-aeb3-4def-bf96-049bb22b9948\', \'multiverseId\': 389418}, \'multiverseid\': 389418}, {\'name\': \'Témoin des âges\', \'text\': \'Mue {5} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\', \'type\': \'Créature-artefact : golem\', \'flavor\': "Il traversa la guerre des dragons, la chute d\'Ugin et l\'ascension des khans.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e23eab40-83b8-4aea-b688-5ae3c03c8307\', \'multiverseId\': 387804}, \'multiverseid\': 387804}, {\'name\': "Testimone dell\'Eternità", \'text\': \'Metamorfosi {5} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': "Ha assistito allo scontro dei draghi, alla caduta di Ugin e all\'ascesa dei khan.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'576dd914-3a6f-4b31-831f-042776a4f198\', \'multiverseId\': 388073}, \'multiverseid\': 388073}, {\'name\': \'星霜の証人\', \'text\': \'変異{5}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'それは龍たちの激突、ウギンの最後、そしてカンたちの興隆のすべての時代を歩いてきた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'beec1890-3a1b-4661-93bc-fdd265dc5a78\', \'multiverseId\': 388342}, \'multiverseid\': 388342}, {\'name\': \'시대의 증인\', \'text\': \'변이 {5} (당신은 {3}을 지불해서 이 카드를 뒷면 상태의 2/2 생물로 발동할 수 있다. 언제든지 변이 비용을 지불하고 앞면이 보이도록 뒤집을 수 있다.)\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': \'이 골렘은 용들의 격돌부터 우진의 죽음, 그리고 칸들의 등장까지 함께 걸어왔다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388611&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'12439d69-8b85-47f2-be2e-a479e753ec00\', \'multiverseId\': 388611}, \'multiverseid\': 388611}, {\'name\': \'Testemunha das Eras\', \'text\': \'Metamorfose {5} (Você pode conjurar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Volte sua face para cima a qualquer momento pagando seu custo de metamorfose.)\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Ele passou pela guerra dos dragões, pela queda de Ugin e pelo surgimento dos khans.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388880&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'03ff0118-6016-489d-b6c8-5fdbfa8ff125\', \'multiverseId\': 388880}, \'multiverseid\': 388880}, {\'name\': \'Свидетель Веков\', \'text\': \'Оборотень {5} (Вы можете разыграть эту карту рубашкой вверх как существо 2/2 за {3}. Переверните ее рубашкой вниз в любой момент за ее стоимость Оборотня.)\', \'type\': \'Артефакт Существо — Голем\', \'flavor\': \'Сражались драконы, пал Уджин, пришли к власти ханы, а он все бродил по земле.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389149&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8f0481fe-d702-4d3f-93ef-7dbfc8bbc0f8\', \'multiverseId\': 389149}, \'multiverseid\': 389149}, {\'name\': \'岁月见证人\', \'text\': \'变身{5}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\', \'type\': \'神器生物～魔像\', \'flavor\': \'它经历了巨龙的冲突、乌金的死亡以及可汗的崛起。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386997&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e836ccd-6b6b-413d-9d0a-06ea6edf6d1f\', \'multiverseId\': 386997}, \'multiverseid\': 386997}, {\'name\': \'歲月見證人\', \'text\': \'變身{5}（你可牌面朝下地施放此牌並支付{3}，將其當成2/2生物。可隨時支付其變身費用使其翻回正面。）\', \'type\': \'神器生物～魔像\', \'flavor\': \'它經歷了巨龍的衝突、烏金的死亡以及可汗的崛起。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387266&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1622818f-2080-46da-b4ab-a2775ff4e3f0\', \'multiverseId\': 387266}, \'multiverseid\': 387266}]', '[{\'name\': \'Zu Fall bringen\', \'text\': \'Zu Fall bringen fügt einer Kreatur deiner Wahl 3 Schadenspunkte zu. Falls mindestens eine +1/+1-Marke auf dieser Kreatur liegt, fügt Zu Fall bringen ihr stattdessen 5 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Leute werden oft von den Elementen gedemütigt. Doch auch die Elemente können Demut lernen." —Surrak, Khan der Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387306&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'74a1e0dd-4ee1-46d0-8a68-18417658b55d\', \'multiverseId\': 387306}, \'multiverseid\': 387306}, {\'name\': \'Degradar\', \'text\': \'Degradar hace 3 puntos de daño a la criatura objetivo. Si esa criatura tiene un contador +1/+1 sobre ella, en vez de eso, Degradar le hace 5 puntos de daño.\', \'type\': \'Instantáneo\', \'flavor\': \'"A veces las personas se sienten pequeñas ante los elementos. Pero también se puede hacer sentir pequeños a los elementos". —Surrak, kan de los Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389189&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7277c5d0-ecea-4860-b82d-5328a5719a2a\', \'multiverseId\': 389189}, \'multiverseid\': 389189}, {\'name\': \'Mettre à bas\', \'text\': \'Mettre à bas inflige 3 blessures à la créature ciblée. Si cette créature a un marqueur +1/+1 sur elle, Mettre à bas lui inflige 5 blessures à la place.\', \'type\': \'Éphémère\', \'flavor\': "« Les hommes s\'inclinent face aux éléments. Mais eux aussi peuvent s\'incliner. » —Surrak, khan des Temur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387575&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72ca789e-09b0-451c-8b70-2139e40410a7\', \'multiverseId\': 387575}, \'multiverseid\': 387575}, {\'name\': \'Abbattere\', \'text\': \'Abbattere infligge 3 danni a una creatura bersaglio. Se quella creatura ha un segnalino +1/+1, Abbattere le infligge invece 5 danni.\', \'type\': \'Istantaneo\', \'flavor\': \'"Spesso ci lasciamo piegare dagli elementi, ma questi a loro volta possono essere dominati." —Surrak, khan dei Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387844&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'89af593d-c7e7-4b00-966f-cf8fdb651d06\', \'multiverseId\': 387844}, \'multiverseid\': 387844}, {\'name\': \'打ち倒し\', \'text\': \'クリーチャー１体を対象とする。打ち倒しはそれに３点のダメージを与える。そのクリーチャーの上に＋１/＋１カウンターが置かれているなら、代わりに打ち倒しはそれに５点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「人はしばしば自然の力によって萎縮させられる場合がある。しかし、その自然ですら萎縮させられることもある。」 ――ティムールのカン、スーラク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388113&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'446cf8cf-bd93-4a5e-8161-412a83e5f96c\', \'multiverseId\': 388113}, \'multiverseid\': 388113}, {\'name\': \'떨구기\', \'text\': \'생물을 목표로 정한다. 떨구기는 그 생물에 피해 3점을 입힌다. 그 생물에 +1/+1 카운터가 있다면, 대신에 떨구기는 그 생물에 피해 5점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"사람들은 정령의 힘 앞에서 겸손해진다. 하지만 정령이 겸손해지는 경우도 있다." —테무르의 칸 서락\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388382&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5132db18-3383-47ea-9c5d-1c5bcc6690eb\', \'multiverseId\': 388382}, \'multiverseid\': 388382}, {\'name\': \'Levar ao Chão\', \'text\': \'Levar ao Chão causa 3 pontos de dano à criatura alvo. Se a criatura tiver um marcador +1/+1, em vez disso, Levar ao Chão causa 5 pontos de dano.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As pessoas costumam se sentir pequenas diante dos elementos. Mas os elementos também podem se sentir pequenos." — Surrak, khan dos Temur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388651&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e23cd18e-bdf4-402a-b8fc-d3f72dc942c1\', \'multiverseId\': 388651}, \'multiverseid\': 388651}, {\'name\': \'Сбить с Ног\', \'text\': \'Сбить с Ног наносит 3 повреждения целевому существу. Если на том существе есть жетон +1/+1, Сбить с Ног наносит ему 5 повреждений вместо этого.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Люди часто оказываются бессильными пред лицом стихии. Но и стихию можно укротить». — Суррак, хан Темура\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388920&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f51dcd95-3257-436c-ba4c-1ba177b4af34\', \'multiverseId\': 388920}, \'multiverseid\': 388920}, {\'name\': \'放倒\', \'text\': \'放倒对目标生物造成3点伤害。如果该生物上有+1/+1指示物，则改为放倒对其造成5点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「酷境常让人望而生畏，但我们也能够还以颜色。」 ～铁木尔可汗苏拉克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=386768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd7efb20-07a3-49a6-a759-5ebb55f73ba6\', \'multiverseId\': 386768}, \'multiverseid\': 386768}, {\'name\': \'放倒\', \'text\': \'放倒對目標生物造成3點傷害。如果該生物上有+1/+1指示物，則改為放倒對其造成5點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「酷境常讓人望而生畏，但我們也能夠還以顏色。」 ～鐵木爾可汗蘇拉克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387037&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'96e0c3dc-9e20-4dc3-b32b-26f628b8a615\', \'multiverseId\': 387037}, \'multiverseid\': 387037}]', '[{\'name\': \'Zurgo Helmbrecher\', \'text\': \'Eile\\nZurgo Helmbrecher greift in jedem Kampf an, falls möglich.\\nZurgo Helmbrecher hat Unzerstörbarkeit, solange es dein Zug ist.\\nImmer wenn eine Kreatur stirbt, der in diesem Zug von Zurgo Helmbrecher Schaden zugefügt wurde, lege eine +1/+1-Marke auf Zurgo Helmbrecher.\', \'type\': \'Legendäre Kreatur — Ork, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387538&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3f96274-e7ca-46b6-8af9-6f5837d6bcf6\', \'multiverseId\': 387538}, \'multiverseid\': 387538}, {\'name\': \'Zurgo Aplastacráneos\', \'text\': \'Prisa.\\nZurgo Aplastacráneos ataca cada combate si puede.\\nZurgo Aplastacráneos tiene la habilidad de indestructible mientras sea tu turno.\\nSiempre que una criatura que haya recibido daño de Zurgo Aplastacráneos este turno muera, pon un contador +1/+1 sobre Zurgo Aplastacráneos.\', \'type\': \'Criatura legendaria — Guerrero orco\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389421&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ea040052-b84b-41dc-be60-6b3225aa41d0\', \'multiverseId\': 389421}, \'multiverseid\': 389421}, {\'name\': \'Zurgo Brisecasque\', \'text\': "Célérité\\nZurgo Brisecasque attaque à chaque combat si possible.\\nZurgo Brisecasque a l\'indestructible tant que c\'est votre tour.\\nÀ chaque fois qu\'une créature blessée par Zurgo Brisecasque ce tour-ci meurt, mettez un marqueur +1/+1 sur Zurgo Brisecasque.", \'type\': \'Créature légendaire : orque et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387807&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff77a8ac-8f97-4b30-b896-67ad4e67f4c5\', \'multiverseId\': 387807}, \'multiverseid\': 387807}, {\'name\': \'Zurgo Spaccaelmi\', \'text\': \'Rapidità\\nZurgo Spaccaelmi attacca in ogni combattimento, se può farlo.\\nZurgo Spaccaelmi ha indistruttibile fintanto che è il tuo turno.\\nOgniqualvolta una creatura a cui è stato inflitto danno da Zurgo Spaccaelmi in questo turno muore, metti un segnalino +1/+1 su Zurgo Spaccaelmi.\', \'type\': \'Creatura Leggendaria — Guerriero Orco\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388076&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'800968c1-ad7b-413f-9b7e-43bbc9496226\', \'multiverseId\': 388076}, \'multiverseid\': 388076}, {\'name\': \'兜砕きのズルゴ\', \'text\': \'速攻\\n兜砕きのズルゴは可能なら各戦闘で攻撃する。\\nあなたのターンであるかぎり、兜砕きのズルゴは破壊不能を持つ。\\nこのターンに、兜砕きのズルゴによってダメージを与えられたクリーチャーが１体死亡するたび、兜砕きのズルゴの上に＋１/＋１カウンターを１個置く。\', \'type\': \'伝説のクリーチャー — オーク・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388345&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c6de5e9-0fd0-4220-a10c-2b48a12d5afa\', \'multiverseId\': 388345}, \'multiverseid\': 388345}, {\'name\': \'투구분쇄자 주르고\', \'text\': \'신속\\n투구분쇄자 주르고는 가능하면 매 전투마다 공격한다.\\n투구분쇄자 주르고는 당신의 턴인 한, 무적을 가진다.\\n투구분쇄자 주르고에게 이 턴에 피해를 입은 생물이 죽을 때마다, 투구분쇄자 주르고에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'전설적 생물 — 오크 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388614&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'60e962d8-6f1e-47f8-abfc-978b0df1786b\', \'multiverseId\': 388614}, \'multiverseid\': 388614}, {\'name\': \'Zurgo Quebra-elmo\', \'text\': \'Ímpeto\\nZurgo Quebra-elmo ataca a cada combate se estiver apto.\\nZurgo Quebra-elmo tem indestrutível enquanto for o seu turno.\\nToda vez que uma criatura que tiver sofrido dano de Zurgo Quebra-elmo neste turno morrer, coloque um marcador +1/+1 em Zurgo Quebra-elmo.\', \'type\': \'Criatura Lendária — Orc Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=388883&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02d4fcb3-2f1a-4fe5-821c-e6a90516a198\', \'multiverseId\': 388883}, \'multiverseid\': 388883}, {\'name\': \'Зурго Шлемобой\', \'text\': \'Ускорение\\nЗурго Шлемобой атакует в каждом бою, если может.\\nЗурго Шлемобой имеет Неразрушимость, пока длится ваш ход.\\nКаждый раз, когда существо, которому Зурго Шлемобой нанес повреждения в этом ходу, умирает, положите один жетон +1/+1 на Зурго Шлемобоя.\', \'type\': \'Легендарное Существо — Орк Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389152&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'854c4a94-df1e-4dad-ac30-25f4c5c8a1f5\', \'multiverseId\': 389152}, \'multiverseid\': 389152}, {\'name\': \'碎盔珠高\', \'text\': \'敏捷\\n碎盔珠高每次战斗若能攻击，则必须攻击。\\n只要是在你的回合中，碎盔珠高便具有不灭异能。\\n每当一个本回合中曾受到碎盔珠高伤害的生物死去时，在碎盔珠高上放置一个+1/+1指示物。\', \'type\': \'传奇生物～半兽人／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d6fe4ccf-3286-4814-a5e9-8ea2195305b0\', \'multiverseId\': 387000}, \'multiverseid\': 387000}, {\'name\': \'碎盔珠高\', \'text\': \'敏捷\\n碎盔珠高每次戰鬥若能攻擊，則必須攻擊。\\n只要是在你的回合中，碎盔珠高便具有不滅異能。\\n每當一個本回合中曾受到碎盔珠高傷害的生物死去時，在碎盔珠高上放置一個+1/+1指示物。\', \'type\': \'傳奇生物～半獸人／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=387269&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8ff4e40-7569-482a-b35a-5781f796552d\', \'multiverseId\': 387269}, \'multiverseid\': 387269}]']
