ultiverseId': 492247}, 'multiverseid': 492247}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492563&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fc4eca5e-e125-4d50-ad9c-15cac1b4bb9c', 'multiverseId': 492563}, 'multiverseid': 492563}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492879&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4c537d50-c8ae-45a5-b411-fcab0a6f90b3', 'multiverseId': 492879}, 'multiverseid': 492879}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493195&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c2736d01-8a84-4ac1-b55b-95dc620bcc57', 'multiverseId': 493195}, 'multiverseid': 493195}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493511&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4988e157-038c-4b6c-854f-e12f1c53ec90', 'multiverseId': 493511}, 'multiverseid': 493511}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493827&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6f1d292d-b8ce-4d79-9477-c93dcb275ccf', 'multiverseId': 493827}, 'multiverseid': 493827}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494143&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '434f0253-d4fd-430a-b91e-60a0ae4fb875', 'multiverseId': 494143}, 'multiverseid': 494143}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494459&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7e6dcd86-3b8e-4c08-8a40-4a24ecf4220c', 'multiverseId': 494459}, 'multiverseid': 494459}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494775&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '35f67aeb-b0fe-480a-bbfe-9a4b85f9457e', 'multiverseId': 494775}, 'multiverseid': 494775}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495091&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e2eba993-76f2-4439-9eb6-48b4a95904d0', 'multiverseId': 495091}, 'multiverseid': 495091}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495105&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8fa7bc26-b06e-4295-a6a5-805c717dc286', 'multiverseId': 495105}, 'multiverseid': 495105}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495110&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e4194228-dc18-4690-b6be-6b38ba8be14c', 'multiverseId': 495110}, 'multiverseid': 495110}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495115&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'aea8aeef-7304-43d3-a4db-adb326af5f04', 'multiverseId': 495115}, 'multiverseid': 495115}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495120&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6c35e5b4-01af-4da0-86ec-ea4ab80d0a3b', 'multiverseId': 495120}, 'multiverseid': 495120}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495125&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '738cb9aa-7acc-4ee2-9011-7efbccaedc72', 'multiverseId': 495125}, 'multiverseid': 495125}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495130&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '690a614e-6ff6-4320-b0c8-6bb6594806ea', 'multiverseId': 495130}, 'multiverseid': 495130}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495135&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ba9607f8-2941-465c-874e-edfc9367fff1', 'multiverseId': 495135}, 'multiverseid': 495135}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495140&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f92233b4-643d-4225-a7f2-3d3365b95a4b', 'multiverseId': 495140}, 'multiverseid': 495140}, {'name': '沼泽', 'type': '基本地 ～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495145&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bdc28533-98cc-427d-8358-80145156a4be', 'multiverseId': 495145}, 'multiverseid': 495145}, {'name': '沼澤', 'type': '基本地 ～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495150&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd6161677-6a29-4932-b545-406c001f46f8', 'multiverseId': 495150}, 'multiverseid': 495150}]", '[{\'name\': \'Söldner aus Klippenhafen\', \'type\': \'Kreatur — Kor, Krieger\', \'flavor\': \'„Ich schwinge ein Schwert. So einfach ist das. Einige Abenteurer sehen in mir nur billige Muskelkraft, aber wenn sie dank meines Stahls lebend und mit intakten Gliedmaßen nach Hause zurückkehren, habe ich meine Arbeit getan."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491945&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb6005e5-f71a-47d2-af6c-b507dec6034c\', \'multiverseId\': 491945}, \'multiverseid\': 491945}, {\'name\': \'Sicario de Refugio Cornisa\', \'type\': \'Criatura — Guerrero kor\', \'flavor\': \'"Blando una espada y llevo una vida sencilla. Muchos aventureros solo me ven como un matón barato, pero si vuelven a casa con sus vidas y extremidades sanas y salvas gracias a mi acero es porque he cumplido mi misión".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492261&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'470459ab-c0fa-4fe8-990a-3f22a5645909\', \'multiverseId\': 492261}, \'multiverseid\': 492261}, {\'name\': "Épée à louer d\'Havrefalaise", \'type\': \'Créature : kor et guerrier\', \'flavor\': "« Je manie l\'épée. C\'est une vie simple. Beaucoup d\'aventuriers me voient comme un mercenaire à deux sous, mais si ma lame les aide à rentrer chez eux vivants et avec tous leurs membres, alors j\'ai accompli mon devoir. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492577&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d1607f7c-fefc-44bf-9533-2124e9a6850b\', \'multiverseId\': 492577}, \'multiverseid\': 492577}, {\'name\': \'Prezzolato di Rifugio Scosceso\', \'type\': \'Creatura — Guerriero Kor\', \'flavor\': \'"Brandisco una spada. È una vita semplice. Molti avventurieri mi considerano solo un ammasso di muscoli a buon prezzo, ma se grazie alla mia lama possono tornare a casa sani e salvi, ho fatto il mio lavoro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492893&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c65859df-21d1-48c0-a0ae-fff6d428e87c\', \'multiverseId\': 492893}, \'multiverseid\': 492893}, {\'name\': \'岸壁安息所の売剣\', \'type\': \'クリーチャー — コー・戦士\', \'flavor\': \'「俺は剣を振るう。いたって単純な生活だ。冒険者どもは俺のことを安上がりの用心棒ぐらいにしか思っちゃいないが、俺の剣で連中を五体満足で生きて家へ帰すことができれば、それで俺は任務完了さ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493209&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2b444b9-1a04-48ed-b1b3-2437809f3a94\', \'multiverseId\': 493209}, \'multiverseid\': 493209}, {\'name\': \'절벽피난처 용병꾼\', \'type\': \'생물 — 코르 전사\', \'flavor\': \'"난 검을 휘둘러. 단순한 삶이지. 많은 모험가들은 날 그냥 싸구려 용병으로 보겠지만, 내 검으로 그들이 사지가 멀쩡하게 집에 돌아올 수 있으면, 난 내 할 일을 한 거야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493525&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9018ff6c-0988-480f-8e69-0ced5df3ec01\', \'multiverseId\': 493525}, \'multiverseid\': 493525}, {\'name\': \'Mercenário do Porto Altivo\', \'type\': \'Criatura — Kor Guerreiro\', \'flavor\': \'"Eu uso uma espada. É uma vida simples. Tem muito aventureiro que me vê como um brutamontes barato, mas se o meu aço fizer eles voltarem pra casa vivos e inteiros, eu já fiz o meu trabalho.".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493841&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7752c540-ca01-4890-99eb-4f9456d41296\', \'multiverseId\': 493841}, \'multiverseid\': 493841}, {\'name\': \'Наемник из Клифхейвена\', \'type\': \'Существо — Кор Воин\', \'flavor\': \'«Я машу мечом. Это простая жизнь. Многие искатели приключений видят во мне просто громилу, которого можно нанять по сходной цене, но если мой клинок помогает им вернуться домой в целости и сохранности, то это значит, что я хорошо сделал свою работу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494157&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eac7250d-7c83-4747-ba7d-b94cee65ef87\', \'multiverseId\': 494157}, \'multiverseid\': 494157}, {\'name\': \'崖屋贷剑客\', \'type\': \'生物 ～寇族／战士\', \'flavor\': \'「我用得一手好剑。生活就是这么简单。虽然许多冒险者只把我当成廉价打手，但只要我手中武器能够保证他们四肢健全平安归家，那我也算完成任务了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494473&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cf0636b2-9763-47b2-9135-b9d95815edf4\', \'multiverseId\': 494473}, \'multiverseid\': 494473}, {\'name\': \'崖屋貸劍客\', \'type\': \'生物 ～寇族／戰士\', \'flavor\': \'「我用得一手好劍。生活就是這麼簡單。雖然許多冒險者只把我當成廉價打手，但只要我手中武器能夠保證他們四肢健全平安歸家，那我也算完成任務了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494789&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fc85fe73-70ef-4776-9aad-033fe1c5759a\', \'multiverseId\': 494789}, \'multiverseid\': 494789}]', '[{\'name\': \'Taborax, Tod der Hoffnung\', \'text\': \'Fliegend\\nTaborax, Tod der Hoffnung, hat Lebensverknüpfung, solange fünf oder mehr +1/+1-Marken auf ihm liegen.\\nImmer wenn eine andere Nichtspielsteinkreatur, die du kontrollierst, stirbt, lege eine +1/+1-Marke auf Taborax. Falls die Kreatur ein Kleriker war, kannst du eine Karte ziehen. Falls du dies tust, verlierst du 1 Lebenspunkt.\', \'type\': \'Legendäre Kreatur — Dämon, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492083&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1af3520e-ff78-45ea-a70c-3cc09154bc25\', \'multiverseId\': 492083}, \'multiverseid\': 492083}, {\'name\': \'Taborax, el Fin de la Esperanza\', \'text\': \'Vuela.\\nTaborax, el Fin de la Esperanza tiene la habilidad de vínculo vital mientras tenga cinco o más contadores +1/+1 sobre él.\\nSiempre que otra criatura que no sea ficha que controlas muera, pon un contador +1/+1 sobre Taborax. Si esa criatura era un Clérigo, puedes robar una carta. Si lo haces, pierdes 1 vida.\', \'type\': \'Criatura legendaria — Clérigo demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2bad42bf-3b39-4435-ba94-6e7c8a0f227e\', \'multiverseId\': 492399}, \'multiverseid\': 492399}, {\'name\': "Taborax, tueur de l\'espoir", \'text\': "Vol\\nTaborax, tueur de l\'espoir a le lien de vie tant qu\'il a au moins cinq marqueurs +1/+1 sur lui.\\nÀ chaque fois qu\'une autre créature non-jeton que vous contrôlez meurt, mettez un marqueur +1/+1 sur Taborax. Si cette créature était un clerc, vous pouvez piocher une carte. Si vous faites ainsi, vous perdez 1 point de vie.", \'type\': \'Créature légendaire : démon et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492715&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'681b71ba-ad0a-4c41-a9bf-500500636465\', \'multiverseId\': 492715}, \'multiverseid\': 492715}, {\'name\': \'Taborax, Morte della Speranza\', \'text\': "Volare\\nTaborax, Morte della Speranza ha legame vitale fintanto che ha cinque o più segnalini +1/+1.\\nOgniqualvolta un\'altra creatura non pedina che controlli muore, metti un segnalino +1/+1 su Taborax. Se quella creatura era un Chierico, puoi pescare una carta. Se lo fai, perdi 1 punto vita.", \'type\': \'Creatura Leggendaria — Chierico Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493031&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0c41248-ab9d-420b-8434-b66119573c7d\', \'multiverseId\': 493031}, \'multiverseid\': 493031}, {\'name\': \'希望の死、タボラックス\', \'text\': \'飛行\\n希望の死、タボラックスの上に＋１/＋１カウンターが５個以上置かれているかぎり、これは絆魂を持つ。\\n他の、あなたがコントロールしていてトークンでないクリーチャーが１体死亡するたび、希望の死、タボラックスの上に＋１/＋１カウンターを１個置く。そのクリーチャーがクレリックであったなら、あなたはカードを１枚引いてもよい。そうしたなら、あなたは１点のライフを失う。\', \'type\': \'伝説のクリーチャー — デーモン・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493347&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e227f8a5-16e7-4a1c-af22-b2a5b735fe97\', \'multiverseId\': 493347}, \'multiverseid\': 493347}, {\'name\': \'희망의 종말, 타보락스\', \'text\': \'비행\\n희망의 종말, 타보락스는 타보락스에 +1/+1 카운터가 다섯 개 이상 있는 한 생명연결을 가진다.\\n당신이 조종하는 토큰이 아닌 다른 생물이 죽을 때마다, 타보락스에 +1/+1 카운터 한 개를 올려놓는다. 그 생물이 성직자였다면, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 당신은 생명 1점을 잃는다.\', \'type\': \'전설적 생물 — 악마 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493663&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'82b1c89c-d750-476e-855b-8bda8b66065d\', \'multiverseId\': 493663}, \'multiverseid\': 493663}, {\'name\': \'Taborax, Fim da Esperança\', \'text\': \'Voar\\nTaborax, Fim da Esperança, terá vínculo com a vida enquanto tiver cinco ou mais marcadores +1/+1.\\nToda vez que outra criatura que você controla que não seja ficha morrer, coloque um marcador +1/+1 em Taborax. Se aquela criatura era um Clérigo, você pode comprar um card. Se fizer isso, você perde 1 ponto de vida.\', \'type\': \'Criatura Lendária — Demônio Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493979&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88392b4c-6121-44c2-a8f3-bbce1b4105c7\', \'multiverseId\': 493979}, \'multiverseid\': 493979}, {\'name\': \'Таборакс, Погибель Надежды\', \'text\': \'Полет\\nТаборакс, Погибель Надежды имеет Цепь жизни, пока на нем есть не менее пяти жетонов +1/+1.\\nКаждый раз, когда другое не являющееся фишкой существо под вашим контролем умирает, положите один жетон +1/+1 на Таборакса. Если то существо было Священником, вы можете взять карту. Если вы это делаете, вы теряете 1 жизнь.\', \'type\': \'Легендарное Существо — Демон Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494295&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eaa0df39-d209-40f6-8e11-953ec488b6ba\', \'multiverseId\': 494295}, \'multiverseid\': 494295}, {\'name\': \'葬望魔塔博锐\', \'text\': \'飞行\\n只要葬望魔塔博锐上有五个或更多+1/+1指示物，它便具有系命异能。\\n每当另一个由你操控且非衍生物的生物死去时，在塔博锐上放置一个+1/+1指示物。若该死去的生物是僧侣，你可以抓一张牌。若你如此作，则你失去1点生命。\', \'type\': \'传奇生物 ～恶魔／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494611&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14251d84-8f46-41cb-9dd6-5d6bda67fddd\', \'multiverseId\': 494611}, \'multiverseid\': 494611}, {\'name\': \'葬望魔塔博銳\', \'text\': \'飛行\\n只要葬望魔塔博銳上有五個或更多+1/+1指示物，它便具有繫命異能。\\n每當另一個由你操控且非衍生物的生物死去時，在塔博銳上放置一個+1/+1指示物。若該死去的生物是僧侶，你可以抽一張牌。若你如此作，則你失去1點生命。\', \'type\': \'傳奇生物 ～惡魔／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494927&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f5c9694a-602d-4cde-a695-f8bb182776d7\', \'multiverseId\': 494927}, \'multiverseid\': 494927}]', '[{\'name\': \'Taborax, Tod der Hoffnung\', \'text\': \'Fliegend\\nTaborax, Tod der Hoffnung, hat Lebensverknüpfung, solange fünf oder mehr +1/+1-Marken auf ihm liegen.\\nImmer wenn eine andere Nichtspielsteinkreatur, die du kontrollierst, stirbt, lege eine +1/+1-Marke auf Taborax. Falls die Kreatur ein Kleriker war, kannst du eine Karte ziehen. Falls du dies tust, verlierst du 1 Lebenspunkt.\', \'type\': \'Legendäre Kreatur — Dämon, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495706&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ceab6754-28dd-4f2a-8c0b-0935a216bed2\', \'multiverseId\': 495706}, \'multiverseid\': 495706}, {\'name\': "Taborax, tueur de l\'espoir", \'text\': "Vol\\nTaborax, tueur de l\'espoir a le lien de vie tant qu\'il a au moins cinq marqueurs +1/+1 sur lui.\\nÀ chaque fois qu\'une autre créature non-jeton que vous contrôlez meurt, mettez un marqueur +1/+1 sur Taborax. Si cette créature était un clerc, vous pouvez piocher une carte. Si vous faites ainsi, vous perdez 1 point de vie.", \'type\': \'Créature légendaire : démon et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495781&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ad55cfa-30cc-4e66-b5f9-9dc44c78dee2\', \'multiverseId\': 495781}, \'multiverseid\': 495781}, {\'name\': \'希望の死、タボラックス\', \'text\': \'飛行\\n希望の死、タボラックスの上に＋１/＋１カウンターが５個以上置かれているかぎり、これは絆魂を持つ。\\n他の、あなたがコントロールしていてトークンでないクリーチャーが１体死亡するたび、希望の死、タボラックスの上に＋１/＋１カウンターを１個置く。そのクリーチャーがクレリックであったなら、あなたはカードを１枚引いてもよい。そうしたなら、あなたは１点のライフを失う。\', \'type\': \'伝説のクリーチャー — デーモン・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495856&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b39d1a7-6825-4df5-bb0e-82b8f10ac357\', \'multiverseId\': 495856}, \'multiverseid\': 495856}]', '[{\'name\': \'Tafelberg-Luchs\', \'text\': \'Solange es nicht dein Zug ist, erhält der Tafelberg-Luchs +0/+2.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Seine Wildheit wird von seiner Geduld gemäßigt, in dem Wissen, dass er für den tödlichen Schlag auf genau den richtigen Moment warten muss.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491968&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d850704-da56-49e5-9d49-e7f9ac07b669\', \'multiverseId\': 491968}, \'multiverseid\': 491968}, {\'name\': \'Lince de la meseta\', \'text\': \'Mientras no sea tu turno, el Lince de la meseta obtiene +0/+2.\', \'type\': \'Criatura — Felino\', \'flavor\': \'Su ferocidad se ve moderada por su paciencia, ya que sabe que debe esperar al momento perfecto para asestar un golpe mortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492284&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'372fe426-4dc7-4136-b363-dabfb847120a\', \'multiverseId\': 492284}, \'multiverseid\': 492284}, {\'name\': \'Lynx de mesa\', \'text\': "Tant que ce n\'est pas votre tour, le Lynx de mesa gagne +0/+2.", \'type\': \'Créature : chat\', \'flavor\': "Sa férocité est adoucie par sa patience. Il sait qu\'il doit attendre le bon moment pour frapper mortellement.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492600&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aa96fe11-5e87-4f88-806a-928aebc74283\', \'multiverseId\': 492600}, \'multiverseid\': 492600}, {\'name\': \'Lince della Mesa\', \'text\': \'Fintanto che non è il tuo turno, la Lince della Mesa prende +0/+2.\', \'type\': \'Creatura — Felino\', \'flavor\': \'La sua ferocia è temperata dalla pazienza, perché sa che deve attendere il momento giusto per sferrare un colpo letale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492916&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3fadb3d4-2e51-4ab2-9122-91cec6ca3ab0\', \'multiverseId\': 492916}, \'multiverseid\': 492916}, {\'name\': \'台地のオオヤマネコ\', \'text\': \'あなたのターンでないかぎり、台地のオオヤマネコは＋０/＋２の修整を受ける。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'獰猛性が忍耐力によって抑制されている。致命的な一撃を与えるためには適切な瞬間を待つべきだと分かっているのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493232&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c7ff96f-3d5d-4356-a62c-d81606863907\', \'multiverseId\': 493232}, \'multiverseid\': 493232}, {\'name\': \'메사 스라소니\', \'text\': \'당신의 턴이 아닌 한, 메사 스라소니는 +0/+2를 받는다.\', \'type\': \'생물 — 고양이\', \'flavor\': \'그것은 살인적인 타격을 입히기 위해 적절한 순간을 기다려야 한다는 것을 알고 인내심으로 흉포함을 누그러뜨린다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493548&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e941c643-ee64-4e5f-acd8-5624301ecac2\', \'multiverseId\': 493548}, \'multiverseid\': 493548}, {\'name\': \'Lince da Meseta\', \'text\': \'Enquanto não for o seu turno, Lince da Meseta receberá +0/+2.\', \'type\': \'Criatura — Felino\', \'flavor\': \'A ferocidade dele é temperada pela paciência, pois sabe que precisa esperar o momento certo para dar um golpe mortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493864&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c971aa51-f68d-4a23-a02e-7e33cd20e730\', \'multiverseId\': 493864}, \'multiverseid\': 493864}, {\'name\': \'Рысь Плоскогорья\', \'text\': \'Пока длится не ваш ход, Рысь Плоскогорья получает +0/+2.\', \'type\': \'Существо — Кошка\', \'flavor\': \'Ее свирепость уравновешивается терпением — она знает, что должна выждать подходящий момент, чтобы нанести смертельный удар.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494180&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5334ab03-d0f0-4b88-8029-89101cc6bbd1\', \'multiverseId\': 494180}, \'multiverseid\': 494180}, {\'name\': \'高地山猫\', \'text\': \'只要不是在你的回合中，高地山猫便得+0/+2。\', \'type\': \'生物 ～猫\', \'flavor\': \'它知道只有在恰当的时机出击才能夺人性命，因此便学会了用耐性来掩盖自己的野性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494496&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c24f88a7-b589-4aa4-926a-7a76b6a94f90\', \'multiverseId\': 494496}, \'multiverseid\': 494496}, {\'name\': \'高地山貓\', \'text\': \'只要不是在你的回合中，高地山貓便得+0/+2。\', \'type\': \'生物 ～貓\', \'flavor\': \'牠知道只有在恰當的時機出擊才能奪人性命，因此便學會了用耐性來掩蓋自己的野性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494812&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'180c6466-8ac4-4e8b-a1ed-23eda6929dd2\', \'multiverseId\': 494812}, \'multiverseid\': 494812}]', '[{\'name\': \'Tajuru-Fäulnisklinge\', \'text\': \'Todesberührung\', \'type\': \'Kreatur — Elf, Räuber\', \'flavor\': \'Ora Ondar, der Khalni-Garten, ist ein üppiges Wirrwarr von Wachstum in den rauen Ländern von Akoum. Seine Pflanzen wachsen wunderbar vielfältig und bilden ein brillantes Spektrum an pulsierendem Leben … und schnellem Tod.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492172&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9cc63110-eb37-4d52-ab8b-797be6fcc1bf\', \'multiverseId\': 492172}, \'multiverseid\': 492172}, {\'name\': \'Hojaponzoña de Tajuru\', \'text\': \'Toque mortal.\', \'type\': \'Criatura — Bribón elfo\', \'flavor\': \'Los jardines de Khalni de Ora Ondar son una exuberante maraña de malezas que se encuentran en las duras tierras de Akoum. La diversidad de sus plantas es soberbia; una gama sin igual de la vida... y de las muertes rápidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492488&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'422bb428-5ef3-4fda-b116-ce6110701cb5\', \'multiverseId\': 492488}, \'multiverseid\': 492488}, {\'name\': \'Pestelame de Tajuru\', \'text\': \'Contact mortel\', \'type\': \'Créature : elfe et gredin\', \'flavor\': "Ora Ondar, le jardin de Khalni, est un enchevêtrement luxuriant situé au milieu des terres rudes d\'Akoum. Les plantes qui y poussent sont merveilleusement variées : c\'est un spectre fascinant de vie... et de mort rapide.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bae7f73b-cf65-44ce-b5ce-071e7ea51336\', \'multiverseId\': 492804}, \'multiverseid\': 492804}, {\'name\': \'Tossilama Tajuru\', \'text\': \'Tocco letale\', \'type\': \'Creatura — Farabutto Elfo\', \'flavor\': \'Ora Ondar, il Giardino di Khalni, è un rigoglioso intreccio di vegetazione nelle aspre terre di Akoum. Le sue piante sono meravigliosamente eterogenee: una splendente varietà di vita fiorente... e morte repentina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493120&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2802404-a88f-48e4-9570-42f641d0421f\', \'multiverseId\': 493120}, \'multiverseid\': 493120}, {\'name\': \'タジュールの荒廃刃\', \'text\': \'接死\', \'type\': \'クリーチャー — エルフ・ならず者\', \'flavor\': \'オラ・オンダール、つまりカルニの庭は、アクームの厳しい土地で絡まり合う繁茂である。その地の植物は驚愕の多様性を見せる。鮮やかな生命の輝かしい混合と、速やかな死が、そこにある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1c813acc-0c71-4290-92ab-5bc0ed573c56\', \'multiverseId\': 493436}, \'multiverseid\': 493436}, {\'name\': \'타주루 역병칼날\', \'text\': \'치명타\', \'type\': \'생물 — 엘프 도적\', \'flavor\': \'칼니 정원인 오라 온다르는 아쿰의 거친 대지 속에서 자라난 것들이 뒤엉켜 있는 곳이다. 그곳의 식물들의 성장 방식은 놀라울 정도로 다양하다. 활기찬 생명이 영롱하게 펼쳐진 것과 동시에 . . . 빠른 죽음도 함께 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493752&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f88d8205-c756-4f61-8978-44f239f177d2\', \'multiverseId\': 493752}, \'multiverseid\': 493752}, {\'name\': \'Venenolâmina Tajuru\', \'text\': \'Toque mortífero\', \'type\': \'Criatura — Elfo Ladino\', \'flavor\': \'Ora Ondar, o Jardim de Khalni, é um emaranhado exuberante nas terras agrestes de Akoum. A flora é maravilhosamente diversa, um brilhante espectro de vida vibrante... e mortes rápidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494068&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9edf316-17de-4d3f-a505-719a8c764f14\', \'multiverseId\': 494068}, \'multiverseid\': 494068}, {\'name\': \'Клинок Погибели из Таджуру\', \'text\': \'Смертельное касание\', \'type\': \'Существо — Эльф Бродяга\', \'flavor\': \'Ора-Ондар, Сад Кални, — это заросли пышной растительности в суровых землях Акума. Флора здесь удивительно разнообразная — полный спектр яркой жизни... и быстрой смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494384&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac7ed68c-a000-4efe-85ae-6648c63db3ac\', \'multiverseId\': 494384}, \'multiverseid\': 494384}, {\'name\': \'特裘如枯刃客\', \'text\': \'死触\', \'type\': \'生物 ～妖精／浪客\', \'flavor\': \'欧拉昂达又称坎尼花园，是阿库姆荒地中一处葱郁丛林。此处植物种类繁多、包罗万象：既有茁壮成长的盎然生机. . .也有能迅速致命的剧烈毒物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494700&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'43cd9651-6da2-490d-a554-51bdb0e897ce\', \'multiverseId\': 494700}, \'multiverseid\': 494700}, {\'name\': \'特裘如枯刃客\', \'text\': \'死觸\', \'type\': \'生物 ～妖精／浪客\', \'flavor\': \'歐拉昂達又稱坎尼花園，是阿庫姆荒地中一處蔥鬱叢林。此處植物種類繁多、包羅萬象：既有茁壯成長的盎然生機. . .也有能迅速致命的劇烈毒物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495016&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'62a64bee-9f2d-4ec5-bbb0-5e441ac0b4a7\', \'multiverseId\': 495016}, \'multiverseid\': 495016}]', '[{\'name\': \'Tajuru-Schlingenwerfer\', \'text\': \'Reichweite\', \'type\': \'Kreatur — Elf, Räuber\', \'flavor\': \'Die Elfen der Tajuru-Nation verbringen ihr Leben in den ausgedehnten Baumkronen der alten Jaddi-Bäume. Einige leben und sterben, ohne jemals den Boden zu betreten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492174&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b849abac-a606-4295-b9ed-a99314501815\', \'multiverseId\': 492174}, \'multiverseid\': 492174}, {\'name\': \'Trampero de Tajuru\', \'text\': \'Alcance.\', \'type\': \'Criatura — Bribón elfo\', \'flavor\': \'Los elfos de la nación de Tajuru pasan sus vidas en las copas de los antiguos árboles jaddis. Hay quienes viven y mueren sin haber llegado a tocar el suelo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492490&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b71a17c1-ccb7-42fe-8ca9-b9b8b9d2460b\', \'multiverseId\': 492490}, \'multiverseid\': 492490}, {\'name\': \'Braconnier de Tajuru\', \'text\': \'Portée\', \'type\': \'Créature : elfe et gredin\', \'flavor\': "Les elfes de la nation Tajuru passent leur vie dans l\'immense canopée des anciens arbres jaddi. Certains y naissent et y meurent sans jamais toucher la terre ferme.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3def9bfc-837b-4500-9b04-2ddfffbd9cd0\', \'multiverseId\': 492806}, \'multiverseid\': 492806}, {\'name\': \'Scagliatrappole Tajuru\', \'text\': \'Raggiungere\', \'type\': \'Creatura — Farabutto Elfo\', \'flavor\': \'Gli elfi della nazione Tajuru passano la loro vita tra le vaste fronde degli antichi alberi jaddi. Alcuni vivono e muoiono senza mai toccare il terreno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493122&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0728e1e1-a394-45c0-b3b2-2b69f170c02a\', \'multiverseId\': 493122}, \'multiverseid\': 493122}, {\'name\': \'タジュールの投網使い\', \'text\': \'到達\', \'type\': \'クリーチャー — エルフ・ならず者\', \'flavor\': \'タジュールの共同体では、エルフは一生を古いジャディ樹の広大な森の上部で過ごす。中には大地に一度も触れることなく一生を終える者もいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493438&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c9ed8d3-7070-43e1-b205-907569024ef9\', \'multiverseId\': 493438}, \'multiverseid\': 493438}, {\'name\': \'타주루 그물사냥꾼\', \'text\': \'대공\', \'type\': \'생물 — 엘프 도적\', \'flavor\': \'타주루 국가의 엘프들은 자디 숲의 넓은 숲 지붕 위에서 그들의 삶을 보내는데, 일부는 죽을 때까지 땅에 발을 한 번도 대지 않고 살기도 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493754&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'01e0d3b8-ba46-4456-aebf-22b2965c838d\', \'multiverseId\': 493754}, \'multiverseid\': 493754}, {\'name\': \'Lançador de Armadilhas Tajuru\', \'text\': \'Alcance\', \'type\': \'Criatura — Elfo Ladino\', \'flavor\': \'Os elfos da nação Tajuru passam a vida no gigantesco dossel das árvores jaddi, com alguns vivendo e morrendo sem jamais tocar o chão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494070&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'be2bee5b-e6ea-453c-a079-62f9488a14d0\', \'multiverseId\': 494070}, \'multiverseid\': 494070}, {\'name\': \'Таджурский Ловец\', \'text\': \'Захват\', \'type\': \'Существо — Эльф Бродяга\', \'flavor\': \'Эльфы народа Таджуру проводят жизнь среди крон древних деревьев джадди, и иные рождаются и умирают, ни разу не ступив на землю.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494386&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ccafbcef-4b44-4675-8504-1de98cca5565\', \'multiverseId\': 494386}, \'multiverseid\': 494386}, {\'name\': \'特裘如布陷手\', \'text\': \'延势\', \'type\': \'生物 ～妖精／浪客\', \'flavor\': \'特裘如一族妖精终生居于古老贾迪巨树广阔林冠之上，有些人一辈子都未曾接触地面。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494702&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0b7abe43-cb0b-430c-ae52-43027af3939f\', \'multiverseId\': 494702}, \'multiverseid\': 494702}, {\'name\': \'特裘如佈陷手\', \'text\': \'延勢\', \'type\': \'生物 ～妖精／浪客\', \'flavor\': \'特裘如一族妖精終生居於古老賈迪巨樹廣闊林冠之上，有些人一輩子都未曾接觸地面。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495018&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c9a4fd6b-cb6c-4a73-95f8-edcabb622189\', \'multiverseId\': 495018}, \'multiverseid\': 495018}]', '[{\'name\': \'Tajuru-Vorbild\', \'text\': \'Das Tajuru-Vorbild ist auch Kleriker, Krieger, Räuber und Zauberer.\\nBonus {3}\\nWenn das Tajuru-Vorbild ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, decke die obersten sechs Karten deiner Bibliothek auf. Du kannst davon eine Karte, die mit ihm einen Kreaturentyp gemeinsam hat, auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Elf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492173&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cda131fb-1022-472a-a5ad-f779d93e3521\', \'multiverseId\': 492173}, \'multiverseid\': 492173}, {\'name\': \'Ejemplar de Tajuru\', \'text\': \'La Ejemplar de Tajuru también es un Clérigo, Bribón, Guerrero y Hechicero.\\nEstímulo {3}.\\nCuando la Ejemplar de Tajuru entre al campo de batalla, si fue estimulada, muestra las seis primeras cartas de tu biblioteca. Puedes poner en tu mano una carta que comparta un tipo de criatura con la Ejemplar de Tajuru que se encuentre entre ellas. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura — Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492489&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1e78010-0438-420d-ac97-888b77321e12\', \'multiverseId\': 492489}, \'multiverseid\': 492489}, {\'name\': \'Parangon de Tajuru\', \'text\': "Le Parangon de Tajuru est aussi un clerc, un gredin, un guerrier et un sorcier.\\nKick {3}\\nQuand le Parangon de Tajuru arrive sur le champ de bataille, s\'il a été kické, révélez les six cartes du dessus de votre bibliothèque. Vous pouvez mettre dans votre main, parmi elles, une carte qui partage un type de créature avec lui. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature : elfe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492805&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1eecc2db-49c0-44e4-8ddb-466c72543da3\', \'multiverseId\': 492805}, \'multiverseid\': 492805}, {\'name\': \'Esemplare Tajuru\', \'text\': "L\'Esemplare Tajuru è anche un Chierico, Farabutto, Guerriero e Mago.\\nPotenziamento {3}\\nQuando l\'Esemplare Tajuru entra nel campo di battaglia, se è stata potenziata, rivela le prime sei carte del tuo grimorio. Puoi aggiungere alla tua mano una carta che condivide un tipo di creatura con l\'Esemplare Tajuru scelta tra esse. Metti le altre in fondo al tuo grimorio in ordine casuale.", \'type\': \'Creatura — Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493121&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'72adc2fe-b4d8-4732-a7a9-32a932c90565\', \'multiverseId\': 493121}, \'multiverseid\': 493121}, {\'name\': \'タジュールの模範\', \'text\': \'タジュールの模範はウィザードとクレリックと戦士とならず者でもある。\\nキッカー{3}\\nタジュールの模範が戦場に出たとき、これがキッカーされていた場合、あなたのライブラリーの一番上からカードを６枚公開する。あなたは、その中からこれと共通のクリーチャー・タイプを持つカード１枚をあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493437&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec4cb254-e3f0-49de-ba82-cf64816b6e70\', \'multiverseId\': 493437}, \'multiverseid\': 493437}, {\'name\': \'타주루 귀감\', \'text\': \'타주루 귀감은 또한 성직자, 도적, 전사, 및 마법사이다.\\n키커 {3}\\n타주루 귀감이 전장에 들어올 때, 타주루 귀감의 키커 비용이 지불되었다면, 당신의 서고 맨 위 카드 여섯 장을 공개한다. 당신은 그중 타주루 귀감과 생물 유형을 공유하는 카드 한 장을 당신의 손에 넣을 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 엘프\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493753&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'58e28b0b-e013-4709-aa5c-1a5791c84dd4\', \'multiverseId\': 493753}, \'multiverseid\': 493753}, {\'name\': \'Paragona Tajuru\', \'text\': \'Paragona Tajuru também é um Clérigo, Ladino, Guerreiro e Mago.\\nReforçar {3}\\nQuando Paragona Tajuru entrar no campo de batalha, se ela tiver sido reforçada, revele os seis cards do topo de seu grimório. Você pode colocar um card que compartilhe um tipo de criatura com ela dentre eles em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura — Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494069&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'12b84570-ae88-47ad-95f0-049dbaf67be8\', \'multiverseId\': 494069}, \'multiverseid\': 494069}, {\'name\': \'Эталон Таджуру\', \'text\': \'Эталон Таджуру также является Бродягой, Воином, Священником и Чародеем.\\nУсилитель {3}\\nКогда Эталон Таджуру выходит на поле битвы, если он получил Усилитель, покажите шесть верхних карт вашей библиотеки. Вы можете положить находящуюся среди них карту, у которой есть такой же тип существа, как у Эталона Таджуру, в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Существо — Эльф\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494385&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e674a46-ef6b-4f03-a3fc-e5a506f6908b\', \'multiverseId\': 494385}, \'multiverseid\': 494385}, {\'name\': \'特裘如典范\', \'text\': \'特裘如典范也是僧侣、浪客、战士和法术师。\\n增幅{3}\\n当特裘如典范进战场时，若它已增幅，则展示你牌库顶的六张牌。你可以将其中一张与之具共通生物类别的牌置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'生物 ～妖精\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494701&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aae1696c-e437-4aac-a315-21629e108986\', \'multiverseId\': 494701}, \'multiverseid\': 494701}, {\'name\': \'特裘如典範\', \'text\': \'特裘如典範也是僧侶、浪客、戰士和魔法師。\\n增幅{3}\\n當特裘如典範進戰場時，若它已增幅，則展示你牌庫頂的六張牌。你可以將其中一張與之具共通生物類別的牌置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'生物 ～妖精\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495017&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7723d51f-072c-4d67-a9dc-85ef29dbafdf\', \'multiverseId\': 495017}, \'multiverseid\': 495017}]', '[{\'name\': \'Tajuru-Vorbild\', \'text\': \'Das Tajuru-Vorbild ist auch Kleriker, Krieger, Räuber und Zauberer.\\nBonus {3}\\nWenn das Tajuru-Vorbild ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, decke die obersten sechs Karten deiner Bibliothek auf. Du kannst davon eine Karte, die mit ihm einen Kreaturentyp gemeinsam hat, auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Elf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495725&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f25d777-2ec3-4e03-94ea-9d5fd210b238\', \'multiverseId\': 495725}, \'multiverseid\': 495725}, {\'name\': \'Parangon de Tajuru\', \'text\': "Le Parangon de Tajuru est aussi un clerc, un gredin, un guerrier et un sorcier.\\nKick {3}\\nQuand le Parangon de Tajuru arrive sur le champ de bataille, s\'il a été kické, révélez les six cartes du dessus de votre bibliothèque. Vous pouvez mettre dans votre main, parmi elles, une carte qui partage un type de créature avec lui. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature : elfe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495800&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b50b05a8-2a56-42f4-8847-f2d5a6929625\', \'multiverseId\': 495800}, \'multiverseid\': 495800}, {\'name\': \'タジュールの模範\', \'text\': \'タジュールの模範はウィザードとクレリックと戦士とならず者でもある。\\nキッカー{3}\\nタジュールの模範が戦場に出たとき、これがキッカーされていた場合、あなたのライブラリーの一番上からカードを６枚公開する。あなたは、その中からこれと共通のクリーチャー・タイプを持つカード１枚をあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495875&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7dab1a2c-e53d-462a-86ed-c90386e5c77a\', \'multiverseId\': 495875}, \'multiverseid\': 495875}]', '[{\'name\': \'Tazeem-Raptor\', \'text\': \'Fliegend\\nWenn der Tazeem-Raptor ins Spiel kommt, kannst du ein Land, das du kontrollierst, auf die Hand seines Besitzers zurückbringen.\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'„Es ist schön, die Adler wieder um den Leuchtturm kreisen zu sehen."\\n—Tazri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491986&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c10c460a-ab5d-4b11-b518-105efbffe79f\', \'multiverseId\': 491986}, \'multiverseid\': 491986}, {\'name\': \'Rapaz de Tazeem\', \'text\': \'Vuela.\\nCuando el Rapaz de Tazeem entre al campo de batalla, puedes regresar una tierra que controlas a la mano de su propietario.\', \'type\': \'Criatura — Ave\', \'flavor\': \'"Me alegro de ver que las águilas vuelven a sobrevolar el Faro".\\n—Tazri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492302&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3d6c18f3-4673-49c6-977a-e0558d30c2c3\', \'multiverseId\': 492302}, \'multiverseid\': 492302}, {\'name\': \'Rapace de Tazeem\', \'text\': \'Vol\\nQuand le Rapace de Tazeem arrive sur le champ de bataille, vous pouvez renvoyer un terrain que vous contrôlez dans la main de son propriétaire.\', \'type\': \'Créature : oiseau\', \'flavor\': "« Qu\'il est bon de revoir les aigles tourner autour du phare. »\\n—Tazri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492618&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9451dd9d-e293-4e8b-83fb-38d78f57bb9f\', \'multiverseId\': 492618}, \'multiverseid\': 492618}, {\'name\': \'Rapace di Tazeem\', \'text\': \'Volare\\nQuando il Rapace di Tazeem entra nel campo di battaglia, puoi far tornare una terra che controlli in mano al suo proprietario.\', \'type\': \'Creatura — Uccello\', \'flavor\': \'"È bello vedere che le aquile sono tornate a sorvolare il Faro."\\n—Tazri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492934&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0cea37f9-9c2f-4b95-b92f-558d3e9d34e1\', \'multiverseId\': 492934}, \'multiverseid\': 492934}, {\'name\': \'タジームの猛禽\', \'text\': \'飛行\\nタジームの猛禽が戦場に出たとき、あなたはあなたがコントロールしている土地１つをオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'「灯台の周りを飛ぶ鷲をまた見られるのはいいものだ。」\\n――タズリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493250&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1b700f3-a292-4972-b806-db25d54f5683\', \'multiverseId\': 493250}, \'multiverseid\': 493250}, {\'name\': \'타짐 독수리\', \'text\': \'비행\\n타짐 독수리가 전장에 들어올 때, 당신은 당신이 조종하는 대지 한 개를 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 조류\', \'flavor\': \'"독수리들이 등대 주위를 돌고 있는 걸 다시 볼 수 있다니 좋군."\\n—타즈리\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493566&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'af5dde5d-9202-48b1-9a0e-e1aa9e5d7171\', \'multiverseId\': 493566}, \'multiverseid\': 493566}, {\'name\': \'Raptor de Tazeem\', \'text\': \'Voar\\nQuando Raptor de Tazeem entra no campo de batalha, você pode devolver um terreno que você controla para a mão de seu dono.\', \'type\': \'Criatura — Ave\', \'flavor\': \'"É bom ver as águias rodeando o Farol de novo."\\n— Tazri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc166eea-3bb8-4e78-b4f3-37e4ebe6612a\', \'multiverseId\': 493882}, \'multiverseid\': 493882}, {\'name\': \'Тазимский Раптор\', \'text\': \'Полет\\nКогда Тазимский Раптор выходит на поле битвы, вы можете вернуть землю под вашим контролем в руку ее владельца.\', \'type\': \'Существо — Птица\', \'flavor\': \'«Какое славное зрелище — орлы вновь кружат у Маяка».\\n— Тазри\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494198&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39b5c573-a7f9-43c1-ab80-a6d4279dd4da\', \'multiverseId\': 494198}, \'multiverseid\': 494198}, {\'name\': \'塔晋猎鸟\', \'text\': \'飞行\\n当塔晋猎鸟进战场时，你可以将一个由你操控的地移回其拥有者手上。\', \'type\': \'生物 ～鸟\', \'flavor\': \'「很高兴看到灯塔上空再有老鹰盘旋。」\\n～塔兹莉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494514&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a287aa8c-009e-4bd6-bbed-126ab78d050e\', \'multiverseId\': 494514}, \'multiverseid\': 494514}, {\'name\': \'塔晉獵鳥\', \'text\': \'飛行\\n當塔晉獵鳥進戰場時，你可以將一個由你操控的地移回其擁有者手上。\', \'type\': \'生物 ～鳥\', \'flavor\': \'「很高興看到燈塔上空再有老鷹盤旋。」\\n～塔茲莉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494830&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d07a3ceb-e28f-4979-b4fc-2cce9dfddc6a\', \'multiverseId\': 494830}, \'multiverseid\': 494830}]', '[{\'name\': \'Tazeem-Turbulenzmagier\', \'text\': \'Bonus {4} (Du kannst zusätzlich {4} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nWenn der Tazeem-Turbulenzmagier ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, bringe eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Die Turbulenz kann gelenkt werden. Sieh her."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492032&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ebf7da4e-da77-4906-a59d-19f7e354ecee\', \'multiverseId\': 492032}, \'multiverseid\': 492032}, {\'name\': \'Mago de la Turbulencia de Tazeem\', \'text\': \'Estímulo {4}. (Puedes pagar {4} adicionales al lanzar este hechizo.)\\nCuando el Mago de la Turbulencia de Tazeem entre al campo de batalla, si fue estimulado, regresa la carta de instantáneo o de conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"Es posible controlar la Turbulencia. Observa".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492348&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15b550d0-b2ec-4b09-b57f-0fc64cfad6b5\', \'multiverseId\': 492348}, \'multiverseid\': 492348}, {\'name\': \'Mage du Roulis de Tazeem\', \'text\': "Kick {4} (Vous pouvez payer {4} supplémentaires au moment où vous lancez ce sort.)\\nQuand le Mage du Roulis de Tazeem arrive sur le champ de bataille, s\'il a été kické, renvoyez une carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': \'« Il est possible de diriger le Roulis. Observez. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492664&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'84a2edfc-e4d5-4fc5-a55d-835ee78df15d\', \'multiverseId\': 492664}, \'multiverseid\': 492664}, {\'name\': \'Mago del Torbido di Tazeem\', \'text\': \'Potenziamento {4} (Puoi pagare {4} addizionale mentre lanci questa magia.)\\nQuando il Mago del Torbido di Tazeem entra nel campo di battaglia, se è stato potenziato, riprendi in mano una carta istantaneo o stregoneria bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Il Torbido può essere guidato. Osserva."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90057b6f-6a1e-4d02-a91f-54a46091c580\', \'multiverseId\': 492980}, \'multiverseid\': 492980}, {\'name\': \'タジームの乱動魔道士\', \'text\': \'キッカー{4}（あなたはこの呪文を唱えるに際し、追加で{4}を支払ってもよい。）\\nタジームの乱動魔道士が戦場に出たとき、これがキッカーされていた場合、あなたの墓地からインスタントかソーサリーであるカード１枚を対象とする。それをあなたの手札に戻す。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'「乱動は操れるのだ。見たまえ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493296&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3c2de68e-b6c0-4365-89d3-5155e0571afd\', \'multiverseId\': 493296}, \'multiverseid\': 493296}, {\'name\': \'타짐 탁류마도사\', \'text\': \'키커 {4} (당신은 이 주문을 발동하면서 추가로 {4}를 지불할 수 있다.)\\n타짐 탁류마도사가 전장에 들어올 때, 타짐 탁류마도사의 키커 비용이 지불되었다면, 당신의 무덤에 있는 순간마법 또는 집중마법 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'"탁류의 방향을 정해 줄 수 있어. 잘 보라고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493612&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ede59e31-1563-4e90-987b-83ff5924f506\', \'multiverseId\': 493612}, \'multiverseid\': 493612}, {\'name\': \'Mago do Turbilhão de Tazeem\', \'text\': \'Reforçar {4} (Você pode pagar um custo adicional de {4} ao conjurar esta mágica.)\\nQuando Mago do Turbilhão de Tazeem entrar no campo de batalha, se ele tiver sido reforçado, devolva o card de mágica instantânea ou feitiço alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"O Turbilhão pode ser canalizado. Observe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb28682c-1850-4d21-9090-b2e7edd05af2\', \'multiverseId\': 493928}, \'multiverseid\': 493928}, {\'name\': \'Тазимский Маг Великого Вала\', \'text\': \'Усилитель {4} (При разыгрывании этого заклинания вы можете дополнительно заплатить {4}.)\\nКогда Тазимский Маг Великого Вала выходит на поле битвы, если он получил Усилитель, верните целевую карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Великий Вал можно направлять. Смотри».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494244&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2ca93a46-bf66-4a37-b2a1-1019185cebac\', \'multiverseId\': 494244}, \'multiverseid\': 494244}, {\'name\': \'塔晋狂搅法师\', \'text\': \'增幅{4}（你施放此咒语时可以额外支付{4}。）\\n当塔晋狂搅法师进战场时，若它已增幅，则将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'「狂搅也能被引导。看好了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494560&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2b203639-1d78-4c70-8fe8-bf284a5e64cc\', \'multiverseId\': 494560}, \'multiverseid\': 494560}, {\'name\': \'塔晉狂攪法師\', \'text\': \'增幅{4}（你施放此咒語時可以額外支付{4}。）\\n當塔晉狂攪法師進戰場時，若它已增幅，則將目標瞬間或巫術牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'「狂攪也能被引導。看好了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494876&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6fa05dbb-f7ba-478c-8e35-d84df7063935\', \'multiverseId\': 494876}, \'multiverseid\': 494876}]', '[{\'name\': \'Tazri, Leuchtfeuer der Einheit\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger.\\n{2/U}{2/B}{2/R}{2/G}: Schaue dir die obersten sechs Karten deiner Bibliothek an. Du kannst davon bis zu zwei Kleriker-, Krieger-, Räuber-, Zauberer- und/oder Verbündeter-Karten offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491987&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86ba8111-ac0b-4ce7-86e0-d170510d1cfe\', \'multiverseId\': 491987}, \'multiverseid\': 491987}, {\'name\': \'Tazri, símbolo de la unidad\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura en tu grupo.\\n{2/U}{2/B}{2/R}{2/G}: Mira las seis primeras cartas de tu biblioteca. Puedes mostrar hasta dos cartas de Clérigo, Bribón, Guerrero, Hechicero y/o Aliado que se encuentren entre ellas y ponerlas en tu mano. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492303&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3dc0deac-017f-4c53-bcb6-252d917d48f6\', \'multiverseId\': 492303}, \'multiverseid\': 492303}, {\'name\': "Tazri, flambeau de l\'unité", \'text\': "Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe.\\n{2/U}{2/B}{2/R}{2/G} : Regardez les six cartes du dessus de votre bibliothèque. Vous pouvez révéler jusqu\'à deux cartes de clerc, de gredin, de guerrier, de sorcier et/ou d\'allié parmi elles et les mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492619&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'648cf2fe-25c8-419c-bd7b-f0a3df75d9ac\', \'multiverseId\': 492619}, \'multiverseid\': 492619}, {\'name\': \'Tazri, Esempio di Unità\', \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura nella tua compagnia.\\n{2/U}{2/B}{2/R}{2/G}: Guarda le prime sei carte del tuo grimorio. Puoi rivelare fino a due carte Chierico, Farabutto, Guerriero, Mago e/o Alleato scelte tra esse e aggiungerle alla tua mano. Metti le altre in fondo al tuo grimorio in ordine casuale.\', \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a018ae93-f947-429c-a58a-e70852b01131\', \'multiverseId\': 492935}, \'multiverseid\': 492935}, {\'name\': \'団結の標、タズリ\', \'text\': \'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。\\n{2/U}{2/B}{2/R}{2/G}：あなたのライブラリーの一番上からカードを６枚見る。あなたは「その中からウィザードやクレリックや戦士やならず者や同盟者であるカード最大２枚を公開し、あなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493251&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f18cc79-eaae-4547-a6c9-3a458300298f\', \'multiverseId\': 493251}, \'multiverseid\': 493251}, {\'name\': \'연합의 봉화, 타즈리\', \'text\': \'이 주문은 당신의 파티에 있는 각 생물마다 발동하는 데 {1}이 덜 든다.\\n{2/U}{2/B}{2/R}{2/G}: 당신의 서고 맨 위 카드 여섯 장을 본다. 당신은 그중에서 성직자, 도적, 전사, 마법사, 및/또는 동맹 카드를 최대 두 장까지 공개하고 그 카드들을 당신의 손으로 가져갈 수 있다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'전설적 생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493567&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'be28603a-04dd-4e51-bb55-853cf42b70d5\', \'multiverseId\': 493567}, \'multiverseid\': 493567}, {\'name\': \'Tazri, Farol da Unidade\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada para cada criatura em seu grupo.\\n{2/U}{2/B}{2/R}{2/G}: Olhe os seis cards do topo de seu grimório. Você pode revelar até dois cards de Clérigo, Ladino, Guerreiro, Mago e/ou Aliado dentre eles e colocá-los em sua mão. Coloque o restante no fundo de seu grimório em ordem aleatória.\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493883&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cbf3e9f6-873c-4843-91f1-f932abdf826e\', \'multiverseId\': 493883}, \'multiverseid\': 493883}, {\'name\': \'Тазри, Светоч Единства\', \'text\': \'Разыгрывание этого заклинания стоит на {1} меньше за каждое существо в вашем отряде.\\n{2/U}{2/B}{2/R}{2/G}: посмотрите шесть верхних карт вашей библиотеки. Вы можете показать не более двух находящихся среди них карт Бродяг, Воинов, Священников, Чародеев и/или Союзников и положить их в вашу руку. Положите остальные карты в низ вашей библиотеки в случайном порядке.\', \'type\': \'Легендарное Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494199&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0aeb0226-7f30-4510-9b5f-c4e060dbadf6\', \'multiverseId\': 494199}, \'multiverseid\': 494199}, {\'name\': \'齐心榜样塔兹莉\', \'text\': \'你冒险团中每有一个生物，此咒语便减少{1}来施放。\\n{2/U}{2/B}{2/R}{2/G}：检视你牌库顶的六张牌。你可以展示其中的至多两张僧侣、浪客、战士、法术师和／或伙伴牌，并将它们置于你手上。将其余的牌以随机顺序置于你的牌库底。\', \'type\': \'传奇生物 ～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494515&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'148eaf4c-e3b1-4759-9082-e88a06e7d969\', \'multiverseId\': 494515}, \'multiverseid\': 494515}, {\'name\': \'齊心榜樣塔茲莉\', \'text\': \'你冒險團中每有一個生物，此咒語便減少{1}來施放。\\n{2/U}{2/B}{2/R}{2/G}：檢視你牌庫頂的六張牌。你可以展示其中的至多兩張僧侶、浪客、戰士、魔法師和／或伙伴牌，並將它們置於你手上。將其餘的牌以隨機順序置於你的牌庫底。\', \'type\': \'傳奇生物 ～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494831&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a3a8e078-8744-4f98-ae27-4cafd0fe301c\', \'multiverseId\': 494831}, \'multiverseid\': 494831}]', '[{\'name\': \'Tazri, Leuchtfeuer der Einheit\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger.\\n{2/U}{2/B}{2/R}{2/G}: Schaue dir die obersten sechs Karten deiner Bibliothek an. Du kannst davon bis zu zwei Kleriker-, Krieger-, Räuber-, Zauberer- und/oder Verbündeter-Karten offen vorzeigen und auf deine Hand nehmen. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495680&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f45a17d-2f9e-4a31-adf8-76e6520060de\', \'multiverseId\': 495680}, \'multiverseid\': 495680}, {\'name\': "Tazri, flambeau de l\'unité", \'text\': "Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe.\\n{2/U}{2/B}{2/R}{2/G} : Regardez les six cartes du dessus de votre bibliothèque. Vous pouvez révéler jusqu\'à deux cartes de clerc, de gredin, de guerrier, de sorcier et/ou d\'allié parmi elles et les mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495755&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d90aed5-bb85-431e-b849-75966f33f49d\', \'multiverseId\': 495755}, \'multiverseid\': 495755}, {\'name\': \'団結の標、タズリ\', \'text\': \'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。\\n{2/U}{2/B}{2/R}{2/G}：あなたのライブラリーの一番上からカードを６枚見る。あなたは「その中からウィザードやクレリックや戦士やならず者や同盟者であるカード最大２枚を公開し、あなたの手札に加える。」を選んでもよい。残りをあなたのライブラリーの一番下に無作為の順番で置く。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495830&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e8141ec7-4cb3-41a2-a0d3-a55e66c4bd72\', \'multiverseId\': 495830}, \'multiverseid\': 495830}]', '[{\'name\': \'Thron von Makindi\', \'text\': \'{T}: Erzeuge {C}.\\n{1}, {T}: Lege eine Ladungsmarke auf den Thron von Makindi.\\n{T}, entferne eine Ladungsmarke vom Thron von Makindi: Erzeuge zwei Mana genau einer beliebigen Farbe. Verwende dieses Mana nur, um Zaubersprüche zu wirken, deren Bonuskosten du bezahlst.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492238&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'77b7377e-5aaf-4467-864f-b66b5e18e414\', \'multiverseId\': 492238}, \'multiverseid\': 492238}, {\'name\': \'Trono de Makindi\', \'text\': \'{T}: Agrega {C}.\\n{1}, {T}: Pon un contador de carga sobre el Trono de Makindi.\\n{T}, remover un contador de carga del Trono de Makindi: Agrega dos manás de un color cualquiera. Usa este maná solo para lanzar hechizos estimulados.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492554&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a7bdb0d-cd97-492c-acf1-4100a6e45314\', \'multiverseId\': 492554}, \'multiverseid\': 492554}, {\'name\': \'Trône des Makindi\', \'text\': "{T} : Ajoutez {C}.\\n{1}, {T} : Mettez un marqueur « charge » sur le Trône des Makindi.\\n{T}, retirez un marqueur « charge » du Trône des Makindi : Ajoutez deux manas d\'une seule couleur de votre choix. Ne dépensez ce mana que pour lancer des sorts kickés.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492870&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c117a8d3-4f9a-459a-9869-66cf462a970c\', \'multiverseId\': 492870}, \'multiverseid\': 492870}, {\'name\': \'Trono di Makindi\', \'text\': \'{T}: Aggiungi {C}.\\n{1}, {T}: Metti un segnalino carica sul Trono di Makindi.\\n{T}, Rimuovi un segnalino carica dal Trono di Makindi: Aggiungi due mana di un qualsiasi colore. Spendi questo mana solo per lanciare magie potenziate.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493186&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bbc24497-116e-4fce-ac46-d1931586ab60\', \'multiverseId\': 493186}, \'multiverseid\': 493186}, {\'name\': \'マキンディの玉座\', \'text\': \'{T}：{C}を加える。\\n{1}, {T}：マキンディの玉座の上に蓄積カウンターを１個置く。\\n{T}, マキンディの玉座の上から蓄積カウンターを１個取り除く：好きな色１色のマナ２点を加える。このマナは、キッカーされている呪文を唱えるためにのみ使用できる。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493502&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'46ed1577-4b30-4a19-b273-fdcc80534ee8\', \'multiverseId\': 493502}, \'multiverseid\': 493502}, {\'name\': \'마킨디 왕좌\', \'text\': \'{T}: {C}를 추가한다.\\n{1}, {T}: 마킨디 왕좌에 충전 카운터 한 개를 올려놓는다.\\n{T}, 마킨디 왕좌에서 충전 카운터 한 개를 제거한다: 원하는 한 가지 색 마나 두 개를 추가한다. 이 마나는 키커 비용이 지불된 주문을 발동하는 데에만 사용할 수 있다.\', \'type\': \'대지\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493818&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b189a524-8117-4719-9985-8ce64c09eeab\', \'multiverseId\': 493818}, \'multiverseid\': 493818}, {\'name\': \'Trono de Makindi\', \'text\': \'{T}: Adicione {C}.\\n{1}, {T}: Coloque um marcador de carga em Trono de Makindi.\\n{T}, remova um marcador de carga de Trono de Makindi: Adicione dois manas de qualquer cor. Gaste este mana somente para conjurar mágicas reforçadas.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494134&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cb307e3c-152c-4e0b-a921-b20712291778\', \'multiverseId\': 494134}, \'multiverseid\': 494134}, {\'name\': \'Трон Макинди\', \'text\': \'{T}: добавьте {C}.\\n{1}, {T}: положите один жетон заряда на Трон Макинди.\\n{T}, удалите один жетон заряда с Трона Макинди: добавьте две маны любого одного цвета. Тратьте эту ману только на разыгрывание заклинаний, получивших Усилитель.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494450&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0bf7daa-391e-4c25-ad2e-4bf79aa85cfb\', \'multiverseId\': 494450}, \'multiverseid\': 494450}, {\'name\': \'马钦迪王座\', \'text\': \'{T}：加{C}。\\n{1}，{T}：在马钦迪王座上放置一个充电指示物。\\n{T}，从马钦迪王座上移去一个充电指示物：加两点任意颜色的单色法术力。此法术力只能用来施放已增幅的咒语。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494766&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5f3fb57b-7b7d-44ff-8b85-09f1af441d20\', \'multiverseId\': 494766}, \'multiverseid\': 494766}, {\'name\': \'馬欽迪王座\', \'text\': \'{T}：加{C}。\\n{1}，{T}：在馬欽迪王座上放置一個充電指示物。\\n{T}，從馬欽迪王座上移去一個充電指示物：加兩點任意顏色的單色魔法力。此魔法力只能用來施放已增幅的咒語。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495082&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eb264296-8fd3-40d3-b8bd-183ce00f3c8e\', \'multiverseId\': 495082}, \'multiverseid\': 495082}]', '[{\'name\': \'Thron von Makindi\', \'text\': \'{T}: Erzeuge {C}.\\n{1}, {T}: Lege eine Ladungsmarke auf den Thron von Makindi.\\n{T}, entferne eine Ladungsmarke vom Thron von Makindi: Erzeuge zwei Mana genau einer beliebigen Farbe. Verwende dieses Mana nur, um Zaubersprüche zu wirken, deren Bonuskosten du bezahlst.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495742&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0732d61-be96-4b06-a9cc-dc7364611fd9\', \'multiverseId\': 495742}, \'multiverseid\': 495742}, {\'name\': \'Trône des Makindi\', \'text\': "{T} : Ajoutez {C}.\\n{1}, {T} : Mettez un marqueur « charge » sur le Trône des Makindi.\\n{T}, retirez un marqueur « charge » du Trône des Makindi : Ajoutez deux manas d\'une seule couleur de votre choix. Ne dépensez ce mana que pour lancer des sorts kickés.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495817&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d246b79d-d9f2-4582-8a07-0c497fe456c9\', \'multiverseId\': 495817}, \'multiverseid\': 495817}, {\'name\': \'マキンディの玉座\', \'text\': \'{T}：{C}を加える。\\n{1}, {T}：マキンディの玉座の上に蓄積カウンターを１個置く。\\n{T}, マキンディの玉座の上から蓄積カウンターを１個取り除く：好きな色１色のマナ２点を加える。このマナは、キッカーされている呪文を唱えるためにのみ使用できる。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495892&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8cafbc96-d6ea-4a9c-a30b-4c9c14e0c672\', \'multiverseId\': 495892}, \'multiverseid\': 495892}]', '[{\'name\': \'Tollwütiger Biss\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, fügt einer Kreatur deiner Wahl, die du nicht kontrollierst, Schadenspunkte in Höhe ihrer Stärke zu.\', \'type\': \'Hexerei\', \'flavor\': \'Ein gesunder Felidar ist unersättlich und doch nobel. Ein tollwütiger Felidar ist nichts weiter als Appetit mit schäumenden Kiefern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492163&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'836f620c-dd2d-4383-89ec-1caac4b451e8\', \'multiverseId\': 492163}, \'multiverseid\': 492163}, {\'name\': \'Mordisco rabioso\', \'text\': \'La criatura objetivo que controlas hace una cantidad de daño igual a su fuerza a la criatura objetivo que no controlas.\', \'type\': \'Conjuro\', \'flavor\': \'Un felidar sano es voraz pero majestuoso. Un felidar rabioso no es más que apetito con mandíbulas salivosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492479&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc7a5c40-106a-49f6-9c59-73abacc0cd3b\', \'multiverseId\': 492479}, \'multiverseid\': 492479}, {\'name\': \'Morsure enragée\', \'text\': \'Une créature ciblée que vous contrôlez inflige un nombre de blessures égal à sa force à une créature ciblée que vous ne contrôlez pas.\', \'type\': \'Rituel\', \'flavor\': "Un félidar en bonne santé est à la fois féroce et majestueux. Un félidar enragé n\'est rien d\'autre qu\'un appétit sur pattes à la mâchoire baveuse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492795&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4868a20d-64dd-4499-8dd3-a21e0499a6b9\', \'multiverseId\': 492795}, \'multiverseid\': 492795}, {\'name\': \'Morso Rabbioso\', \'text\': \'Una creatura bersaglio che controlli infligge danno pari alla sua forza a una creatura bersaglio che non controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'Un felidar sano è vorace ma regale. Un felidar rabbioso non è altro che fame legata a fauci schiumanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493111&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3e7742d5-c542-4476-87b2-ed9d180776dd\', \'multiverseId\': 493111}, \'multiverseid\': 493111}, {\'name\': \'狂気の一咬み\', \'text\': \'あなたがコントロールしているクリーチャー１体と、あなたがコントロールしていないクリーチャー１体を対象とする。その前者はその後者に、自身のパワーに等しい点数のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'健康なフェリダーは食欲旺盛だが威厳を備えている。狂気のフェリダーは口が唾液でいっぱいの食欲以外の何物でもない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493427&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'50362285-396e-4228-9bef-f4d65cb06dd4\', \'multiverseId\': 493427}, \'multiverseid\': 493427}, {\'name\': \'맹렬한 물어뜯기\', \'text\': \'당신이 조종하는 생물과 당신이 조종하지 않는 생물을 각각 목표로 정한다. 첫 번째 목표는 두 번째 목표에게 자신의 공격력만큼 피해를 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'건강한 펠리다르는 식욕이 왕성하지만 한편으로는 근엄하다. 미친 펠리다르는 거품을 문 입에서 흘러내리는 식욕 밖에 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493743&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ceec37ce-9751-446e-850a-bb6f806c2058\', \'multiverseId\': 493743}, \'multiverseid\': 493743}, {\'name\': \'Mordida Rábica\', \'text\': \'A criatura alvo que você controla causa dano igual ao seu poder à criatura alvo que você não controla.\', \'type\': \'Feitiço\', \'flavor\': \'Um felidar saudável é voraz, mas régio. Um felidar raivoso nada mais é que um apetite atrelado a uma boca espumante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494059&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'25c883e1-de80-464b-be77-567c58c02f04\', \'multiverseId\': 494059}, \'multiverseid\': 494059}, {\'name\': \'Бешеный Укус\', \'text\': \'Целевое существо под вашим контролем наносит повреждения, равные своей силе, целевому существу не под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'Здоровый фелидар прожорлив, но сохраняет царственный облик. Бешеный фелидар — это просто голод и челюсти, истекающие слюной.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494375&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'67d118f9-c50b-4687-a81b-7c1189d295c9\', \'multiverseId\': 494375}, \'multiverseid\': 494375}, {\'name\': \'狂疾啃咬\', \'text\': \'目标由你操控的生物对目标不由你操控的生物造成伤害，其数量等同于前者的力量。\', \'type\': \'法术\', \'flavor\': \'健康的晶角兽虽也会大口吞咽，但仍不失威严气质。染疾的晶角兽就只晓得张开血盆大口，屈从于无魇食欲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494691&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5e53a06a-12de-47d9-889c-84482ac06539\', \'multiverseId\': 494691}, \'multiverseid\': 494691}, {\'name\': \'狂疾啃咬\', \'text\': \'目標由你操控的生物對目標不由你操控的生物造成傷害，其數量等同於前者的力量。\', \'type\': \'巫術\', \'flavor\': \'健康的晶角獸雖也會大口吞嚥，但仍不失威嚴氣質。染疾的晶角獸就只曉得張開血盆大口，屈從於無魘食慾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495007&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'742172d3-c4a7-4db7-8e77-476c9df5f73c\', \'multiverseId\': 495007}, \'multiverseid\': 495007}]', '[{\'name\': \'Trittsicherer Infiltrator\', \'text\': \'Tappe einen anderen ungetappten Räuber, den du kontrollierst: Der Trittsichere Infiltrator kann in diesem Zug nicht geblockt werden.\\nImmer wenn der Trittsichere Infiltrator einem Spieler Kampfschaden zufügt, ziehe eine Karte.\', \'type\': \'Kreatur — Meervolk, Räuber\', \'flavor\': \'„Die Ruine, in die ich nicht hineinkomme, muss ich erst noch entdecken."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492031&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ba70dbe7-463e-4a81-b5e3-6e7474070d4b\', \'multiverseId\': 492031}, \'multiverseid\': 492031}, {\'name\': \'Infiltrador confiado\', \'text\': \'Girar otro Bribón enderezado que controlas: El Infiltrador confiado no puede ser bloqueado este turno.\\nSiempre que el Infiltrador confiado haga daño de combate a un jugador, roba una carta.\', \'type\': \'Criatura — Bribón tritón\', \'flavor\': \'"Todavía no he hallado unas ruinas en las que no pueda entrar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492347&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'333dd5ea-e0e7-4cc5-a2e1-737f006fbf9b\', \'multiverseId\': 492347}, \'multiverseid\': 492347}, {\'name\': \'Infiltrateur agile\', \'text\': "Engagez un autre gredin dégagé que vous contrôlez : L\'Infiltrateur agile ne peut pas être bloqué ce tour-ci.\\nÀ chaque fois que l\'Infiltrateur agile inflige des blessures de combat à un joueur, piochez une carte.", \'type\': \'Créature : ondin et gredin\', \'flavor\': "« Je n\'ai encore jamais trouvé de ruine capable de m\'empêcher d\'entrer. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492663&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7d7a5c0-db90-4a1a-b063-1449409a5072\', \'multiverseId\': 492663}, \'multiverseid\': 492663}, {\'name\': \'Infiltrato dal Passo Sicuro\', \'text\': "TAPpa un altro Farabutto STAPpato che controlli: L\'Infiltrato dal Passo Sicuro non può essere bloccato in questo turno.\\nOgniqualvolta l\'Infiltrato dal Passo Sicuro infligge danno da combattimento a un giocatore, pesca una carta.", \'type\': \'Creatura — Farabutto Tritone\', \'flavor\': \'"Devo ancora scoprire la rovina in grado di tenermi fuori."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492979&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0355437d-4283-40ed-834d-69d6274a1e86\', \'multiverseId\': 492979}, \'multiverseid\': 492979}, {\'name\': \'確実な潜入者\', \'text\': \'他の、あなたがコントロールしていてアンタップ状態のならず者１体をタップする：このターン、確実な潜入者はブロックされない。\\n確実な潜入者がプレイヤー１人に戦闘ダメージを与えるたび、カードを１枚引く。\', \'type\': \'クリーチャー — マーフォーク・ならず者\', \'flavor\': \'「私が入ることのできない遺跡にはまだ出会ったことがない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493295&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6ecc9fa-aa8d-4e88-bab3-3855feb976da\', \'multiverseId\': 493295}, \'multiverseid\': 493295}, {\'name\': \'실수하지 않는 잠입자\', \'text\': \'당신이 조종하는 다른 언탭된 도적을 탭한다: 실수하지 않는 잠입자는 이번 턴에 방어될 수 없다.\\n실수하지 않는 잠입자가 플레이어에게 전투피해를 입힐 때마다, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인어 도적\', \'flavor\': \'"내가 들어갈 수 없었던 폐허는 아직 만나본 적이 없어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493611&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9715636d-bc03-4745-92cb-dd74d4972a55\', \'multiverseId\': 493611}, \'multiverseid\': 493611}, {\'name\': \'Infiltrador Passofirme\', \'text\': \'Vire outro Ladino desvirado que você controla: Infiltrador Passofirme não pode ser bloqueado neste turno.\\nToda vez que Infiltrador Passofirme causar dano de combate a um jogador, compre um card.\', \'type\': \'Criatura — Tritão Ladino\', \'flavor\': \'"Ainda não descobri a ruína capaz de me impedir de entrar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493927&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ab6601b-c0bf-4a27-8af2-6c173b57bfa9\', \'multiverseId\': 493927}, \'multiverseid\': 493927}, {\'name\': \'Крепконогий Лазутчик\', \'text\': \'Поверните другого неповернутого Бродягу под вашим контролем: Крепконогий Лазутчик не может быть заблокирован в этом ходу.\\nКаждый раз, когда Крепконогий Лазутчик наносит боевые повреждения игроку, возьмите карту.\', \'type\': \'Существо — Мерфолк Бродяга\', \'flavor\': \'«Мне еще не удалось найти такие руины, куда я не смог бы пробраться».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494243&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'70079bb3-d955-4e50-8ba1-188bf2d720b5\', \'multiverseId\': 494243}, \'multiverseid\': 494243}, {\'name\': \'稳步渗透客\', \'text\': \'横置另一个由你操控且未横置的浪客：稳步渗透客本回合不能被阻挡。\\n每当稳步渗透客对任一牌手造成战斗伤害时，抓一张牌。\', \'type\': \'生物 ～人鱼／浪客\', \'flavor\': \'「这世上还没见过我进不去的遗迹。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494559&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e1e483c-1a4e-4f07-8d9c-fd9fd5f2c85a\', \'multiverseId\': 494559}, \'multiverseid\': 494559}, {\'name\': \'穩步滲透客\', \'text\': \'橫置另一個由你操控且未橫置的浪客：穩步滲透客本回合不能被阻擋。\\n每當穩步滲透客對任一玩家造成戰鬥傷害時，抽一張牌。\', \'type\': \'生物 ～人魚／浪客\', \'flavor\': \'「這世上還沒見過我進不去的遺跡。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494875&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'81e94ca8-7c39-42a4-bc46-c117291f0b4e\', \'multiverseId\': 494875}, \'multiverseid\': 494875}]', '[{\'name\': \'Truppenkommandeur\', \'text\': \'Wenn der Truppenkommandeur ins Spiel kommt, erzeuge für jede Kreatur in deiner Abenteurergruppe einen 1/1 weißen Kor-Krieger-Kreaturenspielstein. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\\nZu Beginn des Kampfes in deinem Zug und falls du eine vollständige Abenteurergruppe hast, erhalten Kreaturen, die du kontrollierst, +1/+0 und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kor, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491984&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ebee2d64-59fe-4517-b74c-4817c4aec28d\', \'multiverseId\': 491984}, \'multiverseid\': 491984}, {\'name\': \'Comandante de la brigada\', \'text\': \'Cuando el Comandante de la brigada entre al campo de batalla, crea una ficha de criatura Guerrero Kor blanca 1/1 por cada criatura en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\\nAl comienzo del combate en tu turno, si tienes un grupo completo, las criaturas que controlas obtienen +1/+0 y ganan la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura — Guerrero kor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492300&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd4955d5-d5e1-41e3-a56d-448bc9cd3371\', \'multiverseId\': 492300}, \'multiverseid\': 492300}, {\'name\': "Commandant d\'escouade", \'text\': "Quand le Commandant d\'escouade arrive sur le champ de bataille, créez un jeton de créature 1/1 blanche Kor et Guerrier pour chaque créature dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)\\nAu début du combat pendant votre tour, si vous avez un groupe complet, les créatures que vous contrôlez gagnent +1/+0 et acquièrent l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature : kor et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74c42979-8b15-4476-8855-6cf384693111\', \'multiverseId\': 492616}, \'multiverseid\': 492616}, {\'name\': \'Comandante della Squadra\', \'text\': "Quando il Comandante della Squadra entra nel campo di battaglia, crea una pedina creatura Guerriero Kor 1/1 bianca per ogni creatura nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\\nAll\'inizio del combattimento nel tuo turno, se hai una compagnia completa, le creature che controlli prendono +1/+0 e hanno indistruttibile fino alla fine del turno.", \'type\': \'Creatura — Guerriero Kor\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492932&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9a260b6c-41f4-47fd-b5d3-68f4ba432547\', \'multiverseId\': 492932}, \'multiverseid\': 492932}, {\'name\': \'兵団の統率者\', \'text\': \'兵団の統率者が戦場に出たとき、あなたのパーティーを構成しているクリーチャー１体につき白の１/１のコー・戦士・クリーチャー・トークンを１体生成する。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\\nあなたのターンの戦闘の開始時に、あなたのパーティーが全員そろっている場合、ターン終了時まで、あなたがコントロールしているクリーチャーは＋１/＋０の修整を受け破壊不能を得る。\', \'type\': \'クリーチャー — コー・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493248&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e006c5e1-c9e0-4293-bad9-45547423e2c0\', \'multiverseId\': 493248}, \'multiverseid\': 493248}, {\'name\': \'부대 지휘관\', \'text\': \'부대 지휘관이 전장에 들어올 때, 당신의 파티에 있는 각 생물마다 1/1 백색 코르 전사 생물 토큰 한 개를 만든다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\\n당신의 턴 전투 시작에, 당신에게 완전한 파티가 있다면, 당신이 조종하는 생물들은 턴종료까지 +1/+0을 받고 무적을 얻는다.\', \'type\': \'생물 — 코르 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493564&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2a57a563-95fd-4296-8a93-4cc7f0041deb\', \'multiverseId\': 493564}, \'multiverseid\': 493564}, {\'name\': \'Comandante de Esquadrão\', \'text\': \'Quando Comandante de Esquadrão entrar no campo de batalha, crie uma ficha de criatura branca 1/1 do tipo Kor Guerreiro para cada criatura em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\\nNo início do combate no seu turno, se você tiver um grupo completo, as criaturas que você controla recebem +1/+0 e ganham indestrutível até o final do turno.\', \'type\': \'Criatura — Kor Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493880&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'60574c4e-e0aa-4f78-ba99-8dd617e812fb\', \'multiverseId\': 493880}, \'multiverseid\': 493880}, {\'name\': \'Командир Отряда\', \'text\': \'Когда Командир Отряда выходит на поле битвы, создайте одну фишку существа 1/1 белый Кор Воин за каждое существо в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\\nВ начале боя во время вашего хода, если у вас есть полный отряд, то существа под вашим контролем получают +1/+0 и Неразрушимость до конца хода.\', \'type\': \'Существо — Кор Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494196&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a59b455-7350-49f5-adf5-c8d90b2932b9\', \'multiverseId\': 494196}, \'multiverseid\': 494196}, {\'name\': \'小队指挥官\', \'text\': \'当小队指挥官进战场时，你冒险团中每有一个生物，便派出一个1/1白色寇族／战士衍生生物。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\\n在你回合的战斗开始时，若你的冒险团满编，则直到回合结束，由你操控的生物得+1/+0且获得不灭异能。\', \'type\': \'生物 ～寇族／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494512&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b231706-92a8-4d62-9566-460c6340c435\', \'multiverseId\': 494512}, \'multiverseid\': 494512}, {\'name\': \'小隊指揮官\', \'text\': \'當小隊指揮官進戰場時，你冒險團中每有一個生物，便派出一個1/1白色寇族／戰士衍生生物。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\\n在你回合的戰鬥開始時，若你的冒險團滿編，則直到回合結束，由你操控的生物得+1/+0且獲得不滅異能。\', \'type\': \'生物 ～寇族／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494828&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7300f4f7-ea05-4722-9552-9f899d1354cb\', \'multiverseId\': 494828}, \'multiverseid\': 494828}]', '[{\'name\': \'Truppenkommandeur\', \'text\': \'Wenn der Truppenkommandeur ins Spiel kommt, erzeuge für jede Kreatur in deiner Abenteurergruppe einen 1/1 weißen Kor-Krieger-Kreaturenspielstein.\\nZu Beginn des Kampfes in deinem Zug und falls du eine vollständige Abenteurergruppe hast, erhalten Kreaturen, die du kontrollierst, +1/+0 und Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kor, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d23eeb00-469e-48cd-906b-9a3946ff201a\', \'multiverseId\': 495679}, \'multiverseid\': 495679}, {\'name\': "Commandant d\'escouade", \'text\': "Quand le Commandant d\'escouade arrive sur le champ de bataille, créez un jeton de créature 1/1 blanche Kor et Guerrier pour chaque creature dans votre groupe.\\nAu début du combat pendant votre tour, si vous avez un groupe complet, les créatures que vous contrôlez gagnent +1/+0 et acquièrent l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature : kor et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495754&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77c8f3b8-e88c-4e01-a428-a88993725e50\', \'multiverseId\': 495754}, \'multiverseid\': 495754}, {\'name\': \'兵団の統率者\', \'text\': \'兵団の統率者が戦場に出たとき、あなたのパーティーを構成しているクリーチャー１体につき白の１/ １のコー・戦士・クリーチャー・トークンを１体生成する。\\nあなたのターンの戦闘の開始時に、あなたのパーティーが全員そろっている場合、ターン終了時まで、あなたがコントロールしているクリーチャーは＋１/＋０の修整を受け破壊不能を得る。\', \'type\': \'クリーチャー — コー・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495829&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a84f92f-287d-4f17-acf3-a981c854899a\', \'multiverseId\': 495829}, \'multiverseid\': 495829}]', "[{'name': 'Tuktuk-Trümmerfort', 'text': 'Verteidiger, Reichweite\\nKreaturen, die du kontrollierst, haben Eile.', 'type': 'Kreatur — Mauer', 'flavor': 'So wie bei allem anderen, glauben Goblins, dass Befestigungen möglichst viele Stacheln haben sollten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492133&type=card', 'language': 'German', 'identifiers': {'scryfallId': '97a89bea-5e9e-47b2-8551-c651811b0229', 'multiverseId': 492133}, 'multiverseid': 492133}, {'name': 'Fortaleza de escombros de Tuktuk', 'text': 'Defensor, alcance.\\nLas criaturas que controlas tienen la habilidad de prisa.', 'type': 'Criatura — Muro', 'flavor': 'Como con todo, los trasgos creen que las fortificaciones son mejores cuantos más trocitos puntiagudos tengan.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492449&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'da84da30-48cf-43a4-8b31-433cf47b353a', 'multiverseId': 492449}, 'multiverseid': 492449}, {'name': 'Fort de gravas tuktuk', 'text': 'Défenseur, portée\\nLes créatures que vous contrôlez ont la célérité.', 'type': 'Créature : mur', 'flavor': 'Comme pour tout le reste, les gobelins pensent que de bonnes fortifications doivent être couvertes de pointes et de pics.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492765&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6b5e866d-170b-4045-9954-38f33257daaf', 'multiverseId': 492765}, 'multiverseid': 492765}, {'name': 'Forte di Macerie dei Tuktuk', 'text': 'Difensore, raggiungere\\nLe creature che controlli hanno rapidità.', 'type': 'Creatura — Muro', 'flavor': 'Come per tutto il resto, i goblin credono che le fortificazioni siano migliorabili aggiungendo quanti più spuntoni possibili.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493081&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9c3b7153-7966-460f-8d79-54b8114021d1', 'multiverseId': 493081}, 'multiverseid': 493081}, {'name': 'タクタクの瓦礫砦', 'text': '防衛、到達\\nあなたがコントロールしているクリーチャーは速攻を持つ。', 'type': 'クリーチャー — 壁', 'flavor': '他の様々な誤解と同じく、砦はトゲトゲギザギザしていればいるほど強固になるとゴブリンたちは思い込んでいる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493397&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8239fff1-084e-4683-89ab-bf45cdace5c1', 'multiverseId': 493397}, 'multiverseid': 493397}, {'name': '툭툭 자갈요새', 'text': '수비태세, 대공\\n당신이 조종하는 생물들은 신속을 가진다.', 'type': '생물 — 벽', 'flavor': '다른 것들과 마찬가지로, 고블린들은 요새를 강화하는 것 또한 뾰족한 것들을 가능한 많이 붙이면 좋다고 생각한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493713&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '541e965d-f205-4047-8a5b-587e61e7a80a', 'multiverseId': 493713}, 'multiverseid': 493713}, {'name': 'Forte dos Escombros Tuktuk', 'text': 'Defensor, alcance\\nAs criaturas que você controla têm ímpeto.', 'type': 'Criatura — Barreira', 'flavor': 'Os goblins acreditam que, como qualquer outra coisa, as fortificações devem ter o máximo de pedaços pontudos possível.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494029&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'abe4e006-10ee-452f-8920-6ffc832ed31b', 'multiverseId': 494029}, 'multiverseid': 494029}, {'name': 'Булыжная Крепость Туктуков', 'text': 'Защитник, Захват\\nСущества под вашим контролем имеют Ускорение.', 'type': 'Существо — Стена', 'flavor': 'Гоблины считают, что укрепления — как, впрочем, и все остальное — тем лучше, чем больше в них острых выступов.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494345&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5388fa62-ebc2-422b-b41c-0bc695630ba2', 'multiverseId': 494345}, 'multiverseid': 494345}, {'name': '图图乱石堡', 'text': '守军，延势\\n由你操控的生物具有敏捷异能。', 'type': '生物 ～墙', 'flavor': '鬼怪认为工事跟其他东西一样，尖头越多越可靠。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494661&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f8d6f82a-1d4b-4cdd-8fa1-78ad86b7db45', 'multiverseId': 494661}, 'multiverseid': 494661}, {'name': '圖圖亂石堡', 'text': '守軍，延勢\\n由你操控的生物具有敏捷異能。', 'type': '生物 ～牆', 'flavor': '鬼怪認為工事跟其他東西一樣，尖頭越多越可靠。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494977&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f34a85d9-8ef4-4824-bf72-251bf2aa6992', 'multiverseId': 494977}, 'multiverseid': 494977}]", '[{\'name\': \'Turbulenter Strudel\', \'text\': \'Zu Beginn des Versorgungssegments jedes Spielers fügt der Turbulente Strudel dem Spieler 1 Schadenspunkt zu.\\nImmer wenn ein Spieler einen Zauberspruch wirkt und falls kein Mana ausgegeben wurde, um den Zauberspruch zu wirken, fügt der Turbulente Strudel dem Spieler 5 Schadenspunkte zu.\\n{R}: Deine Gegner können in diesem Zug keine Lebenspunkte dazuerhalten.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492113&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'186413f6-ecab-4df1-aac5-cf353f30057d\', \'multiverseId\': 492113}, \'multiverseid\': 492113}, {\'name\': \'Vórtice turbulento\', \'text\': \'Al comienzo del mantenimiento de cada jugador, el Vórtice turbulento le hace 1 punto de daño.\\nSiempre que un jugador lance un hechizo, si no se usó maná para lanzarlo, el Vórtice turbulento hace 5 puntos de daño a ese jugador.\\n{R}: Tus oponentes no pueden ganar vidas este turno.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0735f8ac-0998-407c-89c2-18b91202973b\', \'multiverseId\': 492429}, \'multiverseid\': 492429}, {\'name\': \'Vortex bouillonnant\', \'text\': "Au début de l\'entretien de chaque joueur, le Vortex bouillonnant inflige 1 blessure à ce joueur.\\nÀ chaque fois qu\'un joueur lance un sort, si aucun mana n\'a été dépensé pour lancer ce sort, le Vortex bouillonnant inflige 5 blessures à ce joueur.\\n{R} : Vos adversaires ne peuvent pas gagner de points de vie ce tour-ci.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0ce0033-1aaa-4ed3-8906-1b6c4ea70aab\', \'multiverseId\': 492745}, \'multiverseid\': 492745}, {\'name\': \'Vortice Torbido\', \'text\': "All\'inizio del mantenimento di ogni giocatore, il Vortice Torbido gli infligge 1 danno.\\nOgniqualvolta un giocatore lancia una magia, se non è stato speso mana per lanciare quella magia, il Vortice Torbido infligge 5 danni a quel giocatore.\\n{R}: I tuoi avversari non possono guadagnare punti vita in questo turno.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493061&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a955e4b-b700-4bbf-bb5b-c0931ba35db8\', \'multiverseId\': 493061}, \'multiverseid\': 493061}, {\'name\': \'乱動する渦\', \'text\': \'各プレイヤーのアップキープの開始時に、乱動する渦はそのプレイヤーに１点のダメージを与える。\\nプレイヤーが呪文を唱えるたび、その呪文を唱えるためにマナが支払われていない場合、乱動する渦はそのプレイヤーに５点のダメージを与える。\\n{R}：このターン、対戦相手はライフを得られない。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493377&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'61f79e7f-21c2-40fe-bb5e-a937a85b60d7\', \'multiverseId\': 493377}, \'multiverseid\': 493377}, {\'name\': \'휘몰아치는 소용돌이\', \'text\': \'각 플레이어의 유지단 시작에, 휘몰아치는 소용돌이는 그 플레이어에게 피해 1점을 입힌다.\\n플레이어가 주문을 발동할 때마다, 그 주문을 발동하는 데 마나가 지불되지 않았다면, 휘몰아치는 소용돌이는 그 플레이어에게 피해 5점을 입힌다.\\n{R}: 당신의 상대들은 이 턴에 생명점을 얻을 수 없다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493693&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bd385901-4bd8-49ce-9676-25e25cec665a\', \'multiverseId\': 493693}, \'multiverseid\': 493693}, {\'name\': \'Vórtice Turbilhonante\', \'text\': \'No início da manutenção de cada jogador, Vórtice Turbilhonante causa 1 ponto de dano a ele.\\nToda vez que um jogador conjura uma mágica, se nenhum mana foi gasto para conjurar aquela mágica, Vórtice Turbilhonante causa 5 pontos de dano àquele jogador.\\n{R}: Seus oponentes não podem ganhar pontos de vida neste turno.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98d2c36e-823b-4121-867d-e62ffbf5efe8\', \'multiverseId\': 494009}, \'multiverseid\': 494009}, {\'name\': \'Бурлящий Вихрь\', \'text\': \'В начале шага поддержки каждого игрока Бурлящий Вихрь наносит 1 повреждение тому игроку.\\nКаждый раз, когда игрок разыгрывает заклинание, если на разыгрывание того заклинания не было потрачено никакой маны, то Бурлящий Вихрь наносит 5 повреждений тому игроку.\\n{R}: ваши оппоненты не могут получать жизни в этом ходу.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494325&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b6ad6cff-9ecd-43c7-a334-69e59ab8c3a4\', \'multiverseId\': 494325}, \'multiverseid\': 494325}, {\'name\': \'狂搅漩涡\', \'text\': \'在每位牌手的维持开始时，狂搅漩涡对其造成1点伤害。\\n每当任一牌手施放咒语，若施放该咒语时未支付过法术力，则狂搅漩涡对该牌手造成5点伤害。\\n{R}：本回合中，对手不能获得生命。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494641&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6269a554-cdd6-48e1-b14f-9d013cfa9501\', \'multiverseId\': 494641}, \'multiverseid\': 494641}, {\'name\': \'狂攪漩渦\', \'text\': \'在每位玩家的維持開始時，狂攪漩渦對其造成1點傷害。\\n每當任一玩家施放咒語，若施放該咒語時未支付過魔法力，則狂攪漩渦對該玩家造成5點傷害。\\n{R}：本回合中，對手不能獲得生命。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494957&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'926eca4c-db13-4cc0-8db3-41e16a0eb8cf\', \'multiverseId\': 494957}, \'multiverseid\': 494957}]', '[{\'name\': \'Turbulenter Strudel\', \'text\': \'Zu Beginn des Versorgungssegments jedes Spielers fügt der Turbulente Strudel dem Spieler 1 Schadenspunkt zu.\\nImmer wenn ein Spieler einen Zauberspruch wirkt und falls kein Mana ausgegeben wurde, um den Zauberspruch zu wirken, fügt der Turbulente Strudel dem Spieler 5 Schadenspunkte zu.\\n{R}: Deine Gegner können in diesem Zug keine Lebenspunkte dazuerhalten.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495712&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b268c325-0786-4f2a-a9e0-dc319bd6e259\', \'multiverseId\': 495712}, \'multiverseid\': 495712}, {\'name\': \'Vortex bouillonnant\', \'text\': "Au début de l\'entretien de chaque joueur, le Vortex bouillonnant inflige 1 blessure à ce joueur.\\nÀ chaque fois qu\'un joueur lance un sort, si aucun mana n\'a été dépensé pour lancer ce sort, le Vortex bouillonnant inflige 5 blessures à ce joueur.\\n{R} : Vos adversaires ne peuvent pas gagner de points de vie ce tour-ci.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495787&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'463820a0-78ec-4549-bbf8-a48eb28d3147\', \'multiverseId\': 495787}, \'multiverseid\': 495787}, {\'name\': \'乱動する渦\', \'text\': \'各プレイヤーのアップキープの開始時に、乱動する渦はそのプレイヤーに１点のダメージを与える。\\nプレイヤーが呪文を唱えるたび、その呪文を唱えるためにマナが支払われていない場合、乱動する渦はそのプレイヤーに５点のダメージを与える。\\n{R}：このターン、対戦相手はライフを得られない。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495862&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98183264-5363-4c5a-bba0-64962cb79f92\', \'multiverseId\': 495862}, \'multiverseid\': 495862}]', '[{\'name\': \'Turbulentes neues Leben\', \'text\': \'Opfere ein Land. Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, bringe sie getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wurzeln bahnen sich ihren Weg durch den Fels und selbst Berge müssen neuem Wachstum Platz machen."\\n—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492165&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6b5a8f5c-ddd2-44fc-a641-c047d44f173c\', \'multiverseId\': 492165}, \'multiverseid\': 492165}, {\'name\': \'Reverdecer turbulento\', \'text\': \'Sacrifica una tierra. Busca en tu biblioteca hasta dos cartas de tierra básica, ponlas en el campo de batalla giradas y luego baraja tu biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'"Las raíces deben abrirse paso entre las rocas, e incluso las montañas han de ceder ante los crecimientos nuevos".\\n—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492481&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7adca9e1-c8b1-4156-9816-3f2904f59619\', \'multiverseId\': 492481}, \'multiverseid\': 492481}, {\'name\': \'Résurgence du Roulis\', \'text\': "Sacrifiez un terrain. Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base, mettez-les sur le champ de bataille engagées et mélangez ensuite votre bibliothèque.", \'type\': \'Éphémère\', \'flavor\': \'« Les racines traversent le roc, et même les montagnes doivent laisser la place à une nouvelle pousse. »\\n—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492797&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'186ebf11-88e8-4f9f-bf3d-156d0914b105\', \'multiverseId\': 492797}, \'multiverseid\': 492797}, {\'name\': \'Rinascita Torbida\', \'text\': \'Sacrifica una terra. Passa in rassegna il tuo grimorio per trovare fino a due carte terra base, mettile sul campo di battaglia TAPpate, poi rimescola il tuo grimorio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le radici si fanno strada attraverso la roccia e anche le montagne devono lasciare spazio alla nuova vegetazione."\\n—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493113&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce1385ac-34a4-4df4-9aa7-14337252cf51\', \'multiverseId\': 493113}, \'multiverseid\': 493113}, {\'name\': \'乱動の再成長\', \'text\': \'土地１つを生け贄に捧げる。あなたのライブラリーから基本土地・カード最大２枚を探し、タップ状態で戦場に出す。その後、あなたのライブラリーを切り直す。\', \'type\': \'インスタント\', \'flavor\': \'「樹木の根は岩の奥まで伸びてゆく。山でさえも新たな成長に道を譲らざるを得ないわ。」\\n――ニッサ・レヴェイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493429&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69c1a541-c7e5-4e1f-8957-d5ad05eca04c\', \'multiverseId\': 493429}, \'multiverseid\': 493429}, {\'name\': \'거칠게 흐르는 재성장\', \'text\': \'대지 한 개를 희생한다. 당신의 서고에서 기본 대지 카드를 최대 두 장까지 찾아, 탭된 채로 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'순간마법\', \'flavor\': \'"뿌리는 바위의 틈새로 길을 찾는다. 산 조차도 새로운 성장에는 길을 내 주어야 하지."\\n—니사 레베인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493745&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e6f9b9ba-4f1e-4883-acd2-e3007e0e4cb0\', \'multiverseId\': 493745}, \'multiverseid\': 493745}, {\'name\': \'Recrescimento Turbilhonante\', \'text\': \'Sacrifique um terreno. Procure até dois cards de terreno básico em seu grimório, coloque-os no campo de batalha virados e, depois, embaralhe seu grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As raízes acham seu caminho pela rocha, e mesmo as montanhas precisam abrir espaço para o que cresce."\\n— Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494061&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c5975e4-bd4d-44c0-a419-3c295011f710\', \'multiverseId\': 494061}, \'multiverseid\': 494061}, {\'name\': \'Бушующее Отрастание\', \'text\': \'Пожертвуйте землю. Найдите в вашей библиотеке не более двух карт базовых земель, положите их на поле битвы повернутыми, затем перетасуйте вашу библиотеку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Корни прокладывают себе путь через камень, и даже горы уступают дорогу новым росткам».\\n— Нисса Ревейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494377&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d41b6bbd-b218-4d6a-b2ef-885d60508600\', \'multiverseId\': 494377}, \'multiverseid\': 494377}, {\'name\': \'狂搅滋芽\', \'text\': \'牺牲一个地。从你的牌库中搜寻至多两张基本地牌，将它们横置放进战场，然后将你的牌库洗牌。\', \'type\': \'瞬间\', \'flavor\': \'「树根会想方设法穿过石块，就连高山也得给新苗让路。」\\n～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494693&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'96284b5a-0cc1-444d-b1f1-296707b24fa1\', \'multiverseId\': 494693}, \'multiverseid\': 494693}, {\'name\': \'狂攪滋芽\', \'text\': \'犧牲一個地。從你的牌庫中搜尋至多兩張基本地牌，將它們橫置放進戰場，然後將你的牌庫洗牌。\', \'type\': \'瞬間\', \'flavor\': \'「樹根會想方設法穿過石塊，就連高山也得給新苗讓路。」\\n～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495009&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6220d2a3-003b-4465-a2c9-8674b57304ea\', \'multiverseId\': 495009}, \'multiverseid\': 495009}]', '[{\'name\': \'Tyrann der Ley-Linien\', \'text\': \'Fliegend\\nDu behältst unverbrauchtes rotes Mana, sowie Segmente und Phasen enden.\\nWenn der Tyrann der Ley-Linien stirbt, kannst du eine beliebige Menge {R} bezahlen. Wenn du dies tust, fügt er einem Ziel deiner Wahl entsprechend viele Schadenspunkte zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492104&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35e35de8-4212-4d81-a881-83787fc92b4e\', \'multiverseId\': 492104}, \'multiverseid\': 492104}, {\'name\': \'Tirano de la línea mística\', \'text\': \'Vuela.\\nNo pierdes el maná rojo que no hayas usado en cuanto terminan los pasos y las fases.\\nCuando el Tirano de la línea mística muera, puedes pagar cualquier cantidad de {R}. Cuando lo hagas, hace esa misma cantidad de daño a cualquier objetivo.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492420&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1fbd429-7106-4426-9281-52031574eb3d\', \'multiverseId\': 492420}, \'multiverseid\': 492420}, {\'name\': \'Tyran des lignes ley\', \'text\': "Vol\\nVous ne perdez pas le mana rouge non dépensé au moment où les étapes et les phases se terminent.\\nQuand le Tyran des lignes ley meurt, vous pouvez payer la quantité de {R} de votre choix. Quand vous faites ainsi, il inflige autant de blessures à n\'importe quelle cible.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00b7b6d6-65a5-41fa-a291-8437653aff5c\', \'multiverseId\': 492736}, \'multiverseid\': 492736}, {\'name\': \'Tiranno della Leyline\', \'text\': \'Volare\\nNon perdi il mana rosso non speso al termine di fasi e sottofasi.\\nQuando il Tiranno della Leyline muore, puoi pagare un qualsiasi ammontare di {R}. Quando lo fai, infligge altrettanto danno a un qualsiasi bersaglio.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6f4c221-ebbc-4f3f-b545-513a5ea6c66d\', \'multiverseId\': 493052}, \'multiverseid\': 493052}, {\'name\': \'力線の暴君\', \'text\': \'飛行\\nあなたの未消費の赤マナは、ステップやフェイズの終了に際して無くならない。\\n力線の暴君が死亡したとき、あなたは望む数の{R}を支払ってもよい。そうしたとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに、その量に等しい点数のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493368&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'77563278-a366-4079-ac7c-d6788fe7073d\', \'multiverseId\': 493368}, \'multiverseid\': 493368}, {\'name\': \'수맥 폭군\', \'text\': \'비행\\n당신은 단과 단계가 끝나도 사용되지 않은 적색 마나를 잃지 않는다.\\n수맥 폭군이 죽을 때, 당신은 원하는 만큼 {R}를 지불할 수 있다. 그렇게 할 때, 원하는 목표를 정한다. 수맥 폭군은 그 목표에게 그만큼 피해를 입힌다.\', \'type\': \'생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493684&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'45e313f2-b547-45fe-8a78-73921b7c060e\', \'multiverseId\': 493684}, \'multiverseid\': 493684}, {\'name\': \'Tirano da Linha de Força\', \'text\': \'Voar\\nVocê não perde mana vermelho não gasto conforme as etapas e fases terminam.\\nQuando Tirano da Linha de Força morre, você pode pagar qualquer quantidade de {R}. Quando você faz isso, ele causa aquela quantidade de pontos de dano a qualquer alvo.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494000&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e8cfc27-d9bc-4df6-ad12-50ca32e76d30\', \'multiverseId\': 494000}, \'multiverseid\': 494000}, {\'name\': \'Тиран Невидимого Луча\', \'text\': \'Полет\\nВы не теряете непотраченную красную ману по окончании шагов и фаз.\\nКогда Тиран Невидимого Луча умирает, вы можете заплатить любое количество {R}. Когда вы это делаете, он наносит столько же повреждений любой цели.\', \'type\': \'Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494316&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39c6dc41-d1a8-4698-a6d2-f67b3f8ea398\', \'multiverseId\': 494316}, \'multiverseid\': 494316}, {\'name\': \'地脉暴君\', \'text\': \'飞行\\n你不会因步骤与阶段结束失去未用尽的红色法术力。\\n当地脉暴君死去时，你可以支付任意数量的{R}。当你如此作时，它对任意一个目标造成等量的伤害。\', \'type\': \'生物 ～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494632&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6aa2f66-a3b0-4103-bd0b-4ab2a154cb3d\', \'multiverseId\': 494632}, \'multiverseid\': 494632}, {\'name\': \'地脈暴君\', \'text\': \'飛行\\n你不會因步驟與階段結束失去未用盡的紅色魔法力。\\n當地脈暴君死去時，你可以支付任意數量的{R}。當你如此作時，它對任意一個目標造成等量的傷害。\', \'type\': \'生物 ～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494948&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4dbe7362-dbee-4c56-abae-87b838cfe865\', \'multiverseId\': 494948}, \'multiverseid\': 494948}]', '[{\'name\': \'Tyrann der Ley-Linien\', \'text\': \'Fliegend\\nDu behältst unverbrauchtes rotes Mana, sowie Segmente und Phasen enden.\\nWenn der Tyrann der Ley-Linien stirbt, kannst du eine beliebige Menge {R} bezahlen. Wenn du dies tust, fügt er einem Ziel deiner Wahl entsprechend viele Schadenspunkte zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495708&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ec87af26-cb8f-432f-b41c-89fd5536ddc2\', \'multiverseId\': 495708}, \'multiverseid\': 495708}, {\'name\': \'Tyran des lignes ley\', \'text\': "Vol\\nVous ne perdez pas le mana rouge non dépensé au moment où les étapes et les phases se terminent.\\nQuand le Tyran des lignes ley meurt, vous pouvez payer la quantité de {R} de votre choix. Quand vous faites ainsi, il inflige autant de blessures à n\'importe quelle cible.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495783&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b75e8707-08c5-4f01-9c3f-197f5b6e3226\', \'multiverseId\': 495783}, \'multiverseid\': 495783}, {\'name\': \'力線の暴君\', \'text\': \'飛行\\nあなたの未消費の赤マナは、ステップやフェイズの終了に際して無くならない。\\n力線の暴君が死亡したとき、あなたは望む数の{R}を支払ってもよい。そうしたとき、クリーチャー１体かプレインズウォーカー１体かプレイヤー１人を対象とする。これはそれに、その量に等しい点数のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495858&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f455de3-afbf-43e7-8d94-b82a26df8dac\', \'multiverseId\': 495858}, \'multiverseid\': 495858}]', '[{\'name\': \'Tödliche Allianz\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\\nZerstöre eine Kreatur oder einen Planeswalker deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Einzeln würde er jeden von uns besiegen, aber uns allen ist er nicht gewachsen!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492047&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb900251-2c9f-4fe6-860c-a5fd50629f20\', \'multiverseId\': 492047}, \'multiverseid\': 492047}, {\'name\': \'Alianza letal\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\\nDestruye la criatura o planeswalker objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Él podría con cualquiera de nosotros, ¡pero no con todos a la vez!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492363&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f00f3489-cd66-460b-92bd-2220eac4b5ba\', \'multiverseId\': 492363}, \'multiverseid\': 492363}, {\'name\': \'Alliance mortelle\', \'text\': "Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)\\nDétruisez une créature ciblée ou un planeswalker ciblé.", \'type\': \'Éphémère\', \'flavor\': \'« Il pourrait nous vaincre séparément, mais il ne peut pas nous maîtriser tous en même temps ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'093d0979-485f-445e-a892-0302a476fd75\', \'multiverseId\': 492679}, \'multiverseid\': 492679}, {\'name\': \'Alleanza Mortale\', \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\\nDistruggi una creatura o un planeswalker bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Potrebbe battere facilmente uno qualsiasi di noi, ma non ha speranze contro tutti noi!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492995&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b65a13a8-a478-4b4c-a36d-60703770bbe7\', \'multiverseId\': 492995}, \'multiverseid\': 492995}, {\'name\': \'命取りの協力\', \'text\': \'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\\nクリーチャー１体かプレインズウォーカー１体を対象とする。それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「俺たち一人ならなんとかできるかも知れねぇが、俺たち全員には敵わねぇぜ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493311&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad6379ac-41d8-4a1a-ad47-86bd7747ccc5\', \'multiverseId\': 493311}, \'multiverseid\': 493311}, {\'name\': \'치명적인 동맹\', \'text\': \'이 주문은 당신의 파티에 있는 각 생물마다 발동하는 데 {1}이 덜 든다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\\n생물 또는 플레인즈워커를 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"우리 중 하나는 상대할 수 있겠지만, 우리 전부를 상대할 수는 없어!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493627&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'582ce28d-9746-4f28-a64c-463335aeafb2\', \'multiverseId\': 493627}, \'multiverseid\': 493627}, {\'name\': \'Aliança Mortífera\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada para cada criatura em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\\nDestrua a criatura ou o planeswalker alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Ele poderia com qualquer um de nós, mas não é páreo para todos nós!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493943&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24001d9f-6957-40e9-a37b-3951dae1b370\', \'multiverseId\': 493943}, \'multiverseid\': 493943}, {\'name\': \'Смертоносный Альянс\', \'text\': "Разыгрывание этого заклинания стоит на {1} меньше за каждое существо в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\\nУничтожьте целевое существо или planeswalker\'а.", \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Он мог справиться с любым из нас, но не со всеми сразу!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494259&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'09a2f8c7-c65f-438e-9dfc-29d35b3f9808\', \'multiverseId\': 494259}, \'multiverseid\': 494259}, {\'name\': \'联手夺命\', \'text\': \'你冒险团中每有一个生物，此咒语便减少{1}来施放。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\\n消灭目标生物或鹏洛客。\', \'type\': \'瞬间\', \'flavor\': \'「也许我们当中任一个都不是他的对手，但他应付不了我们所有人！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494575&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e8b7ebed-a460-41b0-b8c4-7ef1507bfe3b\', \'multiverseId\': 494575}, \'multiverseid\': 494575}, {\'name\': \'聯手奪命\', \'text\': \'你冒險團中每有一個生物，此咒語便減少{1}來施放。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\\n消滅目標生物或鵬洛客。\', \'type\': \'瞬間\', \'flavor\': \'「也許我們當中任一個都不是他的對手，但他應付不了我們所有人！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494891&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'45eb0574-3dbb-486e-952b-b1007fc8d58f\', \'multiverseId\': 494891}, \'multiverseid\': 494891}]', '[{\'name\': \'Umara-Mystikerin\', \'text\': \'Fliegend\\nImmer wenn du einen Spontanzauber, eine Hexerei oder einen Zauberer-Zauberspruch wirkst, erhält die Umara-Mystikerin +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Wir tolerieren das Versteck der Diebe in Nord-Hada, aber Meuchler, die flussabwärts wandern, haben sich einen Ritt auf einem Himmelsmanta hinaus aufs Meer verdient."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492205&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c36898dc-261a-44e7-b6c7-13f5b60f3382\', \'multiverseId\': 492205}, \'multiverseid\': 492205}, {\'name\': \'Mística de Umara\', \'text\': \'Vuela.\\nSiempre que lances un hechizo de instantáneo, de conjuro o de Hechicero, la Mística de Umara obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"Toleramos a la guarida de ladrones de Hada Norte, pero expulsamos al mar con aeromantas a los asesinos que deambulan río abajo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492521&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'819588f3-d0cf-4287-8b7f-2b3720260869\', \'multiverseId\': 492521}, \'multiverseid\': 492521}, {\'name\': "Mystique de l\'Oumara", \'text\': "Vol\\nÀ chaque fois que vous lancez un sort d\'éphémère, de rituel ou de sorcier, la Mystique de l\'Oumara gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "« Nous tolérons le repère des voleurs de Nord-Hada, mais les surineurs qui traînent plus bas ont droit à un aller simple pour l\'océan en raie manta céleste. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492837&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e40179c1-fbde-4b21-9a6d-ccd6769a6fb0\', \'multiverseId\': 492837}, \'multiverseid\': 492837}, {\'name\': \'Mistica di Umara\', \'text\': \'Volare\\nOgniqualvolta lanci una magia istantaneo, stregoneria o Mago, la Mistica di Umara prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Tolleriamo il covo di ladri di Hada del Nord, ma i tagliagole che si avventurano lungo il fiume si guadagnano un giro in aeromanta verso il mare aperto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493153&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9be6d895-8863-4f1f-9650-8302771bffdf\', \'multiverseId\': 493153}, \'multiverseid\': 493153}, {\'name\': \'ウマーラの神秘家\', \'text\': \'飛行\\nあなたがインスタントやソーサリーやウィザードである呪文を唱えるたび、ターン終了時まで、ウマーラの神秘家は＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'「北ハーダの盗賊の巣は大目に見ても、下流をうろつく殺し屋が空マンタに乗り海へ出ることは許し難い。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493469&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'537c0548-ca23-4fb6-b261-9f6e67321119\', \'multiverseId\': 493469}, \'multiverseid\': 493469}, {\'name\': \'우마라 신비주의자\', \'text\': \'비행\\n당신이 순간마법, 집중마법 또는 마법사 주문을 발동할 때마다, 우마라 신비주의자는 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'"하다 북부에 있는 도둑들의 소굴은 용납해 주겠지만, 강 아래쪽을 얼씬거리는 녀석들은 바다로 나가는 하늘가오리에 올라타게 될 거다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493785&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2b4a62bd-ad87-48eb-ba2e-761525bbbd6b\', \'multiverseId\': 493785}, \'multiverseid\': 493785}, {\'name\': \'Mística de Umara\', \'text\': \'Voar\\nToda vez que você conjura uma mágica instantânea, um feitiço ou uma mágica de Mago, Mística de Umara recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"Nós toleramos o covil dos ladrões de Hada do Norte, mas os salafrários que descem demais o rio ganham uma carona de arraia-voadora até o mar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494101&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'372b4474-8538-4947-a910-6f1ffd0bdfb1\', \'multiverseId\': 494101}, \'multiverseid\': 494101}, {\'name\': \'Умарский Мистик\', \'text\': \'Полет\\nКаждый раз, когда вы разыгрываете заклинание волшебства, Чародея или мгновенное заклинание, Умарский Мистик получает +2/+0 до конца хода.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Мы терпим воровское логово в Северной Хаде, но тех головорезов, что спускаются вниз по реке, ждет поездка на небоскате в открытое море.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494417&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2e22f02f-0a09-4999-bc37-759dac576897\', \'multiverseId\': 494417}, \'multiverseid\': 494417}, {\'name\': \'乌玛拉秘教徒\', \'text\': \'飞行\\n每当你施放瞬间，法术或法术师咒语时，乌玛拉秘教徒得+2/+0直到回合结束。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'「我们能够容忍盗贼在北哈达安营，但倘若割喉客胆敢顺流而下，他们就会被穹鳐扔到海里去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494733&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6d95788a-3277-44d0-aca8-58f124337f34\', \'multiverseId\': 494733}, \'multiverseid\': 494733}, {\'name\': \'烏瑪拉秘教徒\', \'text\': \'飛行\\n每當你施放瞬間，巫術或魔法師咒語時，烏瑪拉秘教徒得+2/+0直到回合結束。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'「我們能夠容忍盜賊在北哈達安營，但倘若割喉客膽敢順流而下，他們就會被穹鰩扔到海裡去。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495049&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9330ad38-8fc6-4d29-a5ac-f5ae63b6aeda\', \'multiverseId\': 495049}, \'multiverseid\': 495049}]', '[{\'name\': \'Umara-Zauberer // Umara-Himmelsfälle\', \'text\': \'Die Umara-Himmelsfälle kommen getappt ins Spiel.\\n{T}: Erzeuge {U}.\\nZauberer\\n{4}{U}\', \'type\': \'Land\', \'flavor\': \'„Die Quelle des Umara-Flusses liegt hoch über Oran-Rief und vergießt ununterbrochen ihre Tränen auf den Dschungel darunter."\\n—Ko Dari, Zauberin der Expedition\', \'faceName\': \'Umara-Himmelsfälle\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492034&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b898dd5e-cb4d-47c4-b17c-9ab1d3273bcb\', \'multiverseId\': 492034}, \'multiverseid\': 492034}, {\'name\': \'Hechicero de Umara // Aerocascadas de Umara\', \'text\': \'Las Aerocascadas de Umara entran al campo de batalla giradas.\\n{T}: Agrega {U}.\\nHechicero\\n{4}{U}\', \'type\': \'Tierra\', \'flavor\': \'"El origen del río Umara se encuentra en lo alto de Oran-Rief, cuyo llanto eterno desciende sobre la jungla inferior".\\n—Ko Dari, hechicero de expedición\', \'faceName\': \'Aerocascadas de Umara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492350&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9954ee3-e29f-4141-b737-47015c86725d\', \'multiverseId\': 492350}, \'multiverseid\': 492350}, {\'name\': "Sorcier de l\'Oumara // Chutes célestes de l\'Oumara", \'text\': "Les Chutes célestes de l\'Oumara arrivent sur le champ de bataille engagées.\\n{T} : Ajoutez {U}.\\nSorcier\\n{4}{U}", \'type\': \'Terrain\', \'flavor\': "« La source de la rivière de l\'Oumara se trouve bien au-dessus d\'Oran-Rief et s\'écoule sur la jungle en contrebas. »\\n—Ko Dari, sorcier d\'expédition", \'faceName\': "Chutes célestes de l\'Oumara", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'03b86568-8526-46f8-a49d-6f478acc1fdd\', \'multiverseId\': 492666}, \'multiverseid\': 492666}, {\'name\': \'Mago di Umara // Cascate Celesti di Umara\', \'text\': \'Le Cascate Celesti di Umara entrano nel campo di battaglia TAPpate.\\n{T}: Aggiungi {U}.\\nMago\\n{4}{U}\', \'type\': \'Terra\', \'flavor\': \'"La sorgente del fiume Umara si trova in alto sopra Oran-Rief, dove piange ininterrottamente sulla giungla sottostante."\\n—Ko Dari, maga della spedizione\', \'faceName\': \'Cascate Celesti di Umara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2db2f1c8-758a-4c4c-b7f9-46c48c6b814f\', \'multiverseId\': 492982}, \'multiverseid\': 492982}, {\'name\': \'ウマーラの魔術師 // ウマーラの空滝\', \'text\': \'ウマーラの空滝はタップ状態で戦場に出る。\\n{T}：{U}を加える。\\nウィザード\\n{4}{U}\', \'type\': \'土地\', \'flavor\': \'「ウマーラ急流の源流はオラン＝リーフのはるか上空にあってジャングルに水を滴らせているのだ。」\\n――探検隊の魔術師、コ・ダーリ\', \'faceName\': \'ウマーラの空滝\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493298&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4c99dc66-fc7e-473f-8ac2-42ddebc50c0f\', \'multiverseId\': 493298}, \'multiverseid\': 493298}, {\'name\': \'우마라 마법사 // 우마라 하늘폭포\', \'text\': \'우마라 하늘폭포는 탭된 채로 전장에 들어온다.\\n{T}: {U}를 추가한다.\\n마법사\\n{4}{U}\', \'type\': \'대지\', \'flavor\': \'"우마라 강의 근원은 오란리프 상공에서 그 아래에 있는 정글에 끊임없이 물길을 쏟아내고 있어."\\n—탐험 마법사, 코 다리\', \'faceName\': \'우마라 하늘폭포\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493614&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'60dcfb9d-d169-4a91-a129-506bcafa747b\', \'multiverseId\': 493614}, \'multiverseid\': 493614}, {\'name\': \'Mago de Umara // Cataratas Celestes de Umara\', \'text\': \'Cataratas Celestes de Umara entra no campo de batalha virada.\\n{T}: Adicione {U}.\\nMago\\n{4}{U}\', \'type\': \'Terreno\', \'flavor\': \'"A nascente do rio Umara paira sobre Oran-Rief, derramando eternamente suas lágrimas nas selvas abaixo."\\n— Ko Dari, maga da expedição\', \'faceName\': \'Cataratas Celestes de Umara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b36b5870-aadf-4483-9352-898965261a01\', \'multiverseId\': 493930}, \'multiverseid\': 493930}, {\'name\': \'Умарский Чародей // Умарские Небопады\', \'text\': \'Умарские Небопады выходят на поле битвы повернутыми.\\n{T}: добавьте {U}.\\nЧародей\\n{4}{U}\', \'type\': \'Земля\', \'flavor\': \'«Исток реки Умара находится высоко над Оран-Рифом, изливая свои воды на зеленые джунгли внизу».\\n— Ко-Дари, чародейка экспедиции\', \'faceName\': \'Умарские Небопады\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494246&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f575a3bd-4017-4ad9-beb5-b47d312e8779\', \'multiverseId\': 494246}, \'multiverseid\': 494246}, {\'name\': \'乌玛拉法师 // 乌玛拉天瀑\', \'text\': \'乌玛拉天瀑须横置进战场。\\n{T}：加{U}。\\n法术师\\n{4}{U}\', \'type\': \'地\', \'flavor\': \'「乌玛拉河的源头位于欧兰黎上空，滴落涓涓细流滋养其下丛林。」\\n～探险队法师蔻达黎\', \'faceName\': \'乌玛拉天瀑\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494562&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46c5b93d-7a33-47bd-8c12-76e1a861bf92\', \'multiverseId\': 494562}, \'multiverseid\': 494562}, {\'name\': \'烏瑪拉法師 // 烏瑪拉天瀑\', \'text\': \'烏瑪拉天瀑須橫置進戰場。\\n{T}：加{U}。\\n魔法師\\n{4}{U}\', \'type\': \'地\', \'flavor\': \'「烏瑪拉河的源頭位於歐蘭黎上空，滴落涓涓細流滋養其下叢林。」\\n～探險隊法師蔻達黎\', \'faceName\': \'烏瑪拉天瀑\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494878&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1005e71d-6b6b-4d9d-81f5-74011723584c\', \'multiverseId\': 494878}, \'multiverseid\': 494878}]', '[{\'name\': \'Umara-Zauberer // Umara-Himmelsfälle\', \'text\': \'Immer wenn du einen Spontanzauber, eine Hexerei oder einen Zauberer-Zauberspruch wirkst, erhält der Umara-Zauberer Flugfähigkeit bis zum Ende des Zuges.\\nLand\\n{T}: Erzeuge {U}.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Du siehst einen Wasserfall. Ich sehe einen Weg nach oben."\\n—Ko Dari, Zauberin der Expedition\', \'faceName\': \'Umara-Zauberer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492034&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b898dd5e-cb4d-47c4-b17c-9ab1d3273bcb\', \'multiverseId\': 492034}, \'multiverseid\': 492034}, {\'name\': \'Hechicero de Umara // Aerocascadas de Umara\', \'text\': \'Siempre que lances un hechizo de instantáneo, de conjuro o de Hechicero, el Hechicero de Umara gana la habilidad de volar hasta el final del turno.\\nTierra\\n{T}: Agrega {U}.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"Tú ves una cascada. Yo veo una forma de subir".\\n—Ko Dari, hechicero de expedición\', \'faceName\': \'Hechicero de Umara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492350&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9954ee3-e29f-4141-b737-47015c86725d\', \'multiverseId\': 492350}, \'multiverseid\': 492350}, {\'name\': "Sorcier de l\'Oumara // Chutes célestes de l\'Oumara", \'text\': "À chaque fois que vous lancez un sort d\'éphémère, de rituel ou de sorcier, le Sorcier de l\'Oumara acquiert le vol jusqu\'à la fin du tour.\\nTerrain\\n{T} : Ajoutez {U}.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "« Vous voyez une chute d\'eau. Je vois un moyen de monter. »\\n—Ko Dari, sorcier d\'expédition", \'faceName\': "Sorcier de l\'Oumara", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'03b86568-8526-46f8-a49d-6f478acc1fdd\', \'multiverseId\': 492666}, \'multiverseid\': 492666}, {\'name\': \'Mago di Umara // Cascate Celesti di Umara\', \'text\': \'Ogniqualvolta lanci una magia istantaneo, stregoneria o Mago, il Mago di Umara ha volare fino alla fine del turno.\\nTerra\\n{T}: Aggiungi {U}.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Voi vedete una cascata. Io vedo una via verso l\\\'alto."\\n—Ko Dari, maga della spedizione\', \'faceName\': \'Mago di Umara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2db2f1c8-758a-4c4c-b7f9-46c48c6b814f\', \'multiverseId\': 492982}, \'multiverseid\': 492982}, {\'name\': \'ウマーラの魔術師 // ウマーラの空滝\', \'text\': \'あなたがインスタントやソーサリーやウィザードである呪文を唱えるたび、ターン終了時まで、ウマーラの魔術師は飛行を得る。\\n土地\\n{T}：{U}を加える。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'「君は滝を見ていたまえ。私は上を見てくる。」\\n――探検隊の魔術師、コ・ダーリ\', \'faceName\': \'ウマーラの魔術師\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493298&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4c99dc66-fc7e-473f-8ac2-42ddebc50c0f\', \'multiverseId\': 493298}, \'multiverseid\': 493298}, {\'name\': \'우마라 마법사 // 우마라 하늘폭포\', \'text\': \'당신이 순간마법, 집중마법 또는 마법사 주문을 발동할 때마다, 우마라 마법사는 턴종료까지 비행을 얻는다.\\n대지\\n{T}: {U}를 추가한다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'"네겐 폭포가 보이나 보군. 내겐 올라가는 길이 보여."\\n—탐험 마법사, 코 다리\', \'faceName\': \'우마라 마법사\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493614&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'60dcfb9d-d169-4a91-a129-506bcafa747b\', \'multiverseId\': 493614}, \'multiverseid\': 493614}, {\'name\': \'Mago de Umara // Cataratas Celestes de Umara\', \'text\': \'Toda vez que você conjurar uma mágica instantânea, um feitiço ou uma mágica de Mago, Mago de Umara ganhará voar até o final do turno.\\nTerreno\\n{T}: Adicione {U}.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"Você vê uma cachoeira. Eu vejo um caminho lá pra cima."\\n— Ko Dari, maga da expedição\', \'faceName\': \'Mago de Umara\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b36b5870-aadf-4483-9352-898965261a01\', \'multiverseId\': 493930}, \'multiverseid\': 493930}, {\'name\': \'Умарский Чародей // Умарские Небопады\', \'text\': \'Каждый раз, когда вы разыгрываете заклинание волшебства, Чародея или мгновенное заклинание, Умарский Чародей получает Полет до конца хода.\\nЗемля\\n{T}: добавьте {U}.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Вы видите водопад. Я вижу путь наверх».\\n— Ко-Дари, чародейка экспедиции\', \'faceName\': \'Умарский Чародей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494246&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f575a3bd-4017-4ad9-beb5-b47d312e8779\', \'multiverseId\': 494246}, \'multiverseid\': 494246}, {\'name\': \'乌玛拉法师 // 乌玛拉天瀑\', \'text\': \'每当你施放瞬间，法术或法术师咒语时，乌玛拉法师获得飞行异能直到回合结束。\\n地\\n{T}：加{U}。\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'「你看到的是瀑布。我看到的是上行道路。」\\n～探险队法师蔻达黎\', \'faceName\': \'乌玛拉法师\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494562&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46c5b93d-7a33-47bd-8c12-76e1a861bf92\', \'multiverseId\': 494562}, \'multiverseid\': 494562}, {\'name\': \'烏瑪拉法師 // 烏瑪拉天瀑\', \'text\': \'每當你施放瞬間，巫術或魔法師咒語時，烏瑪拉法師獲得飛行異能直到回合結束。\\n地\\n{T}：加{U}。\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'「你看到的是瀑布。我看到的是上行道路。」\\n～探險隊法師蔻達黎\', \'faceName\': \'烏瑪拉法師\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494878&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1005e71d-6b6b-4d9d-81f5-74011723584c\', \'multiverseId\': 494878}, \'multiverseid\': 494878}]', '[{\'name\': \'Uralter Grünwächter\', \'text\': \'Reichweite\\nDu kannst Länder aus deinem Friedhof spielen.\\nFalls ein Land ins Spiel kommt und dadurch bei einer bleibenden Karte, die du kontrollierst, eine ausgelöste Fähigkeit auslöst, wird die Fähigkeit ein weiteres Mal ausgelöst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Als die Ruinen erwachten, erwachte auch ihre Verteidigung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492139&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'12c5aa10-b8c5-4009-b313-39f7e28f7539\', \'multiverseId\': 492139}, \'multiverseid\': 492139}, {\'name\': \'Verdiguardián anciano\', \'text\': \'Alcance.\\nPuedes jugar tierras desde tu cementerio.\\nSi una tierra que entra al campo de batalla hace que se dispare una habilidad disparada de un permanente que controlas, esa habilidad se dispara una vez más.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Las defensas de las ruinas resurgieron junto a estas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492455&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f59afd72-7a2b-42bb-902c-75805dd32e84\', \'multiverseId\': 492455}, \'multiverseid\': 492455}, {\'name\': \'Gardien vert ancien\', \'text\': "Portée\\nVous pouvez jouer des terrains depuis votre cimetière.\\nSi l\'arrivée sur le champ de bataille d\'un terrain provoque le déclenchement d\'une capacité déclenchée d\'un permanent que vous contrôlez, cette capacité se déclenche une fois de plus.", \'type\': \'Créature : élémental\', \'flavor\': "Les ruines s\'éveillèrent, aussitôt suivies par leurs défenses.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492771&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8337f74-c145-4ac6-8aec-f2da216118b1\', \'multiverseId\': 492771}, \'multiverseid\': 492771}, {\'name\': \'Antico Custode dei Germogli\', \'text\': "Raggiungere\\nPuoi giocare terre dal tuo cimitero.\\nSe un terra che entra nel campo di battaglia fa innescare un\'abilità innescata di un permanente che controlli, quell\'abilità si innesca una volta in più.", \'type\': \'Creatura — Elementale\', \'flavor\': \'Quando le rovine si risvegliarono, le loro difese fecero altrettanto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493087&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b8a96f0-dc0a-4be7-898c-b7ccf50a31e4\', \'multiverseId\': 493087}, \'multiverseid\': 493087}, {\'name\': \'古の緑守り\', \'text\': \'到達\\nあなたはあなたの墓地から土地をプレイしてもよい。\\n土地が戦場に出たことによりあなたがコントロールしているパーマネントの誘発型能力が誘発するなら、その能力は追加でもう１回誘発する。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'遺跡が目覚めるとき、守り手も目覚める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493403&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98966bcb-aac7-4ccf-b3ce-51bbbd27429a\', \'multiverseId\': 493403}, \'multiverseid\': 493403}, {\'name\': \'고대의 녹음수호자\', \'text\': \'대공\\n당신은 당신의 무덤에서 대지를 플레이할 수 있다.\\n전장에 들어오는 대지가 당신이 조종하는 지속물의 격발능력을 격발시키려 하면, 그 능력은 한 번 더 격발된다.\', \'type\': \'생물 — 정령\', \'flavor\': \'폐허들이 깨어났을 때, 그것들의 방어 또한 깨어났다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493719&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a6fbd21d-eed3-440d-b765-6c340af635ba\', \'multiverseId\': 493719}, \'multiverseid\': 493719}, {\'name\': \'Guardião da Flora Ancestral\', \'text\': \'Alcance\\nVocê pode jogar terrenos do seu cemitério.\\nSe a entrada de um terreno no campo de batalha desencadear uma habilidade desencadeada de uma permanente que você controla, aquela habilidade será desencadeada uma vez adicional.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Quando as ruínas despertaram, suas defesas fizeram o mesmo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494035&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'faf49ae0-7bb0-42e5-9c89-e1b3185aac7d\', \'multiverseId\': 494035}, \'multiverseid\': 494035}, {\'name\': \'Древний Зеленый Страж\', \'text\': \'Захват\\nВы можете разыгрывать земли из вашего кладбища.\\nЕсли выходящая на поле битвы земля вызывает срабатывание срабатывающей способности перманента под вашим контролем, та способность срабатывает дополнительный раз.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Когда проснулись руины, проснулась и их защита.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494351&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'931418c7-71cd-43c9-8aa0-59ae24fc0a6e\', \'multiverseId\': 494351}, \'multiverseid\': 494351}, {\'name\': \'远古育碧灵\', \'text\': \'延势\\n你可以从你的坟墓场中使用地牌。\\n如果进战场的地触发由你操控之永久物的触发式异能，则该异能额外触发一次。\', \'type\': \'生物 ～元素\', \'flavor\': \'遗迹醒转时，其防线亦然。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494667&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'294db26b-4280-41ae-9c71-7d2896eca522\', \'multiverseId\': 494667}, \'multiverseid\': 494667}, {\'name\': \'遠古育碧靈\', \'text\': \'延勢\\n你可以從你的墳墓場中使用地牌。\\n如果進戰場的地觸發由你操控之永久物的觸發式異能，則該異能額外觸發一次。\', \'type\': \'生物 ～元素\', \'flavor\': \'遺跡醒轉時，其防線亦然。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494983&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'89b83a85-ff08-4209-9d9c-291ce5da4a71\', \'multiverseId\': 494983}, \'multiverseid\': 494983}]', '[{\'name\': \'Uralter Grünwächter\', \'text\': \'Reichweite\\nDu kannst Länder aus deinem Friedhof spielen.\\nFalls ein Land ins Spiel kommt und dadurch bei einer bleibenden Karte, die du kontrollierst, eine ausgelöste Fähigkeit auslöst, wird die Fähigkeit ein weiteres Mal ausgelöst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495719&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e6b8ee8-7be0-4493-8c11-397aa22db158\', \'multiverseId\': 495719}, \'multiverseid\': 495719}, {\'name\': \'Gardien vert ancien\', \'text\': "Portée\\nVous pouvez jouer des terrains depuis votre cimetière.\\nSi l\'arrivée sur le champ de bataille d\'un terrain provoque le déclenchement d\'une capacité déclenchée d\'un permanent que vous contrôlez, cette capacité se déclenche une fois de plus.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495794&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'41fceb8d-ef12-4434-ab1d-c43ad1c68205\', \'multiverseId\': 495794}, \'multiverseid\': 495794}, {\'name\': \'古の緑守り\', \'text\': \'到達\\nあなたはあなたの墓地から土地をプレイしてもよい。\\n土地が戦場に出たことによりあなたがコントロールしているパーマネントの誘発型能力が誘発するなら、その能力は追加でもう１回誘発する。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495869&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e63bb61-741e-4ed5-9737-fa502f82f2b9\', \'multiverseId\': 495869}, \'multiverseid\': 495869}]', '[{\'name\': \'Verazol, Spalter der Strömung\', \'text\': \'Verazol, Spalter der Strömung, kommt mit einer +1/+1-Marke ins Spiel für jedes Mana, das ausgegeben wurde, um ihn zu wirken.\\nImmer wenn du einen Zauberspruch wirkst und Bonuskosten für ihn bezahlst, kannst du zwei +1/+1-Marken von Verazol, Spalter der Strömung, entfernen. Falls du dies tust, kopiere jenen Zauberspruch. Du kannst neue Ziele für die Kopie bestimmen. (Eine Kopie eines Bleibende-Karte-Zauberspruchs wird zu einem Spielstein.)\', \'type\': \'Legendäre Kreatur — Schlange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492206&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f7853885-9f50-4c50-8237-36dee481afdc\', \'multiverseId\': 492206}, \'multiverseid\': 492206}, {\'name\': \'Vérazol, la Corriente Dividida\', \'text\': \'Vérazol, la Corriente Dividida entra al campo de batalla con un contador +1/+1 sobre ella por cada maná usado para lanzarla.\\nSiempre que lances un hechizo estimulado, puedes remover dos contadores +1/+1 de Vérazol. Si lo haces, copia ese hechizo. Puedes elegir nuevos objetivos para la copia. (Una copia de un hechizo de permanente se convierte en una ficha.)\', \'type\': \'Criatura legendaria — Serpiente\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492522&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff55f905-356f-4372-b5bc-29434139dff4\', \'multiverseId\': 492522}, \'multiverseid\': 492522}, {\'name\': \'Verazol, le courant partagé\', \'text\': "Verazol, le courant partagé arrive sur le champ de bataille avec, sur lui, un marqueur +1/+1 pour chaque mana dépensé pour le lancer.\\nÀ chaque fois que vous lancez un sort kické, vous pouvez retirer deux marqueurs +1/+1 de Verazol. Si vous faites ainsi, copiez ce sort. Vous pouvez choisir de nouvelles cibles pour cette copie. (Une copie d\'un sort de permanent devient un jeton.)", \'type\': \'Créature légendaire : grand serpent\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492838&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ab7093a-7121-4032-880f-98906db78214\', \'multiverseId\': 492838}, \'multiverseid\': 492838}, {\'name\': \'Verazol, la Corrente Scissa\', \'text\': \'Verazol, la Corrente Scissa entra nel campo di battaglia con un segnalino +1/+1 per ogni mana speso per lanciarla.\\nOgniqualvolta lanci una magia potenziata, puoi rimuovere due segnalini +1/+1 da Verazol. Se lo fai, copia quella magia. Puoi scegliere nuovi bersagli per la copia. (Una copia di una magia permanente diventa una pedina.)\', \'type\': \'Creatura Leggendaria — Serpe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493154&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'19ffb89c-b84b-4969-9610-21a0f07d1512\', \'multiverseId\': 493154}, \'multiverseid\': 493154}, {\'name\': \'分かたれし水流、ヴェラゾール\', \'text\': \'分かたれし水流、ヴェラゾールは、これを唱えるために支払われたマナ１点につき＋１/＋１カウンターが１個置かれた状態で戦場に出る。\\nあなたがキッカーされている呪文を唱えるたび、あなたは分かたれし水流、ヴェラゾールの上から＋１/＋１カウンターを２個取り除いてもよい。そうしたなら、その呪文をコピーする。あなたはそのコピーの新しい対象を選んでもよい。（パーマネント・呪文のコピーはトークンになる。）\', \'type\': \'伝説のクリーチャー — 海蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493470&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'00543d2f-a242-4d13-a535-e9890e18c52a\', \'multiverseId\': 493470}, \'multiverseid\': 493470}, {\'name\': \'물길을 나누는 자, 베라졸\', \'text\': \'물길을 나누는 자, 베라졸은 베라졸을 발동하기 위해 지불한 마나만큼 +1/+1 카운터를 가지고 전장에 들어온다.\\n당신이 키커 비용이 지불된 주문을 발동할 때마다, 당신은 베라졸에서 +1/+1 카운터 두 개를 제거할 수 있다. 그렇게 한다면, 그 주문을 복사한다. 당신은 그 복사본의 목표를 새로 정할 수 있다. (지속물 주문의 복사본은 토큰이 된다.)\', \'type\': \'전설적 생물 — 이무기\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493786&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'98e45a06-6d59-46a7-85a2-ebaa51446641\', \'multiverseId\': 493786}, \'multiverseid\': 493786}, {\'name\': \'Verazol, Corrente Partida\', \'text\': \'Verazol, Corrente Partida, entra no campo de batalha com um marcador +1/+1 para cada mana gasto para conjurá-lo.\\nToda vez que você conjura uma mágica reforçada, você pode remover dois marcadores +1/+1 de Verazol. Se fizer isso, copie aquela mágica. Você pode escolher novos alvos para a cópia. (Uma cópia de uma mágica de permanente torna-se uma ficha.)\', \'type\': \'Criatura Lendária — Serpente\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494102&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'234e1a64-eb99-4e18-9858-8bb455a26fb1\', \'multiverseId\': 494102}, \'multiverseid\': 494102}, {\'name\': \'Веразол, Разделяющий Течения\', \'text\': \'Веразол, Разделяющий Течения выходит на поле битвы с одним жетоном +1/+1 на нем за каждую ману, потраченную на его разыгрывание.\\nКаждый раз, когда вы разыгрываете заклинание, получившее Усилитель, вы можете удалить два жетона +1/+1 с Веразола. Если вы это делаете, скопируйте то заклинание. Вы можете выбрать новые цели для той копии. (Копия заклинания перманента становится фишкой.)\', \'type\': \'Легендарное Существо — Змей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494418&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'86771814-980e-47fe-8eef-5c7521a63e24\', \'multiverseId\': 494418}, \'multiverseid\': 494418}, {\'name\': \'断流怪威拉佐\', \'text\': \'断流怪威拉佐进战场时上面有数个+1/+1指示物，其数量为施放它时用来支付费用的法术力数量。\\n每当你施放已增幅的咒语时，你可以从威拉佐上移去两个+1/+1指示物。若你如此作，则复制该咒语。你可以为该复制品选择新的目标。（永久物咒语的复制品会成为衍生物。）\', \'type\': \'传奇生物 ～巨蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494734&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6ac22689-48ea-44c1-b34b-3117b0fdd2a6\', \'multiverseId\': 494734}, \'multiverseid\': 494734}, {\'name\': \'斷流怪威拉佐\', \'text\': \'斷流怪威拉佐進戰場時上面有數個+1/+1指示物，其數量為施放它時用來支付費用的魔法力數量。\\n每當你施放已增幅的咒語時，你可以從威拉佐上移去兩個+1/+1指示物。若你如此作，則複製該咒語。你可以為該複製品選擇新的目標。（永久物咒語的複製品會成為衍生物。）\', \'type\': \'傳奇生物 ～巨蛇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495050&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ceaf09ff-252f-4284-89c0-606646116d73\', \'multiverseId\': 495050}, \'multiverseid\': 495050}]', "[{'name': 'Verazol, Spalter der Strömung', 'text': 'Verazol, Spalter der Strömung, kommt mit einer +1/+1-Marke ins Spiel für jedes Mana, das ausgegeben wurde, um ihn zu wirken.\\nImmer wenn du einen Zauberspruch wirkst und Bonuskosten für ihn bezahlst, kannst du zwei +1/+1-Marken von Verazol, Spalter der Strömung, entfernen. Falls du dies tust, kopiere jenen Zauberspruch. Du kannst neue Ziele für die Kopie bestimmen.', 'type': 'Legendäre Kreatur — Schlange', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495733&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'eff70e6e-53a0-4ebf-81f5-a465f51f4501', 'multiverseId': 495733}, 'multiverseid': 495733}, {'name': 'Verazol, le courant partagé', 'text': 'Verazol, le courant partagé arrive sur le champ de bataille avec, sur lui, un marqueur +1/+1 pour chaque mana dépensé pour le lancer.\\nÀ chaque fois que vous lancez un sort kické, vous pouvez retirer deux marqueurs +1/+1 de Verazol. Si vous faites ainsi, copiez ce sort. Vous pouvez choisir de nouvelles cibles pour cette copie »', 'type': 'Créature légendaire : grand serpent', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495808&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bcc002eb-768f-4433-ae38-c41130093709', 'multiverseId': 495808}, 'multiverseid': 495808}, {'name': '分かたれし水流、ヴェラゾール', 'text': '分かたれし水流、ヴェラゾールは、これを唱えるために支払われたマナ１点につき＋１/＋１カウンターが１個置かれた状態で戦場に出る。\\nあなたがキッカーされている呪文を唱えるたび、あなたは分かたれし水流、ヴェラゾールの上から＋１/＋１カウンターを２個取り除いてもよい。その呪文をコピーする。あなたはそのコピーの新しい対象を選んでもよい。」を選んでもよい。', 'type': '伝説のクリーチャー — 海蛇', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495883&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '90b55349-32bd-4b47-baae-e6b68c5347b9', 'multiverseId': 495883}, 'multiverseid': 495883}]", '[{\'name\': \'Verbündeter Angriff\', \'text\': \'Bis zu zwei Kreaturen deiner Wahl erhalten bis zum Ende des Zuges jeweils +X/+X, wobei X gleich der Anzahl an Kreaturen in deiner Abenteurergruppe ist. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\', \'type\': \'Spontanzauber\', \'flavor\': \'Ein gemeinsamer Feind ist der Tod alten Hasses.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491938&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de033328-7513-4718-9d01-8fae1a0659c1\', \'multiverseId\': 491938}, \'multiverseid\': 491938}, {\'name\': \'Asalto de grupo\', \'text\': \'Hasta dos criaturas objetivo obtienen +X/+X cada una hasta el final del turno, donde X es la cantidad de criaturas en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\', \'type\': \'Instantáneo\', \'flavor\': \'Los odios pasados llegan a su fin cuando se tiene un enemigo en común.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'80aa8b1d-b854-4ed9-a737-e2ff1b8c9686\', \'multiverseId\': 492254}, \'multiverseid\': 492254}, {\'name\': \'Assaut allié\', \'text\': "Jusqu\'à deux créatures ciblées gagnent chacune +X/+X jusqu\'à la fin du tour, X étant le nombre de créatures dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)", \'type\': \'Éphémère\', \'flavor\': \'Un ennemi commun met fin aux anciennes querelles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492570&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9065c8cf-f71b-4141-8237-39e6ae37a216\', \'multiverseId\': 492570}, \'multiverseid\': 492570}, {\'name\': \'Assalto Alleato\', \'text\': \'Fino a due creature bersaglio prendono +X/+X fino alla fine del turno, dove X è il numero di creature nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\', \'type\': \'Istantaneo\', \'flavor\': \'Un nemico comune significa la morte dei vecchi rancori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492886&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60730355-0ab9-4c91-a5ee-e44925184b92\', \'multiverseId\': 492886}, \'multiverseid\': 492886}, {\'name\': \'共同突撃\', \'text\': \'クリーチャー最大２体を対象とする。ターン終了時まで、それらはそれぞれ＋Ｘ/＋Ｘの修整を受ける。Ｘはあなたのパーティーを構成しているクリーチャーの総数に等しい。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\', \'type\': \'インスタント\', \'flavor\': \'共通の敵の存在は昔からの憎しみを終わらせる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493202&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37fa7bf2-84ee-494a-ad65-b0f884982b91\', \'multiverseId\': 493202}, \'multiverseid\': 493202}, {\'name\': \'연합한 돌격\', \'text\': \'생물을 최대 두 개까지 목표로 정한다. 그 생물들은 각각 턴종료까지 +X/+X를 받는다. X는 당신의 파티에 있는 생물의 수이다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\', \'type\': \'순간마법\', \'flavor\': \'공동의 적은 묵은 증오를 사그라들게 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493518&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d7952eb9-ef46-4e3e-9aa6-b14f3b97c4d2\', \'multiverseId\': 493518}, \'multiverseid\': 493518}, {\'name\': \'Assalto Aliado\', \'text\': \'Até duas criaturas alvo recebem cada uma +X/+X até o final do turno, sendo X o número de criaturas em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os rancores do passado terminam quando se tem um inimigo em comum.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9eaac110-c4db-49d4-890c-1605f9d17645\', \'multiverseId\': 493834}, \'multiverseid\': 493834}, {\'name\': \'Атака Союзников\', \'text\': \'Не более двух целевых существ получают по +X/+X до конца хода, где Х — количество существ в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Общий враг положит конец старой вражде.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494150&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c1bfeaa-fe33-4e47-b89b-15ab8bf455b9\', \'multiverseId\': 494150}, \'multiverseid\': 494150}, {\'name\': \'联手突袭\', \'text\': \'至多两个目标生物各得+X/+X直到回合结束，X为你冒险团中的生物数量。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\', \'type\': \'瞬间\', \'flavor\': \'共同敌人为世代怨仇划上句点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494466&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64e7f55f-a252-43c4-9bff-d467ad2a470e\', \'multiverseId\': 494466}, \'multiverseid\': 494466}, {\'name\': \'聯手突襲\', \'text\': \'至多兩個目標生物各得+X/+X直到回合結束，X為你冒險團中的生物數量。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\', \'type\': \'瞬間\', \'flavor\': \'共同敵人為世代怨仇劃上句點。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494782&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d29c72a8-5b5d-4fac-980d-de014a9da157\', \'multiverseId\': 494782}, \'multiverseid\': 494782}]', '[{\'name\': \'Verdikt der Schatten\', \'text\': \'Schicke alle Kreaturen und Planeswalker mit umgewandelten Manakosten von 3 oder weniger aus dem Spiel ins Exil sowie alle Kreaturen- und Planeswalkerkarten mit umgewandelten Manakosten von 3 oder weniger aus allen Friedhöfen ins Exil.\', \'type\': \'Hexerei\', \'flavor\': \'Der Schleier des Todes legt sich am Ende über jeden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492078&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'78a108e8-dd2c-4805-8a33-c9d93d893307\', \'multiverseId\': 492078}, \'multiverseid\': 492078}, {\'name\': \'Veredicto de las sombras\', \'text\': \'Exilia todas las criaturas y planeswalkers con coste de maná convertido de 3 o menos del campo de batalla y todas las cartas de criatura y planeswalker con coste de maná convertido de 3 o menos de todos los cementerios.\', \'type\': \'Conjuro\', \'flavor\': \'Las sombras de la muerte se ciernen sobre todos al final.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492394&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6fbbc87e-e17b-488e-bd4f-ba4c08d6a910\', \'multiverseId\': 492394}, \'multiverseid\': 492394}, {\'name\': \'Verdict des ombres\', \'text\': \'Exilez toutes les créatures et tous les planeswalkers avec un coût converti de mana inférieur ou égal à 3 du champ de bataille et toutes les cartes de créature et de planeswalker avec un coût converti de mana inférieur ou égal à 3 de tous les cimetières.\', \'type\': \'Rituel\', \'flavor\': "L\'ombre de la mort finit par engloutir tout le monde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5bb58c97-39e9-4cf3-93c9-f2ff1e950d0b\', \'multiverseId\': 492710}, \'multiverseid\': 492710}, {\'name\': \'Verdetto delle Ombre\', \'text\': \'Esilia tutte le creature e i planeswalker con costo di mana convertito pari o inferiore a 3 dal campo di battaglia e tutte le carte creatura e planeswalker con costo di mana convertito pari o inferiore a 3 da tutti i cimiteri.\', \'type\': \'Stregoneria\', \'flavor\': \'Le ombre della morte scendono su tutti, alla fine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cebe218d-f139-4e2f-ad7d-6d799fcade33\', \'multiverseId\': 493026}, \'multiverseid\': 493026}, {\'name\': \'影の評決\', \'text\': \'戦場から点数で見たマナ・コストが３以下の、クリーチャーやプレインズウォーカーと、墓地から点数で見たマナ・コストが３以下でクリーチャーやプレインズウォーカーであるカードを、すべて追放する。\', \'type\': \'ソーサリー\', \'flavor\': \'最後には誰の上にも死の影が下りる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64a3ec3b-affb-40e6-ab4e-26d004995bc2\', \'multiverseId\': 493342}, \'multiverseid\': 493342}, {\'name\': \'그림자의 판결\', \'text\': \'전장에 있는 전환마나비용이 3 이하인 생물 및 플레인즈워커와 모든 무덤에 있는 전환마나비용이 3 이하인 생물 및 플레인즈워커 카드를 모두 추방한다.\', \'type\': \'집중마법\', \'flavor\': \'죽음의 그림자는 결국 모두에게 드리워진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493658&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'11d72bf4-b45e-4fa0-a14d-8049917e3e35\', \'multiverseId\': 493658}, \'multiverseid\': 493658}, {\'name\': \'Veredito das Sombras\', \'text\': \'Exile todas as criaturas e planeswalkers com custo de mana convertido igual ou inferior a 3 do campo de batalha e exile todos os cards de criatura e planeswalker com custo de mana convertido igual ou inferior a 3 de todos os cemitérios.\', \'type\': \'Feitiço\', \'flavor\': \'No fim, as sombras da morte recaem sobre todos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493974&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73cd9dc0-4bb2-4456-a265-a0115b250f70\', \'multiverseId\': 493974}, \'multiverseid\': 493974}, {\'name\': \'Вердикт Теней\', \'text\': "Изгоните все существа и planeswalker\'ов с конвертированной мана-стоимостью не более 3 с поля битвы и все карты существ и planeswalker\'ов с конвертированной мана-стоимостью не более 3 из всех кладбищ.", \'type\': \'Волшебство\', \'flavor\': \'В конце концов на каждого падает тень смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494290&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e34800c-27f5-40a7-839c-59fe2b19e994\', \'multiverseId\': 494290}, \'multiverseid\': 494290}, {\'name\': \'黯影裁定\', \'text\': \'放逐战场上所有总法术力费用等于或小于3之生物和鹏洛客，以及所有坟墓场中的所有总法术力费用等于或小于3之生物和鹏洛客牌。\', \'type\': \'法术\', \'flavor\': \'最后，死亡的阴影落在了所有人头上。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494606&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54f878c7-37d2-4890-a051-0fbdde06b1ce\', \'multiverseId\': 494606}, \'multiverseid\': 494606}, {\'name\': \'黯影裁定\', \'text\': \'放逐戰場上所有總魔法力費用等於或小於3之生物和鵬洛客，以及所有墳墓場中的所有總魔法力費用等於或小於3之生物和鵬洛客牌。\', \'type\': \'巫術\', \'flavor\': \'最後，死亡的陰影落在了所有人頭上。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494922&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5d2d2aab-4ed9-4ec7-ba51-83d2606b6940\', \'multiverseId\': 494922}, \'multiverseid\': 494922}]', "[{'name': 'Verdikt der Schatten', 'text': 'Schicke alle Kreaturen und Planeswalker mit umgewandelten Manakosten von 3 oder weniger aus dem Spiel ins Exil sowie alle Kreaturen- und Planeswalkerkarten mit umgewandelten Manakosten von 3 oder weniger aus allen Friedhöfen ins Exil.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495704&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7489b268-9b54-40ea-ae4b-d64b4dc0d281', 'multiverseId': 495704}, 'multiverseid': 495704}, {'name': 'Verdict des ombres', 'text': 'Exilez toutes les créatures et tous les planeswalkers avec un coût converti de mana inférieur ou égal à 3 du champ de bataille et toutes les cartes de créature et de planeswalker avec un coût converti de mana inférieur ou égal à 3 de tous les cimetières.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495779&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd13c04fe-57c1-4f7b-a888-939d21f7d18a', 'multiverseId': 495779}, 'multiverseid': 495779}, {'name': '影の評決', 'text': '戦場から点数で見たマナ・コストが３以下の、クリーチャーやプレインズウォーカーと、墓地から点数で見たマナ・コストが３以下でクリーチャーやプレインズウォーカーであるカードを、すべて追放する。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495854&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '93800b92-f80c-40e3-be20-fd8ea3a72db0', 'multiverseId': 495854}, 'multiverseid': 495854}]", '[{\'name\': \'Verlassenes Monument\', \'text\': \'Farblose Kreaturen, die du kontrollierst, erhalten +2/+2.\\nImmer wenn du eine bleibende Karte für {C} tappst, erzeuge ein zusätzliches {C}.\\nImmer wenn du einen farblosen Zauberspruch wirkst, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Wir werden für immer umherstreifen."\\n—Ayli, Hohepriesterin der Ewigen Pilger\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492211&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c9b06c4-1bd1-4c9a-a6b4-98361c02b490\', \'multiverseId\': 492211}, \'multiverseid\': 492211}, {\'name\': \'Monumento abandonado\', \'text\': \'Las criaturas incoloras que controlas obtienen +2/+2.\\nSiempre que gires un permanente para obtener {C}, agrega un {C} adicional.\\nSiempre que lances un hechizo incoloro, ganas 2 vidas.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"Deambularemos para siempre".\\n—Ayli, gran sacerdotisa de los Peregrinos Eternos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492527&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6fb9b65-cd3b-455e-adde-5ab17389c5d9\', \'multiverseId\': 492527}, \'multiverseid\': 492527}, {\'name\': \'Monument abandonné\', \'text\': \'Les créatures incolores que vous contrôlez gagnent +2/+2.\\nÀ chaque fois que vous engagez un permanent pour {C}, ajoutez {C} supplémentaire.\\nÀ chaque fois que vous lancez un sort incolore, vous gagnez 2 points de vie.\', \'type\': \'Artefact légendaire\', \'flavor\': "« Nous errerons pour l\'éternité. »\\n—Ayli, grande prêtresse des Pèlerins éternels", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492843&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dabfdabb-8946-4cdb-a3c1-1a0651fad3d0\', \'multiverseId\': 492843}, \'multiverseid\': 492843}, {\'name\': \'Monumento Abbandonato\', \'text\': \'Le creature incolori che controlli prendono +2/+2.\\nOgniqualvolta TAPpi un permanente per attingere {C}, aggiungi {C} addizionale.\\nOgniqualvolta lanci una magia incolore, guadagni 2 punti vita.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'"Vagheremo per sempre."\\n—Ayli, somma sacerdotessa dei Pellegrini Eterni\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493159&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2821fc6-caaa-43d6-b5ed-e3d6116005d1\', \'multiverseId\': 493159}, \'multiverseid\': 493159}, {\'name\': \'見捨てられた碑\', \'text\': \'あなたがコントロールしている無色のクリーチャーは＋２/＋２の修整を受ける。\\nあなたが{C}を引き出す目的でパーマネントを１つタップするたび、追加の{C}を加える。\\nあなたが無色の呪文を唱えるたび、あなたは２点のライフを得る。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'「私たちは永遠にさまよい続けるのです。」\\n――永代巡礼会の高僧、アイリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493475&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53ada0ff-271a-4407-b74e-916a9396f604\', \'multiverseId\': 493475}, \'multiverseid\': 493475}, {\'name\': \'버림받은 기념물\', \'text\': \'당신이 조종하는 무색 생물들은 +2/+2를 받는다.\\n당신이 {C}를 얻기 위해 지속물을 탭할 때마다, 그에 더해 {C}를 추가한다.\\n당신이 무색 주문을 발동할 때마다, 당신은 생명 2점을 얻는다.\', \'type\': \'전설적 마법물체\', \'flavor\': \'"우리는 영원히 떠돌 것이다."\\n—영원의 순례자 고위 사제 아일리\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493791&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8c1c4e7d-5d61-4ea4-981c-721f74c9a925\', \'multiverseId\': 493791}, \'multiverseid\': 493791}, {\'name\': \'Monumento Esquecido\', \'text\': \'As criaturas incolores que você controla recebem +2/+2.\\nToda vez que você virar uma permanente para gerar {C}, adicione um {C} adicional.\\nToda vez que conjura uma mágica incolor, você ganha 2 pontos de vida.\', \'type\': \'Artefato Lendário\', \'flavor\': \'"Vagaremos eternamente."\\n— Ayli, suma sacerdotisa dos Peregrinos Eternos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494107&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9cf9393-4466-4a31-9e38-04e1ecd8671b\', \'multiverseId\': 494107}, \'multiverseid\': 494107}, {\'name\': \'Заброшенный Монумент\', \'text\': \'Бесцветные существа под вашим контролем получают +2/+2.\\nКаждый раз, когда вы поворачиваете перманент для получения {C}, добавьте дополнительно {C}.\\nКаждый раз, когда вы разыгрываете бесцветное заклинание, вы получаете 2 жизни.\', \'type\': \'Легендарный Артефакт\', \'flavor\': \'«Мы будем скитаться всегда».\\n— Айли, верховная жрица Вечных Паломников\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494423&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'82aedc13-0f8b-443d-84bf-4549b080210f\', \'multiverseId\': 494423}, \'multiverseid\': 494423}, {\'name\': \'遭弃纪念碑\', \'text\': \'由你操控的无色生物得+2/+2。\\n每当你横置一个永久物以产生{C}时，额外加{C}。\\n每当你施放无色咒语时，你获得2点生命。\', \'type\': \'传奇神器\', \'flavor\': \'「我们将永生追随。」\\n～坚信朝圣客高阶僧侣艾栗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494739&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9910d73-bbac-4434-b230-d5fcef97a948\', \'multiverseId\': 494739}, \'multiverseid\': 494739}, {\'name\': \'遭棄紀念碑\', \'text\': \'由你操控的無色生物得+2/+2。\\n每當你橫置一個永久物以產生{C}時，額外加{C}。\\n每當你施放無色咒語時，你獲得2點生命。\', \'type\': \'傳奇神器\', \'flavor\': \'「我們將永生追隨。」\\n～堅信朝聖客高階僧侶艾栗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495055&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6f686217-adfc-499c-997b-bfa648c69dcd\', \'multiverseId\': 495055}, \'multiverseid\': 495055}]', "[{'name': 'Verlassenes Monument', 'text': 'Farblose Kreaturen, die du kontrollierst, erhalten +2/+2.\\nImmer wenn du eine bleibende Karte für {C} tappst, erzeuge ein zusätzliches {C}.\\nImmer wenn du einen farblosen Zauberspruch wirkst, erhältst du 2 Lebenspunkte dazu.', 'type': 'Legendäres Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495737&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dc34a1ab-f0f9-4ad5-967b-57ff87343e6d', 'multiverseId': 495737}, 'multiverseid': 495737}, {'name': 'Monument abandonné', 'text': 'Les créatures incolores que vous contrôlez gagnent +2/+2.\\nÀ chaque fois que vous engagez un permanent pour {C}, ajoutez {C} supplémentaire.\\nÀ chaque fois que vous lancez un sort incolore, vous gagnez 2 points de vie.', 'type': 'Artefact légendaire', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495812&type=card', 'language': 'French', 'identifiers': {'scryfallId': '56afbc6b-2c8e-4ac1-b294-91db51dd27cb', 'multiverseId': 495812}, 'multiverseid': 495812}, {'name': '見捨てられた碑', 'text': 'あなたがコントロールしている無色のクリーチャーは＋２/＋２の修整を受ける。\\nあなたが{C}を引き出す目的でパーマネントを１つタップするたび、追加の{C}を加える。\\nあなたが無色の呪文を唱えるたび、あなたは２点のライフを得る。', 'type': '伝説のアーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495887&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8f9a8bc1-dd5d-4c95-a672-b0d11ce13054', 'multiverseId': 495887}, 'multiverseid': 495887}]", '[{\'name\': \'Verrücktmachender Missklang\', \'text\': \'Bonus {3}{U}\\nJeder Gegner millt acht Karten. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, millt jeder Gegner stattdessen die Hälfte seiner Bibliothek, aufgerundet.\', \'type\': \'Hexerei\', \'flavor\': \'Jace folgte Nahiri bis in die Singende Stadt, aber die Magie der uralten Ruinen drohte, seinen Geist zu überwältigen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492013&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d655cc79-a2a9-4338-94d3-7c172c282f0e\', \'multiverseId\': 492013}, \'multiverseid\': 492013}, {\'name\': \'Cacofonía enloquecedora\', \'text\': \'Estímulo {3}{U}.\\nCada oponente muele ocho cartas. Si este hechizo fue estimulado, en vez de eso, cada oponente muele la mitad de su biblioteca, redondeando hacia arriba.\', \'type\': \'Conjuro\', \'flavor\': \'Jace siguió la pista a Nahiri hasta la Ciudad del Canto, pero la magia de las arcaicas ruinas amenazaba con sobrepasar su mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492329&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'35e5ec17-71dc-4cbc-97a7-6c53e7e0100b\', \'multiverseId\': 492329}, \'multiverseid\': 492329}, {\'name\': \'Cacophonie exaspérante\', \'text\': "Kick {3}{U}\\nChaque adversaire meule huit cartes. Si ce sort a été kické, à la place chaque adversaire meule la moitié de sa bibliothèque, arrondie à l\'unité supérieure.", \'type\': \'Rituel\', \'flavor\': "Jace suivit Nahiri jusqu\'à la Cité Chantante, mais la magie de ces ruines anciennes menaçait de lui faire perdre la tête.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f2652ca3-240d-4f9b-9b65-81b1e1ed2124\', \'multiverseId\': 492645}, \'multiverseid\': 492645}, {\'name\': \'Cacofonia Dissennante\', \'text\': \'Potenziamento {3}{U}\\nOgni avversario macina otto carte. Se questa magia è stata potenziata, ogni avversario macina invece metà del proprio grimorio, arrotondata per eccesso.\', \'type\': \'Stregoneria\', \'flavor\': \'Jace rintracciò Nahiri nella Città Canora, ma la magia delle antiche rovine minacciava di sopraffare la sua mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4c01352-9dfa-45e1-865d-f47d43984cc5\', \'multiverseId\': 492961}, \'multiverseid\': 492961}, {\'name\': \'荒れ狂う騒音\', \'text\': \'キッカー{3}{U}\\n各対戦相手はそれぞれカードを８枚切削する。この呪文がキッカーされていたなら、代わりに各対戦相手はそれぞれ自分のライブラリーの端数を切り上げた半分を切削する。\', \'type\': \'ソーサリー\', \'flavor\': \'ジェイスはナヒリの足跡を辿って歌う都へ行ったが、古代遺跡の魔法がジェイスの精神を制圧しようと襲いかかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493277&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32658380-f579-48bc-b0b4-97ddb69ce127\', \'multiverseId\': 493277}, \'multiverseid\': 493277}, {\'name\': \'미칠 것 같은 불협화음\', \'text\': \'키커 {3}{U}\\n각 상대는 카드 여덟 장을 민다. 이 주문의 키커 비용이 지불되었다면, 대신 각 상대는 자신의 서고 절반을 올림해 민다.\', \'type\': \'집중마법\', \'flavor\': \'제이스는 나히리를 쫓아 노래하는 도시로 갔지만, 고대 폐허의 마법이 그의 정신을 압도하려 위협했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493593&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b9caed80-189c-409f-9c5a-6cfb2182f6d6\', \'multiverseId\': 493593}, \'multiverseid\': 493593}, {\'name\': \'Cacofonia Enlouquecedora\', \'text\': \'Reforçar {3}{U}\\nCada oponente tritura oito cards. Se esta mágica foi reforçada, em vez disso, cada oponente tritura metade do próprio grimório, arredondada para cima.\', \'type\': \'Feitiço\', \'flavor\': \'Jace rastreou Nahiri até a Cidade Cantante, mas a magia das ruínas ancestrais ameaçava sobrepujar sua mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493909&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e6f1374b-3bdf-4c25-b4f1-88b6c4cb6353\', \'multiverseId\': 493909}, \'multiverseid\': 493909}, {\'name\': \'Безумная Какофония\', \'text\': \'Усилитель {3}{U}\\nКаждый оппонент скручивает восемь карт. Если это заклинание получило Усилитель, вместо этого каждый оппонент скручивает половину своей библиотеки с округлением в большую сторону.\', \'type\': \'Волшебство\', \'flavor\': \'Джейс проследил путь Нахири до Поющего Города, но магия древних руин грозила раздавить его разум.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494225&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c40d56a6-2c89-43b6-af92-9babeb7df52a\', \'multiverseId\': 494225}, \'multiverseid\': 494225}, {\'name\': \'致狂杂音\', \'text\': \'增幅{3}{U}\\n每位对手各磨八张牌。如果此咒语已增幅，则改为每位对手各磨其牌库一半数量的牌，小数点后进位。\', \'type\': \'法术\', \'flavor\': \'杰斯一路跟随娜希丽来到魅歌城，但这处远古遗迹的魔法却试图压垮他的心智。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494541&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e43b498-606e-4ed9-80a1-8a436b95e144\', \'multiverseId\': 494541}, \'multiverseid\': 494541}, {\'name\': \'致狂雜音\', \'text\': \'增幅{3}{U}\\n每位對手各磨八張牌。如果此咒語已增幅，則改為每位對手各磨其牌庫一半數量的牌，小數點後進位。\', \'type\': \'巫術\', \'flavor\': \'傑斯一路跟隨娜希麗來到魅歌城，但這處遠古遺跡的魔法卻試圖壓垮他的心智。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494857&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'947cbe16-5679-49e1-8ff3-a60fac5ee703\', \'multiverseId\': 494857}, \'multiverseid\': 494857}]', '[{\'name\': \'Verrücktmachender Missklang\', \'text\': \'Bonus {3}{U}\\nJeder Gegner millt acht Karten. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, millt jeder Gegner stattdessen die Hälfte seiner Bibliothek, aufgerundet.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495687&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5598ca28-bd63-49c9-bfd5-299da8a4d0cd\', \'multiverseId\': 495687}, \'multiverseid\': 495687}, {\'name\': \'Cacophonie exaspérante\', \'text\': "Kick {3}{U}\\nChaque adversaire meule huit cartes. Si ce sort a été kické, à la place chaque adversaire meule la moitié de sa bibliothèque, arrondie à l\'unité supérieure.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495762&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4f94384-16da-42a2-b9be-b8703c8bead3\', \'multiverseId\': 495762}, \'multiverseid\': 495762}, {\'name\': \'荒れ狂う騒音\', \'text\': \'キッカー{3}{U}\\n各対戦相手はそれぞれカードを８枚切削する。この呪文がキッカーされていたなら、代わりに各対戦相手はそれぞれ自分のライブラリーの端数を切り上げた半分を切削する。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495837&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d84f31ca-4e4c-44d0-8f46-ad86851b529f\', \'multiverseId\': 495837}, \'multiverseid\': 495837}]', '[{\'name\': \'Verschlungenes Pflanzenpolyeder // Verschlungenes Tal\', \'text\': \'Das Verschlungene Tal kommt getappt ins Spiel.\\n{T}: Erzeuge {G}.\\nElementarwesen\\n{1}{G}\', \'type\': \'Land\', \'flavor\': \'„Wir würden gut daran tun, unsere Augen zu öffnen und uns daran zu erinnern, was es heißt, Wunder zu sehen."\\n—Doral, Führerin aus Bala Ged\', \'faceName\': \'Verschlungenes Tal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492175&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be39e167-d2fa-427d-a51f-b50b172c3346\', \'multiverseId\': 492175}, \'multiverseid\': 492175}, {\'name\': \'Edro floral enredado // Valle Enredado\', \'text\': \'El Valle Enredado entra al campo de batalla girado.\\n{T}: Agrega {G}.\\nElemental\\n{1}{G}\', \'type\': \'Tierra\', \'flavor\': \'"Haríamos bien en abrir los ojos y recordar lo que es maravillarse".\\n—Doral, guía de Bala Ged\', \'faceName\': \'Valle Enredado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492491&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8af9c093-1fc8-418f-924d-878d6764e536\', \'multiverseId\': 492491}, \'multiverseid\': 492491}, {\'name\': \'Florhèdron enchevêtré // Val Enchevêtré\', \'text\': \'Le Val Enchevêtré arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G}.\\nÉlémental\\n{1}{G}\', \'type\': \'Terrain\', \'flavor\': "« Nous ferions bien d\'ouvrir nos yeux et de nous rappeler le sens de l\'émerveillement. »\\n—Doral, guide de Bala Ged", \'faceName\': \'Val Enchevêtré\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492807&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5d8479f-7b17-4bdf-aa4b-a289ca37999f\', \'multiverseId\': 492807}, \'multiverseid\': 492807}, {\'name\': \'Floraedro Aggrovigliato // Valle Aggrovigliata\', \'text\': \'La Valle Aggrovigliata entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {G}.\\nElementale\\n{1}{G}\', \'type\': \'Terra\', \'flavor\': \'"Faremmo bene ad aprire gli occhi e ricordare cosa significa meravigliarsi."\\n—Doral, guida di Bala Ged\', \'faceName\': \'Valle Aggrovigliata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493123&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6366b5a-0c43-4bbb-905e-e32b15e12d0f\', \'multiverseId\': 493123}, \'multiverseid\': 493123}, {\'name\': \'絡みつく花面晶体 // 絡み谷\', \'text\': \'絡み谷はタップ状態で戦場に出る。\\n{T}：{G}を加える。\\nエレメンタル\\n{1}{G}\', \'type\': \'土地\', \'flavor\': \'「目を開き、この驚くべきものを覚えておきたいものだ。」\\n――バーラ・ゲドの案内人、ドーラル\', \'faceName\': \'絡み谷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7026e38-a25e-4773-9b90-084d9f06ec6f\', \'multiverseId\': 493439}, \'multiverseid\': 493439}, {\'name\': \'뒤엉킨 식물헤드론 // 뒤엉킨 계곡\', \'text\': \'뒤엉킨 계곡은 탭된 채로 전장에 들어온다.\\n{T}: {G}를 추가한다.\\n정령\\n{1}{G}\', \'type\': \'대지\', \'flavor\': \'"눈을 크게 뜨고 경이로운 것이 무엇인지를 기억하는 것이 좋을 거야."\\n—발라 게드 안내인, 도랄\', \'faceName\': \'뒤엉킨 계곡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493755&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1b2b076f-824b-46e9-a6c4-3d372504941d\', \'multiverseId\': 493755}, \'multiverseid\': 493755}, {\'name\': \'Floriedro Emaranhado // Vale do Emaranhado\', \'text\': \'Vale do Emaranhado entra no campo de batalha virado.\\n{T}: Adicione {G}.\\nElemental\\n{1}{G}\', \'type\': \'Terreno\', \'flavor\': \'"Faríamos bem em abrir os olhos e lembrar do que é se maravilhar."\\n— Doral, guia de Bala Ged\', \'faceName\': \'Vale do Emaranhado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494071&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9457345e-5ee9-4370-a326-5fd93d94d72d\', \'multiverseId\': 494071}, \'multiverseid\': 494071}, {\'name\': \'Заросший Флораэдр // Заросший Дол\', \'text\': \'Заросший Дол выходит на поле битвы повернутым.\\n{T}: добавьте {G}.\\nЭлементаль\\n{1}{G}\', \'type\': \'Земля\', \'flavor\': \'«Хорошо бы нам вспомнить, как это — открыть глаза и удивиться чуду».\\n— Дорал, бала-гедский проводник\', \'faceName\': \'Заросший Дол\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494387&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8189c908-83c0-4697-9633-3cfc51674ef7\', \'multiverseId\': 494387}, \'multiverseid\': 494387}, {\'name\': \'杂生花晶石 // 缠结林谷\', \'text\': \'缠结林谷须横置进战场。\\n{T}：加{G}。\\n元素\\n{1}{G}\', \'type\': \'地\', \'flavor\': \'「我们只需要睁大双眼，好好记住这片自然奇迹。」\\n～巴勒格向导多拉尔\', \'faceName\': \'缠结林谷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494703&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88d07186-d171-431c-8a10-7eab6ec7fbdf\', \'multiverseId\': 494703}, \'multiverseid\': 494703}, {\'name\': \'雜生花晶石 // 纏結林谷\', \'text\': \'纏結林谷須橫置進戰場。\\n{T}：加{G}。\\n元素\\n{1}{G}\', \'type\': \'地\', \'flavor\': \'「我們只需要睜大雙眼，好好記住這片自然奇跡。」\\n～巴勒格嚮導多拉爾\', \'faceName\': \'纏結林谷\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495019&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4faf939a-13fe-481b-9653-61a4e958fc68\', \'multiverseId\': 495019}, \'multiverseid\': 495019}]', '[{\'name\': \'Verschlungenes Pflanzenpolyeder // Verschlungenes Tal\', \'text\': \'{T}: Erzeuge {G}.\\nLand\\n{T}: Erzeuge {G}.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Jetzt, da Bala Ged wieder auflebt, können wunderbare neue Lebensformen ungehindert florieren."\\n—Doral, Führerin aus Bala Ged\', \'faceName\': \'Verschlungenes Pflanzenpolyeder\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492175&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be39e167-d2fa-427d-a51f-b50b172c3346\', \'multiverseId\': 492175}, \'multiverseid\': 492175}, {\'name\': \'Edro floral enredado // Valle Enredado\', \'text\': \'{T}: Agrega {G}.\\nTierra\\n{T}: Agrega {G}.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"A medida que Bala Ged renace, aparecen nuevas formas de vida maravillosas sin restricciones".\\n—Doral, guía de Bala Ged\', \'faceName\': \'Edro floral enredado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492491&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8af9c093-1fc8-418f-924d-878d6764e536\', \'multiverseId\': 492491}, \'multiverseid\': 492491}, {\'name\': \'Florhèdron enchevêtré // Val Enchevêtré\', \'text\': \'{T} : Ajoutez {G}.\\nTerrain\\n{T} : Ajoutez {G}.\', \'type\': \'Créature : élémental\', \'flavor\': \'« Avec la repousse de Bala Ged, de nouvelles formes de vie extraordinaires font leur apparition. »\\n—Doral, guide de Bala Ged\', \'faceName\': \'Florhèdron enchevêtré\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492807&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5d8479f-7b17-4bdf-aa4b-a289ca37999f\', \'multiverseId\': 492807}, \'multiverseid\': 492807}, {\'name\': \'Floraedro Aggrovigliato // Valle Aggrovigliata\', \'text\': \'{T}: Aggiungi {G}.\\nTerra\\n{T}: Aggiungi {G}.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Mentre Bala Ged ricresce, nuove forme di vita germogliano con illimitata meraviglia."\\n—Doral, guida di Bala Ged\', \'faceName\': \'Floraedro Aggrovigliato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493123&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6366b5a-0c43-4bbb-905e-e32b15e12d0f\', \'multiverseId\': 493123}, \'multiverseid\': 493123}, {\'name\': \'絡みつく花面晶体 // 絡み谷\', \'text\': \'{T}：{G}を加える。\\n土地\\n{T}：{G}を加える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「バーラ・ゲドが再び成長し始めると、自由奔放な驚くべき形の新たな命が花開いた。」\\n――バーラ・ゲドの案内人、ドーラル\', \'faceName\': \'絡みつく花面晶体\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7026e38-a25e-4773-9b90-084d9f06ec6f\', \'multiverseId\': 493439}, \'multiverseid\': 493439}, {\'name\': \'뒤엉킨 식물헤드론 // 뒤엉킨 계곡\', \'text\': \'{T}: {G}를 추가한다.\\n대지\\n{T}: {G}를 추가한다.\', \'type\': \'생물 — 정령\', \'flavor\': \'"발라 게드가 다시 성장하면서, 새로운 모습의 생명이 구속받지 않은 경이로움과 함께 피어나고 있지."\\n—발라 게드 안내인, 도랄\', \'faceName\': \'뒤엉킨 식물헤드론\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493755&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1b2b076f-824b-46e9-a6c4-3d372504941d\', \'multiverseId\': 493755}, \'multiverseid\': 493755}, {\'name\': \'Floriedro Emaranhado // Vale do Emaranhado\', \'text\': \'{T}: Adicione {G}.\\nTerreno\\n{T}: Adicione {G}.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Conforme Bala Ged se recupera, novas formas de vida desabrocham em desinibidas maravilhas."\\n— Doral, guia de Bala Ged\', \'faceName\': \'Floriedro Emaranhado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494071&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9457345e-5ee9-4370-a326-5fd93d94d72d\', \'multiverseId\': 494071}, \'multiverseid\': 494071}, {\'name\': \'Заросший Флораэдр // Заросший Дол\', \'text\': \'{T}: добавьте {G}.\\nЗемля\\n{T}: добавьте {G}.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«В возрожденном Бала-Геде новые формы жизни расцветают ничем не сдерживаемыми чудесами».\\n— Дорал, бала-гедский проводник\', \'faceName\': \'Заросший Флораэдр\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494387&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8189c908-83c0-4697-9633-3cfc51674ef7\', \'multiverseId\': 494387}, \'multiverseid\': 494387}, {\'name\': \'杂生花晶石 // 缠结林谷\', \'text\': \'{T}：加{G}。\\n地\\n{T}：加{G}。\', \'type\': \'生物 ～元素\', \'flavor\': \'「随着巴勒格开始复苏，新的生命如奇迹般恣意绽放。」\\n～巴勒格向导多拉尔\', \'faceName\': \'杂生花晶石\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494703&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88d07186-d171-431c-8a10-7eab6ec7fbdf\', \'multiverseId\': 494703}, \'multiverseid\': 494703}, {\'name\': \'雜生花晶石 // 纏結林谷\', \'text\': \'{T}：加{G}。\\n地\\n{T}：加{G}。\', \'type\': \'生物 ～元素\', \'flavor\': \'「隨著巴勒格開始復甦，新的生命如奇跡般恣意綻放。」\\n～巴勒格嚮導多拉爾\', \'faceName\': \'雜生花晶石\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495019&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4faf939a-13fe-481b-9653-61a4e958fc68\', \'multiverseId\': 495019}, \'multiverseid\': 495019}]', '[{\'name\': \'Versengendes Sperrfeuer\', \'text\': \'Das Versengende Sperrfeuer fügt einer Kreatur deiner Wahl, die in diesem Zug als Blocker deklariert wurde, 4 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Tausende Funken können sich genauso schnell durch deine Verteidigung brennen wie ein massiver Flächenbrand."\\n—Attikar, Akoum-Elementalist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492120&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'955aaecf-0632-48dd-a37e-dc3c09481ab7\', \'multiverseId\': 492120}, \'multiverseid\': 492120}, {\'name\': \'Asalto chisporroteante\', \'text\': \'El Asalto chisporroteante hace 4 puntos de daño a la criatura objetivo que bloqueó este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Mil chispas pueden acabar con tus defensas tan rápido como una llamarada gigantesca".\\n—Attikar, elementalista de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492436&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'343601a9-caa9-451d-af72-96529f73f168\', \'multiverseId\': 492436}, \'multiverseid\': 492436}, {\'name\': \'Barrage grésillant\', \'text\': \'Le Barrage grésillant inflige 4 blessures à une créature ciblée qui a bloqué ce tour-ci.\', \'type\': \'Éphémère\', \'flavor\': "« Mille étincelles peuvent faire flamber vos défenses aussi rapidement qu\'un grand brasier. »\\n—Attikar, élémentaliste d\'Akoum", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492752&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f553bbf-3cb5-45c7-b754-4b04aac03fd0\', \'multiverseId\': 492752}, \'multiverseid\': 492752}, {\'name\': \'Bombardamento Rovente\', \'text\': \'Il Bombardamento Rovente infligge 4 danni a una creatura bersaglio che ha bloccato in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Mille scintille possono incenerire le tue difese con la stessa rapidità di un\\\'unica fiammata enorme."\\n—Attikar, elementalista di Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493068&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb3543be-8733-416e-a7b8-7a8301a2751f\', \'multiverseId\': 493068}, \'multiverseid\': 493068}, {\'name\': \'猛炎の連射\', \'text\': \'このターンにクリーチャーをブロックしたクリーチャー１体を対象とする。猛炎の連射はそれに４点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「数千の小さな炎がお前の守りを焼き尽くす。一つの巨大な炎と同じように。」\\n――アクームの精霊術士、アッティカー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493384&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'351ff383-0ecc-4f59-b5d6-37b3c423cbad\', \'multiverseId\': 493384}, \'multiverseid\': 493384}, {\'name\': \'지글거리는 일제사격\', \'text\': \'이 턴에 방어한 생물을 목표로 정한다. 지글거리는 일제사격은 그 생물에게 피해 4점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"수천 개의 작은 불꽃도 거대한 불길 하나만큼이나 네 방어를 빠르게 태워 없앨 수 있다고."\\n—아쿰 정령술사, 아티카르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493700&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ed132ae9-4b8e-4949-af12-2df56df713c9\', \'multiverseId\': 493700}, \'multiverseid\': 493700}, {\'name\': \'Estouro Fervilhante\', \'text\': \'Estouro Fervilhante causa 4 pontos de dano à criatura alvo que bloqueou neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Mil centelhas podem calcinar as suas defesas tão rápido quanto um incêndio enorme."\\n— Attikar, elementalista de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494016&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7141223a-d4c8-4fcf-86ea-3366753176c7\', \'multiverseId\': 494016}, \'multiverseid\': 494016}, {\'name\': \'Жгучий Залп\', \'text\': \'Жгучий Залп наносит 4 повреждения целевому существу, которое блокировало в этом ходу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Тысяча искр прожжет твою оборону так же быстро, как одна громадная вспышка».\\n— Аттикар, акумский маг стихий\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494332&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aa8dbe03-aa98-44b7-bf80-e53c8fa6d04b\', \'multiverseId\': 494332}, \'multiverseid\': 494332}, {\'name\': \'火热齐击\', \'text\': \'火热齐击对目标本回合中进行过阻挡的生物造成4点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「不论是千颗火星还是一束火光，烧穿你防线的速度一样快。」\\n～阿库姆元素师阿提卡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494648&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a1d5856-1380-4465-bbea-7c9ddee2810b\', \'multiverseId\': 494648}, \'multiverseid\': 494648}, {\'name\': \'火熱齊擊\', \'text\': \'火熱齊擊對目標本回合中進行過阻擋的生物造成4點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「不論是千顆火星還是一束火光，燒穿你防線的速度一樣快。」\\n～阿庫姆元素師阿提卡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494964&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef84510f-55e1-4905-b606-df06a51d4c8c\', \'multiverseId\': 494964}, \'multiverseid\': 494964}]', '[{\'name\': \'Verstandabsaugung\', \'text\': \'Ein Gegner deiner Wahl wirft zwei Karten ab, millt eine Karte und verliert 1 Lebenspunkt. Du erhältst 1 Lebenspunkt dazu. (Um eine Karte zu millen, legt der Spieler die oberste Karte seiner Bibliothek auf seinen Friedhof.)\', \'type\': \'Hexerei\', \'flavor\': \'„Das Mahl war vorzüglich. Die Konversation war zum Vergessen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492067&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6baae45e-d430-4928-86cc-84d56c9c4e98\', \'multiverseId\': 492067}, \'multiverseid\': 492067}, {\'name\': \'Drenar la mente\', \'text\': \'El oponente objetivo descarta dos cartas, muele una carta y pierde 1 vida. Ganas 1 vida. (Para moler una carta, un jugador pone la primera carta de su biblioteca en su cementerio.)\', \'type\': \'Conjuro\', \'flavor\': \'"La comida, exquisita. La conversación... no tanto".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492383&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b4880c1-5f70-4044-80c5-5954e2d50e9b\', \'multiverseId\': 492383}, \'multiverseid\': 492383}, {\'name\': "Drain d\'esprit", \'text\': \'Un adversaire ciblé se défausse de deux cartes, meule une carte, et perd 1 point de vie. Vous gagnez 1 point de vie. (Pour meuler une carte, un joueur met la carte du dessus de sa bibliothèque dans son cimetière.)\', \'type\': \'Rituel\', \'flavor\': "« Le repas était excellent. La conversation ne l\'était pas autant. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492699&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'13097735-ce62-4bea-9d40-90bd03947caf\', \'multiverseId\': 492699}, \'multiverseid\': 492699}, {\'name\': \'Prosciugamento Mentale\', \'text\': \'Un avversario bersaglio scarta due carte, macina una carta e perde 1 punto vita. Guadagni 1 punto vita. (Per macinare una carta, un giocatore mette nel suo cimitero la prima carta del suo grimorio.)\', \'type\': \'Stregoneria\', \'flavor\': \'"Il pasto è stato squisito. La conversazione un po\\\' meno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'05fce3a3-e0a6-4565-a9f8-2b8fb4eb10ae\', \'multiverseId\': 493015}, \'multiverseid\': 493015}, {\'name\': \'精神流出\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーはカード２枚を捨て、カードを１枚切削し、１点のライフを失う。あなたは１点のライフを得る。（カードを切削するとは、自分のライブラリーの一番上のカードを自分の墓地に置くことである。）\', \'type\': \'ソーサリー\', \'flavor\': \'「ディナーは絶品だったわ。会話は今一つだったけれど。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493331&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69b01fee-c404-4c8a-a418-962589564dbb\', \'multiverseId\': 493331}, \'multiverseid\': 493331}, {\'name\': \'정신 누출\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 카드 두 장을 버리고, 카드 한 장을 밀고, 생명 1점을 잃는다. 당신은 생명 1점을 얻는다. (카드를 미는 것은, 플레이어가 자신의 서고 맨 위 카드를 자신의 무덤에 넣는 것이다.)\', \'type\': \'집중마법\', \'flavor\': \'"식사는 아주 좋았네. 대화는, 그보단 좀 덜했지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493647&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8abf84c7-431e-41b5-aab7-f06bcd775409\', \'multiverseId\': 493647}, \'multiverseid\': 493647}, {\'name\': \'Dreno Mental\', \'text\': \'O oponente alvo descarta dois cards, tritura um card e perde 1 ponto de vida. Você ganha 1 ponto de vida. (Para triturar um card, um jogador coloca o card do topo do próprio grimório no próprio cemitério.)\', \'type\': \'Feitiço\', \'flavor\': \'"A refeição foi um requinte. A conversa, nem tanto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493963&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'adad2b5b-3c79-43b7-968f-dff84745476a\', \'multiverseId\': 493963}, \'multiverseid\': 493963}, {\'name\': \'Вытягивание Разума\', \'text\': \'Целевой оппонент сбрасывает две карты, скручивает карту и теряет 1 жизнь. Вы получаете 1 жизнь. (Чтобы скрутить карту, игрок кладет верхнюю карту своей библиотеки на свое кладбище.)\', \'type\': \'Волшебство\', \'flavor\': \'«Угощение было изысканным. Беседа... не слишком».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494279&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f2071796-4736-468d-a3ad-a2b31b7bef8a\', \'multiverseId\': 494279}, \'multiverseid\': 494279}, {\'name\': \'汲取心灵\', \'text\': \'目标对手弃两张牌，磨一张牌，并失去1点生命。你获得1点生命。（磨一张牌的流程是牌手将其牌库顶的牌置入其坟墓场。）\', \'type\': \'法术\', \'flavor\': \'「食物很可口。交流则不尽然。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494595&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6efb649a-4992-414a-86a7-4cedb8c00165\', \'multiverseId\': 494595}, \'multiverseid\': 494595}, {\'name\': \'汲取心靈\', \'text\': \'目標對手棄兩張牌，磨一張牌，並失去1點生命。你獲得1點生命。（磨一張牌的流程是玩家將其牌庫頂的牌置入其墳墓場。）\', \'type\': \'巫術\', \'flavor\': \'「食物很可口。交流則不盡然。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494911&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7ef7652b-3491-40bd-bce2-2904e096ddfb\', \'multiverseId\': 494911}, \'multiverseid\': 494911}]', '[{\'name\': \'Vertrauter des Ruhezauberers\', \'text\': \'{T}: Erzeuge {G} oder {U}.\\nImmer wenn du einen Zauberspruch wirkst und Bonuskosten für ihn bezahlst, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Sie speichern Energie in speziellen Verdauungsorganen … aber du möchtest wohl lieber, dass ich den Weg freimache, als über Organe zu philosophieren."\\n—Fahar, Zauberer der Expedition\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492194&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac123ef9-f437-4cec-826f-543b34d11606\', \'multiverseId\': 492194}, \'multiverseid\': 492194}, {\'name\': \'Familiar del mago arrullador\', \'text\': \'{T}: Agrega {G} o {U}.\\nSiempre que lances un hechizo estimulado, ganas 2 vidas.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"Guardan energía en unos órganos gástricos especiales... Aunque supongo que prefieres que despeje el camino a que te hable sobre tripas".\\n—Fahar, hechicero de expedición\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492510&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dbfd1f2d-b6ac-4fe7-8e28-b21b4a25f65a\', \'multiverseId\': 492510}, \'multiverseid\': 492510}, {\'name\': "Familier de l\'ataraxmage", \'text\': \'{T} : Ajoutez {G} ou {U}.\\nÀ chaque fois que vous lancez un sort kické, vous gagnez 2 points de vie.\', \'type\': \'Créature : bête\', \'flavor\': "« Ils emmagasinent l\'énergie dans des organes gastriques spéciaux... mais j\'imagine que vous préférez que je libère le passage au lieu de vous parler de tripes. »\\n—Fahar, sorcier d\'expédition", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492826&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9154223-6d73-4753-9f71-b72d55a2a677\', \'multiverseId\': 492826}, \'multiverseid\': 492826}, {\'name\': \'Famiglio del Mitigatore\', \'text\': \'{T}: Aggiungi {G} o {U}.\\nOgniqualvolta lanci una magia potenziata, guadagni 2 punti vita.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"Accumulano energia in speciali organi gastrici... ma probabilmente preferisci che sgombri la strada anziché blaterare sulle loro budella."\\n—Fahar, mago della spedizione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493142&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'605e448a-5f78-438f-bbd9-57f7be7b3a9d\', \'multiverseId\': 493142}, \'multiverseid\': 493142}, {\'name\': \'凪魔道士の使い魔\', \'text\': \'{T}：{G}か{U}を加える。\\nあなたがキッカーされている呪文を唱えるたび、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'「あれは胃の特別な器官にエネルギーを蓄えるのだが……たぶん私はそんな蘊蓄ではなく、道を切り開くよう期待されているのだろうな。」\\n――探検隊の魔術師、ファハール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493458&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b119e45-abf7-4389-948b-02c0f88d2b2c\', \'multiverseId\': 493458}, \'multiverseid\': 493458}, {\'name\': \'소강마도사의 소환수\', \'text\': \'{T}: {G} 또는 {U}를 추가한다.\\n당신이 키커 비용이 지불된 주문을 발동할 때마다, 당신은 생명 2점을 얻는다.\', \'type\': \'생물 — 야수\', \'flavor\': \'"저것들은 특별한 위장에 에너지를 저장해 . . . 하지만 보아하니 내가 내장 얘기를 늘어놓기보단 이 길을 뚫어 주기를 바라는 것 같군."\\n—탐험 마법사, 파하르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493774&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'21feb9fc-4a50-4215-bec3-d3b15373a4cb\', \'multiverseId\': 493774}, \'multiverseid\': 493774}, {\'name\': \'Familiar do Mago Anulador\', \'text\': \'{T}: Adicione {G} ou {U}.\\nToda vez que conjura uma mágica reforçada, você ganha 2 pontos de vida.\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Eles armazenam energia em órgãos gástricos especiais... mas acho que vocês preferem que eu abra o caminho em vez de ficar falando de tripa."\\n— Fahar, mago da expedição\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494090&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b97d4bc3-1a3f-4aa1-8edc-1fcc788ca375\', \'multiverseId\': 494090}, \'multiverseid\': 494090}, {\'name\': \'Питомец Мага-Баюна\', \'text\': \'{T}: добавьте {G} или {U}.\\nКаждый раз, когда вы разыгрываете заклинание, получившее Усилитель, вы получаете 2 жизни.\', \'type\': \'Существо — Зверь\', \'flavor\': \'«Они запасают энергию в особом органе в брюшной полости... но вы, наверное, хотите, чтобы я расчистил путь, а не рассуждал о кишках».\\n— Фахар, чародей экспедиции\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494406&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d99c7903-4c58-47b4-9958-8c6c2134e91b\', \'multiverseId\': 494406}, \'multiverseid\': 494406}, {\'name\': \'息法师佣兽\', \'text\': \'{T}：加{G}或{U}。\\n每当你施放已增幅的咒语时，你获得2点生命。\', \'type\': \'生物 ～野兽\', \'flavor\': \'「它们会用特殊的胃来储存能量. . .但我想你应该会让我来替你开路，而不是鼓起胆量自己领头。」\\n～探险队法师伐赫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494722&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'32ff6821-918c-41ab-86cf-435d60285f5a\', \'multiverseId\': 494722}, \'multiverseid\': 494722}, {\'name\': \'息法師傭獸\', \'text\': \'{T}：加{G}或{U}。\\n每當你施放已增幅的咒語時，你獲得2點生命。\', \'type\': \'生物 ～野獸\', \'flavor\': \'「牠們會用特殊的胃來儲存能量. . .但我想你應該會讓我來替你開路，而不是鼓起膽量自己領頭。」\\n～探險隊法師伐赫\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495038&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6b8093c4-1e7a-4df4-b5bd-176eada6ecb7\', \'multiverseId\': 495038}, \'multiverseid\': 495038}]', '[{\'name\': \'Verwickeltes Dilemma\', \'text\': \'Wenn das Verwickelte Dilemma ins Spiel kommt, ziehe eine Karte.\\nImmer wenn ein Land unter der Kontrolle eines Gegners ins Spiel kommt und falls in diesem Zug bereits ein anderes Land unter der Kontrolle des Spielers ins Spiel gekommen ist, bringt er ein Land, das er kontrolliert, auf die Hand seines Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491997&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ce9c3e9-c2ff-4ab9-afe4-fac24618bb74\', \'multiverseId\': 491997}, \'multiverseid\': 491997}, {\'name\': \'Enigma confuso\', \'text\': \'Cuando el Enigma confuso entre al campo de batalla, roba una carta.\\nSiempre que una tierra entre al campo de batalla bajo el control de un oponente, si ese jugador hizo que otra tierra entrase al campo de batalla bajo su control este turno, regresa una tierra que controla a la mano de su propietario.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492313&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a62d9c7-bed9-4c6a-8b83-328aac7cf16a\', \'multiverseId\': 492313}, \'multiverseid\': 492313}, {\'name\': \'Énigme déroutante\', \'text\': "Quand l\'Énigme déroutante arrive sur le champ de bataille, piochez une carte.\\nÀ chaque fois qu\'un terrain arrive sur le champ de bataille sous le contrôle d\'un adversaire, si ce joueur avait fait arriver un autre terrain sur le champ de bataille sous son contrôle ce tour-ci, il renvoie un terrain qu\'il contrôle dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492629&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f96e910a-c903-4ad7-9f3d-de4b3ad80224\', \'multiverseId\': 492629}, \'multiverseid\': 492629}, {\'name\': \'Dilemma Disorientante\', \'text\': "Quando il Dilemma Disorientante entra nel campo di battaglia, pesca una carta.\\nOgniqualvolta una terra entra nel campo di battaglia sotto il controllo di un avversario, se quel giocatore ha fatto entrare nel campo di battaglia un\'altra terra sotto il suo controllo in questo turno, quel giocatore fa tornare una terra che controlla in mano al suo proprietario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492945&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78b9dfc1-a38c-4ed6-916b-47269833471f\', \'multiverseId\': 492945}, \'multiverseid\': 492945}, {\'name\': \'当惑させる難題\', \'text\': \'当惑させる難題が戦場に出たとき、カードを１枚引く。\\n土地が１つ対戦相手のコントロール下で戦場に出るたび、そのプレイヤーがこのターンに自分のコントロール下で他の土地を戦場に出していた場合、そのプレイヤーは自分がコントロールしている土地１つをオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493261&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ef2e688-60f1-4fdf-a418-70f9b7bda294\', \'multiverseId\': 493261}, \'multiverseid\': 493261}, {\'name\': \'당혹스러운 난문제\', \'text\': \'당혹스러운 난문제가 전장에 들어올 때, 카드 한 장을 뽑는다.\\n대지가 상대의 조종하에 전장에 들어올 때마다, 그 플레이어가 이 턴에 다른 대지를 전장에 들어오게 했다면, 그 플레이어는 자신이 조종하는 대지 한 개를 소유자의 손으로 되돌린다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493577&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7a603db0-4c12-4895-b08e-b758a2a223cf\', \'multiverseId\': 493577}, \'multiverseid\': 493577}, {\'name\': \'Dilema Confuso\', \'text\': \'Quando Dilema Confuso entrar no campo de batalha, compre um card.\\nToda vez que um terreno entra no campo de batalha sob o controle de um oponente, se outro terreno entrou no campo de batalha sob o controle daquele jogador neste turno, aquele jogador devolve um terreno que controla para a mão de seu dono.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493893&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'062683e8-70c0-40b4-aa69-50729f215fbb\', \'multiverseId\': 493893}, \'multiverseid\': 493893}, {\'name\': \'Хитроумная Головоломка\', \'text\': \'Когда Хитроумная Головоломка выходит на поле битвы, возьмите карту.\\nКаждый раз, когда земля выходит на поле битвы под контролем оппонента, если в этом ходу под контролем того игрока уже выходила на поле битвы другая земля, он возвращает землю под своим контролем в руку ее владельца.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494209&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2f389a42-4da4-4e0a-a1b5-c10cdb72d37d\', \'multiverseId\': 494209}, \'multiverseid\': 494209}, {\'name\': \'混乱谜团\', \'text\': \'当混乱谜团进战场时，抓一张牌。\\n每当一个地在任一对手的操控下进战场时，若该牌手本回合中有另一个地在其操控下进战场，则他将一个由他操控的地移回其拥有者手上。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494525&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd137e9e-faf6-470f-ba4e-a8c267e9bc78\', \'multiverseId\': 494525}, \'multiverseid\': 494525}, {\'name\': \'混亂謎團\', \'text\': \'當混亂謎團進戰場時，抽一張牌。\\n每當一個地在任一對手的操控下進戰場時，若該玩家本回合中有另一個地在其操控下進戰場，則他將一個由他操控的地移回其擁有者手上。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494841&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b67cbc16-c9ed-454d-a65d-b291bf20105c\', \'multiverseId\': 494841}, \'multiverseid\': 494841}]', '[{\'name\': \'Verwickeltes Dilemma\', \'text\': \'Wenn das Verwickelte Dilemma ins Spiel kommt, ziehe eine Karte.\\nImmer wenn ein Land unter der Kontrolle eines Gegners ins Spiel kommt und falls in diesem Zug bereits ein anderes Land unter der Kontrolle des Spielers ins Spiel gekommen ist, bringt er ein Land, das er kontrolliert, auf die Hand seines Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495682&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'19c25a13-1d98-4c33-bbac-db7a32d06244\', \'multiverseId\': 495682}, \'multiverseid\': 495682}, {\'name\': \'Énigme déroutante\', \'text\': "Quand l\'Énigme déroutante arrive sur le champ de bataille, piochez une carte.\\nÀ chaque fois qu\'un terrain arrive sur le champ de bataille sous le contrôle d\'un adversaire, si ce joueur avait fait arriver un autre terrain sur le champ de bataille sous son contrôle ce tour-ci, il renvoie un terrain qu\'il contrôle dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495757&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23f52df9-d5b4-4e93-bb10-9227f7dba89c\', \'multiverseId\': 495757}, \'multiverseid\': 495757}, {\'name\': \'当惑させる難題\', \'text\': \'当惑させる難題が戦場に出たとき、カードを１枚引く。\\n土地が１つ対戦相手のコントロール下で戦場に出るたび、そのプレイヤーがこのターンに自分のコントロール下で他の土地を戦場に出していた場合、そのプレイヤーは自分がコントロールしている土地１つをオーナーの手札に戻す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495832&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e8d4e0ff-fdd2-4eaf-bf9f-8d1f8e9d092f\', \'multiverseId\': 495832}, \'multiverseid\': 495832}]', '[{\'name\': \'Vorhut aus Goma Fada\', \'text\': \'Immer wenn die Vorhut aus Goma Fada angreift, kann eine Kreatur deiner Wahl, die ein Gegner kontrolliert, und deren Stärke kleiner oder gleich der Anzahl an Kriegern ist, die du kontrollierst, in diesem Zug nicht blocken.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Ihre Waffe ist beeindruckend, das stimmt. Aber du solltest sehen, wie sie sie führt."\\n—Gred, Krieger der Expedition\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492097&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8163478e-a412-401b-970f-476f376b30b3\', \'multiverseId\': 492097}, \'multiverseid\': 492097}, {\'name\': \'Vanguardia de Goma Fada\', \'text\': \'Siempre que la Vanguardia de Goma Fada ataque, la criatura objetivo que controla un oponente con fuerza menor o igual a la cantidad de Guerreros que controlas no puede bloquear este turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Su arma impresiona, sí. Pero tienes que verla blandiéndola".\\n—Gred, guerrero de expedición\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492413&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aabf5773-cb1c-475e-81d8-f9d1f9f508a8\', \'multiverseId\': 492413}, \'multiverseid\': 492413}, {\'name\': \'Avant-garde de Goma Fada\', \'text\': "À chaque fois que l\'Avant-garde de Goma Fada attaque, une créature ciblée qu\'un adversaire contrôle de force inférieure ou égale au nombre de guerriers que vous contrôlez ne peut pas bloquer ce tour-ci.", \'type\': \'Créature : humain et guerrier\', \'flavor\': "« Son arme est impressionnante, c\'est vrai. Mais attendez de la voir la manier. »\\n—Gred, guerrier d\'expédition", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492729&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9004272-5f03-4075-b3f2-7cf575b4d63f\', \'multiverseId\': 492729}, \'multiverseid\': 492729}, {\'name\': \'Avanguardia di Goma Fada\', \'text\': "Ogniqualvolta l\'Avanguardia di Goma Fada attacca, una creatura bersaglio controllata da un avversario con forza pari o inferiore al numero di Guerrieri che controlli non può bloccare in questo turno.", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"La sua arma è impressionante, certo. Ma dovresti vedere come la maneggia."\\n—Gred, guerriero della spedizione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acca263a-4e5d-4e5e-a67e-a424af9b0881\', \'multiverseId\': 493045}, \'multiverseid\': 493045}, {\'name\': \'ゴーマ・ファーダの先兵\', \'text\': \'ゴーマ・ファーダの先兵が攻撃するたび、対戦相手がコントロールしていて、あなたがコントロールしている戦士の総数以下のパワーを持つクリーチャー１体を対象とする。このターン、それではブロックできない。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「彼女の武器はもちろん印象的だ。だが、彼女があれを使っているところも見るべきだね。」\\n――探検隊の戦士、グレド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493361&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'117d0c08-efd0-4bbf-be4d-5e994336cc16\', \'multiverseId\': 493361}, \'multiverseid\': 493361}, {\'name\': \'고마 파다 선봉대\', \'text\': \'고마 파다 선봉대가 공격할 때마다, 상대가 조종하는 생물 중 공격력이 당신이 조종하는 전사의 수 이하인 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"그녀의 무기가 인상적이긴 하지, 맞아. 하지만 봐야 하는 건 그녀가 무기를 휘두르는 모습이야."\\n—탐험 전사, 그레드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493677&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a47376d3-0ec0-4923-a723-92f37bd133de\', \'multiverseId\': 493677}, \'multiverseid\': 493677}, {\'name\': \'Vanguarda de Goma Fada\', \'text\': \'Toda vez que Vanguarda de Goma Fada ataca, a criatura alvo que um oponente controla com poder igual ou inferior ao número de Guerreiros que você controla não pode bloquear neste turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Sua arma é impressionante, com certeza. Mas você precisa ver como ela a empunha."\\n— Gred, guerreiro da expedição\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493993&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f85f1bf-854a-4e8c-923f-93833a97662f\', \'multiverseId\': 493993}, \'multiverseid\': 493993}, {\'name\': \'Авангард Гома-Фада\', \'text\': \'Каждый раз, когда Авангард Гома-Фада атакует, целевое существо под контролем оппонента, значение силы которого меньше или равно количеству Воинов под вашим контролем, не может блокировать в этом ходу.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Да, оружие у нее очень впечатляющее. Ты бы еще видел, как она им орудует».\\n— Гред, воин экспедиции\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494309&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'505930d0-b2a2-46fb-a298-737ac36477a4\', \'multiverseId\': 494309}, \'multiverseid\': 494309}, {\'name\': \'哥马法达先锋\', \'text\': \'每当哥马法达先锋攻击时，选择目标由对手操控且力量等于或小于由你操控之战士数量的生物。该生物本回合不能进行阻挡。\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'「没错，她的武器确实令人眼前一亮。但你更该看看她挥舞时的样子。」\\n～探险队战士格雷德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494625&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'92adae08-791c-4742-ad98-c045d1d99650\', \'multiverseId\': 494625}, \'multiverseid\': 494625}, {\'name\': \'哥馬法達先鋒\', \'text\': \'每當哥馬法達先鋒攻擊時，選擇目標由對手操控且力量等於或小於由你操控之戰士數量的生物。該生物本回合不能進行阻擋。\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'「沒錯，她的武器確實令人眼前一亮。但你更該看看她揮舞時的樣子。」\\n～探險隊戰士格雷德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494941&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ba1642c2-4e46-4f80-a4db-1f7d79c74909\', \'multiverseId\': 494941}, \'multiverseid\': 494941}]', '[{\'name\': \'Vorreiter aus Kabira\', \'text\': \'Wenn der Vorreiter aus Kabira ins Spiel kommt, erhält eine Kreatur deiner Wahl für jede Kreatur in deiner Abenteurergruppe +1/+1 bis zum Ende des Zuges. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Die Moas aus Ondu sind sehr unbequeme Reittiere, aber für entschlossene Krieger zählt nur ihre Geschwindigkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491956&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4d0d8c6-2fcc-466f-81ff-b55be563eac3\', \'multiverseId\': 491956}, \'multiverseid\': 491956}, {\'name\': \'Pionero de Kabira\', \'text\': \'Cuando el Pionero de Kabira entre al campo de batalla, la criatura objetivo obtiene +1/+1 hasta el final del turno por cada criatura en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Las moas de Ondu son monturas de lo más incómodas, pero para los guerreros decididos, su velocidad lo compensa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b8a7f59-c652-48f8-b730-4a762b6e3e9a\', \'multiverseId\': 492272}, \'multiverseid\': 492272}, {\'name\': \'Cavalier de Kabira\', \'text\': "Quand le Cavalier de Kabira arrive sur le champ de bataille, une créature ciblée gagne +1/+1 jusqu\'à la fin du tour pour chaque créature dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'Les moas du Ondou sont des montures très inconfortables, mais pour les guerriers les plus déterminés, leur vitesse compense largement ce désagrément.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492588&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'86db6bfe-6e1a-4136-a5f2-3aea87b1d8c2\', \'multiverseId\': 492588}, \'multiverseid\': 492588}, {\'name\': \'Apripista di Kabira\', \'text\': "Quando l\'Apripista di Kabira entra nel campo di battaglia, una creatura bersaglio prende +1/+1 fino alla fine del turno per ogni creatura nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)", \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'I moa di Ondu sono cavalcature tremendamente scomode ma, per i guerrieri determinati, la loro velocità è sufficiente a compensare questo inconveniente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492904&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d9fb2fe-c2c0-4cf1-b53e-a73ec40aa3c5\', \'multiverseId\': 492904}, \'multiverseid\': 492904}, {\'name\': \'カビーラの先導\', \'text\': \'カビーラの先導が戦場に出たとき、クリーチャー１体を対象とする。ターン終了時まで、それはあなたのパーティーを構成しているクリーチャー１体につき＋１/＋１の修整を受ける。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'オンドゥの恐鳥は荒っぽく乗り心地が悪いが、血気盛んな戦士にとっては、その速度は欠点を補って余りある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493220&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c63e69c-6dfa-441b-b325-6288edcbb63a\', \'multiverseId\': 493220}, \'multiverseid\': 493220}, {\'name\': \'카비라 선두 기수\', \'text\': \'카비라 선두 기수가 전장에 들어올 때, 생물을 목표로 정한다. 그 생물은 턴종료까지 당신의 파티에 있는 각 생물마다 +1/+1을 받는다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'온두의 모아는 엄청나게 불편한 탈것이지만, 신념을 가진 전사들에게는 모아의 속도가 이를 상쇄해 준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493536&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'99dffa73-b672-4d7c-a636-91c58b7febe5\', \'multiverseId\': 493536}, \'multiverseid\': 493536}, {\'name\': \'Vanguardeiro de Kabira\', \'text\': \'Quando Vanguardeiro de Kabira entra no campo de batalha, a criatura alvo recebe +1/+1 até o final do turno para cada criatura em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'As moas de Ondu são montarias bem desconfortáveis, mas para os guerreiros determinados, sua velocidade compensa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493852&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eaf02f81-7fc1-441d-84e1-23280f7ba6ff\', \'multiverseId\': 493852}, \'multiverseid\': 493852}, {\'name\': \'Кабирский Наездник\', \'text\': \'Когда Кабирский Наездник выходит на поле битвы, целевое существо получает +1/+1 до конца хода за каждое существо в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Моа из Онду — своенравные птицы, и скакать на них верхом — то еще удовольствие, но для самых устремленных воинов их скорость с лихвой перекрывает все недостатки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494168&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aaae4bd6-0521-4af8-aacd-81fe88763927\', \'multiverseId\': 494168}, \'multiverseid\': 494168}, {\'name\': \'卡彼拉前导兵\', \'text\': \'当卡彼拉前导兵进战场时，你冒险团中每有一个生物，目标生物便得+1/+1直到回合结束。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'虽然昂度恐鸟骑乘起来非常难受，但在专职战士眼中，它们的速度足以弥补这缺点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494484&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f8a4508b-6921-4e5b-9edc-c86110c59c31\', \'multiverseId\': 494484}, \'multiverseid\': 494484}, {\'name\': \'卡彼拉前導兵\', \'text\': \'當卡彼拉前導兵進戰場時，你冒險團中每有一個生物，目標生物便得+1/+1直到回合結束。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'雖然昂度恐鳥騎乘起來非常難受，但在專職戰士眼中，牠們的速度足以彌補這缺點。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494800&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'45eaac57-3ef8-4543-972c-475c48d82eef\', \'multiverseId\': 494800}, \'multiverseid\': 494800}]', '[{\'name\': \'Wahrsagerin der Expedition\', \'text\': \'Fliegend\\nSolange du einen anderen Zauberer kontrollierst, hat die Wahrsagerin der Expedition „Wenn diese Kreatur stirbt, ziehe eine Karte."\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Die Sprüche der Zauberer verdrehen die Struktur der Realität, um elementare Energien zu kanalisieren, in die Zukunft zu blicken und sogar die Turbulenz zu beruhigen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492001&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0dfebd74-89c4-4aab-9876-951c1272a75a\', \'multiverseId\': 492001}, \'multiverseid\': 492001}, {\'name\': \'Adivina de la expedición\', \'text\': \'Vuela.\\nMientras controles otro Hechicero, la Adivina de la expedición tiene "Cuando esta criatura muera, roba una carta".\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'La magia de los hechiceros distorsiona la estructura de la realidad con tal de canalizar energías elementales, prever el futuro e incluso calmar la Turbulencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492317&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba006861-b877-4475-aba9-07718c86a048\', \'multiverseId\': 492317}, \'multiverseid\': 492317}, {\'name\': "Devineresse d\'expédition", \'text\': "Vol\\nTant que vous contrôlez un autre sorcier, la Devineresse d\'expédition a « Quand cette créature meurt, piochez une carte. »", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "Les sorciers déforment la réalité grâce à leurs sorts pour canaliser les énergies élémentaires, lire l\'avenir et même calmer le Roulis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492633&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'494e636f-4ef5-44bb-90b0-ea0f34909ec4\', \'multiverseId\': 492633}, \'multiverseid\': 492633}, {\'name\': \'Divinatrice della Spedizione\', \'text\': \'Volare\\nFintanto che controlli un altro Mago, la Divinatrice della Spedizione ha "Quando questa creatura muore, pesca una carta".\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'Gli incantesimi dei maghi ritorcono il tessuto della realtà per incanalare energie elementali, vedere nel futuro e perfino calmare il Torbido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492949&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef7b3f45-c4e3-4693-a708-06fe0019a295\', \'multiverseId\': 492949}, \'multiverseid\': 492949}, {\'name\': \'探検隊の占者\', \'text\': \'飛行\\nあなたが他のウィザードをコントロールしているかぎり、探検隊の占者は「このクリーチャーが死亡したとき、カードを１枚引く。」を持つ。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'魔術師の呪文は現実の織り目を捻じ曲げて自然界のエネルギーと繋がり、未来を覗き乱動をも鎮める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493265&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa27cc2a-301f-4b06-87b6-353c045495ac\', \'multiverseId\': 493265}, \'multiverseid\': 493265}, {\'name\': \'탐험 역술가\', \'text\': \'비행\\n당신이 다른 마법사를 조종하는 한, 탐험 역술가는 "이 생물이 죽을 때, 카드 한 장을 뽑는다."를 가진다.\', \'type\': \'생물 — 인어 마법사\', \'flavor\': \'마법사들의 주문은 정령들의 에너지를 끌어들이고, 미래를 엿보며, 탁류를 진정시키기 위해 현실을 비틀어낸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493581&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'442107b4-4169-4ef7-a73a-5913e9f14122\', \'multiverseId\': 493581}, \'multiverseid\': 493581}, {\'name\': \'Adivinha da Expedição\', \'text\': \'Voar\\nEnquanto você controla outro Mago, Adivinha da Expedição tem "Quando esta criatura morrer, compre um card".\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'As mágicas dos magos distorcem o tecido da realidade para canalizar energias elementais, vislumbrar o futuro e até mesmo acalmar o Turbilhão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493897&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e254c1e-5d2d-4658-9da4-e43a9670a3fc\', \'multiverseId\': 493897}, \'multiverseid\': 493897}, {\'name\': \'Предсказательница Экспедиции\', \'text\': \'Полет\\nПока вы контролируете другого Чародея, Предсказательница Экспедиции имеет способность «Когда это существо умирает, возьмите карту».\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Заклинания чародеев меняют ткань реальности, чтобы укротить стихийную энергию, заглянуть в будущее и даже успокоить Великий Вал.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494213&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'01672a23-d9f9-44a9-b052-4b64a35d2939\', \'multiverseId\': 494213}, \'multiverseid\': 494213}, {\'name\': \'探险队占卜师\', \'text\': \'飞行\\n只要你操控另一个法术师，探险队占卜师便具有「当此生物死去时，抓一张牌。」\', \'type\': \'生物 ～人鱼／法术师\', \'flavor\': \'法师咒语能够扭曲现实束缕，从而通联元素能量、窥见未来世界，甚或平息暴怒狂搅。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494529&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab956f36-28f5-4aec-b666-64ec04935be5\', \'multiverseId\': 494529}, \'multiverseid\': 494529}, {\'name\': \'探險隊占卜師\', \'text\': \'飛行\\n只要你操控另一個魔法師，探險隊占卜師便具有「當此生物死去時，抽一張牌。」\', \'type\': \'生物 ～人魚／魔法師\', \'flavor\': \'法師咒語能夠扭曲現實束縷，從而通聯元素能量、窺見未來世界，甚或平息暴怒狂攪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494845&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'92a51c5f-1db8-4ae9-863c-81ad46b826f2\', \'multiverseId\': 494845}, \'multiverseid\': 494845}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492251&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f71eff23-50ed-4f46-a795-b16d64409f9b', 'multiverseId': 492251}, 'multiverseid': 492251}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492567&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '90e7cdf4-21c2-45e8-bc63-33c3a3f637a2', 'multiverseId': 492567}, 'multiverseid': 492567}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492883&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2f200870-0e0b-433f-aefd-bb8e3edd7d65', 'multiverseId': 492883}, 'multiverseid': 492883}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493199&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4ee717e4-26e8-40b2-bb46-123c1eb04815', 'multiverseId': 493199}, 'multiverseid': 493199}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493515&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a3300145-8b03-484a-9d0d-3d842c97a74c', 'multiverseId': 493515}, 'multiverseid': 493515}, {'name': 'Floresta', 'type':