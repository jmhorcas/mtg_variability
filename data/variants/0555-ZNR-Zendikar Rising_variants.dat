l': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494136&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '41828b58-aff6-4508-897a-a9f800fc6071', 'multiverseId': 494136}, 'multiverseid': 494136}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494452&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cebe593f-15e2-435b-9899-ab21296e8754', 'multiverseId': 494452}, 'multiverseid': 494452}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494768&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5c410691-5e43-4be8-ae12-106290427d95', 'multiverseId': 494768}, 'multiverseid': 494768}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495084&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '93b386bb-6b14-4588-af2f-072028f35e0c', 'multiverseId': 495084}, 'multiverseid': 495084}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492241&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0b277860-cbe7-4c8e-a51d-3d76d859bf20', 'multiverseId': 492241}, 'multiverseid': 492241}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492557&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '04af343a-1b1d-4d21-988f-bb3c7b8d9b2c', 'multiverseId': 492557}, 'multiverseid': 492557}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492873&type=card', 'language': 'French', 'identifiers': {'scryfallId': '29224433-7c56-439a-a4ba-ef720fedffd5', 'multiverseId': 492873}, 'multiverseid': 492873}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493189&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4a060b25-236b-4289-a8b3-67fb3fcd3e5a', 'multiverseId': 493189}, 'multiverseid': 493189}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493505&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '16945e7f-697a-4da2-a1ff-92d59d653a99', 'multiverseId': 493505}, 'multiverseid': 493505}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493821&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '85662a30-eb99-493e-9973-578969c39f71', 'multiverseId': 493821}, 'multiverseid': 493821}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494137&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'aecbc843-c9e8-409d-b91a-1815da8c4f56', 'multiverseId': 494137}, 'multiverseid': 494137}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494453&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b6f48b9b-6b9c-4337-bed8-f5e767f4d010', 'multiverseId': 494453}, 'multiverseid': 494453}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494769&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2149b98f-efb6-485a-9a5a-94a2704b6be7', 'multiverseId': 494769}, 'multiverseid': 494769}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495085&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '7c8ec889-f769-46aa-be29-27668210dace', 'multiverseId': 495085}, 'multiverseid': 495085}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495103&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f036939a-1f3e-4a55-90f8-984daddd9c21', 'multiverseId': 495103}, 'multiverseid': 495103}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495113&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'da2b83db-4fea-4255-a962-1072c842129b', 'multiverseId': 495113}, 'multiverseid': 495113}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495118&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5b1f3f98-55c7-495a-9062-d589223f426b', 'multiverseId': 495118}, 'multiverseid': 495118}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495123&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '25212a1b-363c-4034-831c-af4f73ecc144', 'multiverseId': 495123}, 'multiverseid': 495123}, {'name': '들', 'type': '기본 대지 — 들', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495128&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4c482bcd-5b7e-423a-a56c-d929b73e5f89', 'multiverseId': 495128}, 'multiverseid': 495128}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495133&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db36118a-c4c6-4b42-b9ae-07ee8d092d0d', 'multiverseId': 495133}, 'multiverseid': 495133}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495138&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1fb67e32-8452-4615-8463-1e6dcf42a7db', 'multiverseId': 495138}, 'multiverseid': 495138}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495143&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aa3af571-a52b-40be-bd63-763e3e81660b', 'multiverseId': 495143}, 'multiverseid': 495143}, {'name': '平原', 'type': '基本地 ～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495148&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c50ae4a8-a850-46de-bf40-4a7a997d97d4', 'multiverseId': 495148}, 'multiverseid': 495148}]", '[{\'name\': \'Eingeübte Taktik\', \'text\': \'Bestimme eine angreifende oder blockende Kreatur deiner Wahl. Die Eingeübte Taktik fügt der Kreatur Schadenspunkte in Höhe der doppelten Anzahl an Kreaturen in deiner Abenteurergruppe zu. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\', \'type\': \'Spontanzauber\', \'flavor\': \'Jeder Einzelne hat seine entscheidende Rolle zu spielen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491973&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c561d83d-2008-4f53-85f9-0ea0ca43f225\', \'multiverseId\': 491973}, \'multiverseid\': 491973}, {\'name\': \'Tácticas ensayadas\', \'text\': \'Elige la criatura atacante o bloqueadora objetivo. Las Tácticas ensayadas hacen una cantidad de daño igual al doble de la cantidad de criaturas en tu grupo a esa criatura. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\', \'type\': \'Instantáneo\', \'flavor\': \'Cada uno tiene un papel esencial que cumplir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492289&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'024ce2db-3d2d-446c-884e-82f7a649853c\', \'multiverseId\': 492289}, \'multiverseid\': 492289}, {\'name\': \'Tactique maîtrisée\', \'text\': "Choisissez une créature attaquante ou bloqueuse ciblée. La Tactique maîtrisée inflige à cette créature un nombre de blessures égal au double du nombre de créatures dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)", \'type\': \'Éphémère\', \'flavor\': \'Chaque individu a un rôle crucial à jouer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492605&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a4ea908-7c77-4307-92a2-5c36b6591b78\', \'multiverseId\': 492605}, \'multiverseid\': 492605}, {\'name\': \'Tattiche Perfezionate\', \'text\': \'Scegli una creatura attaccante o bloccante bersaglio. Le Tattiche Perfezionate infliggono a quella creatura danno pari al doppio del numero di creature nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\', \'type\': \'Istantaneo\', \'flavor\': \'Ogni individuo ha un ruolo cruciale da svolgere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492921&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'14bffd88-4a27-44fb-b026-cc0da7091a50\', \'multiverseId\': 492921}, \'multiverseid\': 492921}, {\'name\': \'訓練された戦術\', \'text\': \'攻撃クリーチャー１体かブロック・クリーチャー１体を対象とする。訓練された戦術はそのクリーチャーに、あなたのパーティーを構成しているクリーチャーの総数の２倍に等しい点数のダメージを与える。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\', \'type\': \'インスタント\', \'flavor\': \'各自に果たすべき重要な役割がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493237&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84ce256b-af5e-4a13-a9a9-718169c73c09\', \'multiverseId\': 493237}, \'multiverseid\': 493237}, {\'name\': \'훈련한 전술\', \'text\': \'공격 중이거나 방어 중인 생물을 목표로 정한다. 훈련한 전술은 그 생물에게 당신의 파티에 있는 생물 수의 두 배만큼 피해를 입힌다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\', \'type\': \'순간마법\', \'flavor\': \'개개인에게는 각자 행해야 할 중요한 역할이 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493553&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'584f7f0a-97c9-4eb0-9457-3230d20857b1\', \'multiverseId\': 493553}, \'multiverseid\': 493553}, {\'name\': \'Táticas Praticadas\', \'text\': \'Escolha a criatura atacante ou bloqueadora alvo. Táticas Praticadas causa àquela criatura uma quantidade de dano igual a duas vezes o número de criaturas em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Cada indivíduo tem seu próprio papel crucial a desempenhar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f20b895-0e85-4d6c-895a-8182873e80f6\', \'multiverseId\': 493869}, \'multiverseid\': 493869}, {\'name\': \'Отработанная Тактика\', \'text\': \'Выберите целевое атакующее или блокирующее существо. Отработанная Тактика наносит тому существу повреждения, равные удвоенному количеству существ в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Каждый здесь играет свою критическую роль.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494185&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb0c2e07-0b90-407b-a183-eb2f2c26c80e\', \'multiverseId\': 494185}, \'multiverseid\': 494185}, {\'name\': \'熟练战法\', \'text\': \'选择目标进行攻击或阻挡的生物。熟练战法对该生物造成伤害，其数量等同于你冒险团中生物数量的两倍。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\', \'type\': \'瞬间\', \'flavor\': \'每个人都是团队不可或缺的一份子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494501&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce9c8104-ca1d-4892-a85d-d7b82d33e6b0\', \'multiverseId\': 494501}, \'multiverseid\': 494501}, {\'name\': \'熟練戰法\', \'text\': \'選擇目標進行攻擊或阻擋的生物。熟練戰法對該生物造成傷害，其數量等同於你冒險團中生物數量的兩倍。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\', \'type\': \'瞬間\', \'flavor\': \'每個人都是團隊不可或缺的一份子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494817&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b9e8a30-019c-4573-bf1a-2038fa0f86fe\', \'multiverseId\': 494817}, \'multiverseid\': 494817}]', '[{\'name\': \'Einvernehmliche Verteidigung\', \'text\': \'Neutralisiere einen Nichtkreatur-Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {1} plus zusätzlich {1} für jede Kreatur in deiner Abenteurergruppe. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wenn du dich mit einem von uns anlegst, bekommst du es mit uns allen zu tun!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491996&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b2765483-788c-4a22-9b27-e414e26d5fee\', \'multiverseId\': 491996}, \'multiverseid\': 491996}, {\'name\': \'Defensa coordinada\', \'text\': \'Contrarresta el hechizo objetivo que no sea de criatura a menos que su controlador pague {1} más {1} adicional por cada criatura en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Si te metes con uno de los nuestros, te metes con todos!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492312&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae41bf00-8ab7-428e-bf67-a32175f0591b\', \'multiverseId\': 492312}, \'multiverseid\': 492312}, {\'name\': \'Défense concertée\', \'text\': "Contrecarrez un sort non-créature ciblé à moins que son contrôleur ne paie {1}, plus {1} supplémentaire pour chaque créature dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)", \'type\': \'Éphémère\', \'flavor\': "« S\'en prendre à l\'un d\'entre nous, c\'est s\'en prendre à nous tous ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492628&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b83bfc85-8f1e-4a71-a029-7371669cea3c\', \'multiverseId\': 492628}, \'multiverseid\': 492628}, {\'name\': \'Difesa Coordinata\', \'text\': \'Neutralizza una magia non creatura bersaglio a meno che il suo controllore non paghi {1} più {1} addizionale per ogni creatura nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\', \'type\': \'Istantaneo\', \'flavor\': \'"Se ti metti contro uno di noi, dovrai vedertela con tutti noi!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492944&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea7b2613-4499-46e3-a3d1-5cbad9093f58\', \'multiverseId\': 492944}, \'multiverseid\': 492944}, {\'name\': \'一枚岩の防衛\', \'text\': \'クリーチャーでない呪文１つを対象とする。それのコントローラーが、{1}に加えてあなたのパーティーを構成しているクリーチャー１体につき追加の{1}を支払わないかぎり、それを打ち消す。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\', \'type\': \'インスタント\', \'flavor\': \'「私の仲間を侮辱することは、私たち全員を侮辱することよ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493260&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'06626544-519a-4dac-89e4-40a48f99cc2b\', \'multiverseId\': 493260}, \'multiverseid\': 493260}, {\'name\': \'합심한 방어\', \'text\': \'생물이 아닌 주문을 목표로 정한다. 그 주문의 조종자가 {1}에 더해 당신의 파티에 있는 각 생물마다 추가로 {1}을 지불하지 않는 한 그 주문을 무효화한다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\', \'type\': \'순간마법\', \'flavor\': \'"우리 중 하나를 건드리면, 우리 모두를 건드리는 거야!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493576&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fd44cc43-ae05-4659-9922-b1fc30aac33f\', \'multiverseId\': 493576}, \'multiverseid\': 493576}, {\'name\': \'Defesa Coordenada\', \'text\': \'Anule a mágica alvo que não seja de criatura, a menos que seu controlador pague {1} mais {1} adicional para cada criatura em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Mexeu com um, mexeu com todos nós!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493892&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33b3d568-cd20-4977-9e01-92e0682068bc\', \'multiverseId\': 493892}, \'multiverseid\': 493892}, {\'name\': \'Совместная Оборона\', \'text\': \'Отмените целевое не являющееся существом заклинание, если только контролирующий его игрок не заплатит {1} плюс еще по {1} за каждое существо в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Свяжешься с одним из нас — свяжешься со всеми!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494208&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f1ee611e-46d1-4c1e-b92d-580141f10e09\', \'multiverseId\': 494208}, \'multiverseid\': 494208}, {\'name\': \'协力防御\', \'text\': \'除非目标非生物咒语的操控者支付{1}，并为你冒险团中的每个生物各支付{1}，否则反击之。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\', \'type\': \'瞬间\', \'flavor\': \'「惹到其中一个，便是惹到所有人！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494524&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'abf7c5b4-c916-4726-83da-dfd7be509dd4\', \'multiverseId\': 494524}, \'multiverseid\': 494524}, {\'name\': \'協力防禦\', \'text\': \'除非目標非生物咒語的操控者支付{1}，並為你冒險團中的每個生物各支付{1}，否則反擊之。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\', \'type\': \'瞬間\', \'flavor\': \'「惹到其中一個，便是惹到所有人！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494840&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3fe6cc23-a244-4764-a706-686aeb6af5e5\', \'multiverseId\': 494840}, \'multiverseid\': 494840}]', '[{\'name\': \'Eiskalte Falle\', \'text\': \'Eine Kreatur deiner Wahl erhält -4/-0 bis zum Ende des Zuges. Falls du einen Zauberer kontrollierst, ziehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Geschieht dir recht, wenn du so schnell vorpreschst."\\n—Kaliea, Seetor-Fallensucherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491994&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a63892ee-21b9-42b1-b743-08c5b194cf84\', \'multiverseId\': 491994}, \'multiverseid\': 491994}, {\'name\': \'Trampa espeluznante\', \'text\': \'La criatura objetivo obtiene -4/-0 hasta el final del turno. Si controlas un Hechicero, roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Te lo mereces, por adelantarte".\\n—Kaliea, buscatrampas de Portal Marino\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492310&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bfe4bbfd-85e2-48dd-a448-880bf1b01611\', \'multiverseId\': 492310}, \'multiverseid\': 492310}, {\'name\': \'Piège glaçant\', \'text\': "Une créature ciblée gagne -4/-0 jusqu\'à la fin du tour. Si vous contrôlez un sorcier, piochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'« Ça vous apprendra à foncer tête baissée. »\\n—Kaliéa, pistrappeuse de Porte des Mers\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492626&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4990563-6324-4af8-adc6-80564c7a30eb\', \'multiverseId\': 492626}, \'multiverseid\': 492626}, {\'name\': \'Trappola Agghiacciante\', \'text\': \'Una creatura bersaglio prende -4/-0 fino alla fine del turno. Se controlli un Mago, pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ti sta bene per esserti precipitato avanti."\\n—Kaliea, scopritrappole di Portale Marino\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492942&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1745a040-ff40-49c8-958a-f125f3b94689\', \'multiverseId\': 492942}, \'multiverseid\': 492942}, {\'name\': \'凍える罠\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは－４/－０の修整を受ける。あなたがウィザードをコントロールしているなら、カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「先を急ぎすぎたことへの報いね。」\\n――海門の罠探し、ケイリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493258&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6a5a093f-4c30-4270-954e-0ee7e8f36598\', \'multiverseId\': 493258}, \'multiverseid\': 493258}, {\'name\': \'냉각 함정\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 -4/-0을 받는다. 당신이 마법사를 조종하고 있다면, 카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"서두르더니 꼴 한 번 좋군."\\n—바다 관문 함정수색꾼, 칼라이아\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493574&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d19ec62d-d190-4408-9815-2183be495c48\', \'multiverseId\': 493574}, \'multiverseid\': 493574}, {\'name\': \'Armadilha Geladora\', \'text\': \'A criatura alvo recebe -4/-0 até o final do turno. Se você controla um Mago, compre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Bem feito! Quem mandou se apressar?!"\\n— Kaliea, desarmadilheira de Portão Marinho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493890&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27a88b4f-fe09-4118-b4bb-bfed597142ba\', \'multiverseId\': 493890}, \'multiverseid\': 493890}, {\'name\': \'Леденящая Ловушка\', \'text\': \'Целевое существо получает -4/-0 до конца хода. Если у вас под контролем есть Чародей, возьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Так тебе и надо за то, что рвешься вперед».\\n— Кайлея, искательница ловушек из Мореграда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494206&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'60f958f0-1c47-469d-96e2-0e80a641a3a3\', \'multiverseId\': 494206}, \'multiverseid\': 494206}, {\'name\': \'冰寒陷阱\', \'text\': \'目标生物得-4/-0直到回合结束。如果你操控法术师，则抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「叫你往前冲，活该。」\\n～海户探陷人卡理耶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494522&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af44f55a-e74d-4352-b47d-00009774015e\', \'multiverseId\': 494522}, \'multiverseid\': 494522}, {\'name\': \'冰寒陷阱\', \'text\': \'目標生物得-4/-0直到回合結束。如果你操控魔法師，則抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「叫你往前衝，活該。」\\n～海戶探陷人卡理耶\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494838&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ea90d4fe-36df-4fd0-8335-80bd9e402aa1\', \'multiverseId\': 494838}, \'multiverseid\': 494838}]', '[{\'name\': \'Emerias Kapitänin\', \'text\': \'Fliegend, Wachsamkeit\\nWenn Emerias Kapitänin ins Spiel kommt, lege für jede Kreatur in deiner Abenteurergruppe eine +1/+1-Marke auf sie. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\', \'type\': \'Kreatur — Engel, Krieger\', \'flavor\': \'„Die Gaben der Vergangenheit müssen in würdige Hände gelangen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491948&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94a1b54e-7dea-40ba-ab51-9e0972c5f637\', \'multiverseId\': 491948}, \'multiverseid\': 491948}, {\'name\': \'Capitana de Emeria\', \'text\': \'Vuela, vigilancia.\\nCuando la Capitana de Emeria entre al campo de batalla, pon un contador +1/+1 sobre ella por cada criatura en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\', \'type\': \'Criatura — Guerrero ángel\', \'flavor\': \'"Los obsequios del pasado deben recaer en las manos de quienes los merezcan".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492264&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71f033de-9d52-49c6-8c04-3867d9ee26cd\', \'multiverseId\': 492264}, \'multiverseid\': 492264}, {\'name\': "Capitaine d\'Éméria", \'text\': "Vol, vigilance\\nQuand la Capitaine d\'Éméria arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle pour chaque créature dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)", \'type\': \'Créature : ange et guerrier\', \'flavor\': \'« Les cadeaux du passé doivent trouver le moyen de finir entre de bonnes mains. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492580&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'79bee929-12b4-4091-95b1-9cafabbe0450\', \'multiverseId\': 492580}, \'multiverseid\': 492580}, {\'name\': \'Capitana di Emeria\', \'text\': \'Volare, cautela\\nQuando la Capitana di Emeria entra nel campo di battaglia, metti un segnalino +1/+1 su di essa per ogni creatura nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\', \'type\': \'Creatura — Guerriero Angelo\', \'flavor\': \'"I doni del passato devono essere affidati a chi ne è degno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492896&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c0779f4-027d-47e3-a66c-bbdc4ce99b0c\', \'multiverseId\': 492896}, \'multiverseid\': 492896}, {\'name\': \'エメリアの隊長\', \'text\': \'飛行、警戒\\nエメリアの隊長が戦場に出たとき、これの上に＋１/＋１カウンターを、あなたのパーティーを構成しているクリーチャー１体につき１個置く。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\', \'type\': \'クリーチャー — 天使・戦士\', \'flavor\': \'「過去からの贈り物は相応しい受け手へと届けられるべきよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493212&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68b3bc1d-ba7d-43ae-94b5-fad0434c4d45\', \'multiverseId\': 493212}, \'multiverseid\': 493212}, {\'name\': \'에메리아 대장\', \'text\': \'비행, 경계\\n에메리아 대장이 전장에 들어올 때, 당신의 파티에 있는 각 생물 한 개당 에메리아 대장에 +1/+1 카운터 한 개를 올려놓는다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\', \'type\': \'생물 — 천사 전사\', \'flavor\': \'"과거가 주는 선물이 그들에게 합당한 길을 알려주리라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493528&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'55ed0207-0d99-4e96-8ad0-f4d997ee246a\', \'multiverseId\': 493528}, \'multiverseid\': 493528}, {\'name\': \'Capitã de Emeria\', \'text\': \'Voar, vigilância\\nQuando Capitã de Emeria entrar no campo de batalha, coloque um marcador +1/+1 nela para cada criatura em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\', \'type\': \'Criatura — Anjo Guerreiro\', \'flavor\': \'"As dádivas do passado precisam chegar a mãos que as mereçam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b333ae6d-973b-4f33-9680-672760fd3b03\', \'multiverseId\': 493844}, \'multiverseid\': 493844}, {\'name\': \'Капитан Эмерии\', \'text\': \'Полет, Бдительность\\nКогда Капитан Эмерии выходит на поле битвы, положите на него один жетон +1/+1 за каждое существо в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\', \'type\': \'Существо — Ангел Воин\', \'flavor\': \'«Дары прошлого должны попасть в достойные руки».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494160&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ee626a1-0fa0-4df1-a09e-fef8568bf2f2\', \'multiverseId\': 494160}, \'multiverseid\': 494160}, {\'name\': \'伊美黎队长\', \'text\': \'飞行，警戒\\n当伊美黎队长进战场时，你冒险团中每有一个生物，便在前者上放置一个+1/+1指示物。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\', \'type\': \'生物 ～天使／战士\', \'flavor\': \'「历史的赠礼，必须平安送抵应授之人手中。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494476&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'53b0da21-a6c4-4648-a76a-471c24a5b202\', \'multiverseId\': 494476}, \'multiverseid\': 494476}, {\'name\': \'伊美黎隊長\', \'text\': \'飛行，警戒\\n當伊美黎隊長進戰場時，你冒險團中每有一個生物，便在前者上放置一個+1/+1指示物。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\', \'type\': \'生物 ～天使／戰士\', \'flavor\': \'「歷史的贈禮，必須平安送抵應授之人手中。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494792&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e01742d3-c665-4430-bbb0-67f0cd967897\', \'multiverseId\': 494792}, \'multiverseid\': 494792}]', '[{\'name\': \'Emerias Ruf // Emeria, die zerstörte Himmelsfestung\', \'text\': \'Erzeuge zwei 4/4 weiße Engel-Krieger-Kreaturenspielsteine mit Flugfähigkeit. Nicht-Engel-Kreaturen, die du kontrollierst, erhalten Unzerstörbarkeit bis zu deinem nächsten Zug.\\nLand\\n{T}: Erzeuge {W}.\', \'type\': \'Hexerei\', \'flavor\': \'„Iona bewacht diesen Ort nicht mehr. Wir schon."\\n—Kasla, Emerias Hirtin\', \'faceName\': \'Emerias Ruf\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491949&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4042e563-2887-4fb5-bb18-90ee9392312b\', \'multiverseId\': 491949}, \'multiverseid\': 491949}, {\'name\': \'Llamada de Emeria // Emeria, aerorruina quebrada\', \'text\': \'Crea dos fichas de criatura Guerrero Ángel blancas 4/4 con la habilidad de volar. Las criaturas que no sean Ángel que controlas ganan la habilidad de indestructible hasta tu próximo turno.\\nTierra\\n{T}: Agrega {W}.\', \'type\': \'Conjuro\', \'flavor\': \'"Iona ya no protege este lugar, pero nosotras sí".\\n—Kasla, pastora de Emeria\', \'faceName\': \'Llamada de Emeria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43b5816b-f4e3-482f-b1ed-e8ace6447485\', \'multiverseId\': 492265}, \'multiverseid\': 492265}, {\'name\': "Appel d\'Éméria // Éméria, fort céleste fracassé", \'text\': "Créez deux jetons de créature 4/4 blanche Ange et Guerrier avec le vol. Les créatures non-Ange que vous contrôlez acquièrent l\'indestructible jusqu\'à votre prochain tour.\\nTerrain\\n{T} : Ajoutez {W}.", \'type\': \'Rituel\', \'flavor\': "« Cet endroit n\'est plus sous la protection d\'Iona, mais sous la nôtre. »\\n—Kasla, bergère d\'Éméria", \'faceName\': "Appel d\'Éméria", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492581&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8712666-e03a-4bdc-806d-fdb7a8d53986\', \'multiverseId\': 492581}, \'multiverseid\': 492581}, {\'name\': \'Richiamo di Emeria // Emeria, Enclave Celeste Frantumata\', \'text\': \'Crea due pedine creatura Guerriero Angelo 4/4 bianche con volare. Le creature non Angelo che controlli hanno indistruttibile fino al tuo prossimo turno.\\nTerra\\n{T}: Aggiungi {W}.\', \'type\': \'Stregoneria\', \'flavor\': \'"Iona non difende più questo luogo. Ci pensiamo noi."\\n—Kasla, pastore di Emeria\', \'faceName\': \'Richiamo di Emeria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492897&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3f50821-64ed-4de7-ae30-9abaa5d30281\', \'multiverseId\': 492897}, \'multiverseid\': 492897}, {\'name\': \'エメリアの呼び声 // 砕け散ったスカイクレイブ、エメリア\', \'text\': \'飛行を持つ白の４/４の天使・戦士・クリーチャー・トークンを２体生成する。あなたの次のターンまで、あなたがコントロールしていて天使でないクリーチャーは破壊不能を得る。\\n土地\\n{T}：{W}を加える。\', \'type\': \'ソーサリー\', \'flavor\': \'「この場所は最早イオナに守られてはいない。我々が守るのだ。」\\n――エメリアの番人、カスラ\', \'faceName\': \'エメリアの呼び声\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493213&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb7ca9d3-b935-4859-9b0c-f51bd6c61ea3\', \'multiverseId\': 493213}, \'multiverseid\': 493213}, {\'name\': \'에메리아의 부름 // 산산조각난 하늘거주지, 에메리아\', \'text\': \'비행을 가진 4/4 백색 천사 전사 생물 토큰 두 개를 만든다. 당신이 조종하는 천사가 아닌 생물들은 당신의 다음 턴까지 무적을 얻는다.\\n대지\\n{T}: {W}를 추가한다.\', \'type\': \'집중마법\', \'flavor\': \'"이곳을 지키는 것은 더이상 아이오나가 아니다. 우리다."\\n—에메리아 목동, 카슬라\', \'faceName\': \'에메리아의 부름\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493529&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fe1b72c6-d5f8-45a6-9f74-bf7fb8f1e650\', \'multiverseId\': 493529}, \'multiverseid\': 493529}, {\'name\': \'Chamado de Emeria // Emeria, Enclave Celeste Partido\', \'text\': \'Crie duas fichas de criatura branca 4/4 do tipo Anjo Guerreiro com voar. As criaturas que você controla que não sejam Anjos ganham indestrutível até o final do turno.\\nTerreno\\n{T}: Adicione {W}.\', \'type\': \'Feitiço\', \'flavor\': \'"Iona não protege mais este lugar. Nós protegemos."\\n— Kasla, pastora de Emeria\', \'faceName\': \'Chamado de Emeria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493845&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11a6f523-8dd0-4f67-899b-dcd56bc789b9\', \'multiverseId\': 493845}, \'multiverseid\': 493845}, {\'name\': \'Зов Эмерии // Эмерия, Руины Небесного Анклава\', \'text\': \'Создайте две фишки существа 4/4 белый Ангел Воин с Полетом. Не являющиеся Ангелами существа под вашим контролем получают Неразрушимость до вашего следующего хода.\\nЗемля\\n{T}: добавьте {W}.\', \'type\': \'Волшебство\', \'flavor\': \'«Иона больше не охраняет это место. Теперь это делаем мы».\\n— Касла, пастырь Эмерии\', \'faceName\': \'Зов Эмерии\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494161&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'82947fd8-f350-4726-9338-a575d5387f78\', \'multiverseId\': 494161}, \'multiverseid\': 494161}, {\'name\': \'伊美黎召令 // 破碎空境伊美黎\', \'text\': \'派出两个4/4白色，具飞行异能的天使／战士衍生生物。由你操控的非天使生物获得不灭异能直到你的下一个回合。\\n地\\n{T}：加{W}。\', \'type\': \'法术\', \'flavor\': \'「艾欧娜虽不再庇佑此地。但我们仍继续守护。」\\n～伊美黎牧者卡丝拉\', \'faceName\': \'伊美黎召令\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494477&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c7490f7-dd1a-481d-b7e8-1e8c6851cdc5\', \'multiverseId\': 494477}, \'multiverseid\': 494477}, {\'name\': \'伊美黎召令 // 破碎空境伊美黎\', \'text\': \'派出兩個4/4白色，具飛行異能的天使／戰士衍生生物。由你操控的非天使生物獲得不滅異能直到你的下一個回合。\\n地\\n{T}：加{W}。\', \'type\': \'巫術\', \'flavor\': \'「艾歐娜雖不再庇佑此地。但我們仍繼續守護。」\\n～伊美黎牧者卡絲拉\', \'faceName\': \'伊美黎召令\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494793&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'531a6791-8430-4da9-b0b3-361edfb08ced\', \'multiverseId\': 494793}, \'multiverseid\': 494793}]', '[{\'name\': \'Emerias Ruf // Emeria, die zerstörte Himmelsfestung\', \'text\': \'Sowie Emeria, die zerstörte Himmelsfestung, ins Spiel kommt, kannst du 3 Lebenspunkte bezahlen. Falls du dies nicht tust, kommt sie getappt ins Spiel.\\n{T}: Erzeuge {W}.\\nHexerei\\n{4}{W}{W}{W}\', \'type\': \'Land\', \'flavor\': \'„Du hast es als Götterfestung bezeichnet. Es ist weniger als das und so viel mehr."\\n—Kasla, Emerias Hirtin\', \'faceName\': \'Emeria, die zerstörte Himmelsfestung\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491949&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4042e563-2887-4fb5-bb18-90ee9392312b\', \'multiverseId\': 491949}, \'multiverseid\': 491949}, {\'name\': \'Llamada de Emeria // Emeria, aerorruina quebrada\', \'text\': \'En cuanto Emeria, aerorruina quebrada entre al campo de batalla, puedes pagar 3 vidas. Si no lo haces, entra al campo de batalla girada.\\n{T}: Agrega {W}.\\nConjuro\\n{4}{W}{W}{W}\', \'type\': \'Tierra\', \'flavor\': \'"Dijiste que era el castillo de una diosa. Es menos que eso, pero a la vez mucho más".\\n—Kasla, pastora de Emeria\', \'faceName\': \'Emeria, aerorruina quebrada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43b5816b-f4e3-482f-b1ed-e8ace6447485\', \'multiverseId\': 492265}, \'multiverseid\': 492265}, {\'name\': "Appel d\'Éméria // Éméria, fort céleste fracassé", \'text\': \'Au moment où Éméria, fort céleste fracassé arrive sur le champ de bataille, vous pouvez payer 3 points de vie. Si vous ne le faites pas, il arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {W}.\\nRituel\\n{4}{W}{W}{W}\', \'type\': \'Terrain\', \'flavor\': "« Vous l\'avez décrit comme un château divin. C\'est à la fois loin d\'en être un et bien plus que ça encore. »\\n—Kasla, bergère d\'Éméria", \'faceName\': \'Éméria, fort céleste fracassé\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492581&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8712666-e03a-4bdc-806d-fdb7a8d53986\', \'multiverseId\': 492581}, \'multiverseid\': 492581}, {\'name\': \'Richiamo di Emeria // Emeria, Enclave Celeste Frantumata\', \'text\': \'Mentre Emeria, Enclave Celeste Frantumata entra nel campo di battaglia, puoi pagare 3 punti vita. Se non lo fai, entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {W}.\\nStregoneria\\n{4}{W}{W}{W}\', \'type\': \'Terra\', \'flavor\': \'"L\\\'avete chiamata il castello di una dea. È meno di questo e molto di più."\\n—Kasla, pastore di Emeria\', \'faceName\': \'Emeria, Enclave Celeste Frantumata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492897&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3f50821-64ed-4de7-ae30-9abaa5d30281\', \'multiverseId\': 492897}, \'multiverseid\': 492897}, {\'name\': \'エメリアの呼び声 // 砕け散ったスカイクレイブ、エメリア\', \'text\': \'砕け散ったスカイクレイブ、エメリアが戦場に出るに際し、あなたは３点のライフを支払ってもよい。そうしないなら、これはタップ状態で戦場に出る。\\n{T}：{W}を加える。\\nソーサリー\\n{4}{W}{W}{W}\', \'type\': \'土地\', \'flavor\': \'「お前はここが神の城だと言ったな。それほどではない。だがそれ以上でもある。」\\n――エメリアの番人、カスラ\', \'faceName\': \'砕け散ったスカイクレイブ、エメリア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493213&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb7ca9d3-b935-4859-9b0c-f51bd6c61ea3\', \'multiverseId\': 493213}, \'multiverseid\': 493213}, {\'name\': \'에메리아의 부름 // 산산조각난 하늘거주지, 에메리아\', \'text\': \'산산조각난 하늘거주지, 에메리아가 전장에 들어오면서, 당신은 생명 3점을 지불할 수 있다. 그러지 않으면, 에메리아는 탭된 채로 전장에 들어온다.\\n{T}: {W}를 추가한다.\\n집중마법\\n{4}{W}{W}{W}\', \'type\': \'대지\', \'flavor\': \'"넌 그곳을 신의 성이라고 불렀지. 그곳은 그렇다기보단, 더 많은 의미를 가지고 있어."\\n—에메리아 목동, 카슬라\', \'faceName\': \'산산조각난 하늘거주지, 에메리아\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493529&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fe1b72c6-d5f8-45a6-9f74-bf7fb8f1e650\', \'multiverseId\': 493529}, \'multiverseid\': 493529}, {\'name\': \'Chamado de Emeria // Emeria, Enclave Celeste Partido\', \'text\': \'Conforme Emeria, Enclave Celeste Partido, entra no campo de batalha, você pode pagar 3 pontos de vida. Se não fizer isso, ele entrará no campo de batalha virado.\\n{T}: Adicione {W}.\\nFeitiço\\n{4}{W}{W}{W}\', \'type\': \'Terreno\', \'flavor\': \'"Vocês diziam que era o castelo de uma divindade. Não é tudo isso, mas, ao mesmo tempo, é muito mais."\\n— Kasla, pastora de Emeria\', \'faceName\': \'Emeria, Enclave Celeste Partido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493845&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11a6f523-8dd0-4f67-899b-dcd56bc789b9\', \'multiverseId\': 493845}, \'multiverseid\': 493845}, {\'name\': \'Зов Эмерии // Эмерия, Руины Небесного Анклава\', \'text\': \'При выходе Эмерии, Руин Небесного Анклава на поле битвы вы можете заплатить 3 жизни. Если вы этого не делаете, она выходит на поле битвы повернутой.\\n{T}: добавьте {W}.\\nВолшебство\\n{4}{W}{W}{W}\', \'type\': \'Земля\', \'flavor\': \'«Вы называли ее замком богини. Но это нечто меньшее — и неизмеримо большее».\\n— Касла, пастырь Эмерии\', \'faceName\': \'Эмерия, Руины Небесного Анклава\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494161&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'82947fd8-f350-4726-9338-a575d5387f78\', \'multiverseId\': 494161}, \'multiverseid\': 494161}, {\'name\': \'伊美黎召令 // 破碎空境伊美黎\', \'text\': \'于破碎空境伊美黎进战场时，你可以支付3点生命。如果你未如此作，则它须横置进战场。\\n{T}：加{W}。\\n法术\\n{4}{W}{W}{W}\', \'type\': \'地\', \'flavor\': \'「你们将这称作神佑之城。神明已逝，天威犹存。」\\n～伊美黎牧者卡丝拉\', \'faceName\': \'破碎空境伊美黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494477&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c7490f7-dd1a-481d-b7e8-1e8c6851cdc5\', \'multiverseId\': 494477}, \'multiverseid\': 494477}, {\'name\': \'伊美黎召令 // 破碎空境伊美黎\', \'text\': \'於破碎空境伊美黎進戰場時，你可以支付3點生命。如果你未如此作，則它須橫置進戰場。\\n{T}：加{W}。\\n巫術\\n{4}{W}{W}{W}\', \'type\': \'地\', \'flavor\': \'「你們將這稱作神祐之城。神明已逝，天威猶存。」\\n～伊美黎牧者卡絲拉\', \'faceName\': \'破碎空境伊美黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494793&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'531a6791-8430-4da9-b0b3-361edfb08ced\', \'multiverseId\': 494793}, \'multiverseid\': 494793}]', '[{\'name\': \'Engel der Legion\', \'text\': \'Fliegend\\nWenn der Engel der Legion ins Spiel kommt, kannst du eine Karte namens Engel der Legion, die du besitzt, von außerhalb der Partie offen vorzeigen und auf deine Hand nehmen.\', \'type\': \'Kreatur — Engel, Krieger\', \'flavor\': \'„Wir sind viele und bringen Recht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491962&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75f37144-1bb3-413b-8ca4-bfabc5a07b64\', \'multiverseId\': 491962}, \'multiverseid\': 491962}, {\'name\': \'Ángel de la legión\', \'text\': \'Vuela.\\nCuando el Ángel de la legión entre al campo de batalla, puedes mostrar una carta de fuera del juego de la cual eres propietario llamada Ángel de la legión y ponerla en tu mano.\', \'type\': \'Criatura — Guerrero ángel\', \'flavor\': \'"Somos muchas; y justas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3610ab30-005a-469d-aad4-7c5a0d29f160\', \'multiverseId\': 492278}, \'multiverseid\': 492278}, {\'name\': \'Ange de la Légion\', \'text\': "Vol\\nQuand l\'Ange de la Légion arrive sur le champ de bataille, vous pouvez révéler une carte que vous possédez appelée Ange de la Légion depuis l\'extérieur de la partie et la mettre dans votre main.", \'type\': \'Créature : ange et guerrier\', \'flavor\': \'« Nous sommes nombreux, et nous voulons la justice. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492594&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1cb1b389-ea0b-4f9e-aa00-08104dae3fad\', \'multiverseId\': 492594}, \'multiverseid\': 492594}, {\'name\': \'Angelo della Legione\', \'text\': "Volare\\nQuando l\'Angelo della Legione entra nel campo di battaglia, puoi rivelare una carta che possiedi al di fuori della partita chiamata Angelo della Legione e aggiungerla alla tua mano.", \'type\': \'Creatura — Guerriero Angelo\', \'flavor\': \'"Siamo molti e virtuosi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492910&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c45af6bb-6c93-4fdc-b836-375694e6ae06\', \'multiverseId\': 492910}, \'multiverseid\': 492910}, {\'name\': \'軍団の天使\', \'text\': \'飛行\\n軍団の天使が戦場に出たとき、あなたは「ゲームの外部からあなたがオーナーであり『軍団の天使』という名前であるカード１枚を公開し、あなたの手札に加える。」を選んでもよい。\', \'type\': \'クリーチャー — 天使・戦士\', \'flavor\': \'「こちらは多勢で、しかも正義だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493226&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c339f48f-c1b6-4b35-9301-f1ac5acbf351\', \'multiverseId\': 493226}, \'multiverseid\': 493226}, {\'name\': \'군단 천사\', \'text\': \'비행\\n군단 천사가 전장에 들어올 때, 당신은 게임 밖에서 당신이 소유한 이름이 군단 천사인 카드 한 장을 공개하고 당신의 손으로 가져올 수 있다.\', \'type\': \'생물 — 천사 전사\', \'flavor\': \'"우리는 수많고, 정의롭다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493542&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e631a7aa-0abd-4ca4-8f0a-2a64301999ef\', \'multiverseId\': 493542}, \'multiverseid\': 493542}, {\'name\': \'Anjo da Legião\', \'text\': \'Voar\\nQuando Anjo da Legião entra no campo de batalha, você pode revelar um card que você possui com o nome Anjo da Legião de fora do jogo e colocá-lo em sua mão.\', \'type\': \'Criatura — Anjo Guerreiro\', \'flavor\': \'"Somos muitos, e justos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493858&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b801170-a01f-4b15-8e9e-b02ba1758e32\', \'multiverseId\': 493858}, \'multiverseid\': 493858}, {\'name\': \'Ангел Легиона\', \'text\': \'Полет\\nКогда Ангел Легиона выходит на поле битвы, вы можете показать принадлежащую вам карту вне игры с именем Ангел Легиона и положить ее в вашу руку.\', \'type\': \'Существо — Ангел Воин\', \'flavor\': \'«Нас много, и наше дело — правое».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494174&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84d4d824-f6ca-4721-bb14-c5b09307b6e1\', \'multiverseId\': 494174}, \'multiverseid\': 494174}, {\'name\': \'军团天使\', \'text\': \'飞行\\n当军团天使进战场时，你可以从游戏外展示一张由你拥有且名称为军团天使的牌，并将它置于你手上。\', \'type\': \'生物 ～天使／战士\', \'flavor\': \'「我们声势浩大，我们彰显正义。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494490&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'747fc657-d15d-4e5a-93d8-beb9a0e413f7\', \'multiverseId\': 494490}, \'multiverseid\': 494490}, {\'name\': \'軍團天使\', \'text\': \'飛行\\n當軍團天使進戰場時，你可以從遊戲外展示一張由你擁有且名稱為軍團天使的牌，並將它置於你手上。\', \'type\': \'生物 ～天使／戰士\', \'flavor\': \'「我們聲勢浩大，我們彰顯正義。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494806&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'12f9b36e-0062-47e3-86fb-1fe77e8c45bf\', \'multiverseId\': 494806}, \'multiverseid\': 494806}]', '[{\'name\': \'Engel der Legion\', \'text\': \'Fliegend\\nWenn der Engel der Legion ins Spiel kommt, kannst du eine Karte namens Engel der Legion, die du besitzt, von außerhalb der Partie offen vorzeigen und auf deine Hand nehmen.\', \'type\': \'Kreatur — Engel, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495673&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b889a2d-5f68-4c23-9687-f290c644042a\', \'multiverseId\': 495673}, \'multiverseid\': 495673}, {\'name\': \'Ange de la Légion\', \'text\': "Vol\\nQuand l\'Ange de la Légion arrive sur le champ de bataille, vous pouvez révéler une carte que vous possédez appelée Ange de la Légion depuis l\'extérieur de la partie et la mettre dans votre main.", \'type\': \'Créature : ange et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495748&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e39f2b8-98b8-4448-a3f3-8b8864cb36b1\', \'multiverseId\': 495748}, \'multiverseid\': 495748}, {\'name\': \'軍団の天使\', \'text\': \'飛行\\n軍団の天使が戦場に出たとき、あなたは「ゲームの外部からあなたがオーナーであり『軍団の天使』という名前であるカード１枚を公開し、あなたの手札に加える。」を選んでもよい。\', \'type\': \'クリーチャー — 天使・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495823&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62065f39-b74f-4782-ab1e-1021b4b9f3dd\', \'multiverseId\': 495823}, \'multiverseid\': 495823}]', '[{\'name\': \'Engel des Schicksals\', \'text\': \'Fliegend, Doppelschlag\\nImmer wenn eine Kreatur, die du kontrollierst, einem Spieler Kampfschaden zufügt, erhaltet du und der Spieler entsprechend viele Lebenspunkte dazu.\\nZu Beginn deines Endsegments und falls du mindestens 15 Lebenspunkte mehr als deine Startlebenspunktezahl hast, verliert jeder Spieler, den der Engel des Schicksals in diesem Zug angegriffen hat, die Partie.\', \'type\': \'Kreatur — Engel, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491939&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2bb32a6c-595f-42ef-87cf-2f5400af25b4\', \'multiverseId\': 491939}, \'multiverseid\': 491939}, {\'name\': \'Ángel del destino\', \'text\': \'Vuela, daña dos veces.\\nSiempre que una criatura que controlas haga daño de combate a un jugador, ese jugador y tú ganan esa misma cantidad de vidas.\\nAl comienzo de tu paso final, si tienes al menos 15 vidas más que tu total de vidas inicial, cada jugador al que el Ángel del destino atacó este turno pierde el juego.\', \'type\': \'Criatura — Clérigo ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492255&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3cecc652-c88f-4ca4-8159-1e7fc196c9dd\', \'multiverseId\': 492255}, \'multiverseid\': 492255}, {\'name\': \'Ange de la Destinée\', \'text\': "Vol, double initiative\\nÀ chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à un joueur, ce joueur et vous gagnez chacun autant de points de vie.\\nAu début de votre étape de fin, si vous avez au moins 15 points de vie de plus que votre total de points de vie de départ, chaque joueur que l\'Ange de la Destinée a attaqué ce tour-ci perd la partie.", \'type\': \'Créature : ange et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492571&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'937e84f1-ef01-4b33-baa2-f03188c16479\', \'multiverseId\': 492571}, \'multiverseid\': 492571}, {\'name\': \'Angelo del Destino\', \'text\': "Volare, doppio attacco\\nOgniqualvolta una creatura che controlli infligge danno da combattimento a un giocatore, tu e quel giocatore guadagnate altrettanti punti vita.\\nAll\'inizio della tua sottofase finale, se hai almeno 15 punti vita in più rispetto ai tuoi punti vita iniziali, ogni giocatore che l\'Angelo del Destino ha attaccato in questo turno perde la partita.", \'type\': \'Creatura — Chierico Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f02f4bc7-baab-4b88-8236-25787ba80ab4\', \'multiverseId\': 492887}, \'multiverseid\': 492887}, {\'name\': \'運命の天使\', \'text\': \'飛行、二段攻撃\\nあなたがコントロールしているクリーチャー１体がプレイヤー１人に戦闘ダメージを与えるたび、あなたとそのプレイヤーはそれぞれ、その点数に等しい点数のライフを得る。\\nあなたの終了ステップの開始時に、あなたのライフがあなたの初期ライフ総量よりも15点以上多かった場合、運命の天使がこのターンに攻撃したプレイヤーはそれぞれこのゲームに敗北する。\', \'type\': \'クリーチャー — 天使・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493203&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d64d711-add5-49e6-a5e9-cca522cbd527\', \'multiverseId\': 493203}, \'multiverseid\': 493203}, {\'name\': \'운명의 천사\', \'text\': \'비행, 이단공격\\n당신이 조종하는 생물이 플레이어에게 전투피해를 입힐 때마다, 당신과 그 플레이어는 각각 그만큼의 생명점을 얻는다.\\n당신의 종료단 시작에, 당신의 생명 총점이 게임을 시작할 때의 생명 총점보다 최소 15점 이상 높다면, 이 턴에 운명의 천사가 공격한 각 플레이어는 게임에서 패배한다.\', \'type\': \'생물 — 천사 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493519&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8b5efb39-af64-45ff-b836-398d40aad223\', \'multiverseId\': 493519}, \'multiverseid\': 493519}, {\'name\': \'Anjo do Destino\', \'text\': \'Voar, golpe duplo\\nToda vez que uma criatura que você controla causa dano de combate a um jogador, você e aquele jogador ganham aquela quantidade de pontos de vida.\\nNo início de sua etapa final, se você tiver ao menos 15 pontos de vida a mais que seu total de pontos de vida inicial, cada jogador que Anjo do Destino atacou neste turno perde o jogo.\', \'type\': \'Criatura — Anjo Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493835&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5dfd9fe-40d1-4902-a782-7dc18e72fcc4\', \'multiverseId\': 493835}, \'multiverseid\': 493835}, {\'name\': \'Ангел Судьбы\', \'text\': \'Полет, Двойной удар\\nКаждый раз, когда существо под вашим контролем наносит боевые повреждения игроку, вы и тот игрок получаете по такому же количеству жизней.\\nВ начале вашего заключительного шага, если количество ваших жизней превышает ваше начальное количество жизней как минимум на 15, то каждый игрок, которого Ангел Судьбы атаковал в этом ходу, проигрывает партию.\', \'type\': \'Существо — Ангел Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494151&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d4ef47d-c218-4888-b5fe-8a92b7d06420\', \'multiverseId\': 494151}, \'multiverseid\': 494151}, {\'name\': \'命运天使\', \'text\': \'飞行，连击\\n每当一个由你操控的生物对任一牌手造成战斗伤害时，你和该牌手各获得等量的生命。\\n在你的结束步骤开始时，若你的总生命比你的起始总生命至少多15点，则命运天使本回合中攻击过的每位牌手各输掉这盘游戏。\', \'type\': \'生物 ～天使／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494467&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'26554ca4-9508-4f16-9c2e-f8fd558c4d06\', \'multiverseId\': 494467}, \'multiverseid\': 494467}, {\'name\': \'命運天使\', \'text\': \'飛行，連擊\\n每當一個由你操控的生物對任一玩家造成戰鬥傷害時，你和該玩家各獲得等量的生命。\\n在你的結束步驟開始時，若你的總生命比你的起始總生命至少多15點，則命運天使本回合中攻擊過的每位玩家各輸掉這盤遊戲。\', \'type\': \'生物 ～天使／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494783&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8bb0bdcd-8453-4f62-8c93-a1bf6507438c\', \'multiverseId\': 494783}, \'multiverseid\': 494783}]', '[{\'name\': \'Engel des Schicksals\', \'text\': \'Fliegend, Doppelschlag\\nImmer wenn eine Kreatur, die du kontrollierst, einem Spieler Kampfschaden zufügt, erhaltet du und der Spieler entsprechend viele Lebenspunkte dazu.\\nZu Beginn deines Endsegments und falls du mindestens 15 Lebenspunkte mehr als deine Startlebenspunktezahl hast, verliert jeder Spieler, den der Engel des Schicksals in diesem Zug angegriffen hat, die Partie.\', \'type\': \'Kreatur — Engel, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495668&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'123fe3fd-b5e9-48ef-a619-0b864ecb57a3\', \'multiverseId\': 495668}, \'multiverseid\': 495668}, {\'name\': \'Ange de la Destinée\', \'text\': "Vol, double initiative\\nÀ chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à un joueur, ce joueur et vous gagnez chacun autant de points de vie.\\nAu début de votre étape de fin, si vous avez au moins 15 points de vie de plus que votre total de points de vie de départ, chaque joueur que l\'Ange de la Destinée a attaqué ce tour-ci perd la partie.", \'type\': \'Créature : ange et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495743&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42327dc9-0ad4-4261-835c-4f8fa7a00f06\', \'multiverseId\': 495743}, \'multiverseid\': 495743}, {\'name\': \'運命の天使\', \'text\': \'飛行、二段攻撃\\nあなたがコントロールしているクリーチャー１体がプレイヤー１人に戦闘ダメージを与えるたび、あなたとそのプレイヤーはそれぞれ、その点数に等しい点数のライフを得る。\\nあなたの終了ステップの開始時に、あなたのライフがあなたの初期ライフ総量よりも15点以上多かった場合、運命の天使がこのターンに攻撃したプレイヤーはそれぞれこのゲームに敗北する。\', \'type\': \'クリーチャー — 天使・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495818&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7182af74-3be3-4962-ad24-839a6e58c38c\', \'multiverseId\': 495818}, \'multiverseid\': 495818}]', '[{\'name\': \'Engelherz-Beschützerin\', \'text\': \'Wenn die Engelherz-Beschützerin ins Spiel kommt, erhält eine Kreatur deiner Wahl, die du kontrollierst, Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören sie nicht.)\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Wir werden durchhalten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'68e147b7-c97c-4075-8191-a682f61b99cb\', \'multiverseId\': 491940}, \'multiverseid\': 491940}, {\'name\': \'Guardiana corazón de ángel\', \'text\': \'Cuando la Guardiana corazón de ángel entre al campo de batalla, la criatura objetivo que controlas gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no la destruyen.)\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Resistiremos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492256&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8b7a1357-1c83-4b84-82fe-8c8f1616f4f5\', \'multiverseId\': 492256}, \'multiverseid\': 492256}, {\'name\': "Protectrice au cœur d\'ange", \'text\': "Quand la Protectrice au cœur d\'ange arrive sur le champ de bataille, une créature ciblée que vous contrôlez acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne la détruisent pas.)", \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Nous persisterons. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492572&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b63a768b-feba-4692-bec3-7f81c9537e66\', \'multiverseId\': 492572}, \'multiverseid\': 492572}, {\'name\': \'Protettrice del Cuore Angelico\', \'text\': \'Quando la Protettrice del Cuore Angelico entra nel campo di battaglia, una creatura bersaglio che controlli ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non la distruggono.)\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Non ci arrenderemo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492888&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b56c5cf1-f65d-4151-a1b1-eb41d05d5940\', \'multiverseId\': 492888}, \'multiverseid\': 492888}, {\'name\': \'天使心の守護者\', \'text\': \'天使心の守護者が戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とする。ターン終了時まで、それは破壊不能を得る。（ダメージや「破壊」と書かれた効果では、それは破壊されない。）\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「持ちこたえてみせよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493204&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4dd01f72-39df-4810-b13e-450883ab49fb\', \'multiverseId\': 493204}, \'multiverseid\': 493204}, {\'name\': \'천사심장 수호자\', \'text\': \'천사심장 수호자가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'생물 — 인간 성직자\', \'flavor\': \'"우리는 보호해야 한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493520&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c13f50a0-10ee-4f4f-8cec-a347ef6907a0\', \'multiverseId\': 493520}, \'multiverseid\': 493520}, {\'name\': \'Protetora do Coração de Anjo\', \'text\': \'Quando Protetora do Coração de Anjo entra no campo de batalha, a criatura alvo que você controla ganha indestrutível até o final do turno. (O dano e os efeitos que dizem "destrua" não a destroem.)\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'"Nós vamos perseverar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493836&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6e76e398-6d8a-4835-b482-af4d9f177bc9\', \'multiverseId\': 493836}, \'multiverseid\': 493836}, {\'name\': \'Защитница Ангельского Сердца\', \'text\': \'Когда Защитница Ангельского Сердца выходит на поле битвы, целевое существо под вашим контролем получает Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'«Мы выстоим».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494152&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f8299245-440d-45dd-964f-20801bbba9b9\', \'multiverseId\': 494152}, \'multiverseid\': 494152}, {\'name\': \'天使心护僧\', \'text\': \'当天使心护僧进战场时，目标由你操控的生物获得不灭异能直到回合结束。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': \'「我们必能平安归程。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494468&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88e52d39-b456-4d9e-a84b-343e414b6cf0\', \'multiverseId\': 494468}, \'multiverseid\': 494468}, {\'name\': \'天使心護僧\', \'text\': \'當天使心護僧進戰場時，目標由你操控的生物獲得不滅異能直到回合結束。（傷害與註明「消滅」的效應不會將它消滅。）\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': \'「我們必能平安歸程。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494784&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa42c5e5-59db-49ef-97a8-56d9d66fb3b3\', \'multiverseId\': 494784}, \'multiverseid\': 494784}]', '[{\'name\': \'Entschlossener Schlag\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Falls sie ein Krieger ist, kannst du eine Ausrüstung, die du kontrollierst, an sie anlegen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wenn du etwas oft genug übst, geht es in Fleisch und Blut über. Aus diesem Grund trainieren wir und aus diesem Grund überleben wir."\\n—Tasha, Graupelz-Veteranin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491976&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5423b19a-5160-431f-bafd-a948d405329a\', \'multiverseId\': 491976}, \'multiverseid\': 491976}, {\'name\': \'Golpe con decisión\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno. Si es un Guerrero, puedes anexarle un Equipo que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Si practicas algo lo suficientemente a menudo, se vuelve parte de ti. Por eso entrenamos, y por eso sobrevivimos".\\n—Tasha, veterana de Pellejo Gris\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492292&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e8edf3a9-47f0-40ff-8de4-8bd3839a01e3\', \'multiverseId\': 492292}, \'multiverseid\': 492292}, {\'name\': \'Frappe déterminée\', \'text\': "Une créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Si c\'est un guerrier, vous pouvez lui attacher un équipement que vous contrôlez.", \'type\': \'Éphémère\', \'flavor\': "« Si l\'on pratique quelque chose assez souvent, on finit par l\'intégrer. C\'est pour cela que nous nous entraînons, et c\'est comme cela que nous restons en vie. »\\n—Tasha, vétérane de Grisepeau", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492608&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90bc5879-320d-4d62-9af4-726184ddeaa6\', \'multiverseId\': 492608}, \'multiverseid\': 492608}, {\'name\': \'Colpo Risoluto\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno. Se è un Guerriero, puoi assegnargli un Equipaggiamento che controlli.\', \'type\': \'Istantaneo\', \'flavor\': \'"Se pratichi qualcosa abbastanza spesso, diventa parte di te. È per questo che ci addestriamo ed è per questo che sopravviviamo."\\n—Tasha, veterana di Pellegrigia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492924&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'935627fe-99fb-4498-845f-9fdb9e732143\', \'multiverseId\': 492924}, \'multiverseid\': 492924}, {\'name\': \'毅然たる一撃\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。それが戦士であるなら、あなたはあなたがコントロールしている装備品１つをそれにつけてもよい。\', \'type\': \'インスタント\', \'flavor\': \'「繰り返し十分に練習すれば、何であれ自分の一部になる。それが訓練する理由だし、今まで生き残れている理由よ。」\\n――灰色革の古参兵、ターシャ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493240&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d187b29-99a3-4145-9f92-c0b5217a0a2e\', \'multiverseId\': 493240}, \'multiverseid\': 493240}, {\'name\': \'확고한 일격\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 그 생물이 전사라면, 당신은 당신이 조종하는 장비 한 개를 그 생물에게 부착할 수 있다.\', \'type\': \'순간마법\', \'flavor\': \'"무언가를 충분히 자주 연습한다면, 그건 네 일부분이 되지. 그게 우리가 훈련을 하는 이유고, 그게 우리가 살아남는 이유야."\\n—회색가죽 숙련병, 타샤\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493556&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'24fb4fa4-3c2c-4cba-9671-9eb3d7d712a9\', \'multiverseId\': 493556}, \'multiverseid\': 493556}, {\'name\': \'Ataque Resoluto\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno. Se for um Guerreiro, você pode anexar a ela um Equipamento que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Se você pratica alguma coisa constantemente, ela se torna parte de você. É por isso que nós treinamos, e é por isso que nós sobrevivemos."\\n— Tasha, veterana Pele-cinza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493872&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e09bd458-c339-45e8-8c91-9fc0130566dd\', \'multiverseId\': 493872}, \'multiverseid\': 493872}, {\'name\': \'Решительный Удар\', \'text\': \'Целевое существо получает +2/+2 до конца хода. Если это Воин, вы можете прикрепить к нему Снаряжение под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Если долго в чем-то упражняешься, то это становится частью тебя. Поэтому мы упражняемся — и поэтому выживаем».\\n—Таша, грейпелтский ветеран\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494188&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41ff970e-1655-4893-aaa2-00eaf520489e\', \'multiverseId\': 494188}, \'multiverseid\': 494188}, {\'name\': \'坚毅一击\', \'text\': \'目标生物得+2/+2直到回合结束。如果它是战士，则你可以将一个由你操控的武具装备于其上。\', \'type\': \'瞬间\', \'flavor\': \'「如果你认准一件事情不断练习，久了它就会成为你本能反应的一部分。这就是我们不断训练的原因，这就是我们能存活下来的缘由。」\\n～灰皮老兵塔莎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494504&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd35e787-5dde-42d4-8e21-bdc765753094\', \'multiverseId\': 494504}, \'multiverseid\': 494504}, {\'name\': \'堅毅一擊\', \'text\': \'目標生物得+2/+2直到回合結束。如果它是戰士，則你可以將一個由你操控的武具裝備於其上。\', \'type\': \'瞬間\', \'flavor\': \'「如果你認準一件事情不斷練習，久了它就會成為你本能反應的一部分。這就是我們不斷訓練的原因，這就是我們能存活下來的緣由。」\\n～灰皮老兵塔莎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494820&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'35f19a78-664f-44c3-987a-c71d6d82d419\', \'multiverseId\': 494820}, \'multiverseid\': 494820}]', '[{\'name\': \'Entzauberung\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es wurde aus Legenden geschmiedet, und zu den Legenden kehrt es zurück."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491947&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fff120f1-87bf-4245-89b4-b6dbab5abd41\', \'multiverseId\': 491947}, \'multiverseid\': 491947}, {\'name\': \'Desencantar\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Se forjó de una leyenda y retorna a una leyenda".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492263&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ade2c9f-148c-4d5c-92d2-f554009fbb3c\', \'multiverseId\': 492263}, \'multiverseid\': 492263}, {\'name\': \'Désenchantement\', \'text\': \'Détruisez un artefact ciblé ou un enchantement ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'« Il est né de la légende et il redeviendra légende. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492579&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8c3ee9f4-81a7-4d3a-8582-7871f7dd56d5\', \'multiverseId\': 492579}, \'multiverseid\': 492579}, {\'name\': \'Disincantare\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Fu forgiato dalla leggenda e alla leggenda tornerà."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492895&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ee0f5f1-9298-46a0-8c10-01be31190890\', \'multiverseId\': 492895}, \'multiverseid\': 492895}, {\'name\': \'解呪\', \'text\': \'アーティファクト１つかエンチャント１つを対象とする。それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「伝説から造られ、伝説へと帰ってゆく。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493211&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dff6a5dc-d027-4f94-80bb-1919595f75b0\', \'multiverseId\': 493211}, \'multiverseid\': 493211}, {\'name\': \'마법력 소거\', \'text\': \'마법물체 또는 부여마법을 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"전설로부터 만들어져, 다시 전설로 되돌아가리."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493527&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'445a279d-f329-4025-9517-d1194ba757d5\', \'multiverseId\': 493527}, \'multiverseid\': 493527}, {\'name\': \'Desencantar\', \'text\': \'Destrua o artefato ou encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Das lendas forjado, às lendas retorna."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493843&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ac28601-3d0a-4691-9d18-8951fd1d2ca3\', \'multiverseId\': 493843}, \'multiverseid\': 493843}, {\'name\': \'Разочарование\', \'text\': \'Уничтожьте целевой артефакт или чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Из легенды он был выкован, в легенду и возвращается».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494159&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a1dcd680-0cb7-4fab-996f-d9668c789aaa\', \'multiverseId\': 494159}, \'multiverseid\': 494159}, {\'name\': \'消除魔障\', \'text\': \'消灭目标神器或结界。\', \'type\': \'瞬间\', \'flavor\': \'「铸自传说，归于传奇。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494475&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05a697e7-1106-44c1-86bf-88a2bbab16f0\', \'multiverseId\': 494475}, \'multiverseid\': 494475}, {\'name\': \'消除魔障\', \'text\': \'消滅目標神器或結界。\', \'type\': \'瞬間\', \'flavor\': \'「鑄自傳說，歸於傳奇。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494791&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8f4305d0-e039-4f54-bd83-99be8dfdbd50\', \'multiverseId\': 494791}, \'multiverseid\': 494791}]', '[{\'name\': \'Erbeutete Klinge\', \'text\': \'Wenn die Erbeutete Klinge ins Spiel kommt, lege sie an eine Kreatur deiner Wahl an, die du kontrollierst.\\nDie ausgerüstete Kreatur erhält +2/+0.\\nAusrüsten {2}{R} ({2}{R}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492114&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e31243cc-dd27-4634-b7e1-cde55cf06792\', \'multiverseId\': 492114}, \'multiverseid\': 492114}, {\'name\': \'Acero rebuscado\', \'text\': \'Cuando el Acero rebuscado entre al campo de batalla, anéxalo a la criatura objetivo que controlas.\\nLa criatura equipada obtiene +2/+0.\\nEquipar {2}{R}. ({2}{R}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a08a7d47-6668-46cd-84eb-bcbda80b3091\', \'multiverseId\': 492430}, \'multiverseid\': 492430}, {\'name\': \'Lame récupérée\', \'text\': "Quand la Lame récupérée arrive sur le champ de bataille, attachez-la à une créature ciblée que vous contrôlez.\\nLa créature équipée gagne +2/+0.\\nÉquipement {2}{R} ({2}{R} : Attachez à une créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96a171ca-5f95-4620-afbf-edd4a9662cf1\', \'multiverseId\': 492746}, \'multiverseid\': 492746}, {\'name\': \'Lama Sottratta\', \'text\': \'Quando la Lama Sottratta entra nel campo di battaglia, assegnala a una creatura bersaglio che controlli.\\nLa creatura equipaggiata prende +2/+0.\\nEquipaggiare {2}{R} ({2}{R}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'539d5e0c-e107-44a6-917f-d2799ff7c234\', \'multiverseId\': 493062}, \'multiverseid\': 493062}, {\'name\': \'拾った刃\', \'text\': \'拾った刃が戦場に出たとき、あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。\\n装備しているクリーチャーは＋２/＋０の修整を受ける。\\n装備{2}{R}（{2}{R}：あなたがコントロールしているクリーチャー１体を対象とする。これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec1d083d-e072-4a52-bd46-cbee4b8f8b20\', \'multiverseId\': 493378}, \'multiverseid\': 493378}, {\'name\': \'주워온 검\', \'text\': \'주워온 검이 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 주워온 검을 그 생물에 부착한다.\\n장착된 생물은 +2/+0을 받는다.\\n장착 {2}{R} ({2}{R}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493694&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0e959fac-c12b-427b-9919-13eba92a3426\', \'multiverseId\': 493694}, \'multiverseid\': 493694}, {\'name\': \'Lâmina Salvada\', \'text\': \'Quando Lâmina Salvada entrar no campo de batalha, anexe-a à criatura alvo que você controla.\\nA criatura equipada recebe +2/+0.\\nEquipar {2}{R} ({2}{R}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e6df8fc9-a60e-46b0-8246-9ae0fbe54099\', \'multiverseId\': 494010}, \'multiverseid\': 494010}, {\'name\': \'Найденный Клинок\', \'text\': \'Когда Найденный Клинок выходит на поле битвы, прикрепите его к целевому существу под вашим контролем.\\nСнаряженное существо получает +2/+0.\\nСнарядить {2}{R} ({2}{R}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494326&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1139e783-c63b-4978-97d7-99b611f02ccc\', \'multiverseId\': 494326}, \'multiverseid\': 494326}, {\'name\': \'拼装式战刃\', \'text\': \'当拼装式战刃进战场时，将它装备在目标由你操控的生物上。\\n佩带此武具的生物得+2/+0。\\n佩带{2}{R}（{2}{R}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494642&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae37ce76-2225-47a9-b5d6-4dc045a36193\', \'multiverseId\': 494642}, \'multiverseid\': 494642}, {\'name\': \'拼裝式戰刃\', \'text\': \'當拼裝式戰刃進戰場時，將它裝備在目標由你操控的生物上。\\n佩帶此武具的生物得+2/+0。\\n佩帶{2}{R}（{2}{R}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494958&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c320cf91-794b-4ab4-9e79-c3ef19741da8\', \'multiverseId\': 494958}, \'multiverseid\': 494958}]', '[{\'name\': \'Erdspaltenzauberer\', \'text\': \'Wenn der Erdspaltenzauberer ins Spiel kommt, kannst du eine Karte abwerfen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Goblin, Zauberer\', \'flavor\': \'Er könnte einen Lavaausbruch oder einen wütenden Teufelsbraten aus den vulkanischen Tiefen Akoums heraufbeschwören. Oder er könnte einfach hineinfallen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492096&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'365bd584-7bee-4b0d-823b-3573ea995416\', \'multiverseId\': 492096}, \'multiverseid\': 492096}, {\'name\': \'Hechicero de fisuras\', \'text\': \'Cuando el Hechicero de fisuras entre al campo de batalla, puedes descartar una carta. Si lo haces, roba una carta.\', \'type\': \'Criatura — Hechicero trasgo\', \'flavor\': \'Puede invocar un estallido de lava o un infernal iracundo de las profundidades volcánicas de Akoum. O puede que se caiga dentro de la fisura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492412&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2c789f51-77b0-4aa9-8a86-5c39822ece0c\', \'multiverseId\': 492412}, \'multiverseid\': 492412}, {\'name\': \'Sorcier de la fissure\', \'text\': "Quand le Sorcier de la fissure arrive sur le champ de bataille, vous pouvez vous défausser d\'une carte. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : gobelin et sorcier\', \'flavor\': "Il pourrait invoquer une explosion de lave ou une monstruosité enragée des profondeurs d\'Akoum. Ou bien il pourrait simplement tomber.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492728&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5608efdb-4fff-4f09-b77f-f1632d623849\', \'multiverseId\': 492728}, \'multiverseid\': 492728}, {\'name\': \'Mago delle Fratture\', \'text\': \'Quando il Mago delle Fratture entra nel campo di battaglia, puoi scartare una carta. Se lo fai, pesca una carta.\', \'type\': \'Creatura — Mago Goblin\', \'flavor\': "Potrebbe evocare un\'esplosione di lava o un infernale furioso dalle profondità vulcaniche di Akoum. Oppure potrebbe caderci.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493044&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5288ccf-30bb-4fb4-a44c-c4d70ac0a051\', \'multiverseId\': 493044}, \'multiverseid\': 493044}, {\'name\': \'地割れの魔術師\', \'text\': \'地割れの魔術師が戦場に出たとき、あなたはカード１枚を捨ててもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — ゴブリン・ウィザード\', \'flavor\': \'奴はアクームの火山の底から溶岩の噴流や怒れるヘリオンを呼び出すかもしれない。あるいは、ただ落っこちてしまうだけの可能性もある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493360&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f29c7f06-6aa4-4fe7-8acf-4c3b2714abdc\', \'multiverseId\': 493360}, \'multiverseid\': 493360}, {\'name\': \'균열 마법사\', \'text\': \'균열 마법사가 전장에 들어올 때, 당신은 카드 한 장을 버릴 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 고블린 마법사\', \'flavor\': \'그는 아쿰의 화산 구덩이에서 용암을 솟구쳐오르게 할 수도 있고 성난 헬리온을 불러낼 수도 있다. 아니면 그냥 그 안으로 떨어지든가.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493676&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bf66328d-e361-4e77-82f0-ed46f94275ac\', \'multiverseId\': 493676}, \'multiverseid\': 493676}, {\'name\': \'Mago da Fissura\', \'text\': \'Quando Mago da Fissura entra no campo de batalha, você pode descartar um card. Se fizer isso, compre um card.\', \'type\': \'Criatura — Goblin Mago\', \'flavor\': \'Ele pode invocar um jato de lava ou um avernal furioso das profundezas vulcânicas de Akoum. Ou pode só cair lá dentro mesmo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493992&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e333b18-88ae-4369-93d1-92d3208ce556\', \'multiverseId\': 493992}, \'multiverseid\': 493992}, {\'name\': \'Чародей Расселины\', \'text\': \'Когда Чародей Расселины выходит на поле битвы, вы можете сбросить карту. Если вы это делаете, возьмите карту.\', \'type\': \'Существо — Гоблин Чародей\', \'flavor\': \'Он может призвать выброс лавы или свирепого геллиона из вулканических глубин Акума. А может и сам туда свалиться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494308&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e9a4f995-c5fa-4e21-b1ab-1f7b6a4f8e15\', \'multiverseId\': 494308}, \'multiverseid\': 494308}, {\'name\': \'生裂法师\', \'text\': \'当生裂法师进战场时，你可以弃一张牌。若你如此作，则抓一张牌。\', \'type\': \'生物 ～鬼怪／法术师\', \'flavor\': \'他或许能从阿库姆的火山深渊中召出喷发熔岩或是狂怒狱兽。也或许会就此失足坠落。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494624&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5d2df07-a46c-4439-9c05-c437fd848472\', \'multiverseId\': 494624}, \'multiverseid\': 494624}, {\'name\': \'生裂法師\', \'text\': \'當生裂法師進戰場時，你可以棄一張牌。若你如此作，則抽一張牌。\', \'type\': \'生物 ～鬼怪／魔法師\', \'flavor\': \'他或許能從阿庫姆的火山深淵中召出噴發熔岩或是狂怒獄獸。也或許會就此失足墜落。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494940&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d45830cd-e47d-47ab-8583-a04b90e214d0\', \'multiverseId\': 494940}, \'multiverseid\': 494940}]', '[{\'name\': \'Erfahrener Abenteurer\', \'text\': \'Der Erfahrene Abenteurer ist auch Kleriker, Krieger, Räuber und Zauberer.\\nDieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger.\\nWachsamkeit\', \'type\': \'Kreatur — Mensch\', \'flavor\': \'„Wie kann ich behilflich sein?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492185&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bdb714f-f8fe-4590-8e36-5242528f46a9\', \'multiverseId\': 492185}, \'multiverseid\': 492185}, {\'name\': \'Aventurero veterano\', \'text\': \'El Aventurero veterano también es un Clérigo, Bribón, Guerrero y Hechicero.\\nTe cuesta {1} menos lanzar este hechizo por cada criatura en tu grupo.\\nVigilancia.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"¿En qué puedo ayudarte?".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1bb37f49-cdb2-441d-8a0f-3320c9d4d685\', \'multiverseId\': 492501}, \'multiverseid\': 492501}, {\'name\': \'Aventurier vétéran\', \'text\': "L\'Aventurier vétéran est aussi un clerc, un gredin, un guerrier et un sorcier.\\nCe sort coûte {1} de moins à lancer pour chaque créature dans votre groupe.\\nVigilance", \'type\': \'Créature : humain\', \'flavor\': \'« Comment puis-je vous aider ? »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492817&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34689fb2-4cb2-4fef-9fcf-e4e8e435f363\', \'multiverseId\': 492817}, \'multiverseid\': 492817}, {\'name\': \'Avventuriero Veterano\', \'text\': "L\'Avventuriero Veterano è anche un Chierico, Farabutto, Guerriero e Mago.\\nQuesta magia costa {1} in meno per essere lanciata per ogni creatura nella tua compagnia.\\nCautela", \'type\': \'Creatura — Umano\', \'flavor\': \'"Come posso essere di aiuto?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2db56a4f-26df-4676-9e59-3d86c995879d\', \'multiverseId\': 493133}, \'multiverseid\': 493133}, {\'name\': \'古参の冒険者\', \'text\': \'古参の冒険者はウィザードとクレリックと戦士とならず者でもある。\\nこの呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。\\n警戒\', \'type\': \'クリーチャー — 人間\', \'flavor\': \'「お手伝いしましょうか？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493449&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2780bd0c-ae19-48f3-a51e-5fba53ff3269\', \'multiverseId\': 493449}, \'multiverseid\': 493449}, {\'name\': \'숙련 모험가\', \'text\': \'숙련 모험가는 또한 성직자, 도적, 전사, 및 마법사이다.\\n이 주문은 당신의 파티에 있는 각 생물마다 발동하는 데 {1}이 덜 든다.\\n경계\', \'type\': \'생물 — 인간\', \'flavor\': \'"어떻게 도우면 되지?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493765&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'934ea72f-2fee-4ebc-bbdf-d3f26e90a4b8\', \'multiverseId\': 493765}, \'multiverseid\': 493765}, {\'name\': \'Aventureiro Veterano\', \'text\': \'Aventureiro Veterano também é um Clérigo, Ladino, Guerreiro e Mago.\\nEsta mágica custa {1} a menos para ser conjurada para cada criatura em seu grupo.\\nVigilância\', \'type\': \'Criatura — Humano\', \'flavor\': \'"Como eu posso ajudar?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494081&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1e98cbc0-7d72-4b9f-8a63-c437c98becc9\', \'multiverseId\': 494081}, \'multiverseid\': 494081}, {\'name\': \'Бывалый Искатель Приключений\', \'text\': \'Бывалый Искатель Приключений также является Бродягой, Воином, Священником и Чародеем.\\nРазыгрывание этого заклинания стоит на {1} меньше за каждое существо в вашем отряде.\\nБдительность\', \'type\': \'Существо — Человек\', \'flavor\': \'«Чем могу помочь?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494397&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'454aef05-ee9e-42c6-b671-b05c9ba29ea6\', \'multiverseId\': 494397}, \'multiverseid\': 494397}, {\'name\': \'资深冒险者\', \'text\': \'资深冒险者也是僧侣、浪客、战士和法术师。\\n你冒险团中每有一个生物，此咒语便减少{1}来施放。\\n警戒\', \'type\': \'生物 ～人类\', \'flavor\': \'「我能帮上什么忙？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494713&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ced9252d-e255-4a23-9835-4dd42a8da79a\', \'multiverseId\': 494713}, \'multiverseid\': 494713}, {\'name\': \'資深冒險者\', \'text\': \'資深冒險者也是僧侶、浪客、戰士和魔法師。\\n你冒險團中每有一個生物，此咒語便減少{1}來施放。\\n警戒\', \'type\': \'生物 ～人類\', \'flavor\': \'「我能幫上什麼忙？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495029&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7c77c9e2-b9cc-4da3-9bbd-e23098c783cb\', \'multiverseId\': 495029}, \'multiverseid\': 495029}]', '[{\'name\': \'Erforschung von Valakut\', \'text\': \'Landung — Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, schicke die oberste Karte deiner Bibliothek ins Exil. Du kannst die Karte spielen, solange sie im Exil bleibt.\\nZu Beginn deines Endsegments und falls Karten im Exil sind, die mit der Erforschung von Valakut ins Exil geschickt wurden, lege sie auf den Friedhof ihres Besitzers. Dann fügt die Erforschung von Valakut jedem Gegner entsprechend viele Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492136&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3afef584-4608-4174-9939-8324e58ebee6\', \'multiverseId\': 492136}, \'multiverseid\': 492136}, {\'name\': \'Exploración de Valakut\', \'text\': \'Aterrizaje — Siempre que una tierra entre al campo de batalla bajo tu control, exilia la primera carta de tu biblioteca. Puedes jugar esa carta mientras permanezca exiliada.\\nAl comienzo de tu paso final, si hay cartas exiliadas con la Exploración de Valakut, ponlas en el cementerio de su propietario, luego la Exploración de Valakut hace esa misma cantidad de daño a cada oponente.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492452&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd8748a2-2e31-4e34-8f92-c5150aa0348f\', \'multiverseId\': 492452}, \'multiverseid\': 492452}, {\'name\': \'Exploration de Valakut\', \'text\': "Toucheterre — À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, exilez la carte du dessus de votre bibliothèque. Vous pouvez jouer cette carte tant qu\'elle reste exilée.\\nAu début de votre étape de fin, s\'il y a des cartes exilées par l\'Exploration de Valakut, mettez-les dans le cimetière de leur propriétaire, puis l\'Exploration de Valakut inflige autant de blessures à chaque adversaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fbaadd7b-02a4-421f-b28e-1e68aa0ecb22\', \'multiverseId\': 492768}, \'multiverseid\': 492768}, {\'name\': \'Esplorazione di Valakut\', \'text\': "Terraferma — Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, esilia la prima carta del tuo grimorio. Puoi giocare quella carta fintanto che rimane esiliata.\\nAll\'inizio della tua sottofase finale, se ci sono carte esiliate con l\'Esplorazione di Valakut, mettile nel cimitero del loro proprietario, poi l\'Esplorazione di Valakut infligge altrettanti danni a ogni avversario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493084&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ccf4576-0eee-40af-a3f7-f6dcb917dce4\', \'multiverseId\': 493084}, \'multiverseid\': 493084}, {\'name\': \'ヴァラクートの探検\', \'text\': \'上陸 ― 土地が１つあなたのコントロール下で戦場に出るたび、あなたのライブラリーの一番上のカードを追放する。そのカードが追放され続けているかぎり、あなたはそれをプレイしてもよい。\\nあなたの終了ステップの開始時に、ヴァラクートの探検により追放されているカードがある場合、それらをオーナーの墓地に置く。その後、ヴァラクートの探検は各対戦相手にそれぞれ、その量に等しい点数のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493400&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ff489825-47b5-4176-8398-3959b7be3c13\', \'multiverseId\': 493400}, \'multiverseid\': 493400}, {\'name\': \'발라쿠트 탐험\', \'text\': \'대지력 — 대지가 당신의 조종하에 전장에 들어올 때마다, 당신의 서고 맨 위 카드를 추방한다. 그 카드가 추방되어 있는 한, 당신은 그 카드를 플레이할 수 있다.\\n당신의 종료단 시작에, 발라쿠트 탐험으로 추방된 카드들이 있다면, 그 카드들을 소유자의 무덤에 넣은 후, 발라쿠트 탐험은 각 상대에게 그만큼의 피해를 입힌다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493716&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c2ad4799-395b-40d4-b2f5-ddce42822f24\', \'multiverseId\': 493716}, \'multiverseid\': 493716}, {\'name\': \'Exploração de Valakut\', \'text\': \'Aterragem — Toda vez que um terreno entrar no campo de batalha sob seu controle, exile o card do topo de seu grimório. Você poderá jogar aquele card enquanto ele permanecer exilado.\\nNo início de sua etapa final, se houver qualquer número de cards exilados com Exploração de Valakut, coloque-os no cemitério de seu dono. Em seguida, Exploração de Valakut causa aquela quantidade de dano a cada oponente.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494032&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62744c97-cdf7-4111-8417-36369dd1103e\', \'multiverseId\': 494032}, \'multiverseid\': 494032}, {\'name\': \'Исследование Валакута\', \'text\': \'Землепад — Каждый раз, когда земля выходит на поле битвы под вашим контролем, изгоните верхнюю карту вашей библиотеки. Вы можете разыгрывать ту карту, пока она остается в изгнании.\\nВ начале вашего заключительного шага, если есть изгнанные Исследованием Валакута карты, положите их на кладбище их владельца, затем Исследование Валакута наносит столько же повреждений каждому оппоненту.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494348&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'56be0f78-d522-458c-938a-16b4a5a95471\', \'multiverseId\': 494348}, \'multiverseid\': 494348}, {\'name\': \'瓦拉库探险\', \'text\': \'地落～每当一个地在你的操控下进战场时，放逐你的牌库顶牌。于该牌持续放逐的时段内，你可以使用该牌。\\n在你的结束步骤开始时，若放逐区中有以瓦拉库探险放逐的牌，则将其置入其拥有者的坟墓场，然后瓦拉库探险向每位对手各造成等量的伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494664&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'17bc76d8-c1a2-4899-8bb7-e37467b79346\', \'multiverseId\': 494664}, \'multiverseid\': 494664}, {\'name\': \'瓦拉庫探險\', \'text\': \'地落～每當一個地在你的操控下進戰場時，放逐你的牌庫頂牌。於該牌持續放逐的時段內，你可以使用該牌。\\n在你的結束步驟開始時，若放逐區中有以瓦拉庫探險放逐的牌，則將其置入其擁有者的墳墓場，然後瓦拉庫探險向每位對手各造成等量的傷害。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494980&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0c99ff9c-8b55-4bc5-85be-301e589c286d\', \'multiverseId\': 494980}, \'multiverseid\': 494980}]', '[{\'name\': \'Erforschung von Valakut\', \'text\': \'Landung — Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, schicke die oberste Karte deiner Bibliothek ins Exil. Du kannst die Karte spielen, solange sie im Exil bleibt.\\nZu Beginn deines Endsegments und falls Karten im Exil sind, die mit der Erforschung von Valakut ins Exil geschickt wurden, lege sie auf den Friedhof ihres Besitzers. Dann fügt die Erforschung von Valakut jedem Gegner entsprechend viele Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495224&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6b86344e-c3bc-47a0-8f0a-3122bcad45bc\', \'multiverseId\': 495224}, \'multiverseid\': 495224}, {\'name\': \'Exploración de Valakut\', \'text\': \'Aterrizaje — Siempre que una tierra entre al campo de batalla bajo tu control, exilia la primera carta de tu biblioteca. Puedes jugar esa carta mientras permanezca exiliada.\\nAl comienzo de tu paso final, si hay cartas exiliadas con la Exploración de Valakut, ponlas en el cementerio de su propietario, luego la Exploración de Valakut hace esa misma cantidad de daño a cada oponente.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495249&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ddd4ccb0-2e03-4b57-a923-d2e936175bab\', \'multiverseId\': 495249}, \'multiverseid\': 495249}, {\'name\': \'Exploration de Valakut\', \'text\': "Toucheterre — À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, exilez la carte du dessus de votre bibliothèque. Vous pouvez jouer cette carte tant qu\'elle reste exilée.\\nAu début de votre étape de fin, s\'il y a des cartes exilées par l\'Exploration de Valakut, mettez-les dans le cimetière de leur propriétaire, puis l\'Exploration de Valakut inflige autant de blessures à chaque adversaire.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495274&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b97727c-a79d-41ff-9bed-3bfac8af8d8d\', \'multiverseId\': 495274}, \'multiverseid\': 495274}, {\'name\': \'Esplorazione di Valakut\', \'text\': "Terraferma — Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, esilia la prima carta del tuo grimorio. Puoi giocare quella carta fintanto che rimane esiliata.\\nAll\'inizio della tua sottofase finale, se ci sono carte esiliate con l\'Esplorazione di Valakut, mettile nel cimitero del loro proprietario, poi l\'Esplorazione di Valakut infligge altrettanti danni a ogni avversario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495299&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b78baddd-d777-4b6d-b6f2-4ce60cef2837\', \'multiverseId\': 495299}, \'multiverseid\': 495299}, {\'name\': \'ヴァラクートの探検\', \'text\': \'上陸 ― 土地が１つあなたのコントロール下で戦場に出るたび、あなたのライブラリーの一番上のカードを追放する。そのカードが追放され続けているかぎり、あなたはそれをプレイしてもよい。\\nあなたの終了ステップの開始時に、ヴァラクートの探検により追放されているカードがあるなら、それらをオーナーの墓地に置く。その後、ヴァラクートの探検は各対戦相手にそれぞれ、その量に等しい点数のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495324&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aee0580e-fdd0-4563-9a0e-2d3072f27b90\', \'multiverseId\': 495324}, \'multiverseid\': 495324}, {\'name\': \'발라쿠트 탐험\', \'text\': \'대지력 — 대지가 당신의 조종하에 전장에 들어올 때마다, 당신의 서고 맨 위 카드를 추방한다. 그 카드가 추방되어 있는 한, 당신은 그 카드를 플레이할 수 있다.\\n당신의 종료단 시작에, 발라쿠트 탐험으로 추방된 카드들이 있다면, 그 카드들을 소유자의 무덤에 넣은 후, 발라쿠트 탐험은 각 상대에게 그만큼의 피해를 입힌다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495349&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1e475d7c-d534-4157-b259-6a8ea8e86c36\', \'multiverseId\': 495349}, \'multiverseid\': 495349}, {\'name\': \'Exploração de Valakut\', \'text\': \'Aterragem — Toda vez que um terreno entrar no campo de batalha sob seu controle, exile o card do topo de seu grimório. Você poderá jogar aquele card enquanto ele permanecer exilado.\\nNo início de sua etapa final, se houver qualquer número de cards exilados com Exploração de Valakut, coloque-os no cemitério de seu dono. Em seguida, Exploração de Valakut causa aquela quantidade de dano a cada oponente.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495374&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29b5b3e3-6931-4a55-90ae-0fe95dd17a5a\', \'multiverseId\': 495374}, \'multiverseid\': 495374}, {\'name\': \'Исследование Валакута\', \'text\': \'Землепад — Каждый раз, когда земля выходит на поле битвы под вашим контролем, изгоните верхнюю карту вашей библиотеки. Вы можете разыгрывать ту карту, пока она остается в изгнании.\\nВ начале вашего заключительного шага, если есть изгнанные Исследованием Валакута карты, положите их на кладбище их владельца, затем Исследование Валакута наносит столько же повреждений каждому оппоненту.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495399&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bbfc6892-466f-4c71-adfb-2669ac085a22\', \'multiverseId\': 495399}, \'multiverseid\': 495399}, {\'name\': \'瓦拉库探险\', \'text\': \'地落～每当一个地在你的操控下进战场时，放逐你的牌库顶牌。于该牌持续放逐的时段内，你可以使用该牌。\\n在你的结束步骤开始时，若放逐区中有以瓦拉库探险放逐的牌，则将其置入其拥有者的坟墓场，然后瓦拉库探险向每位对手各造成等量的伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495424&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'23578cd6-c173-42d6-be13-97f187f38e23\', \'multiverseId\': 495424}, \'multiverseid\': 495424}, {\'name\': \'瓦拉庫探險\', \'text\': \'地落～每當一個地在你的操控下進戰場時，放逐你的牌庫頂牌。於該牌持續放逐的時段內，你可以使用該牌。\\n在你的結束步驟開始時，若放逐區中有以瓦拉庫探險放逐的牌，則將其置入其擁有者的墳墓場，然後瓦拉庫探險向每位對手各造成等量的傷害。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495449&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e7a7cbe1-cb0b-45ff-961e-81995e49d41e\', \'multiverseId\': 495449}, \'multiverseid\': 495449}]', '[{\'name\': \'Ersatzvorräte\', \'text\': \'Die Ersatzvorräte kommen getappt ins Spiel.\\nWenn die Ersatzvorräte ins Spiel kommen, ziehe eine Karte.\\n{2}, {T}, opfere die Ersatzvorräte: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'„Es ist besser, etwas mehr Gewicht zu tragen, als sich ohne Messer im Rachen eines Baloths wiederzufinden."\\n—Doral, Führerin aus Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492221&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ae1defa-133d-480c-ac87-b7496133c643\', \'multiverseId\': 492221}, \'multiverseid\': 492221}, {\'name\': \'Suministros de repuesto\', \'text\': \'Los Suministros de repuesto entran al campo de batalla girados.\\nCuando los Suministros de repuesto entren al campo de batalla, roba una carta.\\n{2}, {T}, sacrificar los Suministros de repuesto: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'"Es mejor llevar un poco más de peso que estar bajando por la garganta de un báloth sin un cuchillo".\\n—Doral, guía de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492537&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ef6db2a-3619-449b-8137-65821ae8e868\', \'multiverseId\': 492537}, \'multiverseid\': 492537}, {\'name\': \'Équipement de rechange\', \'text\': "L\'Équipement de rechange arrive sur le champ de bataille engagé.\\nQuand l\'Équipement de rechange arrive sur le champ de bataille, piochez une carte.\\n{2}, {T}, sacrifiez l\'Équipement de rechange : Piochez une carte.", \'type\': \'Artefact\', \'flavor\': "« Il vaut mieux avoir un peu de charge supplémentaire plutôt que de se retrouver dans la gorge d\'un baloth sans couteau. »\\n—Doral, guide de Bala Ged", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492853&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0621c8bc-b4f9-4d60-866e-111a5439a099\', \'multiverseId\': 492853}, \'multiverseid\': 492853}, {\'name\': \'Provviste di Scorta\', \'text\': \'Le Provviste di Scorta entrano nel campo di battaglia TAPpate.\\nQuando le Provviste di Scorta entrano nel campo di battaglia, pesca una carta.\\n{2}, {T}, Sacrifica le Provviste di Scorta: Pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': \'"È meglio portare un po\\\' di peso in più che ritrovarsi mezzi inghiottiti da un baloth senza un coltello."\\n—Doral, guida di Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493169&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'48522360-a289-4425-abb7-4f9dc58d4e16\', \'multiverseId\': 493169}, \'multiverseid\': 493169}, {\'name\': \'予備物資\', \'text\': \'予備物資はタップ状態で戦場に出る。\\n予備物資が戦場に出たとき、カードを１枚引く。\\n{2}, {T}, 予備物資を生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'「荷物が多少重くなる方が、ベイロスに飲み込まれかかったときにナイフがないと気付くよりましだ。」\\n――バーラ・ゲドの案内人、ドーラル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493485&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da897cc8-aa7d-4457-a025-23378631079a\', \'multiverseId\': 493485}, \'multiverseid\': 493485}, {\'name\': \'보급품 여분\', \'text\': \'보급품 여분은 탭된 채로 전장에 들어온다.\\n보급품 여분이 전장에 들어올 때, 카드 한 장을 뽑는다.\\n{2}, {T}, 보급품 여분을 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'마법물체\', \'flavor\': \'"칼 없이 발로스의 목구멍 속으로 반쯤 삼켜지는 것보단 짐을 좀 더 지고 가는 게 더 나아."\\n—발라 게드 안내인, 도랄\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493801&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c99cc44f-aae2-41de-8733-40aa5e3ecc8b\', \'multiverseId\': 493801}, \'multiverseid\': 493801}, {\'name\': \'Suprimentos de Reserva\', \'text\': \'Suprimentos de Reserva entra no campo de batalha virado.\\nQuando Suprimentos de Reserva entrar no campo de batalha, compre um card.\\n{2}, {T}, sacrifique Suprimentos de Reserva: Compre um card.\', \'type\': \'Artefato\', \'flavor\': \'"É melhor levar um pouco de peso a mais do que se ver descendo pela goela de um baloth sem nenhuma faca."\\n— Doral, guia de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494117&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'809e3719-d905-43c5-bec4-5667c7e1839a\', \'multiverseId\': 494117}, \'multiverseid\': 494117}, {\'name\': \'Припасы Впрок\', \'text\': \'Припасы Впрок выходят на поле битвы повернутыми.\\nКогда Припасы Впрок выходят на поле битвы, возьмите карту.\\n{2}, {T}, пожертвуйте Припасы Впрок: возьмите карту.\', \'type\': \'Артефакт\', \'flavor\': \'«Лучше таскать с собой немного лишнего груза, чем вдруг обнаружить себя в глотке балота и без ножа».\\n— Дорал, бала-гедский проводник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494433&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99c4a330-6b47-4598-b05f-d6a905d83659\', \'multiverseId\': 494433}, \'multiverseid\': 494433}, {\'name\': \'备用物资\', \'text\': \'备用物资须横置进战场。\\n当备用物资进战场时，抓一张牌。\\n{2}，{T}，牺牲备用物资：抓一张牌。\', \'type\': \'神器\', \'flavor\': \'「宁愿背包重那么一点，也不要在快被巴洛西吞下时发现手头连刀都没有。」\\n～巴勒格向导多拉尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494749&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce262e60-1a3f-44e5-9642-86eaa44c92ea\', \'multiverseId\': 494749}, \'multiverseid\': 494749}, {\'name\': \'備用物資\', \'text\': \'備用物資須橫置進戰場。\\n當備用物資進戰場時，抽一張牌。\\n{2}，{T}，犧牲備用物資：抽一張牌。\', \'type\': \'神器\', \'flavor\': \'「寧願背包重那麼一點，也不要在快被巴洛西吞下時發現手頭連刀都沒有。」\\n～巴勒格嚮導多拉爾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495065&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'24cfea0f-7304-486b-9aa2-b2f06301b0fd\', \'multiverseId\': 495065}, \'multiverseid\': 495065}]', '[{\'name\': \'Ersehnte Beute\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\\nDurchsuche deine Bibliothek nach einer Karte, nimm sie auf deine Hand und mische dann deine Bibliothek. Falls du eine vollständige Abenteurergruppe hast, kannst du einen Zauberspruch mit umgewandelten Manakosten von 4 oder weniger aus deiner Hand wirken, ohne seine Manakosten zu bezahlen.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492046&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'844ada1b-1aa1-4cae-bf20-3cb90c2a9a5c\', \'multiverseId\': 492046}, \'multiverseid\': 492046}, {\'name\': \'Recompensa codiciada\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\\nBusca en tu biblioteca una carta, ponla en tu mano y luego baraja tu biblioteca. Si tienes un grupo completo, puedes lanzar un hechizo de tu mano con coste de maná convertido de 4 o menos sin pagar su coste de maná.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492362&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71452a94-13c6-4307-8d66-daf667e56f2f\', \'multiverseId\': 492362}, \'multiverseid\': 492362}, {\'name\': \'Prix convoité\', \'text\': "Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)\\nCherchez une carte dans votre bibliothèque, mettez-la dans votre main, et mélangez ensuite votre bibliothèque. Si vous avez un groupe complet, vous pouvez lancer un sort avec un coût converti de mana inférieur ou égal à 4 depuis votre main sans payer son coût de mana.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492678&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55284e65-9bd9-46c1-b088-331a06570936\', \'multiverseId\': 492678}, \'multiverseid\': 492678}, {\'name\': \'Premio Ambito\', \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\\nPassa in rassegna il tuo grimorio per una carta, aggiungila alla tua mano, poi rimescola il tuo grimorio. Se hai una compagnia completa, puoi lanciare una magia con costo di mana convertito pari o inferiore a 4 dalla tua mano senza pagare il suo costo di mana.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f80ee244-ab2b-4659-a557-beed01832390\', \'multiverseId\': 492994}, \'multiverseid\': 492994}, {\'name\': \'切望の報奨\', \'text\': \'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\\nあなたのライブラリーからカード１枚を探し、あなたの手札に加える。その後、あなたのライブラリーを切り直す。あなたのパーティーが全員そろっているなら、あなたはあなたの手札から点数で見たマナ・コストが４以下の呪文１つを、そのマナ・コストを支払うことなく唱えてもよい。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493310&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a3fc055-70d3-4af3-9143-04a2ad50a278\', \'multiverseId\': 493310}, \'multiverseid\': 493310}, {\'name\': \'탐나는 상\', \'text\': \'이 주문은 당신의 파티에 있는 각 생물마다 발동하는 데 {1}이 덜 든다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\\n당신의 서고에서 카드 한 장을 찾아, 당신의 손으로 가져간 후, 당신의 서고를 섞는다. 당신에게 완전한 파티가 있다면, 당신은 당신의 손에서 전환마나비용이 4 이하인 주문을 마나 비용을 지불하지 않고 발동할 수 있다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493626&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'562b99fa-441f-49fa-90b9-10e998a62642\', \'multiverseId\': 493626}, \'multiverseid\': 493626}, {\'name\': \'Prêmio Cobiçado\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada para cada criatura em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\\nProcure um card em seu grimório, coloque-o em sua mão e, depois, embaralhe seu grimório. Se tiver um grupo completo, você pode conjurar uma mágica com custo de mana convertido igual ou inferior a 4 de sua mão sem pagar seu custo de mana.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493942&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'49eeb873-f9f6-4a97-8d97-4cf1e1d90d2b\', \'multiverseId\': 493942}, \'multiverseid\': 493942}, {\'name\': \'Заветный Трофей\', \'text\': \'Разыгрывание этого заклинания стоит на {1} меньше за каждое существо в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\\nНайдите в вашей библиотеке карту, положите ее в вашу руку, затем перетасуйте вашу библиотеку. Если у вас есть полный отряд, вы можете разыграть заклинание с конвертированной мана-стоимостью не более 4 из вашей руки без уплаты его мана-стоимости.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494258&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1f862767-d356-461d-b3fa-d7247de89cbd\', \'multiverseId\': 494258}, \'multiverseid\': 494258}, {\'name\': \'诱人珍品\', \'text\': \'你冒险团中每有一个生物，此咒语便减少{1}来施放。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\\n从你的牌库中搜寻一张牌，将它置于你手上，然后将你的牌库洗牌。如果你的冒险团满编，则你可以从你手上施放一个总法术力费用等于或小于4的咒语，且不需支付其法术力费用。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494574&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d237e3b-62e8-486d-bbf2-4549f7914e10\', \'multiverseId\': 494574}, \'multiverseid\': 494574}, {\'name\': \'誘人珍品\', \'text\': \'你冒險團中每有一個生物，此咒語便減少{1}來施放。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\\n從你的牌庫中搜尋一張牌，將它置於你手上，然後將你的牌庫洗牌。如果你的冒險團滿編，則你可以從你手上施放一個總魔法力費用等於或小於4的咒語，且不需支付其魔法力費用。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494890&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b6a86376-421c-47bd-a2bc-89986072972f\', \'multiverseId\': 494890}, \'multiverseid\': 494890}]', "[{'name': 'Ersehnte Beute', 'text': 'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger.\\nDurchsuche deine Bibliothek nach einer Karte, nimm sie auf deine Hand und mische dann deine Bibliothek. Falls du eine vollständige Abenteurergruppe hast, kannst du einen Zauberspruch mit umgewandelten Manakosten von 4 oder weniger aus deiner Hand wirken, ohne seine Manakosten zu bezahlen.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495696&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6175cbcf-eb70-4f47-b090-ad1cbac321ac', 'multiverseId': 495696}, 'multiverseid': 495696}, {'name': 'Prix convoité', 'text': 'Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe.\\nCherchez une carte dans votre bibliothèque, mettez-la dans votre main, et mélangez ensuite votre bibliothèque. Si vous avez un groupe complet, vous pouvez lancer un sort avec un coût converti de mana inférieur ou égal à 4 depuis votre main sans payer son coût de mana.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495771&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd8f2a8ed-015d-4599-9ef5-f48f4e6373b7', 'multiverseId': 495771}, 'multiverseid': 495771}, {'name': '切望の報奨', 'text': 'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。\\nあなたのライブラリーからカード１枚を探し、あなたの手札に加える。その後、あなたのライブラリーを切り直す。あなたのパーティーが全員そろっているなら、あなたはあなたの手札から点数で見たマナ・コストが４以下の呪文１つを、そのマナ・コストを支払うことなく唱えてもよい。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495846&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ff167c39-68aa-4c20-b766-d348b6a57f7c', 'multiverseId': 495846}, 'multiverseid': 495846}]", '[{\'name\': \'Erwachen von Valakut // Steinschmelze von Valakut\', \'text\': \'Die Steinschmelze von Valakut kommt getappt ins Spiel.\\n{T}: Erzeuge {R}.\\nSpontanzauber\\n{2}{R}\', \'type\': \'Land\', \'flavor\': \'„Ich kann das Echo ihrer seit langem verstummten Hämmer hören."\\n—Tars Olan, Steinschmelz-Mystiker\', \'faceName\': \'Steinschmelze von Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492134&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ab59664-61e9-420f-8e0f-4311eba969ef\', \'multiverseId\': 492134}, \'multiverseid\': 492134}, {\'name\': \'Despertar de Valakut // Fragua de piedra de Valakut\', \'text\': \'La Fragua de piedra de Valakut entra al campo de batalla girada.\\n{T}: Agrega {R}.\\nInstantáneo\\n{2}{R}\', \'type\': \'Tierra\', \'flavor\': \'"Todavía puedo oír el eco de sus martillos, aunque pararon hace mucho".\\n—Tars Olan, místico fragua de piedra\', \'faceName\': \'Fragua de piedra de Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492450&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f66450e-ff52-42ac-ba8f-e04c4c0a1e41\', \'multiverseId\': 492450}, \'multiverseid\': 492450}, {\'name\': \'Éveil de Valakut // Forgepierre de Valakut\', \'text\': \'La Forgepierre de Valakut arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {R}.\\nÉphémère\\n{2}{R}\', \'type\': \'Terrain\', \'flavor\': "« J\'entends l\'écho de leurs marteaux qui ne battent plus depuis longtemps. »\\n—Tars Olan, mystique forgepierre", \'faceName\': \'Forgepierre de Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5317ff21-86b3-43bc-99df-bed1322228f7\', \'multiverseId\': 492766}, \'multiverseid\': 492766}, {\'name\': \'Risveglio di Valakut // Forgia di Pietre di Valakut\', \'text\': \'La Forgia di Pietre di Valakut entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {R}.\\nIstantaneo\\n{2}{R}\', \'type\': \'Terra\', \'flavor\': \'"Riesco a sentire l\\\'eco dei loro martelli, a lungo immobili."\\n—Tars Olan, mistico forgiapietra\', \'faceName\': \'Forgia di Pietre di Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493082&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe4a2e65-fa23-440d-98e0-3c7339522129\', \'multiverseId\': 493082}, \'multiverseid\': 493082}, {\'name\': \'ヴァラクートの覚醒 // ヴァラクートの石鍛冶場\', \'text\': \'ヴァラクートの石鍛冶場はタップ状態で戦場に出る。\\n{T}：{R}を加える。\\nインスタント\\n{2}{R}\', \'type\': \'土地\', \'flavor\': \'「俺にはあのハンマーの音が聞こえるんだ。あの長く静まっていた音が。」\\n――石鍛冶の神秘家、タルズ・オラン\', \'faceName\': \'ヴァラクートの石鍛冶場\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493398&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49e271ad-8cc1-4cca-8289-ea1e3852a73e\', \'multiverseId\': 493398}, \'multiverseid\': 493398}, {\'name\': \'발라쿠트의 각성 // 발라쿠트 암석주조소\', \'text\': \'발라쿠트 암석주조소는 탭된 채로 전장에 들어온다.\\n{T}: {R}를 추가한다.\\n순간마법\\n{2}{R}\', \'type\': \'대지\', \'flavor\': \'"오랫동안 잠잠했던 그분들의 망치소리가 메아리치는 것이 들리는군."\\n—암석주술사 신비주의자, 타즈 오란\', \'faceName\': \'발라쿠트 암석주조소\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493714&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'39088815-2d4f-4e8f-9963-8d6bb6d9a711\', \'multiverseId\': 493714}, \'multiverseid\': 493714}, {\'name\': \'Despertar de Valakut // Litoforja de Valakut\', \'text\': \'Litoforja de Valakut entra no campo de batalha virada.\\n{T}: Adicione {R}.\\nMágica Instantânea\\n{2}{R}\', \'type\': \'Terreno\', \'flavor\': \'"Eu consigo ouvir o eco dos martelos deles, há muito imóveis."\\n— Tars Olan, místico litoforjador\', \'faceName\': \'Litoforja de Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494030&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0333f1d9-492b-42cf-bd5f-5599306399e5\', \'multiverseId\': 494030}, \'multiverseid\': 494030}, {\'name\': \'Пробуждение Валакута // Каменная Кузня Валакута\', \'text\': \'Каменная Кузня Валакута выходит на поле битвы повернутой.\\n{T}: добавьте {R}.\\nМгновенное заклинание\\n{2}{R}\', \'type\': \'Земля\', \'flavor\': \'«Я слышу давно затихшее эхо их молотков».\\n— Тарс Олан, мистик-кователь камней\', \'faceName\': \'Каменная Кузня Валакута\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494346&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2218b72b-36c1-4a04-af8f-b4cf381efbbb\', \'multiverseId\': 494346}, \'multiverseid\': 494346}, {\'name\': \'瓦拉库醒转 // 瓦拉库锻石场\', \'text\': \'瓦拉库锻石场须横置进战场。\\n{T}：加{R}。\\n瞬间\\n{2}{R}\', \'type\': \'地\', \'flavor\': \'「虽然他们的巨锤早已闲置多年，我依然能听见敲打的回响。」\\n～锻石秘教徒塔斯欧岚\', \'faceName\': \'瓦拉库锻石场\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494662&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'039c70fb-9abe-47d7-86dc-cc6e4f1f535a\', \'multiverseId\': 494662}, \'multiverseid\': 494662}, {\'name\': \'瓦拉庫醒轉 // 瓦拉庫鍛石場\', \'text\': \'瓦拉庫鍛石場須橫置進戰場。\\n{T}：加{R}。\\n瞬間\\n{2}{R}\', \'type\': \'地\', \'flavor\': \'「雖然他們的巨鎚早已閒置多年，我依然能聽見敲打的迴響。」\\n～鍛石秘教徒塔斯歐嵐\', \'faceName\': \'瓦拉庫鍛石場\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494978&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'19f19846-a017-4d89-b4eb-eb4ca9ae35a3\', \'multiverseId\': 494978}, \'multiverseid\': 494978}]', '[{\'name\': \'Erwachen von Valakut // Steinschmelze von Valakut\', \'text\': \'Lege eine beliebige Anzahl an Karten aus deiner Hand unter deine Bibliothek und ziehe dann entsprechend viele Karten plus eine.\\nLand\\n{T}: Erzeuge {R}.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Meine Vorfahren gestalteten die Welt nach ihren Vorstellungen neu. Ich selbst habe auch ein paar Ideen."\\n—Tars Olan, Steinschmelz-Mystiker\', \'faceName\': \'Erwachen von Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492134&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ab59664-61e9-420f-8e0f-4311eba969ef\', \'multiverseId\': 492134}, \'multiverseid\': 492134}, {\'name\': \'Despertar de Valakut // Fragua de piedra de Valakut\', \'text\': \'Pon cualquier cantidad de cartas de tu mano en el fondo de tu biblioteca, luego roba esa misma cantidad de cartas más una.\\nTierra\\n{T}: Agrega {R}.\', \'type\': \'Instantáneo\', \'flavor\': \'"Mis antepasados transformaron el mundo según sus puntos de vista. Yo tengo alguna que otra idea".\\n—Tars Olan, místico fragua de piedra\', \'faceName\': \'Despertar de Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492450&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f66450e-ff52-42ac-ba8f-e04c4c0a1e41\', \'multiverseId\': 492450}, \'multiverseid\': 492450}, {\'name\': \'Éveil de Valakut // Forgepierre de Valakut\', \'text\': "Mettez n\'importe quel nombre de cartes de votre main au-dessous de votre bibliothèque, puis piochez autant de cartes plus une.\\nTerrain\\n{T} : Ajoutez {R}.", \'type\': \'Éphémère\', \'flavor\': "« Mes ancêtres ont remodelé le monde selon leur vision. Moi aussi, j\'ai quelques idées. »\\n—Tars Olan, mystique forgepierre", \'faceName\': \'Éveil de Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5317ff21-86b3-43bc-99df-bed1322228f7\', \'multiverseId\': 492766}, \'multiverseid\': 492766}, {\'name\': \'Risveglio di Valakut // Forgia di Pietre di Valakut\', \'text\': \'Metti un qualsiasi numero di carte dalla tua mano in fondo al tuo grimorio, poi pesca altrettante carte più una.\\nTerra\\n{T}: Aggiungi {R}.\', \'type\': \'Istantaneo\', \'flavor\': \'"I miei antenati hanno riplasmato il mondo in base alla loro visione. Anch\\\'io ho in mente qualche idea."\\n—Tars Olan, mistico forgiapietra\', \'faceName\': \'Risveglio di Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493082&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe4a2e65-fa23-440d-98e0-3c7339522129\', \'multiverseId\': 493082}, \'multiverseid\': 493082}, {\'name\': \'ヴァラクートの覚醒 // ヴァラクートの石鍛冶場\', \'text\': \'あなたの手札から望む数のカードをあなたのライブラリーの一番下に置き、その後その枚数に１を足した枚数のカードを引く。\\n土地\\n{T}：{R}を加える。\', \'type\': \'インスタント\', \'flavor\': \'「俺らのご先祖は理想を目指して世界を作り変えた。俺にもちょっとは自分の理想ってやつがあるんだ。」\\n――石鍛冶の神秘家、タルズ・オラン\', \'faceName\': \'ヴァラクートの覚醒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493398&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49e271ad-8cc1-4cca-8289-ea1e3852a73e\', \'multiverseId\': 493398}, \'multiverseid\': 493398}, {\'name\': \'발라쿠트의 각성 // 발라쿠트 암석주조소\', \'text\': \'당신의 손에 있는 카드를 원하는 수만큼 당신의 서고 맨 밑에 놓은 후, 그 수에 1을 더한 만큼 카드를 뽑는다.\\n대지\\n{T}: {R}를 추가한다.\', \'type\': \'순간마법\', \'flavor\': \'"내 조상들은 그분들만의 이상을 가지고 세계를 변화시켰어. 나도 나만의 생각이 몇 가지 있지."\\n—암석주술사 신비주의자, 타즈 오란\', \'faceName\': \'발라쿠트의 각성\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493714&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'39088815-2d4f-4e8f-9963-8d6bb6d9a711\', \'multiverseId\': 493714}, \'multiverseid\': 493714}, {\'name\': \'Despertar de Valakut // Litoforja de Valakut\', \'text\': \'Coloque qualquer número de cards de sua mão no fundo de seu grimório e depois compre aquela quantidade de cards mais um.\\nTerreno\\n{T}: Adicione {R}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Meus ancestrais moldaram o mundo de acordo com a visão deles. Eu tenho algumas ideias próprias."\\n— Tars Olan, místico litoforjador\', \'faceName\': \'Despertar de Valakut\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494030&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0333f1d9-492b-42cf-bd5f-5599306399e5\', \'multiverseId\': 494030}, \'multiverseid\': 494030}, {\'name\': \'Пробуждение Валакута // Каменная Кузня Валакута\', \'text\': \'Положите любое количество карт из вашей руки в низ вашей библиотеки, затем возьмите такое же количество карт плюс одну.\\nЗемля\\n{T}: добавьте {R}.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мои предки переделали мир по своему разумению. У меня есть несколько собственных идей».\\n— Тарс Олан, мистик-кователь камней\', \'faceName\': \'Пробуждение Валакута\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494346&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2218b72b-36c1-4a04-af8f-b4cf381efbbb\', \'multiverseId\': 494346}, \'multiverseid\': 494346}, {\'name\': \'瓦拉库醒转 // 瓦拉库锻石场\', \'text\': \'将任意数量的牌从你手上置于你的牌库底，然后抓该数量加一的牌。\\n地\\n{T}：加{R}。\', \'type\': \'瞬间\', \'flavor\': \'「我的先祖按照他们的视像重塑了整个世界。而我有我自己的想法。」\\n～锻石秘教徒塔斯欧岚\', \'faceName\': \'瓦拉库醒转\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494662&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'039c70fb-9abe-47d7-86dc-cc6e4f1f535a\', \'multiverseId\': 494662}, \'multiverseid\': 494662}, {\'name\': \'瓦拉庫醒轉 // 瓦拉庫鍛石場\', \'text\': \'將任意數量的牌從你手上置於你的牌庫底，然後抽該數量加一的牌。\\n地\\n{T}：加{R}。\', \'type\': \'瞬間\', \'flavor\': \'「我的先祖按照他們的視像重塑了整個世界。而我有我自己的想法。」\\n～鍛石秘教徒塔斯歐嵐\', \'faceName\': \'瓦拉庫醒轉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494978&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'19f19846-a017-4d89-b4eb-eb4ca9ae35a3\', \'multiverseId\': 494978}, \'multiverseid\': 494978}]', '[{\'name\': \'Erwachte Springflut\', \'text\': \'Immer wenn du einen Zauberspruch wirkst und Bonuskosten für ihn bezahlst, hat die Erwachte Springflut Basis-Stärke und -Widerstandskraft 5/5 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„An den meisten Tagen ist das Meer mein Freund. Nicht an allen Tagen."\\n—Jori En, Expeditionsführerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492019&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'03cc0089-b4cd-4a2a-93d8-2f01c8840890\', \'multiverseId\': 492019}, \'multiverseid\': 492019}, {\'name\': \'Marea viva\', \'text\': \'Siempre que lances un hechizo estimulado, la Marea viva tiene una fuerza y resistencia base de 5/5 hasta el final del turno.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"La mayoría de días, el mar es mi amigo. Pero solo la mayoría de días".\\n—Jori En, líder de expedición\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'593afacd-76df-4563-8a4e-b36812da10aa\', \'multiverseId\': 492335}, \'multiverseid\': 492335}, {\'name\': \'Contre-courant émergent\', \'text\': "À chaque fois que vous lancez un sort kické, le Contre-courant émergent a une force et une endurance de base de 5/5 jusqu\'à la fin du tour.", \'type\': \'Créature : élémental\', \'flavor\': "« La plupart du temps, la mer est mon alliée. Mais pas toujours. »\\n—Jori En, chef d\'expédition", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b5fdb198-52fb-4490-bcc7-1ad696da3c9d\', \'multiverseId\': 492651}, \'multiverseid\': 492651}, {\'name\': \'Marea Risvegliata\', \'text\': \'Ogniqualvolta lanci una magia potenziata, la Marea Risvegliata ha forza e costituzione base 5/5 fino alla fine del turno.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Quasi tutti i giorni, il mare è mio amico. Quasi tutti."\\n—Jori En, capo spedizione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492967&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2a1952cf-734d-4239-b932-dbef3eea3ca4\', \'multiverseId\': 492967}, \'multiverseid\': 492967}, {\'name\': \'目覚めし激浪\', \'text\': \'あなたがキッカーされている呪文を唱えるたび、ターン終了時まで、目覚めし激浪の基本のパワーとタフネスは５/５になる。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「普段の海は友人よ。あくまでも普段はね。」\\n――探検隊長、ジョリー・エン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493283&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e0376ad-2144-47f3-86a0-33dbd8bd9a81\', \'multiverseId\': 493283}, \'multiverseid\': 493283}, {\'name\': \'솟구쳐오른 역조\', \'text\': \'당신이 키커 비용이 지불된 주문을 발동할 때마다, 솟구쳐오른 역조는 턴종료까지 기본 공격력과 방어력이 5/5가 된다.\', \'type\': \'생물 — 정령\', \'flavor\': \'"바다는 대체로 내 친구야. 대체로만 말이지."\\n—탐험대 대장 조리 엔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493599&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'329456bc-9c27-450f-9407-11b9e7f297a7\', \'multiverseId\': 493599}, \'multiverseid\': 493599}, {\'name\': \'Rebentação Erguida\', \'text\': \'Toda vez que você conjura uma mágica reforçada, Rebentação Erguida tem poder e resistência básicos 5/5 até o final do turno.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"O mar é meu amigo quase sempre. Quase."\\n— Jori En, líder de expedição\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493915&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39d83251-ead4-44ad-a843-bc90b8061a03\', \'multiverseId\': 493915}, \'multiverseid\': 493915}, {\'name\': \'Восставшая Быстрина\', \'text\': \'Каждый раз, когда вы разыгрываете заклинание, получившее Усилитель, Восставшая Быстрина имеет базовую силу и выносливость 5/5 до конца хода.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Чаще всего море — мой друг. Чаще всего, но не всегда».\\n— Джори-Эн, глава экспедиции\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494231&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce7e5f05-e140-4c0c-ba86-ec55f1845855\', \'multiverseId\': 494231}, \'multiverseid\': 494231}, {\'name\': \'醒转浪涛\', \'text\': \'每当你施放已增幅的咒语时，醒转浪涛的基础力量与防御力为5/5直到回合结束。\', \'type\': \'生物 ～元素\', \'flavor\': \'「大多数日子里，大海都是我的朋友。但也只有大多数日子里是这样。」\\n～探险队长裘黎恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494547&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77494f9b-ef1f-4501-98e1-1ffcbcb4eb6e\', \'multiverseId\': 494547}, \'multiverseid\': 494547}, {\'name\': \'醒轉浪濤\', \'text\': \'每當你施放已增幅的咒語時，醒轉浪濤的基礎力量與防禦力為5/5直到回合結束。\', \'type\': \'生物 ～元素\', \'flavor\': \'「大多數日子裡，大海都是我的朋友。但也只有大多數日子裡是這樣。」\\n～探險隊長裘黎恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494863&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3a8584ef-9e26-4d1e-b3ad-cf793772fb7f\', \'multiverseId\': 494863}, \'multiverseid\': 494863}]', '[{\'name\': \'Erzpriester von Iona\', \'text\': \'Die Stärke des Erzpriesters von Iona ist gleich der Anzahl an Kreaturen in deiner Abenteurergruppe. (Deine Abenteurergruppe besteht aus bis zu je einem Kleriker, Krieger, Räuber und Zauberer)\\nZu Beginn des Kampfes in deinem Zug und falls du eine vollständige Abenteurergruppe hast, erhält eine Kreatur deiner Wahl +1/+1 und Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491942&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe6803aa-7071-442d-81b8-7d9f6bec2f15\', \'multiverseId\': 491942}, \'multiverseid\': 491942}, {\'name\': \'Arcipreste de Iona\', \'text\': \'La fuerza del Arcipreste de Iona es igual a la cantidad de criaturas en tu grupo. (Tu grupo consiste en hasta un Clérigo, un Bribón, un Guerrero y un Hechicero.)\\nAl comienzo del combate en tu turno, si tienes un grupo completo, la criatura objetivo obtiene +1/+1 y gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492258&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1bdc81a6-44f2-4e4b-8510-b4952dfdbad4\', \'multiverseId\': 492258}, \'multiverseid\': 492258}, {\'name\': "Archiprêtre d\'Iona", \'text\': "La force de l\'Archiprêtre d\'Iona est égale au nombre de créatures dans votre groupe. (Votre groupe est composé de jusqu\'à un clerc, un gredin, un guerrier et un sorcier.)\\nAu début du combat pendant votre tour, si vous avez un groupe complet, une créature ciblée gagne +1/+1 et acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492574&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bbd6948-3081-4bef-a846-74788d1f30d8\', \'multiverseId\': 492574}, \'multiverseid\': 492574}, {\'name\': \'Sommo Sacerdote di Iona\', \'text\': "La forza del Sommo Sacerdote di Iona è pari al numero di creature nella tua compagnia. (La tua compagnia può includere fino a un Chierico, un Farabutto, un Guerriero e un Mago.)\\nAll\'inizio del combattimento nel tuo turno, se hai una compagnia completa, una creatura bersaglio prende +1/+1 e ha volare fino alla fine del turno.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492890&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe7352a2-2e35-4116-8993-1cba6f5a0580\', \'multiverseId\': 492890}, \'multiverseid\': 492890}, {\'name\': \'イオナの大司祭\', \'text\': \'イオナの大司祭のパワーはあなたのパーティーを構成しているクリーチャーの総数に等しい。（あなたのパーティーは、ウィザードとクレリックと戦士とならず者それぞれ最大１体から構成される。）\\nあなたのターンの戦闘の開始時に、あなたのパーティーが全員そろっている場合、クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受け飛行を得る。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493206&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c1c921a-259b-42bd-843d-00ff4f9f6864\', \'multiverseId\': 493206}, \'multiverseid\': 493206}, {\'name\': \'아이오나의 대사제\', \'text\': \'아이오나의 대사제의 공격력은 당신의 파티에 있는 생물의 수와 같다. (당신의 파티에는 성직자, 도적, 전사, 마법사가 각각 최대 한 개씩 포함된다.)\\n당신의 턴 전투 시작에, 당신에게 완전한 파티가 있다면, 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받고 비행을 얻는다.\', \'type\': \'생물 — 인간 성직자\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493522&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf860957-f234-4f10-bc19-e59a29c437c9\', \'multiverseId\': 493522}, \'multiverseid\': 493522}, {\'name\': \'Arquissacerdote de Iona\', \'text\': \'O poder de Arquissacerdote de Iona é igual ao número de criaturas em seu grupo. (Seu grupo consiste em até um membro de cada um dos seguintes tipos: Clérigo, Ladino, Guerreiro e Mago.)\\nNo início do combate no seu turno, se você tiver um grupo completo, a criatura alvo recebe +1/+1 e ganha voar até o final do turno.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493838&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'289fb612-5d6a-4a93-9146-8e100c8b4b5e\', \'multiverseId\': 493838}, \'multiverseid\': 493838}, {\'name\': \'Архижрец Ионы\', \'text\': \'Сила Архижреца Ионы равняется количеству существ в вашем отряде. (В вашем отряде может быть не более одного Бродяги, Воина, Священника и Чародея.)\\nВ начале боя во время вашего хода, если у вас есть полный отряд, целевое существо получает +1/+1 и Полет до конца хода.\', \'type\': \'Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494154&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec9f4a54-3fe4-4039-a589-7b7e1c99e1d4\', \'multiverseId\': 494154}, \'multiverseid\': 494154}, {\'name\': \'艾欧娜大祭司\', \'text\': \'艾欧娜大祭司的力量等同于你冒险团中的生物数量。（冒险团由僧侣、浪客、战士和法术师组成，每种类别至多只计入一个。）\\n在你回合的战斗开始时，若你的冒险团满编，则直到回合结束，目标生物得+1/+1且获得飞行异能。\', \'type\': \'生物 ～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494470&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8c7b9b85-fafa-470a-81f0-1a40fcfebbcb\', \'multiverseId\': 494470}, \'multiverseid\': 494470}, {\'name\': \'艾歐娜大祭司\', \'text\': \'艾歐娜大祭司的力量等同於你冒險團中的生物數量。（冒險團由僧侶、浪客、戰士和魔法師組成，每種類別至多只計入一個。）\\n在你回合的戰鬥開始時，若你的冒險團滿編，則直到回合結束，目標生物得+1/+1且獲得飛行異能。\', \'type\': \'生物 ～人類／僧侶\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494786&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0b7b29bb-2a89-42cd-b7cc-a1ecac813c6b\', \'multiverseId\': 494786}, \'multiverseid\': 494786}]', '[{\'name\': \'Erzpriester von Iona\', \'text\': \'Die Stärke des Erzpriesters von Iona ist gleich der Anzahl an Kreaturen in deiner Abenteurergruppe.\\nZu Beginn des Kampfes in deinem Zug und falls du eine vollständige Abenteurergruppe hast, erhält eine Kreatur deiner Wahl +1/+1 und Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495670&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89113291-0f2e-4f45-9b47-ce7db72f2135\', \'multiverseId\': 495670}, \'multiverseid\': 495670}, {\'name\': "Archiprêtre d\'Iona", \'text\': "La force de l\'Archiprêtre d\'Iona est égale au nombre de créatures dans votre groupe.\\nAu début du combat pendant votre tour, si vous avez un groupe complet, une créature ciblée gagne +1/+1 et acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85234244-df50-4b1c-bf68-a5e28e7128e4\', \'multiverseId\': 495745}, \'multiverseid\': 495745}, {\'name\': \'イオナの大司祭\', \'text\': \'イオナの大司祭のパワーはあなたのパーティーを構成しているクリーチャーの総数に等しい。\\nあなたのターンの戦闘の開始時に、あなたのパーティーが全員そろっている場合、クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受け飛行を得る。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495820&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9cad22fd-3130-4db5-ab64-5a1a97a45207\', \'multiverseId\': 495820}, \'multiverseid\': 495820}]', '[{\'name\': \'Feldforschung\', \'text\': \'Bonus {2}{U} (Du kannst zusätzlich {2}{U} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nZiehe zwei Karten. Falls die Bonuskosten dieses Zauberspruchs bezahlt wurden, ziehe stattdessen drei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Hier draußen ist es überlebenswichtig, schnell lesen zu können."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492002&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d6bcde8-26d1-4d0c-9d87-f2311961912c\', \'multiverseId\': 492002}, \'multiverseid\': 492002}, {\'name\': \'Investigación de campo\', \'text\': \'Estímulo {2}{U}. (Puedes pagar {2}{U} adicionales al lanzar este hechizo.)\\nRoba dos cartas. Si este hechizo fue estimulado, en vez de eso, roba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"En mi campo, leer rápido es una habilidad de supervivencia".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492318&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98add840-cdff-4949-98be-470bb6b630e0\', \'multiverseId\': 492318}, \'multiverseid\': 492318}, {\'name\': \'Recherches sur le terrain\', \'text\': \'Kick {2}{U} (Vous pouvez payer {2}{U} supplémentaires au moment où vous lancez ce sort.)\\nPiochez deux cartes. Si ce sort a été kické, piochez trois cartes à la place.\', \'type\': \'Rituel\', \'flavor\': \'« Sur le terrain, la lecture rapide est une technique de survie. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492634&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'debf4212-ccb3-41df-944c-3f051440e6e1\', \'multiverseId\': 492634}, \'multiverseid\': 492634}, {\'name\': \'Ricerca sul Campo\', \'text\': \'Potenziamento {2}{U} (Puoi pagare {2}{U} addizionale mentre lanci questa magia.)\\nPesca due carte. Se questa magia è stata potenziata, pesca invece tre carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Sul campo, la lettura veloce è una dote per la sopravvivenza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492950&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3adf39e9-c756-48c5-a41c-1fe3fb0acf9c\', \'multiverseId\': 492950}, \'multiverseid\': 492950}, {\'name\': \'実地研究\', \'text\': \'キッカー{2}{U}（あなたはこの呪文を唱えるに際し、追加で{2}{U}を支払ってもよい。）\\nカードを２枚引く。この呪文がキッカーされていたなら、代わりにカードを３枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「この現場ではね、速読の技法が生死を分けるのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493266&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e84ed89f-17e0-4b55-9bfe-216b82714912\', \'multiverseId\': 493266}, \'multiverseid\': 493266}, {\'name\': \'현장 연구\', \'text\': \'키커 {2}{U} (당신은 이 주문을 발동하면서 추가로 {2}{U}를 지불할 수 있다.)\\n카드 두 장을 뽑는다. 이 주문의 키커 비용이 지불되었다면, 대신 카드 세 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"현장에서는 속독 능력이 생존 기술이라고."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493582&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d6e40a22-1431-4cfa-8a93-ddfa3bd90a7d\', \'multiverseId\': 493582}, \'multiverseid\': 493582}, {\'name\': \'Pesquisa de Campo\', \'text\': \'Reforçar {2}{U} (Você pode pagar um custo adicional de {2}{U} conforme conjura esta mágica.)\\nCompre dois cards. Se esta mágica tiver sido reforçada, em vez disso, compre três cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Em campo, a leitura dinâmica é uma habilidade de sobrevivência."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493898&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'de6611c6-d2d3-4b15-a217-c053e5bad2b9\', \'multiverseId\': 493898}, \'multiverseid\': 493898}, {\'name\': \'Полевое Исследование\', \'text\': \'Усилитель {2}{U} (При разыгрывании этого заклинания вы можете дополнительно заплатить {2}{U}.)\\nВозьмите две карты. Если это заклинание получило Усилитель, вместо этого возьмите три карты.\', \'type\': \'Волшебство\', \'flavor\': \'«В полевых условиях скорочтение — навык, от которого зависит выживание».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494214&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9d39d046-dbc7-4744-827f-8e769640fa4e\', \'multiverseId\': 494214}, \'multiverseid\': 494214}, {\'name\': \'实地勘验\', \'text\': \'增幅{2}{U}（你施放此咒语时可以额外支付{2}{U}。）\\n抓两张牌。如果此咒语已增幅，则改为抓三张牌。\', \'type\': \'法术\', \'flavor\': \'「到了实地，读得快才能保住命。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494530&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'365bfde0-2d30-401d-a334-a3dd3b45f355\', \'multiverseId\': 494530}, \'multiverseid\': 494530}, {\'name\': \'實地勘驗\', \'text\': \'增幅{2}{U}（你施放此咒語時可以額外支付{2}{U}。）\\n抽兩張牌。如果此咒語已增幅，則改為抽三張牌。\', \'type\': \'巫術\', \'flavor\': \'「到了實地，讀得快才能保住命。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494846&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5ac5b559-62c9-4179-9c2c-9aaacc9168ec\', \'multiverseId\': 494846}, \'multiverseid\': 494846}]', '[{\'name\': \'Felidar-Zuflucht\', \'text\': \'Landung — Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, bestimme eines —\\n• Erzeuge einen 2/2 weißen Katze-Bestie-Kreaturenspielstein.\\n• Lege auf jede Kreatur, die du kontrollierst, eine +1/+1-Marke. Die Kreaturen erhalten Wachsamkeit bis zum Ende des Zuges.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=491954&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ebb4f606-7f1c-4182-8900-7f7ced00509b\', \'multiverseId\': 491954}, \'multiverseid\': 491954}, {\'name\': \'Refugio de felidares\', \'text\': \'Aterrizaje — Siempre que una tierra entre al campo de batalla bajo tu control, elige uno:\\n• Crea una ficha de criatura Bestia Felino blanca 2/2.\\n• Pon un contador +1/+1 sobre cada criatura que controlas. Esas criaturas ganan la habilidad de vigilancia hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492270&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e59f1a9f-3816-4ea7-8703-2da5dea21554\', \'multiverseId\': 492270}, \'multiverseid\': 492270}, {\'name\': \'Refuge félidar\', \'text\': "Toucheterre — À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, choisissez l\'un —\\n• Créez un jeton de créature 2/2 blanche Chat et Bête.\\n• Mettez un marqueur +1/+1 sur chaque créature que vous contrôlez. Ces créatures acquièrent la vigilance jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492586&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'19adce27-277c-4c62-a6ca-55d6b762f2cd\', \'multiverseId\': 492586}, \'multiverseid\': 492586}, {\'name\': \'Rifugio dei Felidar\', \'text\': \'Terraferma — Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, scegli uno —\\n• Crea una pedina creatura Bestia Felino 2/2 bianca.\\n• Metti un segnalino +1/+1 su ogni creatura che controlli. Quelle creature hanno cautela fino alla fine del turno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492902&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee2caa5e-3ac0-42c5-bb2e-ffd7f12bdb35\', \'multiverseId\': 492902}, \'multiverseid\': 492902}, {\'name\': \'フェリダーの撤退\', \'text\': \'上陸 ― 土地が１つあなたのコントロール下で戦場に出るたび、以下から１つを選ぶ。\\n• 白の２/２の猫・ビースト・クリーチャー・トークンを１体生成する。\\n•あなたがコントロールしている各クリーチャーの上に、＋１/＋１カウンターをそれぞれ１個置く。ターン終了時まで、それらのクリーチャーは警戒を得る。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493218&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72b171ff-5199-4d43-bafd-936a73c73b70\', \'multiverseId\': 493218}, \'multiverseid\': 493218}, {\'name\': \'펠리다르 후퇴\', \'text\': \'대지력 — 대지가 당신의 조종하에 전장에 들어올 때마다, 하나를 선택한다 —\\n• 2/2 백색 고양이 야수 생물 토큰 한 개를 만든다.\\n• 당신이 조종하는 각 생물에 +1/+1 카운터 한 개를 올려놓는다. 그 생물들은 턴종료까지 경계를 얻는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493534&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'43dedb7e-0627-4c3d-bc40-040fafbbdd12\', \'multiverseId\': 493534}, \'multiverseid\': 493534}, {\'name\': \'Refúgio dos Felidares\', \'text\': \'Aterragem — Toda vez que um terreno entrar no campo de batalha sob seu controle, escolha um —\\n• Crie uma ficha de criatura branca 2/2 do tipo Felino Besta.\\n• Coloque um marcador +1/+1 em cada criatura que você controla. Aquelas criaturas ganham vigilância até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493850&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bed79815-6a9a-4706-95f7-9dad1244724a\', \'multiverseId\': 493850}, \'multiverseid\': 493850}, {\'name\': \'Укрытие Фелидаров\', \'text\': \'Землепад — Каждый раз, когда земля выходит на поле битвы под вашим контролем, выберите одно —\\n• Создайте одну фишку существа 2/2 белая Кошка Зверь.\\n• Положите один жетон +1/+1 на каждое существо под вашим контролем. Те существа получают Бдительность до конца хода.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494166&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'513031e8-e228-4edf-969d-5e976d8d188f\', \'multiverseId\': 494166}, \'multiverseid\': 494166}, {\'name\': \'晶角兽生息所\', \'text\': \'地落～每当一个地在你的操控下进战场时，选择一项～\\n•派出一个2/2白色的猫／野兽衍生生物。\\n•在每个由你操控的生物上各放置一个+1/+1指示物。这些生物获得警戒异能直到回合结束。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494482&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af2b314c-d330-48f4-84e0-d7690eaf46b9\', \'multiverseId\': 494482}, \'multiverseid\': 494482}, {\'name\': \'晶角獸生息所\', \'text\': \'地落～每當一個地在你的操控下進戰場時，選擇一項～\\n‧派出一個2/2白色的貓／野獸衍生生物。\\n‧在每個由你操控的生物上各放置一個+1/+1指示物。這些生物獲得警戒異能直到回合結束。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494798&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'60382159-f224-4a3b-9091-8c2224431597\', \'multiverseId\': 494798}, \'multiverseid\': 494798}]', '[{\'name\': \'Felidar-Zuflucht\', \'text\': \'Landung — Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, bestimme eines —\\n• Erzeuge einen 2/2 weißen Katze-Bestie-Kreaturenspielstein.\\n• Lege auf jede Kreatur, die du kontrollierst, eine +1/+1-Marke. Die Kreaturen erhalten Wachsamkeit bis zum Ende des Zuges.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495213&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'15eff6b2-2eff-4002-8096-f7395981f37f\', \'multiverseId\': 495213}, \'multiverseid\': 495213}, {\'name\': \'Refugio de felidares\', \'text\': \'Aterrizaje — Siempre que una tierra entre al campo de batalla bajo tu control, elige uno:\\n• Crea una ficha de criatura Bestia Felino blanca 2/2.\\n• Pon un contador +1/+1 sobre cada criatura que controlas. Esas criaturas ganan la habilidad de vigilancia hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ca9d0d0-7653-4f6b-ab77-4a42481f134f\', \'multiverseId\': 495238}, \'multiverseid\': 495238}, {\'name\': \'Refuge félidar\', \'text\': "Toucheterre — À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, choisissez l\'un —\\n• Créez un jeton de créature 2/2 blanche Chat et Bête.\\n• Mettez un marqueur +1/+1 sur chaque créature que vous contrôlez. Ces créatures acquièrent la vigilance jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495263&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db7a85c7-13a7-44c0-a26f-f18ecffdc0f0\', \'multiverseId\': 495263}, \'multiverseid\': 495263}, {\'name\': \'Rifugio dei Felidar\', \'text\': \'Terraferma — Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, scegli uno —\\n• Crea una pedina creatura Bestia Felino 2/2 bianca.\\n• Metti un segnalino +1/+1 su ogni creatura che controlli. Quelle creature hanno cautela fino alla fine del turno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495288&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0737644-450a-487d-8b94-b1ca5701c2d4\', \'multiverseId\': 495288}, \'multiverseid\': 495288}, {\'name\': \'フェリダーの撤退\', \'text\': \'上陸 ― 土地が１つあなたのコントロール下で戦場に出るたび、以下から１つを選ぶ。\\n• 白の２/２の猫・ビースト・クリーチャー・トークンを１体生成する。\\n•あなたがコントロールしている各クリーチャーの上に、＋１/＋１カウンターをそれぞれ１個置く。ターン終了時まで、それらのクリーチャーは警戒を得る。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495313&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5ac9103-d9e0-413c-94af-eec77f0007ea\', \'multiverseId\': 495313}, \'multiverseid\': 495313}, {\'name\': \'펠리다르 후퇴\', \'text\': \'대지력 — 대지가 당신의 조종하에 전장에 들어올 때마다, 하나를 선택한다 —\\n• 2/2 백색 고양이 야수 생물 토큰 한 개를 만든다.\\n• 당신이 조종하는 각 생물에 +1/+1 카운터 한 개를 올려놓는다. 그 생물들은 턴종료까지 경계를 얻는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495338&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f391ca9d-ea91-4d7e-901e-54350bcc6912\', \'multiverseId\': 495338}, \'multiverseid\': 495338}, {\'name\': \'Refúgio dos Felidares\', \'text\': \'Aterragem — Toda vez que um terreno entrar no campo de batalha sob seu controle, escolha um —\\n• Crie uma ficha de criatura branca 2/2 do tipo Felino Besta.\\n• Coloque um marcador +1/+1 em cada criatura que você controla. Aquelas criaturas ganham vigilância até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495363&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b3629f3-75b7-4ee8-b87e-37d3b63234eb\', \'multiverseId\': 495363}, \'multiverseid\': 495363}, {\'name\': \'Укрытие Фелидаров\', \'text\': \'Землепад — Каждый раз, когда земля выходит на поле битвы под вашим контролем, выберите одно —\\n• Создайте одну фишку существа 2/2 белая Кошка Зверь.\\n• Положите один жетон +1/+1 на каждое существо под вашим контролем. Те существа получают Бдительность до конца хода.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495388&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d9c29e95-b33c-4004-950f-39cef62132b1\', \'multiverseId\': 495388}, \'multiverseid\': 495388}, {\'name\': \'晶角兽生息所\', \'text\': \'地落～每当一个地在你的操控下进战场时，选择一项～\\n•派出一个2/2白色的猫／野兽衍生生物。\\n•在每个由你操控的生物上各放置一个+1/+1指示物。这些生物获得警戒异能直到回合结束。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495413&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1582a6ef-df8d-4c99-89fa-1cac43bfbf0a\', \'multiverseId\': 495413}, \'multiverseid\': 495413}, {\'name\': \'晶角獸生息所\', \'text\': \'地落～每當一個地在你的操控下進戰場時，選擇一項～\\n‧派出一個2/2白色的貓／野獸衍生生物。\\n‧在每個由你操控的生物上各放置一個+1/+1指示物。這些生物獲得警戒異能直到回合結束。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495438&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'856f9be2-84cf-420f-b72a-2f03105adcec\', \'multiverseId\': 495438}, \'multiverseid\': 495438}]', '[{\'name\': \'Felskronen-Höhenweg // Waldkronen-Höhenweg\', \'text\': \'{T}: Erzeuge {G}.\\nLand\\n{T}: Erzeuge {R}.\', \'type\': \'Land\', \'flavor\': \'„Lauf schnell und ignoriere das Gebrüll aus dem Unterholz."\\n—Enwor aus Seetors Expeditionsgildenhaus\', \'faceName\': \'Waldkronen-Höhenweg\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492231&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe4d9afe-9313-44e1-baf9-927d21ea72cd\', \'multiverseId\': 492231}, \'multiverseid\': 492231}, {\'name\': \'Senda de Cumbrerriscos // Senda de Cumbremadera\', \'text\': \'{T}: Agrega {G}.\\nTierra\\n{T}: Agrega {R}.\', \'type\': \'Tierra\', \'flavor\': \'"Camina deprisa y haz caso omiso a cualquier rugido del sotobosque".\\n—Enwor, Casa expedicionaria de Portal Marino\', \'faceName\': \'Senda de Cumbremadera\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492547&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eda37a1b-c886-4006-94c4-acb554baed7d\', \'multiverseId\': 492547}, \'multiverseid\': 492547}, {\'name\': \'Passage de Cimeroche // Passage de Cimebois\', \'text\': \'{T} : Ajoutez {G}.\\nTerrain\\n{T} : Ajoutez {R}.\', \'type\': \'Terrain\', \'flavor\': \'« Dépêchez-vous et ne faites pas attention aux grognements dans les sous-bois. »\\n—Enwor, corps expéditionnaire de Porte des Mers\', \'faceName\': \'Passage de Cimebois\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492863&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b93dcc2-eefa-4a95-8285-41ac82c5d1b3\', \'multiverseId\': 492863}, \'multiverseid\': 492863}, {\'name\': \'Cammino della Corona di Rupi // Cammino della Corona di Legno\', \'text\': \'{T}: Aggiungi {G}.\\nTerra\\n{T}: Aggiungi {R}.\', \'type\': \'Terra\', \'flavor\': \'"Cammina velocemente e ignora i ruggiti provenienti dal sottobosco."\\n—Enwor, Casa di Spedizioni di Portale Marino\', \'faceName\': \'Cammino della Corona di Legno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493179&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6d41b52-ad9e-4f3a-93f1-846e0cf34ebb\', \'multiverseId\': 493179}, \'multiverseid\': 493179}, {\'name\': \'岩山被りの小道 // 樹木被りの小道\', \'text\': \'{T}：{G}を加える。\', \'type\': \'土地\', \'flavor\': \'「足早に歩き、下から聞こえる咆哮は無視するのだ。」\\n――海門探検協会のエンウォール\', \'faceName\': \'樹木被りの小道\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493495&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'924a7f4b-3bc4-4666-bcfb-c28722d1fa50\', \'multiverseId\': 493495}, \'multiverseid\': 493495}, {\'name\': \'바위왕관 경로 // 나무왕관 경로\', \'text\': \'{T}: {G}를 추가한다.\\n대지\\n{T}: {R}를 추가한다.\', \'type\': \'대지\', \'flavor\': \'"빠르게 걷고, 아래 덤불에서 들리는 포효들은 전부 무시해."\\n—바다 관문 탐험 가문, 엔워르\', \'faceName\': \'나무왕관 경로\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493811&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c89d543-36ee-40bb-942a-00c3648d3ed9\', \'multiverseId\': 493811}, \'multiverseid\': 493811}, {\'name\': \'Trilha da Coroa de Penedos // Trilha da Coroa de Lenho\', \'text\': \'{T}: Adicione {G}.\\nTerreno\\n{T}: Adicione {R}.\', \'type\': \'Terreno\', \'flavor\': \'"Andem rápido e ignorem quaisquer rugidos debaixo da terra."\\n— Enwor, Casa Expedicionária de Portão Marinho\', \'faceName\': \'Trilha da Coroa de Lenho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494127&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'97a44ac1-22a4-4b80-ac01-811707a9ceb4\', \'multiverseId\': 494127}, \'multiverseid\': 494127}, {\'name\': \'Тропа Горного Венца // Тропа Лесного Венца\', \'text\': \'{T}: добавьте {G}.\\nЗемля\\n{T}: добавьте {R}.\', \'type\': \'Земля\', \'flavor\': \'«Идите не задерживаясь, а если из подлеска будет доноситься рык, не обращайте внимания».\\n— Энвор из Мореградского экспедиционного дома\', \'faceName\': \'Тропа Лесного Венца\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494443&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'68e94da4-239a-4874-87d7-c21eb59d0efb\', \'multiverseId\': 494443}, \'multiverseid\': 494443}, {\'name\': \'岩冠通路 // 丛冠通路\', \'text\': \'{T}：加{G}。\\n地\\n{T}：加{R}。\', \'type\': \'地\', \'flavor\': \'「快速通过，不要理会底下的嚎叫声。」\\n～海户探险队的恩沃\', \'faceName\': \'丛冠通路\