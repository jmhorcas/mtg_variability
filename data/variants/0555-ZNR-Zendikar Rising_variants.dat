.ashx?multiverseid=495096&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'be4951e6-917b-4f0c-9ffb-0bb75559496b', 'multiverseId': 495096}, 'multiverseid': 495096}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492253&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7a321a81-11af-47c3-a493-ef15bf89976a', 'multiverseId': 492253}, 'multiverseid': 492253}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492569&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ffa13d4c-6c5e-44bd-859e-38e79d47a916', 'multiverseId': 492569}, 'multiverseid': 492569}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492885&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5248dacc-589a-4f3a-a02c-d94cba4ebdf8', 'multiverseId': 492885}, 'multiverseid': 492885}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493201&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '35f1e450-c527-4f45-a68d-44c0133d6c27', 'multiverseId': 493201}, 'multiverseid': 493201}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493517&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3e235445-d701-449b-b5ee-4de3f0614b89', 'multiverseId': 493517}, 'multiverseid': 493517}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493833&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '70a19569-f738-43e9-acc0-154e47d07eab', 'multiverseId': 493833}, 'multiverseid': 493833}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494149&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '707f3d90-8135-4336-8033-cacc379f8a54', 'multiverseId': 494149}, 'multiverseid': 494149}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494465&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b3678627-9f3e-4e5c-bf59-d559d442d7d7', 'multiverseId': 494465}, 'multiverseid': 494465}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494781&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '57661c55-93ca-407d-a3d4-2abb26e4008b', 'multiverseId': 494781}, 'multiverseid': 494781}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495097&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '64420ea1-7555-4057-98c8-65ab34f62205', 'multiverseId': 495097}, 'multiverseid': 495097}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495107&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cd4cf73d-a408-48f1-9931-54707553c5d5', 'multiverseId': 495107}, 'multiverseid': 495107}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495112&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '84cf766c-19cf-4682-a7f0-04c33f21bf86', 'multiverseId': 495112}, 'multiverseid': 495112}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495117&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ab47e5c7-84b0-4668-8a39-37a566402bf6', 'multiverseId': 495117}, 'multiverseid': 495117}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495122&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cb216b4a-97bf-4f02-8c32-4c1d2486ebda', 'multiverseId': 495122}, 'multiverseid': 495122}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495127&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4f8d0484-8342-43e4-bf93-c1f76cbbeb0e', 'multiverseId': 495127}, 'multiverseid': 495127}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495132&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bc5359ea-4927-4a77-95fb-3988442e3848', 'multiverseId': 495132}, 'multiverseid': 495132}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495137&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ded0aa9c-68ad-4afa-870b-757a8f13f166', 'multiverseId': 495137}, 'multiverseid': 495137}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495142&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4de8c382-3f85-4453-bb75-8a0f0df9880e', 'multiverseId': 495142}, 'multiverseid': 495142}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495147&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '433a69f0-4532-495a-8c2b-4e75f4b573a3', 'multiverseId': 495147}, 'multiverseid': 495147}, {'name': '樹林', 'type': '基本地 ～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495152&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b1243df2-fe3d-4137-8739-8fa8ba06c2c6', 'multiverseId': 495152}, 'multiverseid': 495152}]", '[{\'name\': \'Wendholzwald-Asket\', \'text\': \'Wenn der Wendholzwald-Asket ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\', \'type\': \'Kreatur — Riese, Kleriker\', \'flavor\': \'„So lange schrie dieses Land vor Schmerz. Jetzt, da alles wieder ins Gleichgewicht zurückkehrt, hallt eine neue Harmonie zwischen den Bäumen wider."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492179&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b65e1673-b905-4908-b7b7-b67a7ef375e9\', \'multiverseId\': 492179}, \'multiverseid\': 492179}, {\'name\': \'Asceta de Madera Torcida\', \'text\': \'Cuando el Asceta de Madera Torcida entre al campo de batalla, ganas 3 vidas.\', \'type\': \'Criatura — Clérigo gigante\', \'flavor\': \'"Esta tierra lleva gritando de dolor mucho tiempo. Ahora que el flujo vuelve a estar equilibrado, una nueva armonía resuena por los árboles".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492495&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8468bcab-cba4-4a98-8427-a8fccc7819c5\', \'multiverseId\': 492495}, \'multiverseid\': 492495}, {\'name\': \'Ascète de Tournebois\', \'text\': "Quand l\'Ascète de Tournebois arrive sur le champ de bataille, vous gagnez 3 points de vie.", \'type\': \'Créature : géant et clerc\', \'flavor\': "« Pendant trop longtemps, cette terre a hurlé de douleur. Aujourd\'hui, le flux retourne à son point d\'équilibre, et une nouvelle harmonie résonne dans les arbres. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492811&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b4ca4ce0-2c91-46f9-8053-68f71dc5be20\', \'multiverseId\': 492811}, \'multiverseid\': 492811}, {\'name\': \'Asceta di Legnotorto\', \'text\': "Quando l\'Asceta di Legnotorto entra nel campo di battaglia, guadagni 3 punti vita.", \'type\': \'Creatura — Chierico Gigante\', \'flavor\': \'"Per molto tempo, questa terra ha gridato sofferente. Ora, mentre il flusso torna al suo punto di equilibrio, una nuova armonia riecheggia tra gli alberi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493127&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e58438e-0da4-475c-855d-5309407884f2\', \'multiverseId\': 493127}, \'multiverseid\': 493127}, {\'name\': \'変わり樹の苦行者\', \'text\': \'変わり樹の苦行者が戦場に出たとき、あなたは３点のライフを得る。\', \'type\': \'クリーチャー — 巨人・クレリック\', \'flavor\': \'「長いことこの土地は苦痛に叫んでいた。流れがバランスを取り戻した今は、木々の間に新たな調和がこだましている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493443&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b924cce5-bcdd-403d-9de0-cd44265ec287\', \'multiverseId\': 493443}, \'multiverseid\': 493443}, {\'name\': \'변화림 금욕주의자\', \'text\': \'변화림 금욕주의자가 전장에 들어올 때, 당신은 생명 3점을 얻는다.\', \'type\': \'생물 — 거인 성직자\', \'flavor\': \'"아주 오랫동안, 이 대지는 고통에 차 울부짖었다. 이제, 흐름이 균형점으로 돌아왔으니, 새로운 화음이 숲 속에 메아리친다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493759&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'24be801e-4cab-47fc-815f-73f150b8694e\', \'multiverseId\': 493759}, \'multiverseid\': 493759}, {\'name\': \'Asceta de Virapau\', \'text\': \'Quando Asceta de Virapau entra no campo de batalha, você ganha 3 pontos de vida.\', \'type\': \'Criatura — Gigante Clérigo\', \'flavor\': \'"Por tanto tempo essa terra gritou de dor. Agora, conforme o fluxo volta a seu ponto de equilíbrio, ecoa nas árvores uma nova harmonia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494075&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d126ae7-7c1e-4c5f-8a45-19763593ee33\', \'multiverseId\': 494075}, \'multiverseid\': 494075}, {\'name\': \'Аскет Криволесья\', \'text\': \'Когда Аскет Криволесья выходит на поле битвы, вы получаете 3 жизни.\', \'type\': \'Существо — Гигант Священник\', \'flavor\': \'«Эта земля долго кричала от боли. Теперь же, когда поток пришел в равновесие, новая гармония раздается в ветвях деревьев».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494391&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'caea8c18-a65a-45da-a45f-e9a05f4b0ab0\', \'multiverseId\': 494391}, \'multiverseid\': 494391}, {\'name\': \'旋林苦修士\', \'text\': \'当旋林苦修士进战场时，你获得3点生命。\', \'type\': \'生物 ～巨人／僧侣\', \'flavor\': \'「许多年来，这片大陆在痛苦呻吟。如今能量流动重归平衡，林木之间回响着全新和韵。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494707&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac560076-f467-47bf-9f4d-c8d823162b7a\', \'multiverseId\': 494707}, \'multiverseid\': 494707}, {\'name\': \'旋林苦修士\', \'text\': \'當旋林苦修士進戰場時，你獲得3點生命。\', \'type\': \'生物 ～巨人／僧侶\', \'flavor\': \'「許多年來，這片大陸在痛苦呻吟。如今能量流動重歸平衡，林木之間迴響著全新和韻。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495023&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3b08097f-0ff1-4a3d-a018-f19d773e4318\', \'multiverseId\': 495023}, \'multiverseid\': 495023}]', "[{'name': 'Wendholzwald-Symbiose // Wendholz, der Verschlungene Wald', 'text': 'Schaue dir die obersten sieben Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte ins Spiel bringen. Falls die Karte umgewandelte Manakosten von 3 oder weniger hat, kommt sie mit drei zusätzlichen +1/+1-Marken ins Spiel. Lege den Rest in zufälliger Reihenfolge unter deine Bibliothek.\\nLand\\n{T}: Erzeuge {G}.', 'type': 'Hexerei', 'flavor': None, 'faceName': 'Wendholzwald-Symbiose', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492180&type=card', 'language': 'German', 'identifiers': {'scryfallId': '57edd9a8-9b0a-4784-9b7d-4157a5f80558', 'multiverseId': 492180}, 'multiverseid': 492180}, {'name': 'Simbiosis de Madera Torcida // Madera Torcida, bosque serpentino', 'text': 'Mira las siete primeras cartas de tu biblioteca. Puedes poner en el campo de batalla una carta de criatura que se encuentre entre ellas. Si el coste de maná convertido de esa carta es de 3 o menos, entra con tres contadores +1/+1 adicionales sobre ella. Pon el resto en el fondo de tu biblioteca en un orden aleatorio.\\nTierra\\n{T}: Agrega {G}.', 'type': 'Conjuro', 'flavor': None, 'faceName': 'Simbiosis de Madera Torcida', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492496&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c256ff84-d975-4320-aa0f-2329d6a33d00', 'multiverseId': 492496}, 'multiverseid': 492496}, {'name': 'Symbiose de Tournebois // Tournebois, le bois sinueux', 'text': 'Regardez les sept cartes du dessus de votre bibliothèque. Vous pouvez mettre sur le champ de bataille une carte de créature parmi elles. Si cette carte a un coût converti de mana inférieur ou égal à 3, elle arrive avec trois marqueurs +1/+1 supplémentaires sur elle. Mettez le reste au-dessous de votre bibliothèque dans un ordre aléatoire.\\nTerrain\\n{T} : Ajoutez {G}.', 'type': 'Rituel', 'flavor': None, 'faceName': 'Symbiose de Tournebois', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492812&type=card', 'language': 'French', 'identifiers': {'scryfallId': '94e1f9e6-7518-4555-9331-14b333b0f445', 'multiverseId': 492812}, 'multiverseid': 492812}, {'name': 'Simbiosi di Legnotorto // Legnotorto, Bosco Serpeggiante', 'text': 'Guarda le prime sette carte del tuo grimorio. Puoi mettere sul campo di battaglia una carta creatura scelta tra esse. Se quella carta ha un costo di mana convertito pari o inferiore a 3, entra con tre segnalini +1/+1 addizionali. Metti le altre in fondo al tuo grimorio in ordine casuale.\\nTerra\\n{T}: Aggiungi {G}.', 'type': 'Stregoneria', 'flavor': None, 'faceName': 'Simbiosi di Legnotorto', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493128&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e911557f-2a3d-4afa-b24a-bc52b5f89f47', 'multiverseId': 493128}, 'multiverseid': 493128}, {'name': '変わり樹の共生 // うねる森、変わり樹', 'text': 'あなたのライブラリーの一番上からカードを７枚見る。あなたはその中からクリーチャー・カード１枚を戦場に出してもよい。そのカードの点数で見たマナ・コストが３以下であったなら、それは＋１/＋１カウンターが追加で３個置かれた状態で戦場に出る。残りをあなたのライブラリーの一番下に無作為の順番で置く。\\n土地\\n{T}：{G}を加える。', 'type': 'ソーサリー', 'flavor': None, 'faceName': '変わり樹の共生', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493444&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dac266c7-87eb-43e7-baa4-691a717b5f43', 'multiverseId': 493444}, 'multiverseid': 493444}, {'name': '변화림 공생 // 굽이치는 숲, 변화림', 'text': '당신의 서고 맨 위 카드 일곱 장을 본다. 당신은 그중에서 생물 카드 한 장을 전장에 놓을 수 있다. 그 카드의 전환마나비용이 3 이하라면, 그 생물은 +1/+1 카운터 세 개를 추가로 가지고 들어온다. 나머지 카드들은 무작위 순서로 당신의 서고 맨 밑에 놓는다.\\n대지\\n{T}: {G}를 추가한다.', 'type': '집중마법', 'flavor': None, 'faceName': '변화림 공생', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493760&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '14a79c3d-4208-4664-9ff3-3a4c76cbf891', 'multiverseId': 493760}, 'multiverseid': 493760}, {'name': 'Simbiose de Virapau // Virapau, Mata Serpentina', 'text': 'Olhe os sete cards do topo de seu grimório. Você pode colocar um card de criatura dentre eles no campo de batalha. Se aquele card tiver um custo de mana convertido igual ou inferior a 3, ele entra no campo de batalha com três marcadores +1/+1 adicionais. Coloque o restante no fundo de seu grimório em ordem aleatória.\\nTerreno\\n{T}: Adicione {G}.', 'type': 'Feitiço', 'flavor': None, 'faceName': 'Simbiose de Virapau', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494076&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '37574902-c2dd-4505-b875-978cefed81af', 'multiverseId': 494076}, 'multiverseid': 494076}, {'name': 'Симбиоз Криволесья // Криволесье, Змеящийся Лес', 'text': 'Посмотрите семь верхних карт вашей библиотеки. Вы можете положить на поле битвы находящуюся среди них карту существа. Если конвертированная мана-стоимость той карты не более 3, она выходит на поле битвы с тремя дополнительными жетонами +1/+1 на ней. Положите остальные карты в низ вашей библиотеки в случайном порядке.\\nЗемля\\n{T}: добавьте {G}.', 'type': 'Волшебство', 'flavor': None, 'faceName': 'Симбиоз Криволесья', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494392&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '53be7ed3-d981-441d-bdc3-6dc4e2a0831f', 'multiverseId': 494392}, 'multiverseid': 494392}, {'name': '旋林共生 // 曲木旋林', 'text': '检视你牌库顶的七张牌。你可以将其中的一张生物牌放进战场。如果该牌的总法术力费用等于或小于3，则它进战场时上面额外有三个+1/+1指示物。将其余的牌以随机顺序置于你的牌库底。\\n地\\n{T}：加{G}。', 'type': '法术', 'flavor': None, 'faceName': '旋林共生', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494708&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3fffb755-292f-4634-989e-9ee8aaa837c3', 'multiverseId': 494708}, 'multiverseid': 494708}, {'name': '旋林共生 // 曲木旋林', 'text': '檢視你牌庫頂的七張牌。你可以將其中的一張生物牌放進戰場。如果該牌的總魔法力費用等於或小於3，則它進戰場時上面額外有三個+1/+1指示物。將其餘的牌以隨機順序置於你的牌庫底。\\n地\\n{T}：加{G}。', 'type': '巫術', 'flavor': None, 'faceName': '旋林共生', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495024&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'be7511da-1b65-4adf-a0f9-51a6d36f214b', 'multiverseId': 495024}, 'multiverseid': 495024}]", '[{\'name\': \'Wendholzwald-Symbiose // Wendholz, der Verschlungene Wald\', \'text\': \'Sowie Wendholz, der Verschlungene Wald, ins Spiel kommt, kannst du 3 Lebenspunkte bezahlen. Falls du dies nicht tust, kommt er getappt ins Spiel.\\n{T}: Erzeuge {G}.\\nHexerei\\n{4}{G}{G}{G}\', \'type\': \'Land\', \'flavor\': \'„Die Bäume hier winden sich um Stacheln aus Mana und ernähren sich von der darin fließenden Energie."\\n—Jori En, Expeditionsführerin\', \'faceName\': \'Wendholz, der Verschlungene Wald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492180&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57edd9a8-9b0a-4784-9b7d-4157a5f80558\', \'multiverseId\': 492180}, \'multiverseid\': 492180}, {\'name\': \'Simbiosis de Madera Torcida // Madera Torcida, bosque serpentino\', \'text\': \'En cuanto Madera Torcida, bosque serpentino entre al campo de batalla, puedes pagar 3 vidas. Si no lo haces, entra al campo de batalla girado.\\n{T}: Agrega {G}.\\nConjuro\\n{4}{G}{G}{G}\', \'type\': \'Tierra\', \'flavor\': \'"Los árboles de por aquí envuelven fuentes de maná y se nutren del poder que emanan".\\n—Jori En, líder de expedición\', \'faceName\': \'Madera Torcida, bosque serpentino\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492496&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c256ff84-d975-4320-aa0f-2329d6a33d00\', \'multiverseId\': 492496}, \'multiverseid\': 492496}, {\'name\': \'Symbiose de Tournebois // Tournebois, le bois sinueux\', \'text\': \'Au moment où Tournebois, le bois sinueux arrive sur le champ de bataille, vous pouvez payer 3 points de vie. Si vous ne le faites pas, il arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G}.\\nRituel\\n{4}{G}{G}{G}\', \'type\': \'Terrain\', \'flavor\': "« Ici, les arbres s\'enroulent autour des pics de mana et se nourrissent du flux d\'énergie. »\\n—Jori En, chef d\'expédition", \'faceName\': \'Tournebois, le bois sinueux\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492812&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94e1f9e6-7518-4555-9331-14b333b0f445\', \'multiverseId\': 492812}, \'multiverseid\': 492812}, {\'name\': \'Simbiosi di Legnotorto // Legnotorto, Bosco Serpeggiante\', \'text\': \'Mentre Legnotorto, Bosco Serpeggiante entra nel campo di battaglia, puoi pagare 3 punti vita. Se non lo fai, entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G}.\\nStregoneria\\n{4}{G}{G}{G}\', \'type\': \'Terra\', \'flavor\': \'"Gli alberi qui si attorcigliano attorno ai getti di mana, nutrendosi del potere che fluisce."\\n—Jori En, capo spedizione\', \'faceName\': \'Legnotorto, Bosco Serpeggiante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493128&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e911557f-2a3d-4afa-b24a-bc52b5f89f47\', \'multiverseId\': 493128}, \'multiverseid\': 493128}, {\'name\': \'変わり樹の共生 // うねる森、変わり樹\', \'text\': \'うねる森、変わり樹が戦場に出るに際し、あなたは３点のライフを支払ってもよい。そうしないなら、これはタップ状態で戦場に出る。\\n{T}：{G}を加える。\\nソーサリー\\n{4}{G}{G}{G}\', \'type\': \'土地\', \'flavor\': \'「ここでは木々がマナの棘に巻き付くようにねじれて、そこから流れる魔力を得ている。」\\n――探検隊長、ジョリー・エン\', \'faceName\': \'うねる森、変わり樹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493444&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dac266c7-87eb-43e7-baa4-691a717b5f43\', \'multiverseId\': 493444}, \'multiverseid\': 493444}, {\'name\': \'변화림 공생 // 굽이치는 숲, 변화림\', \'text\': \'굽이치는 숲, 변화림이 전장에 들어오면서, 당신은 생명 3점을 지불할 수 있다. 그러지 않으면, 변화림은 탭된 채로 전장에 들어온다.\\n{T}: {G}를 추가한다.\\n집중마법\\n{4}{G}{G}{G}\', \'type\': \'대지\', \'flavor\': \'"이곳의 나무들은 마나의 가시 주변을 휘감으면서 흘러넘치는 힘에서 양분을 얻고 있어."\\n—탐험대 대장 조리 엔\', \'faceName\': \'굽이치는 숲, 변화림\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493760&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'14a79c3d-4208-4664-9ff3-3a4c76cbf891\', \'multiverseId\': 493760}, \'multiverseid\': 493760}, {\'name\': \'Simbiose de Virapau // Virapau, Mata Serpentina\', \'text\': \'Conforme Virapau, Mata Serpentina, entra no campo de batalha, você pode pagar 3 pontos de vida. Se não fizer isso, ela entrará no campo de batalha virada.\\n{T}: Adicione {G}.\\nFeitiço\\n{4}{G}{G}{G}\', \'type\': \'Terreno\', \'flavor\': \'"Aqui as árvores se enroscam em aguilhões de mana, alimentando-se do poder que flui por eles."\\n— Jori En, líder de expedição\', \'faceName\': \'Virapau, Mata Serpentina\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494076&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37574902-c2dd-4505-b875-978cefed81af\', \'multiverseId\': 494076}, \'multiverseid\': 494076}, {\'name\': \'Симбиоз Криволесья // Криволесье, Змеящийся Лес\', \'text\': \'При выходе Криволесья, Змеящегося Леса на поле битвы вы можете заплатить 3 жизни. Если вы этого не делаете, оно выходит на поле битвы повернутым.\\n{T}: добавьте {G}.\\nВолшебство\\n{4}{G}{G}{G}\', \'type\': \'Земля\', \'flavor\': \'«Деревья здесь закручиваются вокруг выплесков маны, питаясь потоками силы».\\n— Джори-Эн, глава экспедиции\', \'faceName\': \'Криволесье, Змеящийся Лес\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494392&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'53be7ed3-d981-441d-bdc3-6dc4e2a0831f\', \'multiverseId\': 494392}, \'multiverseid\': 494392}, {\'name\': \'旋林共生 // 曲木旋林\', \'text\': \'于曲木旋林进战场时，你可以支付3点生命。如果你未如此作，则它须横置进战场。\\n{T}：加{G}。\\n法术\\n{4}{G}{G}{G}\', \'type\': \'地\', \'flavor\': \'「此处的树木绕着涌出的魔力成长，汲取其间流动能量为生。」\\n～探险队长裘黎恩\', \'faceName\': \'曲木旋林\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494708&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3fffb755-292f-4634-989e-9ee8aaa837c3\', \'multiverseId\': 494708}, \'multiverseid\': 494708}, {\'name\': \'旋林共生 // 曲木旋林\', \'text\': \'於曲木旋林進戰場時，你可以支付3點生命。如果你未如此作，則它須橫置進戰場。\\n{T}：加{G}。\\n巫術\\n{4}{G}{G}{G}\', \'type\': \'地\', \'flavor\': \'「此處的樹木繞著湧出的魔力成長，汲取其間流動能量為生。」\\n～探險隊長裘黎恩\', \'faceName\': \'曲木旋林\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495024&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'be7511da-1b65-4adf-a0f9-51a6d36f214b\', \'multiverseId\': 495024}, \'multiverseid\': 495024}]', '[{\'name\': \'Wiederherstellung von Bala Ged // Zuflucht von Bala Ged\', \'text\': \'Bringe eine Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\nLand\\n{T}: Erzeuge {G}.\', \'type\': \'Hexerei\', \'flavor\': \'„Halte immer einen Notfallplan bereit."\\n—Doral, Führerin aus Bala Ged\', \'faceName\': \'Wiederherstellung von Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492141&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1385536a-4ef0-4b9b-81aa-d4cf5d756e96\', \'multiverseId\': 492141}, \'multiverseid\': 492141}, {\'name\': \'Restauración de Bala Ged // Refugio de Bala Ged\', \'text\': \'Regresa la carta objetivo de tu cementerio a tu mano.\\nTierra\\n{T}: Agrega {G}.\', \'type\': \'Conjuro\', \'flavor\': \'"Siempre hay que tener un plan B".\\n—Doral, guía de Bala Ged\', \'faceName\': \'Restauración de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492457&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b605fd7b-7c52-4679-abb5-fd066a29cd75\', \'multiverseId\': 492457}, \'multiverseid\': 492457}, {\'name\': \'Récupération de Bala Ged // Sanctuaire de Bala Ged\', \'text\': \'Renvoyez une carte ciblée depuis votre cimetière dans votre main.\\nTerrain\\n{T} : Ajoutez {G}.\', \'type\': \'Rituel\', \'flavor\': \'« Il faut toujours avoir un plan de secours. »\\n—Doral, guide de Bala Ged\', \'faceName\': \'Récupération de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492773&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3729ce2-dbb4-4840-ad3a-6a35926ce2da\', \'multiverseId\': 492773}, \'multiverseid\': 492773}, {\'name\': \'Recupero di Bala Ged // Riparo di Bala Ged\', \'text\': \'Riprendi in mano una carta bersaglio dal tuo cimitero.\\nTerra\\n{T}: Aggiungi {G}.\', \'type\': \'Stregoneria\', \'flavor\': \'"Bisogna sempre avere un piano di riserva."\\n—Doral, guida di Bala Ged\', \'faceName\': \'Recupero di Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493089&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d2195f1-b7b2-4ded-ac5c-f1c502150e45\', \'multiverseId\': 493089}, \'multiverseid\': 493089}, {\'name\': \'バーラ・ゲドの復活 // バーラ・ゲドの聖域\', \'text\': \'あなたの墓地からカード１枚を対象とする。それをあなたの手札に戻す。\\n土地\\n{T}：{G}を加える。\', \'type\': \'ソーサリー\', \'flavor\': \'「常に代案を用意しておけ。」\\n――バーラ・ゲドの案内人、ドーラル\', \'faceName\': \'バーラ・ゲドの復活\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493405&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34575691-a378-4518-b2aa-f6399163cbf7\', \'multiverseId\': 493405}, \'multiverseid\': 493405}, {\'name\': \'발라 게드식 회복 // 발라 게드 성소\', \'text\': \'당신의 무덤에 있는 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\\n대지\\n{T}: {G}를 추가한다.\', \'type\': \'집중마법\', \'flavor\': \'"항상 예비 계획을 세워 둬."\\n—발라 게드 안내인, 도랄\', \'faceName\': \'발라 게드식 회복\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493721&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dacf9a9b-117d-4c78-be64-96b15ac9a8a4\', \'multiverseId\': 493721}, \'multiverseid\': 493721}, {\'name\': \'Recuperação de Bala Ged // Santuário de Bala Ged\', \'text\': \'Devolva o card alvo de seu cemitério para sua mão.\\nTerreno\\n{T}: Adicione {G}.\', \'type\': \'Feitiço\', \'flavor\': \'"Tenha sempre um plano B."\\n— Doral, guia de Bala Ged\', \'faceName\': \'Recuperação de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494037&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1dfe4887-5dd8-49ee-8612-997ec9511e37\', \'multiverseId\': 494037}, \'multiverseid\': 494037}, {\'name\': \'Возрождение Бала-Геда // Святилище Бала-Геда\', \'text\': \'Верните целевую карту из вашего кладбища в вашу руку.\\nЗемля\\n{T}: добавьте {G}.\', \'type\': \'Волшебство\', \'flavor\': \'«Всегда должен быть запасной план».\\n— Дорал, бала-гедский проводник\', \'faceName\': \'Возрождение Бала-Геда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494353&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9d378646-9f4e-4a07-9663-c4478fd71464\', \'multiverseId\': 494353}, \'multiverseid\': 494353}, {\'name\': \'巴勒格复苏 // 巴勒格圣所\', \'text\': \'将目标牌从你的坟墓场移回你手上。\\n地\\n{T}：加{G}。\', \'type\': \'法术\', \'flavor\': \'「随时备妥候选方案。」\\n～巴勒格向导多拉尔\', \'faceName\': \'巴勒格复苏\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494669&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b276d867-6467-4174-bac9-533515912580\', \'multiverseId\': 494669}, \'multiverseid\': 494669}, {\'name\': \'巴勒格復甦 // 巴勒格聖所\', \'text\': \'將目標牌從你的墳墓場移回你手上。\\n地\\n{T}：加{G}。\', \'type\': \'巫術\', \'flavor\': \'「隨時備妥候選方案。」\\n～巴勒格嚮導多拉爾\', \'faceName\': \'巴勒格復甦\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494985&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b3757a55-51de-4fa1-98e4-f4539dc29a0d\', \'multiverseId\': 494985}, \'multiverseid\': 494985}]', '[{\'name\': \'Wiederherstellung von Bala Ged // Zuflucht von Bala Ged\', \'text\': \'Die Zuflucht von Bala Ged kommt getappt ins Spiel.\\n{T}: Erzeuge {G}.\\nHexerei\\n{2}{G}\', \'type\': \'Land\', \'flavor\': \'„Ich weiß, dass es hier irgendwo ist."\\n—Doral, Führerin aus Bala Ged\', \'faceName\': \'Zuflucht von Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492141&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1385536a-4ef0-4b9b-81aa-d4cf5d756e96\', \'multiverseId\': 492141}, \'multiverseid\': 492141}, {\'name\': \'Restauración de Bala Ged // Refugio de Bala Ged\', \'text\': \'El Refugio de Bala Ged entra al campo de batalla girado.\\n{T}: Agrega {G}.\\nConjuro\\n{2}{G}\', \'type\': \'Tierra\', \'flavor\': \'"Sé que es por aquí".\\n—Doral, guía de Bala Ged\', \'faceName\': \'Refugio de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492457&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b605fd7b-7c52-4679-abb5-fd066a29cd75\', \'multiverseId\': 492457}, \'multiverseid\': 492457}, {\'name\': \'Récupération de Bala Ged // Sanctuaire de Bala Ged\', \'text\': \'Le Sanctuaire de Bala Ged arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G}.\\nRituel\\n{2}{G}\', \'type\': \'Terrain\', \'flavor\': "« Je sais qu\'il est quelque part par là. »\\n—Doral, guide de Bala Ged", \'faceName\': \'Sanctuaire de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492773&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b3729ce2-dbb4-4840-ad3a-6a35926ce2da\', \'multiverseId\': 492773}, \'multiverseid\': 492773}, {\'name\': \'Recupero di Bala Ged // Riparo di Bala Ged\', \'text\': \'Il Riparo di Bala Ged entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G}.\\nStregoneria\\n{2}{G}\', \'type\': \'Terra\', \'flavor\': \'"So che è qui da qualche parte."\\n—Doral, guida di Bala Ged\', \'faceName\': \'Riparo di Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493089&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d2195f1-b7b2-4ded-ac5c-f1c502150e45\', \'multiverseId\': 493089}, \'multiverseid\': 493089}, {\'name\': \'バーラ・ゲドの復活 // バーラ・ゲドの聖域\', \'text\': \'バーラ・ゲドの聖域はタップ状態で戦場に出る。\\n{T}：{G}を加える。\\nソーサリー\\n{2}{G}\', \'type\': \'土地\', \'flavor\': \'「間違いなくこの辺りだ。」\\n――バーラ・ゲドの案内人、ドーラル\', \'faceName\': \'バーラ・ゲドの聖域\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493405&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34575691-a378-4518-b2aa-f6399163cbf7\', \'multiverseId\': 493405}, \'multiverseid\': 493405}, {\'name\': \'발라 게드식 회복 // 발라 게드 성소\', \'text\': \'발라 게드 성소는 탭된 채로 전장에 들어온다.\\n{T}: {G}를 추가한다.\\n집중마법\\n{2}{G}\', \'type\': \'대지\', \'flavor\': \'"여기 근처 어디인 걸로 알고 있는데."\\n—발라 게드 안내인, 도랄\', \'faceName\': \'발라 게드 성소\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493721&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'dacf9a9b-117d-4c78-be64-96b15ac9a8a4\', \'multiverseId\': 493721}, \'multiverseid\': 493721}, {\'name\': \'Recuperação de Bala Ged // Santuário de Bala Ged\', \'text\': \'Santuário de Bala Ged entra no campo de batalha virado.\\n{T}: Adicione {G}.\\nFeitiço\\n{2}{G}\', \'type\': \'Terreno\', \'flavor\': \'"Eu sei que é em algum lugar por aqui."\\n— Doral, guia de Bala Ged\', \'faceName\': \'Santuário de Bala Ged\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494037&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1dfe4887-5dd8-49ee-8612-997ec9511e37\', \'multiverseId\': 494037}, \'multiverseid\': 494037}, {\'name\': \'Возрождение Бала-Геда // Святилище Бала-Геда\', \'text\': \'Святилище Бала-Геда выходит на поле битвы повернутым.\\n{T}: добавьте {G}.\\nВолшебство\\n{2}{G}\', \'type\': \'Земля\', \'flavor\': \'«Я точно знаю, это где-то здесь».\\n— Дорал, бала-гедский проводник\', \'faceName\': \'Святилище Бала-Геда\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494353&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9d378646-9f4e-4a07-9663-c4478fd71464\', \'multiverseId\': 494353}, \'multiverseid\': 494353}, {\'name\': \'巴勒格复苏 // 巴勒格圣所\', \'text\': \'巴勒格圣所须横置进战场。\\n{T}：加{G}。\\n法术\\n{2}{G}\', \'type\': \'地\', \'flavor\': \'「我就知道在这附近。」\\n～巴勒格向导多拉尔\', \'faceName\': \'巴勒格圣所\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494669&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b276d867-6467-4174-bac9-533515912580\', \'multiverseId\': 494669}, \'multiverseid\': 494669}, {\'name\': \'巴勒格復甦 // 巴勒格聖所\', \'text\': \'巴勒格聖所須橫置進戰場。\\n{T}：加{G}。\\n巫術\\n{2}{G}\', \'type\': \'地\', \'flavor\': \'「我就知道在這附近。」\\n～巴勒格嚮導多拉爾\', \'faceName\': \'巴勒格聖所\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494985&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b3757a55-51de-4fa1-98e4-f4539dc29a0d\', \'multiverseId\': 494985}, \'multiverseid\': 494985}]', '[{\'name\': \'Windgleiter-Zauberer\', \'text\': \'Fliegend\\nImmer wenn du einen Spontanzauber, eine Hexerei oder einen Zauberer-Zauberspruch wirkst, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Es ist die ideale Methode, um Himmelsruinen zu erkunden. Die Sceadas schnuppern kurz an mir, verlieren dann aber das Interesse."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492036&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8adc3f24-3a5d-4d16-bc00-1c1b0b96f1c3\', \'multiverseId\': 492036}, \'multiverseid\': 492036}, {\'name\': \'Hechicero jinete del viento\', \'text\': \'Vuela.\\nSiempre que lances un hechizo de instantáneo, de conjuro o de Hechicero, puedes robar una carta. Si lo haces, descarta una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Es el método ideal para explorar las ruinas celestes. Los dracos me huelen un poco, y después ya no les intereso".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492352&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'700c75c4-a271-4f31-862e-706ef7501e9f\', \'multiverseId\': 492352}, \'multiverseid\': 492352}, {\'name\': \'Sorcier des vents\', \'text\': "Vol\\nÀ chaque fois que vous lancez un sort d\'éphémère, de rituel ou de sorcier, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« C\'est une manière idéale d\'explorer les ruines célestes. Les drakôns me reniflent brièvement mais ils se lassent vite. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492668&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56f4432f-d221-4ae3-916d-a602f46cec2e\', \'multiverseId\': 492668}, \'multiverseid\': 492668}, {\'name\': \'Mago Solcabrezza\', \'text\': \'Volare\\nOgniqualvolta lanci una magia istantaneo, stregoneria o Mago, puoi pescare una carta. Se lo fai, scarta una carta.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"È un metodo ideale per esplorare le rovine celesti. I draghetti mi fiutano per un attimo, ma poi perdono interesse."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492984&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc0b139b-268d-40f1-98b7-92eba7e66fe5\', \'multiverseId\': 492984}, \'multiverseid\': 492984}, {\'name\': \'風乗りの魔術師\', \'text\': \'飛行\\nあなたがインスタントやソーサリーやウィザードである呪文を唱えるたび、あなたはカードを１枚引いてもよい。そうしたなら、カード１枚を捨てる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「空の遺跡を探検する方法としては理想的だ。ドレイクがちょっと匂いを嗅いだが、興味をなくしたよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493300&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cef22b6f-1db3-4646-9f03-ebc1dc483a0f\', \'multiverseId\': 493300}, \'multiverseid\': 493300}, {\'name\': \'바람기수 마법사\', \'text\': \'비행\\n당신이 순간마법, 집중마법, 또는 마법사 주문을 발동할 때마다, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"그건 하늘의 폐허들을 탐험하기 위한 이상적인 방법이야. 드레이크들은 내 냄새를 잠시 맡아 보지만 금새 흥미를 잃지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493616&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2390d592-34b3-45df-bab5-fe3815fd6809\', \'multiverseId\': 493616}, \'multiverseid\': 493616}, {\'name\': \'Mago Ginete do Vento\', \'text\': \'Voar\\nToda vez que você conjura uma mágica instantânea, um feitiço ou uma mágica de Mago, você pode comprar um card. Se fizer isso, descarte um card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"É um método ideal para a exploração de ruínas celestes. Os dragonetes me farejam um pouco e logo perdem o interesse."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493932&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'281c74aa-c87e-41e5-bb56-574c6dda3427\', \'multiverseId\': 493932}, \'multiverseid\': 493932}, {\'name\': \'Чародей-Наездник Ветра\', \'text\': \'Полет\\nКаждый раз, когда вы разыгрываете заклинание волшебства, Чародея или мгновенное заклинание, вы можете взять карту. Если вы это делаете, сбросьте карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Это идеальный метод для исследования небесных руин. Дрейки меня поначалу обнюхивают, но быстро теряют интерес».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494248&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dacce948-1893-4873-9ba8-a17d59153051\', \'multiverseId\': 494248}, \'multiverseid\': 494248}, {\'name\': \'御风法师\', \'text\': \'飞行\\n每当你施放瞬间，法术或法术师咒语时，你可以抓一张牌。若你如此作，则弃一张牌。\', \'type\': \'生物 ～人类／法术师\', \'flavor\': \'「这是探索天空遗迹的理想办法。虽然龙兽嗅到了我的味道，但很快就失去了兴趣。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494564&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ad51f249-d1e9-4d45-a16c-5e2eeba2d84f\', \'multiverseId\': 494564}, \'multiverseid\': 494564}, {\'name\': \'御風法師\', \'text\': \'飛行\\n每當你施放瞬間，巫術或魔法師咒語時，你可以抽一張牌。若你如此作，則棄一張牌。\', \'type\': \'生物 ～人類／魔法師\', \'flavor\': \'「這是探索天空遺跡的理想辦法。雖然龍獸嗅到了我的味道，但很快就失去了興趣。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494880&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'04a539ee-1154-46d8-8637-2060ea67991c\', \'multiverseId\': 494880}, \'multiverseid\': 494880}]', '[{\'name\': \'Wippgipfel-Lauerer\', \'text\': \'{2}{R}: Der Wippgipfel-Lauerer erhält +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Goblins aus den Makindi-Gräben auf Ondu sind aufgrund ihrer Gewohnheit, die Klippen zu erklimmen, um sich auf ahnungslose Feinde zu stürzen, erstaunlich gute Kletterführer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492129&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f88ad0df-0e8c-41ee-8352-753b20d27a6f\', \'multiverseId\': 492129}, \'multiverseid\': 492129}, {\'name\': \'Emboscador picoscilantense\', \'text\': \'{2}{R}: El Emboscador picoscilantense obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Sorprendentemente, los trasgos de las trincheras de Makindi en Ondu son guías alpinistas de mucho talento, ya que escalan precipicios para saltar encima de sus enemigos y así pillarlos desprevenidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492445&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'afa598c7-1b88-4116-8be2-3a5602af8b73\', \'multiverseId\': 492445}, \'multiverseid\': 492445}, {\'name\': \'Embusqueur des Pics vacillants\', \'text\': "{2}{R} : L\'Embusqueur des Pics vacillants gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Les gobelins des tranchées de Makindi du Ondou sont, à la surprise générale, d\'excellents guides de montagne car ils sont habitués à escalader les falaises pour se jeter sur des ennemis trop confiants.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492761&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e992ca64-a1d6-4770-a4cd-3e09a85f4177\', \'multiverseId\': 492761}, \'multiverseid\': 492761}, {\'name\': \'Assalitore dei Picchi Vacillanti\', \'text\': "{2}{R}: L\'Assalitore dei Picchi Vacillanti prende +2/+0 fino alla fine del turno.", \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': "I goblin delle Fosse di Makindi a Ondu sono guide d\'arrampicata sorprendentemente abili grazie alla loro abitudine di scalare le rupi per gettarsi sui nemici ignari.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493077&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5cf2dc83-ee44-4d62-8d7e-c9a8b9533099\', \'multiverseId\': 493077}, \'multiverseid\': 493077}, {\'name\': \'ぐらつく峰の伏兵\', \'text\': \'{2}{R}：ターン終了時まで、ぐらつく峰の伏兵は＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'オンドゥのマキンディ溝のゴブリンは驚くほど優秀な登山案内人になる。崖をよじ登って無防備な敵の上に落ちるという習性があるからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493393&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c36fb375-176c-4190-9f08-1d9655505cd3\', \'multiverseId\': 493393}, \'multiverseid\': 493393}, {\'name\': \'불안정한 봉우리의 매복꾼\', \'text\': \'{2}{R}: 불안정한 봉우리의 매복꾼은 턴종료까지 +2/+0을 받는다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': \'온두의 마킨디 협곡 출신 고블린들은 눈치채이지 않고 적들을 덮치기 위해 높은 절벽을 타고 오르는 습성을 가지고 있어 놀랄 만큼 숙련된 등산 안내인이 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493709&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'403477f5-a75c-415e-92b7-c114c9d9cb5f\', \'multiverseId\': 493709}, \'multiverseid\': 493709}, {\'name\': \'Emboscador dos Picos Vacilantes\', \'text\': \'{2}{R}: Emboscador dos Picos Vacilantes recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Os goblins das Fossas de Makindi em Ondu dão guias de escalada surpreendentemente habilidosos graças ao hábito de escalar os penhascos para se jogarem sobre inimigos desprevenidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494025&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0b267e6-8b8b-48c6-a724-2045f639078a\', \'multiverseId\': 494025}, \'multiverseid\': 494025}, {\'name\': \'Охотник Шатающихся Пиков\', \'text\': \'{2}{R}: Охотник Шатающихся Пиков получает +2/+0 до конца хода.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Гоблины из Разломов Макинди в Онду становятся удивительно способными скальными проводниками — они с детства учатся лазать по утесам, чтобы сверху прыгать на ничего не подозревающих врагов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494341&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88b1bb38-24cc-4fd8-8075-acde75a75390\', \'multiverseId\': 494341}, \'multiverseid\': 494341}, {\'name\': \'晃摇峰伏击兵\', \'text\': \'{2}{R}：晃摇峰伏击兵得+2/+0直到回合结束。\', \'type\': \'生物 ～鬼怪／战士\', \'flavor\': \'来自昂度马钦迪战壕的鬼怪习惯攀登山头从上方袭击毫无防备的敌人，找他们来作登山向导意外好用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494657&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'72db3585-157f-4e6e-9e30-3c78488f58f1\', \'multiverseId\': 494657}, \'multiverseid\': 494657}, {\'name\': \'晃搖峰伏擊兵\', \'text\': \'{2}{R}：晃搖峰伏擊兵得+2/+0直到回合結束。\', \'type\': \'生物 ～鬼怪／戰士\', \'flavor\': \'來自昂度馬欽迪戰壕的鬼怪習慣攀登山頭從上方襲擊毫無防備的敵人，找他們來作登山嚮導意外好用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494973&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a9189c0-f0a6-4b98-90e0-e45ab3cb7513\', \'multiverseId\': 494973}, \'multiverseid\': 494973}]', "[{'name': 'Wurzelgraser aus Murasa', 'text': 'Wachsamkeit\\n{T}: Du kannst eine Standardland-Karte aus deiner Hand ins Spiel bringen.\\n{T}: Bringe ein Standardland deiner Wahl, das du kontrollierst, auf die Hand seines Besitzers zurück.', 'type': 'Kreatur — Bestie', 'flavor': 'Nur wenige andere Kreaturen verkörpern die schnellen Wachstumszyklen auf Murasa so stark.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492196&type=card', 'language': 'German', 'identifiers': {'scryfallId': '28e35de0-bb22-4f3d-86a3-e4e9b0e85bcc', 'multiverseId': 492196}, 'multiverseid': 492196}, {'name': 'Pastarraíces de Murasa', 'text': 'Vigilancia.\\n{T}: Puedes poner en el campo de batalla una carta de tierra básica de tu mano.\\n{T}: Regresa la tierra básica objetivo que controlas a la mano de su propietario.', 'type': 'Criatura — Bestia', 'flavor': 'Pocas otras criaturas encarnan tanto los veloces ciclos de crecimiento de Murasa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492512&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd26efcc9-156c-443d-8511-b1801508f6d7', 'multiverseId': 492512}, 'multiverseid': 492512}, {'name': 'Racinovore de Murasa', 'text': 'Vigilance\\n{T} : Vous pouvez mettre sur le champ de bataille une carte de terrain de base de votre main.\\n{T} : Renvoyez un terrain de base ciblé que vous contrôlez dans la main de son propriétaire.', 'type': 'Créature : bête', 'flavor': 'Peu de créatures incarnent si bien les cycles de croissance rapides de Murasa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492828&type=card', 'language': 'French', 'identifiers': {'scryfallId': '49aae22b-8423-4667-9f20-5707c829dd9f', 'multiverseId': 492828}, 'multiverseid': 492828}, {'name': 'Brucaradici di Murasa', 'text': 'Cautela\\n{T}: Puoi mettere sul campo di battaglia una carta terra base dalla tua mano.\\n{T}: Fai tornare una terra base bersaglio che controlli in mano al suo proprietario.', 'type': 'Creatura — Bestia', 'flavor': 'Poche altre creature incarnano così fedelmente i rapidi cicli di crescita di Murasa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493144&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1b091e24-c4ce-41b8-93f3-6e871710d2ea', 'multiverseId': 493144}, 'multiverseid': 493144}, {'name': 'ムラーサの根食獣', 'text': '警戒\\n{T}：あなたはあなたの手札から基本土地・カード１枚を戦場に出してもよい。\\n{T}：あなたがコントロールしている基本土地１つを対象とする。それをオーナーの手札に戻す。', 'type': 'クリーチャー — ビースト', 'flavor': 'ムラーサの素早い成長周期をこれほど良く表している生き物は、他にはあまりいない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493460&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b80d6989-0570-4df6-b139-b5f3369575ed', 'multiverseId': 493460}, 'multiverseid': 493460}, {'name': '무라사 뿌리포식자', 'text': '경계\\n{T}: 당신은 당신의 손에서 기본 대지 카드 한 장을 전장에 놓을 수 있다.\\n{T}: 당신이 조종하는 기본 대지를 목표로 정한다. 그 대지를 소유자의 손으로 되돌린다.', 'type': '생물 — 야수', 'flavor': '극소수의 다른 생물들만이 무라사의 급격한 성장 주기를 아주 가깝게 받아들인다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493776&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '75ab6c18-e7e5-4ba5-8c2d-1da29323a48a', 'multiverseId': 493776}, 'multiverseid': 493776}, {'name': 'Pasta-raiz de Murasa', 'text': 'Vigilância\\n{T}: Você pode colocar no campo de batalha um card de terreno básico de sua mão.\\n{T}: Devolva o terreno básico alvo que você controla para a mão de seu dono.', 'type': 'Criatura — Besta', 'flavor': 'Poucas criaturas encarnam tão bem os velozes ciclos de crescimento de Murasa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494092&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2ca09d10-16da-4b4d-9b1c-5d50386d3b1d', 'multiverseId': 494092}, 'multiverseid': 494092}, {'name': 'Мурасский Корнеед', 'text': 'Бдительность\\n{T}: вы можете положить карту базовой земли из вашей руки на поле битвы.\\n{T}: верните целевую базовую землю под вашим контролем в руку ее владельца.', 'type': 'Существо — Зверь', 'flavor': 'Немногие существа способны так точно воплотить быстрые циклы роста Мурасы.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494408&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c0d424fa-f3a4-4d7d-a264-abccd5fa7c47', 'multiverseId': 494408}, 'multiverseid': 494408}, {'name': '姆拉撒嚼根兽', 'text': '警戒\\n{T}：你可以将一张基本地牌从你手上放进战场。\\n{T}：将目标由你操控的基本地移回其拥有者手上。', 'type': '生物 ～野兽', 'flavor': '没有其他生物能够如此精准地重现姆拉撒的快速生长周期。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494724&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dc71d962-9371-4fb7-8db8-a57762d8cab0', 'multiverseId': 494724}, 'multiverseid': 494724}, {'name': '姆拉撒嚼根獸', 'text': '警戒\\n{T}：你可以將一張基本地牌從你手上放進戰場。\\n{T}：將目標由你操控的基本地移回其擁有者手上。', 'type': '生物 ～野獸', 'flavor': '沒有其他生物能夠如此精準地重現姆拉撒的快速生長週期。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495040&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c0ba17e7-4342-49b1-bd62-9f644282d2f9', 'multiverseId': 495040}, 'multiverseid': 495040}]", '[{\'name\': \'Wächter der Himmelsfestung\', \'text\': \'Bonus {4} (Du kannst zusätzlich {4} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nFliegend, Verteidiger\\nFalls die Bonuskosten des Wächters der Himmelsfestung bezahlt wurden, kommt er mit zwei +1/+1-Marken ins Spiel.\\nSolange mindestens eine +1/+1-Marke auf dem Wächter der Himmelsfestung liegt, kann er angreifen, als ob er nicht Verteidiger hätte.\', \'type\': \'Artefaktkreatur — Gargoyle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492220&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f3ac923d-b24b-4b17-ac4e-56961fc5e5bd\', \'multiverseId\': 492220}, \'multiverseid\': 492220}, {\'name\': \'Centinela de aerorruina\', \'text\': \'Estímulo {4}. (Puedes pagar {4} adicionales al lanzar este hechizo.)\\nVuela, defensor.\\nSi la Centinela de aerorruina fue estimulada, entra al campo de batalla con dos contadores +1/+1 sobre ella.\\nMientras la Centinela de aerorruina tenga un contador +1/+1 sobre ella, puede atacar como si no tuviera la habilidad de defensor.\', \'type\': \'Criatura artefacto — Gárgola\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492536&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'77b9a8ed-293b-44bd-83f5-a2d6295b688d\', \'multiverseId\': 492536}, \'multiverseid\': 492536}, {\'name\': \'Sentinelle du fort céleste\', \'text\': "Kick {4} (Vous pouvez payer {4} supplémentaires au moment où vous lancez ce sort.)\\nVol, défenseur\\nSi la Sentinelle du fort céleste a été kickée, elle arrive sur le champ de bataille avec deux marqueurs +1/+1 sur elle.\\nTant que la Sentinelle du fort céleste a au moins un marqueur +1/+1 sur elle, elle peut attaquer comme si elle n\'avait pas le défenseur.", \'type\': \'Créature-artefact : gargouille\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492852&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3735298b-c757-4745-8190-2de2a45267aa\', \'multiverseId\': 492852}, \'multiverseid\': 492852}, {\'name\': "Sentinella dell\'Enclave Celeste", \'text\': "Potenziamento {4} (Puoi pagare {4} addizionale mentre lanci questa magia.)\\nVolare, difensore\\nSe la Sentinella dell\'Enclave Celeste è stata potenziata, entra nel campo di battaglia con due segnalini +1/+1.\\nFintanto che la Sentinella dell\'Enclave Celeste ha un segnalino +1/+1, può attaccare come se non avesse difensore.", \'type\': \'Creatura Artefatto — Gargoyle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493168&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'162b8550-9fa6-4ea0-8eab-b2faccd46bd4\', \'multiverseId\': 493168}, \'multiverseid\': 493168}, {\'name\': \'スカイクレイブの歩哨\', \'text\': \'キッカー{4}（あなたはこの呪文を唱えるに際し、追加で{4}を支払ってもよい。）\\n飛行、防衛\\nスカイクレイブの歩哨がキッカーされていたなら、これは＋１/＋１カウンターが２個置かれた状態で戦場に出る。\\nスカイクレイブの歩哨の上に＋１/＋１カウンターが置かれているかぎり、これは防衛を持たないかのように攻撃できる。\', \'type\': \'アーティファクト・クリーチャー — ガーゴイル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493484&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4881bc0-2bca-4c88-9510-56181fedaf9a\', \'multiverseId\': 493484}, \'multiverseid\': 493484}, {\'name\': \'하늘거주지 보초병\', \'text\': \'키커 {4} (당신은 이 주문을 발동하면서 추가로 {4}를 지불할 수 있다.)\\n비행, 수비태세\\n하늘거주지 보초병의 키커 비용이 지불되었다면, 하늘거주지 보초병은 +1/+1 카운터 두 개를 가지고 전장에 들어온다.\\n하늘거주지 보초병이 +1/+1 카운터를 가지고 있는 한, 하늘거주지 보초병은 수비태세가 없는 것처럼 공격할 수 있다.\', \'type\': \'마법물체 생물 — 가고일\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493800&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'56a845c5-8c98-4948-b3be-d43c42244b55\', \'multiverseId\': 493800}, \'multiverseid\': 493800}, {\'name\': \'Sentinela do Enclave Celeste\', \'text\': \'Reforçar {4} (Você pode pagar um custo adicional de {4} ao conjurar esta mágica.)\\nVoar, defensor\\nSe Sentinela do Enclave Celeste foi reforçada, ela entra no campo de batalha com dois marcadores +1/+1.\\nEnquanto Sentinela do Enclave Celeste tiver um marcador +1/+1, ela poderá atacar como se não tivesse defensor.\', \'type\': \'Criatura Artefato — Gárgula\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494116&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b128bff-f5dd-4053-a224-e1ff7e4452e7\', \'multiverseId\': 494116}, \'multiverseid\': 494116}, {\'name\': \'Дозорный Небесного Анклава\', \'text\': \'Усилитель {4} (При разыгрывании этого заклинания вы можете дополнительно заплатить {4}.)\\nПолет, Защитник\\nЕсли Дозорный Небесного Анклава получил Усилитель, он выходит на поле битвы с двумя жетонами +1/+1 на нем.\\nПока на Дозорном Небесного Анклава есть жетон +1/+1, он может атаковать, как если бы у него не было способности Защитника.\', \'type\': \'Артефакт Существо — Горгулья\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494432&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'706d708b-d434-4985-8099-c162f68a4e5c\', \'multiverseId\': 494432}, \'multiverseid\': 494432}, {\'name\': \'空境哨卫\', \'text\': \'增幅{4}（你施放此咒语时可以额外支付{4}。）\\n飞行，守军\\n如果空境哨卫已增幅，则它进战场时上面有两个+1/+1指示物。\\n只要空境哨卫上有+1/+1指示物，它便能视同不具守军异能地进行攻击。\', \'type\': \'神器生物 ～石像鬼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494748&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4cdeb0ab-7983-4ec3-aef4-c624cb1f1619\', \'multiverseId\': 494748}, \'multiverseid\': 494748}, {\'name\': \'空境哨衛\', \'text\': \'增幅{4}（你施放此咒語時可以額外支付{4}。）\\n飛行，守軍\\n如果空境哨衛已增幅，則它進戰場時上面有兩個+1/+1指示物。\\n只要空境哨衛上有+1/+1指示物，它便能視同不具守軍異能地進行攻擊。\', \'type\': \'神器生物 ～石像鬼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495064&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'17ae8433-8a6f-4e58-b255-8c5a392d5896\', \'multiverseId\': 495064}, \'multiverseid\': 495064}]', "[{'name': 'Yasharn, die unerbittliche Erde', 'text': 'Wenn Yasharn ins Spiel kommt, durchsuche deine Bibliothek nach einer Wald- und einer Ebene-Standardlandkarte, zeige sie offen vor, nimm sie auf deine Hand und mische dann deine Bibliothek.\\nSpieler können keine Lebenspunkte bezahlen oder bleibende Karten, die keine Länder sind, opfern, um Zaubersprüche zu wirken oder Fähigkeiten zu aktivieren.', 'type': 'Legendäre Kreatur — Elementarwesen, Wildschwein', 'flavor': 'In seinen Hufabdrücken wird unfruchtbarer Staub zu fruchtbarem Boden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492207&type=card', 'language': 'German', 'identifiers': {'scryfallId': '559593f8-42d2-4c27-a50c-66da7fcf9702', 'multiverseId': 492207}, 'multiverseid': 492207}, {'name': 'Yasharn, tierra implacable', 'text': 'Cuando Yasharn entre al campo de batalla, busca en tu biblioteca una carta de Bosque básica y una carta de Llanura básica, muestra esas cartas, ponlas en tu mano y luego baraja tu biblioteca.\\nLos jugadores no pueden pagar vidas o sacrificar permanentes que no sean tierra para lanzar hechizos o activar habilidades.', 'type': 'Criatura legendaria — Jabalí elemental', 'flavor': 'A su paso, el polvo árido se transforma en tierra fértil.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492523&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6121ed59-03e4-4bd0-828d-b1158922b93b', 'multiverseId': 492523}, 'multiverseid': 492523}, {'name': 'Yasharn, terre implacable', 'text': 'Quand Yasharn arrive sur le champ de bataille, cherchez dans votre bibliothèque une carte de forêt de base et une carte de plaine de base, révélez ces cartes, mettez-les dans votre main, puis mélangez votre bibliothèque.\\nLes joueurs ne peuvent pas payer de points de vie ou sacrifier des permanents non-terrain pour lancer des sorts ou activer des capacités.', 'type': 'Créature légendaire : élémental et sanglier', 'flavor': 'Dans ses empreintes, la poussière stérile se transforme en terre fertile.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492839&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3c02a7b9-8479-4675-84ef-adecc94645a3', 'multiverseId': 492839}, 'multiverseid': 492839}, {'name': 'Yasharn, Suolo Implacabile', 'text': 'Quando Yasharn entra nel campo di battaglia, passa in rassegna il tuo grimorio per una carta Foresta base e una carta Pianura base, rivela quelle carte, aggiungile alla tua mano, poi rimescola il tuo grimorio.\\nI giocatori non possono pagare punti vita o sacrificare permanenti non terra per lanciare magie o attivare abilità.', 'type': 'Creatura Leggendaria — Cinghiale Elementale', 'flavor': 'Nelle impronte dei suoi zoccoli, la polvere sterile diventa terreno fertile.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493155&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '538eec95-3934-4dc7-933f-53969de52b65', 'multiverseId': 493155}, 'multiverseid': 493155}, {'name': '鎮まらぬ大地、ヤシャーン', 'text': '鎮まらぬ大地、ヤシャーンが戦場に出たとき、あなたのライブラリーから基本森・カード１枚と基本平地・カード１枚を探し、公開し、あなたの手札に加える。その後、あなたのライブラリーを切り直す。\\nプレイヤーは、呪文を唱えたり能力を起動したりするために、ライフを支払うことも土地でないパーマネントを生け贄に捧げることもできない。', 'type': '伝説のクリーチャー — エレメンタル・猪', 'flavor': 'その足が踏んだ跡は、不毛の塵が肥沃な土地になる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493471&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '28754ef5-6c2d-4384-95d1-8dff88180cac', 'multiverseId': 493471}, 'multiverseid': 493471}, {'name': '완강한 대지, 야샤른', 'text': '완강한 대지, 야샤른이 전장에 들어올 때, 당신의 서고에서 기본 숲 카드 및 기본 들 카드를 찾아, 그 카드들을 공개하고, 당신의 손에 넣은 후, 당신의 서고를 섞는다.\\n플레이어들은 주문을 발동하거나 능력을 활성화하기 위해 생명점을 지불하거나 대지가 아닌 지속물을 희생할 수 없다.', 'type': '전설적 생물 — 정령 멧돼지', 'flavor': '그것의 발굽 자국이 찍히는 곳에서는 황무지의 먼지가 비옥한 대지가 된다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493787&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6627f10e-bc51-4db6-a88b-90bc2727a158', 'multiverseId': 493787}, 'multiverseid': 493787}, {'name': 'Yasharn, Terra Implacável', 'text': 'Quando Yasharn entrar no campo de batalha, procure em seu grimório um card de Floresta básica e um card de Planície básica, revele aqueles cards, coloque-os em sua mão e depois embaralhe seu grimório.\\nOs jogadores não podem pagar pontos de vida nem sacrificar permanentes que não sejam terrenos para conjurar mágicas ou ativar habilidades.', 'type': 'Criatura Lendária — Elemental Javali', 'flavor': 'Nas marcas de seus cascos o pó inerte torna-se solo fértil.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494103&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '94dd726b-bef4-4d9b-8582-c04a036291d9', 'multiverseId': 494103}, 'multiverseid': 494103}, {'name': 'Йашарн, Непреклонная Земля', 'text': 'Когда Йашарн выходит на поле битвы, найдите в вашей библиотеке карту базового Леса и карту базовой Равнины, покажите те карты, положите их в вашу руку, затем перетасуйте вашу библиотеку.\\nИгроки не могут платить жизни или приносить в жертву не являющиеся землями перманенты для разыгрывания заклинаний или активации способностей.', 'type': 'Легендарное Существо — Элементаль Вепрь', 'flavor': 'В отпечатках его копыт бесплодный прах становится плодородной землей.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494419&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9210cf7d-e18f-4a81-badc-698a5b443b16', 'multiverseId': 494419}, 'multiverseid': 494419}, {'name': '执拗雄野牙刹', 'text': '当牙刹进战场时，从你的牌库中搜寻一张基本的树林牌和一张基本的平原牌，展示这些牌，将它们置于你手上，然后将你的牌库洗牌。\\n牌手不能以支付生命或牺牲非地永久物的方式施放咒语或起动异能。', 'type': '传奇生物 ～元素／野猪', 'flavor': '牙刹巨蹄踩过之处，贫瘠沙漠也能变作肥沃土壤。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494735&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f0656cd1-b088-45db-bc07-d92f7a89a5dd', 'multiverseId': 494735}, 'multiverseid': 494735}, {'name': '執拗雄野牙剎', 'text': '當牙剎進戰場時，從你的牌庫中搜尋一張基本的樹林牌和一張基本的平原牌，展示這些牌，將它們置於你手上，然後將你的牌庫洗牌。\\n玩家不能以支付生命或犧牲非地永久物的方式施放咒語或起動異能。', 'type': '傳奇生物 ～元素／野豬', 'flavor': '牙剎巨蹄踩過之處，貧瘠沙漠也能變作肥沃土壤。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495051&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f1f34fec-87b9-4c48-87b8-0c2795e56aef', 'multiverseId': 495051}, 'multiverseid': 495051}]", "[{'name': 'Yasharn, die unerbittliche Erde', 'text': 'Wenn Yasharn ins Spiel kommt, durchsuche deine Bibliothek nach einer Wald- und einer Ebene-Standardlandkarte, zeige sie offen vor, nimm sie auf deine Hand und mische dann deine Bibliothek.\\nSpieler können keine Lebenspunkte bezahlen oder bleibende Karten, die keine Länder sind, opfern, um Zaubersprüche zu wirken oder Fähigkeiten zu aktivieren.', 'type': 'Legendäre Kreatur — Elementarwesen, Wildschwein', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495734&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dada0a49-f225-4299-a4ea-1b5967f31cda', 'multiverseId': 495734}, 'multiverseid': 495734}, {'name': 'Yasharn, terre implacable', 'text': 'Quand Yasharn arrive sur le champ de bataille, cherchez dans votre bibliothèque une carte de forêt de base et une carte de plaine de base, révélez ces cartes, mettez-les dans votre main, puis mélangez votre bibliothèque.\\nLes joueurs ne peuvent pas payer de points de vie ou sacrifier des permanents non-terrain pour lancer des sorts ou activer des capacités.', 'type': 'Créature légendaire : élémental et sanglier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495809&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f05bca3c-ca3f-4059-a8c8-b3399e810bfe', 'multiverseId': 495809}, 'multiverseid': 495809}, {'name': '鎮まらぬ大地、ヤシャーン', 'text': '鎮まらぬ大地、ヤシャーンが戦場に出たとき、あなたのライブラリーから基本森・カード１枚と基本平地・カード１枚を探し、公開し、あなたの手札に加える。その後、あなたのライブラリーを切り直す。\\nプレイヤーは、呪文を唱えたり能力を起動したりするために、ライフを支払うことも土地でないパーマネントを生け贄に捧げることもできない。', 'type': '伝説のクリーチャー — エレメンタル・猪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495884&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e53b19b0-1744-48a3-b530-824d9f194dbd', 'multiverseId': 495884}, 'multiverseid': 495884}]", '[{\'name\': \'Zagras, Dieb des Herzschlags\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger.\\nFliegend, Todesberührung, Eile\\nAndere Kreaturen, die du kontrollierst, haben Todesberührung.\\nImmer wenn eine Kreatur, die du kontrollierst, einem Planeswalker Kampfschaden zufügt, zerstöre den Planeswalker.\', \'type\': \'Legendäre Kreatur — Vampir, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492208&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0d8ecffa-f347-4f77-a938-9247e4d877bd\', \'multiverseId\': 492208}, \'multiverseid\': 492208}, {\'name\': \'Zagras, ladrón de latidos\', \'text\': \'Te cuesta {1} menos lanzar este hechizo por cada criatura en tu grupo.\\nVuela, toque mortal, prisa.\\nLas otras criaturas que controlas tienen la habilidad de toque mortal.\\nSiempre que una criatura que controlas haga daño de combate a un planeswalker, destruye ese planeswalker.\', \'type\': \'Criatura legendaria — Bribón vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492524&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94287889-710e-484a-b1b0-980e0cf71771\', \'multiverseId\': 492524}, \'multiverseid\': 492524}, {\'name\': \'Zagras, voleur de pulsations\', \'text\': "Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe.\\nVol, contact mortel, célérité\\nLes autres créatures que vous contrôlez ont le contact mortel.\\nÀ chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à un planeswalker, détruisez ce planeswalker.", \'type\': \'Créature légendaire : vampire et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492840&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a93a4fd-83c4-4141-8bda-caf9dfc2c483\', \'multiverseId\': 492840}, \'multiverseid\': 492840}, {\'name\': \'Zagras, Ladro di Battiti\', \'text\': \'Questa magia costa {1} in meno per essere lanciata per ogni creatura nella tua compagnia.\\nVolare, tocco letale, rapidità\\nLe altre creature che controlli hanno tocco letale.\\nOgniqualvolta una creatura che controlli infligge danno da combattimento a un planeswalker, distruggi quel planeswalker.\', \'type\': \'Creatura Leggendaria — Farabutto Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493156&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6caf4a47-f140-4b3f-a1f2-34fd707aca9d\', \'multiverseId\': 493156}, \'multiverseid\': 493156}, {\'name\': \'鼓動盗み、ザグラス\', \'text\': \'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。\\n飛行、接死、速攻\\n他の、あなたがコントロールしているクリーチャーは接死を持つ。\\nあなたがコントロールしているクリーチャー１体がプレインズウォーカー１体に戦闘ダメージを与えるたび、そのプレインズウォーカーを破壊する。\', \'type\': \'伝説のクリーチャー — 吸血鬼・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493472&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c9f1106-ea6d-47b5-8ec1-c55237a1653b\', \'multiverseId\': 493472}, \'multiverseid\': 493472}, {\'name\': \'심장 박동을 훔치는 자, 자그라스\', \'text\': \'이 주문은 당신의 파티에 있는 각 생물마다 발동하는 데 {1}이 덜 든다.\\n비행, 치명타, 신속\\n당신이 조종하는 다른 생물들은 치명타를 가진다.\\n당신이 조종하는 생물이 플레인즈워커에게 피해를 입힐 때마다, 그 플레인즈워커를 파괴한다.\', \'type\': \'전설적 생물 — 흡혈귀 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493788&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ced99ba1-375b-4420-b96f-9f5d2802512e\', \'multiverseId\': 493788}, \'multiverseid\': 493788}, {\'name\': \'Zagras, Ladrão de Pulsações\', \'text\': \'Esta mágica custa {1} a menos para ser conjurada para cada criatura em seu grupo.\\nVoar, toque mortífero, ímpeto\\nAs outras criaturas que você controla têm toque mortífero.\\nToda vez que uma criatura que você controla causar dano de combate a um planeswalker, destrua aquele planeswalker.\', \'type\': \'Criatura Lendária — Vampiro Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494104&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8de20b67-1dda-4b57-bc27-24cf8d3641cf\', \'multiverseId\': 494104}, \'multiverseid\': 494104}, {\'name\': \'Заграс, Похититель Сердцебиения\', \'text\': "Разыгрывание этого заклинания стоит на {1} меньше за каждое существо в вашем отряде.\\nПолет, Смертельное касание, Ускорение\\nДругие существа под вашим контролем имеют Смертельное касание.\\nКаждый раз, когда существо под вашим контролем наносит боевые повреждения planeswalker\'у, уничтожьте того planeswalker\'а.", \'type\': \'Легендарное Существо — Вампир Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494420&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd060591-3c15-49e5-8a89-b5500fbddbe5\', \'multiverseId\': 494420}, \'multiverseid\': 494420}, {\'name\': \'夺命盗札葛斯\', \'text\': \'你冒险团中每有一个生物，此咒语便减少{1}来施放。\\n飞行，死触，敏捷\\n由你操控的其他生物具有死触异能。\\n每当一个由你操控的生物对任一鹏洛客造成战斗伤害时，消灭该鹏洛客。\', \'type\': \'传奇生物 ～吸血鬼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494736&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b21a33d9-7d81-4f4f-b1fd-d5216ab17cb8\', \'multiverseId\': 494736}, \'multiverseid\': 494736}, {\'name\': \'奪命盜札葛斯\', \'text\': \'你冒險團中每有一個生物，此咒語便減少{1}來施放。\\n飛行，死觸，敏捷\\n由你操控的其他生物具有死觸異能。\\n每當一個由你操控的生物對任一鵬洛客造成戰鬥傷害時，消滅該鵬洛客。\', \'type\': \'傳奇生物 ～吸血鬼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495052&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2d26f22f-4284-441b-8a73-617e5b99092e\', \'multiverseId\': 495052}, \'multiverseid\': 495052}]', '[{\'name\': \'Zagras, Dieb des Herzschlags\', \'text\': \'Dieser Zauberspruch kostet beim Wirken für jede Kreatur in deiner Abenteurergruppe {1} weniger.\\nFliegend, Todesberührung, Eile\\nAndere Kreaturen, die du kontrollierst, haben Todesberührung.\\nImmer wenn eine Kreatur, die du kontrollierst, einem Planeswalker Kampfschaden zufügt, zerstöre den Planeswalker.\', \'type\': \'Legendäre Kreatur — Vampir, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc404ad9-000b-4477-800b-d59c611d4d5f\', \'multiverseId\': 495735}, \'multiverseid\': 495735}, {\'name\': \'Zagras, voleur de pulsations\', \'text\': "Ce sort coûte {1} de moins à lancer pour chaque créature dans votre groupe.\\nVol, contact mortel, célérité\\nLes autres créatures que vous contrôlez ont le contact mortel.\\nÀ chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à un planeswalker, détruisez ce planeswalker.", \'type\': \'Créature légendaire : vampire et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495810&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'675cde70-6e1a-48a9-8df1-1bf9aab16d2a\', \'multiverseId\': 495810}, \'multiverseid\': 495810}, {\'name\': \'鼓動盗み、ザグラス\', \'text\': \'この呪文を唱えるためのコストは、あなたのパーティーを構成しているクリーチャー１体につき{1}少なくなる。\\n飛行、接死、速攻\\n他の、あなたがコントロールしているクリーチャーは接死を持つ。\\nあなたがコントロールしているクリーチャー１体がプレインズウォーカー１体に戦闘ダメージを与えるたび、そのプレインズウォーカーを破壊する。\', \'type\': \'伝説のクリーチャー — 吸血鬼・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495885&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef12b0c1-2002-43c4-8b1b-ec9be6b17c4e\', \'multiverseId\': 495885}, \'multiverseid\': 495885}]', '[{\'name\': \'Zareth San, der Trickser\', \'text\': \'Aufblitzen\\n{2}{U}{B}, bringe einen ungeblockten angreifenden Räuber, den du kontrollierst, auf die Hand seines Besitzers zurück: Bringe Zareth San, den Trickser, aus deiner Hand getappt und angreifend ins Spiel.\\nImmer wenn Zareth San, der Trickser, einem Spieler Kampfschaden zufügt, kannst du eine bleibende Karte deiner Wahl aus dem Friedhof des Spielers unter deiner Kontrolle ins Spiel bringen.\', \'type\': \'Legendäre Kreatur — Meervolk, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492209&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea23898b-7211-4d86-9d8a-e783030dca6d\', \'multiverseId\': 492209}, \'multiverseid\': 492209}, {\'name\': \'Záreth San, el Farsante\', \'text\': \'Destello.\\n{2}{U}{B}, regresar un Bribón atacante no bloqueado que controlas a la mano de su propietario: Pon a Záreth San, el Farsante de tu mano en el campo de batalla girado y atacando.\\nSiempre que Záreth San haga daño de combate a un jugador, puedes poner la carta de permanente objetivo del cementerio de ese jugador en el campo de batalla bajo tu control.\', \'type\': \'Criatura legendaria — Bribón tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9137081-ad8c-4349-bba1-fea197fc8165\', \'multiverseId\': 492525}, \'multiverseid\': 492525}, {\'name\': \'Zareth San, le retors\', \'text\': \'Flash\\n{2}{U}{B}, renvoyez un gredin attaquant non-bloqué que vous contrôlez dans la main de son propriétaire : Mettez sur le champ de bataille Zareth San, le retors, engagé et attaquant, depuis votre main.\\nÀ chaque fois que Zareth San inflige des blessures de combat à un joueur, vous pouvez mettre sur le champ de bataille, sous votre contrôle, une carte de permanent ciblée depuis le cimetière de ce joueur.\', \'type\': \'Créature légendaire : ondin et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492841&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'777cda68-c785-4213-82e8-ba1eb76975fc\', \'multiverseId\': 492841}, \'multiverseid\': 492841}, {\'name\': "Zareth San, l\'Ingannevole", \'text\': "Lampo\\n{2}{U}{B}, Fai tornare un Farabutto attaccante non bloccato che controlli in mano al suo proprietario: Metti Zareth San, l\'Ingannevole sul campo di battaglia dalla tua mano TAPpato e attaccante.\\nOgniqualvolta Zareth San infligge danno da combattimento a un giocatore, puoi mettere sul campo di battaglia sotto il tuo controllo una carta permanente bersaglio dal cimitero di quel giocatore.", \'type\': \'Creatura Leggendaria — Farabutto Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493157&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6efe8027-bb69-4338-9b4f-8b993c0eefd5\', \'multiverseId\': 493157}, \'multiverseid\': 493157}, {\'name\': \'トリックスター、ザレス・サン\', \'text\': \'瞬速\\n{2}{U}{B}, あなたがコントロールしていて攻撃していてブロックされていないならず者１体をオーナーの手札に戻す：あなたは、あなたの手札からトリックスター、ザレス・サンをタップ状態かつ攻撃している状態で戦場に出してもよい。\\nトリックスター、ザレス・サンがプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーの墓地からパーマネント・カード１枚を対象とする。あなたはそれをあなたのコントロール下で戦場に出してもよい。\', \'type\': \'伝説のクリーチャー — マーフォーク・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493473&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ef218ef-f81b-4f1e-94dc-044f6f281ab4\', \'multiverseId\': 493473}, \'multiverseid\': 493473}, {\'name\': \'사기꾼, 자레스 산\', \'text\': \'섬광\\n{2}{U}{B}, 당신이 조종하는 공격 중이며 방어되지 않은 도적 한 개를 소유자의 손으로 되돌린다: 사기꾼, 자레스 산을 당신의 손에서 탭되어 공격 중인 상태로 전장에 놓는다.\\n자레스 산이 플레이어에게 전투피해를 입힐 때마다, 그 플레이어의 무덤에 있는 지속물 카드 한 장을 목표로 정한다. 당신은 그 카드를 당신의 조종하에 전장에 놓을 수 있다.\', \'type\': \'전설적 생물 — 인어 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493789&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8d853b2e-d07e-48dc-a2a8-d1c55fddcd8d\', \'multiverseId\': 493789}, \'multiverseid\': 493789}, {\'name\': \'Zareth San, o Trapaceiro\', \'text\': \'Lampejo\\n{2}{U}{B}, devolva um Ladino atacante não bloqueado que você controla para a mão de seu dono: Coloque Zareth San, o Trapaceiro, de sua mão no campo de batalha virado e atacando.\\nToda vez que Zareth San causa dano de combate a um jogador, você pode colocar o card de permanente alvo do cemitério daquele jogador no campo de batalha sob seu controle.\', \'type\': \'Criatura Lendária — Tritão Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494105&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8eb68479-cdfb-493c-bb52-7962e251b73e\', \'multiverseId\': 494105}, \'multiverseid\': 494105}, {\'name\': \'Зарет Сан, Проказник\', \'text\': \'Миг\\n{2}{U}{B}, верните незаблокированного атакующего Бродягу под вашим контролем в руку его владельца: положите Зарета Сана, Проказника из вашей руки на поле битвы повернутым и атакующим.\\nКаждый раз, когда Зарет Сан наносит боевые повреждения игроку, вы можете положить целевую карту перманента из кладбища того игрока на поле битвы под вашим контролем.\', \'type\': \'Легендарное Существо — Мерфолк Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494421&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d39286b-9903-406e-9b22-e62b0744f58f\', \'multiverseId\': 494421}, \'multiverseid\': 494421}, {\'name\': \'诈术师泽雷尚\', \'text\': \'闪现\\n{2}{U}{B}，将一个由你操控、进行攻击且未受阻挡的浪客移回其拥有者手上：将诈术师泽雷尚从你手上横置放进战场且正进行攻击。\\n每当泽雷尚对任一牌手造成战斗伤害时，你可以将目标永久物牌在你的操控下从该牌手的坟墓场放进战场。\', \'type\': \'传奇生物 ～人鱼／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494737&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62fd270f-a726-4c61-84d7-93053efd7bed\', \'multiverseId\': 494737}, \'multiverseid\': 494737}, {\'name\': \'詐術師澤雷尚\', \'text\': \'閃現\\n{2}{U}{B}，將一個由你操控、進行攻擊且未受阻擋的浪客移回其擁有者手上：將詐術師澤雷尚從你手上橫置放進戰場且正進行攻擊。\\n每當澤雷尚對任一玩家造成戰鬥傷害時，你可以將目標永久物牌在你的操控下從該玩家的墳墓場放進戰場。\', \'type\': \'傳奇生物 ～人魚／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495053&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9a1fcc97-041f-45d6-a5e3-612a6f2a55f9\', \'multiverseId\': 495053}, \'multiverseid\': 495053}]', "[{'name': 'Zareth San, der Trickser', 'text': 'Aufblitzen\\n{2}{U}{B}, bringe einen ungeblockten angreifenden Räuber, den du kontrollierst, auf die Hand seines Besitzers zurück: Bringe Zareth San, den Trickser, aus deiner Hand getappt und angreifend ins Spiel.\\nImmer wenn Zareth San, der Trickser, einem Spieler Kampfschaden zufügt, kannst du eine bleibende Karte deiner Wahl aus dem Friedhof des Spielers unter deiner Kontrolle ins Spiel bringen.', 'type': 'Legendäre Kreatur — Meervolk, Räuber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495736&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ce8260f1-6024-4512-aafa-8eb2dc5d45c2', 'multiverseId': 495736}, 'multiverseid': 495736}, {'name': 'Zareth San, le retors', 'text': 'Flash\\n{2}{U}{B}, renvoyez un gredin attaquant non-bloqué que vous contrôlez dans la main de son propriétaire : Mettez sur le champ de bataille Zareth San, le retors, engagé et attaquant, depuis votre main.\\nÀ chaque fois que Zareth San inflige des blessures de combat à un joueur, vous pouvez mettre sur le champ de bataille, sous votre contrôle, une carte de permanent ciblée depuis le cimetière de ce joueur.', 'type': 'Créature légendaire : ondin et gredin', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495811&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9e21719f-6b66-4747-a858-724e35e16fac', 'multiverseId': 495811}, 'multiverseid': 495811}, {'name': 'トリックスター、ザレス・サン', 'text': '瞬速\\n{2}{U}{B}, あなたがコントロールしていて攻撃していてブロックされていないならず者１体をオーナーの手札に戻す：あなたは、あなたの手札からトリックスター、ザレス・サンをタップ状態かつ攻撃している状態で戦場に出してもよい。\\nトリックスター、ザレス・サンがプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーの墓地からパーマネント・カード１枚を対象とする。あなたはそれをあなたのコントロール下で戦場に出してもよい。', 'type': '伝説のクリーチャー — マーフォーク・ならず者', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=495886&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3a1fddbe-bbd2-4302-86a3-57dc55f13e74', 'multiverseId': 495886}, 'multiverseid': 495886}]", '[{\'name\': \'Zofwald-Auszehrung // Zofwald-Blutmoor\', \'text\': \'Das Zofwald-Blutmoor kommt getappt ins Spiel.\\n{T}: Erzeuge {B}.\\nHexerei\\n{4}{B}{B}\', \'type\': \'Land\', \'flavor\': \'„Schau dir diesen Ort an. Welchen Beweis brauchst du noch, dass die Existenz trostlos und bedeutungslos ist?"\\n—Voshk, Priester des Vergessens\', \'faceName\': \'Zofwald-Blutmoor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492086&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fcdca150-7186-43d1-9eba-28b4e05dfb10\', \'multiverseId\': 492086}, \'multiverseid\': 492086}, {\'name\': \'Consumo de Zof // Pantano de sangre de Zof\', \'text\': \'El Pantano de sangre de Zof entra al campo de batalla girado.\\n{T}: Agrega {B}.\\nConjuro\\n{4}{B}{B}\', \'type\': \'Tierra\', \'flavor\': \'"Echa un vistazo a este lugar. ¿Qué otra evidencia necesitas para comprender que la existencia es lúgubre y carente de significado?\\n—Voshk, sacerdote del olvido\', \'faceName\': \'Pantano de sangre de Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83a39e68-865a-4d5e-8116-4f1e7ff8405c\', \'multiverseId\': 492402}, \'multiverseid\': 492402}, {\'name\': \'Festin de Zof // Marécage sanguinolent de Zof\', \'text\': \'Le Marécage sanguinolent de Zof arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {B}.\\nRituel\\n{4}{B}{B}\', \'type\': \'Terrain\', \'flavor\': "« Regardez cet endroit. Que vous faut-il de plus pour accepter que l\'existence est sinistre et futile ? »\\n—Voshk, prêtre de l\'oubli", \'faceName\': \'Marécage sanguinolent de Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492718&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b030b48f-1328-4762-b00f-16883546fe27\', \'multiverseId\': 492718}, \'multiverseid\': 492718}, {\'name\': \'Consumazione di Zof // Palude Sanguigna di Zof\', \'text\': \'La Palude Sanguigna di Zof entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {B}.\\nStregoneria\\n{4}{B}{B}\', \'type\': \'Terra\', \'flavor\': \'"Guarda questo posto. Quali altre prove ti servono del fatto che l\\\'esistenza è squallida e insignificante?"\\n—Voshk, sacerdote dell\\\'oblio\', \'faceName\': \'Palude Sanguigna di Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56dbbc19-3567-4b92-a878-0106acec5f45\', \'multiverseId\': 493034}, \'multiverseid\': 493034}, {\'name\': \'ゾフの消耗 // ゾフの血溜まり\', \'text\': \'ゾフの血溜まりはタップ状態で戦場に出る。\\n{T}：{B}を加える。\\nソーサリー\\n{4}{B}{B}\', \'type\': \'土地\', \'flavor\': \'「この場所を見よ。存在とは不毛で無意味だという、これ以上のどんな証拠が必要だと言うのか？」\\n――忘却の僧侶、ヴォシュク\', \'faceName\': \'ゾフの血溜まり\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493350&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f86fd44-e961-4fe4-bedf-7a98624152ea\', \'multiverseId\': 493350}, \'multiverseid\': 493350}, {\'name\': \'조프식 소모 // 조프 피늪지\', \'text\': \'조프 피늪지는 탭된 채로 전장에 들어온다.\\n{T}: {B}를 추가한다.\\n집중마법\\n{4}{B}{B}\', \'type\': \'대지\', \'flavor\': \'"이 곳을 보아라. 존재라는 것이 황량하고 무의미하다는 증거로 더 무엇이 필요하겠느냐?"\\n—망각 사제, 보쉬크\', \'faceName\': \'조프 피늪지\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493666&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ee3354b4-f303-45a3-973c-d7a52297d182\', \'multiverseId\': 493666}, \'multiverseid\': 493666}, {\'name\': \'Consumição de Zof // Charco Sangrento de Zof\', \'text\': \'Charco Sangrento de Zof entra no campo de batalha virado.\\n{T}: Adicione {B}.\\nFeitiço\\n{4}{B}{B}\', \'type\': \'Terreno\', \'flavor\': \'"Olha esse lugar. Precisa de mais alguma prova de que a existência é deprimente e insignificante?"\\n— Voshk, sacerdote do oblívio\', \'faceName\': \'Charco Sangrento de Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493982&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11c56072-6bad-4099-8922-d3b77d9e2c6f\', \'multiverseId\': 493982}, \'multiverseid\': 493982}, {\'name\': \'Поглощение Зофских Джунглей // Кровотопь Зофских Джунглей\', \'text\': \'Кровотопь Зофских Джунглей выходит на поле битвы повернутой.\\n{T}: добавьте {B}.\\nВолшебство\\n{4}{B}{B}\', \'type\': \'Земля\', \'flavor\': \'«Посмотри на это место. Какие еще тебе нужны доказательства того, что жизнь сера и бессмысленна?»\\n— Восск, жрец забвения\', \'faceName\': \'Кровотопь Зофских Джунглей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494298&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77a3dbef-1ad6-4ae3-8484-1e60b24705fd\', \'multiverseId\': 494298}, \'multiverseid\': 494298}, {\'name\': \'座孚汲取 // 座孚血沼\', \'text\': \'座孚血沼须横置进战场。\\n{T}：加{B}。\\n法术\\n{4}{B}{B}\', \'type\': \'地\', \'flavor\': \'「看看这里。你哪里还需要更多证据才明白生命孱弱无力、了无意义？」\\n～佚界僧侣沃什克\', \'faceName\': \'座孚血沼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494614&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a8cc6561-fbdd-4f52-b739-51139e28ac09\', \'multiverseId\': 494614}, \'multiverseid\': 494614}, {\'name\': \'座孚汲取 // 座孚血沼\', \'text\': \'座孚血沼須橫置進戰場。\\n{T}：加{B}。\\n巫術\\n{4}{B}{B}\', \'type\': \'地\', \'flavor\': \'「看看這裡。你哪裡還需要更多證據才明白生命孱弱無力、了無意義？」\\n～佚界僧侶沃什克\', \'faceName\': \'座孚血沼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494930&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae04235a-515b-4b5e-8b26-1e54ed0729f2\', \'multiverseId\': 494930}, \'multiverseid\': 494930}]', '[{\'name\': \'Zofwald-Auszehrung // Zofwald-Blutmoor\', \'text\': \'Jeder Gegner verliert 4 Lebenspunkte und du erhältst 4 Lebenspunkte dazu.\\nLand\\n{T}: Erzeuge {B}.\', \'type\': \'Hexerei\', \'flavor\': \'„Vernichtung umgibt uns. Wir rufen dazu auf, sich diesem unstillbaren Hunger hinzugeben."\\n—Voshk, Priester des Vergessens\', \'faceName\': \'Zofwald-Auszehrung\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492086&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fcdca150-7186-43d1-9eba-28b4e05dfb10\', \'multiverseId\': 492086}, \'multiverseid\': 492086}, {\'name\': \'Consumo de Zof // Pantano de sangre de Zof\', \'text\': \'Cada oponente pierde 4 vidas y tú ganas 4 vidas.\\nTierra\\n{T}: Agrega {B}.\', \'type\': \'Conjuro\', \'flavor\': \'"Estamos rodeados de aniquilación. Queremos aceptar su hambre incesable".\\n—Voshk, sacerdote del olvido\', \'faceName\': \'Consumo de Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83a39e68-865a-4d5e-8116-4f1e7ff8405c\', \'multiverseId\': 492402}, \'multiverseid\': 492402}, {\'name\': \'Festin de Zof // Marécage sanguinolent de Zof\', \'text\': \'Chaque adversaire perd 4 points de vie et vous gagnez 4 points de vie.\\nTerrain\\n{T} : Ajoutez {B}.\', \'type\': \'Rituel\', \'flavor\': "« L\'annihilation nous entoure. Nous devons accepter sa faim incessante. »\\n—Voshk, prêtre de l\'oubli", \'faceName\': \'Festin de Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492718&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b030b48f-1328-4762-b00f-16883546fe27\', \'multiverseId\': 492718}, \'multiverseid\': 492718}, {\'name\': \'Consumazione di Zof // Palude Sanguigna di Zof\', \'text\': \'Ogni avversario perde 4 punti vita e tu guadagni 4 punti vita.\\nTerra\\n{T}: Aggiungi {B}.\', \'type\': \'Stregoneria\', \'flavor\': \'"L\\\'annientamento ci circonda. Siamo chiamati ad accettare la sua fame incessante."\\n—Voshk, sacerdote dell\\\'oblio\', \'faceName\': \'Consumazione di Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56dbbc19-3567-4b92-a878-0106acec5f45\', \'multiverseId\': 493034}, \'multiverseid\': 493034}, {\'name\': \'ゾフの消耗 // ゾフの血溜まり\', \'text\': \'各対戦相手はそれぞれ４点のライフを失い、あなたは４点のライフを得る。\\n土地\\n{T}：{B}を加える。\', \'type\': \'ソーサリー\', \'flavor\': \'「我々は滅亡に取り囲まれている。我々の選択はその絶え間ない渇望を受け入れることだ。」\\n――忘却の僧侶、ヴォシュク\', \'faceName\': \'ゾフの消耗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493350&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f86fd44-e961-4fe4-bedf-7a98624152ea\', \'multiverseId\': 493350}, \'multiverseid\': 493350}, {\'name\': \'조프식 소모 // 조프 피늪지\', \'text\': \'각 상대는 생명 4점을 잃고 당신은 생명 4점을 얻는다.\\n대지\\n{T}: {B}를 추가한다.\', \'type\': \'집중마법\', \'flavor\': \'"절멸이 우리를 둘러싸고 있다. 우리의 소명은 그 멈추지 않는 굶주림을 받아들이는 것이다."\\n—망각 사제, 보쉬크\', \'faceName\': \'조프식 소모\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493666&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ee3354b4-f303-45a3-973c-d7a52297d182\', \'multiverseId\': 493666}, \'multiverseid\': 493666}, {\'name\': \'Consumição de Zof // Charco Sangrento de Zof\', \'text\': \'Cada oponente perde 4 pontos de vida e você ganha 4 pontos de vida.\\nTerreno\\n{T}: Adicione {B}.\', \'type\': \'Feitiço\', \'flavor\': \'"A aniquilação está por toda parte. Devemos aceitar sua fome incessante."\\n— Voshk, sacerdote do oblívio\', \'faceName\': \'Consumição de Zof\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493982&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11c56072-6bad-4099-8922-d3b77d9e2c6f\', \'multiverseId\': 493982}, \'multiverseid\': 493982}, {\'name\': \'Поглощение Зофских Джунглей // Кровотопь Зофских Джунглей\', \'text\': \'Каждый оппонент теряет 4 жизни, а вы получаете 4 жизни.\\nЗемля\\n{T}: добавьте {B}.\', \'type\': \'Волшебство\', \'flavor\': \'«Истребление окружает нас повсюду. Мы призываем принять его неутолимый голод».\\n— Восск, жрец забвения\', \'faceName\': \'Поглощение Зофских Джунглей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494298&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77a3dbef-1ad6-4ae3-8484-1e60b24705fd\', \'multiverseId\': 494298}, \'multiverseid\': 494298}, {\'name\': \'座孚汲取 // 座孚血沼\', \'text\': \'每位对手各失去4点生命，且你获得4点生命。\\n地\\n{T}：加{B}。\', \'type\': \'法术\', \'flavor\': \'「毁灭将我们包围。我们的唯一出路便是屈服于这无尽饥渴。」\\n～佚界僧侣沃什克\', \'faceName\': \'座孚汲取\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494614&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a8cc6561-fbdd-4f52-b739-51139e28ac09\', \'multiverseId\': 494614}, \'multiverseid\': 494614}, {\'name\': \'座孚汲取 // 座孚血沼\', \'text\': \'每位對手各失去4點生命，且你獲得4點生命。\\n地\\n{T}：加{B}。\', \'type\': \'巫術\', \'flavor\': \'「毀滅將我們包圍。我們的唯一出路便是屈服於這無盡飢渴。」\\n～佚界僧侶沃什克\', \'faceName\': \'座孚汲取\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494930&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae04235a-515b-4b5e-8b26-1e54ed0729f2\', \'multiverseId\': 494930}, \'multiverseid\': 494930}]', '[{\'name\': \'Zulaport-Duellantin\', \'text\': \'Aufblitzen\\nWenn die Zulaport-Duellantin ins Spiel kommt, erhält bis zu eine Kreatur deiner Wahl -2/-0 bis zum Ende des Zuges. Ihr Beherrscher millt zwei Karten. (Er legt die obersten zwei Karten seiner Bibliothek auf seinen Friedhof.)\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492037&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df967ed4-51f1-445b-a909-097c49a522bf\', \'multiverseId\': 492037}, \'multiverseid\': 492037}, {\'name\': \'Duelista de Zulaport\', \'text\': \'Destello.\\nCuando la Duelista de Zulaport entre al campo de batalla, hasta una criatura objetivo obtiene -2/-0 hasta el final del turno. Su controlador muele dos cartas. (Pone las dos primeras cartas de su biblioteca en su cementerio.)\', \'type\': \'Criatura — Bribón humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492353&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e762e11d-2350-4cf8-bf51-a86ccf0ecc31\', \'multiverseId\': 492353}, \'multiverseid\': 492353}, {\'name\': \'Duelliste de Zulaport\', \'text\': "Flash\\nQuand la Duelliste de Zulaport arrive sur le champ de bataille, jusqu\'à une créature ciblée gagne -2/-0 jusqu\'à la fin du tour. Son contrôleur meule deux cartes. (Il met les deux cartes du dessus de sa bibliothèque dans son cimetière.)", \'type\': \'Créature : humain et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492669&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'992b6800-eaf2-462f-b21d-d5697a5586d1\', \'multiverseId\': 492669}, \'multiverseid\': 492669}, {\'name\': \'Duellante di Zulaport\', \'text\': \'Lampo\\nQuando la Duellante di Zulaport entra nel campo di battaglia, fino a una creatura bersaglio prende -2/-0 fino alla fine del turno. Il suo controllore macina due carte. (Mette nel suo cimitero le prime due carte del suo grimorio.)\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492985&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'158c6edd-2d9a-4b07-8f7e-f8583b284351\', \'multiverseId\': 492985}, \'multiverseid\': 492985}, {\'name\': \'ズーラポートの決闘者\', \'text\': \'瞬速\\nズーラポートの決闘者が戦場に出たとき、クリーチャー最大１体を対象とする。ターン終了時まで、それは－２/－０の修整を受ける。それのコントローラーはカードを２枚切削する。（そのプレイヤーは、自分のライブラリーの一番上からカードを２枚自分の墓地に置く。）\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493301&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48c7e3b4-ac08-4352-8111-1d5cf52cf914\', \'multiverseId\': 493301}, \'multiverseid\': 493301}, {\'name\': \'줄라포트 결투사\', \'text\': \'섬광\\n줄라포트 결투사가 전장에 들어올 때, 생물을 최대 한 개까지 목표로 정한다. 그 생물은 턴종료까지 -2/-0을 받는다. 그 생물의 조종자는 카드 두 장을 민다. (그 플레이어는 자신의 서고 맨 위 카드 두 장을 자신의 무덤에 넣는다.)\', \'type\': \'생물 — 인간 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493617&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b4aae539-1cff-42c1-aff1-cd6d686612f2\', \'multiverseId\': 493617}, \'multiverseid\': 493617}, {\'name\': \'Duelista de Zulaport\', \'text\': \'Lampejo\\nQuando Duelista de Zulaport entra no campo de batalha, até uma criatura alvo recebe -2/-0 até o final do turno. Seu controlador tritura dois cards. (Ele coloca os dois cards do topo do próprio grimório no próprio cemitério.)\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493933&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8cca1caf-4c10-4c31-9011-eb88e2300b77\', \'multiverseId\': 493933}, \'multiverseid\': 493933}, {\'name\': \'Дуэлянтка из Зулапорта\', \'text\': \'Миг\\nКогда Дуэлянтка из Зулапорта выходит на поле битвы, не более чем одно целевое существо получает -2/-0 до конца хода. Контролирующий его игрок скручивает две карты. (Он кладет две верхние карты своей библиотеки на свое кладбище.)\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494249&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e9aa07d-4ddf-4102-9922-e49bd4dce459\', \'multiverseId\': 494249}, \'multiverseid\': 494249}, {\'name\': \'筑拉波斗客\', \'text\': \'闪现\\n当筑拉波斗客进战场时，至多一个目标生物得-2/-0直到回合结束。其操控者磨两张牌。（他将其牌库顶的两张牌置入其坟墓场。）\', \'type\': \'生物 ～人类／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494565&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'26d97cb4-5c14-4d37-8c1d-e68a3b9bea6b\', \'multiverseId\': 494565}, \'multiverseid\': 494565}, {\'name\': \'筑拉波鬥客\', \'text\': \'閃現\\n當筑拉波鬥客進戰場時，至多一個目標生物得-2/-0直到回合結束。其操控者磨兩張牌。（他將其牌庫頂的兩張牌置入其墳墓場。）\', \'type\': \'生物 ～人類／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494881&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5323a9b2-a4be-42ed-8152-02dfeec9f181\', \'multiverseId\': 494881}, \'multiverseid\': 494881}]', '[{\'name\': \'Zügelloser Zorn\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+2 bis zum Ende des Zuges. Hellsicht 1.\', \'type\': \'Spontanzauber\', \'flavor\': \'„In den Jahren, die ich durch dieses Land gereist bin, habe ich eine regelrechte Menagerie fantastischer Kreaturen gesehen. Eine, die mir bis jetzt immer entgangen ist, ist jedoch der sagenumwobene ‚gutgelaunte Minotaurus\\\'."\\n—Ko Dari, Zauberin der Expedition\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492100&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ef107b87-d41a-4804-bca7-ea49ea6f731d\', \'multiverseId\': 492100}, \'multiverseid\': 492100}, {\'name\': \'Ira exorbitante\', \'text\': \'La criatura objetivo obtiene +3/+2 hasta el final del turno. Adivina 1.\', \'type\': \'Instantáneo\', \'flavor\': \'"Durante mis años vagando por esta tierra he visto fieras verdaderamente fantásticas, pero la que nunca he visto es el legendario minotauro tranquilo".\\n—Ko Dari, hechicero de expedición\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492416&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'780c84d5-3ab0-406c-afc4-345233803958\', \'multiverseId\': 492416}, \'multiverseid\': 492416}, {\'name\': \'Rage disproportionnée\', \'text\': "Une créature ciblée gagne +3/+2 jusqu\'à la fin du tour. Regard 1.", \'type\': \'Éphémère\', \'flavor\': "« J\'ai passé des années à errer sur ces terres, et j\'ai vu tout un tas de créatures fantastiques, mais il me reste encore à trouver le légendaire minotaure amical. »\\n—Ko Dari, sorcier d\'expédition", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=492732&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4c65e2d7-517f-44fa-afa1-fb24c95c4128\', \'multiverseId\': 492732}, \'multiverseid\': 492732}, {\'name\': \'Ira Sproporzionata\', \'text\': \'Una creatura bersaglio prende +3/+2 fino alla fine del turno. Profetizza 1.\', \'type\': \'Istantaneo\', \'flavor\': \'"Negli anni in cui ho vagato in questa terra ho visto un autentico serraglio di creature fantastiche, ma una che finora è riuscita a eludermi è il leggendario \\\'minotauro mansueto\\\'."\\n—Ko Dari, maga della spedizione\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493048&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd2ddd54-2103-4997-8272-86bdf18a53aa\', \'multiverseId\': 493048}, \'multiverseid\': 493048}, {\'name\': \'異常な怒り\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋２の修整を受ける。占術１を行う。\', \'type\': \'インスタント\', \'flavor\': \'「この地をさまよっている間、私は実に多くの素晴らしい生き物を見てきた。だが今のところ『のんきなミノタウルス』にはまだ出会えていない。」\\n――探検隊の魔術師、コ・ダーリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493364&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8173f1ba-9dfb-45ee-b3a8-c2ca0cea62b7\', \'multiverseId\': 493364}, \'multiverseid\': 493364}, {\'name\': \'지나친 분노\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +3/+2를 받는다. 점술 1을 한다.\', \'type\': \'순간마법\', \'flavor\': \'"이 땅을 떠돌아다니면서 나는 수많은 환상적인 동물들을 보아 왔지만, 지금까지 볼 수 없었던 것 하나는 전설로만 내려오는 \\\'느긋한 미노타우로스\\\'였지."\\n—탐험 마법사, 코 다리\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493680&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ea7f18eb-35b4-4fcf-8c50-3b05d5685e42\', \'multiverseId\': 493680}, \'multiverseid\': 493680}, {\'name\': \'Fúria Desmedida\', \'text\': \'A criatura alvo recebe +3/+2 até o final do turno. Use vidência 1.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Nos meus anos de andança por essas terras, eu já vi um verdadeiro zoológico de criaturas fantásticas, mas uma que não consegui encontrar até hoje foi o lendário \\\'minotauro deboísta\\\'."\\n— Ko Dari, maga da expedição\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=493996&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88eaff2a-06fc-4464-8ba9-4af5d7d8974d\', \'multiverseId\': 493996}, \'multiverseid\': 493996}, {\'name\': \'Необузданный Гнев\', \'text\': \'Целевое существо получает +3/+2 до конца хода. Предскажите 1.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Когда я странствовала по этой стране, то видела изрядное количество фантастических тварей, но существо, которого мне до сих пор не удавалось встретить, — это легендарный „добродушный минотавр"».\\n— Ко-Дари, чародейка экспедиции\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494312&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eab326a3-9f80-4caa-853e-e4e6e818586e\', \'multiverseId\': 494312}, \'multiverseid\': 494312}, {\'name\': \'无度狂怒\', \'text\': \'目标生物得+3/+2直到回合结束。占卜1。\', \'type\': \'瞬间\', \'flavor\': \'「我已在这片土地上游历有年，亲眼见到的奇幻生物数量数不胜数，但迄今为止从未遇到传说中提到过的『随和牛头怪』。」\\n～探险队法师蔻达黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494628&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aec27e8b-32db-46e5-9124-4573ccfffad6\', \'multiverseId\': 494628}, \'multiverseid\': 494628}, {\'name\': \'無度狂怒\', \'text\': \'目標生物得+3/+2直到回合結束。占卜1。\', \'type\': \'瞬間\', \'flavor\': \'「我已在這片土地上遊歷有年，親眼見到的奇幻生物數量數不勝數，但迄今為止從未遇到傳說中提到過的『隨和牛頭怪』。」\\n～探險隊法師蔻達黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=494944&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4f4af057-a357-4c29-a819-7efda08a12d1\', \'multiverseId\': 494944}, \'multiverseid\': 494944}]']
