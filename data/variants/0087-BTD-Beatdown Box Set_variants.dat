type: ['Artifact Creature — Beast', 'Artifact Creature — Bird', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Swamp', 'Creature — Angel', 'Creature — Ape', 'Creature — Boar', 'Creature — Crab', 'Creature — Cyclops', 'Creature — Cyclops Warrior', 'Creature — Djinn', 'Creature — Dragon', 'Creature — Drake', 'Creature — Elemental', 'Creature — Elf Druid', 'Creature — Giant', 'Creature — Goblin Berserker', 'Creature — Human Barbarian', 'Creature — Insect', 'Creature — Leviathan', 'Creature — Minotaur Berserker', 'Creature — Nightstalker', 'Creature — Phyrexian Horror', 'Creature — Phyrexian Imp', 'Creature — Phyrexian Zombie Dog', 'Creature — Rhino', 'Creature — Spider', 'Creature — Spirit', 'Creature — Vampire', 'Creature — Viashino Warrior', 'Creature — Whale', 'Creature — Wurm', 'Creature — Yeti', 'Creature — Zombie', 'Enchantment — Aura', 'Instant', 'Land', 'Sorcery']
