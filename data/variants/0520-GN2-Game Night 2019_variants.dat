type: ['Artifact Creature — Golem', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Angel', 'Creature — Bird Wizard', 'Creature — Cat Beast', 'Creature — Devil', 'Creature — Dinosaur', 'Creature — Dragon', 'Creature — Dragon Egg', 'Creature — Elemental', 'Creature — Giant Druid', 'Creature — Human Soldier', 'Creature — Human Warrior', 'Creature — Kor Knight Ally', 'Creature — Merfolk Wizard', 'Creature — Minotaur Archer', 'Creature — Serpent', 'Creature — Sphinx', 'Creature — Vampire Warrior', 'Creature — Zombie', 'Creature — Zombie Bird', 'Creature — Zombie Jackal', 'Creature — Zombie Wizard', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Legendary Creature — Avatar', 'Legendary Creature — Dragon', 'Legendary Creature — Elder Dinosaur', 'Sorcery']
