subtypes: ['Ally', 'Angel', 'Archer', 'Aura', 'Avatar', 'Beast', 'Bird', 'Cat', 'Devil', 'Dinosaur', 'Dragon', 'Druid', 'Egg', 'Elder', 'Elemental', 'Forest', 'Giant', 'Golem', 'Human', 'Island', 'Jackal', 'Knight', 'Kor', 'Merfolk', 'Minotaur', 'Mountain', 'Plains', 'Serpent', 'Soldier', 'Sphinx', 'Swamp', 'Vampire', 'Warrior', 'Wizard', 'Zombie']
