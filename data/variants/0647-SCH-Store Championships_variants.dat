names: []
mana_cost: ['{1}{B}', '{1}{W}{B}', '{1}{W}{B}{G}', '{2}{G}{G}', '{2}{R}{R}', '{2}{U}', '{2}{U}{U}', '{2}{W}', '{3}{B}{B}', '{3}{U}{U}', '{3}{W}{W}{B}{B}', '{5}', '{5}{W}{W}{W}', '{B}', '{B}{B}', '{G}', '{R}', '{R}{G}{W}{U}', '{R}{R}', '{U}', '{U}{U}{U}', '{X}{U}{U}{U}{U}']
