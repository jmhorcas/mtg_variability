subtypes: ['Advisor', 'Bird', 'Elemental', 'Elf', 'Equipment', 'Forest', 'God', 'Human', 'Island', 'Monk', 'Mountain', 'Plains', 'Shaman', 'Spirit', 'Swamp', 'Wurm']
