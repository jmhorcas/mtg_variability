type: ['Artifact — Equipment', 'Creature — Bird', 'Creature — Elemental', 'Creature — Elf Shaman', 'Creature — Human Monk', 'Creature — Wurm', 'Enchantment Creature — Spirit', 'Instant', 'Land', 'Land — Forest Plains', 'Land — Island Swamp', 'Land — Mountain Forest', 'Land — Plains Island', 'Land — Swamp Mountain', 'Legendary Creature — Elemental', 'Legendary Creature — Spirit Advisor', 'Legendary Enchantment Creature — God', 'Sorcery']
