name: ['Animar, Soul of Elements', 'Damia, Sage of Stone', 'Ghave, Guru of Spores', 'Intet, the Dreamer', 'Kaalia of the Vast', 'Karador, Ghost Chieftain', 'Numot, the Devastator', 'Oros, the Avenger', 'Riku of Two Reflections', 'Ruhan of the Fomori', 'Tariel, Reckoner of Souls', 'Teneb, the Harvester', 'The Mimeoplasm', 'Vorosh, the Hunter', 'Zedruu the Greathearted']
multiverse_id: []
layout: ['normal']
names: []
mana_cost: ['{1}{R}{W}{B}', '{1}{U}{R}{W}', '{2}{B}{G}{U}', '{2}{G}{U}{R}', '{2}{W}{B}{G}', '{3}{B}{G}{U}', '{3}{G}{U}{R}', '{3}{R}{W}{B}', '{3}{U}{R}{W}', '{3}{W}{B}{G}', '{4}{B}{G}{U}', '{4}{R}{W}{B}', '{5}{W}{B}{G}', '{G}{U}{R}']
