rulings: ['[{\'date\': \'2006-02-01\', \'text\': "This spell isn\'t modal. When it resolves, it will destroy the target if it\'s a creature or an artifact, even if it changed from one to the other between targeting and resolution."}]', "[{'date': '2008-08-01', 'text': 'The ability triggers even if the Specter’s damage is being redirected to an opponent. It does not trigger if damage that would have been dealt to the opponent is redirected to a nonopponent player or a creature, or if the damage is prevented.'}]", '[{\'date\': \'2017-11-17\', \'text\': "If the chosen target is illegal when Lightning Helix tries to resolve, it won\'t resolve and none of its effects will happen. You won\'t gain 3 life."}]', '[{\'date\': \'2020-08-07\', \'text\': "Hinder\'s controller, not necessarily the controller of the countered spell, chooses where the countered spell goes."}]']
