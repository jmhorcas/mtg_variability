rulings: ["[{'date': '2017-09-29', 'text': 'All attackers are chosen at once. You can’t attack with Bishop of Rebirth, return a creature card to the battlefield, and then attack with that creature.'}, {'date': '2017-09-29', 'text': 'If the creature returned to the battlefield has any abilities that trigger when creatures attack, those abilities won’t trigger.'}, {'date': '2017-09-29', 'text': 'If the mana cost of a card in your graveyard includes X, X is considered to be 0.'}]", "[{'date': '2017-09-29', 'text': 'Deeproot Champion’s ability resolves before the spell that caused it to trigger.'}]", "[{'date': '2017-09-29', 'text': 'If the ability of Burning Sun’s Avatar has two targets and one becomes illegal, the other will still be dealt damage.'}, {'date': '2017-09-29', 'text': 'The ability of Burning Sun’s Avatar can target any creature, not just one controlled by the target opponent.'}]", '[{\'date\': \'2018-01-19\', \'text\': \'To choose a creature type, you must choose an existing creature type, such as Vampire or Knight. You can\\\'t choose multiple creature types, such as "Vampire Knight." Card types such as artifact can\\\'t be chosen, nor can subtypes that aren\\\'t creature types, such as Jace, Vehicle, or Treasure.\'}]']
