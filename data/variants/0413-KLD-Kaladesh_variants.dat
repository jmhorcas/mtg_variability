age.ashx?multiverseid=418889&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8aba4b30-5a1e-4551-8aea-93437b1ed8f2', 'multiverseId': 418889}, 'multiverseid': 418889}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419153&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '28307ae1-cf72-4d10-bb9c-424d352f7f5a', 'multiverseId': 419153}, 'multiverseid': 419153}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419417&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd76a8fbd-885e-460f-aaf9-868be43298d4', 'multiverseId': 419417}, 'multiverseid': 419417}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419681&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '5ac58359-1d54-4a5e-ac26-19b563524134', 'multiverseId': 419681}, 'multiverseid': 419681}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419945&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ab677748-53ff-4f85-977c-a58318b5468c', 'multiverseId': 419945}, 'multiverseid': 419945}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420209&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2547b9cd-1835-4c37-9842-906e972ecaee', 'multiverseId': 420209}, 'multiverseid': 420209}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418097&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '01acf3de-bf11-4696-9ba7-1f16f8073698', 'multiverseId': 418097}, 'multiverseid': 418097}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418361&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3e8212b5-10ff-40cf-81ca-d10b8cfd036e', 'multiverseId': 418361}, 'multiverseid': 418361}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418626&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bc7fbe24-22e9-4619-9ac7-5f6f39aa087b', 'multiverseId': 418626}, 'multiverseid': 418626}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420474&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0f976606-995a-4c58-8209-80d5f67e9e79', 'multiverseId': 420474}, 'multiverseid': 420474}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418890&type=card', 'language': 'French', 'identifiers': {'scryfallId': '722382ba-7f19-429f-a20c-bbbdb08c13ff', 'multiverseId': 418890}, 'multiverseid': 418890}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419154&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c2862ea5-7747-4578-8c4a-842a3c87f4e1', 'multiverseId': 419154}, 'multiverseid': 419154}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419418&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '19ad76c6-f7b5-4b4b-a654-73deef62721b', 'multiverseId': 419418}, 'multiverseid': 419418}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419682&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8c16d712-020e-4049-a60e-ad651a7a5605', 'multiverseId': 419682}, 'multiverseid': 419682}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419946&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '094a7918-7da5-4656-8951-6273a60d41f2', 'multiverseId': 419946}, 'multiverseid': 419946}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420210&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c668651b-da06-486b-a948-0e9f8235fd4b', 'multiverseId': 420210}, 'multiverseid': 420210}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418098&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '065627f5-ef41-4662-a1c5-823cb07d88d0', 'multiverseId': 418098}, 'multiverseid': 418098}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418362&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '6586e89e-738b-43fa-8f31-f41218d4f46b', 'multiverseId': 418362}, 'multiverseid': 418362}]", '[{\'name\': \'Gebändigter Blitz\', \'text\': \'Bestimme eine Kreatur deiner Wahl. Du erhältst {E}{E}{E} (drei Energiemarken), dann kannst du eine beliebige Menge {E} bezahlen. Der Gebändigte Blitz fügt der bestimmten Kreatur entsprechend viele Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418482&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f53edb56-4a42-485a-8139-6eb0a2956dbf\', \'multiverseId\': 418482}, \'multiverseid\': 418482}, {\'name\': \'Doma del relámpago\', \'text\': \'Elige una criatura objetivo. Obtienes {E}{E}{E} (tres contadores de energía). Luego puedes pagar cualquier cantidad de {E}. La Doma del relámpago le hace esa misma cantidad de daño a esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420330&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'37f6acdd-c218-4e41-9200-06549f7dcfaa\', \'multiverseId\': 420330}, \'multiverseid\': 420330}, {\'name\': \'Éclairs maîtrisés\', \'text\': "Choisissez une créature ciblée. Vous gagnez {E}{E}{E} (trois marqueurs « énergie »), puis vous pouvez payer n\'importe quelle quantité de {E}. Les Éclairs maîtrisés infligent autant de blessures à cette créature.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'99dd6716-f92d-4154-a30f-c02aa29ad87e\', \'multiverseId\': 418746}, \'multiverseid\': 418746}, {\'name\': \'Fulmine Imbrigliato\', \'text\': \'Scegli una creatura bersaglio. Ottieni {E}{E}{E} (tre segnalini energia), poi puoi pagare un qualsiasi ammontare di {E}. Il Fulmine Imbrigliato infligge altrettanti danni a quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419010&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f1859a6-58a3-4b5d-b4a4-fc1ef7404413\', \'multiverseId\': 419010}, \'multiverseid\': 419010}, {\'name\': \'蓄霊稲妻\', \'text\': \'クリーチャー１体を対象とする。あなたは{E}{E}{E}（エネルギー・カウンター３個）を得る。その後あなたは望む数の{E}を支払ってもよい。蓄霊稲妻はそのクリーチャーに、その支払った数に等しい点数のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419274&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e18ba695-1e94-45cf-a28a-83b10d3a1ad1\', \'multiverseId\': 419274}, \'multiverseid\': 419274}, {\'name\': \'통제된 번개\', \'text\': \'생물을 목표로 정한다. 당신은 {E}{E}{E}(에너지 카운터 세 개)를 얻은 후, 원하는 만큼 {E}를 지불할 수 있다. 통제된 번개는 그 생물에게 그만큼의 피해를 입힌다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419538&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0a29a623-f3c6-4cb3-b9f1-38d763768ad8\', \'multiverseId\': 419538}, \'multiverseid\': 419538}, {\'name\': \'Raio Domesticado\', \'text\': \'Escolha uma criatura alvo. Você recebe {E}{E}{E} (três marcadores de energia) e em seguida pode pagar qualquer quantidade de {E}. Raio Domesticado causa uma quantidade equivalente de dano àquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419802&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb3dbdd8-2ce9-4f2d-a3e6-ad7a23647527\', \'multiverseId\': 419802}, \'multiverseid\': 419802}, {\'name\': \'Укрощенная Молния\', \'text\': \'Выберите целевое существо. Вы получаете {E}{E}{E} (три жетона энергии), затем вы можете заплатить любое количество {E}. Укрощенная Молния наносит такое же количество повреждений тому существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420066&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'403f120b-15b6-4530-81f6-0f1bd6c80483\', \'multiverseId\': 420066}, \'multiverseid\': 420066}, {\'name\': \'受控闪电\', \'text\': \'选择目标生物。你得到{E}{E}{E}（三个能量指示物），然后你可以支付任意数量的{E}。受控闪电对该生物造成等量的伤害。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417954&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5f2deb69-4b00-475f-bd7c-e2af7a171ed3\', \'multiverseId\': 417954}, \'multiverseid\': 417954}, {\'name\': \'受控閃電\', \'text\': \'選擇目標生物。你得到{E}{E}{E}（三個能量指示物），然後你可以支付任意數量的{E}。受控閃電對該生物造成等量的傷害。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418218&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d0c40f95-c7d5-44ed-b934-1014f21989d0\', \'multiverseId\': 418218}, \'multiverseid\': 418218}]', '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten ab.\', \'type\': \'Hexerei\', \'flavor\': \'So manche Erfinder scheitern an dem Druck, ein makelloses Konstrukt zu entwerfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418458&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c1e7432-3d84-4854-98e0-77a8bd654390\', \'multiverseId\': 418458}, \'multiverseid\': 418458}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Más de un inventor se ha venido abajo por la presión de crear el diseño perfecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420306&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2168541f-394f-479b-af5e-d56956d63cfe\', \'multiverseId\': 420306}, \'multiverseid\': 420306}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "Plus d\'un inventeur s\'est fourvoyé dans la quête de la conception parfaite.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418722&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9c70e280-029c-473c-8835-f5a1860cb80a\', \'multiverseId\': 418722}, \'multiverseid\': 418722}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': "Più di un inventore è stato schiacciato dall\'ossessione di creare il progetto perfetto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418986&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ebf3729a-a2f4-443e-9e58-5d80a2ec141c\', \'multiverseId\': 418986}, \'multiverseid\': 418986}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカード２枚を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'完璧な設計を生み出すという重圧に潰された発明者は数知れない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419250&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37ab965f-6c44-451b-8df2-4f78174074f8\', \'multiverseId\': 419250}, \'multiverseid\': 419250}, {\'name\': \'정신 부패\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'많은 발명가들이 완벽한 디자인을 만들려는 스트레스에 못 이겨 쓰러진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419514&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'df8bce25-d4ae-477f-8050-d49c867521ba\', \'multiverseId\': 419514}, \'multiverseid\': 419514}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Muitos inventores entraram em colapso ante à pressão de criar um projeto impecável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419778&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bde4bcfc-5804-4973-aa71-50522ec51f93\', \'multiverseId\': 419778}, \'multiverseid\': 419778}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Многих изобретателей подкосило стремление создать безупречное произведение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420042&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'254f74dc-5035-48d9-8336-0d927c9bfb88\', \'multiverseId\': 420042}, \'multiverseid\': 420042}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'许多发明家因创造无瑕设计的压力而崩溃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417930&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'753b2553-806a-444d-8702-154c38f73cb9\', \'multiverseId\': 417930}, \'multiverseid\': 417930}, {\'name\': \'心之衰\', \'text\': \'目標玩家棄兩張牌。\', \'type\': \'巫術\', \'flavor\': \'許多發明家因創造無瑕設計的壓力而崩潰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418194&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dbe752a7-7587-46d7-ac79-d19145fb1b9e\', \'multiverseId\': 418194}, \'multiverseid\': 418194}]', "[{'name': 'Gedeihende Grubblinge', 'text': 'Wenn die Gedeihenden Grubblinge ins Spiel kommen, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn die Gedeihenden Grubblinge angreifen, kannst du {E}{E} bezahlen. Falls du dies tust, lege eine +1/+1-Marke auf sie.', 'type': 'Kreatur — Gremlin', 'flavor': 'Manche Passagiere reisen ohne Fahrschein.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418503&type=card', 'language': 'German', 'identifiers': {'scryfallId': '61dd8f17-fcdd-45cd-995c-bda7caaee92c', 'multiverseId': 418503}, 'multiverseid': 418503}, {'name': 'Vermilinguos impetuosos', 'text': 'Cuando los Vermilinguos impetuosos entren al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que los Vermilinguos impetuosos ataquen, puedes pagar {E}{E}. Si lo haces, pon un contador +1/+1 sobre ellos.', 'type': 'Criatura — Gremlin', 'flavor': 'Algunos pasajeros viajan sin billete.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420351&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7539e4de-e493-42dc-8f47-96fefa42c4b3', 'multiverseId': 420351}, 'multiverseid': 420351}, {'name': 'Larves prospères', 'text': 'Quand les Larves prospères arrivent sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que les Larves prospères attaquent, vous pouvez payer {E}{E}. Si vous faites ainsi, mettez un marqueur +1/+1 sur elles.', 'type': 'Créature : gremlin', 'flavor': 'Certains passagers voyagent sans ticket.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418767&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'df9fa2e6-d05a-44a9-93d7-a1b8199861e5', 'multiverseId': 418767}, 'multiverseid': 418767}, {'name': 'Larve Vigorose', 'text': 'Quando le Larve Vigorose entrano nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta le Larve Vigorose attaccano, puoi pagare {E}{E}. Se lo fai, metti un segnalino +1/+1 su di esse.', 'type': 'Creatura — Gremlin', 'flavor': 'Alcuni passeggeri non pagano il biglietto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419031&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5bc4ec64-c0d5-412a-ade3-f5087db458c6', 'multiverseId': 419031}, 'multiverseid': 419031}, {'name': '亢進する地虫', 'text': '亢進する地虫が戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n亢進する地虫が攻撃するたび、あなたは{E}{E}を支払ってもよい。そうしたなら、これの上に＋１/＋１カウンターを１個置く。', 'type': 'クリーチャー — グレムリン', 'flavor': '切符を買った乗客ばかりではない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419295&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c6eada6f-8bce-44f9-a713-264988848060', 'multiverseId': 419295}, 'multiverseid': 419295}, {'name': '원기왕성한 유충', 'text': '원기왕성한 유충이 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n원기왕성한 유충이 공격할 때마다, 당신은 {E}{E}를 지불할 수 있다. 그렇게 한다면, 원기왕성한 유충에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 그렘린', 'flavor': '일부 승객은 무임으로 승차한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419559&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'bd245929-a3a0-4e0e-9d50-27b8161721df', 'multiverseId': 419559}, 'multiverseid': 419559}, {'name': 'Larvas Vigorosas', 'text': 'Quando Larvas Vigorosas entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Larvas Vigorosas ataca, você pode pagar {E}{E}. Se fizer isso, coloque um marcador +1/+1 nela.', 'type': 'Criatura — Gremlin', 'flavor': 'Alguns passageiros não pagam.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419823&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa05c7bd-8150-4902-86ef-661bf8e2381d', 'multiverseId': 419823}, 'multiverseid': 419823}, {'name': 'Здоровые Толстопузы', 'text': 'Когда Здоровые Толстопузы выходят на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Здоровые Толстопузы атакуют, вы можете заплатить {E}{E}. Если вы это делаете, положите на них один жетон +1/+1.', 'type': 'Существо — Гремлин', 'flavor': 'Кое-кто из пассажиров катается зайцем.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420087&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '03f1264d-34b9-469d-8fe7-c42544016e45', 'multiverseId': 420087}, 'multiverseid': 420087}, {'name': '强旺幼灵', 'text': '当强旺幼灵进战场时，你得到{E}{E}（两个能量指示物）。\\n每当强旺幼灵攻击时，你可以支付{E}{E}。若你如此作，则在其上放置一个+1/+1指示物。', 'type': '生物～怪灵', 'flavor': '有些乘客搭车不买票。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417975&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0e7cce31-f75b-4046-9f90-4f8d81917ae6', 'multiverseId': 417975}, 'multiverseid': 417975}, {'name': '強旺幼靈', 'text': '當強旺幼靈進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當強旺幼靈攻擊時，你可以支付{E}{E}。若你如此作，則在其上放置一個+1/+1指示物。', 'type': '生物～怪靈', 'flavor': '有些乘客搭車不買票。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418239&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2ee4b24a-d1ca-4924-8be3-1d53e1138bde', 'multiverseId': 418239}, 'multiverseid': 418239}]", "[{'name': 'Gedeihende Ratten', 'text': 'Wenn die Gedeihenden Ratten ins Spiel kommen, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn die Gedeihenden Ratten angreifen, kannst du {E}{E} bezahlen. Falls du dies tust, lege eine +1/+1-Marke auf sie.', 'type': 'Kreatur — Ratte', 'flavor': 'In Ghirapur leben selbst die niedersten Bewohner in üppigen Verhältnissen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418467&type=card', 'language': 'German', 'identifiers': {'scryfallId': '51e5ba37-2375-410d-8231-cf70c101786a', 'multiverseId': 418467}, 'multiverseid': 418467}, {'name': 'Ratas impetuosas', 'text': 'Cuando las Ratas impetuosas entren al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que las Ratas impetuosas ataquen, puedes pagar {E}{E}. Si lo haces, pon un contador +1/+1 sobre ellas.', 'type': 'Criatura — Rata', 'flavor': 'En Ghirapur, hasta los residentes más inmundos viven en entornos lujosos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420315&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5f12026b-1047-4440-9f1a-c8ab72cc979b', 'multiverseId': 420315}, 'multiverseid': 420315}, {'name': 'Rats prospères', 'text': 'Quand les Rats prospères arrivent sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que les Rats prospères attaquent, vous pouvez payer {E}{E}. Si vous faites ainsi, mettez un marqueur +1/+1 sur eux.', 'type': 'Créature : rat', 'flavor': 'À Ghirapur, même les habitants les plus misérables vivent dans un environnement luxueux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418731&type=card', 'language': 'French', 'identifiers': {'scryfallId': '17e3e7db-09a5-4e08-b415-a29cf79c7abd', 'multiverseId': 418731}, 'multiverseid': 418731}, {'name': 'Ratti Vigorosi', 'text': 'Quando i Ratti Vigorosi entrano nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta i Ratti Vigorosi attaccano, puoi pagare {E}{E}. Se lo fai, metti un segnalino +1/+1 su di essi.', 'type': 'Creatura — Ratto', 'flavor': 'Persino gli abitanti più abietti di Ghirapur vivono in ambienti lussuosi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418995&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '21d2b52d-c897-4c5f-9ce8-3286c77cec84', 'multiverseId': 418995}, 'multiverseid': 418995}, {'name': '亢進するネズミ', 'text': '亢進するネズミが戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n亢進するネズミが攻撃するたび、あなたは{E}{E}を支払ってもよい。そうしたなら、これの上に＋１/＋１カウンターを１個置く。', 'type': 'クリーチャー — ネズミ', 'flavor': 'ギラプールでは、最も卑しい住民でさえも豪華な環境に住んでいる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419259&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e3c89a0f-716f-492f-a6b2-937f25641eca', 'multiverseId': 419259}, 'multiverseid': 419259}, {'name': '원기왕성한 쥐떼', 'text': '원기왕성한 쥐떼가 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n원기왕성한 쥐떼가 공격할 때마다, 당신은 {E}{E}를 지불할 수 있다. 그렇게 한다면, 원기왕성한 쥐떼에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 쥐', 'flavor': '기라푸르에서는 가장 하찮은 생물도 풍요로운 환경에서 산다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419523&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '123a3fdb-f044-4f00-b513-c01a85b2879a', 'multiverseId': 419523}, 'multiverseid': 419523}, {'name': 'Ratos Vigorosos', 'text': 'Quando Ratos Vigorosos entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Ratos Vigorosos ataca, você pode pagar {E}{E}. Se fizer isso, coloque um marcador +1/+1 nele.', 'type': 'Criatura — Rato', 'flavor': 'Em Ghirapur, mesmo os residentes mais miseráveis vivem em ambientes suntuosos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419787&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa903e77-4659-490b-a8b4-6d11b256d5fd', 'multiverseId': 419787}, 'multiverseid': 419787}, {'name': 'Здоровые Крысы', 'text': 'Когда Здоровые Крысы выходят на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Здоровые Крысы атакуют, вы можете заплатить {E}{E}. Если вы это делаете, положите на них один жетон +1/+1.', 'type': 'Существо — Крыса', 'flavor': 'В Гирапуре даже последние ничтожества живут в окружении роскоши.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420051&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7d0f4b71-f4ac-438e-8fdd-0eb8d75a1071', 'multiverseId': 420051}, 'multiverseid': 420051}, {'name': '强旺鼠', 'text': '当强旺鼠进战场时，你得到{E}{E}（两个能量指示物）。\\n每当强旺鼠攻击时，你可以支付{E}{E}。若你如此作，则在其上放置一个+1/+1指示物。', 'type': '生物～老鼠', 'flavor': '在吉拉波，即使最低等的居民也有奢华的居所。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417939&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '10d95f98-1f4e-4b0f-94c8-5bd5e6ad7321', 'multiverseId': 417939}, 'multiverseid': 417939}, {'name': '強旺鼠', 'text': '當強旺鼠進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當強旺鼠攻擊時，你可以支付{E}{E}。若你如此作，則在其上放置一個+1/+1指示物。', 'type': '生物～老鼠', 'flavor': '在吉拉波，即使最低等的居民也有奢華的居所。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418203&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'df5b90a3-9bba-42e0-9e4f-e2c7b960d847', 'multiverseId': 418203}, 'multiverseid': 418203}]", '[{\'name\': \'Gedeihende Schildkröte\', \'text\': \'Wenn die Gedeihende Schildkröte ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn die Gedeihende Schildkröte angreift, kannst du {E}{E} bezahlen. Falls du dies tust, lege eine +1/+1-Marke auf sie.\', \'type\': \'Kreatur — Schildkröte\', \'flavor\': \'Äther formt auf Kaladesh alles — vom Himmel bis zum Meer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418431&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e11021c9-b12b-4254-a3e6-12284d2f2c28\', \'multiverseId\': 418431}, \'multiverseid\': 418431}, {\'name\': \'Quelonio impetuoso\', \'text\': \'Cuando el Quelonio impetuoso entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que el Quelonio impetuoso ataque, puedes pagar {E}{E}. Si lo haces, pon un contador +1/+1 sobre él.\', \'type\': \'Criatura — Tortuga\', \'flavor\': \'El éter da forma a todo en Kaladesh, desde el cielo hasta el mar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420279&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'63f767bf-621d-4ecc-add3-b67a25881f84\', \'multiverseId\': 420279}, \'multiverseid\': 420279}, {\'name\': \'Tortue prospère\', \'text\': \'Quand la Tortue prospère arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que la Tortue prospère attaque, vous pouvez payer {E}{E}. Si vous faites ainsi, mettez un marqueur +1/+1 sur elle.\', \'type\': \'Créature : tortue terrestre\', \'flavor\': "L\'Éther façonne tout sur Kaladesh, dans les airs comme dans la mer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418695&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d018bc3d-8013-4c80-a5ca-fd4dc7b0b547\', \'multiverseId\': 418695}, \'multiverseid\': 418695}, {\'name\': \'Tartaruga Vigorosa\', \'text\': \'Quando la Tartaruga Vigorosa entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta la Tartaruga Vigorosa attacca, puoi pagare {E}{E}. Se lo fai, metti un segnalino +1/+1 su di essa.\', \'type\': \'Creatura — Tartaruga\', \'flavor\': "L\'etere plasma ogni cosa su Kaladesh, dal cielo fino al mare.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418959&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40a533fb-52e1-481c-88df-c8f080073588\', \'multiverseId\': 418959}, \'multiverseid\': 418959}, {\'name\': \'亢進する亀\', \'text\': \'亢進する亀が戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n亢進する亀が攻撃するたび、あなたは{E}{E}を支払ってもよい。そうしたなら、これの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 海亀\', \'flavor\': \'空から海まで、カラデシュではあらゆるものが霊気の影響下にある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419223&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4435e572-3bd5-49f4-bfeb-6ab04c1edf4c\', \'multiverseId\': 419223}, \'multiverseid\': 419223}, {\'name\': \'원기왕성한 거북이\', \'text\': \'원기왕성한 거북이가 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n원기왕성한 거북이가 공격할 때마다, 당신은 {E}{E}를 지불할 수 있다. 그렇게 한다면, 원기왕성한 거북이에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 거북이\', \'flavor\': \'칼라데시의 하늘과 바다는 모두 에테르로 가득 차 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419487&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'745d1283-6430-4b24-a2c4-45781548bbb0\', \'multiverseId\': 419487}, \'multiverseid\': 419487}, {\'name\': \'Tartaruga Vigorosa\', \'text\': \'Quando Tartaruga Vigorosa entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Tartaruga Vigorosa ataca, você pode pagar {E}{E}. Se fizer isso, coloque um marcador +1/+1 nela.\', \'type\': \'Criatura — Tartaruga\', \'flavor\': \'O éter molda tudo em Kaladesh, do céu ao mar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419751&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a01b591-0107-4eaa-a270-81ffc5ea87d4\', \'multiverseId\': 419751}, \'multiverseid\': 419751}, {\'name\': \'Здоровая Черепаха\', \'text\': \'Когда Здоровая Черепаха выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Здоровая Черепаха атакует, вы можете заплатить {E}{E}. Если вы это делаете, положите на нее один жетон +1/+1.\', \'type\': \'Существо — Черепаха\', \'flavor\': \'Эфир придает форму всему сущему на Каладеше, от небесных высот до глубин океанов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420015&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'56a492a0-0aac-4059-a72f-5a4fa9601340\', \'multiverseId\': 420015}, \'multiverseid\': 420015}, {\'name\': \'强旺龟\', \'text\': \'当强旺龟进战场时，你得到{E}{E}（两个能量指示物）。\\n每当强旺龟攻击时，你可以支付{E}{E}。若你如此作，则在其上放置一个+1/+1指示物。\', \'type\': \'生物～龟\', \'flavor\': \'从天上飞的到海里游的，乙太塑造了卡拉德许的万物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417903&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0ff8696f-4cb1-4737-b7d5-437ec8ebab9d\', \'multiverseId\': 417903}, \'multiverseid\': 417903}, {\'name\': \'強旺龜\', \'text\': \'當強旺龜進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當強旺龜攻擊時，你可以支付{E}{E}。若你如此作，則在其上放置一個+1/+1指示物。\', \'type\': \'生物～龜\', \'flavor\': \'從天上飛的到海裡游的，乙太塑造了卡拉德許的萬物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418167&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'70f34e83-304c-4184-9ee5-ec6356be864a\', \'multiverseId\': 418167}, \'multiverseid\': 418167}]', "[{'name': 'Gedeihender Steinbock', 'text': 'Wenn der Gedeihende Steinbock ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn der Gedeihende Steinbock angreift, kannst du {E}{E} bezahlen. Falls du dies tust, lege eine +1/+1-Marke auf ihn.', 'type': 'Kreatur — Ziege', 'flavor': 'Textilien auf der Erfindermesse enthalten Fäden aus allen Ecken Kaladeshs.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418396&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5cd55889-8ff3-40fe-b9e8-9f00f0ce0a6a', 'multiverseId': 418396}, 'multiverseid': 418396}, {'name': 'Íbice impetuoso', 'text': 'Cuando el Íbice impetuoso entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que el Íbice impetuoso ataque, puedes pagar {E}{E}. Si lo haces, pon un contador +1/+1 sobre él.', 'type': 'Criatura — Cabra', 'flavor': 'Los tejidos expuestos en la Feria de Inventores contienen lana de todos los rincones de Kaladesh.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420244&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2170094e-3d50-4404-8a12-bdfc58abcff8', 'multiverseId': 420244}, 'multiverseid': 420244}, {'name': 'Bouquetin prospère', 'text': 'Quand le Bouquetin prospère arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que le Bouquetin prospère attaque, vous pouvez payer {E}{E}. Si vous faites ainsi, mettez un marqueur +1/+1 sur lui.', 'type': 'Créature : chèvre', 'flavor': 'Les fibres des textiles présentés à la Foire des inventeurs proviennent des quatre coins de Kaladesh.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418660&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b2094a10-cfca-47c0-ac2a-f8b10e98e898', 'multiverseId': 418660}, 'multiverseid': 418660}, {'name': 'Stambecco Vigoroso', 'text': 'Quando lo Stambecco Vigoroso entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta lo Stambecco Vigoroso attacca, puoi pagare {E}{E}. Se lo fai, metti un segnalino +1/+1 su di esso.', 'type': 'Creatura — Capra', 'flavor': 'I tessuti venduti alla Fiera degli Inventori sono ricavati da fibre provenienti da ogni angolo di Kaladesh.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418924&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd3d76fe3-ba38-4e80-b717-5e4768ef2a70', 'multiverseId': 418924}, 'multiverseid': 418924}, {'name': '亢進するアイベックス', 'text': '亢進するアイベックスが戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n亢進するアイベックスが攻撃するたび、あなたは{E}{E}を支払ってもよい。そうしたなら、これの上に＋１/＋１カウンターを１個置く。', 'type': 'クリーチャー — ヤギ', 'flavor': '発明展覧会では、カラデシュ中のありとあらゆる繊維を使った織物を見かける。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419188&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bf949339-faec-4e1d-b4a6-c5a543a822e2', 'multiverseId': 419188}, 'multiverseid': 419188}, {'name': '원기왕성한 염소', 'text': '원기왕성한 염소가 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n원기왕성한 염소가 공격할 때마다, 당신은 {E}{E}를 지불할 수 있다. 그렇게 한다면, 원기왕성한 염소에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 염소', 'flavor': '발명 박람회의 직물은 칼라데시산 원사를 사용한 것이 특징이다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419452&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '35c02c0f-9c9f-41b1-8011-5ac85b0309c1', 'multiverseId': 419452}, 'multiverseid': 419452}, {'name': 'Íbex Vigoroso', 'text': 'Quando Íbex Vigoroso entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Íbex Vigoroso ataca, você pode pagar {E}{E}. Se fizer isso, coloque um marcador +1/+1 nele.', 'type': 'Criatura — Bode', 'flavor': 'A área têxtil da Feira dos Inventores tem fios provenientes de todos os cantos de Kaladesh.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419716&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f1170d11-da82-4d2b-a68d-aaf39b30028a', 'multiverseId': 419716}, 'multiverseid': 419716}, {'name': 'Здоровый Козерог', 'text': 'Когда Здоровый Козерог выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Здоровый Козерог атакует, вы можете заплатить {E}{E}. Если вы это делаете, положите на него один жетон +1/+1.', 'type': 'Существо — Коза', 'flavor': 'В тканях на Ярмарке Изобретателей можно найти нити со всех концов Каладеша.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419980&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4e3e9205-3321-46de-ad5a-f1ace30f10cd', 'multiverseId': 419980}, 'multiverseid': 419980}, {'name': '强旺原羊', 'text': '当强旺原羊进战场时，你得到{E}{E}（两个能量指示物）。\\n每当强旺原羊攻击时，你可以支付{E}{E}。若你如此作，则在其上放置一个+1/+1指示物。', 'type': '生物～山羊', 'flavor': '发明家博览会上的各种织物取材于卡拉德许的各个角落。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417868&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0b5b1a84-cb9d-4c98-95f0-f84286171f48', 'multiverseId': 417868}, 'multiverseid': 417868}, {'name': '強旺原羊', 'text': '當強旺原羊進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當強旺原羊攻擊時，你可以支付{E}{E}。若你如此作，則在其上放置一個+1/+1指示物。', 'type': '生物～山羊', 'flavor': '發明家博覽會上的各種織物取材於卡拉德許的各個角落。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418132&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ce55c104-9055-4be7-ad4d-410bc834f028', 'multiverseId': 418132}, 'multiverseid': 418132}]", '[{\'name\': \'Gedeihendes Nashorn\', \'text\': \'Wenn das Gedeihende Nashorn ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn das Gedeihende Nashorn angreift, kannst du {E}{E} bezahlen. Falls du dies tust, lege eine +1/+1-Marke darauf.\', \'type\': \'Kreatur — Nashorn\', \'flavor\': \'So unberechenbar wie der Äther und genauso schwierig zu kontrollieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418536&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2dccadde-8bd2-4244-8f32-04e2e013acc7\', \'multiverseId\': 418536}, \'multiverseid\': 418536}, {\'name\': \'Rinoceronte impetuoso\', \'text\': \'Cuando el Rinoceronte impetuoso entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que el Rinoceronte impetuoso ataque, puedes pagar {E}{E}. Si lo haces, pon un contador +1/+1 sobre él.\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'Tan impredecible como el éter e igual de difícil de contener.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420384&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'48df5956-6e18-4e16-9add-8846ee74bc76\', \'multiverseId\': 420384}, \'multiverseid\': 420384}, {\'name\': \'Rhinocéros prospère\', \'text\': \'Quand le Rhinocéros prospère arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que le Rhinocéros prospère attaque, vous pouvez payer {E}{E}. Si vous faites ainsi, mettez un marqueur +1/+1 sur lui.\', \'type\': \'Créature : rhinocéros\', \'flavor\': "Aussi imprévisible que l\'Éther, et tout aussi difficile à maîtriser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418800&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0b1c2b0-e97e-4709-a87d-d5ccc856677d\', \'multiverseId\': 418800}, \'multiverseid\': 418800}, {\'name\': \'Rinoceronte Vigoroso\', \'text\': \'Quando il Rinoceronte Vigoroso entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta il Rinoceronte Vigoroso attacca, puoi pagare {E}{E}. Se lo fai, metti un segnalino +1/+1 su di esso.\', \'type\': \'Creatura — Rinoceronte\', \'flavor\': "Imprevedibile come l\'etere e altrettanto difficile da imbrigliare.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419064&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'663a6aa0-efe1-4de3-92b3-aaaed1f68aa7\', \'multiverseId\': 419064}, \'multiverseid\': 419064}, {\'name\': \'亢進するサイ\', \'text\': \'亢進するサイが戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n亢進するサイが攻撃するたび、あなたは{E}{E}を支払ってもよい。そうしたなら、これの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — サイ\', \'flavor\': \'気紛れなのは霊気と同様。閉じ込めるのが難しいのも同様。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419328&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8dad3de7-da97-4a0d-b541-6f48aecb5890\', \'multiverseId\': 419328}, \'multiverseid\': 419328}, {\'name\': \'원기왕성한 코뿔소\', \'text\': \'원기왕성한 코뿔소가 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n원기왕성한 코뿔소가 공격할 때마다, 당신은 {E}{E}를 지불할 수 있다. 그렇게 한다면, 원기왕성한 코뿔소에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 코뿔소\', \'flavor\': \'에테르만큼 예측하기 어렵고 잡아두기 힘들다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419592&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'93d238dc-b01c-4647-9104-55f277b38f5f\', \'multiverseId\': 419592}, \'multiverseid\': 419592}, {\'name\': \'Rinoceronte Vigoroso\', \'text\': \'Quando Rinoceronte Vigoroso entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Rinoceronte Vigoroso ataca, você pode pagar {E}{E}. Se fizer isso, coloque um marcador +1/+1 nele.\', \'type\': \'Criatura — Rinoceronte\', \'flavor\': \'Imprevisível como o éter e igualmente difícil de conter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e1701a3-2731-49d5-92f3-422e6dae32ab\', \'multiverseId\': 419856}, \'multiverseid\': 419856}, {\'name\': \'Здоровый Носорог\', \'text\': \'Когда Здоровый Носорог выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Здоровый Носорог атакует, вы можете заплатить {E}{E}. Если вы это делаете, положите на него один жетон +1/+1.\', \'type\': \'Существо — Носорог\', \'flavor\': \'Непредсказуем, как эфир, и такой же неудержимый.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420120&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c9ea3256-247b-4f5b-a999-1622a2215cbf\', \'multiverseId\': 420120}, \'multiverseid\': 420120}, {\'name\': \'强旺犀牛\', \'text\': \'当强旺犀牛进战场时，你得到{E}{E}（两个能量指示物）。\\n每当强旺犀牛攻击时，你可以支付{E}{E}。若你如此作，则在其上放置一个+1/+1指示物。\', \'type\': \'生物～犀牛\', \'flavor\': \'如乙太一般捉摸不透，也同样难以束缚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418008&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f20a6cea-ddf2-47e1-a0cb-d1e3f056a8ff\', \'multiverseId\': 418008}, \'multiverseid\': 418008}, {\'name\': \'強旺犀牛\', \'text\': \'當強旺犀牛進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當強旺犀牛攻擊時，你可以支付{E}{E}。若你如此作，則在其上放置一個+1/+1指示物。\', \'type\': \'生物～犀牛\', \'flavor\': \'如乙太一般捉摸不透，也同樣難以束縛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418272&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a2b233c0-a79e-4843-9708-299204d1507a\', \'multiverseId\': 418272}, \'multiverseid\': 418272}]', '[{\'name\': \'Geifernde Gremlins\', \'text\': \'Immer wenn ein Artefakt unter deiner Kontrolle ins Spiel kommt, erhalten die Geifernden Gremlins +2/+0 und verursachen Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Gremlin\', \'flavor\': \'Was der Elf träumt, baut der Zwerg — und der Gremlin frisst es.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418494&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5ef98cfd-d378-4dbc-8931-190c8070bf39\', \'multiverseId\': 418494}, \'multiverseid\': 418494}, {\'name\': \'Gremlins salivantes\', \'text\': \'Siempre que un artefacto entre al campo de batalla bajo tu control, los Gremlins salivantes obtienen +2/+0 y ganan la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Gremlin\', \'flavor\': \'Si un elfo puede concebirlo, un enano puede construirlo y un gremlin puede comérselo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420342&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fde1f042-9a61-44b5-a1ab-32c61d5b3c9a\', \'multiverseId\': 420342}, \'multiverseid\': 420342}, {\'name\': \'Gremlins salivants\', \'text\': "À chaque fois qu\'un artefact arrive sur le champ de bataille sous votre contrôle, les Gremlins salivants gagnent +2/+0 et acquièrent le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : gremlin\', \'flavor\': \'Si un elfe peut en rêver, un nain peut le construire et un gremlin peut le manger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418758&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4e60894-3611-4e58-abdf-1df520f6ccf0\', \'multiverseId\': 418758}, \'multiverseid\': 418758}, {\'name\': \'Gremlin Sbavanti\', \'text\': \'Ogniqualvolta un artefatto entra nel campo di battaglia sotto il tuo controllo, i Gremlin Sbavanti prendono +2/+0 e hanno travolgere fino alla fine del turno.\', \'type\': \'Creatura — Gremlin\', \'flavor\': \'Se un elfo riesce a immaginarlo, un nano saprà costruirlo e un gremlin divorarlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419022&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c00ec2a7-4d10-4a6f-9e50-181d6230074d\', \'multiverseId\': 419022}, \'multiverseid\': 419022}, {\'name\': \'垂涎グレムリン\', \'text\': \'アーティファクトが１つあなたのコントロール下で戦場に出るたび、ターン終了時まで、垂涎グレムリンは＋２/＋０の修整を受けるとともにトランプルを得る。\', \'type\': \'クリーチャー — グレムリン\', \'flavor\': \'エルフが構想し、ドワーフが建設し、グレムリンが食べてしまう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419286&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35757c48-e6d1-45e3-a829-b7f7dc740beb\', \'multiverseId\': 419286}, \'multiverseid\': 419286}, {\'name\': \'군침 흘리는 그렘린들\', \'text\': \'마법물체가 당신의 조종하에 전장에 들어올 때마다, 군침 흘리는 그렘린들은 +2/+0을 받고 턴종료까지 돌진을 얻는다.\', \'type\': \'생물 — 그렘린\', \'flavor\': \'엘프가 꿈을 꾸면, 드워프는 그 꿈을 만들 수 있고, 그렘린은 그 꿈을 먹어치울 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419550&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'53008bee-d4d0-4d9c-892c-e1dcb6ac7791\', \'multiverseId\': 419550}, \'multiverseid\': 419550}, {\'name\': \'Gremlins Salivantes\', \'text\': \'Toda vez que um artefato entra no campo de batalha sob seu controle, Gremlins Salivantes recebe +2/+0 e ganha atropelar até o final do turno.\', \'type\': \'Criatura — Gremlin\', \'flavor\': \'Se um elfo pode sonhar com alguma coisa, um anão pode construí-la e um gremlin pode comê-la.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419814&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0efacf7e-021c-4b7a-b88b-26b7196666c4\', \'multiverseId\': 419814}, \'multiverseid\': 419814}, {\'name\': \'Исходящие Слюной Гремлины\', \'text\': \'Каждый раз, когда артефакт выходит на поле битвы под вашим контролем, Исходящие Слюной Гремлины получают +2/+0 и Пробивной удар до конца хода.\', \'type\': \'Существо — Гремлин\', \'flavor\': \'Если эльф может это придумать, то гном может это построить, а гремлин — сожрать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420078&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'89e30de7-3a2f-44ca-81a8-91e2bdaaeaab\', \'multiverseId\': 420078}, \'multiverseid\': 420078}, {\'name\': \'垂涎怪灵\', \'text\': \'每当一个神器在你的操控下进战场时，直到回合结束，垂涎怪灵得+2/+0且获得践踏异能。\', \'type\': \'生物～怪灵\', \'flavor\': \'如果妖精能构想它，矮人就能建造它，怪灵就能吃掉它。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417966&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e9ad9e6-558c-4d26-a206-052e46785fbe\', \'multiverseId\': 417966}, \'multiverseid\': 417966}, {\'name\': \'垂涎怪靈\', \'text\': \'每當一個神器在你的操控下進戰場時，直到回合結束，垂涎怪靈得+2/+0且獲得踐踏異能。\', \'type\': \'生物～怪靈\', \'flavor\': \'如果妖精能構想它，矮人就能建造它，怪靈就能吃掉它。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418230&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'95ca4333-3811-4cfa-a096-e143df3ce068\', \'multiverseId\': 418230}, \'multiverseid\': 418230}]', '[{\'name\': \'Geländeelementar\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Du trittst das Land tagtäglich mit Füßen und doch scheinst du bestürzt, wenn es zurücktritt." —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420515&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47181d4c-e305-4374-a25a-99c06dd2ff95\', \'multiverseId\': 420515}, \'multiverseid\': 420515}, {\'name\': \'Elemental terrenal\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Aunque llevas toda tu vida pisando la tierra, parece que te horrorizas cuando ella se mueve para pisarte a ti". —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420585&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'49ff7828-5cc7-4e66-bac9-c9e3dcc9931f\', \'multiverseId\': 420585}, \'multiverseid\': 420585}, {\'name\': \'Élémental de terrain\', \'type\': \'Créature : élémental\', \'flavor\': \'« Vous foulez la terre de vos pieds en permanence, mais vous semblez catastrophé quand elle se déplace pour vous écraser. » —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420525&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46fe43bc-3abb-42b1-920d-328e3b4d685d\', \'multiverseId\': 420525}, \'multiverseid\': 420525}, {\'name\': \'Elementale del Terreno\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Calpestate la terra ogni giorno, eppure rimanete sgomenti quando è lei a muoversi per calpestare voi." —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420535&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d330834-2851-454b-bf1e-29b266e3809c\', \'multiverseId\': 420535}, \'multiverseid\': 420535}, {\'name\': \'地形の精霊\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「人々は常に土地を踏みにじっているのに、反対にそれが人々を踏み潰すために動き出すと動揺を隠せないようですね。」 ――ニッサ・レヴェイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420545&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79646bc7-b935-4dea-ae78-72a35d22ed74\', \'multiverseId\': 420545}, \'multiverseid\': 420545}, {\'name\': \'대지의 정령\', \'type\': \'생물 — 정령\', \'flavor\': \'"늘 밟고 다니던 대지가 당신을 밟으려고 움직이는 모습을 본다면 그야말로 경악할 것이다." —니사 레베인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420555&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'48b42793-561a-4229-9e49-8a0c14de9d1d\', \'multiverseId\': 420555}, \'multiverseid\': 420555}, {\'name\': \'Elemental Terrenho\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Vocês caminham sobre a terra todo o tempo, mas se surpreendem quando é ela quem caminha sobre vocês." — Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420565&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db7b687d-5eb3-4416-b8cb-63791965cecb\', \'multiverseId\': 420565}, \'multiverseid\': 420565}, {\'name\': \'Элементаль Почвы\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Ты все время ступаешь по земле, так почему же возмущаешься, когда она пытается наступить на тебя?» — Нисса Ревейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420575&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'db81b1be-2782-4d1e-8a3b-a1f137c3d325\', \'multiverseId\': 420575}, \'multiverseid\': 420575}, {\'name\': \'地势元素\', \'type\': \'生物～元素\', \'flavor\': \'「你一向把大地踩在脚下，现在轮到你被踩在脚下，你倒大惊小怪起来了。」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420495&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cc57b27-5e86-4a45-b819-d5fae6267321\', \'multiverseId\': 420495}, \'multiverseid\': 420495}, {\'name\': \'地勢元素\', \'type\': \'生物～元素\', \'flavor\': \'「你一向把大地踩在腳下，現在輪到你被踩在腳下，你倒大驚小怪起來了。」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420505&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'78cd11d0-391b-42c4-a4fc-5cf862b5069c\', \'multiverseId\': 420505}, \'multiverseid\': 420505}]', '[{\'name\': \'Generalüberholen\', \'text\': \'Bringe eine Artefaktkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Wieso willst du das neu kaufen, wenn ich das Werkzeug habe, um es zu reparieren?" —Ripu, Reparateur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418390&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6d74658-35e8-46b6-a922-c094e7b0544c\', \'multiverseId\': 418390}, \'multiverseid\': 418390}, {\'name\': \'Reconstituir\', \'text\': \'Regresa la carta de artefacto objetivo de tu cementerio al campo de batalla.\', \'type\': \'Conjuro\', \'flavor\': \'"No hay razón para comprar uno nuevo si se puede reparar el anterior". —Ripu, especialista en reparaciones\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d771f3b9-5119-4416-99cf-22257b72c974\', \'multiverseId\': 420238}, \'multiverseid\': 420238}, {\'name\': \'Rénovation\', \'text\': "Renvoyez sur le champ de bataille une carte d\'artefact ciblée depuis votre cimetière.", \'type\': \'Rituel\', \'flavor\': "« Il n\'y a aucune raison pour vous d\'acheter du neuf si j\'ai de quoi réparer l\'ancien. » —Ripuù, spécialiste en réparations", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418654&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'540f16d3-0539-497c-856b-fc4dc9c16dde\', \'multiverseId\': 418654}, \'multiverseid\': 418654}, {\'name\': \'Restaurare\', \'text\': \'Rimetti sul campo di battaglia una carta artefatto bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Perché comprarne uno nuovo se ho gli strumenti per sistemare quello che hai già?" —Ripu, specialista in riparazioni\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418918&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b09bd40-b918-4bbf-968a-dec4a56fb6c6\', \'multiverseId\': 418918}, \'multiverseid\': 418918}, {\'name\': \'復元\', \'text\': \'あなたの墓地からアーティファクト・カード１枚を対象とし、それを戦場に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「今ある物を直せるうちに、新品を買うことはありませんよ。」 ――修理専門家、リプー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419182&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7309e5ce-cba8-4e7d-86ed-b20e31289ec3\', \'multiverseId\': 419182}, \'multiverseid\': 419182}, {\'name\': \'새단장\', \'text\': \'당신의 무덤에 있는 마법물체 카드를 목표로 정한다. 그 카드를 전장으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"제 손에 고장난 기계를 고칠 도구만 있다면 당신은 새로 장만할 필요가 없습니다." —수리 전문가 리푸\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419446&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'433a1fa7-6257-4a43-92c4-e9acc6d1703c\', \'multiverseId\': 419446}, \'multiverseid\': 419446}, {\'name\': \'Redecorar\', \'text\': \'Devolva o card de artefato alvo de seu cemitério para o campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': \'"Não há razão para comprar um novo quando eu tenho as ferramentas para consertar o que você tem." — Ripu, especialista em reparos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419710&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0540ffb7-198c-4f63-816d-af0bc2929cd1\', \'multiverseId\': 419710}, \'multiverseid\': 419710}, {\'name\': \'Подновить\', \'text\': \'Верните целевую карту артефакта из вашего кладбища на поле битвы.\', \'type\': \'Волшебство\', \'flavor\': \'«Зачем тебе покупать новый, когда у меня есть инструменты, чтобы починить твой?» — Рипу, специалист-ремонтник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419974&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e65a78b0-e4a8-41c9-9daf-f6e63cb07674\', \'multiverseId\': 419974}, \'multiverseid\': 419974}, {\'name\': \'整修\', \'text\': \'将目标神器牌从你的坟墓场移回战场。\', \'type\': \'法术\', \'flavor\': \'「我手头有修理你这东西的工具，没必要去买新的。」 ～修理能手丽普\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417862&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d618ef34-876f-4fbe-beb7-d023d18930a0\', \'multiverseId\': 417862}, \'multiverseid\': 417862}, {\'name\': \'整修\', \'text\': \'將目標神器牌從你的墳墓場移回戰場。\', \'type\': \'巫術\', \'flavor\': \'「我手頭有修理你這東西的工具，沒必要去買新的。」 ～修理能手麗普\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418126&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9eb81508-c99a-4a41-8331-6e85b7922268\', \'multiverseId\': 418126}, \'multiverseid\': 418126}]', '[{\'name\': \'Geschickte Bastlerin\', \'text\': \'Wenn die Geschickte Bastlerin ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Kreatur — Vedalken, Handwerker\', \'flavor\': \'„Ein Fehler ist nur eine weitere Gelegenheit, sich zu verbessern. Warte nur, was ich mir als Nächstes ausdenke."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418423&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4db42574-085a-4c86-b46c-b60d3696c830\', \'multiverseId\': 418423}, \'multiverseid\': 418423}, {\'name\': \'Inventora capaz\', \'text\': \'Cuando la Inventora capaz entre al campo de batalla, roba una carta.\', \'type\': \'Criatura — Artífice vedalken\', \'flavor\': \'"Un error no es más que otra oportunidad de hacerlo mejor. Espera y verás lo que se me ocurre después de esto".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420271&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6318ec3b-921f-49a9-9f0c-cea501d50447\', \'multiverseId\': 420271}, \'multiverseid\': 420271}, {\'name\': \'Innovatrice agile\', \'text\': "Quand l\'Innovatrice agile arrive sur le champ de bataille, piochez une carte.", \'type\': \'Créature : vedalken et artificier\', \'flavor\': "« L\'échec n\'est qu\'une nouvelle possibilité d\'amélioration. Attendez de voir la suite. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'479a7fb9-661b-40cf-aba1-3afcc54810d8\', \'multiverseId\': 418687}, \'multiverseid\': 418687}, {\'name\': \'Abile Innovatrice\', \'text\': "Quando l\'Abile Innovatrice entra nel campo di battaglia, pesca una carta.", \'type\': \'Creatura — Artefice Vedalken\', \'flavor\': \'"Un fallimento rappresenta solo una nuova opportunità per migliorare. Aspetta di vedere la mia prossima invenzione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418951&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2202711e-11ae-4483-9cd5-c956f9711c2a\', \'multiverseId\': 418951}, \'multiverseid\': 418951}, {\'name\': \'敏捷な革新者\', \'text\': \'敏捷な革新者が戦場に出たとき、カードを１枚引く。\', \'type\': \'クリーチャー — ヴィダルケン・工匠\', \'flavor\': \'「失敗は改良のチャンスです。私が次回出す物を楽しみにしていてください。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419215&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'076754ad-3155-4d98-9da7-0f16856a0681\', \'multiverseId\': 419215}, \'multiverseid\': 419215}, {\'name\': \'재빠른 혁신가\', \'text\': \'재빠른 혁신가가 전장에 들어올 때, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 베달켄 기능공\', \'flavor\': \'"실패는 발전을 위한 또 다른 기회일 뿐입니다. 제 다음 발명품을 기대해 주십시오."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419479&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c7ab347b-c3b1-43a2-93c5-13a45440ada0\', \'multiverseId\': 419479}, \'multiverseid\': 419479}, {\'name\': \'Inovadora Ágil\', \'text\': \'Quando Inovadora Ágil entrar no campo de batalha, compre um card.\', \'type\': \'Criatura — Vedalkeano Artesão\', \'flavor\': \'"Um fracasso é simplesmente outra oportunidade de se aperfeiçoar. Espere para ver o que eu vou inventar agora."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419743&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c0b4b4e-085f-472a-b63d-cbb2825a0f51\', \'multiverseId\': 419743}, \'multiverseid\': 419743}, {\'name\': \'Находчивая Изобретательница\', \'text\': \'Когда Находчивая Изобретательница выходит на поле битвы, возьмите карту.\', \'type\': \'Существо — Ведалкен Механик\', \'flavor\': \'«Неудача — лишь новая возможность для улучшения. Вот увидите, что у меня получится в следующий раз!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420007&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4413889a-720e-48c5-b738-5b139025a9ce\', \'multiverseId\': 420007}, \'multiverseid\': 420007}, {\'name\': \'巧手发明家\', \'text\': \'当巧手发明家进战场时，抓一张牌。\', \'type\': \'生物～维多肯／神器师\', \'flavor\': \'「失败只是改进的机会。等着瞧我的下一件作品吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e9e4170-750b-4e04-a8e3-8e07987e833b\', \'multiverseId\': 417895}, \'multiverseid\': 417895}, {\'name\': \'巧手發明家\', \'text\': \'當巧手發明家進戰場時，抽一張牌。\', \'type\': \'生物～維多肯／神器師\', \'flavor\': \'「失敗只是改進的機會。等著瞧我的下一件作品吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418159&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e9383f3c-ec82-4d6a-8efd-dfff4e8d1ff9\', \'multiverseId\': 418159}, \'multiverseid\': 418159}]', '[{\'name\': \'Gesetzloser Zwischenhändler\', \'text\': \'Wenn der Gesetzlose Zwischenhändler stirbt, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Äthergeborener, Räuber\', \'flavor\': \'Kaladeshs illegaler Handel findet auf den sogenannten „Nachtmärkten" statt, aber wenn du weißt, wen du fragen musst, findest du alles rund um die Uhr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418451&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26482605-0b20-4e8d-9ac3-4e3a29661d62\', \'multiverseId\': 418451}, \'multiverseid\': 418451}, {\'name\': \'Comerciante clandestino\', \'text\': \'Cuando el Comerciante clandestino muera, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Bribón etergénito\', \'flavor\': \'Los mercados ilegales de Kaladesh se llaman "mercados nocturnos", pero si sabes a quién preguntar, puedes encontrar lo que buscas en cualquier momento del día.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420299&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'413d6047-6bb7-4e53-8c7c-27781e3e16e4\', \'multiverseId\': 420299}, \'multiverseid\': 420299}, {\'name\': \'Courtier sans foi ni loi\', \'text\': \'Quand le Courtier sans foi ni loi meurt, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.\', \'type\': \'Créature : éthérien et gredin\', \'flavor\': "On appelle les marchés clandestins de Kaladesh les « marchés nocturnes », mais si vous connaissez les bonnes personnes, vous pourrez trouver ce que vous cherchez à n\'importe quelle heure du jour.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418715&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22ef5d3d-dda8-4733-a034-bfef0ee04b95\', \'multiverseId\': 418715}, \'multiverseid\': 418715}, {\'name\': \'Intermediario Fuorilegge\', \'text\': "Quando l\'Intermediario Fuorilegge muore, metti un segnalino +1/+1 su una creatura bersaglio che controlli.", \'type\': \'Creatura — Farabutto Eteride\', \'flavor\': \'I ritrovi di trafficanti illeciti di Kaladesh sono noti come "mercati notturni", ma se chiedi alla persona giusta, puoi trovare quello che cerchi a ogni ora del giorno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418979&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84481206-788a-4b2e-8c22-2da97f1896be\', \'multiverseId\': 418979}, \'multiverseid\': 418979}, {\'name\': \'不法仲買人\', \'text\': \'不法仲買人が死亡したとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 霊基体・ならず者\', \'flavor\': \'カラデシュでは違法な売買の場は「夜市」と呼ばれている。だが声を掛ける相手さえわかっていれば、いつでも欲しい物が手に入るのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419243&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b75b4cb-baf4-490f-9cde-62ad4778c817\', \'multiverseId\': 419243}, \'multiverseid\': 419243}, {\'name\': \'무법 중개인\', \'text\': \'무법 중개인이 죽을 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 에테르붙이 도적\', \'flavor\': \'칼라데시의 불법 시장은 "야시장"으로 알려져 있지만, 물어볼 대상을 정확히 알고 있다면 낮에도 원하는 것을 찾을 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419507&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c02971f-2b48-4b49-80c7-fccc757e14d5\', \'multiverseId\': 419507}, \'multiverseid\': 419507}, {\'name\': \'Negociante Fora-da-lei\', \'text\': \'Quando Negociante Fora-da-lei morrer, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Criatura — Etergênito Ladino\', \'flavor\': \'Os mercados ilícitos de Kaladesh são conhecidos como "mercados noturnos", mas, se souber a quem perguntar, você pode encontrar o que procura a qualquer hora do dia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419771&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7206d032-fc95-4b49-929d-45575e781175\', \'multiverseId\': 419771}, \'multiverseid\': 419771}, {\'name\': \'Посредник Вне Закона\', \'text\': \'Когда Посредник Вне Закона умирает, положите один жетон +1/+1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Эфирид Бродяга\', \'flavor\': \'Незаконные рынки Каладеша называют «ночными», но если знать, кого спрашивать, то что угодно можно найти в любое время дня.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420035&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'38b8d9be-a7e4-43ec-8e00-e010c95f5a58\', \'multiverseId\': 420035}, \'multiverseid\': 420035}, {\'name\': \'不法掮客\', \'text\': \'当不法掮客死去时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'生物～乙太种／浪客\', \'flavor\': \'卡拉德许的黑市又称为「晚市」，但只要你问对人，就会发现你想要之物随时可得。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417923&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c712bc8d-065a-46a8-9b9f-e3e08c9eeba5\', \'multiverseId\': 417923}, \'multiverseid\': 417923}, {\'name\': \'不法掮客\', \'text\': \'當不法掮客死去時，在目標由你操控的生物上放置一個+1/+1指示物。\', \'type\': \'生物～乙太種／浪客\', \'flavor\': \'卡拉德許的黑市又稱為「晚市」，但只要你問對人，就會發現你想要之物隨時可得。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418187&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c44ec535-92c0-4e36-b3f3-ed3369ea1c0f\', \'multiverseId\': 418187}, \'multiverseid\': 418187}]', '[{\'name\': \'Gesundheitsgefährdende Umstände\', \'text\': \'Kreaturen ohne Marken erhalten -2/-2 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'„Es gibt viele Gründe, warum wir erfinden, und das Überleben ist kein unwichtiger."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418547&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd20115b-e3a2-4f8e-be99-0b715703f390\', \'multiverseId\': 418547}, \'multiverseid\': 418547}, {\'name\': \'Condiciones arriesgadas\', \'text\': \'Las criaturas que no tengan ningún contador sobre ellas obtienen -2/-2 hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'"Hay muchas razones por las que inventamos cosas y, entre ellas, la supervivencia no ocupa un lugar menor".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420395&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db531d32-ecc2-470a-bda8-19fe8570ae18\', \'multiverseId\': 420395}, \'multiverseid\': 420395}, {\'name\': \'Conditions dangereuses\', \'text\': "Les créatures sans marqueur sur elles gagnent -2/-2 jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': "« Nous avons de nombreuses raisons d\'inventer, et la survie est l\'une des principales. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418811&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'daee4a60-ecc4-4e22-87b9-d2f5a46fd91e\', \'multiverseId\': 418811}, \'multiverseid\': 418811}, {\'name\': \'Condizioni Pericolose\', \'text\': \'Le creature senza segnalini prendono -2/-2 fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Molte sono le ragioni che ci spingono a inventare, non ultima la sopravvivenza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419075&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f6da907-cf39-4a0f-be50-6ee4dbb45fbe\', \'multiverseId\': 419075}, \'multiverseid\': 419075}, {\'name\': \'危険な状況\', \'text\': \'ターン終了時まで、カウンターが置かれていないクリーチャーは－２/－２の修整を受ける。\', \'type\': \'ソーサリー\', \'flavor\': \'「発明の動機は様々だが、生き残るためというものもめずらしくない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419339&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4140d68-738d-4f35-be9b-d68117eeb9ad\', \'multiverseId\': 419339}, \'multiverseid\': 419339}, {\'name\': \'위험한 조건\', \'text\': \'카운터를 가지지 않은 생물들은 턴종료까지 -2/-2를 받는다.\', \'type\': \'집중마법\', \'flavor\': \'"생존은 우리가 발명을 하는 이유 중 꽤 중요한 이유의 하나이다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419603&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'26b3558d-facf-4ac9-a4b6-dfb4e16dd8db\', \'multiverseId\': 419603}, \'multiverseid\': 419603}, {\'name\': \'Condições Arriscadas\', \'text\': \'As criaturas sem nenhum marcador recebem -2/-2 até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'"Há muitas razões pelas quais inventamos, e entre elas a sobrevivência não é insignificante."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419867&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab1b5d0b-334c-4f9f-b8d8-c29b287346ca\', \'multiverseId\': 419867}, \'multiverseid\': 419867}, {\'name\': \'Опасные Условия\', \'text\': \'Существа, на которых нет жетонов, получают -2/-2 до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'«Есть много причин, по которым мы занимаемся изобретениями, и выживание — не последняя из них».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420131&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed58f9ed-b851-4492-954d-74508acf456a\', \'multiverseId\': 420131}, \'multiverseid\': 420131}, {\'name\': \'有害情况\', \'text\': \'其上没有指示物的生物得-2/-2直到回合结束。\', \'type\': \'法术\', \'flavor\': \'「我们有种种发明的理由，其中就包括了求取生存。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418019&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83d10b8b-9f9d-4945-9cef-7693d4c11542\', \'multiverseId\': 418019}, \'multiverseid\': 418019}, {\'name\': \'有害情況\', \'text\': \'其上沒有指示物的生物得-2/-2直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'「我們有種種發明的理由，其中就包括了求取生存。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418283&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7f2b961f-0aec-493f-bbb5-8a9e570b8442\', \'multiverseId\': 418283}, \'multiverseid\': 418283}]', "[{'name': 'Ghirapur-Führer', 'text': '{2}{G}: Eine Kreatur deiner Wahl, die du kontrollierst, kann in diesem Zug von Kreaturen mit Stärke 2 oder weniger nicht geblockt werden.', 'type': 'Kreatur — Elf, Späher', 'flavor': 'Messebesucher waren hocherfreut, dass Ghirapur auch außerhalb des Messegeländes Wunder zu bieten hatte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418521&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9e984621-1578-4f87-89f2-9848dd259ea3', 'multiverseId': 418521}, 'multiverseid': 418521}, {'name': 'Guía de Ghirapur', 'text': '{2}{G}: La criatura objetivo que controlas no puede ser bloqueada por criaturas con fuerza de 2 o menos este turno.', 'type': 'Criatura — Explorador elfo', 'flavor': 'A los visitantes de la feria les gustó descubrir que, incluso fuera de sus terrenos, Ghirapur era una ciudad llena de maravillas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420369&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '30a63ed7-4b19-4b8f-bee4-b8acd9537ed6', 'multiverseId': 420369}, 'multiverseid': 420369}, {'name': 'Guide de Ghirapur', 'text': '{2}{G} : Une créature ciblée que vous contrôlez ne peut pas être bloquée par des créatures de force inférieure ou égale à 2 ce tour-ci.', 'type': 'Créature : elfe et éclaireur', 'flavor': 'Les visiteurs furent ravis de découvrir que même en dehors du champ de foire, Ghirapur était une cité merveilleuse.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418785&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e66f5a39-5947-42ec-81ea-176555996b34', 'multiverseId': 418785}, 'multiverseid': 418785}, {'name': 'Guida di Ghirapur', 'text': '{2}{G}: Una creatura bersaglio che controlli non può essere bloccata da creature con forza pari o inferiore a 2 in questo turno.', 'type': 'Creatura — Esploratore Elfo', 'flavor': 'I visitatori furono lieti di scoprire che le meraviglie di Ghirapur non erano confinate tra i banchi della fiera.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419049&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f864bed7-464a-4854-9877-217fe8b51315', 'multiverseId': 419049}, 'multiverseid': 419049}, {'name': 'ギラプールの案内人', 'text': '{2}{G}：あなたがコントロールするクリーチャー１体を対象とする。このターン、それはパワーが２以下のクリーチャーによってはブロックされない。', 'type': 'クリーチャー — エルフ・スカウト', 'flavor': '博覧会を訪れる人々は、会場外も含めてギラプール全体に満ち溢れる驚きを満喫した。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419313&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd8f0036c-48eb-469f-87a0-664b039a24e8', 'multiverseId': 419313}, 'multiverseid': 419313}, {'name': '기라푸르 안내원', 'text': '{2}{G}: 당신이 조종하는 생물을 목표로 정한다. 그 생물은 이 턴에 공격력이 2 이하인 생물에게 방어될 수 없다.', 'type': '생물 — 엘프 정찰병', 'flavor': '박람회 참가자들은 박람회장 밖에서도 기라푸르가 경이로운 도시라는 사실에 경탄했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419577&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '13aae66c-4575-4f59-9a93-5d97c9c2d703', 'multiverseId': 419577}, 'multiverseid': 419577}, {'name': 'Guia de Ghirapur', 'text': '{2}{G}: A criatura alvo que você controla não pode ser boqueada neste turno por criaturas com poder igual ou inferior a 2.', 'type': 'Criatura — Elfo Batedor', 'flavor': 'Os visitantes da Feira se encantaram ao descobrir que mesmo fora da feira Ghirapur era uma cidade de maravilhas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419841&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd7f44e5d-4a5f-40f7-8501-c56e154ea42b', 'multiverseId': 419841}, 'multiverseid': 419841}, {'name': 'Гирапурский Проводник', 'text': '{2}{G}: целевое существо под вашим контролем не может быть заблокировано существами с силой 2 или меньше в этом ходу.', 'type': 'Существо — Эльф Разведчик', 'flavor': 'Приехавшие на Ярмарку с удовольствием обнаружили, что и за пределами ярмарочной площадки Гирапур был настоящим городом чудес.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420105&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2fd93eb5-50e5-427a-9756-c11356cc92cd', 'multiverseId': 420105}, 'multiverseid': 420105}, {'name': '吉拉波向导', 'text': '{2}{G}：目标由你操控的生物本回合不能被力量等于或小于2的生物阻挡。', 'type': '生物～妖精／斥候', 'flavor': '观展的人们惊喜地发现，即便是出了展区，吉拉波这座城市也处处充满神奇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417993&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '50c0fe42-9e5b-4e0c-bb73-fab216617f02', 'multiverseId': 417993}, 'multiverseid': 417993}, {'name': '吉拉波嚮導', 'text': '{2}{G}：目標由你操控的生物本回合不能被力量等於或小於2的生物阻擋。', 'type': '生物～妖精／斥候', 'flavor': '觀展的人們驚喜地發現，即便是出了展區，吉拉波這座城市也處處充滿神奇。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418257&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a0951a7d-99d8-4d4a-aaf6-cb5380b3cb33', 'multiverseId': 418257}, 'multiverseid': 418257}]", '[{\'name\': \'Ghirapur-Orrery\', \'text\': \'Jeder Spieler darf in jedem seiner Züge ein zusätzliches Land spielen.\\nZu Beginn des Versorgungssegments jedes Spielers und falls jener Spieler keine Karten auf der Hand hat, zieht er drei Karten.\', \'type\': \'Artefakt\', \'flavor\': \'Dieses detaillierte Modell ermöglicht es den Konstrukteuren, die Stadt von jedem Winkel aus zu betrachten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7eb0d48c-8ed2-4aa5-aae5-37a8901337d6\', \'multiverseId\': 418581}, \'multiverseid\': 418581}, {\'name\': \'Planetario de Ghirapur\', \'text\': \'Cada jugador puede jugar una tierra adicional durante cada uno de sus turnos.\\nAl comienzo del mantenimiento de cada jugador, si ese jugador no tiene cartas en su mano, ese jugador roba tres cartas.\', \'type\': \'Artefacto\', \'flavor\': \'Este modelo detallado permite que los edificadores examinen la ciudad desde todos los ángulos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9233509f-f4b4-4a44-a0c9-7da0135d6b6a\', \'multiverseId\': 420429}, \'multiverseid\': 420429}, {\'name\': \'Planétaire mécanique de Ghirapur\', \'text\': "Chaque joueur peut jouer un terrain supplémentaire pendant chacun de ses tours.\\nAu début de l\'entretien de chaque joueur, si ce joueur n\'a aucune carte en main, ce joueur pioche trois cartes.", \'type\': \'Artefact\', \'flavor\': "Ce modèle réduit détaillé permet aux édificateurs d\'examiner la ville sous tous les angles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418845&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1cbc31d9-317f-4a64-9ba6-b6e0c6a9afd4\', \'multiverseId\': 418845}, \'multiverseid\': 418845}, {\'name\': \'Planetario di Ghirapur\', \'text\': "Ogni giocatore può giocare una terra addizionale in ognuno dei propri turni.\\nAll\'inizio del mantenimento di ogni giocatore, se quel giocatore non ha carte in mano, quel giocatore pesca tre carte.", \'type\': \'Artefatto\', \'flavor\': \'Questo modello dettagliato permette agli edificatori di esaminare la città da ogni angolo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419109&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d92b27f1-6795-46c3-bb82-7c9f4a88bd1b\', \'multiverseId\': 419109}, \'multiverseid\': 419109}, {\'name\': \'ギラプールの宇宙儀\', \'text\': \'各プレイヤーは、自分の各ターンに追加の土地を１つプレイしてもよい。\\n各プレイヤーのアップキープの開始時に、そのプレイヤーの手札にカードが無い場合、そのプレイヤーはカードを３枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'この詳細な模型により、建築官は市の全貌を様々な角度から検討できる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419373&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f1d73773-ce5f-4c82-8bd2-e2c8b55e157a\', \'multiverseId\': 419373}, \'multiverseid\': 419373}, {\'name\': \'기라푸르 천문관\', \'text\': \'각 플레이어는 자신의 턴에 대지 한 개를 추가로 플레이할 수 있다.\\n각 플레이어의 유지단 시작에, 그 플레이어의 손에 카드가 한 장도 없다면, 그 플레이어는 카드 세 장을 뽑는다.\', \'type\': \'마법물체\', \'flavor\': \'이 상세 모델을 통해 건축가들은 모든 각도에서 도시를 살펴 볼 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419637&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'75bf8333-1842-403f-9339-408b44e44a4f\', \'multiverseId\': 419637}, \'multiverseid\': 419637}, {\'name\': \'Planetário de Ghirapur\', \'text\': \'Cada jogador pode jogar um terreno adicional em cada um de seus turnos.\\nNo início da manutenção de cada jogador, se aquele jogador não tiver cards na mão, ele compra três cards.\', \'type\': \'Artefato\', \'flavor\': \'Este modelo detalhado permite que os edificadores examinem a cidade de todos os ângulos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419901&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c753f8f5-a0f3-405f-8e2d-acd8ef488328\', \'multiverseId\': 419901}, \'multiverseid\': 419901}, {\'name\': \'Гирапурский Планетарий\', \'text\': \'Каждый игрок может разыграть одну дополнительную землю в каждом из своих ходов.\\nВ начале шага поддержки каждого игрока, если у того игрока нет карт в руке, тот игрок берет три карты.\', \'type\': \'Артефакт\', \'flavor\': \'Эта детальная модель позволяет градостроителям изучать город с любого угла.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420165&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'03a04de7-bd55-4fd9-a87a-5683066515a7\', \'multiverseId\': 420165}, \'multiverseid\': 420165}, {\'name\': \'吉拉波星象仪\', \'text\': \'每位牌手在自己的每个回合中均可以额外使用一个地。\\n在每位牌手的维持开始时，若该牌手没有手牌，则该牌手抓三张牌。\', \'type\': \'神器\', \'flavor\': \'这座模型细致入微，让建筑师得以从各个角度研究城市。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418053&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0bd5edbd-e3c2-4e6c-b1a5-ecad0ce8748b\', \'multiverseId\': 418053}, \'multiverseid\': 418053}, {\'name\': \'吉拉波星象儀\', \'text\': \'每位玩家在自己的每個回合中均可以額外使用一個地。\\n在每位玩家的維持開始時，若該玩家沒有手牌，則該玩家抽三張牌。\', \'type\': \'神器\', \'flavor\': \'這座模型細緻入微，讓建築師得以從各個角度研究這座城市。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418317&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'67ca7330-e71a-4076-8b42-612d9b423e83\', \'multiverseId\': 418317}, \'multiverseid\': 418317}]', '[{\'name\': \'Gießerei-Inspektor\', \'text\': \'Artefaktzauber, die du wirkst, kosten beim Wirken {1} weniger.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'Die Maschineninspektoren sorgen dafür, dass die strengen Vorschriften des Konsulats für die Massenproduktion eingehalten werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418580&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc9625b2-2256-46ae-a999-d38a5d4c0d02\', \'multiverseId\': 418580}, \'multiverseid\': 418580}, {\'name\': \'Inspector de la fundición\', \'text\': \'Te cuesta {1} menos lanzar los hechizos de artefacto.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'Los inspectores de autómatas garantizan el cumplimiento de las rígidas normas de producción en masa del Consulado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420428&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1392552a-95dd-49a9-807a-15712837cfb8\', \'multiverseId\': 420428}, \'multiverseid\': 420428}, {\'name\': \'Inspecteur de la fonderie\', \'text\': "Les sorts d\'artefact que vous lancez coûtent {1} de moins à lancer.", \'type\': \'Créature-artefact : construction\', \'flavor\': "Les auto-inspecteurs s\'assurent que les standards d\'excellence du Consulat en matière de production de masse sont respectés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418844&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f904b6f-94bb-4282-8c7d-72de5fb44206\', \'multiverseId\': 418844}, \'multiverseid\': 418844}, {\'name\': \'Ispettore della Fonderia\', \'text\': \'Le magie artefatto che lanci costano {1} in meno per essere lanciate.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': \'Gli automi ispettori garantiscono che vengano mantenuti i severi standard imposti dal Consolato per la produzione di massa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419108&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'24233a09-e8b9-447d-94c8-8993e450b068\', \'multiverseId\': 419108}, \'multiverseid\': 419108}, {\'name\': \'鋳造所の検査官\', \'text\': \'あなたがアーティファクト・呪文を唱えるためのコストは{1}少なくなる。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'自動機械の検査官が、領事府の定めた大量生産の厳格な基準を満たしていることを確認する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419372&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4c34716-0433-4767-9d97-45e2c4041955\', \'multiverseId\': 419372}, \'multiverseid\': 419372}, {\'name\': \'주조소 검사관\', \'text\': \'당신이 발동하는 마법물체 주문들은 발동하는 데 {1}이 덜 든다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': \'자동장치 검사관은 대량 생산에 대한 영사관의 엄격한 기준이 잘 지켜지는지 확인한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419636&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0db0f9c-40e8-4802-875d-3b16ce4830b5\', \'multiverseId\': 419636}, \'multiverseid\': 419636}, {\'name\': \'Inspetor da Fundição\', \'text\': \'As mágicas de artefato que você conjura custam {1} a menos para serem conjuradas.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': \'Os inspetores autômatos garantem que os padrões rigorosos de produção em massa do Consulado sejam mantidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419900&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e8243253-a7d9-401d-9fbd-a42b8c9889b2\', \'multiverseId\': 419900}, \'multiverseid\': 419900}, {\'name\': \'Инспектор Литейной\', \'text\': \'Разыгрываемые вами заклинания артефактов стоят на {1} меньше.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': \'Инспекторы-автоматы следят за тем, чтобы строгие нормы Консульства для массового производства неукоснительно соблюдались.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420164&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'54c92534-db10-4e01-a236-31ee3160079b\', \'multiverseId\': 420164}, \'multiverseid\': 420164}, {\'name\': \'铸造厂监工\', \'text\': \'你施放的神器咒语减少{1}来施放。\', \'type\': \'神器生物～组构体\', \'flavor\': \'执政院为大量生产制定了苛刻标准，自动机械监工确保此标准得以严格执行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418052&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9ec5af8b-f0a4-4146-8893-54574f9bfbcc\', \'multiverseId\': 418052}, \'multiverseid\': 418052}, {\'name\': \'鑄造廠監工\', \'text\': \'你施放的神器咒語減少{1}來施放。\', \'type\': \'神器生物～組構體\', \'flavor\': \'執政院為大量生產制定了苛刻標準，自動機械監工確保此標準得以嚴格執行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418316&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'59af65ea-f726-49e0-ba5c-65d22f3b9a67\', \'multiverseId\': 418316}, \'multiverseid\': 418316}]', '[{\'name\': \'Gießerei-Kreischer\', \'text\': \'Fliegend\\nDer Gießerei-Kreischer erhält +1/+0, solange du ein Artefakt kontrollierst.\', \'type\': \'Kreatur — Fledermaus\', \'flavor\': \'„Meine Geschöpfe sind noch immer nicht so schnell im Sturzflug wie diese geflügelten Säugetiere. Ich sollte eines von denen bei der Messe vorstellen." —Viprikti, Thopterist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418447&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be8adec4-702a-44d9-acb3-494748550f20\', \'multiverseId\': 418447}, \'multiverseid\': 418447}, {\'name\': \'Profierechillidos de la fundición\', \'text\': \'Vuela.\\nEl Profierechillidos de la fundición obtiene +1/+0 mientras controles un artefacto.\', \'type\': \'Criatura — Murciélago\', \'flavor\': \'"Mis creaciones siguen sin poder igualar la velocidad de caída en picado de esos ratones con alas. Quizá debería inscribir a alguno de ellos en la Feria". —Viprikti, topterista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420295&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'199bff84-94ac-4019-8336-97366fe9b6bb\', \'multiverseId\': 420295}, \'multiverseid\': 420295}, {\'name\': \'Crisseur de la fonderie\', \'text\': \'Vol\\nLe Crisseur de la fonderie gagne +1/+0 tant que vous contrôlez un artefact.\', \'type\': \'Créature : chauve-souris\', \'flavor\': \'« Mes créations sont toujours sans commune mesure face à la vitesse de ces mammifères aux ailes souples. Je devrais peut-être en présenter un à la Foire. » —Viprikti, mécanoptériste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58fc41ec-6e52-4e3c-85bd-c1590f35a5aa\', \'multiverseId\': 418711}, \'multiverseid\': 418711}, {\'name\': \'Urlatore della Fonderia\', \'text\': "Volare\\nL\'Urlatore della Fonderia prende +1/+0 fintanto che controlli un artefatto.", \'type\': \'Creatura — Pipistrello\', \'flavor\': \'"Le mie creazioni non riescono ancora a uguagliare la rapidità in picchiata di quei mammiferi dalle ali flosce. Forse dovrei iscriverne uno alla Fiera." —Viprikti, totterista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418975&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d56b1ea8-10ba-472a-b8e4-7fac5aee8ad4\', \'multiverseId\': 418975}, \'multiverseid\': 418975}, {\'name\': \'鋳造所のコウモリ\', \'text\': \'飛行\\nあなたがアーティファクトをコントロールしているかぎり、鋳造所のコウモリは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — コウモリ\', \'flavor\': \'「あのヒラヒラ翼が急降下する速度に匹敵する物ができないの。博覧会にはあれを１匹持ち込んだ方がましかもしれないわね。」 ――飛行機械製作者、ビプリクティ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419239&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62d27762-9c98-4ac1-ba41-a400e17b7f7b\', \'multiverseId\': 419239}, \'multiverseid\': 419239}, {\'name\': \'주조소 박쥐\', \'text\': \'비행\\n주조소 박쥐는 당신이 마법물체를 조종하는 한 +1/+0을 받는다.\', \'type\': \'생물 — 박쥐\', \'flavor\': \'"제 발명품들은 여전히 저 펄럭이는 날개를 가진 포유동물들의 활강 속도를 따라잡지 못합니다. 박람회에 저 녀석들 중 하나를 출품해야 할지도 모르겠군요." —날틀 제작자 비프릭티\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419503&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'653a5204-b469-4b3c-a436-d41f2aa462f7\', \'multiverseId\': 419503}, \'multiverseid\': 419503}, {\'name\': \'Guinchador da Fundição\', \'text\': \'Voar\\nGuinchador da Fundição receberá +1/+0 enquanto você controlar um artefato.\', \'type\': \'Criatura — Morcego\', \'flavor\': \'"Minhas criações ainda não conseguem se comparar à velocidade de mergulho daqueles mamíferos de asa bamba. Talvez eu devesse inscrever um deles na Feira." — Viprikti, topterista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419767&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'554c18f7-ea06-45ba-83b6-877a96d5ced8\', \'multiverseId\': 419767}, \'multiverseid\': 419767}, {\'name\': \'Крикун Литейной\', \'text\': \'Полет\\nКрикун Литейной получает +1/+0, пока вы контролируете артефакт.\', \'type\': \'Существо — Летучая_мышь\', \'flavor\': \'«Все мои создания неспособны превзойти скорость пикирования этих суматошных крылатых тварей. Может, мне показать такого зверя на Ярмарке?» — Виприкти, конструктор топтеров\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420031&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59181c3a-3202-463c-83a6-90c1c42acd3f\', \'multiverseId\': 420031}, \'multiverseid\': 420031}, {\'name\': \'铸造厂鸣蝠\', \'text\': \'飞行\\n只要你操控神器，铸造厂鸣蝠便得+1/+0。\', \'type\': \'生物～蝙蝠\', \'flavor\': \'「论俯冲速度，我的创作还是比不上那些软翼哺乳动物。我干脆带一只去参加博览会算了。」 ～振翼机师维琵蒂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417919&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dbb59dba-b906-4e8a-9b6c-44245c5b5b87\', \'multiverseId\': 417919}, \'multiverseid\': 417919}, {\'name\': \'鑄造廠鳴蝠\', \'text\': \'飛行\\n只要你操控神器，鑄造廠鳴蝠便得+1/+0。\', \'type\': \'生物～蝙蝠\', \'flavor\': \'「論俯衝速度，我的創作還是比不上那些軟翼哺乳動物。我乾脆帶一隻去參加博覽會算了。」 ～振翼機師維琵蒂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418183&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'73baaaa4-ec89-421d-a5b2-14858fdb4b5b\', \'multiverseId\': 418183}, \'multiverseid\': 418183}]', '[{\'name\': \'Glanzband-Kunsthandwerker\', \'text\': \'Fabrizieren 1 (Wenn diese Kreatur ins Spiel kommt, lege eine +1/+1-Marke auf sie oder erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.)\', \'type\': \'Kreatur — Zwerg, Handwerker\', \'flavor\': \'„Glänzend hell, rasend schnell."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418382&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f64c29f-a8ae-471e-9a22-114ad2c37647\', \'multiverseId\': 418382}, \'multiverseid\': 418382}, {\'name\': \'Artesano mangadestello\', \'text\': \'Fabricar 1. (Cuando esta criatura entre al campo de batalla, pon un contador +1/+1 sobre ella o crea una ficha de criatura artefacto Servo incolora 1/1.)\', \'type\': \'Criatura — Enano artífice\', \'flavor\': \'"Energía cargada, tuercas apretadas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f510b94b-7d94-43ad-9a32-e02af63dd769\', \'multiverseId\': 420230}, \'multiverseid\': 420230}, {\'name\': \'Artisan de la Manche étincelante\', \'text\': \'Fabrication 1 (Quand cette créature arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle ou créez un jeton de créature-artefact 1/1 incolore Servo.)\', \'type\': \'Créature : nain et artificier\', \'flavor\': \'« Éclat brillant, boulons serrés. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418646&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'069bf8c2-4ade-477c-950a-8a253fe58b97\', \'multiverseId\': 418646}, \'multiverseid\': 418646}, {\'name\': \'Artigiano Bracciolucente\', \'text\': \'Fabbrica 1 (Quando questa creatura entra nel campo di battaglia, metti un segnalino +1/+1 su di essa o crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.)\', \'type\': \'Creatura — Artefice Nano\', \'flavor\': \'"Lucido e netto, bullone ben stretto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418910&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0ba58923-c56e-4d7e-ac5b-af065fd477f4\', \'multiverseId\': 418910}, \'multiverseid\': 418910}, {\'name\': \'光袖会の職工\', \'text\': \'製造１（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを１個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。）\', \'type\': \'クリーチャー — ドワーフ・工匠\', \'flavor\': \'「光は明るく、ボルトはキツく。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419174&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72e5771b-0335-4833-85f6-f441304d52a0\', \'multiverseId\': 419174}, \'multiverseid\': 419174}, {\'name\': \'반짝소매협회 장인\', \'text\': \'제작 1 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 한 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.)\', \'type\': \'생물 — 드워프 기능공\', \'flavor\': \'"빛나게 광내고 볼트를 조이게."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419438&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e4799e22-681c-4c05-a964-d4efbfff1e6f\', \'multiverseId\': 419438}, \'multiverseid\': 419438}, {\'name\': \'Artesão Braçoluz\', \'text\': \'Fabricar 1 (Quando esta criatura entrar no campo de batalha, coloque um marcador +1/+1 nela ou crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.)\', \'type\': \'Criatura — Anão Artesão\', \'flavor\': \'"Aparelho lustrado, rebite apertado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419702&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a0d74701-6a9a-4a14-9dd8-4d0c1af1d700\', \'multiverseId\': 419702}, \'multiverseid\': 419702}, {\'name\': \'Мастеровой Золотой Руки\', \'text\': \'Производство 1 (Когда это существо выходит на поле битвы, положите на него один жетон +1/+1 или создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.)\', \'type\': \'Существо — Гном Механик\', \'flavor\': \'«Болты подкрути и блеск наводи».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419966&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea1c77c5-5915-4fdb-9859-5c2c34e1f879\', \'multiverseId\': 419966}, \'multiverseid\': 419966}, {\'name\': \'晶袖会工匠\', \'text\': \'装配1（当此生物进战场时，在其上放置一个+1/+1指示物或派出一个1/1无色自动机衍生神器生物。）\', \'type\': \'生物～矮人／神器师\', \'flavor\': \'「光芒耀眼，螺栓牢固。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417854&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2399344c-1a83-4059-b0c2-f9d4d6d47f2b\', \'multiverseId\': 417854}, \'multiverseid\': 417854}, {\'name\': \'晶袖會工匠\', \'text\': \'裝配1（當此生物進戰場時，在其上放置一個+1/+1指示物或派出一個1/1無色自動機衍生神器生物。）\', \'type\': \'生物～矮人／神器師\', \'flavor\': \'「光芒耀眼，螺栓牢固。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418118&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bbf07202-dfc7-4ce7-b518-f23f51b5fc63\', \'multiverseId\': 418118}, \'multiverseid\': 418118}]', '[{\'name\': \'Glasbläser-Rätselknoten\', \'text\': \'Wenn der Glasbläser-Rätselknoten ins Spiel kommt, wende Hellsicht 2 an. Dann erhältst du {E}{E}. (Du erhältst zwei Energiemarken. Betrachte für Hellsicht 2 die obersten zwei Karten deiner Bibliothek und lege dann eine beliebige Anzahl davon unter deine Bibliothek und den Rest in beliebiger Reihenfolge oben darauf.)\\n{2}{U}, opfere den Glasbläser-Rätselknoten: Hellsicht 2, dann erhältst du {E}{E}.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418582&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e28d0e3-99b7-40d5-a99b-f43523f03a50\', \'multiverseId\': 418582}, \'multiverseid\': 418582}, {\'name\': \'Enigma del soplador de vidrio\', \'text\': \'Cuando el Enigma del soplador de vidrio entre al campo de batalla, adivina 2. Luego obtienes {E}{E}. (Obtienes dos contadores de energía. Para adivinar 2, mira las dos primeras cartas de tu biblioteca, luego pon cualquier cantidad de ellas en el fondo de tu biblioteca y el resto en la parte superior en cualquier orden.)\\n{2}{U}, sacrificar el Enigma del soplador de vidrio: Adivina 2. Luego obtienes {E}{E}.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'756baa09-de34-416a-a674-dbf33bfa8c87\', \'multiverseId\': 420430}, \'multiverseid\': 420430}, {\'name\': \'Casse-tête du souffleur de verre\', \'text\': "Quand le Casse-tête du souffleur de verre arrive sur le champ de bataille, regard 2, puis vous gagnez {E}{E}. (Vous gagnez deux marqueurs « énergie ». Pour appliquer regard 2, regardez les deux cartes du dessus de votre bibliothèque. Mettez n\'importe quel nombre d\'entre elles au-dessous de votre bibliothèque et le reste au-dessus, dans n\'importe quel ordre.)\\n{2}{U}, sacrifiez le Casse-tête du souffleur de verre : Regard 2, puis vous gagnez {E}{E}.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a03df19-03d4-406f-804a-09a7af98bfb2\', \'multiverseId\': 418846}, \'multiverseid\': 418846}, {\'name\': \'Enigmatico del Soffiavetro\', \'text\': "Quando l\'Enigmatico del Soffiavetro entra nel campo di battaglia, profetizza 2, poi ottieni {E}{E}. (Ottieni due segnalini energia. Per profetizzare 2, guarda le prime due carte del tuo grimorio, poi mettine un qualsiasi numero in fondo al tuo grimorio e le altre in cima in qualsiasi ordine.)\\n{2}{U}, Sacrifica l\'Enigmatico del Soffiavetro: Profetizza 2, poi ottieni {E}{E}.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419110&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ffa9bd06-b76d-4818-bed5-2990ed78e5a8\', \'multiverseId\': 419110}, \'multiverseid\': 419110}, {\'name\': \'ガラス吹き工の組細工\', \'text\': \'ガラス吹き工の組細工が戦場に出たとき、占術２を行い、その後あなたは{E}{E}を得る。（あなたはエネルギー・カウンターを２個得る。占術２を行うには、あなたのライブラリーの一番上からカードを２枚見て、そのうちの望む枚数のカードを望む順番であなたのライブラリーの一番下に置き、残りを望む順番で一番上に置く。）\\n{2}{U}, ガラス吹き工の組細工を生け贄に捧げる：占術２を行い、その後あなたは{E}{E}を得る。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419374&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a0a2ffda-c4cb-419a-93ae-bdfad9c67eba\', \'multiverseId\': 419374}, \'multiverseid\': 419374}, {\'name\': \'유리세공인의 비밀 장치\', \'text\': \'유리세공인의 비밀 장치가 전장에 들어올 때, 점술 2를 한 후, 당신은 {E}{E}를 얻는다. (당신은 에너지 카운터 두 개를 얻는다. 점술 2를 하려면 당신의 서고 맨 위의 카드 두 장을 본다. 당신은 그 카드 중 원하는 만큼을 당신의 서고 맨 밑에 놓고 나머지를 당신의 서고 맨 위에 원하는 순서대로 놓을 수 있다.)\\n{2}{U}, 유리세공인의 비밀 장치를 희생한다: 점술 2를 한 후, 당신은 {E}{E}를 얻는다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419638&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3fe91708-715a-4401-8d58-b67982dc59be\', \'multiverseId\': 419638}, \'multiverseid\': 419638}, {\'name\': \'Quebra-cabeça do Vidreiro\', \'text\': \'Quando Quebra-cabeça do Vidreiro entrar no campo de batalha, use vidência 2. Em seguida, você recebe {E}{E}. (Você recebe dois marcadores de energia. Para usar vidência 2, olhe os dois cards do topo do seu grimório. Depois, coloque qualquer número deles no fundo do seu grimório e o restante no topo em qualquer ordem.)\\n{2}{U}, Sacrifique Quebra-cabeça do Vidreiro: Use vidência 2. Em seguida, você recebe {E}{E}.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419902&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a3b0d8d-6385-4a3a-9bdf-412864a6cbda\', \'multiverseId\': 419902}, \'multiverseid\': 419902}, {\'name\': \'Головоломка Стеклодува\', \'text\': \'Когда Головоломка Стеклодува выходит на поле битвы, предскажите 2, затем вы получаете {E}{E}. (Вы получаете два жетона энергии. Чтобы предсказать 2, посмотрите две верхние карты вашей библиотеки, затем положите любое количество из них в низ вашей библиотеки, а остальные на верх вашей библиотеки в любом порядке.)\\n{2}{U}, пожертвуйте Головоломку Стеклодува: предскажите 2, затем вы получаете {E}{E}.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420166&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'61973a5d-64dd-4f46-935e-0579845b3d61\', \'multiverseId\': 420166}, \'multiverseid\': 420166}, {\'name\': \'琉璃匠谜结\', \'text\': \'当琉璃匠谜结进战场时，占卜2，然后你得到{E}{E}。（你得到两个能量指示物。占卜2的流程是检视你牌库顶的两张牌，然后将其中任意数量的牌以任意顺序置于你牌库底，其余则以任意顺序置于你牌库顶。）\\n{2}{U}，牺牲琉璃匠谜结：占卜2，然后你得到{E}{E}。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418054&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'feed5892-a2c6-4be3-a0f6-a48926a3fb58\', \'multiverseId\': 418054}, \'multiverseid\': 418054}, {\'name\': \'琉璃匠謎結\', \'text\': \'當琉璃匠謎結進戰場時，占卜2，然後你得到{E}{E}。（你得到兩個能量指示物。占卜2的流程是檢視你牌庫頂的兩張牌，然後將其中任意數量的牌以任意順序置於你牌庫底，其餘則以任意順序置於你牌庫頂。）\\n{2}{U}，犧牲琉璃匠謎結：占卜2，然後你得到{E}{E}。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418318&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3661e7d2-7030-4bef-847a-9962406dab88\', \'multiverseId\': 418318}, \'multiverseid\': 418318}]', '[{\'name\': \'Glitzernest-Kranich\', \'text\': \'Fliegend\\nWenn der Glitzernest-Kranich ins Spiel kommt, schaue dir die obersten vier Karten deiner Bibliothek an. Du kannst davon eine Artefaktkarte offen vorzeigen und sie auf deine Hand nehmen. Lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418415&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'67a9a7ce-e7c3-487c-98a0-f69351bc6495\', \'multiverseId\': 418415}, \'multiverseid\': 418415}, {\'name\': \'Grulla nidofulgor\', \'text\': \'Vuela.\\nCuando la Grulla nidofulgor entre al campo de batalla, mira las cuatro primeras cartas de tu biblioteca. Puedes mostrar una carta de artefacto que se encuentre entre ellas y ponerla en tu mano. Pon el resto en el fondo de tu biblioteca en cualquier orden.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420263&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31e0545b-3d70-492d-b34b-ccb17c824495\', \'multiverseId\': 420263}, \'multiverseid\': 420263}, {\'name\': \'Grue au nid étincelant\', \'text\': "Vol\\nQuand la Grue au nid étincelant arrive sur le champ de bataille, regardez les quatre cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte d\'artefact parmi elles et la mettre dans votre main. Mettez le reste au-dessous de votre bibliothèque dans l\'ordre de votre choix.", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e2dd6c17-2356-4604-b6ae-42fde1918a61\', \'multiverseId\': 418679}, \'multiverseid\': 418679}, {\'name\': \'Gru Nidolucente\', \'text\': \'Volare\\nQuando la Gru Nidolucente entra nel campo di battaglia, guarda le prime quattro carte del tuo grimorio. Puoi rivelare una carta artefatto scelta tra esse e aggiungerla alla tua mano. Metti le altre in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Creatura — Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c87f59b7-bbe5-4668-a64f-5aa65644f7ad\', \'multiverseId\': 418943}, \'multiverseid\': 418943}, {\'name\': \'光り物集めの鶴\', \'text\': \'飛行\\n光り物集めの鶴が戦場に出たとき、あなたのライブラリーの一番上からカードを４枚見る。あなたはその中からアーティファクト・カード１枚を公開してあなたの手札に加えてもよい。残りをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419207&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b3ba2910-ccee-443a-b4eb-5698f38e1bc9\', \'multiverseId\': 419207}, \'multiverseid\': 419207}, {\'name\': \'반짝이 수집 두루미\', \'text\': \'비행\\n반짝이 수집 두루미가 전장에 들어올 때, 당신의 서고 맨 위의 카드 네 장을 본다. 당신은 그중에서 마법물체 카드 한 장을 공개한 후 당신의 손으로 가져갈 수 있다. 나머지 카드들은 당신이 원하는 순서로 당신의 서고 맨 밑에 놓는다.\', \'type\': \'생물 — 조류\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419471&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5e8c21a3-7026-4c65-8173-279935382d46\', \'multiverseId\': 419471}, \'multiverseid\': 419471}, {\'name\': \'Garça Nidilume\', \'text\': \'Voar\\nQuando Garça Nidilume entrar no campo de batalha, olhe os quatro cards do topo de seu grimório. Você pode revelar um card de artefato entre eles e colocá-lo em sua mão. Coloque o restante no fundo de seu grimório em qualquer ordem.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419735&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9894c21b-a501-4fae-b788-7b29dadcf4d1\', \'multiverseId\': 419735}, \'multiverseid\': 419735}, {\'name\': \'Журавль Золоченого Гнезда\', \'text\': \'Полет\\nКогда Журавль Золоченого Гнезда выходит на поле битвы, посмотрите четыре верхние карты вашей библиотеки. Вы можете показать находящуюся среди них карту артефакта и положить ее в вашу руку. Положите остальные карты в низ вашей библиотеки в любом порядке.\', \'type\': \'Существо — Птица\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419999&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6b711eaa-0268-45c3-b3b8-8903bf6397f8\', \'multiverseId\': 419999}, \'multiverseid\': 419999}, {\'name\': \'烁巢鹤\', \'text\': \'飞行\\n当烁巢鹤进战场时，检视你牌库顶的四张牌。你可以展示其中的一张神器牌，并将它置于你手上。将其余的牌以任意顺序置于你牌库底。\', \'type\': \'生物～鸟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417887&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44290b33-8e5f-4fde-b8d3-30e7dde8a8b5\', \'multiverseId\': 417887}, \'multiverseid\': 417887}, {\'name\': \'爍巢鶴\', \'text\': \'飛行\\n當爍巢鶴進戰場時，檢視你牌庫頂的四張牌。你可以展示其中的一張神器牌，並將它置於你手上。將其餘的牌以任意順序置於你的牌庫底。\', \'type\': \'生物～鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418151&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d221fe7e-0df6-4bf2-b9ca-1fca16d5e5f7\', \'multiverseId\': 418151}, \'multiverseid\': 418151}]', '[{\'name\': \'Gonti, Fürst der Opulenz\', \'text\': \'Todesberührung\\nWenn Gonti, Fürst der Opulenz, ins Spiel kommt, schaue dir die obersten vier Karten der Bibliothek eines Gegners deiner Wahl an, schicke eine davon verdeckt ins Exil und lege dann den Rest in zufälliger Reihenfolge unter seine Bibliothek. Solange jene Karte im Exil ist, kannst du sie anschauen, sie wirken und Mana ausgeben, als wäre es Mana beliebigen Typs, um sie zu wirken.\', \'type\': \'Legendäre Kreatur — Äthergeborener, Räuber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418449&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f37582d3-a954-4905-bf77-0588dac1b1a8\', \'multiverseId\': 418449}, \'multiverseid\': 418449}, {\'name\': \'Gonti, señor de la opulencia\', \'text\': \'Toque mortal.\\nCuando Gonti, señor de la opulencia entre al campo de batalla, mira las primeras cuatro cartas de la biblioteca del oponente objetivo y exilia una de ellas boca abajo. Luego, pon el resto en el fondo de esa biblioteca en un orden aleatorio. Mientras esa carta permanezca exiliada, puedes mirarla, lanzarla y gastar maná como si fuera maná de cualquier tipo para lanzarla.\', \'type\': \'Criatura legendaria — Bribón etergénito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420297&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f779c81-b6da-4893-bd04-752cf097443e\', \'multiverseId\': 420297}, \'multiverseid\': 420297}, {\'name\': "Gonti, seigneur de l\'opulence", \'text\': "Contact mortel\\nQuand Gonti, seigneur de l\'opulence arrive sur le champ de bataille, regardez les quatre cartes du dessus de la bibliothèque de l\'adversaire ciblé, exilez l\'une d\'elles face cachée, puis mettez le reste au-dessous de cette bibliothèque dans un ordre aléatoire. Tant que cette carte reste exilée, vous pouvez la regarder, vous pouvez la lancer et vous pouvez dépenser du mana comme s\'il s\'agissait de mana de n\'importe quel type pour la lancer.", \'type\': \'Créature légendaire : éthérien et gredin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418713&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7124f272-0b48-449d-b782-493297ded596\', \'multiverseId\': 418713}, \'multiverseid\': 418713}, {\'name\': \'Gonti, Signore del Lusso\', \'text\': \'Tocco letale\\nQuando Gonti, Signore del Lusso entra nel campo di battaglia, guarda le prime quattro carte del grimorio di un avversario bersaglio, esiliane una a faccia in giù, poi metti le altre in fondo a quel grimorio in ordine casuale. Fintanto che quella carta rimane in esilio, puoi guardarla, puoi lanciarla e puoi spendere mana come se fosse mana di qualsiasi tipo per lanciarla.\', \'type\': \'Creatura Leggendaria — Farabutto Eteride\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418977&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'09b461fc-a5c4-4ad9-8386-64f7fb370ae8\', \'multiverseId\': 418977}, \'multiverseid\': 418977}, {\'name\': \'豪華の王、ゴンティ\', \'text\': \'接死\\n豪華の王、ゴンティが戦場に出たとき、対戦相手１人を対象とする。そのプレイヤーのライブラリーの一番上からカードを４枚見て、そのうち１枚を裏向きに追放し、その後残りをそのライブラリーの一番下に無作為の順番で置く。そのカードが追放され続けているかぎり、あなたはそれを見てもよく、あなたはそれを唱えてもよく、あなたはそれを唱えるために任意のマナを望むタイプのマナであるかのように支払ってもよい。\', \'type\': \'伝説のクリーチャー — 霊基体・ならず者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419241&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5c65adf-e505-4279-a607-456dc7e677d2\', \'multiverseId\': 419241}, \'multiverseid\': 419241}, {\'name\': \'사치스러운 군주 곤티\', \'text\': \'치명타\\n사치스러운 군주 곤티가 전장에 들어올 때, 상대를 목표로 정한다. 그 상대의 서고 맨 위 카드 네 장을 보고 그중 한 장을 뒷면 상태로 추방한 후, 나머지는 상대의 서고 맨 밑에 무작위로 놓는다. 그 카드가 추방된 상태로 남아 있는 한, 당신은 그 카드를 볼 수 있고, 발동할 수 있으며, 발동비용을 지불하기 위한 마나를 원하는 유형의 마나인 것처럼 사용할 수 있다.\', \'type\': \'전설적 생물 — 에테르붙이 도적\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419505&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'142172f5-d24a-4304-adfb-796668c67370\', \'multiverseId\': 419505}, \'multiverseid\': 419505}, {\'name\': \'Gonti, Senhor da Opulência\', \'text\': \'Toque mortífero\\nQuando Gonti, Senhor da Opulência, entrar no campo de batalha, olhe os quatro cards do topo do grimório do oponente alvo, exile um deles com a face voltada para baixo e, em seguida, coloque o restante no fundo daquele grimório em ordem aleatória. Enquanto o card permanecer exilado, você poderá olhá-lo, conjurá-lo e gastar mana como se fosse de qualquer tipo para conjurá-lo.\', \'type\': \'Criatura Lendária — Etergênito Ladino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9b336df-5e97-454b-81a2-0f84be3163fa\', \'multiverseId\': 419769}, \'multiverseid\': 419769}, {\'name\': \'Гонти, Владыка Роскоши\', \'text\': \'Смертельное касание\\nКогда Гонти, Владыка Роскоши выходит на поле битвы, посмотрите четыре верхние карты библиотеки целевого оппонента, изгоните одну из них рубашкой вверх, затем положите остальные карты в низ той библиотеки в случайном порядке. Пока та карта остается в изгнании, вы можете смотреть ее, можете разыграть ее, если это не карта земли, и можете тратить на ее разыгрывание ману, как будто это мана любого типа.\', \'type\': \'Легендарное Существо — Эфирид Бродяга\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420033&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f9b775e4-70be-46fc-b202-e5ef7efec887\', \'multiverseId\': 420033}, \'multiverseid\': 420033}, {\'name\': \'奢华领主贡提\', \'text\': \'死触\\n当奢华领主贡提进战场时，检视目标对手牌库顶的四张牌，将其中一张牌面朝下地放逐，然后将其余的牌以随机顺序置于该牌库底。于该牌持续被放逐期间，你可以检视之，你可以施放之，且你可以将法术力视同任意种类的法术力来支付施放它的费用。\', \'type\': \'传奇生物～乙太种／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417921&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44b2afe0-09e9-40f1-bb84-530a40da63a8\', \'multiverseId\': 417921}, \'multiverseid\': 417921}, {\'name\': \'奢華領主貢提\', \'text\': \'死觸\\n當奢華領主貢提進戰場時，檢視目標對手牌庫頂的四張牌，將其中一張牌面朝下地放逐，然後將其餘的牌以隨機順序置於該牌庫底。於該牌持續被放逐期間，你可以檢視之，你可以施放之，且你可以將魔法力視同任意種類的魔法力來支付施放它的費用。\', \'type\': \'傳奇生物～乙太種／浪客\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418185&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ae40ab1b-fdaf-4bd9-adc4-8075d63649c7\', \'multiverseId\': 418185}, \'multiverseid\': 418185}]', '[{\'name\': \'Hammerfaust-Trupp\', \'text\': \'Bedrohlich\\nFabrizieren 1 (Wenn diese Kreatur ins Spiel kommt, lege eine +1/+1-Marke auf sie oder erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.)\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'„Hübsche Erfindung, die du da hast. Schaut echt zerbrechlich aus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418456&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c743e6d5-086b-4f5f-8aae-d8ef7a1604ce\', \'multiverseId\': 418456}, \'multiverseid\': 418456}, {\'name\': \'Escuadrón Puñomaza\', \'text\': \'Amenaza.\\nFabricar 1. (Cuando esta criatura entre al campo de batalla, pon un contador +1/+1 sobre ella o crea una ficha de criatura artefacto Servo incolora 1/1.)\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'"Bonito invento. Parece muy frágil".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420304&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5e03e07-e53e-44fb-a7cb-2eac8d4613b3\', \'multiverseId\': 420304}, \'multiverseid\': 420304}, {\'name\': \'Escouade de Massepoing\', \'text\': \'Menace\\nFabrication 1 (Quand cette créature arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle ou créez un jeton de créature-artefact 1/1 incolore Servo.)\', \'type\': \'Créature : humain et artificier\', \'flavor\': "« C\'est une belle invention que vous avez là. Elle a l\'air fragile. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418720&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9fc3a2a-ae36-497e-ba04-ead566f3fbc0\', \'multiverseId\': 418720}, \'multiverseid\': 418720}, {\'name\': \'Banda di Pugnomartello\', \'text\': \'Minacciare\\nFabbrica 1 (Quando questa creatura entra nel campo di battaglia, metti un segnalino +1/+1 su di essa o crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.)\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'"Bell\\\'invenzione. Sembra parecchio fragile, però."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418984&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a574047b-cef8-4f7e-9229-f9e331a00c5b\', \'multiverseId\': 418984}, \'multiverseid\': 418984}, {\'name\': \'襲拳会の部隊\', \'text\': \'威迫\\n製造１（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを１個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。）\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'「いい発明品があるな。簡単に壊せそうだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419248&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f683b72-544f-4692-87f0-539d4dddcd24\', \'multiverseId\': 419248}, \'multiverseid\': 419248}, {\'name\': \'망치주먹무리 순찰대\', \'text\': \'호전적\\n제작 1 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 한 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.)\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'"멋진 발명품이군. 깨지기 쉬워 보이는데."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419512&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'76424285-07a9-441a-a48e-12e556cc2ec2\', \'multiverseId\': 419512}, \'multiverseid\': 419512}, {\'name\': \'Esquadrão Punho-de-marreta\', \'text\': \'Ameaçar\\nFabricar 1 (Quando esta criatura entrar no campo de batalha, coloque um marcador +1/+1 nela ou crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.)\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'"Boa invenção, essa. Parece realmente frágil."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419776&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'abcf90b2-fb9e-4ec4-9515-e9f5d01e3914\', \'multiverseId\': 419776}, \'multiverseid\': 419776}, {\'name\': \'Отряд Молотобойцев\', \'text\': \'Угроза\\nПроизводство 1 (Когда это существо выходит на поле битвы, положите на него один жетон +1/+1 или создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.)\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'«Симпатичное у тебя изобретение. Только вот хрупкое на вид».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420040&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd320dce-c873-4f24-8664-b019eda9640d\', \'multiverseId\': 420040}, \'multiverseid\': 420040}, {\'name\': \'槌拳会小队\', \'text\': \'威慑\\n装配1（当此生物进战场时，在其上放置一个+1/+1指示物或派出一个1/1无色自动机衍生神器生物。）\', \'type\': \'生物～人类／神器师\', \'flavor\': \'「不错的发明。看起来一碰就碎。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417928&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7529cec-cf2c-4505-98e3-5af0969e603c\', \'multiverseId\': 417928}, \'multiverseid\': 417928}, {\'name\': \'槌拳會小隊\', \'text\': \'威懾\\n裝配1（當此生物進戰場時，在其上放置一個+1/+1指示物或派出一個1/1無色自動機衍生神器生物。）\', \'type\': \'生物～人類／神器師\', \'flavor\': \'「不錯的發明。看起來一碰就碎。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418192&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aa888bb4-d563-411d-be32-3f092d49b667\', \'multiverseId\': 418192}, \'multiverseid\': 418192}]', '[{\'name\': \'Hammerfaust-Türbrecher\', \'text\': \'Wenn der Hammerfaust-Türbrecher ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn der Hammerfaust-Türbrecher angreift, kannst du {E} bezahlen. Falls du dies tust, kann eine Kreatur deiner Wahl in diesem Zug nicht blocken.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Klopf, klopf … zu spät."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418488&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'76f232a4-3c67-4b11-921a-1ec9669f4b29\', \'multiverseId\': 418488}, \'multiverseid\': 418488}, {\'name\': \'Puñomaza perforapuertas\', \'text\': \'Cuando el Puñomaza perforapuertas entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que el Puñomaza perforapuertas ataque, puedes pagar {E}. Si lo haces, la criatura objetivo no puede bloquear este turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"Toc, toc... Demasiado tarde".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420336&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'364f8634-7fab-4643-a506-fa2e81efd821\', \'multiverseId\': 420336}, \'multiverseid\': 420336}, {\'name\': \'Briseporte de Massepoing\', \'text\': \'Quand le Briseporte de Massepoing arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que le Briseporte de Massepoing attaque, vous pouvez payer {E}. Si vous faites ainsi, la créature ciblée ne peut pas bloquer ce tour-ci.\', \'type\': \'Créature : humain et guerrier\', \'flavor\': \'« Toc, toc, toc... Trop tard. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418752&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1342ae2a-45e8-4617-b777-c1b6d954ab19\', \'multiverseId\': 418752}, \'multiverseid\': 418752}, {\'name\': \'Sfondaporte Pugnomartello\', \'text\': \'Quando lo Sfondaporte Pugnomartello entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta lo Sfondaporte Pugnomartello attacca, puoi pagare {E}. Se lo fai, una creatura bersaglio non può bloccare in questo turno.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Toc toc... troppo tardi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419016&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d368f253-9163-4f53-8ecf-c2c60da4c3f5\', \'multiverseId\': 419016}, \'multiverseid\': 419016}, {\'name\': \'襲拳会の扉破り\', \'text\': \'襲拳会の扉破りが戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n襲拳会の扉破りが攻撃するたび、クリーチャー１体を対象とする。あなたは{E}を支払ってもよい。そうしたなら、このターン、それではブロックできない。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「ちょっと失礼……手遅れだぜ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419280&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'214dabc0-a153-4476-947d-8d9b29e63b03\', \'multiverseId\': 419280}, \'multiverseid\': 419280}, {\'name\': \'망치주먹무리 문파괴자\', \'text\': \'망치주먹무리 문파괴자가 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n망치주먹무리 문파괴자가 공격할 때마다, 당신은 {E}를 지불할 수 있다. 그렇게 한다면, 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"똑, 똑 . . . 늦었어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419544&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'38aa39c9-c854-4097-8277-b72815daa62c\', \'multiverseId\': 419544}, \'multiverseid\': 419544}, {\'name\': \'Arrombador Punho-de-marreta\', \'text\': \'Quando Arrombador Punho-de-marreta entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Arrombador Punho-de-marreta ataca, você pode pagar {E}. Se fizer isso, a criatura alvo não poderá bloquear neste turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Toc, toc... tarde demais."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419808&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b928592-9bdd-496a-8e10-3b8231a622e7\', \'multiverseId\': 419808}, \'multiverseid\': 419808}, {\'name\': \'Молотобоец, Крушитель Дверей\', \'text\': \'Когда Молотобоец, Крушитель Дверей выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Молотобоец, Крушитель Дверей атакует, вы можете заплатить {E}. Если вы это делаете, целевое существо не может блокировать в этом ходу.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«Тук-тук... слишком поздно».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420072&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea57c331-9298-4913-9f77-1109eab60f42\', \'multiverseId\': 420072}, \'multiverseid\': 420072}, {\'name\': \'槌拳会破门人\', \'text\': \'当槌拳会破门人进战场时，你得到{E}{E}（两个能量指示物）。\\n每当槌拳会破门人攻击时，你可以支付{E}。若你如此作，目标生物本回合不能进行阻挡。\', \'type\': \'生物～人类／战士\', \'flavor\': \'「敲敲门. . .来不及了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417960&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c8fb8182-745a-4a73-9587-937d6c77e388\', \'multiverseId\': 417960}, \'multiverseid\': 417960}, {\'name\': \'槌拳會破門人\', \'text\': \'當槌拳會破門人進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當槌拳會破門人攻擊時，你可以支付{E}。若你如此作，目標生物本回合不能進行阻擋。\', \'type\': \'生物～人類／戰士\', \'flavor\': \'「敲敲門. . .來不及了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418224&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a394bf56-97a0-4e3e-86a9-c7467f6d1abf\', \'multiverseId\': 418224}, \'multiverseid\': 418224}]', '[{\'name\': \'Heimtückischer Wille\', \'text\': \'Bestimme eines —\\n• Neutralisiere einen Zauberspruch deiner Wahl.\\n• Du kannst neue Ziele für einen Zauberspruch deiner Wahl bestimmen.\\n• Kopiere einen Spontanzauber oder eine Hexerei deiner Wahl. Du kannst neue Ziele für die Kopie bestimmen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Und so treffen wir uns wieder, Pyromagierin." —Baral, Oberster Regelüberwacher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418417&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6f74698-79e8-4bfc-9ba1-3986bdb3359b\', \'multiverseId\': 418417}, \'multiverseid\': 418417}, {\'name\': \'Voluntad insidiosa\', \'text\': \'Elige uno:\\n• Contrarresta el hechizo objetivo.\\n• Puedes elegir nuevos objetivos para el hechizo objetivo.\\n• Copia el hechizo de instantáneo o de conjuro objetivo. Puedes elegir nuevos objetivos para la copia.\', \'type\': \'Instantáneo\', \'flavor\': \'"Volvemos a vernos, piromante". —Baral, señor de la sumisión\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5edb572a-6605-43d2-aea8-b8f60e1bc303\', \'multiverseId\': 420265}, \'multiverseid\': 420265}, {\'name\': \'Volonté insidieuse\', \'text\': "Choisissez l\'un —\\n• Contrecarrez le sort ciblé.\\n• Vous pouvez choisir de nouvelles cibles pour le sort ciblé.\\n• Copiez le sort d\'éphémère ou de rituel ciblé. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Éphémère\', \'flavor\': \'« Comme on se retrouve, pyromancienne. » —Baral, directeur de conformité\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418681&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2877a89d-eeed-45a4-bb76-aa0bec08367c\', \'multiverseId\': 418681}, \'multiverseid\': 418681}, {\'name\': \'Volontà Insidiosa\', \'text\': \'Scegli uno —\\n• Neutralizza una magia bersaglio.\\n• Puoi scegliere nuovi bersagli per una magia bersaglio.\\n• Copia una magia istantaneo o stregoneria bersaglio. Puoi scegliere nuovi bersagli per la copia.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ci incontriamo di nuovo, piromante." —Baral, Commissario della conformità\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418945&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e46f0ab-95d3-4b0f-a39b-78d6bcb001b3\', \'multiverseId\': 418945}, \'multiverseid\': 418945}, {\'name\': \'腹黒い意志\', \'text\': \'以下から１つを選ぶ。\\n• 呪文１つを対象とし、それを打ち消す。\\n• 呪文１つを対象とする。あなたはそれの新しい対象を選んでもよい。\\n• インスタント・呪文１つかソーサリー・呪文１つを対象とし、それをコピーする。あなたはそのコピーの新しい対象を選んでもよい。\', \'type\': \'インスタント\', \'flavor\': \'「また会ったな、紅蓮術師め。」 ――遵法長、バラル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419209&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5239ece4-ccac-41ca-9dfd-30e3627c9b22\', \'multiverseId\': 419209}, \'multiverseid\': 419209}, {\'name\': \'음흉한 의지\', \'text\': \'하나를 선택한다 —\\n• 주문을 목표로 정한다. 그 주문을 무효화한다.\\n• 주문을 목표로 정한다. 당신은 그 주문의 목표를 새로 정할 수 있다.\\n• 순간마법 또는 집중마법 주문을 목표로 정한다. 그 주문을 복사한다. 당신은 그 복사본의 목표를 새로 정할 수 있다.\', \'type\': \'순간마법\', \'flavor\': \'"다시 만났군, 화염술사." —감시 대장 바랄\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419473&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f0dee3af-15c2-442d-b93f-1b82840d3d0e\', \'multiverseId\': 419473}, \'multiverseid\': 419473}, {\'name\': \'Vontade Insidiosa\', \'text\': \'Escolha um —\\n• Anule a mágica alvo.\\n• Você pode escolher novos alvos para a mágica alvo.\\n• Copie a mágica instantânea ou feitiço alvo. Você pode escolher novos alvos para a cópia.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Enfim nos encontramos de novo, piromante." — Baral, Chefe da Conformidade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419737&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2fc2f8e2-8ef9-4e15-924e-3524a27f4c1f\', \'multiverseId\': 419737}, \'multiverseid\': 419737}, {\'name\': \'Коварная Воля\', \'text\': \'Выберите одно —\\n• Отмените целевое заклинание.\\n• Вы можете выбрать новые цели для целевого заклинания.\\n• Скопируйте целевое мгновенное заклинание или заклинание волшебства. Вы можете выбрать новые цели для этой копии.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Вот мы и встретились вновь, пиромант». — Бараль, старший по повиновению\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420001&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'82f73747-b428-4f23-bc9d-0b9118d41356\', \'multiverseId\': 420001}, \'multiverseid\': 420001}, {\'name\': \'隐伏意志\', \'text\': \'选择一项～\\n•反击目标咒语。\\n•你可以为目标咒语选择新的目标。\\n•复制目标瞬间或法术咒语。你可以为该复制品选择新的目标。\', \'type\': \'瞬间\', \'flavor\': \'「我们又见面了，烈焰术士。」 ～监察长巴罗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0a6600f-0f03-4d61-9209-7db0520b3e53\', \'multiverseId\': 417889}, \'multiverseid\': 417889}, {\'name\': \'隱伏意志\', \'text\': \'選擇一項～\\n•反擊目標咒語。\\n•你可以為目標咒語選擇新的目標。\\n•複製目標瞬間或巫術咒語。你可以為該複製品選擇新的目標。\', \'type\': \'瞬間\', \'flavor\': \'「我們又見面了，烈焰術士。」 ～監察長巴羅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418153&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0629abb6-b53f-4571-b98d-50562d0fc4d4\', \'multiverseId\': 418153}, \'multiverseid\': 418153}]', '[{\'name\': \'Herausgeputztes Dromedar\', \'type\': \'Kreatur — Kamel\', \'flavor\': \'Es gibt keine Kleiderordnung für die Erfindermesse, doch man wird kaum jemanden finden, der sich nicht in Schale geworfen hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418395&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44b35c61-d6b5-4dc1-9950-3d3ecfc0004d\', \'multiverseId\': 418395}, \'multiverseid\': 418395}, {\'name\': \'Dromedario engalanado\', \'type\': \'Criatura — Camello\', \'flavor\': \'No hay un código de vestuario oficial para la Feria de Inventores, pero cuesta encontrar alguien o algo que no se haya arreglado de forma exquisita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420243&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec5e5e07-2a1f-43ee-b475-9dec17dee52a\', \'multiverseId\': 420243}, \'multiverseid\': 420243}, {\'name\': "Dromadaire d\'apparat", \'type\': \'Créature : chameau\', \'flavor\': "Aucune tenue correcte n\'est exigée pour la Foire des inventeurs, mais vous aurez du mal à trouver quelqu\'un ou quelque chose qui ne soit pas paré de ses plus beaux atours.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418659&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'656c39a4-1fd2-4332-8409-d71d554c15ae\', \'multiverseId\': 418659}, \'multiverseid\': 418659}, {\'name\': \'Dromedario da Parata\', \'type\': \'Creatura — Cammello\', \'flavor\': \'La Fiera degli Inventori non richiede un abbigliamento specifico, ma è quasi impossibile trovare qualcuno o qualcosa che non sia bardato a festa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418923&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bbea80ed-acce-4fc6-b486-02ab00bbddac\', \'multiverseId\': 418923}, \'multiverseid\': 418923}, {\'name\': \'着飾ったラクダ\', \'type\': \'クリーチャー — ラクダ\', \'flavor\': \'発明博覧会には服装の決まりなどないが、そこでは誰でも、動物までもが着飾っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419187&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98ce736f-131c-4ee1-b41d-245a9195c31a\', \'multiverseId\': 419187}, \'multiverseid\': 419187}, {\'name\': \'치장한 단봉낙타\', \'type\': \'생물 — 낙타\', \'flavor\': \'발명 박람회에 복장 규정은 없지만, 사람이든 물건이든 차려입지 않은 것을 찾기는 매우 어렵다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419451&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'611e4707-ca66-4dd8-9266-b4aa05d74fdf\', \'multiverseId\': 419451}, \'multiverseid\': 419451}, {\'name\': \'Dromedário Borlado\', \'type\': \'Criatura — Camelo\', \'flavor\': \'Não há um traje recomendado para a Feira dos Inventores, mas vai ser difícil encontrar qualquer um que não esteja com sua melhor indumentária.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419715&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6892fcb7-75d7-415a-b2a3-852d5d8f6356\', \'multiverseId\': 419715}, \'multiverseid\': 419715}, {\'name\': \'Разукрашенный Дромадер\', \'type\': \'Существо — Верблюд\', \'flavor\': \'На Ярмарке Изобретателей нет требований к костюму, но придется сильно постараться, чтобы найти хоть кого-нибудь, не наряженного в свои лучшие одежды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419979&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c44c8584-6d1c-461c-a73a-7357c539eeda\', \'multiverseId\': 419979}, \'multiverseid\': 419979}, {\'name\': \'华装骆驼\', \'type\': \'生物～骆驼\', \'flavor\': \'发明家博览会虽无服装规定，但很难找到没有精心装扮的人或物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417867&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5bb255c7-036a-44ba-ac73-327fd5c1b54d\', \'multiverseId\': 417867}, \'multiverseid\': 417867}, {\'name\': \'華裝駱駝\', \'type\': \'生物～駱駝\', \'flavor\': \'發明家博覽會雖無服裝規定，但很難找到沒有精心裝扮的人或物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418131&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'628c82a1-12f6-473e-8a5e-f194bc14492a\', \'multiverseId\': 418131}, \'multiverseid\': 418131}]', '[{\'name\': \'Herold der Messe\', \'text\': \'Wenn der Herold der Messe ins Spiel kommt, erhält eine Kreatur deiner Wahl, die du kontrollierst, +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch\', \'flavor\': \'„Willkommen, ihr lieben Leute! Hier entlang! Öffnet eure Augen, eure Ohren und eure Vorstellungskraft den Wundern der Erfindermesse!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418383&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e6f51d2-353d-48de-b6dd-2573dd276966\', \'multiverseId\': 418383}, \'multiverseid\': 418383}, {\'name\': \'Pregonero de la feria\', \'text\': \'Cuando el Pregonero de la feria entre al campo de batalla, la criatura objetivo que controlas obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"¡Bienvenidos todos! Por aquí, por favor. ¡Abran los ojos, los oídos y la imaginación a las maravillas de esta Feria de Inventores!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420231&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27813862-41d6-42c4-8858-adf167c7cdf1\', \'multiverseId\': 420231}, \'multiverseid\': 420231}, {\'name\': \'Héraut de la foire\', \'text\': "Quand le Héraut de la foire arrive sur le champ de bataille, une créature ciblée que vous contrôlez gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain\', \'flavor\': \'« Bienvenue à toutes et à tous ! Approchez ! Ouvrez grand vos yeux et vos oreilles, et laissez-vous charmer par les merveilles de la Foire des inventeurs ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418647&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6757f42f-937d-46ac-a04f-54e2a3f55ece\', \'multiverseId\': 418647}, \'multiverseid\': 418647}, {\'name\': \'Araldo della Fiera\', \'text\': "Quando l\'Araldo della Fiera entra nel campo di battaglia, una creatura bersaglio che controlli prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Umano\', \'flavor\': \'"Benvenuti a tutti! Da questa parte! Spalancate gli occhi, le orecchie e la mente per ammirare le meraviglie della Fiera degli Inventori!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418911&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ed534bfe-1324-40cf-ac3a-512f3969513c\', \'multiverseId\': 418911}, \'multiverseid\': 418911}, {\'name\': \'博覧会の歓迎者\', \'text\': \'博覧会の歓迎者が戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間\', \'flavor\': \'「ご来場の皆さん！こちらへお進みください！目と耳と、そして心も開いて、驚異の発明博覧会をご堪能ください！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419175&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c7dcd64-c6a8-48e7-8258-8db9952f94dc\', \'multiverseId\': 419175}, \'multiverseid\': 419175}, {\'name\': \'박람회 전령\', \'text\': \'박람회 전령이 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+1을 받는다.\', \'type\': \'생물 — 인간\', \'flavor\': \'"모두 환영합니다! 이쪽으로 오십시오! 발명 박람회에 전시된 기발한 물건들에 눈과 귀를 열고 상상의 나래를 펴십시오!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419439&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eb063273-65a5-47b8-9214-1b1afe014b6b\', \'multiverseId\': 419439}, \'multiverseid\': 419439}, {\'name\': \'Arauto da Feira\', \'text\': \'Quando Arauto da Feira entra no campo de batalha, a criatura alvo que você controla recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Humano\', \'flavor\': \'"Sejam todos bem-vindos! Por aqui! Abram seus olhos, seus ouvidos e sua imaginação para as maravilhas da Feira dos Inventores!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419703&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50c25b91-4451-4f79-a145-5f5c2abd1946\', \'multiverseId\': 419703}, \'multiverseid\': 419703}, {\'name\': \'Ярмарочный Зазывала\', \'text\': \'Когда Ярмарочный Зазывала выходит на поле битвы, целевое существо под вашим контролем получает +1/+1 до конца хода.\', \'type\': \'Существо — Человек\', \'flavor\': \'«Добро пожаловать, добро пожаловать! Скорее, проходите! Откройте свои глаза, уши и воображение чудесам Ярмарки Изобретателей!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419967&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a234f142-187d-4e8c-a73e-6f0307ef0728\', \'multiverseId\': 419967}, \'multiverseid\': 419967}, {\'name\': \'博览会传令\', \'text\': \'当博览会传令进战场时，目标由你操控的生物得+1/+1直到回合结束。\', \'type\': \'生物～人类\', \'flavor\': \'「各位，欢迎光临！请走这边！拭目细看，倾耳细听，发挥想像，尽赏发明家博览会的奇技！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417855&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'924f6d88-8c1d-4fe2-b3b3-31d8da0d83c6\', \'multiverseId\': 417855}, \'multiverseid\': 417855}, {\'name\': \'博覽會傳令\', \'text\': \'當博覽會傳令進戰場時，目標由你操控的生物得+1/+1直到回合結束。\', \'type\': \'生物～人類\', \'flavor\': \'「各位，歡迎光臨！請走這邊！拭目細看，傾耳細聽，發揮想像，盡賞發明家博覽會的奇技！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418119&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f141627c-6bb8-48ef-85eb-5dbd2e81e925\', \'multiverseId\': 418119}, \'multiverseid\': 418119}]', '[{\'name\': \'Herunterholen\', \'text\': \'Bestimme eines —\\n• Herunterholen fügt einer fliegenden Kreatur deiner Wahl 4 Schadenspunkte zu.\\n• Herunterholen fügt jeder fliegenden Kreatur 1 Schadenspunkt zu.\', \'type\': \'Hexerei\', \'flavor\': \'Der Sceada war schnell. Der Pfeil war schneller.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2fbb940f-6f94-4912-a3b5-ed9f33936c98\', \'multiverseId\': 418535}, \'multiverseid\': 418535}, {\'name\': \'Derribar\', \'text\': \'Elige uno:\\n• Derribar hace 4 puntos de daño a la criatura objetivo con la habilidad de volar.\\n• Derribar hace 1 punto de daño a cada criatura con la habilidad de volar.\', \'type\': \'Conjuro\', \'flavor\': \'El draco voló certero. La flecha lo hizo aún más.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420383&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4aed180-8b1e-4170-bd32-68c4abb0a48d\', \'multiverseId\': 420383}, \'multiverseid\': 420383}, {\'name\': \'Abattre\', \'text\': "Choisissez l\'un —\\n• Abattre inflige 4 blessures à la créature avec le vol ciblée.\\n• Abattre inflige 1 blessure à chaque créature avec le vol.", \'type\': \'Rituel\', \'flavor\': \'Le drakôn volait avec aplomb. La flèche fila à plomb.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418799&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a191ea6-56bc-47c8-bdfa-6882beed0103\', \'multiverseId\': 418799}, \'multiverseid\': 418799}, {\'name\': \'Atterrare\', \'text\': \'Scegli uno —\\n• Atterrare infligge 4 danni a una creatura bersaglio con volare.\\n• Atterrare infligge 1 danno a ogni creatura con volare.\', \'type\': \'Stregoneria\', \'flavor\': \'Il draghetto volava lesto, ma non quanto la freccia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419063&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6448ba6f-f7cc-4c65-8176-7178d724e1cb\', \'multiverseId\': 419063}, \'multiverseid\': 419063}, {\'name\': \'撃墜\', \'text\': \'以下から１つを選ぶ。\\n• 飛行を持つクリーチャー１体を対象とする。撃墜はそれに４点のダメージを与える。\\n• 撃墜は飛行を持つ各クリーチャーにそれぞれ１点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'ドレイクが真直ぐに飛んでいた。矢も真直ぐに飛んでいった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419327&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fbf2234f-43de-4027-8e1e-6b845b480c3d\', \'multiverseId\': 419327}, \'multiverseid\': 419327}, {\'name\': \'격추\', \'text\': \'하나를 선택한다 —\\n• 비행을 가진 생물을 목표로 정한다. 격추는 그 생물에게 피해 4점을 입힌다.\\n• 격추는 비행을 가진 각 생물에게 피해 1점을 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'드레이크는 똑바로 날아간다. 화살은 더 똑바로 날아간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419591&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'53addff1-de2d-4c6a-988f-bea411fb77d3\', \'multiverseId\': 419591}, \'multiverseid\': 419591}, {\'name\': \'Abater\', \'text\': \'Escolha um —\\n• Abater causa 4 pontos de dano à criatura alvo com voar.\\n• Abater causa 1 ponto de dano a cada criatura com voar.\', \'type\': \'Feitiço\', \'flavor\': \'O voo do dragonete foi perfeito. O da flecha foi mais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419855&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cabd3e5f-19a0-485c-ac80-452652c4f1cf\', \'multiverseId\': 419855}, \'multiverseid\': 419855}, {\'name\': \'Сбить\', \'text\': \'Выберите одно —\\n• Сбить наносит 4 повреждения целевому существу с Полетом.\\n• Сбить наносит 1 повреждение каждому существу с Полетом.\', \'type\': \'Волшебство\', \'flavor\': \'Дрейк летел быстро. Стрела летела быстрее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420119&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'74e9fe93-94f7-40a5-bc55-48d632b99a6b\', \'multiverseId\': 420119}, \'multiverseid\': 420119}, {\'name\': \'击落\', \'text\': \'选择一项～\\n•击落对目标具飞行异能的生物造成4点伤害。\\n•击落对每个具飞行异能的生物各造成1点伤害。\', \'type\': \'法术\', \'flavor\': \'龙兽飞得稳。箭射得更稳。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418007&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f64ede9f-d0b3-4182-817b-d39ad968bea7\', \'multiverseId\': 418007}, \'multiverseid\': 418007}, {\'name\': \'擊落\', \'text\': \'選擇一項～\\n•擊落對目標具飛行異能的生物造成4點傷害。\\n•擊落對每個具飛行異能的生物各造成1點傷害。\', \'type\': \'巫術\', \'flavor\': \'龍獸飛得穩。箭射得更穩。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418271&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a6c8fd7a-04d7-423b-b894-cb24a5cde1f1\', \'multiverseId\': 418271}, \'multiverseid\': 418271}]', '[{\'name\': \'Himmelfahrender Reisender\', \'text\': \'Fliegend, verursacht Trampelschaden\\nImmer wenn der Himmelfahrende Reisende einem Spieler Kampfschaden zufügt, erhältst du entsprechend viele {E} (Energiemarken).\', \'type\': \'Kreatur — Vedalken, Späher\', \'flavor\': \'„Jahrelang studierte ich die Äthersphäre aus der Distanz, aber erst als ich den Äther berührte, spürte ich die Kraft, die dem wirbelnden Himmel innewohnt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418545&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8a5a323-6c6d-4408-b91a-a7ebb045c809\', \'multiverseId\': 418545}, \'multiverseid\': 418545}, {\'name\': \'Viajero empíreo\', \'text\': \'Vuela, arrolla.\\nSiempre que el Viajero empíreo haga daño de combate a un jugador, obtienes esa misma cantidad de {E} (contadores de energía).\', \'type\': \'Criatura — Explorador vedalken\', \'flavor\': \'"Durante años estudié la eteresfera desde lejos, pero hasta que no toqué el éter por mí mismo, no supe cuánto poder contenían aquellos torbellinos celestes".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420393&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec7bb02c-153e-4b03-a77e-6d24a1dcbc6e\', \'multiverseId\': 420393}, \'multiverseid\': 420393}, {\'name\': \'Pérégrin empyréen\', \'text\': \'Vol, piétinement\\nÀ chaque fois que le Pérégrin empyréen inflige des blessures de combat à un joueur, vous gagnez autant de {E} (marqueurs « énergie »).\', \'type\': \'Créature : vedalken et éclaireur\', \'flavor\': "« J\'ai étudié l\'Éthersphère de loin pendant des années, mais ce n\'est qu\'en touchant l\'Éther de mes propres doigts que j\'ai compris le pouvoir des tourbillons célestes. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418809&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f375b87c-f0d3-4fec-b797-17ab189fb9fe\', \'multiverseId\': 418809}, \'multiverseid\': 418809}, {\'name\': \'Viaggiatore Empireo\', \'text\': \'Volare, travolgere\\nOgniqualvolta il Viaggiatore Empireo infligge danno da combattimento a un giocatore, ottieni altrettanti {E} (segnalini energia).\', \'type\': \'Creatura — Esploratore Vedalken\', \'flavor\': \'"Per anni ho studiato l\\\'etersfera da lontano, ma solo toccando con mano l\\\'etere ho compreso il potere contenuto in quel cielo vorticante."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9036306e-cef2-40b9-a119-f7eef29c5afe\', \'multiverseId\': 419073}, \'multiverseid\': 419073}, {\'name\': \'崇高な飛行士\', \'text\': \'飛行、トランプル\\n崇高な飛行士がプレイヤー１人に戦闘ダメージを与えるたび、あなたはその点数に等しい数の{E}（エネルギー・カウンター）を得る。\', \'type\': \'クリーチャー — ヴィダルケン・スカウト\', \'flavor\': \'「私は何年も霊気圏を遠くから研究していたが、自分で霊気に触れて初めて、渦巻く空が内包する力を理解できた。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419337&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47ced048-5140-4fe1-bc35-bb8564103ef4\', \'multiverseId\': 419337}, \'multiverseid\': 419337}, {\'name\': \'천공의 여행자\', \'text\': \'비행, 돌진\\n천공의 여행자가 플레이어에게 전투피해를 입힐 때마다, 당신은 그 전투피해만큼 {E}(에너지 카운터)를 얻는다.\', \'type\': \'생물 — 베달켄 정찰병\', \'flavor\': \'"그렇게 오랫동안 멀리서 에테르권을 연구했지만, 에테르를 실제로 만져보고 나서야 소용돌이치는 하늘에 담긴 진짜 힘을 알게 되었습니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419601&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'acf2a6f7-9761-4920-b01c-f699f41ed9cc\', \'multiverseId\': 419601}, \'multiverseid\': 419601}, {\'name\': \'Viajante Empíreo\', \'text\': \'Voar, atropelar\\nToda vez que Viajante Empíreo causa dano de combate a um jogador, você recebe uma quantidade equivalente de {E} (marcadores de energia).\', \'type\': \'Criatura — Vedalkeano Batedor\', \'flavor\': \'"Por anos, eu estudei a eteresfera de longe, mas apenas quando toquei o éter pessoalmente percebi o poder contido no céu turbilhonante."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419865&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44dd16a1-8160-4605-a9b2-b3f24d3c2e53\', \'multiverseId\': 419865}, \'multiverseid\': 419865}, {\'name\': \'Небесный Путешественник\', \'text\': \'Полет, Пробивной удар\\nКаждый раз, когда Небесный Путешественник наносит игроку боевые повреждения, вы получаете столько же {E} (жетонов энергии).\', \'type\': \'Существо — Ведалкен Разведчик\', \'flavor\': \'«Я много лет изучал эфиросферу издалека, но лишь прикоснувшись к эфиру своими руками, познал мощь, скрытую в небесных вихрях».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420129&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'efbb05e9-a358-4040-888e-df0513ae5d8a\', \'multiverseId\': 420129}, \'multiverseid\': 420129}, {\'name\': \'苍天旅人\', \'text\': \'飞行，践踏\\n每当苍天旅人对任一牌手造成战斗伤害时，你得到等量的{E}（能量指示物）。\', \'type\': \'生物～维多肯／斥候\', \'flavor\': \'「我多年来都从远方钻研乙太层，但是直到亲自触碰了乙太，我才领悟到乙太漫旋的天空所蕴含之力量。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418017&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54fb584c-e360-4c19-87bd-749e982965de\', \'multiverseId\': 418017}, \'multiverseid\': 418017}, {\'name\': \'蒼天旅人\', \'text\': \'飛行，踐踏\\n每當蒼天旅人對任一玩家造成戰鬥傷害時，你得到等量的{E}（能量指示物）。\', \'type\': \'生物～維多肯／斥候\', \'flavor\': \'「我多年來都從遠方鑽研乙太層，但是直到親自觸碰了乙太，我才領悟到乙太漫旋的天空所蘊含之力量。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418281&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a7323dbf-6ff0-4330-ba09-d2467b24f90d\', \'multiverseId\': 418281}, \'multiverseid\': 418281}]', '[{\'name\': \'Himmelsfürst, Flaggschiff des Konsuls\', \'text\': \'Fliegend\\nImmer wenn Himmelsfürst, Flaggschiff des Konsuls, ins Spiel kommt oder angreift, fügt es einer Kreatur oder einem Planeswalker deiner Wahl, die bzw. den ein Gegner kontrolliert, 3 Schadenspunkte zu.\\nBemannen 3 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 3 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Legendäres Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418599&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d317718f-f6cc-467c-a98e-5ad9063f9fb3\', \'multiverseId\': 418599}, \'multiverseid\': 418599}, {\'name\': \'Soberano Celeste, Buque del Cónsul\', \'text\': \'Vuela.\\nSiempre que Soberano Celeste, Buque del Cónsul entre al campo de batalla o ataque, hace 3 puntos de daño a la criatura o planeswalker objetivo que controla un oponente.\\nTripular 3. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 3 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto legendario — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c950fde7-a957-4243-9bb4-336ac9ce1e39\', \'multiverseId\': 420447}, \'multiverseid\': 420447}, {\'name\': \'Souverain des cieux, navire amiral du consul\', \'text\': "Vol\\nÀ chaque fois que le Souverain des cieux, navire amiral du consul arrive sur le champ de bataille ou attaque, il inflige 3 blessures à une créature ciblée ou un planeswalker ciblé qu\'un adversaire contrôle.\\nPilotage 3 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 3 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact légendaire : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418863&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94c87c76-2aad-4fa6-b632-398345911a4c\', \'multiverseId\': 418863}, \'multiverseid\': 418863}, {\'name\': \'Sovrana Celeste, Ammiraglia dei Consoli\', \'text\': \'Volare\\nOgniqualvolta la Sovrana Celeste, Ammiraglia dei Consoli entra nel campo di battaglia o attacca, infligge 3 danni a una creatura o a un planeswalker bersaglio controllati da un avversario.\\nManovrare 3 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 3: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)\', \'type\': \'Artefatto Leggendario — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419127&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8c618e35-12d9-4f85-8f8f-414a61cd3c60\', \'multiverseId\': 419127}, \'multiverseid\': 419127}, {\'name\': \'領事の旗艦、スカイソブリン\', \'text\': \'飛行\\n領事の旗艦、スカイソブリンが戦場に出るか攻撃するたび、対戦相手がコントロールするクリーチャー１体かプレインズウォーカー１体を対象とする。領事の旗艦、スカイソブリンはそれに３点のダメージを与える。\\n搭乗３（あなたがコントロールする望む数のクリーチャーを、パワーの合計が３以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'伝説のアーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419391&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae603af9-772a-43f0-99a1-8459146a46a5\', \'multiverseId\': 419391}, \'multiverseid\': 419391}, {\'name\': \'영사관 함선, 창공의 지배자\', \'text\': \'비행\\n영사관 함선, 창공의 지배자가 전장에 들어오거나 공격할 때마다, 상대가 조종하는 생물 또는 플레인즈워커를 목표로 정한다. 창공의 지배자는 그 목표에게 피해 3점을 입힌다.\\n탑승 3 (당신이 조종하는 생물을 공격력 총합이 3 이상이 되도록 원하는 수만큼 탭한다: 이 탑승물은 턴종료까지 마법물체 생물이 된다.)\', \'type\': \'전설적 마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419655&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8bde1672-fc51-41f2-94e0-4356da399699\', \'multiverseId\': 419655}, \'multiverseid\': 419655}, {\'name\': \'Soberana Celeste, Capitânia do Cônsul\', \'text\': \'Voar\\nToda vez que Soberana Celeste, Capitânia do Cônsul, entra no campo de batalha ou ataca, ela causa 3 pontos de dano à criatura ou ao planeswalker alvo que um oponente controla.\\nTripular 3 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 3: Este Veículo se torna uma criatura artefato até o final do turno.)\', \'type\': \'Artefato Lendário — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419919&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4337ade9-2c11-43c4-b294-542d7f68d3d8\', \'multiverseId\': 419919}, \'multiverseid\': 419919}, {\'name\': \'Флагман «Небесный Владыка»\', \'text\': \'Полет\\nКаждый раз, когда Флагман «Небесный Владыка» выходит на поле битвы или атакует, он наносит 3 повреждения целевому существу или planeswalker-у под контролем оппонента.\\nЭкипаж 3 (Поверните любое количество существ под вашим контролем с суммарной силой 3 или более: эта Машина становится артефактом существом до конца хода.)\', \'type\': \'Легендарный Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420183&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17e18824-2da1-472c-afcf-ce2b4ce33a1d\', \'multiverseId\': 420183}, \'multiverseid\': 420183}, {\'name\': \'执政官旗舰云威号\', \'text\': \'飞行\\n每当执政官旗舰云威号进战场或攻击时，它向目标由对手操控的生物或鹏洛客造成3点伤害。\\n搭载3（横置任意数量由你操控且力量总和等于或大于3的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'传奇神器～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418071&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'75d2704f-1227-4db4-9365-158903fec87b\', \'multiverseId\': 418071}, \'multiverseid\': 418071}, {\'name\': \'執政官旗艦雲威號\', \'text\': \'飛行\\n每當執政官旗艦雲威號進戰場或攻擊時，它向目標由對手操控的生物或鵬洛客造成3點傷害。\\n搭載3（橫置任意數量由你操控且力量總和等於或大於3的生物：此載具成為神器生物直到回合結束。）\', \'type\': \'傳奇神器～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418335&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'691249f3-3b42-433a-bdfc-979801845688\', \'multiverseId\': 418335}, \'multiverseid\': 418335}]', '[{\'name\': \'Himmelssog-Habicht\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Die großen Vögel gleiten durch den Himmel, getragen vom Ätherstrom, um sich auf arglose Beute herabzustürzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418393&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8ffbdfc7-200e-4c4f-b8dc-ce394dbe7f7b\', \'multiverseId\': 418393}, \'multiverseid\': 418393}, {\'name\': \'Aguilucho plumarrizada\', \'text\': \'Vuela.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Las grandes rapaces sobrevuelan el cielo, surcando las corrientes de éter con sus alas, para dejarse caer sobre una presa desprevenida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420241&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c29b4cc5-d454-42e3-b2e1-3ab4ece70bfd\', \'multiverseId\': 420241}, \'multiverseid\': 420241}, {\'name\': \'Busard des turbulences\', \'text\': \'Vol\', \'type\': \'Créature : oiseau\', \'flavor\': "Leurs ailes frôlant les flux d\'Éther, les grands rapaces descendent en piqué et fondent sur leur proie peu méfiante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418657&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66642efb-932b-4e48-947a-f7f066105f52\', \'multiverseId\': 418657}, \'multiverseid\': 418657}, {\'name\': \'Rapace Aviovorticante\', \'text\': \'Volare\', \'type\': \'Creatura — Uccello\', \'flavor\': \'I grandi uccelli scendono in picchiata dal cielo, accarezzando con le ali i flussi di etere, per abbattersi sulle prede ignare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418921&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d396d5d-3e34-4a80-a515-3311f841eff9\', \'multiverseId\': 418921}, \'multiverseid\': 418921}, {\'name\': \'空渦鷹\', \'text\': \'飛行\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'その大きな鳥は空から急降下し、翼で霊気の流れに乗りながら、何も気付かない獲物に襲いかかる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419185&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb13466d-fe43-4e5d-86a1-5a64fc3b1225\', \'multiverseId\': 419185}, \'multiverseid\': 419185}, {\'name\': \'하늘소용돌이 사냥꾼\', \'text\': \'비행\', \'type\': \'생물 — 조류\', \'flavor\': \'거대한 새들은 에테르 기류를 타고 급강하해서 아직 눈치채지 못한 사냥감을 덮친다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419449&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1a7a32eb-676b-419c-8bd0-705dd37b9141\', \'multiverseId\': 419449}, \'multiverseid\': 419449}, {\'name\': \'Gavião do Redemoinho\', \'text\': \'Voar\', \'type\': \'Criatura — Ave\', \'flavor\': \'As grandes aves descem dos céus num mergulho turbilhonante para abocanhar suas presas desavisadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419713&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'834d6615-21a8-4531-9918-c5ddb872d26f\', \'multiverseId\': 419713}, \'multiverseid\': 419713}, {\'name\': \'Лунь Завихрений\', \'text\': \'Полет\', \'type\': \'Существо — Птица\', \'flavor\': \'Широко раскинув крылья, эти великие птицы парят на эфирных потоках и молниеносно пикируют на ничего не подозревающую жертву.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419977&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'12064d01-4541-4468-ada5-4c9219bfc43e\', \'multiverseId\': 419977}, \'multiverseid\': 419977}, {\'name\': \'旋空鹞鹰\', \'text\': \'飞行\', \'type\': \'生物～鸟\', \'flavor\': \'巨鸟自天空俯冲而下，羽翼掠过乙太流，攫走猝不及防的猎物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417865&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'42d5bfc3-e055-493c-bf08-c9f84b34f355\', \'multiverseId\': 417865}, \'multiverseid\': 417865}, {\'name\': \'旋空鷂鷹\', \'text\': \'飛行\', \'type\': \'生物～鳥\', \'flavor\': \'巨鳥自天空俯衝而下，羽翼掠過乙太流，攫走猝不及防的獵物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418129&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82a4362e-799d-4aee-aabb-5f3a863bd9b8\', \'multiverseId\': 418129}, \'multiverseid\': 418129}]', "[{'name': 'Himmelstor des Konsulats', 'text': 'Verteidiger\\nReichweite (Diese Kreatur kann fliegende Kreaturen blocken.)', 'type': 'Artefaktkreatur — Mauer', 'flavor': 'Alle Luftschiffe, die die Messe ansteuern oder sie verlassen, müssen die Sicherheitskontrolle passieren.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418567&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2baab4f1-b7ae-470d-91e4-014d321d60ae', 'multiverseId': 418567}, 'multiverseid': 418567}, {'name': 'Aeropuerta del Consulado', 'text': 'Defensor.\\nAlcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)', 'type': 'Criatura artefacto — Muro', 'flavor': 'Todas las aeronaves que entren en el espacio de la feria o lo abandonen deben pasar por la aduana de seguridad.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420415&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fe879ff2-7a02-4f60-a766-431204d87e97', 'multiverseId': 420415}, 'multiverseid': 420415}, {'name': 'Porte aérienne du consulat', 'text': 'Défenseur\\nPortée (Cette créature peut bloquer les créatures avec le vol.)', 'type': 'Créature-artefact : mur', 'flavor': 'Tous les vaisseaux volants qui accèdent au champ de foire ou en partent doivent passer par le poste de sécurité.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418831&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b553a5dd-ddd2-4335-8da7-610e8e9ce594', 'multiverseId': 418831}, 'multiverseid': 418831}, {'name': 'Avioportale del Consolato', 'text': 'Difensore\\nRaggiungere (Questa creatura può bloccare le creature con volare.)', 'type': 'Creatura Artefatto — Muro', 'flavor': 'Tutte le avionavi in arrivo e in partenza dalla Fiera devono superare i controlli di sicurezza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419095&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a870a802-7e83-41b8-ad51-fd4d2c2a7e2d', 'multiverseId': 419095}, 'multiverseid': 419095}, {'name': '領事府の空船口', 'text': '防衛\\n到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）', 'type': 'アーティファクト・クリーチャー — 壁', 'flavor': '博覧会場に出入りする航空船は、保安検問を通過する必要がある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419359&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '78f66700-1376-4f7f-801a-75f776b69783', 'multiverseId': 419359}, 'multiverseid': 419359}, {'name': '영사관 하늘관문', 'text': '수비태세\\n대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)', 'type': '마법물체 생물 — 벽', 'flavor': '박람회장을 출입하는 모든 비행선은 보안 검색소를 통과해야 한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419623&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '72eb5056-6e57-455d-a616-40d0c2f5ef85', 'multiverseId': 419623}, 'multiverseid': 419623}, {'name': 'Portão Aéreo do Consulado', 'text': 'Defensor\\nAlcance (Esta criatura pode bloquear criaturas com voar.)', 'type': 'Criatura Artefato — Barreira', 'flavor': 'Todas as aeronaus que entram e saem da feira precisam passar pela cancela da segurança.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419887&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fc57f5c6-c488-4965-a08a-be8f1f6d0561', 'multiverseId': 419887}, 'multiverseid': 419887}, {'name': 'Небесные Врата Консульства', 'text': 'Защитник\\nЗахват (Это существо может блокировать существа с Полетом.)', 'type': 'Артефакт Существо — Стена', 'flavor': 'Все небесные корабли, следующие на территорию Ярмарки или с нее, должны пройти через сторожевой пост.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420151&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3b612c40-31e4-4033-987f-f3d1e834a1a0', 'multiverseId': 420151}, 'multiverseid': 420151}, {'name': '执政院空闸', 'text': '守军\\n延势（此生物能阻挡具飞行异能的生物。）', 'type': '神器生物～墙', 'flavor': '所有进出展区的飞船都必须由安检口通行。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418039&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e2c20121-a58e-4416-a8db-3bd82e0bbf7f', 'multiverseId': 418039}, 'multiverseid': 418039}, {'name': '執政院空閘', 'text': '守軍\\n延勢（此生物能阻擋具飛行異能的生物。）', 'type': '神器生物～牆', 'flavor': '所有進出展區的飛船都必須由安檢口通行。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418303&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9f0a0738-f098-4e30-b1c7-b6f0fc04cc7d', 'multiverseId': 418303}, 'multiverseid': 418303}]", '[{\'name\': \'Hinterlistige Pläne\', \'text\': \'Immer wenn ein Artefakt unter deiner Kontrolle ins Spiel kommt, kannst du {1} bezahlen. Falls du dies tust, verliert jeder Gegner 1 Lebenspunkt, und du erhältst 1 Lebenspunkt dazu.\\n{1}{B}, opfere die Hinterlistigen Pläne: Zerstöre eine Kreatur deiner Wahl. Aktiviere diese Fähigkeit nur, falls du zwei oder mehr Artefakte kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418469&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc855886-c1d4-4b93-af00-7e2356d01788\', \'multiverseId\': 418469}, \'multiverseid\': 418469}, {\'name\': \'Planes turbios\', \'text\': \'Siempre que un artefacto entre al campo de batalla bajo tu control, puedes pagar {1}. Si lo haces, cada oponente pierde 1 vida y tú ganas 1 vida.\\n{1}{B}, sacrificar los Planes turbios: Destruye la criatura objetivo. Activa esta habilidad solo si controlas dos o más artefactos.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420317&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf2344b7-41a0-4edd-9f92-59138e3a527f\', \'multiverseId\': 420317}, \'multiverseid\': 420317}, {\'name\': \'Motifs sournois\', \'text\': "À chaque fois qu\'un artefact arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {1}. Si vous faites ainsi, chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.\\n{1}{B}, sacrifiez les Motifs sournois : Détruisez une créature ciblée. N\'activez cette capacité que si vous contrôlez au moins deux artefacts.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418733&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bee03d8-d74c-473e-af50-1b748df0b98b\', \'multiverseId\': 418733}, \'multiverseid\': 418733}, {\'name\': \'Propositi Subdoli\', \'text\': \'Ogniqualvolta un artefatto entra nel campo di battaglia sotto il tuo controllo, puoi pagare {1}. Se lo fai, ogni avversario perde 1 punto vita e tu guadagni 1 punto vita.\\n{1}{B}, Sacrifica i Propositi Subdoli: Distruggi una creatura bersaglio. Attiva questa abilità solo se controlli due o più artefatti.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418997&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d47b8c6-14df-4334-b149-50c927b40c2d\', \'multiverseId\': 418997}, \'multiverseid\': 418997}, {\'name\': \'奥の手\', \'text\': \'アーティファクトが１つあなたのコントロール下で戦場に出るたび、あなたは{1}を支払ってもよい。そうしたなら、各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\\n{1}{B}, 奥の手を生け贄に捧げる：クリーチャー１体を対象とし、それを破壊する。この能力は、あなたがアーティファクトを２つ以上コントロールしているときにのみ起動できる。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419261&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae22c227-b8e2-46c4-89a3-74122302d968\', \'multiverseId\': 419261}, \'multiverseid\': 419261}, {\'name\': \'비열한 계획\', \'text\': \'마법물체가 당신의 조종하에 전장에 들어올 때마다, 당신은 {1}을 지불할 수 있다. 그렇게 한다면, 각 상대는 생명 1점을 잃고 당신은 생명 1점을 얻는다.\\n{1}{B}, 비열한 계획을 희생한다: 생물을 목표로 정한다. 그 생물을 파괴한다. 이 능력은 당신이 마법물체를 두 개 이상 조종할 때에만 활성화할 수 있다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419525&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7de7c3f9-9861-4f5e-9356-0f646decf12d\', \'multiverseId\': 419525}, \'multiverseid\': 419525}, {\'name\': \'Projetos Clandestinos\', \'text\': \'Toda vez que um artefato entra no campo de batalha sob seu controle, você pode pagar {1}. Se fizer isso, cada oponente perderá 1 ponto de vida e você ganhará 1 ponto de vida.\\n{1}{B}, Sacrifique Projetos Clandestinos: Destrua a criatura alvo. Ative esta habilidade somente se você controlar dois ou mais artefatos.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419789&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e06ce7b5-15dd-4e26-97fa-2f45b074e9d9\', \'multiverseId\': 419789}, \'multiverseid\': 419789}, {\'name\': \'Закулисные Замыслы\', \'text\': \'Каждый раз, когда артефакт выходит на поле битвы под вашим контролем, вы можете заплатить {1}. Если вы это делаете, каждый оппонент теряет 1 жизнь, а вы получаете 1 жизнь.\\n{1}{B}, пожертвуйте Закулисные Замыслы: уничтожьте целевое существо. Активируйте эту способность, только если вы контролируете не менее двух артефактов.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420053&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fdaa7a43-2fc9-46e9-9ea8-a116b7cef910\', \'multiverseId\': 420053}, \'multiverseid\': 420053}, {\'name\': \'暗中设局\', \'text\': \'每当一个神器在你的操控下进战场时，你可以支付{1}。若你如此作，则每位对手各失去1点生命且你获得1点生命。\\n{1}{B}，牺牲暗中设局：消灭目标生物。只能于你操控两个或更多神器时起动此异能。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417941&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9721ccf8-df50-48e2-a1de-20729f4d6e68\', \'multiverseId\': 417941}, \'multiverseid\': 417941}, {\'name\': \'暗中設局\', \'text\': \'每當一個神器在你的操控下進戰場時，你可以支付{1}。若你如此作，則每位對手失去1點生命且你獲得1點生命。\\n{1}{B}，犧牲暗中設局：消滅目標生物。只能於你操控兩個或更多神器時起動此異能。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418205&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0c31b757-1f75-4f65-8040-1acfa63f3cde\', \'multiverseId\': 418205}, \'multiverseid\': 418205}]', '[{\'name\': \'Hirnverbranntes Experiment\', \'text\': \'Decke Karten oben von deiner Bibliothek auf, bis du eine Artefaktkarte aufdeckst. Bringe die Karte ins Spiel und lege den Rest in zufälliger Reihenfolge unter deine Bibliothek. Das Hirnverbrannte Experiment fügt dir Schaden in Höhe der Anzahl der auf diese Weise aufgedeckten Karten zu.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418487&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'093fbca4-4da6-4915-bccc-912e9d17b6f2\', \'multiverseId\': 418487}, \'multiverseid\': 418487}, {\'name\': \'Experimento descabellado\', \'text\': \'Muestra cartas de la parte superior de tu biblioteca hasta que muestres una carta de artefacto. Pon esa carta en el campo de batalla y el resto en el fondo de tu biblioteca en un orden aleatorio. El Experimento descabellado te hace una cantidad de daño igual a las cartas mostradas de esta manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81d6a6d8-86af-477c-93e2-e4bde5d972c4\', \'multiverseId\': 420335}, \'multiverseid\': 420335}, {\'name\': \'Expérience de tête brûlée\', \'text\': "Révélez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous révéliez une carte d\'artefact. Mettez cette carte sur le champ de bataille et le reste au-dessous de votre bibliothèque dans un ordre aléatoire. L\'Expérience de tête brûlée vous inflige un nombre de blessures égal au nombre de cartes révélées de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5ad97f8-2d5a-459d-a6e3-f534a2947060\', \'multiverseId\': 418751}, \'multiverseid\': 418751}, {\'name\': \'Esperimento da Testa Calda\', \'text\': "Rivela carte dalla cima del tuo grimorio finché non riveli una carta artefatto. Metti quella carta sul campo di battaglia e il resto in fondo al tuo grimorio in ordine casuale. L\'Esperimento da Testa Calda ti infligge danno pari al numero di carte rivelate in questo modo.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'500fda19-c28d-4ff9-9c8c-5f886ab68d35\', \'multiverseId\': 419015}, \'multiverseid\': 419015}, {\'name\': \'向こう見ずな実験\', \'text\': \'アーティファクト・カードが公開されるまで、あなたのライブラリーの一番上からカードを１枚ずつ公開する。そのカードを戦場に出し、残りをあなたのライブラリーの一番下に無作為の順番で置く。向こう見ずな実験はあなたに、これにより公開されたカードの枚数に等しい点数のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419279&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8cc01106-0078-4044-9679-835149864be9\', \'multiverseId\': 419279}, \'multiverseid\': 419279}, {\'name\': \'무모한 실험\', \'text\': \'마법물체 카드가 공개될 때까지 당신의 서고 맨 위의 카드를 공개한다. 그 카드를 전장에 놓고 나머지 카드들은 당신의 서고 맨 밑에 무작위로 놓는다. 무모한 실험은 이런 식으로 공개된 카드 수만큼 당신에게 피해를 입힌다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419543&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0b892fbc-b5ff-4b81-98b3-1ae084bdd4d3\', \'multiverseId\': 419543}, \'multiverseid\': 419543}, {\'name\': \'Experimento Inconsequente\', \'text\': \'Revele cards do topo de seu grimório até revelar um card de artefato. Coloque aquele card no campo de batalha e o restante no fundo de seu grimório em ordem aleatória. Experimento Inconsequente causa a você uma quantidade de dano igual ao número de cards revelados desta forma.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419807&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a8ee9db-0e97-411f-9f06-bf9bce5d4198\', \'multiverseId\': 419807}, \'multiverseid\': 419807}, {\'name\': \'Сумасбродный Эксперимент\', \'text\': \'Показывайте карты с верха вашей библиотеки, пока вы не покажете карту артефакта. Положите ту карту на поле битвы, а остальные в низ вашей библиотеки в случайном порядке. Сумасбродный Эксперимент наносит вам повреждения, равные количеству карт, показанных таким образом.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420071&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e33f7bd-d7f2-42b5-9948-d697fb0538ab\', \'multiverseId\': 420071}, \'multiverseid\': 420071}, {\'name\': \'鲁莽实验\', \'text\': \'从你牌库顶开始展示牌，直到你展示出一张神器牌为止。将该牌放进战场，并将其余的牌以随机顺序置于你的牌库底。鲁莽实验对你造成等同于以此法所展示之牌数量的伤害。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417959&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8066d2f9-1022-4f87-a1af-4b5a72dd4712\', \'multiverseId\': 417959}, \'multiverseid\': 417959}, {\'name\': \'魯莽實驗\', \'text\': \'從你牌庫頂開始展示牌，直到你展示出一張神器牌為止。將該牌放進戰場，並將其餘的牌以隨機順序置於你的牌庫底。魯莽實驗對你造成等同於以此法所展示之牌數量的傷害。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418223&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8e358d22-7a33-4926-9b85-81cc9b8c7635\', \'multiverseId\': 418223}, \'multiverseid\': 418223}]', "[{'name': 'Hochturm-Kunsthandwerker', 'text': 'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\nFabrizieren 1 (Wenn diese Kreatur ins Spiel kommt, lege eine +1/+1-Marke auf sie oder erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.)', 'type': 'Kreatur — Elf, Handwerker', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418522&type=card', 'language': 'German', 'identifiers': {'scryfallId': '36b5e35f-a194-445d-b676-14bc771556dc', 'multiverseId': 418522}, 'multiverseid': 418522}, {'name': 'Artesano de cumbralta', 'text': 'Alcance. (Esta criatura puede bloquear criaturas con la habilidad de volar.)\\nFabricar 1. (Cuando esta criatura entre al campo de batalla, pon un contador +1/+1 sobre ella o crea una ficha de criatura artefacto Servo incolora 1/1.)', 'type': 'Criatura — Artífice elfo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420370&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6e49963e-5e19-41e9-8bc5-38a1cc6b2209', 'multiverseId': 420370}, 'multiverseid': 420370}, {'name': 'Artisan de hautecime', 'text': 'Portée (Cette créature peut bloquer les créatures avec le vol.)\\nFabrication 1 (Quand cette créature arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle ou créez un jeton de créature-artefact 1/1 incolore Servo.)', 'type': 'Créature : elfe et artificier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418786&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd58e3f57-bb7c-4ba3-9534-73ae105339f6', 'multiverseId': 418786}, 'multiverseid': 418786}, {'name': 'Artigiano di Altaguglia', 'text': 'Raggiungere (Questa creatura può bloccare le creature con volare.)\\nFabbrica 1 (Quando questa creatura entra nel campo di battaglia, metti un segnalino +1/+1 su di essa o crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.)', 'type': 'Creatura — Artefice Elfo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419050&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '159fc5a2-1d23-41e8-955f-4f59e1224550', 'multiverseId': 419050}, 'multiverseid': 419050}, {'name': '高峰の職工', 'text': '到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\\n製造１（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを１個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。）', 'type': 'クリーチャー — エルフ・工匠', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419314&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8790a34e-03ef-4ee8-82c0-112d6f101e70', 'multiverseId': 419314}, 'multiverseid': 419314}, {'name': '뾰족봉우리 장인', 'text': '대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\\n제작 1 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 한 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.)', 'type': '생물 — 엘프 기능공', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419578&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'd7ed4e28-9a62-452d-bd9b-e817f04d3e18', 'multiverseId': 419578}, 'multiverseid': 419578}, {'name': 'Artesão dos Espigões', 'text': 'Alcance (Esta criatura pode bloquear criaturas com voar.)\\nFabricar 1 (Quando esta criatura entrar no campo de batalha, coloque um marcador +1/+1 nela ou crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.)', 'type': 'Criatura — Elfo Artesão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419842&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '160332f5-682d-4e2e-b950-d665d77c56f8', 'multiverseId': 419842}, 'multiverseid': 419842}, {'name': 'Мастеровой с Высокого Шпиля', 'text': 'Захват (Это существо может блокировать существа с Полетом.)\\nПроизводство 1 (Когда это существо выходит на поле битвы, положите на него один жетон +1/+1 или создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.)', 'type': 'Существо — Эльф Механик', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420106&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7f4b24a0-9070-488a-8b0b-4ed3874eae62', 'multiverseId': 420106}, 'multiverseid': 420106}, {'name': '峰顶工匠', 'text': '延势（此生物能阻挡具飞行异能的生物。）\\n装配1（当此生物进战场时，在其上放置一个+1/+1指示物或派出一个1/1无色自动机衍生神器生物。）', 'type': '生物～妖精／神器师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417994&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '31a8c235-a2cf-4f02-9094-0fc97ef67746', 'multiverseId': 417994}, 'multiverseid': 417994}, {'name': '峰頂工匠', 'text': '延勢（此生物能阻擋具飛行異能的生物。）\\n裝配1（當此生物進戰場時，在其上放置一個+1/+1指示物或派出一個1/1無色自動機衍生神器生物。）', 'type': '生物～妖精／神器師', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418258&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2307bf59-7715-4eb7-a5ad-2d91f6266747', 'multiverseId': 418258}, 'multiverseid': 418258}]", '[{\'name\': \'Hochwasser-Einsiedlerkrebs\', \'text\': \'Verteidiger\\nWenn der Hochwasser-Einsiedlerkrebs ins Spiel kommt, erhältst du {E}{E}{E}{E} (vier Energiemarken).\\nBezahle {E}{E}: Der Hochwasser-Einsiedlerkrebs kann in diesem Zug angreifen, als ob er nicht Verteidiger hätte.\', \'type\': \'Kreatur — Krabbe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418416&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ddbd5e6-1ad8-4d45-a601-fa709383a5c9\', \'multiverseId\': 418416}, \'multiverseid\': 418416}, {\'name\': \'Ermitaño de marea alta\', \'text\': \'Defensor.\\nCuando el Ermitaño de marea alta entre al campo de batalla, obtienes {E}{E}{E}{E} (cuatro contadores de energía).\\nPagar {E}{E}: El Ermitaño de marea alta puede atacar este turno como si no tuviera la habilidad de defensor.\', \'type\': \'Criatura — Cangrejo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420264&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'446ee802-9164-4dbc-b2d7-589d584acca6\', \'multiverseId\': 420264}, \'multiverseid\': 420264}, {\'name\': "Bernard-l\'ermite du flux", \'text\': "Défenseur\\nQuand le Bernard-l\'ermite du flux arrive sur le champ de bataille, vous gagnez {E}{E}{E}{E} (quatre marqueurs « énergie »).\\nPayez {E}{E} : Le Bernard-l\'ermite du flux peut attaquer ce tour-ci comme s\'il n\'avait pas le défenseur.", \'type\': \'Créature : crabe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418680&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cae7df85-afaf-4302-947d-6acc98d43f49\', \'multiverseId\': 418680}, \'multiverseid\': 418680}, {\'name\': "Paguro dell\'Altamarea", \'text\': "Difensore\\nQuando il Paguro dell\'Altamarea entra nel campo di battaglia, ottieni {E}{E}{E}{E} (quattro segnalini energia).\\nPaga {E}{E}: Il Paguro dell\'Altamarea può attaccare in questo turno come se non avesse difensore.", \'type\': \'Creatura — Granchio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418944&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d995795-a171-41a6-9421-637972e40255\', \'multiverseId\': 418944}, \'multiverseid\': 418944}, {\'name\': \'タカシオヤドカリ\', \'text\': \'防衛\\nタカシオヤドカリが戦場に出たとき、あなたは{E}{E}{E}{E}（エネルギー・カウンター４個）を得る。\\n{E}{E}を支払う：このターン、タカシオヤドカリは防衛を持たないかのように攻撃できる。\', \'type\': \'クリーチャー — カニ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419208&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f4b9d8b9-d943-491d-876b-40043269e4ad\', \'multiverseId\': 419208}, \'multiverseid\': 419208}, {\'name\': \'해변가 은둔자\', \'text\': \'수비태세\\n해변가 은둔자가 전장에 들어올 때, 당신은 {E}{E}{E}{E}(에너지 카운터 네 개)를 얻는다.\\n{E}{E}를 지불한다: 해변가 은둔자는 이 턴에 수비태세가 없는 것처럼 공격할 수 있다.\', \'type\': \'생물 — 게\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419472&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2fedb8fc-ae1e-41a0-bf42-fecbfeaae2b3\', \'multiverseId\': 419472}, \'multiverseid\': 419472}, {\'name\': \'Eremita da Maré Alta\', \'text\': \'Defensor\\nQuando Eremita da Maré Alta entra no campo de batalha, você recebe {E}{E}{E}{E} (quatro marcadores de energia).\\nPague {E}{E}: Eremita da Maré Alta pode atacar neste turno como se não tivesse defensor.\', \'type\': \'Criatura — Caranguejo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419736&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69783135-42e9-4aec-ba48-efefe9423233\', \'multiverseId\': 419736}, \'multiverseid\': 419736}, {\'name\': \'Отшельник Прилива\', \'text\': \'Защитник\\nКогда Отшельник Прилива выходит на поле битвы, вы получаете {E}{E}{E}{E} (четыре жетона энергии).\\nЗаплатите {E}{E}: Отшельник Прилива может атаковать в этом ходу, как если бы у него не было способности Защитника.\', \'type\': \'Существо — Краб\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420000&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7a8cc73-e30c-434e-ab18-75c0bb9cd497\', \'multiverseId\': 420000}, \'multiverseid\': 420000}, {\'name\': \'涨潮寄居蟹\', \'text\': \'守军\\n当涨潮寄居蟹进战场时，你得到{E}{E}{E}{E}（四个能量指示物）。\\n支付{E}{E}：涨潮寄居蟹于本回合中能视同不具守军异能地进行攻击。\', \'type\': \'生物～蟹\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417888&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'48bdd6aa-7ff7-4c4a-adc8-3f6762b60dcd\', \'multiverseId\': 417888}, \'multiverseid\': 417888}, {\'name\': \'漲潮寄居蟹\', \'text\': \'守軍\\n當漲潮寄居蟹進戰場時，你得到{E}{E}{E}{E}（四個能量指示物）。\\n支付{E}{E}：漲潮寄居蟹於本回合中能視同不具守軍異能地進行攻擊。\', \'type\': \'生物～蟹\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418152&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4956abed-3c96-4cf5-ad79-a22dc3c1cd5d\', \'multiverseId\': 418152}, \'multiverseid\': 418152}]', '[{\'name\': \'Holzflechter-Rätselknoten\', \'text\': \'Wenn der Holzflechter-Rätselknoten ins Spiel kommt, erhältst du 3 Lebenspunkte dazu und {E}{E}{E} (drei Energiemarken).\\n{2}{G}, opfere den Holzflechter-Rätselknoten: Du erhältst 3 Lebenspunkte dazu und {E}{E}{E}.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418605&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8cd50db7-e30c-4b83-8ff2-b98012607f64\', \'multiverseId\': 418605}, \'multiverseid\': 418605}, {\'name\': \'Enigma del trenzador de madera\', \'text\': \'Cuando el Enigma del trenzador de madera entre al campo de batalla, ganas 3 vidas y obtienes {E}{E}{E} (tres contadores de energía).\\n{2}{G}, sacrificar el Enigma del trenzador de madera: Ganas 3 vidas y obtienes {E}{E}{E}.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420453&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf382787-22ec-4d60-a081-827353887b88\', \'multiverseId\': 420453}, \'multiverseid\': 420453}, {\'name\': \'Casse-tête du tisseur de bois\', \'text\': \'Quand le Casse-tête du tisseur de bois arrive sur le champ de bataille, vous gagnez 3 points de vie et {E}{E}{E} (trois marqueurs « énergie »).\\n{2}{G}, sacrifiez le Casse-tête du tisseur de bois : Vous gagnez 3 points de vie et {E}{E}{E}.\', \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418869&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e5bf5bc-54c9-4a58-aed0-6425f24b4aba\', \'multiverseId\': 418869}, \'multiverseid\': 418869}, {\'name\': \'Enigmatico del Tessilegno\', \'text\': "Quando l\'Enigmatico del Tessilegno entra nel campo di battaglia, guadagni 3 punti vita e ottieni {E}{E}{E} (tre segnalini energia).\\n{2}{G}, Sacrifica l\'Enigmatico del Tessilegno: Guadagni 3 punti vita e ottieni {E}{E}{E}.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df649a2b-6954-4ebc-9332-b825da965a85\', \'multiverseId\': 419133}, \'multiverseid\': 419133}, {\'name\': \'織木師の組細工\', \'text\': \'織木師の組細工が戦場に出たとき、あなたは３点のライフを得て、{E}{E}{E}（エネルギー・カウンター３個）を得る。\\n{2}{G}, 織木師の組細工を生け贄に捧げる：あなたは３点のライフを得て、{E}{E}{E}を得る。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419397&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed2fae01-428d-4951-be7c-19ae3f7c6c5f\', \'multiverseId\': 419397}, \'multiverseid\': 419397}, {\'name\': \'목조세공인의 비밀 장치\', \'text\': \'목조세공인의 비밀 장치가 전장에 들어올 때, 당신은 생명 3점과 {E}{E}{E}(에너지 카운터 세 개)를 얻는다.\\n{2}{G}, 목조세공인의 비밀 장치를 희생한다: 당신은 생명 3점과 {E}{E}{E}를 얻는다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419661&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fd5097d6-6927-400f-8378-cfa5e7bcae97\', \'multiverseId\': 419661}, \'multiverseid\': 419661}, {\'name\': \'Quebra-cabeça do Lenhotecedor\', \'text\': \'Quando Quebra-cabeça do Lenhotecedor entra no campo de batalha, você ganha 3 pontos de vida e recebe {E}{E}{E} (três marcadores de energia).\\n{2}{G}, Sacrifique Quebra-cabeça do Lenhotecedor: Você ganha 3 pontos de vida e recebe {E}{E}{E}.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419925&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f276c0e-08fe-4774-88ca-a6b210581a05\', \'multiverseId\': 419925}, \'multiverseid\': 419925}, {\'name\': \'Головоломка Древоплета\', \'text\': \'Когда Головоломка Древоплета выходит на поле битвы, вы получаете 3 жизни и {E}{E}{E} (три жетона энергии).\\n{2}{G}, пожертвуйте Головоломку Древоплета: вы получаете 3 жизни и {E}{E}{E}.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420189&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6b9a46d6-bf29-4d00-aa69-d319c93e335b\', \'multiverseId\': 420189}, \'multiverseid\': 420189}, {\'name\': \'塑木师谜结\', \'text\': \'当塑木师谜结进战场时，你获得3点生命且得到{E}{E}{E}（三个能量指示物）。\\n{2}{G}，牺牲塑木师谜结：你获得3点生命且得到{E}{E}{E}。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418077&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d25318d9-e60e-4f77-a9de-607373989c65\', \'multiverseId\': 418077}, \'multiverseid\': 418077}, {\'name\': \'塑木師謎結\', \'text\': \'當塑木師謎結進戰場時，你獲得3點生命且得到{E}{E}{E}（三個能量指示物）。\\n{2}{G}，犧牲塑木師謎結：你獲得3點生命且得到{E}{E}{E}。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418341&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'47f7b25c-3345-4d45-87fe-bf1b8dafd746\', \'multiverseId\': 418341}, \'multiverseid\': 418341}]', '[{\'name\': \'Inhaftiert vom Konsulat\', \'text\': \'Verzaubert eine Kreatur, die du nicht kontrollierst\\nDie verzauberte Kreatur kann nicht angreifen.\\nImmer wenn ein Gegner einen Zauberspruch wirkt und falls der Zauberspruch ein einzelnes Ziel hat, ändere das Ziel auf die verzauberte Kreatur, falls möglich.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Endlich, die berüchtigte Pia Nalaar." —Tezzeret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418373&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc566e20-7d41-4c41-a1fe-6a55107c6281\', \'multiverseId\': 418373}, \'multiverseid\': 418373}, {\'name\': \'Arresto consular\', \'text\': \'Encantar criatura que no controlas.\\nLa criatura encantada no puede atacar.\\nSiempre que un oponente lance un hechizo, si solo tiene un objetivo, cambia el objetivo a la criatura encantada si es posible.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"La famosa Pia Nalaar, al fin". —Tezzeret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420221&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e1b4493-b65b-4446-8a84-eea430e423d6\', \'multiverseId\': 420221}, \'multiverseid\': 420221}, {\'name\': \'Capturée par le consulat\', \'text\': "Enchanter : une créature que vous ne contrôlez pas\\nLa créature enchantée ne peut pas attaquer.\\nÀ chaque fois qu\'un adversaire lance un sort, s\'il a une seule cible, remplacez la cible par la créature enchantée si possible.", \'type\': \'Enchantement : aura\', \'flavor\': \'« Voici, enfin, la tristement célèbre Pia Nalaàr. » —Tezzeret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418637&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3538f88d-1d74-4047-9f9c-c3428b60dc82\', \'multiverseId\': 418637}, \'multiverseid\': 418637}, {\'name\': \'Cattura del Consolato\', \'text\': \'Incanta creatura che non controlli\\nLa creatura incantata non può attaccare.\\nOgniqualvolta un avversario lancia una magia, se questa ha un singolo bersaglio, il bersaglio diventa invece la creatura incantata, se possibile.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Eccola, finalmente: la famigerata Pia Nalaar." —Tezzeret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418901&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4b1bf07-c9bc-4325-8e43-c253d3e0dd35\', \'multiverseId\': 418901}, \'multiverseid\': 418901}, {\'name\': \'領事府による拘禁\', \'text\': \'エンチャント（あなたがコントロールしていないクリーチャー）\\nエンチャントされているクリーチャーでは攻撃できない。\\n対戦相手が呪文を１つ唱えるたび、それが単一の対象を持つ場合、可能ならその対象をエンチャントされているクリーチャーに変更する。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「これはこれは。悪名高いピア・ナラーではないか。」 ――テゼレット\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419165&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e0afbcb9-fe77-4059-a810-a543de0034c3\', \'multiverseId\': 419165}, \'multiverseid\': 419165}, {\'name\': \'영사관에게 체포되다\', \'text\': \'당신이 조종하지 않는 생물에게 부여\\n부여된 생물은 공격할 수 없다.\\n상대가 주문을 발동할 때마다, 그 주문의 목표가 한 개라면, 가능하면 그 목표를 부여된 생물로 변경한다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"드디어, 악명높은 피아 날라르시군." —테제렛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419429&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d077beef-53ca-4061-bcac-4393785f2c0d\', \'multiverseId\': 419429}, \'multiverseid\': 419429}, {\'name\': \'Capturada pelo Consulado\', \'text\': \'Encantar criatura que você não controla\\nA criatura encantada não pode atacar.\\nToda vez que um oponente conjurar uma mágica, se ela tiver um único alvo, altere o alvo para a criatura encantada se esta estiver apta.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Enfim, a infame Pia Nalaar." — Tezzeret\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419693&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2071a01c-b59e-4533-861d-d68398c6c0fb\', \'multiverseId\': 419693}, \'multiverseid\': 419693}, {\'name\': \'В Плену у Консульства\', \'text\': \'Зачаровать существо не под вашим контролем\\nЗачарованное существо не может атаковать.\\nКаждый раз, когда оппонент разыгрывает заклинание, если у него только одна цель, измените ту цель на зачарованное существо, если это возможно.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Ну наконец-то, печально известная Пия Налаар». — Теззерет\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419957&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f16315ec-9a40-4cbb-ae92-e5d69685e57e\', \'multiverseId\': 419957}, \'multiverseid\': 419957}, {\'name\': \'执政院缉捕\', \'text\': \'结附于不由你操控的生物\\n所结附的生物不能进行攻击。\\n每当任一对手施放咒语时，若该咒语仅指定单一目标，则如果能将其目标更改为所结附的生物，便须如此作。\', \'type\': \'结界～灵气\', \'flavor\': \'「恶名昭彰的琵雅纳拉终于被捕了。」 ～泰兹瑞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417845&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'63f169e6-bf20-49b6-86cd-cd1cbc636c54\', \'multiverseId\': 417845}, \'multiverseid\': 417845}, {\'name\': \'執政院緝捕\', \'text\': \'結附於不由你操控的生物\\n所結附的生物不能進行攻擊。\\n每當任一對手施放咒語時，若該咒語僅指定單一目標，則如果能將其目標更改為所結附的生物，便須如此作。\', \'type\': \'結界～靈氣\', \'flavor\': \'「惡名昭彰的琵雅納拉終於被捕了。」 ～泰茲瑞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418109&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c34d0c06-af26-401a-9cfc-f10f1c1e7fd4\', \'multiverseId\': 418109}, \'multiverseid\': 418109}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418618&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8285d852-1540-4b30-aeca-d3539140b81f', 'multiverseId': 418618}, 'multiverseid': 418618}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420466&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '47e23ae2-a8e2-4e3b-adb5-6e299efb6557', 'multiverseId': 420466}, 'multiverseid': 420466}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418882&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e3ce0f62-b502-448f-8b23-1d103600b448', 'multiverseId': 418882}, 'multiverseid': 418882}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419146&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0ef4d3d9-43c1-474b-84ef-2ec711ead783', 'multiverseId': 419146}, 'multiverseid': 419146}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419410&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '07408fe6-af61-4ff3-a139-830b47581177', 'multiverseId': 419410}, 'multiverseid': 419410}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419674&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1fc1a709-6465-49e5-9159-b9b9a63ba605', 'multiverseId': 419674}, 'multiverseid': 419674}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419938&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7c69b85d-40ff-457f-84db-ed1eb3610bd6', 'multiverseId': 419938}, 'multiverseid': 419938}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420202&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'cad39cf9-0296-4bfd-8059-efa4af16cad3', 'multiverseId': 420202}, 'multiverseid': 420202}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418090&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7dbd704e-85b9-4616-a764-7eb8f0af1f36', 'multiverseId': 418090}, 'multiverseid': 418090}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418354&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'e38b7509-d045-44a9-a39f-e81a8474a5f0', 'multiverseId': 418354}, 'multiverseid': 418354}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418619&type=card', 'language': 'German', 'identifiers': {'scryfallId': '312a085b-c970-49a4-866b-adabc34c388d', 'multiverseId': 418619}, 'multiverseid': 418619}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420467&type=card', 'language': 'Spanish', 'identifiers': {'scr