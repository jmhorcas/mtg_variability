x?multiverseid=418091&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '06d942e7-e77f-45d1-a686-f8c8719c70be', 'multiverseId': 418091}, 'multiverseid': 418091}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418355&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '9b57fc1e-fb50-4774-8de7-5c095862b61f', 'multiverseId': 418355}, 'multiverseid': 418355}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418620&type=card', 'language': 'German', 'identifiers': {'scryfallId': '80b60465-a3e4-4998-9bcd-8271ce5642b8', 'multiverseId': 418620}, 'multiverseid': 418620}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420468&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6a467145-2201-4bb2-aacb-d72f2f91d4c2', 'multiverseId': 420468}, 'multiverseid': 420468}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418884&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2d32147d-493a-4965-9239-c896e81b35f2', 'multiverseId': 418884}, 'multiverseid': 418884}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419148&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0ba1e85b-34ca-4a92-b7da-76cac8f501c1', 'multiverseId': 419148}, 'multiverseid': 419148}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419412&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2d5bf1d8-7aa2-4dd8-b96a-d0074858a523', 'multiverseId': 419412}, 'multiverseid': 419412}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419676&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'a8a1717e-8831-4a21-9c58-f1986f921511', 'multiverseId': 419676}, 'multiverseid': 419676}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419940&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '47db18a2-31c5-43c2-b55b-8d69c131d6c5', 'multiverseId': 419940}, 'multiverseid': 419940}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420204&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '40b1f3f3-e8c6-4b26-9640-ef5339af652a', 'multiverseId': 420204}, 'multiverseid': 420204}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418092&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ebdda8ef-9d90-41f0-9be6-d708c3dbef9b', 'multiverseId': 418092}, 'multiverseid': 418092}, {'name': '海島', 'type': '基本地～海島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418356&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ccaa2609-5bc2-4fbe-8d2f-5b265dd03cae', 'multiverseId': 418356}, 'multiverseid': 418356}]", '[{\'name\': \'Inspirierter Ansturm\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +2/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Ein Zwerg im Team garantiert Kompetenz. Ein Team nur aus Zwergen garantiert Großartigkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418385&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ccea446b-6a1c-4ab7-9a61-f8d9eca13258\', \'multiverseId\': 418385}, \'multiverseid\': 418385}, {\'name\': \'Carga inspirada\', \'text\': \'Las criaturas que controlas obtienen +2/+1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Un enano en un equipo de constructores asegura la profesionalidad. Un equipo de constructores formado por enanos asegura la excelencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420233&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2bf84205-df09-4fc3-8dda-f1c693265636\', \'multiverseId\': 420233}, \'multiverseid\': 420233}, {\'name\': \'Charge inspirée\', \'text\': "Les créatures que vous contrôlez gagnent +2/+1 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Un nain dans une équipe de construction est synonyme d\'expertise. Une équipe constituée uniquement de nains est synonyme de génie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418649&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'017dd62f-f316-46a5-bc20-b8a9791102bf\', \'multiverseId\': 418649}, \'multiverseid\': 418649}, {\'name\': \'Carica Ispirata\', \'text\': \'Le creature che controlli prendono +2/+1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Un nano in una squadra di costruzione è garanzia di competenza. Una squadra di soli nani è garanzia di genialità.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418913&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da502ab3-b76e-457a-8f8f-c8b295cd4537\', \'multiverseId\': 418913}, \'multiverseid\': 418913}, {\'name\': \'鼓舞する突撃\', \'text\': \'ターン終了時まで、あなたがコントロールするクリーチャーは＋２/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'建設チームにドワーフが１人いれば有利。チームの全員がドワーフならば卓絶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419177&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5971e762-a1de-42c1-8585-52fd27f4df34\', \'multiverseId\': 419177}, \'multiverseid\': 419177}, {\'name\': \'영감을 얻은 돌진\', \'text\': \'당신이 조종하는 생물들은 턴종료까지 +2/+1을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'제작팀에 드워프가 한 명 있다면 그 제작팀의 수준이 높은 것임을 알 수 있고, 드워프로만 구성되어 있다면 최고임을 의심하지 않아도 된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419441&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'27beb30f-a8e7-4b2a-a535-f63bb90e9ffe\', \'multiverseId\': 419441}, \'multiverseid\': 419441}, {\'name\': \'Ataque Inspirado\', \'text\': \'As criaturas que você controla recebem +2/+1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Um anão em uma equipe de construção garante a competência. Uma equipe só de anões garante o brilhantismo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419705&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41c32e6d-36d4-4aa5-8500-97bd3a455e12\', \'multiverseId\': 419705}, \'multiverseid\': 419705}, {\'name\': \'Вдохновенный Натиск\', \'text\': \'Существа под вашим контролем получают +2/+1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Один гном в строительной команде гарантирует компетентность. Команда из одних гномов гарантирует непревзойденность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419969&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ca2b9e9d-1af0-418d-bf3a-86a9252a572c\', \'multiverseId\': 419969}, \'multiverseid\': 419969}, {\'name\': \'鼓舞冲锋\', \'text\': \'由你操控的生物得+2/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'建造队中有矮人，过人能力有保证。建造全队皆矮人，卓越杰作有保证。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'211caf79-d90b-49aa-862f-031462ed2c9c\', \'multiverseId\': 417857}, \'multiverseid\': 417857}, {\'name\': \'鼓舞衝鋒\', \'text\': \'由你操控的生物得+2/+1直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'建造隊中有矮人，過人能力有保證。建造全隊皆矮人，卓越傑作有保證。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418121&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'16286242-09d0-4a94-be04-a42fa05611b6\', \'multiverseId\': 418121}, \'multiverseid\': 418121}]', '[{\'name\': \'Janjeet-Wachposten\', \'text\': \'Wenn der Janjeet-Wachposten ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\n{T}, bezahle {E}{E}: Du kannst ein Artefakt oder eine Kreatur deiner Wahl tappen oder enttappen.\', \'type\': \'Kreatur — Vedalken, Soldat\', \'flavor\': \'Das Janjeet-Observatorium ist für die Öffentlichkeit zugänglich, aber der Zugang zu den angeschlossenen Laboren ist beschränkt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418418&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1cf62ae3-5c05-4b03-a32a-2cae2aa71f27\', \'multiverseId\': 418418}, \'multiverseid\': 418418}, {\'name\': \'Centinela de Janjeet\', \'text\': \'Cuando el Centinela de Janjeet entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\n{T}, pagar {E}{E}: Puedes girar o enderezar el artefacto o la criatura objetivo.\', \'type\': \'Criatura — Soldado vedalken\', \'flavor\': \'El Observatorio de Janjeet está abierto al público, pero el acceso a los laboratorios anexos está restringido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a2a469d-c395-4270-8d3b-9e510542529e\', \'multiverseId\': 420266}, \'multiverseid\': 420266}, {\'name\': \'Sentinelle de Janjeet\', \'text\': \'Quand la Sentinelle de Janjeet arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\n{T}, payez {E}{E} : Vous pouvez engager ou dégager un artefact ciblé ou une créature ciblée.\', \'type\': \'Créature : vedalken et soldat\', \'flavor\': "L\'observatoire de Janjeet est ouvert au public, mais l\'accès aux laboratoires mitoyens est interdit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418682&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0bdea2b4-5e09-4a56-bdc0-1b2e6cef861c\', \'multiverseId\': 418682}, \'multiverseid\': 418682}, {\'name\': \'Sentinella di Janjeet\', \'text\': \'Quando la Sentinella di Janjeet entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\n{T}, Paga {E}{E}: Puoi TAPpare o STAPpare un artefatto o una creatura bersaglio.\', \'type\': \'Creatura — Soldato Vedalken\', \'flavor\': "L\'Osservatorio di Janjeet è aperto al pubblico, ma ai laboratori adiacenti si accede solo previa autorizzazione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418946&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a97b123-d5de-482d-84cb-4416d51d96aa\', \'multiverseId\': 418946}, \'multiverseid\': 418946}, {\'name\': \'ジャンジーの歩哨\', \'text\': \'ジャンジーの歩哨が戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n{T}, {E}{E}を支払う：アーティファクト１つかクリーチャー１体を対象とする。あなたはそれをタップまたはアンタップしてもよい。\', \'type\': \'クリーチャー — ヴィダルケン・兵士\', \'flavor\': \'ジャンジー観測所は一般公開されているが、隣接する研究所には入れない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419210&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7f4aebe-ffe2-488e-8f18-8aa9b075de57\', \'multiverseId\': 419210}, \'multiverseid\': 419210}, {\'name\': \'잔지트 파수병\', \'text\': \'잔지트 파수병이 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n{T}, {E}{E}를 지불한다: 마법물체 또는 생물을 목표로 정한다. 당신은 그 목표를 탭하거나 언탭할 수 있다.\', \'type\': \'생물 — 베달켄 병사\', \'flavor\': \'잔지트 천문대는 대중에 개방되어 있지만 근처의 실험실들은 출입이 금지되어 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419474&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'db355721-1d3c-45e8-a3bb-eb0f1718a497\', \'multiverseId\': 419474}, \'multiverseid\': 419474}, {\'name\': \'Vigia de Janjeet\', \'text\': \'Quando Vigia de Janjeet entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\n{T}, Pague {E}{E}: Você pode virar ou desvirar o artefato ou a criatura alvo.\', \'type\': \'Criatura — Vedalkeano Soldado\', \'flavor\': \'O Observatório de Janjeet é aberto ao público, mas o acesso aos laboratórios anexos é restrito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419738&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48e70a75-046d-45e5-abc4-a04f3a1d2267\', \'multiverseId\': 419738}, \'multiverseid\': 419738}, {\'name\': \'Стражница Янджита\', \'text\': \'Когда Стражница Янджита выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\n{T}, заплатите {E}{E}: вы можете повернуть или развернуть целевой артефакт или существо.\', \'type\': \'Существо — Ведалкен Солдат\', \'flavor\': \'Обсерватория Янджита открыта для свободного посещения, но проход в соседние с ней лаборатории закрыт.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420002&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6d727544-447d-4ba0-8e70-f45fe600e2e7\', \'multiverseId\': 420002}, \'multiverseid\': 420002}, {\'name\': \'詹吉栋哨卫\', \'text\': \'当詹吉栋哨卫进战场时，你得到{E}{E}（两个能量指示物）。\\n{T}，支付{E}{E}：你可以横置或重置目标神器或生物。\', \'type\': \'生物～维多肯／士兵\', \'flavor\': \'詹吉栋观测站向大众开放，但邻近的实验室闲人免进。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417890&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e8288cb7-5c39-4c61-8ba7-09f50dea1f9f\', \'multiverseId\': 417890}, \'multiverseid\': 417890}, {\'name\': \'詹吉棟哨衛\', \'text\': \'當詹吉棟哨衛進戰場時，你得到{E}{E}（兩個能量指示物）。\\n{T}，支付{E}{E}：你可以橫置或重置目標神器或生物。\', \'type\': \'生物～維多肯／士兵\', \'flavor\': \'詹吉棟觀測站向大眾開放，但鄰近的實驗室閒人免進。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418154&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6d43246a-2f48-4ff6-8405-0d4c4bc69050\', \'multiverseId\': 418154}, \'multiverseid\': 418154}]', '[{\'name\': \'Kambal, Konsul der Allokation\', \'text\': \'Immer wenn ein Gegner einen Nichtkreatur-Zauberspruch wirkt, verliert er 2 Lebenspunkte und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Legendäre Kreatur — Mensch, Berater\', \'flavor\': \'Er hat „Freunde" in allen Gesellschaftsschichten und offenbar schuldet ihm jeder einen Gefallen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418548&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93270dfe-7c6f-4925-bf9f-351e59bf951b\', \'multiverseId\': 418548}, \'multiverseid\': 418548}, {\'name\': \'Kambal, Cónsul de Abastecimiento\', \'text\': \'Siempre que un oponente lance un hechizo que no sea de criatura, ese jugador pierde 2 vidas y tú ganas 2 vidas.\', \'type\': \'Criatura legendaria — Consejero humano\', \'flavor\': \'Tiene "amigos" en las altas esferas y en los bajos fondos, y todos parecen deberle algún favor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420396&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da5ad844-02a0-4039-b3c4-6019ac0f09a4\', \'multiverseId\': 420396}, \'multiverseid\': 420396}, {\'name\': "Kambal, consul de l\'attribution", \'text\': "À chaque fois qu\'un adversaire lance un sort non-créature, ce joueur perd 2 points de vie et vous gagnez 2 points de vie.", \'type\': \'Créature légendaire : humain et conseiller\', \'flavor\': \'Ses « amis » vont du plus riche au plus misérable, et tous semblent lui être redevables.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418812&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d2b6d7d-2d11-429b-b891-300050667c8a\', \'multiverseId\': 418812}, \'multiverseid\': 418812}, {\'name\': "Kambal, Console dell\'Assegnazione", \'text\': \'Ogniqualvolta un avversario lancia una magia non creatura, quel giocatore perde 2 punti vita e tu guadagni 2 punti vita.\', \'type\': \'Creatura Leggendaria — Consigliere Umano\', \'flavor\': \'Ha "amici" sia ai piani alti sia nei bassifondi e tutti sembrano dovergli un favore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419076&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'981c167a-326e-4e87-947e-d2e025e8143e\', \'multiverseId\': 419076}, \'multiverseid\': 419076}, {\'name\': \'配分の領事、カンバール\', \'text\': \'対戦相手がクリーチャーでない呪文を１つ唱えるたび、そのプレイヤーは２点のライフを失い、あなたは２点のライフを得る。\', \'type\': \'伝説のクリーチャー — 人間・アドバイザー\', \'flavor\': \'上下を問わず彼には「友達」が多く、みな彼に貸りがあるようだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e34188e1-9548-443f-8f13-948d6d2aefbf\', \'multiverseId\': 419340}, \'multiverseid\': 419340}, {\'name\': \'배급의 영사 캄발\', \'text\': \'상대가 생물이 아닌 주문을 발동할 때마다, 그 플레이어는 생명 2점을 잃고 당신은 생명 2점을 얻는다.\', \'type\': \'전설적 생물 — 인간 참모\', \'flavor\': \'그는 지위 고하를 막론하고 많은 "친구들" 이 있으며, 그들은 모두 그에게 갚아야 할 빚이 있는 듯 하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419604&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'90c068ac-f107-4dd5-b994-9519fb8e937e\', \'multiverseId\': 419604}, \'multiverseid\': 419604}, {\'name\': \'Kambal, Cônsul da Alocação\', \'text\': \'Toda vez que um oponente conjura uma mágica que não seja de criatura, aquele jogador perde 2 pontos de vida e você ganha 2 pontos de vida.\', \'type\': \'Criatura Lendária — Humano Conselheiro\', \'flavor\': \'Ele tem "amigos" em altos e baixos círculos, e todos parecem lhe dever favores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419868&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dfc4491a-2336-47db-9cf3-dc3d761c4257\', \'multiverseId\': 419868}, \'multiverseid\': 419868}, {\'name\': \'Камбал, Консул Перерасчетов\', \'text\': \'Каждый раз, когда оппонент разыгрывает не являющееся существом заклинание, тот игрок теряет 2 жизни, а вы получаете 2 жизни.\', \'type\': \'Легендарное Существо — Человек Советник\', \'flavor\': \'У него есть «друзья» и в высших эшелонах власти, и среди отбросов общества, и все они чем-то ему обязаны.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420132&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c7496c86-9402-45e3-a5cb-7c4b5a29a609\', \'multiverseId\': 420132}, \'multiverseid\': 420132}, {\'name\': \'划配执政坎拔\', \'text\': \'每当任一对手施放非生物咒语时，该牌手失去2点生命且你获得2点生命。\', \'type\': \'传奇生物～人类／参谋\', \'flavor\': \'他在高低阶层都有「朋友」，而且所有人似乎都欠他人情。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418020&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe16f23b-c973-439b-97d2-58312bf84534\', \'multiverseId\': 418020}, \'multiverseid\': 418020}, {\'name\': \'劃配執政坎拔\', \'text\': \'每當任一對手施放非生物咒語時，該玩家失去2點生命且你獲得2點生命。\', \'type\': \'傳奇生物～人類／參謀\', \'flavor\': \'他在高低階層都有「朋友」，而且所有人似乎都欠他人情。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418284&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dcf97c65-4f1f-467f-9fb9-40b0ced7c85c\', \'multiverseId\': 418284}, \'multiverseid\': 418284}]', '[{\'name\': \'Kapern\', \'text\': \'Übernimm bis zum Ende des Zuges die Kontrolle über ein Artefakt oder eine Kreatur deiner Wahl. Enttappe jene bleibende Karte. Sie erhält Eile bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'„Hui! Ruhig Blut. Wir machen nur einen kleinen Umweg."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418483&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ea0bcfd-c9b0-485e-b624-3aa2a22d0bfc\', \'multiverseId\': 418483}, \'multiverseid\': 418483}, {\'name\': \'Decomiso\', \'text\': \'Gana el control del artefacto o la criatura objetivo hasta el final del turno. Enderézalo. Gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'"Eh, eh, tranquilo. Solo vamos a desviarnos un poco de la ruta".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420331&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a55e39f-3c22-45e4-84ef-d2db9da5b38f\', \'multiverseId\': 420331}, \'multiverseid\': 420331}, {\'name\': \'Détourner\', \'text\': "Acquérez le contrôle de l\'artefact ciblé ou de la créature ciblée jusqu\'à la fin du tour. Dégagez-les. Ils acquierent la célérité jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'« Holà ! Tout doux. On va simplement faire un petit détour. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418747&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b339822b-171a-4f5a-9e86-deb73d67ba4f\', \'multiverseId\': 418747}, \'multiverseid\': 418747}, {\'name\': \'Sequestrare\', \'text\': \'Prendi il controllo di un artefatto o di una creatura bersaglio fino alla fine del turno. STAPpalo. Ha rapidità fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Ehi, rallenta. Faremo giusto una breve deviazione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5331f537-c5a6-44c3-b30a-7c454b5a6d23\', \'multiverseId\': 419011}, \'multiverseid\': 419011}, {\'name\': \'乗っ取り\', \'text\': \'アーティファクト１つかクリーチャー１体を対象とする。ターン終了時まで、それのコントロールを得る。それをアンタップする。ターン終了時まで、それは速攻を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'「おっと、落ち着いて。ちょっと遠回りしてもらうだけだよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419275&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'23b9da1f-2887-471c-99ba-cde0c6573efb\', \'multiverseId\': 419275}, \'multiverseid\': 419275}, {\'name\': \'공중 납치\', \'text\': \'마법물체 또는 생물을 목표로 정한다. 당신은 턴종료까지 그 목표의 조종권을 얻는다. 그 지속물은 언탭되며 턴종료까지 신속을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'"워워, 이봐. 진정하라구. 잠시 돌아가는 것 뿐이야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419539&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fa73ac5b-61ab-4dd0-a582-a53a0f3ac935\', \'multiverseId\': 419539}, \'multiverseid\': 419539}, {\'name\': \'Sequestrar\', \'text\': \'Ganhe o controle do artefato ou criatura alvo até o final do turno. Desvire-o. Ele ganha ímpeto até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'"Ôa! Ôa! Calma. Só vamos dar uma voltinha."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419803&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95f810f2-039a-478f-9313-c8cf877843a9\', \'multiverseId\': 419803}, \'multiverseid\': 419803}, {\'name\': \'Угон\', \'text\': \'Получите контроль над целевым артефактом или существом до конца хода. Разверните его. Он(о) получает Ускорение до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'«А ну, стой. Тпру! Сделаем небольшой крюк».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420067&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'feaabcc6-2c96-4813-b3fb-7bc4aa5503b0\', \'multiverseId\': 420067}, \'multiverseid\': 420067}, {\'name\': \'劫持\', \'text\': \'获得目标神器或生物的操控权直到回合结束。将之重置。它获得敏捷异能直到回合结束。\', \'type\': \'法术\', \'flavor\': \'「哈罗。别紧张。我们只是要绕一点路而已。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417955&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04362aeb-c6f4-4117-acbd-6552f183ec45\', \'multiverseId\': 417955}, \'multiverseid\': 417955}, {\'name\': \'劫持\', \'text\': \'獲得目標神器或生物的操控權直到回合結束。將之重置。它獲得敏捷異能直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'「哈囉。別緊張。我們只是要繞一點路而已。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418219&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'92cbb02c-d621-4bab-aa4a-fc3713fdf8f0\', \'multiverseId\': 418219}, \'multiverseid\': 418219}]', '[{\'name\': \'Klingenzüchter\', \'text\': \'Fabrizieren 2 (Wenn diese Kreatur ins Spiel kommt, lege zwei +1/+1-Marken auf sie oder erzeuge zwei 1/1 farblose Servo-Artefaktkreaturenspielsteine.)\\nImmer wenn der Klingenzüchter angreift, kannst du andere angreifende Kreaturen bis zum Ende des Zuges +X/+X erhalten lassen, wobei X gleich der Stärke des Klingenzüchters ist.\', \'type\': \'Kreatur — Elf, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418516&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'21fbbefe-1d37-4442-adf9-6150545aef38\', \'multiverseId\': 418516}, \'multiverseid\': 418516}, {\'name\': \'Cultivafilos\', \'text\': \'Fabricar 2. (Cuando esta criatura entre al campo de batalla, pon dos contadores +1/+1 sobre ella o crea dos fichas de criatura artefacto Servo incoloras 1/1.)\\nSiempre que el Cultivafilos ataque, puedes hacer que las otras criaturas atacantes obtengan +X/+X hasta el final del turno, donde X es la fuerza del Cultivafilos.\', \'type\': \'Criatura — Artífice elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420364&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad0e102f-c84e-4e04-99b2-c823b8745993\', \'multiverseId\': 420364}, \'multiverseid\': 420364}, {\'name\': \'Cultivatrice de lames\', \'text\': "Fabrication 2 (Quand cette créature arrive sur le champ de bataille, mettez deux marqueurs +1/+1 sur elle ou créez deux jetons de créature-artefact 1/1 incolore Servo.)\\nÀ chaque fois que la Cultivatrice de lames attaque, vous pouvez faire que les autres créatures attaquantes gagnent +X/+X jusqu\'à la fin du tour, X étant la force de la Cultivatrice de lames.", \'type\': \'Créature : elfe et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418780&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee2ee780-0068-4820-9e47-88961f30b3c8\', \'multiverseId\': 418780}, \'multiverseid\': 418780}, {\'name\': \'Coltivatrice di Lame\', \'text\': \'Fabbrica 2 (Quando questa creatura entra nel campo di battaglia, metti due segnalini +1/+1 su di essa o crea due pedine creatura artefatto Servomeccanismo 1/1 incolori.)\\nOgniqualvolta la Coltivatrice di Lame attacca, puoi far prendere +X/+X alle altre creature attaccanti fino alla fine del turno, dove X è la forza della Coltivatrice di Lame.\', \'type\': \'Creatura — Artefice Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419044&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86611402-be49-4da9-991f-d38ed9c4ec7e\', \'multiverseId\': 419044}, \'multiverseid\': 419044}, {\'name\': \'刃の耕作者\', \'text\': \'製造２（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを２個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを２体生成する。）\\n刃の耕作者が攻撃するたび、あなたは「ターン終了時まで、他の攻撃クリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘは刃の耕作者のパワーに等しい。」を選んでもよい。\', \'type\': \'クリーチャー — エルフ・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419308&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f2f09fd-1797-4657-a956-4c312f9cfac5\', \'multiverseId\': 419308}, \'multiverseid\': 419308}, {\'name\': \'칼날 재배자\', \'text\': \'제작 2 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 두 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 두 개를 만든다.)\\n칼날 재배자가 공격할 때마다, 당신은 다른 공격생물들이 턴종료까지 +X/+X를 받도록 할 수 있다. X는 칼날 재배자의 공격력이다.\', \'type\': \'생물 — 엘프 기능공\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419572&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3a48a41e-fed8-49e1-b08a-396d84b7a990\', \'multiverseId\': 419572}, \'multiverseid\': 419572}, {\'name\': \'Cultivadora de Lâminas\', \'text\': \'Fabricar 2 (Quando esta criatura entrar no campo de batalha, coloque dois marcadores +1/+1 nela ou crie duas fichas de criatura artefato incolor 1/1 do tipo Servus.)\\nToda vez que Cultivadora de Lâminas ataca, você pode fazer com que as outras criaturas atacantes recebam +X/+X até o final do turno, sendo X o poder de Cultivadora de Lâminas.\', \'type\': \'Criatura — Elfo Artesão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419836&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffb82fe0-be63-4268-af9f-073ab43008e4\', \'multiverseId\': 419836}, \'multiverseid\': 419836}, {\'name\': \'Культиватор Клинков\', \'text\': \'Производство 2 (Когда это существо выходит на поле битвы, положите на него два жетона +1/+1 или создайте две фишки артефакта существа 1/1 бесцветный Сервотрон.)\\nКаждый раз, когда Культиватор Клинков атакует, вы можете заставить другие атакующие существа получить +X/+X до конца хода, где Х — сила Культиватора Клинков.\', \'type\': \'Существо — Эльф Механик\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420100&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e10383df-78a2-4c9d-b1e6-8eac5bfcafc6\', \'multiverseId\': 420100}, \'multiverseid\': 420100}, {\'name\': \'育剑师\', \'text\': \'装配2（当此生物进战场时，在其上放置两个+1/+1指示物或派出两个1/1无色自动机衍生神器生物。）\\n每当育剑师攻击时，你可以让其他进行攻击的生物得+X/+X直到回合结束，X为育剑师的力量。\', \'type\': \'生物～妖精／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417988&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5649e19-ac97-4321-9484-afe4563de606\', \'multiverseId\': 417988}, \'multiverseid\': 417988}, {\'name\': \'育劍師\', \'text\': \'裝配2（當此生物進戰場時，在其上放置兩個+1/+1指示物或派出兩個1/1無色自動機衍生神器生物。）\\n每當育劍師攻擊時，你可以讓其他進行攻擊的生物得+X/+X直到回合結束，X為育劍師的力量。\', \'type\': \'生物～妖精／神器師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418252&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2ccfee9f-2dba-4675-b9f0-8cb74d77f6ae\', \'multiverseId\': 418252}, \'multiverseid\': 418252}]', "[{'name': 'Konsulats-Überwachung', 'text': 'Wenn die Konsulats-Überwachung ins Spiel kommt, erhältst du {E}{E}{E}{E} (vier Energiemarken).\\nBezahle {E}{E}: Verhindere allen Schaden, der dir in diesem Zug von einer Quelle, die du bestimmst, zugefügt würde.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418375&type=card', 'language': 'German', 'identifiers': {'scryfallId': '484fd4b1-e809-4a51-b25b-07dd7b2ce722', 'multiverseId': 418375}, 'multiverseid': 418375}, {'name': 'Vigilancia del Consulado', 'text': 'Cuando la Vigilancia del Consulado entre al campo de batalla, obtienes {E}{E}{E}{E} (cuatro contadores de energía).\\nPagar {E}{E}: Prevén todo el daño que la fuente de tu elección fuera a hacerte este turno.', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420223&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a3a704ca-4806-449b-a92e-17250f5bc514', 'multiverseId': 420223}, 'multiverseid': 420223}, {'name': 'Surveillance du consulat', 'text': 'Quand la Surveillance du consulat arrive sur le champ de bataille, vous gagnez {E}{E}{E}{E} (quatre marqueurs « énergie »).\\nPayez {E}{E} : Prévenez toutes les blessures qui devraient vous être infligées ce tour-ci par une source de votre choix.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418639&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fad4cbd4-c144-4282-8130-132961a235d1', 'multiverseId': 418639}, 'multiverseid': 418639}, {'name': 'Sorveglianza del Consolato', 'text': 'Quando la Sorveglianza del Consolato entra nel campo di battaglia, ottieni {E}{E}{E}{E} (quattro segnalini energia).\\nPaga {E}{E}: Previeni tutto il danno che ti verrebbe inflitto in questo turno da una fonte a tua scelta.', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418903&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f8f65da6-5801-47cc-be23-183d8449031b', 'multiverseId': 418903}, 'multiverseid': 418903}, {'name': '領事府の看視', 'text': '領事府の看視が戦場に出たとき、あなたは{E}{E}{E}{E}（エネルギー・カウンター４個）を得る。\\n{E}{E}を支払う：このターン、あなたが選んだ発生源１つからあなたに与えられるすべてのダメージを軽減する。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419167&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '34d82f12-dd9d-4038-a079-49db56e07d53', 'multiverseId': 419167}, 'multiverseid': 419167}, {'name': '영사관 감시체계', 'text': '영사관 감시체계가 전장에 들어올 때, 당신은 {E}{E}{E}{E}(에너지 카운터 네 개)를 얻는다.\\n{E}{E}를 지불한다: 당신이 선택한 원천이 이 턴에 당신에게 입히려는 모든 피해를 방지한다.', 'type': '부여마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419431&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e0640b41-65e5-410f-b128-4eadbf169759', 'multiverseId': 419431}, 'multiverseid': 419431}, {'name': 'Vigilância do Consulado', 'text': 'Quando Vigilância do Consulado entra no campo de batalha, você recebe {E}{E}{E}{E} (quatro marcadores de energia).\\nPague {E}{E}: Previna todo o dano que seria causado a você neste turno por uma fonte a sua escolha.', 'type': 'Encantamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419695&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '67579d16-3dc5-46c1-bc6e-cd24a2cb5155', 'multiverseId': 419695}, 'multiverseid': 419695}, {'name': 'Консульская Слежка', 'text': 'Когда Консульская Слежка выходит на поле битвы, вы получаете {E}{E}{E}{E} (четыре жетона энергии).\\nЗаплатите {E}{E}: предотвратите все повреждения, которые должны быть нанесены вам в этом ходу источником по вашему выбору.', 'type': 'Чары', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419959&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '01fabb7e-900b-4b7d-a9f7-fd4ef4dc0d49', 'multiverseId': 419959}, 'multiverseid': 419959}, {'name': '执政监视网', 'text': '当执政监视网进战场时，你得到{E}{E}{E}{E}（四个能量指示物）。\\n支付{E}{E}：选择一个来源。于本回合中，防止该来源将对你造成的所有伤害。', 'type': '结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417847&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ddbc59d2-1a88-46df-b238-38ee1c90fb98', 'multiverseId': 417847}, 'multiverseid': 417847}, {'name': '執政監視網', 'text': '當執政監視網進戰場時，你得到{E}{E}{E}{E}（四個能量指示物）。\\n支付{E}{E}：選擇一個來源。於本回合中，防止該來源將對你造成的所有傷害。', 'type': '結界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418111&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4134267f-6bd8-47a3-8d0e-7c4861ee96a5', 'multiverseId': 418111}, 'multiverseid': 418111}]", '[{\'name\': \'Korrosiver Gremlin\', \'text\': \'{2}{R}, opfere den Korrosiven Gremlin: Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Kreatur — Gremlin\', \'flavor\': \'Stadtbeamte sandten einst zwanzig glänzende Kampfmaschinen aus, um ein Gremlin-Nest zu zerstören. Bald schon waren sie sich ihres Fehlers bewusst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418493&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6807ce5b-2266-4a53-91bf-0c0d1464118d\', \'multiverseId\': 418493}, \'multiverseid\': 418493}, {\'name\': \'Gremlin ruinoso\', \'text\': \'{2}{R}, sacrificar el Gremlin ruinoso: Destruye el artefacto objetivo.\', \'type\': \'Criatura — Gremlin\', \'flavor\': \'Los gobernantes de la ciudad mandaron una vez a veinte autómatas relucientes a exterminar un nido de gremlins. Pronto vieron que se habían equivocado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420341&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3da06234-8385-48b1-88cb-6f40abbffa40\', \'multiverseId\': 420341}, \'multiverseid\': 420341}, {\'name\': \'Gremlin ruineux\', \'text\': "{2}{R}, sacrifiez le Gremlin ruineux : Détruisez l\'artefact ciblé.", \'type\': \'Créature : gremlin\', \'flavor\': \'Un jour, les hauts fonctionnaires de la ville envoyèrent vingt automates rutilants exterminer un nid de gremlins. Ils comprirent rapidement leur erreur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418757&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'034ac503-fb1c-4f06-9976-2da40242a8b0\', \'multiverseId\': 418757}, \'multiverseid\': 418757}, {\'name\': \'Gremlin Rovinoso\', \'text\': \'{2}{R}, Sacrifica il Gremlin Rovinoso: Distruggi un artefatto bersaglio.\', \'type\': \'Creatura — Gremlin\', \'flavor\': \'Le autorità cittadine una volta inviarono venti automi nuovi di fabbrica per sterminare un covo di gremlin. Presto si resero conto di aver commesso un errore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419021&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'546ed1eb-fe3d-4f16-8180-e0a4cec230f4\', \'multiverseId\': 419021}, \'multiverseid\': 419021}, {\'name\': \'壊し屋グレムリン\', \'text\': \'{2}{R}, 壊し屋グレムリンを生け贄に捧げる：アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — グレムリン\', \'flavor\': \'市の役人がピカピカの自動機械を20台ほど送り込み、グレムリンの巣を一掃しようとしたことがある。そのやり方は失敗だと、すぐに明らかになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419285&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5505a16-aa32-47af-840d-c446b8a0266e\', \'multiverseId\': 419285}, \'multiverseid\': 419285}, {\'name\': \'파괴하는 그렘린\', \'text\': \'{2}{R}, 파괴하는 그렘린을 희생한다: 마법물체를 목표로 정한다. 그 마법물체를 파괴한다.\', \'type\': \'생물 — 그렘린\', \'flavor\': \'언젠가 시의 관리들이 그렘린 소굴을 쓸어버리기 위해 신형 자동장치 20대를 보냈다. 그들은 곧 그 판단이 틀렸음을 깨달았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419549&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f69cf6d3-39c8-4ebb-9b35-983c3e3a3920\', \'multiverseId\': 419549}, \'multiverseid\': 419549}, {\'name\': \'Gremlin Ruinoso\', \'text\': \'{2}{R}, Sacrifique Gremlin Ruinoso: Destrua o artefato alvo.\', \'type\': \'Criatura — Gremlin\', \'flavor\': \'Uma vez, as autoridades da cidade enviaram vinte autômatos reluzentes para exterminar um ninho de gremlins. Eles logo perceberam o erro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11ebaa91-280c-4cd1-bfba-b92c0921b6a1\', \'multiverseId\': 419813}, \'multiverseid\': 419813}, {\'name\': \'Гремлин-Крушитель\', \'text\': \'{2}{R}, пожертвуйте Гремлина-Крушителя: уничтожьте целевой артефакт.\', \'type\': \'Существо — Гремлин\', \'flavor\': \'Однажды городские власти отправили двадцать новеньких блестящих автоматов, чтобы истребить гнездо гремлинов. Очень скоро они осознали свою ошибку.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420077&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'32ca01d7-a881-4112-beb8-9b7fa3ee84d4\', \'multiverseId\': 420077}, \'multiverseid\': 420077}, {\'name\': \'毁坏怪灵\', \'text\': \'{2}{R}，牺牲毁坏怪灵：消灭目标神器。\', \'type\': \'生物～怪灵\', \'flavor\': \'市府官员曾派遣二十个亮闪闪的自动机械前去剿灭一群怪灵。他们很快发现这方法出了什么问题。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9e51ca32-8376-4097-a705-c175265c64e8\', \'multiverseId\': 417965}, \'multiverseid\': 417965}, {\'name\': \'毀壞怪靈\', \'text\': \'{2}{R}，犧牲毀壞怪靈：消滅目標神器。\', \'type\': \'生物～怪靈\', \'flavor\': \'市府官員曾派遣二十個亮閃閃的自動機械前去剿滅一群怪靈。他們很快發現這方法出了什麼問題。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418229&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2e609b0a-32f3-487d-8977-898a915f68b5\', \'multiverseId\': 418229}, \'multiverseid\': 418229}]', '[{\'name\': \'Kujar-Saatformerin\', \'text\': \'Wenn die Kujar-Saatformerin ins Spiel kommt, lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst.\', \'type\': \'Kreatur — Elf, Druide\', \'flavor\': \'Jedes Gebäude, jeder Baum und jedes Blatt in Kujar ist so ausgerichtet, dass entsprechend der elfischen Philosophie der Großen Verbindung die größtmögliche Harmonie erzielt wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'46b39dcd-78c1-4b33-ac63-ea7222770020\', \'multiverseId\': 418524}, \'multiverseid\': 418524}, {\'name\': \'Esculpesemillas de Kujar\', \'text\': \'Cuando el Esculpesemillas de Kujar entre al campo de batalla, pon un contador +1/+1 sobre la criatura objetivo que controlas.\', \'type\': \'Criatura — Druida elfo\', \'flavor\': \'Cada hoja, árbol y edificio de Kujar están colocados para infundir la máxima armonía, de acuerdo con la filosofía élfica conocida como la Panconexión.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420372&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af2f0cec-5aec-44d8-8e50-c7b523c6fb06\', \'multiverseId\': 420372}, \'multiverseid\': 420372}, {\'name\': \'Entailleuse de graine de Kujar\', \'text\': "Quand l\'Entailleuse de graine de Kujar arrive sur le champ de bataille, mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez.", \'type\': \'Créature : elfe et druide\', \'flavor\': "L\'emplacement de chaque feuille, chaque arbre et chaque édifice de Kujar a été choisi pour atteindre l\'harmonie parfaite décrite dans la philosophie elfe du Grand conduit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418788&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6dc4625-9968-4640-9977-74783ae0daa4\', \'multiverseId\': 418788}, \'multiverseid\': 418788}, {\'name\': \'Plasmasemi di Kujar\', \'text\': \'Quando la Plasmasemi di Kujar entra nel campo di battaglia, metti un segnalino +1/+1 su una creatura bersaglio che controlli.\', \'type\': \'Creatura — Druido Elfo\', \'flavor\': "Le foglie, gli alberi e gli edifici di Kujar sono tutti stati collocati per favorire l\'armonia, in base ai dettami della filosofia elfica del Grande Flusso.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f04d013-6ac2-4ccd-aa90-2d849963d4ed\', \'multiverseId\': 419052}, \'multiverseid\': 419052}, {\'name\': \'クジャールの種子彫刻家\', \'text\': \'クジャールの種子彫刻家が戦場に出たとき、あなたがコントロールするクリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — エルフ・ドルイド\', \'flavor\': \'クジャールでは、木々も葉も建物も最大の調和をもたらすように、大導路と呼ばれるエルフの哲学に基づいて配置されている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419316&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4017bc36-8e5b-41ee-a15c-e809409d5b1b\', \'multiverseId\': 419316}, \'multiverseid\': 419316}, {\'name\': \'쿠자르 종자조각가\', \'text\': \'쿠자르 종자조각가가 전장에 들어올 때, 당신이 조종하는 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 엘프 드루이드\', \'flavor\': \'찬란한 수로로 알려진 엘프의 철학을 바탕으로 쿠자르에 있는 잎사귀, 나무, 건물 모두가 완벽한 조화를 이루고 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419580&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'37939831-b6de-47d3-8fec-8a999f4401c1\', \'multiverseId\': 419580}, \'multiverseid\': 419580}, {\'name\': \'Escultora de Sementes de Kujar\', \'text\': \'Quando Escultora de Sementes de Kujar entrar no campo de batalha, coloque um marcador +1/+1 na criatura alvo que você controla.\', \'type\': \'Criatura — Elfo Druida\', \'flavor\': \'Todas as folhas, as árvores e os prédios em Kujar foram posicionados de modo a favorecer a máxima harmonia, conforme a filosofia élfica conhecida como o Grande Conduíte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6455ca7d-ef77-4bdf-b463-def18b3eea25\', \'multiverseId\': 419844}, \'multiverseid\': 419844}, {\'name\': \'Куджарская Ваятельница Деревьев\', \'text\': \'Когда Куджарская Ваятельница Деревьев выходит на поле битвы, положите один жетон +1/+1 на целевое существо под вашим контролем.\', \'type\': \'Существо — Эльф Друид\', \'flavor\': \'Каждый лист, дерево и строение в Куджаре размещены так, чтобы достичь максимальной гармонии, следуя эльфийской философии Великого Канала.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420108&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec1872e9-756a-4dd1-9e94-2ce0e64fffa7\', \'multiverseId\': 420108}, \'multiverseid\': 420108}, {\'name\': \'库贾塑碧匠\', \'text\': \'当库贾塑碧匠进战场时，在目标由你操控的生物上放置一个+1/+1指示物。\', \'type\': \'生物～妖精／德鲁伊\', \'flavor\': \'库贾的每片叶子，每棵树和每栋建筑都依称为大通联的妖精哲学安排，达到完美和谐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417996&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a19f8c80-1921-4146-a119-a8acfe6bda83\', \'multiverseId\': 417996}, \'multiverseid\': 417996}, {\'name\': \'庫賈塑碧匠\', \'text\': \'當庫賈塑碧匠進戰場時，在目標由你操控的生物上放置一個+1/+1指示物。\', \'type\': \'生物～妖精／德魯伊\', \'flavor\': \'庫賈的每片葉子，每棵樹和每棟建築都依稱為大通聯的妖精哲學安排，達到完美和諧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418260&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'337ccfa6-7023-45db-b95a-8e1adae376f8\', \'multiverseId\': 418260}, \'multiverseid\': 418260}]', '[{\'name\': \'Kuriositätenhändlerin\', \'type\': \'Kreatur — Vedalken\', \'flavor\': \'„Tritt näher! Nimm es in die Hand! Es belebt die Sinne und sprengt den Verstand!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418407&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c24517d-edd5-4091-aa41-9135610cbf6c\', \'multiverseId\': 418407}, \'multiverseid\': 418407}, {\'name\': \'Vendedora de rarezas\', \'type\': \'Criatura — Vedalken\', \'flavor\': \'"¡Suban al escenario, pruébenlo sin reparo! ¡Los dejará con la boca abierta!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420255&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd8f0c56-02b4-4e73-a7c5-032430fe1c52\', \'multiverseId\': 420255}, \'multiverseid\': 420255}, {\'name\': \'Vendeuse de bibelots\', \'type\': \'Créature : vedalken\', \'flavor\': "« Approchez, approchez ! Tendez votre main ! Vous n\'en croirez pas vos sens ni votre tête ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418671&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a376338a-be3b-4611-829b-4cb3148e9ab8\', \'multiverseId\': 418671}, \'multiverseid\': 418671}, {\'name\': \'Venditrice di Curiosità\', \'type\': \'Creatura — Vedalken\', \'flavor\': \'"Avvicinatevi e toccate con mano! Può elettrizzare i sensi e confondere la mente!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'451c4ac5-1db3-44ca-9180-75d0465bebba\', \'multiverseId\': 418935}, \'multiverseid\': 418935}, {\'name\': \'珍品売り\', \'type\': \'クリーチャー — ヴィダルケン\', \'flavor\': \'「いらっしゃい、いらっしゃい！自分の手で試してみてよ！わくわくして、びっくりするわよ。間違いなし！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419199&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7f9d88e-80a6-42b5-a021-3fb6c5070369\', \'multiverseId\': 419199}, \'multiverseid\': 419199}, {\'name\': \'골동품 장수\', \'type\': \'생물 — 베달켄\', \'flavor\': \'"앞으로 나와서 한번 사용해 보세요! 아마 깜짝 놀라실 겁니다!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419463&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0571b938-0979-4011-8bb7-69b5b869bd13\', \'multiverseId\': 419463}, \'multiverseid\': 419463}, {\'name\': \'Vendedora de Raridades\', \'type\': \'Criatura — Vedalkeano\', \'flavor\': \'"Aproxime-se! Experimente! Prepare-se para fortes emoções!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419727&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d3aa303-5996-42ee-832c-1f6d9828f16c\', \'multiverseId\': 419727}, \'multiverseid\': 419727}, {\'name\': \'Торговка Редкостями\', \'type\': \'Существо — Ведалкен\', \'flavor\': \'«Подходите! Попробуйте сами! Пощекочите себе нервы и пошевелите мозгами!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419991&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a7a6f5a0-9d81-40d2-b8cf-b2a245742b8e\', \'multiverseId\': 419991}, \'multiverseid\': 419991}, {\'name\': \'古物贩商\', \'type\': \'生物～维多肯\', \'flavor\': \'「走上前来！亲手试试！它能让你为之震撼，大开眼界！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417879&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5cddbfb-e1c3-4fff-b559-5063ec932a3a\', \'multiverseId\': 417879}, \'multiverseid\': 417879}, {\'name\': \'古物販商\', \'type\': \'生物～維多肯\', \'flavor\': \'「走上前來！親手試試！它能讓你為之震撼，大開眼界！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418143&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4519b7fd-5b56-4864-a71d-30bd53b14418\', \'multiverseId\': 418143}, \'multiverseid\': 418143}]', '[{\'name\': \'Kuttengrund-Beutesammler\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Konsulatwachen, die flüchtige Renegaten bis in den Kuttengrund verfolgen, verirren sich oft — manchmal für immer — in der wildesten Grünzone der Stadt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418514&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c224cc56-854e-49c4-8282-80977054f78b\', \'multiverseId\': 418514}, \'multiverseid\': 418514}, {\'name\': \'Reptador de Cogulla\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'Los guardias del Consulado que persiguen a los renegados por la Cogulla se pierden a menudo —y a veces para siempre— en el salvaje cinturón verde que rodea la ciudad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420362&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34ee2b87-6e5a-4291-b0a2-3ad8a00f61d8\', \'multiverseId\': 420362}, \'multiverseid\': 420362}, {\'name\': "Rôdeur de l\'Auvent", \'type\': \'Créature : guivre\', \'flavor\': "Les gardes du Consulat poursuivant les renégats en fuite dans l\'Auvent se perdent souvent, et parfois définitivement, dans la ceinture de verdure la plus sauvage de la ville.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418778&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2f5a7f3c-1c85-408f-880f-4727433297ab\', \'multiverseId\': 418778}, \'multiverseid\': 418778}, {\'name\': \'Predatore della Cappa\', \'type\': \'Creatura — Wurm\', \'flavor\': \'Le guardie consolari che inseguono i rinnegati attraverso la Cappa si perdono spesso, talvolta irrimediabilmente, in questa selvaggia fascia di vegetazione nel mezzo della città.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419042&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e7e5de3-5f73-47bb-99b5-9e996581ffb7\', \'multiverseId\': 419042}, \'multiverseid\': 419042}, {\'name\': \'僧帽地帯をうろつくもの\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'領事府の警護員が逃げる改革派を追って僧帽地帯に入っても、大抵は道に迷う。巨大な緑地帯から戻って来ないこともある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419306&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec3c58dd-20a1-47bf-82ca-3aa0862f94e3\', \'multiverseId\': 419306}, \'multiverseid\': 419306}, {\'name\': \'카울 배회자\', \'type\': \'생물 — 웜\', \'flavor\': \'카울로 도망치는 무법자들을 쫓는 영사관 경비병들은 가장 야생적인 녹지대에서 종종 길을 잃거나 영원히 사라지는 경우가 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419570&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a69f4b4a-688d-48e3-a241-6644149b21dd\', \'multiverseId\': 419570}, \'multiverseid\': 419570}, {\'name\': \'Rastejador do Capote\', \'type\': \'Criatura — Vorme\', \'flavor\': \'Os guardas do Consulado que perseguem renegados fugitivos dentro do Capote muitas vezes se perdem — às vezes permanentemente — no cinturão verde mais selvagem da cidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66fdb5e6-84e6-4d88-bc41-da530549fcb3\', \'multiverseId\': 419834}, \'multiverseid\': 419834}, {\'name\': \'Охотник из Покрова\', \'type\': \'Существо — Вурм\', \'flavor\': \'Стражники Консульства, преследующие отступников в Покрове, часто теряются в самом большом из зеленых поясов города — и бывает, что навсегда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420098&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fab5fab9-a868-48a3-ab3f-f667218019c2\', \'multiverseId\': 420098}, \'multiverseid\': 420098}, {\'name\': \'外沿区游掠亚龙\', \'type\': \'生物～亚龙\', \'flavor\': \'执政院守卫因追捕逃走的乱匠而进入外沿区后，经常在这片城市最荒蛮的绿地迷途，甚至永远失踪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417986&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2cbb3f2a-d45d-4cb6-99db-38c47dec212b\', \'multiverseId\': 417986}, \'multiverseid\': 417986}, {\'name\': \'外沿區遊掠亞龍\', \'type\': \'生物～亞龍\', \'flavor\': \'執政院守衛因追捕逃走的亂匠而進入外沿區後，經常在這片城市最荒蠻的綠地迷途，甚至永遠失蹤。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418250&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1d6e2dff-c698-4ea0-8712-dddd6a11b001\', \'multiverseId\': 418250}, \'multiverseid\': 418250}]', '[{\'name\': \'Langflossen-Himmelswal\', \'text\': \'Fliegend\\nDer Langflossen-Himmelswal kann nur fliegende Kreaturen blocken.\', \'type\': \'Kreatur — Wal\', \'flavor\': \'Die Äthersphäre beheimatet die wundersamsten Wesen von ganz Kaladesh, doch aufgrund der dort lauernden Gefahren sind sie nahezu unerforscht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418419&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e8c8f6fa-fd22-4246-89fc-bbb893e32791\', \'multiverseId\': 418419}, \'multiverseid\': 418419}, {\'name\': \'Ballena celeste de aleta larga\', \'text\': \'Vuela.\\nLa Ballena celeste de aleta larga solo puede bloquear a criaturas con la habilidad de volar.\', \'type\': \'Criatura — Ballena\', \'flavor\': \'En la eteresfera viven muchos de los seres más maravillosos de Kaladesh, aunque los peligros de atravesarla indican que aún no se sabe mucho de ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420267&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a48fc7b8-de3a-455c-83e7-668b75514fe3\', \'multiverseId\': 420267}, \'multiverseid\': 420267}, {\'name\': \'Baleine volante à longues nageoires\', \'text\': \'Vol\\nLa Baleine volante à longues nageoires ne peut bloquer que les créatures avec le vol.\', \'type\': \'Créature : baleine\', \'flavor\': "Les êtres les plus extraordinaires de Kaladesh vivent dans l\'Éthersphère, mais les dangers de la traversée font qu\'on ne sait presque rien à leur sujet.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ab5e79f-a137-465a-ad10-cf26598dd92a\', \'multiverseId\': 418683}, \'multiverseid\': 418683}, {\'name\': \'Aviobalena Pinnalunga\', \'text\': "Volare\\nL\'Aviobalena Pinnalunga può bloccare solo le creature con volare.", \'type\': \'Creatura — Balena\', \'flavor\': "L\'etersfera ospita le creature più straordinarie di tutto Kaladesh, ma i pericoli insiti nella sua esplorazione limitano le conoscenze sulla sua fauna.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418947&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f8ace994-3609-4ef4-a9e1-460ff601b90d\', \'multiverseId\': 418947}, \'multiverseid\': 418947}, {\'name\': \'ヒレナガ空鯨\', \'text\': \'飛行\\nヒレナガ空鯨は、飛行を持つクリーチャーのみをブロックできる。\', \'type\': \'クリーチャー — 鯨\', \'flavor\': \'カラデシュの霊気圏には驚異的な生き物が多数生息しているが、それらは未知の部分が多いため、そこを訪れるのは危険である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419211&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c6adf06-6882-4e96-86bd-5713f7d46564\', \'multiverseId\': 419211}, \'multiverseid\': 419211}, {\'name\': \'긴지느러미 하늘고래\', \'text\': \'비행\\n긴지느러미 하늘고래는 비행을 가진 생물만 방어할 수 있다.\', \'type\': \'생물 — 고래\', \'flavor\': \'칼라데시의 신비한 존재들 대부분이 에테르권에 살지만, 에테르권을 횡단하는 것은 매우 위험하기 때문에 그들의 정체는 알려진 것이 거의 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419475&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ff27060c-0ca5-4a9c-9164-a46911ba3014\', \'multiverseId\': 419475}, \'multiverseid\': 419475}, {\'name\': \'Aerobaleia-de-aleta-longa\', \'text\': \'Voar\\nAerobaleia-de-aleta-longa só pode bloquear criaturas com voar.\', \'type\': \'Criatura — Baleia\', \'flavor\': \'A eteresfera é o lar das criaturas mais fantásticas de toda a Kaladesh, embora os perigos de atravessá-la signifiquem que não se sabe muito sobre elas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419739&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0cc4835-ab24-4b04-ab3d-f4542237d868\', \'multiverseId\': 419739}, \'multiverseid\': 419739}, {\'name\': \'Длиннокрылый Небесный Кит\', \'text\': \'Полет\\nДлиннокрылый Небесный Кит может блокировать только существа с Полетом.\', \'type\': \'Существо — Кит\', \'flavor\': \'Эфиросфера — дом самых удивительных созданий на всем Каладеше, но это настолько опасное место, что об его обитателях известно совсем немногое.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420003&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ece8429-e593-4d38-9dbc-b065af80a633\', \'multiverseId\': 420003}, \'multiverseid\': 420003}, {\'name\': \'长鳍飞鲸\', \'text\': \'飞行\\n长鳍飞鲸只能阻挡具飞行异能的生物。\', \'type\': \'生物～鲸鱼\', \'flavor\': \'卡拉德许时空中最奇妙的生物栖息在乙太层中，但由于穿行乙太层间过于危险，人们对这些生物所知甚少。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417891&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66407957-2ef5-4164-8728-98642e771e06\', \'multiverseId\': 417891}, \'multiverseid\': 417891}, {\'name\': \'長鰭飛鯨\', \'text\': \'飛行\\n長鰭飛鯨只能阻擋具飛行異能的生物。\', \'type\': \'生物～鯨魚\', \'flavor\': \'卡拉德許時空中最奇妙的生物棲息在乙太層中，但由於穿行乙太層間過於危險，因此人們對這些生物所知甚少。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418155&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6f6ffc8b-9ab3-4482-a748-5e7f39bb62c8\', \'multiverseId\': 418155}, \'multiverseid\': 418155}]', '[{\'name\': \'Langlebiges Handwerk\', \'text\': \'Immer wenn eine Kreatur unter deiner Kontrolle ins Spiel kommt, kannst du {1} bezahlen. Falls du dies tust, lege eine +1/+1-Marke auf jene Kreatur.\\n{5}{G}, opfere das Langlebige Handwerk: Lege eine +1/+1-Marke auf jede Kreatur, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418518&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'474dc048-8193-4d22-aed9-088da94f0912\', \'multiverseId\': 418518}, \'multiverseid\': 418518}, {\'name\': \'Artesanía imperecedera\', \'text\': \'Siempre que una criatura entre al campo de batalla bajo tu control, puedes pagar {1}. Si lo haces, pon un contador +1/+1 sobre esa criatura.\\n{5}{G}, sacrificar la Artesanía imperecedera: Pon un contador +1/+1 sobre cada criatura que controlas.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420366&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74a6efba-1fbe-4f81-b006-3b05d1913282\', \'multiverseId\': 420366}, \'multiverseid\': 420366}, {\'name\': \'Artisanat durable\', \'text\': "À chaque fois qu\'une créature arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {1}. Si vous faites ainsi, mettez un marqueur +1/+1 sur cette créature.\\n{5}{G}, sacrifiez l\'Artisanat durable : Mettez un marqueur +1/+1 sur chaque créature que vous contrôlez.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418782&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'70797b4e-2952-4fdb-8eac-3449f110b52d\', \'multiverseId\': 418782}, \'multiverseid\': 418782}, {\'name\': \'Artigianato Durevole\', \'text\': "Ogniqualvolta una creatura entra nel campo di battaglia sotto il tuo controllo, puoi pagare {1}. Se lo fai, metti un segnalino +1/+1 su di essa.\\n{5}{G}, Sacrifica l\'Artigianato Durevole: Metti un segnalino +1/+1 su ogni creatura che controlli.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50b64d67-583d-4559-a5d8-6bdc7a8c2ee0\', \'multiverseId\': 419046}, \'multiverseid\': 419046}, {\'name\': \'丈夫な手工品\', \'text\': \'クリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたは{1}を支払ってもよい。そうしたなら、そのクリーチャーの上に＋１/＋１カウンターを１個置く。\\n{5}{G}, 丈夫な手工品を生け贄に捧げる：あなたがコントロールする各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419310&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'11d2fb07-f68f-40da-a6d3-68d8b660cbe7\', \'multiverseId\': 419310}, \'multiverseid\': 419310}, {\'name\': \'튼튼한 수제품\', \'text\': \'생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 {1}을 지불할 수 있다. 그렇게 한다면, 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\\n{5}{G}, 튼튼한 수제품을 희생한다: 당신이 조종하는 각 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419574&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'de8706af-a932-4f67-ba67-0284c4c88b6e\', \'multiverseId\': 419574}, \'multiverseid\': 419574}, {\'name\': \'Artesanato Durável\', \'text\': \'Toda vez que uma criatura entra no campo de batalha sob seu controle, você pode pagar {1}. Se fizer isso, coloque um marcador +1/+1 naquela criatura.\\n{5}{G}, Sacrifique Artesanato Durável: Coloque um marcador +1/+1 em cada criatura que você controla.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419838&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8f94981c-b385-49b8-9cdb-f3971fe7fb16\', \'multiverseId\': 419838}, \'multiverseid\': 419838}, {\'name\': \'Надежная Работа\', \'text\': \'Каждый раз, когда существо выходит на поле битвы под вашим контролем, вы можете заплатить {1}. Если вы это делаете, положите один жетон +1/+1 на то существо.\\n{5}{G}, пожертвуйте Надежную Работу: положите один жетон +1/+1 на каждое существо под вашим контролем.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420102&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59076bda-c439-480b-9df8-260f8f25de0b\', \'multiverseId\': 420102}, \'multiverseid\': 420102}, {\'name\': \'可靠手艺\', \'text\': \'每当一个生物在你的操控下进战场时，你可以支付{1}。若你如此作，则在该生物上放置一个+1/+1指示物。\\n{5}{G}，牺牲可靠手艺：在每个由你操控的生物上各放置一个+1/+1指示物。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417990&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5976f7cb-1f20-44bb-8413-91374efdce2a\', \'multiverseId\': 417990}, \'multiverseid\': 417990}, {\'name\': \'可靠手藝\', \'text\': \'每當一個生物在你的操控下進戰場時，你可以支付{1}。若你如此作，則在該生物上放置一個+1/+1指示物。\\n{5}{G}，犧牲可靠手藝：在每個由你操控的生物上各放置一個+1/+1指示物。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418254&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bba8c280-614e-43c4-8a16-522a0c3351f6\', \'multiverseId\': 418254}, \'multiverseid\': 418254}]', "[{'name': 'Langzahn-Junges', 'text': 'Immer wenn das Langzahn-Junge einem Spieler Kampfschaden zufügt, erhältst du {E}{E} (zwei Energiemarken).\\nBezahle {E}{E}: Lege eine +1/+1-Marke auf das Langzahn-Junge.', 'type': 'Kreatur — Katze', 'flavor': 'Es wächst schon noch.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418526&type=card', 'language': 'German', 'identifiers': {'scryfallId': '78447f55-fd5e-4a42-b368-a61059034c90', 'multiverseId': 418526}, 'multiverseid': 418526}, {'name': 'Cachorro de dientelargo', 'text': 'Siempre que el Cachorro de dientelargo haga daño de combate a un jugador, obtienes {E}{E} (dos contadores de energía).\\nPagar {E}{E}: Pon un contador +1/+1 sobre el Cachorro de dientelargo.', 'type': 'Criatura — Felino', 'flavor': 'No siempre será pequeño.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420374&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6e698222-b5ae-4612-bebe-b015526e6fec', 'multiverseId': 420374}, 'multiverseid': 420374}, {'name': 'Jeune tigre à défenses de sabre', 'text': 'À chaque fois que le Jeune tigre à défenses de sabre inflige des blessures de combat à un joueur, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nPayez {E}{E} : Mettez un marqueur +1/+1 sur le Jeune tigre à défenses de sabre.', 'type': 'Créature : chat', 'flavor': 'Il ne restera pas petit toute sa vie.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418790&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8829469c-4207-46eb-b3a8-ae826ab07998', 'multiverseId': 418790}, 'multiverseid': 418790}, {'name': 'Cucciolo di Zannalunga', 'text': 'Ogniqualvolta il Cucciolo di Zannalunga infligge danno da combattimento a un giocatore, ottieni {E}{E} (due segnalini energia).\\nPaga {E}{E}: Metti un segnalino +1/+1 sul Cucciolo di Zannalunga.', 'type': 'Creatura — Felino', 'flavor': 'Non resterà piccolo per sempre.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419054&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '98eb636f-5111-45d4-94a9-4f203eecffe7', 'multiverseId': 419054}, 'multiverseid': 419054}, {'name': '牙長獣の仔', 'text': '牙長獣の仔がプレイヤー１人に戦闘ダメージを与えるたび、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n{E}{E}を支払う：牙長獣の仔の上に＋１/＋１カウンターを１個置く。', 'type': 'クリーチャー — 猫', 'flavor': 'いつまでも小さくはない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419318&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '15efb968-dd98-4268-8e1a-372093230570', 'multiverseId': 419318}, 'multiverseid': 419318}, {'name': '긴엄니 새끼 맹수', 'text': '긴엄니 새끼 맹수가 플레이어에게 전투피해를 입힐 때마다, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n{E}{E}를 지불한다: 긴엄니 새끼 맹수에 +1/+1 카운터 한 개를 올려놓는다.', 'type': '생물 — 고양이', 'flavor': '이 녀석은 금세 성장한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419582&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8f6ad62b-82d4-4c0a-9971-299068949b85', 'multiverseId': 419582}, 'multiverseid': 419582}, {'name': 'Filhote Presalonga', 'text': 'Toda vez que Filhote Presalonga causa dano de combate a um jogador, você recebe {E}{E} (dois marcadores de energia).\\nPague {E}{E}: Coloque um marcador +1/+1 em Filhote Presalonga.', 'type': 'Criatura — Felino', 'flavor': 'Ele não vai ser pequeno para sempre.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419846&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '23218eb7-d701-4fd8-a366-f168da468905', 'multiverseId': 419846}, 'multiverseid': 419846}, {'name': 'Детеныш Саблебивня', 'text': 'Каждый раз, когда Детеныш Саблебивня наносит боевые повреждения игроку, вы получаете {E}{E} (два жетона энергии).\\nЗаплатите {E}{E}: положите один жетон +1/+1 на Детеныша Саблебивня.', 'type': 'Существо — Кошка', 'flavor': 'Он не навсегда останется маленьким.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420110&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2b219e00-7766-46ff-82ea-9d4d36e0c12c', 'multiverseId': 420110}, 'multiverseid': 420110}, {'name': '长牙幼兽', 'text': '每当长牙幼兽对任一牌手造成战斗伤害时，你得到{E}{E}（两个能量指示物）。\\n支付{E}{E}：在长牙幼兽上放置一个+1/+1指示物。', 'type': '生物～猫', 'flavor': '它不会一直这么小。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417998&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '752a4358-1465-4b33-ae07-59cde3609976', 'multiverseId': 417998}, 'multiverseid': 417998}, {'name': '長牙幼獸', 'text': '每當長牙幼獸對任一玩家造成戰鬥傷害時，你得到{E}{E}（兩個能量指示物）。\\n支付{E}{E}：在長牙幼獸上放置一個+1/+1指示物。', 'type': '生物～貓', 'flavor': '牠不會一直這麼小。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418262&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '5fbf6460-17f9-4651-a179-9f462a3db5b3', 'multiverseId': 418262}, 'multiverseid': 418262}]", '[{\'name\': \'Lathnu-Teufelsbraten\', \'text\': \'Eile\\nWenn der Lathnu-Teufelsbraten ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nOpfere zu Beginn deines Endsegments den Lathnu-Teufelsbraten, es sei denn, du bezahlst {E}{E}.\', \'type\': \'Kreatur — Teufelsbraten\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20b675d7-8730-4a0d-94ff-a60a745c3f70\', \'multiverseId\': 418486}, \'multiverseid\': 418486}, {\'name\': \'Infernal de Lathnu\', \'text\': \'Prisa.\\nCuando el Infernal de Lathnu entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nAl comienzo de tu paso final, sacrifica el Infernal de Lathnu a menos que pagues {E}{E}.\', \'type\': \'Criatura — Infernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420334&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dbe1494d-2445-4b29-af13-226742e9b4f0\', \'multiverseId\': 420334}, \'multiverseid\': 420334}, {\'name\': \'Monstruosité de Lathnu\', \'text\': \'Célérité\\nQuand la Monstruosité de Lathnu arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nAu début de votre étape de fin, sacrifiez la Monstruosité de Lathnu à moins que vous ne payiez {E}{E}.\', \'type\': \'Créature : monstruosité\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54a0d7ca-d2c0-4fa2-9c2b-52d9f7c88511\', \'multiverseId\': 418750}, \'multiverseid\': 418750}, {\'name\': \'Infernale di Lathnu\', \'text\': "Rapidità\\nQuando l\'Infernale di Lathnu entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nAll\'inizio della tua sottofase finale, sacrifica l\'Infernale di Lathnu a meno che non paghi {E}{E}.", \'type\': \'Creatura — Infernale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419014&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b4e27829-9b5e-4241-8856-d6145b74107e\', \'multiverseId\': 419014}, \'multiverseid\': 419014}, {\'name\': \'ラスヌーのヘリオン\', \'text\': \'速攻\\nラスヌーのヘリオンが戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\nあなたの終了ステップの開始時に、あなたが{E}{E}を支払わないかぎり、ラスヌーのヘリオンを生け贄に捧げる。\', \'type\': \'クリーチャー — ヘリオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419278&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5119cc1d-9c49-4eb0-8e90-f645df30068f\', \'multiverseId\': 419278}, \'multiverseid\': 419278}, {\'name\': \'라스누 헬리온\', \'text\': \'신속\\n라스누 헬리온이 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n당신의 종료단 시작에, 당신이 {E}{E}를 지불하지 않으면 라스누 헬리온을 희생한다.\', \'type\': \'생물 — 헬리온\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419542&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'be9b067b-dced-4bd9-a2f1-723563f25ae1\', \'multiverseId\': 419542}, \'multiverseid\': 419542}, {\'name\': \'Avernal de Lathnu\', \'text\': \'Ímpeto\\nQuando Avernal de Lathnu entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nNo início de sua etapa final, sacrifique Avernal de Lathnu, a menos que você pague {E}{E}.\', \'type\': \'Criatura — Avernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419806&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb09a6d4-e45b-400d-89e2-4aa76bbe3020\', \'multiverseId\': 419806}, \'multiverseid\': 419806}, {\'name\': \'Геллион из Латну\', \'text\': \'Ускорение\\nКогда Геллион из Латну выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nВ начале вашего заключительного шага пожертвуйте Геллиона из Латну, если только вы не заплатите {E}{E}.\', \'type\': \'Существо — Геллион\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420070&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5a837aa5-8655-4440-aee6-a62aa9eeb640\', \'multiverseId\': 420070}, \'multiverseid\': 420070}, {\'name\': \'勒图地狱兽\', \'text\': \'敏捷\\n当勒图地狱兽进战场时，你得到{E}{E}（两个能量指示物）。\\n在你的结束步骤开始时，除非你支付{E}{E}，否则牺牲勒图地狱兽。\', \'type\': \'生物～地狱兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417958&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'295875ad-2d25-49df-9784-fe6b006ce046\', \'multiverseId\': 417958}, \'multiverseid\': 417958}, {\'name\': \'勒圖地獄獸\', \'text\': \'敏捷\\n當勒圖地獄獸進戰場時，你得到{E}{E}（兩個能量指示物）。\\n在你的結束步驟開始時，除非你支付{E}{E}，否則犧牲勒圖地獄獸。\', \'type\': \'生物～地獄獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418222&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5025445a-859c-4174-bd7f-86ae03b05dbe\', \'multiverseId\': 418222}, \'multiverseid\': 418222}]', '[{\'name\': \'Lauf der Natur\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält Wachsamkeit und verursacht Trampelschaden bis zum Ende des Zuges. Sie fügt einer Kreatur deiner Wahl, die du nicht kontrollierst, Schadenspunkte in Höhe ihrer Stärke zu.\', \'type\': \'Hexerei\', \'flavor\': \'Viele Elfen vereinigen die Schönheit der Natur mit ihren Erfindungen. Aber nur wenige fangen ihre Wildheit ein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418527&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9aff89d-3e23-42bf-9b59-1de520beb96a\', \'multiverseId\': 418527}, \'multiverseid\': 418527}, {\'name\': \'Método natural\', \'text\': \'La criatura objetivo que controlas gana las habilidades de vigilancia y arrollar hasta el final del turno. Hace una cantidad de daño igual a su fuerza a la criatura objetivo que no controlas.\', \'type\': \'Conjuro\', \'flavor\': \'Muchos elfos incorporan la belleza de la naturaleza en sus inventos, pero pocos reflejan su brutalidad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420375&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'65fd0490-01df-4ef3-a54a-93fc1fc67e10\', \'multiverseId\': 420375}, \'multiverseid\': 420375}, {\'name\': \'Procédé naturel\', \'text\': "La créature ciblée que vous contrôlez acquiert la vigilance et le piétinement jusqu\'à la fin du tour. Elle inflige un nombre de blessures égal à sa force à une créature ciblée que vous ne contrôlez pas.", \'type\': \'Rituel\', \'flavor\': \'De nombreux elfes intègrent la beauté de la nature dans leurs inventions. Peu parviennent à capturer sa sauvagerie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418791&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'881f1551-2103-49e2-8b27-c5b1c623b330\', \'multiverseId\': 418791}, \'multiverseid\': 418791}, {\'name\': \'Legge di Natura\', \'text\': \'Una creatura bersaglio che controlli ha cautela e travolgere fino alla fine del turno. Infligge danno pari alla sua forza a una creatura bersaglio che non controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'Molti elfi infondono la bellezza della natura nelle proprie invenzioni. Pochissimi, invece, sanno catturarne la ferocia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419055&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8699fc2d-0864-470d-a5bb-b1d0bc65dcc0\', \'multiverseId\': 419055}, \'multiverseid\': 419055}, {\'name\': \'自然の流儀\', \'text\': \'あなたがコントロールするクリーチャー１体と、あなたがコントロールしていないクリーチャー１体を対象とする。ターン終了時まで、その前者は警戒とトランプルを得る。その前者はその後者に、自身のパワーに等しい点数のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'エルフの発明には、大抵、自然の美が活かされている。ごく一部には、自然の残酷な側面が表れたものもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419319&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02a412cf-659e-4aea-a9b7-6e58f634b2e1\', \'multiverseId\': 419319}, \'multiverseid\': 419319}, {\'name\': \'자연의 방식\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 경계와 돌진을 얻는다. 당신이 조종하지 않는 생물을 목표로 정한다. 첫 번째 목표는 두 번째 목표에게 자신의 공격력만큼의 피해를 입힌다.\', \'type\': \'집중마법\', \'flavor\': \'많은 엘프들이 자신의 발명품에 자연의 아름다움을 투영한다. 하지만 극히 일부는 자연의 야만성을 담는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419583&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'12473f6e-4131-40c9-88ec-e9590d7adeb3\', \'multiverseId\': 419583}, \'multiverseid\': 419583}, {\'name\': \'Método Natural\', \'text\': \'A criatura alvo que você controla ganha vigilância e atropelar até o final do turno. Ela causa uma quantidade de dano igual ao próprio poder à criatura alvo que você não controla.\', \'type\': \'Feitiço\', \'flavor\': \'Muitos elfos incorporam a beleza da natureza em suas invenções. Muito poucos capturam sua ferocidade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419847&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1cd1a9e-0942-4f9b-be25-31e8ec9c3de2\', \'multiverseId\': 419847}, \'multiverseid\': 419847}, {\'name\': \'Путь Природы\', \'text\': \'Целевое существо под вашим контролем получает Бдительность и Пробивной удар до конца хода. Оно наносит повреждения, равные своей силе, целевому существу не под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'Многие эльфы в своих изобретениях стараются передать красоту природы. И лишь некоторые раскрывают ее свирепость.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420111&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2d4b245b-d416-4276-a8a9-9cbf59a1d545\', \'multiverseId\': 420111}, \'multiverseid\': 420111}, {\'name\': \'自然之道\', \'text\': \'直到回合结束，目标由你操控的生物获得警戒与践踏异能。它对目标不由你操控的生物造成伤害，其数量等同于前者的力量。\', \'type\': \'法术\', \'flavor\': \'许多妖精将自然之美融入其发明。只有极少数掌握了它的野性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417999&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5f6d6c9-6c48-4b68-b367-068acdabcfe3\', \'multiverseId\': 417999}, \'multiverseid\': 417999}, {\'name\': \'自然之道\', \'text\': \'直到回合結束，目標由你操控的生物獲得警戒與踐踏異能。它對目標不由你操控的生物造成傷害，其數量等同於前者的力量。\', \'type\': \'巫術\', \'flavor\': \'許多妖精將自然之美融入其發明。只有極少數掌握了它的野性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418263&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'08accd0c-c4c0-4232-9fb5-5919744b7cb3\', \'multiverseId\': 418263}, \'multiverseid\': 418263}]', '[{\'name\': \'Lebe schnell\', \'text\': \'Du ziehst zwei Karten, verlierst 2 Lebenspunkte und erhältst {E}{E} (zwei Energiemarken).\', \'type\': \'Hexerei\', \'flavor\': \'„Ergreif die Gelegenheit beim Schopf. Lache, singe, tanze. Die Nacht soll niemals enden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418452&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae0b7a72-6c44-4da7-ad7c-1be1f47f5e7b\', \'multiverseId\': 418452}, \'multiverseid\': 418452}, {\'name\': \'Carpe diem\', \'text\': \'Robas dos cartas, pierdes 2 vidas y obtienes {E}{E} (dos contadores de energía).\', \'type\': \'Conjuro\', \'flavor\': \'"Cuando se te presente la oportunidad, tómala. Ríe, canta, baila. No dejes que termine la noche".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420300&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dde00a13-f9e8-45ea-acca-94635976f89c\', \'multiverseId\': 420300}, \'multiverseid\': 420300}, {\'name\': \'Vivre dangereusement\', \'text\': \'Vous piochez deux cartes, perdez 2 points de vie et gagnez {E}{E} (deux marqueurs « énergie »).\', \'type\': \'Rituel\', \'flavor\': \'« Quand la chance vous sourit, saisissez-la. Riez, chantez, dansez. Ne laissez pas la nuit se terminer. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418716&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'975cd092-38f4-4e21-adde-5fcb668bbe9e\', \'multiverseId\': 418716}, \'multiverseid\': 418716}, {\'name\': \'Vita Spericolata\', \'text\': \'Pesca due carte, perdi 2 punti vita e ottieni {E}{E} (due segnalini energia).\', \'type\': \'Stregoneria\', \'flavor\': \'"Quando si presenta l\\\'opportunità, coglila. Ridi, canta, danza. Non lasciare che la notte finisca."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5cb2b2b0-d715-4401-864b-3eac2590d243\', \'multiverseId\': 418980}, \'multiverseid\': 418980}, {\'name\': \'放埒\', \'text\': \'あなたはカードを２枚引き、２点のライフを失い、{E}{E}（エネルギー・カウンター２個）を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'「チャンスがあるならモノにしな。笑って、歌って、踊るんだ。夜が明けるにまかせずに。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419244&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a5ffbd7-bebd-4c45-81e5-d5bfe7994d29\', \'multiverseId\': 419244}, \'multiverseid\': 419244}, {\'name\': \'방탕한 삶\', \'text\': \'당신은 카드 두 장을 뽑고, 생명 2점을 잃고, {E}{E}(에너지 카운터 두 개)를 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'"기회가 왔을 때 즐기는 거야. 이 밤이 끝나지 않게 웃고 노래하고 춤추자구."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419508&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'74ee815e-abd1-4fbd-8abe-d16fcdf07f69\', \'multiverseId\': 419508}, \'multiverseid\': 419508}, {\'name\': \'Viver à Toda\', \'text\': \'Você compra dois cards, perde 2 pontos de vida e recebe {E}{E} (dois marcadores de energia).\', \'type\': \'Feitiço\', \'flavor\': \'"Quando tiver a chance, aproveite. Ria, cante, dance. Não deixe a noite terminar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419772&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b70cbc49-8b2d-4545-a2ed-d6a95f0ace91\', \'multiverseId\': 419772}, \'multiverseid\': 419772}, {\'name\': \'Живи Быстро\', \'text\': \'Вы берете две карты, теряете 2 жизни и получаете {E}{E} (два жетона энергии).\', \'type\': \'Волшебство\', \'flavor\': \'«Когда тебе выпадает шанс, воспользуйся им. Смейся, пой, танцуй. Не позволяй ночи кончаться».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420036&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'13b5af6c-859f-4e18-b94d-367ea32b425b\', \'multiverseId\': 420036}, \'multiverseid\': 420036}, {\'name\': \'快意生活\', \'text\': \'你抓两张牌，失去2点生命，并得到{E}{E}（两个能量指示物）。\', \'type\': \'法术\', \'flavor\': \'「抓住一切机会，欢笑，欢唱，欢舞。切勿虚度夜晚好时光。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417924&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0ef4db0d-d644-4be2-9821-358dc76becba\', \'multiverseId\': 417924}, \'multiverseid\': 417924}, {\'name\': \'快意生活\', \'text\': \'你抽兩張牌，失去2點生命，並得到{E}{E}（兩個能量指示物）。\', \'type\': \'巫術\', \'flavor\': \'「抓住一切機會，歡笑，歡唱，歡舞。切勿虛度夜晚好時光。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418188&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f9acd4a6-f9c2-4d47-bd23-22448f304176\', \'multiverseId\': 418188}, \'multiverseid\': 418188}]', '[{\'name\': \'Lehrling des Erfinders\', \'text\': \'Der Lehrling des Erfinders erhält +1/+1, solange du ein Artefakt kontrollierst.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'„Jeder produziert am Anfang nur Müll. Aber wenn du endlich etwas halbwegs gut hinbekommst, ist das der beste Tag deines Lebens." —Nehra, Erfinderin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418485&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0e3d49f-5a7e-45df-a92b-1cfb4e0e30aa\', \'multiverseId\': 418485}, \'multiverseid\': 418485}, {\'name\': \'Inventora aprendiz\', \'text\': \'La Inventora aprendiz obtiene +1/+1 mientras controles un artefacto.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'"Todo el mundo empieza creando basura. Si terminas por producir algo medio decente, será el mejor día de tu vida". —Nehra, inventora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420333&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d5c433e-0beb-42c6-bb40-2d45eae1fd56\', \'multiverseId\': 420333}, \'multiverseid\': 420333}, {\'name\': "Apprentie de l\'inventeur", \'text\': "L\'Apprentie de l\'inventeur gagne +1/+1 tant que vous contrôlez un artefact.", \'type\': \'Créature : humain et artificier\', \'flavor\': "« Tout ce qu\'un débutant produit finit au rebut. Si vous parvenez un jour à créer quelque chose d\'à peu près convenable, ce sera le plus beau jour de votre vie. » —Nehra, inventeur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418749&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a675eb9d-c5e3-47ca-9b9c-a355c2cb9b3d\', \'multiverseId\': 418749}, \'multiverseid\': 418749}, {\'name\': "Apprendista dell\'Inventore", \'text\': "L\'Apprendista dell\'Inventore prende +1/+1 fintanto che controlli un artefatto.", \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'"Tutti cominciamo creando spazzatura. Quando finalmente costruirai qualcosa di quasi decente, sarà il giorno più bello della tua vita." —Nehra, inventrice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419013&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78470562-d3ff-41ed-8aba-be52267c026e\', \'multiverseId\': 419013}, \'multiverseid\': 419013}, {\'name\': \'発明者の見習い\', \'text\': \'あなたがアーティファクトをコントロールしているかぎり、発明者の見習いは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'「誰だって最初に作る物はまったくのガラクタよ。一部だけでもちゃんとした物が作れれば、それは人生最高の日になるわ。」 ――発明者、ネーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419277&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'315ebe31-1a55-4f7c-b6ed-78cac494b5ea\', \'multiverseId\': 419277}, \'multiverseid\': 419277}, {\'name\': \'발명가 견습생\', \'text\': \'당신이 마법물체를 조종하는 한, 발명가 견습생은 +1/+1을 받는다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'"누구나 형편없는 것을 만드는 것부터 시작합니다. 조금이라도 괜찮은 물건이 나오면 인생 최고의 날이 될 겁니다." —발명가 네라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419541&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'389602cc-f92e-491b-a313-7d33cfca478c\', \'multiverseId\': 419541}, \'multiverseid\': 419541}, {\'name\': \'Aprendiz do Inventor\', \'text\': \'Aprendiz do Inventor receberá +1/+1 enquanto você controlar um artefato.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'"Todo mundo começa fazendo lixo. Se você finalmente fizer alguma coisa quase decente, vai ser o melhor dia da sua vida." — Nehra, inventora\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419805&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'65674daa-9f49-448a-b4a0-8553fd083c21\', \'multiverseId\': 419805}, \'multiverseid\': 419805}, {\'name\': \'Ученица Изобретателя\', \'text\': \'Ученица Изобретателя получает +1/+1, пока вы контролируете артефакт.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'«Каждый начинает с того, что мастерит негодную дрянь. И когда у тебя, наконец, получается хоть что-то достойное, ты радуешься, как в лучший день своей жизни». — изобретательница Нера\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420069&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c39f477-95b2-42df-951f-3a278f029d34\', \'multiverseId\': 420069}, \'multiverseid\': 420069}, {\'name\': \'发明家的学徒\', \'text\': \'只要你操控神器，发明家的学徒便得+1/+1。\', \'type\': \'生物～人类／神器师\', \'flavor\': \'「所有人一开始制造的都是垃圾。等到你终于能制造出稍微不错的东西了，那就是你生命中最美好的一天。」 ～发明家内赫勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417957&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5061ba2-017a-4c76-93cf-64082b2f213f\', \'multiverseId\': 417957}, \'multiverseid\': 417957}, {\'name\': \'發明家的學徒\', \'text\': \'只要你操控神器，發明家的學徒便得+1/+1。\', \'type\': \'生物～人類／神器師\', \'flavor\': \'「所有人一開始製造的都是垃圾。等到你終於能製造出稍微不錯的東西了，那就是你生命中最美好的一天。」 ～發明家內赫勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418221&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'278d3e09-9ae2-42b9-b753-126a0cb2414b\', \'multiverseId\': 418221}, \'multiverseid\': 418221}]', '[{\'name\': \'Listiger Bandar\', \'text\': \'{2}{G}: Der Listige Bandar erhält Unzerstörbarkeit bis zum Ende des Zuges. (Schaden und Effekte, die „zerstören", zerstören ihn nicht.)\', \'type\': \'Kreatur — Katze, Affe\', \'flavor\': \'Halb Katze, halb Affe und ein vollkommenes Ärgernis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418540&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75ef1ecb-2643-47c4-82c0-e0ae314156b7\', \'multiverseId\': 418540}, \'multiverseid\': 418540}, {\'name\': \'Bandar astuto\', \'text\': \'{2}{G}: El Bandar astuto gana la habilidad de indestructible hasta el final del turno. (El daño y los efectos que dicen "destruir" no lo destruyen.)\', \'type\': \'Criatura — Primate felino\', \'flavor\': \'Parte felino, parte primate, y todo problemas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420388&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5bb761a8-e1ee-461c-8742-a4fe31574240\', \'multiverseId\': 420388}, \'multiverseid\': 420388}, {\'name\': \'Bandar rusé\', \'text\': "{2}{G} : Le Bandar rusé acquiert l\'indestructible jusqu\'à la fin du tour. (Les blessures et les effets qui disent « détruisez » ne le détruisent pas.)", \'type\': \'Créature : chat et singe\', \'flavor\': "Mi-félin, mi-primate, source d\'ennuis du museau à la queue.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418804&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b656160d-2317-4cd5-8ef6-2ecf9b68752b\', \'multiverseId\': 418804}, \'multiverseid\': 418804}, {\'name\': \'Bandar Astuto\', \'text\': \'{2}{G}: Il Bandar Astuto ha indistruttibile fino alla fine del turno. (Il danno e gli effetti che dicono "distruggi" non lo distruggono.)\', \'type\': \'Creatura — Scimmia Felino\', \'flavor\': \'50% felino, 50% primate, 100% disastroso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419068&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eedb3234-0660-470d-aabe-6c98b964c19f\', \'multiverseId\': 419068}, \'multiverseid\': 419068}, {\'name\': \'狡猾な猫猿\', \'text\': \'{2}{G}：ターン終了時まで、狡猾な猫猿は破壊不能を得る。（ダメージや「破壊」と書かれた効果では、これは破壊されない。）\', \'type\': \'クリーチャー — 猫・猿\', \'flavor\': \'半分が猫、半分が猿、全部が厄介。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419332&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16f1e30b-26cd-461a-a4cb-19120e5e3312\', \'multiverseId\': 419332}, \'multiverseid\': 419332}, {\'name\': \'교활한 반다르\', \'text\': \'{2}{G}: 교활한 반다르는 턴종료까지 무적을 얻는다. (피해와 "파괴"라고 명시된 효과로 파괴되지 않는다.)\', \'type\': \'생물 — 고양이 원숭이\', \'flavor\': \'일부는 고양이고 일부는 원숭이. 어느 쪽도 위험하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419596&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a663ca27-80ab-4c3a-9849-dcad256bb4f9\', \'multiverseId\': 419596}, \'multiverseid\': 419596}, {\'name\': \'Bandar Astuto\', \'text\': \'{2}{G}: Bandar Astuto ganha indestrutível até o final do turno. (O dano e os efeitos que dizem "destrua" não o destroem.)\', \'type\': \'Criatura — Felino Macaco\', \'flavor\': \'Parte felino, parte primata, integralmente problemático.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9873d735-f2d0-4067-8038-b7c62b33aad3\', \'multiverseId\': 419860}, \'multiverseid\': 419860}, {\'name\': \'Бандар-Пройдоха\', \'text\': \'{2}{G}: Бандар-Пройдоха получает Неразрушимость до конца хода. (Повреждения и эффекты с указанием «уничтожьте» не уничтожают его.)\', \'type\': \'Существо — Кошка Мартышка\', \'flavor\': \'Немного от кошки, немного от примата, и целая гора неприятностей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420124&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'50e1f4bc-bde3-4a0d-8eee-b071642d98b7\', \'multiverseId\': 420124}, \'multiverseid\': 420124}, {\'name\': \'狡诈猫猴\', \'text\': \'{2}{G}：狡诈猫猴获得不灭异能直到回合结束。（伤害与注明「消灭」的效应不会将它消灭。）\', \'type\': \'生物～猫／猴\', \'flavor\': \'半猫半猴，麻烦重重。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'995081a9-7b6d-4d83-ad89-5609d223158f\', \'multiverseId\': 418012}, \'multiverseid\': 418012}, {\'name\': \'狡詐貓猴\', \'text\': \'{2}{G}：狡詐貓猴獲得不滅異能直到回合結束。（傷害與註明「消滅」的效應不會將它消滅。)\', \'type\': \'生物～貓／猴\', \'flavor\': \'半貓半猴，麻煩重重。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418276&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e784e596-463f-4585-b503-7b6962a997c2\', \'multiverseId\': 418276}, \'multiverseid\': 418276}]', '[{\'name\': \'Luftbarke\', \'text\': \'Fliegend\\nBemannen 1 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 1 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418598&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae765793-f0a8-4399-8b9d-6b70e19310e9\', \'multiverseId\': 418598}, \'multiverseid\': 418598}, {\'name\': \'Esquife aéreo\', \'text\': \'Vuela.\\nTripular 1. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 1 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420446&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f76ee835-aa5f-4702-a997-d164c042cd8d\', \'multiverseId\': 420446}, \'multiverseid\': 420446}, {\'name\': \'Esquif volant\', \'text\': "Vol\\nPilotage 1 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 1 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418862&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63014eab-a8df-416d-8531-15e416d11066\', \'multiverseId\': 418862}, \'multiverseid\': 418862}, {\'name\': \'Avioplano\', \'text\': \'Volare\\nManovrare 1 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 1: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)\', \'type\': \'Artefatto — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419126&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c3f239b5-0f0c-4d44-95dd-7bb1d592b28f\', \'multiverseId\': 419126}, \'multiverseid\': 419126}, {\'name\': \'航空艇\', \'text\': \'飛行\\n搭乗１（あなたがコントロールする望む数のクリーチャーを、パワーの合計が１以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419390&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'787656ca-ea8c-41c1-addf-8d62fc6d08fa\', \'multiverseId\': 419390}, \'multiverseid\': 419390}, {\'name\': \'창공 마상이\', \'text\': \'비행\\n탑승 1 (당신이 조종하는 생물을 공격력 총합이 1 이상이 되도록 원하는 수만큼 탭한다: 이 탑승물은 턴종료까지 마법물체 생물이 된다.)\', \'type\': \'마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419654&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0bc1ba1b-9ed4-4b03-b42f-00effddfb02c\', \'multiverseId\': 419654}, \'multiverseid\': 419654}, {\'name\': \'Aeroesquife\', \'text\': \'Voar\\nTripular 1 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 1: Este Veículo se torna uma criatura artefato até o final do turno.)\', \'type\': \'Artefato — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419918&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c58fb256-cb79-4692-b006-9f259be45e71\', \'multiverseId\': 419918}, \'multiverseid\': 419918}, {\'name\': \'Небесный Ялик\', \'text\': \'Полет\\nЭкипаж 1 (Поверните любое количество существ под вашим контролем с суммарной силой 1 или более: эта Машина становится артефактом существом до конца хода.)\', \'type\': \'Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420182&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'558836ec-6f75-4259-9b62-9099f30c3426\', \'multiverseId\': 420182}, \'multiverseid\': 420182}, {\'name\': \'飞空舟\', \'text\': \'飞行\\n搭载1（横置任意数量由你操控且力量总和等于或大于1的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'神器～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418070&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0af6f5a0-be10-4855-afd1-219cc2e39c99\', \'multiverseId\': 418070}, \'multiverseid\': 418070}, {\'name\': \'飛空舟\', \'text\': \'飛行\\n搭載1（橫置任意數量由你操控且力量總和等於或大於1的生物：此載具成為神器生物直到回合結束。）\', \'type\': \'神器～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418334&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3cb8777c-30e5-4521-852e-60b966e95a5f\', \'multiverseId\': 418334}, \'multiverseid\': 418334}]', '[{\'name\': \'Luftschiff-Jäger\', \'text\': \'Fliegend\\n{R}: Der Luftschiff-Jäger erhält +1/+0 bis zum Ende des Zuges.\\n{R}: Der Luftschiff-Jäger erhält Erstschlag bis zum Ende des Zuges.\\n{R}: Der Luftschiff-Jäger erhält Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418495&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7f3a5f0-c2d4-465f-a9de-0e0d708f261e\', \'multiverseId\': 418495}, \'multiverseid\': 418495}, {\'name\': \'Acechador de aeronaves\', \'text\': \'Vuela.\\n{R}: El Acechador de aeronaves obtiene +1/+0 hasta el final del turno.\\n{R}: El Acechador de aeronaves gana la habilidad de dañar primero hasta el final del turno.\\n{R}: El Acechador de aeronaves gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420343&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f1eac312-4fd6-42d6-ad1c-a9415e7de4f2\', \'multiverseId\': 420343}, \'multiverseid\': 420343}, {\'name\': \'Pisteur de vaisseaux volants\', \'text\': "Vol\\n{R} : Le Pisteur de vaisseaux volants gagne +1/+0 jusqu\'à la fin du tour.\\n{R} : Le Pisteur de vaisseaux volants acquiert l\'initiative jusqu\'à la fin du tour.\\n{R} : Le Pisteur de vaisseaux volants acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418759&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7ff8d3f-32c8-4f39-a8ec-b725e536b70c\', \'multiverseId\': 418759}, \'multiverseid\': 418759}, {\'name\': \'Cacciatore di Avionavi\', \'text\': \'Volare\\n{R}: Il Cacciatore di Avionavi prende +1/+0 fino alla fine del turno.\\n{R}: Il Cacciatore di Avionavi ha attacco improvviso fino alla fine del turno.\\n{R}: Il Cacciatore di Avionavi ha rapidità fino alla fine del turno.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419023&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9be664c-8369-42b7-9a82-5aed39f39c7b\', \'multiverseId\': 419023}, \'multiverseid\': 419023}, {\'name\': \'航空船に忍び寄るもの\', \'text\': \'飛行\\n{R}：ターン終了時まで、航空船に忍び寄るものは＋１/＋０の修整を受ける。\\n{R}：ターン終了時まで、航空船に忍び寄るものは先制攻撃を得る。\\n{R}：ターン終了時まで、航空船に忍び寄るものは速攻を得る。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419287&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1c354011-b67c-4daf-a515-2e8427f62d7b\', \'multiverseId\': 419287}, \'multiverseid\': 419287}, {\'name\': \'비행선 추적자\', \'text\': \'비행\\n{R}: 비행선 추적자는 턴종료까지 +1/+0을 받는다.\\n{R}: 비행선 추적자는 턴종료까지 선제공격을 얻는다.\\n{R}: 비행선 추적자는 턴종료까지 신속을 얻는다.\', \'type\': \'생물 — 용\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419551&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0096cd7-e6d7-43d3-a91f-1d52b99c127d\', \'multiverseId\': 419551}, \'multiverseid\': 419551}, {\'name\': \'Espreitador de Aeronau\', \'text\': \'Voar\\n{R}: Espreitador de Aeronau recebe +1/+0 até o final do turno.\\n{R}: Espreitador de Aeronau ganha iniciativa até o final do turno.\\n{R}: Espreitador de Aeronau ganha ímpeto até o final do turno.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e1c8a15-7d11-4143-9b2d-6a84687a39b6\', \'multiverseId\': 419815}, \'multiverseid\': 419815}, {\'name\': \'Охотник на Небесные Корабли\', \'text\': \'Полет\\n{R}: Охотник на Небесные Корабли получает +1/+0 до конца хода.\\n{R}: Охотник на Небесные Корабли получает Первый удар до конца хода.\\n{R}: Охотник на Небесные Корабли получает Ускорение до конца хода.\', \'type\': \'Существо — Дракон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420079&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88343357-eb8c-42b7-894c-4a806bf28afd\', \'multiverseId\': 420079}, \'multiverseid\': 420079}, {\'name\': \'飞船伏龙\', \'text\': \'飞行\\n{R}：飞船伏龙得+1/+0直到回合结束。\\n{R}：飞船伏龙获得先攻异能直到回合结束。\\n{R}：飞船伏龙获得敏捷异能直到回合结束。\', \'type\': \'生物～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417967&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7fe96730-9169-4e83-9e57-a29323be8dee\', \'multiverseId\': 417967}, \'multiverseid\': 417967}, {\'name\': \'飛船伏龍\', \'text\': \'飛行\\n{R}：飛船伏龍得+1/+0直到回合結束。\\n{R}：飛船伏龍獲得先攻異能直到回合結束。\\n{R}：飛船伏龍獲得敏捷異能直到回合結束。\', \'type\': \'生物～龍\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418231&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'99851aa5-23b8-4103-9a4f-2624f17d4a7d\', \'multiverseId\': 418231}, \'multiverseid\': 418231}]', '[{\'name\': \'Lötbrenner-Handschuh\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+0.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Guten Morgen, Kinder. Öffnet eure Ätherventile und entzündet die Handschuhe." —Rakib, Lehrer in Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418602&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'888edec7-2ec3-4ccb-8cc9-0ea71878b916\', \'multiverseId\': 418602}, \'multiverseid\': 418602}, {\'name\': \'Guantelete antorcha\', \'text\': \'La criatura equipada obtiene +2/+0.\\nEquipar {2}. ({2}: Anexa este equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"Buen día, niños. Abran sus válvulas de éter y enciendan sus guanteletes". —Rakib, maestro de Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420450&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e435980-2df7-4658-923b-3099309daf6c\', \'multiverseId\': 420450}, \'multiverseid\': 420450}, {\'name\': \'Gantelet torche\', \'text\': "La créature équipée gagne +2/+0.\\nÉquipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': "« Bonjour les enfants. Ouvrez vos valves d\'Éther et allumez vos gantelets. » —Rakib, instituteur de Ghirapur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418866&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d198ab38-4e15-4b99-b314-414566bb7de3\', \'multiverseId\': 418866}, \'multiverseid\': 418866}, {\'name\': \'Guanto Saldatore\', \'text\': \'La creatura equipaggiata prende +2/+0.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Buongiorno, bambini. Aprite le valvole eteriche e accendete i guanti." —Rakib, insegnante di Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419130&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b6423c4-58ad-471f-98a2-80b01d87b17d\', \'multiverseId\': 419130}, \'multiverseid\': 419130}, {\'name\': \'放射篭手\', \'text\': \'装備しているクリーチャーは＋２/＋０の修整を受ける。\\n装備{2}（{2}：あなたがコントロールするクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「おはよう、生徒諸君。霊気弁を開いて、各自の篭手に火を入れたまえ。」 ――ギラプールの教師、ラキーブ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419394&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'182a4213-1081-487a-94f3-172ebb572b84\', \'multiverseId\': 419394}, \'multiverseid\': 419394}, {\'name\': \'발염 장갑\', \'text\': \'장착된 생물은 +2/+0을 받는다.\\n장착 {2} ({2}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'"애들아, 좋은 아침이구나. 에테르 밸브를 열고 장갑에 불을 붙이거라." —기라푸르 교사 라키브\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419658&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bb61d972-4752-4639-96d1-ae20d0596518\', \'multiverseId\': 419658}, \'multiverseid\': 419658}, {\'name\': \'Manopla-tocha\', \'text\': \'A criatura equipada recebe +2/+0.\\nEquipar {2} ({2}: Anexe à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Bom dia, crianças. Por favor, abram suas válvulas etéreas e liguem suas manoplas." — Rakib, docente em Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419922&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'beaca91c-d2ae-46ca-b2f3-076911aeef20\', \'multiverseId\': 419922}, \'multiverseid\': 419922}, {\'name\': \'Наручная Горелка\', \'text\': \'Снаряженное существо получает +2/+0.\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'«Доброе утро, дети. Пожалуйста, откройте эфирные вентили и зажгите перчатки». — Ракиб, гирапурский учитель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420186&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aedc27a1-bf98-4006-b75f-dd887265df4d\', \'multiverseId\': 420186}, \'multiverseid\': 420186}, {\'name\': \'喷炬护手\', \'text\': \'佩带此武具的生物得+2/+0。\\n佩带{2}（{2}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': \'「早上好，孩子们。请各位打开乙太阀门，点燃护手。」 ～吉拉波学校教师拉吉布\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418074&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'224a7c2d-2114-49de-a138-e47dfe5d3952\', \'multiverseId\': 418074}, \'multiverseid\': 418074}, {\'name\': \'噴炬護手\', \'text\': \'佩帶此武具的生物得+2/+0。\\n佩帶{2}（{2}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': \'「早安，孩子們。請各位打開乙太閥門，點燃護手。」 ～吉拉波學校教師拉吉布\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418338&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c3581b00-47e7-4a8d-9f7a-0fab7aedcf8b\', \'multiverseId\': 418338}, \'multiverseid\': 418338}]', "[{'name': 'Maschinen-Verschlingerin', 'text': 'Die Maschinen-Verschlingerin kostet beim Wirken für jedes Artefakt, das du kontrollierst, {1} weniger.\\n{5}{U}: Die Maschinen-Verschlingerin kann in diesem Zug nicht geblockt werden.', 'type': 'Kreatur — Schlange', 'flavor': 'Ihre Sammlung ist riesig und doch hat jedes Schiff einen besonderen Platz in ihrem Herzen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418413&type=card', 'language': 'German', 'identifiers': {'scryfallId': '673017dc-5a2d-4fef-9451-062a0618ffa8', 'multiverseId': 418413}, 'multiverseid': 418413}, {'name': 'Serpiente devoraingenios', 'text': 'Cuesta {1} menos lanzar la Serpiente devoraingenios por cada artefacto que controlas.\\n{5}{U}: La Serpiente devoraingenios no puede ser bloqueada este turno.', 'type': 'Criatura — Serpiente', 'flavor': 'Su colección es inmensa, pero cada nave tiene un hueco especial en su corazón.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420261&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '864c2d9f-03c2-4d07-9535-8ffc21572006', 'multiverseId': 420261}, 'multiverseid': 420261}, {'name': 'Serpent mécanochercheur', 'text': 'Le Serpent mécanochercheur coûte {1} de moins à lancer pour chaque artefact que vous contrôlez.\\n{5}{U} : Le Serpent mécanochercheur ne peut pas être bloqué ce tour-ci.', 'type': 'Créature : grand serpent', 'flavor': 'Sa collection est immense, mais chaque vaisseau a une place spéciale dans son cœur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418677&type=card', 'language': 'French', 'identifiers': {'scryfallId': '983839a0-9ead-41ee-9dc6-99b817325e17', 'multiverseId': 418677}, 'multiverseid': 418677}, {'name': 'Serpe Meccanivora', 'text': 'La Serpe Meccanivora costa {1} in meno per essere lanciata per ogni artefatto che controlli.\\n{5}{U}: La Serpe Meccanivora non può essere bloccata in questo turno.', 'type': 'Creatura — Serpe', 'flavor': 'La sua collezione è vasta, ma ogni navicella occupa un posto speciale nel suo cuore.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418941&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b892409d-ef5d-44f1-aca1-ee75dcb1cfb3', 'multiverseId': 418941}, 'multiverseid': 418941}, {'name': '歯車襲いの海蛇', 'text': '歯車襲いの海蛇を唱えるためのコストは、あなたがコントロールするアーティファクト１つにつき{1}少なくなる。\\n{5}{U}：このターン、歯車襲いの海蛇はブロックされない。', 'type': 'クリーチャー — 海蛇', 'flavor': 'それが有する船のコレクションは莫大だが、個々の船それぞれに思い入れがある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419205&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8b80c41e-36d2-4391-a73a-9ec6f9b6594e', 'multiverseId': 419205}, 'multiverseid': 419205}, {'name': '기계추적자 이무기', 'text': '기계추적자 이무기는 당신이 조종하는 마법물체 한 개당 발동 비용을 {1}만큼 덜 지불한다.\\n{5}{U}: 기계추적자 이무기는 이 턴에 방어당할 수 없다.', 'type': '생물 — 이무기', 'flavor': '그것은 엄청나게 많은 함선을 수집했지만, 함선 하나하나마다 의미가 있다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419469&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e9e81a28-2fab-4087-a03f-c999f5188a03', 'multiverseId': 419469}, 'multiverseid': 419469}, {'name': 'Serpente Mecanívora', 'text': 'Serpente Mecanívora custa {1} a menos para ser conjurada para cada artefato que você controla.\\n{5}{U}: Serpente Mecanívora não pode ser bloqueada neste turno.', 'type': 'Criatura — Serpente', 'flavor': 'Sua coleção é vasta, e mesmo assim cada embarcação tem um lugar especial em seu coração.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419733&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '051307f8-fbcf-4b55-8e1d-689d0aa46830', 'multiverseId': 419733}, 'multiverseid': 419733}, {'name': 'Жадный до Механики Змей', 'text': 'Стоимость разыгрывания Жадного до Механики Змея уменьшается на {1} за каждый артефакт под вашим контролем.\\n{5}{U}: Жадный до Механики Змей не может быть заблокирован в этом ходу.', 'type': 'Существо — Змей', 'flavor': 'У змея обширная коллекция, но каждый корабль занимает особое место в его сердце.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419997&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ae701c87-4052-495c-9145-c4df12255aa9', 'multiverseId': 419997}, 'multiverseid': 419997}, {'name': '觅械巨蛇', 'text': '你每操控一个神器，觅械巨蛇便减少{1}来施放。\\n{5}{U}：觅械巨蛇本回合不能被阻挡。', 'type': '生物～巨蛇', 'flavor': '它的收藏丰富，但每艘船在其心中都占有特殊地位。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417885&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'de1cf28b-9c14-4068-9f78-39566edb247a', 'multiverseId': 417885}, 'multiverseid': 417885}, {'name': '覓械巨蛇', 'text': '你每操控一個神器，覓械巨蛇便減少{1}來施放。\\n{5}{U}：覓械巨蛇本回合不能被阻擋。', 'type': '生物～巨蛇', 'flavor': '牠的收藏豐富，但每艘船在其心中都佔有特殊地位。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418149&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ea933798-15a0-453e-9faf-28e15a0e91ae', 'multiverseId': 418149}, 'multiverseid': 418149}]", '[{\'name\': \'Mechanikerin des Aviariums\', \'text\': \'Wenn die Mechanikerin des Aviariums ins Spiel kommt, kannst du eine andere bleibende Karte, die du kontrollierst, auf die Hand ihres Besitzers zurückbringen.\', \'type\': \'Kreatur — Zwerg, Handwerker\', \'flavor\': \'Piloten bringen beschädigte Luftschiffe ins Aviarium und vertrauen darauf, dass die talentierten Mechaniker sie wieder flugtüchtig machen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418371&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'30e7174b-2f29-4e38-86b8-e324fd7f35ac\', \'multiverseId\': 418371}, \'multiverseid\': 418371}, {\'name\': \'Mecánica de aeródromo\', \'text\': \'Cuando la Mecánica de aeródromo entre al campo de batalla, puedes regresar otro permanente que controlas a la mano de su propietario.\', \'type\': \'Criatura — Enano artífice\', \'flavor\': \'Los pilotos llevan las aeronaves averiadas a los aeródromos, donde los mejores mecánicos de Kaladesh las ponen a punto para remontar el vuelo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420219&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cef283d3-eb93-4fcc-8359-52b6574ce5d9\', \'multiverseId\': 420219}, \'multiverseid\': 420219}, {\'name\': \'Mécanicienne de la volière\', \'text\': \'Quand la Mécanicienne de la volière arrive sur le champ de bataille, vous pouvez renvoyer un autre permanent que vous contrôlez dans la main de son propriétaire.\', \'type\': \'Créature : nain et artificier\', \'flavor\': \'Les pilotes amènent les vaisseaux volants endommagés aux volières, espérant que les mécaniciens les plus talentueux de Ghirapur pourront les renvoyer dans les airs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418635&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b63250a9-4b60-4893-869e-da20399b2330\', \'multiverseId\': 418635}, \'multiverseid\': 418635}, {\'name\': "Meccanica dell\'Aviorimessa", \'text\': "Quando la Meccanica dell\'Aviorimessa entra nel campo di battaglia, puoi far tornare un altro permanente che controlli in mano al suo proprietario.", \'type\': \'Creatura — Artefice Nano\', \'flavor\': \'I piloti affidano i velivoli in panne alle Aviorimesse, fiduciosi che i meccanici più abili di Ghirapur sapranno farli librare di nuovo in aria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418899&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'62447609-c8fa-4c62-8818-490bd6ba221b\', \'multiverseId\': 418899}, \'multiverseid\': 418899}, {\'name\': \'格納庫の整備士\', \'text\': \'格納庫の整備士が戦場に出たとき、あなたは、あなたがコントロールする他のパーマネント１つをオーナーの手札に戻してもよい。\', \'type\': \'クリーチャー — ドワーフ・工匠\', \'flavor\': \'操縦士は故障した航空船を格納庫に持ち込む。ギラプールで最も才能ある整備士に頼めば、また飛べるようにしてくれるからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419163&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b593900e-bad3-42f7-a677-962e0e2696fc\', \'multiverseId\': 419163}, \'multiverseid\': 419163}, {\'name\': \'격납고 기계공\', \'text\': \'격납고 기계공이 전장에 들어올 때, 당신이 조종하는 다른 지속물을 소유자의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 드워프 기능공\', \'flavor\': \'조종사들은 망가진 비행선을 기라푸르에서 가장 뛰어난 정비공이 고쳐줄 것이라고 믿으며 격납고로 가져간다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419427&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0d13b0bd-16c7-45f6-80c7-fb5736ea774a\', \'multiverseId\': 419427}, \'multiverseid\': 419427}, {\'name\': \'Mecânica do Aviário\', \'text\': \'Quando Mecânica do Aviário entra no campo de batalha, você pode devolver outra permanente que você controla para a mão de seu dono.\', \'type\': \'Criatura — Anão Artesão\', \'flavor\': \'Os pilotos levam as aeronaus avariadas para os Aviários, confiando nos mecânicos mais talentosos de Ghirapur para colocá-las no ar novamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419691&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ca606a44-e211-4cca-9887-2d27efa9fd08\', \'multiverseId\': 419691}, \'multiverseid\': 419691}, {\'name\': \'Механик из Ангара\', \'text\': \'Когда Механик из Ангара выходит на поле битвы, вы можете вернуть другой перманент под вашим контролем в руку его владельца.\', \'type\': \'Существо — Гном Механик\', \'flavor\': \'Пилоты отводят поврежденные небесные корабли в Ангар, где самые талантливые механики Гирапура вновь поднимают их в воздух.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419955&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fa7dd257-ba05-4ff3-a1df-fe9725464706\', \'multiverseId\': 419955}, \'multiverseid\': 419955}, {\'name\': \'停机库技师\', \'text\': \'当停机库技师进战场时，你可以将另一个由你操控的永久物移回其拥有者手上。\', \'type\': \'生物～矮人／神器师\', \'flavor\': \'驾手将受损的飞船驶回停机库，深信吉拉波最巧手的技师能让它们再度起航。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417843&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3baa7be4-d018-4250-8db1-5a6a0d81589c\', \'multiverseId\': 417843}, \'multiverseid\': 417843}, {\'name\': \'停機庫技師\', \'text\': \'當停機庫技師進戰場時，你可以將另一個由你操控的永久物移回其擁有者手上。\', \'type\': \'生物～矮人／神器師\', \'flavor\': \'駕手將受損的飛船駛回停機庫，深信吉拉波最巧手的技師能讓它們再度起航。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418107&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eca65335-cba2-424c-8336-c4f94bc7c6e9\', \'multiverseId\': 418107}, \'multiverseid\': 418107}]', '[{\'name\': \'Meisterhafter Feinmechaniker\', \'text\': \'Servos und Thopter, die du kontrollierst, erhalten +1/+1.\\n{3}{W}: Erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.\', \'type\': \'Kreatur — Zwerg, Handwerker\', \'flavor\': \'„Lasst uns niemals die Freude vergessen, mit der neue Erfindungen unsere Herzen erfüllen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418386&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f5c790e-d65c-461d-8cc7-4773ddf0f013\', \'multiverseId\': 418386}, \'multiverseid\': 418386}, {\'name\': \'Maestro artilugista\', \'text\': \'Los Servos y Tópteros que controlas obtienen +1/+1.\\n{3}{W}: Crea una ficha de criatura artefacto Servo incolora 1/1.\', \'type\': \'Criatura — Enano artífice\', \'flavor\': \'"No olvidemos jamás la emoción que causa la invención".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420234&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca78e393-a9af-41da-9c6e-6aac66aaf86d\', \'multiverseId\': 420234}, \'multiverseid\': 420234}, {\'name\': \'Maître bibeloteur\', \'text\': \'Les servos et les mécanoptères que vous contrôlez gagnent +1/+1.\\n{3}{W} : Créez un jeton de créature-artefact 1/1 incolore Servo.\', \'type\': \'Créature : nain et artificier\', \'flavor\': "« N\'oublions pas la joie qui est au cœur de l\'invention. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418650&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb710a15-b24a-4138-b304-41d2e330c246\', \'multiverseId\': 418650}, \'multiverseid\': 418650}, {\'name\': \'Maestro Fabbricagingilli\', \'text\': \'I Servomeccanismi e i Totteri che controlli prendono +1/+1.\\n{3}{W}: Crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.\', \'type\': \'Creatura — Artefice Nano\', \'flavor\': \'"Non dovremmo mai scordare la gioia insita nel cuore dell\\\'inventiva."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418914&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df4567bb-9591-4154-9ec3-e0f88ef358c1\', \'multiverseId\': 418914}, \'multiverseid\': 418914}, {\'name\': \'小物作りの達人\', \'text\': \'あなたがコントロールする霊気装置と飛行機械は＋１/＋１の修整を受ける。\\n{3}{W}：無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。\', \'type\': \'クリーチャー — ドワーフ・工匠\', \'flavor\': \'「発明の根本は喜びだということを忘れたくないものですな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419178&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24618cc9-500d-4f8b-aee9-6db119eca8c9\', \'multiverseId\': 419178}, \'multiverseid\': 419178}, {\'name\': \'장신구 공예의 대가\', \'text\': \'당신이 조종하는 서보와 날틀은 +1/+1을 받는다.\\n{3}{W}: 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.\', \'type\': \'생물 — 드워프 기능공\', \'flavor\': \'"발명을 통해 얻을 수 있는 기쁨을 잊지 맙시다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419442&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f85bbcc7-1cce-45e5-bcc6-d994641c2b71\', \'multiverseId\': 419442}, \'multiverseid\': 419442}, {\'name\': \'Bugigangueiro Mestre\', \'text\': \'Cada Servus e Tóptero que você controla recebe +1/+1.\\n{3}{W}: Crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.\', \'type\': \'Criatura — Anão Artesão\', \'flavor\': \'"Jamais esqueçamos a alegria que permeia o momento da invenção."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419706&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'270c57fc-f985-4ec3-a9f9-e3621895e8bc\', \'multiverseId\': 419706}, \'multiverseid\': 419706}, {\'name\': \'Мастер Диковинок\', \'text\': \'Сервотроны и Топтеры под вашим контролем получают +1/+1.\\n{3}{W}: создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.\', \'type\': \'Существо — Гном Механик\', \'flavor\': \'«Давайте не забывать, что любое изобретение — это, прежде всего, необыкновенная радость».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419970&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b8ba040e-63fc-4f71-92ff-fb283c7b6d0b\', \'multiverseId\': 419970}, \'multiverseid\': 419970}, {\'name\': \'琐物大师\', \'text\': \'由你操控的自动机和振翼机得+1/+1。\\n{3}{W}：派出一个1/1无色自动机衍生神器生物。\', \'type\': \'生物～矮人／神器师\', \'flavor\': \'「永别忘记深藏在发明之中的那份喜悦。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417858&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'98cd1658-abbc-47fd-99a0-725dcaad38ac\', \'multiverseId\': 417858}, \'multiverseid\': 417858}, {\'name\': \'瑣物大師\', \'text\': \'由你操控的自動機和振翼機得+1/+1。\\n{3}{W}：派出一個1/1無色自動機衍生神器生物。\', \'type\': \'生物～矮人／神器師\', \'flavor\': \'「永別忘記深藏在發明之中的那份喜悅。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418122&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cba14841-b4c8-4b56-abbb-78454ba24c3c\', \'multiverseId\': 418122}, \'multiverseid\': 418122}]', '[{\'name\': \'Meisterin der Marionetten\', \'text\': \'Fabrizieren 3 (Wenn diese Kreatur ins Spiel kommt, lege drei +1/+1-Marken auf sie oder erzeuge drei 1/1 farblose Servo-Artefaktkreaturenspielsteine.)\\nImmer wenn ein Artefakt, das du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, verliert ein Gegner deiner Wahl Lebenspunkte in Höhe der Stärke der Meisterin der Marionetten.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418455&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f2dcc8c-d3eb-423a-a888-850a7a2870c8\', \'multiverseId\': 418455}, \'multiverseid\': 418455}, {\'name\': \'Maestra titiritera\', \'text\': \'Fabricar 3. (Cuando esta criatura entre al campo de batalla, pon tres contadores +1/+1 sobre ella o crea tres fichas de criatura artefacto Servo incoloras 1/1.)\\nSiempre que un artefacto que controlas vaya a un cementerio desde el campo de batalla, el oponente objetivo pierde una cantidad de vidas igual a la fuerza de la Maestra titiritera.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420303&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a56538be-c813-45bf-a675-30157e64efa0\', \'multiverseId\': 420303}, \'multiverseid\': 420303}, {\'name\': \'Maîtresse des marionnettes\', \'text\': "Fabrication 3 (Quand cette créature arrive sur le champ de bataille, mettez trois marqueurs +1/+1 sur elle ou créez trois jetons de créature-artefact 1/1 incolore Servo.)\\nÀ chaque fois qu\'un artefact sous votre contrôle est mis dans un cimetière depuis le champ de bataille, l\'adversaire ciblé perd un nombre de points de vie égal à la force de la Maîtresse des marionnettes.", \'type\': \'Créature : humain et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418719&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a8c3fdd-4e14-4daa-85bc-7ad967f3790a\', \'multiverseId\': 418719}, \'multiverseid\': 418719}, {\'name\': \'Maestra Burattinaia\', \'text\': \'Fabbrica 3 (Quando questa creatura entra nel campo di battaglia, metti tre segnalini +1/+1 su di essa o crea tre pedine creatura artefatto Servomeccanismo 1/1 incolori.)\\nOgniqualvolta un artefatto che controlli viene messo in un cimitero dal campo di battaglia, un avversario bersaglio perde punti vita pari alla forza della Maestra Burattinaia.\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418983&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bde94ff2-5f40-4abd-bd07-5d454a101f8c\', \'multiverseId\': 418983}, \'multiverseid\': 418983}, {\'name\': \'マリオネットの達人\', \'text\': \'製造３（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを３個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを３体生成する。）\\nあなたがコントロールするアーティファクトが１つ戦場から墓地に置かれるたび、対戦相手１人を対象とする。そのプレイヤーはマリオネットの達人のパワーに等しい点数のライフを失う。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419247&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca10abf8-752c-4f68-87ed-d5089e0a94cf\', \'multiverseId\': 419247}, \'multiverseid\': 419247}, {\'name\': \'인형술의 대가\', \'text\': \'제작 3 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 세 개를 올려 놓거나 1/1 무색 서보 마법물체 생물 토큰 세 개를 만든다.)\\n당신이 조종하는 마법물체가 전장에서 무덤으로 들어갈 때마다, 상대를 목표로 정한다. 그 상대는 인형술의 대가의 공격력만큼 생명점을 잃는다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419511&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'63cb5ffa-8439-4d8c-8f3d-840cd3f17367\', \'multiverseId\': 419511}, \'multiverseid\': 419511}, {\'name\': \'Mestra das Marionetes\', \'text\': \'Fabricar 3 (Quando esta criatura entrar no campo de batalha, coloque três marcadores +1/+1 nela ou crie três fichas de criatura artefato incolor 1/1 do tipo Servus.)\\nToda vez que um artefato que você controla é colocado num cemitério do campo de batalha, o oponente alvo perde uma quantidade de pontos de vida igual ao poder de Mestra das Marionetes.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419775&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3274e916-e87d-4a36-a0aa-778af10656bf\', \'multiverseId\': 419775}, \'multiverseid\': 419775}, {\'name\': \'Хозяйка Марионеток\', \'text\': \'Производство 3 (Когда это существо выходит на поле битвы, положите на него три жетона +1/+1 или создайте три фишки артефакта существа 1/1 бесцветный Сервотрон.)\\nКаждый раз, когда артефакт под вашим контролем попадает с поля битвы на кладбище, целевой оппонент теряет количество жизней, равное силе Хозяйки Марионеток.\', \'type\': \'Существо — Человек Механик\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420039&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'60421e3d-8e1b-446f-ac3a-b98ebff139e6\', \'multiverseId\': 420039}, \'multiverseid\': 420039}, {\'name\': \'弄偶大师\', \'text\': \'装配3（当此生物进战场时，在其上放置三个+1/+1指示物或派出三个1/1无色自动机衍生神器生物。）\\n每当一个由你操控的神器从战场进入坟墓场时，目标对手失去等同于弄偶大师之力量的生命。\', \'type\': \'生物～人类／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417927&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'67c4e885-e669-4ad1-9c02-1ba4c1ef9176\', \'multiverseId\': 417927}, \'multiverseid\': 417927}, {\'name\': \'弄偶大師\', \'text\': \'裝配3（當此生物進戰場時，在其上放置三個+1/+1指示物或派出三個1/1無色自動機衍生神器生物。）\\n每當一個由你操控的神器從戰場進入墳墓場時，目標對手失去等同於弄偶大師之力量的生命。\', \'type\': \'生物～人類／神器師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418191&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8880b4e3-2538-479f-80e7-4001fbdac90b\', \'multiverseId\': 418191}, \'multiverseid\': 418191}]', '[{\'name\': \'Messeplatz-Hüter\', \'text\': \'Wenn der Messeplatz-Hüter ins Spiel kommt, schicke eine Kreatur deiner Wahl, die ein Gegner kontrolliert, ins Exil, bis der Messeplatz-Hüter das Spiel verlässt.\', \'type\': \'Kreatur — Zwerg, Soldat\', \'flavor\': \'„Du kommst mit mir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418378&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9747554f-4afd-4041-88d8-1f5d6e238115\', \'multiverseId\': 418378}, \'multiverseid\': 418378}, {\'name\': \'Alcaide de la feria\', \'text\': \'Cuando el Alcaide de la feria entre al campo de batalla, exilia la criatura objetivo que controla un oponente hasta que el Alcaide de la feria deje el campo de batalla.\', \'type\': \'Criatura — Enano soldado\', \'flavor\': \'"Tú vienes conmigo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420226&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8b64af0-8431-45e6-9090-db1020e9e3fe\', \'multiverseId\': 420226}, \'multiverseid\': 420226}, {\'name\': \'Garde de la foire\', \'text\': "Quand le Garde de la foire arrive sur le champ de bataille, exilez une créature ciblée qu\'un adversaire contrôle jusqu\'à ce que le Garde de la foire quitte le champ de bataille.", \'type\': \'Créature : nain et soldat\', \'flavor\': \'« Vous venez avec moi. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418642&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8b4f5a2-409e-481c-9e68-2b8a6856c99d\', \'multiverseId\': 418642}, \'multiverseid\': 418642}, {\'name\': \'Guardiano della Fiera\', \'text\': \'Quando il Guardiano della Fiera entra nel campo di battaglia, esilia una creatura bersaglio controllata da un avversario finché il Guardiano della Fiera non lascia il campo di battaglia.\', \'type\': \'Creatura — Soldato Nano\', \'flavor\': \'"Tu vieni con me."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418906&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d1b38304-0811-4194-91bb-2fc35913cca3\', \'multiverseId\': 418906}, \'multiverseid\': 418906}, {\'name\': \'博覧会場の警備員\', \'text\': \'博覧会場の警備員が戦場に出たとき、対戦相手がコントロールするクリーチャー１体を対象とし、博覧会場の警備員が戦場を離れるまでそれを追放する。\', \'type\': \'クリーチャー — ドワーフ・兵士\', \'flavor\': \'「一緒に来るんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419170&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f8e6c43-45af-4381-926b-bf686ef5fcee\', \'multiverseId\': 419170}, \'multiverseid\': 419170}, {\'name\': \'박람회장 관리인\', \'text\': \'박람회장 관리인이 전장에 들어올 때, 상대가 조종하는 생물을 목표로 정한다. 박람회장 관리인이 전장을 떠날 때까지 그 생물을 추방한다.\', \'type\': \'생물 — 드워프 병사\', \'flavor\': \'"따라와라."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419434&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05314ba5-f4fc-49d3-9c40-d11cd742cfe5\', \'multiverseId\': 419434}, \'multiverseid\': 419434}, {\'name\': \'Guarda da Feira\', \'text\': \'Quando Guarda da Feira entrar no campo de batalha, exile a criatura alvo que um oponente controla até que Guarda da Feira deixe o campo de batalha.\', \'type\': \'Criatura — Anão Soldado\', \'flavor\': \'"Você vem comigo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419698&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b107044-e242-433a-8c95-ad310a1bb328\', \'multiverseId\': 419698}, \'multiverseid\': 419698}, {\'name\': \'Ярмарочный Страж\', \'text\': \'Когда Ярмарочный Страж выходит на поле битвы, изгоните целевое существо под контролем оппонента до тех пор, пока Ярмарочный Страж не покинет поле битвы.\', \'type\': \'Существо — Гном Солдат\', \'flavor\': \'«Ты пойдешь со мной».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419962&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'89dcb057-75dd-439a-8a60-699bf6686764\', \'multiverseId\': 419962}, \'multiverseid\': 419962}, {\'name\': \'展区守卫\', \'text\': \'当展区守卫进战场时，放逐目标由对手操控的生物，直到展区守卫离开战场为止。\', \'type\': \'生物～矮人／士兵\', \'flavor\': \'「你，跟我走。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417850&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a2dc6e63-1ba0-4c75-ac9c-ec5917f81268\', \'multiverseId\': 417850}, \'multiverseid\': 417850}, {\'name\': \'展區守衛\', \'text\': \'當展區守衛進戰場時，放逐目標由對手操控的生物，直到展區守衛離開戰場為止。\', \'type\': \'生物～矮人／士兵\', \'flavor\': \'「你，跟我走。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418114&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'526ce9b8-d180-4b5b-9f60-f73dca38bdb6\', \'multiverseId\': 418114}, \'multiverseid\': 418114}]', '[{\'name\': \'Messeplatz-Trompeter\', \'text\': \'Zu Beginn jedes Endsegments und falls in diesem Zug eine +1/+1-Marke auf eine von dir kontrollierte bleibende Karte gelegt wurde, lege eine +1/+1-Marke auf den Messeplatz-Trompeter.\', \'type\': \'Kreatur — Elefant\', \'flavor\': \'Je lauter der Elefant trötet, desto lauter der Beifall des Publikums. Und je lauter der Beifall des Publikums …\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bec254fc-30b3-4197-a9f3-4babe70c5485\', \'multiverseId\': 418520}, \'multiverseid\': 418520}, {\'name\': \'Paquidermo de la feria\', \'text\': \'Al comienzo de cada paso final, si se puso un contador +1/+1 sobre un permanente bajo tu control este turno, pon un contador +1/+1 sobre el Paquidermo de la feria.\', \'type\': \'Criatura — Elefante\', \'flavor\': \'Cuanto más alto barritaba el paquidermo, más vitoreaba el público. Y cuanto más vitoreaba el público...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420368&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d59f1e4-330f-4713-8eb2-9e95fe038cba\', \'multiverseId\': 420368}, \'multiverseid\': 420368}, {\'name\': \'Joueur de trompe de la foire\', \'text\': \'Au début de chaque étape de fin, si un marqueur +1/+1 a été mis sur un permanent sous votre contrôle ce tour-ci, mettez un marqueur +1/+1 sur le Joueur de trompe de la foire.\', \'type\': \'Créature : éléphant\', \'flavor\': "« Plus l\'éléphant barrissait fort, plus la foule applaudissait. Et plus la foule applaudissait...", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f096816-5066-4ccc-861e-39dec782d6b1\', \'multiverseId\': 418784}, \'multiverseid\': 418784}, {\'name\': \'Trombettiere della Fiera\', \'text\': "All\'inizio di ogni sottofase finale, se un permanente sotto il tuo controllo ha ricevuto un segnalino +1/+1 in questo turno, metti un segnalino +1/+1 sul Trombettiere della Fiera.", \'type\': \'Creatura — Elefante\', \'flavor\': "Più forte era il barrito dell\'elefante, più la folla si animava. E più la folla si animava...", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419048&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63fb5081-1651-49d0-a31e-7c8f99e74489\', \'multiverseId\': 419048}, \'multiverseid\': 419048}, {\'name\': \'博覧会場の吠え象\', \'text\': \'各終了ステップの開始時に、このターン中に＋１/＋１カウンターがパーマネントの上に置かれた時点でそのパーマネントをあなたがコントロールしていた場合、博覧会場の吠え象の上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 象\', \'flavor\': \'象の吠える声が大きくなるほど、観衆の歓声も大きくなった。そして、観衆の歓声が大きくなるほど……。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419312&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37e601c3-27f1-4718-904e-4ce07a68158a\', \'multiverseId\': 419312}, \'multiverseid\': 419312}, {\'name\': \'박람회장 나팔수\', \'text\': \'각 종료단 시작에, 이 턴에 당신이 조종하는 지속물에 +1/+1 카운터가 놓였다면, 박람회장 나팔수에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 코끼리\', \'flavor\': \'코끼리의 나팔 소리가 클수록 더 많은 관중이 환호한다. 그리고 더 많은 관중이 환호할수록 . . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419576&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b0d83571-e2bb-48cd-a747-59d8e5a9a42f\', \'multiverseId\': 419576}, \'multiverseid\': 419576}, {\'name\': \'Trompetista da Feira\', \'text\': \'No início de cada etapa final, se um marcador +1/+1 foi colocado em uma permanente sob seu controle neste turno, coloque um marcador +1/+1 em Trompetista da Feira.\', \'type\': \'Criatura — Elefante\', \'flavor\': \'Quanto mais alto o elefante trombetava, mais a multidão aclamava. E quanto mais a multidão aclamava...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419840&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35f9ab53-366b-46f4-a4e8-b2eb067bbee6\', \'multiverseId\': 419840}, \'multiverseid\': 419840}, {\'name\': \'Ярмарочный Трубач\', \'text\': \'В начале каждого заключительного шага, если в этом ходу на перманент под вашим контролем был помещен жетон +1/+1, положите один жетон +1/+1 на Ярмарочного Трубача.\', \'type\': \'Существо — Слон\', \'flavor\': \'Чем громче трубил слон, тем громче ликовала толпа. А чем громче ликовала толпа...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420104&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a06dd647-df27-45b0-8c21-c0f680d58100\', \'multiverseId\': 420104}, \'multiverseid\': 420104}, {\'name\': \'展区鸣象\', \'text\': \'在每个结束步骤开始时，若本回合中曾在由你操控的永久物上放置+1/+1指示物，则在展区鸣象上放置一个+1/+1指示物。\', \'type\': \'生物～象\', \'flavor\': \'象的怒吼愈大声，群众的欢呼愈响亮。而群众的欢呼愈响亮. . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417992&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4598288d-6a90-46b6-9dd6-5b93a1489a75\', \'multiverseId\': 417992}, \'multiverseid\': 417992}, {\'name\': \'展區鳴象\', \'text\': \'在每個結束步驟開始時，若本回合中曾在由你操控的永久物上放置+1/+1指示物，則在展區鳴象上放置一個+1/+1指示物。\', \'type\': \'生物～象\', \'flavor\': \'象的怒吼愈大聲，群眾的歡呼愈響亮。而群眾的歡呼愈響亮. . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418256&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8f23d643-dee7-4c59-83b1-6543ab067216\', \'multiverseId\': 418256}, \'multiverseid\': 418256}]', "[{'name': 'Metallener Koloss', 'text': 'Der Metallene Koloss kostet beim Wirken {X} weniger, wobei X die Summe der umgewandelten Manakosten aller Nichtkreatur-Artefakte ist, die du kontrollierst.\\nOpfere zwei Artefakte: Bringe den Metallenen Koloss aus deinem Friedhof auf deine Hand zurück.', 'type': 'Artefaktkreatur — Konstrukt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418587&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b7c21923-aca2-476f-8dcd-2af6ed5b337f', 'multiverseId': 418587}, 'multiverseid': 418587}, {'name': 'Coloso metalúrgico', 'text': 'Cuesta {X} menos lanzar al Coloso metalúrgico, donde X es el coste de maná convertido total de los artefactos que no sean criatura que controlas.\\nSacrificar dos artefactos: Regresa el Coloso metalúrgico de tu cementerio a tu mano.', 'type': 'Criatura artefacto — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420435&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7f7936be-2e2b-4318-9c06-8f6497c7a3aa', 'multiverseId': 420435}, 'multiverseid': 420435}, {'name': 'Colosse de métallurgie', 'text': 'Le Colosse de métallurgie coûte {X} de moins à lancer, X étant le coût converti de mana total des artefacts non-créature que vous contrôlez.\\nSacrifiez deux artefacts : Renvoyez le Colosse de métallurgie depuis votre cimetière dans votre main.', 'type': 'Créature-artefact : construction', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418851&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'eb6100ae-9f6c-4dc1-a850-fa8c3715ad58', 'multiverseId': 418851}, 'multiverseid': 418851}, {'name': 'Colosso di Metallo Lavorato', 'text': 'Il Colosso di Metallo Lavorato costa {X} in meno per essere lanciato, dove X è il costo di mana convertito totale degli artefatti non creatura che controlli.\\nSacrifica due artefatti: Riprendi in mano il Colosso di Metallo Lavorato dal tuo cimitero.', 'type': 'Creatura Artefatto — Costrutto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419115&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '40ed9a35-afb6-4153-a433-12d220f830af', 'multiverseId': 419115}, 'multiverseid': 419115}, {'name': '金属製の巨像', 'text': '金属製の巨像を唱えるためのコストは{X}少なくなる。Ｘはあなたがコントロールするクリーチャーでないアーティファクトの点数で見たマナ・コストの合計に等しい。\\nアーティファクト２つを生け贄に捧げる：あなたの墓地から金属製の巨像をあなたの手札に戻す。', 'type': 'アーティファクト・クリーチャー — 構築物', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419379&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ccef3838-ac38-4e26-84de-8d86da23ceef', 'multiverseId': 419379}, 'multiverseid': 419379}, {'name': '금속 가공 거상', 'text': '금속 가공 거상은 발동하는 비용이 {X}만큼 덜 든다. X는 당신이 조종하는 생물이 아닌 마법물체의 총 전환마나비용이다.\\n마법물체 두 개를 희생한다: 금속 가공 거상을 당신의 무덤에서 당신의 손으로 되돌린다.', 'type': '마법물체 생물 — 자동기계', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419643&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'fa17fe50-4b4d-48da-a64d-ddbf44225209', 'multiverseId': 419643}, 'multiverseid': 419643}, {'name': 'Colosso de Serralheria', 'text': 'Colosso de Serralheria custa {X} a menos para ser conjurado, sendo X o custo de mana convertido total dos artefatos que você controla que não sejam criaturas.\\nSacrifique dois artefatos: Devolva Colosso de Serralheria de seu cemitério para sua mão.', 'type': 'Criatura Artefato — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419907&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b94db48c-1768-4176-a180-4e90c85064ec', 'multiverseId': 419907}, 'multiverseid': 419907}, {'name': 'Металлический Колосс', 'text': 'Стоимость разыгрывания Металлического Колосса уменьшается на {X}, где Х — суммарная конвертированная мана-стоимость не являющихся существами артефактов под вашим контролем.\\nПожертвуйте два артефакта: верните Металлического Колосса из вашего кладбища в вашу руку.', 'type': 'Артефакт Существо — Конструкция', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420171&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1f0e5432-f2d8-44a3-b4f3-6f3ce4be3d32', 'multiverseId': 420171}, 'multiverseid': 420171}, {'name': '金工巨像', 'text': '金工巨像减少{X}来施放，X为所有由你操控之非生物神器总法术力费用的总和。\\n牺牲两个神器：将金工巨像从你的坟墓场移回你手上。', 'type': '神器生物～组构体', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418059&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '60084dde-cdc3-45c0-8fb1-0122ef909801', 'multiverseId': 418059}, 'multiverseid': 418059}, {'name': '金工巨像', 'text': '金工巨像減少{X}來施放，X為所有由你操控之非生物神器總魔法力費用的總和。\\n犧牲兩個神器：將金工巨像從你的墳墓場移回你手上。', 'type': '神器生物～組構體', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418323&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'b1f54fb0-063b-4661-9667-dfbc2efb63e7', 'multiverseId': 418323}, 'multiverseid': 418323}]", '[{\'name\': \'Metallurgische Beschwörungen\', \'text\': \'Immer wenn du einen Spontanzauber oder eine Hexerei wirkst, erzeuge einen X/X farblosen Konstrukt-Artefaktkreaturenspielstein, wobei X gleich den umgewandelten Manakosten jenes Zauberspruchs ist.\\n{3}{U}{U}, schicke die Metallurgischen Beschwörungen ins Exil: Bringe alle Spontanzauber- und Hexereikarten aus deinem Friedhof auf deine Hand zurück. Aktiviere diese Fähigkeit nur, falls du sechs oder mehr Artefakte kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418421&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4297c913-fe88-422f-af46-a2f095bc36d9\', \'multiverseId\': 418421}, \'multiverseid\': 418421}, {\'name\': \'Invocaciones metalúrgicas\', \'text\': \'Siempre que lances un hechizo de instantáneo o de conjuro, crea una ficha de criatura artefacto Constructo incolora X/X, donde X es el coste de maná convertido de ese hechizo.\\n{3}{U}{U}, exiliar las Invocaciones metalúrgicas: Regresa todas las cartas de instantáneo o de conjuro de tu cementerio a tu mano. Activa esta habilidad solo si controlas seis o más artefactos.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420269&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af08ddb1-a990-4c0b-91be-15e16b0bff47\', \'multiverseId\': 420269}, \'multiverseid\': 420269}, {\'name\': \'Invocations métallurgiques\', \'text\': "À chaque fois que vous lancez un sort d\'éphémère ou de rituel, créez un jeton de créature-artefact X/X incolore Construction, X étant le coût converti de mana de ce sort.\\n{3}{U}{U}, exilez les Invocations métallurgiques : Renvoyez toutes les cartes d\'éphémère et de rituel depuis votre cimetière dans votre main. N\'activez cette capacité que si vous contrôlez au moins six artefacts.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418685&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9db1d88e-62c4-45cc-9eca-e2a426b6c97d\', \'multiverseId\': 418685}, \'multiverseid\': 418685}, {\'name\': \'Evocazioni Metallurgiche\', \'text\': \'Ogniqualvolta lanci una magia istantaneo o stregoneria, crea una pedina creatura artefatto Costrutto X/X incolore, dove X è il costo di mana convertito di quella magia.\\n{3}{U}{U}, Esilia le Evocazioni Metallurgiche: Riprendi in mano tutte le carte istantaneo e stregoneria dal tuo cimitero. Attiva questa abilità solo se controlli sei o più artefatti.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418949&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59fa862f-fef3-4d3b-832e-3312cd465931\', \'multiverseId\': 418949}, \'multiverseid\': 418949}, {\'name\': \'機械医学的召喚\', \'text\': \'あなたがインスタント・呪文かソーサリー・呪文を１つ唱えるたび、無色のＸ/Ｘの構築物・アーティファクト・クリーチャー・トークンを１体生成する。Ｘはその呪文の点数で見たマナ・コストに等しい。\\n{3}{U}{U}, 機械医学的召喚を追放する：あなたの墓地からすべてのインスタント・カードとソーサリー・カードをあなたの手札に戻す。この能力は、あなたがアーティファクトを６つ以上コントロールしているときにのみ起動できる。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419213&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5cbb8e0d-8ef4-44ec-a3f8-126af0e3c9da\', \'multiverseId\': 419213}, \'multiverseid\': 419213}, {\'name\': \'야금학 소환술\', \'text\': \'당신이 순간마법이나 집중마법 주문을 발동할 때마다, X/X 무색 자동기계 마법물체 생물 토큰 한 개를 만든다. X는 그 주문의 전환마나비용이다.\\n{3}{U}{U}, 야금학 소환술을 추방한다: 당신의 무덤에 있는 모든 순간마법 및 집중마법 카드를 당신의 손으로 되돌린다. 이 능력은 당신이 마법물체를 여섯 개 이상 조종할 때에만 활성화할 수 있다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419477&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'22a6a851-6a7c-4f9e-99a2-bf5c8f4037cd\', \'multiverseId\': 419477}, \'multiverseid\': 419477}, {\'name\': \'Invocações Metalúrgicas\', \'text\': \'Toda vez que você conjurar uma mágica instantânea ou um feitiço, crie uma ficha de criatura artefato incolor X/X do tipo Construto, sendo X o custo de mana convertido daquela mágica.\\n{3}{U}{U}, Exile Invocações Metalúrgicas: Devolva todos os cards de mágica instantânea e feitiço de seu cemitério para sua mão. Ative esta habilidade somente se você controlar seis ou mais artefatos.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419741&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d292e84-25f1-4618-9bf9-b9c9edf613ad\', \'multiverseId\': 419741}, \'multiverseid\': 419741}, {\'name\': \'Призыв Металлурга\', \'text\': \'Каждый раз, когда вы разыгрываете мгновенное заклинание или заклинание волшебства, создайте одну фишку артефакта существа X/X бесцветная Конструкция, где X — конвертированная мана-стоимость того заклинания.\\n{3}{U}{U}, изгоните Призыв Металлурга: верните все карты мгновенных заклинаний и волшебства из вашего кладбища в вашу руку. Активируйте эту способность, только если вы контролируете не менее шести артефактов.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420005&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'816ec97f-1f3a-4df4-8190-bed8e6aeee6d\', \'multiverseId\': 420005}, \'multiverseid\': 420005}, {\'name\': \'冶金召唤\', \'text\': \'每当你施放瞬间或法术咒语时，派出一个X/X无色组构体衍生神器生物，X为该咒语的总法术力费用。\\n{3}{U}{U}，放逐冶金召唤：将所有瞬间与法术牌从你的坟墓场移回你手上。只能于你操控六个或更多神器时起动此异能。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417893&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'84b4c301-25b6-4e20-828a-4a36f4dcfe18\', \'multiverseId\': 417893}, \'multiverseid\': 417893}, {\'name\': \'冶金召喚\', \'text\': \'每當你施放瞬間或巫術咒語時，派出一個X/X無色組構體衍生神器生物，X為該咒語的總魔法力費用。\\n{3}{U}{U}，放逐冶金召喚：將所有瞬間與巫術牌從你的墳墓場移回你手上。只能於你操控六個或更多神器時起動此異能。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418157&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'935f2e7c-02c4-41ec-a191-d9a5111c9945\', \'multiverseId\': 418157}, \'multiverseid\': 418157}]', '[{\'name\': \'Metallweber-Rätselknoten\', \'text\': \'Wenn der Metallweber-Rätselknoten ins Spiel kommt, ziehst du eine Karte und verlierst 1 Lebenspunkt.\\n{2}{B}, opfere den Metallweber-Rätselknoten: Du ziehst eine Karte und verlierst 1 Lebenspunkt.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418586&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'848131fa-9446-42eb-aa26-a2409fa7e76f\', \'multiverseId\': 418586}, \'multiverseid\': 418586}, {\'name\': \'Enigma del giroscultor\', \'text\': \'Cuando el Enigma del giroscultor entre al campo de batalla, roba una carta y pierde 1 vida.\\n{2}{B}, sacrificar el Enigma del giroscultor: Roba una carta y pierde 1 vida.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420434&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dc5f1c60-6f3d-4427-90eb-e9e7acde79bd\', \'multiverseId\': 420434}, \'multiverseid\': 420434}, {\'name\': \'Casse-tête du tourneur sur métal\', \'text\': \'Quand le Casse-tête du tourneur sur métal arrive sur le champ de bataille, vous piochez une carte et vous perdez 1 point de vie.\\n{2}{B}, sacrifiez le Casse-tête du tourneur sur métal : Vous piochez une carte et vous perdez 1 point de vie.\', \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418850&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'98bd35f5-ab9f-459a-bb2e-2ac776696003\', \'multiverseId\': 418850}, \'multiverseid\': 418850}, {\'name\': \'Enigmatico del Filametallo\', \'text\': "Quando l\'Enigmatico del Filametallo entra nel campo di battaglia, pesca una carta e perdi 1 punto vita.\\n{2}{B}, Sacrifica l\'Enigmatico del Filametallo: Pesca una carta e perdi 1 punto vita.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419114&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7793c44a-cb47-463a-a406-66674b2f2326\', \'multiverseId\': 419114}, \'multiverseid\': 419114}, {\'name\': \'金属紡績工の組細工\', \'text\': \'金属紡績工の組細工が戦場に出たとき、あなたはカードを１枚引き、あなたは１点のライフを失う。\\n{2}{B}, 金属紡績工の組細工を生け贄に捧げる：あなたはカードを１枚引き、あなたは１点のライフを失う。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ffede7e2-18bc-4a3c-9d8f-ec827ab1e570\', \'multiverseId\': 419378}, \'multiverseid\': 419378}, {\'name\': \'금속공예가의 비밀 장치\', \'text\': \'금속공예가의 비밀 장치가 전장에 들어올 때, 당신은 카드 한 장을 뽑고 생명 1점을 잃는다.\\n{2}{B}, 금속공예가의 비밀 장치를 희생한다: 당신은 카드 한 장을 뽑고 생명 1점을 잃는다.\', \'type\': \'마법물체\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419642&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0ec6fac1-0d38-4e5b-8968-6c00c5da8155\', \'multiverseId\': 419642}, \'multiverseid\': 419642}, {\'name\': \'Quebra-cabeça do Metalofiador\', \'text\': \'Quando Quebra-cabeça do Metalofiador entra no campo de batalha, você compra um card e perde 1 ponto de vida.\\n{2}{B}, Sacrifique Quebra-cabeça do Metalofiador: Você compra um card e perde 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419906&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'771d47d2-6c52-467c-a163-2676ac0a04d6\', \'multiverseId\': 419906}, \'multiverseid\': 419906}, {\'name\': \'Головоломка Металлиматора\', \'text\': \'Когда Головоломка Металлиматора выходит на поле битвы, вы берете карту и теряете 1 жизнь.\\n{2}{B}, пожертвуйте Головоломку Металлиматора: вы берете карту и теряете 1 жизнь.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420170&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec13aeee-a4de-4bcc-9e49-decf912e94ac\', \'multiverseId\': 420170}, \'multiverseid\': 420170}, {\'name\': \'金旋师谜结\', \'text\': \'当金旋师谜结进战场时，你抓一张牌且失去1点生命。\\n{2}{B}，牺牲金旋师谜结：你抓一张牌且失去1点生命。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418058&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d6718d85-2595-4c09-b705-8d1bb287700c\', \'multiverseId\': 418058}, \'multiverseid\': 418058}, {\'name\': \'金旋師謎結\', \'text\': \'當金旋師謎結進戰場時，你抽一張牌且失去1點生命。\\n{2}{B}，犧牲金旋師謎結：你抽一張牌且失去1點生命。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418322&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'db4a0ad9-8cc0-4f2e-82c8-318c1ff2a570\', \'multiverseId\': 418322}, \'multiverseid\': 418322}]', '[{\'name\': \'Minister der Revision\', \'text\': \'Wenn der Minister der Revision ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\n{T}, bezahle {E}: Ein Spieler deiner Wahl legt die obersten drei Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Kreatur — Vedalken, Berater\', \'flavor\': \'„Diese Forschung verstößt gegen Konsulatgesetze."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418422&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d7a31f4f-34cd-4ceb-9f16-8a3cb0dfd15c\', \'multiverseId\': 418422}, \'multiverseid\': 418422}, {\'name\': \'Administrador de la información\', \'text\': \'Cuando el Administrador de la información entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\n{T}, pagar {E}: El jugador objetivo pone las tres primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Criatura — Consejero vedalken\', \'flavor\': \'"Esta investigación supone una violación de las leyes del Consulado".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420270&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97caff76-0ade-465d-a9c7-7f735f20de38\', \'multiverseId\': 420270}, \'multiverseid\': 420270}, {\'name\': \'Ministre des enquêtes\', \'text\': \'Quand le Ministre des enquêtes arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\n{T}, payez {E} : Le joueur ciblé met les trois cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Créature : vedalken et conseiller\', \'flavor\': \'« Ces recherches enfreignent la loi consulaire. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418686&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f8d4892-fc75-435b-857c-1bbef55ebe07\', \'multiverseId\': 418686}, \'multiverseid\': 418686}, {\'name\': \'Ministro delle Inchieste\', \'text\': \'Quando il Ministro delle Inchieste entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\n{T}, Paga {E}: Un giocatore bersaglio mette nel suo cimitero le prime tre carte del suo grimorio.\', \'type\': \'Creatura — Consigliere Vedalken\', \'flavor\': \'"Questa ricerca viola le leggi consolari."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418950&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a2f6df96-20d1-4e01-aba1-b23bbcc52001\', \'multiverseId\': 418950}, \'multiverseid\': 418950}, {\'name\': \'査問長官\', \'text\': \'査問長官が戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n{T}, {E}を支払う：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上からカードを３枚自分の墓地に置く。\', \'type\': \'クリーチャー — ヴィダルケン・アドバイザー\', \'flavor\': \'「この研究は領事府の法に抵触する。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419214&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd597deb-665b-4c2d-9a58-1fead25da803\', \'multiverseId\': 419214}, \'multiverseid\': 419214}, {\'name\': \'조사위원회 장관\', \'text\': \'조사위원회 장관이 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n{T}, {E}를 지불한다: 플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 세 장을 자신의 무덤에 넣는다.\', \'type\': \'생물 — 베달켄 참모\', \'flavor\': \'"이 연구는 영사관 법 위반이오."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419478&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3f734ab2-9cd7-48c7-b7f1-129709ef315c\', \'multiverseId\': 419478}, \'multiverseid\': 419478}, {\'name\': \'Ministro dos Inquéritos\', \'text\': \'Quando Ministro dos Inquéritos entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\n{T}, Pague {E}: O jogador alvo coloca os três cards do topo do grimório dele no próprio cemitério.\', \'type\': \'Criatura — Vedalkeano Conselheiro\', \'flavor\': \'"Esta pesquisa viola a lei do Consulado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419742&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'159c43b7-db34-45a3-a4e4-64632e6cedf1\', \'multiverseId\': 419742}, \'multiverseid\': 419742}, {\'name\': \'Министр Изысканий\', \'text\': \'Когда Министр Изысканий выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\n{T}, заплатите {E}: целевой игрок кладет три верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Существо — Ведалкен Советник\', \'flavor\': \'«Это исследование нарушает закон Консульства».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420006&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'195884a4-fffa-4322-b5d3-aaad64cbb5b7\', \'multiverseId\': 420006}, \'multiverseid\': 420006}, {\'name\': \'检查执行员\', \'text\': \'当检查执行员进战场时，你得到{E}{E}（两个能量指示物）。\\n{T}，支付{E}：目标牌手将其牌库顶的三张牌置入其坟墓场。\', \'type\': \'生物～维多肯／参谋\', \'flavor\': \'「这项研究违反了执政院颁布的法律。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417894&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9df4124a-b1b3-4ace-95dc-948a5c20218c\', \'multiverseId\': 417894}, \'multiverseid\': 417894}, {\'name\': \'檢查執行員\', \'text\': \'當檢查執行員進戰場時，你得到{E}{E}（兩個能量指示物）。\\n{T}，支付{E}：目標玩家將其牌庫頂的三張牌置入其墳墓場。\', \'type\': \'生物～維多肯／參謀\', \'flavor\': \'「這項研究違反了執政院頒佈的法律。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418158&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'82265e77-8b12-4bfb-9ad0-d82e6a060035\', \'multiverseId\': 418158}, \'multiverseid\': 418158}]', '[{\'name\': \'Morbide Neugier\', \'text\': \'Opfere ein Artefakt oder eine Kreatur als zusätzliche Kosten, um die Morbide Neugier zu wirken.\\nZiehe so viele Karten, wie die umgewandelten Manakosten der geopferten bleibenden Karte betragen.\', \'type\': \'Hexerei\', \'flavor\': \'„Jede Schöpfung enthält einen Teil ihres Schöpfers. Sein Wissen, seine Träume, seine Seele. Das ist der beste Teil."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418459&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'362a15d7-6e22-4ed9-bdeb-5c8dd2fb754b\', \'multiverseId\': 418459}, \'multiverseid\': 418459}, {\'name\': \'Curiosidad morbosa\', \'text\': \'Como coste adicional para lanzar la Curiosidad morbosa, sacrifica un artefacto o criatura.\\nRoba una cantidad de cartas igual al coste de maná convertido del permanente sacrificado.\', \'type\': \'Conjuro\', \'flavor\': \'"Toda creación lleva consigo una parte de su creador: su conocimiento, sus sueños, su alma... Y esa parte es la mejor".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420307&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef1ed9e7-605d-4bae-8d98-183ddedfd8fd\', \'multiverseId\': 420307}, \'multiverseid\': 420307}, {\'name\': \'Curiosité morbide\', \'text\': \'En tant que coût supplémentaire pour lancer la Curiosité morbide, sacrifiez un artefact ou une créature.\\nPiochez un nombre de cartes égal au coût converti de mana du permanent sacrifié.\', \'type\': \'Rituel\', \'flavor\': "« Chaque création abrite une partie de son créateur. Ses connaissances, ses rêves, son âme. C\'est ce que je préfère. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418723&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77644884-0501-439e-b4a2-736fffa2b485\', \'multiverseId\': 418723}, \'multiverseid\': 418723}, {\'name\': \'Curiosità Morbosa\', \'text\': \'Come costo addizionale per lanciare la Curiosità Morbosa, sacrifica un artefatto o una creatura.\\nPesca carte pari al costo di mana convertito del permanente sacrificato.\', \'type\': \'Stregoneria\', \'flavor\': \'"Ogni invenzione riflette parte del suo creatore. La sua conoscenza, i suoi sogni, la sua anima... Quella è la parte migliore."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418987&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5f59777e-f78d-4254-9b3f-7dc8624e5d60\', \'multiverseId\': 418987}, \'multiverseid\': 418987}, {\'name\': \'病的な好奇心\', \'text\': \'病的な好奇心を唱えるための追加コストとして、アーティファクト１つかクリーチャー１体を生け贄に捧げる。\\nその生け贄に捧げたパーマネントの点数で見たマナ・コストに等しい枚数のカードを引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「物には創り手の一部が宿っている。知識、夢、魂。それが最高の部品となるのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419251&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8698cfc8-ae96-4123-a49d-d0398481b0aa\', \'multiverseId\': 419251}, \'multiverseid\': 419251}, {\'name\': \'병적 호기심\', \'text\': \'병적 호기심을 발동하기 위한 추가비용으로, 마법물체나 생물을 희생한다.\\n희생된 지속물의 전환마나비용만큼 카드를 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"모든 창조물에는 창조자의 지식, 꿈, 영혼 같은 창조자의 일부가 투영되어 있어. 그게 제일 좋은 부분이지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419515&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'993df573-95d9-41d6-854a-cb2b981b4092\', \'multiverseId\': 419515}, \'multiverseid\': 419515}, {\'name\': \'Curiosidade Mórbida\', \'text\': \'Como custo adicional para conjurar Curiosidade Mórbida, sacrifique um artefato ou uma criatura.\\nCompre uma quantidade de cards igual ao custo de mana convertido da permanente sacrificada.\', \'type\': \'Feitiço\', \'flavor\': \'"Toda criação carrega uma parte de seus criadores. Seu conhecimento, seus sonhos, suas almas. Essa é a melhor parte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419779&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2da930a1-2bee-437a-b450-7235edf5c587\', \'multiverseId\': 419779}, \'multiverseid\': 419779}, {\'name\': \'Болезненное Любопытство\', \'text\': \'В качестве дополнительной стоимости разыгрывания Болезненного Любопытства пожертвуйте артефакт или существо.\\nВозьмите количество карт, равное конвертированной мана-стоимости пожертвованного перманента.\', \'type\': \'Волшебство\', \'flavor\': \'«Каждое создание несет в себе частичку своих создателей. Их мечты, их знания, их душу. И это — самая главная деталь».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420043&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4c09a309-eb2c-4a32-a2ef-e829c3abcc8e\', \'multiverseId\': 420043}, \'multiverseid\': 420043}, {\'name\': \'丧心好奇\', \'text\': \'牺牲一个神器或生物，以作为施放丧心好奇的额外费用。\\n抓若干牌，其数量等同于所牺牲之永久物的总法术力费用。\', \'type\': \'法术\', \'flavor\': \'「每位创造者都会将自身的一部融入其造物当中：他们的知识，他们的梦想，他们的灵魂。这才是造物的精华所在。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417931&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0dd17a5c-535c-4971-af48-2ee34ddad7de\', \'multiverseId\': 417931}, \'multiverseid\': 417931}, {\'name\': \'喪心好奇\', \'text\': \'犧牲一個神器或生物，以作為施放喪心好奇的額外費用。\\n抽若干牌，其數量等同於所犧牲之永久物的總魔法力費用。\', \'type\': \'巫術\', \'flavor\': \'「每位創造者都會將自身的一部融入其造物當中：他們的知識，他們的夢想，他們的靈魂。這才是造物的精華所在。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418195&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1937aa13-1b4a-4259-b4a4-4ca772d9d8a7\', \'multiverseId\': 418195}, \'multiverseid\': 418195}]', '[{\'name\': \'Motoren anlassen\', \'text\': \'Fahrzeuge, die du kontrollierst, werden bis zum Ende des Zuges zu Artefaktkreaturen. Kreaturen, die du kontrollierst, erhalten +2/+0 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Erfinder aus aller Welt sind zur Messe gekommen, um ihre Schöpfungen auf den ersten Platz fliegen, fahren oder segeln zu sehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418500&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'303b4ecd-6485-4a9e-b859-16aa9a40a209\', \'multiverseId\': 418500}, \'multiverseid\': 418500}, {\'name\': \'Encender motores\', \'text\': \'Los Vehículos que controlas se convierten en criaturas artefacto hasta el final del turno. Las criaturas que controlas obtienen +2/+0 hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'A la Feria llegaron inventores de todo el mundo con la esperanza de que sus creaciones voladoras, rodantes o flotantes se llevarían uno de los primeros premios.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420348&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5052748-e51a-4013-95d2-1d2b6655b9b8\', \'multiverseId\': 420348}, \'multiverseid\': 420348}, {\'name\': \'Allumez les moteurs !\', \'text\': "Les véhicules que vous contrôlez deviennent des créatures-artefacts jusqu\'à la fin du tour. Les créatures que vous contrôlez gagnent +2/+0 jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'Les inventeurs du monde entier se rendent à la Foire en espérant que leurs créations voleront, rouleront ou vogueront vers un prix.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418764&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ec502a9-6b2e-45db-be23-8d3ed5fe6fb4\', \'multiverseId\': 418764}, \'multiverseid\': 418764}, {\'name\': \'Accendere i Motori\', \'text\': \'I Veicoli che controlli diventano creature artefatto fino alla fine del turno. Le creature che controlli prendono +2/+0 fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'Gli inventori di tutto il mondo sono giunti alla Fiera nella speranza che le loro invenzioni li facciano planare, sgommare o veleggiare dritti verso il primo premio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419028&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5842ad4-44fc-4270-883c-ddd2f38bfbf9\', \'multiverseId\': 419028}, \'multiverseid\': 419028}, {\'name\': \'エンジン始動\', \'text\': \'ターン終了時まで、あなたがコントロールする機体はアーティファクト・クリーチャーになる。ターン終了時まで、あなたがコントロールするクリーチャーは＋２/＋０の修整を受ける。\', \'type\': \'ソーサリー\', \'flavor\': \'世界中の発明者たちが、自身の作品が優勝することを願って博覧会に集まっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419292&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'99b0ca96-e56c-45b3-bbdf-1415ee60248b\', \'multiverseId\': 419292}, \'multiverseid\': 419292}, {\'name\': \'엔진 시동\', \'text\': \'당신이 조종하는 탑승물들은 턴종료까지 마법물체 생물이 된다. 당신이 조종하는 생물들은 턴종료까지 +2/+0을 받는다.\', \'type\': \'집중마법\', \'flavor\': \'전 세계의 발명가들이 자신의 발명품으로 대상을 받을 수 있을 거라는 희망을 가지고 박람회에 참가한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419556&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6108ac09-29d5-4799-ab6e-202ec6aa9407\', \'multiverseId\': 419556}, \'multiverseid\': 419556}, {\'name\': \'Liguem Seus Motores\', \'text\': \'Os Veículos que você controla se tornam criaturas artefato até o final do turno. As criaturas que você controla recebem +2/+0 até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'A Feira recebe inventores de todo o mundo esperançosos de ver suas criações voarem, correrem ou navegarem rumo ao primeiro prêmio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419820&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90e7f617-a3b5-465b-815c-659eff3d5802\', \'multiverseId\': 419820}, \'multiverseid\': 419820}, {\'name\': \'Завести Моторы\', \'text\': \'Машины под вашим контролем становятся артефактами существами до конца хода. Существа под вашим контролем получают +2/+0 до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'Изобретатели со всех концов света собираются на Ярмарке, надеясь, что именно их творение прилетит, прикатит или приплывет к главному призу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420084&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'747e41c9-7147-4cca-a591-5c8742a1c333\', \'multiverseId\': 420084}, \'multiverseid\': 420084}, {\'name\': \'启动引擎\', \'text\': \'由你操控的载具成为神器生物直到回合结束。由你操控的生物得+2/+0直到回合结束。\', \'type\': \'法术\', \'flavor\': \'世界各地的发明家齐聚博览会，希望自己能飞行、奔驰或航行的创作一路畅行，勇夺头奖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417972&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c77a62e5-9eb3-42e5-b0ac-4d2a802daa9e\', \'multiverseId\': 417972}, \'multiverseid\': 417972}, {\'name\': \'啟動引擎\', \'text\': \'由你操控的載具成為神器生物直到回合結束。由你操控的生物得+2/+0直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'世界各地的發明家齊聚博覽會，希望自己能飛行、奔馳或航行的創作一路暢行，勇奪頭獎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418236&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a976d5c8-dc20-4aaa-bcf9-a525bdf55109\', \'multiverseId\': 418236}, \'multiverseid\': 418236}]', '[{\'name\': \'Multiformenwunder\', \'text\': \'Wenn das Multiformenwunder ins Spiel kommt, erhältst du {E}{E}{E} (drei Energiemarken).\\nBezahle {E}: Das Multiformenwunder erhält bis zum Ende des Zuges entweder Flugfähigkeit, Wachsamkeit oder Lebensverknüpfung (du entscheidest).\\nBezahle {E}: Das Multiformenwunder erhält +2/-2 oder -2/+2 bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418588&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b9501dc-bd99-42ee-9408-974afe191f72\', \'multiverseId\': 418588}, \'multiverseid\': 418588}, {\'name\': \'Maravilla multiforme\', \'text\': \'Cuando la Maravilla multiforme entre al campo de batalla, obtienes {E}{E}{E} (tres contadores de energía).\\nPagar {E}: La Maravilla multiforme gana a tu elección la habilidad de volar, vigilancia o vínculo vital hasta el final del turno.\\nPagar {E}: La Maravilla multiforme obtiene +2/-2 o -2/+2 hasta el final del turno.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420436&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7387e61a-89d1-46ec-aea4-b4a93fec0920\', \'multiverseId\': 420436}, \'multiverseid\': 420436}, {\'name\': \'Merveille multiforme\', \'text\': "Quand la Merveille multiforme arrive sur le champ de bataille, vous gagnez {E}{E}{E} (trois marqueurs « énergie »).\\nPayez {E} : La Merveille multiforme acquiert, selon votre choix, le vol, la vigilance ou le lien de vie jusqu\'à la fin du tour.\\nPayez {E} : La Merveille multiforme gagne +2/-2 ou -2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418852&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22593239-4a9d-457d-b2de-7a00bafb3d49\', \'multiverseId\': 418852}, \'multiverseid\': 418852}, {\'name\': \'Meraviglia Multiforme\', \'text\': \'Quando la Meraviglia Multiforme entra nel campo di battaglia, ottieni {E}{E}{E} (tre segnalini energia).\\nPaga {E}: La Meraviglia Multiforme ha a tua scelta volare, cautela o legame vitale fino alla fine del turno.\\nPaga {E}: La Meraviglia Multiforme prende +2/-2 o -2/+2 fino alla fine del turno.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419116&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3dbe2c86-b5c1-475d-86f2-42a25c64d2c7\', \'multiverseId\': 419116}, \'multiverseid\': 419116}, {\'name\': \'多用途な逸品\', \'text\': \'多用途な逸品が戦場に出たとき、あなたは{E}{E}{E}（エネルギー・カウンター３個）を得る。\\n{E}を支払う：ターン終了時まで、多用途な逸品は飛行か警戒か絆魂のうち、あなたが選んだ１つを得る。\\n{E}を支払う：ターン終了時まで、多用途な逸品は＋２/－２か－２/＋２の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419380&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02b033f0-04a6-49be-b718-b9423522c8cd\', \'multiverseId\': 419380}, \'multiverseid\': 419380}, {\'name\': \'다형상 걸작\', \'text\': \'다형상 걸작이 전장에 들어올 때, 당신은 {E}{E}{E}(에너지 카운터 세 개)를 얻는다.\\n{E}를 지불한다: 다형상 걸작은 턴종료까지 비행, 경계 또는 생명연결 중에서 당신이 선택한 능력을 얻는다.\\n{E}를 지불한다: 다형상 걸작은 턴종료까지 +2/-2 또는 -2/+2를 받는다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419644&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'31f5414e-c6ae-4b5b-9b33-d50acc630aea\', \'multiverseId\': 419644}, \'multiverseid\': 419644}, {\'name\': \'Maravilha Multiforme\', \'text\': \'Quando Maravilha Multiforme entra no campo de batalha, você recebe {E}{E}{E} (três marcadores de energia).\\nPague {E}: Maravilha Multiforme ganha o que você escolher entre voar, vigilância ou vínculo com a vida, até o final do turno.\\nPague {E}: Maravilha Multiforme recebe +2/-2 ou -2/+2 até o final do turno.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419908&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a2deec2-bec8-44bd-b078-3929b9d7d3ae\', \'multiverseId\': 419908}, \'multiverseid\': 419908}, {\'name\': \'Переменчивый Шедевр\', \'text\': \'Когда Переменчивый Шедевр выходит на поле битвы, вы получаете {E}{E}{E} (три жетона энергии).\\nЗаплатите {E}: Переменчивый Шедевр до конца хода получает по вашему выбору Полет, Бдительность или Цепь жизни.\\nЗаплатите {E}: Переменчивый Шедевр получает +2/-2 или -2/+2 до конца хода.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420172&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'66234052-1187-443a-8601-8eab784dea9c\', \'multiverseId\': 420172}, \'multiverseid\': 420172}, {\'name\': \'多态妙械\', \'text\': \'当多态妙械进战场时，你得到{E}{E}{E}（三个能量指示物）。\\n支付{E}：选择飞行，警戒或系命。多态妙械获得该异能直到回合结束。\\n支付{E}：多态妙械得+2/-2或-2/+2直到回合结束。\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'85ec2639-8dfe-4ed5-b2c3-f2627c016fad\', \'multiverseId\': 418060}, \'multiverseid\': 418060}, {\'name\': \'多態妙械\', \'text\': \'當多態妙械進戰場時，你得到{E}{E}{E}（三個能量指示物）。\\n支付{E}：選擇飛行，警戒或繫命。多態妙械獲得該異能直到回合結束。\\n支付{E}：多態妙械得+2/-2或-2/+2直到回合結束。\', \'type\': \'神器生物～組構體\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418324&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1b054da-0461-4afc-b2f8-45cf01a1c98f\', \'multiverseId\': 418324}, \'multiverseid\': 418324}]', '[{\'name\': \'Nachtmarkt-Aufpasserin\', \'text\': \'Immer wenn die Nachtmarkt-Aufpasserin getappt wird, verliert jeder Gegner 1 Lebenspunkt und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Selten erfährt das Konsulat vor dem Morgengrauen, wo ein Nachtmarkt stattfindet, und Vollstrecker, die dem Ort zu nahe kommen, werden rasch beseitigt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418460&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed35b513-374c-4764-a550-6d622961c03b\', \'multiverseId\': 418460}, \'multiverseid\': 418460}, {\'name\': \'Vigilante de mercado nocturno\', \'text\': \'Siempre que la Vigilante de mercado nocturno se gire, cada oponente pierde 1 vida y tú ganas 1 vida.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'El Consulado no suele descubrir el código secreto de la ubicación de un mercado nocturno antes del alba y, si sus esbirros se acercan demasiado, alguien se ocupa de ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420308&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a1a725e8-c69a-462a-bad6-ccd58651218f\', \'multiverseId\': 420308}, \'multiverseid\': 420308}, {\'name\': \'Vigie du marché nocturne\', \'text\': \'À chaque fois que la Vigie du marché nocturne devient engagée, chaque adversaire perd 1 point de vie et vous gagnez 1 point de vie.\', \'type\': \'Créature : humain et gredin\', \'flavor\': "Il est rare que le Consulat parvienne à décrypter l\'annonce du lieu d\'un marché nocturne avant l\'aube, et les argousins sont rapidement éliminés s\'ils s\'aventurent trop près.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418724&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96007288-c17c-48e6-b13f-d5814ca7d3ab\', \'multiverseId\': 418724}, \'multiverseid\': 418724}, {\'name\': \'Vedetta del Mercato Notturno\', \'text\': \'Ogniqualvolta la Vedetta del Mercato Notturno viene TAPpata, ogni avversario perde 1 punto vita e tu guadagni 1 punto vita.\', \'type\': \'Creatura — Farabutto Umano\', \'flavor\': "Il Consolato raramente decifra i messaggi in codice che annunciano la sede di un mercato notturno prima dell\'alba e, se gli esecutori si avvicinano troppo, qualcuno è pronto a occuparsene.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418988&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56c2fe66-567e-44e5-95d4-bae836e9c97c\', \'multiverseId\': 418988}, \'multiverseid\': 418988}, {\'name\': \'夜市の見張り\', \'text\': \'夜市の見張りがタップ状態になるたび、各対戦相手はそれぞれ１点のライフを失い、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'暗号で書かれた夜市の開催案内を、夜明け前に領事府が解読できることは滅多にない。たまたま近くに来た執行官など、なんとでもなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419252&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'00c943b7-cef7-463b-8437-68cbd2204470\', \'multiverseId\': 419252}, \'multiverseid\': 419252}, {\'name\': \'야시장 파수꾼\', \'text\': \'야시장 파수꾼이 탭될 때마다, 각 상대는 생명 1점을 잃고 당신은 생명 1점을 얻는다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'영사관은 새벽이 오기 전에 야시장의 위치가 적힌 암호화된 공지를 해독한 적이 거의 없다. 게다가 그곳에 너무 가까이 접근한 집행인들은 쥐도 새도 모르게 사라진다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419516&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d1ac1509-7e2e-4093-882d-0b845e3900d9\', \'multiverseId\': 419516}, \'multiverseid\': 419516}, {\'name\': \'Vigia do Mercado Noturno\', \'text\': \'Toda vez que Vigia do Mercado Noturno é virado, cada oponente perde 1 ponto de vida e você ganha 1 ponto de vida.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'O Consulado raramente decifra a mensagem em código que anuncia o local de um mercado noturno antes da alvorada, e caso os policiais cheguem perto demais, alguém se encarrega deles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419780&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e1cbe10-c4f6-4da4-a357-e68ef94a7ff6\', \'multiverseId\': 419780}, \'multiverseid\': 419780}, {\'name\': \'Дозорная с Ночного Рынка\', \'text\': \'Каждый раз, когда Дозорная с Ночного Рынка поворачивается, каждый оппонент теряет 1 жизнь, а вы получаете 1 жизнь.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Консульству редко удается до рассвета разгадать зашифрованное сообщение о том, где проходит ночной рынок. А если поблизости от него оказываются блюстители, то о них позаботятся.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420044&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'146d2b04-3169-4e4f-8472-0aa84430b768\', \'multiverseId\': 420044}, \'multiverseid\': 420044}, {\'name\': \'晚市警戒员\', \'text\': \'每当晚市警戒员成为横置时，每位对手各失去1点生命且你获得1点生命。\', \'type\': \'生物～人类／浪客\', \'flavor\': \'执政院鲜能在日出前破解晚市地点的加密告示，而靠得太近的执法者又会被尽数解决。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417932&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8e988bb-21d5-4058-aa2c-921cccbd4e87\', \'multiverseId\': 417932}, \'multiverseid\': 417932}, {\'name\': \'晚市警戒員\', \'text\': \'每當晚市警戒員成為橫置時，每位對手各失去1點生命且你獲得1點生命。\', \'type\': \'生物～人類／浪客\', \'flavor\': \'執政院鮮能在日出前破解晚市地點的加密告示，而靠得太近的執法者又會被盡數解決。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418196&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b0a944dd-0025-4942-acfa-fdc2f92b141d\', \'multiverseId\': 418196}, \'multiverseid\': 418196}]', '[{\'name\': \'Nachtschicht\', \'text\': \'Die Nachtschicht kommt mit sieben Stundenmarken ins Spiel.\\nZiehe zu Beginn deines Ziehsegments eine zusätzliche Karte und entferne zwei Stundenmarken von der Nachtschicht.\\nDeine maximale Handkartenzahl ist gleich der Anzahl an Stundenmarken auf der Nachtschicht.\\nImmer wenn du eine Karte abwirfst, verlierst du 1 Lebenspunkt.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418457&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75798b45-eb01-48cc-bde9-5c47fa27e6d3\', \'multiverseId\': 418457}, \'multiverseid\': 418457}, {\'name\': \'Hasta el último segundo\', \'text\': \'Hasta el último segundo entra al campo de batalla con siete contadores de hora sobre él.\\nAl comienzo de tu paso de robar, roba una carta adicional y remueve dos contadores de hora de Hasta el último segundo.\\nTu tamaño máximo de mano es igual a la cantidad de contadores de hora sobre Hasta el último segundo.\\nSiempre que descartes una carta, pierdes 1 vida.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420305&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1104caf4-052f-488c-9f12-6b7b53ee35d8\', \'multiverseId\': 420305}, \'multiverseid\': 420305}, {\'name\': \'Nuit blanche\', \'text\': "La Nuit blanche arrive sur le champ de bataille avec sept marqueurs « heure » sur elle.\\nAu début de votre étape de pioche, piochez une carte supplémentaire et retirez deux marqueurs « heure » de la Nuit blanche.\\nLa taille maximale de votre main est égale au nombre de marqueurs « heure » sur la Nuit blanche.\\nÀ chaque fois que vous vous défaussez d\'une carte, vous perdez 1 point de vie.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418721&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8e7d5d1-e306-46c6-ad0c-d7aa8d09ebe4\', \'multiverseId\': 418721}, \'multiverseid\': 418721}, {\'name\': \'Ore Piccole\', \'text\': "Le Ore Piccole entrano nel campo di battaglia con sette segnalini ora.\\nAll\'inizio della tua sottofase di acquisizione, pesca una carta addizionale e rimuovi due segnalini ora dalle Ore Piccole.\\nIl limite massimo di carte nella tua mano è pari al numero di segnalini ora sulle Ore Piccole.\\nOgniqualvolta scarti una carta, perdi 1 punto vita.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418985&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'362ed7f2-ea8b-438b-aa8a-a68efc17fc33\', \'multiverseId\': 418985}, \'multiverseid\': 418985}, {\'name\': \'夜更かし\', \'text\': \'夜更かしは時刻カウンターが７個置かれた状態で戦場に出る。\\nあなたのドロー・ステップの開始時に、あなたはカードを追加で１枚引き、夜更かしの上から時刻カウンターを２個取り除く。\\nあなたの手札の上限は、夜更かしの上に置かれている時刻カウンターの数に等しい。\\nあなたがカードを１枚捨てるたび、あなたは１点のライフを失う。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419249&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'17427eac-b47d-4458-9d3e-babd775b9839\', \'multiverseId\': 419249}, \'multiverseid\': 419249}, {\'name\': \'철야\', \'text\': \'철야는 시간 카운터 일곱 개를 가진 채로 전장에 들어온다.\\n당신의 뽑기단 시작에, 카드 한 장을 추가로 뽑고 철야의 시간 카운터 두 개를 제거한다.\\n당신이 손에 가질 수 있는 최대 카드 수는 철야의 시간 카운터 수와 같다.\\n당신이 카드를 버릴 때마다, 당신은 생명 1점을 잃는다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419513&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9fd0f27c-4a61-4f15-b5b9-a879bcd15559\', \'multiverseId\': 419513}, \'multiverseid\': 419513}, {\'name\': \'Varar a Noite\', \'text\': \'Varar a Noite entra no campo de batalha com sete marcadores de hora.\\nNo início de sua fase de compra, compre um card adicional e remova dois marcadores de hora de Varar a Noite.\\nO tamanho máximo de sua mão é igual ao número de marcadores de hora em Varar a Noite.\\nToda vez que você descarta um card, você perde 1 ponto de vida.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa64fdcf-8a55-446a-88dd-033b9d8e7433\', \'multiverseId\': 419777}, \'multiverseid\': 419777}, {\'name\': \'Полуночные Бдения\', \'text\': \'Полуночные Бдения выходят на поле битвы с семью жетонами часа на них.\\nВ начале вашего шага взятия карты возьмите дополнительную карту и удалите два жетона часа с Полуночных Бдений.\\nМаксимальный размер вашей руки равен количеству жетонов часа на Полуночных Бдениях.\\nКаждый раз, когда вы сбрасываете карту, вы теряете 1 жизнь.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420041&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'61bb5c27-931a-43a1-a1bc-1b751da3d402\', \'multiverseId\': 420041}, \'multiverseid\': 420041}, {\'name\': \'焚膏继晷\', \'text\': \'焚膏继晷进战场时上面有七个时刻指示物。\\n在你的抓牌步骤开始时，额外抓一张牌，并从焚膏继晷上移去两个时刻指示物。\\n你的手牌数量上限等同于焚膏继晷上时刻指示物的数量。\\n每当你弃一张牌时，你失去1点生命。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417929&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b120a011-99a4-4688-a822-1d9d3c6c850a\', \'multiverseId\': 417929}, \'multiverseid\': 417929}, {\'name\': \'焚膏繼晷\', \'text\': \'焚膏繼晷進戰場時上面有七個時刻指示物。\\n在你的抽牌步驟開始時，額外抽一張牌，並從焚膏繼晷上移去兩個時刻指示物。\\n你的手牌數量上限等同於焚膏繼晷上時刻指示物的數量。\\n每當你棄一張牌時，你失去1點生命。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418193&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'23cf30cd-d3d5-4d2f-ba8c-c9d05a618c71\', \'multiverseId\': 418193}, \'multiverseid\': 418193}]', '[{\'name\': \'Narnam-Kobra\', \'text\': \'{G}: Die Narnam-Kobra erhält Todesberührung bis zum Ende des Zuges. (Eine beliebige Menge Schadenspunkte, die sie einer Kreatur zufügt, ist ausreichend, um diese zu zerstören.)\', \'type\': \'Artefaktkreatur — Ophis\', \'flavor\': \'Manche sagen, dass die Geschichten vom Narnam-Gewächshaus nur die Kinder erschrecken sollen, aber in jeder Geschichte steckt ein Körnchen Wahrheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418589&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c606185-0129-4273-97f5-08437f9e4535\', \'multiverseId\': 418589}, \'multiverseid\': 418589}, {\'name\': \'Cobra de Narnam\', \'text\': \'{G}: La Cobra de Narnam gana la habilidad de toque mortal hasta el final del turno. (Cualquier cantidad de daño que haga a una criatura es suficiente para destruirla.)\', \'type\': \'Criatura artefacto — Víbora\', \'flavor\': \'Algunos dicen que las historias del invernadero Narnam son invenciones para asustar a los niños, pero en toda leyenda hay una pizca de verdad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420437&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff4b88e7-1ed1-47a6-99e7-fe3a53de9964\', \'multiverseId\': 420437}, \'multiverseid\': 420437}, {\'name\': \'Cobra de Narnam\', \'text\': "{G} : Le Cobra de Narnam acquiert le contact mortel jusqu\'à la fin du tour. (Le nombre de blessures qu\'il inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)", \'type\': \'Créature-artefact : serpent\', \'flavor\': "Certains disent que les légendes de la serre de Narnam ne servent qu\'à effrayer les enfants, mais toutes les histoires ont un fond de vérité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418853&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7aaf7e2a-19cb-4bf1-9e13-2d3211240265\', \'multiverseId\': 418853}, \'multiverseid\': 418853}, {\'name\': \'Cobra di Narnam\', \'text\': \'{G}: Il Cobra di Narnam ha tocco letale fino alla fine del turno. (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)\', \'type\': \'Creatura Artefatto — Serpente\', \'flavor\': "Secondo alcuni, le leggende narrate sulla serra di Narnam servono solo a spaventare i bambini, ma in ogni storia c\'è un fondo di verità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419117&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0eef7401-e2ab-48ee-8cee-aace99010328\', \'multiverseId\': 419117}, \'multiverseid\': 419117}, {\'name\': \'ナーナムのコブラ\', \'text\': \'{G}：ターン終了時まで、ナーナムのコブラは接死を得る。（これが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）\', \'type\': \'アーティファクト・クリーチャー — 蛇\', \'flavor\': \'ナーナム温室の物語は子供を怖がらせるための作り話だという人が多いが、大抵の作り話は実話が誇張されたものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419381&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d3a18053-5b39-44c7-a223-c67aac387e13\', \'multiverseId\': 419381}, \'multiverseid\': 419381}, {\'name\': \'나르남 코브라\', \'text\': \'{G}: 나르남 코브라는 턴종료까지 치명타를 얻는다. (이 생물에 피해를 입은 생물은 입은 피해의 양에 상관없이 파괴된다.)\', \'type\': \'마법물체 생물 — 뱀\', \'flavor\': \'혹자는 나르남 온실 이야기가 아이들을 겁주려고 만든 이야기라고 하지만, 모든 이야기는 진실이라는 씨앗으로부터 시작된다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419645&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ff4e67ce-08c2-441a-99a4-a7b1446f1690\', \'multiverseId\': 419645}, \'multiverseid\': 419645}, {\'name\': \'Naja da Narnam\', \'text\': \'{G}: Naja da Narnam ganha toque mortífero até o final do turno. (Qualquer quantidade de dano que ela causa a uma criatura é suficiente para destruí-la.)\', \'type\': \'Criatura Artefato — Cobra\', \'flavor\': \'Alguns dizem que as histórias sobre a estufa de Narnam são para assustar as crianças, mas toda história brota de uma semente de verdade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419909&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e794468-e9a5-42b3-abf8-1f5bef307874\', \'multiverseId\': 419909}, \'multiverseid\': 419909}, {\'name\': \'Нарнамская Кобра\', \'text\': \'{G}: Нарнамская Кобра получает Смертельное касание до конца хода. (Любого количества повреждений, которое она наносит существу, достаточно, чтобы уничтожить то существо.)\', \'type\': \'Артефакт Существо — Змея\', \'flavor\': \'Некоторые говорят, что истории о Нарнамской теплице — просто страшные сказки для детей, но каждая сказка растет из семени истины.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420173&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fefc7224-9181-4d1b-994f-058c40729e59\', \'multiverseId\': 420173}, \'multiverseid\': 420173}, {\'name\': \'纳南眼镜蛇\', \'text\': \'{G}：纳南眼镜蛇获得死触异能直到回合结束。（它对生物造成的任何数量伤害都足以消灭后者。）\', \'type\': \'神器生物～蛇\', \'flavor\': \'有人说纳南温室的故事只是为了吓小孩，但每个传说都是从真实开始萌发。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418061&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd2cf587-16d1-4909-889f-9e3de6419a3e\', \'multiverseId\': 418061}, \'multiverseid\': 418061}, {\'name\': \'納南眼鏡蛇\', \'text\': \'{G}：納南眼鏡蛇獲得死觸異能直到回合結束。（它對生物造成的任何數量傷害都足以消滅後者。）\', \'type\': \'神器生物～蛇\', \'flavor\': \'有人說納南溫室的故事只是為了嚇小孩，但每個傳說都是從真實開始萌發。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418325&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0dbf1eba-96c8-401c-95db-3cad36dc820b\', \'multiverseId\': 418325}, \'multiverseid\': 418325}]', '[{\'name\': \'Nicht bestandene Inspektion\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl. Ziehe eine Karte und wirf dann eine Karte ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'Das Gefährlichste, was ein Handwerker machen kann, ist anzunehmen, dass eine Erfindung perfekt sei.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418412&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'340e469e-88a5-4424-a698-20d00194815e\', \'multiverseId\': 418412}, \'multiverseid\': 418412}, {\'name\': \'Inspección no superada\', \'text\': \'Contrarresta el hechizo objetivo. Roba una carta, luego descarta una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Lo más peligroso que puede hacer un artífice es creer que un invento es perfecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420260&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0524aa0f-827f-45c9-8d90-5a254c38cab4\', \'multiverseId\': 420260}, \'multiverseid\': 420260}, {\'name\': "Échec à l\'inspection", \'text\': "Contrecarrez le sort ciblé. Piochez une carte, puis défaussez-vous d\'une carte.", \'type\': \'Éphémère\', \'flavor\': "Pour un artificier, il n\'y a rien de plus dangereux que de croire qu\'une invention est parfaite.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418676&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'acb1292a-7d0b-449e-996c-27c1ec70fbc1\', \'multiverseId\': 418676}, \'multiverseid\': 418676}, {\'name\': \'Ispezione Fallita\', \'text\': \'Neutralizza una magia bersaglio. Pesca una carta, poi scarta una carta.\', \'type\': \'Istantaneo\', \'flavor\': "La cosa più pericolosa che un artefice possa fare è considerare un\'invenzione perfetta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418940&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7cae43be-b13a-43f4-9487-9d2facff92c4\', \'multiverseId\': 418940}, \'multiverseid\': 418940}, {\'name\': \'検査不合格\', \'text\': \'呪文１つを対象とし、それを打ち消す。カードを１枚引き、その後カード１枚を捨てる。\', \'type\': \'インスタント\', \'flavor\': \'工匠にとって最も危険なのは、自分の発明品が完全だと過信することだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419204&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'407a72ed-b874-4eb3-ae7a-048776485460\', \'multiverseId\': 419204}, \'multiverseid\': 419204}, {\'name\': \'검사 실패\', \'text\': \'주문을 목표로 정한다. 그 주문을 무효화한다. 카드 한 장을 뽑은 후 카드 한 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': \'기능공이 할 수 있는 가장 위험한 생각은 발명이 완벽하다고 믿는 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419468&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'30abf528-6aa8-4aea-84dd-45d26d0a6cd3\', \'multiverseId\': 419468}, \'multiverseid\': 419468}, {\'name\': \'Inspeção Fracassada\', \'text\': \'Anule a mágica alvo. Compre um card e depois descarte um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A coisa mais perigosa que um artesão pode fazer é crer que uma invenção é perfeita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419732&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a0ef1cbb-5175-4b1a-9e1e-6845441dca32\', \'multiverseId\': 419732}, \'multiverseid\': 419732}, {\'name\': \'Проваленный Осмотр\', \'text\': \'Отмените целевое заклинание. Возьмите карту, затем сбросьте карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Самое опасное, что может сделать механик, — решить, что его изобретение безупречно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419996&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'03725aea-0a9c-4211-86d2-3ffc7ea71e56\', \'multiverseId\': 419996}, \'multiverseid\': 419996}, {\'name\': \'检出劣品\', \'text\': \'反击目标咒语。抓一张牌，然后弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'神器师最危险的举动便是相信某项发明完美无缺。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f4a2c81c-8809-4016-82cb-eabd76fd6b5b\', \'multiverseId\': 417884}, \'multiverseid\': 417884}, {\'name\': \'檢出劣品\', \'text\': \'反擊目標咒語。抽一張牌，然後棄一張牌。\', \'type\': \'瞬間\', \'flavor\': \'神器師最危險的舉動便是相信某項發明完美無缺。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418148&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dca264f0-9331-42af-b761-55b390dbdff8\', \'multiverseId\': 418148}, \'multiverseid\': 418148}]', '[{\'name\': \'Nissa, Macht des Lebens\', \'text\': \'+1: Enttappe ein Land deiner Wahl, das du kontrollierst. Bis zu deinem nächsten Zug wird es zu einer 5/5 Elementarwesen-Kreatur mit Eile. Es ist immer noch ein Land.\\n—3: Bringe eine bleibende Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\n—6: Du erhältst ein Emblem mit „Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, kannst du eine Karte ziehen."\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418528&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6b82a54-f4c9-44c6-bde2-fd14d519d666\', \'multiverseId\': 418528}, \'multiverseid\': 418528}, {\'name\': \'Nissa, fuerza vital\', \'text\': \'+1: Endereza la tierra objetivo que controlas. Hasta tu próximo turno, se convierte en una criatura Elemental 5/5 con la habilidad de prisa. Sigue siendo una tierra.\\n−3: Regresa la carta de permanente objetivo de tu cementerio a tu mano.\\n−6: Obtienes un emblema con "Siempre que una tierra entre al campo de batalla bajo tu control, puedes robar una carta".\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420376&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da55f3f3-fc7e-46ab-9fae-06b40dbac2d6\', \'multiverseId\': 420376}, \'multiverseid\': 420376}, {\'name\': \'Nissa, force vitale\', \'text\': "+1 : Dégagez un terrain ciblé que vous contrôlez. Jusqu\'à votre prochain tour, il devient une créature 5/5 Élémental avec la célérité. C\'est toujours un terrain.\\n-3 : Renvoyez une carte de permanent ciblée depuis votre cimetière dans votre main.\\n-6 : Vous gagnez un emblème avec « À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, vous pouvez piocher une carte. »", \'type\': \'Planeswalker : Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418792&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6c57f5c-e1f0-4fc9-a6b2-6351f614ea6f\', \'multiverseId\': 418792}, \'multiverseid\': 418792}, {\'name\': \'Nissa, Forza Vitale\', \'text\': \'+1: STAPpa una terra bersaglio che controlli. Fino al tuo prossimo turno, diventa una creatura Elementale 5/5 con rapidità. È ancora una terra.\\n-3: Riprendi in mano una carta permanente bersaglio dal tuo cimitero.\\n-6: Ottieni un emblema con "Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, puoi pescare una carta".\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419056&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a2543825-4b92-4107-8cf6-68cb4433a0cf\', \'multiverseId\': 419056}, \'multiverseid\': 419056}, {\'name\': \'生命の力、ニッサ\', \'text\': \'+1：あなたがコントロールする土地１つを対象とし、それをアンタップする。あなたの次のターンまで、それは速攻を持つ５/５のエレメンタル・クリーチャーになる。それは土地でもある。\\n-3：あなたの墓地からパーマネント・カード１枚を対象とし、それをあなたの手札に戻す。\\n-6：あなたは「土地が１つあなたのコントロール下で戦場に出るたび、あなたはカードを１枚引いてもよい。」を持つ紋章を得る。\', \'type\': \'プレインズウォーカー — ニッサ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419320&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'832e683a-6abf-4c6f-8462-b798de3628e1\', \'multiverseId\': 419320}, \'multiverseid\': 419320}, {\'name\': \'생명력의 원천 니사\', \'text\': \'+1: 당신이 조종하는 대지를 목표로 정한다. 그 대지를 언탭한다. 당신의 다음 턴까지, 그 대지는 신속을 가진 5/5 정령 생물이 된다. 그 대지는 생물이 된 후에도 여전히 대지다.\\n−3: 당신의 무덤에 있는 지속물 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\\n−6: 당신은 "대지가 당신의 조종하에 전장에 들어올 때마다, 당신은 카드를 뽑을 수 있다."를 가진 휘장을 얻는다.\', \'type\': \'플레인즈워커 — 니사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419584&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ea61fc67-e290-4afb-8fc9-9d2568ab9ac8\', \'multiverseId\': 419584}, \'multiverseid\': 419584}, {\'name\': \'Nissa, Força Vital\', \'text\': \'+1: Desvire o terreno alvo que você controla. Até seu próximo turno, ele se torna uma criatura 5/5 do tipo Elemental com ímpeto. Ela ainda é um terreno.\\n−3: Devolva o card de permanente alvo de seu cemitério para sua mão.\\n−6: Você recebe um emblema com "Toda vez que um terreno entra no campo de batalha sob seu controle, você pode comprar um card".\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419848&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c940cdb7-b838-4e1f-8617-a74a5419fae3\', \'multiverseId\': 419848}, \'multiverseid\': 419848}, {\'name\': \'Нисса, Жизненная Сила\', \'text\': \'+1: разверните целевую землю под вашим контролем. До вашего следующего хода она становится существом 5/5 Элементаль с Ускорением. При этом она остается землей.\\n−3: верните целевую карту перманента из вашего кладбища в вашу руку.\\n−6: вы получаете эмблему со способностью «Каждый раз, когда земля выходит на поле битвы под вашим контролем, вы можете взять карту».\', \'type\': \'Planeswalker — Нисса\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420112&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57043200-79a0-446d-8dc6-67c60b494834\', \'multiverseId\': 420112}, \'multiverseid\': 420112}, {\'name\': \'生机妮莎\', \'text\': \'+1：重置目标由你操控的地。直到你的下一个回合，它成为5/5，具敏捷异能的元素生物。它仍然是地。\\n−3：将目标永久物牌从你的坟墓场移回你手上。\\n−6：你获得具有「每当一个地在你的操控下进战场时，你可以抓一张牌」的徽记。\', \'type\': \'鹏洛客～妮莎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'488ef1bf-18aa-4e59-86c8-6e3e6c782bd5\', \'multiverseId\': 418000}, \'multiverseid\': 418000}, {\'name\': \'生機妮莎\', \'text\': \'+1：重置目標由你操控的地。直到你的下一個回合，它成為5/5，具敏捷異能的元素生物。它仍然是地。\\n−3：將目標永久物牌從你的墳墓場移回你手上。\\n−6：你獲得具有「每當一個地在你的操控下進戰場時，你可以抽一張牌」的徽記。\', \'type\': \'鵬洛客～妮莎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418264&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'beb90a74-c7fd-4d01-8cc3-056bb0b7de4e\', \'multiverseId\': 418264}, \'multiverseid\': 418264}]', '[{\'name\': \'Nissa, Schöpferin der Natur\', \'text\': \'+3: Du erhältst 3 Lebenspunkte dazu.\\n−4: Decke die obersten zwei Karten deiner Bibliothek auf. Bringe davon alle Länderkarten ins Spiel und nimm den Rest auf deine Hand.\\n−12: Kreaturen, die du kontrollierst, erhalten +5/+5 und verursachen Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420513&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f8baeb4-b3ef-4f8c-867b-fa5da52346b9\', \'multiverseId\': 420513}, \'multiverseid\': 420513}, {\'name\': \'Nissa, artesana de la naturaleza\', \'text\': \'+3: Ganas 3 vidas.\\n−4: Muestra las dos primeras cartas de tu biblioteca. Pon en el campo de batalla todas las cartas de tierra entre ellas y el resto en tu mano.\\n-12: Las criaturas que controlas obtienen +5/+5 y ganan la habilidad de arrollar hasta el final del turno.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420583&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1f65923-f4a1-470e-ad5a-f828b5f102bb\', \'multiverseId\': 420583}, \'multiverseid\': 420583}, {\'name\': \'Nissa, artisane de la nature\', \'text\': "+3 : Vous gagnez 3 points de vie.\\n-4 : Révélez les deux cartes du dessus de votre bibliothèque. Mettez toutes les cartes de terrain parmi elles sur le champ de bataille, et le reste dans votre main.\\n-12 : Les créatures que vous contrôlez gagnent +5/+5 et acquièrent le piétinement jusqu\'à la fin du tour.", \'type\': \'Planeswalker : Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420523&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ab3c076c-921c-4951-b26c-6a1ee3b5c4f2\', \'multiverseId\': 420523}, \'multiverseid\': 420523}, {\'name\': \'Nissa, Artigiana della Natura\', \'text\': \'+3: Guadagni 3 punti vita.\\n-4: Rivela le prime due carte del tuo grimorio. Metti sul campo di battaglia tutte le carte terra tra di esse e aggiungi le altre alla tua mano.\\n-12: Le creature che controlli prendono +5/+5 e hanno travolgere fino alla fine del turno.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420533&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b846024a-7d18-4af1-9554-a19bb807525b\', \'multiverseId\': 420533}, \'multiverseid\': 420533}, {\'name\': \'自然の職工、ニッサ\', \'text\': \'+3：あなたは３点のライフを得る。\\n-4：あなたのライブラリーの一番上から２枚のカードを公開する。その中から土地・カードをすべて戦場に出し、残りをあなたの手札に加える。\\n-12：ターン終了時まで、あなたがコントロールするクリーチャーは＋５/＋５の修整を受けるとともにトランプルを得る。\', \'type\': \'プレインズウォーカー — ニッサ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420543&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7bddeac5-b62a-4b3b-9eb7-298436cfda28\', \'multiverseId\': 420543}, \'multiverseid\': 420543}, {\'name\': \'자연의 장인 니사\', \'text\': \'+3: 당신은 생명 3점을 얻는다.\\n-4: 당신의 서고 맨 위의 카드 두 장을 공개한다. 그 중 대지 카드를 모두 전장에 놓고 나머지는 당신의 손으로 가져간다.\\n-12: 당신이 조종하는 생물들은 턴종료까지 +5/+5를 받고 돌진을 얻는다.\', \'type\': \'플레인즈워커 — 니사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420553&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0dbdfe7f-cbdc-4192-9043-e8800898b39d\', \'multiverseId\': 420553}, \'multiverseid\': 420553}, {\'name\': \'Nissa, Artesã da Natureza\', \'text\': \'+3: Você ganha 3 pontos de vida.\\n−4: Revele os dois cards do topo de seu grimório. Coloque todos os cards de terreno dentre eles no campo de batalha e o restante em sua mão.\\n−12: As criaturas que você controla recebem +5/+5 e ganham atropelar até o final do turno.\', \'type\': \'Planeswalker — Nissa\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420563&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ada6c9b5-e763-4a3c-9297-d1c3b96be3ea\', \'multiverseId\': 420563}, \'multiverseid\': 420563}, {\'name\': \'Нисса, Мастер Природы\', \'text\': \'+3: вы получаете 3 жизни.\\n—4: покажите две верхние карты вашей библиотеки. Положите все находящиеся среди них карты земель на поле битвы, а остальные — в вашу руку.\\n—12: существа под вашим контролем получают +5/+5 и Пробивной удар до конца хода.\', \'type\': \'Planeswalker — Нисса\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420573&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e75a3ac-490c-4fd1-94f4-26789a438fd2\', \'multiverseId\': 420573}, \'multiverseid\': 420573}, {\'name\': \'自然巧匠妮莎\', \'text\': \'+3：你获得3点生命。\\n−4：展示你牌库顶的两张牌。将其中所有地牌放进战场，其余则置于你手上。\\n−12：直到回合结束，由你操控的生物得+5/+5且获得践踏异能。\', \'type\': \'鹏洛客～妮莎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420493&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a16d4266-16b5-48cd-9510-7707fe89ee46\', \'multiverseId\': 420493}, \'multiverseid\': 420493}, {\'name\': \'自然巧匠妮莎\', \'text\': \'+3：你獲得3點生命。\\n−4：展示你牌庫頂的兩張牌。將其中所有地牌放進戰場，其餘則置於你手上。\\n-12：直到回合結束，由你操控的生物得+5/+5且獲得踐踏異能。\', \'type\': \'鵬洛客～妮莎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420503&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'57646cac-bfdb-49f6-a497-14a1a234479d\', \'multiverseId\': 420503}, \'multiverseid\': 420503}]', '[{\'name\': \'Obsolet machen\', \'text\': \'Kreaturen, die deine Gegner kontrollieren, erhalten -1/-1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Wunder von gestern sind die Antiquitäten von heute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418454&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7cb0917-85e5-49d1-8c93-f18c7a98b82a\', \'multiverseId\': 418454}, \'multiverseid\': 418454}, {\'name\': \'Hacer obsoleto\', \'text\': \'Las criaturas que controlan tus oponentes obtienen -1/-1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Las maravillas de ayer son las antigüedades de hoy.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420302&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84bc7f35-b228-4d9a-a002-026f30b610d5\', \'multiverseId\': 420302}, \'multiverseid\': 420302}, {\'name\': \'Obsolescence\', \'text\': "Les créatures que vos adversaires contrôlent gagnent -1/-1 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Les merveilles d\'hier font les antiquités d\'aujourd\'hui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418718&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca65e1a4-90b4-4bab-9059-0d4d0c489293\', \'multiverseId\': 418718}, \'multiverseid\': 418718}, {\'name\': \'Rendere Obsoleto\', \'text\': \'Le creature controllate dai tuoi avversari prendono -1/-1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': "Le meraviglie di ieri sono l\'antiquariato di oggi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9c7ae81e-e9aa-41a3-8b0e-0baef557a6d4\', \'multiverseId\': 418982}, \'multiverseid\': 418982}, {\'name\': \'陳腐化\', \'text\': \'ターン終了時まで、対戦相手がコントロールするクリーチャーは－１/－１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'昨日のびっくりは今日のがっかり。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419246&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f95ef6e1-ea3d-45e0-8950-c496d85ac071\', \'multiverseId\': 419246}, \'multiverseid\': 419246}, {\'name\': \'폐기 처분\', \'text\': \'상대가 조종하는 생물들은 턴종료까지 -1/-1을 받는다.\', \'type\': \'순간마법\', \'flavor\': \'과거에는 놀라웠던 물건이 오늘날에는 골동품에 불과하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419510&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6801997f-29fa-45d1-95f9-7e4a0b9d946c\', \'multiverseId\': 419510}, \'multiverseid\': 419510}, {\'name\': \'Tornar Obsoleto\', \'text\': \'As criaturas controladas por seus oponentes recebem -1/-1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'As maravilhas de ontem são as antiguidades de hoje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'889b1e43-53b8-48be-8ef8-5a46fb0bc5e6\', \'multiverseId\': 419774}, \'multiverseid\': 419774}, {\'name\': \'Плановое Устаревание\', \'text\': \'Существа под контролем ваших оппонентов получают -1/-1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Вчерашние чудеса — сегодняшние древности.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420038&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b35b874c-202a-47a5-b0db-e5d61d2fb39f\', \'multiverseId\': 420038}, \'multiverseid\': 420038}, {\'name\': \'将其淘汰\', \'text\': \'由对手操控的生物得-1/-1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'昨日之奇物为今日之古董。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417926&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8ac8153a-1d1b-49f5-8f06-8eb56a411e28\', \'multiverseId\': 417926}, \'multiverseid\': 417926}, {\'name\': \'將其淘汰\', \'text\': \'由對手操控的生物得-1/-1直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'昨日之奇物為今日之古董。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418190&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'318e9763-04f6-4eb6-8909-0ddadf26141d\', \'multiverseId\': 418190}, \'multiverseid\': 418190}]', '[{\'name\': \'Ornamentkäfer-Kolonie\', \'text\': \'Die Ornamentkäfer-Kolonie kann nicht blocken.\\nLege zu Beginn deines Versorgungssegments eine +1/+1-Marke auf die Ornamentkäfer-Kolonie und du verlierst 1 Lebenspunkt.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Der Schwarm hinterlässt ein makelloses Muster, das nur selten die strukturelle Integrität des Holzes bedroht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418448&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7871d05e-5db0-4dff-9dc2-6babca3b5892\', \'multiverseId\': 418448}, \'multiverseid\': 418448}, {\'name\': \'Colonia de ornamentadores\', \'text\': \'La Colonia de ornamentadores no puede bloquear.\\nAl comienzo de tu mantenimiento, pon un contador +1/+1 sobre la Colonia de ornamentadores y pierde 1 vida.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'El enjambre conforma una hermosa decoración que pocas veces amenaza la integridad estructural de la madera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420296&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e61efe8-7a32-42cc-8a50-7476dc49b8ba\', \'multiverseId\': 420296}, \'multiverseid\': 420296}, {\'name\': \'Colonie de frettes\', \'text\': \'La Colonie de frettes ne peut pas bloquer.\\nAu début de votre entretien, mettez un marqueur +1/+1 sur la Colonie de frettes et vous perdez 1 point de vie.\', \'type\': \'Créature : insecte\', \'flavor\': "L\'essaim laisse derrière lui un motif sans défaut, qui ne menace que rarement l\'intégrité structurelle du bois.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418712&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d416abd1-abdc-4184-a3a5-2b98d564d55e\', \'multiverseId\': 418712}, \'multiverseid\': 418712}, {\'name\': \'Colonia di Intagliatori\', \'text\': "La Colonia di Intagliatori non può bloccare.\\nAll\'inizio del tuo mantenimento, metti un segnalino +1/+1 sulla Colonia di Intagliatori e perdi 1 punto vita.", \'type\': \'Creatura — Insetto\', \'flavor\': "Lo sciame si lascia alle spalle un disegno perfetto che solo a volte compromette l\'integrità strutturale del legno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418976&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'159c5d08-207e-48bd-845e-74c05648241a\', \'multiverseId\': 418976}, \'multiverseid\': 418976}, {\'name\': \'透彫虫の群棲\', \'text\': \'透彫虫の群棲ではブロックできない。\\nあなたのアップキープの開始時に、透彫虫の群棲の上に＋１/＋１カウンターを１個置き、あなたは１点のライフを失う。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'巣が移った後には完璧な透かし模様が残る。それが木材の構造強度に影響を与えていることは滅多にない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419240&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'046161ff-938c-4b6d-bb70-12811ea12f63\', \'multiverseId\': 419240}, \'multiverseid\': 419240}, {\'name\': \'조각벌레 군락\', \'text\': \'조각벌레 군락은 방어할 수 없다.\\n당신의 유지단 시작에, 조각벌레 군락에 +1/+1 카운터 한 개를 올려놓고 당신은 생명 1점을 잃는다.\', \'type\': \'생물 — 곤충\', \'flavor\': \'이 벌레 무리는 종종 나무의 구조적 무결성을 파괴하는 완벽한 패턴을 남긴다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419504&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'36f2b9f0-0580-48c3-9eb5-0e17aa483098\', \'multiverseId\': 419504}, \'multiverseid\': 419504}, {\'name\': \'Colônia de Ornamentistas\', \'text\': \'Colônia de Ornamentistas não pode bloquear.\\nNo início de sua manutenção, coloque um marcador +1/+1 em Colônia de Ornamentistas e perca 1 ponto de vida.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'O enxame desenha um arabesco impecável que só ameaça a integridade estrutural da madeira ocasionalmente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419768&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99a83c01-92c9-4d38-b056-ea722b152a95\', \'multiverseId\': 419768}, \'multiverseid\': 419768}, {\'name\': \'Колония Точильщиков\', \'text\': \'Колония Точильщиков не может блокировать.\\nВ начале вашего шага поддержки положите один жетон +1/+1 на Колонию Точильщиков, и вы теряете 1 жизнь.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'Рой оставляет после себя безупречный рисунок, который лишь иногда угрожает структурной целостности дерева.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420032&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c406baf1-6c34-458f-b084-880234a7cc24\', \'multiverseId\': 420032}, \'multiverseid\': 420032}, {\'name\': \'浮雕虫群\', \'text\': \'浮雕虫群不能进行阻挡。\\n在你的维持开始时，在浮雕虫群上放置一个+1/+1指示物且你失去1点生命。\', \'type\': \'生物～昆虫\', \'flavor\': \'虫群留下的完美花纹偶尔才会对木头的结构完整性造成威胁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417920&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0f7536f-f3f1-427f-b8ae-b9733bbee4aa\', \'multiverseId\': 417920}, \'multiverseid\': 417920}, {\'name\': \'浮雕蟲群\', \'text\': \'浮雕蟲群不能進行阻擋。\\n在你的維持開始時，在浮雕蟲群上放置一個+1/+1指示物且你失去1點生命。\', \'type\': \'生物～昆蟲\', \'flavor\': \'蟲群留下的完美花紋偶爾才會對木頭的結構完整性造成威脅。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418184&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e3411298-4d4a-46af-b282-f195ca421ee5\', \'multiverseId\': 418184}, \'multiverseid\': 418184}]', '[{\'name\': \'Ovalhatz-Dragster\', \'text\': \'Verursacht Trampelschaden, Eile\\nBemannen 1 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 1 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': \'Entweder wird er zu Schrott gefahren, oder er gewinnt das Rennen. Wahrscheinlich beides.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418590&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'730f835c-5eb7-4838-80cf-f5dde3f13868\', \'multiverseId\': 418590}, \'multiverseid\': 418590}, {\'name\': \'Auto trucado de circuito ovalado\', \'text\': \'Arrolla, prisa.\\nTripular 1. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 1 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto — Vehículo\', \'flavor\': \'O se estrella, o gana la carrera. Puede que ambas cosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420438&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c31cdb4e-48d4-4648-90be-33c65d3e6007\', \'multiverseId\': 420438}, \'multiverseid\': 420438}, {\'name\': \'Dragster de la Course ovale\', \'text\': "Piétinement, célérité\\nPilotage 1 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 1 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact : véhicule\', \'flavor\': \'Il aura un accident ou gagnera la course. Probablement les deux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418854&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'028fcee5-80d7-4308-bb30-970cffed1cb0\', \'multiverseId\': 418854}, \'multiverseid\': 418854}, {\'name\': \'Bolide del Circuito Ovale\', \'text\': \'Travolgere, rapidità\\nManovrare 1 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 1: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)\', \'type\': \'Artefatto — Veicolo\', \'flavor\': \'O si schianta o vince la gara... o forse entrambe le cose.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419118&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af51b368-8c9a-47ad-982d-41d11563c7aa\', \'multiverseId\': 419118}, \'multiverseid\': 419118}, {\'name\': \'楕円競走車\', \'text\': \'トランプル、速攻\\n搭乗１（あなたがコントロールする望む数のクリーチャーを、パワーの合計が１以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'アーティファクト — 機体\', \'flavor\': \'レースでは、事故を起こすか優勝するか。ひょっとすると両方かもしれない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419382&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a743bb1-f8fb-4d28-987b-347e3f0e71cd\', \'multiverseId\': 419382}, \'multiverseid\': 419382}, {\'name\': \'타원경주로 경주자동차\', \'text\': \'돌진, 신속\\n탑승 1 (당신이 조종하는 생물을 공격력 총합이 1 이상이 되도록 원하는 수만큼 탭한다: 이 탑승물은 턴종료까지 마법물체 생물이 된다.)\', \'type\': \'마법물체 — 탑승물\', \'flavor\': \'경주에서 부서지거나 승리할 것이다. 물론 둘 다일 수도 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419646&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ad37225a-fa5c-475c-a194-99736fe2d63c\', \'multiverseId\': 419646}, \'multiverseid\': 419646}, {\'name\': \'Dragster da Pista Oval\', \'text\': \'Atropelar, ímpeto\\nTripular 1 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 1: Este Veículo se torna uma criatura artefato até o final do turno.)\', \'type\': \'Artefato — Veículo\', \'flavor\': \'Ele vai bater ou vencer. Talvez ambos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419910&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e4b03d5-cfd7-4921-adf5-40ac93dc492e\', \'multiverseId\': 419910}, \'multiverseid\': 419910}, {\'name\': \'Болид Овального Трека\', \'text\': \'Пробивной удар, Ускорение\\nЭкипаж 1 (Поверните любое количество существ под вашим контролем с суммарной силой 1 или более: эта Машина становится артефактом существом до конца хода.)\', \'type\': \'Артефакт — Машина\', \'flavor\': \'Он либо разобьется, либо выиграет гонку. А возможно, и то и другое.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420174&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6b80030d-ee7a-429d-8943-5621c705ea9e\', \'multiverseId\': 420174}, \'multiverseid\': 420174}, {\'name\': \'逐榄道赛车\', \'text\': \'践踏，敏捷\\n搭载1（横置任意数量由你操控且力量总和等于或大于1的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'神器～载具\', \'flavor\': \'不出事故就能夺魁。也有可能两者同时发生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9897a8e7-56d2-4c66-8628-2467e36b9bac\', \'multiverseId\': 418062}, \'multiverseid\': 418062}, {\'name\': \'逐欖道賽車\', \'text\': \'踐踏，敏捷\\n搭載1（橫置任意數量由你操控且力量總和等於或大於1的生物：此載具成為神器生物直到回合結束。）\', \'type\': \'神器～載具\', \'flavor\': \'不出事故就能奪魁。也有可能兩者同時發生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418326&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8b91fae7-ee0f-4dd4-a647-cf149efaf9ee\', \'multiverseId\': 418326}, \'multiverseid\': 418326}]', '[{\'name\': \'Ovalhatz-Draufgängerin\', \'text\': \'Immer wenn ein Artefakt unter deiner Kontrolle ins Spiel kommt, kannst du die Ovalhatz-Draufgängerin aus deinem Friedhof auf deine Hand zurückbringen.\', \'type\': \'Kreatur — Mensch, Pilot\', \'flavor\': \'„Lass mich raten. Du dachtest, ich wäre tot."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418462&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'585689c8-26c9-4a70-9f0e-3400503ce677\', \'multiverseId\': 418462}, \'multiverseid\': 418462}, {\'name\': \'Temeraria de circuito ovalado\', \'text\': \'Siempre que un artefacto entre al campo de batalla bajo tu control, puedes regresar a la Temeraria de circuito ovalado de tu cementerio a tu mano.\', \'type\': \'Criatura — Piloto humano\', \'flavor\': \'"A ver si lo adivino. Creías que estaba muerta".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420310&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'05b6cf68-46ce-43c2-8a6e-8f1e12c58f5e\', \'multiverseId\': 420310}, \'multiverseid\': 420310}, {\'name\': \'Casse-cou de la Course ovale\', \'text\': "À chaque fois qu\'un artefact arrive sur le champ de bataille sous votre contrôle, vous pouvez renvoyer la Casse-cou de la Course ovale depuis votre cimetière dans votre main.", \'type\': \'Créature : humain et pilote\', \'flavor\': "« Laissez-moi deviner. Vous pensiez que j\'étais morte. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418726&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b35dd5a-a8f3-476f-baf6-94e707c0e97d\', \'multiverseId\': 418726}, \'multiverseid\': 418726}, {\'name\': \'Temeraria del Circuito Ovale\', \'text\': \'Ogniqualvolta un artefatto entra nel campo di battaglia sotto il tuo controllo, puoi riprendere in mano dal tuo cimitero la Temeraria del Circuito Ovale.\', \'type\': \'Creatura — Pilota Umano\', \'flavor\': \'"Lasciami indovinare. Pensavi che fossi morta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418990&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'78ae818e-f712-4063-b2d2-9d9806c0601d\', \'multiverseId\': 418990}, \'multiverseid\': 418990}, {\'name\': \'楕円競走の無謀者\', \'text\': \'アーティファクトが１つあなたのコントロール下で戦場に出るたび、あなたはあなたの墓地から楕円競走の無謀者を自分の手札に戻してもよい。\', \'type\': \'クリーチャー — 人間・操縦士\', \'flavor\': \'「当ててみようか。アタシが死んだと思ったんでしょ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419254&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7dc9867f-e4d5-48ba-a63f-038b37d5c8e8\', \'multiverseId\': 419254}, \'multiverseid\': 419254}, {\'name\': \'무모한 타원경주로 레이서\', \'text\': \'마법물체가 당신의 조종하에 전장에 들어올 때마다, 당신은 당신의 무덤에서 무모한 타원경주로 레이서를 당신의 손으로 되돌릴 수 있다.\', \'type\': \'생물 — 인간 조종사\', \'flavor\': \'"예상하건대, 당신은 내가 죽었다고 생각했겠지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419518&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'570466d0-7792-4452-ae93-dd0598043da6\', \'multiverseId\': 419518}, \'multiverseid\': 419518}, {\'name\': \'Destemida da Pista Oval\', \'text\': \'Toda vez que um artefato entra no campo de batalha sob seu controle, você pode devolver Destemida da Pista Oval de seu cemitério para sua mão.\', \'type\': \'Criatura — Humano Piloto\', \'flavor\': \'"Deixa eu adivinhar. Você achou que eu tinha morrido."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419782&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37ed89ee-409b-428b-b50a-e504fd22d2dd\', \'multiverseId\': 419782}, \'multiverseid\': 419782}, {\'name\': \'Сорвиголова Овального Трека\', \'text\': \'Каждый раз, когда артефакт выходит на поле битвы под вашим контролем, вы можете вернуть Сорвиголову Овального Трека из вашего кладбища в вашу руку.\', \'type\': \'Существо — Человек Пилот\', \'flavor\': \'«Дай догадаюсь. Ты думал, что я разбилась».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420046&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'de6a9d47-0e8d-48c3-8dd0-3074c4260364\', \'multiverseId\': 420046}, \'multiverseid\': 420046}, {\'name\': \'逐榄道铁胆车手\', \'text\': \'每当一个神器在你的操控下进战场时，你可以将逐榄道铁胆车手从你的坟墓场移回你手上。\', \'type\': \'生物～人类／驾手\', \'flavor\': \'「我猜猜。你以为我死了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417934&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d922f3de-7f35-4eb2-9489-50ec11fd14d4\', \'multiverseId\': 417934}, \'multiverseid\': 417934}, {\'name\': \'逐欖道鐵膽車手\', \'text\': \'每當一個神器在你的操控下進戰場時，你可以將逐欖道鐵膽車手從你的墳墓場移回你手上。\', \'type\': \'生物～人類／駕手\', \'flavor\': \'「我猜猜。你以為我死了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418198&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'31eafde8-b1a2-4c99-bdd7-043655bfccd1\', \'multiverseId\': 418198}, \'multiverseid\': 418198}]', '[{\'name\': \'Oviya Pashiri, weise Biotronikerin\', \'text\': \'{2}{G}, {T}: Erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.\\n{4}{G}, {T}: Erzeuge einen X/X farblosen Konstrukt-Artefaktkreaturenspielstein, wobei X gleich der Anzahl an Kreaturen ist, die du kontrollierst.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': \'„Inspiration ist wechselseitig: Wir sind uns gegenseitig verpflichtet, zu erschaffen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418530&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5de13c66-c673-4e95-a771-2cee62e2d8d9\', \'multiverseId\': 418530}, \'multiverseid\': 418530}, {\'name\': \'Oviya Pashiri, fraguavidas sabia\', \'text\': \'{2}{G}, {T}: Crea una ficha de criatura artefacto Servo incolora 1/1.\\n{4}{G}, {T}: Crea una ficha de criatura artefacto Constructo incolora X/X, donde X es la cantidad de criaturas que controlas.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': \'"La inspiración es recíproca: todos tenemos la responsabilidad de crear para los otros".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420378&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'39946970-4b64-4799-9173-5d00f23fa167\', \'multiverseId\': 420378}, \'multiverseid\': 420378}, {\'name\': \'Oviya Pashiri, sage façonneuse de vie\', \'text\': \'{2}{G}, {T} : Créez un jeton de créature-artefact 1/1 incolore Servo.\\n{4}{G}, {T} : Créez un jeton de créature-artefact X/X incolore Construction, X étant le nombre de créatures que vous contrôlez.\', \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': "« L\'inspiration est réciproque : chacun de nous a une responsabilité créative envers l\'autre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418794&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ef42456-f4a6-45ae-8e2d-0d24a07e710f\', \'multiverseId\': 418794}, \'multiverseid\': 418794}, {\'name\': \'Oviya Pashiri, Saggia Forgiavita\', \'text\': \'{2}{G}, {T}: Crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.\\n{4}{G}, {T}: Crea una pedina creatura artefatto Costrutto X/X incolore, dove X è il numero di creature che controlli.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': \'"L\\\'ispirazione è reciproca: ognuno è chiamato a creare per il prossimo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419058&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'602aac6f-8834-410a-abc1-865a57702047\', \'multiverseId\': 419058}, \'multiverseid\': 419058}, {\'name\': \'造命の賢者、オビア・パースリー\', \'text\': \'{2}{G}, {T}：無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。\\n{4}{G}, {T}：無色のＸ/Ｘの構築物・アーティファクト・クリーチャー・トークンを１体生成する。Ｘはあなたがコントロールするクリーチャーの総数に等しい。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': \'「創造性は持ちつ持たれつ。私たちは皆、他の人の創作にも責任があるの。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419322&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'803f2900-2301-44ad-93c7-7a84c103ab57\', \'multiverseId\': 419322}, \'multiverseid\': 419322}, {\'name\': \'현명한 생명체제작자 오비야 파시리\', \'text\': \'{2}{G}, {T}: 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.\\n{4}{G}, {T}: X/X 무색 자동기계 마법물체 생물 토큰 한 개를 만든다. X는 당신이 조종하는 생물의 수이다.\', \'type\': \'전설적 생물 — 인간 기능공\', \'flavor\': \'"영감은 상호적 관계지. 우리 모두는 서로에 대해 창조할 책임이 있단다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419586&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e688ae73-d6a6-4b5b-a553-7cdc77f780bf\', \'multiverseId\': 419586}, \'multiverseid\': 419586}, {\'name\': \'Oviya Pashiri, Sábia Vivideira\', \'text\': \'{2}{G}, {T}: Crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.\\n{4}{G}, {T}: Crie uma ficha de criatura artefato incolor X/X do tipo Construto, sendo X o número de criaturas que você controla.\', \'type\': \'Criatura Lendária — Humano Artesão\', \'flavor\': \'"A inspiração é recíproca: cada um de nós tem uma responsabilidade criativa para com os outros."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419850&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ba4eb02-528b-4fa7-8393-a27e47724a0b\', \'multiverseId\': 419850}, \'multiverseid\': 419850}, {\'name\': \'Мудрая Овия Пашири, Жизнетворец\', \'text\': \'{2}{G}, {T}: создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.\\n{4}{G}, {T}: создайте одну фишку артефакта существа X/X бесцветная Конструкция, где X — количество существ под вашим контролем.\', \'type\': \'Легендарное Существо — Человек Механик\', \'flavor\': \'«Все мы возвращаем полученное вдохновение: творить — наша обязанность друг перед другом».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420114&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'25b533c3-0f06-4d28-b18b-48f43b64aab9\', \'multiverseId\': 420114}, \'multiverseid\': 420114}, {\'name\': \'铸生智者奥薇亚帕西理\', \'text\': \'{2}{G}，{T}：派出一个1/1无色自动机衍生神器生物。\\n{4}{G}，{T}：派出一个X/X无色组构体衍生神器生物，X为由你操控的生物数量。\', \'type\': \'传奇生物～人类／神器师\', \'flavor\': \'「灵感妙思是互惠的：我们都有促进彼此创作的责任。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418002&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'401846e6-7379-4f5f-94f9-795dc3056ec8\', \'multiverseId\': 418002}, \'multiverseid\': 418002}, {\'name\': \'鑄生智者奧薇亞帕西理\', \'text\': \'{2}{G}，{T}：派出一個1/1無色自動機衍生神器生物。\\n{4}{G}，{T}：派出一個X/X無色組構體衍生神器生物，X為由你操控的生物數量。\', \'type\': \'傳奇生物～人類／神器師\', \'flavor\': \'「靈感妙思是互惠的：我們都有促進彼此創作的責任。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418266&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3400b945-0a9b-4b3c-a96b-c3e81a3edf03\', \'multiverseId\': 418266}, \'multiverseid\': 418266}]', '[{\'name\': \'Padeem, Konsulin der Innovation\', \'text\': \'Artefakte, die du kontrollierst, haben Fluchsicherheit.\\nZu Beginn deines Versorgungssegments und falls du das Artefakt mit den höchsten umgewandelten Manakosten kontrollierst oder diesbezüglich Gleichstand zwischen dir und einem anderen Spieler herrscht, ziehe eine Karte.\', \'type\': \'Legendäre Kreatur — Vedalken, Handwerker\', \'flavor\': \'„Beeindrucke mich."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418424&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9bf4a4b-23c8-4a73-bf46-8e5af37da59b\', \'multiverseId\': 418424}, \'multiverseid\': 418424}, {\'name\': \'Padeem, Cónsul de Innovación\', \'text\': \'Los artefactos que controlas tienen la habilidad de antimaleficio.\\nAl comienzo de tu mantenimiento, si controlas el artefacto con el coste de maná convertido más alto o empatado por el coste de maná convertido más alto, roba una carta.\', \'type\': \'Criatura legendaria — Artífice vedalken\', \'flavor\': \'"Impresióname".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d5dcb7d-d30b-43aa-a35c-3cad22d36e4f\', \'multiverseId\': 420272}, \'multiverseid\': 420272}, {\'name\': "Padeem, consul de l\'innovation", \'text\': "Les artefacts que vous contrôlez ont la défense talismanique.\\nAu début de votre entretien, si vous contrôlez l\'artefact ayant le coût converti de mana le plus élevé ou partageant le coût converti de mana le plus élevé, piochez une carte.", \'type\': \'Créature légendaire : vedalken et artificier\', \'flavor\': \'« Impressionnez-moi. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418688&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4fac654e-1d69-4196-b8ab-318551bfadf2\', \'multiverseId\': 418688}, \'multiverseid\': 418688}, {\'name\': "Padeem, Console dell\'Innovazione", \'text\': "Gli artefatti che controlli hanno anti-malocchio.\\nAll\'inizio del tuo mantenimento, se controlli l\'artefatto con il costo di mana convertito più alto o con costo di mana convertito più alto a pari merito con un altro artefatto, pesca una carta.", \'type\': \'Creatura Leggendaria — Artefice Vedalken\', \'flavor\': \'"Stupiscimi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418952&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9a675b1-72f5-4458-8439-d595a85d0d72\', \'multiverseId\': 418952}, \'multiverseid\': 418952}, {\'name\': \'発明の領事、パディーム\', \'text\': \'あなたがコントロールするアーティファクトは呪禁を持つ。\\nあなたのアップキープの開始時に、点数で見たマナ・コストが最も大きいか同じであるアーティファクトをあなたがコントロールしている場合、カードを１枚引く。\', \'type\': \'伝説のクリーチャー — ヴィダルケン・工匠\', \'flavor\': \'「私を驚かせなさい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419216&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10ab1079-8f6c-4ab0-8604-8f9463cdae13\', \'multiverseId\': 419216}, \'multiverseid\': 419216}, {\'name\': \'혁신의 영사 파딤\', \'text\': \'당신이 조종하는 마법물체들은 방호를 가진다.\\n당신의 유지단 시작에, 당신이 전환마나비용이 제일 높거나 공동으로 전환마나비용이 제일 높은 마법물체를 조종한다면, 카드 한 장을 뽑는다.\', \'type\': \'전설적 생물 — 베달켄 기능공\', \'flavor\': \'"날 감동시켜 보게."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419480&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2fa931e6-6d96-4159-874b-0168ad009d5b\', \'multiverseId\': 419480}, \'multiverseid\': 419480}, {\'name\': \'Padeem, Consulesa da Inovação\', \'text\': \'Os artefatos que você controla têm resistência a magia.\\nNo início de sua manutenção, se você controlar o artefato de maior custo de mana convertido (ou empatado no maior custo de mana convertido), compre um card.\', \'type\': \'Criatura Lendária — Vedalkeano Artesão\', \'flavor\': \'"Impressione-me."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419744&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51597060-b2af-44d8-9de5-454055553285\', \'multiverseId\': 419744}, \'multiverseid\': 419744}, {\'name\': \'Падима, Консул Инноваций\', \'text\': \'Артефакты под вашим контролем имеют Порчеустойчивость.\\nВ начале вашего шага поддержки, если вы контролируете артефакт с самой большой конвертированной мана-стоимостью или с одинаковым значением самой большой конвертированной мана-стоимости с другим артефактом, возьмите карту.\', \'type\': \'Легендарное Существо — Ведалкен Механик\', \'flavor\': \'«Удиви меня».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420008&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9a03b42d-52a3-4642-b2ae-ab023a1361a5\', \'multiverseId\': 420008}, \'multiverseid\': 420008}, {\'name\': \'求新执政珀蒂\', \'text\': \'由你操控的神器具有辟邪异能。\\n在你的维持开始时，若你操控总法术力费用最高或与他者同为最高的神器，抓一张牌。\', \'type\': \'传奇生物～维多肯／神器师\', \'flavor\': \'「让我大开眼界吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417896&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e5aeed5-1abc-49f4-84fc-25bd65298f98\', \'multiverseId\': 417896}, \'multiverseid\': 417896}, {\'name\': \'求新執政珀蒂\', \'text\': \'由你操控的神器具有辟邪異能。\\n在你的維持開始時，若你操控總魔法力費用最高或與他者同為最高的神器，抽一張牌。\', \'type\': \'傳奇生物～維多肯／神器師\', \'flavor\': \'「讓我大開眼界吧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418160&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dbcf6505-d820-437f-b944-f9c5ceda9111\', \'multiverseId\': 418160}, \'multiverseid\': 418160}]', '[{\'name\': \'Panharmonikon\', \'text\': \'Falls ein Artefakt oder eine Kreatur ins Spiel kommt und dadurch bei einer bleibenden Karte, die du kontrollierst, eine ausgelöste Fähigkeit auslöst, wird die Fähigkeit ein weiteres Mal ausgelöst.\', \'type\': \'Artefakt\', \'flavor\': \'Jeder, der zuhört, vernimmt sein eigenes Lied — eine einzigartige Melodie ganz für ihn alleine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418591&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0cdbabf-f968-4a05-a9df-f6d15dcbc58b\', \'multiverseId\': 418591}, \'multiverseid\': 418591}, {\'name\': \'Panharmónico\', \'text\': \'Si un artefacto o criatura que entra al campo de batalla hiciera que una habilidad disparada de un permanente que controlas se disparase, esa habilidad se dispara una vez más.\', \'type\': \'Artefacto\', \'flavor\': \'Todos los que lo escuchan oyen su propia canción, una melodía única que suena solo para ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420439&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9ed23a0-a540-4ad7-ad72-eaa7e6a5f957\', \'multiverseId\': 420439}, \'multiverseid\': 420439}, {\'name\': \'Panharmonicus\', \'text\': "Si l\'arrivée sur le champ de bataille d\'un artefact ou d\'une créature provoque le déclenchement d\'une capacité déclenchée d\'un permanent que vous contrôlez, cette capacité se déclenche une fois de plus.", \'type\': \'Artefact\', \'flavor\': "Tous ceux qui l\'écoutent entendent une musique différente, une mélodie unique jouée seulement pour eux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418855&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d04dad18-2cc7-4a76-8585-14d05d2e297d\', \'multiverseId\': 418855}, \'multiverseid\': 418855}, {\'name\': \'Panarmonico\', \'text\': "Se un artefatto o una creatura che entrano nel campo di battaglia fanno innescare l\'abilità innescata di un permanente che controlli, quell\'abilità si innesca una volta in più.", \'type\': \'Artefatto\', \'flavor\': \'Chiunque lo ascolti sente una canzone diversa, una melodia unica suonata solo per le sue orecchie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419119&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65d84e3f-9768-447a-9be1-281fee4748d0\', \'multiverseId\': 419119}, \'multiverseid\': 419119}, {\'name\': \'パンハモニコン\', \'text\': \'アーティファクト１つかクリーチャー１体が戦場に出たことによりあなたがコントロールするパーマネントの誘発型能力が誘発するなら、その能力は追加でもう１回誘発する。\', \'type\': \'アーティファクト\', \'flavor\': \'その音色に耳を傾ける者たちは、自分自身の歌を聴く。自分のためのみに奏でられた独特な旋律を。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419383&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f866610-b994-452c-9bbe-61a30d482d00\', \'multiverseId\': 419383}, \'multiverseid\': 419383}, {\'name\': \'팬하모니콘\', \'text\': \'마법물체 또는 생물이 전장에 들어와서 당신이 조종하는 지속물의 격발능력이 격발되려고 하면, 그 능력은 한 번 더 격발된다.\', \'type\': \'마법물체\', \'flavor\': \'듣는 자들은 모두 자신만을 위해 연주되는 특별한 멜로디의 노래를 듣는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419647&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'df16620f-bd4c-42a1-b221-a9e9df4145d3\', \'multiverseId\': 419647}, \'multiverseid\': 419647}, {\'name\': \'Panarmônico\', \'text\': \'Se um artefato ou uma criatura que entra no campo de batalha fizer com que uma habilidade desencadeada de uma permanente que você controla seja desencadeada, aquela habilidade será desencadeada uma vez adicional.\', \'type\': \'Artefato\', \'flavor\': \'Todos que ouvem escutam sua própria música, uma melodia única tocada só para eles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419911&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'86173cd0-5255-4dd3-99b6-a23e5975d99e\', \'multiverseId\': 419911}, \'multiverseid\': 419911}, {\'name\': \'Пангармоникон\', \'text\': \'Если выходящий на поле битвы артефакт или существо вызывает срабатывание срабатывающей способности перманента под вашим контролем, та способность срабатывает дополнительный раз.\', \'type\': \'Артефакт\', \'flavor\': \'Каждый, кто его слушает, слышит свою песню — уникальную мелодию, что играет только для него.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420175&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'220e469d-3572-4452-8b67-27b8d528de18\', \'multiverseId\': 420175}, \'multiverseid\': 420175}, {\'name\': \'万和琴\', \'text\': \'如果进战场的神器或生物触发由你操控之永久物的触发式异能，则该异能额外触发一次。\', \'type\': \'神器\', \'flavor\': \'听者各闻心中悦音，独特旋律为其特别奏响。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418063&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d87eaf2-0a4e-466b-8c42-df56333f5698\', \'multiverseId\': 418063}, \'multiverseid\': 418063}, {\'name\': \'萬和琴\', \'text\': \'如果進戰場的神器或生物觸發由你操控的永久物之觸發式異能，則該異能額外觸發一次。\', \'type\': \'神器\', \'flavor\': \'聽者心中各聞悅音，獨特旋律為其特別奏響。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418327&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'50019aaa-13e9-4053-aa8d-e9aa444e4a55\', \'multiverseId\': 418327}, \'multiverseid\': 418327}]', '[{\'name\': \'Paradoxes Ergebnis\', \'text\': \'Bringe eine beliebige Anzahl an bleibenden Karten deiner Wahl, die du kontrollierst und die weder Länder noch Spielsteine sind, auf die Hand ihrer Besitzer zurück. Ziehe eine Karte für jede auf diese Weise auf deine Hand zurückgebrachte Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Ergebnisse von Rashmis Experimenten zwangen sie, anzuerkennen, dass es viel mehr Realitäten gibt als nur die ihre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418425&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09235c4a-cc20-48de-8dd8-11a394827f02\', \'multiverseId\': 418425}, \'multiverseid\': 418425}, {\'name\': \'Resultado paradójico\', \'text\': \'Regresa cualquier cantidad de permanentes objetivo que no sean tierra ni ficha y que controlas a las manos de sus propietarios. Roba una carta por cada carta regresada a tu mano de esta manera.\', \'type\': \'Instantáneo\', \'flavor\': \'Los resultados de la experimentación de Rashmi la obligaron a considerar la posibilidad de la existencia de numerosas realidades más allá de la suya.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420273&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b55b19fa-e3af-44bf-8726-520b6092db02\', \'multiverseId\': 420273}, \'multiverseid\': 420273}, {\'name\': \'Résultat paradoxal\', \'text\': "Renvoyez n\'importe quel nombre de permanents non-jeton, non-terrain ciblés que vous contrôlez dans les mains de leurs propriétaires. Piochez une carte pour chaque carte renvoyée dans votre main de cette manière.", \'type\': \'Éphémère\', \'flavor\': "Les résultats de son expérience obligèrent Rashmi à considérer l\'existence d\'innombrables réalités au-delà de la sienne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418689&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12052e00-0423-4beb-ad53-b038d9b7b617\', \'multiverseId\': 418689}, \'multiverseid\': 418689}, {\'name\': \'Esito Paradossale\', \'text\': \'Fai tornare un qualsiasi numero di permanenti non terra, non pedina bersaglio che controlli in mano ai rispettivi proprietari. Pesca una carta per ogni carta che hai ripreso in mano in questo modo.\', \'type\': \'Istantaneo\', \'flavor\': "I risultati degli esperimenti di Rashmi la costrinsero a prendere in considerazione l\'esistenza di una moltitudine di realtà oltre alla sua.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418953&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bafec6f3-900e-49d0-8350-2c64be57d1f1\', \'multiverseId\': 418953}, \'multiverseid\': 418953}, {\'name\': \'逆説的な結果\', \'text\': \'望む数のあなたがコントロールする土地でもトークンでもないパーマネントを対象とし、それらをオーナーの手札に戻す。これによりあなたの手札に戻されたカード１枚につき、カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'ラシュミ自身の実験結果から、彼女は自分が属す現実だけでない多元的な現実の可能性を受け入れるしかなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419217&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cdff7bf2-f353-48da-8306-a14e83cb1e63\', \'multiverseId\': 419217}, \'multiverseid\': 419217}, {\'name\': \'역설적 결과\', \'text\': \'당신이 조종하는 대지가 아니고 토큰이 아닌 지속물을 원하는 수만큼 목표로 정한다. 그 목표들을 소유자의 손으로 되돌린다. 이렇게 당신의 손으로 되돌려진 카드마다 카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'그녀는 라시미의 실험 결과로 인해 자신의 현실 이외에 무수히 많은 현실이 존재할 가능성을 고려하게 되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419481&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8dd31c93-421d-4692-b3d2-eabe63a34139\', \'multiverseId\': 419481}, \'multiverseid\': 419481}, {\'name\': \'Resultado Paradoxal\', \'text\': \'Devolva qualquer número de permanentes alvo que você controla que não sejam terrenos nem fichas para as mãos de seus donos. Compre um card para cada card devolvido para sua mão desta forma.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os resultados das experiências de Rashmi a forçaram a considerar a possibilidade da existência de múltiplas realidades além da dela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419745&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'16d362f7-8ec3-4473-ad40-4a5d2b256632\', \'multiverseId\': 419745}, \'multiverseid\': 419745}, {\'name\': \'Парадоксальный Исход\', \'text\': \'Верните любое количество целевых не являющихся землями или фишками перманентов под вашим контролем в руки их владельцев. Возьмите одну карту за каждую карту, возвращенную в вашу руку таким образом.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Результаты проделанных Рашми экспериментов заставили ее задуматься о возможности существования множества миров помимо ее собственного.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420009&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f7e6553c-56cf-4dd0-935f-a021038188e6\', \'multiverseId\': 420009}, \'multiverseid\': 420009}, {\'name\': \'矛盾结果\', \'text\': \'将任意数量目标由你操控且既非地也非衍生物的永久物移回其拥有者手上。每以此法将一张牌移回你手上，便抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'由于实验结果，列施蜜禁不住思考：除了她所处的现实以外，是否还有许多现实存在。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417897&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'19c4cdad-df9c-428d-8806-5d7052b5c0f1\', \'multiverseId\': 417897}, \'multiverseid\': 417897}, {\'name\': \'矛盾結果\', \'text\': \'將任意數量目標由你操控且既非地也非衍生物的永久物移回其擁有者手上。每以此法將一張牌移回你手上，便抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'由於實驗結果，列施蜜禁不住思考：除了她所處的現實以外，是否還有許多現實存在。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418161&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'177cc0df-a67d-4887-919f-354a2ccbd2a2\', \'multiverseId\': 418161}, \'multiverseid\': 418161}]', '[{\'name\': \'Patrouille der neunten Brücke\', \'text\': \'Immer wenn eine andere Kreatur, die du kontrollierst, das Spiel verlässt, lege eine +1/+1-Marke auf die Patrouille der neunten Brücke.\', \'type\': \'Kreatur — Zwerg, Soldat\', \'flavor\': \'Das Konsulat führt auf allen elf Brücken Kontrollen durch, um sicherzustellen, dass der Markt ein Ort des Handels bleibt und nicht zu einem Ort der Betrügerei verkommt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418387&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'96def469-4fab-4d96-aee6-766cf4171bdf\', \'multiverseId\': 418387}, \'multiverseid\': 418387}, {\'name\': \'Patrullero del noveno puente\', \'text\': \'Siempre que otra criatura que controlas deje el campo de batalla, pon un contador +1/+1 sobre el Patrullero del noveno puente.\', \'type\': \'Criatura — Enano soldado\', \'flavor\': \'El Consulado vigila cada uno de los once puentes para garantizar que el mercado es un sitio seguro para comerciantes, no para estafadores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36e7d3e3-30bf-43ee-a062-0d061243de07\', \'multiverseId\': 420235}, \'multiverseid\': 420235}, {\'name\': \'Patrouille du neuvième pont\', \'text\': "À chaque fois qu\'une autre créature que vous contrôlez quitte le champ de bataille, mettez un marqueur +1/+1 sur la Patrouille du neuvième pont.", \'type\': \'Créature : nain et soldat\', \'flavor\': "Le Consulat surveille chacun des onze ponts pour s\'assurer que le marché reste un havre pour le commerce, pas pour les arnaques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33964904-678d-46f2-a2bb-9671afdd73fa\', \'multiverseId\': 418651}, \'multiverseid\': 418651}, {\'name\': \'Pattuglia del Nono Ponte\', \'text\': "Ogniqualvolta un\'altra creatura che controlli lascia il campo di battaglia, metti un segnalino +1/+1 sulla Pattuglia del Nono Ponte.", \'type\': \'Creatura — Soldato Nano\', \'flavor\': \'Il Consolato sorveglia tutti gli undici ponti per assicurarsi che il mercato resti un ritrovo di commercianti e non di truffatori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418915&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c41a398-6247-4eda-b107-daab1cc0fe53\', \'multiverseId\': 418915}, \'multiverseid\': 418915}, {\'name\': \'第九橋の巡回員\', \'text\': \'あなたがコントロールする他のクリーチャーが１体戦場を離れるたび、第九橋の巡回員の上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — ドワーフ・兵士\', \'flavor\': \'領事府は11基ある橋をそれぞれ監視している。商取引の場である市場に詐欺師を横行させないためである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419179&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6fcf106f-606b-414b-9ac3-3d17a6ea659e\', \'multiverseId\': 419179}, \'multiverseid\': 419179}, {\'name\': \'9번 대교 순찰병\', \'text\': \'당신이 조종하는 다른 생물이 전장을 떠날 때마다, 9번 대교 순찰병에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 드워프 병사\', \'flavor\': \'영사관은 시장을 사기꾼들의 회합 장소가 아닌 상업의 중심지로 만들기 위해 다리 열한개를 모두 감시한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419443&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b87da765-ced1-4d53-bbde-6f9c4a034ccd\', \'multiverseId\': 419443}, \'multiverseid\': 419443}, {\'name\': \'Patrulheiro da Nona Ponte\', \'text\': \'Toda vez que outra criatura que você controla deixar o campo de batalha, coloque um marcador +1/+1 em Patrulheiro da Nona Ponte.\', \'type\': \'Criatura — Anão Soldado\', \'flavor\': \'O Consulado vigia cada uma das onze pontes para garantir que o mercado continue a ser um porto seguro para o comércio, e não para os vigaristas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419707&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9dc09d6e-920d-4d40-b429-4b771b981d38\', \'multiverseId\': 419707}, \'multiverseid\': 419707}, {\'name\': \'Патрульный Девятого Моста\', \'text\': \'Каждый раз, когда другое существо под вашим контролем покидает поле битвы, положите один жетон +1/+1 на Патрульного Девятого Моста.\', \'type\': \'Существо — Гном Солдат\', \'flavor\': \'Консульство охраняет все одиннадцать мостов, чтобы рынок оставался вотчиной торговцев, а не мошенников.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419971&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dc13b7a5-10e8-4138-90e1-9b1f2547f531\', \'multiverseId\': 419971}, \'multiverseid\': 419971}, {\'name\': \'九桥巡卫\', \'text\': \'每当另一个由你操控的生物离开战场时，在九桥巡卫上放置一个+1/+1指示物。\', \'type\': \'生物～矮人／士兵\', \'flavor\': \'执政院严密监控十一座桥，确保市场的公平交易，防止奸商横行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417859&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9aca0930-a399-4801-baf0-ad482deacb99\', \'multiverseId\': 417859}, \'multiverseid\': 417859}, {\'name\': \'九橋巡衛\', \'text\': \'每當另一個由你操控的生物離開戰場時，在九橋巡衛上放置一個+1/+1指示物。\', \'type\': \'生物～矮人／士兵\', \'flavor\': \'執政院嚴密監控十一座橋，確保市場的公平交易，防止奸商橫行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418123&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0c9b5b3f-b096-4d64-8971-62af3af5531e\', \'multiverseId\': 418123}, \'multiverseid\': 418123}]', "[{'name': 'Peema-Vorreiter', 'text': 'Verursacht Trampelschaden\\nFabrizieren 1 (Wenn diese Kreatur ins Spiel kommt, lege eine +1/+1-Marke auf sie oder erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.)', 'type': 'Kreatur — Elf, Handwerker', 'flavor': 'Verbunden als Handwerker und Erfindung, Verbündete als Reiter und Ross.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418531&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c5693d5e-5826-45fc-beaf-066b2455bfc0', 'multiverseId': 418531}, 'multiverseid': 418531}, {'name': 'Batidor de Peema', 'text': 'Arrolla.\\nFabricar 1. (Cuando esta criatura entre al campo de batalla, pon un contador +1/+1 sobre ella o crea una ficha de criatura artefacto Servo incolora 1/1.)', 'type': 'Criatura — Artífice elfo', 'flavor': 'Conectados como artífice e invento; unidos como jinete y montura.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420379&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '34a55576-3a1e-43f8-8dd6-bb29eebe14db', 'multiverseId': 420379}, 'multiverseid': 420379}, {'name': 'Cavalier de Peema', 'text': 'Piétinement\\nFabrication 1 (Quand cette créature arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle ou créez un jeton de créature-artefact 1/1 incolore Servo.)', 'type': 'Créature : elfe et artificier', 'flavor': 'Connecté comme un artificier à son invention, lié comme un cavalier à sa monture.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418795&type=card', 'language': 'French', 'identifiers': {'scryfallId': '13644951-dc16-4fac-8158-e508f25560e0', 'multiverseId': 418795}, 'multiverseid': 418795}, {'name': 'Battipista di Peema', 'text': 'Travolgere\\nFabbrica 1 (Quando questa creatura entra nel campo di battaglia, metti un segnalino +1/+1 su di essa o crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.)', 'type': 'Creatura — Artefice Elfo', 'flavor': 'Il legame di un artefice con la sua invenzione, la sintonia di un cavaliere con il suo destriero.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419059&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6237d823-1e1d-4b53-b23b-6c049f7d264a', 'multiverseId': 419059}, 'multiverseid': 419059}, {'name': 'ピーマの先導', 'text': 'トランプル\\n製造１（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを１個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。）', 'type': 'クリーチャー — エルフ・工匠', 'flavor': '工匠と発明品の繋がり。乗り手と馬の絆。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419323&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7b9cba61-8d7c-4bda-b3b1-267b6cbe8a89', 'multiverseId': 419323}, 'multiverseid': 419323}, {'name': '피마 척후병', 'text': '돌진\\n제작 1 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 한 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.)', 'type': '생물 — 엘프 기능공', 'flavor': '기능공과 발명품의 관계처럼 기수와 말은 한 몸과 같다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419587&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4065c8fb-a65a-454a-96f2-853f7348fe3e', 'multiverseId': 419587}, 'multiverseid': 419587}, {'name': 'Vanguardeiro de Peema', 'text': 'Atropelar\\nFabricar 1 (Quando esta criatura entrar no campo de batalha, coloque um marcador +1/+1 nela ou crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.)', 'type': 'Criatura — Elfo Artesão', 'flavor': 'Conectados como artesão e invenção, unidos como ginete e corcel.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419851&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ab472acb-b0a7-4372-ae76-9333a30d71e1', 'multiverseId': 419851}, 'multiverseid': 419851}, {'name': 'Пимский Наездник', 'text': 'Пробивной удар\\nПроизводство 1 (Когда это существо выходит на поле битвы, положите на него один жетон +1/+1 или создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.)', 'type': 'Существо — Эльф Механик', 'flavor': 'Связаны, как механик и изобретение; едины, как наездник и скакун.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420115&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e61b2c9b-64a9-4651-9e59-c24c209ed50a', 'multiverseId': 420115}, 'multiverseid': 420115}, {'name': '皮默前导兵', 'text': '践踏\\n装配1（当此生物进战场时，在其上放置一个+1/+1指示物或派出一个1/1无色自动机衍生神器生物。）', 'type': '生物～妖精／神器师', 'flavor': '如神器师与发明的连结，似骑手与骏马的羁绊。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418003&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '59b79dcd-f073-4de3-b301-4338b34c66f2', 'multiverseId': 418003}, 'multiverseid': 418003}, {'name': '皮默前導兵', 'text': '踐踏\\n裝配1（當此生物進戰場時，在其上放置一個+1/+1指示物或派出一個1/1無色自動機衍生神器生物。）', 'type': '生物～妖精／神器師', 'flavor': '如神器師與發明的連結，似騎手與駿馬的羈絆。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418267&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '34d95def-68f1-45b9-86b3-95f8842b76a9', 'multiverseId': 418267}, 'multiverseid': 418267}]", '[{\'name\': \'Perfektes Timing\', \'text\': \'Perfektes Timing fügt einer angreifenden oder blockenden Kreatur deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Als Baral seine Falle für Chandra konstruierte, berücksichtigte er nicht die Ankunft eines riesigen, Doppelaxt schwingenden Leoniden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418384&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6890821-b75c-4192-86d4-5c9d6ffbe663\', \'multiverseId\': 418384}, \'multiverseid\': 418384}, {\'name\': \'Llegada oportuna\', \'text\': \'La Llegada oportuna hace 3 puntos de daño a la criatura atacante o bloqueadora objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Cuando Baral construyó su trampa para Chandra, no previó la llegada de un leonino enorme con un hacha de dos cabezas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d02bbb43-62ce-4310-a911-6b83798551e2\', \'multiverseId\': 420232}, \'multiverseid\': 420232}, {\'name\': \'Moment opportun\', \'text\': \'Le Moment opportun inflige 3 blessures à la créature attaquante ou bloqueuse ciblée.\', \'type\': \'Éphémère\', \'flavor\': "Quand Baral tendit un piège à Chandra, ce fut sans compter sur l\'arrivée d\'un énorme léonin maniant une hache à double tranchant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418648&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bb962062-d741-40d9-b8db-f4f24599f068\', \'multiverseId\': 418648}, \'multiverseid\': 418648}, {\'name\': \'Tempismo Impeccabile\', \'text\': \'Il Tempismo Impeccabile infligge 3 danni a una creatura attaccante o bloccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Durante la progettazione della trappola per Chandra, Baral non considerò l\'eventuale intervento di un leonid gigantesco armato di ascia bipenne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418912&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ff09a3c2-62bb-46b8-9a67-0eff6c89b859\', \'multiverseId\': 418912}, \'multiverseid\': 418912}, {\'name\': \'絶妙なタイミング\', \'text\': \'攻撃クリーチャー１体かブロック・クリーチャー１体を対象とする。絶妙なタイミングはそれに３点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'バラルがチャンドラを捕らえる罠を準備したときには、双頭の斧を持った巨大なレオニンの登場など、想定していなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419176&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7428683-b644-48b8-a147-a9aee0fef194\', \'multiverseId\': 419176}, \'multiverseid\': 419176}, {\'name\': \'완벽한 시기\', \'text\': \'공격생물이나 방어생물을 목표로 정한다. 완벽한 시기는 그 생물에게 피해 3점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'바랄이 찬드라를 잡기 위한 함정을 만들 때, 거대한 레오닌이 쌍두도끼를 휘두르며 나타날 것이라고는 예상하지 못했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419440&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d0a87dbf-4f9b-4891-886d-deae611b15a0\', \'multiverseId\': 419440}, \'multiverseid\': 419440}, {\'name\': \'Sincronização Impecável\', \'text\': \'Sincronização Impecável causa 3 pontos de dano à criatura atacante ou bloqueadora alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Quando Baral construiu sua armadilha para Chandra, não contava com a chegada de um leonino enorme empunhando um machado de duas lâminas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b57b987a-6569-4c6c-bd46-08c5d707185f\', \'multiverseId\': 419704}, \'multiverseid\': 419704}, {\'name\': \'Безупречный Момент\', \'text\': \'Безупречный Момент наносит 3 повреждения целевому атакующему или блокирующему существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Когда Бараль готовил ловушку для Чандры, он совсем не ждал появления громадного леонинца, вооруженного обоюдоострым топором.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419968&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'22445280-6aab-4a4b-ba85-5d0ea34ee309\', \'multiverseId\': 419968}, \'multiverseid\': 419968}, {\'name\': \'完美时机\', \'text\': \'完美时机对目标进行攻击或阻挡的生物造成3点伤害。\', \'type\': \'瞬间\', \'flavor\': \'巴罗在架设捕捉茜卓的陷阱时，未曾料想会有魁梧狮族挥舞着双头斧杀到。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417856&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8fb05082-19cb-4375-bee5-ac99b1043748\', \'multiverseId\': 417856}, \'multiverseid\': 417856}, {\'name\': \'完美時機\', \'text\': \'完美時機對目標進行攻擊或阻擋的生物造成3點傷害。\', \'type\': \'瞬間\', \'flavor\': \'巴羅在架設捕捉茜卓的陷阱時，未曾料想會有魁梧獅族揮舞著雙頭斧殺到。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418120&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'54be6b88-14c7-47a1-9458-e007e6dbca22\', \'multiverseId\': 418120}, \'multiverseid\': 418120}]', '[{\'name\': \'Pia Nalaar\', \'text\': \'Wenn Pia Nalaar ins Spiel kommt, erzeuge einen 1/1 farblosen Thopter-Artefaktkreaturenspielstein mit Flugfähigkeit.\\n{1}{R}: Eine Artefaktkreatur deiner Wahl erhält +1/+0 bis zum Ende des Zuges.\\n{1}, opfere ein Artefakt: Eine Kreatur deiner Wahl kann in diesem Zug nicht blocken.\', \'type\': \'Legendäre Kreatur — Mensch, Handwerker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418489&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93bcc5b0-5408-4fd2-ba57-ec04c89f4937\', \'multiverseId\': 418489}, \'multiverseid\': 418489}, {\'name\': \'Pia Nalaar\', \'text\': \'Cuando Pia Nalaar entre al campo de batalla, crea una ficha de criatura artefacto Tóptero incolora 1/1 con la habilidad de volar.\\n{1}{R}: La criatura artefacto objetivo obtiene +1/+0 hasta el final del turno.\\n{1}, sacrificar un artefacto: La criatura objetivo no puede bloquear este turno.\', \'type\': \'Criatura legendaria — Artífice humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420337&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e9a336f-3f94-4923-9c50-88e5d4ef671f\', \'multiverseId\': 420337}, \'multiverseid\': 420337}, {\'name\': \'Pia Nalaàr\', \'text\': "Quand Pia Nalaàr arrive sur le champ de bataille, créez un jeton de créature-artefact 1/1 incolore Mécanoptère avec le vol.\\n{1}{R} : La créature-artefact ciblée gagne +1/+0 jusqu\'à la fin du tour.\\n{1}, sacrifiez un artefact : La créature ciblée ne peut pas bloquer ce tour-ci.", \'type\': \'Créature légendaire : humain et artificier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5993990c-1c7b-4ba7-bd75-9083a35fe2ec\', \'multiverseId\': 418753}, \'multiverseid\': 418753}, {\'name\': \'Pia Nalaar\', \'text\': \'Quando Pia Nalaar entra nel campo di battaglia, crea una pedina creatura artefatto Tottero 1/1 incolore con volare.\\n{1}{R}: Una creatura artefatto bersaglio prende +1/+0 fino alla fine del turno.\\n{1}, Sacrifica un artefatto: Una creatura bersaglio non può bloccare in questo turno.\', \'type\': \'Creatura Leggendaria — Artefice Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419017&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eec6b31a-b9ee-4712-9a66-c045bb6c21fc\', \'multiverseId\': 419017}, \'multiverseid\': 419017}, {\'name\': \'ピア・ナラー\', \'text\': \'ピア・ナラーが戦場に出たとき、飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを１体生成する。\\n{1}{R}：アーティファクト・クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受ける。\\n{1}, アーティファクト１つを生け贄に捧げる：クリーチャー１体を対象とする。このターン、それではブロックできない。\', \'type\': \'伝説のクリーチャー — 人間・工匠\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419281&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2abc7ae-7b18-497d-a8ee-9b3c691d031e\', \'multiverseId\': 419281}, \'multiverseid\': 419281}, {\'name\': \'피아 날라르\', \'text\': \'피아 날라르가 전장에 들어올 때, 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰 한 개를 만든다.\\n{1}{R}: 마법물체 생물을 목표로 정한다. 그 마법물체 생물은 턴종료까지 +1/+0을 받는다.\\n{1}, 마법물체 한 개를 희생한다: 생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\', \'type\': \'전설적 생물 — 인간 기능공\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419545&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'02bd165b-91f4-47aa-91c8-a39119a7b741\', \'multiverseId\': 419545}, \'multiverseid\': 419545}, {\'name\': \'Pia Nalaar\', \'text\': \'Quando Pia Nalaar entrar no campo de batalha, crie uma ficha de criatura artefato incolor 1/1 do tipo Tóptero com voar.\\n{1}{R}: A criatura artefato alvo recebe +1/+0 até o final do turno.\\n{1}, Sacrifique um artefato: A criatura alvo não pode bloquear neste turno.\', \'type\': \'Criatura Lendária — Humano Artesão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c1572b9-2fdd-4b81-9981-df270acb3060\', \'multiverseId\': 419809}, \'multiverseid\': 419809}, {\'name\': \'Пия Налаар\', \'text\': \'Когда Пия Налаар выходит на поле битвы, создайте одну фишку артефакта существа 1/1 бесцветный Топтер с Полетом.\\n{1}{R}: целевой артефакт существо получает +1/+0 до конца хода.\\n{1}, пожертвуйте артефакт: целевое существо не может блокировать в этом ходу.\', \'type\': \'Легендарное Существо — Человек Механик\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420073&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7098689b-cd58-4024-98f3-a1f0353507b8\', \'multiverseId\': 420073}, \'multiverseid\': 420073}, {\'name\': \'琵雅纳拉\', \'text\': \'当琵雅纳拉进战场时，派出一个1/1无色，具飞行异能的振翼机衍生神器生物。\\n{1}{R}：目标神器生物得+1/+0直到回合结束。\\n{1}，牺牲一个神器：目标生物本回合不能进行阻挡。\', \'type\': \'传奇生物～人类／神器师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417961&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e177b5a4-5740-4a6f-9d7d-ca288f644819\', \'multiverseId\': 417961}, \'multiverseid\': 417961}, {\'name\': \'琵雅納拉\', \'text\': \'當琵雅納拉進戰場時，派出一個1/1無色，具飛行異能的振翼機衍生神器生物。\\n{1}{R}：目標神器生物得+1/+0直到回合結束。\\n{1}，犧牲一個神器：目標生物本回合不能進行阻擋。\', \'type\': \'傳奇生物～人類／神器師\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418225&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3d83bb15-8bfb-464f-a6e6-1fb8aa12aa9c\', \'multiverseId\': 418225}, \'multiverseid\': 418225}]', '[{\'name\': \'Plattnerkunst-Preisrichterin\', \'text\': \'Wenn die Plattnerkunst-Preisrichterin ins Spiel kommt, ziehe eine Karte für jede Kreatur, die du kontrollierst und auf der mindestens eine +1/+1-Marke liegt.\', \'type\': \'Kreatur — Elf, Handwerker\', \'flavor\': \'Wäre sie keine Preisrichterin, würde sie in ihrer Kategorie gewinnen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418509&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33e5c184-2a9b-4415-8167-e867e9cfbb87\', \'multiverseId\': 418509}, \'multiverseid\': 418509}, {\'name\': \'Jueza de forja de armaduras\', \'text\': \'Cuando la Jueza de forja de armaduras entre al campo de batalla, roba una carta por cada criatura que controlas con un contador +1/+1 sobre ella.\', \'type\': \'Criatura — Artífice elfo\', \'flavor\': \'Si no fuera jueza, ganaría en su propia categoría.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420357&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0ef99ed1-b87d-4182-84a3-3c5b1f893186\', \'multiverseId\': 420357}, \'multiverseid\': 420357}, {\'name\': "Juge des façonneurs d\'armures", \'text\': "Quand la Juge des façonneurs d\'armures arrive sur le champ de bataille, piochez une carte pour chaque créature que vous contrôlez avec un marqueur +1/+1 sur elle.", \'type\': \'Créature : elfe et artificier\', \'flavor\': "Si elle n\'était pas juge, c\'est elle qui remporterait la compétition.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418773&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef999bb1-ae53-4580-96a6-33f27d31c160\', \'multiverseId\': 418773}, \'multiverseid\': 418773}, {\'name\': \'Giudice Forgiacorazze\', \'text\': \'Quando la Giudice Forgiacorazze entra nel campo di battaglia, pesca una carta per ogni creatura con un segnalino +1/+1 che controlli.\', \'type\': \'Creatura — Artefice Elfo\', \'flavor\': \'Se non fosse lei stessa a giudicarla, sarebbe la vincitrice nella sua categoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419037&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34cdc1c5-226b-4706-9ce3-e6b584c77559\', \'multiverseId\': 419037}, \'multiverseid\': 419037}, {\'name\': \'鎧作りの審判者\', \'text\': \'鎧作りの審判者が戦場に出たとき、あなたがコントロールする＋１/＋１カウンターが置かれているクリーチャー１体につきカードを１枚引く。\', \'type\': \'クリーチャー — エルフ・工匠\', \'flavor\': \'審判者でなかったら、この部門では彼女が優勝するだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419301&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d30c6c4e-171d-4b23-ba9b-8f12a850c0ba\', \'multiverseId\': 419301}, \'multiverseid\': 419301}, {\'name\': \'갑옷제작술 심사위원\', \'text\': \'갑옷제작술 심사위원이 전장에 들어올 때, 당신이 조종하는 +1/+1 카운터가 놓여진 생물 한 개당 카드 한 장을 뽑는다.\', \'type\': \'생물 — 엘프 기능공\', \'flavor\': \'그녀가 심사위원이 아니었다면, 대회에서 우승한 사람은 그녀였을 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419565&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'232aae9f-9edf-47e8-9bca-f9b6f7ee711f\', \'multiverseId\': 419565}, \'multiverseid\': 419565}, {\'name\': \'Jurada de Armoraria\', \'text\': \'Quando Jurada de Armoraria entrar no campo de batalha, compre um card para cada criatura que você controla com um marcador +1/+1.\', \'type\': \'Criatura — Elfo Artesão\', \'flavor\': \'Se não fosse a jurada, ela mesma venceria na categoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419829&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d45591b1-4a18-4883-b751-2039edc6ee7f\', \'multiverseId\': 419829}, \'multiverseid\': 419829}, {\'name\': \'Судья Бронного Искусства\', \'text\': \'Когда Судья Бронного Искусства выходит на поле битвы, возьмите одну карту за каждое существо под вашим контролем, на котором есть жетон +1/+1.\', \'type\': \'Существо — Эльф Механик\', \'flavor\': \'Не будь она судьей, она сама сокрушила бы соперников в этой дисциплине.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420093&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e54fb992-0f07-43ca-9fd4-adaf4516bb46\', \'multiverseId\': 420093}, \'multiverseid\': 420093}, {\'name\': \'制甲艺评审\', \'text\': \'当制甲艺评审进战场时，你每操控一个其上有+1/+1指示物的生物，便抓一张牌。\', \'type\': \'生物～妖精／神器师\', \'flavor\': \'她若不是评审，本项目桂冠非她莫属。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'694f65c0-a537-4aa5-b54a-995db3496587\', \'multiverseId\': 417981}, \'multiverseid\': 417981}, {\'name\': \'製甲藝評審\', \'text\': \'當製甲藝評審進戰場時，你每操控一個其上有+1/+1指示物的生物，便抽一張牌。\', \'type\': \'生物～妖精／神器師\', \'flavor\': \'她若不是評審，本項目桂冠非她莫屬。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418245&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'81f619dc-8f72-4017-aab9-c14b374f5a3d\', \'multiverseId\': 418245}, \'multiverseid\': 418245}]', '[{\'name\': \'Prakhata-Säulenkäfer\', \'text\': \'{B}: Der Prakhata-Säulenkäfer erhält Lebensverknüpfung bis zum Ende des Zuges. (Schaden, der von dieser Kreatur zugefügt wird, lässt dich ebenso viele Lebenspunkte dazuerhalten.)\', \'type\': \'Artefaktkreatur — Insekt\', \'flavor\': \'Nicht ein Staubkorn entgeht den gewissenhaften Putzkräften, die den exklusiven Prakhata-Club makellos halten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418593&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'752bf515-9ccc-4755-a4f9-807051db9e7d\', \'multiverseId\': 418593}, \'multiverseid\': 418593}, {\'name\': \'Tecnoruga de Prakhata\', \'text\': \'{B}: La Tecnoruga de Prakhata gana la habilidad de vínculo vital hasta el final del turno. (El daño hecho por esta criatura también hace que ganes esa misma cantidad de vidas.)\', \'type\': \'Criatura artefacto — Insecto\', \'flavor\': \'Ni una sola mota de polvo escapa a los limpiasuelos abnegados que mantienen inmaculado el exclusivo club Prakhata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420441&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db95eef1-bd03-4a42-a23b-4aa802d30456\', \'multiverseId\': 420441}, \'multiverseid\': 420441}, {\'name\': \'Myriapode de Prakhata\', \'text\': "{B} : Le Myriapode de Prakhata acquiert le lien de vie jusqu\'à la fin du tour. (Les blessures infligées par cette créature vous font aussi gagner autant de points de vie.)", \'type\': \'Créature-artefact : insecte\', \'flavor\': "Pas un grain de poussière n\'échappe aux agents consciencieux qui nettoient le très exclusif Club Prakhata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418857&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0a1b7ccb-fc4b-41b0-8e63-5b1a49e24b78\', \'multiverseId\': 418857}, \'multiverseid\': 418857}, {\'name\': \'Meccabruco di Prakhata\', \'text\': \'{B}: Il Meccabruco di Prakhata ha legame vitale fino alla fine del turno. (Il danno inflitto da questa creatura ti fa anche guadagnare altrettanti punti vita.)\', \'type\': \'Creatura Artefatto — Insetto\', \'flavor\': "Neppure un granello di polvere può sfuggire agli operosi addetti alla pulizia che mantengono immacolato l\'esclusivo Club Prakhata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419121&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acca0814-4843-4dea-9eac-2805a4fb68b8\', \'multiverseId\': 419121}, \'multiverseid\': 419121}, {\'name\': \'プラカタの柱行虫\', \'text\': \'{B}：ターン終了時まで、プラカタの柱行虫は絆魂を得る。（このクリーチャーがダメージを与えると、さらにあなたはその点数分のライフを得る。）\', \'type\': \'アーティファクト・クリーチャー — 昆虫\', \'flavor\': \'塵も埃も逃さない従順な掃除機械が会員制プラカタクラブを清潔に保っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419385&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf6c4361-e71e-4246-983d-ba1cb6e70f91\', \'multiverseId\': 419385}, \'multiverseid\': 419385}, {\'name\': \'프라카타 기둥벌레\', \'text\': \'{B}: 프라카타 기둥벌레는 턴종료까지 생명연결을 얻는다. (이 생물이 피해를 입히면, 이 생물의 조종자는 그 피해만큼의 생명점을 얻는다.)\', \'type\': \'마법물체 생물 — 곤충\', \'flavor\': \'티끌 하나도 용납하지 않는 깐깐한 청소부 덕분에 고급 프라카타 클럽은 아주 깨끗하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419649&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ba068544-cc70-4e45-a341-21dc856e7846\', \'multiverseId\': 419649}, \'multiverseid\': 419649}, {\'name\': \'Mecanopeia do Prakhata\', \'text\': \'{B}: Mecanopeia do Prakhata ganha vínculo com a vida até o final do turno. (O dano causado por esta criatura faz com que você ganhe uma quantidade equivalente de pontos de vida.)\', \'type\': \'Criatura Artefato — Inseto\', \'flavor\': \'Nenhum grão de poeira escapa aos diligentes faxineiros que mantêm imaculado o exclusivo Clube Prakhata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419913&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a37c2e20-a424-44dc-b309-dbe92fbfa654\', \'multiverseId\': 419913}, \'multiverseid\': 419913}, {\'name\': \'Пракатская Механожка\', \'text\': \'{B}: Пракатская Механожка получает Цепь жизни до конца хода. (Повреждения, наносимые этим существом, также заставляют вас получить такое же количество жизней.)\', \'type\': \'Артефакт Существо — Насекомое\', \'flavor\': \'Ни одна пылинка не скроется от деловитых чистильщиков, содержащих в идеальном порядке престижный Пракатский клуб.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420177&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d1f2c596-f8ed-4231-8daa-c39303e6e9ab\', \'multiverseId\': 420177}, \'multiverseid\': 420177}, {\'name\': \'巴克特会械虫\', \'text\': \'{B}：巴克特会械虫获得系命异能直到回合结束。（此生物所造成的伤害会让你得到等量的生命。）\', \'type\': \'神器生物～昆虫\', \'flavor\': \'巴克特会的清扫器会拭去一切尘埃，保持这家私人会所洁净无瑕。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418065&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1259f85f-e86c-4a93-9ff6-80606931ca23\', \'multiverseId\': 418065}, \'multiverseid\': 418065}, {\'name\': \'巴克特會械蟲\', \'text\': \'{B}：巴克特會械蟲獲得繫命異能直到回合結束。（此生物所造成的傷害會讓你獲得等量的生命。）\', \'type\': \'神器生物～昆蟲\', \'flavor\': \'巴克特會的清掃器會拭去一切塵埃，保持這家私人會所潔淨無瑕。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418329&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'87994925-1a07-4855-828d-cc1c9dc8da33\', \'multiverseId\': 418329}, \'multiverseid\': 418329}]', "[{'name': 'Prakhata-Türsteher', 'type': 'Kreatur — Äthergeborener, Krieger', 'flavor': 'Nur selten schließt der Prakhata-Club seine Pforten. Und ebenso selten trifft sich Fürst Gonti mit Konsul Kambal. Wie wahrscheinlich ist es, dass beides am selben Tag passiert?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418463&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b6dd684e-0f48-4520-81f6-92c67ed408cc', 'multiverseId': 418463}, 'multiverseid': 418463}, {'name': 'Seguridad del club Prakhata', 'type': 'Criatura — Guerrero etergénito', 'flavor': 'Es raro que el club Prakhata cierre sus puertas, casi tanto como que el señor Gonti tenga una reunión con el Cónsul Kambal. ¿Qué posibilidades había de que ambas cosas ocurriesen el mismo día?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420311&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f0ed6e51-ebf1-49f8-8302-9e840ae243c8', 'multiverseId': 420311}, 'multiverseid': 420311}, {'name': 'Sécurité du Club Prakhata', 'type': 'Créature : éthérien et guerrier', 'flavor': 'Le Club Prakhata ferme rarement ses portes et le seigneur Gonti ne rencontre que rarement le consul Kambal. Quelles sont les chances pour que les deux se produisent le même jour ?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418727&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4a8a27bf-2ef1-40bd-a440-30b54684e426', 'multiverseId': 418727}, 'multiverseid': 418727}, {'name': 'Buttafuori del Club Prakhata', 'type': 'Creatura — Guerriero Eteride', 'flavor': 'È raro che il Club Prakhata chiuda i battenti. È altrettanto raro che il Signor Gonti si incontri con il console Kambal. Che combinazione che entrambi gli eventi si verifichino lo stesso giorno!', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418991&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '06a88a62-015a-41e9-8561-5f26f46787fa', 'multiverseId': 418991}, 'multiverseid': 418991}, {'name': 'プラカタクラブの用心棒', 'type': 'クリーチャー — 霊基体・戦士', 'flavor': 'プラカタクラブの扉が閉ざされることは希である。ゴンティ王とカンバール領事が歓談することも希である。その二つが同じ日に起きる確率は？', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419255&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '058cc70e-37ea-4001-b410-fd7de97b1854', 'multiverseId': 419255}, 'multiverseid': 419255}, {'name': '프라카타 클럽 경비', 'type': '생물 — 에테르붙이 전사', 'flavor': '프라카타 클럽이 그 문을 닫는 일은 거의 없다. 곤티 군주가 캄발 영사를 만나는 것 또한 흔치 않다. 그러면 저 두 가지가 같은 날 일어날 확률은 얼마나 될까?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419519&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3b87e7da-5b05-41e1-bcf9-c517258d444a', 'multiverseId': 419519}, 'multiverseid': 419519}, {'name': 'Segurança do Clube Prakhata', 'type': 'Criatura — Etergênito Guerreiro', 'flavor': 'É raro o Clube Prakhata fechar as portas. Também é raro que o Senhor Gonti se encontre com o Cônsul Kambal. Qual é a probabilidade de os dois ocorrerem no mesmo dia?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419783&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0de75f2a-3840-4841-9558-f57da4ad8271', 'multiverseId': 419783}, 'multiverseid': 419783}, {'name': 'Охранник Пракатского Клуба', 'type': 'Существо — Эфирид Воин', 'flavor': 'Пракатский клуб редко закрывает двери. А владыка Гонти редко встречается с консулом Камбалом. Велики ли шансы того, что это случайно произошло в один день?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420047&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '881f2828-a600-46b8-970a-f35f9e9af6c2', 'multiverseId': 420047}, 'multiverseid': 420047}, {'name': '巴克特会警卫', 'type': '生物～乙太种／战士', 'flavor': '巴克特会难得大门紧闭。领主贡提也很少与执政坎拔会面。这两件事发生在同一天的机率有多低？', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417935&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '890d3bdd-7419-4a5c-be3c-e4de67989ce4', 'multiverseId': 417935}, 'multiverseid': 417935}, {'name': '巴克特會警衛', 'type': '生物～乙太種／戰士', 'flavor': '巴克特會難得大門緊閉。領主貢提也很少與執政坎拔會面。這兩件事發生在同一天的機率有多低？', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418199&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '1441bb5b-ec69-4b0b-b647-6a8201159759', 'multiverseId': 418199}, 'multiverseid': 418199}]", '[{\'name\': \'Privilegien aberkennen\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur kann nicht angreifen, blocken oder Fahrzeuge bemannen.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Gemäß Erlass 482 des Konsulats ist es meine Pflicht, dich zu inhaftieren, Bürger."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418391&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cacad3ce-dfb7-43fc-b638-acbaed00cfb3\', \'multiverseId\': 418391}, \'multiverseid\': 418391}, {\'name\': \'Privilegios revocados\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede atacar, bloquear ni tripular Vehículos.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"En concordancia con el Mandato 482 del Consulado, nos vemos obligados a detenerte, ciudadano".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420239&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07bd6bf4-c12d-400a-9ff6-5306591cd294\', \'multiverseId\': 420239}, \'multiverseid\': 420239}, {\'name\': \'Révocation des privilèges\', \'text\': \'Enchanter : créature\\nLa créature enchantée ne peut ni attaquer, ni bloquer, ni piloter de véhicule.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Citoyen, en vertu du mandat consulaire 482, je dois vous placer en détention. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418655&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd59af1a-77c3-4cf1-aa02-2c1199e8b53d\', \'multiverseId\': 418655}, \'multiverseid\': 418655}, {\'name\': \'Revocare i Privilegi\', \'text\': \'Incanta creatura\\nLa creatura incantata non può attaccare, bloccare o manovrare Veicoli.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Ai sensi del Mandato consolare 482, devo procedere al tuo arresto, cittadino."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418919&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c9371854-d17c-4741-8c37-3986e381b07f\', \'multiverseId\': 418919}, \'multiverseid\': 418919}, {\'name\': \'特権剥奪\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーでは攻撃したりブロックしたりできず、それは機体に搭乗できない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「市民、領事府指令482号により、あなたを拘束します。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419183&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f651994-b0e4-47e6-8b30-ae1a3e43ea0b\', \'multiverseId\': 419183}, \'multiverseid\': 419183}, {\'name\': \'특권 박탈\', \'text\': \'생물에게 부여\\n부여된 생물은 공격, 방어 또는 탑승물에 탑승할 수 없다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"영사관 칙령 482조에 따라 당신을 구금합니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419447&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'71354fb1-b512-4166-9e8a-da1869d49048\', \'multiverseId\': 419447}, \'multiverseid\': 419447}, {\'name\': \'Revogar Privilégios\', \'text\': \'Encantar criatura\\nA criatura encantada não pode atacar, bloquear nem tripular Veículos.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Por determinação do Mandado 482 do Consulado, sou obrigado a detê-lo, cidadão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419711&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7dd16859-8edf-4c90-8ab0-163d2dee0aa5\', \'multiverseId\': 419711}, \'multiverseid\': 419711}, {\'name\': \'Отзыв Привилегий\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может атаковать, блокировать или входить в Экипаж Машин.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Согласно мандату Консульства номер 482, я обязан вас задержать, гражданин».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419975&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'705b6696-e390-471d-9f1f-89b8d7ecda77\', \'multiverseId\': 419975}, \'multiverseid\': 419975}, {\'name\': \'撤销特权\', \'text\': \'结附于生物\\n所结附的生物不能进行攻击、阻挡或搭载载具。\', \'type\': \'结界～灵气\', \'flavor\': \'「市民，根据执政院482号命令，我必须拘捕你。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417863&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5399d416-9c8d-45a0-b831-8e37f96f3a45\', \'multiverseId\': 417863}, \'multiverseid\': 417863}, {\'name\': \'撤銷特權\', \'text\': \'結附於生物\\n所結附的生物不能進行攻擊、阻擋或搭載載具。\', \'type\': \'結界～靈氣\', \'flavor\': \'「市民，根據執政院482號命令，我必須拘捕你。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418127&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5283965d-078b-4e96-91e2-ff5a06fc395a\', \'multiverseId\': 418127}, \'multiverseid\': 418127}]', '[{\'name\': \'Propeller-Pionierin\', \'text\': \'Fliegend\\nFabrizieren 1 (Wenn diese Kreatur ins Spiel kommt, lege eine +1/+1-Marke auf sie oder erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.)\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'„Nach oben sind keine Grenzen gesetzt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418389&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae17e13c-33f1-47d7-882a-5edb7f3223ac\', \'multiverseId\': 418389}, \'multiverseid\': 418389}, {\'name\': \'Exploradora portahélices\', \'text\': \'Vuela.\\nFabricar 1. (Cuando esta criatura entre al campo de batalla, pon un contador +1/+1 sobre ella o crea una ficha de criatura artefacto Servo incolora 1/1.)\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'"El cielo no es el límite. Es el punto de partida".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420237&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'404abcc4-0024-43a6-bf3d-d5ba1ef8d018\', \'multiverseId\': 420237}, \'multiverseid\': 420237}, {\'name\': \'Pionnière à hélices\', \'text\': \'Vol\\nFabrication 1 (Quand cette créature arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle ou créez un jeton de créature-artefact 1/1 incolore Servo.)\', \'type\': \'Créature : humain et artificier\', \'flavor\': "« Le ciel n\'est pas la fin. C\'est le point de départ. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418653&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9a75bad-5a04-4da0-b54b-7f32c88ea7a8\', \'multiverseId\': 418653}, \'multiverseid\': 418653}, {\'name\': \'Pioniera della Propulsione\', \'text\': \'Volare\\nFabbrica 1 (Quando questa creatura entra nel campo di battaglia, metti un segnalino +1/+1 su di essa o crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.)\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'"Il cielo non è un traguardo, ma una linea di partenza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418917&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'385ec458-0110-4870-bbf6-3a4c8b007073\', \'multiverseId\': 418917}, \'multiverseid\': 418917}, {\'name\': \'プロペラの先駆者\', \'text\': \'飛行\\n製造１（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを１個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。）\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'「空は限界じゃないわ。出発点なのよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419181&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32150c5e-1a2e-49fc-abbc-2cd3ad668e6e\', \'multiverseId\': 419181}, \'multiverseid\': 419181}, {\'name\': \'프로펠러 개척자\', \'text\': \'비행\\n제작 1 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 한 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.)\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'"하늘은 끝이 아니라 시작일 뿐이지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419445&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f6469758-4ffa-4d66-b6a1-af4e6a94a2b4\', \'multiverseId\': 419445}, \'multiverseid\': 419445}, {\'name\': \'Pioneira dos Propulsores\', \'text\': \'Voar\\nFabricar 1 (Quando esta criatura entrar no campo de batalha, coloque um marcador +1/+1 nela ou crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.)\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'"O céu não é o limite. Ele é o ponto de partida."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419709&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'497e147d-1d3d-4ee0-9a6b-fe58e4618296\', \'multiverseId\': 419709}, \'multiverseid\': 419709}, {\'name\': \'Винтокрылый Новатор\', \'text\': \'Полет\\nПроизводство 1 (Когда это существо выходит на поле битвы, положите на него один жетон +1/+1 или создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.)\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'«Небо — не предел. Это лишь отправная точка».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419973&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e93626c-1131-42a6-9a56-b83695a0498b\', \'multiverseId\': 419973}, \'multiverseid\': 419973}, {\'name\': \'螺旋桨先驱\', \'text\': \'飞行\\n装配1（当此生物进战场时，在其上放置一个+1/+1指示物或派出一个1/1无色自动机衍生神器生物。）\', \'type\': \'生物～人类／神器师\', \'flavor\': \'「天空不是终点，而是起点。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417861&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba529f40-7adf-4786-892b-e6dc184174aa\', \'multiverseId\': 417861}, \'multiverseid\': 417861}, {\'name\': \'螺旋槳先驅\', \'text\': \'飛行\\n裝配1（當此生物進戰場時，在其上放置一個+1/+1指示物或派出一個1/1無色自動機衍生神器生物。）\', \'type\': \'生物～人類／神器師\', \'flavor\': \'「天空不是終點，而是起點。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418125&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0b3210a3-277e-45ee-8f2e-c46d475bc56b\', \'multiverseId\': 418125}, \'multiverseid\': 418125}]', '[{\'name\': \'Prophetisches Prisma\', \'text\': \'Wenn das Prophetische Prisma ins Spiel kommt, ziehe eine Karte.\\n{1}, {T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Artefakt\', \'flavor\': \'Um Kaladesh zu verstehen, muss man erst verstehen, wie Äther und Erfindergeist zusammen im großen Ätherkreislauf fließen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418594&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ee2a737-0272-4e48-981c-0a281965a4d6\', \'multiverseId\': 418594}, \'multiverseid\': 418594}, {\'name\': \'Prisma profético\', \'text\': \'Cuando el Prisma profético entre al campo de batalla, roba una carta.\\n{1}, {T}: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Para entender Kaladesh, primero hay que entender que el éter y la invención fluyen juntos a través del gran Ciclo del Éter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420442&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e573336-5164-4ae7-bf5e-977b21f8e67c\', \'multiverseId\': 420442}, \'multiverseid\': 420442}, {\'name\': \'Prisme prophétique\', \'text\': \'Quand le Prisme prophétique arrive sur le champ de bataille, piochez une carte.\\n{1}, {T} : Ajoutez un mana de la couleur de votre choix à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Pour comprendre Kaladesh, il faut d\'abord comprendre comment l\'Éther et les inventions évoluent ensemble dans le grand cycle de l\'Éther.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418858&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'380cb2dd-dcf5-4425-b0eb-a4820f40b653\', \'multiverseId\': 418858}, \'multiverseid\': 418858}, {\'name\': \'Prisma Profetico\', \'text\': \'Quando il Prisma Profetico entra nel campo di battaglia, pesca una carta.\\n{1}, {T}: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': "Per comprendere Kaladesh, occorre prima capire come l\'etere e il processo inventivo confluiscano nel grande Ciclo Eterico.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419122&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8c9be29-c14a-4895-bf4b-48b2ab288959\', \'multiverseId\': 419122}, \'multiverseid\': 419122}, {\'name\': \'予言のプリズム\', \'text\': \'予言のプリズムが戦場に出たとき、カードを１枚引く。\\n{1}, {T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'カラデシュを知るためには、大きな霊気循環の中で霊気と発明がどのように流通するのかを、まず理解する必要がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419386&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'397470cd-41da-4d61-92e5-4aac80449f51\', \'multiverseId\': 419386}, \'multiverseid\': 419386}, {\'name\': \'예언의 프리즘\', \'text\': \'예언의 프리즘이 전장에 들어올 때, 카드 한 장을 뽑는다.\\n{1}, {T}: 원하는 색의 마나 한 개를 당신의 마나풀에 담는다.\', \'type\': \'마법물체\', \'flavor\': \'칼라데시를 이해하려면 에테르와 발명이 위대한 에테르 사이클에서 조화롭게 움직이는 방식을 이해해야 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419650&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'276525bf-c810-4c84-aae6-030d59dfd1ef\', \'multiverseId\': 419650}, \'multiverseid\': 419650}, {\'name\': \'Prisma Profético\', \'text\': \'Quando Prisma Profético entrar no campo de batalha, compre um card.\\n{1}, {T}: Adicione um mana de qualquer cor à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Para entender Kaladesh, primeiro é necessário entender como o éter e a invenção fluem juntos no grande Ciclo do Éter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419914&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2efb3615-2dba-416e-a6b3-052255d71432\', \'multiverseId\': 419914}, \'multiverseid\': 419914}, {\'name\': \'Пророческая Призма\', \'text\': \'Когда Пророческая Призма выходит на поле битвы, возьмите карту.\\n{1}, {T}: добавьте одну ману любого цвета в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'Чтобы понять Каладеш, сперва нужно понять, как эфир и изобретения переплетаются в великом Эфирном Цикле.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420178&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'00f29125-1ba6-497e-864f-88ee8dae5ceb\', \'multiverseId\': 420178}, \'multiverseid\': 420178}, {\'name\': \'预视棱镜\', \'text\': \'当预视棱镜进战场时，抓一张牌。\\n{1}，{T}：加一点任意颜色的法术力到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'若要了解卡拉德许，就必须先从了解乙太大循环中乙太与发明的交汇入手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'76d97cdd-b5b6-49f2-8c50-ef185c34a871\', \'multiverseId\': 418066}, \'multiverseid\': 418066}, {\'name\': \'預視稜鏡\', \'text\': \'當預視稜鏡進戰場時，抽一張牌。\\n{1}，{T}：加一點任意顏色的魔法力到你的魔法力池中。\', \'type\': \'神器\', \'flavor\': \'若要了解卡拉德許，就必須先從了解乙太大循環中乙太與發明的交匯入手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418330&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c423ecb8-c97f-4528-9c9c-ef1db5fefda9\', \'multiverseId\': 418330}, \'multiverseid\': 418330}]', '[{\'name\': \'Raffinierter Schlag\', \'text\': \'Bestimme eines oder beides —\\n• Eine Kreatur deiner Wahl erhält -1/-1 bis zum Ende des Zuges.\\n• Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manche Renegaten verrichten ihre beste Arbeit direkt vor den Augen des Konsulats.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418465&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'977dfb01-c483-4011-9ad5-b3ba7c432ead\', \'multiverseId\': 418465}, \'multiverseid\': 418465}, {\'name\': \'Agresión taimada\', \'text\': \'Elige uno o ambos:\\n• La criatura objetivo obtiene -1/-1 hasta el final del turno.\\n• Pon un contador +1/+1 sobre la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Los renegados hacen parte de su mejor trabajo en las narices del Consulado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420313&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f58d28a9-b7a4-4a42-b486-974d51493c31\', \'multiverseId\': 420313}, \'multiverseid\': 420313}, {\'name\': \'Frappe subtile\', \'text\': "Choisissez l\'un ou les deux —\\n• La créature ciblée gagne -1/-1 jusqu\'à la fin du tour.\\n• Mettez un marqueur +1/+1 sur la créature ciblée.", \'type\': \'Éphémère\', \'flavor\': \'Les renégats réalisent certaines de leurs meilleures opérations au nez et à la barbe du Consulat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418729&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c83d9439-af37-4754-9375-da3cf14c148d\', \'multiverseId\': 418729}, \'multiverseid\': 418729}, {\'name\': \'Colpo Inaspettato\', \'text\': \'Scegli uno o entrambi —\\n• Una creatura bersaglio prende -1/-1 fino alla fine del turno.\\n• Metti un segnalino +1/+1 su una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'I rinnegati compiono alcune delle loro azioni più riuscite proprio sotto il naso del Consolato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418993&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aa674224-48a1-448b-a3bf-3c086d3fe024\', \'multiverseId\': 418993}, \'multiverseid\': 418993}, {\'name\': \'隠然たる襲撃\', \'text\': \'以下から１つまたは両方を選ぶ。\\n• クリーチャー１体を対象とする。ターン終了時まで、それは－１/－１の修整を受ける。\\n• クリーチャー１体を対象とし、それの上に＋１/＋１カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': \'改革派の最高の活動の中には、領事府の鼻先で行われるものもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419257&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e0ac023-6166-40d8-9d88-6fad67a95d1a\', \'multiverseId\': 419257}, \'multiverseid\': 419257}, {\'name\': \'섬세한 일격\', \'text\': \'하나 혹은 둘 다를 선택한다 —\\n• 생물을 목표로 정한다. 그 생물은 턴종료까지 -1/-1을 받는다.\\n• 생물을 목표로 정한다. 그 생물에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'순간마법\', \'flavor\': \'무법자들은 영사관이 가까이 접근하면 자신들이 가장 잘하는 일을 한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419521&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1f6b7bb9-d722-4945-813d-09e8ecc6a600\', \'multiverseId\': 419521}, \'multiverseid\': 419521}, {\'name\': \'Golpe Sutil\', \'text\': \'Escolha um ou ambos —\\n• A criatura alvo recebe -1/-1 até o final do turno.\\n• Coloque um marcador +1/+1 na criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os renegados fazem alguns de seus melhores trabalhos bem embaixo do nariz do Consulado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419785&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b1465c8-d17e-43ef-9f4b-67edd1c3029c\', \'multiverseId\': 419785}, \'multiverseid\': 419785}, {\'name\': \'Незаметный Удар\', \'text\': \'Выберите одно или оба —\\n• Целевое существо получает -1/-1 до конца хода.\\n• Положите один жетон +1/+1 на целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Свои самые удачные дела отступники проворачивают прямо под носом у Консульства.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420049&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3caeb1d3-12d7-4502-b08e-51e917731da0\', \'multiverseId\': 420049}, \'multiverseid\': 420049}, {\'name\': \'暗中一击\', \'text\': \'选择一项或都选～\\n•目标生物得-1/-1直到回合结束。\\n•在目标生物上放置一个+1/+1指示物。\', \'type\': \'瞬间\', \'flavor\': \'乱匠在执政院眼皮底下作出不少绝妙行动。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417937&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'11074572-ebd1-4bd9-ad82-9039442b9ce7\', \'multiverseId\': 417937}, \'multiverseid\': 417937}, {\'name\': \'暗中一擊\', \'text\': \'選擇一項或都選～\\n•目標生物得-1/-1直到回合結束。\\n•在目標生物上放置一個+1/+1指示物。\', \'type\': \'瞬間\', \'flavor\': \'亂匠在執政院眼皮底下作出不少絕妙行動。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418201&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4137e0ed-851a-43ea-a67a-da7575759912\', \'multiverseId\': 418201}, \'multiverseid\': 418201}]', '[{\'name\': \'Rashmi, Schöpferin der Ewigkeiten\', \'text\': \'Immer wenn du zum ersten Mal in einem Zug einen Zauberspruch wirkst, decke die oberste Karte deiner Bibliothek auf. Falls es eine Karte ist, die kein Land ist und deren umgewandelte Manakosten kleiner sind als die des Zauberspruchs, kannst du sie wirken, ohne ihre Manakosten zu bezahlen. Falls du die aufgedeckte Karte nicht wirkst, nimm sie auf deine Hand.\', \'type\': \'Legendäre Kreatur — Elf, Druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'457952f9-1500-49e0-8a38-74cbba86ad1c\', \'multiverseId\': 418549}, \'multiverseid\': 418549}, {\'name\': \'Rashmi, escultora de eternidades\', \'text\': \'Siempre que lances tu primer hechizo cada turno, muestra la primera carta de tu biblioteca. Si es una carta que no sea tierra con coste de maná convertido menor que el del hechizo, puedes lanzarla sin pagar su coste de maná. Si no lanzas la carta mostrada, ponla en tu mano.\', \'type\': \'Criatura legendaria — Druida elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420397&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce869416-2d99-4b39-b9e9-549d252c09d1\', \'multiverseId\': 420397}, \'multiverseid\': 420397}, {\'name\': \'Rashmi, façonneuse des Éternités\', \'text\': "À chaque fois que vous lancez votre premier sort à chaque tour, révélez la carte du dessus de votre bibliothèque. Si c\'est une carte non-terrain avec un coût converti de mana inférieur à celui de ce sort, vous pouvez la lancer sans payer son coût de mana. Si vous ne lancez pas la carte révélée, mettez-la dans votre main.", \'type\': \'Créature légendaire : elfe et druide\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418813&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01baf8e6-e105-453b-9d3b-d06c50b9b6b0\', \'multiverseId\': 418813}, \'multiverseid\': 418813}, {\'name\': \'Rashmi, Plasmatrice di Eternità\', \'text\': \'Ogniqualvolta lanci la tua prima magia in ogni turno, rivela la prima carta del tuo grimorio. Se è una carta non terra con costo di mana convertito inferiore a quello di quella magia, puoi lanciarla senza pagare il suo costo di mana. Se non lanci la carta rivelata, aggiungila alla tua mano.\', \'type\': \'Creatura Leggendaria — Druido Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419077&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb0d7e69-e117-4476-8afb-9df70be9f477\', \'multiverseId\': 419077}, \'multiverseid\': 419077}, {\'name\': \'永遠の造り手、ラシュミ\', \'text\': \'あなたが各ターンのあなたの１つ目の呪文を唱えるたび、あなたのライブラリーの一番上のカードを公開する。それが、その呪文よりも点数で見たマナ・コストが小さい、土地でないカードであるなら、あなたはそれをそのマナ・コストを支払うことなく唱えてもよい。その公開したカードを唱えないなら、それをあなたの手札に加える。\', \'type\': \'伝説のクリーチャー — エルフ・ドルイド\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419341&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f08a64d-53af-4ba4-863b-e37da1468c92\', \'multiverseId\': 419341}, \'multiverseid\': 419341}, {\'name\': \'영생 제작자 라시미\', \'text\': \'당신이 매 턴 당신의 첫 번째 주문을 발동할 때마다, 당신의 서고 맨 위의 카드를 공개한다. 그 카드가 대지 카드가 아니고 전환마나비용이 발동한 주문의 비용보다 적다면, 당신은 마나 비용을 지불하지 않고 그 카드를 발동할 수 있다. 공개된 카드를 발동하지 않으면, 당신의 손으로 가져간다.\', \'type\': \'전설적 생물 — 엘프 드루이드\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419605&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7b031a13-503b-4a80-8361-798f4cf50a57\', \'multiverseId\': 419605}, \'multiverseid\': 419605}, {\'name\': \'Rashmi, Artesã das Eternidades\', \'text\': \'Toda vez que você conjurar sua primeira mágica em cada turno, revele o card do topo de seu grimório. Se for um card que não seja terreno com custo de mana convertido inferior ao daquela mágica, você poderá conjurá-lo sem pagar seu custo de mana. Se não conjurar o card revelado desta forma, coloque-o em sua mão.\', \'type\': \'Criatura Lendária — Elfo Druida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3b12d2cc-5002-40b5-8e2e-44eee5f64df6\', \'multiverseId\': 419869}, \'multiverseid\': 419869}, {\'name\': \'Рашми, Мастерица Вечности\', \'text\': \'Каждый раз, когда вы разыгрываете ваше первое заклинание в каждом ходу, покажите верхнюю карту вашей библиотеки. Если это не являющаяся землей карта с конвертированной мана-стоимостью меньше, чем у того заклинания, то вы можете разыграть ее без уплаты ее мана-стоимости. Если вы не разыгрываете показанную карту, положите ее в вашу руку.\', \'type\': \'Легендарное Существо — Эльф Друид\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420133&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3ee1f9a1-4ed1-4da4-813f-6835ee3a3be6\', \'multiverseId\': 420133}, \'multiverseid\': 420133}, {\'name\': \'虚空塑师列施蜜\', \'text\': \'每当你施放每回合中你的第一个咒语时，展示你的牌库顶牌。若该牌为非地牌，且其总法术力费用小于该咒语，则你可以施放它，且不需支付其法术力费用。若你未施放所展示的牌，则将它置于你手上。\', \'type\': \'传奇生物～妖精／德鲁伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418021&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f8a60749-1adb-4c13-b741-e95011a0c364\', \'multiverseId\': 418021}, \'multiverseid\': 418021}, {\'name\': \'虛空塑師列施蜜\', \'text\': \'每當你施放每回合中你的第一個咒語時，展示你的牌庫頂牌。若該牌為非地牌，且其總魔法力費用小於該咒語，則你可以施放它，且不需支付其魔法力費用。若你未施放所展示的牌，則將它置於你手上。\', \'type\': \'傳奇生物～妖精／德魯伊\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418285&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'016881a4-facc-415d-a01b-45e149b171e7\', \'multiverseId\': 418285}, \'multiverseid\': 418285}]', '[{\'name\': \'Renegaten-Frachter\', \'text\': \'Immer wenn der Renegaten-Frachter angreift, erhält er +1/+1 und verursacht Trampelschaden bis zum Ende des Zuges.\\nBemannen 2 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 2 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418595&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1756ea1f-248b-484f-873d-bca177f4b0c9\', \'multiverseId\': 418595}, \'multiverseid\': 418595}, {\'name\': \'Locomotora renegada\', \'text\': \'Siempre que la Locomotora renegada ataque, obtiene +1/+1 y gana la habilidad de arrollar hasta el final del turno.\\nTripular 2. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 2 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420443&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0de6a2ad-40a2-4677-a286-2e5f741d08d5\', \'multiverseId\': 420443}, \'multiverseid\': 420443}, {\'name\': \'Cargo renégat\', \'text\': "À chaque fois que le Cargo renégat attaque, il gagne +1/+1 et acquiert le piétinement jusqu\'à la fin du tour.\\nPilotage 2 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 2 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418859&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c7c52d2-442b-40d0-ae06-d602808baaa2\', \'multiverseId\': 418859}, \'multiverseid\': 418859}, {\'name\': \'Cargo dei Rinnegati\', \'text\': \'Ogniqualvolta il Cargo dei Rinnegati attacca, prende +1/+1 e ha travolgere fino alla fine del turno.\\nManovrare 2 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 2: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)\', \'type\': \'Artefatto — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419123&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f7a8acb-fc22-4c8d-8d03-b8894ace9087\', \'multiverseId\': 419123}, \'multiverseid\': 419123}, {\'name\': \'改革派の貨物車\', \'text\': \'改革派の貨物車が攻撃するたび、ターン終了時まで、これは＋１/＋１の修整を受けるとともにトランプルを得る。\\n搭乗２（あなたがコントロールする望む数のクリーチャーを、パワーの合計が２以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419387&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86a58025-ab38-4620-88b7-94ccf031e9a6\', \'multiverseId\': 419387}, \'multiverseid\': 419387}, {\'name\': \'무법자 화물차\', \'text\': \'무법자 화물차가 공격할 때마다, 무법자 화물차는 턴종료까지 +1/+1을 받고 돌진을 얻는다.\\n탑승 2 (당신이 조종하는 생물을 공격력 총합이 2 이상이 되도록 원하는 수만큼 탭한다: 이 탑승물은 턴종료까지 마법물체 생물이 된다.)\', \'type\': \'마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419651&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'26379e76-8347-49a1-83e2-5f19bb547089\', \'multiverseId\': 419651}, \'multiverseid\': 419651}, {\'name\': \'Fretista Renegado\', \'text\': \'Toda vez que Fretista Renegado ataca, ele recebe +1/+1 e ganha atropelar até o final do turno.\\nTripular 2 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 2: Este Veículo se torna uma criatura artefato até o final do turno.)\', \'type\': \'Artefato — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419915&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d85c075e-f5ec-40f7-8b93-8f78a5dab328\', \'multiverseId\': 419915}, \'multiverseid\': 419915}, {\'name\': \'Грузовоз Отступников\', \'text\': \'Каждый раз, когда Грузовоз Отступников атакует, он получает +1/+1 и Пробивной удар до конца хода.\\nЭкипаж 2 (Поверните любое количество существ под вашим контролем с суммарной силой 2 или более: эта Машина становится артефактом существом до конца хода.)\', \'type\': \'Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420179&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'925399d3-12d5-4ab8-9619-17fe0c4c917f\', \'multiverseId\': 420179}, \'multiverseid\': 420179}, {\'name\': \'乱匠货车\', \'text\': \'每当乱匠货车攻击时，直到回合结束，它得+1/+1且获得践踏异能。\\n搭载2（横置任意数量由你操控且力量总和等于或大于2的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'神器～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418067&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d0ef13e-37ca-4d8a-97ff-bdc7efa6d335\', \'multiverseId\': 418067}, \'multiverseid\': 418067}, {\'name\': \'亂匠貨車\', \'text\': \'每當亂匠貨車攻擊時，直到回合結束，它得+1/+1且獲得踐踏異能。\\n搭載2（橫置任意數量由你操控且力量總和等於或大於2的生物：此載具成為神器生物直到回合結束。）\', \'type\': \'神器～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418331&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c656a731-edea-4c3b-b7db-8cbdd52804af\', \'multiverseId\': 418331}, \'multiverseid\': 418331}]', '[{\'name\': \'Renegaten-Taktik\', \'text\': \'Eine Kreatur deiner Wahl kann in diesem Zug nicht blocken.\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Nichts gegen dich. Aber ich bin es leid, auf die Freigabe durch das Konsulats zu warten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418492&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42e0c8dc-456e-426e-a2b5-4acee715c82c\', \'multiverseId\': 418492}, \'multiverseid\': 418492}, {\'name\': \'Tácticas de renegado\', \'text\': \'La criatura objetivo no puede bloquear este turno.\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'"No tengo nada contra ti. Solo es que nunca me gustó esperar la aprobación del Consulado".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420340&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f628a6a9-6977-42c9-b60a-cdf6035eb4d8\', \'multiverseId\': 420340}, \'multiverseid\': 420340}, {\'name\': \'Tactiques de renégat\', \'text\': \'La créature ciblée ne peut pas bloquer ce tour-ci.\\nPiochez une carte.\', \'type\': \'Rituel\', \'flavor\': "« Je n\'ai rien contre vous, mais je n\'ai jamais vraiment aimé attendre l\'autorisation du Consulat. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418756&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8de38ccd-450f-4788-b573-21f0f5fc36c1\', \'multiverseId\': 418756}, \'multiverseid\': 418756}, {\'name\': \'Tattiche dei Rinnegati\', \'text\': \'Una creatura bersaglio non può bloccare in questo turno.\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Niente di personale. Solo che aspettare l\\\'autorizzazione del Consolato non è mai stato il mio forte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419020&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf11221f-f0fe-4e82-bcab-ed08e8c30dd2\', \'multiverseId\': 419020}, \'multiverseid\': 419020}, {\'name\': \'改革派の戦術\', \'text\': \'クリーチャー１体を対象とする。このターン、それではブロックできない。\\nカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「君に恨みはないがね。領事府の許可をじっと待つのは性に合わないんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419284&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0bafa577-1512-416c-ba98-a2a15ab4bb93\', \'multiverseId\': 419284}, \'multiverseid\': 419284}, {\'name\': \'무법자의 전략\', \'text\': \'생물을 목표로 정한다. 그 생물은 이 턴에 방어할 수 없다.\\n카드 한 장을 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"당신에게 악감정은 없어. 그냥 영사관의 허가를 기다리는 게 체질에 맞지 않을 뿐이야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419548&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'98ca2154-b713-4c89-961f-8378373fdec6\', \'multiverseId\': 419548}, \'multiverseid\': 419548}, {\'name\': \'Tática dos Renegados\', \'text\': \'A criatura alvo não pode bloquear neste turno.\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': \'"Nada contra você. É que esperar pela autorização do Consulado nunca foi meu forte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419812&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9927f4f3-05d8-4d37-9bc9-d7a896306d34\', \'multiverseId\': 419812}, \'multiverseid\': 419812}, {\'name\': \'Тактика Отступников\', \'text\': \'Целевое существо не может блокировать в этом ходу.\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Ты не сделал мне ничего плохого. Просто не хочется ждать, пока Консульство выдаст мне допуск».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420076&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0e398ab-ae0b-4056-b57a-3a8cc439b066\', \'multiverseId\': 420076}, \'multiverseid\': 420076}, {\'name\': \'乱匠战术\', \'text\': \'目标生物本回合不能进行阻挡。\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「我不是针对你。我只是没兴趣等执政院的许可。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417964&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dabee24a-ccd6-41eb-b021-7e88e207b279\', \'multiverseId\': 417964}, \'multiverseid\': 417964}, {\'name\': \'亂匠戰術\', \'text\': \'目標生物本回合不能進行阻擋。\\n抽一張牌。\', \'type\': \'巫術\', \'flavor\': \'「我不是針對你。我只是沒興趣等執政院的許可。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418228&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0f10945b-7d60-4c09-9233-095ac2546497\', \'multiverseId\': 418228}, \'multiverseid\': 418228}]', '[{\'name\': \'Renegaten-Unruhestifter\', \'text\': \'Solange du eine Chandra-Planeswalkerin kontrollierst, erhält der Renegaten-Unruhestifter +1/+0 und hat Erstschlag. (Er fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'„Für Freiheit! Für Ruhm! Für Feuer!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'175bc05d-01ae-430f-b6f2-1810d56361b0\', \'multiverseId\': 420511}, \'multiverseid\': 420511}, {\'name\': \'Instigador renegado\', \'text\': \'Mientras controles un planeswalker Chandra, el Instigador renegado obtiene +1/+0 y tiene la habilidad de dañar primero. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'"¡Por la libertad! ¡Por la gloria! ¡Por la llama!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420581&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dfefbf24-f955-4e48-b278-92ade158254e\', \'multiverseId\': 420581}, \'multiverseid\': 420581}, {\'name\': \'Brandon renégat\', \'text\': "Tant que vous contrôlez un planeswalker Chandra, le Brandon renégat gagne +1/+0 et a l\'initiative. (Il inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Créature : humain et guerrier\', \'flavor\': \'« Pour la liberté ! Pour la gloire ! Pour le feu ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420521&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d815d95-1e82-4d9d-8fc3-c0ea29886f05\', \'multiverseId\': 420521}, \'multiverseid\': 420521}, {\'name\': \'Tizzone Ardente Rinnegato\', \'text\': \'Fintanto che controlli un planeswalker Chandra, il Tizzone Ardente Rinnegato prende +1/+0 e ha attacco improvviso. (Infligge danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'"Per la libertà! Per la fama! Per la fiamma!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420531&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41fa8a00-3f8b-4e93-a81e-8f949cf040a5\', \'multiverseId\': 420531}, \'multiverseid\': 420531}, {\'name\': \'改革派の炬火\', \'text\': \'あなたがチャンドラ・プレインズウォーカーをコントロールしているかぎり、改革派の炬火は＋１/＋０の修整を受けるとともに先制攻撃を持つ。（これは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'「自由、名声、そして火のために！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420541&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4a67a64-ff48-4a6e-b720-65cbe7a2dc8e\', \'multiverseId\': 420541}, \'multiverseid\': 420541}, {\'name\': \'무법자 선동가\', \'text\': \'당신이 찬드라 플레인즈워커를 조종하는 한, 무법자 선동가는 +1/+0을 받고 선제공격을 가진다. (이 생물은 선제공격이 없는 생물보다 먼저 전투피해를 입힌다.)\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'"자유를 위해! 명예를 위해! 불꽃을 위해!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420551&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'74d8790d-599a-41c0-85e8-7e49e0b94ad3\', \'multiverseId\': 420551}, \'multiverseid\': 420551}, {\'name\': \'Instigador Renegado\', \'text\': \'Enquanto você controlar uma planeswalker do tipo Chandra, Instigador Renegado receberá +1/+0 e terá iniciativa. (Ele causa dano de combate antes das criaturas sem iniciativa.)\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'"Pela liberdade! Pela fama! Pelo fogo!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420561&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'544b9418-37ef-466d-9a2e-d57d4acbf3e9\', \'multiverseId\': 420561}, \'multiverseid\': 420561}, {\'name\': \'Отступник-Разжигатель\', \'text\': \'Пока вы контролируете planeswalker-а Чандру, Отступник-Разжигатель получает +1/+0 и имеет Первый удар. (Он наносит боевые повреждения раньше существ без Первого удара.)\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'«За свободу! За славу! За огонь!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420571&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'abf7f504-5404-4767-9013-8ef8b697fe85\', \'multiverseId\': 420571}, \'multiverseid\': 420571}, {\'name\': \'惹事乱匠\', \'text\': \'只要你操控茜卓鹏洛客，惹事乱匠便得+1/+0且具有先攻异能。（它会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'生物～人类／战士\', \'flavor\': \'「为了自由！为了名誉！为了烈焰！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420491&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a365105b-fb67-4113-8f84-45c7642f0ae6\', \'multiverseId\': 420491}, \'multiverseid\': 420491}, {\'name\': \'惹事亂匠\', \'text\': \'只要你操控茜卓鵬洛客，惹事亂匠便得+1/+0且具先攻異能。（它會比不具先攻異能的生物提前造成戰鬥傷害。）\', \'type\': \'生物～人類／戰士\', \'flavor\': \'「為了自由！為了名譽！為了烈焰！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420501&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7593eb1f-77a8-46ab-b6a5-d01587f8b033\', \'multiverseId\': 420501}, \'multiverseid\': 420501}]', '[{\'name\': \'Rennbahn-Fanatikerin\', \'text\': \'Eile\\nImmer wenn die Rennbahn-Fanatikerin ein Fahrzeug bemannt, erhält das Fahrzeug Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Pilot\', \'flavor\': \'Selbst wenn ihr Fahrzeug eine Bremse hätte, wüsste sie nicht, welches Pedal es ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418497&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ef46a11-47a3-46f0-bc54-dc2139c10a11\', \'multiverseId\': 418497}, \'multiverseid\': 418497}, {\'name\': \'Devota del circuito\', \'text\': \'Prisa.\\nSiempre que la Devota del circuito tripule un Vehículo, ese Vehículo gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Piloto humano\', \'flavor\': \'Incluso si su vehículo tuviera frenos, no sabría qué pedal es.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420345&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f443e18d-4542-4b5f-aa9c-4a1ce8375a85\', \'multiverseId\': 420345}, \'multiverseid\': 420345}, {\'name\': \'Fanatique du circuit\', \'text\': "Célérité\\nÀ chaque fois que la Fanatique du circuit pilote un véhicule, ce véhicule acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : humain et pilote\', \'flavor\': \'Si son véhicule avait un frein, elle serait bien incapable de vous dire où.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418761&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ca87b2b-fa15-4cd4-8fde-8e250357063e\', \'multiverseId\': 418761}, \'multiverseid\': 418761}, {\'name\': \'Fanatica del Circuito\', \'text\': \'Rapidità\\nOgniqualvolta la Fanatica del Circuito manovra un Veicolo, quel Veicolo ha rapidità fino alla fine del turno.\', \'type\': \'Creatura — Pilota Umano\', \'flavor\': \'Se anche il suo veicolo avesse dei freni, non saprebbe dire con quale pedale si attivino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419025&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'036d61f3-6f2a-48fe-8011-db8b01e903ca\', \'multiverseId\': 419025}, \'multiverseid\': 419025}, {\'name\': \'競走路の熱狂者\', \'text\': \'速攻\\n競走路の熱狂者が機体１つに搭乗するたび、ターン終了時まで、その機体は速攻を得る。\', \'type\': \'クリーチャー — 人間・操縦士\', \'flavor\': \'ブレーキがあったとしても、どのペダルなのか知らないのだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419289&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02af618a-fba9-4a3f-af42-6f09e934e1f2\', \'multiverseId\': 419289}, \'multiverseid\': 419289}, {\'name\': \'스피드광\', \'text\': \'신속\\n스피드광이 탑승물에 탑승할 때마다, 그 탑승물은 턴종료까지 신속을 얻는다.\', \'type\': \'생물 — 인간 조종사\', \'flavor\': \'그녀의 탑승물에 브레이크가 있다고 해도, 그녀는 어떤 페달이 브레이크인지 모른다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419553&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3abffa98-2d68-4073-9d90-fc7cb479d81d\', \'multiverseId\': 419553}, \'multiverseid\': 419553}, {\'name\': \'Fanática das Pistas\', \'text\': \'Ímpeto\\nToda vez que Fanática das Pistas tripula um Veículo, aquele Veículo ganha ímpeto até o final do turno.\', \'type\': \'Criatura — Humano Piloto\', \'flavor\': \'Mesmo que o veículo dela tivesse um freio, ela não saberia lhe dizer qual é o pedal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68dee4a2-9e5b-47bf-adb6-ac99ab0266a3\', \'multiverseId\': 419817}, \'multiverseid\': 419817}, {\'name\': \'Неистовая Гонщица\', \'text\': \'Ускорение\\nКаждый раз, когда Неистовая Гонщица входит в Экипаж Машины, та Машина получает Ускорение до конца хода.\', \'type\': \'Существо — Человек Пилот\', \'flavor\': \'Если у ее машины и есть тормоз, то вряд ли она знает, какая это педаль.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420081&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2418aaac-4a0e-488a-9f33-561ce4a9602f\', \'multiverseId\': 420081}, \'multiverseid\': 420081}, {\'name\': \'狂热赛手\', \'text\': \'敏捷\\n每当狂热赛手搭载载具时，该载具获得敏捷异能直到回合结束。\', \'type\': \'生物～人类／驾手\', \'flavor\': \'即使她的车上装有刹车，她也分不清是哪块踏板。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417969&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e91cb5c-a01f-4b26-bdcf-7230ab81a000\', \'multiverseId\': 417969}, \'multiverseid\': 417969}, {\'name\': \'狂熱賽手\', \'text\': \'敏捷\\n每當狂熱賽手搭載載具時，該載具獲得敏捷異能直到回合結束。\', \'type\': \'生物～人類／駕手\', \'flavor\': \'即使她的車上裝有剎車，她也分不清是哪塊踏板。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418233&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5a44dee2-4f7b-482d-bd39-a0c05b28c6d2\', \'multiverseId\': 418233}, \'multiverseid\': 418233}]', '[{\'name\': \'Reparierende Technoschmiedin\', \'text\': \'Wenn die Reparierende Technoschmiedin ins Spiel kommt, bringe eine Artefakt- oder Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'Alles, was sie anfasst, wird zu gut geöltem, fein abgestimmtem und perfekt ausbalanciertem Gold.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418550&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9367f135-144c-4529-acca-ac1abc4fd811\', \'multiverseId\': 418550}, \'multiverseid\': 418550}, {\'name\': \'Reparadora de engranajes\', \'text\': \'Cuando la Reparadora de engranajes entre al campo de batalla, regresa la carta de artefacto o criatura objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'Todo lo que toca se convierte en oro... Un oro bien engrasado, exquisitamente calibrado y perfectamente equilibrado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'28a51433-c694-43d8-9776-202264c46ada\', \'multiverseId\': 420398}, \'multiverseid\': 420398}, {\'name\': \'Restauratrice mécanique\', \'text\': "Quand la Restauratrice mécanique arrive sur le champ de bataille, renvoyez une carte de créature ou d\'artefact ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : humain et artificier\', \'flavor\': "Tout ce qu\'elle touche se transforme en or parfaitement équilibré, délicatement calibré et bien huilé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418814&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff888a2f-7ea0-41cf-94f2-81e755dbe50b\', \'multiverseId\': 418814}, \'multiverseid\': 418814}, {\'name\': \'Riparatrice di Ingranaggi\', \'text\': \'Quando la Riparatrice di Ingranaggi entra nel campo di battaglia, riprendi in mano una carta artefatto o creatura bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': \'Tutto ciò che tocca si tramuta in oro ben lubrificato, accuratamente calibrato e perfettamente bilanciato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419078&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'636053c9-d025-4b21-90de-f95bb48ffa4d\', \'multiverseId\': 419078}, \'multiverseid\': 419078}, {\'name\': \'機械修復職人\', \'text\': \'機械修復職人が戦場に出たとき、あなたの墓地からアーティファクト・カード１枚かクリーチャー・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'彼女の手にかかれば何でも、十分に注油され絶妙に調整された、バランスのよい貴重品に生まれ変わる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6809ca6c-3baf-4c1a-840b-4a4b30e73194\', \'multiverseId\': 419342}, \'multiverseid\': 419342}, {\'name\': \'복원의 톱니대장장이\', \'text\': \'복원의 톱니대장장이가 전장에 들어올 때, 당신의 무덤에 있는 마법물체 또는 생물 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'그녀의 손길이 닿으면 기름칠이 잘 되어 있고 섬세하게 보정됐으며 완벽하게 균형 잡힌 귀한 물건으로 바뀐다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419606&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'617675e7-2503-4e90-b3cb-15247c8973c0\', \'multiverseId\': 419606}, \'multiverseid\': 419606}, {\'name\': \'Engreneira de Restauração\', \'text\': \'Quando Engreneira de Restauração entrar no campo de batalha, devolva o card de artefato ou criatura alvo de seu cemitério para a sua mão.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'Tudo que ela toca vira ouro, mas um ouro bem lubrificado, delicadamente calibrado e perfeitamente balanceado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419870&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f87d789b-7cfd-4ce1-a2a4-436d168fd438\', \'multiverseId\': 419870}, \'multiverseid\': 419870}, {\'name\': \'Мастеровая-Ремонтница\', \'text\': \'Когда Мастеровая-Ремонтница выходит на поле битвы, верните целевую карту артефакта или существа из вашего кладбища в вашу руку.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'Все, к чему она прикасается, превращается в хорошо смазанное, тщательно настроенное и идеально сбалансированное золото.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420134&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93c57134-af40-4f00-ad38-30bab9ea518a\', \'multiverseId\': 420134}, \'multiverseid\': 420134}, {\'name\': \'整修工匠\', \'text\': \'当整修工匠进战场时，将目标神器或生物牌从你的坟墓场移回你手上。\', \'type\': \'生物～人类／神器师\', \'flavor\': \'她经手之物都会成为运转顺畅，校正精准，完美平衡的黄金。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418022&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ca989870-c7b0-4cef-8505-1aca0876f5f4\', \'multiverseId\': 418022}, \'multiverseid\': 418022}, {\'name\': \'整修工匠\', \'text\': \'當整修工匠進戰場時，將目標神器或生物牌從你的墳墓場移回你手上。\', \'type\': \'生物～人類／神器師\', \'flavor\': \'她經手之物都會成為運轉順暢，校正精準，完美平衡的黃金。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418286&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'45859b7e-c729-4280-832f-2343e800c2ce\', \'multiverseId\': 418286}, \'multiverseid\': 418286}]', '[{\'name\': \'Revolutionäre Zurückweisung\', \'text\': \'Neutralisiere einen Nichtartefakt-Zauberspruch deiner Wahl, es sei denn, sein Beherrscher bezahlt {2}.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wenn die Sanktionen des Konsulats offiziell verhängt werden, haben die Flinkschmied-Renegaten schon längst einen Weg gefunden, sie zu umgehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418426&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dfd7ab1d-35fd-4aa4-bcdb-c41bf54c04cb\', \'multiverseId\': 418426}, \'multiverseid\': 418426}, {\'name\': \'Impugnación revolucionaria\', \'text\': \'Contrarresta el hechizo objetivo que no sea de artefacto a menos que su controlador pague {2}.\', \'type\': \'Instantáneo\', \'flavor\': \'Cuando una sanción del Consulado se hace oficial, los forjacéleres renegados ya han encontrado la forma de evadirla.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420274&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b17fa1f-abb5-4fdb-b5ac-09cec222fd71\', \'multiverseId\': 420274}, \'multiverseid\': 420274}, {\'name\': \'Rebuffade révolutionnaire\', \'text\': \'Contrecarrez le sort non-artefact ciblé à moins que son contrôleur ne paie {2}.\', \'type\': \'Éphémère\', \'flavor\': "Dès qu\'une sanction du Consulat devient enfin officielle, les forgevifs renégats ont déjà trouvé un moyen de la contourner.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418690&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'069d121a-967b-4dd8-8f87-8a2ff72bbc1a\', \'multiverseId\': 418690}, \'multiverseid\': 418690}, {\'name\': \'Rigetto Rivoluzionario\', \'text\': \'Neutralizza una magia non artefatto bersaglio a meno che il suo controllore non paghi {2}.\', \'type\': \'Istantaneo\', \'flavor\': \'Nel tempo che impiega una sanzione del Consolato a entrare in vigore, i tempralesti rinnegati hanno già trovato il modo di aggirarla.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418954&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5ff29650-4996-4b75-9888-d81958f27925\', \'multiverseId\': 418954}, \'multiverseid\': 418954}, {\'name\': \'革命的拒絶\', \'text\': \'アーティファクトでない呪文１つを対象とし、それのコントローラーが{2}を支払わないかぎり、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'領事府の制裁措置が承認される以前に、改革派の速製職人はそれを出し抜く方法を見つけていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419218&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e24c5590-122f-4548-bb5d-30beeca5d392\', \'multiverseId\': 419218}, \'multiverseid\': 419218}, {\'name\': \'혁명적 거절\', \'text\': \'마법물체가 아닌 주문을 목표로 정한다. 그 주문의 조종자가 {2}를 지불하지 않으면 그 주문을 무효화한다.\', \'type\': \'순간마법\', \'flavor\': \'영사관의 제재가 공식화될 무렵, 무법자 숙련기술공들은 이미 피해갈 방법을 찾았다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419482&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c762835-660e-4481-ab28-1596c170c9d5\', \'multiverseId\': 419482}, \'multiverseid\': 419482}, {\'name\': \'Repúdio Revolucionário\', \'text\': \'Anule a mágica alvo que não seja de artefato, a menos que seu controlador pague {2}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'No momento em que uma sanção do Consulado se torna oficial, os veloferreiros renegados já encontraram uma forma de contorná-la.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419746&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27b1aec0-898f-4c65-b05e-f84dddbaa7ea\', \'multiverseId\': 419746}, \'multiverseid\': 419746}, {\'name\': \'Революционный Отказ\', \'text\': \'Отмените целевое заклинание, не являющееся заклинанием артефакта, если только контролирующий его игрок не заплатит {2}.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'К тому времени, как запрет Консульства вступает в силу, проворные кузнецы отступников уже находят способ его обойти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420010&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f805c91e-f90f-4037-b430-18a7b4a78cd0\', \'multiverseId\': 420010}, \'multiverseid\': 420010}, {\'name\': \'革新拒斥\', \'text\': \'除非目标非神器咒语的操控者支付{2}，否则反击之。\', \'type\': \'瞬间\', \'flavor\': \'等到执政院的制裁正式生效时，反乱迅匠们早已想好应对之策。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417898&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05a43d23-d74c-4757-ac59-f0c248094a44\', \'multiverseId\': 417898}, \'multiverseid\': 417898}, {\'name\': \'革新拒斥\', \'text\': \'除非目標非神器咒語的操控者支付{2}，否則反擊之。\', \'type\': \'瞬間\', \'flavor\': \'等到執政院的制裁正式生效時，反亂迅匠們早已想好應對之策。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418162&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d74ddbdd-c63e-4503-b621-c6af02fceb87\', \'multiverseId\': 418162}, \'multiverseid\': 418162}]', '[{\'name\': \'Riesenspektakel\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +2/+1 und hat Bedrohlichkeit.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Der Riesen-Dekorationswettbewerb beim Migrationsfestival ist eine Tradition, die wohl als Mutprobe angefangen hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f03237e4-18f0-4040-8844-e58f4d8c6c8c\', \'multiverseId\': 418481}, \'multiverseid\': 418481}, {\'name\': \'Espectáculo de gigantes\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +2/+1 y tiene la habilidad de amenaza.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El concurso de decoración de gigantes en el festival de la migración es una tradición que probablemente empezó como una broma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420329&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6170ffcc-15d6-4182-95c6-c4923c9a6df3\', \'multiverseId\': 420329}, \'multiverseid\': 420329}, {\'name\': \'Spectacle géant\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +2/+1 et a la menace.\', \'type\': \'Enchantement : aura\', \'flavor\': "C\'est peut-être un gage qui est à l\'origine du concours traditionnel de décorations de géants du festival migratoire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e7beea9f-643c-4b96-8751-db93d0fbfdef\', \'multiverseId\': 418745}, \'multiverseid\': 418745}, {\'name\': \'Spettacolo Gigantesco\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +2/+1 e ha minacciare.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'La gara di decorazione dei giganti durante la festa della migrazione è una tradizione che potrebbe affondare le radici in una vecchia scommessa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'610924ea-eb94-44b1-85e6-85a1b4d046ca\', \'multiverseId\': 419009}, \'multiverseid\': 419009}, {\'name\': \'巨人の光景\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋２/＋１の修整を受けるとともに威迫を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'移住祭の呼び物である巨人装飾コンテストの伝統は、もともと度胸試しだったのかもしれない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419273&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2bda8204-b029-4c4d-af7d-d96cdb4ecfe8\', \'multiverseId\': 419273}, \'multiverseid\': 419273}, {\'name\': \'거대한 볼거리\', \'text\': \'생물에게 부여\\n부여된 생물은 +2/+1을 받고 호전적을 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'이주민 축제의 전통인 거인 꾸미기 콘테스트는 처음에는 무모한 도전에서 시작되었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419537&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9616b83c-e7c5-4ffd-9e8d-1c1719f8d988\', \'multiverseId\': 419537}, \'multiverseid\': 419537}, {\'name\': \'Espetáculo de Gigantes\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +2/+1 e tem ameaçar.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'O concurso de decoração de gigantes no festival da migração é uma tradição que pode ter começado como um desafio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419801&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2450746-3ebe-4084-9f3e-4a59796a4f05\', \'multiverseId\': 419801}, \'multiverseid\': 419801}, {\'name\': \'Грандиозное Зрелище\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +2/+1 и имеет Угрозу.\', \'type\': \'Чары — Аура\', \'flavor\': \'Конкурс по украшению гигантов на фестивале миграции — традиция, которая, скорее всего, началась с рискованной шутки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cf56995f-4595-465a-90ec-d69d7a7ca1d9\', \'multiverseId\': 420065}, \'multiverseid\': 420065}, {\'name\': \'巨大奇观\', \'text\': \'结附于生物\\n所结附的生物得+2/+1且具有威慑异能。\', \'type\': \'结界～灵气\', \'flavor\': \'迁徙节上的巨人盛装大赛这项传统可能源自某种挑战行动。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417953&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3240d90b-f52e-4f81-a345-1cb58e798129\', \'multiverseId\': 417953}, \'multiverseid\': 417953}, {\'name\': \'巨大奇觀\', \'text\': \'結附於生物\\n所結附的生物得+2/+1且具有威懾異能。\', \'type\': \'結界～靈氣\', \'flavor\': \'遷徙節上的巨人盛裝大賽這項傳統可能源自某種挑戰行動。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418217&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'524b85ef-39c3-46ae-9433-30b55440de5e\', \'multiverseId\': 418217}, \'multiverseid\': 418217}]', '[{\'name\': \'Rücksichtsloser Feuerweber\', \'text\': \'Immer wenn ein Artefakt unter deiner Kontrolle ins Spiel kommt, fügt der Rücksichtslose Feuerweber jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'Die vollendete Form der Drachenkörper inspiriert die Architekten, doch die Handwerker finden eher Gefallen am feurigen Atem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'658187a0-7c61-46f6-92c2-6472eaac3ed6\', \'multiverseId\': 418491}, \'multiverseid\': 418491}, {\'name\': \'Tejellamas temerario\', \'text\': \'Siempre que un artefacto entre al campo de batalla bajo tu control, el Tejellamas temerario hace 1 punto de daño a cada oponente.\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'Los arquitectos encuentran inspiración en la belleza de formas del dragón, mientras que el funcionamiento de su fuego atrapa a los artífices.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420339&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'87719e5c-dae9-4341-9657-451e3da56a4f\', \'multiverseId\': 420339}, \'multiverseid\': 420339}, {\'name\': \'Tissefeu téméraire\', \'text\': "À chaque fois qu\'un artefact arrive sur le champ de bataille sous votre contrôle, le Tissefeu téméraire inflige 1 blessure à chaque adversaire.", \'type\': \'Créature : humain et artificier\', \'flavor\': "Les architectes s\'inspirent de la beauté du dragon, tandis que les artificiers reproduisent ses flammes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418755&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'17179147-6b57-4cd7-9ad1-6e163ea6641c\', \'multiverseId\': 418755}, \'multiverseid\': 418755}, {\'name\': \'Tessifuoco Imprudente\', \'text\': \'Ogniqualvolta un artefatto entra nel campo di battaglia sotto il tuo controllo, il Tessifuoco Imprudente infligge 1 danno a ogni avversario.\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': "Gli architetti trovano ispirazione nell\'eleganza delle forme dei draghi, mentre è l\'efficacia delle loro fiamme a influenzare gli artefici.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419019&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'850d1d69-49d7-4aa5-8681-5ce2474ca075\', \'multiverseId\': 419019}, \'multiverseid\': 419019}, {\'name\': \'無謀な炎織り\', \'text\': \'アーティファクトが１つあなたのコントロール下で戦場に出るたび、無謀な炎織りは各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'建築家はドラゴンの形式美から着想を得るが、工匠はその炎の機能からヒントを得る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419283&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'909b984f-4d98-4afb-a70f-d60040495811\', \'multiverseId\': 419283}, \'multiverseid\': 419283}, {\'name\': \'무모한 화염방직공\', \'text\': \'마법물체가 당신의 조종하에 전장에 들어올 때마다, 무모한 화염방직공은 각 상대에게 피해 1점을 입힌다.\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'건축가는 용의 아름다운 모습에서 영감을 찾지만, 기능공은 용이 내뿜는 불에서 아이디어를 얻는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419547&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fa3dcaa4-8e13-47d0-90bf-1b4ec4728007\', \'multiverseId\': 419547}, \'multiverseid\': 419547}, {\'name\': \'Flamitecelão Temerário\', \'text\': \'Toda vez que um artefato entra no campo de batalha sob seu controle, Flamitecelão Temerário causa 1 ponto de dano a cada oponente.\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'Os arquitetos encontram inspiração na beleza estrutural do dragão, enquanto os artesãos são influenciados pela eficácia de seu fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419811&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7740acde-2db3-4db5-a5b5-ed1aa9405fd3\', \'multiverseId\': 419811}, \'multiverseid\': 419811}, {\'name\': \'Безрассудный Кудесник Огня\', \'text\': \'Каждый раз, когда артефакт выходит на поле битвы под вашим контролем, Безрассудный Кудесник Огня наносит 1 повреждение каждому оппоненту.\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'Архитекторы ищут вдохновение в совершенном облике дракона, а механики изучают принцип действия его пламени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420075&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cbef9a2e-7b76-4b4f-8b94-22e061e6d52e\', \'multiverseId\': 420075}, \'multiverseid\': 420075}, {\'name\': \'鲁莽织焰匠\', \'text\': \'每当一个神器在你的操控下进战场时，鲁莽织焰匠向每位对手各造成1点伤害。\', \'type\': \'生物～人类／神器师\', \'flavor\': \'建筑师从巨龙优美形态中觅求灵感，而神器师则受其喷火能力启发。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417963&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5860a10-00c8-4eb2-8ea0-c858f7058593\', \'multiverseId\': 417963}, \'multiverseid\': 417963}, {\'name\': \'魯莽織焰匠\', \'text\': \'每當一個神器在你的操控下進戰場時，魯莽織焰匠對每位對手各造成1點傷害。\', \'type\': \'生物～人類／神器師\', \'flavor\': \'建築師從巨龍優美形態中覓求靈感，而神器師則受其噴火能力啟發。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418227&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'378d0080-9780-493e-b288-2c0cd256fcc1\', \'multiverseId\': 418227}, \'multiverseid\': 418227}]', '[{\'name\': \'Saheeli Rai\', \'text\': \'+1: Hellsicht 1. Saheeli Rai fügt jedem Gegner 1 Schadenspunkt zu.\\n—2: Erzeuge einen Spielstein, der eine Kopie eines Artefakts oder einer Kreatur deinerWahl, das bzw. die du kontrollierst, ist, außer dass er zusätzlich zu seinen anderen Typen ein Artefakt ist. Der Spielstein erhält Eile. Schicke ihn zu Beginn des nächsten Endsegments ins Exil.\\n—7: Durchsuche deine Bibliothek nach bis zu drei Artefaktkarten mit unterschiedlichen Namen, bringe sie ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Planeswalker — Saheeli\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418551&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'982891c4-0973-454c-b36d-263be9a9ef32\', \'multiverseId\': 418551}, \'multiverseid\': 418551}, {\'name\': \'Saheeli Rai\', \'text\': \'+1: Adivina 1. Saheeli Rai hace 1 punto de daño a cada oponente.\\n−2: Crea una ficha que es una copia del artefacto o criatura objetivo que controlas, excepto que es un artefacto además de sus otros tipos. Esa ficha gana la habilidad de prisa. Exíliala al comienzo del próximo paso final.\\n−7: Busca en tu biblioteca hasta tres cartas de artefacto con nombres distintos, ponlas en el campo de batalla y luego baraja tu biblioteca.\', \'type\': \'Planeswalker — Saheeli\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'37da3c74-471e-45ea-bb35-31ada3bada1b\', \'multiverseId\': 420399}, \'multiverseid\': 420399}, {\'name\': \'Saheeli Rai\', \'text\': "+1 : Regard 1. Saheeli Rai inflige 1 blessure à chaque adversaire.\\n-2 : Créez un jeton qui est une copie d\'un artefact ciblé ou d\'une créature ciblée que vous contrôlez, excepté que c\'est un artefact en plus de ses autres types. Ce jeton acquiert la célérité. Exilez-le au début de la prochaine étape de fin.\\n-7 : Cherchez dans votre bibliothèque jusqu\'à trois cartes d\'artefact ayant des noms différents, mettez-les sur le champ de bataille et mélangez ensuite votre bibliothèque.", \'type\': \'Planeswalker : Saheeli\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418815&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23245c7c-d4c7-47fc-90a4-49e3c764f948\', \'multiverseId\': 418815}, \'multiverseid\': 418815}, {\'name\': \'Saheeli Raji\', \'text\': "+1: Profetizza 1. Saheeli Raji infligge 1 danno a ogni avversario.\\n-2: Crea una pedina che è una copia di un artefatto o una creatura bersaglio che controlli, tranne che è un artefatto in aggiunta ai suoi altri tipi. Quella pedina ha rapidità. Esiliala all\'inizio della prossima sottofase finale.\\n-7: Passa in rassegna il tuo grimorio per trovare fino a tre carte artefatto con nomi diversi, mettile sul campo di battaglia, poi rimescola il tuo grimorio.", \'type\': \'Planeswalker — Saheeli\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419079&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0feb45c-145b-4dfe-8b9f-feb4293365c5\', \'multiverseId\': 419079}, \'multiverseid\': 419079}, {\'name\': \'サヒーリ・ライ\', \'text\': \'+1：占術１を行う。サヒーリ・ライは各対戦相手にそれぞれ１点のダメージを与える。\\n-2：あなたがコントロールするアーティファクト１つかクリーチャー１体を対象とし、それの他のタイプに加えてアーティファクトであることを除きそれのコピーであるトークンを１つ生成する。そのトークンは速攻を得る。次の終了ステップの開始時に、それを追放する。\\n-7：あなたのライブラリーから異なる名前のアーティファクト・カード最大３枚を探し、それらを戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'プレインズウォーカー — サヒーリ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419343&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'468c82f1-81a6-4278-8d34-3dd86b06e440\', \'multiverseId\': 419343}, \'multiverseid\': 419343}, {\'name\': \'사힐리 라이\', \'text\': \'+1: 점술 1을 한다. 사힐리 라이는 각 상대에게 피해 1점을 입힌다.\\n−2: 당신이 조종하는 마법물체 또는 생물을 목표로 정한다. 그 목표의 복사본인 토큰 한 개를 만든다. 단, 그 토큰은 자신의 다른 유형에 더불어 마법물체다. 그 토큰은 신속을 얻는다. 다음 종료단 시작에 그 토큰을 추방한다.\\n−7: 당신의 서고에서 서로 다른 이름을 가진 마법물체 카드를 최대 세 장까지 찾아 전장에 놓은 후, 당신의 서고를 섞는다.\', \'type\': \'플레인즈워커 — 사힐리\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419607&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d9394df5-f238-4591-bd48-0bb3aba94cd1\', \'multiverseId\': 419607}, \'multiverseid\': 419607}, {\'name\': \'Saheeli Rai\', \'text\': \'+1: Vidência 1. Saheeli Rai causa 1 ponto de dano a cada oponente.\\n−2: Crie uma ficha que seja uma cópia do artefato ou criatura alvo que você controla, exceto que ela é um artefato além de seus outros tipos. Aquela ficha ganha ímpeto. Exile-a no início da próxima etapa final.\\n−7: Procure até três cards de artefato com nomes diferentes em seu grimório, coloque-os no campo de batalha e, em seguida, embaralhe seu grimório.\', \'type\': \'Planeswalker — Saheeli\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419871&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1054828f-dd0f-4212-a681-3c0687226c63\', \'multiverseId\': 419871}, \'multiverseid\': 419871}, {\'name\': \'Сахили Рей\', \'text\': \'+1: предскажите 1. Сахили Рей наносит 1 повреждение каждому оппоненту.\\n−2: создайте фишку, являющуюся копией целевого артефакта или существа под вашим контролем, но при этом являющуюся артефактом в дополнение к своим другим типам. Та фишка получает Ускорение. Изгоните ее в начале следующего заключительного шага.\\n−7: найдите в вашей библиотеке не более трех карт артефактов с разными именами, положите их на поле битвы, затем перетасуйте вашу библиотеку.\', \'type\': \'Planeswalker — Сахили\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420135&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6404814c-9bd7-4418-9180-8c79d7a23d61\', \'multiverseId\': 420135}, \'multiverseid\': 420135}, {\'name\': \'莎希莉莱伊\', \'text\': \'+1：占卜1。莎希莉莱伊向每位对手各造成1点伤害。\\n−2：派出一个衍生物，此衍生物为目标由你操控的神器或生物之复制品，但它额外具有神器此类别。该衍生物获得敏捷异能。在下一个结束步骤开始时，将它放逐。\\n−7：从你的牌库中搜寻至多三张名称各不相同的神器牌，将它们放进战场，然后将你的牌库洗牌。\', \'type\': \'鹏洛客～莎希莉\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418023&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a6ddd93a-f440-4636-925e-f73f0f14d4ee\', \'multiverseId\': 418023}, \'multiverseid\': 418023}, {\'name\': \'莎希莉萊伊\', \'text\': \'+1：占卜1。莎希莉萊伊向每位對手各造成1點傷害。\\n−2：派出一個衍生物，此衍生物為目標由你操控的神器或生物之複製品，但它額外具有神器此類別。該衍生物獲得敏捷異能。在下一個結束步驟開始時，將它放逐。\\n−7：從你的牌庫中搜尋至多三張名稱各不相同的神器牌，將它們放進戰場，然後將你的牌庫洗牌。\', \'type\': \'鵬洛客～莎希莉\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418287&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'17ac7d1c-4fc9-4864-aecf-d48692d45c0a\', \'multiverseId\': 418287}, \'multiverseid\': 418287}]', '[{\'name\': \'Saheelis Kunstfertigkeit\', \'text\': \'Bestimme eines oder beides —\\n• Erzeuge einen Spielstein, der eine Kopie eines Artefakts deiner Wahl ist.\\n• Erzeuge einen Spielstein, der eine Kopie einer Kreatur deiner Wahl ist, außer dass er zusätzlich zu seinen anderen Typen ein Artefakt ist.\', \'type\': \'Hexerei\', \'flavor\': \'„Schon bei der ersten Berührung weiß ich, was das Metall sein möchte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418427&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c274e9a2-19a0-48c1-8fc6-97622cf31f86\', \'multiverseId\': 418427}, \'multiverseid\': 418427}, {\'name\': \'Maestría de Saheeli\', \'text\': \'Elige uno o ambos:\\n• Crea una ficha que es una copia del artefacto objetivo.\\n• Crea una ficha que es una copia de la criatura objetivo, excepto que es un artefacto además de sus otros tipos.\', \'type\': \'Conjuro\', \'flavor\': \'"Sé exactamente lo que cada metal quiere ser únicamente con tocarlo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a7834f6-a01d-4737-b657-f6e6c0341541\', \'multiverseId\': 420275}, \'multiverseid\': 420275}, {\'name\': \'Art de Saheeli\', \'text\': "Choisissez l\'un ou les deux —\\n• Créez un jeton qui est une copie de l\'artefact ciblé.\\n• Créez un jeton qui est une copie de la créature ciblée, excepté que c\'est un artefact en plus de ses autres types.", \'type\': \'Rituel\', \'flavor\': "« Je sais exactement ce que le métal veut devenir dès l\'instant où je le touche. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418691&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca7dd8b8-bd53-4629-91b7-9e4f7c43ef90\', \'multiverseId\': 418691}, \'multiverseid\': 418691}, {\'name\': \'Maestria di Saheeli\', \'text\': \'Scegli uno o entrambi —\\n• Crea una pedina che è una copia di un artefatto bersaglio.\\n• Crea una pedina che è una copia di una creatura bersaglio, tranne che è un artefatto in aggiunta ai suoi altri tipi.\', \'type\': \'Stregoneria\', \'flavor\': \'"Fin dal primo tocco, capisco esattamente cosa vuole diventare il metallo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418955&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6acd39db-2c21-4e53-bb01-8ed912db9a05\', \'multiverseId\': 418955}, \'multiverseid\': 418955}, {\'name\': \'サヒーリの芸術\', \'text\': \'以下から１つまたは両方を選ぶ。\\n• アーティファクト１つを対象とし、それのコピーであるトークンを１つ生成する。\\n• クリーチャー１体を対象とし、それの他のタイプに加えてアーティファクトであることを除きそれのコピーであるトークンを１体生成する。\', \'type\': \'ソーサリー\', \'flavor\': \'「一触れすれば、その金属が何になりたがっているのかわかるわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419219&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9967eba3-2d78-4718-b3f3-5e1d70a64467\', \'multiverseId\': 419219}, \'multiverseid\': 419219}, {\'name\': \'사힐리의 기교\', \'text\': \'하나 혹은 둘 다를 선택한다 —\\n• 마법물체를 목표로 정한다. 그 마법물체의 복사본인 토큰 한 개를 만든다.\\n• 생물을 목표로 정한다. 그 생물의 복사본인 토큰 한 개를 만든다. 이 토큰은 자신의 다른 유형에 더불어 마법물체이다.\', \'type\': \'집중마법\', \'flavor\': \'"처음 손을 댄 순간부터 이 금속이 무엇이 되고 싶어 하는지 정확히 알았어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419483&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a35c5e4d-c7a3-4a4a-9dd2-66057d83416a\', \'multiverseId\': 419483}, \'multiverseid\': 419483}, {\'name\': \'Arte de Saheeli\', \'text\': \'Escolha um ou ambos —\\n• Crie uma ficha que seja uma cópia do artefato alvo.\\n• Crie uma ficha que seja uma cópia da criatura alvo, exceto que ela é um artefato além de seus outros tipos.\', \'type\': \'Feitiço\', \'flavor\': \'"Desde o primeiro toque, eu sei exatamente o que o metal quer ser."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419747&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d37da708-f060-47f9-84bd-4366f08d92bc\', \'multiverseId\': 419747}, \'multiverseid\': 419747}, {\'name\': \'Искусство Сахили\', \'text\': \'Выберите одно или оба —\\n• Создайте фишку, являющуюся копией целевого артефакта.\\n•Создайте фишку, являющуюся копией целевого существа, но при этом являющуюся артефактом в дополнение к своим другим типам.\', \'type\': \'Волшебство\', \'flavor\': \'«С первого прикосновения я ясно понимаю, чем хочет стать металл».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420011&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2e138dd0-14b8-4d3d-8ce6-ddcaea197f59\', \'multiverseId\': 420011}, \'multiverseid\': 420011}, {\'name\': \'莎希莉的技艺\', \'text\': \'选择一项或都选～\\n•派出一个衍生物，此衍生物为目标神器之复制品。\\n•派出一个衍生物，此衍生物为目标生物之复制品，但它额外具有神器此类别。\', \'type\': \'法术\', \'flavor\': \'「只要碰触一下，我就知道这金属想成为什么。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417899&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b1e8875d-77f8-46d9-bc93-58e611395b96\', \'multiverseId\': 417899}, \'multiverseid\': 417899}, {\'name\': \'莎希莉的技藝\', \'text\': \'選擇一項或都選～\\n•派出一個衍生物，此衍生物為目標神器之複製品。\\n•派出一個衍生物，此衍生物為目標生物之複製品，但它額外具有神器此類別。\', \'type\': \'巫術\', \'flavor\': \'「只要碰觸一下，我就知道這金屬想成為什麼。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418163&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4996900b-7081-4eb1-9b56-72aa079b846b\', \'multiverseId\': 418163}, \'multiverseid\': 418163}]', "[{'name': 'Sauberes Ende', 'text': 'Zerstöre eine Kreatur deiner Wahl. Du erhältst für jedes Artefakt, das du kontrollierst, 1 Lebenspunkt dazu.', 'type': 'Spontanzauber', 'flavor': 'Einem Patron der Äthergeborenen ist jedes Mittel recht, um seinen Schützlingen zum Sieg zu verhelfen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418468&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9d6a7948-435d-4a20-be09-73adfa7846e5', 'multiverseId': 418468}, 'multiverseid': 418468}, {'name': 'Final organizado', 'text': 'Destruye la criatura objetivo. Ganas 1 vida por cada artefacto que controlas.', 'type': 'Instantáneo', 'flavor': 'Los patrones etergénitos emplean todo lo que está a su alcance para que sus protegidos obtengan la victoria.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420316&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '601970bd-8f23-4215-acda-de6908e1ca77', 'multiverseId': 420316}, 'multiverseid': 420316}, {'name': 'Conclusion sans bavure', 'text': 'Détruisez une créature ciblée. Vous gagnez 1 point de vie pour chaque artefact que vous contrôlez.', 'type': 'Éphémère', 'flavor': 'Les mécènes éthériens utilisent tous les moyens nécessaires pour assurer la victoire de leurs protégés.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418732&type=card', 'language': 'French', 'identifiers': {'scryfallId': '58083d33-3b39-4d59-94b1-dbe51531fef0', 'multiverseId': 418732}, 'multiverseid': 418732}, {'name': 'Netta Conclusione', 'text': 'Distruggi una creatura bersaglio. Guadagni 1 punto vita per ogni artefatto che controlli.', 'type': 'Istantaneo', 'flavor': 'I mecenati eteridi ricorrono a qualsiasi mezzo per garantire la vittoria dei loro protetti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418996&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fd287e14-6259-42d9-8470-bd0e8b0121ef', 'multiverseId': 418996}, 'multiverseid': 418996}, {'name': '当然の結論', 'text': 'クリーチャー１体を対象とし、それを破壊する。あなたはあなたがコントロールするアーティファクト１つにつき１点のライフを得る。', 'type': 'インスタント', 'flavor': '霊基体の後援者は、自分が援助する者を勝たせるためには何でもする。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419260&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c8ac6faa-f991-41c9-9348-744854847c8a', 'multiverseId': 419260}, 'multiverseid': 419260}, {'name': '깔끔한 종결', 'text': '생물을 목표로 정한다. 그 생물을 파괴한다. 당신은 당신이 조종하는 마법물체 한 개당 생명 1점을 얻는다.', 'type': '순간마법', 'flavor': '에테르붙이 후견인은 피후견인의 승리를 위해서라면 수단과 방법을 가리지 않는다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419524&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '9cce9d98-10f4-4c10-aa96-acb554430153', 'multiverseId': 419524}, 'multiverseid': 419524}, {'name': 'Conclusão Impecável', 'text': 'Destrua a criatura alvo. Você ganha 1 ponto de vida para cada artefato que você controla.', 'type': 'Mágica Instantânea', 'flavor': 'Os patrocinadores etergênitos usam todos os meios necessários para garantir a vitória a seus protegidos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419788&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '22087d02-cd3c-4e7f-a0d6-2761ecd55af3', 'multiverseId': 419788}, 'multiverseid': 419788}, {'name': 'Чистое Устранение', 'text': 'Уничтожьте целевое существо. Вы получаете 1 жизнь за каждый артефакт под вашим контролем.', 'type': 'Мгновенное заклинание', 'flavor': 'Эфириды-покровители не гнушаются никакими средствами, чтобы гарантировать победу своим протеже.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420052&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ee4edf1f-d0f9-4697-a8be-429b72aec03d', 'multiverseId': 420052}, 'multiverseid': 420052}, {'name': '收拾残局', 'text': '消灭目标生物。你每操控一个神器，便获得1点生命。', 'type': '瞬间', 'flavor': '乙太种的主人会用尽一切必要手段确保其门徒获胜。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417940&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0a6d3623-ddeb-4659-a397-93c136757957', 'multiverseId': 417940}, 'multiverseid': 417940}, {'name': '收拾殘局', 'text': '消滅目標生物。你每操控一個神器，便獲得1點生命。', 'type': '瞬間', 'flavor': '乙太種的主人會用盡一切必要手段確保其門徒獲勝。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418204&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'afbfe924-b035-49d0-b9ef-671fa9f14cc5', 'multiverseId': 418204}, 'multiverseid': 418204}]", '[{\'name\': \'Schaltknüppel-Ass\', \'text\': \'Erstschlag\\nImmer wenn das Schaltknüppel-Ass ein Fahrzeug bemannt, erhält das Fahrzeug Erstschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zwerg, Pilot\', \'flavor\': \'Manche stellen ihre Trophäen in den Hallen der Mechaniker zur Schau. Andere ihr Können in den Straßen von Ghirapur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418381&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f2c2c4b-f9de-41cb-af4f-36b1ea359a63\', \'multiverseId\': 418381}, \'multiverseid\': 418381}, {\'name\': \'Cambiamarchas experto\', \'text\': \'Daña primero.\\nSiempre que el Cambiamarchas experto tripule un Vehículo, ese Vehículo gana la habilidad de dañar primero hasta el final del turno.\', \'type\': \'Criatura — Enano piloto\', \'flavor\': \'Algunos exponen sus trofeos en el Salón de los Mecánicos. Otros prefieren exhibir su talento en las calles de Ghirapur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420229&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9c6bb3a4-524d-4476-b3a7-f342ebf32462\', \'multiverseId\': 420229}, \'multiverseid\': 420229}, {\'name\': \'As de la boîte de vitesse\', \'text\': "Initiative\\nÀ chaque fois que l\'As de la boîte de vitesse pilote un véhicule, ce véhicule acquiert l\'initiative jusqu\'à la fin du tour.", \'type\': \'Créature : nain et pilote\', \'flavor\': "Certains exposent leurs trophées dans le Hall des mécanistes. D\'autres exposent leur talent dans les rues de Ghirapur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a707dca3-9925-43a1-b32f-e84f9cbda897\', \'multiverseId\': 418645}, \'multiverseid\': 418645}, {\'name\': \'Campione del Cambio\', \'text\': \'Attacco improvviso\\nOgniqualvolta il Campione del Cambio manovra un Veicolo, quel Veicolo ha attacco improvviso fino alla fine del turno.\', \'type\': \'Creatura — Pilota Nano\', \'flavor\': \'Alcuni mettono in mostra i propri trofei nella Sala dei Meccanisti. Altri dimostrano il proprio talento sulle strade di Ghirapur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418909&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'18b7a795-7795-4430-9d01-0415dc286e4d\', \'multiverseId\': 418909}, \'multiverseid\': 418909}, {\'name\': \'変速の名手\', \'text\': \'先制攻撃\\n変速の名手が機体１つに搭乗するたび、ターン終了時まで、その機体は先制攻撃を得る。\', \'type\': \'クリーチャー — ドワーフ・操縦士\', \'flavor\': \'機体技師の殿堂に戦果が展示される者もいる。ギラプールの街路で才能を示す者もいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419173&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1885e05c-c8c8-4fb0-a043-67332ea9f434\', \'multiverseId\': 419173}, \'multiverseid\': 419173}, {\'name\': \'길거리 경주 에이스\', \'text\': \'선제공격\\n길거리 경주 에이스가 탑승물에 탑승할 때마다, 그 탑승물은 턴종료까지 선제공격을 얻는다.\', \'type\': \'생물 — 드워프 조종사\', \'flavor\': \'어떤 이는 기계공의 전당에 자신의 트로피를 전시하고, 어떤 이는 기라푸르의 거리에서 자신의 실력을 입증한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419437&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d2fa284b-abbd-4f42-a4a4-231617700cf1\', \'multiverseId\': 419437}, \'multiverseid\': 419437}, {\'name\': \'Ás das Marchas\', \'text\': \'Iniciativa\\nToda vez que Ás das Marchas tripula um Veículo, aquele Veículo ganha iniciativa até o final do turno.\', \'type\': \'Criatura — Anão Piloto\', \'flavor\': \'Alguns exibem seus troféus no Salão dos Mecanistas. Outros exibem seu talento nas ruas de Ghirapur.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419701&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6dfb3a2c-c789-434a-86ab-b7e927aca3ef\', \'multiverseId\': 419701}, \'multiverseid\': 419701}, {\'name\': \'Опытный Лихач\', \'text\': \'Первый удар\\nКаждый раз, когда Опытный Лихач входит в Экипаж Машины, та Машина получает Первый удар до конца хода.\', \'type\': \'Существо — Гном Пилот\', \'flavor\': \'Одни демонстрируют свои трофеи в Зале Механиков. Другие демонстрируют свои таланты на улицах Гирапура.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419965&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bec3dd06-b5f2-4507-9db6-b7f4a7c5814e\', \'multiverseId\': 419965}, \'multiverseid\': 419965}, {\'name\': \'变速高手\', \'text\': \'先攻\\n每当变速高手搭载载具时，该载具获得先攻异能直到回合结束。\', \'type\': \'生物～矮人／驾手\', \'flavor\': \'有些人在技师名人堂展示自己的奖杯。有些人在吉拉波街头展现自己的才华。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417853&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5ace673-e6e6-4ec7-a6c2-3ab99eed5865\', \'multiverseId\': 417853}, \'multiverseid\': 417853}, {\'name\': \'變速高手\', \'text\': \'先攻\\n每當變速高手搭載載具時，該載具獲得先攻異能直到回合結束。\', \'type\': \'生物～矮人／駕手\', \'flavor\': \'有些人在技師名人堂展示自己的獎盃。有些人在吉拉波街頭展現自己的才華。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418117&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'336d3212-57bf-458a-8099-5079dc0138ef\', \'multiverseId\': 418117}, \'multiverseid\': 418117}]', '[{\'name\': \'Schicksalsträchtige Machtprobe\', \'text\': \'Die Schicksalsträchtige Machtprobe fügt einer Kreatur oder einem Spieler deiner Wahl so viele Schadenspunkte zu, wie du Karten auf deiner Hand hast. Wirf alle Karten aus deiner Hand ab und ziehe dann entsprechend viele Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'Bezeugt heute Abend bei der Großen Ausstellung das Aufeinandertreffen vom Obersten Preisrichter Tezzeret und der berüchtigten Renegatin Pia Nalaar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418479&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6800370e-92a8-4592-863c-77a8bbbe13b4\', \'multiverseId\': 418479}, \'multiverseid\': 418479}, {\'name\': \'Enfrentamiento fatídico\', \'text\': \'El Enfrentamiento fatídico hace una cantidad de daño a la criatura o jugador objetivo igual a la cantidad de cartas en tu mano. Descarta todas las cartas en tu mano, luego roba esa misma cantidad de cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'Hoy, en la Gran Exhibición, veremos al juez principal Tezzeret enfrentarse a la famosa renegada Pia Nalaar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420327&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eee79cda-91b0-47a6-ac22-b45b9d769de4\', \'multiverseId\': 420327}, \'multiverseid\': 420327}, {\'name\': \'Confrontation fatidique\', \'text\': \'La Confrontation fatidique inflige à une cible, créature ou joueur, un nombre de blessures égal au nombre de cartes dans votre main. Défaussez-vous de toutes les cartes de votre main, puis piochez autant de cartes.\', \'type\': \'Éphémère\', \'flavor\': "Ce soir, à la Grande Exposition, assistez à l\'affrontement entre Tezzeret, le grand juge, et la renégate notoire, Pia Nalaàr.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418743&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5786b2e0-ba04-49a3-a2d5-876b094067b4\', \'multiverseId\': 418743}, \'multiverseid\': 418743}, {\'name\': \'Confronto Fatidico\', \'text\': \'Il Confronto Fatidico infligge a una creatura o a un giocatore bersaglio danno pari al numero di carte nella tua mano. Scarta tutte le carte della tua mano, poi pesca altrettante carte.\', \'type\': \'Istantaneo\', \'flavor\': \'Questa sera, durante la Grande Esibizione, potrete ammirare il giudice capo Tezzeret che affronta la famigerata rinnegata Pia Nalaar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419007&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3bae5b33-6d4d-4e36-a504-4fc814991066\', \'multiverseId\': 419007}, \'multiverseid\': 419007}, {\'name\': \'宿命の決着\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。宿命の決着はそれに、あなたの手札にあるカードの枚数に等しい点数のダメージを与える。あなたの手札にあるカードをすべて捨て、その後その枚数に等しい枚数のカードを引く。\', \'type\': \'インスタント\', \'flavor\': \'今宵、大展示場にて、審判長テゼレットと悪名高い改革派ピア・ナラーの対決をご覧ください。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419271&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc9c953e-69fc-4e0d-823d-6f2551f1cf70\', \'multiverseId\': 419271}, \'multiverseid\': 419271}, {\'name\': \'운명적 대결\', \'text\': \'생물이나 플레이어를 목표로 정한다. 운명적 대결은 그 목표에게 당신의 손에 있는 카드 수만큼 피해를 입힌다. 당신의 손에 있는 모든 카드를 버린 후, 버린 카드의 수만큼 카드를 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'오늘 밤 대전시회장에서 주심 테제렛과 악명 높은 무법자 피아 날라르가 펼치는 대결을 관전하십시오.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419535&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b90a3498-b5ee-4344-b047-f2dbfc4a0672\', \'multiverseId\': 419535}, \'multiverseid\': 419535}, {\'name\': \'Confronto Fatídico\', \'text\': \'Confronto Fatídico causa uma quantidade de dano à criatura ou ao jogador alvo igual ao número de cards em sua mão. Descarte todos os cards em sua mão e depois compre uma quantidade equivalente de cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Hoje à noite, na Grande Exposição, veja o Jurado Mor Tezzeret enfrentar a infame renegada Pia Nalaar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419799&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38f08f31-4947-4465-9a7a-3b0ec81fc6c6\', \'multiverseId\': 419799}, \'multiverseid\': 419799}, {\'name\': \'Судьбоносная Схватка\', \'text\': \'Судьбоносная Схватка наносит целевому существу или игроку повреждения, равные количеству карт в вашей руке. Сбросьте все карты в вашей руке, затем возьмите столько же карт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Только сегодня на Большой Выставке! Приходите посмотреть, как главный судья Теззерет сразится с закоренелой отступницей Пией Налаар!\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420063&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb6178a5-ba98-466f-baa3-4cc7909b0400\', \'multiverseId\': 420063}, \'multiverseid\': 420063}, {\'name\': \'宿命对决\', \'text\': \'宿命对决对目标生物或牌手造成等同于你手牌数量的伤害。弃掉你的手牌，然后抓等量的牌。\', \'type\': \'瞬间\', \'flavor\': \'在今晚的盛大展演中，亲眼见证主审泰兹瑞正面迎战恶名昭彰的乱匠琵雅纳拉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417951&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'945ed630-f42c-4222-9067-c2bd90d6327e\', \'multiverseId\': 417951}, \'multiverseid\': 417951}, {\'name\': \'宿命對決\', \'text\': \'宿命對決對目標生物或玩家造成等同於你手牌數量的傷害。棄掉你的手牌，然後抽等量的牌。\', \'type\': \'瞬間\', \'flavor\': \'在今晚的盛大展演中，親眼見證主審泰茲瑞正面迎戰惡名昭彰的亂匠琵雅納拉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418215&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'776fa8b7-efcf-4476-bf5f-415a8ebfa9d4\', \'multiverseId\': 418215}, \'multiverseid\': 418215}]', '[{\'name\': \'Schieber des Syndikats\', \'text\': \'{1}, opfere ein Artefakt: Lege eine +1/+1-Marke auf den Schieber des Syndikats. Er erhält Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Äthergeborener, Räuber\', \'flavor\': \'„Der Preis ist nicht verhandelbar, aber du stimmst mir sicher zu, dass er angemessen ist."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418466&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f3b0e85-cbf4-469a-8e11-d6cf5638309c\', \'multiverseId\': 418466}, \'multiverseid\': 418466}, {\'name\': \'Traficante del cártel\', \'text\': \'{1}, sacrificar un artefacto: Pon un contador +1/+1 sobre el Traficante del cártel. Gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura — Bribón etergénito\', \'flavor\': \'"El precio no es negociable, pero estarás de acuerdo en que es justo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420314&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'28fc8d39-2841-485e-9205-883055452cfe\', \'multiverseId\': 420314}, \'multiverseid\': 420314}, {\'name\': \'Trafiquant du syndicat\', \'text\': "{1}, sacrifiez un artefact : Mettez un marqueur +1/+1 sur le Trafiquant du syndicat. Il acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature : éthérien et gredin\', \'flavor\': "« Le prix n\'est pas négociable, mais je suis sûr que vous le trouverez honnête. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418730&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b7e98b1-d422-4ebc-b6b3-d04630a54d57\', \'multiverseId\': 418730}, \'multiverseid\': 418730}, {\'name\': \'Trafficante del Sindacato\', \'text\': \'{1}, Sacrifica un artefatto: Metti un segnalino +1/+1 sul Trafficante del Sindacato. Ha indistruttibile fino alla fine del turno.\', \'type\': \'Creatura — Farabutto Eteride\', \'flavor\': \'"Il prezzo non è trattabile, ma sono certo che lo troverete equo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0853021-b2f1-4cd6-9e47-54801d4e5246\', \'multiverseId\': 418994}, \'multiverseid\': 418994}, {\'name\': \'組織の密売人\', \'text\': \'{1}, アーティファクト１つを生け贄に捧げる：組織の密売人の上に＋１/＋１カウンターを１個置く。ターン終了時まで、これは破壊不能を得る。\', \'type\': \'クリーチャー — 霊基体・ならず者\', \'flavor\': \'「値引きには応じない。これはまったく公正な価格だ。そうだろ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419258&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'65a5f6f9-829e-4d0c-9517-6ed8f3a4ff81\', \'multiverseId\': 419258}, \'multiverseid\': 419258}, {\'name\': \'비밀조직 암상인\', \'text\': \'{1}, 마법물체 한 개를 희생한다: 비밀조직 암상인에 +1/+1 카운터 한 개를 올려놓는다. 비밀조직 암상인은 턴종료까지 무적을 얻는다.\', \'type\': \'생물 — 에테르붙이 도적\', \'flavor\': \'"가격에는 협상의 여지가 없지만, 적정한 가격이라는 것에는 동의하실 겁니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419522&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'46cf7d61-a459-44ff-ba65-f1292766a84b\', \'multiverseId\': 419522}, \'multiverseid\': 419522}, {\'name\': \'Traficante do Sindicato\', \'text\': \'{1}, Sacrifique um artefato: Coloque um marcador +1/+1 em Traficante do Sindicato. Ele ganha indestrutível até o final do turno.\', \'type\': \'Criatura — Etergênito Ladino\', \'flavor\': \'"O preço não é negociável, mas eu tenho certeza de que você vai concordar que é justo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419786&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0aaafba-420e-4e74-8f03-46f162b39b59\', \'multiverseId\': 419786}, \'multiverseid\': 419786}, {\'name\': \'Негоциант Синдиката\', \'text\': \'{1}, пожертвуйте артефакт: положите один жетон +1/+1 на Негоцианта Синдиката. Он получает Неразрушимость до конца хода.\', \'type\': \'Существо — Эфирид Бродяга\', \'flavor\': \'«Цена не обсуждается. Впрочем, не сомневаюсь, что вы согласитесь с тем, что она честная».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420050&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4ca724c-9591-4358-8ec2-d31279023163\', \'multiverseId\': 420050}, \'multiverseid\': 420050}, {\'name\': \'集团私贩\', \'text\': \'{1}，牺牲一个神器：在集团私贩上放置一个+1/+1指示物。它获得不灭异能直到回合结束。\', \'type\': \'生物～乙太种／浪客\', \'flavor\': \'「这价钱没得谈，我想你会同意它很公道。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417938&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'27994416-af8f-422b-b831-74b8d13c524f\', \'multiverseId\': 417938}, \'multiverseid\': 417938}, {\'name\': \'集團私販\', \'text\': \'{1}，犧牲一個神器：在集團私販上放置一個+1/+1指示物。它獲得不滅異能直到回合結束。\', \'type\': \'生物～乙太種／浪客\', \'flavor\': \'「這價錢沒得談，我想你會同意它很公道。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418202&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'27c80b7f-300b-410a-8839-cd1832ad2a5a\', \'multiverseId\': 418202}, \'multiverseid\': 418202}]', '[{\'name\': \'Schildwache des Konsuls\', \'text\': \'Wenn die Schildwache des Konsuls ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn die Schildwache des Konsuls angreift, kannst du {E} bezahlen. Falls du dies tust, erhält eine andere angreifende Kreatur deiner Wahl Unzerstörbarkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zwerg, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418376&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'67b31d1b-e281-4e38-a037-e9dfae9ca5be\', \'multiverseId\': 418376}, \'multiverseid\': 418376}, {\'name\': \'Cortescudo del cónsul\', \'text\': \'Cuando el Cortescudo del cónsul entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que el Cortescudo del cónsul ataque, puedes pagar {E}. Si lo haces, otra criatura atacante objetivo gana la habilidad de indestructible hasta el final del turno.\', \'type\': \'Criatura — Enano soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420224&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06976f58-0bbd-4a85-a0b8-ceb48aee3683\', \'multiverseId\': 420224}, \'multiverseid\': 420224}, {\'name\': \'Gardebouclier du consul\', \'text\': "Quand le Gardebouclier du consul arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que le Gardebouclier du consul attaque, vous pouvez payer {E}. Si vous faites ainsi, une autre créature attaquante ciblée acquiert l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Créature : nain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418640&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ecee8ae-2ddf-46c8-8626-471dd523e460\', \'multiverseId\': 418640}, \'multiverseid\': 418640}, {\'name\': \'Guardiascudo del Console\', \'text\': "Quando il Guardiascudo del Console entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta il Guardiascudo del Console attacca, puoi pagare {E}. Se lo fai, un\'altra creatura attaccante bersaglio ha indistruttibile fino alla fine del turno.", \'type\': \'Creatura — Soldato Nano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418904&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c798c5c-ecce-47ff-8d48-29f0279778ba\', \'multiverseId\': 418904}, \'multiverseid\': 418904}, {\'name\': \'領事の盾護員\', \'text\': \'領事の盾護員が戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n領事の盾護員が攻撃するたび、他の攻撃クリーチャー１体を対象とする。あなたは{E}を支払ってもよい。そうしたなら、ターン終了時まで、それは破壊不能を得る。\', \'type\': \'クリーチャー — ドワーフ・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419168&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f5de53e-e2d6-4e03-818e-de409bffe4a5\', \'multiverseId\': 419168}, \'multiverseid\': 419168}, {\'name\': \'영사의 방패경비대\', \'text\': \'영사의 방패경비대가 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n영사의 방패경비대가 공격할 때마다, 당신은 {E}를 지불할 수 있다. 그렇게 한다면, 다른 공격생물을 목표로 정한다. 그 생물은 턴종료까지 무적을 얻는다.\', \'type\': \'생물 — 드워프 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419432&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ff81f44e-21d5-4a2b-84a0-23036e776887\', \'multiverseId\': 419432}, \'multiverseid\': 419432}, {\'name\': \'Guarda Escudo do Cônsul\', \'text\': \'Quando Guarda Escudo do Cônsul entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Guarda Escudo do Cônsul ataca, você pode pagar {E}. Se fizer isso, outra criatura atacante alvo ganha indestrutível até o final do turno.\', \'type\': \'Criatura — Anão Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419696&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'913df034-0ab2-4e29-84fc-6daa4479fd2a\', \'multiverseId\': 419696}, \'multiverseid\': 419696}, {\'name\': \'Щитоносец Консула\', \'text\': \'Когда Щитоносец Консула выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Щитоносец Консула атакует, вы можете заплатить {E}. Если вы это делаете, другое целевое атакующее существо получает Неразрушимость до конца хода.\', \'type\': \'Существо — Гном Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419960&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed392e1f-3c3a-41bf-8321-706c476dc1ad\', \'multiverseId\': 419960}, \'multiverseid\': 419960}, {\'name\': \'执政官盾卫\', \'text\': \'当执政官盾卫进战场时，你得到{E}{E}（两个能量指示物）。\\n每当执政官盾卫攻击时，你可以支付{E}。若你如此作，则另一个目标进行攻击的生物获得不灭异能直到回合结束。\', \'type\': \'生物～矮人／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417848&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d9ee85b7-a54b-4336-be09-6b2df5ec12a6\', \'multiverseId\': 417848}, \'multiverseid\': 417848}, {\'name\': \'執政官盾衛\', \'text\': \'當執政官盾衛進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當執政官盾衛攻擊時，你可以支付{E}。若你如此作，則另一個目標進行攻擊的生物獲得不滅異能直到回合結束。\', \'type\': \'生物～矮人／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418112&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7230e317-2b80-4a3f-aecb-34c11364e098\', \'multiverseId\': 418112}, \'multiverseid\': 418112}]', '[{\'name\': \'Schleichender Schimmel\', \'text\': \'Zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Sanktionen, Mandate, Vorschriften … Diese Dinge bedeuten der Natur nichts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418515&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1b10d79-b8fc-4e9e-ac3b-ce652ea0164d\', \'multiverseId\': 418515}, \'multiverseid\': 418515}, {\'name\': \'Moho reptante\', \'text\': \'Destruye el artefacto, encantamiento o tierra objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'Sanciones, mandatos, regulaciones... Todo eso no significa nada para la naturaleza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420363&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7c924d70-b9e3-4247-830b-7bb2379509c1\', \'multiverseId\': 420363}, \'multiverseid\': 420363}, {\'name\': \'Moisissure rampante\', \'text\': "Détruisez l\'artefact ciblé, l\'enchantement ciblé ou le terrain ciblé.", \'type\': \'Rituel\', \'flavor\': "Sanctions, mandats, réglementations... Tout cela n\'a aucun sens aux yeux du monde naturel.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418779&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3d9bf82-e95a-47f0-8b75-cd994a91f49a\', \'multiverseId\': 418779}, \'multiverseid\': 418779}, {\'name\': \'Muffa Insidiosa\', \'text\': \'Distruggi un artefatto, un incantesimo o una terra bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'Sanzioni, mandati, regolamenti... Queste parole non hanno significato per la natura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419043&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2f3da94-ab4e-46cd-824f-b77c6cc3c57d\', \'multiverseId\': 419043}, \'multiverseid\': 419043}, {\'name\': \'忍び寄るカビ\', \'text\': \'アーティファクト１つかエンチャント１つか土地１つを対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'制裁、指令、規制……。自然界はその種のことに関心がない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419307&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'960a8c4e-ce30-4f35-a8e4-0bc21db37528\', \'multiverseId\': 419307}, \'multiverseid\': 419307}, {\'name\': \'기어다니는 곰팡이\', \'text\': \'마법물체, 부여마법 또는 대지를 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'집중마법\', \'flavor\': \'제재, 칙령, 규정. . . 이런 것은 자연계에서 아무런 의미도 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419571&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'28a996a7-8f5b-488d-bfa5-5f8d2ba90257\', \'multiverseId\': 419571}, \'multiverseid\': 419571}, {\'name\': \'Bolor Invasor\', \'text\': \'Destrua o artefato, encantamento ou terreno alvo.\', \'type\': \'Feitiço\', \'flavor\': \'Sanções, mandados, regulamentos... Essas coisas não significam nada para o mundo natural.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419835&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f4a22ac-b864-4c35-8697-9895e232b142\', \'multiverseId\': 419835}, \'multiverseid\': 419835}, {\'name\': \'Ползучая Плесень\', \'text\': \'Уничтожьте целевой артефакт, чары или землю.\', \'type\': \'Волшебство\', \'flavor\': \'Санкции, запреты, нормативы... Для мира природы эти слова ничего не значат.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420099&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7cfc3c21-f163-425b-b4ee-fe49fb4121a6\', \'multiverseId\': 420099}, \'multiverseid\': 420099}, {\'name\': \'爬行腐霉\', \'text\': \'消灭目标神器，结界或地。\', \'type\': \'法术\', \'flavor\': \'制裁、命令、法规. . .这些事物于自然界而言毫无意义。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417987&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec9669b1-cfd9-47fb-bb67-606733dbeebf\', \'multiverseId\': 417987}, \'multiverseid\': 417987}, {\'name\': \'爬行腐霉\', \'text\': \'消滅目標神器，結界或地。\', \'type\': \'巫術\', \'flavor\': \'制裁、命令、法規. . .這些事物於自然界而言毫無意義。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418251&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'75cfc903-acc5-468d-b954-c7469b71a1d3\', \'multiverseId\': 418251}, \'multiverseid\': 418251}]', '[{\'name\': \'Schlingen-Thopter\', \'text\': \'Fliegend, Eile\', \'type\': \'Artefaktkreatur — Thopter\', \'flavor\': \'„Ich hätte nicht gedacht, dass ich die kalten, filigranen Kreaturen dieser Welt verstehen würde, doch auch sie gehorchen den Naturgesetzen." —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70e5b1f8-d8c6-41c5-b254-f83e8decd6e7\', \'multiverseId\': 418601}, \'multiverseid\': 418601}, {\'name\': \'Tóptero cazador\', \'text\': \'Vuela, prisa.\', \'type\': \'Criatura artefacto — Tóptero\', \'flavor\': \'"No creí que pudiera entender a las frías criaturas de filigrana de este mundo, pero ellas también están gobernadas por las leyes de la naturaleza". —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420449&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2d29cfd-2843-43c3-91c9-a7464747f9ad\', \'multiverseId\': 420449}, \'multiverseid\': 420449}, {\'name\': \'Mécanoptère piégeur\', \'text\': \'Vol, célérité\', \'type\': \'Créature-artefact : mécanoptère\', \'flavor\': \'« Je ne pensais pas pouvoir comprendre les froides créatures de filigrane de ce monde, mais elles aussi sont régies par les lois de la nature. » —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418865&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec1d820f-0109-45cb-8ec5-faaaab26ac98\', \'multiverseId\': 418865}, \'multiverseid\': 418865}, {\'name\': \'Tottero Intrappolante\', \'text\': \'Volare, rapidità\', \'type\': \'Creatura Artefatto — Tottero\', \'flavor\': \'"Credevo che non avrei capito le fredde creature di filigrana di questo mondo, ma anch\\\'esse sono governate dalle leggi della natura." —Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419129&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2ee16141-65fb-4695-b5ad-711b1ee7acd7\', \'multiverseId\': 419129}, \'multiverseid\': 419129}, {\'name\': \'捕獲飛行機械\', \'text\': \'飛行、速攻\', \'type\': \'アーティファクト・クリーチャー — 飛行機械\', \'flavor\': \'「この世界にいる冷たい金線条細工の動物を理解できるとは思っていなかったけれど、結局みな自然の法則に従っているのね。」 ――ニッサ・レヴェイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419393&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb047103-91e9-428c-9005-b005e1b6f974\', \'multiverseId\': 419393}, \'multiverseid\': 419393}, {\'name\': \'올가미 날틀\', \'text\': \'비행, 신속\', \'type\': \'마법물체 생물 — 날틀\', \'flavor\': \'"칼라데시에 있는 금속 줄세공 생물들을 이해할 수 없을 것 같았지. 하지만 그들도 역시 자연의 법칙을 따르고 있어." —니사 레베인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419657&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'570e49c3-6439-4d76-bfa3-da44b78ce76b\', \'multiverseId\': 419657}, \'multiverseid\': 419657}, {\'name\': \'Tóptero de Captura\', \'text\': \'Voar, ímpeto\', \'type\': \'Criatura Artefato — Tóptero\', \'flavor\': \'"Não achei que entenderia as frias criaturas filigranadas deste mundo, mas elas também são regidas pelas leis da natureza." — Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419921&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87963e98-65d2-4ae3-9b18-212afdd1c4be\', \'multiverseId\': 419921}, \'multiverseid\': 419921}, {\'name\': \'Ловчий Топтер\', \'text\': \'Полет, Ускорение\', \'type\': \'Артефакт Существо — Топтер\', \'flavor\': \'«Я не думала, что смогу понять холодных механических созданий этого мира, но ими тоже управляют законы природы». — Нисса Ревейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420185&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ca17df02-0476-4c00-aa80-da9f4372d8cc\', \'multiverseId\': 420185}, \'multiverseid\': 420185}, {\'name\': \'圈套振翼机\', \'text\': \'飞行，敏捷\', \'type\': \'神器生物～振翼机\', \'flavor\': \'「虽然我无法理解这世界的冰冷丝金生物，但它们也同样遵循自然规律。」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1630fecf-6ad6-4d08-80a2-96323ec92ea1\', \'multiverseId\': 418073}, \'multiverseid\': 418073}, {\'name\': \'圈套振翼機\', \'text\': \'飛行，敏捷\', \'type\': \'神器生物～振翼機\', \'flavor\': \'「雖然我無法理解這世界的冰冷絲金生物，但它們也同樣遵循自然規律。」 ～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418337&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4f75ea2e-af43-48e5-b368-d6ea48ec81a9\', \'multiverseId\': 418337}, \'multiverseid\': 418337}]', '[{\'name\': \'Schlüssel zur Stadt\', \'text\': \'{T}, wirf eine Karte ab: Bis zu eine Kreatur deiner Wahl kann in diesem Zug nicht geblockt werden.\\nImmer wenn der Schlüssel zur Stadt enttappt wird, kannst du {2} bezahlen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Es wäre ein Unglück, würde der Schlüssel in die falschen Hände gelangen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418585&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60f2b842-522f-4fc9-8ba2-bea467a9ebec\', \'multiverseId\': 418585}, \'multiverseid\': 418585}, {\'name\': \'Llave de la ciudad\', \'text\': \'{T}, descartar una carta: Hasta una criatura objetivo no puede ser bloqueada este turno.\\nSiempre que la Llave de la ciudad se enderece, puedes pagar {2}. Si lo haces, roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Sería una pena que la llave cayese en las manos equivocadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420433&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'714a76c6-0441-49da-b6c0-401200fbffae\', \'multiverseId\': 420433}, \'multiverseid\': 420433}, {\'name\': \'Clé de la ville\', \'text\': "{T}, défaussez-vous d\'une carte : Jusqu\'à une créature ciblée ne peut pas être bloquée ce tour-ci.\\nÀ chaque fois que la Clé de la ville devient dégagée, vous pouvez payer {2}. Si vous faites ainsi, piochez une carte.", \'type\': \'Artefact\', \'flavor\': \'Il serait fâcheux que cette clé tombe entre de mauvaises mains.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418849&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2973cff1-e0ea-4b75-b9c7-0dc4688df974\', \'multiverseId\': 418849}, \'multiverseid\': 418849}, {\'name\': \'Chiave della Città\', \'text\': \'{T}, Scarta una carta: Fino a una creatura bersaglio non può essere bloccata in questo turno.\\nOgniqualvolta la Chiave della Città viene STAPpata, puoi pagare {2}. Se lo fai, pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': \'Sarebbe spiacevole se la chiave finisse nelle mani sbagliate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419113&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c56f00b0-2191-44e2-8684-42ef0a0a90af\', \'multiverseId\': 419113}, \'multiverseid\': 419113}, {\'name\': \'街の鍵\', \'text\': \'{T}, カード１枚を捨てる：クリーチャーを最大１体対象とする。このターン、それはブロックされない。\\n街の鍵がアンタップ状態になるたび、あなたは{2}を支払ってもよい。そうしたなら、カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'この鍵が悪者の手に渡ったら大変なことになる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419377&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b27acb2-b1de-4183-b40a-9b8d735aa666\', \'multiverseId\': 419377}, \'multiverseid\': 419377}, {\'name\': \'도시로 통하는 열쇠\', \'text\': \'{T}, 카드 한 장을 버린다: 생물을 최대 한 개까지 목표로 정한다. 그 생물은 이 턴에 방어될 수 없다.\\n도시로 통하는 열쇠가 언탭될 때마다, 당신은 {2}를 지불할 수 있다. 그렇게 한다면, 카드 한 장을 뽑는다.\', \'type\': \'마법물체\', \'flavor\': \'열쇠가 악당의 손에 들어간다면 큰 문제가 될 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419641&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'455db6ca-e7b6-4339-ab05-e6ee10894d5f\', \'multiverseId\': 419641}, \'multiverseid\': 419641}, {\'name\': \'Chave da Cidade\', \'text\': \'{T}, Descarte um card: Até uma criatura alvo não pode ser bloqueada neste turno.\\nToda vez que Chave da Cidade é desvirada, você pode pagar {2}. Se fizer isso, compre um card.\', \'type\': \'Artefato\', \'flavor\': \'Seria uma pena se a chave caísse nas mãos erradas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419905&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e21d1f1-aef3-48fa-a955-540a151f96df\', \'multiverseId\': 419905}, \'multiverseid\': 419905}, {\'name\': \'Ключ от Города\', \'text\': \'{T}, сбросьте карту: до одного целевого существа не может быть заблокировано в этом ходу.\\nКаждый раз, когда Ключ от Города разворачивается, вы можете заплатить {2}. Если вы это делаете, возьмите карту.\', \'type\': \'Артефакт\', \'flavor\': \'Страшно подумать, что случится, если этот ключ попадет не в те руки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420169&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9e825768-07d1-4fef-aef6-beebb6a0255e\', \'multiverseId\': 420169}, \'multiverseid\': 420169}, {\'name\': \'入城钥匙\', \'text\': \'{T}，弃一张牌：至多一个目标生物本回合不能被阻挡。\\n每当入城钥匙成为未横置时，你可以支付{2}。若你如此作，则抓一张牌。\', \'type\': \'神器\', \'flavor\': \'钥匙要落入不法之徒手中，那就糟了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418057&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba39c9bc-5d9b-47d7-9c7b-1341088c2e3c\', \'multiverseId\': 418057}, \'multiverseid\': 418057}, {\'name\': \'入城鑰匙\', \'text\': \'{T}，棄一張牌：至多一個目標生物本回合不能被阻擋。\\n每當入城鑰匙成為未橫置時，你可以支付{2}。若你如此作，則抽一張牌。\', \'type\': \'神器\', \'flavor\': \'鑰匙要落入不法之徒手中，那就糟了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418321&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'fc7c588b-3392-494f-b068-9636a2c0c3a1\', \'multiverseId\': 418321}, \'multiverseid\': 418321}]', '[{\'name\': \'Schmuggler-Boss\', \'text\': \'Lebensverknüpfung\\nImmer wenn ein Artefakt unter deiner Kontrolle ins Spiel kommt, wende Hellsicht 1 an.\', \'type\': \'Kreatur — Äthergeborener, Räuber\', \'flavor\': \'„Verschwende nicht meine Zeit mit Kleinigkeiten. Bring mir Kunstwerke und ich mache dich reich."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418542&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a46be29e-d302-4952-9a7a-6dc72df18816\', \'multiverseId\': 418542}, \'multiverseid\': 418542}, {\'name\': \'Líder de los contrabandistas\', \'text\': \'Vínculo vital.\\nSiempre que un artefacto entre al campo de batalla bajo tu control, adivina 1.\', \'type\': \'Criatura — Bribón etergénito\', \'flavor\': \'"No me hagas perder el tiempo con nimiedades. Tráeme obras de arte y te colmaré de riquezas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420390&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d3976d31-c3be-4343-a149-a45654f9e6a7\', \'multiverseId\': 420390}, \'multiverseid\': 420390}, {\'name\': \'Baron de la contrebande\', \'text\': "Lien de vie\\nÀ chaque fois qu\'un artefact arrive sur le champ de bataille sous votre contrôle, regard 1.", \'type\': \'Créature : éthérien et gredin\', \'flavor\': "« Ne me faites pas perdre mon temps avec des broutilles. Apportez-moi des œuvres d\'art et je vous rendrai riche. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418806&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6a0a74d-21f5-4a7a-9c26-9bd38428cbfa\', \'multiverseId\': 418806}, \'multiverseid\': 418806}, {\'name\': \'Re del Contrabbando\', \'text\': \'Legame vitale\\nOgniqualvolta un artefatto entra nel campo di battaglia sotto il tuo controllo, profetizza 1.\', \'type\': \'Creatura — Farabutto Eteride\', \'flavor\': \'"Non farmi perdere tempo con queste bazzecole. Portami dei capolavori e ti renderò ricco."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419070&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'96694ed4-8604-4b71-8d6c-b3c207e58f11\', \'multiverseId\': 419070}, \'multiverseid\': 419070}, {\'name\': \'禁制品の黒幕\', \'text\': \'絆魂\\nアーティファクトが１つあなたのコントロール下で戦場に出るたび、占術１を行う。\', \'type\': \'クリーチャー — 霊基体・ならず者\', \'flavor\': \'「くだらん物で俺の時間を無駄にするな。芸術品を持って来い。そうすりゃ金持ちにしてやる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419334&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fffab4b0-c067-4a05-84ca-e45bc5c92d44\', \'multiverseId\': 419334}, \'multiverseid\': 419334}, {\'name\': \'밀수꾼 두목\', \'text\': \'생명연결\\n마법물체가 당신의 조종하에 전장에 들어올 때마다, 점술 1을 한다.\', \'type\': \'생물 — 에테르붙이 도적\', \'flavor\': \'"사소한 일로 내 시간을 낭비하지 마라. 예술품을 가져오면 널 부자로 만들어 주지."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419598&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5b604469-0825-4c77-b2d0-ca8f627d7161\', \'multiverseId\': 419598}, \'multiverseid\': 419598}, {\'name\': \'Chefão do Contrabando\', \'text\': \'Vínculo com a vida\\nToda vez que um artefato entrar no campo de batalha sob seu controle, use vidência 1.\', \'type\': \'Criatura — Etergênito Ladino\', \'flavor\': \'"Não desperdice meu tempo com frivolidades. Traga-me obras de arte e eu deixarei você rico."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a2ba8bd-32dd-4b4e-8761-f2779050b9b5\', \'multiverseId\': 419862}, \'multiverseid\': 419862}, {\'name\': \'Главарь Контрабандистов\', \'text\': \'Цепь жизни\\nКаждый раз, когда артефакт выходит на поле битвы под вашим контролем, предскажите 1.\', \'type\': \'Существо — Эфирид Бродяга\', \'flavor\': \'«Не трать мое время по пустякам. Достань мне произведения искусства, и станешь богачом».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420126&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d4efbe3-a0ce-4bcb-b5b5-50fa3552755c\', \'multiverseId\': 420126}, \'multiverseid\': 420126}, {\'name\': \'禁品主谋\', \'text\': \'系命\\n每当一个神器在你的操控下进战场时，占卜1。\', \'type\': \'生物～乙太种／浪客\', \'flavor\': \'「别拿庸俗作品浪费我的时间。带技艺杰作过来，我必让你致富。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418014&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc372639-8afd-4063-a9fd-8b9f1098da13\', \'multiverseId\': 418014}, \'multiverseid\': 418014}, {\'name\': \'禁品主謀\', \'text\': \'繫命\\n每當一個神器在你的操控下進戰場時，占卜1。\', \'type\': \'生物～乙太種／浪客\', \'flavor\': \'「別拿庸俗作品浪費我的時間。帶技藝傑作過來，我必讓你致富。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418278&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c5f13449-8d23-452a-8e4a-522419a67274\', \'multiverseId\': 418278}, \'multiverseid\': 418278}]', '[{\'name\': \'Schmuggler-Kopter\', \'text\': \'Fliegend\\nImmer wenn der Schmuggler-Kopter angreift oder blockt, kannst du eine Karte ziehen. Falls du dies tust, wirf eine Karte ab.\\nBemannen 1 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 1 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418600&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a54e73fd-224c-4bac-a741-74f45de923f5\', \'multiverseId\': 418600}, \'multiverseid\': 418600}, {\'name\': \'Cóptero de contrabandista\', \'text\': \'Vuela.\\nSiempre que el Cóptero de contrabandista ataque o bloquee, puedes robar una carta. Si lo haces, descarta una carta.\\nTripular 1. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 1 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420448&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1b1fc3d-218c-4fbc-b3e5-f339dd4e948f\', \'multiverseId\': 420448}, \'multiverseid\': 420448}, {\'name\': \'Coptère de contrebandier\', \'text\': "Vol\\nÀ chaque fois que le Coptère de contrebandier attaque ou bloque, vous pouvez piocher une carte. Si vous faites ainsi, défaussez-vous d\'une carte.\\nPilotage 1 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 1 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418864&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'918c76d2-0056-4a9a-ba7d-bd3f5f3028b8\', \'multiverseId\': 418864}, \'multiverseid\': 418864}, {\'name\': \'Aerocottero del Contrabbandiere\', \'text\': "Volare\\nOgniqualvolta l\'Aerocottero del Contrabbandiere attacca o blocca, puoi pescare una carta. Se lo fai, scarta una carta.\\nManovrare 1 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 1: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)", \'type\': \'Artefatto — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419128&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'864c478f-1a82-4eaa-82fd-467a0cc2cf04\', \'multiverseId\': 419128}, \'multiverseid\': 419128}, {\'name\': \'密輸人の回転翼機\', \'text\': \'飛行\\n密輸人の回転翼機が攻撃かブロックするたび、あなたはカードを１枚引いてもよい。そうしたなら、カード１枚を捨てる。\\n搭乗１（あなたがコントロールする望む数のクリーチャーを、パワーの合計が１以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8ce86124-f4ca-4883-9748-7cee38054d83\', \'multiverseId\': 419392}, \'multiverseid\': 419392}, {\'name\': \'밀수꾼의 비행선\', \'text\': \'비행\\n밀수꾼의 비행선이 공격 또는 방어할 때마다, 당신은 카드 한 장을 뽑을 수 있다. 그렇게 한다면, 카드 한 장을 버린다.\\n탑승 1 (당신이 조종하는 생물을 공격력 총합이 1 이상이 되도록 원하는 수만큼 탭한다: 이 탑승물은 턴종료까지 마법물체 생물이 된다.)\', \'type\': \'마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419656&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'96fd273b-d3e6-420d-b778-9f6574ce95a0\', \'multiverseId\': 419656}, \'multiverseid\': 419656}, {\'name\': \'Cóptero do Contrabandista\', \'text\': \'Voar\\nToda vez que Cóptero do Contrabandista ataca ou bloqueia, você pode comprar um card. Se fizer isso, descarte um card.\\nTripular 1 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 1: Este Veículo se torna uma criatura artefato até o final do turno.)\', \'type\': \'Artefato — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419920&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'341bad89-41fb-4092-8354-7162a76dab51\', \'multiverseId\': 419920}, \'multiverseid\': 419920}, {\'name\': \'Коптер Контрабандиста\', \'text\': \'Полет\\nКаждый раз, когда Коптер Контрабандиста атакует или блокирует, вы можете взять карту. Если вы это делаете, сбросьте карту.\\nЭкипаж 1 (Поверните любое количество существ под вашим контролем с суммарной силой 1 или более: эта Машина становится артефактом существом до конца хода.)\', \'type\': \'Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420184&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b27c4d8d-bf51-4281-b48f-0e4606cd099c\', \'multiverseId\': 420184}, \'multiverseid\': 420184}, {\'name\': \'走私直升机\', \'text\': \'飞行\\n每当走私直升机攻击或阻挡时，你可以抓一张牌。若你如此作，则弃一张牌。\\n搭载1（横置任意数量由你操控且力量总和等于或大于1的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'神器～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3b307a83-36f0-4d70-b2a2-16232608f689\', \'multiverseId\': 418072}, \'multiverseid\': 418072}, {\'name\': \'走私直升機\', \'text\': \'飛行\\n每當走私直升機攻擊或阻擋時，你可以抽一張牌。若你如此作，則棄一張牌。\\n搭載1（橫置任意數量由你操控且力量總和等於或大於1的生物：此載具成為神器生物直到回合結束。）\', \'type\': \'神器～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418336&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1bc8631-3af8-4fcb-abfe-b09bbe8f38df\', \'multiverseId\': 418336}, \'multiverseid\': 418336}]', '[{\'name\': \'Schrecken vom Messeplatz\', \'type\': \'Kreatur — Gremlin\', \'flavor\': \'„Es gilt die höchste Alarmstufe. Erlaubnis zum Eliminieren bei Sichtkontakt erteilt. Entweder wir zerstören ihn oder er zerstört die Messe." —Pav, Gremlinwache\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418502&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8661115d-556c-4751-b254-56f183bd66a5\', \'multiverseId\': 418502}, \'multiverseid\': 418502}, {\'name\': \'Horror de la feria\', \'type\': \'Criatura — Gremlin\', \'flavor\': \'"Consideren esto una alerta roja. Tienen permiso para destruirlo en cuanto lo tengamos a la vista. O acabamos con él, o acabará con la Feria entera". —Pav, vigilagremlins\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420350&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d74078c-d55d-499b-99ae-a07d6c6cf0e2\', \'multiverseId\': 420350}, \'multiverseid\': 420350}, {\'name\': \'Terreur de la foire\', \'type\': \'Créature : gremlin\', \'flavor\': \'« Ceci est une alerte rouge. Permission de détruire à vue. Soit on élimine cette menace, soit elle détruira la Foire. » —Pav, agent de surveillance des gremlins\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9401153b-dda2-48cd-a1f8-2c780da803d7\', \'multiverseId\': 418766}, \'multiverseid\': 418766}, {\'name\': \'Terrore della Fiera\', \'type\': \'Creatura — Gremlin\', \'flavor\': \'"Consideratelo un codice rosso, gente. Siete autorizzati a distruggere a vista. Se non lo facciamo fuori, sarà lui a far fuori la Fiera." —Pav, guardia antigremlin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419030&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1202bcf-0036-4fb3-89de-f73e4a8e3be1\', \'multiverseId\': 419030}, \'multiverseid\': 419030}, {\'name\': \'博覧会場の恐怖\', \'type\': \'クリーチャー — グレムリン\', \'flavor\': \'「皆さん、十分注意してください。見つけ次第に退治する許可が出ています。放置すれば博覧会が台無しになるでしょう。」 ――グレムリン対策員、パヴ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419294&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bde47490-5784-479c-887f-43e43cfcecf2\', \'multiverseId\': 419294}, \'multiverseid\': 419294}, {\'name\': \'박람회장의 골칫덩이\', \'type\': \'생물 — 그렘린\', \'flavor\': \'"여러분, 지금은 비상사태입니다. 발견하는 즉시 처치하십시오. 그러지 않으면 박람회가 쑥대밭이 될 겁니다." —그렘린 감시자 파브\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419558&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'1c675765-43b1-44e4-a25a-22f40fc9fa51\', \'multiverseId\': 419558}, \'multiverseid\': 419558}, {\'name\': \'Terror da Feira\', \'type\': \'Criatura — Gremlin\', \'flavor\': \'"Considerem isso um alerta máximo, gente. Permissão para abater à primeira vista. Ou destruímos essa coisa, ou ela destrói a Feira." — Pav, da guarda antigremlin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419822&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'26c15509-0dde-4b5d-8a94-74093fc1ab59\', \'multiverseId\': 419822}, \'multiverseid\': 419822}, {\'name\': \'Ярмарочный Ужас\', \'type\': \'Существо — Гремлин\', \'flavor\': \'«Общая тревога, народ. При встрече — сразу атаковать. Или мы прикончим этого гада, или он сожрет всю Ярмарку». — Пав из антигремлинского патруля\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420086&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40a4017b-3ac5-4172-bc80-94eb6a3c93c9\', \'multiverseId\': 420086}, \'multiverseid\': 420086}, {\'name\': \'展区恐灵\', \'type\': \'生物～怪灵\', \'flavor\': \'「各位对此物要高度戒备。只要见到，即可就地格杀。我们如果不解决它，它就会把博览会给解决了。」 ～怪灵警戒员珀沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417974&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d1d5196-b7bb-4aea-85c2-25980b9c5ffa\', \'multiverseId\': 417974}, \'multiverseid\': 417974}, {\'name\': \'展區恐靈\', \'type\': \'生物～怪靈\', \'flavor\': \'「各位對此物要高度戒備。只要見到，即可就地格殺。我們如果不解決他，他就會把博覽會給解決了。」 ～怪靈警戒員珀沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418238&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'54b5f7fb-5034-4a62-ad06-0454d2327fda\', \'multiverseId\': 418238}, \'multiverseid\': 418238}]', '[{\'name\': \'Schrotthalden-Schmarotzer\', \'text\': \'Der Schrotthalden-Schmarotzer kann nicht blocken.\\n{1}{B}, schicke eine andere Kreaturenkarte aus deinem Friedhof ins Exil: Bringe den Schrotthalden-Schmarotzer aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'Manche Maschinen weigern sich anzuerkennen, dass sie komplett veraltet sind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418596&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e8d3ee12-597d-4c02-9c20-70421471de04\', \'multiverseId\': 418596}, \'multiverseid\': 418596}, {\'name\': \'Parásito desguazador\', \'text\': \'El Parásito desguazador no puede bloquear.\\n{1}{B}, exiliar otra carta de criatura de tu cementerio: Regresa el Parásito desguazador de tu cementerio al campo de batalla.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'Algunas máquinas rehúsan aceptar su propia obsolescencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420444&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60fae09a-27c8-4339-88b6-968a5b41597e\', \'multiverseId\': 420444}, \'multiverseid\': 420444}, {\'name\': \'Parasite du rebut\', \'text\': \'Le Parasite du rebut ne peut pas bloquer.\\n{1}{B}, exilez une autre carte de créature depuis votre cimetière : Renvoyez sur le champ de bataille le Parasite du rebut depuis votre cimetière.\', \'type\': \'Créature-artefact : construction\', \'flavor\': "Certaines machines refusent d\'accepter leur obsolescence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418860&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6ade13c5-3683-46e3-ae1e-21e9113195f1\', \'multiverseId\': 418860}, \'multiverseid\': 418860}, {\'name\': \'Sciacallo dei Rottami\', \'text\': "Lo Sciacallo dei Rottami non può bloccare.\\n{1}{B}, Esilia un\'altra carta creatura dal tuo cimitero: Rimetti sul campo di battaglia lo Sciacallo dei Rottami dal tuo cimitero.", \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': \'Alcune macchine non si rassegnano a diventare obsolete.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419124&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2b0ebff-9c43-496f-9628-b0a0b4bdcb09\', \'multiverseId\': 419124}, \'multiverseid\': 419124}, {\'name\': \'屑鉄場のたかり屋\', \'text\': \'屑鉄場のたかり屋ではブロックできない。\\n{1}{B}, あなたの墓地から他のクリーチャー・カード１枚を追放する：あなたの墓地から屑鉄場のたかり屋を戦場に戻す。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'機械の中には、自分の陳腐化を納得しない物もある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419388&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1248cccc-a17f-4aa5-9b9b-daee094c05dd\', \'multiverseId\': 419388}, \'multiverseid\': 419388}, {\'name\': \'폐품 약탈자\', \'text\': \'폐품 약탈자는 방어할 수 없다.\\n{1}{B}, 당신의 무덤에서 다른 생물 카드 한 장을 추방한다: 폐품 약탈자를 당신의 무덤에서 전장으로 되돌린다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': \'몇몇 기계는 자신이 구식이 되었다는 사실을 받아들이지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419652&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7398ad74-e230-4eda-b9ff-7195d27264c1\', \'multiverseId\': 419652}, \'multiverseid\': 419652}, {\'name\': \'Parasita de Sucata\', \'text\': \'Parasita de Sucata não pode bloquear.\\n{1}{B}, Exile outro card de criatura de seu cemitério: Devolva Parasita de Sucata de seu cemitério para o campo de batalha.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': \'Algumas máquinas se recusam a aceitar a própria obsolescência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419916&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13b3ff53-7477-403e-b000-224d3faa808a\', \'multiverseId\': 419916}, \'multiverseid\': 419916}, {\'name\': \'Металлоломный Хапуга\', \'text\': \'Металлоломный Хапуга не может блокировать.\\n{1}{B}, изгоните другую карту существа из вашего кладбища: верните Металлоломного Хапугу из вашего кладбища на поле битвы.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': \'Некоторые машины отказываются признавать, что давно устарели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420180&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e6df3d3-e579-4ead-8eff-287ef7627812\', \'multiverseId\': 420180}, \'multiverseid\': 420180}, {\'name\': \'废品搜刮者\', \'text\': \'废品搜刮者不能进行阻挡。\\n{1}{B}，从你的坟墓场放逐另一张生物牌：将废品搜刮者从你的坟墓场移回战场。\', \'type\': \'神器生物～组构体\', \'flavor\': \'机械会不断老化；而有些机械不甘如此。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418068&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6f0a31b1-bd62-47d0-82eb-a67df8441340\', \'multiverseId\': 418068}, \'multiverseid\': 418068}, {\'name\': \'廢品搜刮者\', \'text\': \'廢品搜刮者不能進行阻擋。\\n{1}{B}，從你的墳墓場放逐另一張生物牌：將廢品搜刮者從你的墳墓場移回戰場。\', \'type\': \'神器生物～組構體\', \'flavor\': \'機械會不斷老化；而有些機械不甘如此。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418332&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'40e2aa27-9fad-4418-93b7-784efba47ba4\', \'multiverseId\': 418332}, \'multiverseid\': 418332}]', '[{\'name\': \'Schuss des Himmelswalfängers\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit Stärke 3 oder mehr. Hellsicht 1.\', \'type\': \'Spontanzauber\', \'flavor\': \'Im entscheidenden Moment ist es, als würde die Zeit stehenbleiben und der Wal bewegungslos zwischen den Wolken hängen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418394&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a04d688-e1d9-4e84-a43b-2ce0892939a2\', \'multiverseId\': 418394}, \'multiverseid\': 418394}, {\'name\': \'Disparo de ballenero celeste\', \'text\': \'Destruye la criatura objetivo con fuerza de 3 o más. Adivina 1.\', \'type\': \'Instantáneo\', \'flavor\': \'A la hora de la verdad, es como si el tiempo se detuviese; y la ballena espera, suspendida en el cielo...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420242&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3024a824-e4b7-4a63-a588-fd4cf9ed7d78\', \'multiverseId\': 420242}, \'multiverseid\': 420242}, {\'name\': \'Tir du baleinier volant\', \'text\': \'Détruisez une créature ciblée de force supérieure ou égale à 3. Regard 1.\', \'type\': \'Éphémère\', \'flavor\': "Au moment de vérité, le temps semble s\'arrêter et la baleine attendre, suspendue dans les airs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418658&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'104e1cd2-321a-46b0-b8a1-36e1ce088e45\', \'multiverseId\': 418658}, \'multiverseid\': 418658}, {\'name\': "Colpo dell\'Aviobaleniere", \'text\': \'Distruggi una creatura bersaglio con forza pari o superiore a 3. Profetizza 1.\', \'type\': \'Istantaneo\', \'flavor\': "Nell\'attimo cruciale, sembra che il tempo si fermi e la balena attenda, sospesa in mezzo al cielo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418922&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'795ada8a-20e4-44e4-b786-0d8cc463bcee\', \'multiverseId\': 418922}, \'multiverseid\': 418922}, {\'name\': \'空鯨捕りの一撃\', \'text\': \'パワーが３以上のクリーチャー１体を対象とし、それを破壊する。占術１を行う。\', \'type\': \'インスタント\', \'flavor\': \'その瞬間、まるで時が停まったように、その鯨は空中に留まり待っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419186&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8e50ac97-1444-4dad-a243-9fc027b99feb\', \'multiverseId\': 419186}, \'multiverseid\': 419186}, {\'name\': \'하늘고래 포획\', \'text\': \'공격력이 3 이상인 생물을 목표로 정한다. 그 생물을 파괴한다. 점술 1을 한다.\', \'type\': \'순간마법\', \'flavor\': \'결정적 순간에 마치 시간이 멈춘 듯, 고래가 하늘에 뜬 채 기다리고 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419450&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7a231ea6-070f-40e5-9e51-6000136828d0\', \'multiverseId\': 419450}, \'multiverseid\': 419450}, {\'name\': \'Tiro do Aerobaleeiro\', \'text\': \'Destrua a criatura alvo com poder igual ou superior a 3. Vidência 1.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Na hora da verdade, é como se o tempo parasse e a baleia esperasse, suspensa no céu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419714&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79e15c79-5357-4680-9f20-646522a53409\', \'multiverseId\': 419714}, \'multiverseid\': 419714}, {\'name\': \'Выстрел Небесного Китобоя\', \'text\': \'Уничтожьте целевое существо с силой 3 или больше. Предскажите 1.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В решающий момент время будто останавливается, и кит ждет, замерев в небесах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419978&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57bebd46-8dc1-49a1-ba90-65a0bf2a696f\', \'multiverseId\': 419978}, \'multiverseid\': 419978}, {\'name\': \'飞鲸猎手射击\', \'text\': \'消灭目标力量等于或大于3的生物。占卜1。\', \'type\': \'瞬间\', \'flavor\': \'在这紧要关头，仿佛一切都凝固了：时间静止，飞鲸停滞。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417866&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'930f1e7f-aff3-44e4-af71-054e4adb2b15\', \'multiverseId\': 417866}, \'multiverseid\': 417866}, {\'name\': \'飛鯨獵手射擊\', \'text\': \'消滅目標力量大於或等於3的生物。占卜1。\', \'type\': \'瞬間\', \'flavor\': \'在這緊要關頭，彷彿一切都凝固了；時間靜止，飛鯨停滯。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418130&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d38e6f35-acb7-46f9-8948-5f912c8bd446\', \'multiverseId\': 418130}, \'multiverseid\': 418130}]', '[{\'name\': \'Schutzbrille des Erfinders\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+2.\\nImmer wenn ein Handwerker unter deiner Kontrolle ins Spiel kommt, kannst du die Schutzbrille des Erfinders an ihn anlegen.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418583&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6006d8c-04ca-4a25-a3d2-1fa95ad416c8\', \'multiverseId\': 418583}, \'multiverseid\': 418583}, {\'name\': \'Anteojos de inventor\', \'text\': \'La criatura equipada obtiene +1/+2.\\nSiempre que un Artífice entre al campo de batalla bajo tu control, puedes anexarle los Anteojos de inventor.\\nEquipar {2}. ({2}: Anexa este equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420431&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ff494cc7-db29-4202-b182-96f7246bc63f\', \'multiverseId\': 420431}, \'multiverseid\': 420431}, {\'name\': "Lunettes d\'inventeur", \'text\': "La créature équipée gagne +1/+2.\\nÀ chaque fois qu\'un artificier arrive sur le champ de bataille sous votre contrôle, vous pouvez lui attacher les Lunettes d\'inventeur.\\nÉquipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418847&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78b96732-060d-4cff-b52f-9a4378849b91\', \'multiverseId\': 418847}, \'multiverseid\': 418847}, {\'name\': "Occhialoni dell\'Inventore", \'text\': "La creatura equipaggiata prende +1/+2.\\nOgniqualvolta un Artefice entra nel campo di battaglia sotto il tuo controllo, puoi assegnargli gli Occhialoni dell\'Inventore.\\nEquipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)", \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419111&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e49ff5bf-f9b9-4b5f-a83a-48de4603db85\', \'multiverseId\': 419111}, \'multiverseid\': 419111}, {\'name\': \'発明者のゴーグル\', \'text\': \'装備しているクリーチャーは＋１/＋２の修整を受ける。\\n工匠が１体あなたのコントロール下で戦場に出るたび、あなたは発明者のゴーグルをそれにつけてもよい。\\n装備{2}（{2}：あなたがコントロールするクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419375&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b160251d-71c2-41e4-971b-9793dd5ae594\', \'multiverseId\': 419375}, \'multiverseid\': 419375}, {\'name\': \'발명가의 고글\', \'text\': \'장착된 생물은 +1/+2를 받는다.\\n기능공이 당신의 조종하에 전장에 들어올 때마다, 당신은 그 생물에 발명가의 고글을 부착할 수 있다.\\n장착 {2} ({2}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419639&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'df05c5cf-eeef-4be6-ab82-4b0dab978418\', \'multiverseId\': 419639}, \'multiverseid\': 419639}, {\'name\': \'Óculos do Inventor\', \'text\': \'A criatura equipada recebe +1/+2.\\nToda vez que um Artesão entra no campo de batalha sob seu controle, você pode anexar Óculos do Inventor a ele.\\nEquipar {2} ({2}: Anexe à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419903&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f324164-5e57-410e-8ef3-47566580a6e1\', \'multiverseId\': 419903}, \'multiverseid\': 419903}, {\'name\': \'Очки Изобретателя\', \'text\': \'Снаряженное существо получает +1/+2.\\nКаждый раз, когда Механик выходит на поле битвы под вашим контролем, вы можете прикрепить к нему Очки Изобретателя.\\nСнарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420167&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8bcf732c-e18c-4e56-ac78-9ec72bf18211\', \'multiverseId\': 420167}, \'multiverseid\': 420167}, {\'name\': \'发明家护目镜\', \'text\': \'佩带此武具的生物得+1/+2。\\n每当一个神器师在你的操控下进战场时，你可以将发明家护目镜装备于其上。\\n佩带{2}（{2}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418055&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cce17026-98c9-45ad-b3cb-5e88edb75d64\', \'multiverseId\': 418055}, \'multiverseid\': 418055}, {\'name\': \'發明家護目鏡\', \'text\': \'佩帶此武具的生物得+1/+2。\\n每當一個神器師在你的操控下進戰場時，你可以將發明家護目鏡裝備於其上。\\n佩帶{2}（{2}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418319&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ee270e34-d51f-4e31-90d0-de2f1dd5742a\', \'multiverseId\': 418319}, \'multiverseid\': 418319}]', '[{\'name\': \'Schweißfunken\', \'text\': \'Die Schweißfunken fügen einer Kreatur deiner Wahl X Schadenspunkte zu, wobei X gleich 3 plus der Anzahl an Artefakten, die du kontrollierst, ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das Feuer des Erfindergeistes brennt in jedem von uns. Ich kämpfe für die Freiheit, dieses Feuer zu entfesseln." —Pia Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11855c45-3d84-4654-8b4d-1e4c8c723410\', \'multiverseId\': 418505}, \'multiverseid\': 418505}, {\'name\': \'Chispas de soldadura\', \'text\': \'Las Chispas de soldadura hacen X puntos de daño a la criatura objetivo, donde X es 3 más la cantidad de artefactos que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los fuegos de la invención arden en todos nosotros. Yo lucho por la libertad de liberar esas llamas". —Pia Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420353&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d80e3ff4-895b-4f7d-8c98-ad344e14b773\', \'multiverseId\': 420353}, \'multiverseid\': 420353}, {\'name\': \'Étincelles de soudure\', \'text\': "Les Étincelles de soudure infligent X blessures à la créature ciblée, X étant 3 plus le nombre d\'artefacts que vous contrôlez.", \'type\': \'Éphémère\', \'flavor\': \'« Le feu de la créativité brûle en chacun de nous. Je me bats pour libérer ces flammes. » —Pia Nalaàr\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418769&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc9410c1-04db-4025-a9e1-26689dba7dd4\', \'multiverseId\': 418769}, \'multiverseid\': 418769}, {\'name\': \'Scintille della Saldatura\', \'text\': \'Le Scintille della Saldatura infliggono X danni a una creatura bersaglio, dove X è 3 più il numero di artefatti che controlli.\', \'type\': \'Istantaneo\', \'flavor\': \'"La fiamma della creatività arde in ognuno di noi. Io combatto per la libertà di scatenare quel fuoco." —Pia Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7984845d-9b89-419d-aa7d-7840df81e0a7\', \'multiverseId\': 419033}, \'multiverseid\': 419033}, {\'name\': \'溶接の火花\', \'text\': \'クリーチャー１体を対象とする。溶接の火花はそれにＸ点のダメージを与える。Ｘはあなたがコントロールするアーティファクトの総数に３を足した数に等しい。\', \'type\': \'インスタント\', \'flavor\': \'「発明の炎は誰の心にも燃えているわ。その炎を解き放つ自由のために、私は戦っているの。」 ――ピア・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419297&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40550e66-5b52-438b-86d3-d519ca77c4dd\', \'multiverseId\': 419297}, \'multiverseid\': 419297}, {\'name\': \'용접 불꽃\', \'text\': \'생물을 목표로 정한다. 용접 불꽃은 그 생물에게 피해 X점을 입힌다. X는 당신이 조종하는 마법물체 수에 3을 더한 수이다.\', \'type\': \'순간마법\', \'flavor\': \'"우리 모두 발명에 대한 열정으로 불탑니다. 저는 이러한 열정을 마음껏 발산할 수 있는 자유를 위해 싸웁니다." —피아 날라르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419561&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f63bcbf5-c907-45c7-8b1d-775ca6401292\', \'multiverseId\': 419561}, \'multiverseid\': 419561}, {\'name\': \'Centelhas da Solda\', \'text\': \'Centelhas da Solda causa X pontos de dano à criatura alvo, sendo X 3 mais o número de artefatos que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As chamas da invenção ardem em todos nós. Eu luto pela liberdade de atear esse fogo." — Pia Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73adc594-faa1-48ae-a90a-feba7c085748\', \'multiverseId\': 419825}, \'multiverseid\': 419825}, {\'name\': \'Искры Сварки\', \'text\': \'Искры Сварки наносят X повреждений целевому существу, где X — 3 плюс количество артефактов под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Огонь изобретений полыхает в каждом из нас. Я сражаюсь за право выпустить его на свободу». — Пия Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420089&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4cf302a5-5772-4e4c-ab90-6958e1d1094d\', \'multiverseId\': 420089}, \'multiverseid\': 420089}, {\'name\': \'焊接火花\', \'text\': \'焊接火花对目标生物造成X点伤害，X为由你操控的神器数量加3。\', \'type\': \'瞬间\', \'flavor\': \'「发明之火在我们所有人的心中燃烧。我为能自由释放这些火焰而战。」 ～琵雅纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b1bdbc72-3128-46af-b511-2f54203eb75b\', \'multiverseId\': 417977}, \'multiverseid\': 417977}, {\'name\': \'焊接火花\', \'text\': \'焊接火花對目標生物造成X點傷害，X為由你操控的神器數量加3。\', \'type\': \'瞬間\', \'flavor\': \'「發明之火在我們所有人的心中燃燒。我為能自由釋放這些火焰而戰。」 ～琵雅納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418241&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c1c96f1c-6a12-4ea3-9838-768b7d27455b\', \'multiverseId\': 418241}, \'multiverseid\': 418241}]', '[{\'name\': \'Selbstmontierer\', \'text\': \'Wenn der Selbstmontierer ins Spiel kommt, kannst du deine Bibliothek nach einer Montagearbeiter-Kreaturenkarte durchsuchen, sie offen vorzeigen, auf deine Hand nehmen und dann deine Bibliothek mischen.\', \'type\': \'Artefaktkreatur — Montagearbeiter\', \'flavor\': \'Er sieht sich selbst in all seinen Schöpfungen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418597&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70288cb1-c159-419c-99a7-cc5f4cd27c71\', \'multiverseId\': 418597}, \'multiverseid\': 418597}, {\'name\': \'Autoensamblador\', \'text\': \'Cuando el Autoensamblador entre al campo de batalla, puedes buscar en tu biblioteca una carta de criatura Operario, mostrarla, ponerla en tu mano y luego barajar tu biblioteca.\', \'type\': \'Criatura artefacto — Operario\', \'flavor\': \'Se ve a sí mismo en todas sus creaciones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420445&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1427139b-b03b-47a8-be16-4169a6b32acd\', \'multiverseId\': 420445}, \'multiverseid\': 420445}, {\'name\': \'Auto-assembleur\', \'text\': "Quand l\'Auto-assembleur arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de créature Ouvrier spécialisé, la révéler, la mettre dans votre main et mélanger ensuite votre bibliothèque.", \'type\': \'Créature-artefact : ouvrier spécialisé\', \'flavor\': \'Il se retrouve dans toutes ses créations.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418861&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a9bcc394-39c6-4ef3-8cfe-8b5afd3ebd64\', \'multiverseId\': 418861}, \'multiverseid\': 418861}, {\'name\': \'Auto-Assemblante\', \'text\': "Quando l\'Auto-Assemblante entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta creatura Addetto-al-Montaggio, rivelarla, aggiungerla alla tua mano e poi rimescolare il tuo grimorio.", \'type\': \'Creatura Artefatto — Addetto-al-Montaggio\', \'flavor\': \'Si rivede in tutte le sue creazioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419125&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1180ca4d-1bfa-41d5-8d1e-401c04822ee6\', \'multiverseId\': 419125}, \'multiverseid\': 419125}, {\'name\': \'自己組立機械\', \'text\': \'自己組立機械が戦場に出たとき、あなたはあなたのライブラリーから組立作業員・クリーチャー・カード１枚を探してもよい。そうしたなら、それを公開してあなたの手札に加え、その後あなたのライブラリーを切り直す。\', \'type\': \'アーティファクト・クリーチャー — 組立作業員\', \'flavor\': \'それは自分の組立の様子を自分で見ている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419389&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd3e0c27-2cac-4740-aea2-d31f585ab204\', \'multiverseId\': 419389}, \'multiverseid\': 419389}, {\'name\': \'자가조립체\', \'text\': \'자가조립체가 전장에 들어올 때, 당신은 당신의 서고에서 조립공 생물 카드 한 장을 찾아 공개한 후 당신의 손으로 가져올 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.\', \'type\': \'마법물체 생물 — 조립공\', \'flavor\': \'그것은 모든 창조물에서 자신의 모습을 본다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419653&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'269900f3-6b8a-4ea3-8a52-5c1a10666498\', \'multiverseId\': 419653}, \'multiverseid\': 419653}, {\'name\': \'Automontante\', \'text\': \'Quando Automontante entra no campo de batalha, você pode procurar um card de criatura do tipo Operário de Linha de Montagem em seu grimório, revelá-lo e colocá-lo na sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Criatura Artefato — Operário de Linha de Montagem\', \'flavor\': \'Ele se vê em todas as suas criações.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419917&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cffb400e-9e85-4325-808f-4760c689b9f7\', \'multiverseId\': 419917}, \'multiverseid\': 419917}, {\'name\': \'Самосборщик\', \'text\': \'Когда Самосборщик выходит на поле битвы, вы можете найти в вашей библиотеке карту существа с типом Рабочий-Сборщик, показать ее, положить ее в вашу руку, затем перетасовать вашу библиотеку.\', \'type\': \'Артефакт Существо — Рабочий-Cборщик\', \'flavor\': \'Он видит себя во всех своих созданиях.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420181&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'90754991-a87e-41de-bafe-31bee530e0e4\', \'multiverseId\': 420181}, \'multiverseid\': 420181}, {\'name\': \'自组工人\', \'text\': \'当自组工人进战场时，你可以从你的牌库中搜寻一张组装工人生物牌，展示该牌，将它置于你手上，然后将你的牌库洗牌。\', \'type\': \'神器生物～组装工人\', \'flavor\': \'它的所有造物中都留有自身影子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418069&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'40b2ad9a-dfaa-420d-9f09-06dfe6d7b149\', \'multiverseId\': 418069}, \'multiverseid\': 418069}, {\'name\': \'自組工人\', \'text\': \'當自組工人進戰場時，你可以從你的牌庫中搜尋一張組裝工人生物牌，展示該牌，將它置於你手上，然後將你的牌庫洗牌。\', \'type\': \'神器生物～組裝工人\', \'flavor\': \'它的所有造物中都留有自身影子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418333&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3c26766a-8714-45bb-a819-df5ecad1cf4c\', \'multiverseId\': 418333}, \'multiverseid\': 418333}]', '[{\'name\': \'Servo-Vorführung\', \'text\': \'Erzeuge zwei 1/1 farblose Servo-Artefaktkreaturenspielsteine.\', \'type\': \'Hexerei\', \'flavor\': \'„Sie wurden von den Preisrichtern genau unter die Lupe genommen, aber sie haben überzeugt. Ich glaube, sogar der Oberste Preisrichter Tezzeret war beeindruckt." —Ritika, Handwerkerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418392&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d08b8fb-262c-4eb6-b9ad-91b8d5bbe54f\', \'multiverseId\': 418392}, \'multiverseid\': 418392}, {\'name\': \'Exhibición de servos\', \'text\': \'Crea dos fichas de criatura artefacto Servo incoloras 1/1.\', \'type\': \'Conjuro\', \'flavor\': \'"Los jueces se lo pusieron muy difícil, pero han demostrado su valía. Creo que impresionaron hasta al juez principal, Tezzeret". —Ritika, artífice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420240&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30bd228e-f739-4af1-8973-46a12789650a\', \'multiverseId\': 420240}, \'multiverseid\': 420240}, {\'name\': \'Exhibition de servos\', \'text\': \'Créez deux jetons de créature-artefact 1/1 incolore Servo.\', \'type\': \'Rituel\', \'flavor\': "« Les juges les ont vraiment mis à l\'épreuve, mais ils se sont imposés. Je pense que même le grand juge Tezzeret a été impressionné. » —Ritika, artificier", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418656&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7b07dc5-dd6e-4e2d-8405-88c6ada0d11f\', \'multiverseId\': 418656}, \'multiverseid\': 418656}, {\'name\': \'Esibizione di Servomeccanismi\', \'text\': \'Crea due pedine creatura artefatto Servomeccanismo 1/1 incolori.\', \'type\': \'Stregoneria\', \'flavor\': \'"I giudici li hanno sottoposti a un esame severo, ma si sono mostrati all\\\'altezza. Credo che sia rimasto colpito persino il giudice capo Tezzeret." —Ritika, artefice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418920&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86167a07-37f7-4db1-a2c7-1447965784b1\', \'multiverseId\': 418920}, \'multiverseid\': 418920}, {\'name\': \'霊気装置の展示\', \'text\': \'無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを２体生成する。\', \'type\': \'ソーサリー\', \'flavor\': \'「審判者はこれを本気で試していたが、好印象だったようだ。テゼレット審判長も感心していたと思う。」 ――工匠、リティカ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419184&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'103355c9-8e06-4419-858c-5aeff13be7ab\', \'multiverseId\': 419184}, \'multiverseid\': 419184}, {\'name\': \'서보 전시회\', \'text\': \'1/1 무색 서보 마법물체 생물 토큰 두 개를 만든다.\', \'type\': \'집중마법\', \'flavor\': \'"심사위원들이 그들을 끝까지 시험해 봤으나 그들이 이겼습니다. 주심 테제렛마저도 감동받은 것 같습니다." —기능공 리티카\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419448&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f0861a72-cdc3-43ff-b063-aad5fc298383\', \'multiverseId\': 419448}, \'multiverseid\': 419448}, {\'name\': \'Exposição de Servus\', \'text\': \'Crie duas fichas de criatura artefato incolor 1/1 do tipo Servus.\', \'type\': \'Feitiço\', \'flavor\': \'"Os jurados realmente os fizeram penar, mas eles triunfaram. Acho que impressionaram até o Jurado Mor Tezzeret." — Ritika, artesão\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419712&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c3cdb701-cd5b-4727-8d8a-6def6949060d\', \'multiverseId\': 419712}, \'multiverseid\': 419712}, {\'name\': \'Показ Сервотронов\', \'text\': \'Создайте две фишки артефакта существа 1/1 бесцветный Сервотрон.\', \'type\': \'Волшебство\', \'flavor\': \'«Судьи их гоняли в хвост и в гриву, но они выстояли. Кажется, даже главный судья Теззерет был впечатлен». — механик Ритика\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419976&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59a49e9a-9a05-4a10-b838-bf20ef545d22\', \'multiverseId\': 419976}, \'multiverseid\': 419976}, {\'name\': \'自动机展览\', \'text\': \'派出两个1/1无色自动机衍生神器生物。\', \'type\': \'法术\', \'flavor\': \'「评审严格检验其各项性能，但它们一一过关。就连主审泰兹瑞都对其留下深刻印象。」 ～神器师黎提克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417864&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62533d5f-b675-43bc-b16b-f02f3f8cdd59\', \'multiverseId\': 417864}, \'multiverseid\': 417864}, {\'name\': \'自動機展覽\', \'text\': \'派出兩個1/1無色自動機衍生神器生物。\', \'type\': \'巫術\', \'flavor\': \'「評審嚴格檢驗其各項性能，但它們一一過關。就連主審泰茲瑞都對其留下深刻印象。」 ～神器師黎提克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418128&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3e75672e-7200-4a45-953c-eab42d3e1bf1\', \'multiverseId\': 418128}, \'multiverseid\': 418128}]', '[{\'name\': \'Spontane Straßenkünstlerin\', \'text\': \'Wenn die Spontane Straßenkünstlerin ins Spiel kommt, erhältst du {E} (eine Energiemarke).\\nBezahle {E}: Eine Kreatur deiner Wahl erhält Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Das Graffiti der „undichten Turmspitze" ist ein Symbol der Renegaten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418499&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1d94b0cd-88dd-48d1-af51-29e017f662cf\', \'multiverseId\': 418499}, \'multiverseid\': 418499}, {\'name\': \'Artista espontánea\', \'text\': \'Cuando la Artista espontánea entre al campo de batalla, obtienes {E} (un contador de energía).\\nPagar {E}: La criatura objetivo gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'Siempre se encuentra el símbolo del chapitel desbordante en grafitis allá donde han estado los renegados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420347&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'12c13db3-5f61-4f09-8635-cc0402c40dce\', \'multiverseId\': 420347}, \'multiverseid\': 420347}, {\'name\': \'Artiste spontanée\', \'text\': "Quand l\'Artiste spontanée arrive sur le champ de bataille, vous gagnez {E} (un marqueur « énergie »).\\nPayez {E} : Une créature ciblée acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : humain et gredin\', \'flavor\': \'Les graffitis au symbole de « tour percée » marquent le passage des renégats.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418763&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72823637-b62f-4e2f-b08d-a6214c69cc51\', \'multiverseId\': 418763}, \'multiverseid\': 418763}, {\'name\': \'Artista Spontanea\', \'text\': "Quando l\'Artista Spontanea entra nel campo di battaglia, ottieni {E} (un segnalino energia).\\nPaga {E}: Una creatura bersaglio ha rapidità fino alla fine del turno.", \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'Ovunque passino i rinnegati, spuntano graffiti che raffigurano il simbolo della "guglia stillante".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419027&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f23af02-27b5-4c46-8e8e-01b2484eed4c\', \'multiverseId\': 419027}, \'multiverseid\': 419027}, {\'name\': \'気ままな芸術家\', \'text\': \'気ままな芸術家が戦場に出たとき、あなたは{E}（エネルギー・カウンター１個）を得る。\\n{E}を支払う：クリーチャー１体を対象とする。ターン終了時まで、それは速攻を得る。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'「漏霊塔」の落書きは、改革派がいるところならどこにでも見つかる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419291&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'492522fc-91ce-46ce-abe2-8339998bd2ce\', \'multiverseId\': 419291}, \'multiverseid\': 419291}, {\'name\': \'즉흥적인 예술가\', \'text\': \'즉흥적인 예술가가 전장에 들어올 때, 당신은 {E}(에너지 카운터 한 개)를 얻는다.\\n{E}를 지불한다: 생물을 목표로 정한다. 그 생물은 턴종료까지 신속을 얻는다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'무법자들이 지나간 곳에는 어디든 "에테르가 새는 첨탑" 기호가 그려져 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419555&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0dd4fd78-5ff7-4fda-a833-39ec3fa69a7c\', \'multiverseId\': 419555}, \'multiverseid\': 419555}, {\'name\': \'Artista Espontânea\', \'text\': \'Quando Artista Espontânea entra no campo de batalha, você recebe {E} (um marcador de energia).\\nPague {E}: A criatura alvo ganha ímpeto até o final do turno.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'As pichações com o símbolo da "torre vazando" marcam a passagem dos renegados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419819&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02932ac9-a180-4f40-8165-7522ff1bab24\', \'multiverseId\': 419819}, \'multiverseid\': 419819}, {\'name\': \'Импульсивная Художница\', \'text\': \'Когда Импульсивная Художница выходит на поле битвы, вы получаете {E} (один жетон энергии).\\nЗаплатите {E}: целевое существо получает Ускорение до конца хода.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Всюду, где побывали отступники, можно увидеть нарисованный на стенах символ — «прохудившийся шпиль».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420083&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8966c53c-89ea-453b-ab78-d503830605b9\', \'multiverseId\': 420083}, \'multiverseid\': 420083}, {\'name\': \'天生能手\', \'text\': \'当天生能手进战场时，你得到{E}（一个能量指示物）。\\n支付{E}：目标生物获得敏捷异能直到回合结束。\', \'type\': \'生物～人类／浪客\', \'flavor\': \'乱匠所到之处，必可见「渗漏尖塔」符号的涂鸦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417971&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a88c187f-481f-432d-8461-4fee9f7cb0c9\', \'multiverseId\': 417971}, \'multiverseid\': 417971}, {\'name\': \'天生能手\', \'text\': \'當天生能手進戰場時，你得到{E}（一個能量指示物）。\\n支付{E}：目標生物獲得敏捷異能直到回合結束。\', \'type\': \'生物～人類／浪客\', \'flavor\': \'亂匠所到之處，必可見「滲漏尖塔」符號的塗鴉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418235&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f4e27f6f-2e98-433f-99a7-7dc006c9b87c\', \'multiverseId\': 418235}, \'multiverseid\': 418235}]', "[{'name': 'Sprießendes Crescendo', 'text': 'Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe sie getappt ins Spiel. Durchsuche deine Bibliothek und deinen Friedhof nach einer Karte namens Nissa, Schöpferin der Natur, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420516&type=card', 'language': 'German', 'identifiers': {'scryfallId': '51732a54-358f-4d9f-9831-dbabd4a64fa0', 'multiverseId': 420516}, 'multiverseid': 420516}, {'name': 'Clímax verdeante', 'text': 'Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Busca en tu biblioteca y cementerio una carta llamada Nissa, artesana de la naturaleza; muéstrala y ponla en tu mano. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420586&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '67a98e5c-b08e-4374-9cfa-c396e007e78d', 'multiverseId': 420586}, 'multiverseid': 420586}, {'name': 'Apogée verdoyante', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Cherchez dans votre bibliothèque et votre cimetière une carte appelée Nissa, artisane de la nature, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420526&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e2a751d7-7efc-44ab-bb9f-028aa179db77', 'multiverseId': 420526}, 'multiverseid': 420526}, {'name': 'Crescendo Verdeggiante', 'text': 'Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Passa in rassegna il tuo grimorio e il tuo cimitero per una carta chiamata Nissa, Artigiana della Natura, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420536&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd8a57f94-3e80-43db-8c96-a2c4ddbbfd0c', 'multiverseId': 420536}, 'multiverseid': 420536}, {'name': '新緑の最高潮', 'text': 'あなたのライブラリーから基本土地・カード１枚を探し、それをタップ状態で戦場に出す。あなたのライブラリーやあなたの墓地から「自然の職工、ニッサ」という名前のカード１枚を探し、それを公開してあなたの手札に加える。その後あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420546&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '182a1f85-a366-448b-a0c1-60e12f7240fa', 'multiverseId': 420546}, 'multiverseid': 420546}, {'name': '신록의 확장', 'text': '당신의 서고에서 기본 대지 카드 한 장을 찾아 탭된 채로 전장에 놓는다. 당신의 서고 및 무덤에서 이름이 자연의 장인 니사인 카드 한 장을 찾아 공개한 후 당신의 손으로 가져간다. 그러고 나서 당신의 서고를 섞는다.', 'type': '집중마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420556&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '323eed6d-817e-4e0a-8378-bcb01b1abc10', 'multiverseId': 420556}, 'multiverseid': 420556}, {'name': 'Crescendo Verdejante', 'text': 'Procure um card de terreno básico em seu grimório e coloque-o no campo de batalha virado. Procure um card com o nome Nissa, Artesã da Natureza, em seu grimório e cemitério, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420566&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5ac38e6c-7b96-404c-b304-e34740cc8c89', 'multiverseId': 420566}, 'multiverseid': 420566}, {'name': 'Зеленое Крещендо', 'text': 'Найдите в вашей библиотеке карту базовой земли и положите ее на поле битвы повернутой. Найдите в вашей библиотеке и на вашем кладбище карту с именем Нисса, Мастер Природы, покажите ее и положите в вашу руку. Затем перетасуйте вашу библиотеку.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420576&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8b4d46a5-0c8c-4bcd-bad2-76aa2a406fac', 'multiverseId': 420576}, 'multiverseid': 420576}, {'name': '新绿渐生', 'text': '从你的牌库中搜寻一张基本地牌，并将之横置放进战场。从你的牌库和坟墓场中搜寻一张名称为自然巧匠妮莎的牌，展示该牌，并将它置于你手上。然后将你的牌库洗牌。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420496&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd1476227-ff9c-4a59-ad86-29f1f8d0da7d', 'multiverseId': 420496}, 'multiverseid': 420496}, {'name': '新綠漸生', 'text': '從你的牌庫中搜尋一張基本地牌，並將之橫置放進戰場。從你的牌庫和墳墓場中搜尋一張名稱為自然巧匠妮莎的牌，展示該牌，並將它置於你手上。然後將你的牌庫洗牌。', 'type': '巫術', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420506&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a0675370-2344-4627-8061-cd1c709a2102', 'multiverseId': 420506}, 'multiverseid': 420506}]", '[{\'name\': \'Starrsinniger Riese\', \'text\': \'Bedrohlich\', \'type\': \'Kreatur — Riese\', \'flavor\': \'„Die Riesen folgen dem Ätherfluss. Und zweimal im Jahr führt er sie hier durch. Lektion gelernt. Wir müssen mehr Platz schaffen." —Sram, Leitender Konstrukteur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418504&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04ddc97b-146c-4ef2-ab19-869be9201e45\', \'multiverseId\': 418504}, \'multiverseid\': 418504}, {\'name\': \'Gigante descontrolado\', \'text\': \'Amenaza.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'"Los gigantes siguen la estela del éter y migran aquí dos veces al año. Lección aprendida: necesitamos más espacio". —Sram, edificador experto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420352&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'415fcc2c-b45d-40d0-ba06-2c6d5289a718\', \'multiverseId\': 420352}, \'multiverseid\': 420352}, {\'name\': \'Géant rétif\', \'text\': \'Menace\', \'type\': \'Créature : géant\', \'flavor\': "« Les géants suivent le flux de l\'Éther, qui les conduit ici deux fois par an. Nous avons retenu la leçon : la hauteur est un paramètre essentiel. » —Sram, édificateur principal", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04377e5f-7e58-49c5-8931-24aa16d3fb72\', \'multiverseId\': 418768}, \'multiverseid\': 418768}, {\'name\': \'Gigante Fuori Controllo\', \'text\': \'Minacciare\', \'type\': \'Creatura — Gigante\', \'flavor\': \'"I giganti seguono il flusso dell\\\'etere, che due volte l\\\'anno li conduce qui. Abbiamo imparato la lezione: servono archi più alti." —Sram, edificatore capo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419032&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e77c14e-1902-49e6-9055-a988281a05e5\', \'multiverseId\': 419032}, \'multiverseid\': 419032}, {\'name\': \'むら気な巨人\', \'text\': \'威迫\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'「巨人は霊気の流れを追うので、年に２回ここを通ることになるのだ。この失敗から、もっと幅を広げるべきだとわかった。」 ――上級建設官、スラム\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419296&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'775adcac-3b55-4030-a02f-65adceb73796\', \'multiverseId\': 419296}, \'multiverseid\': 419296}, {\'name\': \'방종한 거인\', \'text\': \'호전적\', \'type\': \'생물 — 거인\', \'flavor\': \'"거인들은 에테르 흐름을 따라다니고, 에테르 흐름은 일 년에 두 번 이곳을 통과하지. 한 가지 배웠군. 길의 폭을 더 넓혀야 해." —수석 건축가 스람\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419560&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'16ad4826-1476-471d-b2e3-4fb8231ed0cb\', \'multiverseId\': 419560}, \'multiverseid\': 419560}, {\'name\': \'Gigante Errático\', \'text\': \'Ameaçar\', \'type\': \'Criatura — Gigante\', \'flavor\': \'"Os gigantes seguem o fluxo do éter, e duas vezes por ano ele os traz para cá. Aprendemos a lição. É preciso abrir mais espaço." — Sram, edificador sênior\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419824&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c4d0c33a-887d-4a8d-93e2-df3ae056e6a5\', \'multiverseId\': 419824}, \'multiverseid\': 419824}, {\'name\': \'Своенравный Гигант\', \'text\': \'Угроза\', \'type\': \'Существо — Гигант\', \'flavor\': \'«Гиганты следуют за потоками эфира, и дважды в год те приводят их сюда. Все ясно. Нужно сделать проход пошире». — старший градостроитель Эсрам\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420088&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a84c6683-54f4-4182-94bf-de6503290374\', \'multiverseId\': 420088}, \'multiverseid\': 420088}, {\'name\': \'刚愎巨人\', \'text\': \'威慑\', \'type\': \'生物～巨人\', \'flavor\': \'「巨人随者乙太流而行，一年经过此处两次。记取教训。需要更宽敞的通行空间。」 ～资深建筑师斯勒姆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417976&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb29f257-2c27-4bc3-9ffa-ee74763d0259\', \'multiverseId\': 417976}, \'multiverseid\': 417976}, {\'name\': \'剛愎巨人\', \'text\': \'威懾\', \'type\': \'生物～巨人\', \'flavor\': \'「巨人隨者乙太流而行，一年經過此處兩次。記取教訓。需要更寬敞的通行空間。」 ～資深建築師斯勒姆\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418240&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'300bd4ed-5a56-40bb-ab0e-415f52c2da1b\', \'multiverseId\': 418240}, \'multiverseid\': 418240}]', '[{\'name\': \'Steinbruch\', \'text\': \'Der Steinbruch kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Die Renaissance der Erfinder folgte direkt auf den großen Äther-Boom und ließ die Nachfrage nach Rohmaterialien aller Art in die Höhe schnellen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420512&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'964c5eb9-acd4-4d26-93d9-d62e0343b5cf\', \'multiverseId\': 420512}, \'multiverseid\': 420512}, {\'name\': \'Pedrera\', \'text\': \'La Pedrera entra al campo de batalla girada.\\n{T}: Agrega {R} o {W} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'El Renacimiento de los inventores llegó poco después del gran auge del éter, que aumentó la demanda de materias primas de todo tipo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420582&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1377103f-4247-4756-ad70-cb6d751f1fce\', \'multiverseId\': 420582}, \'multiverseid\': 420582}, {\'name\': \'Carrière de pierre\', \'text\': \'La Carrière de pierre arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {R} ou {W} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "La Renaissance des inventeurs a commencé peu après l\'Essor de l\'Éther, augmentant la demande de matières premières de toute sorte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420522&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'542ff812-d5be-4926-b670-b5cc9163a043\', \'multiverseId\': 420522}, \'multiverseid\': 420522}, {\'name\': \'Cava di Pietra\', \'text\': \'La Cava di Pietra entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {R} o {W} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "Il Rinascimento degli Inventori fiorì sulla scia del Grande Boom dell\'Etere, causando un picco nella domanda di materie prime di ogni genere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420532&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9ef52e63-8b82-46c0-a8ad-c14dcb0c8bda\', \'multiverseId\': 420532}, \'multiverseid\': 420532}, {\'name\': \'採石場\', \'text\': \'採石場はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{R}か{W}を加える。\', \'type\': \'土地\', \'flavor\': \'発明家の復興は霊気ブーム最盛期の後にやってきたため、あらゆる原材料の需要が高まった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420542&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fff7b0bb-c431-42ae-9bd8-ebdbe34b45b9\', \'multiverseId\': 420542}, \'multiverseid\': 420542}, {\'name\': \'채석장\', \'text\': \'채석장은 탭된 채로 전장에 들어온다.\\n{T}: {R} 또는 {W}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'에테르 대폭발 직후에 발명가들의 르네상스가 도래했고, 이후 모든 종류의 원자재에 대한 수요가 급증했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420552&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'517b7f50-a74f-4cb7-8761-a33514c27b16\', \'multiverseId\': 420552}, \'multiverseid\': 420552}, {\'name\': \'Pedreira\', \'text\': \'Pedreira entra no campo de batalha virada.\\n{T}: Adicione {R} ou {W} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'O Renascimento dos Inventores veio no rastro da Grande Explosão do Éter, aumentando a demanda de matérias primas de todos os tipos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420562&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f95a14e6-2a40-4bd4-b7b9-bc011ad94d84\', \'multiverseId\': 420562}, \'multiverseid\': 420562}, {\'name\': \'Каменоломня\', \'text\': \'Каменоломня выходит на поле битвы повернутой.\\n{T}: добавьте {R} или {W} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'За Великим эфирным бумом пришла эпоха расцвета изобретателей, и спрос на разного рода сырье взлетел до небес.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420572&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4d7180f7-d961-4259-afc4-d53de22cf418\', \'multiverseId\': 420572}, \'multiverseid\': 420572}, {\'name\': \'采石场\', \'text\': \'采石场须横置进战场。\\n{T}：加{R}或{W}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'乙太兴旺后引发了创意复兴，让各类原料的需求急速攀升。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420492&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae3b65b0-11c0-4387-91b4-a79c4c427953\', \'multiverseId\': 420492}, \'multiverseid\': 420492}, {\'name\': \'採石場\', \'text\': \'採石場須橫置進戰場。\\n{T}：加{R}或{W}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'乙太興旺後引發了創意復興，讓各類原料的需求急速攀升。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420502&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cea19923-ac96-464d-9319-cf6fe6972055\', \'multiverseId\': 420502}, \'multiverseid\': 420502}]', '[{\'name\': \'Stirb jung\', \'text\': \'Bestimme eine Kreatur deiner Wahl. Du erhältst {E}{E} (zwei Energiemarken), dann kannst du eine beliebige Menge {E} bezahlen. Die bestimmte Kreatur erhält für jede auf diese Weise bezahlte {E} -1/-1 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'„Wenn die Zeit gekommen ist, lass los. Nichts währt ewig."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418441&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7edceb5a-1f84-4b79-b76d-d454104fb0bf\', \'multiverseId\': 418441}, \'multiverseid\': 418441}, {\'name\': \'Tempus fugit\', \'text\': \'Elige una criatura objetivo. Obtienes {E}{E} (dos contadores de energía). Luego puedes pagar cualquier cantidad de {E}. La criatura obtiene -1/-1 hasta el final del turno por cada {E} pagado de esta manera.\', \'type\': \'Conjuro\', \'flavor\': \'"Cuando llegue el momento, no te resistas. Nada dura eternamente".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420289&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'744dfc73-ebfb-41a3-8c94-ad8ee65edea7\', \'multiverseId\': 420289}, \'multiverseid\': 420289}, {\'name\': \'Mourir jeune\', \'text\': "Choisissez une créature ciblée. Vous gagnez {E}{E} (deux marqueurs « énergie »), puis vous pouvez payer n\'importe quelle quantité de {E}. La créature gagne -1/-1 jusqu\'à la fin du tour pour chaque {E} payé de cette manière.", \'type\': \'Rituel\', \'flavor\': "« Quand viendra l\'heure, lâchez prise. Rien n\'est éternel. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418705&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b819845-105a-4eb3-bd20-10ceb9354d03\', \'multiverseId\': 418705}, \'multiverseid\': 418705}, {\'name\': \'Morte Anticipata\', \'text\': \'Scegli una creatura bersaglio. Ottieni {E}{E} (due segnalini energia), poi puoi pagare un qualsiasi ammontare di {E}. La creatura prende -1/-1 fino alla fine del turno per ogni {E} pagato in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': \'"Quando giunge la tua ora, arrenditi. Niente dura per sempre."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418969&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61d9b763-5caa-4515-918d-20a2a14bd1b0\', \'multiverseId\': 418969}, \'multiverseid\': 418969}, {\'name\': \'短命\', \'text\': \'クリーチャー１体を対象とする。あなたは{E}{E}（エネルギー・カウンター２個）を得る。その後あなたは望む数の{E}を支払ってもよい。ターン終了時まで、そのクリーチャーは、これにより支払われた{E}１個につき－１/－１の修整を受ける。\', \'type\': \'ソーサリー\', \'flavor\': \'「その時が来たら諦めろ。永遠なんてない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419233&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'14b4bd28-485c-40e6-9142-d6059e2e7ae4\', \'multiverseId\': 419233}, \'multiverseid\': 419233}, {\'name\': \'요절\', \'text\': \'생물을 목표로 정한다. 당신은 {E}{E}(에너지 카운터 두 개)를 얻은 후, 원하는 만큼 {E}를 지불할 수 있다. 그 생물은 이렇게 지불된 {E}마다 턴종료까지 -1/-1을 받는다.\', \'type\': \'집중마법\', \'flavor\': \'"때가 되면 놓아 주십시오. 영원한 것은 없습니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419497&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8cb7a2bf-6f55-4971-a251-a0ab2d2278c9\', \'multiverseId\': 419497}, \'multiverseid\': 419497}, {\'name\': \'Morrer Jovem\', \'text\': \'Escolha uma criatura alvo. Você recebe {E}{E} (dois marcadores de energia) e, em seguida, você pode pagar qualquer quantidade de {E}. A criatura recebe -1/-1 até o final do turno para cada {E} pago desta forma.\', \'type\': \'Feitiço\', \'flavor\': \'"Quando a hora chegar, desapegue-se. Nada é para sempre."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419761&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b0f49f74-3b8c-4865-988b-71a837a7974c\', \'multiverseId\': 419761}, \'multiverseid\': 419761}, {\'name\': \'Умри Молодым\', \'text\': \'Выберите целевое существо. Вы получаете {E}{E} (два жетона энергии), затем вы можете заплатить любое количество {E}. То существо получает -1/-1 до конца хода за каждый {E}, заплаченный таким образом.\', \'type\': \'Волшебство\', \'flavor\': \'«Когда приходит время, смирись. Ничто не длится вечно».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420025&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5cc40cc0-b674-46b0-8353-e1edf8d81812\', \'multiverseId\': 420025}, \'multiverseid\': 420025}, {\'name\': \'英年早逝\', \'text\': \'选择目标生物。你得到{E}{E}（两个能量指示物），然后你可以支付任意数量的{E}。每以此法支付一个{E}，该生物便得-1/-1直到回合结束。\', \'type\': \'法术\', \'flavor\': \'「寿数将尽时，便顺其自然。万物皆有终了时。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417913&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a001dcaa-a5f9-4f2c-a6dd-fb22f580c4a3\', \'multiverseId\': 417913}, \'multiverseid\': 417913}, {\'name\': \'英年早逝\', \'text\': \'選擇目標生物。你得到{E}{E}（兩個能量指示物），然後你可以支付任意數量的{E}。每以此法支付一個{E}，該生物便得-1/-1直到回合結束。\', \'type\': \'巫術\', \'flavor\': \'「壽數將盡時，便順其自然。萬物皆有終了時。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418177&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1dd98bcd-b1e2-4743-899d-ad3660b315ce\', \'multiverseId\': 418177}, \'multiverseid\': 418177}]', '[{\'name\': \'Strenge Überprüfung\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst davon eine Kreaturenkarte. Der Spieler wirft die bestimmte Karte ab. Hellsicht 1.\', \'type\': \'Hexerei\', \'flavor\': \'„Wenn du nichts Falsches getan hast, hast du nichts zu befürchten." —Oberster Vollstrecker Ranaj\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418450&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a4bb4ff9-60e4-431e-80fe-2620b25883df\', \'multiverseId\': 418450}, \'multiverseid\': 418450}, {\'name\': \'Escrutinio riguroso\', \'text\': \'El oponente objetivo muestra su mano. Tú eliges de ahí una carta de criatura. Ese jugador descarta esa carta. Adivina 1.\', \'type\': \'Conjuro\', \'flavor\': \'"Si no hiciste nada malo, no tienes nada que temer". —Ranaj, brazo ejecutor de la ley\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420298&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07a6104e-43a4-4f46-91c8-e5e1ed5d29b3\', \'multiverseId\': 420298}, \'multiverseid\': 420298}, {\'name\': \'Examen attentif\', \'text\': "L\'adversaire ciblé révèle sa main. Vous y choisissez une carte de créature. Ce joueur se défausse de cette carte. Regard 1.", \'type\': \'Rituel\', \'flavor\': "« Si vous n\'avez rien à vous reprocher, vous n\'avez rien à craindre. » —Ranaj, argousin en chef", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418714&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af07fe50-a232-4532-a9a1-9fabfc1045b6\', \'multiverseId\': 418714}, \'multiverseid\': 418714}, {\'name\': \'Scrutinio Severo\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta creatura da quella mano. Quel giocatore scarta quella carta. Profetizza 1.\', \'type\': \'Stregoneria\', \'flavor\': \'"Se non hai fatto nulla di male, non hai nulla da temere." —Ranaj, esecutore capo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418978&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7aca8424-4729-4313-9e66-c8a19f2e10d4\', \'multiverseId\': 418978}, \'multiverseid\': 418978}, {\'name\': \'過酷な精査\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはその中からクリーチャー・カード１枚を選ぶ。そのプレイヤーはそのカードを捨てる。占術１を行う。\', \'type\': \'ソーサリー\', \'flavor\': \'「何も悪いことをしていないなら、何も心配する必要はありません。」 ――執行官長、ラナージ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419242&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'09190b80-7dbd-45e5-9ca2-bfb304d12846\', \'multiverseId\': 419242}, \'multiverseid\': 419242}, {\'name\': \'가혹한 조사\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 당신은 그 중 생물 카드 한 장을 선택한다. 그 플레이어는 그 카드를 버린다. 점술 1을 한다.\', \'type\': \'집중마법\', \'flavor\': \'"잘못한 것이 없다면 두려워할 것도 없다." —최고 집행자 라나지\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419506&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05f9c91a-fea4-476d-893b-2492120dbe92\', \'multiverseId\': 419506}, \'multiverseid\': 419506}, {\'name\': \'Escrutínio Rigoroso\', \'text\': \'O oponente alvo revela a própria mão. Você escolhe um card de criatura dela. Aquele jogador descarta aquele card. Vidência 1.\', \'type\': \'Feitiço\', \'flavor\': \'"Se você não fez nada de errado, não tem nada a temer." — Ranaj, Chefe de Policiamento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419770&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'28607ac9-cad1-4217-8bd0-c1015ca3b17b\', \'multiverseId\': 419770}, \'multiverseid\': 419770}, {\'name\': \'Тщательное Рассмотрение\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете из нее карту существа. Тот игрок сбрасывает ту карту. Предскажите 1.\', \'type\': \'Волшебство\', \'flavor\': \'«Если ты ничего не нарушил, то тебе и бояться нечего». — старший блюститель Ранадж\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420034&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'59d1d2f6-dcc0-4f1c-aa2c-b3ca701c71b3\', \'multiverseId\': 420034}, \'multiverseid\': 420034}, {\'name\': \'严加审查\', \'text\': \'目标对手展示其手牌。你选择其中一张生物牌。该牌手弃掉该牌。占卜1。\', \'type\': \'法术\', \'flavor\': \'「只要你没犯错，就没什么好怕的。」 ～执法长拉纳吉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417922&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62bac8b5-9101-48bc-b784-09ca8adb25b6\', \'multiverseId\': 417922}, \'multiverseid\': 417922}, {\'name\': \'嚴加審查\', \'text\': \'目標對手展示其手牌。你選擇其中一張生物牌。該玩家棄掉該牌。占卜1。\', \'type\': \'巫術\', \'flavor\': \'「只要你沒犯錯，就沒什麼好怕的。」 ～執法長拉納吉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418186&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cd26639d-7055-4adc-a428-3d94f6edef1c\', \'multiverseId\': 418186}, \'multiverseid\': 418186}]', '[{\'name\': \'Strömender Mechakoloss\', \'text\': \'Aufblitzen\\nWenn der Strömende Mechakoloss ins Spiel kommt, kannst du eine Spontanzauberkarte deiner Wahl aus deinem Friedhof wirken, ohne ihre Manakosten zu bezahlen. Falls die Karte in diesem Zug auf deinen Friedhof gelegt würde, schicke sie stattdessen ins Exil.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418432&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6119f888-60aa-46f3-9277-b49f3f28c864\', \'multiverseId\': 418432}, \'multiverseid\': 418432}, {\'name\': \'Mecatitán torrencial\', \'text\': \'Destello.\\nCuando el Mecatitán torrencial entre al campo de batalla, puedes lanzar la carta de instantáneo objetivo de tu cementerio sin pagar su coste de maná. Si esa carta fuera a ser puesta en tu cementerio este turno, en vez de eso, exíliala.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420280&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d0f0e50-673a-46c9-8e79-5f817c0658ce\', \'multiverseId\': 420280}, \'multiverseid\': 420280}, {\'name\': \'Carcasse mécanique torrentielle\', \'text\': "Flash\\nQuand la Carcasse mécanique torrentielle arrive sur le champ de bataille, vous pouvez lancer une carte d\'éphémère ciblée depuis votre cimetière sans payer son coût de mana. Si cette carte devait être mise dans votre cimetière ce tour-ci, exilez-la à la place.", \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418696&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2719484-b6ee-47c0-bf70-16dceceb8374\', \'multiverseId\': 418696}, \'multiverseid\': 418696}, {\'name\': \'Meccatitano Torrenziale\', \'text\': \'Lampo\\nQuando il Meccatitano Torrenziale entra nel campo di battaglia, puoi lanciare una carta istantaneo bersaglio dal tuo cimitero senza pagare il suo costo di mana. Se quella carta sta per essere messa nel tuo cimitero in questo turno, invece esiliala.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418960&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4dbcd06-40f2-4887-becf-f3042b3ed76b\', \'multiverseId\': 418960}, \'multiverseid\': 418960}, {\'name\': \'奔流の機械巨人\', \'text\': \'瞬速\\n奔流の機械巨人が戦場に出たとき、あなたの墓地からインスタント・カード１枚を対象とする。あなたはそれを、そのマナ・コストを支払うことなく唱えてもよい。このターンにそのカードがあなたの墓地に置かれるなら、代わりにそれを追放する。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419224&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ea92d24-d066-4e9a-947f-69cc45b9f754\', \'multiverseId\': 419224}, \'multiverseid\': 419224}, {\'name\': \'격류의 톱니거신병\', \'text\': \'섬광\\n격류의 톱니거신병이 전장에 들어올 때, 당신의 무덤에 있는 순간마법 카드를 목표로 정한다. 당신은 마나 비용을 지불하지 않고 그 카드를 발동할 수 있다. 그 카드가 이 턴에 당신의 무덤에 들어가려고 하면, 대신에 그 카드를 추방한다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419488&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'383cdbfa-8b8b-4429-8286-5997fa7b1082\', \'multiverseId\': 419488}, \'multiverseid\': 419488}, {\'name\': \'Mecanotitã Torrencial\', \'text\': \'Lampejo\\nQuando Mecanotitã Torrencial entra no campo de batalha, você pode conjurar o card de mágica instantânea alvo do seu cemitério sem pagar seu custo de mana. Se aquele card seria colocado no seu cemitério neste turno, em vez disso, exile-o.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419752&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d5b8136-423e-49e6-97b3-57429fdf0ffa\', \'multiverseId\': 419752}, \'multiverseid\': 419752}, {\'name\': \'Мехагигант Потоков\', \'text\': \'Миг\\nКогда Мехагигант Потоков выходит на поле битвы, вы можете разыграть целевую карту мгновенного заклинания из вашего кладбища без уплаты ее мана-стоимости. Если та карта должна быть положена на ваше кладбище в этом ходу, изгоните ее вместо этого.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420016&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16057973-713c-4372-b06c-6d8bccc2b20a\', \'multiverseId\': 420016}, \'multiverseid\': 420016}, {\'name\': \'汹涌巨械\', \'text\': \'闪现\\n当汹涌巨械进战场时，你可以从你的坟墓场施放目标瞬间牌，且不需支付其法术力费用。如果该牌于本回合中将置入你的坟墓场，则改为将其放逐。\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'78661628-e1de-4750-ac80-a7ca106d01b6\', \'multiverseId\': 417904}, \'multiverseid\': 417904}, {\'name\': \'洶湧巨械\', \'text\': \'閃現\\n當洶湧巨械進戰場時，你可以從你的墳墓場施放目標瞬間牌，且不需支付其魔法力費用。如果該牌於本回合中將置入你的墳墓場，則改為將其放逐。\', \'type\': \'神器生物～組構體\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418168&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3d3430c1-1339-459a-8efa-9ed5268b96fc\', \'multiverseId\': 418168}, \'multiverseid\': 418168}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418621&type=card', 'language': 'German', 'identifiers': {'scryfallId': '94260dc6-9095-454c-85de-a724125555a6', 'multiverseId': 418621}, 'multiverseid': 418621}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420469&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2c53e5da-bdc2-4ab3-a744-4e9ef7cfd19b', 'multiverseId': 420469}, 'multiverseid': 420469}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418885&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5ed4fc7f-e1ed-4ee4-9b9c-43c4b922ecea', 'multiverseId': 418885}, 'multiverseid': 418885}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419149&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '47be1540-2d31-4e69-9010-4e11c5010787', 'multiverseId': 419149}, 'multiverseid': 419149}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419413&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '85024e29-910a-4023-840f-103a4a88cc5e', 'multiverseId': 419413}, 'multiverseid': 419413}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419677&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '8aac89ca-a351-4a0c-b491-cad650822d7d', 'multiverseId': 419677}, 'multiverseid': 419677}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419941&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1b6bfabd-8d2c-4184-a3d7-740f923830cd', 'multiverseId': 419941}, 'multiverseid': 419941}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420205&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '619fb36c-2247-4cfd-a2f5-bafa68c74800', 'multiverseId': 420205}, 'multiverseid': 420205}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418093&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ebeb4165-f4af-4fee-b0fe-fab79ba3a113', 'multiverseId': 418093}, 'multiverseid': 418093}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418357&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '3fcfb864-489a-4e39-a0b7-6a1af8a0be25', 'multiverseId': 418357}, 'multiverseid': 418357}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418622&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5d1752db-5c74-436f-95ba-cf00366f3787', 'multiverseId': 418622}, 'multiverseid': 418622}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420470&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '313daa79-1953-4a5f-8357-463a59848b7b', 'multiverseId': 420470}, 'multiverseid': 420470}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418886&type=card', 'language': 'French', 'identifiers': {'scryfallId': '17c0ff96-f89f-4279-b4f3-6d6a640fab79', 'multiverseId': 418886}, 'multiverseid': 418886}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419150&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dcbb869f-0838-4e3c-9808-ba0d5e7162c9', 'multiverseId': 419150}, 'multiverseid': 419150}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419414&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd35fb826-1e69-4742-89d6-26901ec081a6', 'multiverseId': 419414}, 'multiverseid': 419414}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419678&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'f673d63d-ea86-4499-8634-ca1fce46cb0f', 'multiverseId': 419678}, 'multiverseid': 419678}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419942&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fdfd83cd-97c4-4246-aea1-fc65a16416de', 'multiverseId': 419942}, 'multiverseid': 419942}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420206&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '15f307ba-9b40-489d-ae8a-9804d43bf68d', 'multiverseId': 420206}, 'multiverseid': 420206}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418094&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '03c890d6-2e21-4648-90ed-9c42d85d5f76', 'multiverseId': 418094}, 'multiverseid': 418094}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418358&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'a2f00fac-8f3b-4e8a-b10b-68da4394805e', 'multiverseId': 418358}, 'multiverseid': 418358}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418623&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6775e06e-5614-4fce-a383-2919b247a573', 'multiverseId': 418623}, 'multiverseid': 418623}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420471&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7fbd30dd-dbce-4f92-8859-a4553c76a901', 'multiverseId': 420471}, 'multiverseid': 420471}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418887&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f20b2bd8-8f59-45df-aa87-621f8b8d2908', 'multiverseId': 418887}, 'multiverseid': 418887}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419151&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '99a7f4e2-d8c9-4db7-af00-a8f30fedd9b4', 'multiverseId': 419151}, 'multiverseid': 419151}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419415&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '108d577d-5580-42d1-8e96-eb5da944e275', 'multiverseId': 419415}, 'multiverseid': 419415}, {'name': '늪', 'type': '기본 대지 — 늪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419679&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '053a7b1c-a974-48b6-b743-7711b28df957', 'multiverseId': 419679}, 'multiverseid': 419679}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419943&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cc3e8892-872e-45a3-806b-5ec99b3f94db', 'multiverseId': 419943}, 'multiverseid': 419943}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420207&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4f41536a-3197-4555-8bbf-0d414bf8e992', 'multiverseId': 420207}, 'multiverseid': 420207}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418095&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '039c81d6-375a-4b45-9550-d810822ff260', 'multiverseId': 418095}, 'multiverseid': 418095}, {'name': '沼澤', 'type': '基本地～沼澤', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418359&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '914dbe26-c427-415d-9cec-c72a84e8ec10', 'multiverseId': 418359}, 'multiverseid': 418359}]", '[{\'name\': \'Technisierte Macht\', \'text\': \'Bestimme eines —\\n• Eine Kreatur deiner Wahl erhält +5/+5 und verursacht Trampelschaden bis zum Ende des Zuges.\\n• Kreaturen, die du kontrollierst, erhalten +2/+2 und Wachsamkeit bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418546&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4db4a598-7b25-4a5b-90b7-956343d82efb\', \'multiverseId\': 418546}, \'multiverseid\': 418546}, {\'name\': \'Ingeniería aplicada\', \'text\': \'Elige uno:\\n• La criatura objetivo obtiene +5/+5 y gana la habilidad de arrollar hasta el final del turno.\\n• Las criaturas que controlas obtienen +2/+2 y ganan la habilidad de vigilancia hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420394&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e0a1de91-6353-4773-a1e5-d82ee2935e6b\', \'multiverseId\': 420394}, \'multiverseid\': 420394}, {\'name\': \'Puissance artificielle\', \'text\': "Choisissez l\'un —\\n• La créature ciblée gagne +5/+5 et acquiert le piétinement jusqu\'à la fin du tour.\\n• Les créatures que vous contrôlez gagnent +2/+2 et acquièrent la vigilance jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418810&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e032adee-4d0d-4657-a46f-d86ec35000ea\', \'multiverseId\': 418810}, \'multiverseid\': 418810}, {\'name\': \'Potenza Ingegnerizzata\', \'text\': \'Scegli uno —\\n• Una creatura bersaglio prende +5/+5 e ha travolgere fino alla fine del turno.\\n• Le creature che controlli prendono +2/+2 e hanno cautela fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419074&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f76ba7ce-468a-4c2f-8edd-358024218db5\', \'multiverseId\': 419074}, \'multiverseid\': 419074}, {\'name\': \'品種改良の力\', \'text\': \'以下から１つを選ぶ。\\n• クリーチャー１体を対象とする。ターン終了時まで、それは＋５/＋５の修整を受けるとともにトランプルを得る。\\n• ターン終了時まで、あなたがコントロールするクリーチャーは＋２/＋２の修整を受けるとともに警戒を得る。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419338&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5df9c8d6-47ae-40e1-be42-5b560f792c4d\', \'multiverseId\': 419338}, \'multiverseid\': 419338}, {\'name\': \'공학의 힘\', \'text\': \'하나를 선택한다 —\\n• 생물을 목표로 정한다. 그 생물은 턴종료까지 +5/+5를 받고 돌진을 얻는다.\\n• 당신이 조종하는 생물들은 턴종료까지 +2/+2를 받고 경계를 얻는다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419602&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'15e43b2f-9f86-4b51-9812-f8b40f2cb5cf\', \'multiverseId\': 419602}, \'multiverseid\': 419602}, {\'name\': \'Poder Fabricado\', \'text\': \'Escolha um —\\n• A criatura alvo recebe +5/+5 e ganha atropelar até o final do turno.\\n• As criaturas que você controla recebem +2/+2 e ganham vigilância até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'798fa59b-3de5-4b24-989e-302b95c2da4c\', \'multiverseId\': 419866}, \'multiverseid\': 419866}, {\'name\': \'Рукотворная Мощь\', \'text\': \'Выберите одно —\\n• Целевое существо получает +5/+5 и Пробивной удар до конца хода.\\n• Существа под вашим контролем получают +2/+2 и Бдительность до конца хода.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420130&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3337c37a-13ce-4620-a903-4059fd7cb780\', \'multiverseId\': 420130}, \'multiverseid\': 420130}, {\'name\': \'可控之威\', \'text\': \'选择一项～\\n•直到回合结束，目标生物得+5/+5且获得践踏异能。\\n•直到回合结束，由你操控的生物得+2/+2且获得警戒异能。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8986ad54-5b13-451e-82f5-e683851b6023\', \'multiverseId\': 418018}, \'multiverseid\': 418018}, {\'name\': \'可控之威\', \'text\': \'選擇一項～\\n•直到回合結束，目標生物得+5/+5且獲得踐踏異能。\\n•直到回合結束，由你操控的生物得+2/+2且獲得警戒異能。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418282&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'52fd5a70-7581-4de0-93a0-089c4ef18b8e\', \'multiverseId\': 418282}, \'multiverseid\': 418282}]', '[{\'name\': \'Teuflischer Lehrmeister\', \'text\': \'Durchsuche deine Bibliothek nach einer Karte und nimm sie auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Zeig es ihnen. Zeig ihnen, wie heiß dein Feuer brennen kann." —Liliana Vess zu Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418440&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f18b2eba-c9ff-4839-8d3d-de719e6a8f4b\', \'multiverseId\': 418440}, \'multiverseid\': 418440}, {\'name\': \'Tutor diabólico\', \'text\': \'Busca una carta en tu biblioteca y ponla en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"Muéstraselo. Muéstrales cuánto puede arder tu fuego". —Liliana Vess, a Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420288&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59f65db4-cf06-420e-9ce9-f520fd00305a\', \'multiverseId\': 420288}, \'multiverseid\': 420288}, {\'name\': \'Précepteur démoniaque\', \'text\': \'Cherchez une carte dans votre bibliothèque et mettez cette carte dans votre main. Mélangez ensuite votre bibliothèque.\', \'type\': \'Rituel\', \'flavor\': "« Montre-leur. Montre-leur l\'intensité de tes flammes. » —Liliana Vess, à Chandra Nalaàr", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418704&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fbc72153-3d2e-4880-8205-fa48699b3dfa\', \'multiverseId\': 418704}, \'multiverseid\': 418704}, {\'name\': \'Tutore Diabolico\', \'text\': \'Passa in rassegna il tuo grimorio per una carta e aggiungila alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Mostraglielo. Mostra loro quanto possono essere incandescenti le tue fiamme." —Liliana Vess a Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418968&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e134d42d-186a-4dd2-84f2-ba144bde29bc\', \'multiverseId\': 418968}, \'multiverseid\': 418968}, {\'name\': \'魔性の教示者\', \'text\': \'あなたのライブラリーからカード１枚を探し、そのカードをあなたの手札に加える。その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'「あなたの炎がどれほど熱いか思い知らせてやるのよ。」 ――リリアナ・ヴェスからチャンドラ・ナラーへ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419232&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9458666b-6200-47d7-b5c4-a0ee7dbb5537\', \'multiverseId\': 419232}, \'multiverseid\': 419232}, {\'name\': \'극악한 자의 가르침\', \'text\': \'당신의 서고에서 원하는 카드 한 장을 찾아 당신의 손으로 가져간다. 그러고 나서 당신의 서고를 섞는다.\', \'type\': \'집중마법\', \'flavor\': \'"해 버려. 그들에게 네 화염이 얼마나 뜨거운 지 보여 줘." —릴리아나 베스가 찬드라 날라르에게\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419496&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'915ce1b3-1ddc-4afb-ac9d-d6ee74f9e1e0\', \'multiverseId\': 419496}, \'multiverseid\': 419496}, {\'name\': \'Tutor Diabólico\', \'text\': \'Procure um card em seu grimório e coloque aquele card em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"Mostre a eles. Mostre a eles o quanto seu fogo pode arder." — Liliana Vess, para Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a427511a-341b-4684-ab22-4d40067779c5\', \'multiverseId\': 419760}, \'multiverseid\': 419760}, {\'name\': \'Дьявольский Наставник\', \'text\': \'Найдите в вашей библиотеке карту и положите ту карту в вашу руку. Затем перетасуйте вашу библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'«Покажи им. Покажи им, как жарко может гореть твое пламя». — Лилиана Весс, обращаясь к Чандре Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420024&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'364bf657-03f5-4615-b6be-81a6b6d283bb\', \'multiverseId\': 420024}, \'multiverseid\': 420024}, {\'name\': \'恶魔导师\', \'text\': \'从你的牌库中搜寻一张牌并置于你手上。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'「露一手给他们看。让他们瞧瞧你的烈焰能烧到多旺。」 ～莉莲娜维斯告诉茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417912&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7749328e-208c-46f5-8fe0-ed3312bae62f\', \'multiverseId\': 417912}, \'multiverseid\': 417912}, {\'name\': \'惡魔導師\', \'text\': \'從你的牌庫中搜尋一張牌並置於你手上。然後將你的牌庫洗牌。\', \'type\': \'巫術\', \'flavor\': \'「露一手給他們看。讓他們瞧瞧妳的烈焰能燒到多旺。」 ～莉蓮娜維斯告訴茜卓納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418176&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'53b500f0-a597-4aaa-afc6-005d12c13852\', \'multiverseId\': 418176}, \'multiverseid\': 418176}]', '[{\'name\': \'Tezzerets Ambitionen\', \'text\': \'Ziehe drei Karten. Falls du kein Artefakt kontrollierst, wirf eine Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Um zu erreichen, was niemand zuvor erreicht hat, muss man wagen, was niemand zuvor gewagt hat."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418430&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'85954553-95df-4376-8033-7fe1dd31a723\', \'multiverseId\': 418430}, \'multiverseid\': 418430}, {\'name\': \'Ambición de Tezzeret\', \'text\': \'Roba tres cartas. Si no controlas ningún artefacto, descarta una carta.\', \'type\': \'Conjuro\', \'flavor\': \'"Para conseguir lo que nadie ha conseguido antes, hay que atreverse a lo que nadie se ha atrevido".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c1f52e2-a9c8-4cd3-a3a8-7902299bbe0e\', \'multiverseId\': 420278}, \'multiverseid\': 420278}, {\'name\': \'Ambitions de Tezzeret\', \'text\': "Piochez trois cartes. Si vous ne contrôlez aucun artefact, défaussez-vous d\'une carte.", \'type\': \'Rituel\', \'flavor\': "« Pour accomplir ce que personne n\'a jamais accompli, il faut oser ce que personne n\'a jamais osé. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418694&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad49f723-05c1-4c9e-a1f8-c77badd69968\', \'multiverseId\': 418694}, \'multiverseid\': 418694}, {\'name\': \'Ambizione di Tezzeret\', \'text\': \'Pesca tre carte. Se non controlli artefatti, scarta una carta.\', \'type\': \'Stregoneria\', \'flavor\': \'"Per compiere ciò che nessuno ha compiuto finora, è necessario osare ciò che nessun altro ha mai osato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418958&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a0147cea-f387-46dd-a280-70fa120da8fd\', \'multiverseId\': 418958}, \'multiverseid\': 418958}, {\'name\': \'テゼレットの野望\', \'text\': \'カードを３枚引く。あなたがアーティファクトをコントロールしていないなら、カード１枚を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「今まで誰も成し遂げていないことを成し遂げたければ、今まで誰もやる勇気のなかったことをやらねばならない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419222&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'853ab922-1c87-44da-abab-366deda2f305\', \'multiverseId\': 419222}, \'multiverseid\': 419222}, {\'name\': \'테제렛의 야망\', \'text\': \'카드 세 장을 뽑는다. 당신이 마법물체를 조종하지 않는다면, 카드 한 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'"아무도 성취하지 못한 것을 성취하려면, 아무도 시도하지 않은 것에 도전해야 한다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419486&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'05efe503-f545-4a01-8f17-76be019274eb\', \'multiverseId\': 419486}, \'multiverseid\': 419486}, {\'name\': \'Ambição de Tezzeret\', \'text\': \'Compre três cards. Se você não controlar nenhum artefato, descarte um card.\', \'type\': \'Feitiço\', \'flavor\': \'"Para conseguir o que ninguém nunca conseguiu é preciso ousar o que ninguém nunca ousou."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419750&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d1579ed-fb2d-4c1c-bf40-0dcaf41ce04c\', \'multiverseId\': 419750}, \'multiverseid\': 419750}, {\'name\': \'Притязания Теззерета\', \'text\': \'Возьмите три карты. Если под вашим контролем нет артефактов, сбросьте карту.\', \'type\': \'Волшебство\', \'flavor\': \'«Чтобы достичь того, чего еще никому не удавалось, надо осмелиться на то, на что еще никто не осмеливался».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420014&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b08baa73-7981-4c33-a283-961602938658\', \'multiverseId\': 420014}, \'multiverseid\': 420014}, {\'name\': \'泰兹瑞的野心\', \'text\': \'抓三张牌。如果你未操控神器，则弃一张牌。\', \'type\': \'法术\', \'flavor\': \'「想要达成前人未曾达成之事，必须勇于尝试前人未敢尝试之法。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417902&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dfdeee02-fe3d-481b-bd4a-d47bb09a6a83\', \'multiverseId\': 417902}, \'multiverseid\': 417902}, {\'name\': \'泰茲瑞的野心\', \'text\': \'抽三張牌。如果你未操控神器，則棄一張牌。\', \'type\': \'巫術\', \'flavor\': \'「想要達成前人未曾達成之事，必須勇於嘗試前人未敢嘗試之法。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418166&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0bdad502-b83f-4c1f-916d-3e236d6d10a9\', \'multiverseId\': 418166}, \'multiverseid\': 418166}]', '[{\'name\': \'Todbringender Mechakoloss\', \'text\': \'Bedrohlich\\nWenn der Todbringende Mechakoloss ins Spiel kommt, kannst du eine andere Kreatur deiner Wahl zerstören. Falls eine Kreatur auf diese Weise zerstört wird, erhältst du Lebenspunkte in Höhe ihrer Widerstandskraft dazu.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418461&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed80f038-8344-403f-b69b-1a19c2348f83\', \'multiverseId\': 418461}, \'multiverseid\': 418461}, {\'name\': \'Mecatitán letal\', \'text\': \'Amenaza.\\nCuando el Mecatitán letal entre al campo de batalla, puedes destruir otra criatura objetivo. Si una criatura es destruida de esta manera, ganas una cantidad de vidas igual a su resistencia.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420309&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'65f3e82f-7839-4dc3-acea-d4407d8b4155\', \'multiverseId\': 420309}, \'multiverseid\': 420309}, {\'name\': \'Carcasse mécanique délétère\', \'text\': \'Menace\\nQuand la Carcasse mécanique délétère arrive sur le champ de bataille, vous pouvez détruire une autre créature ciblée. Si une créature est détruite de cette manière, vous gagnez un nombre de points de vie égal à son endurance.\', \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418725&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7711500-f693-4377-ad17-1eb88a844bc5\', \'multiverseId\': 418725}, \'multiverseid\': 418725}, {\'name\': \'Meccatitano Tossico\', \'text\': "Minacciare\\nQuando il Meccatitano Tossico entra nel campo di battaglia, puoi distruggere un\'altra creatura bersaglio. Se una creatura viene distrutta in questo modo, guadagni punti vita pari alla sua costituzione.", \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418989&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e27cff28-0668-4e4a-8a21-a41e68125b8a\', \'multiverseId\': 418989}, \'multiverseid\': 418989}, {\'name\': \'害悪の機械巨人\', \'text\': \'威迫\\n害悪の機械巨人が戦場に出たとき、他のクリーチャー１体を対象とする。あなたはそれを破壊してもよい。これによりクリーチャーが破壊されたなら、あなたはそれのタフネスに等しい点数のライフを得る。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419253&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e300b703-39ff-4c4a-8650-1ea57402295e\', \'multiverseId\': 419253}, \'multiverseid\': 419253}, {\'name\': \'사악한 톱니거신병\', \'text\': \'호전적\\n사악한 톱니거신병이 전장에 들어올 때, 다른 생물을 목표로 정한다. 당신은 그 생물을 파괴할 수 있다. 이렇게 생물이 파괴되었다면, 당신은 그 생물의 방어력만큼 생명점을 얻는다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419517&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'72440f80-19c9-4726-ab23-a5585c966087\', \'multiverseId\': 419517}, \'multiverseid\': 419517}, {\'name\': \'Mecanotitã Pernicioso\', \'text\': \'Ameaçar\\nQuando Mecanotitã Pernicioso entra no campo de batalha, você pode destruir outra criatura alvo. Se uma criatura é destruída desta forma, você ganha uma quantidade de pontos de vida igual a sua resistência.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419781&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'74bebf72-c8ac-4cee-9ea2-e2e8f744bbd3\', \'multiverseId\': 419781}, \'multiverseid\': 419781}, {\'name\': \'Мехагигант Заразы\', \'text\': \'Угроза\\nКогда Мехагигант Заразы выходит на поле битвы, вы можете уничтожить другое целевое существо. Если существо уничтожено таким образом, вы получаете количество жизней, равное его выносливости.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420045&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'76c0f9c7-52f3-4057-80a7-02dab2690ecc\', \'multiverseId\': 420045}, \'multiverseid\': 420045}, {\'name\': \'恶毒巨械\', \'text\': \'威慑\\n当恶毒巨械进战场时，你可以消灭另一个目标生物。若以此法消灭了生物，则你获得等同于其防御力的生命。\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417933&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5e0cc77f-4dad-40f8-91fe-928d1ad17ced\', \'multiverseId\': 417933}, \'multiverseid\': 417933}, {\'name\': \'惡毒巨械\', \'text\': \'威懾\\n當惡毒巨械進戰場時，你可以消滅另一個目標生物。若以此法消滅了生物，則你獲得等同於其防禦力的生命。\', \'type\': \'神器生物～組構體\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418197&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'69359663-95ca-4cef-b47e-368686c8737b\', \'multiverseId\': 418197}, \'multiverseid\': 418197}]', '[{\'name\': \'Treuer Begleiter\', \'text\': \'Wachsamkeit\\nDer Treue Begleiter kann nicht alleine angreifen.\', \'type\': \'Kreatur — Hyäne\', \'flavor\': \'Er zeigt Zuneigung, zu der ein Maschinenwesen niemals fähig wäre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418398&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'85ab1963-da2b-42c5-b354-a1d7642b55cb\', \'multiverseId\': 418398}, \'multiverseid\': 418398}, {\'name\': \'Compañero leal\', \'text\': \'Vigilancia.\\nEl Compañero leal no puede atacar solo.\', \'type\': \'Criatura — Hiena\', \'flavor\': \'Muestra un afecto del que es incapaz un autómata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420246&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67c6a3f0-c8ab-4653-bcaf-6a27809cbc7b\', \'multiverseId\': 420246}, \'multiverseid\': 420246}, {\'name\': \'Compagnon fidèle\', \'text\': \'Vigilance\\nLe Compagnon fidèle ne peut pas attaquer seul.\', \'type\': \'Créature : hyène\', \'flavor\': "Il fait preuve d\'une affection dont serait incapable un automate.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418662&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b2f489f-ce4f-4b2a-87c7-e25e48662875\', \'multiverseId\': 418662}, \'multiverseid\': 418662}, {\'name\': \'Compagno Fidato\', \'text\': \'Cautela\\nIl Compagno Fidato non può attaccare da solo.\', \'type\': \'Creatura — Iena\', \'flavor\': \'Dimostra un affetto di cui gli automi sono incapaci.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418926&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27f9e830-ba89-4dcc-9250-07813361c25b\', \'multiverseId\': 418926}, \'multiverseid\': 418926}, {\'name\': \'信頼できる仲間\', \'text\': \'警戒\\n信頼できる仲間は単独では攻撃できない。\', \'type\': \'クリーチャー — ハイエナ\', \'flavor\': \'その獣は自動機械にはない愛情を示す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419190&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a03fb2f5-020d-4544-b0ae-148787d15b6a\', \'multiverseId\': 419190}, \'multiverseid\': 419190}, {\'name\': \'믿을 수 있는 동료\', \'text\': \'경계\\n믿을 수 있는 동료는 혼자 공격할 수 없다.\', \'type\': \'생물 — 하이에나\', \'flavor\': \'자동장치에게선 느낄 수 없는 애정을 보여준다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419454&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'06789831-370b-45ab-9942-2eafa4583511\', \'multiverseId\': 419454}, \'multiverseid\': 419454}, {\'name\': \'Companheiro de Confiança\', \'text\': \'Vigilância\\nCompanheiro de Confiança não pode atacar sozinho.\', \'type\': \'Criatura — Hiena\', \'flavor\': \'Ele demonstra o afeto que um autômato jamais conseguiria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419718&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27c4dd34-14a9-4ea4-bb79-af0fd2271c69\', \'multiverseId\': 419718}, \'multiverseid\': 419718}, {\'name\': \'Верная Спутница\', \'text\': \'Бдительность\\nВерная Спутница не может атаковать в одиночку.\', \'type\': \'Существо — Гиена\', \'flavor\': \'Она по-настоящему привязана к хозяину. Автоматам такое недоступно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419982&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9cb15ba7-6e80-422a-a81e-b6bd74e110ba\', \'multiverseId\': 419982}, \'multiverseid\': 419982}, {\'name\': \'可靠旅伴\', \'text\': \'警戒\\n可靠旅伴不能单独进行攻击。\', \'type\': \'生物～鬣狗\', \'flavor\': \'它展现出自动机械不可能会有的情感。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417870&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46f6d83d-8f97-4166-b9be-b8209b3f8f5c\', \'multiverseId\': 417870}, \'multiverseid\': 417870}, {\'name\': \'可靠旅伴\', \'text\': \'警戒\\n可靠旅伴不能單獨進行攻擊。\', \'type\': \'生物～鬣狗\', \'flavor\': \'牠展現出自動機械不可能會有的情感。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418134&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d6bd6a35-d4e2-41d8-9e7a-871bd5dc5a10\', \'multiverseId\': 418134}, \'multiverseid\': 418134}]', '[{\'name\': \'Turbo-Straßenkreuzer\', \'text\': \'Verursacht Trampelschaden, Eile\\nWenn der Turbo-Straßenkreuzer ins Spiel kommt, wird er bis zum Ende des Zuges zu einer Artefaktkreatur.\\nBemannen 2 (Tappe eine beliebige Anzahl an Kreaturen, die du kontrollierst und die zusammen Stärke 2 oder mehr haben: Dieses Fahrzeug wird bis zum Ende des Zuges zu einer Artefaktkreatur.)\', \'type\': \'Artefakt — Fahrzeug\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418579&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72bf82bb-791c-4a09-8f79-1dc2013fd0d4\', \'multiverseId\': 418579}, \'multiverseid\': 418579}, {\'name\': \'Automotor ruedaveloz\', \'text\': \'Arrolla, prisa.\\nCuando el Automotor ruedaveloz entre al campo de batalla, se convierte en una criatura artefacto hasta el final del turno.\\nTripular 2. (Girar cualquier cantidad de criaturas que controlas con una fuerza total de 2 o más: Este Vehículo se convierte en una criatura artefacto hasta el final del turno.)\', \'type\': \'Artefacto — Vehículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb2130f2-d83a-4eb0-95fa-76de1ed58a10\', \'multiverseId\': 420427}, \'multiverseid\': 420427}, {\'name\': \'Croiseur roulevif\', \'text\': "Piétinement, célérité\\nQuand le Croiseur roulevif arrive sur le champ de bataille, il devient une créature-artefact jusqu\'à la fin du tour.\\nPilotage 2 (Engagez n\'importe quel nombre de créatures que vous contrôlez dont la force totale est supérieure ou égale à 2 : Ce véhicule devient une créature-artefact jusqu\'à la fin du tour.)", \'type\': \'Artefact : véhicule\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418843&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d877b15-34dd-414a-9011-ba17cf6a0fd3\', \'multiverseId\': 418843}, \'multiverseid\': 418843}, {\'name\': \'Navetta Ruotacelere\', \'text\': \'Travolgere, rapidità\\nQuando la Navetta Ruotacelere entra nel campo di battaglia, diventa una creatura artefatto fino alla fine del turno.\\nManovrare 2 (TAPpa un qualsiasi numero di creature che controlli con forza totale pari o superiore a 2: Questo Veicolo diventa una creatura artefatto fino alla fine del turno.)\', \'type\': \'Artefatto — Veicolo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419107&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c7a6159-1a82-4838-a344-11b36b68bb19\', \'multiverseId\': 419107}, \'multiverseid\': 419107}, {\'name\': \'高速警備車\', \'text\': \'トランプル、速攻\\n高速警備車が戦場に出たとき、ターン終了時まで、これはアーティファクト・クリーチャーになる。\\n搭乗２（あなたがコントロールする望む数のクリーチャーを、パワーの合計が２以上になるように選んでタップする：ターン終了時まで、この機体はアーティファクト・クリーチャーになる。）\', \'type\': \'アーティファクト — 機体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419371&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'917e48fe-f867-4e6c-be43-ab62e214012e\', \'multiverseId\': 419371}, \'multiverseid\': 419371}, {\'name\': \'쾌속 순찰차\', \'text\': \'돌진, 신속\\n쾌속 순찰차가 전장에 들어올 때, 쾌속 순찰차는 턴종료까지 마법물체 생물이 된다.\\n탑승 2 (당신이 조종하는 생물을 공격력 총합이 2 이상이 되도록 원하는 수만큼 탭한다: 이 탑승물은 턴종료까지 마법물체 생물이 된다.)\', \'type\': \'마법물체 — 탑승물\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419635&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'50bbf404-f0ca-4067-aaf9-eaadd8cbe7fb\', \'multiverseId\': 419635}, \'multiverseid\': 419635}, {\'name\': \'Esportivo Rodalépida\', \'text\': \'Atropelar, ímpeto\\nQuando Esportivo Rodalépida entra no campo de batalha, ele se torna uma criatura artefato até o final do turno.\\nTripular 2 (Vire qualquer número de criaturas que você controla com total de poder igual ou superior a 2: Este Veículo se torna uma criatura artefato até o final do turno.)\', \'type\': \'Artefato — Veículo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419899&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50f27de2-8a5b-4458-937d-75fc7386543c\', \'multiverseId\': 419899}, \'multiverseid\': 419899}, {\'name\': \'Стремительный Болид\', \'text\': \'Пробивной удар, Ускорение\\nКогда Стремительный Болид выходит на поле битвы, он становится артефактом существом до конца хода.\\nЭкипаж 2 (Поверните любое количество существ под вашим контролем с суммарной силой 2 или более: эта Машина становится артефактом существом до конца хода.)\', \'type\': \'Артефакт — Машина\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420163&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'966a66dd-22a7-4ddb-b5a4-c28587951d91\', \'multiverseId\': 420163}, \'multiverseid\': 420163}, {\'name\': \'迅轮飞车\', \'text\': \'践踏，敏捷\\n当迅轮飞车进战场时，它成为神器生物直到回合结束。\\n搭载2（横置任意数量由你操控且力量总和等于或大于2的生物：此载具成为神器生物直到回合结束。）\', \'type\': \'神器～载具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418051&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2760eb1e-fd94-4a84-8c4e-97d31de63a1e\', \'multiverseId\': 418051}, \'multiverseid\': 418051}, {\'name\': \'迅輪飛車\', \'text\': \'踐踏，敏捷\\n當迅輪飛車進戰場時，它成為神器生物直到回合結束。\\n搭載2（橫置任意數量由你操控且力量總和等於或大於2的生物：此載具成為神器生物直到回合結束。）\', \'type\': \'神器～載具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418315&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'47fae2d6-4568-4be9-83d1-8bd7e1185d14\', \'multiverseId\': 418315}, \'multiverseid\': 418315}]', '[{\'name\': \'Turmklippenkanal\', \'text\': \'Der Turmklippenkanal kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder weniger andere Länder.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {R}.\', \'type\': \'Land\', \'flavor\': \'Abseits der ausgetretenen Pfade kann man so viel mehr von Ghirapur entdecken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418614&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca6f48e2-74be-439e-a5c2-a59cc3fb6703\', \'multiverseId\': 418614}, \'multiverseid\': 418614}, {\'name\': \'Canal riscoaguja\', \'text\': \'El Canal riscoaguja entra al campo de batalla girado a menos que controles otras dos o menos tierras.\\n{T}: Agrega {U} o {R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'En Ghirapur hay muchos más sitios que aquellos a los que se accede por caminos tradicionales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420462&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11084795-a094-4f33-beac-a4bc76bd1db0\', \'multiverseId\': 420462}, \'multiverseid\': 420462}, {\'name\': \'Canal du belvédère\', \'text\': \'Le Canal du belvédère arrive sur le champ de bataille engagé à moins que vous ne contrôliez deux autres terrains ou moins.\\n{T} : Ajoutez {U} ou {R} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Ghirapur recèle bien d\'autres merveilles où ne mènent pas les routes traditionnelles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418878&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e751437a-fc49-4091-85c3-c3bab18a90af\', \'multiverseId\': 418878}, \'multiverseid\': 418878}, {\'name\': \'Canale delle Guglie Vertiginose\', \'text\': \'Il Canale delle Guglie Vertiginose entra nel campo di battaglia TAPpato a meno che tu non controlli al massimo altre due terre.\\n{T}: Aggiungi {U} o {R} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Molto di ciò che Ghirapur ha da offrire non può essere raggiunto tramite vie tradizionali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419142&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ac3ffcbb-9af1-4344-9c79-ad01eb10ee92\', \'multiverseId\': 419142}, \'multiverseid\': 419142}, {\'name\': \'尖塔断の運河\', \'text\': \'あなたがコントロールしている他の土地が３つ以上であるかぎり、尖塔断の運河はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}か{R}を加える。\', \'type\': \'土地\', \'flavor\': \'ギラプールには、昔ながらの道では行けない場所がたくさんある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419406&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2cb85bf2-c9cc-4af3-a10b-bff3198c5ec2\', \'multiverseId\': 419406}, \'multiverseid\': 419406}, {\'name\': \'첨탑 절벽 운하\', \'text\': \'첨탑 절벽 운하는 당신이 다른 대지를 두 개 이하로 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {U}나 {R}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'기존의 도로를 통하지 않고도 다양한 방법으로 기라푸르에 올 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419670&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4b12fa0c-84c3-4520-a282-ec0db1d18bda\', \'multiverseId\': 419670}, \'multiverseid\': 419670}, {\'name\': \'Canal dos Espigões\', \'text\': \'Canal dos Espigões entra no campo de batalha virado, a menos que você controle dois outros terrenos ou menos.\\n{T}: Adicione {U} ou {R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Há muito mais em Ghirapur além do que pode ser acessado pelas ruas tradicionais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419934&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69a45f31-d52b-4679-a2a6-77e43101749e\', \'multiverseId\': 419934}, \'multiverseid\': 419934}, {\'name\': \'Путь Крутошпилья\', \'text\': \'Путь Крутошпилья выходит на поле битвы повернутым, если под вашим контролем есть не менее трех других земель.\\n{T}: добавьте {U} или {R} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'В Гирапуре есть множество мест, куда не попасть по обычным дорогам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420198&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6b802dba-f074-45c6-8776-b32f64f36e4c\', \'multiverseId\': 420198}, \'multiverseid\': 420198}, {\'name\': \'尖塔崖天渠\', \'text\': \'除非由你操控的其他地数量为两个或更少，否则尖塔崖天渠须横置进战场。\\n{T}：加{U}或{R}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'数得清吉拉波外万千通路，道不尽吉拉波内无数精彩。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418086&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cefbfeae-69c3-4604-90dc-ecc4d978470e\', \'multiverseId\': 418086}, \'multiverseid\': 418086}, {\'name\': \'尖塔崖天渠\', \'text\': \'除非由你操控的其他地數量為兩個或更少，否則尖塔崖天渠須橫置進戰場。\\n{T}：加{U}或{R}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'數得清吉拉波外萬千通路，道不盡吉拉波內無數精彩。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418350&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'22d87cbf-a391-4ec1-9e3f-18e457d075a1\', \'multiverseId\': 418350}, \'multiverseid\': 418350}]', '[{\'name\': \'Turmspitzen-Infiltrator\', \'text\': \'Immer wenn der Turmspitzen-Infiltrator getappt wird, fügt er jedem Gegner 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'„Das Konsulat hat versprochen, dass jeder Zugang zum Äther bekommt. Ich nehme sie nur beim Wort."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418498&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09ffb8a6-03cc-48fe-86ed-054ae5c9dac6\', \'multiverseId\': 418498}, \'multiverseid\': 418498}, {\'name\': \'Invasor de chapiteles\', \'text\': \'Siempre que el Invasor de chapiteles se gire, hace 1 punto de daño a cada oponente.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'"El Consultado nos prometió que todos tendríamos acceso al éter. Solo hago que cumplan sus promesas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420346&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cdeb97df-97d2-434a-9627-c02b895c91ad\', \'multiverseId\': 420346}, \'multiverseid\': 420346}, {\'name\': \'Infiltrateur de façade\', \'text\': "À chaque fois que l\'Infiltrateur de façade devient engagé, il inflige 1 blessure à chaque adversaire.", \'type\': \'Créature : humain et gredin\', \'flavor\': "« Le Consulat a promis que nous aurions tous accès à l\'Éther. Je ne fais que les aider à tenir leur promesse. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418762&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ded6eec-828e-430b-81fa-94ca7fd63e11\', \'multiverseId\': 418762}, \'multiverseid\': 418762}, {\'name\': \'Infiltrato degli Ingranaggi\', \'text\': "Ogniqualvolta l\'Infiltrato degli Ingranaggi viene TAPpato, infligge 1 danno a ogni avversario.", \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'"Il Consolato ci ha promesso che avremmo avuto tutti accesso all\\\'etere. Sto solo impedendo loro di diventare dei bugiardi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bdad3e03-4fea-4ad9-8248-fcb92a1792fa\', \'multiverseId\': 419026}, \'multiverseid\': 419026}, {\'name\': \'尖塔横の潜入者\', \'text\': \'尖塔横の潜入者がタップ状態になるたび、これは各対戦相手にそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'「かつて領事府は、全市民が霊気を利用できるようにすると約束した。俺はただ領事の連中を嘘つきにしたくないだけさ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419290&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'603185b8-cad9-4a53-8f6b-6bd568fa344a\', \'multiverseId\': 419290}, \'multiverseid\': 419290}, {\'name\': \'첨탑 침투자\', \'text\': \'첨탑 침투자가 탭될 때마다, 첨탑 침투자는 각 상대에게 피해 1점을 입힌다.\', \'type\': \'생물 — 인간 도적\', \'flavor\': \'"영사관은 모두가 에테르를 이용할 수 있을 거라고 약속했어. 난 그 약속을 지키도록 도와주는 것 뿐이야."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419554&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f6088b9c-d28e-4049-ade5-2188b295508b\', \'multiverseId\': 419554}, \'multiverseid\': 419554}, {\'name\': \'Infiltrador das Torres\', \'text\': \'Toda vez que Infiltrador das Torres é virado, ele causa 1 ponto de dano a cada oponente.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'"O Consulado prometeu que todos teríamos acesso ao éter. Estou apenas preservando a honestidade deles."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f28b0b01-430e-4ba9-862f-6202c2b42a1b\', \'multiverseId\': 419818}, \'multiverseid\': 419818}, {\'name\': \'Шпильный Лазутчик\', \'text\': \'Каждый раз, когда Шпильный Лазутчик поворачивается, он наносит 1 повреждение каждому оппоненту.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'«В Консульстве обещали, что эфир будет доступен всем. Я просто забочусь об их честности».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420082&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'25baec64-efa1-4747-ac14-dbd401b1bcbd\', \'multiverseId\': 420082}, \'multiverseid\': 420082}, {\'name\': \'塔侧渗透者\', \'text\': \'每当塔侧渗透者成为横置时，它向每位对手各造成1点伤害。\', \'type\': \'生物～人类／浪客\', \'flavor\': \'「执政院承诺会让我们都取得乙太。我只是要确保他们恪守承诺。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417970&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d4d0de6e-8bbf-4111-a8b9-c9240e05960d\', \'multiverseId\': 417970}, \'multiverseid\': 417970}, {\'name\': \'塔側滲透者\', \'text\': \'每當塔側滲透者成為橫置時，它向每位對手各造成1點傷害。\', \'type\': \'生物～人類／浪客\', \'flavor\': \'「執政院承諾會讓我們都取得乙太。我只是要確保他們恪守承諾。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418234&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3cf6518a-a791-4224-b688-c71a79779ec5\', \'multiverseId\': 418234}, \'multiverseid\': 418234}]', '[{\'name\': \'Unfaire Konfiszierung\', \'text\': \'Bestimme ein Artefakt oder eine Kreatur deiner Wahl. Du erhältst {E}{E}{E}{E} (vier Energiemarken), dann kannst du {E} in Höhe der umgewandelten Manakosten der bleibenden Karte bezahlen. Falls du dies tust, übernimmst du die Kontrolle über sie.\', \'type\': \'Hexerei\', \'flavor\': \'„Wehrt euch nicht, Bürger. Dies dient zu eurer Sicherheit. Tezzeret wünscht die Herausgabe eurer Erfindungen. Jetzt sofort."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418406&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af11be88-8f02-4ac3-ba45-1711ffe73a31\', \'multiverseId\': 418406}, \'multiverseid\': 418406}, {\'name\': \'Incautación\', \'text\': \'Elige un artefacto o criatura objetivo. Obtienes {E}{E}{E}{E} (cuatro contadores de energía). Luego puedes pagar una cantidad de {E} igual al coste de maná convertido de ese permanente. Si lo haces, gana el control de él.\', \'type\': \'Conjuro\', \'flavor\': \'"Ciudadanos, no se resistan. Es por su seguridad. Tezzeret les solicita que entreguen sus inventos. Ahora".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'54c7698b-ccb2-487c-ab9b-32fa2f51b223\', \'multiverseId\': 420254}, \'multiverseid\': 420254}, {\'name\': \'Coup de confiscation\', \'text\': "Choisissez l\'artefact ciblé ou la créature ciblée. Vous gagnez {E}{E}{E}{E} (quatre marqueurs « énergie »), puis vous pouvez payer un nombre de {E} égal au coût converti de mana de ce permanent. Si vous faites ainsi, acquérez-en le contrôle.", \'type\': \'Rituel\', \'flavor\': \'« Citoyens, ne résistez pas. Nous agissons pour votre sécurité. Tezzeret vous demande de céder vos inventions. Immédiatement. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418670&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bca6b00c-2baa-425a-9137-79a944204b0b\', \'multiverseId\': 418670}, \'multiverseid\': 418670}, {\'name\': \'Azione di Confisca\', \'text\': \'Scegli un artefatto o una creatura bersaglio. Ottieni {E}{E}{E}{E} (quattro segnalini energia), poi puoi pagare un ammontare di {E} pari al costo di mana convertito di quel permanente. Se lo fai, ne prendi il controllo.\', \'type\': \'Stregoneria\', \'flavor\': \'"Non opponete resistenza, cittadini. Per garantire la vostra sicurezza, Tezzeret vi ordina di consegnare le vostre invenzioni. Immediatamente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418934&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cfb8ce73-2011-487a-8a0e-a53a852a6e16\', \'multiverseId\': 418934}, \'multiverseid\': 418934}, {\'name\': \'慮外な押収\', \'text\': \'アーティファクト１つかクリーチャー１体を対象とする。あなたは{E}{E}{E}{E}（エネルギー・カウンター４個）を得る。その後あなたは、そのパーマネントの点数で見たマナ・コストに等しい数の{E}を支払ってもよい。そうしたなら、それのコントロールを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'「市民の皆さん、抵抗はお止めください。あなた方の安全のためです。テゼレット審判長の命により発明品を押収します。直ちにです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419198&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'146513f6-ac6d-4891-b3ba-9640f16e323d\', \'multiverseId\': 419198}, \'multiverseid\': 419198}, {\'name\': \'재산 몰수\', \'text\': \'마법물체 또는 생물을 목표로 정한다. 당신은 {E}{E}{E}{E}(에너지 카운터 네 개)를 얻은 후, 그 지속물의 전환마나비용만큼 {E}를 지불할 수 있다. 그렇게 한다면, 그 지속물의 조종권을 얻는다.\', \'type\': \'집중마법\', \'flavor\': \'"시민 여러분, 저항하지 마십시오. 여러분의 안전을 위한 것입니다. 테제렛이 발명품을 포기하라고 지시했습니다. 즉시 말입니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419462&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a1a0c293-a101-4662-83fb-1490ea8aa947\', \'multiverseId\': 419462}, \'multiverseid\': 419462}, {\'name\': \'Golpe do Confisco\', \'text\': \'Escolha o artefato ou a criatura alvo. Você recebe {E}{E}{E}{E} (quatro marcadores de energia) e, em seguida, pode pagar uma quantidade de {E} igual ao custo de mana convertido daquela permanente. Se fizer isso, ganhe o controle dela.\', \'type\': \'Feitiço\', \'flavor\': \'"Cidadãos, não resistam. Isso é para sua própria segurança. Tezzeret ordena que vocês entreguem suas invenções. Imediatamente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419726&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee49d612-f36b-4fc3-ae67-0a3d0f4e6b74\', \'multiverseId\': 419726}, \'multiverseid\': 419726}, {\'name\': \'Заговор с Конфискацией\', \'text\': \'Выберите целевой артефакт или существо. Вы получаете {E}{E}{E}{E} (четыре жетона энергии), затем вы можете заплатить количество {E}, равное конвертированной мана-стоимости того перманента. Если вы это делаете, получите над ним контроль.\', \'type\': \'Волшебство\', \'flavor\': \'«Не сопротивляйтесь, граждане. Это для вашей же безопасности. Теззерет призывает всех сдать свои изобретения. Немедленно».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419990&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef190d2b-8326-4c24-aef2-432c3c147d03\', \'multiverseId\': 419990}, \'multiverseid\': 419990}, {\'name\': \'即刻征收\', \'text\': \'选择目标神器或生物。你得到{E}{E}{E}{E}（四个能量指示物），然后你可以支付等同于该永久物总法术力费用之数量的{E}。如果你如此作，则获得其操控权。\', \'type\': \'法术\', \'flavor\': \'「市民，不要反抗；这是为了你的安全着想。泰兹瑞要求你交出你的发明，就是现在。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05e0e4f7-16e1-4cca-8d0a-ade43292d0e4\', \'multiverseId\': 417878}, \'multiverseid\': 417878}, {\'name\': \'即刻徵收\', \'text\': \'選擇目標神器或生物。你得到{E}{E}{E}{E}（四個能量指示物），然後你可以支付等同於該永久物總魔法力費用之數量的{E}。如果你如此作，則獲得其操控權。\', \'type\': \'巫術\', \'flavor\': \'「市民，不要反抗；這是為了你的安全著想。泰茲瑞要求你交出你的發明，就是現在。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418142&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7a5f2cd2-3b6e-4649-a7c3-9bdd93cedd64\', \'multiverseId\': 418142}, \'multiverseid\': 418142}]', '[{\'name\': \'Unlizenzierte Zersetzung\', \'text\': \'Zerstöre eine Kreatur deiner Wahl. Falls du ein Artefakt kontrollierst, fügt die Unlizenzierte Zersetzung dem Beherrscher der Kreatur 3 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„An deiner Stelle würde ich mich fernhalten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418552&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9b73926-da4e-4026-ae30-f26965e9c8e6\', \'multiverseId\': 418552}, \'multiverseid\': 418552}, {\'name\': \'Desintegración no autorizada\', \'text\': \'Destruye la criatura objetivo. Si controlas un artefacto, la Desintegración no autorizada hace 3 puntos de daño al controlador de esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'"Yo de ti no me acercaría".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420400&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bcd83a8b-688d-46c0-b18e-052cabbe3e60\', \'multiverseId\': 420400}, \'multiverseid\': 420400}, {\'name\': \'Désintégration illicite\', \'text\': \'Détruisez une créature ciblée. Si vous contrôlez un artefact, la Désintégration illicite inflige 3 blessures au contrôleur de cette créature.\', \'type\': \'Éphémère\', \'flavor\': "« Si j\'étais vous, je reculerai. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418816&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'52355959-8ea5-428d-b203-7a5a04f0445c\', \'multiverseId\': 418816}, \'multiverseid\': 418816}, {\'name\': \'Disintegrazione Abusiva\', \'text\': \'Distruggi una creatura bersaglio. Se controlli un artefatto, la Disintegrazione Abusiva infligge 3 danni al controllore di quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': \'"Se fossi in te, farei un passo indietro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419080&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'efd2dbd0-4b95-478a-a514-d6c552899255\', \'multiverseId\': 419080}, \'multiverseid\': 419080}, {\'name\': \'無許可の分解\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。あなたがアーティファクトをコントロールしているなら、無許可の分解はそのクリーチャーのコントローラーに３点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「私なら後ろに下がるけどね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419344&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21f1abc2-3f37-412e-a3d3-5cca5e37ed7f\', \'multiverseId\': 419344}, \'multiverseid\': 419344}, {\'name\': \'불법 분해\', \'text\': \'생물을 목표로 정한다. 그 생물을 파괴한다. 당신이 마법물체를 조종하고 있다면, 불법 분해는 그 생물의 조종자에게 피해 3점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'"내가 당신이라면 물러서 있겠소."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419608&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b7b10e88-e575-45a8-9448-d9ffa9cc4d2f\', \'multiverseId\': 419608}, \'multiverseid\': 419608}, {\'name\': \'Desintegração Ilícita\', \'text\': \'Destrua a criatura alvo. Se você controla um artefato, Desintegração Ilícita causa 3 pontos de dano ao controlador aquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Eu chegaria para trás se fosse você."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419872&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'40fdef01-36a3-4770-89fe-e0d655ede95f\', \'multiverseId\': 419872}, \'multiverseid\': 419872}, {\'name\': \'Противоправная Дезинтеграция\', \'text\': \'Уничтожьте целевое существо. Если вы контролируете артефакт, Противоправная Дезинтеграция наносит 3 повреждения игроку, контролирующему то существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«На твоем месте я бы отошел».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420136&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2776c7d9-6211-4b54-bc78-becf1dfc1c35\', \'multiverseId\': 420136}, \'multiverseid\': 420136}, {\'name\': \'私自分解\', \'text\': \'消灭目标生物。如果你操控神器，则私自分解对该生物的操控者造成3点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「如果我是你，就会往后退。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418024&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b7e209a1-5239-46f2-9a42-a41843878cda\', \'multiverseId\': 418024}, \'multiverseid\': 418024}, {\'name\': \'私自分解\', \'text\': \'消滅目標生物。如果你操控神器，則私自分解對該生物的操控者造成3點傷害。\', \'type\': \'瞬間\', \'flavor\': \'「如果我是你，就會往後退。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418288&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b8154d80-8cba-423b-b637-9c38e59a5b0b\', \'multiverseId\': 418288}, \'multiverseid\': 418288}]', '[{\'name\': \'Vedalken-Klingenmeister\', \'text\': \'Bravour (Immer wenn du einen Nichtkreatur-Zauberspruch wirkst, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\', \'type\': \'Kreatur — Vedalken, Soldat\', \'flavor\': \'Vedalken haben sechs dünne, flinke Finger an jeder Hand, die sie unvergleichlich geschickt einsetzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418433&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48e089f7-b468-4f4a-b851-17a408a3055d\', \'multiverseId\': 418433}, \'multiverseid\': 418433}, {\'name\': \'Maestro de filo vedalken\', \'text\': \'Destreza. (Siempre que lances un hechizo que no sea de criatura, esta criatura obtiene +1/+1 hasta el final del turno.)\', \'type\': \'Criatura — Soldado vedalken\', \'flavor\': \'Los vedalken tienen seis dedos largos y ágiles en cada mano, con los que obtienen una destreza sin igual.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420281&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8bfa1fa8-8f1a-4d05-b425-8178d18cdb58\', \'multiverseId\': 420281}, \'multiverseid\': 420281}, {\'name\': "Maître d\'épée vedalken", \'text\': "Prouesse (À chaque fois que vous lancez un sort non-créature, cette créature gagne +1/+1 jusqu\'à la fin du tour.)", \'type\': \'Créature : vedalken et soldat\', \'flavor\': \'Les vedalkens possèdent six longs doigts souples à chaque main, ce qui leur confère une dextérité sans pareille.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c45ed76b-98c4-466d-836b-4f8d03d2ccce\', \'multiverseId\': 418697}, \'multiverseid\': 418697}, {\'name\': \'Maestro di Spada Vedalken\', \'text\': \'Prodezza (Ogniqualvolta lanci una magia non creatura, questa creatura prende +1/+1 fino alla fine del turno.)\', \'type\': \'Creatura — Soldato Vedalken\', \'flavor\': \'Le mani dei vedalken sono munite di sei dita sottili e agili che conferiscono loro una destrezza senza paragoni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56d6c5a5-4410-470a-bdf5-bfa7c05c6b9b\', \'multiverseId\': 418961}, \'multiverseid\': 418961}, {\'name\': \'ヴィダルケンの刃の達人\', \'text\': \'果敢（あなたがクリーチャーでない呪文を１つ唱えるたび、ターン終了時まで、このクリーチャーは＋１/＋１の修整を受ける。）\', \'type\': \'クリーチャー — ヴィダルケン・兵士\', \'flavor\': \'ヴィダルケンには、細くしなやかな指が６本あり、比類なく器用である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419225&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'390ffbe3-a1c8-45ca-9c30-8062714c6111\', \'multiverseId\': 419225}, \'multiverseid\': 419225}, {\'name\': \'베달켄 검성\', \'text\': \'기량 (당신이 생물이 아닌 주문을 발동할 때마다, 이 생물은 턴종료까지 +1/+1을 받는다.)\', \'type\': \'생물 — 베달켄 병사\', \'flavor\': \'베달켄은 양손에 가늘고 날렵한 손가락을 여섯 개나 가지고 있어 아주 민첩하다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419489&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'26b9b32f-382f-46c4-bbc4-5ba586a219a2\', \'multiverseId\': 419489}, \'multiverseid\': 419489}, {\'name\': \'Lâmina-mestre Vedalkeano\', \'text\': \'Destreza (Toda vez que você conjura uma mágica que não seja de criatura, esta criatura recebe +1/+1 até o final do turno.)\', \'type\': \'Criatura — Vedalkeano Soldado\', \'flavor\': \'Os vedalkeanos têm seis dedos finos e ágeis em cada mão, que lhes concedem uma destreza inigualável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f9fc52d-6a8b-44a7-8988-0801210a65e5\', \'multiverseId\': 419753}, \'multiverseid\': 419753}, {\'name\': \'Ведалкен, Мастер Клинка\', \'text\': \'Искусность (Каждый раз, когда вы разыгрываете не являющееся существом заклинание, это существо получает +1/+1 до конца хода.)\', \'type\': \'Существо — Ведалкен Солдат\', \'flavor\': \'У ведалкенов на каждой руке по шесть тонких подвижных пальцев, и поэтому мало кто может сравниться с ними в ловкости.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420017&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'326b86e7-5dec-49b5-9bfe-a23fbb32b7d5\', \'multiverseId\': 420017}, \'multiverseid\': 420017}, {\'name\': \'维多肯大剑师\', \'text\': \'灵技（每当你施放非生物咒语时，此生物得+1/+1直到回合结束。）\', \'type\': \'生物～维多肯／士兵\', \'flavor\': \'维多肯人的手上有六根手指，纤细灵活，论起手巧当然无人能及。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417905&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28289635-0396-47b5-8269-561ed2014476\', \'multiverseId\': 417905}, \'multiverseid\': 417905}, {\'name\': \'維多肯大劍師\', \'text\': \'靈技（每當你施放非生物咒語時，此生物得+1/+1直到回合結束。）\', \'type\': \'生物～維多肯／士兵\', \'flavor\': \'維多肯人的手上有六根手指，纖細靈活，論起手巧當然無人能及。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418169&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cea5ebb8-0204-4db6-9796-73fd656d2b75\', \'multiverseId\': 418169}, \'multiverseid\': 418169}]', '[{\'name\': \'Verborgener Innenhof\', \'text\': \'Der Verborgene Innenhof kommt getappt ins Spiel, es sei denn, du kontrollierst zwei oder weniger andere Länder.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}.\', \'type\': \'Land\', \'flavor\': \'Wo die oberen Zehntausend und liederliche Absichten aufeinandertreffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418610&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe3d861c-6dbe-4125-9b4b-b0f590d1cea7\', \'multiverseId\': 418610}, \'multiverseid\': 418610}, {\'name\': \'Patio oculto\', \'text\': \'El Patio oculto entra al campo de batalla girado a menos que controles otras dos o menos tierras.\\n{T}: Agrega {W} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Allá donde la alta sociedad se codea con la siniestra oportunidad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420458&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d187cde4-c298-4389-ad8a-5a4ec58ef142\', \'multiverseId\': 420458}, \'multiverseid\': 420458}, {\'name\': \'Cour dissimulée\', \'text\': \'La Cour dissimulée arrive sur le champ de bataille engagée à moins que vous ne contrôliez deux autres terrains ou moins.\\n{T} : Ajoutez {W} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "C\'est ici que la haute société rencontre de sombres opportunités.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418874&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f56ba76b-1cb0-41db-9d61-f683274d9368\', \'multiverseId\': 418874}, \'multiverseid\': 418874}, {\'name\': \'Cortile Nascosto\', \'text\': \'Il Cortile Nascosto entra nel campo di battaglia TAPpato a meno che tu non controlli al massimo altre due terre.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "All\'intersezione tra l\'alta società e le subdole opportunità.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419138&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'04cbaeb8-8670-41f7-bfbb-dd71d1277adc\', \'multiverseId\': 419138}, \'multiverseid\': 419138}, {\'name\': \'秘密の中庭\', \'text\': \'あなたがコントロールしている他の土地が３つ以上であるかぎり、秘密の中庭はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'上流社会と闇の機会が出会う場所。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419402&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80a6db00-a4ba-424e-aa89-23eb96f82238\', \'multiverseId\': 419402}, \'multiverseid\': 419402}, {\'name\': \'가려진 안뜰\', \'text\': \'가려진 안뜰은 당신이 다른 대지를 두 개 이하로 조종하지 않는 한 탭된 채로 전장에 들어온다.\\n{T}: {W} 또는 {B}를 당신의 마나풀에 담는다.\', \'type\': \'대지\', \'flavor\': \'상류 사회의 음흉한 계획이 시작되는 곳이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419666&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'57d467af-b2ee-4a1d-baa5-b95778857e39\', \'multiverseId\': 419666}, \'multiverseid\': 419666}, {\'name\': \'Pátio Oculto\', \'text\': \'Pátio Oculto entra no campo de batalha virado, a menos que você controle dois outros terrenos ou menos.\\n{T}: Adicione {W} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Onde a alta sociedade e as oportunidades sombrias se cruzam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44a3e2bd-9d0d-4341-8ad0-2cac3023095f\', \'multiverseId\': 419930}, \'multiverseid\': 419930}, {\'name\': \'Закрытый Дворик\', \'text\': \'Закрытый Дворик выходит на поле битвы повернутым, если под вашим контролем есть не менее трех других земель.\\n{T}: добавьте {W} или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Здесь высшее общество встречается с темными делами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420194&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fa04e37c-90f3-49d5-8a25-e1cf926bb69f\', \'multiverseId\': 420194}, \'multiverseid\': 420194}, {\'name\': \'隐秘庭院\', \'text\': \'除非由你操控的其他地数量为两个或更少，否则隐秘庭院须横置进战场。\\n{T}：加{W}或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'名流与暗潮交汇之所。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418082&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2685879c-d5fe-4518-8032-e9b4d8c0f68c\', \'multiverseId\': 418082}, \'multiverseid\': 418082}, {\'name\': \'隱秘庭院\', \'text\': \'除非由你操控的其他地數量為兩個或更少，否則隱秘庭院須橫置進戰場。\\n{T}：加{W}或{B}到你的魔法力池中。\', \'type\': \'地\', \'flavor\': \'名流與暗潮交匯之所。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418346&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4f8ef762-f67f-48ae-9599-5190c0ded379\', \'multiverseId\': 418346}, \'multiverseid\': 418346}]', '[{\'name\': \'Verhandlungsgeschick\', \'text\': \'Tausche die Kontrolle über ein Artefakt deiner Wahl, das du kontrollierst, und ein Artefakt oder eine Kreatur deiner Wahl, das bzw. die du nicht kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'„Es war mir eine Freude, mit Euch Geschäfte zu machen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418429&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb9a6f4c-8b35-4b1f-a40f-77eb38d115f7\', \'multiverseId\': 418429}, \'multiverseid\': 418429}, {\'name\': \'Regateo inteligente\', \'text\': \'Intercambia el control del artefacto objetivo que controlas y el artefacto o la criatura objetivo que no controlas.\', \'type\': \'Conjuro\', \'flavor\': \'"Un placer hacer negocios contigo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420277&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b06b71fb-6d6d-4596-b02b-957dbac434c5\', \'multiverseId\': 420277}, \'multiverseid\': 420277}, {\'name\': \'Habile négociation\', \'text\': "Échangez le contrôle d\'un artefact ciblé que vous contrôlez contre celui d\'un artefact ciblé ou d\'une créature ciblée que vous ne contrôlez pas.", \'type\': \'Rituel\', \'flavor\': "« C\'est un plaisir de faire affaire avec vous. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418693&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d20b45f-33f1-4a3e-9075-4195ccadf8b5\', \'multiverseId\': 418693}, \'multiverseid\': 418693}, {\'name\': \'Trattativa Scaltra\', \'text\': \'Scambia il controllo di un artefatto bersaglio che controlli e un artefatto o una creatura bersaglio che non controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'"È un piacere fare affari con te."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418957&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5532ac3c-1113-4750-8756-3831bf963380\', \'multiverseId\': 418957}, \'multiverseid\': 418957}, {\'name\': \'巧みな交渉術\', \'text\': \'あなたがコントロールするアーティファクト１つと、あなたがコントロールしていないアーティファクト１つかクリーチャー１体を対象とし、それらのコントロールを交換する。\', \'type\': \'ソーサリー\', \'flavor\': \'「あなたと取り引きできて嬉しいわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419221&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'020257e5-dfdd-48db-9403-b6a33578ed5d\', \'multiverseId\': 419221}, \'multiverseid\': 419221}, {\'name\': \'빈틈 없는 협상\', \'text\': \'당신이 조종하는 마법물체와 당신이 조종하지 않는 마법물체 또는 생물을 목표로 정한다. 이 둘의 조종권을 교환한다.\', \'type\': \'집중마법\', \'flavor\': \'"거래하게 되어 기쁩니다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419485&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2abf5c4e-dedd-475c-aeee-d7126ab20c49\', \'multiverseId\': 419485}, \'multiverseid\': 419485}, {\'name\': \'Negociação Ardilosa\', \'text\': \'Permute o controle do artefato alvo que você controla e do artefato ou criatura alvo que você não controla.\', \'type\': \'Feitiço\', \'flavor\': \'"É um prazer fazer negócios com você."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419749&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0ec1daa-d6c8-4a6f-9eef-c643245cb500\', \'multiverseId\': 419749}, \'multiverseid\': 419749}, {\'name\': \'Искусные Переговоры\', \'text\': \'Поменяйте контроль над целевым артефактом под вашим контролем и целевым артефактом или существом не под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'«Иметь с тобой дело — одно удовольствие».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420013&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'34bd7b9e-e4ff-49c9-8344-81fdb8125365\', \'multiverseId\': 420013}, \'multiverseid\': 420013}, {\'name\': \'机伶协商\', \'text\': \'交换目标由你操控的神器与目标不由你操控的神器或生物之操控权。\', \'type\': \'法术\', \'flavor\': \'「跟你做生意很愉快。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417901&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a5b785c3-82b9-467c-8f9b-fd76c630f7ef\', \'multiverseId\': 417901}, \'multiverseid\': 417901}, {\'name\': \'機伶協商\', \'text\': \'交換目標由你操控的神器與目標不由你操控的神器或生物之操控權。\', \'type\': \'巫術\', \'flavor\': \'「跟你做生意很愉快。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418165&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a22c933-1c29-4c0a-9e06-06e4ef9b9f7a\', \'multiverseId\': 418165}, \'multiverseid\': 418165}]', '[{\'name\': \'Verheerender Mechakoloss\', \'text\': \'Wachsamkeit\\nWenn der Verheerende Mechakoloss ins Spiel kommt, bestimmt jeder Spieler ein Artefakt, eine Kreatur, eine Verzauberung und einen Planeswalker von den bleibenden Karten, die er kontrolliert und die keine Länder sind, und opfert dann den Rest.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418374&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8bf0f46-7466-49dc-9069-9729fb5c3d7f\', \'multiverseId\': 418374}, \'multiverseid\': 418374}, {\'name\': \'Mecatitán cataclísmico\', \'text\': \'Vigilancia.\\nCuando el Mecatitán cataclísmico entre al campo de batalla, cada jugador elige un artefacto, una criatura, un encantamiento y un planeswalker de entre los permanentes que no sean tierra y que ese jugador controla. Luego, sacrifica el resto.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420222&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34f26538-e86e-4661-ad7f-594fe58f58a2\', \'multiverseId\': 420222}, \'multiverseid\': 420222}, {\'name\': \'Carcasse mécanique cataclysmique\', \'text\': "Vigilance\\nQuand la Carcasse mécanique cataclysmique arrive sur le champ de bataille, chaque joueur choisit un artefact, une créature, un enchantement et un planeswalker parmi les permanents non-terrain qu\'il contrôle, puis sacrifie le reste.", \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418638&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f1b191a-a811-400b-8451-605789c8538b\', \'multiverseId\': 418638}, \'multiverseid\': 418638}, {\'name\': \'Meccatitano del Cataclisma\', \'text\': \'Cautela\\nQuando il Meccatitano del Cataclisma entra nel campo di battaglia, ogni giocatore sceglie un artefatto, una creatura, un incantesimo e un planeswalker tra i permanenti non terra che controlla, poi sacrifica gli altri.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418902&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30567c83-03c3-4d5e-9a5f-522064e2e3f5\', \'multiverseId\': 418902}, \'multiverseid\': 418902}, {\'name\': \'激変の機械巨人\', \'text\': \'警戒\\n激変の機械巨人が戦場に出たとき、各プレイヤーはそれぞれ、自分がコントロールする土地でないパーマネントの中から、アーティファクト１つとクリーチャー１体とエンチャント１つとプレインズウォーカー１体を選び、残りを生け贄に捧げる。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419166&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'28a40c35-d604-47b4-b0f5-8e2bbe129cbf\', \'multiverseId\': 419166}, \'multiverseid\': 419166}, {\'name\': \'격변의 톱니거신병\', \'text\': \'경계\\n격변의 톱니거신병이 전장에 들어올 때, 각 플레이어는 자신이 조종하는 대지가 아닌 지속물 중에서 마법물체, 생물, 부여마법, 플레인즈워커를 하나씩 선택한 후 나머지를 희생한다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419430&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9e763864-9827-4226-8487-d9ab5e432eaf\', \'multiverseId\': 419430}, \'multiverseid\': 419430}, {\'name\': \'Mecanotitã Cataclísmico\', \'text\': \'Vigilância\\nQuando Mecanotitã Cataclísmico entra no campo de batalha, cada jogador escolhe um artefato, uma criatura, um encantamento e um planeswalker dentre as permanentes que não sejam terrenos que este controla e, em seguida, sacrifica as restantes.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419694&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'43dcf2b2-e07b-4fcc-8e89-c59cd278a2f6\', \'multiverseId\': 419694}, \'multiverseid\': 419694}, {\'name\': \'Мехагигант Катаклизмов\', \'text\': \'Бдительность\\nКогда Мехагигант Катаклизмов выходит на поле битвы, каждый игрок выбирает из не являющихся землями перманентов под своим контролем артефакт, существо, чары и planeswalker-а, затем жертвует остальные.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419958&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30a57f1e-e780-49a7-b23a-5f4c93db20be\', \'multiverseId\': 419958}, \'multiverseid\': 419958}, {\'name\': \'灾变巨械\', \'text\': \'警戒\\n当灾变巨械进战场时，每位牌手各从由其操控的非地永久物中选择一个神器、一个生物、一个结界和一个鹏洛客，然后牺牲其余的非地永久物。\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417846&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'717217e0-6ca8-4294-b601-29e01b2ff63a\', \'multiverseId\': 417846}, \'multiverseid\': 417846}, {\'name\': \'災變巨械\', \'text\': \'警戒\\n當災變巨械進戰場時，每位玩家各從由其操控的非地永久物中選擇一個神器、一個生物、一個結界和一個鵬洛客，然後犧牲其餘的非地永久物。\', \'type\': \'神器生物～組構體\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418110&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d6d14423-836c-4ce2-9510-d35691bdb3ec\', \'multiverseId\': 418110}, \'multiverseid\': 418110}]', '[{\'name\': \'Verlorenes Vermächtnis\', \'text\': \'Benenne eine Karte, die weder ein Artefakt noch ein Land ist. Durchsuche den Friedhof, die Hand und die Bibliothek eines Spielers deiner Wahl nach einer beliebigen Anzahl an Karten mit diesem Namen und schicke sie ins Exil. Dieser Spieler mischt seine Bibliothek und zieht dann eine Karte für jede auf diese Weise aus seiner Hand ins Exil geschickte Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Dieser Name wird nicht mehr ausgesprochen." —Baral, Oberster Regelüberwacher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418453&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35cf3144-d538-481b-9ea6-cf007e0014ad\', \'multiverseId\': 418453}, \'multiverseid\': 418453}, {\'name\': \'Legado extraviado\', \'text\': \'Nombra una carta que no sea tierra ni artefacto. Busca en el cementerio, mano y biblioteca del jugador objetivo cualquier cantidad de cartas con ese nombre y exílialas. Ese jugador baraja su biblioteca y luego roba una carta por cada carta exiliada de su mano de esta manera.\', \'type\': \'Conjuro\', \'flavor\': \'"Ese nombre no debe ser pronunciado". —Baral, señor de la sumisión\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420301&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd0bf604-c62a-428f-a8ba-7be699702108\', \'multiverseId\': 420301}, \'multiverseid\': 420301}, {\'name\': \'Héritage perdu\', \'text\': "Nommez une carte non-terrain, non-artefact. Cherchez dans le cimetière, la main et la bibliothèque du joueur ciblé n\'importe quel nombre de cartes avec ce nom et exilez-les. Ce joueur mélange sa bibliothèque, puis pioche une carte pour chaque carte exilée depuis sa main de cette manière.", \'type\': \'Rituel\', \'flavor\': \'« Ce nom ne sera pas prononcé. » —Baral, directeur de conformité\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418717&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b3ccca9-2e9a-442e-9d38-ad3fec28992b\', \'multiverseId\': 418717}, \'multiverseid\': 418717}, {\'name\': \'Eredità Perduta\', \'text\': \'Nomina una carta non artefatto, non terra. Passa in rassegna il cimitero, la mano e il grimorio di un giocatore bersaglio per un qualsiasi numero di carte con quel nome ed esiliale. Quel giocatore rimescola il suo grimorio, poi pesca una carta per ogni carta esiliata dalla sua mano in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': \'"Quel nome non deve essere pronunciato." —Baral, Commissario della conformità\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418981&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'456169c7-7685-4056-b3e1-dbfd3a8bac09\', \'multiverseId\': 418981}, \'multiverseid\': 418981}, {\'name\': \'失われた遺産\', \'text\': \'プレイヤー１人を対象とする。アーティファクトでも土地でもないカード名１つを指定する。そのプレイヤーの墓地と手札とライブラリーから、望む枚数のその名前を持つカードを探し、それらを追放する。そのプレイヤーは自分のライブラリーを切り直し、その後そのプレイヤーはこれにより手札から追放されたカード１枚につきカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「その名を口にしてはならない。」 ――遵法長、バラル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419245&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a8593b8-3f60-4d92-8bed-939e3b09272c\', \'multiverseId\': 419245}, \'multiverseid\': 419245}, {\'name\': \'잃어버린 유산\', \'text\': \'마법물체가 아니고 대지가 아닌 카드 한 장을 호명한다. 플레이어를 목표로 정한다. 그 플레이어의 무덤, 손, 서고에서 그 이름의 카드를 원하는 만큼 찾아서 추방한다. 그 플레이어는 자신의 서고를 섞은 후, 이렇게 손에서 추방된 카드 한 장당 카드를 한 장 뽑는다.\', \'type\': \'집중마법\', \'flavor\': \'"그 이름을 입에 담지 마라." —감시 대장 바랄\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419509&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'92ac401e-1ff1-4f4a-b40d-55a6fa9dc4cc\', \'multiverseId\': 419509}, \'multiverseid\': 419509}, {\'name\': \'Legado Perdido\', \'text\': \'Nomeie um card que não seja artefato nem terreno. Procure um número qualquer de cards com o mesmo nome daquele card no cemitério, na mão e no grimório do jogador alvo e exile-os. Aquele jogador embaralha o próprio grimório e, em seguida compra um card para cada card exilado da própria mão desta forma.\', \'type\': \'Feitiço\', \'flavor\': \'"Aquele nome não será pronunciado." — Baral, Chefe da Conformidade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419773&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21000c5d-3235-44c5-a72d-8730e99e7336\', \'multiverseId\': 419773}, \'multiverseid\': 419773}, {\'name\': \'Потерянное Наследие\', \'text\': \'Назовите не являющуюся землей или артефактом карту. Найдите на кладбище, в руке и в библиотеке целевого игрока любое количество карт с тем именем и изгоните их. Тот игрок тасует свою библиотеку, затем берет одну карту за каждую карту, изгнанную из руки таким образом.\', \'type\': \'Волшебство\', \'flavor\': \'«Это имя произносить запрещено». — Бараль, старший по повиновению\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420037&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1e01ba60-799c-4330-9d14-0309ac59ea0b\', \'multiverseId\': 420037}, \'multiverseid\': 420037}, {\'name\': \'佚失遗物\', \'text\': \'说出一个非神器且非地的牌之名称。从目标牌手的坟墓场，手牌及牌库中搜寻任意数量该名称的牌，并将它们放逐。该牌手将其牌库洗牌，然后每有一张以此法放逐的手牌，他便抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「禁说此名。」 ～监察长巴罗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417925&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'40dd5dc3-f52c-44c2-9fcd-e36aeaa00ff8\', \'multiverseId\': 417925}, \'multiverseid\': 417925}, {\'name\': \'佚失遺物\', \'text\': \'說出一個非神器且非地的牌之名稱。從目標玩家的墳墓場、手牌以及牌庫中搜尋任意數量該名稱的牌，並將它們放逐。該玩家將其牌庫洗牌，然後每有一張以此法放逐的手牌，他便抽一張牌。\', \'type\': \'巫術\', \'flavor\': \'「禁說此名。」 ～監察長巴羅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418189&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ddb9e6b8-daea-4a07-b6f7-8cf4ac149009\', \'multiverseId\': 418189}, \'multiverseid\': 418189}]', '[{\'name\': \'Verschwindetrick\', \'text\': \'Bringe als zusätzliche Kosten, um den Verschwindetrick zu wirken, eine bleibende Karte, die du kontrollierst, auf die Hand ihres Besitzers zurück.\\nNeutralisiere einen Zauberspruch deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Baral hat mir damals meine Familie genommen. Ich würde alles tun, um ihm jetzt gegenüberzutreten." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418408&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81193580-a906-4ef1-b244-b65f46c2bfb1\', \'multiverseId\': 418408}, \'multiverseid\': 418408}, {\'name\': \'Acto de desaparición\', \'text\': \'Como coste adicional para lanzar el Acto de desaparición, regresa un permanente que controlas a la mano de su propietario.\\nContrarresta el hechizo objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Baral me arrebató a mi familia en el pasado. Haría cualquier cosa por enfrentarme a él ahora". —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420256&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3e322dfa-84cf-4a26-be07-262c97a51a13\', \'multiverseId\': 420256}, \'multiverseid\': 420256}, {\'name\': \'Numéro de disparition\', \'text\': \'En tant que coût supplémentaire pour lancer le Numéro de disparition, renvoyez un permanent que vous contrôlez dans la main de son propriétaire.\\nContrecarrez le sort ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« À l\'époque, Baral m\'a enlevé ma famille. Je donnerai n\'importe quoi pour l\'affronter aujourd\'hui. » —Chandra Nalaàr", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418672&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'93a55d20-7413-42af-9079-d7ce1a7dac89\', \'multiverseId\': 418672}, \'multiverseid\': 418672}, {\'name\': \'Trucco di Sparizione\', \'text\': \'Come costo addizionale per lanciare il Trucco di Sparizione, fai tornare un permanente che controlli in mano al suo proprietario.\\nNeutralizza una magia bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Baral in passato mi ha strappato la mia famiglia. Darei qualsiasi cosa per affrontarlo adesso." —Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418936&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5b271562-cb62-4777-b24f-84e0c08b7cd2\', \'multiverseId\': 418936}, \'multiverseid\': 418936}, {\'name\': \'失跡\', \'text\': \'失跡を唱えるための追加コストとして、あなたがコントロールするパーマネント１つをオーナーの手札に戻す。\\n呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「あの時バラルが、私から家族を奪った。あいつと対決するためなら、何だってやるわ。」 ――チャンドラ・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419200&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9831647-66d4-4c61-bf08-4f2781606aac\', \'multiverseId\': 419200}, \'multiverseid\': 419200}, {\'name\': \'모습 감추기\', \'text\': \'모습 감추기를 발동하기 위한 추가비용으로, 당신이 조종하는 지속물을 소유자의 손으로 되돌린다.\\n주문을 목표로 정한다. 그 주문을 무효화한다.\', \'type\': \'순간마법\', \'flavor\': \'"그때 바랄이 내 가족을 끌고 갔어. 그놈을 만날 수만 있다면 무슨 일이든 하겠어." —찬드라 날라르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419464&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7b3dd426-3c03-42e3-91d2-8102f3b7265e\', \'multiverseId\': 419464}, \'multiverseid\': 419464}, {\'name\': \'Truque de Desaparecimento\', \'text\': \'Como custo adicional para conjurar Truque de Desaparecimento, devolva uma permanente que você controla para a mão de seu dono.\\nAnule a mágica alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Baral tirou minha família de mim naquela época. Eu faria qualquer coisa para enfrentá-lo agora." — Chandra Nalaar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419728&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2faa154c-dcc9-4f8a-bbbf-b6395df03c6c\', \'multiverseId\': 419728}, \'multiverseid\': 419728}, {\'name\': \'Трюк с Исчезновением\', \'text\': \'В качестве дополнительной стоимости разыгрывания Трюка с Исчезновением верните перманент под вашим контролем в руку его владельца.\\nОтмените целевое заклинание.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Бараль тогда отобрал у меня семью. Сейчас я готова на все, чтобы с ним встретиться». — Чандра Налаар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419992&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f9fde0d0-a49a-40df-ab0e-af164d446488\', \'multiverseId\': 419992}, \'multiverseid\': 419992}, {\'name\': \'消失把戏\', \'text\': \'将一个由你操控的永久物移回其拥有者手上，以作为施放消失把戏的额外费用。\\n反击目标咒语。\', \'type\': \'瞬间\', \'flavor\': \'「巴罗先前让我家破人亡。如今我愿不惜一切代价找上他。」 ～茜卓纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417880&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3e2bdcf-9741-42ad-873e-d02399307b45\', \'multiverseId\': 417880}, \'multiverseid\': 417880}, {\'name\': \'消失把戲\', \'text\': \'將一個由你操控的永久物移回其擁有者手上，以作為施放消失把戲的額外費用。\\n反擊目標咒語。\', \'type\': \'瞬間\', \'flavor\': \'「巴羅先前讓我家破人亡。如今我願不惜一切代價找上他。」 ～茜卓納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418144&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a8e145bf-48ec-42ed-8071-100cc0673b70\', \'multiverseId\': 418144}, \'multiverseid\': 418144}]', '[{\'name\': \'Visionäre Augmentiererin\', \'text\': \'Fabrizieren 2 (Wenn diese Kreatur ins Spiel kommt, lege zwei +1/+1-Marken auf sie oder erzeuge zwei 1/1 farblose Servo-Artefaktkreaturenspielsteine.)\', \'type\': \'Kreatur — Zwerg, Handwerker\', \'flavor\': \'„Es handelt sich um ein multifunktionales, radiales Erweiterungssystem mit superlateralem, kraftverstärkendem Aufbau. Natürlich wird es gewinnen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418399&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e59a49c7-7d4b-4402-88c9-e158124cae5a\', \'multiverseId\': 418399}, \'multiverseid\': 418399}, {\'name\': \'Aumentadora visionaria\', \'text\': \'Fabricar 2. (Cuando esta criatura entre al campo de batalla, pon dos contadores +1/+1 sobre ella o crea dos fichas de criatura artefacto Servo incoloras 1/1.)\', \'type\': \'Criatura — Enano artífice\', \'flavor\': \'"Es un sistema de extensión radial multifuncional con un modelado supralateral que amplifica la fuerza. Claro que ganará".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420247&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f33ba237-aa03-43bd-aabf-d31517e6b527\', \'multiverseId\': 420247}, \'multiverseid\': 420247}, {\'name\': \'Amplificatrice visionnaire\', \'text\': \'Fabrication 2 (Quand cette créature arrive sur le champ de bataille, mettez deux marqueurs +1/+1 sur elle ou créez deux jetons de créature-artefact 1/1 incolore Servo.)\', \'type\': \'Créature : nain et artificier\', \'flavor\': "« Il s\'agit d\'un système radial multifonction équipé d\'un mécanisme latéral amplificateur de force. Bien sûr qu\'il va gagner. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418663&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1cd67143-4028-47b6-bc65-ecba62c6a0e3\', \'multiverseId\': 418663}, \'multiverseid\': 418663}, {\'name\': \'Potenziatrice Visionaria\', \'text\': \'Fabbrica 2 (Quando questa creatura entra nel campo di battaglia, metti due segnalini +1/+1 su di essa o crea due pedine creatura artefatto Servomeccanismo 1/1 incolori.)\', \'type\': \'Creatura — Artefice Nano\', \'flavor\': \'"È un sistema multifunzionale di estensione radiale con impianto amplificatore sopralaterale. Mi pare ovvio che vincerà."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418927&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e891640-aaf7-4022-9c0f-398946cb5f50\', \'multiverseId\': 418927}, \'multiverseid\': 418927}, {\'name\': \'先見的な増強者\', \'text\': \'製造２（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを２個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを２体生成する。）\', \'type\': \'クリーチャー — ドワーフ・工匠\', \'flavor\': \'「これはね、側外部筋力増幅機構付きの多機能骨格延長システムなのよ。もちろん勝つわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419191&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76980fe5-048f-4048-b7e4-b8eab790119f\', \'multiverseId\': 419191}, \'multiverseid\': 419191}, {\'name\': \'명석한 강화복제작자\', \'text\': \'제작 2 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 두 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 두 개를 만든다.)\', \'type\': \'생물 — 드워프 기능공\', \'flavor\': \'"측면 공격력이 엄청나게 강화된 다기능 방사형 확장 시스템입니다. 당연히 1등감이죠."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419455&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'70f71bb4-f2c1-46c3-a437-fa5740a8c826\', \'multiverseId\': 419455}, \'multiverseid\': 419455}, {\'name\': \'Amplificadora Visionária\', \'text\': \'Fabricar 2 (Quando esta criatura entrar no campo de batalha, coloque dois marcadores +1/+1 nela ou crie duas fichas de criatura artefato incolor 1/1 do tipo Servus.)\', \'type\': \'Criatura — Anão Artesão\', \'flavor\': \'"É um sistema de extensão radial multifuncional com aparato amplificador de força superlateral. É claro que vai ganhar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419719&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'712039b8-7cae-4013-96c9-32488e6e8132\', \'multiverseId\': 419719}, \'multiverseid\': 419719}, {\'name\': \'Дальновидная Усилительница\', \'text\': \'Производство 2 (Когда это существо выходит на поле битвы, положите на него два жетона +1/+1 или создайте две фишки артефакта существа 1/1 бесцветный Сервотрон.)\', \'type\': \'Существо — Гном Механик\', \'flavor\': \'«Тут стоит многофункциональная радиальная система расширения с суперлатеральной усиливающей оснасткой. Само собой, он победит».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419983&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'62938667-0688-4952-9e34-ead471994f70\', \'multiverseId\': 419983}, \'multiverseid\': 419983}, {\'name\': \'创见增现师\', \'text\': \'装配2（当此生物进战场时，在其上放置两个+1/+1指示物或派出两个1/1无色自动机衍生神器生物。）\', \'type\': \'生物～矮人／神器师\', \'flavor\': \'「它不仅有多功能放射状延展系统，还配备超外层增力传动装置。它当然会赢。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417871&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79769751-7aa3-44f5-96a6-1026baadca7a\', \'multiverseId\': 417871}, \'multiverseid\': 417871}, {\'name\': \'創見增現師\', \'text\': \'裝配2（當此生物進戰場時，在其上放置兩個+1/+1指示物或派出兩個1/1無色自動機衍生神器生物。）\', \'type\': \'生物～矮人／神器師\', \'flavor\': \'「它不僅有多功能放射狀延展系統，還配備超外層增力傳動裝置。它當然會贏。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418135&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bf2b0e09-15ba-43b9-af1d-a71fd684cd49\', \'multiverseId\': 418135}, \'multiverseid\': 418135}]', '[{\'name\': \'Vitalitätsschub\', \'text\': \'Eine Kreatur deiner Wahl erhält +1/+0, Lebensverknüpfung und Unzerstörbarkeit bis zum Ende des Zuges. (Schaden, der von ihr zugefügt wird, lässt ihren Beherrscher ebenso viele Lebenspunkte dazuerhalten, und sie kann weder durch Schaden zerstört werden, noch von Effekten, die „zerstören".)\', \'type\': \'Spontanzauber\', \'flavor\': \'Kurze Leben verleiten zu verbotenen Entscheidungen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418464&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d480a174-5761-4868-b863-05bb716f8e01\', \'multiverseId\': 418464}, \'multiverseid\': 418464}, {\'name\': \'Ráfaga de vitalidad\', \'text\': \'La criatura objetivo obtiene +1/+0 y gana las habilidades de vínculo vital e indestructible hasta el final del turno. (El daño hecho por esa criatura también hace que su controlador gane esa misma cantidad de vidas, y no puede ser destruida por daño o por efectos que digan "destruye".)\', \'type\': \'Instantáneo\', \'flavor\': \'Las vidas cortas llevan a tomar decisiones prohibidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420312&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'23b2c6c5-334f-40b7-9695-cacd666792ad\', \'multiverseId\': 420312}, \'multiverseid\': 420312}, {\'name\': \'Afflux de vitalité\', \'text\': "La créature ciblée gagne +1/+0 et acquiert le lien de vie et l\'indestructible jusqu\'à la fin du tour. (Les blessures infligées par cette créature font aussi gagner autant de points de vie à son contrôleur, et elle ne peut pas être détruite par les blessures ou les effets qui indiquent « détruisez ».)", \'type\': \'Éphémère\', \'flavor\': \'Une vie courte mène à des choix défendus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418728&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'725b4cfd-746f-4479-95c8-59038ac39ed9\', \'multiverseId\': 418728}, \'multiverseid\': 418728}, {\'name\': \'Scarica di Vitalità\', \'text\': \'Una creatura bersaglio prende +1/+0 e ha legame vitale e indistruttibile fino alla fine del turno. (Il danno inflitto da quella creatura fa anche guadagnare al suo controllore altrettanti punti vita ed essa non può essere distrutta dal danno o dagli effetti che dicono "distruggi".)\', \'type\': \'Istantaneo\', \'flavor\': \'Vite brevi spingono a scelte proibite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418992&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca4d5aa8-fa4c-4723-a8cf-5ad9ecd76e9d\', \'multiverseId\': 418992}, \'multiverseid\': 418992}, {\'name\': \'活力の奔出\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは＋１/＋０の修整を受けるとともに絆魂と破壊不能を得る。（そのクリーチャーがダメージを与えると、さらにそのコントローラーはその点数分のライフを得る。ダメージや「破壊」と書かれた効果では、それは破壊されない。）\', \'type\': \'インスタント\', \'flavor\': \'短命の者は禁断の行為に流れやすい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419256&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'467a1825-b22a-45ba-8961-ce70d164440c\', \'multiverseId\': 419256}, \'multiverseid\': 419256}, {\'name\': \'활력 분출\', \'text\': \'생물을 목표로 정한다. 그 생물은 턴종료까지 +1/+0을 받고 생명연결과 무적을 얻는다. (그 생물이 피해를 입히면 그 생물의 조종자는 그 피해만큼 생명점을 얻는다. 또한 이 생물은 피해 혹은 "파괴"라고 명시된 효과에 의해 파괴될 수 없다.)\', \'type\': \'순간마법\', \'flavor\': \'삶이 얼마 남지 않은 자는 금지된 선택도 서슴지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419520&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8e1c2e4f-4cde-4971-9863-ee5dd228893b\', \'multiverseId\': 419520}, \'multiverseid\': 419520}, {\'name\': \'Ímpeto de Vitalidade\', \'text\': \'A criatura alvo recebe +1/+0 e ganha vínculo com a vida e indestrutível até o final do turno. (O dano causado por aquela criatura também faz com que seu controlador ganhe uma quantidade equivalente de pontos de vida, e ela não pode ser destruída por dano nem por efeitos que dizem "destrua".)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Vidas curtas levam a escolhas proibidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44e6f3a5-7296-4d1f-84bb-8490eb79a447\', \'multiverseId\': 419784}, \'multiverseid\': 419784}, {\'name\': \'Приток Жизни\', \'text\': \'Целевое существо получает +1/+0, Цепь жизни и Неразрушимость до конца хода. (Повреждения, наносимые тем существом, также заставляют контролирующего его игрока получить такое же количество жизней, и оно не может быть уничтожено повреждениями и эффектами с указанием «уничтожьте».)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Недолгая жизнь заставляет пойти на нарушение запретов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420048&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0fc1ee74-58ea-4b2a-8831-978a191e4284\', \'multiverseId\': 420048}, \'multiverseid\': 420048}, {\'name\': \'活力突袭\', \'text\': \'直到回合结束，目标生物得+1/+0且获得系命与不灭异能。（该生物所造成的伤害会让其操控者获得等量的生命，且伤害与注明「消灭」的效应不会将该生物消灭。）\', \'type\': \'瞬间\', \'flavor\': \'短暂生命引发不法之举。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417936&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3ae6b212-c8e4-4443-817d-aab915108698\', \'multiverseId\': 417936}, \'multiverseid\': 417936}, {\'name\': \'活力突襲\', \'text\': \'直到回合結束，目標生物得+1/+0且獲得繫命與不滅異能。(該生物所造成的傷害會讓其操控者獲得等量的生命，且傷害與註明「消滅」的效應不會將該生物消滅。）\', \'type\': \'瞬間\', \'flavor\': \'短暫生命引發不法之舉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418200&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'639d5263-fe6e-4179-be6d-5d089debd70c\', \'multiverseId\': 418200}, \'multiverseid\': 418200}]', '[{\'name\': \'Vollendete Kampfmaschine\', \'text\': \'Fabrizieren 1 (Wenn diese Kreatur ins Spiel kommt, lege eine +1/+1-Marke auf sie oder erzeuge einen 1/1 farblosen Servo-Artefaktkreaturenspielstein.)\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'War sie nur einsam, oder war die nächste Evolutionsstufe unumgänglich?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418556&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48d4393e-cefd-45af-9422-310e202770e4\', \'multiverseId\': 418556}, \'multiverseid\': 418556}, {\'name\': \'Autómata consumado\', \'text\': \'Fabricar 1. (Cuando esta criatura entre al campo de batalla, pon un contador +1/+1 sobre ella o crea una ficha de criatura artefacto Servo incolora 1/1.)\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'¿Se sentía solo, o fue algún tipo de evolución inevitable?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420404&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72151853-0733-4cf1-9eff-078669d9f9e8\', \'multiverseId\': 420404}, \'multiverseid\': 420404}, {\'name\': \'Automate accompli\', \'text\': \'Fabrication 1 (Quand cette créature arrive sur le champ de bataille, mettez un marqueur +1/+1 sur elle ou créez un jeton de créature-artefact 1/1 incolore Servo.)\', \'type\': \'Créature-artefact : construction\', \'flavor\': "Souffrait-il de la solitude, ou l\'évolution était-elle inévitable ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418820&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6821af3-69d9-4f63-b796-c231ffbf2870\', \'multiverseId\': 418820}, \'multiverseid\': 418820}, {\'name\': \'Abile Automa\', \'text\': \'Fabbrica 1 (Quando questa creatura entra nel campo di battaglia, metti un segnalino +1/+1 su di essa o crea una pedina creatura artefatto Servomeccanismo 1/1 incolore.)\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': "Che sia il frutto della solitudine o di un\'evoluzione inevitabile?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419084&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'09a685e5-0ef9-42c2-82dc-92ef503f1c34\', \'multiverseId\': 419084}, \'multiverseid\': 419084}, {\'name\': \'成し遂げた自動機械\', \'text\': \'製造１（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを１個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを１体生成する。）\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'単に寂しいからか、それとも不可避な進化の形態か？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419348&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e033cb0-47c9-4cfc-804e-3e2bc5c0fcfd\', \'multiverseId\': 419348}, \'multiverseid\': 419348}, {\'name\': \'뛰어난 자동장치\', \'text\': \'제작 1 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 한 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 한 개를 만든다.)\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': \'단지 외로운 것인가? 아니면 일종의 불가피한 진화 방식인가?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419612&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3c051e06-1ad5-4d15-82c2-eb3d5e271d04\', \'multiverseId\': 419612}, \'multiverseid\': 419612}, {\'name\': \'Autômato Talentoso\', \'text\': \'Fabricar 1 (Quando esta criatura entrar no campo de batalha, coloque um marcador +1/+1 nela ou crie uma ficha de criatura artefato incolor 1/1 do tipo Servus.)\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': \'Ele só estava solitário, ou alguma forma de evolução era inevitável?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3026902c-81b7-4939-afc1-8568d980b76d\', \'multiverseId\': 419876}, \'multiverseid\': 419876}, {\'name\': \'Совершенный Автомат\', \'text\': \'Производство 1 (Когда это существо выходит на поле битвы, положите на него один жетон +1/+1 или создайте одну фишку артефакта существа 1/1 бесцветный Сервотрон.)\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': \'Ему просто было одиноко, или же определенного рода эволюция была неизбежной?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420140&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f0462867-806f-4121-b8ee-6a6e8aed707a\', \'multiverseId\': 420140}, \'multiverseid\': 420140}, {\'name\': \'高明机械兽\', \'text\': \'装配1（当此生物进战场时，在其上放置一个+1/+1指示物或派出一个1/1无色自动机衍生神器生物。）\', \'type\': \'神器生物～组构体\', \'flavor\': \'只是因为它孤单，还是说某种进化已成必然？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418028&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ddc79bb9-8702-444d-9d6a-66b90932b270\', \'multiverseId\': 418028}, \'multiverseid\': 418028}, {\'name\': \'高明機械獸\', \'text\': \'裝配1（當此生物進戰場時，在其上放置一個+1/+1指示物或派出一個1/1無色自動機衍生神器生物。）\', \'type\': \'神器生物～組構體\', \'flavor\': \'只是因為它孤單，還是說某種進化已成必然？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418292&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cfdb3d20-d643-4233-a4ba-d1f1f3a24be6\', \'multiverseId\': 418292}, \'multiverseid\': 418292}]', '[{\'name\': \'Voltaischer Raufbold\', \'text\': \'Wenn der Voltaische Raufbold ins Spiel kommt, erhältst du {E}{E} (zwei Energiemarken).\\nImmer wenn der Voltaische Raufbold angreift, kannst du {E} bezahlen. Falls du dies tust, erhält er +1/+1 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418554&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a9e76387-2905-4f9e-baee-3bccdfd28e1d\', \'multiverseId\': 418554}, \'multiverseid\': 418554}, {\'name\': \'Pendenciero voltaico\', \'text\': \'Cuando el Pendenciero voltaico entre al campo de batalla, obtienes {E}{E} (dos contadores de energía).\\nSiempre que el Pendenciero voltaico ataque, puedes pagar {E}. Si lo haces, obtiene +1/+1 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2202c04-4e52-414d-a918-3b32da4edef5\', \'multiverseId\': 420402}, \'multiverseid\': 420402}, {\'name\': \'Bagarreur voltaïque\', \'text\': "Quand le Bagarreur voltaïque arrive sur le champ de bataille, vous gagnez {E}{E} (deux marqueurs « énergie »).\\nÀ chaque fois que le Bagarreur voltaïque attaque, vous pouvez payer {E}. Si vous faites ainsi, il gagne +1/+1 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418818&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'828f892d-18ec-41b9-91ac-4d9d8648c2b4\', \'multiverseId\': 418818}, \'multiverseid\': 418818}, {\'name\': \'Lottatore Voltaico\', \'text\': \'Quando il Lottatore Voltaico entra nel campo di battaglia, ottieni {E}{E} (due segnalini energia).\\nOgniqualvolta il Lottatore Voltaico attacca, puoi pagare {E}. Se lo fai, prende +1/+1 e ha travolgere fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419082&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5bfaaca8-b351-4902-8025-c4bcc7d72060\', \'multiverseId\': 419082}, \'multiverseid\': 419082}, {\'name\': \'通電の喧嘩屋\', \'text\': \'通電の喧嘩屋が戦場に出たとき、あなたは{E}{E}（エネルギー・カウンター２個）を得る。\\n通電の喧嘩屋が攻撃するたび、あなたは{E}を支払ってもよい。そうしたなら、ターン終了時まで、これは＋１/＋１の修整を受けるとともにトランプルを得る。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419346&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64de6ff2-5d74-410a-b5d3-41c2302803ab\', \'multiverseId\': 419346}, \'multiverseid\': 419346}, {\'name\': \'전기 싸움꾼\', \'text\': \'전기 싸움꾼이 전장에 들어올 때, 당신은 {E}{E}(에너지 카운터 두 개)를 얻는다.\\n전기 싸움꾼이 공격할 때마다, 당신은 {E}를 지불할 수 있다. 그렇게 한다면, 전기 싸움꾼은 턴종료까지 +1/+1를 받고 돌진을 얻는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419610&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8e37d724-c6b2-411a-bf82-72a4235c6be0\', \'multiverseId\': 419610}, \'multiverseid\': 419610}, {\'name\': \'Brigão Voltaico\', \'text\': \'Quando Brigão Voltaico entra no campo de batalha, você recebe {E}{E} (dois marcadores de energia).\\nToda vez que Brigão Voltaico ataca, você pode pagar {E}. Se fizer isso, ele recebe +1/+1 e ganha atropelar até o final do turno.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419874&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15849716-8eed-45b2-8513-00b762909cbe\', \'multiverseId\': 419874}, \'multiverseid\': 419874}, {\'name\': \'Гальванический Боец\', \'text\': \'Когда Гальванический Боец выходит на поле битвы, вы получаете {E}{E} (два жетона энергии).\\nКаждый раз, когда Гальванический Боец атакует, вы можете заплатить {E}. Если вы это делаете, он получает +1/+1 и Пробивной удар до конца хода.\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420138&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'45610ae5-0fbe-425d-b81f-1fe7d7ce31e3\', \'multiverseId\': 420138}, \'multiverseid\': 420138}, {\'name\': \'电流喧哗兵\', \'text\': \'当电流喧哗兵进战场时，你得到{E}{E}（两个能量指示物）。\\n每当电流喧哗兵攻击时，你可以支付{E}。若你如此作，则直到回合结束，它得+1/+1且获得践踏异能。\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418026&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'974d8868-1fca-48ea-8c4e-b4e45e5cd2a2\', \'multiverseId\': 418026}, \'multiverseid\': 418026}, {\'name\': \'電流喧嘩兵\', \'text\': \'當電流喧嘩兵進戰場時，你得到{E}{E}（兩個能量指示物）。\\n每當電流喧嘩兵攻擊時，你可以支付{E}。若你如此作，則直到回合結束，它得+1/+1且獲得踐踏異能。\', \'type\': \'生物～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418290&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ca4902b8-58be-4dd7-a1b4-0319ffc11d29\', \'multiverseId\': 418290}, \'multiverseid\': 418290}]', '[{\'name\': \'Vorbildlicher Werkzeugmacher\', \'text\': \'Zu Beginn des Kampfes in deinem Zug und falls du ein Artefakt kontrollierst, erhält der Vorbildliche Werkzeugmacher +2/+1 bis zum Ende des Zuges. Falls du drei oder mehr Artefakte kontrollierst, erhält er außerdem Erstschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zwerg, Handwerker\', \'flavor\': \'„Wenn du das beste Produkt herstellen willst, musst du mit den besten Werkzeugen arbeiten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418397&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0beba161-9c4e-42d1-a710-8c265f0461b9\', \'multiverseId\': 418397}, \'multiverseid\': 418397}, {\'name\': \'Maestro de forja de herramientas\', \'text\': \'Al comienzo del combate en tu turno, si controlas un artefacto, el Maestro de forja de herramientas obtiene +2/+1 hasta el final del turno. Si controlas tres o más artefactos, también gana la habilidad de dañar primero hasta el final del turno.\', \'type\': \'Criatura — Enano artífice\', \'flavor\': \'"Si quieres producir un objeto sublime, debes empezar usando las mejores herramientas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420245&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c6c64d6-cf12-40f4-ae20-892d3d2505af\', \'multiverseId\': 420245}, \'multiverseid\': 420245}, {\'name\': "Archétype de façonneur d\'outils", \'text\': "Au début du combat pendant votre tour, si vous contrôlez un artefact, l\'Archétype de façonneur d\'outils gagne +2/+1 jusqu\'à la fin du tour. Si vous contrôlez au moins trois artefacts, il acquiert aussi l\'initiative jusqu\'à la fin du tour.", \'type\': \'Créature : nain et artificier\', \'flavor\': \'« Pour réaliser les travaux les plus délicats, il faut disposer des outils les plus raffinés. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418661&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef75e26b-d422-49a6-86bd-5afd64e31d80\', \'multiverseId\': 418661}, \'multiverseid\': 418661}, {\'name\': \'Forgiattrezzi Esemplare\', \'text\': "All\'inizio del combattimento nel tuo turno, se controlli un artefatto, il Forgiattrezzi Esemplare prende +2/+1 fino alla fine del turno. Se controlli tre o più artefatti, ha anche attacco improvviso fino alla fine del turno.", \'type\': \'Creatura — Artefice Nano\', \'flavor\': \'"Le creazioni migliori richiedono i migliori strumenti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418925&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6438f218-9397-46e1-982d-bf248f8a9064\', \'multiverseId\': 418925}, \'multiverseid\': 418925}, {\'name\': \'模範的な造り手\', \'text\': \'あなたのターンの戦闘の開始時に、あなたがアーティファクトをコントロールしている場合、ターン終了時まで、模範的な造り手は＋２/＋１の修整を受ける。あなたがアーティファクトを３つ以上コントロールしているなら、ターン終了時まで、これは先制攻撃も得る。\', \'type\': \'クリーチャー — ドワーフ・工匠\', \'flavor\': \'「最高の作品を創り上げたいなら、最高の道具を使わないとね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419189&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac8368d4-47b8-4b08-a189-d492c80a45d3\', \'multiverseId\': 419189}, \'multiverseid\': 419189}, {\'name\': \'공구제작술의 귀감\', \'text\': \'당신의 턴 전투 시작에, 당신이 마법물체를 조종하고 있다면, 공구제작술의 귀감은 턴종료까지 +2/+1을 받는다. 당신이 마법물체를 세 개 이상 조종하고 있다면, 공구제작술의 귀감은 턴종료까지 선제공격도 얻는다.\', \'type\': \'생물 — 드워프 기능공\', \'flavor\': \'"최고의 물건을 만들고 싶다면, 최고의 공구를 가지고 시작해야 하지요."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419453&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3444d394-5b78-4c88-861e-79aacb895936\', \'multiverseId\': 419453}, \'multiverseid\': 419453}, {\'name\': \'Ferramenteiro Exemplar\', \'text\': \'No início do combate no seu turno, se você controla um artefato, Ferramenteiro Exemplar recebe +2/+1 até o final do turno. Se você controla três ou mais artefatos, ele também ganha iniciativa até o final do turno.\', \'type\': \'Criatura — Anão Artesão\', \'flavor\': \'"Se você quer fazer o melhor trabalho, precisa começar com as melhores ferramentas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419717&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2c50f5c-a460-4466-97ca-66b8091e75a2\', \'multiverseId\': 419717}, \'multiverseid\': 419717}, {\'name\': \'Мастер по Инструментам\', \'text\': \'В начале боя во время вашего хода, если под вашим контролем есть артефакт, то Мастер по Инструментам получает +2/+1 до конца хода. Если под вашим контролем есть не менее трех артефактов, он также получает Первый удар до конца хода.\', \'type\': \'Существо — Гном Механик\', \'flavor\': \'«Если хочешь получить превосходный результат, начни с превосходных инструментов».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419981&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cf8cebf2-c7b1-491f-bd52-12686e207994\', \'multiverseId\': 419981}, \'multiverseid\': 419981}, {\'name\': \'匠技模范\', \'text\': \'在你回合的战斗开始时，若你操控神器，则匠技模范得+2/+1直到回合结束。若你操控三个或更多神器，则它再获得先攻异能直到回合结束。\', \'type\': \'生物～矮人／神器师\', \'flavor\': \'「工欲善其事，必先利其器。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417869&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f0f2f842-a2bc-4f0c-92b2-3094e463fc4f\', \'multiverseId\': 417869}, \'multiverseid\': 417869}, {\'name\': \'匠技模範\', \'text\': \'在你回合的戰鬥開始時，若你操控神器，則匠技模範得+2/+1直到回合結束。若你操控三個或更多神器，則它再獲得先攻異能直到回合結束。\', \'type\': \'生物～矮人／神器師\', \'flavor\': \'「工欲善其事，必先利其器。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418133&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'197d9c35-0d24-4c27-8885-3be44121a0c5\', \'multiverseId\': 418133}, \'multiverseid\': 418133}]', "[{'name': 'Vorsteher der Gießerei', 'text': 'Andere Artefaktkreaturen, die du kontrollierst, erhalten +1/+1.', 'type': 'Artefaktkreatur — Konstrukt', 'flavor': 'Die Gießereien von Kaladesh laufen wie Uhrwerke unter der Kontrolle ihrer formidablen Aufseher.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418565&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b261c39a-52c6-4604-963d-de489ce9df7f', 'multiverseId': 418565}, 'multiverseid': 418565}, {'name': 'Capataz de la fundición', 'text': 'Las otras criaturas artefacto que controlas obtienen +1/+1.', 'type': 'Criatura artefacto — Constructo', 'flavor': 'Las fundiciones de Kaladesh funcionan como un reloj bajo la supervisión de sus formidables supervisores.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420413&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '701373a2-f580-49dc-add7-eb6dbbcac762', 'multiverseId': 420413}, 'multiverseid': 420413}, {'name': 'Chef de la fonderie', 'text': 'Les autres créatures-artefacts que vous contrôlez gagnent +1/+1.', 'type': 'Créature-artefact : construction', 'flavor': 'Les fonderies de Kaladesh fonctionnent impeccablement sous la supervision de leurs redoutables brigadiers.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418829&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4d0382dd-26ad-49df-b53e-7f077bc2ec88', 'multiverseId': 418829}, 'multiverseid': 418829}, {'name': 'Capo della Fonderia', 'text': 'Le altre creature artefatto che controlli prendono +1/+1.', 'type': 'Creatura Artefatto — Costrutto', 'flavor': 'Le fonderie di Kaladesh funzionano alla perfezione sotto la supervisione dei loro formidabili sovrintendenti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419093&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4fe0b823-4298-49b3-8339-cfa97a0cf09f', 'multiverseId': 419093}, 'multiverseid': 419093}, {'name': '鋳造所の隊長', 'text': 'あなたがコントロールする他のアーティファクト・クリーチャーは＋１/＋１の修整を受ける。', 'type': 'アーティファクト・クリーチャー — 構築物', 'flavor': 'カラデシュの鋳造所は、その恐るべき監督者の管理の下で時計仕掛けのように規則正しく運営されている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419357&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bfe26da3-1b47-4622-b73e-1119df30e564', 'multiverseId': 419357}, 'multiverseid': 419357}, {'name': '주조소 주임', 'text': '당신이 조종하는 다른 마법물체 생물들은 +1/+1을 받는다.', 'type': '마법물체 생물 — 자동기계', 'flavor': '칼라데시의 주조소는 능력 있는 감독관의 지도하에 톱니바퀴처럼 돌아간다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419621&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '4c9ad1f4-341c-4072-9118-c7ea2f96dcd7', 'multiverseId': 419621}, 'multiverseid': 419621}, {'name': 'Chefe da Fundição', 'text': 'As outras criaturas artefato que você controla recebem +1/+1.', 'type': 'Criatura Artefato — Constructo', 'flavor': 'Os magníficos supervisores das fundições de Kaladesh garantem que elas funcionem como um relógio.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419885&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9bacdae2-29ff-49cc-a720-7e7d8fc6ba21', 'multiverseId': 419885}, 'multiverseid': 419885}, {'name': 'Мастер Литейной', 'text': 'Другие артефакты существа под вашим контролем получают +1/+1.', 'type': 'Артефакт Существо — Конструкция', 'flavor': 'Литейные Каладеша как часы работают под присмотром грозных мастеров.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420149&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '348aa70a-e5d9-4920-bcd3-ba7e3cb65840', 'multiverseId': 420149}, 'multiverseid': 420149}, {'name': '铸造厂主管', 'text': '由你操控的其他神器生物得+1/+1。', 'type': '神器生物～组构体', 'flavor': '卡拉德许的铸造厂在其强横的主管监督下，如钟表装置般规律地运转。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418037&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '945baa5e-4266-4501-9a32-bd45a0cc878d', 'multiverseId': 418037}, 'multiverseid': 418037}, {'name': '鑄造廠主管', 'text': '由你操控的其他神器生物得+1/+1。', 'type': '神器生物～組構體', 'flavor': '卡拉德許的鑄造廠在其強橫的主管監督下，如鐘錶裝置般規律地運轉。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418301&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '33ded75c-9721-4d98-9b3a-81602fbc7b0c', 'multiverseId': 418301}, 'multiverseid': 418301}]", '[{\'name\': \'Waffenbaukunst-Enthusiast\', \'text\': \'Fabrizieren 2 (Wenn diese Kreatur ins Spiel kommt, lege zwei +1/+1-Marken auf sie oder erzeuge zwei 1/1 farblose Servo-Artefaktkreaturenspielsteine.)\', \'type\': \'Kreatur — Äthergeborener, Handwerker\', \'flavor\': \'„Nein, ich glaube, dafür wurden die erforderlichen Genehmigungen nicht eingeholt, aber ich werde bestimmt nicht danach fragen." —Caru, Konsulatwärter\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418470&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee1ac1a9-b563-4f87-81d7-e9713d0123f8\', \'multiverseId\': 418470}, \'multiverseid\': 418470}, {\'name\': \'Entusiasta de la forja de armas\', \'text\': \'Fabricar 2. (Cuando esta criatura entre al campo de batalla, pon dos contadores +1/+1 sobre ella o crea dos fichas de criatura artefacto Servo incoloras 1/1.)\', \'type\': \'Criatura — Artífice etergénito\', \'flavor\': \'"No, no creo que tengan los permisos en regla para esas cosas, pero no voy a ser yo quien pregunte". —Caru, guardia del Consulado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420318&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4d9cbf4-29ca-4788-9ae1-440f121b9312\', \'multiverseId\': 420318}, \'multiverseid\': 420318}, {\'name\': "Façonneur d\'armes amateur", \'text\': \'Fabrication 2 (Quand cette créature arrive sur le champ de bataille, mettez deux marqueurs +1/+1 sur elle ou créez deux jetons de créature-artefact 1/1 incolore Servo.)\', \'type\': \'Créature : éthérien et artificier\', \'flavor\': "« Non, je ne crois pas qu\'ils aient les bons permis pour ça, mais je ne vais pas aller les leur demander. » —Caru, garde du Consulat", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418734&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ab932c2-1f73-4611-9c47-0c451f055a1a\', \'multiverseId\': 418734}, \'multiverseid\': 418734}, {\'name\': \'Forgiarsenale Fanatico\', \'text\': \'Fabbrica 2 (Quando questa creatura entra nel campo di battaglia, metti due segnalini +1/+1 su di essa o crea due pedine creatura artefatto Servomeccanismo 1/1 incolori.)\', \'type\': \'Creatura — Artefice Eteride\', \'flavor\': \'"No, non credo che abbia i permessi necessari per quelle, ma non sarò io a chiedergli di mostrarmeli." —Caru, guardiano del Consolato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418998&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'438460dd-3744-4c87-97a8-8033fdf66702\', \'multiverseId\': 418998}, \'multiverseid\': 418998}, {\'name\': \'武器作り狂\', \'text\': \'製造２（このクリーチャーが戦場に出たとき、これの上に＋１/＋１カウンターを２個置くか、無色の１/１の霊気装置・アーティファクト・クリーチャー・トークンを２体生成する。）\', \'type\': \'クリーチャー — 霊基体・工匠\', \'flavor\': \'「いや、私だってアレが正式に許可されているとは思えませんが、でもそれを問いただす役割はご免ですよ。」 ――領事府の警備員、カル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419262&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5c4ba07-235a-4cfa-9c87-e682ce4cbd73\', \'multiverseId\': 419262}, \'multiverseid\': 419262}, {\'name\': \'무기제작술 맹신자\', \'text\': \'제작 2 (이 생물이 전장에 들어올 때, 이 생물에 +1/+1 카운터 두 개를 올려놓거나 1/1 무색 서보 마법물체 생물 토큰 두 개를 만든다.)\', \'type\': \'생물 — 에테르붙이 기능공\', \'flavor\': \'"아니요, 전 그들이 이 무기들에 대해 적법한 허가를 받았다고 믿지 않습니다. 하지만 제가 그걸 물어보지는 않을 겁니다." —영사관 관리인 카루\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419526&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'03f24799-f11d-404b-a160-c685da4ddd81\', \'multiverseId\': 419526}, \'multiverseid\': 419526}, {\'name\': \'Entusiasta de Armifício\', \'text\': \'Fabricar 2 (Quando esta criatura entrar no campo de batalha, coloque dois marcadores +1/+1 nela ou crie duas fichas de criatura artefato incolor 1/1 do tipo Servus.)\', \'type\': \'Criatura — Etergênito Artesão\', \'flavor\': \'"Não, não acredito que eles tenham as autorizações adequadas para isso, mas não serei eu a perguntar." — Caru, guardião do Consulado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=419790&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fabb20df-f491-40b8-aef0-034223d5b071\', \'multiverseId\': 419790}, \'multiverseid\': 419790}, {\'name\': \'Оружейник-Энтузиаст\', \'text\': \'Производство 2 (Когда это существо выходит на поле битвы, положите на него два жетона +1/+1 или создайте две фишки артефакта существа 1/1 бесцветный Сервотрон.)\', \'type\': \'Существо — Эфирид Механик\', \'flavor\': \'«Нет, я не думаю, что у них есть на это разрешение, но узнавать не собираюсь». — Кару, стражник Консульства\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420054&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1638d575-f465-4927-a24d-cc115cfdacaa\', \'multiverseId\': 420054}, \'multiverseid\': 420054}, {\'name\': \'狂热造兵匠\', \'text\': \'装配2（当此生物进战场时，在其上放置两个+1/+1指示物或派出两个1/1无色自动机衍生神器生物。）\', \'type\': \'生物～乙太种／神器师\', \'flavor\': \'「不，我不相信他们会有制造那种东西的许可证，但我可不想去问。」 ～执政院护卫切鲁\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=417942&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4ed50977-217f-4d51-a781-0bf6096c873a\', \'multiverseId\': 417942}, \'multiverseid\': 417942}, {\'name\': \'狂熱造兵匠\', \'text\': \'裝配2（當此生物進戰場時，在其上放置兩個+1/+1指示物或派出兩個1/1無色自動機衍生神器生物。）\', \'type\': \'生物～乙太種／神器師\', \'flavor\': \'「不，我不相信他們會有製造那種東西的許可證，但我可不想去問。」 ～執政院護衛切魯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418206&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'aaaec441-e752-4f1a-b80c-fb5897a6b359\', \'multiverseId\': 418206}, \'multiverseid\': 418206}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=418627&type=card', 'language': 'German', 'identifiers': {'scryfallId': '08ce7ddf-3603-43b6-b531-2820edff2783', 'multiverseId': 418627}, 'multiverseid': 418627}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=420475&type=ca