: None, 'language': 'Spanish', 'identifiers': {'scryfallId': '9a9e2376-cffd-4dad-b110-f9451d721900'}, 'multiverseid': None}, {'name': 'Goule des tumulus', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '65c8ebca-6845-4cf5-98f2-8f624640f16d'}, 'multiverseid': None}, {'name': 'Ghoul dei Sepolcri', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '3613b043-61c8-4420-9287-52f0626fc2fc'}, 'multiverseid': None}, {'name': '墳墓の食屍鬼', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '7a440aed-5af4-493e-af9a-91441f54d9bc'}, 'multiverseid': None}, {'name': 'Carniçal do Túmulo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a48b2f65-acec-4134-93fd-f5d99659eccd'}, 'multiverseid': None}]", "[{'name': 'Inneres Heiligtum', 'text': 'Kumulative Versorgung -2 Lebenspunkte\\nJeglicher Schaden, der Kreaturen, die Du kontrollierst, zugefügt wird, wird auf 0 reduziert.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'fbd210ff-d34d-47f4-9e0a-312b1be87ddd'}, 'multiverseid': None}, {'name': 'Santuario interior', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3b749517-a6d2-4eb7-9851-5bf5159d0eb8'}, 'multiverseid': None}, {'name': 'Saint des saints', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b3ef13fc-0cdd-465d-b8ac-ed15d5bace94'}, 'multiverseid': None}, {'name': 'Santuario Interiore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '76f2017e-90ef-4a5a-8bb1-6915db406380'}, 'multiverseid': None}, {'name': '至上の聖域', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '7efabff5-73a7-43fa-8fb1-d33b77dc7508'}, 'multiverseid': None}, {'name': 'Santuário Secreto', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd896c115-ae5b-4fb0-b4f3-3416485eb090'}, 'multiverseid': None}]", '[{\'name\': \'Jabaris Banner\', \'text\': \'1, {T}: Eine Kreatur Deiner Wahl erhält Flankenangriff bis zum Ende des Zuges.\', \'type\': \'Artefakt\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'803790e6-198a-402a-b851-42388e4f0cc9\'}, \'multiverseid\': None}, {\'name\': \'Estandarte de Jabari\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'544feb9a-430f-4301-85b3-82d74245c72c\'}, \'multiverseid\': None}, {\'name\': \'Bannière de Djabari\', \'flavor\': "« J\'ai changé le *Brise légère* en *Aquilon*, mais je n\'ai pas changé d\'allégeance. »\\n—Gerrard, de l\'Aquilon.", \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aa845ab5-4421-47ae-8a3f-a4cf169fddd5\'}, \'multiverseid\': None}, {\'name\': \'Stendardo di Jabari\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af9fbcf7-c159-427d-97a0-c49588c94743\'}, \'multiverseid\': None}, {\'name\': \'ジャバーリーの旗印\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10cc0dbe-21ad-4086-a324-aa00a726aee9\'}, \'multiverseid\': None}, {\'name\': \'Estandarte de Jabari\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30312f01-aebd-4a30-91fc-977f75088ac3\'}, \'multiverseid\': None}]', "[{'name': 'Junger Dschinn', 'text': 'Fliegend\\nDer Junge Dschinn fügt Dir während Deiner Versorgungsphase 1 Schadenspunkt zu.', 'type': 'Beschwörung eines Dschinns', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '08e691a2-1724-4e0c-9751-65dade5c38e8'}, 'multiverseid': None}, {'name': 'Retoño de djinn', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a225bb27-ae6b-43f7-b3a5-5b61755ee201'}, 'multiverseid': None}, {'name': 'Djinn juvénile', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '4548622a-a4d9-447e-9363-26efe398ff17'}, 'multiverseid': None}, {'name': 'Genio Inesperto', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '02ece22c-a962-496c-bc39-8c7258bd0ef9'}, 'multiverseid': None}, {'name': '青二才のジン', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '69b16fc4-6a0e-4683-89f1-5e6f53a09d0e'}, 'multiverseid': None}, {'name': 'Gênio Inexperiente', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a4775dac-0d64-4ae5-8537-80b79ffe3fa4'}, 'multiverseid': None}]", "[{'name': 'Kenntnis der Ahnen', 'text': 'Kumulative Versorgung -1\\nWenn die Kenntnis der Ahnen ins Spiel kommt, schaue Dir die obersten zehn Karten Deiner Bibliothek an und entferne eine beliebige Anzahl davon ganz aus dem Spiel. Lege die übrigen Karten in beliebiger Reihenfolge oben auf Deine Bibliothek.\\nMische Deine Bibliothek neu, wenn die Kenntnis der Ahnen das Spiel verlässt.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0d6d59f4-7a37-4baf-a2ec-641ef3442eae'}, 'multiverseid': None}, {'name': 'Conocimiento ancestral', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '86e7c6a1-a79c-4eb9-9903-218e6aca1a76'}, 'multiverseid': None}, {'name': 'Connaissance ancestrale', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'cf1d7eea-47b5-4a9f-82ef-c3894d0ab565'}, 'multiverseid': None}, {'name': 'Conoscenza Ancestrale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'ff6e0b15-b4ff-402d-a159-4be2fd5c2772'}, 'multiverseid': None}, {'name': '祖先の知識', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'df54fba4-a21b-4145-897d-8ac2eda255f8'}, 'multiverseid': None}, {'name': 'Conhecimento Ancestral', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '582756dd-f7e3-4b2c-b171-bab78595a0d7'}, 'multiverseid': None}]", "[{'name': 'Kithkinpanzer', 'text': 'Die verzauberte Kreatur kann nicht von Kreaturen mit einer Stärke größer oder gleich 3 geblockt werden.\\nOpfere den Kithkinpanzer: Verhindere allen Schaden, der der verzauberten Kreatur aus einer Quelle zugefügt wird.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0a999a78-57ec-41a9-874b-caae5bd2d181'}, 'multiverseid': None}, {'name': 'Armadura kithkin', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4aa39cf4-264c-410f-9316-a97f3ac2b210'}, 'multiverseid': None}, {'name': 'Armure sangamie', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '286d6710-f602-4aa4-80cf-0c503bd7f0c8'}, 'multiverseid': None}, {'name': 'Corazza di Kithkin', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2dd991d7-4bc1-4c7e-bc30-30bb8d6f627e'}, 'multiverseid': None}, {'name': 'キスキンの鎧', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '61aab4c1-5467-4ce9-83d3-f229b5b558b9'}, 'multiverseid': None}, {'name': 'Armadura Kithkin', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c10eb430-d509-4c34-a999-9dcf79bed711'}, 'multiverseid': None}]", "[{'name': 'Knarrende Laufmaschine', 'text': 'Wenn die Knarrende Laufmaschine angreift, enttappe alle Kreaturen, die der verteidigende Spieler kontrolliert.', 'type': 'Artefaktkreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '6bb594e2-8968-4db2-aed3-c1c9995311be'}, 'multiverseid': None}, {'name': 'Autómata chirriante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'aa10c04b-92df-4f5f-bc9a-a574f63194e4'}, 'multiverseid': None}, {'name': 'Automate cliquetant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '34d166e7-27f5-4713-8d96-410459c3e853'}, 'multiverseid': None}, {'name': 'Automa Sgangherato', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1a382dbd-a1d9-45c5-9403-8b902ef2edf4'}, 'multiverseid': None}, {'name': 'ガチャガチャ自動人形', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4ddb7490-6dbb-4b3b-b6d1-178c965687a6'}, 'multiverseid': None}, {'name': 'Autômato Desajeitado', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ad1b8eac-1faa-4c55-8de1-f191a80ed7e8'}, 'multiverseid': None}]", '[{\'name\': \'Knochentänzer\', \'text\': \'0: Bringe die oberste Kreaturenkarte aus dem Friedhof des verteidigenden Spielers direkt unter Deiner Kontrolle ins Spiel. Der Knochentänzer fügt in diesem Zug keinen Kampfschaden zu. Benutze diese Fähigkeit nur, wenn der Knochentänzer angreift und nicht geblockt wird, und nur einmal pro Zug.\', \'type\': \'Beschwörung eines Zombies\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de45dd6d-aa9d-4626-b893-032b2184ec5f\'}, \'multiverseid\': None}, {\'name\': \'Danzarín de hueso\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2469a376-5d5e-4025-ac59-62fbc831f029\'}, \'multiverseid\': None}, {\'name\': \'Ostéodanseur\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2cab002c-4468-4271-ae9d-df0174f012c6\'}, \'multiverseid\': None}, {\'name\': "Danzatore d\'Ossa", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9746ca74-8beb-426e-830c-58e7fc6e2a76\'}, \'multiverseid\': None}, {\'name\': \'骨の踊り手\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'613db532-2c33-4f81-a946-519d50e27a97\'}, \'multiverseid\': None}, {\'name\': \'Dançarino de Ossos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'adbb1f6b-e077-4a2b-9cdc-a79e43407667\'}, \'multiverseid\': None}]', "[{'name': 'Kreisende Geier', 'text': 'Fliegend\\nEntferne während Deiner Versorgungsphase die oberste Kreaturenkarte Deines Friedhofs ganz aus dem Spiel oder begrabe die Kreisenden Geier.\\nWenn die Kreisenden Geier auf Deiner Hand sind, kannst Du sie abwerfen. Spiele diese Fähigkeit wie einen Spontanzauber.', 'type': 'Beschwörung von Vögeln', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8f989a7d-24da-488c-b746-4d3dca1f0a28'}, 'multiverseid': None}, {'name': 'Buitres al acecho', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '622d8727-36df-4df5-99fd-cd292da4f188'}, 'multiverseid': None}, {'name': 'Vautours tournoyants', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '69e1f469-98d2-471f-ad07-47bbec376816'}, 'multiverseid': None}, {'name': 'Avvoltoi Volteggianti', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd312a17c-4b02-4119-933e-e8c002f7e61f'}, 'multiverseid': None}, {'name': '待ち受ける禿鷹', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '13b80a5c-6385-411a-bb3d-76427c80c8f7'}, 'multiverseid': None}, {'name': 'Abutres Circulantes', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3e20c262-f83d-44ec-9e81-9ce211871a6c'}, 'multiverseid': None}]", "[{'name': 'Lavahunde', 'text': 'Für die Lavahunde gilt die Einsatzverzögerung nicht.\\nWenn die Lavahunde ins Spiel kommen, fügen sie Dir 4 Schadenspunkte zu.', 'type': 'Beschwörung von Hunden', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'bc2e7e92-ea2e-4b54-bafd-eb7788117d12'}, 'multiverseid': None}, {'name': 'Sabuesos de lava', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '728163e7-0e4c-43e7-8ea6-44339bb36f99'}, 'multiverseid': None}, {'name': 'Chiens de lave', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3b1c82be-40b9-41f2-8b96-d0152f858669'}, 'multiverseid': None}, {'name': 'Segugi di Lava', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'fef42459-199b-4c29-8b15-07f5633f54b2'}, 'multiverseid': None}, {'name': '溶岩の猟犬', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5ec54a99-7a53-442e-a6c9-26d0c70c3a09'}, 'multiverseid': None}, {'name': 'Sabujos de Lava', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '721c0c56-72ff-4347-91ed-6fb60b7b3dd4'}, 'multiverseid': None}]", "[{'name': 'Lavasturm', 'text': 'Der Lavasturm fügt jeder angreifenden Kreatur 2 Schadenspunkte oder jeder blockenden Kreatur 2 Schadenspunkte zu.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1030cca3-6428-4c5a-a45d-f135179b5331'}, 'multiverseid': None}, {'name': 'Tormenta de lava', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4c13e49f-76a9-467c-984d-0d8847d16a93'}, 'multiverseid': None}, {'name': 'Tempête de lave', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6e990757-742c-41b5-9e2d-a0e68ae7f6f8'}, 'multiverseid': None}, {'name': 'Tempesta di Lava', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '914dff6a-2940-4c6a-963c-35920217706e'}, 'multiverseid': None}, {'name': '溶岩の嵐', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2945944a-53e0-4aa7-8e8a-40354eb44c22'}, 'multiverseid': None}, {'name': 'Tempestade de Lava', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c62214d4-3da1-4c3b-80a1-29744c8414ad'}, 'multiverseid': None}]", "[{'name': 'Lebendig begraben', 'text': 'Durchsuche Deine Bibliothek nach bis zu drei Kreaturenkarten und lege sie auf Deinen Friedhof. Mische Deine Bibliothek danach neu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c180f42a-ff7b-4fda-8369-9c0382298fc5'}, 'multiverseid': None}, {'name': 'Entierro en vida', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '21cc8c62-a921-4c46-ae23-173f06836625'}, 'multiverseid': None}, {'name': 'Enterré vivant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '23ae486a-dac4-4e07-910c-3c39aaaf6489'}, 'multiverseid': None}, {'name': 'Sepolto Vivo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'fb3bdbfd-e195-4ebd-80c5-32f720e7ac85'}, 'multiverseid': None}, {'name': '生き埋め', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'db4e734e-cc25-4392-9952-33478bf9fef6'}, 'multiverseid': None}, {'name': 'Enterrado Vivo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a7c5c192-f2ba-4a46-8a37-405f3ba0fee5'}, 'multiverseid': None}]", "[{'name': 'Leichenfleddernde Zombies', 'text': 'Entferne die oberste Kreaturenkarte aus Deinem Friedhof ganz aus dem Spiel: Regeneration', 'type': 'Beschwörung von Zombies', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e11d6199-aed8-44b2-8d08-39a172ca6b32'}, 'multiverseid': None}, {'name': 'Zombis saqueadores', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '300987f9-c566-4e1c-9b12-446fce7c6d2a'}, 'multiverseid': None}, {'name': 'Zombies nécrophages', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c7509003-5fff-402c-9026-85e70a1c6ba3'}, 'multiverseid': None}, {'name': 'Zombi Mangiacarogne', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b5aee40e-1dbd-4da6-90a8-0cc288f66133'}, 'multiverseid': None}, {'name': '腐肉あさりのゾンビ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ce713f22-88b4-4448-bee7-fd712f4d408d'}, 'multiverseid': None}, {'name': 'Zumbis Escamotadores', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f9ef6aa4-14ae-49aa-a3db-3349eb26734c'}, 'multiverseid': None}]", "[{'name': 'Llanowar-Behemoth', 'text': 'Tappe eine Kreatur, die Du kontrollierst: +1/+1 bis zum Ende des Zuges.', 'type': 'Beschwörung eines Behemoth', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c577ddea-1f51-4c1a-84d9-d000426d5024'}, 'multiverseid': None}, {'name': 'Behemot de Llanowar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c3812e31-1da2-444d-b122-6f20400def0e'}, 'multiverseid': None}, {'name': 'Béhémoth de Llanowar', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bdb0fa64-a745-4130-a36d-b8d6f63f0e56'}, 'multivers