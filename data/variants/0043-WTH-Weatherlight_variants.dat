': 'Spanish', 'identifiers': {'scryfallId': 'd801e2a9-2ac1-43dc-9cca-907cde0c30dc'}, 'multiverseid': None}, {'name': 'Rapt', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd7e82318-4c51-4eeb-818a-1b3980fc275e'}, 'multiverseid': None}, {'name': 'Rapimento', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f4959ccd-f4d7-410d-951b-5d4bc3f1705a'}, 'multiverseid': None}, {'name': '誘拐', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '59dcf8c5-f00f-4626-9ddb-b91bf4c2fdb7'}, 'multiverseid': None}, {'name': 'Abdução', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1cb4815c-2f86-4d42-acd5-d1002c4c177d'}, 'multiverseid': None}]", "[{'name': 'Erfahrener Erforscher', 'text': 'Wenn der Erfahrene Erforscher aus dem Spiel auf dem Friedhof landet, kann jeder Spieler seine Bibliothek nach bis zu zwei Standardlandkarten durchsuchen und diese Länder direkt ins Spiel bringen. Jeder Spieler mischt danach seine Bibliothek.', 'type': 'Beschwörung eines Soldaten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2fbf9763-6c2b-425a-bf59-b54fa2ca397e'}, 'multiverseid': None}, {'name': 'Explorador veterano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a7b6466f-c345-43d2-b21d-e6f4f6215fd4'}, 'multiverseid': None}, {'name': 'Explorateur émérite', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3da7cf4d-3470-47df-ad7a-7c0fe5623c96'}, 'multiverseid': None}, {'name': 'Esploratore Veterano', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a5007e7a-45fd-49e0-8d14-7c51d4dcb3a9'}, 'multiverseid': None}, {'name': '老練の探険者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '06da63bb-51cd-44f7-926c-417eb3955b19'}, 'multiverseid': None}, {'name': 'Explorador Veterano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e7bdf016-fc8a-42a0-a95c-c49db2667e78'}, 'multiverse