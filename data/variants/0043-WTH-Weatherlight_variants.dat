, 'identifiers': {'scryfallId': '76e77798-e3d1-4b6c-9ac8-993891d04d63'}, 'multiverseid': None}, {'name': 'Fiancé du feu', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'afe86f0d-6071-4cf1-99ca-8eb3b2d3201d'}, 'multiverseid': None}, {'name': 'Promesso Sposo del Fuoco', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '9a2e89e3-e7b8-4b39-b615-9617bef04143'}, 'multiverseid': None}, {'name': '炎の刻印', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3593c8e9-c07d-4534-8dc2-dbf4214f1151'}, 'multiverseid': None}, {'name': 'Prometido do Fogo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ba4f11e2-e470-4b76-8df8-9c3f00cf544b'}, 'multiverseid': None}]", "[{'name': 'Verzweifelter Schachzug', 'text': 'Wirf eine Münze. Während die Münze in der Luft ist, entscheidet sich ein Gegner Deiner Wahl für Kopf oder Zahl. Gewinnst Du, verdopple allen Schaden, aus einer Quelle, die Du kontrollierst. Ansonsten verhindere allen Schaden aus dieser Quelle.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5fbe6713-37d2-4a99-aa09-6a86c71be924'}, 'multiverseid': None}, {'name': 'Gambito desesperado', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'da6f1934-5fa9-4a0c-83f1-84cb0943bc88'}, 'multiverseid': None}, {'name': 'Gambit désespéré', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '51d2c7af-e3c2-4537-a31f-cd3b26dc770c'}, 'multiverseid': None}, {'name': 'Mossa Disperata', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '276eabf2-fae6-4f42-9a70-5ebd33a8c40b'}, 'multiverseid': None}, {'name': '一か八か', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8143ba57-0b0f-4d9f-bc05-4e59ece2051d'}, 'multiverseid': None}, {'name': 'Lance Desesperado', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '05b041ee-8f5d-4cc9-9da5-836996e73975'}, 'multiverseid': None}]", "[{'name': 'Vodalischer Illusionist', 'text': '{U}{U}, {T}: Eine Kreatur Deiner Wahl destabilisiert sich.', 'type': 'Beschwörung von Meervolk', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7a9b0f5b-a437-4088-9851-f0a20c8d0467'}, 'multiverseid': None}, {'name': 'Ilusionista vodaliano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7452d898-0664-43cb-b911-38f547953930'}, 'multiverseid': None}, {'name': 'Illusionniste vodalian', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '89b65bef-99bd-46d3-b1ec-61008faf2be5'}, 'multiverseid': None}, {'name': 'Illusionista di Vodalia', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7df7ab4b-7f83-428c-be09-b2c96f650c21'}, 'multiverseid': None}, {'name': 'ヴォーデイリアの幻術師', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'cab70d19-3d68-471a-8c18-7fa6f554ff6c'}, 'multiverseid': None}, {'name': 'Ilusionista Vodaliano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8e10f1db-d464-4cc4-8086-5c0825189c62'}, 'multiverseid': None}]", "[{'name': 'Weise Eule', 'text': 'Fliegend\\nWenn die Weise Eule ins Spiel kommt, schaue Dir die obersten vier Karten Deiner Bibliothek an und lege sie in beliebiger Reihenfolge zurück.', 'type': 'Beschwörung eines Vogels', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '786c811f-38f7-42c1-87b4-d036a38dc465'}, 'multiverseid': None}, {'name': 'Búho sabio', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1c1f3ee5-73a4-47ef-a8cd-840e713b8fbb'}, 'multiverseid': None}, {'name': 'Hibou savant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'de8619c8-1b89-42f2-ab26-fdd5147461ca'}, 'multiverseid': None}, {'name': 'Gufo Sapiente', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c172ba09-edd7-4e0d-a005-31f632998fcf'}, 'multiverseid': None}, {'name': '物知りフクロウ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5f51e1e7-2985-4cc3-a094-659661579ec0'}, 'multiverseid': None}, {'name': 'Coruja Sábia', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0663bb66-0ed0-4807-a28c-2b77424f0028'}, 'multiverseid': None}]", "[{'name': 'Welle des Schreckens', 'text': 'Kumulative Versorgung -1\\nBegrabe am Ende Deiner Versorgungsphase alle Kreaturen, deren Gesamtspruchkosten gleich der Höhe der für die Welle des Schreckens zuletzt bezahlten kumulativen Versorgung sind.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1d694d70-fa76-4aba-ad51-367eea9be80d'}, 'multiverseid': None}, {'name': 'Ola de terror', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c12e972c-d855-4c07-ab45-bc642272ac0b'}, 'multiverseid': None}, {'name': 'Vague de terreur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '69abd186-2ca3-4037-b255-1748a212d165'}, 'multiverseid': None}, {'name': 'Ondata di Terrore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f1a2ac34-dce5-403a-a2ea-c74fa95ed3b2'}, 'multiverseid': None}, {'name': '恐怖の波', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3a093f03-9683-4798-b6d8-b10408a6308f'}, 'multiverseid': None}, {'name': 'Onda de Terror', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '79000e84-60dd-4ebe-bcbe-b54575cbbc5d'}, 'multiverseid': None}]", "[{'name': 'Wiedererwachen der Natur', 'text': 'Jeder Spieler zieht Karten in Höhe der Anzahl an Kreaturenkarten auf seinem Friedhof.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '4969f96e-cfab-46ae-a95e-d892fabe6dbe'}, 'multiverseid': None}, {'name': 'Resurgir de la naturaleza', 'text': 'Cada jugador roba un número de cartas igual al número de cartas de criatura que hay en su cementerio.', 'type': 'Conjuro', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3cdeabe7-a110-4fed-b5c0-fb89dd3649f7'}, 'multiverseid': None}, {'name': 'Renouveau de la nature', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '9f86da86-7528-408a-9977-9a0b9ee9e7a4'}, 'multiverseid': None}, {'name': 'Rinascita della Natura', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd99f23c4-3b09-48c5-9471-01bc16040e35'}, 'multiverseid': None}, {'name': '自然の復活', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '57b69554-778d-4f7c-9f6d-f0c86d908414'}, 'multiverseid': None}, {'name': 'Ressurgência da Natureza', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7cac471d-93ed-41cf-8848-9caf9f777450'}, 'multiverseid': None}]", "[{'name': 'Wirbelnde Dunkelheit', 'text': 'Du kannst die obersten drei schwarzen Karten Deines Friedhofs ganz aus dem Spiel entfernen, anstatt die Spruchkosten der Wirbelnden Dunkelheit zu bezahlen.\\nDie Wirbelnde Dunkelheit fügt einer nichtschwarzen Kreatur Deiner Wahl 3 Schadenspunkte zu, und Du erhältst 3 Lebenspunkte dazu.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '08800516-e01a-4a91-a2f2-bcc233b1e262'}, 'multiverseid': None}, {'name': 'Vorágine de oscuridad', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e5958e0c-eef0-4164-968a-d23e52dacfcc'}, 'multiverseid': None}, {'name': 'Obscurité tourbillonnante', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '78e9828a-1990-4bd3-b1d5-2500cce0e9ef'}, 'multiverseid': None}, {'name': 'Vortice di Tenebre', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '9bdb1de7-23e5-43e9-90b4-8a1f38cb9773'}, 'multiverseid': None}, {'name': '闇の旋動', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'dcfcf761-ea07-48ce-bff1-9688316c0371'}, 'multiverseid': None}, {'name': 'Escuridão Giratória', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f178e913-7113-4122-898b-265ffadf033d'}, 'multiverseid': None}]", "[{'name': 'Wissensbrunnen', 'text': 'Jeder Spieler kann während seiner Kartenziehphase 2 bezahlen, um eine Karte zu ziehen. Diese Fähigkeit kann beliebig oft benutzt werden.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c5f1650e-ec73-4c1e-aa08-e4c091ce8eda'}, 'multiverseid': None}, {'name': 'Pozo del conocimiento', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'cf36ac02-27ed-400d-b7ed-32bec09c29f5'}, 'multiverseid': None}, {'name': 'Puits de connaissance', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e7b0873f-a57b-4305-89c2-a6acc0cbaa9b'}, 'multiverseid': None}, {'name': 'Pozzo della Conoscenza', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b40be689-689f-48b8-a1d0-f2fef683e854'}, 'multiverseid': None}, {'name': '知識の井戸', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4e7c180c-2e28-404e-a11b-bc64263a3109'}, 'multiverseid': None}, {'name': 'Poço da Sabedoria', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '28503ab4-b5b7-4051-b8a8-b087685956b0'}, 'multiverseid': None}]", "[{'name': 'Wolkendschinn', 'text': 'Fliegend\\nDer Wolkendschinn kann nur fliegende Kreaturen blocken.', 'type': 'Beschwörung eines Dschinns', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1ef08776-b08b-40e2-9f62-4e0c6c04ca3b'}, 'multiverseid': None}, {'name': 'Djinn de las nubes', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'b32e4c26-f202-472a-bd52-426aba410682'}, 'multiverseid': None}, {'name': 'Djinn des nuages', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5101df67-05d3-489e-858c-7578ad0ac31f'}, 'multiverseid': None}, {'name': 'Genio delle Nubi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '53a68c84-d7f5-43be-9488-6fc4161bd597'}, 'multiverseid': None}, {'name': '雲のジン', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '190913e1-bb16-4a6d-aa65-48ea8527935c'}, 'multiverseid': None}, {'name': 'Gênio das Nuvens', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bccd951b-6c42-426d-b35f-c28e91bda867'}, 'multiverseid': None}]", '[{\'name\': \'Wutanfall\', \'text\': \'Eine Kreatur Deiner Wahl erhält +3/+3 und Erstschlag bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dabab55c-5382-41a6-b5ad-7c29392e9379\'}, \'multiverseid\': None}, {\'name\': \'Acceso de cólera\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'56bab38b-a1dc-4a6c-b78c-dfdf7f6c56b5\'}, \'multiverseid\': None}, {\'name\': \'Accès de rage\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f7d999a-1408-4e3a-919d-223a0464ff1c\'}, \'multiverseid\': None}, {\'name\': "Accesso d\'Ira", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'20c31de9-7f56-4cd9-a33b-7cf3298112a8\'}, \'multiverseid\': None}, {\'name\': \'激昂\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'df64af75-98fc-49d3-904b-3f84354e1829\'}, \'multiverseid\': None}, {\'name\': \'Acesso de Raiva\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'96f61e04-ae29-4db0-bd15-52efd1116a60\'}, \'multiverseid\': None}]', "[{'name': 'Würgeranken', 'text': 'Sprich diesen Zauberspruch nur, wenn Blocker deklariert wurden.\\nX angreifende Kreaturen Deiner Wahl werden als geblockt behandelt. Die Würgeranken fügen jeder dieser Kreaturen 1 Schadenspunkt zu.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '796da4a5-d8d2-4149-8282-21ef1e17311f'}, 'multiverseid': None}, {'name': 'Enredaderas asfixiantes', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0e14edf2-d1e2-4075-b79d-c1d0cfcda308'}, 'multiverseid': None}, {'name': 'Vignes étrangleuses', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '74ca2a2c-8aca-44e6-a55d-d5211b7a7903'}, 'multiverseid': None}, {'name': 'Liane Soffocanti', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0022a132-7607-418d-8d5a-59a99f57c98e'}, 'multiverseid': None}, {'name': '窒息ツタ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4a1eebd4-a5cd-45e7-9ec5-b7cad88b052d'}, 'multiverseid': None}, {'name': 'Trepadeiras Sufocantes', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '91e77d99-36ba-4d93-bb23-a88ca12cb8c4'}, 'multiverseid': None}]", "[{'name': 'Xanthische Statue', 'text': '{5}: Die Xanthische Staue ist bis zum Ende des Zuges eine trampelnde 8/8 Artefaktkreatur.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '030bea46-4182-4a20-b88c-8d36da233bdc'}, 'multiverseid': None}, {'name': 'Estatua xántica', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2e7cb824-9aef-4f5d-95f4-302ef02750c6'}, 'multiverseid': None}, {'name': 'Statue xanthique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '596492d2-23b3-4a0d-ad50-cd61f1555609'}, 'multiverseid': None}, {'name': 'Statua di Xanthic', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e9f7a789-4760-4399-842c-f66909c132f8'}, 'multiverseid': None}, {'name': '黄金像', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '424df5c6-34be-48b7-9ffa-2e701f954a94'}, 'multiverseid': None}, {'name': 'Estátua Xântica', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '73b680f9-6509-4cdd-9885-0babb8236ce4'}, 'multiverseid': None}]", "[{'name': 'Zauberbuch der Thran', 'text': '5, {T}: Zeige die obersten drei Karten Deiner Bibliothek einem Gegner Deiner Wahl. Begrabe eine dieser Karten, die dieser Gegner auswählt. Ziehe die übrigen Karten.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0329ede6-1c4c-49e0-9cb5-8d876df27ea6'}, 'multiverseid': None}, {'name': 'Volumen de Thran', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a90dee8b-7766-4c6f-87e3-3743973416ae'}, 'multiverseid': None}, {'name': 'Grimoire de Thran', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '1cc34df8-5c85-4977-9017-b3b50f0a0a79'}, 'multiverseid': None}, {'name': 'Tomo di Thran', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0493d776-1212-415a-8ca2-0214d3498374'}, 'multiverseid': None}, {'name': 'スランの秘本', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9c2561d7-3cdb-497e-981c-0e9dcad5ea5b'}, 'multiverseid': None}, {'name': 'Livro de Thran', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e262a214-b474-4394-91b1-3afee26b4707'}, 'multiverseid': None}]", "[{'name': 'Zoll', 'text': 'Jeder Spieler bestimmt eine der Kreaturen mit den höchsten Gesamtspruchkosten, die er kontrolliert, und bezahlt dann Mana in der Höhe der Gesamtspruchkosten dieser Kreatur oder begräbt die Kreatur.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7588fc3e-b28d-410d-a97f-e9da50d5c767'}, 'multiverseid': None}, {'name': 'Tasa', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '083d4ee6-6600-447e-8983-ae7be911890a'}, 'multiverseid': None}, {'name': 'Tarif', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '075faa0e-1c2e-446f-9db5-7d90fa2cf981'}, 'multiverseid': None}, {'name': 'Tariffa', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5de864e7-2974-4222-8eba-f5ec44c4dba4'}, 'multiverseid': None}, {'name': '関税', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '1b1614b6-91b6-46b2-bed2-63f892a5ebb1'}, 'multiverseid': None}, {'name': 'Tarifa', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6a1adb47-36cc-4e96-91a6-55eba23f2f6b'}, 'multiverseid': None}]", "[{'name': 'Zurückhaltung', 'text': 'Ein Spieler Deiner Wahl kann bis zum Ende des Zuges keine Spontanzauber, Unterbrechungszauber oder Hexereien sprechen bzw. Fähigkeiten benutzen, die Aktivierungskosten erfordern.\\nZiehe eine Karte.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd5b930ab-3ad3-4ecc-b990-bb838c523361'}, 'multiverseid': None}, {'name': 'Supresión', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '43d991a6-22b6-4bad-807f-0e735cfda67d'}, 'multiverseid': None}, {'name': 'Suspens', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '635d05bd-2067-462e-9e5f-86532d33fb9f'}, 'multiverseid': None}, {'name': 'Quiescenza', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f40bba17-9c71-4d6a-86cc-309426abf7a1'}, 'multiverseid': None}, {'name': '中断', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '09d69b12-79af-47e7-98bf-297a8dd7d4a4'}, 'multiverseid': None}, {'name': 'Latência', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '42df080d-cde2-4d6a-b828-2b2d8301aa65'}, 'multiverseid': None}]", "[{'name': 'Zwergenberserker', 'text': 'Wenn der Zwergenberserker geblockt wird, erhält er +3/+0 und verursacht Trampelschaden bis zum Ende des Zuges.', 'type': 'Beschwörung eines Zwergs', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8cdae89a-e75d-4806-b0ce-f48207ce3805'}, 'multiverseid': None}, {'name': 'Enano berserker', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3b28ca87-a15a-478f-bad3-b464f19f253a'}, 'multiverseid': None}, {'name': 'Berserker nain', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c64f4e28-8e3a-404a-9d83-dfa2b52d42ae'}, 'multiverseid': None}, {'name': 'Nano Berserker', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4685375f-3aca-4ed2-a809-f34f6ed4d84e'}, 'multiverseid': None}, {'name': 'ドワーフの狂戦士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5ebb3f64-6c67-4eee-b4b6-421e99fcac65'}, 'multiverseid': None}, {'name': 'Anão Furioso', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '18d0a3b0-5a5c-417e-ba03-5b2c7ff3261d'}, 'multiverseid': None}]", "[{'name': 'Zwergenthaumaturge', 'text': '{T}: Vertausche die Stärke und Widerstandskraft einer Kreatur Deiner Wahl bis zum Ende des Zuges. Effekte, die Stärke dieser Kreatur verändern, verändern stattdessen bis zum Ende des Zuges die Widerstandskraft und umgekehrt.', 'type': 'Beschwörung eines Zwerges', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '4a2ff7c9-a51e-4bd3-80ef-ae59bd9650b3'}, 'multiverseid': None}, {'name': 'Enano taumaturgo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c8a21935-1039-47c8-8b5d-7bcacae135cf'}, 'multiverseid': None}, {'name': 'Thaumaturge nain', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a9bfe015-ecdd-4cfb-93ef-f9bdf93a0ed4'}, 'multiverseid': None}, {'name': 'Nano Taumaturgo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b3299aac-119c-43d6-942b-a154cff96d26'}, 'multiverseid': None}, {'name': 'ドワーフの秘術師', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ad451b73-2b50-4e85-80f7-5c5350c45603'}, 'multiverseid': None}, {'name': 'Taumaturgo dos Anões', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8ff57453-bfd4-4903-a54b-c1832df6993b'}, 'multiverseid': None}]", "[{'name': 'Zyklop vom Blutfelsen', 'text': 'Der Zyklop vom Blutfelsen greift in jedem Zug an, wenn möglich.', 'type': 'Beschwörung eines Zyklopen', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1ed03505-324c-4f94-8502-a99ac6be3a05'}, 'multiverseid': None}, {'name': 'Cíclope de Rocasangrienta', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ce30086f-e820-47de-ae0c-9e9049d18552'}, 'multiverseid': None}, {'name': 'Cyclope de Rochesang', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '30e1ddea-90fa-417b-8fbf-d1ef4f7da602'}, 'multiverseid': None}, {'name': 'Ciclope della Roccia Insanguinata', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '73d95309-e863-4dd9-84ac-ad30e4867c13'}, 'multiverseid': None}, {'name': 'ブラッドロック・サイクロプス', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c55046e6-fd86-43ac-bf45-b834e2932b7a'}, 'multiverseid': None}, {'name': 'Cíclope de Jaspe', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '52536fe4-2177-4c0a-b2b2-914ee489f502'}, 'multiverseid': None}]", "[{'name': 'Ängstlicher Sceada', 'text': 'Fliegend\\nWenn eine andere Kreatur ins Spiel kommt, bringe den Ängstlichen Sceada auf die Hand seines Besitzers zurück.', 'type': 'Beschwörung eines Sceadas', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9c22eb3d-b1dc-407a-b925-9639205b752a'}, 'multiverseid': None}, {'name': 'Draco asustadizo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '071058e7-8f91-472f-99de-856825ef6168'}, 'multiverseid': None}, {'name': 'Drakôn fuyard', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'cb62734d-b1e5-4ab4-b1c8-0175b97b0238'}, 'multiverseid': None}, {'name': 'Draghetto Timido', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c0f6b4c7-9074-4095-aec6-df7fbb85b613'}, 'multiverseid': None}, {'name': '臆病ドレイク', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '08187a81-0930-46e4-b057-344175ad9e01'}, 'multiverseid': None}, {'name': 'Dragonete Tímido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3d6b8e83-e4e6-47c9-84d1-77f9411c5350'}, 'multiverseid': None}]", '[{\'name\': \'Ätherblitz\', \'text\': \'Immer wenn eine Kreatur ins Spiel kommt, fügt der Ätherblitz dieser Kreatur 2 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3dc259af-f61f-4e3d-b2fb-c0c5055fa0bc\'}, \'multiverseid\': None}, {\'name\': \'Destello del Éter\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fca45f64-ce27-4736-af6c-1a21bfd2fca5\'}, \'multiverseid\': None}, {\'name\': "Flash d\'Aether", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b9ef8d5-c2b8-4920-aa79-4eae83d612c3\'}, \'multiverseid\': None}, {\'name\': \'Fiammata Eterea\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0b1bf48d-91b2-4aab-980d-7c396dd19b25\'}, \'multiverseid\': None}, {\'name\': \'Æther Flash\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b0ede06d-b6cd-4f56-9709-15a204cc3ec8\'}, \'multiverseid\': None}, {\'name\': \'Clarão do Éter\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0274ebc-131b-4789-8b60-e285eb804947\'}, \'multiverseid\': None}]']
