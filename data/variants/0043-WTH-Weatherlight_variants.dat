 '34e027a2-1c8c-43be-9f2d-e80d79f7000c'}, 'multiverseid': None}, {'name': 'Portero abismal', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd88a0ace-2647-4b8c-9285-b54aaf8751e7'}, 'multiverseid': None}, {'name': 'Gardien de la porte des abysses', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8a909d62-161f-471b-9ad6-4d391cef4495'}, 'multiverseid': None}, {'name': 'Custode del Portale Abissale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '04cfdeab-fc6a-4ca4-967a-d7f885a46ddc'}, 'multiverseid': None}, {'name': '深淵の門番', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '1c7aa2a7-93fa-4edc-8c35-ba9fb7241a7e'}, 'multiverseid': None}, {'name': 'Porteiro Abissal', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '863d85b3-eabf-4be1-88b5-b680be062c24'}, 'multiverseid': None}]", '[{\'name\': \'Uktabi-Ifrit\', \'text\': \'Kumulative Versorgung- G\', \'type\': \'Beschwörung eines Ifrits\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89676217-6328-47e1-a6b8-76ec001df88a\'}, \'multiverseid\': None}, {\'name\': \'Efrit de Uktabi\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd31f08c-e578-4b95-88ff-5b954c139521\'}, \'multiverseid\': None}, {\'name\': "Efrit de l\'Ouktabi", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3435d604-3855-4754-af64-47f9100a3e4e\'}, \'multiverseid\': None}, {\'name\': \'Efreet di Uktabi\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a85057b4-3c9f-496b-b0bc-8f05e104ffa8\'}, \'multiverseid\': None}, {\'name\': \'ウークタビー・イフリート\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f166799-21b3-41a0-a954-13bc99a1ed0b\'}, \'multiverseid\': None}, {\'name\': \'Efrite de Uktabi\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ddc2e8ed-5a54-4b32-b20b-7e2ffd3929ec\'}, \'multiverseid\': None}]', "[{'name': 'Unheilbringender Poltergeist', 'text': 'Fliegend\\nZahle 1 Lebenspunkt: Regeneration', 'type': 'Beschwörung eines Geistwesens', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '026d47f4-e03e-4b78-9266-2bfc2001861a'}, 'multiverseid': None}, {'name': 'Poltergeist malicioso', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4df15cd9-2c0b-4bd1-84d3-30898a2d30e4'}, 'multiverseid': None}, {'name': 'Poltergeist malicieux', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3d7d7884-e91e-4d76-a2ee-eeb0b5eb3634'}, 'multiverseid': None}, {'name': 'Poltergeist Maligno', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '67e5ef36-fad7-4b1c-a1df-776daf92d407'}, 'multiverseid': None}, {'name': '悪戯なポルターガイスト', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '51c1700b-9065-4321-a7b0-d5392212f725'}, 'multiverseid': None}, {'name': 'Poltergeist Malicioso', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5e31bec2-bbbf-4e11-981d-89a436b95d0b'}, 'multiverseid': None}]", '[{\'name\': \'Urborg-Gerechtigkeit\', \'text\': \'Ein Gegner Deiner Wahl bestimmt und begräbt eine Anzahl an Kreaturen, die er kontrolliert, in der Höhe der Anzahl der Kreaturen, die in diesem Zug bisher auf Deinem Friedhof gelandet sind.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7881144a-cf84-4f85-9c74-287a48a856ac\'}, \'multiverseid\': None}, {\'name\': \'Justicia de Urborg\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fbea2d09-0a28-4ecb-bd1a-ebe419407102\'}, \'multiverseid\': None}, {\'name\': "Justice d\'Urborg", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'500332da-e9b5-4d56-a4fe-4fc995eb5e3c\'}, \'multiverseid\': None}, {\'name\': \'Giustizia di Urborg\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6fa85d7f-1563-4565-9fd0-6785698bfe62\'}, \'multiverseid\': None}, {\'name\': \'アーボーグの報復\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d60e2c60-486f-47a6-852c-550efc151fab\'}, \'multiverseid\': None}, {\'name\': \'Justiça de Urborg\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0bcdc87c-3a06-42aa-9233-c24d134a0fc8\'}, \'multiverseid\': None}]', '[{\'name\': \'Urborg-Wanderer\', \'text\': \'Wenn während der Versorgungsphase eines Spielers dieser nicht-schwarze bleibende Karten (außer Ländern) kontrolliert, fügt ihm der Urborg-Wanderer 1 Schadenspunkt zu.\', \'type\': \'Beschwörung eines Wiedergängers\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5ee1ace-a308-46fd-94f7-077b75bcf732\'}, \'multiverseid\': None}, {\'name\': \'Rondador de Urborg\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af62cb5a-3807-4536-b160-938a13480bd0\'}, \'multiverseid\': None}, {\'name\': "Pisteur d\'Urborg", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ea5e9cf-35d8-4b7d-ad07-1d5bea8422f9\'}, \'multiverseid\': None}, {\'name\': \'Cacciatore di Urborg\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a606ada2-6c51-45c5-804c-e6c355bc719d\'}, \'multiverseid\': None}, {\'name\': \'アーボーグ・ストーカー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e519dff-e458-4d5b-b80b-a8322a0a9ec0\'}, \'multiverseid\': None}, {\'name\': \'Rastejador de Urborg\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bebe2433-f064-4b1d-8e21-3dbf89f6f900\'}, \'multiverseid\': None}]', "[{'name': 'Vasall des Baumvolks', 'text': 'Wenn der Vasall des Baumvolks aus dem Spiel auf dem Friedhof landet, kann jeder Spieler eine beliebige Anzahl an Mana bezahlen, um eine gleiche Anzahl an Eichhörnchen-Spielsteinen unter seiner Kontrolle ins Spiel zu bringen. Behandle diese Spielsteine wie 1/1 grüne Kreaturen.', 'type': 'Beschwörung eines Geistes', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'f51b58cb-7111-49d1-9087-d5bbd6d145a4'}, 'multiverseid': None}, {'name': 'Siervo de las hoquedades', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'afa6ceab-ae78-417d-b7f1-b3f9a2955333'}, 'multiverseid': None}, {'name': 'Féal des arbres creux', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '4e7f6caf-0243-4985-aa9e-6ef21aa4985f'}, 'multiverseid': None}, {'name': 'Vassallo delle Valli Boscose', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0e68f2e4-8669-4310-ae11-d0d4ba548db4'}, 'multiverseid': None}, {'name': 'うろの下僕', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '38dc25be-09f5-4da4-9b41-82910f324d58'}, 'multiverseid': None}, {'name': 'Regente das Tocas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3c9ab40f-f76a-4681-aaf3-eb9e4703e6a4'}, 'multiverseid': None}]", "[{'name': 'Verborgener Schrecken', 'text': 'Bestimme eine Kreaturenkarte aus Deiner Hand und wirf diese ab, wenn der Verborgene Schrecken ins Spiel kommt, oder begrabe den Verborgenen Schrecken.', 'type': 'Beschwörung eines Wiedergängers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'bf35edfb-e6ed-4320-b93c-aecb39b57eae'}, 'multiverseid': None}, {'name': 'Horror oculto', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '06ad8f5d-e575-4ffb-a010-a8a851f7a689'}, 'multiverseid': None}, {'name': 'Horreur cachée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'eaa93af7-dc9e-4d6e-8792-79553a190e3f'}, 'multiverseid': None}, {'name': 'Orrore Nascosto', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '78b73059-0ced-4282-9d0a-5b38186daae4'}, 'mul