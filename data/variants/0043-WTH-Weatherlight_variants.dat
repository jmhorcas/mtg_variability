tuguese (Brazil)', 'identifiers': {'scryfallId': 'ca075f61-3ec0-417d-93eb-134824356d2c'}, 'multiverseid': None}]", "[{'name': 'Teferis Schleier', 'text': 'Immer wenn eine Deiner Kreaturen angreift, destabilisiert sie sich am Ende des Kampfes.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '294d540d-55f3-461f-9b25-16fb98feed68'}, 'multiverseid': None}, {'name': 'Velo de Teferi', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'eec10032-9aaf-4d47-8f3a-27de1a665326'}, 'multiverseid': None}, {'name': 'Voile de Téfeiri', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '836d825a-5fc2-44d9-9d36-e989e9e715b0'}, 'multiverseid': None}, {'name': 'Velo di Teferi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6d9f0299-0a5a-4dfd-83ae-c03b254cbd75'}, 'multiverseid': None}, {'name': 'テフェリーのヴェール', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '97221f3a-df76-418c-9e0a-23f62be333f0'}, 'multiverseid': None}, {'name': 'Véu de Teferi', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c5a625a2-f4e9-471e-9e74-405fbbe273f1'}, 'multiverseid': None}]", "[{'name': 'Todesstoß', 'text': 'Begrabe eine Kreatur Deiner Wahl, der in diesem Zug Schaden zugefügt wurde.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0f9d13c6-044d-4515-9975-752cb99ece54'}, 'multiverseid': None}, {'name': 'Golpe de gracia', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6ae0cbe5-d8ee-4bbb-b729-5a3f686d85aa'}, 'multiverseid': None}, {'name': 'Coup fatal', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '87002a3a-7eb0-4ff6-84a1-3f30a231461e'}, 'multiverseid': None}, {'name': 'Colpo Fatale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e4809422-1394-4840-bcdb-c2beafc91e8f'}, 'multiverseid': None}, {'name': '命取り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '115defc6-32fa-42df-bb03-8d74c2fdde37'}, 'multiverseid': None}, {'name': 'Golpe Fatal', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd4181516-1d2a-4b1f-a02a-38705e06d97b'}, 'multiverseid': None}]", "[{'name': 'Tolarianische Schlange', 'text': 'Lege während Deiner Versorgungsphase die obersten sieben Karten Deiner Bibliothek auf Deinen Friedhof.', 'type': 'Beschwörung einer Schlange', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7c800a24-c94a-4eeb-94c7-020e6a6c0ee6'}, 'multiverseid': None}, {'name': 'Serpiente tolariana', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '38ab300d-206b-4c2e-bf4d-0d9c6a9555c5'}, 'multiverseid': None}, {'name': 'Serpent de mer de Tolaria', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd47b5dce-30bc-473e-a397-cfb48801a1b0'}, 'multiverseid': None}, {'name': 'Serpente di Tolaria', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1ef150c7-2850-45b8-9e8a-891450506c95'}, 'multiverseid': None}, {'name': 'トレイリアの大海蛇', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '78872c05-091c-468b-be76-99dea1ffcd80'}, 'multiverseid': None}, {'name': 'Serpente Tolariana', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '49360a41-aa6c-499a-b177-c7c9b10ce29a'}, 'multiverseid': None}]", "[{'name': 'Tolarianischer Hypnotiseur', 'text': 'Immer wenn der Tolarianische Hypnotiseur von einer Kreatur geblockt wird, übernimm am Ende des Kampfes die Kontrolle über diese Kreatur.', 'type': 'Beschwörung eines Zauberers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c2a8d67f-6c13-4829-b67d-aebdc510df3c'}, 'multiverseid': None}, {'name': 'Hipnotizador tolariano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '17b9bc51-07cc-47b4-af2c-b4dad550278d'}, 'multiverseid': None}, {'name': 'Enjôleur tolarian', 'flavor': No