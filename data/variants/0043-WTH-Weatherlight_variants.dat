: {'scryfallId': '408eae82-fb0c-4530-850a-7fac31d34d04'}, 'multiverseid': None}, {'name': '火炎放射', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2538e02c-5737-48fa-9241-b194da22d5d9'}, 'multiverseid': None}, {'name': 'Cone de Chamas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3f8b08c3-8a81-4dc1-80fa-94d03d587397'}, 'multiverseid': None}]", "[{'name': 'Fluktuation', 'text': 'Jeder Spieler wählt eine beliebige Anzahl an Karten aus seiner Hand und wirft diese ab. Danach zieht jeder Spieler genauso viele Karten.\\nZiehe eine Karte.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '43657fad-e5dc-4c7c-9065-d91aa28d14d4'}, 'multiverseid': None}, {'name': 'Flujo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f0d4284b-179a-4b1c-b2cb-a03c33eefdd8'}, 'multiverseid': None}, {'name': 'Flux', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6b2f7a1b-68d8-40d8-a7d8-45dad74c9163'}, 'multiverseid': None}, {'name': 'Flusso', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1ff75aa1-cb13-4253-baef-5160cf2f6bd2'}, 'multiverseid': None}, {'name': '有為転変', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ea550a68-7b9f-421f-9fd4-ae19ea4b5291'}, 'multiverseid': None}, {'name': 'Fluxo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a716453f-ee05-4444-907d-3719b64e1c92'}, 'multiverseid': None}]", "[{'name': 'Foriysische Brigade', 'text': 'Die Foriysische Brigade kann in jedem Kampf bis zu zwei Kreaturen blocken. Alle deklarierten Blocks müssen erlaubt sein.', 'type': 'Beschwörung von Soldaten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'dc7fbb9c-41f5-4bbe-86a8-6b5788b7b8ba'}, 'multiverseid': None}, {'name': 'Brigada foriysiana', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '18c1ce20-6d4b-4df4-9c62-abb6c800afc8'}, 'multi