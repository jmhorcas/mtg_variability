 'multiverseid': None}, {'name': 'Vorme Ceifeiro', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '284a6515-65da-40e7-ba06-a2314f905a2e'}, 'multiverseid': None}]", '[{\'name\': \'Ertais Vertrauter\', \'text\': \'Instabilität\\nWenn Ertais Vertrauter das Spiel verlässt, lege die obersten drei Karten Deiner Bibliothek auf Deinen Friedhof.\\n{U}: Ertais Vertrauter kann sich bis zu Beginn Deiner nächsten Versorgungsphase nicht destabilisieren.\', \'type\': \'Beschwörung einer Illusion\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed6cd79b-1798-49e0-96e6-a0292294733f\'}, \'multiverseid\': None}, {\'name\': \'Familiar de Ertai\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0545376a-62fd-448c-9c17-881f74f1b28c\'}, \'multiverseid\': None}, {\'name\': "Familier d\'Ertaï", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be7e8fe9-4259-42f8-866d-66ed7f7ec9a5\'}, \'multiverseid\': None}, {\'name\': \'Famiglio di Ertai\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'114f5839-0ce9-4896-9531-2fac9d833377\'}, \'multiverseid\': None}, {\'name\': \'アーテイの使い魔\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc363edf-9a68-450a-bb35-426427dd47ed\'}, \'multiverseid\': None}, {\'name\': \'Familiar de Ertai\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dbb768e0-3008-46ff-a2fb-2f06e86b13b9\'}, \'multiverseid\': None}]', "[{'name': 'Fallwind', 'text': '{G}: Eine Kreatur Deiner Wahl verliert ihre Flugfähigkeit bis zum Ende des Zuges.\\nOpfere den Fallwind: Der Fallwind fügt jeder fliegenden Kreatur 2 Schadenspunkte zu.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7f9c7d64-1380-4c77-b970-fd2b137c900d'}, 'multiverseid': None}, {'name': 'Corriente descendente', 'flavor': None, 'language': 'S