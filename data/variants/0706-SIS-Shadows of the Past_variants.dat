mana_cost: ['{1}', '{1}{B}', '{1}{B}{B}', '{1}{B}{R}', '{1}{G}', '{1}{R}', '{1}{R}{G}', '{1}{R}{R}', '{1}{U}', '{1}{U}{B}', '{1}{U}{U}', '{1}{W}', '{1}{W}{U}', '{1}{W}{W}', '{2}{B}', '{2}{B}{B}', '{2}{B}{R}', '{2}{G}', '{2}{G}{W}{W}', '{2}{R}', '{2}{R}{G}', '{2}{R}{R}', '{2}{U}', '{2}{U}{U}', '{2}{W}', '{2}{W}{W}', '{3}', '{3}{B}', '{3}{G}', '{3}{G}{G}', '{3}{R}', '{3}{U}', '{3}{U}{B}', '{3}{U}{U}', '{4}', '{4}{B}', '{4}{B}{B}{B}{B}', '{4}{G}', '{4}{R}', '{4}{U}', '{4}{W}', '{5}{R}{R}', '{5}{W}', '{5}{W}{W}{W}', '{B}', '{G}', '{R}', '{U}', '{W}', '{X}{R}']
