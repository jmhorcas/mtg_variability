type: ['Artifact', 'Artifact Creature — Juggernaut', 'Artifact — Equipment', 'Creature — Angel', 'Creature — Bird', 'Creature — Devil', 'Creature — Dragon', 'Creature — Elemental', 'Creature — Homunculus', 'Creature — Human Advisor Werewolf', 'Creature — Human Cleric', 'Creature — Human Druid', 'Creature — Human Monk', 'Creature — Human Rogue', 'Creature — Human Rogue Werewolf', 'Creature — Human Shaman', 'Creature — Human Soldier', 'Creature — Human Warrior', 'Creature — Human Werewolf', 'Creature — Human Wizard', 'Creature — Spirit', 'Creature — Spirit Soldier', 'Creature — Vampire', 'Creature — Vampire Noble', 'Creature — Vampire Soldier', 'Creature — Wolf', 'Creature — Zombie', 'Creature — Zombie Soldier', 'Creature — Zombie Wizard', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Legendary Creature — Angel', 'Legendary Creature — Demon', 'Legendary Creature — Spirit Cleric', 'Legendary Planeswalker — Garruk', 'Sorcery']
