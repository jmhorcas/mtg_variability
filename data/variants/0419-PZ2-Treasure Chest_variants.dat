subtypes: ['Advisor', 'Ally', 'Aminatou', 'Angel', 'Arcane', 'Archer', 'Artificer', 'Assassin', 'Aura', 'Avatar', 'Beast', 'Berserker', 'Bird', 'Cat', 'Centaur', 'Cleric', 'Construct', 'Crab', 'Curse', 'Daretti', 'Demon', 'Dinosaur', 'Dog', 'Dragon', 'Drake', 'Druid', 'Efreet', 'Elemental', 'Elf', 'Elk', 'Equipment', 'Estrid', 'Faerie', 'Fish', 'Forest', 'Fox', 'Giant', 'Goblin', 'Golem', 'Horror', 'Human', 'Hydra', 'Insect', 'Island', 'Kaya', 'Kirin', 'Knight', 'Kor', 'Kraken', 'Lizard', 'Merfolk', 'Minion', 'Minotaur', 'Monk', 'Mountain', 'Mutant', 'Naga', 'Ninja', 'Nymph', 'Ogre', 'Ooze', 'Ox', 'Pangolin', 'Pegasus', 'Phoenix', 'Phyrexian', 'Plains', 'Plant', 'Rat', 'Rhino', 'Rogue', 'Saheeli', 'Scorpion', 'Scout', 'Shaman', 'Shapeshifter', 'Snake', 'Soldier', 'Sphinx', 'Spider', 'Spirit', 'Turtle', 'Unicorn', 'Vampire', 'Vedalken', 'Wall', 'Warrior', 'Windgrace', 'Wizard', 'Yanggu', 'Yanling', 'Zombie']
