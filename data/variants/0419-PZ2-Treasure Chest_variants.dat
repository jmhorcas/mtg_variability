, 'Legendary Enchantment Creature — Nymph', 'Legendary Planeswalker — Aminatou', 'Legendary Planeswalker — Daretti', 'Legendary Planeswalker — Estrid', 'Legendary Planeswalker — Kaya', 'Legendary Planeswalker — Saheeli', 'Legendary Planeswalker — Windgrace', 'Legendary Planeswalker — Yanggu', 'Legendary Planeswalker — Yanling', 'Sorcery', 'Tribal Sorcery — Merfolk', 'World Enchantment']
