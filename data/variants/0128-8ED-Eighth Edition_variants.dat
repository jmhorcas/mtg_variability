andlers/Image.ashx?multiverseid=162951&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f3c560e3-18b8-4e23-a675-b28109728e63', 'multiverseId': 162951}, 'multiverseid': 162951}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165588&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0e7917e8-15ec-4041-83f5-1641b09777c3', 'multiverseId': 165588}, 'multiverseid': 165588}, {'name': 'Île', 'type': 'Terrain de base : Île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163308&type=card', 'language': 'French', 'identifiers': {'scryfallId': '630d4298-2eeb-4a00-96a3-4cfabd2c9bb5', 'multiverseId': 163308}, 'multiverseid': 163308}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165231&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '146608f5-e388-4885-b1e9-6e830ac333b6', 'multiverseId': 165231}, 'multiverseid': 165231}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd970e2a3-cc1f-47ca-8d55-0719558455a8'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165945&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b0d47cdd-ccc8-4b40-bc5f-633e112980e8', 'multiverseId': 165945}, 'multiverseid': 165945}]", '[{\'name\': \'Inspiration\', \'text\': \'Ein Spieler deiner Wahl zieht zwei Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Unterschied zwischen Wahnsinn und Genialität findet sich nur im Erfolg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162698&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6a08ccf-0c34-4bdb-9268-c0107e2551a8\', \'multiverseId\': 162698}, \'multiverseid\': 162698}, {\'name\': \'Inspiración\', \'text\': \'El jugador objetivo roba dos cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'La locura y la genialidad están separados sólo por grados de éxito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165335&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'185c9f96-d02a-4baf-9c64-53c9e807db0c\', \'multiverseId\': 165335}, \'multiverseid\': 165335}, {\'name\': \'Inspiration\', \'text\': \'Le joueur ciblé pioche deux cartes.\', \'type\': \'Éphémère\', \'flavor\': "La folie et le génie ne sont séparés l\'un de l\'autre que par l\'échec ou le succès.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163055&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8bdcc351-8b33-4eea-b972-d09bc624c70d\', \'multiverseId\': 163055}, \'multiverseid\': 163055}, {\'name\': \'Ispirazione\', \'text\': \'Il giocatore bersaglio pesca due carte.\', \'type\': \'Istantaneo\', \'flavor\': \'Follia e genio si distinguono solo in base al successo ottenuto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164978&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce5382bb-3331-4803-bc2f-8048b2c6b242\', \'multiverseId\': 164978}, \'multiverseid\': 164978}, {\'name\': \'霊感\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cea68b4b-29ff-4aaf-9a13-f36b33bcf136\'}, \'multiverseid\': None}, {\'name\': \'Inspiração\', \'text\': \'O jogador alvo compra dois cards.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A loucura e a genialidade são separadas apenas por seus graus de sucesso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165692&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88c3aba9-c3c9-41f8-b714-d051940cb55f\', \'multiverseId\': 165692}, \'multiverseid\': 165692}]', "[{'name': 'Kaiserkrokodil', 'text': 'Wenn du keine anderen Kreaturen kontrollierst, opfere das Kaiserkrokodil.', 'type': 'Kreatur — Krokodil', 'flavor': 'Der Fürst der Gewässer Yavimayas ist fast rührend um seine Untertanen besorgt und genießt ihre Verherrlichung sehr.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162859&type=card', 'language': 'German', 'identifiers': {'scryfallId': '382f9065-a771-46cf-b986-40cc60e0ff7a', 'multiverseId': 162859}, 'multiverseid': 162859}, {'name': 'Cocodrilo emperador', 'text': 'Cuando no controles ninguna otra criatura, sacrifica el Cocodrilo emperador.', 'type': 'Criatura — Cocodrilo', 'flavor': 'El rey de las aguas de Yavimaya presta constante atención a sus súbditos . . . y prospera con su adulación.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165496&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9f29f44f-27b2-44f2-91cd-742866ada6cd', 'multiverseId': 165496}, 'multiverseid': 165496}, {'name': 'Crocodile empereur', 'text': 'Quand vous ne contrôlez aucune autre créature, sacrifiez le Crocodile empereur.', 'type': 'Créature : crocodile', 'flavor': 'Le roi des eaux de la Yavimaya fait particulièrement attention à ses sujets . . . et se repaît de leur adoration.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163216&type=card', 'language': 'French', 'identifiers': {'scryfallId': '70d9c16c-47ca-42c1-8741-5cf56cb58175', 'multiverseId': 163216}, 'multiverseid': 163216}, {'name': 'Coccodrillo Imperatore', 'text': 'Quando non controlli altre creature, sacrifica il Coccodrillo Imperatore.', 'type': 'Creatura — Coccodrillo', 'flavor': 'Il re delle acque di Yavimaya presta sempre attenzione ai propri sudditi . . . e prospera grazie alla loro adulazione.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165139&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ab923bc1-d5a2-4f22-9744-9432b5e77fdb', 'multiverseId': 165139}, 'multiverseid': 165139}, {'name': '皇帝クロコダイル', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fc5ba87d-daa8-4e02-98b7-136c8e8818e9'}, 'multiverseid': None}, {'name': 'Crocodilo Imperador', 'text': 'Quando você não controlar outras criaturas, sacrifique Crocodilo Imperador.', 'type': 'Criatura — Crocodilo', 'flavor': 'O rei das águas de Yavimaya presta muita atenção a seus súditos . . . e alimenta-se de sua adulação.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165853&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e1d30ba1-9964-49c5-8ce1-22f02d70c8c3', 'multiverseId': 165853}, 'multiverseid': 165853}]", '[{\'name\': \'Kammlinienwüterich\', \'text\': \'{R}: Der Kammlinienwüterich erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Während Armeen Jamuraa durchzogen, streiften die Bestien über entlegene Ebenen, immer auf der Suche nach Opfern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162828&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d0e21b3-6ddc-4c7e-82cf-1e4c8189d6d1\', \'multiverseId\': 162828}, \'multiverseid\': 162828}, {\'name\': \'Iracundo alomado\', \'text\': \'{R}: El Iracundo alomado obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Mientras los ejércitos combatían a través de Jamuraa, las bestias acechaban los lugares elevados en busca de víctimas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165465&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cfa3e92a-153c-48bd-8f21-348da7f9d171\', \'multiverseId\': 165465}, \'multiverseid\': 165465}, {\'name\': \'Furie des crêtes\', \'text\': "{R} : La Furie des crêtes gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : bête\', \'flavor\': "Tandis que les armées s\'affrontaient sur la plaine de Jamuraa, les bêtes rôdaient dans les hauteurs, comptant leurs futures proies.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163185&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce3f6f6f-a811-4b43-a34f-39a280a7dabf\', \'multiverseId\': 163185}, \'multiverseid\': 163185}, {\'name\': \'Rabbioso Crestato\', \'text\': \'{R}: Il Rabbioso Crestato prende +1/+0 fino alla fine del turno\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Mentre gli eserciti combattevano su tutta Jamuraa, le bestie esploravano i luoghi più elevati alla ricerca di vittime.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165108&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56cc9e74-6d04-45c1-9dd5-9ad56aaa0053\', \'multiverseId\': 165108}, \'multiverseid\': 165108}, {\'name\': \'尾根の憤怒獣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac3ff0a1-4340-434b-9ac0-fca0cded9b4d\'}, \'multiverseid\': None}, {\'name\': \'Raivoso da Cordilheira\', \'text\': \'{R}: Raivoso da Cordilheira recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Enquanto exércitos batalhavam por toda a Jamuraa, as bestas espreitavam nos lugares altos em busca de vítimas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165822&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6223146-ec0c-4407-b1bd-ece5b2784a07\', \'multiverseId\': 165822}, \'multiverseid\': 165822}]', '[{\'name\': \'Karma\', \'text\': \'Zu Beginn des Versorgungssegments jedes Spielers fügt Karma diesem Spieler Schadenspunkte in Höhe der Anzahl Sümpfe, die er kontrolliert, zu. (Dein Versorgungssegment kommt nach dem Enttappen und vor dem Ziehen.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c6f71cb-57f7-44d6-864c-bae52686fb95\', \'multiverseId\': 162641}, \'multiverseid\': 162641}, {\'name\': \'Karma\', \'text\': \'Al comienzo del mantenimiento de cada jugador, el Karma hace a ese jugador una cantidad de daño igual al número de Pantanos que controle. (Tu paso de mantenimiento es después de enderezar y antes de robar.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9dbd34f-62ff-4d83-b3c9-3015516e44d4\', \'multiverseId\': 165278}, \'multiverseid\': 165278}, {\'name\': \'Karma\', \'text\': "Au début de l\'entretien de chaque joueur, le Karma inflige à ce joueur un nombre de blessures égal au nombre de marais qu\'il contrôle. (Votre phase d\'entretien commence après le dégagement de vos cartes et avant votre pioche.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162998&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'598c63a0-c3b4-4ea2-a24e-a5a80769f338\', \'multiverseId\': 162998}, \'multiverseid\': 162998}, {\'name\': \'Karma\', \'text\': "All\'inizio del mantenimento di ciascun giocatore, il Karma infligge a quel giocatore un ammontare di danni pari al numero di Paludi che controlla (il tuo mantenimento è dopo il tuo STAP e prima della tua acquisizione).", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164921&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8fe385ec-a0b1-44f4-a69f-e3be3e220af5\', \'multiverseId\': 164921}, \'multiverseid\': 164921}, {\'name\': \'因果応報\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf4675d6-7098-457f-9e27-a51c0b7de2a5\'}, \'multiverseid\': None}, {\'name\': \'Karma\', \'text\': \'No início da manutenção de cada jogador, Karma causa uma quantidade de pontos de dano àquele jogador igual ao número de Pântanos que ele próprio controla. (Sua etapa de manutenção ocorre depois que você desvirar e antes de você comprar.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165635&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2299eadc-2991-4bc5-b09d-8a0c33b50132\', \'multiverseId\': 165635}, \'multiverseid\': 165635}]', '[{\'name\': \'Katalog\', \'text\': \'Ziehe zwei Karten und wirf dann eine Karte aus deiner Hand ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'Es gibt so viele Lernende wie ein Ochse Haare hat, doch die Erfolgreichen sind so selten wie des Einhorns Horn. —Chinesisches Sprichwort\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ddc6208f-2a40-4d9b-9f3d-9894ab4a6b06\', \'multiverseId\': 162678}, \'multiverseid\': 162678}, {\'name\': \'Catalogar\', \'text\': \'Roba dos cartas, luego descarta una carta de tu mano.\', \'type\': \'Instantáneo\', \'flavor\': \'Aunque los que estudian son tantos como los pelos de un buey, los que tienen éxito son tan raros como los cuernos de unicornio. —Proverbio chino\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165315&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e7291c9-2082-45e8-ad10-321bed8d90a1\', \'multiverseId\': 165315}, \'multiverseid\': 165315}, {\'name\': \'Catalogue\', \'text\': "Piochez deux cartes, puis défaussez-vous d\'une carte de votre main.", \'type\': \'Éphémère\', \'flavor\': "L\'étudiant se multiplie comme les poils sur le dos d\'un bœuf, mais l\'érudit se fait aussi rare que les cornes de licorne. —Proverbe chinois", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163035&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69c3a6e0-dbdc-4560-8323-3298e5e93c88\', \'multiverseId\': 163035}, \'multiverseid\': 163035}, {\'name\': \'Catalogare\', \'text\': \'Pesca due carte, poi scarta una carta dalla tua mano.\', \'type\': \'Istantaneo\', \'flavor\': "Anche se coloro che studiano sono numerosi come i peli di un bue, quelli che hanno successo sono rari come le corna dell\'unicorno. —proverbio cinese", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164958&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8541ee6d-3fd1-440a-8e13-7ad5e0fa97a7\', \'multiverseId\': 164958}, \'multiverseid\': 164958}, {\'name\': \'目録\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6a8f87e-1897-4a9d-b64d-f4d4d526acfe\'}, \'multiverseid\': None}, {\'name\': \'Catalogar\', \'text\': \'Compre dois cards e depois descarte um card de sua mão.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Embora haja tantos estudiosos quanto pêlos no touro, os bem-sucedidos são tão raros quanto chifres de unicórnio. — Provérbio chinês\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165672&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f0f4cbc6-234a-4ea6-b594-ffa6be944910\', \'multiverseId\': 165672}, \'multiverseid\': 165672}]', '[{\'name\': \'Klingenschauer\', \'text\': \'Der Klingenschauer fügt jeder angreifenden Kreatur 1 Schadenspunkt zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manche behaupten, dies seien die Waffen der im Kampf gefallenen Helden, die auf einen letzten Ruhmesglanz hoffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162648&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1a6d789-78b4-4b17-bd59-ab3741d4d086\', \'multiverseId\': 162648}, \'multiverseid\': 162648}, {\'name\': \'Lluvia de espadas\', \'text\': \'La Lluvia de espadas hace 1 punto de daño a cada criatura atacante.\', \'type\': \'Instantáneo\', \'flavor\': \'Algunos dicen que son las armas de héroes caídos en batalla, ansiosos por una última oportunidad de obtener gloria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165285&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9b2db648-e533-4798-aebf-dd4811d47d30\', \'multiverseId\': 165285}, \'multiverseid\': 165285}, {\'name\': \'Pluie de lames\', \'text\': \'La Pluie de lames inflige 1 blessure à chaque créature attaquante.\', \'type\': \'Éphémère\', \'flavor\': "La légende veut que ce soient les armes des héros tombés au champ d\'honneur, venues chercher une dernière heure de gloire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163005&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'088f464b-e153-401e-a2df-afa9c46a6183\', \'multiverseId\': 163005}, \'multiverseid\': 163005}, {\'name\': \'Pioggia di Lame\', \'text\': \'La Pioggia di Lame infligge 1 danno a ogni creatura attaccante.\', \'type\': \'Istantaneo\', \'flavor\': "Alcuni dicono che siano le armi degli eroi caduti in battaglia, assetate di un\'ultima occasione di gloria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164928&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2eba726d-f10e-4762-9dc4-11f508aedb87\', \'multiverseId\': 164928}, \'multiverseid\': 164928}, {\'name\': \'刃の雨\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f34c1971-5f73-43d8-afbb-9ffd22021a03\'}, \'multiverseid\': None}, {\'name\': \'Chuva de Lâminas\', \'text\': \'Chuva de Lâminas causa 1 ponto de dano a cada criatura atacante.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Alguns dizem que elas são as armas dos heróis que caíram no campo de batalha, sedentas por uma última chance de alcançar a glória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165642&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'05272f4a-817a-4697-8322-ba084a248acb\', \'multiverseId\': 165642}, \'multiverseid\': 165642}]', '[{\'name\': \'Knochenhron\', \'text\': \'Immer wenn ein Spieler einen schwarzen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Durch tausend Ängste beschmutzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162930&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'70ba5532-a162-422a-8b11-2afc83a5848b\', \'multiverseId\': 162930}, \'multiverseid\': 162930}, {\'name\': \'Trono de hueso\', \'text\': \'Siempre que un jugador juegue un hechizo negro, puedes pagar {1}. Si lo haces, ganas 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'Corrompido por mil miedos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165567&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f72a174e-cbea-4238-9ee1-110b9f59cd5b\', \'multiverseId\': 165567}, \'multiverseid\': 165567}, {\'name\': "Trône d\'os", \'text\': "À chaque fois qu\'un joueur joue un sort noir, vous pouvez payer {1}. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Souillée par un millier de peurs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163287&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f549a7b6-3013-4448-9c6f-5bc182b66331\', \'multiverseId\': 163287}, \'multiverseid\': 163287}, {\'name\': "Trono d\'Ossa", \'text\': \'Ogniqualvolta un giocatore gioca una magia nera, puoi spendere {1}. Se lo fai, guadagni 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'Contaminato da un migliaio di paure.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165210&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9da9dbc0-a0a0-44bc-a0fb-0b68c0bd4e8a\', \'multiverseId\': 165210}, \'multiverseid\': 165210}, {\'name\': \'骨の玉座\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e84c0ce7-457d-4dd0-a552-904b3a196a58\'}, \'multiverseid\': None}, {\'name\': \'Trono de Ossos\', \'text\': \'Toda vez que um jogador jogar uma mágica preta, você pode pagar {1}. Se o fizer, você ganha 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Amaldiçoado por mil temores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165924&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'86c76786-fb25-4aa3-bcd1-5c28f4fdbaf9\', \'multiverseId\': 165924}, \'multiverseid\': 165924}]', '[{\'name\': \'Kochende See\', \'text\': \'Zerstöre alle Inseln.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Erst wenn das letzte Riff trocken und alle Wellen Staub sind erst dann will ich ruhen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162793&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a362647d-edd2-4c39-9503-29873e5da73a\', \'multiverseId\': 162793}, \'multiverseid\': 162793}, {\'name\': \'Ebullición\', \'text\': \'Destruye todas las islas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Cuando todos los arrecifes hayan sido pelados y todas las olas sean polvo, sólo entonces descansaré".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a0d798c-3d57-4ec7-8c2a-618be086a496\', \'multiverseId\': 165430}, \'multiverseid\': 165430}, {\'name\': \'Bouillonnement\', \'text\': \'Détruisez toutes les îles.\', \'type\': \'Éphémère\', \'flavor\': \'« Lorsque tous les rochers seront seront à nu, et les vagues un souvenir dans le sel du désert, alors je pourrai me reposer. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163150&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4a6c7fc-cb7f-4a51-b0ea-3dd07e05e33e\', \'multiverseId\': 163150}, \'multiverseid\': 163150}, {\'name\': \'Ribollire\', \'text\': \'Distruggi tutte le Isole.\', \'type\': \'Istantaneo\', \'flavor\': \'"Quando ogni scoglio sarà stato svuotato e ogni onda sarà divenuta sabbia, solo allora potrò riposare".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2957ed7c-4058-47bc-987b-11a4a1581751\', \'multiverseId\': 165073}, \'multiverseid\': 165073}, {\'name\': \'沸騰\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0dd01e6b-cf42-4b43-a84a-b70ff17b697e\'}, \'multiverseid\': None}, {\'name\': \'Ferver\', \'text\': \'Destrói todas as Ilhas.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Quando todos os recifes estiverem desertos e todas as ondas forem pó só então eu descansarei."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165787&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2ce30110-17dc-442a-ad46-5a43e3f4adac\', \'multiverseId\': 165787}, \'multiverseid\': 165787}]', '[{\'name\': \'Konzentrieren\', \'text\': \'Ziehe drei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Schätze in meinem Gedächtnis sind mit allem weltlichen Ruhm nicht aufzuwiegen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162681&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04a88b7f-b189-4463-b98a-8d6a980a36c1\', \'multiverseId\': 162681}, \'multiverseid\': 162681}, {\'name\': \'Concentrarse\', \'text\': \'Roba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"El tesoro en mi mente es más grande que cualquier gloria mundana".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165318&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9e22153-33ea-46d0-80ad-e7bd63bf2ae2\', \'multiverseId\': 165318}, \'multiverseid\': 165318}, {\'name\': \'Concentration\', \'text\': \'Piochez trois cartes.\', \'type\': \'Rituel\', \'flavor\': \'« Je préfère les trésors de mon esprit à toutes les richesses de la terre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163038&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ebe3619d-c4fa-4ef4-bfa8-9c6cb294953a\', \'multiverseId\': 163038}, \'multiverseid\': 163038}, {\'name\': \'Concentrare\', \'text\': \'Pesca tre carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il tesoro che c\\\'è nella mia mente è più grande di tutti i beni terreni".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cbc24b14-5ba6-439f-923a-3a01962d3eed\', \'multiverseId\': 164961}, \'multiverseid\': 164961}, {\'name\': \'集中\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b323a933-7f01-4a2d-9c37-53b5115c3a1a\'}, \'multiverseid\': None}, {\'name\': \'Concentrar\', \'text\': \'Compre três cards.\', \'type\': \'Feitiço\', \'flavor\': \'"O tesouro em minha mente é maior que qualquer glória mundana."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165675&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4e58e88-6611-4e2b-b7f1-ae6a191b3222\', \'multiverseId\': 165675}, \'multiverseid\': 165675}]', '[{\'name\': \'Korallenaal\', \'type\': \'Kreatur — Aal\', \'flavor\': \'Manche Fischer essen gerne Aal, und manche Aale essen gerne Fischer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162683&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5171033e-cd6d-458d-b91b-d2bf8d5556db\', \'multiverseId\': 162683}, \'multiverseid\': 162683}, {\'name\': \'Anguila de coral\', \'type\': \'Criatura — Anguila\', \'flavor\': \'A algunos pescadores les gusta comer anguilas y a algunas anguilas les gusta comer pescadores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165320&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'57223f80-02e2-4fe8-a400-dbb1bbefd989\', \'multiverseId\': 165320}, \'multiverseid\': 165320}, {\'name\': \'Anguille des coraux\', \'type\': \'Créature : anguille\', \'flavor\': "Les pêcheurs aiment taquiner l\'anguille, mais les anguilles aiment parfois dévorer les pêcheurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163040&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'38715495-91a2-43f8-abad-0e16498e0795\', \'multiverseId\': 163040}, \'multiverseid\': 163040}, {\'name\': \'Anguilla Corallina\', \'type\': \'Creatura — Anguilla\', \'flavor\': \'Alcuni pescatori amano mangiare le anguille e alcune anguille amano mangiare i pescatori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164963&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d72549e1-4258-4dc0-9cc5-57dc5185cc98\', \'multiverseId\': 164963}, \'multiverseid\': 164963}, {\'name\': \'珊瑚ウツボ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3872296f-5195-4113-a9cd-32b8da02f03e\'}, \'multiverseid\': None}, {\'name\': \'Enguia dos Corais\', \'type\': \'Criatura — Enguia\', \'flavor\': \'Alguns pescadores gostam de comer enguias e algumas enguias gostam de comer pescadores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165677&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed0a8008-9d61-4bb0-9fdc-4597c3dc0e00\', \'multiverseId\': 165677}, \'multiverseid\': 165677}]', '[{\'name\': \'Kristallstab\', \'text\': \'Immer wenn ein Spieler einen blauen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Durch tausend Wellen blankpoliert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162908&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2c7c3a5-7438-47a3-9499-27d3e7cdc6a7\', \'multiverseId\': 162908}, \'multiverseid\': 162908}, {\'name\': \'Vara de cristal\', \'text\': \'Siempre que un jugador juegue un hechizo azul, puedes pagar {1}. Si lo haces, ganas 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'Pulida por mil olas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165545&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4ae9037-07b7-40c0-9f98-7a88ded13c6c\', \'multiverseId\': 165545}, \'multiverseid\': 165545}, {\'name\': \'Baguette de cristal\', \'text\': "À chaque fois qu\'un joueur joue un sort bleu, vous pouvez payer {1}. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Polie par un millier de vagues.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163265&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'156734c5-e43d-4e8c-aff8-e6ed53b80f1e\', \'multiverseId\': 163265}, \'multiverseid\': 163265}, {\'name\': \'Scettro di Cristallo\', \'text\': \'Ogniqualvolta un giocatore gioca una magia blu, puoi spendere {1}. Se lo fai, guadagni 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'Levigato da un migliaio di onde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165188&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2eb28f26-c9c7-4417-9fb1-4e7ccd91b12d\', \'multiverseId\': 165188}, \'multiverseid\': 165188}, {\'name\': \'水晶のロッド\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83bc1808-b337-4e08-ade4-e4282713d259\'}, \'multiverseid\': None}, {\'name\': \'Bastão de Cristal\', \'text\': \'Toda vez que um jogador jogar uma mágica azul, você pode pagar {1}. Se o fizer, você ganha 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Polido por mil ondas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165902&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ae70eb9-23b2-4e40-9185-a521b9ac71bd\', \'multiverseId\': 165902}, \'multiverseid\': 165902}]', '[{\'name\': \'Kämpfender Sceada\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Zauberlehrer in ihren Elfenbeintürmen nennen sie die „Himmelshaie". Zauberlehrer auf der Straße haben dafür meist keine Zeit mehr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2169ce6e-7c82-4080-ba6c-d7dcc02449d2\', \'multiverseId\': 162690}, \'multiverseid\': 162690}, {\'name\': \'Draco de lucha\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Draco\', \'flavor\': \'Los eruditos en sus torres de marfil los llaman "tiburones del cielo". Los eruditos en el camino definitivamente no los llaman.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165327&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'877e3f2d-01f9-4c49-bd0d-1bceb0d211e5\', \'multiverseId\': 165327}, \'multiverseid\': 165327}, {\'name\': \'Drakôn combattant\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : drakôn\', \'flavor\': "Les érudits dans leurs tours d\'ivoire les appellent les « requins du ciel ». Ceux qui sont sur les routes préfèrent ne pas les appeler.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163047&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a16eec6c-6314-4481-a61f-aec034e60fdb\', \'multiverseId\': 163047}, \'multiverseid\': 163047}, {\'name\': \'Draghetto Combattente\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'Gli studiosi nelle loro torri d\\\'avorio li chiamano "squali del cielo". Gli studiosi sulle strade non li chiamano proprio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164970&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eade21b0-bd28-439d-a2b8-a5c241275a93\', \'multiverseId\': 164970}, \'multiverseid\': 164970}, {\'name\': \'ファイティング・ドレイク\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efd7abbb-c0ea-42b4-9e41-0d9714cc2789\'}, \'multiverseid\': None}, {\'name\': \'Dragonete Combatente\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'Os estudiosos que ficam em suas torres de marfim chamam-nos "tubarões dos céus". Os estudiosos que estão na estrada não os chamam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165684&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8944e6e-7491-4b64-a0ab-065980b7909b\', \'multiverseId\': 165684}, \'multiverseid\': 165684}]', '[{\'name\': \'Köder\', \'text\': \'Alle Kreaturen, die die verzauberte Kreatur blocken können, tun dies.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Wenn der Wald etwas will, kann kein sterbliches Hirn ihm widerstehen." —Maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162876&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2918c740-4d03-4045-b631-28b94096c566\', \'multiverseId\': 162876}, \'multiverseid\': 162876}, {\'name\': \'Señuelo\', \'text\': \'Todas las criaturas que puedan bloquear a la criatura encantada lo hacen.\', \'type\': \'Encantar criatura\', \'flavor\': \'"Cuando el bosque quiere algo, ninguna mente mortal puede resistírsele." Maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165513&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d43cf305-efbe-4ba6-8335-556d26c8f005\', \'multiverseId\': 165513}, \'multiverseid\': 165513}, {\'name\': \'Leurre\', \'text\': \'Toutes les créatures capables de bloquer la créature enchantée le font.\', \'type\': \'Enchanter : créature\', \'flavor\': \'« Quand la forêt veut quelque chose, aucun esprit mortel ne peut lui résister.» — Maro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163233&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'de6cfea5-06a0-4a18-be91-fea360092570\', \'multiverseId\': 163233}, \'multiverseid\': 163233}, {\'name\': \'Richiamo\', \'text\': \'Tutte le creature che possono bloccare la creatura incantata lo fanno.\', \'type\': \'Incanta Creatura\', \'flavor\': \'"Quando la foresta vuole qualcosa, nessuna mente mortale può resisterle". -Maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165156&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5eb3dcbd-1935-47ec-8e1d-946e4ac3eb8c\', \'multiverseId\': 165156}, \'multiverseid\': 165156}, {\'name\': \'寄せ餌\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c2d170c-e07c-4c33-b28d-3ea28614c4bf\'}, \'multiverseid\': None}, {\'name\': \'Isca\', \'text\': \'Todas as criaturas aptas a bloquearem a criatura encantada o fazem.\', \'type\': \'Encantar Criatura\', \'flavor\': \'"Quando a floresta quer alguma coisa, nenhum ser mortal é capaz de lhe resistir." — Maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165870&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c6f7d88-f340-47e7-a243-da598c005bff\', \'multiverseId\': 165870}, \'multiverseid\': 165870}]', '[{\'name\': \'Küstenhornschnabel\', \'text\': \'Opfere ein Land: Der Küstenhornschnabel erhält bis zum Ende des Zuges Flugfähigkeit. (Sie kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Die Bauern Jamuraas fürchten nur drei Dinge: Dürren, Überschwemmungen und die Hornschnäbel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'317a0297-a1ce-4f5a-8789-c2ee99bbb7be\', \'multiverseId\': 162679}, \'multiverseid\': 162679}, {\'name\': \'Garracuerno costero\', \'text\': \'Sacrificar una tierra: El Garracuerno costero gana la habilidad de volar hasta el final del turno. (No pueden ser bloqueados excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Ave\', \'flavor\': \'Los granjeros de Jamuraa les temen a tres cosas más que a nada: sequias, inundaciones y garracuernos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165316&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ca81352-7e31-42c7-8100-3db99c50a61d\', \'multiverseId\': 165316}, \'multiverseid\': 165316}, {\'name\': \'Grifargne côtier\', \'text\': "Sacrifiez un terrain : Le Grifargne côtier acquiert le vol jusqu\'à la fin du tour. (Elle ne peut être bloquée que par des créatures avec le vol.)", \'type\': \'Créature : oiseau\', \'flavor\': \'Les fermiers jamuréens redoutent par-dessus tout trois fléaux : la sécheresse, les inondations et les grifargnes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163036&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27448476-80c9-4477-be43-1ad40ecdb57a\', \'multiverseId\': 163036}, \'multiverseid\': 163036}, {\'name\': \'Cornartiglio della Costa\', \'text\': \'Sacrifica una terra: Il Cornartiglio della Costa guadagna volare fino alla fine del turno (Non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Uccello\', \'flavor\': \'I contadini di Jamuraa temono tre cose su tutte: la siccità, le alluvioni e i cornartigli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164959&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b5911ee7-3957-4caf-ae29-70285943d890\', \'multiverseId\': 164959}, \'multiverseid\': 164959}, {\'name\': \'沿岸の角爪鳥\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'801d7a7c-5818-47fd-998d-43cbefd72955\'}, \'multiverseid\': None}, {\'name\': \'Garracórneo Costeiro\', \'text\': \'Sacrifique um terreno: Garracórneo Costeiro ganha a habilidade de voar até o final do turno. (Ela só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Ave\', \'flavor\': \'As três coisas que os fazendeiros de Jamuraa mais temem são: a seca, as enchentes e os garracórneos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165673&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a91b9e8e-c932-46ca-be80-ce7193353f07\', \'multiverseId\': 165673}, \'multiverseid\': 165673}]', '[{\'name\': \'Küstenräuberei\', \'text\': \'Immer wenn eine Kreatur, die du kontrollierst, einem Gegner Kampfschaden zufügt, kannst du eine Karte ziehen.\', \'type\': \'Verzauberung\', \'flavor\': \'„Ich sehe mich nicht als einen Piraten. Sagen wir lieber, ich kurbele die lokale Wirtschaft an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162680&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b08b76b4-adb0-415d-bcdb-9cfc2e9c66f0\', \'multiverseId\': 162680}, \'multiverseid\': 162680}, {\'name\': \'Piratería costera\', \'text\': \'Siempre que una criatura que controles haga daño de combate a un oponente, puedes robar una carta.\', \'type\': \'Encantamiento\', \'flavor\': \'"No me gusta considerarme un pirata. Más bien soy un estimulante para la economía local".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165317&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eeabf308-283d-449c-b8ed-8da724fa329c\', \'multiverseId\': 165317}, \'multiverseid\': 165317}, {\'name\': \'Piraterie côtière\', \'text\': "À chaque fois qu\'une créature que vous contrôlez inflige des blessures de combat à l\'un de vos adversaires, vous pouvez piocher une carte.", \'type\': \'Enchantement\', \'flavor\': "« Je ne me considère pas comme un pirate, mais plutôt comme un catalyseur de l\'économie locale. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163037&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed7bf30b-25b8-430e-b8ab-7e2972a7c5e9\', \'multiverseId\': 163037}, \'multiverseid\': 163037}, {\'name\': \'Pirateria Costiera\', \'text\': \'Ogniqualvolta una creatura che controlli infligge danno da combattimento a un avversario, puoi pescare una carta.\', \'type\': \'Incantesimo\', \'flavor\': \'"Non mi considero un pirata. Più che altro sono uno stimolatore dell\\\'economia locale".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164960&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6042a93-0eec-47ce-90cb-6495fe4acc49\', \'multiverseId\': 164960}, \'multiverseid\': 164960}, {\'name\': \'沿岸の海賊行為\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'492ac6df-13aa-46a3-b02a-207e3ffd1771\'}, \'multiverseid\': None}, {\'name\': \'Pirataria Costeira\', \'text\': \'Toda vez que uma criatura que você controla causar dano de combate a um oponente, você pode comprar um card.\', \'type\': \'Encantamento\', \'flavor\': \'"Não gosto de pensar que sou um pirata. Sou mais como um incentivador da economia local."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165674&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cf9d67ad-3a65-43e9-8a85-631b77d01fc4\', \'multiverseId\': 165674}, \'multiverseid\': 165674}]', "[{'name': 'Küstenturm', 'text': 'Der Küstenturm kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {U}.', 'type': 'Land', 'flavor': 'Ein Leuchtfeuer in der Nacht, ein Traum im Nebel.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162936&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f22bd1e1-b57f-420a-bb82-9fc809cbe337', 'multiverseId': 162936}, 'multiverseid': 162936}, {'name': 'Torre costera', 'text': 'La Torre costera entra en juego girada.{T}: Agrega {W} o {U} a tu reserva de maná.', 'type': 'Tierra', 'flavor': 'Un faro en la noche, un sueño en la niebla.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165573&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2770c44a-1355-487b-9012-779608a12802', 'multiverseId': 165573}, 'multiverseid': 165573}, {'name': 'Tour côtière', 'text': 'La Tour côtière arrive en jeu engagée.\\n{T} : Ajoutez {W} ou {U} à votre réserve.', 'type': 'Terrain', 'flavor': 'Une lumière dans la nuit ; un rêve dans le brouillard.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163293&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8226d674-36a3-45a8-b463-4ec4dad8eca8', 'multiverseId': 163293}, 'multiverseid': 163293}, {'name': 'Torre Costiera', 'text': 'La Torre Costiera entra in gioco TAPpata.\\n{T}: Aggiungi {W} o {U} alla tua riserva di mana.', 'type': 'Terra', 'flavor': 'Un faro nella notte, un sogno nella nebbia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165216&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bdcd4731-554e-493b-88a1-b9d2df761ae7', 'multiverseId': 165216}, 'multiverseid': 165216}, {'name': '沿岸の塔', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0b118c88-842f-4ce7-a0f9-d9806992d9e8'}, 'multiverseid': None}, {'name': 'Torre Costeira', 'text': 'Torre Costeira entra em jogo virado.\\n{T}: Adiciona {W} ou {U} à sua reserva de mana.', 'type': 'Terreno', 'flavor': 'Um facho de luz na noite, um sonho no nevoeiro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165930&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cb53b16d-038c-43e9-8fa0-c69fe106f858', 'multiverseId': 165930}, 'multiverseid': 165930}]", "[{'name': 'Lasttier', 'text': 'Stärke und Widerstandskraft des Lasttiers sind gleich der Anzahl an Kreaturen im Spiel.', 'type': 'Artefaktkreatur', 'flavor': 'Je schwerer die Last, desto härter arbeitet es.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162905&type=card', 'language': 'German', 'identifiers': {'scryfallId': '21099efb-40b8-4bbc-a609-a65a36c663ed', 'multiverseId': 162905}, 'multiverseid': 162905}, {'name': 'Bestia de carga', 'text': 'Tanto la fuerza como la resistencia de la Bestia de carga son iguales al número de criaturas que haya en juego.', 'type': 'Criatura artefacto', 'flavor': 'Mientras más pesada la carga, más duro trabaja.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165542&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fc3b3ca2-6e3a-4b55-b1b9-6451b1a338c5', 'multiverseId': 165542}, 'multiverseid': 165542}, {'name': 'Bête de somme', 'text': 'La Bête de somme a une force et une endurance chacune égale au nombre de créatures en jeu.', 'type': 'Créature-artefact', 'flavor': 'Plus lourde est la charge, plus dur elle travaille.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163262&type=card', 'language': 'French', 'identifiers': {'scryfallId': '525b1c9c-6ff6-46a3-b8f6-6e84d8987252', 'multiverseId': 163262}, 'multiverseid': 163262}, {'name': 'Bestia da Soma', 'text': 'La forza e la costituzione della Bestia da Soma sono pari ciascuna al numero di creature in gioco.', 'type': 'Creatura Artefatto', 'flavor': 'Più pesante è il fardello, più duramente lavora.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165185&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd17a0df3-2706-43ad-a5a0-5eb3b79d27c3', 'multiverseId': 165185}, 'multiverseid': 165185}, {'name': '役畜', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '25866fa8-35ab-4dd9-bb8c-ee0863b2cd0c'}, 'multiverseid': None}, {'name': 'Besta de Carga', 'text': 'O poder e a resistência de Besta de Carga são ambos iguais ao número de criaturas em jogo.', 'type': 'Criatura Artefato', 'flavor': 'Quanto mais pesada a carga, mais ela se empenha no trabalho.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165899&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '603e0fa9-352f-4e1a-b6c7-5743a78ab3cf', 'multiverseId': 165899}, 'multiverseid': 165899}]", '[{\'name\': \'Lavaaxt\', \'text\': \'Lavaaxt fügt einem Spieler deiner Wahl 5 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Fang"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162810&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b268f75-3a54-4ea8-8174-a3c684e6f775\', \'multiverseId\': 162810}, \'multiverseid\': 162810}, {\'name\': \'Hacha de lava\', \'text\': \'El Hacha de lava hace 5 puntos de daño al jugador objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"¡Atrapa"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d6c6a3e-fd9f-4547-b23f-58f789fae82a\', \'multiverseId\': 165447}, \'multiverseid\': 165447}, {\'name\': \'Hache de lave\', \'text\': \'La Hache de lave inflige 5 blessures au joueur ciblé.\', \'type\': \'Rituel\', \'flavor\': \'« Attrape ça »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163167&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'565fa1fd-5985-4c13-8f2b-1693772bfa91\', \'multiverseId\': 163167}, \'multiverseid\': 163167}, {\'name\': \'Ascia di Lava\', \'text\': "L\'Ascia di Lava infligge 5 danni a un giocatore bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'"Lascia"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165090&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f69d7e26-bc1a-47a2-bcbe-db144e934ee5\', \'multiverseId\': 165090}, \'multiverseid\': 165090}, {\'name\': \'溶岩の斧\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5ef66da-8f20-4dc4-a6c3-0bb0e247db8d\'}, \'multiverseid\': None}, {\'name\': \'Machado de Lava\', \'text\': \'Machado de Lava causa 5 pontos de dano ao jogador alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Pega aí"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165804&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'726a8d63-74de-4b70-8fd7-69560eb73b89\', \'multiverseId\': 165804}, \'multiverseid\': 165804}]', "[{'name': 'Lavahunde', 'text': 'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen.)\\nWenn die Lavahunde ins Spiel kommen, fügen sie dir 4 Schadenspunkte zu.', 'type': 'Kreatur — Hund', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162811&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'afe0c748-066e-4cfd-9fc1-9290ad9271bc', 'multiverseId': 162811}, 'multiverseid': 162811}, {'name': 'Sabuesos de lava', 'text': 'Prisa. (Esta criatura puede atacar el turno en que entre bajo tu control.)\\nCuando los Sabuesos de lava entren en juego, te hacen 4 puntos de daño.', 'type': 'Criatura — Perro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165448&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6a6f2c3e-2a5b-4396-90fe-4257eac7156e', 'multiverseId': 165448}, 'multiverseid': 165448}, {'name': 'Chiens de lave', 'text': 'Célérité (Cette créature peut attaquer dès le tour où elle arrive sous votre contrôle.)\\nQuand les Chiens de lave arrivent en jeu, ils vous infligent 4 blessures.', 'type': 'Créature : chien de chasse', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163168&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2ebcabf7-8b88-40f6-9ea1-565093367c9f', 'multiverseId': 163168}, 'multiverseid': 163168}, {'name': 'Segugi di Lava', 'text': 'Rapidità (Questa creatura può attaccare nel turno in cui entra sotto il tuo controllo.)\\nQuando i Segugi di Lava entrano in gioco, ti infliggono 4 danni.', 'type': 'Creatura — Segugio', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165091&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4eb3aa7b-be50-42a1-9e52-76f0701939a9', 'multiverseId': 165091}, 'multiverseid': 165091}, {'name': '溶岩の猟犬', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ffc65622-75bc-4b78-a738-d24f59af963a'}, 'multiverseid': None}, {'name': 'Sabujos de Lava', 'text': 'Ímpeto (Esta criatura pode atacar no turno em que entra em jogo sob seu controle.)\\nQuando Sabujos de Lava entra em jogo, ele causa 4 pontos de dano a você.', 'type': 'Criatura — Sabujo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165805&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9b5b3e90-62b8-4960-af04-31d0398e6f79', 'multiverseId': 165805}, 'multiverseid': 165805}]", "[{'name': 'Lebende Landschaft', 'text': 'Das verzauberte Land ist eine 5/6 grüne Baumhirtenkreatur, die auch noch ein Land ist.', 'type': 'Landverzauberung', 'flavor': 'Manche Krieger wandern über die Erde. Andere wurden von ihr erschaffen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162873&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f1eda85a-e94f-4217-a0f7-6a552d649f1e', 'multiverseId': 162873}, 'multiverseid': 162873}, {'name': 'Terreno vivo', 'text': 'La tierra encantada es una criatura Pueblo arbóreo verde 5/6 que sigue siendo una tierra.', 'type': 'Encantar tierra', 'flavor': 'Algunos guerreros recorren la tierra. Otros nacen de ella.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165510&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '990ffab0-775e-4832-8d23-080d49347000', 'multiverseId': 165510}, 'multiverseid': 165510}, {'name': 'Terrain vivant', 'text': 'Le terrain enchanté est une créature 5/6 verte Sylvin qui est toujours un terrain.', 'type': 'Enchanter : terrain', 'flavor': 'On dit que les plus grands guerriers foulent la terre. Certains y ont même leurs racines.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163230&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c69e2a50-f8a3-4642-b57e-41c5eb9b57eb', 'multiverseId': 163230}, 'multiverseid': 163230}, {'name': 'Terreno Vivente', 'text': 'La terra incantata è una creatura Silvantropo 5/6 verde che è ancora una terra.', 'type': 'Incanta Terra', 'flavor': 'Alcuni guerrieri camminano sulla terra. Altri sono i suoi figli.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165153&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e0aa1c4d-f7af-4020-a53e-b3e2cd6a1d2e', 'multiverseId': 165153}, 'multiverseid': 165153}, {'name': '生きている地形', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2b9dbde3-d866-4573-87ad-d4a9670e6e41'}, 'multiverseid': None}, {'name': 'Terra Viva', 'text': 'O terreno encantado é uma criatura verde 5/6 do tipo Ent, que ainda é um terreno.', 'type': 'Encantar Terreno', 'flavor': 'Alguns guerreiros caminham sobre a terra. Outros nascem dela.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165867&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1d3dbc44-8dd0-46b3-99e6-a2c0fef58a90', 'multiverseId': 165867}, 'multiverseid': 165867}]", '[{\'name\': \'Lebendige Brücke\', \'text\': \'Kreaturen mit einer Stärke größer als die Anzahl an Karten auf deiner Hand können nicht angreifen.\', \'type\': \'Artefakt\', \'flavor\': \'„Warum sollte man Brücken bauen, die sich nicht selber bewachen?" —Champion der Elfen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162913&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'062ba5cf-3f15-4534-93a7-0fc93cdf2889\', \'multiverseId\': 162913}, \'multiverseid\': 162913}, {\'name\': \'Puente engañoso\', \'text\': \'Las criaturas con fuerza mayor al número de cartas que haya en tu mano no pueden atacar.\', \'type\': \'Artefacto\', \'flavor\': \'"Por qué construir un puente que necesita ser protegido?". —Campeona élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165550&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e87cd050-26bb-4140-a3b0-81f6a7585ad6\', \'multiverseId\': 165550}, \'multiverseid\': 165550}, {\'name\': \'Piègepont\', \'text\': \'Les créatures avec une force supérieure au nombre de cartes dans votre main ne peuvent pas attaquer.\', \'type\': \'Artefact\', \'flavor\': \'« Pourquoi construire un pont qui doit être gardé ? » — Championne elfe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163270&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0afe96f-40fb-4125-aadc-90ac6efd005b\', \'multiverseId\': 163270}, \'multiverseid\': 163270}, {\'name\': \'Ponte Intrappolante\', \'text\': \'Le creature con forza superiore al numero di carte che hai in mano non possono attaccare.\', \'type\': \'Artefatto\', \'flavor\': \'"Perché costruire un ponte che deve essere sorvegliato?". —campione elfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165193&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b0154af-6e80-4825-a174-6763a39711de\', \'multiverseId\': 165193}, \'multiverseid\': 165193}, {\'name\': \'罠の橋\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f72c2c9-ebc8-49fc-8506-fbd66ddb51a5\'}, \'multiverseid\': None}, {\'name\': \'Ponte Traiçoeira\', \'text\': \'Criaturas com o poder maior do que o número de cards na sua mão não podem atacar.\', \'type\': \'Artefato\', \'flavor\': \'"Para quê construir uma ponte que precisa de guarda?" — Campeão élfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165907&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c20df2d-1ff4-4d35-ba1b-c074099672bd\', \'multiverseId\': 165907}, \'multiverseid\': 165907}]', "[{'name': 'Lebensquelle', 'text': 'Ein Spieler deiner Wahl erhält X Lebenspunkte dazu.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162895&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5c508c03-36a6-4fc2-988b-f58947c576bb', 'multiverseId': 162895}, 'multiverseid': 162895}, {'name': 'Manantial de vida', 'text': 'El jugador objetivo gana X vidas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165532&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c38b2c3b-b954-49a3-90b3-0b8a77386e81', 'multiverseId': 165532}, 'multiverseid': 165532}, {'name': 'Source de vie', 'text': 'Le joueur ciblé gagne X points de vie.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163252&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a2acd4b4-f511-4e24-a125-a204c571cb60', 'multiverseId': 163252}, 'multiverseid': 163252}, {'name': 'Fonte della Vita', 'text': 'Il giocatore bersaglio guadagna X punti vita.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165175&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '508b4efd-23f6-45a1-aa90-aaac305ccdcf', 'multiverseId': 165175}, 'multiverseid': 165175}, {'name': '命の川', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '27de4907-3308-42fa-bc49-7f8545fe32cc'}, 'multiverseid': None}, {'name': 'Fluxo de Vida', 'text': 'O jogador alvo ganha X pontos de vida.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165889&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '060ea9d4-bd19-40bd-a85a-fbcbc8f6eb28', 'multiverseId': 165889}, 'multiverseid': 165889}]", '[{\'name\': \'Lhurgoyf\', \'text\': \'Die Stärke des Lhurgoyfs ist gleich der Anzahl der Kreaturenkarten in allen Friedhöfen, und seine Widerstandskraft ist gleich dieser Zahl plus 1.\', \'type\': \'Kreatur — Lhurgoyf\', \'flavor\': \'„Lauf Hans, lauf Es ist der Lhurgoyf" —Saffi Eriksdotter, ihre letzten Worte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162872&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e2fc08a-ce43-4213-b8f1-793efad9b602\', \'multiverseId\': 162872}, \'multiverseid\': 162872}, {\'name\': \'Lhurgoyf\', \'text\': \'La fuerza del Lhurgoyf es igual al número de cartas de criatura que haya en todos los cementerios y su resistencia es igual a ese número más uno.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': \'"¡Ay ¡Corre, Hans ¡Es el lhurgoyf". Últimas palabras de Saffi Eriksdotter\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165509&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0855ba97-d01c-4089-8139-c5112ab6b758\', \'multiverseId\': 165509}, \'multiverseid\': 165509}, {\'name\': \'lhurgoyf\', \'text\': \'La force du Lhurgoyf est égale au nombre de cartes de créature dans tous les cimetières et son endurance est égale à ce nombre plus 1.\', \'type\': \'Créature : lhurgoyf\', \'flavor\': "« Ach Hans, fuis C\'est le lhurgoyf » — Saffi Eriksdotter, derniers mots", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163229&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58869e7f-49b2-4815-8ff4-a2281cbb2c49\', \'multiverseId\': 163229}, \'multiverseid\': 163229}, {\'name\': \'Lhurgoyf\', \'text\': \'La forza del Lhurgoyf è pari al numero di carte creatura presenti in tutti i cimiteri e la sua costituzione è pari a quel numero più 1.\', \'type\': \'Creatura — Lhurgoyf\', \'flavor\': \'"Ack Corri, Hans È il lhurgoyf" —Saffi Eriksdotter, ultime parole\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165152&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47c3e185-8719-451e-ae88-6c4782be9423\', \'multiverseId\': 165152}, \'multiverseid\': 165152}, {\'name\': \'ルアゴイフ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e5bf801-6d21-4720-be64-9f4cd511565d\'}, \'multiverseid\': None}, {\'name\': \'Lhurgoyf\', \'text\': \'O poder de Lhurgoyf é igual ao número de cards de criatura em todos os cemitérios e sua resistência é igual àquele número mais 1.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': \'"Ah Corra Hans É o lhurgoyf" — Saffi Eriksdotter, últimas palavras\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0547f5ff-e411-45ae-bdd8-ef285ec16615\', \'multiverseId\': 165866}, \'multiverseid\': 165866}]', '[{\'name\': \'Liederliches Verlangen\', \'text\': \'Liederliches Verlangen fügt einer Kreatur deiner Wahl 2 Schadenspunkte zu, und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Nur die gierigsten Seelen ernähren sich von der Gesundheit der Schwachen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fcd42b63-dbac-4ee1-8ba7-1cc61b618d9b\', \'multiverseId\': 162784}, \'multiverseid\': 162784}, {\'name\': \'Hambre perversa\', \'text\': \'El Hambre perversa hacen 2 puntos de daño a la criatura objetivo, y ganas 2 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'Sólo el alma más voraz se alimenta de la salud de los débiles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165421&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f05a7d65-6415-4b03-bfcf-42e827405c78\', \'multiverseId\': 165421}, \'multiverseid\': 165421}, {\'name\': \'Faim violente\', \'text\': \'La Faim violente inflige 2 blessures à la créature ciblée et vous gagnez 2 points de vie.\', \'type\': \'Rituel\', \'flavor\': "Seule l\'âme la plus affamée se repaît de la santé des faibles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163141&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a8ad86a-da15-431e-b0db-8cc6db20b4c0\', \'multiverseId\': 163141}, \'multiverseid\': 163141}, {\'name\': \'Appetito Perverso\', \'text\': "L\'Appetito Perverso infligge 2 danni a una creatura bersaglio e tu guadagni 2 punti vita.", \'type\': \'Stregoneria\', \'flavor\': \'Solo le anime più ingorde si nutrono della salute dei deboli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165064&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aad67fe2-3929-461c-84f6-790809c60502\', \'multiverseId\': 165064}, \'multiverseid\': 165064}, {\'name\': \'不純な飢え\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab52c8d4-0644-47d9-9bf1-e2967e7ec8f1\'}, \'multiverseid\': None}, {\'name\': \'Fome Mórbida\', \'text\': \'Fome Mórbida causa 2 pontos de dano à criatura alvo e você ganha 2 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'Somente as almas mais vorazes se alimentam da saúde dos fracos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165778&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c2182a3d-bc87-4769-a508-76f0b0d6a166\', \'multiverseId\': 165778}, \'multiverseid\': 165778}]', '[{\'name\': \'Llanowar-Behemoth\', \'text\': \'Tappe eine ungetappte Kreatur, die du kontrollierst: Der Llanowar-Behemoth erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Behemoth\', \'flavor\': \'„Die meisten Leute können noch nicht einmal aus Stein oder Stahl gute Waffen herstellen. Die Elfen dagegen brauchen anscheinend nur Lehm und Ranken." —Gerrard von der Wetterlicht\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162874&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ba98268-b2cf-476e-8d87-38f893ad431d\', \'multiverseId\': 162874}, \'multiverseid\': 162874}, {\'name\': \'Behemot de Llanowar\', \'text\': \'Girar una criatura enderezada que controles: El Behemot de Llanowar obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Behemot\', \'flavor\': \'"La mayoría de la gente no puede fabricar armas decentes con piedra ni con acero. Confía en que los elfos pueden hacerlo con solo lodo y lianas." —Gerrard del Vientoligero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165511&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13bc761f-6153-46d6-99dd-67fe32c1f609\', \'multiverseId\': 165511}, \'multiverseid\': 165511}, {\'name\': \'Béhémoth de Llanowar\', \'text\': "Engagez une créature dégagée que vous contrôlez : Le Béhémoth de Llanowar gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : béhémoth\', \'flavor\': "« La plupart des gens ne savent même pas fabriquer de bonnes armes avec la pierre et l\'acier — alors que les elfes en font avec de la boue et des lianes. » —Gerrard de l\'Aquilon", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163231&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b24a24d-312c-44e2-b06d-6ffc24b34ab8\', \'multiverseId\': 163231}, \'multiverseid\': 163231}, {\'name\': \'Behemoth di Llanowar\', \'text\': \'TAPpa una creatura STAPpata che controlli: Il Behemoth di Llanowar prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Behemoth\', \'flavor\': \'"Molte persone non riescono a costruire armi decenti neppure con la pietra o il metallo. Gli elfi ci riescono usando solo fango e liane." —Gerrard della Cavalcavento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165154&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a747b57-2f72-4a6e-9fe4-10413bfd13d3\', \'multiverseId\': 165154}, \'multiverseid\': 165154}, {\'name\': \'ラノワールのビヒモス\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'876f2eb3-e0cd-4b65-9915-7ec806b269d2\'}, \'multiverseid\': None}, {\'name\': \'Behemoth de Llanowar\', \'text\': \'Vire um criatura desvirada que você controla: Behemoth de Llanowar recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Behemoth\', \'flavor\': \'"A maioria das pessoas não é capaz de fabricar armas decentes de pedra ou de aço. Pode ter certeza de que os elfos são capazes de fazê-lo, usando apenas barro e ramos de trepadeiras." — Gerrard do Bons Ventos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165868&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f10ed63-14d0-4a81-8020-e4e4e4002a8c\', \'multiverseId\': 165868}, \'multiverseid\': 165868}]', '[{\'name\': \'Luftelementar\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Du kannst nur hoffen, dass du es nicht aus Versehen einatmest.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162672&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'297f58dd-1e6b-489a-b1cd-3098d5480f66\', \'multiverseId\': 162672}, \'multiverseid\': 162672}, {\'name\': \'Elemental de aire\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Ruega porque no busque la seguridad de tus pulmones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165309&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06cdd3d2-0d53-43af-89e0-f6a20902e713\', \'multiverseId\': 165309}, \'multiverseid\': 165309}, {\'name\': "Élémental d\'air", \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : élémental\', \'flavor\': "Priez pour qu\'il ne trouve pas refuge dans vos poumons.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163029&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b5882837-5814-471f-8c2f-89449256b7f8\', \'multiverseId\': 163029}, \'multiverseid\': 163029}, {\'name\': "Elementale dell\'Aria", \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Elementale\', \'flavor\': \'Prega che non cerchi la protezione dei tuoi polmoni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164952&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c401232-e794-4e4f-a458-90e6ad72927f\', \'multiverseId\': 164952}, \'multiverseid\': 164952}, {\'name\': \'大気の精霊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a6598329-9234-46d2-a8b4-265a42d5c003\'}, \'multiverseid\': None}, {\'name\': \'Elemental do Ar\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Reza para que ele não busque a segurança dos teus pulmões.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165666&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24b17e19-230f-4abd-9cca-8cdce8493f06\', \'multiverseId\': 165666}, \'multiverseid\': 165666}]', '[{\'name\': \'Luftmauer\', \'text\': \'(Mauern können nicht angreifen.)\\nFliegend (Diese Kreatur kann fliegende Kreaturen blocken.)\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'Hüte dich vor dem Himmel, wenn keine Falken fliegen. —Redewendung der Femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162726&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f9718fc7-85a2-4c79-82b4-daa7f9925ab2\', \'multiverseId\': 162726}, \'multiverseid\': 162726}, {\'name\': \'Muro de aire\', \'text\': \'(Los Muros no pueden atacar.)\\nVuela. (Esta criatura puede bloquear criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Muro\', \'flavor\': \'Cuando los halcones no vuelan, cuidado con el cielo. —Aforismo femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165363&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'089b4969-70bb-414c-a60b-db779cffb554\', \'multiverseId\': 165363}, \'multiverseid\': 165363}, {\'name\': "Mur d\'air", \'text\': \'(Les murs ne peuvent pas attaquer.)Vol\\n(Cette créature peut bloquer les créatures avec le vol.)\', \'type\': \'Créature : mur\', \'flavor\': "Ciel vide de faucons, danger à l\'horizon. —Aphorisme femeref", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163083&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a26f3c26-d7dc-43b2-b76b-ee1dd3f20195\', \'multiverseId\': 163083}, \'multiverseid\': 163083}, {\'name\': "Muro d\'Aria", \'text\': \'(I Muri non possono attaccare.)Volare\\n(questa creatura può bloccare creature con volare).\', \'type\': \'Creatura — Muro\', \'flavor\': \'Quando non volano i falchi, abbi timore del cielo. —aforisma femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165006&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fd394e66-773e-4c3d-8797-f33ed5e592e0\', \'multiverseId\': 165006}, \'multiverseid\': 165006}, {\'name\': \'大気の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b322acab-ce0c-446b-a93b-c737bc49e347\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Ar\', \'text\': \'(As Barreiras não podem atacar.)Voar\\n(Esta criatura pode bloquear criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Barreira\', \'flavor\': \'Quando falcões não estão a voar, cuidado com o céu deves tomar. — Aforisma de Femeref\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165720&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e326b396-ff08-47b4-8b4b-459931ef8cad\', \'multiverseId\': 165720}, \'multiverseid\': 165720}]', '[{\'name\': \'Macht der Eichen\', \'text\': \'Eine Kreatur deiner Wahl erhält +7/+7 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Rat mal, wo ich das hinpflanzen werde"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162878&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a901814-8235-473f-81ef-b7b7f581368d\', \'multiverseId\': 162878}, \'multiverseid\': 162878}, {\'name\': \'Poder de los robles\', \'text\': \'La criatura objetivo obtiene +7/+7 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Adivina dónde voy a plantar esto"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165515&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0080e559-c196-45b5-af23-5b50f09497f7\', \'multiverseId\': 165515}, \'multiverseid\': 165515}, {\'name\': \'Puissance des chênaies\', \'text\': "La créature ciblée gagne +7/+7 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Oh Oh Oh Il est vraiment des chênaies. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163235&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ea5ad75-a87a-456e-bb39-5656298457e9\', \'multiverseId\': 163235}, \'multiverseid\': 163235}, {\'name\': \'Forza delle Querce\', \'text\': \'La creatura bersaglio prende +7/+7 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Indovina dove pianterò questo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165158&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79bcc29e-0c4a-494e-bc8b-e2e16f9b8a06\', \'multiverseId\': 165158}, \'multiverseid\': 165158}, {\'name\': \'樫の力\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c037238-003a-44a7-bccb-d860c5a208bb\'}, \'multiverseid\': None}, {\'name\': \'Força dos Carvalhos\', \'text\': \'A criatura alvo recebe +7/+7 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Adivinha onde vou plantar este"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165872&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'051680ed-cabe-4244-9d83-c107e4cce19f\', \'multiverseId\': 165872}, \'multiverseid\': 165872}]', '[{\'name\': \'Madenwirt\', \'text\': \'Wenn der Madenwirt ins Spiel kommt, verliert jeder Spieler 1 Lebenspunkt.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'„Wir begegnen dem Tod nicht plötzlich, sondern bewegen uns langsam auf ihn zu; wir sterben an jedem Tag." —Seneca, Episteln\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162755&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29d8e7b8-0bd2-4352-8a2e-031870deca5d\', \'multiverseId\': 162755}, \'multiverseid\': 162755}, {\'name\': \'Portador de larvas\', \'text\': \'Cuando el Portador de larvas entre en juego, cada jugador pierde 1 vida.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'"No llegamos a la muerte repentinamente, sino que nos acercamos a ella poco a poco; morimos cada día". —Seneca, Epistles\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165392&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26d7c63c-c1e2-4bce-8f3e-0c5863f278a5\', \'multiverseId\': 165392}, \'multiverseid\': 165392}, {\'name\': \'Propagateur de vermine\', \'text\': \'Quand le Propagateur de vermine arrive en jeu, chaque joueur perd 1 point de vie.\', \'type\': \'Créature : zombie\', \'flavor\': "« En outre, si la vie la plus longue n\'est pas toujours la meilleure, la mort qui se prolonge est toujours la pire. » —Sénèque", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163112&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6fe68107-498d-4891-9cad-2626d47ace20\', \'multiverseId\': 163112}, \'multiverseid\': 163112}, {\'name\': \'Portatore di Larve\', \'text\': \'Quando il Portatore di Larve entra in gioco, ogni giocatore perde 1 punto vita.\', \'type\': \'Creatura — Zombie\', \'flavor\': \'"Non cadiamo morti all\\\'improvviso, ma avanziamo verso la fine a piccoli passi; muoriamo un po\\\' ogni giorno". —Seneca, Epistole\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9be793d1-1c79-4f8b-8ac3-2378987fc6c7\', \'multiverseId\': 165035}, \'multiverseid\': 165035}, {\'name\': \'蛆たかり\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6a8af447-a960-42f7-aaf9-5f11c19c1551\'}, \'multiverseid\': None}, {\'name\': \'Portadores de Vermes\', \'text\': \'Quando Portadores de Vermes entra em jogo, cada jogador perde 1 ponto de vida.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'"Não caímos mortos de repente. Caminhamos para a morte passo a passo; nós morremos um pouco a cada dia." —Sêneca, Epístolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165749&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f3b2df1-bb76-413f-b902-ff604d628fab\', \'multiverseId\': 165749}, \'multiverseid\': 165749}]', '[{\'name\': \'Mahamoti-Dschinn\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Dschinn\', \'flavor\': \'Als König der Geister der Lüfte reitet der Mahamoti-Dschinn auf den Flügeln der Winde. Im Kampf und im Spiel ist er ein gefährlicher Gegner, und zudem ein Meister der Täuschung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162701&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55e42e7b-26ee-471a-a82c-59ac17b291c9\', \'multiverseId\': 162701}, \'multiverseid\': 162701}, {\'name\': \'Djinn Mahamoti\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Djinn\', \'flavor\': \'De sangre real entre los espíritus del aire, el djinn Mahamoti cabalga sobre las alas de los vientos. Es tan peligroso en el salón de juego como en batalla, y es un maestro del engaño y la información errónea.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165338&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'89525ebd-9bff-4e13-8737-cd7ceab52e98\', \'multiverseId\': 165338}, \'multiverseid\': 165338}, {\'name\': \'Djinn mahâmot\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : djinn\', \'flavor\': "Noble d\'entre les plus nobles esprits de l\'air, le djinn mahâmot voyage sur les ailes du vent. Maître de la ruse et du mensonge, il est aussi redoutable au jeu que sur le champ de bataille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163058&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1fb3d51e-774f-4262-ad9a-ae46a5ba0480\', \'multiverseId\': 163058}, \'multiverseid\': 163058}, {\'name\': \'Genio Mahamoti\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Genio\', \'flavor\': "Di sangue nobile tra gli spiriti dell\'aria, il genio Mahamoti cavalca sulle ali del vento. Pericoloso nelle sale da gioco come in battaglia, è un maestro degli inganni e delle truffe.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164981&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'db04f08e-0f8d-4234-b7a6-a199ae6c1578\', \'multiverseId\': 164981}, \'multiverseid\': 164981}, {\'name\': \'マハモティ・ジン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e72d08d-e6d7-4951-b95b-3cfc15e19874\'}, \'multiverseid\': None}, {\'name\': \'Gênio Mahamoti\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Gênio\', \'flavor\': \'Sangue real entre os espíritos do ar, o gênio Mahamoti cavalga nas asas dos ventos. Tão perigoso nos salões de jogos como na batalha, ele é um mestre dos truques e engodos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165695&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6c98bc0-8ab4-410a-a1e9-24a5bdbfa701\', \'multiverseId\': 165695}, \'multiverseid\': 165695}]', '[{\'name\': \'Manakollision\', \'text\': \'Ein Gegner deiner Wahl und du werfen beide eine Münze. Manakollision fügt jedem Spieler, dessen Münze „Zahl" zeigt, 1 Schadenspunkt zu. Wiederholt diesen Prozess, bis beide Münzen im selben Wurf „Kopf" zeigen.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162815&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'578d7589-78c6-4d99-821f-64608c1dbe10\', \'multiverseId\': 162815}, \'multiverseid\': 162815}, {\'name\': \'Choque de maná\', \'text\': \'Tanto tú como el oponente objetivo lanzan una moneda al aire. El Choque de maná hace 1 punto de daño a cada jugador que haya sacado cruz. Se repite este proceso hasta que ambos jugadores sacan cara en el mismo lanzamiento.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165452&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a9a1be8-81da-4708-b92c-8a9ba4a13fbb\', \'multiverseId\': 165452}, \'multiverseid\': 165452}, {\'name\': \'Choc de mana\', \'text\': "Vous et l\'adversaire ciblé lancez chacun une pièce en l\'air. Le Choc de mana inflige 1 blessure à chaque joueur dont la pièce retombe sur pile. Répétez la procédure jusqu\'à ce que les deux pièces tombent sur face en même temps.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163172&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'75008597-a6ac-498b-8866-9f080960a012\', \'multiverseId\': 163172}, \'multiverseid\': 163172}, {\'name\': \'Contesa di Magia\', \'text\': "Tu e l\'avversario bersaglio lanciate una moneta ciascuno. La Contesa di Magia infligge 1 danno a ogni giocatore che ottiene croce. Ripeti il procedimento fino a quando entrambi i giocatori ottengono testa con lo stesso lancio.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165095&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'384a7875-d82d-41a3-a19a-f9f3df2b9f4d\', \'multiverseId\': 165095}, \'multiverseid\': 165095}, {\'name\': \'魔力激突\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dff2181b-21ef-4a64-a5af-1359f786ec78\'}, \'multiverseid\': None}, {\'name\': \'Duelo de Mana\', \'text\': \'Você e o oponente alvo lançam uma moeda. Duelo de Mana causa 1 ponto de dano a cada jogador que tirar coroa. Repita o processo até que as moedas dos dois jogadores dêem cara ao mesmo tempo.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'189e385c-5c99-45b1-8615-d01ff07cc7c1\', \'multiverseId\': 165809}, \'multiverseid\': 165809}]', '[{\'name\': \'Manaleck\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, falls sein Beherrscher nicht {3} bezahlt.\', \'type\': \'Spontanzauber\', \'flavor\': \'Viele Pläne scheitern an der Annahme, man wüsste mehr als der Gegner.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162702&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9dfa4043-4fff-4a15-9af7-b0a757b8379a\', \'multiverseId\': 162702}, \'multiverseid\': 162702}, {\'name\': \'Fuga de maná\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {3}.\', \'type\': \'Instantáneo\', \'flavor\': \'El error fatídico de todos los planes es la suposición de que sabemos más que nuestro enemigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165339&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3c18b9e0-19aa-4fc5-9221-f7f634c2dac5\', \'multiverseId\': 165339}, \'multiverseid\': 165339}, {\'name\': \'Fuite de mana\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paye {3}.\', \'type\': \'Éphémère\', \'flavor\': "C\'est toujours une erreur de croire que l\'on en sait plus que son ennemi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163059&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'75e18fed-b26b-40d2-a0c7-b37389582585\', \'multiverseId\': 163059}, \'multiverseid\': 163059}, {\'name\': \'Indebolimento Magico\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore spenda {3}.\', \'type\': \'Istantaneo\', \'flavor\': \'Il punto debole di qualsiasi piano è dare per scontato che tu ne sappia di più del tuo nemico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1284f4f9-0cdb-4120-a642-99ee070da6a0\', \'multiverseId\': 164982}, \'multiverseid\': 164982}, {\'name\': \'マナ漏出\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'46d3e1ab-820b-4622-806e-f49a5997ebbf\'}, \'multiverseid\': None}, {\'name\': \'Fuga de Mana\', \'text\': \'Anula a mágica alvo a menos que seu controlador pague {3}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A falha fatal em qualquer plano é a presunção de que você sabe mais do que o seu inimigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165696&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'179483fd-fdb5-42ea-a802-052725786590\', \'multiverseId\': 165696}, \'multiverseid\': 165696}]', '[{\'name\': \'Marionettenkönig\', \'text\': \'{U}, {T}: Tappe oder enttappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Zauberer\', \'flavor\': \'„Wenn man Leute dazu bringen will, das zu tun, was man von ihnen will, muss man ihnen das sagen, was sie gerne hören wollen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162707&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0d195ec-c0d3-4f54-9fbd-4d73365930c6\', \'multiverseId\': 162707}, \'multiverseid\': 162707}, {\'name\': \'Titiritero\', \'text\': \'{U}, {T}: Gira o endereza la criatura objetivo.\', \'type\': \'Criatura — Hechicero\', \'flavor\': \'"Hacer que la gente haga lo que quieres es meramente cuestión de decirles lo que quieren oír."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165344&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e6ef6cc-9ab5-4c21-89f4-22e97f7f23c3\', \'multiverseId\': 165344}, \'multiverseid\': 165344}, {\'name\': \'Sculpteur de marionnettes\', \'text\': \'{U}, {T} : Engagez ou dégagez la créature ciblée.\', \'type\': \'Créature : sorcier\', \'flavor\': "« Pour qu\'ils fassent ce que vous voulez, dites-leur ce qu\'ils veulent entendre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163064&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'17da33c6-4a7c-48a4-9a14-37196ab8fa85\', \'multiverseId\': 163064}, \'multiverseid\': 163064}, {\'name\': \'Burattinaio\', \'text\': \'{U}, {T}: TAPpa o STAPpa una creatura bersaglio.\', \'type\': \'Creatura — Mago\', \'flavor\': \'"Indurre le persone a fare quello che vuoi dipende semplicemente dal saper dire loro quello che vogliono sentire."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164987&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6aede4e5-3c1e-452f-b3fe-ede940c80729\', \'multiverseId\': 164987}, \'multiverseid\': 164987}, {\'name\': \'くぐつ師\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b7caf9d-4513-456d-a230-15a9835b6f55\'}, \'multiverseid\': None}, {\'name\': \'Titeriteiro\', \'text\': \'{U}, {T}: Vira ou desvira a criatura alvo.\', \'type\': \'Criatura — Mago\', \'flavor\': \'"Fazer com que as pessoas façam o que você quer é apenas uma questão de lhes dizer o que elas querem ouvir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165701&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba3cc9bb-78b6-4fc4-960f-57c7390034f2\', \'multiverseId\': 165701}, \'multiverseid\': 165701}]', '[{\'name\': \'Marit Lages Zorn\', \'text\': \'Wenn Marit Lages Zorn ins Spiel kommt, tappe alle roten Kreaturen.\\nRote Kreaturen enttappen nicht während der Enttappsegmente ihrer Besitzer.\', \'type\': \'Verzauberung\', \'flavor\': \'„Marit Lage liegt eingefroren im Kern des Gletschers. Doch ihre Träume nehmen in unserer Welt Gestalt an und stehlen die Wärme aus unseren Herzen." —Halvor Arenson, Kjeldoranischer Priester\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f739af66-bfca-438e-bd6e-fcb24356a73e\', \'multiverseId\': 162728}, \'multiverseid\': 162728}, {\'name\': \'Ira de Marit Lage\', \'text\': \'Cuando la Ira de Marit Lage entre en juego, gira todas las criaturas rojas.\\nLas criaturas rojas no se enderezan durante los pasos de enderezar de sus controladores.\', \'type\': \'Encantamiento\', \'flavor\': \'"Marit Lage yace congelada en el corazón de un glaciar. Aun así, sus sueños toman forma en nuestro mundo, robando el calor de nuestras almas". —Halvor Arenson, sacerdote kjeldorano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165365&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa0b7a11-39cf-477d-aeed-ce00f4852173\', \'multiverseId\': 165365}, \'multiverseid\': 165365}, {\'name\': \'Colère de Marit Lage\', \'text\': "Quand la Colère de Marit Lage arrive en jeu, engagez toutes les créatures rouges.\\nLes créatures rouges ne se dégagent pas pendant l\'étape de dégagement de leurs contrôleurs.", \'type\': \'Enchantement\', \'flavor\': "« Marit Lage repose, gelée au cœur d\'un glacier. Mais ses rêves prennent toujours forme dans notre monde, volant la chaleur de nos âmes. » —Halvor Arenson, prêtre du Kjeldor", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163085&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'48a867be-35ff-46fc-ac84-2ea14116edd3\', \'multiverseId\': 163085}, \'multiverseid\': 163085}, {\'name\': \'Ira di Marit Lage\', \'text\': "Quando l\'Ira di Marit Lage entra in gioco, TAPpa tutte le creature rosse.\\nLe creature rosse non STAPpano durante gli STAP dei loro controllori.", \'type\': \'Incantesimo\', \'flavor\': \'"Marit Lage giace ibernata nel cuore di un ghiacciaio. Ma i suoi sogni prendono ancora forma nel nostro mondo e rubano il calore dalle nostre anime". —Halvor Arenson, sacerdote di Kjeldor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165008&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ae246bbe-3ef0-486c-8524-a760468e5a59\', \'multiverseId\': 165008}, \'multiverseid\': 165008}, {\'name\': \'マリット・レイジの怒り\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2b323e9-340c-4bb8-b2a6-9fbaa8cbeac3\'}, \'multiverseid\': None}, {\'name\': \'Ira de Marit Lage\', \'text\': \'Quando Ira de Marit Lage entra em jogo, vire todas as criaturas vermelhas.\\nAs criaturas vermelhas não desviram durante as etapas de desvirar de seus controladores.\', \'type\': \'Encantamento\', \'flavor\': \'"Marit Lage jaz congelada no coração de uma geleira. Mas, mesmo assim, seus sonhos tomam forma em nosso mundo." — Halvor Arenson, sacerdote Kjeldorano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165722&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb1310a7-c1c0-4445-8338-0e95c953742a\', \'multiverseId\': 165722}, \'multiverseid\': 165722}]', "[{'name': 'Maro', 'text': 'Stärke und Widerstandskraft des Maro sind gleich der Anzahl der Karten auf deiner Hand.', 'type': 'Kreatur — Elementarwesen', 'flavor': 'Es haben noch keine zwei Leute denselben Maro gesehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162877&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e4b47938-4fce-480f-b020-350f99c391dd', 'multiverseId': 162877}, 'multiverseid': 162877}, {'name': 'Maro', 'text': 'Tanto la fuerza como la resistencia del Maro son iguales al número de cartas que haya en tu mano.', 'type': 'Criatura — Elemental', 'flavor': 'Un mismo maro no puede ser visto por dos seres.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165514&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ff62586f-57ab-42d6-a4ca-7fba5b38fd91', 'multiverseId': 165514}, 'multiverseid': 165514}, {'name': 'Maro', 'text': 'Le Maro a une force et une endurance chacune égale au nombre de cartes dans votre main.', 'type': 'Créature : élémental', 'flavor': 'Chacun voit un maro différent.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163234&type=card', 'language': 'French', 'identifiers': {'scryfallId': '58c009ba-1731-4c68-8141-709c724da844', 'multiverseId': 163234}, 'multiverseid': 163234}, {'name': 'Maro', 'text': 'La forza e la costituzione del Maro sono pari ciascuna al numero di carte che hai in mano.', 'type': 'Creatura — Elementale', 'flavor': 'Due persone non vedono mai lo stesso Maro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165157&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3958eaee-a6b9-4c03-96a1-b010ccac111d', 'multiverseId': 165157}, 'multiverseid': 165157}, {'name': 'マロー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f579d23b-5312-4af8-a575-780c975cff80'}, 'multiverseid': None}, {'name': 'Maro', 'text': 'O poder e a resistência de Maro são ambos iguais ao número de cards em sua mão.', 'type': 'Criatura — Elemental', 'flavor': 'Não se vê o mesmo Maro duas vezes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165871&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1c2cee05-4020-44b7-bbd3-3d5a1739444b', 'multiverseId': 165871}, 'multiverseid': 165871}]", '[{\'name\': \'Meisterbogenschützen\', \'text\': \'{T}: Die Meisterbogenschützen fügen einer angreifenden oder blockenden Kreatur deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Sie fiedern ihre Pfeile mit den Federn von Engeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5e94561-2fe4-4434-badb-ad9953a71062\', \'multiverseId\': 162631}, \'multiverseid\': 162631}, {\'name\': \'Arqueros de élite\', \'text\': \'{T}: Los Arqueros de élite hacen 3 puntos de daño a la criatura objetivo atacante o bloqueadora.\', \'type\': \'Criatura — Soldado\', \'flavor\': \'Empluman sus flechas con plumas de ángeles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165268&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eefa9dd8-e21b-468d-92e1-e5522e14d87e\', \'multiverseId\': 165268}, \'multiverseid\': 165268}, {\'name\': "Archers d\'élite", \'text\': "{T} : Ces Archers d\'élite infligent 3 blessures à la créature attaquante ou bloqueuse ciblée.", \'type\': \'Créature : soldat\', \'flavor\': "Ils empennent leurs flèches de plumes d\'anges.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162988&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bae7ba0a-e405-4691-b003-3550ed8ec9a7\', \'multiverseId\': 162988}, \'multiverseid\': 162988}, {\'name\': "Arcieri d\'Elite", \'text\': "{T}: Gli Arcieri d\'Elite infliggono 3 danni a una creatura bersaglio che sta attaccando o bloccando.", \'type\': \'Creatura — Soldato\', \'flavor\': \'Impennano le proprie frecce con le piume degli angeli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164911&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da3b18d2-36ac-4553-8053-31bd42af89e8\', \'multiverseId\': 164911}, \'multiverseid\': 164911}, {\'name\': \'精鋭なる射手\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5fa6eaa6-1c81-43e1-88ae-ca5390679a8e\'}, \'multiverseid\': None}, {\'name\': \'Arqueiros de Elite\', \'text\': \'{T}: Arqueiros de Elite causa 3 pontos de dano à criatura alvo atacante ou bloqueadora.\', \'type\': \'Criatura — Soldado\', \'flavor\': \'Eles guarnecem suas flechas com penas de anjos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165625&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'614415c8-bbb1-4956-965f-e3323888b433\', \'multiverseId\': 165625}, \'multiverseid\': 165625}]', '[{\'name\': \'Meisterhafter Köder\', \'text\': \'{W}, {T}: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Ein erfahrener Köder kann deine Feinde von ihrem Pfad abbringen. Ein meisterhafter Köder kann überleben, um es noch mal zu tun.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'68689bf8-e1ab-4785-88ee-00ae4cec7ffb\', \'multiverseId\': 162642}, \'multiverseid\': 162642}, {\'name\': \'Maestro en señuelos\', \'text\': \'{W}, {T}: Gira la criatura objetivo.\', \'type\': \'Criatura — Soldado\', \'flavor\': \'Un señuelo hábil puede hacer que tus enemigos dejen de seguirte el rastro. Un señuelo experto puede sobrevivir para volver a hacerlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165279&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cad4e7a0-e6a5-47de-a7e7-9ad474da32c6\', \'multiverseId\': 165279}, \'multiverseid\': 165279}, {\'name\': \'Maître leurreur\', \'text\': \'{W}, {T} : Engagez la créature ciblée.\', \'type\': \'Créature : soldat\', \'flavor\': \'Un leurreur expérimenté peut faire perdre votre trace à vos adversaires. Un maître leurreur peut survivre et recommencer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162999&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd4b16fd-dd65-4faa-b64a-a4f451148f18\', \'multiverseId\': 162999}, \'multiverseid\': 162999}, {\'name\': "Maestro d\'Astuzia", \'text\': \'{W}, {T}: TAPpa una creatura bersaglio.\', \'type\': \'Creatura — Soldato\', \'flavor\': "Un bravo adescatore può sviare i nemici dalle tue tracce. Un maestro d\'astuzia riesce a sopravvivere per farlo ancora.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164922&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a81ca1a7-2688-487c-a6a8-457013b283e2\', \'multiverseId\': 164922}, \'multiverseid\': 164922}, {\'name\': \'おとりの達人\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d85efa7b-eef2-4c35-baaf-049ebe249c16\'}, \'multiverseid\': None}, {\'name\': \'Chamariz Magistral\', \'text\': \'{W}, {T}: Vira a criatura alvo.\', \'type\': \'Criatura — Soldado\', \'flavor\': \'Um chamariz habilidoso é capaz de afastar teus inimigos de teu caminho. Um chamariz magistral é capaz de sobreviver para repetir a façanha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165636&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3b56c45d-69fa-4769-835a-e3fd4d11068e\', \'multiverseId\': 165636}, \'multiverseid\': 165636}]', '[{\'name\': \'Meisterheiler\', \'text\': \'{T}: Verhindere die nächsten 4 Schadenspunkte, die in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt würden.\', \'type\': \'Kreatur — Kleriker\', \'flavor\': \'Ihr Herz enthält die Angst jedes Soldaten, den sie je geheilt hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162643&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'288062fc-1f68-4e88-a3d5-83609dce3962\', \'multiverseId\': 162643}, \'multiverseid\': 162643}, {\'name\': \'Sanador experto\', \'text\': \'{T}: Prevén los siguientes 4 puntos de daño que se le fueran a hacer a la criatura o jugador objetivo este turno.\', \'type\': \'Criatura — Clérigo\', \'flavor\': \'Su corazón guarda el dolor de cada soldado a quien ha sanado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165280&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c766f105-6c4b-4c78-a43a-d395d895c842\', \'multiverseId\': 165280}, \'multiverseid\': 165280}, {\'name\': \'Maître guérisseur\', \'text\': \'{T} : Prévenez, ce tour-ci, les prochaines 4 blessures qui devrait être infligées à une cible, créature ou joueur.\', \'type\': \'Créature : clerc\', \'flavor\': "Son cœur contient les souffrances de tous les soldats qu\'elle a soignés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163000&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dfd7b40e-0771-4b72-9f11-76ff7b9d0fed\', \'multiverseId\': 163000}, \'multiverseid\': 163000}, {\'name\': \'Mastro Guaritore\', \'text\': \'{T}: Previeni i prossimi 4 danni che verrebbero inflitti a una creatura o a un giocatore bersaglio in questo turno.\', \'type\': \'Creatura — Chierico\', \'flavor\': \'Il suo cuore conserva il dolore di ogni soldato che ha curato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164923&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e96a86ea-c749-46ac-958f-26e787a50bbb\', \'multiverseId\': 164923}, \'multiverseid\': 164923}, {\'name\': \'練達の癒し手\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4c4b71f-bf92-456d-a6e7-0a89f196d9fc\'}, \'multiverseid\': None}, {\'name\': \'Mestre Curandeiro\', \'text\': \'{T}: Previne os próximos 4 pontos de dano que seriam causados à criatura ou ao jogador alvo neste turno.\', \'type\': \'Criatura — Clérigo\', \'flavor\': \'O seu coração carrega a dor de cada soldado que já curou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165637&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87bde481-fc27-42fb-8851-38d8a234e083\', \'multiverseId\': 165637}, \'multiverseid\': 165637}]', '[{\'name\': \'Meistermeuchler\', \'text\': \'{T}: Zerstöre eine getappte Kreatur deiner Wahl.\', \'type\': \'Kreatur — Assassine\', \'flavor\': \'In den Künsten der Verschwörung wohl ausgebildet, wählen die Meistermeuchler ihre Opfer sorgfältig. Sie verlassen sich lieber auf den rechten Zeitpunkt und Präzision als auf rohe Gewalt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162772&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2958f67f-aa65-44c4-a5ca-eb947af4bf93\', \'multiverseId\': 162772}, \'multiverseid\': 162772}, {\'name\': \'Asesino real\', \'text\': \'{T}: Destruye la criatura objetivo girada.\', \'type\': \'Criatura — Asesino\', \'flavor\': \'Entrenados en las artes del sigilo, los asesinos reales eligen a sus víctimas cuidadosamente basándose en el momento indicado y la precisión, en vez de en la fuerza bruta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165409&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92151a55-ca61-41f6-a101-1d41abf7a764\', \'multiverseId\': 165409}, \'multiverseid\': 165409}, {\'name\': \'Assassin royal\', \'text\': \'{T} : Détruisez la créature engagée ciblée.\', \'type\': \'Créature : assassin\', \'flavor\': \'Entraînés aux arts furtifs, les assassins royaux choisissent tout particulièrement leurs victimes, préférant la préparation et la précision à la force brute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163129&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e600c047-8b2e-458a-b676-b5ade334a7a0\', \'multiverseId\': 163129}, \'multiverseid\': 163129}, {\'name\': \'Assassino Reale\', \'text\': \'{T}: Distruggi una creatura TAPpata bersaglio.\', \'type\': \'Creatura — Assassino\', \'flavor\': "Addestrati nell\'arte del sotterfugio, gli assassini reali scelgono le loro vittime con cura e si affidano al tempismo e alla precisione piuttosto che alla forza bruta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0d7dfea-d18d-4030-ac8d-800c09d75691\', \'multiverseId\': 165052}, \'multiverseid\': 165052}, {\'name\': \'凄腕の暗殺者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f798f0e2-d612-4705-873d-e9f328d52f8f\'}, \'multiverseid\': None}, {\'name\': \'Assassino da Realeza\', \'text\': \'{T}: Destrói a criatura alvo virada.\', \'type\': \'Criatura — Assassino\', \'flavor\': \'Treinados nas artes da furtividade, os assassinos da realeza escolhem suas vítimas com cuidado, contando mais com o senso de oportunidade e a precisão do que com a força bruta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165766&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad100ac7-2b97-4bc5-b52d-e11d7af5bdb0\', \'multiverseId\': 165766}, \'multiverseid\': 165766}]', '[{\'name\': \'Messingherold\', \'text\': \'Bestimme einen Kreaturentyp, sowie der Messingherold ins Spiel kommt.\\nWenn der Messingherold ins Spiel kommt, decke die vier obersten Karten deiner Bibliothek auf. Nimm alle Kreaturkarten des bestimmten Typs, die auf diese Weise aufgedeckt wurden, auf deine Hand und lege den Rest der Karten in beliebiger Reihenfolge unter deine Bibliothek.\\nAlle Kreaturen des bestimmten Typs erhalten +1/+1.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162906&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ef3ca969-bb18-436a-ae70-38069aad35fb\', \'multiverseId\': 162906}, \'multiverseid\': 162906}, {\'name\': \'Heraldo de bronce\', \'text\': \'En cuanto el Heraldo de bronce entre en juego, elige una tipo de criatura.\\nCuando el Heraldo de bronce entre en juego, muestra las primeras cuatro cartas de la parte superior de tu biblioteca. Pon todas las cartas de criatura del tipo elegido mostradas de esta manera en tu mano y el resto en la parte inferior de tu biblioteca en cualquier orden.\\nLas criaturas del tipo elegido obtienen +1/+1.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165543&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ffecd6eb-e517-47a9-97df-d85e1970d08a\', \'multiverseId\': 165543}, \'multiverseid\': 165543}, {\'name\': "Héraut d\'airain", \'text\': "Au moment où le Héraut d\'airain arrive en jeu, choisissez un type de créature.\\nQuand le Héraut d\'airain arrive en jeu, révélez les quatre cartes du dessus de votre bibliothèque. Mettez toutes les cartes de créature du type choisi et révélées de cette manière dans votre main et le reste au-dessous de votre bibliothèque dans n\'importe quel ordre.\\nLes créatures du type choisi gagnent +1/+1.", \'type\': \'Créature-artefact : golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163263&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'216b1b40-ac49-42b2-866f-612692f3389e\', \'multiverseId\': 163263}, \'multiverseid\': 163263}, {\'name\': \'Araldo di Ottone\', \'text\': "Mentre l\'Araldo di Ottone entra in gioco, scegli un tipo di creatura.\\nQuando l\'Araldo di Ottone entra in gioco, rivela le prime quattro carte del tuo grimorio. Aggiungi alla tua mano tutte le carte creatura del tipo scelto rivelate in questo modo e metti le rimanenti in fondo al tuo grimorio nell\'ordine che preferisci.\\nLe creature del tipo scelto prendono +1/+1.", \'type\': \'Creatura Artefatto — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165186&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'21a1d7d5-7be6-41df-a0d5-fea64365ad13\', \'multiverseId\': 165186}, \'multiverseid\': 165186}, {\'name\': \'真鍮の伝令\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d0f02f12-aefd-4765-8b68-0905525bf92e\'}, \'multiverseid\': None}, {\'name\': \'Arauto de Bronze\', \'text\': \'Conforme Arauto de Bronze entra em jogo, escolha um tipo de criatura.Quando Arauto de Bronze entra em jogo, revele os quatro cards do topo de seu grimório.\\n Coloque em sua mão todos os cards de criatura do tipo escolhido que forem revelados desta maneira e coloque o resto no fundo de seu grimório em qualquer ordem.\\nAs criaturas do tipo escolhido recebem +1/+1.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165900&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'868c02ac-c147-40fb-9650-38e8361d9aa8\', \'multiverseId\': 165900}, \'multiverseid\': 165900}]', '[{\'name\': \'Messingstadt\', \'text\': \'Immer wenn die Messingstadt getappt wird, fügt sie dir 1 Schadenspunkt zu.\\n{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162935&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'12843b35-de76-4107-b7cc-356218aec837\', \'multiverseId\': 162935}, \'multiverseid\': 162935}, {\'name\': \'Ciudad de bronce\', \'text\': \'Siempre que la Ciudad de bronce sea girada, te hace 1 punto de daño.\\n{T}: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165572&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62b3926b-0123-412c-b0f1-4d0a892e92a4\', \'multiverseId\': 165572}, \'multiverseid\': 165572}, {\'name\': "Cité d\'airain", \'text\': "À chaque fois que la Cité d\'airain devient engagée, elle vous inflige 1 blessure.\\n{T} : Ajoutez un mana de la couleur de votre choix à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163292&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff0e13f4-839b-46cc-8119-22831577468b\', \'multiverseId\': 163292}, \'multiverseid\': 163292}, {\'name\': "Città d\'Ottone", \'text\': "Ogniqualvolta la Città d\'Ottone diventa TAPpata, ti infligge 1 danno.{T}: Aggiungi un mana di qualsiasi colore alla tua riserva.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165215&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c2379c9-8d6a-4a4d-927d-140c3439a982\', \'multiverseId\': 165215}, \'multiverseid\': 165215}, {\'name\': \'真鍮の都\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6c5d3de-52c1-4929-a79b-874552fd84a3\'}, \'multiverseid\': None}, {\'name\': \'Cidade de Bronze\', \'text\': \'Toda vez que Cidade de Bronze for virada, ela causa 1 ponto de dano a você.\\n{T}: Adiciona um mana de qualquer cor à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165929&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bbbb813b-316a-4334-b3b9-d90ed07da013\', \'multiverseId\': 165929}, \'multiverseid\': 165929}]', '[{\'name\': \'Mogg-Wachposten\', \'text\': \'Immer wenn ein Gegner einen Zauberspruch spielt, erhält der Mogg-Wachposten +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'Von klein auf von ihren Herrschern mit Magie gequält, kocht das Blut der Moggs schon, wenn sie nur Hexerei riechen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162816&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5775361-fafc-454d-a188-5c3e1f738bf9\', \'multiverseId\': 162816}, \'multiverseid\': 162816}, {\'name\': \'Centinela mogg\', \'text\': \'Siempre que un oponente juegue un hechizo, el Centinela mogg obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'Torturados con magia por sus amos, a los moggs los irrita el olor de la brujería.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165453&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85f393c7-92e5-4852-9546-550dd6c654b5\', \'multiverseId\': 165453}, \'multiverseid\': 165453}, {\'name\': \'Sentinelle mogg\', \'text\': "À chaque fois qu\'un adversaire joue un sort, la Sentinelle mogg gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin\', \'flavor\': "Torturés par la magie de leurs maîtres, les moggs s\'enivrent de l\'odeur de la sorcellerie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163173&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'91852d5f-952b-467a-9645-205c4a97eb74\', \'multiverseId\': 163173}, \'multiverseid\': 163173}, {\'name\': \'Sentinella Mogg\', \'text\': \'Ogniqualvolta un avversario gioca una magia, la Sentinella Mogg prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Goblin\', \'flavor\': \'Torturati con la magia dai loro padroni, i mogg si infuriano quando sentono odore di stregoneria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165096&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bcbc7035-4fb2-48d3-a6fc-60bf9494f602\', \'multiverseId\': 165096}, \'multiverseid\': 165096}, {\'name\': \'モグの歩哨\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a4be636-9c78-4844-ba36-78b9a246d021\'}, \'multiverseid\': None}, {\'name\': \'Sentinela Mogg\', \'text\': \'Toda vez que um oponente jogar uma mágica, Sentinela Mogg recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Goblin\', \'flavor\': \'Torturados por seus mestres com magia, os moggs se inflamam ao cheiro da feitiçaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c640f3fd-5bf4-4a2a-87d4-1876daa2eba8\', \'multiverseId\': 165810}, \'multiverseid\': 165810}]', '[{\'name\': \'Moosmonster\', \'type\': \'Kreatur — Monster\', \'flavor\': \'Eine unheimliche Stille ergriff nach der Schlacht den Wald. Was von den Verlierern übrig war, überzog sich mit einer dünnen grünlichen Schicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162880&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f48a59a-60e0-4586-b9f1-1471a14a7339\', \'multiverseId\': 162880}, \'multiverseid\': 162880}, {\'name\': \'Monstruo de musgo\', \'type\': \'Criatura — Monstruo\', \'flavor\': \'Después de la batalla, un silencio fantasmagórico se apoderó del bosque.Los restos de los perdedores estaban cubiertos ligeramente con polvo verde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165517&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d535f328-8664-4244-90ea-56f26c1bd950\', \'multiverseId\': 165517}, \'multiverseid\': 165517}, {\'name\': \'Monstre de mousse\', \'type\': \'Créature : monstre\', \'flavor\': "Après la bataille, le silence retomba sur la forêt. Les cadavres des perdants se couvrirent d\'une couche verdâtre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163237&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d1ea0cc-c589-4ec9-9175-36ea8ead0295\', \'multiverseId\': 163237}, \'multiverseid\': 163237}, {\'name\': \'Mostro di Muschio\', \'type\': \'Creatura — Mostro\', \'flavor\': \'Dopo la battaglia, un agghiacciante silenzio avvolse la foresta. I resti degli sconfitti erano coperti da una lieve polvere verde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165160&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d13559aa-371c-4612-9229-75ad4e5bc554\', \'multiverseId\': 165160}, \'multiverseid\': 165160}, {\'name\': \'苔の怪物\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5306fc4d-ad4b-473e-aba2-3ee38ff7410e\'}, \'multiverseid\': None}, {\'name\': \'Monstro de Limo\', \'type\': \'Criatura — Monstro\', \'flavor\': \'Depois da batalha, um silêncio lúgubre abateu-se sobre a floresta. Os restos dos vencidos ficaram levemente cobertos com poeira verde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165874&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'240c461d-f745-479c-a022-73c37afa8008\', \'multiverseId\': 165874}, \'multiverseid\': 165874}]', '[{\'name\': \'Mure\', \'text\': \'Mauern können angreifen, als ob sie keine Mauern wären.\', \'type\': \'Verzauberung\', \'flavor\': \'„Glaub es mir diese Wände haben mehr als nur Ohren." —Orkspion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d83d8df2-0a77-4a7c-a498-7274ea021c36\', \'multiverseId\': 162651}, \'multiverseid\': 162651}, {\'name\': \'Piedras animadas\', \'text\': \'Los Muros pueden atacar como si no fueran Muros.\', \'type\': \'Encantamiento\', \'flavor\': \'"Créeme, las paredes no solamente oyen". —Espía orco\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165288&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3852a86-9925-44ed-a4da-0bb3762d2225\', \'multiverseId\': 165288}, \'multiverseid\': 165288}, {\'name\': \'Pierres agressives\', \'text\': "Les murs peuvent attaquer comme s\'ils n\'étaient pas des murs.", \'type\': \'Enchantement\', \'flavor\': "« Croyez-moi, les murs n\'ont pas que des oreilles. » —Espion orque", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163008&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a06fe24-d7ea-4894-9111-4acc4232493d\', \'multiverseId\': 163008}, \'multiverseid\': 163008}, {\'name\': \'Pietre Rotolanti\', \'text\': \'I Muri possono attaccare come se non fossero Muri.\', \'type\': \'Incantesimo\', \'flavor\': \'"Fidati di me: i muri hanno ben altro che orecchie". —spia orchesca\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164931&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'012e5e3d-01fb-4f70-b889-8fe15f186c97\', \'multiverseId\': 164931}, \'multiverseid\': 164931}, {\'name\': \'ローリング・ストーンズ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e859d183-0787-4511-b35d-7ed5b2d1863a\'}, \'multiverseid\': None}, {\'name\': \'Pedras Rolantes\', \'text\': \'As Barreiras podem atacar como se não fossem Barreiras.\', \'type\': \'Encantamento\', \'flavor\': \'"Acredite no que eu digo as muralhas têm ouvidos e muito mais." — Orc espião\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165645&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f95eafb-4039-4349-8ae8-50fa76de748f\', \'multiverseId\': 165645}, \'multiverseid\': 165645}]', '[{\'name\': \'Mühlstein\', \'text\': \'{2}, {T}: Ein Spieler deiner Wahl legt die obersten beiden Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Artefakt\', \'flavor\': \'Das Geräusch des unablässigen Mahlens des Mühlsteins hat schon mehr als einen Magier in den Wahnsinn getrieben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162920&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'02cc205f-bd27-4936-9394-0addd77a4683\', \'multiverseId\': 162920}, \'multiverseid\': 162920}, {\'name\': \'Rueda de molino\', \'text\': \'{2}, {T}: El jugador objetivo pone las dos primeras cartas de su biblioteca en su cementerio .\', \'type\': \'Artefacto\', \'flavor\': \'Más de un mago se ha vuelto loco por el sonido de la rueda de molino triturando inexorablemente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165557&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'487fe659-2782-4ee6-b6fe-5182971f4f22\', \'multiverseId\': 165557}, \'multiverseid\': 165557}, {\'name\': \'Meule\', \'text\': \'{2}, {T} : Le joueur ciblé met dans son cimetière les deux cartes du dessus de sa bibliothèque.\', \'type\': \'Artefact\', \'flavor\': "Plus d\'un mage a été rendu fou par le bruit implacable de la meule, grinçant sans trêve ni repos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163277&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ecd94fec-566d-4971-8b9c-a749b8ccdccd\', \'multiverseId\': 163277}, \'multiverseid\': 163277}, {\'name\': \'Pietra da Macina Magica\', \'text\': \'{2}, {T}: Il giocatore bersaglio mette nel proprio cimitero le prime due carte del proprio grimorio.\', \'type\': \'Artefatto\', \'flavor\': \'Più di un mago è impazzito al suono della macina che pressa inesorabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165200&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'89271e67-9738-42f6-ac07-702c3ab83212\', \'multiverseId\': 165200}, \'multiverseid\': 165200}, {\'name\': \'石臼\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5b2bdaf6-ebad-40ce-98c8-7013fb4fc1f8\'}, \'multiverseid\': None}, {\'name\': \'Mó\', \'text\': \'{2}, {T}: O jogador alvo coloca os dois cards do topo de seu próprio grimório em seu próprio cemitério.\', \'type\': \'Artefato\', \'flavor\': \'Vários magos enlouqueceram com o incessante ranger da mó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165914&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'999811c2-84b0-4221-a5dc-4727789bb275\', \'multiverseId\': 165914}, \'multiverseid\': 165914}]', '[{\'name\': \'Nachtmahr\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nStärke und Widerstandskraft des Nachtmahrs sind gleich der Anzahl der Sümpfe, die du kontrollierst.\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': \'Der Donner seiner Hufe verwandelt Träume in Verzweiflung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162763&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bba83630-1aa3-45c1-8c02-3cd3192fa3ff\', \'multiverseId\': 162763}, \'multiverseid\': 162763}, {\'name\': \'Pesadilla\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)Tanto la fuerza como la resistencia de la Pesadilla son iguales al número de pantanos que controles.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': \'El estruendo de sus cascos pisa los sueños hasta convertirlos en desesperación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165400&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ce99897-8a77-4905-928e-082ac0ee9885\', \'multiverseId\': 165400}, \'multiverseid\': 165400}, {\'name\': \'Cheval de cauchemar\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nLe Cheval de cauchemar a une force et une endurance chacune égale au nombre de marais que vous contrôlez.\', \'type\': \'Créature : Cheval de cauchemar\', \'flavor\': \'« Cauchemars entrevus dans le sommeil sans bornes, Sirènes aux seins nus, mélusines, licornes (…) » —Victor Hugo, La Légende des siècles\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163120&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83776e97-e28b-41fb-9bdb-0fbb267dcbc3\', \'multiverseId\': 163120}, \'multiverseid\': 163120}, {\'name\': \'Incubo\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nLa forza e la costituzione dell\'Incubo sono pari ciascuna al numero di Paludi che controlli.", \'type\': \'Creatura — Incubo\', \'flavor\': \'Il rombo dei suoi zoccoli trasforma i sogni in disperazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165043&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9097bb38-db3d-482d-83af-93bfe8c3f74e\', \'multiverseId\': 165043}, \'multiverseid\': 165043}, {\'name\': \'夢魔\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26ee78ef-cee7-4dd6-b748-f0e311a6db0f\'}, \'multiverseid\': None}, {\'name\': \'Pesadelo\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nO poder e a resistência de Pesadelo são ambos iguais ao número de Pântanos que você controla.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': \'O ressoar de seus cascos leva os sonhos ao desespero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e24b4f2-729c-4c19-b74c-8de91411b36d\', \'multiverseId\': 165757}, \'multiverseid\': 165757}]', '[{\'name\': \'Nantuko-Jünger\', \'text\': \'{G}, {T}: Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Insekt, Druide\', \'flavor\': \'Unbeantwortete Gebete sind selber bereits Antworten. —Lehre der Nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162881&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b94e75fa-01cf-4a1c-9e61-b48297552a71\', \'multiverseId\': 162881}, \'multiverseid\': 162881}, {\'name\': \'Discípulo nantuko\', \'text\': \'{G}, {T}: La criatura objetivo obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Druida insecto\', \'flavor\': \'Las oraciones sin respuesta son respuestas en sí.—Enseñanza nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165518&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'54abf7ab-95c2-4c20-a94e-4ef33454e9b6\', \'multiverseId\': 165518}, \'multiverseid\': 165518}, {\'name\': \'Disciple nantuko\', \'text\': "{G}, {T} : La créature ciblée gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : insecte et druide\', \'flavor\': \'Les prières sans réponses sont leurs propres réponses. —Enseignement nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163238&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6e6f5f88-4181-4f8c-ba7e-fe8f52db2148\', \'multiverseId\': 163238}, \'multiverseid\': 163238}, {\'name\': \'Discepolo Nantuko\', \'text\': \'{G}, {T}: La creatura bersaglio prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Druido Insetto\', \'flavor\': \'Una preghiera senza risposta è di per sé una risposta. —Insegnamento nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165161&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bc6d988d-9a1b-4ccc-ad60-0974c144f4d3\', \'multiverseId\': 165161}, \'multiverseid\': 165161}, {\'name\': \'ナントゥーコの信奉者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'acc42597-0758-4f6c-9766-e848f9e6abfe\'}, \'multiverseid\': None}, {\'name\': \'Discípulo Nantuko\', \'text\': \'{G}, {T}: A criatura alvo recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Druida Inseto\', \'flavor\': \'Preces ignoradas são uma resposta por si só. — Ensinamento dos nantukos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165875&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'19027001-c120-41b5-9078-3bbe6144e1cd\', \'multiverseId\': 165875}, \'multiverseid\': 165875}]', '[{\'name\': \'Naturalisieren\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Alles in der Welt endet durch Zufall und Ermüdung." —Heinrich Heine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162883&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'796c37ce-1b72-42e3-915e-0255d30979d0\', \'multiverseId\': 162883}, \'multiverseid\': 162883}, {\'name\': \'Naturalizar\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Un toque de la naturaleza hace que todo el mundo sea afin". William Shakespeare, Troilo y Cresida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165520&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86213a7e-9153-4050-b382-3ae07f8abb83\', \'multiverseId\': 165520}, \'multiverseid\': 165520}, {\'name\': \'Naturalisation\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': \'« Peuples, sachez donc une fois que la Nature a voulu vous préserver de la Science, comme une mère arrache une arme dangereuse des mains de son enfant. » —Jean-Jacques Rousseau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163240&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40376687-e8e7-426e-b5c7-4ccdd57dd275\', \'multiverseId\': 163240}, \'multiverseid\': 163240}, {\'name\': \'Ritorno alla Natura\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Un tocco della natura rende il mondo intero affine". —William Shakespeare, Troilo e Cressida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165163&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34d1db57-3472-4a5a-9543-d72b389a6d47\', \'multiverseId\': 165163}, \'multiverseid\': 165163}, {\'name\': \'帰化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a862853-aa9c-4f53-9042-c69ec3ddceb4\'}, \'multiverseid\': None}, {\'name\': \'Naturalizar\', \'text\': \'Destrói o artefato alvo ou o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um toque da natureza torna o mundo inteiro afim." — William Shakespeare, Troilus e Cressida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165877&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0a3ec4f4-dad1-4b04-9f33-af24660d26f8\', \'multiverseId\': 165877}, \'multiverseid\': 165877}]', '[{\'name\': \'Natürliche Beziehung\', \'text\': \'Bis zum Ende des Zuges werden alle Länder zu 2/2 Kreaturen, die auch noch Länder sind.\', \'type\': \'Spontanzauber\', \'flavor\': \'Solange die Dryaden ein Teil des Waldes sind, ist der Wald ein Teil der Armee.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162882&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0897168-0adf-46db-bc71-eff60bf4123b\', \'multiverseId\': 162882}, \'multiverseid\': 162882}, {\'name\': \'Afinidad natural\', \'text\': \'Hasta el final del turno, todas las tierras son criaturas 2/2 que siguen siendo tierras.\', \'type\': \'Instantáneo\', \'flavor\': \'Mientras las dríadas sean parte del bosque, el bosque es parte del ejército.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165519&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92bf4c1f-45ef-4144-a323-ffecf0836213\', \'multiverseId\': 165519}, \'multiverseid\': 165519}, {\'name\': \'Affinité naturelle\', \'text\': "Jusqu\'à la fin du tour, tous les terrains deviennent des créatures 2/2 qui sont toujours des terrains.", \'type\': \'Éphémère\', \'flavor\': "Tant que les dryades sont dans la forêt, la forêt est partie intégrante de l\'armée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163239&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc8662d3-a9a5-4737-bb3f-98906b1aad8b\', \'multiverseId\': 163239}, \'multiverseid\': 163239}, {\'name\': \'Affinità Naturale\', \'text\': \'Fino alla fine del turno, tutte le terre diventano creature 2/2 che sono ancora terre.\', \'type\': \'Istantaneo\', \'flavor\': "Fintanto che le driadi sono parte della foresta, la foresta è parte dell\'esercito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165162&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2adf2889-6edb-4b55-914a-33f91b62cc91\', \'multiverseId\': 165162}, \'multiverseid\': 165162}, {\'name\': \'自然の類似\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2dc20569-e9c3-4477-a09b-bc229302d214\'}, \'multiverseid\': None}, {\'name\': \'Afinidade Natural\', \'text\': \'Até o final do turno, todos os terrenos tornam-se criaturas 2/2 que ainda são terrenos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Enquanto as dríades forem uma parte da floresta, a floresta será uma parte do exército.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2def9841-624d-463c-b295-5d433e46140c\', \'multiverseId\': 165876}, \'multiverseid\': 165876}]', '[{\'name\': \'Nekrataal\', \'text\': \'Erstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\\nWenn der Nekrataal ins Spiel kommt, zerstöre eine nichtschwarze Nichtartefaktkreatur deiner Wahl. Diese Kreatur kann nicht regeneriert werden.\', \'type\': \'Kreatur — Nekrataal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162762&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3b65e0f-4bc3-4d88-b81a-30c44582a398\', \'multiverseId\': 162762}, \'multiverseid\': 162762}, {\'name\': \'Nekrataal\', \'text\': \'Daña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\\nCuando el Nekrataal entre en juego, destruye la criatura objetivo que no sea artefacto y que no sea negra. Esa criatura no puede ser regenerada.\', \'type\': \'Criatura — Nekrataal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2db9787f-c7a2-4ad2-b5dd-55640b90ec30\', \'multiverseId\': 165399}, \'multiverseid\': 165399}, {\'name\': \'Nékrataal\', \'text\': "Initiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)\\nQuand le Nékrataal arrive en jeu, détruisez la créature non-artefact, non-noire ciblée. Cette créature ne peut pas être régénérée.", \'type\': \'Créature : Nékrataal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163119&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d649d362-49b6-4ec5-9c5d-01f5182613c8\', \'multiverseId\': 163119}, \'multiverseid\': 163119}, {\'name\': \'Nekrataal\', \'text\': \'Attacco improvviso (Questa creatura infligge il danno da combattimento prima delle creature senza attacco improvviso.)\\nQuando il Nekrataal entra in gioco, distruggi una creatura bersaglio non artefatto, non nera. Quella creatura non può essere rigenerata.\', \'type\': \'Creatura — Nekrataal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165042&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9aac5724-5b64-4cab-9a44-b7bb59b066ea\', \'multiverseId\': 165042}, \'multiverseid\': 165042}, {\'name\': \'ネクラタル\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8e84c4d8-b254-4da4-97a9-e69b79cdca03\'}, \'multiverseid\': None}, {\'name\': \'Nekrataal\', \'text\': \'Iniciativa (Esta criatura causa dano de combate antes de criaturas sem a habilidade de iniciativa.)\\nQuando Nekrataal entra em jogo, destrói a criatura alvo que não seja preta nem artefato. Aquela criatura não pode ser regenerada.\', \'type\': \'Criatura — Nekrataal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165756&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4496d7c0-23b9-4299-b3b0-a1e84b4fa26d\', \'multiverseId\': 165756}, \'multiverseid\': 165756}]', '[{\'name\': \'Neugier\', \'text\': \'Immer wenn die verzauberte Kreatur einem Gegner Schaden zufügt, kannst du eine Karte ziehen.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Kennst du dieses Geheimnis? Das eine, das dich in der Nacht schweißgebadet aufwachen lässt? Das eine, von dem du glaubst, dass es niemand sonst auf dieser Welt kennt? Na, rate mal..."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162685&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f9545646-31d8-404d-8e87-d5e18d4b524e\', \'multiverseId\': 162685}, \'multiverseid\': 162685}, {\'name\': \'Curiosidad\', \'text\': \'Siempre que la criatura encantada haga daño a un oponente, puedes robar una carta.\', \'type\': \'Encantar criatura\', \'flavor\': \'"¿Sabes ese secreto? ¿El que te hace despertar por la noche sudando frío? ¿El que crees que no sabe nadie más en el mundo? Pues, adivina".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165322&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cdf915c2-cbed-4294-b738-a2bcbbfd40dc\', \'multiverseId\': 165322}, \'multiverseid\': 165322}, {\'name\': \'Curiosité\', \'text\': "À chaque fois que la créature enchantée blesse l\'un de vos adversaires, vous pouvez piocher une carte.", \'type\': \'Enchanter : créature\', \'flavor\': "« Tu connais le secret ? Celui qui te réveille en pleine nuit, le dos couvert de sueur froide ? Celui que tu penses que personne d\'autre au monde ne connaît ? Devine quoi... »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163042&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7df8c973-88fa-4ba4-88b9-9cce8e7adac9\', \'multiverseId\': 163042}, \'multiverseid\': 163042}, {\'name\': \'Curiosità\', \'text\': \'Ogniqualvolta la creatura incantata infligge danno da combattimento a un avversario, puoi pescare una carta.\', \'type\': \'Incanta Creatura\', \'flavor\': \'"Hai presente quel segreto? Quello che ti fa svegliare tutto sudato in piena notte? Quello che pensi nessun\\\'altro conosca? Be\\\', indovina un po\\\'...\\\'"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164965&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eeda5f45-b36b-4b9e-a95f-d4b76dacf137\', \'multiverseId\': 164965}, \'multiverseid\': 164965}, {\'name\': \'好奇心\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc316c02-248f-471a-92d1-101ec6db5504\'}, \'multiverseid\': None}, {\'name\': \'Curiosidade\', \'text\': \'Toda vez que a criatura encantada causar dano de combate a um oponente, você pode comprar um card.\', \'type\': \'Encantar Criatura\', \'flavor\': \'"Sabes aquele segredo? Aquele que te faz acordar no meio da noite suando frio? Aquele que pensas que ninguém no mundo conhece? Pois bem, adivinha."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165679&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8204340a-46af-48a7-ba18-d746858e01a2\', \'multiverseId\': 165679}, \'multiverseid\': 165679}]', '[{\'name\': \'Norwaldläufer\', \'type\': \'Kreatur — Elf\', \'flavor\': \'Die Melodie des Waldes ist in perfekter Harmonie. Stimmt auch nur der leiseste Ton nicht, werden die Elfen die Ursache dafür finden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162884&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d2a1cc1-d763-4782-a6d8-25bccd7cb2b2\', \'multiverseId\': 162884}, \'multiverseid\': 162884}, {\'name\': \'Guardabosque de Norwood\', \'type\': \'Criatura — Elfo\', \'flavor\': \'La canción del bosque está en perfecta armonía. Si una sola nota está fuera de lugar, los elfos encontrarán su fuente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165521&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85946b71-258f-4057-a2e0-b45e2d3d44e0\', \'multiverseId\': 165521}, \'multiverseid\': 165521}, {\'name\': \'Ranger de Norbois\', \'type\': \'Créature : elfe\', \'flavor\': \'Le chant de la forêt est une parfaite harmonie, dans laquelle les elfes entendront la fausse note la plus discrète.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163241&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'093d4e90-ccf4-4fc7-bd33-6f1f9da933e0\', \'multiverseId\': 163241}, \'multiverseid\': 163241}, {\'name\': \'Ranger di Norwood\', \'type\': \'Creatura — Elfo\', \'flavor\': "La canzone della foresta è in perfetta armonia. Se ci dovesse essere una stonatura, gli elfi ne troverebbero l\'origine.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165164&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a39d1b27-d344-4566-b1f9-d097e17983a8\', \'multiverseId\': 165164}, \'multiverseid\': 165164}, {\'name\': \'ノーウッドのレインジャー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90d52ccd-d673-4b4f-a307-0be086cc2f10\'}, \'multiverseid\': None}, {\'name\': \'Patrulheiro de Norwood\', \'type\': \'Criatura — Elfo\', \'flavor\': \'A canção da floresta está em perfeita harmonia. Se uma única nota estiver fora do lugar, os elfos encontrarão sua fonte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165878&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'550ada36-75aa-4168-a216-0bc45c09eef8\', \'multiverseId\': 165878}, \'multiverseid\': 165878}]', '[{\'name\': \'Ogerscherge\', \'text\': \'Der Ogerscherge kann nicht blocken.\', \'type\': \'Kreatur — Oger\', \'flavor\': \'Oger lernen, wie man Sachen zerstört, sogar bevor sie lernen, wie man läuft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e794fa4-f20a-4114-b5a6-2bea392c38ba\', \'multiverseId\': 162818}, \'multiverseid\': 162818}, {\'name\': \'Capataz ogro\', \'text\': \'El Capataz ogro no puede bloquear.\', \'type\': \'Criatura — Ogro\', \'flavor\': \'Los ogros aprenden a destruir cosas incluso antes de aprender a caminar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165455&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e66e45b4-68e1-46c1-8025-9ecb1f39bcca\', \'multiverseId\': 165455}, \'multiverseid\': 165455}, {\'name\': \'Surveillant ogre\', \'text\': \'Le Surveillant ogre ne peut pas bloquer.\', \'type\': \'Créature : ogre\', \'flavor\': "Les ogres apprennent à frapper avant d\'apprendre à marcher.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'488abfaf-5f5d-4d6a-aaaf-3634b786e501\', \'multiverseId\': 163175}, \'multiverseid\': 163175}, {\'name\': \'Sorvegliante Ogre\', \'text\': \'Il Sorvegliante Ogre non può bloccare.\', \'type\': \'Creatura — Ogre\', \'flavor\': \'Gli ogre imparano a spaccare le cose ancora prima di imparare a camminare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165098&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba4f5b91-cac4-469c-9da6-41a25391834f\', \'multiverseId\': 165098}, \'multiverseid\': 165098}, {\'name\': \'オーガの監督官\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e82ee5cf-9bc3-4d65-8677-21dd81da23cf\'}, \'multiverseid\': None}, {\'name\': \'Capataz Ogre\', \'text\': \'Capataz Ogre não pode bloquear.\', \'type\': \'Criatura — Ogre\', \'flavor\': \'Os ogres aprendem a esmagar coisas antes mesmo de aprenderem a andar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165812&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99db17d4-4514-4bb5-a35d-f9d589eb81f0\', \'multiverseId\': 165812}, \'multiverseid\': 165812}]', '[{\'name\': \'Okk\', \'text\': \'Der Okk kann nur angreifen, wenn eine Kreatur mit größerer Stärke ebenfalls angreift.\\nDer Okk kann nur blocken, wenn eine Kreatur mit größerer Stärke ebenfalls blockt.\', \'type\': \'Kreatur — Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162819&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'671f08b8-0e35-46ef-8fc3-278e54778d42\', \'multiverseId\': 162819}, \'multiverseid\': 162819}, {\'name\': \'Okk\', \'text\': \'El Okk no puede atacar a menos que también ataque una criatura con mayor fuerza que él.\\nEl Okk no puede bloquear a menos que también bloquee una criatura con mayor fuerza que él.\', \'type\': \'Criatura — Trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165456&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8d7b5287-20ab-4e2d-a00b-9cb9482a550d\', \'multiverseId\': 165456}, \'multiverseid\': 165456}, {\'name\': \'Okk\', \'text\': "L\'Okk ne peut pas attaquer à moins qu\'une créature avec une force plus grande attaque également.\\nL\'Okk ne peut pas bloquer à moins qu\'une créature avec une force plus grande bloque également.", \'type\': \'Créature : gobelin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163176&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66e33fb4-3399-456a-99e7-65c9fef7d05f\', \'multiverseId\': 163176}, \'multiverseid\': 163176}, {\'name\': \'Okk\', \'text\': "L\'Okk non può attaccare a meno che attacchi anche una creatura con forza superiore alla sua.\\nL\'Okk non può bloccare a meno che blocchi anche una creatura con forza superiore alla sua.", \'type\': \'Creatura — Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39d1c043-1c07-4a33-bbb4-85b60781b737\', \'multiverseId\': 165099}, \'multiverseid\': 165099}, {\'name\': \'オック\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'28c56840-ed1a-4571-9a6b-2c0959969232\'}, \'multiverseid\': None}, {\'name\': \'Okk\', \'text\': \'Okk só pode atacar se outra criatura com poder maior também atacar.\\nOkk só pode bloquear se outra criatura com poder maior também bloquear.\', \'type\': \'Criatura — Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d18d7398-32cb-42ce-bd3e-ba3b05328d2d\', \'multiverseId\': 165813}, \'multiverseid\': 165813}]', '[{\'name\': \'Ork-Artillerie\', \'text\': \'{T}: Die Ork-Artillerie fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte und dir 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Ork\', \'flavor\': \'Da Orks weder mathematisch noch sozial veranlagt sind, konnte ihnen der Nachteil eigener Verluste nie erklärt werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162820&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2e80c72-a10a-47c8-9800-29fda4add9ea\', \'multiverseId\': 162820}, \'multiverseid\': 162820}, {\'name\': \'Artillería orca\', \'text\': \'{T}: La Artillería orca hace 2 puntos de daño a la criatura o jugador objetivo y 3 puntos de daño a ti.\', \'type\': \'Criatura — Orco\', \'flavor\': \'"¿Quieren matar a mis hombres? Pues dos pueden jugar ese juego." —General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165457&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e659fd1-b626-4976-b79f-789d47c488bf\', \'multiverseId\': 165457}, \'multiverseid\': 165457}, {\'name\': \'Artillerie orque\', \'text\': "{T} : L\'Artillerie orque inflige 2 blessures à une cible, créature ou joueur, et vous inflige 3 blessures.", \'type\': \'Créature : orque\', \'flavor\': \'« Alors ils veulent tuer mes hommes ? Eh bien on peut être deux pour jouer à ce jeu-là » —Général Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163177&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a24c000c-8084-40ae-adc9-acd46e580f81\', \'multiverseId\': 163177}, \'multiverseid\': 163177}, {\'name\': \'Artiglieria Orchesca\', \'text\': "{T}: L\'Artiglieria Orchesca infligge 2 danni a una creatura o a un giocatore bersaglio e 3 danni a te.", \'type\': \'Creatura — Orco\', \'flavor\': \'"Vogliono uccidere i miei uomini? Beh, questo è un gioco che si può fare in due." —Generale Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165100&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ca76fa8-61a2-423b-9bad-dc2ee203876c\', \'multiverseId\': 165100}, \'multiverseid\': 165100}, {\'name\': \'オーク弩弓隊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ab67fff-d565-405b-8937-98aec4c49791\'}, \'multiverseid\': None}, {\'name\': \'Artilharia Órquica\', \'text\': \'{T}: Artilharia Órquica causa 2 pontos de dano à criatura ou ao jogador alvo e 3 pontos de dano a você.\', \'type\': \'Criatura — Orc\', \'flavor\': \'"Então eles querem matar meus homens? Muito bem, então. Dois podem fazer esse jogo." — General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165814&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d880dbe3-9934-41e1-9388-6b875b9a344b\', \'multiverseId\': 165814}, \'multiverseid\': 165814}]', '[{\'name\': \'Orkspion\', \'text\': \'{T}: Schaue dir die obersten drei Karten der Bibliothek eines Spielers deiner Wahl an. (Lege sie in derselben Reihenfolge zurück.)\', \'type\': \'Kreatur — Ork\', \'flavor\': \'„Du Idiot Man darf nicht zulassen, dass Spione nach Erfüllung ihrer Mission mit den gemeinen Soldaten schwatzen. Jetzt wird es lange dauern, bis sie kämpfen wollen" —General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162821&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5ddf6da6-9ed3-4857-a7e5-929bf1781b79\', \'multiverseId\': 162821}, \'multiverseid\': 162821}, {\'name\': \'Espía orco\', \'text\': \'{T}: Miras las tres cartas de la parte superior de la biblioteca del jugador objetivo. (Regrésalas en el mismo orden.)\', \'type\': \'Criatura — Orco\', \'flavor\': \'"¡ldiota Nunca dejes que los espias se mezclen con los soldados orcos después de terminar una misión. ¡Ahora no lograremos hacer que combatan". —General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165458&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e6f3445d-6805-496b-afed-4dfca188f034\', \'multiverseId\': 165458}, \'multiverseid\': 165458}, {\'name\': \'Espion orque\', \'text\': \'{T} : Regardez les trois cartes du dessus de la bibliothèque du joueur ciblé. (Remettez-les dans le même ordre.)\', \'type\': \'Créature : orque\', \'flavor\': \'« Imbécile Ne laisse jamais les espions retrouver les autres orques après une mission. Qui va vouloir se battre, à présent ? » —Général Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163178&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fee553d9-8212-4446-b71b-81f501403ebd\', \'multiverseId\': 163178}, \'multiverseid\': 163178}, {\'name\': \'Spia Orchesca\', \'text\': \'{T}: Guarda le prime tre carte del grimorio di un giocatore bersaglio (rimettile a posto nello stesso ordine).\', \'type\': \'Creatura — Orco\', \'flavor\': \'"Idiota Non permette mai alle spie di mescolarsi agli orchi comuni dopo una missione. Adesso non riusciremo più a farli combattere". —Generale Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165101&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'034dd9c1-d9c2-417a-bc77-f1cbc183716e\', \'multiverseId\': 165101}, \'multiverseid\': 165101}, {\'name\': \'オークのスパイ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'143dc03a-8693-4339-9385-c1955ef33d2d\'}, \'multiverseid\': None}, {\'name\': \'Espião Orc\', \'text\': \'{T}: Olhe os três cards do topo do grimório do jogador alvo. (Coloque-os de volta em qualquer ordem.)\', \'type\': \'Criatura — Orc\', \'flavor\': \'"Seu idiota Nunca deixe que os espiões juntem-se aos soldados de linha orcs após completarem uma missão. Agora nunca conseguiremos fazer com que eles lutem" — General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'909b1336-c143-4091-a958-304815beb967\', \'multiverseId\': 165815}, \'multiverseid\': 165815}]', '[{\'name\': \'Paladin des Ostens\', \'text\': \'{B}{B}, {T}: Zerstöre eine grüne Kreatur deiner Wahl.\', \'type\': \'Kreatur — Ritter\', \'flavor\': \'„Es gibt keinen schlimmeren Gegner. Seine Leidenschaft für den Tod grenzt nicht bloß an den Wahnsinn, sie suhlt sich darin." —Paladin des Südens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c754e8b-d759-4b77-95ee-8ceeb1979aa9\', \'multiverseId\': 162744}, \'multiverseid\': 162744}, {\'name\': \'Paladín oriental\', \'text\': \'{B}{B}, {T}: Destruye la criatura objetivo verde.\', \'type\': \'Criatura — Caballero\', \'flavor\': \'"No hay peor enemigo. Su pasión por la muerte no sólo linda con la locura, nada en ella." —El Paladin del sur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165381&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5348dfa-2ab8-41a2-b4ef-8d0f6924af40\', \'multiverseId\': 165381}, \'multiverseid\': 165381}, {\'name\': "Paladin de l\'Est", \'text\': \'{B}{B}, {T} : Détruisez la créature verte ciblée.\', \'type\': \'Créature : chevalier\', \'flavor\': "« Il n\'y a pas pire ennemi. Il est fou de la mort, et la mort est folle de lui. » — Paladin du Sud", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163101&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcafbead-0b39-4bc3-a36a-b43c7c382d64\', \'multiverseId\': 163101}, \'multiverseid\': 163101}, {\'name\': \'Paladino Orientale\', \'text\': \'{B}{B}, {T}: Distruggi una creatura bersaglio verde.\', \'type\': \'Creatura — Cavaliere\', \'flavor\': \'"Non esiste nemico peggiore. La sua passione per la morte non è ai limiti della follia: ci è dentro in pieno". —paladino del sud\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165024&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f098064a-8675-4326-a355-8c675d136aaf\', \'multiverseId\': 165024}, \'multiverseid\': 165024}, {\'name\': \'東の聖騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a3ebf290-5357-4434-ab35-6d8666663ba6\'}, \'multiverseid\': None}, {\'name\': \'Paladino do Leste\', \'text\': \'{B}{B}, {T}: Destrói a criatura verde alvo.\', \'type\': \'Criatura — Cavaleiro\', \'flavor\': \'"Não há inimigo pior. Sua paixão pela morte não só beira a insanidade, como chafurda nela." — Paladino do Sul\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165738&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'adf2d203-3f1a-46cc-98c8-a5f0f6c38e54\', \'multiverseId\': 165738}, \'multiverseid\': 165738}]', '[{\'name\': \'Paladin des Westens\', \'text\': \'{B}{B}, {T}: Zerstöre eine weiße Kreatur deiner Wahl.\', \'type\': \'Kreatur — Ritter\', \'flavor\': \'„Erwarte nichts von ihm außer Hohn, Schmeichelei und Lügen. Und drehe ihm niemals den Rücken zu." —Paladin des Nordens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162786&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f3678f7-4c9d-4eaf-bc0f-0c48dfd5038b\', \'multiverseId\': 162786}, \'multiverseid\': 162786}, {\'name\': \'Paladín occidental\', \'text\': \'{B}{B}, {T}: Destruye la criatura objetivo blanca.\', \'type\': \'Criatura — Caballero\', \'flavor\': \'"No esperes nada excepto desprecio, adulación y mentiras. Y nunca le des la espalda." El Paladín del norte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165423&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d91d7d7b-8242-4aa5-b228-7b6bacd07dfc\', \'multiverseId\': 165423}, \'multiverseid\': 165423}, {\'name\': "Paladin de l\'Ouest", \'text\': \'{B}{B}, {T} : Détruisez la créature blanche ciblée.\', \'type\': \'Créature : chevalier\', \'flavor\': "« N\'attendez rien de lui si ce n\'est veulerie, flatterie et mensonges. Et ne lui tournez jamais le dos. » — Paladin du Nord", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163143&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7ecdc7d-2fa6-4404-bcf4-1d7741991d7c\', \'multiverseId\': 163143}, \'multiverseid\': 163143}, {\'name\': \'Paladino Occidentale\', \'text\': \'{B}{B}, {T}: Distruggi una creatura bersaglio bianca.\', \'type\': \'Creatura — Cavaliere\', \'flavor\': \'"Non aspettarti altro che disprezzo, adulazione e bugie. E non voltargli mai le spalle". —paladino del nord\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165066&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce180c89-6cc2-47e5-a16a-26ce99dab1ca\', \'multiverseId\': 165066}, \'multiverseid\': 165066}, {\'name\': \'西の聖騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'860e3587-0681-4a08-8693-d048e22f3ca0\'}, \'multiverseid\': None}, {\'name\': \'Paladino do Oeste\', \'text\': \'{B}{B}, {T}: Destrói a criatura branca alvo.\', \'type\': \'Criatura — Cavaleiro\', \'flavor\': \'"Não espere nada além de escárnio, lisonja e mentiras. E jamais lhe dê as costas". — Paladino do Norte\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165780&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'902cdecb-7c30-4a93-a89c-ef488c724784\', \'multiverseId\': 165780}, \'multiverseid\': 165780}]', "[{'name': 'Panikanfall', 'text': 'Bis zu drei Kreaturen deiner Wahl können in diesem Zug nicht blocken.', 'type': 'Hexerei', 'flavor': 'Manchmal passiert es, dass alle gleichzeitig Hilfe holen gehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162822&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aacdb782-1782-48b9-9609-7f2ad8fe183c', 'multiverseId': 162822}, 'multiverseid': 162822}, {'name': 'Ataque de pánico', 'text': 'Hasta tres criaturas objetivo no pueden bloquear este turno.', 'type': 'Conjuro', 'flavor': 'A veces todos deciden ir por ayuda al mismo tiempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165459&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5900ecfb-8a47-4c4b-b2bb-f819263325ba', 'multiverseId': 165459}, 'multiverseid': 165459}, {'name': 'Attaque paniquante', 'text': 'Un maximum de trois créatures ciblées ne peuvent pas bloquer ce tour-ci.', 'type': 'Rituel', 'flavor': 'Pas tous à la fois', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163179&type=card', 'language': 'French', 'identifiers': {'scryfallId': '431d629d-8cf4-44d8-be74-561705f4ea62', 'multiverseId': 163179}, 'multiverseid': 163179}, {'name': 'Attacco di Panico', 'text': 'Fino a tre creature bersaglio non possono bloccare in questo turno.', 'type': 'Stregoneria', 'flavor': 'A volte decidono tutti di andare a cercare aiuto nello stesso momento.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165102&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '979ab77b-fdb2-49e3-8a9c-62d7f9a5dcb8', 'multiverseId': 165102}, 'multiverseid': 165102}, {'name': '恐ろしき攻撃', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '39809da1-2e14-4a5c-9a92-803d30f7bd73'}, 'multiverseid': None}, {'name': 'Ataque de Pânico', 'text': 'Até três criaturas alvo não podem bloquear neste turno.', 'type': 'Feitiço', 'flavor': 'Às vezes, todo mundo resolve ir pedir ajuda ao mesmo tempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165816&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '825f2067-0ec8-4676-aa60-16584fae334d', 'multiverseId': 165816}, 'multiverseid': 165816}]", "[{'name': 'Paradiesvögel', 'text': 'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\n{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.', 'type': 'Kreatur — Vogel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162846&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e3131e10-5ac0-407b-b4ce-6975bf33d622', 'multiverseId': 162846}, 'multiverseid': 162846}, {'name': 'Aves del paraíso', 'text': 'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\n{T}: Agrega un maná de cualquier color a tu reserva de maná.', 'type': 'Criatura — Ave', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165483&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '477c0c5b-9df9-44cb-a116-a4e5f0d479f1', 'multiverseId': 165483}, 'multiverseid': 165483}, {'name': 'Oiseaux de paradis', 'text': 'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\n{T} : Ajoutez un mana de la couleur de votre choix à votre réserve.', 'type': 'Créature : oiseau', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163203&type=card', 'language': 'French', 'identifiers': {'scryfallId': '45cf80aa-8417-4e6c-a87b-5ea49d7bd74f', 'multiverseId': 163203}, 'multiverseid': 163203}, {'name': 'Uccelli del Paradiso', 'text': 'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.){T}: Aggiungi un mana di qualsiasi colore alla tua riserva.', 'type': 'Creatura — Uccello', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165126&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4b1c7de9-b8fc-4000-9cd4-ef834dec29c7', 'multiverseId': 165126}, 'multiverseid': 165126}, {'name': '極楽鳥', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'a9d953cc-f697-47c0-9e52-e2fec64c7406'}, 'multiverseid': None}, {'name': 'Aves do Paraíso', 'text': 'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\n{T}: Adiciona um mana de qualquer cor à sua reserva de mana.', 'type': 'Criatura — Ave', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165840&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa1dc789-a0c4-4a85-bb07-3a098178cb33', 'multiverseId': 165840}, 'multiverseid': 165840}]", '[{\'name\': \'Patagiagolem\', \'text\': \'{3}: Der Patagiagolem erhält Flugfähigkeit bis zum Ende des Zuges. (Sie kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Eigentlich waren seine Flügel nur als Zierde gedacht, aber er lernte schnell, sie auch zu nutzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162921&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47f80827-5889-470c-9236-4b097feb96ec\', \'multiverseId\': 162921}, \'multiverseid\': 162921}, {\'name\': \'Gólem membranoso\', \'text\': \'{3}: El Gólem membranoso gana la habilidad de volar hasta el final del turno. (No pueden ser bloqueados excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Sus alas sólo fueron diseñadas para ser ornamentales, pero aprendió a usarlas él solo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165558&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dfb3a350-a012-4727-94a6-81d3bce1bcdb\', \'multiverseId\': 165558}, \'multiverseid\': 165558}, {\'name\': \'Golem à patagia\', \'text\': "{3} : Le Golem à patagia acquiert le vol jusqu\'à la fin du tour. (Elle ne peut être bloquée que par des créatures avec le vol.)", \'type\': \'Créature-artefact : golem\', \'flavor\': "Ses ailes n\'étaient à l\'origine qu\'ornementales, mais il a appris à s\'en servir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163278&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ba015b1-8abf-4883-90e0-0c2aa28a2abf\', \'multiverseId\': 163278}, \'multiverseid\': 163278}, {\'name\': \'Golem Aliante\', \'text\': \'{3}: Il Golem Aliante guadagna volare fino alla fine del turno (Non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'Le sue ali sono state progettate per essere solo ornamentali, ma ha imparato a usarle per conto proprio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165201&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d902b9c-26da-4edb-8a0f-b75b2cb86893\', \'multiverseId\': 165201}, \'multiverseid\': 165201}, {\'name\': \'翼膜のゴーレム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a09269b2-c17d-4cef-ace8-df485eff9171\'}, \'multiverseid\': None}, {\'name\': \'Golem com Patágio\', \'text\': \'{3}: Golem com Patágio ganha a habilidade de voar até o final do turno. (Ela só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Suas asas foram projetadas para serem apenas ornamentais, mas ele aprendeu a usá-las sozinho.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165915&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c12f9b4f-6f9f-418e-9236-c6b94d3ab4bf\', \'multiverseId\': 165915}, \'multiverseid\': 165915}]', "[{'name': 'Pazifismus', 'text': 'Die verzauberte Kreatur kann nicht angreifen oder blocken.', 'type': 'Kreaturenverzauberung', 'flavor': 'Ein Friedlicher ist einer, der sich totschießen lässt, um zu beweisen, dass der andere der Aggressor gewesen ist.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162646&type=card', 'language': 'German', 'identifiers': {'scryfallId': '69b41e72-2e24-4a93-8426-1ee3b4c7f7ab', 'multiverseId': 162646}, 'multiverseid': 162646}, {'name': 'Pacifismo', 'text': 'La criatura encantada no puede atacar ni bloquear.', 'type': 'Encantar criatura', 'flavor': 'Por primera vez en su vida, Grakk sintió ternura en su interior.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165283&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8a607881-9ae6-4fd6-bf1f-89c7df41ac79', 'multiverseId': 165283}, 'multiverseid': 165283}, {'name': 'Pacifisme', 'text': 'La créature enchantée ne peut ni attaquer ni bloquer.', 'type': 'Enchanter : créature', 'flavor': 'Pour la première fois dans sa vie, Grakk sentit une douce chaleur se répandre en lui.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163003&type=card', 'language': 'French', 'identifiers': {'scryfallId': '79960d22-bb38-43b4-a08c-50f2c9405a8d', 'multiverseId': 163003}, 'multiverseid': 163003}, {'name': 'Pacifismo', 'text': 'La creatura incantata non può attaccare né bloccare.', 'type': 'Incanta Creatura', 'flavor': 'Per la prima volta nella propria vita, Grakk sentì una sensazione di calore e confusione dentro di sé.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164926&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1f79a6b9-ae3f-47a4-930e-08b2e0eaf170', 'multiverseId': 164926}, 'multiverseid': 164926}, {'name': '平和な心', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '41d28683-4bf7-403e-9938-729095e655a5'}, 'multiverseid': None}, {'name': 'Pacifismo', 'text': 'A criatura encantada não pode atacar nem bloquear.', 'type': 'Encantar Criatura', 'flavor': 'Pela primeira vez na vida, Grakk sentiu-se aquecido e confuso por dentro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165640&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b4736962-7c09-40c9-a6d6-4ce755fc4402', 'multiverseId': 165640}, 'multiverseid': 165640}]", '[{\'name\': \'Phantomkrieger\', \'text\': \'Der Phantomkrieger ist unblockbar.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'Er kann durch feste Materie schlüpfen — aber nimm niemals an, er sei harmlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162706&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83943488-0661-41d5-ba43-72966d9be3c1\', \'multiverseId\': 162706}, \'multiverseid\': 162706}, {\'name\': \'Guerrero fantasmal\', \'text\': \'El Guerrero fantasmal es imbloqueable.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'Puede atravesar materia sólida, pero eso no significa que sea inofensivo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165343&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b0e80833-9520-468f-b227-74b34da0b26e\', \'multiverseId\': 165343}, \'multiverseid\': 165343}, {\'name\': \'Guerrier fantomatique\', \'text\': \'Le Guerrier fantomatique est imblocable.\', \'type\': \'Créature : illusion\', \'flavor\': "Il peut passer à travers la matière, mais cela ne signifie pas qu\'il soit inoffensif.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163063&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2f9529df-0dce-49eb-8ad8-7884abff131e\', \'multiverseId\': 163063}, \'multiverseid\': 163063}, {\'name\': \'Guerriero Fantasma\', \'text\': \'Il Guerriero Fantasma non può essere bloccato.\', \'type\': \'Creatura — Illusione\', \'flavor\': \'Può attraversare la materia solida... ma questo non significa che sia inoffensivo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164986&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'20edebde-b06e-4ee5-b6b7-efccadb5dede\', \'multiverseId\': 164986}, \'multiverseid\': 164986}, {\'name\': \'幻影の戦士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f856f70-a851-44d5-93f2-7c7b268acce3\'}, \'multiverseid\': None}, {\'name\': \'Guerreiro Fantasma\', \'text\': \'Guerreiro Fantasma não pode ser bloqueado.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'Ele atravessa matéria sólida mas isso não significa que seja inofensivo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165700&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d0286357-1768-436e-9a9d-0bb6cb01f254\', \'multiverseId\': 165700}, \'multiverseid\': 165700}]', '[{\'name\': \'Phyrexianische Arena\', \'text\': \'Zu Beginn deines Versorgungssegments ziehst du eine Karte und verlierst 1 Lebenspunkt. (Dein Versorgungssegment kommt nach dem Enttappen und vor dem Ziehen.)\', \'type\': \'Verzauberung\', \'flavor\': \'Eine Flut der Macht kostet immer ein Stück deiner Menschlichkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162765&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2f7fdeec-63de-4551-b928-2cc04107ca32\', \'multiverseId\': 162765}, \'multiverseid\': 162765}, {\'name\': \'Arena pirexiana\', \'text\': \'Al comienzo de tu mantenimiento, roba una carta y pierde 1 vida. (Tu paso de mantenimiento es después de enderezar y antes de robar.)\', \'type\': \'Encantamiento\', \'flavor\': \'Una gota de humanidad para un mar de poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165402&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9685360-3237-4a50-a683-0928d4b85b75\', \'multiverseId\': 165402}, \'multiverseid\': 165402}, {\'name\': \'Arène phyrexiane\', \'text\': "Au début de votre entretien, vous piochez une carte et vous perdez 1 point de vie. (Votre phase d\'entretien commence après le dégagement de vos cartes et avant votre pioche.)", \'type\': \'Enchantement\', \'flavor\': "Une goutte d\'humanité pour un océan de puissance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163122&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0883e5b4-008d-4e52-97b4-e8657563c06b\', \'multiverseId\': 163122}, \'multiverseid\': 163122}, {\'name\': \'Arena di Phyrexia\', \'text\': "All\'inizio del tuo mantenimento, peschi una carta e perdi 1 punto vita. (il tuo mantenimento è dopo il tuo STAP e prima della tua acquisizione).", \'type\': \'Incantesimo\', \'flavor\': \'Una goccia di umanità per un mare di potere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83c10f23-8372-4986-836a-9cdc7c43554c\', \'multiverseId\': 165045}, \'multiverseid\': 165045}, {\'name\': \'ファイレクシアの闘技場\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a78485df-e9fe-4680-a07e-5b9843840350\'}, \'multiverseid\': None}, {\'name\': \'Arena Phyrexiana\', \'text\': \'No início de sua manutenção, você compra um card e perde 1 ponto de vida. (Sua etapa de manutenção ocorre depois que você desvirar e antes de você comprar.)\', \'type\': \'Encantamento\', \'flavor\': \'Uma gota de humanidade num oceano de poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165759&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5b1e51e2-5c84-43bd-9114-f63c12d15992\', \'multiverseId\': 165759}, \'multiverseid\': 165759}]', "[{'name': 'Phyrexianischer Koloss', 'text': 'Der Phyrexianische Koloss enttappt nicht während deines Enttappsegments.\\nBezahle 8 Lebenspunkte: Enttappe den Phyrexianischen Koloss.\\nDer Phyrexianische Koloss kann nicht von weniger als drei Kreaturen geblockt werden.', 'type': 'Artefaktkreatur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162922&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c96e4712-d1a3-420a-a04c-8881866dc697', 'multiverseId': 162922}, 'multiverseid': 162922}, {'name': 'Coloso pirexiano', 'text': 'El Coloso pirexiano no se endereza durante tu paso de enderezar.\\nPagar 8 vidas: Endereza el Coloso pirexiano.\\nEl Coloso pirexiano no puede ser bloqueado excepto por tres o más criaturas.', 'type': 'Criatura artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165559&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6507bf0a-0da2-4fa3-b584-c5ef94957da6', 'multiverseId': 165559}, 'multiverseid': 165559}, {'name': 'Colosse phyrexian', 'text': 'Le Colosse phyrexian ne se dégage pas pendant votre étape de dégagement.\\nPayez 8 points de vie : Dégagez le Colosse phyrexian.\\nLe Colosse phyrexian ne peut pas être bloqué excepté par trois créatures ou plus.', 'type': 'Créature-artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163279&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0d7c1b6e-01e0-46e5-ae4d-3f59d15c8b9a', 'multiverseId': 163279}, 'multiverseid': 163279}, {'name': 'Colosso di Phyrexia', 'text': 'Il Colosso di Phyrexia non STAPpa durante il tuo STAP.\\nPaga 8 punti vita: STAPpa il Colosso di Phyrexia.\\nIl Colosso di Phyrexia non può essere bloccato tranne che da tre o più creature.', 'type': 'Creatura Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165202&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7eef3273-884b-4b8c-a58f-5a33b1bd621e', 'multiverseId': 165202}, 'multiverseid': 165202}, {'name': 'ファイレクシアの巨像', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ec89c098-063d-469b-98fc-d6177fa7efae'}, 'multiverseid': None}, {'name': 'Colosso Phyrexiano', 'text': 'Colosso Phyrexiano não desvira durante a sua etapa de desvirar.\\nPague 8 pontos de vida: Desvira Colosso Phyrexiano.\\nColosso Phyrexiano só pode ser bloqueado por três ou mais criaturas.', 'type': 'Criatura Artefato', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165916&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '67d93a64-5641-400f-84f0-2e1e4038900a', 'multiverseId': 165916}, 'multiverseid': 165916}]", '[{\'name\': \'Phyrexianischer Moloch\', \'type\': \'Artefaktkreatur\', \'flavor\': \'Er denkt nicht nach. Er fühlt auch nichts. Er weint nie oder lacht. Früh fängt er mit dem Töten an, Was er bis abends macht. —Oneanischer Kinderreim\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162923&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e066774-15d0-4698-93b7-81ed176f186d\', \'multiverseId\': 162923}, \'multiverseid\': 162923}, {\'name\': \'Titán pirexiano\', \'type\': \'Criatura artefacto\', \'flavor\': \'No piensa. No siente.No ríe ni llora. Lo único que hace del atardecer al amanecer es hacer morir a los soldados. Rima infantil oneana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165560&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'392a7e5c-7eb1-4405-bb7a-2fa8e25854ec\', \'multiverseId\': 165560}, \'multiverseid\': 165560}, {\'name\': \'Carcasse phyrexiane\', \'type\': \'Créature-artefact\', \'flavor\': "Il ne pense pas. Il ne sent pas. Il ne pleure et ne rit pas. Tout ce qu\'il fait, matin ou soir C\'est de jouer l\'aplatissoir. —Comptine onéane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163280&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbb264f6-6040-4bc9-84ef-3cd428499fb4\', \'multiverseId\': 163280}, \'multiverseid\': 163280}, {\'name\': \'Carcassa di Phyrexia\', \'type\': \'Creatura Artefatto\', \'flavor\': "Non pensa. Non ha tornaconto. Non ride e non sente. Tutto ciò che fa dall\'alba al tramonto È far morire la gente. —Rima dei bambini oneani", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165203&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9d05659b-ccfe-4516-9bf3-d875162478a9\', \'multiverseId\': 165203}, \'multiverseid\': 165203}, {\'name\': \'ファイレクシアの大男\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21912799-35e1-4232-a006-debc1e146a9d\'}, \'multiverseid\': None}, {\'name\': \'Brutamontes Phyrexiano\', \'type\': \'Criatura Artefato\', \'flavor\': \'Ele não pensa. Ele não sente. Ele não ri nem chora. Tudo que faz do entardecer à aurora É levar soldados à morte, incontinente. — Verso infantil de Oneah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165917&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7d083d99-8f78-4f19-9db4-396be82e523e\', \'multiverseId\': 165917}, \'multiverseid\': 165917}]', '[{\'name\': \'Phyrexianischer Seuchenherr\', \'text\': \'{T}, opfere den Phyrexianischen Seuchenherrn: Eine Kreatur deiner Wahl erhält -4/-4 bis zum Ende des Zuges.\\nOpfere eine Kreatur: Eine Kreatur deiner Wahl erhält -1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Überträger\', \'flavor\': \'„Die letzte Stufe der Krankheit: Delirium, Krämpfe und Tod." —Phyrexianisches Versuchsprotokoll\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e2f7ca4-c5ec-4921-b651-b1138c4000eb\', \'multiverseId\': 162766}, \'multiverseid\': 162766}, {\'name\': \'Señor de la peste pirexiano\', \'text\': \'{T}, sacrificar el Señor de la peste pirexiano: La criatura objetivo obtiene -4/-4 hasta el final del turno.\\nSacrificar una criatura: La criatura objetivo obtiene -1/-1 hasta el final del turno.\', \'type\': \'Criatura — Portador\', \'flavor\': \'"La etapa final de la enfermedad: delirio, convulsiones y muerte". —Notas de progreso pirexianas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3fa08c15-5bc1-4780-b0e7-8f45fc3720d7\', \'multiverseId\': 165403}, \'multiverseid\': 165403}, {\'name\': \'Seigneur de la peste phyrexian\', \'text\': "{T}, Sacrifiez le Seigneur de la peste phyrexian : La créature ciblée gagne -4/-4 jusqu\'à la fin du tour.\\nSacrifiez une créature : La créature ciblée gagne -1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : propagateur\', \'flavor\': \'« La phase finale de la maladie : le délire, les convulsions et enfin la mort. » — Notes médicales phyrexianes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163123&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58b5503e-dc56-4038-9937-178ae91aa283\', \'multiverseId\': 163123}, \'multiverseid\': 163123}, {\'name\': \'Signore della Peste di Phyrexia\', \'text\': \'{T}, Sacrifica il Signore della Peste di Phyrexia: La creatura bersaglio prende -4/-4 fino alla fine del turno.\\nSacrifica una creatura: La creatura bersaglio prende -1/-1 fino alla fine del turno.\', \'type\': \'Creatura — Portatore\', \'flavor\': \'"L\\\'ultimo stadio della malattia: delirio, convulsioni e morte". —note sui progressi di Phyrexia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4356dcd-778b-46eb-8468-1d164a10136f\', \'multiverseId\': 165046}, \'multiverseid\': 165046}, {\'name\': \'ファイレクシアの疫病王\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'702de4d5-cf17-465a-9a61-1313f272a8d2\'}, \'multiverseid\': None}, {\'name\': \'Senhor da Praga Phyrexiano\', \'text\': \'{T}, Sacrifique Senhor da Praga Phyrexiano: A criatura alvo recebe -4/-4 até o final do turno.\\nSacrifique uma criatura: A criatura alvo recebe -1/-1 até o final do turno.\', \'type\': \'Criatura — Portador\', \'flavor\': \'"O estágio final da doença: delírio, convulsões e morte." — Notas de progresso phyrexianas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'20d6ede1-9695-4341-a95b-a3c98ab2d6e6\', \'multiverseId\': 165760}, \'multiverseid\': 165760}]', '[{\'name\': \'Plötzlicher Aufprall\', \'text\': \'Der Plötzliche Aufprall fügt einem Spieler deiner Wahl Schadenspunkte in Höhe der Anzahl an Karten auf seiner Hand zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manche Leute wissen alles besser. Goblins wissen besser nichts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162839&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6081f804-b294-4015-8a56-1357bca90384\', \'multiverseId\': 162839}, \'multiverseid\': 162839}, {\'name\': \'Impacto súbito\', \'text\': \'El Impacto súbito hace una cantidad de daño igual al número de cartas que haya en la mano del jugador objetivo a ese jugador.\', \'type\': \'Instantáneo\', \'flavor\': \'La mayoría de la gente tiene sentido común. Los trasgos sólo tienen sentido del tamaño.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165476&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7414ab0d-d296-45aa-aa0d-6434432d9266\', \'multiverseId\': 165476}, \'multiverseid\': 165476}, {\'name\': \'Choc soudain\', \'text\': \'Le Choc soudain inflige au joueur ciblé un nombre de blessures égal au nombre de cartes dans la main de ce joueur.\', \'type\': \'Éphémère\', \'flavor\': \'Un gobelin ne peut jamais viser mieux, mais il peut toujours taper plus fort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163196&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ec5d243-1393-4f39-bdbf-ee3e471088da\', \'multiverseId\': 163196}, \'multiverseid\': 163196}, {\'name\': \'Impatto Improvviso\', \'text\': "L\'Impatto Improvviso infligge a un giocatore bersaglio un ammontare di danni pari al numero di carte presenti nella mano di quel giocatore.", \'type\': \'Istantaneo\', \'flavor\': "Molte persone sanno cos\'è meglio. I goblin sanno solo cos\'è più grosso.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165119&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9f700f1-6c39-4da1-91ee-f8a9dc87650e\', \'multiverseId\': 165119}, \'multiverseid\': 165119}, {\'name\': \'突然の衝撃\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7eb6b928-eef9-4434-85f3-ef5f22fdb00d\'}, \'multiverseid\': None}, {\'name\': \'Impacto Súbito\', \'text\': \'Impacto Súbito causa ao jogador alvo uma quantidade de dano igual ao número de cards na mão daquele jogador.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A maior parte das pessoas sabe o que é melhor. Os goblins só sabem do que é maior.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165833&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff1f1615-8de8-499d-9d71-89fe2bc49a92\', \'multiverseId\': 165833}, \'multiverseid\': 165833}]', '[{\'name\': \'Portal der Welten\', \'text\': \'{6}, {T}: Durchsuche deine Bibliothek nach einer Karte und nimm diese Karte auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Artefakt\', \'flavor\': \'Es gibt Geschichten, dass diese Apparate ganze Welten durch den Äther bewegt haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162924&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7908f901-880d-4af0-ae54-809b19d02c9c\', \'multiverseId\': 162924}, \'multiverseid\': 162924}, {\'name\': \'Portal de planos\', \'text\': \'{6}, {T}: Busca en tu biblioteca una carta y pon esa carta en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Artefacto\', \'flavor\': \'Se sabe que estos artefactos han arrastrado mundos enteros a través del Eter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165561&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06375290-6588-4252-b45e-8f4154da111d\', \'multiverseId\': 165561}, \'multiverseid\': 165561}, {\'name\': \'Portail interplan\', \'text\': \'{6}, {T} : Cherchez une carte dans votre bibliothèque et mettez cette carte dans votre main. Mélangez ensuite votre bibliothèque.\', \'type\': \'Artefact\', \'flavor\': "Ces instruments sont connus pour avoir aspiré des mondes entiers dans l\'Aether.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163281&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'02695b48-b1a2-4611-b6da-42668b1e036e\', \'multiverseId\': 163281}, \'multiverseid\': 163281}, {\'name\': \'Varco Dimensionale\', \'text\': \'{6}, {T}: Passa in rassegna il tuo grimorio, scegli una carta e aggiungi quella carta alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Artefatto\', \'flavor\': "Questi dispositivi un tempo hanno trascinato interi mondi attraverso l\'etere.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165204&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd44fd40-6fcb-4c57-8b6b-055a3ae3c130\', \'multiverseId\': 165204}, \'multiverseid\': 165204}, {\'name\': \'次元の門\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68d9c061-ef2f-4f41-a342-b95cf7d00ed5\'}, \'multiverseid\': None}, {\'name\': \'Portal Planar\', \'text\': \'{6}, {T}: Procure em seu grimório por um card e coloque-o em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Artefato\', \'flavor\': \'Estes aparelhos eram conhecidos por puxar mundos inteiros através do Éter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165918&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bcc89d9-37f0-4a03-8f7e-c0893ddb07ab\', \'multiverseId\': 165918}, \'multiverseid\': 165918}]', '[{\'name\': \'Preis des Ehrgeizes\', \'text\': \'Du ziehst drei Karten und verlierst 3 Lebenspunkte.\', \'type\': \'Hexerei\', \'flavor\': \'„Wissen verlangt Opfer."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162731&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c5f6a06-1ce7-48de-9b21-ed89c3c1dfcb\', \'multiverseId\': 162731}, \'multiverseid\': 162731}, {\'name\': \'El precio de la ambición\', \'text\': \'Roba tres cartas y pierde tres vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"El conocimiento exige sacrificio".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165368&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f48c9869-3a18-41f3-8cfd-8581bc9e4ea0\', \'multiverseId\': 165368}, \'multiverseid\': 165368}, {\'name\': "Le prix de l\'ambition", \'text\': \'Vous piochez trois cartes et vous perdez 3 points de vie.\', \'type\': \'Rituel\', \'flavor\': \'« Le savoir exige un sacrifice. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163088&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05d35977-da6e-4ff0-a939-ff227c6d0755\', \'multiverseId\': 163088}, \'multiverseid\': 163088}, {\'name\': "Costo dell\'Ambizione", \'text\': \'Tu peschi 3 carte e perdi 3 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"La conoscenza richiede sacrifici".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1a31f1b-b98f-41b0-8314-de390bf5c8b1\', \'multiverseId\': 165011}, \'multiverseid\': 165011}, {\'name\': \'野望の代償\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9e573224-a1fd-4ce2-b43f-503465063a2b\'}, \'multiverseid\': None}, {\'name\': \'Custo da Ambição\', \'text\': \'Você compra três cards e perde 3 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"O conhecimento exige sacrifício."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165725&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'634d5620-394a-4148-a921-077e81618322\', \'multiverseId\': 165725}, \'multiverseid\': 165725}]', '[{\'name\': \'Pyrotechnik\', \'text\': \'Pyrotechnik fügt 4 Schadenspunkte zu, deren Verteilung auf eine beliebige Anzahl an Kreaturen und/oder Spielern deiner Wahl du bestimmst.\', \'type\': \'Hexerei\', \'flavor\': \'„Wer hat gesagt, dass der Blitz nie zweimal zuschlägt?" —Sturmschamane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162824&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3ee6d4b-6463-432e-a6fe-eb2f1d3bdff8\', \'multiverseId\': 162824}, \'multiverseid\': 162824}, {\'name\': \'Pirotecnia\', \'text\': \'La Pirotecnia hace 4 puntos de daño divididos de la manera que elijas entre cualquier número de criaturas y/o jugadores objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"¿Quién dice que los rayos nunca golpean dos veces?" Chamán de la tormenta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165461&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d0bc3c5-538c-4365-8921-2fccc811c7a1\', \'multiverseId\': 165461}, \'multiverseid\': 165461}, {\'name\': \'Pyrotechnie\', \'text\': \'La Pyrotechnie inflige 4 blessures réparties de la manière que vous choisissez parmi un nombre quelconque de cibles, créatures et/ou joueurs.\', \'type\': \'Rituel\', \'flavor\': "« Qui a dit que l\'éclair ne frappait jamais deux fois au même endroit ? » — Une shamane de l\'orage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163181&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'91fef5bc-be01-4373-92ff-eb979ff04da8\', \'multiverseId\': 163181}, \'multiverseid\': 163181}, {\'name\': "Fuochi d\'Artificio", \'text\': "I Fuochi d\'Artificio infliggono 4 danni divisi a tua scelta tra un qualsiasi numero di creature e/o giocatori bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'"Chi dice che un fulmine non colpisce mai due volte?" -sciamano delle tempeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165104&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c14b04d2-aa5e-4aa1-8bf6-4dffa2c9af19\', \'multiverseId\': 165104}, \'multiverseid\': 165104}, {\'name\': \'発火\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb7af889-1db8-423f-bf99-4913c2e44774\'}, \'multiverseid\': None}, {\'name\': \'Pirotécnica\', \'text\': \'Pirotécnica causa 4 pontos de dano, distribuídos da maneira que você quiser entre um número qualquer de criaturas alvo e/ou jogadores alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Quem disse que um raio não cai duas vezes no mesmo lugar?" — Xamã da tempestade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8632cfad-8f12-4fcb-84b2-992a1a72140e\', \'multiverseId\': 165818}, \'multiverseid\': 165818}]', "[{'name': 'Rankende Reben', 'text': '(Mauern können nicht angreifen.){T}: Erhöhe deinen Manavorrat um {G}.', 'type': 'Kreatur — Mauer', 'flavor': 'Selbst beste Seilerkunst kann mit den Knoten der Natur nicht mithalten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162900&type=card', 'language': 'German', 'identifiers': {'scryfallId': '524566c3-03d9-4ed4-b442-59e3fa45ba60', 'multiverseId': 162900}, 'multiverseid': 162900}, {'name': 'Espaldar', 'text': '(Los Muros no pueden atacar.)\\n{T}: Agrega {G} a tu reserva de maná.', 'type': 'Criatura — Muro', 'flavor': 'La naturaleza trama nudos más fuertes que cualquier cuerda.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165537&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a36c3602-817e-49a0-9f65-4698a84ad77b', 'multiverseId': 165537}, 'multiverseid': 165537}, {'name': 'Treille', 'text': '(Les murs ne peuvent pas attaquer.){T} : Ajoutez {G} à votre réserve.', 'type': 'Créature : mur', 'flavor': 'La nature crée des nœuds plus résistants que la corde la plus solide.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163257&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd22c087b-fe9c-4483-bbfb-93697dfebe64', 'multiverseId': 163257}, 'multiverseid': 163257}, {'name': 'Tralicci Rampicanti', 'text': '(I Muri non possono attaccare.){T}: Aggiungi {G} alla tua riserva di mana.', 'type': 'Creatura — Muro', 'flavor': 'La natura stringe nodi più forti di qualsiasi fune.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165180&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7d50ab60-9c8c-4ae8-b1ef-c2819825d2ae', 'multiverseId': 165180}, 'multiverseid': 165180}, {'name': 'ぶどう棚', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'aeb0abca-b1a1-4da8-b659-6ef47969f88c'}, 'multiverseid': None}, {'name': 'Rede de Trepadeiras', 'text': '(As Barreiras não podem atacar.){T}: Adiciona {G} à sua reserva de mana.', 'type': 'Criatura — Barreira', 'flavor': 'A natureza ata nós mais fortes do que qualquer corda.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165894&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c30a7e7d-dce2-403d-895c-9a56522c4fc3', 'multiverseId': 165894}, 'multiverseid': 165894}]", '[{\'name\': \'Rasiermesserklauen-Greif\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)Erstschlag\\n (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Kreatur — Greif\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'580ac2d4-d62c-41e6-a352-77affba81743\', \'multiverseId\': 162649}, \'multiverseid\': 162649}, {\'name\': \'Grifo pienavaja\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nDaña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Criatura — Grifo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165286&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98eeea0a-db2e-496c-ba33-cc5728977794\', \'multiverseId\': 165286}, \'multiverseid\': 165286}, {\'name\': \'Griffon serres-rasoir\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nInitiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Créature : griffon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163006&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42d8589e-2f95-4673-96ce-e93addd8e601\', \'multiverseId\': 163006}, \'multiverseid\': 163006}, {\'name\': \'Grifone dal Tallone Tagliente\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nAttacco improvviso (Questa creatura infligge il danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Creatura — Grifone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164929&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6b5a135b-2b24-4d08-8dcd-2762e14b5319\', \'multiverseId\': 164929}, \'multiverseid\': 164929}, {\'name\': \'カミソリ足のグリフィン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'411169ee-ccd6-4199-bec5-958b780ac52e\'}, \'multiverseid\': None}, {\'name\': \'Grifo Garra-de-Navalha\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nIniciativa (Esta criatura causa dano de combate antes de criaturas sem a habilidade de iniciativa.)\', \'type\': \'Criatura — Grifo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165643&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aaf318b0-076d-41b6-8581-0accd3e50b3d\', \'multiverseId\': 165643}, \'multiverseid\': 165643}]', '[{\'name\': \'Rattenschwarm\', \'text\': \'Die Stärke des Rattenschwarms ist gleich der Anzahl an Ratten, die du kontrollierst.\', \'type\': \'Kreatur — Ratte\', \'flavor\': \'„Da krabbeln sie nun, wie die Ratten auf der Keule des Herkules..." —Friedrich Schiller, Die Räuber\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162780&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13cb8a85-0413-4b5c-9fb0-71a52546be86\', \'multiverseId\': 162780}, \'multiverseid\': 162780}, {\'name\': \'Aluvión de ratas\', \'text\': \'La fuerza del Aluvión de ratas es igual al número de Ratas que controles.\', \'type\': \'Criatura — Rata\', \'flavor\': \'"¡Ratas, ratas, ratas Cientos, miles, millones de ellas, y cada una de ellas es una vida." —Bram Stoker, Drácula\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165417&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99ec6133-a5ad-4534-8b39-4ea94ce11552\', \'multiverseId\': 165417}, \'multiverseid\': 165417}, {\'name\': \'Colonie de rats\', \'text\': \'La force de la Colonie de rats est égale au nombre de rats que vous contrôlez.\', \'type\': \'Créature : rat\', \'flavor\': "« Des rats Par centaines, par milliers, par millions... Et chacun d\'eux une vie distinctive. » —Bram Stoker, Dracula", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163137&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8771ae29-1a62-4910-929d-e293741e236d\', \'multiverseId\': 163137}, \'multiverseid\': 163137}, {\'name\': \'Sciame di Ratti\', \'text\': \'La forza dello Sciame di Ratti è pari al numero di Ratti che controlli.\', \'type\': \'Creatura — Ratto\', \'flavor\': \'"Ratti, ratti, ratti Centinaia, migliaia, milioni di essi, e ciascuno una vita." —Bram Stoker, Dracula\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165060&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'088ce282-6960-4d20-9239-36efd2678f99\', \'multiverseId\': 165060}, \'multiverseid\': 165060}, {\'name\': \'ネズミの大群\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'757ae4de-083a-4841-9422-c524f9d872c8\'}, \'multiverseid\': None}, {\'name\': \'Rataria\', \'text\': \'O poder de Rataria é igual ao número de Ratos que você controla.\', \'type\': \'Criatura — Rato\', \'flavor\': \'"Ratos, ratos, ratos Centenas, milhares, milhões deles. E cada um é uma vida." — Bram Stoker, Drácula\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a665fae6-03cd-4c97-8022-a4df2f79f6e5\', \'multiverseId\': 165774}, \'multiverseid\': 165774}]', '[{\'name\': \'Reflexe\', \'text\': \'Die verzauberte Kreatur hat Erstschlag. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Sei so schnell wie der Blitz, und du wirst genauso tödlich sein." —Kampftrainer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162826&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'59c2f4bf-36f0-431a-aab5-e7ab68228d15\', \'multiverseId\': 162826}, \'multiverseid\': 162826}, {\'name\': \'Reflejos\', \'text\': \'La criatura encantada tiene la habilidad de dañar primero. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Encantar criatura\', \'flavor\': \'"Sé tan rápido como el rayo y serás igual de mortífero." Entrenador de combate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165463&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4807d56-3bc6-4de0-89ba-bb258461276a\', \'multiverseId\': 165463}, \'multiverseid\': 165463}, {\'name\': \'Réflexes\', \'text\': "La créature enchantée a l\'initiative. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Enchanter : créature\', \'flavor\': "« Soyez rapide comme l\'éclair, vous serez dangereux comme l\'éclair. » — Un entraîneur de combat.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163183&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e433dd9e-b369-412e-a228-8c9c0c327d60\', \'multiverseId\': 163183}, \'multiverseid\': 163183}, {\'name\': \'Riflessi\', \'text\': \'La creatura incantata ha attacco improvviso. (Infligge il danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Incanta Creatura\', \'flavor\': \'"Sii veloce come il fulmine e sarai altrettanto mortale". -addestratore al combattimento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165106&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5bfda22a-e0fb-4c18-a4bf-f8b34397b3d9\', \'multiverseId\': 165106}, \'multiverseid\': 165106}, {\'name\': \'速やかな反応\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6102b5ce-cb4a-42f8-a083-bbd07836bf82\'}, \'multiverseid\': None}, {\'name\': \'Reflexos\', \'text\': \'A criatura encantada tem iniciativa. (Ela causa dano antes de criaturas sem a habilidade de iniciativa.)\', \'type\': \'Encantar Criatura\', \'flavor\': \'"Sê tão rápido quanto o relâmpago e serás tão letal quanto ele." — Instrutor de combate\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165820&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'249d3fc7-f749-4be1-8db9-3fa853c41db9\', \'multiverseId\': 165820}, \'multiverseid\': 165820}]', '[{\'name\': \'Regeneration\', \'text\': \'{G}: Regeneriere die verzauberte Kreatur.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Warum sollte der Tod immer das letzte Wort haben?" —Llanowardruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162888&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'722208a4-e938-4a80-9e00-7a83525d2ad1\', \'multiverseId\': 162888}, \'multiverseid\': 162888}, {\'name\': \'Regeneración\', \'text\': \'{G}: Regenera a la criatura encantada.\', \'type\': \'Encantar criatura\', \'flavor\': \'"¿Por qué la muerte ha de tener siempre la última palabra?" Druida de Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165525&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb062965-047c-447c-afd5-da64c69b3e28\', \'multiverseId\': 165525}, \'multiverseid\': 165525}, {\'name\': \'Régénération\', \'text\': \'{G} : Régénérez la créature enchantée.\', \'type\': \'Enchanter : créature\', \'flavor\': \'« Pourquoi la mort aurait-elle le dernier mot ? » — Un druide de la Llanowar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163245&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'64b2ec24-cf31-494b-9356-adb1943780ed\', \'multiverseId\': 163245}, \'multiverseid\': 163245}, {\'name\': \'Rigenerazione\', \'text\': \'{G}: Rigenera la creatura incantata.\', \'type\': \'Incanta Creatura\', \'flavor\': \'"Perché la morte deve sempre avere l\\\'ultima parola?" -druido di Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165168&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c73a4386-df5a-4a2f-add0-ee1ec67462dc\', \'multiverseId\': 165168}, \'multiverseid\': 165168}, {\'name\': \'再生\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5bc5b72-aba4-4bf4-bef7-bec330d8dc3b\'}, \'multiverseid\': None}, {\'name\': \'Regeneração\', \'text\': \'{G}: Regenera a criatura encantada.\', \'type\': \'Encantar Criatura\', \'flavor\': \'"Por que a morte sempre tem que ter a última palavra?" — Druida de Llanowar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c16afbf-a33e-4444-b87c-5d99aa8ff9c2\', \'multiverseId\': 165882}, \'multiverseid\': 165882}]', '[{\'name\': \'Rhox\', \'text\': \'Du kannst Rhox seinen Kampfschaden dem verteidigenden Spieler zufügen lassen, als ob es nicht geblockt worden wäre.\\n{2}{G}: Regeneriere Rhox.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162890&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a045990-f19d-427d-acd5-34b975e4aad8\', \'multiverseId\': 162890}, \'multiverseid\': 162890}, {\'name\': \'Rhox\', \'text\': \'Puedes hacer que el Rhox haga su daño de combate al jugador defensor como si no hubiera sido bloqueado.\\n{2}{G}: Regenera al Rhox.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165527&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b679209b-f1e6-4306-942f-422f84796fda\', \'multiverseId\': 165527}, \'multiverseid\': 165527}, {\'name\': \'Rhox\', \'text\': "Vous pouvez faire que les blessures infligées par le Rhox au joueur défenseur le soient comme s\'il n\'était pas bloqué.\\n{2}{G} : Régénérez le Rhox.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163247&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d76722f8-666c-4eb8-8ee5-b6dd814bf43f\', \'multiverseId\': 163247}, \'multiverseid\': 163247}, {\'name\': \'Rhox\', \'text\': \'Puoi decidere che il Rhox infligga il proprio danno da combattimento al giocatore in difesa come se non fosse stato bloccato.\\n{2}{G}: Rigenera il Rhox.\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165170&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4530f107-6253-445f-a07b-488681a5cfd5\', \'multiverseId\': 165170}, \'multiverseid\': 165170}, {\'name\': \'ロウクス\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b056e669-c537-4545-93ea-719c6d789265\'}, \'multiverseid\': None}, {\'name\': \'Rhox\', \'text\': \'Você pode fazer com que Rhox cause seu dano de combate ao jogador defensor como se não tivesse sido bloqueado.\\n{2}{G}: Regenera Rhox.\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165884&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c1b65cd-d8db-4dd1-9a28-08a6b0825414\', \'multiverseId\': 165884}, \'multiverseid\': 165884}]', '[{\'name\': \'Riesendachs\', \'text\': \'Immer wenn der Riesendachs blockt, erhält er +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Dachs\', \'flavor\': \'Störe einen schlafenden Dachs, und das Brechen deiner Knochen wird die ganze Umgebung aufwecken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162866&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae269bc8-7481-40ea-864b-30e29a98d047\', \'multiverseId\': 162866}, \'multiverseid\': 162866}, {\'name\': \'Tejón gigante\', \'text\': \'Siempre que el Tejón gigante bloquee, obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Tejón\', \'flavor\': \'Si molestas a un tejón dormido, los chasquidos de tus huesos despertarán a la campiña.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165503&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'977052da-c2e1-4e23-aadb-caa7a9b9c928\', \'multiverseId\': 165503}, \'multiverseid\': 165503}, {\'name\': \'Blaireau géant\', \'text\': "À chaque fois que le Blaireau géant bloque, il gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : blaireau\', \'flavor\': \'Dérangez le blaireau qui dort et les craquements de vos os brisés réveilleront toute la forêt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163223&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4407f225-b97d-4c3d-9fbb-d8c157c66da4\', \'multiverseId\': 163223}, \'multiverseid\': 163223}, {\'name\': \'Tasso Gigante\', \'text\': \'Ogniqualvolta il Tasso Gigante blocca, prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Tasso\', \'flavor\': \'Prova a disturbare un tasso che dorme e tutta la vallata verrà risvegliata dallo schioccare delle tue ossa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165146&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4c5a4a2-95f6-45f1-a529-43232ddb22a5\', \'multiverseId\': 165146}, \'multiverseid\': 165146}, {\'name\': \'大アナグマ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20e42d98-bb2b-4ac0-bdce-2e759cb283e2\'}, \'multiverseid\': None}, {\'name\': \'Texugo Gigante\', \'text\': \'Toda vez que Texugo Gigante bloquear, ele recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Texugo\', \'flavor\': \'Incomoda um texugo adormecido e o estalar dos teus ossos vai acordar todo o campo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ccb4743-ecf4-4135-b291-183070248a83\', \'multiverseId\': 165860}, \'multiverseid\': 165860}]', '[{\'name\': \'Riesenschabe\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Toren war im Laufe seines Lebens schon auf eine Menge Käfer getreten. Daher war es etwas schockierend für ihn, als plötzlich ein Käfer ihn zertrat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162748&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d070ae73-60d0-4a52-923f-957f28b74157\', \'multiverseId\': 162748}, \'multiverseid\': 162748}, {\'name\': \'Cucaracha gigante\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Toren había pisado muchos insectos durante su vida, así que no pudo evitar sentirse avergonzado al ser pisado por un insecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165385&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6c66d764-4bed-4a01-b426-3ded22f2bf6c\', \'multiverseId\': 165385}, \'multiverseid\': 165385}, {\'name\': \'Cafard géant\', \'type\': \'Créature : insecte\', \'flavor\': \'Toren avait souvent écrasé des insectes. Maintenant il recevait la monnaie de sa pièce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163105&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f41207f2-1e16-427d-905a-074932bbcd46\', \'multiverseId\': 163105}, \'multiverseid\': 163105}, {\'name\': \'Scarafaggio Gigante\', \'type\': \'Creatura — Insetto\', \'flavor\': "Toren aveva schiacciato un\'infinità di insetti nella propria vita, così non poté fare a meno di sentirsi imbarazzato quando venne calpestato da uno scarafaggio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165028&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b3cf2a2b-11ce-4177-9f24-6e3086218d8c\', \'multiverseId\': 165028}, \'multiverseid\': 165028}, {\'name\': \'巨大ゴキブリ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7449c72-1b10-4efa-aea8-2428a605e545\'}, \'multiverseid\': None}, {\'name\': \'Barata Gigante\', \'type\': \'Criatura — Inseto\', \'flavor\': \'Toren havia pisoteado muitos insetos durante sua vida, portanto não pôde evitar sentir-se constrangido quando um inseto o pisoteou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165742&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3229eccb-a7a5-4142-a4c2-ff9ed76c4d2b\', \'multiverseId\': 165742}, \'multiverseid\': 165742}]', '[{\'name\': \'Riesenspinne\', \'text\': \'Die Riesenspinne kann blocken, als ob sie Flugfähigkeit hätte.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Das Spinnennetz beobachten —Llanowar-Ausdruck für „auf das Falsche konzentrieren"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162868&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36090954-fe16-45eb-91a4-ddf5f79095fe\', \'multiverseId\': 162868}, \'multiverseid\': 162868}, {\'name\': \'Araña gigante\', \'text\': \'La Araña gigante puede bloquear como si tuviera la habilidad de volar.\', \'type\': \'Criatura — Araña\', \'flavor\': \'Observando la telaraña—Expresión de Llanowar que significa "enfocándose en la cosa equivocada"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165505&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0a776f7-476b-42c9-bbc1-c644011768ac\', \'multiverseId\': 165505}, \'multiverseid\': 165505}, {\'name\': \'Araignée géante\', \'text\': "L\'Araignée géante peut bloquer comme si elle avait le vol.", \'type\': \'Créature : araignée\', \'flavor\': "Regarder la toile de l\'araignée —Expression de la Llanowar signifiant « regarder dans la mauvaise direction »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163225&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1b8adba-f3b0-4c2d-860e-6e29cdd33083\', \'multiverseId\': 163225}, \'multiverseid\': 163225}, {\'name\': \'Ragno Gigante\', \'text\': \'Il Ragno Gigante può bloccare come se avesse volare.\', \'type\': \'Creatura — Ragno\', \'flavor\': \'Guardare la tela del ragno —Espressione di Llanowar, che significa "concentrarsi sulla cosa sbagliata".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165148&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e0ea966-a5e8-449d-8a9e-329c35eda3f7\', \'multiverseId\': 165148}, \'multiverseid\': 165148}, {\'name\': \'大蜘蛛\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'88d2f465-6f2e-4e33-839c-fb0403647ee3\'}, \'multiverseid\': None}, {\'name\': \'Aranha Gigante\', \'text\': \'Aranha Gigante pode bloquear como se tivesse a habilidade de voar.\', \'type\': \'Criatura — Aranha\', \'flavor\': \'Observar a teia da aranha — Expressão de Llanowar que significa "concentrar-se na coisa errada"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57e2d0b4-9872-4cc8-96f8-8ad3d576e5b4\', \'multiverseId\': 165862}, \'multiverseid\': 165862}]', '[{\'name\': \'Riesenwuchs\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+3 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162867&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bbb6535f-9ec4-4b55-bd8c-88fc13a25cc6\', \'multiverseId\': 162867}, \'multiverseid\': 162867}, {\'name\': \'Crecimiento gigante\', \'text\': \'La criatura objetivo obtiene +3/+3 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165504&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4bf7c270-5dce-4145-a4e4-f1133b0a0be7\', \'multiverseId\': 165504}, \'multiverseid\': 165504}, {\'name\': \'Croissance gigantesque\', \'text\': "La créature ciblée gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163224&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25165915-818c-42d8-921a-efba575cd838\', \'multiverseId\': 163224}, \'multiverseid\': 163224}, {\'name\': \'Crescita Gigante\', \'text\': \'La creatura bersaglio prende +3/+3 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165147&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9946502d-0c94-432c-8786-7e11349646ba\', \'multiverseId\': 165147}, \'multiverseid\': 165147}, {\'name\': \'巨大化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'05e56178-a997-43e9-8f81-32f078b855fa\'}, \'multiverseid\': None}, {\'name\': \'Crescimento Desenfreado\', \'text\': \'A criatura alvo recebe +3/+3 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd01e0eb-cca4-4acf-a622-00452e140f5c\', \'multiverseId\': 165861}, \'multiverseid\': 165861}]', '[{\'name\': \'Ruf der Wildnis\', \'text\': \'{2}{G}{G}: Decke die oberste Karte deiner Bibliothek auf. Falls es eine Kreaturenkarte ist, bringe sie ins Spiel. Lege sie andernfalls auf deinen Friedhof.\', \'type\': \'Verzauberung\', \'flavor\': \'Egal ob Flüstern oder Brüllen der Ruf wird von allen gehört und von niemandem ignoriert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162848&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7ec2b48-5f7c-42a9-a76c-7ba6188bd71e\', \'multiverseId\': 162848}, \'multiverseid\': 162848}, {\'name\': \'Llamado de la naturaleza\', \'text\': \'{2}{G}{G}: Muestra la carta de la parte superior de tu biblioteca. Si es una carta de criatura, ponla en juego. Si no, ponla en tu cementerio.\', \'type\': \'Encantamiento\', \'flavor\': \'De un suspiro a un rugido, el llamado es oido por todos y rehusado por ninguno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165485&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3dd3044-3f94-4786-b7e8-ba03287def49\', \'multiverseId\': 165485}, \'multiverseid\': 165485}, {\'name\': \'Appel de la forêt\', \'text\': "{2}{G}{G} : Révélez la carte du dessus de votre bibliothèque. Si c\'est une carte de créature, mettez-la en jeu. Sinon, mettez-la dans votre cimetière.", \'type\': \'Enchantement\', \'flavor\': "Qu\'il soit murmure ou rugissement, l\'appel est entendu par tous et nul, jamais, ne le refuse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163205&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'87094a9f-960d-42f2-bd0b-23e1fbf14d69\', \'multiverseId\': 163205}, \'multiverseid\': 163205}, {\'name\': \'Richiamo della Foresta\', \'text\': \'{2}{G}{G}: Rivela la prima carta del tuo grimorio. Se è una carta creatura, mettila in gioco. In caso contrario, mettila nel tuo cimitero.\', \'type\': \'Incantesimo\', \'flavor\': \'Da un sussurro a un ruggito, il richiamo viene udito da tutti e nessuno lo rinnega.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165128&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73802a36-2b9b-49f1-98bc-c79e3f1e7be5\', \'multiverseId\': 165128}, \'multiverseid\': 165128}, {\'name\': \'野生の呼び声\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0fc97a79-4af1-4d4f-9ad0-10e9f07cf9d3\'}, \'multiverseid\': None}, {\'name\': \'Chamado da Selva\', \'text\': \'{2}{G}{G}: Revele o card do topo de seu grimório. Se este for um card de criatura, coloque-o em jogo. Se não, coloque-o em seu cemitério.\', \'type\': \'Encantamento\', \'flavor\': \'De um sussurro a um rugido, o chamado é ouvido por todos e não é ignorado por ninguém.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165842&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b7585123-f7b1-4508-ada0-e2e5361f8df3\', \'multiverseId\': 165842}, \'multiverseid\': 165842}]', '[{\'name\': \'Ruhmsucher\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Das Schlachtenglück kehrt immer mit dem einen Soldaten zurück, der es sich anders überlegt und sich wieder in den Kampf stürzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162634&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14a2baf5-94ab-49c6-9826-365ecfda42dc\', \'multiverseId\': 162634}, \'multiverseid\': 162634}, {\'name\': \'Buscador de gloria\', \'type\': \'Criatura — Soldado\', \'flavor\': \'El cambio de la suerte siempre comienza con la decisión de un soldado de regresar a la lucha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165271&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e704350-d8a2-4f51-b65e-ccfc9053c53c\', \'multiverseId\': 165271}, \'multiverseid\': 165271}, {\'name\': \'Chercheur de gloire\', \'type\': \'Créature : soldat\', \'flavor\': "Un seul soldat retourne au combat, et l\'espoir change de camp.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162991&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d3a1395-7527-414a-be40-1754a044eec1\', \'multiverseId\': 162991}, \'multiverseid\': 162991}, {\'name\': \'Cacciatore di Gloria\', \'type\': \'Creatura — Soldato\', \'flavor\': \'Le sorti della battaglia sono destinate a mutare quando un soldato decide di tornare a gettarsi nella mischia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164914&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'497d292c-3b48-4d5a-82cf-270c0b61c8a6\', \'multiverseId\': 164914}, \'multiverseid\': 164914}, {\'name\': \'栄光の探求者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc275d34-66d2-4316-aa7b-9cb20733cafa\'}, \'multiverseid\': None}, {\'name\': \'Perseguidor da Glória\', \'type\': \'Criatura — Soldado\', \'flavor\': \'A mudança da maré sempre tem início com a decisão de um soldado de voltar para a luta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165628&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9fd12e55-e62f-45b6-8eec-8d1764739648\', \'multiverseId\': 165628}, \'multiverseid\': 165628}]', '[{\'name\': \'Rukh-Ei\', \'text\': \'Wenn das Rukh-Ei aus dem Spiel auf den Friedhof gelegt wird, bringe am Ende des Zuges einen 4/4 roten Rukh-Spielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Kreatur — Ei\', \'flavor\': \'Rukhs, in den Ebenen oft „Steinfedern" genannt, stammen angeblich von einem Phoenix ab, der seine Flamme gegen einen steinernen Körper eingetauscht haben soll.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162829&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'017cb3d3-b8d8-4b7f-937b-bc32dd127c0f\', \'multiverseId\': 162829}, \'multiverseid\': 162829}, {\'name\': \'Huevo de rukh\', \'text\': \'Cuando el Huevo de rukh vaya a un cementerio desde el juego, pon en juego una ficha de criatura Rukh roja 4/4 con la habilidad de volar al final del turno.\', \'type\': \'Criatura — Huevo\', \'flavor\': \'Muchas personas de las tierras bajas los llaman "plumas de piedra". Se piensa que los rukh descienden de un fénix que sacrificó su llama por un cuerpo de piedra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165466&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebc73da4-1490-45c3-884a-da3eaf4ffcdf\', \'multiverseId\': 165466}, \'multiverseid\': 165466}, {\'name\': \'Œuf de rukh\', \'text\': "Quand l\'Œuf de rukh est envoyé dans un cimetière depuis le jeu, mettez en jeu, à la fin du tour, un jeton de créature 4/4 rouge Rukh.", \'type\': \'Créature : œuf\', \'flavor\': "Appelés « Plumepierres » par les gens des basses terres, les rukhs seraient les descendants d\'un phénix qui, un jour, sacrifia sa flamme pour obtenir un corps de pierre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163186&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c79477fe-956e-4aed-86e2-d3131527ad15\', \'multiverseId\': 163186}, \'multiverseid\': 163186}, {\'name\': \'Uovo di Rukh\', \'text\': "Quando l\'Uovo di Rukh viene messo in un cimitero dal gioco, metti in gioco una pedina creatura Rukh 4/4 rossa con volare alla fine del turno.", \'type\': \'Creatura — Uovo\', \'flavor\': \'Chiamati "pietrapiuma" da molti abitanti del bassopiano, si pensa che i rukh siano discendenti di una fenice che ha sacrificato il proprio fuoco in cambio di un corpo di pietra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165109&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b96dcfd3-41ba-4a0f-8631-6c1ebc7c6797\', \'multiverseId\': 165109}, \'multiverseid\': 165109}, {\'name\': \'ルフ鳥の卵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d24f2365-2c94-4e69-9792-389388f3c6a6\'}, \'multiverseid\': None}, {\'name\': \'Ovo de Rukh\', \'text\': \'Quando Ovo de Rukh for colocado num cemitério vindo de jogo, coloque em jogo no final do turno uma ficha de criatura vermelha 4/4, com a habilidade de voar, do tipo Rukh.\', \'type\': \'Criatura — Ovo\', \'flavor\': \'Chamados de "penas de pedra" por muitos das terras baixas, acredita-se que os rukhs descendem de uma fênix que sacrificou sua chama para ter um corpo de pedra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165823&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a59f20b-84f2-4196-a0ad-d1d6d6ca8e3c\', \'multiverseId\': 165823}, \'multiverseid\': 165823}]', '[{\'name\': \'Rumpeltruppen\', \'text\': \'Opfere die Rumpeltruppen: Die Rumpeltruppen fügen einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'War is a conflict that determines not who is right—but who is left.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162836&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f2de9d7-a35f-4735-b63e-658778d4e2d2\', \'multiverseId\': 162836}, \'multiverseid\': 162836}, {\'name\': \'Tropas de choque\', \'text\': \'Sacrificar las Tropas de choque: Las Tropas de choque hacen 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Soldado\', \'flavor\': \'La guerra es un conflicto que determina quién tiene la razón . . . y quién sobrevive.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'196e26a3-2fe0-4200-b8b4-69c5c68c1849\', \'multiverseId\': 165473}, \'multiverseid\': 165473}, {\'name\': \'Troupes de choc\', \'text\': \'Sacrifiez les Troupes de choc : Les Troupes de choc infligent 2 blessures à une cible, créature ou joueur.\', \'type\': \'Créature : soldat\', \'flavor\': "Après une guerre, il n\'y a pas un vainqueur et un vaincu. Il y a seulement un survivant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163193&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2313ed42-7f4a-49d4-abf5-146e9e1a8a49\', \'multiverseId\': 163193}, \'multiverseid\': 163193}, {\'name\': "Truppe d\'Assalto", \'text\': "Sacrifica le Truppe d\'Assalto: Le Truppe d\'Assalto infliggono 2 danni a una creatura o a un giocatore bersaglio.", \'type\': \'Creatura — Soldato\', \'flavor\': \'La guerra è un conflitto che non stabilisce chi ha ragione, solo chi sopravvive.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165116&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'630a7950-6de6-4e57-be36-d22acfca8635\', \'multiverseId\': 165116}, \'multiverseid\': 165116}, {\'name\': \'突撃隊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b789e84d-d9f6-4141-bd66-7d4d346b42a7\'}, \'multiverseid\': None}, {\'name\': \'Tropas de Choque\', \'text\': \'Sacrifique Tropas de Choque: Tropas de Choque causa 2 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Criatura — Soldado\', \'flavor\': \'A guerra não é um conflito que determina quem está certo mas quem está vivo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165830&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'460f1575-646d-4ce4-9b28-f1d4438b1995\', \'multiverseId\': 165830}, \'multiverseid\': 165830}]', "[{'name': 'Rückruf', 'text': 'Bringe eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162725&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ec3c58a7-32d7-4999-b452-9cd4b79e5047', 'multiverseId': 162725}, 'multiverseid': 162725}, {'name': 'Anular invocación', 'text': 'Regresa la criatura objetivo a la mano de su propietario.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165362&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b3bf9e57-0b9d-47c2-a5ab-b3e5808ff0c6', 'multiverseId': 165362}, 'multiverseid': 165362}, {'name': 'Désinvocation', 'text': 'Renvoyez la créature ciblée dans la main de son propriétaire.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163082&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e605a6dd-0523-4a71-9d9d-cf6e5b1b0c9b', 'multiverseId': 163082}, 'multiverseid': 163082}, {'name': 'Controevocazione', 'text': 'Il proprietario riprende in mano una creatura bersaglio.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165005&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9def9599-102e-47cd-917d-2054c6f76366', 'multiverseId': 165005}, 'multiverseid': 165005}, {'name': '送還', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd84b54e0-6b89-4612-962a-8d4acd9adae8'}, 'multiverseid': None}, {'name': 'Esconjurar', 'text': 'Devolva a criatura alvo para a mão de seu dono.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165719&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '52a9e56e-c073-4cdf-87fa-5bb401166ac1', 'multiverseId': 165719}, 'multiverseid': 165719}]", '[{\'name\': \'Sagenkreis\', \'text\': \'Bestimme eine Farbe, sowie der Sagenkreis ins Spiel kommt.\\n{W}: Sobald eine Quelle der bestimmten Farbe, die du bestimmst, dir das nächste Mal in diesem Zug Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162663&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'16acaa79-d9eb-4c70-bd32-d79a00008511\', \'multiverseId\': 162663}, \'multiverseid\': 162663}, {\'name\': \'Círculo de historias\', \'text\': \'En cuanto el Círculo de historias entre en juego, elige un color.\\n{W}: La próxima vez que una fuente de tu elección del color elegido fuera a hacerte daño este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165300&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'250fc941-01b9-4d5e-8f03-d3383d9224c7\', \'multiverseId\': 165300}, \'multiverseid\': 165300}, {\'name\': \'Théâtre en cercle\', \'text\': "Au moment où le Théâtre en cercle arrive en jeu, choisissez une couleur.\\n{W} : La prochaine fois qu\'une source de votre choix de la couleur choisie devrait vous blesser ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163020&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c697b413-2786-44e0-9614-3a32d9bde093\', \'multiverseId\': 163020}, \'multiverseid\': 163020}, {\'name\': \'Circolo della Storia\', \'text\': \'Mentre il Circolo della Storia entra in gioco, scegli un colore.\\n{W}: La prossima volta che una fonte a tua scelta del colore scelto ti sta per infliggere danno in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf5add80-a360-41ac-8b81-f51eba07e7c3\', \'multiverseId\': 164943}, \'multiverseid\': 164943}, {\'name\': \'物語の円\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca5c718e-d720-40a3-b367-66f72b269319\'}, \'multiverseid\': None}, {\'name\': \'Círculo de Histórias\', \'text\': \'Conforme Círculo de Histórias entra em jogo, escolha uma cor.\\n{W}: Na próxima vez que uma fonte de sua escolha da cor escolhida fosse causar dano a você neste turno, previna aquele dano.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165657&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f4c21453-1518-49e0-b94c-c0d6ebe07f84\', \'multiverseId\': 165657}, \'multiverseid\': 165657}]', '[{\'name\': \'Salzmarschen\', \'text\': \'Die Salzmarschen kommen getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {B}.\', \'type\': \'Land\', \'flavor\': \'Im stillen Wasser nistet nur der Tod. —Urborgweisheit\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162938&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29902404-470c-4a63-bc0d-c57542507075\', \'multiverseId\': 162938}, \'multiverseid\': 162938}, {\'name\': \'Cenagal salino\', \'text\': \'El Cenagal salino entra en juego girado.{T}: Agrega {U} o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Sólo la muerte prolifera en agua estancada. Refrán de Urborg\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165575&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'559ab717-2d5e-4c92-94de-0edb388637b5\', \'multiverseId\': 165575}, \'multiverseid\': 165575}, {\'name\': \'Marais salant\', \'text\': \'Le Marais salant arrive en jeu engagé.\\n{T} : Ajoutez {U} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Seule la mort prolifère dans l\'eau stagnante —Dicton d\'Urborg", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163295&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7295ca55-deed-4164-bfd9-b0305749860d\', \'multiverseId\': 163295}, \'multiverseid\': 163295}, {\'name\': \'Palude Salata\', \'text\': \'La Palude Salata entra in gioco TAPpata.\\n{T}: Aggiungi {U} o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Solo la morte si riproduce nelle sue acque stagnanti. —Detto di Urborg\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165218&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'667bb687-c15c-4156-8a54-1bb35ff8bed7\', \'multiverseId\': 165218}, \'multiverseid\': 165218}, {\'name\': \'塩の湿地\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75939008-d1ef-4588-9593-f75053428b10\'}, \'multiverseid\': None}, {\'name\': \'Pântano Salgado\', \'text\': \'Pântano Salgado entra em jogo virado.\\n{T}: Adiciona {U} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Só a morte procria na água estagnada. — Provérbio de Urborg\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165932&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1874b98e-d7b7-4755-9ba6-badd5557debd\', \'multiverseId\': 165932}, \'multiverseid\': 165932}]', '[{\'name\': \'Savannenlöwen\', \'type\': \'Kreatur — Löwe\', \'flavor\': \'Selbst die Tapfersten werden dreifach vom Löwen erschreckt: erst von seinen Spuren, dann von seinem Brüllen, und schließlich von seinem Angesicht. —Sprichwort aus Somalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162656&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ada16b56-fd26-49c2-ad0b-c9027728d8ea\', \'multiverseId\': 162656}, \'multiverseid\': 162656}, {\'name\': \'Leones de la sabana\', \'type\': \'Criatura — León\', \'flavor\': \'Incluso los valientes se asustan con el león tres veces: primero, al ver sus huellas; luego, al oír su rugido; y finalmente, al verlo cara a cara. —Proverbio somalí\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165293&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5858af67-5970-442b-9e91-52d3a611f481\', \'multiverseId\': 165293}, \'multiverseid\': 165293}, {\'name\': \'Lions des savanes\', \'type\': \'Créature : lion\', \'flavor\': "Par trois fois, le plus brave est effrayé par le lion : d\'abord en voyant ses traces, ensuite en entendant son rugissement, et finalement en l\'affrontant. —Proverbe somalien", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163013&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6c4c848-4536-496f-be36-5c9ee2f3ca07\', \'multiverseId\': 163013}, \'multiverseid\': 163013}, {\'name\': \'Leoni della Savana\', \'type\': \'Creatura — Leone\', \'flavor\': \'Anche il coraggioso viene spaventato tre volte dal leone: prima dalle sue tracce, poi dal suo ruggito e infine dalla vista delle sue fauci. —Proverbio somalo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164936&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5172293-2505-499d-8546-341b69d9e4e4\', \'multiverseId\': 164936}, \'multiverseid\': 164936}, {\'name\': \'サバンナ・ライオン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49d9302f-a5e6-4b1d-a63a-dc19dfde7c98\'}, \'multiverseid\': None}, {\'name\': \'Leões da Savana\', \'type\': \'Criatura — Leão\', \'flavor\': \'Até os bravos são assustados três vezes por um leão: primeiro por suas pegadas, depois por seu rugido e, por último, pela encarada. — Provérbio Somali\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165650&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2fa877f5-9349-491f-8d02-23bd49d94011\', \'multiverseId\': 165650}, \'multiverseid\': 165650}]', '[{\'name\': \'Schatzhort\', \'text\': \'{2}{U}{U}: Ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'„... der Mensch begehrt alles an sich zu reißen, um nur nach Belieben damit schalten und walten zu können." —Johann Wolfgang von Goethe, Lehrjahre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162723&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a30c5d73-37b7-41db-bd5e-ee6fda3fe483\', \'multiverseId\': 162723}, \'multiverseid\': 162723}, {\'name\': \'Descubrimiento del tesoro\', \'text\': \'{2}{U}{U}: Roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': \'"La riqueza es poder; el poder de someter, de aplastar, de explotar, el poder de esclavizar, de ultrajar, de degradar." —Emma Goldman, "Anarquismo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165360&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1cf5c57a-84b1-4109-891e-81c77e030c74\', \'multiverseId\': 165360}, \'multiverseid\': 165360}, {\'name\': \'Caverne au trésor\', \'text\': \'{2}{U}{U} : Piochez une carte.\', \'type\': \'Enchantement\', \'flavor\': "« Ou le luxe est l\'effet des richesses, ou il les rend nécessaires ; il corrompt à la fois le riche et le pauvre, l\'un par la possession, l\'autre par la convoitise. » —Jean-Jacques Rousseau", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163080&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30f6c68b-d099-4391-addc-d27cefb14997\', \'multiverseId\': 163080}, \'multiverseid\': 163080}, {\'name\': \'Tesoro Ritrovato\', \'text\': \'{2}{U}{U}: Pesca una carta\', \'type\': \'Incantesimo\', \'flavor\': \'"La ricchezza significa potere; il potere di sottomettere, di schiacciare, di sfruttare, il potere di schiavizzare, di oltraggiare, di degradare." —Emma Goldman, "Anarchia"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165003&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77b9caed-9c21-4911-9604-0f3732697b0b\', \'multiverseId\': 165003}, \'multiverseid\': 165003}, {\'name\': \'貴重な収集品\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97c0fb3a-b86c-4a39-878f-f609229bc7b9\'}, \'multiverseid\': None}, {\'name\': \'Reintegração do Tesouro\', \'text\': \'{2}{U}{U}: Compre um card.\', \'type\': \'Encantamento\', \'flavor\': \'"A riqueza significa poder; o poder para subjugar, massacrar, explorar, o poder para escravizar, ultrajar, degradar." — Emma Goldman, "Anarquismo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165717&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9bdfec8b-c62e-4046-af42-4a5578c56d75\', \'multiverseId\': 165717}, \'multiverseid\': 165717}]', '[{\'name\': \'Scheinheiligkeit\', \'text\': \'Immer wenn ein Gegner ein Gebirge für Mana tappt, kannst du 1 Lebenspunkt dazuerhalten.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Bauern arbeiten in meine Tasche. Ich erkenne das an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e460a4b9-9f5d-4b33-972b-128e4b45bd66\', \'multiverseId\': 162655}, \'multiverseid\': 162655}, {\'name\': \'Santurronería\', \'text\': \'Siempre que un oponente gire una Montaña para obtener maná, puedes ganar 1 vida.\', \'type\': \'Encantamiento\', \'flavor\': \'"Los campesinos trabajan para que yo gane. Yo lo apruebo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165292&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a066de5e-f31d-4fc8-bf73-fdf14e884e2f\', \'multiverseId\': 165292}, \'multiverseid\': 165292}, {\'name\': \'Tartuferie\', \'text\': "À chaque fois que l\'un de vos adversaires engage une montagne pour du mana, vous pouvez gagner 1 point de vie.", \'type\': \'Enchantement\', \'flavor\': "« Certains prient, d\'autres travaillent. Tel est l\'ordre de la nature. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163012&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29fa0940-7ab5-43de-9886-70234663ff6e\', \'multiverseId\': 163012}, \'multiverseid\': 163012}, {\'name\': \'Bigotteria\', \'text\': \'Ogniqualvolta un avversario TAPpa una Montagna per attingere mana, puoi guadagnare 1 punto vita.\', \'type\': \'Incantesimo\', \'flavor\': \'"I contadini lavorano per il mio profitto. Approvo".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00392896-8a63-43b4-994b-06b4d000a794\', \'multiverseId\': 164935}, \'multiverseid\': 164935}, {\'name\': \'偽の信心\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd643894-a551-4d1d-9b27-cf07621123cd\'}, \'multiverseid\': None}, {\'name\': \'Santimônia\', \'text\': \'Toda vez que um de seus oponentes virar uma Montanha para gerar mana, você pode ganhar 1 ponto de vida.\', \'type\': \'Encantamento\', \'flavor\': \'"Os camponeses trabalham para meu benefício. Eu aprovo isso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165649&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f8bf5e1-b8ef-4eff-9383-74c2a37da0d1\', \'multiverseId\': 165649}, \'multiverseid\': 165649}]', '[{\'name\': \'Schlamm im Sinn\', \'text\': \'Ein Spieler deiner Wahl wirft für jeden Sumpf, den du kontrollierst, eine Karte aus seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': \'Wenn du in den Sumpf gerätst, gerät Sumpf auch in dich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162759&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afe7344b-7b60-402e-8ee7-aea5b503dc64\', \'multiverseId\': 162759}, \'multiverseid\': 162759}, {\'name\': \'Fango mental\', \'text\': \'El jugador objetivo descarta una carta de su mano por cada Pantano que controles.\', \'type\': \'Conjuro\', \'flavor\': \'Cuando te metes en el pantano, el pantano se mete en ti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165396&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6642df87-d614-46fc-96cb-21634e7de79d\', \'multiverseId\': 165396}, \'multiverseid\': 165396}, {\'name\': \'Vase cérébrale\', \'text\': "Le joueur ciblé se défausse d\'une carte de sa main pour chaque marais que vous contrôlez.", \'type\': \'Rituel\', \'flavor\': \'Quand vous entrez dans le marais, le marais entre en vous.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163116&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e07a15cb-f09f-4dbe-bd72-129ac72adbd6\', \'multiverseId\': 163116}, \'multiverseid\': 163116}, {\'name\': \'Fango Mentale\', \'text\': \'Il giocatore bersaglio scarta una carta dalla propria mano per ogni Palude che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'Quando entri nella palude, la palude entra dentro di te.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165039&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4778ce3e-dae2-4040-861a-f26ce5c92722\', \'multiverseId\': 165039}, \'multiverseid\': 165039}, {\'name\': \'精神ヘドロ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a6e8ef9e-c2c2-49c5-b8db-7c51d4ebd9ab\'}, \'multiverseid\': None}, {\'name\': \'Imundície Mental\', \'text\': \'O jogador alvo descarta um card de sua própria mão para cada Pântano que você controla.\', \'type\': \'Feitiço\', \'flavor\': \'Quando você entra no pântano, o pântano entra em você.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f826c06-3b7f-4e35-b0fe-2d72e8b9d356\', \'multiverseId\': 165753}, \'multiverseid\': 165753}]', "[{'name': 'Schlangenkrieger', 'text': 'Du verlierst 3 Lebenspunkte, wenn der Schlangenkrieger ins Spiel kommt.', 'type': 'Kreatur — Soldat', 'flavor': 'Manchmal ist schon sein Zischen tödlich.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162774&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fb7052f4-457f-4768-90e8-8a24b5d14044', 'multiverseId': 162774}, 'multiverseid': 162774}, {'name': 'Guerrero serpiente', 'text': 'Cuando el Guerrero serpiente entre en juego, pierde 3 vidas.', 'type': 'Criatura — Soldado', 'flavor': 'Un siseo antes de morir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165411&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cbe01f82-e253-443f-8603-47c00c3e545d', 'multiverseId': 165411}, 'multiverseid': 165411}, {'name': 'Guerrier serpentiforme', 'text': 'Quand le Guerrier serpentiforme arrive en jeu, vous perdez 3 points de vie.', 'type': 'Créature : soldat', 'flavor': 'La mort sifflante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163131&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ee66f38a-c505-49a4-a787-fdfc5aa96a09', 'multiverseId': 163131}, 'multiverseid': 163131}, {'name': 'Guerriero Serpente', 'text': 'Quando il Guerriero Serpente entra in gioco, perdi 3 punti vita.', 'type': 'Creatura — Soldato', 'flavor': 'Un sibilo prima di morire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165054&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4264e1c9-b754-4820-8b7c-fa74bd8e58eb', 'multiverseId': 165054}, 'multiverseid': 165054}, {'name': '蛇人間の戦士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2846c5b0-8554-4994-b7bb-33617c7f68e8'}, 'multiverseid': None}, {'name': 'Guerreiro Serpente', 'text': 'Quando Guerreiro Serpente entra em jogo, você perde 3 pontos de vida.', 'type': 'Criatura — Soldado', 'flavor': 'Um sibilar antes da morte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165768&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2b8a65cb-948c-40c6-8c29-e9fa1453732d', 'multiverseId': 165768}, 'multiverseid': 165768}]", '[{\'name\': \'Schleichender Homunkulus\', \'text\': \'Der Schleichende Homunkulus kann von Kreaturen mit Stärke 2 oder mehr nicht geblockt werden.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'Wenn du nur auf die Riesen achtest, wirst du von den Ameisen gefressen werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162714&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f8180a95-5bd2-4648-b1ed-63049c6bb125\', \'multiverseId\': 162714}, \'multiverseid\': 162714}, {\'name\': \'Homúnculo furtivo\', \'text\': \'El Homúnculo furtivo no puede bloquear o ser bloqueado por criaturas con fuerza de 2 o más.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'Cuídate sólo de los gigantes y te comerán las hormigas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165351&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d27c030d-6a96-4013-b3e0-461fa95863b5\', \'multiverseId\': 165351}, \'multiverseid\': 165351}, {\'name\': \'Homoncule furtif\', \'text\': "L\'Homoncule furtif ne peut pas bloquer ni être bloqué par des créatures de force supérieure à 2.", \'type\': \'Créature : illusion\', \'flavor\': \'Si vous veillez seulement à ne pas être écrasé par les géants, vous serez dévoré par les fourmis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163071&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a3670b9-2baa-4399-88ad-f23b70d78887\', \'multiverseId\': 163071}, \'multiverseid\': 163071}, {\'name\': \'Omuncolo Furtivo\', \'text\': "L\'Omuncolo Furtivo non può bloccare né essere bloccato da creature con forza pari o superiore a 2.", \'type\': \'Creatura — Illusione\', \'flavor\': \'Se ti guardi solo dai giganti, finirai per essere divorato dalle formiche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cafdafb8-f0fc-4541-9921-b9ae132c5f14\', \'multiverseId\': 164994}, \'multiverseid\': 164994}, {\'name\': \'こそこそするホムンクルス\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d019e781-1892-40a0-9cfb-5bbead3966b5\'}, \'multiverseid\': None}, {\'name\': \'Homúnculo Furtivo\', \'text\': \'Homúnculo Furtivo não pode bloquear nem ser bloqueado por criaturas com poder maior ou igual a 2.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'Fica de olho apenas nos gigantes e acabarás sendo comido pelas formigas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165708&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'441b1d38-35b9-4919-b0c6-5ba7066b6769\', \'multiverseId\': 165708}, \'multiverseid\': 165708}]', '[{\'name\': \'Schleichender Schimmel\', \'text\': \'Zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Der Schimmel kroch über die Mauern und in jede Spalte, bis der glänzende weiße Stein sich verformte und zerbarst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162853&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5d2d388-02cd-4935-a751-263b08a8a418\', \'multiverseId\': 162853}, \'multiverseid\': 162853}, {\'name\': \'Moho reptante\', \'text\': \'Destruye el artefacto, encantamiento o tierra objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'El moho subió por los muros y entró en todas las grietas hasta que la brillante piedra blanca no aguantó más y se rompió.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165490&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'855ff422-2b3e-4df4-8b2c-c938c6ec6398\', \'multiverseId\': 165490}, \'multiverseid\': 165490}, {\'name\': \'Moisissure rampante\', \'text\': "Détruisez l\'artefact ciblé, l\'enchantement ciblé ou le terrain ciblé.", \'type\': \'Rituel\', \'flavor\': "« Il tombait en désuétude. La moisissure l\'envahissait, les fleurs le quittaient. » —Victor Hugo, Les Misérables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163210&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4344759a-3f99-40fb-853d-7271b3ec45a4\', \'multiverseId\': 163210}, \'multiverseid\': 163210}, {\'name\': \'Muffa Insidiosa\', \'text\': \'Distruggi un artefatto, un incantesimo o una terra bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'La muffa si arrampicò sulle mura e si insinuò in ogni crepa, fino a quando la bianca e scintillante pietra cedette ed esplose.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe5c162e-5b94-4242-8a44-bd61cf73be0e\', \'multiverseId\': 165133}, \'multiverseid\': 165133}, {\'name\': \'忍び寄るカビ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9762bd22-fe55-4650-95b5-e2141c437675\'}, \'multiverseid\': None}, {\'name\': \'Bolor Invasor\', \'text\': \'Destrói o artefato, o encntamento ou o terreno alvo.\', \'type\': \'Feitiço\', \'flavor\': \'O bolor espalhou-se pelas paredes e penetrou cada fenda, até que a reluzente pedra branca deformou-se e explodiu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165847&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'82da2d73-efa8-48b6-8d3a-91952a090e41\', \'multiverseId\': 165847}, \'multiverseid\': 165847}]', '[{\'name\': \'Schock\', \'text\': \'Schock fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich liebe Blitze Das ist meine beste Erfindung seit den Steinen." —Toggo, Goblin-Waffenschmied\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162835&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6f92e71-9439-43fa-b994-46391a9ce179\', \'multiverseId\': 162835}, \'multiverseid\': 162835}, {\'name\': \'Choque\', \'text\': \'El Choque hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Adoro el rayo Es mi mejor inviención después de la roca". —Toggo, armero trasgo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e147295e-7b33-4cb5-bf9e-a320498903ca\', \'multiverseId\': 165472}, \'multiverseid\': 165472}, {\'name\': \'Choc\', \'text\': \'Le Choc inflige 2 blessures à une cible, créature ou joueur.\', \'type\': \'Éphémère\', \'flavor\': "« J\'aime les éclairs. C\'est ma meilleure invention depuis le rocher. » —Toggo, forgeur d\'armes gobelin", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163192&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad7e7025-4251-49e6-a1c4-39e50898cf1a\', \'multiverseId\': 163192}, \'multiverseid\': 163192}, {\'name\': \'Shock\', \'text\': \'Lo Shock infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Amo i fulmini Sono la mia migliore invenzione dopo la roccia". —Toggo, fabbro goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'26519dac-dc17-42f3-965a-f623d29ed116\', \'multiverseId\': 165115}, \'multiverseid\': 165115}, {\'name\': \'ショック\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'814acb63-afcb-427a-8501-58562876d31a\'}, \'multiverseid\': None}, {\'name\': \'Choque\', \'text\': \'Choque causa 2 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Adoro os raios São minha melhor invenção desde as pedras." — Toggo, armeiro goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165829&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'895781b1-edde-4d55-ac0e-41d0aba15011\', \'multiverseId\': 165829}, \'multiverseid\': 165829}]', '[{\'name\': \'Schutzkreis gegen Blau\', \'text\': \'{1}: Sobald eine blaue Quelle, die du bestimmst, dir das nächste Mal in diesem Zug Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162624&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d676bbd-7b9a-4e5a-8419-698828a52295\', \'multiverseId\': 162624}, \'multiverseid\': 162624}, {\'name\': \'Círculo de protección: azul\', \'text\': \'{1}: La próxima vez que una fuente azul de tu elección fuera a hacerte daño este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165261&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9aa45606-6dbe-4c48-a31d-c982f0c7e70f\', \'multiverseId\': 165261}, \'multiverseid\': 165261}, {\'name\': \'Cercle de protection : bleu\', \'text\': "{1} : La prochaine fois qu\'une source bleue de votre choix devrait vous blesser ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162981&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0ae36a6-6542-42c6-bcde-0ae6c38a269b\', \'multiverseId\': 162981}, \'multiverseid\': 162981}, {\'name\': \'Circolo di Protezione: Blu\', \'text\': \'{1}: La prossima volta che una fonte blu a tua scelta ti infliggerebbe danno in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164904&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e0542f4-9d79-49f0-8ec9-6cb32b4e2dd1\', \'multiverseId\': 164904}, \'multiverseid\': 164904}, {\'name\': \'青の防御円\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a48c4ea-b384-408a-b6ca-f7f1318d5473\'}, \'multiverseid\': None}, {\'name\': \'Círculo de Proteção: Azul\', \'text\': \'{1}: Na próxima vez em que uma fonte azul a sua escolha lhe fosse causar dano neste turno, previna aquele dano.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165618&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb3ee730-2c5f-4627-b357-bcc69b193b6e\', \'multiverseId\': 165618}, \'multiverseid\': 165618}]', '[{\'name\': \'Schutzkreis gegen Grün\', \'text\': \'{1}: Sobald eine grüne Quelle, die du bestimmst, dir das nächste Mal in diesem Zug Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162625&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'911721db-3f19-4320-8616-ea98a69d4815\', \'multiverseId\': 162625}, \'multiverseid\': 162625}, {\'name\': \'Círculo de protección: verde\', \'text\': \'{1}: La próxima vez que una fuente verde de tu elección fuera a hacerte daño este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165262&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5337cf9-1073-47e7-bd3a-027fbe11916a\', \'multiverseId\': 165262}, \'multiverseid\': 165262}, {\'name\': \'Cercle de protection : vert\', \'text\': "{1} : La prochaine fois qu\'une source verte de votre choix devrait vous blesser ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162982&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09330640-f26d-487e-910d-5abee0777593\', \'multiverseId\': 162982}, \'multiverseid\': 162982}, {\'name\': \'Circolo di Protezione: Verde\', \'text\': \'{1}: La prossima volta che una fonte verde a tua scelta ti infliggerebbe danno in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None,