ards.com/Handlers/Image.ashx?multiverseid=162962&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5374d161-ffc6-46f4-9191-3cf185416942', 'multiverseId': 162962}, 'multiverseid': 162962}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165599&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ca61e85a-0b24-4fbd-bb8d-0ea964d317ce', 'multiverseId': 165599}, 'multiverseid': 165599}, {'name': 'Forêt', 'type': 'Terrain de base : Forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163319&type=card', 'language': 'French', 'identifiers': {'scryfallId': '53da27f0-9672-46b2-94ad-e25ba335c20b', 'multiverseId': 163319}, 'multiverseid': 163319}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165242&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '600464ce-a82e-4105-ba2f-3ccdcdc836ac', 'multiverseId': 165242}, 'multiverseid': 165242}, {'name': '森', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '192be59b-8607-4019-8cee-cf91a2a8e6dd'}, 'multiverseid': None}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165956&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7cc11b5c-1b60-4fb5-83dd-b2df0227c7d9', 'multiverseId': 165956}, 'multiverseid': 165956}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162963&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'acdc84f6-9c3a-4937-8611-3775f7ed2ac6', 'multiverseId': 162963}, 'multiverseid': 162963}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165600&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '234f29d9-f432-4a0d-8223-7ffa0fa66492', 'multiverseId': 165600}, 'multiverseid': 165600}, {'name': 'Forêt', 'type': 'Terrain de base : Forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163320&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f3572119-4419-4d6f-a9e4-a7c4a74e10fc', 'multiverseId': 163320}, 'multiverseid': 163320}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165243&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b67228a8-76b0-418b-8e3b-b2bfc720f37c', 'multiverseId': 165243}, 'multiverseid': 165243}, {'name': '森', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'bf2d89be-d7f0-40a6-b4a1-2cc012f009c4'}, 'multiverseid': None}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165957&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0ff420bd-0700-468b-ad39-a4de14863f8b', 'multiverseId': 165957}, 'multiverseid': 165957}]", '[{\'name\': \'Waldatog\', \'text\': \'{G}, opfere einen Wald: Der Waldatog erhält +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Atog\', \'flavor\': \'Was in fünfhundert Jahren gewachsen ist, kann man in einer Minute essen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162862&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'151555e0-97e2-4292-b11f-3a62a7a4bc62\', \'multiverseId\': 162862}, \'multiverseid\': 162862}, {\'name\': \'Atog de los bosques\', \'text\': \'{G}, sacrificar un Bosque: El Atog de los bosques obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Atog\', \'flavor\': \'Quinientos años para crecer, apenas un minuto para comérselo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165499&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3c25ce8f-9294-4a2f-ab94-61b2112a821f\', \'multiverseId\': 165499}, \'multiverseid\': 165499}, {\'name\': \'Sylvatog\', \'text\': "{G} Sacrifiez une forêt : Le Sylvatog gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : Atog\', \'flavor\': "Cinq cents ans pour atteindre l\'âge adulte et jamais le temps de manger.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163219&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e1a4b97-45ef-4fdd-9477-ac5803d60be2\', \'multiverseId\': 163219}, \'multiverseid\': 163219}, {\'name\': \'Atog delle Foreste\', \'text\': "{G}, Sacrifica una Foresta: L\'Atog delle Foreste prende +2/+2 fino alla fine del turno.", \'type\': \'Creatura — Atog\', \'flavor\': \'Cinquecento anni per crescere, meno di un minuto per essere mangiato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165142&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'107aee7b-360e-49f7-99b8-f8b45d770d36\', \'multiverseId\': 165142}, \'multiverseid\': 165142}, {\'name\': \'森エイトグ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea4de045-f7ca-4aa5-aec4-a3adf3c6070c\'}, \'multiverseid\': None}, {\'name\': \'Atogue Voraz\', \'text\': \'{G}, Sacrifique uma Floresta: Atogue Voraz recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Atogue\', \'flavor\': \'Quinhentos anos para crescer menos de um minuto para ser engolida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5d39c07d-6ebb-42dd-98fb-1ca3bbaa672f\', \'multiverseId\': 165856}, \'multiverseid\': 165856}]', '[{\'name\': \'Waldelfen\', \'text\': \'Wenn die Waldelfen ins Spiel kommen, durchsuche deine Bibliothek nach einem Wald und bringe ihn ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'Jeder Zweig eine Kreuzung, jede Ranke ein Fortbewegungsmittel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162902&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99623dbc-410b-4b48-b51a-609a92c458ab\', \'multiverseId\': 162902}, \'multiverseid\': 162902}, {\'name\': \'Elfos del bosque\', \'text\': \'Cuando los Elfos del bosque entren en juego, busca una carta de bosque en tu biblioteca y pon esa carta en juego. Luego baraja tu biblioteca.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'Cada rama es una encrucijada, cada enredadera es un corcel raudo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165539&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3c423ac6-26f4-493d-9ee3-9feda293b63d\', \'multiverseId\': 165539}, \'multiverseid\': 165539}, {\'name\': \'Elfe des bois\', \'text\': "Quand l\'Elfe des bois arrive en jeu, cherchez une carte de forêt dans votre bibliothèque et mettez cette carte en jeu. Mélangez ensuite votre bibliothèque.", \'type\': \'Créature : elfe\', \'flavor\': \'Chaque branche est un embranchement, chaque bouture une monture.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163259&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0aeb0091-c412-436f-a1ac-971ce1d01f0b\', \'multiverseId\': 163259}, \'multiverseid\': 163259}, {\'name\': \'Elfi dei Boschi\', \'text\': \'Quando gli Elfi dei Boschi entrano in gioco, passa in rassegna il tuo grimorio, scegli una carta Foresta e metti in gioco quella carta. Poi rimescola il tuo grimorio.\', \'type\': \'Creatura — Elfo\', \'flavor\': \'Ogni ramo è un crocevia, ogni liana un veloce destriero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165182&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6b81853-0ed3-4b1b-9056-a9e7ed3455f4\', \'multiverseId\': 165182}, \'multiverseid\': 165182}, {\'name\': \'ウッド・エルフ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19922de6-2cd1-4c9a-aca3-68584279017b\'}, \'multiverseid\': None}, {\'name\': \'Elfos da Floresta\', \'text\': \'Quando Elfos da Floresta entra em jogo, procure em seu grimório por um card de Floresta e coloque-o em jogo. Depois, embaralhe seu grimório.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'Cada galho uma encruzilhada, cada vinha um veloz garanhão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165896&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d1bfaf5-4bb6-4f7c-a4c7-95c7a02843f7\', \'multiverseId\': 165896}, \'multiverseid\': 165896}]', '[{\'name\': \'Wassermangel\', \'text\': \'Die verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Weine dich doch bei der Sonne aus, und du wirst feststellen, dass nicht einmal mehr deine Tränen dir gehorchen." —Tempeldiener von Marit Lage\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3465684c-362e-4744-8560-203f7405f4af\', \'multiverseId\': 162688}, \'multiverseid\': 162688}, {\'name\': \'Deshidratación\', \'text\': \'La criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantar criatura\', \'flavor\': \'"Llórale al sol y observa cómo incluso tus lágrimas te abandonan". —Acólito de Marit Lage\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165325&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d3e5c810-0454-416b-910a-2c766155b14f\', \'multiverseId\': 165325}, \'multiverseid\': 165325}, {\'name\': \'Déshydratation\', \'text\': "La créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchanter : créature\', \'flavor\': \'« Implore le soleil et tu verras que devant sa splendeur, même tes larmes te trahissent. » —Acolyte de Marit Lage\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163045&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c1d88347-036e-4c2d-82b0-3c1cb133b043\', \'multiverseId\': 163045}, \'multiverseid\': 163045}, {\'name\': \'Disidratazione\', \'text\': \'La creatura incantata non STAPpa durante lo STAP del proprio controllore.\', \'type\': \'Incanta Creatura\', \'flavor\': \'"Lamentati con il sole e guarda come anche le tue lacrime ti abbandonano". —Accolito di Marit Lage\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164968&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cb13a51c-e209-463a-ba00-4e672ce8d6a1\', \'multiverseId\': 164968}, \'multiverseid\': 164968}, {\'name\': \'脱水\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'595e2c4f-8931-4859-802d-0359ab5af28e\'}, \'multiverseid\': None}, {\'name\': \'Desidratação\', \'text\': \'A criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantar Criatura\', \'flavor\': \'"Chora para o sol e observa quando até tuas lágrimas te abandonarem." — Acólito de Marit Lage\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165682&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'36700dad-41ac-424c-b245-db1ffe0fb331\', \'multiverseId\': 165682}, \'multiverseid\': 165682}]', '[{\'name\': \'Weise Eule\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nWenn die Weise Eule ins Spiel kommt, schaue dir die obersten vier Karten deiner Bibliothek an und lege sie in beliebiger Reihenfolge zurück.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162711&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'63746cbe-2a5c-4d0d-b5bd-71e5aea8cf6e\', \'multiverseId\': 162711}, \'multiverseid\': 162711}, {\'name\': \'Búho sabio\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nCuando el Búho sabio entre en juego, mira las primeras cuatro cartas de la parte superior de tu biblioteca y regrésalas en el orden que elijas.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165348&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7801baac-4181-4184-9e5d-b632f3efec09\', \'multiverseId\': 165348}, \'multiverseid\': 165348}, {\'name\': \'Hibou savant\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nQuand le Hibou savant arrive en jeu, regardez les quatre cartes du dessus de votre bibliothèque et remettez-les-y dans l\'ordre de votre choix.", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163068&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a767d9f-d6b0-47f2-a785-dba95285b427\', \'multiverseId\': 163068}, \'multiverseid\': 163068}, {\'name\': \'Gufo Sapiente\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nQuando il Gufo Sapiente entra in gioco, guarda le prime quattro carte del tuo grimorio, poi rimettile a posto nell\'ordine che preferisci.", \'type\': \'Creatura — Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164991&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d649d86-061e-4f1f-bc71-ed4b35756059\', \'multiverseId\': 164991}, \'multiverseid\': 164991}, {\'name\': \'物知りフクロウ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fcc67a8d-8bce-4d53-ac3a-cadaa985d384\'}, \'multiverseid\': None}, {\'name\': \'Coruja Sábia\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nQuando Coruja Sábia entra em jogo, olhe os quatro cards do topo de seu grimório e coloque-os de volta em qualquer ordem.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165705&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80856110-13fc-47c1-930b-dd565c3ab032\', \'multiverseId\': 165705}, \'multiverseid\': 165705}]', '[{\'name\': \'Weiser aus dem Fyndhorn\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {G}{G}.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'„Es ist nützlich, dass ich mit den Bäumen sprechen kann. Und es ist fabelhaft, dass ich ihnen auch zuhören kann."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162864&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b12cf792-8ed7-422d-99f1-4a7f36e94762\', \'multiverseId\': 162864}, \'multiverseid\': 162864}, {\'name\': \'Anciano de Fyndhorn\', \'text\': \'{T}: Agrega {G}{G} a tu reserva de maná.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'"Es útil poder hablarles a los árboles. Pero es verdaderamente maravilloso poder escucharlos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6db4a584-56dd-4534-87f4-f23fec166fc9\', \'multiverseId\': 165501}, \'multiverseid\': 165501}, {\'name\': \'Ancêtre cordellien\', \'text\': \'{T} : Ajoutez {G}{G} à votre réserve.\', \'type\': \'Créature : elfe\', \'flavor\': \'« Il est utile de savoir parler aux arbres, mais plus encore de savoir les écouter. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163221&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e94be63e-cc82-4259-93ee-ddba727465e8\', \'multiverseId\': 163221}, \'multiverseid\': 163221}, {\'name\': \'Antico di Fyndhorn\', \'text\': \'{T}: Aggiungi {G}{G} alla tua riserva di mana.\', \'type\': \'Creatura — Elfo\', \'flavor\': \'"Saper parlare agli alberi è molto utile. Ma lo è ancora di più riuscire a capirli".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165144&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6fbdbf9-3b7a-4908-a1c7-766dc5a0c8e7\', \'multiverseId\': 165144}, \'multiverseid\': 165144}, {\'name\': \'フィンドホーンの古老\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f97caa40-cbee-449f-8a81-21d79908caae\'}, \'multiverseid\': None}, {\'name\': \'Ancião de Fyndhorn\', \'text\': \'{T}: Adiciona {G}{G} à sua reserva de mana.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'"É muito útil saber falar com as árvores. Mas ser capaz de ouvi-las é a verdadeira maravilha."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165858&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f816097-bb24-411f-a066-deb53c450fe4\', \'multiverseId\': 165858}, \'multiverseid\': 165858}]', '[{\'name\': \'Weiser von Lat-Nam\', \'text\': \'{T}, opfere ein Artefakt: Ziehe eine Karte.\', \'type\': \'Kreatur — Weiser\', \'flavor\': \'In jedem Mechanismus steckt ein Funken der Seele seines Erschaffers. In jedem Weisen steckt eine Lampe, die nur auf diesen Funken wartet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162710&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'051c81f8-884b-457b-9edd-8a8395c1c3d6\', \'multiverseId\': 162710}, \'multiverseid\': 162710}, {\'name\': \'Sabio de Lat-Nam\', \'text\': \'{T}, sacrificar un artefacto: Roba una carta.\', \'type\': \'Criatura — Sabio\', \'flavor\': \'Dentro de cada artefacto hay una chispa del alma de su creador. Dentro de cada sabio hay una lámpara que espera esa chispa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165347&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f418b1b7-36f2-4eeb-988d-9a96d4803023\', \'multiverseId\': 165347}, \'multiverseid\': 165347}, {\'name\': \'Sage de Lat-Nam\', \'text\': \'{T}, Sacrifiez un artefact : Piochez une carte.\', \'type\': \'Créature : sage\', \'flavor\': "Dans chaque instrument réside une étincelle de l\'âme de son créateur. Dans chaque sage est une lampe qui attend cette étincelle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163067&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e65c609c-f846-4725-9589-d97d06c5fd72\', \'multiverseId\': 163067}, \'multiverseid\': 163067}, {\'name\': \'Saggio di Lat-Nam\', \'text\': \'{T}, Sacrifica un artefatto: Pesca una carta.\', \'type\': \'Creatura — Sage\', \'flavor\': "Dentro ogni congegno c\'è una scintilla dell\'anima del suo creatore. Dentro ogni saggio c\'è una lampada che attende quella scintilla.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164990&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f107911-aac1-4458-a55c-40a77c08eee4\', \'multiverseId\': 164990}, \'multiverseid\': 164990}, {\'name\': \'ラト＝ナムの賢人\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'909b1d53-ffda-41ee-b8fc-5a30a6119e1f\'}, \'multiverseid\': None}, {\'name\': \'Sábio de Lat-Nam\', \'text\': \'{T}, Sacrifique um artefato: Compre um card.\', \'type\': \'Criatura — Sábio\', \'flavor\': \'Dentro de cada aparelho há uma centelha da alma de seu criador. Dentro de cada sábio há uma lâmpada à espera dessa centelha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9785aebb-eca5-47f9-8c8f-7e07234c0729\', \'multiverseId\': 165704}, \'multiverseid\': 165704}]', '[{\'name\': \'Wiederbelebung\', \'text\': \'Bringe eine grüne Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Hexerei\', \'flavor\': \'Dryaden schaffen es, Dinge zurückzubringen, die für immer verloren schienen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162889&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2bc5f197-d938-4b11-86d3-5894c22fdceb\', \'multiverseId\': 162889}, \'multiverseid\': 162889}, {\'name\': \'Revivir\', \'text\': \'Regresa la carta objetivo verde de tu cementerio a tu mano.\', \'type\': \'Conjuro\', \'flavor\': \'Incluso lo que nadie recuerda que se perdió regresa cuando es persuadido por la mano de una dríada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165526&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60f0c491-3064-422b-8cf8-b856c4ea683c\', \'multiverseId\': 165526}, \'multiverseid\': 165526}, {\'name\': \'Ravivement\', \'text\': \'Renvoyez une carte verte ciblée depuis votre cimetière dans votre main.\', \'type\': \'Rituel\', \'flavor\': "La main des dryades peut même rappeler ce qu\'on croit perdu à jamais.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163246&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd889df8-6e33-4941-ba70-b312bc8b12e6\', \'multiverseId\': 163246}, \'multiverseid\': 163246}, {\'name\': \'Rivivere\', \'text\': \'Riprendi in mano una carta bersaglio verde dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'Anche ciò che è perso oltre ogni speranza ritorna se viene richiamato dalla mano di una driade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165169&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0072a1a0-8d25-42cf-8f71-3ff1a03f5f3e\', \'multiverseId\': 165169}, \'multiverseid\': 165169}, {\'name\': \'生き返り\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2280020-b7be-4736-9838-1432df6057cf\'}, \'multiverseid\': None}, {\'name\': \'Reviver\', \'text\': \'Devolve o card verde alvo de seu cemitério para sua mão.\', \'type\': \'Feitiço\', \'flavor\': \'Mesmo o que está perdido além da lembrança retorna quando é persuadido pelas mão de uma dríade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165883&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ef460041-9513-4583-87d4-8a3ed028476a\', \'multiverseId\': 165883}, \'multiverseid\': 165883}]', '[{\'name\': \'Windsceada\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'„Dort drob schießt sie durch Luft und Licht, Weit über jeder Ruh, Die Last der Erde bind\\\'t sie nicht, Kein Schatten setzt ihr zu." —Thomas Moore, „Oh wenn ich Flügel hätt"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d0df4dc2-ee70-45d8-98f9-563e0bcd1594\', \'multiverseId\': 162727}, \'multiverseid\': 162727}, {\'name\': \'Draco del viento\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Draco\', \'flavor\': \'"Pero se remonta en lo alto a través del aire y la luz,sobre todos los obstáculos, donde nada terrenal limita su vuelo, y ninguna sombra oscurece su camino." —Thomas Moore, "Oh si tuviera yo alas"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165364&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a4a5519-1f6d-4bb4-be06-d078acf3b01e\', \'multiverseId\': 165364}, \'multiverseid\': 165364}, {\'name\': \'Drakôn des vents\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : drakôn\', \'flavor\': "« L\'aigle alors jette au loin ces dépouilles opimes Et, l\'aile ouverte au vent, vole vers le soleil. » —Verlaine, Poèmes saturniens", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163084&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a13ceef-3620-49ae-a07a-1281a90b5b94\', \'multiverseId\': 163084}, \'multiverseid\': 163084}, {\'name\': \'Draghetto del Vento\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'"Ma vola alta attraverso l\\\'aria e la luce, Sopra a qualsiasi infima barriera, Dove niente di terreno impedisce il suo volo, Né l\\\'ombra oscura la sua strada". —Thomas Moore, "Oh that I had Wings"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165007&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d129e8ef-264e-46c3-8436-b34aded505a7\', \'multiverseId\': 165007}, \'multiverseid\': 165007}, {\'name\': \'風のドレイク\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'275b34cd-d13c-49cc-ba1e-4199b6d5f207\'}, \'multiverseid\': None}, {\'name\': \'Dragonete do Vento\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'"Para o alto ela vai, risca o ar e a luz, Sobre tudo o que abaixo atrasa e reduz, Onde nada da terra seu vôo prende, Nem sombra qualquer sua rota surpreende" — Thomas Moore, "Ah, se eu tivesse Asas"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165721&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c4e218f-2399-422f-98f2-8378867844ed\', \'multiverseId\': 165721}, \'multiverseid\': 165721}]', '[{\'name\': \'Winterschlaf\', \'text\': \'Bringe alle grünen bleibenden Karten auf die Hand ihrer Besitzer zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der tiefe Schlaf im Winter ist nicht immer erholsam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8bb94a7-de90-401d-8a11-234c62f63028\', \'multiverseId\': 162695}, \'multiverseid\': 162695}, {\'name\': \'Hibernación\', \'text\': \'Regresa todos los permanentes verdes a las manos de sus propietarios.\', \'type\': \'Instantáneo\', \'flavor\': \'El profundo sueño del invierno no siempre es descansado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165332&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6373af01-0d66-4520-bd06-758d175e4d3c\', \'multiverseId\': 165332}, \'multiverseid\': 165332}, {\'name\': \'Hibernation\', \'text\': \'Renvoyez tous les permanents verts dans les mains de leurs propriétaires.\', \'type\': \'Éphémère\', \'flavor\': "Le sommeil hivernal n\'est pas de tout repos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163052&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0612e4b-362e-4a6d-a94c-d4afbbfad995\', \'multiverseId\': 163052}, \'multiverseid\': 163052}, {\'name\': \'Letargo\', \'text\': \'I proprietari riprendono in mano tutti i permanenti verdi.\', \'type\': \'Istantaneo\', \'flavor\': "Il sonno profondo dell\'inverno non sempre porta riposo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164975&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c78fc204-b2a1-4cc4-9ea2-2b0d1d3e374e\', \'multiverseId\': 164975}, \'multiverseid\': 164975}, {\'name\': \'冬眠\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6464a34-8020-4313-b5a9-c5f45073963f\'}, \'multiverseid\': None}, {\'name\': \'Hibernação\', \'text\': \'Devolve todas as permanentes verdes para as mãos de seus donos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Nem sempre o sono profundo do inverno é reparador.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165689&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bde2112-abde-4f4c-9b48-28ceea7f5515\', \'multiverseId\': 165689}, \'multiverseid\': 165689}]', "[{'name': 'Wucherndes Wachstum', 'text': 'Durchsuche deine Bibliothek nach einem Standardland und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die Natur lässt die Lösungen für ihre Probleme einfach sprießen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162887&type=card', 'language': 'German', 'identifiers': {'scryfallId': '51ca6c69-ac4d-43c0-8875-290c681c3178', 'multiverseId': 162887}, 'multiverseid': 162887}, {'name': 'Crecimiento exuberante', 'text': 'Busca en tu biblioteca una carta de tierra básica y pon en juego esa carta girada. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'La naturaleza cultiva soluciones para sus problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165524&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ff2a7fd8-063d-4d0e-9aa9-8f1a577255fd', 'multiverseId': 165524}, 'multiverseid': 165524}, {'name': 'Croissance luxuriante', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base et mettez cette carte en jeu engagée. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'La nature crée des solutions à ses problèmes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163244&type=card', 'language': 'French', 'identifiers': {'scryfallId': '88412220-c4b2-4ce7-ba8a-001429cfd95e', 'multiverseId': 163244}, 'multiverseid': 163244}, {'name': 'Crescita Inarrestabile', 'text': 'Passa in rassegna il tuo grimorio, scegli una carta terra base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'La natura genera soluzioni ai propri problemi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165167&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'af11c69c-29db-4f6b-aabf-c18ccb3a8635', 'multiverseId': 165167}, 'multiverseid': 165167}, {'name': '不屈の自然', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'aeb276e2-3122-4c43-acd9-4be63ea10dd3'}, 'multiverseid': None}, {'name': 'Crescimento Exuberante', 'text': 'Procure em seu grimório por um card de terreno básico e coloque-o em jogo virado. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'A natureza cria soluções para seus problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165881&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f1416a95-6ae3-4b7d-9d8b-218b8c6f0c01', 'multiverseId': 165881}, 'multiverseid': 165881}]", '[{\'name\': \'Wurzelkraft\', \'text\': \'Immer wenn ein Spieler einen grünen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Durch tausend Glieder gestärkt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162934&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c10c908-91c4-4fe8-83b5-e08a7b80b6d9\', \'multiverseId\': 162934}, \'multiverseid\': 162934}, {\'name\': \'Esfera de madera\', \'text\': \'Siempre que un jugador juegue un hechizo verde, puedes pagar {1}. Si lo haces, ganas 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'Fortalecida por mil ramas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165571&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5cfe1ff8-b752-49fe-84fa-6c10971c3e17\', \'multiverseId\': 165571}, \'multiverseid\': 165571}, {\'name\': \'Sphère de bois\', \'text\': "À chaque fois qu\'un joueur joue un sort vert, vous pouvez payer {1}. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Portée par un millier de bras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163291&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0def4937-626e-4183-b55a-7ad63b5c298b\', \'multiverseId\': 163291}, \'multiverseid\': 163291}, {\'name\': \'Sfera di Legno\', \'text\': \'Ogniqualvolta un giocatore gioca una magia verde, puoi spendere {1}. Se lo fai, guadagni 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'Rafforzato da un migliaio di rami.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165214&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb64814d-ae5d-4a0f-b88d-7022e0947ed2\', \'multiverseId\': 165214}, \'multiverseid\': 165214}, {\'name\': \'森の宝球\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'12134a2b-24c2-43ba-bafb-8d22c7b51361\'}, \'multiverseid\': None}, {\'name\': \'Esfera de Madeira\', \'text\': \'Toda vez que um jogador jogar uma mágica verde, você pode pagar {1}. Se o fizer, você ganha 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Fortalecida por mil ramos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09abbeb8-9bdb-4c59-ac67-727355cf6035\', \'multiverseId\': 165928}, \'multiverseid\': 165928}]', '[{\'name\': \'Wütender Goblin\', \'text\': \'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen.)\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'Er tobte gegen die Welt, gegen seine Familie, gegen sein Leben. Aber hauptsächlich tobte er.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162825&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0271f6d5-365c-4728-ab43-9bdff2b09bed\', \'multiverseId\': 162825}, \'multiverseid\': 162825}, {\'name\': \'Trasgo furioso\', \'text\': \'Prisa. (Esta criatura puede atacar el turno en que entre bajo tu control.)\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'Estaba furioso con su mundo, con su familia, con su vida. Pero principalmente, sólo estaba furioso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165462&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2b527631-178f-4ec6-be86-d85f681d0b56\', \'multiverseId\': 165462}, \'multiverseid\': 165462}, {\'name\': \'Gobelin enragé\', \'text\': \'Célérité (Cette créature peut attaquer dès le tour où elle arrive sous votre contrôle.)\', \'type\': \'Créature : gobelin\', \'flavor\': "Il enrageait contre le monde, contre sa famille, contre lui-même. Mais en fait, il n\'avait pas vraiment besoin d\'enrager contre quelque chose de précis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163182&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7e43707-547b-42ec-8018-1b3e60042bfb\', \'multiverseId\': 163182}, \'multiverseid\': 163182}, {\'name\': \'Goblin Furioso\', \'text\': \'Rapidità (Questa creatura può attaccare nel turno in cui entra sotto il tuo controllo.)\', \'type\': \'Creatura — Goblin\', \'flavor\': \'È arrabbiato con il mondo, con la propria famiglia e con la vita. Più che altro è arrabbiato e basta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165105&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'95456c36-f26f-4092-b838-dbd441c96db4\', \'multiverseId\': 165105}, \'multiverseid\': 165105}, {\'name\': \'怒り狂うゴブリン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5eb4504b-1c2f-4538-84e0-acd943a8dac8\'}, \'multiverseid\': None}, {\'name\': \'Goblin Enfurecido\', \'text\': \'Ímpeto (Esta criatura pode atacar no turno em que entra em jogo sob seu controle.)\', \'type\': \'Criatura — Goblin\', \'flavor\': \'Ele se enfurecia com o mundo, com sua família, com sua vida. Mas acima de tudo, ele se enfurecia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165819&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e9c58139-d82a-404f-9c89-14c28b4df91b\', \'multiverseId\': 165819}, \'multiverseid\': 165819}]', '[{\'name\': \'Wütendwerden\', \'text\': \'Eine Kreatur deiner Wahl erhält +X/+0 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Du wirst mich nicht mögen, wenn ich ärgerlich werde."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162798&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32b4b57d-143c-40b9-a4b1-256ef6d270c4\', \'multiverseId\': 162798}, \'multiverseid\': 162798}, {\'name\': \'Encolerizar\', \'text\': \'La criatura objetivo obtiene +X/+0 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Yo no te agradaría si me enojara".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165435&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e980f9f6-3e2e-48bf-b942-5c469fa95d82\', \'multiverseId\': 165435}, \'multiverseid\': 165435}, {\'name\': \'Enrager\', \'text\': "La créature ciblée gagne +X/+0 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Là je suis calme Vous me verriez quand je suis en colère... »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163155&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1374c669-7441-4971-bb51-1a3b9353f3a4\', \'multiverseId\': 163155}, \'multiverseid\': 163155}, {\'name\': \'Infuriare\', \'text\': \'La creatura bersaglio prende +X/+0 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non ti piacerei quando sono arrabbiato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165078&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f15a54d-5f1e-4f57-a405-72bcb76a1bad\', \'multiverseId\': 165078}, \'multiverseid\': 165078}, {\'name\': \'怒髪天\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'469920c8-d9d5-4a8e-9bb0-dfc8a8736dca\'}, \'multiverseid\': None}, {\'name\': \'Enfurecer\', \'text\': \'A criatura alvo recebe +X/+0 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você não gostaria de me ver zangado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165792&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'feb8ce11-4a91-4c91-9981-b514f5a09ddf\', \'multiverseId\': 165792}, \'multiverseid\': 165792}]', '[{\'name\': \'Yavimayablütenzauberin\', \'text\': \'Die Yavimayablütenzauberin erhält +1/+1 für jede Verzauberung im Spiel.\', \'type\': \'Kreatur — Druide\', \'flavor\': \'Ihre Wurzeln verbinden sie mit den Wünschen des Waldes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162903&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86367607-925a-478c-aa2c-cbb66401dd74\', \'multiverseId\': 162903}, \'multiverseid\': 162903}, {\'name\': \'Hechicera de Yavimaya\', \'text\': \'La Hechicera de Yavimaya obtiene +1/+1 por cada encantamiento que haya en juego.\', \'type\': \'Criatura — Druida\', \'flavor\': \'Sus raíces la conectan con los deseos del bosque.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165540&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'400f4f05-e0d2-44c0-8d53-433f85049d0d\', \'multiverseId\': 165540}, \'multiverseid\': 165540}, {\'name\': \'Enchanteresse de la Yavimaya\', \'text\': "L\'Enchanteresse de la Yavimaya gagne +1/+1 pour chaque enchantement en jeu.", \'type\': \'Créature : druide\', \'flavor\': \'Ses racines la relient aux désirs de la forêt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163260&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7e1efcac-fa89-49be-a423-3cc4d0d2bebb\', \'multiverseId\': 163260}, \'multiverseid\': 163260}, {\'name\': \'Incantatrice di Yavimaya\', \'text\': "L\'Incantatrice di Yavimaya prende +1/+1 per ogni incantesimo in gioco.", \'type\': \'Creatura — Druido\', \'flavor\': \'Le sue radici la tengono in contatto con i desideri della foresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165183&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7fb9e186-c796-4ceb-90b1-4641ef154dd8\', \'multiverseId\': 165183}, \'multiverseid\': 165183}, {\'name\': \'ヤヴィマヤの女魔術師\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b693d75e-8ba9-4fba-a739-916be73c4bf3\'}, \'multiverseid\': None}, {\'name\': \'Encantadora de Yavimaya\', \'text\': \'Encantadora de Yavimaya recebe +1/+1 para cada encantamento em jogo.\', \'type\': \'Criatura — Druida\', \'flavor\': \'Suas raízes a conectam aos desejos da floresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165897&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45b7cdd5-0b07-449c-9e59-01609e865bba\', \'multiverseId\': 165897}, \'multiverseid\': 165897}]', '[{\'name\': \'Zauberbuch\', \'text\': \'Es gibt keine Obergrenze für die Anzahl der Karten, die du auf der Hand halten darfst.\', \'type\': \'Artefakt\', \'flavor\': \'Wissen kennt keine Grenzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162927&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd6c8947-b5b9-4259-993c-d885c39f631d\', \'multiverseId\': 162927}, \'multiverseid\': 162927}, {\'name\': \'Libro de hechizos\', \'text\': \'Tu mano no tiene tamaño máximo.\', \'type\': \'Artefacto\', \'flavor\': \'El conocimiento no conoce límites.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165564&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5664ba67-224d-4b4c-9550-06e3e1311a25\', \'multiverseId\': 165564}, \'multiverseid\': 165564}, {\'name\': \'Livre de sorts\', \'text\': "Il n\'y a pas de limite au nombre de cartes dans votre main.", \'type\': \'Artefact\', \'flavor\': \'La connaissance ne connaît pas de limite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163284&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4e1d17c-5f3a-47f7-85dd-50b674f3c1c9\', \'multiverseId\': 163284}, \'multiverseid\': 163284}, {\'name\': \'Libro delle Magie\', \'text\': \'Non hai più il limite di carte nella mano.\', \'type\': \'Artefatto\', \'flavor\': \'La conoscenza non ha confini.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165207&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'24fc529a-6c90-4274-b521-9f208c26a00a\', \'multiverseId\': 165207}, \'multiverseid\': 165207}, {\'name\': \'呪文書\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e874a4c-653d-4d93-a786-e31c44a5eb63\'}, \'multiverseid\': None}, {\'name\': \'Livro de Mágicas\', \'text\': \'Você não tem o tamanho de mão máximo.\', \'type\': \'Artefato\', \'flavor\': \'O conhecimento não conhece fronteiras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165921&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9d9d029-691f-408f-ae2e-3b537d991b1b\', \'multiverseId\': 165921}, \'multiverseid\': 165921}]', '[{\'name\': \'Zeittalent\', \'text\': \'{U}{U}{U}, {T}: Bringe eine bleibende Karte deiner Wahl auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreatur — Zauberer\', \'flavor\': \'„Natürlich ist sie Klassenbeste. Alle ihre Mitschülerinnen sind verschwunden." —Tolarianischer Renegat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162719&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f240c681-cd10-4a76-909d-f981eca48ef0\', \'multiverseId\': 162719}, \'multiverseid\': 162719}, {\'name\': \'Perito temporal\', \'text\': \'{U}{U}{U}, {T}: Regresa el permanente objetivo a la mano de su propietario.\', \'type\': \'Criatura — Hechicero\', \'flavor\': \'"Claro que está en primer lugar de su clase. Todos sus compañeros desaparecieron." Renegado tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165356&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9598aec2-756e-462d-9f7e-dd9a37e672f6\', \'multiverseId\': 165356}, \'multiverseid\': 165356}, {\'name\': \'Expert en temporalité\', \'text\': \'{U}{U}{U}, {T} : Renvoyez le permanent ciblé dans la main de son propriétaire.\', \'type\': \'Créature : sorcier\', \'flavor\': \'« Bien sûr, elle est la première de la classe. Tous ses camarades ont disparu. » — Un renégat tolarian.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163076&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c870a34-bba5-426d-8941-010384f91cd8\', \'multiverseId\': 163076}, \'multiverseid\': 163076}, {\'name\': \'Cronomante\', \'text\': \'{U}{U}{U}, {T}: Il proprietario riprende in mano un permanente bersaglio.\', \'type\': \'Creatura — Mago\', \'flavor\': \'"Certo che è la migliore della classe. Tutti i suoi compagni sono scomparsi". —rinnegato di Tolaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164999&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e833d162-4163-4c0d-ab86-e2f53e52ee8f\', \'multiverseId\': 164999}, \'multiverseid\': 164999}, {\'name\': \'時間の名人\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d47eaa62-23b0-4940-8e28-9544b9e05e17\'}, \'multiverseid\': None}, {\'name\': \'Adepto Temporal\', \'text\': \'{U}{U}{U}, {T}: Devolve a permanente alvo para a mão de seu dono.\', \'type\': \'Criatura — Mago\', \'flavor\': \'"Claro que ela é a primeira da classe. Todos os seus outros colegas desapareceram." — Renegado tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165713&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24b7adcb-232a-48cc-885f-87db08a2148f\', \'multiverseId\': 165713}, \'multiverseid\': 165713}]', '[{\'name\': \'Zerfledderte Legion\', \'text\': \'Verursacht Furcht (Diese Kreatur kann nur von Artefaktkreaturen und/oder schwarzen Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Nach Sonnenuntergang macht niemand in Aphetto die Tür auf, wenn es klopft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162776&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'adeda215-2475-4124-a8d3-25608daf01f2\', \'multiverseId\': 162776}, \'multiverseid\': 162776}, {\'name\': \'Legión cercenada\', \'text\': \'Inspirar temor. (Esta criatura no puede ser bloqueada excepto por criaturas artefacto y/o criaturas negras.)\', \'type\': \'Criatura — Zombie\', \'flavor\': \'En Afetto nadie responde cuando llaman a la puerta después de la puesta del sol.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165413&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db874960-efbc-4864-81b8-5882065dd8ed\', \'multiverseId\': 165413}, \'multiverseid\': 165413}, {\'name\': \'Légion sectionnée\', \'text\': \'Peur (Cette créature ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures noires.)\', \'type\': \'Créature : zombie\', \'flavor\': "À Aphetto, personne n\'ouvre quand on frappe à la porte après le crépuscule.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163133&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'52b69c5f-e7b5-4090-a60d-167a28a49ae4\', \'multiverseId\': 163133}, \'multiverseid\': 163133}, {\'name\': \'Legione di Arti\', \'text\': \'Paura (Questa creatura non può essere bloccata tranne che da creature artefatto e/o da creature nere.)\', \'type\': \'Creatura — Zombie\', \'flavor\': \'Nessuno ad Aphetto risponde a chi bussa dopo il tramonto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165056&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5875a982-464c-48ae-8cce-ef22fc410b21\', \'multiverseId\': 165056}, \'multiverseid\': 165056}, {\'name\': \'切り刻まれた軍勢\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8190fbc9-7a57-4ddd-bfe9-a7a630f813e4\'}, \'multiverseid\': None}, {\'name\': \'Legião Apartada\', \'text\': \'Amedrontar (Esta criatura só pode ser bloqueada por criaturas pretas e/ou criaturas artefato.)\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Em Aphetto, ninguém atende à porta após o pôr-do-sol.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165770&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b95457e-3eeb-4fa1-9ae3-72134ed2dd70\', \'multiverseId\': 165770}, \'multiverseid\': 165770}]', '[{\'name\': \'Zersplittern\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162833&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7d843e3-b789-4ec7-9346-1cb6b09a8318\', \'multiverseId\': 162833}, \'multiverseid\': 162833}, {\'name\': \'Romper\', \'text\': \'Destruye el artefacto objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165470&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7c896c16-9fb8-401c-8056-b939280a3382\', \'multiverseId\': 165470}, \'multiverseid\': 165470}, {\'name\': \'Fracasser\', \'text\': "Détruisez l\'artefact ciblé.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163190&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4bf81d53-99c9-40c8-87df-a33e735cf557\', \'multiverseId\': 163190}, \'multiverseid\': 163190}, {\'name\': \'Distruggi Artefatto\', \'text\': \'Distruggi un artefatto bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165113&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44dda216-cff0-4180-a3ee-38d70e1a4661\', \'multiverseId\': 165113}, \'multiverseid\': 165113}, {\'name\': \'粉砕\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4a92ff4-7620-427d-9b70-fb26f6ac5ef7\'}, \'multiverseid\': None}, {\'name\': \'Estilhaçar\', \'text\': \'Destrói o artefato alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165827&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b1fb07bb-d87e-4c27-b789-5851bba6921f\', \'multiverseId\': 165827}, \'multiverseid\': 165827}]', '[{\'name\': \'Zombifizierung\', \'text\': \'Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Die erste Geburt feiert das Leben. Die zweite Geburt verhöhnt es." —Älterer Mystiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162787&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'755d00c2-6a2e-46ec-b417-b72373175da6\', \'multiverseId\': 162787}, \'multiverseid\': 162787}, {\'name\': \'Zombificar\', \'text\': \'Regresa la carta de criatura objetivo de tu cementerio al juego.\', \'type\': \'Conjuro\', \'flavor\': \'"El primer nacimiento celebra la vida. El segundo nacimiento se burla de ella."—Anciano místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165424&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebae128c-19a1-4494-853c-f3e867ce72c9\', \'multiverseId\': 165424}, \'multiverseid\': 165424}, {\'name\': \'Zombification\', \'text\': \'Renvoyez en jeu la carte de créature ciblée de votre cimetière.\', \'type\': \'Rituel\', \'flavor\': "« La première naissance célèbre la vie. La seconde s\'en moque. » —Un doyen des mystiques", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163144&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2dc1dc8c-a339-4f68-81d7-573fbe225391\', \'multiverseId\': 163144}, \'multiverseid\': 163144}, {\'name\': \'Zombificare\', \'text\': \'Rimetti in gioco una carta creatura bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"La prima nascita celebra la vita. La seconda la sbeffeggia." —Anziano mistico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165067&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ded36b8-1afd-4c74-ab56-b9aeb206401f\', \'multiverseId\': 165067}, \'multiverseid\': 165067}, {\'name\': \'ゾンビ化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6b28c5a-447c-48d4-9f13-533b6e0315eb\'}, \'multiverseid\': None}, {\'name\': \'Zumbificar\', \'text\': \'Devolva para o jogo o card alvo de criatura de seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'"O primeiro nascimento celebra a vida. O segundo nascimento zomba dela." — Ancião místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165781&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7989c47a-b623-4866-b269-fd171a4fbf89\', \'multiverseId\': 165781}, \'multiverseid\': 165781}]', "[{'name': 'Zorn Gottes', 'text': 'Zerstöre alle Kreaturen. Sie können nicht regeneriert werden.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162671&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2404ac2c-0e74-47dd-81af-1ba7f0dbf6cc', 'multiverseId': 162671}, 'multiverseid': 162671}, {'name': 'Ira de Dios', 'text': 'Destruye todas las criaturas. No pueden ser regeneradas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165308&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c33dba36-9209-4298-862d-459dec62722d', 'multiverseId': 165308}, 'multiverseid': 165308}, {'name': 'Colère de Dieu', 'text': 'Détruisez toutes les créatures. Elles ne peuvent pas être régénérées.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163028&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c11b0a37-1397-4553-932f-04b0a473a472', 'multiverseId': 163028}, 'multiverseid': 163028}, {'name': 'Ira di Dio', 'text': 'Distruggi tutte le creature. Non possono essere rigenerate.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164951&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5c18d148-e5fc-4816-a998-a8813270c181', 'multiverseId': 164951}, 'multiverseid': 164951}, {'name': '神の怒り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4213fdb1-4f5c-4a3d-96f2-49f585672c72'}, 'multiverseid': None}, {'name': 'Cólera de Deus', 'text': 'Destrói todas as criaturas. Elas não podem ser regeneradas.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165665&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2531d137-fb86-4b16-89f1-34210ea6bad9', 'multiverseId': 165665}, 'multiverseid': 165665}]", '[{\'name\': \'Zurs bizarre Welt\', \'text\': \'Alle Spieler spielen mit offenen Karten.\\nFalls ein Spieler eine Karte ziehen würde, zeigt er sie stattdessen offen vor. Dann kann jeder andere Spieler 2 Lebenspunkte bezahlen. Falls ein Spieler dies tut, lege die Karte auf den Friedhof ihres Besitzers. Sonst zieht dieser Spieler die Karte.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162729&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e45bffb-85e2-4804-9b9f-949b8646ce0f\', \'multiverseId\': 162729}, \'multiverseid\': 162729}, {\'name\': \'Presagio de Zur\', \'text\': \'Los jugadores juegan mostrando sus manos.Si un jugador fuera a robar una carta, en vez de eso, la muestra.\\n Luego cualquier otro jugador puede pagar 2 vidas. Si algún jugador lo hace, pon esa carta en el cementerio de su propietario. De lo contrario, el jugador roba la carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165366&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2c568f54-623b-423d-b19d-3530d67a6166\', \'multiverseId\': 165366}, \'multiverseid\': 165366}, {\'name\': \'Déterminisme selon Zur\', \'text\': "Les joueurs jouent avec leurs mains révélées.\\nSi un joueur devait piocher une carte, il la révèle à la place. N\'importe quel autre joueur peut ensuite payer 2 points de vie. Si c\'est le cas, mettez cette carte dans le cimetière de son propriétaire. Sinon, ce joueur pioche la carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163086&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b1d4cb8-7c77-4615-bc07-98936541b112\', \'multiverseId\': 163086}, \'multiverseid\': 163086}, {\'name\': \'Malia di Zur\', \'text\': \'I giocatori giocano a carte scoperte.\\nSe un giocatore sta per pescare una carta, invece la rivela. Poi ogni altro giocatore può pagare 2 punti vita. Se un giocatore paga, metti quella carta nel cimitero del suo proprietario. Altrimenti, quel giocatore pesca la carta.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d4a3a0a-991d-4303-8608-ee15b38ab640\', \'multiverseId\': 165009}, \'multiverseid\': 165009}, {\'name\': \'ズアーの運命支配\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8fb2f0f7-d0ec-46a9-bcf9-2d9fc1d137a3\'}, \'multiverseid\': None}, {\'name\': \'Fatalidade de Zur\', \'text\': \'Os jogadores jogam com os cards de suas mãos revelados.\\nSe um jogador fosse comprar um card, ele próprio o revela em vez disso. Depois, qualquer outro jogador pode pagar 2 pontos de vida. Se um jogador o fizer, coloque aquele card no cemitério de seu dono. Se não, aquele jogador compra o card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165723&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a514cbe-95ce-4927-9a58-425a407d68a2\', \'multiverseId\': 165723}, \'multiverseid\': 165723}]', '[{\'name\': \'Zurückdrehen\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl und enttappe dann bis zu vier Länder.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Lass uns das noch einmal durchgehen..."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162709&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5b384009-eebd-49f9-bb73-a43c06ca28ed\', \'multiverseId\': 162709}, \'multiverseid\': 162709}, {\'name\': \'Retroceder\', \'text\': \'Contrarresta el hechizo objetivo, luego endereza hasta cuatro tierras.\', \'type\': \'Instantáneo\', \'flavor\': \'"Repasemos esto una vez más . . .".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165346&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e239c0c-9e11-4995-8e02-8cb49c28a926\', \'multiverseId\': 165346}, \'multiverseid\': 165346}, {\'name\': \'Rembobinage\', \'text\': "Contrecarrez le sort ciblé, et dégagez ensuite jusqu\'à quatre terrains.", \'type\': \'Éphémère\', \'flavor\': \'« Encore une fois . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163066&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc9eef2d-436b-45e9-94d2-56f2ce5afcbb\', \'multiverseId\': 163066}, \'multiverseid\': 163066}, {\'name\': \'Rifare\', \'text\': \'Neutralizza una magia bersaglio, poi STAPpa fino a quattro terre.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ripetiamolo ancora una volta. . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164989&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'520c090a-f035-4cd6-8f47-40d345375d4a\', \'multiverseId\': 164989}, \'multiverseid\': 164989}, {\'name\': \'巻き直し\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a5dc603-4ca5-4877-b314-0d0390f10b77\'}, \'multiverseid\': None}, {\'name\': \'Retroceder\', \'text\': \'Anula a mágica alvo e depois desvira até quatro terrenos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Vamos recapitular mais uma vez. . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165703&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f6e753f-db56-4e5e-bb5f-a3d272928a31\', \'multiverseId\': 165703}, \'multiverseid\': 165703}]', '[{\'name\': \'Zwangsabgabe\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Bestimme eine Karte davon. Dieser Spieler wirft diese Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Menschliche Zärtlichkeit ist nichts naderes als hübsch verpackte Verweichlichkeit."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'07087df5-65f8-4693-864f-d3fbdbfecfb3\', \'multiverseId\': 162735}, \'multiverseid\': 162735}, {\'name\': \'Coerción\', \'text\': \'El oponente objetivo muestra su mano. Elige una carta de ahí. Ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'"El cariño humano es simplemente debilidad en un paquete bonito".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165372&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9de74b38-e78b-42f5-8290-aaa0dc1975d0\', \'multiverseId\': 165372}, \'multiverseid\': 165372}, {\'name\': \'Coercition\', \'text\': "L\'adversaire ciblé révèle sa main. Choisissez-y une carte. Ce joueur se défausse de cette carte.", \'type\': \'Rituel\', \'flavor\': "« Tendresse est tendance à se livrer en toute faiblesse à la douceur d\'être faible. » —Paul Valéry", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163092&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c13bdc4f-1e9c-4ce5-be78-5553595f95c9\', \'multiverseId\': 163092}, \'multiverseid\': 163092}, {\'name\': \'Coercizione\', \'text\': "L\'avversario bersaglio rivela la propria mano. Scegli una carta da essa. Quel giocatore scarta quella carta.", \'type\': \'Stregoneria\', \'flavor\': \'"La tenerezza umana è semplice debolezza ben confezionata".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e02d39e-d177-4a7e-8b81-ceccd02b01b6\', \'multiverseId\': 165015}, \'multiverseid\': 165015}, {\'name\': \'強要\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd96f05f-afce-449b-8771-25fdd3572989\'}, \'multiverseid\': None}, {\'name\': \'Coerção\', \'text\': \'O oponente alvo revela sua própria mão. Escolha um card dela. Aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'"A suavidade humana não passa de fraqueza numa bela embalagem."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165729&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cc411c23-752b-4811-807d-1d2f032b4ca6\', \'multiverseId\': 165729}, \'multiverseid\': 165729}]', '[{\'name\': \'Zweiköpfiger Drache\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\n{1}{R}: Der Zweiköpfige Drache erhält +2/+0 bis zum Ende des Zuges.\\nDer Zweiköpfige Drache kann nicht von weniger als zwei Kreaturen geblockt werden.\\nDer Zweiköpfige Drache kann eine zusätzliche Kreatur blocken.\', \'type\': \'Kreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162842&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5bf33ad-b16a-4b7f-a886-b7ddf2a88abc\', \'multiverseId\': 162842}, \'multiverseid\': 162842}, {\'name\': \'Dragón de dos cabezas\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\n{1}{R}: El Dragón de dos cabezas obtiene +2/+0 hasta el final del turno.\\nEl Dragón de dos cabezas no puede ser bloqueado excepto por dos o más criaturas.\\nEl Dragón de dos cabezas puede bloquear a una criatura adicional.\', \'type\': \'Criatura — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165479&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec00d872-439c-45c1-9882-14f707541ed7\', \'multiverseId\': 165479}, \'multiverseid\': 165479}, {\'name\': \'Dragon à deux têtes\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\n{1}{R} : Le Dragon à deux têtes gagne +2/+0 jusqu\'à la fin du tour.\\nLe Dragon à deux têtes ne peut pas être bloqué excepté par deux créatures ou plus.\\nLe Dragon à deux têtes peut bloquer une créature supplémentaire.", \'type\': \'Créature : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163199&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d040db91-976d-4c3e-aab8-595dd3c09956\', \'multiverseId\': 163199}, \'multiverseid\': 163199}, {\'name\': \'Drago a Due Teste\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\n{1}{R}: Il Drago a Due Teste prende +2/+0 fino alla fine del turno.\\nIl Drago a Due Teste non può essere bloccato tranne che da due o più creature.\\nIl Drago a Due Teste può bloccare una creatura addizionale.\', \'type\': \'Creatura — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165122&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5420450a-f2ff-49e9-b356-ce92166cce54\', \'multiverseId\': 165122}, \'multiverseid\': 165122}, {\'name\': \'双頭のドラゴン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e22dd988-2eac-4f85-b616-7669ee881327\'}, \'multiverseid\': None}, {\'name\': \'Dragão de Duas Cabeças\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\n{1}{R}: Dragão de Duas Cabeças recebe +2/+0 até o final do turno.\\nDragão de Duas Cabeças só pode ser bloqueado por duas ou mais criaturas.\\nDragão de Duas Cabeças pode bloquear uma criatura adicional.\', \'type\': \'Criatura — Dragão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165836&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'da01c876-5e8f-4f36-b0d3-b62c56db0c07\', \'multiverseId\': 165836}, \'multiverseid\': 165836}]', '[{\'name\': \'Zwerg-Gargadon\', \'text\': \'Immer wenn das Zwerg-Gargadon angreift oder blockt, opfere ein Land.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„In manchen Kulturen ist es ein Zeichen von Rang, Würde und Macht, auf einem Elefanten zu reiten. Ich vermute, ein normaler Elefant würde in Keld gar nicht bemerkt werden." —Oneanischer Hauptmann\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162812&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c261ca79-680c-40e9-81ae-c643e6231e75\', \'multiverseId\': 162812}, \'multiverseid\': 162812}, {\'name\': \'Gigantodón menor\', \'text\': \'Siempre que el Gigantodón menor ataque o bloquee, sacrifica una tierra.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"En algunas culturas, quienes tienen el poder montan elefantes. No creo que un mero elefante sería notado en Keld".—Sargento oneano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165449&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8bf6b027-8412-46f6-b3a0-c7747ebf25b1\', \'multiverseId\': 165449}, \'multiverseid\': 165449}, {\'name\': \'Petit gargadon\', \'text\': \'À chaque fois que le Petit gargadon attaque ou bloque, sacrifiez un terrain.\', \'type\': \'Créature : bête\', \'flavor\': "« Dans bien des cultures, les éléphants servent de monture aux puissants. Je ne crois malheureusement pas qu\'un simple éléphant serait remarqué à Keld. » — Un sergent onéan", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163169&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a9d1929-4d6f-476a-ae55-941b4c7a556c\', \'multiverseId\': 163169}, \'multiverseid\': 163169}, {\'name\': \'Gargadonte Minore\', \'text\': \'Ogniqualvolta il Gargadonte Minore attacca o blocca, sacrifica una terra.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"In alcune culture, gli elefanti vengono cavalcati da chi detiene il potere. Penso che a Keld un semplice elefante non verrebbe neppure notato". —Sergente oneano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165092&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0b9fefe7-1e18-463a-bc8e-6db83d2c6432\', \'multiverseId\': 165092}, \'multiverseid\': 165092}, {\'name\': \'レッサー・ガルガドン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'750082c7-220e-4873-8162-2c4f5c726d21\'}, \'multiverseid\': None}, {\'name\': \'Gargadonte Menor\', \'text\': \'Toda vez que Gargadonte Menor atacar ou bloquear, sacrifique um terreno.\', \'type\': \'Criatura — Besta\', \'flavor\': \'"Em algumas culturas, os elefantes são montados pelos poderosos. Eu acho que em Keld um mero elefante nem seria notado." — Sargento de Oneah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165806&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'625a54b3-b488-46bc-a830-9e1ad36671bf\', \'multiverseId\': 165806}, \'multiverseid\': 165806}]', '[{\'name\': \'Zwergen-Zerstörungstrupp\', \'text\': \'{T}: Zerstöre eine Mauer deiner Wahl.\', \'type\': \'Kreatur — Zwerg\', \'flavor\': \'Törichterweise zog sich Najib in seine Festung bei El-Abar zurück; am anderen Morgen war er tot. In nur einer Nacht hatten die Zwerge die mächtigen Mauern in einen Haufen Geröll verwandelt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162797&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'77ff5a97-046f-43d7-a89b-6a793be5fea5\', \'multiverseId\': 162797}, \'multiverseid\': 162797}, {\'name\': \'Equipo enano de demolición\', \'text\': \'{T}: Destruye el Muro objetivo.\', \'type\': \'Criatura — Enano\', \'flavor\': \'Tontamente, Najib se retiró a su castillo en El-Abar; a la siguiente mañana, estaba muerto. En una sola noche, las fuerzas enanas habían reducido los imponentes muros a meros escombros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165434&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'551a46ce-2af1-44e8-84c0-10c376f8ba82\', \'multiverseId\': 165434}, \'multiverseid\': 165434}, {\'name\': \'Équipe de démolition naine\', \'text\': \'{T} : Détruisez le mur ciblé.\', \'type\': \'Créature : nain\', \'flavor\': "Sans réfléchir, Najib se réfugia dans son château d\'El-Abar ; le lendemain matin il était mort. Pendant la nuit, les forces gobelines avaient réduit les puissantes fortifications en poussière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163154&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3bb8cb36-5d93-41fc-b9b3-fd5c310f009a\', \'multiverseId\': 163154}, \'multiverseid\': 163154}, {\'name\': \'Squadra di Demolizione Nanesca\', \'text\': \'{T}: Distruggi un Muro bersaglio.\', \'type\': \'Creatura — Nano\', \'flavor\': \'Stoltamente, Najib si ritirò nel proprio castello a El-Abar; la mattina seguente era già morto. In una sola notte, le forze dei nani avevano ridotto in macerie le possenti mura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165077&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2a2eed4-cb2b-4a99-99bb-00d458912c65\', \'multiverseId\': 165077}, \'multiverseid\': 165077}, {\'name\': \'ドワーフ爆破作業班\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d46a189-12a8-4fef-9a95-128312087947\'}, \'multiverseid\': None}, {\'name\': \'Equipe de Demolição dos Anões\', \'text\': \'{T}: Destrói a Barreira alvo.\', \'type\': \'Criatura — Anão\', \'flavor\': \'Estupidamente, Najib recuou a seu castelo em El-Abar; na manhã seguinte ele estava morto. Em apenas uma noite, as forças dos anões reduziram a entulho as imponentes muralhas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165791&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3ff51a8-f1cf-4005-b875-c2af090722f3\', \'multiverseId\': 165791}, \'multiverseid\': 165791}]', '[{\'name\': \'Zwiespaltsszepter\', \'text\': \'{3}, {T}: Ein Spieler deiner Wahl wirft eine Karte aus seiner Hand ab. Spiele diese Fähigkeit nur während deines Zuges.\', \'type\': \'Artefakt\', \'flavor\': \'„Wahre Macht ist, wenn du nicht nur die Herzen deiner Opfer, sondern auch ihre Gedanken kontrollierst."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'733bb767-80f2-4b28-91cd-260f9462930d\', \'multiverseId\': 162911}, \'multiverseid\': 162911}, {\'name\': \'Cetro disruptor\', \'text\': \'{3}, {T}: El jugador objetivo descarta una carta de su mano. Juega esta habilidad sólo durante tu turno.\', \'type\': \'Artefacto\', \'flavor\': \'"El poder verdadero es controlar no sólo los corazones de tus súbditos, sino también sus mentes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165548&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e57caa0f-ab97-443a-8dc5-0436784338c3\', \'multiverseId\': 165548}, \'multiverseid\': 165548}, {\'name\': \'Sceptre de dislocation\', \'text\': "{3}, {T} : Le joueur ciblé se défausse d\'une carte de sa main. Ne jouez cette capacité que pendant votre tour.", \'type\': \'Artefact\', \'flavor\': "« Être véritablement puissant, c\'est contrôler le cœur de ses sujets, mais aussi leurs esprits. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163268&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca36ab0b-1c5e-4c4e-b67c-0e2e502add17\', \'multiverseId\': 163268}, \'multiverseid\': 163268}, {\'name\': \'Scettro Devastante\', \'text\': \'{3}, {T}: Il giocatore bersaglio scarta una carta dalla propria mano. Gioca questa abilità solo durante il tuo turno.\', \'type\': \'Artefatto\', \'flavor\': \'"Il vero potere è controllare non solo i cuori dei tuoi sottoposti, ma anche le loro menti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165191&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e0b73e06-3fc3-4029-b400-626863744d4e\', \'multiverseId\': 165191}, \'multiverseid\': 165191}, {\'name\': \'破裂の王笏\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cea132e3-1b2c-4da1-a720-eea3512641f4\'}, \'multiverseid\': None}, {\'name\': \'Cetro Desintegrador\', \'text\': \'{3}, {T}: O jogador alvo descarta um card de sua própria mão. Use esta habilidade apenas durante o seu próprio turno.\', \'type\': \'Artefato\', \'flavor\': \'"O verdadeiro poder reside não apenas no controle dos corações de seus súditos, mas também de suas mentes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165905&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2073d550-bd63-4499-bcb4-63fa666e74f2\', \'multiverseId\': 165905}, \'multiverseid\': 165905}]', '[{\'name\': \'Züchtigen\', \'text\': \'Zerstöre eine angreifende Kreatur deiner Wahl. Du erhältst Lebenspunkte in Höhe ihrer Stärke dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Warum beten wir zu der Ahnfrau? Weil Sie uns zuhört." —Älterer Mystiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162622&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a90b5b2-ca13-43c0-a204-ef4b16ed1d72\', \'multiverseId\': 162622}, \'multiverseid\': 162622}, {\'name\': \'Reprender\', \'text\': \'Destruye la criatura atacante objetivo. Ganas una cantidad de vida igual a su fuerza.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Por qué le rezamos a la Antepasada? Porque Ella escucha."—Anciano místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165259&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6afe49f9-4984-499f-965a-2655f330ba7f\', \'multiverseId\': 165259}, \'multiverseid\': 165259}, {\'name\': \'Punition\', \'text\': \'Détruisez la créature attaquante ciblée. Vous gagnez autant de points de vie que sa force.\', \'type\': \'Éphémère\', \'flavor\': "« Pourquoi prions-nous l\'Ancêtre ? Parce qu\'Elle écoute. » —Un doyen des mystiques", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162979&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46901559-14c1-4dba-99e3-1602011e1c40\', \'multiverseId\': 162979}, \'multiverseid\': 162979}, {\'name\': \'Castigare\', \'text\': \'Distruggi una creatura attaccante bersaglio. Guadagni un ammontare di punti vita pari alla sua forza.\', \'type\': \'Istantaneo\', \'flavor\': \'"Perché preghiamo l\\\'Antenata? Perché ci ascolta." —Anziano mistico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=164902&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e2b1f8c4-20c6-4312-9193-9abb8c17fdb9\', \'multiverseId\': 164902}, \'multiverseid\': 164902}, {\'name\': \'懲罰\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1bd696f6-3cc4-49f4-97d8-188945f4b02a\'}, \'multiverseid\': None}, {\'name\': \'Castigar\', \'text\': \'Destrói a criatura alvo atacante. Você ganha uma quantidade de pontos de vida igual ao poder dela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Por que rezamos para a Ancestral? Porque Ela escuta." — Ancião místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165616&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13febaf7-cf87-4ba2-9fb8-610f3a8c3e05\', \'multiverseId\': 165616}, \'multiverseid\': 165616}]', '[{\'name\': \'Übelkeit\', \'text\': \'Alle Kreaturen erhalten -1/-1 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Keine Angst. Keinen Sinn. Und bald auch kein Mittagessen mehr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162761&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'07e1ce34-e743-4785-b64b-a55aad76ab01\', \'multiverseId\': 162761}, \'multiverseid\': 162761}, {\'name\': \'Náusea\', \'text\': \'Todas las criaturas obtienen -1/-1 hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'Sin miedo. Sin juicio. Y dentro de poco, sin almuerzo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13375696-ccfa-4592-81da-fa5413931471\', \'multiverseId\': 165398}, \'multiverseid\': 165398}, {\'name\': \'Nausée\', \'text\': "Toutes les créatures gagnent -1/-1 jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'Sans peur, sans intelligence, et bientôt sans repas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e213461b-25ef-4118-8e57-7c89822680ca\', \'multiverseId\': 163118}, \'multiverseid\': 163118}, {\'name\': \'Nausea\', \'text\': \'Tutte le creature prendono -1/-1 fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'Niente paura. Niente sensi. E presto, niente cibo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165041&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fd5c2089-49f5-409e-8269-f5fdcb01b7e6\', \'multiverseId\': 165041}, \'multiverseid\': 165041}, {\'name\': \'吐き気\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'252ab73c-a76e-48c2-9ff9-9e2b03f4991d\'}, \'multiverseid\': None}, {\'name\': \'Náusea\', \'text\': \'Todas as criaturas recebem -1/-1 até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'Nenhum medo. Nenhuma sensação. E logo, logo, nenhum almoço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165755&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5ff77d1-b44e-46c4-96c0-42d446f459f1\', \'multiverseId\': 165755}, \'multiverseid\': 165755}]', '[{\'name\': \'Überwucherung\', \'text\': \'Inseln enttappen nicht während der Enttappsegmente ihrer Besitzer.\', \'type\': \'Verzauberung\', \'flavor\': \'„Eines Tages werden wir dort, wo jetzt noch Wasser ist, trockenen Fußes gehen können." —Eladamri, Herr des Waldes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=162850&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8f3e91f-c627-4c8b-b39c-65f63f7be730\', \'multiverseId\': 162850}, \'multiverseid\': 162850}, {\'name\': \'Atoramiento\', \'text\': \'Las Islas no se enderezan durante los pasos de enderezar de sus controladores.\', \'type\': \'Encantamiento\', \'flavor\': \'"Algún día caminaremos donde una vez hubo agua". —Eladamri, Señor de las frondas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165487&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca23f125-6581-4b23-a23a-a33eda64dfa8\', \'multiverseId\': 165487}, \'multiverseid\': 165487}, {\'name\': \'Suffocation\', \'text\': "Les îles ne se dégagent pas pendant l\'étape de dégagement de leurs contrôleurs.", \'type\': \'Enchantement\', \'flavor\': \'« Un jour, nous foulerons ce qui était autrefois la mer. » — Éladämri, seigneur des frondaisons\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=163207&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7773056d-1863-4a09-b585-e06ab4c0f93e\', \'multiverseId\': 163207}, \'multiverseid\': 163207}, {\'name\': \'Soffocamento\', \'text\': \'Le Isole non STAPpano durante lo STAP dei loro controllori.\', \'type\': \'Incantesimo\', \'flavor\': \'"Un giorno cammineremo dove un tempo c\\\'era l\\\'acqua". —Eladamri, Signore delle Foglie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165130&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0c5a84c3-e24f-4b57-93ec-8e302de226e3\', \'multiverseId\': 165130}, \'multiverseid\': 165130}, {\'name\': \'窒息\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'750aac99-2fe0-45a0-9c4a-f5f1ac44377a\'}, \'multiverseid\': None}, {\'name\': \'Sufocar\', \'text\': \'As Ilhas não desviram durante as etapas de desvirar de seus controladores.\', \'type\': \'Encantamento\', \'flavor\': \'"Um dia caminharemos onde antes havia água." — Eladamri, Senhor das Folhas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=165844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0711576d-9228-413d-97e6-8e69a7c9c568\', \'multiverseId\': 165844}, \'multiverseid\': 165844}]']
