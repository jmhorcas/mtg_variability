nish\', \'identifiers\': {\'scryfallId\': \'d74a7f05-d3ec-44eb-93fa-5a0f7d07e51b\'}, \'multiverseid\': None}, {\'name\': "Tempête d\'aiguilles", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2dd9ce0-0329-4a14-8a68-1e227ced4b25\'}, \'multiverseid\': None}, {\'name\': \'針の嵐\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fffa3262-8152-485f-aa7a-1ddf08f9a09e\'}, \'multiverseid\': None}]', "[{'name': 'Peitschenwurm', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '53879380-a378-4121-8257-a989c2cb781f'}, 'multiverseid': None}, {'name': 'Sierpe cola fustigante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f064bfc6-acce-461f-99ae-d791b6f1c61d'}, 'multiverseid': None}, {'name': 'Guivre a queue en fouet', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8d4522e4-f596-4dbe-9fdc-10d9ff76aafd'}, 'multiverseid': None}, {'name': '鞭尾のワーム', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '40d6da0c-07a6-4553-9897-e4dec93928c8'}, 'multiverseid': None}]", "[{'name': 'Persönlicher Lehrmeister', 'text': 'Durchsuche Deine Bibliothek nach einer Hexerei und zeige diese Karte allen Spielern. Mische Deine Bibliothek neu und lege die gezeigte Karte oben auf Deine Bibliothek.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2fe8e963-aa0d-44d6-bb7f-5c7946cc21f9'}, 'multiverseid': None}, {'name': 'Tutor personal', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c08be543-cc4b-4dbe-8325-2613e22c45c1'}, 'multiverseid': None}, {'name': 'Précepteur particulier', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '75b6cd9b-89c7-4909-a8f2-75bb5674afd0'}, 'multiverseid': None}, {'name': '親身の教示者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2f975442-0815-4922-9c35-0fa76de75db8'}, 'multiverseid': None}]", "[{'nam