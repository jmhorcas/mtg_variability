ederkleid', 'text': 'Eine Kreatur Deiner Wahl erhält Flugfähigkeit bis zum Ende des Zuges. Ziehe eine Karte.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8a352780-b0a5-4921-b71a-97e0a14e6753'}, 'multiverseid': None}, {'name': 'Manto plumas', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd606febd-c5ca-4cbb-8e44-126fc888f724'}, 'multiverseid': None}, {'name': 'Cape de plumes', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5b9994ee-6abd-425d-b473-561aa05d2f24'}, 'multiverseid': None}, {'name': '羽根の外套', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd5d9a84c-3be2-41ff-a2a8-f987bd06fdaa'}, 'multiverseid': None}]", "[{'name': 'Feiger Riese', 'text': 'Der Feige Riese kann nicht blocken.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '54865174-1585-451d-bab2-ae4f238a7186'}, 'multiverseid': None}, {'name': 'Gigante cobarde', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1501c258-3e66-432b-9800-c6c902a73a99'}, 'multiverseid': None}, {'name': 'Géant poltron', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd0312def-44a5-403c-bd7c-de4b5fa7f367'}, 'multiverseid': None}, {'name': '臆病な巨人', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e4717754-6676-497e-ac85-4da88749899d'}, 'multiverseid': None}]", "[{'name': 'Feiger Ritter', 'text': 'Der Feige Ritter kann nicht blocken.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9ca63a38-9cd5-4326-9b79-aaaf4fe1efa7'}, 'multiverseid': None}, {'name': 'Caballero pusilánime', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7ad92adf-15fe-486e-8b73-38b7421597d4'}, 'multiverseid': None}, {'name': 'Chevalier poltron', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e6bf70e7-fa86-49be-90bc-1aca60ebc9c2'}, 'multiverseid':