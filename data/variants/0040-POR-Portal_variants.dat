rulings: ['[{\'date\': \'2004-10-04\', \'text\': \'Because the "search" requires you to find a card with certain characteristics, you don\\\'t have to find the card if you don\\\'t want to.\'}]', "[{'date': '2004-10-04', 'text': 'Because the “search” requires you to find a card with certain characteristics, you don’t have to find the card if you don’t want to.'}, {'date': '2006-10-15', 'text': 'Can fetch a snow land.'}]", "[{'date': '2004-10-04', 'text': 'Because the “search” requires you to find a card with certain characteristics, you don’t have to find the card if you don’t want to.'}]", "[{'date': '2004-10-04', 'text': 'Can target an already tapped creature if you want.'}]", "[{'date': '2004-10-04', 'text': 'If both players run out of cards during this effect, the game is a draw.'}]", "[{'date': '2004-10-04', 'text': 'If it loses Flying, it will be unable to block any creatures.'}]", "[{'date': '2004-10-04', 'text': 'If there are less than 7 cards in the library, look at all of them. Put two into your hand, and the rest in the graveyard.'}, {'date': '2004-10-04', 'text': 'This is not considered a draw or a discard.'}]", "[{'date': '2004-10-04', 'text': 'The creature being brought back is chosen on announcement and not on resolution of the spell because it is targeted.'}, {'date': '2004-10-04', 'text': 'You must show the card you bring out of the graveyard to your opponent.'}]", "[{'date': '2004-10-04', 'text': 'The creatures and lands are only prevented from untapping during the targeted player’s next untap step. They can still can untap during other player’s untap steps.'}, {'date': '2009-10-01', 'text': 'No creatures or lands controlled by the player will untap during their next untap step. This includes those which entered the battlefield after Exhaustion resolved.'}]", "[{'date': '2004-10-04', 'text': 'The creatures are counted on resolution.'}]", "[{'date': '2004-10-04', 'text': 'The discard is forced even though you choose how many to discard.'}, {'date': '2008-04-01', 'text': 'Each player chooses how many cards they would like to discard. That number may be 0.'}]", "[{'date': '2004-10-04', 'text': 'The number of cards is counted during resolution.'}]", "[{'date': '2004-10-04', 'text': 'This spell increases the number of lands you can play in a turn. The land cards are played as you would normally play lands.'}]", "[{'date': '2004-10-04', 'text': 'Whether or not a creature has flying is only checked on resolution.'}]", "[{'date': '2004-10-04', 'text': 'Whether or not a creature is without flying is only checked on resolution.'}]", "[{'date': '2004-10-04', 'text': 'Will not tap a creature that is both white and another color.'}]", "[{'date': '2004-10-04', 'text': 'You can cast this if you have less than 3 life, since the life is lost as an effect and not a payment.'}]", "[{'date': '2004-10-04', 'text': 'You must target two different lands. You can’t choose to target just one.'}]", "[{'date': '2005-08-01', 'text': 'Gift of Estates does nothing if each of your opponents has the same number of lands or fewer as you.'}, {'date': '2005-08-01', 'text': 'You can find nonbasic lands if they have the Plains land type, such as dual lands (Tundra, et al).'}]", "[{'date': '2007-05-01', 'text': 'This will always be shuffled into its owner’s library.'}]", "[{'date': '2007-09-16', 'text': 'Each player draws a number of cards equal to the number of cards they shuffled into their own library.'}]", "[{'date': '2008-04-01', 'text': 'This card now uses the Reach keyword ability to enable the blocking of flying creatures. This works because a creature with flying can only be blocked by creatures with flying or reach.'}]", "[{'date': '2008-10-01', 'text': 'If there are no other creatures on the battlefield, Fire Dragon will have to target itself. The ability is mandatory.'}]", "[{'date': '2009-10-01', 'text': 'A “creature card” is any card with the type creature, even if it has other types such as artifact, enchantment, or land. Older cards of type summon are also creature cards.'}]", "[{'date': '2009-10-01', 'text': 'You divide the damage as you cast Forked Lightning, not as it resolves. Each target you choose must be assigned at least 1 damage.'}]", "[{'date': '2013-04-15', 'text': 'Players can only respond once this spell has been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to prevent you from casting this spell.'}, {'date': '2013-04-15', 'text': 'You must sacrifice exactly one creature to cast this spell; you cannot cast it without sacrificing a creature, and you cannot sacrifice additional creatures.'}]", "[{'date': '2013-09-20', 'text': 'If a turn has multiple combat phases, the ability can only be activated before the beginning of the declare attackers step of the first combat phase in that turn.'}]", '[{\'date\': \'2016-06-08\', \'text\': "Players can respond to this spell only after it\'s been cast and all its costs have been paid. No one can try to destroy the creature you sacrificed to stop you from casting this spell or to make you sacrifice a different one."}, {\'date\': \'2016-06-08\', \'text\': "Sacrificing a green creature is part of Natural Order\'s cost. You can\'t sacrifice more creatures to search for more creature cards, and you can\'t cast Natural Order at all if you control no green creatures."}]', '[{\'date\': \'2018-03-16\', \'text\': "If the target creature is an illegal target by the time Path of Peace tries to resolve, the spell doesn\'t resolve. No player gains life."}, {\'date\': \'2018-03-16\', \'text\': "You are a creature\'s owner if the card representing it began the game in your deck, or if it\'s a token that entered the battlefield under your control. If Path of Peace targets a creature that you own but an opponent controls, you\'ll gain 4 life."}]', '[{\'date\': \'2019-06-14\', \'text\': "If there are no other creatures on the battlefield when Man-o\'-War enters the battlefield, its ability must target itself."}]', "[{'date': '2022-12-08', 'text': 'You may find a basic Forest or any land card with the land type Forest.'}]"]
foreign_names: ['[{\'name\': \'Alabasterdrache\', \'text\': \'Fliegend\\nWenn der Alabasterdrache aus dem Spiel auf Deinem Friedhof landet, mische den Alabasterdrachen wieder in Deine Bibliothek.\', \'type\': \'Beschwörungszauber\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'404e9080-b5e0-43ce-843a-3c4a070ab1bf\'}, \'multiverseid\': None}, {\'name\': \'Dragón alabastro\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93254f2d-67e1-444f-b22f-55eeedb7d15c\'}, \'multiverseid\': None}, {\'name\': "Dragon d\'albâtre", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6c792c1-6570-4898-9bd8-47df49029e24\'}, \'multiverseid\': None}, {\'name\': \'純白のドラゴン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4376e342-17fe-458c-a043-bfcbe5f9a39d\'}, \'multiverseid\': None}]', "[{'name': 'Anakonda', 'text': 'Sumpftarnung\\n(Wenn der verteidigende Spieler mindestens einen Sumpf im Spiel hat, kann die Anakonda nicht geblockt werden.)', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd7c123ad-db1b-4615-be96-c931af3b03f9'}, 'multiverseid': None}, {'name': 'Anaconda', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '09321fea-c004-40b0-b5d1-d05671eb33ff'}, 'multiverseid': None}, {'name': 'Anaconda', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '1125aca7-33d0-460f-92b9-b81096dadbc2'}, 'multiverseid': None}, {'name': 'アナコンダ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5909a648-613c-4d8d-a54e-0a32f97d080f'}, 'multiverseid': None}]", "[{'name': 'Angriffslustiger Paladin', 'text': 'Wenn der Angriffslustige Paladin angreift, erhält er +0/+3 bis zum Ende des Zuges.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'fd882995-4c1c-43c1-b912-926c7bdcecc9'}, 'multiverseid': None}, {'name': 'P