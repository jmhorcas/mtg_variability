': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'cc07c74e-ecea-4dc9-bc96-ec38e8952f0f'}, 'multiverseid': None}, {'name': 'Bestia imperecedera', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ba80c5c4-4a4c-4c11-8c1b-4e5eae88a2bf'}, 'multiverseid': None}, {'name': 'Bête qui ne meurt pas', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '33152fb8-0c50-45bd-9076-70dc385e1eab'}, 'multiverseid': None}, {'name': '死せざる魔獣', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0b91d6f8-7466-43d9-a7d6-0b335510469a'}, 'multiverseid': None}]", "[{'name': 'Urgewalt', 'text': 'Zerstöre drei Wälder, wenn die Urgewalt von Deiner Hand ins Spiel kommt, oder zerstöre die Urgewalt.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b8fb360a-2999-4329-b1b7-9c1edeb1edff'}, 'multiverseid': None}, {'name': 'Fuerza primigenia', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '05acf068-91a1-4af9-b86d-57a6aac13124'}, 'multiverseid': None}, {'name': 'Force primitive', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8f519ff8-b41e-4a56-baac-cce9b0863c68'}, 'multiverseid': None}, {'name': '原始の力', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '75e602eb-ca2d-434d-b9cc-0129c57f345d'}, 'multiverseid': None}]", "[{'name': 'Verfall der Natürlichkeit', 'text': 'Zerstöre alle grünen Kreaturen.\\n(Das gilt auch für Deine grünen Kreaturen.)', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3688fa72-d98a-4ae8-baec-badfd27e48aa'}, 'multiverseid': None}, {'name': 'Decadencia naturaleza', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0d572286-30cd-4e75-9684-c5bd6909395c'}, 'multiverseid': None}, {'name': 'Ruine de la nature', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '29cd6f31-8cf8-45db-92e2-eff163bf0d6a'