-b52d-8937bde7bcb8'}, 'multiverseid': None}]", "[{'name': 'Zorn Gottes', 'text': 'Lege alle Kreaturen auf die Friedhöfe ihrer Besitzer.\\n(Das gilt auch für Deine Kreaturen.)', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '06e3310c-8a1f-47e8-9771-045ad36b19b1'}, 'multiverseid': None}, {'name': 'Ira de Díos', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e1a4bc63-dfaf-43e8-a243-13e25d353cc6'}, 'multiverseid': None}, {'name': 'Colère de Dieu', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8ab2a636-3953-45fe-ab56-40c8222614e0'}, 'multiverseid': None}, {'name': '神の怒り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'af30f8b6-61ea-480a-8438-31b0ef6ad2a7'}, 'multiverseid': None}]"]
