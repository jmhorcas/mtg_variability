llId': 'e6fd9fdb-b2cc-40d0-9a85-8139a7bc5a65'}, 'multiverseid': None}, {'name': 'Serpent squelette', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd1be49e0-4833-4d8c-a572-a69e32f0ca5c'}, 'multiverseid': None}, {'name': '骸骨蛇', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd9666042-821f-4b68-b041-3423fdc73cea'}, 'multiverseid': None}]", "[{'name': 'Kochende Erde', 'text': 'Die Kochende Erde fügt einer Kreatur Deiner Wahl Schadenspunkte zu in Höhe der Anzahl an Gebirgen, die Du im Spiel hast.\\n(Das gilt für getappte und ungetappte Gebirge.)', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '29677346-2524-4f67-a141-a3ddc289c8f0'}, 'multiverseid': None}, {'name': 'Sacudida telúrica', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '17e0b692-7503-4a5b-b81f-1a2c836358bb'}, 'multiverseid': None}, {'name': 'Expectoration tellurique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f130c4f7-3471-422e-b769-388fcd019e2e'}, 'multiverseid': None}, {'name': '大地の飛礫', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '121c0d36-e133-4fc6-9389-3e6c41699f34'}, 'multiverseid': None}]", "[{'name': 'Kochendes Meer', 'text': 'Zerstöre alle Inseln.\\n(Das gilt auch für Deine Inseln.)', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '96fddb0b-7299-4bab-9657-2c53eb94e49d'}, 'multiverseid': None}, {'name': 'Mares hirvientes', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f5a16a3e-39ad-4a2a-a419-712bce3941f1'}, 'multiverseid': None}, {'name': 'Mers bouillonnantes', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '701c67bf-46e9-48eb-9a0a-87bda5233b9a'}, 'multiverseid': None}, {'name': '沸き立つ海', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b5d2ab09-bff3-49d2-8fce-1c4c5632c268'}, 'multiverseid': None}]", "[{'name': 'Korallenaal', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a52da5e3-8f26-4087-a5a5-a27c8d4a047f'}, 'multiverseid': None}, {'name': 'Azote del coral', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '9710d866-7679-42ec-bc3b-2baf4780c514'}, 'multiverseid': None}, {'name': 'Anguille des coraux', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e6d9f265-b643-41d5-accd-2b4626ae19f9'}, 'multiverseid': None}, {'name': '珊瑚ウツボ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '31496cf2-bbd2-431d-88c7-e74dd96fb45f'}, 'multiverseid': None}]", "[{'name': 'Königsmörder', 'text': 'Du kannst den Königsmörder in Deinem Zug vor Deinem Angriff tappen, um eine getappte Kreatur Deiner Wahl zu zerstören.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '59a0722f-839e-4a5e-ad33-d6bfeba0817d'}, 'multiverseid': None}, {'name': 'Asesino del reino', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0f35a595-4537-44fe-8f38-ba741d63c2b8'}, 'multiverseid': None}, {'name': 'Assassin du roi', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6b3aa84d-4dc2-4750-ab00-02b7b2d6de90'}, 'multiverseid': None}, {'name': '王の暗殺者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8d54602e-6c0f-4e70-a03a-ab9ba81394e8'}, 'multiverseid': None}]", "[{'name': 'Lampengeist', 'text': 'Fliegend', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '93a6d00d-3d8d-4f95-ae39-44e1b227643c'}, 'multiverseid': None}, {'name': 'Djinn de lámpara', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5dd6467e-edca-4466-b841-626d97a703d4'}, 'multiverseid': None}, {'name': 'Djinn de la lampe', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f21d2cf6-999c-4c6a-8681-18e720304af5'}, 'multiverseid': None}, {'name': 'デジャ・ヴュ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f11ad711-2a8e-48ba-a9f5-c10c964f8ed2'}, 'multiverseid': None}]", "[{'name': 'Landschenkung', 'text': 'Wenn Dein Gegner mehr Länder als Du im Spiel hat, durchsuche Deine Bibliothek nach bis zu drei Ebenen und nimm diese auf Deine Hand. Mische Deine Bibliothek danach neu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '99368620-f12c-471d-82da-21756e488711'}, 'multiverseid': None}, {'name': 'Concesión tierras', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3e726a6d-0c67-4905-8ad2-60953597b2df'}, 'multiverseid': None}, {'name': 'Don de domaines', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '232ed4f2-1da7-440a-b039-231e563f542a'}, 'multiverseid': None}, {'name': '土地の寄進', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd6626305-60c0-4905-a17c-71f7c75833e3'}, 'multiverseid': None}]", "[{'name': 'Launischer Zauberer', 'text': 'Du kannst den Launischen Zauberer in Deinem Zug, bevor Du angreifst, tappen, damit er einer Kreatur oder einem Spieler Deiner Wahl 1 Schadenspunkt zufügt.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '98088034-b316-4a48-9426-d0af55f3fc42'}, 'multiverseid': None}, {'name': 'Hechicero capríchoso', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '069e824d-aa98-45c7-a322-a7914966dbd6'}, 'multiverseid': None}, {'name': 'Sorcière capricieuse', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '49a0bb57-8e33-4a36-8a3c-a2654810da2c'}, 'multiverseid': None}, {'name': '気まぐれ魔術師', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b5459719-ea3b-4478-8f2a-d745bd48ac17'}, 'multiverseid': None}]", "[{'name': 'Lavaaxt', 'text': 'Die Lavaaxt fügt Deinem Gegner 5 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2ac40d26-4f01-4780-b0d4-cad1ea277348'}, 'multiverseid': None}, {'name': 'Hacha de lava', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3cf654f9-c2cd-4298-937c-5a88cdc9018b'}, 'multiverseid': None}, {'name': 'Hache de lave', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '62f1e55f-3b12-4307-aac7-4e8e6a6ad0e6'}, 'multiverseid': None}, {'name': '溶岩の斧', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'faf9420c-9725-435b-a26b-ca8c4ecbe198'}, 'multiverseid': None}]", "[{'name': 'Lavafluß', 'text': 'Zerstöre eine Kreatur oder ein Land Deiner Wahl.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '4e550fb1-dcc2-400c-8e68-72993d164c83'}, 'multiverseid': None}, {'name': 'Río de lava', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c1eea638-ae30-48ab-b7fe-29ca789292b0'}, 'multiverseid': None}, {'name': 'Flot de lave', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '36161ad6-8b02-41bf-88e8-8d8d8283ec4e'}, 'multiverseid': None}, {'name': '溶岩の流れ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9a161fd6-6c0e-4db6-82ae-da8c6b9a9321'}, 'multiverseid': None}]", "[{'name': 'Lebenshauch', 'text': 'Nimm einen Beschwörungszauber Deiner Wahl aus Deinem Friedhof und bringe diese Karte direkt ins Spiel. Behandle diese Kreatur, als ob Du sie gerade von Deiner Hand gespielt hättest.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9f6c243a-f729-4253-b216-bae93c754fdc'}, 'multiverseid': None}, {'name': 'Aliento vital', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a5e2cb7a-e34d-4da3-9254-08699c517318'}, 'multiverseid': None}, {'name': 'Souffle de vie', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bcbc9fd5-492a-4a14-b48f-8aae3cd90fd7'}, 'multiverseid': None}, {'name': '生命の息吹', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8da0403a-fa57-4f75-b4a6-8dd3c764e9f5'}, 'multiverseid': None}]", "[{'name': 'Leichtfüßiger Mönch', 'text': 'Der Leichtfüßige Mönch kann nicht von Kreaturen mit einer Stärke größer oder gleich 3 geblockt werden.', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '69c98b68-2818-4f1a-941c-3bff96090505'}, 'multiverseid': None}, {'name': 'Monje veloz', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a921bf26-82a3-4a11-acaf-7f97a6d8f8a3'}, 'multiverseid': None}, {'name': 'Moine au pied léger', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f1de6009-fe73-4282-a310-63544890e6a1'}, 'multiverseid': None}, {'name': '俊足の修道士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8b33f983-9f7f-4781-b52f-a410164a6901'}, 'multiverseid': None}]", "[{'name': 'Letzte Chance', 'text': 'Du erhältst einen weiteren Zug nach diesem Zug. Du verlierst das Spiel am Ende jenes Zuges. (Du verlierst das Spiel nicht, wenn Du vorher gewinnst.)', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a6cccd20-7f75-4466-8e18-f7493d058a72'}, 'multiverseid': None}, {'name': 'Última oportunidad', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2d8f3983-20e0-4550-b4f8-d3397b2ec28d'}, 'multiverseid': None}, {'name': 'Ultime chance', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0711a927-125a-4894-9043-5b07a9c05be2'}, 'multiverseid': None}, {'name': '最後のチャンス', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b79b5256-5a14-4f5a-814e-fddb16496742'}, 'multiverseid': None}]", "[{'name': 'Lockender Duft', 'text': 'Bestimme eine Kreatur Deiner Wahl. Alle Kreaturen, die diese Kreatur in diesem Zug blocken können, tun dies.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '43a9e585-2039-4fba-b590-c6677bc6b58d'}, 'multiverseid': None}, {'name': 'Aroma seductor', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7ceb30e7-e905-4a2c-97cd-a755d02a4bb6'}, 'multiverseid': None}, {'name': 'Odeur alléchante', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bfc0023e-3cee-40e8-825e-04705d669c02'}, 'multiverseid': None}, {'name': '誘いの匂い', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '21b90989-864c-4bff-916c-b27559ac0dbb'}, 'multiverseid': None}]", "[{'name': 'Meervolk des Perlendreizacks', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '98c291b3-b2bd-401e-a983-a871c46f459a'}, 'multiverseid': None}, {'name': 'Tritones tridente p.', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ef4db811-9b66-424c-89f9-c19b7d99671d'}, 'multiverseid': None}, {'name': 'Ondins du Trident nacré', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '31708fa6-80e1-48db-886e-060d3043d8b4'}, 'multiverseid': None}, {'name': '真珠三叉矛の人魚', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '6b92ff7b-8c70-4d14-885e-a9d338fada78'}, 'multiverseid': None}]", "[{'name': 'Minotaurenkrieger', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a11c85a9-1351-486d-abbf-620ad2f1de89'}, 'multiverseid': None}, {'name': 'Movilización', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '73985f1e-6d13-4127-a589-b00bf460bdf3'}, 'multiverseid': None}, {'name': 'Guerrier minotaure', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '9cc33049-36b5-4ad5-a564-11e196c45b14'}, 'multiverseid': None}, {'name': 'ミノタウルスの戦士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'eaca7f2a-23e1-43fe-bba9-9feda99e0277'}, 'multiverseid': None}]", "[{'name': 'Mobilisierung', 'text': 'Enttappe alle Deine Kreaturen.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7a02200c-7ddb-478a-a15c-4074a860b8d4'}, 'multiverseid': None}, {'name': 'Mobilisation', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '06e07723-1c51-43c3-987d-8fd35e08e791'}, 'multiverseid': None}, {'name': '動員', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '167aed7e-0c1e-4c64-b262-2729a69479b8'}, 'multiverseid': None}]", "[{'name': 'Mondfee', 'text': 'Fliegend', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '73a0e237-2b16-4d83-9bbf-cf5653fd1e35'}, 'multiverseid': None}, {'name': 'Duende lunar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '187c21d7-f6e6-4010-8dd3-2219a6844909'}, 'multiverseid': None}, {'name': 'Farfadet lunaire', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5bd943a4-5fd1-4503-97a7-036176cd2170'}, 'multiverseid': None}, {'name': 'ムーン・スプライト', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9eb66ebe-88a3-42fa-bf45-423224a2fb75'}, 'multiverseid': None}]", "[{'name': 'Morgenröte', 'text': 'Du erhältst für jedes Gebirge, das Dein Gegner im Spiel hat, 2 Lebenspunkte dazu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c2d04759-5f3d-4b8a-bbf3-dbc3d8ecf822'}, 'multiverseid': None}, {'name': 'Amanecer renovador', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd83db37f-5542-4dcc-b711-7375a51aaf2c'}, 'multiverseid': None}, {'name': 'Aube renouvelée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '67ce1389-ef91-45ee-b226-f27149a80855'}, 'multiverseid': None}, {'name': '復活の夜明け', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '64f183a0-a68a-44cf-936c-89977969591e'}, 'multiverseid': None}]", "[{'name': 'Naturgeheimnisse', 'text': 'Durchsuche Deine Bibliothek nach einem Wald und bringe ihn sofort ins Spiel. Mische Deine Bibliothek danach.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'fe0ae011-0bcb-40b3-a7b1-c7a1d8dd85dd'}, 'multiverseid': None}, {'name': 'Sabiduría naturaleza', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '9596ff37-e7ab-4c53-b96a-48866b50aad5'}, 'multiverseid': None}, {'name': 'Sapience naturaliste', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'adc42903-44f3-4429-85c3-a1558022fd28'}, 'multiverseid': None}, {'name': '自然の知識', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c9f077a8-420c-4b0f-b6e4-1cafd5dbfe7a'}, 'multiverseid': None}]", "[{'name': 'Natürliche Ordnung', 'text': 'Durchsuche Deine Bibliothek nach einem grünen Beschwörungszauber und bringe diese Karte direkt ins Spiel, als ob sie gerade von Deiner Hand gespielt worden wäre.\\nLege dann eine Deiner grünen Kreaturen auf Deinen Friedhof. Mische Deine Bibliothek danach.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '32ffcb55-7e2f-4905-8bf4-a5f4b1bc0281'}, 'multiverseid': None}, {'name': 'Orden natural', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4ac1f3d7-375b-4f08-bbce-f1478b06ab8f'}, 'multiverseid': None}, {'name': 'Ordre naturel', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5d41da2a-7678-4704-bfd3-067efc7ed85d'}, 'multiverseid': None}, {'name': '自然の秩序', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '7efd50f4-f829-412b-b199-4e808713f991'}, 'multiverseid': None}]", "[{'name': 'Nobles Einhorn', 'type': 'Beschwörungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a9a96cdd-ee96-4214-a191-dfcda8470664'}, 'multiverseid': None}, {'name': 'Unicornio regio', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8d1e3664-6805-4f60-8ace-924d495c93cd'}, 'multiverseid': None}, {'name': 'Licorne royale', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3a95ffa0-5d6a-4877-b660-4e2973ff2377'}, 'multiverseid': None}, {'name': '皇帝一角獣', 'flavor': N