mana_cost: ['{0}', '{10}{G}{G}', '{1}{G}{U}{R}', '{1}{G}{U}{U}', '{1}{G}{W}', '{1}{R}', '{1}{U}{U}', '{1}{W}', '{2}', '{2}{B}', '{2}{B}{R}{G}', '{2}{G}', '{2}{G}{G}', '{2}{R}', '{2}{U}', '{2}{U}{B}', '{2}{W}', '{3}{B}', '{3}{R}', '{3}{R}{R}', '{3}{U}{U}', '{3}{W}{W}', '{4}{B}{B}', '{4}{G}{G}', '{6}{G}{G}', '{6}{R}', '{B}', '{B}{B}{B}', '{G}{U}', '{R}', '{U}{B}', '{U}{U}']
