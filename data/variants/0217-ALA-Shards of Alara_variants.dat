188446&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '61d0ac9e-5c21-44b8-9dcd-0d73e50263dc', 'multiverseId': 188446}, 'multiverseid': 188446}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187201&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '403f90fd-2c7e-49d3-984e-6543a3b457a7', 'multiverseId': 187201}, 'multiverseid': 187201}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188197&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6d48c829-961f-4f72-b2c2-add81d80adca', 'multiverseId': 188197}, 'multiverseid': 188197}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188944&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a3a32e99-3aa2-479a-abf2-0f803e098b4c', 'multiverseId': 188944}, 'multiverseid': 188944}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187450&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '23f3fce2-a270-45d4-89cc-d126acab128d', 'multiverseId': 187450}, 'multiverseid': 187450}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187700&type=card', 'language': 'German', 'identifiers': {'scryfallId': '59fa0bf0-9477-4e24-8cd3-65a434be0c22', 'multiverseId': 187700}, 'multiverseid': 187700}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187949&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e8b9aef7-b05b-4b98-8416-e0bd11f07558', 'multiverseId': 187949}, 'multiverseid': 187949}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188696&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5744f931-57e5-40cd-ad40-4f0056d0a3f8', 'multiverseId': 188696}, 'multiverseid': 188696}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188447&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ecf85ea2-f4b0-43e2-b11d-3759b782f7a3', 'multiverseId': 188447}, 'multiverseid': 188447}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187202&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9c610428-e30c-4f41-b0d1-13386deb0c63', 'multiverseId': 187202}, 'multiverseid': 187202}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188198&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd0c1c19d-7ac7-4d41-bf40-5ebc8679fd40', 'multiverseId': 188198}, 'multiverseid': 188198}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188945&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '578a9717-7df0-4c6d-9a03-f4f828838c77', 'multiverseId': 188945}, 'multiverseid': 188945}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187451&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '304423cf-4ce1-4c0a-b473-1abcc74cf1e6', 'multiverseId': 187451}, 'multiverseid': 187451}]", '[{\'name\': \'Eingeweideschlepper\', \'text\': \'Umwandlung {2} ({2}, wirf diese Karte aus deiner Hand ab: Ziehe eine Karte.)\\nExhumieren {1}{B} ({1}{B}: Bringe diese Karte aus deinem Friedhof ins Spiel zurück. Sie hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Kreatur — Zombie, Oger, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187559&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'497a9245-0cf0-4b82-b7e5-3c4c0c3f5b7d\', \'multiverseId\': 187559}, \'multiverseid\': 187559}, {\'name\': \'Arrastravísceras\', \'text\': \'Ciclo {2}. ({2}, descartar esta carta: Roba una carta.)\\nDesenterrar {1}{B}. ({1}{B}: Regresa esta carta de tu cementerio al juego. Gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura — Guerrero ogro zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187808&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d646cf55-9a6a-48c7-a72e-7a89d9058b9b\', \'multiverseId\': 187808}, \'multiverseid\': 187808}, {\'name\': \'Traîneur de viscères\', \'text\': "Recyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\\nExhumation {1}{B} ({1}{B} : Renvoyez en jeu cette carte depuis votre cimetière. Elle acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature : zombie et ogre et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188555&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2cfbb5c0-11f7-49d1-a1f1-0676b3875ac5\', \'multiverseId\': 188555}, \'multiverseid\': 188555}, {\'name\': \'Trascinatore di Visceri\', \'text\': \'Ciclo {2} ({2}, Scarta questa carta: Pesca una carta.)\\nDissotterrare {1}{B} ({1}{B}: Rimetti in gioco questa carta dal tuo cimitero. Ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)\', \'type\': \'Creatura — Guerriero Ogre Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188306&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f932d482-f65a-426b-a61b-e5f55a68b413\', \'multiverseId\': 188306}, \'multiverseid\': 188306}, {\'name\': \'臓物を引きずる者\', \'text\': \'サイクリング {2} （{2}, このカードを捨てる：カードを１枚引く。）\\n蘇生 {1}{B} ({1}{B}：このカードをあなたの墓地から場に戻す。 それは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — ゾンビ・オーガ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187061&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e43a8392-2a6e-44d6-9013-c4e2d8773a02\', \'multiverseId\': 187061}, \'multiverseid\': 187061}, {\'name\': \'Rebocador Visceral\', \'text\': \'Reciclar {2} ({2}, Descarte este card: Compre um card.)\\nDesenterrar {1}{B} ({1}{B}: Devolva este card de seu cemitério para o jogo. Ele ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura — Zumbi Ogre Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188057&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'072904d6-3900-452c-bfb9-07733170e737\', \'multiverseId\': 188057}, \'multiverseid\': 188057}, {\'name\': \'Собиратель Потрохов\', \'text\': \'Цикл {2} ({2}, сбросьте эту карту: возьмите карту.)\\nОткопать {1}{B} ( {1}{B}: верните эту карту из вашего кладбища в игру. Она получает Ускорение. Удалите ее из игры в конце хода, или если она должна покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Существо — Зомби Огр Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188804&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cc36fb03-7c35-47d2-963f-8f8441752c27\', \'multiverseId\': 188804}, \'multiverseid\': 188804}, {\'name\': \'拽脏灵俑\', \'text\': \'循环{2} （{2}，弃掉此牌：抓一张牌。）\\n破坟{1}{B} （{1}{B}：将此牌从你的坟墓场移回场上。 它获得敏捷。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'生物～灵俑／食人魔／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187310&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'85816ee6-77fc-4a17-a4ff-914f178c20b9\', \'multiverseId\': 187310}, \'multiverseid\': 187310}]', '[{\'name\': \'Eintauchen in den Vulkan\', \'text\': \'Zerstöre ein Artefakt oder ein Land deiner Wahl.\\nUmwandlung {2} ({2}, wirf diese Karte aus deiner Hand ab: Ziehe eine Karte.)\', \'type\': \'Hexerei\', \'flavor\': \'Der Tod eines Drachen wird fast ebenso gefürchtet wie sein Leben. Alte, sterbende Drachen werfen sich gerne in Vulkane und sorgen dadurch für mittlere Katastrophen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187588&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0ef390b-f2a8-447e-9286-137d0d6dfaf4\', \'multiverseId\': 187588}, \'multiverseid\': 187588}, {\'name\': \'Inmersión volcánica\', \'text\': \'Destruye el artefacto o tierra objetivo.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Conjuro\', \'flavor\': \'La muerte de un dragón es casi tan temida como su vida. Los viejos dragones moribundos se arrojan en volcanes, creando desastres y alzamientos masivos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187837&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f6c40c10-bb69-48bd-bc28-5cb0f84a13d3\', \'multiverseId\': 187837}, \'multiverseid\': 187837}, {\'name\': \'Submersion volcanique\', \'text\': "Détruisez l\'artefact ciblé ou le terrain ciblé.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Rituel\', \'flavor\': "La mort d\'un dragon est presque autant redoutée que sa vie. Les vieux dragons mourants se jettent dans des volcans, créant bouleversements et catastrophes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188584&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e5c7f48-d685-4f39-9545-8c41332847dd\', \'multiverseId\': 188584}, \'multiverseid\': 188584}, {\'name\': \'Inondazione Vulcanica\', \'text\': \'Distruggi un artefatto o una terra bersaglio.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Stregoneria\', \'flavor\': \'La morte di un drago è temuta quasi quanto la sua vita. I vecchi draghi morenti si gettano nei vulcani, provocando sismi enormi e disastri di vasta estensione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188335&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb408bab-07d1-4957-85ce-53d53bd783ca\', \'multiverseId\': 188335}, \'multiverseid\': 188335}, {\'name\': \'火山流埋め\', \'text\': \'アーティファクト１つか土地１つを対象とし、それを破壊する。\\nサイクリング {2} （{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'ソーサリー\', \'flavor\': \'竜の死は、その生とほとんど同じぐらいに恐れられている。 老いて死にゆく竜は自身を火口へと投げ、ものすごい大激動と広大な範囲の災害をもたらすからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187090&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7bdded87-d306-4d52-85b1-c0a26a56ed80\', \'multiverseId\': 187090}, \'multiverseid\': 187090}, {\'name\': \'Submersão Vulcânica\', \'text\': \'Destrua o artefato ou o terreno alvo.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Feitiço\', \'flavor\': \'A morte de um dragão é tão temida quanto a sua vida. Os dragões velhos e moribundos lançam-se nos vulcões, causando uma gigantesca sublevação e um desastre generalizado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188086&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff1c25c1-376d-4883-972b-6d9b3bedcefe\', \'multiverseId\': 188086}, \'multiverseid\': 188086}, {\'name\': \'Вулканическое Наводнение\', \'text\': \'Уничтожьте целевой артефакт или землю.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Волшебство\', \'flavor\': \'Смерть дракона вселяет почти такой же страх, как и жизнь. Старые, умирающие драконы бросаются в жерла вулканов, чем вызывают грандиозные извержения и колоссальные катастрофы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188833&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ff0374e-b810-45ce-acd5-115e02bfed83\', \'multiverseId\': 188833}, \'multiverseid\': 188833}, {\'name\': \'火山淹没\', \'text\': \'消灭目标神器或地。\\n循环{2} （{2}，弃掉此牌：抓一张牌。）\', \'type\': \'法术\', \'flavor\': \'龙死亡时与其生前一样可怕。 年衰将亡的龙会投身火山，造成天翻地覆的广大危害。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187339&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e1ed74a-7681-4659-9a23-70b80627a69c\', \'multiverseId\': 187339}, \'multiverseid\': 187339}]', '[{\'name\': \'Elfischer Visionär\', \'text\': \'Wenn der Elfische Visionär ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Vor jeder größeren Unternehmung sucht ein cylianischer Elf den Rat eines Visionärs, um den Willen der alten Gargantuas zu erfahren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187597&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60a3b8ad-aaa7-4af4-b2a0-c6d345537e2b\', \'multiverseId\': 187597}, \'multiverseid\': 187597}, {\'name\': \'Visionaria élfica\', \'text\': \'Cuando la Visionaria élfica entre en juego, roba una carta.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Antes de una misión, un elfo cyliano busca el consejo de un visionario para conocer la voluntad de los antiguos gargantúa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187846&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae61f6fb-3bd6-4998-bb93-afa2028649fb\', \'multiverseId\': 187846}, \'multiverseid\': 187846}, {\'name\': \'Visionnaire elfe\', \'text\': \'Quand la Visionnaire elfe arrive en jeu, piochez une carte.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': "Avant tout projet d\'importance, un elfe cylian demande conseil à un visionnaire pour connaître la volonté des anciens gargantuesques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188593&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d926e4ee-aa0a-4bf7-82af-bfd075e549ec\', \'multiverseId\': 188593}, \'multiverseid\': 188593}, {\'name\': \'Elfa Visionaria\', \'text\': "Quando l\'Elfa Visionaria entra in gioco, pesca una carta.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': "Prima di ogni grande missione, un\'elfa Cylian cerca la guida di una visionaria per apprendere la volontà degli antichi mastodonti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188344&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f8d4e93-5912-4181-8fea-03770b794cf0\', \'multiverseId\': 188344}, \'multiverseid\': 188344}, {\'name\': \'エルフの幻想家\', \'text\': \'エルフの幻想家が場に出たとき、カードを１枚引く。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'どんな大事の前でも、シーリアのエルフは古きガルガンチュアンの意思を聞く幻視者の導きを求める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187099&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'293ee637-e5a2-4366-a5ab-650bf055c4e6\', \'multiverseId\': 187099}, \'multiverseid\': 187099}, {\'name\': \'Visionário Élfico\', \'text\': \'Quando Visionário Élfico entrar em jogo, compre um card.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'Antes de qualquer decisão importante, um elfo cyliano sempre busca a orientação de um visionário para saber qual a vontade dos anciãos gargantuas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188095&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e66b550-6a4a-4b47-a248-5f7cd9f6593d\', \'multiverseId\': 188095}, \'multiverseid\': 188095}, {\'name\': \'Эльфийский Прорицатель\', \'text\': \'Когда Эльфийский Прорицатель входит в игру, возьмите карту.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Перед любым важным делом силийский эльф ищет совета у прорицателя, чтобы узнать волю древних исполинов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188842&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'497e0430-6f85-4d85-8835-02f90456c793\', \'multiverseId\': 188842}, \'multiverseid\': 188842}, {\'name\': \'地精幻视师\', \'text\': \'当地精幻视师进场时，抓一张牌。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'在作出任何重大承诺之前，塞利亚地精会寻求幻视师的指导，好知晓巨兽祖先的意念。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187348&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8f354fb5-8105-4191-a972-cb58a3d0cfa7\', \'multiverseId\': 187348}, \'multiverseid\': 187348}]', '[{\'name\': \'Elspeth, fahrende Ritterin\', \'text\': \'+1: Bringe einen 1/1 weißen Soldat-Kreaturenspielstein ins Spiel.\\n+1: Eine Kreatur deiner Wahl erhält +3/+3 und Flugfähigkeit bis zum Ende des Zuges.\\n-8: Für den Rest des Spiels sind Artefakte, Kreaturen, Verzauberungen und Länder, die du kontrollierst, unzerstörbar.\', \'type\': \'Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187476&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8fdd9374-2c37-4edd-9e31-cdaf9325f4d4\', \'multiverseId\': 187476}, \'multiverseid\': 187476}, {\'name\': \'Elspeth, Caballero Errante\', \'text\': \'+1: Pon en juego una ficha de criatura Soldado blanca 1/1.\\n+1: La criatura objetivo obtiene +3/+3 y gana la habilidad de volar hasta el final del turno.\\n-8: Por el resto del juego los artefactos, criaturas, encantamiento y tierras que controlas son indestructibles.\', \'type\': \'Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187725&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d61293dc-38e9-4e55-bfc8-faacae9dfebe\', \'multiverseId\': 187725}, \'multiverseid\': 187725}, {\'name\': \'Elspeth, chevalière errante\', \'text\': "+1 : Mettez en jeu un jeton de créature 1/1 blanche Soldat.\\n+1 : La créature ciblée gagne +3/+3 et acquiert le vol jusqu\'à la fin du tour.\\n-8 : Pour le restant de la partie, les artefacts, les créatures, les enchantements et les terrains que vous contrôlez sont indestructibles.", \'type\': \'Planeswalker : Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188472&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2fdf1d47-96ba-4258-803d-a22ce42328a6\', \'multiverseId\': 188472}, \'multiverseid\': 188472}, {\'name\': \'Elspeth, Cavaliera Errante\', \'text\': \'+1: Metti in gioco una pedina creatura Soldato 1/1 bianca.\\n+1: Una creatura bersaglio prende +3/+3 e ha volare fino alla fine del turno.\\n-8: Per il resto della partita, gli artefatti, le creature, gli incantesimi e le terre che controlli sono indistruttibili.\', \'type\': \'Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188223&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c43eefb-a37d-43b0-84dc-ef329b7d22fc\', \'multiverseId\': 188223}, \'multiverseid\': 188223}, {\'name\': \'遍歴の騎士、エルズペス\', \'text\': \'+1:白の１/１の兵士クリーチャー・トークンを１体場に出す。\\n+1:クリーチャー１体を対象とする。それはターン終了時まで＋３/＋３の修整を受けるとともに飛行を得る。\\n-8:残りのゲームの間、あなたがコントロールするアーティファクトとクリーチャーとエンチャントと土地は破壊されない。\', \'type\': \'プレインズウォーカー — エルズペス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186978&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6536870c-4190-4fe1-9a83-74bb8bcd52f5\', \'multiverseId\': 186978}, \'multiverseid\': 186978}, {\'name\': \'Elspeth, Cavaleira Errante\', \'text\': \'+1: Coloque em jogo uma ficha de criatura branca 1/1 do tipo Soldado.\\n+1: A criatura alvo recebe +3/+3 e ganha voar até o final do turno.\\n-8: Durante o restante do jogo, os artefatos, criaturas, encantamentos e terrenos que você controla são indestrutíveis.\', \'type\': \'Planeswalker — Elspeth\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187974&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffd62b97-35b9-4662-a8ca-016d82583ebb\', \'multiverseId\': 187974}, \'multiverseid\': 187974}, {\'name\': \'Элспет, Рыцарь-Странница\', \'text\': \'+1: положите в игру одну фишку существа 1/1 белый Солдат.\\n+1: целевое существо получает +3/+3 и Полет до конца хода.\\n-8: до конца партии артефакты, существа, чары и земли под вашим контролем не могут быть уничтожены.\', \'type\': \'Planeswalker — Элспет\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188721&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'675aebbd-ae19-498b-8dc2-2e6fdfc6ecc8\', \'multiverseId\': 188721}, \'multiverseid\': 188721}, {\'name\': \'游侠艾紫培\', \'text\': \'+1：将一个1/1白色士兵衍生物放置进场。\\n+1：目标生物得+3/+3并获得飞行异能直到回合结束。\\n-8：直到这盘对战结束，由你操控的神器，生物，结界，以及地都不会毁坏。\', \'type\': \'鹏洛客～艾紫培\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187227&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5743f365-fea2-4941-bf1f-2791de85f337\', \'multiverseId\': 187227}, \'multiverseid\': 187227}]', '[{\'name\': \'Engel der Kampfgnade\', \'text\': \'Fliegend\\nEdelmut (Immer wenn eine Kreatur, die du kontrollierst, alleine angreift, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\nImmer wenn eine Kreatur, die du kontrollierst, alleine angreift, erhält sie bis zum Ende des Zuges Lebensverknüpfung.\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187473&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b796956e-a1a5-4925-ae22-605316cb3eab\', \'multiverseId\': 187473}, \'multiverseid\': 187473}, {\'name\': \'Ángel bendición de batalla\', \'text\': \'Vuela.\\nExaltado. (Siempre que una criatura que controles ataque sola, esa criatura obtiene +1/+1 hasta el final del turno.)\\nSiempre que una criatura que controles ataque sola, gana la habilidad de vínculo vital hasta el final del turno.\', \'type\': \'Criatura — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187722&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d93bb3f-a1f8-4236-b35b-5b79ab4c8d97\', \'multiverseId\': 187722}, \'multiverseid\': 187722}, {\'name\': \'Ange de grâcebataille\', \'text\': "Vol\\nExaltation (À chaque fois qu\'une créature que vous contrôlez attaque seule, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\nÀ chaque fois qu\'une créature que vous contrôlez attaque seule, elle acquiert le lien de vie jusqu\'à la fin du tour.", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188469&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'231aafbd-3495-4023-9266-f6428d1f6b09\', \'multiverseId\': 188469}, \'multiverseid\': 188469}, {\'name\': \'Angelo della Grazia Guerriera\', \'text\': \'Volare\\nEsaltato (Ogniqualvolta una creatura che controlli attacca da sola, prende +1/+1 fino alla fine del turno.)\\nOgniqualvolta una creatura che controlli attacca da sola, ha legame vitale fino alla fine del turno.\', \'type\': \'Creatura — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188220&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d609b1c9-ab4a-42f5-ae19-1fd13c486918\', \'multiverseId\': 188220}, \'multiverseid\': 188220}, {\'name\': \'戦誉の天使\', \'text\': \'飛行\\n賛美 （あなたがコントロールするいずれかのクリーチャーが単独で攻撃するたび、そのクリーチャーはターン終了時まで＋１/＋１の修整を受ける。）\\nあなたがコントロールするいずれかのクリーチャーが単独で攻撃するたび、それはターン終了時まで絆魂を得る。\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186975&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'acac2a96-c172-4f78-91af-3a421c9432c7\', \'multiverseId\': 186975}, \'multiverseid\': 186975}, {\'name\': \'Anjo da Graça de Batalha\', \'text\': \'Voar\\nExaltado (Toda vez que uma criatura que você controla ataca sozinha, ela recebe +1/+1 até o final do turno.)\\nToda vez que uma criatura que você controla ataca sozinha, ela recebe vínculo com a vida até o final do turno.\', \'type\': \'Criatura — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187971&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a79cbf8a-c1ea-40a5-8c17-1d2a5112e024\', \'multiverseId\': 187971}, \'multiverseid\': 187971}, {\'name\': \'Ангел Боевой Благодати\', \'text\': \'Полет\\nПовышение (Каждый раз, когда существо под вашим контролем атакует в одиночку, оно получает +1/+1 до конца хода.)\\nКаждый раз, когда существо под вашим контролем атакует в одиночку, оно получает Цепь жизни до конца хода.\', \'type\': \'Существо — Ангел\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188718&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'45f83eb9-ef76-4b5a-bb00-bb384458fdd6\', \'multiverseId\': 188718}, \'multiverseid\': 188718}, {\'name\': \'战华天使\', \'text\': \'飞行\\n颂威 （每当一个由你操控的生物单独攻击时，该生物得+1/+1直到回合结束。）\\n每当一个由你操控的生物单独攻击时，它获得系命异能直到回合结束。\', \'type\': \'生物～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187224&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a49a7f46-4526-4712-b201-dc455d707dff\', \'multiverseId\': 187224}, \'multiverseid\': 187224}]', '[{\'name\': \'Engelsgesang\', \'text\': \'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.\\nUmwandlung {2} ({2}, wirf diese Karte aus deiner Hand ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Das Klirren der Schwerter und das Gebrüll der Bestien schweigen, wenn die Engel zum Gebet rufen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187471&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80c63307-5be3-41a9-a31c-4d4f08f668b6\', \'multiverseId\': 187471}, \'multiverseid\': 187471}, {\'name\': \'Canción angelical\', \'text\': \'Prevén todo el daño de combate que se fuera a hacer este turno.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'El choque de espadas y el grito de las bestias callan cuando los ángeles llaman a oración.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187720&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc9214fa-f334-4fb8-922f-535eafdcf0e2\', \'multiverseId\': 187720}, \'multiverseid\': 187720}, {\'name\': \'Chant angélique\', \'text\': \'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)\', \'type\': \'Éphémère\', \'flavor\': "Le fracas des épées et le hurlement des bêtes cessent quand les anges sonnent l\'appel à la prière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188467&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da627ed3-22b1-4566-a4e4-cbe920b94be2\', \'multiverseId\': 188467}, \'multiverseid\': 188467}, {\'name\': "Canto dell\'Angelo", \'text\': \'Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': "Il clangore delle spade e l\'urlo delle bestie ammutoliscono quando gli angeli suonano l\'adunata per la preghiera.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188218&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f4c03fa-be46-4b29-9eb0-7c9c076aac17\', \'multiverseId\': 188218}, \'multiverseid\': 188218}, {\'name\': \'天使歌\', \'text\': \'このターンに与えられるすべての戦闘ダメージを軽減する。\\nサイクリング {2} （{2}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'天使の声が祈りを呼び覚ますとき、剣のぶつかる音や獣の叫び声はかき消される。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186973&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed179577-0ef5-4e42-bba7-48523caf1b02\', \'multiverseId\': 186973}, \'multiverseid\': 186973}, {\'name\': \'Música Angelical\', \'text\': \'Previna todo o dano de combate que seria causado neste turno.\\nReciclar {2} ({2}, Descarte este card: Compre um card.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O tinir das espadas e o grito das feras calam-se quando os anjos entoam o canto da prece.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187969&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'407f0279-6d96-4488-ad80-e6bb431ba4b9\', \'multiverseId\': 187969}, \'multiverseid\': 187969}, {\'name\': \'Песнь Ангелов\', \'text\': \'Предотвратите все боевые повреждения, которые должны быть нанесены в этом ходу.\\nЦикл {2} ({2}, сбросьте эту карту: возьмите карту.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Лязг мечей и звериный рык замолкают, когда ангелы призывают к молитве.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188716&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'07e9638b-98fa-420a-97b9-7725c60cb837\', \'multiverseId\': 188716}, \'multiverseid\': 188716}, {\'name\': \'天使祷曲\', \'text\': \'于本回合中，防止将造成的所有战斗伤害。\\n循环{2} （{2}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'天使祷声传杨，让刀剑交击与野兽咆哮归诸宁静。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187222&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d9a834c-07d9-4df9-8250-6b840cc7b262\', \'multiverseId\': 187222}, \'multiverseid\': 187222}]', '[{\'name\': \'Erdbodengleichmacher\', \'text\': \'Wenn der Erdbodengleichmacher ins Spiel kommt, entferne alle Länder ganz aus dem Spiel.\\nWenn der Erdbodengleichmacher das Spiel verlässt, bringe die so ganz aus dem Spiel entfernten Karten getappt unter der Kontrolle ihrer Besitzer ins Spiel zurück.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Der Behemoth brüllte, und die Welt war von Reichen und Tyrannen befreit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187654&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7eae9dc8-08b0-486a-b588-4ace0ff6ea5b\', \'multiverseId\': 187654}, \'multiverseid\': 187654}, {\'name\': \'Arrasareinos\', \'text\': \'Cuando el Arrasareinos entre en juego, remueve del juego todas las tierras.\\nCuando el Arrasareinos deje el juego, regresa al juego giradas bajo el control de sus propietarios las cartas removidas.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'El behemot rugió, y el mundo se liberó de imperios y tiranos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187903&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'48eac179-0547-42ef-a793-aed0d5559991\', \'multiverseId\': 187903}, \'multiverseid\': 187903}, {\'name\': \'Terrasseur de royaume\', \'text\': \'Quand le Terrasseur de royaume arrive en jeu, retirez de la partie tous les terrains.\\nQuand le Terrasseur de royaume quitte le jeu, renvoyez en jeu, engagées et sous le contrôle de leurs propriétaires, les cartes retirées.\', \'type\': \'Créature : bête\', \'flavor\': "Le béhémoth rugit et le monde fut balayé de l\'emprise des empires et des tyrans.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188650&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6824a284-9f70-49fd-a690-68e5f678c32a\', \'multiverseId\': 188650}, \'multiverseid\': 188650}, {\'name\': \'Distruttore del Reame\', \'text\': \'Quando il Distruttore del Reame entra in gioco, rimuovi dal gioco tutte le terre.\\nQuando il Distruttore del Reame lascia il gioco, rimetti in gioco TAPpate le carte rimosse sotto il controllo dei loro proprietari.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Il behemoth ruggì e il mondo fu liberato da imperi e tiranni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188401&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b6ed10d-94a1-4f92-94da-fadc1237772b\', \'multiverseId\': 188401}, \'multiverseid\': 188401}, {\'name\': \'領土を滅ぼすもの\', \'text\': \'領土を滅ぼすものが場に出たとき、すべての土地をゲームから取り除く。\\n領土を滅ぼすものが場を離れたとき、その取り除かれたカードをオーナーのコントロール下でタップ状態で場に戻す。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'ビヒモスは吼え、世界は帝国と暴君からあっという間に開放された。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187156&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b257212e-6ed9-4f29-a638-2c4260c5d2b7\', \'multiverseId\': 187156}, \'multiverseid\': 187156}, {\'name\': \'Destruidor de Reinos\', \'text\': \'Quando Destruidor de Reinos entrar em jogo, remova todos os terrenos do jogo.\\nQuando Destruidor de Reinos deixar o jogo, devolva os cards removidos ao jogo virados sob o controle de seus donos.\', \'type\': \'Criatura — Besta\', \'flavor\': \'O behemoth rugiu, e os impérios e tiranos foram aniquilados do mundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188152&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fc1b1f8-2403-4d48-9bc5-7a6e4a8ec439\', \'multiverseId\': 188152}, \'multiverseid\': 188152}, {\'name\': \'Разрушитель Владений\', \'text\': \'Когда Разрушитель Владений входит в игру, удалите из игры все земли.\\nКогда Разрушитель Владений покидает игру, верните те удаленные карты в игру повернутыми под контроль их владельцев.\', \'type\': \'Существо — Зверь\', \'flavor\': \'Чудище взревело, и мир взорвался, освободившись от империй и тиранов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188899&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e9b882c4-fb5b-45e9-91b0-1f226c513905\', \'multiverseId\': 188899}, \'multiverseid\': 188899}, {\'name\': \'夷壤\', \'text\': \'当夷壤进场时，将所有地移出对战。\\n当夷壤离场时，将所移出对战的牌分别在其拥有者的操控下横置移回场上。\', \'type\': \'生物～野兽\', \'flavor\': \'贝西摩斯高吼，从此世上不受帝国与暴君宰制。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187405&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fea41643-fd0d-47aa-ba9e-42ca2327c513\', \'multiverseId\': 187405}, \'multiverseid\': 187405}]', '[{\'name\': \'Erinnerungserosion\', \'text\': \'Immer wenn ein Gegner einen Zauberspruch spielt, legt dieser Spieler die obersten zwei Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Filigranen Texte verpflichten dich nicht, nach ihren Geboten zu leben. Sie zeigen dir nur die Konsequenzen auf, solltest du es nicht tun." —Lodus der Äthergläubige\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c263d1c-d92c-419f-a3c6-efadcb6d3a59\', \'multiverseId\': 187517}, \'multiverseid\': 187517}, {\'name\': \'Erosión de la memoria\', \'text\': \'Siempre que un oponente juegue un hechizo, ese jugador pone las dos primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Encantamiento\', \'flavor\': \'"Los Textos de Filigrana no te obligan a actuar según sus preceptos. Sólo especifican las consecuencias si no lo haces." —Lodus de los etereados\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187766&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60a2dc68-37d5-4d00-86a5-b118e8e225ec\', \'multiverseId\': 187766}, \'multiverseid\': 187766}, {\'name\': \'Érosion de la mémoire\', \'text\': "À chaque fois qu\'un adversaire joue un sort, ce joueur met les deux cartes du dessus de sa bibliothèque dans son cimetière.", \'type\': \'Enchantement\', \'flavor\': \'« Les Textes du Filigrane ne vous forcent pas à suivre leurs lois. Ils vous expliquent seulement quelles sont les conséquences si vous ne le faites pas. » —Lodus des Éthermentés\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'86c187f7-aabf-461d-9e66-6fcb812fd2ac\', \'multiverseId\': 188513}, \'multiverseid\': 188513}, {\'name\': \'Erosione della Memoria\', \'text\': \'Ogniqualvolta un avversario gioca una magia, quel giocatore mette nel suo cimitero le prime due carte del suo grimorio.\', \'type\': \'Incantesimo\', \'flavor\': \'"I Testi della Filigrana non ti costringono ad agire secondo i loro precetti. Si limitano a specificare le conseguenze nel caso tu fallisca." —Lodus degli Eterici\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188264&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3031d181-db87-4f72-8d67-7355f620b019\', \'multiverseId\': 188264}, \'multiverseid\': 188264}, {\'name\': \'記憶の浸食\', \'text\': \'いずれかの対戦相手が呪文を１つプレイするたび、そのプレイヤーは自分のライブラリーの一番上から２枚のカードを自分の墓地に置く。\', \'type\': \'エンチャント\', \'flavor\': \'「金線の書は、お前にその教えに従うよう仕向けるものではない。 ただ、従わない者の末路を示すだけだ。」 ――エーテル宣誓会のローダス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187019&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84eecd57-3f0c-4315-8f66-6b37545058b1\', \'multiverseId\': 187019}, \'multiverseid\': 187019}, {\'name\': \'Erosão de Memória\', \'text\': \'Toda vez que um oponente joga uma mágica, ele coloca os dois cards do topo de seu próprio grimório em seu próprio cemitério.\', \'type\': \'Encantamento\', \'flavor\': \'"Os Textos de Filigree não o compelem a agir de acordo com seus preceitos. Eles simplesmente especificam as conseqüências caso você não os siga." — Lodus, dos Etherólatras\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188015&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c9c7de3-eb5d-4b3c-aa04-c6afe262f872\', \'multiverseId\': 188015}, \'multiverseid\': 188015}, {\'name\': \'Эрозия Памяти\', \'text\': \'Каждый раз, когда оппонент разыгрывает заклинание, тот игрок кладет две верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Чары\', \'flavor\': \'«Филигранные Тексты не заставляют вас действовать согласно изложенным в них заповедям. Они лишь поясняют последствия в случае неповиновения». — Лодус из ордена Эфироблюстителей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188762&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'37e7c8d0-5442-4371-a988-32f8ab15ded1\', \'multiverseId\': 188762}, \'multiverseid\': 188762}, {\'name\': \'侵蚀记忆\', \'text\': \'每当任一对手使用咒语时，该牌手将其牌库顶的两张牌置入其坟墓场。\', \'type\': \'结界\', \'flavor\': \'「丝金录并未规定你必须遵从其上的戒律。 上面只列出不从的后果。」 ～乙金盟的罗得斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187268&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3c90d7f-1c7f-4842-abfd-8f39f9f31ab3\', \'multiverseId\': 187268}, \'multiverseid\': 187268}]', '[{\'name\': \'Erzdämon von Unx\', \'text\': \'Fliegend, verursacht Trampelschaden\\nOpfere zu Beginn deines Versorgungssegments eine Nicht-Zombiekreatur und bringe dann einen 2/2 schwarzen Zombie-Kreaturenspielstein ins Spiel.\', \'type\': \'Kreatur — Dämon\', \'flavor\': \'Die Nekropolis von Unx war einst eine lebendige Stadt, auf deren Straßen der Tod unbekannt war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'441d7422-3297-453a-95d0-cabfc3ffebc0\', \'multiverseId\': 187531}, \'multiverseid\': 187531}, {\'name\': \'Archidemonio de Unx\', \'text\': \'Vuela, arrolla.\\nAl comienzo de tu mantenimiento, sacrifica una criatura que no sea Zombie y luego pon en juego una ficha de criatura Zombie negra 2/2.\', \'type\': \'Criatura — Demonio\', \'flavor\': \'La necrópolis de Unx fue una vez una ciudad viva, sus calles limpias de muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187780&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67028ef1-b6cd-475a-b089-8483338e41a8\', \'multiverseId\': 187780}, \'multiverseid\': 187780}, {\'name\': "Archidémon d\'Unx", \'text\': \'Vol, piétinement\\nAu début de votre entretien, sacrifiez une créature non-zombie et mettez ensuite en jeu un jeton de créature 2/2 noire Zombie.\', \'type\': \'Créature : démon\', \'flavor\': "La nécropole d\'Unx était jadis une cité vivante dont les rues n\'étaient pas foulées par la mort.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188527&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90a5b0f1-418f-4f84-bf08-9a3656ce2c6d\', \'multiverseId\': 188527}, \'multiverseid\': 188527}, {\'name\': \'Arcidemone di Unx\', \'text\': "Volare, travolgere\\nAll\'inizio del tuo mantenimento, sacrifica una creatura non Zombie, poi metti in gioco una pedina creatura Zombie 2/2 nera.", \'type\': \'Creatura — Demone\', \'flavor\': \'La necropoli di Unx un tempo era una città viva, le sue strade sconosciute alla morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188278&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3fbf5504-137c-48c6-82ca-076d06cf4824\', \'multiverseId\': 188278}, \'multiverseid\': 188278}, {\'name\': \'アンクスの大悪魔\', \'text\': \'飛行、トランプル\\nあなたのアップキープの開始時に、ゾンビでないクリーチャーを１体生け贄に捧げ、その後、黒の２/２のゾンビ・クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': \'アンクスの死滅都市もかつては賑わっていて、その通りには死など寄りつきもしなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187033&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8dfc8da8-1cd5-4dee-a99c-a910f542eb40\', \'multiverseId\': 187033}, \'multiverseid\': 187033}, {\'name\': \'Arquidemônio de Unx\', \'text\': \'Voar, atropelar\\nNo início de sua manutenção, sacrifique uma criatura que não seja do tipo Zumbi e, em seguida, coloque em jogo uma ficha de criatura preta 2/2 do tipo Zumbi.\', \'type\': \'Criatura — Demônio\', \'flavor\': \'A necrópole de Unx já foi uma cidade vivaz, quando os mortos-vivos ainda não perambulavam por suas ruas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188029&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f4446f1-4e25-42df-9005-a3045a426dd0\', \'multiverseId\': 188029}, \'multiverseid\': 188029}, {\'name\': \'Архидемон Ункса\', \'text\': \'Полет, Пробивной удар\\nВ начале вашего шага поддержки пожертвуйте существо, не являющееся Зомби, затем положите в игру одну фишку существа 2/2 черный Зомби.\', \'type\': \'Существо — Демон\', \'flavor\': \'Когда-то некрополь Ункса был живым городом, и улицы его не знали, что такое шаги Смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188776&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e5f4db9a-98cb-4cf7-9a63-dd61f4d5e17f\', \'multiverseId\': 188776}, \'multiverseid\': 188776}, {\'name\': \'温各大恶魔\', \'text\': \'飞行，践踏\\n在你的维持开始时，牺牲一个非灵俑生物，然后将一个2/2黑色灵俑衍生物放置进场。\', \'type\': \'生物～恶魔\', \'flavor\': \'温各的古陵寝曾是个生机盎然、充满活力的都市。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187282&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'42d29f60-18fd-43c0-a366-dfd1289aec17\', \'multiverseId\': 187282}, \'multiverseid\': 187282}]', '[{\'name\': \'Ewige Spirale\', \'text\': \'{T}, entferne zwei Karten aus deinem Friedhof ganz aus dem Spiel: Ziehe eine Karte.\\nFalls dir Schaden zugefügt würde, verhindere diesen Schaden. Entferne für jeden auf diese Weise verhinderten 1 Schadenspunkt eine Karte aus deinem Friedhof ganz aus dem Spiel.\\nWenn du keine Karten in deinem Friedhof hast, verlierst du das Spiel.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187546&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d58312de-8e52-4a05-ad76-210e79f09a47\', \'multiverseId\': 187546}, \'multiverseid\': 187546}, {\'name\': \'Espiral inmortal\', \'text\': \'{T}, Remueve del juego dos cartas de tu cementerio: Roba una carta.\\nSi se te fuera a hacer daño, prevén ese daño. Remueve del juego una carta de tu cementerio por cada 1 punto de daño prevenido de esta manera.\\nCuando no haya cartas en tu cementerio, pierdes el juego.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187795&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b8d2632-8c52-486c-9ef3-73de18ea3323\', \'multiverseId\': 187795}, \'multiverseid\': 187795}, {\'name\': "Étreinte de l\'immortalité", \'text\': "{T}, retirez de la partie deux cartes de votre cimetière : Piochez une carte.\\nSi des blessures devaient vous être infligées, prévenez ces blessures. Retirez de la partie une carte de votre cimetière pour chaque 1 blessure prévenue de cette manière.\\nQuand il n\'y a plus de carte dans votre cimetière, vous perdez la partie.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188542&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b9468c1-3b09-42e2-a6f8-bb4b3938155f\', \'multiverseId\': 188542}, \'multiverseid\': 188542}, {\'name\': \'Serpentina Immortale\', \'text\': \'{T}, Rimuovi dal gioco due carte nel tuo cimitero: Pesca una carta.\\nSe ti sta per essere inflitto danno, previeni quel danno. Rimuovi dal gioco una carta nel tuo cimitero per ogni punto danno prevenuto in questo modo.\\nQuando non ci sono carte nel tuo cimitero, perdi la partita.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188293&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'48bfc519-eac4-4da9-a11a-d236350b51f2\', \'multiverseId\': 188293}, \'multiverseid\': 188293}, {\'name\': \'不死のコイル\', \'text\': \'{T}, あなたの墓地にあるカードを２枚ゲームから取り除く：カードを１枚引く。\\nあなたにダメージが与えられる場合、そのダメージをすべて軽減する。 これにより軽減されたダメージ１点につき、あなたの墓地にあるカードを１枚ゲームから取り除く。\\nあなたの墓地にカードがないとき、あなたはこのゲームに敗北する。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187048&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49f559a9-c465-4a27-89b2-9b3461aed40d\', \'multiverseId\': 187048}, \'multiverseid\': 187048}, {\'name\': \'Espiral Imortal\', \'text\': \'{T}, Remova do jogo dois cards de seu cemitério: Compre um card.\\nSe algum dano seria causado a você, previna aquele dano. Remova do jogo um card no seu cemitério para cada 1 ponto de dano prevenido desta maneira.\\nQuando não houver nenhum card no seu cemitério, você perderá o jogo.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188044&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'473dfdde-8d5c-4722-b8cf-b3d2a84cbfd9\', \'multiverseId\': 188044}, \'multiverseid\': 188044}, {\'name\': \'Петля Бессмертия\', \'text\': \'{T}, удалите из игры две карты, находящиеся на вашем кладбище: возьмите карту.\\nЕсли вам должны быть нанесены повреждения, предотвратите эти повреждения. Удалите из игры одну карту, находящуюся на вашем кладбище, за каждое 1 повреждение, предотвращенное таким образом.\\nКогда на вашем кладбище нет карт, вы проигрываете партию.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188791&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d249254c-ea74-42a6-a203-a6396b37094e\', \'multiverseId\': 188791}, \'multiverseid\': 188791}, {\'name\': \'永生圈环\', \'text\': \'{T}，从你坟墓场中将两张牌移出对战：抓一张牌。\\n若你将受到伤害，则防止该伤害。 每以此法防止1点伤害，就从你坟墓场中将一张牌移出对战。\\n当你的坟墓场没有牌时，你输掉这盘对战。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187297&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac400475-f6ef-4cfd-b421-d024b8458f0e\', \'multiverseId\': 187297}, \'multiverseid\': 187297}]', '[{\'name\': \'Exemplare begutachten\', \'text\': \'Falls eine Kreatur in diesem Zug unter der Kontrolle eines Gegners ins Spiel kommen würde, kommt sie stattdessen unter deiner Kontrolle ins Spiel.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es kann alles tun, was es will. Ich habe ihm nur souffliert, um was es sich dabei handelt." —Xorin, Architekt des Willens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187512&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4aaa348-4ddb-4054-ab75-a36dcf43c3cb\', \'multiverseId\': 187512}, \'multiverseid\': 187512}, {\'name\': \'Recolectar especímenes\', \'text\': \'Si una criatura fuera a entrar en juego bajo el control de un oponente este turno, en vez de eso, entra en juego bajo tu control.\', \'type\': \'Instantáneo\', \'flavor\': \'"Es libre de hacer lo que quiera. Yo sólo le digo qué es eso." —Xorin, arquitecto de voluntad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187761&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'020978a0-3328-47bb-93d1-dbf00bb1f6f4\', \'multiverseId\': 187761}, \'multiverseid\': 187761}, {\'name\': \'Rassembler des spécimens\', \'text\': "Si une créature devait arriver en jeu sous le contrôle d\'un adversaire ce tour-ci, elle arrive en jeu sous votre contrôle à la place.", \'type\': \'Éphémère\', \'flavor\': "« Il est libre de faire ce qu\'il veut. Je n\'ai fait que lui dire ce que c\'était. » —Xorin, architecte de la Volonté", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188508&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd37d99f-68a8-42d2-b384-6990e64e5c04\', \'multiverseId\': 188508}, \'multiverseid\': 188508}, {\'name\': \'Raccogliere Esemplari\', \'text\': \'Se una creatura sta per entrare in gioco sotto il controllo di un avversario in questo turno, entra invece in gioco sotto il tuo controllo.\', \'type\': \'Istantaneo\', \'flavor\': \'"E\\\' libero di fare tutto quel che vuole. Gli ho semplicemente detto che cos\\\'è." —Xorin, Architetto della Volontà\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188259&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2c34119-bc0f-462f-aa46-235ffc7aca10\', \'multiverseId\': 188259}, \'multiverseid\': 188259}, {\'name\': \'標本集め\', \'text\': \'このターン、いずれかのクリーチャーがいずれかの対戦相手のコントロール下で場に出る場合、代わりにそれはあなたのコントロール下で場に出る。\', \'type\': \'インスタント\', \'flavor\': \'「やりたいことをやるのは自由さ。 単にそれがどうなるかって話をしただけで。」 ――意思切る者、ゾリン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187014&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0be246a9-0581-43fa-acbc-1ab09d113c20\', \'multiverseId\': 187014}, \'multiverseid\': 187014}, {\'name\': \'Reunir Espécimes\', \'text\': \'Se uma criatura for entrar em jogo sob o controle de um oponente neste turno, em vez disso, ela entrará em jogo sob o seu controle.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Ele é livre para fazer o que quiser. Eu mal lhe disse o que era isso." — Xorin, Arquiteto do Arbítrio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f18bf15e-5235-4d32-a7f1-3d106335e665\', \'multiverseId\': 188010}, \'multiverseid\': 188010}, {\'name\': \'Сбор Образцов\', \'text\': \'Если в этом ходу существо должно войти в игру под контролем оппонента, оно входит в игру под вашим контролем вместо этого.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Она может делать все, что захочет. Я просто сказал ей, что именно». — Ксорин, архитектор воли\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188757&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7e06e726-5bdb-4962-bca4-0fc428ff0444\', \'multiverseId\': 188757}, \'multiverseid\': 188757}, {\'name\': \'收集样本\', \'text\': \'本回合中，如果某生物将在对手的操控下进场，则它改为在你的操控下进场。\', \'type\': \'瞬间\', \'flavor\': \'「他可以随意行事。 我只是告诉他该要些什么。」 ～构念师索林\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187263&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f501d21-bbd5-4164-8325-5c1572da13f1\', \'multiverseId\': 187263}, \'multiverseid\': 187263}]', '[{\'name\': \'Exkommunizieren\', \'text\': \'Lege eine Kreatur deiner Wahl oben auf die Bibliothek ihres Besitzers.\', \'type\': \'Hexerei\', \'flavor\': \'Rebellen und andere Unzufriedene, die zur Teilnahme am Ritual gezwungen wurden, wachen einsam in den weiten Savannen Topas wieder auf. Wer den Weg zurück findet, kehrt bescheiden und bußwillig heim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187478&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8772e96-32f0-4d0f-aa10-d575f29ede40\', \'multiverseId\': 187478}, \'multiverseid\': 187478}, {\'name\': \'Excomulgar\', \'text\': \'Pon la criatura objetivo en la parte superior de la biblioteca de su propietario.\', \'type\': \'Conjuro\', \'flavor\': \'Los rebeldes forzados al ritual se despiertan perdidos en las vastas sabanas de Topa. Aquellos que encuentran el camino de regreso vuelven arrepentidos y humildes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187727&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d85073fe-1065-464a-9334-e295eaf4006b\', \'multiverseId\': 187727}, \'multiverseid\': 187727}, {\'name\': \'Excommunication\', \'text\': \'Mettez la créature ciblée au-dessus de la bibliothèque de son propriétaire.\', \'type\': \'Rituel\', \'flavor\': "Les rebelles et autres mécontents impliqués de force dans le rituel s\'éveillent perdus quelque part dans les vastes savanes de Topa. Ceux qui en reviennent se repentent de leur manque de foi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188474&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0091f35-1f56-4928-b63b-57a18925e612\', \'multiverseId\': 188474}, \'multiverseid\': 188474}, {\'name\': \'Scomunicare\', \'text\': \'Metti una creatura bersaglio in cima al grimorio del suo proprietario.\', \'type\': \'Stregoneria\', \'flavor\': \'Ribelli e altri scontenti costretti al rituale si risvegliano dispersi nelle vaste savane di Topa. Quelli che trovano la strada di casa ritornano umili e penitenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188225&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9895701-09f0-4bdb-848c-0fc2541bcd3d\', \'multiverseId\': 188225}, \'multiverseid\': 188225}, {\'name\': \'破門\', \'text\': \'クリーチャー１体を対象とし、それをオーナーのライブラリーの一番上に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'儀式へと強制的に送り込まれた反乱軍や他の不満分子は、トーパの巨大なサバンナで何も分からないまま目を覚ます。 そして、何とか故郷へ帰った者達は、卑屈と後悔の中に捕らわれることとなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186980&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fa81ca4d-200a-482c-8a23-c409b7bbbfd8\', \'multiverseId\': 186980}, \'multiverseid\': 186980}, {\'name\': \'Excomungar\', \'text\': \'Coloque a criatura alvo no topo do grimório de seu dono.\', \'type\': \'Feitiço\', \'flavor\': \'Os rebeldes e outros descontentes que são submetidos ao ritual à força despertam perdidos nas amplas savanas de Topa. Aqueles que encontram seu caminho de volta retornam humildes e arrependidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187976&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90e58b25-f4a4-484e-b55d-70b1affbcad9\', \'multiverseId\': 187976}, \'multiverseid\': 187976}, {\'name\': \'Отлучение\', \'text\': \'Положите целевое существо на верх библиотеки его владельца.\', \'type\': \'Волшебство\', \'flavor\': \'Мятежников и прочих недовольных принуждают пройти особый ритуал, после которого они выходят из забытья, затерянные в бескрайних саваннах Топы. Те, кто находит дорогу домой, возвращаются безропотными и раскаявшимися.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188723&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'81d811c3-99c0-4ed0-86c9-0777f29c732d\', \'multiverseId\': 188723}, \'multiverseid\': 188723}, {\'name\': \'逐出教会\', \'text\': \'将目标生物置于其拥有者的牌库顶。\', \'type\': \'法术\', \'flavor\': \'反抗者与其他不满现状者被迫进行此仪式，醒来后发现自己置身托帕的广阔草原。 回得来的人都带着谦卑悔悟的心境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187229&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c404933-c0f6-4c4d-9f69-479c828847d7\', \'multiverseId\': 187229}, \'multiverseid\': 187229}]', '[{\'name\': \'Fahlschlag\', \'text\': \'Der Fahlschlag fügt einem Spieler deiner Wahl 3 Schadenspunkte zu. Dieser Spieler wirft zwei Karten aus seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': \'Während der Gestank nach brennendem Fleisch in Grixis normal ist, kann man den Geruch von schwelender Gehirnmasse nur selten erschnuppern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187623&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c48838a-d271-4f06-bf1e-f34d6fb6aded\', \'multiverseId\': 187623}, \'multiverseid\': 187623}, {\'name\': \'Ruinámpago\', \'text\': \'El Ruinámpago hace 3 puntos de daño al jugador objetivo. Ese jugador descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Aunque el olor de la carne ardiendo es común en Grixis, el aroma de cerebros asados es un manjar delicado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187872&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03c728ef-a9fb-4163-bce2-96cb4e3a0bac\', \'multiverseId\': 187872}, \'multiverseid\': 187872}, {\'name\': \'Éclair de flétrissement\', \'text\': "L\'Éclair de flétrissement inflige 3 blessures au joueur ciblé. Ce joueur se défausse de deux cartes.", \'type\': \'Rituel\', \'flavor\': "Alors que l\'odeur de la chair brûlée est courante sur Grixis, celle de la cervelle grillée est plutôt rare.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188619&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df0b14ba-0cf7-424c-83bc-70e6fc6761af\', \'multiverseId\': 188619}, \'multiverseid\': 188619}, {\'name\': \'Folgore Devastante\', \'text\': \'La Folgore Devastante infligge 3 danni a un giocatore bersaglio. Quel giocatore scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': "Anche se l\'odore di carne bruciata è comune in Grixis, la puzza di materia grigia ardente è una gioia rara.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bad1ec9d-552c-4dd4-9025-1563703ec079\', \'multiverseId\': 188370}, \'multiverseid\': 188370}, {\'name\': \'荒廃稲妻\', \'text\': \'プレイヤー１人を対象とする。荒廃稲妻はそのプレイヤーに３点のダメージを与える。 そのプレイヤーはカードを２枚捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'グリクシスでは肉の焼ける臭いは普通のことだが、脳みその燻る臭いは珍しいご馳走だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187125&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f66b686b-8860-43d6-ba2b-07b153390c7d\', \'multiverseId\': 187125}, \'multiverseid\': 187125}, {\'name\': \'Detonar\', \'text\': \'Detonar causa 3 pontos de dano ao jogador alvo. Aquele jogador descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Enquanto o odor de carne tostada é muito comum em Grixis, o odor de massa cerebral fumegante é uma fina iguaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188121&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7aebae22-91a4-41e1-a8a2-31ecc4d1d626\', \'multiverseId\': 188121}, \'multiverseid\': 188121}, {\'name\': \'Губительная Молния\', \'text\': \'Губительная Молния наносит 3 повреждения целевому игроку. Тот игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Хотя запах горелой плоти не редкость на Гриксисе, аромат подпаленного мозга это необычное лакомство.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188868&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7fcf2866-f908-4198-a04a-d1a11dbdc6bf\', \'multiverseId\': 188868}, \'multiverseid\': 188868}, {\'name\': \'脑电击\', \'text\': \'脑电击对目标牌手造成3点伤害。 该牌手弃掉两张牌。\', \'type\': \'法术\', \'flavor\': \'虽然焦肉气味在格利极到处都闻得到，但飘烟的脑浆气味倒是少有机会遇上。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187374&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f8346de9-c251-4fc2-984c-4a1bbb1208e3\', \'multiverseId\': 187374}, \'multiverseid\': 187374}]', '[{\'name\': \'Feuerfeld-Oger\', \'text\': \'Erstschlag\\nExhumieren {U}{B}{R} ({U}{B}{R}: Bringe diese Karte aus deinem Friedhof ins Spiel zurück. Sie hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Kreatur — Oger, Mutant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e55e25bc-a9db-4e59-939b-06be9dd25f0f\', \'multiverseId\': 187635}, \'multiverseid\': 187635}, {\'name\': \'Ogro campo de fuego\', \'text\': \'Daña primero.\\nDesenterrar {U}{B}{R}. ({U}{B}{R}: Regresa esta carta de tu cementerio al juego. Gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura — Mutante ogro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187884&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4ab31df1-2260-490a-9b49-7feed2150e50\', \'multiverseId\': 187884}, \'multiverseid\': 187884}, {\'name\': \'Ogre du champ de feu\', \'text\': "Initiative\\nExhumation {U}{B}{R} ({U}{B}{R} : Renvoyez en jeu cette carte depuis votre cimetière. Elle acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature : ogre et mutant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188631&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad8a1d00-5bac-4d3b-83e4-da6c1790c00e\', \'multiverseId\': 188631}, \'multiverseid\': 188631}, {\'name\': \'Ogre Campo di Fuoco\', \'text\': \'Attacco improvviso\\nDissotterrare {U}{B}{R} ({U}{B}{R}: Rimetti in gioco questa carta dal tuo cimitero. Ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)\', \'type\': \'Creatura — Mutante Ogre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188382&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0c2a28b-11d9-4e08-a649-208b009f3dab\', \'multiverseId\': 188382}, \'multiverseid\': 188382}, {\'name\': \'火炎地のオーガ\', \'text\': \'先制攻撃\\n蘇生 {U}{B}{R} ({U}{B}{R}：このカードをあなたの墓地から場に戻す。 それは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — オーガ・ミュータント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187137&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'67e2fe57-18ab-4632-8402-0e945bd8943b\', \'multiverseId\': 187137}, \'multiverseid\': 187137}, {\'name\': \'Ogre Campo de Fogo\', \'text\': \'Iniciativa\\nDesenterrar {U}{B}{R} ({U}{B}{R}: Devolva este card de seu cemitério para o jogo. Ele ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura — Ogre Mutante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188133&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'61c44b6a-4797-4887-b618-47ab33671e9b\', \'multiverseId\': 188133}, \'multiverseid\': 188133}, {\'name\': \'Огр Огненного Поля\', \'text\': \'Первый удар\\nОткопать {U}{B}{R} ({U}{B}{R}: верните эту карту из вашего кладбища в игру. Она получает Ускорение. Удалите ее из игры в конце хода, или если она должна покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Существо — Огр Мутант\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188880&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9afe7c44-c118-4ba8-9158-c839ae6ecd91\', \'multiverseId\': 188880}, \'multiverseid\': 188880}, {\'name\': \'火鬼食人魔\', \'text\': \'先攻\\n破坟{U}{B}{R} （{U}{B}{R}：将此牌从你的坟墓场移回场上。 它获得敏捷。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'生物～食人魔／突变体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187386&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5f40d80-3899-4ae4-9578-498d0c5ff2eb\', \'multiverseId\': 187386}, \'multiverseid\': 187386}]', '[{\'name\': \'Flammenstoß-Drache\', \'text\': \'Fliegend\\nImmer wenn der Flammenstoß-Drache angreift, kannst du {X}{R} bezahlen. Falls du dies tust, fügt der Flammenstoß-Drache einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Drachenfürsten von Jund herrschen durch das Gesetz der Flamme.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95362703-0039-49c2-971f-5eaac9d04641\', \'multiverseId\': 187567}, \'multiverseid\': 187567}, {\'name\': \'Dragón ráfaga de llamas\', \'text\': \'Vuela.\\nSiempre que el Dragón ráfaga de llamas ataque, puedes pagar {X}{R}. Si lo haces, el Dragón ráfaga de llamas hace X puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Los señores dragón de Jund gobiernan con edictos de fuego.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187816&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'23cac1f2-0697-45ea-b0a5-54dd94a4778d\', \'multiverseId\': 187816}, \'multiverseid\': 187816}, {\'name\': \'Dragon à la salve de flammes\', \'text\': \'Vol\\nÀ chaque fois que le Dragon à la salve de flammes attaque, vous pouvez payer {X}{R}. Si vous faites ainsi, le Dragon à la salve de flammes inflige X blessures à une cible, créature ou joueur.\', \'type\': \'Créature : dragon\', \'flavor\': "Les seigneurs dragon de Jund règnent par l\'édit des flammes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188563&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'990ab13c-a9b8-4afe-ad46-45884db2192c\', \'multiverseId\': 188563}, \'multiverseid\': 188563}, {\'name\': \'Drago Esplosivo\', \'text\': \'Volare\\nOgniqualvolta il Drago Esplosivo attacca, puoi pagare {X}{R}. Se lo fai, il Drago Esplosivo infligge X danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Drago\', \'flavor\': \'I signori dei draghi di Jund governano con editti di fiamme.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188314&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e8e3eb2-1655-4956-ae75-1499535464ee\', \'multiverseId\': 188314}, \'multiverseid\': 188314}, {\'name\': \'炎破のドラゴン\', \'text\': \'飛行\\n炎破のドラゴンが攻撃するたび、クリーチャー１体かプレイヤー１人を対象とする。あなたは{X}{R}を支払ってもよい。 そうした場合、炎破のドラゴンはそれにＸ点のダメージを与える。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'ジャンドの竜の王は、炎の命じで支配を行う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187069&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3479c87-4e7d-4aa5-8d90-14fdbed7482a\', \'multiverseId\': 187069}, \'multiverseid\': 187069}, {\'name\': \'Dragão da Explosão Flamejante\', \'text\': \'Voar\\nToda vez que Dragão da Explosão Flamejante ataca, você pode pagar {X}{R}. Se o fizer, Dragão da Explosão Flamejante causará X pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'Os lordes dragões de Jund governam através de éditos de fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188065&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e94da52-6864-4816-96ef-d8a1b99aa51a\', \'multiverseId\': 188065}, \'multiverseid\': 188065}, {\'name\': \'Огнеметный Дракон\', \'text\': \'Полет\\nКаждый раз, когда Огнеметный Дракон атакует, вы можете заплатить {X}{R}. Если вы это делаете, Огнеметный Дракон наносит Х повреждений целевому существу или игроку.\', \'type\': \'Существо — Дракон\', \'flavor\': \'Драконы-повелители правят на Джанде силой пламени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188812&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ba070cb3-69dc-44ee-a89f-2c6cc844827c\', \'multiverseId\': 188812}, \'multiverseid\': 188812}, {\'name\': \'爆焰巨龙\', \'text\': \'飞行\\n每当爆焰巨龙攻击时，你可以支付{X}{R}。 若你如此作，则爆焰巨龙对目标生物或牌手造成X点伤害。\', \'type\': \'生物～龙\', \'flavor\': \'勇得的巨龙领主以火焰勒令来统治。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187318&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab24fc85-b135-46ef-b200-423f1a181a85\', \'multiverseId\': 187318}, \'multiverseid\': 187318}]', "[{'name': 'Fluchwespen-Heimsuchung', 'text': 'Kreaturenverzauberung\\nWenn die verzauberte Kreatur auf einen Friedhof gelegt wird, verliert der Beherrscher der Kreatur Lebenspunkte in Höhe ihrer Widerstandskraft.', 'type': 'Verzauberung — Aura', 'flavor': 'Das alles verzehrende Untote in Grixis jagt den Überlebenden aus Vithia Angst ein, doch die Tierwelt ist ebenso schrecklich.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187532&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f5164ee6-5bc2-4a4c-8276-694d928cfc3f', 'multiverseId': 187532}, 'multiverseid': 187532}, {'name': 'Aflicción de avispa de ruina', 'text': 'Encantar criatura.\\nCuando la criatura encantada vaya a un cementerio, el controlador de la criatura pierde vida igual a su resistencia.', 'type': 'Encantamiento — Aura', 'flavor': 'Los muertos vivientes de Grixis aterrorizan a los supervivientes de Vithia, pero su fauna es igual de espantosa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187781&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd7d19499-0ce1-42f1-b908-3dd049d1cc38', 'multiverseId': 187781}, 'multiverseid': 187781}, {'name': 'Affliction des guêplaies', 'text': 'Enchanter : créature\\nQuand la créature enchantée est mise dans un cimetière, le contrôleur de cette créature perd un nombre de points de vie égal à son endurance.', 'type': 'Enchantement : aura', 'flavor': 'La morte-vie vorace de Grixis terrifie les survivants de Vithia, mais sa faune est tout aussi effrayante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188528&type=card', 'language': 'French', 'identifiers': {'scryfallId': '161e60ac-4c0c-49e2-ab2c-0abbc19ec880', 'multiverseId': 188528}, 'multiverseid': 188528}, {'name': 'Calamità di Vespiaga', 'text': 'Incanta creatura\\nQuando la creatura incantata viene messa in un cimitero, il controllore di quella creatura perde punti vita pari alla sua costituzione.', 'type': 'Incantesimo — Aura', 'flavor': 'La non morte struggente di Grixis terrorizza i sopravvissuti di Vithia, ma la sua fauna è altrettanto spaventosa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188279&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0e2ac8d9-9bd4-497a-b9aa-75d6609bbcf2', 'multiverseId': 188279}, 'multiverseid': 188279}, {'name': '破滅蜂の苦悩', 'text': 'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーがいずれかの墓地に置かれたとき、そのクリーチャーのコントローラーはそれのタフネスに等しい点数のライフを失う。', 'type': 'エンチャント — オーラ', 'flavor': 'グリクシスの破滅的な不死者はヴィティアの生き残りを脅かしているが、そもそもそこに生息する動物すら同じぐらいに恐ろしい。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187034&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6841edae-c583-46e6-9f36-72a31a2e38d4', 'multiverseId': 187034}, 'multiverseid': 187034}, {'name': 'Aflição de Vespa-Voraz', 'text': 'Encantar criatura\\nQuando a criatura encantada é colocada em um cemitério, o controlador daquela criatura perde uma quantidade de pontos de vida igual à sua resistência.', 'type': 'Encantamento — Aura', 'flavor': 'Os mortos-vivos de Grixis aterrorizam os sobreviventes de Vithia, mas a sua fauna é igualmente intimidante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188030&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '937a6b29-5c9b-4570-9e4b-25643eda21c7', 'multiverseId': 188030}, 'multiverseid': 188030}, {'name': 'Нападение Плотоядных Ос', 'text': 'Зачаровать существо\\nКогда зачарованное существо попадает на кладбище, контролирующий то существо игрок теряет количество жизней, равное его выносливости.', 'type': 'Чары — Аура', 'flavor': 'Всепоглощающая нежизнь Гриксиса вселяет ужас в выживших витийцев, но его фауна страшит не меньше.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188777&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9de4dcc9-c7cf-4f14-b1a3-c1589be99cfe', 'multiverseId': 188777}, 'multiverseid': 188777}, {'name': '食肉蜂纠缠', 'text': '生物结界\\n当受此结界的生物置入坟墓场时，该生物的操控者失去等同于其防御力的生命。', 'type': '结界～灵气', 'flavor': '不死生物横行格利极，让威西亚王国的幸存者惊骇万分；但该处的动物也是一样可怕。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187283&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c5a060d2-6c29-44dd-a5fa-cc8013889ab4', 'multiverseId': 187283}, 'multiverseid': 187283}]", '[{\'name\': \'Fähigkeitsausleiher\', \'text\': \'Die oberste Karte deiner Bibliothek ist offen.\\nSolange die oberste Karte deiner Bibliothek eine Artefakt- oder Kreaturenkarte ist, hat der Fähigkeitsausleiher alle aktivierten Fähigkeiten dieser Karte. (Verwenden einige dieser Fähigkeiten den Namen jener Karte, verwende stattdessen den Namen dieser Kreatur.)\', \'type\': \'Artefaktkreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61138537-850e-4dd8-b1d5-8bee1e66e26d\', \'multiverseId\': 187523}, \'multiverseid\': 187523}, {\'name\': \'Apropiadora de destrezas\', \'text\': \'Juega mostrando la primera carta de tu biblioteca.\\nMientras la primera carta de tu biblioteca sea una carta de criatura o artefacto, la Apropiadora de destrezas tiene todas las habilidades activadas de esa carta. (Si alguna de las habilidades usa el nombre de esa carta, en vez de eso, usa el nombre de esta carta.)\', \'type\': \'Criatura artefacto — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187772&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'48a26e6b-0636-46aa-8d2c-6326e8b78c61\', \'multiverseId\': 187772}, \'multiverseid\': 187772}, {\'name\': \'Emprunteuse de talent\', \'text\': "Jouez avec la carte du dessus de votre bibliothèque révélée.\\nTant que la carte du dessus de votre bibliothèque est une carte d\'artefact ou de créature, l\'Emprunteuse de talent a toutes les capacités activées de cette carte. (Si l\'une de ces capacités utilise le nom de cette carte, utilisez le nom de cette créature à la place.)", \'type\': \'Créature-artefact : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188519&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'658a3123-9344-4a49-899b-a33abd166ca8\', \'multiverseId\': 188519}, \'multiverseid\': 188519}, {\'name\': \'Prestatrice di Abilità\', \'text\': \'Gioca con la prima carta del tuo grimorio rivelata.\\nFintanto che la prima carta del tuo grimorio è una carta artefatto o creatura, la Prestatrice di Abilità ha tutte le abilità attivate di quella carta. (Se una delle abilità usa il nome di quella carta, usa invece il nome di questa creatura.)\', \'type\': \'Creatura Artefatto — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188270&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e194308-015d-4a8d-a4a6-d3208d1fb5fe\', \'multiverseId\': 188270}, \'multiverseid\': 188270}, {\'name\': \'技を借りる者\', \'text\': \'あなたのライブラリーの一番上のカードを公開したままプレイする。\\nあなたのライブラリーの一番上のカードがアーティファクト・カードかクリーチャー・カードであるかぎり、技を借りる者はそのカードのすべての起動型能力を持つ。 （それらの能力がそのカードの名前を用いている場合、代わりにこのクリーチャーの名前を用いる。）\', \'type\': \'アーティファクト・クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187025&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'862077e5-f0a7-488a-af6d-d84e6ebf6296\', \'multiverseId\': 187025}, \'multiverseid\': 187025}, {\'name\': \'Prestador de Habilidades\', \'text\': \'Jogue com o card do topo de seu grimório revelado.\\nEnquanto o card do topo de seu grimório for um card de artefato ou de criatura, Prestador de Habilidades terá todas as habilidades ativadas daquele card. (Se uma das habilidades usar o nome daquele card, em vez disso, use o nome desta criatura.)\', \'type\': \'Criatura Artefato — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188021&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67374563-ec3a-4232-ba91-e6d584986fff\', \'multiverseId\': 188021}, \'multiverseid\': 188021}, {\'name\': \'Заемщица Умений\', \'text\': \'Играйте с открытой верхней картой вашей библиотеки.\\nПока верхняя карта вашей библиотеки карта артефакта или существа, Заемщица Умений имеет все активируемые способности той карты. (Если в каких-либо из тех способностей используется имя той карты, вместо него используйте имя этого существа.)\', \'type\': \'Артефактное Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188768&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'43a5b7a9-2d36-4009-94f1-9ffec8ad4be3\', \'multiverseId\': 188768}, \'multiverseid\': 188768}, {\'name\': \'借招法师\', \'text\': \'你以展示牌库顶牌的方式进行对战。\\n只要你的牌库顶牌是神器或生物牌，借招法师便具有该牌的所有起动式异能。 （若任何异能用到了该牌的名称，则改为用此生物的名称）\', \'type\': \'神器生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187274&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb4372a4-b6b8-4a11-beff-7d47fdc4b9da\', \'multiverseId\': 187274}, \'multiverseid\': 187274}]', '[{\'name\': \'Gabe der Gargantuas\', \'text\': \'Schaue dir die obersten vier Karten deiner Bibliothek an. Du kannst eine Kreaturenkarte und/oder eine Länderkarte darunter offen vorzeigen und die vorgezeigten Karten auf deine Hand nehmen. Lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187599&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c05762c-ecec-45c2-85c8-a0d6d2f84cac\', \'multiverseId\': 187599}, \'multiverseid\': 187599}, {\'name\': \'Regalo de las gargantúas\', \'text\': \'Mira las primeras cuatro cartas de tu biblioteca. Puedes mostrar una carta de criatura y/o una carta de tierra que se encuentre entre ellas y poner las cartas mostradas en tu mano. Pon el resto en la parte inferior de tu biblioteca en cualquier orden.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187848&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e1d9c14d-12ec-428d-aebd-ea8dbd385a07\', \'multiverseId\': 187848}, \'multiverseid\': 187848}, {\'name\': \'Don du gargantuesque\', \'text\': "Regardez les quatre cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte de créature et/ou une carte de terrain parmi elles et mettre les cartes révélées dans votre main. Mettez les autres au-dessous de votre bibliothèque, dans n\'importe quel ordre.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188595&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77172a88-16be-4cdf-b2db-d038ed8c742b\', \'multiverseId\': 188595}, \'multiverseid\': 188595}, {\'name\': \'Dono del Mastodonte\', \'text\': \'Guarda le prime quattro carte del tuo grimorio. Tra esse puoi rivelare una carta creatura e/o una carta terra e aggiungere alla tua mano le carte rivelate. Metti le altre in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188346&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef6d5f08-d7a7-4b07-8120-5a803593241c\', \'multiverseId\': 188346}, \'multiverseid\': 188346}, {\'name\': \'ガルガンチュアンの贈り物\', \'text\': \'あなたのライブラリーの一番上から４枚のカードを見る。 あなたはそれらの中からクリーチャー・カード１枚か土地カード１枚かその両方を公開してもよい。そうしたなら、その公開したカードをあなたの手札に加える。 残りのカードをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187101&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'67f211d2-c575-4612-8fb5-2de0e125e5b4\', \'multiverseId\': 187101}, \'multiverseid\': 187101}, {\'name\': \'Dom do Gargantua\', \'text\': \'Olhe os quatro cards do topo de seu grimório. Você pode revelar um card de criatura e/ou um card de terreno entre eles e colocar os cards revelados na sua mão. Coloque o resto no fundo de seu grimório em qualquer ordem.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188097&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'afc57354-96dd-41d0-b13c-8be3a54e36a3\', \'multiverseId\': 188097}, \'multiverseid\': 188097}, {\'name\': \'Дар Исполина\', \'text\': \'Посмотрите четыре верхние карты вашей библиотеки. Вы можете показать из них карту существа и (или) карту земли и положить показанные карты в вашу руку. Положите остальные карты в низ вашей библиотеки в любом порядке.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188844&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a06bd02e-1dfc-4def-8431-cb53be7ba311\', \'multiverseId\': 188844}, \'multiverseid\': 188844}, {\'name\': \'巨兽赋礼\', \'text\': \'检视你牌库顶的四张牌。 你可以展示其中的一张生物牌和／或一张地牌，并将所展示的牌置于你手上。 将其余的牌以任意顺序置于你牌库底。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187350&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83fd42b2-885c-437c-a5c0-21c06c3db217\', \'multiverseId\': 187350}, \'multiverseid\': 187350}]', '[{\'name\': \'Gargoyle des Heiligtums\', \'text\': \'Fliegend\\nWenn der Gargoyle des Heiligtums ins Spiel kommt, kannst du eine Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurücknehmen.\', \'type\': \'Artefaktkreatur — Gargoyle\', \'flavor\': \'Als ihre Ätherium-Vorräte zur Neige gingen, mussten die Mechaniker ihre Gargoylen immer weiter ausschicken, um Nachschub zu erhalten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3dba39dd-1c5f-4d05-9992-b13a42b596f4\', \'multiverseId\': 187491}, \'multiverseid\': 187491}, {\'name\': \'Gárgola del santuario\', \'text\': \'Vuela.\\nCuando la Gárgola del santuario entre en juego, puedes regresar la carta de artefacto objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura artefacto — Gárgola\', \'flavor\': \'Cuando sus reservas de eterium menguaron, los mecanistas enviaron gárgolas más y más lejos para encontrar restos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187740&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d6d14e85-9c30-4ffa-bda5-b81dc973346e\', \'multiverseId\': 187740}, \'multiverseid\': 187740}, {\'name\': \'Gargouille du sanctuaire\', \'text\': "Vol\\nQuand la Gargouille du sanctuaire arrive en jeu, vous pouvez renvoyer une carte d\'artefact ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature-artefact : gargouille\', \'flavor\': "Leurs réserves d\'étherium disparaissant rapidement, les mécanistes envoyèrent les gargouilles toujours plus loin pour en récupérer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188487&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7ad98847-4fd5-48ec-b4b2-025af22a6bda\', \'multiverseId\': 188487}, \'multiverseid\': 188487}, {\'name\': \'Gargoyle del Santuario\', \'text\': \'Volare\\nQuando il Gargoyle del Santuario entra in gioco, puoi riprendere in mano una carta artefatto bersaglio dal tuo cimitero.\', \'type\': \'Creatura Artefatto — Gargoyle\', \'flavor\': \'Man mano che le loro scorte di eterium si riducevano, i meccanicisti inviavano i gargoyle sempre più lontano in cerca di materiale di recupero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188238&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2576fa22-3c00-4cf0-8655-169c3f613793\', \'multiverseId\': 188238}, \'multiverseid\': 188238}, {\'name\': \'聖域のガーゴイル\', \'text\': \'飛行\\n聖域のガーゴイルが場に出たとき、あなたの墓地にあるアーティファクト・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。\', \'type\': \'アーティファクト・クリーチャー — ガーゴイル\', \'flavor\': \'エーテリウムの供給が少なくなるにつれ、商人は廃物を求めてガーゴイルをより遠くへと送り込むようになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186993&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'91f614f6-62e8-4a09-be37-07156486122b\', \'multiverseId\': 186993}, \'multiverseid\': 186993}, {\'name\': \'Gárgula do Santuário\', \'text\': \'Voar\\nQuando Gárgula do Santuário entra em jogo, você pode devolver o card de artefato alvo de seu cemitério para a sua mão.\', \'type\': \'Criatura Artefato — Gárgula\', \'flavor\': \'Quando suas reservas de etherium acabaram, os mecanistas enviaram as gárgulas cada vez mais longe em busca de uma salvação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187989&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b4f4cb5a-6fe5-4847-adf4-838fa82261f8\', \'multiverseId\': 187989}, \'multiverseid\': 187989}, {\'name\': \'Горгулья Святилища\', \'text\': \'Полет\\nКогда Горгулья Святилища входит в игру, вы можете вернуть целевую карту артефакта из вашего кладбища в вашу руку.\', \'type\': \'Артефактное Существо — Горгулья\', \'flavor\': \'По мере того как запасы эфирия подходили к концу, маги-механики отправляли горгулий все дальше и дальше на поиски скрапа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188736&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b0d6b90d-2f7e-42bf-acb3-8e4b57e1d4eb\', \'multiverseId\': 188736}, \'multiverseid\': 188736}, {\'name\': \'圣所石像鬼\', \'text\': \'飞行\\n当圣所石像鬼进场时，你可以将目标神器牌从你的坟墓场移回你手上。\', \'type\': \'神器生物～石像鬼\', \'flavor\': \'机械师在乙金存量不足时，会派出石像鬼到遥远彼方搜寻可用材料。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187242&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dde2859c-28e2-47d1-b0f7-18925b9ebeda\', \'multiverseId\': 187242}, \'multiverseid\': 187242}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187709&type=card', 'language': 'German', 'identifiers': {'scryfallId': '54148605-9166-4df1-9587-20b1043e1033', 'multiverseId': 187709}, 'multiverseid': 187709}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187958&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'dc3ef99e-5f17-481b-8b17-c73f9bc3258e', 'multiverseId': 187958}, 'multiverseid': 187958}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188705&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5a58322d-d625-41d6-8c79-b29a8115ad1a', 'multiverseId': 188705}, 'multiverseid': 188705}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188456&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a24faaed-008a-4cb2-8d5b-16eb772de19e', 'multiverseId': 188456}, 'multiverseid': 188456}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187211&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5748b177-5efd-4b51-b17b-9d7df9f447a3', 'multiverseId': 187211}, 'multiverseid': 187211}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188207&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '259e5c40-8990-4d91-a1ff-1b83b9133a9f', 'multiverse