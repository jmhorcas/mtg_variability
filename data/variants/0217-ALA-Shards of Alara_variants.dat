s.com/Handlers/Image.ashx?multiverseid=188699&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9fced246-2721-4617-96df-fd863ce87a0f', 'multiverseId': 188699}, 'multiverseid': 188699}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188450&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd4c19bb8-2e09-41cb-bfdc-dbdd82b96979', 'multiverseId': 188450}, 'multiverseid': 188450}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187205&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e33bd45f-9255-40df-96b9-74c7c0cdbbb9', 'multiverseId': 187205}, 'multiverseid': 187205}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188201&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd45e6879-beb2-46a0-8aee-c1f19571837f', 'multiverseId': 188201}, 'multiverseid': 188201}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188948&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '196104b8-5031-4f32-8ff8-6f501b554a73', 'multiverseId': 188948}, 'multiverseid': 188948}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187454&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a9709000-a873-4618-9d03-01531be5c5fb', 'multiverseId': 187454}, 'multiverseid': 187454}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187704&type=card', 'language': 'German', 'identifiers': {'scryfallId': '29211bbe-aed4-4db7-b83f-e0e18f4cdbef', 'multiverseId': 187704}, 'multiverseid': 187704}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187953&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '29235c47-520f-415e-a250-d80ebcd9f119', 'multiverseId': 187953}, 'multiverseid': 187953}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188700&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c20daf60-7b9f-416c-9b3f-929852427ef6', 'multiverseId': 188700}, 'multiverseid': 188700}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188451&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '63342e3e-80d3-45b4-872c-17b0332259f3', 'multiverseId': 188451}, 'multiverseid': 188451}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187206&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '07db9ee9-8497-47bc-839e-bd38976e44a5', 'multiverseId': 187206}, 'multiverseid': 187206}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188202&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '06899172-5453-424a-93e2-d87b93fcb498', 'multiverseId': 188202}, 'multiverseid': 188202}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188949&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd25e493f-dab1-4707-be89-b1056ac03a79', 'multiverseId': 188949}, 'multiverseid': 188949}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187455&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c1aa5ac9-8d5b-4225-84b5-5a2a51a4c0f0', 'multiverseId': 187455}, 'multiverseid': 187455}]", "[{'name': 'Jagender Drache', 'text': 'Fliegend, Eile\\nVerschlingen 2 (Sowie diese Karte ins Spiel kommt, kannst du eine beliebige Anzahl an Kreaturen opfern. Diese Kreatur kommt mit doppelt so vielen +1/+1-Marken ins Spiel.)', 'type': 'Kreatur — Drache', 'flavor': 'Drachen geben gehässige Götter ab.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187576&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a6c82331-fc27-46fb-88c3-6160a8b84f44', 'multiverseId': 187576}, 'multiverseid': 187576}, {'name': 'Dragón depredador', 'text': 'Vuela, prisa.\\nDevorar 2. (En cuanto esto entra en juego puedes sacrificar cualquier cantidad de criaturas. Esta criatura entra en juego con el doble de esa cantidad de contadores +1/+1 sobre ella.)', 'type': 'Criatura — Dragón', 'flavor': 'Los dragones son dioses malévolos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187825&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '133e95a4-5ae2-41ed-8505-5565d1ebe4c4', 'multiverseId': 187825}, 'multiverseid': 187825}, {'name': 'Dragon prédateur', 'text': 'Vol, célérité\\nDévorement 2 (Au moment où cette créature arrive en jeu, vous pouvez sacrifier le nombre de créatures de votre choix. Cette créature arrive en jeu avec deux fois ce nombre de marqueurs +1/+1 sur elle.)', 'type': 'Créature : dragon', 'flavor': 'Les dragons font des dieux malveillants.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188572&type=card', 'language': 'French', 'identifiers': {'scryfallId': '82ce7b49-5e92-4dc9-b0ba-bd988dac8813', 'multiverseId': 188572}, 'multiverseid': 188572}, {'name': 'Drago Predatore', 'text': 'Volare, rapidità\\nDivorare 2 (Mentre questa creatura entra in gioco, puoi sacrificare un qualsiasi numero di creature. Entra in gioco con un numero di segnalini +1/+1 pari al doppio delle creature sacrificate.)', 'type': 'Creatura — Drago', 'flavor': 'I draghi possono essere dei molto dispettosi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188323&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2dd289d1-a989-434d-8cf4-821c0efd0e9d', 'multiverseId': 188323}, 'multiverseid': 188323}, {'name': '捕食者のドラゴン', 'text': '飛行、速攻\\n貪食 ２ （これが場に出るに際し、あなたは望む数のクリーチャーを生け贄に捧げてもよい。 このクリーチャーはその数の２倍に等しい＋１/＋１カウンターが置かれた状態で場に出る。）', 'type': 'クリーチャー — ドラゴン', 'flavor': 'ドラゴンは悪意ある神だ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187078&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9848d6e8-daf5-4e44-8b1e-b482af0644c1', 'multiverseId': 187078}, 'multiverseid': 187078}, {'name': 'Dragão Predador', 'text': 'Voar, ímpeto\\nDevorar 2 (Conforme esta criatura entra em jogo, você pode sacrificar um número qualquer de criaturas. Esta criatura entra em jogo com o dobro daquela quantidade de marcadores +1/+1.)', 'type': 'Criatura — Dragão', 'flavor': 'Os dragões são deuses malignos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188074&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9257704e-5ca3-4311-ba2f-2bb78430609f', 'multiverseId': 188074}, 'multiverseid': 188074}, {'name': 'Хищный Дракон', 'text': 'Полет, Ускорение\\nПожирание 2 (При входе этого существа в игру вы можете пожертвовать любое количество существ. Это существо входит в игру с количеством жетонов +1/+1 на нем, в два раза превышающим их число.)', 'type': 'Существо — Дракон', 'flavor': 'Из драконов получаются злобные боги.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188821&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f926dfd8-215f-432f-92e9-2de2a4a9f56f', 'multiverseId': 188821}, 'multiverseid': 188821}, {'name': '掠食巨龙', 'text': '飞行，敏捷\\n吞噬2 （于它进场时，你可以牺牲任意数量的生物。 此生物进场时上面有该数量两倍的+1/+1指示物。）', 'type': '生物～龙', 'flavor': '为怨念神明而生的巨龙。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187327&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '64054984-0a96-451d-adce-116be7c3fa90', 'multiverseId': 187327}, 'multiverseid': 187327}]", '[{\'name\': \'Jhessischer Beobachtungsposten\', \'type\': \'Kreatur — Mensch, Späher\', \'flavor\': \'Sie ist immer auf der Wacht, da sie weiß, dass ein einzelnes Segel am Horizont das Ende von Wochen des Friedens und der Ruhe bedeuten kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187513&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ad72786-acea-494d-89cc-a2a78d04acce\', \'multiverseId\': 187513}, \'multiverseid\': 187513}, {\'name\': \'Centinela jhessiana\', \'type\': \'Criatura — Explorador humano\', \'flavor\': \'Está lista, siempre atenta, sabiendo que semanas de paz y serenidad pueden desaparecer con una sola vela lejana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187762&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85c0d932-8505-4840-b0c8-83c38ee406b8\', \'multiverseId\': 187762}, \'multiverseid\': 187762}, {\'name\': \'Vigie de Jhess\', \'type\': \'Créature : humain et éclaireur\', \'flavor\': "Elle est toujours prête, toujours alerte, car elle sait que la seule apparition d\'une voile au lointain peut mettre fin à des semaines de paix et de sérénité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188509&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01b63e9e-0cad-4d5a-a5e3-66ba08a5f707\', \'multiverseId\': 188509}, \'multiverseid\': 188509}, {\'name\': \'Vedetta di Jhess\', \'type\': \'Creatura — Esploratore Umano\', \'flavor\': \'Sta pronta, sempre vigile, ben sapendo che intere settimane di pace e serenità possono essere sconvolte da una singola vela in distanza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188260&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'600eaf9b-d351-4f1b-bb4d-a4e35a77cbdb\', \'multiverseId\': 188260}, \'multiverseid\': 188260}, {\'name\': \'ジェスの監視人\', \'type\': \'クリーチャー — 人間・スカウト\', \'flavor\': \'彼女は準備万端で、常に注意深い。長きに渡る平安も、遠くの船一隻で覆ることを知っているから。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187015&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d66ca1da-2fbf-4d59-b4ea-b1b9fd4a96be\', \'multiverseId\': 187015}, \'multiverseid\': 187015}, {\'name\': \'Vigilante Jhessiana\', \'type\': \'Criatura — Humano Batedor\', \'flavor\': \'Ela está sempre de prontidão e com o olhar atento, pois sabe que semanas de paz e serenidade podem acabar drasticamente ao avistar uma única vela distante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188011&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73ec8236-8c67-444b-8170-7fa256bd2eaa\', \'multiverseId\': 188011}, \'multiverseid\': 188011}, {\'name\': \'Джесский Дозорный\', \'type\': \'Существо — Человек Разведчик\', \'flavor\': \'Она стоит наготове, никогда не теряя бдительности, зная, что недели мира и спокойствия могут быть смятены одиноким парусом, показавшимся на горизонте.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188758&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'54bc530a-800d-4f6e-8b80-88088deac23c\', \'multiverseId\': 188758}, \'multiverseid\': 188758}, {\'name\': \'介斯警戒员\', \'type\': \'生物～人类／斥候\', \'flavor\': \'她随时提高警觉、严阵以待，因为远处的孤帆随时都可能打破持续数周的平静祥和。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187264&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'06d4055f-2a6f-4a70-aded-e17754bbd96f\', \'multiverseId\': 187264}, \'multiverseid\': 187264}]', '[{\'name\': \'Jhessischer Infiltrator\', \'text\': \'Der Jhessische Infiltrator ist unblockbar.\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Die jhessische Marine kann immer wieder erfolgreich die Küstenstädte von Valeron überfallen, da sie in Friedenszeiten dort genügend Spione untergebracht hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86436152-3395-4644-a934-2629eb70df99\', \'multiverseId\': 187641}, \'multiverseid\': 187641}, {\'name\': \'Espía jhessiana\', \'text\': \'El Espía jhessiana es imbloqueable.\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'La armada jhessiana logra incursiones exitosas en las ciudades costeras de Valeron gracias a los espías dejados en tiempos de paz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187890&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4483f7d4-0bfe-4d58-b0c3-0de4b425836c\', \'multiverseId\': 187890}, \'multiverseid\': 187890}, {\'name\': \'Infiltratrice de Jhess\', \'text\': "L\'Infiltratrice de Jhess est imblocable.", \'type\': \'Créature : humain et gredin\', \'flavor\': \'La marine jhessienne réussit ses raids contre les villes côtières de Valéron grâce aux espions qui y ont été implantés pendant la paix.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188637&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4517f7ba-5d9f-4ad5-8fa9-30a45901fd85\', \'multiverseId\': 188637}, \'multiverseid\': 188637}, {\'name\': \'Infiltrata di Jhess\', \'text\': "L\'Infiltrata di Jhess non può essere bloccata.", \'type\': \'Creatura — Farabutto Umano\', \'flavor\': \'La flotta di Jhess compie razzie di successo nelle città costiere di Valeron grazie alle sue spie infiltrate in tempo di pace.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188388&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'85127e2d-05e3-49d4-9003-02b57bae32e6\', \'multiverseId\': 188388}, \'multiverseid\': 188388}, {\'name\': \'ジェスの浸透者\', \'text\': \'ジェスの浸透者はブロックされない。\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'ジェスの海軍のヴァレロンの港町への襲撃は、平和時に送り込んだ密偵のおかげで成功を収めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187143&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1ce2bf4b-d943-4195-9043-239fb9d4585c\', \'multiverseId\': 187143}, \'multiverseid\': 187143}, {\'name\': \'Infiltrado Jhessiano\', \'text\': \'Infiltrado Jhessiano não pode ser bloqueado.\', \'type\': \'Criatura — Humano Ladino\', \'flavor\': \'A marinha jhessiana lança ataques bem-sucedidos nas cidades costeiras de Valeron graças aos espiões que implantou durante os tempos de paz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188139&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d752e441-b3b7-4d0e-99b8-f11bf906a2f2\', \'multiverseId\': 188139}, \'multiverseid\': 188139}, {\'name\': \'Джесский Шпион\', \'text\': \'Джесский Шпион не может быть заблокирован.\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'Джесский флот совершает успешные нападения на прибрежные города Валерона благодаря своим шпионам, действующим в мирное время.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188886&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'198e2fac-2ab2-4f7e-8289-88b28b80fa28\', \'multiverseId\': 188886}, \'multiverseid\': 188886}, {\'name\': \'介斯渗透者\', \'text\': \'介斯渗透者不能被阻挡。\', \'type\': \'生物～人类／浪客\', \'flavor\': \'藉由承平时期所安插的探子之助，介斯海军成功袭击了威烈隆的海岸城镇\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187392&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'00d99b02-e88a-4487-9a58-dce4000e66fd\', \'multiverseId\': 187392}, \'multiverseid\': 187392}]', '[{\'name\': \'Kampfmagier aus Bant\', \'text\': \'{G}, {T}: Eine Kreatur deiner Wahl verursacht bis zum Ende des Zuges Trampelschaden.\\n{U}, {T}: Eine Kreatur deiner Wahl erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Ein Nachtangriff ist kein Problem. Wir machen einen Luftangriff über die Grenze zu Akrasa. Besorge mir einfach ein paar Flintsteine, damit ich die Kriegsfackeln entzünden kann."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187472&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc0534af-78b1-4eaf-a3c9-f990c2363fa3\', \'multiverseId\': 187472}, \'multiverseid\': 187472}, {\'name\': \'Maga de guerra bantiana\', \'text\': \'{G}, {T}: La criatura objetivo gana la habilidad de arrollar hasta el final del turno.\\n{U}, {T}: La criatura objetivo gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Un ataque nocturno será fácil. Haremos una incursión aérea sobre la frontera de Akrasa. Consígueme un poco de yesca para encender las antorchas de guerra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187721&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3718005-6137-432c-9141-a7970fd61be0\', \'multiverseId\': 187721}, \'multiverseid\': 187721}, {\'name\': \'Mage de bataille de Bant\', \'text\': "{G}, {T} : La créature ciblée acquiert le piétinement jusqu\'à la fin du tour.\\n{U}, {T} : La créature ciblée acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« Une attaque nocturne sera facile. Nous procèderons à un raid aérien de la frontière akrasane. Donnez-moi du silex pour allumer les torches de guerre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188468&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a704fd17-863e-4bb7-a720-e208dbf22865\', \'multiverseId\': 188468}, \'multiverseid\': 188468}, {\'name\': \'Maga Combattente di Bant\', \'text\': \'{G}, {T}: Una creatura bersaglio ha travolgere fino alla fine del turno.\\n{U}, {T}: Una creatura bersaglio ha volare fino alla fine del turno.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Un attacco notturno sarà molto semplice. Faremo un\\\'incursione aerea sul confine di Akrasa. Trovatemi una pietra focaia per accendere le torce di guerra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188219&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e5c0ff0-7d84-4bcc-9521-0a90e9d683e1\', \'multiverseId\': 188219}, \'multiverseid\': 188219}, {\'name\': \'バントの戦闘魔道士\', \'text\': \'{G}, {T}：クリーチャー１体を対象とする。それはターン終了時までトランプルを得る。\\n{U}, {T}：クリーチャー１体を対象とする。それはターン終了時まで飛行を得る。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「夜襲など簡単なことです。 アクラサの国境を越えて空から仕掛けましょう。 松明を灯すための火打石だけもってきなさい。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186974&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b20c60d-7225-45b6-95eb-8bfccb1a6be4\', \'multiverseId\': 186974}, \'multiverseid\': 186974}, {\'name\': \'Mago de Combate de Bant\', \'text\': \'{G}, {T}: A criatura alvo ganha atropelar até o final do turno.\\n{U}, {T}: A criatura alvo ganha voar até o final do turno.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Um ataque nortuno será fácil. Faremos um ataque aéreo sobre as fronteiras akrasanas. Preciso apenas de uma pederneira para acender as tochas de guerra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187970&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c554f14e-bf5f-4437-9b2d-0d242028714f\', \'multiverseId\': 187970}, \'multiverseid\': 187970}, {\'name\': \'Боевой Маг Бэнта\', \'text\': \'{G}, {T}: целевое существо получает Пробивной удар до конца хода.\\n{U}, {T}: целевое существо получает Полет до конца хода.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Напасть ночью будет несложно. Мы совершим воздушный налет на акрасскую границу. Дайте только кремень, чтобы зажечь факелы войны».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188717&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6c8c79a2-9663-4174-90e2-60dcda05d937\', \'multiverseId\': 188717}, \'multiverseid\': 188717}, {\'name\': \'班特战法术师\', \'text\': \'{G}，{T}：目标生物获得践踏异能直到回合结束。\\n{U}，{T}：目标生物获得飞行异能直到回合结束。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「夜袭很简单。 我们将从阿卡沙边境发动空袭。 只要给我些打火石点燃火把就行。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187223&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70a8e5f3-f9cc-44b3-abf3-4cc0daec61bf\', \'multiverseId\': 187223}, \'multiverseid\': 187223}]', '[{\'name\': \'Kampfmagier aus Grixis\', \'text\': \'{U}, {T}: Ziehe eine Karte und wirf dann eine Karte aus deiner Hand ab.\\n{R}, {T}: Eine Kreatur deiner Wahl kann in diesem Zug nicht blocken.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Die Lebenden in Grixis, die das Untote scheuen, müssen sich bemühen, ihre Sterblichkeit zu behalten. Das Ergebnis ist eine Gattung von erfindungsreichen Magiern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187545&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee644ad2-8ab4-44a7-8a97-da38694ce695\', \'multiverseId\': 187545}, \'multiverseid\': 187545}, {\'name\': \'Mago de guerra grixiano\', \'text\': \'{U}, {T}: Roba una carta, luego descarta una carta.\\n{R}, {T}: La criatura objetivo no puede bloquear este turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Los vitales de Grixis que burlan la muerte viviente deben rebuscárselas para retener su mortalidad. El resultado es una raza de magos muy ocurrentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187794&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'186544ef-93fe-490c-8f60-5a0ec5865d12\', \'multiverseId\': 187794}, \'multiverseid\': 187794}, {\'name\': \'Mage de bataille de Grixis\', \'text\': "{U}, {T} : Piochez une carte, puis défaussez-vous d\'une carte.\\n{R}, {T} : La créature ciblée ne peut pas bloquer ce tour-ci.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "Les vitaux de Grixis qui s\'abstiennent de toucher à la morte-vie doivent lutter pour garder leur mortalité. Il en résulte une race de mages inventifs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188541&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32626114-218f-4c9d-9498-6c995410390d\', \'multiverseId\': 188541}, \'multiverseid\': 188541}, {\'name\': \'Mago Combattente di Grixis\', \'text\': \'{U}, {T}: Pesca una carta, poi scarta una carta.\\n{R}, {T}: Una creatura bersaglio non può bloccare in questo turno.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'Le parti vitali di Grixis che evitano la non morte devono raschiare e raspare per conservare la loro mortalità. Il risultato è una razza di maghi creativi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188292&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c08306e3-9abd-4dd6-a22d-87f1c74429ef\', \'multiverseId\': 188292}, \'multiverseid\': 188292}, {\'name\': \'グリクシスの戦闘魔道士\', \'text\': \'{U}, {T}：カードを１枚引き、その後カードを１枚捨てる。\\n{R}, {T}：クリーチャー１体を対象とする。このターン、それではブロックできない。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'グリクシスに生きるものが不死者となることを避けるには、自らの生命にしがみつく必要がある。 その結果、才ある魔道士が生き残ることとなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187047&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f52776ff-91a1-4dd4-92b1-bf019de42094\', \'multiverseId\': 187047}, \'multiverseid\': 187047}, {\'name\': \'Mago de Combate de Grixis\', \'text\': \'{U}, {T}: Compre um card e depois descarte um card.\\n{R}, {T}: A criatura alvo não pode bloquear neste turno.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'Os vitais de Grixis que fogem dos mortos-vivos precisam tentar de tudo para reter sua vitalidade. O resultado é uma raça de magos inventivos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188043&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'10617767-158f-4038-be26-86afc3333939\', \'multiverseId\': 188043}, \'multiverseid\': 188043}, {\'name\': \'Боевой Маг Гриксиса\', \'text\': \'{U}, {T}: возьмите карту, затем сбросьте карту.\\n{R}, {T}: целевое существо не может блокировать в этом ходу.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Живые существа Гриксиса, избегающие нежизни, должны прилагать неимоверные усилия, чтобы сохранить свою смертность. Так появилось целое поколение изобретательных магов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188790&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'13b29a3d-7f96-4672-945e-8f6f266be435\', \'multiverseId\': 188790}, \'multiverseid\': 188790}, {\'name\': \'格利极战法术师\', \'text\': \'{U}，{T}：抓一张牌，然后弃一张牌。\\n{R}，{T}：目标生物本回合不能进行阻挡。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'格利极讨厌不死生物的生灵，得费尽力气才能维持自己的生命现况。 因此诞生了一群充满创意的法师。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187296&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2c918655-fe23-451e-83af-43a3aff987c2\', \'multiverseId\': 187296}, \'multiverseid\': 187296}]', '[{\'name\': \'Kampfmagier aus Jund\', \'text\': \'{B}, {T}: Ein Spieler deiner Wahl verliert 1 Lebenspunkt.\\n{G}, {T}: Bringe einen 1/1 grünen Saproling-Kreaturenspielstein ins Spiel.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': \'„Aus deinem Blut mache ich Met, den ich dem durstigen Dschungel opfere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187573&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f98df29e-cd10-49ba-b263-cee66bec80a5\', \'multiverseId\': 187573}, \'multiverseid\': 187573}, {\'name\': \'Mago de guerra jundiano\', \'text\': \'{B}, {T}: El jugador objetivo pierde 1 vida.\\n{G}, {T}: Pon en juego una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': \'"Con tu sangre haré una bebida, una ofrenda para la selva sedienta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187822&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6666f0d0-372c-46e5-b41e-c92b35a58f81\', \'multiverseId\': 187822}, \'multiverseid\': 187822}, {\'name\': \'Mage de bataille de Jund\', \'text\': \'{B}, {T} : Le joueur ciblé perd 1 point de vie.\\n{G}, {T} : Mettez en jeu un jeton de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : humain et shamane\', \'flavor\': \'« Je ferai fermenter votre sang pour en faire ma cervoise, une offrande à la jungle assoiffée. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188569&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'982049f2-d3e1-4e89-82cd-e9df5a336bd9\', \'multiverseId\': 188569}, \'multiverseid\': 188569}, {\'name\': \'Mago Combattente di Jund\', \'text\': \'{B}, {T}: Un giocatore bersaglio perde 1 punto vita.\\n{G}, {T}: Metti in gioco una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Creatura — Sciamano Umano\', \'flavor\': \'"Del tuo sangue ne farò il mio idromele, un\\\'offerta alla giungla assetata."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188320&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bb910d37-854b-40fe-84dd-a7913347d77f\', \'multiverseId\': 188320}, \'multiverseid\': 188320}, {\'name\': \'ジャンドの戦闘魔道士\', \'text\': \'{B}, {T}：プレイヤー１人を対象とする。そのプレイヤーは１点のライフを失う。\\n{G}, {T}：緑の１/１の苗木・クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': \'「お前の血で酒を醸し、乾いたジャングルに捧げることとしよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187075&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8bae2a6f-009b-4aad-8c5e-f6cfe5845f74\', \'multiverseId\': 187075}, \'multiverseid\': 187075}, {\'name\': \'Mago de Combate de Jund\', \'text\': \'{B}, {T}: O jogador alvo perde 1 ponto de vida.\\n{G}, {T}: Coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': \'"De seu sangue farei meu hidromel, uma oferenda à selva sedenta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188071&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e2a1948e-09d9-47e1-a429-06841ab0a1c8\', \'multiverseId\': 188071}, \'multiverseid\': 188071}, {\'name\': \'Боевой Маг Джанда\', \'text\': \'{B}, {T}: целевой игрок теряет 1 жизнь.\\n{G}, {T}: положите в игру одну фишку существа 1/1 зеленый Сапролинг.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': \'«Из крови твоей я приготовлю медовое вино мое подношение томимым жаждой джунглям».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188818&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'214d925b-1ee8-4786-9439-fc938848c9f4\', \'multiverseId\': 188818}, \'multiverseid\': 188818}, {\'name\': \'勇得战法术师\', \'text\': \'{B}，{T}：目标牌手失去1点生命。\\n{G}，{T}：将一个1/1绿色的腐生物衍生物放置进场。\', \'type\': \'生物～人类／祭师\', \'flavor\': \'「你的鲜血将成为我奉献给饥渴丛林的甜酒。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187324&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f43546f7-19bd-4f8c-8664-fa8d727a7915\', \'multiverseId\': 187324}, \'multiverseid\': 187324}]', '[{\'name\': \'Kampfmagier aus Naya\', \'text\': \'{R}, {T}: Eine Kreatur deiner Wahl erhält +2/+0 bis zum Ende des Zuges.\\n{W}, {T}: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': \'„Ich habe in allen drei Schulen der Magie gelernt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29e64b2a-ef28-4644-883c-d817213833bf\', \'multiverseId\': 187609}, \'multiverseid\': 187609}, {\'name\': \'Maga de guerra nayana\', \'text\': \'{R}, {T}: La criatura objetivo obtiene +2/+0 hasta el final del turno.\\n{W}, {T}: Gira la criatura objetivo.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': \'"Estudié en las tres escuelas de magia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187858&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7cdd968-daea-484f-a73f-462f4877e86f\', \'multiverseId\': 187858}, \'multiverseid\': 187858}, {\'name\': \'Mage de bataille de Naya\', \'text\': "{R}, {T} : La créature ciblée gagne +2/+0 jusqu\'à la fin du tour.{W}, {T} : Engagez la créature ciblée.", \'type\': \'Créature : humain et shamane\', \'flavor\': "« J\'ai suivi une formation dans les trois écoles de magie. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188605&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1f4a68b-7582-408e-8d1e-625aeb5645be\', \'multiverseId\': 188605}, \'multiverseid\': 188605}, {\'name\': \'Maga Combattente di Naya\', \'text\': \'{R}, {T}: Una creatura bersaglio prende +2/+0 fino alla fine del turno.\\n{W}, {T}: TAPpa una creatura bersaglio.\', \'type\': \'Creatura — Sciamano Umano\', \'flavor\': \'"Mi sono addestrata in tutte e tre le scuole di magia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188356&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c856230-69f1-4b48-aac3-7ec3dfd822c2\', \'multiverseId\': 188356}, \'multiverseid\': 188356}, {\'name\': \'ナヤの戦闘魔道士\', \'text\': \'{R}, {T}：クリーチャー１体を対象とする。それはターン終了時まで＋２/＋０の修整を受ける。\\n{W}, {T}：クリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': \'「三つの魔法の流儀を全部学んできたんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187111&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f06042f3-64bb-450b-a8b1-a10b3ab3ed25\', \'multiverseId\': 187111}, \'multiverseid\': 187111}, {\'name\': \'Mago de Combate de Naya\', \'text\': \'{R}, {T}: A criatura alvo recebe +2/+0 até o final do turno.\\n{W}, {T}: Vire a criatura alvo.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': \'"Eu fui treinada em todas as três escolas de magia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188107&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2370da84-cf89-4d4d-9e45-3002bcbce803\', \'multiverseId\': 188107}, \'multiverseid\': 188107}, {\'name\': \'Боевой Маг Найи\', \'text\': \'{R}, {T}: целевое существо получает +2/+0 до конца хода.\\n{W}, {T}: поверните целевое существо.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': \'«Меня подготовили во всех трех школах магии».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188854&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8861179d-ef50-4c04-b2d6-73f88bdc03b1\', \'multiverseId\': 188854}, \'multiverseid\': 188854}, {\'name\': \'纳雅战法术师\', \'text\': \'{R}，{T}：目标生物得+2/+0直到回合结束。\\n{W}，{T}：横置目标生物。\', \'type\': \'生物～人类／祭师\', \'flavor\': \'「世上这三派法术我全都精通。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187360&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df3bae3d-cac8-4c27-a6ae-978dac123c46\', \'multiverseId\': 187360}, \'multiverseid\': 187360}]', '[{\'name\': \'Kampfmagierin aus Esper\', \'text\': \'{W}, {T}: Verhindere die nächsten 2 Schadenspunkte, die dir in diesem Zug zugefügt würden.\\n{B}, {T}: Eine Kreatur deiner Wahl erhält -1/-1 bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Mensch, Zauberer\', \'flavor\': \'Sie kann Körper heilen oder deren viele Schwächen ausnutzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187507&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3449478b-f350-493e-abe7-0bef2a285d7e\', \'multiverseId\': 187507}, \'multiverseid\': 187507}, {\'name\': \'Maga de guerra esperiana\', \'text\': \'{W}, {T}: Prevén los siguientes 2 puntos de daño que se te fueran a hacer este turno.\\n{B}, {T}: La criatura objetivo obtiene -1/-1 hasta el final del turno.\', \'type\': \'Criatura artefacto — Hechicero humano\', \'flavor\': \'Ella puede curar la carne, o aprovecharse de sus debilidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187756&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f25fcce-e073-4496-9e7c-f913e1b9ee4f\', \'multiverseId\': 187756}, \'multiverseid\': 187756}, {\'name\': "Mage de bataille d\'Esper", \'text\': "{W}, {T} : Prévenez, ce tour-ci, les prochaines 2 blessures qui devraient vous être infligées.\\n{B}, {T} : La créature ciblée gagne -1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : humain et sorcier\', \'flavor\': \'Elle peut guérir la chair ou exploiter ses nombreuses faiblesses.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188503&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbc09bfb-71af-42bc-9bd0-f15bb20e9bb5\', \'multiverseId\': 188503}, \'multiverseid\': 188503}, {\'name\': \'Maga Combattente di Esper\', \'text\': \'{W}, {T}: Previeni i prossimi 2 danni che ti verrebbero inflitti in questo turno.\\n{B}, {T}: Una creatura bersaglio prende -1/-1 fino alla fine del turno.\', \'type\': \'Creatura Artefatto — Mago Umano\', \'flavor\': \'Può guarire la carne o sfruttarne le molteplici debolezze.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188254&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b3433cd9-1fb9-4dbe-903c-b106759cb416\', \'multiverseId\': 188254}, \'multiverseid\': 188254}, {\'name\': \'エスパーの戦闘魔道士\', \'text\': \'{W}, {T}：このターン、次にあなたに与えられるダメージを２点軽減する。\\n{B}, {T}：クリーチャー１体を対象とする。それはターン終了時まで－１/－１の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — 人間・ウィザード\', \'flavor\': \'彼女は肉体を癒し、あるいはその弱みを突くことができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187009&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'55cfdd5b-249a-405a-8ee7-6ab6100a582d\', \'multiverseId\': 187009}, \'multiverseid\': 187009}, {\'name\': \'Mago de Combate de Esper\', \'text\': \'{W}, {T}: Previna os próximos 2 pontos de dano que seriam causados a você neste turno.\\n{B}, {T}: A criatura alvo recebe -1/-1 até o final do turno.\', \'type\': \'Criatura Artefato — Humano Mago\', \'flavor\': \'Ela pode curar a carne, ou explorar suas inúmeras fraquezas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188005&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84c45f77-9064-4770-88d8-9d0767938172\', \'multiverseId\': 188005}, \'multiverseid\': 188005}, {\'name\': \'Боевой Маг Эспера\', \'text\': \'{W}, {T}: предотвратите следующие 2 повреждения, которые должны быть нанесены вам в этом ходу.\\n{B}, {T}: целевое существо получает -1/-1 до конца хода.\', \'type\': \'Артефактное Существо — Человек Чародей\', \'flavor\': \'Она может излечить плоть или воспользоваться ее многочисленными слабостями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188752&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f172772b-99b7-4c43-925c-c621e4226b27\', \'multiverseId\': 188752}, \'multiverseid\': 188752}, {\'name\': \'艾斯波战法术师\', \'text\': \'{W}，{T}：于本回合中，防止接下来将对你造成的2点伤害。\\n{B}，{T}：目标生物得-1/-1直到回合结束。\', \'type\': \'神器生物～人类／法术师\', \'flavor\': \'她能医治肉身，也能利用其诸多弱点。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187258&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52b71d9e-65d9-4f4a-8dae-dea3e2112a5d\', \'multiverseId\': 187258}, \'multiverseid\': 187258}]', '[{\'name\': \'Kapsel des Henkers\', \'text\': \'{1}{B}, {T}, opfere die Kapsel des Henkers: Zerstöre eine nichtschwarze Kreatur deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'Es gibt immer einen kleinen Moment der Beklemmung, bevor die Kapsel mit der Nachricht geöffnet wird, da niemand das Urteil vorher kennt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187542&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be63a3c5-9f2a-459e-ab9b-ed51c1c8eb20\', \'multiverseId\': 187542}, \'multiverseid\': 187542}, {\'name\': \'Cápsula del verdugo\', \'text\': \'{1}{B}, {T}, sacrificar la Cápsula del verdugo: Destruye la criatura objetivo que no sea negra.\', \'type\': \'Artefacto\', \'flavor\': \'Siempre hay un momento de duda antes de abrir una cápsula mensajera, por miedo al juicio que podría contener.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187791&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a82d731-d3fd-4df4-bcc9-2d8cb4ad79fa\', \'multiverseId\': 187791}, \'multiverseid\': 187791}, {\'name\': "Capsule de l\'exécuteur", \'text\': "{1}{B}, {T}, sacrifiez la Capsule de l\'exécuteur : Détruisez la créature non-noire ciblée.", \'type\': \'Artefact\', \'flavor\': "L\'ouverture d\'une capsule est toujours précédée d\'un instant de trépidation, de crainte du jugement qu\'elle pourrait contenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188538&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'897bec6a-e659-4c92-9470-77087261f57b\', \'multiverseId\': 188538}, \'multiverseid\': 188538}, {\'name\': \'Capsula del Carnefice\', \'text\': \'{1}{B}, {T}, Sacrifica la Capsula del Carnefice: Distruggi una creatura non nera bersaglio.\', \'type\': \'Artefatto\', \'flavor\': "C\'è sempre un momento di trepidazione prima di aprire una capsula di messaggi, per timore del giudizio che potrebbe esservi all\'interno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188289&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'112d0173-e9cd-4ccb-ae77-0bbca069a611\', \'multiverseId\': 188289}, \'multiverseid\': 188289}, {\'name\': \'処刑人の薬包\', \'text\': \'{1}{B}, {T}, 処刑人の薬包を生け贄に捧げる：黒でないクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'書簡を開封する前には、いつも恐ろしい瞬間がある。その中にあるかもしれない決定に対する恐怖だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187044&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'88b72715-4132-42e8-8032-a7513089c9a6\', \'multiverseId\': 187044}, \'multiverseid\': 187044}, {\'name\': \'Cápsula do Executor\', \'text\': \'{1}{B}, {T}, Sacrifique Cápsula do Executor: Destrua a criatura alvo que não seja preta.\', \'type\': \'Artefato\', \'flavor\': \'Sempre há um momento de apreensão antes de abrir uma cápsula de mensagem, pelo medo do julgamento que pode estar contido nela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188040&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68213ee5-8b94-4a16-a315-f34f503338f7\', \'multiverseId\': 188040}, \'multiverseid\': 188040}, {\'name\': \'Капсула Палача\', \'text\': \'{1}{B}, {T}, пожертвуйте Капсулу Палача: уничтожьте целевое нечерное существо.\', \'type\': \'Артефакт\', \'flavor\': \'Перед открытием капсулы с посланием, адресата всегда охватывает тревога из страха перед приговором, который может находиться внутри.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188787&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'49a96315-17dd-4039-977b-a3b88cbcf4c1\', \'multiverseId\': 188787}, \'multiverseid\': 188787}, {\'name\': \'刽子手坠盒\', \'text\': \'{1}{B}，{T}，牺牲刽子手坠盒：消灭目标非黑色生物。\', \'type\': \'神器\', \'flavor\': \'打开这坠盒之前总会不自主地颤抖，深怕其中可能承载的裁决。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187293&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2b7f63d2-9d30-4cb5-aeec-53ff6e6dcb3b\', \'multiverseId\': 187293}, \'multiverseid\': 187293}]', '[{\'name\': \'Kapsel des Kuriers\', \'text\': \'{1}{U}, {T}, opfere die Kapsel des Kuriers: Ziehe zwei Karten.\', \'type\': \'Artefakt\', \'flavor\': \'In vergangenen Zeiten überbrachten Kuriere in Esper verzierte Schriftrollen. Das Medium hat sich verändert, das Prinzip ist gleich geblieben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187504&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'283ae544-b291-44bd-aa50-3daf200fe2e2\', \'multiverseId\': 187504}, \'multiverseid\': 187504}, {\'name\': \'Cápsula del mensajero\', \'text\': \'{1}{U}, {T}, sacrificar la Cápsula del mensajero: Roba dos cartas.\', \'type\': \'Artefacto\', \'flavor\': \'En eras pasadas, los mensajeros de Esper llevaban mensajes escritos en pergaminos adornados. El medio es ahora mucho más sofisticado, pero el principio es el mismo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187753&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7dca0ff3-03bd-4463-9db6-d5b41a5be53c\', \'multiverseId\': 187753}, \'multiverseid\': 187753}, {\'name\': \'Capsule du messager\', \'text\': \'{1}{U}, {T}, sacrifiez la Capsule du messager : Piochez deux cartes.\', \'type\': \'Artefact\', \'flavor\': "Jadis, les messagers d\'Esper transportaient des messages écrits sur des parchemins ornés. L\'objet est devenu plus sophistiqué, mais le principe reste le même.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188500&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e826d048-9f93-48c0-9a8e-6c5aced20d14\', \'multiverseId\': 188500}, \'multiverseid\': 188500}, {\'name\': \'Capsula del Corriere\', \'text\': \'{1}{U}, {T}, Sacrifica la Capsula del Corriere: Pesca due carte.\', \'type\': \'Artefatto\', \'flavor\': \'In passato, i corrieri di Esper recavano messaggi scritti su pergamene decorate. Lo strumento è diventato più sofisticato, ma il principio è rimasto lo stesso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188251&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1695b247-5ce7-4bfa-a619-ca83bbe9fc37\', \'multiverseId\': 188251}, \'multiverseid\': 188251}, {\'name\': \'急使の薬包\', \'text\': \'{1}{U}, {T}, 急使の薬包を生け贄に捧げる：カードを２枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'過去何世代もの間、エスパーの急使は飾り立てられた巻物に書かれた書簡を運んでいた。 その後、手段はより洗練されていったが、書かれる内容は変わりがない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187006&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19fbf99a-e566-45a5-8012-5ea01d572528\', \'multiverseId\': 187006}, \'multiverseid\': 187006}, {\'name\': \'Cápsula do Mensageiro\', \'text\': \'{1}{U}, {T}, Sacrifique Cápsula do Mensageiro: Compre dois cards.\', \'type\': \'Artefato\', \'flavor\': \'Nas eras passadas, os mensageiros de Esper levavam mensagens escritas em pergaminhos decorados. O meio tornou-se mais sofisticado, mas os princípios permanecem os mesmos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188002&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dd8d6967-e9b5-488a-a392-6ce26408d2fe\', \'multiverseId\': 188002}, \'multiverseid\': 188002}, {\'name\': \'Капсула Гонца\', \'text\': \'{1}{U}, {T}, пожертвуйте Капсулу Гонца: возьмите две карты.\', \'type\': \'Артефакт\', \'flavor\': \'В стародавние времена эсперские гонцы переносили послания, написанные на богато украшенных свитках. Теперь средство стало более сложным, но принцип остался прежним.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188749&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cd2c6a10-4c8f-450f-97e7-7db94141a9f8\', \'multiverseId\': 188749}, \'multiverseid\': 188749}, {\'name\': \'讯使坠盒\', \'text\': \'{1}{U}，{T}，牺牲讯使坠盒：抓两张牌。\', \'type\': \'神器\', \'flavor\': \'在很久以前，艾斯波讯使身上携带的是写在华美卷轴上的讯息。 承载讯息的东西已更加精致，但原理依旧相同。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187255&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f308b819-58ae-4bc2-b269-83e0085b0c9a\', \'multiverseId\': 187255}, \'multiverseid\': 187255}]', '[{\'name\': \'Kapsel des Verbanners\', \'text\': \'{2}{W}, {T}, opfere die Kapsel des Verbanners: Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'„Ich finde ihre Symmetrie sympathisch. Die Kapsel befreit unsere Welt von widerwärtigem Unrat und entsorgt sich dabei selbst." —Dolomarus, Proktor der Reinen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187475&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14de6551-e6e7-479b-9f80-e54748176961\', \'multiverseId\': 187475}, \'multiverseid\': 187475}, {\'name\': \'Cápsula del disipador\', \'text\': \'{2}{W}, {T}, sacrificar la Cápsula del disipador: Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'"Su simetría es placentera. Elimina desechos de nuestro mundo al mismo tiempo que se destruye." —Dolomarus, supervisor de los Puros\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187724&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84973e92-14b6-4480-9e3a-bf4724253da5\', \'multiverseId\': 187724}, \'multiverseid\': 187724}, {\'name\': \'Capsule du dissipateur\', \'text\': "{2}{W}, {T}, sacrifiez la Capsule du dissipateur : Détruisez l\'artefact ou l\'enchantement ciblé.", \'type\': \'Artefact\', \'flavor\': "« Je trouve sa symétrie agréable. Elle élimine les impuretés choquantes de notre monde tout en se débarrassant d\'elle-même. » —Dolomarus, questeur de la Pureté", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188471&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc4db173-f8b5-4228-83e2-9abac4679c8f\', \'multiverseId\': 188471}, \'multiverseid\': 188471}, {\'name\': \'Capsula del Dissipatore\', \'text\': \'{2}{W}, {T}, Sacrifica la Capsula del Dissipatore: Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Artefatto\', \'flavor\': \'"Trovo che la sua simmetria sia piacevole. Elimina rifiuti ripugnanti dal nostro mondo mentre smaltisce se stesso." —Dolomarus, Censore della Pulizia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188222&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f83e91d5-ffb9-455f-b3f3-29af12597965\', \'multiverseId\': 188222}, \'multiverseid\': 188222}, {\'name\': \'祓い士の薬包\', \'text\': \'{2}{W}, {T}, 祓い士の薬包を生け贄に捧げる：アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'「この調和は好ましいな。 自身を失いながら、この世界の有害な廃棄物を消し去るのだから。」 ――清浄の代理人、ドロマールス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186977&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'306c1023-7817-4239-baf2-9c80be89de56\', \'multiverseId\': 186977}, \'multiverseid\': 186977}, {\'name\': \'Cápsula do Dispersor\', \'text\': \'{2}{W}, {T}, Sacrifique Cápsula do Dispersor: Destrua o artefato ou encantamento alvo.\', \'type\': \'Artefato\', \'flavor\': \'"Eu acho sua simetria muito agradável. Ela retira do mundo a imundície ofensiva enquanto se dispersa." — Dolomarus, Inspetor da Limpeza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187973&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'968157ac-757c-4778-8cca-d80945c0f5fd\', \'multiverseId\': 187973}, \'multiverseid\': 187973}, {\'name\': \'Капсула Рассеивателя\', \'text\': \'{2}{W}, {T}, пожертвуйте Капсулу Рассеивателя: уничтожьте целевой артефакт или чары.\', \'type\': \'Артефакт\', \'flavor\': \'«Меня радует симметрия ее действия. Она освобождает наш мир от отвратительных нечистот и при этом самоуничтожается». — Доломарус, Проктор Очищенных\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188720&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a7b47871-29a5-4940-a51c-a8100dd59242\', \'multiverseId\': 188720}, \'multiverseid\': 188720}, {\'name\': \'驱散者坠盒\', \'text\': \'{2}{W}，{T}，牺牲驱散者坠盒：消灭目标神器或结界。\', \'type\': \'神器\', \'flavor\': \'「这对称性相当有趣： 它把带有攻击性又不该存于世上的东西与它本身一同处理掉。」 ～理净师多洛马勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187226&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'07f1ea34-fc2d-4baa-883b-67e58ddbbccc\', \'multiverseId\': 187226}, \'multiverseid\': 187226}]', '[{\'name\': \'Katharischer Kreischer\', \'text\': \'Fliegend\\nExhumieren {2}{U} ({2}{U}: Bringe diese Karte aus deinem Friedhof ins Spiel zurück. Sie hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Kreatur — Vogel, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187514&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5333d4cb-1e33-4cb9-a295-6ec90577128d\', \'multiverseId\': 187514}, \'multiverseid\': 187514}, {\'name\': \'Chirriante kathari\', \'text\': \'Vuela.\\nDesenterrar {2}{U}. ({2}{U}: Regresa esta carta de tu cementerio al juego. Gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura — Soldado ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187763&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f329398-0473-4ee2-bae0-da98cd6562c8\', \'multiverseId\': 187763}, \'multiverseid\': 187763}, {\'name\': \'Kathari grinçant\', \'text\': "Vol\\nExhumation {2}{U} ({2}{U} : Renvoyez en jeu cette carte depuis votre cimetière. Elle acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature : oiseau et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188510&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8798cd1c-2151-499d-8791-bcd42d21f904\', \'multiverseId\': 188510}, \'multiverseid\': 188510}, {\'name\': \'Urlatore Kathari\', \'text\': \'Volare\\nDissotterrare {2}{U} ({2}{U}: Rimetti in gioco questa carta dal tuo cimitero. Ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)\', \'type\': \'Creatura — Uccello Soldato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188261&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2a15e1b8-955e-40f8-89e7-0b0cc0f8293f\', \'multiverseId\': 188261}, \'multiverseid\': 188261}, {\'name\': \'カターリの金切り声上げ\', \'text\': \'飛行\\n蘇生 {2}{U} ({2}{U}：このカードをあなたの墓地から場に戻す。 それは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — 鳥・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7db24767-0149-49d6-aede-165da1431bc8\', \'multiverseId\': 187016}, \'multiverseid\': 187016}, {\'name\': \'Guinchador Kathari\', \'text\': \'Voar\\nDesenterrar {2}{U} ({2}{U}: Devolva este card de seu cemitério para o jogo. Ele ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura — Ave Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188012&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'df2a6364-ea7c-488e-bd17-7d6a02186fa9\', \'multiverseId\': 188012}, \'multiverseid\': 188012}, {\'name\': \'Крикун Катари\', \'text\': \'Полет\\nОткопать {2}{U} ({2}{U}: верните эту карту из вашего кладбища в игру. Она получает Ускорение. Удалите ее из игры в конце хода, или если она должна покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Существо — Птица Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188759&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'19a3de4d-f85f-49c2-a6b9-ebfe3ce99383\', \'multiverseId\': 188759}, \'multiverseid\': 188759}, {\'name\': \'尖鸣卡刹立\', \'text\': \'飞行\\n破坟{2}{U} （{2}{U}：将此牌从你的坟墓场移回场上。 它获得敏捷。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'生物～鸟／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187265&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0967103e-007d-4e3d-bd3a-3935a6b6b834\', \'multiverseId\': 187265}, \'multiverseid\': 187265}]', '[{\'name\': \'Knochenspreißel\', \'text\': \'Opfere eine Kreatur als zusätzliche Kosten, um Knochenspreißel zu spielen.\\nZerstöre eine Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Die Hexen des Spaltaugenzirkels sprechen von einer Zukunft, in der Grixis von Lebensenergie überspült wird. Bis dahin müssen sie die Lebenskraft von Kreaturen sammeln, um ihre dunkle Magie damit zu schüren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187534&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a003daa8-1478-45b4-a8ab-c437a3b26b16\', \'multiverseId\': 187534}, \'multiverseid\': 187534}, {\'name\': \'Astillas óseas\', \'text\': \'Como coste adicional para jugar las Astillas óseas, sacrifica una criatura.\\nDestruye la criatura objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'Las brujas del Ojo Partido hablan de un futuro en el que Grixis abundará con energía vital. Por ahora, recolectan vis de los vivos para alimentar su magia oscura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187783&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6109af3d-dc48-4f63-85fc-b752ec4a0dbb\', \'multiverseId\': 187783}, \'multiverseid\': 187783}, {\'name\': "Fragments d\'os", \'text\': "En tant que coût supplémentaire pour jouer les Fragments d\'os, sacrifiez une créature.\\nDétruisez la créature ciblée.", \'type\': \'Rituel\', \'flavor\': "Les sorcières du Couvent de l\'Œil-scindé parlent d\'un avenir où Grixis bouillonnera d\'énergie vitale. Pour l\'instant, elles doivent récolter la vithe des vivants pour alimenter leur magie noire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188530&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1efad8ed-6f14-4a57-af88-a7f0c2e6949c\', \'multiverseId\': 188530}, \'multiverseid\': 188530}, {\'name\': "Schegge d\'Osso", \'text\': "Come costo addizionale per giocare le Schegge d\'Osso, sacrifica una creatura.\\nDistruggi una creatura bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'Le streghe della Congrega Occhio Fesso parlano di un futuro in cui Grixis traboccherà di energia vitale. Per ora, devono raccogliere vis tra i viventi per alimentare le loro oscure magie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188281&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aee23b76-ed48-40ba-b0b8-9f36712b7355\', \'multiverseId\': 188281}, \'multiverseid\': 188281}, {\'name\': \'骨の粉砕\', \'text\': \'骨の粉砕をプレイするための追加コストとして、クリーチャーを１体生け贄に捧げる。\\nクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'裂け眼の集いの魔女は、グリクシスにいつ生命が満ちるのか、その未来について語っている。 今のところは、彼女らも闇の魔法を成すための力を生あるものから刈り取っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187036&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'38bae163-133a-40b4-9942-41ceddc59971\', \'multiverseId\': 187036}, \'multiverseid\': 187036}, {\'name\': \'Estacas Ósseas\', \'text\': \'Como custo adicional para jogar Estacas Ósseas, sacrifique uma criatura.\\nDestrua a criatura alvo.\', \'type\': \'Feitiço\', \'flavor\': \'A bruxas do Conventículo do Olho Partido falam de um futuro em que Grixis transbordará de energia vital. Por enquanto, elas precisam coletar o vis dos seres vivos como combustível para suas magias negras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188032&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4afd3b8d-4901-4dfe-b076-e181530fe919\', \'multiverseId\': 188032}, \'multiverseid\': 188032}, {\'name\': \'Костные Осколки\', \'text\': \'В качестве дополнительной стоимости разыгрывания Костных Осколков пожертвуйте существо.\\nУничтожьте целевое существо.\', \'type\': \'Волшебство\', \'flavor\': \'Ведьмы из клана Кошачего Глаза говорят о будущем, когда Гриксис переполнится жизненной энергией. Но пока они вынуждены отнимать силу жизни у всего живого, чтобы подпитывать свою темную магию.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188779&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d7946c8c-68e9-494d-9c6a-347d9f7a6eda\', \'multiverseId\': 188779}, \'multiverseid\': 188779}, {\'name\': \'碎骨贯身\', \'text\': \'牺牲一个生物，以作为使用碎骨贯身的额外费用。\\n消灭目标生物。\', \'type\': \'法术\', \'flavor\': \'在共眼集法术师谈述的未来中，格利极将会充满生命能量。 而目前来说，他们得从活物采收生命来当作黑暗法术的能量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187285&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e4ae50da-b3cd-4dec-8a73-a972bb9ee93e\', \'multiverseId\': 187285}, \'multiverseid\': 187285}]', '[{\'name\': \'Koma-Schleier\', \'text\': \'Artefakt-oder-Kreatur-Verzauberung\\nDie verzauberte bleibende Karte enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Ätherium schläft nicht. Nur Magie kann ihm den ruhenden Zustand von kaltem Stahl beibringen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187503&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83ce430c-63b2-4ef7-ac5d-fe829ad4fa1b\', \'multiverseId\': 187503}, \'multiverseid\': 187503}, {\'name\': \'Velo de coma\', \'text\': \'Encantar criatura o artefacto.\\nEl permanente encantado no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El eterium no duerme. Sólo la magia puede enseñarle el descanso del frío acero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187752&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'233f6d12-5fd7-43e9-a9f1-bf809b20ba5e\', \'multiverseId\': 187752}, \'multiverseid\': 187752}, {\'name\': \'Voile de coma\', \'text\': "Enchanter : artefact ou créature\\nLe permanent enchanté ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': "L\'étherium ne sommeille jamais. Seule la magie peut lui apprendre l\'état de repos de l\'acier trempé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188499&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee0e08c9-34c4-4fde-b5c8-379f984e6ea4\', \'multiverseId\': 188499}, \'multiverseid\': 188499}, {\'name\': \'Apparenza Comatosa\', \'text\': \'Incanta artefatto o creatura\\nIl permanente incantato non STAPpa durante lo STAP del suo controllore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "L\'eterium non conosce il riposo. Solo la magia può insegnargli lo stato inerte del freddo acciaio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188250&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f04fb89-17cb-4ef5-9a8e-8e2b6626178f\', \'multiverseId\': 188250}, \'multiverseid\': 188250}, {\'name\': \'昏睡のヴェール\', \'text\': \'エンチャント（アーティファクトかクリーチャー）\\nエンチャントされているパーマネントは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'エーテリウムは休むことを知らない。 それを冷たい鋼へと休ませることができるのは魔法だけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187005&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6e12163-3da9-4567-a105-0690994dcba9\', \'multiverseId\': 187005}, \'multiverseid\': 187005}, {\'name\': \'Véu do Coma\', \'text\': \'Encantar artefato ou criatura\\nA permanente encantada não desvira durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'O etherium não repousa. Somente através da mágica ele pode conhecer o estado repousante do aço frio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188001&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48cc0e9d-9714-4976-ade4-7012beae0d58\', \'multiverseId\': 188001}, \'multiverseid\': 188001}, {\'name\': \'Покров Комы\', \'text\': \'Зачаровать артефакт или существо\\nЗачарованный перманент не разворачивается во время шага разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': \'Эфирий не знает, что такое сон. Только магия может научить его состоянию покоя, напоминающему холодную сталь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188748&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'07b2245e-ab84-476f-8681-a4bd125304e9\', \'multiverseId\': 188748}, \'multiverseid\': 188748}, {\'name\': \'昏迷帘幕\', \'text\': \'神器结界或生物结界\\n受此结界的永久物于其操控者的重置步骤中不能重置。\', \'type\': \'结界～灵气\', \'flavor\': \'乙金不需要睡眠。 只有法术才能教会它何谓金属的休眠状态。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187254&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70fe93cd-53bd-4f36-85bf-b25f04270aa3\', \'multiverseId\': 187254}, \'multiverseid\': 187254}]', '[{\'name\': \'Krachmacherin des Ripp-Clans\', \'text\': \'Eile\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Falls du ausatmest, wird sie dich bekämpfen. Falls du Feuer ausatmest, muss sie dich bekämpfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187656&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2f76b2a0-2694-4713-8e49-7994ce92fd55\', \'multiverseId\': 187656}, \'multiverseid\': 187656}, {\'name\': \'Aplastadora del Clan Rip\', \'text\': \'Prisa.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Si respiras, luchará contigo. Si respiras fuego, debe luchar contigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187905&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c3c81ea-0669-4002-b539-5287390d7d34\', \'multiverseId\': 187905}, \'multiverseid\': 187905}, {\'name\': "Fracasseuse du clan de l\'Entaille", \'text\': \'Célérité\', \'type\': \'Créature : humain et guerrier\', \'flavor\': \'Si vous soufflez, elle vous combattra. Si vous soufflez le feu, elle devra vous combattre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188652&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4263621a-63e7-4ee3-8f40-100df33e43c3\', \'multiverseId\': 188652}, \'multiverseid\': 188652}, {\'name\': \'Distruttrice del Clan Squarcio\', \'text\': \'Rapidità\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': \'Se respiri, ti affronterà. Se soffi fuoco, dovrà affrontarti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188403&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6e68c26-b84a-4f07-8f3b-5e30cef66445\', \'multiverseId\': 188403}, \'multiverseid\': 188403}, {\'name\': \'切り裂き隊の壊し屋\', \'text\': \'速攻\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'お前が息をするのなら、彼女はお前と戦うだろう。 お前が火の息をするのなら、彼女は必ずやお前と戦うだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187158&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca820ad9-904a-4d30-9dc5-2e37a393a739\', \'multiverseId\': 187158}, \'multiverseid\': 187158}, {\'name\': \'Estilhaçadora do Clã do Corte\', \'text\': \'Ímpeto\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Se você respirar, ela lutará contra você. Se você respirar fogo, ela deverá lutar contra você.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188154&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd3d0293-1ac6-47d4-ac22-c97a952f8b7f\', \'multiverseId\': 188154}, \'multiverseid\': 188154}, {\'name\': \'Крушитель из Разломного Клана\', \'text\': \'Ускорение\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Если вы дышите, она вызовет вас на бой. Если вы дышите огнем, то она просто обязана это сделать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188901&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8b29db74-e06c-4155-a187-d112f3034343\', \'multiverseId\': 188901}, \'multiverseid\': 188901}, {\'name\': \'撕肉族击破兵\', \'text\': \'敏捷\', \'type\': \'生物～人类／战士\', \'flavor\': \'如果你呼气，她将会与你战斗。 如果你吐火，她必须与你战斗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187407&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e0ba6ee-29fd-43de-80b0-8d84dfa77155\', \'multiverseId\': 187407}, \'multiverseid\': 187407}]', '[{\'name\': \'Krater-Teufelsbraten\', \'text\': \'Verschlingen 1 (Sowie diese Karte ins Spiel kommt, kannst du eine beliebige Anzahl an Kreaturen opfern. Diese Kreatur kommt mit so vielen +1/+1-Marken ins Spiel.)\\nWenn der Krater-Teufelsbraten ins Spiel kommt, fügt er allen Kreaturen 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Teufelsbraten\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187562&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de17913a-58a0-4383-9f59-922ff7af6f9c\', \'multiverseId\': 187562}, \'multiverseid\': 187562}, {\'name\': \'Infernal de la caldera\', \'text\': \'Devorar 1. (En cuanto esto entra en juego puedes sacrificar cualquier cantidad de criaturas. Esta criatura entra en juego con esa cantidad de contadores +1/+1 sobre ella.)\\nCuando el Infernal de la caldera entre en juego, le hace 3 puntos de daño a cada criatura.\', \'type\': \'Criatura — Infernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187811&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc99935f-ec96-4995-be65-9830845a5614\', \'multiverseId\': 187811}, \'multiverseid\': 187811}, {\'name\': \'Monstruosité des caldeiras\', \'text\': \'Dévorement 1 (Au moment où cette créature arrive en jeu, vous pouvez sacrifier le nombre de créatures de votre choix. Cette créature arrive en jeu avec ce nombre de marqueurs +1/+1 sur elle.)\\nQuand la Monstruosité des caldeiras arrive en jeu, elle inflige 3 blessures à chaque créature.\', \'type\': \'Créature : monstruosité\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188558&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'162b3e55-dd90-4a98-85bb-4a55a132d107\', \'multiverseId\': 188558}, \'multiverseid\': 188558}, {\'name\': \'Infernale della Caldera\', \'text\': "Divorare 1 (Mentre questa creatura entra in gioco, puoi sacrificare un qualsiasi numero di creature. Entra in gioco con un numero di segnalini +1/+1 pari alle creature sacrificate.)\\nQuando l\'Infernale della Caldera entra in gioco, infligge 3 danni a ogni creatura.", \'type\': \'Creatura — Infernale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188309&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'757fb655-9a6f-4786-b2f2-7c0974045451\', \'multiverseId\': 188309}, \'multiverseid\': 188309}, {\'name\': \'カルデラの乱暴者\', \'text\': \'貪食 １ （これが場に出るに際し、あなたは望む数のクリーチャーを生け贄に捧げてもよい。 このクリーチャーはその数に等しい＋１/＋１カウンターが置かれた状態で場に出る。）\\nカルデラの乱暴者が場に出たとき、それは各クリーチャーにそれぞれ３点のダメージを与える。\', \'type\': \'クリーチャー — ヘリオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187064&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83020da4-4e3f-42f0-a258-da6618673836\', \'multiverseId\': 187064}, \'multiverseid\': 187064}, {\'name\': \'Avernal da Caldeira\', \'text\': \'Devorar 1 (Conforme esta criatura entra em jogo, você pode sacrificar um número qualquer de criaturas. Esta criatura entra em jogo com aquela quantidade de marcadores +1/+1.)\\nQuando Avernal da Caldeira entra em jogo, ele causa 3 pontos de dano a cada criatura.\', \'type\': \'Criatura — Avernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188060&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c7e4556b-3696-4aa6-8fee-ccaa0733eedd\', \'multiverseId\': 188060}, \'multiverseid\': 188060}, {\'name\': \'Кальдерный Геллион\', \'text\': \'Пожирание 1 (При входе этого существа в игру вы можете пожертвовать любое количество существ. Это существо входит в игру с таким же количеством жетонов +1/+1 на нем.)\\nКогда Кальдерный Геллион входит в игру, он наносит 3 повреждения каждому существу.\', \'type\': \'Существо — Геллион\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188807&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dc5acd1f-13bc-4b92-ae95-980cfe39cff9\', \'multiverseId\': 188807}, \'multiverseid\': 188807}, {\'name\': \'火口湖地狱兽\', \'text\': \'吞噬1 （于它进场时，你可以牺牲任意数量的生物。 此生物进场时上面有该数量的+1/+1指示物。）\\n当火口湖地狱兽进场时，它对每个生物造成3点伤害。\', \'type\': \'生物～地狱兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187313&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c39f6367-602e-4620-823e-b2d0e0b306bd\', \'multiverseId\': 187313}, \'multiverseid\': 187313}]', '[{\'name\': \'Kresh Blutzopf\', \'text\': \'Immer wenn eine andere Kreatur aus dem Spiel auf einen Friedhof gelegt wird, kannst du X +1/+1-Marken auf Kresh Blutzopf legen, wobei X gleich der Stärke der Kreatur ist.\', \'type\': \'Legendäre Kreatur — Mensch, Krieger\', \'flavor\': \'Jeder seiner zweiundzwanzig Zöpfe hat eine Spange aus Knochen und Leder eines anderen Feindes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187645&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0d7db85-6222-4df1-a0e1-6a9b88456912\', \'multiverseId\': 187645}, \'multiverseid\': 187645}, {\'name\': \'Kresh Trenzas Sangrientas\', \'text\': \'Siempre que otra criatura vaya a un cementerio desde el juego, puedes poner X contadores +1/+1 sobre Kresh Trenzas Sangrientas, donde X es la fuerza de esa criatura.\', \'type\': \'Criatura legendaria — Guerrero humano\', \'flavor\': \'Cada una de sus veintidós trenzas está atada con huesos y cuero de un enemigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187894&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdf4e020-f6d3-4402-8f4b-074eef00c8d1\', \'multiverseId\': 187894}, \'multiverseid\': 187894}, {\'name\': \'Kresh aux Nattes sanguinolentes\', \'text\': "À chaque fois qu\'une autre créature est mise dans un cimetière depuis le jeu, vous pouvez mettre X marqueurs +1/+1 sur Kresh aux Nattes sanguinolentes, X étant la force de cette créature.", \'type\': \'Créature légendaire : humain et guerrier\', \'flavor\': "Chacune de ses vingt-deux nattes est entrelacée des ossements et du cuir d\'un de ses ennemis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188641&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c060646a-9127-42cf-8d5f-40bd8b5491d3\', \'multiverseId\': 188641}, \'multiverseid\': 188641}, {\'name\': \'Kresh dalle Trecce Rosse\', \'text\': "Ogniqualvolta un\'altra creatura viene messa in un cimitero dal gioco, puoi mettere X segnalini +1/+1 su Kresh dalle Trecce Rosse, dove X è la forza di quella creatura.", \'type\': \'Creatura Leggendaria — Guerriero Umano\', \'flavor\': \'Ognuna delle sue ventidue trecce è legata con ossa e cuoio di un nemico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188392&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'199bc09b-fd94-4beb-befb-c33e2b3143cc\', \'multiverseId\': 188392}, \'multiverseid\': 188392}, {\'name\': \'血編み髪のクレシュ\', \'text\': \'他のクリーチャーが１体場からいずれかの墓地に置かれるたび、あなたは血編み髪のクレシュの上に＋１/＋１カウンターをＸ個置いてもよい。Ｘはそのクリーチャーのパワーに等しい。\', \'type\': \'伝説のクリーチャー — 人間・戦士\', \'flavor\': \'彼の二十二ある編み髪を縛っているのは、どれも敵の皮と骨だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187147&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bbddb838-0a5b-45d3-8748-1800d1d4583e\', \'multiverseId\': 187147}, \'multiverseid\': 187147}, {\'name\': \'Kresh Tranças-de-Sangue\', \'text\': \'Toda vez que outra criatura é colocada no cemitério vinda do jogo, você pode colocar X marcadores +1/+1 em Kresh Tranças-de-Sangue, sendo X igual ao poder daquela criatura.\', \'type\': \'Criatura Lendária — Humano Guerreiro\', \'flavor\': \'Cada uma de suas vinte e duas tranças é atada com ossos e pele de um inimigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188143&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'53d67265-e522-4ca0-aa12-311170455901\', \'multiverseId\': 188143}, \'multiverseid\': 188143}, {\'name\': \'Креш Кровавокосый\', \'text\': \'Каждый раз, когда другое существо попадает из игры на кладбище, вы можете положить X жетонов +1/+1 на Креша Кровавокосого, где X сила того существа.\', \'type\': \'Легендарное Существо — Человек Воин\', \'flavor\': \'В каждую из его двадцати двух кос вплетена кость и кусок кожи врага.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188890&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9e436098-b406-48bd-8094-222070650cd3\', \'multiverseId\': 188890}, \'multiverseid\': 188890}, {\'name\': \'血辫奎许\', \'text\': \'每当另一个生物从场上置入坟墓场时，你可以在血辫奎许上放置X个+1/+1指示物，X为该生物的力量。\', \'type\': \'传奇生物～人类／战士\', \'flavor\': \'他有二十二条辫子，每条都绑上一个敌人的骨头与皮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187396&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ed745e48-c87e-4264-b6ec-390242219a38\', \'multiverseId\': 187396}, \'multiverseid\': 187396}]', "[{'name': 'Kriecher aus Kederekt', 'text': 'Todesberührung (Immer wenn diese Kreatur einer Kreatur Schaden zufügt, zerstöre jene Kreatur.)\\nDer Kriecher aus Kederekt kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.', 'type': 'Kreatur — Schrecken', 'flavor': 'Vor lauter Gift aufgedunsen kriecht er durch Grixis und sucht Opfer, die er anschleimen kann.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187643&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aa9e0441-d840-4e1e-b79e-f8c11f5c53cc', 'multiverseId': 187643}, 'multiverseid': 187643}, {'name': 'Trepador de Kederekt', 'text': 'Toque mortal. (Siempre que esta criatura haga daño a una criatura, destruye esa criatura.)\\nEl Trepador de Kederekt no puede ser bloqueado excepto por dos o más criaturas.', 'type': 'Criatura — Horror', 'flavor': 'Lleno de veneno, repta por Grixis buscando víctimas que devorar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187892&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5f7f686c-80a4-4ad6-a071-fea8fdcebc9c', 'multiverseId': 187892}, 'multiverseid': 187892}, {'name': 'Fureteur de Kederekt', 'text': 'Contact mortel (À chaque fois que cette créature inflige des blessures à une créature, détruisez la créature blessée.)\\nLe Fureteur de Kederekt ne peut pas être bloqué excepté par deux créatures ou plus.', 'type': 'Créature : horreur', 'flavor': 'Gonflé de venin, il rampe dans tout Grixis à la recherche de victimes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188639&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7d54450c-e7ed-4ca4-b774-4037fe443c5f', 'multiverseId': 188639}, 'multiverseid': 188639}, {'name': 'Strisciante di Kederekt', 'text': 'Tocco letale (Ogniqualvolta questa creatura infligge danno a una creatura, distruggi quella creatura.)\\nLo Strisciante di Kederekt non può essere bloccato tranne che da due o più creature.', 'type': 'Creatura — Orrore', 'flavor': 'Gonfio di veleno, striscia in Grixis alla ricerca di vittime su cui colare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188390&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9d08b2c3-cd1f-4116-9f4b-d3946e9ab969', 'multiverseId': 188390}, 'multiverseid': 188390}, {'name': 'ケデレクトの忍び寄るもの', 'text': '接死 （このクリーチャーがいずれかのクリーチャーにダメージを与えるたび、そのクリーチャーを破壊する。）\\nケデレクトの忍び寄るものは、２体以上のクリーチャーによってしかブロックされない。', 'type': 'クリーチャー — ホラー', 'flavor': 'それはグリクシスを這い回り、毒に満ちた身体で犠牲者に乗りかかろうとしている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187145&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b3b64fc3-45cf-4ddd-a43c-57d89fa10af0', 'multiverseId': 187145}, 'multiverseid': 187145}, {'name': 'Rastejador de Kederekt', 'text': 'Toque mortífero (Toda vez que esta criatura causar dano a outra criatura, destrua aquela criatura.)\\nRastejador de Kederekt só pode ser bloqueado por duas ou mais criaturas.', 'type': 'Criatura — Horror', 'flavor': 'Inflado com veneno, ele rasteja por Grixis em busca das vítimas nas quais destilá-lo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188141&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '71a96439-ebdc-4773-a001-86b2ed8ec448', 'multiverseId': 188141}, 'multiverseid': 188141}, {'name': 'Кедеректский Ползун', 'text': 'Смертельное касание (Каждый раз, когда это существо наносит повреждения другому существу, уничтожьте то существо.)\\nКедеректский Ползун не может быть заблокирован менее чем двумя существами.', 'type': 'Существо — Ужас', 'flavor': 'Распухший от яда, он ползет по Гриксису, выбирая себе жертву.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188888&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c6a767e5-3dee-42c7-b73b-dc068d6609dc', 'multiverseId': 188888}, 'multiverseid': 188888}, {'name': '奇登磊匍行怪', 'text': '死触 （每当此生物对任一生物造成伤害时，消灭后者。）\\n奇登磊匍行怪只能被两个或更多生物阻挡。', 'type': '生物～惊惧兽', 'flavor': '它在格利极四处爬动，寻找对象来注射自己饱含的毒液。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187394&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c4d9eb04-2067-4ffd-b20b-1cd048f55ae3', 'multiverseId': 187394}, 'multiverseid': 187394}]", '[{\'name\': \'Krümmender Schmerz\', \'text\': \'Eine Kreatur deiner Wahl erhält -3/-0 bis zum Ende des Zuges.\\nEine Kreatur deiner Wahl erhält -0/-3 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'In Grixis läuft der Kreis des Lebens umgekehrt ab. Die gleiche Energie wird endlos wiederaufbereitet und wird dabei immer träger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187620&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26a59b05-768c-47dc-974a-a56ef9c16e6c\', \'multiverseId\': 187620}, \'multiverseid\': 187620}, {\'name\': \'Deformar agónicamente\', \'text\': \'La criatura objetivo obtiene -3/-0 hasta el final del turno.\\nLa criatura objetivo obtiene -0/-3 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'El círculo de la vida está invertido en Grixis. La misma energía se recicla incesantemente y con cada ciclo está más estancada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187869&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c9691c2f-4d61-442b-ba91-444b00ec5dc7\', \'multiverseId\': 187869}, \'multiverseid\': 187869}, {\'name\': "Distorsion d\'angoisse", \'text\': "La créature ciblée gagne -3/-0 jusqu\'à la fin du tour.\\nLa créature ciblée gagne -0/-3 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Le cycle de la vie s\'est inversé sur Grixis. La même énergie est constamment recyclée, devenant plus stagnante à chaque nouveau passage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'baee8b27-2f6f-4a3b-baad-9a09dca99184\', \'multiverseId\': 188616}, \'multiverseid\': 188616}, {\'name\': \'Distorsione Straziante\', \'text\': \'Una creatura bersaglio prende -3/-0 fino alla fine del turno.\\nUna creatura bersaglio prende -0/-3 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Il ciclo della vita è stato invertito in Grixis. La stessa energia viene continuamente riciclata e diventa più stagnante ad ogni passaggio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188367&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30b21932-3a4a-4278-9c19-3757d513a202\', \'multiverseId\': 188367}, \'multiverseid\': 188367}, {\'name\': \'苦悶のねじれ\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで－３/－０の修整を受ける。\\nクリーチャー１体を対象とする。それはターン終了時まで－０/－３の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'生命の移り変わりは、グリクシスでは逆向きになっている。 同じ力は無限に移り変わっていくが、一回りごとにどんどん停滞していくのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187122&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10168112-db35-44ca-9a24-c46e709630f1\', \'multiverseId\': 187122}, \'multiverseid\': 187122}, {\'name\': \'Distorção Agonizante\', \'text\': \'A criatura alvo recebe -3/-0 até o final do turno.\\nA criatura alvo recebe -0/-3 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O círculo da vida se inverteu em Grixis. A mesma energia é reciclada infinitamente e se torna mais estagnante a cada passagem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188118&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'421eb2ba-6565-4f1e-9dbd-70f5ac5d88b1\', \'multiverseId\': 188118}, \'multiverseid\': 188118}, {\'name\': \'Мучительная Деформация\', \'text\': \'Целевое существо получает -3/-0 до конца хода.\\nЦелевое существо получает -0/-3 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Круг жизни в Гриксисе вывернут наизнанку. Одна и та же энергия используется до бесконечности, становясь с каждым циклом все более застойной.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188865&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c3ef3a20-dbb7-4603-9a76-8f6b57d3df6a\', \'multiverseId\': 188865}, \'multiverseid\': 188865}, {\'name\': \'苦痛歪曲\', \'text\': \'目标生物得-3/-0直到回合结束。\\n目标生物得-0/-3直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'生命的循环在格利极逆转。 同样的能量无止境地循环利用，每一轮过后都变得更加腐臭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187371&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e588eb6b-4ef5-47ca-a797-997a9aebf102\', \'multiverseId\': 187371}, \'multiverseid\': 187371}]', '[{\'name\': \'Kuss der Amesha-Engel\', \'text\': \'Ein Spieler deiner Wahl erhält 7 Lebenspunkte dazu und zieht zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'Einmal im Jahr findet in Akrasa ein Ritterstechen statt, das die Ritter jeder Nation in Bant samt ihren Leotaus anzieht. Der Siegespreis ist ein akrasisches Siegel, aber die wahre Belohnung ist der Kuss eines Engels.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187644&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69eab7c3-5947-49da-8507-c8f9e7567809\', \'multiverseId\': 187644}, \'multiverseid\': 187644}, {\'name\': \'Beso de los Amesha\', \'text\': \'El jugador objetivo gana 7 vidas y roba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Una vez al año, Akrasa organiza una justa que atrae a los caballeros y sus leotaus de todas las naciones de Bant. El premio es un sello akrasano, pero la verdadera recompensa es el beso del ángel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187893&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce47edc9-89e5-4b4f-b15a-d1d3a4c175be\', \'multiverseId\': 187893}, \'multiverseid\': 187893}, {\'name\': "Baiser de l\'Amesha", \'text\': \'Le joueur ciblé gagne 7 points de vie et pioche deux cartes.\', \'type\': \'Rituel\', \'flavor\': "Une fois par an, Akrasa organise une joute qui attire les chevaliers et leurs léotaux de toutes les nations de Bant. Le vainqueur reçoit un sigille akrasan, mais la véritable récompense est le baiser de l\'ange.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188640&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'914a6bbb-86ba-48ff-b7eb-cce286c78851\', \'multiverseId\': 188640}, \'multiverseid\': 188640}, {\'name\': "Bacio dell\'Amesha", \'text\': \'Un giocatore bersaglio guadagna 7 punti vita e pesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': "Una volta all\'anno, Akrasa ospita un torneo che attira i cavalieri e i loro leotauri da ogni nazione in Bant. Il premio è un sigillo di Akrasa, ma la vera ricompensa è il bacio dell\'angelo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188391&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5f5a86be-9e04-46eb-be4c-2b952ea30f78\', \'multiverseId\': 188391}, \'multiverseid\': 188391}, {\'name\': \'アミーシャの口づけ\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは７点のライフを得てカードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'年に一度、アクラサではバントのあらゆる国の騎士とレオトーの集まる競技会が開かれる。 表向きの賞はアクラサの印章だが、真の栄誉は天使の口づけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187146&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9cc76f8-33d4-4492-a7cf-e7ee608e5de8\', \'multiverseId\': 187146}, \'multiverseid\': 187146}, {\'name\': \'Beijo de Amesha\', \'text\': \'O jogador alvo ganha 7 pontos de vida e compra dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Uma vez por ano, é realizada em Akrasa uma justa que atrai cavaleiros e leotaus de todas as nações de Bant. O prêmio é uma insígnia akrasana, mas a verdadeira recompensa é o beijo do anjo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188142&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5663b526-315c-44d2-92d9-45ba2e6db3ce\', \'multiverseId\': 188142}, \'multiverseid\': 188142}, {\'name\': \'Поцелуй Амеши\', \'text\': \'Целевой игрок получает 7 жизней и берет две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Раз в год в Акрасе устраивается турнир, на который стекаются рыцари и их верные леотау из всех стран Бэнта. Главный приз медаль Акрасы, но истинная награда это поцелуй ангела.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188889&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d5487c18-96f6-47e5-b573-a66730f31e9c\', \'multiverseId\': 188889}, \'multiverseid\': 188889}, {\'name\': \'爱米莎之吻\', \'text\': \'目标牌手获得7点生命并抓两张牌。\', \'type\': \'法术\', \'flavor\': \'阿卡沙每年会举办一次骑士比武，吸引班特全境的骑士与其座狮前来参与。 奖品是一个阿卡沙印记，但真正的奖赏则是天使之吻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187395&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec4f8ae5-35f6-4a41-8319-37ad9f7e00e8\', \'multiverseId\': 187395}, \'multiverseid\': 187395}]', '[{\'name\': \'Lakaienreflektor\', \'text\': \'Immer wenn eine Kreatur unter deiner Kontrolle ins Spiel kommt, die kein Spielstein ist, kannst du {2} bezahlen. Falls du dies tust, bringe einen Spielstein ins Spiel, der eine Kopie dieser Kreatur ist. Dieser Spielstein hat Eile und „Opfere am Ende des Zuges diese bleibende Karte".\', \'type\': \'Artefakt\', \'flavor\': \'Einen Spiegel zu zerbrechen bedeutet, eine Öffnung zu schaffen, durch die das Spiegelbild entweichen kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2bb92c2-2d90-44f9-9845-98449d9b4c86\', \'multiverseId\': 187678}, \'multiverseid\': 187678}, {\'name\': \'Reflector del sicario\', \'text\': \'Siempre que una criatura que no sea una ficha entre en juego bajo tu control, puedes pagar {2}. Si lo haces, pon en juego una ficha que es una copia de esa criatura. Esa ficha tiene la habilidad de prisa y "Al final del turno, sacrifica este permanente".\', \'type\': \'Artefacto\', \'flavor\': \'Quebrar un espejo es darle al reflejo una salida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187927&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5b6d164-6c27-42d1-a34f-03d704199a46\', \'multiverseId\': 187927}, \'multiverseid\': 187927}, {\'name\': \'Réflecteur de mignon\', \'text\': "À chaque fois qu\'une créature non-jeton arrive en jeu sous votre contrôle, vous pouvez payer {2}. Si vous faites ainsi, mettez en jeu un jeton qui est une copie de cette créature. Ce jeton a la célérité et « À la fin du tour, sacrifiez ce permanent. »", \'type\': \'Artefact\', \'flavor\': "Briser un miroir, c\'est permettre au reflet de s\'échapper.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188674&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'537eedd1-dc18-43aa-aa4f-592333a45b6a\', \'multiverseId\': 188674}, \'multiverseid\': 188674}, {\'name\': \'Servitore Riflettente\', \'text\': \'Ogniqualvolta una creatura non pedina entra in gioco sotto il tuo controllo, puoi pagare {2}. Se lo fai, metti in gioco una pedina che è una copia di quella creatura. Quella pedina ha rapidità e "Alla fine del turno, sacrifica questo permanente".\', \'type\': \'Artefatto\', \'flavor\': \'Rompere uno specchio è fornire un varco perché il riflesso riesca a fuggire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188425&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'588f302d-59d5-47cd-a5dc-3be209927752\', \'multiverseId\': 188425}, \'multiverseid\': 188425}, {\'name\': \'下僕の反射鏡\', \'text\': \'トークンでないクリーチャーが１体あなたのコントロール下で場に出るたび、あなたは{2}を支払ってもよい。 そうした場合、そのクリーチャーのコピーであるトークンを１体場に出す。 そのトークンは速攻と「ターン終了時に、このパーマネントを生け贄に捧げる。」を持つ。\', \'type\': \'アーティファクト\', \'flavor\': \'鏡を砕けば、反射が逃げるための道が現れる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187180&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce1dc99a-574c-4a14-af5b-9a9f9c740d13\', \'multiverseId\': 187180}, \'multiverseid\': 187180}, {\'name\': \'Refletor do Assecla\', \'text\': \'Toda vez que uma criatura que não seja ficha entra em jogo sob seu controle, você pode pagar {2}. Se fizer isso, coloque uma ficha em jogo que seja uma cópia daquela criatura. Aquela ficha tem ímpeto e "No final do turno, sacrifique esta permanente."\', \'type\': \'Artefato\', \'flavor\': \'Quebrar um espelho é proporcionar uma abertura para que o reflexo escape.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188176&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba60862d-1875-4eb1-b8cf-9220628f8e2f\', \'multiverseId\': 188176}, \'multiverseid\': 188176}, {\'name\': \'Отражатель Приспешников\', \'text\': \'Каждый раз, когда не являющееся фишкой существо входит в игру под вашим контролем, вы можете заплатить {2}. Если вы это делаете, положите в игру одну фишку, являющуюся копией того существа. Та фишка имеет Ускорение и способность «В конце хода пожертвуйте этот перманент».\', \'type\': \'Артефакт\', \'flavor\': \'Трещина в зеркале это лазейка, через которую может ускользнуть отражение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188923&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8a6e9682-5241-4a34-8458-30d9073f0238\', \'multiverseId\': 188923}, \'multiverseid\': 188923}, {\'name\': \'仆从映镜\', \'text\': \'每当一个非衍生物的生物在你的操控下进场时，你可以支付{2}。 若你如此作，则将一个衍生物放置进场，且是该生物的复制。 该衍生物具有敏捷异能及「在回合结束时，牺牲此永久物。」\', \'type\': \'神器\', \'flavor\': \'若打破镜子，就会给里面的映影开个出口逃离。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187429&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62c63535-f6bf-4bc6-af52-0e204e4a11c1\', \'multiverseId\': 187429}, \'multiverseid\': 187429}]', '[{\'name\': \'Leichenkenner\', \'text\': \'Wenn der Leichenkenner ins Spiel kommt, kannst du deine Bibliothek nach einer Kreaturenkarte durchsuchen und diese Karte auf deinen Friedhof legen. Falls du dies tust, mische danach deine Bibliothek.\\nExhumieren {3}{B} ({3}{B}: Bringe diese Karte aus deinem Friedhof ins Spiel zurück. Sie hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Kreatur — Zombie, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36f0f6dd-12b9-4344-8a28-52e5dcab6667\', \'multiverseId\': 187535}, \'multiverseid\': 187535}, {\'name\': \'Conocedor de cuerpos\', \'text\': \'Cuando el Conocedor de cuerpos entre en juego, puedes buscar en tu biblioteca una carta de criatura y ponerla en tu cementerio. Si lo haces, baraja tu biblioteca.\\nDesenterrar {3}{B}. ({3}{B}: Regresa esta carta de tu cementerio al juego. Gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura — Hechicero zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187784&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe860893-b7e3-40a2-9317-052ee93deee4\', \'multiverseId\': 187784}, \'multiverseid\': 187784}, {\'name\': \'Connaisseur en cadavres\', \'text\': "Quand le Connaisseur en cadavres arrive en jeu, vous pouvez chercher dans votre bibliothèque une carte de créature et mettre cette carte dans votre cimetière. Si vous faites ainsi, mélangez votre bibliothèque.\\nExhumation {3}{B} ({3}{B} : Renvoyez en jeu cette carte de votre cimetière. Elle acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature : zombie et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188531&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'01e3727e-3aa5-4e4c-b628-a0ee75c28997\', \'multiverseId\': 188531}, \'multiverseid\': 188531}, {\'name\': \'Esperto di Cadaveri\', \'text\': "Quando l\'Esperto di Cadaveri entra in gioco, puoi passare in rassegna il tuo grimorio per una carta creatura e metterla nel tuo cimitero. Se lo fai, rimescola il tuo grimorio.\\nDissotterrare {3}{B} ({3}{B}: Rimetti in gioco questa carta dal tuo cimitero. Ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)", \'type\': \'Creatura — Mago Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188282&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf60f8fa-9199-4b1c-9101-ee5c4e777e7c\', \'multiverseId\': 188282}, \'multiverseid\': 188282}, {\'name\': \'死体の鑑定人\', \'text\': \'死体の鑑定人が場に出たとき、あなたはあなたのライブラリーからクリーチャー・カードを１枚探してあなたの墓地に置いてもよい。そうした場合、あなたのライブラリーを切り直す。\\n蘇生 {3}{B} ({3}{B}：このカードをあなたの墓地から場に戻す。 それは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — ゾンビ・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187037&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a02afdb-4283-434c-8978-a1db3a433f2c\', \'multiverseId\': 187037}, \'multiverseid\': 187037}, {\'name\': \'Connoisseur de Cadáveres\', \'text\': \'Quando Connoisseur de Cadáveres entra em jogo, você pode procurar em seu grimório por um card de criatura e colocá-lo no seu cemitério. Se fizer isso, embaralhe seu grimório.\\nDesenterrar {3}{B} ({3}{B}: Devolva este card de seu cemitério para o jogo. Ele ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura — Zumbi Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188033&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a266343-7322-4c7d-8028-bb548094fe05\', \'multiverseId\': 188033}, \'multiverseid\': 188033}, {\'name\': \'Знаток Трупов\', \'text\': \'Когда Знаток Трупов входит в игру, вы можете найти в вашей библиотеке карту существа и положить ту карту на ваше кладбище. Если вы это делаете, перетасуйте вашу библиотеку.\\nОткопать {3}{B} ({3}{B}: верните эту карту из вашего кладбища в игру. Она получает Ускорение. Удалите ее из игры в конце хода, или если она должна покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Существо — Зомби Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188780&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eb72c8c5-33b6-4906-8f88-625f17794f6c\', \'multiverseId\': 188780}, \'multiverseid\': 188780}, {\'name\': \'死尸鉴赏家\', \'text\': \'当死尸鉴赏家进场时，你可以从你的牌库中搜寻一张生物牌，并将该牌置入你的坟墓场。若你如此作，则将你的牌库洗牌。\\n破坟{3}{B} （{3}{B}：将此牌从你的坟墓场移回场上。 它获得敏捷。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'生物～灵俑／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187286&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8605c3fd-934a-4953-b4d0-a3ba19a1788f\', \'multiverseId\': 187286}, \'multiverseid\': 187286}]', '[{\'name\': \'Leviathan aus Kederekt\', \'text\': \'Wenn der Leviathan aus Kederekt ins Spiel kommt, bringe alle anderen bleibenden Karten, die keine Länder sind, auf die Hand ihrer Besitzer zurück.\\nExhumieren {6}{U} ({6}{U}: Bringe diese Karte aus deinem Friedhof ins Spiel zurück. Sie hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Kreatur — Leviathan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187515&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b82260ee-e2bf-4103-a7a2-a7ee5d0530fe\', \'multiverseId\': 187515}, \'multiverseid\': 187515}, {\'name\': \'Leviatán de Kederekt\', \'text\': \'Cuando el Leviatán de Kederekt entre en juego, regresa todos los otros permanentes que no sean tierras a las manos de sus propietarios.\\nDesenterrar {6}{U}. ({6}{U}: Regresa esta carta de tu cementerio al juego. Gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura — Leviatán\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187764&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab18e8a5-8ba3-4f8d-a9b8-c632526937ef\', \'multiverseId\': 187764}, \'multiverseid\': 187764}, {\'name\': \'Léviathan de Kederekt\', \'text\': "Quand le Léviathan de Kederekt arrive en jeu, renvoyez tous les autres permanents non-terrain dans les mains de leurs propriétaires.\\nExhumation {6}{U} ({6}{U} : Renvoyez en jeu cette carte depuis votre cimetière. Elle acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature : léviathan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188511&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f31d9401-7b0c-42f5-a41a-c94d3549afb0\', \'multiverseId\': 188511}, \'multiverseid\': 188511}, {\'name\': \'Leviatano di Kederekt\', \'text\': \'Quando il Leviatano di Kederekt entra in gioco, fai tornare tutti gli altri permanenti non terra in mano ai loro proprietari.\\nDissotterrare {6}{U} ({6}{U}: Rimetti in gioco questa carta dal tuo cimitero. Ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)\', \'type\': \'Creatura — Leviatano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188262&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f41b5dc-220d-4741-9558-5784a8c80f2a\', \'multiverseId\': 188262}, \'multiverseid\': 188262}, {\'name\': \'ケデレクトのリバイアサン\', \'text\': \'ケデレクトのリバイアサンが場に出たとき、他のすべての土地でないパーマネントをオーナーの手札に戻す。\\n蘇生 {6}{U} ({6}{U}：このカードをあなたの墓地から場に戻す。 それは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — リバイアサン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187017&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79b8decb-a625-4afb-9981-83f7c5dbc37c\', \'multiverseId\': 187017}, \'multiverseid\': 187017}, {\'name\': \'Leviatã de Kederekt\', \'text\': \'Quando Leviatã de Kederekt entrar em jogo, devolva todas as permanentes que não sejam terrenos para a mão de seus donos.\\nDesenterrar {6}{U} ({6}{U}: Devolva este card de seu cemitério para o jogo. Ele ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura — Leviatã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188013&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'26ca2fd3-6683-44b1-b0c6-e8f320c983ae\', \'multiverseId\': 188013}, \'multiverseid\': 188013}, {\'name\': \'Кедеректский Левиафан\', \'text\': \'Когда Кедеректский Левиафан входит в игру, верните все остальные не являющиеся землями перманенты в руки их владельцев.\\nОткопать {6}{U} ({6}{U}: верните эту карту из вашего кладбища в игру. Она получает Ускорение. Удалите ее из игры в конце хода, или если она должна покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Существо — Левиафан\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188760&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5bd99b50-84a6-46e2-a8cf-afb45b8f6711\', \'multiverseId\': 188760}, \'multiverseid\': 188760}, {\'name\': \'奇登磊海怪\', \'text\': \'当奇登磊海怪进场时，将所有其他非地永久物移回其拥有者手上。\\n破坟{6}{U} （{6}{U}：将此牌从你的坟墓场移回场上。 它获得敏捷。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'生物～海怪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187266&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3102d800-c09d-4d15-b571-ea0be31e27cf\', \'multiverseId\': 187266}, \'multiverseid\': 187266}]', '[{\'name\': \'Listiger Vergessensmagier\', \'text\': \'Zu Beginn deines Ziehsegments wirft jeder Spieler eine Karte aus seiner Hand ab.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Gib mir deine Erinnerungen, und ich erlöse dich von den Qualen, die sie dir bringen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187536&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'454b2073-4968-4f9f-945b-323fe622e3d6\', \'multiverseId\': 187536}, \'multiverseid\': 187536}, {\'name\': \'Olvidomante astuto\', \'text\': \'Al comienzo de tu mantenimiento, cada jugador descarta una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Dame tus recuerdos, y te liberarás del sufrimiento que te causan."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187785&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c059dbc-4c07-4448-be22-e9d0f5dc8997\', \'multiverseId\': 187785}, \'multiverseid\': 187785}, {\'name\': \'Amnémancien rusé\', \'text\': "Au début de votre entretien, chaque joueur se défausse d\'une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Donnez-moi vos souvenirs, et vous serez libéré des souffrances qu\'ils vous apportent. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63bc02db-8c35-4941-bce4-f9fef1ffc453\', \'multiverseId\': 188532}, \'multiverseid\': 188532}, {\'name\': \'Letemante Astuto\', \'text\': "All\'inizio del tuo mantenimento, ogni giocatore scarta una carta.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Dammi i tuoi ricordi e sarai libero dalla sofferenza che ti provocano."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188283&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b945a910-175d-4601-ae63-ff5b570249fb\', \'multiverseId\': 188283}, \'multiverseid\': 188283}, {\'name\': \'狡猾な忘術士\', \'text\': \'あなたのアップキープの開始時に、各プレイヤーはカードを１枚捨てる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「記憶を差し出すがよい。さすれば、それがもたらす苦悩から解き放ってくれよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187038&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d0ae4085-25f1-40cf-b40c-b5c8c520f698\', \'multiverseId\': 187038}, \'multiverseid\': 187038}, {\'name\': \'Mnemomântico Ardiloso\', \'text\': \'No início de sua manutenção, cada jogador descarta um card.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Dê-me suas memórias e você estará livre do sofrimento que elas lhe causam."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188034&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a94cb16-62c3-43ed-98b1-d7f548450922\', \'multiverseId\': 188034}, \'multiverseid\': 188034}, {\'name\': \'Коварный Летамант\', \'text\': \'В начале вашего шага поддержки каждый игрок сбрасывает одну карту.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Отдай свои воспоминания мне, и ты будешь свободен от страданий, которые они тебе причиняют».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188781&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'13d69b22-831a-4e26-b10e-32107bd5e643\', \'multiverseId\': 188781}, \'multiverseid\': 188781}, {\'name\': \'狡诈忘却术士\', \'text\': \'在你的维持开始时，每位牌手弃一张牌。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「将记忆交给我，你将能从它带来的苦痛中解脱。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187287&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09c79b8e-67ef-4dc7-bbf5-67662e385c02\', \'multiverseId\': 187287}, \'multiverseid\': 187287}]', '[{\'name\': \'Macht des Seele\', \'text\': \'Lege X +1/+1-Marken auf eine Kreatur deiner Wahl, wobei X gleich der Stärke der Kreatur ist.\', \'type\': \'Hexerei\', \'flavor\': \'Er formt einen Avatar aus Instinkt und Kraft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187616&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c321eb0-684c-4340-8b3d-fc2d4c5a0bd4\', \'multiverseId\': 187616}, \'multiverseid\': 187616}, {\'name\': \'Poder del alma\', \'text\': \'Pon X contadores +1/+1 sobre la criatura objetivo, donde X es la fuerza de esa criatura.\', \'type\': \'Conjuro\', \'flavor\': \'Esculpe un avatar de instinto y fuerza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187865&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4374469-2d77-4f06-bb1b-5b4b9995e1d0\', \'multiverseId\': 187865}, \'multiverseid\': 187865}, {\'name\': "Puissance de l\'âme", \'text\': \'Mettez X marqueurs +1/+1 sur la créature ciblée, X étant la force de cette créature.\', \'type\': \'Rituel\', \'flavor\': "Un avatar qu\'il sculpte avec l\'instinct et la force.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188612&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'de51d865-f47d-4111-8dbd-1a848b882bbe\', \'multiverseId\': 188612}, \'multiverseid\': 188612}, {\'name\': "Potenza dell\'Anima", \'text\': \'Metti X segnalini +1/+1 su una creatura bersaglio, dove X è la forza di quella creatura.\', \'type\': \'Stregoneria\', \'flavor\': \'Scolpisce un avatar di forza e istinto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee1bed2a-b28b-49b7-bdfe-22daaff3bd32\', \'multiverseId\': 188363}, \'multiverseid\': 188363}, {\'name\': \'魂の力\', \'text\': \'クリーチャー１体を対象とし、それの上に＋１/＋１カウンターをＸ個置く。Ｘはそのクリーチャーのパワーに等しい。\', \'type\': \'ソーサリー\', \'flavor\': \'本能と力を象った化身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187118&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d37f191c-a415-4acc-ae99-decb585fe721\', \'multiverseId\': 187118}, \'multiverseid\': 187118}, {\'name\': \'Poder da Alma\', \'text\': \'Coloque X marcadores +1/+1 na criatura alvo, sendo X igual ao poder daquela criatura.\', \'type\': \'Feitiço\', \'flavor\': \'Um avatar ele esculpe, de instinto e força.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188114&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb37d7f3-0035-4a2a-a085-c179c1b4144e\', \'multiverseId\': 188114}, \'multiverseid\': 188114}, {\'name\': \'Сила Души\', \'text\': \'Положите X жетонов +1/+1 на целевое существо, где Х сила того существа.\', \'type\': \'Волшебство\', \'flavor\': \'Аватара, которую он ваяет из чутья и силы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188861&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e5ef44cc-d0e9-4d9d-a133-7ff99fb6bb2f\', \'multiverseId\': 188861}, \'multiverseid\': 188861}, {\'name\': \'灵魂瀚力\', \'text\': \'在目标生物上放置X个+1/+1指示物，X为该生物的力量。\', \'type\': \'法术\', \'flavor\': \'以直觉与力量塑造的化身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187367&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7447b1d5-e31b-4465-a263-6f6a794e51ff\', \'multiverseId\': 187367}, \'multiverseid\': 187367}]', '[{\'name\': \'Magmagischt\', \'text\': \'Die Magmagischt fügt einer Kreatur deiner Wahl 2 Schadenspunkte zu. Falls diese Kreatur in diesem Zug auf einen Friedhof gelegt würde, entferne sie stattdessen ganz aus dem Spiel.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Jund ist eine Welt voller Wunden. Hüte dich vor dem kochenden Blut, das an die Oberfläche spritzt." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187575&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8031a88d-37de-495b-86f2-5d17c8ae9c6f\', \'multiverseId\': 187575}, \'multiverseid\': 187575}, {\'name\': \'Rocío de magma\', \'text\': \'El Rocío de magma hace 2 puntos de daño a la criatura objetivo. Si esa criatura fuera a ir a un cementerio este turno, en vez de eso, remuévela del juego.\', \'type\': \'Instantáneo\', \'flavor\': \'"Jund es un mundo herido. Ten cuidado con su sangre derramándose en la superficie." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187824&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a38c2bab-b80d-4bb0-9c2b-3e661b22447b\', \'multiverseId\': 187824}, \'multiverseid\': 187824}, {\'name\': \'Giclée de magma\', \'text\': \'La Giclée de magma inflige 2 blessures à la créature ciblée. Si cette créature devait être mise dans un cimetière ce tour-ci, retirez-la de la partie à la place.\', \'type\': \'Éphémère\', \'flavor\': \'« Jund est un monde blessé. Prenez garde, son sang brûlant jaillit à la surface. » —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188571&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92a343bb-8e05-46ee-9db6-887d4786c3ae\', \'multiverseId\': 188571}, \'multiverseid\': 188571}, {\'name\': \'Spruzzo di Magma\', \'text\': \'Lo Spruzzo di Magma infligge 2 danni a una creatura bersaglio. Se quella creatura sta per essere messa in un cimitero in questo turno, rimuovila invece dal gioco.\', \'type\': \'Istantaneo\', \'flavor\': \'"Jund è un mondo ferito. Fai attenzione al suo sangue incandescente che zampilla in superficie." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188322&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5637895c-6598-4f4a-83df-34b4cec648c5\', \'multiverseId\': 188322}, \'multiverseid\': 188322}, {\'name\': \'マグマのしぶき\', \'text\': \'クリーチャー１体を対象とする。マグマのしぶきはそれに２点のダメージを与える。 そのクリーチャーがこのターンいずれかの墓地に置かれる場合、代わりにそれをゲームから取り除く。\', \'type\': \'インスタント\', \'flavor\': \'「ジャンドは傷を負った世界なの。 肌から噴き出す焼けた血に気をつけることね。」 ――ラッカ・マー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187077&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34a8c175-7caa-4ba5-af42-662653e6eed1\', \'multiverseId\': 187077}, \'multiverseid\': 187077}, {\'name\': \'Esguicho de Magma\', \'text\': \'Esguicho de Magma causa 2 pontos de dano à criatura alvo. Se aquela criatura seria colocada num cemitério neste turno, em vez disso, remova-a de jogo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Jund é um mundo ferido. Tome cuidado com seu sangue fervente que jorra na superfície." — Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188073&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'781b6498-30d3-4e66-b03b-43c9f6eaf6fa\', \'multiverseId\': 188073}, \'multiverseid\': 188073}, {\'name\': \'Выброс Магмы\', \'text\': \'Выброс Магмы наносит 2 повреждения целевому существу. Если то существо должно быть положено на кладбище в этом ходу, удалите его из игры вместо этого.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Джанд израненный мир. Опасайтесь его кипящей крови, выплескивающейся на поверхность». — Ракка Мар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188820&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eafe5481-d2f0-41e7-a7ea-ffe4710416be\', \'multiverseId\': 188820}, \'multiverseid\': 188820}, {\'name\': \'岩浆喷散\', \'text\': \'岩浆喷散对目标生物造成2点伤害。 若该生物于本回合中将被置入坟墓场，则改为将它移出对战。\', \'type\': \'瞬间\', \'flavor\': \'「勇得是充满伤痕的世界。 得提防它从地面喷出的火热血液。」 ～拉卡玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187326&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9ee78bb-a2b2-4172-9e14-d84f4f881a12\', \'multiverseId\': 187326}, \'multiverseid\': 187326}]', '[{\'name\': \'Manaplasma\', \'text\': \'Immer wenn du einen Zauberspruch spielst, erhält das Manaplasma +X/+X bis zum Ende des Zuges, wobei X gleich den umgewandelten Manakosten dieses Zauberspruchs ist.\', \'type\': \'Kreatur — Schlammwesen\', \'flavor\': \'Urak blieb stehen, als er es hörte. Das war sein erster Fehler. Dann drehte er sich um und sprach einen wilden Schutzzauber. Das war sein letzter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187605&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c0374c6-66e2-47d2-b7a0-673979bc82b5\', \'multiverseId\': 187605}, \'multiverseid\': 187605}, {\'name\': \'Manaplasma\', \'text\': \'Siempre que juegues un hechizo, el Manaplasma obtiene +X/+X hasta el final del turno, donde X es el coste de maná convertido de ese hechizo.\', \'type\': \'Criatura — Cieno\', \'flavor\': \'Urak se detuvo cuando lo escuchó. Ese fue su primer error. Se giró y lanzó un hechizo de protección. Ese fue su último error.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187854&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a26ac0ab-35f0-40ca-a47c-7ad505b125eb\', \'multiverseId\': 187854}, \'multiverseid\': 187854}, {\'name\': \'Manaplasme\', \'text\': "À chaque fois que vous jouez un sort, le Manaplasme gagne +X/+X jusqu\'à la fin du tour, X étant le coût converti de mana de ce sort.", \'type\': \'Créature : limon\', \'flavor\': "Urak s\'immobilisa quand il l\'entendit. Ce fut sa première erreur. Il se retourna et lança un sort de défense théâtral. Ce fut sa dernière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188601&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cc48e93c-ed18-413b-86c3-af503650c500\', \'multiverseId\': 188601}, \'multiverseid\': 188601}, {\'name\': \'Manaplasma\', \'text\': \'Ogniqualvolta giochi una magia, il Manaplasma prende +X/+X fino alla fine del turno, dove X è il costo di mana convertito di quella magia.\', \'type\': \'Creatura — Melma\', \'flavor\': \'Urak si bloccò quando lo udì. Fu il suo primo errore. Si girò e lanciò una magia sigillante. Fu il suo ultimo errore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188352&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d54c0e16-7242-4a40-9a28-165463ae7d23\', \'multiverseId\': 188352}, \'multiverseid\': 188352}, {\'name\': \'魔力軟体\', \'text\': \'あなたが呪文を１つプレイするたび、魔力軟体はターン終了時まで＋Ｘ/＋Ｘの修整を受ける。Ｘはその呪文の点数で見たマナ・コストに等しい。\', \'type\': \'クリーチャー — ウーズ\', \'flavor\': \'その音を聞いて、ウラクは凍りついた。 それが彼の最初の過ちだった。 彼は振り返り、強烈な結界呪文を唱えた。 それが彼の最後の過ちだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187107&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94a501d7-bcc9-4da1-866e-00c2ce3874b6\', \'multiverseId\': 187107}, \'multiverseid\': 187107}, {\'name\': \'Manaplasma\', \'text\': \'Toda vez que você joga uma mágica, Manaplasma recebe +X/+X até o final do turno, sendo X igual ao custo de mana convertido daquela mágica.\', \'type\': \'Criatura — Lodo\', \'flavor\': \'Urak congelou-se ao ouvi-lo. Esse foi seu primeiro erro. Ele se virou e lançou uma dramática mágica de proteção. Foi seu último.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188103&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73951b4e-82cb-4fae-aa68-ea4233e29c38\', \'multiverseId\': 188103}, \'multiverseid\': 188103}, {\'name\': \'Манаплазма\', \'text\': \'Каждый раз, когда вы разыгрываете заклинание, Манаплазма получает +X/+X до конца хода, где X конвертированная мана-стоимость того заклинания.\', \'type\': \'Существо — Тина\', \'flavor\': \'Урак замер, когда услышал ее приближение. Это было его первой ошибкой. Он повернулся и применил впечатляющее охранительное заклинание. Оно стало его последней ошибкой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188850&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac38895c-575f-4007-ac22-d766fbda9f74\', \'multiverseId\': 188850}, \'multiverseid\': 188850}, {\'name\': \'魔力流浆\', \'text\': \'每当你使用一个咒语时，魔力流浆得+X/+X直到回合结束，X为该咒语的总法术力费用。\', \'type\': \'生物～流浆\', \'flavor\': \'这声音让乌拉克僵住； 这是他犯的第一个错误。 他转身施放强大防护咒语； 这是他犯的最后一个错误。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187356&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5be87fe3-30a6-44d8-8fa6-ef90664323ab\', \'multiverseId\': 187356}, \'multiverseid\': 187356}]', "[{'name': 'Marmorkelch', 'text': '{T}: Du erhältst 1 Lebenspunkt dazu.', 'type': 'Artefakt', 'flavor': 'Der Kelch war ein Geschenk der Sphinx Tameron, damit diejenigen, die aus ihm tranken, lange genug lebten, um die Weisheit der Sphingen zu entschlüsseln.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187485&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1f49b70a-7ebc-4777-a4c0-d4386aff9722', 'multiverseId': 187485}, 'multiverseid': 187485}, {'name': 'Cáliz de mármol', 'text': '{T}: Ganas 1 vida.', 'type': 'Artefacto', 'flavor': 'El cáliz fue un regalo de la esfinge Tameron, quien tenía la esperanza que aquellos que bebieran de él vivieran lo suficiente como para descifrar la sabiduría de las esfinges.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187734&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '16b54c0d-2507-4ad4-afe3-6a338d3e5c8f', 'multiverseId': 187734}, 'multiverseid': 187734}, {'name': 'Calice de marbre', 'text': '{T} : Vous gagnez 1 point de vie.', 'type': 'Artefact', 'flavor': 'Le calice était un don du sphinx Tameron, qui espérait que quiconque y boirait vivrait suffisamment longtemps pour décrypter la sagesse des sphinx.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188481&type=card', 'language': 'French', 'identifiers': {'scryfallId': '66893744-a993-4a15-ac65-fa231ab42db0', 'multiverseId': 188481}, 'multiverseid': 188481}, {'name': 'Calice di Marmo', 'text': '{T}: Guadagni 1 punto vita.', 'type': 'Artefatto', 'flavor': 'La coppa era un dono della sfinge Tameron, la quale sperava che quanti bevevano da essa potessero vivere abbastanza a lungo da decifrare la saggezza delle sfingi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188232&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ff3709d0-064f-40a2-99a2-bcd28f37bfe8', 'multiverseId': 188232}, 'multiverseid': 188232}, {'name': '大理石の杯', 'text': '{T}：あなたは１点のライフを得る。', 'type': 'アーティファクト', 'flavor': 'この杯はスフィンクスのタマロンからの授かり物だ。彼はこの杯から飲んだ者が、スフィンクスの知恵を解き明かせるほどの長寿を得ることを願っていた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186987&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8ac82632-3edb-4fd0-8fe5-62b2252d1b5c', 'multiverseId': 186987}, 'multiverseid': 186987}, {'name': 'Cálice de Mármore', 'text': '{T}: Você ganha 1 ponto de vida.', 'type': 'Artefato', 'flavor': 'O cálice era um presente da esfinge Tameron, na esperança de que aqueles que dele bebessem viveriam o bastante para decifrar a sabedoria das esfinges.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187983&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f4f4efc7-3280-4774-92d1-fe3b7adc484e', 'multiverseId': 187983}, 'multiverseid': 187983}, {'name': 'Мраморная Чаша', 'text': '{T}: вы получаете 1 жизнь.', 'type': 'Артефакт', 'flavor': 'Эта чаша была даром сфинкса Тамерон, которая надеялась, что испившие из нее будут жить достаточно долго для того, чтобы разгадать тайну мудрости сфинксов.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188730&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '049725d7-d660-4ad0-8062-b307faa8266a', 'multiverseId': 188730}, 'multiverseid': 188730}, {'name': '大理石圣杯', 'text': '{T}：你获得1点生命。', 'type': '神器', 'flavor': '这杯子是史芬斯谭莫琅的赠礼，她希望用它饮水的人都能获致长寿，才能通晓史芬斯的智慧。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187236&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b4fcb140-20da-406f-bdfd-6c9a57a45ec1', 'multiverseId': 187236}, 'multiverseid': 187236}]", '[{\'name\': \'Marodierender Fleischsack\', \'text\': \'Wenn der Marodierende Fleischsack ins Spiel kommt, opfert jeder Spieler eine Kreatur.\', \'type\': \'Kreatur — Zombie, Krieger\', \'flavor\': \'Grixis ist eine Welt, auf der es nur Tod und Verfall im Überfluss gibt. Leichen, auch in Teilen, sind die Standardwährung bei Todesbeschwörern und Dämonen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187543&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'456733f1-a03b-44fb-8be4-f24e0ed05d60\', \'multiverseId\': 187543}, \'multiverseid\': 187543}, {\'name\': \'Merodeador bolsa de carne\', \'text\': \'Cuando el Merodeador bolsa de carne entre en juego, cada jugador sacrifica una criatura.\', \'type\': \'Criatura — Guerrero zombie\', \'flavor\': \'Grixis es un mundo donde lo único que hay en abundancia es muerte y podredumbre. Los cuerpos, enteros o en partes, son moneda corriente entre necromantes y demonios.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187792&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dde2fc9a-a7a3-47ea-9522-da7afddac5d9\', \'multiverseId\': 187792}, \'multiverseid\': 187792}, {\'name\': \'Maraudeur sacpeau\', \'text\': \'Quand le Maraudeur sacpeau arrive en jeu, chaque joueur sacrifie une créature.\', \'type\': \'Créature : zombie et guerrier\', \'flavor\': "Grixis est un monde où seules la mort et la décrépitude existent en abondance. Les cadavres, entiers ou en pièces, sont la monnaie d\'échange des nécromanciens et des démons.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188539&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72ae7279-6ef2-4cc2-80aa-185e6003ea4e\', \'multiverseId\': 188539}, \'multiverseid\': 188539}, {\'name\': \'Predone Sacco di Carne\', \'text\': \'Quando il Predone Sacco di Carne entra in gioco, ogni giocatore sacrifica una creatura.\', \'type\': \'Creatura — Guerriero Zombie\', \'flavor\': \'Grixis è un mondo in cui le sole cose che abbondano sono la morte e la putrefazione. I cadaveri, interi o in parti, sono la moneta corrente tra demoni e necromanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188290&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3841c6e4-bab9-4bec-82bb-a920c33343a9\', \'multiverseId\': 188290}, \'multiverseid\': 188290}, {\'name\': \'肉袋の匪賊\', \'text\': \'肉袋の匪賊が場に出たとき、各プレイヤーはクリーチャーを１体生け贄に捧げる。\', \'type\': \'クリーチャー — ゾンビ･戦士\', \'flavor\': \'グリクシスに大量に存在するものは死と腐敗だけだ。 死体は全身であれ一部であれ、屍術士や悪魔達の間では一般的な通貨である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187045&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47dff959-7581-47dd-a5c3-785b03d90dd4\', \'multiverseId\': 187045}, \'multiverseid\': 187045}, {\'name\': \'Saqueador Saco-de-Carne\', \'text\': \'Quando Saqueador Saco-de-Carne entra em jogo, cada jogador sacrifica uma criatura.\', \'type\': \'Criatura — Zumbi Guerreiro\', \'flavor\': \'Grixis é um mundo em que a única coisa abundante é a morte e a decadência. Os cadáveres, inteiros ou em partes, são a moeda corrente dos necromantes e demônios.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188041&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8791b210-00de-4d74-abf0-363ad9ddac28\', \'multiverseId\': 188041}, \'multiverseid\': 188041}, {\'name\': \'Трупный Куль-Мародер\', \'text\': \'Когда Трупный Куль-Мародер входит в игру, каждый игрок жертвует существо.\', \'type\': \'Существо — Зомби Воин\', \'flavor\': \'Гриксис это мир, где в изобилии есть только смерть и тлен. Трупы, целиком или кусками, обычное средство платежа среди некромантов и демонов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188788&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6718d35f-fc30-4da3-b114-c138363c4598\', \'multiverseId\': 188788}, \'multiverseid\': 188788}, {\'name\': \'肉囊劫掠者\', \'text\': \'当肉囊劫掠者进场时，每位牌手牺牲一个生物。\', \'type\': \'生物～灵俑／战士\', \'flavor\': \'格利极这世界盛产的只有死亡与腐败。 死灵术士与恶魔所使用的交易标准是死尸，不论完整或是片段。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187294&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3849d8ee-8291-4c8b-a53e-087b31a7ec4d\', \'multiverseId\': 187294}, \'multiverseid\': 187294}]', '[{\'name\': \'Mayael die Anima\', \'text\': \'{3}{R}{G}{W}, {T}: Schaue dir die obersten fünf Karten deiner Bibliothek an. Du kannst davon eine Kreaturenkarte mit Stärke 5 oder mehr ins Spiel bringen. Lege den Rest in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Legendäre Kreatur — Elf, Schamane\', \'flavor\': \'Die Augen der heiligen Anima sehen nichts außer den größten Wahrheiten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187646&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab0395cf-7d89-47c8-8292-b8a9201cca1a\', \'multiverseId\': 187646}, \'multiverseid\': 187646}, {\'name\': \'Mayael el Ánima\', \'text\': \'{3}{R}{G}{W}, {T}: Mira las primeras cinco cartas de tu biblioteca. Puedes poner en juego una carta de criatura con fuerza de 5 o más que se encuentre entre ellas. Pon el resto en la parte inferior de tu biblioteca en cualquier orden.\', \'type\': \'Criatura legendaria — Chamán elfo\', \'flavor\': \'Los ojos sagrados del Ánima están ciegos a todo salvo las más grandes verdades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187895&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61349fa4-f538-4c98-8f1e-2b601b2a6727\', \'multiverseId\': 187895}, \'multiverseid\': 187895}, {\'name\': "Mayael l\'Anima", \'text\': "{3}{R}{G}{W}, {T} : Regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez mettre en jeu une carte de créature de force supérieure ou égale à 5 parmi elles. Mettez les autres au-dessous de votre bibliothèque, dans n\'importe quel ordre.", \'type\': \'Créature légendaire : elfe et shamane\', \'flavor\': "Les yeux de l\'Anima sacrée ne voient que les plus imposantes vérités.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188642&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db5da6c1-5ab5-4654-9425-07ba332f34be\', \'multiverseId\': 188642}, \'multiverseid\': 188642}, {\'name\': "Mayael l\'Anima", \'text\': \'{3}{R}{G}{W}, {T}: Guarda le prime cinque carte del tuo grimorio. Puoi mettere in gioco una carta creatura con forza pari o superiore a 5 scelta tra esse. Metti le altre in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Creatura Leggendaria — Sciamano Elfo\', \'flavor\': \'Gli occhi della sacra Anima sono ciechi a tutto tranne che alle verità più imponenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188393&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe5a586e-457e-42ab-9899-e7a64243b848\', \'multiverseId\': 188393}, \'multiverseid\': 188393}, {\'name\': \'アニマのメイエル\', \'text\': \'{3}{R}{G}{W}, {T}：あなたのライブラリーの一番上から５枚のカードを見る。 あなたはそれらの中からパワーが５以上のクリーチャー・カードを１枚場に出してもよい。 残りのカードをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'伝説のクリーチャー — エルフ・シャーマン\', \'flavor\': \'聖なるアニマの目は、最も偉大なる真実以外には盲いている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187148&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47f0cd10-fdb6-4c37-803b-56c1edc5398c\', \'multiverseId\': 187148}, \'multiverseid\': 187148}, {\'name\': \'Mayael, a Anima\', \'text\': \'{3}{R}{G}{W}, {T}: Olhe os cinco cards do topo de seu grimório. Você pode colocar em jogo um card de criatura com poder maior ou igual a 5 dentre eles. Coloque o resto no fundo de seu grimório em qualquer ordem.\', \'type\': \'Criatura Lendária — Elfo Xamã\', \'flavor\': \'Os olhos sagrados de Anima são cegos a tudo, menos às verdades mais grandiosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188144&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dff54020-c3cc-4821-9477-ed413dcfaf53\', \'multiverseId\': 188144}, \'multiverseid\': 188144}, {\'name\': \'Майел, Святая Анима\', \'text\': \'{3}{R}{G}{W}, {T}: посмотрите пять верхних карт вашей библиотеки. Вы можете положить в игру находящуюся среди них карту существа с силой 5 или больше. Положите остальные карты в низ вашей библиотеки в любом порядке.\', \'type\': \'Легендарное Существо — Эльф Шаман\', \'flavor\': \'Глаза святой Анимы слепы ко всему, кроме самых великих истин.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188891&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'60d44195-7fd5-4799-8969-9bfcab5d2b7f\', \'multiverseId\': 188891}, \'multiverseid\': 188891}, {\'name\': \'谕灵梅燕\', \'text\': \'{3}{R}{G}{W}，{T}：检视你牌库顶的五张牌。 你可以将其中一张力量大于或等于5的生物牌放置进场。 将其余的牌以任意顺序置于你牌库底。\', \'type\': \'传奇生物～地精／祭师\', \'flavor\': \'谕灵的神圣双眼只看得到最深层的真实。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187397&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d195a963-01c0-447c-b934-b908a727cfc2\', \'multiverseId\': 187397}, \'multiverseid\': 187397}]', '[{\'name\': \'Meister des Läuterns\', \'text\': \'{T}: Ein Spieler deiner Wahl legt die oberste Karte seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Vergiss. Nur dann hast du zwischen Schmerz und Furcht auch Raum für Hoffnung."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e4706e64-4aee-4629-840f-316831922aa1\', \'multiverseId\': 187501}, \'multiverseid\': 187501}, {\'name\': \'Perito catártico\', \'text\': \'{T}: El jugador objetivo pone la primera carta de su biblioteca en su cementerio .\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Olvida. Sólo entonces habrá lugar para la esperanza entre el dolor y el miedo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187750&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'91fc9126-1894-4d12-ac05-517cd1c47387\', \'multiverseId\': 187750}, \'multiverseid\': 187750}, {\'name\': \'Expert en catharsis\', \'text\': \'{T} : Le joueur ciblé met la carte du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Oubliez. Vous trouverez alors une place pour l\'espoir entre la souffrance et la peur. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188497&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb6ba6ac-9472-4f01-8775-035f6fe0ac8c\', \'multiverseId\': 188497}, \'multiverseid\': 188497}, {\'name\': \'Catartico Esperto\', \'text\': \'{T}: Un giocatore bersaglio mette nel suo cimitero la prima carta del suo grimorio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Dimentica. Solo allora ci sarà spazio per la speranza tra il dolore e la paura."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188248&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1d34fb6-0df3-45f9-bfe8-cdb49e3b10a7\', \'multiverseId\': 188248}, \'multiverseid\': 188248}, {\'name\': \'垂れ流しの達人\', \'text\': \'{T}：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上のカードを自分の墓地に置く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「忘れよ。 さすれば、苦痛と恐怖の間に希望の生まれる隙間もできよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187003&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1dc1649e-f318-4549-b02f-6714afcd19aa\', \'multiverseId\': 187003}, \'multiverseid\': 187003}, {\'name\': \'Adepto Catártico\', \'text\': \'{T}: O jogador alvo coloca o card do topo de seu grimório em seu cemitério.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Esqueça. Só então haverá espaço para a esperança entre a dor e o medo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187999&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'96aa5bcf-bcae-4191-8f29-1bce5b117d2e\', \'multiverseId\': 187999}, \'multiverseid\': 187999}, {\'name\': \'Адепт Катарсиса\', \'text\': \'{T}: целевой игрок кладет верхнюю карту своей библиотеки на свое кладбище.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Забудь. Только так меж боли и страха появится место для надежды».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188746&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0542ee45-7d24-487b-8651-b1475b318beb\', \'multiverseId\': 188746}, \'multiverseid\': 188746}, {\'name\': \'倾泄专家\', \'text\': \'{T}：目标牌手将他的牌库顶牌置入其坟墓场。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「忘了吧。 这样你才能在痛苦与恐惧之间留点空间给希望。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187252&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ff08d78b-02e3-4c93-a0f4-f3b4fea9eb2c\', \'multiverseId\': 187252}, \'multiverseid\': 187252}]', '[{\'name\': \'Meister des Ätheriums\', \'text\': \'Stärke und Widerstandskraft des Meisters des Ätheriums sind gleich der Anzahl der Artefakte, die du kontrollierst.\\nAndere Artefaktkreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Artefaktkreatur — Vedalken, Zauberer\', \'flavor\': \'„Nur ein Verstand, der nicht von den Sorgen eines Körpers belastet wird, kann die Welt so sehen, wie sie wirklich ist."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187516&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6270d704-65cc-4151-af24-5c6ecdae80e8\', \'multiverseId\': 187516}, \'multiverseid\': 187516}, {\'name\': \'Maestro de eterium\', \'text\': \'La fuerza y resistencia del Maestro de eterium son iguales al número de artefactos que controles.\\nLas otras criaturas artefacto que controlas obtienen +1/+1.\', \'type\': \'Criatura artefacto — Hechicero vedalken\', \'flavor\': \'"Sólo una mente no contaminada con las preocupaciones de la carne puede ver el mundo como realmente es."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187765&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1789a86f-9605-462e-b67c-cb1ecb40f6a2\', \'multiverseId\': 187765}, \'multiverseid\': 187765}, {\'name\': "Maître de l\'étherium", \'text\': "La force et l\'endurance du Maître de l\'étherium sont chacune égale au nombre d\'artefacts que vous contrôlez.\\nLes autres créatures-artefacts que vous contrôlez gagnent +1/+1.", \'type\': \'Créature-artefact : vedalken et sorcier\', \'flavor\': "« Seul l\'esprit qui se moque des aspects de la chair peut voir le monde tel qu\'il est véritablement. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d368d19-05bb-4cf3-b0b3-5e686739920d\', \'multiverseId\': 188512}, \'multiverseid\': 188512}, {\'name\': \'Maestro di Eterium\', \'text\': \'La forza e la costituzione del Maestro di Eterium sono pari al numero di artefatti che controlli.\\nLe altre creature artefatto che controlli prendono +1/+1.\', \'type\': \'Creatura Artefatto — Mago Vedalken\', \'flavor\': \'"Solo una mente libera dalle preoccupazioni della carne può vedere il mondo com\\\'è realmente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188263&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'906aef3d-b81a-4965-8260-01f11ac39aa3\', \'multiverseId\': 188263}, \'multiverseid\': 188263}, {\'name\': \'エーテリウムの達人\', \'text\': \'エーテリウムの達人のパワーとタフネスは、それぞれあなたがコントロールするアーティファクトの総数に等しい。\\nあなたがコントロールする他のアーティファクト・クリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'アーティファクト・クリーチャー — ヴィダルケン・ウィザード\', \'flavor\': \'「肉体の懸念から解き放たれた精神のみが、真の世界を見ることができる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187018&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b6d58539-037d-4575-bec8-d3fa5f9626d9\', \'multiverseId\': 187018}, \'multiverseid\': 187018}, {\'name\': \'Mestre do Etherium\', \'text\': \'O poder e a resistência de Mestre do Etherium são ambos iguais ao número de artefatos que você controla.\\nAs outras criaturas artefato que você controla recebem +1/+1.\', \'type\': \'Criatura Artefato — Vedalkeano Mago\', \'flavor\': \'"Somente uma mente livre das preocupações da carne pode ver o mundo como ele realmente é."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188014&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'455b999d-1292-46db-9299-f030c2908ee5\', \'multiverseId\': 188014}, \'multiverseid\': 188014}, {\'name\': \'Мастер Эфирия\', \'text\': \'Сила и выносливость Мастера Эфирия равны количеству артефактов под вашим контролем.\\nДругие артефактные существа под вашим контролем получают +1/+1.\', \'type\': \'Артефактное Существо — Ведалкен Чародей\', \'flavor\': \'«Только разум, освобожденный от оков плоти, может увидеть мир таким, какой он есть на самом деле».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188761&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2acdc493-4459-4105-aed8-b2b882391413\', \'multiverseId\': 188761}, \'multiverseid\': 188761}, {\'name\': \'乙金大师\', \'text\': \'乙金大师的力量与防御力各等同于由你操控的神器之数量。\\n由你操控的其他神器生物得+1/+1。\', \'type\': \'神器生物～维多肯／法术师\', \'flavor\': \'「未受肉身束缚的心灵，才得见世界真貌。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187267&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bc0e2a2b-1149-44a1-9a52-a727597ed077\', \'multiverseId\': 187267}, \'multiverseid\': 187267}]', '[{\'name\': \'Metalldoktor\', \'text\': \'{W}, {T}: Regeneriere ein Artefakt deiner Wahl.\', \'type\': \'Artefaktkreatur — Mensch, Handwerker\', \'flavor\': \'„Als ich endlich ankam, hatte das Herz aufgehört zu schlagen. Zum Glück konnte ich es mit etwas Besserem ersetzen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18c52f05-e08b-4eb6-a85e-f7fb57c7a1c9\', \'multiverseId\': 187486}, \'multiverseid\': 187486}, {\'name\': \'Metalúrgico\', \'text\': \'{W}, {T}: Regenera el artefacto objetivo.\', \'type\': \'Criatura artefacto — Artífice humano\', \'flavor\': \'"Cuando llegué, el corazón ya se había detenido. Afortunadamente, pude reemplazarlo con algo mejor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187735&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cbba675d-0ff6-4fb6-803b-78c5bcc3a435\', \'multiverseId\': 187735}, \'multiverseid\': 187735}, {\'name\': \'Métallurgien\', \'text\': "{W}, {T} : Régénérez l\'artefact ciblé.", \'type\': \'Créature-artefact : humain et artificier\', \'flavor\': "« Quand je suis arrivé, le cœur avait cessé de battre. Heureusement, j\'ai pu le remplacer par mieux. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188482&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5824c8bd-739d-40d0-86a8-2548af69a1a6\', \'multiverseId\': 188482}, \'multiverseid\': 188482}, {\'name\': \'Metallurgo\', \'text\': \'{W}, {T}: Rigenera un artefatto bersaglio.\', \'type\': \'Creatura Artefatto — Artefice Umano\', \'flavor\': \'"Quando sono arrivato, il cuore si era fermato. Fortunatamente, sono riuscito a sostituirlo con qualcosa di meglio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188233&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4d4ea45-1516-4176-8cb0-f8fc49e63746\', \'multiverseId\': 188233}, \'multiverseid\': 188233}, {\'name\': \'機械医師\', \'text\': \'{W}, {T}：アーティファクト１つを対象とし、それを再生する。\', \'type\': \'アーティファクト・クリーチャー — 人間・工匠\', \'flavor\': \'「私が着いたときには、もう心臓は止まっていた。 幸運なことに、もっと良い物に取り替えることができたんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186988&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'50590c2a-4afc-4170-96e3-eff384f7da65\', \'multiverseId\': 186988}, \'multiverseid\': 186988}, {\'name\': \'Metalurgião\', \'text\': \'{W}, {T}: Regenere o artefato alvo.\', \'type\': \'Criatura Artefato — Humano Artesão\', \'flavor\': \'"Quando cheguei lá, o coração já havia parado. Felizmente, pude substituí-lo com algo melhor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187984&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2396b69c-456e-421b-8c2d-65ae4a9340a7\', \'multiverseId\': 187984}, \'multiverseid\': 187984}, {\'name\': \'Врачеватель Металла\', \'text\': \'{W}, {T}: регенерируйте целевой артефакт.\', \'type\': \'Артефактное Существо — Человек Механик\', \'flavor\': \'«Когда я наконец добрался до больного, его сердце уже остановилось. К счастью, я смог заменить его на кое-что получше».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188731&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cd97df78-3592-4105-976e-43d1c7c6a736\', \'multiverseId\': 188731}, \'multiverseid\': 188731}, {\'name\': \'金属医师\', \'text\': \'{W}，{T}：重生目标神器。\', \'type\': \'神器生物～人类／神器师\', \'flavor\': \'「在我到达之前，心脏已经停止运作。 幸好我还有办法拿更好的换上。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187237&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'776158df-8654-46c0-88e9-d1ee00278139\', \'multiverseId\': 187237}, \'multiverseid\': 187237}]', '[{\'name\': \'Moostodon\', \'text\': \'{1}: Eine Kreatur deiner Wahl mit Stärke 5 oder mehr verursacht bis zum Ende des Zuges Trampelschaden.\', \'type\': \'Kreatur — Pflanze, Elefant\', \'flavor\': "Ob jetzt die Gargantuas der fleischgewordene Wille des Progenitus\' sind oder nur das Resultat überfließender Ressourcen — wenn eine Herde davon auf dich zurennt, kann dir das egal sein.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187606&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6558fb3d-66b2-4f6f-a297-ee67a65240e2\', \'multiverseId\': 187606}, \'multiverseid\': 187606}, {\'name\': \'Musgodonte\', \'text\': \'{1}: La criatura objetivo con fuerza de 5 o más gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Elefante planta\', \'flavor\': \'Ya sea que las gargantúas sean la voluntad manifiesta de Progenitus o simplemente el resultado de la sobreabundancia de recursos es superfluo cuando toda una manada está pisoteándote.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187855&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d732bb30-7ab3-4db7-8535-17a7c8a987b7\', \'multiverseId\': 187855}, \'multiverseid\': 187855}, {\'name\': \'Moustodon\', \'text\': "{1} : La créature ciblée de force supérieure ou égale à 5 acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : plante et éléphant\', \'flavor\': "Que les gargantuesques soient la volonté manifeste de Progénitus ou simplement le résultat de ressources abondantes n\'a plus d\'importance quand ils vous foncent dessus en troupeau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188602&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b9ff1776-9457-4451-a850-c36199e60531\', \'multiverseId\': 188602}, \'multiverseid\': 188602}, {\'name\': \'Muschiodonte\', \'text\': \'{1}: Una creatura bersaglio con forza pari o superiore a 5 ha travolgere fino alla fine del turno.\', \'type\': \'Creatura — Elefante Pianta\', \'flavor\': \'Che i mastodonti siano la volontà manifesta del Progenitus o semplicemente il risultato di risorse sovrabbondanti è irrilevante quando una mandria si sta precipitando verso di te.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188353&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fcebe8e-f042-4c9d-8bcd-3dcb1c218f82\', \'multiverseId\': 188353}, \'multiverseid\': 188353}, {\'name\': \'モストドン\', \'text\': \'{1}：パワーが５以上のクリーチャー１体を対象とする。それはターン終了時までトランプルを得る。\', \'type\': \'クリーチャー — 植物・象\', \'flavor\': \'ガルガンチュアンが大祖始の意に従っていようと、あるいは単に有り余る資源の故であろうと、その群れが自分に突っ込んでくる状況では関係のないことだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187108&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9bcd3fa2-3785-4901-988b-ff5bf613f0e0\', \'multiverseId\': 187108}, \'multiverseid\': 187108}, {\'name\': \'Musgodonte\', \'text\': \'{1}: A criatura alvo com poder maior ou igual a 5 ganha atropelar até o final do turno.\', \'type\': \'Criatura — Planta Elefante\', \'flavor\': \'Se os gargantuas são a manifestação da vontade de Progenitus ou simplesmente o resultado de uma superabundância de recursos é irrelevante quando há uma manada deles galopando na sua direção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188104&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b71a539-fb80-46fd-b9e0-11790f47ae9a\', \'multiverseId\': 188104}, \'multiverseid\': 188104}, {\'name\': \'Моходонт\', \'text\': \'{1}: целевое существо с силой 5 или больше получает Пробивной удар до конца хода.\', \'type\': \'Существо — Растение Слон\', \'flavor\': \'Являются ли исполины проявлением воли Прародителя или всего лишь последствием огромного изобилия вопрос абсолютно не важный, когда на тебя несется целое стадо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188851&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c411939-8048-470f-ae33-76356533d9d3\', \'multiverseId\': 188851}, \'multiverseid\': 188851}, {\'name\': \'厚苔象\', \'text\': \'{1}：目标力量大于或等于5的生物获得践踏异能直到回合结束。\', \'type\': \'生物～植物／象\', \'flavor\': \'巨兽是祖神兽的意念展现，或者只是繁盛资源的产物？当他们一整群向你冲锋而来时，这问题一点意义都没有。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187357&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a5c3444-3c40-40cf-b9c8-6f464412dbac\', \'multiverseId\': 187357}, \'multiverseid\': 187357}]', '[{\'name\': \'Morgenlicht-Bogenschütze\', \'text\': \'Edelmut (Immer wenn eine Kreatur, die du kontrollierst, alleine angreift, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\n{W}, {T}: Der Morgenlicht-Bogenschütze fügt einer angreifenden oder blockenden Kreatur deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Mensch, Bogenschütze\', \'flavor\': \'Sie geben Schüsse meistens als Signal ab — oder als Erinnerung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187506&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a33599b-305a-472d-9651-4de80a12d4b7\', \'multiverseId\': 187506}, \'multiverseid\': 187506}, {\'name\': \'Arquera Rayo del alba\', \'text\': \'Exaltado. (Siempre que una criatura que controles ataque sola, esa criatura obtiene +1/+1 hasta el final del turno.)\\n{W}, {T}: La Arquera Rayo del alba hace 1 punto de daño a la criatura atacante o bloqueadora objetivo.\', \'type\': \'Criatura — Arquero humano\', \'flavor\': \'Sus disparos se usan casi siempre como señales... o contra aquellos que no entendieron el mensaje.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187755&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0fc59eff-fc32-4558-a39f-78f3f8705b7b\', \'multiverseId\': 187755}, \'multiverseid\': 187755}, {\'name\': \'Archer de Raidaube\', \'text\': "Exaltation (À chaque fois qu\'une créature que vous contrôlez attaque seule, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\n{W}, {T} : L\'Archer de Raidaube inflige 1 blessure à la créature attaquante ou bloqueuse ciblée.", \'type\': \'Créature : humain et archer\', \'flavor\': "Ils décochent surtout leurs flèches en guise d\'avertissement — ou pour ceux qui n\'auraient pas compris le message.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188502&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ab32316-cea9-4cc7-9eee-3702303778b8\', \'multiverseId\': 188502}, \'multiverseid\': 188502}, {\'name\': "Arciere di Raggio d\'Alba", \'text\': "Esaltato (Ogniqualvolta una creatura che controlli attacca da sola, prende +1/+1 fino alla fine del turno.)\\n{W}, {T}: L\'Arciere di Raggio d\'Alba infligge 1 danno a una creatura attaccante o bloccante bersaglio.", \'type\': \'Creatura — Arciere Umano\', \'flavor\': \'Le loro frecce sono scoccate spesso come segnali... o contro quanti non hanno recepito il messaggio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188253&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ed1d43c3-d486-43ae-bf20-24a542b2fdd2\', \'multiverseId\': 188253}, \'multiverseid\': 188253}, {\'name\': \'暁の光の射手\', \'text\': \'賛美 （あなたがコントロールするいずれかのクリーチャーが単独で攻撃するたび、そのクリーチャーはターン終了時まで＋１/＋１の修整を受ける。）\\n{W}, {T}：攻撃かブロックしているクリーチャー１体を対象とする。暁の光の射手はそれに１点のダメージを与える。\', \'type\': \'クリーチャー — 人間・射手\', \'flavor\': \'彼らの矢は、しばしば信号として放たれる――あるいは、それを理解できない相手に向けて。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187008&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85c3bb06-6075-429d-bb9a-668989e5ccb3\', \'multiverseId\': 187008}, \'multiverseid\': 187008}, {\'name\': \'Arqueiro do Raio Auroral\', \'text\': \'Exaltado (Toda vez que uma criatura que você controla ataca sozinha, ela recebe +1/+1 até o final do turno.)\\n{W}, {T}: Arqueiro do Raio Auroral causa 1 ponto de dano à criatura alvo atacante ou bloqueadora.\', \'type\': \'Criatura — Humano Arqueiro\', \'flavor\': \'Suas flechas geralmente são disparadas como alertas ou naqueles que não entenderam a mensagem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188004&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e9368fc-3fbe-4d0e-94e9-44513397555f\', \'multiverseId\': 188004}, \'multiverseid\': 188004}, {\'name\': \'Лучница Утренней Зари\', \'text\': \'Повышение (Каждый раз, когда существо под вашим контролем атакует в одиночку, оно получает +1/+1 до конца хода.)\\n{W}, {T}: Лучница Утренней Зари наносит 1 повреждение целевому атакующему или блокирующему существу.\', \'type\': \'Существо — Человек Лучник\', \'flavor\': \'Чаще всего они стреляют, чтобы подать сигнал или сразить тех, кто его не понял.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188751&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cf2c766e-6018-4a9e-88d3-fec06d676d7b\', \'multiverseId\': 188751}, \'multiverseid\': 188751}, {\'name\': \'晨辉箭手\', \'text\': \'颂威 （每当一个由你操控的生物单独攻击时，该生物得+1/+1直到回合结束。）\\n{W}，{T}：晨辉箭手对目标进行攻击或阻挡的生物造成1点伤害。\', \'type\': \'生物～人类／弓箭手\', \'flavor\': \'他们射箭多半是用来表示讯息～或是拿来对付那些看不懂的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187257&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0dc0a59-9829-40e5-a517-d9594dc741b6\', \'multiverseId\': 187257}, \'multiverseid\': 187257}]', '[{\'name\': \'Mykoloth\', \'text\': \'Verschlingen 2 (Sowie diese Karte ins Spiel kommt, kannst du eine beliebige Anzahl an Kreaturen opfern. Diese Kreatur kommt mit doppelt so vielen +1/+1-Marken ins Spiel.)\\nBringe zu Beginn deines Versorgungssegments für jede +1/+1-Marke auf dem Mykoloth einen 1/1 grünen Saproling-Kreaturenspielstein ins Spiel.\', \'type\': \'Kreatur — Pilzwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187607&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2a822ba6-9b1e-4fa9-8257-bd7862fcfbaa\', \'multiverseId\': 187607}, \'multiverseid\': 187607}, {\'name\': \'Micolot\', \'text\': \'Devorar 2. (En cuanto esto entra en juego puedes sacrificar cualquier cantidad de criaturas. Esta criatura entra en juego con el doble de esa cantidad de contadores +1/+1 sobre ella.)\\nAl comienzo de tu mantenimiento, pon en juego una ficha de criatura Saprolín verde 1/1 por cada contador +1/+1 sobre el Micolot.\', \'type\': \'Criatura — Hongo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187856&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a9c3bb3-43c7-495c-a3c2-2e747574e9b7\', \'multiverseId\': 187856}, \'multiverseid\': 187856}, {\'name\': \'Mycoloth\', \'text\': \'Dévorement 2 (Au moment où cette créature arrive en jeu, vous pouvez sacrifier le nombre de créatures de votre choix. Cette créature arrive en jeu avec deux fois ce nombre de marqueurs +1/+1 sur elle.)\\nAu début de votre entretien, mettez en jeu un jeton de créature 1/1 verte Saprobionte pour chaque marqueur +1/+1 sur le Mycoloth.\', \'type\': \'Créature : fongus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188603&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'838f7180-8fd7-4931-bfe7-0aacb1db3650\', \'multiverseId\': 188603}, \'multiverseid\': 188603}, {\'name\': \'Fungoloth\', \'text\': "Divorare 2 (Mentre questa creatura entra in gioco, puoi sacrificare un qualsiasi numero di creature. Entra in gioco con un numero di segnalini +1/+1 pari al doppio delle creature sacrificate.)\\nAll\'inizio del tuo mantenimento, metti in gioco una pedina creatura Saprolingio 1/1 verde per ogni segnalino +1/+1 sul Fungoloth.", \'type\': \'Creatura — Fungus\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188354&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0ee1ba1-c6c0-4987-bbcc-0e9c2e72d87d\', \'multiverseId\': 188354}, \'multiverseid\': 188354}, {\'name\': \'マイコロス\', \'text\': \'貪食 ２ （これが場に出るに際し、あなたは望む数のクリーチャーを生け贄に捧げてもよい。 このクリーチャーはその数の２倍に等しい＋１/＋１カウンターが置かれた状態で場に出る。）\\nあなたのアップキープの開始時に、マイコロスの上に置かれている＋１/＋１カウンター１個につき、緑の１/１の苗木・クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — ファンガス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187109&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9e4c70b1-700f-43b4-bf8c-2acc2c587001\', \'multiverseId\': 187109}, \'multiverseid\': 187109}, {\'name\': \'Micoloth\', \'text\': \'Devorar 2 (Conforme esta criatura entra em jogo, você pode sacrificar um número qualquer de criaturas. Esta criatura entra em jogo com o dobro daquela quantidade de marcadores +1/+1.)\\nNo início de sua manutenção, coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita para cada marcador +1/+1 em Micoloth.\', \'type\': \'Criatura — Fungo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188105&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f1c52f76-b473-46bc-83b6-5c6e621f5902\', \'multiverseId\': 188105}, \'multiverseid\': 188105}, {\'name\': \'Миколот\', \'text\': \'Пожирание 2 (При входе этого существа в игру вы можете пожертвовать любое количество существ. Это существо входит в игру с количеством жетонов +1/+1 на нем, в два раза превышающим их число.)\\nВ начале вашего шага поддержки положите в игру одну фишку существа 1/1 зеленый Сапролинг за каждый жетон +1/+1 на Миколоте.\', \'type\': \'Существо — Плесень\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188852&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88b1ea04-f90a-4560-b9da-c0f66c310f6a\', \'multiverseId\': 188852}, \'multiverseid\': 188852}, {\'name\': \'真菌洛西\', \'text\': \'吞噬2 （于它进场时，你可以牺牲任意数量的生物。 此生物进场时上面有该数量两倍的+1/+1指示物。）\\n在你的维持开始时，真菌洛西上每有一个+1/+1指示物，便将一个1/1绿色腐生物衍生物放置进场。\', \'type\': \'生物～真菌\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187358&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5c1bb96a-3ebd-4b1f-a8dc-fc832dfcdf88\', \'multiverseId\': 187358}, \'multiverseid\': 187358}]', '[{\'name\': \'Mysteriöses Sanktum\', \'text\': \'Das Mysteriöse Sanktum kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W}, {U} oder {B}.\', \'type\': \'Land\', \'flavor\': \'„Wir müssen uns auf unser eigenes Wissen verlassen, nicht auf das Dogma der Suchenden oder das Gemurmel der Sphingen." —Tullus von Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187687&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9257620e-7ed2-43f2-bc22-a34f5fff0bd7\', \'multiverseId\': 187687}, \'multiverseid\': 187687}, {\'name\': \'Santuario arcano\', \'text\': \'El Santuario arcano entra en juego girado.\\n{T}: Agrega {W}, {U}, o {B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"Debemos confiar en nuestro conocimiento, no en el dogma de los buscadores o los balbuceos de las esfinges." —Tullus de Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187936&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0008f744-65f0-4a78-9b9a-d4582886c568\', \'multiverseId\': 187936}, \'multiverseid\': 187936}, {\'name\': \'Sanctuaire ésotérique\', \'text\': \'Le Sanctuaire ésotérique arrive en jeu engagé.\\n{T} : Ajoutez {W}, {U} ou {B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': \'« Nous devons nous fier à notre connaissance, pas au dogme des chercheurs ou aux murmures des sphinx. » —Tullus de Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba6b8a19-f9f9-4ecb-a94e-498af6d432c8\', \'multiverseId\': 188683}, \'multiverseid\': 188683}, {\'name\': \'Santuario Arcano\', \'text\': \'Il Santuario Arcano entra in gioco TAPpato.\\n{T}: Aggiungi {W}, {U} o {B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'"Dobbiamo confidare nelle nostre conoscenze, non nel dogma dei cercatori o nei mormorii delle sfingi." —Tullus di Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188434&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'451b0bfc-f6d8-48e6-b292-6b758917f1c4\', \'multiverseId\': 188434}, \'multiverseid\': 188434}, {\'name\': \'秘儀の聖域\', \'text\': \'秘儀の聖域はタップ状態で場に出る。\\n{T}：あなたのマナ・プールに{W}か{U}か{B}を加える。\', \'type\': \'土地\', \'flavor\': \'「我々は求道者の教義やスフィンクスのぼやきなどではなく、自らの知識を礎としなければならない。」 ――パランディウスのタラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187189&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e805b47f-7cd7-4ef6-b9ed-fd9ec59dbd6c\', \'multiverseId\': 187189}, \'multiverseid\': 187189}, {\'name\': \'Santuário Arcano\', \'text\': \'Santuário Arcano entra em jogo virado.\\n{T}: Adicione {W}, {U} ou {B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"Precisamos confiar em nosso próprio conhecimento, não no dogma dos buscadores ou nos murmúrios das esfinges." — Tullus de Palandius\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188185&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ba770bc-86b8-4c6f-bdaf-225c97a1e631\', \'multiverseId\': 188185}, \'multiverseid\': 188185}, {\'name\': \'Загадочное Святилище\', \'text\': \'Загадочное Святилище входит в игру повернутым.\\n{T}: добавьте {W}, {U} или {B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'«Мы должны полагаться на собственные знания, а не на догмы искателей и бормотания сфинксов». — Туллус, правитель Паландиуса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188932&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'228171de-879e-40e7-84cf-ef38d88336cf\', \'multiverseId\': 188932}, \'multiverseid\': 188932}, {\'name\': \'玄秘圣所\', \'text\': \'玄秘圣所须横置进场。\\n{T}：加{W}，{U}，或{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'「我们得依赖自己的知识，而不是致知者的文件、史芬斯的呢喃。」 ～帕连迪的突卢兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187438&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'24e6b11b-c75b-4577-b795-614bf896b029\', \'multiverseId\': 187438}, \'multiverseid\': 187438}]', '[{\'name\': \'Naturalisieren\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Götzen von einst stecken voller Mineralien und Magie. Sie werden auseinandergerissen, wenn die Natur gut speisen will.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187608&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'536d3403-a8c3-4d88-9b9f-845cad39c52d\', \'multiverseId\': 187608}, \'multiverseid\': 187608}, {\'name\': \'Naturalizar\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Los ídolos del pasado son ricos en minerales y magia. Son destrozados cuando la naturaleza tiene hambre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187857&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'35229979-c567-46d6-8cc9-1ae53db9d290\', \'multiverseId\': 187857}, \'multiverseid\': 187857}, {\'name\': \'Naturalisation\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': \'Les idoles anciennes sont riches en minéraux et en magie. Elles sont détruites quand la nature a faim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188604&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4cd0acd3-0a5f-48a6-b941-751f02ab7f8d\', \'multiverseId\': 188604}, \'multiverseid\': 188604}, {\'name\': \'Ritorno alla Natura\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Gli idoli del passato sono ricchi di minerali e magia. Vengono fatti a pezzi quando la natura aspira a mangiare meglio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188355&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f7092a1-d9e8-437c-97ad-5f474f3e5d84\', \'multiverseId\': 188355}, \'multiverseid\': 188355}, {\'name\': \'帰化\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'古き偶像は素材と魔法に満ちている。 自然が食を求めれば、それは引き裂かれる定めだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187110&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'440cdefc-3c1c-49f0-9052-26728e1255d3\', \'multiverseId\': 187110}, \'multiverseid\': 187110}, {\'name\': \'Naturalizar\', \'text\': \'Destrua o artefato ou o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os ídolos do passado são ricos em minerais e magia. Eles são despedaçados quando a natureza precisa se alimentar bem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188106&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c96e391-67e4-4ebc-a2b6-e4fd48395d8c\', \'multiverseId\': 188106}, \'multiverseid\': 188106}, {\'name\': \'Приживание\', \'text\': \'Уничтожьте целевой артефакт или чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Старинные идолы богаты минералами и магией. Когда природа собирается как следует поесть, она разрывает их на части.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188853&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'947be076-0c3f-44ad-8122-9dc8333ce5f8\', \'multiverseId\': 188853}, \'multiverseid\': 188853}, {\'name\': \'回归自然\', \'text\': \'消灭目标神器或结界。\', \'type\': \'瞬间\', \'flavor\': \'古代的雕像充满矿物质与法术。 当大自然想要吃好一点，它们就将四散粉碎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187359&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2c9cf8f8-3442-417c-bb35-98d5afc4f60e\', \'multiverseId\': 187359}, \'multiverseid\': 187359}]', '[{\'name\': \'Nekrogenese\', \'text\': \'{2}: Entferne eine Kreaturenkarte deiner Wahl aus einem Friedhof ganz aus dem Spiel. Bringe einen 1/1 grünen Saproling-Kreaturenspielstein ins Spiel.\', \'type\': \'Verzauberung\', \'flavor\': \'„Dieses Gekrümme könnte andeuten, dass ein Leben endet oder ein anderes beginnt. Jedenfalls würde ich es lieber in Ruhe lassen." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187648&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e5eef3c-6ad4-49f7-ac64-02bbb9341a8b\', \'multiverseId\': 187648}, \'multiverseid\': 187648}, {\'name\': \'Necrogénesis\', \'text\': \'{2}: Remueve del juego la carta de criatura objetivo de un cementerio. Pon en juego una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Encantamiento\', \'flavor\': \'"Eso pueden ser los serpenteos de una vida que se acaba o una que comienza. En cualquier caso, lo dejaré tranquilo." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187897&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'954921fa-b767-4b5e-94de-54b38896cddc\', \'multiverseId\': 187897}, \'multiverseid\': 187897}, {\'name\': \'Nécrogénèse\', \'text\': "{2} : Retirez de la partie la carte de créature ciblée d\'un cimetière. Mettez en jeu un jeton de créature 1/1 verte Saprobionte.", \'type\': \'Enchantement\', \'flavor\': "« Ce sont peut-être les convulsions d\'une vie qui s\'achève ou d\'une autre qui commence. Dans les deux cas, je n\'y toucherais pas. » —Rakka Mar", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188644&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d3afa1f-63e8-4d26-a408-011f6a470d96\', \'multiverseId\': 188644}, \'multiverseid\': 188644}, {\'name\': \'Necrogenesi\', \'text\': \'{2}: Rimuovi dal gioco una carta creatura bersaglio in un cimitero. Metti in gioco una pedina creatura Saprolingio 1/1 verde.\', \'type\': \'Incantesimo\', \'flavor\': \'"Quelli potrebbero essere i contorcimenti di una vita che termina o di un\\\'altra che inizia. In entrambi i casi, preferisco lasciarla stare." —Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188395&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'959035ec-0a03-491c-be5e-9f1c93922378\', \'multiverseId\': 188395}, \'multiverseid\': 188395}, {\'name\': \'屍からの発生\', \'text\': \'{2}：いずれかの墓地にあるクリーチャー・カード１枚を対象とし、それをゲームから取り除く。 緑の１/１の苗木・クリーチャー・トークンを１体場に出す。\', \'type\': \'エンチャント\', \'flavor\': \'「一つの生の最期のもだえなのか、新たな生命の始まりなのか。 どっちにせよ、かかわらない方がいいわね。」 ――ラッカ・マー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187150&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d07c1d9b-e73f-4cc4-ad6b-b83f782b76f4\', \'multiverseId\': 187150}, \'multiverseid\': 187150}, {\'name\': \'Necrogênese\', \'text\': \'{2}: Remova do jogo o card de criatura alvo de um cemitério. Coloque em jogo uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Encantamento\', \'flavor\': \'"Podem ser contorções de uma vida que termina ou de outra que se inicia. De qualquer forma, é melhor não interferir." — Rakka Mar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188146&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45920102-cd77-425f-a4ce-5a12da9c2718\', \'multiverseId\': 188146}, \'multiverseid\': 188146}, {\'name\': \'Некрогенез\', \'text\': \'{2}: удалите из игры находящуюся на кладбище целевую карту существа. Положите в игру одну фишку существа 1/1 зеленый Сапролинг.\', \'type\': \'Чары\', \'flavor\': \'«Так может корчиться либо уже угасающая жизнь, либо еще только зарождающаяся. Так или иначе, советую ее не трогать». — Ракка Мар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188893&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'07d47a00-e924-477c-9d3f-5993b1305034\', \'multiverseId\': 188893}, \'multiverseid\': 188893}, {\'name\': \'死灵创生\', \'text\': \'{2}：将目标生物牌从任一坟墓场移出对战。 将一个1/1绿色腐生物衍生物放置进场。\', \'type\': \'结界\', \'flavor\': \'「那些触手可能要终结某生命，也可能要开始某生命。 不论如何，我都不会去管。」 ～拉卡玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187399&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'063e5e0c-813e-4593-bb4d-b3ccceb54bc9\', \'multiverseId\': 187399}, \'multiverseid\': 187399}]', '[{\'name\': \'Obelisk von Bant\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {G}, {W} oder {U}.\', \'type\': \'Artefakt\', \'flavor\': \'Ob sie in Burgen eingebaut oder als Einzeldenkmäler bewundert werden, die Obelisken stehen für die Werte von Bant: Treue, Ehre und Wahrheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d0cfd29d-b522-4c74-8d2f-9f7e353f7257\', \'multiverseId\': 187679}, \'multiverseid\': 187679}, {\'name\': \'Obelisco de Bant\', \'text\': \'{T}: Agrega {G}, {W}, o {U} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Ya sea incorporados a la estructura de castillos o admirados como símbolos solitarios, los obeliscos representan los valores de lealtad, honor y verdad en Bant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187928&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'243f9a7a-734c-4f30-b66e-c7752f223a4b\', \'multiverseId\': 187928}, \'multiverseid\': 187928}, {\'name\': \'Obélisque de Bant\', \'text\': \'{T} : Ajoutez {G}, {W} ou {U} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Incorporé dans la structure des châteaux ou admiré comme symbole solitaire, l\'obélisque représente les valeurs de loyauté, d\'honneur et de vérité de Bant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188675&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4f74c00-f3cf-4b8d-acba-a403c89db960\', \'multiverseId\': 188675}, \'multiverseid\': 188675}, {\'name\': \'Obelisco di Bant\', \'text\': \'{T}: Aggiungi {G}, {W} o {U} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Che siano incorporati nella struttura dei castelli o ammirati come simboli solitari, gli obelischi rappresentano i valori di lealtà, onore e verità di Bant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188426&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e46a37f-52e5-471e-8673-f0219065e167\', \'multiverseId\': 188426}, \'multiverseid\': 188426}, {\'name\': \'バントのオベリスク\', \'text\': \'{T}：あなたのマナ・プールに{G}か{W}か{U}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'オベリスクはバントの忠誠と名誉と真実の象徴で、城に組み込まれることも単独でシンボルとなることもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187181&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2890845e-5609-45c5-ad40-d9815497131b\', \'multiverseId\': 187181}, \'multiverseid\': 187181}, {\'name\': \'Obelisco de Bant\', \'text\': \'{T}: Adicione {G}, {W} ou {U} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Estejam incorporados à estrutura de castelos ou como símbolos solitários, os obeliscos representam os valores de lealdade, honra e verdade de Bant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188177&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'870b06ad-1b04-449e-a203-5d99b91ffc2f\', \'multiverseId\': 188177}, \'multiverseid\': 188177}, {\'name\': \'Обелиск Бэнта\', \'text\': \'{T}: добавьте {G}, {W} или {U} в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'Являются ли они частью замковых ансамблей или возвышаются как одинокие памятники, обелиски символизируют такие добродетели Бэнта, как верность, честь и правда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188924&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e141987-eeba-4827-b154-24bbb2e9fac0\', \'multiverseId\': 188924}, \'multiverseid\': 188924}, {\'name\': \'班特碑\', \'text\': \'{T}：加{G}，{W}，或{U}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'不论是由于上面所镌刻的种姓系统，或是纯粹当作象征，此碑都代表了班特的价值观：忠贞，荣誉，以及真诚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187430&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f71ebbc-014c-4c58-a2dd-92ad1f37bd02\', \'multiverseId\': 187430}, \'multiverseid\': 187430}]', '[{\'name\': \'Obelisk von Esper\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {W}, {U} oder {B}.\', \'type\': \'Artefakt\', \'flavor\': \'Er ist ein Monument, das so nüchtern, unnachgiebig und unergründlich wie Esper selbst ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187680&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'30052443-72e8-490e-826e-e9fd3c8efeb6\', \'multiverseId\': 187680}, \'multiverseid\': 187680}, {\'name\': \'Obelisco de Esper\', \'text\': \'{T}: Agrega {W}, {U}, o {B} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Es un monumento austero, implacable e inescrutable como el mismo Esper.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187929&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'784adf1e-6c60-4fb5-baef-3d94782d2399\', \'multiverseId\': 187929}, \'multiverseid\': 187929}, {\'name\': "Obélisque d\'Esper", \'text\': \'{T} : Ajoutez {W}, {U} ou {B} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "C\'est un monument aussi austère, inébranlable et inscrutable qu\'Esper.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188676&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3a5bc6cf-5e84-4b31-ac71-d77d98fdb8b3\', \'multiverseId\': 188676}, \'multiverseid\': 188676}, {\'name\': \'Obelisco di Esper\', \'text\': \'{T}: Aggiungi {W}, {U} o {B} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': "E\' un monumento austero, inflessibile e imperscrutabile come lo stesso Esper.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188427&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9d4f441-c79a-4959-960c-cd1aa0d32e85\', \'multiverseId\': 188427}, \'multiverseid\': 188427}, {\'name\': \'エスパーのオベリスク\', \'text\': \'{T}：あなたのマナ・プールに{W}か{U}か{B}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'それはエスパーと同じぐらい、飾り気なく、断固として、不可解だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187182&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75b8cd5b-7ad7-40e9-b3d6-7cf392c5ce41\', \'multiverseId\': 187182}, \'multiverseid\': 187182}, {\'name\': \'Obelisco de Esper\', \'text\': \'{T}: Adicione {W}, {U} ou {B} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'É um monumento tão austero, inflexível e inescrutável quando a própria Esper.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188178&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dca473c3-76a2-4446-ada9-99971e51b86b\', \'multiverseId\': 188178}, \'multiverseid\': 188178}, {\'name\': \'Обелиск Эспера\', \'text\': \'{T}: добавьте {W}, {U} или {B} в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'Это такой же суровый, жесткий и непостижимый монумент, как и сам Эспер.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188925&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce7608ae-b748-4597-b53d-6b23e71638cd\', \'multiverseId\': 188925}, \'multiverseid\': 188925}, {\'name\': \'艾斯波碑\', \'text\': \'{T}：加{W}，{U}，或{B}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'此碑象征了严峻，执拗与深沉，正如同艾斯波本身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187431&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7eba24f-9745-4c88-b994-b8eb3d4d4456\', \'multiverseId\': 187431}, \'multiverseid\': 187431}]', '[{\'name\': \'Obelisk von Grixis\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {U}, {B} oder {R}.\', \'type\': \'Artefakt\', \'flavor\': \'Wie die meisten Besonderheiten von Grixis sind auch die Obelisken Überreste aus der Zeit von Alara und existieren jetzt nur noch zur Ausbeutung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187681&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad346094-b759-4766-87bb-93bb83976c7a\', \'multiverseId\': 187681}, \'multiverseid\': 187681}, {\'name\': \'Obelisco de Grixis\', \'text\': \'{T}: Agrega {U}, {B}, o {R} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Como la mayoría de las cosas en Grixis, los obeliscos que quedan del tiempo de Alara ahora existen para un provecho siniestro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187930&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f472ea28-935e-41c9-b8ab-e33415418a2c\', \'multiverseId\': 187930}, \'multiverseid\': 187930}, {\'name\': \'Obélisque de Grixis\', \'text\': \'{T} : Ajoutez {U}, {B} ou {R} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Comme beaucoup d\'éléments sur Grixis, les obélisques restants de l\'époque d\'Alara ne servent plus qu\'à des desseins néfastes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188677&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4a6bc9b6-f979-45da-92c0-b14ab46a8deb\', \'multiverseId\': 188677}, \'multiverseid\': 188677}, {\'name\': \'Obelisco di Grixis\', \'text\': \'{T}: Aggiungi {U}, {B} o {R} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Come molte delle attrattive di Grixis, gli obelischi che rimangono dai tempi di Alara ora esistono solo per un oscuro sfruttamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188428&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ccb4085-521b-43dc-bfd4-32115f496745\', \'multiverseId\': 188428}, \'multiverseid\': 188428}, {\'name\': \'グリクシスのオベリスク\', \'text\': \'{T}：あなたのマナ・プールに{U}か{B}か{R}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'グリクシスの特徴と同様に、そのオベリスクもアラーラの頃から存在しているが、今では闇のシンボルでしかない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187183&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7dfb5b9b-fb3f-4170-afbc-d6dec5b42ad5\', \'multiverseId\': 187183}, \'multiverseid\': 187183}, {\'name\': \'Obelisco de Grixis\', \'text\': \'{T}: Adicione {U}, {B} ou {R} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Assim como quase tudo em Grixis, os obeliscos remanescentes da era de Alara agora servem apenas para fins malignos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188179&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5edf911a-59af-4c0a-96a6-8feead48260c\', \'multiverseId\': 188179}, \'multiverseid\': 188179}, {\'name\': \'Обелиск Гриксиса\', \'text\': \'{T}: добавьте {U}, {B} или {R} в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'Как и большинство элементов Гриксиса, оставшиеся со времен Алары обелиски служат теперь только темным целям.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188926&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28ba4423-047f-4ec5-ae7e-06c0d0218d03\', \'multiverseId\': 188926}, \'multiverseid\': 188926}, {\'name\': \'格利极碑\', \'text\': \'{T}：加{U}，{B}，或{R}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'正如格利极的大部分东西，此碑是从阿拉若的时代留存至今，现在却只被利用来行使黑暗意图。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187432&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e9caaf9-c565-4e6f-a6ab-db9a5ed32860\', \'multiverseId\': 187432}, \'multiverseid\': 187432}]', '[{\'name\': \'Obelisk von Jund\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {B},{R} oder {G}.\', \'type\': \'Artefakt\', \'flavor\': \'Vulkanische Aschenwinde schleifen ihn, Kletterranken überwuchern ihn, Drachenfeuer verbrennt ihn, und immer noch steht er als Zeugnis einer vergessenen Welt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187682&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d27a2923-0a24-4091-a24e-513c31aedb2b\', \'multiverseId\': 187682}, \'multiverseid\': 187682}, {\'name\': \'Obelisco de Jund\', \'text\': \'{T}: Agrega {B}, {R}, o {G} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Los vientos volcánicos los azotan, las viñas los atoran, el fuego de los dragones los quema, y sin embargo allí están, como testimonio de un mundo olvidado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187931&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b5988d7e-e442-4fca-a7bf-eaa7f2dc60b7\', \'multiverseId\': 187931}, \'multiverseid\': 187931}, {\'name\': \'Obélisque de Jund\', \'text\': \'{T} : Ajoutez {B}, {R} ou {G} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Il est battu par les vents de cendre, recouvert de lianes grimpantes, grillé par le feu des dragons et pourtant, il reste érigé, testament d\'un monde oublié.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188678&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c220b08c-c8a5-4c38-8849-ef915df36d20\', \'multiverseId\': 188678}, \'multiverseid\': 188678}, {\'name\': \'Obelisco di Jund\', \'text\': \'{T}: Aggiungi {B}, {R} o {G} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Venti carichi di cenere vulcanica lo sferzano, rampicanti soffocanti lo aggrediscono, il fuoco dei draghi lo arrostisce, eppure rimane in piedi come testamento di un mondo dimenticato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188429&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79d1ad2c-29c9-4b04-952f-0e1cc706a3c4\', \'multiverseId\': 188429}, \'multiverseid\': 188429}, {\'name\': \'ジャンドのオベリスク\', \'text\': \'{T}：あなたのマナ・プールに{B}か{R}か{G}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'火山の灰交じりの風が叩き、蔦がその表面を覆い、竜が炎で焼き尽くしても、それは忘れられた世界の証拠として建ち続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187184&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87b04480-13a7-4560-a3ec-11f7b4fbce9e\', \'multiverseId\': 187184}, \'multiverseid\': 187184}, {\'name\': \'Obelisco de Jund\', \'text\': \'{T}: Adicione {B}, {R} ou {G} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Mesmo assolado por ventos de cinzas vulcânicas, devorado por vinhas asfixiantes e tostado pelo fogo de dragões, ele permanece em pé, como testemunho de um mundo esquecido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188180&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21b6fae4-ad8f-4fae-b4bc-2d272b8aabe5\', \'multiverseId\': 188180}, \'multiverseid\': 188180}, {\'name\': \'Обелиск Джанда\', \'text\': \'{T}: добавьте {B}, {R} или {G} в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'Его обдувают суровые ветра, разносящие вулканический пепел, его оплетают ползучие лианы, его обугливает огненное дыхание дракона, и все же он стоит, словно памятник забытому миру.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188927&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7f301877-8049-4c1e-a12b-6f4046154f11\', \'multiverseId\': 188927}, \'multiverseid\': 188927}, {\'name\': \'勇得碑\', \'text\': \'{T}：加{B}，{R}，或{G}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'历经火山酸风拍打，爬行藤蔓覆盖，巨龙火焰烧灼，它始终屹立不摇，代表属于某个遗忘世界的试炼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187433&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0b9e0091-abfe-497d-a65e-4e3c25ba8999\', \'multiverseId\': 187433}, \'multiverseid\': 187433}]', '[{\'name\': \'Obelisk von Naya\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {R}, {G} oder {W}.\', \'type\': \'Artefakt\', \'flavor\': \'Jahrhunderte sind vergangen, seit die Welt zerbrochen ist, doch die Obelisken auf allen Fragmenten dienen ergeben ihrem schon lange vergessenen Zweck.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187683&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd7ff319-39be-4c96-b3d8-48fb4a726251\', \'multiverseId\': 187683}, \'multiverseid\': 187683}, {\'name\': \'Obelisco de Naya\', \'text\': \'{T}: Agrega {R}, {G}, o {W} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Pasaron siglos desde que el plano se fragmentó, pero los obeliscos de cada fragmento todavía sirven a su antiguo propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187932&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'177e5334-09c9-4a81-81ae-6d3c4ffe66bd\', \'multiverseId\': 187932}, \'multiverseid\': 187932}, {\'name\': \'Obélisque de Naya\', \'text\': \'{T} : Ajoutez {R}, {G} ou {W} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "Des siècles se sont écoulés depuis l\'éclatement du plan, et pourtant les obélisques de chaque éclat remplissent toujours leur rôle oublié.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f64583be-9760-4f77-b8ab-0f9b846c83cb\', \'multiverseId\': 188679}, \'multiverseid\': 188679}, {\'name\': \'Obelisco di Naya\', \'text\': \'{T}: Aggiungi {R}, {G} o {W} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': \'Ormai sono trascorsi secoli da quando il piano è andato in pezzi, eppure gli obelischi di ogni frammento servono fedelmente il loro scopo da tempo dimenticato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188430&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'448b1dae-ad83-410f-8065-91ee40487fc1\', \'multiverseId\': 188430}, \'multiverseid\': 188430}, {\'name\': \'ナヤのオベリスク\', \'text\': \'{T}：あなたのマナ・プールに{R}か{G}か{W}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'次元が砕けてから数世紀がたつが、オベリスクはそれぞれの断片の中で、忘れ去られた目的を守り続けている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187185&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9011b56b-37d8-4c00-abbb-68ef5a858d37\', \'multiverseId\': 187185}, \'multiverseid\': 187185}, {\'name\': \'Obelisco de Naya\', \'text\': \'{T}: Adicione {R}, {G} ou {W} à sua reserva de mana.\', \'type\': \'Artefato\', \'flavor\': \'Séculos se passaram desde que o plano se fragmentou, mas os obeliscos de cada fragmento ainda cumprem seu há muito esquecido propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188181&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f2a5e79c-a921-4698-aaea-a0db2b1c8e6d\', \'multiverseId\': 188181}, \'multiverseid\': 188181}, {\'name\': \'Обелиск Найи\', \'text\': \'{T}: добавьте {R}, {G} или {W} в ваше хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': \'С момента раскола единого мира прошли целые века, и все же обелиски каждого осколка продолжают верно служить своей давно позабытой цели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188928&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'597bce94-78e3-4e04-8944-13ff19c1c569\', \'multiverseId\': 188928}, \'multiverseid\': 188928}, {\'name\': \'纳雅碑\', \'text\': \'{T}：加{R}，{G}，或{W}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'时空分裂已历经数百年，而每个断片的石碑依旧忠实地执行那早遭遗忘的任务。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187434&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7b14f3cc-e5ec-4a37-90b4-2b49002a2091\', \'multiverseId\': 187434}, \'multiverseid\': 187434}]', '[{\'name\': \'Oberherr der Höllendrachen\', \'text\': \'Fliegend, verursacht Trampelschaden, Eile\\n{R}: Der Oberherr der Höllendrachen erhält +1/+0 bis zum Ende des Zuges.\\n{B}{G}: Regeneriere den Oberherrn der Höllendrachen.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'„Der Drache muss kein Mitleid heischen, keine falsche Maske der Zivilisation tragen — er besteht nur aus Hunger, Hitze und Bedürfnissen." —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187639&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b2bf2ae-df2a-44b3-a9f6-fed57a67d0ab\', \'multiverseId\': 187639}, \'multiverseid\': 187639}, {\'name\': \'Engendro supremo\', \'text\': \'Vuela, arrolla, prisa.\\n{R}: El Engendro supremo obtiene +1/+0 hasta el final del turno.\\n{B}{G}: Regenera el Engendro supremo.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'"El dragón no muestra compasión ni una máscara de civilidad: es hambre, calor y deseo." —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187888&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8eaf1b1b-76cb-4703-90ad-8b1fd7a85f1a\', \'multiverseId\': 187888}, \'multiverseid\': 187888}, {\'name\': \'Suzerain escouflenfer\', \'text\': "Vol, piétinement, célérité\\n{R} : Le Suzerain escouflenfer gagne +1/+0 jusqu\'à la fin du tour.\\n{B}{G} : Régénérez le Suzerain escouflenfer.", \'type\': \'Créature : dragon\', \'flavor\': "« Le dragon a nulle prétention de compassion, nul masque de civilisation — il n\'est que faim, chaleur et désir. » —Sarkhan Vol", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188635&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5480115a-8699-4276-9a81-c53e3e6cdd6d\', \'multiverseId\': 188635}, \'multiverseid\': 188635}, {\'name\': \'Signore Supremo dei Nibbi Infernali\', \'text\': \'Volare, travolgere, rapidità\\n{R}: Il Signore Supremo dei Nibbi Infernali prende +1/+0 fino alla fine del turno.\\n{B}{G}: Rigenera il Signore Supremo dei Nibbi Infernali.\', \'type\': \'Creatura — Drago\', \'flavor\': \'"Il drago non ha pretese di compassione, né una falsa maschera di civiltà: solo fame, calore e necessità." —Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188386&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4086ee54-d669-48e7-a9b1-90ff861e1682\', \'multiverseId\': 188386}, \'multiverseid\': 188386}, {\'name\': \'ヘルカイトの首領\', \'text\': \'飛行、トランプル、速攻\\n{R}：ヘルカイトの首領はターン終了時まで＋１/＋０の修整を受ける。\\n{B}{G}：ヘルカイトの首領を再生する。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'「竜には見せかけの慈悲も、上っ面の上品さの仮面もない――飢えて、燃え盛り、求めているだけだ。」 ――サルカン・ヴォル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187141&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1aaf679-64a9-418f-98c8-1e53c7d87ded\', \'multiverseId\': 187141}, \'multiverseid\': 187141}, {\'name\': \'Soberano Dragão Avérneo\', \'text\': \'Voar, atropelar, ímpeto\\n{R}: Soberano Dragão Avérneo recebe +1/+0 até o final do turno.\\n{B}{G}: Regenere Soberano Dragão Avérneo.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'"O dragão não simula ter compaixão ou uma máscara falsa de civilidade tem apenas fome, calor e necessidade." — Sarkhan Vol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188137&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e685492-cf34-48bf-9f20-cc727a42fb4d\', \'multiverseId\': 188137}, \'multiverseid\': 188137}, {\'name\': \'Змей-Повелитель\', \'text\': \'Полет, Пробивной удар, Ускорение\\n{R}: Змей-Повелитель получает +1/+0 до конца хода.\\n{B}{G}: регенерируйте Змея-Повелителя.\', \'type\': \'Существо — Дракон\', \'flavor\': \'«Дракону чуждо притворное сострадание, лживая маска цивилизованности есть только голод, жар и потребность». — Сархан Воль\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188884&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41789c7a-9b57-44f4-94e8-3c124114bbe4\', \'multiverseId\': 188884}, \'multiverseid\': 188884}, {\'name\': \'王龙残虐者\', \'text\': \'飞行，践踏，敏捷\\n{R}：王龙残虐者得+1/+0直到回合结束。\\n{B}{G}：重生王龙残虐者.\', \'type\': \'生物～龙\', \'flavor\': \'「龙不会假装慈悲，也从不戴上文明的虚伪面具～只有饥渴，火热，与需要。」 ～萨坎沃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187390&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'691f4ad0-3539-49b3-8301-280b5846a333\', \'multiverseId\': 187390}, \'multiverseid\': 187390}]', '[{\'name\': \'Onyxpokal\', \'text\': \'{T}: Ein Spieler deiner Wahl verliert 1 Lebenspunkt.\', \'type\': \'Artefakt\', \'flavor\': \'Der Pokal war ein Geschenk der Sphinx Gorael, die hoffte, dass Menschen und Vedalken sich im Kampf darum gegenseitig vernichten und Esper den Sphingen überlassen würden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187548&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'50337bcb-5f37-4d1f-a454-daaf0e5b378a\', \'multiverseId\': 187548}, \'multiverseid\': 187548}, {\'name\': \'Cáliz de ónix\', \'text\': \'{T}: El jugador objetivo pierde 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'El cáliz fue un regalo de la esfinge Gorael, quien tenía la esperanza que humanos y vedalken se destruyeran mutuamente para obtenerlo, liberando Esper para sus congéneres.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187797&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7713a3ca-f725-45c7-aed5-9f0dc5a7c1fb\', \'multiverseId\': 187797}, \'multiverseid\': 187797}, {\'name\': "Gobelet d\'onyx", \'text\': \'{T} : Le joueur ciblé perd 1 point de vie.\', \'type\': \'Artefact\', \'flavor\': "Le gobelet était un cadeau de Gorael la sphinge, qui espérait que les humains et les vedalkens se détruiraient les uns les autres pour l\'acquérir, laissant Esper aux siens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188544&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c31c4fa7-8bdd-4806-ad5d-92de7a41b6d4\', \'multiverseId\': 188544}, \'multiverseid\': 188544}, {\'name\': "Calice d\'Onice", \'text\': \'{T}: Un giocatore bersaglio perde 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'Il calice era un regalo della sfinge Gorael, che sperava che gli umani e i vedalken alla fine si distruggessero a vicenda per conquistarlo, lasciando tutto Esper alla sua specie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188295&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e8bf0e4-2f6b-4559-a77b-d41c8eea88cd\', \'multiverseId\': 188295}, \'multiverseid\': 188295}, {\'name\': \'縞瑪瑙のゴブレット\', \'text\': \'{T}：プレイヤー１人を対象とする。そのプレイヤーは１点のライフを失う。\', \'type\': \'アーティファクト\', \'flavor\': \'このゴブレットは、スフィンクスのゴリアルからの授かり物だ。彼女は人間とヴィダルケンが互いを従えるべく争いあって滅び、エスパーを自身のものとすることを願っていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187050&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79ca4f68-c4d1-460d-873d-ea8a141429a9\', \'multiverseId\': 187050}, \'multiverseid\': 187050}, {\'name\': \'Cálice de Ônix\', \'text\': \'{T}: O jogador alvo perde 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'O cálice era um presente da esfinge Gorael, na esperança de que um dia os humanos e os vedalkeanos destruiríam-se uns aos outros para possuí-lo, deixando toda Esper para os da sua espécie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188046&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'316aae55-c2ce-4b34-9662-0645ec2812cb\', \'multiverseId\': 188046}, \'multiverseid\': 188046}, {\'name\': \'Ониксовый Кубок\', \'text\': \'{T}: целевой игрок теряет 1 жизнь.\', \'type\': \'Артефакт\', \'flavor\': \'Этот кубок был даром сфинкса Гореаль, которая надеялась, что люди и ведалкены в конце концов уничтожат друг друга ради обладания им, оставив весь Эспер ей подобным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188793&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce9097bb-326a-4bde-ad87-c76dbd50cf81\', \'multiverseId\': 188793}, \'multiverseid\': 188793}, {\'name\': \'玛瑙酒杯\', \'text\': \'{T}：目标牌手失去1点生命。\', \'type\': \'神器\', \'flavor\': \'这酒杯是史芬斯格瑞儿的赠礼，希望人类与维多肯能为争夺它而互相毁灭，让艾斯波只剩下她的族人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187299&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9da1d78f-7155-4dbc-96a9-73e38a02bb36\', \'multiverseId\': 187299}, \'multiverseid\': 187299}]', '[{\'name\': \'Panorama von Bant\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere das Panorama von Bant: Durchsuche deine Bibliothek nach einem Standardwald, einer Standardebene oder einer Standardinsel und bringe das Land getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Die Herzen in Bant sind so rein wie die Luft und so hell wie der Himmel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ba99c7cd-ead6-4105-aea8-8e700d68639f\', \'multiverseId\': 187688}, \'multiverseid\': 187688}, {\'name\': \'Panorama de Bant\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar el Panorama de Bant: Busca en tu biblioteca una carta de bosque, llanura o isla básica y ponla en juego girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Los corazones de Bant son puros como su aire y brillantes como sus cielos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187937&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5da10173-082e-4628-9bc7-d82b1b2e3540\', \'multiverseId\': 187937}, \'multiverseid\': 187937}, {\'name\': \'Panorama de Bant\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez le Panorama de Bant : Cherchez dans votre bibliothèque une carte de base de forêt, de plaine ou d\'île et mettez-la en jeu engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': \'Les cœurs de Bant sont aussi purs que son air et aussi limpides que ses cieux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188684&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15284cb5-48eb-4076-b0a5-04d68426e328\', \'multiverseId\': 188684}, \'multiverseid\': 188684}, {\'name\': \'Panorama di Bant\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica il Panorama di Bant: Passa in rassegna il tuo grimorio per una carta Foresta, Pianura o Isola base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'I cuori di Bant sono puri come la sua aria e luminosi come i suoi cieli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188435&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5c2e146-3b1c-4ab4-b01a-5ae0f12b48e3\', \'multiverseId\': 188435}, \'multiverseid\': 188435}, {\'name\': \'バントの全景\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, バントの全景を生け贄に捧げる：あなたのライブラリーから基本森カード１枚か基本平地カード１枚か基本島カード１枚を探し、それをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'バントの中心は、その空気と同じぐらい清らかで、その空と同じぐらい明るい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187190&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef08ef0d-9fce-4382-9b27-efebc83a6efd\', \'multiverseId\': 187190}, \'multiverseid\': 187190}, {\'name\': \'Panorama de Bant\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}, Sacrifique Panorama de Bant: Procure em seu grimório por um card de terreno básico do tipo Floresta, Planície ou Ilha e coloque-o em jogo virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Os corações de Bant são tão puros quanto seu ar, tão límpidos quanto seus céus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188186&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d97c9961-660f-43ad-8d15-b5f683e5db2b\', \'multiverseId\': 188186}, \'multiverseid\': 188186}, {\'name\': \'Панорама Бэнта\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{1}, {T}, пожертвуйте Панораму Бэнта: найдите в вашей библиотеке карту базового Леса, Равнины или Острова и положите ее в игру повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'Сердца Бэнта чисты, как его воздух, и светлы, как его небо.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188933&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ff7b8ace-5222-4dd5-bd9b-23551f724aab\', \'multiverseId\': 188933}, \'multiverseid\': 188933}, {\'name\': \'班特全景\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲班特全景：从你的牌库中搜寻一张基本的树林，平原，或海岛牌，并将之横置进场。 然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'班特的心思如空气纯净，似天空明亮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187439&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'914995ee-fc08-4d15-b073-d379c881c08e\', \'multiverseId\': 187439}, \'multiverseid\': 187439}]', '[{\'name\': \'Panorama von Esper\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere das Panorama von Esper: Durchsuche deine Bibliothek nach einer Standardebene, einer Standardinsel oder einem Standardsumpf und bringe das Land getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Esper ist wie eine riesige Leinwand, die von genauen, kontrollierenden Händen bemalt wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8161e71c-abad-4b9b-9757-2a3c540a7379\', \'multiverseId\': 187690}, \'multiverseid\': 187690}, {\'name\': \'Panorama de Esper\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar el Panorama de Esper: Busca en tu biblioteca una carta de llanura, isla o pantano básica y ponla en juego girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Esper es una tela pintada por manos controladoras y precisas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187939&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06b22b97-b3a4-4ece-8ae4-c5ec1745dae9\', \'multiverseId\': 187939}, \'multiverseid\': 187939}, {\'name\': "Panorama d\'Esper", \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez le Panorama d\'Esper : Cherchez dans votre bibliothèque une carte de base de plaine, d\'île ou de marais et mettez-la en jeu engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': \'Esper est une toile immense peinte par des mains précises et expertes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188686&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bcde24b-3452-41ee-a069-9c544459bf97\', \'multiverseId\': 188686}, \'multiverseid\': 188686}, {\'name\': \'Panorama di Esper\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica il Panorama di Esper: Passa in rassegna il tuo grimorio per una carta Pianura, Isola o Palude base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Esper è una vasta tela dipinta da mani precise e dominanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188437&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f37632b2-9913-4ce1-bd69-e838189e2b29\', \'multiverseId\': 188437}, \'multiverseid\': 188437}, {\'name\': \'エスパーの全景\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, エスパーの全景を生け贄に捧げる：あなたのライブラリーから基本平地カード１枚か基本島カード１枚か基本沼カード１枚を探し、それをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'エスパーは緻密に統制された手で塗られている、広がりゆくキャンバスだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187192&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'342c62eb-fe22-4161-bf9b-07859aff3b58\', \'multiverseId\': 187192}, \'multiverseid\': 187192}, {\'name\': \'Panorama de Esper\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}, Sacrifique Panorama de Esper: Procure em seu grimório por um card de terreno básico do tipo Planície, Ilha ou Pântano e coloque-o em jogo virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Esper é uma tela expansiva pintada por mãos precisas e controladoras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188188&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'43c884ed-a5f8-4a44-84cc-cafec660e5c6\', \'multiverseId\': 188188}, \'multiverseid\': 188188}, {\'name\': \'Панорама Эспера\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{1}, {T}, пожертвуйте Панораму Эспера: найдите в вашей библиотеке карту базовой Равнины, Острова или Болота и положите ее в игру повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'Эспер это широкое полотно, написанное точными и властными руками.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188935&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d86db9e-838b-4bd8-a21d-ff5eddd5f43d\', \'multiverseId\': 188935}, \'multiverseid\': 188935}, {\'name\': \'艾斯波全景\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲艾斯波全景：从你的牌库中搜寻一张基本的平原，海岛，或沼泽牌，并将之横置进场。 然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'艾斯波有如块广大帆布，由精细而全面控制的手上色。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187441&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'94ee09d1-3b67-40e6-b4a6-7ca8e81458ba\', \'multiverseId\': 187441}, \'multiverseid\': 187441}]', '[{\'name\': \'Panorama von Grixis\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere das Panorama von Grixis: Durchsuche deine Bibliothek nach einer Standardinsel, einem Standardsumpf oder einem Standardgebirge und bringe das Land getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Es gibt keine Erhöhung in Grixis, auf der man dem Gestank des Todes entgehen könnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187691&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2d1ac99f-1501-434d-a3e8-ece6c9f61237\', \'multiverseId\': 187691}, \'multiverseid\': 187691}, {\'name\': \'Panorama de Grixis\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar el Panorama de Grixis: Busca en tu biblioteca una carta de isla, pantano o montaña básica y ponla en juego girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'No hay ningún pico en Grixis a salvo del hedor de la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8a7f97f-4280-419a-a8d5-80727fb86cab\', \'multiverseId\': 187940}, \'multiverseid\': 187940}, {\'name\': \'Panorama de Grixis\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez le Panorama de Grixis : Cherchez dans votre bibliothèque une carte de base d\'île, de marais ou de montagne et mettez-la en jeu engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': "Même le ciel au-dessus de Grixis n\'échappe pas à la puanteur de la mort.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b5bec1f-8246-422b-bc42-4caae34f4678\', \'multiverseId\': 188687}, \'multiverseid\': 188687}, {\'name\': \'Panorama di Grixis\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica il Panorama di Grixis: Passa in rassegna il tuo grimorio per una carta Isola, Palude o Montagna base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Non ci sono alture sopra Grixis che è priva del fetore della morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188438&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a26d0dbd-9f36-4677-8caf-653dba36d121\', \'multiverseId\': 188438}, \'multiverseid\': 188438}, {\'name\': \'グリクシスの全景\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, グリクシスの全景を生け贄に捧げる：あなたのライブラリーから基本島カード１枚か基本沼カード１枚か基本山カード１枚を探し、それをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'グリクシスには、死の臭いから逃れえる高みなど存在しない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187193&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1acb14f0-db10-4d21-9938-1ce114c7616f\', \'multiverseId\': 187193}, \'multiverseid\': 187193}, {\'name\': \'Panorama de Grixis\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}, Sacrifique Panorama de Grixis: Procure em seu grimório por um card de terreno básico do tipo Ilha, Pântano ou Montanha e coloque-o em jogo virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Não há altura acima de Grixis que esteja livre do fedor da morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188189&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac5d49ba-6d21-41bc-838a-f608f462f031\', \'multiverseId\': 188189}, \'multiverseid\': 188189}, {\'name\': \'Панорама Гриксиса\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{1}, {T}, пожертвуйте Панораму Гриксиса: найдите в вашей библиотеке карту базового Острова, Болота или Горы и положите ее в игру повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'Как бы высоко ты не поднялся над Гриксисом, ты всегда будешь чувствовать зловоние смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188936&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc8209a0-d9d5-44fa-af59-169acc737447\', \'multiverseId\': 188936}, \'multiverseid\': 188936}, {\'name\': \'格利极全景\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲格利极全景：从你的牌库中搜寻一张基本的海岛，沼泽，或山脉牌，并将之横置进场。 然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'格利极没有一块能让你摆脱死亡气息的高地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187442&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e70c1a33-2af6-4fe1-a445-13e8a300da37\', \'multiverseId\': 187442}, \'multiverseid\': 187442}]', "[{'name': 'Panorama von Jund', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere das Panorama von Jund: Durchsuche deine Bibliothek nach einem Standardsumpf, einem Standardgebirge oder einem Standardwald und bringe das Land getappt ins Spiel. Mische danach deine Bibliothek.', 'type': 'Land', 'flavor': 'Der Himmel ist der Thron des Drachens, von wo aus er seine flammenden Anweisungen gibt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187692&type=card', 'language': 'German', 'identifiers': {'scryfallId': '29a3db55-60b0-4af5-ada4-1378357888ef', 'multiverseId': 187692}, 'multiverseid': 187692}, {'name': 'Panorama de Jund', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar el Panorama de Jund: Busca en tu biblioteca una carta de pantano, montaña o bosque básica y ponla en juego girada. Luego baraja tu biblioteca.', 'type': 'Tierra', 'flavor': 'El cielo es el trono del dragón, desde donde dicta su decretos ígneos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187941&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3e6e3dc8-1ffe-4e6f-99ad-8ff22595077e', 'multiverseId': 187941}, 'multiverseid': 187941}, {'name': 'Panorama de Jund', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez le Panorama de Jund : Cherchez dans votre bibliothèque une carte de base de marais, de montagne ou de forêt et mettez-la en jeu engagée. Mélangez ensuite votre bibliothèque.', 'type': 'Terrain', 'flavor': 'Le ciel est le trône du dragon, le siège depuis lequel il impose ses lois incendiaires.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188688&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'eab6eda3-7d17-4674-abb8-bb2c3f56400d', 'multiverseId': 188688}, 'multiverseid': 188688}, {'name': 'Panorama di Jund', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica il Panorama di Jund: Passa in rassegna il tuo grimorio per una carta Palude, Montagna o Foresta base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.', 'type': 'Terra', 'flavor': 'Il cielo è il trono del drago, il posto in cui emana i suoi decreti infuocati.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188439&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '89106fe4-7651-4838-8f9f-9770c6e693bd', 'multiverseId': 188439}, 'multiverseid': 188439}, {'name': 'ジャンドの全景', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, ジャンドのの全景を生け贄に捧げる：あなたのライブラリーから基本沼カード１枚か基本山カード１枚か基本森カード１枚を探し、それをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。', 'type': '土地', 'flavor': '空は竜の王宮であり、炎の命じを下す玉座である。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187194&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9ada9bea-1ee0-44dc-8b5e-c63ed7890fb4', 'multiverseId': 187194}, 'multiverseid': 187194}, {'name': 'Panorama de Jund', 'text': '{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}, Sacrifique Panorama de Jund: Procure em seu grimório por um card de terreno básico do tipo Pântano, Montanha ou Floresta e coloque-o em jogo virado. Depois, embaralhe seu grimório.', 'type': 'Terreno', 'flavor': 'O céu é o trono do dragão, o assento do qual lança seus decretos flamejantes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188190&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c0eb0fc1-4170-483f-a544-d774d45e84f0', 'multiverseId': 188190}, 'multiverseid': 188190}, {'name': 'Панорама Джанда', 'text': '{T}: добавьте {1} в ваше хранилище маны.\\n{1}, {T}, пожертвуйте Панораму Джанда: найдите в вашей библиотеке карту базового Болота, Горы или Леса и положите ее в игру повернутой. Затем перетасуйте вашу библиотеку.', 'type': 'Земля', 'flavor': 'Небо это трон дракона, чертог, из которого он издает свои огненные указы.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188937&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0cf037bd-35ff-4290-8e7b-22763b8b2979', 'multiverseId': 188937}, 'multiverseid': 188937}, {'name': '勇得全景', 'text': '{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲勇得全景：从你的牌库中搜寻一张基本的沼泽，山脉，或树林牌，并将之横置进场。 然后将你的牌库洗牌。', 'type': '地', 'flavor': '天空是龙的王座，他在该处宣布火热裁决。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187443&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1467632e-3bb4-4e21-abc2-b914ae34b5fb', 'multiverseId': 187443}, 'multiverseid': 187443}]", '[{\'name\': \'Panorama von Naya\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere das Panorama von Naya: Durchsuche deine Bibliothek nach einem Standardgebirge, einem Standardwald oder einer Standardebene und bringe das Land getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Zwischen den donnernden Schritten der Behemoths von Naya herrscht immer einen Augenblick lang perfekte Stille.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a76625c-ef41-4aaf-bcbd-1ff6e4d4e0ec\', \'multiverseId\': 187694}, \'multiverseid\': 187694}, {\'name\': \'Panorama de Naya\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar el Panorama de Naya: Busca en tu biblioteca una carta de montaña, bosque o llanura básica y ponla en juego girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Entre los estruendosos pisotones de los behemots de Naya hay momentos de perfecta calma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187943&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2ece712-2155-4869-a1b9-a284941bf905\', \'multiverseId\': 187943}, \'multiverseid\': 187943}, {\'name\': \'Panorama de Naya\', \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez le Panorama de Naya : Cherchez dans votre bibliothèque une carte de base de montagne, de forêt ou de plaine et mettez-la en jeu engagée. Mélangez ensuite votre bibliothèque.\', \'type\': \'Terrain\', \'flavor\': "Le tonnerre des pas des béhémoths de Naya est entrecoupé d\'instants de silence parfait.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188690&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbe73de8-9511-4ed1-9309-729a3f114eee\', \'multiverseId\': 188690}, \'multiverseid\': 188690}, {\'name\': \'Panorama di Naya\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica il Panorama di Naya: Passa in rassegna il tuo grimorio per una carta Montagna, Foresta o Pianura base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Tra i fragorosi passi dei behemoth di Naya si trovano momenti di quiete perfetta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188441&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'19e93827-0a3c-4736-aebc-c4ec952693c1\', \'multiverseId\': 188441}, \'multiverseid\': 188441}, {\'name\': \'ナヤの全景\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, ナヤの全景を生け贄に捧げる：あなたのライブラリーから基本山カード１枚か基本森カード１枚か基本平地カード１枚を探し、それをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'ナヤのビヒモスの轟くような足音の合間には、完璧な静寂の瞬間がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187196&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4633ff2c-1b0e-47b7-88df-b098e84cda2b\', \'multiverseId\': 187196}, \'multiverseid\': 187196}, {\'name\': \'Panorama de Naya\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}, Sacrifique Panorama de Naya: Procure em seu grimório por um card de terreno básico do tipo Montanha, Floresta ou Planície e coloque-o em jogo virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Entre os passos estrondosos dos behemoths de Naya, encontram-se momentos de perfeita quietude.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188192&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7282ad24-7311-4e34-a82b-71bb68189247\', \'multiverseId\': 188192}, \'multiverseid\': 188192}, {\'name\': \'Панорама Найи\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{1}, {T}, пожертвуйте Панораму Найи: найдите в вашей библиотеке карту базовой Горы, Леса или Равнины и положите ее в игру повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'В промежутках между громовыми шагами исполинских чудищ Найи наступают моменты абсолютной тишины.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188939&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'26473a14-ab42-48ae-b816-f54858b568a5\', \'multiverseId\': 188939}, \'multiverseid\': 188939}, {\'name\': \'纳雅全景\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲纳雅全景：从你的牌库中搜寻一张基本的山脉，树林，或平原牌，并将之横置进场。 然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'在纳雅的贝西摩斯雷鸣足声间，藏着片刻的纯粹宁静。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187445&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d22b26c0-638d-42c0-a516-b77d33c88fc9\', \'multiverseId\': 187445}, \'multiverseid\': 187445}]', '[{\'name\': \'Prinz der Knechte\', \'text\': \'Immer wenn eine bleibende Karte, die ein Gegner kontrolliert, auf den Friedhof gelegt wird, bringe diese Karte unter deiner Kontrolle ins Spiel zurück, falls dieser Gegner nicht 3 Lebenspunkte bezahlt.\', \'type\': \'Kreatur — Dämon\', \'flavor\': \'„Alles, was lebt, kann ich zerquetschen. Alles, was tot ist, kann ich kontrollieren."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6f49f7a-9338-42f3-a857-0e0294fcf750\', \'multiverseId\': 187649}, \'multiverseid\': 187649}, {\'name\': \'Príncipe de los esclavos\', \'text\': \'Siempre que un permanente que controle un oponente vaya a un cementerio, pon esa carta en juego bajo tu control a menos que ese oponente pague 3 vidas.\', \'type\': \'Criatura — Demonio\', \'flavor\': \'"No hay nadie vivo que no pueda aplastar. No existe ningún muerto que no pueda dominar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187898&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5870de7c-addd-488a-bba9-cf8e063754ad\', \'multiverseId\': 187898}, \'multiverseid\': 187898}, {\'name\': \'Prince des serviteurs\', \'text\': "À chaque fois qu\'un permanent qu\'un adversaire contrôle est mis dans un cimetière, mettez en jeu cette carte sous votre contrôle à moins que cet adversaire ne paie 3 points de vie.", \'type\': \'Créature : démon\', \'flavor\': "« Il n\'y a aucun vivant que je ne puisse écraser. Il n\'y a aucun mort que je ne puisse commander. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aa837ca9-4b34-44ab-b1fe-54aa35391233\', \'multiverseId\': 188645}, \'multiverseid\': 188645}, {\'name\': \'Principe degli Schiavi\', \'text\': "Ogniqualvolta un permanente controllato da un avversario viene messo in un cimitero, metti in gioco quella carta sotto il tuo controllo a meno che quell\'avversario non paghi 3 punti vita.", \'type\': \'Creatura — Demone\', \'flavor\': \'"Non c\\\'è nessuno vivo che io non possa annientare. Non c\\\'è nessuno morto che io non comandi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188396&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9baede74-4ffb-4dda-8b44-743a1ff7296c\', \'multiverseId\': 188396}, \'multiverseid\': 188396}, {\'name\': \'束縛の皇子\', \'text\': \'いずれかの対戦相手がコントロールするパーマネントが１ついずれかの墓地に置かれるたび、その対戦相手が３点のライフを支払わないかぎり、そのカードをあなたのコントロール下で場に出す。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': \'「我に踏み潰せぬもの生者の中に無し。 我の命じを拒めるもの死者の中に無し。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187151&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a1ddcb2-8dc0-42e3-a242-0f25b43b24e2\', \'multiverseId\': 187151}, \'multiverseid\': 187151}, {\'name\': \'Príncipe dos Servos\', \'text\': \'Toda vez que uma permanente que um oponente controla é colocada num cemitério, coloque aquele card em jogo sob o seu controle, a menos que aquele oponente pague 3 pontos de vida.\', \'type\': \'Criatura — Demônio\', \'flavor\': \'"Não há ninguém entre os vivos que eu não possa esmagar. Não há ninguém entre os mortos que eu não possa comandar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188147&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69dd9287-5299-453f-b7e9-07aae7319109\', \'multiverseId\': 188147}, \'multiverseid\': 188147}, {\'name\': \'Князь Порабощенных\', \'text\': \'Каждый раз, когда перманент под контролем оппонента попадает на кладбище, положите ту карту в игру под вашим контролем, если только тот оппонент не заплатит 3 жизни.\', \'type\': \'Существо — Демон\', \'flavor\': \'«Нет живых, которых я не мог бы сокрушить. Нет мертвых, над которыми я был бы не властен».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188894&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55eebf72-258a-4112-9110-e326fda636de\', \'multiverseId\': 188894}, \'multiverseid\': 188894}, {\'name\': \'尸奴王子\', \'text\': \'每当一个由对手操控的永久物置入坟墓场时，除非该对手支付3点生命，否则将该牌在你的操控下放置进场。\', \'type\': \'生物～恶魔\', \'flavor\': \'「所有活物都任我宰割。 所有死物均听我号令。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187400&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3fca979-6947-4463-9e88-b02092dcafad\', \'multiverseId\': 187400}, \'multiverseid\': 187400}]', '[{\'name\': \'Puppenbeschwörer\', \'text\': \'{U}, {T}: Bringe einen 0/1 blauen Homunkulus-Artefaktkreaturenspielstein ins Spiel.\\nOpfere zu Beginn deines Versorgungssegments einen Homunkulus.\', \'type\': \'Artefaktkreatur — Mensch, Zauberer\', \'flavor\': \'Er blickt seine unausgereifte Kreation finster an und zerquetscht sie zu Schrott. Dann rettet er das Ätherium und fängt wieder von vorne an.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f74c86d-996e-4078-8339-52d80e217548\', \'multiverseId\': 187549}, \'multiverseid\': 187549}, {\'name\': \'Conjurador de títeres\', \'text\': \'{U}, {T}: Pon en juego una ficha de criatura artefacto Homúnculo azul 0/1.\\nAl comienzo de tu mantenimiento, sacrifica un Homúnculo.\', \'type\': \'Criatura artefacto — Hechicero humano\', \'flavor\': \'Mira con desdén la creación imperfecta, luego la hace añicos. Rescata el eterium y comienza de nuevo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187798&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b07a589f-8410-489c-a817-d8e97e15c805\', \'multiverseId\': 187798}, \'multiverseid\': 187798}, {\'name\': \'Conjurateur de marionnettes\', \'text\': \'{U}, {T} : Mettez en jeu un jeton de créature-artefact 0/1 bleue Homoncule.\\nAu début de votre entretien, sacrifiez un homoncule.\', \'type\': \'Créature-artefact : humain et sorcier\', \'flavor\': "Il jette un regard de dégoût à sa création imparfaite, puis la réduit en miettes. Il récupère ensuite l\'étherium et recommence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188545&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6e17287e-c131-48f8-9f03-25d330b07ab9\', \'multiverseId\': 188545}, \'multiverseid\': 188545}, {\'name\': \'Evocatore di Burattini\', \'text\': "{U}, {T}: Metti in gioco una pedina creatura artefatto Omuncolo 0/1 blu.\\nAll\'inizio del tuo mantenimento, sacrifica un Omuncolo.", \'type\': \'Creatura Artefatto — Mago Umano\', \'flavor\': "Osserva con sguardo torvo la sua creazione imperfetta, poi la fa a pezzi. Recupera l\'eterium e ricomincia da capo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188296&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4825ccb-d029-4e46-bfe0-f1fbe9893bf9\', \'multiverseId\': 188296}, \'multiverseid\': 188296}, {\'name\': \'くぐつの妖術師\', \'text\': \'{U}, {T}：青の０/１のホムンクルス・アーティファクト・クリーチャー・トークンを１体場に出す。\\nあなたのアップキープの開始時に、ホムンクルスを１つ生け贄に捧げる。\', \'type\': \'アーティファクト・クリーチャー — 人間・ウィザード\', \'flavor\': \'彼は自身の不完全な創造物をねめつけ、叩き潰して鉄くずにする。 彼はそこからエーテリウムを抜き出し、話は始めに戻る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187051&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'137aff88-1988-4218-9abc-b403f822b1d6\', \'multiverseId\': 187051}, \'multiverseid\': 187051}, {\'name\': \'Conjurador de Marionetes\', \'text\': \'{U}, {T}: Coloque em jogo uma ficha de criatura artefato azul 0/1 do tipo Homúnculo.\\nNo início de sua manutenção, sacrifique um Homúnculo.\', \'type\': \'Criatura Artefato — Humano Mago\', \'flavor\': \'Ele olha com desprezo para suas criações imperfeitas, estraçalhando-as em seguida. Então, ele recupera o etherium e começa tudo de novo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188047&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fca25a39-f98d-488b-a6bb-c06b28385fbf\', \'multiverseId\': 188047}, \'multiverseid\': 188047}, {\'name\': \'Заклинатель Кукол\', \'text\': \'{U}, {T}: положите в игру одну фишку артефактного существа 0/1 синий Гомункул.\\nВ начале вашего шага поддержки пожертвуйте Гомункула.\', \'type\': \'Артефактное Существо — Человек Чародей\', \'flavor\': \'Он хмуро смотрит на свое несовершенное творение и разбивает его на куски. Затем он собирает эфирий и начинает все заново.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188794&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f76585f9-4a25-4531-b07a-05d5b6e1c2d0\', \'multiverseId\': 188794}, \'multiverseid\': 188794}, {\'name\': \'傀儡咒法师\', \'text\': \'{U}，{T}：将一个0/1蓝色造妖神器生物衍生物放置进场。\\n在你的维持开始时，牺牲一个造妖。\', \'type\': \'神器生物～人类／法术师\', \'flavor\': \'他对着自己未尽完美的造物皱眉，然后将它砸成废铁。 之后将乙金回收，重新来过。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187300&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d42ebe2-0005-4c9a-bc29-a084d7d449b7\', \'multiverseId\': 187300}, \'multiverseid\': 187300}]', '[{\'name\': \'Rafiq von den Vielen\', \'text\': \'Edelmut (Immer wenn eine Kreatur, die du kontrollierst, alleine angreift, erhält diese Kreatur +1/+1 bis zum Ende des Zuges.)\\nImmer wenn eine Kreatur, die du kontrollierst, alleine angreift, erhält sie Doppelschlag bis zum Ende des Zuges.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': \'Viele Siegel, ein Zweck.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187652&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72069d98-3068-4d9e-beb3-27354a88b351\', \'multiverseId\': 187652}, \'multiverseid\': 187652}, {\'name\': \'Rafiq de los Mil Sellos\', \'text\': \'Exaltado. (Siempre que una criatura que controles ataque sola, esa criatura obtiene +1/+1 hasta el final del turno.)\\nSiempre que una criatura que controles ataque sola, gana la habilidad de dañar dos veces hasta el final del turno.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': \'Muchos sellos, un objetivo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187901&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3b33422-6ee6-480f-b5bf-447885c7f90b\', \'multiverseId\': 187901}, \'multiverseid\': 187901}, {\'name\': \'Rafiq aux Innombrables\', \'text\': "Exaltation (À chaque fois qu\'une créature que vous contrôlez attaque seule, cette créature gagne +1/+1 jusqu\'à la fin du tour.)\\nÀ chaque fois qu\'une créature que vous contrôlez attaque seule, elle acquiert la double initiative jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': \'Multiples sigilles, unique objectif.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188648&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8fa0209a-7e44-4dd9-8d76-89b14d6b4a8d\', \'multiverseId\': 188648}, \'multiverseid\': 188648}, {\'name\': \'Rafiq dei Molti\', \'text\': \'Esaltato (Ogniqualvolta una creatura che controlli attacca da sola, prende +1/+1 fino alla fine del turno.)\\nOgniqualvolta una creatura che controlli attacca da sola, ha doppio attacco fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': \'Molti sigilli, uno scopo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188399&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb863883-d5ca-43d8-b19a-0efbadc6258a\', \'multiverseId\': 188399}, \'multiverseid\': 188399}, {\'name\': \'数多のラフィーク\', \'text\': \'賛美 （あなたがコントロールするいずれかのクリーチャーが単独で攻撃するたび、そのクリーチャーはターン終了時まで＋１/＋１の修整を受ける。）\\nあなたがコントロールするいずれかのクリーチャーが単独で攻撃するたび、それはターン終了時まで二段攻撃を得る。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': \'数多の印章に、一つの目的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187154&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ecf99aa2-2ee4-41b9-a7bd-6b7f6cea3bca\', \'multiverseId\': 187154}, \'multiverseid\': 187154}, {\'name\': \'Rafiq dos Muitos\', \'text\': \'Exaltado (Toda vez que uma criatura que você controla ataca sozinha, ela recebe +1/+1 até o final do turno.)\\nToda vez que uma criatura que você controla ataca sozinha, ela ganha golpe duplo até o final do turno.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': \'Muitas insígnias, um propósito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188150&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d5b25038-ce12-406f-bc68-0fbf8c42b149\', \'multiverseId\': 188150}, \'multiverseid\': 188150}, {\'name\': \'Рафик Многомедальный\', \'text\': \'Повышение (Каждый раз, когда существо под вашим контролем атакует в одиночку, оно получает +1/+1 до конца хода.)\\nКаждый раз, когда существо под вашим контролем атакует в одиночку, оно получает Двойной удар до конца хода.\', \'type\': \'Легендарное Существо — Человек Рыцарь\', \'flavor\': \'Много медалей, одна цель.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188897&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6e5d89f-750e-4322-b68c-869e1328fc21\', \'multiverseId\': 188897}, \'multiverseid\': 188897}, {\'name\': \'千印莱菲\', \'text\': \'颂威 （每当一个由你操控的生物单独攻击时，该生物得+1/+1直到回合结束。）\\n每当一个由你操控的生物单独攻击时，它获得连击异能直到回合结束。\', \'type\': \'传奇生物～人类／骑士\', \'flavor\': \'印记众多，目标唯一。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187403&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4470002f-9b18-4f82-872f-a158f7ceccff\', \'multiverseId\': 187403}, \'multiverseid\': 187403}]', "[{'name': 'Reliquie von Progenitus', 'text': '{T}: Ein Spieler deiner Wahl entfernt eine Karte aus seinem Friedhof ganz aus dem Spiel.\\n{1}, entferne die Reliquie von Progenitus ganz aus dem Spiel: Entferne alle Karten in allen Friedhöfen ganz aus dem Spiel. Ziehe eine Karte.', 'type': 'Artefakt', 'flavor': 'Elfen glauben, dass der Hydragott Progenitus unter Naya schläft und sich von vergessener Magie ernährt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187685&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2651b781-39a5-4c6b-aa4c-fb939a5df66d', 'multiverseId': 187685}, 'multiverseid': 187685}, {'name': 'Reliquia de Progenitus', 'text': '{T}: El jugador objetivo remueve del juego una carta de su cementerio.\\n{1}, remover del juego la Reliquia de Progenitus: Remueve del juego todos los cementerios. Roba una carta.', 'type': 'Artefacto', 'flavor': 'Los elfos creen que el dios hidra Progenitus duerme bajo Naya, alimentándose de la magia olvidada.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187934&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '28c18918-01d0-452b-a205-5aaaf15c0365', 'multiverseId': 187934}, 'multiverseid': 187934}, {'name': 'Relique de Progénitus', 'text': '{T} : Le joueur ciblé retire de la partie une carte de son cimetière.\\n{1}, Retirez la Relique de Progénitus de la partie : Retirez tous les cimetières de la partie. Piochez une carte.', 'type': 'Artefact', 'flavor': 'Les elfes croient que le dieu-hydre Progénitus sommeille sous la surface de Naya, nourri par des magies oubliées.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188681&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cf12004a-8c91-421c-96ea-bc853c5f9687', 'multiverseId': 188681}, 'multiverseid': 188681}, {'name': 'Reliquia del Progenitus', 'text': '{T}: Un giocatore bersaglio rimuove dal gioco una carta nel suo cimitero.\\n{1}, Rimuovi dal gioco la Reliquia del Progenitus: Rimuovi dal gioco tutti i cimiteri. Pesca una carta.', 'type': 'Artefatto', 'flavor': 'Gli elfi credono che il dio-idra Progenitus dorma sotto Naya, nutrendosi di magie dimenticate.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188432&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '81a7e7c9-797d-4a7b-aacc-54314c1a6b29', 'multiverseId': 188432}, 'multiverseid': 188432}, {'name': '大祖始の遺産', 'text': '{T}：プレイヤー１人を対象とする。そのプレイヤーは自分の墓地にあるカードを１枚ゲームから取り除く。\\n{1}, 大祖始の遺産をゲームから取り除く：すべての墓地をゲームから取り除く。 カードを１枚引く。', 'type': 'アーティファクト', 'flavor': 'エルフはハイドラ神である大祖始が、ナヤの地底で忘れられた魔法を餌にしながら眠っていると信じている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187187&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '605dab39-5c20-4133-8434-a27f80afee23', 'multiverseId': 187187}, 'multiverseid': 187187}, {'name': 'Relíquia de Progenitus', 'text': '{T}: O jogador alvo remove de jogo um card de seu próprio cemitério.\\n{1}, Remova Relíquia de Progenitus do jogo: Remova do jogo todos os cemitérios. Compre um card.', 'type': 'Artefato', 'flavor': 'Os elfos acreditam que o deus-hidra Progenitus dorme debaixo de Naya, alimentando-se de magias esquecidas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188183&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b5769070-6fe2-4ec5-b86e-e11a6abb588f', 'multiverseId': 188183}, 'multiverseid': 188183}, {'name': 'Реликт Прародителя', 'text': '{T}: целевой игрок удаляет из игры карту, находящуюся на его кладбище.\\n{1}, удалите Реликт Прародителя из игры: удалите из игры все кладбища. Возьмите карту.', 'type': 'Артефакт', 'flavor': 'Эльфы верят, что в недрах Найи спит и питается забытой магией бог-гидра Прародитель.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188930&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b479df99-7c4c-4242-8275-08541f7dc011', 'multiverseId': 188930}, 'multiverseid': 188930}, {'name': '祖神兽遗宝', 'text': '{T}：目标牌手将一张牌从其坟墓场移出对战。\\n{1}，将祖神兽遗宝移出对战：将所有坟墓场移出对战。 抓一张牌。', 'type': '神器', 'flavor': '地精相信多头龙神是他们的祖神兽，正在纳雅地底沉睡着，以遭遗忘的法术为食。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187436&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b2ae8e2d-6edc-40fe-9216-7643cdd2059b', 'multiverseId': 187436}, 'multiverseid': 187436}]", '[{\'name\': \'Rhox-Kriegsmönch\', \'text\': \'Lebensverknüpfung\', \'type\': \'Kreatur — Nashorn, Mönch\', \'flavor\': \'Rhox-Mönche widmen sich dem spirituellen Wachstum und dem Lernen, die meisten tragen die Siegel vieler Studenten. Allerdings ertragen sie nur ungern Dummköpfe oder Schüler, die ihr sorgfältig verflochtenes Dogma kritisieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'73bb0004-9d6a-49f0-8a4a-b943c8c424c6\', \'multiverseId\': 187655}, \'multiverseid\': 187655}, {\'name\': \'Monje guerrero rhox\', \'text\': \'Vínculo vital.\', \'type\': \'Criatura — Monje rinoceronte\', \'flavor\': \'Los monjes rhox se dedican al crecimiento espiritual y al aprendizaje, y la mayoría lleva los sellos de muchos estudiantes. Sin embargo, no soportan a los tontos o a aquellos que no están de acuerdo con sus cuidadosamente forjadas enseñanzas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187904&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5472884d-24aa-42e2-919d-0e2e0bd7be0d\', \'multiverseId\': 187904}, \'multiverseid\': 187904}, {\'name\': \'Moine de guerre rhox\', \'text\': \'Lien de vie\', \'type\': \'Créature : rhinocéros et moine\', \'flavor\': "Les moines rhox sont voués à la croissance et à l\'éducation spirituelle et ils portent les sigilles de beaucoup d\'élèves. Par contre ils n\'ont pas de patience pour ceux qui sont en désaccord avec leurs dogmes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fbaf067c-6318-4ef4-b52d-33a31b64dc7d\', \'multiverseId\': 188651}, \'multiverseid\': 188651}, {\'name\': \'Rhox Monaco Battagliero\', \'text\': \'Legame vitale\', \'type\': \'Creatura — Monaco Rinoceronte\', \'flavor\': "I rhox monaci sono dediti alla crescita spirituale e all\'apprendimento e parecchi portano i sigilli di molti studenti. Tuttavia, non sopportano di buon grado gli sciocchi e quanti sono in disaccordo con il loro dogma formulato con cura.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188402&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bf52dd23-cfb5-4e6d-a679-eeca4d3a734d\', \'multiverseId\': 188402}, \'multiverseid\': 188402}, {\'name\': \'ロウクスの戦修道士\', \'text\': \'絆魂\', \'type\': \'クリーチャー — サイ・モンク\', \'flavor\': \'ロウクスの僧は精神の成長と学習に身を捧げ、数多くの学び手としての印章を受けている。 しかし、馬鹿や丁寧に扱われる彼らの教義に逆らうものを喜んで受け入れるわけでもない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187157&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40f36ffd-b145-4a3d-896f-3c7f2674f561\', \'multiverseId\': 187157}, \'multiverseid\': 187157}, {\'name\': \'Monge de Guerra Rhox\', \'text\': \'Vínculo com a vida\', \'type\': \'Criatura — Rinoceronte Monge\', \'flavor\': \'Os monges Rhox dedicam-se ao crescimento e ao aprendizado espiritual, e muitos portam as insígnias de vários estudantes. Entretanto, eles não toleram facilmente os tolos ou aqueles que discordam de seu dogma cuidadosamente elaborado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188153&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce0c21ef-fff5-4d0a-bbbc-f7515ac74cce\', \'multiverseId\': 188153}, \'multiverseid\': 188153}, {\'name\': \'Рокс, Боевой Монах\', \'text\': \'Цепь жизни\', \'type\': \'Существо — Носорог Монах\', \'flavor\': \'Роксы-монахи посвящают себя духовному росту и знаниям, и большинство из них отмечены медалями за воспитание учеников. Тем не менее, у них мало терпения к глупцам или тем, кто не согласен с их тщательно сформулированной догмой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188900&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'42615d68-8c20-49d2-85cc-bce974e994be\', \'multiverseId\': 188900}, \'multiverseid\': 188900}, {\'name\': \'罗克战僧\', \'text\': \'系命\', \'type\': \'生物～犀牛／修行僧\', \'flavor\': \'罗克修行僧致力于精神层面的成长与学习，通常都持有学生众多的印记。 不过，他们不太能容忍愚人，或是对他们精心撰写的文件有意见者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187406&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'596209b5-6290-4d06-be38-32580e50de12\', \'multiverseId\': 187406}, \'multiverseid\': 187406}]', '[{\'name\': \'Ritter der weißen Orchidee\', \'text\': \'Erstschlag\\nWenn der Ritter der weißen Orchidee ins Spiel kommt und falls ein Gegner mehr Länder kontrolliert als du, kannst du deine Bibliothek nach einer Ebenen-Karte durchsuchen, sie ins Spiel bringen und dann deine Bibliothek mischen.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Er hilft als Führer durch die weiten Ebenen, die er bewacht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187483&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'97b7b90d-dd3c-49a4-a675-33bf08d49896\', \'multiverseId\': 187483}, \'multiverseid\': 187483}, {\'name\': \'Caballero de la Orquídea Blanca\', \'text\': \'Daña primero.\\nCuando el Caballero de la Orquídea Blanca entre en juego, si un oponente controla más tierras que tú, puedes buscar en tu biblioteca una carta de llanura, ponerla en juego y luego barajar tu biblioteca.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'Guía y guardián en la llanura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187732&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50798696-7a66-4602-8f0e-56c85515d193\', \'multiverseId\': 187732}, \'multiverseid\': 187732}, {\'name\': "Chevalier de l\'Orchidée blanche", \'text\': "Initiative\\nQuand le Chevalier de l\'Orchidée blanche arrive en jeu, si un adversaire contrôle plus de terrains que vous, vous pouvez chercher dans votre bibliothèque une carte de plaine, la mettre en jeu et mélanger ensuite votre bibliothèque.", \'type\': \'Créature : humain et chevalier\', \'flavor\': \'Aussi bien guide que gardien dans une plaine dégagée.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188479&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'45dc575e-f835-494a-bc4f-475691e7e9c6\', \'multiverseId\': 188479}, \'multiverseid\': 188479}, {\'name\': "Cavaliere dell\'Orchidea Bianca", \'text\': "Attacco improvviso\\nQuando il Cavaliere dell\'Orchidea Bianca entra in gioco, se un avversario controlla più terre di te, puoi passare in rassegna il tuo grimorio per una carta Pianura, metterla in gioco, poi rimescolare il tuo grimorio.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': \'Sia la guida che la guardia in aperta pianura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188230&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd625eb6-a5e0-4544-884b-81ef24bb4b07\', \'multiverseId\': 188230}, \'multiverseid\': 188230}, {\'name\': \'白蘭の騎士\', \'text\': \'先制攻撃\\n白蘭の騎士が場に出たとき、いずれかの対戦相手があなたよりも多くの土地をコントロールしている場合、あなたは自分のライブラリーから平地カードを１枚探してもよい。そうしたならそれを場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'広い平原の先達であり護衛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186985&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87a485e0-85a5-47d3-89e7-4dcef52390af\', \'multiverseId\': 186985}, \'multiverseid\': 186985}, {\'name\': \'Cavaleiro da Orquídea Branca\', \'text\': \'Iniciativa\\nQuando Cavaleiro da Orquídea Branca entrar em jogo, se um oponente controlar mais terrenos que você, você poderá procurar em seu grimório por um card de Planície, colocá-lo em jogo e depois embaralhar seu grimório.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'Ele guia e protege as planícies abertas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187981&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ca1c43d3-cfbe-43d6-b808-1e00c532d3a7\', \'multiverseId\': 187981}, \'multiverseid\': 187981}, {\'name\': \'Рыцарь Белой Орхидеи\', \'text\': \'Первый удар\\nКогда Рыцарь Белой Орхидеи входит в игру, если под контролем оппонента больше земель, чем под вашим контролем, вы можете найти в вашей библиотеке карту Равнины, положить ее в игру, затем перетасовать вашу библиотеку.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'И страж, и проводник на открытой равнине.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188728&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'022995ac-3c89-4a61-a380-8017fa50c9e0\', \'multiverseId\': 188728}, \'multiverseid\': 188728}, {\'name\': \'白兰骑士\', \'text\': \'先攻\\n当白兰骑士进场时，若任一对手操控的地比你多，则你可以从你牌库中搜寻一张平原牌，将其放置进场，然后将你的牌库洗牌。\', \'type\': \'生物～人类／骑士\', \'flavor\': \'无垠平原上的向导兼守卫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187234&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d122cc78-2c19-4c56-bf20-2bc3c921e6b6\', \'multiverseId\': 187234}, \'multiverseid\': 187234}]', '[{\'name\': \'Ritter des Aufblickenden Auges\', \'text\': \'{3}{G}: Der Ritter des Aufblickenden Auges erhält +3/+3 bis zum Ende des Zuges. Spiele diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Der Orden des Aufblickenden Auges tanzt nach der Pfeife einer bösen Macht, indem er unbewusst Furcht und Misstrauen in Bant verbreitet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187482&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'960e9552-da3e-4b31-96e7-263d8ce1e152\', \'multiverseId\': 187482}, \'multiverseid\': 187482}, {\'name\': \'Caballero del Ojo Celeste\', \'text\': \'{3}{G}: El Caballero del Ojo Celeste obtiene +3/+3 hasta el final del turno. Juega esta habilidad sólo una vez cada turno.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'La Orden del Ojo Celeste, sin saberlo, sigue la voluntad de una fuerza maligna, extiendiendo la desconfianza y el miedo por todo Bant de acuerdo a sus planes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187731&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd7fe34f-5154-425d-af0a-3fe0d8c8f0b1\', \'multiverseId\': 187731}, \'multiverseid\': 187731}, {\'name\': "Chevalier de l\'Œil tourné vers le Ciel", \'text\': "{3}{G} : Le Chevalier de l\'Œil tourné vers le ciel gagne +3/+3 jusqu\'à la fin du tour. Ne jouez cette capacité qu\'une seule fois par tour.", \'type\': \'Créature : humain et chevalier\', \'flavor\': "L\'Ordre de l\'Œil tourné vers le Ciel sert sans le savoir les plans d\'une force maléfique en semant peur et méfiance partout sur Bant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188478&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c29896ea-7e28-4cc6-bba7-383a30ef042b\', \'multiverseId\': 188478}, \'multiverseid\': 188478}, {\'name\': "Cavaliere dell\'Occhio al Cielo", \'text\': "{3}{G}: Il Cavaliere dell\'Occhio al Cielo prende +3/+3 fino alla fine del turno. Gioca questa abilità solo una volta per turno.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': "L\'Ordine dell\'Occhio al Cielo esegue gli ordini di una forza malvagia, fomentando inconsapevolmente paura e diffidenza in tutto Bant secondo i suoi piani.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188229&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'715a1096-0ce4-4d55-8f10-8a981d106dd0\', \'multiverseId\': 188229}, \'multiverseid\': 188229}, {\'name\': \'天望の騎士\', \'text\': \'{3}{G}：天望の騎士はターン終了時まで＋３/＋３の修整を受ける。 この能力は、毎ターン１回のみプレイできる。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'天望騎士団は知らず知らずのうちに、バント全土を覆う恐怖と不信を掻き回す邪悪な力の計画に導かれることとなっていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186984&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'33d77a59-7086-44e3-880b-142f37bf82f4\', \'multiverseId\': 186984}, \'multiverseid\': 186984}, {\'name\': \'Cavaleiro do Olho Celestial\', \'text\': \'{3}{G}: Cavaleiro do Olho Celestial recebe +3/+3 até o final do turno. Use esta habilidade apenas uma vez a cada turno.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'A Ordem do Olho Celestial realiza a vontade de uma força maligna e favorece assim seus planos, involuntariamente incitando o medo e a desconfiança em Bant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187980&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e4a75c49-1531-47e9-8147-57de93652682\', \'multiverseId\': 187980}, \'multiverseid\': 187980}, {\'name\': \'Рыцарь Поднятого к Небу Взора\', \'text\': \'{3}{G}: Рыцарь Поднятого к Небу Взора получает +3/+3 до конца хода. Разыгрывайте эту способность только один раз за ход.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Рыцари Ордена Поднятого к Небу Взора исполняют волю злой силы и, сами того не подозревая, сеют страх и недоверие по всему Бэнту согласно ее планам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188727&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'08636ca1-e202-41f9-a950-82b34c4f0b28\', \'multiverseId\': 188727}, \'multiverseid\': 188727}, {\'name\': \'尊天骑士\', \'text\': \'{3}{G}：尊天骑士得+3/+3直到回合结束。 此异能每回合中只能使用一次。\', \'type\': \'生物～人类／骑士\', \'flavor\': \'邪恶势力打算在班特散布恐惧与怀疑，而尊天骑士团不知不觉地提供了协助。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187233&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d6107f79-9724-4bc6-85e5-e9a081348b58\', \'multiverseId\': 187233}, \'multiverseid\': 187233}]', '[{\'name\': \'Rittmeister von Eos\', \'text\': \'Wenn der Rittmeister von Eos ins Spiel kommt, bringe zwei 1/1 weiße Soldat-Kreaturenspielsteine ins Spiel.\\n{W}, opfere einen Soldaten: Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Die Stärke des Kastensystems auf Bant ist die unermüdliche Loyalität der niederen Stände.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187484&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b4977c69-0280-4a57-9169-6355d7f0bfb3\', \'multiverseId\': 187484}, \'multiverseid\': 187484}, {\'name\': \'Caballero capitán de Eos\', \'text\': \'Cuando el Caballero capitán de Eos entre en juego, pon en juego dos fichas de criatura Soldado blancas 1/1.\\n{W}, sacrificar un soldado: Prevén todo el daño de combate que se fuera a hacer este turno.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'La fortaleza del sistema de castas de Bant es la lealtad firme de sus miembros más débiles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187733&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d238ea1-15a1-48a0-a31d-856d743aa954\', \'multiverseId\': 187733}, \'multiverseid\': 187733}, {\'name\': "Capitaine de chevalerie d\'Éos", \'text\': "Quand le Capitaine de chevalerie d\'Éos arrive en jeu, mettez en jeu deux jetons de créature 1/1 blanche Soldat.\\n{W}, sacrifiez un soldat : Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.", \'type\': \'Créature : humain et chevalier\', \'flavor\': \'La force du système de castes de Bant repose entièrement sur la loyauté inébranlable de ses membres les plus humbles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188480&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f83372b8-0523-408b-a8d8-fb23380d7927\', \'multiverseId\': 188480}, \'multiverseid\': 188480}, {\'name\': \'Capitano di Eos\', \'text\': \'Quando il Capitano di Eos entra in gioco, metti in gioco due pedine creatura Soldato 1/1 bianche.\\n{W}, Sacrifica un Soldato: Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno.\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': "La forza del sistema a caste di Bant è l\'immancabile lealtà dei suoi membri più umili.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188231&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63063157-ed1c-4964-9e93-1bf7ecefc1a0\', \'multiverseId\': 188231}, \'multiverseid\': 188231}, {\'name\': \'イーオスの騎士長\', \'text\': \'イーオスの騎士長が場に出たとき、白の１/１の兵士・クリーチャー・トークンを２体場に出す。\\n{W}, 兵士を１つ生け贄に捧げる：このターンに与えられるすべての戦闘ダメージを軽減する。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'バントの階級制の強みは、最も下層の構成員の絶対の忠誠だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186986&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2122319b-1f65-499f-a7f2-3b437a3e3423\', \'multiverseId\': 186986}, \'multiverseid\': 186986}, {\'name\': \'Cavaleiro-Capitão de Eos\', \'text\': \'Quando Cavaleiro-Capitão de Eos entrar em jogo, coloque em jogo duas fichas de criatura brancas 1/1 do tipo Soldado.\\n{W}, Sacrifique um Soldado: Previna todo o dano de combate que seria causado neste turno.\', \'type\': \'Criatura — Humano Cavaleiro\', \'flavor\': \'A força do sistema de castas de Bant está na lealdade inabalável de seus membros mais modestos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187982&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b1ea466-4a15-41ab-8995-9f0325c9cb7d\', \'multiverseId\': 187982}, \'multiverseid\': 187982}, {\'name\': \'Эосский Рыцарь-Капитан\', \'text\': \'Когда Эосский Рыцарь-Капитан входит в игру, положите в игру две фишки существа 1/1 белый Солдат.\\n{W}, пожертвуйте Солдата: предотвратите все боевые повреждения, которые должны быть нанесены в этом ходу.\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Сила кастовой системы Бэнта зиждется на неизменной преданности ее самых скромных членов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188729&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'63efe112-eebd-492c-a80f-59e1db4d353b\', \'multiverseId\': 188729}, \'multiverseid\': 188729}, {\'name\': \'亿欧骑士队长\', \'text\': \'当亿欧骑士队长进场时，将两个1/1白色士兵衍生物放置进场。\\n{W}，牺牲一个士兵：于本回合中，防止将造成的所有战斗伤害。\', \'type\': \'生物～人类／骑士\', \'flavor\': \'班特种姓制度的力量，来自最基层成员的忠贞不移。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187235&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0feb3fb5-e9f6-4510-9443-96fa4a1bc937\', \'multiverseId\': 187235}, \'multiverseid\': 187235}]', '[{\'name\': \'Ruderer der Gezeitenleere\', \'text\': \'Wenn der Ruderer der Gezeitenleere ins Spiel kommt, zeigt ein Gegner deiner Wahl die Karten auf seiner Hand offen vor, und du bestimmst eine Karte darunter, die kein Land ist. Entferne diese Karte ganz aus dem Spiel.\\nWenn der Ruderer der Gezeitenleere das Spiel verlässt, bringe die so ganz aus dem Spiel entfernte Karte wieder auf die Hand ihres Besitzers zurück.\', \'type\': \'Artefaktkreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187669&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eee75b45-fca3-4ed4-b56d-9efd6588d7f3\', \'multiverseId\': 187669}, \'multiverseid\': 187669}, {\'name\': \'Barquero de Marea Hueca\', \'text\': \'Cuando el Barquero de Marea Hueca entre en juego, el oponente objetivo muestra su mano y tú eliges de ahí una carta que no sea tierra. Remueve del juego esa carta.\\nCuando el Barquero de Marea Hueca salga del juego, regresa la carta removida a la mano de su propietario.\', \'type\': \'Criatura artefacto — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187918&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e72c066-8342-4504-9bd4-0bcccec832bb\', \'multiverseId\': 187918}, \'multiverseid\': 187918}, {\'name\': \'Passeur de la Mer creuse\', \'text\': "Quand le Passeur de la Mer creuse arrive en jeu, l\'adversaire ciblé révèle sa main et vous y choisissez une carte non-terrain. Retirez cette carte de la partie.\\nQuand le Passeur de la Mer creuse quitte le jeu, renvoyez la carte retirée dans la main de son propriétaire.", \'type\': \'Créature-artefact : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188665&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2327f21e-5516-4dd5-a55c-982a5d9fa7e9\', \'multiverseId\': 188665}, \'multiverseid\': 188665}, {\'name\': \'Rematore di Mareacava\', \'text\': \'Quando il Rematore di Mareacava entra in gioco, un avversario bersaglio rivela la sua mano e tu scegli una carta non terra da essa. Rimuovi dal gioco quella carta.\\nQuando il Rematore di Mareacava lascia il gioco, fai tornare la carta rimossa in mano al suo proprietario.\', \'type\': \'Creatura Artefatto — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188416&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ae4d8a4-c438-4eb7-8274-83e11d61dbb3\', \'multiverseId\': 188416}, \'multiverseid\': 188416}, {\'name\': \'潮の虚ろの漕ぎ手\', \'text\': \'潮の虚ろの漕ぎ手が場に出たとき、対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開し、あなたはそこから土地でないカードを１枚選ぶ。 そのカードをゲームから取り除く。\\n潮の虚ろの漕ぎ手が場を離れたとき、その取り除いたカードをオーナーの手札に戻す。\', \'type\': \'アーティファクト・クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187171&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1eb6975-b2e4-4ccf-83a2-e0d069ee3095\', \'multiverseId\': 187171}, \'multiverseid\': 187171}, {\'name\': \'Remador da Grota das Marés\', \'text\': \'Quando Remador da Grota das Marés entra em jogo, o oponente alvo revela a sua mão e você escolhe um card que não seja um terreno dela. Remova aquele card do jogo.\\nQuando Remador da Grota das Marés deixar o jogo, devolva o card removido para a mão de seu dono.\', \'type\': \'Criatura Artefato — Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188167&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98847436-7a15-4e41-a0a4-2ca3c2d2f1c2\', \'multiverseId\': 188167}, \'multiverseid\': 188167}, {\'name\': \'Кормчий Приливных Пещер\', \'text\': \'Когда Кормчий Приливных Пещер входит в игру, целевой оппонент показывает свою руку, и вы выбираете из нее не являющуюся землей карту. Удалите ту карту из игры.\\nКогда Кормчий Приливных Пещер покидает игру, верните ту удаленную карту в руку ее владельца.\', \'type\': \'Артефактное Существо — Зомби\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188914&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd6bae7e-3d9a-464e-8c0c-e908db831280\', \'multiverseId\': 188914}, \'multiverseid\': 188914}, {\'name\': \'潮窟渡船夫\', \'text\': \'当潮窟渡船夫进场时，目标对手展示其手牌且你选择其中一张非地的牌。 将该牌移出对战。\\n当潮窟渡船夫离场时，将以此法移出对战的牌移回其拥有者手上。\', \'type\': \'神器生物～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187420&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9317fb3b-7448-4e1f-8240-b254d1bf5fa8\', \'multiverseId\': 187420}, \'multiverseid\': 187420}]', '[{\'name\': \'Sangritwoge\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+3 und Doppelschlag bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Manche glauben, dass das spitze Kristall namens Sangrit konzentrierter Drachenodem ist. Andere vermuten, dass es kristallisierte Lebensenergie ist. Den Clans ist das egal, ihnen geht es nur um die freigesetzte Kraft, wenn man es zerquetscht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187657&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4b2e7c6-3040-40f2-8aa8-185ec580908a\', \'multiverseId\': 187657}, \'multiverseid\': 187657}, {\'name\': \'Oleada de sangrita\', \'text\': \'La criatura objetivo obtiene +3/+3 y gana la habilidad de dañar dos veces hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'Algunos creen que el cristal filoso llamado sangrita es aliento de dragón concentrado. Otros creen que es energía vital cristalizada. Los clanes sólo se preocupan del poder que libera al ser aplastado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187906&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab46e2ab-22d2-42a6-85e7-d3f89db829fa\', \'multiverseId\': 187906}, \'multiverseid\': 187906}, {\'name\': \'Déferlement de sangrite\', \'text\': "La créature ciblée gagne +3/+3 et acquiert la double initiative jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': "Il y en a qui croient que le cristal épineux appelé sangrite est un souffle de dragon concentré. D\'autres pensent qu\'il s\'agit d\'énergie vitale cristallisée. Les clans s\'intéressent seulement à la puissance qu\'il libère quand il est écrasé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188653&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae43ff33-a49c-49a2-a5da-7e3e0b37a7d9\', \'multiverseId\': 188653}, \'multiverseid\': 188653}, {\'name\': \'Ondata di Sangrite\', \'text\': \'Una creatura bersaglio prende +3/+3 e ha doppio attacco fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'Alcuni credono che il cristallo appuntito chiamato sangrite sia soffio di drago concentrato. Altri pensano che sia energia vitale cristallizzata. I clan si interessano solo al potere che scatena quando viene infranto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188404&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd1890dc-71fd-4e60-be2e-15afe6412189\', \'multiverseId\': 188404}, \'multiverseid\': 188404}, {\'name\': \'サングライトのうねり\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋３/＋３の修整を受けるとともに二段攻撃を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'サングライトと呼ばれるとげだらけの水晶を、竜の息を凝縮したものだと信じている者もいる。 生命の力の結晶体だと思っている者もいる。 しかし彼らにとっては、叩き壊したときに放つ力だけがあればそれでいい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187159&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ed76346-4cab-4310-88c6-0a198a65e01c\', \'multiverseId\': 187159}, \'multiverseid\': 187159}, {\'name\': \'Explosão de Sangrite\', \'text\': \'A criatura alvo recebe +3/+3 e ganha golpe duplo até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'Alguns acreditam que o cristal pontiagudo chamado sangrite seja bafo de dragão concentrado. Outros acreditam que seja energia vital cristalizada. Para os clãs, a única coisa que importa é a força que libera quando estraçalhado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188155&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cd0eb210-e6e9-47c3-ac0b-cbf4d3d1758b\', \'multiverseId\': 188155}, \'multiverseid\': 188155}, {\'name\': \'Сангритный Всплеск\', \'text\': \'Целевое существо получает +3/+3 и Двойной удар до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'Некоторые верят, что остроконечный кристалл под названием «сангрит» это сгущенное дыхание дракона. Другие считают, что это кристаллизованная жизненная сила. Воюющим кланам же важно только то, что при его дроблении высвобождается огромная энергия.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188902&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1655f094-921f-4bd2-8541-ffaffee9dbf2\', \'multiverseId\': 188902}, \'multiverseid\': 188902}, {\'name\': \'闪晶波涛\', \'text\': \'目标生物得+3/+3且获得连击异能直到回合结束。\', \'type\': \'法术\', \'flavor\': \'刺状的水晶称为闪晶，有人相信这是龙之吐息的浓缩物。 其他人则认为这是生命能量的结晶。 而族人只关心它打破时放射的力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187408&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'066e07e8-77a9-4c23-b790-64630c9a8159\', \'multiverseId\': 187408}, \'multiverseid\': 187408}]', '[{\'name\': \'Sarkhan Vol\', \'text\': \'+1: Kreaturen, die du kontrollierst, erhalten +1/+1 und Eile bis zum Ende des Zuges.\\n-2: Übernimm die Kontrolle über eine Kreatur deiner Wahl bis zum Ende des Zuges. Enttappe diese Kreatur. Sie erhält Eile bis zum Ende des Zuges.\\n-6: Bringe fünf 4/4 rote Drachen-Kreaturenspielsteine mit Flugfähigkeit ins Spiel.\', \'type\': \'Planeswalker — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187658&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32e79c81-1932-4bfa-8031-6222e49f35e4\', \'multiverseId\': 187658}, \'multiverseid\': 187658}, {\'name\': \'Sarkhan Vol\', \'text\': \'+1: Las criaturas que controlas obtienen +1/+1 y ganan la habilidad de prisa hasta el final del turno.\\n-2: Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno.\\n-6: Pon en juego cinco fichas de criatura Dragón rojas 4/4 con la habilidad de volar.\', \'type\': \'Planeswalker — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187907&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01ba9e03-ed2b-4e58-a115-6863429c1997\', \'multiverseId\': 187907}, \'multiverseid\': 187907}, {\'name\': \'Sarkhan Vol\', \'text\': "+1 : Les créatures que vous contrôlez gagnent +1/+1 et acquièrent la célérité jusqu\'à la fin du tour.\\n-2 : Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour.\\n-6 : Mettez en jeu cinq jetons de créature 4/4 rouge Dragon avec le vol.", \'type\': \'Planeswalker : Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188654&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5de5e59a-ab45-4e6c-98b4-453015b14245\', \'multiverseId\': 188654}, \'multiverseid\': 188654}, {\'name\': \'Sarkhan Vol\', \'text\': \'+1: Le creature che controlli prendono +1/+1 e hanno rapidità fino alla fine del turno.\\n-2: Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno.\\n-6: Metti in gioco cinque pedine creatura Drago 4/4 rosse con volare.\', \'type\': \'Planeswalker — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188405&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8252373e-f8a3-40b5-9d6e-7d8d361d2859\', \'multiverseId\': 188405}, \'multiverseid\': 188405}, {\'name\': \'サルカン・ヴォル\', \'text\': \'+1:あなたがコントロールするクリーチャーはターン終了時まで＋１/＋１の修整を受けるとともに速攻を得る。\\n-2:クリーチャー１体を対象とし、ターン終了時までそれのコントロールを得る。 そのクリーチャーをアンタップする。 それはターン終了時まで速攻を得る。\\n-6:飛行を持つ赤の４/４のドラゴン・クリーチャー・トークンを５体場に出す。\', \'type\': \'プレインズウォーカー — サルカン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187160&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'51b8a9d9-7ad7-4fbb-9524-dff544458d63\', \'multiverseId\': 187160}, \'multiverseid\': 187160}, {\'name\': \'Sarkhan Vol\', \'text\': \'+1: As criaturas que você controla recebem +1/+1 e ganham ímpeto até o final do turno.\\n-2: Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno.\\n-6: Coloque em jogo cinco fichas de criatura vermelhas 4/4 do tipo Dragão com voar.\', \'type\': \'Planeswalker — Sarkhan\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188156&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a713120b-b267-4ef1-875d-2a11d952dbed\', \'multiverseId\': 188156}, \'multiverseid\': 188156}, {\'name\': \'Сархан Воль\', \'text\': \'+1: существа под вашим контролем получают +1/+1 и Ускорение до конца хода.\\n-2: получите контроль над целевым существом до конца хода. Разверните то существо. Оно получает Ускорение до конца хода.\\n-6: положите в игру пять фишек существа 4/4 красный Дракон с Полетом.\', \'type\': \'Planeswalker — Сархан\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188903&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30046f4c-e842-46d9-b69e-da392145a173\', \'multiverseId\': 188903}, \'multiverseid\': 188903}, {\'name\': \'萨坎沃\', \'text\': \'+1：由你操控的生物得+1/+1并获得敏捷异能直到回合结束。\\n-2：获得目标生物的操控权直到回合结束。 重置该生物。 它获得敏捷异能直到回合结束。\\n-6：将五个4/4红色，具飞行异能的龙衍生物放置进场。\', \'type\': \'鹏洛客～萨坎\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187409&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e39ba4c-454f-47c4-a34f-921ccc6f33db\', \'multiverseId\': 187409}, \'multiverseid\': 187409}]', '[{\'name\': \'Schattennahrung\', \'text\': \'Entferne eine Karte deiner Wahl in einem Friedhof ganz aus dem Spiel. Du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Zukunft ist eine Schlange, die dein Leben rückwärts durch die Zeit hindurch frisst. Auch wenn du stirbst, schlingt sie weiter." —Sedris, König der Verräter\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187553&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36273085-aa7a-4ea5-b8c1-9b8e05d15cd1\', \'multiverseId\': 187553}, \'multiverseid\': 187553}, {\'name\': \'Alimentar las sombras\', \'text\': \'Remueve del juego la carta objetivo de un cementerio. Gana 3 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'"El futuro es una serpiente, devorando la vida a través del tiempo. Y créeme, cuando te mueres, no deja de alimentarse." —Sedris, el Rey Traidor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187802&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f50d0806-a351-4ca1-861d-eb37c0828d31\', \'multiverseId\': 187802}, \'multiverseid\': 187802}, {\'name\': "Repas de l\'ombre", \'text\': "Retirez de la partie la carte ciblée d\'un cimetière. Vous gagnez 3 points de vie.", \'type\': \'Éphémère\', \'flavor\': "« L\'avenir est un serpent qui dévore votre vie comme un repas qu\'il commencerait par le dessert. Et croyez-moi, son avidité ne prend pas fin avec votre mort. » —Sedris, le Roi traître", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188549&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b61d13b6-bcb2-41a1-8ee9-a46b13618b12\', \'multiverseId\': 188549}, \'multiverseid\': 188549}, {\'name\': \'Nutrimento Ombroso\', \'text\': \'Rimuovi dal gioco una carta bersaglio da un cimitero. Guadagni 3 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"Il futuro è un serpente, che divora la tua vita a ritroso nel tempo. E quando muori, credi a me, non smette di nutrirsi." —Sedris, il Re Traditore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188300&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f7016415-5443-4813-b297-5ddef6f69d81\', \'multiverseId\': 188300}, \'multiverseid\': 188300}, {\'name\': \'影餌付け\', \'text\': \'いずれかの墓地にあるカード１枚を対象とし、それをゲームから取り除く。 あなたは３点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'「未来とは、お前の生命を食らって時間を遡っていく蛇だ。 そしていいか、お前が死んだとて、それは食い続けるんだ。」 ――裏切り者の王、セドリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187055&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7de70aaa-1aad-4c38-91fc-948f016a7d16\', \'multiverseId\': 187055}, \'multiverseid\': 187055}, {\'name\': \'Alimento Sombrio\', \'text\': \'Remova de jogo o card alvo de um cemitério. Você ganha 3 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O futuro é uma cobra, devorando sua vida de trás para frente através do tempo. E quando você morre, acredite, ela não pára de se alimentar." — Sedris, o Rei Traidor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188051&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d62678e-f465-4342-8f65-ad1052d45961\', \'multiverseId\': 188051}, \'multiverseid\': 188051}, {\'name\': \'Пожирание Теней\', \'text\': \'Удалите из игры находящуюся на кладбище целевую карту. Вы получаете 3 жизни.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Будущее это змея, которая миг за мигом пожирает вашу жизнь, устремившись в прошлое. И, поверьте мне, когда вы умрете, она не перестанет кормиться». — Седрис, король-предатель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188798&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bf8d6383-a309-4cae-8bb1-ac5b883e2d4d\', \'multiverseId\': 188798}, \'multiverseid\': 188798}, {\'name\': \'暗影吞没\', \'text\': \'将目标牌从坟墓场移出对战。 你获得3点生命。\', \'type\': \'瞬间\', \'flavor\': \'「未来是条蛇，随着时间将你的生命彼端慢慢吞掉。 相信我，当你死时它还没吃够。」 ～叛徒之王塞基司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187304&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c4398774-151a-4cfe-8ab0-b1e8b1cda5d8\', \'multiverseId\': 187304}, \'multiverseid\': 187304}]', '[{\'name\': \'Schicksalsflicker\', \'text\': \'{T}: Du kannst eine andere bleibende Karte deiner Wahl tappen oder enttappen.\\nExhumieren {U} ({U}: Bringe diese Karte aus deinem Friedhof ins Spiel zurück. Sie hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Kreatur — Zombie, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187510&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'73332c25-8d56-4001-b4c3-bf6210c8d824\', \'multiverseId\': 187510}, \'multiverseid\': 187510}, {\'name\': \'Suturadestinos\', \'text\': \'{T}: Puedes girar o enderezar otro permanente objetivo.\\nDesenterrar {U}. ({U}: Regresa esta carta de tu cementerio al juego. Gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura — Hechicero zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187759&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e69b110f-7ff3-4ee5-bff2-5482737cb097\', \'multiverseId\': 187759}, \'multiverseid\': 187759}, {\'name\': \'Sutureur de destin\', \'text\': "{T} : Vous pouvez engager ou dégager un autre permanent ciblé.\\nExhumation {U} ({U} : Renvoyez en jeu cette carte depuis votre cimetière. Elle acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature : zombie et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188506&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f155cf2-2200-4f30-b216-7d16724bfdf5\', \'multiverseId\': 188506}, \'multiverseid\': 188506}, {\'name\': \'Cucifato\', \'text\': \'{T}: Puoi TAPpare o STAPpare un altro permanente bersaglio.\\nDissotterrare {U} ({U}: Rimetti in gioco questa carta dal tuo cimitero. Ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)\', \'type\': \'Creatura — Mago Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188257&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'10ef36c8-cffa-4781-b650-be8a9d14320c\', \'multiverseId\': 188257}, \'multiverseid\': 188257}, {\'name\': \'命運縫い\', \'text\': \'{T}：他のパーマネント１つを対象とする。あなたはそれをタップまたはアンタップしてもよい。\\n蘇生 {U} ({U}：このカードをあなたの墓地から場に戻す。 それは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'クリーチャー — ゾンビ・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187012&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75225b5d-a352-4699-a7d9-6ca0da269cd8\', \'multiverseId\': 187012}, \'multiverseid\': 187012}, {\'name\': \'Cosedor de Destino\', \'text\': \'{T}: Você pode virar ou desvirar outra permanente alvo.\\nDesenterrar {U} ({U}: Devolva este card de seu cemitério para o jogo. Ele ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura — Zumbi Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188008&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5bfad47b-d97f-479f-8be5-5e8203ecbecd\', \'multiverseId\': 188008}, \'multiverseid\': 188008}, {\'name\': \'Сшиватель Судеб\', \'text\': \'{T}: вы можете повернуть или развернуть другой целевой перманент.\\nОткопать {U} ({U}: верните эту карту из вашего кладбища в игру. Она получает Ускорение. Удалите ее из игры в конце хода, или если она должна покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Существо — Зомби Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188755&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'788e19bc-326e-451a-b531-6e394f57a533\', \'multiverseId\': 188755}, \'multiverseid\': 188755}, {\'name\': \'织命灵俑\', \'text\': \'{T}：你可以横置或重置另一个目标永久物。\\n破坟{U} （{U}：将此牌从你的坟墓场移回场上。 它获得敏捷。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'生物～灵俑／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187261&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'efaba584-5ece-4d81-a8fb-1c07c06733e5\', \'multiverseId\': 187261}, \'multiverseid\': 187261}]', '[{\'name\': \'Schildkrötenformation\', \'text\': \'Kreaturen, die du kontrollierst, sind bis zum Ende des Zuges verhüllt. (Sie können nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Auf dem Meer schlägt die jhessische Flotte schnell und unbarmherzig zu. An Land müssen die Marineinfanteristen gegen die Elitereiterei Valerons auf vorsichtigere Taktiken zurückgreifen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187528&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'447156fb-202c-4508-8816-4619feea4084\', \'multiverseId\': 187528}, \'multiverseid\': 187528}, {\'name\': \'Formación tortuga\', \'text\': \'Las criaturas que controlas ganan la habilidad de velo hasta el final del turno. (No pueden ser objetivo de hechizos o habilidades.)\', \'type\': \'Instantáneo\', \'flavor\': \'En el mar, la flota Jhessiana golpea rápida y segura. En tierra, enfrentando a la caballería de élite de Valeron, sus marinos deben recurrir a estrategias más cautelosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187777&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb7367ed-b7c3-4817-92bd-d76aaa67cace\', \'multiverseId\': 187777}, \'multiverseid\': 187777}, {\'name\': \'Formation de la tortue\', \'text\': "Les créatures que vous contrôlez acquièrent le linceul jusqu\'à la fin du tour. (Elles ne peuvent pas être la cible de sorts ou de capacités.)", \'type\': \'Éphémère\', \'flavor\': "En mer, la flotte jhessienne attaque de façon rapide et décisive. Sur terre, face à la cavalerie d\'élite de Valéron, ses troupes marines dépendent de stratégies plus complexes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188524&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2994173-5538-4929-bc3b-4548ac959757\', \'multiverseId\': 188524}, \'multiverseid\': 188524}, {\'name\': \'Schieramento a Testuggine\', \'text\': \'Le creature che controlli hanno velo fino alla fine del turno. (Non possono essere bersaglio di magie o abilità.)\', \'type\': \'Istantaneo\', \'flavor\': \'In mare, la flotta di Jhess colpisce con rapidità e determinazione. Sulla terraferma, quando affronta la cavalleria scelta di Valeron, la sua fanteria da sbarco deve fare affidamento su strategie più prudenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188275&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5099fd3f-5ad5-46d8-b797-192f94c6291d\', \'multiverseId\': 188275}, \'multiverseid\': 188275}, {\'name\': \'陸亀の体勢\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで被覆を得る。 （それらは呪文や能力の対象にならない。）\', \'type\': \'インスタント\', \'flavor\': \'海では、ジェスの艦隊が素早く思い切りのいい攻撃を仕掛けている。 陸では、ヴァレロンの精鋭騎士に対し、海兵はより慎重な手段に出る必要がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187030&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87c43754-b608-4595-a344-05445d2a3ed6\', \'multiverseId\': 187030}, \'multiverseid\': 187030}, {\'name\': \'Formação Tartaruga\', \'text\': \'As criaturas que você controla ganham manto até o final do turno. (Elas não podem ser alvo de mágicas nem de habilidades.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'No mar, a frota jhessiana combate com rapidez e determinação. Em terra firme, ao enfrentar a cavalaria de elite de Valeron, seus marinheiros precisam usar estratégias mais cautelosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188026&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9756090-ed1e-4ffd-9af4-b2c204272ff1\', \'multiverseId\': 188026}, \'multiverseid\': 188026}, {\'name\': \'Черепаший Строй\', \'text\': \'Существа под вашим контролем получают Пелену до конца хода. (Они не могут быть целями заклинаний или способностей.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В море джесский флот нападает решительно и молниеносно. На суше, сталкиваясь с элитной кавалерией Валерона, морские пехотинцы вынуждены прибегать к более осторожным приемам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188773&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88039a69-0d03-436d-907d-9b256af243f5\', \'multiverseId\': 188773}, \'multiverseid\': 188773}, {\'name\': \'龟壳阵型\', \'text\': \'由你操控的生物获得帷幕异能直到回合结束。 （它们不能成为咒语或异能的目标。）\', \'type\': \'瞬间\', \'flavor\': \'在大海，介斯舰队以调度灵巧著称。 在陆地，对抗威烈隆菁英骑兵的战士得依靠更谨慎的策略。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187279&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'97ce1ee4-2fe5-40df-97de-d1352c524c0e\', \'multiverseId\': 187279}, \'multiverseid\': 187279}]', '[{\'name\': \'Schlammgarten\', \'text\': \'{1}{G}, opfere eine Nicht-Schlammwesen-Kreatur: Bringe einen X/X grünen Schlammwesen-Kreaturenspielstein ins Spiel, wobei X gleich der Stärke der geopferten Kreatur ist. Spiele diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei spielen könntest.\', \'type\': \'Verzauberung\', \'flavor\': \'In Jund gibt es nur wenig Todesbeschwörung. Stattdessen hilft das Fleisch der Toten den Algen-Unwesen beim Wachsen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187610&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bf1743e-27ff-4d5d-8cdd-62b05d4720ef\', \'multiverseId\': 187610}, \'multiverseid\': 187610}, {\'name\': \'Jardín de cienos\', \'text\': \'{1}{G}, sacrificar una criatura que no sea Cieno: Pon en juego una ficha de criatura Cieno verde X/X, donde X es la fuerza de la criatura sacrificada. Juega esta habilidad sólo cuando puedas jugar un conjuro.\', \'type\': \'Encantamiento\', \'flavor\': \'Jund tiene poca necromancia. En lugar de eso, la carne de los muertos crea demonios de algas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187859&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'124f4db5-cdfc-49ff-a48e-abba33825e3a\', \'multiverseId\': 187859}, \'multiverseid\': 187859}, {\'name\': \'Jardin de limon\', \'text\': \'{1}{G}, sacrifiez une créature non-limon : Mettez en jeu un jeton de créature X/X verte Limon, X étant la force de la créature sacrifiée. Ne jouez cette capacité que lorsque vous pourriez jouer un rituel.\', \'type\': \'Enchantement\', \'flavor\': "Jund a peu de nécromancie. Par contre, de la chair de ses cadavres naîssent des monstres d\'algues.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188606&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d5b460d6-7bf6-478a-a796-c55d3ec57b30\', \'multiverseId\': 188606}, \'multiverseid\': 188606}, {\'name\': \'Giardino di Melma\', \'text\': \'{1}{G}, Sacrifica una creatura non Melma: Metti in gioco una pedina creatura Melma X/X verde, dove X è la forza della creatura sacrificata. Gioca questa abilità solo quando potresti giocare una stregoneria.\', \'type\': \'Incantesimo\', \'flavor\': "Jund ha ben poca necromanzia. Invece, la carne dei suoi morti dà origine a demoni d\'alga.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188357&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b5f11b1-bcb1-453c-86d6-b55570274f45\', \'multiverseId\': 188357}, \'multiverseid\': 188357}, {\'name\': \'軟泥の庭\', \'text\': \'{1}{G}, ウーズでないクリーチャーを１体生け贄に捧げる：緑のＸ/Ｘのウーズ・クリーチャー・トークンを１体場に出す。Ｘはその生け贄に捧げられたクリーチャーのパワーに等しい。 この能力は、あなたがソーサリーをプレイできるときにのみプレイできる。\', \'type\': \'エンチャント\', \'flavor\': \'ジャンドには屍術はわずかしかない。 その代わりに、死体の肉は藻の悪鬼として復活する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187112&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72056f4e-5bc0-4a3e-86d7-4022b3120af7\', \'multiverseId\': 187112}, \'multiverseid\': 187112}, {\'name\': \'Jardim Lodoso\', \'text\': \'{1}{G}, Sacrifique uma criatura que não seja do tipo Lodo: Coloque em jogo uma ficha de criatura verde X/X do tipo Lodo, sendo X igual ao poder da criatura sacrificada. Jogue esta habilidade somente quando puder jogar um feitiço.\', \'type\': \'Encantamento\', \'flavor\': \'Em Jund, há pouca necromancia. Em vez disso, da carne de seus mortos formam-se demônios algais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188108&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5c834e3-2c44-4adc-b89c-ce44fccd7ccf\', \'multiverseId\': 188108}, \'multiverseid\': 188108}, {\'name\': \'Сад Тины\', \'text\': \'{1}{G}, пожертвуйте не являющееся Тиной существо: положите в игру одну фишку существа X/X зеленая Тина, где Х сила пожертвованного существа. Разыгрывайте эту способность только при возможности разыгрывать волшебство.\', \'type\': \'Чары\', \'flavor\': \'На Джанде почти нет некромантии. Вместо этого, разлагающиеся тела мертвых порождают водорослевых монстров.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188855&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'36c6fb42-e13e-41d9-9242-af0a5c2ea56e\', \'multiverseId\': 188855}, \'multiverseid\': 188855}, {\'name\': \'流浆花园\', \'text\': \'{1}{G}，牺牲一个不是流浆的生物：将一个X/X绿色流浆衍生物放置进场，X为所牺牲之生物的力量。 你只可以于你能使用法术的时机下使用此异能。\', \'type\': \'结界\', \'flavor\': \'勇得几乎不存有死灵术。 此处死尸的肉身会喂养出藻类邪鬼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187361&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a2af1834-978e-49e6-aa0f-84fbc6659a92\', \'multiverseId\': 187361}, \'multiverseid\': 187361}]', '[{\'name\': \'Schädelmulcher\', \'text\': \'Verschlingen 1 (Sowie diese Karte ins Spiel kommt, kannst du eine beliebige Anzahl an Kreaturen opfern. Diese Kreatur kommt mit so vielen +1/+1-Marken ins Spiel.)\\nWenn der Schädelmulcher ins Spiel kommt, ziehe für jede Kreatur, die er verschlungen hat, eine Karte.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187615&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3470cb1f-f92b-4086-86b0-ed10431ba01b\', \'multiverseId\': 187615}, \'multiverseid\': 187615}, {\'name\': \'Cubrecalaveras\', \'text\': \'Devorar 1. (En cuanto esto entra en juego puedes sacrificar cualquier cantidad de criaturas. Esta criatura entra en juego con esa cantidad de contadores +1/+1 sobre ella.)\\nCuando el Cubrecalaveras entre en juego, roba una carta por cada criatura que devoró.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187864&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c0bd7d97-c217-4468-a3b6-11f9d925ae2a\', \'multiverseId\': 187864}, \'multiverseid\': 187864}, {\'name\': \'Fertiliseur de crânes\', \'text\': "Dévorement 1 (Au moment où cette créature arrive en jeu, vous pouvez sacrifier le nombre de créatures de votre choix. Cette créature arrive en jeu avec ce nombre de marqueurs +1/+1 sur elle.)\\nQuand le Fertiliseur de crânes arrive en jeu, piochez une carte pour chaque créature qu\'il a dévorée.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188611&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a78a1291-20b0-4603-8e00-0a1a3c754c94\', \'multiverseId\': 188611}, \'multiverseid\': 188611}, {\'name\': \'Necroconcimatore\', \'text\': \'Divorare 1 (Mentre questa creatura entra in gioco, puoi sacrificare un qualsiasi numero di creature. Entra in gioco con un numero di segnalini +1/+1 pari alle creature sacrificate.)\\nQuando il Necroconcimatore entra in gioco, pesca una carta per ogni creatura divorata.\', \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188362&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'824594be-66bc-44b2-960e-a6e524afa8db\', \'multiverseId\': 188362}, \'multiverseid\': 188362}, {\'name\': \'髑髏覆い\', \'text\': \'貪食 １ （これが場に出るに際し、あなたは望む数のクリーチャーを生け贄に捧げてもよい。 このクリーチャーはその数に等しい＋１/＋１カウンターが置かれた状態で場に出る。）\\n髑髏覆いが場に出たとき、それが貪食したクリーチャー１体につきカードを１枚引く。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187117&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41918371-4005-450f-97a8-23504e08dfc5\', \'multiverseId\': 187117}, \'multiverseid\': 187117}, {\'name\': \'Recicla-Cova\', \'text\': \'Devorar 1 (Conforme esta criatura entra em jogo, você pode sacrificar um número qualquer de criaturas. Esta criatura entra em jogo com aquela quantidade de marcadores +1/+1.)\\nQuando Recicla-Cova entrar em jogo, compre um card para cada criatura devorada por ele.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188113&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e45050a-05d3-407c-bba2-f455291644c3\', \'multiverseId\': 188113}, \'multiverseid\': 188113}, {\'name\': \'Перетиратель Черепов\', \'text\': \'Пожирание 1 (При входе этого существа в игру вы можете пожертвовать любое количество существ. Это существо входит в игру с таким же количеством жетонов +1/+1 на нем.)\\nКогда Перетиратель Черепов входит в игру, возьмите одну карту за каждое пожранное им существо.\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188860&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'72693e4e-9879-46b5-b702-8b302e35d393\', \'multiverseId\': 188860}, \'multiverseid\': 188860}, {\'name\': \'掩颅灵\', \'text\': \'吞噬1 （于它进场时，你可以牺牲任意数量的生物。 此生物进场时上面有该数量的+1/+1指示物。）\\n当掩颅灵进场时，它每吞噬过一个生物，便抓一张牌。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187366&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9da7938c-eeb6-4caa-9c66-42b7a272af30\', \'multiverseId\': 187366}, \'multiverseid\': 187366}]', '[{\'name\': \'Sedris, König der Verräter\', \'text\': \'Jede Kreaturenkarte in deinem Friedhof hat Exhumieren {2}{B}. ({2}{B}: Bringe die Karte ins Spiel zurück. Die Kreatur hat Eile. Entferne sie am Ende des Zuges oder falls sie das Spiel verlassen würde ganz aus dem Spiel. Spiele Exhumieren nur wie eine Hexerei.)\', \'type\': \'Legendäre Kreatur — Zombie, Krieger\', \'flavor\': \'Er lässt seine Diener aus ihren Gräbern auferstehen, damit sie vor ihm auf die Knie fallen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187660&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa1a69a0-56b2-452d-a393-f930e6eef84f\', \'multiverseId\': 187660}, \'multiverseid\': 187660}, {\'name\': \'Sedris, el Rey Traidor\', \'text\': \'Cada criatura en tu cementerio tiene la habilidad de desenterrar {2}{B}. ({2}{B}: Regresa la carta al juego. La criatura gana la habilidad de prisa. Remuévela del juego al final del turno o si fuera a dejar el juego. Desentierra sólo como un conjuro.)\', \'type\': \'Criatura legendaria — Guerrero zombie\', \'flavor\': \'Obliga a sus sicarios a levantarse de sus tumbas y arrodillarse ante él.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187909&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'63598772-2e21-447b-b38a-8a8bc68b6a6a\', \'multiverseId\': 187909}, \'multiverseid\': 187909}, {\'name\': \'Sedris, le Roi traître\', \'text\': "Chaque carte de créature dans votre cimetière a exhumation {2}{B}. ({2}{B} : Renvoyez en jeu la carte. La créature acquiert la célérité. Retirez-la de la partie à la fin du tour ou si elle devait quitter le jeu. N\'exhumez que lorsque vous pourriez jouer un rituel.)", \'type\': \'Créature légendaire : zombie et guerrier\', \'flavor\': \'Il commande à ses serviteurs de sortir de leur tombe pour se prosterner à ses pieds.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188656&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b55e99f-56f4-4393-a091-e7c70a08fdc2\', \'multiverseId\': 188656}, \'multiverseid\': 188656}, {\'name\': \'Sedris, il Re Traditore\', \'text\': \'Ogni carta creatura nel tuo cimitero ha dissotterrare {2}{B}. ({2}{B}: Rimetti in gioco la carta. La creatura ha rapidità. Rimuovila dal gioco alla fine del turno o se sta per lasciare il gioco. Dissotterra solo quando potresti giocare una stregoneria.)\', \'type\': \'Creatura Leggendaria — Guerriero Zombie\', \'flavor\': \'Ordina ai suoi servitori di sorgere dalla tomba per mettersi in ginocchio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188407&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'69a7e0c7-9478-469a-9dc6-ccb0d3709751\', \'multiverseId\': 188407}, \'multiverseid\': 188407}, {\'name\': \'裏切り者の王、セドリス\', \'text\': \'あなたの墓地にある各クリーチャー・カードは、それぞれ「蘇生 {2}{B}」を持つ。 （{2}{B}：そのカードを場に戻す。 そのクリーチャーは速攻を得る。 ターン終了時かそれが場を離れる場合にそれをゲームから取り除く。 蘇生はソーサリーとしてのみ行う。）\', \'type\': \'伝説のクリーチャー — ゾンビ･戦士\', \'flavor\': \'彼は墓場から下僕を呼び出し、自らの前にひざまずかせる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187162&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a968cb65-e721-4ae6-a944-da63af683d11\', \'multiverseId\': 187162}, \'multiverseid\': 187162}, {\'name\': \'Sedris, o Rei Traidor\', \'text\': \'Cada card de criatura no seu cemitério tem desenterrar {2}{B}. ({2}{B}: Devolva o card para o jogo. A criatura ganha ímpeto. Remova-o do jogo no final do turno ou se ele for deixar o jogo. Use desenterrar somente como um feitiço.)\', \'type\': \'Criatura Lendária — Zumbi Guerreiro\', \'flavor\': \'Ele invoca seus asseclas a levantarem-se de seus túmulos e ajoelharem-se aos seus pés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188158&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66b679cc-743f-440e-88d0-6b273018c0ef\', \'multiverseId\': 188158}, \'multiverseid\': 188158}, {\'name\': \'Седрис, Король-Предатель\', \'text\': \'Каждая карта существа на вашем кладбище имеет способность Откопать {2}{B}. ({2}{B}: верните эту карту в игру. Это существо получает Ускорение. Удалите его из игры в конце хода, или если оно должно покинуть игру. Откапывайте только как волшебство.)\', \'type\': \'Легендарное Существо — Зомби Воин\', \'flavor\': \'Он приказывает своим приспешникам встать из могил... на колени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188905&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'851017e6-51a5-4e6a-994e-d92eb6bf8452\', \'multiverseId\': 188905}, \'multiverseid\': 188905}, {\'name\': \'叛徒之王塞基司\', \'text\': \'你坟墓场中的每张生物牌都具有破坟{2}{B}。 ({2}{B}：将此牌移回场上。 此生物获得敏捷异能。 于它将离场时，或在回合结束时，将它移出对战。 破坟的时机视同法术。）\', \'type\': \'传奇生物～灵俑／战士\', \'flavor\': \'他命令手下仆从自坟地起身向他行跪礼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187411&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dd2342c7-e575-428b-80b0-a31587723166\', \'multiverseId\': 187411}, \'multiverseid\': 187411}]', "[{'name': 'Seeküstenzitadelle', 'text': 'Die Seeküstenzitadelle kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}, {W} oder {U}.', 'type': 'Land', 'flavor': 'Um der Weisheit willen wurde sie hoch gebaut, um alles von oben sehen zu können. Um des Ruhmes willen wurde sie hoch gebaut, um als Dokument der Macht zu dienen. Um der Stärke willen wurde sie hoch gebaut, um alle Angriffe abzuwehren.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187696&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1e776d8b-ef66-403d-9f13-5efe10c02ca5', 'multiverseId': 187696}, 'multiverseid': 187696}, {'name': 'Ciudadela costera', 'text': 'La Ciudadela costera entra en juego girada.\\n{T}: Agrega {G}, {W}, o {U} a tu reserva de maná.', 'type': 'Tierra', 'flavor': 'Para la sabiduría, fue construida bien alta para observarlo todo. Para la gloria, fue construida bien alta para ser un testimonio del poder. Para la fortaleza, fue construida bien alta para repeler todos los ataques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187945&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2441e329-88cd-4a08-9693-d01c2762c496', 'multiverseId': 187945}, 'multiverseid': 187945}, {'name': 'Citadelle maritime', 'text': 'La Citadelle maritime arrive en jeu engagée.\\n{T} : Ajoutez {G}, {W} ou {U} à votre réserve.', 'type': 'Terrain', 'flavor': 'Pour la sagesse, elle fut construite haute pour tout voir. Pour la gloire, elle fut construite haute en testament de la puissance. Pour la force, elle fut construite haute pour repousser toutes les attaques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188692&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7dea8558-0ec8-433a-a10a-7301932d91e7', 'multiverseId': 188692}, 'multiverseid': 188692}, {'name': 'Cittadella sul Mare', 'text': 'La Cittadella sul Mare entra in gioco TAPpata.\\n{T}: Aggiungi {G}, {W} o {U} alla tua riserva di mana.', 'type': 'Terra', 'flavor': 'Per la saggezza, è stata costruita in alto per contemplare ogni cosa. Per la gloria, è stata costruita in alto come testimonianza di potere. Per la potenza, è stata costruita in alto per respingere tutti gli attacchi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188443&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '27141639-6d6e-4be6-92b7-ad2b9a15d351', 'multiverseId': 188443}, 'multiverseid': 188443}, {'name': '海辺の城塞', 'text': '海辺の城塞はタップ状態で場に出る。\\n{T}：あなたのマナ・プールに{G}か{W}か{U}を加える。', 'type': '土地', 'flavor': '智のために、それはあらゆる物を見下ろすべき高さとなった。 名誉のために、それは力を示す高さとなった。 力のために、それはすべての攻撃を跳ね返す高さとなった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187198&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9d608260-65b6-40ce-a92b-70a20e46238b', 'multiverseId': 187198}, 'multiverseid': 187198}, {'name': 'Cidadela à Beira-Mar', 'text': 'Cidadela à Beira-Mar entra em jogo virado.\\n{T}: Adicione {G}, {W} ou {U} à sua reserva de mana.', 'type': 'Terreno', 'flavor': 'Pela sabedoria, ela foi construída no alto para ver todas as coisas. Pela glória, ela foi construída no alto como um testemunho de poder. Pela força, ela foi construída no alto para repelir todos os ataques.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188194&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'da622e6c-978a-4973-9538-7b5285442aba', 'multiverseId': 188194}, 'multiverseid': 188194}, {'name': 'Морская Цитадель', 'text': 'Морская Цитадель входит в игру повернутой.\\n{T}: добавьте {G}, {W} или {U} в ваше хранилище маны.', 'type': 'Земля', 'flavor': 'Ее построили высокой ради мудрости, чтобы созерцать все вокруг. Ее построили высокой ради славы, чтобы доказать могущество. Ее построили высокой ради неприступности, чтобы отражать любые атаки.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188941&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f350d608-97ea-48dd-8012-7b3334f26ab2', 'multiverseId': 188941}, 'multiverseid': 188941}, {'name': '海滨殿堂', 'text': '海滨殿堂须横置进场。\\n{T}：加{G}，{W}，或{U}到你的法术力池中。', 'type': '地', 'flavor': '为了智慧，它建在高地来监看万物。 为了荣誉，它建在高地以验证勇武。 为了力量，它建在高地好斥退攻势。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187447&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '70156d0b-6c30-4b0f-910f-ee5f49b148d8', 'multiverseId': 187447}, 'multiverseid': 187447}]", '[{\'name\': \'Seelenfeuer\', \'text\': \'Eine Kreatur deiner Wahl im Spiel, die du kontrollierst, fügt einer Kreatur oder einem Spieler deiner Wahl Schadenspunkte in Höhe ihrer Stärke zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Er formt einen Avatar aus Zorn und Flammen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187582&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e52a9709-ba0f-413e-abdf-9c8df0e40fbc\', \'multiverseId\': 187582}, \'multiverseid\': 187582}, {\'name\': \'Fuego del alma\', \'text\': \'La criatura objetivo en juego que controlas hace daño igual a su fuerza a la criatura o jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Esculpe un avatar de ira y llamas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187831&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf598cf7-a512-47ed-8b23-ac085493b950\', \'multiverseId\': 187831}, \'multiverseid\': 187831}, {\'name\': "Feu de l\'âme", \'text\': \'La créature ciblée que vous contrôlez en jeu inflige un nombre de blessures égal à sa force à une cible, créature ou joueur.\', \'type\': \'Éphémère\', \'flavor\': "Un avatar qu\'il sculpte avec la rage et les flammes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188578&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2e1dfffd-e264-4830-8cce-63f2bf38a031\', \'multiverseId\': 188578}, \'multiverseid\': 188578}, {\'name\': "Fuoco dell\'Anima", \'text\': \'Una creatura bersaglio che controlli in gioco infligge danno pari alla sua forza a una creatura o a un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Scolpisce un avatar di rabbia e fiamme.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188329&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38f30175-918b-42d2-a922-27ebaac806cc\', \'multiverseId\': 188329}, \'multiverseid\': 188329}, {\'name\': \'魂の火\', \'text\': \'あなたがコントロールする場にあるクリーチャー１体と、クリーチャー１体かプレイヤー１人を対象とする。その前者はその後者に、自身のパワーに等しい点数のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'憤怒と炎を象った化身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187084&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'caa4dcbd-760a-4239-b985-f4b7e0ae51dc\', \'multiverseId\': 187084}, \'multiverseid\': 187084}, {\'name\': \'Fogo da Alma\', \'text\': \'A criatura alvo que você controla em jogo causa dano igual ao seu poder à criatura ou ao jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Um avatar ele esculpe, de ira e chamas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188080&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f4d8cf4c-7c3e-432f-bc1e-d59bdb0c9a4c\', \'multiverseId\': 188080}, \'multiverseid\': 188080}, {\'name\': \'Огонь Души\', \'text\': \'Находящееся в игре целевое существо под вашим контролем наносит целевому существу или игроку повреждения, равные своей силе.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Аватара, которую он ваяет из гнева и пламени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188827&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2dc74897-bbad-45c6-99c6-b6f220653fb4\', \'multiverseId\': 188827}, \'multiverseid\': 188827}, {\'name\': \'灵魂热火\', \'text\': \'由你操控且在场的目标生物对目标生物或牌手造成伤害，其数量等同于前者的力量。\', \'type\': \'瞬间\', \'flavor\': \'以愤怒与火焰塑造的化身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187333&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'130bc167-269c-41ef-b70b-e264fe11f57f\', \'multiverseId\': 187333}, \'multiverseid\': 187333}]', '[{\'name\': \'Segen des Siegels\', \'text\': \'Bis zum Ende des Zuges erhält eine Kreatur deiner Wahl, die du kontrollierst, +3/+3, und alle andere Kreaturen, die du kontrollierst, +1/+1.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Für unbeirrten Einsatz und unnachgiebige Härte verleiht dir der Orden der Weißen Orchidee sein Siegel. Erhebe dich, Rittmeister, und tue deine Pflicht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187662&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6bfa26f1-8fa2-4466-a883-71680d59d154\', \'multiverseId\': 187662}, \'multiverseid\': 187662}, {\'name\': \'Bendición del sello\', \'text\': \'Hasta el final del turno, la criatura objetivo que controlas obtiene +3/+3 y las otras criaturas que controlas obtienen +1/+1.\', \'type\': \'Instantáneo\', \'flavor\': \'"Por su compromiso indudable y su fuerza persistente, la Orden de la Orquídea Blanca otorga su sello. Levántate, caballero capitán, y cumple tu labor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187911&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11ea31cc-3e7a-4dae-96b6-ab95719a0b82\', \'multiverseId\': 187911}, \'multiverseid\': 187911}, {\'name\': \'Bénédiction de sigille\', \'text\': "Jusqu\'à la fin du tour, la créature ciblée que vous contrôlez gagne +3/+3 et les autres créatures que vous contrôlez gagnent +1/+1.", \'type\': \'Éphémère\', \'flavor\': "« Pour récompenser ce dévouement et cette force inébranlables, l\'Ordre de l\'Orchidée blanche vous confère son sigille. Relevez-vous, capitaine de chevalerie, et accomplissez votre devoir. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188658&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b49469dd-0c5a-4c41-b091-57b7e686e3b2\', \'multiverseId\': 188658}, \'multiverseid\': 188658}, {\'name\': \'Benedizione del Sigillo\', \'text\': \'Fino alla fine del turno, una creatura bersaglio che controlli prende +3/+3 e le altre creature che controlli prendono +1/+1.\', \'type\': \'Istantaneo\', \'flavor\': \'"L\\\'Ordine dell\\\'Orchidea Bianca ti conferisce il suo sigillo, per una dedizione incrollabile e una forza inflessibile. Alzati, capitano, e compi il tuo dovere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188409&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d6198a4-b021-437d-a2a6-835e60a26931\', \'multiverseId\': 188409}, \'multiverseid\': 188409}, {\'name\': \'印章の祝福\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とする。ターン終了時まで、それは＋３/＋３の修整を受け、あなたがコントロールする他のクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'「断固たる意思と怯むことなき力をもって、白蘭騎士団は印章を授ける。 立て、騎士長よ、汝の責務を果たせ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187164&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ac7028c-1ded-4b40-97f6-0dbcaaef557a\', \'multiverseId\': 187164}, \'multiverseid\': 187164}, {\'name\': \'Bênção da insígnia\', \'text\': \'Até o final do turno, a criatura alvo que você controla recebe +3/+3 e as outras criaturas que você controla recebem +1/+1.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Pelo comprometimento inabalável e pela determinação resoluta, a Ordem da Orquídea Branca confere a sua insígnia. Levante-se, cavaleiro-capitão, e cumpra o seu dever."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188160&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4e057bb3-3ee5-452b-98e7-6977231a5d99\', \'multiverseId\': 188160}, \'multiverseid\': 188160}, {\'name\': \'Благословение Медалью\', \'text\': \'До конца хода целевое существо под вашим контролем получает +3/+3, а другие существа под вашим контролем получают +1/+1.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«За непоколебимую преданность и решительную силу Орден Белой Орхидеи награждает тебя своей медалью. Встань, рыцарь-капитан, и выполняй свой долг»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188907&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39808cf0-63f0-4852-a736-ccd4e2e0d2dd\', \'multiverseId\': 188907}, \'multiverseid\': 188907}, {\'name\': \'印记加持\', \'text\': \'直到回合结束，目标由你操控的生物得+3/+3且由你操控的其他生物得+1/+1。\', \'type\': \'瞬间\', \'flavor\': \'「为了不移心志与坚定力量，白兰骑士团特授予此印记。 骑士队长，请带着这责任起身。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187413&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'81c36271-b975-47f8-9aa0-82899a023ce8\', \'multiverseId\': 187413}, \'multiverseid\': 187413}]', '[{\'name\': \'Sharuum, Sphinx-Hegemon\', \'text\': \'Fliegend\\nWenn Sharuum, Sphinx-Hegemon ins Spiel kommt, kannst du eine Artefaktkarte deiner Wahl aus deinem Friedhof ins Spiel zurückbringen.\', \'type\': \'Legendäre Artefaktkreatur — Sphinx\', \'flavor\': \'Um eine Audienz bei dem Hegemon zu erhalten, muss man ein Rätsel mitbringen, das dieser noch nicht kennt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187661&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b3e01d0-738c-4370-ba41-4e9a3aebfb3a\', \'multiverseId\': 187661}, \'multiverseid\': 187661}, {\'name\': \'Sharuum la Hegemón\', \'text\': \'Vuela.\\nCuando Sharuum la Hegemón entre en juego, puedes regresar la carta de artefacto objetivo de tu cementerio al juego.\', \'type\': \'Criatura artefacto legendaria — Esfinge\', \'flavor\': \'Para obtener una audiencia con la hegemón, debes traerle un acertijo que no haya escuchado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187910&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f34e48e-247c-4c67-ad81-6824bf4a18d2\', \'multiverseId\': 187910}, \'multiverseid\': 187910}, {\'name\': "Sharuûm l\'Hégémon", \'text\': "Vol\\nQuand Sharuûm l\'Hégémon arrive en jeu, vous pouvez renvoyer en jeu une carte d\'artefact ciblée depuis votre cimetière.", \'type\': \'Créature-artefact légendaire : Sphinx\', \'flavor\': "Pour obtenir audience avec l\'Hégémon, il faut pouvoir lui présenter une énigme qu\'elle n\'a jamais entendue auparavant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188657&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d9f1356-b88c-433f-a1c9-b43040941652\', \'multiverseId\': 188657}, \'multiverseid\': 188657}, {\'name\': "Sharuum l\'Egemone", \'text\': "Volare\\nQuando Sharuum l\'Egemone entra in gioco, puoi rimettere in gioco una carta artefatto bersaglio dal tuo cimitero.", \'type\': \'Creatura Artefatto Leggendaria — Sfinge\', \'flavor\': "Perché l\'egemone dia udienza, si deve proporre un enigma che non abbia mai sentito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3708b4b3-d0ba-4e31-991d-a4a36f53019b\', \'multiverseId\': 188408}, \'multiverseid\': 188408}, {\'name\': \'覇者シャルム\', \'text\': \'飛行\\n覇者シャルムが場に出たとき、あなたの墓地にあるアーティファクト・カード１枚を対象とする。あなたはそれを場に戻してもよい。\', \'type\': \'伝説のアーティファクト・クリーチャー — スフィンクス\', \'flavor\': \'教義を授かるためには、彼女の知らない謎を聞かせなければならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187163&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ce48461-8b54-4c5b-8528-869a8c192e15\', \'multiverseId\': 187163}, \'multiverseid\': 187163}, {\'name\': \'Sharuum, a Hegemônica\', \'text\': \'Voar\\nQuando Sharuum, a Hegemônica, entra em jogo, você pode devolver o card de artefato alvo de seu cemitério ao jogo.\', \'type\': \'Criatura Artefato Lendária — Esfinge\', \'flavor\': \'Para que a hegemônica lhe conceda uma audiência, é necessário trazer um enigma que ela ainda não conheça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188159&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'530921df-2c5d-4dab-aebf-099f4f81e3d6\', \'multiverseId\': 188159}, \'multiverseid\': 188159}, {\'name\': \'Шарум Гегемон\', \'text\': \'Полет\\nКогда Шарум Гегемон входит в игру, вы можете вернуть целевую карту артефакта из вашего кладбища в игру.\', \'type\': \'Легендарное Артефактное Существо — Сфинкс\', \'flavor\': \'Чтобы получить аудиенцию у гегемона, нужно принести с собой загадку, которую она никогда не слышала.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188906&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'10938198-bcf9-426a-85fe-371486e29ed6\', \'multiverseId\': 188906}, \'multiverseid\': 188906}, {\'name\': \'支配者韶伦\', \'text\': \'飞行\\n当支配者韶伦进场时，你可以将目标神器牌从你的坟墓场移回场上。\', \'type\': \'传奇神器生物～史芬斯\', \'flavor\': \'为了赢得支配者的青睐，必得准备一则她没听过的谜语。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187412&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39bf8506-0d28-42c5-8639-2a2fc63db3ce\', \'multiverseId\': 187412}, \'multiverseid\': 187412}]', "[{'name': 'Siegel der Anerkennung', 'text': 'Das Siegel der Anerkennung kommt mit X Ladungsmarken ins Spiel.\\nDie ausgerüstete Kreatur erhält +1/+1 für jede Ladungsmarke auf dem Siegel der Anerkennung.\\nAusrüsten Entferne eine Ladungsmarke vom Siegel der Anerkennung.', 'type': 'Artefakt — Ausrüstung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187686&type=card', 'language': 'German', 'identifiers': {'scryfallId': '79b1e0bf-165c-4f77-93b3-e501ca871f50', 'multiverseId': 187686}, 'multiverseid': 187686}, {'name': 'Sello de distinción', 'text': 'El Sello de distinción entra en juego con X contadores de carga sobre él.\\nLa criatura equipada obtiene +1/+1 por cada contador de carga sobre el Sello de distinción.\\nEquipar—Remover un contador de carga del Sello de distinción.', 'type': 'Artefacto — Equipo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187935&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a98a19e6-9ec7-4d51-914b-627903124b3f', 'multiverseId': 187935}, 'multiverseid': 187935}, {'name': 'Sigille de distinction', 'text': 'Le Sigille de distinction arrive en jeu avec X marqueurs « charge » sur lui.\\nLa créature équipée gagne +1/+1 for pour chaque marqueur « charge » sur le Sigille de distinction.\\nÉquipement — Retirez un marqueur « charge » du Sigille de distinction.', 'type': 'Artefact : équipement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188682&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fc13414e-175a-43ef-9576-103bee726072', 'multiverseId': 188682}, 'multiverseid': 188682}, {'name': 'Sigillo di Onorificenza', 'text': 'Il Sigillo di Onorificenza entra in gioco con X segnalini carica.\\nLa creatura equipaggiata prende +1/+1 per ogni segnalino carica sul Sigillo di Onorificenza.\\nEquipaggiare—Rimuovi un segnalino carica dal Sigillo di Onorificenza.', 'type': 'Artefatto — Equipaggiamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188433&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '32f10503-0def-4685-ae5e-496e9c779b0e', 'multiverseId': 188433}, 'multiverseid': 188433}, {'name': '卓越の印章', 'text': '卓越の印章は蓄積カウンターがＸ個置かれた状態で場に出る。\\n装備しているクリーチャーは、卓越の印章の上に置かれている蓄積カウンター１個につき＋１/＋１の修整を受ける。\\n装備 ― 卓越の印章から蓄積カウンターを１個取り除く。', 'type': 'アーティファクト — 装備品', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187188&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '84295f95-9bff-4088-afab-0967e246a7ba', 'multiverseId': 187188}, 'multiverseid': 187188}, {'name': 'Insígnia de Distinção', 'text': 'Insígnia de Distinção entra em jogo com X marcadores de carga.\\nA criatura equipada recebe +1/+1 para cada marcador de carga em Insígnia de Distinção.\\nEquipar Remova um marcador de carga de Insígnia de Distinção.', 'type': 'Artefato — Equipamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188184&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '967424e0-e271-40ce-96cc-f385a8c0e3b7', 'multiverseId': 188184}, 'multiverseid': 188184}, {'name': 'Медаль Отличия', 'text': 'Медаль Отличия входит в игру с Х жетонами заряда на ней.\\nСнаряженное существо получает +1/+1 за каждый жетон заряда на Медали Отличия.\\nСнарядить удалите один жетон заряда с Медали Отличия.', 'type': 'Артефакт — Снаряжение', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188931&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd82023bb-fcbc-4e38-b6b1-f351cd625871', 'multiverseId': 188931}, 'multiverseid': 188931}, {'name': '明辨印记', 'text': '明辨印记进场时上面有X个充电指示物。\\n明辨印记上每有一个充电指示物，佩带此武具的生物便得+1/+1。\\n佩带～从明辨印记上移去一个充电指示物。', 'type': '神器～武具', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187437&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '894e4fc6-c5a6-4a2c-be3b-03ac561034e1', 'multiverseId': 187437}, 'multiverseid': 187437}]", '[{\'name\': \'Skelettartiger Kathari\', \'text\': \'Fliegend\\n{B}, opfere eine Kreatur: Regeneriere den Skelettartigen Kathari.\', \'type\': \'Kreatur — Vogel, Skelett\', \'flavor\': \'Auch als Untote suchen die Kathari weiter nach Aas und entfernen fleißig Leichen aus dem Bodensatz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187555&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'236b6f44-b25e-4f77-95ed-c35b44bf470c\', \'multiverseId\': 187555}, \'multiverseid\': 187555}, {\'name\': \'Kathari esquelético\', \'text\': \'Vuela.\\n{B}, sacrificar una criatura: Regenera el Kathari esquelético.\', \'type\': \'Criatura — Esqueleto ave\', \'flavor\': \'La muerte viviente no limita la búsqueda de carroña de los kathari; sólo quita un cuerpo del Escorial.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187804&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'961a07d2-4f58-4490-8713-f34a3ef2a07a\', \'multiverseId\': 187804}, \'multiverseid\': 187804}, {\'name\': \'Kathari squelettique\', \'text\': \'Vol\\n{B}, sacrifiez une créature : Régénérez le Kathari squelettique.\', \'type\': \'Créature : oiseau et squelette\', \'flavor\': "La morte-vie n\'interrompt pas la recherche de charogne du kathari ; elle retire simplement un cadavre de la Bourbière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188551&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33eea086-379b-4da0-9004-977de4e8a222\', \'multiverseId\': 188551}, \'multiverseid\': 188551}, {\'name\': \'Kathari Scheletrico\', \'text\': \'Volare\\n{B}, Sacrifica una creatura: Rigenera il Kathari Scheletrico.\', \'type\': \'Creatura — Scheletro Uccello\', \'flavor\': \'La non morte non fa smettere i kathari di cercare carogne; semplicemente elimina un cadavere da Fecciorama.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188302&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'43bdc814-be8c-4e04-bef3-83761da069c5\', \'multiverseId\': 188302}, \'multiverseid\': 188302}, {\'name\': \'骸骨のカターリ\', \'text\': \'飛行\\n{B}, クリーチャーを１体生け贄に捧げる：骸骨のカターリを再生する。\', \'type\': \'クリーチャー — 鳥・スケルトン\', \'flavor\': \'不死者となっても、それでカターリが腐肉を探すのをやめるわけではない。単に屑肉の地から死体が一つ減っただけなのだから。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187057&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'980eda07-b440-4a46-9801-789455ebe571\', \'multiverseId\': 187057}, \'multiverseid\': 187057}, {\'name\': \'Kathari Esquelético\', \'text\': \'Voar\\n{B}, Sacrifique uma criatura: Regenere Kathari Esquelético.\', \'type\': \'Criatura — Ave Esqueleto\', \'flavor\': \'A morte-vida não cessa a busca dos kathari por carne podre; simplesmente remove um corpo do Vale das Escórias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188053&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'adbecfab-d223-4488-bbae-2f0d09a686ef\', \'multiverseId\': 188053}, \'multiverseid\': 188053}, {\'name\': \'Скелетный Катари\', \'text\': \'Полет\\n{B}, пожертвуйте существо: регенерируйте Скелетного Катари.\', \'type\': \'Существо — Птица Скелет\', \'flavor\': \'Приняв нежизнь, катари не прекращает своих поисков падали просто на Протухшем Болоте становится одним трупом меньше.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188800&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'af617a3f-62e3-4735-8147-ba4d7aa84cd3\', \'multiverseId\': 188800}, \'multiverseid\': 188800}, {\'name\': \'骷髅卡刹立\', \'text\': \'飞行\\n{B}，牺牲一个生物：重生骷髅卡刹立。\', \'type\': \'生物～鸟／骷髅妖\', \'flavor\': \'卡刹立在死后依旧寻觅着腐肉；这只不过是让渣境少了个尸体。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187306&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4253688c-6e8a-45ba-ad2e-34abb255c09b\', \'multiverseId\': 187306}, \'multiverseid\': 187306}]', '[{\'name\': \'Skelettierung\', \'text\': \'Skelettierung fügt einer Kreatur deiner Wahl 3 Schadenspunkte zu. Wenn eine Kreatur, der auf diese Weise Schaden zugefügt wurde, in diesem Zug auf den Friedhof gelegt wird, bringe einen 1/1 schwarzen Skelett-Kreaturenspielstein mit „{B}: Regeneriere diese Kreatur" ins Spiel.\', \'type\': \'Spontanzauber\', \'flavor\': \'Das Feuer brennt sowohl das Fleisch als auch die Freiheit weg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'348eaeae-2e88-4839-b053-980913ddf9ef\', \'multiverseId\': 187581}, \'multiverseid\': 187581}, {\'name\': \'Esqueletonizar\', \'text\': \'Esqueletonizar hace 3 puntos de daño a la criatura objetivo. Cuando una criatura que recibió daño de esta manera vaya a un cementerio este turno, pon en juego una ficha de criatura Esqueleto negra 1/1 con "{B}: Regenera esta criatura".\', \'type\': \'Instantáneo\', \'flavor\': \'El fuego quema la carne y la libertad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187830&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'939e67c8-8549-43d9-9655-69bbdbc03dcd\', \'multiverseId\': 187830}, \'multiverseid\': 187830}, {\'name\': \'Squelettification\', \'text\': \'La Squelettification inflige 3 blessures à la créature ciblée. Quand une créature qui a subi des blessures de cette manière est mise dans un cimetière ce tour-ci, mettez en jeu un jeton de créature 1/1 noire Squelette avec « {B} : Régénérez cette créature. »\', \'type\': \'Éphémère\', \'flavor\': \'Le feu consume aussi bien la chair que la liberté.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188577&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae378af1-4bb8-4fdb-8efd-f00bf919e8eb\', \'multiverseId\': 188577}, \'multiverseid\': 188577}, {\'name\': \'Scheletrizzare\', \'text\': \'Scheletrizzare infligge 3 danni a una creatura bersaglio. Quando una creatura a cui è stato inflitto danno in questo modo viene messa in un cimitero in questo turno, metti in gioco una pedina creatura Scheletro 1/1 nera con "{B}: Rigenera questa creatura".\', \'type\': \'Istantaneo\', \'flavor\': \'Il fuoco consuma sia la carne che la libertà.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188328&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b26bb904-2fc8-4d42-af44-436bf8ddf62f\', \'multiverseId\': 188328}, \'multiverseid\': 188328}, {\'name\': \'骸骨化\', \'text\': \'クリーチャー１体を対象とする。骸骨化はそれに３点のダメージを与える。 このターン、これによりダメージを与えられたクリーチャーがいずれかの墓地に置かれたとき、「{B}：このクリーチャーを再生する。」を持つ黒の１/１のスケルトン・クリーチャー・トークンを１体場に出す。\', \'type\': \'インスタント\', \'flavor\': \'火は肉体と自由を燃やし尽くす。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187083&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8e7545da-2865-4cb5-b580-f134531588ee\', \'multiverseId\': 187083}, \'multiverseid\': 187083}, {\'name\': \'Esqueletizar\', \'text\': \'Esqueletizar causa 3 pontos de dano à criatura alvo. Quando uma criatura que sofre dano desta maneira é colocada num cemitério neste turno, coloque em jogo uma ficha de criatura preta 1/1 do tipo Esqueleto com "{B}: Regenere esta criatura."\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O fogo transforma em cinzas tanto a carne quanto a liberdade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188079&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7028ef4-3cb1-416f-ad9a-6846e5358e4e\', \'multiverseId\': 188079}, \'multiverseid\': 188079}, {\'name\': \'Скелетонизация\', \'text\': \'Скелетонизация наносит 3 повреждения целевому существу. Когда существо, которому таким образом были нанесены повреждения, попадает на кладбище в этом ходу, положите в игру одну фишку существа 1/1 черный Скелет со способностью «{B}: регенерируйте это существо».\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Огонь сжигает и плоть, и свободу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188826&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b882959-9b17-48ff-aac9-32eb9675aee7\', \'multiverseId\': 188826}, \'multiverseid\': 188826}, {\'name\': \'烧成骷髅\', \'text\': \'烧成骷髅对目标生物造成3点伤害。 当本回合中曾以此法受到伤害的生物置入坟墓场时，将一个1/1黑色骷髅妖衍生物放置进场，且具有「{B}：重生此生物」。\', \'type\': \'瞬间\', \'flavor\': \'烈火将肉身与自由一起烧毁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187332&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3994383f-9a06-4a58-84f3-968ccfbf918f\', \'multiverseId\': 187332}, \'multiverseid\': 187332}]', "[{'name': 'Sonnensamen-Pflegerin', 'text': 'Falls du am Ende deines Zuges eine Kreatur mit Stärke 5 oder mehr kontrollierst, kannst du 2 Lebenspunkte dazuerhalten.\\n{T}: Erhöhe deinen Manavorrat um {1}.', 'type': 'Kreatur — Mensch, Druide, Zauberer', 'flavor': 'Sonnensamer suchen nach Gegenden mit freiem Himmel. Sie richten Pflugbestien ab, um den dichten Dschungel lange genug zurückzudrängen, um eine Ernte einzufahren.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187496&type=card', 'language': 'German', 'identifiers': {'scryfallId': '50da7ed0-af32-439e-9e6b-5c4f07657469', 'multiverseId': 187496}, 'multiverseid': 187496}, {'name': 'Nutriente Siembrasol', 'text': 'Al final de tu turno, si controlas una criatura con fuerza de 5 o más, puedes ganar 2 vidas.\\n{T}: Agrega {1} a tu reserva de maná.', 'type': 'Criatura — Hechicero druida humano', 'flavor': 'Los Siembrasol buscan áreas de cielo abierto. Entrenan a las bestias de siembra para empujar la densa selva lo suficiente como para cultivar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187745&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5a64b12d-930c-4d06-afe8-45dde9f391e1', 'multiverseId': 187745}, 'multiverseid': 187745}, {'name': 'Nourricier de grain solaire', 'text': 'À la fin de votre tour, si vous contrôlez une créature de force supérieure ou égale à 5, vous pouvez gagner 2 points de vie.\\n{T} : Ajoutez {1} à votre réserve.', 'type': 'Créature : humain et druide et sorcier', 'flavor': 'Les planteurs de grain solaire recherchent des endroits à ciel ouvert. Ils entraînent les labourins à repousser la jungle dense suffisamment longtemps pour obtenir une moisson.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188492&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6819406d-c2c8-4a4b-b031-3c725a5a72c5', 'multiverseId': 188492}, 'multiverseid': 188492}, {'name': 'Coltivatore di Semi Solari', 'text': 'Alla fine del tuo turno, se controlli una creatura con forza pari o superiore a 5, puoi guadagnare 2 punti vita.\\n{T}: Aggiungi {1} alla tua riserva di mana.', 'type': 'Creatura — Mago Druido Umano', 'flavor': 'I seminatori solari cercano zone di cielo sereno. Addestrano le bestiaratro a respingere la giungla fitta abbastanza a lungo da coltivare un raccolto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188243&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '19689973-0e36-4b87-83c0-8070d1f675c9', 'multiverseId': 188243}, 'multiverseid': 188243}, {'name': '太陽の種の育種士', 'text': 'あなたのターンの終了時に、あなたがパワーが５以上のクリーチャーをコントロールしている場合、あなたは２点のライフを得てもよい。\\n{T}：あなたのマナ・プールに{1}を加える。', 'type': 'クリーチャー — 人間・ドルイド・ウィザード', 'flavor': '太陽の種撒きは、広々とした空のある場所を求めている。 深い密林の中で収穫が得られるまでの脅威を跳ね返すため、彼らは耕し獣を鍛えている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186998&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2569696a-ea1d-47ec-8d52-97a7ccf50b82', 'multiverseId': 186998}, 'multiverseid': 186998}, {'name': 'Nutridor de Heliósporo', 'text': 'No final de seu turno, se você controlar uma criatura com poder maior ou igual a 5, poderá ganhar 2 pontos de vida.\\n{T}: Adicione {1} à sua reserva de mana.', 'type': 'Criatura — Humano Druida Mago', 'flavor': 'Os semeadores de heliósporos buscam áreas de céu aberto. Eles treinam as bestas lavradoras para derrubar uma área grande o bastante na densa selva para cultivar uma plantação.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187994&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0fa9359d-1622-4320-a08f-2d5efacb4195', 'multiverseId': 187994}, 'multiverseid': 187994}, {'name': 'Проращиватель Солнечных Семян', 'text': 'В конце вашего хода, если под вашим контролем есть существо с силой 5 или больше, вы можете получить 2 жизни.\\n{T}: добавьте {1} в ваше хранилище маны.', 'type': 'Существо — Человек Друид Чародей', 'flavor': 'Сеятели солнечных семян находятся в постоянном поиске пахотной земли под открытым небом. Они дрессируют плугозверей, чтобы те сдерживали наступающие джунгли, пока не вызреет урожай.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188741&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b98e9800-2754-4f5f-99f2-b53daf80936c', 'multiverseId': 188741}, 'multiverseid': 188741}, {'name': '日种滋养师', 'text': '在你的回合结束时，如果你操控了力量大于或等于5的生物，你可以获得2点生命。\\n{T}：加{1}到你的法术力池中。', 'type': '生物～人类／德鲁伊／法术师', 'flavor': '日种农人需要一大片的空旷农地。 他们训练犁兽开垦浓密丛林边境，将之化为良田。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187247&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f8ea0654-5929-4523-92fb-bad27dbcf80f', 'multiverseId': 187247}, 'multiverseid': 187247}]", "[{'name': 'Speerbrecherbehemoth', 'text': 'Der Speerbrecherbehemoth ist unzerstörbar.\\n{1}: Eine Kreatur deiner Wahl mit Stärke 5 oder mehr ist in diesem Zug unzerstörbar.', 'type': 'Kreatur — Bestie', 'flavor': 'In Nayan werden Gargantuas nur von wenigen gejagt. Sie werden nicht als Tiere betrachtet, sondern als Naturgewalten wie Erdrutsche oder Taifune.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187617&type=card', 'language': 'German', 'identifiers': {'scryfallId': '59d1b6f9-65d4-4966-9adb-cedfa5c3f219', 'multiverseId': 187617}, 'multiverseid': 187617}, {'name': 'Behemot rompelanzas', 'text': 'El Behemot rompelanzas es indestructible.\\n{1}: La criatura objetivo con fuerza de 5 o más es indestructible este turno.', 'type': 'Criatura — Bestia', 'flavor': 'Pocos nayanos se animan a cazar gargantúas. No se los trata como animales, sino como fuerzas de la naturaleza, como las avalanchas o los tifones.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187866&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e19b989b-4bbc-4448-ac4b-4fb31dc48e2f', 'multiverseId': 187866}, 'multiverseid': 187866}, {'name': 'Béhémoth briselance', 'text': 'Le Béhémoth briselance est indestructible.\\n{1} : La créature ciblée de force supérieure ou égale à 5 est indestructible ce tour-ci.', 'type': 'Créature : bête', 'flavor': 'Peu de Nayens osent chasser les gargantuesques. Ils ne sont pas considérés comme des animaux, mais comme des forces de la nature, tels les glissements de terrain ou les typhons.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188613&type=card', 'language': 'French', 'identifiers': {'scryfallId': '020d8242-1b7c-47ca-bb69-c48d3bf76973', 'multiverseId': 188613}, 'multiverseid': 188613}, {'name': 'Behemoth Spezzalancia', 'text': 'Il Behemoth Spezzalancia è indistruttibile.\\n{1}: Una creatura bersaglio con forza pari o superiore a 5 è indistruttibile in questo turno.', 'type': 'Creatura — Bestia', 'flavor': 'Pochi abitanti di Naya osano cacciare i mastodonti. Non sono considerati animali ma piuttosto forze della natura, quali frane e tifoni.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188364&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd3b23107-444d-4774-a13c-d32de069d6b5', 'multiverseId': 188364}, 'multiverseid': 188364}, {'name': '槍折りのビヒモス', 'text': '槍折りのビヒモスは破壊されない。\\n{1}：パワーが５以上のクリーチャー１体を対象とする。このターン、それは破壊されない。', 'type': 'クリーチャー — ビースト', 'flavor': 'ガルガンチュアンを狩ろうとするナヤ人はほとんどいない。 彼らにとって、それは動物ではなく、崖崩れや台風のような自然の力なのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187119&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '14a79647-887b-4184-b9e6-44cd19649682', 'multiverseId': 187119}, 'multiverseid': 187119}, {'name': 'Behemoth Quebra-Lanças', 'text': 'Behemoth Quebra-Lanças é indestrutível.\\n{1}: A criatura alvo com poder maior ou igual a 5 é indestrutível neste turno.', 'type': 'Criatura — Besta', 'flavor': 'São poucos os nayanos que ousam caçar os gargantuas. Eles não são considerados animais, mas forças da natureza, assim como os deslizamentos de terra ou os furacões.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188115&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a0470ed6-67f0-467d-954e-c58aa3327859', 'multiverseId': 188115}, 'multiverseid': 188115}, {'name': 'Ломающее Копья Чудище', 'text': 'Ломающее Копья Чудище не может быть уничтожено.\\n{1}: целевое существо с силой 5 или больше не может быть уничтожено в этом ходу.', 'type': 'Существо — Зверь', 'flavor': 'Немногие обитатели Найи осмеливаются охотиться на исполинов. Они считаются не зверьем, а силами природы, подобно оползням и тайфунам.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188862&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'afa089b8-ba8d-4736-9ebd-4bd29718e068', 'multiverseId': 188862}, 'multiverseid': 188862}, {'name': '破矛贝西摩斯', 'text': '破矛贝西摩斯不会毁坏。\\n{1}：目标力量大于或等于5的生物本回合不会毁坏。', 'type': '生物～野兽', 'flavor': '很少有纳雅人胆敢狩猎巨兽。 他们不被当成动物看待，而是当作山崩或台风这类自然之力。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187368&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2e712199-1999-44df-bfd9-ad884c48831c', 'multiverseId': 187368}, 'multiverseid': 187368}]", '[{\'name\': \'Sphinx-Souverän\', \'text\': \'Fliegend\\nDu erhältst am Ende deines Zuges 3 Lebenspunkte dazu, falls der Sphinx-Souverän ungetappt ist. Sonst verliert jeder Gegner 3 Lebenspunkte.\', \'type\': \'Artefaktkreatur — Sphinx\', \'flavor\': \'„Was bläst ohne Mund, flüstert ohne Stimme, beißt ohne Zähne und legt sich, ohne je gestanden zu haben?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187663&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ade6f83a-71de-43eb-b424-a2c27eb2e2ae\', \'multiverseId\': 187663}, \'multiverseid\': 187663}, {\'name\': \'Esfinge soberana\', \'text\': \'Vuela.\\nAl final de tu turno, ganas 3 vidas si la Esfinge soberana está enderezada. De lo contrario, cada oponente pierde 3 vidas.\', \'type\': \'Criatura artefacto — Esfinge\', \'flavor\': \'"¿Qué se levanta sin piernas, susurra sin voz, muerde sin dientes y muere sin tener vida?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187912&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'134f775a-5f84-4c4e-b103-690ef73705c2\', \'multiverseId\': 187912}, \'multiverseid\': 187912}, {\'name\': \'Souveraine sphinxiale\', \'text\': \'Vol\\nÀ la fin de votre tour, vous gagnez 3 points de vie si la Souveraine sphinxiale est dégagée. Sinon, chaque adversaire perd 3 points de vie.\', \'type\': \'Créature-artefact : Sphinx\', \'flavor\': "« Qu\'est-ce qui se lève sans jambes, murmure sans voix, mord sans dent et meurt sans avoir jamais vécu ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188659&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f823e8f9-de20-4650-af26-6d4cfcdf9fa1\', \'multiverseId\': 188659}, \'multiverseid\': 188659}, {\'name\': \'Sfinge Sovrana\', \'text\': \'Volare\\nAlla fine del tuo turno, guadagni 3 punti vita se la Sfinge Sovrana è STAPpata. Altrimenti, ogni avversario perde 3 punti vita.\', \'type\': \'Creatura Artefatto — Sfinge\', \'flavor\': \'"Cosa si alza senza gambe, mormora senza voce, sferza senza frusta e muore senza essere vivo?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188410&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b16e3bb1-8927-4952-a5c0-e90b4ae838aa\', \'multiverseId\': 188410}, \'multiverseid\': 188410}, {\'name\': \'スフィンクスの君主\', \'text\': \'飛行\\nあなたのターンの終了時に、スフィンクスの君主がアンタップ状態ならあなたは３点のライフを得る。 そうでない場合、各対戦相手はそれぞれ３点のライフを失う。\', \'type\': \'アーティファクト・クリーチャー — スフィンクス\', \'flavor\': \'「足無くて立ち、曲無くて舞い、刃無くて切り、生無くて死すものは何か？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187165&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92aea1bd-5226-4c3c-b453-d99cb5a5de5a\', \'multiverseId\': 187165}, \'multiverseid\': 187165}, {\'name\': \'Soberano da Esfinge\', \'text\': \'Voar\\nNo final de seu turno, você ganhará 3 pontos de vida se Soberano da Esfinge estiver desvirado. Do contrário, cada oponente perde 3 pontos de vida.\', \'type\': \'Criatura Artefato — Esfinge\', \'flavor\': \'"O que se levanta sem ter pés, sussurra sem ter voz, arranca sem ter braços e morre sem ter vida?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188161&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e47b11a2-0bd2-41a5-bbce-bae6e004652c\', \'multiverseId\': 188161}, \'multiverseid\': 188161}, {\'name\': \'Сфинкс-Владыка\', \'text\': \'Полет\\nВ конце вашего хода вы получаете 3 жизни, если Сфинкс-Владыка не повернут. В противном случае каждый оппонент теряет 3 жизни.\', \'type\': \'Артефактное Существо — Сфинкс\', \'flavor\': \'«Что поднимается, но не на ноги, шепчет, но без голоса, кусает, но без зубов, и умирает, не родившись?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188908&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2ff58f52-61ef-49d3-b357-61dc96c48f69\', \'multiverseId\': 188908}, \'multiverseid\': 188908}, {\'name\': \'史芬斯君王\', \'text\': \'飞行\\n在你的回合结束时，如果史芬斯君王未横置，则你获得3点生命。 若否，则每位对手各失去3点生命。\', \'type\': \'神器生物～史芬斯\', \'flavor\': \'「什么东西不用脚也能起身，不出声却能细语，没牙齿也能咬，没生命却会死？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187414&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d3ceaef-5f75-401c-a425-a2eb4d9fb21f\', \'multiverseId\': 187414}, \'multiverseid\': 187414}]', '[{\'name\': \'Sphäre des Gedankenblocks\', \'text\': \'Spieler können keine Bibliotheken durchsuchen.\', \'type\': \'Artefakt\', \'flavor\': \'Räuberische Mechaniker durchstöberten einst die Ödlande der Gezeitenleere, bauten unerlaubt Golems und bedrohten die Vorherrschaft der Sphingen. Die Sphären beendeten dies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187518&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'727800fd-4e5c-43b6-9b68-2844c580c153\', \'multiverseId\': 187518}, \'multiverseid\': 187518}, {\'name\': \'Orbe trabamentes\', \'text\': \'Los jugadores no pueden buscar en bibliotecas.\', \'type\': \'Artefacto\', \'flavor\': \'Los mecanicistas independientes vagaban por los yermos de Marea Hueca, construyendo gólems no autorizados para amenazar la hegemonía de las esfinges. Las orbes detuvieron eso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187767&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'20338f70-9915-41d7-aee3-6bdcf3161b2e\', \'multiverseId\': 187767}, \'multiverseid\': 187767}, {\'name\': \'Orbe bloquesprit\', \'text\': \'Les joueurs ne peuvent pas chercher dans leur bibliothèque.\', \'type\': \'Artefact\', \'flavor\': "Des mécanistes rebelles fouillaient jadis les landes de la Mer creuse et y construisaient des golems interdits qui menaçaient l\'hégémonie des sphinx. Les orbes y ont mis fin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188514&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd21d78c-2db9-4358-8d33-5f3973f73cd2\', \'multiverseId\': 188514}, \'multiverseid\': 188514}, {\'name\': \'Globo Bloccamente\', \'text\': \'I giocatori non possono passare in rassegna i grimori.\', \'type\': \'Artefatto\', \'flavor\': "I meccanicisti farabutti un tempo rovistavano tra i rifiuti di Mareacava, costruendo golem non autorizzati per minacciare l\'egemonia delle sfingi. I globi misero fine a tutto ciò.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188265&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e46da639-a85f-46e9-a0a1-a61948ea6a41\', \'multiverseId\': 188265}, \'multiverseid\': 188265}, {\'name\': \'精神固めの宝珠\', \'text\': \'プレイヤーはライブラリーから探せない。\', \'type\': \'アーティファクト\', \'flavor\': \'かつてならず者の機械技師達が、潮の虚ろのゴミを漁り、我流で組んだゴーレムでスフィンクスの支配を脅かしたことがある。 それを止めたのはこの宝玉だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187020&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c1e302f-f48e-41dc-bc56-4d225bdeefab\', \'multiverseId\': 187020}, \'multiverseid\': 187020}, {\'name\': \'Orbe do Bloqueio Mental\', \'text\': \'Os jogadores não podem procurar em grimórios.\', \'type\': \'Artefato\', \'flavor\': \'Antigamente, os mecanistas ladinos exploravam a Grota das Marés, construindo golens ilegais para ameaçar a hegemonia das esfinges. Os orbes puseram um fim nisso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188016&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3dbcce9e-4d3b-4de2-a19d-be36e01c7380\', \'multiverseId\': 188016}, \'multiverseid\': 188016}, {\'name\': \'Замыкатель Разума\', \'text\': \'Игроки не могут искать в библиотеках.\', \'type\': \'Артефакт\', \'flavor\': \'Непутевые маги-механики когда-то прочесывали свалки Приливных Пещер в поисках утиля, чтобы изготовить запрещенных големов, замахнувшись на гегемонию сфинксов. «Замыкатели» положили этому конец.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188763&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ac30dc1a-0a65-44aa-b2d1-6284bb662bca\', \'multiverseId\': 188763}, \'multiverseid\': 188763}, {\'name\': \'锁灵法球\', \'text\': \'牌手不能搜寻牌库。\', \'type\': \'神器\', \'flavor\': \'反抗的机械师曾在潮窟的荒地四处翻拣，私下构组魔像好用来威胁史芬斯的霸权。 这法球让他们无法得逞。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187269&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cef6b80-eee2-4ac2-a0a2-f47763682dcc\', \'multiverseId\': 187269}, \'multiverseid\': 187269}]', "[{'name': 'Spiegel des Lichs', 'text': 'Falls du das Spiel verlieren würdest, mische stattdessen die Karten auf deiner Hand, in deinem Friedhof und alle bleibenden Karten, die du besitzt, in deine Bibliothek. Ziehe dann sieben Karten. Dein Lebenspunktestand wird 20.', 'type': 'Artefakt', 'flavor': 'Er zeigt dir nicht, was du bist, sondern was du warst.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187677&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4a6a32ce-1ae8-4c85-94d3-30f6f1acfb22', 'multiverseId': 187677}, 'multiverseid': 187677}, {'name': 'Espejo del liche', 'text': 'Si fueras a perder el juego, en vez de eso, baraja tu mano, cementerio y todos los permanentes de los cuales eres propietario en tu biblioteca, luego roba siete cartas y tu total de vidas es 20.', 'type': 'Artefacto', 'flavor': 'No te muestra lo que eres, sino lo que fuiste.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187926&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7591dffa-583c-4876-bf3f-2ed62eeb65b1', 'multiverseId': 187926}, 'multiverseid': 187926}, {'name': 'Miroir de la liche', 'text': 'Si vous deviez perdre la partie, à la place, mélangez votre main, votre cimetière et tous les permanents que vous possédez dans votre bibliothèque, piochez ensuite sept cartes et votre total de points de vie devient 20.', 'type': 'Artefact', 'flavor': 'Il ne montre pas ce que vous êtes, mais ce que vous étiez.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188673&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c4edd0cd-a871-40fb-ac87-c5423e8041bc', 'multiverseId': 188673}, 'multiverseid': 188673}, {'name': 'Specchio del Lich', 'text': 'Se stai per perdere la partita, rimescola invece la tua mano, il tuo cimitero e tutti i permanenti che possiedi nel tuo grimorio, poi pesca sette carte e i tuoi punti vita diventano 20.', 'type': 'Artefatto', 'flavor': 'Mostra non ciò che sei ma ciò che eri.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188424&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2a0c183f-1fde-453d-a76e-11fe45ed86a8', 'multiverseId': 188424}, 'multiverseid': 188424}, {'name': '死者の鏡', 'text': 'あなたがこのゲームに敗北する場合、代わりにあなたの手札とあなたの墓地とあなたがオーナーであるすべてのパーマネントをあなたのライブラリーに加えて切り直し、その後カードを７枚引き、あなたのライフの総量を20点にする。', 'type': 'アーティファクト', 'flavor': 'それが映すのは、あるべきお前ではなく、ありしお前。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187179&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4442819a-08d8-4869-80ab-6a86da385160', 'multiverseId': 187179}, 'multiverseid': 187179}, {'name': 'Espelho do Lich', 'text': 'Se você for perder o jogo, em vez disso, embaralhe sua mão, seu cemitério e todas as suas permanentes no seu grimório, depois compre sete cards e o seu total de pontos de vida se torna 20.', 'type': 'Artefato', 'flavor': 'Ele não mostra o que você é, mas o que você era.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188175&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9837e9b6-77c0-4e02-9e32-a87ed73daedd', 'multiverseId': 188175}, 'multiverseid': 188175}, {'name': 'Зеркало Лича', 'text': 'Если вы должны проиграть партию, вместо этого втасуйте вашу руку, ваше кладбище и все перманенты, владельцем которых вы являетесь, в вашу библиотеку, затем возьмите семь карт, и ваше количество жизней становится 20.', 'type': 'Артефакт', 'flavor': 'Оно показывает, не какой вы сейчас, а каким вы были раньше.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188922&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '09023c57-89ca-47c0-b462-b2f4daabe9dd', 'multiverseId': 188922}, 'multiverseid': 188922}, {'name': '巫妖秘镜', 'text': '若你将输掉这盘对战，则改为将你的手牌、坟墓场与所有你拥有的永久物洗入你的牌库，然后抓七张牌且你的总生命成为20。', 'type': '神器', 'flavor': '映照出的不是你，而是过去的你。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187428&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '749248e5-f26e-46ac-a127-81ac1e5d8a14', 'multiverseId': 187428}, 'multiverseid': 187428}]", '[{\'name\': \'Splitter-Sphinx\', \'text\': \'Fliegend\\nImmer wenn eine Artefaktkreatur, die du kontrollierst, einem Spieler Kampfschaden zufügt, kannst du einen 1/1 blauen Thopter-Artefaktkreaturenspielstein mit Flugfähigkeit ins Spiel bringen.\', \'type\': \'Artefaktkreatur — Sphinx\', \'flavor\': \'Ob es mechanischen oder biologischen Ursprungs ist, das Leben findet immer ein Mittel, um sich fortzupflanzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187522&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b8b3e05-5e0a-46c0-afb3-d873e38e9a58\', \'multiverseId\': 187522}, \'multiverseid\': 187522}, {\'name\': \'Esfinge fragmentadora\', \'text\': \'Vuela.\\nSiempre que una criatura artefacto que controles haga daño de combate a un jugador, puedes poner en juego una ficha de criatura artefacto Tóptero azul 1/1 con la habilidad de volar.\', \'type\': \'Criatura artefacto — Esfinge\', \'flavor\': \'Ya sea mecánica o biológica, la vida encuentra maneras de auto propagarse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187771&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa80ab6b-9bf7-44e4-907f-474a640a8dac\', \'multiverseId\': 187771}, \'multiverseid\': 187771}, {\'name\': \'Sphinge écailleuse\', \'text\': "Vol\\nÀ chaque fois qu\'une créature-artefact que vous contrôlez inflige des blessures de combat à un joueur, vous pouvez mettre en jeu un jeton de créature-artefact 1/1 bleue Mécanoptère avec le vol.", \'type\': \'Créature-artefact : Sphinx\', \'flavor\': \'Mécanique ou biologique, la vie trouve toujours le moyen de se propager.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188518&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9492c00a-08ae-415c-bcd4-42f6e3ecd242\', \'multiverseId\': 188518}, \'multiverseid\': 188518}, {\'name\': \'Sfinge Frammentata\', \'text\': \'Volare\\nOgniqualvolta una creatura artefatto che controlli infligge danno da combattimento a un giocatore, puoi mettere in gioco una pedina creatura artefatto Tottero 1/1 blu con volare.\', \'type\': \'Creatura Artefatto — Sfinge\', \'flavor\': \'Che sia meccanica o biologica, la vita trova sempre il modo di propagarsi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188269&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1dc6b6a4-4a04-4cb8-860d-291e2575b8ae\', \'multiverseId\': 188269}, \'multiverseid\': 188269}, {\'name\': \'破片撒きのスフィンクス\', \'text\': \'飛行\\nあなたがコントロールするアーティファクト・クリーチャーが１体いずれかのプレイヤーに戦闘ダメージを与えるたび、あなたは飛行を持つ青の１/１の飛行機械・アーティファクト・クリーチャー・トークンを１体場に出してもよい。\', \'type\': \'アーティファクト・クリーチャー — スフィンクス\', \'flavor\': \'機械だろうと生物だろうと、生命というものは増殖の道を見つけるものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187024&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80fb2275-ea83-4b6f-9c7b-93abbfe37ca5\', \'multiverseId\': 187024}, \'multiverseid\': 187024}, {\'name\': \'Esfinge Fragmentável\', \'text\': \'Voar\\nToda vez que uma criatura artefato que você controla causa dano de combate a um jogador, você pode colocar em jogo uma ficha de criatura artefato azul 1/1 do tipo Tóptero com voar.\', \'type\': \'Criatura Artefato — Esfinge\', \'flavor\': \'Seja de forma mecânica ou biológica, a vida sempre encontra um modo de se propagar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188020&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5bb14180-5f2d-48bd-8429-f055da91cd6a\', \'multiverseId\': 188020}, \'multiverseid\': 188020}, {\'name\': \'Осколочный Сфинкс\', \'text\': \'Полет\\nКаждый раз, когда артефактное существо под вашим контролем наносит боевые повреждения игроку, вы можете положить в игру одну фишку артефактного существа 1/1 синий Топтер с Полетом.\', \'type\': \'Артефактное Существо — Сфинкс\', \'flavor\': \'Механическая или биологическая, жизнь находит способы размножаться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188767&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'76d1f938-fe68-4796-abd4-0721309c5344\', \'multiverseId\': 188767}, \'multiverseid\': 188767}, {\'name\': \'舞翼史芬斯\', \'text\': \'飞行\\n每当由你操控的一个神器生物对牌手造成战斗伤害时，你可以将一个1/1蓝色，具飞行异能的振翼机神器生物衍生物放置进场。\', \'type\': \'神器生物～史芬斯\', \'flavor\': \'不论机械生命或生体生命，都有办法繁衍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187273&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'feb25eb1-23bc-4d8c-b689-d0f874bb81df\', \'multiverseId\': 187273}, \'multiverseid\': 187273}]', '[{\'name\': \'Sprießendes Thrinax\', \'text\': \'Wenn das Sprießende Thrinax aus dem Spiel auf den Friedhof gelegt wird, bringe drei 1/1 grüne Saproling-Kreaturenspielsteine ins Spiel.\', \'type\': \'Kreatur — Eidechse\', \'flavor\': \'Die riesige Nahrungskette in Jund hat dazu geführt, dass sich manche seltsamen Lebewesen daran angepasst haben, gefressen zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7fb87016-d67e-47a5-856a-75ad1783bb94\', \'multiverseId\': 187664}, \'multiverseid\': 187664}, {\'name\': \'Thrinax germinante\', \'text\': \'Cuando el Thrinax germinante vaya a un cementerio desde el juego, pon en juego tres fichas de criatura Saprolín verdes 1/1.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'La enorme red de depredadores de Jund ha logrado que algunas extrañas criaturas se adapten a ser comidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187913&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03c7b92e-ef11-4246-b45b-e5a11981ab57\', \'multiverseId\': 187913}, \'multiverseid\': 187913}, {\'name\': \'Thrinax bourgeonnant\', \'text\': \'Quand le Thrinax bourgeonnant est mis dans un cimetière depuis le jeu, mettez en jeu trois jetons de créature 1/1 verte Saprobionte.\', \'type\': \'Créature : lézard\', \'flavor\': "Le cycle alimentaire de Jund a provoqué d\'étranges adaptations chez certaines créatures.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188660&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9c8db986-5207-41a3-bb9e-2dc08cdae6d2\', \'multiverseId\': 188660}, \'multiverseid\': 188660}, {\'name\': \'Thrinax dei Germogli\', \'text\': \'Quando il Thrinax dei Germogli viene messo in un cimitero dal gioco, metti in gioco tre pedine creatura Saprolingio 1/1 verdi.\', \'type\': \'Creatura — Lucertola\', \'flavor\': \'La vasta rete di predatori in Jund ha addirittura fatto sì che alcune strane creature si adattassero a essere mangiate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188411&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1fa76dd4-04dd-4b1a-9bc8-1784c4d8cdef\', \'multiverseId\': 188411}, \'multiverseid\': 188411}, {\'name\': \'芽吹くトリナクス\', \'text\': \'芽吹くトリナクスが場からいずれかの墓地に置かれたとき、緑の１/１の苗木・クリーチャー・トークンを３体場に出す。\', \'type\': \'クリーチャー — トカゲ\', \'flavor\': \'ジャンドの巨大な食物連鎖の網は、食われるべき奇妙な生き物を生み出した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187166&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35fb1cf8-a159-492b-b45e-0fab4a9c43ac\', \'multiverseId\': 187166}, \'multiverseid\': 187166}, {\'name\': \'Trinax Germinante\', \'text\': \'Quando Trinax Germinante for colocado no cemitério vindo do jogo, coloque em jogo três fichas de criatura verdes 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'A vasta rede de predação de Jund na verdade fez com que algumas estranhas criaturas se adaptassem a serem comidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f50abab3-d4ea-4efe-be5b-98f662e87477\', \'multiverseId\': 188162}, \'multiverseid\': 188162}, {\'name\': \'Разрастающийся Тринакс\', \'text\': \'Когда Разрастающийся Тринакс попадает из игры на кладбище, положите в игру три фишки существа 1/1 зеленый Сапролинг.\', \'type\': \'Существо — Ящер\', \'flavor\': \'Повсеместное хищничество на Джанде заставило некоторые необычные существа приспособиться к тому, что их поедают.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188909&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'295a2d01-dc02-4b05-ada9-639beb455ee4\', \'multiverseId\': 188909}, \'multiverseid\': 188909}, {\'name\': \'芽生叉齿蜥\', \'text\': \'当芽生叉齿蜥从场上置入坟墓场时，将三个1/1绿色腐生物衍生物放置进场。\', \'type\': \'生物～蜥蜴\', \'flavor\': \'勇得的广大猎捕关系网路，造成某些奇怪生物专门担任给吃掉的角色。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187415&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44e35125-34ce-4b33-9bdf-059693fcaae7\', \'multiverseId\': 187415}, \'multiverseid\': 187415}]', '[{\'name\': \'Stahlgepanzerte Schlange\', \'text\': \'Die Stahlgepanzerte Schlange kann nicht angreifen, falls du nicht ein anderes Artefakt kontrollierst.\', \'type\': \'Artefaktkreatur — Schlange\', \'flavor\': \'„Von den höchsten Türmen bis in die Tiefe des Meeres muss alles Leben mit Ätherium erfüllt werden." —Lodus der Äthergläubige\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187526&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'17793db8-2c11-4a7e-b65b-298ccb934f97\', \'multiverseId\': 187526}, \'multiverseid\': 187526}, {\'name\': \'Serpiente acorazada\', \'text\': \'La Serpiente acorazada no puede atacar a menos que controles otro artefacto.\', \'type\': \'Criatura artefacto — Serpiente\', \'flavor\': \'"Desde las más altas torres hasta el fondo del mar, toda la vida debe ser tocada por eterium." —Lodus de los etereados\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187775&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61936058-7584-4eac-8def-d798caff699d\', \'multiverseId\': 187775}, \'multiverseid\': 187775}, {\'name\': "Serpent à l\'habit d\'acier", \'text\': "Le Serpent à l\'habit d\'acier ne peut pas attaquer à moins que vous ne contrôliez un autre artefact.", \'type\': \'Créature-artefact : serpent\', \'flavor\': "« Des plus hautes tours aux mers les plus profondes, toute vie doit être touchée par l\'étherium. » —Lodus des Éthermentés", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188522&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d5a5a44-ef01-4096-9ac9-54eea5c9a84f\', \'multiverseId\': 188522}, \'multiverseid\': 188522}, {\'name\': \'Serpe Corazzata\', \'text\': \'La Serpe Corazzata non può attaccare a meno che tu non controlli un altro artefatto.\', \'type\': \'Creatura Artefatto — Serpe\', \'flavor\': \'"Dalle torri più alte ai mari più profondi, ogni forma di vita deve avere un contatto con l\\\'eterium." —Lodus degli Eterici\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188273&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd5e4a02-60bc-4286-914e-6e5ed555af2c\', \'multiverseId\': 188273}, \'multiverseid\': 188273}, {\'name\': \'鋼覆いの海蛇\', \'text\': \'鋼覆いの海蛇は、あなたが他のアーティファクトをコントロールしていないかぎり攻撃できない。\', \'type\': \'アーティファクト・クリーチャー — 海蛇\', \'flavor\': \'「最も高い塔の上から最も深い海の底まで、全ての生命はエーテリウムに触れねばならぬ。」 ――エーテル宣誓会のローダス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187028&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a11ee00-d5c7-40d2-a46b-313778836cc8\', \'multiverseId\': 187028}, \'multiverseid\': 187028}, {\'name\': \'Serpente Blindada\', \'text\': \'Serpente Blindada não pode atacar, a menos que você controle outro artefato.\', \'type\': \'Criatura Artefato — Serpente\', \'flavor\': \'"Desde as torres mais altas até o mais profundo dos mares, todas as formas de vida devem ser tocadas pelo etherium." — Lodus, dos Etherólatras\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188024&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'765e16f8-bc65-4649-90fa-4679c829d80e\', \'multiverseId\': 188024}, \'multiverseid\': 188024}, {\'name\': \'Покрытый Сталью Змей\', \'text\': \'Покрытый Сталью Змей не может атаковать, если только под вашим контролем нет другого артефакта.\', \'type\': \'Артефактное Существо — Змей\', \'flavor\': \'«От высочайших башен до глубочайших морских пучин эфирий должен коснуться всего живого». — Лодус из ордена Эфироблюстителей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188771&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2621967a-e790-49cb-9e4e-079028eaf49f\', \'multiverseId\': 188771}, \'multiverseid\': 188771}, {\'name\': \'覆铁巨蛇\', \'text\': \'除非你操控其他神器，否则覆铁巨蛇不能进行攻击。\', \'type\': \'神器生物～巨蛇\', \'flavor\': \'「从最高的塔到最深的海，其间所有生物都该感受乙金。」 ～乙金盟的罗得斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187277&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d9c3231-11ce-47f5-b956-81874f7d38e6\', \'multiverseId\': 187277}, \'multiverseid\': 187277}]', '[{\'name\': \'Steinwerfer-Kolonne\', \'text\': \'{4}{G}: Die Steinwerfer-Kolonne fügt allen fliegenden Kreaturen und allen Spielern 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Nashorn, Soldat\', \'flavor\': \'„Avior-Banditen können äußerst frech sein. Du musst schon den Himmel mit Felsbrocken füllen, und dann sofort in Deckung gehen." —Rittmeister Wyhorn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187490&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7cba4b73-4154-4813-a4cd-82f43ffb5b1e\', \'multiverseId\': 187490}, \'multiverseid\': 187490}, {\'name\': \'Pelotón arrojapiedras\', \'text\': \'{4}{G}: El Pelotón arrojapiedras hace 2 puntos de daño a cada criatura con la habilidad de volar y a cada jugador.\', \'type\': \'Criatura — Soldado rinoceronte\', \'flavor\': \'"Los bandidos aven pueden ser taimados. Debes llenar el cielo de rocas, y buscar cobertura de inmediato." —Caballero capitán Wyhorn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187739&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7d5c59d9-10ad-4207-97a2-381d1c88d30e\', \'multiverseId\': 187739}, \'multiverseid\': 187739}, {\'name\': \'Régiment lanceroc\', \'text\': \'{4}{G} : Le Régiment lanceroc inflige 2 blessures à chaque créature avec le vol et à chaque joueur.\', \'type\': \'Créature : rhinocéros et soldat\', \'flavor\': \'« Les bandits avemains sont rusés. Il faut cribler le ciel de rochers — et trouver immédiatement un abri. » —Capitaine de chevalerie Wykorn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188486&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c6fa7ca-d7a7-4078-bff6-a3c004b1e121\', \'multiverseId\': 188486}, \'multiverseid\': 188486}, {\'name\': \'Plotone Scagliasassi\', \'text\': \'{4}{G}: Il Plotone Scagliasassi infligge 2 danni a ogni creatura con volare e a ogni giocatore.\', \'type\': \'Creatura — Soldato Rinoceronte\', \'flavor\': \'"I banditi aviani possono essere scaltri. Devi riempire il cielo di macigni... e poi metterti subito al riparo." —Capitano Wyhorn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188237&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8eab6d5-02b2-4b67-921a-a1a8d3399e39\', \'multiverseId\': 188237}, \'multiverseid\': 188237}, {\'name\': \'岩投げの小隊\', \'text\': \'{4}{G}：岩投げの小隊は、飛行を持つ各クリーチャーと各プレイヤーにそれぞれ２点のダメージを与える。\', \'type\': \'クリーチャー — サイ・兵士\', \'flavor\': \'「エイヴンの賊はずる賢い。 空が埋まるほどに石弾を撃って――その後にすぐ隠れなきゃいけなくなるんだから。」 ――ワイホーン騎士長\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=186992&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'043601e5-8113-4508-989e-d5e27ba8e40c\', \'multiverseId\': 186992}, \'multiverseid\': 186992}, {\'name\': \'Pelotão Lança-Pedra\', \'text\': \'{4}{G}: Pelotão Lança-Pedra causa 2 pontos de dano a cada criatura com voar e a cada jogador.\', \'type\': \'Criatura — Rinoceronte Soldado\', \'flavor\': \'"Os bandidos avíneos são ardilosos. É preciso bombardear os céus com pedras e procurar abrigo imediatamente." — Cavaleiro-Capitão Wyhorn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187988&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2476aba1-d8a6-4170-8f56-4462f1dd5e00\', \'multiverseId\': 187988}, \'multiverseid\': 187988}, {\'name\': \'Взвод Камнеметателей\', \'text\': \'{4}{G}: Взвод Камнеметателей наносит 2 повреждения каждому существу с Полетом и каждому игроку.\', \'type\': \'Существо — Носорог Солдат\', \'flavor\': \'«Крылатые бандиты бывают ловкими. Надо закидать небо камнями и сразу же искать укрытия». — Рыцарь-капитан Уайгорн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188735&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'79e97745-5c0f-4f9c-a588-8477c25009bb\', \'multiverseId\': 188735}, \'multiverseid\': 188735}, {\'name\': \'掷石排\', \'text\': \'{4}{G}：掷石排对每位牌手和每个具飞行异能的生物造成2点伤害。\', \'type\': \'生物～犀牛／士兵\', \'flavor\': \'「艾文强盗相当狡猾。 你得先往天上撒满石头～然后立刻寻找掩蔽。」 ～骑士队长外鸿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187241&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f23d76ca-a562-4fbf-b564-776c288b2f2d\', \'multiverseId\': 187241}, \'multiverseid\': 187241}]', '[{\'name\': \'Stillmacher aus Vectis\', \'text\': \'{2}{B}: Die Stillmacher aus Vectis erhalten Todesberührung bis zum Ende des Zuges. (Immer wenn sie einer Kreatur Schaden zufügen, zerstöre jene Kreatur.)\', \'type\': \'Artefaktkreatur — Mensch, Räuber\', \'flavor\': \'Selbst in Esper gibt es Leute, die Magie scheuen und einfachere Methoden bevorzugen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad86d955-e834-49c2-a956-4713df3d269a\', \'multiverseId\': 187529}, \'multiverseid\': 187529}, {\'name\': \'Silenciadores de Vectis\', \'text\': \'{2}{B}: Los Silenciadores de Vectis ganan la habilidad de toque mortal hasta el final del turno. (Siempre que hagan daño a una criatura, destruye esa criatura.)\', \'type\': \'Criatura artefacto — Bribón humano\', \'flavor\': \'Incluso en Esper están aquellos que dejan de lado el uso de la magia por métodos más simples.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187778&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9455e061-587d-44ab-bcbe-473364b3e8d6\', \'multiverseId\': 187778}, \'multiverseid\': 187778}, {\'name\': \'Museleurs de Vectis\', \'text\': "{2}{B} : Les Museleurs de Vectis acquièrent le contact mortel jusqu\'à la fin du tour. (À chaque fois qu\'ils infligent des blessures à une créature, détruisez la créature blessée.)", \'type\': \'Créature-artefact : humain et gredin\', \'flavor\': "Même sur Esper, il y en a qui s\'abstiennent d\'utiliser la magie, lui préférant des méthodes plus simples.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188525&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1ee7d9d-ba70-4252-8ae2-b5d66eb67813\', \'multiverseId\': 188525}, \'multiverseid\': 188525}, {\'name\': \'Silenziatori di Vectis\', \'text\': \'{2}{B}: I Silenziatori di Vectis hanno tocco letale fino alla fine del turno. (Ogniqualvolta questa creatura infligge danno a una creatura, distruggi quella creatura.)\', \'type\': \'Creatura Artefatto — Farabutto Umano\', \'flavor\': "Perfino in Esper, c\'è chi evita l\'uso della magia in favore di metodi più semplici.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188276&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aff68608-dffe-4014-9b34-e05c52a0b77a\', \'multiverseId\': 188276}, \'multiverseid\': 188276}, {\'name\': \'ヴェクティスの口封じ\', \'text\': \'{2}{B}：ヴェクティスの口封じはターン終了時まで接死を得る。 （それがいずれかのクリーチャーにダメージを与えるたび、そのクリーチャーを破壊する。）\', \'type\': \'アーティファクト・クリーチャー — 人間・ならず者\', \'flavor\': \'より単純な方法を優先して魔法を避ける者は、エスパーにすら存在する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187031&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'662750f6-10ed-43e4-8b1e-e9d45543db10\', \'multiverseId\': 187031}, \'multiverseid\': 187031}, {\'name\': \'Silenciadores de Vectis\', \'text\': \'{2}{B}: Silenciadores de Vectis ganha toque mortífero até o final do turno. (Toda vez que esta criatura causar dano a outra criatura, destrua aquela criatura.)\', \'type\': \'Criatura Artefato — Humano Ladino\', \'flavor\': \'Mesmo em Esper, existem aqueles que preferem evitar o uso da magia, favorecendo métodos mais simples.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188027&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'369effae-57f0-462f-8eb9-103f7620d120\', \'multiverseId\': 188027}, \'multiverseid\': 188027}, {\'name\': \'Усмирители из Вектиса\', \'text\': \'{2}{B}: Усмирители из Вектиса получают Смертельное касание до конца хода. (Каждый раз, когда они наносят повреждения существу, уничтожьте то существо.)\', \'type\': \'Артефактное Существо — Человек Бродяга\', \'flavor\': \'Даже на Эспере есть те, кто отказывается от магии, предпочитая более простые методы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188774&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a90e9de3-f715-486d-9609-f3a572861d4a\', \'multiverseId\': 188774}, \'multiverseid\': 188774}, {\'name\': \'纬提断音客\', \'text\': \'{2}{B}：纬提断音客获得死触异能直到回合结束。 （每当此生物对任一生物造成伤害时，消灭后者。）\', \'type\': \'神器生物～人类／浪客\', \'flavor\': \'就算在艾斯波，也有些人讨厌使用法术，而偏好更简单的解决之道。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187280&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9b975a1-8898-4a2b-9cf6-8af42ba38b81\', \'multiverseId\': 187280}, \'multiverseid\': 187280}]', '[{\'name\': \'Stoischer Engel\', \'text\': \'Fliegend, Wachsamkeit\\nSpieler können nicht mehr als eine Kreatur während ihres Enttappsegments enttappen.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Selbst die kampferfahrensten Krieger halten sich in seiner Anwesenheit zurück und gönnen sich einen Augenblick der Selbstprüfung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187666&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d0fd4db3-25d1-430a-b677-0e31dfd9e2bc\', \'multiverseId\': 187666}, \'multiverseid\': 187666}, {\'name\': \'Ángel estoico\', \'text\': \'Vuela, vigilancia.\\nLos jugadores no pueden enderezar más de una criatura durante sus pasos de enderezar.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Hasta los soldados más fogueados en la batalla se inmovilizan en su presencia para meditar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187915&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'473c6bbb-eef1-4abd-a5fd-2f6b051bc8b8\', \'multiverseId\': 187915}, \'multiverseid\': 187915}, {\'name\': \'Ange stoïque\', \'text\': "Vol, vigilance\\nLes joueurs ne peuvent pas dégager plus d\'une créature pendant leurs étapes de dégagement.", \'type\': \'Créature : ange\', \'flavor\': "Même les soldats les plus endurcis marquent une pause d\'introspection en sa présence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188662&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe76a848-b431-41d4-9db7-e384be3b6900\', \'multiverseId\': 188662}, \'multiverseid\': 188662}, {\'name\': \'Angelo Stoico\', \'text\': \'Volare, cautela\\nI giocatori non possono STAPpare più di una creatura durante il loro STAP.\', \'type\': \'Creatura — Angelo\', \'flavor\': \'Perfino i soldati più temprati dalla battaglia si fermano in sua presenza per un momento di introspezione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188413&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8fb2214a-9fd7-4a8b-b797-86a65dee817e\', \'multiverseId\': 188413}, \'multiverseid\': 188413}, {\'name\': \'冷静な天使\', \'text\': \'飛行、警戒\\nプレイヤーは自分のアンタップ・ステップに、クリーチャーを１体しかアンタップできない。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'戦場で鍛えられた兵士でも、彼女の前では内省に思わず立ち止まる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187168&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7a4def5-73d6-4be8-87ba-9b129a0602a7\', \'multiverseId\': 187168}, \'multiverseid\': 187168}, {\'name\': \'Anjo Estóico\', \'text\': \'Voar, vigilância\\nOs jogadores não podem desvirar mais de uma criatura durante suas etapas de desvirar.\', \'type\': \'Criatura — Anjo\', \'flavor\': \'Até mesmo os soldados mais endurecidos pela batalha fazem uma pausa em sua presença para um momento de introspecção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188164&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'973843d8-8ee2-4095-9cf0-2ab944a010a6\', \'multiverseId\': 188164}, \'multiverseid\': 188164}, {\'name\': \'Стоический Ангел\', \'text\': \'Полет, Бдительность\\nИгроки не могут развернуть более одного существа во время своих шагов разворота.\', \'type\': \'Существо — Ангел\', \'flavor\': \'Даже самые закаленные в битвах солдаты замирают в ее присутствии, погружаясь в самосозерцание.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188911&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f06c74c5-5818-4ff0-a96e-5ffdf533f863\', \'multiverseId\': 188911}, \'multiverseid\': 188911}, {\'name\': \'寡欲天使\', \'text\': \'飞行，警戒\\n每位牌手在其重置步骤所重置的生物不能多于一个。\', \'type\': \'生物～天使\', \'flavor\': \'当她现身，就连身经百战的士兵都不由得停手自省。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187417&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ae7433a7-8217-4bc2-bd0a-eb2c8f4e4a5a\', \'multiverseId\': 187417}, \'multiverseid\': 187417}]', '[{\'name\': \'Strandschnapper\', \'text\': \'{U}: Der Strandschnapper erhält Inseltarnung bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Die Kathari, die widerwärtige Avior-Art in Grixis, lernten schnell, dass die Leichen an der Küste eher Fallen als Leckerbissen waren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187554&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f633232-4487-428b-9c6c-4543cc762d85\', \'multiverseId\': 187554}, \'multiverseid\': 187554}, {\'name\': \'Mordedor costero\', \'text\': \'{U}: El Mordedor costero gana la habilidad de cruzar islas hasta el final del turno.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Los Kathari, los débiles aven de Grixis, aprendieron que los cuerpos en la costa son más trampa que bocado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187803&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9103115-7a70-46c7-b03f-70c5fc0e09ba\', \'multiverseId\': 187803}, \'multiverseid\': 187803}, {\'name\': \'Claqueur des côtes\', \'text\': "{U} : Le Claqueur des côtes acquiert la traversée des îles jusqu\'à la fin du tour.", \'type\': \'Créature : bête\', \'flavor\': \'Les katharis, les avemains maladifs de Grixis, ont appris que les cadavres proches de la côte sont le plus souvent des pièges.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188550&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7776e76e-2cc1-4a7b-82c8-62a8fe3485ed\', \'multiverseId\': 188550}, \'multiverseid\': 188550}, {\'name\': \'Mordente Costiero\', \'text\': \'{U}: Il Mordente Costiero ha passa-Isole fino alla fine del turno.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'I Kathari, i deboli aviani di Grixis, hanno imparato che i cadaveri sulla costa sono più una trappola che non un banchetto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188301&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2b3adf43-08ac-4bb8-8451-ab2fbf248427\', \'multiverseId\': 188301}, \'multiverseid\': 188301}, {\'name\': \'岸の噛みつき\', \'text\': \'{U}：岸の噛みつきはターン終了時まで島渡りを得る。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'グリクシスの病弱なエイヴンのカターリは、海岸の死体はご馳走ではなく罠であることを学んでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187056&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'917ff677-e92d-4c34-b331-1345bd75d00f\', \'multiverseId\': 187056}, \'multiverseid\': 187056}, {\'name\': \'Abocanhador Costeiro\', \'text\': \'{U}: Abocanhador Costeiro ganha travessia de ilha até o final do turno.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Kathari, o avíneo adoentado de Grixis, aprendeu que os cadáveres da orla estão mais para cilada do que petisco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188052&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'acb91211-c361-4e94-a719-0a5a1f77a205\', \'multiverseId\': 188052}, \'multiverseid\': 188052}, {\'name\': \'Береговой Зубохват\', \'text\': \'{U}: Береговой Зубохват получает Знание Островов до конца хода.\', \'type\': \'Существо — Зверь\', \'flavor\': \'Катари, хилые крылатые существа Гриксиса, поняли на собственной шкуре, что прибитые к берегу трупы являются скорее западней, нежели лакомством.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188799&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'19172938-2fbd-410d-870f-054cc4ed42ed\', \'multiverseId\': 188799}, \'multiverseid\': 188799}, {\'name\': \'海岸快嘴兽\', \'text\': \'{U}：海岸快嘴兽获得海岛行者异能直到回合结束。\', \'type\': \'生物～野兽\', \'flavor\': \'卡刹立是格利极的恶心艾文，已经学到了海岸线的死尸多半是陷阱而非大餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187305&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73ef82c4-49c1-476a-b621-38c43683cf51\', \'multiverseId\': 187305}, \'multiverseid\': 187305}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187705&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5242498b-6067-47a8-9719-ee0d9b7109fe', 'multiverseId': 187705}, 'multiverseid': 187705}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187954&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '77b8ab0a-d4e1-4261-bd68-f69d1daac197', 'multiverseId': 187954}, 'multiverseid': 187954}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188701&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd63bc8ba-b25d-40c3-a8ca-d80274aa9a02', 'multiverseId': 188701}, 'multiverseid': 188701}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188452&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b5467b8f-6265-487b-afee-cf784408a666', 'multiverseId': 188452}, 'multiverseid': 188452}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187207&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c1b76dd0-9b0b-45a9-bcc7-945190c25d0f', 'multiverseId': 187207}, 'multiverseid': 187207}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188203&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5280a651-879a-40c2-bf05-430c1d7d21a6', 'multiverseId': 188203}, 'multiverseid': 188203}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=188950&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'dbd43bc3-2aa6-419f-bff3-e282524ca4f2', 'multiverseId': 188950}, 'multiverseid': 188950}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187456&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a52667e0-c4b4-4646-807d-059ce2746954', 'multiverseId': 187456}, 'multiverseid': 187456}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=187706&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bbd1a424-bc34-4df0-9755-e84bee27f08b', 'multiverseId': 187706}, 'multiverseid': 187706}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http: