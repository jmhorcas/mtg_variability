type: ['Artifact', 'Artifact Creature — Construct', 'Artifact Creature — Cyborg Advisor', 'Artifact Creature — Cyborg Angel', 'Artifact Creature — Cyborg Knight', 'Artifact — Equipment', 'Creature — Avatar', 'Creature — Bird Advisor', 'Creature — Demon Beast Grandchild', 'Creature — Demon Child', 'Creature — Dog', 'Creature — Elemental', 'Creature — Goblin Mutant', 'Creature — Goblin Rigger', 'Creature — Human Spy', 'Creature — Hydra Dog', 'Creature — Squirrel Noble Advisor', 'Creature — Troll Ninja', 'Creature — Wurm', 'Enchantment', 'Enchantment — Aura', 'Host Artifact Creature — Angel', 'Instant', 'Land', 'Legendary Artifact', 'Legendary Creature', 'Legendary Creature — Bird Knight', 'Legendary Creature — Brainiac Villain', 'Legendary Creature — Clamfolk Advisor Rebel', 'Legendary Creature — Elephant Rogue', 'Legendary Creature — Goblin Warrior', 'Legendary Creature — Human Designer', 'Legendary Creature — Human Gamer', 'Legendary Creature — Human Noble', 'Legendary Creature — Human Spy', 'Legendary Creature — Human Villain', 'Legendary Creature — Squirrel', 'Legendary Creature — Wombat Bat Chameleon', 'Legendary Creature — Zombie Villain', 'Legendary Planeswalker — B.O.B.', 'Sorcery', 'Summon — Dinosaur']
