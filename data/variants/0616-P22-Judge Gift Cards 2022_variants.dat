name: ['Animate Dead', 'Greater Auramancy', 'Growing Rites of Itlimoc // Itlimoc, Cradle of the Sun', 'No Mercy', 'Omniscience', 'Parallel Lives', 'Purphoros, God of the Forge', 'Smothering Tithe', 'Stranglehold', 'Training Grounds']
multiverse_id: []
layout: ['normal', 'transform']
names: []
mana_cost: ['{1}{B}', '{1}{W}', '{2}{B}{B}', '{2}{G}', '{3}{G}', '{3}{R}', '{3}{W}', '{7}{U}{U}{U}', '{U}']
cmc: ['1.0', '10.0', '2.0', '3.0', '4.0']
colors: ['B', 'G', 'R', 'U', 'W']
