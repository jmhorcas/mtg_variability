type: ['Artifact', 'Artifact Creature — Bird', 'Artifact Creature — Construct', 'Artifact Creature — Golem', 'Artifact Creature — Shapeshifter', 'Artifact Creature — Soldier', 'Artifact Creature — Wall', 'Creature — Djinn', 'Creature — Efreet', 'Creature — Elephant', 'Creature — Faerie', 'Creature — Fish', 'Creature — Goblin Artificer', 'Creature — Human', 'Creature — Human Bird', 'Creature — Human Rogue', 'Creature — Human Wizard', 'Creature — Jackal', 'Creature — Ogre', 'Creature — Orc', 'Creature — Phyrexian Demon', 'Creature — Snake', 'Creature — Spirit', 'Creature — Turtle', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', "Land — Urza's Mine", "Land — Urza's Power-Plant", "Land — Urza's Tower", 'Sorcery']
