name: ["Commander's Sphere", 'Food Chain', 'Lord of Atlantis', 'Merchant Scroll', 'Nin, the Pain Artist', 'Rhystic Study', "Teferi's Protection", 'Vampiric Tutor']
multiverse_id: []
