subtypes: ['Aura', 'Baddest,', 'Beast', 'Biggest,', 'Bird', 'Cat', 'Clamfolk', 'Construct', 'Cow', 'Devil', 'Egg', 'Elves', 'Etiquette', 'Forest', 'Gamer', 'Goblin', 'Gus', 'Human', 'Imp', 'Island', 'Knight', 'Lady', 'Lizard', 'Lobster', 'Minotaur', 'Mountain', 'Nastiest,', 'Noble', 'Ogre', 'Plains', 'Proper', 'Spirit', 'Swamp', 'The', 'Zombie', 'of']
