type: ['Artifact', 'Artifact Creature — Bird', 'Artifact Creature — Cat', 'Artifact Creature — Construct', 'Artifact Creature — Lizard', 'Artifact Creature — Lobster', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Beast', 'Creature — Bird', 'Creature — Bird Noble', 'Creature — Bird Spirit', 'Creature — Clamfolk', 'Creature — Cow', 'Creature — Egg', 'Creature — Elves', 'Creature — Goblin', 'Creature — Gus', 'Creature — Imp', 'Creature — Knight', 'Creature — Lady of Proper Etiquette', 'Creature — Minotaur', 'Creature — Ogre', 'Creature — The Biggest, Baddest, Nastiest,', 'Creature — Zombie', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Legendary Creature — Devil', 'Legendary Creature — Human Gamer', "Scariest Creature You'll Ever See", 'Sorcery']
