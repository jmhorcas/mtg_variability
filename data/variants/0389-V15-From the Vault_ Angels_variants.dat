name: ['Akroma, Angel of Fury', 'Akroma, Angel of Wrath', 'Archangel of Strife', 'Aurelia, the Warleader', 'Avacyn, Angel of Hope', 'Baneslayer Angel', 'Entreat the Angels', 'Exalted Angel', 'Iona, Shield of Emeria', 'Iridescent Angel', 'Jenara, Asura of War', 'Lightning Angel', 'Platinum Angel', 'Serra Angel', 'Tariel, Reckoner of Souls']
