om/Handlers/Image.ashx?multiverseid=390278&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c26eb3cc-46ee-4fd5-835a-6538de77bc0a', 'multiverseId': 390278}, 'multiverseid': 390278}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391626&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '98df4b6d-25d3-4825-8171-c80e14e160c2', 'multiverseId': 391626}, 'multiverseid': 391626}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390615&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9012da5f-47e8-41d9-989c-18554b87169d', 'multiverseId': 390615}, 'multiverseid': 390615}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390952&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '09135897-5b2a-4331-8365-470336c22de6', 'multiverseId': 390952}, 'multiverseid': 390952}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391289&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '96cfaab5-bc9f-43d4-bb18-4a57fac3eb6a', 'multiverseId': 391289}, 'multiverseid': 391289}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389941&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ec31d48f-826a-4350-9491-ba3b8d9fb4ec', 'multiverseId': 389941}, 'multiverseid': 389941}]", '[{\'name\': \'Gedankenfang\', \'text\': \'Jeder andere Spieler wirft eine Karte ab. Du ziehst für jede auf diese Weise abgeworfene Karte eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'Wenn die Temperamente aufwallen, ist es nicht schwierig, den Kopf zu verlieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390384&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d15ac119-18b4-4839-9bb7-11ac68fcba02\', \'multiverseId\': 390384}, \'multiverseid\': 390384}, {\'name\': \'Extraer la mente\', \'text\': \'Cada otro jugador descarta una carta. Roba una carta por cada carta descartada de esta manera.\', \'type\': \'Conjuro\', \'flavor\': \'Cuando se pierden los estribos, es fácil perder la cabeza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391732&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fe43ef5-b956-4133-b945-17680c7d4756\', \'multiverseId\': 391732}, \'multiverseid\': 391732}, {\'name\': "Siphonner l\'esprit", \'text\': "Chaque autre joueur se défausse d\'une carte. Vous piochez une carte pour chaque carte défaussée de cette manière.", \'type\': \'Rituel\', \'flavor\': \'Les têtes brûlées perdent facilement la tête.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390721&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'283a4de1-d5bc-4431-be6d-de1c174ee2e0\', \'multiverseId\': 390721}, \'multiverseid\': 390721}, {\'name\': \'Riflusso della Mente\', \'text\': \'Ogni altro giocatore scarta una carta. Tu peschi una carta per ogni carta scartata in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': \'Quando gli animi sono accesi, è facile perdere la testa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391058&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c1e3104-ea32-454b-9f6e-f6144f9e2fd5\', \'multiverseId\': 391058}, \'multiverseid\': 391058}, {\'name\': \'吸心\', \'text\': \'他の各プレイヤーはそれぞれカードを１枚捨てる。あなたはこれにより捨てられたカード１枚につき、カードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'アツくなる奴は、すぐ自分を見失う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391395&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1cfef3b-93f2-493b-95a6-d046dcc6b361\', \'multiverseId\': 391395}, \'multiverseid\': 391395}, {\'name\': \'吸收心灵\', \'text\': \'其他每位牌手各弃一张牌。每以此法弃掉一张牌，你便抓一张牌。\', \'type\': \'法术\', \'flavor\': \'情绪高涨时，很容易失去理智。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390047&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cb4ec775-9508-4263-875c-748132112fe2\', \'multiverseId\': 390047}, \'multiverseid\': 390047}]', '[{\'name\': \'Gedankenstein\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere den Gedankenstein: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'„Was ist Mana anderes als Möglichkeit, eine Idee, der noch nicht Gestalt gegeben wurde?" —Jhoira, Meisterbastlerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390270&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bea161ec-ae17-4e12-8d49-4f737ac1ecf7\', \'multiverseId\': 390270}, \'multiverseid\': 390270}, {\'name\': \'Piedra mental\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar la Piedra mental: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'"¿Qué es el maná sino una posibilidad, una idea a la que todavía no se ha dado forma?" —Jhoira, maestra artífice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391618&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34535d8e-6d53-440c-a7a0-91c99b5e826e\', \'multiverseId\': 391618}, \'multiverseid\': 391618}, {\'name\': "Pierre de l\'esprit", \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez la Pierre de l\'esprit : Piochez une carte.", \'type\': \'Artefact\', \'flavor\': "« Qu\'est-ce que le mana sinon une possibilité, une idée qui n\'a pas encore pris forme ? » —Djoïra, maîtresse artificière", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390607&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1a638e2-c74e-48e1-8772-c46ae2f9911f\', \'multiverseId\': 390607}, \'multiverseid\': 390607}, {\'name\': \'Pietra della Mente\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica la Pietra della Mente: Pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': \'"Cos\\\'è il mana se non una possibilità, un\\\'idea che ancora non ha preso forma?" —Jhoira, maestra artefice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390944&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eeb8277c-0ddf-456d-b760-006293a46b4f\', \'multiverseId\': 390944}, \'multiverseid\': 390944}, {\'name\': \'精神石\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, 精神石を生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'「マナはまだ形を成していない発想よ。それが可能性でなければ何だというの？」 ――工芸の達人、ジョイラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391281&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'95c4f424-0981-4070-8e4d-b74e37bbbbf8\', \'multiverseId\': 391281}, \'multiverseid\': 391281}, {\'name\': \'心灵石\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲心灵石：抓一张牌。\', \'type\': \'神器\', \'flavor\': \'「法术力是尚无定形的理念，那这无穷的可能性又是什么？」 ～神器大师尤依拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389933&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'810185ca-f5ed-4e68-bbc4-0f088fdce91c\', \'multiverseId\': 389933}, \'multiverseid\': 389933}]', '[{\'name\': \'Gedankenverdreher\', \'text\': \'Morph {1}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Gedankenverdreher aufgedeckt wird, verändere das Ziel eines Zauberspruchs oder einer Fähigkeit deiner Wahl, der bzw. die nur ein einzelnes Ziel hat.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390422&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae057a7b-0da9-4473-9b9c-974626a39134\', \'multiverseId\': 390422}, \'multiverseid\': 390422}, {\'name\': \'Doblegavoluntades\', \'text\': \'Metamorfosis {1}{U}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Doblegavoluntades se ponga boca arriba, cambia el objetivo del hechizo o la habilidad objetivo que tenga un solo objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391770&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8bc3c2db-05e0-46f3-97b3-6337da851a4d\', \'multiverseId\': 391770}, \'multiverseid\': 391770}, {\'name\': \'Plieur de volonté\', \'text\': \'Mue {1}{U} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand le Plieur de volonté est retourné face visible, changez la cible du sort ou de la capacité avec une cible unique.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390759&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'222333bf-5636-4dce-83d2-072cffd70a5a\', \'multiverseId\': 390759}, \'multiverseid\': 390759}, {\'name\': \'Soggiogatore\', \'text\': "Metamorfosi {1}{U} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando il Soggiogatore viene girato a faccia in su, cambia il bersaglio di una magia o di un\'abilità bersaglio con un singolo bersaglio.", \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391096&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'47473ce2-c0ce-4514-9c74-55aa717652b6\', \'multiverseId\': 391096}, \'multiverseid\': 391096}, {\'name\': \'意志を曲げる者\', \'text\': \'変異{1}{U}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n意志を曲げる者が表向きになったとき、単一の対象を持つ、呪文１つか能力１つを対象とし、それの対象を変更する。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391433&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49a1eb7c-db0d-47bb-9c17-253d21f6d02c\', \'multiverseId\': 391433}, \'multiverseid\': 391433}, {\'name\': \'曲愿师\', \'text\': \'变身{1}{U}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当曲愿师翻回正面时，为仅指定单一目标的目标咒语或异能更改目标。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390085&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9f8e9708-2bf3-480c-86a8-2b0bd8cc09ee\', \'multiverseId\': 390085}, \'multiverseid\': 390085}]', '[{\'name\': \'Geisterprozession\', \'text\': \'Bringe drei 1/1 weiße Geist-Kreaturenspielsteine mit Flugfähigkeit ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': \'„Den Toten geht es ohnehin gut. Sie müssen nicht mehr leiden. Wenn das Stören ihrer Ruhe den Lebenden hilft, sollen sie sich nicht beklagen." —Olka, Nebelwiesenhexe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390359&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b44fcf8d-8248-42fc-a4e1-d0858e53c144\', \'multiverseId\': 390359}, \'multiverseid\': 390359}, {\'name\': \'Procesión espectral\', \'text\': \'Pon en el campo de batalla tres fichas de criatura Espíritu blancas 1/1 con la habilidad de volar.\', \'type\': \'Conjuro\', \'flavor\': \'"Es fácil para los muertos. Ya no sufren. Si perturbar su descanso ayuda a los vivos, que así sea". —Olka, bruja de Pradera Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391707&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'973d4bec-11c5-4ac3-8d4e-1b04ffbbd7d7\', \'multiverseId\': 391707}, \'multiverseid\': 391707}, {\'name\': \'Procession spectrale\', \'text\': \'Mettez sur le champ de bataille trois jetons de créature 1/1 blanche Esprit avec le vol.\', \'type\': \'Rituel\', \'flavor\': \'« Les morts ont de la chance, ils ne souffrent plus. On peut bien interrompre leur repos pour aider les vivants. » —Olka, envoûteuse de Brumeprairie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390696&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b070cd6-4400-4278-9b54-6a516ae98fbe\', \'multiverseId\': 390696}, \'multiverseid\': 390696}, {\'name\': \'Processione Spettrale\', \'text\': \'Metti sul campo di battaglia tre pedine creatura Spirito 1/1 bianche con volare.\', \'type\': \'Stregoneria\', \'flavor\': \'"Per i morti è semplice. Loro non soffrono più. Se interrompere il loro riposo può aiutare i viventi, così sia." —Olka, strega della Prateria Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'818cbcc0-e411-4a9a-925a-328e52c0953b\', \'multiverseId\': 391033}, \'multiverseid\': 391033}, {\'name\': \'幽体の行列\', \'text\': \'飛行を持つ白の１/１のスピリット・クリーチャー・トークンを３体戦場に出す。\', \'type\': \'ソーサリー\', \'flavor\': \'「死んだ奴らは安らかさ。これ以上苦しまないんだからね。生きてるもののためにその眠りを覚ますんなら、それはそれじゃないか。」 ――ミストメドウの魔女、オルカ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391370&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c939a8ef-e53d-475f-a3b3-f098f854cc57\', \'multiverseId\': 391370}, \'multiverseid\': 391370}, {\'name\': \'幽灵行列\', \'text\': \'将三个1/1白色，具飞行异能的精怪衍生生物放进战场。\', \'type\': \'法术\', \'flavor\': \'「死人可以轻松胜任；它们再也不会感到伤痛。如果打扰它们的安眠能帮助活人，那就作吧。」 ～雾牧地巫师欧卡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390022&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'744331c8-c5a0-44b5-a9f2-176501298a98\', \'multiverseId\': 390022}, \'multiverseid\': 390022}]', "[{'name': 'Geisterviertel', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}, opfere das Geisterviertel: Zerstöre ein Land deiner Wahl. Dessen Beherrscher kann seine Bibliothek nach einer Standardland-Karte durchsuchen, diese ins Spiel bringen und dann seine Bibliothek mischen.', 'type': 'Land', 'flavor': 'Verlassen, aber nicht unbewohnt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390208&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cab00ff6-a6e0-4578-b59d-2b0fb48ab84f', 'multiverseId': 390208}, 'multiverseid': 390208}, {'name': 'Cuartel fantasmal', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}, sacrificar el Cuartel fantasmal: Destruye la tierra objetivo. Su controlador puede buscar en su biblioteca una carta de tierra básica, ponerla en el campo de batalla y luego barajar su biblioteca.', 'type': 'Tierra', 'flavor': 'Abandonado, pero no deshabitado.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391556&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '115d4e6a-c04c-4e88-ba96-5739664d17e0', 'multiverseId': 391556}, 'multiverseid': 391556}, {'name': 'Quartier fantôme', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T}, sacrifiez le Quartier fantôme : Détruisez le terrain ciblé. Son contrôleur peut chercher dans sa bibliothèque une carte de terrain de base, la mettre sur le champ de bataille et mélanger ensuite sa bibliothèque.', 'type': 'Terrain', 'flavor': 'Désert, mais pas inhabité.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390545&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5167333a-bb54-4903-aa13-e5ba9de01ba8', 'multiverseId': 390545}, 'multiverseid': 390545}, {'name': 'Quartiere Fantasma', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}, Sacrifica il Quartiere Fantasma: Distruggi una terra bersaglio. Il suo controllore può passare in rassegna il suo grimorio per una carta terra base, metterla sul campo di battaglia, poi rimescolare il suo grimorio.', 'type': 'Terra', 'flavor': 'Abbandonato, ma non disabitato.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390882&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'aa2918f0-a549-47ec-af27-28e110e5f8c9', 'multiverseId': 390882}, 'multiverseid': 390882}, {'name': '幽霊街', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}, 幽霊街を生け贄に捧げる：土地１つを対象とし、それを破壊する。それのコントローラーは自分のライブラリーから基本土地・カードを１枚探してもよい。そうしたなら、それを戦場に出し、その後自分のライブラリーを切り直す。', 'type': '土地', 'flavor': '見捨てられてはいるが、誰もいない訳ではない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391219&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1efeb395-3913-4cc7-9fa2-ee666b072fb7', 'multiverseId': 391219}, 'multiverseid': 391219}, {'name': '魂魅城区', 'text': '{T}：加{1}到你的法术力池中。\\n{T}，牺牲魂魅城区：消灭目标地。该地的操控者可以从其牌库中搜寻一张基本地牌，将之放进战场，然后将其牌库洗牌。', 'type': '地', 'flavor': '遭人遗弃，但并非没有居民。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389871&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5d4b0d5d-fcd2-4d02-97f2-8d59a56697e6', 'multiverseId': 389871}, 'multiverseid': 389871}]", '[{\'name\': \'Gemeinsames Bewusstsein\', \'text\': \'Ziehe für jede Kreatur, die du kontrollierst, eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Die wilden Bestien sind meine Sinne. All mein Wissen beziehe ich durch ihre Augen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390138&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24f9018a-8c2a-4d11-ac1f-c77957711042\', \'multiverseId\': 390138}, \'multiverseid\': 390138}, {\'name\': \'Inconsciente colectivo\', \'text\': \'Roba una carta por cada criatura que controlas.\', \'type\': \'Conjuro\', \'flavor\': \'"Las bestias en libertad son mis sentidos. Será a través de sus ojos que todo el conocimiento vendrá a mí".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391486&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d5addfe-5ea3-4824-a665-51b25b2e900e\', \'multiverseId\': 391486}, \'multiverseid\': 391486}, {\'name\': \'Inconscient collectif\', \'text\': \'Piochez une carte pour chaque créature que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "« Les bêtes sauvages sont mes sens. C\'est par leurs yeux que me parvient la connaissance. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b299d0c3-ac7c-4b90-93b5-d573078d15f8\', \'multiverseId\': 390475}, \'multiverseid\': 390475}, {\'name\': \'Inconscio Collettivo\', \'text\': \'Pesca una carta per ogni creatura che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le bestie selvagge sono i miei sensi. È attraverso i loro occhi che tutta la conoscenza verrà a me."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390812&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1615332e-535c-44cd-866e-fd7aa550da5d\', \'multiverseId\': 390812}, \'multiverseid\': 390812}, {\'name\': \'集団潜在意識\', \'text\': \'あなたがコントロールするクリーチャー１体につきカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「野生の獣は私の五感だ。その目を通して、すべての知識が流れ込んでくる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391149&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d547512e-3fee-40c5-b8ef-5f5e56dba3ce\', \'multiverseId\': 391149}, \'multiverseid\': 391149}, {\'name\': \'集体潜意识\', \'text\': \'你每操控一个生物，便抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「原野众兽为我感官，从其眼底得识万物。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389801&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8759621d-f303-41bc-9d5d-48f663270488\', \'multiverseId\': 389801}, \'multiverseid\': 389801}]', '[{\'name\': \'Geniale Anwandlung\', \'text\': \'Ein Spieler deiner Wahl zieht X Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'Nach hundert missglückten Experimenten war Urza fassungslos, als er merkte, dass normales Silber das Portal unbeschädigt passieren konnte. Sofort entwickelte er einen Golem, der ganz aus diesem Metall bestand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390371&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b4ffe63e-7748-4c59-ae67-ad121c56cb11\', \'multiverseId\': 390371}, \'multiverseid\': 390371}, {\'name\': \'Golpe de ingenio\', \'text\': \'El jugador objetivo roba X cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'Tras cien experimentos fallidos, a Urza le sorprendió descubrir que la plata común pasaba a través del portal sin sufrir daños. De inmediato, diseñó un gólem de ese mismo metal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391719&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9ef6224-7e3b-4726-acd1-c15a9fdf86e8\', \'multiverseId\': 391719}, \'multiverseid\': 391719}, {\'name\': \'Éclair de génie\', \'text\': \'Le joueur ciblé pioche X cartes.\', \'type\': \'Éphémère\', \'flavor\': "« Ce n\'est pas un cerveau que j\'ai, c\'est comme de la sauce blanche ! » s\'écria Urza, se rendant compte, après une centaine d\'échecs, que le vil argent passait sans dommage à travers le portail temporel. Il fabriqua aussitôt un golem de cette matière.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390708&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'08b803b0-036a-4bb9-b429-e47b439b38d2\', \'multiverseId\': 390708}, \'multiverseid\': 390708}, {\'name\': \'Colpo di Genio\', \'text\': \'Un giocatore bersaglio pesca X carte.\', \'type\': \'Istantaneo\', \'flavor\': \'Dopo un centinaio di esperimenti falliti, Urza rimase sconcertato nello scoprire che il comune argento poteva passare indenne attraverso il portale. Cominciò subito a progettare un golem fatto di quel metallo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aebadeac-d504-442d-90df-3e876fcbc43f\', \'multiverseId\': 391045}, \'multiverseid\': 391045}, {\'name\': \'天才のひらめき\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードをＸ枚引く。\', \'type\': \'インスタント\', \'flavor\': \'実験に百回も失敗したあと、ウルザは普通の銀が何の問題もなく門を通り抜けることを発見して驚いた。彼はすぐに銀製のゴーレムをデザインした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391382&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1786302c-6fc1-49af-a9a8-b54b69325254\', \'multiverseId\': 391382}, \'multiverseid\': 391382}, {\'name\': \'神来一笔\', \'text\': \'目标牌手抓X张牌。\', \'type\': \'瞬间\', \'flavor\': \'在一百多次实验失败后，克撒惊觉一般的银可以通过时光通道而不受伤害。于是他立刻设计了一个银魔像。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390034&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'530001ea-7ace-436e-808d-0edb1b90662d\', \'multiverseId\': 390034}, \'multiverseid\': 390034}]', '[{\'name\': \'Geralf der Leichenflicker\', \'text\': \'{2}{U}, {T}: Jeder Spieler legt die obersten drei Karten seiner Bibliothek auf seinen Friedhof. Schicke bis zu zwei Kreaturenkarten, die auf diese Weise auf den Friedhof gelegt wurden, ins Exil. Bringe einen X/X blauen Zombie-Kreaturenspielstein ins Spiel, wobei X der Gesamtstärke der Karten entspricht, die auf diese Weise ins Exil geschickt wurden.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390368&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'45ea2dd7-0f3b-426c-8681-27b4dd5570af\', \'multiverseId\': 390368}, \'multiverseid\': 390368}, {\'name\': \'Suturador Geralf\', \'text\': \'{2}{U}, {T}: Cada jugador pone las tres primeras cartas de su biblioteca en su cementerio. Exilia hasta dos cartas de criatura puestas en los cementerios de esta manera. Pon en el campo de batalla una ficha de criatura Zombie azul X/X, donde X es igual a la fuerza total de las cartas exiliadas de esta manera.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391716&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1925e1c-5b10-4beb-9e1c-24621bebce72\', \'multiverseId\': 391716}, \'multiverseid\': 391716}, {\'name\': \'Geralf, raccommodeur\', \'text\': "{2}{U}, {T} : Chaque joueur met les trois cartes du dessus de sa bibliothèque dans son cimetière. Exilez jusqu\'à deux cartes de créature mises dans des cimetières de cette manière. Mettez sur le champ de bataille un jeton de créature X/X bleue Zombie, X étant la force totale des cartes exilées de cette manière.", \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390705&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4988e25f-157e-4a17-84c7-ea8789b05e06\', \'multiverseId\': 390705}, \'multiverseid\': 390705}, {\'name\': \'Cucitore Geralf\', \'text\': \'{2}{U}, {T}: Ogni giocatore mette nel proprio cimitero le prime tre carte del proprio grimorio. Esilia fino a due carte creatura messe nei cimiteri in questo modo. Metti sul campo di battaglia una pedina creatura Zombie X/X blu, dove X è la forza totale delle carte esiliate in questo modo.\', \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391042&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70546c98-456a-481c-93fd-86515da0c0a3\', \'multiverseId\': 391042}, \'multiverseid\': 391042}, {\'name\': \'縫い師、ゲラルフ\', \'text\': \'{2}{U}, {T}：各プレイヤーはそれぞれ、自分のライブラリーの一番上から３枚のカードを自分の墓地に置く。これにより墓地に置かれたクリーチャー・カードを最大２体まで追放する。青のＸ/Ｘのゾンビ・クリーチャー・トークンを１体戦場に出す。Ｘはこれにより追放されたカードのパワーの合計に等しい。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391379&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dfc75e67-25b3-4a6b-bc3f-dbcaab01fd29\', \'multiverseId\': 391379}, \'multiverseid\': 391379}, {\'name\': \'拼接师基拉夫\', \'text\': \'{2}{U}，{T}：每位牌手各将其牌库顶的三张牌置入其坟墓场。放逐至多两张以此法置入坟墓场的生物牌。将一个X/X蓝色灵俑衍生生物放进战场，X为以此法放逐之牌力量的总和。\', \'type\': \'传奇生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390031&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd7b5c95-6d2f-40c9-9f65-dd0e8b270fb2\', \'multiverseId\': 390031}, \'multiverseid\': 390031}]', '[{\'name\': \'Gerechte Strafe\', \'text\': \'Verhindere allen Schaden, der dir oder Planeswalkern, die du kontrollierst, in diesem Zug von Quellen, die du nicht kontrollierst, zugefügt würde. Falls auf diese Weise Schaden aus einer Quelle, die eine Kreatur ist, verhindert wurde, fügt die Gerechte Strafe dieser Kreatur entsprechend viele Schadenspunkte zu. Falls auf diese Weise Schaden aus einer Quelle, die keine Kreatur ist, verhindert wurde, fügt die Gerechte Strafe dem Beherrscher der Quelle entsprechend viele Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390139&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35a7e245-9054-49af-b135-b00b3b784d9e\', \'multiverseId\': 390139}, \'multiverseid\': 390139}, {\'name\': \'Castigo merecido\', \'text\': \'Prevén todo el daño que fueran a hacer fuentes que no controlas a ti y a los planeswalkers que controlas este turno. Si se previene daño de una fuente de criatura de esta manera, el Castigo merecido hace la misma cantidad de daño a esa criatura. Si se previene daño de una fuente que no sea criatura de esta manera, el Castigo merecido hace la misma cantidad de daño al controlador de la fuente.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391487&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c06f89fb-2332-4d6f-af6d-8e5c6a048e95\', \'multiverseId\': 391487}, \'multiverseid\': 391487}, {\'name\': \'Sort bien mérité\', \'text\': "Prévenez, ce tour-ci, toutes les blessures qui devraient être infligées à vous et aux planeswalkers que vous contrôlez par des sources que vous ne contrôlez pas. Si les blessures d\'une source créature sont prévenues de cette manière, le Sort bien mérité inflige autant de blessures à cette créature. Si les blessures d\'une source non-créature sont prévenues de cette manière, le Sort bien mérité inflige autant de blessures au contrôleur de cette source.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390476&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a6d5c92-df92-45a6-8ec7-93df863de088\', \'multiverseId\': 390476}, \'multiverseid\': 390476}, {\'name\': \'Castigo Meritato\', \'text\': \'Previeni tutto il danno che verrebbe inflitto in questo turno a te e ai planeswalker che controlli da fonti che non controlli. Se viene prevenuto in questo modo il danno da una fonte creatura, il Castigo Meritato infligge altrettanti danni a quella creatura. Se viene prevenuto in questo modo il danno da una fonte non creatura, il Castigo Meritato infligge altrettanti danni al controllore di quella fonte.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390813&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'09d66d62-168d-4210-9ff3-eb196980ceb4\', \'multiverseId\': 390813}, \'multiverseid\': 390813}, {\'name\': \'誅罰\', \'text\': \'あなたがコントロールしていない発生源があなたまたはあなたがコントロールするプレインズウォーカーに与えるすべてのダメージを軽減する。クリーチャーである発生源からのダメージがこれにより軽減されたなら、誅罰はそのクリーチャーにそのダメージと同じ点数のダメージを与える。クリーチャーでない発生源からのダメージがこれにより軽減されたなら、誅罰はその発生源のコントローラーにそのダメージと同じ点数のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391150&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c4fc642-47d2-47f8-abbc-d78e6ba8f663\', \'multiverseId\': 391150}, \'multiverseid\': 391150}, {\'name\': \'自业自得\', \'text\': \'于本回合中，防止不由你操控的来源将对你和由你操控的鹏洛客造成的所有伤害。如果以此法防止了某个来源为生物的伤害，则自业自得对该生物造成等量的伤害。如果以此法防止了某个来源为非生物的伤害，则自业自得对该来源的操控者造成等量的伤害。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389802&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2b67af52-87dd-4493-96fa-2d6c36dfaff3\', \'multiverseId\': 389802}, \'multiverseid\': 389802}]', '[{\'name\': \'Gisa die Ghulruferin\', \'text\': \'{B}, {T}, opfere eine andere Kreatur: Bringe X 2/2 schwarze Zombie-Kreaturenspielsteine ins Spiel, wobei X gleich der Stärke der geopferten Kreatur ist.\', \'type\': \'Legendäre Kreatur — Mensch, Zauberer\', \'flavor\': \'„Musst du immer jammern, Geralf? Ich habe gar nichts versprochen. Ich werde Ghule auferwecken, wann immer es mir beliebt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390209&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'622ddd7f-afe8-4b4e-a67b-ec6d895f02e6\', \'multiverseId\': 390209}, \'multiverseid\': 390209}, {\'name\': \'Gisa, la llamamuertos\', \'text\': \'{B}, {T}, sacrificar otra criatura: Pon en el campo de batalla X fichas de criatura Zombie negras 2/2, donde X es la fuerza de la criatura sacrificada.\', \'type\': \'Criatura legendaria — Hechicero humano\', \'flavor\': \'"Geralf, ¿tienes que quejarte siempre? No te prometí nada. Alzaré necrófagos cuando yo quiera".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391557&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83c069b3-3617-4e92-854b-f185c54a9de9\', \'multiverseId\': 391557}, \'multiverseid\': 391557}, {\'name\': \'Gisa, meneuse de goule\', \'text\': \'{B}, {T}, sacrifiez une autre créature : Mettez sur le champ de bataille X jetons de créature 2/2 noire Zombie, X étant la force de la créature sacrifiée.\', \'type\': \'Créature légendaire : humain et sorcier\', \'flavor\': "« Geralf, vas-tu cesser de te plaindre ? Je ne t\'ai rien promis. Je lèverai des goules quand il me plaira. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390546&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25a42490-a03b-4a71-b446-25e739f1d744\', \'multiverseId\': 390546}, \'multiverseid\': 390546}, {\'name\': "Gisa l\'Evocaghoul", \'text\': "{B}, {T}, Sacrifica un\'altra creatura: Metti sul campo di battaglia X pedine creatura Zombie 2/2 nere, dove X è la forza della creatura sacrificata.", \'type\': \'Creatura Leggendaria — Mago Umano\', \'flavor\': \'"Smettila di piagnucolare, Geralf. Non ho mai accettato le tue regole. Evoco i miei ghoul quando mi pare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390883&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'22481712-cde6-4806-b1d4-199761767668\', \'multiverseId\': 390883}, \'multiverseid\': 390883}, {\'name\': \'グール呼びのギサ\', \'text\': \'{B}, {T}, 他のクリーチャーを１体生け贄に捧げる：黒の２/２のゾンビ・クリーチャー・トークンをＸ体戦場に出す。Ｘはその生け贄に捧げられたクリーチャーのパワーに等しい。\', \'type\': \'伝説のクリーチャー — 人間・ウィザード\', \'flavor\': \'「ゲラルフ、あなたはいつも泣き言ばかりね？私は何も約束した覚えはないわよ。私は、私の望む時にグールを蘇らせるだけよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391220&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f5398cc-04b0-4467-ad34-28dd2df4a5cb\', \'multiverseId\': 391220}, \'multiverseid\': 391220}, {\'name\': \'尸鬼牧者基沙\', \'text\': \'{B}，{T}，牺牲另一个生物：将X个2/2黑色灵俑衍生生物放进战场，X为所牺牲之生物的力量。\', \'type\': \'传奇生物～人类／法术师\', \'flavor\': \'「基拉夫，你非得喋喋不休吗？我什么都不同意。我要什么时候召唤食尸鬼，就什么时候召唤。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389872&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'946f556a-bf18-4c1d-8a55-6abb5cd5d3b2\', \'multiverseId\': 389872}, \'multiverseid\': 389872}]', '[{\'name\': \'Glanzgeschliffener Hirsch\', \'text\': \'{3}, opfere den Glanzgeschliffenen Hirsch: Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, bringe diese getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Artefaktkreatur — Hirsch\', \'flavor\': \'Von Göttern geschmiedet, um unter Sterblichen zu wandeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390128&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8714ae93-8902-4c5b-9ae3-c3d7a0fa4a5a\', \'multiverseId\': 390128}, \'multiverseid\': 390128}, {\'name\': \'Venado bruñido\', \'text\': \'{3}, sacrificar el Venado bruñido: Busca en tu biblioteca hasta dos cartas de tierra básica, ponlas en el campo de batalla giradas y luego baraja tu biblioteca.\', \'type\': \'Criatura artefacto — Alce\', \'flavor\': \'Forjado por manos divinas para deambular por los reinos mortales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391476&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e59f508-644e-44b2-b556-c1a37c05edd2\', \'multiverseId\': 391476}, \'multiverseid\': 391476}, {\'name\': \'Cerf bruni\', \'text\': "{3}, sacrifiez le Cerf bruni : Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base, mettez-les sur le champ de bataille engagées et mélangez votre bibliothèque.", \'type\': \'Créature-artefact : élan\', \'flavor\': \'Forgé par des mains divines pour sillonner les royaumes des mortels.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390465&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c1edcd30-0f43-4695-9060-3f015d0f6e1c\', \'multiverseId\': 390465}, \'multiverseid\': 390465}, {\'name\': \'Cervo Brunito\', \'text\': \'{3}, Sacrifica il Cervo Brunito: Passa in rassegna il tuo grimorio per trovare fino a due carte terra base, mettile sul campo di battaglia TAPpate, poi rimescola il tuo grimorio.\', \'type\': \'Creatura Artefatto — Alce\', \'flavor\': \'Forgiato da mani divine per vagare tra i reami mortali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390802&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d733be51-cb36-4338-bb38-d72e5c9f713b\', \'multiverseId\': 390802}, \'multiverseid\': 390802}, {\'name\': \'つややかな雄鹿\', \'text\': \'{3}, つややかな雄鹿を生け贄に捧げる：あなたのライブラリーから基本土地・カードを最大２枚まで探し、それらをタップ状態で戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'アーティファクト・クリーチャー — 大鹿\', \'flavor\': \'定命の者の世界をさまようため、天界の者の手により創られた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391139&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c05eebc-7916-40ff-af6f-7a2234051939\', \'multiverseId\': 391139}, \'multiverseid\': 391139}, {\'name\': \'光洁雄鹿\', \'text\': \'{3}，牺牲光洁雄鹿：从你的牌库中搜寻至多两张基本地牌，将之横置进战场，然后将你的牌库洗牌。\', \'type\': \'神器生物～麋鹿\', \'flavor\': \'由神明之手铸造，在凡人领域游荡。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389791&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d2a760e-a19e-4fe7-b98b-02ae0cbfdab0\', \'multiverseId\': 389791}, \'multiverseid\': 389791}]', '[{\'name\': \'Goblinschweißmeister\', \'text\': \'{T}: Bestimme ein Artefakt deiner Wahl, das ein Spieler kontrolliert, und eine Artefaktkarte deiner Wahl im Friedhof dieses Spielers. Falls beide Ziele immer noch legal sind, wenn diese Fähigkeit verrechnet wird, opfert dieser Spieler gleichzeitig das Artefakt und bringt die Artefaktkarte ins Spiel zurück.\', \'type\': \'Kreatur — Goblin, Handwerker\', \'flavor\': \'„Boss, ich habe deinen Metallkerl gefetzt. Aber ich habe dir einen Aschenbecher daraus gemacht!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390211&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e4f963f5-31cd-4861-8342-4e97ba17330f\', \'multiverseId\': 390211}, \'multiverseid\': 390211}, {\'name\': \'Soldador trasgo\', \'text\': \'{T}: Elige un artefacto objetivo que controla un jugador y una carta de artefacto objetivo en el cementerio de ese jugador. Si ambos objetivos aún son legales cuando se resuelva esta habilidad, ese jugador sacrifica el artefacto y regresa la carta de artefacto al campo de batalla de forma simultánea.\', \'type\': \'Criatura — Artífice trasgo\', \'flavor\': \'"He roto su hombre de metal, jefe. ¡Pero mire! Le he hecho un cenicero".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391559&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'843c573e-a161-40f0-9f4d-93055a500c9e\', \'multiverseId\': 391559}, \'multiverseid\': 391559}, {\'name\': \'Soudeur gobelin\', \'text\': "{T} : Choisissez un artefact ciblé qu\'un joueur contrôle et une carte d\'artefact ciblée dans le cimetière de ce joueur. Si les deux cibles sont encore légales au moment où cette capacité se résout, ce joueur sacrifie l\'artefact et renvoie simultanément la carte d\'artefact sur le champ de bataille.", \'type\': \'Créature : gobelin et artificier\', \'flavor\': "« J\'ai bousillé ton mec en métal, chef. Mais regarde, je t\'ai bricolé un cendrier. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390548&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7a0072b-386c-46e4-b600-844d4a4bbe20\', \'multiverseId\': 390548}, \'multiverseid\': 390548}, {\'name\': \'Saldatore Goblin\', \'text\': "{T}: Scegli un artefatto bersaglio controllato da un giocatore e una carta artefatto bersaglio nel cimitero di quel giocatore. Se entrambi i bersagli sono ancora legali mentre questa abilità si risolve, quel giocatore sacrifica l\'artefatto e contemporaneamente rimette la carta artefatto sul campo di battaglia.", \'type\': \'Creatura — Artefice Goblin\', \'flavor\': \'"Ho sfasciato la tua creatura di metallo, capo. Ma guarda! Ti ho fatto un bel posacenere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390885&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f5ee6b6-9ece-4234-bfa6-456cfd66c835\', \'multiverseId\': 390885}, \'multiverseid\': 390885}, {\'name\': \'ゴブリンの溶接工\', \'text\': \'{T}：プレイヤー１人がコントロールするアーティファクト１つと、そのプレイヤーの墓地にあるアーティファクト・カード１枚を対象とする。両方の対象がこの能力の解決時に適正であるなら、そのプレイヤーはそのアーティファクトを生け贄に捧げると同時にそのアーティファクト・カードを戦場に戻す。\', \'type\': \'クリーチャー — ゴブリン・工匠\', \'flavor\': \'「ボス、あなたの金物野郎を壊してしまいやした。でも、ほら！灰皿を作ってあげやしたよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391222&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5f201cce-23c7-4f6f-9bac-1d4e95a3d7ed\', \'multiverseId\': 391222}, \'multiverseid\': 391222}, {\'name\': \'鬼怪焊工\', \'text\': \'{T}：选择目标由任一牌手操控的神器和目标在该牌手坟墓场中的神器牌。如果于此异能结算时这两个目标仍合法，则该牌手同时牺牲该神器并将该神器牌移回战场。\', \'type\': \'生物～鬼怪／神器师\', \'flavor\': \'「老大，我弄坏了你的金属人。可是你看，我为你做出了一个烟灰缸！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389874&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b4d6986-a2bf-40ec-919d-cfd82ead6811\', \'multiverseId\': 389874}, \'multiverseid\': 389874}]', '[{\'name\': \'Gottloser Befehl\', \'text\': \'Bestimme zwei —\\n• Ein Spieler deiner Wahl verliert X Lebenspunkte.\\n• Bringe eine Kreaturenkarte deiner Wahl mit umgewandelten Manakosten von X oder weniger aus deinem Friedhof ins Spiel zurück.\\n• Eine Kreatur deiner Wahl erhält -X/-X bis zum Ende des Zuges.\\n• Bis zu X Kreaturen deiner Wahl verursachen Furcht bis zum Ende des Zuges. (Sie können außer von Artefaktkreaturen und/oder schwarzen Kreaturen nicht geblockt werden.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390319&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a9ee85ec-7d9d-43f6-8a53-b3d475f1b146\', \'multiverseId\': 390319}, \'multiverseid\': 390319}, {\'name\': \'Dictado profano\', \'text\': \'Elige dos:\\n• El jugador objetivo pierde X vidas.\\n• Regresa la carta de criatura objetivo con coste de maná convertido de X o menos de tu cementerio al campo de batalla.\\n• La criatura objetivo obtiene -X/-X hasta el final del turno.\\n• Hasta X criaturas ganan la habilidad de inspirar temor hasta el final del turno. (No pueden ser bloqueadas excepto por criaturas artefacto y/o criaturas negras.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391667&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a4cd7c4-ae69-4bcb-97a1-55f62140e148\', \'multiverseId\': 391667}, \'multiverseid\': 391667}, {\'name\': \'Commandement profane\', \'text\': "Choisissez deux —\\n• Le joueur ciblé perd X points de vie.\\n• Renvoyez sur le champ de bataille depuis votre cimetière une carte de créature ciblée avec un coût converti de mana inférieur ou égal à X.\\n• La créature ciblée gagne -X/-X jusqu\'à la fin du tour.\\n• Jusqu\'à X créatures ciblées acquièrent la peur jusqu\'à la fin du tour. (Elles ne peuvent pas être bloquées excepté par des créatures-artefacts et/ou des créatures noires.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390656&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'44a6c9cb-7a0f-4b51-a0bf-e6e99f8738df\', \'multiverseId\': 390656}, \'multiverseid\': 390656}, {\'name\': \'Ordine Profano\', \'text\': \'Scegli due —\\n• Un giocatore bersaglio perde X punti vita.\\n• Rimetti sul campo di battaglia una carta creatura bersaglio con costo di mana convertito pari o inferiore a X dal tuo cimitero.\\n• Una creatura bersaglio prende -X/-X fino alla fine del turno.\\n• Fino a X creature bersaglio hanno paura fino alla fine del turno. (Non possono essere bloccate tranne che da creature artefatto e/o creature nere.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390993&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90fe8db7-4d9a-408f-b5f7-5c54fb26e070\', \'multiverseId\': 390993}, \'multiverseid\': 390993}, {\'name\': \'不敬の命令\', \'text\': \'以下の４つから２つを選ぶ。\\n「プレイヤー１人を対象とする。そのプレイヤーはＸ点のライフを失う。」\\n「あなたの墓地にある点数で見たマナ・コストがＸ以下のクリーチャー・カード１枚を対象とし、それを戦場に戻す。」\\n「クリーチャー１体を対象とする。ターン終了時まで、それは－Ｘ/－Ｘの修整を受ける。」\\n「クリーチャーを最大Ｘ体まで対象とする。ターン終了時まで、それらは畏怖を得る。（それらはアーティファクトでも黒でもないクリーチャーによってはブロックされない。）」\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391330&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b8aeb67d-1eb3-45aa-9ad1-5028f74b0250\', \'multiverseId\': 391330}, \'multiverseid\': 391330}, {\'name\': \'渎神指命\', \'text\': \'选择两项～\\n•目标牌手失去X点生命。\\n•将目标总法术力费用等于或小于X的生物牌从你的坟墓场移回战场。\\n•目标生物得-X/-X直到回合结束。\\n•至多X个目标生物获得恐惧异能直到回合结束。（它们只能被神器生物和／或黑色生物阻挡。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389982&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'785360a4-3ef1-41ed-beca-f317de21eb00\', \'multiverseId\': 389982}, \'multiverseid\': 389982}]', '[{\'name\': \'Grabes-Titan\', \'text\': \'Todesberührung\\nImmer wenn der Grabes-Titan ins Spiel kommt oder angreift, bringe zwei 2/2 schwarze Zombie-Kreaturenspielsteine ins Spiel.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Tod in Form und Funktion.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390214&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df74d5ec-22fa-4f47-bdf0-07038a024113\', \'multiverseId\': 390214}, \'multiverseid\': 390214}, {\'name\': \'Titán de la tumba\', \'text\': \'Toque mortal.\\nSiempre que el Titán de la tumba entre al campo de batalla o ataque, pon en el campo de batalla dos fichas de criatura Zombie negras 2/2.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'La muerte en forma y función.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391562&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c43fa547-6d7c-4755-868d-7598308c4221\', \'multiverseId\': 391562}, \'multiverseid\': 391562}, {\'name\': \'Titan des tombes\', \'text\': "Contact mortel\\nÀ chaque fois que le Titan des tombes arrive sur le champ de bataille ou qu\'il attaque, mettez sur le champ de bataille deux jetons de créature 2/2 noire Zombie.", \'type\': \'Créature : géant\', \'flavor\': \'La mort par forme et par fonction.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390551&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'38ec4d35-be75-4c1c-9752-1725a18aed02\', \'multiverseId\': 390551}, \'multiverseid\': 390551}, {\'name\': \'Titano Sepolcrale\', \'text\': \'Tocco letale\\nOgniqualvolta il Titano Sepolcrale entra nel campo di battaglia o attacca, metti sul campo di battaglia due pedine creatura Zombie 2/2 nere.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Morte di nome e di fatto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390888&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c0aca99-6777-4172-a582-e6849ef46407\', \'multiverseId\': 390888}, \'multiverseid\': 390888}, {\'name\': \'墓所のタイタン\', \'text\': \'接死\\n墓所のタイタンが戦場に出るか攻撃するたび、黒の２/２のゾンビ・クリーチャー・トークンを２体戦場に出す。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'姿と機能を有した死。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391225&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc5a3597-6f1e-4c78-b0d2-281ceca141a3\', \'multiverseId\': 391225}, \'multiverseid\': 391225}, {\'name\': \'墓地泰坦\', \'text\': \'死触\\n每当墓地泰坦进战场或攻击时，将两个2/2黑色灵俑衍生生物放进战场。\', \'type\': \'生物～巨人\', \'flavor\': \'死亡的可运作实体。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389877&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc7eedba-5643-47f3-a1b6-f8ed79a794fa\', \'multiverseId\': 389877}, \'multiverseid\': 389877}]', '[{\'name\': \'Grabsieber\', \'text\': \'Wenn der Grabsieber ins Spiel kommt, bestimmt jeder Spieler einen Kreaturentyp und bringt eine beliebige Anzahl an Karten dieses Typs aus seinem Friedhof auf seine Hand zurück.\', \'type\': \'Kreatur — Elementarwesen, Bestie\', \'flavor\': \'Er scharrt unaufhörlich in der Erde, in dem vergeblichen Versuch, wiederzuerlangen, was er einst war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390213&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d200fcb-a808-44d5-bd27-19764ae2c2a1\', \'multiverseId\': 390213}, \'multiverseid\': 390213}, {\'name\': \'Cernedor de tumbas\', \'text\': \'Cuando el Cernedor de tumbas entre al campo de batalla, cada jugador elige un tipo de criatura y regresa cualquier cantidad de cartas de ese tipo de su cementerio a su mano.\', \'type\': \'Criatura — Bestia elemental\', \'flavor\': \'Desgarra la tierra en un vano intento de ser lo que fue en otro tiempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391561&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1b2a009-6dda-4666-81e6-65161fcc4cc0\', \'multiverseId\': 391561}, \'multiverseid\': 391561}, {\'name\': \'Épurateur de tombes\', \'text\': "Quand l\'Épurateur de tombes arrive sur le champ de bataille, chaque joueur choisit un type de créature et renvoie n\'importe quel nombre de cartes de ce type depuis son cimetière dans sa main.", \'type\': \'Créature : élémental et bête\', \'flavor\': "Il laboure le sol dans le vain espoir de redevenir ce qu\'il n\'est plus.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390550&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae6330db-61e7-47f7-a33f-bf94345f1566\', \'multiverseId\': 390550}, \'multiverseid\': 390550}, {\'name\': \'Setacciatore dei Sepolcri\', \'text\': \'Quando il Setacciatore dei Sepolcri entra nel campo di battaglia, ogni giocatore sceglie un tipo di creatura e riprende in mano dal proprio cimitero un qualsiasi numero di carte di quel tipo.\', \'type\': \'Creatura — Bestia Elementale\', \'flavor\': \'Affonda gli artigli nella terra nel vano tentativo di riappropriarsi di ciò che è stato un tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'33141197-7d11-43b3-9adf-e073b3349553\', \'multiverseId\': 390887}, \'multiverseid\': 390887}, {\'name\': \'墓所の選別者\', \'text\': \'墓所の選別者が戦場に出たとき、各プレイヤーはそれぞれクリーチャー・タイプを１つ選び、そのプレイヤーの墓地にあるその選んだタイプを持つカードを望む枚数そのプレイヤーの手札に戻す。\', \'type\': \'クリーチャー — エレメンタル・ビースト\', \'flavor\': \'それはかつての自分を取り戻そうと足掻いているかのように、土に向かって爪を立て続ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391224&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'935b87ec-ad78-45f4-b95d-c54c85a65dab\', \'multiverseId\': 391224}, \'multiverseid\': 391224}, {\'name\': \'筛坟兽\', \'text\': \'当筛坟兽进战场时，每位牌手各选择一个生物类别，并将任意数量该类别的牌从他的坟墓场移回其手上。\', \'type\': \'生物～元素／野兽\', \'flavor\': \'它不断挖掘，试图找出自身原貌，终究徒劳无功。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f2f12fdd-dae4-4b88-940b-0388f45bbba7\', \'multiverseId\': 389876}, \'multiverseid\': 389876}]', '[{\'name\': \'Grauer Händler aus Asphodel\', \'text\': \'Wenn der Graue Händler aus Asphodel ins Spiel kommt, verliert jeder Gegner X Lebenspunkte, wobei X gleich deiner Hingabe zu Schwarz ist. Du erhältst so viele Lebenspunkte dazu, wie auf diese Weise Lebenspunkte verloren wurden. (Jedes {B} in den Manakosten von bleibenden Karten, die du kontrollierst, erhöht deine Hingabe zu Schwarz um eins.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390215&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae455fc8-df75-4287-9336-712d90f32b7c\', \'multiverseId\': 390215}, \'multiverseid\': 390215}, {\'name\': \'Comerciante plomizo de Asfodel\', \'text\': \'Cuando el Comerciante plomizo de Asfodel entre al campo de batalla, cada oponente pierde X vidas, donde X es tu devoción al negro. Ganas vidas igual a la cantidad de vidas perdidas de esta manera. (Cada {B} en los costes de maná de los permanentes que controlas cuenta para tu devoción al negro.)\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391563&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1599478c-2fde-4f0d-abbc-e82b71fc1b7c\', \'multiverseId\': 391563}, \'multiverseid\': 391563}, {\'name\': "Marchand gris d\'Asphodèle", \'text\': "Quand le Marchand gris d\'Asphodèle arrive sur le champ de bataille, chaque adversaire perd X points de vie, X étant votre dévotion au noir. Vous gagnez autant de points de vie que ceux perdus de cette manière. (Chaque {B} dans les coûts de mana des permanents que vous contrôlez compte pour votre dévotion au noir.)", \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390552&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d8bd953-7bce-48fe-80f7-cb64ad5e53d3\', \'multiverseId\': 390552}, \'multiverseid\': 390552}, {\'name\': \'Mercante Grigio di Asfodelo\', \'text\': \'Quando il Mercante Grigio di Asfodelo entra nel campo di battaglia, ogni avversario perde X punti vita, dove X è pari alla tua devozione al nero. Guadagni tanti punti vita quanti sono i punti vita persi in questo modo. (La tua devozione al nero è la somma dei {B} nel costo di mana dei permanenti che controlli.)\', \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390889&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7e74287-f430-403a-a60a-17f52823f8f8\', \'multiverseId\': 390889}, \'multiverseid\': 390889}, {\'name\': \'アスフォデルの灰色商人\', \'text\': \'アスフォデルの灰色商人が戦場に出たとき、各対戦相手はそれぞれＸ点のライフを失う。Ｘはあなたの黒への信心に等しい。あなたはこれにより失われたライフに等しい点数のライフを得る。（あなたの黒への信心は、あなたがコントロールするパーマネントのマナ・コストに含まれる{B}の総数に等しい。）\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391226&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1828b43-b71a-49ab-85ba-6ac945ef68de\', \'multiverseId\': 391226}, \'multiverseid\': 391226}, {\'name\': \'安福陵的暗贾\', \'text\': \'当安福陵的暗贾进战场时，每位对手各失去X点生命，X为你的黑色献力。你获得若干生命，其数量等同于以此法失去的生命总和。（由你操控之永久物的法术力费用当中每含有一个{B}，你的黑色献力就加一。）\', \'type\': \'生物～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389878&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14079c4a-1f1f-4b52-8bbe-4263f641a788\', \'multiverseId\': 389878}, \'multiverseid\': 389878}]', '[{\'name\': \'Grimmige Blüte\', \'text\': \'Ziehe für jede Kreaturenkarte in deinem Friedhof eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Nichts in der Natur geht verloren, noch nicht einmal der verrottende Körper eines blutsaugenden Tunichtsguts von Vampir." —Halana vom Ulvenwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390217&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'512b4ac0-f582-452b-a6e5-b83034c8662b\', \'multiverseId\': 390217}, \'multiverseid\': 390217}, {\'name\': \'Floración siniestra\', \'text\': \'Roba una carta por cada carta de criatura en tu cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'"Nada se desperdicia en la naturaleza, ni siquiera el cuerpo putrefacto de un vampiro chupasangre inútil." —Halana de Ulvenwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391565&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81f310bf-fddd-43cb-bcb2-714860173ead\', \'multiverseId\': 391565}, \'multiverseid\': 391565}, {\'name\': \'Sinistre floraison\', \'text\': \'Piochez une carte pour chaque carte de créature dans votre cimetière.\', \'type\': \'Rituel\', \'flavor\': "« Dans la nature, rien n\'est jamais gaspillé, pas même le cadavre pourrissant d\'un bon à rien de vampire suceur de sang. » —Halana d\'Ulvenwald", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390554&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'debe7c8c-c391-44f5-ad31-f042f0946e5b\', \'multiverseId\': 390554}, \'multiverseid\': 390554}, {\'name\': \'Fioritura Macabra\', \'text\': \'Pesca una carta per ogni carta creatura nel tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Nulla in natura viene sprecato, neppure il cadavere putrescente di un vampiro buono-a-nulla e succhia-sangue." —Halana di Ulvenwald\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390891&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2926f9c2-de5f-4232-a60a-e79a71841808\', \'multiverseId\': 390891}, \'multiverseid\': 390891}, {\'name\': \'不気味な開花\', \'text\': \'あなたの墓地にあるクリーチャー・カード１枚につきカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「自然には無駄になるものなどありません。何の役にも立たない、血に飢えた吸血鬼の腐った死体であろうと。」 ――ウルヴェンワルドのハラナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391228&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35d9b1ba-c288-4806-800d-bbd041798584\', \'multiverseId\': 391228}, \'multiverseid\': 391228}, {\'name\': \'阴森花开\', \'text\': \'你坟墓场中每有一张生物牌，便抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「在大自然中什么都不会浪费掉，就连这些一无是处的吸血鬼腐尸也是一样。」 ～沃文森的荷拉娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389880&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0e4b9b4-3ca4-433b-b9b1-01607a8df957\', \'multiverseId\': 389880}, \'multiverseid\': 389880}]', '[{\'name\': \'Grollgröhler\', \'text\': \'Wenn der Grollgröhler das Spiel verlässt, fügt er einer Kreatur deiner Wahl 6 Schadenspunkte zu.\\nHerbeirufen {1}{R}{R} (Du kannst diesen Zauberspruch für seine Herbeirufungskosten wirken. Falls du dies tust, wird die Kreatur geopfert, wenn sie ins Spiel kommt.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Das Unglück wandert mit aufgerissenem Maul durch nicht darauf vorbereitete Gegenden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390364&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a9cb5b3-a9cf-4114-aea5-f60ed2b742c5\', \'multiverseId\': 390364}, \'multiverseid\': 390364}, {\'name\': \'Bramador malicioso\', \'text\': \'Cuando el Bramador malicioso deje el campo de batalla, hace 6 puntos de daño a la criatura objetivo.\\nEvocar {1}{R}{R}. (Puedes lanzar este hechizo por su coste de evocar. Si lo haces, sacrifícalo cuando entre al campo de batalla.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'El desastre acecha con las mandíbulas listas por los territorios desprevenidos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391712&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a98b84b5-385e-418e-a89c-fa6f164610e9\', \'multiverseId\': 391712}, \'multiverseid\': 391712}, {\'name\': \'Soufflaigreur\', \'text\': "Quand le Soufflaigreur quitte le champ de bataille, il inflige 6 blessures à une créature ciblée.\\nÉvocation {1}{R}{R} (Vous pouvez lancer ce sort pour son coût d\'évocation. Si vous faites ainsi, il est sacrifié quand il arrive sur le champ de bataille.)", \'type\': \'Créature : élémental\', \'flavor\': \'Le désastre ouvre ses mâchoires béantes sur des territoires sans défense.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390701&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7b2fb2fa-f6aa-4b01-9b58-2a08851a643b\', \'multiverseId\': 390701}, \'multiverseid\': 390701}, {\'name\': \'Ruggito Malefico\', \'text\': \'Quando il Ruggito Malefico lascia il campo di battaglia, infligge 6 danni a una creatura bersaglio.\\nApparire {1}{R}{R} (Puoi lanciare questa magia pagando il suo costo di apparire. Se lo fai, viene sacrificata quando entra nel campo di battaglia.)\', \'type\': \'Creatura — Elementale\', \'flavor\': \'Il disastro incombe con mascelle devastanti attraverso terre impreparate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391038&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81dc0b76-b960-4d94-9208-b0eaf3e75d61\', \'multiverseId\': 391038}, \'multiverseid\': 391038}, {\'name\': \'恨み唸り\', \'text\': \'恨み唸りが戦場を離れたとき、クリーチャー１体を対象とする。恨み唸りはそれに６点のダメージを与える。\\n想起{1}{R}{R}（あなたはこの呪文を、これの想起コストで唱えてもよい。そうしたなら、戦場に出たときにこれを生け贄に捧げる。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'災害は身構え無き地を大口を開けてうろついている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391375&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d12eff07-ffce-4871-b6fe-045926a5eb68\', \'multiverseId\': 391375}, \'multiverseid\': 391375}, {\'name\': \'怨吼灵\', \'text\': \'当怨吼灵离开战场时，它对目标生物造成6点伤害。\\n呼魂{1}{R}{R}（你可以支付此咒语的呼魂费用来施放它。若你如此作，当它进战场时便牺牲之。）\', \'type\': \'生物～元素\', \'flavor\': \'灾难张口袭击平静大地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390027&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2125f71-fbbc-4094-bb7b-8b9c0f1d0977\', \'multiverseId\': 390027}, \'multiverseid\': 390027}]', '[{\'name\': \'Große Schmelze\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {R}.\', \'type\': \'Artefakt, Land\', \'flavor\': \'Kuldotha, Urquell des geschmolzenen Metalls, Tempel der Goblinhorde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390216&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22dff2ab-df87-4e75-89c0-beacb9f5a9d5\', \'multiverseId\': 390216}, \'multiverseid\': 390216}, {\'name\': \'Gran horno\', \'text\': \'{T}: Agrega {R} a tu reserva de maná.\', \'type\': \'Tierra artefacto\', \'flavor\': \'Kuldotha, manantial del metal fundido, templo de la horda de trasgos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391564&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3b136036-2c69-4e0f-bcd5-13ce7e37aed5\', \'multiverseId\': 391564}, \'multiverseid\': 391564}, {\'name\': \'Grand Fourneau\', \'text\': \'{T} : Ajoutez {R} à votre réserve.\', \'type\': \'Terrain-artefact\', \'flavor\': \'Kuldotha, puits sourcier de métal en fusion, temple des hordes gobelines.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390553&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0673025-83f5-4244-ae25-3e3fded21ae8\', \'multiverseId\': 390553}, \'multiverseid\': 390553}, {\'name\': \'Grande Fornace\', \'text\': \'{T}: Aggiungi {R} alla tua riserva di mana.\', \'type\': \'Terra Artefatto\', \'flavor\': "Kuldotha, fonte del metallo fuso, tempio dell\'orda dei goblin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390890&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27c39053-85cf-4f10-9617-420a3054c68a\', \'multiverseId\': 390890}, \'multiverseid\': 390890}, {\'name\': \'大焼炉\', \'text\': \'{T}：あなたのマナ・プールに{R}を加える。\', \'type\': \'アーティファクト・土地\', \'flavor\': \'カルドーサ、溶けた金属の噴き出すゴブリンの群落の寺。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391227&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'537dd6d8-3f44-448d-9e29-86313f90bd9f\', \'multiverseId\': 391227}, \'multiverseid\': 391227}, {\'name\': \'大熔炉\', \'text\': \'{T}：加{R}到你的法术力池中。\', \'type\': \'神器地\', \'flavor\': \'库度沙，熔铁的泉源，鬼怪大军的庙堂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389879&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2cec3df4-1a64-43eb-bc8a-0c1bc68e1ca2\', \'multiverseId\': 389879}, \'multiverseid\': 389879}]', '[{\'name\': \'Großer Abschaffer\', \'text\': \'Während deines Zuges können deine Gegner keine Zaubersprüche wirken oder Fähigkeiten von Artefakten, Kreaturen oder Verzauberungen aktivieren.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Dein Aberglauben und dein Gemurmel halten meiner Rechtschaffenheit nicht stand."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390212&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ede6990-f7ed-4bdd-bc87-a74e59d360ba\', \'multiverseId\': 390212}, \'multiverseid\': 390212}, {\'name\': \'Gran abolidor\', \'text\': \'Durante tu turno, tus oponentes no pueden lanzar hechizos o activar habilidades de artefactos, criaturas o encantamientos.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Tus supersticiones y balbuceos no servirán de nada frente a mi rectitud."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391560&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'16668d6d-e491-418a-9e44-1ff37d4287ef\', \'multiverseId\': 391560}, \'multiverseid\': 391560}, {\'name\': \'Grand abolisseur\', \'text\': "Pendant votre tour, vos adversaires ne peuvent pas lancer de sorts ou activer les capacités d\'artefacts, de créatures ou d\'enchantements.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Vos superstitions et vos grommellements sont impuissants face à ma droiture. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390549&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'915bb3e1-7bec-4e50-9243-d53253d96668\', \'multiverseId\': 390549}, \'multiverseid\': 390549}, {\'name\': \'Grande Abolitore\', \'text\': \'Durante il tuo turno, i tuoi avversari non possono lanciare magie o attivare abilità di artefatti, creature o incantesimi.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Le tue superstizioni e le tue ciance sono sciocchezze inutili di fronte alla mia rettitudine."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390886&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a905fd28-ebe3-4059-a9fa-8b73c62339b5\', \'multiverseId\': 390886}, \'multiverseid\': 390886}, {\'name\': \'堂々たる撤廃者\', \'text\': \'あなたのターン中、あなたの対戦相手は呪文を唱えることもアーティファクトやクリーチャーやエンチャントの能力を起動することもできない。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「お前の迷信や戯言は、私の正義の前には無用の屑だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391223&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04623e4d-ca59-48e1-8f3b-5fcd1d1c4e68\', \'multiverseId\': 391223}, \'multiverseid\': 391223}, {\'name\': \'止咒高僧\', \'text\': \'在你的回合中，所有对手都不能施放咒语或起动神器，生物或结界的异能。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「在我正气当前，你那些迷信与呓语都是无用长物。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389875&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c66599df-b34b-475c-b576-7ce149b08d67\', \'multiverseId\': 389875}, \'multiverseid\': 389875}]', '[{\'name\': \'Grübelschlängler\', \'text\': \'Fliegend\\nWenn der Grübelschlängler ins Spiel kommt, ziehe zwei Karten.\\nHerbeirufen {2}{U} (Du kannst diesen Zauberspruch für seine Herbeirufungskosten wirken. Falls du dies tust, wird die Kreatur geopfert, wenn sie ins Spiel kommt.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390279&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'300c69a3-d8ad-42fd-a03f-53abdbdaba4a\', \'multiverseId\': 390279}, \'multiverseid\': 390279}, {\'name\': \'Errante meditabundo\', \'text\': \'Vuela.\\nCuando el Errante meditabundo entre al campo de batalla, roba dos cartas.\\nEvocar {2}{U}. (Puedes lanzar este hechizo por su coste de evocar. Si lo haces, sacrifícalo cuando entre al campo de batalla.)\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391627&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'446e27d3-73ca-44e5-80dc-c4512a9f4c9d\', \'multiverseId\': 391627}, \'multiverseid\': 391627}, {\'name\': \'Vagabond des pensées\', \'text\': "Vol\\nQuand le Vagabond des pensées arrive sur le champ de bataille, piochez deux cartes.\\nÉvocation {2}{U} (Vous pouvez lancer ce sort pour son coût d\'évocation. Si vous faites ainsi, il est sacrifié quand il arrive sur le champ de bataille.)", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16897326-7772-4348-a8f8-e76a8e3578ea\', \'multiverseId\': 390616}, \'multiverseid\': 390616}, {\'name\': \'Vagabondo Pensoso\', \'text\': \'Volare\\nQuando il Vagabondo Pensoso entra nel campo di battaglia, pesca due carte.\\nApparire {2}{U} (Puoi lanciare questa magia pagando il suo costo di apparire. Se lo fai, viene sacrificata quando entra nel campo di battaglia.)\', \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390953&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b11ec930-3446-4311-a5f3-3da335f7d308\', \'multiverseId\': 390953}, \'multiverseid\': 390953}, {\'name\': \'熟考漂い\', \'text\': \'飛行\\n熟考漂いが戦場に出たとき、カードを２枚引く。\\n想起{2}{U}（あなたはこの呪文を、これの想起コストで唱えてもよい。そうしたなら、戦場に出たときにこれを生け贄に捧げる。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391290&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75a6c479-3f6e-4fc1-8452-0f16de2da169\', \'multiverseId\': 391290}, \'multiverseid\': 391290}, {\'name\': \'漂念精\', \'text\': \'飞行\\n当漂念精进战场时，抓两张牌。\\n呼魂{2}{U}（你可以支付此咒语的呼魂费用来施放它。若你如此作，当它进战场时便牺牲之。）\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389942&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'664cc1de-0bde-4d02-a144-9ccef210a043\', \'multiverseId\': 389942}, \'multiverseid\': 389942}]', '[{\'name\': \'Gussblock-Zerkauer\', \'text\': \'Wenn der Gussblock-Zerkauer ins Spiel kommt, zerstöre ein Artefakt deiner Wahl.\\nHerbeirufen {R} (Du kannst diesen Zauberspruch für seine Herbeirufungskosten wirken. Falls du dies tust, wird die Kreatur geopfert, wenn sie ins Spiel kommt.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Elementarwesen sind Ideen, denen Gestalt gegeben wurde. Dieses hier ist der Ausdruck von Zerstörungssucht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390232&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d3fb3d2-86c0-427d-9edd-45666125c0cb\', \'multiverseId\': 390232}, \'multiverseid\': 390232}, {\'name\': \'Masticador de lingotes\', \'text\': \'Cuando el Masticador de lingotes entre al campo de batalla, destruye el artefacto objetivo.\\nEvocar {R}. (Puedes lanzar este hechizo por su coste de evocar. Si lo haces, sacrifícalo cuando entre al campo de batalla.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Los elementales son ideas que cobran vida. Esta, por ejemplo, es la idea de "demolición".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391580&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72154059-e80a-4e60-9b9a-9f22a998a2ca\', \'multiverseId\': 391580}, \'multiverseid\': 391580}, {\'name\': \'Mâcheur de lingot\', \'text\': "Quand le Mâcheur de lingot arrive sur le champ de bataille, détruisez l\'artefact ciblé.\\nÉvocation {R} (Vous pouvez lancer ce sort pour son coût d\'évocation. Si vous faites ainsi, il est sacrifié quand il arrive sur le champ de bataille.)", \'type\': \'Créature : élémental\', \'flavor\': "Les élémentaux sont des idées incarnées. Celui-ci, par exemple, incarne l\'idée de la « mâchittude ».", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390569&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59a170db-a1aa-443b-8d55-29bed7eb3e27\', \'multiverseId\': 390569}, \'multiverseid\': 390569}, {\'name\': \'Mastica Lingotti\', \'text\': \'Quando il Mastica Lingotti entra nel campo di battaglia, distruggi un artefatto bersaglio.\\nApparire {R} (Puoi lanciare questa magia pagando il suo costo di apparire. Se lo fai, viene sacrificata quando entra nel campo di battaglia.)\', \'type\': \'Creatura — Elementale\', \'flavor\': \'Gli elementali sono idee che prendono forma. Questo qui è l\\\'idea della "frantumazione".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390906&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'214c21a2-cfcc-4a0a-ac88-7106e444c2cc\', \'multiverseId\': 390906}, \'multiverseid\': 390906}, {\'name\': \'鋳塊かじり\', \'text\': \'鋳塊かじりが戦場に出たとき、アーティファクト１つを対象とし、それを破壊する。\\n想起{R}（あなたはこの呪文を、これの想起コストで唱えてもよい。そうしたなら、戦場に出たときにこれを生け贄に捧げる。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'精霊は形を成した思考だ。例えばこいつは「ぶち壊しがい」という考えだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391243&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc7fd091-d342-440e-8784-d8510ee51776\', \'multiverseId\': 391243}, \'multiverseid\': 391243}, {\'name\': \'嚼锭怪\', \'text\': \'当嚼锭怪进战场时，消灭目标神器。\\n呼魂{R}（你可以支付此咒语的呼魂费用来施放它。若你如此作，当它进战场时便牺牲之。）\', \'type\': \'生物～元素\', \'flavor\': \'元素是意念的具现。这个就是「想打坏」的意念。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c0457623-390b-4589-8451-745eb9b8edc5\', \'multiverseId\': 389895}, \'multiverseid\': 389895}]', '[{\'name\': \'Handelsposten\', \'text\': \'{1}, {T}, wirf eine Karte ab: Du erhältst 4 Lebenspunkte dazu.\\n{1}, {T}, bezahle 1 Lebenspunkt: Bringe einen 0/1 weißen Ziege-Kreaturenspielstein ins Spiel.\\n{1}, {T}, opfere eine Kreatur: Bringe eine Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\n{1}, {T}, opfere ein Artefakt: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390399&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'435b9bc5-2246-4d12-9dd8-4b645a46c37e\', \'multiverseId\': 390399}, \'multiverseid\': 390399}, {\'name\': \'Puesto comercial\', \'text\': \'{1}, {T}, descartar una carta: Ganas 4 vidas.\\n{1}, {T}: pagar 1 vida: Pon en el campo de batalla una ficha de criatura Cabra blanca 0/1.\\n{1}, {T}, sacrificar una criatura: Regresa la carta de artefacto objetivo de tu cementerio a tu mano.\\n{1}, {T}, sacrificar un artefacto: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391747&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b2cd0af-5b0e-45f8-b3a2-fd0b164622e8\', \'multiverseId\': 391747}, \'multiverseid\': 391747}, {\'name\': \'Comptoir de commerce\', \'text\': "{1}, {T}, défaussez-vous d\'une carte : Vous gagnez 4 points de vie.\\n{1}, {T}, payez 1 point de vie : Mettez sur le champ de bataille un jeton de créature 0/1 blanche Chèvre.\\n{1}, {T}, sacrifiez une créature : Renvoyez une carte d\'artefact ciblée depuis votre cimetière dans votre main.\\n{1}, {T}, sacrifiez un artefact : Piochez une carte.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90284775-cd56-4b76-a672-34d7127c2f7a\', \'multiverseId\': 390736}, \'multiverseid\': 390736}, {\'name\': \'Stazione Commerciale\', \'text\': \'{1}, {T}, Scarta una carta: Guadagni 4 punti vita.\\n{1}, {T}, Paga 1 punto vita: Metti sul campo di battaglia una pedina creatura Capra 0/1 bianca.\\n{1}, {T}, Sacrifica una creatura: Riprendi in mano una carta artefatto bersaglio dal tuo cimitero.\\n{1}, {T}, Sacrifica un artefatto: Pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391073&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd8680bd-88e2-4cd6-ae6a-c7589d0240cc\', \'multiverseId\': 391073}, \'multiverseid\': 391073}, {\'name\': \'交易所\', \'text\': \'{1}, {T}, カードを１枚捨てる：あなたは４点のライフを得る。\\n{1}, {T}, ライフを１点支払う：白の０/１のヤギ・クリーチャー・トークンを１体戦場に出す。\\n{1}, {T}, クリーチャーを１体生け贄に捧げる：あなたの墓地にあるアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\\n{1}, {T}, アーティファクトを１つ生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391410&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f1758fc-cdb9-4fbf-9bdd-8bd50fdebcff\', \'multiverseId\': 391410}, \'multiverseid\': 391410}, {\'name\': \'交易站\', \'text\': \'{1}，{T}，弃一张牌：你获得4点生命。\\n{1}，{T}，支付1点生命：将一个0/1白色山羊衍生生物放进战场。\\n{1}，{T}，牺牲一个生物：将目标神器牌从你的坟墓场移回你手上。\\n{1}，{T}，牺牲一个神器：抓一张牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'11c1e7ee-8c7b-4e7c-be2d-98d69312cb4a\', \'multiverseId\': 390062}, \'multiverseid\': 390062}]', "[{'name': 'Heiliger Seelenhüter', 'text': 'Wachsamkeit\\nWenn der Heilige Seelenhüter stirbt, bringe X 1/1 weiße Geist-Kreaturenspielsteine mit Flugfähigkeit ins Spiel, wobei X gleich der Anzahl an Kreaturenkarten in deinem Friedhof ist.', 'type': 'Kreatur — Avatar', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390218&type=card', 'language': 'German', 'identifiers': {'scryfallId': '67dc2005-6e0e-410b-a7bf-74a7dac93ad4', 'multiverseId': 390218}, 'multiverseid': 390218}, {'name': 'Guardián espiritual consagrado', 'text': 'Vigilancia.\\nCuando el Guardián espiritual consagrado muera, pon en el campo de batalla X fichas de criatura Espíritu blancas 1/1 con la habilidad de volar, donde X es la cantidad de cartas de criatura en tu cementerio.', 'type': 'Criatura — Avatar', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391566&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '180b5641-b60b-4676-94a2-9b7237132ce3', 'multiverseId': 391566}, 'multiverseid': 391566}, {'name': 'Gardien sacré des esprits', 'text': 'Vigilance\\nQuand le Gardien sacré des esprits meurt, mettez sur le champ de bataille X jetons de créature 1/1 blanche Esprit avec le vol, X étant le nombre de cartes de créature dans votre cimetière.', 'type': 'Créature : avatar', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390555&type=card', 'language': 'French', 'identifiers': {'scryfallId': '62482336-75db-4f4d-b253-ecf0e05332fa', 'multiverseId': 390555}, 'multiverseid': 390555}, {'name': 'Custode di Spiriti Consacrato', 'text': 'Cautela\\nQuando il Custode di Spiriti Consacrato muore, metti sul campo di battaglia X pedine creatura Spirito 1/1 bianche con volare, dove X è il numero di carte creatura nel tuo cimitero.', 'type': 'Creatura — Avatar', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390892&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fc8a3ff8-4811-457c-b170-695db98405fb', 'multiverseId': 390892}, 'multiverseid': 390892}, {'name': '神聖なる魂の守り手', 'text': '警戒\\n神聖なる魂の守り手が死亡したとき、飛行を持つ白の１/１のスピリット・クリーチャー・トークンをＸ体戦場に出す。Ｘはあなたの墓地にあるクリーチャー・カードの総数に等しい。', 'type': 'クリーチャー — アバター', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391229&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dfa9b7b4-d464-4ecb-a1c1-73003b462ad7', 'multiverseId': 391229}, 'multiverseid': 391229}, {'name': '圣洁灵卫', 'text': '警戒\\n当圣洁灵卫死去时，将X个1/1白色，具飞行异能的精怪衍生生物放进战场，X为你坟墓场中生物牌的数量。', 'type': '生物～圣者', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389881&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '016b290b-9372-4bd3-a40c-01b59e3b7c96', 'multiverseId': 389881}, 'multiverseid': 389881}]", '[{\'name\': \'Heiliger Tafelberg\', \'text\': \'Opfere zu Beginn deines Versorgungssegments den Heiligen Tafelberg, falls du nicht einen Pegasus opferst.\\n{1}{W}: Bringe einen 1/1 weißen Pegasus-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390335&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a79157a0-68a7-4b93-80bb-e25a43db679c\', \'multiverseId\': 390335}, \'multiverseid\': 390335}, {\'name\': \'Meseta sagrada\', \'text\': \'Al comienzo de tu mantenimiento, sacrifica la Meseta sagrada a menos que sacrifiques un Pegaso.\\n{1}{W}: Pon en el campo de batalla una ficha de criatura Pegaso blanca 1/1 con la habilidad de volar.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391683&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8ee3ca71-c47b-475d-aee5-2f55534e8314\', \'multiverseId\': 391683}, \'multiverseid\': 391683}, {\'name\': \'Mesa sacrée\', \'text\': \'Au début de votre entretien, sacrifiez la Mesa sacrée à moins que vous ne sacrifiiez un pégase.\\n{1}{W} : Mettez sur le champ de bataille un jeton de créature 1/1 blanche Pégase avec le vol.\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390672&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a55b669d-f996-4abf-8b4e-fc223efb28db\', \'multiverseId\': 390672}, \'multiverseid\': 390672}, {\'name\': \'Mesa Inviolabile\', \'text\': "All\'inizio del tuo mantenimento, sacrifica la Mesa Inviolabile a meno che non sacrifichi un Pegaso.\\n{1}{W}: Metti sul campo di battaglia una pedina creatura Pegaso 1/1 bianca con volare.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9feb58a7-8006-4efc-a88b-ac45dba5c6ad\', \'multiverseId\': 391009}, \'multiverseid\': 391009}, {\'name\': \'聖なるメサ\', \'text\': \'あなたのアップキープの開始時に、ペガサスを１体生け贄に捧げないかぎり、聖なるメサを生け贄に捧げる。\\n{1}{W}：飛行を持つ白の１/１のペガサス・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391346&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'006833e0-4f9a-427e-bda1-86d6f098ef71\', \'multiverseId\': 391346}, \'multiverseid\': 391346}, {\'name\': \'圣洁台地\', \'text\': \'在你的维持开始时，除非你牺牲一个飞马，否则牺牲圣洁台地。\\n{1}{W}：将一个1/1白色，具飞行异能的飞马衍生生物放进战场。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389998&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'177d0dc0-5e26-4989-921c-7582c0c6464b\', \'multiverseId\': 389998}, \'multiverseid\': 389998}]', "[{'name': 'Heimgesuchtes Sumpfgrab', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{3}, {T}, opfere das Heimgesuchte Sumpfgrab: Bringe eine zufällig bestimmte Kreaturenkarte aus deinem Friedhof auf deine Hand zurück.', 'type': 'Land', 'flavor': 'Der Spielplatz der Ghulrufer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390220&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1c64b60a-22e3-4f5b-bafa-23c3b0e12fab', 'multiverseId': 390220}, 'multiverseid': 390220}, {'name': 'Tumbanegada embrujada', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{3}, {T}, sacrificar la Tumbanegada embrujada: Regresa una carta de criatura al azar de tu cementerio a tu mano.', 'type': 'Tierra', 'flavor': 'El jardín de un llamamuertos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391568&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4cedad70-7a3f-4276-bc4a-bd15ab7058d3', 'multiverseId': 391568}, 'multiverseid': 391568}, {'name': 'Paludgraf hanté', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{3}, {T}, sacrifiez le Paludgraf hanté : Renvoyez une carte de créature au hasard depuis votre cimetière dans votre main.', 'type': 'Terrain', 'flavor': 'Le terrain de jeu du meneur de goule.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390557&type=card', 'language': 'French', 'identifiers': {'scryfallId': '02aafcd0-c6c6-4836-b56d-1b9cad50e2ec', 'multiverseId': 390557}, 'multiverseid': 390557}, {'name': 'Cimitero Palustre Infestato', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{3}, {T}, Sacrifica il Cimitero Palustre Infestato: Riprendi in mano una carta creatura a caso dal tuo cimitero.', 'type': 'Terra', 'flavor': 'Il parco giochi di un evocaghoul.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390894&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '86e13f51-a6e4-4ae1-a01f-66f97970e210', 'multiverseId': 390894}, 'multiverseid': 390894}, {'name': '憑依された沼墓', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{3}, {T}, 憑依された沼墓を生け贄に捧げる：あなたの墓地にあるクリーチャー・カードを１枚無作為に選んであなたの手札に戻す。', 'type': '土地', 'flavor': 'グール呼びの遊び場。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391231&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '387800fd-6cf4-4751-a7e0-abb641812179', 'multiverseId': 391231}, 'multiverseid': 391231}, {'name': '闹鬼沼墓', 'text': '{T}：加{1}到你的法术力池中。\\n{3}，{T}，牺牲闹鬼沼墓：随机将一张生物牌从你的坟墓场移回你手上。', 'type': '地', 'flavor': '尸鬼牧者的游乐场。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389883&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eea32d0c-f484-41d7-813f-e3640c7a57e9', 'multiverseId': 389883}, 'multiverseid': 389883}]", '[{\'name\': \'Himmeljäger-Plänkler\', \'text\': \'Fliegend, Doppelschlag\', \'type\': \'Kreatur — Katze, Ritter\', \'flavor\': \'„Wie das erste Licht des Morgens sollst du die Unvorbereiteten blenden und die Schatten verbannen." —Himmeljägermotto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390352&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95bf8e4d-0d10-4da1-ba6c-b5ee59e8037f\', \'multiverseId\': 390352}, \'multiverseid\': 390352}, {\'name\': \'Escaramuzadora cazacielos\', \'text\': \'Vuela, daña dos veces.\', \'type\': \'Criatura — Caballero felino\', \'flavor\': \'"Como la primera luz del alba, ciega a los indignos y destierra las sombras". —Credo cazacielos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391700&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'17665e34-7986-42f6-8c68-f34fbdb2f1f3\', \'multiverseId\': 391700}, \'multiverseid\': 391700}, {\'name\': \'Assaillante chasseciel\', \'text\': \'Vol, double initiative\', \'type\': \'Créature : chat et chevalier\', \'flavor\': "« Aveugle celui qui est pris au dépourvu et chasse les ombres, tel le premier rayon de l\'aube. » —Credo des chasseciel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390689&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a1b83a1-c6b3-4e47-a313-66f366c4e1e8\', \'multiverseId\': 390689}, \'multiverseid\': 390689}, {\'name\': \'Esploratrice Solcacielo\', \'text\': \'Volare, doppio attacco\', \'type\': \'Creatura — Cavaliere Felino\', \'flavor\': \'"Come la prima luce dell\\\'alba, acceca chi non è preparato e metti in fuga le ombre." —Credo dei Solcacielo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ddddbf24-b0f0-45f3-a60a-d42e5acb5ff6\', \'multiverseId\': 391026}, \'multiverseid\': 391026}, {\'name\': \'空狩人の散兵\', \'text\': \'飛行、二段攻撃\', \'type\': \'クリーチャー — 猫・騎士\', \'flavor\': \'「夜明けの一番の光のように、構え無き者の目をふさぎ、影を消し去るべし。」 ――空狩人の教義\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391363&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1591844-3b94-4154-a84c-f6546a739589\', \'multiverseId\': 391363}, \'multiverseid\': 391363}, {\'name\': \'侦卫空猎者\', \'text\': \'飞行，连击\', \'type\': \'生物～猫／骑士\', \'flavor\': \'「如首道晨光般冲破黑暗，破敌于不备。」 ～空猎者纲领\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390015&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0879dbf7-4249-43d2-a22a-61248cc21070\', \'multiverseId\': 390015}, \'multiverseid\': 390015}]', "[{'name': 'Himmelsdiamant', 'text': 'Der Himmelsdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390351&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4fcf9ad2-fce7-49af-89f3-ea7c2a5c8d78', 'multiverseId': 390351}, 'multiverseid': 390351}, {'name': 'Diamante celeste', 'text': 'El Diamante celeste entra al campo de batalla girado.\\n{T}: Agrega {U} a tu reserva de maná.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391699&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6d02b5cb-f412-4848-ad7a-ef14b796e627', 'multiverseId': 391699}, 'multiverseid': 391699}, {'name': 'Diamant du ciel', 'text': 'Le Diamant du ciel arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {U} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390688&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0b794fc4-ad82-4a54-a643-2094b0e7af66', 'multiverseId': 390688}, 'multiverseid': 390688}, {'name': 'Diamante del Cielo', 'text': 'Il Diamante del Cielo entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {U} alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391025&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1e6ab6e8-36be-4ba6-a045-09e75d5e5f07', 'multiverseId': 391025}, 'multiverseid': 391025}, {'name': '空色のダイアモンド', 'text': '空色のダイアモンドはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{U}を加える。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391362&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '13049968-f7a6-42c6-8527-ea00f276f0e9', 'multiverseId': 391362}, 'multiverseid': 391362}, {'name': '天蓝钻石', 'text': '天蓝钻石须横置进战场。\\n{T}：加{U}到你的法术力池中。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390014&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd5bd9b37-1ade-4629-9b93-7e01b2cef1da', 'multiverseId': 390014}, 'multiverseid': 390014}]", "[{'name': 'Himmlischer Feldmarschall', 'text': 'Fliegend\\nLeutnant — Solange du deinen Kommandeur kontrollierst, erhält der Himmlische Feldmarschall +2/+2 und Kreaturen, die du kontrollierst, haben Wachsamkeit.', 'type': 'Kreatur — Engel', 'flavor': 'Ihre Präsenz auf dem Schlachtfeld kann eine aufgebrachte Meute in eine disziplinierte Armee verwandeln.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390102&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4e288b80-6cb8-4e96-a3c7-f298d5a8d3c8', 'multiverseId': 390102}, 'multiverseid': 390102}, {'name': 'Mariscal de campo angelical', 'text': 'Vuela.\\nTeniente — Mientras controles a tu comandante, la Mariscal de campo angelical obtiene +2/+2 y las criaturas que controlas tienen la habilidad de vigilancia.', 'type': 'Criatura — Ángel', 'flavor': 'Su presencia en el campo de batalla puede transformar una turba descontrolada en un ejército disciplinado.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391450&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '77a39fbe-1c46-4277-b2de-373699c6220c', 'multiverseId': 391450}, 'multiverseid': 391450}, {'name': 'Générale de campagne angélique', 'text': 'Vol\\nLieutenant — Tant que vous contrôlez votre commandant, la Générale de campagne angélique gagne +2/+2 et les créatures que vous contrôlez ont la vigilance.', 'type': 'Créature : ange', 'flavor': 'Sur le champ de bataille, sa présence peut changer une foule indocile en armée disciplinée.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390439&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f649c1d3-ad9f-4015-af62-a1bd418ce076', 'multiverseId': 390439}, 'multiverseid': 390439}, {'name': 'Supremo Comandante Angelico', 'text': 'Volare\\nTenente — Fintanto che controlli il tuo comandante, il Supremo Comandante Angelico prende +2/+2 e le creature che controlli hanno cautela.', 'type': 'Creatura — Angelo', 'flavor': 'La sua presenza sul campo di battaglia può trasformare una marmaglia insubordinata in un esercito disciplinato.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390776&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '12e1e0c2-815d-42c8-8604-2732c5cc685e', 'multiverseId': 390776}, 'multiverseid': 390776}, {'name': '天使の元帥', 'text': '飛行\\n副官 ― あなたがあなたの統率者をコントロールしているかぎり、天使の元帥は＋２/＋２の修整を受け、あなたがコントロールするクリーチャーは警戒を持つ。', 'type': 'クリーチャー — 天使', 'flavor': '彼女が戦場に存在するだけで、無秩序の暴徒の集団を秩序立った軍隊に変えることができる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391113&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e655ef99-e2c9-40ca-8572-a070bb9b377a', 'multiverseId': 391113}, 'multiverseid': 391113}, {'name': '天使元帅', 'text': '飞行\\n副官～只要你操控你的指挥官，天使元帅便得+2/+2且由你操控的生物具有警戒异能。', 'type': '生物～天使', 'flavor': '得她号令，就连难以驾驭的暴民都能成为纪律严明的军队。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389765&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3b0d0b13-d123-48a1-bfc7-6dacf4550542', 'multiverseId': 389765}, 'multiverseid': 389765}]", "[{'name': 'Himmlischer Kreuzritter', 'text': 'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)\\nSekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche wirken oder Fähigkeiten aktivieren, die keine Manafähigkeiten sind.)\\nFliegend\\nAndere weiße Kreaturen erhalten +1/+1.', 'type': 'Kreatur — Geist', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390135&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a55672ee-fd19-48bd-904f-4f188b5a5c37', 'multiverseId': 390135}, 'multiverseid': 390135}, {'name': 'Cruzado celestial', 'text': 'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)\\nFracción de segundo. (Mientras este hechizo esté en la pila, los jugadores no pueden lanzar hechizos o activar habilidades que no sean habilidades de maná.)\\nVuela.\\nLas otras criaturas blancas obtienen +1/+1.', 'type': 'Criatura — Espíritu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391483&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '38e9c4f4-1f68-4bfc-9c16-7b55130a39e5', 'multiverseId': 391483}, 'multiverseid': 391483}, {'name': 'Croisé céleste', 'text': 'Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)\\nFraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas lancer de sorts ou activer de capacités qui ne sont pas des capacités de mana.)\\nVol\\nLes autres créatures blanches gagnent +1/+1.', 'type': 'Créature : esprit', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390472&type=card', 'language': 'French', 'identifiers': {'scryfallId': '001be5ed-52a7-477d-beae-1c0c5e630ba5', 'multiverseId': 390472}, 'multiverseid': 390472}, {'name': 'Crociato Celestiale', 'text': 'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)\\nBattibaleno (Fintanto che questa magia è in pila, i giocatori non possono lanciare magie o attivare abilità che non siano abilità di mana.)\\nVolare\\nLe altre creature bianche prendono +1/+1.', 'type': 'Creatura — Spirito', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390809&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6d76ca67-d48f-47d1-8b5c-770444cd22c5', 'multiverseId': 390809}, 'multiverseid': 390809}, {'name': '天界の十字軍', 'text': '瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）\\n刹那（この呪文がスタックにあるかぎり、プレイヤーは呪文を唱えられず、マナ能力でない起動型能力を起動できない。）\\n飛行\\n他の白のクリーチャーは＋１/＋１の修整を受ける。', 'type': 'クリーチャー — スピリット', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391146&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9a0abae3-f633-49e2-8a47-141d5f091cec', 'multiverseId': 391146}, 'multiverseid': 391146}, {'name': '天界十字军', 'text': '闪现（你可以于你能够施放瞬间的时机下施放此咒语。）\\n转瞬（只要此咒语在堆叠上，牌手便不能施放咒语或起动不是法术力异能的异能。）\\n飞行\\n其他白色生物得+1/+1。', 'type': '生物～精怪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389798&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3e23cec9-77a9-4242-8720-216bedf4591f', 'multiverseId': 389798}, 'multiverseid': 389798}]", '[{\'name\': \'Holzwart-Elf\', \'text\': \'{T}: Eine Kreatur deiner Wahl erhält +X/+X bis zum Ende des Zuges, wobei X gleich der Anzahl an Elfen im Spiel ist.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'Selbst in der Stimme des Mirari hören die Elfen noch den Ruf ihrer Verwandten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390394&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f02379d-2182-4c62-a3d9-7423c97a6bdc\', \'multiverseId\': 390394}, \'multiverseid\': 390394}, {\'name\': \'Elfo vigilabosques\', \'text\': \'{T}: La criatura objetivo obtiene +X/+X hasta el final del turno, donde X es la cantidad de Elfos en el campo de batalla.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'Los elfos oyen el llamado de sus parientes incluso por encima de la voz del Mirari.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391742&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40dee778-c684-4971-aa05-9c5742ca79fa\', \'multiverseId\': 391742}, \'multiverseid\': 391742}, {\'name\': \'Elfe gardebois\', \'text\': "{T} : La créature ciblée gagne +X/+X jusqu\'à la fin du tour, X étant le nombre d\'elfes sur le champ de bataille.", \'type\': \'Créature : elfe\', \'flavor\': "Même troublés par la voix du Mirari, les elfes entendaient toujours l\'appel de leurs semblables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390731&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15f79bc6-28b2-4b97-83ca-1f272c9bfdcd\', \'multiverseId\': 390731}, \'multiverseid\': 390731}, {\'name\': \'Elfo Guardaboschi\', \'text\': \'{T}: Una creatura bersaglio prende +X/+X fino alla fine del turno, dove X è il numero di Elfi sul campo di battaglia.\', \'type\': \'Creatura — Elfo\', \'flavor\': \'Anche attraverso la voce del Mirari, gli elfi riuscivano ancora a sentire il richiamo dei propri simili.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391068&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1553751-d517-4c9b-bc5f-efeb674c2be1\', \'multiverseId\': 391068}, \'multiverseid\': 391068}, {\'name\': \'森林守りのエルフ\', \'text\': \'{T}：クリーチャー１体を対象とする。ターン終了時まで、それは＋Ｘ/＋Ｘの修整を受ける。Ｘは戦場に出ているエルフの総数に等しい。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': \'エルフが仲間を呼ぶ声は、ミラーリの声を通してさえ響きあう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391405&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a10806d6-323f-4818-b5a1-1dd5eb2c8dcf\', \'multiverseId\': 391405}, \'multiverseid\': 391405}, {\'name\': \'巡林妖精\', \'text\': \'{T}：目标生物得+X/+X直到回合结束，X为战场上妖精的数量。\', \'type\': \'生物～妖精\', \'flavor\': \'在映奇宝珠的喧扰声中，妖精依旧能听见族人的呼唤。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390057&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'def28b81-ce01-4e36-9773-1fd08dc1b1a8\', \'multiverseId\': 390057}, \'multiverseid\': 390057}]', '[{\'name\': \'Hortschmelzender Drache\', \'text\': \'Fliegend\\n{3}{R}: Zerstöre ein Artefakt deiner Wahl. Der Hortschmelzende Drache erhält +X/+0 bis zum Ende des Zuges, wobei X gleich den umgewandelten Manakosten dieses Artefakts ist.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Er sammelt die wertvollen Metalle und wandelt dann den Rest in Treibgas um.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390222&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d0d3368-076c-41a9-9381-cdf70bb7cf67\', \'multiverseId\': 390222}, \'multiverseid\': 390222}, {\'name\': \'Dragón fundetesoros\', \'text\': \'Vuela.\\n{3}{R}: Destruye el artefacto objetivo. El Dragón fundetesoros obtiene +X/+0 hasta el final del turno, donde X es el coste de maná convertido de ese artefacto.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Colecciona los metales preciosos, y luego convierte el resto en propulsor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391570&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f0bdebb-b6ae-4e70-b254-78d630fbc868\', \'multiverseId\': 391570}, \'multiverseid\': 391570}, {\'name\': \'Dragon fondeur de butin\', \'text\': "Vol\\n{3}{R} : Détruisez l\'artefact ciblé. Le Dragon fondeur de butin gagne +X/+0 jusqu\'à la fin du tour, X étant le coût converti de mana de cet artefact.", \'type\': \'Créature : dragon\', \'flavor\': \'Il récupère les métaux précieux et transforme ensuite le reste en carburant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390559&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bddd24f9-1265-4e46-a1d7-bd1a70a110f5\', \'multiverseId\': 390559}, \'multiverseid\': 390559}, {\'name\': \'Drago Fonditesori\', \'text\': "Volare\\n{3}{R}: Distruggi un artefatto bersaglio. Il Drago Fonditesori prende +X/+0 fino alla fine del turno, dove X è il costo di mana convertito di quell\'artefatto.", \'type\': \'Creatura — Drago\', \'flavor\': \'Accumula metalli preziosi e poi converte il resto in propellente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390896&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3bfcc067-067b-435e-9852-356744c292fb\', \'multiverseId\': 390896}, \'multiverseid\': 390896}, {\'name\': \'蔵製錬のドラゴン\', \'text\': \'飛行\\n{3}{R}：アーティファクト１つを対象とし、それを破壊する。ターン終了時まで、蔵製錬のドラゴンは＋Ｘ/＋０の修整を受ける。Ｘはそのアーティファクトの点数で見たマナ・コストに等しい。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'彼は貴重な金属を集め、残りを噴気へと変える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391233&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc21c922-60c8-4c4c-ac17-f112a862af80\', \'multiverseId\': 391233}, \'multiverseid\': 391233}, {\'name\': \'炼储巨龙\', \'text\': \'飞行\\n{3}{R}：消灭目标神器。炼储巨龙得+X/+0直到回合结束，X为该神器的总法术力费用。\', \'type\': \'生物～龙\', \'flavor\': \'他收集贵金属，然后将其他的转化为推进燃料。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389885&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dbcc6ddf-61b5-4ca2-91ca-8bdffa6b2dbf\', \'multiverseId\': 389885}, \'multiverseid\': 389885}]', '[{\'name\': \'Hymne des Marschalls\', \'text\': \'Multibonus {1}{W} (Du kannst zusätzlich beliebig oft {1}{W} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nKreaturen, die du kontrollierst, erhalten +1/+1.\\nWenn die Hymne des Marschalls ins Spiel kommt, bringe bis zu X Kreaturenkarten deiner Wahl aus deinem Friedhof ins Spiel zurück, wobei X gleich der Anzahl ist, wie oft die Bonuskosten der Hymne des Marschalls bezahlt wurden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390263&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe663500-94d9-4377-96da-1aee69fe03e9\', \'multiverseId\': 390263}, \'multiverseid\': 390263}, {\'name\': \'Himno del mariscal\', \'text\': \'Multiestímulo {1}{W}. (Puedes pagar {1}{W} adicional tantas veces como quieras al lanzar este hechizo.)\\nLas criaturas que controlas obtienen +1/+1.\\nCuando el Himno del mariscal entre al campo de batalla, regresa hasta X cartas de criatura objetivo de tu cementerio al campo de batalla, donde X es igual a la cantidad de veces que el Himno del mariscal fue estimulado.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391611&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4f74662-f1e1-4c3b-a997-87589f47deca\', \'multiverseId\': 391611}, \'multiverseid\': 391611}, {\'name\': \'Antienne du maréchal\', \'text\': "Multikick {1}{W} (Vous pouvez payer {1}{W} supplémentaires autant de fois que vous le souhaitez au moment où vous lancez ce sort.)\\nLes créatures que vous contrôlez gagnent +1/+1.\\nQuand l\'Antienne du maréchal arrive sur le champ de bataille, renvoyez sur le champ de bataille jusqu\'à X cartes de créature ciblées depuis votre cimetière, X étant le nombre de fois que l\'Antienne du maréchal a été kickée.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390600&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad73beac-a110-4987-9baf-8b01d937b24e\', \'multiverseId\': 390600}, \'multiverseid\': 390600}, {\'name\': \'Inno del Maresciallo\', \'text\': "Multipotenziamento {1}{W} (Puoi pagare {1}{W} addizionale un qualsiasi numero di volte mentre lanci questa magia.)\\nLe creature che controlli prendono +1/+1.\\nQuando l\'Inno del Maresciallo entra nel campo di battaglia, rimetti sul campo di battaglia fino a X carte creatura bersaglio dal tuo cimitero, dove X è il numero di volte che l\'Inno del Maresciallo è stato potenziato.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390937&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'328c5345-b28f-4f95-b8bb-69fad65b82cf\', \'multiverseId\': 390937}, \'multiverseid\': 390937}, {\'name\': \'司令官の頌歌\', \'text\': \'多重キッカー{1}{W}（あなたはこの呪文を唱えるに際し、追加で{1}{W}を望む回数支払ってもよい。）\\nあなたがコントロールするクリーチャーは＋１/＋１の修整を受ける。\\n司令官の頌歌が戦場に出たとき、あなたの墓地にあるクリーチャー・カードを最大Ｘ枚まで対象とし、それらを戦場に戻す。Ｘは司令官の頌歌がキッカーされた回数に等しい。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391274&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf1468dd-3506-4a0d-997b-d3783de58ff4\', \'multiverseId\': 391274}, \'multiverseid\': 391274}, {\'name\': \'元帅赞美诗\', \'text\': \'多重增幅{1}{W}（你施放此咒语时可以任意次数地额外支付{1}{W}。）\\n由你操控的生物得+1/+1。\\n当元帅赞美诗进战场时，将至多X张目标生物牌从你的坟墓场移回战场，X为元帅赞美诗增幅过的次数。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389926&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2a92c2a0-6927-4bae-915c-d90d2101deab\', \'multiverseId\': 389926}, \'multiverseid\': 389926}]', "[{'name': 'Höllischer Verfolger', 'text': 'Fliegend, verursacht Trampelschaden\\nDu kannst die Partie nicht gewinnen, und deine Gegner können die Partie nicht verlieren.', 'type': 'Kreatur — Dämon', 'flavor': 'Seine Sklaven sehnen sich mehr nach dem Tod als nach der Freiheit. Er gönnt ihnen beides nicht.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390096&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6871cf8c-10c1-4e7b-bcd0-6332f222922b', 'multiverseId': 390096}, 'multiverseid': 390096}, {'name': 'Perseguidor abismal', 'text': 'Vuela, arrolla.\\nTú no puedes ganar el juego y tus oponentes no pueden perder el juego.', 'type': 'Criatura — Demonio', 'flavor': 'Sus esclavos desean más la muerte que la libertad. Él les niega ambas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391444&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0e1e529e-34d1-42c5-865b-998346fb2dd7', 'multiverseId': 391444}, 'multiverseid': 391444}, {'name': 'Persécuteur abyssal', 'text': 'Vol, piétinement\\nVous ne pouvez pas gagner la partie et vos adversaires ne peuvent pas la perdre.', 'type': 'Créature : démon', 'flavor': 'Ses esclaves préfèrent la mort à la liberté. Il leur refuse les deux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390433&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3c1fb54d-3200-47ca-bbe5-30952251d997', 'multiverseId': 390433}, 'multiverseid': 390433}, {'name': 'Persecutore Abissale', 'text': 'Volare, travolgere\\nNon puoi vincere la partita e i tuoi avversari non possono perdere la partita.', 'type': 'Creatura — Demone', 'flavor': 'I suoi schiavi bramano la morte più di quanto non desiderino la libertà. Lui nega loro entrambe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390770&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dbe963b8-951d-4557-b9ae-b7872a0870a8', 'multiverseId': 390770}, 'multiverseid': 390770}, {'name': '深淵の迫害者', 'text': '飛行、トランプル\\nあなたはこのゲームに勝利することができず、あなたの対戦相手はこのゲームに敗北することができない。', 'type': 'クリーチャー — デーモン', 'flavor': '彼の奴隷は、自由を求めるよりも死を望んでいる。彼はそのどちらも許さない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391107&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9ab0a988-1d9a-442a-af45-0bef60239a78', 'multiverseId': 391107}, 'multiverseid': 391107}, {'name': '深渊虐魔', 'text': '飞行，践踏\\n你这盘游戏不会赢，对手也不会输。', 'type': '生物～恶魔', 'flavor': '比起希冀自由，他的奴隶还更渴求一死。但他两者都不许。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389759&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '673a37ea-d6ec-4357-bee0-c88b4613b6d4', 'multiverseId': 389759}, 'multiverseid': 389759}]", "[{'name': 'Höllisches Präsent', 'text': 'Bestimme einen Gegner. Du und dieser Spieler opfert je eine Kreatur. Jeder Spieler, der auf diese Weise eine Kreatur geopfert hat, zieht zwei Karten.\\nBestimme einen Gegner. Bringe eine Kreaturenkarte aus deinem Friedhof ins Spiel zurück und dann bringt dieser Spieler eine Kreaturenkarte aus seinem Friedhof ins Spiel zurück.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390230&type=card', 'language': 'German', 'identifiers': {'scryfallId': '38176a7e-7447-4960-ad8d-1f2d7ad82c41', 'multiverseId': 390230}, 'multiverseid': 390230}, {'name': 'Ofrenda infernal', 'text': 'Elige un oponente. Ese jugador y tú sacrifican una criatura cada uno. Cada jugador que sacrificó una criatura de esta manera roba dos cartas.\\nElige un oponente. Regresa una carta de criatura de tu cementerio al campo de batalla, luego ese jugador regresa una carta de criatura de su cementerio al campo de batalla.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391578&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3b118473-98f0-448d-a267-bd0ac1902de3', 'multiverseId': 391578}, 'multiverseid': 391578}, {'name': 'Offrande infernale', 'text': 'Choisissez un adversaire. Ce joueur et vous sacrifiez chacun une créature. Chaque joueur qui a sacrifié une créature de cette manière pioche deux cartes.\\nChoisissez un adversaire. Renvoyez sur le champ de bataille une carte de créature depuis votre cimetière, puis ce joueur renvoie sur le champ de bataille une carte de créature depuis son cimetière.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390567&type=card', 'language': 'French', 'identifiers': {'scryfallId': '040b362f-5332-40af-b00d-726d9524e77c', 'multiverseId': 390567}, 'multiverseid': 390567}, {'name': 'Offerta Infernale', 'text': 'Scegli un avversario. Tu e quel giocatore sacrificate ognuno una creatura. Ogni giocatore che ha sacrificato una creatura in questo modo pesca due carte.\\nScegli un avversario. Rimetti sul campo di battaglia una carta creatura dal tuo cimitero, poi quel giocatore rimette sul campo di battaglia una carta creatura dal suo cimitero.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390904&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c6c7209f-f52c-493e-b397-b9dc98fad8f0', 'multiverseId': 390904}, 'multiverseid': 390904}, {'name': '冥府の捧げ物', 'text': '対戦相手を１人選ぶ。あなたとそのプレイヤーはそれぞれクリーチャーを１体生け贄に捧げる。これによりクリーチャーを生け贄に捧げた各プレイヤーはカードを２枚引く。\\n対戦相手を１人選ぶ。あなたの墓地にあるクリーチャー・カード１枚を戦場に戻す。その後、そのプレイヤーは自分の墓地にあるクリーチャー・カード１枚を戦場に戻す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391241&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ba4848e9-7f2c-4f67-ab80-868b9b1bfdf4', 'multiverseId': 391241}, 'multiverseid': 391241}, {'name': '炼狱乐施', 'text': '选择一位对手。你和该牌手各牺牲一个生物。每位以此法牺牲生物的牌手各抓两张牌。\\n选择一位对手。将一张生物牌从你的坟墓场移回战场，然后该牌手将一张生物牌从他的坟墓场移回战场。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389893&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2f7945af-8aff-48e1-bdb9-7e944673f087', 'multiverseId': 389893}, 'multiverseid': 389893}]", '[{\'name\': \'Hüter des Lebenssafts\', \'text\': \'Immer wenn eine andere Kreatur ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Je weiter unsere Zahl ansteigt, desto mehr kann ich hoffen, dass Volrath und seine verdammte Felsenburg eines Tages fallen werden." —Eladamri, Herr des Waldes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390179&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'853f38f1-729b-4c21-9404-22a3356cad4d\', \'multiverseId\': 390179}, \'multiverseid\': 390179}, {\'name\': \'Protectora de esencia\', \'text\': \'Siempre que otra criatura entre al campo de batalla, gana 1 vida.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"Cuantos más somos, más esperanzas tengo de que Volrath y su maldita fortaleza caigan al fin." —Eladamri, señor de las frondas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391527&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0384fab-a1a2-4adc-9459-d634a1ad0c07\', \'multiverseId\': 391527}, \'multiverseid\': 391527}, {\'name\': "Garde d\'essence", \'text\': "À chaque fois qu\'une autre créature arrive sur le champ de bataille, vous gagnez 1 point de vie.", \'type\': \'Créature : elfe et shamane\', \'flavor\': "« Plus nous sommes nombreux, et plus j\'ai espoir que Wöhlrajh et sa maudite forteresse tomberont un jour. » — Éladämri, seigneur des frondaisons", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390516&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'473aedff-3b16-44ec-a3ae-c2ade6c5c666\', \'multiverseId\': 390516}, \'multiverseid\': 390516}, {\'name\': "Guardiana dell\'Essenza", \'text\': "Ogniqualvolta un\'altra creatura entra nel campo di battaglia, guadagni 1 punto vita.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"Più aumentiamo di numero e più cresce la mia speranza che Volrath e la sua fortezza maledetta possano un giorno soccombere." —Eladamri, Signore delle Foglie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390853&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'27025423-3c9f-4d01-b8c4-adcddd347006\', \'multiverseId\': 390853}, \'multiverseid\': 390853}, {\'name\': \'本質の管理人\', \'text\': \'他のクリーチャーが１体戦場に出るたび、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「我々の数が増えていくにつれ、ヴォルラスと彼の呪われた要塞がいつかは倒されるという希望も増えていくのだ。」 ――葉の王エラダムリー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391190&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b4b52e7-8804-4456-aecb-2dd4e3aa7da8\', \'multiverseId\': 391190}, \'multiverseid\': 391190}, {\'name\': \'护华师\', \'text\': \'每当另一个生物进战场时，你获得1点生命。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'「随着我方势力增强，我更确信瓦拉司与那受诅的城塞必有败亡之日。」 ～叶海大帝艾拉达力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389842&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f8735016-ff66-455e-b186-6760b5469eea\', \'multiverseId\': 389842}, \'multiverseid\': 389842}]', '[{\'name\': \'Immervoller Kelch\', \'text\': \'Multibonus {2} (Du kannst zusätzlich beliebig oft {2} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nDer Immervolle Kelch kommt mit X Ladungsmarken ins Spiel, wobei X die Anzahl ist, wie oft seine Bonuskosten bezahlt wurden.\\n{T}: Erhöhe deinen Manavorrat für jede Ladungsmarke auf dem Immervollen Kelch um {1}.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390180&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54b26886-0ff4-448b-b150-904fc14d060a\', \'multiverseId\': 390180}, \'multiverseid\': 390180}, {\'name\': \'Cáliz flujo eterno\', \'text\': \'Multiestímulo {2}. (Puedes pagar {2} adicional tantas veces como quieras al lanzar este hechizo.)\\nEl Cáliz flujo eterno entra al campo de batalla con un contador de carga sobre él por cada vez que fue estimulado.\\n{T}: Agrega {1} a tu reserva de maná por cada contador de carga sobre el Cáliz flujo eterno.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391528&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7c0073ed-66ad-4a0f-b305-1834752ec827\', \'multiverseId\': 391528}, \'multiverseid\': 391528}, {\'name\': \'Calice toujours ruisselant\', \'text\': "Multikick {2} (Vous pouvez payer {2} supplémentaires autant de fois que vous le souhaitez au moment où vous lancez ce sort.)\\nLe Calice toujours ruisselant arrive sur le champ de bataille avec, sur lui, un marqueur « charge » pour chaque fois qu\'il a été kické.\\n{T} : Ajoutez {1} à votre réserve pour chaque marqueur « charge » sur le Calice toujours ruisselant.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8c09caa-10a4-48b3-921a-bbf3d4627756\', \'multiverseId\': 390517}, \'multiverseid\': 390517}, {\'name\': \'Calice Infinito\', \'text\': \'Multipotenziamento {2} (Puoi pagare {2} addizionale un qualsiasi numero di volte mentre lanci questa magia.)\\nIl Calice Infinito entra nel campo di battaglia con un segnalino carica per ogni volta che è stato potenziato.\\n{T}: Aggiungi {1} alla tua riserva di mana per ogni segnalino carica sul Calice Infinito.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390854&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73b0c7ba-f2f2-4304-b175-c61881768c6b\', \'multiverseId\': 390854}, \'multiverseid\': 390854}, {\'name\': \'永遠溢れの杯\', \'text\': \'多重キッカー{2}（あなたはこの呪文を唱えるに際し、追加で{2}を望む回数支払ってもよい。）\\n永遠溢れの杯は、これがキッカーされた１回につき蓄積カウンターが１個置かれた状態で戦場に出る。\\n{T}：あなたのマナ・プールに、永遠溢れの杯の上に置かれている蓄積カウンター１個につき{1}を加える。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391191&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13681c80-0566-4e4e-99e2-81116d1bfc46\', \'multiverseId\': 391191}, \'multiverseid\': 391191}, {\'name\': \'汨汨圣杯\', \'text\': \'多重增幅{2}（你施放此咒语时可以任意次数地额外支付{2}。）\\n汨汨圣杯进战场时上面有数个充电指示物，其数量为它增幅过的次数。\\n{T}：汨汨圣杯上每有一个充电指示物，便加{1}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389843&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb013a0c-70e9-40a4-8bf7-5eda05d608ab\', \'multiverseId\': 389843}, \'multiverseid\': 389843}]', '[{\'name\': \'Immerändernde Weite\', \'text\': \'{T}, opfere die Immerändernde Weite: Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe sie getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390390&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e77ce467-3c05-44d3-bfc9-38e60f2083e5\', \'multiverseId\': 390390}, \'multiverseid\': 390390}, {\'name\': \'Expansión terramórfica\', \'text\': \'{T}, sacrificar la Expansión terramórfica: Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391738&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'353aee91-39ea-44f9-b869-6f11d1331b52\', \'multiverseId\': 391738}, \'multiverseid\': 391738}, {\'name\': \'Immensité terramorphe\', \'text\': "{T}, sacrifiez l\'Immensité terramorphe : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390727&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'701fb603-c03d-4551-b4be-994a9bed9801\', \'multiverseId\': 390727}, \'multiverseid\': 390727}, {\'name\': \'Distesa Terramorfica\', \'text\': \'{T}, Sacrifica la Distesa Terramorfica: Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391064&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6ce482e-a0ad-4e16-9445-36facdb9bad8\', \'multiverseId\': 391064}, \'multiverseid\': 391064}, {\'name\': \'広漠なる変幻地\', \'text\': \'{T}, 広漠なる変幻地を生け贄に捧げる：あなたのライブラリーから基本土地・カードを１枚探し、それをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391401&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97b1b060-0323-474d-ab6f-f9c55835e93c\', \'multiverseId\': 391401}, \'multiverseid\': 391401}, {\'name\': \'地塑旷野\', \'text\': \'{T}，牺牲地塑旷野：从你的牌库中搜寻一张基本地牌，并将之横置进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390053&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a029de62-2e4b-4126-9f13-25f66e70fb5f\', \'multiverseId\': 390053}, \'multiverseid\': 390053}]', '[{\'name\': \'In Erinnerung rufen\', \'text\': \'Bringe eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Es ist schwer zu sagen, was befriedigender ist: die Suche nach dem fehlenden Teil oder es dann einzusetzen." —Evo Ragus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390132&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37b67b5b-b46c-43a9-8c0d-275364da7f50\', \'multiverseId\': 390132}, \'multiverseid\': 390132}, {\'name\': \'Traer el recuerdo\', \'text\': \'Regresa la carta de instantáneo o conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Conjuro\', \'flavor\': \'"Es difícil decidir qué es más satisfactorio: la búsqueda de la pieza que falta, o colocar esa pieza en su lugar." —Evo Ragus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391480&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c782c44b-57cc-438a-817b-1c2200428600\', \'multiverseId\': 391480}, \'multiverseid\': 391480}, {\'name\': "Appel à l\'esprit", \'text\': "Renvoyez la carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Rituel\', \'flavor\': \'« Il est difficile de dire ce qui est le plus satisfaisant : rechercher la pièce manquante, ou la placer. » —Evo Ragus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390469&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b624f50-5179-4b0b-bb48-8ef1d39220ab\', \'multiverseId\': 390469}, \'multiverseid\': 390469}, {\'name\': \'Richiamare alla Mente\', \'text\': \'Riprendi in mano una carta istantaneo o stregoneria bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"È difficile dire cosa sia più soddisfacente: cercare il pezzo mancante o infilarlo al suo posto." —Evo Ragus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390806&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4cefa6e3-090b-4195-ab87-33c05f6716c0\', \'multiverseId\': 390806}, \'multiverseid\': 390806}, {\'name\': \'思い起こし\', \'text\': \'あなたの墓地にあるインスタント・カード１枚かソーサリー・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「欠けた何かを見つける事と、それをその場にはめ込む事か。どちらがより満足かは難しいところだ。」 ――イーヴォ・レイジャス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391143&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'349da8bc-4a5f-41cd-9185-3c51cb453963\', \'multiverseId\': 391143}, \'multiverseid\': 391143}, {\'name\': \'回忆升起\', \'text\': \'将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'法术\', \'flavor\': \'「很难说哪一项比较令人满足：寻找失落的那块，或是把它拼回去。」 ～艾佛拉格斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389795&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'306cf22b-2883-48fa-8d96-dc82ae85be4f\', \'multiverseId\': 389795}, \'multiverseid\': 389795}]', '[{\'name\': \'In die Turbulenz hinein\', \'text\': \'Bonus {1}{U} (Du kannst zusätzlich {1}{U} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nBringe eine bleibende Karte deiner Wahl, die kein Land ist, auf die Hand ihres Besitzers zurück. Falls die Bonuskosten von In die Turbulenz hinein bezahlt wurden, ziehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Turbulenz kommt! Die Turbulenz kommt! Bindet euch fest!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390234&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3292c65-8065-4526-a396-72b4d065ddf5\', \'multiverseId\': 390234}, \'multiverseid\': 390234}, {\'name\': \'Dentro de la Turbulencia\', \'text\': \'Estímulo {1}{U}. (Puedes pagar {1}{U} adicional al lanzar este hechizo.)\\nRegresa el permanente objetivo que no sea tierra a la mano de su propietario. Si Dentro de la Turbulencia fue estimulado, roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Marea de Turbulencia! ¡Marea de Turbulencia! ¡Sujétense!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391582&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d78bb22b-ccc9-4f1b-94e7-6aaa5d6060b9\', \'multiverseId\': 391582}, \'multiverseid\': 391582}, {\'name\': \'En plein Roulis\', \'text\': \'Kick {1}{U} (Vous pouvez payer {1}{U} supplémentaires au moment où vous lancez ce sort.)\\nRenvoyez le permanent non-terrain ciblé dans la main de son propriétaire. Si En plein Roulis a été kické, piochez une carte.\', \'type\': \'Éphémère\', \'flavor\': \'« Vague de Roulis ! Vague de Roulis ! Attachez-vous ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390571&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c28e7f75-4eb2-4ffc-b1aa-416cb7fd423d\', \'multiverseId\': 390571}, \'multiverseid\': 390571}, {\'name\': \'Nel Torbido\', \'text\': \'Potenziamento {1}{U} (Puoi pagare {1}{U} addizionale mentre lanci questa magia.)\\nFai tornare un permanente non terra bersaglio in mano al suo proprietario. Se Nel Torbido è stato potenziato, pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Marea torbida! Marea torbida! Tenetevi stretti!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390908&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6feda527-3609-45d7-b1fb-c9341f12d1ee\', \'multiverseId\': 390908}, \'multiverseid\': 390908}, {\'name\': \'乱動への突入\', \'text\': \'キッカー{1}{U}（あなたはこの呪文を唱えるに際し、追加で{1}{U}を支払ってもよい。）\\n土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。乱動への突入がキッカーされていたなら、カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「乱動の潮目だ！乱動の潮目だ！どこかに身体を縛り付けろ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391245&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c05d25a-ea6a-4f28-919d-7576c5857c2f\', \'multiverseId\': 391245}, \'multiverseid\': 391245}, {\'name\': \'没入狂搅\', \'text\': \'增幅{1}{U}（你可以在施放此咒语时额外支付{1}{U}。）\\n将目标非地永久物移回其拥有者手上。如果没入狂搅已增幅，则抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「狂搅潮！是狂搅潮！快把自己扎紧！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389897&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73215059-bcd3-4bab-9239-4538e939c562\', \'multiverseId\': 389897}, \'multiverseid\': 389897}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390235&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e7434a1f-2ef4-4598-94de-628e631c61c7', 'multiverseId': 390235}, 'multiverseid': 390235}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391583&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '97cc77fb-2965-4ad6-8553-f466731b6861', 'multiverseId': 391583}, 'multiverseid': 391583}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390572&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2587d75c-177a-48cd-b188-752362d29738', 'multiverseId': 390572}, 'multiverseid': 390572}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390909&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cf9120da-5566-4176-bb5a-09ece9bc9a16', 'multiverseId': 390909}, 'multiverseid': 390909}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391246&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd1fde4f2-dbee-42f4-9422-132348f7c809', 'multiverseId': 391246}, 'multiverseid': 391246}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389898&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'de7485c1-84b4-4406-964b-4a20681c128c', 'multiverseId': 389898}, 'multiverseid': 389898}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390236&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cdde123b-ef4a-430e-9174-be4bff51d877', 'multiverseId': 390236}, 'multiverseid': 390236}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391584&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bfeebe7c-b3c5-4fd9-85f9-8eef547811bc', 'multiverseId': 391584}, 'multiverseid': 391584}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390573&type=card', 'language': 'French', 'identifiers': {'scryfallId': '638e3c5e-a59a-459b-871e-7286c498e513', 'multiverseId': 390573}, 'multiverseid': 390573}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390910&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6f78e353-ef77-4466-ad18-bbd2ec385334', 'multiverseId': 390910}, 'multiverseid': 390910}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391247&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'abf4e7db-3104-4253-95e3-f159e09da9a0', 'multiverseId': 391247}, 'multiverseid': 391247}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389899&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a1212da0-ae80-476b-9bbe-51bc61261da5', 'multiverseId': 389899}, 'multiverseid': 389899}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390237&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bae8bd09-bc57-4637-a171-f2ca3a857a2d', 'multiverseId': 390237}, 'multiverseid': 390237}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391585&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '17d9e1af-168a-46f8-8f40-9860849cb62d', 'multiverseId': 391585}, 'multiverseid': 391585}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390574&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'df2f5203-6767-46f1-8582-64c81d97730a', 'multiverseId': 390574}, 'multiverseid': 390574}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390911&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ac3477e4-ca8e-46c9-985d-b862c647c35a', 'multiverseId': 390911}, 'multiverseid': 390911}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391248&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '711c9784-0d65-4445-a9fa-7eb23bc80f5d', 'multiverseId': 391248}, 'multiverseid': 391248}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389900&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b66de310-14a1-4d20-8729-be433fae6d8f', 'multiverseId': 389900}, 'multiverseid': 389900}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390238&type=card', 'language': 'German', 'identifiers': {'scryfallId': '46cd1174-9288-48a7-9c26-1145f7576545', 'multiverseId': 390238}, 'multiverseid': 390238}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391586&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3b636940-83a5-4fd7-a39f-9cead70795fa', 'multiverseId': 391586}, 'multiverseid': 391586}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390575&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd13bca47-d92d-4288-9e6a-9c6b85e61245', 'multiverseId': 390575}, 'multiverseid': 390575}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390912&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0484f04d-0329-4125-8974-ac7e2ef67e5d', 'multiverseId': 390912}, 'multiverseid': 390912}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391249&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '28de556b-f943-4b5c-9e35-bb29c2f3e1a5', 'multiverseId': 391249}, 'multiverseid': 391249}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389901&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c159e7c0-f322-433a-97e1-8c7e74d6b524', 'multiverseId': 389901}, 'multiverseid': 389901}]", '[{\'name\': \'Instabiler Obelisk\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{7}, {T}, opfere den Instabilen Obelisken: Zerstöre eine bleibende Karte deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'Sein Zerfall ist wie das letzte Aufbäumen einer längst vergangenen Zivilisation, die es nicht ertragen kann, in Vergessenheit zu geraten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390407&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5a8a9b2f-884f-494e-9bf3-cce973e96d70\', \'multiverseId\': 390407}, \'multiverseid\': 390407}, {\'name\': \'Obelisco inestable\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{7}, {T}, sacrificar el Obelisco inestable: Destruye el permanente objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'Su derrumbamiento es como la insolencia de una civilización largo tiempo extinta y ofendida por haber sido olvidada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391755&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c0690f21-2dd3-4d68-b448-3960bd1d4754\', \'multiverseId\': 391755}, \'multiverseid\': 391755}, {\'name\': \'Obélisque instable\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{7}, {T}, sacrifiez l\'Obélisque instable : Détruisez le permanent ciblé.", \'type\': \'Artefact\', \'flavor\': "Son effondrement est l\'ultime attaque d\'une civilisation disparue qui refuse de sombrer dans l\'oubli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390744&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8244e00a-2d72-4686-8109-cba3c8e9c393\', \'multiverseId\': 390744}, \'multiverseid\': 390744}, {\'name\': \'Obelisco Instabile\', \'text\': "{T}: Aggiungi {1} alla tua riserva di mana.\\n{7}, {T}, Sacrifica l\'Obelisco Instabile: Distruggi un permanente bersaglio.", \'type\': \'Artefatto\', \'flavor\': \'Il suo crollo è il monito stizzito di una civiltà scomparsa da tempo che non sopporta di essere dimenticata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391081&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ac32290e-4717-408c-9566-f3d5139743aa\', \'multiverseId\': 391081}, \'multiverseid\': 391081}, {\'name\': \'不安定なオベリスク\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{7}, {T}, 不安定なオベリスクを生け贄に捧げる：パーマネント１つを対象とし、それを破壊する。\', \'type\': \'アーティファクト\', \'flavor\': \'その崩壊は、遠い昔に死に絶えた文明が忘れ去られることへの不満を表す足掻きのようであった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391418&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dec05c2d-6e40-4e50-846c-e65d695b84c6\', \'multiverseId\': 391418}, \'multiverseid\': 391418}, {\'name\': \'不稳定石碑\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{7}，{T}，牺牲不稳定石碑：消灭目标永久物。\', \'type\': \'神器\', \'flavor\': \'远古文明若遭后人遗忘，定会带来惨烈后果以警醒世人。此座石碑之坍塌亦然。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390070&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df556379-6e49-452e-a6f2-807e8032904c\', \'multiverseId\': 390070}, \'multiverseid\': 390070}]', '[{\'name\': \'Ixidron\', \'text\': \'Sowie das Ixidron ins Spiel kommt, verdecke alle anderen Nichtspielsteinkreaturen. (Sie sind 2/2 Kreaturen)\\nStärke und Widerstandskraft des Ixidrons sind gleich der Anzahl an verdeckten Kreaturen im Spiel.\', \'type\': \'Kreatur — Illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390239&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2afcd950-69b0-4816-9843-bbf7257febaf\', \'multiverseId\': 390239}, \'multiverseid\': 390239}, {\'name\': \'Íxidron\', \'text\': \'En cuanto el Íxidron entre al campo de batalla, pon boca abajo todas las otras criaturas que no sean fichas. (Son criaturas 2/2.)\\nTanto la fuerza como la resistencia del Íxidron son iguales a la cantidad de criaturas que están boca abajo en el campo de batalla.\', \'type\': \'Criatura — Ilusión\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391587&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'737e5fb0-082a-49eb-809e-6d3f52e0cae8\', \'multiverseId\': 391587}, \'multiverseid\': 391587}, {\'name\': \'Ixidron\', \'text\': "Au moment où Ixidron arrive sur le champ de bataille, retournez toutes les autres créatures non-jeton face cachée. (Ce sont des créatures 2/2.)\\nLa force et l\'endurance d\'Ixidron sont chacune égales au nombre de créatures face cachée sur le champ de bataille.", \'type\': \'Créature : illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390576&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d76938b9-61be-447e-b9e7-fb6eaed08cab\', \'multiverseId\': 390576}, \'multiverseid\': 390576}, {\'name\': \'Ixidron\', \'text\': \'Mentre Ixidron entra nel campo di battaglia, gira a faccia in giù tutte le altre creature non pedina. (Sono creature 2/2.)\\nLa forza e la costituzione di Ixidron sono pari al numero di creature a faccia in giù sul campo di battaglia.\', \'type\': \'Creatura — Illusione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390913&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a071ebd1-c61f-4067-a60f-bcfd8ae2c6b0\', \'multiverseId\': 390913}, \'multiverseid\': 390913}, {\'name\': \'イクシドロン\', \'text\': \'イクシドロンが戦場に出るに際し、他のトークンでないすべてのクリーチャーを裏向きにする。（それらは２/２のクリーチャーである。）\\nイクシドロンのパワーとタフネスは、それぞれ戦場に出ている裏向きのクリーチャーの総数に等しい。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391250&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ebaebd23-e597-4f3c-9a6e-4d0d32ee09ee\', \'multiverseId\': 391250}, \'multiverseid\': 391250}, {\'name\': \'意塑影\', \'text\': \'于意塑影进战场时，将所有其他非衍生物的生物翻为牌面朝下。（它们是2/2生物。）\\n意塑影的力量和防御力各等同于战场上牌面朝下的生物数量。\', \'type\': \'生物～虚影\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389902&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a73787d-755f-4730-9908-3bf9257ca67f\', \'multiverseId\': 389902}, \'multiverseid\': 389902}]', '[{\'name\': \'Jagdführer von Lys Alana\', \'text\': \'Immer wenn du einen Elf-Zauberspruch wirkst, kannst du einen 1/1 grünen (Elf, Krieger)-Kreaturenspielstein ins Spiel bringen.\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': \'Von den obersten Stockwerken des Morgenlichtpalastes bis in die tiefsten Schatten des Zaunkönigreviers: Die silbrigen Klänge des Horns schimmern in der Luft, und wer es hören kann, fühlt sich davon angezogen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390258&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'016f3c44-503f-4572-b5eb-449984e9095c\', \'multiverseId\': 390258}, \'multiverseid\': 390258}, {\'name\': \'Maestro de caza de Lys Alana\', \'text\': \'Siempre que lances un hechizo de Elfo, puedes poner en el campo de batalla una ficha de criatura Guerrero Elfo verde 1/1.\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': \'Desde las filas más altas del Palacio Luz del Amanecer hasta la sombra más profunda de Coto de Reyezuelos, las notas plateadas del cuerno brillan en el aire, y todos aquellos que las escuchan sienten su atracción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391606&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b5f3f5e-f27b-4c92-b792-37b6f72aa87d\', \'multiverseId\': 391606}, \'multiverseid\': 391606}, {\'name\': \'Maître-chasseur de Lys Alana\', \'text\': "À chaque fois que vous lancez un sort d\'elfe, vous pouvez mettre sur le champ de bataille un jeton de créature 1/1 verte Elfe et Guerrier.", \'type\': \'Créature : elfe et guerrier\', \'flavor\': "Des hauteurs du Palais de Lumière d\'aurore aux ombres les plus noires de la Garenne du Roitelet, le doux son argenté de la corne résonne dans les airs, et chacun ressent son appel.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390595&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed8cbfe7-919e-4dc2-9d88-f25b07a382f7\', \'multiverseId\': 390595}, \'multiverseid\': 390595}, {\'name\': \'Capocaccia di Lys Alana\', \'text\': \'Ogniqualvolta lanci una magia Elfo, puoi mettere sul campo di battaglia una pedina creatura Guerriero Elfo 1/1 verde.\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': "Dai più alti ordini del Palazzo Luce dell\'Aurora alle ombre più profonde di Volo dello Scricciolo, le note argentee del suo corno luccicano nell\'aria e chi le ode se ne sente attirato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390932&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bc6e1e1a-f554-46a9-8696-d4abe1dbc3f8\', \'multiverseId\': 390932}, \'multiverseid\': 390932}, {\'name\': \'リス・アラナの狩りの達人\', \'text\': \'あなたがエルフ・呪文を１つ唱えるたび、あなたは緑の１/１のエルフ・戦士・クリーチャー・トークンを１体戦場に出してもよい。\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': \'曙光の宮殿の最上位からレンの地の最も暗い影まで、角笛の銀の音色は響き渡り、それを耳にした誰もが引きつけられていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391269&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1c823ebe-168c-431d-839e-05eb3eb9ccfd\', \'multiverseId\': 391269}, \'multiverseid\': 391269}, {\'name\': \'黎撒拉那领猎人\', \'text\': \'每当你施放妖精咒语时，你可以将一个1/1绿色妖精／战士衍生生物放进战场。\', \'type\': \'生物～妖精／战士\', \'flavor\': \'从晓明殿最高的一层，直到蒙鸠地最暗的阴影，此号角的银色音符在空气中闪烁，让听闻者都为之牵动。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389921&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46a7b1ac-3759-4973-bd96-3e49ac6a3ad4\', \'multiverseId\': 389921}, \'multiverseid\': 389921}]', '[{\'name\': \'Jazal Goldmähne\', \'text\': \'Erstschlag\\n{3}{W}{W}: Angreifende Kreaturen, die du kontrollierst, erhalten +X/+X bis zum Ende des Zuges, wobei X gleich der Anzahl an angreifenden Kreaturen ist.\', \'type\': \'Legendäre Kreatur — Katze, Krieger\', \'flavor\': \'„Als mein Kha ist er der Quell meiner Inspiration. Als mein Bruder ist er die Verkörperung meiner Ziele." —Ajani Goldmähne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390241&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'235dd990-b376-40da-a009-46b6d35b06e0\', \'multiverseId\': 390241}, \'multiverseid\': 390241}, {\'name\': \'Jazal Melena Dorada\', \'text\': \'Daña primero.\\n{3}{W}{W}: Las criaturas atacantes que controlas obtienen +X/+X hasta el final del turno, donde X es la cantidad de criaturas atacantes.\', \'type\': \'Criatura legendaria — Guerrero felino\', \'flavor\': \'"Como mi kha, es la fuente de mi inspiración. Como mi hermano, es la encarnación de mis aspiraciones". —Ajani Melena Dorada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391589&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'469462aa-8fdb-472e-9175-339373191719\', \'multiverseId\': 391589}, \'multiverseid\': 391589}, {\'name\': \'Jazal Crinièredor\', \'text\': "Initiative\\n{3}{W}{W} : Les créatures attaquantes que vous contrôlez gagnent +X/+X jusqu\'à la fin du tour, X étant le nombre de créatures attaquantes.", \'type\': \'Créature légendaire : chat et guerrier\', \'flavor\': \'« Mon kha, source de mon inspiration. Mon frère, incarnation de mes aspirations. » —Ajani Crinièredor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390578&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b412e7f5-6dd8-4523-99dc-d1f4c1435025\', \'multiverseId\': 390578}, \'multiverseid\': 390578}, {\'name\': "Jazal Criniera D\'Oro", \'text\': \'Attacco improvviso\\n{3}{W}{W}: Le creature attaccanti che controlli prendono +X/+X fino alla fine del turno, dove X è il numero di creature attaccanti.\', \'type\': \'Creatura Leggendaria — Guerriero Felino\', \'flavor\': \'"È il mio kha e come tale è fonte della mia ispirazione. Ma è anche mio fratello, l\\\'incarnazione delle mie aspirazioni." —Ajani Criniera D\\\'Oro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390915&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'49452566-9e62-480d-949c-c6daa66e9cc6\', \'multiverseId\': 390915}, \'multiverseid\': 390915}, {\'name\': \'黄金のたてがみのジャザル\', \'text\': \'先制攻撃\\n{3}{W}{W}：ターン終了時まで、あなたがコントロールする攻撃クリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘは攻撃クリーチャーの総数に等しい。\', \'type\': \'伝説のクリーチャー — 猫・戦士\', \'flavor\': \'「我が王として、あの方は私の勇気の源泉である。我が兄として、あの方は私の願望を体現する者である。」 ――黄金のたてがみのアジャニ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391252&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'12ece79f-48a6-44f0-a1d4-f5eccd1ac63a\', \'multiverseId\': 391252}, \'multiverseid\': 391252}, {\'name\': \'金鬃贾佐\', \'text\': \'先攻\\n{3}{W}{W}：由你操控且进行攻击的生物得+X/+X直到回合结束，X为进行攻击的生物数量。\', \'type\': \'传奇生物～猫／战士\', \'flavor\': \'「作为狮王，他是我的精神引领。作为兄长，他是我的志望所向。」 ～金鬃阿耶尼\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f50e5a1-66c9-458e-8a74-0e8141af4283\', \'multiverseId\': 389904}, \'multiverseid\': 389904}]', '[{\'name\': \'Jägertrio\', \'text\': \'Bringe drei 1/1 grüne (Elf, Krieger)-Kreaturenspielsteine ins Spiel.\\nUnterstützung 3 — {3}{G} ({3}{G}, wirf diese Karte ab: Lege drei +1/+1-Marken auf eine Kreatur deiner Wahl.)\', \'type\': \'Stammes-Hexerei — Elf\', \'flavor\': \'„Augenweh kann man einfach aufspüren. Man muss nur der Unvollkommenheit folgen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390224&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37884214-1d3b-451d-9ae0-2e83eb60f416\', \'multiverseId\': 390224}, \'multiverseid\': 390224}, {\'name\': \'Tríada cazadora\', \'text\': \'Pon en el campo de batalla tres fichas de criatura Guerrero Elfo verdes 1/1.\\nReforzar 3—{3}{G}. ({3}{G}, descartar esta carta: Pon tres contadores +1/+1 sobre la criatura objetivo.)\', \'type\': \'Conjuro tribal — Elfo\', \'flavor\': \'"Las desgracias visuales son fáciles de rastrear. Solo sigue las imperfecciones".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391572&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42229dd9-00a5-4efd-8146-7d185a3b4962\', \'multiverseId\': 391572}, \'multiverseid\': 391572}, {\'name\': \'Triade chasseresse\', \'text\': \'Mettez sur le champ de bataille trois jetons de créature 1/1 verte Elfe et Guerrier.\\nRenfort 3 — {3}{G} ({3}{G}, défaussez-vous de cette carte : Mettez trois marqueurs +1/+1 sur la créature ciblée.)\', \'type\': \'Rituel tribal : elfe\', \'flavor\': \'« Les dysmèles sont faciles à pister. Il suffit de suivre les imperfections. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390561&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'19d9d93f-ef8a-45b0-8c3e-8dc39aaaef27\', \'multiverseId\': 390561}, \'multiverseid\': 390561}, {\'name\': \'Triade da Caccia\', \'text\': \'Metti sul campo di battaglia tre pedine creatura Guerriero Elfo 1/1 verdi.\\nRinforzare 3—{3}{G} ({3}{G}, Scarta questa carta: Metti tre segnalini +1/+1 su una creatura bersaglio.)\', \'type\': \'Stregoneria Tribale — Elfo\', \'flavor\': \'"I mal\\\'occhi sono semplici da rintracciare. Basta seguire le imperfezioni."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390898&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'94c332cd-d3d0-479f-bc51-8a5976902422\', \'multiverseId\': 390898}, \'multiverseid\': 390898}, {\'name\': \'三人組の狩り\', \'text\': \'緑の１/１のエルフ・戦士・クリーチャー・トークンを３体戦場に出す。\\n補強３―{3}{G}（{3}{G}, このカードを捨てる：クリーチャー１体を対象とし、それの上に＋１/＋１カウンターを３個置く。）\', \'type\': \'部族・ソーサリー — エルフ\', \'flavor\': \'「眼腐りを追うのは簡単だ。不完全なものについていけばいいんだから。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391235&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2edcd6bd-9b08-4d2e-96ce-23cf5c3acbab\', \'multiverseId\': 391235}, \'multiverseid\': 391235}, {\'name\': \'狩猎三人组\', \'text\': \'将三个1/1绿色妖精／战士衍生生物放进战场。\\n补强3～{3}{G}（{3}{G}，弃掉此牌：在目标生物上放置三个+1/+1指示物。）\', \'type\': \'部族法术～妖精\', \'flavor\': \'「碍眼很容易找；循着不完美追踪即可。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389887&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1dae9631-0906-4514-81c1-c4d1e5fd3e46\', \'multiverseId\': 389887}, \'multiverseid\': 389887}]', '[{\'name\': \'Kampfanzug\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+2, hat Eile, kann weder dich noch einen Planeswalker, den du kontrollierst, angreifen und kann nicht geopfert werden.\\nZu Beginn des Versorgungssegments jedes Gegners kannst du diesen Spieler bis zum Ende des Zuges die Kontrolle über die ausgerüstete Kreatur übernehmen lassen. Falls du dies tust, enttappe sie.\\nAusrüsten {3}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390108&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca15f263-e287-4380-a1ce-4d54672f63fa\', \'multiverseId\': 390108}, \'multiverseid\': 390108}, {\'name\': \'Armadura de asalto\', \'text\': \'La criatura equipada obtiene +2/+2, tiene la habilidad de prisa, no puede atacarte a ti o a un planeswalker que controlas y no puede ser sacrificada.\\nAl comienzo del mantenimiento de cada oponente, puedes hacer que ese jugador gane el control de la criatura equipada hasta el final del turno. Si lo haces, enderézala.\\nEquipar {3}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391456&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'186c291f-f785-484f-95b9-6e31bb70edfc\', \'multiverseId\': 391456}, \'multiverseid\': 391456}, {\'name\': "Cuirasse d\'assaut", \'text\': "La créature équipée gagne +2/+2, a la célérité, ne peut pas vous attaquer ou attaquer un planeswalker que vous contrôlez et ne peut pas être sacrifiée.\\nAu début de l\'entretien de chaque adversaire, vous pouvez faire que ce joueur acquière le contrôle de la créature équipée jusqu\'à la fin du tour. Si vous faites ainsi, dégagez-la.\\nÉquipement {3}", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390445&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7052becf-001b-4f2e-8822-30d3cf36aba8\', \'multiverseId\': 390445}, \'multiverseid\': 390445}, {\'name\': "Corazza d\'Assalto", \'text\': "La creatura equipaggiata prende +2/+2, ha rapidità, non può attaccare te o un planeswalker che controlli e non può essere sacrificata.\\nAll\'inizio del mantenimento di ogni avversario, puoi far prendere il controllo della creatura equipaggiata a quel giocatore fino alla fine del turno. Se lo fai, STAPpala.\\nEquipaggiare {3}", \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390782&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'33084bdd-429f-4d98-80e6-ec78d00b73a4\', \'multiverseId\': 390782}, \'multiverseid\': 390782}, {\'name\': \'突撃鎧\', \'text\': \'装備しているクリーチャーは＋２/＋２の修整を受け、速攻を持ち、あなたやあなたがコントロールするプレインズウォーカーを攻撃できず、生け贄に捧げることもできない。\\n各対戦相手のアップキープの開始時に、あなたはターン終了時までそのプレイヤーにその装備しているクリーチャーのコントロールを得させてもよい。そうしたなら、それをアンタップする。\\n装備{3}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391119&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d37ba449-5f92-41f5-9f63-d477df86ddf6\', \'multiverseId\': 391119}, \'multiverseid\': 391119}, {\'name\': \'突击装\', \'text\': \'佩带此武具的生物得+2/+2，具有敏捷异能，不能攻击你或由你操控的鹏洛客，且不能被牺牲。\\n在每位对手的维持开始时，你可以让该牌手获得佩带此武具之生物的操控权直到回合结束。若你如此作，则将它重置。\\n佩带{3}\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389771&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5af7f239-f4e4-4fc5-981a-98b21f8aa1e4\', \'multiverseId\': 389771}, \'multiverseid\': 389771}]', "[{'name': 'Karru', 'text': 'Die Karru kommt getappt ins Spiel.\\nWenn die Karru ins Spiel kommt, opfere sie, falls du nicht eine ungetappte Ebene, die du kontrollierst, auf die Hand ihres Besitzers zurückbringst.\\n{T}: Erhöhe deinen Manavorrat um {1}{W}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390246&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ccd1ea0c-74c0-4f4c-a78b-e293d8c8a79c', 'multiverseId': 390246}, 'multiverseid': 390246}, {'name': 'Karrú', 'text': 'El Karrú entra al campo de batalla girado.\\nCuando el Karrú entre al campo de batalla, sacrifícalo a menos que regreses una llanura enderezada que controlas a la mano de su propietario.\\n{T}: Agrega {1}{W} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391594&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '08442c32-7cc2-4032-8b4d-19000e3533c7', 'multiverseId': 391594}, 'multiverseid': 391594}, {'name': 'Karoo', 'text': 'Le Karoo arrive sur le champ de bataille engagé.\\nQuand le Karoo arrive sur le champ de bataille, sacrifiez-le à moins de renvoyer une plaine dégagée que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {1}{W} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390583&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0ada2b8f-bda2-4879-b671-f70cd56d6970', 'multiverseId': 390583}, 'multiverseid': 390583}, {'name': 'Karoo', 'text': 'Il Karoo entra nel campo di battaglia TAPpato.\\nQuando il Karoo entra nel campo di battaglia, sacrificalo a meno che tu non faccia tornare una Pianura STAPpata che controlli in mano al suo proprietario.\\n{T}: Aggiungi {1}{W} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390920&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '676bf219-63ee-48a2-b940-ad91d6009d9a', 'multiverseId': 390920}, 'multiverseid': 390920}, {'name': '乾燥高原', 'text': '乾燥高原はタップ状態で戦場に出る。\\n乾燥高原が戦場に出たとき、あなたがコントロールするアンタップ状態の平地１つをオーナーの手札に戻さないかぎり、これを生け贄に捧げる。\\n{T}：あなたのマナ・プールに{1}{W}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391257&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '36362565-5bb3-42a9-a00b-d2037b002413', 'multiverseId': 391257}, 'multiverseid': 391257}, {'name': '卡陆', 'text': '卡陆须横置进战场。\\n当卡陆进战场时，除非你将一个由你操控且未横置的平原移回其拥有者手上，否则牺牲之。\\n{T}：加{1}{W}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389909&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b3f20789-9f93-4398-8bbb-f6912080a01d', 'multiverseId': 389909}, 'multiverseid': 389909}]", '[{\'name\': \'Kathodion\', \'text\': \'Wenn das Kathodion stirbt, erhöhe deinen Manavorrat um {3}.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': \'Anstelle eines Werkzeugs, das von Hitze beschädigt würde, bauten die Thran einfach eines, das von Hitze angetrieben wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390134&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab338761-0742-4273-87b1-52f4a512411c\', \'multiverseId\': 390134}, \'multiverseid\': 390134}, {\'name\': \'Catodion\', \'text\': \'Cuando el Catodion muera, agrega {3} a tu reserva de maná.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': \'En vez de crear una herramienta a la que el calor hiciera daño, los thran construyeron una que se alimentara de él.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391482&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b897ec6-ef75-4aed-ae04-e8d4633be59b\', \'multiverseId\': 391482}, \'multiverseid\': 391482}, {\'name\': \'Cathodion\', \'text\': \'Quand le Cathodion meurt, ajoutez {3} à votre réserve.\', \'type\': \'Créature-artefact : construction\', \'flavor\': "Trop d\'outils sont abîmés par le feu. Les Thrans en construisirent un qui s\'en nourrit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390471&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d6b70bd-00f4-4bce-b3b9-7c4d644d2619\', \'multiverseId\': 390471}, \'multiverseid\': 390471}, {\'name\': \'Catodione\', \'text\': \'Quando il Catodione muore, aggiungi {3} alla tua riserva di mana.\', \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': \'Invece di creare un attrezzo che potesse essere danneggiato dal calore, i Thran ne costruirono uno che ne fosse alimentato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390808&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e41bbf0e-deb9-44cd-b707-ac38ec2856cc\', \'multiverseId\': 390808}, \'multiverseid\': 390808}, {\'name\': \'陰極器\', \'text\': \'陰極器が死亡したとき、あなたのマナ・プールに{3}を加える。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': \'熱で駄目になるような道具を作る代わりに、スランは熱で充電するような道具を作った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391145&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b68264dd-1b38-4f10-a286-d3d02b2dc4ed\', \'multiverseId\': 391145}, \'multiverseid\': 391145}, {\'name\': \'负极兽\', \'text\': \'当负极兽死去时，加{3}到你的法术力池中。\', \'type\': \'神器生物～组构体\', \'flavor\': \'不去制作会被热所损伤的工具，索蓝王国改去建造可以此来充能者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389797&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c1d1b30-e6d3-49c4-a3a6-77882c1e5557\', \'multiverseId\': 389797}, \'multiverseid\': 389797}]', '[{\'name\': \'Kemba, Kha-Herrscherin\', \'text\': \'Bringe zu Beginn deines Versorgungssegments für jede an Kemba, Kha-Herrscherin, angelegte Ausrüstung einen 2/2 weißen Katze-Kreaturenspielstein ins Spiel.\', \'type\': \'Legendäre Kreatur — Katze, Kleriker\', \'flavor\': \'„Ich bin nicht Raksha. Ich werde es auch nie sein. Aber ich weigere mich, die Kha zu sein, die nur zusieht, wie sich ihr Rudel spaltet."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390247&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8df7ce98-de65-4903-bfdb-6a2b7c272523\', \'multiverseId\': 390247}, \'multiverseid\': 390247}, {\'name\': \'Kemba, regente del Kha\', \'text\': \'Al comienzo de tu mantenimiento, pon en el campo de batalla una ficha de criatura Felino blanca 2/2 por cada equipo anexado a Kemba, regente del Kha.\', \'type\': \'Criatura legendaria — Clérigo felino\', \'flavor\': \'"No soy Raksha. Nunca lo seré. Pero me niego a ser el kha que observó cómo era destruida su manada."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391595&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'caafd03f-a45d-4ba4-896d-ae81406b1e4c\', \'multiverseId\': 391595}, \'multiverseid\': 391595}, {\'name\': \'Kemba, kha régente\', \'text\': \'Au début de votre entretien, mettez sur le champ de bataille un jeton de créature 2/2 blanche Chat pour chaque équipement attaché à Kemba, kha régente.\', \'type\': \'Créature légendaire : chat et clerc\', \'flavor\': "« Je ne suis pas Raksha. Je ne le serai jamais. Mais je refuse d\'être la kha qui laissera sa bande s\'entredéchirer. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390584&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7d1a19b-bbcf-4cdb-bf48-07fc06d8dd82\', \'multiverseId\': 390584}, \'multiverseid\': 390584}, {\'name\': \'Kemba, Kha Reggente\', \'text\': "All\'inizio del tuo mantenimento, metti sul campo di battaglia una pedina creatura Felino 2/2 bianca per ogni Equipaggiamento assegnato a Kemba, Kha Reggente.", \'type\': \'Creatura Leggendaria — Chierico Felino\', \'flavor\': \'"Non sono Raksha. Non lo sarò mai. Ma rifiuto di essere la kha che è rimasta a guardare mentre il suo branco veniva fatto a pezzi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390921&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d6bf6a5-1cfe-4a97-a7fc-e82e786f8ec8\', \'multiverseId\': 390921}, \'multiverseid\': 390921}, {\'name\': \'王の摂政、ケンバ\', \'text\': \'あなたのアップキープの開始時に、王の摂政、ケンバにつけられている装備品１つにつき、白の２/２の猫・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'伝説のクリーチャー — 猫・クレリック\', \'flavor\': \'「私はラクシャではありません。そうなろうとも思いません。しかし、群れが散り散りになるのを見ているだけの王になりたくはありません。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391258&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'42d83f8e-cb42-4d93-9129-d62fa364acce\', \'multiverseId\': 391258}, \'multiverseid\': 391258}, {\'name\': \'摄政狮王肯芭\', \'text\': \'在你的维持开始时，摄政狮王肯芭上每装备一个武具，便将一个2/2白色的猫衍生生物放进战场。\', \'type\': \'传奇生物～猫／僧侣\', \'flavor\': \'「我不是洛夏。我永远都不会是。而我拒绝担任眼见自己狮群分裂的狮王。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389910&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cb5ca801-1e17-43a2-afb5-d3cde0984ad6\', \'multiverseId\': 389910}, \'multiverseid\': 389910}]', '[{\'name\': \'Kichernder Gegenpart\', \'text\': \'Bringe einen Spielstein ins Spiel, der eine Kopie einer Kreatur deiner Wahl ist, die du kontrollierst.\\nRückblende {5}{U}{U} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten wirken. Schicke sie danach ins Exil.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390130&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb20bf76-23d8-460a-aec5-055a40f08615\', \'multiverseId\': 390130}, \'multiverseid\': 390130}, {\'name\': \'Homólogo carcajeante\', \'text\': \'Pon en el campo de batalla una ficha que es una copia de la criatura objetivo que controlas.\\nRetrospectiva {5}{U}{U}. (Puedes lanzar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego exíliala.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391478&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26ac3224-6371-4e73-97c4-44a5798e032c\', \'multiverseId\': 391478}, \'multiverseid\': 391478}, {\'name\': \'Équivalent caquetant\', \'text\': "Mettez sur le champ de bataille un jeton qui est une copie d\'une créature ciblée que vous contrôlez.\\nFlashback {5}{U}{U} (Vous pouvez lancer cette carte depuis votre cimetière pour son coût de flashback. Exilez-la ensuite.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390467&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'422e1594-4a83-4db0-ae29-bb80b04422ab\', \'multiverseId\': 390467}, \'multiverseid\': 390467}, {\'name\': \'Controparte Ghignante\', \'text\': \'Metti sul campo di battaglia una pedina che è una copia di una creatura bersaglio che controlli.\\nFlashback {5}{U}{U} (Puoi lanciare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi esiliala.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390804&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4be565cd-c5cb-4531-8fd0-a0324737e363\', \'multiverseId\': 390804}, \'multiverseid\': 390804}, {\'name\': \'大笑いの写し身\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とし、それのコピーであるトークンを１体戦場に出す。\\nフラッシュバック{5}{U}{U}（あなたはあなたの墓地にあるこのカードを、これのフラッシュバック・コストで唱えてもよい。その後、これを追放する。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391141&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb8d6c38-0df8-4d37-9562-401ea69abfb9\', \'multiverseId\': 391141}, \'multiverseid\': 391141}, {\'name\': \'咳笑复身\', \'text\': \'将一个衍生物放进战场，此衍生物为目标由你操控的生物之复制品。\\n返照{5}{U}{U}（你可以从你的坟墓场施放此牌，并支付其返照费用，然后将它放逐。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389793&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ec47ec7-7591-44f4-9451-ee5695af9da1\', \'multiverseId\': 389793}, \'multiverseid\': 389793}]', "[{'name': 'Knochen-Hellseherei', 'text': 'Schicke als zusätzliche Kosten, um die Knochen-Hellseherei zu wirken, X Karten aus deinem Friedhof ins Exil.\\nDu ziehst X Karten und verlierst X Lebenspunkte.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390348&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c232888e-c3d3-4546-b376-dc51d5c36cea', 'multiverseId': 390348}, 'multiverseid': 390348}, {'name': 'Adivinación esquelética', 'text': 'Como coste adicional para lanzar la Adivinación esquelética, exilia X cartas de tu cementerio.\\nRobas X cartas y pierdes X vidas.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391696&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'da7a2faa-7101-4b22-869c-911778732279', 'multiverseId': 391696}, 'multiverseid': 391696}, {'name': 'Regard du squelette', 'text': 'En tant que coût supplémentaire pour lancer le Regard du squelette, exilez X cartes depuis votre cimetière.\\nVous piochez X cartes et vous perdez X points de vie.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390685&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e8d335d3-45ef-4a4a-ac06-1c58eac0dc82', 'multiverseId': 390685}, 'multiverseid': 390685}, {'name': 'Premonizione Scheletrica', 'text': 'Come costo addizionale per lanciare la Premonizione Scheletrica, esilia X carte dal tuo cimitero.\\nPesca X carte e perdi X punti vita.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391022&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0f3365bd-a5b2-49de-acce-42716e4d103c', 'multiverseId': 391022}, 'multiverseid': 391022}, {'name': '占骨術', 'text': '占骨術を唱えるための追加コストとして、あなたの墓地にあるカードをＸ枚追放する。\\nあなたはカードをＸ枚引き、あなたはＸ点のライフを失う。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391359&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7fd4e72e-b86e-4882-937b-ad32759d6831', 'multiverseId': 391359}, 'multiverseid': 391359}, {'name': '骸骨占卜', 'text': '从你坟墓场中放逐X张牌，以作为施放骸骨占卜的额外费用。\\n你抓X张牌且你失去X点生命。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390011&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '971d48d6-155e-4bd6-bb8b-b9ea4bdf79a4', 'multiverseId': 390011}, 'multiverseid': 390011}]", '[{\'name\': \'Knochenhort\', \'text\': \'Lebende Waffe (Wenn diese Ausrüstung ins Spiel kommt, bringe einen 0/0 schwarzen Keim-Kreaturenspielstein ins Spiel und lege sie dann an ihn an.)\\nDie ausgerüstete Kreatur erhält +X/+X, wobei X gleich der Anzahl an Kreaturenkarten in allen Friedhöfen ist.\\nAusrüsten {2}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390121&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'975004e8-8876-46c5-9566-655fd01cddb2\', \'multiverseId\': 390121}, \'multiverseid\': 390121}, {\'name\': \'Huesotesoro\', \'text\': \'Arma viviente. (Cuando este equipo entre al campo de batalla, pon en el campo de batalla una ficha de criatura Germen negra 0/0, luego anéxalo a ella.)\\nLa criatura equipada obtiene +X/+X, donde X es la cantidad de cartas de criatura en todos los cementerios.\\nEquipar {2}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391469&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07856194-8bf3-40f5-a147-b862b6157abb\', \'multiverseId\': 391469}, \'multiverseid\': 391469}, {\'name\': \'Récoltos\', \'text\': \'Arme vivante (Quand cet équipement arrive sur le champ de bataille, mettez sur le champ de bataille un jeton de créature 0/0 noire Germe, puis attachez-lui cet équipement.)\\nLa créature équipée gagne +X/+X, X étant le nombre de cartes de créature dans tous les cimetières.\\nÉquipement {2}\', \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390458&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5b83fc92-c06d-48ef-bac3-cc26d8e9418a\', \'multiverseId\': 390458}, \'multiverseid\': 390458}, {\'name\': "Mucchio d\'Ossa", \'text\': \'Arma vivente (Quando questo Equipaggiamento entra nel campo di battaglia, metti sul campo di battaglia una pedina creatura Microbo 0/0 nera, poi assegnalo ad essa.)\\nLa creatura equipaggiata prende +X/+X, dove X è il numero di carte creatura in tutti i cimiteri.\\nEquipaggiare {2}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390795&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5861535d-cbf0-4359-b59a-747070396788\', \'multiverseId\': 390795}, \'multiverseid\': 390795}, {\'name\': \'骨溜め\', \'text\': \'生体武器（この装備品が戦場に出たとき、黒の０/０の細菌・クリーチャー・トークンを１体戦場に出し、その後これをそれにつける。）\\n装備しているクリーチャーは＋Ｘ/＋Ｘの修整を受ける。Ｘはすべての墓地にあるクリーチャー・カードの総数に等しい。\\n装備{2}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391132&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5b554ecd-ecf4-4c61-befc-f03354dc4544\', \'multiverseId\': 391132}, \'multiverseid\': 391132}, {\'name\': \'聚骨装\', \'text\': \'活化武器（当此武具进战场时，将一个0/0黑色病菌衍生生物放进战场，然后将它装备上去。）\\n佩带此武具的生物得+X/+X，X为所有坟墓场中生物牌的数量。\\n佩带{2}\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389784&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28894e19-9b52-4e52-b1e0-56e351096094\', \'multiverseId\': 389784}, \'multiverseid\': 389784}]', '[{\'name\': \'Konzentrieren\', \'text\': \'Ziehe drei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Schätze in meinem Gedächtnis sind mit allem weltlichen Ruhm nicht aufzuwiegen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390142&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69f284d4-4ec8-45a2-b5e4-ec65209ded38\', \'multiverseId\': 390142}, \'multiverseid\': 390142}, {\'name\': \'Concentrarse\', \'text\': \'Roba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"El tesoro en mi mente es más grande que cualquier gloria mundana."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391490&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e35d9c2b-5aa6-4e83-9be7-419ecae2164c\', \'multiverseId\': 391490}, \'multiverseid\': 391490}, {\'name\': \'Concentration\', \'text\': \'Piochez trois cartes.\', \'type\': \'Rituel\', \'flavor\': \'« Je préfère les trésors de mon esprit à toutes les richesses de la terre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390479&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9b548ae-6414-4c10-b5ce-4a04bb499d0e\', \'multiverseId\': 390479}, \'multiverseid\': 390479}, {\'name\': \'Concentrare\', \'text\': \'Pesca tre carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il tesoro che c\\\'è nella mia mente è più grande di tutti i beni terreni."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390816&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ce1256b-d19b-4f9f-9714-52ba7834dd90\', \'multiverseId\': 390816}, \'multiverseid\': 390816}, {\'name\': \'集中\', \'text\': \'カードを３枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「私の心の中の宝物は、この世のどんな栄光よりも素晴らしいんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391153&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dea53682-575f-47a1-a599-a17fc035b427\', \'multiverseId\': 391153}, \'multiverseid\': 391153}, {\'name\': \'专注\', \'text\': \'抓三张牌。\', \'type\': \'法术\', \'flavor\': \'「我心中的宝藏更胜世间荣耀。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389805&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5686d501-2f41-4687-a336-70369352e6d6\', \'multiverseId\': 389805}, \'multiverseid\': 389805}]', '[{\'name\': \'Kor-Weihepriester\', \'text\': \'Bonus {W} (Du kannst zusätzlich {W} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nWenn der Kor-Weihepriester ins Spiel kommt und falls seine Bonuskosten bezahlt wurden, zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Kreatur — Kor, Kleriker\', \'flavor\': \'„Warum willst du solchen Tand behalten? Er ist nur zusätzliches Gewicht in deinem Gepäck."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390248&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7c464d1-8da8-48a0-a638-25e0c057a21a\', \'multiverseId\': 390248}, \'multiverseid\': 390248}, {\'name\': \'Santificadores kor\', \'text\': \'Estímulo {W}. (Puedes pagar {W} adicional al lanzar este hechizo.)\\nCuando los Santificadores kor entren al campo de batalla, si fueron estimulados, destruye el artefacto o encantamiento objetivo.\', \'type\': \'Criatura — Clérigo kor\', \'flavor\': \'"¿Para qué llevar esas bagatelas? Sólo agregan peso a nuestro viaje."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391596&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3b5ae741-e8e6-4b8c-b8a4-cd20a7bea8b2\', \'multiverseId\': 391596}, \'multiverseid\': 391596}, {\'name\': \'Sanctificateurs kor\', \'text\': "Kick {W} (Vous pouvez payer {W} supplémentaires au moment où vous lancez ce sort.)\\nQuand les Sanctificateurs kor arrivent sur le champ de bataille, s\'ils ont été kickés, détruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Créature : kor et clerc\', \'flavor\': "« Pourquoi garder ces colifichets ? Ils ne feront que t\'alourdir pendant le voyage. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390585&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d2d95d36-9028-4f06-9cac-aad23a2b7240\', \'multiverseId\': 390585}, \'multiverseid\': 390585}, {\'name\': \'Santificatori Kor\', \'text\': \'Potenziamento {W} (Puoi pagare {W} addizionale mentre lanci questa magia.)\\nQuando i Santificatori Kor entrano nel campo di battaglia, se sono stati potenziati, distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Creatura — Chierico Kor\', \'flavor\': \'"Perché tenere dei simili gingilli? Aggiungono solo peso ai tuoi viaggi."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390922&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fcd2cf9b-7c3b-4fa2-bb0d-6a9cb98e2c0c\', \'multiverseId\': 390922}, \'multiverseid\': 390922}, {\'name\': \'コーの奉納者\', \'text\': \'キッカー{W}（あなたはこの呪文を唱えるに際し、追加で{W}を支払ってもよい。）\\nコーの奉納者が戦場に出たとき、これがキッカーされていた場合、アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — コー・クレリック\', \'flavor\': \'「何でそんな光り物を取っておくんだ？旅の荷物が増えるだけなのに。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391259&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5a58a8d-69da-49e5-b3ed-7a267083ddcf\', \'multiverseId\': 391259}, \'multiverseid\': 391259}, {\'name\': \'寇族净圣僧\', \'text\': \'增幅{W}（你可以在施放此咒语时额外支付{W}。）\\n当寇族净圣僧进战场时，若它已增幅，则消灭目标神器或结界。\', \'type\': \'生物～寇族／僧侣\', \'flavor\': \'「这东西带着干嘛？ 只能加重行囊而已。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389911&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8f1cb5db-961a-41b2-ae74-c2e4532a4a93\', \'multiverseId\': 389911}, \'multiverseid\': 389911}]', '[{\'name\': \'Korallenatoll\', \'text\': \'Das Korallenatoll kommt getappt ins Spiel.\\nWenn das Korallenatoll ins Spiel kommt, opfere es, falls du nicht eine ungetappte Insel, die du kontrollierst, auf die Hand ihres Besitzers zurückbringst.\\n{T}: Erhöhe deinen Manavorrat um {1}{U}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390145&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9cf29fdb-e007-4d56-9311-ac7bf892a046\', \'multiverseId\': 390145}, \'multiverseid\': 390145}, {\'name\': \'Atolón de coral\', \'text\': \'El Atolón de coral entra al campo de batalla girado.\\nCuando el Atolón de coral entre al campo de batalla, sacrifícalo a menos que regreses una isla enderezada que controlas a la mano de su propietario.\\n{T}: Agrega {1}{U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391493&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'33010c0d-7784-453e-9f90-070e3a13450d\', \'multiverseId\': 391493}, \'multiverseid\': 391493}, {\'name\': \'Atoll de corail\', \'text\': "L\'Atoll de corail arrive sur le champ de bataille engagé.\\nQuand l\'Atoll de corail arrive sur le champ de bataille, sacrifiez-le à moins de renvoyer une île dégagée que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {1}{U} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390482&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40290402-8695-4613-9901-a8176d2479ab\', \'multiverseId\': 390482}, \'multiverseid\': 390482}, {\'name\': \'Atollo Corallino\', \'text\': "L\'Atollo Corallino entra nel campo di battaglia TAPpato.\\nQuando l\'Atollo Corallino entra nel campo di battaglia, sacrificalo a meno che tu non faccia tornare un\'Isola STAPpata che controlli in mano al suo proprietario.\\n{T}: Aggiungi {1}{U} alla tua riserva di mana.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390819&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f6fcf55f-8896-4711-bb30-2de2d58e6c3d\', \'multiverseId\': 390819}, \'multiverseid\': 390819}, {\'name\': \'珊瑚礁\', \'text\': \'珊瑚礁はタップ状態で戦場に出る。\\n珊瑚礁が戦場に出たとき、あなたがコントロールするアンタップ状態の島１つをオーナーの手札に戻さないかぎり、これを生け贄に捧げる。\\n{T}：あなたのマナ・プールに{1}{U}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391156&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ba9e296c-00e9-4ed1-9fe5-cfa1065f6836\', \'multiverseId\': 391156}, \'multiverseid\': 391156}, {\'name\': \'环珊瑚礁\', \'text\': \'环珊瑚礁须横置进战场。\\n当环珊瑚礁进战场时，除非你将一个由你操控且未横置的海岛移回其拥有者手上，否则牺牲之。\\n{T}：加{1}{U}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389808&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c8f07b87-2c84-4eca-8527-04a154cec32a\', \'multiverseId\': 389808}, \'multiverseid\': 389808}]', '[{\'name\': \'Kozileks Handwerker\', \'text\': \'Wenn du Kozileks Handwerker wirkst, kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurückbringen.\\nVernichter 2 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler zwei bleibende Karten.)\', \'type\': \'Kreatur — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390107&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83fa345e-ab3d-4ec2-91f0-33307a5f8f9d\', \'multiverseId\': 390107}, \'multiverseid\': 390107}, {\'name\': \'Artesano de Kozilek\', \'text\': \'Cuando lances el Artesano de Kozilek, puedes regresar la carta de criatura objetivo de tu cementerio al campo de batalla.\\nAniquilador 2. (Siempre que esta criatura ataque, el jugador defensor sacrifica dos permanentes.)\', \'type\': \'Criatura — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391455&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1c5ef00-3ad7-4937-b3af-4b5832a4f99f\', \'multiverseId\': 391455}, \'multiverseid\': 391455}, {\'name\': \'Artisan de Kozilek\', \'text\': "Quand vous lancez l\'Artisan de Kozilek, vous pouvez renvoyer sur le champ de bataille une carte de créature ciblée depuis votre cimetière.\\nAnnihilateur 2 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie deux permanents.)", \'type\': \'Créature : eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390444&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d9ef51a-f01e-49e3-95cf-65489b031a37\', \'multiverseId\': 390444}, \'multiverseid\': 390444}, {\'name\': \'Artigiano di Kozilek\', \'text\': "Quando lanci l\'Artigiano di Kozilek, puoi rimettere sul campo di battaglia una carta creatura bersaglio dal tuo cimitero.\\nAnnientatore 2 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica due permanenti.)", \'type\': \'Creatura — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390781&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8fb0d6f-6f86-4162-a777-255514a0ed0d\', \'multiverseId\': 390781}, \'multiverseid\': 390781}, {\'name\': \'コジレックの職工\', \'text\': \'あなたがコジレックの職工を唱えたとき、あなたの墓地にあるクリーチャー・カード１枚を対象とする。あなたはそれを戦場に戻してもよい。\\n滅殺２（このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを２つ生け贄に捧げる。）\', \'type\': \'クリーチャー — エルドラージ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391118&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'acec0df9-df87-4023-89ba-2a9379308370\', \'multiverseId\': 391118}, \'multiverseid\': 391118}, {\'name\': \'寇基雷工匠\', \'text\': \'当你施放寇基雷工匠时，你可以将目标生物牌从你的坟墓场移回战场。\\n歼灭2（每当此生物攻击时，防御牌手牺牲两个永久物。）\', \'type\': \'生物～奥札奇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389770&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55d5c910-0dd7-42bc-a2a4-32d319e0758d\', \'multiverseId\': 389770}, \'multiverseid\': 389770}]', '[{\'name\': \'Kreischmaul\', \'text\': \'Verursacht Furcht (Diese Kreatur kann außer von Artefaktkreaturen und/oder schwarzen Kreaturen nicht geblockt werden.)\\nWenn das Kreischmaul ins Spiel kommt, zerstöre eine nichtschwarze Nichtartefaktkreatur deiner Wahl.\\nHerbeirufen {1}{B} (Du kannst diesen Zauberspruch für seine Herbeirufungskosten wirken. Falls du dies tust, wird die Kreatur geopfert, wenn sie ins Spiel kommt.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390343&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c8b2695-4a76-4ce6-b5a0-88d29cb1b1e0\', \'multiverseId\': 390343}, \'multiverseid\': 390343}, {\'name\': \'Garganta chillona\', \'text\': \'Inspirar temor. (Esta criatura no puede ser bloqueada excepto por criaturas artefacto y/o criaturas negras.)\\nCuando el Garganta chillona entre al campo de batalla, destruye la criatura objetivo que no sea negra o artefacto.\\nEvocar {1}{B}. (Puedes lanzar este hechizo por su coste de evocar. Si lo haces, sacrifícalo cuando entre al campo de batalla.)\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391691&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'05432650-b08f-4cba-9181-189ce1725321\', \'multiverseId\': 391691}, \'multiverseid\': 391691}, {\'name\': \'Hurlegueule\', \'text\': "Peur (Cette créature ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures noires.)\\nQuand le Hurlegueule arrive sur le champ de bataille, détruisez la créature non-artefact, non-noire ciblée.\\nÉvocation {1}{B} (Vous pouvez lancer ce sort pour son coût d\'évocation. Si vous faites ainsi, il est sacrifié quand il arrive sur le champ de bataille.)", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390680&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f7f6b030-0831-438f-a99f-ef5b4d05a82c\', \'multiverseId\': 390680}, \'multiverseid\': 390680}, {\'name\': \'Fauce Urlante\', \'text\': \'Paura (Questa creatura non può essere bloccata tranne che da creature artefatto e/o creature nere.)\\nQuando la Fauce Urlante entra nel campo di battaglia, distruggi una creatura non artefatto, non nera bersaglio.\\nApparire {1}{B} (Puoi lanciare questa magia pagando il suo costo di apparire. Se lo fai, viene sacrificata quando entra nel campo di battaglia.)\', \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391017&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'605d5566-6f07-4c97-bc25-f33019322cd5\', \'multiverseId\': 391017}, \'multiverseid\': 391017}, {\'name\': \'叫び大口\', \'text\': \'畏怖（このクリーチャーは、アーティファクトでも黒でもないクリーチャーによってはブロックされない。）\\n叫び大口が戦場に出たとき、アーティファクトでも黒でもないクリーチャー１体を対象とし、それを破壊する。\\n想起{1}{B}（あなたはこの呪文を、これの想起コストで唱えてもよい。そうしたなら、戦場に出たときにこれを生け贄に捧げる。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391354&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20d2daa8-a288-446d-8e43-98cc621497a9\', \'multiverseId\': 391354}, \'multiverseid\': 391354}, {\'name\': \'尖吼怪\', \'text\': \'恐惧（此生物只能被神器生物和／或黑色生物阻挡。）\\n当尖吼怪进战场时，消灭目标非神器且非黑色的生物。\\n呼魂{1}{B}（你可以支付此咒语的呼魂费用来施放它。若你如此作，当它进战场时便牺牲之。）\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390006&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c5df0e3b-5982-494b-ac57-4f83f5bb7668\', \'multiverseId\': 390006}, \'multiverseid\': 390006}]', '[{\'name\': \'Kreuzzug der Katharer\', \'text\': \'Immer wenn eine Kreatur unter deiner Kontrolle ins Spiel kommt, lege eine +1/+1-Marke auf jede Kreatur, die du kontrollierst.\', \'type\': \'Verzauberung\', \'flavor\': \'Avacyns heilige Krieger gaben auch in den dunkelsten Stunden die Hoffnung nicht auf. Nun tragen sie diese Hoffnung durch Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390133&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d47ad486-354d-4b99-880e-819dae221722\', \'multiverseId\': 390133}, \'multiverseid\': 390133}, {\'name\': \'Cruzada de los cátaros\', \'text\': \'Siempre que una criatura entre al campo de batalla bajo tu control, pon un contador +1/+1 sobre cada criatura que controles.\', \'type\': \'Encantamiento\', \'flavor\': \'Los guerreros sagrados de Avacyn mantuvieron viva la esperanza en los momentos más aciagos. Ahora, llevarán esa esperanza por todo Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391481&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f7eaa09-403e-4e56-abc4-663c151c67f0\', \'multiverseId\': 391481}, \'multiverseid\': 391481}, {\'name\': \'Croisade cathare\', \'text\': "À chaque fois qu\'une créature arrive sur le champ de bataille sous votre contrôle, mettez un marqueur +1/+1 sur chaque créature que vous contrôlez.", \'type\': \'Enchantement\', \'flavor\': "L\'espoir entretenu par les guerriers saints d\'Avacyn aux heures les plus sombres sera désormais porté à travers Innistrad.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390470&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d627a16-b85e-4978-90a3-00833a41fe52\', \'multiverseId\': 390470}, \'multiverseid\': 390470}, {\'name\': \'Crociata dei Catari\', \'text\': \'Ogniqualvolta una creatura entra nel campo di battaglia sotto il tuo controllo, metti un segnalino +1/+1 su ogni creatura che controlli.\', \'type\': \'Incantesimo\', \'flavor\': \'I guerrieri sacri di Avacyn alimentarono la speranza nei suoi momenti più bui. Ora diffonderanno quella speranza in Innistrad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390807&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d1ac010-58e8-424f-b808-ebdf06285ddd\', \'multiverseId\': 390807}, \'multiverseid\': 390807}, {\'name\': \'聖戦士の進軍\', \'text\': \'クリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたがコントロールする各クリーチャーの上に＋１/＋１カウンターをそれぞれ１個置く。\', \'type\': \'エンチャント\', \'flavor\': \'アヴァシンの聖なる戦士達は、彼女の最も困難な時期にも希望を絶やさなかった。彼らは今、その希望をイニストラード全土にもたらすのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391144&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9751084-9089-43a0-9857-b585787e7673\', \'multiverseId\': 391144}, \'multiverseid\': 391144}, {\'name\': \'护教军圣战\', \'text\': \'每当一个生物在你的操控下进战场时，在每个由你操控的生物上各放置一个+1/+1指示物。\', \'type\': \'结界\', \'flavor\': \'艾维欣的圣战士在她最艰困的时刻依旧维系着希望。现在他们将把这份希望传遍依尼翠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389796&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ab339102-d983-4546-97c4-8a31edda1995\', \'multiverseId\': 389796}, \'multiverseid\': 389796}]', '[{\'name\': \'Kriegscoup\', \'text\': \'Bringe X 1/1 weiße Soldat-Kreaturenspielsteine ins Spiel. Falls X 5 oder mehr beträgt, zerstöre alle anderen Kreaturen.\', \'type\': \'Hexerei\', \'flavor\': \'Die Nationen von Bant legten ihren Krieg bei und vereinigten sich gegen die gemeinsame Bedrohung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390264&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'15411395-2fde-4eb9-8f31-bc7b4d131abb\', \'multiverseId\': 390264}, \'multiverseid\': 390264}, {\'name\': \'Golpe marcial\', \'text\': \'Pon en el campo de batalla X fichas de criatura Soldado blancas 1/1. Si X es 5 o más, destruye todas las otras criaturas.\', \'type\': \'Conjuro\', \'flavor\': \'Olvidando sus guerras, las naciones de Bant se unieron para enfrentar una amenaza común.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391612&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdaf30b4-b55b-4fd5-ae4f-830df45ae487\', \'multiverseId\': 391612}, \'multiverseid\': 391612}, {\'name\': "Coup d\'état militaire", \'text\': \'Mettez sur le champ de bataille X jetons de créature 1/1 blanche Soldat. Si X est supérieur ou égal à 5, détruisez toutes les autres créatures.\', \'type\': \'Rituel\', \'flavor\': "Oubliant leur guerre, les nations de Bant s\'unirent face à une menace commune.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390601&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e6c82b1-efe3-4301-ac83-7b36e1404998\', \'multiverseId\': 390601}, \'multiverseid\': 390601}, {\'name\': \'Colpo Militare\', \'text\': \'Metti sul campo di battaglia X pedine creatura Soldato 1/1 bianche. Se X è pari o superiore a 5, distruggi tutte le altre creature.\', \'type\': \'Stregoneria\', \'flavor\': \'Dimenticata la guerra in atto, i popoli di Bant si schierarono fianco a fianco per contrastare la minaccia comune.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390938&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81da80a5-b0c9-4145-a68d-bd6016fef6d0\', \'multiverseId\': 390938}, \'multiverseid\': 390938}, {\'name\': \'軍部政変\', \'text\': \'白の１/１の兵士・クリーチャー・トークンをＸ体戦場に出す。Ｘが５以上であるなら、他のすべてのクリーチャーを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'バントの国々は自らの戦争を忘れ、共に面した敵に対して一体となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391275&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'474e5f45-a79c-4340-86a4-7ac95448e224\', \'multiverseId\': 391275}, \'multiverseid\': 391275}, {\'name\': \'军事壮举\', \'text\': \'将X个1/1白色士兵衍生生物放进战场。如果X等于或大于5，则消灭所有其他生物。\', \'type\': \'法术\', \'flavor\': \'班特诸邦抛弃过往恩怨，团结面对共同威胁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389927&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7df28cb-0b04-47ea-8caf-fc034a7689fc\', \'multiverseId\': 389927}, \'multiverseid\': 389927}]', '[{\'name\': \'Kriegssänger aus Joraga\', \'text\': \'Multibonus {1}{G} (Du kannst zusätzlich beliebig oft {1}{G} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nDer Kriegssänger aus Joraga kommt mit X +1/+1-Marken ins Spiel, wobei X die Anzahl ist, wie oft seine Bonuskosten bezahlt wurden.\\nAndere Elf-Kreaturen, die du kontrollierst, erhalten für jede +1/+1-Marke auf dem Kriegssänger aus Joraga +1/+1.\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390243&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'171d10d0-909d-48fc-b714-b9189c0d115d\', \'multiverseId\': 390243}, \'multiverseid\': 390243}, {\'name\': \'Llamaguerra de Joraga\', \'text\': \'Multiestímulo {1}{G}. (Puedes pagar {1}{G} adicional tantas veces como quieras al lanzar este hechizo.)\\nEl Llamaguerra de Joraga entra al campo de batalla con un contador +1/+1 sobre él por cada vez que fue estimulado.\\nLas otras criaturas Elfo que controlas obtienen +1/+1 por cada contador +1/+1 sobre el Llamaguerra de Joraga.\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391591&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d385218-da5e-4780-a8df-bbf7a060c687\', \'multiverseId\': 391591}, \'multiverseid\': 391591}, {\'name\': \'Meneur de guerre de Joraga\', \'text\': "Multikick {1}{G} (Vous pouvez payer {1}{G} supplémentaires autant de fois que vous le souhaitez au moment où vous lancez ce sort.)\\nLe Meneur de guerre de Joraga arrive sur le champ de bataille avec, sur lui, un marqueur +1/+1 pour chaque fois qu\'il a été kické.\\nLes autres créatures Elfe que vous contrôlez gagnent +1/+1 pour chaque marqueur +1/+1 sur le Meneur de guerre de Joraga.", \'type\': \'Créature : elfe et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390580&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22c8107e-58fd-4fc6-b6e7-613e0e79deba\', \'multiverseId\': 390580}, \'multiverseid\': 390580}, {\'name\': \'Convocatore di Guerra di Joraga\', \'text\': \'Multipotenziamento {1}{G} (Puoi pagare {1}{G} addizionale un qualsiasi numero di volte mentre lanci questa magia.)\\nIl Convocatore di Guerra di Joraga entra nel campo di battaglia con un segnalino +1/+1 per ogni volta che è stato potenziato.\\nLe altre creature Elfo che controlli prendono +1/+1 per ogni segnalino +1/+1 sul Convocatore di Guerra di Joraga.\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390917&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b5b0a024-f09b-40d2-9532-a6d296f85276\', \'multiverseId\': 390917}, \'multiverseid\': 390917}, {\'name\': \'ジョラーガの戦呼び\', \'text\': \'多重キッカー{1}{G}（あなたはこの呪文を唱えるに際し、追加で{1}{G}を望む回数支払ってもよい。）\\nジョラーガの戦呼びは、これがキッカーされた１回につき＋１/＋１カウンターが１個置かれた状態で戦場に出る。\\nあなたがコントロールする他のエルフ・クリーチャーは、ジョラーガの戦呼びの上に置かれている＋１/＋１カウンター１個につき＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391254&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed07c432-44ef-4104-9de6-10f67f2a0c6e\', \'multiverseId\': 391254}, \'multiverseid\': 391254}, {\'name\': \'玖瑞加战呼人\', \'text\': \'多重增幅{1}{G}（你施放此咒语时可以任意次数地额外支付{1}{G}。）\\n玖瑞加战呼人进战场时上面有数个+1/+1指示物，其数量为它增幅过的次数。\\n玖瑞加战呼人上每有一个+1/+1指示物，由你操控的其他妖精生物便得+1/+1。\', \'type\': \'生物～妖精／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389906&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'86795f3e-f946-4852-b044-76572b2c979c\', \'multiverseId\': 389906}, \'multiverseid\': 389906}]', '[{\'name\': \'Kriegstreiber-Höllendrache\', \'text\': \'Fliegend\\nAlle Kreaturen greifen in jedem Kampf an, falls möglich.\\n{1}{R}: Angreifende Kreaturen erhalten +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Seine Flügel schlagen im Takt mit dem Kriegsgebrüll und entfachen die Feuer der Wut.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390413&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ce61ac7-c9ee-4eb2-bc75-1f8442db87f7\', \'multiverseId\': 390413}, \'multiverseid\': 390413}, {\'name\': \'Engendro belicista\', \'text\': \'Vuela.\\nTodas las criaturas atacan cada combate si pueden.\\n{1}{R}: Las criaturas atacantes obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Sus alas baten al ritmo de los alaridos de guerra y avivan los fuegos de la ira.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391761&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd19b81b-037c-42a3-bc12-d16de316cd1b\', \'multiverseId\': 391761}, \'multiverseid\': 391761}, {\'name\': \'Escouflenfer belliciste\', \'text\': "Vol\\nToutes les créatures attaquent à chaque combat si possible.\\n{1}{R} : Les créatures attaquantes gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : dragon\', \'flavor\': "Ses battements d\'ailes rythment les cris de guerre et attisent les brasiers de la rage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3f9fd5a-7088-4bc4-a5a0-d8181d68e50b\', \'multiverseId\': 390750}, \'multiverseid\': 390750}, {\'name\': \'Nibbio Infernale Guerrafondaio\', \'text\': \'Volare\\nTutte le creature attaccano in ogni combattimento, se possono farlo.\\n{1}{R}: Le creature attaccanti prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Drago\', \'flavor\': \'Il battito delle sue ali scandisce le grida di guerra e alimenta le fiamme della furia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391087&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17d89eea-11ac-4180-bb8e-9dec349ab5b5\', \'multiverseId\': 391087}, \'multiverseid\': 391087}, {\'name\': \'ヘルカイトの戦争屋\', \'text\': \'飛行\\nすべてのクリーチャーは、可能なら各戦闘で攻撃する。\\n{1}{R}：ターン終了時まで、攻撃クリーチャーは＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'その翼のはばたきは戦乱の慟哭に呼応し、憤怒の炎を煽り立てる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391424&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ccd88f04-e5d2-45e8-aeba-42db5e42c28c\', \'multiverseId\': 391424}, \'multiverseid\': 391424}, {\'name\': \'好战残虐者\', \'text\': \'飞行\\n所有生物每次战斗若能攻击，则必须攻击。\\n{1}{R}：进行攻击的生物得+1/+0直到回合结束。\', \'type\': \'生物～龙\', \'flavor\': \'龙翼舞动，正合冲锋战嚎，煽动狂愤怒火。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390076&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb99ce50-06d4-4907-9571-5121f0054f9c\', \'multiverseId\': 390076}, \'multiverseid\': 390076}]', "[{'name': 'Kristallader', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}, opfere die Kristallader: Erhöhe deinen Manavorrat um {2}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390150&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5af8b011-7269-4fce-831f-cb09e4446d7e', 'multiverseId': 390150}, 'multiverseid': 390150}, {'name': 'Veta cristalina', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}, sacrificar la Veta cristalina: Agrega {2} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391498&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '779c60b0-0aa6-4d2a-b67e-502c7edc2167', 'multiverseId': 391498}, 'multiverseid': 391498}, {'name': 'Veine de cristal', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T}, sacrifiez la Veine de cristal : Ajoutez {2} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390487&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a8f46a49-8baa-4f33-820f-cd8a1dda490b', 'multiverseId': 390487}, 'multiverseid': 390487}, {'name': 'Vena di Cristallo', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}, Sacrifica la Vena di Cristallo: Aggiungi {2} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390824&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '02727d47-9e2c-4bde-97f8-e2a76081dd1b', 'multiverseId': 390824}, 'multiverseid': 390824}, {'name': '水晶鉱脈', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}, 水晶鉱脈を生け贄に捧げる：あなたのマナ・プールに{2}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391161&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '26f4ceb4-5c83-47ae-a83e-ac420cfcbae7', 'multiverseId': 391161}, 'multiverseid': 391161}, {'name': '水晶矿脉', 'text': '{T}：加{1}到你的法术力池中。\\n{T}，牺牲水晶矿脉：加{2}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389813&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0cc902f7-22af-40ef-ad7d-2a580f8534ac', 'multiverseId': 389813}, 'multiverseid': 389813}]", '[{\'name\': \'Krone der Verdammnis\', \'text\': \'Immer wenn eine Kreatur dich oder einen Planeswalker, den du kontrollierst, angreift, erhält sie +2/+0 bis zum Ende des Zuges.\\n{2}: Ein Spieler deiner Wahl außer dem Besitzer der Krone der Verdammnis übernimmt die Kontrolle über sie. Aktiviere diese Fähigkeit nur während deines Zuges.\', \'type\': \'Artefakt\', \'flavor\': \'Jeder Kopf, den sie schmückt, wird gekürzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390147&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e3ef041-f3b9-4ce4-b59d-7fd6bdabae9a\', \'multiverseId\': 390147}, \'multiverseid\': 390147}, {\'name\': \'Corona de la fatalidad\', \'text\': \'Siempre que una criatura te ataque a ti o a un planeswalker que controlas, esa criatura obtiene +2/+0 hasta el final del turno.\\n{2}: El jugador objetivo que no sea el propietario de la Corona de la fatalidad gana su control. Activa esta habilidad solo durante tu turno.\', \'type\': \'Artefacto\', \'flavor\': \'Cada cabeza sobre la que se posa acaba cercenada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391495&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fbcbf5a6-7ac3-4a6d-8667-22d63e1bb2a8\', \'multiverseId\': 391495}, \'multiverseid\': 391495}, {\'name\': \'Couronne du destin\', \'text\': "À chaque fois qu\'une créature vous attaque ou attaque un planeswalker que vous contrôlez, elle gagne +2/+0 jusqu\'à la fin du tour.\\n{2} : Un joueur ciblé autre que le propriétaire de la Couronne du destin en acquiert le contrôle. N\'activez cette capacité que pendant votre tour.", \'type\': \'Artefact\', \'flavor\': "Chaque tête qui s\'en trouve coiffée finit tranchée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390484&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'433b939b-47b5-4410-9a8e-1cc59cbc67b7\', \'multiverseId\': 390484}, \'multiverseid\': 390484}, {\'name\': \'Corona del Destino\', \'text\': \'Ogniqualvolta una creatura attacca te o un planeswalker che controlli, prende +2/+0 fino alla fine del turno.\\n{2}: Un giocatore bersaglio diverso dal proprietario della Corona del Destino ne prende il controllo. Attiva questa abilità solo durante il tuo turno.\', \'type\': \'Artefatto\', \'flavor\': \'Ogni testa su cui si posa finisce per essere mozzata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390821&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a788a57b-ce22-4885-a97e-f0673115cf78\', \'multiverseId\': 390821}, \'multiverseid\': 390821}, {\'name\': \'破滅の冠\', \'text\': \'クリーチャー１体があなたかあなたがコントロールするプレインズウォーカーを攻撃するたび、ターン終了時まで、それは＋２/＋０の修整を受ける。\\n{2}：破滅の冠のオーナー以外のプレイヤーを対象とする。そのプレイヤーはこれのコントロールを得る。この能力は、あなたのターンの間にのみ起動できる。\', \'type\': \'アーティファクト\', \'flavor\': \'それを戴いた首はもれなく切り落とされることとなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391158&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'731e76ec-4c51-4fcd-8017-23e9c753b42f\', \'multiverseId\': 391158}, \'multiverseid\': 391158}, {\'name\': \'末日冠冕\', \'text\': \'每当一个生物攻击你或由你操控的鹏洛客时，它得+2/+0直到回合结束。\\n{2}：末日冠冕之拥有者以外的目标牌手获得末日冠冕的操控权。只能于你的回合中起动此异能。\', \'type\': \'神器\', \'flavor\': \'曾戴过这顶皇冠的人，结局都是身首异处。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389810&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9cbd39e8-9daf-44c2-b39c-a2475798f50d\', \'multiverseId\': 389810}, \'multiverseid\': 389810}]', '[{\'name\': \'Krypta von Agadeem\', \'text\': \'Die Krypta von Agadeem kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {B}.\\n{2}, {T}: Erhöhe deinen Manavorrat für jede schwarze Kreaturenkarte in deinem Friedhof um {B}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390149&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00e5541e-cac4-42d4-9ae4-73dcf2a3d24b\', \'multiverseId\': 390149}, \'multiverseid\': 390149}, {\'name\': \'Cripta de Agadeem\', \'text\': \'La Cripta de Agadeem entra al campo de batalla girada.\\n{T}: Agrega {B} a tu reserva de maná.\\n{2}, {T}: Agrega {B} a tu reserva de maná por cada carta de criatura negra en tu cementerio.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391497&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acc19b3e-4f65-4343-be97-42644a448824\', \'multiverseId\': 391497}, \'multiverseid\': 391497}, {\'name\': "Crypte d\'Agadeem", \'text\': "La Crypte d\'Agadeem arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {B} à votre réserve.\\n{2}, {T} : Ajoutez {B} à votre réserve pour chaque carte de créature noire dans votre cimetière.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390486&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'277b3402-26e9-4884-8c7b-284c3b6de95d\', \'multiverseId\': 390486}, \'multiverseid\': 390486}, {\'name\': \'Cripta di Agadeem\', \'text\': \'La Cripta di Agadeem entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {B} alla tua riserva di mana.\\n{2}, {T}: Aggiungi {B} alla tua riserva di mana per ogni carta creatura nera nel tuo cimitero.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390823&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b24c04b-8523-40e9-bdb9-b7b26f9ceb3c\', \'multiverseId\': 390823}, \'multiverseid\': 390823}, {\'name\': \'アガディームの墓所\', \'text\': \'アガディームの墓所はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{B}を加える。\\n{2}, {T}：あなたの墓地にある黒のクリーチャー・カード１枚につき、あなたのマナ・プールに{B}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391160&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e6cf501-be12-4476-8483-d3645e2e912d\', \'multiverseId\': 391160}, \'multiverseid\': 391160}, {\'name\': \'艾格丁墓穴\', \'text\': \'艾格丁墓穴须横置进战场。\\n{T}：加{B}到你的法术力池中。\\n{2}，{T}：你坟墓场中每有一张黑色生物牌，便加{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389812&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8201be6d-5eed-4464-a300-cf7ccfd3c3c0\', \'multiverseId\': 389812}, \'multiverseid\': 389812}]', "[{'name': 'Krypta-Schaudergeist', 'text': 'Abnötigen (Immer wenn du einen Zauberspruch wirkst, kannst du {W/B} bezahlen. Falls du dies tust, verliert jeder Gegner 1 Lebenspunkt und du erhältst ebenso viele Lebenspunkte dazu.)\\nImmer wenn du einen Sumpf für Mana tappst, erhöhe deinen Manavorrat um {B} (zusätzlich zu dem Mana, das dieses Land erzeugt).', 'type': 'Kreatur — Geist', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390148&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1d42b9a6-145c-4cd3-a99f-f35a6c0f54f9', 'multiverseId': 390148}, 'multiverseid': 390148}, {'name': 'Espanto de la cripta', 'text': 'Extorsionar. (Siempre que lances un hechizo, puedes pagar {W/B}. Si lo haces, cada oponente pierde 1 vida y tú ganas esa cantidad de vidas.)\\nSiempre que gires un pantano para obtener maná, añade {B} a tu reserva de maná (además del maná que produzca esa tierra).', 'type': 'Criatura — Espíritu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391496&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9c427d67-bd5e-4343-bfcb-49dbc7ae94c7', 'multiverseId': 391496}, 'multiverseid': 391496}, {'name': 'Blême des cryptes', 'text': 'Extorsion (À chaque fois que vous lancez un sort, vous pouvez payer {W/B}. Si vous faites ainsi, chaque adversaire perd 1 point de vie et vous gagnez autant de points de vie.)\\nÀ chaque fois que vous engagez un marais pour du mana, ajoutez {B} à votre réserve (en plus du mana produit par le terrain).', 'type': 'Créature : esprit', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390485&type=card', 'language': 'French', 'identifiers': {'scryfallId': '82853e54-996c-419c-b47d-65b49d688c82', 'multiverseId': 390485}, 'multiverseid': 390485}, {'name': 'Spettro della Cripta', 'text': 'Estorsione (Ogniqualvolta lanci una magia, puoi pagare {W/B}. Se lo fai, ogni avversario perde 1 punto vita e tu guadagni altrettanti punti vita.)\\nOgniqualvolta TAPpi una Palude per attingere mana, aggiungi {B} alla tua riserva di mana (in aggiunta al mana prodotto dalla terra).', 'type': 'Creatura — Spirito', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390822&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5a3ac349-0bd9-4005-8c95-cfe200617684', 'multiverseId': 390822}, 'multiverseid': 390822}, {'name': '墓所の怪異', 'text': '強請（あなたが呪文を１つ唱えるたび、あなたは{W/B}を支払ってもよい。そうしたなら、各対戦相手はそれぞれ１点のライフを失い、あなたはその点数分のライフを得る。）\\nあなたがマナを引き出す目的で沼を１つタップするたび、（その土地が生み出すマナに加えて）あなたのマナ・プールに{B}を加える。', 'type': 'クリーチャー — スピリット', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391159&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f590a0d2-487f-4829-a999-c4640ef1780d', 'multiverseId': 391159}, 'multiverseid': 391159}, {'name': '墓穴惧妖', 'text': '敲诈（每当你施放一个咒语时，你可以支付{W/B}。若你如此作，则每位对手各失去1点生命，且你获得等量的生命。）\\n每当你横置一个沼泽以产生法术力时，加{B}到你的法术力池中。（会得到原本该有的法术力，并加上此份法术力。）', 'type': '生物～精怪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389811&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f2da0a7d-c591-4c50-804e-28d6b8ca2d90', 'multiverseId': 389811}, 'multiverseid': 389811}]", '[{\'name\': \'Landschenkung\', \'text\': \'Falls ein Gegner mehr Länder als du kontrolliert, durchsuche deine Bibliothek nach bis zu drei Ebene-Karten, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390210&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ccd0c65-bdc3-4dec-9a69-79edf73e193d\', \'multiverseId\': 390210}, \'multiverseid\': 390210}, {\'name\': \'Regalo de fincas\', \'text\': \'Si un oponente controla más tierras que tú, busca en tu biblioteca hasta tres cartas de llanura, muéstralas y ponlas en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391558&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'62a2e17b-278b-44d4-8716-b19f0f52b5be\', \'multiverseId\': 391558}, \'multiverseid\': 391558}, {\'name\': \'Don de domaines\', \'text\': "Si un adversaire contrôle plus de terrains que vous, cherchez dans votre bibliothèque jusqu\'à trois cartes de plaine, révélez-les et mettez-les dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390547&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ab01b63-92f1-429d-8e22-66a395b50238\', \'multiverseId\': 390547}, \'multiverseid\': 390547}, {\'name\': "Dono dell\'Estate", \'text\': \'Se un avversario controlla più terre di te, passa in rassegna il tuo grimorio per trovare fino a tre carte Pianura, rivelale e aggiungile alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'04b0be3a-65c5-426a-bd60-cb26bba87d56\', \'multiverseId\': 390884}, \'multiverseid\': 390884}, {\'name\': \'土地の寄進\', \'text\': \'対戦相手１人があなたより多くの土地をコントロールしているなら、あなたのライブラリーから平地・カードを最大３枚まで探し、それらを公開してあなたの手札に加える。その後あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391221&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f297267-dce7-4ae7-8d02-b1df7915ddbf\', \'multiverseId\': 391221}, \'multiverseid\': 391221}, {\'name\': \'献地\', \'text\': \'如果某对手操控的地比你多，则从你的牌库中搜寻至多三张平原牌，展示这些牌，并将它们置于你手上。然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389873&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4ab354cb-f568-4a3f-b100-2b0d031aa5ac\', \'multiverseId\': 389873}, \'multiverseid\': 389873}]', '[{\'name\': \'Laugenelementar\', \'text\': \'Morph {5}{U}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn das Laugenelementar aufgedeckt wird, übergehen alle Gegner ihr nächstes Enttappsegment.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Wasser vereint sich mit Wasser und lässt hinter sich die Welt ausgetrocknet zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390126&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a06b99e7-1e04-416e-b930-591287cfae8d\', \'multiverseId\': 390126}, \'multiverseid\': 390126}, {\'name\': \'Elemental marítimo\', \'text\': \'Metamorfosis {5}{U}{U}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Elemental marítimo se ponga boca arriba, cada oponente se salta su próximo paso de enderezar.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'El agua llama al agua, y el mundo queda agotado y reseco a su paso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391474&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e8ca960-0f28-483d-a1d8-ebf74ab337a0\', \'multiverseId\': 391474}, \'multiverseid\': 391474}, {\'name\': \'Élémental des embruns\', \'text\': "Mue {5}{U}{U} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand l\'Élémental des embruns est retourné face visible, chaque adversaire passe sa prochaine étape de dégagement.", \'type\': \'Créature : élémental\', \'flavor\': "L\'eau engendre l\'eau, et elle laisse un monde desséché dans son sillage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390463&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bed0a117-2532-40e6-98cc-ebf7d14f6cca\', \'multiverseId\': 390463}, \'multiverseid\': 390463}, {\'name\': \'Elementale del Mare\', \'text\': "Metamorfosi {5}{U}{U} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando l\'Elementale del Mare viene girata a faccia in su, ogni avversario salta il suo prossimo STAP.", \'type\': \'Creatura — Elementale\', \'flavor\': "L\'acqua attira l\'acqua e il mondo è lasciato esausto e inaridito nella sua scia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390800&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7757aeb5-ce23-4673-98a0-01d83e105a95\', \'multiverseId\': 390800}, \'multiverseid\': 390800}, {\'name\': \'塩水の精霊\', \'text\': \'変異{5}{U}{U}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n塩水の精霊が表向きになったとき、各対戦相手はそれぞれ自分の次のアンタップ・ステップを飛ばす。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'水は水を呼び、その後に残された世界は疲れ果て干からびていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391137&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b8cd5bc-9351-40c2-93df-65187e5fbe81\', \'multiverseId\': 391137}, \'multiverseid\': 391137}, {\'name\': \'盐湖元素\', \'text\': \'变身{5}{U}{U}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当盐湖元素翻回正面时，每位对手略过其下一个重置步骤。\', \'type\': \'生物～元素\', \'flavor\': \'水分凝聚汇流，遗下一片干枯世界。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389789&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d09ddc8-e56b-4ac5-aaca-7d4196a6614d\', \'multiverseId\': 389789}, \'multiverseid\': 389789}]', '[{\'name\': \'Lebensblut-Hydra\', \'text\': \'Verursacht Trampelschaden\\nDie Lebensblut-Hydra kommt mit X +1/+1-Marken ins Spiel.\\nWenn die Lebensblut-Hydra stirbt, erhältst du Lebenspunkte in Höhe ihrer Stärke dazu und ziehst entsprechend viele Karten.\', \'type\': \'Kreatur — Hydra\', \'flavor\': \'In ihre Knochen sind Pharikas Geheimnisse geritzt, so dass nur die Würdigen sie entdecken mögen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390250&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d201ecc-7b42-4e96-b72a-1ded2a238ac4\', \'multiverseId\': 390250}, \'multiverseid\': 390250}, {\'name\': \'Hidra sangrienta\', \'text\': \'Arrolla.\\nLa Hidra sangrienta entra al campo de batalla con X contadores +1/+1 sobre ella.\\nCuando la Hidra sangrienta muera, ganas una cantidad de vidas y robas una cantidad de cartas igual a su fuerza.\', \'type\': \'Criatura — Hidra\', \'flavor\': \'Farika ha escrito sus secretos en sus huesos para que solo aquellos que sean dignos los descubran.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391598&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4556b17c-f3fd-4d32-82df-7c71ee83b4fc\', \'multiverseId\': 391598}, \'multiverseid\': 391598}, {\'name\': \'Hydre de force vive\', \'text\': "Piétinement\\nL\'Hydre de force vive arrive sur le champ de bataille avec X marqueurs +1/+1 sur elle.\\nQuand l\'Hydre de force vive meurt, vous gagnez un nombre de points de vie et piochez un nombre de cartes égaux à sa force.", \'type\': \'Créature : hydre\', \'flavor\': "Pour éviter que ses secrets ne tombent aux mains de n\'importe qui, Pharika les a inscrits sur les os de la bête.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390587&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27250e60-04ee-4800-97c2-11c908fbec4e\', \'multiverseId\': 390587}, \'multiverseid\': 390587}, {\'name\': \'Idra della Linfa Vitale\', \'text\': "Travolgere\\nL\'Idra della Linfa Vitale entra nel campo di battaglia con X segnalini +1/+1.\\nQuando l\'Idra della Linfa Vitale muore, guadagni punti vita e peschi un numero di carte pari alla sua forza.", \'type\': \'Creatura — Idra\', \'flavor\': \'Farika ha inciso i propri segreti sulle sue ossa, affinché solo chi ne è degno possa scoprirli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390924&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b66b3ec-7a5b-4e37-8a63-2955ad79c963\', \'multiverseId\': 390924}, \'multiverseid\': 390924}, {\'name\': \'生命線のハイドラ\', \'text\': \'トランプル\\n生命線のハイドラは、＋１/＋１カウンターがＸ個置かれた状態で戦場に出る。\\n生命線のハイドラが死亡したとき、あなたはこれのパワーに等しい点数のライフを得て、これのパワーに等しい枚数のカードを引く。\', \'type\': \'クリーチャー — ハイドラ\', \'flavor\': \'ファリカはそれを知る資格のある者のみが発見できるよう、その骨に彼女の持つ秘密を記した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391261&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca1b321b-017f-4feb-900f-db70c6cf05cb\', \'multiverseId\': 391261}, \'multiverseid\': 391261}, {\'name\': \'血脉多头龙\', \'text\': \'践踏\\n血脉多头龙进战场时上面有X个+1/+1指示物。\\n当血脉多头龙死去时，你获得等同于其力量的生命，并抓该数量的牌。\', \'type\': \'生物～多头龙\', \'flavor\': \'芳瑞卡将她的秘密写在多头龙骨头上，确保只有值得知晓此秘密的人才能发现。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389913&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6096385d-abd4-47fb-bca8-55fa4820ded9\', \'multiverseId\': 389913}, \'multiverseid\': 389913}]', '[{\'name\': \'Liebliche Sirenen\', \'text\': \'{U}, {T}: Eine Kreatur deiner Wahl greift einen Gegner deiner Wahl in diesem Zug an, falls möglich.\\nMorph {U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\', \'type\': \'Kreatur — Sirene\', \'flavor\': \'Was sind die Befehle eines Königs oder die eigene Überzeugung nebst solcher Melodien?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390171&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'92ebe60b-c23a-48a3-9263-2b09c038c8d1\', \'multiverseId\': 390171}, \'multiverseid\': 390171}, {\'name\': \'Sirenas melodiosas\', \'text\': \'{U}, {T}: La criatura objetivo ataca al oponente objetivo este turno si puede.\\nMetamorfosis {U}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\', \'type\': \'Criatura — Sirena\', \'flavor\': \'¿Qué son las órdenes de un rey o las exigencias de un credo frente a tales melodías?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391519&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b357b9b8-c7f7-4091-818e-7f9270058af4\', \'multiverseId\': 391519}, \'multiverseid\': 391519}, {\'name\': \'Sirènes suaves\', \'text\': "{U}, {T} : La créature ciblée attaque l\'adversaire ciblé ce tour-ci si possible.\\nMue {U} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)", \'type\': \'Créature : sirène\', \'flavor\': "Face à pareille mélodie, quel poids ont les ordres d\'un roi ou les exigences d\'un dogme ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390508&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ced57340-5551-499c-b38d-992db8889bc5\', \'multiverseId\': 390508}, \'multiverseid\': 390508}, {\'name\': \'Sirene Soavi\', \'text\': \'{U}, {T}: Una creatura bersaglio attacca un avversario bersaglio in questo turno, se può farlo.\\nMetamorfosi {U} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\', \'type\': \'Creatura — Sirena\', \'flavor\': \'Cosa valgono gli ordini di un re o gli obblighi della fede di fronte a simili melodie?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390845&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f674918-2a3c-46c7-a1a3-d3a65eafe0d4\', \'multiverseId\': 390845}, \'multiverseid\': 390845}, {\'name\': \'美旋律のセイレーン\', \'text\': \'{U}, {T}：クリーチャー１体と対戦相手１人を対象とする。このターン、そのクリーチャーは可能ならそのプレイヤーを攻撃する。\\n変異{U}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\', \'type\': \'クリーチャー — セイレーン\', \'flavor\': \'このような旋律に比べれば、王の命令や信条が求める要求などさしたるものではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391182&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e090ebc4-380c-475b-aa83-303896572055\', \'multiverseId\': 391182}, \'multiverseid\': 391182}, {\'name\': \'悦曲塞连\', \'text\': \'{U}，{T}：目标生物本回合若能攻击目标对手，则必须如此作。\\n变身{U}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\', \'type\': \'生物～塞连\', \'flavor\': \'但闻如此美妙旋律，哪还理得了许多君命与教义？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389834&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71f3ba08-fa60-48ef-ab4d-6466f20f242b\', \'multiverseId\': 389834}, \'multiverseid\': 389834}]', "[{'name': 'Lied der Dryaden', 'text': 'Verzaubert eine bleibende Karte\\nDie verzauberte bleibende Karte ist ein farbloses Wald-Land.', 'type': 'Verzauberung — Aura', 'flavor': 'Nur wenige, die auf den seltsamen Hain stoßen, ziehen weiter, wenn sie erst den melodischen Gesang der Dryaden vernommen haben.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390357&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f3a6f6a7-c1dc-45c0-9565-88991bcb5a45', 'multiverseId': 390357}, 'multiverseid': 390357}, {'name': 'Canción de las dríadas', 'text': 'Encantar permanente.\\nEl permanente encantado es una tierra bosque incolora.', 'type': 'Encantamiento — Aura', 'flavor': 'Pocos de aquellos que hallan la extraña arboleda de formas humanas la abandonan una vez que el melodioso coro de las dríadas alcanza sus oídos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391705&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '35cc5d58-6f9b-4d52-a6a3-b7272ba53dac', 'multiverseId': 391705}, 'multiverseid': 391705}, {'name': 'Chant des dryades', 'text': 'Enchanter : permanent\\nLe permanent enchanté est un terrain Forêt incolore.', 'type': 'Enchantement : aura', 'flavor': 'De tous ceux qui découvrent cet étrange bosquet vivant, rares sont ceux qui en ressortent une fois captivés par le chœur mélodieux des dryades.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390694&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f0c3b552-9a7c-45b1-abf9-011347f2a579', 'multiverseId': 390694}, 'multiverseid': 390694}, {'name': 'Canto delle Driadi', 'text': 'Incanta permanente\\nIl permanente incantato è una terra Foresta incolore.', 'type': 'Incantesimo — Aura', 'flavor': 'Di quanti si imbattono nel bizzarro boschetto dalle sembianze umane, ben pochi lo lasciano dopo che il melodioso coro delle driadi ha raggiunto le loro orecchie.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391031&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ad402e03-d664-475d-9aed-38a28f91eed1', 'multiverseId': 391031}, 'multiverseid': 391031}, {'name': 'ドライアドの歌', 'text': 'エンチャント（パーマネント）\\nエンチャントされているパーマネントは無色の森・土地である。', 'type': 'エンチャント — オーラ', 'flavor': 'この奇妙な人の形をした木立と遭遇し、ドライアドたちの陽気な合唱の声がその耳に届いた者のなかで、再びそこから離れることができた者は少ない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391368&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7062beda-49ae-4790-b8e3-c4e56792d87a', 'multiverseId': 391368}, 'multiverseid': 391368}, {'name': '树灵幽歌', 'text': '结附于永久物\\n所结附的永久物是无色树林地。', 'type': '结界～灵气', 'flavor': '鲜有在看到奇异人形树丛，听到树灵的轻快合唱之后还离开者。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390020&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ebf61bb8-cb59-45e4-9aab-34a25d026a76', 'multiverseId': 390020}, 'multiverseid': 390020}]", '[{\'name\': \'Lilianas Plünderer\', \'text\': \'Todesberührung\\nImmer wenn Lilianas Plünderer einem Spieler Kampfschaden zufügt, wirft dieser Spieler eine Karte ab und du bringst einen 2/2 schwarzen Zombie-Kreaturenspielstein getappt ins Spiel.\', \'type\': \'Kreatur — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390251&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'035af280-bcd8-489e-b1ff-4dceb40fd40a\', \'multiverseId\': 390251}, \'multiverseid\': 390251}, {\'name\': \'Desgarrador de Liliana\', \'text\': \'Toque mortal.\\nSiempre que el Desgarrador de Liliana haga daño de combate a un jugador, ese jugador descarta una carta y tú pones en el campo de batalla una ficha de criatura Zombie negra 2/2 girada.\', \'type\': \'Criatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391599&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02d78f64-c8fd-4fb5-a331-0a2e0c2b0dbb\', \'multiverseId\': 391599}, \'multiverseid\': 391599}, {\'name\': \'Pillard de Liliana\', \'text\': "Contact mortel\\nÀ chaque fois que le Pillard de Liliana inflige des blessures de combat à un joueur, ce joueur se défausse d\'une carte et vous mettez sur le champ de bataille, engagé, un jeton de créature 2/2 noire Zombie.", \'type\': \'Créature : zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390588&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'761b173e-22f0-42dc-9354-eab5beeadba7\', \'multiverseId\': 390588}, \'multiverseid\': 390588}, {\'name\': \'Razziatore di Liliana\', \'text\': \'Tocco letale\\nOgniqualvolta il Razziatore di Liliana infligge danno da combattimento a un giocatore, quel giocatore scarta una carta e tu metti una pedina creatura Zombie 2/2 nera sul campo di battaglia TAPpata.\', \'type\': \'Creatura — Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390925&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'21a09b6a-7876-446d-a82b-c29bf88121b6\', \'multiverseId\': 390925}, \'multiverseid\': 390925}, {\'name\': \'リリアナの肉裂き\', \'text\': \'接死\\nリリアナの肉裂きがプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーはカードを１枚捨て、あなたは黒の２/２のゾンビ・クリーチャー・トークンを１体タップ状態で戦場に出す。\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391262&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fefbd528-4b28-4864-9041-9bf95a62b3c6\', \'multiverseId\': 391262}, \'multiverseid\': 391262}, {\'name\': \'莉莲娜的撕肉兽\', \'text\': \'死触\\n每当莉莲娜的撕肉兽对任一牌手造成战斗伤害时，该牌手弃一张牌，且你将一个2/2黑色灵俑衍生生物横置进战场。\', \'type\': \'生物～灵俑\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389914&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2c809768-80d8-49f9-a12c-66acc4febe5d\', \'multiverseId\': 389914}, \'multiverseid\': 389914}]', "[{'name': 'Llanowarelfen', 'text': '{T}: Erhöhe deinen Manavorrat um {G}.', 'type': 'Kreatur — Elf, Druide', 'flavor': 'Ein gebrochener Knochen für jeden zertretenen Zweig. —Strafe der Llanowar für Waldfriedensbruch', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390253&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c6d4dde6-1b60-4f58-b47f-81da7b96c1cd', 'multiverseId': 390253}, 'multiverseid': 390253}, {'name': 'Elfos de Llanowar', 'text': '{T}: Agrega {G} a tu reserva de maná.', 'type': 'Criatura — Druida elfo', 'flavor': 'Un hueso roto por cada rama partida. —Castigo Llanowar a los intrusos', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391601&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c0acbb4d-3d52-4bd8-a3bf-ed4055e50c92', 'multiverseId': 391601}, 'multiverseid': 391601}, {'name': 'Elfes de Llanowar', 'text': '{T} : Ajoutez {G} à votre réserve.', 'type': 'Créature : elfe et druide', 'flavor': 'Un os brisé pour chaque branche cassée. —Punition de Llanowar pour les intrus', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390590&type=card', 'language': 'French', 'identifiers': {'scryfallId': '25f8902d-b0a5-436d-8e28-106389d3e7e1', 'multiverseId': 390590}, 'multiverseid': 390590}, {'name': 'Elfi di Llanowar', 'text': '{T}: Aggiungi {G} alla tua riserva di mana.', 'type': 'Creatura — Druido Elfo', 'flavor': 'Un osso rotto per ogni ramoscello calpestato. —Punizione di Llanowar per gli intrusi', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390927&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '19dcc493-15eb-4ea3-884a-bd91183f4553', 'multiverseId': 390927}, 'multiverseid': 390927}, {'name': 'ラノワールのエルフ', 'text': '{T}：あなたのマナ・プールに{G}を加える。', 'type': 'クリーチャー — エルフ・ドルイド', 'flavor': '小枝を踏み折れば、骨を折ってあがないとする。 ――ラノワールのエルフの、侵入者への処罰', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391264&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b0737421-88ca-4a97-b101-5f5f8ba05c53', 'multiverseId': 391264}, 'multiverseid': 391264}, {'name': '罗堰妖精', 'text': '{T}：加{G}到你的法术力池中。', 'type': '生物～妖精／德鲁伊', 'flavor': '每踩断脚下一根树枝就打断一根骨头。 ～罗堰族对非法入侵者的罚则', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389916&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '37762869-c19d-4775-8ee0-29135e551ae5', 'multiverseId': 389916}, 'multiverseid': 389916}]", '[{\'name\': \'Lorthos, der Gezeitenmacher\', \'text\': \'Immer wenn Lorthos, der Gezeitenmacher, angreift, kannst du {8} bezahlen. Falls du dies tust, tappe bis zu acht bleibende Karten deiner Wahl. Diese bleibenden Karten enttappen nicht während des nächsten Enttappsegments ihrer Beherrscher.\', \'type\': \'Legendäre Kreatur — Oktopus\', \'flavor\': \'Wenn Lorthos aus seinem Tiefseereich auftaucht, fügt sich die Flut seinem Willen, und die Küste zieht sich zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390256&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5fcfbd23-43a7-4377-988d-dfe84b87f187\', \'multiverseId\': 390256}, \'multiverseid\': 390256}, {\'name\': \'Lorthos, el creador de mareas\', \'text\': \'Siempre que Lorthos, el creador de mareas ataque, puedes pagar {8}. Si lo haces, gira hasta ocho permanentes objetivo. Esos permanentes no se enderezan durante el próximo paso de enderezar de sus controladores.\', \'type\': \'Criatura legendaria — Pulpo\', \'flavor\': \'Cuando Lorthos emerge de su reino en las profundidades, las mareas se inclinan a su voluntad y la costa se acobarda ante su presencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391604&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8307023d-b3d7-4ac8-bf56-df66b8580afa\', \'multiverseId\': 391604}, \'multiverseid\': 391604}, {\'name\': \'Lorthos, le Faiseur de marées\', \'text\': "À chaque fois que Lorthos, le Faiseur de marées attaque, vous pouvez payer {8}. Si vous faites ainsi, engagez jusqu\'à huit permanents ciblés. Ces permanents ne se dégagent pas pendant les prochaines étapes de dégagement de leurs contrôleurs.", \'type\': \'Créature légendaire : pieuvre\', \'flavor\': \'Quand Lorthos surgit des profondeurs de son royaume, les marées se plient à ses désirs et la côte tremble en sa présence.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390593&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2f950c0d-1569-4411-8d3b-cbd2fbbc270a\', \'multiverseId\': 390593}, \'multiverseid\': 390593}, {\'name\': \'Lorthos, lo Spostamaree\', \'text\': \'Ogniqualvolta Lorthos, lo Spostamaree attacca, puoi pagare {8}. Se lo fai, TAPpa fino a otto permanenti bersaglio. Quei permanenti non STAPpano durante i prossimi STAP dei rispettivi controllori.\', \'type\': \'Creatura Leggendaria — Piovra\', \'flavor\': \'Quando Lorthos emerge dal suo reame delle profondità, le maree si inchinano al suo volere e la costa si prostra alla sua presenza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390930&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'faab9575-f44d-436c-835d-bf078082ba85\', \'multiverseId\': 390930}, \'multiverseid\': 390930}, {\'name\': \'潮汐を作るもの、ロートス\', \'text\': \'潮汐を作るもの、ロートスが攻撃するたび、パーマネントを最大８つまで対象とする。あなたは{8}を支払ってもよい。そうしたなら、それらのパーマネントをタップする。それらのパーマネントは、それらのコントローラーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'伝説のクリーチャー — タコ\', \'flavor\': \'ロートスが深海の王国から姿を現す時、潮流は彼の意志に頭を下げ、海岸は彼の存在に恐れおののく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391267&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4122acb3-9fbd-465c-bcbf-3eb0a3319b1e\', \'multiverseId\': 391267}, \'multiverseid\': 391267}, {\'name\': \'兴潮罗佐司\', \'text\': \'每当兴潮罗佐司攻击时，你可以支付{8}。若你如此作，则横置至多八个目标永久物。这些永久物于其操控者的下一个重置步骤中不能重置。\', \'type\': \'传奇生物～章鱼\', \'flavor\': \'罗佐司从其深海国度现身，潮浪为其意志而躬身行礼，海岸见其身形即畏缩奔逃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389919&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e1f836ad-4642-4f70-816f-3e777342de38\', \'multiverseId\': 389919}, \'multiverseid\': 389919}]', '[{\'name\': \'Loxodon-Kriegshammer\', \'text\': \'Die ausgerüstete Kreatur erhält +3/+0, hat Lebensverknüpfung und verursacht Trampelschaden.\\nAusrüsten {3}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Ein Schmied muss seine Waffe mit einem Teil seiner Seele erfüllen — dessen sind die Phyrexianer nicht fähig." —Melira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390257&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'136137d8-e307-4b50-9e69-9f71fdd4d95e\', \'multiverseId\': 390257}, \'multiverseid\': 390257}, {\'name\': \'Martillo de guerra loxodón\', \'text\': \'La criatura equipada obtiene +3/+0 y tiene las habilidades de arrollar y vínculo vital.\\nEquipar {3}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"Un herrero debe imbuir en su arma parte de su alma... algo de lo que los pirexianos son incapaces". —Melira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391605&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07f61d3a-3cdf-48af-a556-f20d7abffc03\', \'multiverseId\': 391605}, \'multiverseid\': 391605}, {\'name\': \'Marteau de guerre loxodon\', \'text\': \'La créature équipée gagne +3/+0 et a le piétinement et le lien de vie.\\nÉquipement {3}\', \'type\': \'Artefact : équipement\', \'flavor\': "« Un façonneur doit imprégner son arme d\'une partie de son âme — ce dont les Phyrexians sont bien incapables. » —Melira", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390594&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'afac774c-3633-4832-b17d-1ce94f2cab70\', \'multiverseId\': 390594}, \'multiverseid\': 390594}, {\'name\': \'Martello da Guerra Lossodonte\', \'text\': \'La creatura equipaggiata prende +3/+0 e ha legame vitale e travolgere.\\nEquipaggiare {3}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Un\\\'artefice deve infondere nella sua arma parte della propria anima: un processo impossibile per gli orrori di Phyrexia." —Melira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390931&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfaac31d-6c03-4769-bbdb-dae740e744d4\', \'multiverseId\': 390931}, \'multiverseid\': 390931}, {\'name\': \'ロクソドンの戦槌\', \'text\': \'装備しているクリーチャーは＋３/＋０の修整を受けるとともにトランプルと絆魂を持つ。\\n装備{3}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「造り士は武器に自分の魂の一部を埋め込まなくてはならないの。これはファイレクシア人にはできない芸当だけどね。」 ――メリーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391268&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6163fa25-23dc-4f3e-8dfd-d8d486d33944\', \'multiverseId\': 391268}, \'multiverseid\': 391268}, {\'name\': \'象族战锤\', \'text\': \'佩带此武具的生物得+3/+0且具有系命与践踏异能。\\n佩带{3}\', \'type\': \'神器～武具\', \'flavor\': \'「巧匠打造武器时必定会将心血甚至灵魂灌注其中～这一点非瑞克西亚人永远没法做到。」 ～梅梨莱\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389920&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3d5df9e4-ab61-44c7-9cac-243e583e2312\', \'multiverseId\': 389920}, \'multiverseid\': 389920}]', '[{\'name\': \'Machtversprechen\', \'text\': \'Bestimme eines —\\n• Du ziehst fünf Karten und verlierst 5 Lebenspunkte.\\n• Bringe einen X/X schwarzen Dämon-Kreaturenspielstein mit Flugfähigkeit ins Spiel, wobei X gleich der Anzahl an Karten auf deiner Hand ist, sowie der Spielstein ins Spiel kommt.\\nVerflechtung {4} (Bestimme beides, falls du die Verflechtungskosten bezahlst.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390320&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c11719f2-3eb7-41da-9c7d-a92ccfe50e21\', \'multiverseId\': 390320}, \'multiverseid\': 390320}, {\'name\': \'Promesa de poder\', \'text\': \'Elige uno:\\n• Robas cinco cartas y pierdes 5 vidas.\\n• Pon en el campo de batalla una ficha de criatura Demonio negra X/X con la habilidad de volar, donde X es la cantidad de cartas en tu mano cuando la ficha entra al campo de batalla.\\nEntrelazar {4}. (Si pagas el coste de entrelazar, elige ambas opciones.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391668&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88f1bf32-f919-4226-9056-0930e74245cb\', \'multiverseId\': 391668}, \'multiverseid\': 391668}, {\'name\': \'Promesse de pouvoir\', \'text\': "Choisissez l\'un —\\n• Vous piochez cinq cartes et vous perdez 5 points de vie.\\n• Mettez sur le champ de bataille un jeton de créature X/X noire Démon avec le vol, X étant le nombre de cartes dans votre main au moment où le jeton arrive sur le champ de bataille.\\nUnion {4} (Choisissez les deux si vous payez le coût d\'union.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390657&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3fd7740-5f88-4bc0-a187-c76890fba154\', \'multiverseId\': 390657}, \'multiverseid\': 390657}, {\'name\': \'Promessa di Potere\', \'text\': \'Scegli uno —\\n• Pesca cinque carte e perdi 5 punti vita.\\n• Metti sul campo di battaglia una pedina creatura Demone X/X nera con volare, dove X è il numero di carte che hai in mano mentre la pedina entra nel campo di battaglia.\\nIntrecciare {4} (Scegli entrambi se paghi il costo di intrecciare.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'242ff6af-9a95-439a-97e1-0f13a4c1df5f\', \'multiverseId\': 390994}, \'multiverseid\': 390994}, {\'name\': \'力の確約\', \'text\': \'以下の２つから１つを選ぶ。\\n「あなたはカードを５枚引き、５点のライフを失う。」\\n「飛行を持つ黒のＸ/Ｘのデーモン・クリーチャー・トークンを１体戦場に出す。Ｘはそのトークンが戦場に出る際のあなたの手札にあるカードの枚数に等しい。」\\n双呪{4}（双呪コストを支払ったなら、両方を選ぶ。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391331&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cf79360b-c373-4c1b-84b5-421ad922be28\', \'multiverseId\': 391331}, \'multiverseid\': 391331}, {\'name\': \'允诺力量\', \'text\': \'选择一项～\\n•你抓五张牌且你失去5点生命。\\n•将一个X/X黑色，具飞行异能的恶魔衍生生物放进战场，X为于此衍生物进战场时你的手牌数量。\\n打包{4}（如果你支付打包费用，则两项都选。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389983&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e490f26a-a208-4faa-8082-7cf031e0ef9e\', \'multiverseId\': 389983}, \'multiverseid\': 389983}]', '[{\'name\': \'Magmabeben\', \'text\': \'Das Magmabeben fügt allen Planeswalkern und allen nichtfliegenden Kreaturen X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wohin willst du fliehen, wenn ich dich mit eben dem Boden bestrafe, auf dem du fliehst?" —Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390259&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf56c39f-515d-4067-a471-65f6f09a7261\', \'multiverseId\': 390259}, \'multiverseid\': 390259}, {\'name\': \'Magmamoto\', \'text\': \'El Magmamoto hace X puntos de daño a cada criatura que no tenga la habilidad de volar y a cada planeswalker.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Adónde huirás cuando te castigue con el mismo suelo sobre el que corres?" —Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391607&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42b767d1-0ec0-4069-80a1-f6056b5ee510\', \'multiverseId\': 391607}, \'multiverseid\': 391607}, {\'name\': \'Tremblement de lave\', \'text\': \'Le Tremblement de lave inflige X blessures à chaque créature sans le vol et à chaque planeswalker.\', \'type\': \'Éphémère\', \'flavor\': "« Où fuir, quand je te châtie à l\'aide du sol sur lequel tu prends appui pour courir ? » —Nicol Bolas", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390596&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2d75f48-2651-4e82-baa7-521de7aa9702\', \'multiverseId\': 390596}, \'multiverseid\': 390596}, {\'name\': \'Magmamoto\', \'text\': \'Il Magmamoto infligge X danni a ogni creatura senza volare e a ogni planeswalker.\', \'type\': \'Istantaneo\', \'flavor\': \'"Dove potrai mai fuggire quando ti punisco con lo stesso terreno su cui stai correndo?" —Nicol Bolas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390933&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61369558-dfe8-45cc-b839-2ff8dbb2c432\', \'multiverseId\': 390933}, \'multiverseid\': 390933}, {\'name\': \'溶岩震\', \'text\': \'溶岩震は飛行を持たない各クリーチャーと各プレインズウォーカーにそれぞれＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「貴様が落ち延びた先の大地そのもので罰してやるというのに、どこへ逃げるつもりだ？」 ――ニコル・ボーラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391270&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1273e933-2244-48a0-ab2c-58bc42df51f4\', \'multiverseId\': 391270}, \'multiverseid\': 391270}, {\'name\': \'岩浆暴震\', \'text\': \'岩浆暴震对每个鹏洛客与每个不具飞行异能的生物各造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「你脚踩的大地就是我要拿来对付你的东西，还想往哪逃？」 ～尼可波拉斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389922&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5cf06d72-c44a-438d-add1-29fbdf0bac9f\', \'multiverseId\': 389922}, \'multiverseid\': 389922}]', '[{\'name\': \'Magus der Schatzkammern\', \'text\': \'{2}, {T}: Erhöhe deinen Manavorrat für jeden Sumpf, den du kontrollierst, um {B}.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Von den Kabbalisten verblieb nur der Hall in ihren tiefsten Gewölben. Doch wer diese Echos hört, kann eine Macht spüren, der kein Staub der Jahre etwas anhaben konnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390260&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a7789d7-295a-4458-9bf4-ff2982a6545a\', \'multiverseId\': 390260}, \'multiverseid\': 390260}, {\'name\': \'Mago de las arcas\', \'text\': \'{2}, {T}: Agrega {B} a tu reserva de maná por cada pantano que controlas.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Todo lo que queda de la Cábala son los ecos en sus bóvedas más profundas. Sin embargo, aquellos que escuchan los ecos sienten un poder que no ha disminuido con los años.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391608&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb4d7204-7df7-4dad-86d7-e9fec71aef64\', \'multiverseId\': 391608}, \'multiverseid\': 391608}, {\'name\': \'Mage des coffres\', \'text\': \'{2}, {T} : Ajoutez {B} à votre réserve pour chaque marais que vous contrôlez.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "La Coterie n\'est plus désormais qu\'un écho dans ses caves les plus profondes. Pourtant, ceux qui l\'entendent ressentent un pouvoir qui ne s\'est pas flétri au passage du temps.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390597&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1a34a92-db5c-42ba-9003-d64f222bfc1c\', \'multiverseId\': 390597}, \'multiverseid\': 390597}, {\'name\': \'Magus degli Scrigni\', \'text\': \'{2}, {T}: Aggiungi {B} alla tua riserva di mana per ogni Palude che controlli.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "Tutto ciò che rimane della Cabala è l\'eco delle voci nella sua cripta più profonda. Quanti odono quell\'eco, però, sentono una potenza non certo sminuita dalla polvere dei secoli.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390934&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'45c5f909-b288-4353-838f-426fedeeae5e\', \'multiverseId\': 390934}, \'multiverseid\': 390934}, {\'name\': \'貴重品室の大魔術師\', \'text\': \'{2}, {T}：あなたがコントロールする沼１つにつき、あなたのマナ・プールに{B}を加える。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'陰謀団が遺したすべての物は、最も深い地下室に響くこだまだけだ。ただし、そのこだまを耳にするものは、年月の埃に埋もれても消えない力を感じるのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391271&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'41141c26-372f-401f-9f1c-1fc99a6dae37\', \'multiverseId\': 391271}, \'multiverseid\': 391271}, {\'name\': \'金库贤者\', \'text\': \'{2}，{T}：你每操控一个沼泽，便加{B}到你的法术力池中。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'柯帮的唯一遗物是地窖最深处之回响。但可听闻者，都能感受此力量并未因久远岁月而减弱。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389923&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5fa5fa8e-e578-41c4-b2d7-fea2c1921283\', \'multiverseId\': 389923}, \'multiverseid\': 389923}]', '[{\'name\': \'Makelloser Magistrat\', \'text\': \'{T}: Lege für jeden Elfen, den du kontrollierst, eine +1/+1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Elfen der Kaste der Makellosen weben Pflanzen in lebende Kreaturen ein — manchmal, um einen Elitekrieger auszuzeichnen, manchmal, um ein atmendes Kunstwerk zu erschaffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390226&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d055665c-82f2-4cd1-ab88-3c65ccadb71d\', \'multiverseId\': 390226}, \'multiverseid\': 390226}, {\'name\': \'Magistrado inmaculado\', \'text\': \'{T}: Pon un contador +1/+1 sobre la criatura objetivo por cada Elfo que controlas.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Los elfos de la casta inmaculada tejen criaturas vivientes a partir de flores; a veces para respaldar a un guerrero de élite, a veces para crear una obra de arte viviente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391574&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68852207-3a1c-41df-a533-048b82378174\', \'multiverseId\': 391574}, \'multiverseid\': 391574}, {\'name\': \'Magistrat immaculé\', \'text\': \'{T} : Mettez un marqueur +1/+1 sur la créature ciblée pour chaque elfe que vous contrôlez.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': "Les elfes de la caste des immaculés font fleurir des créatures vivantes — parfois pour indiquer qu\'ils sont les mécènes d\'un guerrier d\'élite, d\'autres pour créer une œuvre d\'art vivante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390563&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66c325a0-9633-4ebc-8225-0f3ce6bea4b9\', \'multiverseId\': 390563}, \'multiverseid\': 390563}, {\'name\': \'Magistrato Immacolato\', \'text\': \'{T}: Metti un segnalino +1/+1 su una creatura bersaglio per ogni Elfo che controlli.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': "Gli elfi della classe immacolata tessono la flora in creature viventi... a volte per aiutare un abile guerriero, altre per creare una pulsante opera d\'arte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390900&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f7510c2d-e65b-43e3-9c72-cba0ad65b362\', \'multiverseId\': 390900}, \'multiverseid\': 390900}, {\'name\': \'清廉潔白な判事\', \'text\': \'{T}：クリーチャー１体を対象とする。それの上に、あなたがコントロールするエルフ１体につき＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'エルフの清廉潔白な者の階級は、植物を編み上げて生き物を生み出す――時には精鋭の戦士の証として、時には生ける美を創り出す仕事のために。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391237&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f435d95a-2d04-45d5-828e-72ef30210769\', \'multiverseId\': 391237}, \'multiverseid\': 391237}, {\'name\': \'无垢官员\', \'text\': \'{T}：你每操控一个妖精，便在目标生物上放置一个+1/+1指示物。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'无垢阶级的妖精将植物织成活物～有时用来献给出色战士，有时用来创造无上艺术品。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2528968f-d432-49df-ac3e-6accfacc3056\', \'multiverseId\': 389889}, \'multiverseid\': 389889}]', '[{\'name\': \'Makelloser Talisman\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}. Du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'„Werkzeuge und Handwerker können zerstört werden, aber der Akt des Erschaffens bleibt unberührt." —Elspeth Tirel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390318&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9668ee45-7737-41d2-9cc9-97dc6686dba8\', \'multiverseId\': 390318}, \'multiverseid\': 390318}, {\'name\': \'Talismán prístino\', \'text\': \'{T}: Agrega {1} a tu reserva de maná. Ganas 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'"Las herramientas y artesanos pueden ser destruidos, pero el acto de creación es inviolable". —Elspeth Tirel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391666&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7aaa1393-68ca-49ec-8774-9aa476e4268d\', \'multiverseId\': 391666}, \'multiverseid\': 391666}, {\'name\': \'Talisman immaculé\', \'text\': \'{T} : Ajoutez {1} à votre réserve. Vous gagnez 1 point de vie.\', \'type\': \'Artefact\', \'flavor\': "« Les outils et les artisans peuvent être détruits, mais l\'acte de création reste pur. » —Elspeth Tirel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390655&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9da954b-10e1-4953-8eba-54bd2b40bc70\', \'multiverseId\': 390655}, \'multiverseid\': 390655}, {\'name\': \'Talismano Integro\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana. Guadagni 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'"Gli attrezzi e gli artigiani possono essere distrutti, ma l\\\'atto della creazione è inviolato." —Elspeth Tirel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390992&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d27450c-cc0d-4712-b0fc-935aa511ec2e\', \'multiverseId\': 390992}, \'multiverseid\': 390992}, {\'name\': \'清純のタリスマン\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。あなたは１点のライフを得る。\', \'type\': \'アーティファクト\', \'flavor\': \'「道具や職人は失われます。だけど、創造の行いは犯されません。」 ――エルズペス・ティレル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391329&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ef49fc2f-4da2-4b62-84d1-7cfeeb2947da\', \'multiverseId\': 391329}, \'multiverseid\': 391329}, {\'name\': \'纯净饰符\', \'text\': \'{T}：加{1}到你的法术力池中。你获得1点生命。\', \'type\': \'神器\', \'flavor\': \'「工具与工匠可能会毁灭，但创作此行为将生生不息。」 ～艾紫培提瑞\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a2c810cf-3490-4a81-80b3-5413facbe8e9\', \'multiverseId\': 389981}, \'multiverseid\': 389981}]', '[{\'name\': \'Mannigfaltige Landschaft\', \'text\': \'Die Mannigfaltige Landschaft kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {1}.\\n{2}, {T}, opfere die Mannigfaltige Landschaft: Durchsuche deine Bibliothek nach bis zu zwei Standardland-Karten, die einen Landtyp gemeinsam haben, bringe diese getappt ins Spiel und mische dann deine Bibliothek.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390285&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'62531abb-9264-4f70-b461-ff4d5423043a\', \'multiverseId\': 390285}, \'multiverseid\': 390285}, {\'name\': \'Paisaje infinito\', \'text\': \'El Paisaje infinito entra al campo de batalla girado.\\n{T}: Agrega {1} a tu reserva de maná.\\n{2}, {T}, sacrificar el Paisaje infinito: Busca en tu biblioteca hasta dos cartas de tierra básica que compartan un tipo de tierra, ponlas en el campo de batalla giradas y luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391633&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36754ac3-3e12-412e-906e-ab48e45eabb7\', \'multiverseId\': 391633}, \'multiverseid\': 391633}, {\'name\': \'Paysage myriadaire\', \'text\': "Le Paysage myriadaire arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {1} à votre réserve.\\n{2}, {T}, sacrifiez le Paysage myriadaire : Cherchez dans votre bibliothèque jusqu\'à deux cartes de terrain de base qui partagent un type de terrain, mettez-les sur le champ de bataille engagées et mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390622&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32ea16d3-7eae-4002-a78a-10c15fd6fe06\', \'multiverseId\': 390622}, \'multiverseid\': 390622}, {\'name\': \'Paesaggio delle Miriadi\', \'text\': \'Il Paesaggio delle Miriadi entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {1} alla tua riserva di mana.\\n{2}, {T}, Sacrifica il Paesaggio delle Miriadi: Passa in rassegna il tuo grimorio per trovare fino a due carte terra base che condividono un tipo di terra, mettile sul campo di battaglia TAPpate, poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390959&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'57cfa4fe-0c41-4db4-9718-c89c34d71212\', \'multiverseId\': 390959}, \'multiverseid\': 390959}, {\'name\': \'無限地帯\', \'text\': \'無限地帯はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{1}を加える。\\n{2}, {T}, 無限地帯を生け贄に捧げる：あなたのライブラリーから同じ土地タイプを持つ基本土地・カードを最大２枚まで探し、それらをタップ状態で戦場に出し、その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391296&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b8e67cc-6937-47df-ba16-b7db434d307f\', \'multiverseId\': 391296}, \'multiverseid\': 391296}, {\'name\': \'繁茂地境\', \'text\': \'繁茂地境须横置进战场。\\n{T}：加{1}到你的法术力池中。\\n{2}，{T}，牺牲繁茂地境：从你的牌库中搜寻至多两张具共通地类别的基本地牌，将它们横置进战场，然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389948&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0b58501-8189-4364-982b-8015fd89d99c\', \'multiverseId\': 389948}, \'multiverseid\': 389948}]', '[{\'name\': \'Meisterhafte Schrottverwertung\', \'text\': \'Jeder Spieler schickt alle Artefaktkarten aus seinem Friedhof ins Exil, opfert dann alle Artefakte, die er kontrolliert, und bringt dann alle auf diese Weise ins Exil geschickten Karten ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': \'„Wo Kleingeister Schrott sehen, sehe ich unendliches Potenzial."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390337&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14c0d65b-b98d-4bff-9bd6-821dcbaebafc\', \'multiverseId\': 390337}, \'multiverseid\': 390337}, {\'name\': \'Maestría de la chatarra\', \'text\': \'Cada jugador exilia todas las cartas de artefacto de su cementerio, luego sacrifica todos los artefactos que controla, luego pone todas las cartas que exilió de esta manera en el campo de batalla.\', \'type\': \'Conjuro\', \'flavor\': \'"Donde una mente inferior ve basura, yo veo un potencial infinito".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391685&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cbb0db50-0a31-48a8-9755-ec1bc143120f\', \'multiverseId\': 391685}, \'multiverseid\': 391685}, {\'name\': \'Maîtrise de la ferraille\', \'text\': "Chaque joueur exile toutes les cartes d\'artefact depuis son cimetière, puis sacrifie tous les artefacts qu\'il contrôle, et met ensuite sur le champ de bataille toutes les cartes qu\'il a exilées de cette manière.", \'type\': \'Rituel\', \'flavor\': \'« Là où les esprits inférieurs ne voient que quincaille, je vois un potentiel infini. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390674&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15ff46e5-f927-4bee-aa44-c843ea2078bc\', \'multiverseId\': 390674}, \'multiverseid\': 390674}, {\'name\': \'Maestria con i Rottami\', \'text\': \'Ogni giocatore esilia tutte le carte artefatto dal proprio cimitero, poi sacrifica tutti gli artefatti che controlla, infine mette sul campo di battaglia tutte le carte esiliate in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': \'"Dove gli stolti vedono cianfrusaglie, io vedo un potenziale infinito."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2faff216-45bd-43e0-9628-a520a9f7c1c3\', \'multiverseId\': 391011}, \'multiverseid\': 391011}, {\'name\': \'屑鉄の熟達\', \'text\': \'各プレイヤーは、自分の墓地からすべてのアーティファクト・カードを追放し、その後自分がコントロールするすべてのアーティファクトを生け贄に捧げ、その後これにより自分が追放したすべてのカードを戦場に出す。\', \'type\': \'ソーサリー\', \'flavor\': \'「小者はこれらをガラクタとしか認識しないだろうが、私は無限の可能性を見出すことができる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391348&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'483b79c9-4a5d-4b87-9567-45f6258b880f\', \'multiverseId\': 391348}, \'multiverseid\': 391348}, {\'name\': \'废铁究研\', \'text\': \'每位牌手各从其坟墓场中放逐所有神器牌，然后牺牲由他操控的所有神器，然后将他以此法放逐的所有牌放进战场。\', \'type\': \'法术\', \'flavor\': \'「低等人眼中的垃圾，在我手中却有无限可能。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1991f869-82bc-4427-b9bf-356a89869a50\', \'multiverseId\': 390000}, \'multiverseid\': 390000}]', '[{\'name\': \'Meisterwerk der Erfindungsgabe\', \'text\': \'Du kannst das Meisterwerk der Erfindungsgabe als Kopie einer beliebigen Ausrüstung im Spiel ins Spiel kommen lassen.\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Der Schmelztiegel bringt hervor, was deine Gedanken geschmiedet haben. Du musst nur danach greifen und das Meisterwerk herausziehen." —Wahara, Hüterin des Schmelztiegels\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390267&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b00fabb-2159-4659-a27c-b35504d1844a\', \'multiverseId\': 390267}, \'multiverseid\': 390267}, {\'name\': \'Obra maestra del ingenio\', \'text\': \'Puedes hacer que la Obra maestra del ingenio entre al campo de batalla como una copia de cualquier equipo en el campo de batalla.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"El crisol produce lo que has forjado en tu mente. Solo tienes que extender la mano y extraer la obra maestra". —Wahara, guardiana del crisol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391615&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'960f02ec-1683-4190-8638-33ee099c4149\', \'multiverseId\': 391615}, \'multiverseid\': 391615}, {\'name\': "Chef-d\'œuvre d\'ingéniosité", \'text\': "Vous pouvez faire que le Chef-d\'œuvre d\'ingéniosité arrive sur le champ de bataille comme une copie de n\'importe quel équipement sur le champ de bataille.", \'type\': \'Artefact : équipement\', \'flavor\': "« Le creuset produit ce que vous avez forgé dans votre esprit. Vous n\'avez plus qu\'à tendre la main pour récupérer votre chef-d\'œuvre. » —Wahara, gardienne du creuset", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390604&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e8c48d8-ed54-4e57-abdc-ff26bec3aa54\', \'multiverseId\': 390604}, \'multiverseid\': 390604}, {\'name\': \'Capolavoro di Ingegno\', \'text\': \'Puoi far entrare il Capolavoro di Ingegno nel campo di battaglia come una copia di qualsiasi Equipaggiamento sul campo di battaglia.\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Il crogiolo produce ciò che la tua mente ha forgiato. Devi solo tendere la mano per estrarne un capolavoro." —Wahara, Custode del Crogiolo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390941&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4bff95a3-7e7f-4e62-847c-cdd3fc9f0498\', \'multiverseId\': 390941}, \'multiverseid\': 390941}, {\'name\': \'創意工夫の傑作\', \'text\': \'あなたは創意工夫の傑作を、戦場に出ているいずれかの装備品のコピーとして戦場に出してもよい。\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「るつぼはあなたが思い描いたものを生み出します。あとは、あなたがこの中に手を伸ばして、傑作を引き出してあげるだけ。」 ――るつぼの守り手、ワハラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391278&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d024a8b-206b-455b-ada5-ddb0e5ca65db\', \'multiverseId\': 391278}, \'multiverseid\': 391278}, {\'name\': \'巧手神兵\', \'text\': \'你可以使巧手神兵当成战场上任一武具的复制品来进入战场。\', \'type\': \'神器～武具\', \'flavor\': \'「心中神兵锤炼，都在熔炉之中。只需伸手入内，就能将之取出。」 ～熔炉看守瓦哈拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389930&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5c5190ee-af6c-4887-9482-3e49f2d955f7\', \'multiverseId\': 389930}, \'multiverseid\': 389930}]', '[{\'name\': \'Mentor der Sanften\', \'text\': \'Immer wenn eine andere Kreatur mit Stärke 2 oder weniger unter deiner Kontrolle ins Spiel kommt, kannst du {1} bezahlen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„In diesen Hallen gibt es kein Bestehen oder Scheitern. Deine wahre Prüfung kommt beim nächsten Vollmond."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390268&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4dc542bf-112c-43b9-bd6d-3d167e7e149f\', \'multiverseId\': 390268}, \'multiverseid\': 390268}, {\'name\': \'Mentor de los mansos\', \'text\': \'Siempre que otra criatura con fuerza de 2 o menos entre al campo de batalla bajo tu control, puedes pagar {1}. Si lo haces, roba una carta.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"En estos salones no se aprueba o reprueba. El verdadero examen llega con la primera luna llena."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391616&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db90074b-c5c8-42dd-b016-47b12d6fcad6\', \'multiverseId\': 391616}, \'multiverseid\': 391616}, {\'name\': \'Mentor des humbles\', \'text\': "À chaque fois qu\'une autre créature avec une force inférieure ou égale à 2 arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {1}. Si vous faites ainsi, piochez une carte.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Ici il n\'y a pas d\'échec ou de réussite. Votre véritable examen de passage, c\'est la première pleine lune. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390605&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bb029ac-8568-421a-be09-3ab0c0afe152\', \'multiverseId\': 390605}, \'multiverseid\': 390605}, {\'name\': \'Mentore degli Umili\', \'text\': "Ogniqualvolta un\'altra creatura con forza pari o inferiore a 2 entra nel campo di battaglia sotto il tuo controllo, puoi pagare {1}. Se lo fai, pesca una carta.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"In queste sale non c\\\'è promosso o bocciato. La vostra vera prova avviene con la prima luna piena."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390942&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'858b8154-79e6-4fa9-a0f1-ebd0a3e94ebd\', \'multiverseId\': 390942}, \'multiverseid\': 390942}, {\'name\': \'弱者の師\', \'text\': \'他のパワーが２以下のクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたは{1}を支払ってもよい。そうしたなら、カードを１枚引く。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「これらの広間では、成功も失敗もありません。真の試練は最初の満月と共に訪れます。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391279&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69b75958-39e5-4851-a9a9-b3697d644bdb\', \'multiverseId\': 391279}, \'multiverseid\': 391279}, {\'name\': \'驯良明师\', \'text\': \'每当另一个力量等于或小于2的生物在你的操控下进战场时，你可以支付{1}。若你如此作，则抓一张牌。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「这课堂没有过不过关的问题。真正的考验会在第一次满月时到来。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389931&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b31e22ef-e6f3-42c2-b57a-f33446275deb\', \'multiverseId\': 389931}, \'multiverseid\': 389931}]', "[{'name': 'Mit Blut unterschreiben', 'text': 'Ein Spieler deiner Wahl zieht zwei Karten und verliert 2 Lebenspunkte.', 'type': 'Hexerei', 'flavor': 'Kleine Schmerzen ebnen den Weg zu größerer Macht.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390345&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4af84fd4-ab3e-484a-9d5b-00a158e02fde', 'multiverseId': 390345}, 'multiverseid': 390345}, {'name': 'Firmar con sangre', 'text': 'El jugador objetivo roba dos cartas y pierde 2 vidas.', 'type': 'Conjuro', 'flavor': 'Pequeños dolores preparan el camino para un gran poder.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391693&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a3081a13-b714-4b49-a6d7-39d815cdaeeb', 'multiverseId': 391693}, 'multiverseid': 391693}, {'name': 'Signature de sang', 'text': 'Le joueur ciblé pioche deux cartes et perd 2 points de vie.', 'type': 'Rituel', 'flavor': 'Les petites douleurs ouvrent la voie du grand pouvoir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390682&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5d330c07-30ac-491d-8a00-1ebf9a2a3021', 'multiverseId': 390682}, 'multiverseid': 390682}, {'name': 'Firmare col Sangue', 'text': 'Un giocatore bersaglio pesca due carte e perde 2 punti vita.', 'type': 'Stregoneria', 'flavor': 'Lievi tormenti pavimentano la strada verso un potere superiore.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391019&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '30db14f8-5221-4daa-a72e-6a7225a0bf8a', 'multiverseId': 391019}, 'multiverseid': 391019}, {'name': '血の署名', 'text': 'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚引き、２点のライフを失う。', 'type': 'ソーサリー', 'flavor': 'わずかな苦悶が偉大なる力への道を拓く。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391356&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bb83db20-4957-4b94-a0f2-3aa83a1fa654', 'multiverseId': 391356}, 'multiverseid': 391356}, {'name': '以血立契', 'text': '目标牌手抓两张牌且失去2点生命。', 'type': '法术', 'flavor': '微小痛苦为巨大力量铺路。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390008&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6e34b83a-36a2-4ae8-9d44-be6a03a685da', 'multiverseId': 390008}, 'multiverseid': 390008}]", '[{\'name\': \'Mitternächtliches Spuken\', \'text\': \'Bringe zwei 1/1 weiße Geist-Kreaturenspielsteine mit Flugfähigkeit ins Spiel.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Weg zurück in die Welt der Lebenden ist unklar und verwirrend. Manche Geister entdecken nie, dass sie ihre eigenen Angehörigen terrorisieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390269&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e9a970e-bd06-48d1-a82c-10273d83911c\', \'multiverseId\': 390269}, \'multiverseid\': 390269}, {\'name\': \'Aparición de medianoche\', \'text\': \'Pon en el campo de batalla dos fichas de criatura Espíritu blancas 1/1 con la habilidad de volar.\', \'type\': \'Instantáneo\', \'flavor\': \'El camino de regreso al mundo de los vivos es fangoso y apabullante. Un geist puede no darse cuenta de que está aterrorizando a sus seres amados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391617&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'682bcafe-97f4-4cd7-9dca-b35eb1e2a325\', \'multiverseId\': 391617}, \'multiverseid\': 391617}, {\'name\': \'Hantise de minuit\', \'text\': \'Mettez sur le champ de bataille deux jetons de créature 1/1 blanche Esprit avec le vol.\', \'type\': \'Éphémère\', \'flavor\': "La voie qui vous ramène dans le monde des vivants est trouble et surprenante. Un geist ne réalise parfois même pas qu\'il terrifie ses proches.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390606&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e106239a-66dd-4dfe-933f-31dfd300c438\', \'multiverseId\': 390606}, \'multiverseid\': 390606}, {\'name\': \'Infestazione di Mezzanotte\', \'text\': \'Metti sul campo di battaglia due pedine creatura Spirito 1/1 bianche con volare.\', \'type\': \'Istantaneo\', \'flavor\': \'Il sentiero che riporta nel mondo dei viventi è oscuro e sconcertante. Un geist probabilmente non capisce neppure che sta terrorizzando i suoi cari.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3710d6c9-b02b-4a51-9ea6-4e7a470e3a63\', \'multiverseId\': 390943}, \'multiverseid\': 390943}, {\'name\': \'深夜の出没\', \'text\': \'飛行を持つ白の１/１のスピリット・クリーチャー・トークンを２体戦場に出す。\', \'type\': \'インスタント\', \'flavor\': \'生者の世界へ戻る道は暗く迷走している。 霊は自分が愛した者にすら恐怖を引き起こすことすらわからないのだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391280&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'879b96a2-9e9b-4345-998d-a2ae1e07d2c0\', \'multiverseId\': 391280}, \'multiverseid\': 391280}, {\'name\': \'午夜作祟\', \'text\': \'将两个1/1白色，具飞行异能的精怪衍生生物放进战场。\', \'type\': \'瞬间\', \'flavor\': \'回到生者世界的道路崎岖而漫长。游魂可能根本不晓得它会惊吓到自己所爱的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389932&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62bc1a26-8cb3-4358-9bcf-838488c0b233\', \'multiverseId\': 389932}, \'multiverseid\': 389932}]', "[{'name': 'Mobilisierung', 'text': 'Soldat-Kreaturen haben Wachsamkeit.\\n{2}{W}: Bringe einen 1/1 weißen Soldat-Kreaturenspielstein ins Spiel.', 'type': 'Verzauberung', 'flavor': 'Kriege werden durch Stärke, Tapferkeit und Anzahl der Kämpfer gewonnen — vor allem durch letzteres.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390271&type=card', 'language': 'German', 'identifiers': {'scryfallId': '47ab75fc-a59f-43f4-82a9-78964401d5b7', 'multiverseId': 390271}, 'multiverseid': 390271}, {'name': 'Movilización', 'text': 'Las criaturas Soldado tienen la habilidad de vigilancia.\\n{2}{W}: Pon en el campo de batalla una ficha de criatura Soldado blanca 1/1.', 'type': 'Encantamiento', 'flavor': 'Las guerras se ganan con fuerza, valor y números... especialmente números.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391619&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b494ec1e-b029-446b-8b90-f51d79896d48', 'multiverseId': 391619}, 'multiverseid': 391619}, {'name': 'Incorporation', 'text': 'Les créatures Soldat ont la vigilance.\\n{2}{W} : Mettez sur le champ de bataille un jeton de créature 1/1 blanche Soldat.', 'type': 'Enchantement', 'flavor': 'Les guerres se gagnent avec force, courage et nombre — particulièrement le nombre.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390608&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e1462209-7bf6-4e7c-b24b-8a2fe1c29c4f', 'multiverseId': 390608}, 'multiverseid': 390608}, {'name': 'Mobilitazione', 'text': 'Le creature Soldato hanno cautela.\\n{2}{W}: Metti sul campo di battaglia una pedina creatura Soldato 1/1 bianca.', 'type': 'Incantesimo', 'flavor': 'Le guerre sono vinte con la forza, il valore e i numeri... soprattutto i numeri.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390945&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '683f61ef-b4b5-449e-8a7d-bef7931f8ab0', 'multiverseId': 390945}, 'multiverseid': 390945}, {'name': '動員令', 'text': '兵士・クリーチャーは警戒を持つ。\\n{2}{W}：白の１/１の兵士・クリーチャー・トークンを１体戦場に出す。', 'type': 'エンチャント', 'flavor': '戦争は、力と勇気と数で勝利する――とりわけ、数が重要だ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391282&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9e87d750-c120-4722-82b7-14b9e83bc083', 'multiverseId': 391282}, 'multiverseid': 391282}, {'name': '动员时期', 'text': '士兵生物具有警戒异能。\\n{2}{W}：将一个1/1白色士兵衍生生物放进战场。', 'type': '结界', 'flavor': '胜仗得靠力量，英勇，以及数量～尤其是数量。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389934&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '63b6719e-eeeb-4dab-948e-922a6b6bbc76', 'multiverseId': 389934}, 'multiverseid': 389934}]", "[{'name': 'Mondschatten', 'text': 'Schwarze Kreaturen erhalten +1/+1.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390110&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c9807fb6-329d-4f3a-aaf3-76aea99b5a3e', 'multiverseId': 390110}, 'multiverseid': 390110}, {'name': 'Luna maligna', 'text': 'Las criaturas negras obtienen +1/+1.', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391458&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd85acf94-8dd1-403a-a774-cb626b5edce6', 'multiverseId': 391458}, 'multiverseid': 391458}, {'name': 'Lune blafarde', 'text': 'Les créatures noires gagnent +1/+1.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390447&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a1e3c674-1309-41e5-9e25-42a8cb8d352b', 'multiverseId': 390447}, 'multiverseid': 390447}, {'name': 'Luna Nera', 'text': 'Le creature nere prendono +1/+1.', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390784&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '00f7e055-fd6b-4c60-9d90-58d13d32fc04', 'multiverseId': 390784}, 'multiverseid': 390784}, {'name': '不吉の月', 'text': '黒のクリーチャーは＋１/＋１の修整を受ける。', 'type': 'エンチャント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391121&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e299f679-5827-4986-b2bd-3571711cb987', 'multiverseId': 391121}, 'multiverseid': 391121}, {'name': '邪恶之月', 'text': '黑色生物得+1/+1。', 'type': '结界', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389773&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '31807cee-0293-4622-a694-36775715cc55', 'multiverseId': 389773}, 'multiverseid': 389773}]", "[{'name': 'Moosdiamant', 'text': 'Der Moosdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390274&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'db7615f6-9ea1-4dbe-8865-2b623a398e13', 'multiverseId': 390274}, 'multiverseid': 390274}, {'name': 'Diamante mohoso', 'text': 'El Diamante mohoso entra al campo de batalla girado.\\n{T}: Agrega {G} a tu reserva de maná.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391622&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a9179b5b-d50a-499f-81fc-97619f41dfb3', 'multiverseId': 391622}, 'multiverseid': 391622}, {'name': 'Diamant de la mousse', 'text': 'Le Diamant de la mousse arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390611&type=card', 'language': 'French', 'identifiers': {'scryfallId': '125a78e0-b377-4790-8bcc-67067ddc9261', 'multiverseId': 390611}, 'multiverseid': 390611}, {'name': 'Diamante del Muschio', 'text': 'Il Diamante del Muschio entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390948&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a9ac4833-9092-476a-b339-81b07464f0c2', 'multiverseId': 390948}, 'multiverseid': 390948}, {'name': '苔色のダイアモンド', 'text': '苔色のダイアモンドはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}を加える。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391285&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '651827ac-2061-439a-80ce-20534dca311f', 'multiverseId': 391285}, 'multiverseid': 391285}, {'name': '苔绿钻石', 'text': '苔绿钻石须横置进战场。\\n{T}：加{G}到你的法术力池中。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389937&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1d818705-6437-47b4-b279-c4a915c71c1e', 'multiverseId': 389937}, 'multiverseid': 389937}]", '[{\'name\': \'Morkrut-Todesfee\', \'text\': \'Morbide — Wenn die Morkrut-Todesfee ins Spiel kommt und falls in diesem Zug eine Kreatur gestorben ist, erhält eine Kreatur deiner Wahl -4/-4 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Lasse deinen Groll fahren, oder du riskierst, für alle Ewigkeiten in mörderischem Zorn durch die Sümpfe zu streichen." —Hildin, Priesterin von Avacyn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390273&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f688e2b-b791-48d7-bb1c-802550fc3079\', \'multiverseId\': 390273}, \'multiverseid\': 390273}, {\'name\': \'Banshee de Morkrut\', \'text\': \'Necrario — Cuando la Banshee de Morkrut entre al campo de batalla, si una criatura murió este turno, la criatura objetivo obtiene -4/-4 hasta el final del turno.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"Olvídate de tus agravios, o arriésgate a vagar por las ciénagas por siempre con una ira asesina." —Hildin, sacerdote de Avacyn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391621&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8d282e26-0db7-429b-a3fa-c0c84d31f0e0\', \'multiverseId\': 391621}, \'multiverseid\': 391621}, {\'name\': \'Banshee de Morkrut\', \'text\': "Morbidité — Quand la Banshee de Morkrut arrive sur le champ de bataille, si une créature est morte ce tour-ci, la créature ciblée gagne -4/-4 jusqu\'à la fin du tour.", \'type\': \'Créature : esprit\', \'flavor\': "« Abandonnez vos rancœurs ou vous risquez d\'errer pour l\'éternité dans les marais, animé d\'une rage aveugle. » —Hildin, prêtresse d\'Avacyn", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390610&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c1abd93-33f7-4f76-aabd-9906d0203e32\', \'multiverseId\': 390610}, \'multiverseid\': 390610}, {\'name\': \'Banshee di Morkrut\', \'text\': \'Morboso — Quando la Banshee di Morkrut entra nel campo di battaglia, se è morta una creatura in questo turno, una creatura bersaglio prende -4/-4 fino alla fine del turno.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"Dimentica i tuoi rancori o rischi di vagare nelle paludi per sempre con una rabbia omicida." —Hildin, sacerdotessa di Avacyn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390947&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'153e360b-555b-409c-8cce-6b3ee5e67794\', \'multiverseId\': 390947}, \'multiverseid\': 390947}, {\'name\': \'モークラットのバンシー\', \'text\': \'陰鬱 ― モークラットのバンシーが戦場に出たとき、このターンにクリーチャーが死亡していた場合、クリーチャー１体を対象とする。ターン終了時まで、それは－４/－４の修整を受ける。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'「恨みを捨てなさい。さもなくば、殺したいほどの怒りに取り憑かれ、沼地を永遠にさまようことになりかねません。」 ――アヴァシンの僧侶、ヒルディン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391284&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3df8e60b-ffc5-4274-94e3-5049ea5fdb4a\', \'multiverseId\': 391284}, \'multiverseid\': 391284}, {\'name\': \'穆坎女妖\', \'text\': \'丧心～当穆坎女妖进战场时，若本回合有生物死去，则目标生物得-4/-4直到回合结束。\', \'type\': \'生物～精怪\', \'flavor\': \'「抛弃你的嫌隙，否则小心会落入抱着恨意永远在沼地徘徊的地步。」 ～艾维欣僧侣西汀\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389936&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'014e4a98-19f8-4bea-b403-2144402e6e29\', \'multiverseId\': 389936}, \'multiverseid\': 389936}]', '[{\'name\': \'Mycosynth-Urquell\', \'text\': \'Wenn der Mycosynth-Urquell ins Spiel kommt oder aus dem Spiel auf einen Friedhof gelegt wird, kannst du deine Bibliothek nach einer Standardland-Karte durchsuchen, sie offen vorzeigen und auf deine Hand nehmen und dann deine Bibliothek mischen.\', \'type\': \'Artefakt\', \'flavor\': \'Das Öl erzeugte das Mycosynth. Das Mycosynth erzeugte das Neue Phyrexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390281&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'28eb3c19-d9cd-4b53-9f91-7dc3165da04d\', \'multiverseId\': 390281}, \'multiverseid\': 390281}, {\'name\': \'Manantial de micosintético\', \'text\': \'Cuando el Manantial de micosintético entre al campo de batalla o vaya a un cementerio desde el campo de batalla, puedes buscar en tu biblioteca una carta de tierra básica, mostrarla, ponerla en tu mano y luego barajar tu biblioteca.\', \'type\': \'Artefacto\', \'flavor\': \'El aceite creó el micosintético. El micosintético creó Nueva Pirexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391629&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b93e6a4c-ada2-48f1-af12-e2e774a4d0e7\', \'multiverseId\': 391629}, \'multiverseid\': 391629}, {\'name\': \'Source de mycosynthèse\', \'text\': \'Quand la Source de mycosynthèse arrive sur le champ de bataille ou est mise dans un cimetière depuis le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de terrain de base, la révéler, la mettre dans votre main et mélanger ensuite votre bibliothèque.\', \'type\': \'Artefact\', \'flavor\': \'Le pétrole créa la mycosynthèse. La mycosynthèse créa la Nouvelle Phyrexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390618&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b7b8694-9492-4022-91b1-66ef6f0a9ee1\', \'multiverseId\': 390618}, \'multiverseid\': 390618}, {\'name\': \'Sorgente di Micosinti\', \'text\': \'Quando la Sorgente di Micosinti entra nel campo di battaglia o viene messa in un cimitero dal campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta terra base, rivelarla e aggiungerla alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Artefatto\', \'flavor\': "L\'olio creò i micosinti. I micosinti crearono la Nuova Phyrexia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390955&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59d0c236-036f-4ec6-bc99-9ac7e3645e77\', \'multiverseId\': 390955}, \'multiverseid\': 390955}, {\'name\': \'マイコシンスの水源\', \'text\': \'マイコシンスの水源が戦場に出たか戦場から墓地に置かれたとき、あなたはあなたのライブラリーから基本土地・カードを１枚探してもよい。そうしたなら、それを公開してあなたの手札に加え、その後あなたのライブラリーを切り直す。\', \'type\': \'アーティファクト\', \'flavor\': \'油はマイコシンスを生み出した。マイコシンスは新ファイレクシアを生み出した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391292&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'14971e5e-4c2b-4d0d-9170-62ea7856301c\', \'multiverseId\': 391292}, \'multiverseid\': 391292}, {\'name\': \'构生菌涌泉\', \'text\': \'当构生菌涌泉进战场或从战场进入坟墓场时，你可以从你的牌库中搜寻一张基本地牌，展示该牌，并将它置于你手上，然后将你的牌库洗牌。\', \'type\': \'神器\', \'flavor\': \'烁油带来构生菌。构生菌带来新非瑞克西亚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389944&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6a58bfb-f267-43ee-b76b-cdb864351616\', \'multiverseId\': 389944}, \'multiverseid\': 389944}]', '[{\'name\': \'Myr-Kampfkugel\', \'text\': \'Wenn die Myr-Kampfkugel ins Spiel kommt, bringe vier 1/1 farblose Myr-Artefaktkreaturenspielsteine ins Spiel.\\nImmer wenn die Myr-Kampfkugel angreift, kannst du X ungetappte Myr, die du kontrollierst, tappen. Falls du dies tust, erhält die Myr-Kampfkugel +X/+0 bis zum Ende des Zuges und fügt dem verteidigenden Spieler X Schadenspunkte zu.\', \'type\': \'Artefaktkreatur — Myr, Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390282&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4826f6cd-179f-4474-915a-2a165ef75210\', \'multiverseId\': 390282}, \'multiverseid\': 390282}, {\'name\': \'Esfera de batalla myr\', \'text\': \'Cuando la Esfera de batalla myr entre al campo de batalla, pon en el campo de batalla cuatro fichas de criatura artefacto Myr incoloras 1/1.\\nSiempre que la Esfera de batalla myr ataque, puedes girar X Myr enderezados que controlas. Si lo haces, la Esfera de batalla myr obtiene +X/+0 hasta el final del turno y hace X puntos de daño al jugador defensor.\', \'type\': \'Criatura artefacto — Constructo myr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391630&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99c9259b-17d5-4786-b2f1-a53b42fd2385\', \'multiverseId\': 391630}, \'multiverseid\': 391630}, {\'name\': \'Sphère de bataille myr\', \'text\': "Quand la Sphère de bataille myr arrive sur le champ de bataille, mettez sur le champ de bataille quatre jetons de créature-artefact 1/1 incolore Myr.\\nÀ chaque fois que la Sphère de bataille myr attaque, vous pouvez engager X myrs dégagés que vous contrôlez. Si vous faites ainsi, la Sphère de bataille myr gagne +X/+0 jusqu\'à la fin du tour et inflige X blessures au joueur défenseur.", \'type\': \'Créature-artefact : myr et construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390619&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36024595-5b45-4870-b62c-c9b7d771ec98\', \'multiverseId\': 390619}, \'multiverseid\': 390619}, {\'name\': \'Sfera da Battaglia Myr\', \'text\': \'Quando la Sfera da Battaglia Myr entra nel campo di battaglia, metti sul campo di battaglia quattro pedine creatura artefatto Myr 1/1 incolori.\\nOgniqualvolta la Sfera da Battaglia Myr attacca, puoi TAPpare X Myr STAPpati che controlli. Se lo fai, la Sfera da Battaglia Myr prende +X/+0 fino alla fine del turno e infligge X danni al giocatore in difesa.\', \'type\': \'Creatura Artefatto — Costrutto Myr\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390956&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1690b55c-5fb2-4a6e-9b42-42a19b6e4f1c\', \'multiverseId\': 390956}, \'multiverseid\': 390956}, {\'name\': \'マイアの戦闘球\', \'text\': \'マイアの戦闘球が戦場に出たとき、無色の１/１のマイア・アーティファクト・クリーチャー・トークンを４体戦場に出す。\\nマイアの戦闘球が攻撃するたび、あなたはあなたがコントロールするアンタップ状態のマイアをＸ体タップしてもよい。そうしたなら、ターン終了時まで、マイアの戦闘球は＋Ｘ/＋０の修整を受けるとともに、防御プレイヤーにＸ点のダメージを与える。\', \'type\': \'アーティファクト・クリーチャー — マイア・構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391293&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'900631ed-a113-4c20-b50f-b757b58320d1\', \'multiverseId\': 391293}, \'multiverseid\': 391293}, {\'name\': \'秘耳斗球\', \'text\': \'当秘耳斗球进战场时，将四个1/1无色秘耳衍生神器生物放进战场。\\n每当秘耳斗球攻击时，你可以横置X个由你操控且未横置的秘耳。若你如此作，则秘耳斗球得+X/+0直到回合结束，并对防御牌手造成X点伤害。\', \'type\': \'神器生物～秘耳／组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389945&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'faf2dab9-b689-48d9-85a1-12d0581495e2\', \'multiverseId\': 389945}, \'multiverseid\': 389945}]', '[{\'name\': \'Myr-Wiederholer\', \'text\': \'Wenn der Myr-Wiederholer stirbt, bringe eine andere Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Artefaktkreatur — Myr\', \'flavor\': \'Der Mephidross gibt seine Schätze gerne her … solange du deren Platz einnimmst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390283&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'724a6fc0-ee85-4581-9745-b9f46027447f\', \'multiverseId\': 390283}, \'multiverseid\': 390283}, {\'name\': \'Recuperador myr\', \'text\': \'Cuando el Recuperador myr muera, regresa otra carta de artefacto objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura artefacto — Myr\', \'flavor\': \'El Méfidros entrega sus tesoros fácilmente... siempre que tomes su lugar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391631&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae634297-76b2-46f8-a999-28cccdc69f92\', \'multiverseId\': 391631}, \'multiverseid\': 391631}, {\'name\': \'Récupérateur Myr\', \'text\': "Quand le Récupérateur Myr meurt, renvoyez une autre carte d\'artefact ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature-artefact : myr\', \'flavor\': \'Mephidross vous abandonne aisément ses richesses... si vous prenez leur place.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390620&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd4e60fe-6d45-46ac-b5fc-a5036a1170ef\', \'multiverseId\': 390620}, \'multiverseid\': 390620}, {\'name\': \'Myr da Riporto\', \'text\': "Quando il Myr da Riporto muore, riprendi in mano un\'altra carta artefatto bersaglio dal tuo cimitero.", \'type\': \'Creatura Artefatto — Myr\', \'flavor\': \'Mephidross cede facilmente i propri tesori... a patto che tu prenda il loro posto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390957&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8ad8bbd-073a-4252-9649-36f811ac2272\', \'multiverseId\': 390957}, \'multiverseid\': 390957}, {\'name\': \'マイアの回収者\', \'text\': \'マイアの回収者が死亡したとき、あなたの墓地にある他のアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'アーティファクト・クリーチャー — マイア\', \'flavor\': \'メフィドロスは宝の山だ…… お前がそこにいられる間は。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391294&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b35b393b-596e-4a3e-aa7a-7126bb8e7840\', \'multiverseId\': 391294}, \'multiverseid\': 391294}, {\'name\': \'回收秘耳\', \'text\': \'当回收秘耳死去时，将另一张目标神器牌从你的坟墓场移回你手上。\', \'type\': \'神器生物～秘耳\', \'flavor\': \'蔓非沼乐于提供宝藏...只要你乐于顶替其位置。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389946&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e1eb10b-7c17-432f-b6a0-705b952af1db\', \'multiverseId\': 389946}, \'multiverseid\': 389946}]', '[{\'name\': \'Myrerzeuger\', \'text\': \'Wenn der Myrerzeuger stirbt, bringe einen 1/1 farblosen Myr-Artefaktkreaturenspielstein ins Spiel.\', \'type\': \'Artefaktkreatur — Myr\', \'flavor\': \'Für Phyrexianer ist der Tod weder ein Ende noch einmalig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390284&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed3744f8-38ad-473e-b5d8-98c27be53710\', \'multiverseId\': 390284}, \'multiverseid\': 390284}, {\'name\': \'Señor myr\', \'text\': \'Cuando el Señor myr muera, pon en el campo de batalla una ficha de criatura artefacto Myr incolora 1/1.\', \'type\': \'Criatura artefacto — Myr\', \'flavor\': \'Para los pirexianos, la muerte no es el final, ni algo que ocurre una sola vez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391632&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73baef17-2225-4cb8-94e6-bb5a5ca4e1f8\', \'multiverseId\': 391632}, \'multiverseid\': 391632}, {\'name\': \'Père des myrs\', \'text\': \'Quand le Père des myrs meurt, mettez sur le champ de bataille un jeton de créature-artefact 1/1 incolore Myr.\', \'type\': \'Créature-artefact : myr\', \'flavor\': "Pour les Phyrexians, la mort n\'est ni une fin, ni un événement unique.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390621&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00c26b0f-a48c-4c83-9357-7b81224600be\', \'multiverseId\': 390621}, \'multiverseid\': 390621}, {\'name\': \'Antenato Myr\', \'text\': "Quando l\'Antenato Myr muore, metti sul campo di battaglia una pedina creatura artefatto Myr 1/1 incolore.", \'type\': \'Creatura Artefatto — Myr\', \'flavor\': \'Per i Phyrexian, la morte non è una fine, né un evento singolo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390958&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'19a332d8-4606-4791-a0ef-fb9f59ac391c\', \'multiverseId\': 390958}, \'multiverseid\': 390958}, {\'name\': \'マイアの種父\', \'text\': \'マイアの種父が死亡したとき、無色の１/１のマイア・アーティファクト・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'アーティファクト・クリーチャー — マイア\', \'flavor\': \'ファイレクシア人にとって、死は終わりではなく、一度限りの事でもない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391295&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f35b97d0-a30e-4ab6-a84e-006fff751a68\', \'multiverseId\': 391295}, \'multiverseid\': 391295}, {\'name\': \'秘耳君父\', \'text\': \'当秘耳君父死去时，将一个1/1无色秘耳衍生神器生物放进战场。\', \'type\': \'神器生物～秘耳\', \'flavor\': \'对非瑞克西亚人来说，死亡既非终点，亦非仅只一次的事件。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389947&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'115a6c79-b4cc-496c-b958-f4b3609799c8\', \'multiverseId\': 389947}, \'multiverseid\': 389947}]', '[{\'name\': \'Mülltaucher\', \'text\': \'Fliegend\\nWenn der Mülltaucher stirbt, bringe eine andere Artefaktkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Artefaktkreatur — Vogel\', \'flavor\': \'Urza erfand nebenher auch noch Recycling.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390245&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18ef6fe9-103d-4616-b655-17a79b3f80aa\', \'multiverseId\': 390245}, \'multiverseid\': 390245}, {\'name\': \'Clavador de basura\', \'text\': \'Vuela.\\nCuando el Clavador de basura muera, regresa otra carta de artefacto objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura artefacto — Ave\', \'flavor\': \'Dentro basura, fuera tesoro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391593&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'522315c2-9d4d-4844-a70b-4ddaac765eaa\', \'multiverseId\': 391593}, \'multiverseid\': 391593}, {\'name\': \'Mécaplongeur\', \'text\': "Vol\\nQuand le Mécaplongeur meurt, renvoyez dans votre main une autre carte d\'artefact ciblée depuis votre cimetière.", \'type\': \'Créature-artefact : oiseau\', \'flavor\': \'De la ferraille à la trouvaille.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390582&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba75f105-77e2-4c48-ad14-a2ed82add1d4\', \'multiverseId\': 390582}, \'multiverseid\': 390582}, {\'name\': \'Pescarifiuti\', \'text\': "Volare\\nQuando il Pescarifiuti muore, riprendi in mano un\'altra carta artefatto bersaglio dal tuo cimitero.", \'type\': \'Creatura Artefatto — Uccello\', \'flavor\': \'Dentro la spazzatura, fuori il tesoro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390919&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b672d8d-f489-4a4f-be08-932d98b06632\', \'multiverseId\': 390919}, \'multiverseid\': 390919}, {\'name\': \'ガラクタ潜り\', \'text\': \'飛行\\nガラクタ潜りが死亡したとき、あなたの墓地にある他のアーティファクト・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'アーティファクト・クリーチャー — 鳥\', \'flavor\': \'ゴミは内、宝は外。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391256&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74dfeaff-0506-4bc2-b364-e58d6aff6518\', \'multiverseId\': 391256}, \'multiverseid\': 391256}, {\'name\': \'垃圾掠集兽\', \'text\': \'飞行\\n当垃圾掠集兽死去时，将另一张目标神器牌从你的坟墓场移回你手上。\', \'type\': \'神器生物～鸟\', \'flavor\': \'废物换宝物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389908&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02047072-d577-421b-b657-dfe03263533f\', \'multiverseId\': 389908}, \'multiverseid\': 389908}]', "[{'name': 'Nachtdiamant', 'text': 'Der Nachtdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {B}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390137&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dfb8b9fe-342a-4b2d-978e-173395faf633', 'multiverseId': 390137}, 'multiverseid': 390137}, {'name': 'Diamante carbonífero', 'text': 'El Diamante carbonífero entra al campo de batalla girado.\\n{T}: Agrega {B} a tu reserva de maná.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391485&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '268a143d-1bff-4b31-a074-38de6d40be84', 'multiverseId': 391485}, 'multiverseid': 391485}, {'name': 'Diamant du charbon', 'text': 'Le Diamant du charbon arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {B} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390474&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1809c480-8975-4e65-837c-b5e0da0f6736', 'multiverseId': 390474}, 'multiverseid': 390474}, {'name': 'Diamante della Cenere', 'text': 'Il Diamante della Cenere entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {B} alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390811&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '813cbbeb-ee22-403e-b293-e8aa2b7ce565', 'multiverseId': 390811}, 'multiverseid': 390811}, {'name': '炭色のダイアモンド', 'text': '炭色のダイアモンドはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{B}を加える。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391148&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '750bbcfb-09ef-4294-a8b6-1ca27dee28e5', 'multiverseId': 391148}, 'multiverseid': 391148}, {'name': '炭黑钻石', 'text': '炭黑钻石须横置进战场。\\n{T}：加{B}到你的法术力池中。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389800&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9e23b58d-d19b-42f0-8e31-96501176c81a', 'multiverseId': 389800}, 'multiverseid': 389800}]", '[{\'name\': \'Nachtstahl-Zitadelle\', \'text\': \'Unzerstörbar (Effekte, die „zerstören", zerstören dieses Land nicht.)\\n{T}: Erhöhe deinen Manavorrat um {1}.\', \'type\': \'Artefakt, Land\', \'flavor\': \'Bauten aus Nachtstahl werden weder durch Angriffe noch durch Alterung geschwächt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390153&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad544857-37c2-4c8a-a5b4-68bd0b91079d\', \'multiverseId\': 390153}, \'multiverseid\': 390153}, {\'name\': \'Ciudadela de acero oscuro\', \'text\': \'Indestructible. (Los efectos que dicen "destruye" no destruyen esta tierra.)\\n{T}: Agrega {1} a tu reserva de maná.\', \'type\': \'Tierra artefacto\', \'flavor\': \'Las estructuras construidas con acero oscuro no ceden ante el asalto ni ante el paso del tiempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391501&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50e3bbe6-1a52-4deb-a0ec-fd2121781610\', \'multiverseId\': 391501}, \'multiverseid\': 391501}, {\'name\': \'Citadelle de sombracier\', \'text\': \'Indestructible (Les effets qui disent « détruisez » ne détruisent pas ce terrain.)\\n{T} : Ajoutez {1} à votre réserve.\', \'type\': \'Terrain-artefact\', \'flavor\': \'Les édifices en sombracier défient les assauts et le temps.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390490&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'828b4472-73cb-4e7d-be8a-5e9d15e0ddfc\', \'multiverseId\': 390490}, \'multiverseid\': 390490}, {\'name\': \'Roccaforte di Darksteel\', \'text\': \'Indistruttibile (Gli effetti che dicono "distruggi" non distruggono questa terra.)\\n{T}: Aggiungi {1} alla tua riserva di mana.\', \'type\': \'Terra Artefatto\', \'flavor\': \'Le strutture di darksteel sono impervie sia agli attacchi sia al passare del tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390827&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2952ef20-cd08-4c64-99c8-27d0049524fa\', \'multiverseId\': 390827}, \'multiverseid\': 390827}, {\'name\': \'ダークスティールの城塞\', \'text\': \'破壊不能（「破壊する」と書かれた効果では、この土地は破壊されない。）\\n{T}：あなたのマナ・プールに{1}を加える。\', \'type\': \'アーティファクト・土地\', \'flavor\': \'ダークスティールで造られた構造物は、攻撃にも年月にも屈することはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391164&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'73523154-32f4-4ed8-91ad-1226aa671e8e\', \'multiverseId\': 391164}, \'multiverseid\': 391164}, {\'name\': \'玄铁殿堂\', \'text\': \'不灭（注明「消灭」的效应不会消灭此地。）\\n{T}：加{1}到你的法术力池中。\', \'type\': \'神器地\', \'flavor\': \'玄铁所建之物，不受战事侵袭，不留岁月痕迹。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389816&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9615ba52-12e7-4251-a0ef-2a20027786f5\', \'multiverseId\': 389816}, \'multiverseid\': 389816}]', '[{\'name\': \'Nahiri die Lithomagierin\', \'text\': \'+2: Bringe einen 1/1 weißen (Kor, Soldat)-Kreaturenspielstein ins Spiel. Du kannst eine Ausrüstung, die du kontrollierst, an ihn anlegen.\\n−2: Du kannst eine Ausrüstung-Karte aus deiner Hand oder deinem Friedhof ins Spiel bringen.\\n−10: Bringe einen farblosen Ausrüstung-Artefaktspielstein namens Steingeschmiedete Klinge ins Spiel. Er hat Unzerstörbarkeit, „Die ausgerüstete Kreatur erhält +5/+5 und hat Doppelschlag" und Ausrüsten {0}.\\nNahiri die Lithomagierin kann dein Kommandeur sein.\', \'type\': \'Planeswalker — Nahiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390286&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'12f37a9a-fd78-46aa-9ac7-30b6ae9f51e8\', \'multiverseId\': 390286}, \'multiverseid\': 390286}, {\'name\': \'Nahiri, la litomante\', \'text\': \'+2: Pon en el campo de batalla una ficha de criatura Soldado Kor blanca 1/1. Puedes anexarle un equipo que controlas.\\n−2: Puedes poner en el campo de batalla una carta de equipo de tu mano o cementerio.\\n−10: Pon en el campo de batalla una ficha de artefacto equipo incolora llamada Espada de la fragua de piedra. Tiene la habilidad de indestructible, "La criatura equipada obtiene +5/+5 y tiene la habilidad de dañar dos veces" y la habilidad de equipar {0}.\\nNahiri, la litomante puede ser tu comandante.\', \'type\': \'Planeswalker — Nahiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391634&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1cf99f1-a659-41d0-88b0-5016df454518\', \'multiverseId\': 391634}, \'multiverseid\': 391634}, {\'name\': \'Nahiri, la lithomancienne\', \'text\': "+2 : Mettez sur le champ de bataille un jeton de créature 1/1 blanche Kor et Soldat. Vous pouvez lui attacher un équipement que vous contrôlez.\\n−2 : Vous pouvez mettre sur le champ de bataille une carte d\'équipement depuis votre main ou votre cimetière.\\n−10 : Mettez sur le champ de bataille un jeton d\'artefact incolore Équipement appelé Lame du forgepierre. Il a l\'indestructible, « La créature équipée gagne +5/+5 et a la double initiative » et équipement {0}.\\nNahiri, la lithomancienne peut être votre commandant.", \'type\': \'Planeswalker : Nahiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390623&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26a0dbbf-e7d8-45a6-8135-46d1bb5ad718\', \'multiverseId\': 390623}, \'multiverseid\': 390623}, {\'name\': \'Nahiri, la Litomante\', \'text\': \'+2: Metti sul campo di battaglia una pedina creatura Soldato Kor 1/1 bianca. Puoi assegnarle un Equipaggiamento che controlli.\\n-2: Puoi mettere sul campo di battaglia una carta Equipaggiamento dalla tua mano o dal tuo cimitero.\\n-10: Metti sul campo di battaglia una pedina artefatto Equipaggiamento incolore chiamata Lama Forgiata nella Pietra. Ha indistruttibile, "La creatura equipaggiata prende +5/+5 e ha doppio attacco" ed equipaggiare {0}.\\nNahiri, la Litomante può essere il tuo comandante.\', \'type\': \'Planeswalker — Nahiri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390960&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37807c78-ba85-4130-b6b8-90cbe50454e9\', \'multiverseId\': 390960}, \'multiverseid\': 390960}, {\'name\': \'石術師、ナヒリ\', \'text\': \'＋２：白の１/１のコー・兵士・クリーチャー・トークンを１体戦場に出す。あなたは、それにあなたがコントロールする装備品１つをつけてもよい。\\n－２：あなたは、あなたの手札か墓地にある装備品・カードを１枚戦場に出してもよい。\\n－10：無色の「石鍛冶製の剣」と言う名前の装備品・アーティファクト・トークンを１つ戦場に出す。それは破壊不能と「装備しているクリーチャーは＋５/＋５の修整を受けるとともに二段攻撃を持つ。」と装備{0}を持つ。\\n石術師、ナヒリは統率者として使用できる。\', \'type\': \'プレインズウォーカー — ナヒリ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391297&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ba265d3e-c8de-49b7-9b5d-b852525f629a\', \'multiverseId\': 391297}, \'multiverseid\': 391297}, {\'name\': \'砾岩术士娜希丽\', \'text\': \'+2：将一个1/1白色寇族／士兵衍生生物放进战场。你可以将一个由你操控的武具装备于其上。\\n−2：你可以将一张武具牌从你手上或坟墓场放进战场。\\n−10：将一个名称为锻石砾刃的无色武具衍生神器放进战场。它具有不灭，「佩带此武具的生物得+5/+5且具有连击异能」与佩带{0}。\\n砾岩术士娜希丽可用作指挥官。\', \'type\': \'鹏洛客～娜希丽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389949&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce89ee46-85cf-48f8-9725-9e5fde01b5c5\', \'multiverseId\': 389949}, \'multiverseid\': 389949}]', '[{\'name\': \'Nantuko-Schatten\', \'text\': \'{B}: Der Nantuko-Schatten erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Insekt, Schatten\', \'flavor\': \'In ihrem Leben studieren die Nantuko die Natur, indem sie sie verehren. Im Tod studieren sie die Natur, indem sie sie ausweiden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390287&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab77fb28-4bdc-4397-b8db-728628168c8c\', \'multiverseId\': 390287}, \'multiverseid\': 390287}, {\'name\': \'Sombra nantuko\', \'text\': \'{B}: La Sombra nantuko obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Sombra insecto\', \'flavor\': \'En vida, los nantuko estudian la naturaleza adorándola. En la muerte, la estudian destripándola.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391635&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2b0b3b27-af8d-4592-aeb5-afca215f1b95\', \'multiverseId\': 391635}, \'multiverseid\': 391635}, {\'name\': \'Ombre nantuko\', \'text\': "{B} : L\'Ombre nantuko gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : insecte et ombre\', \'flavor\': "Dans la vie, les nantuko étudient la nature en l\'adorant. Dans la mort, ils l\'étudient en la disséquant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390624&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'84fcb956-fb15-40bb-9c7a-61260305accf\', \'multiverseId\': 390624}, \'multiverseid\': 390624}, {\'name\': \'Ombra di Nantuko\', \'text\': "{B}: L\'Ombra di Nantuko prende +1/+1 fino alla fine del turno.", \'type\': \'Creatura — Ombra Insetto\', \'flavor\': \'In vita, i nantuko studiano la natura onorandola. Nella morte, studiano la natura sventrandola.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'267d199a-9dd1-46c9-b237-70c70f2be56c\', \'multiverseId\': 390961}, \'multiverseid\': 390961}, {\'name\': \'ナントゥーコの影\', \'text\': \'{B}：ターン終了時まで、ナントゥーコの影は＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 昆虫・シェイド\', \'flavor\': \'生あるとき、ナントゥーコは崇めることで自然を学ぶ。死せるとき、彼らは臓物を引き抜くことで自然を学ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391298&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ade3ceb0-df51-4ed3-9870-1cb71fb8cf9f\', \'multiverseId\': 391298}, \'multiverseid\': 391298}, {\'name\': \'螳人阴魂\', \'text\': \'{B}：螳人阴魂得+1/+1直到回合结束。\', \'type\': \'生物～昆虫／阴魂\', \'flavor\': \'螳人生时靠着崇敬自然来研究它。他们死后藉由开膛剖腹来研究它。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389950&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d8743915-0204-4691-b457-d13ed9ffc615\', \'multiverseId\': 389950}, \'multiverseid\': 389950}]', '[{\'name\': \'Nebelbank\', \'text\': \'Verteidiger, Fliegend\\nVerhindere allen Kampfschaden, der der Nebelbank zugefügt und von ihr zugefügt würde.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'„Die Vereinigung von Meer und Himmel bildet die perfekte Deckung." —Talrand der Himmelsbeschwörer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390196&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04ba704f-7c33-4a3a-9570-687969808241\', \'multiverseId\': 390196}, \'multiverseid\': 390196}, {\'name\': \'Banco de niebla\', \'text\': \'Defensor, vuela.\\nPrevén todo el daño de combate que fuera a hacer y que se le fuera a hacer al Banco de niebla.\', \'type\': \'Criatura — Muro\', \'flavor\': \'"La unión entre el cielo y el mar es el escondite perfecto". —Talrand, invocador celeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391544&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24d96ec7-6758-4f29-9409-75ec6b829c5c\', \'multiverseId\': 391544}, \'multiverseid\': 391544}, {\'name\': \'Banc de brouillard\', \'text\': \'Défenseur, vol\\nPrévenez toutes les blessures de combat qui devraient être infligées à et par le Banc de brouillard.\', \'type\': \'Créature : mur\', \'flavor\': "« L\'union de la mer et du ciel fournit une couverture parfaite. » —Talrand, invocateur céleste", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390533&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe852306-9402-4750-aa9c-0d5f9a636257\', \'multiverseId\': 390533}, \'multiverseid\': 390533}, {\'name\': \'Banco di Nebbia\', \'text\': \'Difensore, volare\\nPrevieni tutto il danno da combattimento che verrebbe inflitto al e dal Banco di Nebbia.\', \'type\': \'Creatura — Muro\', \'flavor\': \'"L\\\'unione di mari e cieli crea il riparo perfetto." —Talrand, evocatore celeste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390870&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73fd3d38-7092-4754-8a26-c1c9c35a4d33\', \'multiverseId\': 390870}, \'multiverseid\': 390870}, {\'name\': \'濃霧の層\', \'text\': \'防衛、飛行\\n濃霧の層に与えられるすべての戦闘ダメージと濃霧の層が与えるすべての戦闘ダメージを軽減する。\', \'type\': \'クリーチャー — 壁\', \'flavor\': \'「海と空とが溶け合えば理想的な防壁となる。」 ――空召喚士ターランド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391207&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2bd4b7a-3aa5-44d8-8ff3-b1c8a756520a\', \'multiverseId\': 391207}, \'multiverseid\': 391207}, {\'name\': \'浓雾堤防\', \'text\': \'守军，飞行\\n防止浓雾堤防将受到与造成的所有战斗伤害。\', \'type\': \'生物～墙\', \'flavor\': \'「海天交融，为我们提供了完美庇护。」 ～空召师陶岚\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389859&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b339620d-5c94-451d-8a15-6d4c7711b137\', \'multiverseId\': 389859}, \'multiverseid\': 389859}]', '[{\'name\': \'Nekrataal\', \'text\': \'Erstschlag\\nWenn der Nekrataal ins Spiel kommt, zerstöre eine nichtschwarze Nichtartefaktkreatur deiner Wahl. Diese Kreatur kann nicht regeneriert werden.\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': \'Seine Opfer haben keine Zeit mehr, verzweifelt zu sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390289&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd6e8fdc-cb54-40bc-9d8a-3203975b8b5d\', \'multiverseId\': 390289}, \'multiverseid\': 390289}, {\'name\': \'Nekrataal\', \'text\': \'Daña primero.\\nCuando el Nekrataal entre al campo de batalla, destruye la criatura objetivo que no sea artefacto y que no sea negra. Esa criatura no puede ser regenerada.\', \'type\': \'Criatura — Asesino humano\', \'flavor\': \'Sus víctimas no tienen tiempo de desesperar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391637&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd0a0e44-3cff-48ec-b1cc-39353310263e\', \'multiverseId\': 391637}, \'multiverseid\': 391637}, {\'name\': \'Nékrataal\', \'text\': \'Initiative\\nQuand le Nékrataal arrive sur le champ de bataille, détruisez la créature non-artefact, non-noire ciblée. Cette créature ne peut pas être régénérée.\', \'type\': \'Créature : humain et assassin\', \'flavor\': "Ses victimes n\'ont pas le temps de ressentir le désespoir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390626&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9fca9742-bff9-489b-9a78-9935ce3eafac\', \'multiverseId\': 390626}, \'multiverseid\': 390626}, {\'name\': \'Nekrataal\', \'text\': \'Attacco improvviso\\nQuando il Nekrataal entra nel campo di battaglia, distruggi una creatura non artefatto, non nera bersaglio. Quella creatura non può essere rigenerata.\', \'type\': \'Creatura — Assassino Umano\', \'flavor\': \'Le sue vittime non hanno il tempo di provare disperazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390963&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25eec887-1c6d-4be5-af0a-07cd12b39e79\', \'multiverseId\': 390963}, \'multiverseid\': 390963}, {\'name\': \'ネクラタル\', \'text\': \'先制攻撃\\nネクラタルが戦場に出たとき、アーティファクトでも黒でもないクリーチャー１体を対象とし、それを破壊する。そのクリーチャーは再生できない。\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': \'彼の犠牲者には絶望を感じる時間さえない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391300&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b153440-be5a-4d16-9587-ed60939d981e\', \'multiverseId\': 391300}, \'multiverseid\': 391300}, {\'name\': \'尼可拉塔\', \'text\': \'先攻\\n当尼可拉塔进战场时，消灭目标非神器且非黑色的生物。该生物不能重生。\', \'type\': \'生物～人类／杀手\', \'flavor\': \'其下手目标连感到绝望的时间都没有。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389952&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'22e08c3b-5356-4c4c-ad1a-7e9baaa3497e\', \'multiverseId\': 389952}, \'multiverseid\': 389952}]', '[{\'name\': \'Nekromagische Auslese\', \'text\': \'Zerstöre alle Kreaturen und bringe dann eine Kreaturenkarte, die auf diese Weise auf einen Friedhof gelegt wurde, unter deiner Kontrolle ins Spiel zurück. Sie ist zusätzlich zu ihren anderen Farben und Typen ein schwarzer Zombie. Schicke die Nekromagische Auslese ins Exil.\', \'type\': \'Hexerei\', \'flavor\': \'Er schlurfte aus der Aschewolke und ließ den Knochenhaufen hinter sich, völlig unbeirrt von seinem eigenen Tod.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390288&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9de33499-ba43-4ab5-8c7a-96c54c79bd06\', \'multiverseId\': 390288}, \'multiverseid\': 390288}, {\'name\': \'Selección nigromántica\', \'text\': \'Destruye todas las criaturas, luego regresa al campo de batalla bajo tu control una carta de criatura puesta en un cementerio de esta manera. Es un Zombie negro además de sus otros colores y tipos. Exilia la Selección nigromántica.\', \'type\': \'Conjuro\', \'flavor\': \'Se arrastró entre la nube de cenizas y polvo de hueso, sin ceder al desaliento de su propia extinción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391636&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81a37b9b-bb53-405c-b567-b23fc006bfd3\', \'multiverseId\': 391636}, \'multiverseid\': 391636}, {\'name\': \'Sélection nécromantique\', \'text\': "Détruisez toutes les créatures, puis renvoyez sur le champ de bataille, sous votre contrôle, une carte de créature mise dans un cimetière de cette manière. C\'est un zombie noir en plus de ses autres couleurs et de ses autres types. Exilez la Sélection nécromantique.", \'type\': \'Rituel\', \'flavor\': "Peu découragé par sa propre extinction, il jaillit en titubant du nuage de cendres et de poussières d\'os.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390625&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63bca235-b4d8-451c-a20f-e3f1363a5adb\', \'multiverseId\': 390625}, \'multiverseid\': 390625}, {\'name\': \'Selezione Necromantica\', \'text\': \'Distruggi tutte le creature, poi rimetti sul campo di battaglia sotto il tuo controllo una carta creatura messa in un cimitero in questo modo. È uno Zombie nero in aggiunta ai suoi altri tipi e colori. Esilia la Selezione Necromantica.\', \'type\': \'Stregoneria\', \'flavor\': "Uscì arrancando dalla nuvola di cenere e polvere d\'osso, incurante della propria morte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390962&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'43dca150-fe42-4afc-8f6c-8b59d3ff3d95\', \'multiverseId\': 390962}, \'multiverseid\': 390962}, {\'name\': \'屍術淘汰\', \'text\': \'すべてのクリーチャーを破壊し、その後これにより墓地に置かれたクリーチャー・カードを１枚あなたのコントロール下で戦場に戻す。そのクリーチャーは、他の色やタイプに加えて黒のゾンビでもある。屍術淘汰を追放する。\', \'type\': \'ソーサリー\', \'flavor\': \'それは自らの死滅など意に介さぬがごとく、灰と骨粉の煙の中からよろめき出た。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391299&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6deff853-e069-485d-b7a5-e223d392eb13\', \'multiverseId\': 391299}, \'multiverseid\': 391299}, {\'name\': \'物尽天择\', \'text\': \'消灭所有生物，然后将一张以此法置入坟墓场的生物牌在你的操控下移回战场。它额外具有黑色此颜色与灵俑此类别。放逐物尽天择。\', \'type\': \'法术\', \'flavor\': \'残灰散尽，骨骸落定，它自混沌中蹒跚而出，饶是自身灭绝也未能惊动分毫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389951&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b24da2d-45f5-4e27-9d14-c40d2ce3d0b4\', \'multiverseId\': 389951}, \'multiverseid\': 389951}]', "[{'name': 'Nevinyrrals Wunderscheibe', 'text': 'Nevinyrrals Wunderscheibe kommt getappt ins Spiel.\\n{1}, {T}: Zerstöre alle Artefakte, Kreaturen und Verzauberungen.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390290&type=card', 'language': 'German', 'identifiers': {'scryfallId': '160f1a85-a681-4c77-b5e0-ef157f294a18', 'multiverseId': 390290}, 'multiverseid': 390290}, {'name': 'Disco de Nevinyrral', 'text': 'El Disco de Nevinyrral entra al campo de batalla girado.\\n{1}, {T}: Destruye todos los artefactos, criaturas y encantamientos.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391638&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5171bb32-9777-4e02-8b77-4a0c10728829', 'multiverseId': 391638}, 'multiverseid': 391638}, {'name': 'Disque de Nevinyrral', 'text': 'Le Disque de Nevinyrral arrive sur le champ de bataille engagé.\\n{1}, {T} : Détruisez tous les artefacts, toutes les créatures et tous les enchantements.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390627&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'aac9a197-4125-47e8-b147-1fb30aab02da', 'multiverseId': 390627}, 'multiverseid': 390627}, {'name': 'Disco di Nevinyrral', 'text': 'Il Disco di Nevinyrral entra nel campo di battaglia TAPpato.\\n{1}, {T}: Distruggi tutti gli artefatti, le creature e gli incantesimi.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390964&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dc39db16-a8b5-46c8-9608-014f9271c8a4', 'multiverseId': 390964}, 'multiverseid': 390964}, {'name': 'ネビニラルの円盤', 'text': 'ネビニラルの円盤はタップ状態で戦場に出る。\\n{1}, {T}：すべてのアーティファクトとすべてのクリーチャーとすべてのエンチャントを破壊する。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391301&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c255bdc2-c973-4361-8098-9138d3150780', 'multiverseId': 391301}, 'multiverseid': 391301}, {'name': '妮维亚洛之碟', 'text': '妮维亚洛之碟须横置进战场。\\n{1}，{T}：消灭所有神器，生物和结界。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389953&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '21a3a9e5-456b-4550-8532-cec5e028cc8a', 'multiverseId': 389953}, 'multiverseid': 389953}]", '[{\'name\': \'Ob Nixilis des schwarzen Schwurs\', \'text\': \'+2: Jeder Gegner verliert 1 Lebenspunkt. Du erhältst so viele Lebenspunkte dazu, wie auf diese Weise Lebenspunkte verloren wurden.\\n−2: Bringe einen 5/5 schwarzen Dämon-Kreaturenspielstein mit Flugfähigkeit ins Spiel. Du verlierst 2 Lebenspunkte.\\n−8: Du erhältst ein Emblem mit „{1}{B}, opfere eine Kreatur: Du erhältst X Lebenspunkte dazu und ziehst X Karten, wobei X gleich der Stärke der geopferten Kreatur ist."\\nOb Nixilis des schwarzen Schwurs kann dein Kommandeur sein.\', \'type\': \'Planeswalker — Nixilis\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390292&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3affed40-3a8a-4b4d-a16e-23e86dd9d48d\', \'multiverseId\': 390292}, \'multiverseid\': 390292}, {\'name\': \'Ob Nixilis del juramento sombrío\', \'text\': \'+2: Cada oponente pierde 1 vida. Ganas una cantidad de vidas igual a las vidas perdidas de esta manera.\\n-2: Pon en el campo de batalla una ficha de criatura Demonio negra 5/5 con la habilidad de volar. Pierdes 2 vidas.\\n-8: Obtienes un emblema con "{1}{B}, sacrificar una criatura: Ganas X vidas y robas X cartas, donde X es la fuerza de la criatura sacrificada".\\nOb Nixilis del juramento sombrío puede ser tu comandante.\', \'type\': \'Planeswalker — Nixilis\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391640&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e03d8b9-d5ee-4e56-8ee3-1432192f57d1\', \'multiverseId\': 391640}, \'multiverseid\': 391640}, {\'name\': \'Ob Nixilis du Sombre Serment\', \'text\': \'+2 : Chaque adversaire perd 1 point de vie. Vous gagnez autant de points de vie que ceux perdus de cette manière.\\n−2 : Mettez sur le champ de bataille un jeton de créature 5/5 noire Démon avec le vol. Vous perdez 2 points de vie.\\n−8 : Vous gagnez un emblème avec « {1}{B}, sacrifiez une créature : Vous gagnez X points de vie et piochez X cartes, X étant la force de la créature sacrifiée. »\\nOb Nixilis du Sombre Serment peut être votre commandant.\', \'type\': \'Planeswalker : Nixilis\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390629&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f1d8b8be-3a9d-4e62-89d4-2163270934d0\', \'multiverseId\': 390629}, \'multiverseid\': 390629}, {\'name\': \'Ob Nixilis del Giuramento Nero\', \'text\': \'+2: Ogni avversario perde 1 punto vita. Guadagni punti vita pari ai punti vita persi in questo modo.\\n-2: Metti sul campo di battaglia una pedina creatura Demone 5/5 nera con volare. Perdi 2 punti vita.\\n-8: Ottieni un emblema con "{1}{B}, Sacrifica una creatura: Guadagni X punti vita e peschi X carte, dove X è la forza della creatura sacrificata".\\nOb Nixilis del Giuramento Nero può essere il tuo comandante.\', \'type\': \'Planeswalker — Nixilis\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390966&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c36ad718-31af-4f24-aa32-b5d26467b6b6\', \'multiverseId\': 390966}, \'multiverseid\': 390966}, {\'name\': \'黒き誓約、オブ・ニクシリス\', \'text\': \'＋２：各対戦相手はそれぞれ１点のライフを失う。あなたはこれにより失われたライフに等しい点数のライフを得る。\\n－２：飛行を持つ黒の５/５のデーモン・クリーチャー・トークンを１体戦場に出す。あなたは２点のライフを失う。\\n－８：あなたは「{1}{B}, クリーチャーを１体生け贄に捧げる：あなたはＸ点のライフを得て、カードをＸ枚引く。Ｘはその生け贄に捧げられたクリーチャーのパワーに等しい。」を持つ紋章を得る。\\n黒き誓約、オブ・ニクシリスは統率者として使用できる。\', \'type\': \'プレインズウォーカー — ニクシリス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391303&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'561b15c8-8495-4514-a68e-baaa17427c4d\', \'multiverseId\': 391303}, \'multiverseid\': 391303}, {\'name\': \'黯约者欧尼希兹\', \'text\': \'+2：每位对手各失去1点生命。你获得若干生命，其数量等同于以此法失去的生命总和。\\n−2：将一个5/5黑色，具飞行异能的恶魔衍生生物放进战场。你失去2点生命。\\n−8：你获得具有「{1}{B}，牺牲一个生物：你获得X点生命且抓X张牌，X为所牺牲生物的力量」的徽记。\\n黯约者欧尼希兹可用作指挥官。\', \'type\': \'鹏洛客～尼希兹\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389955&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e2448bf-a885-44e0-9e63-d856695f6147\', \'multiverseId\': 389955}, \'multiverseid\': 389955}]', '[{\'name\': \'Opfergabe\', \'text\': \'Der Besitzer einer bleibenden Karte deiner Wahl, die kein Land ist, mischt diese in seine Bibliothek und zieht dann zwei Karten.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ein reicheres Volk könnte zwar mehr geben, aber nie genug."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390293&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b528c14-8510-4879-a488-602fa509a471\', \'multiverseId\': 390293}, \'multiverseid\': 390293}, {\'name\': \'Oblación\', \'text\': \'El propietario del permanente objetivo que no sea tierra lo baraja en su biblioteca, luego roba dos cartas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Un pueblo más rico podría dar más, pero nunca podría dar tanto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391641&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e12ecce4-8618-4cde-92d2-51327b4d83a4\', \'multiverseId\': 391641}, \'multiverseid\': 391641}, {\'name\': \'Oblation\', \'text\': \'Le propriétaire du permanent non-terrain ciblé le mélange à sa bibliothèque et pioche ensuite deux cartes.\', \'type\': \'Éphémère\', \'flavor\': \'« Un peuple plus riche pourrait donner plus, mais il ne donnerait jamais autant de lui-même. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390630&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5868991f-c256-43f5-b765-655da3838d57\', \'multiverseId\': 390630}, \'multiverseid\': 390630}, {\'name\': \'Obolo\', \'text\': \'Il proprietario di un permanente non terra bersaglio lo rimescola nel suo grimorio, poi pesca due carte.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le persone più ricche possono dare di più, ma non potranno mai dare così tanto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390967&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa91d885-98e5-427b-92cb-4be275998508\', \'multiverseId\': 390967}, \'multiverseid\': 390967}, {\'name\': \'奉納\', \'text\': \'土地でないパーマネント１つを対象とする。それのオーナーは、それを自分のライブラリーに加えて切り直し、その後カードを２枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「裕福な人ほどより多く出せるはずなのに、人並みに出すことさえしない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391304&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dbcc1fab-c497-461f-a8da-68c0cf0e6592\', \'multiverseId\': 391304}, \'multiverseid\': 391304}, {\'name\': \'奉献\', \'text\': \'目标非地永久物的拥有者将它洗入其牌库，然后抓两张牌。\', \'type\': \'瞬间\', \'flavor\': \'「富人能给得更多，但永无法如此慷慨。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389956&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b61fbf2c-9eee-42f6-ac75-744d5fd8462e\', \'multiverseId\': 389956}, \'multiverseid\': 389956}]', '[{\'name\': \'Orakel aus Seetor\', \'text\': \'Wenn das Orakel aus Seetor ins Spiel kommt, schaue dir die obersten beiden Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege die andere unter deine Bibliothek.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Der geheime Eingang sollte ganz in der Nähe sein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390338&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'32a03085-17fc-4566-ae9f-049d3de2b6c4\', \'multiverseId\': 390338}, \'multiverseid\': 390338}, {\'name\': \'Oráculo de Portal Marino\', \'text\': \'Cuando el Oráculo de Portal Marino entre al campo de batalla, mira las dos primeras cartas de tu biblioteca. Pon una de ellas en tu mano y la otra en el fondo de tu biblioteca.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"La entrada secreta debería estar cerca."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391686&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a5a7012-0964-468b-a031-e966663c922c\', \'multiverseId\': 391686}, \'multiverseid\': 391686}, {\'name\': \'Oracle de Porte des Mers\', \'text\': "Quand l\'Oracle de Porte des Mers arrive sur le champ de bataille, regardez les deux cartes du dessus de votre bibliothèque. Mettez l\'une d\'elles dans votre main et l\'autre au-dessous de votre bibliothèque.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« L\'entrée secrète ne devrait pas être loin. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390675&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c7a3498b-18c3-4d53-b5e5-cfe2824608e2\', \'multiverseId\': 390675}, \'multiverseid\': 390675}, {\'name\': \'Oracolo di Portale Marino\', \'text\': "Quando l\'Oracolo di Portale Marino entra nel campo di battaglia, guarda le prime due carte del tuo grimorio. Aggiungi una di quelle carte alla tua mano e metti l\'altra in fondo al tuo grimorio.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"L\\\'entrata segreta dovrebbe essere vicina."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391012&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2b215f04-dea3-44fc-a181-dbd42140afaa\', \'multiverseId\': 391012}, \'multiverseid\': 391012}, {\'name\': \'海門の神官\', \'text\': \'海門の神官が戦場に出たとき、あなたのライブラリーの一番上から２枚のカードを見る。そのうち１枚をあなたの手札に加え、もう１枚をあなたのライブラリーの一番下に置く。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「秘密の入り口は近くにあるはずだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391349&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'221b1353-9589-44be-bd82-0759cd19c790\', \'multiverseId\': 391349}, \'multiverseid\': 391349}, {\'name\': \'海户先知\', \'text\': \'当海户先知进战场时，检视你牌库顶的两张牌。将其中一张置于你手上，另一张置于你的牌库底。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「秘密入口应该就在附近。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390001&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5e8b6184-4dc7-448d-81bb-f990cb2f0002\', \'multiverseId\': 390001}, \'multiverseid\': 390001}]', "[{'name': 'Oran-Rief, das Riesenholz', 'text': 'Oran-Rief, das Riesenholz, kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}.\\n{T}: Lege auf jede grüne Kreatur, die in diesem Zug ins Spiel gekommen ist, eine +1/+1-Marke.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390294&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a8695d0e-e379-44c6-9fc6-8a6e3edbb0a3', 'multiverseId': 390294}, 'multiverseid': 390294}, {'name': 'Oran-Rief, el Bosque Extenso', 'text': 'Oran-Rief, el Bosque Extenso entra al campo de batalla girado.\\n{T}: Agrega {G} a tu reserva de maná.\\n{T}: Pon un contador +1/+1 sobre cada criatura verde que entró al campo de batalla este turno.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391642&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '23ab7692-46fa-48d5-9eff-6fd91ddc48a5', 'multiverseId': 391642}, 'multiverseid': 391642}, {'name': 'Oran-Rief, le Vastebois', 'text': 'Oran-Rief, le Vastebois arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G} à votre réserve.\\n{T} : Mettez un marqueur +1/+1 sur chaque créature verte qui est arrivée sur le champ de bataille ce tour-ci.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390631&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ce087a73-a417-404d-aeeb-299a5d236397', 'multiverseId': 390631}, 'multiverseid': 390631}, {'name': 'Oran-Rief, il Boscovasto', 'text': 'Oran-Rief, il Boscovasto entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} alla tua riserva di mana.\\n{T}: Metti un segnalino +1/+1 su ogni creatura verde che è entrata nel campo di battaglia in questo turno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390968&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '52f4acde-3152-41c9-9caf-f6b289dee6ac', 'multiverseId': 390968}, 'multiverseid': 390968}, {'name': '巨森、オラン＝リーフ', 'text': '巨森、オラン＝リーフはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}を加える。\\n{T}：このターンに戦場に出た緑の各クリーチャーの上に、それぞれ＋１/＋１カウンターを１個置く。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391305&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7f09324c-d563-4377-abc1-d8eab71a9c43', 'multiverseId': 391305}, 'multiverseid': 391305}, {'name': '广林欧兰黎', 'text': '广林欧兰黎须横置进战场。\\n{T}：加{G}到你的法术力池中。\\n{T}：在每个本回合进战场的绿色生物上各放置一个+1/+1指示物。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389957&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9090b8f0-e6ff-4e9e-8d34-37838e5fe896', 'multiverseId': 389957}, 'multiverseid': 389957}]", "[{'name': 'Palladiummyr', 'text': '{T}: Erhöhe deinen Manavorrat um {2}.', 'type': 'Artefaktkreatur — Myr', 'flavor': 'Die Myr sind wie die Glimmerleere: leere Leinwände, auf denen man große Kunstwerke schaffen könnte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390298&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5f8ecc3b-67e1-494d-8885-e5c5ef3e5b94', 'multiverseId': 390298}, 'multiverseid': 390298}, {'name': 'Myr de paladio', 'text': '{T}: Agrega {2} a tu reserva de maná.', 'type': 'Criatura artefacto — Myr', 'flavor': 'Los myr son como el Campo Resplandeciente: lienzos en blanco sobre los que dibujar grandes creaciones.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391646&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b7089ee0-d6d3-4a15-87ac-16471afef9c2', 'multiverseId': 391646}, 'multiverseid': 391646}, {'name': 'Myr de palladium', 'text': '{T} : Ajoutez {2} à votre réserve.', 'type': 'Créature-artefact : myr', 'flavor': 'Les myrs sont comme le Vide Rayonnant : une toile vierge sur laquelle on peut peindre de grandes créations.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390635&type=card', 'language': 'French', 'identifiers': {'scryfallId': '84a620ee-2e79-4216-8a82-da24a4cfbf0e', 'multiverseId': 390635}, 'multiverseid': 390635}, {'name': 'Myr di Palladio', 'text': '{T}: Aggiungi {2} alla tua riserva di mana.', 'type': 'Creatura Artefatto — Myr', 'flavor': 'I myr sono come il Nulla Scintillante: tele bianche su cui dare vita a grandi creazioni.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390972&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b846ad84-fd99-4573-a605-7c27de270a8f', 'multiverseId': 390972}, 'multiverseid': 390972}, {'name': 'パラジウムのマイア', 'text': '{T}：あなたのマナ・プールに{2}を加える。', 'type': 'アーティファクト・クリーチャー — マイア', 'flavor': 'マイアは空僻地のようなものだ。それは素晴らしい創造を成すための真っ白なキャンバスなのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391309&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '67abf38e-5b55-4e77-bd31-e5f6bcf0b4e0', 'multiverseId': 391309}, 'multiverseid': 391309}, {'name': '钯秘耳', 'text': '{T}：加{2}到你的法术力池中。', 'type': '神器生物～秘耳', 'flavor': '此秘耳一如烁光荒野：一片空白的画布，却将用来建构伟大的造物。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389961&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9c672a45-9514-4e36-8819-bbea46a84bdf', 'multiverseId': 389961}, 'multiverseid': 389961}]", "[{'name': 'Panik-Spruchbombe', 'text': '{T}, opfere die Panik-Spruchbombe: Eine Kreatur deiner Wahl kann in diesem Zug nicht blocken.\\nWenn die Panik-Spruchbombe aus dem Spiel auf einen Friedhof gelegt wird, kannst du {R} bezahlen. Falls du dies tust, ziehe eine Karte.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390299&type=card', 'language': 'German', 'identifiers': {'scryfallId': '454807b7-f7e1-4aa8-b41f-acf48897105b', 'multiverseId': 390299}, 'multiverseid': 390299}, {'name': 'Bombahechizo del pánico', 'text': '{T}, sacrificar la Bombahechizo del pánico: La criatura objetivo no puede bloquear este turno.\\nCuando la Bombahechizo del pánico vaya a un cementerio desde el campo de batalla, puedes pagar {R}. Si lo haces, roba una carta.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391647&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8577403c-af50-44fa-b057-99754886848b', 'multiverseId': 391647}, 'multiverseid': 391647}, {'name': 'Bombe à sortilèges de panique', 'text': '{T}, sacrifiez la Bombe à sortilèges de panique : La créature ciblée ne peut pas bloquer ce tour-ci.\\nQuand la Bombe à sortilèges de panique est mise dans un cimetière depuis le champ de bataille, vous pouvez payer {R}. Si vous faites ainsi, piochez une carte.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390636&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3b8b5c0d-6383-4c9c-901b-c16dda5388c5', 'multiverseId': 390636}, 'multiverseid': 390636}, {'name': 'Bombarcana del Panico', 'text': '{T}, Sacrifica la Bombarcana del Panico: Una creatura bersaglio non può bloccare in questo turno.\\nQuando la Bombarcana del Panico viene messa in un cimitero dal campo di battaglia, puoi pagare {R}. Se lo fai, pesca una carta.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390973&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3c733211-db32-4100-9e9f-e69ce7dae0fc', 'multiverseId': 390973}, 'multiverseid': 390973}, {'name': '恐慌の呪文爆弾', 'text': '{T}, 恐慌の呪文爆弾を生け贄に捧げる：クリーチャー１体を対象とする。このターン、それではブロックできない。\\n恐慌の呪文爆弾が戦場から墓地に置かれたとき、あなたは{R}を支払ってもよい。そうしたなら、カードを１枚引く。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391310&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd9cbad3c-6e30-4219-b8bb-24911463ed32', 'multiverseId': 391310}, 'multiverseid': 391310}, {'name': '惊慌咒击弹', 'text': '{T}，牺牲惊慌咒击弹：目标生物本回合不能进行阻挡。\\n当惊慌咒击弹从战场进入坟墓场时，你可以支付{R}。若你如此作，则抓一张牌。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389962&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4e567449-00f5-4564-b215-912c63788f6f', 'multiverseId': 389962}, 'multiverseid': 389962}]", "[{'name': 'Peitschlodern', 'text': 'Das Peitschlodern fügt jeder Nichtartefaktkreatur 2 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Die Schlackenarbeiter verschwendeten keine Zeit, ihren eigenen Flammenpuls zu erschaffen, um das Gebiet von den Unkompleatierten zu säubern.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390418&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0bf1162f-859c-44cb-a614-94001f17680b', 'multiverseId': 390418}, 'multiverseid': 390418}, {'name': 'Llama flagelante', 'text': 'La Llama flagelante hace 2 puntos de daño a cada criatura que no sea artefacto.', 'type': 'Conjuro', 'flavor': 'Los trabajadores de la escoria no tardaron en crear sus propios pulsos de llamas para limpiar el área de los imperfectos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391766&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9af1fecd-b120-4920-a0ac-07631cc19c44', 'multiverseId': 391766}, 'multiverseid': 391766}, {'name': 'Fulgurofouet', 'text': 'Le Fulgurofouet inflige 2 blessures à chaque créature non-artefact.', 'type': 'Rituel', 'flavor': 'Les ouvriers des fourneaux ne perdaient pas de temps à créer leurs propres outils pour écarter les imparachevés.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390755&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b454dd5e-53ce-442a-967e-6dea483badbe', 'multiverseId': 390755}, 'multiverseid': 390755}, {'name': 'Bagliore Sferzante', 'text': 'Il Bagliore Sferzante infligge 2 danni a ogni creatura non artefatto.', 'type': 'Stregoneria', 'flavor': 'Gli operai delle scorie non persero tempo e crearono i loro bagliori pulsanti per ripulire la zona dagli incompleti.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391092&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '02c28b86-ee7a-49b2-97a7-9fbaebb600bf', 'multiverseId': 391092}, 'multiverseid': 391092}, {'name': '鞭打ち炎', 'text': '鞭打ち炎はアーティファクトでない各クリーチャーにそれぞれ２点のダメージを与える。', 'type': 'ソーサリー', 'flavor': '金屑の労働者は、完璧ならざる地を浄化するため、一刻も早く独自の炎を作り出そうとしていた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391429&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b6257184-6c3c-4f74-a480-8914c66369d8', 'multiverseId': 391429}, 'multiverseid': 391429}, {'name': '鞭扫火光', 'text': '鞭扫火光对每个非神器的生物各造成2点伤害。', 'type': '法术', 'flavor': '熔渣工人很快就创出火焰脉动，用来清理未完化者的区域。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390081&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a25438bd-9be5-44e9-89d4-d9f3e1762f34', 'multiverseId': 390081}, 'multiverseid': 390081}]", "[{'name': 'Pentavus', 'text': 'Der Pentavus kommt mit fünf +1/+1-Marken ins Spiel.\\n{1}, entferne eine +1/+1-Marke vom Pentavus: Bringe einen 1/1 farblosen Pentavit-Artefaktkreaturenspielstein mit Flugfähigkeit ins Spiel.\\n{1}, opfere einen Pentavit: Lege eine +1/+1-Marke auf den Pentavus.', 'type': 'Artefaktkreatur — Konstrukt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390301&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ea416b19-92fa-42ed-af76-19a1e84ac796', 'multiverseId': 390301}, 'multiverseid': 390301}, {'name': 'Péntavo', 'text': 'El Péntavo entra al campo de batalla con cinco contadores +1/+1 sobre él.\\n{1}, remover un contador +1/+1 del Péntavo: Pon en el campo de batalla una ficha de criatura artefacto Pentavita incolora 1/1 con la habilidad de volar.\\n{1}, sacrificar un Pentavita: Pon un contador +1/+1 sobre el Péntavo.', 'type': 'Criatura artefacto — Constructo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391649&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0857b247-b252-4968-8325-d469452fd2fd', 'multiverseId': 391649}, 'multiverseid': 391649}, {'name': 'Pentavus', 'text': 'Le Pentavus arrive sur le champ de bataille avec cinq marqueurs +1/+1 sur lui.\\n{1}, retirez un marqueur +1/+1 du Pentavus : Mettez sur le champ de bataille un jeton de créature-artefact 1/1 incolore Pentavite avec le vol.\\n{1}, sacrifiez un pentavite : Mettez un marqueur +1/+1 sur le Pentavus.', 'type': 'Créature-artefact : construction', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390638&type=card', 'language': 'French', 'identifiers': {'scryfallId': '01c4cde9-e7b8-45ae-81e7-77eb49599950', 'multiverseId': 390638}, 'multiverseid': 390638}, {'name': 'Pentavo', 'text': 'Il Pentavo entra nel campo di battaglia con cinque segnalini +1/+1.\\n{1}, Rimuovi un segnalino +1/+1 dal Pentavo: Metti sul campo di battaglia una pedina creatura artefatto Pentavite 1/1 incolore con volare.\\n{1}, Sacrifica un Pentavite: Metti un segnalino +1/+1 sul Pentavo.', 'type': 'Creatura Artefatto — Costrutto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390975&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5266a1cf-62a4-4be0-9a9d-22cfa716a052', 'multiverseId': 390975}, 'multiverseid': 390975}, {'name': 'ペンタバス', 'text': 'ペンタバスは、＋１/＋１カウンターが５個置かれた状態で戦場に出る。\\n{1}, ペンタバスの上から＋１/＋１カウンターを１個取り除く：飛行を持つ無色の１/１のペンタバイト・アーティファクト・クリーチャー・トークンを１体戦場に出す。\\n{1}, ペンタバイトを１体生け贄に捧げる：ペンタバスの上に＋１/＋１カウンターを１個置く。', 'type': 'アーティファクト・クリーチャー — 構築物', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391312&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f988a088-9e52-48e0-b01b-03d3b16772c2', 'multiverseId': 391312}, 'multiverseid': 391312}, {'name': '五节兽', 'text': '五节兽进战场时上面有五个+1/+1指示物。\\n{1}，从五节兽上移去一个+1/+1指示物：将一个1/1无色，具飞行异能的分节衍生神器生物放进战场。\\n{1}，牺牲一个分节：在五节兽上放置一个+1/+1指示物。', 'type': '神器生物～组构体', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389964&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b2166b21-fd5f-4180-ac4c-9f58d1d52538', 'multiverseId': 389964}, 'multiverseid': 389964}]", "[{'name': 'Perlenmedaillon', 'text': 'Weiße Zaubersprüche, die du wirkst, kosten beim Wirken {1} weniger.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390300&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7622038f-9ebd-4139-b0fa-fb6dbd4f9d74', 'multiverseId': 390300}, 'multiverseid': 390300}, {'name': 'Medallón de perlas', 'text': 'Te cuesta {1} menos lanzar los hechizos blancos.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391648&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '791b12ed-7818-4141-ade9-427505d237e4', 'multiverseId': 391648}, 'multiverseid': 391648}, {'name': 'Médaillon de perle', 'text': 'Les sorts blancs que vous lancez coûtent {1} de moins à lancer.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390637&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ded054f6-914a-4e76-ad36-762efaf14b27', 'multiverseId': 390637}, 'multiverseid': 390637}, {'name': 'Medaglione di Perla', 'text': 'Le magie bianche che lanci costano {1} in meno per essere lanciate.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390974&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a990705a-d10e-4db1-9971-973adc096108', 'multiverseId': 390974}, 'multiverseid': 390974}, {'name': '真珠の大メダル', 'text': 'あなたが唱える白の呪文を唱えるためのコストは{1}少なくなる。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391311&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f26d6a32-1502-461b-bd01-4fba258b6844', 'multiverseId': 391311}, 'multiverseid': 391311}, {'name': '珍珠徽章', 'text': '你施放的白色咒语减少{1}来施放。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389963&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8fccb9df-b501-4904-acd9-691ff7a0a323', 'multiverseId': 389963}, 'multiverseid': 389963}]", '[{\'name\': \'Pestilenzdämon\', \'text\': \'Fliegend\\n{B}: Der Pestilenzdämon fügt jeder Kreatur und jedem Spieler 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Dämon\', \'flavor\': \'„Ich habe zu lange intrigiert, um mich einfach von toten Göttern vertreiben zu lassen. Falls ich diese Welt nicht haben kann, dann kann das niemand."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390302&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b826d5e1-3f61-4e26-9153-9dbaede27033\', \'multiverseId\': 390302}, \'multiverseid\': 390302}, {\'name\': \'Demonio de la pestilencia\', \'text\': \'Vuela.\\n{B}: El Demonio de la pestilencia hace 1 punto de daño a cada criatura y a cada jugador.\', \'type\': \'Criatura — Demonio\', \'flavor\': \'"He planeado demasiado para ser suplantado por dioses muertos. Si yo no puedo dominar este mundo, nadie puede."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391650&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'91fde003-13dc-4678-a06d-733748cc2adf\', \'multiverseId\': 391650}, \'multiverseid\': 391650}, {\'name\': \'Démon de pestilence\', \'text\': \'Vol\\n{B} : Le Démon de pestilence inflige 1 blessure à chaque créature et à chaque joueur.\', \'type\': \'Créature : démon\', \'flavor\': "« J\'ai comploté pendant trop longtemps pour être remplacé par des dieux morts. Si ce monde ne peut m\'appartenir, personne ne l\'aura. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390639&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5dc7e07-1d50-4fa9-9116-cecd08361921\', \'multiverseId\': 390639}, \'multiverseid\': 390639}, {\'name\': \'Demone Pestilenziale\', \'text\': \'Volare\\n{B}: Il Demone Pestilenziale infligge 1 danno a ogni creatura e a ogni giocatore.\', \'type\': \'Creatura — Demone\', \'flavor\': \'"Ho complottato troppo a lungo per essere rimpiazzato da divinità morte. Se non posso avere questo mondo, nessun altro può."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390976&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0ede030d-a0cc-4cc5-9f42-dcb8c61d803f\', \'multiverseId\': 390976}, \'multiverseid\': 390976}, {\'name\': \'黒死病の悪魔\', \'text\': \'飛行\\n{B}：黒死病の悪魔は各クリーチャーと各プレイヤーにそれぞれ１点のダメージを与える。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': \'「我は死の神の策謀に、長くその座を奪われていた。我が手に入らぬ世界なら、誰の手にも入れぬ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391313&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'312e99ac-c17f-454c-8cbb-eb8163f2c2d5\', \'multiverseId\': 391313}, \'multiverseid\': 391313}, {\'name\': \'瘟疫恶魔\', \'text\': \'飞行\\n{B}：瘟疫恶魔对每个生物和每位牌手各造成1点伤害。\', \'type\': \'生物～恶魔\', \'flavor\': \'「我算计得如此久远，死亡之神绝对赶不走我。如果连我都拿不下这世界，也没人能拿得下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dfa9f830-1f15-43b6-8155-ac4681902057\', \'multiverseId\': 389965}, \'multiverseid\': 389965}]', '[{\'name\': \'Phyrexianischer Einverleiber\', \'text\': \'Einprägen — Wenn der Phyrexianische Einverleiber ins Spiel kommt, kannst du eine Nichtspielsteinkreatur deiner Wahl ins Exil schicken.\\nDer Phyrexianische Einverleiber erhält +X/+Y, wobei X die Stärke und Y die Widerstandskraft der ins Exil geschickten Kreaturenkarte ist.\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390305&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'827548f8-0db4-4d1d-b4c9-6f3d1c5a442e\', \'multiverseId\': 390305}, \'multiverseid\': 390305}, {\'name\': \'Engullidor pirexiano\', \'text\': \'Estampa — Cuando el Engullidor pirexiano entre al campo de batalla, puedes exiliar la criatura objetivo que no sea ficha.\\nEl Engullidor pirexiano obtiene +X/+Y, donde X es la fuerza e Y la resistencia de la carta de criatura exiliada.\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391653&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cdbbfb4e-03db-4ff9-904b-362276016d44\', \'multiverseId\': 391653}, \'multiverseid\': 391653}, {\'name\': \'Ingurgitateur phyrexian\', \'text\': "Empreinte — Quand l\'Ingurgitateur phyrexian arrive sur le champ de bataille, vous pouvez exiler une créature non-jeton ciblée.\\nL\'Ingurgitateur phyrexian gagne +X/+Y, X étant la force de la carte de créature exilée et Y, son endurance.", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390642&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90a3b56a-ab2b-4bae-81f7-c742336c57e1\', \'multiverseId\': 390642}, \'multiverseid\': 390642}, {\'name\': \'Ingeritore di Phyrexia\', \'text\': "Imprimere — Quando l\'Ingeritore di Phyrexia entra nel campo di battaglia, puoi esiliare una creatura non pedina bersaglio.\\nL\'Ingeritore di Phyrexia prende +X/+Y, dove X è la forza della carta creatura esiliata e Y è la sua costituzione.", \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390979&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'524db72a-d0d3-4502-aaa3-f21523ad4cf8\', \'multiverseId\': 390979}, \'multiverseid\': 390979}, {\'name\': \'ファイレクシアの摂取者\', \'text\': \'刻印 ― ファイレクシアの摂取者が戦場に出たとき、トークンでないクリーチャー１体を対象とする。あなたはそれを追放してもよい。\\nファイレクシアの摂取者は＋Ｘ/＋Ｙの修整を受ける。Ｘはその追放されたクリーチャー・カードのパワーに等しく、Ｙはその追放されたクリーチャー・カードのタフネスに等しい。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391316&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'45a833eb-9519-49e1-9faf-cf12c0e36030\', \'multiverseId\': 391316}, \'multiverseid\': 391316}, {\'name\': \'非瑞克西亚摄食兽\', \'text\': \'压印～当非瑞克西亚摄食兽进战场时，你可以放逐目标非衍生物的生物。\\n非瑞克西亚摄食兽得+X/+Y，X为所放逐之生物牌的力量，Y为该牌的防御力。\', \'type\': \'生物～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389968&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d49e5ca0-cc10-40f7-b5cc-768943a310d1\', \'multiverseId\': 389968}, \'multiverseid\': 389968}]', "[{'name': 'Phyrexianischer Gargantua', 'text': 'Wenn der Phyrexianische Gargantua ins Spiel kommt, ziehst du zwei Karten und verlierst 2 Lebenspunkte.', 'type': 'Kreatur — Schrecken', 'flavor': 'Selbst andere Phyrexianer fürchten sich vor dem Gargantua.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390304&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4d0568f5-c192-42e6-b716-86ce890bc88c', 'multiverseId': 390304}, 'multiverseid': 390304}, {'name': 'Gargantúa pirexiano', 'text': 'Cuando el Gargantúa pirexiano entre al campo de batalla, roba dos cartas y pierde 2 vidas.', 'type': 'Criatura — Horror', 'flavor': 'Otros pirexianos tienen pesadillas sobre los gargantúa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391652&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a5b5cd51-2dbd-420e-8d6a-e2d6de6b5d31', 'multiverseId': 391652}, 'multiverseid': 391652}, {'name': 'Gargantua phyrexian', 'text': 'Quand le Gargantua phyrexian arrive sur le champ de bataille, vous piochez deux cartes et vous perdez 2 points de vie.', 'type': 'Créature : horreur', 'flavor': 'Le gargantua donne des cauchemars même aux autres phyrexians.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390641&type=card', 'language': 'French', 'identifiers': {'scryfallId': '16261aaa-fdc3-418f-9844-6b560e95fbd4', 'multiverseId': 390641}, 'multiverseid': 390641}, {'name': 'Gargantua di Phyrexia', 'text': 'Quando il Gargantua di Phyrexia entra nel campo di battaglia, pesca due carte e perdi 2 punti vita.', 'type': 'Creatura — Orrore', 'flavor': 'Gli altri abitanti di Phyrexia incontrano il gargantua nei loro peggiori incubi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390978&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5eab991d-aaf2-4ac4-bd14-d8d0462239c9', 'multiverseId': 390978}, 'multiverseid': 390978}, {'name': 'ファイレクシアのガルガンチュア', 'text': 'ファイレクシアのガルガンチュアが戦場に出たとき、あなたはカードを２枚引き、あなたは２点のライフを失う。', 'type': 'クリーチャー — ホラー', 'flavor': 'ファイレクシア人でさえ、ガルガンチュアの夢にうなされる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391315&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9c1b401f-027e-4fad-8a99-1ba3bec5853a', 'multiverseId': 391315}, 'multiverseid': 391315}, {'name': '非瑞克西亚巨罡兽', 'text': '当非瑞克西亚巨罡兽进战场时，你抓两张牌且失去2点生命。', 'type': '生物～惊惧兽', 'flavor': '其他的非瑞克西亚人，都曾在恶梦中见过这巨兽。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389967&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c2277c2d-1d26-413d-a25c-7180091f9fd4', 'multiverseId': 389967}, 'multiverseid': 389967}]", '[{\'name\': \'Phyrexias Kern\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}, opfere ein Artefakt: Du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Land\', \'flavor\': \'„Also ist selbst das Herz unserer Welt verfallen." —Koth vom Hammerclan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390303&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3d4fefd-bf31-4852-87db-60ee28f4c0e4\', \'multiverseId\': 390303}, \'multiverseid\': 390303}, {\'name\': \'Núcleo de Pirexia\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}, sacrificar un artefacto: Ganas 1 vida.\', \'type\': \'Tierra\', \'flavor\': \'"Así que incluso el corazón de nuestro mundo ha caído." —Koth del Martillo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391651&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb008763-1099-4216-8cd8-2807553e7061\', \'multiverseId\': 391651}, \'multiverseid\': 391651}, {\'name\': \'Noyau de Phyrexia\', \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{1}, {T}, sacrifiez un artefact : Vous gagnez 1 point de vie.\', \'type\': \'Terrain\', \'flavor\': \'« Donc, même le cœur de notre monde a succombé. » —Koth du Marteau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390640&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'530f6de0-c799-4f97-b73f-7689561c7f20\', \'multiverseId\': 390640}, \'multiverseid\': 390640}, {\'name\': \'Nucleo di Phyrexia\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}, Sacrifica un artefatto: Guadagni 1 punto vita.\', \'type\': \'Terra\', \'flavor\': \'"Quindi anche il cuore del nostro mondo ha ceduto." —Koth del Martello\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390977&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8f2f7fac-0323-40e7-8178-08a60ef4c456\', \'multiverseId\': 390977}, \'multiverseid\': 390977}, {\'name\': \'ファイレクシアの核\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}, アーティファクトを１つ生け贄に捧げる：あなたは１点のライフを得る。\', \'type\': \'土地\', \'flavor\': \'「我らの世界の中心すら屈服してしまった。」 ――槌のコス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391314&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3d6a71cf-ae9a-4b8f-a48c-f66bbe83fe13\', \'multiverseId\': 391314}, \'multiverseid\': 391314}, {\'name\': \'非瑞克西亚核心\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}，牺牲一个神器：你获得1点生命。\', \'type\': \'地\', \'flavor\': \'「原来连我们世界的心脏都屈服了。」 ～锤族的寇斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389966&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2604c2cf-cf8c-4cb8-9552-562eda80a42d\', \'multiverseId\': 389966}, \'multiverseid\': 389966}]', '[{\'name\': \'Plötzliche Beeinträchtigung\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche wirken oder Fähigkeiten aktivieren, die keine Manafähigkeiten sind.)\\nBis zum Ende des Zuges verlieren alle Kreaturen, die ein Spieler deiner Wahl kontrolliert, alle Fähigkeiten und haben Basis-Stärke und -Widerstandskraft 0/2.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390372&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60ee6853-94cb-4099-a779-4811ee8d3919\', \'multiverseId\': 390372}, \'multiverseid\': 390372}, {\'name\': \'Despojo súbito\', \'text\': \'Fracción de segundo. (Mientras este hechizo esté en la pila, los jugadores no pueden lanzar hechizos o activar habilidades que no sean habilidades de maná.)\\nHasta el final del turno, las criaturas que controla el jugador objetivo pierden todas sus habilidades y tienen una fuerza y resistencia base de 0/2.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391720&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'795cb170-1213-445a-8941-877ccb4cf2a3\', \'multiverseId\': 391720}, \'multiverseid\': 391720}, {\'name\': \'Déliquescence soudaine\', \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas lancer de sorts ou activer de capacités qui ne sont pas des capacités de mana.)\\nJusqu\'à la fin du tour, les créatures que le joueur ciblé contrôle perdent toutes leurs capacités et ont une force et une endurance de base de 0/2.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390709&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2c77b15f-8125-4e14-9653-50ce26c34bf9\', \'multiverseId\': 390709}, \'multiverseid\': 390709}, {\'name\': \'Deperimento Improvviso\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono lanciare magie o attivare abilità che non siano abilità di mana.)\\nFino alla fine del turno, le creature controllate da un giocatore bersaglio perdono tutte le abilità e hanno forza e costituzione base 0/2.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2fe3bd9-886b-4e94-9a4c-8b3110956609\', \'multiverseId\': 391046}, \'multiverseid\': 391046}, {\'name\': \'突然の俗化\', \'text\': \'刹那（この呪文がスタックにあるかぎり、プレイヤーは呪文を唱えられず、マナ能力でない起動型能力を起動できない。）\\nプレイヤー１人を対象とする。ターン終了時まで、そのプレイヤーがコントロールするクリーチャーはすべての能力を失うとともに基本のパワーとタフネスが０/２となる。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391383&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd39c100-7c91-4ba7-bf3c-e2074b42a03e\', \'multiverseId\': 391383}, \'multiverseid\': 391383}, {\'name\': \'瞬息腐坏\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能施放咒语或起动不是法术力异能的异能。）\\n直到回合结束，由目标牌手操控的生物均失去所有异能，且基础力量与防御力为0/2。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8ed08571-6b53-4b48-9659-1122ab416dc7\', \'multiverseId\': 390035}, \'multiverseid\': 390035}]', '[{\'name\': \'Pontifex der Fäulnis\', \'text\': \'Abnötigen (Immer wenn du einen Zauberspruch wirkst, kannst du {W/B} bezahlen. Falls du dies tust, verliert jeder Gegner 1 Lebenspunkt und du erhältst ebenso viele Lebenspunkte dazu.)\\nAndere Kreaturen, die du kontrollierst, haben Abnötigen. (Hat eine Kreatur mehrfach Abnötigen, wird jedes Vorkommen einzeln ausgelöst.)\', \'type\': \'Kreatur — Zombie, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390313&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'496315cf-601f-4a4c-9c20-934aa657dae6\', \'multiverseId\': 390313}, \'multiverseid\': 390313}, {\'name\': \'Pontífice de desolación\', \'text\': \'Extorsionar. (Siempre que lances un hechizo, puedes pagar {W/B}. Si lo haces, cada oponente pierde 1 vida y tú ganas esa cantidad de vidas.)\\nLas otras criaturas que controlas tienen la habilidad de extorsionar. (Si una criatura tiene varias copias de extorsionar, cada una se dispara por separado.)\', \'type\': \'Criatura — Clérigo zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391661&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e738c0f-f312-462e-a124-7b72403b0f33\', \'multiverseId\': 391661}, \'multiverseid\': 391661}, {\'name\': \'Pontife du fléau\', \'text\': "Extorsion (À chaque fois que vous lancez un sort, vous pouvez payer {W/B}. Si vous faites ainsi, chaque adversaire perd 1 point de vie et vous gagnez autant de points de vie.)\\nLes autres créatures que vous contrôlez ont l\'extorsion. (Si une créature a plusieurs occurrences d\'extorsion, chacune d\'elles se déclenche séparément.)", \'type\': \'Créature : zombie et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390650&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88e14c68-32ee-4cfd-9d4e-8c5ac9de8aae\', \'multiverseId\': 390650}, \'multiverseid\': 390650}, {\'name\': \'Pontefice della Rovina\', \'text\': \'Estorsione (Ogniqualvolta lanci una magia, puoi pagare {W/B}. Se lo fai, ogni avversario perde 1 punto vita e tu guadagni altrettanti punti vita.)\\nLe altre creature che controlli hanno estorsione. (Se una creatura ha più istanze di estorsione, ognuna si innesca separatamente.)\', \'type\': \'Creatura — Chierico Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390987&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4aaef173-d05d-463e-af31-ecb7516d0339\', \'multiverseId\': 390987}, \'multiverseid\': 390987}, {\'name\': \'荒廃の司教\', \'text\': \'強請（あなたが呪文を１つ唱えるたび、あなたは{W/B}を支払ってもよい。そうしたなら、各対戦相手はそれぞれ１点のライフを失い、あなたはその点数分のライフを得る。）\\nあなたがコントロールする他のクリーチャーは強請を持つ。（あるクリーチャーが複数の強請を持っているなら、それぞれ誘発する。）\', \'type\': \'クリーチャー — ゾンビ・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391324&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa4f233c-137a-49c7-9fda-b7b69087d033\', \'multiverseId\': 391324}, \'multiverseid\': 391324}, {\'name\': \'枯萎主教\', \'text\': \'敲诈（每当你施放一个咒语时，你可以支付{W/B}。若你如此作，则每位对手各失去1点生命，且你获得等量的生命。）\\n由你操控的其他生物具有敲诈异能。（若某生物具有数个敲诈异能，则每一个都会分别触发。）\', \'type\': \'生物～灵俑／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389976&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'95b8b5bd-54c6-4f14-8107-0496887a6f1f\', \'multiverseId\': 389976}, \'multiverseid\': 389976}]', "[{'name': 'Purpurdiamant', 'text': 'Der Purpurdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {R}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390191&type=card', 'language': 'German', 'identifiers': {'scryfallId': '895c1ce9-5066-4342-a557-8d5c6d04f11f', 'multiverseId': 390191}, 'multiverseid': 390191}, {'name': 'Diamante flamígero', 'text': 'El Diamante flamígero entra al campo de batalla girado.\\n{T}: Agrega {R} a tu reserva de maná.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391539&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '21e8ab3e-806d-490b-8f74-b22aea9c43e5', 'multiverseId': 391539}, 'multiverseid': 391539}, {'name': 'Diamant du feu', 'text': 'Le Diamant du feu arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {R} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390528&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e6d5f3d2-ea82-4533-b8cd-fa784a2a1e92', 'multiverseId': 390528}, 'multiverseid': 390528}, {'name': 'Diamante del Fuoco', 'text': 'Il Diamante del Fuoco entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {R} alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390865&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '66e7efe8-be27-4bc9-96c5-3520930392b4', 'multiverseId': 390865}, 'multiverseid': 390865}, {'name': '緋色のダイアモンド', 'text': '緋色のダイアモンドはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{R}を加える。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391202&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ac92e231-4200-4f3c-865a-1849b8f7819f', 'multiverseId': 391202}, 'multiverseid': 391202}, {'name': '焰红钻石', 'text': '焰红钻石须横置进战场。\\n{T}：加{R}到你的法术力池中。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389854&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0f7d6844-5f0d-4596-90bf-55fe3faefe66', 'multiverseId': 389854}, 'multiverseid': 389854}]", '[{\'name\': \'Quelle der Inspiration\', \'text\': \'Wenn die Quelle der Inspiration ins Spiel kommt, ziehe zwei Karten.\\nZu Beginn des Ziehsegments jedes anderen Spielers zieht dieser Spieler eine zusätzliche Karte.\\nZiehe zu Beginn deines Ziehsegments zwei zusätzliche Karten.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390416&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f57e187d-c7ab-4aea-b600-931b60f2db52\', \'multiverseId\': 390416}, \'multiverseid\': 390416}, {\'name\': \'Pozo de ideas\', \'text\': \'Cuando el Pozo de ideas entre al campo de batalla, roba dos cartas.\\nAl comienzo del paso de robar de cada uno de los demás jugadores, ese jugador roba una carta adicional.\\nAl comienzo de tu paso de robar, roba dos cartas adicionales.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391764&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebc6d97d-293e-4942-9a0e-202f371ae9c8\', \'multiverseId\': 391764}, \'multiverseid\': 391764}, {\'name\': "Puits d\'idées", \'text\': "Quand le Puits d\'idées arrive sur le champ de bataille, piochez deux cartes.\\nAu début de l\'étape de pioche de chaque autre joueur, ce joueur pioche une carte supplémentaire.\\nAu début de votre étape de pioche, piochez deux cartes supplémentaires.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe1e4f50-2a28-426a-b3d0-c78903bb1f80\', \'multiverseId\': 390753}, \'multiverseid\': 390753}, {\'name\': \'Pozzo delle Idee\', \'text\': "Quando il Pozzo delle Idee entra nel campo di battaglia, pesca due carte.\\nAll\'inizio dell\'acquisizione di ogni altro giocatore, quel giocatore pesca una carta addizionale.\\nAll\'inizio della tua acquisizione, pesca due carte addizionali.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391090&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'068d307a-168f-4a7d-9839-c780bbdc7546\', \'multiverseId\': 391090}, \'multiverseid\': 391090}, {\'name\': \'発想の井戸\', \'text\': \'発想の井戸が戦場に出たとき、カードを２枚引く。\\n他の各プレイヤーのドロー・ステップの開始時に、そのプレイヤーはカードを追加で１枚引く。\\nあなたのドロー・ステップの開始時に、カードを追加で２枚引く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391427&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5a23eed-b1f3-4081-9825-56ceaab8c6a0\', \'multiverseId\': 391427}, \'multiverseid\': 391427}, {\'name\': \'灵感之井\', \'text\': \'当灵感之井进战场时，抓两张牌。\\n在其他每位牌手的抓牌步骤开始时，该牌手额外抓一张牌。\\n在你的抓牌步骤开始时，额外抓两张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390079&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f4f77023-daa3-47d9-91a3-b11626434566\', \'multiverseId\': 390079}, \'multiverseid\': 390079}]', '[{\'name\': \'Quellenrufer\', \'text\': \'{T}: Du erhältst für jeden Elfen im Spiel 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'„Verschließe deine Ohren, wenn die Gier ruft, und du kannst aus einem Geschenk für einen ein Geschenk für viele machen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390417&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b63bd93-3e3b-4871-983e-82c2eb77275f\', \'multiverseId\': 390417}, \'multiverseid\': 390417}, {\'name\': \'Bienhechora\', \'text\': \'{T}: Ganas 1 vida por cada Elfo en el campo de batalla.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'"Cierra tus oídos a la voz de la codicia y podrás convertir un obsequio para uno en un obsequio para muchos".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391765&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'583a7973-9422-4490-9f0e-6ffffa721ba7\', \'multiverseId\': 391765}, \'multiverseid\': 391765}, {\'name\': \'Sibylle des fontaines\', \'text\': \'{T} : Vous gagnez 1 point de vie pour chaque elfe sur le champ de bataille.\', \'type\': \'Créature : elfe\', \'flavor\': "« Cesse d\'écouter la voix de l\'avidité, et d\'un présent qui t\'était destiné tu feras un cadeau pour tous. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390754&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ea1c9d3-b0f0-4188-ad3c-d14ad87c3cd8\', \'multiverseId\': 390754}, \'multiverseid\': 390754}, {\'name\': \'Augure\', \'text\': \'{T}: Guadagni 1 punto vita per ogni Elfo sul campo di battaglia.\', \'type\': \'Creatura — Elfo\', \'flavor\': \'"Chiudi le tue orecchie alla voce della bramosia e potrai trasformare il dono per una persona in un dono per molti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391091&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'20c3cce6-6d47-430b-8056-2536402e530e\', \'multiverseId\': 391091}, \'multiverseid\': 391091}, {\'name\': \'幸運を祈る者\', \'text\': \'{T}：あなたは戦場に出ているエルフ１体につき１点のライフを得る。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': \'「強欲の声に耳を閉ざしなさい。そうすれば、一人への贈り物は皆への贈り物となるのです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391428&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87d4b48a-295a-4191-b415-35157787058c\', \'multiverseId\': 391428}, \'multiverseid\': 391428}, {\'name\': \'美愿祈者\', \'text\': \'{T}：战场上每有一个妖精，你便获得1点生命。\', \'type\': \'生物～妖精\', \'flavor\': \'「不去聆听贪婪之声，你便能将一人之惠化为万人之福。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390080&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52462d3a-9145-484f-a01f-8e38551418d3\', \'multiverseId\': 390080}, \'multiverseid\': 390080}]', '[{\'name\': \'Ranken des Zerfalls\', \'text\': \'Die Ranken des Zerfalls fügen einer Kreatur deiner Wahl X Schadenspunkte zu und du erhältst X Lebenspunkte dazu, wobei X gleich der Anzahl an Sümpfen ist, die du kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Dunkelheit schickt nicht immer ihre Knechte aus, um die dreckige Arbeit zu machen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390388&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c7af61f-44c8-4e13-a426-1979e88a99dc\', \'multiverseId\': 390388}, \'multiverseid\': 390388}, {\'name\': \'Zarcillos de corrupción\', \'text\': \'Los Zarcillos de corrupción hacen X puntos de daño a la criatura objetivo y tú ganas X vidas, donde X es la cantidad de pantanos que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'La oscuridad no siempre envía a sus sicarios a hacer el trabajo sucio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391736&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'037eddc8-b601-4a5c-a95e-a141f1ba89ec\', \'multiverseId\': 391736}, \'multiverseid\': 391736}, {\'name\': \'Vrilles de corruption\', \'text\': \'Les Vrilles de corruption infligent X blessures à une créature ciblée et vous gagnez X points de vie, X étant le nombre de marais que vous contrôlez.\', \'type\': \'Éphémère\', \'flavor\': "Les ténèbres n\'envoient pas toujours leurs serviteurs faire leur sale besogne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390725&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2804a742-3b5b-4097-aeec-717ecb88e072\', \'multiverseId\': 390725}, \'multiverseid\': 390725}, {\'name\': \'Tentacoli della Corruzione\', \'text\': \'I Tentacoli della Corruzione infliggono X danni a una creatura bersaglio e tu guadagni X punti vita, dove X è il numero di Paludi che controlli.\', \'type\': \'Istantaneo\', \'flavor\': "L\'oscurità non manda sempre i suoi scherani a fare il lavoro sporco.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eda25a7c-e026-4769-901c-48019dc1efc8\', \'multiverseId\': 391062}, \'multiverseid\': 391062}, {\'name\': \'堕落の触手\', \'text\': \'クリーチャー１体を対象とする。堕落の触手はそれにＸ点のダメージを与え、あなたはＸ点のライフを得る。Ｘはあなたがコントロールする沼の総数に等しい。\', \'type\': \'インスタント\', \'flavor\': \'闇が穢れた仕事を行うとき、送り込んでくるのは手先ばかりとは限らない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391399&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb00009b-4386-4940-91c4-a3e7aff0c703\', \'multiverseId\': 391399}, \'multiverseid\': 391399}, {\'name\': \'腐化卷须\', \'text\': \'腐化卷须对目标生物造成X点伤害且你获得X点生命，X为由你操控的沼泽数量。\', \'type\': \'瞬间\', \'flavor\': \'黑暗势力不是每次都会派仆役来执行肮脏任务。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390051&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e952dfa-97fe-4aa6-80fc-672b9e8cd173\', \'multiverseId\': 390051}, \'multiverseid\': 390051}]', '[{\'name\': \'Rankengeflecht\', \'text\': \'Verursacht Trampelschaden\\n{1}{G}: Bis zum Ende des Zuges hat eine Kreatur deiner Wahl, die du kontrollierst, Basis-Stärke und -Widerstandskraft 5/5 und verursacht Trampelschaden.\', \'type\': \'Kreatur — Pflanze, Elementarwesen\', \'flavor\': \'„Ich habe die Verwüstung gesehen, als die Juggernauten die Mauern von An Karras zerschmetterten. Das hat mir zu denken gegeben." —Janji, Walddruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390146&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'19c632ea-8ed6-40fb-a9d3-30c95cf59410\', \'multiverseId\': 390146}, \'multiverseid\': 390146}, {\'name\': \'Trepador imponente\', \'text\': \'Arrolla.\\n{1}{G}: Hasta el final del turno, la criatura objetivo que controlas tiene una fuerza y resistencia base de 5/5 y gana la habilidad de arrollar.\', \'type\': \'Criatura — Elemental planta\', \'flavor\': \'"Vi la devastación cuando los destructores derribaron los muros de An Karras. Aquello me hizo pensar". —Janji, druida silvano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391494&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95fe07a8-8ddf-4fa7-96e2-ff6a576ef3c5\', \'multiverseId\': 391494}, \'multiverseid\': 391494}, {\'name\': \'Exovigne\', \'text\': "Piétinement\\n{1}{G} : Jusqu\'à la fin du tour, la créature ciblée que vous contrôlez a une force et une endurance de base de 5/5 et acquiert le piétinement.", \'type\': \'Créature : plante et élémental\', \'flavor\': "« J\'ai vu la dévastation à l\'œuvre quand les djaggernauts ont défoncé les murailles d\'An Karras. Cela m\'a donné matière à réfléchir. » —Janji, druide sylvestre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390483&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cab87930-3b39-4c00-bd29-0e2a07a64221\', \'multiverseId\': 390483}, \'multiverseid\': 390483}, {\'name\': \'Colosso Rampicante\', \'text\': \'Travolgere\\n{1}{G}: Fino alla fine del turno, una creatura bersaglio che controlli ha forza e costituzione base 5/5 e travolgere.\', \'type\': \'Creatura — Elementale Pianta\', \'flavor\': \'"Ho visto la devastazione provocata dai juggernaut che sfondavano le mura di An Karras. È così che mi è venuta l\\\'idea." —Janji, druido silvano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390820&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7798f046-402a-4194-8cfe-a54d5e06245b\', \'multiverseId\': 390820}, \'multiverseid\': 390820}, {\'name\': \'忍び寄る大蔦\', \'text\': \'トランプル\\n{1}{G}：あなたがコントロールするクリーチャー１体を対象とする。ターン終了時まで、それは基本のパワーとタフネスが５/５となるとともにトランプルを得る。\', \'type\': \'クリーチャー — 植物・エレメンタル\', \'flavor\': \'「私は、巨大戦車がアン・カラスの壁を破壊した時にもたらされた荒廃を目の当たりにした。そこでいろいろ考えてみた。」 ――森のドルイド、ジャンジ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391157&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7f71b2e-63cb-4d9f-8524-f945de78c5e5\', \'multiverseId\': 391157}, \'multiverseid\': 391157}, {\'name\': \'匍行巨蔓\', \'text\': \'践踏\\n{1}{G}：直到回合结束，目标由你操控的生物之基础力量与防御力为5/5且获得践踏异能。\', \'type\': \'生物～植物／元素\', \'flavor\': \'「我曾亲眼目睹攻城巨车攻破安喀拉城墙的毁灭情景。我不由得开始思考。」 ～森林德鲁伊晏基\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'46e7cee0-f9b6-46f7-8cfb-bb3402f79f13\', \'multiverseId\': 389809}, \'multiverseid\': 389809}]', '[{\'name\': \'Rat der Prätoren\', \'text\': \'Bringe alle Karten aus deinem Friedhof auf deine Hand zurück. Schicke den Rat der Prätoren ins Exil. Du hast für den Rest der Partie keine maximale Handkartenzahl.\', \'type\': \'Hexerei\', \'flavor\': \'Während die phyrexianische Seuche Karns Körper zersetze, flüsterten die Prätoren Psalme, um seinen Verstand zu korrumpieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390314&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e12f7ff-4fe2-4d61-9b26-f4b337ea440c\', \'multiverseId\': 390314}, \'multiverseid\': 390314}, {\'name\': \'Consejo del magistrado\', \'text\': \'Regresa a tu mano todas las cartas de tu cementerio. Exilia el Consejo del magistrado. Tu mano no tiene tamaño máximo durante el resto del juego.\', \'type\': \'Conjuro\', \'flavor\': \'Mientras la enfermedad pirexiana corrompía el cuerpo de Karn, los magistrados susurraban salmos para corromper su mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391662&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a40dffa-0105-431e-a742-270dcfbd8da9\', \'multiverseId\': 391662}, \'multiverseid\': 391662}, {\'name\': \'Conseil du praetor\', \'text\': "Renvoyez toutes les cartes depuis votre cimetière dans votre main. Exilez le Conseil du praetor. Vous n\'avez plus de limite au nombre de cartes dans votre main pour le restant de la partie.", \'type\': \'Rituel\', \'flavor\': \'Pendant que la contagion phyrexiane corrodait le corps de Karn, les praetors psalmodiaient pour corrompre son esprit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56e84bbb-0b42-4e8c-a48c-1073c333282f\', \'multiverseId\': 390651}, \'multiverseid\': 390651}, {\'name\': \'Consiglio del Pretore\', \'text\': \'Riprendi in mano tutte le carte dal tuo cimitero. Esilia il Consiglio del Pretore. Non hai un limite massimo di carte in mano per il resto della partita.\', \'type\': \'Stregoneria\', \'flavor\': \'Man mano che il contagio di Phyrexia corrodeva il corpo di Karn, i pretori gli sussurravano salmi per corromperne anche la mente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390988&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e55611e-b527-4dbc-aa45-3977555bd35d\', \'multiverseId\': 390988}, \'multiverseid\': 390988}, {\'name\': \'法務官の相談\', \'text\': \'あなたの墓地にあるすべてのカードをあなたの手札に戻す。法務官の相談を追放する。このゲームの残りの間、あなたの手札の上限はなくなる。\', \'type\': \'ソーサリー\', \'flavor\': \'ファイレクシアの病原がカーンの体を蝕む一方、法務官は聖歌を囁き彼の心を蝕んでいった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391325&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb9cdc99-d73e-4f97-993f-fec86b6421d2\', \'multiverseId\': 391325}, \'multiverseid\': 391325}, {\'name\': \'魔判官商议\', \'text\': \'将所有牌从你的坟墓场移回你手上。放逐魔判官商议。在本盘游戏接下来的时段，你的手牌数量没有上限。\', \'type\': \'法术\', \'flavor\': \'非瑞克西亚的传染侵蚀着卡恩的身体，魔判官以赞歌同时腐化其心灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e9c0069d-ad58-4ca5-a649-d7c3721cd123\', \'multiverseId\': 389977}, \'multiverseid\': 389977}]', '[{\'name\': \'Raubvogel, Flaggschiff des Bösen\', \'text\': \'{2}: Eine Kreatur deiner Wahl erhält Flugfähigkeit bis zum Ende des Zuges.\\n{5}, {T}: Zerstöre eine fliegende Kreatur deiner Wahl.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Die Geißel des Wolkenwaldes kommt wieder einmal aus den Lüften." —Das Orakel en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390315&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91a24bfd-b438-4a24-b7c6-5aa76fb52642\', \'multiverseId\': 390315}, \'multiverseid\': 390315}, {\'name\': \'Depredador, buque insignia\', \'text\': \'{2}: La criatura objetivo gana la habilidad de volar hasta el final del turno.\\n{5}, {T}: Destruye la criatura objetivo con la habilidad de volar.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"El azote de Veloceleste vuela de nuevo". —Oráculo en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391663&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'118bd78c-8f27-4227-ac49-3b45ecbc4f7b\', \'multiverseId\': 391663}, \'multiverseid\': 391663}, {\'name\': \'Le prédateur, navire amiral\', \'text\': "{2} : La créature ciblée acquiert le vol jusqu\'à la fin du tour.\\n{5}, {T} : Détruisez la créature avec le vol ciblée.", \'type\': \'Artefact légendaire\', \'flavor\': \'« Si Linciel périt ce sera par les cieux. » —Oracle en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390652&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'531f2f6d-c3f3-4085-8e3f-9110d7135604\', \'multiverseId\': 390652}, \'multiverseid\': 390652}, {\'name\': \'Predatrice, Nave Ammiraglia\', \'text\': \'{2}: Una creatura bersaglio ha volare fino alla fine del turno.\\n{5}, {T}: Distruggi una creatura bersaglio con volare.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'"La dannazione di Cielsudario giunge ancora una volta dall\\\'alto." —Oracolo en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390989&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ceb927ba-8c21-48a5-ae7e-5bac5ac46b37\', \'multiverseId\': 390989}, \'multiverseid\': 390989}, {\'name\': \'旗艦プレデター\', \'text\': \'{2}：クリーチャー１体を対象とする。ターン終了時まで、それは飛行を得る。\\n{5}, {T}：飛行を持つクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'伝説のアーティファクト\', \'flavor\': \'「あのスカイシュラウドの災厄が、また空を飛んでいる。」 ――ヴェクの巫女\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391326&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62235ea0-2d89-4db7-a832-c9c1286aacce\', \'multiverseId\': 391326}, \'multiverseid\': 391326}, {\'name\': \'飞空旗舰掠夺者号\', \'text\': \'{2}：目标生物获得飞行异能直到回合结束。\\n{5}，{T}：消灭目标具飞行异能的生物。\', \'type\': \'传奇神器\', \'flavor\': \'「天帷的苦难之源再度从天而降。」 ～维克族神谕使\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389978&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a61b5d32-6d8a-4797-8ead-8de5db853e53\', \'multiverseId\': 389978}, \'multiverseid\': 389978}]', '[{\'name\': \'Rebellion anzetteln\', \'text\': \'Für jeden Spieler fügt Rebellion anzetteln diesem Spieler und allen Kreaturen, die dieser Spieler kontrolliert, so viele Schadenspunkte zu, wie er Kreaturen kontrolliert.\', \'type\': \'Hexerei\', \'flavor\': \'Nichts vertreibt Langeweile so schnell wie ein guter alter Aufstand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390229&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e2c0153-cc8b-4799-8fc7-52c1e778f24f\', \'multiverseId\': 390229}, \'multiverseid\': 390229}, {\'name\': \'Incitar a la rebelión\', \'text\': \'Por cada jugador, Incitar a la rebelión hace a ese jugador y a cada criatura que controla ese jugador una cantidad de daño igual a la cantidad de criaturas que controla.\', \'type\': \'Conjuro\', \'flavor\': \'Nada rompe la monotonía como un buen disturbio a la antigua usanza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391577&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e136875-c184-45a5-9e5d-c58694ba4c5f\', \'multiverseId\': 391577}, \'multiverseid\': 391577}, {\'name\': \'Incitation à la rébellion\', \'text\': "Pour chaque joueur, l\'Incitation à la rébellion inflige à ce joueur et à chaque créature que ce joueur contrôle un nombre de blessures égal au nombre de créatures qu\'il contrôle.", \'type\': \'Rituel\', \'flavor\': "Pour rompre la monotonie, rien de tel qu\'une bonne vieille émeute.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390566&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6622b036-a854-404b-a843-08e56d7e3217\', \'multiverseId\': 390566}, \'multiverseid\': 390566}, {\'name\': \'Incitare alla Ribellione\', \'text\': \'Per ogni giocatore, Incitare alla Ribellione infligge a quel giocatore e a ogni creatura controllata da quel giocatore danno pari al numero di creature che controlla.\', \'type\': \'Stregoneria\', \'flavor\': \'Niente spezza la monotonia come una buona vecchia sommossa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390903&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fdde10c0-9bdf-44c9-83aa-1fed282cd2b5\', \'multiverseId\': 390903}, \'multiverseid\': 390903}, {\'name\': \'反乱の扇動\', \'text\': \'各プレイヤーにつき、反乱の扇動はそのプレイヤーがコントロールしているクリーチャーの数に等しい点数のダメージをそのプレイヤーとそのプレイヤーがコントロールしている各クリーチャーにそれぞれ与える。\', \'type\': \'ソーサリー\', \'flavor\': \'退屈を破るのには、昔ながらの騒乱が一番だな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391240&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1e57002-8f29-4eb4-92b7-f5b333bdc903\', \'multiverseId\': 391240}, \'multiverseid\': 391240}, {\'name\': \'煽动叛乱\', \'text\': \'对每位牌手而言，煽动叛乱对该牌手和由该牌手操控的每个生物各造成伤害，其数量等同于由他操控的生物数量。\', \'type\': \'法术\', \'flavor\': \'想要打破千篇一律的生活，暴乱这个方法虽最为古老，但也最为有效。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389892&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aff075ac-0f4e-4921-b081-f82f3ed3edad\', \'multiverseId\': 389892}, \'multiverseid\': 389892}]', "[{'name': 'Replikationsritual', 'text': 'Bonus {5} (Du kannst zusätzlich {5} bezahlen, sowie du diesen Zauberspruch wirkst.)\\nBringe einen Spielstein ins Spiel, der eine Kopie einer Kreatur deiner Wahl ist. Falls die Bonuskosten von Replikationsritual bezahlt wurden, bringe stattdessen fünf dieser Spielsteine ins Spiel.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390332&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'db4a093b-96be-4fad-a40c-e2caa5caa035', 'multiverseId': 390332}, 'multiverseid': 390332}, {'name': 'Rito de replicación', 'text': 'Estímulo {5}. (Puedes pagar {5} adicionales al lanzar este hechizo.)\\nPon en el campo de batalla una ficha que es una copia de la criatura objetivo. Si el Rito de replicación fue estimulado, en vez de eso, pon en el campo de batalla cinco de esas fichas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391680&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2a0be1da-c594-4201-9982-2e086a4d13cc', 'multiverseId': 391680}, 'multiverseid': 391680}, {'name': 'Rite de duplication', 'text': 'Kick {5} (Vous pouvez payer {5} supplémentaires au moment où vous lancez ce sort.)\\nMettez sur le champ de bataille un jeton qui est une copie de la créature ciblée. Si le Rite de duplication a été kické, mettez sur le champ de bataille cinq de ces jetons à la place.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390669&type=card', 'language': 'French', 'identifiers': {'scryfallId': '937ff980-f6e7-4b95-bf74-b5c94388ff99', 'multiverseId': 390669}, 'multiverseid': 390669}, {'name': 'Rito di Riproduzione', 'text': 'Potenziamento {5} (Puoi pagare {5} addizionale mentre lanci questa magia.)\\nMetti sul campo di battaglia una pedina che è una copia di una creatura bersaglio. Se il Rito di Riproduzione è stato potenziato, metti invece cinque di quelle pedine sul campo di battaglia.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391006&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1f689e87-e24e-43cc-b35d-3b0be382309a', 'multiverseId': 391006}, 'multiverseid': 391006}, {'name': '複製の儀式', 'text': 'キッカー{5}（あなたはこの呪文を唱えるに際し、追加で{5}を支払ってもよい。）\\nクリーチャー１体を対象とし、それのコピーであるトークンを１体戦場に出す。複製の儀式がキッカーされていたなら、代わりにそのトークンを５体戦場に出す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391343&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '522d678a-9b30-4cf6-9ec5-2014007e77fa', 'multiverseId': 391343}, 'multiverseid': 391343}, {'name': '模造仪式', 'text': '增幅{5}（你可以在施放此咒语时额外支付{5}。）\\n将一个衍生物放进战场，此衍生物为目标生物之复制品。如果模造仪式已增幅，则改为将五个此类衍生物放进战场。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389995&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '945bad67-a262-47bc-bdcc-0536f9843679', 'multiverseId': 389995}, 'multiverseid': 389995}]", '[{\'name\': \'Requiem-Engel\', \'text\': \'Fliegend\\nImmer wenn eine andere Nicht-Geist-Kreatur stirbt, die du kontrollierst, bringe einen 1/1 weißen Geist-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Wenn schon die Engel verzweifeln, wie sollen da noch die Sterblichen hoffen?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390329&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dbf3d764-a0a2-4358-9138-945becc49ea7\', \'multiverseId\': 390329}, \'multiverseid\': 390329}, {\'name\': \'Ángel del réquiem\', \'text\': \'Vuela.\\nSiempre que otra criatura que controlas que no sea Espíritu muera, pon en el campo de batalla una ficha de criatura Espíritu blanca 1/1 con la habilidad de volar.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Cuando los ángeles se desesperan, ¿qué esperanza queda para los mortales?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391677&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e697560-f434-4a82-93e0-669da302116f\', \'multiverseId\': 391677}, \'multiverseid\': 391677}, {\'name\': \'Ange du requiem\', \'text\': "Vol\\nÀ chaque fois qu\'une autre créature non-Esprit que vous contrôlez meurt, mettez sur le champ de bataille un jeton de créature 1/1 blanche Esprit avec le vol.", \'type\': \'Créature : ange\', \'flavor\': \'Quand les anges sont en proie au désespoir, quel espoir reste-t-il pour les mortels ?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1ce0332-dd67-4180-9732-a59b4ed7413b\', \'multiverseId\': 390666}, \'multiverseid\': 390666}, {\'name\': \'Angelo del Requiem\', \'text\': "Volare\\nOgniqualvolta un\'altra creatura non Spirito che controlli muore, metti sul campo di battaglia una pedina creatura Spirito 1/1 bianca con volare.", \'type\': \'Creatura — Angelo\', \'flavor\': \'Quando gli angeli si disperano, quali speranze possono avere i mortali?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391003&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'10c013d1-e1e4-400e-8e7d-f377a0f22239\', \'multiverseId\': 391003}, \'multiverseid\': 391003}, {\'name\': \'鎮魂歌の天使\', \'text\': \'飛行\\nあなたがコントロールする他のスピリットでないクリーチャーが１体死亡するたび、飛行を持つ白の１/１のスピリット・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'天使が絶望するとき、定命の者にどんな希望が残るのか？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4e6e98d3-3b84-4994-8506-fd8257dc7668\', \'multiverseId\': 391340}, \'multiverseid\': 391340}, {\'name\': \'安魂天使\', \'text\': \'飞行\\n每当另一个由你操控且非精怪的生物死去时，将一个1/1白色，具飞行异能的精怪衍生生物放进战场。\', \'type\': \'生物～天使\', \'flavor\': \'若天使都失志沮丧，生灵岂能作何指望？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389992&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39aaf347-0354-4a89-beda-b940601770cd\', \'multiverseId\': 389992}, \'multiverseid\': 389992}]', '[{\'name\': \'Riffwürmchen\', \'text\': \'Wenn das Riffwürmchen stirbt, bringe einen 3/3 blauen Fisch-Kreaturenspielstein ins Spiel mit „Wenn diese Kreatur stirbt, bringe einen 6/6 Wal-Kreaturenspielstein ins Spiel mit ,Wenn diese Kreatur stirbt, bringe einen 9/9 Krake-Kreaturenspielstein ins Spiel\\\'".\', \'type\': \'Kreatur — Würmchen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390326&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce66770d-aa56-4360-9235-10e66f08bcce\', \'multiverseId\': 390326}, \'multiverseid\': 390326}, {\'name\': \'Gusano de arrecife\', \'text\': \'Cuando el Gusano de arrecife muera, pon en el campo de batalla una ficha de criatura Pez azul 3/3 con "Cuando esta criatura muera, pon en el campo de batalla una ficha de criatura Ballena azul 6/6 con \\\'Cuando esta criatura muera, pon en el campo de batalla una ficha de criatura Kraken azul 9/9\\\'".\', \'type\': \'Criatura — Gusano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391674&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'198b3698-bdaa-4b7e-bf3e-b03d3d3e3361\', \'multiverseId\': 391674}, \'multiverseid\': 391674}, {\'name\': \'Ver de récif\', \'text\': "Quand le Ver de récif meurt, mettez sur le champ de bataille un jeton de créature 3/3 bleue Poisson avec « Quand cette créature meurt, mettez sur le champ de bataille un jeton de créature 6/6 bleue Baleine avec \'Quand cette créature meurt, mettez sur le champ de bataille un jeton de créature 9/9 bleue Kraken.\' »", \'type\': \'Créature : ver\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390663&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa3cc3b0-85d8-4cdf-8de0-1b9935c065f3\', \'multiverseId\': 390663}, \'multiverseid\': 390663}, {\'name\': \'Verme della Scogliera\', \'text\': \'Quando il Verme della Scogliera muore, metti sul campo di battaglia una pedina creatura Pesce 3/3 blu con "Quando questa creatura muore, metti sul campo di battaglia una pedina creatura Balena 6/6 blu con \\\'Quando questa creatura muore, metti sul campo di battaglia una pedina creatura Kraken 9/9 blu\\\' ".\', \'type\': \'Creatura — Verme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391000&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fdc51f47-a6af-4d21-9c44-df8dfbbf2a8e\', \'multiverseId\': 391000}, \'multiverseid\': 391000}, {\'name\': \'浅瀬蟲\', \'text\': \'浅瀬蟲が死亡したとき、青の３/３の魚・クリーチャー・トークンを１体戦場に出す。それは「このクリーチャーが死亡したとき、青の６/６の鯨・クリーチャー・トークンを１体戦場に出す。それは『このクリーチャーが死亡したとき、青の９/９のクラーケン・クリーチャー・トークンを１体戦場に出す。』を持つ。」を持つ。\', \'type\': \'クリーチャー — 蟲\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391337&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ec13968-a405-4a5e-b29b-812f00fffb65\', \'multiverseId\': 391337}, \'multiverseid\': 391337}, {\'name\': \'暗礁水蛆\', \'text\': \'当暗礁水蛆死去时，将一个3/3蓝色的鱼衍生生物放进战场，且具有「当此生物死去时，将一个6/6蓝色鲸鱼衍生生物放进战场，且具有『当此生物死去时，将一个9/9蓝色巨海兽衍生生物放进战场』。」\', \'type\': \'生物～蠕虫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389989&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88f45e89-9e0d-46c5-b922-f3d95525c10a\', \'multiverseId\': 389989}, \'multiverseid\': 389989}]', '[{\'name\': \'Rift des Sturmtiefs\', \'text\': \'Bringe eine bleibende Karte deiner Wahl, die kein Land ist und die du nicht kontrollierst, auf die Hand ihres Besitzers zurück.\\nÜberlast {6}{U} (Du kannst diesen Zauber für seine Überlast-Kosten wirken. Falls du dies tust, verändere seinen Text, indem du im Text alle Vorkommen von „deiner Wahl" durch „jeder" ersetzt.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Izzet sind auf unnatürliche Katastrophen spezialisiert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390151&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60729704-bc51-49c8-a4ce-ce480c69dfb7\', \'multiverseId\': 390151}, \'multiverseid\': 390151}, {\'name\': \'Grieta ciclónica\', \'text\': \'Regresa el permanente objetivo que no sea tierra que no controles a la mano de su propietario.\\nSobrecarga {6}{U}. (Puedes lanzar este hechizo por su coste de sobrecarga. Si lo haces, cambia su texto reemplazando "el permanente objetivo" por "cada permanente".)\', \'type\': \'Instantáneo\', \'flavor\': \'Los ízzet se especializan en desastres no naturales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391499&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'982e3712-255b-4001-b7f2-43db0f46c9f1\', \'multiverseId\': 391499}, \'multiverseid\': 391499}, {\'name\': \'Faille cyclonique\', \'text\': \'Renvoyez un permanent non-terrain ciblé que vous ne contrôlez pas dans la main de son propriétaire.\\nSurcharge {6}{U} (Vous pouvez lancer ce sort pour son coût de surcharge. Si vous faites ainsi, modifiez son texte en remplaçant toutes les occurrences de « ciblé(e) » par « chaque ».)\', \'type\': \'Éphémère\', \'flavor\': \'Les Izzet sont spécialisés dans les catastrophes artificielles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390488&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b2801a4b-e310-4a1d-8684-f5df68bd76eb\', \'multiverseId\': 390488}, \'multiverseid\': 390488}, {\'name\': \'Squarcio Ciclonico\', \'text\': \'Fai tornare un permanente non terra bersaglio che non controlli in mano al suo proprietario.\\nSovraccarico {6}{U} (Puoi lanciare questa magia per il suo costo di sovraccarico. Se lo fai, cambiane il testo sostituendo "un permanente non terra bersaglio" con "ogni permanente non terra".)\', \'type\': \'Istantaneo\', \'flavor\': \'Gli Izzet sono specializzati in catastrofi innaturali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390825&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8a7b3f4-5c05-4f4b-9114-ea83ab1de234\', \'multiverseId\': 390825}, \'multiverseid\': 390825}, {\'name\': \'サイクロンの裂け目\', \'text\': \'あなたがコントロールしていない土地でないパーマネント１つを対象とし、それをオーナーの手札に戻す。\\n超過{6}{U}（あなたはこの呪文を、これの超過コストで唱えてもよい。そうしたなら、あなたがコントロールしていない土地でない各パーマネントをそれぞれオーナーの手札に戻す。）\', \'type\': \'インスタント\', \'flavor\': \'イゼット団は不自然災害を専門としている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391162&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'11308bef-f3d0-4ab0-b1df-412639223294\', \'multiverseId\': 391162}, \'multiverseid\': 391162}, {\'name\': \'龙卷裂空\', \'text\': \'将目标不由你操控的非地永久物移回其拥有者手上。\\n超载{6}{U}（你可以支付此咒语的超载费用来施放它。如果你如此作，将其中的「目标」字样全部更改为「每个」。）\', \'type\': \'瞬间\', \'flavor\': \'伊捷以非天然灾害为业。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45e6b68c-fd9f-43b1-b756-22f57f992fe4\', \'multiverseId\': 389814}, \'multiverseid\': 389814}]', "[{'name': 'Rubinmedaillon', 'text': 'Rote Zaubersprüche, die du wirkst, kosten beim Wirken {1} weniger.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390333&type=card', 'language': 'German', 'identifiers': {'scryfallId': '43ca6057-99d4-4be2-a9f0-289394c2d6e8', 'multiverseId': 390333}, 'multiverseid': 390333}, {'name': 'Medallón de rubíes', 'text': 'Te cuesta {1} menos lanzar los hechizos rojos.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391681&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ccde64e8-f6bb-40cd-9572-a139350619e4', 'multiverseId': 391681}, 'multiverseid': 391681}, {'name': 'Médaillon de rubis', 'text': 'Les sorts rouges que vous lancez coûtent {1} de moins à lancer.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390670&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b76e4d1d-005f-40a5-b0de-51eb109753aa', 'multiverseId': 390670}, 'multiverseid': 390670}, {'name': 'Medaglione di Rubino', 'text': 'Le magie rosse che lanci costano {1} in meno per essere lanciate.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391007&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '41ffc56d-986a-48de-9dc7-8c04785327e4', 'multiverseId': 391007}, 'multiverseid': 391007}, {'name': 'ルビーの大メダル', 'text': 'あなたが唱える赤の呪文を唱えるためのコストは{1}少なくなる。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391344&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bde3b3b0-fe14-48a0-8735-264a0857533c', 'multiverseId': 391344}, 'multiverseid': 391344}, {'name': '红宝石徽章', 'text': '你施放的红色咒语减少{1}来施放。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389996&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '88228eee-9090-4891-b7b5-fac1f9e48c05', 'multiverseId': 389996}, 'multiverseid': 389996}]", '[{\'name\': \'Rudelführer des Zaunkönigreviers\', \'text\': \'Beschütze einen Elfen (Wenn diese Karte ins Spiel kommt, opfere sie, falls du nicht einen anderen Elfen, den du kontrollierst, ins Exil schickst. Wenn diese Kreatur das Spiel verlässt, kehrt jene Karte ins Spiel zurück.)\\n{2}{G}: Bringe einen 2/2 grünen Wolf-Kreaturenspielstein ins Spiel.\\nWölfe, die du kontrollierst, haben Todesberührung.\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390429&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20c9f4dc-370e-49aa-90f9-cef1b78ec9fa\', \'multiverseId\': 390429}, \'multiverseid\': 390429}, {\'name\': \'Ama de jauría de Coto de Reyezuelos\', \'text\': \'Amparar un Elfo. (Cuando esta carta entre al campo de batalla, sacrifícala a menos que exilies otro Elfo que controlas. Cuando esta criatura deje el campo de batalla, esa carta regresa al campo de batalla.)\\n{2}{G}: Pon en el campo de batalla una ficha de criatura Lobo verde 2/2.\\nLos Lobos que controlas tienen la habilidad de toque mortal.\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391777&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4bfdaf2-812d-40a2-9cdc-bc025f31f808\', \'multiverseId\': 391777}, \'multiverseid\': 391777}, {\'name\': \'Veneur de la Garenne du Roitelet\', \'text\': "Appui d\'elfe (Quand cette créature arrive sur le champ de bataille, sacrifiez-la à moins que vous n\'exiliez un autre elfe que vous contrôlez. Quand cette créature quitte le champ de bataille, la carte exilée revient sur le champ de bataille.)\\n{2}{G} : Mettez sur le champ de bataille un jeton de créature 2/2 verte Loup.\\nLes loups que vous contrôlez ont le contact mortel.", \'type\': \'Créature : elfe et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ec31f77-d532-48d6-9c78-729dfd80c84c\', \'multiverseId\': 390766}, \'multiverseid\': 390766}, {\'name\': \'Capobranco di Volo dello Scricciolo\', \'text\': \'Battersi per un Elfo (Quando questa creatura entra nel campo di battaglia, sacrificala a meno che non esili un altro Elfo che controlli. Quando questa creatura lascia il campo di battaglia, quella carta viene rimessa sul campo di battaglia.)\\n{2}{G}: Metti sul campo di battaglia una pedina creatura Lupo 2/2 verde.\\nI Lupi che controlli hanno tocco letale.\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391103&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'89de06df-3e5e-40f6-aab5-db514bb78628\', \'multiverseId\': 391103}, \'multiverseid\': 391103}, {\'name\': \'レンの地の群れ使い\', \'text\': \'覇権（エルフ）（このクリーチャーが戦場に出たとき、あなたがコントロールする他のエルフを１体追放しないかぎり、これを生け贄に捧げる。このクリーチャーが戦場を離れたとき、そのカードは戦場に戻る。）\\n{2}{G}：緑の２/２の狼・クリーチャー・トークンを１体戦場に出す。\\nあなたがコントロールする狼は接死を持つ。\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391440&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24dac8f2-f837-48df-85c0-4ec997065985\', \'multiverseId\': 391440}, \'multiverseid\': 391440}, {\'name\': \'蒙鸠地狼群使\', \'text\': \'夺冠妖精（当此生物进战场时，除非你放逐另一个由你操控的妖精，否则牺牲之。当它离开战场时，将该牌移回战场。）\\n{2}{G}：将一个2/2绿色的狼衍生生物放进战场。\\n由你操控的狼具有死触异能。\', \'type\': \'生物～妖精／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390092&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9a0d902-ab06-4f76-8b00-24b711f46b7d\', \'multiverseId\': 390092}, \'multiverseid\': 390092}]', '[{\'name\': \'Ruf der Wölfe\', \'text\': \'Bringe zu Beginn deines Versorgungssegments X 2/2 grüne Wolf-Kreaturenspielsteine ins Spiel, wobei X gleich der Anzahl an Gegnern ist, die vier oder mehr Karten auf der Hand haben.\', \'type\': \'Verzauberung\', \'flavor\': \'„Wissen ist ein Makel, der nur durch niedere Instinkte ausgemerzt werden kann." —Drarg, Wolfrufer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390425&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2acf042-571e-4f70-9a8b-ad2eac132785\', \'multiverseId\': 390425}, \'multiverseid\': 390425}, {\'name\': \'Aullido llamalobos\', \'text\': \'Al comienzo de tu mantenimiento, pon en el campo de batalla X fichas de criatura Lobo verdes 2/2, donde X es la cantidad de tus oponentes con cuatro o más cartas en la mano.\', \'type\': \'Encantamiento\', \'flavor\': \'"El conocimiento es una mancha que solo el instinto y la ferocidad son capaces de limpiar". —Drarg, llamalobos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391773&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'06583099-7c55-402a-8648-8fe987a3c588\', \'multiverseId\': 391773}, \'multiverseid\': 391773}, {\'name\': \'Hurlement du meneur de loups\', \'text\': \'Au début de votre entretien, mettez sur le champ de bataille X jetons de créature 2/2 verte Loup, X étant le nombre de vos adversaires avec au moins quatre cartes en main.\', \'type\': \'Enchantement\', \'flavor\': "« Le savoir est une tache que seuls l\'instinct et la férocité peuvent effacer. » —Drarg, meneur de loups", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390762&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3ccc5e9-44e7-4820-b19f-16ddbf1a6de3\', \'multiverseId\': 390762}, \'multiverseid\': 390762}, {\'name\': "Ululato dell\'Evocalupi", \'text\': "All\'inizio del tuo mantenimento, metti sul campo di battaglia X pedine creatura Lupo 2/2 verdi, dove X è il numero di tuoi avversari che hanno quattro o più carte in mano.", \'type\': \'Incantesimo\', \'flavor\': \'"La conoscenza è una macchia che solo l\\\'istinto e la ferocia possono rimuovere." —Drarg, evocalupi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d24c0647-2c3b-45ec-8037-ffcaa1228955\', \'multiverseId\': 391099}, \'multiverseid\': 391099}, {\'name\': \'狼呼びの雄叫び\', \'text\': \'あなたのアップキープの開始時に、緑の２/２の狼・クリーチャー・トークンをＸ体戦場に出す。Ｘは手札を４枚以上持つ対戦相手の総数に等しい。\', \'type\': \'エンチャント\', \'flavor\': \'「知識とは、本能と獰猛さでもってのみ浄化することができる穢れである。」 ――狼呼び、ドラルグ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3d8b2e2a-dc32-4d86-bfb4-f35e45d2c082\', \'multiverseId\': 391436}, \'multiverseid\': 391436}, {\'name\': \'唤狼师之吼\', \'text\': \'在你的维持开始时，将X个2/2绿色的狼衍生生物放进战场，X为有四张或更多手牌之对手的数量。\', \'type\': \'结界\', \'flavor\': \'「知识这种污渍只有本能和残暴才能洗刷。」 ～唤狼师德拉格\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390088&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bbeae8b-25b3-4fd1-ab9a-37928ce4cc94\', \'multiverseId\': 390088}, \'multiverseid\': 390088}]', "[{'name': 'Saphirmedaillon', 'text': 'Blaue Zaubersprüche, die du wirkst, kosten beim Wirken {1} weniger.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390336&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd2c1f3b2-f7d8-4859-abf0-f2c51be2a56b', 'multiverseId': 390336}, 'multiverseid': 390336}, {'name': 'Medallón de zafiros', 'text': 'Te cuesta {1} menos lanzar los hechizos azules.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391684&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e824f68f-fed9-4959-8b62-c41cb921a1ad', 'multiverseId': 391684}, 'multiverseid': 391684}, {'name': 'Médaillon de saphir', 'text': 'Les sorts bleus que vous lancez coûtent {1} de moins à lancer.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390673&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f5c7c70b-13ba-4a24-985c-adf6c1a2aed9', 'multiverseId': 390673}, 'multiverseid': 390673}, {'name': 'Medaglione di Zaffiro', 'text': 'Le magie blu che lanci costano {1} in meno per essere lanciate.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391010&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '98c4657e-4bb1-4832-86a5-e427697457cf', 'multiverseId': 391010}, 'multiverseid': 391010}, {'name': 'サファイアの大メダル', 'text': 'あなたが唱える青の呪文を唱えるためのコストは{1}少なくなる。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391347&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '96ccf082-4d2f-45aa-90f0-c0d395e569af', 'multiverseId': 391347}, 'multiverseid': 391347}, {'name': '蓝宝石徽章', 'text': '你施放的蓝色咒语减少{1}来施放。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389999&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd8e83a43-53a6-4b79-95ac-37a341959907', 'multiverseId': 389999}, 'multiverseid': 389999}]", "[{'name': 'Scharfsinniges Präsent', 'text': 'Bestimme einen Gegner. Du und dieser Spieler zieht je drei Karten.\\nBestimme einen Gegner. Enttappe alle bleibende Karten, die du kontrollierst und die keine Länder sind, und alle bleibenden Karten, die dieser Spieler kontrolliert und die keine Länder sind.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390233&type=card', 'language': 'German', 'identifiers': {'scryfallId': '50cd5a11-ac12-4c5b-ad15-3a64004e483f', 'multiverseId': 390233}, 'multiverseid': 390233}, {'name': 'Ofrenda intelectual', 'text': 'Elige un oponente. Ese jugador y tú roban tres cartas cada uno.\\nElige un oponente. Endereza todos los permanentes que no sean tierra que controlas y todos los permanentes que no sean tierra que controla ese jugador.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391581&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c8ef6cb9-3bf2-4cb8-8249-6985e7235b3e', 'multiverseId': 391581}, 'multiverseid': 391581}, {'name': 'Offrande intellectuelle', 'text': 'Choisissez un adversaire. Ce joueur et vous piochez chacun trois cartes.\\nChoisissez un adversaire. Dégagez tous les permanents non-terrains que vous contrôlez et tous les permanents non-terrains que ce joueur contrôle.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390570&type=card', 'language': 'French', 'identifiers': {'scryfallId': '49493033-9e04-49a2-a68b-117fec92d11d', 'multiverseId': 390570}, 'multiverseid': 390570}, {'name': 'Offerta Intellettuale', 'text': 'Scegli un avversario. Tu e quel giocatore pescate ognuno tre carte.\\nScegli un avversario. STAPpa tutti i permanenti non terra che controlli e tutti i permanenti non terra controllati da quel giocatore.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390907&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7e5fbe89-5068-4a84-a28f-ba7b57fdcecf', 'multiverseId': 390907}, 'multiverseid': 390907}, {'name': '知性の捧げ物', 'text': '対戦相手を１人選ぶ。あなたとそのプレイヤーはそれぞれカードを３枚引く。\\n対戦相手を１人選ぶ。あなたがコントロールするすべての土地でないパーマネントとそのプレイヤーがコントロールするすべての土地でないパーマネントをアンタップする。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391244&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '787a6d3f-bcb5-49a0-a579-9490755c0a29', 'multiverseId': 391244}, 'multiverseid': 391244}, {'name': '智识乐施', 'text': '选择一位对手。你和该牌手各抓三张牌。\\n选择一位对手。重置由你操控的所有非地永久物和由该牌手操控的所有非地永久物。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389896&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9ea6598f-95ad-404f-99c5-190d2e21dde8', 'multiverseId': 389896}, 'multiverseid': 389896}]", '[{\'name\': \'Schlachtfeld von Havenwood\', \'text\': \'Das Schlachtfeld von Havenwood kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}.\\n{T}, opfere das Schlachtfeld von Havenwood: Erhöhe deinen Manavorrat um {G}{G}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390221&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'90da1b83-7e90-47ab-8312-d108a4fae4cf\', \'multiverseId\': 390221}, \'multiverseid\': 390221}, {\'name\': \'Campo de Havenwood\', \'text\': \'El Campo de Havenwood entra al campo de batalla girado.\\n{T}: Agrega {G} a tu reserva de maná.\\n{T}, sacrificar el Campo de Havenwood: Agrega {G}{G} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391569&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31d4a5d5-06fc-4514-9055-81196f201697\', \'multiverseId\': 391569}, \'multiverseid\': 391569}, {\'name\': "Champ de bataille d\'Havrebois", \'text\': "Le Champ de bataille d\'Havrebois arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G} à votre réserve.\\n{T}, sacrifiez le Champ de bataille d\'Havrebois : Ajoutez {G}{G} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390558&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'539f7239-e665-4d8c-bcab-aafad4609db5\', \'multiverseId\': 390558}, \'multiverseid\': 390558}, {\'name\': \'Campo di Battaglia di Havenwood\', \'text\': \'Il Campo di Battaglia di Havenwood entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} alla tua riserva di mana.\\n{T}, Sacrifica il Campo di Battaglia di Havenwood: Aggiungi {G}{G} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390895&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f902170d-5ebf-4c59-a0a1-1678e47db36a\', \'multiverseId\': 390895}, \'multiverseid\': 390895}, {\'name\': \'へイヴンウッドの古戦場\', \'text\': \'へイヴンウッドの古戦場はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}を加える。\\n{T}, へイヴンウッドの古戦場を生け贄に捧げる：あなたのマナ・プールに{G}{G}を加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391232&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0993b19-3f43-4582-9728-78ed00a9fd4d\', \'multiverseId\': 391232}, \'multiverseid\': 391232}, {\'name\': \'海温森战场\', \'text\': \'海温森战场须横置进战场。\\n{T}：加{G}到你的法术力池中。\\n{T}，牺牲海温森战场：加{G}{G}到你的法术力池中。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea995365-a0e8-46c2-834b-57c1149c7a44\', \'multiverseId\': 389884}, \'multiverseid\': 389884}]', "[{'name': 'Schlafender Vulkan', 'text': 'Der Schlafende Vulkan kommt getappt ins Spiel.\\nWenn der Schlafende Vulkan ins Spiel kommt, opfere ihn, falls du nicht ein ungetapptes Gebirge, das du kontrollierst, auf die Hand seines Besitzers zurückbringst.\\n{T}: Erhöhe deinen Manavorrat um {1}{R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390163&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7b254124-647e-4a09-af97-e1e0c7bc3cd8', 'multiverseId': 390163}, 'multiverseid': 390163}, {'name': 'Volcán inactivo', 'text': 'El Volcán inactivo entra al campo de batalla girado.\\nCuando el Volcán inactivo entre al campo de batalla, sacrifícalo a menos que regreses una montaña enderezada que controlas a la mano de su propietario.\\n{T}: Agrega {1}{R} a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391511&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '200f335e-b9e9-48c8-ad99-b3e3cddf9a4f', 'multiverseId': 391511}, 'multiverseid': 391511}, {'name': 'Volcan assoupi', 'text': 'Le Volcan assoupi arrive sur le champ de bataille engagé.\\nQuand le Volcan assoupi arrive sur le champ de bataille, sacrifiez-le à moins de renvoyer une montagne dégagée que vous contrôlez dans la main de son propriétaire.\\n{T} : Ajoutez {1}{R} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390500&type=card', 'language': 'French', 'identifiers': {'scryfallId': '481268de-7c7c-4fb9-ac53-7abf99b29011', 'multiverseId': 390500}, 'multiverseid': 390500}, {'name': 'Vulcano Dormiente', 'text': 'Il Vulcano Dormiente entra nel campo di battaglia TAPpato.\\nQuando il Vulcano Dormiente entra nel campo di battaglia, sacrificalo a meno che tu non faccia tornare una Montagna STAPpata che controlli in mano al suo proprietario.\\n{T}: Aggiungi {1}{R} alla tua riserva di mana.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390837&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b046cd27-e17f-4d8c-8b3f-f52c1cd77533', 'multiverseId': 390837}, 'multiverseid': 390837}, {'name': '休火山', 'text': '休火山はタップ状態で戦場に出る。\\n休火山が戦場に出たとき、あなたがコントロールするアンタップ状態の山１つをオーナーの手札に戻さないかぎり、これを生け贄に捧げる。\\n{T}：あなたのマナ・プールに{1}{R}を加える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391174&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4ebe3f79-71f8-4c8f-961c-99c9bc75fb10', 'multiverseId': 391174}, 'multiverseid': 391174}, {'name': '休火山', 'text': '休火山须横置进战场。\\n当休火山进战场时，除非你将一个由你操控且未横置的山脉移回其拥有者手上，否则牺牲之。\\n{T}：加{1}{R}到你的法术力池中。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389826&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7d265212-6150-4366-8481-a20c809932d8', 'multiverseId': 389826}, 'multiverseid': 389826}]", "[{'name': 'Schloss des Gargoyle', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{5}, {T}, opfere das Schloss des Gargoyle: Bringe einen 3/4 farblosen Gargoyle-Artefaktkreaturenspielstein mit Flugfähigkeit ins Spiel.', 'type': 'Land', 'flavor': 'Die meisten kannten den Zauberer und den Gargoyle des Turms. Doch nur wenige wussten, wer der Meister und wer der Wächter war.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390206&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e14c53ef-be0e-466e-8ffd-17603179b5b2', 'multiverseId': 390206}, 'multiverseid': 390206}, {'name': 'Castillo de las gárgolas', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{5}, {T}, sacrificar el Castillo de las gárgolas: Pon en el campo de batalla una ficha de criatura artefacto Gárgola incolora 3/4 con la habilidad de volar.', 'type': 'Tierra', 'flavor': 'Muchos conocían al hechicero y a la gárgola de la torre. Pocos sabían quién era el guardián y quién el amo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391554&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5c1ab12b-1ad1-4432-a175-34bdd82ac237', 'multiverseId': 391554}, 'multiverseid': 391554}, {'name': 'Château de la gargouille', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{5}, {T}, sacrifiez le Château de la gargouille : Mettez sur le champ de bataille un jeton de créature-artefact 3/4 incolore Gargouille avec le vol.', 'type': 'Terrain', 'flavor': 'Tous connaissaient le sorcier et la gargouille de la tour. Peu réalisaient qui était le gardien et qui était le maître.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390543&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0d20e7c2-99ee-4b38-93d7-2cdbbafb2355', 'multiverseId': 390543}, 'multiverseid': 390543}, {'name': 'Castello del Gargoyle', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{5}, {T}, Sacrifica il Castello del Gargoyle: Metti sul campo di battaglia una pedina creatura artefatto Gargoyle 3/4 incolore con volare.', 'type': 'Terra', 'flavor': 'Molti conoscevano il mago e il gargoyle della torre. Pochi riuscivano a capire chi fosse il guardiano e chi il padrone.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390880&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'beb3daca-b91f-42fd-afc6-eb3a436b1b71', 'multiverseId': 390880}, 'multiverseid': 390880}, {'name': 'ガーゴイルの城', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{5}, {T}, ガーゴイルの城を生け贄に捧げる：飛行を持つ無色の３/４のガーゴイル・アーティファクト・クリーチャー・トークンを１体戦場に出す。', 'type': '土地', 'flavor': 'その塔の魔術師とガーゴイルのことは誰でも知っている。そのどちらが主でどちらが護衛であるかを知るものはほとんどいない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391217&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fee88abf-35ca-4965-b7dc-26e9c74fd37c', 'multiverseId': 391217}, 'multiverseid': 391217}, {'name': '石像鬼城堡', 'text': '{T}：加{1}到你的法术力池中。\\n{5}，{T}，牺牲石像鬼城堡：将一个3/4无色，具飞行异能的石像鬼衍生神器生物放进战场。', 'type': '地', 'flavor': '大多数人都晓得这塔上的法师与石像鬼。但很少人明白究竟谁是守护者，谁又是主人。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389869&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '55e2562d-7db3-4699-8d35-1c50e5860858', 'multiverseId': 389869}, 'multiverseid': 389869}]", '[{\'name\': \'Schlächter von Malakir\', \'text\': \'Fliegend\\nImmer wenn der Schlächter von Malakir oder eine andere Kreatur, die du kontrollierst, stirbt, opfert jeder Gegner eine Kreatur.\', \'type\': \'Kreatur — Vampir, Krieger\', \'flavor\': \'Sein Urteil lautet immer auf schuldig. Die Strafe lautet immer Tod.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390129&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'67b2d627-3e3e-4171-ade2-0b491a896b7f\', \'multiverseId\': 390129}, \'multiverseid\': 390129}, {\'name\': \'Carnicero de Malakir\', \'text\': \'Vuela.\\nSiempre que el Carnicero de Malakir u otra criatura que controlas muera, cada oponente sacrifica una criatura.\', \'type\': \'Criatura — Guerrero vampiro\', \'flavor\': \'Su veredicto siempre es culpable. Su sentencia siempre es la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391477&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c3e0dca-da42-494a-8fd2-1cb336561268\', \'multiverseId\': 391477}, \'multiverseid\': 391477}, {\'name\': \'Boucher de Malakir\', \'text\': "Vol\\nÀ chaque fois que le Boucher de Malakir ou qu\'une autre créature que vous contrôlez meurt, chaque adversaire sacrifie une créature.", \'type\': \'Créature : vampire et guerrier\', \'flavor\': \'Son verdict est toujours coupable. Sa sentence est toujours la mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390466&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd937d9c-1eb8-4d3a-ad75-76af6dfa0b1b\', \'multiverseId\': 390466}, \'multiverseid\': 390466}, {\'name\': \'Macellaio di Malakir\', \'text\': "Volare\\nOgniqualvolta il Macellaio di Malakir o un\'altra creatura che controlli muore, ogni avversario sacrifica una creatura.", \'type\': \'Creatura — Guerriero Vampiro\', \'flavor\': \'Il suo verdetto? Colpevole. La sua sentenza? Morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390803&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81997991-7e03-442d-aa02-c21c8ddd7463\', \'multiverseId\': 390803}, \'multiverseid\': 390803}, {\'name\': \'マラキールの解体者\', \'text\': \'飛行\\nマラキールの解体者かあなたがコントロールする他のクリーチャーが１体死亡するたび、各対戦相手はそれぞれクリーチャーを１体生け贄に捧げる。\', \'type\': \'クリーチャー — 吸血鬼・戦士\', \'flavor\': \'彼の判決は常に有罪だ。彼の量刑は常に死刑だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391140&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6456dd97-5c33-4a40-9b33-32990fa4d514\', \'multiverseId\': 391140}, \'multiverseid\': 391140}, {\'name\': \'马拉奇屠夫\', \'text\': \'飞行\\n每当马拉奇屠夫或另一个由你操控的生物死去时，每位对手各牺牲一个生物。\', \'type\': \'生物～吸血鬼／战士\', \'flavor\': \'他永远判定有罪。他总是裁决处死。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389792&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e560bf27-86c2-486d-8414-97bf82537dd4\', \'multiverseId\': 389792}, \'multiverseid\': 389792}]', "[{'name': 'Schlüpfriger Karst', 'text': 'Der Schlüpfrige Karst kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390353&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0b4d059e-1514-4f49-81ee-569df13b80e7', 'multiverseId': 390353}, 'multiverseid': 390353}, {'name': 'Gruta resbaladiza', 'text': 'La Gruta resbaladiza entra al campo de batalla girada.\\n{T}: Agrega {G} a tu reserva de maná.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391701&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '626d9a45-d963-470e-b27f-8045792e1098', 'multiverseId': 391701}, 'multiverseid': 391701}, {'name': 'Karst glissant', 'text': 'Le Karst glissant arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {G} à votre réserve.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390690&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8fadba86-d577-4684-8ca1-f11c901de4f8', 'multiverseId': 390690}, 'multiverseid': 390690}, {'name': 'Carso Scivoloso', 'text': 'Il Carso Scivoloso entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} alla tua riserva di mana.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391027&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '24797970-f99f-4988-9ef0-4aefa8f8c1ed', 'multiverseId': 391027}, 'multiverseid': 391027}, {'name': '滑りやすいカルスト', 'text': '滑りやすいカルストはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391364&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '62e65e4a-c6d8-42a0-90d2-24ed20ca09c2', 'multiverseId': 391364}, 'multiverseid': 391364}, {'name': '湿滑灰岩地', 'text': '湿滑灰岩地须横置进战场。\\n{T}：加{G}到你的法术力池中。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390016&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0ead07dc-c474-4fcc-81b1-78c687de0959', 'multiverseId': 390016}, 'multiverseid': 390016}]", "[{'name': 'Schmutziges Schlammloch', 'text': 'Das Schmutzige Schlammloch kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {B}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390311&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2294707c-0911-4fb5-842d-95a3a704e423', 'multiverseId': 390311}, 'multiverseid': 390311}, {'name': 'Cenagal contaminado', 'text': 'El Cenagal contaminado entra al campo de batalla girado.\\n{T}: Agrega {B} a tu reserva de maná.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391659&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5942a4a9-9ee1-4c4e-a9ce-ee0e9ce63b07', 'multiverseId': 391659}, 'multiverseid': 391659}, {'name': 'Fondrière polluée', 'text': 'La Fondrière polluée arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {B} à votre réserve.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390648&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e6c51c0d-0b1a-4282-8107-8cf4b3b91207', 'multiverseId': 390648}, 'multiverseid': 390648}, {'name': 'Palude Inquinata', 'text': 'La Palude Inquinata entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {B} alla tua riserva di mana.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390985&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '58c15208-6002-44c5-8346-b058163a2598', 'multiverseId': 390985}, 'multiverseid': 390985}, {'name': '汚染されたぬかるみ', 'text': '汚染されたぬかるみはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{B}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391322&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd1e2886b-2673-43cf-b6cb-77abc07519c7', 'multiverseId': 391322}, 'multiverseid': 391322}, {'name': '污泥沼', 'text': '污泥沼须横置进战场。\\n{T}：加{B}到你的法术力池中。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389974&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dd23e396-9431-4583-8cde-6dfc42e3d6e8', 'multiverseId': 389974}, 'multiverseid': 389974}]", "[{'name': 'Schneediamant', 'text': 'Der Schneediamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390262&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b81aa32c-f63a-4759-b996-23f8d900ecb8', 'multiverseId': 390262}, 'multiverseid': 390262}, {'name': 'Diamante marmóleo', 'text': 'El Diamante marmóleo entra al campo de batalla girado.\\n{T}: Agrega {W} a tu reserva de maná.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391610&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8681bd23-47d2-4989-8206-1fa1cd117ec9', 'multiverseId': 391610}, 'multiverseid': 391610}, {'name': 'Diamant du marbre', 'text': 'Le Diamant du marbre arrive sur le champ de bataille engagé.\\n{T} : Ajoutez {W} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390599&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8f5d09c7-48b3-4a28-9cb3-4a42f3dee48a', 'multiverseId': 390599}, 'multiverseid': 390599}, {'name': 'Diamante del Marmo', 'text': 'Il Diamante del Marmo entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {W} alla tua riserva di mana.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390936&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '64d0b694-e4e4-48b3-a257-fbf2d62f4f5a', 'multiverseId': 390936}, 'multiverseid': 390936}, {'name': '乳白色のダイアモンド', 'text': '乳白色のダイアモンドはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}を加える。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391273&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f0f68929-efaa-4f49-87d3-c76fcf1a9bf7', 'multiverseId': 391273}, 'multiverseid': 391273}, {'name': '乳白钻石', 'text': '乳白钻石须横置进战场。\\n{T}：加{W}到你的法术力池中。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389925&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9f22d6af-dac6-488b-b391-9c8392e04f4b', 'multiverseId': 389925}, 'multiverseid': 389925}]", '[{\'name\': \'Schnitter aus dem Abgrund\', \'text\': \'Fliegend\\nMorbide — Zerstöre zu Beginn jedes Endsegments, falls in diesem Zug eine Kreatur gestorben ist, eine Nicht-Dämon-Kreatur deiner Wahl.\', \'type\': \'Kreatur — Dämon\', \'flavor\': \'„Avacyn hat euch verlassen. Ich nehme an ihrer Stelle eure Verehrung an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390324&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55514da6-d6bf-46c2-bca5-e1b762af9a6a\', \'multiverseId\': 390324}, \'multiverseid\': 390324}, {\'name\': \'Segador del abismo\', \'text\': \'Vuela.\\nNecrario — Al comienzo de cada paso final, si una criatura murió este turno, destruye la criatura objetivo que no sea Demonio.\', \'type\': \'Criatura — Demonio\', \'flavor\': \'"Avacyn te ha abandonado. Yo aceptaré tu devoción en su lugar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391672&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f7e8e4eb-2e5e-4362-afa9-57fb2980e506\', \'multiverseId\': 391672}, \'multiverseid\': 391672}, {\'name\': "Faucheur de l\'abysse", \'text\': \'Vol\\nMorbidité — Au début de chaque étape de fin, si une créature est morte ce tour-ci, détruisez une créature non-Démon ciblée.\', \'type\': \'Créature : démon\', \'flavor\': "« Avacyn vous a abandonné. J\'accepte votre dévotion pour la remplacer. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390661&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60b9ead7-f728-426c-ba69-cceff9ef44e0\', \'multiverseId\': 390661}, \'multiverseid\': 390661}, {\'name\': "Mietitore dell\'Abisso", \'text\': "Volare\\nMorboso — All\'inizio di ogni sottofase finale, se è morta una creatura in questo turno, distruggi una creatura non Demone bersaglio.", \'type\': \'Creatura — Demone\', \'flavor\': \'"Avacyn ti ha abbandonato. Accolgo di buon grado la tua devozione in sua vece."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390998&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecb42b95-bf71-446f-91f5-ecd46e014fd3\', \'multiverseId\': 390998}, \'multiverseid\': 390998}, {\'name\': \'深淵からの魂刈り\', \'text\': \'飛行\\n陰鬱 ― 各終了ステップの開始時に、このターンにクリーチャーが死亡していた場合、デーモンでないクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': \'「アヴァシンはお前を見捨てた。彼女の代わりに、私がお前の献身を歓迎しよう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391335&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ca28c7a-d048-4a10-9a86-7405da9fad38\', \'multiverseId\': 391335}, \'multiverseid\': 391335}, {\'name\': \'深渊刽子手\', \'text\': \'飞行\\n丧心～在每个结束步骤开始时，若本回合有生物死去，则消灭目标非恶魔的生物。\', \'type\': \'生物～恶魔\', \'flavor\': \'「艾维欣抛弃了你。我欢迎你转而为我奉献。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389987&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'560edb05-5992-46ec-a57c-29dadecc571d\', \'multiverseId\': 389987}, \'multiverseid\': 389987}]', "[{'name': 'Schwebende Wiesen', 'text': 'Die Schwebenden Wiesen kommen getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {W}.\\nUmwandlung {2} ({2}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390168&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3fffcfbf-bb5c-4294-9a66-8e8f452c50e3', 'multiverseId': 390168}, 'multiverseid': 390168}, {'name': 'Pradera a la deriva', 'text': 'La Pradera a la deriva entra al campo de batalla girada.\\n{T}: Agrega {W} a tu reserva de maná.\\nCiclo {2}. ({2}, descartar esta carta: Roba una carta.)', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391516&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9da1626e-77fb-4fb5-9ce1-028c7ff1cdbe', 'multiverseId': 391516}, 'multiverseid': 391516}, {'name': 'Prairie dérivante', 'text': 'La Prairie dérivante arrive sur le champ de bataille engagée.\\n{T} : Ajoutez {W} à votre réserve.\\nRecyclage {2} ({2}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390505&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c4a098d4-8ea9-428e-9c85-0283f5832b71', 'multiverseId': 390505}, 'multiverseid': 390505}, {'name': 'Prateria Sospesa', 'text': 'La Prateria Sospesa entra nel campo di battaglia TAPpata.\\n{T}: Aggiungi {W} alla tua riserva di mana.\\nCiclo {2} ({2}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390842&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '38722f82-e07a-4ae5-a8d5-f9d5a4a9e315', 'multiverseId': 390842}, 'multiverseid': 390842}, {'name': '漂う牧草地', 'text': '漂う牧草地はタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{W}を加える。\\nサイクリング{2}（{2}, このカードを捨てる：カードを１枚引く。）', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391179&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '590b3db7-966a-40c0-981f-539970e8eecb', 'multiverseId': 391179}, 'multiverseid': 391179}, {'name': '飘移牧草地', 'text': '飘移牧草地须横置进战场。\\n{T}：加{W}到你的法术力池中。\\n循环{2}（{2}，弃掉此牌：抓一张牌。）', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389831&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4ca77cf7-9ed7-47de-80ff-f9deb89154cd', 'multiverseId': 389831}, 'multiverseid': 389831}]", '[{\'name\': \'Schwert der Rache\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+0 und hat Erstschlag, Wachsamkeit, Eile und verursacht Trampelschaden.\\nAusrüsten {3}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Wenn es von einem echten Gläubigen geführt wird, ist es egal, ob es ein Original oder eine Nachbildung ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390380&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8429094f-6ff8-4492-a9d7-d3377f5f4eff\', \'multiverseId\': 390380}, \'multiverseid\': 390380}, {\'name\': \'Espada de la venganza\', \'text\': \'La criatura equipada obtiene +2/+0 y tiene las habilidades de dañar primero, vigilancia, arrollar y prisa.\\nEquipar {3}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Cuando es esgrimida por un creyente, poco importa si la espada es una reliquia o una réplica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391728&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b716c833-8cf8-4531-b853-b4be68bba474\', \'multiverseId\': 391728}, \'multiverseid\': 391728}, {\'name\': \'Épée de la vengeance\', \'text\': "La créature équipée gagne +2/+0 et a l\'initiative, la vigilance, le piétinement et la célérité.\\nÉquipement {3}", \'type\': \'Artefact : équipement\', \'flavor\': "Tant qu\'elle est brandie par un vrai croyant, peu importe que l\'épée soit une relique ou une réplique.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390717&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a424435-cd46-4aa9-a490-8632eadd182f\', \'multiverseId\': 390717}, \'multiverseid\': 390717}, {\'name\': \'Spada della Vendetta\', \'text\': \'La creatura equipaggiata prende +2/+0 e ha attacco improvviso, cautela, travolgere e rapidità.\\nEquipaggiare {3}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Quando impugnata da un vero credente, poco importa se la spada è una reliquia o una replica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391054&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25f01c94-ff95-4618-b0b9-89c7682b826b\', \'multiverseId\': 391054}, \'multiverseid\': 391054}, {\'name\': \'執念の剣\', \'text\': \'装備しているクリーチャーは、＋２/＋０の修整を受けるとともに先制攻撃と警戒とトランプルと速攻を持つ。\\n装備{3}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'献身的な信者が構えれば、その剣が神器か紛い物かは些細な問題になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391391&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e39b7cd0-0a3d-4672-a0d2-258de472a8be\', \'multiverseId\': 391391}, \'multiverseid\': 391391}, {\'name\': \'复仇剑\', \'text\': \'佩带此武具的生物得+2/+0且具有先攻，警戒，践踏与敏捷异能。\\n佩带{3}\', \'type\': \'神器～武具\', \'flavor\': \'只要握在真信者手上，这把剑是古物还是摹制品都不重要。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390043&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'344c97e4-3aa5-4377-a791-bfd32d13caac\', \'multiverseId\': 390043}, \'multiverseid\': 390043}]', '[{\'name\': \'Schädelstrammer\', \'text\': \'Die ausgerüstete Kreatur erhält +1/-1.\\nImmer wenn die ausgerüstete Kreatur stirbt, ziehe zwei Karten.\\nAusrüsten {1}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Das Gehirn ist ein wunderbarer Schatz, der in einem langweiligen Behältnis aus Knochen versteckt ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390350&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'973ba867-be2d-4a1c-95c5-9b32540af87c\', \'multiverseId\': 390350}, \'multiverseid\': 390350}, {\'name\': \'Engrampacráneo\', \'text\': \'La criatura equipada obtiene +1/-1.\\nSiempre que la criatura equipada muera, roba dos cartas.\\nEquipar {1}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'La mente es una recompensa hermosa encerrada en un molesto contenedor óseo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391698&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b40c401-9f7b-4dd5-a321-8372fd57fd69\', \'multiverseId\': 391698}, \'multiverseid\': 391698}, {\'name\': \'Pincecrâne\', \'text\': \'La créature équipée gagne +1/-1.\\nÀ chaque fois que la créature équipée meurt, piochez deux cartes.\\nÉquipement {1}\', \'type\': \'Artefact : équipement\', \'flavor\': "L\'esprit est une belle récompense enveloppée d\'une pellicule chiante en os.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390687&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'25cc09a6-98ac-446f-a219-cb6c7fdc06c1\', \'multiverseId\': 390687}, \'multiverseid\': 390687}, {\'name\': \'Morsa Cerebrale\', \'text\': \'La creatura equipaggiata prende +1/-1.\\nOgniqualvolta la creatura equipaggiata muore, pesca due carte.\\nEquipaggiare {1}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'La mente è un dono bellissimo racchiuso in un fastidioso contenitore osseo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391024&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'13098232-3c21-4b17-bcb8-00b8ed09cf80\', \'multiverseId\': 391024}, \'multiverseid\': 391024}, {\'name\': \'頭蓋骨絞め\', \'text\': \'装備しているクリーチャーは＋１/－１の修整を受ける。\\n装備しているクリーチャーが死亡するたび、カードを２枚引く。\\n装備{1}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'精神とは、面倒臭い骨の器に閉じ込められた素晴らしい褒章だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391361&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'96b7d5fe-cbfd-4836-8027-2e7a8fcaaca9\', \'multiverseId\': 391361}, \'multiverseid\': 391361}, {\'name\': \'备忘夹\', \'text\': \'佩带此武具的生物得+1/-1。\\n每当佩带此武具的生物死去时，抓两张牌。\\n佩带{1}\', \'type\': \'神器～武具\', \'flavor\': \'心灵就是裹藏在无用躯骨中的曼妙恩惠。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a45725ad-87df-41f0-9421-4a6c8c9bc0e6\', \'multiverseId\': 390013}, \'multiverseid\': 390013}]', '[{\'name\': \'Seele der Ernte\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn eine andere Nichtspielsteinkreatur unter deiner Kontrolle ins Spiel kommt, kannst du eine Karte ziehen.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Sie ist da, wenn ein Samen sprießt, wenn Kalebassen an den Ranken reifen und wenn die Ernter im Schein des Erntemonds das Getreide schneiden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390358&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5c41fb8-8ad0-48dc-9aec-aac98e263cc1\', \'multiverseId\': 390358}, \'multiverseid\': 390358}, {\'name\': \'Alma de la cosecha\', \'text\': \'Arrolla.\\nSiempre que otra criatura que no sea ficha entre al campo de batalla bajo tu control, puedes robar una carta.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Está presente cuando la semilla brota, cuando las calabazas maduran en la planta y cuando las guadañas siegan bajo la Luna de Cosecha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391706&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e27a935f-9bb8-4e0b-8f51-e28b792cccce\', \'multiverseId\': 391706}, \'multiverseid\': 391706}, {\'name\': \'Âme des moissons\', \'text\': "Piétinement\\nÀ chaque fois qu\'une autre créature non-jeton arrive sur le champ de bataille sous votre contrôle, vous pouvez piocher une carte.", \'type\': \'Créature : élémental\', \'flavor\': \'Elle est présente quand germe une graine, quand mûrissent les calebasses et quand les moissonneurs fauchent les grains à la lune des moissons.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390695&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b29bfae4-92b4-486c-812a-638abf75188c\', \'multiverseId\': 390695}, \'multiverseid\': 390695}, {\'name\': \'Anima della Mietitura\', \'text\': "Travolgere\\nOgniqualvolta un\'altra creatura non pedina entra nel campo di battaglia sotto il tuo controllo, puoi pescare una carta.", \'type\': \'Creatura — Elementale\', \'flavor\': \'È presente quando germoglia un seme, quando i frutti maturano sui tralci e quando i mietitori falciano il grano sotto la Luna del Raccolto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391032&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e0ddbdfe-306f-40c8-89c1-f47725d7d627\', \'multiverseId\': 391032}, \'multiverseid\': 391032}, {\'name\': \'収穫の魂\', \'text\': \'トランプル\\n他のトークンでないクリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたはカードを１枚引いてもよい。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'種から芽が出るときも、蔓の先に実がなるときも、収穫月のもとで穀物が刈り取られるときも、それは確かに存在している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391369&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04cfcd5a-c5b5-4a66-bd6d-6463ee4641a6\', \'multiverseId\': 391369}, \'multiverseid\': 391369}, {\'name\': \'收成灵\', \'text\': \'践踏\\n每当另一个非衍生物的生物在你的操控下进战场时，你可以抓一张牌。\', \'type\': \'生物～元素\', \'flavor\': \'无论是种子萌芽，藤瓜成熟，还是收割者在收获月割下谷粒，它时时都在。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390021&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b58e2515-3f1e-4654-be22-9db6f8ba94e3\', \'multiverseId\': 390021}, \'multiverseid\': 390021}]', "[{'name': 'Seelenwandlung', 'text': 'Zerstöre eine Kreatur deiner Wahl. Sie kann nicht regeneriert werden. Ihr Beherrscher bringt einen 1/1 weißen Geist-Kreaturenspielstein mit Flugfähigkeit ins Spiel.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390100&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4d456353-2202-401d-aa55-007c5fb265c2', 'multiverseId': 390100}, 'multiverseid': 390100}, {'name': 'Vestigio de vida', 'text': 'Destruye la criatura objetivo. No puede ser regenerada. Su controlador pone en el campo de batalla una ficha de criatura Espíritu blanca 1/1 con la habilidad de volar.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391448&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ffda15a1-d2aa-4ea6-874f-88077c443406', 'multiverseId': 391448}, 'multiverseid': 391448}, {'name': 'Destin posthume', 'text': 'Détruisez une créature ciblée. Elle ne peut pas être régénérée. Son contrôleur met sur le champ de bataille un jeton de créature 1/1 blanche Esprit avec le vol.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390437&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6ac8f24f-9df7-471c-9556-beac9c88fde0', 'multiverseId': 390437}, 'multiverseid': 390437}, {'name': 'Aldilà', 'text': 'Distruggi una creatura bersaglio. Non può essere rigenerata. Il suo controllore mette sul campo di battaglia una pedina creatura Spirito 1/1 bianca con volare.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390774&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '368faf8d-88b7-430b-a485-0b383beb7a23', 'multiverseId': 390774}, 'multiverseid': 390774}, {'name': '死後の生命', 'text': 'クリーチャー１体を対象とし、それを破壊する。それは再生できない。それのコントローラーは、飛行を持つ白の１/１のスピリット・クリーチャー・トークンを１体戦場に出す。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391111&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6c51d783-1e05-4f60-86f8-2e72a435e2fa', 'multiverseId': 391111}, 'multiverseid': 391111}, {'name': '来生', 'text': '消灭目标生物。它不能重生。其操控者将一个1/1白色，具飞行异能的精怪衍生生物放进战场。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389763&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '54826d62-2f7a-47fa-b0df-ddeddc4868b6', 'multiverseId': 389763}, 'multiverseid': 389763}]", '[{\'name\': \'Seidenpeitschen-Spinne\', \'text\': \'Reichweite\\n{X}{G}{G}: Die Seidenpeitschen-Spinne fügt allen fliegenden Kreaturen X Schadenspunkte zu.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Bis die Spinne kommt, um ihr Abendmahl zu verschlingen, wurden ihre Opfer durch die säurehaltige Seide schon zum Teil aufgelöst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390346&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b3fd797-8a51-4510-8233-5c5e3d22255d\', \'multiverseId\': 390346}, \'multiverseid\': 390346}, {\'name\': \'Araña azotaseda\', \'text\': \'Alcance.\\n{X}{G}{G}: La Araña azotaseda hace X puntos de daño a cada criatura con la habilidad de volar.\', \'type\': \'Criatura — Araña\', \'flavor\': \'Para cuando la araña sube a comerse su cena, la seda ácida ya ha disuelto parcialmente a sus víctimas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391694&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5bb6bd3-84a5-4d31-bc5d-12d10af72225\', \'multiverseId\': 391694}, \'multiverseid\': 391694}, {\'name\': \'Araignée fouettesoie\', \'text\': "Portée\\n{X}{G}{G} : L\'Araignée fouettesoie inflige X blessures à chaque créature avec le vol.", \'type\': \'Créature : araignée\', \'flavor\': "Au moment où l\'araignée vient déguster son dîner, la victime a déjà été partiellement dissoute par l\'acidité de la soie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f11eb7c8-fc98-4271-a8f5-11a8d8678591\', \'multiverseId\': 390683}, \'multiverseid\': 390683}, {\'name\': \'Ragno Setafrusta\', \'text\': \'Raggiungere\\n{X}{G}{G}: Il Ragno Setafrusta infligge X danni a ogni creatura con volare.\', \'type\': \'Creatura — Ragno\', \'flavor\': \'Quando il ragno si appresta a trangugiare la sua cena, la seta acida ha già parzialmente sciolto le sue vittime.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391020&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15917578-4911-4e91-a98d-ef5157962255\', \'multiverseId\': 391020}, \'multiverseid\': 391020}, {\'name\': \'絹鎖の蜘蛛\', \'text\': \'到達\\n{X}{G}{G}：絹鎖の蜘蛛は飛行を持つ各クリーチャーにそれぞれＸ点のダメージを与える。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'蜘蛛が夕食をすすりに来るまでに、犠牲者は酸性の絹によって部分的に溶け落ちている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391357&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c45c5519-4394-4fe7-a38c-d190ed74073f\', \'multiverseId\': 391357}, \'multiverseid\': 391357}, {\'name\': \'丝鞭蜘蛛\', \'text\': \'延势\\n{X}{G}{G}：丝鞭蜘蛛对每个具飞行异能的生物各造成X点伤害。\', \'type\': \'生物～蜘蛛\', \'flavor\': \'等到蜘蛛出来享用晚餐时，他的猎物已被酸性蛛网溶解大半。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390009&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c175de40-5008-423a-8538-5f53d6132ded\', \'multiverseId\': 390009}, \'multiverseid\': 390009}]', '[{\'name\': \'Serras Avatar\', \'text\': \'Stärke und Widerstandskraft von Serras Avatar sind gleich deinem Lebenspunktestand.\\nWenn Serras Avatar von irgendwoher auf einen Friedhof gelegt wird, mische ihn in die Bibliothek seines Besitzers.\', \'type\': \'Kreatur — Avatar\', \'flavor\': \'„Serra ist nicht tot. Sie lebt in mir weiter."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390341&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5d8692ed-3896-492d-99d0-18a162cd58f8\', \'multiverseId\': 390341}, \'multiverseid\': 390341}, {\'name\': \'Avatar de Serra\', \'text\': \'Tanto la fuerza como la resistencia del Avatar de Serra son iguales a tu total de vidas.\\nCuando el Avatar de Serra vaya a un cementerio desde cualquier parte, barájalo en la biblioteca de su propietario.\', \'type\': \'Criatura — Avatar\', \'flavor\': \'"Serra no está muerta. Sigue viviendo a través de mí".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391689&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0da393c6-8e08-434c-b20a-45a7bdaca6eb\', \'multiverseId\': 391689}, \'multiverseid\': 391689}, {\'name\': \'Avatar de Serra\', \'text\': "La force et l\'endurance de l\'Avatar de Serra sont chacune égales à votre total de points de vie.\\nQuand l\'Avatar de Serra est mis dans un cimetière d\'où qu\'il vienne, mélangez-le dans la bibliothèque de son propriétaire.", \'type\': \'Créature : avatar\', \'flavor\': "« Serra n\'est pas morte. Elle vit en moi. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390678&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f2c24cc2-f22b-4cd2-9e2b-f9cad7ccd81e\', \'multiverseId\': 390678}, \'multiverseid\': 390678}, {\'name\': \'Avatar di Serra\', \'text\': "La forza e la costituzione dell\'Avatar di Serra sono pari ai tuoi punti vita.\\nQuando l\'Avatar di Serra viene messo in un cimitero da qualsiasi zona, rimescolalo nel grimorio del suo proprietario.", \'type\': \'Creatura — Avatar\', \'flavor\': \'"Serra non è morta, poiché vive attraverso di me."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab058a16-4949-467a-a761-638edd5a5f60\', \'multiverseId\': 391015}, \'multiverseid\': 391015}, {\'name\': \'セラのアバター\', \'text\': \'セラのアバターのパワーとタフネスは、それぞれあなたのライフの総量に等しい。\\nセラのアバターがいずれかの領域から墓地に置かれたとき、これをオーナーのライブラリーに加えて切り直す。\', \'type\': \'クリーチャー — アバター\', \'flavor\': \'「セラは死んでいない。セラは私を介して生き続ける。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391352&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a45708f1-3823-4a44-a2d5-9fbf4a8a9ab4\', \'multiverseId\': 391352}, \'multiverseid\': 391352}, {\'name\': \'撒拉圣者\', \'text\': \'撒拉圣者的力量和防御力各等同于你的总生命。\\n当撒拉圣者从任何区域置入坟墓场时，将它洗入其拥有者的牌库。\', \'type\': \'生物～圣者\', \'flavor\': \'「撒拉并未死去。她仍活在我体内。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390004&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dbfacb6b-cc6f-4dd6-807c-0d849111bcf8\', \'multiverseId\': 390004}, \'multiverseid\': 390004}]', '[{\'name\': \'Sich entfaltende Wildnis\', \'text\': \'{T}, opfere die Sich entfaltende Wildnis: Durchsuche deine Bibliothek nach einer Standardland-Karte und bringe sie getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Ohne den störenden Einfluss der Zivilisation wird sich die Natur immer nach dem eigenen Bedarf formen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390183&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e039b33-c56e-4128-ba9c-292dba7789c1\', \'multiverseId\': 390183}, \'multiverseid\': 390183}, {\'name\': \'Terrenos expansivos\', \'text\': \'{T}, sacrificar los Terrenos expansivos: Busca en tu biblioteca una carta de tierra básica y ponla en el campo de batalla girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Sin las entrometidas manos de la civilización, la naturaleza siempre se moldeará según sus propias necesidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391531&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf369e1e-ce0d-4841-be97-157d5c1ff84a\', \'multiverseId\': 391531}, \'multiverseid\': 391531}, {\'name\': \'Étendues sauvages en évolution\', \'text\': \'{T}, sacrifiez les Étendues sauvages en évolution : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la sur le champ de bataille engagée. Mélangez ensuite votre bibliothèque.\', \'type\': \'Terrain\', \'flavor\': "Sans interférence de la civilisation, la nature s\'adapte toujours à ses propres besoins.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e52b864e-7e46-4b9c-a9dc-8a073ee87db4\', \'multiverseId\': 390520}, \'multiverseid\': 390520}, {\'name\': \'Terre Selvagge in Evoluzione\', \'text\': \'{T}, Sacrifica le Terre Selvagge in Evoluzione: Passa in rassegna il tuo grimorio per una carta terra base e mettila sul campo di battaglia TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Senza la presenza invasiva della civiltà, la natura plasmerà se stessa a seconda dei propri bisogni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390857&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc76e1fc-ace4-4fc5-9027-f2f594057c22\', \'multiverseId\': 390857}, \'multiverseid\': 390857}, {\'name\': \'進化する未開地\', \'text\': \'{T}, 進化する未開地を生け贄に捧げる：あなたのライブラリーから基本土地・カードを１枚探し、それをタップ状態で戦場に出す。その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'文明の手による介入がなければ、自然は必ずその必要に応じて自らを変容させる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391194&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'059f2aa9-f71e-43be-bdac-94e2f2aa1755\', \'multiverseId\': 391194}, \'multiverseid\': 391194}, {\'name\': \'成形野地\', \'text\': \'{T}，牺牲成形野地：从你的牌库中搜寻一张基本地牌，并将之横置进战场。然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'若没有文明的干预，自然将始终按照它自己的需求塑造自身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389846&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'667cf91f-f8e5-44ad-a222-01543236eaf6\', \'multiverseId\': 389846}, \'multiverseid\': 389846}]', '[{\'name\': \'Silberklingen-Paladin\', \'text\': \'Seelengebunden (Du kannst diese Kreatur an eine andere nicht gebundene Kreatur binden, wenn eine von beiden ins Spiel kommt. Sie bleiben verbunden, solange du die Kontrolle über beide Kreaturen hast.)\\nSolange der Silberklingen-Paladin an eine andere Kreatur gebunden ist, haben beide Kreaturen Doppelschlag.\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390347&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1fb7adc1-8a92-438e-b31d-df5703efb2a1\', \'multiverseId\': 390347}, \'multiverseid\': 390347}, {\'name\': \'Paladín espada plateada\', \'text\': \'Unir almas. (Puedes emparejar esta criatura con otra criatura no emparejada cuando cualquiera de ellas entre al campo de batalla. Permanecen emparejadas mientras controles ambas criaturas.)\\nMientras el Paladín espada plateada esté emparejado con otra criatura, ambas criaturas tienen la habilidad de dañar dos veces.\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391695&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'91c1e64d-69f4-4249-9e44-eeb0acf3a678\', \'multiverseId\': 391695}, \'multiverseid\': 391695}, {\'name\': "Paladin à la lame d\'argent", \'text\': "Association d\'âmes (Vous pouvez associer cette créature à une autre créature dissociée quand l\'une d\'elles arrive sur le champ de bataille. Elles restent associées tant que vous les contrôlez toutes les deux.)\\nTant que le Paladin à la lame d\'argent est associé à une autre créature, les deux créatures ont la double initiative.", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390684&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'193c2412-f0c1-40b2-a598-df460fcddef5\', \'multiverseId\': 390684}, \'multiverseid\': 390684}, {\'name\': "Paladino dalla Lama d\'Argento", \'text\': "Unione d\'anime (Puoi abbinare questa creatura a un\'altra creatura non abbinata quando una delle due entra nel campo di battaglia. Restano abbinate fintanto che le controlli entrambe.)\\nFintanto che il Paladino dalla Lama d\'Argento è abbinato a un\'altra creatura, entrambe le creature hanno doppio attacco.", \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391021&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91f03492-0599-4ea3-9d98-b3f80e3967f7\', \'multiverseId\': 391021}, \'multiverseid\': 391021}, {\'name\': \'銀刃の聖騎士\', \'text\': \'結魂（このクリーチャーか他のまだ組になっていないクリーチャーが戦場に出たとき、あなたはそれらを組にしてもよい。それらのクリーチャーは、あなたがその両方をコントロールし続けるかぎり組である。）\\n銀刃の聖騎士が他のクリーチャーと組になっているかぎり、両方のクリーチャーは二段攻撃を持つ。\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391358&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0c9b0f65-98ef-4310-86a9-6c02baf6e5a1\', \'multiverseId\': 391358}, \'multiverseid\': 391358}, {\'name\': \'银刃神圣武士\', \'text\': \'魂系（你可以将此生物与另一未搭档的生物在它们任一进战场时组搭档。于你同时操控这两者的时段内，它们持续搭档。）\\n只要银刃神圣武士与另一生物搭档，此两者便具有连击异能。\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390010&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54e704ea-5eaf-475e-b78d-a0dc65f31699\', \'multiverseId\': 390010}, \'multiverseid\': 390010}]', '[{\'name\': \'Silberrüstung\', \'text\': \'Die ausgerüstete Kreatur erhält +6/+6.\\nImmer wenn die ausgerüstete Kreatur angreift, zerstöre eine bleibende Karte deiner Wahl.\\nAusrüsten {6}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Der Erfinder von Mirrodin lebt immer noch, formt immer noch Metall und gebietet immer noch über die Welt erschütternde Kräfte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390105&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6bdaab54-0944-4f5d-bbac-3db99cd92c24\', \'multiverseId\': 390105}, \'multiverseid\': 390105}, {\'name\': \'Armadura de argentum\', \'text\': \'La criatura equipada obtiene +6/+6.\\nSiempre que la criatura equipada ataque, destruye el permanente objetivo.\\nEquipar {6}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'El creador de Mirrodin todavía vive, todavía da forma al metal, y todavía tiene un poder que puede sacudir el mundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391453&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9c987da3-5477-4518-a4aa-5007ca9ebe18\', \'multiverseId\': 391453}, \'multiverseid\': 391453}, {\'name\': "Armure d\'Argentum", \'text\': \'La créature équipée gagne +6/+6.\\nÀ chaque fois que la créature équipée attaque, détruisez le permanent ciblé.\\nÉquipement {6}\', \'type\': \'Artefact : équipement\', \'flavor\': "Le créateur de Mirrodin vit encore. Il continue de forger le métal et de contrôler une puissance à l\'échelle du monde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390442&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66c510c5-2787-428a-9e43-c34aede13b15\', \'multiverseId\': 390442}, \'multiverseid\': 390442}, {\'name\': \'Armatura di Argentum\', \'text\': \'La creatura equipaggiata prende +6/+6.\\nOgniqualvolta la creatura equipaggiata attacca, distruggi un permanente bersaglio.\\nEquipaggiare {6}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Il creatore di Mirrodin è ancora vivo, forgia ancora metalli e domina ancora un potere in grado di scuotere il mondo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390779&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4f7010a-21ce-49bf-a6f0-e1a477475739\', \'multiverseId\': 390779}, \'multiverseid\': 390779}, {\'name\': \'アージェンタムの鎧\', \'text\': \'装備しているクリーチャーは＋６/＋６の修整を受ける。\\n装備しているクリーチャーが攻撃するたび、パーマネント１つを対象とし、それを破壊する。\\n装備{6}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'ミラディンの造物主はまだ生きていて、金属を形作り続け、世界を揺るがす力を手にしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391116&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'155492cd-81ac-405b-8a17-ad2dfaca941d\', \'multiverseId\': 391116}, \'multiverseid\': 391116}, {\'name\': \'古银铠甲\', \'text\': \'佩带此武具的生物得+6/+6。\\n每当佩带此武具的生物攻击时，消灭目标永久物。\\n佩带{6}\', \'type\': \'神器～武具\', \'flavor\': \'秘罗地的创造者依旧活着，依旧塑造金属，也依旧持有惊天动地的力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1c292ab-3657-4140-b8b4-a331f9e9f900\', \'multiverseId\': 389768}, \'multiverseid\': 389768}]', '[{\'name\': \'Skirsdag-Hohepriester\', \'text\': \'Morbide — {T}, tappe zwei ungetappte Kreaturen, die du kontrollierst: Bringe einen 5/5 schwarzen Dämon-Kreaturenspielstein mit Flugfähigkeit ins Spiel. Aktiviere diese Fähigkeit nur, falls in diesem Zug eine Kreatur gestorben ist.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Thrabens Flehen stößt auf taube Ohren. Unseres nicht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390349&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5759346d-1991-4527-bc60-67bb6449b2a2\', \'multiverseId\': 390349}, \'multiverseid\': 390349}, {\'name\': \'Gran sacerdote Skirsdag\', \'text\': \'Necrario — {T}, girar dos criaturas enderezadas que controlas: Pon en el campo de batalla una ficha de criatura Demonio negra 5/5 con la habilidad de volar. Activa esta habilidad solo si una criatura murió este turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Las súplicas de Thraben caen en oídos sordos. Las nuestras, no."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391697&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9521abe3-6eda-45d5-ac90-402236b73e1d\', \'multiverseId\': 391697}, \'multiverseid\': 391697}, {\'name\': \'Grand prêtre de Skirsdag\', \'text\': "Morbidité — {T}, engagez deux créatures dégagées que vous contrôlez : Mettez sur le champ de bataille un jeton de créature 5/5 noire Démon avec le vol. N\'activez cette capacité que si une créature est morte ce tour-ci.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'« Les supplications de Thraben sont vaines. Pas les nôtres. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390686&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40a94495-272f-4d02-81ef-937e366ce1ee\', \'multiverseId\': 390686}, \'multiverseid\': 390686}, {\'name\': \'Sommo Sacerdote Skirsdag\', \'text\': \'Morboso — {T}, TAPpa due creature STAPpate che controlli: Metti sul campo di battaglia una pedina creatura Demone 5/5 nera con volare. Attiva questa abilità solo se è morta una creatura in questo turno.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Le preghiere di Thraben rimangono inascoltate. Ma non le nostre."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391023&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df8af974-e0cc-4563-b499-88e42cc0235d\', \'multiverseId\': 391023}, \'multiverseid\': 391023}, {\'name\': \'スカースダグの高僧\', \'text\': \'陰鬱 ― {T}, あなたがコントロールするアンタップ状態のクリーチャーを２体タップする：飛行を持つ黒の５/５のデーモン・クリーチャー・トークンを１体戦場に出す。この能力は、このターンにクリーチャーが死亡していた場合にのみ起動できる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'「スレイベンの嘆願は、聞こえぬ耳には届かぬ。我々のは届く。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391360&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7e3024f3-7b15-47fe-893e-b9491f839a02\', \'multiverseId\': 391360}, \'multiverseid\': 391360}, {\'name\': \'史革达高阶僧侣\', \'text\': \'丧心～{T}，横置两个由你操控且未横置的生物：将一个5/5黑色，具飞行异能的恶魔衍生生物放进战场。只能于有生物死去的回合中起动此异能。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「瑟班的祈祷无人听闻。我们的可不会。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'865d8910-849c-4511-b0cc-a9206416cc05\', \'multiverseId\': 390012}, \'multiverseid\': 390012}]', '[{\'name\': \'Smaragdmedaillon\', \'text\': \'Grüne Zaubersprüche, die du wirkst, kosten beim Wirken {1} weniger.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390176&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ac0b64e-777f-44c9-993e-eb4802886b8f\', \'multiverseId\': 390176}, \'multiverseid\': 390176}, {\'name\': \'Medallón de esmeralda\', \'text\': \'Te cuesta {1} menos lanzar los hechizos verdes.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391524&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b8d1bbf7-f5bc-4580-a251-671cbcd2eaad\', \'multiverseId\': 391524}, \'multiverseid\': 391524}, {\'name\': "Médaillon d\'émeraude", \'text\': \'Les sorts verts que vous lancez coûtent {1} de moins à lancer.\', \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23f48796-b131-48d7-b6da-dbc8ec1cd132\', \'multiverseId\': 390513}, \'multiverseid\': 390513}, {\'name\': \'Medaglione di Smeraldo\', \'text\': \'Le magie verdi che lanci costano {1} in meno per essere lanciate.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390850&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f9c7fee-08a8-41cf-aa6c-8ac032ba172a\', \'multiverseId\': 390850}, \'multiverseid\': 390850}, {\'name\': \'エメラルドの大メダル\', \'text\': \'あなたが唱える緑の呪文を唱えるためのコストは{1}少なくなる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391187&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48f3b772-a43d-4d0d-8cb5-6a3a69ca35e2\', \'multiverseId\': 391187}, \'multiverseid\': 391187}, {\'name\': \'翡翠徽章\', \'text\': \'你施放的绿色咒语减少{1}来施放。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389839&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dbc4852a-3335-49c8-b563-50f9567989ec\', \'multiverseId\': 389839}, \'multiverseid\': 389839}]', '[{\'name\': \'Sonnen-Titan\', \'text\': \'Wachsamkeit\\nImmer wenn der Sonnen-Titan ins Spiel kommt oder angreift, kannst du eine bleibende Karte deiner Wahl mit umgewandelten Manakosten von 3 oder weniger aus deinem Friedhof ins Spiel bringen.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Eine brennende Sonne, die nie untergeht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390373&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e4bc85e7-fc48-49a1-8077-52eb19c85c23\', \'multiverseId\': 390373}, \'multiverseid\': 390373}, {\'name\': \'Titán solar\', \'text\': \'Vigilancia.\\nSiempre que el Titán solar entre al campo de batalla o ataque, puedes regresar la carta de permanente objetivo con coste de maná convertido de 3 o menos de tu cementerio al campo de batalla.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Un sol ardiente que nunca se pone.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391721&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4f15a29-23ed-4656-8086-4e091ee7672a\', \'multiverseId\': 391721}, \'multiverseid\': 391721}, {\'name\': \'Titan solaire\', \'text\': "Vigilance\\nÀ chaque fois que le Titan solaire arrive sur le champ de bataille ou qu\'il attaque, vous pouvez renvoyer sur le champ de bataille depuis votre cimetière une carte de permanent ciblée avec un coût converti de mana inférieur ou égal à 3.", \'type\': \'Créature : géant\', \'flavor\': \'Un soleil brûlant qui ne se couche jamais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0925551a-eec2-4659-a86c-77174681c7e1\', \'multiverseId\': 390710}, \'multiverseid\': 390710}, {\'name\': \'Titano Solare\', \'text\': \'Cautela\\nOgniqualvolta il Titano Solare entra nel campo di battaglia o attacca, puoi rimettere sul campo di battaglia una carta permanente bersaglio con costo di mana convertito pari o inferiore a 3 dal tuo cimitero.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Un sole cocente che non tramonta mai.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391047&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17742d06-6960-4a97-b488-c1a36f651765\', \'multiverseId\': 391047}, \'multiverseid\': 391047}, {\'name\': \'太陽のタイタン\', \'text\': \'警戒\\n太陽のタイタンが戦場に出るか攻撃するたび、あなたの墓地にある点数で見たマナ・コストが３以下のパーマネント・カード１枚を対象とする。あなたはそれを戦場に戻してもよい。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'沈まない燃え盛る太陽。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391384&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'194bd4d9-c3ec-483d-bea6-8d8003d97e3e\', \'multiverseId\': 391384}, \'multiverseid\': 391384}, {\'name\': \'旭日泰坦\', \'text\': \'警戒\\n每当旭日泰坦进战场或攻击时，你可以将目标总法术力费用等于或小于3的永久物牌从你的坟墓场移回战场。\', \'type\': \'生物～巨人\', \'flavor\': \'永不落下的烈日。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390036&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1450d015-bba6-4af5-a7af-ec8d5369c426\', \'multiverseId\': 390036}, \'multiverseid\': 390036}]', '[{\'name\': \'Sonnenexplosions-Engel\', \'text\': \'Fliegend\\nWenn der Sonnenexplosions-Engel ins Spiel kommt, zerstöre alle getappten Kreaturen.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Es könnten Mächte existieren, die noch mächtiger als Phyrexia sind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390374&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4561cea3-a21c-40a3-a4ae-7f876c782b2d\', \'multiverseId\': 390374}, \'multiverseid\': 390374}, {\'name\': \'Ángel ráfaga solar\', \'text\': \'Vuela.\\nCuando el Ángel ráfaga solar entre al campo de batalla, destruye todas las criaturas giradas.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Puede que existan poderes aún más grandes que Pirexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391722&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d153df76-aecd-4c50-90c7-5c3ea4833b22\', \'multiverseId\': 391722}, \'multiverseid\': 391722}, {\'name\': \'Ange solaire\', \'text\': "Vol\\nQuand l\'Ange solaire arrive sur le champ de bataille, détruisez toutes les créatures engagées.", \'type\': \'Créature : ange\', \'flavor\': "Il se pourrait qu\'il existe des puissances encore plus redoutables que Phyrexia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d291897e-d57f-45e4-88a7-f2446ac1e7d9\', \'multiverseId\': 390711}, \'multiverseid\': 390711}, {\'name\': "Angelo dell\'Esplosione Solare", \'text\': "Volare\\nQuando l\'Angelo dell\'Esplosione Solare entra nel campo di battaglia, distruggi tutte le creature TAPpate.", \'type\': \'Creatura — Angelo\', \'flavor\': \'Potrebbero esistere poteri ancora più immensi di Phyrexia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391048&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'216f97e6-d514-4188-80c6-b214fa3b3b2d\', \'multiverseId\': 391048}, \'multiverseid\': 391048}, {\'name\': \'太陽破の天使\', \'text\': \'飛行\\n太陽破の天使が戦場に出たとき、すべてのタップ状態のクリーチャーを破壊する。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'ファイレクシアより大きな力も存在できうる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391385&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f9922cd-97a4-44d5-9c37-34ca81583358\', \'multiverseId\': 391385}, \'multiverseid\': 391385}, {\'name\': \'旭击天使\', \'text\': \'飞行\\n当旭击天使进战场时，消灭所有已横置的生物。\', \'type\': \'生物～天使\', \'flavor\': \'可能存在着比非瑞克西亚更强大的力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390037&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7e82c09-142a-438d-8670-d211203f8b11\', \'multiverseId\': 390037}, \'multiverseid\': 390037}]', '[{\'name\': \'Sonnenring\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {2}.\', \'type\': \'Artefakt\', \'flavor\': \'Die Kunst, das Licht eines fernen Sterns in einem Ring aus reinem Gold einzufangen, ist mit der Zeit verlorengegangen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390355&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f9ca932-8076-4f5b-8bf9-1fce12761fb8\', \'multiverseId\': 390355}, \'multiverseid\': 390355}, {\'name\': \'Anillo solar\', \'text\': \'{T}: Agrega {2} a tu reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': \'Se ha perdido en el tiempo el arte del artífice de atrapar la luz de una estrella distante en un anillo del oro más puro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391703&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c7f8688-14d5-4585-9556-a0bdacaf1930\', \'multiverseId\': 391703}, \'multiverseid\': 391703}, {\'name\': \'Anneau solaire\', \'text\': \'{T} : Ajoutez {2} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "L\'art de l\'artificier de piéger la lumière d\'un astre lointain dans un anneau d\'or le plus pur est désormais perdu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390692&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'175fc943-f2d2-4713-b700-612bbc090937\', \'multiverseId\': 390692}, \'multiverseid\': 390692}, {\'name\': \'Anello Solare\', \'text\': \'{T}: Aggiungi {2} alla tua riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': "Persa col tempo è l\'arte dell\'artefice di intrappolare la luce di una stella lontana in un anello di oro purissimo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391029&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a930236a-523c-4087-8d40-bb642a8c6e0d\', \'multiverseId\': 391029}, \'multiverseid\': 391029}, {\'name\': \'太陽の指輪\', \'text\': \'{T}：あなたのマナ・プールに{2}を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'遥かな星の光を最も純なる黄金の指輪に捕らえる工匠の技は、時の中で失われた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391366&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1dc4bdd9-2fc5-405f-938e-4881d0c4900e\', \'multiverseId\': 391366}, \'multiverseid\': 391366}, {\'name\': \'阳光戒\', \'text\': \'{T}：加{2}到你的法术力池中。\', \'type\': \'神器\', \'flavor\': \'神器师曾能利用至纯黄金打造的戒指捕获来自遥远星辰的光芒，这门技艺如今早已亡佚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'504e831d-699a-497b-ba54-b5dffe229927\', \'multiverseId\': 390018}, \'multiverseid\': 390018}]', '[{\'name\': \'Sonnenuhr des Sehers\', \'text\': \'Landung — Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, kannst du {2} bezahlen. Falls du dies tust, ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'„Der Schatten wandert auf den Gipfel zu. Ich schätze, dass wir bald die wahre Dunkelheit kennenlernen werden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390340&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94c52622-ddc6-49c3-a00c-fa9a9cb5e365\', \'multiverseId\': 390340}, \'multiverseid\': 390340}, {\'name\': \'Reloj de sol del vidente\', \'text\': \'Aterrizaje — Siempre que una tierra entre al campo de batalla bajo tu control, puedes pagar {2}. Si lo haces, roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'"La sombra va hacia el cenit. Predigo que pronto veremos la verdadera dimensión de la oscuridad".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391688&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'312677e2-57cb-42f7-bd23-8f5788db009b\', \'multiverseId\': 391688}, \'multiverseid\': 391688}, {\'name\': \'Cadran solaire du voyant\', \'text\': "Toucheterre — À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, vous pouvez payer {2}. Si vous faites ainsi, piochez une carte.", \'type\': \'Artefact\', \'flavor\': "« L\'ombre monte à son zénith. Je prédis que bientôt, nous connaîtrons la véritable mesure des ténèbres. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390677&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66221374-3c73-4788-8d0c-422f0b23ebbb\', \'multiverseId\': 390677}, \'multiverseid\': 390677}, {\'name\': \'Meridiana del Veggente\', \'text\': \'Terraferma — Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, puoi pagare {2}. Se lo fai, pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': \'"Le ombre si stanno muovendo verso la vetta. Immagino che presto ci renderemo conto della vera potenza dell\\\'oscurità."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391014&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7f1f058f-6f88-4cf6-9982-4213e0f16247\', \'multiverseId\': 391014}, \'multiverseid\': 391014}, {\'name\': \'予見者の日時計\', \'text\': \'上陸 ― 土地が１つあなたのコントロール下で戦場に出るたび、あなたは{2}を支払ってもよい。そうしたなら、カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'「影は頂上を指しています。おそらくもうすぐ真の闇を見ることになるでしょうね。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391351&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c8988522-1bf4-4ed7-ae61-6a889060a00a\', \'multiverseId\': 391351}, \'multiverseid\': 391351}, {\'name\': \'预言师日晷\', \'text\': \'地落～每当一个地在你的操控下进战场时，你可以支付{2}。若你如此作，则抓一张牌。\', \'type\': \'神器\', \'flavor\': \'「阴影逐渐向顶点移动。我预测我们很快将会见到黑暗的真正尺度。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390003&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'51499266-55bb-4776-823a-116f0fb331e2\', \'multiverseId\': 390003}, \'multiverseid\': 390003}]', "[{'name': 'Spaltsense', 'text': 'Einprägen — Wenn die Spaltsense ins Spiel kommt, durchsuche deine Bibliothek nach einer Länderkarte, schicke sie ins Exil und mische dann deine Bibliothek.\\nDie ausgerüstete Kreatur erhält +1/+1 für jedes Land im Spiel mit dem gleichen Namen wie die ins Exil geschickte Karte.\\nAusrüsten {3}', 'type': 'Artefakt — Ausrüstung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390370&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cc39784f-284f-40b2-b2f3-171f1778d0e7', 'multiverseId': 390370}, 'multiverseid': 390370}, {'name': 'Guadaña de estratos', 'text': 'Estampa — Cuando la Guadaña de estratos entre al campo de batalla, busca en tu biblioteca una carta de tierra, exíliala y luego baraja tu biblioteca.\\nLa criatura equipada obtiene +1/+1 por cada tierra en el campo de batalla con el mismo nombre que la carta exiliada.\\nEquipar {3}.', 'type': 'Artefacto — Equipo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391718&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b854d0e8-d259-479e-980a-cf72c5d503a7', 'multiverseId': 391718}, 'multiverseid': 391718}, {'name': 'Faux à strates', 'text': 'Empreinte — Quand la Faux à strates arrive sur le champ de bataille, cherchez dans votre bibliothèque une carte de terrain, exilez-la et mélangez ensuite votre bibliothèque.\\nLa créature équipée gagne +1/+1 pour chaque terrain sur le champ de bataille ayant le même nom que la carte exilée.\\nÉquipement {3}', 'type': 'Artefact : équipement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390707&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8df59c2c-c932-44ad-a13b-dc5e0a4dc09a', 'multiverseId': 390707}, 'multiverseid': 390707}, {'name': 'Falce delle Falde', 'text': 'Imprimere — Quando la Falce delle Falde entra nel campo di battaglia, passa in rassegna il tuo grimorio per una carta terra, esiliala, poi rimescola il tuo grimorio.\\nLa creatura equipaggiata prende +1/+1 per ogni terra sul campo di battaglia con lo stesso nome della carta esiliata.\\nEquipaggiare {3}', 'type': 'Artefatto — Equipaggiamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391044&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '962f0c52-0a88-40de-bbe9-c09128b27be9', 'multiverseId': 391044}, 'multiverseid': 391044}, {'name': '地層の鎌', 'text': '刻印 ― 地層の鎌が戦場に出たとき、あなたのライブラリーから土地・カードを１枚探し、それを追放し、その後あなたのライブラリーを切り直す。\\n装備しているクリーチャーは、その追放されているカードと同じ名前を持つ戦場に出ている土地１つにつき＋１/＋１の修整を受ける。\\n装備{3}', 'type': 'アーティファクト — 装備品', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391381&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f43656fa-7c08-4935-841a-44afcb3ef667', 'multiverseId': 391381}, 'multiverseid': 391381}, {'name': '地层镰刀', 'text': '压印～当地层镰刀进战场时，从你的牌库中搜寻一张地牌，将它放逐，然后将你的牌库洗牌。\\n战场上每有一个与所放逐的牌同名之地，佩带此武具的生物便得+1/+1。\\n佩带{3}', 'type': '神器～武具', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390033&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '37df3f08-d35b-4e7b-a99d-1e5ccb10cddd', 'multiverseId': 390033}, 'multiverseid': 390033}]", '[{\'name\': \'Speer aus Mondsilber\', \'text\': \'Die ausgerüstete Kreatur hat Erstschlag.\\nImmer wenn die ausgerüstete Kreatur angreift, bringe einen 4/4 weißen Engel-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\\nAusrüsten {4}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390272&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9cbbc0ec-1b74-407a-96e3-e8beb9426d69\', \'multiverseId\': 390272}, \'multiverseid\': 390272}, {\'name\': \'Lanza de platalunar\', \'text\': \'La criatura equipada tiene la habilidad de dañar primero.\\nSiempre que la criatura equipada ataque, pon en el campo de batalla una ficha de criatura Ángel blanca 4/4 con la habilidad de volar.\\nEquipar {4}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'229ea129-733d-452d-a549-4e9edeb9686d\', \'multiverseId\': 391620}, \'multiverseid\': 391620}, {\'name\': "Lance d\'argent de lune", \'text\': "La créature équipée a l\'initiative.\\nÀ chaque fois que la créature équipée attaque, mettez sur le champ de bataille un jeton de créature 4/4 blanche Ange avec le vol.\\nÉquipement {4}", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390609&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63525638-7dfb-4d34-945a-271971018183\', \'multiverseId\': 390609}, \'multiverseid\': 390609}, {\'name\': \'Lancia di Selenargento\', \'text\': \'La creatura equipaggiata ha attacco improvviso.\\nOgniqualvolta la creatura equipaggiata attacca, metti sul campo di battaglia una pedina creatura Angelo 4/4 bianca con volare.\\nEquipaggiare {4}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390946&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'36590f22-2f48-43de-8b16-c863a0940b80\', \'multiverseId\': 390946}, \'multiverseid\': 390946}, {\'name\': \'月銀の槍\', \'text\': \'装備しているクリーチャーは先制攻撃を持つ。\\n装備しているクリーチャーが攻撃するたび、飛行を持つ白の４/４の天使・クリーチャー・トークンを１体戦場に出す。\\n装備{4}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391283&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b559f20c-3812-452d-818a-67843adb80ca\', \'multiverseId\': 391283}, \'multiverseid\': 391283}, {\'name\': \'月银长矛\', \'text\': \'佩带此武具的生物具有先攻异能。\\n每当佩带此武具的生物攻击时，将一个4/4白色，具飞行异能的天使衍生生物放进战场。\\n佩带{4}\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389935&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93d1a6f9-e243-42b5-8dd0-71f4c2681dc3\', \'multiverseId\': 389935}, \'multiverseid\': 389935}]', '[{\'name\': \'Sphinx der Jwar-Insel\', \'text\': \'Fliegend\\nVerhüllt (Diese Kreatur kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.)\\nDu kannst dir die oberste Karte deiner Bibliothek anschauen. (Du kannst dies jederzeit tun.)\', \'type\': \'Kreatur — Sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390360&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f8d1657-3a20-403a-b346-e887d7965800\', \'multiverseId\': 390360}, \'multiverseid\': 390360}, {\'name\': \'Esfinge de la isla Jwar\', \'text\': \'Vuela.\\nVelo. (Esta criatura no puede ser objetivo de hechizos o habilidades.)\\nPuedes mirar la primera carta de tu biblioteca. (Puedes hacer esto en cualquier momento.)\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391708&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'022c5329-6ebb-4ceb-aed4-5cd8e0ead817\', \'multiverseId\': 391708}, \'multiverseid\': 391708}, {\'name\': "Sphinx de l\'île de Jwar", \'text\': \'Vol\\nLinceul (Cette créature ne peut pas être la cible de sorts ou de capacités.)\\nVous pouvez regarder la carte du dessus de votre bibliothèque. (Vous pouvez faire ceci à tout moment.)\', \'type\': \'Créature : sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8b5cad5-d113-4c40-84e1-153944303187\', \'multiverseId\': 390697}, \'multiverseid\': 390697}, {\'name\': "Sfinge dell\'Isola Jwar", \'text\': \'Volare\\nVelo (Questa creatura non può essere bersaglio di magie o abilità.)\\nPuoi guardare la prima carta del tuo grimorio. (Puoi farlo in qualsiasi momento.)\', \'type\': \'Creatura — Sfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'178056e8-5aad-491c-88c5-5166026c4bbc\', \'multiverseId\': 391034}, \'multiverseid\': 391034}, {\'name\': \'ジュワー島のスフィンクス\', \'text\': \'飛行\\n被覆（このクリーチャーは呪文や能力の対象にならない。）\\nあなたはあなたのライブラリーの一番上のカードを見てもよい。（これはいつでも行ってよい。）\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391371&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c321059f-7e15-47f8-a16e-7d6583dd57a1\', \'multiverseId\': 391371}, \'multiverseid\': 391371}, {\'name\': \'爪尔岛史芬斯\', \'text\': \'飞行\\n帷幕（此生物不能成为咒语或异能的目标。）\\n你可以检视你的牌库顶牌。（你可以随时如此作。）\', \'type\': \'生物～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390023&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4112032b-7ee8-4a1d-ba8f-8752f73cf688\', \'multiverseId\': 390023}, \'multiverseid\': 390023}]', '[{\'name\': \'Sphinx vom Magosi\', \'text\': \'Fliegend\\n{2}{U}: Ziehe eine Karte und lege dann eine +1/+1-Marke auf die Sphinx vom Magosi.\', \'type\': \'Kreatur — Sphinx\', \'flavor\': \'„Ein Rätsel ist eigentlich nur eine Falle für Kleingeistige, die mit dem Versprechen der Lösung hineingelockt werden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390361&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d48cc004-0d94-47d7-865a-917e067bbdcd\', \'multiverseId\': 390361}, \'multiverseid\': 390361}, {\'name\': \'Esfinge de Magosi\', \'text\': \'Vuela.\\n{2}{U}: Roba una carta, luego pon un contador +1/+1 sobre la Esfinge de Magosi.\', \'type\': \'Criatura — Esfinge\', \'flavor\': \'"Un acertijo no es más que una trampa para mentes pequeñas, atraídas por la ilusión de entenderlo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391709&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8d7e8de-584c-4501-84a1-6a8cc66a9aaa\', \'multiverseId\': 391709}, \'multiverseid\': 391709}, {\'name\': \'Sphinx de Magosi\', \'text\': \'Vol\\n{2}{U} : Piochez une carte et mettez ensuite un marqueur +1/+1 sur le Sphinx de Magosi.\', \'type\': \'Créature : sphinx\', \'flavor\': "« Une énigme n\'est rien d\'autre qu\'un piège pour les petits esprits, appâtés par une promesse de connaissance. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390698&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18d81033-af61-446f-83cd-5b189be05853\', \'multiverseId\': 390698}, \'multiverseid\': 390698}, {\'name\': \'Sfinge di Magosi\', \'text\': \'Volare\\n{2}{U}: Pesca una carta, poi metti un segnalino +1/+1 sulla Sfinge di Magosi.\', \'type\': \'Creatura — Sfinge\', \'flavor\': \'"Un enigma non è altro che una trappola per menti meschine, allettate dalla promessa di comprensione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f0eb99d-a8b2-4779-aef1-ed7147b88e04\', \'multiverseId\': 391035}, \'multiverseid\': 391035}, {\'name\': \'マゴーシのスフィンクス\', \'text\': \'飛行\\n{2}{U}：カードを１枚引き、その後マゴーシのスフィンクスの上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': \'「謎など、解答の保証で釣るちっぽけな精神の罠に過ぎぬ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391372&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'83652de2-eba7-465b-9aa2-107719b88927\', \'multiverseId\': 391372}, \'multiverseid\': 391372}, {\'name\': \'马格西史芬斯\', \'text\': \'飞行\\n{2}{U}：抓一张牌，然后在马格西史芬斯上放置一个+1/+1指示物。\', \'type\': \'生物～史芬斯\', \'flavor\': \'「谜语只不过是对付卑微心灵的陷阱，以终能理解的承诺为诱饵。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390024&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4bbbeb59-f017-4fde-acc2-23d5f5fb4e58\', \'multiverseId\': 390024}, \'multiverseid\': 390024}]', '[{\'name\': \'Sphinx von Uthuun\', \'text\': \'Fliegend\\nWenn die Sphinx von Uthuun ins Spiel kommt, decke die obersten fünf Karten deiner Bibliothek auf. Ein Gegner teilt diese Karten auf zwei Haufen auf. Nimm die Karten des einen Haufens auf deine Hand und lege die anderen auf deinen Friedhof.\', \'type\': \'Kreatur — Sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390362&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc582ecf-0e06-4f0d-bad4-bcea36b90bcc\', \'multiverseId\': 390362}, \'multiverseid\': 390362}, {\'name\': \'Esfinge de Uthuun\', \'text\': \'Vuela.\\nCuando la Esfinge de Uthuun entre al campo de batalla, muestra las cinco primeras cartas de tu biblioteca. Un oponente separa esas cartas en dos montones. Pon un montón en tu mano y el otro en tu cementerio.\', \'type\': \'Criatura — Esfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391710&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a2fe980-6e8e-44a5-b4b9-613cae903bfb\', \'multiverseId\': 391710}, \'multiverseid\': 391710}, {\'name\': "Sphinx d\'Uthuün", \'text\': "Vol\\nQuand le Sphinx d\'Uthuün arrive sur le champ de bataille, révélez les cinq cartes du dessus de votre bibliothèque. Un adversaire sépare ces cartes en deux tas. Mettez un tas dans votre main et l\'autre dans votre cimetière.", \'type\': \'Créature : sphinx\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390699&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d8893bd-b839-473c-9616-1e08032bdddc\', \'multiverseId\': 390699}, \'multiverseid\': 390699}, {\'name\': \'Sfinge di Uthuun\', \'text\': "Volare\\nQuando la Sfinge di Uthuun entra nel campo di battaglia, rivela le prime cinque carte del tuo grimorio. Un avversario separa quelle carte in due pile. Aggiungi alla tua mano una pila e metti l\'altra nel tuo cimitero.", \'type\': \'Creatura — Sfinge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391036&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9289fbbb-75d6-4b0b-a37d-ddacd4fe893f\', \'multiverseId\': 391036}, \'multiverseid\': 391036}, {\'name\': \'ウスーンのスフィンクス\', \'text\': \'飛行\\nウスーンのスフィンクスが戦場に出たとき、あなたのライブラリーの一番上から５枚のカードを公開する。対戦相手１人は、それらのカードを２つの束に分ける。一方の束をあなたの手札に加え、もう一方をあなたの墓地に置く。\', \'type\': \'クリーチャー — スフィンクス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391373&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d76c665-edc1-49b7-9d88-3ec534f57271\', \'multiverseId\': 391373}, \'multiverseid\': 391373}, {\'name\': \'乌屯史芬斯\', \'text\': \'飞行\\n当乌屯史芬斯进战场时，展示你牌库顶的五张牌。由任一对手将它们分成两堆。将其中一堆置于你手上，另一堆置入你的坟墓场。\', \'type\': \'生物～史芬斯\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390025&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b8c27dd-e173-4682-88ec-ac1a45bcc4d0\', \'multiverseId\': 390025}, \'multiverseid\': 390025}]', '[{\'name\': \'Sphäre des Kommandeurs\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe der Farbidentität deines Kommandeurs.\\nOpfere die Sphäre des Kommandeurs: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Sie ist im Einklang mit der Essenz ihres Meisters.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390140&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea7d4e88-3963-4b4b-a2ba-75da4ae58ff3\', \'multiverseId\': 390140}, \'multiverseid\': 390140}, {\'name\': \'Esfera del comandante\', \'text\': \'{T}: Agrega a tu reserva de maná un maná de cualquier color en la identidad de color de tu comandante.\\nSacrificar la Esfera del comandante: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Está en armonía con la esencia de su amo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391488&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52f0f6ab-e5f4-4d73-9bb4-bbaa38700610\', \'multiverseId\': 391488}, \'multiverseid\': 391488}, {\'name\': \'Sphère du commandant\', \'text\': "{T} : Ajoutez à votre réserve un mana de n\'importe quelle couleur de l\'identité couleur de votre commandant.\\nSacrifiez la Sphère du commandant : Piochez une carte.", \'type\': \'Artefact\', \'flavor\': "Elle s\'harmonise avec l\'essence de son maître.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390477&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5cf069d0-d85b-4ca8-9c4c-e33fc1240b5a\', \'multiverseId\': 390477}, \'multiverseid\': 390477}, {\'name\': \'Sfera del Comandante\', \'text\': "{T}: Aggiungi alla tua riserva di mana un mana di un qualsiasi colore nell\'identità di colore del tuo comandante.\\nSacrifica la Sfera del Comandante: Pesca una carta.", \'type\': \'Artefatto\', \'flavor\': "Si accorda all\'essenza del suo signore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390814&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f96d816-ff1a-42e9-9691-cfe1ead62abd\', \'multiverseId\': 390814}, \'multiverseid\': 390814}, {\'name\': \'統率者の宝球\', \'text\': \'{T}：あなたのマナ・プールに、あなたの統率者の固有色のうち１色の色のマナ１点を加える。\\n統率者の宝球を生け贄に捧げる：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'それはその主の本質と調和する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391151&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8a493eb0-bf59-42a3-9415-66d6d2e5592c\', \'multiverseId\': 391151}, \'multiverseid\': 391151}, {\'name\': \'指挥官法球\', \'text\': \'{T}：加一点法术力到你的法术力池中，其颜色为你指挥官标识色中的任一颜色。\\n牺牲指挥官法球：抓一张牌。\', \'type\': \'神器\', \'flavor\': \'它能与主人的精华同调。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389803&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6db5dbcb-8aa9-4c10-8501-4a91409f714e\', \'multiverseId\': 389803}, \'multiverseid\': 389803}]', "[{'name': 'Springflut-Überlebender', 'text': 'Morph {1}{U}{U} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur wirken. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Springflut-Überlebende aufgedeckt wird, wirf zwei Karten ab und ziehe dann drei Karten.', 'type': 'Kreatur — Mensch, Zauberer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390331&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'efce9a24-6430-4501-ab24-8ca3b02fdd41', 'multiverseId': 390331}, 'multiverseid': 390331}, {'name': 'Sobreviviente del Proyecto Resaca', 'text': 'Metamorfosis {1}{U}{U}. (Puedes lanzar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando el Sobreviviente del Proyecto Resaca se ponga boca arriba, descarta dos cartas y luego roba tres cartas.', 'type': 'Criatura — Hechicero humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391679&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4f8be193-a889-47bc-8ada-a6ed37415633', 'multiverseId': 391679}, 'multiverseid': 391679}, {'name': 'Rescapé du projet Jusant', 'text': 'Mue {1}{U}{U} (Vous pouvez lancer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la à tout moment pour son coût de mue.)\\nQuand le Rescapé du projet Jusant est retourné face visible, défaussez-vous de deux cartes, puis piochez trois cartes.', 'type': 'Créature : humain et sorcier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390668&type=card', 'language': 'French', 'identifiers': {'scryfallId': '99c8c0e2-a8fe-4fd8-9e75-03ecaf5f1083', 'multiverseId': 390668}, 'multiverseid': 390668}, {'name': 'Sopravvissuto della Marea', 'text': 'Metamorfosi {1}{U}{U} (Puoi lanciare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando il Sopravvissuto della Marea viene girato a faccia in su, scarta due carte, poi pesca tre carte.', 'type': 'Creatura — Mago Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391005&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '55cabfd5-b051-4f6c-b6cb-9673289c62b9', 'multiverseId': 391005}, 'multiverseid': 391005}, {'name': '激浪計画の生き残り', 'text': '変異{1}{U}{U}（あなたはこのカードを、{3}で２/２クリーチャーとして裏向きに唱えてもよい。これの変異コストで、これをいつでも表向きにしてよい。）\\n激浪計画の生き残りが表向きになったとき、カードを２枚捨て、その後カードを３枚引く。', 'type': 'クリーチャー — 人間・ウィザード', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391342&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a8520f9e-159d-43e2-88d7-f4b9d2fa5242', 'multiverseId': 391342}, 'multiverseid': 391342}, {'name': '激流余生者', 'text': '变身{1}{U}{U}（你可牌面朝下地施放此牌并支付{3}，将其当成2/2生物。可随时支付其变身费用使其翻回正面。）\\n当激流余生者翻回正面时，弃两张牌，然后抓三张牌。', 'type': '生物～人类／法术师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389994&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8701c623-b001-4c98-83d4-cd255a40cdb2', 'multiverseId': 389994}, 'multiverseid': 389994}]", '[{\'name\': \'Stachel aus Ish Sah\', \'text\': \'Wenn der Stachel aus Ish Sah ins Spiel kommt, zerstöre eine bleibende Karte deiner Wahl.\\nWenn der Stachel aus Ish Sah aus dem Spiel auf einen Friedhof gelegt wird, bringe den Stachel aus Ish Sah auf die Hand seines Besitzers zurück.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390363&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bbbebf54-c356-4772-b718-f393d6b248ab\', \'multiverseId\': 390363}, \'multiverseid\': 390363}, {\'name\': \'Espina de Ish Sah\', \'text\': \'Cuando la Espina de Ish Sah entre al campo de batalla, destruye el permanente objetivo.\\nCuando la Espina de Ish Sah vaya a un cementerio desde el campo de batalla, regresa la Espina de Ish Sah a la mano de su propietario.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391711&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2d696b4-be36-438b-8a24-615d8f7a5992\', \'multiverseId\': 391711}, \'multiverseid\': 391711}, {\'name\': "Échine d\'Ish Sah", \'text\': "Quand l\'Échine d\'Ish Sah arrive sur le champ de bataille, détruisez le permanent ciblé.\\nQuand l\'Échine d\'Ish Sah est mise dans un cimetière depuis le champ de bataille, renvoyez l\'Échine d\'Ish Sah dans la main de son propriétaire.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390700&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0262b26d-7acd-4b14-8672-092996501735\', \'multiverseId\': 390700}, \'multiverseid\': 390700}, {\'name\': \'Spina di Ish Sah\', \'text\': \'Quando la Spina di Ish Sah entra nel campo di battaglia, distruggi un permanente bersaglio.\\nQuando la Spina di Ish Sah viene messa in un cimitero dal campo di battaglia, falla tornare in mano al suo proprietario.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391037&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fbb3e982-3fe4-41bd-966d-0a946b997105\', \'multiverseId\': 391037}, \'multiverseid\': 391037}, {\'name\': \'イシュ・サーの背骨\', \'text\': \'イシュ・サーの背骨が戦場に出たとき、パーマネント１つを対象とし、それを破壊する。\\nイシュ・サーの背骨が戦場から墓地に置かれたとき、イシュ・サーの背骨をオーナーの手札に戻す。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391374&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dad881f3-f207-462b-be1a-2699328cbdb3\', \'multiverseId\': 391374}, \'multiverseid\': 391374}, {\'name\': \'伊沙脊柱\', \'text\': \'当伊沙脊柱进战场时，消灭目标永久物。\\n当伊沙脊柱从战场进入坟墓场时，将伊沙脊柱移回其拥有者的手上。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390026&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1298e527-f513-41a1-b641-2263ecce2fc0\', \'multiverseId\': 390026}, \'multiverseid\': 390026}]', "[{'name': 'Stein des Sagensuchers', 'text': '{3}, {T}: Ziehe drei Karten. Das Aktivieren dieser Fähigkeit kostet für jede Karte auf deiner Hand {1} mehr.', 'type': 'Artefakt', 'flavor': 'Magier kommen von nah und fern, um sich an seiner Weisheit zu ergötzen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390255&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dc99841f-abe9-4256-ad4f-5183352e6f37', 'multiverseId': 390255}, 'multiverseid': 390255}, {'name': 'Piedra del buscador de sabiduría', 'text': '{3}, {T}: Roba tres cartas. Cuesta {1} más activar esta habilidad por cada carta en tu mano.', 'type': 'Artefacto', 'flavor': 'De todos los rincones llegan magos para bañarse en su sapiencia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391603&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '084f4eae-81f2-4015-887d-36960606a5e5', 'multiverseId': 391603}, 'multiverseid': 391603}, {'name': 'Pierre du cherchesapience', 'text': '{3}, {T} : Piochez trois cartes. Cette capacité coûte {1} de plus à activer pour chaque carte dans votre main.', 'type': 'Artefact', 'flavor': 'Les mages viennent de loin pour baigner dans sa sagesse.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390592&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'dfc6b9b9-f6da-4394-8729-8fb30acf9ce5', 'multiverseId': 390592}, 'multiverseid': 390592}, {'name': 'Pietra del Cercatore di Leggende', 'text': '{3}, {T}: Pesca tre carte. Questa abilità costa {1} in più per essere attivata per ogni carta che hai in mano.', 'type': 'Artefatto', 'flavor': 'I maghi giungono da distanze sconfinate per bearsi alla luce della sua saggezza.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390929&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'edbc7548-0f3a-4217-b444-173faebf5943', 'multiverseId': 390929}, 'multiverseid': 390929}, {'name': '伝承探求者の石', 'text': '{3}, {T}：カードを３枚引く。この能力を起動するためのコストは、あなたの手札にあるカード１枚につき{1}多くなる。', 'type': 'アーティファクト', 'flavor': 'その英知に浴するため、魔道士たちは遠近関係なく各地からここに集結する。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391266&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '99e9c2b1-f90f-4fc4-b16b-07777a45800b', 'multiverseId': 391266}, 'multiverseid': 391266}, {'name': '觅智者灵石', 'text': '{3}，{T}：抓三张牌。你手上每有一张牌，此异能便增加{1}来起动。', 'type': '神器', 'flavor': '各处法师不远万里前来，只为亲沐其智慧光芒。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389918&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '13e9f841-2ab9-4ec0-ae9f-daf2adee3768', 'multiverseId': 389918}, 'multiverseid': 389918}]", '[{\'name\': \'Sternensturm\', \'text\': \'Der Sternensturm fügt allen Kreaturen X Schadenspunkte zu.\\nUmwandlung {3} ({3}, wirf diese Karte ab: Ziehe eine Karte.)\', \'type\': \'Spontanzauber\', \'flavor\': \'Seit der Katastrophe schauen die Überlebenden nur noch von Furcht erfüllt in den Sternenhimmel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390366&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc7f9762-5bf9-4e57-8af3-b1cdce62d54e\', \'multiverseId\': 390366}, \'multiverseid\': 390366}, {\'name\': \'Tormenta de estrellas\', \'text\': \'La Tormenta de estrellas hace X puntos de daño a cada criatura.\\nCiclo {3}. ({3}, descartar esta carta: Roba una carta.)\', \'type\': \'Instantáneo\', \'flavor\': \'Desde el desastre, los supervivientes de la ciudad contemplaban con temor el cielo estrellado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391714&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc29d6ef-7ebf-413b-a984-7e44a8c9334c\', \'multiverseId\': 391714}, \'multiverseid\': 391714}, {\'name\': \'Ouragan stellaire\', \'text\': "L\'Ouragan stellaire inflige X blessures à chaque créature.\\nRecyclage {3} ({3}, défaussez-vous de cette carte : Piochez une carte.)", \'type\': \'Éphémère\', \'flavor\': "Depuis le désastre, les survivants de la ville contemplaient les cieux constellés d\'étoiles avec effroi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390703&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32c6acd7-3d26-47ff-8d4c-b4477b1937b2\', \'multiverseId\': 390703}, \'multiverseid\': 390703}, {\'name\': \'Tempesta Stellare\', \'text\': \'La Tempesta Stellare infligge X danni a ogni creatura.\\nCiclo {3} ({3}, Scarta questa carta: Pesca una carta.)\', \'type\': \'Istantaneo\', \'flavor\': \'Dopo il disastro, i superstiti della città guardarono sempre il cielo cosparso di stelle con terrore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391040&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'462d1751-4d4c-4724-a5b8-c210ddd87b07\', \'multiverseId\': 391040}, \'multiverseid\': 391040}, {\'name\': \'星の嵐\', \'text\': \'星の嵐は各クリーチャーにそれぞれＸ点のダメージを与える。\\nサイクリング{3}（{3}, このカードを捨てる：カードを１枚引く。）\', \'type\': \'インスタント\', \'flavor\': \'災厄が起こった時から、街の生存者たちは星空を恐怖の目で見上げるようになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391377&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf71d7dd-f432-4217-945d-abb855683163\', \'multiverseId\': 391377}, \'multiverseid\': 391377}, {\'name\': \'流星暴\', \'text\': \'流星暴对每个生物各造成X点伤害。\\n循环{3}（{3}，弃掉此牌：抓一张牌。）\', \'type\': \'瞬间\', \'flavor\': \'亲历过那场浩劫的市民，如今无不望星色变。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390029&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e6a73707-a816-45d7-95c4-f37eb1262018\', \'multiverseId\': 390029}, \'multiverseid\': 390029}]', "[{'name': 'Stilles Dickicht', 'text': 'Das Stille Dickicht kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}.\\nUmwandlung {G} ({G}, wirf diese Karte ab: Ziehe eine Karte.)', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390401&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c4d92167-f385-4361-93d4-8e3074496db3', 'multiverseId': 390401}, 'multiverseid': 390401}, {'name': 'Maleza tranquila', 'text': 'La Maleza tranquila entra al campo de batalla girada.\\n{T}: Agrega {G} a tu reserva de maná.\\nCiclo {G}. ({G}, descartar esta carta: Roba una carta.)', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391749&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9731c701-dc39-479c-bac5-da066646d6bf', 'multiverseId': 391749}, 'multiverseid': 391749}, {'name': 'Halliers tranquilles', 'text': 'Les Halliers tranquilles arrivent sur le champ de bataille engagés.\\n{T} : Ajoutez {G} à votre réserve.\\nRecyclage {G} ({G}, défaussez-vous de cette carte : Piochez une carte.)', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390738&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7928c99b-2908-47da-ab9c-bf738652d78d', 'multiverseId': 390738}, 'multiverseid': 390738}, {'name': 'Boschetto Tranquillo', 'text': 'Il Boschetto Tranquillo entra nel campo di battaglia TAPpato.\\n{T}: Aggiungi {G} alla tua riserva di mana.\\nCiclo {G} ({G}, Scarta questa carta: Pesca una carta.)', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391075&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ebbe042c-8116-4895-8ecf-9d6176924549', 'multiverseId': 391075}, 'multiverseid': 391075}, {'name': '平穏な茂み', 'text': '平穏な茂みはタップ状態で戦場に出る。\\n{T}：あなたのマナ・プールに{G}を加える。\\nサイクリング{G}（{G}, このカードを捨てる：カードを１枚引く。）', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391412&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5321ce7f-3292-4e2a-bb5a-ae0d9ae214b1', 'multiverseId': 391412}, 'multiverseid': 391412}, {'name': '静谧灌丛', 'text': '静谧灌丛须横置进战场。\\n{T}：加{G}到你的法术力池中。\\n循环{G}（{G}，弃掉此牌：抓一张牌。）', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390064&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1744a6ba-3e03-485d-8f45-f1be145ce3d2', 'multiverseId': 390064}, 'multiverseid': 390064}]", '[{\'name\': \'Sturmflutkrake\', \'text\': \'Fluchsicher\\nLeutnant — Solange du deinen Kommandeur kontrollierst, erhält der Sturmflutkrake +2/+2 und hat „Immer wenn der Sturmflutkrake geblockt wird, kannst du zwei Karten ziehen."\', \'type\': \'Kreatur — Krake\', \'flavor\': \'Die meisten denken, Kraken werden nur von blinder Zerstörungswut geleitet. Doch sie bemerken nicht, mit welcher Präzision Kraken ein Schiff auseinandernehmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390369&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'203d8a91-a33e-4b8a-a5dd-72c2fd498d6b\', \'multiverseId\': 390369}, \'multiverseid\': 390369}, {\'name\': \'Kraken de la marejada\', \'text\': \'Antimaleficio.\\nTeniente — Mientras controles a tu comandante, el Kraken de la marejada obtiene +2/+2 y tiene "Siempre que el Kraken de la marejada sea bloqueado, puedes robar dos cartas".\', \'type\': \'Criatura — Kraken\', \'flavor\': \'Muchos ven a los krakens como criaturas de una violencia irracional y no advierten su minuciosidad a la hora de desmantelar una nave.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391717&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eaf78fcc-ee83-4b1b-9444-a42471032195\', \'multiverseId\': 391717}, \'multiverseid\': 391717}, {\'name\': \'Kraken déferlorage\', \'text\': \'Défense talismanique\\nLieutenant — Tant que vous contrôlez votre commandant, le Kraken déferlorage gagne +2/+2 et a « À chaque fois que le Kraken déferlorage devient bloqué, vous pouvez piocher deux cartes. »\', \'type\': \'Créature : kraken\', \'flavor\': "Beaucoup considèrent la violence des krakens comme aléatoire, faute d\'avoir remarqué leur soin méticuleux lorsqu\'ils démolissent un navire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390706&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d9f737a-a04f-495f-b63e-2a51980fee47\', \'multiverseId\': 390706}, \'multiverseid\': 390706}, {\'name\': \'Kraken della Mareggiata\', \'text\': \'Anti-malocchio\\nTenente — Fintanto che controlli il tuo comandante, il Kraken della Mareggiata prende +2/+2 e ha "Ogniqualvolta il Kraken della Mareggiata viene bloccato, puoi pescare due carte".\', \'type\': \'Creatura — Kraken\', \'flavor\': \'I più vedono i kraken come creature dalla violenza arbitraria, senza fermarsi ad apprezzare la cura meticolosa con cui disassemblano le navi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391043&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c51282c-683d-4e3c-be3d-fd09852aa52e\', \'multiverseId\': 391043}, \'multiverseid\': 391043}, {\'name\': \'うねり嵐のクラーケン\', \'text\': \'呪禁\\n副官 ― あなたがあなたの統率者をコントロールしているかぎり、うねり嵐のクラーケンは＋２/＋２の修整を受けるとともに「うねり嵐のクラーケンがブロックされた状態になるたび、あなたはカードを２枚引いてもよい。」を持つ。\', \'type\': \'クリーチャー — クラーケン\', \'flavor\': \'多くの者はクラーケンを気ままな乱暴者としてしか認識していないが、彼らが船舶を分解する際に細部に注意を払っている点を見落としている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391380&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cdd4e912-d7e8-49f5-9529-045de40f8999\', \'multiverseId\': 391380}, \'multiverseid\': 391380}, {\'name\': \'岚涛巨海兽\', \'text\': \'辟邪\\n副官～只要你操控你的指挥官，岚涛巨海兽便得+2/+2且具有「每当岚涛巨海兽被阻挡时，你可以抓两张牌。」\', \'type\': \'生物～巨海兽\', \'flavor\': \'许多人都认为巨海怪只会恣意施暴，却从未注意到它们破坏船舶时的细腻讲究。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3cda11ba-8b64-42e9-9418-c606f67ef455\', \'multiverseId\': 390032}, \'multiverseid\': 390032}]', '[{\'name\': \'Stählerner Höllendrache\', \'text\': \'Fliegend\\n{2}: Der Stählerne Höllendrache erhält +1/+0 bis zum Ende des Zuges.\\n{X}: Zerstöre jede bleibende Karte mit umgewandelten Manakosten von X, die kein Land ist und deren Beherrscher in diesem Zug vom Stählernen Höllendrachen Kampfschaden zugefügt wurde. Aktiviere diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Artefaktkreatur — Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390367&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'229a9f57-a0d2-4b8c-9758-4b296d7b89a0\', \'multiverseId\': 390367}, \'multiverseid\': 390367}, {\'name\': \'Engendro de acero\', \'text\': \'Vuela.\\n{2}: El Engendro de acero obtiene +1/+0 hasta el final del turno.\\n{X}: Destruye cada permanente que no sea tierra con coste de maná convertido de X cuyo controlador haya recibido daño de combate del Engendro de acero este turno. Activa esta habilidad solo una vez por turno.\', \'type\': \'Criatura artefacto — Dragón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391715&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb558237-6948-454c-bbcd-5745d3e6cda0\', \'multiverseId\': 391715}, \'multiverseid\': 391715}, {\'name\': "Escouflenfer d\'acier", \'text\': "Vol\\n{2} : L\'Escouflenfer d\'acier gagne +1/+0 jusqu\'à la fin du tour.\\n{X} : Détruisez chaque permanent non-terrain avec un coût converti de mana de X dont le contrôleur a subi des blessures de combat par l\'Escouflenfer d\'acier ce tour-ci. N\'activez cette capacité qu\'une seule fois par tour.", \'type\': \'Créature-artefact : dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390704&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a8eeb5d-881e-4dba-9bf9-136f16287681\', \'multiverseId\': 390704}, \'multiverseid\': 390704}, {\'name\': "Nibbio Infernale d\'Acciaio", \'text\': "Volare\\n{2}: Il Nibbio Infernale d\'Acciaio prende +1/+0 fino alla fine del turno.\\n{X}: Distruggi ogni permanente non terra con costo di mana convertito pari a X al cui controllore è stato inflitto danno da combattimento dal Nibbio Infernale d\'Acciaio in questo turno. Attiva questa abilità solo una volta per turno.", \'type\': \'Creatura Artefatto — Drago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391041&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7bc97cf5-f57c-4cba-940c-c1f7c7b294d5\', \'multiverseId\': 391041}, \'multiverseid\': 391041}, {\'name\': \'鋼のヘルカイト\', \'text\': \'飛行\\n{2}：ターン終了時まで、鋼のヘルカイトは＋１/＋０の修整を受ける。\\n{X}：このターンに鋼のヘルカイトによって戦闘ダメージを与えられたプレイヤーがコントロールする、点数で見たマナ・コストがＸの土地でない各パーマネントをそれぞれ破壊する。この能力は、毎ターン１回のみ起動できる。\', \'type\': \'アーティファクト・クリーチャー — ドラゴン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f05bc4d-d89c-459b-97f1-eec42879e2e0\', \'multiverseId\': 391378}, \'multiverseid\': 391378}, {\'name\': \'钢铁残虐者\', \'text\': \'飞行\\n{2}：钢铁残虐者得+1/+0直到回合结束。\\n{X}：对本回合已受到钢铁残虐者之战斗伤害的牌手而言，消灭所有由他操控且总法术力费用为X的非地永久物。此异能每回合只能起动一次。\', \'type\': \'神器生物～龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390030&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'11dfd5b2-a212-4f09-8f7e-74fd109d1a8b\', \'multiverseId\': 390030}, \'multiverseid\': 390030}]', '[{\'name\': \'Stürmischer Äther\', \'text\': \'Bringe sechs bleibende Karten deiner Wahl, die keine Länder sind, auf die Hand ihrer Besitzer zurück.\', \'type\': \'Hexerei\', \'flavor\': \'In Erwartung des Angriffs fand sich die Bürgerwehr auf dem Hauptplatz ein, doch die Riesen kamen nicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390098&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b51d3536-94f5-464d-af90-45ffbd37a682\', \'multiverseId\': 390098}, \'multiverseid\': 390098}, {\'name\': \'Vendaval del éter\', \'text\': \'Regresa seis permanentes objetivo que no sean tierra a las manos de sus propietarios.\', \'type\': \'Conjuro\', \'flavor\': \'La milicia formó en la plaza central esperando la embestida, pero los gigantes no llegaron a cargar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391446&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5cd58e5-a880-4e70-8096-2305cf22542a\', \'multiverseId\': 391446}, \'multiverseid\': 391446}, {\'name\': "Bourrasque d\'Aether", \'text\': \'Renvoyez six permanents non-terrains ciblés dans les mains de leurs propriétaires.\', \'type\': \'Rituel\', \'flavor\': "En prévision de l\'assaut, la milice s\'était postée en formation sur la place centrale, mais les géants avaient disparu bien avant d\'y arriver.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390435&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5f6a10b7-99e4-41da-be2b-f1e8164a46d4\', \'multiverseId\': 390435}, \'multiverseid\': 390435}, {\'name\': \'Burrasca Eterea\', \'text\': \'Fai tornare sei permanenti non terra bersaglio in mano ai rispettivi proprietari.\', \'type\': \'Stregoneria\', \'flavor\': "La milizia si dispose in formazione nella piazza centrale in attesa dell\'assalto, ma i giganti non la raggiunsero mai.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390772&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'772e8c4a-b2d7-4605-b2b2-219f5e7af5f1\', \'multiverseId\': 390772}, \'multiverseid\': 390772}, {\'name\': \'霊気の突風\', \'text\': \'土地でないパーマネント６つを対象とし、それらをオーナーの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'猛攻を待つべく中央広場に集合した民兵たちであったが、巨人たちはそこに到達することはなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391109&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b11e5024-a31b-429e-a2cb-79dede064fc2\', \'multiverseId\': 391109}, \'multiverseid\': 391109}, {\'name\': \'乙太狂风\', \'text\': \'将六个目标非地永久物移回其拥有者手上。\', \'type\': \'法术\', \'flavor\': \'义勇兵已在中心广场严阵以待，准备抵御巨人强大攻势，但敌人却从未出现。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=389761&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d65e8c41-bd86-4edd-845c-235104378806\', \'multiverseId\': 389761}, \'multiverseid\': 389761}]', "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390375&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4af11a1c-9c37-4b0c-a695-669d30a74378', 'multiverseId': 390375}, 'multiverseid': 390375}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391723&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3944fadd-af74-476d-944d-22eccba39b2a', 'multiverseId': 391723}, 'multiverseid': 391723}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=390712&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e0f8e0f9-ec24-4039-af00-53229fa747c7', 'multiverseId': 390712}, 'multiverseid': 390712}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=391049&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '45ddbe20-806f-4346-996b-940fef138e3b', 'multiverseId': 391049}, 'multiverseid': 391049}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'h