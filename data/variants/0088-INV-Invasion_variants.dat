ers/Image.ashx?multiverseid=183761&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c47cd670-619e-4510-b613-05bf1a8eaf62', 'multiverseId': 183761}, 'multiverseid': 183761}, {'name': 'Isla', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ee7af39b-ac72-4d53-8e5f-0b64b0ff9d7e'}, 'multiverseid': None}, {'name': 'Île', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185635&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd1da0424-2058-46cb-8b29-15178419dce7', 'multiverseId': 185635}, 'multiverseid': 185635}, {'name': 'Isola', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4e445c83-36fc-4fa8-888e-b17c023f6a4d'}, 'multiverseid': None}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '82e05a97-0c74-4060-a7a1-e898edee06b5'}, 'multiverseid': None}, {'name': 'Ilha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '85083c57-88fa-4dad-9cfd-e1374ca48bfe'}, 'multiverseid': None}]", '[{\'name\': \'Jadeegel\', \'text\': \'Grüne Zaubersprüche, die Du spielst, kosten {G} mehr.\', \'type\': \'Kreatur — Egel\', \'flavor\': \'„Wir benötigten Magie, um auch nur einen der Steine zu entfernen. Und fünf Leute, um ihn zu tragen." —Tolarianische Forschungsergebnisse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183608&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b939f8a-ff49-478e-91a7-245c967c1441\', \'multiverseId\': 183608}, \'multiverseid\': 183608}, {\'name\': \'Sanguijuela de Jade\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e17ca0f5-3ceb-4a22-a511-c56ea05b8d4e\'}, \'multiverseid\': None}, {\'name\': \'Sangsue de jade\', \'text\': \'Les sorts verts que vous jouez coûtent {G} de plus à jouer.\', \'type\': \'Créature : sangsue\', \'flavor\': \'« Il faut user de magie pour retirer une de ces pierres, puis il faut cinq personnes pour la porter. » — Notes scientifiques, Tolaria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185482&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29427b83-a7b1-4541-94c6-959b1bc8f80e\', \'multiverseId\': 185482}, \'multiverseid\': 185482}, {\'name\': \'Sanguisuga di Giada\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3be095c8-e037-47c6-aa85-723aefd5c82a\'}, \'multiverseid\': None}, {\'name\': \'翡翠のヒル\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7b1f5ae3-943b-4b21-a004-ccb72685f124\'}, \'multiverseid\': None}, {\'name\': \'Sanguessuga de Jade\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a32cfcf3-35cd-4605-84ed-b3236de85101\'}, \'multiverseid\': None}]', '[{\'name\': \'Jagender Kavu\', \'text\': \'{1}{R}{G}, {T}: Entferne den Jagenden Kavu und eine nichtfliegende Kreatur Deiner Wahl, die Dich angreift, ganz aus dem Spiel.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Die Völker Dominarias kämpften bereitwillig Seite an Seite mit den Kavus... bis die Kavus feststellten, daß Dominarier auch recht lecker schmecken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183670&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f8579bbc-e70a-40d8-afad-ff33d86d7801\', \'multiverseId\': 183670}, \'multiverseid\': 183670}, {\'name\': \'Kavu Cazador\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e8e509e-d44f-4a5f-8736-682f394bec95\'}, \'multiverseid\': None}, {\'name\': \'Kavru chasseur\', \'text\': \'{1}{R}{G}{T} : Retirez de la partie le Kavru chasseur et la créature sans le vol ciblée qui vous attaque.\', \'type\': \'Créature : kavru\', \'flavor\': "Les Dominarians se battaient volontiers aux côtés des kavrus... jusqu\'à ce que certains kavrus trouvent certains Dominarians appétissants.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185544&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7464953a-a849-4b62-b06f-864195c3f6fc\', \'multiverseId\': 185544}, \'multiverseid\': 185544}, {\'name\': \'Kavu in Caccia\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfcdda65-df81-49bc-b6de-e1f85cc06a09\'}, \'multiverseid\': None}, {\'name\': \'狩りをするカヴー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59abafb8-c24e-4177-8e96-7d1d8a779f40\'}, \'multiverseid\': None}, {\'name\': \'Kavu Caçador\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c3f5df8-0cde-48b7-8c3d-19cab385780e\'}, \'multiverseid\': None}]', '[{\'name\': \'Jakobsmuschelbrosche\', \'text\': \'{T}: Erhöhe Deinen Manavorrat um {W} oder {U}.\', \'type\': \'Artefakt\', \'flavor\': \'„Heute fiel hier in Kinymu, hunderte Meilen vom Meer entfernt, eine Muschel vom Himmel. Ich bin unsicher — soll ich einen Vogel oder eine Frau schnitzen?" —Isel, Meisterschnitzer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183734&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2a8cacc7-95f3-4cb1-ad2b-a2b63a99ac11\', \'multiverseId\': 183734}, \'multiverseid\': 183734}, {\'name\': \'Camafeo Concha Marina\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d32a7a32-3624-4244-9e10-e589ef431e7f\'}, \'multiverseid\': None}, {\'name\': \'Camée de nacre\', \'text\': \'{T}: Ajoutez {W} ou {U} à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "« Aujourd\'hui un coquillage est tombé du ciel vide de Kinymu, à plusieurs lieues de la mer. J\'hésite. Dois-je sculpter une sirène ou un oiseau ? » — Iseul, maître sculpteur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185608&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2998f77a-74b6-410b-bd8f-9418b45d46e7\', \'multiverseId\': 185608}, \'multiverseid\': 185608}, {\'name\': \'Conchiglia Intagliata\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5c4a630-e118-40ca-8d58-9c9305da44ed\'}, \'multiverseid\': None}, {\'name\': \'貝殻のカメオ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'358a4d34-66b8-40aa-9380-d8c33fb274eb\'}, \'multiverseid\': None}, {\'name\': \'Camafeu de Concha\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76da4d2c-11b8-44b5-925f-e32bc35fc1e3\'}, \'multiverseid\': None}]', '[{\'name\': \'Juntu-Pfähle\', \'text\': \'Kreaturen mit Stärke 1 oder weniger enttappen nicht während des Enttapp-Segments ihres Beherrschers.\', \'type\': \'Artefakt\', \'flavor\': \'„Wer nicht überleben kann, zählt ohnehin nicht." —Tsabo Tavoc\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ab81ec3-eeef-43b6-9e57-5df565203d91\', \'multiverseId\': 183727}, \'multiverseid\': 183727}, {\'name\': \'Estacas Juntu\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f494a21-fef2-415b-83ef-70b121f2dc14\'}, \'multiverseid\': None}, {\'name\': \'Piques de Juntu\', \'text\': \'Les créatures avec une force de 1 ou moins ne se dégagent pas pendant les étapes de dégagement de leurs contrôleurs.\', \'type\': \'Artefact\', \'flavor\': "« Peu m\'importe ceux qui ne survivront pas. » — Tsabo Tavoc.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185601&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ddda0813-35c6-4a2a-b3e9-57a0f5a8c71c\', \'multiverseId\': 185601}, \'multiverseid\': 185601}, {\'name\': \'Spuntoni Juntu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'554d5ad7-e48b-43e6-a372-6c65a862401c\'}, \'multiverseid\': None}, {\'name\': \'ジュントゥのくい\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea6936bf-f1d4-49dc-b507-e5512dbb4566\'}, \'multiverseid\': None}, {\'name\': \'Estacas Juntu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad0bc935-4885-4ffc-b116-359d5f146c24\'}, \'multiverseid\': None}]', '[{\'name\': \'Kaiserin Galina\', \'text\': \'{U}{U}, {T}: Übernimm die Kontrolle über eine Legende oder eine legendäre bleibende Karte. (Dieser Effekt endet nicht am Ende des Zuges.)\', \'type\': \'Kreatur — Legende\', \'flavor\': \'„Über den Wellen bist Du gewiß groß und mächtig. Hier unten allerdings gehörst Du mir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183472&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79d806e5-671c-406a-8ab9-dd1023a03933\', \'multiverseId\': 183472}, \'multiverseid\': 183472}, {\'name\': \'Emperatriz Galina\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00ee0ece-2ba7-4431-b30d-ca743ee6e354\'}, \'multiverseid\': None}, {\'name\': \'Impératrice Galiva\', \'text\': "{U}{U}, {T}: Acquérez le contrôle de la légende ciblée ou du permanent légendaire ciblé. (Cet effet ne s\'arrête pas à la fin du tour.)", \'type\': \'Créature : légende\', \'flavor\': "« Tout puissant que vous soyez au-dessus des vagues, ici vous m\'appartenez. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34db3b48-f936-4705-9790-43ff0b1757b0\', \'multiverseId\': 185346}, \'multiverseid\': 185346}, {\'name\': \'Imperatrice Galina\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e927d9b6-82c3-436a-a774-0492a7494b0c\'}, \'multiverseid\': None}, {\'name\': \'女帝ガリーナ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43591e70-2cbc-4ca2-92bd-bf4b39186fb1\'}, \'multiverseid\': None}, {\'name\': \'Imperatriz Galina\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45959455-1f9d-4367-b510-bab78889ba68\'}, \'multiverseid\': None}]', '[{\'name\': \'Kampf der Geistesstärke\', \'text\': \'Immer wenn ein Spieler ein oder mehrere Ziele bestimmt, dreht jeder die Spieler die oberste Karte seiner Bibliothek um. Derjenige Spieler, der die Karte mit den höchsten umgewandelten Manakosten aufdeckt, kann das Ziel bzw. die Ziele umändern. Wenn zwei oder mehr Karten gemeinsam die höchsten Manakosten haben, bleiben das Ziel bzw. die Ziele unverändert.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afde90ca-4425-493a-84d9-f42b9619ac83\', \'multiverseId\': 183486}, \'multiverseid\': 183486}, {\'name\': \'Batalla Psíquica\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8be25b36-bd6a-4867-9327-6a1e04625d1d\'}, \'multiverseid\': None}, {\'name\': \'Bataille psychique\', \'text\': "À chaque fois qu\'un joueur choisit une ou plusieurs cibles, chaque joueur révèle la carte du dessus de sa bibliothèque. Le joueur qui révèle la carte avec le plus haut coût converti de mana peut changer la ou les cibles. Si deux cartes ou plus sont à égalité pour le plus haut coût, la ou les cibles restent inchangées.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185360&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f95fb706-03c5-454b-91bb-e0368a14c46e\', \'multiverseId\': 185360}, \'multiverseid\': 185360}, {\'name\': \'Battaglia Psichica\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5334b182-556c-4625-8b0c-6367edc34c33\'}, \'multiverseid\': None}, {\'name\': \'超心理戦\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d72d56f-fb3a-49ff-a5cd-2d79c14b802c\'}, \'multiverseid\': None}, {\'name\': \'Batalha Psíquica\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f0ad086-b473-4c7c-8cec-752c00624f25\'}, \'multiverseid\': None}]', "[{'name': 'Kampf oder Flucht', 'text': 'Teile zu Beginn jeder Kampfphase Deines Gegners alle Kreaturen, die er kontrolliert, auf zwei offene Stapel auf. Nur Kreaturen in dem Stapel, den Dein Gegner bestimmt, können in diesem Zug angreifen.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183434&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1d31330f-a09e-4a6f-9444-c50273c464e2', 'multiverseId': 183434}, 'multiverseid': 183434}, {'name': 'Pelear o Huir', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '02c930a8-36c4-4d55-a4fa-87c66049519d'}, 'multiverseid': None}, {'name': 'Fuir ou combattre', 'text': 'Au début de la phase de combat de chacun de vos adversaires, séparez toutes les créatures que ce joueur contrôle en deux tas faces visibles. Seules les créatures dans le tas de son choix peuvent attaquer ce tour-ci.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185308&type=card', 'language': 'French', 'identifiers': {'scryfallId': '507696b7-dd77-473b-866a-cec46dd45416', 'multiverseId': 185308}, 'multiverseid': 185308}, {'name': 'Combatti o Scappa', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '76d8f2f7-b09e-4a0c-99b7-b1170a165ccc'}, 'multiverseid': None}, {'name': '闘争か逃亡か', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4cc85fc2-2785-4293-a9cd-552b36b10a17'}, 'multiverseid': None}, {'name': 'Lutar ou Fugir', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e2b03ee4-7c95-42c4-8d9d-75a468549bcc'}, 'multiverseid': None}]", "[{'name': 'Kangee, Hüter der Lüfte', 'text': 'Bonus {2}{X} (Du kannst zusätzlich {2}{X} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nFliegend\\nWenn Du die Bonuskosten bezahlt hast, lege X Federmarken auf Kangee, wenn er ins Spiel kommt.\\nAlle Vögel erhalten +1/+1 für jede Federmarke auf Kangee, Hüter der Lüfte.', 'type': 'Kreatur — Legende', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183671&type=card', 'language': 'German', 'identifiers': {'scryfallId': '95b122bb-3093-4e6e-b011-454c3ab1a6f1', 'multiverseId': 183671}, 'multiverseid': 183671}, {'name': 'Kangee, Cuidador de la Nidada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '183909a8-d484-4714-83a1-a1e4b9ba67ce'}, 'multiverseid': None}, {'name': 'Kanji, gardien des Aérains', 'text': 'Kick {2}{X} (Vous pouvez payer {2}{X} supplémentaires quand vous jouez ce sort.)\\nVol\\nQuand Kanji, gardien des Aérains, arrive en jeu, si vous avez payé le coût de kick, mettez X marqueurs « plume » sur lui.\\nTous les oiseaux gagnent +1/+1 pour chaque marqueur « plume » sur Kanji, gardien des Aérains.', 'type': 'Créature : légende', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185545&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0597a116-65c2-4adf-ac0f-86703b1709a1', 'multiverseId': 185545}, 'multiverseid': 185545}, {'name': 'Kangee,Guardiano del Nido', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1e57de53-c69c-4d2e-a25a-05a029608d40'}, 'multiverseid': None}, {'name': '巣を守るものカンジー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fbd1309c-d57a-4446-954d-d44435f65842'}, 'multiverseid': None}, {'name': 'Kangee, Guardião do Ninho', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '00cdc272-cd59-4282-a139-adfee823d74c'}, 'multiverseid': None}]", '[{\'name\': \'Kapitän Sisay\', \'text\': \'{T}: Durchsuche Deine Bibliothek nach einer Legende oder einer legendären Karte, zeige sie offen und nimm sie auf Deine Hand. Mische danach Deine Bibliothek.\', \'type\': \'Kreatur — Legende\', \'flavor\': \'Sisays Führungstalent formte die großartige Mannschaft der Wetterlicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'970da614-095f-4f4a-9b2c-65e18730afb7\', \'multiverseId\': 183655}, \'multiverseid\': 183655}, {\'name\': \'Capitana de Sisay\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'96091630-fa76-43ab-9c69-50416ac332dd\'}, \'multiverseid\': None}, {\'name\': \'Capitaine Sissay\', \'text\': \'{T} : Cherchez dans votre bibliothèque une carte de légende ou légendaire, révélez cette carte et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.\', \'type\': \'Créature : Légende\', \'flavor\': "Sous son commandement, l\'Aquilon eut le meilleur des équipages.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185529&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16dd0254-d5f0-4b11-bcb9-760337aa1bd7\', \'multiverseId\': 185529}, \'multiverseid\': 185529}, {\'name\': \'Capitano Sisay\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25da8dbf-2002-46f0-a168-85b2891d0787\'}, \'multiverseid\': None}, {\'name\': \'艦長シッセイ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e129e55-2206-4d9a-9f5e-6d91572fcbf3\'}, \'multiverseid\': None}, {\'name\': \'Capitã Sisay\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'283ccafe-e3c0-4cc9-8b22-c82adb27bc0f\'}, \'multiverseid\': None}]', '[{\'name\': \'Karmesinroter Tempeldiener\', \'text\': \'Schutz vor Rot\\n{W}: Eine Kreatur Deiner Wahl erhält Schutz vor Rot bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kleriker\', \'flavor\': \'Die Gläubigen werden durch Flüsse aus Flammen waten und rein hervortreten. —Credo der karmesinroten Tempeldiener\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183429&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa8597d1-3a5d-4ef9-a75d-c4a23bf3bc56\', \'multiverseId\': 183429}, \'multiverseid\': 183429}, {\'name\': \'Acólito Carmesí\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f18b6d01-419e-4534-9669-16ffaad4d957\'}, \'multiverseid\': None}, {\'name\': \'Acolyte pourpre\', \'text\': "Protection contre le rouge\\n{W}: La créature ciblée acquiert la protection contre le rouge jusqu\'à la fin du tour.", \'type\': \'Créature : clerc\', \'flavor\': \'Celui qui a la foi traversera les vagues de flamme et ressortira indemne. — Credo des acolytes pourpres.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0331769-40ee-4674-bbee-462d123a425c\', \'multiverseId\': 185303}, \'multiverseid\': 185303}, {\'name\': \'Accolito Scarlatto\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ff97086-0788-4323-9c36-74ba6ee12c3c\'}, \'multiverseid\': None}, {\'name\': \'真紅の見習い僧\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'776db5e3-78af-442a-815e-724bcfcaf84b\'}, \'multiverseid\': None}, {\'name\': \'Acólito Escarlate\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6773a85-f04d-4999-a400-9a5b1e1c064c\'}, \'multiverseid\': None}]', '[{\'name\': \'Kavu-Chamäleon\', \'text\': \'Das Kavu-Chamäleon kann nicht neutralisiert werden.\\n{G}: Das Kavu-Chamäleon wird bis zum Ende des Zuges zu einer Kreatur einer Farbe, die Du bestimmst.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'„Sie waren nicht Teil meines Plans, aber Gaea bestand darauf." —Urza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42f48090-44d4-460d-8086-38fc0997b391\', \'multiverseId\': 183609}, \'multiverseid\': 183609}, {\'name\': \'Kavu Camaleón\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3017628a-1d8a-4783-977c-e04473c09592\'}, \'multiverseid\': None}, {\'name\': \'Kavru caméléon\', \'text\': "Le Kavru caméléon ne peut pas être contrecarré.\\n{G}: Le Kavru caméléon devient de la couleur de votre choix jusqu\'à la fin du tour.", \'type\': \'Créature : kavru\', \'flavor\': \'« Ils ne faisaient pas partie de mon plan mais Gaia a insisté. » — Urza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185483&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5372619-7109-4e88-9dc7-74b1633fc623\', \'multiverseId\': 185483}, \'multiverseid\': 185483}, {\'name\': \'Camaleonte di Kavu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9ba52e2-3047-486e-8fc6-df0da9f5229a\'}, \'multiverseid\': None}, {\'name\': \'カヴーのカメレオン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'07cbcbc1-bc43-4d33-b121-6476492e3d3a\'}, \'multiverseid\': None}, {\'name\': \'Camaleão Kavu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'482b2181-62e8-4d86-8f66-66c4e2d36a14\'}, \'multiverseid\': None}]', '[{\'name\': \'Kavu-Kaiser\', \'text\': \'Alle Kavus verursachen Trampelschaden.\\nImmer wenn ein anderer Kavu ins Spiel kommt, lege eine +1/+1-Marke auf den Kavu-Kaiser.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Kavus fanden sich überall in Dominaria, aber die ersten und stärksten kamen aus Yavimaya.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72aad86d-1df8-4019-b984-1fdf2f460ee8\', \'multiverseId\': 183567}, \'multiverseid\': 183567}, {\'name\': \'Kavu Monarca\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e0f18490-e98e-4ff5-b348-7848863da714\'}, \'multiverseid\': None}, {\'name\': \'Monarque kavru\', \'text\': "Tous les kavrus ont le piétinement.À chaque fois qu\'un autre kavru arrive en jeu, mettez un marqueur +1/+1 sur le Monarque kavru.", \'type\': \'Créature : kavru\', \'flavor\': \'Des kavrus apparurent sur tout Dominaria, mais les premiers et les plus forts venaient de la Yavimaya.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185441&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf2a4e2f-9cfd-4f61-a816-f54c0d98eaba\', \'multiverseId\': 185441}, \'multiverseid\': 185441}, {\'name\': \'Monarca Kavu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7aaf3fbd-03f5-45bf-9f7b-972cdf808bbb\'}, \'multiverseid\': None}, {\'name\': \'カヴーの王者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b404739f-2866-441f-be9c-7e2eddb5ef6d\'}, \'multiverseid\': None}, {\'name\': \'Monarca Kavu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e470f6fa-01a0-49c8-8ccc-4b03462e0729\'}, \'multiverseid\': None}]', '[{\'name\': \'Kavu-Kundschafter\', \'text\': \'Der Kavu-Kundschafter erhält +1/+0 für jeden Standardlandtyp unter den Ländern, die Du kontrollierst.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Die Kavus entwickelten sich jahrhunderte-ang im Inneren Dominarias, und einige können Kraft aus dem Land ziehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183569&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e556403b-1b8b-428e-a183-17870f425ece\', \'multiverseId\': 183569}, \'multiverseid\': 183569}, {\'name\': \'Kavu Explorador\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f45db5a-8f69-45d5-be88-f0b6b950d62e\'}, \'multiverseid\': None}, {\'name\': \'Éclaireur kavru\', \'text\': "L\'Éclaireur kavru gagne +1/+0 pour chaque type de terrain de base parmi les terrains que vous contrôlez.", \'type\': \'Créature : kavru\', \'flavor\': \'Des siècles durant, les kavrus ont évolué sous la surface de Dominaria, et certains savent user des forces telluriques.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185443&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'430caa39-5920-482a-b3a8-d5073a238a9d\', \'multiverseId\': 185443}, \'multiverseid\': 185443}, {\'name\': \'Scout Kavu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5ed2ea8c-8a44-4a30-b76a-da525d211a26\'}, \'multiverseid\': None}, {\'name\': \'カヴーの斥候\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9e8e8978-e099-4126-b27b-c08d2edc9aa2\'}, \'multiverseid\': None}, {\'name\': \'Batedor Kavu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5e8c89b1-7ad9-4e23-8275-db8b56b38dc8\'}, \'multiverseid\': None}]', "[{'name': 'Kavu-Titan', 'text': 'Bonus {2}{G} (Du kannst zusätzlich {2}{G} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nWenn Du die Bonuskosten bezahlt hast, kommt der Kavu-Titan mit drei +1/+1-Marken ins Spiel und verursacht Trampelschaden.', 'type': 'Kreatur — Kavu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183612&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c949c262-750b-4847-8c73-f46f303f3a6a', 'multiverseId': 183612}, 'multiverseid': 183612}, {'name': 'Kavu Titán', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5572a99d-db30-4525-bbcd-1cf6d01a9fad'}, 'multiverseid': None}, {'name': 'Kavru titanesque', 'text': 'Kick {2}{G} (Vous pouvez payer {2}{G} supplémentaires quand vous jouez ce sort.)\\nSi vous avez payé le coût de kick, le Kavru titanesque arrive en jeu avec trois marqueurs +1/+1 sur lui et a le piétinement.', 'type': 'Créature : kavru', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185486&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4f96c3e6-4878-4279-bc98-99aa1c720781', 'multiverseId': 185486}, 'multiverseid': 185486}, {'name': 'Titano Kavu', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4b773dbb-caa2-4101-839c-627904584c9e'}, 'multiverseid': None}, {'name': 'カヴーのタイタン', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '503e7907-0514-4fd8-8f74-4d63f72f339a'}, 'multiverseid': None}, {'name': 'Titã Kavu', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0ab2669f-1a6c-4ce2-afc9-a553449ea9d3'}, 'multiverseid': None}]", '[{\'name\': \'Kavuhöhle\', \'text\': \'Immer wenn eine Kreatur mit Stärke 4 oder größer ins Spiel kommt, zieht ihr Beherrscher eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'Als der dunkle Regen von Phyrexianern aus dem Himmel herabstürzte, barsten Fontänen von Kavus aus dem Boden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183611&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'900dbfbe-c35d-45e0-b306-22b443481dd4\', \'multiverseId\': 183611}, \'multiverseid\': 183611}, {\'name\': \'Guarida de Kavu\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb6a6ab4-5d6a-41d7-bd92-93a85e9db65f\'}, \'multiverseid\': None}, {\'name\': \'Tanière kavrue\', \'text\': "À chaque fois qu\'une créature avec une force de 4 ou plus arrive en jeu, son contrôleur pioche une carte.", \'type\': \'Enchantement\', \'flavor\': \'Une pluie noire de Phyrexians tombait du ciel ; des fontaines de kavrus jaillirent du sol.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185485&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cb0c4bf0-58bf-4537-8f6e-396415ea6710\', \'multiverseId\': 185485}, \'multiverseid\': 185485}, {\'name\': \'Tana dei Kavu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'333f1757-c201-45e4-9db8-df47648ae62d\'}, \'multiverseid\': None}, {\'name\': \'カヴーの巣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26d54580-1b54-451e-ba75-296c907a729c\'}, \'multiverseid\': None}, {\'name\': \'Covil Kavu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ee9aa96-a3d7-420e-a21b-b47f9981504a\'}, \'multiverseid\': None}]', "[{'name': 'Keldonische Totenstadt', 'text': '{T}: Erhöhe Deinen Manavorrat um ein farbloses Mana.\\n{4}{R}, {T}, opfere eine Kreatur: Die Keldonische Totenstadt fügt einer Kreatur oder einem Spieler Deiner Wahl 2 Schadenspunkte zu.', 'type': 'Legendäres Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183748&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c11a6113-31f4-4611-89fe-a598be5dcfb5', 'multiverseId': 183748}, 'multiverseid': 183748}, {'name': 'Necrópolis de Keldon', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8c22b66a-8d76-451c-96e2-62ff20ff283c'}, 'multiverseid': None}, {'name': 'Nécropole kelde', 'text': '{T}: Ajoutez un mana incolore à votre réserve.\\n{4}{R}, {T}, sacrifiez une créature : La Nécropole kelde inflige 2 blessures à une cible, créature ou joueur.', 'type': 'Terrain légendaire', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185622&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd88b457e-b508-4c49-b9ab-c6670b5c6a1f', 'multiverseId': 185622}, 'multiverseid': 185622}, {'name': 'Necropoli di Keld', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5966c8c9-9947-4ad3-97c6-fae6ddaf8d5b'}, 'multiverseid': None}, {'name': 'ケルドの死滅都市', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8ee8c11c-2c92-432e-a9bb-09d191a80be4'}, 'multiverseid': None}, {'name': 'Necrópole de Keld', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '20c088d3-a847-423c-891c-a5d297cee890'}, 'multiverseid': None}]", "[{'name': 'Kesseltanz', 'text': 'Spiele den Kesseltanz nur während eines Kampfes.\\nBringe eine Kreatur Deiner Wahl aus Deinem Friedhof ins Spiel. Diese Kreatur erhält Eile. Bringe sie am Ende des Zuges auf Deine Hand zurück.\\nBringe eine Kreatur aus Deiner Hand ins Spiel. Diese Kreatur erhält Eile. Lege sie am Ende des Zuges auf Deinen Friedhof.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183656&type=card', 'language': 'German', 'identifiers': {'scryfallId': '352d94a0-fde6-4204-b0f7-121d12ed3dee', 'multiverseId': 183656}, 'multiverseid': 183656}, {'name': 'Baile de la Caldera', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'dec782c5-8555-4bd8-a087-fbb03eaf32a4'}, 'multiverseid': None}, {'name': 'Danse du chaudron', 'text': 'Ne jouez la Danse du Chaudron que pendant le combat.\\nRenvoyez en jeu la carte de créature ciblée en provenance de votre cimetière. Cette créature acquiert la célérité. Renvoyez-la dans votre main à la fin du tour.\\nMettez une carte de créature de votre main en jeu. Cette créature acquiert la célérité. Mettez-la dans votre cimetière à la fin du tour.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185530&type=card', 'language': 'French', 'identifiers': {'scryfallId': '90b8356f-4be9-4c15-9342-64a4c26c3397', 'multiverseId': 185530}, 'multiverseid': 185530}, {'name': 'Danza del Calderone', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '60460092-4ab3-4af8-9ea3-540b090bddd6'}, 'multiverseid': None}, {'name': '大釜のダンス', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '334ad54c-6e77-48f6-a987-5cc2bed9bd8d'}, 'multiverseid': None}, {'name': 'Dança do Caldeirão', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b4e99083-d576-4033-a0ce-1501359aeb9c'}, 'multiverseid': None}]", '[{\'name\': \'Klammergriff\', \'text\': \'Spiele den Klammergriff nur während des Kampfes.\\nEnttappe eine Kreatur, die Du nicht kontrollierst und übernimm die Kontrolle über sie. Diese Kreatur erhält Eile bis zum Ende des Zuges. Opfere am Ende des Zuges diese Kreatur. Wenn Du dies tust, erhältst Du Lebenspunkte in Höhe der Widerstandskraft der Kreatur dazu. (Sie kann in dem Zug, in dem sie unter Deine Kontrolle kommt, angreifen und Fähigkeiten anwenden, bei denen sie getappt wird.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e01ca431-c335-4599-978b-fe66e4d286cb\', \'multiverseId\': 183694}, \'multiverseid\': 183694}, {\'name\': \'Abrazo Espinal\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9aad897b-d704-4449-99e4-fbabdfed881d\'}, \'multiverseid\': None}, {\'name\': \'Étreinte spinale\', \'text\': "Ne jouez l\'étreinte spinale que pendant le combat.\\nDégagez la créature ciblée que vous ne contrôlez pas et acquérez-en le contrôle. Elle acquiert la célérité jusqu\'à la fin du tour. À la fin du tour, sacrifiez-la. Si vous faites ainsi, vous gagnez autant de points de vie que son endurance. (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185568&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'821cee40-b253-4907-9506-1959ea65e27e\', \'multiverseId\': 185568}, \'multiverseid\': 185568}, {\'name\': \'Abbraccio Vertebrale\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bc6c74cf-ce7d-47a9-bd93-efd3e02328ac\'}, \'multiverseid\': None}, {\'name\': \'脊髄支配\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b02446ef-3fae-4284-85ad-a666bec7cdbd\'}, \'multiverseid\': None}, {\'name\': \'Abraço Espinal\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3125017-210a-4f11-a17f-630851bdc226\'}, \'multiverseid\': None}]', '[{\'name\': \'Kletterkavu\', \'text\': \'Ziehe eine Karte, wenn der Kletterkavu ins Spiel kommt.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Das Erscheinen des ersten Kavu überraschte Multani. Als weitere auftauchten, zweifelte er nicht länger an der Fähigkeit Yavimayas, sich selbst zu verteidigen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183610&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d90e7bc7-b1fa-41a7-98e3-ba9a1e6f652a\', \'multiverseId\': 183610}, \'multiverseid\': 183610}, {\'name\': \'Kavu Escalador\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9304ca07-c799-45b1-978f-752a93d51b21\'}, \'multiverseid\': None}, {\'name\': \'Kavru grimpeur\', \'text\': \'Quand le Kavru grimpeur arrive en jeu, piochez une carte.\', \'type\': \'Créature : kavru\', \'flavor\': "L\'aspect du premier kavru surprit Multani. Comme il en sortait encore et encore, il comprit que la Yavimaya pouvait se défendre elle-même.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185484&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c4a9616-cd5a-4118-be11-55f368a49da3\', \'multiverseId\': 185484}, \'multiverseid\': 185484}, {\'name\': \'Scalatore Kavu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60cc3a30-1d0e-4e91-8329-7b7586743f98\'}, \'multiverseid\': None}, {\'name\': \'木登りカヴー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d83f4886-5d45-4490-acb5-ee1278866ad0\'}, \'multiverseid\': None}, {\'name\': \'Escalador Kavu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2e8b77d-1475-4a39-8eb2-5e80dcfd6855\'}, \'multiverseid\': None}]', '[{\'name\': \'Kneifzangenspinne\', \'text\': \'Bonus {3} (Du kannst zusätzlich {3} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nDie Kneifzangenspinne kann blocken, als ob sie Flugfähigkeit hätte.\\nWenn Du die Bonuskosten bezahlt hast, kommt die Kneifzangenspinne mit einer +1/+1-Marke ins Spiel.\', \'type\': \'Kreatur — Spinne\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183619&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'87d968ee-f358-4fd3-a77e-40bafa998efc\', \'multiverseId\': 183619}, \'multiverseid\': 183619}, {\'name\': \'Araña con Pinzas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15423c45-7ccb-4e5c-a239-0cc332b601b4\'}, \'multiverseid\': None}, {\'name\': \'Araignée à pinces\', \'text\': "Kick {3} (Vous pouvez payer {3} supplémentaires quand vous jouez ce sort.)\\nL\'Araignée à pinces peut bloquer comme si elle avait le vol.\\nSi vous avez payé le coût de kick, l\'Araignée à pinces arrive en jeu avec un marqueur +1/+1 sur elle.", \'type\': \'Créature : araignée\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185493&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55a8dbb6-a099-41fb-b3a9-50fa37e77019\', \'multiverseId\': 185493}, \'multiverseid\': 185493}, {\'name\': \'Ragno Chelato\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd8fe01f-7f07-4914-a671-65b409a9e1ec\'}, \'multiverseid\': None}, {\'name\': \'はさみ蜘蛛\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13a975db-ceb9-4f4e-ac04-c2292a0fa38f\'}, \'multiverseid\': None}, {\'name\': \'Aranha de Pinças\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2724d9b1-1194-4df7-88cf-506fb71b80ce\'}, \'multiverseid\': None}]', '[{\'name\': \'Koalitionssieg\', \'text\': \'Du gewinnst das Spiel, wenn Du ein Land jedes Standardlandtyps und eine Kreatur jeder Farbe kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'„Wir haben aus mangelhaften Teilen eine perfekte Maschine gebaut." —Urza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183659&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b91a6138-58b8-45a1-9938-2a53a463921f\', \'multiverseId\': 183659}, \'multiverseid\': 183659}, {\'name\': \'Victoria en Coalición\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'410f83e2-c321-4361-88e7-271d9f92535b\'}, \'multiverseid\': None}, {\'name\': \'Victoire de la coalition\', \'text\': \'Vous gagnez la partie si vous contrôlez un terrain de chaque type de terrain de base et une créature de chaque couleur.\', \'type\': \'Rituel\', \'flavor\': \'« Une machine parfaite peut être assemblée à partir de pièces imparfaites. » — Urza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185533&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14a0bbd6-7fc7-4a5e-ae62-cbb246073eff\', \'multiverseId\': 185533}, \'multiverseid\': 185533}, {\'name\': \'Coalizione Vittoriosa\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'265d3ebc-2db8-427f-be1d-3b0111e3e06e\'}, \'multiverseid\': None}, {\'name\': \'合同勝利\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f3caeff-cc5c-42