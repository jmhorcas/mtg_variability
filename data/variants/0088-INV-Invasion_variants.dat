nguage\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b257d5e-56b2-4eaa-abd1-82aa2d40d4bb\'}, \'multiverseid\': None}]', '[{\'name\': \'Anstürmender Troll\', \'text\': \'Der Anstürmende Troll wird beim Angreifen nicht getappt.\\n{G}: Regeneriere den Anstürmenden Troll.\', \'type\': \'Kreatur — Troll\', \'flavor\': \'Sie bremsen nicht, noch nicht mal am Ende des Kampfes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183657&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9abf3e57-5d3b-4a3b-9fc0-2cdbc88b6f3e\', \'multiverseId\': 183657}, \'multiverseid\': 183657}, {\'name\': \'Troll a la Carga\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b0f0026-5dac-4426-9390-2b5798f449c9\'}, \'multiverseid\': None}, {\'name\': \'Troll fougueux\', \'text\': "Attaquer avec le Troll fougueux ne le fait aps s\'engager.\\n{G} : Régénérez le Troll fougueux.", \'type\': \'Créature : troll\', \'flavor\': \'Rien ne les arrête, pas même la fin de la bataille.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185531&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'852aad8b-8ece-467a-b3cf-722fd0b8fac9\', \'multiverseId\': 185531}, \'multiverseid\': 185531}, {\'name\': \'Troll alla Carica\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53ff7163-2668-4a97-9e67-53e83981a526\'}, \'multiverseid\': None}, {\'name\': \'突進するトロール\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e8e1be2-8bd5-420b-ad54-70d7c9fc6f0f\'}, \'multiverseid\': None}, {\'name\': \'Trol Atacante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1f0d86f8-ac7b-4bf2-a371-580f1f176fff\'}, \'multiverseid\': None}]', '[{\'name\': \'Anthrazit-Egel\', \'text\': \'Schwarze Zaubersprüche, die Du spielst, kosten {B} mehr.\\n{B}: Der Anthrazit-Egel erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Egel\', \'flavor\': \'„Ältere Exemplare sind vollständig mit Edelsteinen verkrustet, die sowohl als Rüstung als auch als Waffen zu dienen scheinen." —Tolarianische Forschungsergebnisse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7a1e20e-d05d-4474-b376-ba7b40175391\', \'multiverseId\': 183511}, \'multiverseid\': 183511}, {\'name\': \'Sanguijuela Andradita\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c66667ef-2d27-4dbf-b4b7-daf30cfd4136\'}, \'multiverseid\': None}, {\'name\': "Sangsue d\'andradite", \'text\': "Les sorts noirs que vous jouez coûtent {B} de plus à jouer.\\n{B}: La Sangsue d\'andradite gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : sangsue\', \'flavor\': "« Les plus vieux spécimens sont complètement recouverts de gemmes qui servent à la fois d\'armure et d\'armes. » — Notes scientifiques, Tolaria.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185385&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63864f4f-9aa3-41f3-83f2-d00a3cb46da5\', \'multiverseId\': 185385}, \'multiverseid\': 185385}, {\'name\': \'Sanguisuga di Andralite\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2148344c-b7b5-47f9-bdb5-687755c1f145\'}, \'multiverseid\': None}, {\'name\': \'ざくろ石のヒル\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5f331bba-ffb3-4f90-a1f7-ca6acb9092bc\'}, \'multiverseid\': None}, {\'name\': \'Sanguessuga de Andradita\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'daae1cf2-bb91-4fcf-b4d8-efc773903345\'}, \'multiverseid\': None}]', '[{\'name\': \'Archäologische Ausgrabung\', \'text\': \'{T}: Erhöhe Deinen Manavorrat um ein farbloses Mana.\\n{T}, opfere die Archäologische Ausgrabung: Erhöhe Deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183743&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d1131bd-3041-4478-888d-e677996dd158\', \'multiverseId\': 183743}, \'multiverseid\': 183743}, {\'name\': \'Excavación Arqueológica\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc75429a-0bab-4369-a73d-c621eeba9375\'}, \'multiverseid\': None}, {\'name\': \'Gisement archéologique\', \'text\': "{T}: Ajoutez un mana incolore à votre réserve.\\n{T}, sacrifiez le Gisement archéologique: Ajoutez un mana d\'une couleur de votre choix à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185617&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'187355bf-ab23-451a-ad07-713f7bb12a89\', \'multiverseId\': 185617}, \'multiverseid\': 185617}, {\'name\': \'Scavo Archeologico\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eef52a23-8a40-4922-b888-53f786302311\'}, \'multiverseid\': None}, {\'name\': \'遺跡発掘現場\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc009079-f259-4173-ba37-c35145e3c104\'}, \'multiverseid\': None}, {\'name\': \'Escavação Arqueológica\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9f298e7-0a83-4c6c-8653-be0715a42abc\'}, \'multiverseid\': None}]', '[{\'name\': \'Artefaktmutation\', \'text\': \'Zerstöre ein Artefakt Deiner Wahl. Es kann nicht regeneriert werden. Bringe X 1/1 grüne Saproling-Spielsteine ins Spiel, wobei X die umgewandelten Manakosten des Artefakts sind.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Aus Splittern und Scherben rufe ich meine lebendige Horde empor." —Molimo, Maro-Hexer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8daae720-bac6-42d0-b1c1-461e638eb5a0\', \'multiverseId\': 183649}, \'multiverseid\': 183649}, {\'name\': \'Mutación de Artefacto\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5776d86-8dc4-4e53-be90-f6832fd4a62d\'}, \'multiverseid\': None}, {\'name\': "Mutation d\'artefact", \'text\': "Détruisez l\'artefact ciblé. Il ne peut pas être régénéré. Mettez en jeu X jetons de créature 1/1 verte Saprobionte, où X est son coût converti de mana.", \'type\': \'Éphémère\', \'flavor\': "« Épines et échardes, je t\'appelle, horde vivante » — Molimo, maro-sorcier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185523&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'42dfe8bb-5786-4661-b691-25764bfb652c\', \'multiverseId\': 185523}, \'multiverseid\': 185523}, {\'name\': \'Mutazione degli Artefatti\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec8a0063-b8e2-4034-86b5-77c17438dd31\'}, \'multiverseid\': None}, {\'name\': \'秘宝の突然変異\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c9df8e9c-2f9c-40df-bd95-21a1d30e1dad\'}, \'multiverseid\': None}, {\'name\': \'Mutação de Artefato\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'464a13f2-d4e5-46f2-ab79-cbcb48239380\'}, \'multiverseid\': None}]', "[{'name': 'Asalto // Violencia', 'flavor': None, 'faceName': 'Asalto', 'language': 'Spanish', 'identifiers': {'scryfallId': '23c6ac79-a895-4687-97b1-cfb0119fff1d'}, 'multiverseid': None}, {'name': 'Batteria // Aggressione', 'flavor': None, 'faceName': 'Batteria', 'language': 'Italian', 'identifiers': {'scryfallId': '9328293f-f3ca-477e-b970-818524b2ac4c'}, 'multiverseid': None}, {'name': '暴行 // 殴打 // Battery', 'flavor': None, 'faceName': '暴行 // 殴打', 'lan