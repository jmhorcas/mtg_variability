fiers': {'scryfallId': '3ce757b4-52eb-4786-8a54-aa23b77ff505'}, 'multiverseid': None}, {'name': 'Planície', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2756133b-9d82-4ab9-bdff-4edbd90e9da5'}, 'multiverseid': None}]", "[{'name': 'Ebene', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183757&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0c4796a8-cd8f-4d61-968c-fc3a5fc036c4', 'multiverseId': 183757}, 'multiverseid': 183757}, {'name': 'Isla', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7678fa01-df0e-4430-9e19-aa910fe2f851'}, 'multiverseid': None}, {'name': 'Plaine', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185631&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f1cac307-9c5d-447d-913d-b91ee8499c15', 'multiverseId': 185631}, 'multiverseid': 185631}, {'name': 'Pianura', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '640c3f4e-ab5f-4dcb-b947-db37ea992122'}, 'multiverseid': None}, {'name': '平地', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b74b278c-a3da-4292-ad3a-c0a9a71011c2'}, 'multiverseid': None}, {'name': 'Planície', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '141e5705-635b-4dde-873f-e561768f2ede'}, 'multiverseid': None}]", '[{\'name\': \'Edler Panther\', \'text\': \'{1}: Der Edle Panther erhält Erstschlag bis zum Ende des Zuges.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Anders als andere Jäger brauchen die Panther keine Tarnung. Sie sind schnell genug, ihre Beute auch so zu fangen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183675&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea0ad132-3e4d-4d54-a4c8-ee9fd7c66934\', \'multiverseId\': 183675}, \'multiverseid\': 183675}, {\'name\': \'Pantera Noble\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b9be6e6b-4455-4660-b017-f1db075f869b\'}, \'multiverseid\': None}, {\'name\': \'Panthère noble\', \'text\': "{1} : La Panthère noble acquiert l\'initiative jusqu\'à la fin du tour.", \'type\': \'Créature : chat\', \'flavor\': "Contrairement à beaucoup de fauves, ces panthères n\'ont nul besoin de camouflage. Leur rapidité est suffisante pour attraper leurs proies.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185549&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f739eca0-dd0f-44bb-ae60-f53bfe0797db\', \'multiverseId\': 185549}, \'multiverseid\': 185549}, {\'name\': \'Pantera Nobile\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'35a2d3d5-f1a6-43dd-88c8-de7899e453b2\'}, \'multiverseid\': None}, {\'name\': \'気高き豹\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'139544c7-858f-4be0-a52e-1ae68daa262c\'}, \'multiverseid\': None}, {\'name\': \'Pantera Nobre\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71c1b165-3b11-41b1-8768-d4c5315a7f50\'}, \'multiverseid\': None}]', "[{'name': 'Elfheim-Heiligtum', 'text': 'Du kannst zu Beginn Deines Versorgungssegments Deine Bibliothek nach einem Standardland durchsuchen, die Karte vorzeigen und auf Deine Hand nehmen. Wenn Du dies tust, übergehe Dein Ziehsegment in diesem Zug und mische danach Deine Bibliothek.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183603&type=card', 'language': 'German', 'identifiers': {'scryfallId': '80ed12a7-5086-4ec5-982a-35de942dfa8e', 'multiverseId': 183603}, 'multiverseid': 183603}, {'name': 'Santuario Elfhogar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'dd932ca6-8ebe-4d54-b1bb-ec43cc079a09'}, 'multiverseid': None}, {'name': 'Sanctuaire terrelfe', 'text': 'Au début de votre entretien, vous pouvez chercher une carte de terrain de base dans votre bibliothèque, révéler cette carte et la mettre dans votre main. Si vous faites ainsi, sautez votre étape de pioche ce tour-ci et mélangez votre bibliothèque.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185477&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3727bc1f-6e8b-4028-8cca-e5cb0f5723db', 'multiverseId': 185477}, 'multiverseid': 185477}, {'name': 'Santuario del Regno degli Elfi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '301ef16a-ec36-44f0-9397-6f947c517447'}, 'multiverseid': None}, {'name': 'エルフェイムの聖域', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5c499f6f-7efc-417d-bba2-7140142e6020'}, 'multiverseid': None}, {'name': 'Santuário de Elfilar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a4388919-4e7f-4c3e-9d1f-ba16d9e6c070'}, 'multiverseid': None}]", '[{\'name\': \'Elfheim-Palast\', \'text\': \'Der Elfheim-Palast kommt getappt ins Spiel.\\n{T}: Erhöhe Deinen Manavorrat um {G} oder {W}.\', \'type\': \'Land\', \'flavor\': \'Llanowar hat sieben Elfheime, oder Königreiche, jedes mit seinem eigenen Herrscher. Deren Paläste wecken im Betrachter Ehrfurcht, Wunder und Neid.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f26a5704-352d-4f04-9563-5a2aea7bb6a3\', \'multiverseId\': 183745}, \'multiverseid\': 183745}, {\'name\': \'Palacio Elfhogar\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'197589fa-59f9-43e3-a669-288047b33607\'}, \'multiverseid\': None}, {\'name\': \'Palais terrelfe\', \'text\': \'Le Palais terrelfe arrive en jeu engagé.\\n{T}: Ajoutez {G} ou {W} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Llanowar a sept terrelfes, chacun avec son propre seigneur. Leurs palais suscitent l\'admiration, l\'émerveillement et la jalousie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185619&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65df37cc-8984-46ee-b31d-2cb6b06c4445\', \'multiverseId\': 185619}, \'multiverseid\': 185619}, {\'name\': \'Palazzo degli Elfi\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e44a7cab-81a5-4a76-aae8-fa2024cc9fde\'}, \'multiverseid\': None}, {\'name\': \'エルフェイムの宮殿\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b198c05-a3a8-4cf8-8729-31a3467a145b\'}, \'multiverseid\': None}, {\'name\': \'Palácio de Elfilar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7944e0e1-231d-48a7-9351-e4191a3c4d81\'}, \'multiverseid\': None}]', '[{\'name\': \'Elfischer Champion\', \'text\': \'Alle Elfen erhalten +1/+1 und Waldtarnung. (Sie sind unblockbar, solange der verteidigende Spieler einen Wald kontrolliert.)\', \'type\': \'Kreatur — Herrscher\', \'flavor\': \'„Denn was sind Blätter anderes als Klingen, um einen zahllosen Feind zu bekämpfen?" —Wolkenwaldhymne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183604&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82dd0841-d9ef-46e5-8730-6bd139b0a517\', \'multiverseId\': 183604}, \'multiverseid\': 183604}, {\'name\': \'Campeona Elfica\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'46e7fc3f-7f7d-454a-866b-c09de8a0ce37\'}, \'multiverseid\': None}, {\'name\': \'Championne elfe\', \'text\': \'Tous les elfes gagnent +1/+1 et ont la traversée des forêts. (Ils sont imblocables tant que le joueur défenseur contrôle au moins une forêt.)\', \'type\': \'Créature : seigneur\', \'flavor\': "« Ne sont les feuilles que des lames éternelles Pour combattre le deuil et l\'ennemi cruel ?» — Hymne de Linciel.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185478&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbd22e89-c5fc-49ae-9081-401e1e8c073a\', \'multiverseId\': 185478}, \'multiverseid\': 185478}, {\'name\': \'Campione Elfico\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25644d3e-86a0-4ccb-a378-22af1e3082d4\'}, \'multiverseid\': None}, {\'name\': \'エルフのチャンピオン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53243f4b-a980-4c34-af7b-a43053d0ea86\'}, \'multiverseid\': None}, {\'name\': \'Campeão Élfico\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68e27e4d-36af-4d68-861f-411fb8ee8371\'}, \'multiverseid\': None}]', "[{'name': 'Enfrentar // Cumplir', 'flavor': None, 'faceName': 'Cumplir', 'language': 'Spanish', 'identifiers': {'scryfallId': '108fb413-2aab-469d-8320-077fb42eb4c6'}, 'multiverseid': None}, {'name': 'Consegna // Resistenza', 'flavor': None, 'faceName': 'Resistenza', 'language': 'Italian', 'identifiers': {'scryfallId': 'f1d0c726-148b-41f4-8857-8c8e5e16e527'}, 'multiverseid': None}, {'name': '抵抗 // 救難', 'flavor': None, 'faceName': '救難', 'language': 'Japanese', 'identifiers': {'scryfallId': '252d7d05-9ffe-4fd5-b952-a2f4499c7bf9'}, 'multiverseid': None}, {'name': 'Entregar // Defender', 'flavor': None, 'faceName': 'Defender', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '47f5f4d0-262c-427e-aafc-73ca35d73f9a'}, 'multiverseid': None}, {'name': 'Stand // Deliver', 'flavor': None, 'faceName': 'Deliver', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3fa04a89-e35b-4f01-af9d-0e5bd37efb1a'}, 'multiverseid': None}, {'name': 'Stand // Deliver', 'flavor': None, 'faceName': 'Deliver', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '72a7d8fe-db45-460c-ad78-604705cd6dd3'}, 'multiverseid': None}]", "[{'name': 'Enfrentar // Cumplir', 'flavor': None, 'faceName': 'Enfrentar', 'language': 'Spanish', 'identifiers': {'scryfallId': '108fb413-2aab-469d-8320-077fb42eb4c6'}, 'multiverseid': None}, {'name': 'Consegna // Resistenza', 'flavor': None, 'faceName': 'Consegna', 'language': 'Italian', 'identifiers': {'scryfallId': 'f1d0c726-148b-41f4-8857-8c8e5e16e527'}, 'multiverseid': None}, {'name': '抵抗 // 救難', 'flavor': None, 'faceName': '抵抗', 'language': 'Japanese', 'identifiers': {'scryfallId': '252d7d05-9ffe-4fd5-b952-a2f4499c7bf9'}, 'multiverseid': None}, {'name': 'Entregar // Defender', 'flavor': None, 'faceName': 'Entregar', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '47f5f4d0-262c-427e-aafc-73ca35d73f9a'}, 'multiverseid': None}, {'name': 'Stand // Deliver', 'flavor': None, 'faceName': 'Stand', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3fa04a89-e35b-4f01-af9d-0e5bd37efb1a'}, 'multiverseid': None}, {'name': 'Stand // Deliver', 'flavor': None, 'faceName': 'Stand', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '72a7d8fe-db45-460c-ad78-604705cd6dd3'}, 'multiverseid': None}]", '[{\'name\': \'Engel der Gnade\', \'text\': \'Fliegend\\nWenn der Engel der Gnade ins Spiel kommt, erhältst Du 3 Lebenspunkte dazu.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„In Zeiten wie dieser brauchen die Leute etwas, was sie an das Mitgefühl erinnert." —Sisay\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183420&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f930a04-3eb2-46f6-b6fc-05557ecf8c4a\', \'multiverseId\': 183420}, \'multiverseid\': 183420}, {\'name\': \'Angel de Piedad\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb137243-0546-4568-ab16-55b7a02d41fd\'}, \'multiverseid\': None}, {\'name\': \'Ange de miséricorde\', \'text\': "Vol\\nQuand l\'Ange de miséricorde arrive en jeu, vous gagnez 3 points de vie.", \'type\': \'Créature : ange\', \'flavor\': "« C\'est dans les temps difficiles qu\'il faut savoir être miséricordieux. » — Sissay.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185294&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65fa3da8-bb8e-4a9a-ac16-ca25c2abe896\', \'multiverseId\': 185294}, \'multiverseid\': 185294}, {\'name\': \'Angelo della Misericordia\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39b1501c-6ea5-411f-8a78-ac3b4c6fec66\'}, \'multiverseid\': None}, {\'name\': \'慈悲の天使\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de839d7c-df86-4d55-a40d-762cff07ef20\'}, \'multiverseid\': None}, {\'name\': \'Anjo de Misericórdia\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9cec47e4-cc8f-4b8f-93fb-1aceeea67b54\'}, \'multiverseid\': None}]', '[{\'name\': \'Entweihende Tränen\', \'text\': \'Bis zum Ende Deines Zuges wird eine Kreatur Deiner Wahl zu einer schwarzen Kreatur, erhält +1/-1 und „{B}: Regeneriere diese Kreatur."\', \'type\': \'Spontanzauber\', \'flavor\': \'Serras lebende Krieger starrten voller Schrecken. „Wo ist unsere Herrin jetzt?" klagten sie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c949844b-d613-40c7-8fdd-fd50c9217cb5\', \'multiverseId\': 183517}, \'multiverseid\': 183517}, {\'name\': \'Lagrimas de Deshonra\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'12edb8f5-0b02-4af1-a86b-52455afc4da9\'}, \'multiverseid\': None}, {\'name\': \'Larmes souillées\', \'text\': "Jusqu\'à la fin du tour, la créature ciblée devient noire, gagne +1/-1, et acquiert « {B}: Régénérez cette créature. ».", \'type\': \'Éphémère\', \'flavor\': \'Les quelques rescapées des troupes de Serra se regardèrent avec horreur. « Où est notre Dame maintenant ? » Elles pleurèrent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185391&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e7983b7-5cd9-432d-8c21-c0be164d15a7\', \'multiverseId\': 185391}, \'multiverseid\': 185391}, {\'name\': \'Lacrime Inquinanti\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a4ad334-5e0d-4949-a4d0-c006d563fb40\'}, \'multiverseid\': None}, {\'name\': \'汚辱の涙\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37b914a9-db72-4850-a0f9-918725fb5722\'}, \'multiverseid\': None}, {\'name\': \'Lágrimas de Corrupção\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'20667a66-a7bc-4fba-85bb-a70d2d9bfd77\'}, \'multiverseid\': None}]', '[{\'name\': \'Erbeutete Waffen\', \'text\': \'Wenn die Erbeuteten Waffen ins Spiel kommen, ziehe eine Karte.Die verzauberte Kreatur erhält +1/+1.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Die Phyrexianer haben sich entwickelt," meinte Urza bewundernd. „Ihre Teile sind jetzt austauschbar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183541&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'16432f56-afed-48e4-85a7-5241bc4977c5\', \'multiverseId\': 183541}, \'multiverseid\': 183541}, {\'name\': \'Armamento de Desechos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e6f7a8f-142f-4bfc-bec7-e5283fc9faf2\'}, \'multiverseid\': None}, {\'name\': \'Armement nécropsique\', \'text\': "Quand l\'Armement nécropsique arrive en jeu, piochez une carte.La créature enchantée gagne +1/+1.", \'type\': \'Enchanter : créature\', \'flavor\': \'« Les Phyrexians ont progressé », admit Urza. « Leurs composants sont interchangeables. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68f23600-10e0-4974-967a-55d49d82002b\', \'multiverseId\': 185415}, \'multiverseid\': 185415}, {\'name\': \'Armeria Saccheggiata\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'400b6a08-feca-49c6-b152-7a697d923e04\'}, \'multiverseid\': None}, {\'name\': \'拾い集めた武具\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7d50b5f-7a15-4d45-a77e-050c04779076\'}, \'multiverseid\': None}, {\'name\': \'Armamento Escamoteado\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7906b8ef-2862-4b1f-9b82-069a891bf7c4\'}, \'multiverseid\': None}]', '[{\'name\': \'Erkundungstreck\', \'text\': \'Durchsuche Deine Bibliothek nach einer beliebigen Anzahl an Standardländern, zeige diese offen vor und lege sie beiseite. Mische Deine Bibliothek und lege dann diese Karten in beliebiger Reihenfolge oben darauf.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich habe meinen Pfad gewählt. Wer will mit mir gehen?" —Eladamri\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183628&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'295c8595-56b8-4248-b134-24456feafe73\', \'multiverseId\': 183628}, \'multiverseid\': 183628}, {\'name\': \'Jornada de Exploración\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3cbe4879-2abe-4856-a0f5-fc8a0afd5711\'}, \'multiverseid\': None}, {\'name\': "Voyage d\'exploration", \'text\': "Cherchez dans votre bibliothèque n\'importe quel nombre de cartes de terrains de base, révélez-les et mettez-les de côté. Mélangez votre bibliothèque puis mettez ces cartes au-dessus dans l\'ordre de votre choix.", \'type\': \'Rituel\', \'flavor\': "« J\'ai choisi ma voie. Qui marchera à mes côtés ? » —Éladämri", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185502&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d5268eb-9a9b-484f-85ef-04f3f32e874b\', \'multiverseId\': 185502}, \'multiverseid\': 185502}, {\'name\': \'Perlustrazione\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ae5ef259-bf5e-43a1-9673-e6070b7f4c0b\'}, \'multiverseid\': None}, {\'name\': \'偵察行\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da2d7800-a843-4dd1-a1c5-a045945c884d\'}, \'multiverseid\': None}, {\'name\': \'Caminho dos Batedores\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'13d77b5c-1eb5-493f-ab4f-db3e5fa2bc59\'}, \'multiverseid\': None}]', '[{\'name\': \'Essenzleck\', \'text\': \'Wenn die verzauberte bleibende Karte rot oder grün ist, erhält sie „Opfere zu Beginn Deines Versorgungssegments diese bleibende Karte, wenn Du nicht ihre Manakosten bezahlst.".\', \'type\': \'Bleibende-Karten-Verzauberung\', \'flavor\': \'„Noch bestimmen wir, wo Realität anfängt und wo sie aufhört." —Teferi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183473&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'986f294c-12a6-4134-a558-a975d5b6a2ca\', \'multiverseId\': 183473}, \'multiverseid\': 183473}, {\'name\': \'Fuga de Esencia\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca57ee71-768e-4ae9-8c42-6066aadde336\'}, \'multiverseid\': None}, {\'name\': "Fuite d\'essence", \'text\': \'Si le permanent enchanté est rouge ou vert, il a « Au début de votre entretien, sacrifiez ce permanent à moins que vous ne payiez son coût de mana. »\', \'type\': \'Enchanter : permanent\', \'flavor\': "« L\'existence précède l\'essence. » — Jean-Paul Sartre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185347&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'35f9d1f9-23ef-4232-8cdd-a5a0878ad1d3\', \'multiverseId\': 185347}, \'multiverseid\': 185347}, {\'name\': \'Fuga di Essenza\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4574b716-8161-465e-95cc-0b2e33a17b2f\'}, \'multiverseid\': None}, {\'name\': \'エッセンスの漏出\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5fd98ed1-2f54-470e-ba32-e889d27826cd\'}, \'multiverseid\': None}, {\'name\': \'Fuga de Essência\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'46e85cc7-1d24-48de-9ba2-78acb638b735\'}, \'multiverseid\': None}]', '[{\'name\': \'Exotischer Fluch\', \'text\': \'Die verzauberte Kreatur erhält -1/-1 für jeden Standardlandtyp unter den Ländern, die Du kontrollierst.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'Garstiger als der Kuß eines Hexers. —Jamuraanisches Sprichwort\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0f6f984-ba05-45b8-8fa0-8008d2af0968\', \'multiverseId\': 183523}, \'multiverseid\': 183523}, {\'name\': \'Maldición Exótica\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09ab4e51-ee66-48b6-a37e-9085be0dac3a\'}, \'multiverseid\': None}, {\'name\': \'Malédiction exotique\', \'text\': \'La créature enchantée gagne -1/-1 pour chaque type de terrain de base parmi les terrains que vous contrôlez.\', \'type\': \'Enchanter : créature\', \'flavor\': "Plus dégueulasse que le baiser d\'un nécromancien. — Expression djamúraane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185397&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9161b817-4dd6-49fa-aa5b-277fdb45ba32\', \'multiverseId\': 185397}, \'multiverseid\': 185397}, {\'name\': \'Maledizione Esotica\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84f379bb-7d95-4e9a-85cd-563624569f42\'}, \'multiverseid\': None}, {\'name\': \'風変わりな呪い\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad394858-7d02-4b31-98f4-3e71e108d41f\'}, \'multiverseid\': None}, {\'name\': \'Maldição Exótica\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2105a3d3-86aa-438f-b004-f390e0f6ca85\'}, \'multiverseid\': None}]', '[{\'name\': \'Explosives Wachstum\', \'text\': \'Bonus {5} (Du kannst zusätzlich {5} bezahlen, wenn Du diesen Zauberspruch spielst.)Eine Kreatur Deiner Wahl erhält +2/+2 bis zum Ende des Zuges.\\n Wenn Du die Bonuskosten bezahlt hast, erhält sie stattdessen +5/+5 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183605&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f0bdd3df-ffcf-44a0-b3fa-e046137b70ab\', \'multiverseId\': 183605}, \'multiverseid\': 183605}, {\'name\': \'Crecimiento Explosivo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2ed1e4a-804a-4dd7-82bd-983b589a48f4\'}, \'multiverseid\': None}, {\'name\': \'Croissance explosive\', \'text\': "Kick {5} (Vous pouvez payer {5} supplémentaires quand vous jouez ce sort.)\\nLa créature ciblée gagne +2/+2 jusqu\'à la fin du tour. Si vous avez payé le coût de kick, cette créature gagne +5/+5 jusqu\'à la fin du tour à la place.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185479&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4aaa2af-1eb0-4c32-9b81-536f35255558\', \'multiverseId\': 185479}, \'multiverseid\': 185479}, {\'name\': \'Crescita Esplosiva\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b137cf10-ca4e-488b-80f8-dd93cf2365de\'}, \'multiverseid\': None}, {\'name\': \'爆発的成長\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b597c0af-88d1-4c9f-bd80-369faf6d3f99\'}, \'multiverseid\': None}, {\'name\': \'Crescimento Explosivo\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68a219e3-dddb-4b64-a402-f65b9d10d0a9\'}, \'multiverseid\': None}]', '[{\'name\': \'Fakt oder Fiktion\', \'text\': \'Decke die obersten fünf Karten Deiner Bibliothek auf. Ein Gegner teilt diese auf zwei offene Stapel auf. Nimm den einen Stapel auf Deine Hand und lege den anderen in Deinen Friedhof.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183475&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f73068e-42f2-4150-9a4c-d10c1aad28bb\', \'multiverseId\': 183475}, \'multiverseid\': 183475}, {\'name\': \'Realidad o Ficción\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5d74b17-aff6-4e4e-a5e0-ff558d8e9ebb\'}, \'multiverseid\': None}, {\'name\': \'Fait ou fiction\', \'text\': "Révélez les cinq cartes du dessus de votre bibliothèque. Un adversaire sépare ces cartes en deux tas faces visibles. Mettez un de ces tas dans votre main et l\'autre dans votre cimetière.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185349&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59e615a2-34d9-481d-b0f6-5b03a458ffae\', \'multiverseId\': 185349}, \'multiverseid\': 185349}, {\'name\': \'Certezza o Finzione\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e3264e8a-3ef1-462b-be10-58ffb5e2735d\'}, \'multiverseid\': None}, {\'name\': \'嘘か真か\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b9251ace-fc9a-44e5-a416-b2e93d58cc75\'}, \'multiverseid\': None}, {\'name\': \'Fato ou Ficção\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54f770e6-47ee-4e91-9e3f-2a70beda1978\'}, \'multiverseid\': None}]', '[{\'name\': \'Feenschwadron\', \'text\': \'Bonus {3}{U} (Du kannst zusätzlich {3}{U} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nWenn Du die Bonuskosten bezahlt hast, kommt die Feenschwadron mit zwei +1/+1-Marken ins Spiel und hat Flugfähigkeit.\', \'type\': \'Kreatur — Feenwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183476&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9dff5eec-affa-458c-aac2-cba3b9e7434e\', \'multiverseId\': 183476}, \'multiverseid\': 183476}, {\'name\': \'Escuadrón de hadas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'92ea5cb4-9f0f-44d2-90c1-06db332ecac7\'}, \'multiverseid\': None}, {\'name\': \'Escadrille de faeries\', \'text\': "Kick {3}{U} (Vous pouvez payer {3}{U} supplémentaires quand vous jouez ce sort.)\\nSi vous avez payé le coût de kick, l\'Escadrille de faeries arrive en jeu avec deux marqueurs +1/+1 sur elle et a le vol.", \'type\': \'Créature : peuple fée\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185350&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af7f269f-59de-4790-b45f-9ab1ab6e88d4\', \'multiverseId\': 185350}, \'multiverseid\': 185350}, {\'name\': \'Squadrone di Spiritelli\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'98fec3f5-f81e-4e58-b647-edd7c1e30577\'}, \'multiverseid\': None}, {\'name\': \'フェアリーの戦隊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d49e1dd-9782-4dab-8e97-055d70f649c4\'}, \'multiverseid\': None}, {\'name\': \'Esquadrão de Fadas\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'22105236-934c-479d-98fc-2c70bac6aef6\'}, \'multiverseid\': None}]', '[{\'name\': \'Feiertag\', \'text\': \'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wessen Eintreffen wird die Geschichte wohl für heute festhalten — das der Dämonen oder das der Retter?" —Barrin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183438&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b84470a2-d0aa-462e-a48f-2e1268bf401b\', \'multiverseId\': 183438}, \'multiverseid\': 183438}, {\'name\': \'Día Santo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bcd24534-7620-4747-b9a9-d971a542c321\'}, \'multiverseid\': None}, {\'name\': \'Jour saint\', \'text\': \'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.\', \'type\': \'Éphémère\', \'flavor\': "« L\'Histoire retiendra-t-elle ce jour comme celui qui vit l\'arrivée des démons ou celui qui vit l\'arrivée des sauveurs ? » — Barrin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0c5db0a-58e8-4ba0-8b7e-221010d050a3\', \'multiverseId\': 185312}, \'multiverseid\': 185312}, {\'name\': \'Giorno Sacro\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'520b8c29-9ceb-4949-8687-c90cfe24779a\'}, \'multiverseid\': None}, {\'name\': \'聖なる日\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76482619-3949-44d3-a211-e33fb7488f57\'}, \'multiverseid\': None}, {\'name\': \'Dia Sagrado\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'515b8401-eb63-467d-a6e7-0d0b26ecc054\'}, \'multiverseid\': None}]', '[{\'name\': \'Fesseln\', \'text\': \'Die verzauberte Kreatur enttappt nicht während des Enttapp-Segments ihres Beherrschers.\\n{W}: Bringe die Fesseln auf die Hand ihres Besitzers zurück\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Es könnte schlimmer sein", sagte Gerrard, als er sich umschaute. „Naja, beinahe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183455&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a236359-6e36-49fc-911d-b8c24dc19843\', \'multiverseId\': 183455}, \'multiverseid\': 183455}, {\'name\': \'Grilletes\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8480841-104a-4aeb-88a0-c9379600a348\'}, \'multiverseid\': None}, {\'name\': \'Entraves\', \'text\': "La créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.\\n{W}: Renvoyez ces Entraves dans la main de leur propriétaire.", \'type\': \'Enchanter : créature\', \'flavor\': \'« Cela pourrait être pire », dit Gerrard en regardant alentour. « Enfin, peut-être. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b306a3a-8944-487d-aadd-120fd4cbcda9\', \'multiverseId\': 185329}, \'multiverseid\': 185329}, {\'name\': \'Catene\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4b2a68e-5a40-444d-be6c-80c38c36ae1e\'}, \'multiverseid\': None}, {\'name\': \'手かせ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5080021-49f0-44d4-8113-889b25bb8cd5\'}, \'multiverseid\': None}, {\'name\': \'Grilhões\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'487b4dca-2e56-4a17-8997-55287d324963\'}, \'multiverseid\': None}]', '[{\'name\': \'Feuer von Yavimaya\', \'text\': \'Alle Kreaturen, die Du kontrollierst, haben Eile. (Sie können in dem Zug, in dem sie ins Spiel kommen, angreifen und Fähigkeiten anwenden, bei denen sie getappt werden.)\\nOpfere die Feuer von Yavimaya: Eine Kreatur Deiner Wahl erhält +2/+2 bis zum Ende des Zuges.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94a87c22-06d3-4ff0-9102-374534944adf\', \'multiverseId\': 183664}, \'multiverseid\': 183664}, {\'name\': \'Fuegos de Yavimaya\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c8962b8a-f8a9-4d6d-a7a6-16d7439b33ba\'}, \'multiverseid\': None}, {\'name\': \'Feux de la Yavimaya\', \'text\': "Les créatures que vous contrôlez ont la célérité. (Elles peuvent attaquer et {T} dès le tour où elles arrivent sous votre contrôle.)\\nSacrifiez ces Feux de la Yavimaya : La créature ciblée gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185538&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14afd079-72d0-4bac-88d0-f3b681f040f5\', \'multiverseId\': 185538}, \'multiverseid\': 185538}, {\'name\': \'Fuochi di Yavimaya\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5cf243ed-217d-488e-9085-23c478aa7cd1\'}, \'multiverseid\': None}, {\'name\': \'ヤヴィマヤの火\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f127294-ceba-4000-a44e-4a64244be996\'}, \'multiverseid\': None}, {\'name\': \'Fogos de Yavimaya\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'510d081f-9667-410d-910c-f8c941c52962\'}, \'multiverseid\': None}]', "[{'name': 'Feuerbrandzombie', 'text': 'Du kannst zu Beginn Deines Versorgungssegments {1}{B}{B} bezahlen, wenn der Feuerbrandzombie in Deinem Friedhof ist. Wenn Du dies tust, bringe den Feuerbrandzombie aus Deinem Friedhof auf Deine Hand zurück.\\n{1}{R}{R}, opfere den Feuerbrandzombie: Der Feuerbrandzombie fügt einer Kreatur oder einem Spieler Deiner Wahl 2 Schadenspunkte zu.', 'type': 'Kreatur — Zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183679&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ab1f50d7-5bfb-427a-963c-58c6ca8fb183', 'multiverseId': 183679}, 'multiverseid': 183679}, {'name': 'Zombie de la Pira', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4aa6d3a1-8173-4ebd-9986-62f32eef5bfd'}, 'multiverseid': None}, {'name': 'Zombie des bûchers', 'text': 'Au début de votre entretien, si le Zombie des bûchers est dans votre cimetière, vous pouvez payer {1}{B}{B}. Si vous faites ainsi, renvoyez le Zombie des bûchers depuis votre cimetière dans votre main.\\n{1}{R}{R}, sacrifiez le Zombie des bûchers : Le Zombie des bûchers inflige 2 blessures à une cible, créature ou joueur.', 'type': 'Créature : zombie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185553&type=card', 'language': 'French', 'identifiers': {'scryfallId': '381b181b-aa5a-49dd-a2d2-8dee2b2775bb', 'multiverseId': 185553}, 'multiverseid': 185553}, {'name': 'Zombie della Pira', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6069c7eb-b369-4fcc-a211-6157bdeb20a3'}, 'multiverseid': None}, {'name': '火葬のゾンビ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '60b81b4e-2509-46c1-9c3a-abf745cffef4'}, 'multiverseid': None}, {'name': 'Zumbi da Pira', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ce3830ab-ffab-46bf-a521-9f01f05f6605'}, 'multiverseid': None}]", '[{\'name\': \'Feuerschreier\', \'text\': \'{R}: Der Feuerschreier erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Im Dunkeln ist er fast unsichtbar — bis er ausatmet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a2eaa71-cee6-4815-97c7-ed1fd37b12b1\', \'multiverseId\': 183524}, \'multiverseid\': 183524}, {\'name\': \'Gritafuego\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e56a9025-c4fd-4fae-ac73-33167d4e5a3e\'}, \'multiverseid\': None}, {\'name\': \'Crifeu\', \'text\': "{R}: Le Crifeu gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : kavru\', \'flavor\': "Dans l\'obscurité, il est presque invisible, jusqu\'à ce qu\'il souffle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185398&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'992104bd-7e4e-4cd4-bb4f-c5faa61aeff0\', \'multiverseId\': 185398}, \'multiverseid\': 185398}, {\'name\': \'Urlatore di Fuoco\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7bbf22d8-b515-49a4-849e-6637e1c170cc\'}, \'multiverseid\': None}, {\'name\': \'火吐きカヴー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be53ac5b-3c9e-460e-a6b1-3b72e631a965\'}, \'multiverseid\': None}, {\'name\': \'Grita-Fogos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'27b70c3a-709f-4cde-883c-8a86bf61e97f\'}, \'multiverseid\': None}]', '[{\'name\': \'Flammenkrone\', \'text\': \'{R}: Die verzauberte Kreatur erhält +1/+0 bis zum Ende des Zuges.\\n{R}: Bringe die Flammenkrone auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Mein ganzes Leben lange habe ich diese Monster bekämpft. Heute findet das sein Ende." —Barrin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183560&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f8c37b6-eb25-4682-9597-35e7ac5b0783\', \'multiverseId\': 183560}, \'multiverseid\': 183560}, {\'name\': \'Corona de Llamas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7995b0b7-e60b-429b-8347-f60a99f4bb42\'}, \'multiverseid\': None}, {\'name\': \'Couronne de flammes\', \'text\': "{R}: La créature enchantée gagne +1/+0 jusqu\'à la fin du tour.\\n{R}: Renvoyez la Couronne de flammes dans la main de son propriétaire.", \'type\': \'Enchanter : créature\', \'flavor\': "« Toute ma vie j\'ai affronté ces monstres. Aujourd\'hui ce combat s\'achève. » — Barrin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185434&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'622d276f-38a7-41b0-9bd4-96dc0676d3e4\', \'multiverseId\': 185434}, \'multiverseid\': 185434}, {\'name\': \'Corona di Fiamme\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1fb4c25c-3042-4a1a-ad9b-d6d83f1d3248\'}, \'multiverseid\': None}, {\'name\': \'炎の冠\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'af049ca6-64ee-4ac2-839b-bc12ea9e38e4\'}, \'multiverseid\': None}, {\'name\': \'Coroa de Chamas\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'19b7024d-c728-445a-a092-901f53df18e2\'}, \'multiverseid\': None}]', '[{\'name\': \'Flitzender Mungo\', \'text\': \'Der Flitzende Mungo kann nicht neutralisiert werden.\\nDer Flitzende Mungo kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.\', \'type\': \'Kreatur — Mungo\', \'flavor\': \'„Der Mungo blies seine Kerze aus und war schon im Bett, bevor das Zimmer dunkel wurde." —Llanowarfabel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7dc6c3af-5cc5-438f-be0a-895e0a3e2935\', \'multiverseId\': 183601}, \'multiverseid\': 183601}, {\'name\': \'Mangosta Borrosa\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'79b87fc0-7fa9-47d9-a19e-7bab95cad56d\'}, \'multiverseid\': None}, {\'name\': \'Mangouste floue\', \'text\': \'La Mangouste floue ne peut pas être contrecarrée.\\nLa Mangouste floue ne peut être la cible de sorts ou de capacités.\', \'type\': \'Créature : mangouste\', \'flavor\': \'« La mangouste éteignit la chandelle et se mit au lit avant même que la chambre devienne sombre.» — Fable de Llanowar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0dc6292-cf3f-43c2-a6b7-3953eb3c119a\', \'multiverseId\': 185475}, \'multiverseid\': 185475}, {\'name\': \'Mangusta Fulminea\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4148fc80-bf60-4af9-b55c-aca80d780993\'}, \'multiverseid\': None}, {\'name\': \'疾風のマングース\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ebc9bc79-7da8-48c1-af36-bee360d51b1b\'}, \'multiverseid\': None}, {\'name\': \'Mangusto Manchado\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b51133a0-ad3f-47c7-bf84-ed7d45089c40\'}, \'multiverseid\': None}]', '[{\'name\': \'Flügel der Hoffnung\', \'text\': \'Die verzauberte Kreatur erhält +1/+3 und Flugfähigkeit.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'Urza wußte, daß die Phyrexianer aus der Luft kommen würden, und sandte ihnen seine Soldaten entgegen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183707&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'31a9e167-1388-4bea-86da-059e56ed6907\', \'multiverseId\': 183707}, \'multiverseid\': 183707}, {\'name\': \'Alas de Esperanza\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a0fab95-17bd-4f57-8137-307f09625b44\'}, \'multiverseid\': None}, {\'name\': "Ailes de l\'espoir", \'text\': \'La créature enchantée gagne +1/+3 et a le vol.\', \'type\': \'Enchanter : créature\', \'flavor\': \'Urza savait que les Phyrexians viendraient par les airs et il se prépara à les recevoir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185581&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'332fab44-c0bd-4773-8983-544753191ab0\', \'multiverseId\': 185581}, \'multiverseid\': 185581}, {\'name\': \'Ali della Speranza\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'94a087bd-2846-4c97-90b5-a9e2ed6878b4\'}, \'multiverseid\': None}, {\'name\': \'希望の翼\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'42d3b404-348c-4a6b-85e3-84d3e48037e8\'}, \'multiverseid\': None}, {\'name\': \'Asas de Esperança\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f512e45c-13eb-48c1-893e-9b5373e7f8c7\'}, \'multiverseid\': None}]', '[{\'name\': \'Fruchtbarer Boden\', \'text\': \'Immer wenn das verzauberte Land für Mana getappt wird, erhöht sein Beherrscher seinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Landverzauberung\', \'flavor\': \'Als die Phyrexianer herabstießen, hielt Multani einen Moment inne, um die Schönheit zu betrachten, die so bald schon nicht mehr sein würde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183606&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56ff2a83-6b4f-45c1-b0a4-7bc7b901a17f\', \'multiverseId\': 183606}, \'multiverseid\': 183606}, {\'name\': \'Tierra fértil\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d152d8db-9c44-4f7c-9613-825c9b1aee2c\'}, \'multiverseid\': None}, {\'name\': \'Terrain fertile\', \'text\': "À chaque fois que le terrain enchanté est engagé pour du mana, son contrôleur ajoute un mana d\'une couleur de son choix à sa réserve.", \'type\': \'Enchanter : terrain\', \'flavor\': "Alors que les Phyrexians descendaient, Multani s\'arrêta pour admirer cette beauté qui risquait de se faner à jamais.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185480&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'45777740-1b76-41bb-8ced-bf36c403b35c\', \'multiverseId\': 185480}, \'multiverseid\': 185480}, {\'name\': \'Terreno Fertile\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83cce3e9-6298-4eb8-96bd-14407e6ec91b\'}, \'multiverseid\': None}, {\'name\': \'肥沃な大地\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f1fdf83-8a9e-4979-9cb4-1a07bc97d9db\'}, \'multiverseid\': None}, {\'name\': \'Solo Fértil\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51f51b31-3cb6-4334-ad75-39b2fe7dd218\'}, \'multiverseid\': None}]', '[{\'name\': \'Galinas Ritter\', \'text\': \'Schutz vor Rot\', \'type\': \'Kreatur — Meervolk, Ritter\', \'flavor\': \'„Sind sie auf unserer Seite?" fragte Sisay. „Solange sie Phyrexianer töten, sind sie es," antwortete Gerrard.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183666&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c880463a-569a-4a9a-bcdc-2a202a399096\', \'multiverseId\': 183666}, \'multiverseid\': 183666}, {\'name\': \'Caballero de Galina\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2d796455-133e-43ba-a5a2-35984eaa7977\'}, \'multiverseid\': None}, {\'name\': \'Chevalier de Galiva\', \'text\': \'Protection contre le rouge\', \'type\': \'Créature : ondin et chevalier\', \'flavor\': "« Sont-ils des nôtres? », demanda Sissay. « S\'ils tuent des Phyrexians, ils le sont », répliqua Gerrard.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185540&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'504bf348-6559-4deb-b514-9ced87590bdc\', \'multiverseId\': 185540}, \'multiverseid\': 185540}, {\'name\': \'Cavaliere di Galina\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0537a3df-cffe-400a-9cd1-2d4284c1d783\'}, \'multiverseid\': None}, {\'name\': \'ガリーナの騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d13ec4c6-01d8-4ff4-8639-1e91a4806b57\'}, \'multiverseid\': None}, {\'name\': \'Cavaleiro de Galina\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'179d3c24-f1d4-481a-9efd-839d76838e46\'}, \'multiverseid\': None}]', "[{'name': 'Gebirge', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183766&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bdd493b0-3d98-42bc-b990-0b3c586eb8c8', 'multiverseId': 183766}, 'multiverseid': 183766}, {'name': 'Montaña', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8a3d9f7f-0e11-4aaf-8d7d-0a0c2352908c'}, 'multiverseid': None}, {'name': 'Montagne', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185640&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c8527eea-d949-4253-a0fd-cad694574a48', 'multiverseId': 185640}, 'multiverseid': 185640}, {'name': 'Montagna', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2740cee8-031c-487b-8301-a0463cf31441'}, 'multiverseid': None}, {'name': '山', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b5880d29-dd8a-49b4-9c13-a87775983deb'}, 'multiverseid': None}, {'name': 'Montanha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0a3646ae-0274-47d3-9c92-57ceea4e9b89'}, 'multiverseid': None}]", "[{'name': 'Gebirge', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183767&type=card', 'language': 'German', 'identifiers': {'scryfallId': '21c2331d-d4c6-4858-8ab1-2b15b21509ac', 'multiverseId': 183767}, 'multiverseid': 183767}, {'name': 'Montaña', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '59377d58-8870-4ce7-9048-23558e2b51a6'}, 'multiverseid': None}, {'name': 'Montagne', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185641&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b26b3903-d4d5-427d-a83c-f5073d35670c', 'multiverseId': 185641}, 'multiverseid': 185641}, {'name': 'Montagna', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f9f2e1b8-f552-43bc-8b83-7895adffe1d6'}, 'multiverseid': None}, {'name': '山', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '7e858a70-956f-4ebc-b341-bef10245f67e'}, 'multiverseid': None}, {'name': 'Montanha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a0c8cc2c-4ebd-4476-a448-55f2f5befecb'}, 'multiverseid': None}]", "[{'name': 'Gebirge', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183768&type=card', 'language': 'German', 'identifiers': {'scryfallId': '25bb5d63-70eb-4b10-bdfd-47fcd56930d8', 'multiverseId': 183768}, 'multiverseid': 183768}, {'name': 'Montaña', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '27f84875-36e0-4827-a958-7d6d4c8b5a76'}, 'multiverseid': None}, {'name': 'Montagne', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185642&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fb1f5452-4931-41e6-b440-9c57f9c51430', 'multiverseId': 185642}, 'multiverseid': 185642}, {'name': 'Montagna', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '520ebf7c-b699-4601-ac93-07f2759a2e58'}, 'multiverseid': None}, {'name': '山', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '154a8463-88eb-4c70-a681-6b55cc6244e4'}, 'multiverseid': None}, {'name': 'Montanha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8b6878ae-6676-480a-a355-c457d8614ba3'}, 'multiverseid': None}]", "[{'name': 'Gebirge', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183769&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e4b3c8dc-10c1-4ff0-8a37-185644371e7c', 'multiverseId': 183769}, 'multiverseid': 183769}, {'name': 'Montaña', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '15782a86-7139-4264-900d-527832cad5bc'}, 'multiverseid': None}, {'name': 'Montagne', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185643&type=card', 'language': 'French', 'identifiers': {'scryfallId': '60ae6a3e-e378-4ac1-85d8-0357b73c35fd', 'multiverseId': 185643}, 'multiverseid': 185643}, {'name': 'Montagna', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'db90f422-c1cc-43ee-9f14-7b78d2dbdeb1'}, 'multiverseid': None}, {'name': '山', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b1e03a94-8181-4789-a8fd-cc0151da2b36'}, 'multiverseid': None}, {'name': 'Montanha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fca873c5-0b1b-4a80-811c-6631c3e5be2f'}, 'multiverseid': None}]", '[{\'name\': \'Gehörnter Gepard\', \'text\': \'Immer wenn der Gehörnte Gepard Schaden zufügt, erhältst Du soviele Lebenspunkte dazu.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'„Ich glaube, sie will, daß wir es essen," sagte Squee und betrachtete den öligen Kadaver, den die Gepardin zum Lagerfeuer geschleppt hatte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183669&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bf5ad54-a340-4bee-a1e7-a8de343cf083\', \'multiverseId\': 183669}, \'multiverseid\': 183669}, {\'name\': \'Leopardo Cornudo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e9d0f2f-e1bf-4469-9de8-89254287f4a1\'}, \'multiverseid\': None}, {\'name\': \'Guépard cornu\', \'text\': \'À chaque fois que le Guépard cornu inflige des blessures, vous gagnez autant de points de vie.\', \'type\': \'Créature : chat\', \'flavor\': "« Elle veut qu\'on mange ça », dit Skwi en regardant la carcasse huileuse que le guépard femelle avait ramené au camp.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185543&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e5a5c09-7d67-43eb-b755-d6963eb20c7e\', \'multiverseId\': 185543}, \'multiverseid\': 185543}, {\'name\': \'Ghepardo Cornuto\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0586adfb-e7d8-40cd-8bbf-61c44993ca37\'}, \'multiverseid\': None}, {\'name\': \'有角チータ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19476978-0b02-45c0-a077-6800403ea695\'}, \'multiverseid\': None}, {\'name\': \'Guepardo com Chifres\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9cd51ea-053b-44aa-99f0-531076e78902\'}, \'multiverseid\': None}]', "[{'name': 'Gemeinsamer Gegendruck', 'text': 'Kreaturen können Dich nicht angreifen, wenn ihr Beherrscher nicht {X} für jede angreifende Kreatur bezahlt, wobei X die Anzahl an Standardlandtypen unter den Ländern, die Du kontrollierst, ist. (Diese Kosten werden bezahlt, wenn die Angreifer deklariert werden.)', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183467&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cfc17869-7e54-45e0-95cd-fc6fd9788b54', 'multiverseId': 183467}, 'multiverseid': 183467}, {'name': 'Restricción Colectiva', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '9a35dd44-8231-4243-a5df-235876190887'}, 'multiverseid': None}, {'name': 'Restriction collective', 'text': 'Les créatures ne peuvent pas vous attaquer à moins que leur contrôleur ne paye {X} pour chaque créature qui vous attaque, X étant le nombre de types de terrains de base parmi les terrains que vous contrôlez. (Ce coût est payé quand les attaquants sont déclarés.)', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185341&type=card', 'language': 'French', 'identifiers': {'scryfallId': '64709165-11d2-419e-a20a-4ecc52422e67', 'multiverseId': 185341}, 'multiverseid': 185341}, {'name': 'Repressione Collettiva', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '77476e1f-3bb5-40a9-9559-40b4a43cdd74'}, 'multiverseid': None}, {'name': '集団監禁', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3b586029-456e-4243-9c31-d338365f23ce'}, 'multiverseid': None}, {'name': 'Restrição Colectiva', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dd438809-9fbe-44bf-862f-5a3f042a4c81'}, 'multiverseid': None}]", '[{\'name\': \'Gemächlicher Riese\', \'text\': \'Immer wenn der Gemächliche Riese angreift oder blockt, lege die oberste Karte Deiner Bibliothek in Deinen Friedhof. Wenn diese Karte ein Land war, verhindere allen Kampfschaden, den der Gemächliche Riese in diesem Zug zufügen würde.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'„Vergiß es. Heute stehe ich nicht auf."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183571&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'064a3633-042f-42c1-b889-ead28b6e5d18\', \'multiverseId\': 183571}, \'multiverseid\': 183571}, {\'name\': \'Gigante Aragan\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'505fa87b-18ab-4b0d-b242-03452afc1dfb\'}, \'multiverseid\': None}, {\'name\': \'Géant paresseux\', \'text\': \'À chaque fois que le Géant paresseux attaque ou bloque, mettez la carte du dessus de votre bibliothèque dans votre cimetière. Si cette carte est une carte de terrain, prévenez toutes les blessures de combat que le Géant paresseux devrait infliger ce tour-ci.\', \'type\': \'Créature : géant\', \'flavor\': \'« Laisse tomber Pas envie de me lever ce matin.»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185445&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bb6553d-2bb7-4da5-b304-dad52538ab0a\', \'multiverseId\': 185445}, \'multiverseid\': 185445}, {\'name\': \'Gigante Ozioso\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c4fd06f-51c1-41b7-a91b-04406787e41e\'}, \'multiverseid\': None}, {\'name\': \'ぶらつく巨人\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76fc4ecb-2c49-46b9-99ce-0354bb6982d9\'}, \'multiverseid\': None}, {\'name\': \'Gigante Mandrião\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68e7f9a2-9f2e-496e-b80a-018d9f1cce4a\'}, \'multiverseid\': None}]', '[{\'name\': \'Geordnete Vogelzüge\', \'text\': \'Bringe für jeden Standardlandtyp unter den Ländern, die Du kontrollierst, einen 1/1 blauen Vogelspielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': \'„Vögel erreichen jeden Teil der Welt," sagte Barrin. „Sie werden hervorragende Späher abgeben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183676&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af415f80-0755-4146-a3ca-ee33c76cdaf6\', \'multiverseId\': 183676}, \'multiverseid\': 183676}, {\'name\': \'Migración Ordenada\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab05af56-4395-4681-8f02-cdc365dc0eae\'}, \'multiverseid\': None}, {\'name\': \'Migration programmée\', \'text\': \'Mettez en jeu un jeton de créature 1/1 bleue avec le vol Oiseau pour chaque type de terrain de base parmi les terrains que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "« Les oiseaux vont partout », dit Barrin. « Ils feront d\'excellents éclaireurs. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185550&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'57f57bf8-9074-4876-b5a6-abb1943c31e1\', \'multiverseId\': 185550}, \'multiverseid\': 185550}, {\'name\': \'Migrazione Ordinata\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'75bcc75e-5e3d-451f-9933-275129b79ba1\'}, \'multiverseid\': None}, {\'name\': \'秩序ある渡り\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98cec0b8-183d-4fcc-bb96-0c516dd1b638\'}, \'multiverseid\': None}, {\'name\': \'Migração Ordeira\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b716084f-e60e-4714-b271-4b63bd105125\'}, \'multiverseid\': None}]', "[{'name': 'Geothermische Spalte', 'text': 'Die Geothermische Spalte kommt getappt ins Spiel.\\n{T}: Erhöhe Deinen Manavorrat um {R}.\\n{T}, opfere die Geothermische Spalte: Erhöhe Deinen Manavorrat um {B}{G}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183746&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b89f4002-e710-4237-8efb-e0840cda7486', 'multiverseId': 183746}, 'multiverseid': 183746}, {'name': 'Fisura Geotérmica', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '129eb4d2-a9be-4407-95d7-038ed1f4ef4c'}, 'multiverseid': None}, {'name': 'Crevasse bouillonnante', 'text': 'La Crevasse bouillonnante arrive en jeu engagée.\\n{T} : Ajoutez {R} à votre réserve.\\n{T}, sacrifiez la Crevasse bouillonnante: Ajoutez {B}{G} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185620&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e261363a-73dc-410b-9f6b-c4c56320c11a', 'multiverseId': 185620}, 'multiverseid': 185620}, {'name': 'Fenditura Geotermica', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7863b32f-f44a-4f24-9705-754407cc2962'}, 'multiverseid': None}, {'name': '地熱の割れ目', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '51ae9840-97a2-47e9-9590-beb4ab790310'}, 'multiverseid': None}, {'name': 'Fenda Geotérmica', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '978e849f-9837-4a31-a1a4-009882f55cd3'}, 'multiverseid': None}]", '[{\'name\': \'Gepanzerter Wächter\', \'text\': \'{1}{W}{W}: Bestimme eine Farbe. Eine Kreatur Deiner Wahl, die Du kontrollierst, erhält Schutz vor dieser Farbe bis zum Ende des Zuges.\\n{1}{U}{U}: Der gepanzerte Wächter kann in diesem Zug nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.\', \'type\': \'Kreatur — Wächter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183648&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b29c5e7-f41e-4f4e-bdde-66eca6ca6e8c\', \'multiverseId\': 183648}, \'multiverseid\': 183648}, {\'name\': \'Guardián Acorazado\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42d44d94-2b61-4784-9c67-492353805a4d\'}, \'multiverseid\': None}, {\'name\': \'Vigile en armure\', \'text\': "{1}{W}{W} : La créature ciblée que vous contrôlez acquiert la protection contre la couleur de votre choix jusqu\'à la fin du tour.\\n{1}{U}{U} : Le Vigile en armure ne peut être la cible de sorts ou de capacités ce tour-ci.", \'type\': \'Créature : vigile\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185522&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4baa0228-83a3-4e18-80a0-5aaf55d530ec\', \'multiverseId\': 185522}, \'multiverseid\': 185522}, {\'name\': \'Guardiano Corazzato\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bdb6d73d-444c-4446-b179-e7252e382f7a\'}, \'multiverseid\': None}, {\'name\': \'鎧を着た守護者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ee299f9e-499f-4a85-ab89-a4579ccb4f16\'}, \'multiverseid\': None}, {\'name\': \'Guardião de Armadura\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'82114d06-cc39-4b2e-9d3c-c398b63e2834\'}, \'multiverseid\': None}]', '[{\'name\': \'Gesandter der Natur\', \'text\': \'Bonus {1}{R} (Du kannst zusätzlich {1}{R} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nWenn Du die Bonuskosten bezahlt hast, zerstöre ein Artefakt Deiner Wahl, wenn der Gesandte der Natur ins Spiel kommt. Es kann nicht regeneriert werden.\', \'type\': \'Kreatur — Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183639&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c1fe01d-b309-454d-936f-d3ac1d664486\', \'multiverseId\': 183639}, \'multiverseid\': 183639}, {\'name\': \'Emisaria Verdurana\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c51d3058-7783-49e8-bfc1-074bf418e8ed\'}, \'multiverseid\': None}, {\'name\': \'Émissaire de Verdural\', \'text\': "Kick {1}{R} (Vous pouvez payer {1}{R} supplémentaires quand vous jouez ce sort.)\\nQuand l\'Émissaire de Verdural arrive en jeu, si vous avez payé le coût de kick, détruisez l\'artefact ciblé. Il ne peut pas être régénéré.", \'type\': \'Créature : sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7db47b28-93e6-499d-90be-bf2e90f45ea0\', \'multiverseId\': 185513}, \'multiverseid\': 185513}, {\'name\': \'Emissario dei Boschi\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c19c67f-262a-49d2-ba00-9a53402758da\'}, \'multiverseid\': None}, {\'name\': \'新緑の使者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a21a053-1042-4112-9a6c-938fc15d329d\'}, \'multiverseid\': None}, {\'name\': \'Emissário de Verduran\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f761dc4-2fd5-46d1-b8f7-a8920c2cc5d7\'}, \'multiverseid\': None}]', '[{\'name\': \'Gewundener Kavu\', \'text\': \'{R}: Der Gewundene Kavu erhält Eile bis zum Ende des Zuges. (Er kann in dem Zug, in dem er unter Deine Kontrolle kommt, angreifen und Fähigkeiten anwenden, bei denen er getappt wird.)\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Unter Yavimayas friedlichem Äußeren schlagen die Herzen vieler wilder Bestien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183629&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'223819a9-d03b-4963-8186-652298a7e88a\', \'multiverseId\': 183629}, \'multiverseid\': 183629}, {\'name\': \'Kavu Serpentino\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9cf151a2-dda1-4eec-b791-3bb2d39b55c2\'}, \'multiverseid\': None}, {\'name\': \'Kavru serpentin\', \'text\': "{R}: Le Kavru serpentin acquiert la célérité jusqu\'à la fin du tour. (Elle peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)", \'type\': \'Créature : kavru\', \'flavor\': \'Sous la calme surface de la Yavimaya battent mille cœurs de bêtes féroces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185503&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1349c11a-4e8a-46d8-8529-bf86179aef1b\', \'multiverseId\': 185503}, \'multiverseid\': 185503}, {\'name\': \'Kavu Serpentino\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9a55ffad-fde1-4946-91a4-5365e5556a73\'}, \'multiverseid\': None}, {\'name\': \'うねるカヴー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dea9bc03-bc58-4179-bba8-76b735b787c8\'}, \'multiverseid\': None}, {\'name\': \'Kavu Serpenteante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6313e216-f041-44c8-b382-8a3809b06111\'}, \'multiverseid\': None}]', "[{'name': 'Ghitufeuer', 'text': 'Du kannst Ghitufeuer immer denn spielen, wenn Du auch einen Spontanzauber spielen könntest, wenn Du zusätzlich {2} bezahlst.\\nGhitufeuer fügt einer Kreatur oder einem Spieler Deiner Wahl X Schadenspunkte zu', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183562&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3ca2d870-802f-4fd9-91f5-fc782aa215eb', 'multiverseId': 183562}, 'multiverseid': 183562}, {'name': 'Fuego Ghitu', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd4ef4e12-82ec-420b-82f4-caf14573f49f'}, 'multiverseid': None}, {'name': 'Feu guitûk', 'text': 'Vous pouvez jouer le Feu guitûk à tout moment où vous pourriez jouer un éphémère si vous payez {2} de plus pour cela.\\nLe Feu guitûk inflige X blessures à une cible, créature ou joueur.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185436&type=card', 'language': 'French', 'identifiers': {'scryfallId': '97a194d2-cd70-4882-a398-c1a555f06612', 'multiverseId': 185436}, 'multiverseid': 185436}, {'name': 'Fuoco Ghitu', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c3b3c7a7-a45d-4379-a8ee-5e813e42620f'}, 'multiverseid': None}, {'name': 'ギトゥの火', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e667a370-efc8-4c2b-a64c-f5c2d17a4d21'}, 'multiverseid': None}, {'name': 'Fogo de Ghitu', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3b4ce927-f1d7-4c54-86cc-139205f2bf42'}, 'multiverseid': None}]", '[{\'name\': \'Gierige Kobra\', \'text\': \'Erstschlag\\nImmer wenn die Gierige Kobra einer Kreatur Kampfschaden zufügt, zerstöre diese Kreatur.\', \'type\': \'Kreatur — Ophis\', \'flavor\': \'Es gibt kein Gegenmittel gegen das Gift der Kobra... und auch keins gegen ihren Appetit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183706&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20a70b4d-2a09-4431-bfa0-32307729028d\', \'multiverseId\': 183706}, \'multiverseid\': 183706}, {\'name\': \'Cobra Voraz\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ecae6e6-374f-4c92-ab6c-ef49063173c3\'}, \'multiverseid\': None}, {\'name\': \'Cobra vorace\', \'text\': \'Initiative\\nÀ chaque fois que le Cobra vorace inflige des blessures de combat à une créature, détruisez cette créature.\', \'type\': \'Créature : serpent\', \'flavor\': "Il n\'y a pas d\'antidote connu contre le venin du cobra, ni contre son appétit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185580&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d392eaed-e6ca-48eb-b9e0-7f99f90189d0\', \'multiverseId\': 185580}, \'multiverseid\': 185580}, {\'name\': \'Cobra Vorace\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dc2ccb37-db4d-4759-9a8f-62fad5511ba4\'}, \'multiverseid\': None}, {\'name\': \'大食のコブラ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81844eae-fa6c-4157-afc1-1839c0f2a0b4\'}, \'multiverseid\': None}, {\'name\': \'Naja Voraz\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd396dfb-442d-4375-a21c-3e2620a60da0\'}, \'multiverseid\': None}]', '[{\'name\': \'Gierige Ratten\', \'text\': \'Wenn die Gierigen Ratten ins Spiel kommen, wirft ein Gegner Deiner Wahl eine Karte aus seiner Hand ab.\', \'type\': \'Kreatur — Ratte\', \'flavor\': \'Den Ratten ist nichts heilig. Alles ist nur eine weitere Mahlzeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183538&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'996b58bf-af12-4e0d-986a-2af66157018c\', \'multiverseId\': 183538}, \'multiverseid\': 183538}, {\'name\': \'Ratas Rapaces\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'45440420-35ee-4015-bc21-9811c0877515\'}, \'multiverseid\': None}, {\'name\': \'Rats voraces\', \'text\': "Quand ces Rats voraces arrivent en jeu, l\'adversaire ciblé se défausse d\'une carte de sa main.", \'type\': \'Créature : rat\', \'flavor\': "Rien n\'est sacré pour les rats. Tout leur est nourriture.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a62a578c-07c4-47bd-bcc7-05fe4d84f7b9\', \'multiverseId\': 185412}, \'multiverseid\': 185412}, {\'name\': \'Ratti Famelici\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b85fb56-ad05-478f-ad5e-5d7499c3803c\'}, \'multiverseid\': None}, {\'name\': \'貪欲なるネズミ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74b19285-5a30-4052-8fb9-e8757f92f981\'}, \'multiverseid\': None}, {\'name\': \'Ratos Vorazes\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e63cd79f-9bfb-4399-9ebc-4629c8d171e8\'}, \'multiverseid\': None}]', '[{\'name\': \'Glimmernder Engel\', \'text\': \'Fliegend\\n{U}: Der Glimmernde Engel kann in diesem Zug nicht das Ziel von Zaubersprüchen und Fähigkeiten sein.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„Wir wandten uns um, um die Herkunft des Schlages zu erkunden, doch wir sahen nur ein fernes Leuchten." —Lord der Capashen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183435&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69ce571b-f863-44a0-9506-60f1c4d7d4e9\', \'multiverseId\': 183435}, \'multiverseid\': 183435}, {\'name\': \'Angel Centelleante\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e849b9b7-b890-4459-bbd5-ef4588fad8bc\'}, \'multiverseid\': None}, {\'name\': \'Ange rayonnant\', \'text\': "Vol\\n{U}: L\'Ange rayonnant ne peut être la cible de sorts ou de capacités ce tour-ci.", \'type\': \'Créature : ange\', \'flavor\': "« Nous nous tournâmes vers la direction du coup mais ne vîmes qu\'un rai de lumière dans le lointain. » — Un seigneur capashen.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185309&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2dfe02c7-0f30-4ac6-a5eb-35fbf908abec\', \'multiverseId\': 185309}, \'multiverseid\': 185309}, {\'name\': \'Angelo Scintillante\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0257063-dd1f-4f1b-9a76-15cf4a052bed\'}, \'multiverseid\': None}, {\'name\': \'薄光の天使\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a55db75b-80bf-496c-b48d-37af32b98e96\'}, \'multiverseid\': None}, {\'name\': \'Anjo Brilhante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a9517b4-86f8-4c9a-85f5-7cccdaca07d4\'}, \'multiverseid\': None}]', '[{\'name\': \'Glitzernde Gischt\', \'text\': \'Ändere den Text eines Zauberspruchs oder einer bleibenden Karte Deiner Wahl bis zum Ende des Zuges, indem Du alle Vorkommen einer Farbe oder eines Standardlandtyps durch eine(n) andere(n) ersetzt.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183468&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f60541cb-a7d5-453f-afa7-8344346b2f72\', \'multiverseId\': 183468}, \'multiverseid\': 183468}, {\'name\': \'Rociada de Cristal\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9a85520d-1f19-4fb6-a01a-0480962e94cf\'}, \'multiverseid\': None}, {\'name\': \'Giclée de cristaux\', \'text\': "Changez le texte du sort ciblé ou du permanent ciblé en remplaçant toutes les occurrences d\'un nom de couleur ou de type de terrain de base par un autre jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185342&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'757a2a5f-149e-4ee9-ad28-36da95ef0af9\', \'multiverseId\': 185342}, \'multiverseid\': 185342}, {\'name\': \'Spruzzo di Cristallo\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7889d5f-6baa-4290-b375-c76100ce7093\'}, \'multiverseid\': None}, {\'name\': \'水晶のしぶき\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad34476f-ef78-44bc-92f2-5531b08ea960\'}, \'multiverseid\': None}, {\'name\': \'Difusão de Cristal\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dfaf8825-4752-4f09-ba8f-a8e3f7a078dd\'}, \'multiverseid\': None}]', '[{\'name\': \'Globale Vernichtung\', \'text\': \'Jeder Spieler bestimmt von den Ländern, die er kontrolliert, ein Land jedes Standardlandtyps und opfert dann die restlichen Länder.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Erde erbebte, der Himmel weinte Feuer, und es schien, als endete die Welt." —Unbekannter benalischer Flüchtling\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183436&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'809d6017-8123-4dd5-9690-057cd8780aad\', \'multiverseId\': 183436}, \'multiverseid\': 183436}, {\'name\': \'Ruina Global\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f959fd57-60aa-4810-aedf-dfe3ce5a8371\'}, \'multiverseid\': None}, {\'name\': \'Destruction globale\', \'text\': "Chaque joueur choisit parmi les terrains qu\'il contrôle un terrain de chaque type de terrain de base, puis il sacrifie les autres.", \'type\': \'Rituel\', \'flavor\': "« La terre a tremblé, le feu est tombé du ciel et le monde s\'est comme arrêté. » — Un réfugié bénalian.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185310&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77b845fa-79ce-4458-a01c-d51eb00a1d32\', \'multiverseId\': 185310}, \'multiverseid\': 185310}, {\'name\': \'Rovina Globale\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d3010d7-3846-4fd9-aaf5-18591070822e\'}, \'multiverseid\': None}, {\'name\': \'世界の荒廃\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a1d96af0-7894-466f-8e9d-c8874e1f09e9\'}, \'multiverseid\': None}, {\'name\': \'Ruína Global\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5d89773-a232-4747-bcf9-67818f5a30ec\'}, \'multiverseid\': None}]', '[{\'name\': \'Goblinspion\', \'text\': \'Die oberste Karte Deiner Bibliothek ist immer aufgedeckt.\', \'type\': \'Kreatur — Goblin\', \'flavor\': \'„Ist er nicht einer von unseren?" „Konkret." „Warum spioniert er dann uns aus?" „Frag besser nicht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183563&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5a3acf6-5676-4248-bd40-60f1dacf0b81\', \'multiverseId\': 183563}, \'multiverseid\': 183563}, {\'name\': \'Espía Trasgo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'392c314e-2283-480e-969d-64eadae05c82\'}, \'multiverseid\': None}, {\'name\': \'Espion gobelin\', \'text\': \'Jouez avec la carte du dessus de votre bibliothèque révélée.\', \'type\': \'Créature : gobelin\', \'flavor\': "« Il est des nôtres ? — Ouaip — Alors pourquoi il nous espionne ? — Vaut mieux pas d\'mander. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185437&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1515d7b5-7282-4ca1-9fab-795fd45e882a\', \'multiverseId\': 185437}, \'multiverseid\': 185437}, {\'name\': \'Spia Goblin\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c51d3b2-ef32-4a07-b29d-b6f2ffbee381\'}, \'multiverseid\': None}, {\'name\': \'ゴブリンのスパイ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16f9d861-6117-4ddf-b582-39cbe5cbd73f\'}, \'multiverseid\': None}, {\'name\': \'Espião Goblin\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eea63a70-4fed-4d31-9a87-ed2423709329\'}, \'multiverseid\': None}]', '[{\'name\': \'Goham-Dschinn\', \'text\': \'{1}{B}: Regeneriere den Goham-Dschinn.\\nDer Goham-Dschinn erhält -2/-2, solange Schwarz die häufigste Farbe unter bleibenden Karten ist. Dies gilt auch bei Gleichstand.\', \'type\': \'Kreatur — Dschinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183525&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'137666ee-0438-41b2-a3de-fe5583c85406\', \'multiverseId\': 183525}, \'multiverseid\': 183525}, {\'name\': \'Djinn Goham\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'792ca369-c1ca-448f-ab0c-564b664210d9\'}, \'multiverseid\': None}, {\'name\': \'Djinn gohâm\', \'text\': "{1}{B}: Régénérez le Djinn gohâm.\\nLe Djinn gohâm gagne -2/-2 tant que le noir est la couleur la plus fréquente parmi tous les permanents (même en cas d\'égalité).", \'type\': \'Créature : djinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185399&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3ab802f-9ce2-4516-9a1b-cd0af71e038a\', \'multiverseId\': 185399}, \'multiverseid\': 185399}, {\'name\': \'Genio Goham\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af6e6078-c3dd-4895-aaa8-21e3bb934f0e\'}, \'multiverseid\': None}, {\'name\': \'ゴーアム・ジン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'520799c9-f672-430d-88ec-14d7c8ae35bc\'}, \'multiverseid\': None}, {\'name\': \'Gênio Goham\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e848eb4c-6d75-4a89-8f06-3b24e9eb0f5c\'}, \'multiverseid\': None}]', '[{\'name\': \'Grabenwurm\', \'text\': \'{2}{R}, {T}: Zerstöre ein Nicht-Standardland Deiner Wahl.\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'„Ihre Ankunft bedeutet wohl das Ende von Yawgmoths Subtilität." —Urza\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183545&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'827d650c-5c5b-42bb-a704-8e2a79c4a4c6\', \'multiverseId\': 183545}, \'multiverseid\': 183545}, {\'name\': \'Sierpe Zanjadora\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1f3a011-f86f-41e3-826c-31ddb8be3942\'}, \'multiverseid\': None}, {\'name\': \'Guivre fouisseuse\', \'text\': \'{2}{R}, {T} : Détruisez le terrain non-base ciblé.\', \'type\': \'Créature : guivre\', \'flavor\': \'« Avec leur arrivée, Yaugzebul a arrêté son approche discrète. » — Urza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185419&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5be8ef1f-fa6e-4378-8b57-0c531097ea3b\', \'multiverseId\': 185419}, \'multiverseid\': 185419}, {\'name\': \'Wurm del Fosso\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'789ffbbe-4a33-40f3-b0bb-e402b6758d0a\'}, \'multiverseid\': None}, {\'name\': \'塹壕のワーム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'007daf9f-4805-443b-8f65-61d1935619f9\'}, \'multiverseid\': None}, {\'name\': \'Vorme de Trincheira\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c98c17e-4cf1-4a25-8805-81a0e332a29f\'}, \'multiverseid\': None}]', '[{\'name\': \'Gruftengel\', \'text\': \'Fliegend, Schutz vor Weiß\\nWenn der Gruftengel ins Spiel kommt, bringe eine blaue oder eine rote Kreaturenkarte Deiner Wahl aus Deinem Friedhof auf Deine Hand zurück.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Einst ein Engel, jetzt ein Scheusal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183515&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65ffcbe0-6895-4130-b676-7103258a7d10\', \'multiverseId\': 183515}, \'multiverseid\': 183515}, {\'name\': \'Angel de la Cripta\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3412620d-55f7-4bad-8a4b-281a774b6904\'}, \'multiverseid\': None}, {\'name\': \'Ange de la crypte\', \'text\': "Vol, protection contre le blanc\\nQuand l\'Ange de la crypte arrive en jeu renvoyez la carte de créature ciblée, bleue ou rouge, depuis votre cimetière dans votre main.", \'type\': \'Créature : ange\', \'flavor\': "Autrefois un ange, aujourd\'hui une abomination.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185389&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2249f4e2-4533-48bd-8938-4b8d9babad2a\', \'multiverseId\': 185389}, \'multiverseid\': 185389}, {\'name\': \'Angelo della Cripta\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d019f71-22b8-4485-bf15-f281d767e07b\'}, \'multiverseid\': None}, {\'name\': \'墓所の天使\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86e76897-7bcd-4eea-9ebf-7364a9d498cb\'}, \'multiverseid\': None}, {\'name\': \'Anjo da Cripta\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffbc7269-0913-4716-bc44-a910cf51d42b\'}, \'multiverseid\': None}]', '[{\'name\': \'Göttliche Gegenwart\', \'text\': \'Wenn eine Schadensquelle einer Kreatur oder einem Spieler 4 oder mehr Schadenspunkte zufügen würde, fügt sie stattdessen dieser Kreatur oder diesem Spieler 3 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Serras Licht ist nicht so leicht zu löschen." —Reya Morgenbringer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183433&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18aa77e5-5a81-4c8e-a28a-87b7dc956551\', \'multiverseId\': 183433}, \'multiverseid\': 183433}, {\'name\': \'Presencia Divina\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'de90adff-8d26-43c1-9d1c-794d7b498247\'}, \'multiverseid\': None}, {\'name\': \'Présence divine\', \'text\': \'Si une source devait infliger 4 blessures ou plus à une créature ou à un joueur, cette source infligerait 3 blessures à cette créature ou à ce joueur à la place.\', \'type\': \'Enchantement\', \'flavor\': "« La lumière de Serra ne s\'éteint pas facilement.» — Reya Aubevenant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185307&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d894e2c0-4f4f-4d78-a14e-a9421534bebb\', \'multiverseId\': 185307}, \'multiverseid\': 185307}, {\'name\': \'Presenza Divina\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f709725b-34a4-4455-969b-ccbc18e575f0\'}, \'multiverseid\': None}, {\'name\': \'神々しい存在\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4a7da78d-7cd3-401c-9853-97078f85e3aa\'}, \'multiverseid\': None}, {\'name\': \'Presença Divina\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bbf857c-ea64-4468-8226-2ff7e12088d4\'}, \'multiverseid\': None}]', '[{\'name\': \'Hain der Reinheit\', \'text\': \'Alle anderen Verzauberungen, die Du kontrollierst, können nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.\\n{1}, opfere den Hain der Reinheit: Durchsuche Deine Bibliothek nach einer Verzauberungskarte und zeige diese offen. Mische Deine Bibliothek und lege dann diese Karte oben darauf.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183696&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10956852-4969-4fdb-a6b3-d0e86f7be9bb\', \'multiverseId\': 183696}, \'multiverseid\': 183696}, {\'name\': \'Arboleda Pura\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3301616b-feeb-43d2-b98c-01194c75f092\'}, \'multiverseid\': None}, {\'name\': \'Bosquet solide\', \'text\': "Tous les autres enchantements que vous contrôlez ne peuvent être la cible de sorts ou de capacités.\\n{1}, sacrifiez le Bosquet solide : Cherchez dans votre bibliothèque une carte d\'enchantement et révélez cette carte. Mélangez votre bibliothèque puis mettez cette carte au-dessus.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185570&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1d37be8a-3681-4f05-92ac-2616af20000c\', \'multiverseId\': 185570}, \'multiverseid\': 185570}, {\'name\': \'Boschetto Prezioso\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a117b67b-ad49-46fc-a606-34370e88fd78\'}, \'multiverseid\': None}, {\'name\': \'真の木立ち\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bcf277a6-fc7f-451a-ba5f-6f48b1b8c095\'}, \'multiverseid\': None}, {\'name\': \'Bosque Esterlino\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a1dfad4d-df9f-4723-aa27-c1437417c1dc\'}, \'multiverseid\': None}]', '[{\'name\': \'Halam-Dschinn\', \'text\': \'Eile (Diese Kreatur kann in den Zug, in dem sie unter Deine Kontrolle kommt, angreifen und Fähigkeiten anwenden, bei denen sie getappt wird.)\\nDer Halam-Dschinn erhält -2/-2, solange Rot die häufigste Farbe unter bleibenden Karten ist. Dies gilt auch bei Gleichstand.\', \'type\': \'Kreatur — Dschinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183564&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'571e1054-ab9d-4f29-9aa4-a27c759176a8\', \'multiverseId\': 183564}, \'multiverseid\': 183564}, {\'name\': \'Djinn Halam\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84ec357c-4bf3-43b3-9d70-09e8c9e6e059\'}, \'multiverseid\': None}, {\'name\': \'Djinn halâm\', \'text\': "Célérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)\\nLe Djinn halâm gagne -2/-2 tant que le rouge est la couleur la plus fréquente parmi tous les permanents (même en cas d\'égalité).", \'type\': \'Créature : djinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185438&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea4e0568-b2dc-4db0-a03c-cd20413b6baa\', \'multiverseId\': 185438}, \'multiverseid\': 185438}, {\'name\': \'Genio Halam\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ed96255-2de7-4e2a-a7fb-26f1ae631841\'}, \'multiverseid\': None}, {\'name\': \'ハラム・ジン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'73b5b192-407a-40ea-a406-5ae0909b409d\'}, \'multiverseid\': None}, {\'name\': \'Génio Halam\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7fda2a0f-da6b-418b-b21a-2bb524bf63f4\'}, \'multiverseid\': None}]', '[{\'name\': \'Hanna die Navigatorin\', \'text\': \'{1}{W}{U}, {T}: Bringe ein Artefakt oder eine Verzauberung Deiner Wahl aus Deinem Friedhof auf Deine Hand zurück.\', \'type\': \'Kreatur — Legende\', \'flavor\': \'„Ich hätte nie gedacht, daß ich mein Leben mit Kämpfen verbringe. Ich bin eine Schafferin, keine Zerstörerin."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183667&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa4ffc68-759a-4f85-9f37-02732241b52f\', \'multiverseId\': 183667}, \'multiverseid\': 183667}, {\'name\': \'Hanna, Navegante del Barco\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab61d68e-ffe6-4118-bc50-086e68541d06\'}, \'multiverseid\': None}, {\'name\': \'Hanna la navigatrice\', \'text\': "{1}{W}{U}, {T} : Renvoyez la carte d\'artefact ou d\'enchantement ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : Légende\', \'flavor\': "« Je n\'avais jamais pensé que je passerai ma vie à me battre. J\'étais faite pour bâtir, non pour détruire. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185541&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73f4580d-4ca7-49ed-8e1e-0feb26a5365c\', \'multiverseId\': 185541}, \'multiverseid\': 185541}, {\'name\': \'Hanna,Pilota della Nave\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7114acb8-dc52-47c1-89d8-860bf2ed4f00\'}, \'multiverseid\': None}, {\'name\': \'航行長ハナ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d76adb5d-d324-4b22-b663-29f39cbaee49\'}, \'multiverseid\': None}, {\'name\': \'Hanna, Navegadora\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6da01d1c-0534-4ac1-b93a-8c1393d63373\'}, \'multiverseid\': None}]', '[{\'name\': \'Hartes Urteil\', \'text\': \'Bestimme eine Farbe, wenn das Harte Urteil ins Spiel kommt.\\nWenn ein Spontanzauber oder eine Hexerei dieser Farbe Dir Schaden zufügen würde, fügt sie diesen Schaden stattdessen ihrem Beherrscher zu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Immerhin wissen sie noch, wer ich bin." —Gerrard\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183437&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b896682-5507-4380-bc6d-74e77f072294\', \'multiverseId\': 183437}, \'multiverseid\': 183437}, {\'name\': \'Juicio Severo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5eeb0ca4-a9b6-46ff-9176-0a27c8e1950b\'}, \'multiverseid\': None}, {\'name\': \'Jugement cruel\', \'text\': \'Au moment où le Jugement cruel arrive en jeu, choisissez une couleur.\\nSi un éphémère ou un rituel de la couleur choisie devait vous infliger des blessures, il infligera ces blessures à son contrôleur à la place.\', \'type\': \'Enchantement\', \'flavor\': \'« Au moins se souviennent-ils de moi. » — Gerrard.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185311&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'02150f20-11e3-45e8-9a6f-040332ea3691\', \'multiverseId\': 185311}, \'multiverseid\': 185311}, {\'name\': \'Giudizio Affrettato\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd43e409-0302-4ffa-81dc-3a45f480cd05\'}, \'multiverseid\': None}, {\'name\': \'苛酷な審判\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6955c55f-4a90-48c2-be96-296086bbb30f\'}, \'multiverseid\': None}, {\'name\': \'Julgamento Austero\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'19ccbfa4-6bf7-437b-afc1-435753199aa6\'}, \'multiverseid\': None}]', "[{'name': 'Heiler der Baumhirten', 'text': '{2}{W}, {T}: Verhindere die nächsten 2 Schadenspunkte, die einer Kreatur oder einem Spieler Deiner Wahl in diesem Zug zugefügt werden.', 'type': 'Kreatur — Baumhirte', 'flavor': 'Von den Druiden für viele Jahrhunderte geschützt, begann der Wald nun, diesen Gefallen zurückzuzahlen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183636&type=card', 'language': 'German', 'identifiers': {'scryfallId': '304c40cb-f361-4772-890f-9b3b45437df6', 'multiverseId': 183636}, 'multiverseid': 183636}, {'name': 'Pueblo Arbóreo Sanador', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'b2fdca08-9bad-443c-9a0f-cdb91f85c707'}, 'multiverseid': None}, {'name': 'Guérisseur sylvin', 'text': '{2}{W}, {T}: Prévenez, ce tour-ci, les prochai-nes 2 blessures qui devraient être infligées à une cible, créature ou joueur.', 'type': 'Créature : sylvin', 'flavor': 'La forêt avait été protégée pendant des siècles par les druides. Elle sut leur rendre la politesse.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185510&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b223bc97-bda8-4739-9c78-8e3c67002329', 'multiverseId': 185510}, 'multiverseid': 185510}, {'name': 'Curatore Silvantropo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a4b57495-89d7-44cf-babf-768a8a02cd57'}, 'multiverseid': None}, {'name': 'ツリーフォークの癒し手', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '525a307c-7248-4082-8ac6-112134ef28ce'}, 'multiverseid': None}, {'name': 'Curandeiro Ent', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'af7c3902-58ca-4204-8b6c-8e3845cc3989'}, 'multiverseid': None}]", '[{\'name\': \'Heißblütiger Soldat\', \'text\': \'Bonus {2} (Du kannst zusätzlich {2} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nDer Heißblütige Soldat wird beim Angreifen nicht getappt.\\nWenn Du die Bonuskosten bezahlt hast, kommt der Heißblütige Soldat mit einer +1/+1-Marke ins Spiel.\', \'type\': \'Kreatur — Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183421&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3fe705c0-2f43-471f-9fcd-0ec5786b770c\', \'multiverseId\': 183421}, \'multiverseid\': 183421}, {\'name\': \'Soldado Ardoroso\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a521f5ef-9313-4136-914c-9121a11512b9\'}, \'multiverseid\': None}, {\'name\': \'Soldat ardent\', \'text\': "Kick {2} (Vous pouvez payer {2} supplémentaires quand vous jouez ce sort.)\\nAttaquer avec le Soldat ardent ne le fait pas s\'engager.\\nSi vous avez payé le coût de kick, le Soldat ardent arrive en jeu avec un marqueur +1/+1 sur lui.", \'type\': \'Créature : soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185295&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aeec220f-980e-4181-8aac-0087a7b43c75\', \'multiverseId\': 185295}, \'multiverseid\': 185295}, {\'name\': \'Soldato Fervente\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60a41eea-41b9-475c-beb0-6798423db18f\'}, \'multiverseid\': None}, {\'name\': \'献身的兵士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb1287ab-7f6c-4618-a7f1-2eb9ab774505\'}, \'multiverseid\': None}, {\'name\': \'Soldado Fervoroso\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa3de26e-23fb-40db-8bbf-be615e80cbe0\'}, \'multiverseid\': None}]', "[{'name': 'Herumstreifender Riese', 'text': 'Der Herumstreifende Riese erhält +1/+1 für jeden Standardlandtyp unter den Ländern, die Du kontrollierst.', 'type': 'Kreatur — Riese', 'flavor': 'Seine Größe und seine Schrittlänge nehmen mit jeder neuen Wanderung zu.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183462&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0b769c52-42b0-458d-abf4-433a5d7cd06d', 'multiverseId': 183462}, 'multiverseid': 183462}, {'name': 'Gigante Caminante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '69c08a8b-df3c-46c7-9806-e217233f430a'}, 'multiverseid': None}, {'name': 'Géant baladeur', 'text': 'Le Géant baladeur gagne +1/+1 pour chaque type de terrain de base parmi les terrains que vous contrôlez.', 'type': 'Créature : géant', 'flavor': 'Sa taille et ses enjambées augmentaient à chacune de ses étapes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185336&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c042b9a6-5e5b-4c5e-aaa0-767ab69c742a', 'multiverseId': 185336}, 'multiverseid': 185336}, {'name': 'Gigante Viaggiatore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '525bf5c9-9be7-4ba7-9007-629166696e6c'}, 'multiverseid': None}, {'name': '旅する巨人', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '895998a8-cdc7-4644-bbd6-f51e1fa596ed'}, 'multiverseid': None}, {'name': 'Gigante Viajante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db791862-830c-49c3-8397-b7394a7b9647'}, 'multiverseid': None}]", '[{\'name\': \'Hervorzerren\', \'text\': \'Opfere eine Kreatur oder ein Land.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich würde der Welt die Haut abziehen, um zu sehen, was darunter ist, aber ich würde sie nie diesen phyrexianischen Parasiten und ihrem falschen Gott überlassen." —Urborghexe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11df26e9-b67a-4910-982a-32f3da5b65d5\', \'multiverseId\': 183521}, \'multiverseid\': 183521}, {\'name\': \'Dragar\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e704283-88ea-4caf-9425-ff15e8468149\'}, \'multiverseid\': None}, {\'name\': \'Dragage\', \'text\': \'Sacrifiez une créature ou un terrain.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "« Je donnerai tout ce qui est sur ce monde pour voir ce qui gît dessous, mais jamais je ne laisserai cela à ces parasites phyrexians et à leur faux dieu. » — Une sorcière d\'Urborg.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185395&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'530ae577-da29-41b6-aa60-aa346493824c\', \'multiverseId\': 185395}, \'multiverseid\': 185395}, {\'name\': \'Drenare\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65e014fa-470b-4b0a-9f23-52979c1f034f\'}, \'multiverseid\': None}, {\'name\': \'底ざらい\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca96001b-f97b-4e58-821e-41c7441b9c6f\'}, \'multiverseid\': None}, {\'name\': \'Dragar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0289d083-9593-4c30-9646-036662ed1e23\'}, \'multiverseid\': None}]', '[{\'name\': \'Hypnotische Wolke\', \'text\': \'Bonus {4} (Du kannst zusätzlich {4} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nEin Spieler Deiner Wahl wirft eine Karte von seiner Hand ab. Wenn Du die Bonuskosten bezahlt hast, wirft er stattdessen drei Karten von seiner Hand ab.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183527&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b5edc9c-a3eb-4c03-932f-a15696b45ef6\', \'multiverseId\': 183527}, \'multiverseid\': 183527}, {\'name\': \'Nube Hipnótica\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc0014eb-efca-4f62-809d-d289950b027b\'}, \'multiverseid\': None}, {\'name\': \'Nuage hypnotique\', \'text\': "Kick {4} (Vous pouvez payer {4} supplémentaires quand vous jouez ce sort.)\\nLe joueur ciblé se défausse d\'une carte de sa main. Si vous avez payé le coût de kick, ce joueur se défausse de trois cartes de sa main à la place.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185401&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbe71c8a-eb21-412e-b3de-00899d0f6223\', \'multiverseId\': 185401}, \'multiverseid\': 185401}, {\'name\': \'Nube Ipnotica\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44851896-9c65-4aff-b668-c902f8e0a3fa\'}, \'multiverseid\': None}, {\'name\': \'惑乱の雲\