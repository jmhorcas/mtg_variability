7e-1705ffcf3854\', \'multiverseId\': 185363}, \'multiverseid\': 185363}, {\'name\': \'Sanguisuga di Zaffiro\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7bd4ab87-fef9-4cce-81e4-5fc02fb236f6\'}, \'multiverseid\': None}, {\'name\': \'サファイアのヒル\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0611b920-f0de-4c0c-ae6f-d0e9936aae07\'}, \'multiverseid\': None}, {\'name\': \'Sanguessuga de Safira\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'34de148a-e4ef-4910-9a99-9d8a6aa3a7bf\'}, \'multiverseid\': None}]', '[{\'name\': \'Saprolingbefall\', \'text\': \'Immer wenn ein Spieler Bonuskosten bezahlt, bringe einen 1/1 grünen Saproling-Spielstein ins Spiel.\', \'type\': \'Verzauberung\', \'flavor\': \'„Ich brauchte Jahrhunderte, um meine Armee auszuheben," bemerkte Urza. "Yavimaya scheint ihre einfach aus dem Nichts zu schöpfen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183626&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1eb04e32-9709-4a41-9009-dd92bef5667b\', \'multiverseId\': 183626}, \'multiverseid\': 183626}, {\'name\': \'Infestación de Saprolines\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c8b11e45-b8d8-433a-a79c-1ed5c8d3ca2e\'}, \'multiverseid\': None}, {\'name\': \'Infestation de saprobiontes\', \'text\': "À chaque fois qu\'un joueur paye un coût de kick, vous mettez en jeu un jeton de créature 1/1 verte Saprobionte.", \'type\': \'Enchantement\', \'flavor\': "« Il m\'a fallu des siècles pour constituer une armée », remarqua Urza. « Et la Yavimaya semble les conjurer de l\'air du temps. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185500&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'248ee002-2e5c-4fe5-a441-d1fd7a299541\', \'multiverseId\': 185500}, \'multiverseid\': 185500}, {\'name\': \'Infestazione di Saprolingi\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'029bd1d3-f336-41be-bfb0-5d5bc52d06a2\'}, \'multiverseid\': None}, {\'name\': \'菌獣の横行\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'032fe173-e568-4079-9287-1622d78a17b8\'}, \'multiverseid\': None}, {\'name\': \'Infestação Saprófita\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'04353e5b-101f-418e-9878-a07c9bd5d96d\'}, \'multiverseid\': None}]', "[{'name': 'Saprolingsymbiose', 'text': 'Du kannst die Saprolingsymbiose immer dann spielen, wenn Du auch einen Spontanzauber spielen könntest, wenn Du zusätzlich {2} bezahlst.\\nBringe pro Kreatur, die Du kontrollierst, einen 1/1 grünen Saproling-Spielstein ins Spiel.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183627&type=card', 'language': 'German', 'identifiers': {'scryfallId': '287d6955-d7ab-4d2d-a2ef-f178ee470764', 'multiverseId': 183627}, 'multiverseid': 183627}, {'name': 'Simbiosis de Saprolines', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd345506a-ee2d-4ce0-a40b-4f80fc4882c8'}, 'multiverseid': None}, {'name': 'Symbiose saprobionte', 'text': 'Vous pouvez jouer la Symbiose saprobionte à tout moment où vous pourriez jouer un éphémère si vous payez {2} de plus pour cela.\\nMettez en jeu un jeton de créature 1/1 verte Saprobionte pour chaque créature que vous contrôlez.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185501&type=card', 'language': 'French', 'identifiers': {'scryfallId': '743effd2-bed3-40f7-b580-c87eb6920444', 'multiverseId': 185501}, 'multiverseid': 185501}, {'name': 'Simbiosi dei Saprolingi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '3a2636c8-b45e-4eac-b9ae-4b316c80070a'}, 'multiverseid': None}, {'name': '菌獣の共生', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ee522852-9d0c-4f1b-8119-fd88d7c49766'}, 'multiverseid': None}, {'name': 'Simbiose Saprófita', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c2c85281-5863-48ea-a999-d63fd88dee18'}, 'multiverseid': None}]", '[{\'name\': \'Schild der Engel\', \'text\': \'Alle Kreaturen, die Du kontrollierst, erhalten +0/+1.\\nOpfere den Schild der Engel: Bringe eine Kreatur Deiner Wahl auf die Hand ihres Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': \'„Wenn wir nur alle durch Engelsflügel geschützt würden." —Barrin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183646&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5f21c7d-f585-494f-9a68-4df1df508dfe\', \'multiverseId\': 183646}, \'multiverseid\': 183646}, {\'name\': \'Escudo Angélico\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e1dbf28-8cd0-4a9c-98e9-08357580478c\'}, \'multiverseid\': None}, {\'name\': \'Bouclier angélique\', \'text\': \'Les créatures que vous contrôlez gagnent +0/+1.\\nSacrifiez le Bouclier angélique : Renvoyez la créature ciblée dans la main de son propriétaire.\', \'type\': \'Enchantement\', \'flavor\': "« Puissions-nous tous nous abriter sous les larges ailes d\'un ange. » — Barrin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20ab9dcc-9e76-47eb-8404-ef014913ec95\', \'multiverseId\': 185520}, \'multiverseid\': 185520}, {\'name\': \'Scudo Angelico\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'07bfff29-8939-4c2b-a98b-54c90d09d067\'}, \'multiverseid\': None}, {\'name\': \'天使の盾\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9ef5ab1-7136-4ca7-9533-f16a65e7a322\'}, \'multiverseid\': None}, {\'name\': \'Escudo Angelical\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6444ad58-a519-464f-9217-89cde2f35167\'}, \'multiverseid\': None}]', '[{\'name\': \'Schimmernde Flügel\', \'text\': \'Die verzauberte Kreatur erhält Flugfähigkeit.\\n{U}: Bringe die Schimmernden Flügel auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Flügel sind auch nur Luftflossen." —Kaiserin Galina\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183490&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'086d81b5-4b43-4bb7-951a-e1fe887c0694\', \'multiverseId\': 183490}, \'multiverseid\': 183490}, {\'name\': \'Alas Relucientes\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5300556-9e51-436c-8550-d49466cdee09\'}, \'multiverseid\': None}, {\'name\': \'Ailes chatoyantes\', \'text\': \'La créature enchantée a le vol.\\n{U}: Renvoyez ces Ailes chatoyantes dans la main de leur propriétaire.\', \'type\': \'Enchanter : créature\', \'flavor\': "« Les ailes sont des ailerons pour nager dans le ciel. » — L\'impératrice Galiva.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185364&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc711fe1-8450-42f6-9ab1-68cefe94029c\', \'multiverseId\': 185364}, \'multiverseid\': 185364}, {\'name\': \'Ali Evanescenti\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5e2c02b5-eaf3-4ca7-a5df-00da25d571bb\'}, \'multiverseid\': None}, {\'name\': \'ゆらめく翼\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d3cb9e34-2611-4a7e-aece-fbbfb0d888aa\'}, \'multiverseid\': None}, {\'name\': \'Asas Tremeluzentes\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51242b1e-0a3a-40f4-a919-31a0930f208a\'}, \'multiverseid\': None}]', '[{\'name\': \'Schleimiger Kavu\', \'text\': \'{T}: Ein Land Deiner Wahl wird bis zum Ende des Zuges zu einem Sumpf.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'Sein Schleim löst den Boden genauso effizient auf, wie seine Klauen seine Beute zerfleischen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183588&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4663fd7e-6462-4380-b4a5-b5dfd9d7b87c\', \'multiverseId\': 183588}, \'multiverseid\': 183588}, {\'name\': \'Kavu Baboso\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'204ec919-314e-4458-ac25-c74ce361043e\'}, \'multiverseid\': None}, {\'name\': \'Kavru baveur\', \'text\': "{T}: Le terrain ciblé devient un marais jusqu\'à la fin du tour.", \'type\': \'Créature : kavru\', \'flavor\': \'Sa bave liquéfie le sol comme ses crocs déchirent les proies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185462&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05dfd201-e9db-4628-80b8-ef3e76df7e93\', \'multiverseId\': 185462}, \'multiverseid\': 185462}, {\'name\': \'Kavu Bavoso\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa118b3c-e11c-4734-8658-dfc635176cac\'}, \'multiverseid\': None}, {\'name\': \'べたつきカヴー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d276e8d-9ea3-4223-986f-1d2fe9c47d17\'}, \'multiverseid\': None}, {\'name\': \'Kavu Viscoso\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5a754059-410f-482f-b44f-5e60cefdcfb1\'}, \'multiverseid\': None}]', '[{\'name\': \'Schlingseide\', \'text\': \'Die verzauberte Kreatur kann blocken, als ob sie Flugfähigkeit hätte.\\n{G}: Bringe die Schlingseide auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'Llanowar schmiedet Waffen aus Stahl. Yavimaya läßt seine in sich selber wachsen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183643&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f969c4b4-a3af-4dbc-8031-990c7ce2095c\', \'multiverseId\': 183643}, \'multiverseid\': 183643}, {\'name\': \'Látigo de Seda\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72e88744-13e0-407c-884e-66520056e716\'}, \'multiverseid\': None}, {\'name\': \'Fouet de soie\', \'text\': \'La créature enchantée peut bloquer comme si elle avait le vol.\\n{G}: Renvoyez le Fouet de soie dans la main de son propriétaire.\', \'type\': \'Enchanter : créature\', \'flavor\': "Llanowar forge des armes d\'acier. La Yavimaya fait pousser les siennes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df1cfd61-a109-4df2-b21c-7fd7e59b38b9\', \'multiverseId\': 185517}, \'multiverseid\': 185517}, {\'name\': \'Frusta di Seta\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ded1491b-325d-4115-90be-775be59035d5\'}, \'multiverseid\': None}, {\'name\': \'ムチ絹\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1816b3ab-1b57-4a4e-ba10-8a3d28d8471d\'}, \'multiverseid\': None}, {\'name\': \'Seda de Chicote\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ebcff0f8-a72b-49be-b20e-fadec9a9d4e8\'}, \'multiverseid\': None}]', "[{'name': 'Schlängelnde Schlange', 'text': 'Waldtarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler einen Wald kontrolliert.)', 'type': 'Kreatur — Schlange', 'flavor': 'Sie windet sich ebenso leicht durchs Unterholz, wie sie durch Tümpel schwimmt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183692&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f09cc134-cc11-4d51-be8f-07263acc453d', 'multiverseId': 183692}, 'multiverseid': 183692}, {'name': 'Serpiente Furtiva', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '63ad2be4-49e7-48e8-ba89-8601bc4d9019'}, 'multiverseid': None}, {'name': 'Grand serpent sinueux', 'text': 'Traversée des forêts (Cette créature est imblocable tant que le joueur défenseur contrôle au moins une forêt.)', 'type': 'Créature : serpent', 'flavor': 'Elle trace son chemin aussi bien que sous le sol.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185566&type=card', 'language': 'French', 'identifiers': {'scryfallId': '971fa35a-8a59-4a34-8ac9-70b994935e07', 'multiverseId': 185566}, 'multiverseid': 185566}, {'name': 'Serpente Furtivo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '03df885f-a87c-4ae2-a26e-8135d38f9636'}, 'multiverseid': None}, {'name': 'しなやかな海蛇', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '45985512-a675-4280-9970-106fbe59dff7'}, 'multiverseid': None}, {'name': 'Serpente EsguiaEsquiva', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '08655378-a3ab-403b-88c5-ab9bd0ef7170'}, 'multiverseid': None}]", '[{\'name\': \'Schmerzvolles Ableben\', \'text\': \'Bonus {1}{R} (Du kannst zusätzlich {1}{R} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nZerstöre eine nichtschwarze Kreatur Deiner Wahl. Sie kann nicht regeneriert werden. Wenn Du die Bonuskosten bezahlt hast, fügt das Schmerzvolle Ableben dem Beherrscher der Kreatur Schaden in Höhe der Stärke der Kreatur zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183510&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81f154a2-15a8-4f09-9d21-692b74fcc508\', \'multiverseId\': 183510}, \'multiverseid\': 183510}, {\'name\': \'Fallecimiento Agónico\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7641bced-2c6a-406d-b215-bdedb6efe708\'}, \'multiverseid\': None}, {\'name\': \'Agonie terminale\', \'text\': "Kick {1}{R} (Vous pouvez payer {1}{R} supplémentaires quand vous jouez ce sort.)\\nDétruisez la créature non-noire ciblée. Elle ne peut pas être régénérée. Si vous avez payé le coût de kick, l\'Agonie terminale inflige au contrôleur de la créature un nombre de blessures égal à la force de la créature.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185384&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d1a147c-03b4-4e06-be62-c7213c2634df\', \'multiverseId\': 185384}, \'multiverseid\': 185384}, {\'name\': \'Dipartita Straziante\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce037e70-df3c-407d-bf4e-22654da32c5b\'}, \'multiverseid\': None}, {\'name\': \'苦悶の死\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2de2e4f7-73b2-43f0-882f-42ac89bfe836\'}, \'multiverseid\': None}, {\'name\': \'Morte Agonizante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b75c510a-1ebf-47b9-bb26-06202ea09091\'}, \'multiverseid\': None}]', "[{'name': 'Schwefelkrater', 'text': 'Der Schwefelkrater kommt getappt ins Spiel.{T}: Erhöhe Deinen Manavorrat um {B}.\\n{T}, opfere den Schwefelkrater: Erhöhe Deinen Manavorrat um {U}{R}.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183751&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0e9870a3-d174-4980-840f-a7744f9d2847', 'multiverseId': 183751}, 'multiverseid': 183751}, {'name': 'Respiradero de Azufre', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '61bbb44f-9542-4490-a48c-2aa3e9e163a3'}, 'multiverseid': None}, {'name': 'Geyser de soufre', 'text': 'Le Geyser de soufre arrive en jeu engagé.\\n{T} : Ajoutez {B} à votre réserve.\\n{T}, sacrifiez le Geyser de soufre : Ajoutez {U}{R} à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185625&type=card', 'language': 'French', 'identifiers': {'scryfallId': '62893f77-9ccf-47f6-8aee-a08d8a1faab7', 'multiverseId': 185625}, 'multiverseid': 185625}, {'name': 'Condotto Sulfureo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e413a5bb-ebed-46f2-a3c0-2a01ab29cd79'}, 'multiverseid': None}, {'name': '硫黄孔', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '47d4ff46-1d08-4d46-a912-16f7d5aa9c1d'}, 'multiverseid': None}, {'name': 'Abertura Sulfúrica', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a33f317c-ffab-4bba-8c12-89755d2147ae'}, 'multiverseid': None}]", '[{\'name\': \'Schützende Sphäre\', \'text\': \'{1}, bezahle 1 Lebenspunkt: Verhindere allen Schaden, der Dir in diesem Zug von einer Quelle zugefügt wird, die die selbe Farbe hat wie das Mana, das Du für die Aktivierungskosten ausgegeben hast. (Farbloses Mana verhindert keinen Schaden.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183444&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6470b924-4fd2-40fa-828e-0803ff59f871\', \'multiverseId\': 183444}, \'multiverseid\': 183444}, {\'name\': \'Esfera Protectora\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d7a4e795-8c7c-4095-8e08-3f25f4a38b6a\'}, \'multiverseid\': None}, {\'name\': \'Sphère de protection\', \'text\': "{1}, payez 1 point de vie : Prévenez, ce tour-ci, toutes les blessures qui devraient vous être infligées par une source de votre choix qui partage au moins une couleur avec le mana dépensé dans ce coût d\'activation. (Le mana incolore ne prévient aucune blessure.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185318&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e03cd623-0431-4e5b-8e54-a1c65edc044b\', \'multiverseId\': 185318}, \'multiverseid\': 185318}, {\'name\': \'Sfera Protettiva\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e4b7b6c-b2e6-4f10-ad4f-a99b9fd736f7\'}, \'multiverseid\': None}, {\'name\': \'防護の宝球\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5b17d902-a473-4ebb-afdb-a5e4712d42a3\'}, \'multiverseid\': None}, {\'name\': \'Esfera de Proteção\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cce30af5-5cde-47e6-8565-09f58468deb6\'}, \'multiverseid\': None}]', '[{\'name\': \'Seelenfeuer\', \'text\': \'Du kannst für das X nur schwarzes und rotes Mana ausgeben.\\nSeelenfeuer fügt einer Kreatur oder einem Spieler Deiner Wahl X Schadenspunkte zu. Du erhältst Lebenspunkte in Höhe der zugefügten Schadenspunkte dazu, aber nicht mehr als die Anzahl an {B} in den X, als die Anzahl der Lebenspunkte des Spielers, bevor Seelenfeuer Schaden zugefügt hat, oder als die Widerstandskraft der Kreatur.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183542&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9095e4fe-298f-4933-a6eb-44d5120f71d2\', \'multiverseId\': 183542}, \'multiverseid\': 183542}, {\'name\': \'Consumir Alma\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0065481-54dc-4c0e-a9a1-cbb0b7ce0735\'}, \'multiverseid\': None}, {\'name\': \'Brûlure des âmes\', \'text\': "Ne dépensez dans X que du mana noir ou rouge.\\nLa Brûlure des âmes inflige X blessures à une cible, créature ou joueur. Vous gagnez un nombre de points de vie égal au plus au nombre de blessures infligées, mais ne pouvant être supérieur au nombre de {B} dépensés dans X, au total de points de vie du joueur avant les blessures infligées par la Brûlure des âmes, ou à l\'endurance de la créature.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185416&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8216aa3b-0d55-4c70-a8a5-1b0165b54607\', \'multiverseId\': 185416}, \'multiverseid\': 185416}, {\'name\': "Bruciare l\'Anima", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d1945cc-70f7-4cff-bca0-bb50891bba18\'}, \'multiverseid\': None}, {\'name\': \'霊魂焼却\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f6426f1-8c29-46ea-b1d6-c7ef7a0b06bc\'}, \'multiverseid\': None}, {\'name\': \'Queimadura da Alma\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a7b58ae-9fb6-4511-bd9d-65d5f5741141\'}, \'multiverseid\': None}]', "[{'name': 'Seelenruhe', 'text': 'Zerstöre alle Verzauberungen.', 'type': 'Hexerei', 'flavor': 'Die Seuche raubte Llanowar alles außer seinen Träumen. Eladamri hoffte, Träume würden reichen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183635&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a0edb4b9-cb05-4637-a972-b6da1c53fbfb', 'multiverseId': 183635}, 'multiverseid': 183635}, {'name': 'Tranquilidad', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '55e5d06b-9d3e-48fb-8c08-0e37bac30728'}, 'multiverseid': None}, {'name': 'Tranquillité', 'text': 'Détruisez tous les enchantements.', 'type': 'Rituel', 'flavor': 'Les pestes volèrent tout ce qui était cher à Dominaria, ne lui laissant que ses rêves. Éladämri espérait que les rêves suffiraient.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185509&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1e2a2f26-0992-47fd-8722-2638d6ada26a', 'multiverseId': 185509}, 'multiverseid': 185509}, {'name': 'Tranquillità', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '482db9a4-f0ab-4085-8fd7-421b59c2753a'}, 'multiverseid': None}, {'name': '平穏', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ea732051-01aa-4b5a-8b2b-b42e7996bbd0'}, 'multiverseid': None}, {'name': 'Tranqüilidade', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '70b3619d-9dac-45a8-b047-cee2b3829731'}, 'multiverseid': None}]", '[{\'name\': \'Seher der Gezeiten\', \'text\': \'{T}: Die Farbe einer Kreatur Deiner Wahl wird bis zum Ende des Zuges zu einer Farbe, die Du bestimmst.\', \'type\': \'Kreatur — Zauberer\', \'flavor\': \'Unter den Wellen erscheinen die Dinge so, wie das Meervolk es wünscht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183498&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9f3a09c-03b2-4c98-a353-b888d74cc952\', \'multiverseId\': 183498}, \'multiverseid\': 183498}, {\'name\': \'Vidente de la Marea\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'507b1bd8-f7a2-4d76-96fe-f116044e293a\'}, \'multiverseid\': None}, {\'name\': \'Visionnaire des marées\', \'text\': "{T}: La créature ciblée devient de la couleur de votre choix jusqu\'à la fin du tour.", \'type\': \'Créature : sorcier\', \'flavor\': \'Sous les flots, les choses paraissent telles que les ondins les désirent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185372&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1c379a0a-db9c-4af3-af10-61cdbbad351f\', \'multiverseId\': 185372}, \'multiverseid\': 185372}, {\'name\': \'Visionario della Marea\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2da6a802-a3ba-4281-9d6e-0a5fe03aa797\'}, \'multiverseid\': None}, {\'name\': \'高潮の幻想家\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4f80a263-540c-4196-ba56-921a31273357\'}, \'multiverseid\': None}, {\'name\': \'Vidente das Marés\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4499f316-211b-4e31-85fa-5f64a103f78d\'}, \'multiverseid\': None}]', "[{'name': 'Sengende Lava', 'text': 'Bonus {R} (Du kannst zusätzlich {R} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nSengende Lava fügt einer Kreatur oder einem Spieler Deiner Wahl 1 Schadenspunkt zu. Wenn Du die Bonuskosten bezahlt hast, kann diese Kreatur in diesem Zug nicht regeneriert werden, und wenn sie in diesem Zug auf den Friedhof gelegt würde, entferne sie stattdessen ganz aus dem Spiel.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183582&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1e7c5bbb-440e-46bf-a197-28a2cdfa4aa4', 'multiverseId': 183582}, 'multiverseid': 183582}, {'name': 'Lava Abrasadora', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1532e3a4-7c1c-4221-af39-0331c2ff731f'}, 'multiverseid': None}, {'name': 'Lave dévastatrice', 'text': 'Kick {R} (Vous pouvez payer {R} supplémentaires quand vous jouez ce sort.)\\nLa Lave dévastatrice inflige 2 blessures à une cible, créature ou joueur. Si vous avez payé le coût de kick, cette créature ne peut pas être régénérée ce tour-ci et si elle devait être mise dans un cimetière ce tour-ci, retirez-la de la partie à la place.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185456&type=card', 'language': 'French', 'identifiers': {'scryfallId': '294ca7be-9266-4c4b-915c-490e368643f7', 'multiverseId': 185456}, 'multiverseid': 185456}, {'name': 'Lava Ustionante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '428357a0-4029-40cb-a8ca-f39513b5490d'}, 'multiverseid': None}, {'name': '焦熱の溶岩', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b016f5df-1217-474d-8dc9-17eeb5aeda43'}, 'multiverseid': None}, {'name': 'Lava Escaldante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '83ee3c3c-096e-4183-982e-33a3e17ccb6e'}, 'multiverseid': None}]", "[{'name': 'Seuchenspeier', 'text': 'Zu Beginn Deines Versorgungssegments fügt der Seuchenspeier jeder Kreatur und jedem Spieler 1 Schadenspunkt zu.\\nWenn der Seuchenspeier aus dem Spiel auf den Friedhof geht, fügt er jeder Kreatur und jedem Spieler 1 Schadenspunkt zu.', 'type': 'Kreatur — Schrecken', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183537&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5f48a495-8c83-4072-a559-3236171613e3', 'multiverseId': 183537}, 'multiverseid': 183537}, {'name': 'Escupidor de peste', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'be515e1e-2e8d-4b3a-8a89-f0c759afbde4'}, 'multiverseid': None}, {'name': 'Cracheur de peste', 'text': 'Au début de votre entretien, le Cracheur de peste inflige 1 blessure à chaque créature et à chaque joueur.\\nQuand le Cracheur de peste est mis dans un cimetière depuis le jeu, le Cracheur de peste inflige 1 blessure à chaque créature et à chaque joueur.', 'type': 'Créature : horreur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185411&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0c0b810e-1952-4b51-bb3e-0c3f06f28fc2', 'multiverseId': 185411}, 'multiverseid': 185411}, {'name': 'Sputapeste', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'ccd77f7c-3d98-4e6a-9975-be9c28b73e54'}, 'multiverseid': None}, {'name': '疫病吐き', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9fe1b5ad-3289-476f-8002-f851570fb599'}, 'multiverseid': None}, {'name': 'Cuspidor de Pragas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9a1e087c-32a9-4ecc-9541-122600e2b46e'}, 'multiverseid': None}]", '[{\'name\': \'Seuchensporen\', \'text\': \'Zerstöre eine nichtschwarze Kreatur Deiner Wahl und ein Land Deiner Wahl. Diese können nicht regeneriert werden.\', \'type\': \'Hexerei\', \'flavor\': \'„Atme tief ein, Dominaria. Hole tief Luft und stirb." —Tsabo Tavoc, phyrexianischer General\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f8633fe5-2c10-4474-a1b5-382e43ca1da9\', \'multiverseId\': 183678}, \'multiverseid\': 183678}, {\'name\': \'Esporas de Peste\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b5337264-88c8-46f2-8db6-44788bbb3179\'}, \'multiverseid\': None}, {\'name\': \'Spores pesteuses\', \'text\': \'Détruisez la créature non-noire ciblée et le terrain ciblé. Ils ne peuvent pas être régénérés.\', \'type\': \'Rituel\', \'flavor\': \'« Respire profondément, Dominaria. Respire profondément et meurt. » — Tsabo Tavoc, générale des Phyrexians.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185552&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d58e27a-2518-4c55-955f-cd30e6ae8ce7\', \'multiverseId\': 185552}, \'multiverseid\': 185552}, {\'name\': \'Spore Pestilenziali\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7c53f74b-1f90-457e-ab67-e3ae54afb269\'}, \'multiverseid\': None}, {\'name\': \'疫病の胞子\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1188de8-38b2-4091-9233-e549abadb5a4\'}, \'multiverseid\': None}, {\'name\': \'Esporos da Praga\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f906ac2-db63-404d-8164-7375595d4ddf\'}, \'multiverseid\': None}]', '[{\'name\': \'Shiv-Oase\', \'text\': \'Die Shiv-Oase kommt getappt ins Spiel.\\n{T}: Erhöhe Deinen Manavorrat um {R} oder {G}.\', \'type\': \'Land\', \'flavor\': \'Nur die tüchtigsten Erforscher überlebten und konnten ihre Früchte genießen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183750&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5575659d-39ab-456d-b8e0-fbf9c337d235\', \'multiverseId\': 183750}, \'multiverseid\': 183750}, {\'name\': \'Oasis Shivano\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d51533d-27f4-4653-a0f0-02cc90b140e1\'}, \'multiverseid\': None}, {\'name\': \'Oasis shivâne\', \'text\': "L\'Oasis shivâne arrive en jeu engagée.\\n{T}: Ajoutez {R} ou {G} à votre réserve.", \'type\': \'Terrain\', \'flavor\': \'Seuls les plus hardis des explorateurs ont survécu assez longtemps pour en goûter les fruits.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185624&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bea8e1b-dd2a-4a5b-80b2-b1de9224fe8d\', \'multiverseId\': 185624}, \'multiverseid\': 185624}, {\'name\': \'Oasi di Shiv\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70808c2b-f90c-435c-b3dc-200804f0da0b\'}, \'multiverseid\': None}, {\'name\': \'シヴのオアシス\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94225623-60e7-4b37-8734-1fa6b6c4b35b\'}, \'multiverseid\': None}, {\'name\': \'Oásis de Shiv\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0623f084-c9f8-4372-98d9-d6987b5bd491\'}, \'multiverseid\': None}]', '[{\'name\': \'Shivanische Ernte\', \'text\': \'{1}{R}, opfere eine Kreatur: Zerstöre ein Nicht-Standardland Deiner Wahl.\', \'type\': \'Verzauberung\', \'flavor\': \'„Das Blut eurer Ahnen floß schwer über diesen Boden. Jetzt seid ihr dran, euch für den Ruhm Shivs zu opfern." —Viashino-Ketzer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183585&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'01d2db85-8bb9-405c-98c2-e84e006f15b6\', \'multiverseId\': 183585}, \'multiverseid\': 183585}, {\'name\': \'Cosecha Shivana\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4bf6229c-0438-4a04-9f48-fb1451ba4171\'}, \'multiverseid\': None}, {\'name\': \'Récolte shivâne\', \'text\': \'{1}{R}, sacrifiez une créature : Détruisez le terrain non-base ciblé.\', \'type\': \'Enchantement\', \'flavor\': "« Le sang de vos ancêtres a abreuvé les sillons de Shiv. Maintenant c\'est votre tour de vous sacrifier pour la gloire de Shiv. » — Un hérétique viashino.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185459&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f15f7e57-b3a9-4d71-98b5-53e349984d19\', \'multiverseId\': 185459}, \'multiverseid\': 185459}, {\'name\': \'Raccolto di Shiv\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3e1cf122-f20f-4077-ab80-3b88411a40e1\'}, \'multiverseid\': None}, {\'name\': \'シヴの収穫\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'44acfdcd-6f0b-49ce-925f-9a11f634fa7c\'}, \'multiverseid\': None}, {\'name\': \'Colheita de Shiv\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'914a5580-eea4-401f-8f92-2015beccc7dc\'}, \'multiverseid\': None}]', '[{\'name\': \'Shivanischer Gesandter\', \'text\': \'Bonus {1}{B} (Du kannst zusätzlich {1}{B} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nWenn der Shivanische Gesandte ins Spiel kommt und Du die Bonuskosten bezahlt hast, zerstöre eine nichtschwarze Kreatur Deiner Wahl. Diese kann nicht regeneriert werden.\', \'type\': \'Kreatur — Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183584&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6af80141-f597-476a-921b-2d59cd45658f\', \'multiverseId\': 183584}, \'multiverseid\': 183584}, {\'name\': \'Emisario Shivano\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'928bbaa7-4fb8-42d6-ad55-ba199c4ac9e8\'}, \'multiverseid\': None}, {\'name\': \'Émissaire de Shiv\', \'text\': "Kick {1}{B} (Vous pouvez payer {1}{B} supplémentaires quand vous jouez ce sort.)\\nQuand l\'Émissaire de Shiv arrive en jeu, si vous avez payé le coût de kick, détruisez la créature non-noire ciblée. Elle ne peut pas être régénérée.", \'type\': \'Créature : sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185458&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba5aa824-5114-4b69-ad46-bd2c4204b1d3\', \'multiverseId\': 185458}, \'multiverseid\': 185458}, {\'name\': \'Emissario di Shiv\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5bb96d7e-0a88-44b8-bb98-cb5939ac14ed\'}, \'multiverseid\': None}, {\'name\': \'シヴの使者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c786c970-7a85-4c57-a25d-c70b4d91c71f\'}, \'multiverseid\': None}, {\'name\': \'Emissário de Shiv\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7eb3853b-2833-4d49-a076-c3ef5bef4aa8\'}, \'multiverseid\': None}]', '[{\'name\': \'Shivanischer Zombie\', \'text\': \'Schutz vor Weiß\', \'type\': \'Kreatur — Barbar, Zombie\', \'flavor\': \'Barbaren sehnen sich nach dem glorreichen Tod in der Schlacht. Die Phyrexianer waren da sehr entgegenkommend.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183689&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'192a22e9-cdbf-43ec-adf0-00076499fe30\', \'multiverseId\': 183689}, \'multiverseid\': 183689}, {\'name\': \'Zombie Shivano\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69187fd7-2eff-4268-8d5e-f3c8429c3f68\'}, \'multiverseid\': None}, {\'name\': \'Zombie Shivân\', \'text\': \'Protection contre le blanc\', \'type\': \'Créature : barbare et zombie\', \'flavor\': "Les barbares cherchent une mort glorieuse au combat. Phyrexia est heureuse d\'exaucer leurs voeux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185563&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'745630ce-dca7-4609-a9fe-a3ae6af6c1a0\', \'multiverseId\': 185563}, \'multiverseid\': 185563}, {\'name\': \'Zombie di Shiv\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'95d162ec-58c5-4796-a0ac-b8d255015277\'}, \'multiverseid\': None}, {\'name\': \'シヴのゾンビ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'700f6932-c8dd-42d8-8f57-642f5456444d\'}, \'multiverseid\': None}, {\'name\': \'Zumbi de Shiv\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b9d0d15-5c00-4c2f-8119-5b6ab9ddca52\'}, \'multiverseid\': None}]', '[{\'name\': \'Sifaka\', \'text\': \'Der Sifaka fügt jeder Kreatur, die ein Gegner Deiner Wahl kontrolliert, 1 Schadenspunkt zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der heiße Wind sprang auf, als wollte das Wetter selber die Phyrexianer bekämpfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1fa8b8e0-7d9e-483b-93e1-e96c9439778c\', \'multiverseId\': 183690}, \'multiverseid\': 183690}, {\'name\': \'Simun\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1c145a8-0bd9-4396-b558-65d5a5bcb2c7\'}, \'multiverseid\': None}, {\'name\': \'Simoun\', \'text\': "Le Simoun inflige 1 blessure à chaque créature que l\'adversaire ciblé contrôle.", \'type\': \'Éphémère\', \'flavor\': "Les vents chauds fouettaient l\'air comme s\'ils cherchaient aussi à combattre les Phyrexians.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185564&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'635b6de0-cc6a-4bce-982b-3a7fca9c5da0\', \'multiverseId\': 185564}, \'multiverseid\': 185564}, {\'name\': \'Simun\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f46d79e-dcc0-450e-9cfb-dbf7391a8f79\'}, \'multiverseid\': None}, {\'name\': \'サイムーン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'286607e2-587c-4c62-b78e-011cd3fb36b0\'}, \'multiverseid\': None}, {\'name\': \'Simum\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'711d3778-216d-4049-bfab-924d4816b249\'}, \'multiverseid\': None}]', '[{\'name\': \'Skizzik\', \'text\': \'Bonus {R} (Du kannst zusätzlich {R} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nVerursacht Trampelschaden; Eile (Diese Kreatur kann in dem Zug, in dem sie unter Deine Kontrolle kommt, angreifen und Fähigkeiten anwenden, bei denen sie getappt wird.)\\nOpfere Skizzik am Ende des Zuges, wenn Du die Bonuskosten nicht bezahlt hast.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183587&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa3d4858-585b-4f47-858b-a152f183c868\', \'multiverseId\': 183587}, \'multiverseid\': 183587}, {\'name\': \'Skizzik\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf8ee914-b0ec-4905-88d4-dbe836c6a985\'}, \'multiverseid\': None}, {\'name\': \'Skizzik\', \'text\': "Kick {R} (Vous pouvez payer {R} supplémentaires quand vous jouez ce sort.)\\nPiétinement, célérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)\\nÀ la fin du tour, sacrifiez le Skizzik à moins que le coût de kick n\'ait été payé.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185461&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'61624a9b-0944-499a-9261-a64fd0afca5c\', \'multiverseId\': 185461}, \'multiverseid\': 185461}, {\'name\': \'Skizzik\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b74b4671-18e8-40e1-b660-cceb9a14a165\'}, \'multiverseid\': None}, {\'name\': \'スキジック\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c5feb565-cc98-46a5-8141-794cdaaa8a70\'}, \'multiverseid\': None}, {\'name\': \'Skizzik\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'537cf5af-6f75-4145-a99e-0df9cf774a13\'}, \'multiverseid\': None}]', '[{\'name\': \'Skrupelloser Wahn\', \'text\': \'Zerstöre zwei nichtschwarze Kreaturen Deiner Wahl. Du verlierst 5 Lebenspunkte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Tod ist so ein exquisites Gefühl." —Tsabo Tavoc, phyrexianischer General\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183539&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7321714d-5396-4c3d-beb2-35f17eb31f6a\', \'multiverseId\': 183539}, \'multiverseid\': 183539}, {\'name\': \'Rencor Imprudente\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4029830-c142-47c4-80ec-c3d95cebddaf\'}, \'multiverseid\': None}, {\'name\': \'Rancune téméraire\', \'text\': \'Détruisez deux créatures non-noires ciblées. Vous perdez 5 points de vie.\', \'type\': \'Éphémère\', \'flavor\': \'« La mort est une sensation si douce. » — Tsabo Tavoc, générale des Phyrexians.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185413&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c737f0f1-5d78-48bd-a919-de3e07061796\', \'multiverseId\': 185413}, \'multiverseid\': 185413}, {\'name\': \'Disprezzo Sconsiderato\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f93ac69-bd06-4806-a3c8-5cbc50410420\'}, \'multiverseid\': None}, {\'name\': \'無謀な悪意\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'33adf288-037a-4902-a2d9-22b4ad6e4ad5\'}, \'multiverseid\': None}, {\'name\': \'Rancor Imprudente\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3dfc813b-f484-4645-bc8f-e427c0df2776\'}, \'multiverseid\': None}]', "[{'name': 'Sonde', 'text': 'Bonus {1}{B} (Du kannst zusätzlich {1}{B} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nZiehe drei Karten und wirf dann zwei Karten von Deiner Hand ab.\\nWenn Du die Bonuskosten bezahlt hast, wirft ein Spieler Deiner Wahl zwei Karten von seiner Hand ab.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183484&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'af04f28b-85c0-4eaa-a282-748a083a741d', 'multiverseId': 183484}, 'multiverseid': 183484}, {'name': 'Sondear', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a71ee41b-4e1a-48af-bd35-6ede8a4092fa'}, 'multiverseid': None}, {'name': 'Sonde', 'text': 'Kick {1}{B} (Vous pouvez payer {1}{B} supplémentaires quand vous jouez ce sort.)\\nPiochez trois cartes, puis défaussez-vous de deux cartes de votre main.\\nSi vous avez payé le coût de kick, le joueur ciblé se défausse de deux cartes de sa main.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185358&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f7df5682-ffe7-42a0-986c-b8e2fc9c772a', 'multiverseId': 185358}, 'multiverseid': 185358}, {'name': 'Sondare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a5f42ee5-3405-4db0-823e-ca47b70bd638'}, 'multiverseid': None}, {'name': '調査', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '366c321d-f052-4824-8c10-9302dd5c2f51'}, 'multiverseid': None}, {'name': 'Sondar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2a3bd339-68a0-4aec-b115-793d80996c5e'}, 'multiverseid': None}]", '[{\'name\': \'Sparrings-Golem\', \'text\': \'Immer wenn der Sparrings-Golem geblockt wird, erhält er bis zum Ende des Zuges +1/+1 für jede Kreatur, die ihn blockt.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'„Teils Rekrutenausbilder, teils Prügelknecht," dachte Gerrard. „Ich hoffe, er hält einem echten Gefecht stand."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'96c07185-b36d-4755-8b35-be10f4743fe7\', \'multiverseId\': 183735}, \'multiverseid\': 183735}, {\'name\': \'Gólem Entrenamiento\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e9718321-a289-4343-b1ad-2e939e988750\'}, \'multiverseid\': None}, {\'name\': "Golem d\'entraînement", \'text\': "À chaque fois que Golem d\'entraînement devient bloqué, il gagne +1/+1 jusqu\'à la fin du tour pour chaque créature qui l\'a bloqué.", \'type\': \'Créature-artefact : golem\', \'flavor\': "« Il n\'est pas mauvais pour s\'entraîner », pensait Gerrard. « Mais tiendra-t-il face à une vraie guerre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185609&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'829efae1-ff41-479f-9213-c437cae4b0ae\', \'multiverseId\': 185609}, \'multiverseid\': 185609}, {\'name\': \'Golem Assemblato\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'334ee7f0-395c-44b4-9e55-f53617167aa6\'}, \'multiverseid\': None}, {\'name\': \'演習用ゴーレム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4598b96d-9b0b-4b07-8752-04cafcaa17a9\'}, \'multiverseid\': None}, {\'name\': \'Golem Treinador\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3513c1f7-600d-4859-9405-44740ddc941b\'}, \'multiverseid\': None}]', "[{'name': 'Springender Kavu', 'text': 'Bonus {2}{R} (Du kannst zusätzlich {2}{R} bezahlen, wenn Du diesen Zauberspruch spielst.)Erstschlag\\nWenn Du die Bonuskosten bezahlt hast, kommt der Springende Kavu mit zwei +1/+1-Marken ins Spiel und hat Eile. (Er kann in dem Zug, in dem er unter Deine Kontrolle kommt, angreifen und Fähigkeiten anwenden, bei denen er getappt wird.)', 'type': 'Kreatur — Kavu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183576&type=card', 'language': 'German', 'identifiers': {'scryfallId': '44c6e137-33c3-465c-bf9f-365b20d52582', 'multiverseId': 183576}, 'multiverseid': 183576}, {'name': 'Kavu Saltador', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'cd2e1905-4def-41f1-ad56-fe7b8791fa14'}, 'multiverseid': None}, {'name': 'Kavru bondissant', 'text': 'Kick {2}{R} (Vous pouvez payer {2}{R} supplémentaires quand vous jouez ce sort.)\\nInitiative\\nSi vous avez payé le coût de kick, le Kavru bondissant arrive en jeu avec deux marqueurs +1/+1 sur lui et a la célérité. (Il peut attaquer et {T} dès le tour où il arrive sous votre contrôle.)', 'type': 'Créature : kavru', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185450&type=card', 'language': 'French', 'identifiers': {'scryfallId': '83d4c221-ab18-4d7e-b77d-9294f9495d50', 'multiverseId': 185450}, 'multiverseid': 185450}, {'name': 'Kavu Balzante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '3b5d4ffe-615c-4898-be24-f0024cb08108'}, 'multiverseid': None}, {'name': '飛びかかるカヴー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '20cd1d39-a436-4f43-add2-5bf1709244f3'}, 'multiverseid': None}, {'name': 'Kavu Rabaz', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '211092e2-8e1f-4bf9-bc8a-1b46f34144d9'}, 'multiverseid': None}]", '[{\'name\': \'Springflutkrabbe\', \'text\': \'Die Springflutkrabbe wird beim Angreifen nicht getappt.\\nZiehe eine Karte, wenn die Springflutkrabbe aus dem Spiel auf den Friedhof geht.\', \'type\': \'Kreatur — Krabbe\', \'flavor\': \'Sie schläft mit offenen Scheren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183684&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'46bc84ff-8313-4989-a849-378584893432\', \'multiverseId\': 183684}, \'multiverseid\': 183684}, {\'name\': \'Cangrejo de Resaca\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93bace84-77e5-4a81-8a9b-3fa718eba78d\'}, \'multiverseid\': None}, {\'name\': \'Crabe du reflux\', \'text\': "Attaquer avec le Crabe du reflux ne le fait pas s\'engager.\\nQuand le Crabe du reflux est mis dans un cimetière depuis le jeu, piochez une carte.", \'type\': \'Créature : crabe\', \'flavor\': \'Il dort les pinces ouvertes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185558&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aef8dde7-9896-4202-ae9e-147ea4ecbb07\', \'multiverseId\': 185558}, \'multiverseid\': 185558}, {\'name\': \'Granchio della Marea\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7977615-7908-4195-b132-a1e521b6f119\'}, \'multiverseid\': None}, {\'name\': \'激浪のカニ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d360fe3d-64ee-4639-a470-f0a56a83779b\'}, \'multiverseid\': None}, {\'name\': \'Caranguejo de Rebentação\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab83e289-b5a1-4cfc-bb40-92bfb3bf6157\'}, \'multiverseid\': None}]', '[{\'name\': \'Stammesflammen\', \'text\': \'Die Stammesflammen fügen einer Kreatur oder einem Spieler Deiner Wahl X Schadenspunkte zu, wobei X gleich der Anzahl an verschiedenen Standardlandtypen unter den Ländern, die Du kontrollierst, ist.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Sprache des Feuers versteht jeder." —Jhoira, Meisterbastler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183594&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'02c7fe98-38a2-48f7-b29a-d24a8b3b2896\', \'multiverseId\': 183594}, \'multiverseid\': 183594}, {\'name\': \'Flamas Tribales\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83ed51f9-43f2-4e95-b031-f0bb01f084a7\'}, \'multiverseid\': None}, {\'name\': \'Flammes tribales\', \'text\': \'Ces Flammes tribales infligent X blessures à une cible, créature ou joueur, X étant le nombre de types de terrains de base parmi les terrains que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': \'« Le feu est le langage du monde. » — Djoïra, maîtresse artificière.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185468&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36bedd86-7274-4c16-88cd-c2b628dbe7ac\', \'multiverseId\': 185468}, \'multiverseid\': 185468}, {\'name\': \'Fiamme Tribali\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e6244c9d-4c72-4dc2-9747-817a8a1e40e2\'}, \'multiverseid\': None}, {\'name\': \'部族の炎\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7de2cfa4-6adf-42f8-bb4a-3b644b96e710\'}, \'multiverseid\': None}, {\'name\': \'Chamas Tribais\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'694aa598-98a2-46b4-965b-f6b157909ce4\'}, \'multiverseid\': None}]', "[{'name': 'Stehen oder Fallen', 'text': 'Teile zu Beginn Deiner Kampfphase alle Kreaturen, die der verteidigende Spieler kontrolliert, auf zwei offene Stapel auf. Nur Kreaturen aus demjenigen Stapel, den dieser Spieler bestimmt, können in diesem Zug blocken.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183589&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6f8f0f80-5a24-47fb-82ec-41dbc9d324d9', 'multiverseId': 183589}, 'multiverseid': 183589}, {'name': 'Resistir o Rendirse', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd91257e9-9c2d-42c3-a4e8-7b3d99d84a15'}, 'multiverseid': None}, {'name': 'Tenir ou tomber', 'text': 'Au début de votre phase de combat, séparez toutes les créatures que le joueur défenseur contrôle en deux tas faces visibles. Seules les créatures dans le tas choisi par ce joueur pourront bloquer ce tour-ci.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185463&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c4ed5dcb-556b-4860-b719-412b182fee78', 'multiverseId': 185463}, 'multiverseid': 185463}, {'name': 'Resisti o Cadi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c4c5a921-d8af-47bc-a744-b6659d8310f9'}, 'multiverseid': None}, {'name': '立つか転ぶか', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2fcce546-b44c-4aee-b46e-9f7063331ffb'}, 'multiverseid': None}, {'name': 'Defender ou Cair', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '74c43662-4ef3-4cff-9e41-392c23ae13cd'}, 'multiverseid': None}]", '[{\'name\': \'Strandräuber\', \'text\': \'Schutz vor Kavu\', \'type\': \'Kreatur — Meervolk\', \'flavor\': \'„Dieses seltsame neue Wesen gibt eine hervorragende Mahlzeit ab. Besorgt mir noch eines" —Kaiserin Galina\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a1d95926-5842-4c9c-91fc-c60f8fb93741\', \'multiverseId\': 183491}, \'multiverseid\': 183491}, {\'name\': \'Jinete Costero\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'adb4c55d-4e90-43e0-8d63-5c0fdc4805b5\'}, \'multiverseid\': None}, {\'name\': \'Pillard des côtes\', \'text\': \'Protection contre les kavrus\', \'type\': \'Créature : ondin\', \'flavor\': "« Quelle saveur nouvelle et délicieuse. J\'en veux encore. » — L\'impératrice Galiva.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185365&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53686863-ec2e-4e65-93bb-381120735f01\', \'multiverseId\': 185365}, \'multiverseid\': 185365}, {\'name\': \'Predatori Costieri\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5d3ef5f4-6e14-4e2f-8785-106f5a0b29b5\'}, \'multiverseid\': None}, {\'name\': \'海辺の略奪者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90cdf99e-76cc-4b41-aa5a-a490f4d5db67\'}, \'multiverseid\': None}, {\'name\': \'Salteador da Costa\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37f570d8-f83c-46d9-9fb8-10753c2b6b07\'}, \'multiverseid\': None}]', '[{\'name\': \'Stärke durch Einheit\', \'text\': \'Die verzauberte Kreatur erhält +1/+1 für jeden Standardlandtyp unter den Ländern, die Du kontrollierst.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'Alle Bewohner Dominarias waren sich zumindest in einer Hinsicht einig: Sie würden nicht ohne einen Kampf untergehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183458&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c671e3f-b2d4-4cfa-8a5d-164c4703d5d4\', \'multiverseId\': 183458}, \'multiverseid\': 183458}, {\'name\': \'Fuerza de la Unidad\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44bc240e-50d1-4301-8e89-3a0e0b615cb1\'}, \'multiverseid\': None}, {\'name\': "Force de l\'unité", \'text\': \'La créature enchantée gagne +1/+1 pour chaque type de terrain de base parmi les terrains que vous contrôlez.\', \'type\': \'Enchanter : créature\', \'flavor\': "Ils se battraient jusqu\'au bout. Sur ce point, au moins, tous les Dominarians étaient d\'accord.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00c04268-8e0f-49df-8a85-96c4d06a2f6b\', \'multiverseId\': 185332}, \'multiverseid\': 185332}, {\'name\': "L\'Unione Fa la Forza", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b5e2bc4-6c12-4457-b815-3709534a07e4\'}, \'multiverseid\': None}, {\'name\': \'団結の力\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c34362b-0ecd-4610-bfc4-1b02c697ec55\'}, \'multiverseid\': None}, {\'name\': \'A União faz a Força\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71e8198b-84ab-481a-a194-c564f9a3e1ae\'}, \'multiverseid\': None}]', '[{\'name\': \'Störung\', \'text\': \'Neutralisiere einen Spontanzauber oder eine Hexerei Deiner Wahl, wenn deren Beherrscher nicht {1} bezahlt.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Teferi wollte nichts mit Urzas Schlachtplänen zu tun haben, aber sie waren sich einig, daß das phyrexianische Portal geschlossen werden müßte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183469&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82229463-bf0d-4cf5-b79d-4a8f28dc3099\', \'multiverseId\': 183469}, \'multiverseid\': 183469}, {\'name\': \'Disrupción\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf4791a9-2c31-4de9-9c5f-a43bed3a25df\'}, \'multiverseid\': None}, {\'name\': \'Perturbation\', \'text\': "Contrecarrez le sort d\'éphémère ou de rituel ciblé à moins que son contrôleur ne paye {1}.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "Téfeiri ne voulait pas prendre part au plan d\'Urza mais tout deux savaient que le portail de Phyrexia devait être refermé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185343&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e9aa2ec9-08de-4b81-b8f1-fd52d0cccdef\', \'multiverseId\': 185343}, \'multiverseid\': 185343}, {\'name\': \'Disturbo\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'55b11ab7-25dc-481a-8c45-bdbd693d04fe\'}, \'multiverseid\': None}, {\'name\': \'撹乱\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4fc3738b-ffe5-46af-9e76-d2b7ca0cb73f\'}, \'multiverseid\': None}, {\'name\': \'Romper\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9cd0e9ad-798a-4ec8-ae72-a4c17ff36f01\'}, \'multiverseid\': None}]', '[{\'name\': \'Stürmische Offensive\', \'text\': \'Bonus {G} (Du kannst zusätzlich {G} bezahlen, wenn Du diesen Zauberspruch spielst.)\\nKreaturen, die Du kontrollierst, erhalten Erstschlag bis zum Ende des Zuges. Wenn Du die Bonuskosten bezahlt hast, erhalten sie zusätzlich +1/+1 bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183580&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f72bf05d-dd80-4392-9eab-2d0f1ae18afe\', \'multiverseId\': 183580}, \'multiverseid\': 183580}, {\'name\': \'Ofensiva Salvaje\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f307542-f6d7-440e-ac81-35d967b0b91b\'}, \'multiverseid\': None}, {\'name\': \'Offensive sauvage\', \'text\': "Kick {G} (Vous pouvez payer {G} supplémentaires quand vous jouez ce sort.)\\nLes créatures que vous contrôlez acquièrent l\'initiative jusqu\'à la fin du tour. Si vous avez payé le coût de kick, elles gagnent +1/+1 jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185454&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb9159bf-6f04-48e8-af94-3207f2060aa5\', \'multiverseId\': 185454}, \'multiverseid\': 185454}, {\'name\': \'Attacco Selvaggio\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e434d52a-b037-4968-a34a-0a97f4f71010\'}, \'multiverseid\': None}, {\'name\': \'野蛮な攻勢\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5cd8200-ca4d-4cf3-b7ad-98b3101a2689\'}, \'multiverseid\': None}, {\'name\': \'Ofensiva Selvagem\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'05266ae3-2efe-4441-b90b-b5aa95a89ccb\'}, \'multiverseid\': None}]', '[{\'name\': \'Sulam-Dschinn\', \'text\': \'Verursacht Trampelschaden\\nDer Sulam-Dschinn erhält -2/-2, solange Grün die häufigste Farbe unter bleibenden Karten ist. Dies gilt auch bei Gleichstand.\', \'type\': \'Kreatur — Dschinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=183630&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1d8b8084-6b38-4d8f-a4b0-14238446ecba\', \'multiverseId\': 183630}, \'multiverseid\': 183630}, {\'name\': \'Djinn Sulam\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb3e4edd-3fc0-4173-8336-e22766c03fee\'}, \'multiverseid\': None}, {\'name\': \'Djinn sulâm\', \'text\': "Piétinement\\nLe Djinn sulâm gagne -2/-2 tant que le vert est la couleur la plus fréquente parmi tous les permanents (même en cas d\'égalité).", \'type\': \'Créature : djinn\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=185504&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af6c9a95-abbb-44ef-a4d1-772efba21c8b\', \'multiverseId\': 185504}, \'multiverseid\': 185504}, {\'name\': \'Genio Sulam\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'430d95cd-29fc-4b34-bfbe-4f7cbe1fe60c\'}, \'multive