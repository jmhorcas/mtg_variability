subtypes: ['Advisor', 'Angel', 'Ape', 'Aura', 'Avatar', 'Barbarian', 'Bard', 'Beast', 'Berserker', 'Bird', 'Cleric', 'Construct', 'Drone', 'Druid', 'Elemental', 'Elf', 'Gargoyle', 'Goblin', 'Homarid', 'Horror', 'Human', 'Illusion', 'Insect', 'Juggernaut', 'Knight', 'Mercenary', 'Merfolk', 'Phelddagrif', 'Phyrexian', 'Plant', 'Ranger', 'Rat', 'Rogue', 'Scout', 'Shaman', 'Skeleton', 'Soldier', 'Spirit', 'Starfish', 'Treefolk', 'Wall', 'Warrior', 'Wizard', 'Worm', 'Zombie']
