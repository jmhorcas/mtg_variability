zil)', 'identifiers': {'scryfallId': '764f0ec7-83bd-4df7-8879-e7a2b66976ae'}, 'multiverseid': None}]", "[{'name': 'Rasende Gorillas', 'text': 'Verursacht Trampelschaden\\nRaserei: 2\\nKönnen nicht von weniger als drei Kreaturen geblockt werden.', 'type': 'Beschwörung von Gorillas', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '95c682c0-2a8d-483b-adde-b4bd6fc62470'}, 'multiverseid': None}, {'name': 'Gorilas enfurecidos', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f19efcfa-3b2a-45f0-99c6-344d87ce2512'}, 'multiverseid': None}, {'name': 'Berserkers gorilles', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '772f4ad5-505f-44fe-bbb4-6a22690f9ae4'}, 'multiverseid': None}, {'name': 'Gorilla Berserker', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '3a4ea015-f472-440f-b621-4d838eb6670f'}, 'multiverseid': None}, {'name': 'Gorilas Enfurecidos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f6d5cda8-7515-4f65-a01c-eaf7648e13e6'}, 'multiverseid': None}]", "[{'name': 'Rasende Gorillas', 'text': 'Verursacht Trampelschaden\\nRaserei: 2\\nKönnen nicht von weniger als drei Kreaturen geblockt werden.', 'type': 'Beschwörung von Gorillas', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd9feb76b-d9ee-4606-a947-1559c2ef8240'}, 'multiverseid': None}, {'name': 'Gorilas enfurecidos', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '073d66ea-97f9-46aa-b85e-6a2bde2aaf06'}, 'multiverseid': None}, {'name': 'Berserkers gorilles', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '4cfeb06f-07f2-47cd-84e6-e788ffeb8713'}, 'multiverseid': None}, {'name': 'Gorilla Berserker', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6a057bc3-3824-4738-aab5-7997b6caa71a'}, 'multiverseid': None}, {'name': 'Gorilas Enfurecidos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7079831f-c356-47f7-a17b-df4ef7a61462'}, 'multiverseid': None}]", "[{'name': 'Reisender Magus', 'text': '{W}: Bezahle 1 Lebenspunkt, um bis zu 2 Schadenspunkte bei einer Kreatur zu verhindern.\\nEffekte, die Schaden verhindern oder umleiten, können hier nicht angewendet werden, um den Verlust der Lebenspunkte zu verhindern.\\n{U}: Verhindere 1 Schadenspunkt bei einem Kleriker oder Zauberer.\\n{B}: Lege eine -1/-1-Marke auf eine Kreatur Deiner Wahl, die Du kontrollierst, um bis zu 2 Schadenspunkte bei einem Spieler zu verhindern.', 'type': 'Beschwörung eines Klerikers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '02fa7fca-ed35-4d15-a3ec-208208f2da97'}, 'multiverseid': None}, {'name': 'Mago errante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1eccc369-4e39-4c0d-8b9c-001cd890e215'}, 'multiverseid': None}, {'name': 'Mage itinérante', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5aff7504-0f2e-449a-b6fa-bcc6f9cce013'}, 'multiverseid': None}, {'name': 'Mago Girovago', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '93bbea3f-12cd-4ddb-a5d5-228b2b4a3517'}, 'multiverseid': None}, {'name': 'Mago Errante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e46fc7ff-967b-4d1e-8fdf-6140b971bfb8'}, 'multiverseid': None}]", "[{'name': 'Revolte', 'text': 'Begrabe eine Kreatur Deiner Wahl mit Stärke größer oder gleich 4.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'bdb2fd72-a841-4204-ad80-6ea8e54fecfe'}, 'multiverseid': None}, {'name': 'Represalia', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '61cf0c4b-45b9-4bf0-ad7e-8c227874e95d'}, 'multiverseid': None}, {'name': 'Représailles', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd6ad218c-834d-47cf-b793-8d741ab4d701'}, 'multiverseid': None}, {'name': 'Rappresaglia', 'flavor': None, 'language': 'Italian', 'identi