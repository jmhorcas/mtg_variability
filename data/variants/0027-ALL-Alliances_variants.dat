': None}, {'name': 'Zanzara delle Paludi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c77f78f0-aed3-423e-b23e-21566fce1c27'}, 'multiverseid': None}, {'name': 'Mosquito do Pântano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a9295c1a-1173-4be4-bbd3-f3f3d141b7b4'}, 'multiverseid': None}]", '[{\'name\': \'Tauende Gletscher\', \'text\': "Kommt getappt ins Spiel.\\n{1}, {T}: Durchsuche Deine Bibliothek nach irgendeinem Standartland und bringe es sofort getappt ins Spiel. Dieses zählt nicht zu der \'ein-Land-pro-Runde\'-Beschränkung.\\nMische Deine Bibliothek danach neu. Bringe die Tauenden Gletscher am Ende des Zuges auf die Hand ihres Besitzers zurück.", \'type\': \'Land\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c286024-afd2-4b50-b0ab-3fce4852c105\'}, \'multiverseid\': None}, {\'name\': \'Glaciares menguantes\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c26f206-b5bb-4adf-bec8-40fd7aa30d0b\'}, \'multiverseid\': None}, {\'name\': \'Glaciers en dégel\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cfb41963-99cd-456f-bc3a-8e763312c90e\'}, \'multiverseid\': None}, {\'name\': \'Ghiacciai in Disgelo\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03539efa-e7b7-4ab9-ad7b-abb50979fa39\'}, \'multiverseid\': None}, {\'name\': \'Geleiras Minguantes\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69fbba49-96d8-4680-8efd-3488938855d2\'}, \'multiverseid\': None}]', "[{'name': 'Todesfunke', 'text': 'Der Todesfunke fügt einer Kreatur oder einem Spieler Deiner Wahl 1 Schadenspunkt zu.\\nWenn am Ende der Versorgungsphase der Todesfunke in Deinem Friedhof ist, mit einer Kreaturenkarte, direkt über ihm, kannst Du {1} bezahlen, um ihn wieder auf Deine Hand zu nehmen.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '09f0a7e6-62e3-4a34-a7b1-4438a4af00de'}, 'multiverseid': None}, {'name': 'Chispazo letal', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd9007c72-a025-4b8e-98cb-05a8150fab66'}, 'multiverseid': None}, {'name': 'Etincelle de mort', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '951c11d6-2d70-4167-bc98-3038179732aa'}, 'multiverseid': None}, {'name': 'Scintilla Mortale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b19b06af-eabf-47e4-93e2-6005710abe43'}, 'multiverseid': None}, {'name': 'Centelha Letal', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6673e99c-e9ce-4685-a4af-f2ec33cfaa1b'}, 'multiverseid': None}]", "[{'name': 'Tornado', 'text': 'Kumulative Versorgung: {G}\\n{2}{G}: Zahle 3 Lebenspunkte für jede Geschwindigkeits-Marke auf dem Tornado. Zerstöre eine bleibende Karte Deiner Wahl und lege eine Geschwindigkeits-Marke auf den Tornado. Benutze diese Fähigkeit nur einmal pro Zug.\\nEffekte, die Schaden verhindern oder umleiten, können hier nicht angewendet werden, um den Verlust der Lebenspunkte zu verhindern.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'cb2fbb96-1153-4cbc-98aa-88ae5d79b4e0'}, 'multiverseid': None}, {'name': 'Tornado', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ec03d8ab-1930-43db-b31d-279a9e8b6ae7'}, 'multiverseid': None}, {'name': 'Tornade', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '89e65481-3d91-48e7-b47e-4a836cd96a98'}, 'multiverseid': None}, {'name': 'Tornado', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '69bfee3f-3528-4cf8-a503-de5e76be0d30'}, 'multiverseid': None}, {'name': 'Tornado', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f8cbcbff-a8e4-4d31-ab76-1159da797284'}, 'multiverseid': None}]", "[{'name': 'Tote aus Balduvia', 'text': '{2}{R}: En