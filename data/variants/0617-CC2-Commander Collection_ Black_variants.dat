name: ['Command Tower', 'Ghoulcaller Gisa', 'Liliana, Heretical Healer // Liliana, Defiant Necromancer', 'Ophiomancer', 'Phyrexian Arena', 'Reanimate', 'Sol Ring', 'Toxic Deluge']
