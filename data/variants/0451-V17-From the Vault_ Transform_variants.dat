type: ['Creature — Human Insect', 'Creature — Human Werewolf', 'Creature — Human Wizard', 'Creature — Vampire', 'Creature — Werewolf', 'Legendary Artifact — Equipment', 'Legendary Creature — Angel', 'Legendary Creature — Angel Horror', 'Legendary Creature — Demon', 'Legendary Creature — Eldrazi Angel', 'Legendary Creature — Elf Scout', 'Legendary Creature — Human Cleric', 'Legendary Creature — Human Shaman', 'Legendary Creature — Human Soldier', 'Legendary Creature — Human Wizard', 'Legendary Enchantment', 'Legendary Land', 'Legendary Planeswalker — Arlinn', 'Legendary Planeswalker — Chandra', 'Legendary Planeswalker — Garruk', 'Legendary Planeswalker — Gideon', 'Legendary Planeswalker — Jace', 'Legendary Planeswalker — Liliana', 'Legendary Planeswalker — Nissa']
