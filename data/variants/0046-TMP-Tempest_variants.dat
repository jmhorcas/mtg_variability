: None}, {'name': 'Diabrete Enlouquecedor', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2b73a65c-448c-4872-8f60-07ffc9d512e3'}, 'multiverseid': None}]", "[{'name': 'Botschafter der Soltari', 'text': '{W}: Der Botschafter der Soltari erhält Irrealität bis zum Ende des Zuges.', 'type': 'Beschwörung eines Soldaten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e2a45633-50df-4fa5-805f-f7e7f21b9abb'}, 'multiverseid': None}, {'name': 'Emisario soltari', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd44b8b99-2532-4c3c-865a-b5d0323caf0a'}, 'multiverseid': None}, {'name': 'Emissaire soltari', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8b02121f-bda1-44fa-97c6-19728b1ec5d8'}, 'multiverseid': None}, {'name': 'Emissario Soltari', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1149a61a-ffa3-484e-870f-b4073c00461c'}, 'multiverseid': None}, {'name': 'サルタリーの使者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'bdc784fa-5713-400e-be24-3378609ef3b3'}, 'multiverseid': None}, {'name': 'Emissário Soltariano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '63a1fd8b-27de-49e7-aa77-f43b139aecd4'}, 'multiverseid': None}]", "[{'name': 'Brandrodung', 'text': 'Opfere ein Land. Durchsuche Deine Bibliothek nach bis zu zwei Standardlandkarten und bringe diese ins Spiel. Mische Deine Bibliothek danach neu.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c215f17c-c0ef-4894-8e11-463799ea5076'}, 'multiverseid': None}, {'name': 'Gradar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'cc2951a2-9359-448a-bb45-a2165c23fb29'}, 'multiverseid': None}, {'name': 'Hersage', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b806b714-c3e5-481d-bb85-3d61f1da75e7'}, 'multiverseid': None}, {'name': 'Erpice', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '749ea150-cda7-4eba-8cb5-5cb50a4c7f58'}, 'multiverseid': None}, {'name': '砕土', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '761dab36-809e-4b6f-9bc6-73a2e2c8ec01'}, 'multiverseid': None}, {'name': 'Estorrar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0e8e07a4-e3e6-463d-86d0-ae9afabe145c'}, 'multiverseid': None}]", "[{'name': 'Brennende Berührung', 'text': 'Rückkauf 4\\nDie Brennende Berührung fügt einer Kreatur oder einem Spieler Deiner Wahl 1 Schadenspunkt zu.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2dfa8b7b-a5f2-41e2-a42f-ccbb01bf173a'}, 'multiverseid': None}, {'name': 'Toque abrasador', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5dbad268-dbe1-47b7-b13b-85ce912f5b0b'}, 'multiverseid': None}, {'name': 'Effleurement de feu', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8184a76b-4cd3-4d19-9046-7b31c6555a78'}, 'multiverseid': None}, {'name': 'Tocco Bruciante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd05fab1f-3f92-4089-b566-1baef90d5e1b'}, 'multiverseid': None}, {'name': 'ふにゃふにゃ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fd22f25a-c1cf-4b0c-bdd2-009645a9059b'}, 'multiverseid': None}, {'name': 'Toque Cauterizante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8b58136c-b98c-4cad-9664-18b867fb2683'}, 'multiverseid': None}]", "[{'name': 'Brisenreiter', 'text': '{T}, tappe zwei Kreaturen, die Du kontrollierst: Bringe eine bleibende Karte Deiner Wahl auf die Hand ihres Besitzers zurück.', 'type': 'Beschwörung eines Geistes', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '6cb10255-b04d-45fe-b95e-210b75c86fb1'}, 'multiverseid': None}, {'name': 'Jinete de los vientos alisios', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2b8f1a57-e941-44b3-9efb-9ef61a4cb41a'}, 'multiverseid': None}, {'name': 'Chevaucheur des alizés', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '774be228-6811-40fb-a58c-59cedb0ca7a6'}, 'multiverseid': None}, {'name': 'Predone degli Alisei', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '677c14e1-99a8-4572-8372-c855c8981bc6'}, 'multiverseid': None}, {'name': '貿易風ライダー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ebd39347-f5dd-4cd6-86a7-f8e2ab9295b4'}, 'multiverseid': None}, {'name': 'Cavaleiro dos Alísios', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '68bc7a4d-d4df-482c-8c62-e9908b7474d8'}, 'multiverseid': None}]", '[{\'name\': \'Bücherregal\', \'text\': \'1, {T}: Bestimme eine beliebige Anzahl an Karten auf Deiner Hand und lege diese Karten zur Seite. Nimm dann die gleiche Anzahl Karten oben von Deiner Bibliothek auf Deine Hand und lege die Karten, die auf diese Art zur Seite gelegt wurden, in beliebiger Reihenfolge oben auf Deine Bibliothek.\', \'type\': \'Artefakt\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4ec4e578-dde8-4c54-bf7d-abd2ad4c1ec6\'}, \'multiverseid\': None}, {\'name\': \'Estantería de pergaminos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d196387b-596c-40b1-99ce-df172a4a3ec2\'}, \'multiverseid\': None}, {\'name\': \'Râtelier à parchemins\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'31b1c169-8f93-4903-8257-03c6ca9ac53c\'}, \'multiverseid\': None}, {\'name\': \'Scansia di Pergamene\', \'text\': "{1}, {T}: Scegli un qualsiasi numero di carte dalla tua mano e mettile da parte. Prendi un eguale numero di carte dalla cima tuo grimorio e aggiungile alla tua mano. Poi prendi le carte messe da parte in questo modo e mettile sulla cima del tuo grimorio nell\'ordine che preferisci.", \'type\': \'Artefatto\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bacb51f5-c743-4444-b784-ab53f33867ad\'}, \'multiverseid\': None}, {\'name\': \'巻物棚\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'896cdb11-d698-4b6e-a67e-95256fcde98b\'}, \'multiverseid\': None}, {\'name\': \'Prateleira de Pergaminhos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba544e81-f109-4e9f-8539-fc6521a802ff\'}, \'multiverseid\': None}]', "[{'name': 'Chaotischer Schlamm', 'text': 'Der Chaotische Schlamm kommt mit drei +1/+1 Marken auf ihm ins Spiel.\\nDu kannst während Deiner Versorgungsphase eine Münze werfen. Wenn Du den Münzwurf gewinnst, lege eine +1/+1 Marke auf den Chaotischen Schlamm. Entferne ansonsten eine +1/+1 Marke vom Chaotischen Schlamm.', 'type': 'Beschwörung eines Schlammwesens', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '15dd5250-1357-4425-8fb6-688fb736c317'}, 'multiverseid': None}, {'name': 'Substancia caótica', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1f6a0088-4abb-4607-830b-5c2bfd985caf'}, 'multiverseid': None}, {'name': 'Empois chaotique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f7fc93f8-7ec5-4613-bd73-0497444ff757'}, 'multiverseid': None}, {'name': 'Limo Caotico', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0998a52a-079e-4745-926b-26b7adcc1874'}, 'multiverseid': None}, {'name': '混沌のグー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fb87ccd3-27e0-4ffa-9835-90cb869ac6e4'}, 'multiverseid': None}, {'name': 'Visco Caótico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '958ae26a-4bb0-41d2-830c-794d799fecca'}, 'multiverseid': None}]", '[{\'name\': \'Dauerfrost\', \'text\': \'Zerstöre ein Land Deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9fda6f9b-cae9-418d-89ec-f74a5bc56884\'}, 