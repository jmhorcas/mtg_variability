.', 'type': 'Beschwörung einer Bestie', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '58201f5a-8815-4839-99a3-2c9bad4b7f77'}, 'multiverseid': None}, {'name': 'Palimud', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '675a2ae8-5ea7-4dca-ada9-0c2c09e39ede'}, 'multiverseid': None}, {'name': 'Mâchefange', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'cc94f18e-e463-4b09-a1cd-12867848e878'}, 'multiverseid': None}, {'name': 'Pallimud', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '16120c52-d3d1-4d5d-9187-e66472a7a122'}, 'multiverseid': None}, {'name': 'パリムッド', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5dfe7be6-6c0a-48e5-a956-2edc0a8dbb8b'}, 'multiverseid': None}, {'name': 'Pallimud', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4eef5901-81ed-4dd7-96a0-53982e3bdc1d'}, 'multiverseid': None}]", "[{'name': 'Pazifismus', 'text': 'Die verzauberte Kreatur kann nicht angreifen oder blocken.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7f11d46d-970b-4f00-9709-4ee9459f5784'}, 'multiverseid': None}, {'name': 'Pacifismo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '279c6c2b-e246-4b32-977d-9f5782d69b6d'}, 'multiverseid': None}, {'name': 'Pacifisme', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '878b3302-70b2-48bd-b897-6120a870fc5f'}, 'multiverseid': None}, {'name': 'Pacifismo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5ee2bb69-8fe7-42c8-8652-9bc585ce8552'}, 'multiverseid': None}, {'name': '平和な心', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c010ab66-a3d6-435c-8da3-1abcb20814b9'}, 'multiverseid': None}, {'name': 'Pacifismo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '68a3797b-37c8-417b-8876-1e1f120baa07'}, 'multiverseid': None}]", '[{\'