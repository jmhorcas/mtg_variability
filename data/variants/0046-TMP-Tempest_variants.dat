ultiverseid\': None}, {\'name\': \'Fractius Mnemônico\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af1dba92-68f5-49b6-80d7-03e66a9c58d5\'}, \'multiverseid\': None}]', "[{'name': 'Ernte des Lebens', 'text': 'Bringe eine beliebige Anzahl an Karten Deiner Wahl aus Deinem Friedhof zurück auf Deine Hand. Du kannst nicht mehr Karten wählen, als die Anzahl an schwarzen bleibenden Karten, die ein Gegner Deiner Wahl kontrolliert, beträgt.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'ca4ecf85-ca5a-403b-95ec-867ea02105b2'}, 'multiverseid': None}, {'name': 'Cosechar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4c6e818d-dcd0-4962-a9ea-47a149e868da'}, 'multiverseid': None}, {'name': 'Fenaison', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '3e92cc27-e2e7-4ac1-86bc-e34c087de93a'}, 'multiverseid': None}, {'name': 'Mietitura', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '22059187-9343-4079-83e7-73fd39f0e6b5'}, 'multiverseid': None}, {'name': '刈り取り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '6ce8d869-0914-4176-9826-e5a8b6d434fd'}, 'multiverseid': None}, {'name': 'Segar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3a9b1c71-4ce1-4ec8-93b5-e5e6b8a22d3f'}, 'multiverseid': None}]", '[{\'name\': \'Erster Speer\', \'text\': \'Wenn der Erste Speer blockt, fügt er einer angreifenden Kreatur Deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Beschwörung eines Soldaten\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'884e1cc3-426d-4c4c-b1ff-6550413bea2f\'}, \'multiverseid\': None}, {\'name\': \'Javalinero de élite\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7efdeb23-036b-4c52-8b70-bc03bd989917\'}, \'multiverseid\': None}, {\'name\': "Javelinier d\'élite", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32c83a59-17f8-424c-b230-3a91bac9ac23\'}, \'multiverseid\': None}, {\'name\': \'Giavellottiere Scelto\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39b5cf26-ba6b-420e-9e46-233a56fb1c62\'}, \'multiverseid\': None}, {\'name\': \'精鋭なる投槍兵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98dcc797-d383-498b-9cab-a2eb36414c1e\'}, \'multiverseid\': None}, {\'name\': \'Zagaieiro de Elite\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8819bf40-a20c-40d8-ba17-318bcc9dedb0\'}, \'multiverseid\': None}]', "[{'name': 'Ertais Einmischung', 'text': 'Lege X Verzögerungsmarken auf einen Zauberspruch Deiner Wahl, wenn dieser erfolgreich gesprochen wurde. X kann nicht 0 sein.\\nEntferne während der Versorgungsphase des Urhebers des verzögerten Zauberspruchs eine Verzögerungsmarke von diesem Zauberspruch. Wenn auf dem Zauberspruch keine Verzögerungsmarken liegen, wird er verrechnet.', 'type': 'Unterbrechungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a33fa002-df77-42a9-9575-986c7cb95394'}, 'multiverseid': None}, {'name': 'La intromisión de Ertai', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6df7e41a-7479-4a6b-8069-d302507f2cb6'}, 'multiverseid': None}, {'name': 'Ingérence selon Ertaï', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'fb507a78-2e08-45ad-aceb-cdc837c3f056'}, 'multiverseid': None}, {'name': 'Ingerenza di Ertai', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '64fb94b8-e6d3-4c36-ac0b-b4c204977d03'}, 'multiverseid': None}, {'name': 'アーテイのおせっかい', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3c990f0d-592d-4a90-9a16-ca4771fdb21d'}, 'multiverseid': None}, {'name': 'Intromissão de Ertai', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7fde1c40-0e97-4a45