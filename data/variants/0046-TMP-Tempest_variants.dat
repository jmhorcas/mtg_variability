olrath', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '16b295bb-c487-4fd6-9721-a04a6b917dca'}, 'multiverseid': None}, {'name': 'Malédiction selon Wöhlrajh', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '693e594f-b721-4614-b41b-c9785fc9676f'}, 'multiverseid': None}, {'name': 'Maledizione di Volrath', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b7e9119e-d245-4e72-9944-ad123d96233b'}, 'multiverseid': None}, {'name': 'ヴォルラスの呪い', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f4f8cd92-c95d-4660-a468-a96d8af77e87'}, 'multiverseid': None}, {'name': 'Maldição de Volrath', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f064febb-212e-4fdd-b590-7162f7106fe7'}, 'multiverseid': None}]", "[{'name': 'Vorahnung', 'text': 'Du kannst Dir während Deiner Versorgungsphase die oberste Karte der Bibliothek eines Gegners Deiner Wahl anschauen. Du kannst diese Karte unter die Bibliothek dieses Spielers legen.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8472f5e3-5a6c-4d66-b246-6cc4c1a5a821'}, 'multiverseid': None}, {'name': 'Precognición', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '31ca1cb4-693b-4fbd-9a51-3cd279eb42f4'}, 'multiverseid': None}, {'name': 'Précognition', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '2afbea8a-cade-45dd-98db-ca091cb0caf5'}, 'multiverseid': None}, {'name': 'Precognizione', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e9c7fbec-cfae-4496-88fa-c51fa0644b44'}, 'multiverseid': None}, {'name': '前知', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c0e291a8-1735-4d6a-bb5c-21411a5b348f'}, 'multiverseid': None}, {'name': 'Precognição', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9efd3bcb-0766-4372-ba55-9b2eb3196483'}, 'multiverseid': None}]", "[{'name': 'Wachhu