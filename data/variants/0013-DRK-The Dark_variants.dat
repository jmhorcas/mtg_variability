n', 'identifiers': {'scryfallId': '14644810-3c52-4680-b4aa-d0a3509e3c47'}, 'multiverseid': None}]", "[{'name': 'Teschio di Orn', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'dc07a22f-4d98-4c91-a1fd-ada80deb758a'}, 'multiverseid': None}]", "[{'name': 'Tocco di Gea', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd2530161-e1ae-4c3c-bff6-041fc4de3782'}, 'multiverseid': None}]", "[{'name': 'Topi delle Paludi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f70d7858-355d-4dff-9d88-629ad6877fee'}, 'multiverseid': None}]", "[{'name': 'Torre di Coireall', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '990edef7-a553-4c68-815f-f2d3c167374b'}, 'multiverseid': None}]", "[{'name': 'Tritone Assassino', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '80934163-0df2-4e0e-80c4-1a99a723f3ef'}, 'multiverseid': None}]", "[{'name': 'Veleno', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5665e75a-8cdf-4998-be92-96ec34b06732'}, 'multiverseid': None}]", "[{'name': 'Vermi della Terra', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '258b25e7-f2be-4c0f-9df3-001dd92f889c'}, 'multiverseid': None}]", "[{'name': 'Vincolo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6af62501-353c-44be-9298-fa38a248a9d2'}, 'multiverseid': None}]", "[{'name': 'Vipera degli Acquitrini', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '7fd10515-750f-4ea9-b2a0-1f8560d92fa6'}, 'multiverseid': None}]", "[{'name': 'Vortice di Mana', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a320f33e-1b03-4f4a-8a86-b4d02d067b20'}, 'multiverseid': None}]", "[{'name': 'Zio Istvan', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '52a2afa6-75c0-4b58-b38b-294b060ae760'}, 'multiverseid': None}]", "[{'name': 'Zombi del Naufragio', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryf