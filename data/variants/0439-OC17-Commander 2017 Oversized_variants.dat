type: ['Legendary Creature — Cat Avatar', 'Legendary Creature — Dragon Avatar', 'Legendary Creature — Human Wizard', 'Legendary Creature — Vampire Knight']
supertypes: ['Legendary']
subtypes: ['Avatar', 'Cat', 'Dragon', 'Human', 'Knight', 'Vampire', 'Wizard']
