resta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400670&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a9c8ef6c-ae1e-4109-9e19-3ca1253998f3', 'multiverseId': 400670}, 'multiverseid': 400670}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400947&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e6a91042-ff86-464d-8d27-de56a57de233', 'multiverseId': 400947}, 'multiverseid': 400947}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398731&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'de4a0078-7e9c-4557-a203-032306666ea2', 'multiverseId': 398731}, 'multiverseid': 398731}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399008&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '74d225d1-0a53-4e0e-92ea-f9768aabbc3a', 'multiverseId': 399008}, 'multiverseid': 399008}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399401&type=card', 'language': 'German', 'identifiers': {'scryfallId': '03b0418f-b209-4c02-8e9a-80d3d1aceaf6', 'multiverseId': 399401}, 'multiverseid': 399401}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401340&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5c6514d7-4260-4975-859a-06a69f913359', 'multiverseId': 401340}, 'multiverseid': 401340}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399678&type=card', 'language': 'French', 'identi