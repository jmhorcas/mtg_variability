dlers/Image.ashx?multiverseid=399124&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '09ae0a28-d837-4ca8-b99e-06e262aadf47', 'multiverseId': 399124}, 'multiverseid': 399124}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399448&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3dc72848-0bd7-488b-a7e1-3de166d6143a', 'multiverseId': 399448}, 'multiverseid': 399448}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401387&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c83de699-df38-48f5-bc2b-5079cae4f201', 'multiverseId': 401387}, 'multiverseid': 401387}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399725&type=card', 'language': 'French', 'identifiers': {'scryfallId': '497c398b-a69b-4402-adf2-ba6327373654', 'multiverseId': 399725}, 'multiverseid': 399725}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400002&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1659a42c-1d65-470b-9ac1-f1df1d51f94e', 'multiverseId': 400002}, 'multiverseid': 400002}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400279&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ad139df8-cb40-44c1-888c-0d2f5c5eba2c', 'multiverseId': 400279}, 'multiverseid': 400279}, {'name': '숲', 'type': '기본 대지 — 숲', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400556&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '91a1cac1-bbe5-4fa9-9cfd-c6bec9ed4981', 'multiverseId': 400556}, 'multiverseid': 400556}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400833&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd75dbd92-0817-4334-8f16-3114998deba1', 'multiverseId': 400833}, 'multiverseid': 400833}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401110&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0133568d-1060-445f-9da4-509f806b795e', 'multiverseId': 401110}, 'multiverseid': 401110}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398894&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6c7cbd99-5541-4322-b545-27e42a9a8f72', 'multiverseId': 398894}, 'multiverseid': 398894}, {'name': '樹林', 'type': '基本地～樹林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399171&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '803921c6-e405-49c1-a9d3-08b4d709a133', 'multiverseId': 399171}, 'multiverseid': 399171}]", "[{'name': 'Waldland-Gröler', 'text': 'Wenn der Waldland-Gröler ins Spiel kommt, kannst du deine Bibliothek nach einer nichtlegendären grünen Kreaturenkarte mit umgewandelten Manakosten von 3 oder weniger durchsuchen, sie ins Spiel bringen und dann deine Bibliothek mischen.', 'type': 'Kreatur — Bestie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399342&type=card', 'language': 'German', 'identifiers': {'scryfallId': '66c827d3-80ca-4858-9494-ec463c751c0c', 'multiverseId': 399342}, 'multiverseid': 399342}, {'name': 'Rugidor del bosque', 'text': 'Cuando el Rugidor del bosque entre al campo de batalla, puedes buscar en tu biblioteca una carta de criatura verde que no sea legendaria con coste de maná convertido de 3 o menos, ponerla en el campo de batalla y luego barajar tu biblioteca.', 'type': 'Criatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401281&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '341b61c5-e0d3-4efa-ac91-b91f665c2734', 'multiverseId': 401281}, 'multiverseid': 401281}, {'name': 'Beuglard des sylves', 'text': 'Quand le Beuglard des sylves arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte de créature verte non-légendaire ayant un coût converti de mana inférieur ou égal à 3, la mettre sur le champ de bataille et mélanger ensuite votre bibliothèque.', 'type': 'Créature : bête', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399619&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c948aa7a-6f66-49bf-a582-c8b6a0175a7c', 'multiverseId': 399619}, 'multiverseid': 399619}, {'name': 'Ruggente dei Boschi', 'text': 'Quando il Ruggente dei Boschi entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta creatura non leggendaria verde con costo di mana convertito pari o inferiore a 3, metterla sul campo di battaglia, poi rimescolare il tuo grimorio.', 'type': 'Creatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399896&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fa94b6be-a664-4397-a96c-f6409517a5ef', 'multiverseId': 399896}, 'multiverseid': 399896}, {'name': '森林の怒声吠え', 'text': '森林の怒声吠えが戦場に出たとき、あなたはあなたのライブラリーから、点数で見たマナ・コストが３以下の伝説でない緑のクリーチャー・カードを１枚探してもよい。そうしたなら、それを戦場に出し、その後あなたのライブラリーを切り直す。', 'type': 'クリーチャー — ビースト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400173&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '602b74e1-6f26-40fd-9317-0f51a0c7f67f', 'multiverseId': 400173}, 'multiverseid': 400173}, {'name': '포효하는 삼림지 짐승', 'text': '포효하는 삼림지 짐승이 전장에 들어올 때, 당신은 당신의 서고에서 전환마나비용이 3 이하이고 전설이 아닌 녹색 생물 카드 한 장을 찾아 공개한 후 전장에 놓을 수 있다. 그렇게 한다면, 당신의 서고를 섞는다.', 'type': '생물 — 야수', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400450&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '92b399dd-028f-49d4-b57c-978356beaf95', 'multiverseId': 400450}, 'multiverseid': 400450}, {'name': 'Uivador da Floresta', 'text': 'Quando Uivador da Floresta entra no campo de batalha, você pode procurar em seu grimório um card de criatura verde que não seja lendário com custo de mana convertido igual ou inferior a 3, colocá-lo no campo de batalha e depois embaralhar seu grimório.', 'type': 'Criatura — Besta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400727&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '41a9893c-f05a-48f5-b7c9-8c3a7805a56e', 'multiverseId': 400727}, 'multiverseid': 400727}, {'name': 'Лесной Ревун', 'text': 'Когда Лесной Ревун выходит на поле битвы, вы можете найти в вашей библиотеке карту не являющегося легендарным зеленого существа с конвертированной мана-стоимостью не более 3, положить ее на поле битвы, затем перетасовать вашу библиотеку.', 'type': 'Существо — Зверь', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401004&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f657180a-6bbe-4486-af5f-60702fc9a8a8', 'multiverseId': 401004}, 'multiverseid': 401004}, {'name': '林地咆哮兽', 'text': '当林地咆哮兽进战场时，你可以从你的牌库中搜寻一张总法术力费用等于或小于3且非传奇的绿色生物牌，将之放进战场，然后将你的牌库洗牌。', 'type': '生物～野兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398788&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8ab7b0e4-7459-4455-8e57-8f2c5e8112e5', 'multiverseId': 398788}, 'multiverseid': 398788}, {'name': '林地咆哮獸', 'text': '當林地咆哮獸進戰場時，你可以從你的牌庫中搜尋一張總魔法力費用等於或小於3且非傳奇的綠色生物牌，將之放進戰場，然後將你的牌庫洗牌。', 'type': '生物～野獸', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399065&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'f69fafc9-8007-413e-98dc-a2bc97508285', 'multiverseId': 399065}, 'multiverseid': 399065}]", '[{\'name\': \'Wasserfließer\', \'text\': \'{U}: Der Wasserfließer erhält +1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Hüte dich vor Strudeln, wo keine sein sollten, oder Stellen, an denen das Wasser zu schnell oder zu langsam fließt."—Alte Gräte, Flussführer aus Martyne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399371&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ce571fa-2cfc-4c06-b2e4-e137228baa13\', \'multiverseId\': 399371}, \'multiverseid\': 399371}, {\'name\': \'Corcel acuático\', \'text\': \'{U}: El Corcel acuático obtiene +1/-1 hasta el final del turno.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"No te fíes de un remolino que no debiera estar ahí ni de un tramo que fluya demasiado deprisa o demasiado lento".—Viejo Huesos de Pescado, guía de río de Martyne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401310&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'53f6f554-1f8e-4bd3-bdab-e892afb417d4\', \'multiverseId\': 401310}, \'multiverseid\': 401310}, {\'name\': \'Coursier des eaux\', \'text\': "{U} : Le Coursier des eaux gagne +1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : élémental\', \'flavor\': "« Gare aux tourbillons qui ne sont pas à leur place ou aux cours d\'eau au débit anormal. »—Vieilles Arêtes, guide fluvial de Marteyne", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399648&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7dc316ec-d985-4f41-b984-9611bf8b9f9d\', \'multiverseId\': 399648}, \'multiverseid\': 399648}, {\'name\': \'Solca-acqua\', \'text\': \'{U}: Il Solca-acqua prende +1/-1 fino alla fine del turno.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Guardati da un gorgo che non dovrebbe trovarsi lì o da una corrente che scorre troppo veloce o troppo lenta."—Vecchia Lisca, guida fluviale di Martyne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399925&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f0d6a8e-85a3-441a-ad56-290b82532bd9\', \'multiverseId\': 399925}, \'multiverseid\': 399925}, {\'name\': \'狩漁者\', \'text\': \'{U}：ターン終了時まで、狩漁者は＋１/－１の修整を受ける。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「ないはずの所に出ている渦、それから速すぎる流れや遅すぎる流れに気を付けるんじゃぞ。」――マーティンの川案内人、魚骨老\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400202&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1840cea3-0fdf-40ed-a0c0-a5cde7958056\', \'multiverseId\': 400202}, \'multiverseid\': 400202}, {\'name\': \'급류의 정령\', \'text\': \'{U}: 급류의 정령은 턴종료까지 +1/-1을 받는다.\', \'type\': \'생물 — 정령\', \'flavor\': \'"없어야 할 곳에 있는 소용돌이나 물이 흐르는 속도가 현저히 다른 곳을 조심하시오."—마르틴 강의 안내원 늙은이 피시본\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400479&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a61eecf5-a053-488e-a167-72334b07e842\', \'multiverseId\': 400479}, \'multiverseid\': 400479}, {\'name\': "Cursor D\'água", \'text\': "{U}: Cursor D\'água recebe +1/-1 até o final do turno.", \'type\': \'Criatura — Elemental\', \'flavor\': \'"Cuidado com os redemoinhos que não deveriam existir ou com uma marola que se propague rápido demais ou devagar demais."— Velho Espinha de Peixe, guia do rio Martyne\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400756&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b7c8be3-3cf4-4ce5-9f5a-eaf7512acfda\', \'multiverseId\': 400756}, \'multiverseid\': 400756}, {\'name\': \'Водобег\', \'text\': \'{U}: Водобег получает +1/-1 до конца хода.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Берегись водоворотов там, где их не должно быть, и слишком быстрого или медленного течения».— Старик Рыбохвост, речной проводник из Мартайна\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401033&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fff5b40b-fc74-45bd-944c-f05939c041d6\', \'multiverseId\': 401033}, \'multiverseid\': 401033}, {\'name\': \'河道巡灵\', \'text\': \'{U}：河道巡灵得+1/-1直到回合结束。\', \'type\': \'生物～元素\', \'flavor\': \'「当心意外出现的漩涡，或水流过快或过慢的航程。」～马提涅河领路人老鱼骨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398817&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ffea7179-e6f7-4aef-9231-05baee813abd\', \'multiverseId\': 398817}, \'multiverseid\': 398817}, {\'name\': \'河道巡靈\', \'text\': \'{U}：河道巡靈得+1/-1直到回合結束。\', \'type\': \'生物～元素\', \'flavor\': \'「當心意外出現的漩渦，或水流過快或過慢的航程。」～馬提涅河領路人老魚骨\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399094&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'79c43584-d54a-4720-8acd-4b1b31e603d6\', \'multiverseId\': 399094}, \'multiverseid\': 399094}]', '[{\'name\': \'Wiedergekehrter Zentaur\', \'text\': \'Wenn der Wiedergekehrte Zentaur ins Spiel kommt, legt ein Spieler deiner Wahl die obersten vier Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Kreatur — Zombie, Zentaur\', \'flavor\': \'Vertrieben von seinen lebenden Artgenossen irrt er trauernd durch die Wildnis, immer auf der Suche nach Asphodel, der Polis der Toten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399299&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6dc8a0f0-6688-4502-99c1-eeff88cda3ea\', \'multiverseId\': 399299}, \'multiverseid\': 399299}, {\'name\': \'Centauro resurgido\', \'text\': \'Cuando el Centauro resurgido entre al campo de batalla, el jugador objetivo pone las cuatro primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Criatura — Centauro zombie\', \'flavor\': \'Expulsado por sus hermanos vivos, vaga y se lamenta por los parajes en busca de la ciudad muerta de Asfodel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8cc88260-db0f-436d-90ff-91ed31805755\', \'multiverseId\': 401238}, \'multiverseid\': 401238}, {\'name\': \'Centaure reparu\', \'text\': \'Quand le Centaure reparu arrive sur le champ de bataille, le joueur ciblé met les quatre cartes du dessus de sa bibliothèque dans son cimetière.\', \'type\': \'Créature : zombie et centaure\', \'flavor\': "Chassé par ses semblables du monde des vivants, il parcourt désespérément les terres sauvages en quête de la cité des morts d\'Asphodèle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399576&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d09b41e1-6bd9-4eb0-bb83-d4a9fe249662\', \'multiverseId\': 399576}, \'multiverseid\': 399576}, {\'name\': \'Centauro Risvegliato\', \'text\': \'Quando il Centauro Risvegliato entra nel campo di battaglia, un giocatore bersaglio mette nel suo cimitero le prime quattro carte del suo grimorio.\', \'type\': \'Creatura — Centauro Zombie\', \'flavor\': \'Scacciato dai suoi fratelli viventi, vaga gemendo per le terre selvagge, alla ricerca della città morta di Asfodelo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399853&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fff5f98b-ac9c-449e-b629-9941f6bc26f5\', \'multiverseId\': 399853}, \'multiverseid\': 399853}, {\'name\': \'蘇りしケンタウルス\', \'text\': \'蘇りしケンタウルスが戦場に出たとき、プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上から４枚のカードを自分の墓地に置く。\', \'type\': \'クリーチャー — ゾンビ・ケンタウルス\', \'flavor\': \'生ある仲間たちから追われ、彼は悲しみの中、死者の街アスフォデルを求めて荒野をさまよっていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400130&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e846f24a-dee9-4d96-b85c-3a6673161675\', \'multiverseId\': 400130}, \'multiverseid\': 400130}, {\'name\': \'되살아난 켄타우로스\', \'text\': \'되살아난 켄타우로스가 전장에 들어올 때, 플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 네 장을 자신의 무덤에 넣는다.\', \'type\': \'생물 — 좀비 켄타우로스\', \'flavor\': \'살아 있는 동료들에게 쫓겨난 켄타우로스는 망자들의 도시 아스포델을 찾아 황야를 배회한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400407&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'eb9ecac3-124f-4abd-b12b-0a5239a83b6a\', \'multiverseId\': 400407}, \'multiverseid\': 400407}, {\'name\': \'Centauro Ressurgido\', \'text\': \'Quando Centauro Ressurgido entra no campo de batalha, o jogador alvo coloca os quatro cards do topo do grimório dele no próprio cemitério.\', \'type\': \'Criatura — Zumbi Centauro\', \'flavor\': \'Rechaçado por seus parentes vivos, ele vaga em lamento pelas terras selvagens em busca da cidade dos mortos, Asfódelos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400684&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f4f680ad-30bd-4c63-acb2-fa3e14eddab4\', \'multiverseId\': 400684}, \'multiverseid\': 400684}, {\'name\': \'Возвращенный Кентавр\', \'text\': \'Когда Возвращенный Кентавр выходит на поле битвы, целевой игрок кладет четыре верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Существо — Зомби Кентавр\', \'flavor\': \'Изгнанный своими живыми собратьями, он печально скитается по диким землям в поисках мертвого города Асфодели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400961&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7fd75ff3-e066-4eaa-b130-619d5eb560e7\', \'multiverseId\': 400961}, \'multiverseid\': 400961}, {\'name\': \'转世半人马\', \'text\': \'当转世半人马进战场时，目标牌手将其牌库顶的四张牌置入其坟墓场。\', \'type\': \'生物～灵俑／半人马\', \'flavor\': \'被在世的亲属赶走后，他悲伤地在旷野间徘徊，寻找死城安福陵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398745&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c420f8b4-9acd-42d2-bc5f-6943377d493c\', \'multiverseId\': 398745}, \'multiverseid\': 398745}, {\'name\': \'轉世半人馬\', \'text\': \'當轉世半人馬進戰場時，目標玩家將其牌庫頂的四張牌置入其墳墓場。\', \'type\': \'生物～殭屍／半人馬\', \'flavor\': \'被在世的親屬趕走後，他悲傷地在曠野間徘徊，尋找死城安福陵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399022&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'136b96cc-31c3-41cf-a16d-ca70e75e95b1\', \'multiverseId\': 399022}, \'multiverseid\': 399022}]', '[{\'name\': \'Wilde Instinkte\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält +2/+2 bis zum Ende des Zuges. Sie kämpft gegen eine Kreatur deiner Wahl, die ein Gegner kontrolliert. (Jede dieser Kreaturen fügt der anderen Schadenspunkte in Höhe ihrer Stärke zu.)\', \'type\': \'Hexerei\', \'flavor\': \'Nissa hatte nur einen Herzschlag Zeit, um zu reagieren, und ihre Instinkte lenkten ihre Klinge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399339&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bf6fab0-518d-4123-bf0a-e6f500db3d5a\', \'multiverseId\': 399339}, \'multiverseid\': 399339}, {\'name\': \'Instintos salvajes\', \'text\': \'La criatura objetivo que controlas obtiene +2/+2 hasta el final del turno. Lucha contra la criatura objetivo que controla un oponente. (Cada una hace un daño igual a su fuerza a la otra.)\', \'type\': \'Conjuro\', \'flavor\': \'Nissa solo tuvo un instante para reaccionar; sus instintos guiaron su hoja.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401278&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'49d8b30f-d564-41e4-a026-12a94ed9dd24\', \'multiverseId\': 401278}, \'multiverseid\': 401278}, {\'name\': \'Instincts sauvages\', \'text\': "Une créature ciblée que vous contrôlez gagne +2/+2 jusqu\'à la fin du tour. Elle se bat contre une créature ciblée qu\'un adversaire contrôle. (Chacune inflige un nombre de blessures égal à sa force à l\'autre.)", \'type\': \'Rituel\', \'flavor\': "Nissa n\'eut qu\'un battement de cœur pour réagir, son instinct guidant sa lame.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d05d07a4-aa2e-44cb-a7bb-a6df23f108b3\', \'multiverseId\': 399616}, \'multiverseid\': 399616}, {\'name\': \'Istinti Selvaggi\', \'text\': "Una creatura bersaglio che controlli prende +2/+2 fino alla fine del turno. Lotta con una creatura bersaglio controllata da un avversario. (Ogni creatura infligge all\'altra danno pari alla propria forza.)", \'type\': \'Stregoneria\', \'flavor\': "Nissa ebbe il tempo di un battito del cuore per reagire. Fu l\'istinto a guidare la sua lama.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399893&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0fec395-7a82-4d14-b3c0-cb57829af54f\', \'multiverseId\': 399893}, \'multiverseid\': 399893}, {\'name\': \'野性の本能\', \'text\': \'あなたがコントロールするクリーチャー１体と、対戦相手がコントロールするクリーチャー１体を対象とする。ターン終了時まで、その前者は＋２/＋２の修整を受ける。その前者はその後者と格闘を行う。（それぞれはもう一方に自身のパワーに等しい点数のダメージを与える。）\', \'type\': \'ソーサリー\', \'flavor\': \'ニッサが反応するのに心の臓が１拍する間の猶予しかなかった。彼女の本能がその刃を導いた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400170&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b62aaceb-99f1-45fd-8b34-31ff4bcf0dda\', \'multiverseId\': 400170}, \'multiverseid\': 400170}, {\'name\': \'야생의 본능\', \'text\': \'당신이 조종하는 생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 상대가 조종하는 생물을 목표로 정한다. 그 생물은 첫 번째로 목표로 정한 생물과 싸운다. (각 생물은 서로에게 각자의 공격력만큼의 피해를 입힌다.)\', \'type\': \'집중마법\', \'flavor\': \'니사에게는 상황을 판단해서 대응할 시간이 없었다. 그저 본능적으로 칼을 휘둘렀다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400447&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6d7e8e00-17f6-4a7a-8784-f73254c5e601\', \'multiverseId\': 400447}, \'multiverseid\': 400447}, {\'name\': \'Instintos Selvagens\', \'text\': \'A criatura alvo que você controla recebe +2/+2 até o final do turno. Ela luta contra a criatura alvo que um oponente controla. (Cada uma causa dano igual ao seu poder à outra.)\', \'type\': \'Feitiço\', \'flavor\': \'Nissa teve apenas uma fração de segundo para reagir, controlando a lâmina instintivamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400724&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'034d5cd4-0f0b-4410-9902-ac245ed4c58f\', \'multiverseId\': 400724}, \'multiverseid\': 400724}, {\'name\': \'Дикие Инстинкты\', \'text\': \'Целевое существо под вашим контролем получает +2/+2 до конца хода. Оно дерется с целевым существом под контролем оппонента. (Эти существа наносят друг другу повреждения, равные своей силе.)\', \'type\': \'Волшебство\', \'flavor\': \'У Ниссы было лишь мгновение, чтобы среагировать. Ее клинок направили инстинкты.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401001&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'95ae4f66-7b23-4bdf-b2d8-95d92bc22450\', \'multiverseId\': 401001}, \'multiverseid\': 401001}, {\'name\': \'野性本能\', \'text\': \'目标由你操控的生物得+2/+2直到回合结束。它与目标由对手操控的生物互斗。（它们各向对方造成等同于本身力量的伤害。）\', \'type\': \'法术\', \'flavor\': \'妮莎只有心跳般的余裕能反应，她本能地举起了剑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398785&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c4304a21-aa91-4f3c-8ffa-ffe0e74125a0\', \'multiverseId\': 398785}, \'multiverseid\': 398785}, {\'name\': \'野性本能\', \'text\': \'目標由你操控的生物得+2/+2直到回合結束。它與目標由對手操控的生物互鬥。（它們各向對方造成等同於本身力量的傷害。）\', \'type\': \'巫術\', \'flavor\': \'妮莎只有心跳般的餘裕能反應，她本能地舉起了劍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399062&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7348ef48-1117-45ee-88a4-67a029c4d83c\', \'multiverseId\': 399062}, \'multiverseid\': 399062}]', '[{\'name\': \'Willensbrecherin\', \'text\': \'Immer wenn eine Kreatur, die ein Gegner kontrolliert, das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die du kontrollierst, übernimm die Kontrolle über diese Kreatur, solange du die Willensbrecherin kontrollierst.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Kontrolliere deine Gedanken, sonst werde ich es für dich tun."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399333&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a39ab20-0ad5-41d2-8e85-f88386bdb9c5\', \'multiverseId\': 399333}, \'multiverseid\': 399333}, {\'name\': \'Rompevoluntades\', \'text\': \'Siempre que una criatura que controla un oponente sea el objetivo de un hechizo o habilidad que controlas, gana el control de esa criatura mientras controles el Rompevoluntades.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Domina tu mente, o la dominaré yo en tu lugar".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd3eadfc-136e-4b48-8339-39914ca2a9fb\', \'multiverseId\': 401272}, \'multiverseid\': 401272}, {\'name\': \'Briseur de volonté\', \'text\': "À chaque fois qu\'une créature qu\'un adversaire contrôle devient la cible d\'un sort ou d\'une capacité que vous contrôlez, acquérez le contrôle de cette créature tant que vous contrôlez le Briseur de volonté.", \'type\': \'Créature : humain et sorcier\', \'flavor\': \'« Contrôle ton esprit, ou je le contrôlerai pour toi. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399610&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca6b5d74-4559-40b8-bed2-358610d15ab7\', \'multiverseId\': 399610}, \'multiverseid\': 399610}, {\'name\': \'Asservitrice\', \'text\': "Ogniqualvolta una creatura controllata da un avversario diventa bersaglio di una magia o abilità che controlli, prendi il controllo di quella creatura fintanto che controlli l\'Asservitrice.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Domina la tua mente o lo farò io per te."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cf6f0780-99fb-441c-84f0-8b38f0772c84\', \'multiverseId\': 399887}, \'multiverseid\': 399887}, {\'name\': \'意志を砕く者\', \'text\': \'対戦相手がコントロールするクリーチャー１体があなたのコントロールする呪文や能力の対象になるたび、あなたが意志を砕く者をコントロールし続けているかぎり、それのコントロールを得る。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'「己の精神を掌握しなさい。さもなくば私が掌握して差し上げますよ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400164&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b47bc8b3-bfcb-4681-a9b8-801e6600ea1c\', \'multiverseId\': 400164}, \'multiverseid\': 400164}, {\'name\': \'의지를 굴복시키는 자\', \'text\': \'상대가 조종하는 생물이 당신이 조종하는 주문이나 능력의 목표가 될 때마다, 당신이 의지를 굴복시키는 자를 조종하는 한, 그 생물의 조종권을 얻는다.\', \'type\': \'생물 — 인간 마법사\', \'flavor\': \'"네 마음을 다스려라. 그렇지 않으면 내가 네 마음을 다스리겠다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400441&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a038616b-2b95-4c88-8986-73cfe5a2f7d6\', \'multiverseId\': 400441}, \'multiverseid\': 400441}, {\'name\': \'Quebrador de Vontades\', \'text\': \'Toda vez que uma criatura que um oponente controla se tornar alvo de uma mágica ou habilidade que você controla, você ganhará o controle daquela criatura enquanto controlar Quebrador de Vontades.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'"Domine sua mente ou eu a dominarei por você."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400718&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa366ab1-cb76-4efd-ac87-219fb838660c\', \'multiverseId\': 400718}, \'multiverseid\': 400718}, {\'name\': \'Ломающая Волю\', \'text\': \'Каждый раз, когда существо под контролем оппонента становится целью заклинания или способности под вашим контролем, получите контроль над тем существом на все время, пока вы контролируете Ломающую Волю.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Контролируй свой разум, или контролировать его буду я».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400995&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'37f7afd1-dbe2-4971-b550-ac65e9623aa1\', \'multiverseId\': 400995}, \'multiverseid\': 400995}, {\'name\': \'破志师\', \'text\': \'每当一个由对手操控的生物成为由你操控之咒语或异能的目标时，于你操控破志师的时段内，获得该生物的操控权。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「掌控你的心智，不然我就替你掌控。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398779&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'84871fe7-0166-468d-b8c3-aa90b1a96fc7\', \'multiverseId\': 398779}, \'multiverseid\': 398779}, {\'name\': \'破志師\', \'text\': \'每當一個由對手操控的生物成為由你操控之咒語或異能的目標時，於你操控破志師的時段內，獲得該生物的操控權。\', \'type\': \'生物～人類／魔法師\', \'flavor\': \'「掌控你的心智，不然我就替你掌控。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399056&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'36779f27-af3e-439a-a608-e7d136f3b1e0\', \'multiverseId\': 399056}, \'multiverseid\': 399056}]', "[{'name': 'Wirbler-Räuberin', 'text': 'Wenn die Wirbler-Räuberin ins Spiel kommt, bringe zwei 1/1 farblose Thopter-Artefaktkreaturenspielsteine mit Flugfähigkeit ins Spiel.Tappe zwei ungetappte Artefakte, die du kontrollierst: Eine Kreatur deiner Wahl kann in diesem Zug nicht geblockt werden.', 'type': 'Kreatur — Mensch, Räuber, Handwerker', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399241&type=card', 'language': 'German', 'identifiers': {'scryfallId': '76f315b9-4c74-4865-811b-643630684df8', 'multiverseId': 399241}, 'multiverseid': 399241}, {'name': 'Bribona de los zumbones', 'text': 'Cuando la Bribona de los zumbones entre al campo de batalla, pon en el campo de batalla dos fichas de criatura artefacto Tóptero incoloras 1/1 con la habilidad de volar.Girar dos artefactos enderezados que controlas: La criatura objetivo no puede ser bloqueada este turno.', 'type': 'Criatura — Artífice bribón humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401180&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '19fa75a1-592f-43e0-8729-4b2ee05e670e', 'multiverseId': 401180}, 'multiverseid': 401180}, {'name': 'Gredine à voltigeurs', 'text': 'Quand la Gredine à voltigeurs arrive sur le champ de bataille, mettez sur le champ de bataille deux jetons de créature-artefact 1/1 incolore Mécanoptère avec le vol.Engagez deux artefacts dégagés que vous contrôlez : la créature ciblée ne peut pas être bloquée ce tour-ci.', 'type': 'Créature : humain et gredin et artificier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399518&type=card', 'language': 'French', 'identifiers': {'scryfallId': '800100b2-89ac-414d-8503-f8b0fb0431ac', 'multiverseId': 399518}, 'multiverseid': 399518}, {'name': 'Canaglia dei Turbinanti', 'text': 'Quando la Canaglia dei Turbinanti entra nel campo di battaglia, metti sul campo di battaglia due pedine creatura artefatto Tottero 1/1 incolori con volare.TAPpa due artefatti STAPpati che controlli: Una creatura bersaglio non può essere bloccata in questo turno.', 'type': 'Creatura — Artefice Farabutto Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399795&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9d3070be-bbec-47c9-bec3-b071e15fda47', 'multiverseId': 399795}, 'multiverseid': 399795}, {'name': 'つむじ風のならず者', 'text': 'つむじ風のならず者が戦場に出たとき、飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを２体戦場に出す。あなたがコントロールするアンタップ状態のアーティファクトを２つタップする：クリーチャー１体を対象とする。このターン、それはブロックされない。', 'type': 'クリーチャー — 人間・ならず者・工匠', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400072&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6d24acd1-ff6a-4d8b-b0a7-b6f59530c09f', 'multiverseId': 400072}, 'multiverseid': 400072}, {'name': '돌개 부리는 도적', 'text': '돌개 부리는 도적이 전장에 들어올 때, 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰 두 개를 전장에 놓는다.당신이 조종하는 언탭된 마법물체 두 개를 탭한다: 생물을 목표로 정한다. 그 생물은 이 턴에 방어될 수 없다.', 'type': '생물 — 인간 도적 기능공', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400349&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '1439b9f9-6a4e-4ce3-ae38-b97402f8cd66', 'multiverseId': 400349}, 'multiverseid': 400349}, {'name': 'Ladra dos Turbilinos', 'text': 'Quando Ladra dos Turbilinos entrar no campo de batalha, coloque no campo de batalha duas fichas de criatura artefato incolor 1/1 do tipo Tóptero com voar.Vire dois artefatos desvirados que você controla: A criatura alvo não pode ser bloqueada neste turno.', 'type': 'Criatura — Humano Ladino Artesão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400626&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7bdb0118-e768-4d0a-b920-4996de50e2c0', 'multiverseId': 400626}, 'multiverseid': 400626}, {'name': 'Разбойница с Махолетами', 'text': 'Когда Разбойница с Махолетами выходит на поле битвы, положите на поле битвы две фишки артефакта существа 1/1 бесцветный Топтер с Полетом.Поверните два неповернутых артефакта под вашим контролем: целевое существо не может быть заблокировано в этом ходу.', 'type': 'Существо — Человек Бродяга Механик', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400903&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e8de8f62-8062-4348-a039-239b90fc1e9a', 'multiverseId': 400903}, 'multiverseid': 400903}, {'name': '旋翼浪客', 'text': '当旋翼浪客进战场时，将两个1/1无色，具飞行异能的振翼机衍生神器生物放进战场。横置两个由你操控且未横置的神器：目标生物本回合不能被阻挡。', 'type': '生物～人类／浪客／神器师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398687&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '09ee9843-6991-4cfe-9950-56b3d7dbc600', 'multiverseId': 398687}, 'multiverseid': 398687}, {'name': '旋翼浪客', 'text': '當旋翼浪客進戰場時，將兩個1/1無色，具飛行異能的振翼機衍生神器生物放進戰場。橫置兩個由你操控且未橫置的神器：目標生物本回合不能被阻擋。', 'type': '生物～人類／浪客／神器師', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398964&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ed099be4-6a7f-4e44-94ab-325f32931517', 'multiverseId': 398964}, 'multiverseid': 398964}]", '[{\'name\': \'Wolf des Waldrudels\', \'text\': \'Der Wolf des Waldrudels erhält +1/+1 für jede andere Kreatur namens Wolf des Waldrudels, die du kontrollierst.\', \'type\': \'Kreatur — Wolf\', \'flavor\': \'Ihre Stärke liegt nicht allein in ihrer Zahl. Eine nicht greifbare Macht verstärkt die Wölfe, wenn sie im Rudel jagen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399276&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d222e63-93e4-41d9-8fb0-72d116e783ca\', \'multiverseId\': 399276}, \'multiverseid\': 399276}, {\'name\': \'Lobo manada de madera\', \'text\': \'El Lobo manada de madera obtiene +1/+1 por cada otra criatura que controlas llamada Lobo manada de madera.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'Su fuerza no es solo cuestión de números. Un poder intangible potencia a los lobos cuando corren juntos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401215&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ebaefbfe-1709-4ac9-b56e-788bc494fa8d\', \'multiverseId\': 401215}, \'multiverseid\': 401215}, {\'name\': \'Loup de la meute des forêts\', \'text\': \'Le Loup de la meute des forêts gagne +1/+1 pour chaque autre créature que vous contrôlez appelée Loup de la meute des forêts.\', \'type\': \'Créature : loup\', \'flavor\': "Leur force ne se limite pas à leur nombre. Une puissance intangible s\'empare des loups quand ils sont en meute.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399553&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9259cc5f-1f6b-4d70-a0b8-fb5683a8e4a2\', \'multiverseId\': 399553}, \'multiverseid\': 399553}, {\'name\': \'Lupo di Legnobranco\', \'text\': \'Il Lupo di Legnobranco prende +1/+1 per ogni altra creatura che controlli chiamata Lupo di Legnobranco.\', \'type\': \'Creatura — Lupo\', \'flavor\': "La loro forza non è una semplice questione di numeri. Un\'energia intangibile potenzia i lupi quando corrono insieme.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399830&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b10067a6-0fc1-4fc4-a491-be7e645d9842\', \'multiverseId\': 399830}, \'multiverseid\': 399830}, {\'name\': \'森林群れの狼\', \'text\': \'森林群れの狼は、他のあなたがコントロールする「森林群れの狼」という名前のクリーチャー１体につき＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — 狼\', \'flavor\': \'その力は、数の力に頼んだものだけではない。共に走ることで、目に見えない力が狼たちを増補するのである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400107&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb809669-e0d4-4151-9136-9ab7b7b3404c\', \'multiverseId\': 400107}, \'multiverseid\': 400107}, {\'name\': \'얼룩떼 늑대\', \'text\': \'얼룩떼 늑대는 당신이 조종하는 다른 생물 중 얼룩떼 늑대라는 이름을 가진 생물 한 개당 +1/+1을 받는다.\', \'type\': \'생물 — 늑대\', \'flavor\': \'얼룩떼 늑대는 단지 숫자가 많아서 무서운 것이 아니다. 이들이 무리를 지으면 보이지 않는 힘이 이들을 강화한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400384&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'0c55e12d-6e32-4334-bd8f-3c25ce408845\', \'multiverseId\': 400384}, \'multiverseid\': 400384}, {\'name\': \'Lobo da Alcateia do Arvoredo\', \'text\': \'Lobo da Alcateia do Arvoredo recebe +1/+1 para cada outra criatura com o nome Lobo da Alcateia do Arvoredo que você controle.\', \'type\': \'Criatura — Lobo\', \'flavor\': \'A força deles não é uma mera questão de números. Uma força intangível aprimora os lobos quando eles correm juntos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400661&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e1b22457-18fb-4439-a74e-8549a1122af5\', \'multiverseId\': 400661}, \'multiverseid\': 400661}, {\'name\': \'Волк Лесной Стаи\', \'text\': \'Волк Лесной Стаи получает +1/+1 за каждое другое существо с именем Волк Лесной Стаи под вашим контролем.\', \'type\': \'Существо — Волк\', \'flavor\': \'Их мощь — не просто в количестве. Неосязаемая сила укрепляет каждого из волков, когда они бегут друг рядом с другом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400938&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a5cb1c75-fafe-4499-914d-bcca490d0949\', \'multiverseId\': 400938}, \'multiverseid\': 400938}, {\'name\': \'林群狼\', \'text\': \'你每操控一个名称为林群狼的其他生物，林群狼便得+1/+1。\', \'type\': \'生物～狼\', \'flavor\': \'它们的力量不只是数字游戏。当狼群一起奔跑时，有种无形影响会让它们更加强大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398722&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1a65558e-12eb-440e-998d-f70d32a43ae9\', \'multiverseId\': 398722}, \'multiverseid\': 398722}, {\'name\': \'林群狼\', \'text\': \'你每操控一個名稱為林群狼的其他生物，林群狼便得+1/+1。\', \'type\': \'生物～狼\', \'flavor\': \'牠們的力量不只是數字遊戲。當狼群一起奔跑時，有種無形影響會讓牠們更加強大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398999&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9661e612-2711-4c1c-a2d7-a010ed3fc04c\', \'multiverseId\': 398999}, \'multiverseid\': 398999}]', '[{\'name\': \'Wurfmesser\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+0.Immer wenn die ausgerüstete Kreatur angreift, kannst du das Wurfmesser opfern. Falls du dies tust, fügt das Wurfmesser einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.Ausrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399426&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a9813d9-e8a6-4af4-b878-6d38755f9ea2\', \'multiverseId\': 399426}, \'multiverseid\': 399426}, {\'name\': \'Cuchillo arrojadizo\', \'text\': \'La criatura equipada obtiene +2/+0.Siempre que la criatura equipada ataque, puedes sacrificar el Cuchillo arrojadizo. Si lo haces, el Cuchillo arrojadizo hace 2 puntos de daño a la criatura o jugador objetivo.Equipar {2}. ({2}: Anexa este equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401365&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44e50316-bcb0-4c57-a407-eb59a284a60d\', \'multiverseId\': 401365}, \'multiverseid\': 401365}, {\'name\': \'Couteau de lancer\', \'text\': "La créature équipée gagne +2/+0.À chaque fois que la créature équipée attaque, vous pouvez sacrifier le Couteau de lancer. Si vous faites ainsi, le Couteau de lancer inflige 2 blessures à une cible, créature ou joueur.Équipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399703&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0c7c1eb-ef11-458a-b771-7325f3745ed8\', \'multiverseId\': 399703}, \'multiverseid\': 399703}, {\'name\': \'Coltello da Lancio\', \'text\': \'La creatura equipaggiata prende +2/+0.Ogniqualvolta la creatura equipaggiata attacca, puoi sacrificare il Coltello da Lancio. Se lo fai, il Coltello da Lancio infligge 2 danni a una creatura o a un giocatore bersaglio.Equipaggiare {2} ({2}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd4ac2cb-a422-4a15-85c4-0b71fcd0f9c7\', \'multiverseId\': 399980}, \'multiverseid\': 399980}, {\'name\': \'投げナイフ\', \'text\': \'装備しているクリーチャーは＋２/＋０の修整を受ける。装備しているクリーチャーが攻撃するたび、クリーチャー１体かプレイヤー１人を対象とする。あなたは投げナイフを生け贄に捧げてもよい。そうしたなら、投げナイフはそれに２点のダメージを与える。装備{2}（{2}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400257&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'306749c8-7caa-415e-a2e8-327362bbbe9b\', \'multiverseId\': 400257}, \'multiverseid\': 400257}, {\'name\': \'투척용 단검\', \'text\': \'장착된 생물은 +2/+0을 받는다.장착된 생물이 공격할 때마다, 당신은 투척용 단검을 희생할 수 있다. 그렇게 한다면, 생물이나 플레이어를 목표로 정한다. 투척용 단검은 그 목표에 피해 2점을 입힌다.장착 {2} ({2}: 당신이 조종하는 생물 한 개를 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400534&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'50b36eca-1071-4240-b6c0-edf17745e8b0\', \'multiverseId\': 400534}, \'multiverseid\': 400534}, {\'name\': \'Faca de Arremesso\', \'text\': \'A criatura equipada recebe +2/+0.Toda vez que a criatura equipada ataca, você pode sacrificar Faca de Arremesso. Se fizer isso, Faca de Arremesso causará 2 pontos de dano à criatura ou ao jogador alvo.Equipar {2} ({2}: Anexe à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400811&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dadc8d61-9d34-4957-bdd8-87cb39178b8b\', \'multiverseId\': 400811}, \'multiverseid\': 400811}, {\'name\': \'Метательный Кинжал\', \'text\': \'Снаряженное существо получает +2/+0.Каждый раз, когда снаряженное существо атакует, вы можете пожертвовать Метательный Кинжал. Если вы это делаете, Метательный Кинжал наносит 2 повреждения целевому существу или игроку.Снарядить {2} ({2}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401088&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d317fa4-be03-4da2-86f7-3daacc0ce659\', \'multiverseId\': 401088}, \'multiverseid\': 401088}, {\'name\': \'飞刀\', \'text\': \'佩带此武具的生物得+2/+0。每当佩带此武具的生物攻击时，你可以牺牲飞刀。若你如此作，则飞刀对目标生物或牌手造成2点伤害。佩带{2}（{2}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398872&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16bdab91-b742-4627-a8e0-696d6cfe7240\', \'multiverseId\': 398872}, \'multiverseid\': 398872}, {\'name\': \'飛刀\', \'text\': \'佩帶此武具的生物得+2/+0。每當佩帶此武具的生物攻擊時，你可以犧牲飛刀。若你如此作，則飛刀對目標生物或玩家造成2點傷害。佩帶{2}（{2}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399149&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d60e8930-74f6-4c5e-ab4e-3c75f14e784f\', \'multiverseId\': 399149}, \'multiverseid\': 399149}]', '[{\'name\': \'Wächter von Meletis\', \'text\': \'Verteidiger (Diese Kreatur kann nicht angreifen.)\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Die Historiker sprechen von zwei verfeindeten Herrschern, deren Tode gefeiert wurden, und deren Monumente das Ende ihrer Kriege symbolisieren. In Wahrheit waren sie friedliche Liebende, doch ihre Geschichte ging mit den Jahrhunderten verloren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399384&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca5f80b0-b6a1-4318-ab99-59ef302d786f\', \'multiverseId\': 399384}, \'multiverseid\': 399384}, {\'name\': \'Guardianes de Meletis\', \'text\': \'Defensor. (Esta criatura no puede atacar.)\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Las historias hablan de dos gobernantes enfrentados, cuyas muertes se celebraron y cuyos monumentos simbolizaron el fin de sus guerras. En realidad fueron pacíficos amantes, cuya historia cayó en el olvido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401323&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6c795289-78f1-4f44-bac6-e3ea471b503d\', \'multiverseId\': 401323}, \'multiverseid\': 401323}, {\'name\': \'Vigiles de Mélétis\', \'text\': \'Défenseur (Cette créature ne peut pas attaquer.)\', \'type\': \'Créature-artefact : golem\', \'flavor\': "Les historiens évoquent deux potentats ennemis dont la mort fut célébrée par deux monuments symbolisant la fin de leurs conflits. En réalité, il s\'agissait de deux amants paisibles dont l\'histoire s\'est perdue au fil du temps.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399661&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f51ec689-3876-4e78-a5bd-7200c70cd4b7\', \'multiverseId\': 399661}, \'multiverseid\': 399661}, {\'name\': \'Guardiani di Meletis\', \'text\': \'Difensore (Questa creatura non può attaccare.)\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'Le cronache parlano della faida tra due regnanti, le cui morti furono celebrate e i cui monumenti funebri simboleggiavano la fine delle loro guerre. In realtà erano pacifici amanti e la loro vera storia è andata perduta nelle pieghe del tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399938&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a164f8b-a3f1-43ae-b8cd-fb334eb4f039\', \'multiverseId\': 399938}, \'multiverseid\': 399938}, {\'name\': \'メレティスの守護者\', \'text\': \'防衛（このクリーチャーでは攻撃できない。）\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'歴史では諍い合う２人の統治者がおり、その者たちの死が祝福され、彼らの記念碑が争いの終わりの象徴となったと伝わっている。本当は２人は平和的な恋人同士であったという史実は時の流れの中で喪失してしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400215&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63ddaa37-11f6-44f6-9cb7-38000ebb576f\', \'multiverseId\': 400215}, \'multiverseid\': 400215}, {\'name\': \'멜레티스의 수호자\', \'text\': \'수비태세 (이 생물은 공격할 수 없다.)\', \'type\': \'마법물체 생물 — 골렘\', \'flavor\': \'사서에 의하면 이 동상들은 서로 전쟁을 일삼던 두 군주가 죽었을 때 백성들이 종전을 기념하여 세운 것이라고 한다. 하지만 사실 동상의 주인공은 사랑하는 연인 사이로, 그 진실이 역사 속에서 잊혀졌을 뿐이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400492&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9408cdbd-e6ad-47a6-8ec6-ea819c261462\', \'multiverseId\': 400492}, \'multiverseid\': 400492}, {\'name\': \'Guardiões de Meletis\', \'text\': \'Defensor (Esta criatura não pode atacar.)\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'As histórias falam de dois governantes em disputa, cujas mortes foram celebradas e cujos monumentos simbolizaram o fim de suas guerras. Na verdade, eram dois amantes pacíficos, cuja história se perdeu no tempo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'729d9aa8-a77c-4039-8d08-151b68f1d956\', \'multiverseId\': 400769}, \'multiverseid\': 400769}, {\'name\': \'Стражи Мелетиды\', \'text\': \'Защитник (Это существо не может атаковать.)\', \'type\': \'Артефакт Существо — Голем\', \'flavor\': \'Легенды рассказывают о двух враждующих правителях, после смерти которых люди воздвигли этот монумент в ознаменование окончания войны. На самом же деле это были миролюбивые влюбленные, чья история потерялась в глубине веков.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401046&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'336d3101-db33-476a-a77d-7b4c6d05e90b\', \'multiverseId\': 401046}, \'multiverseid\': 401046}, {\'name\': \'迈勒提斯守护者\', \'text\': \'守军（此生物不能攻击。）\', \'type\': \'神器生物～魔像\', \'flavor\': \'史书论及两位长期争斗的世仇君王，他们离世时人民无不额手称庆，以其纪念碑象征着战争结束。史实却刚好相反：他们彼此友爱且天下太平，但其故事早随时间长河亡佚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398830&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'93b80f73-2492-4abb-9e2d-e8b46733e4ec\', \'multiverseId\': 398830}, \'multiverseid\': 398830}, {\'name\': \'邁勒提斯守護者\', \'text\': \'守軍（此生物不能攻擊。）\', \'type\': \'神器生物～魔像\', \'flavor\': \'史書論及兩位長期爭鬥的世仇君王，他們離世時人民無不額手稱慶，以其紀念碑象徵著戰爭結束。史實卻剛好相反：他們彼此友愛且天下太平，但其故事早隨時間長河亡佚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399107&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ef158c47-2fa3-4e41-98e4-723630392020\', \'multiverseId\': 399107}, \'multiverseid\': 399107}]', '[{\'name\': \'Wächterin der Ewigen Wache\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)Tappe zu Beginn des Kampfes im Zug jedes Gegners eine Kreatur deiner Wahl, die dieser Spieler kontrolliert.\', \'type\': \'Kreatur — Riese, Soldat\', \'flavor\': \'Das Fallgatter ist überflüssig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399490&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d354acb-6618-4049-9f27-1fdbf96d4bcb\', \'multiverseId\': 399490}, \'multiverseid\': 399490}, {\'name\': \'Centinela de la guardia eterna\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)Al comienzo del combate en el turno de cada oponente, gira la criatura objetivo que controla ese jugador.\', \'type\': \'Criatura — Soldado gigante\', \'flavor\': \'La verja levadiza es superflua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'861abe79-bf3d-46f6-9517-49d0a2abca9b\', \'multiverseId\': 401429}, \'multiverseid\': 401429}, {\'name\': \'Sentinelle des veilleurs éternels\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)Au début du combat pendant le tour de chaque adversaire, engagez une créature ciblée que ce joueur contrôle.", \'type\': \'Créature : géant et soldat\', \'flavor\': \'La herse est superflue.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399767&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec894969-75aa-4c88-a7ba-5795f8c11b11\', \'multiverseId\': 399767}, \'multiverseid\': 399767}, {\'name\': \'Sentinella della Guardia Eterna\', \'text\': "Cautela (Questa creatura attacca senza TAPpare.)All\'inizio del combattimento nel turno di ogni avversario, TAPpa una creatura bersaglio controllata da quel giocatore.", \'type\': \'Creatura — Soldato Gigante\', \'flavor\': \'La saracinesca è superflua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400044&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'016d7d88-48d7-4641-9e28-f4582349680f\', \'multiverseId\': 400044}, \'multiverseid\': 400044}, {\'name\': \'永遠警備の歩哨\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）各対戦相手のターンの戦闘の開始時に、そのプレイヤーがコントロールするクリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 巨人・兵士\', \'flavor\': \'落とし格子など不要である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400321&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6e91513c-a1cd-49e9-b9c5-abd312075b0e\', \'multiverseId\': 400321}, \'multiverseid\': 400321}, {\'name\': \'영겁의 감시단 보초\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)각 상대 턴의 전투 시작에, 그 플레이어가 조종하는 생물을 목표로 정한다. 그 생물을 탭한다.\', \'type\': \'생물 — 거인 병사\', \'flavor\': \'쇠창살문은 약간 지나친 감이 있군.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400598&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f1406217-115a-4cb7-adec-3b4093b495a2\', \'multiverseId\': 400598}, \'multiverseid\': 400598}, {\'name\': \'Sentinela da Vigília Eterna\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)No início do combate no turno de cada oponente, vire a criatura alvo que aquele jogador controla.\', \'type\': \'Criatura — Gigante Soldado\', \'flavor\': \'A ponte levadiça não faz diferença.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400875&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d98cd048-21a9-4072-99fc-d64c42ac84d9\', \'multiverseId\': 400875}, \'multiverseid\': 400875}, {\'name\': \'Стражница Вечного Дозора\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)В начале боя во время хода каждого из оппонентов поверните целевое существо под контролем того игрока.\', \'type\': \'Существо — Гигант Солдат\', \'flavor\': \'Решетка ворот — излишняя предосторожность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401152&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'96068b92-b21d-4078-a282-3a126a8ffd43\', \'multiverseId\': 401152}, \'multiverseid\': 401152}, {\'name\': \'恒卫哨兵\', \'text\': \'警戒（此生物攻击时不需横置。）在每位对手回合的战斗开始时，横置目标由该牌手操控的生物。\', \'type\': \'生物～巨人／士兵\', \'flavor\': \'城堡铁栅纯属摆设。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398936&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d91f0d5c-5823-4b00-8943-fb19baa59867\', \'multiverseId\': 398936}, \'multiverseid\': 398936}, {\'name\': \'恆衛哨兵\', \'text\': \'警戒（此生物攻擊時不需橫置。）在每位對手回合的戰鬥開始時，橫置目標由該玩家操控的生物。\', \'type\': \'生物～巨人／士兵\', \'flavor\': \'城堡鐵柵純屬擺設。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399213&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'be268803-376c-4cfb-a7ce-ed0ba3c63af9\', \'multiverseId\': 399213}, \'multiverseid\': 399213}]', "[{'name': 'Yavimayaküste', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.{T}: Erhöhe deinen Manavorrat um {G} oder {U}. Die Yavimayaküste fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399397&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a8b29a21-e396-4234-91fd-6aa5d3ccea33', 'multiverseId': 399397}, 'multiverseid': 399397}, {'name': 'Costa de Yavimaya', 'text': '{T}: Agrega {1} a tu reserva de maná.{T}: Agrega {G} o {U} a tu reserva de maná. La Costa de Yavimaya te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401336&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '892e7d10-d27f-4998-b2f5-5e202e3c4777', 'multiverseId': 401336}, 'multiverseid': 401336}, {'name': 'Côte de la Yavimaya', 'text': '{T} : Ajoutez {1} à votre réserve.{T} : Ajoutez {G} ou {U} à votre réserve. La Côte de la Yavimaya vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399674&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6d93c5b4-3603-404b-bac0-a1225627bc13', 'multiverseId': 399674}, 'multiverseid': 399674}, {'name': 'Costa di Yavimaya', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.{T}: Aggiungi {G} o {U} alla tua riserva di mana. La Costa di Yavimaya ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399951&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '800d60ce-f192-4f06-90a1-e1cadc1ec1f3', 'multiverseId': 399951}, 'multiverseid': 399951}, {'name': 'ヤヴィマヤの沿岸', 'text': '{T}：あなたのマナ・プールに{1}を加える。{T}：あなたのマナ・プールに{G}か{U}を加える。ヤヴィマヤの沿岸はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400228&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e306d856-789b-4803-b177-80c865d696d4', 'multiverseId': 400228}, 'multiverseid': 400228}, {'name': '야비마야의 해변', 'text': '{T}: {1}을 당신의 마나풀에 담는다.{T}: {G} 또는 {U}를 당신의 마나풀에 담는다. 야비마야의 해변은 당신에게 피해 1점을 입힌다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400505&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'c4c878d1-16e3-42e8-8977-825d95a351c8', 'multiverseId': 400505}, 'multiverseid': 400505}, {'name': 'Costa de Yavimaya', 'text': '{T}: Adicione {1} à sua reserva de mana.{T}: Adicione {G} ou {U} à sua reserva de mana. Costa de Yavimaya causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400782&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '515a77b3-20f5-4b8c-8ac7-70f1e12cc1ec', 'multiverseId': 400782}, 'multiverseid': 400782}, {'name': 'Явимайское Побережье', 'text': '{T}: добавьте {1} в ваше хранилище маны.{T}: добавьте {G} или {U} в ваше хранилище маны. Явимайское Побережье наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401059&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd4b09b7d-cb43-4d61-b088-92db2b14cf8f', 'multiverseId': 401059}, 'multiverseid': 401059}, {'name': '亚维马雅海岸', 'text': '{T}：加{1}到你的法术力池中。{T}：加{G}或{U}到你的法术力池中。亚维马雅海岸对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398843&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '004fb96f-d41b-43a0-a918-4ab43ceb640b', 'multiverseId': 398843}, 'multiverseid': 398843}, {'name': '亞維馬雅海岸', 'text': '{T}：加{1}到你的魔法力池中。{T}：加{G}或{U}到你的魔法力池中。亞維馬雅海岸對你造成1點傷害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399120&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '4a592de3-b61a-43c5-8f6a-c73ee61f887b', 'multiverseId': 399120}, 'multiverseid': 399120}]", '[{\'name\': \'Yevas Kraftmagier\', \'text\': \'Wenn Yevas Kraftmagier ins Spiel kommt, erhält eine Kreatur deiner Wahl +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Die Natur kann nicht aufgehalten werden. Sie reißt an Ravnicas höchsten Gebäuden herum, um mehr Sonne zu bekommen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399255&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d775d78b-f3c0-408c-83ef-6e6a5c7e9531\', \'multiverseId\': 399255}, \'multiverseid\': 399255}, {\'name\': \'Magofuerza de Yeva\', \'text\': \'Cuando el Magofuerza de Yeva entre al campo de batalla, la criatura objetivo obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"No se puede detener a la naturaleza. Quiebra y rasga los edificios más altos de Rávnica para reclamar su lugar en el sol".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401194&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27527bbc-1764-401c-8db0-56fda7c551bb\', \'multiverseId\': 401194}, \'multiverseid\': 401194}, {\'name\': \'Mageforce de Yeva\', \'text\': "Quand le Mageforce de Yeva arrive sur le champ de bataille, la créature ciblée gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et shamane\', \'flavor\': \'« La nature est inexorable. Elle étrangle les plus hautes tours de Ravnica pour recouvrer sa place au soleil. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8af66aab-4eb8-4199-9a72-bd6bcac38de1\', \'multiverseId\': 399532}, \'multiverseid\': 399532}, {\'name\': \'Mago della Forza di Yeva\', \'text\': \'Quando il Mago della Forza di Yeva entra nel campo di battaglia, una creatura bersaglio prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"La natura non può essere fermata. Trancia e squarcia gli edifici più alti di Ravnica per reclamare il proprio posto al sole."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399809&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e6da8c1-e403-4939-8056-5ffde0634ba0\', \'multiverseId\': 399809}, \'multiverseid\': 399809}, {\'name\': \'イェヴァの腕力魔道士\', \'text\': \'イェヴァの腕力魔道士が戦場に出たとき、クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「自然は立ち止まらない。ラヴニカ最大の建物をも引き裂き、引きちぎって、太陽目指して伸びていくのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400086&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5cfd92f-9cba-4371-8c5a-d4db86b7880d\', \'multiverseId\': 400086}, \'multiverseid\': 400086}, {\'name\': \'예바의 완력술사\', \'text\': \'예바의 완력술사가 전장에 들어올 때, 생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다.\', \'type\': \'생물 — 엘프 주술사\', \'flavor\': \'"자연은 태양을 보기 위하여 라브니카의 건물들을 부숴버릴 것이다. 그것을 막을 수 있는 자는 아무도 없다."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400363&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'65af6ac1-0a1b-425d-81cb-90f30c7d3cb8\', \'multiverseId\': 400363}, \'multiverseid\': 400363}, {\'name\': \'Mago da Força de Yeva\', \'text\': \'Quando Mago da Força de Yeva entra no campo de batalha, a criatura alvo recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"A natureza não pode ser detida. Ela rompe e rasga tudo em seu caminho até a construção mais alta de Ravnica para reivindicar seu lugar ao sol."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400640&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48761543-4cc7-4a07-bfec-387a6ba45a26\', \'multiverseId\': 400640}, \'multiverseid\': 400640}, {\'name\': \'Природомаг Йевы\', \'text\': \'Когда Природомаг Йевы выходит на поле битвы, целевое существо получает +2/+2 до конца хода.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«Природу невозможно остановить. Она крушит и ломает самые высокие здания в Равнике, чтобы найти себе место под солнцем».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400917&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a57e7e40-b36b-4704-a483-463e838a461b\', \'multiverseId\': 400917}, \'multiverseid\': 400917}, {\'name\': \'叶娃的力法师\', \'text\': \'当叶娃的力法师进战场时，目标生物得+2/+2直到回合结束。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'「大自然无法阻抗。他将拉尼卡最高耸的建筑扯坏拉倒，在太阳底下挣回地盘。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398701&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39552910-0e12-427b-8747-ee16abe29a68\', \'multiverseId\': 398701}, \'multiverseid\': 398701}, {\'name\': \'葉娃的力法師\', \'text\': \'當葉娃的力法師進戰場時，目標生物得+2/+2直到回合結束。\', \'type\': \'生物～妖精／祭師\', \'flavor\': \'「大自然無法阻抗。他將拉尼卡最高聳的建築扯壞拉倒，在太陽底下掙回地盤。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398978&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2d773a86-2444-4773-ab36-fe4153c848f7\', \'multiverseId\': 398978}, \'multiverseid\': 398978}]', '[{\'name\': \'Zendikars Turbulenz\', \'text\': \'Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt, bringe einen 2/2 grünen Elementarwesen-Kreaturenspielstein ins Spiel.\', \'type\': \'Verzauberung\', \'flavor\': \'„Ich lag falsch. Zendikar ist nicht gegen mich. Es ist gegen niemanden von uns. Es ist nicht böse oder rachsüchtig. Es ist großartig … aber es hat große Schmerzen."—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399349&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a95ddf2-9215-42bd-b1b0-8cfbd7b76972\', \'multiverseId\': 399349}, \'multiverseid\': 399349}, {\'name\': \'La Turbulencia de Zendikar\', \'text\': \'Siempre que una tierra entre al campo de batalla bajo tu control, pon en el campo de batalla una ficha de criatura Elemental verde 2/2.\', \'type\': \'Encantamiento\', \'flavor\': \'"Estaba equivocada. Zendikar no me persigue. No persigue a ninguno de nosotros. No es maligno ni vengativo. Es magnífico... pero sufre".—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401288&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9bb22ea1-f22b-4e0b-a70f-b5eadf1e3946\', \'multiverseId\': 401288}, \'multiverseid\': 401288}, {\'name\': \'Roulis de Zendikar\', \'text\': "À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, mettez sur le champ de bataille un jeton de créature 2/2 verte Élémental.", \'type\': \'Enchantement\', \'flavor\': "« J\'avais tort. Zendikar ne m\'en veut pas... ni à personne d\'ailleurs. Le plan n\'est ni maléfique ni vengeur. Il est magnifique... mais il souffre. »—Nissa Revane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399626&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'baa97399-8086-4224-9d8d-9a7ce03ff203\', \'multiverseId\': 399626}, \'multiverseid\': 399626}, {\'name\': \'Torbido di Zendikar\', \'text\': \'Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, metti sul campo di battaglia una pedina creatura Elementale 2/2 verde.\', \'type\': \'Incantesimo\', \'flavor\': \'"Mi sbagliavo. Zendikar non ce l\\\'ha con me. Non ce l\\\'ha con nessuno di noi. Non è malvagio o vendicativo. È magnifico... ma sta soffrendo."—Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399903&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d04e0c62-32ca-452d-b34f-b4f37074d68c\', \'multiverseId\': 399903}, \'multiverseid\': 399903}, {\'name\': \'ゼンディカーの乱動\', \'text\': \'土地が１つあなたのコントロール下で戦場に出るたび、緑の２/２のエレメンタル・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'エンチャント\', \'flavor\': \'「私が間違っていた。ゼンディカーは私を追ってなどいない。私たちの誰かを追っているのでもない。それには邪悪も復讐心もなく、ただ、壮大で……苦しんでいるんだわ。」――ニッサ・レヴェイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400180&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'35b2191b-6291-4728-8634-428334b77a75\', \'multiverseId\': 400180}, \'multiverseid\': 400180}, {\'name\': \'젠디카르의 탁류\', \'text\': \'대지가 당신의 조종하에 전장에 들어올 때마다, 2/2 녹색 정령 생물 토큰 한 개를 전장에 놓는다.\', \'type\': \'부여마법\', \'flavor\': \'내가 틀렸어요. 젠디카르는 날 쫓는 게 아닙니다. 우리 중 누구를 쫓는 것도 아니에요. 젠디카르가 악하다거나 복수를 원하는 것도 아니고요. 젠디카르는 웅장하지만... 고통에 시달리고 있어요."—니사 레베인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400457&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'67d5c955-12bc-480a-bfd2-e2204ef80765\', \'multiverseId\': 400457}, \'multiverseid\': 400457}, {\'name\': \'Turbilhão de Zendikar\', \'text\': \'Toda vez que um terreno entrar no campo de batalha sob o seu controle, coloque no campo de batalha uma ficha de criatura verde 2/2 do tipo Elemental.\', \'type\': \'Encantamento\', \'flavor\': \'"Eu estava errada. Zendikar não está me perseguindo. Não está perseguindo nenhum de nós. O plano não é mau nem vingativo. É magnífico... Mas está sofrendo."— Nissa Revane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400734&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b681f36-fe02-4ff4-bd6f-60e61356333e\', \'multiverseId\': 400734}, \'multiverseid\': 400734}, {\'name\': \'Великий Вал Зендикара\', \'text\': \'Каждый раз, когда земля выходит на поле битвы под вашим контролем, положите на поле битвы одну фишку существа 2/2 зеленый Элементаль.\', \'type\': \'Чары\', \'flavor\': \'«Я ошибалась. Зендикар не держит на меня зла. Он не держит зла ни на кого. Он не жесток и не мстителен. Он великолепен... но он страдает».— Нисса Ревейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401011&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aee8b9a3-e8c1-4ddb-8669-8fccce1ffa0a\', \'multiverseId\': 401011}, \'multiverseid\': 401011}, {\'name\': \'赞迪卡的狂搅\', \'text\': \'每当一个地在你的操控下进战场时，将一个2/2绿色元素衍生生物放进战场。\', \'type\': \'结界\', \'flavor\': \'「我错了。赞迪卡找上的不是我。它根本没找上任何人。它并不邪恶，也不怀怨仇。它壮丽非凡...却饱受痛苦。」～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398795&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2fc0c6f2-6d04-4e02-b70c-88a5d5db4010\', \'multiverseId\': 398795}, \'multiverseid\': 398795}, {\'name\': \'贊迪卡的狂攪\', \'text\': \'每當一個地在你的操控下進戰場時，將一個2/2綠色元素衍生生物放進戰場。\', \'type\': \'結界\', \'flavor\': \'「我錯了。贊迪卡找上的不是我。它根本沒找上任何人。它並不邪惡，也不懷怨仇。它壯麗非凡...卻飽受痛苦。」～妮莎瑞文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399072&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'33d674f2-4343-4272-bf9d-8cecfe6590f3\', \'multiverseId\': 399072}, \'multiverseid\': 399072}]', "[{'name': 'Zügellose Blutsaugerin', 'text': 'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)Wenn die Zügellose Blutsaugerin ins Spiel kommt, verliert jeder Spieler 2 Lebenspunkte.', 'type': 'Kreatur — Vampir', 'flavor': 'Sie sucht die Straßen heim, mit gespreizten Schwingen, fauligem Atem und blutunterlaufenen Augen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399388&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd6e183b0-cf46-421c-a247-b30017c3b740', 'multiverseId': 399388}, 'multiverseid': 399388}, {'name': 'Chupasangre rabiosa', 'text': 'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)Cuando la Chupasangre rabiosa entre al campo de batalla, cada jugador pierde 2 vidas.', 'type': 'Criatura — Vampiro', 'flavor': 'Ronda las calles con las alas desplegadas, con carroña en el aliento y sangre en los ojos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401327&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'db07f82f-17d4-402e-831d-4839bd0da56a', 'multiverseId': 401327}, 'multiverseid': 401327}, {'name': 'Suceuse de sang enragée', 'text': 'Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)Quand la Suceuse de sang enragée arrive sur le champ de bataille, chaque joueur perd 2 points de vie.', 'type': 'Créature : vampire', 'flavor': 'Elle hante les rues, ailes déployées, une puanteur de charogne pour haleine et du sang dans le regard.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399665&type=card', 'language': 'French', 'identifiers': {'scryfallId': '12262d02-8fd1-4815-8ec9-8a704c3063bb', 'multiverseId': 399665}, 'multiverseid': 399665}, {'name': 'Succhiasangue Rabbiosa', 'text': 'Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)Quando la Succhiasangue Rabbiosa entra nel campo di battaglia, ogni giocatore perde 2 punti vita.', 'type': 'Creatura — Vampiro', 'flavor': 'Vaga per le strade, ad ali spiegate, il fiato putrido e gli occhi intrisi di sangue.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399942&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ee814046-8817-41d4-b8b3-1b110fc12b81', 'multiverseId': 399942}, 'multiverseid': 399942}, {'name': '狂暴な吸血者', 'text': '飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってブロックされない。）狂暴な吸血者が戦場に出たとき、各プレイヤーはそれぞれ２点のライフを失う。', 'type': 'クリーチャー — 吸血鬼', 'flavor': '彼女は翼を広く伸ばしながら道に出没する。その息は死肉臭を漂わせ、その目は赤く血走っている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400219&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8218c8f0-2468-424f-97be-b76a2d7713b2', 'multiverseId': 400219}, 'multiverseid': 400219}, {'name': '미친 흡혈귀', 'text': '비행 (이 생물은 비행이나 대공을 가진 생물에만 방어될 수 있다.)미친 흡혈귀가 전장에 들어올 때, 각 플레이어는 생명 2점을 잃는다.', 'type': '생물 — 흡혈귀', 'flavor': '그녀는 날개를 펼치고 거리를 돌아다니는데, 입에서는 구더기가 나오고 눈에서는 피가 흐른다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400496&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6b51f90a-1c90-4999-b621-48c57f92ffe7', 'multiverseId': 400496}, 'multiverseid': 400496}, {'name': 'Sugador de Sangue Raivoso', 'text': 'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)Quando Sugador de Sangue Raivoso entra no campo de batalha, cada jogador perde 2 pontos de vida.', 'type': 'Criatura — Vampiro', 'flavor': 'Ela assombra as ruas de asas abertas, com hálito de carniça e sangue nos olhos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400773&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '06e22c28-a4bf-4092-bf32-1ee62bfb2e8e', 'multiverseId': 400773}, 'multiverseid': 400773}, {'name': 'Бешеный Кровосос', 'text': 'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)Когда Бешеный Кровосос выходит на поле битвы, каждый игрок теряет 2 жизни.', 'type': 'Существо — Вампир', 'flavor': 'Широко раскинув крылья, она кружит над улицами. Ее дыхание наполнено зловонием трупов, а глаза налиты кровью.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401050&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7de75520-36da-4502-a307-3a9a9288defc', 'multiverseId': 401050}, 'multiverseid': 401050}, {'name': '狂疾吸血怪', 'text': '飞行（只有具飞行或延势异能的生物才能阻挡它。）当狂疾吸血怪进战场时，每位牌手各失去2点生命。', 'type': '生物～吸血鬼', 'flavor': '她展翅盘旋在街道之上，呼吸透着腐臭，双眼满是鲜血。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398834&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '060b56b1-1ac4-4fb7-87f1-6d74c6049435', 'multiverseId': 398834}, 'multiverseid': 398834}, {'name': '狂疾吸血怪', 'text': '飛行（只有具飛行或延勢異能的生物才能阻擋它。）當狂疾吸血怪進戰場時，每位玩家各失去2點生命。', 'type': '生物～吸血鬼', 'flavor': '她展翅盤旋在街道之上，呼吸透著腐臭，雙眼滿是鮮血。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399111&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2280e49e-c8f9-44a8-a14e-ca4bf1b7c581', 'multiverseId': 399111}, 'multiverseid': 399111}]", '[{\'name\': \'Ätzende Raupe\', \'text\': \'{1}{G}, opfere die Ätzende Raupe: Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'„Die ebenso seltenen wie schönen Schmetterlinge haben uns zum Design unserer Thopter inspiriert. Die Raupen hingegen sind eine ganz andere Geschichte."—Kiran Nalaar, Ghirapur-Erfinder\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399240&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d837f177-8bf9-451d-ab35-0157009fd9ca\', \'multiverseId\': 399240}, \'multiverseid\': 399240}, {\'name\': \'Oruga corrosiva\', \'text\': \'{1}{G}, sacrificar la Oruga corrosiva: Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Criatura — Insecto\', \'flavor\': \'"Las mariposas más bellas y raras inspiran los diseños de nuestros tópteros. Las larvas, sin embargo, son un tema completamente distinto".—Kiran Nalaar, inventor de Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401179&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f3b84ed-e7c5-410b-b099-781e48f1e2b0\', \'multiverseId\': 401179}, \'multiverseid\': 401179}, {\'name\': \'Chenille caustique\', \'text\': "{1}{G}, Sacrifiez la Chenille caustique : Détruisez l\'artefact ou l\'enchantement ciblé.", \'type\': \'Créature : insecte\', \'flavor\': "« Les papillons rares et magnifiques inspirent la conception de nos mécanoptères. Les larves, c\'est une toute autre histoire. »—Kiran Nalaàr, inventeur de Ghirapur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96c9aea7-9209-4054-92c7-847d4506ba26\', \'multiverseId\': 399517}, \'multiverseid\': 399517}, {\'name\': \'Bruco Caustico\', \'text\': \'{1}{G}, Sacrifica il Bruco Caustico: Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Creatura — Insetto\', \'flavor\': \'"Le farfalle più rare e incantevoli ci ispirano nella progettazione dei totteri. Le larve, invece, sono tutta un\\\'altra storia."—Kiran Nalaar, inventore di Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399794&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32337714-f3ad-46de-ad8e-bef911c67d56\', \'multiverseId\': 399794}, \'multiverseid\': 399794}, {\'name\': \'苛性イモムシ\', \'text\': \'{1}{G}, 苛性イモムシを生け贄に捧げる：アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'「希少で美しい蝶たちは、我々の飛行機械のデザインに着想を与えてくれる。もっとも、その幼虫はまったく別な話ではあるが。」――ギラプールの発明家、キラン・ナラー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400071&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'22bf7277-ce3b-40b8-82ce-5aa3591a86a0\', \'multiverseId\': 400071}, \'multiverseid\': 400071}, {\'name\': \'부식성 애벌레\', \'text\': \'{1}{G}, 부식성 애벌레를 희생한다: 마법물체나 부여마법을 목표로 정한다. 그 목표를 파괴한다.\', \'type\': \'생물 — 곤충\', \'flavor\': \'"희귀하고 아름다운 이 나비는 날틀을 설계하는 데 영감을 주었습니다. 하지만 이 나비의 애벌레는 완전히 다른 이야기죠."—기라푸르의 발명가 키란 날라르\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400348&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3eb8c934-6113-4c45-a60c-aafa5ed1bc59\', \'multiverseId\': 400348}, \'multiverseid\': 400348}, {\'name\': \'Lagarta Cáustica\', \'text\': \'{1}{G}, Sacrifique Lagarta Cáustica: Destrua o artefato ou encantamento alvo.\', \'type\': \'Criatura — Inseto\', \'flavor\': \'"As belas e raras borboletas inspiram o desenho de nossos tópteros. As larvas, porém, são outra história."— Kiran Nalaar, inventor de Ghirapur\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400625&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fcea66da-79f2-44da-a746-10c7c614de35\', \'multiverseId\': 400625}, \'multiverseid\': 400625}, {\'name\': \'Едкая Гусеница\', \'text\': \'{1}{G}, пожертвуйте Едкую Гусеницу: уничтожьте целевой артефакт или чары.\', \'type\': \'Существо — Насекомое\', \'flavor\': \'«Наблюдая за редкими и прекрасными бабочками, мы черпаем идеи для наших топтеров. А вот их личинки — совсем другая история».— Киран Налаар, гирапурский изобретатель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400902&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f55b7846-06b0-4756-981c-4781a5b9f81f\', \'multiverseId\': 400902}, \'multiverseid\': 400902}, {\'name\': \'腐蚀毛虫\', \'text\': \'{1}{G}，牺牲腐蚀毛虫：消灭目标神器或结界。\', \'type\': \'生物～昆虫\', \'flavor\': \'「这些罕见美丽的蝴蝶是我们设计振翼机的灵感来源。然而，它们的幼虫就另当别论。」～吉拉波发明家基岚纳拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1b3b99da-4023-4c67-ba81-fdbb5a4d9c01\', \'multiverseId\': 398686}, \'multiverseid\': 398686}, {\'name\': \'腐蝕毛蟲\', \'text\': \'{1}{G}，犧牲腐蝕毛蟲：消滅目標神器或結界。\', \'type\': \'生物～昆蟲\', \'flavor\': \'「這些罕見美麗的蝴蝶是我們設計振翼機的靈感來源。然而，牠們的幼蟲就另當別論。」～吉拉波發明家基嵐納拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398963&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'eade0ce8-fa95-4759-8b24-bd0366955769\', \'multiverseId\': 398963}, \'multiverseid\': 398963}]', '[{\'name\': \'Überragende Feuerkunst\', \'text\': \'Überragende Feuerkunst fügt einer Kreatur oder einem Spieler deiner Wahl 4 Schadenspunkte zu.Zauberkunst — Falls sich zwei oder mehr Spontanzauber- und/oder Hexerei-Karten in deinem Friedhof befinden, kann Überragende Feuerkunst nicht von Zaubersprüchen oder Fähigkeiten neutralisiert werden.\', \'type\': \'Hexerei\', \'flavor\': \'Chandras Gabe ließ sie selbst in ihrer Berufung und andere in Flammen aufgehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399344&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52f5a6ee-0e88-4634-9626-b38544d5cf6e\', \'multiverseId\': 399344}, \'multiverseid\': 399344}, {\'name\': \'Piromancia impecable\', \'text\': \'La Piromancia impecable hace 4 puntos de daño a la criatura o jugador objetivo.Dominio de hechizos — Si hay dos o más cartas de instantáneo y/o de conjuro en tu cementerio, la Piromancia impecable no puede ser contrarrestada por hechizos o habilidades.\', \'type\': \'Conjuro\', \'flavor\': \'El don de Chandra la hizo destacar y a otros arder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401283&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72e2775e-449f-4a37-9675-7e19404f72ca\', \'multiverseId\': 401283}, \'multiverseid\': 401283}, {\'name\': \'Art pyromantique admirable\', \'text\': "L\'Art pyromantique admirable inflige 4 blessures à une cible, créature ou joueur.Maîtrise de sort — S\'il y a au moins deux cartes d\'éphémère et/ou de rituel dans votre cimetière, l\'Art pyromantique admirable ne peut pas être contrecarré par des sorts ou des capacités.", \'type\': \'Rituel\', \'flavor\': "Le don de Chandra l\'isolait et consumait les autres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399621&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a9caa8dc-1d9e-4e78-beb3-8a0610828e8f\', \'multiverseId\': 399621}, \'multiverseid\': 399621}, {\'name\': \'Piroarte Raffinata\', \'text\': \'La Piroarte Raffinata infligge 4 danni a una creatura o a un giocatore bersaglio.Arte magica — Se nel tuo cimitero ci sono due o più carte istantaneo e/o stregoneria, la Piroarte Raffinata non può essere neutralizzata da magie o abilità.\', \'type\': \'Stregoneria\', \'flavor\': \'Il dono di Chandra isolava lei mentre inceneriva gli altri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399898&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e95bf66-3791-46e0-8ccd-54b5e7692206\', \'multiverseId\': 399898}, \'multiverseid\': 399898}, {\'name\': \'極上の炎技\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。極上の炎技はそれに４点のダメージを与える。魔巧 ― あなたの墓地にインスタント・カードやソーサリー・カードが合わせて２枚以上あるなら、極上の炎技は呪文や能力によっては打ち消されない。\', \'type\': \'ソーサリー\', \'flavor\': \'チャンドラの天資は彼女を際立たせ、他の者を燃え立たせた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400175&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de45d4b4-fa02-4f37-a34d-7f43df003106\', \'multiverseId\': 400175}, \'multiverseid\': 400175}, {\'name\': \'정교한 화염술\', \'text\': \'생물이나 플레이어를 목표로 정한다. 정교한 화염술은 그 목표에 피해 4점을 입힌다.주문 숙련 — 당신의 무덤에 집중마법 그리고/또는 순간마법 카드가 두 장 이상 있다면, 정교한 화염술은 주문이나 능력에 의해 무효화될 수 없다.\', \'type\': \'집중마법\', \'flavor\': \'찬드라의 상대를 불태워 자신의 불타는 신념을 표출한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400452&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ba1f3516-d78b-44cc-b792-d2b0259c2f0b\', \'multiverseId\': 400452}, \'multiverseid\': 400452}, {\'name\': \'Excelência em Pirotecnia\', \'text\': \'Excelência em Pirotecnia causa 4 pontos de dano à criatura ou ao jogador alvo.Maestria em magia — Se houver dois ou mais cards de mágica instantânea ou feitiço no seu cemitério, Excelência em Pirotecnia não poderá ser anulada por mágicas ou habilidades.\', \'type\': \'Feitiço\', \'flavor\': \'O dom de Chandra a distinguiu dos outros, que acabaram em chamas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400729&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'446e3e46-656d-4a73-8724-a469032c40dd\', \'multiverseId\': 400729}, \'multiverseid\': 400729}, {\'name\': \'Изысканное Мастерство Пламени\', \'text\': \'Изысканное Мастерство Пламени наносит 4 повреждения целевому существу или игроку.Мастерство заклинаний — Если на вашем кладбище есть не менее двух карт мгновенных заклинаний и (или) волшебства, Изысканное Мастерство Пламени не может быть отменено заклинаниями или способностями.\', \'type\': \'Волшебство\', \'flavor\': \'Дар Чандры возвышал ее над остальными, а остальных — превращал в пепел.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401006&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2bc0b2ce-113a-430a-92e6-ac6ab91e9c3e\', \'multiverseId\': 401006}, \'multiverseid\': 401006}, {\'name\': \'精巧火术\', \'text\': \'精巧火术对目标生物或牌手造成4点伤害。精熟咒语～如果你坟墓场中有两张或更多的瞬间和／或法术牌，则精巧火术不能被咒语或异能反击。\', \'type\': \'法术\', \'flavor\': \'茜卓的天赋让她孑然独立，使他人着火燃烧。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398790&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce6f7f74-14b8-4dfa-88f1-529c90607c1b\', \'multiverseId\': 398790}, \'multiverseid\': 398790}, {\'name\': \'精巧火術\', \'text\': \'精巧火術對目標生物或玩家造成4點傷害。精熟咒語～如果你墳墓場中有兩張或更多的瞬間和／或巫術牌，則精巧火術不能被咒語或異能反擊。\', \'type\': \'巫術\', \'flavor\': \'茜卓的天賦讓她孑然獨立，使他人著火燃燒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399067&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'cf97aa24-d111-4d20-9866-796a86c8744a\', \'multiverseId\': 399067}, \'multiverseid\': 399067}]']
