ageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400983&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0046cbed-69d5-4947-a64d-0fcb25d266f0', 'multiverseId': 400983}, 'multiverseid': 400983}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398767&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e2f5413e-59a8-4256-9352-d6fffd07d5f0', 'multiverseId': 398767}, 'multiverseid': 398767}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399044&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '2124c660-dd5d-4851-a651-ca149abd8eac', 'multiverseId': 399044}, 'multiverseid': 399044}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399341&type=card', 'language': 'German', 'identifiers': {'scryfallId': '74ae32f7-33cf-4967-8d20-8ea46d383c15', 'multiverseId': 399341}, 'multiverseid': 399341}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401280&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1e3782e9-64ef-45f6-8d19-0b02597ec1c3', 'multiverseId': 401280}, 'multiverseid': 401280}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399618&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'debb2641-6e03-4768-88ad-c70d36ec68dd', 'multiverseId': 399618}, 'multiverseid': 399618}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399895&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '45890746-6c17-496f-b635-e4b56f415dee', 'multiverseId': 399895}, 'multiverseid': 399895}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400172&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6a74639d-dd43-44a4-982c-50d5ab8ccb02', 'multiverseId': 400172}, 'multiverseid': 400172}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400449&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '774c357a-f152-4fdb-ba7c-8fe915c70921', 'multiverseId': 400449}, 'multiverseid': 400449}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400726&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1132edda-c7d3-4b28-954f-281097a8d25f', 'multiverseId': 400726}, 'multiverseid': 400726}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401003&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0872feb0-6dc3-4429-b94c-35d6fe510442', 'multiverseId': 401003}, 'multiverseid': 401003}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398787&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '40382f7b-8749-473c-84de-d715400c0c4b', 'multiverseId': 398787}, 'multiverseid': 398787}, {'name': '山脈', 'type': '基本地～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399064&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '47f23fc6-a5a7-4197-b8d9-1e90c01be5fa', 'multiverseId': 399064}, 'multiverseid': 399064}]", '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Es macht mich traurig, eine Quelle der Inspiration zu verlieren. Diese hier schien besonders vielversprechend."—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401508&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86ec0317-e780-4370-b2da-edb810fe7453\', \'multiverseId\': 401508}, \'multiverseid\': 401508}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"Me entristece perder una fuente de inspiración. Esta parecía especialmente prometedora".—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401620&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f1816442-446b-478a-be9f-d3d080ac5e37\', \'multiverseId\': 401620}, \'multiverseid\': 401620}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« Quelle tristesse de voir disparaître une source d\'inspiration. D\'autant que celle-ci paraissait très prometteuse. »—Ashiok", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401524&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59f9826e-08d1-40b4-b2b0-e55e717f42c4\', \'multiverseId\': 401524}, \'multiverseid\': 401524}, {\'name\': \'Cancrena della Mente\', \'text\': \'Un giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Mi addolora perdere una fonte di ispirazione. Questa sembrava particolarmente promettente."—Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401540&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca9c841d-9445-46df-9b0b-9bdc7ca79313\', \'multiverseId\': 401540}, \'multiverseid\': 401540}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「発想の源が失われるのは悲しいものがある。今回のは特に有望そうだったのだが。」――アショク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401556&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'604e1010-bcfb-408f-9f49-ebc9f9bdda78\', \'multiverseId\': 401556}, \'multiverseid\': 401556}, {\'name\': \'정신 부패\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 카드 두 장을 버린다.\', \'type\': \'집중마법\', \'flavor\': \'"영감의 원천을 잃는 일은 날 슬프게 한다. 이번 녀석은 특히 유망해 보였었다."—아시오크\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401572&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f797173-81ce-42be-be54-1d9ea549b084\', \'multiverseId\': 401572}, \'multiverseid\': 401572}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Me entristece perder uma fonte de inspiração. Essa parecia especialmente promissora."— Ashiok\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401588&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fad639f3-7a47-4cf7-97ef-7df1a8293a8b\', \'multiverseId\': 401588}, \'multiverseid\': 401588}, {\'name\': \'Гниение Разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'«Жаль терять источник вдохновения. Этот выглядел особенно многообещающе».— Ашиок\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401604&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d78e966-87a4-4989-87cb-9d5c80c31bc7\', \'multiverseId\': 401604}, \'multiverseid\': 401604}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'「失去灵感的源泉，令我非常难过。尤其是这一个看上去大有可为。」～安梭苛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401476&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'64390420-d7b6-4b06-b3b7-1db39e4d28fd\', \'multiverseId\': 401476}, \'multiverseid\': 401476}, {\'name\': \'心之衰\', \'text\': \'目標玩家棄兩張牌。\', \'type\': \'巫術\', \'flavor\': \'「失去靈感的源泉，令我非常難過。尤其是這一個看上去大有可為。」～安梭苛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401492&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'70709f8d-b250-4f21-a5d2-dd2126109edf\', \'multiverseId\': 401492}, \'multiverseid\': 401492}]', '[{\'name\': \'Geheiligtes Mondlicht\', \'text\': \'Falls bis zum Ende des Zuges eine Kreatur ins Spiel kommen würde und sie nicht gewirkt wurde, schicke sie stattdessen ins Exil.Ziehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Kreaturen der Finsternis meiden instinktiv das Licht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399336&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a94290f-616a-46e8-a4ef-553e98febcfc\', \'multiverseId\': 399336}, \'multiverseid\': 399336}, {\'name\': \'Luz de luna consagrada\', \'text\': \'Hasta el final del turno, si una criatura fuera a entrar al campo de batalla y no fue lanzada, en vez de eso, exíliala.Roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Las criaturas de la oscuridad se ocultan de la luz de manera instintiva.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8d5d51e8-e1b3-4507-9e1d-7d138cad336c\', \'multiverseId\': 401275}, \'multiverseid\': 401275}, {\'name\': \'Clair de lune sacré\', \'text\': "Jusqu\'à la fin du tour, si une créature devait arriver sur le champ de bataille et qu\'elle n\'a pas été lancée, exilez-la à la place.Piochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'Les créatures des ténèbres se cachent instinctivement de la lumière.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399613&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bffbbe19-ded6-476f-ac56-c1b890f195dc\', \'multiverseId\': 399613}, \'multiverseid\': 399613}, {\'name\': \'Chiaro di Luna Consacrato\', \'text\': \'Fino alla fine del turno, se una creatura sta per entrare nel campo di battaglia e non è stata lanciata, invece esiliala.Pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Le creature delle tenebre rifuggono istintivamente la luce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399890&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9cd38afb-3852-4d9d-95d7-d6f3ea5e1ab3\', \'multiverseId\': 399890}, \'multiverseid\': 399890}, {\'name\': \'神聖なる月光\', \'text\': \'ターン終了時まで、クリーチャーが、それが唱えられることなく戦場に出るなら、代わりにそれを追放する。カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'闇に蠢くものは本能的に光を避ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400167&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fb8e7f8b-93fd-4bae-846e-d9c55bfb4ff0\', \'multiverseId\': 400167}, \'multiverseid\': 400167}, {\'name\': \'신성한 달빛\', \'text\': \'턴종료까지, 발동되지 않은 생물이 전장에 들어오려 하면 대신에 그 생물을 추방한다.카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'어둠의 생물들은 본능적으로 빛을 피한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400444&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ed5dcf97-b32c-4a53-8458-c9367c0cf4f5\', \'multiverseId\': 400444}, \'multiverseid\': 400444}, {\'name\': \'Luar Consagrado\', \'text\': \'Até o final do turno, se uma criatura entraria no campo de batalha sem ser conjurada, em vez disso, exile-a.Compre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'As criaturas das trevas escondem-se instintivamente da luz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400721&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9a12fc3-5459-4d5e-b131-60b041d4b175\', \'multiverseId\': 400721}, \'multiverseid\': 400721}, {\'name\': \'Священный Свет Луны\', \'text\': \'До конца хода, если существо должно выйти на поле битвы и оно не было разыграно как заклинание, изгоните его вместо этого.Возьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Создания тьмы инстинктивно прячутся от света.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400998&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7af075e9-f4b8-49dd-87f0-fd3037af5b81\', \'multiverseId\': 400998}, \'multiverseid\': 400998}, {\'name\': \'圣洁月光\', \'text\': \'直到回合结束，如果某生物将进战场，且未有牌手施放之，则改为将它放逐。抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'暗夜生物本能地趋避明光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398782&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ceac8c7-f9d0-453e-8e89-6b1846b4e49b\', \'multiverseId\': 398782}, \'multiverseid\': 398782}, {\'name\': \'聖潔月光\', \'text\': \'直到回合結束，如果某生物將進戰場，且未有玩家施放之，則改為將它放逐。抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'暗夜生物本能地趨避明光。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399059&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a1b0da8b-22eb-4642-b638-062927170512\', \'multiverseId\': 399059}, \'multiverseid\': 399059}]', '[{\'name\': \'Geist der Toten\', \'text\': \'FliegendStärke und Widerstandskraft des Geists der Toten sind gleich der Anzahl an Kreaturenkarten in deinem Friedhof.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Auferstanden aus dem Massaker an einer ganzen Armee, ist er erfüllt vom Zorn hunderter Seelen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399406&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d79be59f-85e6-45a5-84b8-b2ac10beeeb6\', \'multiverseId\': 399406}, \'multiverseid\': 399406}, {\'name\': \'Aparecido\', \'text\': \'Vuela.Tanto la fuerza como la resistencia del Aparecido son iguales a la cantidad de cartas de criatura que haya en tu cementerio.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Nacido de la masacre de todo un ejército, alberga la ira de cien almas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401345&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13fb4a2e-b343-41b7-a5d5-f6911ca53dac\', \'multiverseId\': 401345}, \'multiverseid\': 401345}, {\'name\': \'Revenant\', \'text\': "VolLa force et l\'endurance du Revenant sont chacune égales au nombre de cartes de créature dans votre cimetière.", \'type\': \'Créature : esprit\', \'flavor\': \'Né du massacre de toute une armée, il porte en lui la rage de cent âmes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399683&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbc8ed7c-e9c0-4f2f-b7d1-60cbc19f87c2\', \'multiverseId\': 399683}, \'multiverseid\': 399683}, {\'name\': \'Redivivo\', \'text\': \'VolareLa forza e la costituzione del Redivivo sono pari al numero di carte creatura nel tuo cimitero.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'Nato dal massacro di un intero esercito, porta con sé la collera di un centinaio di anime.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399960&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7335697-fa7b-46e1-b8f9-44f23a214f25\', \'multiverseId\': 399960}, \'multiverseid\': 399960}, {\'name\': \'黄泉からの帰還者\', \'text\': \'飛行黄泉からの帰還者のパワーとタフネスは、それぞれあなたの墓地にあるクリーチャー・カードの枚数に等しい。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'それは軍団全員の虐殺から生まれ、百の魂の怒りを秘める。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400237&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1784c8fb-93ea-4ce5-94ae-260f9f5bc4a1\', \'multiverseId\': 400237}, \'multiverseid\': 400237}, {\'name\': \'망령\', \'text\': \'비행망령의 공격력과 방어력은 각각 당신의 무덤에 있는 생물 카드의 개수와 같다.\', \'type\': \'생물 — 신령\', \'flavor\': \'군대가 몰살당한 곳에서 태어나는 망령은 수백 명 분의 분노를 토해낸다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400514&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'bd032feb-1511-47e8-b777-28c5c3021cfd\', \'multiverseId\': 400514}, \'multiverseid\': 400514}, {\'name\': \'Ressurgido\', \'text\': \'Vpoder e a resistência de Ressurgido são ambos iguais ao número de cards de criatura no seu cemitério.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Nascido do massacre de um exército inteiro, ele carrega a fúria de centenas de almas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400791&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e0f94f38-d0ef-4bd3-a486-22d78182fb5f\', \'multiverseId\': 400791}, \'multiverseid\': 400791}, {\'name\': \'Призрак Мертвеца\', \'text\': \'ПолетСила и выносливость Призрака Мертвеца равны количеству карт существ на вашем кладбище.\', \'type\': \'Существо — Дух\', \'flavor\': \'Он родился там, где была истреблена целая армия, и несет в себе гнев сотни душ.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401068&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'86959555-4601-4f6f-bc08-a240215da7c3\', \'multiverseId\': 401068}, \'multiverseid\': 401068}, {\'name\': \'复仇者\', \'text\': \'飞行复仇者的力量和防御力各等同于你坟墓场中的生物牌数量。\', \'type\': \'生物～精怪\', \'flavor\': \'整支军队惨遭屠戮后而生，承载上百灵魂忿恨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398852&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb0ec99a-3fad-4ab1-bc41-9a0a570a2632\', \'multiverseId\': 398852}, \'multiverseid\': 398852}, {\'name\': \'復仇者\', \'text\': \'飛行復仇者的力量和防禦力各等同於你墳墓場中的生物牌數量。\', \'type\': \'生物～精靈\', \'flavor\': \'整支軍隊慘遭屠戮後而生，承載上百靈魂忿恨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399129&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4ef3d4f5-3461-465c-a83c-04783c011e38\', \'multiverseId\': 399129}, \'multiverseid\': 399129}]', '[{\'name\': \'Geist des Obsthains\', \'text\': \'Der Geist des Obsthains kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Pflücke weder die faulen Früchte noch die besten. Lasse sie als Gabe für unsere unsichtbaren Gäste zurück."—Radwick, Bauer aus Gatztow\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399475&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1b6342ce-628d-4f14-89a5-fe0776a1dfe5\', \'multiverseId\': 399475}, \'multiverseid\': 399475}, {\'name\': \'Espíritu del huerto\', \'text\': \'La Espíritu del huerto no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"No tomes la fruta podrida, pero tampoco tomes la mejor. Esas déjalas como una ofrenda para nuestros invitados invisibles".—Radwick, granjero de Gatstaf\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401414&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c68a8bd-afbc-43ef-aa33-d9a79932f227\', \'multiverseId\': 401414}, \'multiverseid\': 401414}, {\'name\': \'Esprit du verger\', \'text\': "L\'Esprit du verger ne peut pas être bloqué excepté par des créatures avec le vol ou la portée.", \'type\': \'Créature : esprit\', \'flavor\': \'« Ne ramassez pas les fruits pourris, mais ne touchez pas non plus aux plus beaux. Ce sont nos offrandes à nos invités invisibles. »—Radwick, fermier de Gatstaf\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399752&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f9ad8e4f-762d-47a6-a760-f8654f749f0e\', \'multiverseId\': 399752}, \'multiverseid\': 399752}, {\'name\': \'Spirito del Frutteto\', \'text\': \'Lo Spirito del Frutteto non può essere bloccato tranne che da creature con volare o raggiungere.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"Non cogliere la frutta marcia, ma la migliore non toccare. Lasciala per gli ospiti invisibili che la vengono a mangiare."—Radwick, contadino di Gatstaf\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400029&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37ca5c12-9d36-4096-aec7-54699c2092dc\', \'multiverseId\': 400029}, \'multiverseid\': 400029}, {\'name\': \'果樹園の霊魂\', \'text\': \'果樹園の霊魂は、飛行か到達を持つクリーチャーによってしかブロックされない。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'「腐った果物は摘んじゃならんし、熟しとるのも触っちゃならん。見えん客への捧げ物として残しておくがええ。」――ガツタフの農夫、ラドウィック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400306&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'469f1999-0301-4813-adb1-3f3060536d05\', \'multiverseId\': 400306}, \'multiverseid\': 400306}, {\'name\': \'과수원 신령\', \'text\': \'과수원 신령은 비행이나 대공을 가진 생물에만 방어될 수 있다.\', \'type\': \'생물 — 신령\', \'flavor\': \'"썩은 과일은 따지 마. 제일 좋은 과일에도 손대지 말고. 그것들은 보이지 않는 손님들에게 바치는 거야."—갓스타프의 농부 라드윅\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400583&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ef552337-af04-4d89-9d69-b825ce576782\', \'multiverseId\': 400583}, \'multiverseid\': 400583}, {\'name\': \'Espírito do Pomar\', \'text\': \'Espírito do Pomar só pode ser bloqueado por criaturas com voar ou alcance.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"Não colha a fruta podre, tampouco a madura. Que sejam oferendas aos nossos hóspedes, invisíveis criaturas.— Radwick, fazendeiro de Gatstaf\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2c430b93-8792-4e9b-aad6-05c81fe42383\', \'multiverseId\': 400860}, \'multiverseid\': 400860}, {\'name\': \'Дух Фруктового Сада\', \'text\': \'Дух Фруктового Сада может быть заблокирован только существом с Полетом или Захватом.\', \'type\': \'Существо — Дух\', \'flavor\': \'«Не собирай гнилые плоды, но и самые лучшие не трогай. Оставь их как приношение нашим невидимым гостям».— Радвик, фермер из Гастафа\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401137&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'32214971-a8ba-45d6-a33b-57d3e8e9bae6\', \'multiverseId\': 401137}, \'multiverseid\': 401137}, {\'name\': \'果园精怪\', \'text\': \'只有具飞行或延势异能的生物才能阻挡果园精怪。\', \'type\': \'生物～精怪\', \'flavor\': \'「别挑中烂果子，也别碰最好的。那些该留着奉献给我们看不见的客人。」～卡兹特农夫列维\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398921&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bf5fa76d-02d6-42dc-874a-6a9ecf09ca9e\', \'multiverseId\': 398921}, \'multiverseid\': 398921}, {\'name\': \'果園精靈\', \'text\': \'只有具飛行或延勢異能的生物才能阻擋果園精靈。\', \'type\': \'生物～精靈\', \'flavor\': \'「別挑中爛果子，也別碰最好的。那些該留著奉獻給我們看不見的客人。」～卡茲特農夫列維\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399198&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ab9ea8ae-318c-4ca3-9acb-93055f1fded2\', \'multiverseId\': 399198}, \'multiverseid\': 399198}]', '[{\'name\': \'Geistesblitz des Handwerkers\', \'text\': \'Ziehe zwei Karten. Falls du kein Artefakt kontrollierst, wirf eine Karte ab.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Handwerker von Kaladesh streben unablässig nach Perfektion, Fortschritt und der ultimativen Darstellung von Eleganz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399293&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f30f5dfc-6b15-4fd5-8dbb-5e7a207b26d4\', \'multiverseId\': 399293}, \'multiverseid\': 399293}, {\'name\': \'Epifanía del artífice\', \'text\': \'Roba dos cartas. Si no controlas ningún artefacto, descarta una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Los artífices de Kaladesh buscan sin descanso la perfección, el progreso y la expresión definitiva de la elegancia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43489cff-4dc7-4ea3-b6f8-1bebc4e4f2a4\', \'multiverseId\': 401232}, \'multiverseid\': 401232}, {\'name\': "Révélation de l\'artificier", \'text\': "Piochez deux cartes. Si vous ne contrôlez aucun artefact, défaussez-vous d\'une carte.", \'type\': \'Éphémère\', \'flavor\': "Les artificiers de Kaladesh aspirent sans relâche à la perfection, au progrès et à l\'expression ultime de l\'élégance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399570&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f55daec-aaf2-4b82-a441-85e283845ddb\', \'multiverseId\': 399570}, \'multiverseid\': 399570}, {\'name\': "Rivelazione dell\'Artefice", \'text\': \'Pesca due carte. Se non controlli artefatti, scarta una carta.\', \'type\': \'Istantaneo\', \'flavor\': "Gli artefici di Kaladesh aspirano incessantemente alla perfezione, al progresso e all\'espressione suprema dell\'eleganza.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399847&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9135f590-b620-4c63-a1ba-eff3d566e6ef\', \'multiverseId\': 399847}, \'multiverseid\': 399847}, {\'name\': \'工匠の天啓\', \'text\': \'カードを２枚引く。あなたがアーティファクトをコントロールしていないなら、カードを１枚捨てる。\', \'type\': \'インスタント\', \'flavor\': \'カラデシュの工匠たちは進歩と完璧さ、そして究極の優雅さの表現を求めて絶え間ない努力を惜しまない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400124&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be34b01d-cdf3-4243-bfc7-7f87d40d95d1\', \'multiverseId\': 400124}, \'multiverseid\': 400124}, {\'name\': \'마법공학자의 깨달음\', \'text\': \'카드 두 장을 뽑는다. 당신이 마법물체를 조종하지 않는다면, 카드 한 장을 버린다.\', \'type\': \'순간마법\', \'flavor\': \'칼라데쉬의 기능공들은 완벽함과 진보, 궁극적으로 세련됨을 표현하기 위해 정진한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400401&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d8c2e572-8e97-42bd-80ac-590b25c2b293\', \'multiverseId\': 400401}, \'multiverseid\': 400401}, {\'name\': \'Epifania do Artífice\', \'text\': \'Compre dois cards. Se você não controlar nenhum artefato, descarte um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os artífices de Kaladesh buscam incessantemente a perfeição, o progresso e a expressão máxima da elegância.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400678&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fdd79a87-a8bb-4def-a501-2813b2d1a8b4\', \'multiverseId\': 400678}, \'multiverseid\': 400678}, {\'name\': \'Прозрение Механика\', \'text\': \'Возьмите две карты. Если под вашим контролем нет артефактов, сбросьте карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Механики Каладеша неустанно стремятся к совершенству, развитию и высшей степени изящества.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400955&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b7a7811a-5b29-4603-a763-c2f24733f56e\', \'multiverseId\': 400955}, \'multiverseid\': 400955}, {\'name\': \'神器师的顿悟\', \'text\': \'抓两张牌。如果你未操控神器，则弃一张牌。\', \'type\': \'瞬间\', \'flavor\': \'卡拉德许神器师为求完美、创新、至上典雅而不断钻研求精。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398739&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'96b1222c-b368-4d77-a0a3-6b734b635336\', \'multiverseId\': 398739}, \'multiverseid\': 398739}, {\'name\': \'神器師的頓悟\', \'text\': \'抽兩張牌。如果你未操控神器，則棄一張牌。\', \'type\': \'瞬間\', \'flavor\': \'卡拉德許神器師為求完美、創新、至上典雅而不斷鑽研求精。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399016&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'456c037b-033c-48fc-9b1c-cc4f945beedf\', \'multiverseId\': 399016}, \'multiverseid\': 399016}]', '[{\'name\': \'Gesegnete Geister\', \'text\': \'FliegendImmer wenn du einen Verzauberungszauber wirkst, lege eine +1/+1-Marke auf die Gesegneten Geister.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Nicht alle Helden sterben in einer Rüstung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399459&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a16f2953-85f3-40c2-b2cc-bbadaf21274d\', \'multiverseId\': 399459}, \'multiverseid\': 399459}, {\'name\': \'Espíritus bienaventurados\', \'text\': \'Vuela.Siempre que lances un hechizo de encantamiento, pon un contador +1/+1 sobre los Espíritus bienaventurados.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'No todos los héroes mueren con armadura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401398&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4161229-721d-4bbf-870d-5d9335f180e8\', \'multiverseId\': 401398}, \'multiverseid\': 401398}, {\'name\': \'Esprits bénis\', \'text\': "VolÀ chaque fois que vous lancez un sort d\'enchantement, mettez un marqueur +1/+1 sur les Esprits bénis.", \'type\': \'Créature : esprit\', \'flavor\': \'Les héros ne meurent pas tous en armure.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'49dfe959-51e2-4ac9-a8c2-4ef07bedfd12\', \'multiverseId\': 399736}, \'multiverseid\': 399736}, {\'name\': \'Spiriti Benedetti\', \'text\': \'VolareOgniqualvolta lanci una magia incantesimo, metti un segnalino +1/+1 sugli Spiriti Benedetti.\', \'type\': \'Creatura — Spirito\', \'flavor\': "Non tutti gli eroi muoiono indossando un\'armatura.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400013&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40e46458-c964-4e7e-83f6-86c03bd88422\', \'multiverseId\': 400013}, \'multiverseid\': 400013}, {\'name\': \'祝福された霊魂\', \'text\': \'飛行あなたがエンチャント・呪文を１つ唱えるたび、祝福された霊魂の上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'すべての英雄が鎧を着て死ぬとはかぎらない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400290&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6daf557d-c191-4910-8300-624084ab4c75\', \'multiverseId\': 400290}, \'multiverseid\': 400290}, {\'name\': \'축복받은 신령들\', \'text\': \'비행당신이 부여마법 주문을 발동할 때마다, 축복받은 신령들에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 신령\', \'flavor\': \'갑옷을 입지 않고 죽는 영웅도 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400567&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d66d8e1b-2f0c-4a2a-b353-5e7fc45c0315\', \'multiverseId\': 400567}, \'multiverseid\': 400567}, {\'name\': \'Espíritos Abençoados\', \'text\': \'VoarToda vez que você conjurar uma mágica de encantamento, coloque um marcador +1/+1 em Espíritos Abençoados.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Nem todos os heróis morrem usando armadura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1f1c6565-ace2-4210-ad27-b56c9b31da22\', \'multiverseId\': 400844}, \'multiverseid\': 400844}, {\'name\': \'Благословенные Духи\', \'text\': \'ПолетКаждый раз, когда вы разыгрываете заклинание чар, положите один жетон +1/+1 на Благословенных Духов.\', \'type\': \'Существо — Дух\', \'flavor\': \'Не все герои умирают в доспехах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401121&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'70af660f-282b-4f25-81f2-e327b9bb8f07\', \'multiverseId\': 401121}, \'multiverseid\': 401121}, {\'name\': \'福佑精怪\', \'text\': \'飞行每当你施放结界咒语时，在福佑精怪上放置一个+1/+1指示物。\', \'type\': \'生物～精怪\', \'flavor\': \'不是所有英雄都披甲而亡。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398905&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'50b107eb-7d9d-4ae2-9710-03afbf2b7aa8\', \'multiverseId\': 398905}, \'multiverseid\': 398905}, {\'name\': \'福佑精靈\', \'text\': \'飛行每當你施放結界咒語時，在福佑精靈上放置一個+1/+1指示物。\', \'type\': \'生物～精靈\', \'flavor\': \'不是所有英雄都披甲而亡。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399182&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a235eb31-b03e-4aaf-8522-7b77463ad3c9\', \'multiverseId\': 399182}, \'multiverseid\': 399182}]', '[{\'name\': \'Gewässer der Angst\', \'text\': \'Ein Spieler deiner Wahl legt die obersten X Karten seiner Bibliothek auf seinen Friedhof, wobei X gleich der Anzahl an Ländern ist, die du kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'Wenn du dich zu weit in den Morkrut wagst, erhebt er sich vielleicht, um dich zu behalten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399236&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'deb8671d-8da9-4ad3-bed7-a3f274fc8807\', \'multiverseId\': 399236}, \'multiverseid\': 399236}, {\'name\': \'Aguas pavorosas\', \'text\': \'El jugador objetivo pone las X primeras cartas de su biblioteca en su cementerio, donde X es la cantidad de tierras que controlas.\', \'type\': \'Conjuro\', \'flavor\': \'Si te extravías por el Morkrut, puede que se alce para reclamarte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401175&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ea68ae7-d62d-450a-9383-567997460a04\', \'multiverseId\': 401175}, \'multiverseid\': 401175}, {\'name\': \'Flots funestes\', \'text\': \'Le joueur ciblé met les X cartes du dessus de sa bibliothèque dans son cimetière, X étant le nombre de terrains que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "S\'égarer dans le Morkrut, c\'est prendre le risque de s\'y noyer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399513&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7038d880-ec10-43c4-b5e7-f5902e193a98\', \'multiverseId\': 399513}, \'multiverseid\': 399513}, {\'name\': \'Acque del Terrore\', \'text\': \'Un giocatore bersaglio mette nel suo cimitero le prime X carte del suo grimorio, dove X è il numero di terre che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'Vaga troppo a lungo nel Morkrut e il Morkrut ti reclamerà.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399790&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'be2ef0c7-65e9-496f-9191-b146194c7b35\', \'multiverseId\': 399790}, \'multiverseid\': 399790}, {\'name\': \'戦慄水\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上からＸ枚のカードを自分の墓地に置く。Ｘはあなたがコントロールする土地の総数に等しい。\', \'type\': \'ソーサリー\', \'flavor\': \'モークラットに迷い込んだら、その水に飲み込まれてしまうかもしれないよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400067&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fbec783e-b87d-4a3f-a6cf-5591f0af8bf1\', \'multiverseId\': 400067}, \'multiverseid\': 400067}, {\'name\': \'공포의 파도\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 자신의 서고 맨 위의 카드 X장을 무덤에 넣는다. X는 당신이 조종하는 대지의 개수다.\', \'type\': \'집중마법\', \'flavor\': \'모르크루트는 실수로 들어가면 당신을 앗아가 버리는 곳이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400344&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7166cf43-9edb-4725-ace6-13d2315b4e98\', \'multiverseId\': 400344}, \'multiverseid\': 400344}, {\'name\': \'Onda Medonha\', \'text\': \'O jogador alvo coloca X cards do topo do grimório dele no próprio cemitério, sendo X o número de terrenos que você controla.\', \'type\': \'Feitiço\', \'flavor\': \'Cuidado ao aventurar-se pelo Morkrut, pois ele pode se erguer para pegá-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400621&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc3807a7-eecc-4497-95e2-cfb64d494367\', \'multiverseId\': 400621}, \'multiverseid\': 400621}, {\'name\': \'Волна Ужаса\', \'text\': \'Целевой игрок кладет X верхних карт своей библиотеки на свое кладбище, где X — количество земель под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'Если вы заблудитесь в Моркруте, болото поднимется и заберет вас.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400898&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7709d6fb-8fad-4e62-917a-946514a01b8f\', \'multiverseId\': 400898}, \'multiverseid\': 400898}, {\'name\': \'恶水\', \'text\': \'目标牌手将其牌库顶的X张牌置入其坟墓场，X为由你操控的地数量。\', \'type\': \'法术\', \'flavor\': \'误入穆坎，恐遭灭顶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398682&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'89379c14-eeba-44d9-ba9e-7357827a2278\', \'multiverseId\': 398682}, \'multiverseid\': 398682}, {\'name\': \'惡水\', \'text\': \'目標玩家將其牌庫頂的X張牌置入其墳墓場，X為由你操控的地數量。\', \'type\': \'巫術\', \'flavor\': \'誤入穆坎，恐遭滅頂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398959&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'12716850-4e5c-47a5-9182-c0003e903917\', \'multiverseId\': 398959}, \'multiverseid\': 398959}]', '[{\'name\': \'Ghirapur-Feinmechaniker\', \'text\': \'Wenn der Ghirapur-Feinmechaniker ins Spiel kommt, bringe einen 1/1 farblosen Thopter-Artefaktkreaturenspielstein mit Flugfähigkeit ins Spiel. (Eine Kreatur mit Flugfähigkeit kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)\', \'type\': \'Kreatur — Mensch, Handwerker\', \'flavor\': \'Das Metall muss rein sein. Die Hand muss ruhig sein. Das Produkt muss perfekt sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399512&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'070bb9bd-3fac-498c-bd78-fd81ab8fcb27\', \'multiverseId\': 399512}, \'multiverseid\': 399512}, {\'name\': \'Creador de artefactos de Ghirapur\', \'text\': \'Cuando el Creador de artefactos de Ghirapur entre al campo de batalla, pon en el campo de batalla una ficha de criatura artefacto Tóptero incolora 1/1 con la habilidad de volar. (Una criatura que vuela no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)\', \'type\': \'Criatura — Artífice humano\', \'flavor\': \'El metal debe ser puro; la mano, firme; y el producto, perfecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401451&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'42a0d803-db15-4789-a4df-f9597c04371f\', \'multiverseId\': 401451}, \'multiverseid\': 401451}, {\'name\': \'Attirailleur de Ghirapur\', \'text\': "Quand l\'Attirailleur de Ghirapur arrive sur le champ de bataille, mettez sur le champ de bataille un jeton de créature-artefact 1/1 incolore Mécanoptère avec le vol. (Une créature avec le vol ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)", \'type\': \'Créature : humain et artificier\', \'flavor\': \'Le métal doit être pur. La main doit être stable. Le produit doit être parfait.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399789&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ab25420c-0e11-4fa0-9591-c29ab85b0e0c\', \'multiverseId\': 399789}, \'multiverseid\': 399789}, {\'name\': \'Creaingranaggi di Ghirapur\', \'text\': \'Quando il Creaingranaggi di Ghirapur entra nel campo di battaglia, metti sul campo di battaglia una pedina creatura artefatto Tottero 1/1 incolore con volare. (Una creatura con volare non può essere bloccata tranne che da creature con volare o raggiungere.)\', \'type\': \'Creatura — Artefice Umano\', \'flavor\': "Il metallo dev\'essere puro, la mano ferma, il prodotto perfetto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400066&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1376f4a9-6b05-471e-8408-0866a471e7d5\', \'multiverseId\': 400066}, \'multiverseid\': 400066}, {\'name\': \'ギラプールの歯車造り\', \'text\': \'ギラプールの歯車造りが戦場に出たとき、飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを１体戦場に出す。（飛行を持つクリーチャーは、飛行や到達を持たないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — 人間・工匠\', \'flavor\': \'金属は純粋でなければならない。手技は安定していなければならない。製品は完璧でなければならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400343&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8cabd6ff-68d5-4c58-a63e-2d8f4b95b4ce\', \'multiverseId\': 400343}, \'multiverseid\': 400343}, {\'name\': \'기라푸르 톱니장인\', \'text\': \'기라푸르 톱니장인이 전장에 들어올 때, 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰 한 개를 전장에 놓는다. (비행 능력을 가진 생물은 비행이나 대공 능력을 가진 생물에만 방어될 수 있다.)\', \'type\': \'생물 — 인간 기능공\', \'flavor\': \'불순물 없는 금속을 쓰자. 손을 떨지 말자. 완벽한 물건을 만들자.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400620&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'228069ca-2ab0-4adb-830f-f764a18ed3a4\', \'multiverseId\': 400620}, \'multiverseid\': 400620}, {\'name\': \'Artesão Mecânico de Ghirapur\', \'text\': \'Quando Artesão Mecânico de Ghirapur entrar no campo de batalha, coloque no campo de batalha uma ficha de criatura artefato incolor 1/1 do tipo Tóptero com voar. (Uma criatura com voar só pode ser bloqueada por criaturas com voar ou alcance.)\', \'type\': \'Criatura — Humano Artesão\', \'flavor\': \'O metal deve ser puro. A mão deve ser firme. O produto deve ser perfeito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400897&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cd9a98b8-623e-4412-900b-564f426b2838\', \'multiverseId\': 400897}, \'multiverseid\': 400897}, {\'name\': \'Гирапурский Умелец\', \'text\': \'Когда Гирапурский Умелец выходит на поле битвы, положите на поле битвы одну фишку артефакта существа 1/1 бесцветный Топтер с Полетом. (Существо с Полетом может быть заблокировано только существами с Полетом или Захватом.)\', \'type\': \'Существо — Человек Механик\', \'flavor\': \'Металл должен быть чистым. Рука должна быть твердой. Изделие должно быть совершенным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401174&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'510b5f6b-fffb-48ae-9639-684f4a094aa0\', \'multiverseId\': 401174}, \'multiverseid\': 401174}, {\'name\': \'吉拉波机械匠\', \'text\': \'当吉拉波机械匠进战场时，将一个1/1无色，具飞行异能的振翼机衍生神器生物放进战场。（只有具飞行或延势异能的生物才能阻挡具飞行异能的生物。）\', \'type\': \'生物～人类／神器师\', \'flavor\': \'金属必须纯净；双手必须稳当；产品必须完美。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398958&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'915c5a8c-c90d-44d8-8398-ccb10c58eec5\', \'multiverseId\': 398958}, \'multiverseid\': 398958}, {\'name\': \'吉拉波機械匠\', \'text\': \'當吉拉波機械匠進戰場時，將一個1/1無色，具飛行異能的振翼機衍生神器生物放進戰場。（只有具飛行或延勢異能的生物才能阻擋具飛行異能的生物。）\', \'type\': \'生物～人類／神器師\', \'flavor\': \'金屬必須純淨；雙手必須穩當；產品必須完美。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399235&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a595f0d9-15b6-4e70-8475-00deb17b2b5c\', \'multiverseId\': 399235}, \'multiverseid\': 399235}]', '[{\'name\': \'Ghirapur-Ätherfeld\', \'text\': \'Tappe zwei ungetappte Artefakte, die du kontrollierst: Das Ghirapur-Ätherfeld fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Stadt Ghirapur ist ein lebendes Wesen, und lebende Wesen verteidigen sich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399348&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac3a0f1d-0a1b-454e-a1f6-aa643f4c4df6\', \'multiverseId\': 399348}, \'multiverseid\': 399348}, {\'name\': \'Barrera de éter de Ghirapur\', \'text\': \'Girar dos artefactos enderezados que controlas: La Barrera de éter de Ghirapur hace 1 punto de daño a la criatura o jugador objetivo.\', \'type\': \'Encantamiento\', \'flavor\': \'La ciudad de Ghirapur es un ser vivo, y los seres vivos se defienden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401287&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3769aecd-3daa-47db-b394-799f209ef57c\', \'multiverseId\': 401287}, \'multiverseid\': 401287}, {\'name\': "Grille d\'Aether de Ghirapur", \'text\': "Engagez deux artefacts dégagés que vous contrôlez : La Grille d\'Aether de Ghirapur inflige 1 blessure à une cible, créature ou joueur.", \'type\': \'Enchantement\', \'flavor\': \'La cité de Ghirapur est vivante, et tout ce qui est vivant se défend.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399625&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54b75b00-3147-4f6d-91f5-5d70903c0ceb\', \'multiverseId\': 399625}, \'multiverseid\': 399625}, {\'name\': \'Griglia Eterea di Ghirapur\', \'text\': \'TAPpa due artefatti STAPpati che controlli: La Griglia Eterea di Ghirapur infligge 1 danno a una creatura o a un giocatore bersaglio.\', \'type\': \'Incantesimo\', \'flavor\': \'La città di Ghirapur è un essere vivente... e gli esseri viventi si difendono.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399902&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da7ce50b-08bc-4f51-967f-458f73d9c75b\', \'multiverseId\': 399902}, \'multiverseid\': 399902}, {\'name\': \'ギラプールの霊気格子\', \'text\': \'あなたがコントロールするアンタップ状態のアーティファクトを２つタップする：クリーチャー１体かプレイヤー１人を対象とする。ギラプールの霊気格子はそれに１点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'ギラプールの街は生命体であり、生命体は自らを防衛するものである。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400179&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f757bec3-a2da-40dd-b11e-c1268018e762\', \'multiverseId\': 400179}, \'multiverseid\': 400179}, {\'name\': \'기라푸르 에테르 격자\', \'text\': \'당신이 조종하는 언탭된 마법물체 두 개를 탭한다: 생물이나 플레이어를 목표로 정한다. 기라푸르 에테르 격자는 그 목표에 피해 1점을 입힌다.\', \'type\': \'부여마법\', \'flavor\': \'기라푸르는 도시 자체가 생물이다. 생물은 자신을 방어한다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400456&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6285903a-e6f2-4faf-a481-7ab0e80ad46e\', \'multiverseId\': 400456}, \'multiverseid\': 400456}, {\'name\': \'Grade de Éter de Ghirapur\', \'text\': \'Vire dois artefatos desvirados que você controla: Grade de Éter de Ghirapur causa 1 ponto de dano à criatura ou ao jogador alvo.\', \'type\': \'Encantamento\', \'flavor\': \'A cidade de Ghirapur é um organismo vivo, e como tal, ela se defende.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400733&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f67f0fe-8fb4-4a51-8369-5a75a2cba8ad\', \'multiverseId\': 400733}, \'multiverseid\': 400733}, {\'name\': \'Гирапурская Эфирная Сеть\', \'text\': \'Поверните два неповернутых артефакта под вашим контролем: Гирапурская Эфирная Сеть наносит 1 повреждение целевому существу или игроку.\', \'type\': \'Чары\', \'flavor\': \'Город Гирапур — это живой организм, а живые организмы умеют защищаться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401010&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'461b46a2-ec9d-46b5-9073-f28b6523befb\', \'multiverseId\': 401010}, \'multiverseid\': 401010}, {\'name\': \'吉拉波乙太网\', \'text\': \'横置两个由你操控且未横置的神器：吉拉波乙太网对目标生物或牌手造成1点伤害。\', \'type\': \'结界\', \'flavor\': \'吉拉波城是活的，而活物会自我防御。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398794&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'72310390-b2c7-4369-b42d-217a9daaa495\', \'multiverseId\': 398794}, \'multiverseid\': 398794}, {\'name\': \'吉拉波乙太網\', \'text\': \'橫置兩個由你操控且未橫置的神器：吉拉波乙太網對目標生物或玩家造成1點傷害。\', \'type\': \'結界\', \'flavor\': \'吉拉波城是活的，而活物會自我防禦。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399071&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'43ff2cdc-04d1-4711-83b1-b512f2b9130a\', \'multiverseId\': 399071}, \'multiverseid\': 399071}]', '[{\'name\': \'Gideons Phalanx\', \'text\': \'Bringe vier 2/2 weiße Ritter-Kreaturenspielsteine mit Wachsamkeit ins Spiel.Zauberkunst — Falls sich zwei oder mehr Spontanzauber- und/oder Hexerei-Karten in deinem Friedhof befinden, erhalten Kreaturen, die du kontrollierst, bis zum Ende des Zuges Unzerstörbarkeit.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399302&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b503bfd-6143-485a-b452-f9df7f1bae5f\', \'multiverseId\': 399302}, \'multiverseid\': 399302}, {\'name\': \'Falange de Gideon\', \'text\': \'Pon en el campo de batalla cuatro fichas de criatura Caballero blancas 2/2 con la habilidad de vigilancia.Dominio de hechizos — Si hay dos o más cartas de instantáneo y/o de conjuro en tu cementerio, las criaturas que controlas ganan la habilidad de indestructible hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401241&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5321fd3c-fa9c-422e-b2b0-b6e55c78047e\', \'multiverseId\': 401241}, \'multiverseid\': 401241}, {\'name\': \'Phalange de Gideon\', \'text\': "Mettez sur le champ de bataille quatre jetons de créature 2/2 blanche Chevalier avec la vigilance.Maîtrise de sort — S\'il y a au moins deux cartes d\'éphémère et/ou de rituel dans votre cimetière, les créatures que vous contrôlez acquièrent l\'indestructible jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399579&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b0f00da-16c9-4cfb-ab8d-c55bdd25f42b\', \'multiverseId\': 399579}, \'multiverseid\': 399579}, {\'name\': \'Falange di Gideon\', \'text\': \'Metti sul campo di battaglia quattro pedine creatura Cavaliere 2/2 bianche con cautela.Arte magica — Se nel tuo cimitero ci sono due o più carte istantaneo e/o stregoneria, le creature che controlli hanno indistruttibile fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399856&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'327ae137-46fa-40b1-aabd-eeab2f11a4cc\', \'multiverseId\': 399856}, \'multiverseid\': 399856}, {\'name\': \'ギデオンの密集軍\', \'text\': \'警戒を持つ白の２/２の騎士・クリーチャー・トークンを４体戦場に出す。魔巧 ― あなたの墓地にインスタント・カードやソーサリー・カードが合わせて２枚以上あるなら、ターン終了時まで、あなたがコントロールするクリーチャーは破壊不能を得る。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400133&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1e55263-a2de-44ff-8f00-c7a6dd56d7fb\', \'multiverseId\': 400133}, \'multiverseid\': 400133}, {\'name\': \'기디온의 팔랑크스\', \'text\': \'경계를 가진 2/2 백색 기사 생물 토큰 네 개를 전장에 놓는다.주문 숙련 — 당신의 무덤에 집중마법 그리고/또는 순간마법 카드가 두 장 이상 있다면, 당신이 조종하는 생물들은 턴종료까지 무적을 얻는다.\', \'type\': \'순간마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400410&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7d738aac-6609-43e4-bb67-5cf26f0a785c\', \'multiverseId\': 400410}, \'multiverseid\': 400410}, {\'name\': \'Falange de Gideon\', \'text\': \'Coloque no campo de batalha quatro fichas de criatura brancas 2/2 do tipo Cavaleiro com vigilância.Maestria em magia — Se houver dois ou mais cards de mágica instantânea ou feitiço no seu cemitério, as criaturas que você controla ganharão indestrutível até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400687&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89a0bb05-c989-43aa-8558-4a4f9d042f59\', \'multiverseId\': 400687}, \'multiverseid\': 400687}, {\'name\': \'Фаланга Гидеона\', \'text\': \'Положите на поле битвы четыре фишки существа 2/2 белый Рыцарь с Бдительностью.Мастерство заклинаний — Если на вашем кладбище есть не менее двух карт мгновенных заклинаний и (или) волшебства, существа под вашим контролем получают Неразрушимость до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400964&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bf518583-f7d9-4b26-b919-eca08a1b89d4\', \'multiverseId\': 400964}, \'multiverseid\': 400964}, {\'name\': \'基定的方阵兵团\', \'text\': \'将四个2/2白色，具警戒异能的骑士衍生生物放进战场。精熟咒语～如果你坟墓场中有两张或更多的瞬间和／或法术牌，则由你操控的生物获得不灭异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398748&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e297739f-cad7-44fd-b903-aa3e9c9adf47\', \'multiverseId\': 398748}, \'multiverseid\': 398748}, {\'name\': \'基定的方陣兵團\', \'text\': \'將四個2/2白色，具警戒異能的騎士衍生生物放進戰場。精熟咒語～如果你墳墓場中有兩張或更多的瞬間和／或巫術牌，則由你操控的生物獲得不滅異能直到回合結束。\', \'type\': \'瞬間\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399025&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8af1311e-32ec-4d0f-b6d2-e3ec73fd0068\', \'multiverseId\': 399025}, \'multiverseid\': 399025}]', "[{'name': 'Gießerei der Konsule', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.{5}, {T}, opfere die Gießerei der Konsule: Bringe zwei 1/1 farblose Thopter-Artefaktkreaturenspielsteine mit Flugfähigkeit ins Spiel.', 'type': 'Land', 'flavor': 'Überall um die Gießerei herum koppelten sich Maschinenwesen von ihren Halterungen ab und richteten sich auf Chandra aus.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399444&type=card', 'language': 'German', 'identifiers': {'scryfallId': '39ef6431-a3d9-4a6b-974c-8f910531e433', 'multiverseId': 399444}, 'multiverseid': 399444}, {'name': 'Fundición de los cónsules', 'text': '{T}: Agrega {1} a tu reserva de maná.{5}, {T}, sacrificar la Fundición de los cónsules: Pon en el campo de batalla dos fichas de criatura artefacto Tóptero incoloras 1/1 con la habilidad de volar.', 'type': 'Tierra', 'flavor': 'Por toda la fundición, los autómatas se desenganchaban de sus soportes y rotaban para estar de cara a Chandra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401383&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c7149863-bcda-41b6-878a-043e8295130c', 'multiverseId': 401383}, 'multiverseid': 401383}, {'name': 'Fonderie des consuls', 'text': '{T} : Ajoutez {1} à votre réserve.{5}, {T}, sacrifiez la Fonderie des consuls : Mettez sur le champ de bataille deux jetons de créature-artefact 1/1 incolore Mécanoptère avec le vol.', 'type': 'Terrain', 'flavor': 'Dans toute la fonderie, les automates se décrochèrent de leurs montures et pivotèrent pour faire face à Chandra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399721&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7cf921e0-ed85-4392-9afc-025d6e089c18', 'multiverseId': 399721}, 'multiverseid': 399721}, {'name': 'Fonderia dei Consoli', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.{5}, {T}, Sacrifica la Fonderia dei Consoli: Metti sul campo di battaglia due pedine creatura artefatto Tottero 1/1 incolori con volare.', 'type': 'Terra', 'flavor': 'Tutto intorno alla fonderia, gli automi si sganciarono dai propri destrieri e ruotarono per affrontare Chandra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399998&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '55c3af60-e451-444b-bae2-e018ea774405', 'multiverseId': 399998}, 'multiverseid': 399998}, {'name': '領事の鋳造所', 'text': '{T}：あなたのマナ・プールに{1}を加える。{5}, {T}, 領事の鋳造所を生け贄に捧げる：飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを２体戦場に出す。', 'type': '土地', 'flavor': '鋳造所のあちらこちらで、自動機械たちは自らを台座から取り外し、旋回してチャンドラの方を向いた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400275&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8287eb58-5a43-46d8-b877-1791a486ca10', 'multiverseId': 400275}, 'multiverseid': 400275}, {'name': '영사의 주조소', 'text': '{T}: {1}을 당신의 마나풀에 담는다.{5}, {T}, 영사의 주조소를 희생한다: 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰 두 개를 전장에 놓는다.', 'type': '대지', 'flavor': '주조소 주변에서 자동기계들이 튀어나와 찬드라를 향해 회전했다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400552&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '3ea4ac54-c5d3-4341-b749-8081074cd8e3', 'multiverseId': 400552}, 'multiverseid': 400552}, {'name': 'Fundição dos Cônsules', 'text': '{T}: Adicione {1} à sua reserva de mana.{5}, {T}, Sacrifique Fundição dos Cônsules: Coloque no campo de batalha duas fichas de criatura artefato incolor 1/1 do tipo Tóptero com voar.', 'type': 'Terreno', 'flavor': 'Por toda a forja, os autômatos se soltaram de seus encaixes e se viraram na direção de Chandra.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400829&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b0b176fc-55c5-43d5-a139-c8082e6eea81', 'multiverseId': 400829}, 'multiverseid': 400829}, {'name': 'Литейная Консулов', 'text': '{T}: добавьте {1} в ваше хранилище маны.{5}, {T}, пожертвуйте Литейную Консулов: положите на поле битвы две фишки артефакта существа 1/1 бесцветный Топтер с Полетом.', 'type': 'Земля', 'flavor': 'По всей литейной автоматы выбирались из своих креплений и поворачивались, чтобы встретить Чандру.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401106&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4ed0ba68-f94c-4486-bf6b-5bdf882d9728', 'multiverseId': 401106}, 'multiverseid': 401106}, {'name': '执政官铸造厂', 'text': '{T}：加{1}到你的法术力池中。{5}，{T}，牺牲执政官铸造厂：将两个1/1无色，具飞行异能的振翼机衍生神器生物放进战场。', 'type': '地', 'flavor': '整个铸造厂的机器人都从基座上出动，包围了茜卓。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398890&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '19d3609c-60cc-4a89-8a68-077ba1c499a4', 'multiverseId': 398890}, 'multiverseid': 398890}, {'name': '執政官鑄造廠', 'text': '{T}：加{1}到你的魔法力池中。{5}，{T}，犧牲執政官鑄造廠：將兩個1/1無色，具飛行異能的振翼機衍生神器生物放進戰場。', 'type': '地', 'flavor': '整個鑄造廠的機器人都從基座上出動，包圍了茜卓。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399167&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c399cbc1-7aa0-4f52-9670-5dbc668b4d02', 'multiverseId': 399167}, 'multiverseid': 399167}]", '[{\'name\': \'Glutschlund-Teufelsbraten\', \'text\': \'Verursacht Trampelschaden (Diese Kreatur kann beim Angreifen überschüssigen Kampfschaden dem verteidigenden Spieler oder Planeswalker zufügen.)Falls eine andere rote Quelle, die du kontrollierst, einer bleibenden Karte oder einem Spieler Schaden zufügen würde, fügt sie dieser bleibenden Karte oder diesem Spieler stattdessen so viele Schadenspunkte plus 1 zu.\', \'type\': \'Kreatur — Teufelsbraten\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399407&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e34d4b9-9f9b-4c39-b53e-4ccf6a5ac7b0\', \'multiverseId\': 399407}, \'multiverseid\': 399407}, {\'name\': \'Infernal brasafauces\', \'text\': \'Arrolla. (Esta criatura puede hacer el daño de combate sobrante al jugador o planeswalker defensor mientras ataca.)Si otra fuente roja que controlas fuera a hacer daño a un permanente o jugador, en vez de eso, hace esa misma cantidad de daño más 1 a ese permanente o jugador.\', \'type\': \'Criatura — Infernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401346&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e452935-be21-4897-a530-b457df4c89c6\', \'multiverseId\': 401346}, \'multiverseid\': 401346}, {\'name\': \'Monstruosité braisegueule\', \'text\': \'Piétinement (Cette créature peut infliger son surplus de blessures de combat au joueur ou au planeswalker défenseur quand elle attaque.)Si une autre source rouge que vous contrôlez devait infliger des blessures à un permanent ou à un joueur, elle inflige autant de blessures plus 1 à ce permanent ou à ce joueur à la place.\', \'type\': \'Créature : monstruosité\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399684&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf656d90-a860-4248-9f86-81b0ee01dd8f\', \'multiverseId\': 399684}, \'multiverseid\': 399684}, {\'name\': \'Infernale Bracifauce\', \'text\': "Travolgere (Questa creatura può infliggere il danno da combattimento in eccesso a un giocatore in difesa o a un planeswalker mentre attacca.)Se un\'altra fonte rossa che controlli sta per infliggere danno a un permanente o a un giocatore, infligge invece altrettanti danni più 1 a quel permanente o giocatore.", \'type\': \'Creatura — Infernale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'42aa0b1d-f32f-4aef-8084-d5b3388ab241\', \'multiverseId\': 399961}, \'multiverseid\': 399961}, {\'name\': \'燃えさし口のヘリオン\', \'text\': \'トランプル（攻撃しているこのクリーチャーは余剰の戦闘ダメージを防御プレイヤーかプレインズウォーカーに与えることができる。）あなたがコントロールする他の赤の発生源がパーマネントかプレイヤーにダメージを与えるなら、代わりにそれはそのパーマネントやプレイヤーに、その点数に１を足した点数のダメージを与える。\', \'type\': \'クリーチャー — ヘリオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400238&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'faf98eac-edf5-4426-a7d1-08073730eb18\', \'multiverseId\': 400238}, \'multiverseid\': 400238}, {\'name\': \'불꽃아가리 헬리온\', \'text\': \'돌진 (이 생물은 공격할 때 수비플레이어 또는 플레인즈워커에게 여분의 피해를 입힌다.)당신이 조종하는 다른 적색 원천이 지속물이나 플레이어에게 피해를 입히려 한다면, 대신에 그 피해에 1을 더한 만큼의 피해를 입힌다.\', \'type\': \'생물 — 헬리온\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400515&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4f337b1e-951c-45cd-b3af-1ba0f7656367\', \'multiverseId\': 400515}, \'multiverseid\': 400515}, {\'name\': \'Avernal Boca de Brasa\', \'text\': \'Atropelar (Esta criatura pode causar seu dano de combate excedente ao planeswalker ou jogador defensor ao atacar.)Se outra fonte vermelha sob seu controle for causar dano a uma permanente ou jogador, ela causará, em vez disso, aquela quantidade de dano mais 1 àquela permanente ou jogador.\', \'type\': \'Criatura — Avernal\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400792&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ce47a6b6-05fd-410c-8905-4da947d03ced\', \'multiverseId\': 400792}, \'multiverseid\': 400792}, {\'name\': \'Геллион Пылающей Утробы\', \'text\': \'Пробивной удар (Атакуя, это существо может нанести избыточные боевые повреждения защищающемуся игроку или planeswalker-у.)Если другой красный источник под вашим контролем должен нанести повреждения перманенту или игроку, вместо этого он наносит тому перманенту или игроку на 1 повреждение больше.\', \'type\': \'Существо — Геллион\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401069&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77c1d6d1-f4fe-418b-a3d7-9838d739b03a\', \'multiverseId\': 401069}, \'multiverseid\': 401069}, {\'name\': \'烬喉地狱兽\', \'text\': \'践踏（此生物攻击时造成之过量战斗伤害能对防御牌手或鹏洛客造成之。）如果由你操控的其他红色来源将对任一永久物或牌手造成伤害，则改为它对该永久物或牌手造成原数量加1点伤害。\', \'type\': \'生物～地狱兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398853&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'deb3dfd7-e2fb-4c8b-bd20-fcb57702ccd4\', \'multiverseId\': 398853}, \'multiverseid\': 398853}, {\'name\': \'燼喉地獄獸\', \'text\': \'踐踏（此生物攻擊時造成之過量戰鬥傷害能對防禦玩家或鵬洛客造成之。）如果由你操控的其他紅色來源將對任一永久物或玩家造成傷害，則改為它對該永久物或玩家造成原數量加1點傷害。\', \'type\': \'生物～地獄獸\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399130&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'decfc68a-5433-47a6-a9c9-ab134ff692b6\', \'multiverseId\': 399130}, \'multiverseid\': 399130}]', '[{\'name\': \'Glühender Höllenhund\', \'text\': \'{1}, opfere eine andere Kreatur: Der Glühende Höllenhund fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Elementarwesen, Hund\', \'flavor\': \'Er reißt dir das Fleisch von den Knochen und verschlingt die Asche mit seinem feurigen Maul.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89bca21b-f3aa-4167-9016-a81509207762\', \'multiverseId\': 399491}, \'multiverseid\': 399491}, {\'name\': \'Perro infernal llameante\', \'text\': \'{1}, sacrificar otra criatura: El Perro infernal llameante hace 1 punto de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Perro elemental\', \'flavor\': \'Te arranca la carne de los huesos y luego se traga las cenizas con sus fauces ardientes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'819acb29-9003-407e-a7f3-0a1f636688d4\', \'multiverseId\': 401430}, \'multiverseid\': 401430}, {\'name\': \'Cerbère brûlant\', \'text\': \'{1}, sacrifiez une autre créature : Le Cerbère brûlant inflige 1 blessure à une cible, créature ou joueur.\', \'type\': \'Créature : élémental et chien de chasse\', \'flavor\': \'Il vous arrache la chair des os, puis avale les cendres dans sa gueule incendiaire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1cb02e6-8eaf-47b0-bb18-420f14f4dbb9\', \'multiverseId\': 399768}, \'multiverseid\': 399768}, {\'name\': \'Segugio Infernale Ardente\', \'text\': "{1}, Sacrifica un\'altra creatura: Il Segugio Infernale Ardente infligge 1 danno a una creatura o a un giocatore bersaglio.", \'type\': \'Creatura — Segugio Elementale\', \'flavor\': \'Strappa la carne dalle ossa, poi ingoia le ceneri con le sue fauci infuocate.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4431799f-ed05-49d6-9fb5-2de4db84954d\', \'multiverseId\': 400045}, \'multiverseid\': 400045}, {\'name\': \'猛火のヘルハウンド\', \'text\': \'{1}, 他のクリーチャーを１体生け贄に捧げる：クリーチャー１体かプレイヤー１人を対象とする。猛火のヘルハウンドはそれに１点のダメージを与える。\', \'type\': \'クリーチャー — エレメンタル・猟犬\', \'flavor\': \'それは骨から肉を食いちぎり、そして燃える口から灰を飲み込む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400322&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a73ffd1e-87a5-4097-8f60-e021358a088f\', \'multiverseId\': 400322}, \'multiverseid\': 400322}, {\'name\': \'불타는 지옥견\', \'text\': \'{1}, 다른 생물을 희생한다: 생물이나 플레이어를 목표로 정한다. 불타는 지옥견은 그 목표에 피해 1점을 입힌다.\', \'type\': \'생물 — 사냥개 정령\', \'flavor\': \'녀석은 네 뼈에서 살을 발라내고 그 불타는 주둥이로 네 재를 삼킬 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400599&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5059f39d-5b46-4a4e-8ca7-f14344be2692\', \'multiverseId\': 400599}, \'multiverseid\': 400599}, {\'name\': \'Sabujo Infernal Flamejante\', \'text\': \'{1}, Sacrifique outra criatura: Sabujo Infernal Flamejante causa 1 ponto de dano à criatura ou ao jogador alvo.\', \'type\': \'Criatura — Elemental Sabujo\', \'flavor\': \'Ele arranca a carne dos seus ossos e depois engole as cinzas com a boca flamejante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ddc76e4e-6169-4cf3-99b6-7c57d4b36b40\', \'multiverseId\': 400876}, \'multiverseid\': 400876}, {\'name\': \'Пылающий Цербер\', \'text\': \'{1}, пожертвуйте другое существо: Пылающий Цербер наносит 1 повреждение целевому существу или игроку.\', \'type\': \'Существо — Элементаль Пес\', \'flavor\': \'Он отрывает плоть от костей, а затем отправляет пепел в свою огненную глотку.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401153&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e2c8da2-488f-4e71-8dba-74e868379250\', \'multiverseId\': 401153}, \'multiverseid\': 401153}, {\'name\': \'炽焰地狱犬\', \'text\': \'{1}，牺牲另一个生物：炽焰地狱犬对目标生物或牌手造成1点伤害。\', \'type\': \'生物～元素／猎犬\', \'flavor\': \'它从你的骨头上咬下肉块，然后用火热的巨口将灰烬吞下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398937&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'31e0c273-6b69-4ef9-b6de-35f02736af97\', \'multiverseId\': 398937}, \'multiverseid\': 398937}, {\'name\': \'熾焰地獄犬\', \'text\': \'{1}，犧牲另一個生物：熾焰地獄犬對目標生物或玩家造成1點傷害。\', \'type\': \'生物～元素／獵犬\', \'flavor\': \'牠從你的骨頭上咬下肉塊，然後用火熱的巨口將灰燼吞下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399214&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3917788f-7c17-4fa7-9e74-38c95d2ef393\', \'multiverseId\': 399214}, \'multiverseid\': 399214}]', '[{\'name\': \'Goblin-Rudeltreiber\', \'text\': \'Schutz vor Blau (Diese Kreatur kann von nichts Blauem geblockt oder als Ziel bestimmt werden, von ihm Schaden zugefügt bekommen oder von ihm verzaubert werden.)Immer wenn der Goblin-Rudeltreiber angreift, erhält er bis zum Ende des Zuges +2/+0 für jeden anderen angreifenden Goblin.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399368&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9133e8e1-6912-4adb-b820-643594f5d685\', \'multiverseId\': 399368}, \'multiverseid\': 399368}, {\'name\': \'Encabezahorda trasgo\', \'text\': \'Protección contra azul. (Esta criatura no puede ser bloqueada, hecha objetivo, recibir daño de o estar encantada por nada azul.)Siempre que el Encabezahorda trasgo ataque, obtiene +2/+0 hasta el final del turno por cada uno de los demás Trasgos atacantes.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401307&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43bb9e35-4d0d-421f-a770-21980676eb45\', \'multiverseId\': 401307}, \'multiverseid\': 401307}, {\'name\': \'Pelleteur gobelin\', \'text\': "Protection contre le bleu (Cette créature ne peut pas être bloquée, ciblée, blessée ou enchantée par quoi que ce soit de bleu.)À chaque fois que le Pelleteur gobelin attaque, il gagne +2/+0 jusqu\'à la fin du tour pour chaque autre gobelin attaquant.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1bb6bb29-97b0-4735-8df7-bc012208f667\', \'multiverseId\': 399645}, \'multiverseid\': 399645}, {\'name\': \'Scagliaorda Goblin\', \'text\': \'Protezione dal blu (Questa creatura non può essere bloccata, bersagliata, non le può essere inflitto danno, né può essere incantata da nulla di blu.)Ogniqualvolta lo Scagliaorda Goblin attacca, prende +2/+0 fino alla fine del turno per ogni altro Goblin che attacca.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399922&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b261829-38d1-4b17-a598-9b7589f05c5a\', \'multiverseId\': 399922}, \'multiverseid\': 399922}, {\'name\': \'ゴブリンの群衆追い\', \'text\': \'プロテクション（青）（このクリーチャーは青のものによって、ブロックされず、対象にならず、ダメージを与えられず、エンチャントされない。）ゴブリンの群衆追いが攻撃するたび、ターン終了時まで、これは他の攻撃しているゴブリン１体につき＋２/＋０の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400199&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'caccb9c4-f696-4d7f-8060-9e4fea278659\', \'multiverseId\': 400199}, \'multiverseid\': 400199}, {\'name\': \'고블린 파일드라이버\', \'text\': \'청색으로부터 보호 (이 생물은 청색 생물에 방어될 수 없고, 청색 원천의 목표로 정해질 수 없고, 청색 원천으로부터 피해를 입지 않고, 청색 부여마법이 부여될 수 없다.)고블린 파일드라이버가 공격할 때마다, 고블린 파일드라이버는 턴종료까지 공격하는 다른 고블린 한 개당 +2/+0을 받는다.\', \'type\': \'생물 — 고블린 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400476&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5bd93c59-4842-4cda-96dc-01b56b4bb246\', \'multiverseId\': 400476}, \'multiverseid\': 400476}, {\'name\': \'Goblin Bate-estacas\', \'text\': \'Proteção contra o azul (Esta criatura não pode ser bloqueada, ser alvo, sofrer dano ou ser encantada por nada azul.)Toda vez que Goblin Bate-estacas ataca, ele recebe +2/+0 até o final do turno para cada outro Goblin atacante.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5043e26-2ec8-4d33-bab4-09f4a305ca13\', \'multiverseId\': 400753}, \'multiverseid\': 400753}, {\'name\': \'Гоблин-Забойщик\', \'text\': \'Защита от синего (Ни один синий объект не может блокировать это существо, делать его своей целью, наносить ему повреждения и зачаровывать его.)Каждый раз, когда Гоблин-Забойщик атакует, он получает +2/+0 до конца хода за каждого другого атакующего Гоблина.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401030&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30332228-bb2a-47f9-99e0-87c20e2b5aee\', \'multiverseId\': 401030}, \'multiverseid\': 401030}, {\'name\': \'监军鬼怪\', \'text\': \'反蓝保护（此生物不能被蓝色的东西所阻挡、指定为目标、造成伤害或是被结附。）每当监军鬼怪攻击时，每有一个进行攻击的其他鬼怪，它便得+2/+0直到回合结束。\', \'type\': \'生物～鬼怪／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7cc59529-6790-4280-9cc6-1351bad43071\', \'multiverseId\': 398814}, \'multiverseid\': 398814}, {\'name\': \'監軍鬼怪\', \'text\': \'反藍保護（此生物不能被藍色的東西所阻擋、指定為目標、造成傷害、或是被結附。）每當監軍鬼怪攻擊時，每有一個進行攻擊的其他鬼怪，它便得+2/+0直到回合結束。\', \'type\': \'生物～鬼怪／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399091&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'e0d6dc78-1775-4a09-bd09-f627676584f5\', \'multiverseId\': 399091}, \'multiverseid\': 399091}]', '[{\'name\': \'Goblin-Ruhmjäger\', \'text\': \'Ruhm 1 (Wenn diese Kreatur einem Spieler Kampfschaden zufügt und falls sie nicht ruhmvoll ist, lege eine +1/+1-Marke auf sie und sie wird ruhmvoll.)Solange der Goblin-Ruhmjäger ruhmvoll ist, hat er Bedrohlichkeit. (Er kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399429&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'41324f4e-598b-4e74-8e06-35529469578a\', \'multiverseId\': 399429}, \'multiverseid\': 399429}, {\'name\': \'Buscador de gloria trasgo\', \'text\': \'Prestigio 1. (Cuando esta criatura haga daño de combate a un jugador, si no tiene prestigio, pon un contador +1/+1 sobre ella y gana prestigio.)Mientras el Buscador de gloria trasgo tenga prestigio, tiene la habilidad de amenazar. (No puede ser bloqueado excepto por dos o más criaturas.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401368&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'65618ace-e125-4aad-bf19-92a88febe3c4\', \'multiverseId\': 401368}, \'multiverseid\': 401368}, {\'name\': \'Gobelin chasse-gloire\', \'text\': "Réputation 1 (Quand cette créature inflige des blessures de combat à un joueur, si elle n\'est pas réputée, mettez un marqueur +1/+1 sur elle et elle devient réputée.)Tant que le Gobelin chasse-gloire est réputé, il a la menace. (Il ne peut pas être bloqué excepté par deux créatures ou plus.)", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399706&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d8cc36c-6903-43cf-ac4e-8565ae9c1466\', \'multiverseId\': 399706}, \'multiverseid\': 399706}, {\'name\': \'Cercatore di Gloria Goblin\', \'text\': \'Rinomare 1 (Quando questa creatura infligge danno da combattimento a un giocatore, se non è rinomata, metti un segnalino +1/+1 su di essa e diventa rinomata.)Fintanto che il Cercatore di Gloria Goblin è rinomato, ha minacciare. (Non può essere bloccato tranne che da due o più creature.)\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399983&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ddebc69-5230-4470-aa5f-7e8dd16ebbd9\', \'multiverseId\': 399983}, \'multiverseid\': 399983}, {\'name\': \'ゴブリンの栄光追い\', \'text\': \'高名１（このクリーチャーがプレイヤー１人に戦闘ダメージを与えたとき、これが高名でない場合、これの上に＋１/＋１カウンターを１個置く。これは高名になる。）ゴブリンの栄光追いが高名であるかぎり、これは威迫を持つ。（これは２体以上のクリーチャーによってしかブロックされない。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400260&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e64a1903-b751-4aff-bc78-8c9f02383bac\', \'multiverseId\': 400260}, \'multiverseid\': 400260}, {\'name\': \'영광을 추구하는 고블린\', \'text\': \'명성 1 (이 생물이 플레이어에게 전투피해를 입힐 때, 이 생물에 명성이 없다면 +1/+1 카운터 한 개를 올려놓고 이 생물은 명성을 얻는다.)영광을 추구하는 고블린에게 명성이 있는 한, 영광을 추구하는 고블린은 호전적을 가진다. (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)\', \'type\': \'생물 — 고블린 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400537&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'5d005e4f-030a-45a3-ba3b-a4d1dfd647f6\', \'multiverseId\': 400537}, \'multiverseid\': 400537}, {\'name\': \'Goblin Buscador de Glória\', \'text\': \'Renome 1 (Quando esta criatura causar dano de combate a um jogador, se ela não for renomada, coloque um marcador +1/+1 nela e ela se tornará renomada.)Enquanto Goblin Buscador de Glória for renomado, ele terá ameaçar. (Ele só pode ser bloqueado por duas ou mais criaturas.)\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400814&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea88d782-8cab-4dc7-aca2-24d78b5af058\', \'multiverseId\': 400814}, \'multiverseid\': 400814}, {\'name\': \'Гоблинский Охотник за Славой\', \'text\': \'Прославленность 1 (Когда это существо наносит боевые повреждения игроку, если оно не прославлено, положите на него один жетон +1/+1, и оно становится прославленным.)Пока Гоблинский Охотник за Славой прославлен, у него есть Угроза. (Он не может быть заблокирован менее чем двумя существами.)\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401091&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5ddd54af-1ce7-4d53-ad2d-cb31d61f6089\', \'multiverseId\': 401091}, \'multiverseid\': 401091}, {\'name\': \'逐耀鬼怪\', \'text\': \'铭勇1（当此生物对任一牌手造成战斗伤害时，若它未铭勇，则在其上放置一个+1/+1指示物且它已铭勇。）只要逐耀鬼怪已铭勇，它便具有威慑异能。（它只能被两个或更多生物阻挡。）\', \'type\': \'生物～鬼怪／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398875&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'15f89e51-8e95-4c2f-9cea-8f205aed2b86\', \'multiverseId\': 398875}, \'multiverseid\': 398875}, {\'name\': \'逐耀鬼怪\', \'text\': \'銘勇1（當此生物對任一玩家造成戰鬥傷害時，若它未銘勇，則在其上放置一個+1/+1指示物且它已銘勇。）只要逐耀鬼怪已銘勇，它便具有威懾異能。（它只能被兩個或更多生物阻擋。）\', \'type\': \'生物～鬼怪／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399152&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9dfe518a-41a5-4102-a165-0e48b17436aa\', \'multiverseId\': 399152}, \'multiverseid\': 399152}]', '[{\'name\': \'Goldgeschmiedeter Wachposten\', \'text\': \'Fliegend\', \'type\': \'Artefaktkreatur — Chimäre\', \'flavor\': \'Von den Göttern gesegnet. Von den Sterblichen ersehnt. Niemandem verpflichtet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399416&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5980ea3-2dd4-4366-8b71-d0b55ab319aa\', \'multiverseId\': 399416}, \'multiverseid\': 399416}, {\'name\': \'Centinela forjado en oro\', \'text\': \'Vuela.\', \'type\': \'Criatura artefacto — Quimera\', \'flavor\': \'Los dioses lo bendicen. Los mortales lo codician. Ninguno de ellos puede someterlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401355&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'08b6966e-bed5-4769-a2b6-d58949d5ca44\', \'multiverseId\': 401355}, \'multiverseid\': 401355}, {\'name\': "Sentinelle forgée d\'or", \'text\': \'Vol\', \'type\': \'Créature-artefact : chimère\', \'flavor\': "Bénie par les dieux. Convoitée par les mortels. Redevable à nul d\'entre eux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399693&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af22fab4-0bf6-40cf-a6b4-046f3d6e9918\', \'multiverseId\': 399693}, \'multiverseid\': 399693}, {\'name\': "Sentinella Forgiata nell\'Oro", \'text\': \'Volare\', \'type\': \'Creatura Artefatto — Chimera\', \'flavor\': \'Benedetta dagli dei. Desiderata dai mortali. Sottomessa a nessuno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399970&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a89a10b0-0ed0-407c-959a-ea71489cce95\', \'multiverseId\': 399970}, \'multiverseid\': 399970}, {\'name\': \'黄金造りの歩哨\', \'text\': \'飛行\', \'type\': \'アーティファクト・クリーチャー — キマイラ\', \'flavor\': \'神々によって祝福され、定命の者たちによって渇望され、いずれの恩義も受けず。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400247&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2cf26646-b1b9-4db2-b54f-60fd756e919a\', \'multiverseId\': 400247}, \'multiverseid\': 400247}, {\'name\': \'황금 보초\', \'text\': \'비행\', \'type\': \'마법물체 생물 — 키메라\', \'flavor\': \'신들에게 축복받고 필멸자들이 원하지만 어느 쪽에도 기울지 않는다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400524&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9f56e536-3e3e-436e-b3f4-c016b1f210fa\', \'multiverseId\': 400524}, \'multiverseid\': 400524}, {\'name\': \'Sentinela Forjada em Ouro\', \'text\': \'Voar\', \'type\': \'Criatura Artefato — Quimera\', \'flavor\': \'Abençoada pelos deuses. Cobiçada pelos mortais. Leal a nenhum deles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400801&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'915b9d3f-edc6-44c6-aace-915dc586ec49\', \'multiverseId\': 400801}, \'multiverseid\': 400801}, {\'name\': \'Выкованный из Золота Страж\', \'text\': \'Полет\', \'type\': \'Артефакт Существо — Химера\', \'flavor\': \'Благословенна богами. Желанна людьми. Не признательна никому.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401078&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5152252d-bad1-4483-94bc-cbaa7494335e\', \'multiverseId\': 401078}, \'multiverseid\': 401078}, {\'name\': \'金铸哨兵\', \'text\': \'飞行\', \'type\': \'神器生物～盖美拉\', \'flavor\': \'随诸神降福，任众生祈盼，仍无偏无倚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398862&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f6242c8-3f4e-4a71-9a3e-a38e5e2bdbbc\', \'multiverseId\': 398862}, \'multiverseid\': 398862}, {\'name\': \'金鑄哨兵\', \'text\': \'飛行\', \'type\': \'神器生物～蓋美拉\', \'flavor\': \'隨諸神降福，任眾生祈盼，仍無偏無倚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399139&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'7b53ba2f-f875-4ac2-a32f-7ebfee13b4e1\', \'multiverseId\': 399139}, \'multiverseid\': 399139}]', '[{\'name\': \'Grab des Engels\', \'text\': \'Immer wenn eine Kreatur unter deiner Kontrolle ins Spiel kommt, kannst du das Grab des Engels bis zum Ende des Zuges zu einer 3/3 weißen Engel-Artefaktkreatur mit Flugfähigkeit werden lassen.\', \'type\': \'Artefakt\', \'flavor\': \'„Glaube kann selbst die Steine mit Leben erfüllen."—Schriften des Mikaeus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399249&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'743d514e-5136-4f84-8be9-c440c255dd15\', \'multiverseId\': 399249}, \'multiverseid\': 399249}, {\'name\': \'Tumba del ángel\', \'text\': \'Siempre que una criatura entre al campo de batalla bajo tu control, puedes hacer que la Tumba del ángel se convierta en una criatura artefacto Ángel blanca 3/3 con la habilidad de volar hasta el final del turno.\', \'type\': \'Artefacto\', \'flavor\': \'"La fe puede conferir vida a las propias piedras".—Escrituras de Mikaeus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401188&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b9f5977-4a91-47f5-bda0-91f41b69be60\', \'multiverseId\': 401188}, \'multiverseid\': 401188}, {\'name\': "Tombe de l\'ange", \'text\': "À chaque fois qu\'une créature arrive sur le champ de bataille sous votre contrôle, vous pouvez faire que la Tombe de l\'ange devienne une créature-artefact 3/3 blanche Ange avec le vol jusqu\'à la fin du tour.", \'type\': \'Artefact\', \'flavor\': \'« La foi peut donner vie aux pierres elles-mêmes. »—Écrits de Mikaeus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399526&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5ef5a7a-1a37-458a-901b-68c715402276\', \'multiverseId\': 399526}, \'multiverseid\': 399526}, {\'name\': "Sepolcro dell\'Angelo", \'text\': "Ogniqualvolta una creatura entra nel campo di battaglia sotto il tuo controllo, puoi far diventare il Sepolcro dell\'Angelo una creatura artefatto Angelo 3/3 bianca con volare fino alla fine del turno.", \'type\': \'Artefatto\', \'flavor\': \'"La fede può infondere vita persino nelle pietre."—Scritti di Mikaeus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399803&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ecc9091-1e8b-4d65-aef0-02586c9a2c79\', \'multiverseId\': 399803}, \'multiverseid\': 399803}, {\'name\': \'天使の墳墓\', \'text\': \'クリーチャーが１体あなたのコントロール下で戦場に出るたび、あなたは「ターン終了時まで、天使の墳墓は飛行を持つ白の３/３の天使・アーティファクト・クリーチャーになる。」を選んでもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'「信仰は石にさえ命の息吹を与える。」――ミケウスのメモ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400080&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43e46352-ab97-45fb-bcc5-d7df21e8c96d\', \'multiverseId\': 400080}, \'multiverseid\': 400080}, {\'name\': \'천사의 무덤\', \'text\': \'생물이 당신의 조종하에 전장에 들어올 때마다, 당신은 턴종료까지 천사의 무덤을 비행을 가진 3/3 백색 천사 마법물체 생물이 되도록 할 수 있다.\', \'type\': \'마법물체\', \'flavor\': \'"믿음은 돌에도 생명을 불어넣는다."—미케이우스의 저서\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400357&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d1b3cd8c-13df-45e2-b838-852826837101\', \'multiverseId\': 400357}, \'multiverseid\': 400357}, {\'name\': \'Tumba de Anjo\', \'text\': \'Toda vez que uma criatura entra no campo de batalha sob o seu controle, você pode fazer com que Tumba de Anjo se torne uma criatura artefato branca 3/3 do tipo Anjo com voar até o final do turno.\', \'type\': \'Artefato\', \'flavor\': \'"A fé pode dar vida até mesmo às pedras."— Escritos de Mikaeus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400634&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'485961f7-333c-4e88-a2de-acc152d013af\', \'multiverseId\': 400634}, \'multiverseid\': 400634}, {\'name\': \'Гробница Ангела\', \'text\': \'Каждый раз, когда существо выходит на поле битвы под вашим контролем, вы можете заставить Гробницу Ангела стать артефактом существом 3/3 белый Ангел с Полетом до конца хода.\', \'type\': \'Артефакт\', \'flavor\': \'«Вера может оживить даже камни».— Из записей Микеаса\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400911&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed3ec37b-4682-4c95-be58-55497ebd68dc\', \'multiverseId\': 400911}, \'multiverseid\': 400911}, {\'name\': \'天使之墓\', \'text\': \'每当一个生物在你的操控下进战场时，你可以令天使之墓成为3/3白色，具飞行异能的天使神器生物直到回合结束。\', \'type\': \'神器\', \'flavor\': \'「信念能替顽石激发生命。」～米凯耶的著作\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398695&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c79df5d6-9d13-4789-99df-59bad0add6e3\', \'multiverseId\': 398695}, \'multiverseid\': 398695}, {\'name\': \'天使之墓\', \'text\': \'每當一個生物在你的操控下進戰場時，你可以令天使之墓成為3/3白色，具飛行異能的天使神器生物直到回合結束。\', \'type\': \'神器\', \'flavor\': \'「信念能替頑石激發生命。」～米凱耶的著作\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398972&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f85a316b-a979-457a-8010-48c8b421acd1\', \'multiverseId\': 398972}, \'multiverseid\': 398972}]', '[{\'name\': \'Grabklingenmarodeur\', \'text\': \'Todesberührung (Eine beliebige Menge Schadenspunkte, die er einer Kreatur zufügt, sind ausreichend, um diese zu zerstören.)Immer wenn der Grabklingenmarodeur einem Spieler Kampfschaden zufügt, verliert dieser Spieler Lebenspunkte in Höhe der Anzahl an Kreaturenkarten in deinem Friedhof.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399357&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a064c0e-37c6-4e07-9eaa-093d4c994ba9\', \'multiverseId\': 399357}, \'multiverseid\': 399357}, {\'name\': \'Merodeador filotumba\', \'text\': \'Toque mortal. (Cualquier cantidad de daño que esta carta haga a una criatura es suficiente para destruirla.)Siempre que el Merodeador filotumba haga daño de combate a un jugador, ese jugador pierde una cantidad de vidas igual a la cantidad de cartas de criatura que haya en tu cementerio.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401296&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2c32e74-5eb5-4900-a691-9595114305f9\', \'multiverseId\': 401296}, \'multiverseid\': 401296}, {\'name\': \'Maraudeur à lame sépulcrale\', \'text\': "Contact mortel (Le nombre de blessures que cette créature inflige à une créature, quel qu\'il soit, est suffisant pour la détruire.)À chaque fois que le Maraudeur à lame sépulcrale inflige des blessures de combat à un joueur, ce joueur perd un nombre de points de vie égal au nombre de cartes de créature dans votre cimetière.", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399634&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60c94038-7dfc-4df0-86cb-45ba1f7fab21\', \'multiverseId\': 399634}, \'multiverseid\': 399634}, {\'name\': \'Predatore della Lama Funerea\', \'text\': \'Tocco letale (Qualsiasi danno che questa creatura infligge a una creatura è sufficiente a distruggerla.)Ogniqualvolta il Predatore della Lama Funerea infligge danno da combattimento a un giocatore, quel giocatore perde punti vita pari al numero di carte creatura nel tuo cimitero.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399911&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d724209-14aa-4dbc-9a0a-c37c70a887d8\', \'multiverseId\': 399911}, \'multiverseid\': 399911}, {\'name\': \'墓刃の匪賊\', \'text\': \'接死（これが何らかのダメージをクリーチャーに与えたら、それだけで破壊する。）墓刃の匪賊がプレイヤー１人に戦闘ダメージを与えるたび、そのプレイヤーはあなたの墓地にあるクリーチャー・カードの枚数に等しい点数のライフを失う。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400188&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3c6cf113-43a9-4956-ab42-7c32b97c17ae\', \'multiverseId\': 400188}, \'multiverseid\': 400188}, {\'name\': \'무덤칼 약탈자\', \'text\': \'치명타 (이 생물에 피해를 입은 생물은 피해의 양에 상관없이 파괴된다.)무덤칼 약탈자가 플레이어에게 전투피해를 입힐 때마다, 그 플레이어는 당신의 무덤에 있는 생물 카드 수만큼의 생명점을 잃는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400465&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c582aeaf-61f8-4bad-a620-1871f3814098\', \'multiverseId\': 400465}, \'multiverseid\': 400465}, {\'name\': \'Saqueador da Lâmina Funesta\', \'text\': \'Toque mortífero (Qualquer quantidade de dano que esta criatura cause a uma criatura é suficiente para destruí-la.)Toda vez que Saqueador da Lâmina Funesta causar dano de combate a um jogador, aquele jogador perde pontos de vida equivalentes ao número de cards de criatura no seu cemitério.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400742&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d9457f51-843b-4ca4-afcf-afbade98c6d1\', \'multiverseId\': 400742}, \'multiverseid\': 400742}, {\'name\': \'Мародер Могильного Клинка\', \'text\': \'Смертельное касание (Любое количество повреждений, которое этот объект наносит существу, достаточно, чтобы его уничтожить.)Каждый раз, когда Мародер Могильного Клинка наносит боевые повреждения игроку, тот игрок теряет количество жизней, равное количеству карт существ на вашем кладбище.\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401019&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'98a44457-3b96-4216-9fd1-2b6b43702ff9\', \'multiverseId\': 401019}, \'multiverseid\': 401019}, {\'name\': \'墓刃劫掠者\', \'text\': \'死触（它对生物造成的任何数量伤害都足以消灭后者。）每当墓刃劫掠者对任一牌手造成战斗伤害时，该牌手失去等同于你坟墓场中生物牌数量的生命。\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398803&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5bfd19fc-f746-4400-8bdb-27ac2e19a4ff\', \'multiverseId\': 398803}, \'multiverseid\': 398803}, {\'name\': \'墓刃劫掠者\', \'text\': \'死觸（它對生物造成的任何數量傷害都足以消滅後者。）每當墓刃劫掠者對任一玩家造成戰鬥傷害時，該玩家失去等同於你墳墓場中生物牌數量的生命。\', \'type\': \'生物～人類／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399080&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'1211112f-0b50-4a43-8aa2-21b937439050\', \'multiverseId\': 399080}, \'multiverseid\': 399080}]', '[{\'name\': \'Grausame Wiederbelebung\', \'text\': \'Zerstöre eine Nicht-Zombie-Kreatur deiner Wahl. Sie kann nicht regeneriert werden. Bringe bis zu eine Zombie-Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'Auf Innistrad verschrieb sich Liliana der Nekromagie und verfeinerte ihr Können, indem sie an unzähligen Untoten übte … und an einigen Lebenden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399246&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cba10492-8558-4d9d-a85c-91256ba35ee8\', \'multiverseId\': 399246}, \'multiverseid\': 399246}, {\'name\': \'Resucitación cruel\', \'text\': \'Destruye la criatura objetivo que no sea Zombie. No puede ser regenerada. Regresa hasta una carta objetivo de Zombie de tu cementerio a tu mano.\', \'type\': \'Instantáneo\', \'flavor\': \'En Innistrad, Liliana abrazó la nigromancia y perfeccionó sus poderes practicando con decenas de muertos vivientes... y a veces con los vivos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401185&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e7940ac-8971-4f71-acd9-d708e960a27e\', \'multiverseId\': 401185}, \'multiverseid\': 401185}, {\'name\': \'Réanimation cruelle\', \'text\': "Détruisez la créature non-Zombie ciblée. Elle ne peut pas être régénérée. Renvoyez jusqu\'à une carte de zombie ciblée depuis votre cimetière dans votre main.", \'type\': \'Éphémère\', \'flavor\': "Sur Innistrad, Liliana s\'était passionnée pour la nécromancie, perfectionnant ses pouvoirs sur des dizaines de morts-vivants... et parfois les vivants.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399523&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d6d20273-6641-4be4-a8d3-621884855207\', \'multiverseId\': 399523}, \'multiverseid\': 399523}, {\'name\': \'Rinascita Crudele\', \'text\': \'Distruggi una creatura non Zombie bersaglio. Non può essere rigenerata. Riprendi in mano fino a una carta Zombie bersaglio dal tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': "Su Innistrad, Liliana abbracciò l\'arte della necromanzia, affinando i suoi poteri con esperimenti su un gran numero di non morti e talvolta sui vivi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399800&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b43b03b-b1f6-4989-9c3b-5f7810214a21\', \'multiverseId\': 399800}, \'multiverseid\': 399800}, {\'name\': \'残酷な蘇生\', \'text\': \'ゾンビでないクリーチャー１体を対象とし、それを破壊する。それは再生できない。あなたの墓地にあるゾンビ・カードを最大１枚まで対象とし、それをあなたの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'イニストラードでリリアナは屍術を受け入れ、数多くの不死者たち、そして時には生ある者たちを実験台として、その実力を磨いてきた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400077&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4efcccde-81bf-476a-8c0a-a45f50615b42\', \'multiverseId\': 400077}, \'multiverseid\': 400077}, {\'name\': \'가혹한 부활\', \'text\': \'좀비가 아닌 생물을 목표로 정한다. 그 생물을 파괴한다. 그 생물은 재생될 수 없다. 당신의 무덤에 있는 좀비 카드를 최대 한 장까지 목표로 정한다. 그 카드를 당신의 무덤에서 당신의 손으로 되돌린다.\', \'type\': \'순간마법\', \'flavor\': \'릴리아나는 이니스트라드에서 사령술을 받아들였다. 그녀는 수많은 시체로 자신의 기술을 연마했고, 때로는 멀쩡한 사람을 상대로 연습했다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400354&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'35a42983-a0be-4b0d-a8ff-7b391f10469c\', \'multiverseId\': 400354}, \'multiverseid\': 400354}, {\'name\': \'Renascimento Cruel\', \'text\': \'Destrua a criatura alvo que não seja Zumbi. Ela não pode ser regenerada. Devolva até um card alvo do tipo Zumbi de seu cemitério para sua mão.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Em Innistrad, Liliana abraçou a necromancia, aprimorando seus poderes nas hordas de mortos-vivos e, às vezes, nos vivos também.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400631&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3eefc24e-4823-495f-b226-e3348f9e1eeb\', \'multiverseId\': 400631}, \'multiverseid\': 400631}, {\'name\': \'Жестокое Оживление\', \'text\': \'Уничтожьте целевое существо, не являющееся Зомби. Оно не может быть регенерировано. Верните не более одной целевой карты Зомби из вашего кладбища в вашу руку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В Иннистраде Лилиана изучала некромантию, оттачивая свое мастерство на многочисленной нежити... а иногда и на живых.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400908&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'780e9547-7e74-4dc8-8a6d-04e35062d12c\', \'multiverseId\': 400908}, \'multiverseid\': 400908}, {\'name\': \'残酷复生\', \'text\': \'消灭目标非灵俑的生物。它不能重生。将至多一张目标灵俑牌从你的坟墓场移回你手上。\', \'type\': \'瞬间\', \'flavor\': \'莉莲娜在依尼翠钻研死灵术，拿无数不死生物来磨练她的技艺，有时甚至用上活物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398692&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1391ea46-56e6-4d8b-ae3f-6e54a1835112\', \'multiverseId\': 398692}, \'multiverseid\': 398692}, {\'name\': \'殘酷復生\', \'text\': \'消滅目標非殭屍的生物。它不能重生。將至多一張目標殭屍牌從你的墳墓場移回你手上。\', \'type\': \'瞬間\', \'flavor\': \'莉蓮娜在依尼翠鑽研死靈術，拿無數不死生物來磨練她的技藝，有時甚至用上活物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398969&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8b36f1b1-e73a-43f9-b9c8-52cee751d473\', \'multiverseId\': 398969}, \'multiverseid\': 398969}]', '[{\'name\': \'Griff des Hieromanten\', \'text\': \'Verzaubert eine KreaturDie verzauberte Kreatur erhält +1/+1 und hat „Immer wenn diese Kreatur angreift, tappe eine Kreatur deiner Wahl, die der verteidigende Spieler kontrolliert."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Unbekümmertheit verleiht Macht, Kontrolle jedoch noch viel mehr."—Wärter Hixus zu Kytheon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399389&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa161cbe-c01b-40b1-8a1c-27e9d103c1ca\', \'multiverseId\': 399389}, \'multiverseid\': 399389}, {\'name\': \'Yugo del hieromante\', \'text\': \'Encantar criatura.La criatura encantada obtiene +1/+1 y tiene "Siempre que esta criatura ataque, gira la criatura objetivo que controla el jugador defensor".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Hay poder en el abandono, pero hay mucho más en el control".—Carcelero Hixus, a Kytheon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401328&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ee8ce8c1-5fc1-46ce-a0e6-9433401c865f\', \'multiverseId\': 401328}, \'multiverseid\': 401328}, {\'name\': \'Emprise du hiéromancien\', \'text\': \'Enchanter : créatureLa créature enchantée gagne +1/+1 et a « À chaque fois que cette créature attaque, engagez une créature ciblée que le joueur défenseur contrôle. »\', \'type\': \'Enchantement : aura\', \'flavor\': "« L\'abandon est source de puissance, mais bien moins que le contrôle. »—Gardien Hixus, à Kytheon", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399666&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb13b56d-fc65-4d12-b4dc-e857afc3b131\', \'multiverseId\': 399666}, \'multiverseid\': 399666}, {\'name\': \'Vincolo dello Ieromante\', \'text\': \'Incanta creaturaLa creatura incantata prende +1/+1 e ha "Ogniqualvolta questa creatura attacca, TAPpa una creatura bersaglio controllata dal giocatore in difesa".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Nella sfrenatezza c\\\'è potere, nel controllo molto di più."—Guardiano Hixus, a Kytheon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e5f6fdf5-68b7-4d79-adae-e3c2130a123a\', \'multiverseId\': 399943}, \'multiverseid\': 399943}, {\'name\': \'秘儀術師の掌握\', \'text\': \'エンチャント（クリーチャー）エンチャントされているクリーチャーは＋１/＋１の修整を受けるとともに「このクリーチャーが攻撃するたび、防御プレイヤーがコントロールするクリーチャー１体を対象とし、それをタップする。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「放縦さにも力はあるが、制御にはさらに多くの力がある。」――牢獄の管理人ヒクサスからキテオンへ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400220&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b53d8be5-f9bd-4841-b952-8369223e563f\', \'multiverseId\': 400220}, \'multiverseid\': 400220}, {\'name\': \'성령술사의 구속\', \'text\': \'생물에 부여부여된 생물은 +1/+1을 받고 "이 생물이 공격할 때마다, 수비플레이어가 조종하는 생물을 목표로 정한다. 그 생물을 탭한다"를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"포기하는 데에도 힘이 필요하지만 지배하려면 더 큰 힘이 필요하다."—간수 힉서스가 키세온에게\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400497&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e59a39d8-ab83-4008-8c57-dc85344a7bec\', \'multiverseId\': 400497}, \'multiverseid\': 400497}, {\'name\': \'Garra do Hieromante\', \'text\': \'Encantar criaturaA criatura encantada recebe +1/+1 e tem "Toda vez que esta criatura atacar, vire a criatura alvo que o jogador defensor controla."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Há poder no abandono, mas há ainda mais poder no controle."— Carcereiro Hixus, para Quiteon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f5e1a654-02be-4293-9bd3-1203c902478a\', \'multiverseId\': 400774}, \'multiverseid\': 400774}, {\'name\': \'Хватка Иероманта\', \'text\': \'Зачаровать существоЗачарованное существо получает +1/+1 и имеет способность «Каждый раз, когда это существо атакует, поверните целевое существо под контролем защищающегося игрока».\', \'type\': \'Чары — Аура\', \'flavor\': \'«В несдержанности есть сила, но еще больше силы в контроле».— Надзиратель Хиксус, обращаясь к Китеону\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401051&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2b3b86f-9f5b-49f2-8764-c3a800dd7b4c\', \'multiverseId\': 401051}, \'multiverseid\': 401051}, {\'name\': \'圣术士之攫\', \'text\': \'结附于生物所结附的生物得+1/+1且具有「每当此生物攻击时，横置目标由防御牌手操控的生物。」\', \'type\': \'结界～灵气\', \'flavor\': \'「懂得放弃虽也可贵，但能控制才是力量正道。」～典狱长希瑟思教导库忒昂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398835&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a0048d3c-a958-4f09-89ed-4cf24d24a80a\', \'multiverseId\': 398835}, \'multiverseid\': 398835}, {\'name\': \'聖術士之攫\', \'text\': \'結附於生物所結附的生物得+1/+1且具有「每當此生物攻擊時，橫置目標由防禦玩家操控的生物。」\', \'type\': \'結界～靈氣\', \'flavor\': \'「懂得放棄雖也可貴，但能控制才是力量正道。」～典獄長希瑟思教導庫忒昂\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399112&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'28dcf8ba-2a2f-43d5-be5d-be5cbac3447c\', \'multiverseId\': 399112}, \'multiverseid\': 399112}]', '[{\'name\': \'Göttliches Verdikt\', \'text\': \'Zerstöre eine angreifende oder blockende Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Schuldig."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f29d1bc1-99ab-4fae-a092-c2816be11499\', \'multiverseId\': 401501}, \'multiverseid\': 401501}, {\'name\': \'Veredicto divino\', \'text\': \'Destruye la criatura atacante o bloqueadora objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Culpable".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401613&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'77dac9e0-64ec-4d3a-a2e4-b0754e741b39\', \'multiverseId\': 401613}, \'multiverseid\': 401613}, {\'name\': \'Verdict divin\', \'text\': \'Détruisez la créature attaquante ou bloqueuse ciblée.\', \'type\': \'Éphémère\', \'flavor\': \'« Coupable. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e311295-9e1d-4b74-8be7-8a37c57cfb31\', \'multiverseId\': 401517}, \'multiverseid\': 401517}, {\'name\': \'Verdetto Divino\', \'text\': \'Distruggi una creatura attaccante o bloccante bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Colpevole."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401533&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2bdecd09-6cbc-4b12-95b6-2b1ef03bcb04\', \'multiverseId\': 401533}, \'multiverseid\': 401533}, {\'name\': \'神聖なる評決\', \'text\': \'攻撃かブロックしているクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「有罪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401549&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f06c8f4d-0797-4150-8376-6821d17e1629\', \'multiverseId\': 401549}, \'multiverseid\': 401549}, {\'name\': \'신의 판결\', \'text\': \'공격생물 또는 방어생물을 목표로 정한다. 그 생물을 파괴한다.\', \'type\': \'순간마법\', \'flavor\': \'"유죄."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401565&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a636ff59-ce53-4351-a55c-8e5a6804809d\', \'multiverseId\': 401565}, \'multiverseid\': 401565}, {\'name\': \'Veredito Divino\', \'text\': \'Destrua a criatura atacante ou bloqueadora alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Culpado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401581&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'58da688f-a248-4b50-a10d-58bac5bbfc49\', \'multiverseId\': 401581}, \'multiverseid\': 401581}, {\'name\': \'Божественный Приговор\', \'text\': \'Уничтожьте целевое атакующее или блокирующее существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Виновен».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401597&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c9f3e413-abc7-45f5-acd9-8075ce2234f9\', \'multiverseId\': 401597}, \'multiverseid\': 401597}, {\'name\': \'明圣裁定\', \'text\': \'消灭目标进行攻击或阻挡的生物。\', \'type\': \'瞬间\', \'flavor\': \'「有罪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401469&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fa7b173a-0237-4cc5-a91b-5972fa22d84c\', \'multiverseId\': 401469}, \'multiverseid\': 401469}, {\'name\': \'明聖裁定\', \'text\': \'消滅目標進行攻擊或阻擋的生物。\', \'type\': \'瞬間\', \'flavor\': \'「有罪。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401485&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3d4721df-c3ef-4149-87d8-1c42ca9a0afb\', \'multiverseId\': 401485}, \'multiverseid\': 401485}]', '[{\'name\': \'Güldenlaub-Ausdünner\', \'text\': \'Bedrohlich (Diese Kreatur kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.)Wenn der Güldenlaub-Ausdünner ins Spiel kommt, kannst du eine Nicht-Elf-Kreatur deiner Wahl, deren Stärke und Widerstandskraft ungleich sind, zerstören.\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399326&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'74614161-af59-4f9f-a183-39b90eddde3a\', \'multiverseId\': 399326}, \'multiverseid\': 399326}, {\'name\': \'Aventador de Hojas Doradas\', \'text\': \'Amenaza. (Esta criatura no puede ser bloqueada excepto por dos o más criaturas.)Cuando el Aventador de Hojas Doradas entre al campo de batalla, puedes destruir la criatura objetivo que no sea Elfo cuya fuerza y resistencia no sean iguales.\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'46fb6fce-55a5-4347-8ab3-c8b194ab5867\', \'multiverseId\': 401265}, \'multiverseid\': 401265}, {\'name\': \'Vanneur de Feuilledor\', \'text\': "Menace (Cette créature ne peut pas être bloquée excepté par deux créatures ou plus.)Quand le Vanneur de Feuilledor arrive sur le champ de bataille, vous pouvez détruire une créature non-Elfe ciblée dont la force et l\'endurance ne sont pas égales.", \'type\': \'Créature : elfe et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399603&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85d5db56-d364-435a-bb52-ef146d47022a\', \'multiverseId\': 399603}, \'multiverseid\': 399603}, {\'name\': \'Setacciatore di Foglia Dorata\', \'text\': \'Minacciare (Questa creatura non può essere bloccata tranne che da due o più creature.)Quando il Setacciatore di Foglia Dorata entra nel campo di battaglia, puoi distruggere una creatura non Elfo bersaglio con forza e costituzione diverse tra loro.\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399880&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6b8d87d-d114-40b8-92cd-6634c4bec895\', \'multiverseId\': 399880}, \'multiverseid\': 399880}, {\'name\': \'光り葉の選別者\', \'text\': \'威迫（このクリーチャーは２体以上のクリーチャーによってしかブロックされない。）光り葉の選別者が戦場に出たとき、パワーとタフネスが異なる、エルフでないクリーチャー１体を対象とする。あなたはそれを破壊してもよい。\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400157&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f41c6c71-9e10-4bbd-b7e0-7ef4d70d5a0f\', \'multiverseId\': 400157}, \'multiverseid\': 400157}, {\'name\': \'금박나뭇잎 타작인\', \'text\': \'호전적 (이 생물은 두 개 이상의 생물에만 방어될 수 있다.)금박나뭇잎 타작인이 전장에 들어올 때, 엘프가 아니며 공격력과 방어력이 동일하지 않은 생물을 목표로 정한다. 당신은 그 생물을 파괴할 수 있다.\', \'type\': \'생물 — 엘프 전사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400434&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'79847664-bb05-47f6-ad58-1f92b431b3bd\', \'multiverseId\': 400434}, \'multiverseid\': 400434}, {\'name\': "Peneirador de Folha D\'Ouro", \'text\': "Ameaçar (Esta criatura só pode ser bloqueada por duas ou mais criaturas.)Quando Peneirador de Folha D\'Ouro entra no campo de batalha, você pode destruir a criatura alvo que não seja Elfo cujo poder e resistência não sejam iguais.", \'type\': \'Criatura — Elfo Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400711&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1bbc33f5-0e88-4f1d-b188-2ec516185fc6\', \'multiverseId\': 400711}, \'multiverseid\': 400711}, {\'name\': \'Отсеиватель из Златолесья\', \'text\': \'Угроза (Это существо не может быть заблокировано менее чем двумя существами.)Когда Отсеиватель из Златолесья выходит на поле битвы, вы можете уничтожить целевое не являющееся Эльфом существо, значение силы которого не равно значению выносливости.\', \'type\': \'Существо — Эльф Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400988&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e010df06-0a41-4b2f-9364-a1507cf089d3\', \'multiverseId\': 400988}, \'multiverseid\': 400988}, {\'name\': \'金叶筛除者\', \'text\': \'威慑（此生物只能被两个或更多生物阻挡。）当金叶筛除者进战场时，你可以消灭目标力量与防御力不相等的非妖精生物。\', \'type\': \'生物～妖精／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398772&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04e7f04b-ec46-484c-85f3-7e9d2d99b272\', \'multiverseId\': 398772}, \'multiverseid\': 398772}, {\'name\': \'金葉篩除者\', \'text\': \'威懾（此生物只能被兩個或更多生物阻擋。）當金葉篩除者進戰場時，你可以消滅目標力量與防禦力不相等的非妖精生物。\', \'type\': \'生物～妖精／戰士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399049&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d331c886-a8f6-40e4-baf5-2c69c8a23d29\', \'multiverseId\': 399049}, \'multiverseid\': 399049}]', '[{\'name\': \'Hangar-Schreiter\', \'text\': \'Der Hangar-Schreiter kommt mit X +1/+1-Marken ins Spiel.Wenn der Hangar-Schreiter stirbt, bringe für jede +1/+1-Marke auf dem Hangar-Schreiter einen 1/1 farblosen Thopter-Artefaktkreaturenspielstein mit Flugfähigkeit ins Spiel.{1}, {T}: Lege eine +1/+1-Marke auf den Hangar-Schreiter.\', \'type\': \'Artefaktkreatur — Konstrukt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399403&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'64b64b6e-b9aa-44f9-9609-236eff5eafa1\', \'multiverseId\': 399403}, \'multiverseid\': 399403}, {\'name\': \'Caminante lomohangar\', \'text\': \'El Caminante lomohangar entra al campo de batalla con X contadores +1/+1 sobre él.Cuando el Caminante lomohangar muera, pon en el campo de batalla una ficha de criatura artefacto Tóptero incolora 1/1 con la habilidad de volar por cada contador +1/+1 sobre el Caminante lomohangar.{1}, {T}: Pon un contador +1/+1 sobre el Caminante lomohangar.\', \'type\': \'Criatura artefacto — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401342&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f173a91-cc7f-4729-bb44-02c000b4052e\', \'multiverseId\': 401342}, \'multiverseid\': 401342}, {\'name\': \'Marcheur porte-hangars\', \'text\': \'Le Marcheur porte-hangars arrive sur le champ de bataille avec X marqueurs +1/+1 sur lui.Quand le Marcheur porte-hangars meurt, mettez sur le champ de bataille un jeton de créature-artefact 1/1 incolore Mécanoptère avec le vol pour chaque marqueur +1/+1 sur le Marcheur porte-hangars.{1}, {T} : Mettez un marqueur +1/+1 sur le Marcheur porte-hangars.\', \'type\': \'Créature-artefact : construction\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399680&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a29a54f-fcdd-4637-8dc4-e971f5245072\', \'multiverseId\': 399680}, \'multiverseid\': 399680}, {\'name\': \'Errante Portaturbinanti\', \'text\': "L\'Errante Portaturbinanti entra nel campo di battaglia con X segnalini +1/+1.Quando l\'Errante Portaturbinanti muore, metti sul campo di battaglia una pedina creatura artefatto Tottero 1/1 incolore con volare per ogni segnalino +1/+1 sull\'Errante Portaturbinanti.{1}, {T}: Metti un segnalino +1/+1 sull\'Errante Portaturbinanti.", \'type\': \'Creatura Artefatto — Costrutto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399957&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f072640-e19f-4758-a107-4ae5f62821be\', \'multiverseId\': 399957}, \'multiverseid\': 399957}, {\'name\': \'搭載歩行機械\', \'text\': \'搭載歩行機械は、＋１/＋１カウンターがＸ個置かれた状態で戦場に出る。搭載歩行機械が死亡したとき、これの上に置かれている＋１/＋１カウンター１個につき、飛行を持つ無色の１/１の飛行機械・アーティファクト・クリーチャー・トークンを１体戦場に出す。{1}, {T}：搭載歩行機械の上に＋１/＋１カウンターを１個置く。\', \'type\': \'アーティファクト・クリーチャー — 構築物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400234&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'759a2885-13e5-4165-a52c-3272171e1a32\', \'multiverseId\': 400234}, \'multiverseid\': 400234}, {\'name\': \'이동식 격납기계\', \'text\': \'이동식 격납기계는 +1/+1 카운터 X개를 가진 채로 전장에 들어온다.이동식 격납기계가 죽을 때, 이동식 격납기계에 올려진 각 +1/+1 카운터만큼 비행을 가진 1/1 무색 날틀 마법물체 생물 토큰을 전장에 놓는다.{1}, {T}: 이동식 격납기계에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'마법물체 생물 — 자동기계\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400511&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'44ab8d9d-c795-4603-8d37-24359059192d\', \'multiverseId\': 400511}, \'multiverseid\': 400511}, {\'name\': \'Caminhante Aeródromo\', \'text\': \'Caminhante Aeródromo entra no campo de batalha com X marcadores +1/+1.Quando Caminhante Aeródromo morrer, coloque no campo de batalha uma ficha de criatura artefato incolor 1/1 do tipo Tóptero com voar para cada marcador +1/+1 em Caminhante Aeródromo.{1}, {T}: Coloque um marcador +1/+1 em Caminhante Aeródromo.\', \'type\': \'Criatura Artefato — Constructo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400788&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e126febd-4062-46c8-985d-6a871df5b8b6\', \'multiverseId\': 400788}, \'multiverseid\': 400788}, {\'name\': \'Ангарный Ходун\', \'text\': \'Ангарный Ходун выходит на поле битвы с Х жетонами +1/+1 на нем.Когда Ангарный Ходун умирает, положите на поле битвы одну фишку артефакта существа 1/1 бесцветный Топтер с Полетом за каждый жетон +1/+1 на Ангарном Ходуне.{1}, {T}: положите один жетон +1/+1 на Ангарного Ходуна.\', \'type\': \'Артефакт Существо — Конструкция\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c87f1c82-a611-4bcb-b903-1597c4ef2c9f\', \'multiverseId\': 401065}, \'multiverseid\': 401065}, {\'name\': \'行走机库\', \'text\': \'行走机库进战场时上面有X个+1/+1指示物。当行走机库死去时，其上每有一个+1/+1指示物，便将一个1/1无色，具飞行异能的振翼机衍生神器生物放进战场。{1}，{T}：在行走机库上放置一个+1/+1指示物。\', \'type\': \'神器生物～组构体\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398849&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'76e3b665-6347-42ff-88ee-5f9cd4f765ff\', \'multiverseId\': 398849}, \'multiverseid\': 398849}, {\'name\': \'行走機庫\', \'text\': \'行走機庫進戰場時上面有X個+1/+1指示物。當行走機庫死去時，其上每有一個+1/+1指示物，便將一個1/1無色，具飛行異能的振翼機衍生神器生物放進戰場。{1}，{T}：在行走機庫上放置一個+1/+1指示物。\', \'type\': \'神器生物～組構體\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399126&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d8d91f16-1db9-41b6-aa67-8cab7ca65ba1\', \'multiverseId\': 399126}, \'multiverseid\': 399126}]', '[{\'name\': \'Hautfetzen-Sceada\', \'text\': \'Fliegend (Diese Kreatur kann außer von fliegenden Kreaturen und Kreaturen mit Reichweite nicht geblockt werden.)Der Hautfetzen-Sceada kann nur fliegende Kreaturen blocken.\', \'type\': \'Kreatur — Zombie, Sceada\', \'flavor\': \'„Die Katharer haben meine Skaab unten am Boden getötet. Mal schauen, wie hoch ihre Schwerter reichen."—Ludevic, Nekro-Alchemist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399309&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f0de524-fa8f-485e-84bf-2d5546333a71\', \'multiverseId\': 399309}, \'multiverseid\': 399309}, {\'name\': \'Draco sobrapiel\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar o alcance.)El Draco sobrapiel solo puede bloquear a criaturas con la habilidad de volar.\', \'type\': \'Criatura — Draco zombie\', \'flavor\': \'"Los cátaros mataron a mis skaabs allí abajo. Veamos cuán alto alcanzan sus espadas".—Ludevic, necro-alquimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401248&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2bc35ade-0eff-4a60-9f04-b0d03109bbf8\', \'multiverseId\': 401248}, \'multiverseid\': 401248}, {\'name\': \'Drakôn desquamé\', \'text\': \'Vol (Cette créature ne peut pas être bloquée excepté par des créatures avec le vol ou la portée.)Le Drakôn desquamé ne peut bloquer que les créatures avec le vol.\', \'type\': \'Créature : zombie et drakôn\', \'flavor\': \'« Les cathares ont tué mes skaabs au sol. Voyons maintenant à quelle altitude portent leurs épées. »—Ludevic, nécro-alchimiste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399586&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0541c9b5-15b0-40da-aa35-7bd2f0d808c8\', \'multiverseId\': 399586}, \'multiverseid\': 399586}, {\'name\': \'Draghetto dalla Pelle a Brandelli\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare o raggiungere.)Il Draghetto dalla Pelle a Brandelli può bloccare solo creature con volare.\', \'type\': \'Creatura — Draghetto Zombie\', \'flavor\': \'"I catari hanno ucciso i miei skaab, là sotto. Vediamo quanto possono arrivare in alto le loro spade."—Ludevic, necro-alchimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399863&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce91023e-3af8-43fa-ae3a-0a686d677bae\', \'multiverseId\': 399863}, \'multiverseid\': 399863}, {\'name\': \'屑肌のドレイク\', \'text\': \'飛行（このクリーチャーは飛行や到達を持たないクリーチャーによってブロックされない。）屑肌のドレイクは飛行を持つクリーチャーのみをブロックできる。\', \'type\': \'クリーチャー — ゾンビ・ドレイク\', \'flavor\': \'「聖戦士達が下で私のスカーブを殺したようだ。その剣がどれほどの高さまで届くか見てやろうじゃないか。」――屍錬金術師、ルーデヴィック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400140&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4579609-d783-4ff4-b686-9061a619dd9b\', \'multiverseId\': 400140}, \'multiverseid\': 400140}, {\'name\': \'누더기피부 드레이크\', \'text\': \'비행 (이 생물은 비행이나 대공을 가진 생물에만 방어될 수 있다.)누더기피부 드레이크는 비행을 가진 생물만 방어할 수 있다.\', \'type\': \'생물 — 좀비 드레이크\', \'flavor\': \'"카타르 놈들, 감히 지상에 있는 내 스캅들을 죽였겠다. 녀석들이 높은 곳에 있는 적을 어떻게 상대하는지 볼까."—사령연금술사 루데비치\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400417&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'fc10483b-8291-4435-bdda-9f52b77e7b4d\', \'multiverseId\': 400417}, \'multiverseid\': 400417}, {\'name\': \'Dragonete Remendado\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com voar ou alcance.)Dragonete Remendado só pode bloquear criaturas com voar.\', \'type\': \'Criatura — Zumbi Dragonete\', \'flavor\': \'"Os cátaros mataram meus skaabs lá embaixo. Vamos ver quão alto vão suas espadas."— Ludevic, necroalquimista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400694&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e1d24f11-16ff-4027-b1d7-0416396a41c2\', \'multiverseId\': 400694}, \'multiverseid\': 400694}, {\'name\': \'Лоскутный Дрейк\', \'text\': \'Полет (Это существо может быть заблокировано только существами с Полетом или Захватом.)Лоскутный Дрейк может блокировать только существа с Полетом.\', \'type\': \'Существо — Зомби Дрейк\', \'flavor\': \'«Катары отправили моих скаабов в преисподнюю. Посмотрим, как высоко смогут дотянуться их мечи».— Людевик, некроалхимик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400971&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5c48e6ec-dcbd-47cb-82a5-8e10ac8e8d82\', \'multiverseId\': 400971}, \'multiverseid\': 400971}, {\'name\': \'废皮龙兽\', \'text\': \'飞行 （此生物只能被具飞行或延势异能的生物阻挡。）废皮龙兽只能阻挡具飞行异能的生物。\', \'type\': \'生物～灵俑／龙兽\', \'flavor\': \'「护教军在底下杀死我的尸嵌。且瞧瞧他们的剑能挥得多高。」～死灵炼金术士卢德维\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398755&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e32e189-c4bc-4673-b0fa-050cff9b69f9\', \'multiverseId\': 398755}, \'multiverseid\': 398755}, {\'name\': \'廢皮龍獸\', \'text\': \'飛行 （此生物只能被具飛行或延勢異能的生物阻擋。）廢皮龍獸只能阻擋具飛行異能的生物。\', \'type\': \'生物～殭屍／龍獸\', \'flavor\': \'「護教軍在底下殺死我的屍嵌。且瞧瞧他們的劍能揮得多高。」～死靈鍊金術士盧德維\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399032&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f6cc0b77-9342-43d8-9b27-d460404ad715\', \'multiverseId\': 399032}, \'multiverseid\': 399032}]', "[{'name': 'Heilende Hände', 'text': 'Ein Spieler deiner Wahl erhält 4 Lebenspunkte dazu.Ziehe eine Karte.', 'type': 'Hexerei', 'flavor': 'Die ätherische Berührung erleichtert. Die physische Berührung beruhigt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399394&type=card', 'language': 'German', 'identifiers': {'scryfallId': '49d3af0a-17cf-4a93-831c-f02b39e34887', 'multiverseId': 399394}, 'multiverseid': 399394}, {'name': 'Manos sanadoras', 'text': 'El jugador objetivo gana 4 vidas.Roba una carta.', 'type': 'Conjuro', 'flavor': 'El toque etéreo trae el alivio. El toque físico trae la paz.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401333&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ca1a98a3-4840-4934-95cd-d00072e3ae3f', 'multiverseId': 401333}, 'multiverseid': 401333}, {'name': 'Mains curatives', 'text': 'Le joueur ciblé gagne 4 points de vie.Piochez une carte.', 'type': 'Rituel', 'flavor': 'Le contact éthéré apporte le soulagement. Le contact physique apporte la paix.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399671&type=card', 'language': 'French', 'identifiers': {'scryfallId': '481abc02-0e84-49d4-8607-547ac03b1121', 'multiverseId': 399671}, 'multiverseid': 399671}, {'name': 'Mani della Guarigione', 'text': 'Un giocatore bersaglio guadagna 4 punti vita.Pesca una carta.', 'type': 'Stregoneria', 'flavor': 'Il tocco etereo dona conforto. Il tocco fisico dona pace.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399948&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '52fad1c7-4a20-43c4-ab7b-eac9c003c8b7', 'multiverseId': 399948}, 'multiverseid': 399948}, {'name': '治癒の手', 'text': 'プレイヤー１人を対象とする。そのプレイヤーは４点のライフを得る。カードを１枚引く。', 'type': 'ソーサリー', 'flavor': '霊気による接触は安心をもたらす。肉体による接触は安穏をもたらす。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400225&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bd123b95-b0f2-4e45-9e89-1c657a2c8926', 'multiverseId': 400225}, 'multiverseid': 400225}, {'name': '치유의 손길', 'text': '플레이어를 목표로 정한다. 그 플레이어는 생명 4점을 얻는다.카드 한 장을 뽑는다.', 'type': '집중마법', 'flavor': '에테르 요법은 환자를 안심시킨다. 반면 물리적인 치료는 환자에게 안식을 준다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400502&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '772ac45a-93e5-409f-ab34-48ae9ccd9ce2', 'multiverseId': 400502}, 'multiverseid': 400502}, {'name': 'Mãos Curativas', 'text': 'O jogador alvo ganha 4 pontos de vida.Compre um card.', 'type': 'Feitiço', 'flavor': 'O toque etéreo traz alívio. O toque físico traz a paz.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400779&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'adf9d058-cc59-48f4-b048-f7c1fc7e2792', 'multiverseId': 400779}, 'multiverseid': 400779}, {'name': 'Руки Целителя', 'text': 'Целевой игрок получает 4 жизни.Возьмите карту.', 'type': 'Волшебство', 'flavor': 'Духовное касание несет облегчение. Телесное касание несет покой.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401056&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '606f5979-65ea-41ba-83e6-f4a6b24dc600', 'multiverseId': 401056}, 'multiverseid': 401056}, {'name': '治疗之手', 'text': '目标牌手获得4点生命。抓一张牌。', 'type': '法术', 'flavor': '虚缈之手使人宽心。现实之手让人释怀。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398840&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6de952e5-7156-42eb-86aa-2d0f007374a8', 'multiverseId': 398840}, 'multiverseid': 398840}, {'name': '治療之手', 'text': '目標玩家獲得4點生命。抽一張牌。', 'type': '巫術', 'flavor': '虛緲之手使人寬心。現實之手讓人釋懷。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399117&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '03b6c7ea-b389-47be-a7b8-ca92c9afe5d0', 'multiverseId': 399117}, 'multiverseid': 399117}]", '[{\'name\': \'Helm der Götter\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1 für jede Verzauberung, die du kontrollierst.Ausrüsten {1} ({1}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Seine Segnungen sind so zahlreich wie die Sterne von Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399419&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3cbab137-2f9b-4ee6-be29-b1e1a141d49a\', \'multiverseId\': 399419}, \'multiverseid\': 399419}, {\'name\': \'Yelmo de los dioses\', \'text\': \'La criatura equipada obtiene +1/+1 por cada encantamiento que controlas.Equipar {1}. ({1}: Anexa este equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Sus bendiciones son tan numerosas como las estrellas de Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401358&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11a14ea2-2b21-4379-9b74-fb081c8e3c60\', \'multiverseId\': 401358}, \'multiverseid\': 401358}, {\'name\': \'Heaume des dieux\', \'text\': "La créature équipée gagne +1/+1 pour chaque enchantement que vous contrôlez.Équipement {1} ({1} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': \'Ses bénédictions sont aussi nombreuses que les étoiles de Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399696&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'210b8222-6418-447c-888a-23baef5e1b54\', \'multiverseId\': 399696}, \'multiverseid\': 399696}, {\'name\': \'Elmo degli Dei\', \'text\': \'La creatura equipaggiata prende +1/+1 per ogni incantesimo che controlli.Equipaggiare {1} ({1}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Le sue benedizioni sono numerose come le stelle di Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399973&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e06ce5d4-a51c-43ae-8567-505fede18067\', \'multiverseId\': 399973}, \'multiverseid\': 399973}, {\'name\': \'神々の兜\', \'text\': \'装備しているクリーチャーは、あなたがコントロールするエンチャント１つにつき＋１/＋１の修整を受ける。装備{1}（{1}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'それが受けた祝福はニクスにある星の数に匹敵する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400250&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'130a5a76-969e-493d-a8aa-6bf3ac89eed6\', \'multiverseId\': 400250}, \'multiverseid\': 400250}, {\'name\': \'신들의 투구\', \'text\': \'장착된 생물은 당신이 조종하는 부여마법 한 개당 +1/+1을 받는다.장착 {1} ({1}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 이 능력을 활성화할 수 있다.\', \'type\': \'마법물체 — 장비\', \'flavor\': \'이 투구에 깃든 축복은 닉스의 별만큼 많다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400527&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'9a433280-06f1-4ee1-9ca0-adaea185c352\', \'multiverseId\': 400527}, \'multiverseid\': 400527}, {\'name\': \'Elmo dos Deuses\', \'text\': \'A criatura equipada recebe +1/+1 para cada encantamento que você controla.Equipar {1} ({1}: Anexe-o à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'Suas bênçãos são tão numerosas quanto as estrelas de Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400804&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ef716883-b384-48e9-a4fa-da5a3b678702\', \'multiverseId\': 400804}, \'multiverseid\': 400804}, {\'name\': \'Шлем Богов\', \'text\': \'Снаряженное существо получает +1/+1 за каждые чары под вашим контролем.Снарядить {1} ({1}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'Благословения на нем бесчисленны, как звезды Никса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401081&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'82d56441-96e0-40f1-8033-f2d81320d359\', \'multiverseId\': 401081}, \'multiverseid\': 401081}, {\'name\': \'众神之盔\', \'text\': \'你每操控一个结界，佩带此武具的生物便得+1/+1。佩带{1}（{1}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': \'其上祝福多如尼兹繁星。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398865&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'84fba7f9-67ad-41c4-87e8-e6efb1f22093\', \'multiverseId\': 398865}, \'multiverseid\': 398865}, {\'name\': \'諸神之盔\', \'text\': \'你每操控一個結界，佩帶此武具的生物便得+1/+1。佩帶{1}（{1}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器～武具\', \'flavor\': \'其上祝福多如尼茲繁星。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399142&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5f533df8-30e1-4bd7-bcd1-206fc729bf82\', \'multiverseId\': 399142}, \'multiverseid\': 399142}]', '[{\'name\': \'Heroldin des Pantheons\', \'text\': \'Verzauberungszauber, die du wirkst, kosten beim Wirken {1} weniger.Immer wenn du einen Verzauberungszauber wirkst, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Zentaur, Schamane\', \'flavor\': \'Die Auszeichnung, zum Bannerträger der Götter auserkoren zu werden, ist nichts verglichen mit der Ehre, Nyx näher sein zu dürfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399291&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc8c227d-ecbd-4a69-bd1a-a40097f48faa\', \'multiverseId\': 399291}, \'multiverseid\': 399291}, {\'name\': \'Heraldo del panteón\', \'text\': \'Te cuesta {1} menos lanzar los hechizos de encantamiento.Siempre que lances un hechizo de encantamiento, ganas 1 vida.\', \'type\': \'Criatura — Chamán centauro\', \'flavor\': \'La distinción de portar el estandarte de los dioses no es nada comparada con la gloria de estar más cerca de Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e1fff31-6d15-4173-bfb8-b1bc24a9a6b9\', \'multiverseId\': 401230}, \'multiverseid\': 401230}, {\'name\': \'Héraut du panthéon\', \'text\': "Les sorts d\'enchantement que vous lancez coûtent {1} de moins à lancer.À chaque fois que vous lancez un sort d\'enchantement, vous gagnez 1 point de vie.", \'type\': \'Créature : centaure et shamane\', \'flavor\': "Porter l\'étendard des dieux n\'est rien comparé à la gloire d\'être plus proche de Nyx.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399568&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fad73d6-36e2-4068-9958-e9516ced72b4\', \'multiverseId\': 399568}, \'multiverseid\': 399568}, {\'name\': \'Messaggera del Pantheon\', \'text\': \'Le magie incantesimo che lanci costano {1} in meno per essere lanciate.Ogniqualvolta lanci una magia incantesimo, guadagni 1 punto vita.\', \'type\': \'Creatura — Sciamano Centauro\', \'flavor\': "L\'onore di portare il vessillo degli dei non è nulla se paragonato alla gloria di essere più vicini a Nyx.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399845&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'410d2900-44f5-46d7-8089-9677b9c638c6\', \'multiverseId\': 399845}, \'multiverseid\': 399845}, {\'name\': \'万神殿の伝令\', \'text\': \'あなたがエンチャント・呪文を唱えるためのコストは{1}少なくなる。あなたがエンチャント・呪文を１つ唱えるたび、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — ケンタウルス・シャーマン\', \'flavor\': \'神々の戦旗を掲げることができる栄誉など、ニクスに近づくことの栄光と比べたら何でもない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400122&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ac9b112-13ac-4f97-9a48-66cf30f2f9be\', \'multiverseId\': 400122}, \'multiverseid\': 400122}, {\'name\': \'신계의 전령\', \'text\': \'당신이 발동하는 부여마법 주문들은 발동하는 데 {1}이 덜 든다.당신이 부여마법 주문을 발동할 때마다, 당신은 생명 1점을 얻는다.\', \'type\': \'생물 — 켄타우로스 주술사\', \'flavor\': \'신의 기치를 드는 영광은 닉스에 다가가는 영광에 비하면 아무것도 아니다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400399&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d13aa2cc-862a-4ffe-be83-58890909b0a0\', \'multiverseId\': 400399}, \'multiverseid\': 400399}, {\'name\': \'Arauto do Panteão\', \'text\': \'As mágicas de encantamentos que você conjura custam {1} a menos para serem conjuradas.Toda vez que você conjura uma mágica de encantamento, você ganha 1 ponto de vida.\', \'type\': \'Criatura — Centauro Xamã\', \'flavor\': \'A honra de carregar o estandarte dos deuses não é nada comparado à glória de estar mais perto de Nyx.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400676&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad042608-5c56-483e-92be-13f504d9721c\', \'multiverseId\': 400676}, \'multiverseid\': 400676}, {\'name\': \'Глашатай Пантеона\', \'text\': \'Разыгрываемые вами заклинания чар стоят на {1} меньше.Каждый раз, когда вы разыгрываете заклинание чар, вы получаете 1 жизнь.\', \'type\': \'Существо — Кентавр Шаман\', \'flavor\': \'Почетное право нести знамя богов — ничто по сравнению с честью быть ближе к Никсу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400953&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc30e3f0-1d06-4356-b173-01e97650a523\', \'multiverseId\': 400953}, \'multiverseid\': 400953}, {\'name\': \'诸神传令使\', \'text\': \'你施放的结界咒语减少{1}来施放。每当你施放结界咒语时，你获得1点生命。\', \'type\': \'生物～半人马／祭师\', \'flavor\': \'高扬诸神的旗帜所获得的荣誉无法与更接近尼兹所带来的荣耀相比。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398737&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33f25ba0-81a2-451a-9413-4c56f66f15dd\', \'multiverseId\': 398737}, \'multiverseid\': 398737}, {\'name\': \'諸神傳令使\', \'text\': \'你施放的結界咒語減少{1}來施放。每當你施放結界咒語時，你獲得1點生命。\', \'type\': \'生物～半人馬／祭師\', \'flavor\': \'高揚諸神的旗幟所獲得的榮譽無法與更接近尼茲所帶來的榮耀相比。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399014&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'04f4088c-1586-47cc-aa43-a349d3887231\', \'multiverseId\': 399014}, \'multiverseid\': 399014}]', "[{'name': 'Himmelpflügende Riesin', 'text': 'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)', 'type': 'Kreatur — Riese', 'flavor': 'Sie ist erst zufrieden, wenn ihr Kopf am höchsten in den Himmel aufragt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399261&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e693d1e3-feaa-4dbb-813d-a9322aa03d00', 'multiverseId': 399261}, 'multiverseid': 399261}, {'name': 'Giganta azote del cielo', 'text': 'Alcance. (Esta criatura puede bloquear a criaturas con la habilidad de volar.)', 'type': 'Criatura — Gigante', 'flavor': 'No estará satisfecha hasta que la suya sea la cabeza más alta en los cielos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401200&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0d8af95d-327a-496f-96db-020734fa680f', 'multiverseId': 401200}, 'multiverseid': 401200}, {'name': 'Géante ratisseciel', 'text': 'Portée (Cette créature peut bloquer les créatures avec le vol.)', 'type': 'Créature : géant', 'flavor': 'Elle ne sera satisfaite que lorsque sa tête sera la plus haute dans le ciel.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399538&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f4b2e58c-e8ce-49f9-8b64-50cb7cfb83b8', 'multiverseId': 399538}, 'multiverseid': 399538}, {'name': 'Gigante Rastrellacieli', 'text': 'Raggiungere (Questa creatura può bloccare le creature con volare.)', 'type': 'Creatura — Gigante', 'flavor': 'Non si riterrà soddisfatta finché la sua testa non sarà la più alta in cielo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399815&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '569bdf12-2dab-443d-b51b-0830fccc4de4', 'multiverseId': 399815}, 'multiverseid': 399815}, {'name': '空荒らしの巨人', 'text': '到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）', 'type': 'クリーチャー — 巨人', 'flavor': '空の最も高い所にその頭があるようになるまで、彼女は納得しないだろう。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400092&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7f8d2b12-d457-44c2-858f-c46ae5fc9678', 'multiverseId': 400092}, 'multiverseid': 400092}, {'name': '하늘을 할퀴는 거인', 'text': '대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)', 'type': '생물 — 거인', 'flavor': '그녀는 자신의 머리보다 위에 있는 생물을 증오한다.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400369&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': 'e463965e-d2e9-4fad-b184-d9f120cb935b', 'multiverseId': 400369}, 'multiverseid': 400369}, {'name': 'Gigante Varredor do Céu', 'text': 'Alcance (Esta criatura pode bloquear criaturas com voar.)', 'type': 'Criatura — Gigante', 'flavor': 'Ela não ficará satisfeita até que sua cabeça seja a mais alta no céu.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400646&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'af5b8d75-d41b-48b0-827d-385608e286c9', 'multiverseId': 400646}, 'multiverseid': 400646}, {'name': 'Гигант-Неболов', 'text': 'Захват (Это существо может блокировать существа с Полетом.)', 'type': 'Существо — Гигант', 'flavor': 'Она не успокоится, пока ее голова не будет в небе выше всех.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400923&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2317198a-5022-4302-a18b-6e6d18546d57', 'multiverseId': 400923}, 'multiverseid': 400923}, {'name': '劫天巨人', 'text': '延势（此生物能阻挡具飞行异能的生物。）', 'type': '生物～巨人', 'flavor': '在成为天下最高的人以前，她绝不会满足。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398707&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '15af786f-f18a-4789-b8ad-1d84f5d78816', 'multiverseId': 398707}, 'multiverseid': 398707}, {'name': '劫天巨人', 'text': '延勢（此生物能阻擋具飛行異能的生物。）', 'type': '生物～巨人', 'flavor': '在成為天下最高的人以前，她絕不會滿足。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398984&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '5abc8fc2-1d01-4f19-822a-f5dd0d140eab', 'multiverseId': 398984}, 'multiverseid': 398984}]", '[{\'name\': \'Himmelsfang-Spinne\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Das Einzige, was übellauniger ist als ein in ein Netz geratener Greif, ist die Spinne, die ihn überwältigen muss.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae8a43ed-73c4-44fa-b6fd-efc56e7c6627\', \'multiverseId\': 399481}, \'multiverseid\': 399481}, {\'name\': \'Araña devoradora del cielo\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)Alcance. (Esta criatura puede bloquear a criaturas con la habilidad de volar.)\', \'type\': \'Criatura — Araña\', \'flavor\': \'Lo único más malhumorado que un grifo en una red es la araña que debe subyugarlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401420&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84ba48c9-c062-4321-80d3-8c52ab806cb3\', \'multiverseId\': 401420}, \'multiverseid\': 401420}, {\'name\': \'Araignée piégeuse céleste\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)Portée (Cette créature peut bloquer les créatures avec le vol.)", \'type\': \'Créature : araignée\', \'flavor\': "Il n\'y a rien de plus grincheux qu\'un griffon pris dans une toile, excepté l\'araignée qui tente de l\'immobiliser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399758&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18014e50-286b-4099-9e99-b13fc5a9b0db\', \'multiverseId\': 399758}, \'multiverseid\': 399758}, {\'name\': \'Ragno Aerotrappola\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)Raggiungere (Questa creatura può bloccare le creature con volare.)\', \'type\': \'Creatura — Ragno\', \'flavor\': "L\'unico essere più iracondo di un grifone in una ragnatela è il ragno che deve domarlo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b793d98b-036e-45d4-b817-3b1b5c691202\', \'multiverseId\': 400035}, \'multiverseid\': 400035}, {\'name\': \'空網蜘蛛\', \'text\': \'警戒（このクリーチャーは攻撃してもタップしない。）到達（このクリーチャーは飛行を持つクリーチャーをブロックできる。）\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'蜘蛛の網に捕らえられたグリフィン以上に不機嫌なのは、それを制圧しなければならない蜘蛛である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400312&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e322f096-5572-4204-af69-4153e48ef202\', \'multiverseId\': 400312}, \'multiverseid\': 400312}, {\'name\': \'하늘올가미 거미\', \'text\': \'경계 (이 생물은 공격하면서 탭되지 않는다.)대공 (이 생물은 비행을 가진 생물을 방어할 수 있다.)\', \'type\': \'생물 — 거미\', \'flavor\': \'거미줄에 걸린 그리핀보다 더 성질을 부리는 존재는 그 그리핀을 잡아야 하는 거미다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400589&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'7632937a-df3c-4e27-9d71-9f629b4c734f\', \'multiverseId\': 400589}, \'multiverseid\': 400589}, {\'name\': \'Aranha da Armadilha Celeste\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)Alcance (Esta criatura pode bloquear criaturas com voar.)\', \'type\': \'Criatura — Aranha\', \'flavor\': \'A única coisa mais nervosa do que um grifo preso em uma teia é a aranha que precisa dominá-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37ac7945-9db1-441d-8e62-09f6c1ea3bab\', \'multiverseId\': 400866}, \'multiverseid\': 400866}, {\'name\': \'Паук Небесных Силков\', \'text\': \'Бдительность (Атакуя, это существо не поворачивается.)Захват (Это существо может блокировать существа с Полетом.)\', \'type\': \'Существо — Паук\', \'flavor\': \'Превзойти яростью попавшего в паутину грифона может только паук, которому предстоит его усмирить.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401143&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9aff8de-d4cf-4dbf-bd25-f7a763b4e5f5\', \'multiverseId\': 401143}, \'multiverseid\': 401143}, {\'name\': \'天网蜘蛛\', \'text\': \'警戒（此生物攻击时不需横置。）延势（此生物能阻挡具飞行异能的生物。）\', \'type\': \'生物～蜘蛛\', \'flavor\': \'比落入蛛网的狮鹫脾气更坏的，就只有必须制服它的蜘蛛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398927&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6856d137-d968-4a91-912e-b4fbbd885667\', \'multiverseId\': 398927}, \'multiverseid\': 398927}, {\'name\': \'天網蜘蛛\', \'text\': \'警戒（此生物攻擊時不需橫置。）延勢（此生物能阻擋具飛行異能的生物。）\', \'type\': \'生物～蜘蛛\', \'flavor\': \'比落入蛛網的獅鷲脾氣更壞的，就只有必須制服牠的蜘蛛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399204&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'a3a5632f-d8ad-4d4a-8c46-2c9b297f4038\', \'multiverseId\': 399204}, \'multiverseid\': 399204}]', '[{\'name\': \'Himmlisches Leuchtfeuer\', \'text\': \'Ein Spieler deiner Wahl opfert eine angreifende oder blockende Kreatur.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Als du den Angriff erklärt hast, warst du bereits besiegt."—Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399319&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1bce2f72-cfce-4e23-93b6-76210f7d50f2\', \'multiverseId\': 399319}, \'multiverseid\': 399319}, {\'name\': \'Fulgor celestial\', \'text\': \'El jugador objetivo sacrifica una criatura atacante o bloqueadora.\', \'type\': \'Instantáneo\', \'flavor\': \'"Estabas derrotado en el momento en que declaraste tu agresión".—Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401258&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b6621160-7af7-42b8-a74c-645b4096bd78\', \'multiverseId\': 401258}, \'multiverseid\': 401258}, {\'name\': \'Flamboiement céleste\', \'text\': \'Le joueur ciblé sacrifie une créature attaquante ou bloqueuse.\', \'type\': \'Éphémère\', \'flavor\': \'« Tu étais vaincu dès le moment où tu as attaqué. »—Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399596&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b2fcab0-2757-4a70-b00d-8977fc32ed60\', \'multiverseId\': 399596}, \'multiverseid\': 399596}, {\'name\': \'Bagliore Celestiale\', \'text\': \'Un giocatore bersaglio sacrifica una creatura attaccante o bloccante.\', \'type\': \'Istantaneo\', \'flavor\': \'"Eri già sconfitto nel momento in cui hai dichiarato la tua aggressione."—Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399873&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c454faa2-fc07-4380-96b2-144fa37dcd3c\', \'multiverseId\': 399873}, \'multiverseid\': 399873}, {\'name\': \'天界のほとばしり\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは攻撃かブロックしているクリーチャーを１体生け贄に捧げる。\', \'type\': \'インスタント\', \'flavor\': \'「攻撃しようとしたとき、君は負けていたのさ。」――ギデオン・ジュラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400150&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f568dab-0c25-4e39-a62b-147aa78e09be\', \'multiverseId\': 400150}, \'multiverseid\': 400150}, {\'name\': \'천상의 섬광\', \'text\': \'플레이어를 목표로 정한다. 그 플레이어는 공격생물 또는 방어생물 한 개를 희생한다.\', \'type\': \'순간마법\', \'flavor\': \'"적의를 표한 순간, 넌 이미 패배했다."—기디온 주라\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400427&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'17f0dcbf-6550-448b-8a97-44f2087006a7\', \'multiverseId\': 400427}, \'multiverseid\': 400427}, {\'name\': \'Clarão Celestial\', \'text\': \'O jogador alvo sacrifica uma criatura atacante ou bloqueadora.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você foi derrotado no mesmo momento em que declarou sua ofensiva."— Gideon Jura\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'91d98e85-5560-4290-8b50-6b84188805d8\', \'multiverseId\': 400704}, \'multiverseid\': 400704}, {\'name\': \'Небесная Вспышка\', \'text\': \'Целевой игрок жертвует атакующее или блокирующее существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ты проиграл бой уже тем, что вступил в него».— Гидеон Джура\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400981&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0aff6aa6-d4cc-4b88-a85f-814000b3aa48\', \'multiverseId\': 400981}, \'multiverseid\': 400981}, {\'name\': \'天界火光\', \'text\': \'目标牌手牺牲一个进行攻击或阻挡的生物。\', \'type\': \'瞬间\', \'flavor\': \'「你在宣战的那一刻就已经输了。」～基定尤拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398765&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'474df7bf-ce2c-4f14-ab6c-07cf314d3150\', \'multiverseId\': 398765}, \'multiverseid\': 398765}, {\'name\': \'天界火光\', \'text\': \'目標玩家犧牲一個進行攻擊或阻擋的生物。\', \'type\': \'瞬間\', \'flavor\': \'「你在宣戰的那一刻就已經輸了。」～基定尤拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399042&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f98f950d-b49c-40f8-8fc6-2337db390ca3\', \'multiverseId\': 399042}, \'multiverseid\': 399042}]', '[{\'name\': \'Hinterland-Koloss\', \'text\': \'Ruhm 6 (Wenn diese Kreatur einem Spieler Kampfschaden zufügt und falls sie nicht ruhmvoll ist, lege sechs +1/+1-Marken auf sie und sie wird ruhmvoll.)Der Hinterland-Koloss kann nicht von mehr als einer Kreatur geblockt werden.\', \'type\': \'Kreatur — Riese\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399499&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36cf4329-e603-4595-acc9-d59002ba67d8\', \'multiverseId\': 399499}, \'multiverseid\': 399499}, {\'name\': \'Coloso forastero\', \'text\': \'Prestigio 6. (Cuando esta criatura haga daño de combate a un jugador, si no tiene prestigio, pon seis contadores +1/+1 sobre ella y gana prestigio.)El Coloso forastero no puede ser bloqueado por más de una criatura.\', \'type\': \'Criatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401438&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c65165be-e613-44db-b3e0-f07f5c6edb19\', \'multiverseId\': 401438}, \'multiverseid\': 401438}, {\'name\': "Colosse de l\'horizon", \'text\': "Réputation 6 (Quand cette créature inflige des blessures de combat à un joueur, si elle n\'est pas réputée, mettez six marqueurs +1/+1 sur elle et elle devient réputée.)Le Colosse de l\'horizon ne peut pas être bloqué par plus d\'une créature.", \'type\': \'Créature : géant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399776&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4eb4a26-608a-499c-b404-b801d0e3023a\', \'multiverseId\': 399776}, \'multiverseid\': 399776}, {\'name\': \'Colosso delle Zone di Confine\', \'text\': \'Rinomare 6 (Quando questa creatura infligge danno da combattimento a un giocatore, se non è rinomata, metti sei segnalini +1/+1 su di essa e diventa rinomata.)Il Colosso delle Zone di Confine non può essere bloccato da più di una creatura.\', \'type\': \'Creatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400053&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7e34bd8-8f1d-4b23-b22c-cc63042f44ad\', \'multiverseId\': 400053}, \'multiverseid\': 400053}, {\'name\': \'辺境地の巨人\', \'text\': \'高名６（このクリーチャーがプレイヤー１人に戦闘ダメージを与えたとき、これが高名でない場合、これの上に＋１/＋１カウンターを６個置く。これは高名になる。）辺境地の巨人は、２体以上のクリーチャーによってはブロックされない。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400330&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd846ef8-3e26-47aa-95d1-c63001eebbb1\', \'multiverseId\': 400330}, \'multiverseid\': 400330}, {\'name\': \'변경 거상\', \'text\': \'명성 6 (이 생물이 플레이어에게 전투피해를 입힐 때, 이 생물에 명성이 없다면 +1/+1 카운터 여섯 개를 올려놓고 이 생물은 명성을 얻는다.)변경 거상은 생물 하나에게만 방어될 수 있다.\', \'type\': \'생물 — 거인\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400607&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d378737b-0111-4f1c-8e84-e3619b2490b4\', \'multiverseId\': 400607}, \'multiverseid\': 400607}, {\'name\': \'Colosso Forasteiro\', \'text\': \'Renome 6 (Quando esta criatura causar dano de combate a um jogador, se ela não for renomada, coloque seis marcadores +1/+1 nela e ela se tornará renomada.)Colosso Forasteiro não pode ser bloqueado por mais de uma criatura.\', \'type\': \'Criatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400884&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2ff4be1b-522e-4601-bcfe-14daa8595581\', \'multiverseId\': 400884}, \'multiverseid\': 400884}, {\'name\': \'Колосс Дальнего Края\', \'text\': \'Прославленность 6 (Когда это существо наносит боевые повреждения игроку, если оно не прославлено, положите на него шесть жетонов +1/+1, и оно становится прославленным.)Колосс Дальнего Края не может быть заблокирован более чем одним существом.\', \'type\': \'Существо — Гигант\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401161&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77c36162-fb01-4706-9b71-8a3f9c5ba388\', \'multiverseId\': 401161}, \'multiverseid\': 401161}, {\'name\': \'离乡巨汉\', \'text\': \'铭勇6（当此生物对任一牌手造成战斗伤害时，若它未铭勇，则在其上放置六个+1/+1指示物且它已铭勇。）离乡巨汉不能被多于一个生物阻挡。\', \'type\': \'生物～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398945&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f431cff3-4b92-48aa-9998-f2fee84b0443\', \'multiverseId\': 398945}, \'multiverseid\': 398945}, {\'name\': \'離鄉巨漢\', \'text\': \'銘勇6（當此生物對任一玩家造成戰鬥傷害時，若它未銘勇，則在其上放置六個+1/+1指示物且它已銘勇。）離鄉巨漢不能被多於一個生物阻擋。\', \'type\': \'生物～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399222&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9fdd5735-664e-49af-80e6-6fc5c4522aef\', \'multiverseId\': 399222}, \'multiverseid\': 399222}]', '[{\'name\': \'Hixus der Gefängniswärter\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt wirken, zu dem du einen Spontanzauber wirken könntest.)Immer wenn dir eine Kreatur Kampfschaden zufügt und falls Hixus der Gefängniswärter in diesem Zug ins Spiel gekommen ist, schicke diese Kreatur ins Exil, bis Hixus das Spiel verlässt. (Die Kreatur kehrt unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Legendäre Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399442&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'05ef8434-aebb-4312-9f7e-3645ef9a7fed\', \'multiverseId\': 399442}, \'multiverseid\': 399442}, {\'name\': \'Hixus, carcelero\', \'text\': \'Destello. (Puedes lanzar este hechizo en cualquier momento en que pudieras lanzar un instantáneo.)Siempre que una criatura te haga daño de combate, si Hixus, carcelero entró al campo de batalla este turno, exilia esa criatura hasta que Hixus deje el campo de batalla. (Esa criatura regresa bajo el control de su propietario.)\', \'type\': \'Criatura legendaria — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401381&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'20ef263b-0c69-4c47-b3d9-c6bc376878b9\', \'multiverseId\': 401381}, \'multiverseid\': 401381}, {\'name\': \'Hixus, gardien de prison\', \'text\': "Flash (Vous pouvez lancer ce sort à tout moment où vous pourriez lancer un éphémère.)À chaque fois qu\'une créature vous inflige des blessures de combat, si Hixus, gardien de prison est arrivé sur le champ de bataille ce tour-ci, exilez cette créature jusqu\'à ce que Hixus quitte le champ de bataille. (Cette créature revient sous le contrôle de son propriétaire.)", \'type\': \'Créature légendaire : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399719&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b72abca-b7dc-45d4-a697-a803750d940c\', \'multiverseId\': 399719}, \'multiverseid\': 399719}, {\'name\': \'Hixus, Guardiano della Prigione\', \'text\': \'Lampo (Puoi lanciare questa magia in ogni momento in cui potresti lanciare un istantaneo.)Ogniqualvolta una creatura ti infligge danno da combattimento, se Hixus, Guardiano della Prigione è entrato nel campo di battaglia in questo turno, esilia quella creatura finché Hixus non lascia il campo di battaglia. (Quella creatura torna sotto il controllo del suo proprietario.)\', \'type\': \'Creatura Leggendaria — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399996&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'abb86b2c-3c9f-4b9a-b92d-4547ef49d278\', \'multiverseId\': 399996}, \'multiverseid\': 399996}, {\'name\': \'牢獄の管理人、ヒクサス\', \'text\': \'瞬速（あなたはこの呪文を、あなたがインスタントを唱えられるときならいつでも唱えてよい。）クリーチャー１体があなたに戦闘ダメージを与えるたび、牢獄の管理人、ヒクサスがこのターンに戦場に出ていた場合、牢獄の管理人、ヒクサスが戦場を離れるまでそのクリーチャーを追放する。（そのクリーチャーはオーナーのコントロール下で戦場に戻る。）\', \'type\': \'伝説のクリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400273&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'079399f1-eb6c-426a-9451-0f85e94d376f\', \'multiverseId\': 400273}, \'multiverseid\': 400273}, {\'name\': \'간수 힉서스\', \'text\': \'섬광 (순간마법을 발동할 수 있는 시기라면 당신은 이 주문을 언제든지 발동할 수 있다.)생물이 당신에게 전투피해를 입힐 때마다, 간수 힉서스가 이 턴에 전장에 들어왔다면, 힉서스가 전장을 떠날 때까지 그 생물을 추방한다. (그 생물은 그 소유자의 조종하에 전장으로 돌아온다.)\', \'type\': \'전설적 생물 — 인간 병사\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400550&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'504f36dc-44ea-473c-ba38-f1433bd911e4\', \'multiverseId\': 400550}, \'multiverseid\': 400550}, {\'name\': \'Hixus, o Carcereiro\', \'text\': \'Lampejo (Você poderá conjurar esta mágica a qualquer momento em que puder conjurar uma mágica instantânea.)Toda vez que uma criatura causar dano de combate a você, se Hixus, o Carcereiro, tiver entrado no campo de batalha neste turno, exile aquela criatura até Hixus deixar o campo de batalha. (Aquela criatura retorna sob o controle de seu dono.)\', \'type\': \'Criatura Lendária — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400827&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9fb6045-26ba-4db2-b547-71a4101bf931\', \'multiverseId\': 400827}, \'multiverseid\': 400827}, {\'name\': \'Хиксус, Тюремный Надзиратель\', \'text\': \'Миг (Вы можете разыграть это заклинание при любой возможности разыгрывать мгновенные заклинания.)Каждый раз, когда существо наносит вам боевые повреждения, если Хиксус, Тюремный Надзиратель вышел на поле битвы в этом ходу, изгоните то существо до тех пор, пока Хиксус не покинет поле битвы. (То существо возвращается под контролем своего владельца.)\', \'type\': \'Легендарное Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401104&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f128870-a4e3-44e5-a3e2-f5c03f539d5d\', \'multiverseId\': 401104}, \'multiverseid\': 401104}, {\'name\': \'典狱长希瑟思\', \'text\': \'闪现（你可以于你能够施放瞬间的时机下施放此咒语。）每当一个生物对你造成战斗伤害时，若典狱长希瑟思是于本回合进战场，则放逐该生物，直到希瑟思离开战场为止。（该生物会在其拥有者的操控下移回。）\', \'type\': \'传奇生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398888&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0fabe5f9-d399-4311-9e5e-6134b5b95575\', \'multiverseId\': 398888}, \'multiverseid\': 398888}, {\'name\': \'典獄長希瑟思\', \'text\': \'閃現（你可以於你能夠施放瞬間的時機下施放此咒語。）每當一個生物對你造成戰鬥傷害時，若典獄長希瑟思是於本回合進戰場，則放逐該生物，直到希瑟思離開戰場為止。（該生物會在其擁有者的操控下移回。）\', \'type\': \'傳奇生物～人類／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399165&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'229fd49e-752d-43fa-9d8d-1970d38c1a62\', \'multiverseId\': 399165}, \'multiverseid\': 399165}]', '[{\'name\': \'Hydrohieb\', \'text\': \'Angreifende Kreaturen erhalten -2/-0 bis zum Ende des Zuges.Ziehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Mich interessieren weder eure Magierringe noch eure Mana-Gleichungen. Ich rufe, und das Meer antwortet."—Keyta, Rebellische Hydromagierin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399497&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'33f7847b-12a6-4a1c-9baf-b9a124c2868d\', \'multiverseId\': 399497}, \'multiverseid\': 399497}, {\'name\': \'Latigazo marino\', \'text\': \'Las criaturas atacantes obtienen -2/-0 hasta el final del turno.Roba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"No necesito tus anillos mágicos ni tus ecuaciones de maná. Yo invoco y el mar responde".—Keyta, hidromante rebelde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401436&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3e72a69-7ef6-4769-b1f8-b295342205de\', \'multiverseId\': 401436}, \'multiverseid\': 401436}, {\'name\': \'Hydrofouet\', \'text\': "Les créatures attaquantes gagnent -2/-0 jusqu\'à la fin du tour.Piochez une carte.", \'type\': \'Éphémère\', \'flavor\': "« Je n\'ai nul besoin de vos anneaux de mage ou de vos équations de mana. J\'appelle, et la mer me répond. »—Keyta, hydromancienne rebelle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399774&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b51e64a2-accd-418e-900c-127caa92a871\', \'multiverseId\': 399774}, \'multiverseid\': 399774}, {\'name\': \'Idrofrusta\', \'text\': \'Le creature attaccanti prendono -2/-0 fino alla fine del turno.Pesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non mi servono i vostri anelli magici o le vostre equazioni di mana. Quando io chiamo, il mare risponde."—Keyta, idromante ribelle\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400051&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'928cf8c1-c9ad-42c7-85f6-89aff02331cb\', \'multiverseId\': 400051}, \'multiverseid\': 400051}, {\'name\': \'水撃\', \'text\': \'ターン終了時まで、攻撃クリーチャーは－２/－０の修整を受ける。カードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「私はお前たちの魔道士輪もマナ方程式も必要としない。私が呼べば、海が応えてくれる。」――水術師の反逆者、ケイタ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400328&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'31fcabb4-e820-480a-8d79-0f77e058a037\', \'multiverseId\': 400328}, \'multiverseid\': 400328}, {\'name\': \'물 채찍\', \'text\': \'공격생물들은 턴종료까지 -2/-0을 받는다.카드 한 장을 뽑는다.\', \'type\': \'순간마법\', \'flavor\': \'"난 당신들처럼 마력 고리나 마나 공식이 필요 없어. 내가 바다를 부르면 바다가 내게 응답할 뿐이다."—반란군 수력술사 케이타\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400605&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e6369f4d-b809-4e29-8a52-27fd0a9f5682\', \'multiverseId\': 400605}, \'multiverseid\': 400605}, {\'name\': \'Açoite Hídrico\', \'text\': \'As criaturas atacantes recebem -2/-0 até o final do turno.Compre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Eu não preciso de seus anéis de mago ou de suas equações de mana. Eu chamo e o mar responde."— Keyta, hidromante rebelde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31963fd8-b422-476f-bed2-0b0e7d5444be\', \'multiverseId\': 400882}, \'multiverseid\': 400882}, {\'name\': \'Водяная Плеть\', \'text\': \'Атакующие существа получают -2/-0 до конца хода.Возьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мне не нужны ваши магические кольца и уравнения маны. Я взываю к морю — и море отвечает».— Кейта, мятежница-гидромант\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401159&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8962449b-47d7-44ff-b435-0a2921b8065c\', \'multiverseId\': 401159}, \'multiverseid\': 401159}, {\'name\': \'水流鞭\', \'text\': \'进行攻击的生物得-2/-0直到回合结束。抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「我不需要你的法师环塔或法力方程式。我发出呼唤，大海便会回应。」～反叛水流术士凯塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398943&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5b6d6cd-15f9-404e-989b-752f35c6d22f\', \'multiverseId\': 398943}, \'multiverseid\': 398943}, {\'name\': \'水流鞭\', \'text\': \'進行攻擊的生物得-2/-0直到回合結束。抽一張牌。\', \'type\': \'瞬間\', \'flavor\': \'「我不需要你的法師環塔或法力方程式。我發出呼喚，大海便會回應。」～反叛水流術士凱塔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399220&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f06c8820-750f-4cc7-aebe-2d037993fc9e\', \'multiverseId\': 399220}, \'multiverseid\': 399220}]', "[{'name': 'Höhlen von Koilos', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.{T}: Erhöhe deinen Manavorrat um {W} oder {B}. Die Höhlen von Koilos fügen dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399335&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a7fbed1d-09de-472c-855d-7358b8fac82e', 'multiverseId': 399335}, 'multiverseid': 399335}, {'name': 'Cuevas de Koilos', 'text': '{T}: Agrega {1} a tu reserva de maná.{T}: Agrega {W} o {B} a tu reserva de maná. Las Cuevas de Koilos te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401274&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4fc2c11a-367e-4692-8c45-e11861c637f7', 'multiverseId': 401274}, 'multiverseid': 401274}, {'name': 'Cavernes de Koïlos', 'text': '{T} : Ajoutez {1} à votre réserve.{T} : Ajoutez {W} ou {B} à votre réserve. Les Cavernes de Koïlos vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399612&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bc43ce44-ab5e-437b-b337-f7900990b032', 'multiverseId': 399612}, 'multiverseid': 399612}, {'name': 'Caverne di Koilos', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.{T}: Aggiungi {W} o {B} alla tua riserva di mana. Le Caverne di Koilos ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399889&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bcacfe31-590b-4d2f-9d26-755a2e53bd60', 'multiverseId': 399889}, 'multiverseid': 399889}, {'name': 'コイロスの洞窟', 'text': '{T}：あなたのマナ・プールに{1}を加える。{T}：あなたのマナ・プールに{W}か{B}を加える。コイロスの洞窟はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400166&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bd428d61-3672-4d06-98a5-735607d16d71', 'multiverseId': 400166}, 'multiverseid': 400166}, {'name': '코일로스의 동굴', 'text': '{T}: {1}을 당신의 마나풀에 담는다.{T}: {W} 또는 {B}를 당신의 마나풀에 담는다. 코일로스의 동굴은 당신에게 피해 1점을 입힌다.', 'type': '대지', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400443&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '48f01629-7712-4c64-ade2-cd5c8124ad90', 'multiverseId': 400443}, 'multiverseid': 400443}, {'name': 'Cavernas de Koilos', 'text': '{T}: Adicione {1} à sua reserva de mana.{T}: Adicione {W} ou {B} à sua reserva de mana. Cavernas de Koilos causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400720&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '50110658-c0d1-4f5c-9aa1-31eb1f2cb64d', 'multiverseId': 400720}, 'multiverseid': 400720}, {'name': 'Пещеры Койлоса', 'text': '{T}: добавьте {1} в ваше хранилище маны.{T}: добавьте {W} или {B} в ваше хранилище маны. Пещеры Койлоса наносят вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400997&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '859ba642-68f7-40ed-b17d-893ee4cd9dd9', 'multiverseId': 400997}, 'multiverseid': 400997}, {'name': '喀洛斯洞窟', 'text': '{T}：加{1}到你的法术力池中。{T}：加{W}或{B}到你的法术力池中。喀洛斯洞窟对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398781&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b75d4003-943c-4244-bf78-2520e77d8254', 'multiverseId': 398781}, 'multiverseid': 398781}, {'name': '喀洛斯洞窟', 'text': '{T}：加{1}到你的魔法力池中。{T}：加{W}或{B}到你的魔法力池中。喀洛斯洞窟對你造成1點傷害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399058&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'ebe32be5-0a97-4f8d-b38e-91e66a371652', 'multiverseId': 399058}, 'multiverseid': 399058}]", '[{\'name\': \'Höllische Narben\', \'text\': \'Verzaubert eine KreaturDie verzauberte Kreatur erhält +2/+0 und hat „Wenn diese Kreatur stirbt, ziehe eine Karte."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Derjenige, der im Leben von einem Dämon gezeichnet wird, bleibt nach seinem Tode als Dämon in Erinnerung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399469&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2f910f3-5b00-49af-8c38-efcda16f90cb\', \'multiverseId\': 399469}, \'multiverseid\': 399469}, {\'name\': \'Cicatrices infernales\', \'text\': \'Encantar criatura.La criatura encantada obtiene +2/+0 y tiene "Cuando esta criatura muera, roba una carta".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Quien queda marcado por un demonio en vida será recordado como uno de ellos en la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401408&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a8e09786-5dc2-4e2a-a4eb-af143d64af44\', \'multiverseId\': 401408}, \'multiverseid\': 401408}, {\'name\': \'Scarification infernale\', \'text\': \'Enchanter : créatureLa créature enchantée gagne +2/+0 et a « Quand cette créature meurt, piochez une carte ».\', \'type\': \'Enchantement : aura\', \'flavor\': \'Qui est marqué de son vivant par un démon sera considéré comme tel après sa mort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399746&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'38144120-88c3-470a-ab6f-0c76538b8042\', \'multiverseId\': 399746}, \'multiverseid\': 399746}, {\'name\': \'Sfregio Infernale\', \'text\': \'Incanta creaturaLa creatura incantata prende +2/+0 e ha "Quando questa creatura muore, pesca una carta".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Chi è marchiato da un demone in vita certamente sarà ricordato come tale nella morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400023&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad9ee839-6b43-43ca-86a4-cde14fb8f8cb\', \'multiverseId\': 400023}, \'multiverseid\': 400023}, {\'name\': \'冥府の傷跡\', \'text\': \'エンチャント（クリーチャー）エンチャントされているクリーチャーは＋２/＋０の修整を受けるとともに「このクリーチャーが死亡したとき、カードを１枚引く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'悪魔によって印を受けた生ある者は、死んだ者として記憶されるだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400300&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b18c1af-6eea-4527-94f6-5febcd934715\', \'multiverseId\': 400300}, \'multiverseid\': 400300}, {\'name\': \'지옥에서 입은 흉터\', \'text\': \'생물에 부여부여된 생물은 +2/+0을 받고 "이 생물이 죽을 때, 카드 한 장을 뽑는다."를 가진다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'생전에 악마에게 낙인 찍힌 자는 죽어서도 그 오명을 씻을 수 없다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400577&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'84e42230-4fed-4ec4-a7be-eef3728f1e5d\', \'multiverseId\': 400577}, \'multiverseid\': 400577}, {\'name\': \'Escarificação Infernal\', \'text\': \'Encantar criaturaA criatura encantada recebe +2/+0 e tem "Quando esta criatura morrer, compre um card."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Aquele que é marcado por um demônio em vida, certamente será lembrado como um na morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400854&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'00a08d9c-3f3c-4e69-8ebb-430790ebb4e5\', \'multiverseId\': 400854}, \'multiverseid\': 400854}, {\'name\': \'Шрамы Преисподней\', \'text\': \'Зачаровать существоЗачарованное существо получает +2/+0 и имеет способность «Когда это существо умирает, возьмите карту».\', \'type\': \'Чары — Аура\', \'flavor\': \'Того, кого демон отметил при жизни, запомнят таким и после смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401131&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'269b053b-65c5-457f-bab0-8313e195536a\', \'multiverseId\': 401131}, \'multiverseid\': 401131}, {\'name\': \'炼狱留痕\', \'text\': \'结附于生物所结附的生物得+2/+0且具有「当此生物死去时，抓一张牌。」\', \'type\': \'结界～灵气\', \'flavor\': \'生前得恶魔印记者，死后亦被以恶魔相待。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398915&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5143360-3d23-4479-ae9e-3744de000ce9\', \'multiverseId\': 398915}, \'multiverseid\': 398915}, {\'name\': \'煉獄留痕\', \'text\': \'結附於生物所結附的生物得+2/+0且具有「當此生物死去時，抽一張牌。」\', \'type\': \'結界～靈氣\', \'flavor\': \'生前得惡魔印記者，死後亦被以惡魔相待。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399192&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9e644197-6f15-4d49-9950-d6f879be459e\', \'multiverseId\': 399192}, \'multiverseid\': 399192}]', '[{\'name\': \'Hüter von Valeron\', \'text\': \'Ruhm 2 (Wenn diese Kreatur einem Spieler Kampfschaden zufügt und falls sie nicht ruhmvoll ist, lege zwei +1/+1-Marken auf sie und sie wird ruhmvoll.)Immer wenn eine Kreatur, die du kontrollierst, ruhmvoll wird, ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Mönch\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399278&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00af875f-d277-4cf6-bd9d-1e35a87f18c7\', \'multiverseId\': 399278}, \'multiverseid\': 399278}, {\'name\': \'Protectores de Valeron\', \'text\': \'Prestigio 2. (Cuando esta criatura haga daño de combate a un jugador, si no tiene prestigio, pon dos contadores +1/+1 sobre ella y gana prestigio.)Siempre que una criatura que controlas gane prestigio, roba una carta.\', \'type\': \'Criatura — Monje humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401217&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc2ce7e3-1e56-4e54-be13-d85aa1f6b8ac\', \'multiverseId\': 401217}, \'multiverseid\': 401217}, {\'name\': \'Gardes de Valéron\', \'text\': "Réputation 2 (Quand cette créature inflige des blessures de combat à un joueur, si elle n\'est pas réputée, mettez deux marqueurs +1/+1 sur elle et elle devient réputée.)À chaque fois qu\'une créature que vous contrôlez devient réputée, piochez une carte.", \'type\': \'Créature : humain et moine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399555&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d0772ab-e0cc-42d1-a54f-f18f3ff3bc4a\', \'multiverseId\': 399555}, \'multiverseid\': 399555}, {\'name\': \'Guardiani di Valeron\', \'text\': \'Rinomare 2 (Quando questa creatura infligge danno da combattimento a un giocatore, se non è rinomata, metti due segnalini +1/+1 su di essa e diventa rinomata.)Ogniqualvolta una creatura che controlli diventa rinomata, pesca una carta.\', \'type\': \'Creatura — Monaco Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399832&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dce410c1-7ea6-4251-9ef4-0e5323199888\', \'multiverseId\': 399832}, \'multiverseid\': 399832}, {\'name\': \'ヴァレロンの管理人\', \'text\': \'高名２（このクリーチャーがプレイヤー１人に戦闘ダメージを与えたとき、これが高名でない場合、これの上に＋１/＋１カウンターを２個置く。これは高名になる。）あなたがコントロールするクリーチャーが１体高名になるたび、カードを１枚引く。\', \'type\': \'クリーチャー — 人間・モンク\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400109&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'477044bc-6b5a-4e9f-95b1-4a4f5907969f\', \'multiverseId\': 400109}, \'multiverseid\': 400109}, {\'name\': \'발레론 관리자\', \'text\': \'명성 2 (이 생물이 플레이어에게 전투피해를 입힐 때, 이 생물에 명성이 없다면 +1/+1 카운터 두 개를 올려놓고 이 생물은 명성을 얻는다.)당신이 조종하는 생물이 명성을 얻을 때마다, 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 승려\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400386&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cfdc49bc-e209-43c9-aab0-f3d3b2d5e394\', \'multiverseId\': 400386}, \'multiverseid\': 400386}, {\'name\': \'Protetores de Valeron\', \'text\': \'Renome 2 (Quando esta criatura causar dano de combate a um jogador, se ela não for renomada, coloque dois marcadores +1/+1 nela e ela se tornará renomada.)Toda vez que uma criatura que você controla se tornar renomada, compre um card.\', \'type\': \'Criatura — Humano Monge\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400663&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9f9ee505-865c-4b90-ae80-f3337692f652\', \'multiverseId\': 400663}, \'multiverseid\': 400663}, {\'name\': \'Хранители Валерона\', \'text\': \'Прославленность 2 (Когда это существо наносит боевые повреждения игроку, если оно не прославлено, положите на него два жетона +1/+1, и оно становится прославленным.)Каждый раз, когда существо под вашим контролем становится прославленным, возьмите карту.\', \'type\': \'Существо — Человек Монах\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400940&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1c672bbf-fe69-4f56-be66-601b3c8a3e1b\', \'multiverseId\': 400940}, \'multiverseid\': 400940}, {\'name\': \'威烈隆护卫\', \'text\': \'铭勇2（当此生物对任一牌手造成战斗伤害时，若它未铭勇，则在其上放置两个+1/+1指示物且它已铭勇。）每当一个由你操控的生物铭勇时，抓一张牌。\', \'type\': \'生物～人类／修行僧\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398724&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2edd7fb5-e22e-455b-ac58-43dccc484bdc\', \'multiverseId\': 398724}, \'multiverseid\': 398724}, {\'name\': \'威烈隆護衛\', \'text\': \'銘勇2（當此生物對任一玩家造成戰鬥傷害時，若它未銘勇，則在其上放置兩個+1/+1指示物且它已銘勇。）每當一個由你操控的生物銘勇時，抽一張牌。\', \'type\': \'生物～人類／修行僧\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399001&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8c39ca5e-b19c-4813-a726-cca588e8e50d\', \'multiverseId\': 399001}, \'multiverseid\': 399001}]', '[{\'name\': \'Im Äther verankern\', \'text\': \'Lege eine Kreatur deiner Wahl oben auf die Bibliothek ihres Besitzers. Hellsicht 1. (Schaue dir die oberste Karte deiner Bibliothek an. Du kannst diese Karte unter deine Bibliothek legen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399305&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'41693392-bc17-40e1-a993-425b63988630\', \'multiverseId\': 399305}, \'multiverseid\': 399305}, {\'name\': \'Anclado al éter\', \'text\': \'Pon la criatura objetivo en la parte superior de la biblioteca de su propietario. Adivina 1. (Mira la primera carta de tu biblioteca. Puedes poner esa carta en el fondo de tu biblioteca.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401244&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'03dc64c6-ad4c-4bf4-ba0f-26b3d30d2f6a\', \'multiverseId\': 401244}, \'multiverseid\': 401244}, {\'name\': "Ancrer à l\'Aether", \'text\': \'Mettez la créature ciblée au-dessus de la bibliothèque de son propriétaire. Regard 1. (Regardez la carte du dessus de votre bibliothèque. Vous pouvez mettre cette carte au-dessous de votre bibliothèque.)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399582&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04b538bb-2a70-4368-8e7b-06947186ddf8\', \'multiverseId\': 399582}, \'multiverseid\': 399582}, {\'name\': "Ancorare all\'Etere", \'text\': \'Metti una creatura bersaglio in cima al grimorio del suo proprietario. Profetizza 1. (Guarda la prima carta del tuo grimorio. Puoi mettere quella carta in fondo al tuo grimorio.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399859&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8bd1a72-0c20-4d58-bf73-ae2c8322a036\', \'multiverseId\': 399859}, \'multiverseid\': 399859}, {\'name\': \'霊気への抑留\', \'text\': \'クリーチャー１体を対象とし、それをオーナーのライブラリーの一番上に置く。占術１を行う。（あなたのライブラリーの一番上のカードを見る。あなたはそのカードをあなたのライブラリーの一番下に置いてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400136&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d0c0682-d44d-49bc-a275-7b4f8a12773c\', \'multiverseId\': 400136}, \'multiverseid\': 400136}, {\'name\': \'에테르 닻\', \'text\': \'생물을 목표로 정한다. 그 생물을 소유자의 서고 맨 위에 올려놓는다. 점술 1을 한다. (당신의 서고 맨 위의 카드 한 장을 본다. 당신은 그 카드를 당신의 서고 맨 밑에 놓을 수 있다.)\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400413&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b1b2b566-7f1e-4a00-a414-f0db2f9b6a43\', \'multiverseId\': 400413}, \'multiverseid\': 400413}, {\'name\': \'Ancorar ao Éter\', \'text\': \'Coloque a criatura alvo no topo do grimório de seu dono. Vidência 1. (Olhe o card do topo de seu grimório. Você pode colocar aquele card no fundo de seu grimório.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400690&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'77e04d2e-0a0b-4344-962c-d456b7f9a638\', \'multiverseId\': 400690}, \'multiverseid\': 400690}, {\'name\': \'Узы Эфира\', \'text\': \'Положите целевое существо на верх библиотеки его владельца. Предскажите 1. (Посмотрите верхнюю карту вашей библиотеки. Вы можете положить ту карту в низ вашей библиотеки.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400967&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7f555c9e-9469-4b41-8cc3-2a822da346f3\', \'multiverseId\': 400967}, \'multiverseid\': 400967}, {\'name\': \'钉入乙太\', \'text\': \'将目标生物置于其拥有者的牌库顶。占卜1。（检视你牌库顶的牌。你可以将该牌置于你的牌库底。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398751&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a87fb297-de1e-4b53-87bb-56f82fa83107\', \'multiverseId\': 398751}, \'multiverseid\': 398751}, {\'name\': \'釘入乙太\', \'text\': \'將目標生物置於其擁有者的牌庫頂。占卜1。（檢視你牌庫頂的牌。你可以將該牌置於你的牌庫底。）\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399028&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'ee855847-2385-44cf-ba23-84afe59135ca\', \'multiverseId\': 399028}, \'multiverseid\': 399028}]', '[{\'name\': \'In Stückchen zerschmettern\', \'text\': \'Zerstöre ein Artefakt deiner Wahl. In Stückchen zerschmettern fügt dem Beherrscher dieses Artefakts 3 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Riese Tarvik träumte, dass Schmuckstücke und Maschinen an allem Übel der Welt schuld seien. Als er aus seinem unruhigen Schlaf erwachte, nannte er sich Tarvik Gerümpelzerschmetterer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399500&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e0611ac-b70c-4829-ba61-740ff44a77fb\', \'multiverseId\': 399500}, \'multiverseid\': 399500}, {\'name\': \'Hacer añicos\', \'text\': \'Destruye el artefacto objetivo. Hacer añicos hace 3 puntos de daño al controlador de ese artefacto.\', \'type\': \'Instantáneo\', \'flavor\': \'El gigante Tarvik soñó que las baratijas y las máquinas causaban todos los males del mundo. Cuando despertó de su turbador sueño, adoptó el nombre de Tarvik Aplastarreliquias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401439&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e529d0ce-eadd-4f53-9b4c-7703924980f6\', \'multiverseId\': 401439}, \'multiverseid\': 401439}, {\'name\': \'En mille morceaux\', \'text\': "Détruisez l\'artefact ciblé. En mille morceaux inflige 3 blessures au contrôleur de cet artefact.", \'type\': \'Éphémère\', \'flavor\': "Tarvik le géant rêva que les colifichets et les machines étaient responsables de tous les malheurs du monde. Quand il s\'éveilla de son sommeil troublé, il prit le nom de Tarvik Broyeur-de-reliques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399777&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46907574-b6d9-48d9-a4f8-5c9236924fe6\', \'multiverseId\': 399777}, \'multiverseid\': 399777}, {\'name\': \'Sbriciolare\', \'text\': "Distruggi un artefatto bersaglio. Sbriciolare infligge 3 danni al controllore di quell\'artefatto.", \'type\': \'Istantaneo\', \'flavor\': \'Il gigante Tarvik sognò che le macchine e i gingilli erano la causa di tutto il dolore del mondo. Quando si risvegliò dal suo sonno agitato, prese il nome di Tarvik Spaccareliquie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400054&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ff9c38f-29fd-49ef-bbbe-9d355e5bfb92\', \'multiverseId\': 400054}, \'multiverseid\': 400054}, {\'name\': \'粉々\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。粉々はそのアーティファクトのコントローラーに３点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'巨人のターヴィックは世界に災厄をもたらす輝石と機械の夢を見た。その休まらない眠りから目覚めたとき、彼は自らを遺物壊しのターヴィックと名乗ることにした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400331&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76aad6cd-6a25-4c5a-8bc8-6312d81eba24\', \'multiverseId\': 400331}, \'multiverseid\': 400331}, {\'name\': \'산산조각으로 때려부수기\', \'text\': \'마법물체를 목표로 정한다. 그 마법물체를 파괴한다. 산산조각으로 때려부수기는 그 마법물체의 조종자에게 피해 3점을 입힌다.\', \'type\': \'순간마법\', \'flavor\': \'거인 타르빅은 장신구나 기계가 세상을 망친 꿈을 꾸었다. 잠을 설치다 깬 타르빅은 유물파괴자 타르빅이라는 이름을 생각해냈다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400608&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'da4bfc84-d8d8-43fc-aeb5-1894751dee7e\', \'multiverseId\': 400608}, \'multiverseid\': 400608}, {\'name\': \'Reduzir a Cacos\', \'text\': \'Destrua o artefato alvo. Reduzir a Cacos causa 3 pontos de dano ao controlador daquele artefato.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O gigante Tarvik sonhou que berloques e máquinas causavam todos os problemas do mundo. Quando acordou do sono ruim, ele assumiu o nome de Tarvik Quebrarelíquia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400885&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ede69ad1-d81f-4609-925f-c090afe60cb2\', \'multiverseId\': 400885}, \'multiverseid\': 400885}, {\'name\': \'Разнести в Щепки\', \'text\': \'Уничтожьте целевой артефакт. Разнести в Щепки наносит 3 повреждения игроку, контролирующему тот артефакт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Великану Тарвику снилось, что все беды мира исходят от механизмов и машин. Проснувшись после беспокойного сна, он взял себе имя Тарвик, Крушитель Реликвий.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401162&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e2c8a91c-10a5-4f89-98e2-94b179ea5a64\', \'multiverseId\': 401162}, \'multiverseid\': 401162}, {\'name\': \'砸成碎片\', \'text\': \'消灭目标神器。砸成碎片对该神器的操控者造成3点伤害。\', \'type\': \'瞬间\', \'flavor\': \'巨人塔巍克梦到琐物与机器替世界带来灾祸。当他自恶梦醒来后，便有了砸器塔巍克的名号。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398946&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'96941179-90cd-446f-b8ad-8bf9e737c21c\', \'multiverseId\': 398946}, \'multiverseid\': 398946}, {\'name\': \'砸成碎片\', \'text\': \'消滅目標神器。砸成碎片對該神器的操控者造成3點傷害。\', \'type\': \'瞬間\', \'flavor\': \'巨人塔巍克夢到瑣物與機器替世界帶來災禍。當他自惡夢醒來後，便有了砸器塔巍克的名號。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399223&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d188677c-2e2e-4a62-ba93-0eb9e3acbe4b\', \'multiverseId\': 399223}, \'multiverseid\': 399223}]', '[{\'name\': \'In die Leere\', \'text\': \'Bringe bis zu zwei Kreaturen deiner Wahl auf die Hand ihrer Besitzer zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Katharer haben ihre Schwerter, die Inquisitoren ihre Äxte. Ich bevorzuge den ‚diplomatischen\\\' Ansatz."—Therhold, Erzmagier von Durnau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401504&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e37ab1b1-b58e-481a-a1cb-a5a7cbf1a8ac\', \'multiverseId\': 401504}, \'multiverseid\': 401504}, {\'name\': \'Empujar al vacío\', \'text\': \'Regresa hasta dos criaturas objetivo a las manos de sus propietarios.\', \'type\': \'Conjuro\', \'flavor\': \'"Los cátaros tienen espadas, y los inquisidores, hachas. Yo prefiero el enfoque \\\'diplomático\\\'".—Terhold, archimago de Drunau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401616&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7abed7af-0cba-43ef-bac4-43bc593eed83\', \'multiverseId\': 401616}, \'multiverseid\': 401616}, {\'name\': \'Vers le néant\', \'text\': "Renvoyez jusqu\'à deux créatures ciblées dans les mains de leurs propriétaires.", \'type\': \'Rituel\', \'flavor\': "« Les cathares ont leur épée, les inquisiteurs leur hache. Je préfère quant à moi l\'approche… diplomatique. »—Terhold, archimage de Drunaü", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401520&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af8978e0-11d2-4e90-af0b-a1fd01a6e88a\', \'multiverseId\': 401520}, \'multiverseid\': 401520}, {\'name\': \'Nel Vuoto\', \'text\': \'Fai tornare fino a due creature bersaglio in mano ai rispettivi proprietari.\', \'type\': \'Stregoneria\', \'flavor\': \'"I catari brandiscono le spade, gli inquisitori impugnano le asce. Io preferisco un approccio più... diplomatico."—Terhold, arcimago di Drunau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401536&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'179534a3-ba8a-4722-aec3-35d6b2dd694f\', \'multiverseId\': 401536}, \'multiverseid\': 401536}, {\'name\': \'虚空への突入\', \'text\': \'クリーチャーを最大２体まで対象とし、それらをオーナーの手札に戻す。\', \'type\': \'ソーサリー\', \'flavor\': \'「聖戦士には剣が、審問官には斧がある。だがわしは『外交的』な手段を望んでおる。」――ドルナウの大魔導師、ターホールド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401552&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3206a462-9dda-4f13-8311-2cbd01f91254\', \'multiverseId\': 401552}, \'multiverseid\': 401552}, {\'name\': \'심연 속으로\', \'text\': \'최대 두 개까지의 생물을 목표로 정한다. 그 생물들을 소유자의 손으로 되돌린다.\', \'type\': \'집중마법\', \'flavor\': \'"카타르들은 칼을, 이단심문관들은 도끼를 사용하지. 난 \\\'외교적인\\\' 접근 방식을 선호해."—드루나우의 대마법사 테르홀드\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401568&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'acf3ce17-cc21-448e-9d15-70a5b6a5314a\', \'multiverseId\': 401568}, \'multiverseid\': 401568}, {\'name\': \'Ao Vácuo\', \'text\': \'Devolva até duas criaturas alvo para as mãos de seus donos.\', \'type\': \'Feitiço\', \'flavor\': \'"Os cátaros têm suas espadas; os inquisidores, seus machados. Eu prefiro a abordagem \\\'diplomática\\\'."— Terhold, arquimago de Drunau\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401584&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69ea777c-814d-490d-a3f5-609e457215c6\', \'multiverseId\': 401584}, \'multiverseid\': 401584}, {\'name\': \'Навстречу Пустоте\', \'text\': \'Верните не более двух целевых существ в руки их владельцев.\', \'type\': \'Волшебство\', \'flavor\': \'«Катары сражаются мечами, инквизиторы — топорами. Я же предпочитаю... дипломатический подход».— Терхольд, архимаг Друнау\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401600&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d0ec009f-5854-49ab-a511-85d42bf7c8b9\', \'multiverseId\': 401600}, \'multiverseid\': 401600}, {\'name\': \'驱入虚空\', \'text\': \'将至多两个目标生物移回其拥有者手上。\', \'type\': \'法术\', \'flavor\': \'「护教军有剑，审判官有斧。我偏好『外交』手段。」～杜瑙大法师忒候\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401472&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9c857a78-cf9a-4a4e-a428-422a7bd6e452\', \'multiverseId\': 401472}, \'multiverseid\': 401472}, {\'name\': \'驅入虛空\', \'text\': \'將至多兩個目標生物移回其擁有者手上。\', \'type\': \'巫術\', \'flavor\': \'「護教軍有劍，審判官有斧。我偏好『外交』手段。」～杜瑙大法師忒候\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401488&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'5bd69750-101b-4b9b-8585-478753c58dfc\', \'multiverseId\': 401488}, \'multiverseid\': 401488}]', '[{\'name\': \'Inkarnation Zendikars\', \'text\': \'Die Stärke der Inkarnation Zendikars ist gleich der Anzahl an Ländern, die du kontrollierst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Ihr Volk verärgerte Zendikar und erntete den Zorn des Landes. Deshalb ist Nissa die letzte der Animisten."—Numa, Joraga-Häuptling\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399492&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d7e1b19-c8ec-4972-9e62-1f4b5efdda85\', \'multiverseId\': 399492}, \'multiverseid\': 399492}, {\'name\': \'Encarnación de Zendikar\', \'text\': \'La fuerza de la Encarnación de Zendikar es igual a la cantidad de tierras que controlas.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Su pueblo irritó a Zendikar y sufrió la ira de la tierra. Por eso Nissa es la última de los animistas".—Numa, cacique joraga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401431&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f431e0e-2427-4e2f-83d1-0fe08353f470\', \'multiverseId\': 401431}, \'multiverseid\': 401431}, {\'name\': \'Zendikar incarné\', \'text\': \'La force de Zendikar incarné est égale au nombre de terrains que vous contrôlez.\', \'type\': \'Créature : élémental\', \'flavor\': "« Son peuple a enragé Zendikar et a été la victime de sa colère. C\'est pourquoi Nissa est la dernière animiste. »—Numa, chef de clan de Joraga", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399769&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94928792-84c1-4e6c-88cc-10b2c1071144\', \'multiverseId\': 399769}, \'multiverseid\': 399769}, {\'name\': \'Incarnazione di Zendikar\', \'text\': "La forza dell\'Incarnazione di Zendikar è pari al numero di terre che controlli.", \'type\': \'Creatura — Elementale\', \'flavor\': \'"La sua gente suscitò la collera di Zendikar e dovette affrontare l\\\'ira della terra. Per questo motivo Nissa è l\\\'ultima degli animisti."—Numa, capitano Joraga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab2fb597-908a-4c19-9915-e6d11434d62e\', \'multiverseId\': 400046}, \'multiverseid\': 400046}, {\'name\': \'ゼンディカーの具現\', \'text\': \'ゼンディカーの具現のパワーは、あなたがコントロールする土地の総数に等しい。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「彼女の民はゼンディカーを怒らせ、大地の報いを受けることとなった。ニッサが最後の精霊信者であるのは、その理由からだ。」――ジョラーガの酋長、ヌーマ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400323&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1d64278d-d88c-43a8-985a-f3c6dcf0f430\', \'multiverseId\': 400323}, \'multiverseid\': 400323}, {\'name\': \'젠디카르 화신\', \'text\': \'젠디카르 화신의 공격력은 당신이 조종하는 대지의 개수와 같다.\', \'type\': \'생물 — 정령\', \'flavor\': \'"그녀의 동족이 젠디카르를 분노하게 만들어 그 대가를 치렀어. 그것이 니사가 자신의 종족 최후의 정령숭배자인 이유지."—조라가 추장 누마\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400600&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'4fedaaba-af3c-4a16-a93e-f33926570b12\', \'multiverseId\': 400600}, \'multiverseid\': 400600}, {\'name\': \'Zendikar Incarnada\', \'text\': \'O poder de Zendikar Incarnada é igual ao número de terrenos que você controla.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"O povo dela enfureceu Zendikar e eles enfrentaram a fúria da terra. É por isso que Nissa é a última dos animistas."— Numa, líder de Joraga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400877&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9f48c625-4a85-41bf-81cf-9a97d49a4f74\', \'multiverseId\': 400877}, \'multiverseid\': 400877}, {\'name\': \'Воплощение Зендикара\', \'text\': \'Сила Воплощения Зендикара равна количеству земель под вашим контролем.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Ее народ прогневал Зендикар, и сама земля обрушила на них свой гнев. Вот почему Нисса стала последней из анимистов».— Нума, вождь племени Джорага\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401154&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a5153ed-b977-49b5-a38e-b47c1c41b41c\', \'multiverseId\': 401154}, \'multiverseid\': 401154}, {\'name\': \'赞迪卡化身\', \'text\': \'赞迪卡化身的力量等同于由你操控的地数量。\', \'type\': \'生物～元素\', \'flavor\': \'「她的子民触怒赞迪卡，因此承受大地的愤懑。所以妮莎之后物灵师再无传人。」～玖瑞加酋长努玛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=398938&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'726c51ee-ac96-4b7f-bb85-827ed943dfe0\', \'multiverseId\': 398938}, \'multiverseid\': 398938}, {\'name\': \'贊迪卡化身\', \'text\': \'贊迪卡化身的力量等同於由你操控的地數量。\', \'type\': \'生物～元素\', \'flavor\': \'「她的子民觸怒贊迪卡，因此承受大地的憤懣。所以妮莎之後物靈師再無傳人。」～玖瑞加酋長努瑪\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399215&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'93028ed0-a7c0-4725-891d-a623fc2019c0\', \'multiverseId\': 399215}, \'multiverseid\': 399215}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399262&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c4ee50e2-ff95-4b0e-8fb5-24fc021fa8b0', 'multiverseId': 399262}, 'multiverseid': 399262}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=401201&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '84b4b76d-c67a-482d-b6b2-3b06efc69c7b', 'multiverseId': 401201}, 'multiverseid': 401201}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399539&type=card', 'language': 'French', 'identifiers': {'scryfallId': '21b6e3cd-3ea3-4743-89d0-2637b567c6f5', 'multiverseId': 399539}, 'multiverseid': 399539}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=399816&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd71f4843-ae4d-4475-a5bf-c2878d1f95d1', 'multiverseId': 399816}, 'multiverseid': 399816}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400093&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '90d15e90-e4b0-4f81-9faf-5cc13f161d8e', 'multiverseId': 400093}, 'multiverseid': 400093}, {'name': '섬', 'type': '기본 대지 — 섬', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400370&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '31791a17-0139-4d77-9d21-9960610bca53', 'multiverseId': 400370}, 'multiverseid': 400370}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=400647&type=card', 'language': 'Portuguese (Brazil)', 'identifiers