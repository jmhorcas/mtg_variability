//gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99096&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4ff77d65-955e-4e30-9279-65f68caea915', 'multiverseId': 99096}, 'multiverseid': 99096}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99456&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '06dc2c8b-6005-4f10-b3f4-25d019e38f76', 'multiverseId': 99456}, 'multiverseid': 99456}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99816&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '423e181d-ab14-44c0-a48b-dc2283f81413', 'multiverseId': 99816}, 'multiverseid': 99816}, {'name': 'Болото', 'type': 'Базовая земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110087&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'aa675174-8d2b-410b-9a05-acc3869330ea', 'multiverseId': 110087}, 'multiverseid': 110087}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98016&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c12cd255-4d18-4f21-bd21-7253b73dc8d9', 'multiverseId': 98016}, 'multiverseid': 98016}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98737&type=card', 'language': 'German', 'identifiers': {'scryfallId': '38a708af-b2f7-4f30-b194-e52d21e012bf', 'multiverseId': 98737}, 'multiverseid': 98737}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100177&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9a1ce41f-8b04-4ad0-b5b7-f6b9077f1f82', 'multiverseId': 100177}, 'multiverseid': 100177}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98377&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e63adaa7-38f2-4e31-935f-e949e0d822aa', 'multiverseId': 98377}, 'multiverseid': 98377}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99097&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '140696b9-c1e5-4b50-b42f-7aaec964fe62', 'multiverseId': 99097}, 'multiverseid': 99097}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99457&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '325b5409-dece-492b-95f9-cdb3e6396efa', 'multiverseId': 99457}, 'multiverseid': 99457}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99817&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd2125b61-84ca-4895-9a17-1a457c68ca28', 'multiverseId': 99817}, 'multiverseid': 99817}, {'name': 'Болото', 'type': 'Базовая земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110088&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6103992f-238e-4a81-a433-5cdcdaf1abff', 'multiverseId': 110088}, 'multiverseid': 110088}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98017&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e049a170-048f-4050-9da1-aabf6f93bc25', 'multiverseId': 98017}, 'multiverseid': 98017}]", '[{\'name\': \'Tanzender Krummsäbel\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Artefaktkreatur — Geist\', \'flavor\': \'Eine Klinge, die nie eine Scheide gesehen hat, ein Heft, dass nie eine Hand gespürt hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98494&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c242b181-b0f1-4189-94f9-1237089173fb\', \'multiverseId\': 98494}, \'multiverseid\': 98494}, {\'name\': \'Cimitarra danzante\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura artefacto — Espíritu\', \'flavor\': \'Una hoja que nunca ha conocido vaina, una empuñadura que nunca ha conocido mano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99934&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31f97c64-6562-42b4-b593-89418a2cd8ab\', \'multiverseId\': 99934}, \'multiverseid\': 99934}, {\'name\': \'Cimeterre dansant\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature-artefact : esprit\', \'flavor\': "Une lame qui jamais n\'a connu de fourreau ; une garde qui jamais n\'a touché de main.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98134&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e24b5b6-92ce-453a-8fac-6110c9d09962\', \'multiverseId\': 98134}, \'multiverseid\': 98134}, {\'name\': \'Scimitarra Danzante\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura Artefatto — Spirito\', \'flavor\': "Una lama che non ha mai conosciuto il fodero, un\'elsa che non ha mai toccato la mano.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98854&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3293f38d-cd52-43e5-b1ce-2857bb1551a1\', \'multiverseId\': 98854}, \'multiverseid\': 98854}, {\'name\': \'踊る円月刀\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'アーティファクト・クリーチャー — スピリット\', \'flavor\': \'鞘を知らぬ刃、手を知らぬ柄。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99214&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'20e26c09-77d4-4f64-bcc2-7bc8d37e6f42\', \'multiverseId\': 99214}, \'multiverseid\': 99214}, {\'name\': \'Cimitarra Dançante\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura Artefato — Espírito\', \'flavor\': \'Uma lâmina que nunca conheceu bainha, um punho que nunca conheceu mão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99574&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac90a016-4ebc-46ea-b5db-c209a09ca139\', \'multiverseId\': 99574}, \'multiverseid\': 99574}, {\'name\': \'Пляшущий ятаган\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Артефактное существо — Дух\', \'flavor\': \'Этот клинок не знал ножен, этой рукояти не касалась рука человека.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109845&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4578f0ce-23b5-4845-89ab-cbd1303d7d7a\', \'multiverseId\': 109845}, \'multiverseid\': 109845}, {\'name\': \'飞舞的弯刀\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'神器生物～精怪\', \'flavor\': \'其刃从未入鞘，其柄从未触手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97774&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3f19a027-1e3b-4b44-bb7f-9f72398fb431\', \'multiverseId\': 97774}, \'multiverseid\': 97774}]', '[{\'name\': \'Taschenspielerei\', \'text\': \'Schau dir die obersten zwei Karten deiner Bibliothek an. Nimm eine davon auf deine Hand und lege die andere unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'„Spiele niemals mit Zauberern um Geld." —Remin, ehrwürdiger Mönch\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98718&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23af18b6-725c-427b-867d-bfb36b5b47a9\', \'multiverseId\': 98718}, \'multiverseid\': 98718}, {\'name\': \'Juego de manos\', \'text\': \'Mira las dos primeras cartas de la parte superior de tu biblioteca. Pon una de ellas en tu mano y la otra en la parte inferior de tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'"En los juegos de azar con magos, nunca hay azar." —Remin, monje venerable\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100158&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4bafa18-bbb1-43da-8d88-1abdd7f37cb7\', \'multiverseId\': 100158}, \'multiverseid\': 100158}, {\'name\': \'Passe-passe\', \'text\': "Regardez les deux cartes du dessus de votre bibliothèque. Mettez une de ces cartes dans votre main et l\'autre au-dessous de votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': \'« Ne pariez jamais avec des mages. » —Remin, moine vénérable\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98358&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5741cb26-f7dd-43f1-aec5-1c34fe4ab6e6\', \'multiverseId\': 98358}, \'multiverseid\': 98358}, {\'name\': \'Gioco di Prestigio\', \'text\': "Guarda le prime due carte del tuo grimorio. Aggiungine una alla tua mano e metti l\'altra in fondo al tuo grimorio.", \'type\': \'Stregoneria\', \'flavor\': \'"Scommettere con i maghi non è mai saggio." —Remin, monaco venerabile\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99078&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1e1cb9f9-d061-49b5-b6f8-23de7c09f1c9\', \'multiverseId\': 99078}, \'multiverseid\': 99078}, {\'name\': \'手練\', \'text\': \'あなたのライブラリーのカードを上から２枚見る。 そのうち１枚をあなたの手札に加え、もう１枚をあなたのライブラリーの一番下に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'魔道士との賭けは賭けじゃない。 ――神々しき老修道士、レミン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99438&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3351b8e9-f9f3-437f-828c-d217eee78270\', \'multiverseId\': 99438}, \'multiverseid\': 99438}, {\'name\': \'Truque de Mãos\', \'text\': \'Olhe os dois cards do topo de seu grimório. Coloque um em sua mão e o outro no fundo de seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'"Apostar com magos nunca dá certo." — Remin, monge venerável\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99798&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'31cd2fcc-36c7-4cf8-8aba-cf616dcdfd13\', \'multiverseId\': 99798}, \'multiverseid\': 99798}, {\'name\': \'Ловкость рук\', \'text\': \'Посмотрите две верхние карты вашей библиотеки. Одну из них поместите в руку, а вторую положите в библиотеку сверху.\', \'type\': \'Волшебство\', \'flavor\': \'"Играть с магами на деньги просто невозможно". — Ремин, почтенный монах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110069&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b31809dc-f083-4ed9-9205-9775030e08ba\', \'multiverseId\': 110069}, \'multiverseid\': 110069}, {\'name\': \'变戏法\', \'text\': \'检视你牌库顶的两张牌。 将其中一张置于你的手上，另一张置于你的牌库底。\', \'type\': \'法术\', \'flavor\': \'「与法师赌博必无胜算。」 ～可敬的修行僧睿明\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97998&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'884e8261-3ca3-4f55-9cc7-432c1e47cc4e\', \'multiverseId\': 97998}, \'multiverseid\': 97998}]', "[{'name': 'Tatzelwurm', 'type': 'Kreatur — Wurm', 'flavor': 'Das Schrecklichste am Tatzelwurm ist das furchtbar krachende Geräusch, mit dem er durch den Wald bricht. Der Lärm ist so laut, dass sein Echo von den Bäumen zurückgeworfen wird und von überall gleichzeitig zu kommen scheint.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98490&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9d592e72-be89-41a6-a285-de7481a0c17f', 'multiverseId': 98490}, 'multiverseid': 98490}, {'name': 'Sierpe dragón', 'type': 'Criatura — Sierpe', 'flavor': 'Lo más espeluznante de la sierpe dragón es probablemente el horrible estrépito que hace al moverse velozmente a través del bosque. Este ruido es tan fuerte que hace eco a través de los árboles y parece venir de todas direcciones al mismo tiempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99930&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b21a7658-fc90-4f98-b83e-13c6ae99129b', 'multiverseId': 99930}, 'multiverseid': 99930}, {'name': 'Guivre vorace', 'type': 'Créature : guivre', 'flavor': 'Le plus terrifiant, ce sont les sinistres craquements de la guivre vorace qui chasse dans la forêt. Ils se répercutent dans les arbres et semblent venir de partout à la fois.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98130&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bee02614-d598-4b85-91e0-751fa0f77020', 'multiverseId': 98130}, 'multiverseid': 98130}, {'name': 'Wurm Devastatore', 'type': 'Creatura — Wurm', 'flavor': 'La cosa più terrificante del wurm devastatore sono probabilmente i terribili schianti che produce quando si muove rapidamente nella foresta. Il rumore è così forte che riecheggia tra gli alberi e sembra venire da tutte le direzioni contemporaneamente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98850&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '28bac954-fd16-44cd-b0a1-d5ca4b478791', 'multiverseId': 98850}, 'multiverseid': 98850}, {'name': '大喰らいのワーム', 'type': 'クリーチャー — ワーム', 'flavor': 'このワームのいちばんの恐ろしさは、木々を砕いて森を進むときのすさまじい音にある。 その音は木々の間で激しくこだまし、まるで自分がその中心にいるような錯覚を起こさせるのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99210&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ffcb632e-089f-46f5-b52a-4c9e00874d16', 'multiverseId': 99210}, 'multiverseid': 99210}, {'name': 'Serpente Terrestre de Craw', 'type': 'Criatura — Vorme', 'flavor': 'Provavelmente, o que há de mais aterrador na serpente terrestre de craw é o horrível som de devastação que ela faz ao passar velozmente pela floresta. É um som tão alto que ecoa pelas árvores e parece vir de todos os lados.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99570&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0788d6af-10ce-4a02-8fe9-21a6abfa12ad', 'multiverseId': 99570}, 'multiverseid': 99570}, {'name': 'Зобатый вурм', 'type': 'Существо — Вурм', 'flavor': 'Самое ужасное это то, с каким страшным шумом этот зобатый вурм продирается через лес. Шум отражается эхом меж деревьев, и кажется, что он звучит сразу со всех сторон.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109841&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f0a22641-ead4-4f52-9d42-9d9eb2b541f8', 'multiverseId': 109841}, 'multiverseid': 109841}, {'name': '巨爪亚龙', 'type': '生物～亚龙', 'flavor': '巨爪亚龙最可怕之处，大概便是他高速冲过森林时所造成的恐怖声响了。 那巨大的声响在树间回荡不歇，有如同时从四面八方而来。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97770&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b3dee373-79f7-4974-8f19-6297f559f91c', 'multiverseId': 97770}, 'multiverseid': 97770}]", '[{\'name\': \'Teferis Rätselkiste\', \'text\': \'Zu Beginn seines Ziehsegments legt jeder Spieler die Karten, die er auf der Hand hat, in beliebiger Reihenfolge unter seine Bibliothek und zieht genau so viele Karten nach.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98740&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09b51abc-5fed-466e-b2f1-681928c9a33f\', \'multiverseId\': 98740}, \'multiverseid\': 98740}, {\'name\': \'Rompecabezas de Teferi\', \'text\': \'Al inicio del paso de robar de cada jugador, ese jugador pone las cartas que tenga en la mano en la parte inferior de su biblioteca en cualquier orden, luego roba ese mismo número de cartas.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100180&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'867e0ae4-803f-47f3-9ba2-aa8a42d4cfd7\', \'multiverseId\': 100180}, \'multiverseid\': 100180}, {\'name\': \'Boîte à mystère de Téfeiri\', \'text\': "Au début de l\'étape de pioche de chaque joueur, ce joueur compte les cartes de sa main, puis les met au-dessous de sa bibliothèque dans l\'ordre de son choix, puis pioche ce même nombre de cartes.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98380&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af8b9c36-082f-4ceb-aca8-85953c353634\', \'multiverseId\': 98380}, \'multiverseid\': 98380}, {\'name\': \'Scatola degli Enigmi di Teferi\', \'text\': "All\'inizio della propria acquisizione, ciascun giocatore mette le carte della propria mano in fondo al proprio grimorio nell\'ordine che preferisce, poi pesca altrettante carte.", \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99100&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2a0ce54-6c86-42d4-ade7-8c750019c673\', \'multiverseId\': 99100}, \'multiverseid\': 99100}, {\'name\': \'テフェリーの細工箱\', \'text\': \'各プレイヤーのドロー・ステップの開始時に、そのプレイヤーは自分の手札のカードを自分のライブラリーの一番下に好きな順番で置く。その後、同じ枚数のカードを引く。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99460&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f4a8163f-0fc3-40b4-93c6-419f2260f0cb\', \'multiverseId\': 99460}, \'multiverseid\': 99460}, {\'name\': \'Quebra-cabeças de Teferi\', \'text\': \'No início da etapa de compra de cada jogador, aquele jogador coloca os cards de sua mão no fundo de seu próprio grimório em qualquer ordem e, a seguir, compra a mesma quantidade de cards.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99820&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63d713a4-c1fd-4bcf-a26c-ea41935651e8\', \'multiverseId\': 99820}, \'multiverseid\': 99820}, {\'name\': \'Ящик загадок Тефери\', \'text\': \'Каждый игрок в начале своего этапа взятия карт кладет карты из руки в библиотеку сверху в произвольном порядке, а затем берет столько же карт.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110091&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0466e8c2-9a45-434d-af8f-18fbc0b29f1e\', \'multiverseId\': 110091}, \'multiverseid\': 110091}, {\'name\': \'泰菲力的魔术方块\', \'text\': \'在每位牌手的抓牌步骤开始时，该牌手将其手牌以任意次序置于其牌库底，然后抓等量的牌。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98020&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac9efdd7-accd-4501-a05f-c53519ed7e16\', \'multiverseId\': 98020}, \'multiverseid\': 98020}]', '[{\'name\': \'Telepathie\', \'text\': \'Alle deine Gegner spielen mit offenen Karten.\', \'type\': \'Verzauberung\', \'flavor\': \'„Geheimnisse? Was für Geheimnisse?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98741&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7dd7f91-fefd-4100-b1c9-50a6dbeef2ab\', \'multiverseId\': 98741}, \'multiverseid\': 98741}, {\'name\': \'Telepatía\', \'text\': \'Tus oponentes juegan mostrando sus manos.\', \'type\': \'Encantamiento\', \'flavor\': \'"¿Secretos? ¿Cuáles secretos?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100181&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb18085e-233b-4f9f-a454-50f4095b52f2\', \'multiverseId\': 100181}, \'multiverseid\': 100181}, {\'name\': \'Télépathie\', \'text\': \'Vos adversaires jouent avec leurs mains révélées.\', \'type\': \'Enchantement\', \'flavor\': \'« Des secrets ? Quels secrets ? »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98381&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d5783af5-f1a5-4b39-b359-8cd3ca27d193\', \'multiverseId\': 98381}, \'multiverseid\': 98381}, {\'name\': \'Telepatia\', \'text\': \'I tuoi avversari giocano a carte scoperte.\', \'type\': \'Incantesimo\', \'flavor\': \'"Segreti? Cosa sono?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99101&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e322d18-43e2-4c38-9ec9-96f3478dd97d\', \'multiverseId\': 99101}, \'multiverseid\': 99101}, {\'name\': \'テレパシー\', \'text\': \'あなたの対戦相手は、手札を公開したままプレイする。\', \'type\': \'エンチャント\', \'flavor\': \'秘密？ 秘密なんてあるの？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99461&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9b5d4ce1-e3d1-4644-a4a6-a6a918b511ec\', \'multiverseId\': 99461}, \'multiverseid\': 99461}, {\'name\': \'Telepatia\', \'text\': \'Seus oponentes jogam com os cards de suas respectivas mãos revelados.\', \'type\': \'Encantamento\', \'flavor\': \'"Segredos? Que segredos?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99821&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76a35917-7981-4ad3-953c-3abb75a4e824\', \'multiverseId\': 99821}, \'multiverseid\': 99821}, {\'name\': \'Телепатия\', \'text\': \'Ваши оппоненты играют с открытыми руками.\', \'type\': \'Чары\', \'flavor\': \'"Секреты? Какие могут быть секреты?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110092&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0cd33ea4-cfd2-4c00-926d-a725cc0ea68e\', \'multiverseId\': 110092}, \'multiverseid\': 110092}, {\'name\': \'心灵感应\', \'text\': \'对手以展示手牌的方式进行游戏。\', \'type\': \'结界\', \'flavor\': \'「秘密？ 什么秘密？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98021&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4413cc74-5277-4158-83ce-282eb7414328\', \'multiverseId\': 98021}, \'multiverseid\': 98021}]', "[{'name': 'Teuflischer Lehrmeister', 'text': 'Durchsuche deine Bibliothek nach einer Karte und nimm diese Karte auf deine Hand. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die besten Ideen kommen oft aus den verdrehtesten Hirnen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98504&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0f96abb2-38ba-4f23-a55a-ba1fad1f4853', 'multiverseId': 98504}, 'multiverseid': 98504}, {'name': 'Tutor diabólico', 'text': 'Busca en tu biblioteca una carta y pon esa carta en tu mano. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'Las mejores ideas frecuentemente vienen de las peores mentes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99944&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '75178fb6-f313-4639-9fd8-525bf5df0930', 'multiverseId': 99944}, 'multiverseid': 99944}, {'name': 'Précepteur démoniaque', 'text': 'Cherchez une carte dans votre bibliothèque et mettez cette carte dans votre main. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'Les meilleures idées viennent parfois des pires esprits.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98144&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0eb91561-1c4e-4419-a384-7260791cc420', 'multiverseId': 98144}, 'multiverseid': 98144}, {'name': 'Tutore Diabolico', 'text': 'Passa in rassegna il tuo grimorio, scegli una carta e aggiungila alla tua mano. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'Le idee migliori spesso vengono dalle menti peggiori.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98864&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ac6df992-23aa-4409-92c0-6a1ef15feddf', 'multiverseId': 98864}, 'multiverseid': 98864}, {'name': '魔性の教示者', 'text': 'あなたのライブラリーからカードを１枚探し、それをあなたの手札に加える。 その後、あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': '最高のアイデアは、往々にして最低の心から生まれるんだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99224&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0e8a4fab-e9da-42e4-9eb4-59dc679b8eaa', 'multiverseId': 99224}, 'multiverseid': 99224}, {'name': 'Tutor Diabólico', 'text': 'Procure em seu grimório por um card e coloque-o em sua mão. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'As melhores idéias costumam vir das piores mentes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99584&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a8aad57d-cba6-42ef-b728-f149b81030cd', 'multiverseId': 99584}, 'multiverseid': 99584}, {'name': 'Дьявольский наставник', 'text': 'Найдите нужную карту в своей библиотеке и поместите ее в руку. Затем перетасуйте библиотеку.', 'type': 'Волшебство', 'flavor': 'Порою худшие умы порождают гениальнейшие мысли.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109855&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd34e7391-5ceb-4104-9146-fce8e7703f9a', 'multiverseId': 109855}, 'multiverseid': 109855}, {'name': '恶魔导师', 'text': '从你的牌库中搜寻一张牌并置于你手上。 然后将你的牌库洗牌。', 'type': '法术', 'flavor': '最好的点子常常出自最坏的心灵。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97784&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0c0951ef-77b8-4901-ba7a-047b71da474a', 'multiverseId': 97784}, 'multiverseid': 97784}]", '[{\'name\': \'Thran-Golem\', \'text\': \'Solange der Thran-Golem verzaubert ist, erhält er +2/+2, Flugfähigkeit und Erstschlag und verursacht Trampelschaden.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'So wie der Biberzahn wächst, wenn er nicht ständig nagt, so wächst auch die Rüstung des Golems, wenn er nicht ständig kämpft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9fbe466-a1f2-4dab-9841-a6159d95fc0b\', \'multiverseId\': 98746}, \'multiverseid\': 98746}, {\'name\': \'Gólem thran\', \'text\': \'Mientras el Gólem thran esté encantado, obtiene +2/+2 y tiene las habilidades de volar, dañar primero y arrollar.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Como los dientes de un castor crecen sin el uso regular, la armadura del gólem crece sin batallas regulares.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100186&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98f827c1-7f60-4e39-a4df-788d3250561d\', \'multiverseId\': 100186}, \'multiverseid\': 100186}, {\'name\': \'Golem thran\', \'text\': "Tant que le Golem thran est enchanté, il gagne +2/+2 et il a le vol, l\'initiative et le piétinement.", \'type\': \'Créature-artefact : golem\', \'flavor\': "Tout comme les dents du castor s\'il ne les utilise pas, l\'armure du golem ne cesse de grandir s\'il ne se bat pas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98386&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f1b989f3-5899-4e1c-9429-bf6ea3dfa07b\', \'multiverseId\': 98386}, \'multiverseid\': 98386}, {\'name\': \'Golem Thran\', \'text\': \'Fintanto che il Golem Thran è incantato, prende +2/+2 e ha volare, attacco improvviso e travolgere.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': "Come i denti di un castoro crescono a dismisura se non sono usati regolarmente, così l\'armatura di un golem cresce senza l\'uso regolare in battaglia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99106&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dc522cd2-b592-49ca-afc8-aff56d45c46f\', \'multiverseId\': 99106}, \'multiverseid\': 99106}, {\'name\': \'スランのゴーレム\', \'text\': \'スランのゴーレムがエンチャントされている限り、それは+2/+2の修整を受けるとともに飛行と先制攻撃とトランプルを持つ。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'使われないビーバーの歯が無制限に伸びていくように、戦いに臨まないゴーレムの鎧も伸びていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99466&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'738c2baf-6935-4ed5-a1eb-2505d6852dab\', \'multiverseId\': 99466}, \'multiverseid\': 99466}, {\'name\': \'Golem dos Thran\', \'text\': \'Desde que Golem dos Thran esteja encantado, ele recebe +2/+2 e tem as habilidades de voar, de iniciativa e de atropelar.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Como os dentes de um castor que crescem desenfreadamente sem uso contínuo, a armadura do golem cresce sem batalhas freqüentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99826&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'797dc5cf-49ad-431c-a734-a2c4b095ee4a\', \'multiverseId\': 99826}, \'multiverseid\': 99826}, {\'name\': \'Голем Трана\', \'text\': \'Пока Голем Трана зачарован, он получает +2/+2, способность полета, первого удара и пробивающего удара.\', \'type\': \'Артефактное существо — Голем\', \'flavor\': \'Если бобер не орудует зубами, они растут и растут, так и броня голема растет, если он не участвует в битвах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110097&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'af907366-f070-47e5-9b24-fb4c9006b4f2\', \'multiverseId\': 110097}, \'multiverseid\': 110097}, {\'name\': \'索蓝魔像\', \'text\': \'若索蓝魔像上结附了结界，它便得+2/+2并具有飞行、先攻和践踏异能。\', \'type\': \'神器生物～魔像\', \'flavor\': \'河狸牙齿若太少使用便会不断增长，而魔像的护甲若少受战火磨耗也会不停增厚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98026&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c2e8ba1-0834-44d9-9991-16476e1bb905\', \'multiverseId\': 98026}, \'multiverseid\': 98026}]', '[{\'name\': \'Tiefseemonster\', \'text\': \'Das Tiefseemonster kann nicht angreifen, wenn der verteidigende Spieler keine Insel kontrolliert.\', \'type\': \'Kreatur — Schlange\', \'flavor\': \'Es ist nicht schwer, das Monster als Mythos abzutun bis du merkst, wie 3000 Zentner Mythos sich um dein Schiff schlingen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98699&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'98e8ea2f-e2cc-489c-8280-9776dc5ba21c\', \'multiverseId\': 98699}, \'multiverseid\': 98699}, {\'name\': \'Engendro marino\', \'text\': \'El Engendro marino no puede atacar a menos que el jugador defensor controle una isla.\', \'type\': \'Criatura — Serpiente\', \'flavor\': \'Es fácil creer que el monstruo es un mito hasta que sientes cómo 136 toneladas de mito aplastan tu embarcación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100139&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b37d608f-d056-400c-b261-47a621a043ce\', \'multiverseId\': 100139}, \'multiverseid\': 100139}, {\'name\': \'Monstre marin\', \'text\': \'Le Monstre marin ne peut pas attaquer, à moins que le joueur défenseur contrôle au moins une île.\', \'type\': \'Créature : serpent\', \'flavor\': "Il est facile de croire que le monstre est un mythe — mais vous changerez d\'avis quand vous sentirez deux cents kilos de mythe éperonner votre navire", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98339&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69ddb73d-94b9-4b96-ae56-91c986a2d646\', \'multiverseId\': 98339}, \'multiverseid\': 98339}, {\'name\': \'Mostro Marino\', \'text\': "Il Mostro Marino non può attaccare a meno che il giocatore in difesa controlli almeno un\'Isola.", \'type\': \'Creatura — Serpe\', \'flavor\': \'È facile credere che il mostro sia solo una leggenda... almeno fintanto che non senti duecento tonnellate di leggenda che si abbattono sulla tua nave.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99059&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'62ea1768-344b-407e-94ac-d73bc3a0da7a\', \'multiverseId\': 99059}, \'multiverseid\': 99059}, {\'name\': \'シー・モンスター\', \'text\': \'シー・モンスターは、防御側プレイヤーが島をコントロールしていない限り攻撃に参加できない。\', \'type\': \'クリーチャー — 海蛇\', \'flavor\': \'モンスターが神話に過ぎないと信じるのはたやすい――お前の船を、150トンもの神話が叩き潰しに来るまでの話だが。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99419&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4481a7b5-6c49-431d-b8a6-00a89b80a58b\', \'multiverseId\': 99419}, \'multiverseid\': 99419}, {\'name\': \'Monstro Marinho\', \'text\': \'Monstro Marinho não pode atacar, a menos que o jogador defensor controle uma Ilha.\', \'type\': \'Criatura — Serpente\', \'flavor\': \'É fácil acreditar que o monstro é um mito até que sintas duzentas toneladas de mito esmagando teu navio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99779&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9629d05d-425e-421d-b289-1ff9920c9921\', \'multiverseId\': 99779}, \'multiverseid\': 99779}, {\'name\': \'Морское чудовище\', \'text\': \'Морское чудовище может нападать, только если обороняющийся игрок контролирует остров.\', \'type\': \'Существо — Змея\', \'flavor\': \'Можно считать, что чудовище это миф, пока триста тысяч фунтов этого самого мифического чудовища не обрушатся на ваш корабль.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110050&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'abdcc3ea-38cd-4368-8062-c340e5b4e8e1\', \'multiverseId\': 110050}, \'multiverseid\': 110050}, {\'name\': \'大海妖\', \'text\': \'除非防御牌手操控海岛，否则大海妖不能攻击。\', \'type\': \'生物～巨蛇\', \'flavor\': \'这种怪物的传说很容易给当成迷思～直到你感到三十万磅的迷思重重压上船身。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97979&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc7778c6-6093-4a7a-a942-a2f35c890227\', \'multiverseId\': 97979}, \'multiverseid\': 97979}]', '[{\'name\': \'Todesgruben von Rath\', \'text\': \'Immer wenn einer Kreatur Schaden zugefügt wird, zerstöre sie. Sie kann nicht regeneriert werden.\', \'type\': \'Verzauberung\', \'flavor\': \'„Ich konnte auch nicht vergessen, was ich über diese Gruben gelesen hatte — nämlich, dass es nicht ihre grausige Bestimmung war, das Leben plötzlich auszulöschen." —Edgar Allan Poe, „Grube und Pendel"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98497&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eed734d2-6dd4-4b29-908f-0c08d4ef38e6\', \'multiverseId\': 98497}, \'multiverseid\': 98497}, {\'name\': \'Pozos de la muerte de Rath\', \'text\': \'Siempre que una criatura reciba daño, destrúyela. No puede ser regenerada.\', \'type\': \'Encantamiento\', \'flavor\': \'"Tampoco podía olvidar lo que había leído sobre estos pozos: que la extinción repentina de la vida no formaba parte de su plan horripilante." —Edgar Allan Poe, "El pozo y el péndulo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99937&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4a749bf3-33d5-4707-924b-f279ed122c87\', \'multiverseId\': 99937}, \'multiverseid\': 99937}, {\'name\': \'Mort-fosses de Rajh\', \'text\': "À chaque fois qu\'une créature subit des blessures, détruisez-la. Elle ne peut pas être régénérée.", \'type\': \'Enchantement\', \'flavor\': "« Je vois les reflets d\'une aurore dont je ne verrai pas se lever le soleil. Il ne me reste qu\'à m\'asseoir au bord de ma fosse ; après quoi, je descendrai hardiment, le crucifix à la main, dans l\'éternité? » —François René de Chateaubriand", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98137&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'97ba7cf3-c664-4ef4-9ab1-fc00744d3aaf\', \'multiverseId\': 98137}, \'multiverseid\': 98137}, {\'name\': \'Abissi della Morte di Rath\', \'text\': \'Ogniqualvolta viene inflitto danno a una creatura, distruggila. Non può essere rigenerata.\', \'type\': \'Incantesimo\', \'flavor\': \'"Né potevo dimenticare ciò che avevo letto di queste pozze: che l\\\'improvvisa estinzione della vita non rientrava neanche nel loro più terribile piano." —Edgar Allan Poe, "Il Pozzo e il Pendolo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98857&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea320724-47e0-47b2-8286-2b01bdd05ace\', \'multiverseId\': 98857}, \'multiverseid\': 98857}, {\'name\': \'ラースの死の奈落\', \'text\': \'いずれかのクリーチャーにダメージが与えられるたび、それを破壊する。 それは再生できない。\', \'type\': \'エンチャント\', \'flavor\': \'忘れられないのは、ここまで読んでいただいた陥穽のことばかりではない――突然の生命の喪失が、この最も恐ろしい計画の一部ですらなかったということだ。 ――エドガー・アラン・ポー 「陥穽と振子」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99217&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'44420948-de4c-4586-862c-8c940b115f37\', \'multiverseId\': 99217}, \'multiverseid\': 99217}, {\'name\': \'Fossos da Morte de Rath\', \'text\': \'Toda vez que uma criatura sofrer dano, destrua-a. Ela não pode ser regenerada.\', \'type\': \'Encantamento\', \'flavor\': \'"E também não podia me esquecer do que havia lido sobre esses fossos que a súbita extinção da vida não fazia parte de seu plano mais pavoroso." — Edgar Allan Poe, "O Fosso e o Pêndulo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99577&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a0a81a00-0936-4473-809a-f4c15b5cf429\', \'multiverseId\': 99577}, \'multiverseid\': 99577}, {\'name\': \'Колодец смерти Рата\', \'text\': \'Каждый раз, когда существу наносятся повреждения, уничтожьте его. Оно не может быть регенерировано.\', \'type\': \'Чары\', \'flavor\': \'"К тому же из головы не шло то, что я читал о таких колодцах мгновенно расстаться с жизнью там еще никому не удавалось". — Эдгар Алан По, "Колодец и маятник"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109848&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fb3d48e7-2863-47d4-bf5c-560cf8e208a8\', \'multiverseId\': 109848}, \'multiverseid\': 109848}, {\'name\': \'瑞斯死渊\', \'text\': \'每当任何生物受到伤害时，将其消灭。 它不能重生。\', \'type\': \'结界\', \'flavor\': \'「我也无法忘记关于这些深渊的记叙～生命突然灭绝的惨事，在他们可怕至极的计划中还不值一提。」 ～爱伦‧坡， 「陷阱与钟摆」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97777&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'478b52c1-44a2-4f8b-89b6-cf8d980ca098\', \'multiverseId\': 97777}, \'multiverseid\': 97777}]', '[{\'name\': \'Todespakt\', \'text\': \'Immer wenn eine Kreatur, die du kontrollierst, aus dem Spiel auf einen Friedhof gelegt wird, opfert jeder andere Spieler eine Kreatur.\', \'type\': \'Verzauberung\', \'flavor\': \'„Ein Treuebund kann einen auch ins Grab bringen." —Crovax, Aufsteigender Evincar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98562&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e514406-b3ab-4d5f-a8e6-2e9c4b385dbc\', \'multiverseId\': 98562}, \'multiverseid\': 98562}, {\'name\': \'Pacto de las sepulturas\', \'text\': \'Siempre que una criatura que controles vaya a un cementerio desde el juego, cada uno de los demás jugadores sacrifica una criatura.\', \'type\': \'Encantamiento\', \'flavor\': \'"Los lazos de la lealtad pueden atarnos a la tumba." —Crovax, évincar predominante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100002&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ee359c39-eba2-47f4-87e9-93f2213e17de\', \'multiverseId\': 100002}, \'multiverseid\': 100002}, {\'name\': \'Pacte de la tombe\', \'text\': "À chaque fois qu\'une créature que vous contrôlez est mise dans un cimetière depuis le jeu, chaque autre joueur sacrifie une créature.", \'type\': \'Enchantement\', \'flavor\': \'« Les liens de la loyauté peuvent vous attacher à votre tombe. » — Crovax, incarmal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98202&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0185c4a-65d0-4b99-b911-43577af61c0d\', \'multiverseId\': 98202}, \'multiverseid\': 98202}, {\'name\': \'Patto Sepolcrale\', \'text\': \'Ogniqualvolta una creatura che controlli viene messa in un cimitero dal gioco, ogni altro giocatore sacrifica una creatura.\', \'type\': \'Incantesimo\', \'flavor\': \'"I legami della lealtà possono incatenarti alla tomba." —Crovax, evincaro dominante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98922&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c714c37-7bb3-4e62-ac3f-ff2d278637b3\', \'multiverseId\': 98922}, \'multiverseid\': 98922}, {\'name\': \'墓穴までの契約\', \'text\': \'あなたがコントロールするいずれかのクリーチャーが場からいずれかの墓地に置かれるたび、他のプレイヤーはそれぞれクリーチャーを１体生け贄に捧げる。\', \'type\': \'エンチャント\', \'flavor\': \'忠誠の絆は、墓穴の中までつながっているのだ。 ――隆盛なるエヴィンカー、クロウヴァクス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99282&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c685ef33-8be2-4b75-b474-1b849d2a3139\', \'multiverseId\': 99282}, \'multiverseid\': 99282}, {\'name\': \'Pacto da Sepultura\', \'text\': \'Toda vez que uma criatura que você controla for colocada num cemitério vinda de jogo, cada um dos outros jogadores sacrifica uma criatura.\', \'type\': \'Encantamento\', \'flavor\': \'"Os laços de lealdade são capazes de atar-te a uma sepultura." — Crovax, evincar ascendente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99642&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1e66d0e2-f9b6-4e00-9010-532476cb502e\', \'multiverseId\': 99642}, \'multiverseid\': 99642}, {\'name\': \'Соглашение о захоронении\', \'text\': \'Каждый раз, когда существо, которое вы контролируете, попадает на кладбище, все остальные игроки приносят в жертву по одному существу.\', \'type\': \'Чары\', \'flavor\': \'"Оковы преданности могут сдавить насмерть". — Кровакс, правящий эвинкар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109913&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4f3887f-9e1e-49d1-a6c9-0c21e6ac0ebc\', \'multiverseId\': 109913}, \'multiverseid\': 109913}, {\'name\': \'墓约\', \'text\': \'每当一个由你操控的生物从场上置入坟墓场时，其它每位牌手各牺牲一个生物。\', \'type\': \'结界\', \'flavor\': \'「忠诚的束缚可以把人绑到坟墓里。」 ～天威大魔将寇维克斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97842&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8692c61b-c211-4668-9464-9ec308a6123c\', \'multiverseId\': 97842}, \'multiverseid\': 97842}]', '[{\'name\': \'Todesstarrer\', \'text\': \'Immer wenn der Todesstarrer eine nichtschwarze Kreatur blockt oder von ihr geblockt wird, zerstöre diese Kreatur am Ende des Kampfes.\', \'type\': \'Kreatur — Eidechse\', \'flavor\': \'Dein ganzes Leben läuft vor seinen Augen ab.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98498&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36a3187c-3eca-42c4-8463-a5828b222aa6\', \'multiverseId\': 98498}, \'multiverseid\': 98498}, {\'name\': \'Contemplador mortal\', \'text\': \'Siempre que el Contemplador mortal bloquee o sea bloqueado por una criatura que no sea negra, destruye esa criatura al final del combate.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'Tu vida entera pasa frente a sus ojos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99938&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ea44b51-a83c-4a5b-988c-49d85c0e6e17\', \'multiverseId\': 99938}, \'multiverseid\': 99938}, {\'name\': \'Œil-de-mort\', \'text\': "À chaque fois que l\'Œil-de-mort bloque ou devient bloqué par une créature non-noire, détruisez cette créature à la fin du combat.", \'type\': \'Créature : lézard\', \'flavor\': \'Votre vie toute entière passe devant ses yeux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98138&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34e90cf5-3e7b-4d4a-a7f9-d58187f890dc\', \'multiverseId\': 98138}, \'multiverseid\': 98138}, {\'name\': \'Sguardo Mortale\', \'text\': \'Ogniqualvolta lo Sguardo Mortale blocca o viene bloccato da una creatura non nera, distruggi quella creatura alla fine del combattimento.\', \'type\': \'Creatura — Lucertola\', \'flavor\': \'Tutta la tua vita passa davanti ai suoi occhi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98858&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d320279-e726-40cc-aec8-e4b42bad5e84\', \'multiverseId\': 98858}, \'multiverseid\': 98858}, {\'name\': \'凶眼のトカゲ\', \'text\': \'凶眼のトカゲがいずれかの黒でないクリーチャーをブロックするかブロックされた状態になるたび、戦闘終了時にそのクリーチャーを破壊する。\', \'type\': \'クリーチャー — トカゲ\', \'flavor\': \'お前の人生すべては、そいつの目の前で終わる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99218&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce2b8f95-d091-47e9-9085-f1c8245c6bd3\', \'multiverseId\': 99218}, \'multiverseid\': 99218}, {\'name\': \'Lagarto Olho-de-morte\', \'text\': \'Toda vez que Lagarto Olho-de-morte bloquear ou for bloqueado por uma criatura que não seja preta, destrói aquela criatura no final do combate.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'A tua vida inteira passa diante dos olhos dele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99578&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'949b7858-5d3e-4ebc-ba4f-76fe2f8e7c2c\', \'multiverseId\': 99578}, \'multiverseid\': 99578}, {\'name\': \'Смертельный наблюдатель\', \'text\': \'Каждый раз, когда Смертельный наблюдатель блокирует или заблокирован нечерным существом, уничтожьте это существо в конце боя.\', \'type\': \'Существо — Ящерица\', \'flavor\': \'Вся жизнь пройдет у вас перед глазами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109849&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb4d273d-4f87-4e12-94e1-feb3f28961a9\', \'multiverseId\': 109849}, \'multiverseid\': 109849}, {\'name\': \'致命妖瞳\', \'text\': \'每当致命妖瞳阻挡非黑色生物或被非黑色生物阻挡，在战斗结束时消灭该生物。\', \'type\': \'生物～蜥蜴\', \'flavor\': \'你的一生在他眼前掠过。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97778&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'18db4699-dbe0-449f-9b95-ecfc1d0b842f\', \'multiverseId\': 97778}, \'multiverseid\': 97778}]', '[{\'name\': \'Todlose Moorleiche\', \'text\': \'Sumpftarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler einen Sumpf kontrolliert.)\', \'type\': \'Kreatur — Wraith\', \'flavor\': \'Die Körper ihrer Opfer sind die einzigen Spuren, die sie hinterlässt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98470&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34e274ce-8a62-4104-9e94-a7b2a1a6a8d2\', \'multiverseId\': 98470}, \'multiverseid\': 98470}, {\'name\': \'Aparición de la ciénaga\', \'text\': \'Cruza pantanos. (Esta criatura es imbloqueable mientras el jugador defensor controle un pantano.)\', \'type\': \'Criatura — Aparición\', \'flavor\': \'Los cuerpos de sus víctimas son las únicas huellas que deja.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99910&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e47899d-167d-42a0-94e4-b1f1b5b73dda\', \'multiverseId\': 99910}, \'multiverseid\': 99910}, {\'name\': \'Apparition des marécages\', \'text\': \'Traversée des marais (Cette créature est imblocable tant que le joueur défenseur contrôle au moins un marais.)\', \'type\': \'Créature : apparition\', \'flavor\': "« L\'homme, fantôme errant, passe, sans laisser même son ombre sur le mur » —Victor Hugo, Les Feuilles d\'automne", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98110&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b44a6496-9edc-45af-a156-562f44ccd92f\', \'multiverseId\': 98110}, \'multiverseid\': 98110}, {\'name\': \'Necrospettro delle Paludi\', \'text\': \'Passa-paludi (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla almeno una Palude.)\', \'type\': \'Creatura — Necrospettro\', \'flavor\': "I corpi delle sue vittime sono l\'unica traccia che lascia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98830&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fba20a93-5645-4388-bc24-d4919515a945\', \'multiverseId\': 98830}, \'multiverseid\': 98830}, {\'name\': \'沼の悪霊\', \'text\': \'沼渡り （このクリーチャーは防御プレイヤーが沼をコントロールしている限りブロックされない。）\', \'type\': \'クリーチャー — レイス\', \'flavor\': \'あれが通った痕跡といえば、えじきになったものたちの死体だけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99190&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a48c26b8-7538-4265-a9b4-8c58c06e8630\', \'multiverseId\': 99190}, \'multiverseid\': 99190}, {\'name\': \'Aparição do Pântano\', \'text\': \'Travessia de Pântano (Esta criatura não pode ser bloqueada desde que o jogador defensor controle um Pântano.)\', \'type\': \'Criatura — Aparição\', \'flavor\': \'Os corpos das vítimas são os únicos rastros que ele deixa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99550&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'804c9887-6af0-4fc5-bcc1-66986a598b7d\', \'multiverseId\': 99550}, \'multiverseid\': 99550}, {\'name\': \'Болотная тень\', \'text\': \'Знание болот (Это существо невозможно заблокировать, пока обороняющийся игрок контролирует Болото).\', \'type\': \'Существо — Тень\', \'flavor\': \'Там, где он проходит, остаются лишь тела его жертв.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109821&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8915390d-b6d4-4fbd-bd7d-9f1a8a151167\', \'multiverseId\': 109821}, \'multiverseid\': 109821}, {\'name\': \'腐沼鬼魂\', \'text\': \'沼泽行者（只要防御牌手操控沼泽，此生物便不能被阻挡）\', \'type\': \'生物～鬼魂\', \'flavor\': \'牺牲者的尸体是他唯一留下的形迹。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97750&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6c2e2ab-b1b3-457f-aadc-de7da6798b04\', \'multiverseId\': 97750}, \'multiverseid\': 97750}]', "[{'name': 'Torfbold', 'text': 'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)', 'type': 'Kreatur — Bold', 'flavor': 'Stell sie dir als Fleischermesser mit Flügeln vor.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98469&type=card', 'language': 'German', 'identifiers': {'scryfallId': '144c498d-7656-4aa0-8a7b-2c71a827b1c6', 'multiverseId': 98469}, 'multiverseid': 98469}, {'name': 'Diablillo del pantano', 'text': 'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)', 'type': 'Criatura — Diablillo', 'flavor': 'Imagina que es un cuchillo de carnicero con alas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99909&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0d1e4549-6094-4f53-a5a4-e0ad517cf3a4', 'multiverseId': 99909}, 'multiverseid': 99909}, {'name': 'Diablotin des marécages', 'text': 'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)', 'type': 'Créature : diablotin', 'flavor': 'Un couteau de boucher avec des ailes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98109&type=card', 'language': 'French', 'identifiers': {'scryfallId': '763beaaf-1bac-4ce8-a34a-27f503a023bf', 'multiverseId': 98109}, 'multiverseid': 98109}, {'name': 'Demonietto delle Paludi', 'text': 'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)', 'type': 'Creatura — Demonietto', 'flavor': 'Immaginalo come una mannaia con le ali.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98829&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b91e4743-d418-4fdf-a537-90ede8ada7e6', 'multiverseId': 98829}, 'multiverseid': 98829}, {'name': '沼インプ', 'text': '飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）', 'type': 'クリーチャー — インプ', 'flavor': 'こいつは翼のついた肉切り包丁なんだと思ってかかれ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99189&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0f430f4e-d539-4482-8496-7a85813c0858', 'multiverseId': 99189}, 'multiverseid': 99189}, {'name': 'Diabrete do Pântano', 'text': 'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)', 'type': 'Criatura — Diabrete', 'flavor': 'Imagina-o como uma faca de açougueiro com asas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99549&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8b41a13c-9324-4f51-b66b-1d0c145f9494', 'multiverseId': 99549}, 'multiverseid': 99549}, {'name': 'Болотный бес', 'text': 'Полет (Это существо может быть блокировано только существом со способностью полета).', 'type': 'Существо — Бес', 'flavor': 'Считайте, что это нож мясника, который обрел крылья.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109820&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0cfc8cb0-6da3-46e9-a783-c7f9621742ae', 'multiverseId': 109820}, 'multiverseid': 109820}, {'name': '腐沼小恶魔', 'text': '飞行（只有具飞行异能的生物才能阻挡它。）', 'type': '生物～小恶魔', 'flavor': '把他想成是有翅膀的屠刀。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97749&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e452a4be-5383-4323-94ac-b9a13422ecb9', 'multiverseId': 97749}, 'multiverseid': 97749}]", '[{\'name\': \'Totale Erschöpfung\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur erhält -2/-2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Wenn es schwach ist, töte es oder ignoriere es. Alles andere wertet es auf." —Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c49da2ff-1553-40f2-a218-6985e79972db\', \'multiverseId\': 98517}, \'multiverseid\': 98517}, {\'name\': \'Postración\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada obtiene -2/-2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Si es débil, mátalo o ignóralo. Cualquier otra cosa lo honra." —Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99957&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'afd3c6af-cc32-4ade-9285-a11d6d0c55e9\', \'multiverseId\': 99957}, \'multiverseid\': 99957}, {\'name\': \'Affaiblissement\', \'text\': \'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée gagne -2/-2.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Tuez ou ignorez tout ce qui est faible. Honorez le reste. » —Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98157&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db2b6436-6d1e-48e4-b0a3-f4b53bc14beb\', \'multiverseId\': 98157}, \'multiverseid\': 98157}, {\'name\': \'Debilitazione\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata prende -2/-2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Se è debole, uccidilo o ignoralo. Qualsiasi altra azione gli renderebbe onore." —Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98877&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'16ea0dc7-5b37-45f5-abfb-a36dece0f494\', \'multiverseId\': 98877}, \'multiverseid\': 98877}, {\'name\': \'弱体化\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは-2/-2の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'弱い相手は、殺すか、無視するかだ。 ほかは相手をつけあがらせる。 ――ケアヴェク\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99237&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eafc96c5-8278-408c-a35c-f4b311c603aa\', \'multiverseId\': 99237}, \'multiverseid\': 99237}, {\'name\': \'Enfraquecimento\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada recebe -2/-2.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Se estiver fraco, mate-o ou ignore-o. Qualquer outra coisa o honra." — Kaervek\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99597&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c2bd767-07c0-4045-ba77-3626f0d3a7a1\', \'multiverseId\': 99597}, \'multiverseid\': 99597}, {\'name\': \'Слабость\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает -2/-2.\', \'type\': \'Чары — Аура\', \'flavor\': \'"Ты или убей слабого, либо не обращай на него внимания. Всего остального он не достоин". — Каервек\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109868&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'149d2940-1562-48cb-b393-21004b7f67d8\', \'multiverseId\': 109868}, \'multiverseid\': 109868}, {\'name\': \'无力\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物得-2/-2。\', \'type\': \'结界～灵气\', \'flavor\': \'「弱者只须杀掉或是丢着不管。 其它的处置方法都算太厚待了。」 ～凯雷威克\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97797&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fdcd4c3b-8bfe-4b2d-8fd0-7b1cbfca1c1c\', \'multiverseId\': 97797}, \'multiverseid\': 97797}]', "[{'name': 'Totengräber', 'text': 'Wenn der Totengräber ins Spiel kommt, kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurücknehmen.', 'type': 'Kreatur — Zombie', 'flavor': 'Ein voller Sarg ist wie ein voller Koffer — beide sind attraktiv für Diebe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98563&type=card', 'language': 'German', 'identifiers': {'scryfallId': '29fdf843-c657-47c8-ac2f-3a704293add2', 'multiverseId': 98563}, 'multiverseid': 98563}, {'name': 'Sepulturero', 'text': 'Cuando el Sepulturero entre en juego, puedes regresar la carta objetivo de criatura de tu cementerio a tu mano.', 'type': 'Criatura — Zombie', 'flavor': 'Un ataúd ocupado es como un cofre lleno: ambos atraen a los ladrones.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100003&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd7eb416c-7652-40df-b1ec-2aa343d9c52e', 'multiverseId': 100003}, 'multiverseid': 100003}, {'name': 'Fossoyeur', 'text': 'Quand le Fossoyeur arrive en jeu, vous pouvez renvoyer une carte de créature ciblée depuis votre cimetière dans votre main.', 'type': 'Créature : zombie', 'flavor': 'Un cercueil plein, comme un coffre plein, attire les voleurs.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98203&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a2bd7337-1e3b-4f1e-a8bf-c7856d1a2568', 'multiverseId': 98203}, 'multiverseid': 98203}, {'name': 'Scavatombe', 'text': 'Quando lo Scavatombe entra in gioco, puoi riprendere in mano una carta creatura bersaglio dal tuo cimitero.', 'type': 'Creatura — Zombie', 'flavor': 'Una tomba piena è come un ricco forziere: entrambi attirano i ladri.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98923&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '90c0a2c0-8224-4ee1-ac24-d094ee161d59', 'multiverseId': 98923}, 'multiverseid': 98923}, {'name': 'グレイブディガー', 'text': 'グレイブディガーが場に出たとき、あなたの墓地にあるクリーチャー・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。', 'type': 'クリーチャー — ゾンビ', 'flavor': '副葬品がいっぱいの棺は、中味がいっぱいの貴重品箱と同じだ――どちらも泥棒にとって魅力的だという点で。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99283&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b9f426b4-ff25-445a-8c49-09baa375e7bd', 'multiverseId': 99283}, 'multiverseid': 99283}, {'name': 'Coveiro', 'text': 'Quando Coveiro entra em jogo, você pode devolver o card de criatura alvo de seu cemitério para a sua mão.', 'type': 'Criatura — Zumbi', 'flavor': 'Um caixão cheio é como um cofre cheio ambos são atraentes aos ladrões.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99643&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7b7c18cc-07dd-49df-85f8-975de8cf57cb', 'multiverseId': 99643}, 'multiverseid': 99643}, {'name': 'Могильщик', 'text': 'Когда Могильщик вступает в игру, вы можете вернуть целевую карту существа с кладбища в руку.', 'type': 'Существо — Зомби', 'flavor': 'Гроб что сундук: содержимое и того, и другого притягательно для воров.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109914&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6054dc8b-ccd1-4f10-b734-ad4e03cf4367', 'multiverseId': 109914}, 'multiverseid': 109914}, {'name': '掘墓怪', 'text': '当掘墓怪进场时，你可以将目标生物牌从你的坟墓场移回你手上。', 'type': '生物～灵俑', 'flavor': '满载的棺木就像满载的宝库～两者都对贼有吸引力。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97843&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cfad4b05-13a9-47eb-938b-919e66639116', 'multiverseId': 97843}, 'multiverseid': 97843}]", '[{\'name\': \'Traumatisierung\', \'text\': \'Ein Spieler deiner Wahl legt die obere Hälfte seiner Bibliothek (abgerundet) auf seinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'Du wirst gar nicht wissen, was dir fehlt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98754&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'95583e87-b298-4006-a28e-7e799ff5f097\', \'multiverseId\': 98754}, \'multiverseid\': 98754}, {\'name\': \'Traumatizar\', \'text\': \'El jugador objetivo pone la mitad superior de su biblioteca, redondeada hacia abajo, en su cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'No sabrás lo que te pierdes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100194&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93d95481-6c78-421e-83f0-d0dc807ced65\', \'multiverseId\': 100194}, \'multiverseid\': 100194}, {\'name\': \'Traumatisme\', \'text\': "Le joueur ciblé met la moitié des cartes (arrondie à l\'inférieur) du dessus de sa bibliothèque dans son cimetière.", \'type\': \'Rituel\', \'flavor\': \'Vous ne savez pas ce qui va vous manquer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98394&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8015352a-2301-4827-bf05-57d58a2c00d8\', \'multiverseId\': 98394}, \'multiverseid\': 98394}, {\'name\': \'Traumatizzare\', \'text\': \'Il giocatore bersaglio mette la metà superiore del proprio grimorio, arrotondata per difetto, nel proprio cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'Non ti sarà dato sapere cosa ti stai perdendo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99114&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0cb83b6-6206-45c9-b3e0-f8eba9020628\', \'multiverseId\': 99114}, \'multiverseid\': 99114}, {\'name\': \'心の傷跡\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの上から半分（端数は切捨て）を自分の墓地に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'失ったものなんて知らなくてもいいさ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99474&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'568aa975-5513-4600-a5b9-5a636a044048\', \'multiverseId\': 99474}, \'multiverseid\': 99474}, {\'name\': \'Traumatizar\', \'text\': \'O jogador alvo coloca a metade superior de seu próprio grimório, arredondada para baixo, em seu próprio cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'Você não vai saber o que está perdendo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99834&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c188be9-0d76-4cbf-b502-a9e8f1b66bfd\', \'multiverseId\': 99834}, \'multiverseid\': 99834}, {\'name\': \'Травма\', \'text\': \'Целевой игрок перемещает верхнюю половину библиотеки (округлять в меньшую сторону) на свое кладбище.\', \'type\': \'Волшебство\', \'flavor\': \'Вы не знаете, что теряете.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110105&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'359d61f9-b694-4dc4-a4ee-8b7ff3a8ecc0\', \'multiverseId\': 110105}, \'multiverseid\': 110105}, {\'name\': \'精神受创\', \'text\': \'目标牌手将其牌库从顶上算起一半数量的牌置入其坟墓场，小数点以下舍去。\', \'type\': \'法术\', \'flavor\': \'你不会晓得自己少了什么。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98034&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'117f4225-f6ff-41ce-9df0-3534a9da8486\', \'multiverseId\': 98034}, \'multiverseid\': 98034}]', '[{\'name\': \'Traumläufer\', \'text\': \'Der Traumläufer ist unblockbar, solange er alleine angreift.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'„Unglaublich manche halten Schlaf für einen erholsamen Zustand." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98507&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ea7f805-85b7-4c66-83e2-5f5cd6152a92\', \'multiverseId\': 98507}, \'multiverseid\': 98507}, {\'name\': \'Rondador onírico\', \'text\': \'El Rondador onírico es imbloqueable mientras ataque solo.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'"Y pensar que algunos descansan durante el sueño." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99947&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db954e0a-db93-447c-8c50-9031b60ceb8c\', \'multiverseId\': 99947}, \'multiverseid\': 99947}, {\'name\': \'Rôdeur des rêves\', \'text\': "Le Rôdeur des rêves est imblocable tant qu\'il attaque seul.", \'type\': \'Créature : illusion\', \'flavor\': "« Quand je pense qu\'il y en a qui trouvent le repos dans le sommeil. » —Wöhlrajh", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98147&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd90b0f9-58c5-4fe8-bedf-a2b0bf560e1d\', \'multiverseId\': 98147}, \'multiverseid\': 98147}, {\'name\': \'Predatore Onirico\', \'text\': \'Il Predatore Onirico non può essere bloccato fintanto che attacca da solo.\', \'type\': \'Creatura — Illusione\', \'flavor\': \'"E pensare che alcuni trovano ristoratore il sonno." —Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98867&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81b3a4f0-f974-47c2-b510-a267d58155fe\', \'multiverseId\': 98867}, \'multiverseid\': 98867}, {\'name\': \'夢でうろつくもの\', \'text\': \'夢でうろつくものは、単独で攻撃に参加している限りブロックされない。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'眠りが安らぎのときだなんていう奴がいるとはな。 ――ヴォルラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99227&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'285e419d-5149-4744-b6e2-c34467cec99b\', \'multiverseId\': 99227}, \'multiverseid\': 99227}, {\'name\': \'Espreitador dos Sonhos\', \'text\': \'Espreitador dos Sonhos não pode ser bloqueado desde que esteja atacando sozinho.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'"E pensar que alguns acham que o sono é um estado de repouso." — Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99587&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b0a2ea2c-15bd-4891-8694-e42279f1a5de\', \'multiverseId\': 99587}, \'multiverseid\': 99587}, {\'name\': \'Похититель снов\', \'text\': \'Похититель снов не блокируется, пока он нападает один.\', \'type\': \'Существо — Иллюзия\', \'flavor\': \'"Подумать только, кто-то считает, что он отдыхает во сне" — Волрат\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109858&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7cea0d1c-56fc-45bc-b318-62abe24fa6d7\', \'multiverseId\': 109858}, \'multiverseid\': 109858}, {\'name\': \'梦境巡影\', \'text\': \'只要梦境巡影单独进行攻击，它便不能被阻挡。\', \'type\': \'生物～虚影\', \'flavor\': \'「而有人竟把睡眠视为休息。」 ～瓦拉司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97787&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c7a3e3c4-9b88-4b37-a065-c7ae701d9223\', \'multiverseId\': 97787}, \'multiverseid\': 97787}]', '[{\'name\': \'Treibsand\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}, opfere den Treibsand: Eine angreifende Kreatur deiner Wahl ohne Flugfähigkeit erhält -1/-2 bis zum Ende des Zuges.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98666&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d03a8cc9-b522-47e1-9632-0989a6f647f3\', \'multiverseId\': 98666}, \'multiverseid\': 98666}, {\'name\': \'Arenas movedizas\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{T}, sacrificar las Arenas movedizas: La criatura atacante objetivo sin la habilidad de volar obtiene -1/-2 hasta el final del turno.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100106&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2505f75-89e5-47f0-a395-5a7f0e9b8df5\', \'multiverseId\': 100106}, \'multiverseid\': 100106}, {\'name\': \'Sables mouvants\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{T}, Sacrifiez les Sables mouvants : La créature attaquante sans le vol ciblée gagne -1/-2 jusqu\'à la fin du tour.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78017c42-b72c-4c77-8c19-c30145890a04\', \'multiverseId\': 98306}, \'multiverseid\': 98306}, {\'name\': \'Sabbie Mobili\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}, Sacrifica le Sabbie Mobili: La creatura attaccante bersaglio senza volare prende -1/-2 fino alla fine del turno.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99026&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32655f6d-36a5-44f7-afd3-77c380665155\', \'multiverseId\': 99026}, \'multiverseid\': 99026}, {\'name\': \'流砂\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{T}, 流砂を生け贄に捧げる：飛行を持たない攻撃クリーチャー１体を対象とする。それはターン終了時まで-1/-2の修整を受ける。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99386&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b1b018e2-6aee-4151-a47c-a7b22f3ec2f2\', \'multiverseId\': 99386}, \'multiverseid\': 99386}, {\'name\': \'Areia Movediça\', \'text\': \'{T}: Adiciona {1} à sua reserva de mana.\\n{T}, Sacrifique Areia Movediça: A criatura alvo atacante sem a habilidade de voar recebe -1/-2 até o final do turno.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99746&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'20a97512-029e-4b3f-aef7-fa8afed418dc\', \'multiverseId\': 99746}, \'multiverseid\': 99746}, {\'name\': \'Зыбучие пески\', \'text\': \'{T}: Добавьте {1} в запас маны.\\n{T}, Принесите Зыбучие пески в жертву: целевое нападающее существо без способности полета получает -1/-2 до конца хода.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110017&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a619bcbf-273a-47e7-81cf-4ea67d71e11a\', \'multiverseId\': 110017}, \'multiverseid\': 110017}, {\'name\': \'流沙\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{T}，牺牲流沙：目标进行攻击，且不具飞行异能的生物得-1/-2直到回合结束。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97946&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7aa6568-01ab-4faf-b5c0-905c83d95599\', \'multiverseId\': 97946}, \'multiverseid\': 97946}]', '[{\'name\': \'Umkehrschaden\', \'text\': \'Wähle eine Schadensquelle. Wenn dir diese Quelle in diesem Zug das nächste Mal Schaden zufügt, verhindere diesen Schaden. Du erhältst ebensoviele Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Der Hass meines Gegner ist seine Schwäche. Der Zorn meines Gegners ist meine Stärke." —Remin, ehrwürdiger Mönch\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7bf8340a-e183-4aaf-8ea5-6daeae005811\', \'multiverseId\': 98679}, \'multiverseid\': 98679}, {\'name\': \'Inversión de daño\', \'text\': \'La próxima vez que una fuente de tu elección fuera a hacerte daño este turno, prevén ese daño. Gana esa cantidad de vida.\', \'type\': \'Instantáneo\', \'flavor\': \'"El odio de mi enemigo es su debilidad. El furor de mi enemigo es mi fuerza." —Remin, monje venerable\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100119&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a53a2c5d-9da0-4ff7-8410-47c147f303cd\', \'multiverseId\': 100119}, \'multiverseid\': 100119}, {\'name\': \'Inversion des dégâts\', \'text\': "La prochaine fois qu\'une source de votre choix devrait vous blesser ce tour-ci, prévenez ces blessures. Vous gagnez autant de points de vie.", \'type\': \'Éphémère\', \'flavor\': \'« La haine de mon ennemi est sa faiblesse. La rage de mon ennemi est ma force. » —Remin, moine vénérable\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98319&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f241b627-de61-4d51-94a7-1b74d62f3de3\', \'multiverseId\': 98319}, \'multiverseid\': 98319}, {\'name\': \'Inversione del Danno\', \'text\': \'La prossima volta che una fonte a tua scelta ti sta per infliggere danno in questo turno, previeni quel danno. Guadagni altrettanti punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"L\\\'odio del mio nemico è la sua debolezza. La rabbia del mio nemico è la mia forza." —Remin, monaco venerabile\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99039&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e2db49a8-c8b8-4adf-a6c2-457c171f751f\', \'multiverseId\': 99039}, \'multiverseid\': 99039}, {\'name\': \'ダメージ反転\', \'text\': \'このターン、次にあなたが選んだいずれかの発生源１つがあなたに与えるダメージをすべて軽減し、０にする。 あなたはその点数に等しい点数のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'敵の憎悪は敵の弱み。 敵の激怒は我が力。 ――神々しき老修道士、レミン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99399&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'703452cd-8948-4850-865b-ee5864f8db5d\', \'multiverseId\': 99399}, \'multiverseid\': 99399}, {\'name\': \'Reverter Dano\', \'text\': \'Na próxima vez que uma fonte à sua escolha fosse lhe causar dano neste turno, previna aquele dano. Você ganha uma quantidade de pontos de vida igual à quantidade de dano prevenida dessa maneira.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O ódio de meu inimigo é a sua fraqueza. A raiva de meu inimigo é minha força." — Remin, monge venerável\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99759&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'28eb1953-f02d-4e82-829d-b00423b8cd9c\', \'multiverseId\': 99759}, \'multiverseid\': 99759}, {\'name\': \'Обратные повреждения\', \'text\': \'В следующий раз, когда выбранный вами источник в этот ход будет наносить вам повреждения, предотвратите повреждения. Вы получаете столько пунктов жизни, сколько вам наносилось повреждений.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Ненависть моего врага его слабость. Злоба моего врага моя сила". — Ремин, почтенный монах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110030&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3fa57e0c-df4a-4364-8e6c-97b4c0fd2098\', \'multiverseId\': 110030}, \'multiverseid\': 110030}, {\'name\': \'逆转伤害\', \'text\': \'选择一个来源，于本回合中，防止该来源下一次将对你造成的伤害。 你获得等量的生命。\', \'type\': \'瞬间\', \'flavor\': \'「敌手的恨意将削弱其身。 敌手的愤怒将助我得胜。」 ～可敬的修行僧睿明\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97959&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eb289b51-fdc0-4938-ba11-4e5690ea63b9\', \'multiverseId\': 97959}, \'multiverseid\': 97959}]', '[{\'name\': \'Unheilige Stärke\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur erhält +2/+1.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Solche Macht lässt den Körper schwellen und die Seele schrumpfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98760&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b8d3e56c-852f-415b-8745-aba892aa631e\', \'multiverseId\': 98760}, \'multiverseid\': 98760}, {\'name\': \'Fuerza impía\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada obtiene +2/+1.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Tal poder expande el cuerpo y encoge el alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100200&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d32ecffd-1025-49a8-9e39-4e8171a127a2\', \'multiverseId\': 100200}, \'multiverseid\': 100200}, {\'name\': \'Force impie\', \'text\': \'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée gagne +2/+1.\', \'type\': \'Enchantement : aura\', \'flavor\': "« La Démesure est fille de l\'impiété. » —Eschyle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98400&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e16dc5a-4531-4c1b-878c-888165a9e5fa\', \'multiverseId\': 98400}, \'multiverseid\': 98400}, {\'name\': \'Forza Diabolica\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata prende +2/+1.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Questo potere alimenta il corpo e prosciuga l\'anima.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99120&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3e823614-5ea5-42cc-9741-eeef7fc1e691\', \'multiverseId\': 99120}, \'multiverseid\': 99120}, {\'name\': \'邪悪なる力\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは+2/+1の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'その力は、魂を縮めた分、肉体を強化する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99480&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d6895d2-9dd8-416f-a7af-8a87088bcee5\', \'multiverseId\': 99480}, \'multiverseid\': 99480}, {\'name\': \'Força Profana\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada recebe +2/+1.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Este poder faz crescer o corpo enquanto encolhe a alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99840&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66a23fc9-8831-431b-b9dc-ef53fdcdf343\', \'multiverseId\': 99840}, \'multiverseid\': 99840}, {\'name\': \'Нечистая сила\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает +2/+1.\', \'type\': \'Чары — Аура\', \'flavor\': \'Эта сила увеличивает тело, уменьшая душу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110111&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f1a3b26e-891c-4114-9cd1-8b33e25bfe99\', \'multiverseId\': 110111}, \'multiverseid\': 110111}, {\'name\': \'不洁之力\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物得+2/+1。\', \'type\': \'结界～灵气\', \'flavor\': \'此等力量强体而噬魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98040&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ffcf29da-ffd0-451d-b0a8-33e17a55789d\', \'multiverseId\': 98040}, \'multiverseid\': 98040}]', '[{\'name\': \'Unnachgiebiger Ansturm\', \'text\': \'Enttappe alle Kreaturen, die in diesem Zug angegriffen haben. Nach dieser Hauptphase gibt es eine zusätzliche Kampfphase, der eine zusätzliche Hauptphase folgt.\', \'type\': \'Hexerei\', \'flavor\': \'„Gnade? Gnade ist etwas für die Spielwiese, nicht für das Schlachtfeld."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98676&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'563449a8-7500-4865-89bf-b6c10655b330\', \'multiverseId\': 98676}, \'multiverseid\': 98676}, {\'name\': \'Asalto implacable\', \'text\': \'Endereza todas las criaturas que atacaron este turno. Después de esta fase principal, hay una fase de combate adicional seguida de una fase principal adicional.\', \'type\': \'Conjuro\', \'flavor\': \'"¿Piedad? La piedad es para el jardín de juegos, no para el campo de batalla."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100116&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acd85c3b-533d-476f-ab2a-ced8b8d7e3b4\', \'multiverseId\': 100116}, \'multiverseid\': 100116}, {\'name\': \'Assaut implacable\', \'text\': "Dégagez toutes les créatures qui ont attaqué ce tour-ci. Cette phase principale est suivie d\'une phase de combat supplémentaire, puis d\'une phase principale supplémentaire.", \'type\': \'Rituel\', \'flavor\': \'« Pitié ? On est sur un champ de bataille, pas dans une cour de récréation. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98316&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4cb64bdb-7278-4058-889c-4acec38bb460\', \'multiverseId\': 98316}, \'multiverseid\': 98316}, {\'name\': \'Assalto Implacabile\', \'text\': "STAPpa tutte le creature che hanno attaccato in questo turno. Dopo questa fase principale, c\'è una fase di combattimento aggiuntiva seguita da una fase principale aggiuntiva.", \'type\': \'Stregoneria\', \'flavor\': \'"Pietà? La pietà va bene nei campi da gioco, non nei campi di battaglia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99036&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa294279-21de-4999-a432-22f2561fa6da\', \'multiverseId\': 99036}, \'multiverseid\': 99036}, {\'name\': \'連続突撃\', \'text\': \'このターン攻撃に参加したすべてのクリーチャーをアンタップする。 このメイン・フェイズの後に、追加の戦闘フェイズとその後の追加のメイン・フェイズを加える。\', \'type\': \'ソーサリー\', \'flavor\': \'慈悲だと？ 慈悲ってのは遊び場での代物だ。戦場のものじゃない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99396&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a4af780-92c9-41ca-9d5e-6e19e46ec73a\', \'multiverseId\': 99396}, \'multiverseid\': 99396}, {\'name\': \'Assalto Implacável\', \'text\': \'Desvira todas as criaturas que atacaram neste turno. Após esta fase principal, há uma fase adicional de combate seguida por uma fase principal adicional.\', \'type\': \'Feitiço\', \'flavor\': \'"Piedade? Piedade é para o campo de recreio, não para o campo de batalha."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99756&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa5bd7e4-650e-4fc0-9aa3-19c6e579ad24\', \'multiverseId\': 99756}, \'multiverseid\': 99756}, {\'name\': \'Неутомимая атака\', \'text\': \'Разверните все существа, нападавшие в этот ход. За этой главной фазой последует дополнительная фаза боя, а затем еще одна главная фаза.\', \'type\': \'Волшебство\', \'flavor\': \'"Милосердие? Оставь милосердие для детской площадки, в бою оно никчему".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110027&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'410c4dff-5c90-45b3-bb9c-d74bc61e9f2d\', \'multiverseId\': 110027}, \'multiverseid\': 110027}, {\'name\': \'无情的突袭\', \'text\': \'重置所有于本回合中曾经攻击的生物。 在此行动阶段后，额外多出一个战斗阶段，以及接于其后之一个额外的行动阶段。\', \'type\': \'法术\', \'flavor\': \'「手下留情？ 运动场上才可能手下留情，战场上没这回事。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97956&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'42c9a1b7-aa32-4722-939b-07695a5af58e\', \'multiverseId\': 97956}, \'multiverseid\': 97956}]', "[{'name': 'Unterirdischer Fluss', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {B}. Der Unterirdische Fluss fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98758&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2bf3734c-f71b-4c8c-88fa-77d173f52e89', 'multiverseId': 98758}, 'multiverseid': 98758}, {'name': 'Río subterráneo', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {U} o {B} a tu reserva de maná. El Río subterráneo te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100198&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2a170359-ebdd-44e2-b44d-7bef108b8946', 'multiverseId': 100198}, 'multiverseid': 100198}, {'name': 'Rivière souterraine', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {U} ou {B} à votre réserve. La Rivière souterraine vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98398&type=card', 'language': 'French', 'identifiers': {'scryfallId': '76b0bf14-0221-4be5-84da-e5e422194eaa', 'multiverseId': 98398}, 'multiverseid': 98398}, {'name': 'Fiume Sotterraneo', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {U} o {B} alla tua riserva di mana. Il Fiume Sotterraneo ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99118&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'be80c8c4-f8e1-465f-8224-9d8a42e2ef24', 'multiverseId': 99118}, 'multiverseid': 99118}, {'name': '地底の大河', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{U}か{B}を加える。 地底の大河はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99478&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '402ca541-7fd2-42bd-ba3f-28296ab5de8c', 'multiverseId': 99478}, 'multiverseid': 99478}, {'name': 'Rio Subterrâneo', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {U} ou {B} à sua reserva de mana. Rio Subterrâneo causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99838&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1d7e4d85-0b08-48a0-8f91-63150087012e', 'multiverseId': 99838}, 'multiverseid': 99838}, {'name': 'Подземная река', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {U} или {B} в запас маны. Подземная река наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110109&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '14f98c4a-ffea-49ae-beac-cbed1ce1606b', 'multiverseId': 110109}, 'multiverseid': 110109}, {'name': '伏流', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{U}或{B}到你的法术力池中。 伏流对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98038&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a59758d3-96ce-49b3-a113-0ebf7ec542e6', 'multiverseId': 98038}, 'multiverseid': 98038}]", '[{\'name\': \'Unterweltstraum\', \'text\': \'Immer wenn ein Gegner eine Karte zieht, fügt der Unterweltstraum ihm 1 Schadenspunkt zu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Jeder Mensch wird im Reiche einen Engel haben, der mit ihm herrscht, und in der Unterwelt einen Dämon, der ihn straft." —Thomas von Aquin, Summa theologica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98759&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b63fcda6-dbdc-4cd1-bb73-7fcfacb6480e\', \'multiverseId\': 98759}, \'multiverseid\': 98759}, {\'name\': \'Sueños del infierno\', \'text\': \'Siempre que un oponente robe una carta, los Sueños del infierno le hacen 1 punto de daño.\', \'type\': \'Encantamiento\', \'flavor\': \'"En la somnolienta caverna oscura de la mente, los sueños hacen su nido con los fragmentos dejados por la caravana del día." —Rabindranath Tagore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100199&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13bdcad5-16f6-42a2-8daf-d2882ebd9a17\', \'multiverseId\': 100199}, \'multiverseid\': 100199}, {\'name\': \'Rêves du monde souterrain\', \'text\': "À chaque fois qu\'un adversaire pioche une carte, les Rêves du monde souterrain lui infligent 1 blessure.", \'type\': \'Enchantement\', \'flavor\': "« Dans la sombre caverne somnolente de l\'esprit, les rêves construisent leur nid des fragments oubliés par la caravane du jour. » —Rabindranath Tagore", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98399&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16905901-bf21-4287-a14a-deec0051db30\', \'multiverseId\': 98399}, \'multiverseid\': 98399}, {\'name\': \'Sogni del Mondo Sotterraneo\', \'text\': \'Ogniqualvolta un avversario pesca una carta, i Sogni del Mondo Sotterraneo gli infliggono 1 danno.\', \'type\': \'Incantesimo\', \'flavor\': \'"Nella sonnolenta caverna oscura della mente, i sogni fanno il nido con i frammenti scartati dalla carovana del giorno." —Rabindranath Tagore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99119&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2a5977fc-5f87-4761-be14-82a68f816168\', \'multiverseId\': 99119}, \'multiverseid\': 99119}, {\'name\': \'地獄界の夢\', \'text\': \'いずれかの対戦相手がカードを１枚引くたび、地獄界の夢はそのプレイヤーに１点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'眠気を誘うような思考の洞窟の暗い奥で、夢は日中の様々なものが落としていった欠片から巣をつくるのだ。 ――ラビンドラナート・タゴール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99479&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1dfc7738-9423-434e-ac95-184b10acf827\', \'multiverseId\': 99479}, \'multiverseid\': 99479}, {\'name\': \'Sonhos do Submundo\', \'text\': \'Toda vez que um oponente comprar um card, Sonhos do Submundo causa 1 ponto de dano a ele.\', \'type\': \'Encantamento\', \'flavor\': \'"Na entorpecida negra caverna da mente, os sonhos constróem seu ninho com fragmentos caídos da caravana do dia." — Rabindranath Tagore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99839&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07e0afa8-f8b4-4ca8-a468-7b2ee21d3d20\', \'multiverseId\': 99839}, \'multiverseid\': 99839}, {\'name\': \'Сны подземелья\', \'text\': \'Каждый раз, когда оппонент берет карту, Сны подземелья наносят ему 1 повреждение.\', \'type\': \'Чары\', \'flavor\': \'"В усыпляющей темноте разума сны вьют свои гнезда из того, что оставляет на своем пути караван дней". — Рабиндранат Тагор\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110110&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d9fa9b49-0730-4491-8f68-60503eabd8fd\', \'multiverseId\': 110110}, \'multiverseid\': 110110}, {\'name\': \'地底幻梦\', \'text\': \'每当对手抓一张牌时，地底幻梦对他造成1点伤害。\', \'type\': \'结界\', \'flavor\': \'「在昏眩的心灵暗窟里，梦以昼间商队散落的片段筑巢。」 ～拉宾德拉纳‧泰戈尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98039&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a5fb1150-2edc-48d8-9b80-a4b66bcf02f6\', \'multiverseId\': 98039}, \'multiverseid\': 98039}]', '[{\'name\': \'Urzas Bergwerk\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}. Falls du ein Urzas Kraftwerk und einen Urzas Turm kontrollierst, erhöhe deinen Manavorrat stattdessen um {2}.\', \'type\': \'Land — Urzas Bergwerk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98762&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6f3179a-6818-4ac6-8340-bb82c396e8d8\', \'multiverseId\': 98762}, \'multiverseid\': 98762}, {\'name\': \'Mina de Urza\', \'text\': \'{T}: Agrega {1} a tu reserva de maná. Si controlas una Central de energía de Urza y una Torre de Urza, en vez de eso, agrega {2} a tu reserva de maná.\', \'type\': \'Tierra — Mina de Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100202&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d3517b29-a8db-4641-8acd-fc7a89ee20cc\', \'multiverseId\': 100202}, \'multiverseid\': 100202}, {\'name\': "Mine d\'Urza", \'text\': "{T} : Ajoutez {1} à votre réserve. Si vous contrôlez une centrale énergétique d\'Urza et une tour d\'Urza, ajoutez {2} à votre réserve à la place.", \'type\': "Terrain : mine d\'Urza", \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98402&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40cc5792-f445-40c9-ae65-fd36de62a5fb\', \'multiverseId\': 98402}, \'multiverseid\': 98402}, {\'name\': \'Miniera di Urza\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana. Se controlli almeno una Centrale Energetica di Urza e una Torre di Urza, invece aggiungi {2} alla tua riserva di mana.\', \'type\': \'Terra — Miniera di Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99122&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'08d88767-aef6-4f65-af23-66e37f342502\', \'multiverseId\': 99122}, \'multiverseid\': 99122}, {\'name\': \'ウルザの鉱山\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。 あなたがウルザの・魔力炉とウルザの・塔をコントロールしている場合、代わりにあなたのマナ・プールに{2}を加える。\', \'type\': \'土地 — ウルザの・鉱山\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99482&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7cdc398c-d403-47ae-94b0-ddd69cc165cc\', \'multiverseId\': 99482}, \'multiverseid\': 99482}, {\'name\': \'Mina de Urza\', \'text\': \'{T}: Adiciona {1} à sua reserva de mana. Se você controlar uma Usina de Urza e uma Torre de Urza, em vez disso, adiciona {2} à sua reserva de mana.\', \'type\': \'Terreno — Mina de Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99842&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'14e8db3d-28ac-45b3-a0e0-59f11d2c1873\', \'multiverseId\': 99842}, \'multiverseid\': 99842}, {\'name\': \'Шахта Урзы\', \'text\': \'{T}: Добавьте {1} в запас маны. Если вы контролируете Электростанцию Урзы и Башню Урзы, вместо этого добавьте {2} в запас маны.\', \'type\': \'Земля — Шахта Урзы\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110113&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ff05a5b-22a5-4c70-a459-787fcce407c6\', \'multiverseId\': 110113}, \'multiverseid\': 110113}, {\'name\': \'克撒的矿脉\', \'text\': \'{T}：加{1}到你的法术力池中。 如果你操控克撒的动力炉和克撒的塔，则改为加{2}到你的法术力池中。\', \'type\': \'地～克撒的矿脉\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98042&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c0335dd-c449-46dd-839b-6dc49ec3f73c\', \'multiverseId\': 98042}, \'multiverseid\': 98042}]', '[{\'name\': \'Urzas Kraftwerk\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}. Falls du ein Urzas Bergwerk und einen Urzas Turm kontrollierst, erhöhe deinen Manavorrat stattdessen um {2}.\', \'type\': \'Land — Urzas Kraftwerk\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98763&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5826bf60-e00b-4163-a851-3e1dcf94c2db\', \'multiverseId\': 98763}, \'multiverseid\': 98763}, {\'name\': \'Central de energía de Urza\', \'text\': \'{T}: Agrega {1} a tu reserva de maná. Si controlas una Mina de Urza y una Torre de Urza, en vez de eso, agrega {2} a tu reserva de maná.\', \'type\': \'Tierra — Central de energía de Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100203&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b0db4dd2-65cc-4f2a-81b5-9653fb7d3c36\', \'multiverseId\': 100203}, \'multiverseid\': 100203}, {\'name\': "Centrale énergétique d\'Urza", \'text\': "{T} : Ajoutez {1} à votre réserve. Si vous contrôlez une mine d\'Urza et une tour d\'Urza, ajoutez {2} à votre réserve à la place.", \'type\': "Terrain : centrale énergétique d\'Urza", \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98403&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f9264f6-1bff-44d4-adc8-3202928b6f22\', \'multiverseId\': 98403}, \'multiverseid\': 98403}, {\'name\': \'Centrale Energetica di Urza\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana. Se controlli almeno una Miniera di Urza e una Torre di Urza, invece aggiungi {2} alla tua riserva di mana.\', \'type\': \'Terra — Centrale Energetica di Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99123&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6de969db-6644-4229-b876-c6dd69a898db\', \'multiverseId\': 99123}, \'multiverseid\': 99123}, {\'name\': \'ウルザの魔力炉\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。 あなたがウルザの・鉱山とウルザの・塔をコントロールしている場合、代わりにあなたのマナ・プールに{2}を加える。\', \'type\': \'土地 — ウルザの・魔力炉\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99483&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'132e3ee9-d0df-4df5-acf0-844ea53c22d3\', \'multiverseId\': 99483}, \'multiverseid\': 99483}, {\'name\': \'Usina de Urza\', \'text\': \'{T}: Adiciona {1} à sua reserva de mana. Se você controlar uma Mina de Urza e uma Torre de Urza, em vez disso, adiciona {2} à sua reserva de mana.\', \'type\': \'Terreno — Usina de Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99843&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57e3a9df-24c8-4df5-93a2-f3aa83893396\', \'multiverseId\': 99843}, \'multiverseid\': 99843}, {\'name\': \'Электростанция Урзы\', \'text\': \'{T}: Добавьте {1} в запас маны. Если вы контролируете Шахту Урзы и Башню Урзы, вместо этого добавьте {2} в запас маны.\', \'type\': \'Земля — Электростанция Урзы\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110114&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bbc281bd-2c11-4a71-a9af-d927dcfaf993\', \'multiverseId\': 110114}, \'multiverseid\': 110114}, {\'name\': \'克撒的动力炉\', \'text\': \'{T}：加{1}到你的法术力池中。 如果你操控克撒的矿脉和克撒的塔，则改为加{2}到你的法术力池中。\', \'type\': \'地～克撒的动力炉\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98043&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8bbcac80-0459-4cb4-81bd-bb85deaafe7e\', \'multiverseId\': 98043}, \'multiverseid\': 98043}]', '[{\'name\': \'Urzas Turm\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}. Falls du ein Urzas Bergwerk und ein Urzas Kraftwerk kontrollierst, erhöhe deinen Manavorrat stattdessen um {3}.\', \'type\': \'Land — Urzas Turm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98764&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2b6b4d1f-f71b-4aef-8b53-6cf795b5633d\', \'multiverseId\': 98764}, \'multiverseid\': 98764}, {\'name\': \'Torre de Urza\', \'text\': \'{T}: Agrega {1} a tu reserva de maná. Si controlas una Mina de Urza y una Central de energía de Urza, en vez de eso, agrega {3} a tu reserva de maná.\', \'type\': \'Tierra — Torre de Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100204&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fdc2686d-7328-4d1e-931f-ee6a724343d7\', \'multiverseId\': 100204}, \'multiverseid\': 100204}, {\'name\': "Tour d\'Urza", \'text\': "{T} : Ajoutez {1} à votre réserve. Si vous contrôlez une mine d\'Urza et une centrale énergétique d\'Urza, ajoutez {3} à votre réserve à la place.", \'type\': "Terrain : tour d\'Urza", \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98404&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'499f06c6-76bc-4fd1-a955-f53be0a24a29\', \'multiverseId\': 98404}, \'multiverseid\': 98404}, {\'name\': \'Torre di Urza\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana. Se controlli almeno una Miniera di Urza e una Centrale Energetica di Urza, invece aggiungi {3} alla tua riserva di mana.\', \'type\': \'Terra — Torre di Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99124&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'74b217c8-98b1-469b-89b2-ca34285c6c34\', \'multiverseId\': 99124}, \'multiverseid\': 99124}, {\'name\': \'ウルザの塔\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。 あなたがウルザの・鉱山とウルザの・魔力炉をコントロールしている場合、代わりにあなたのマナ・プールに{3}を加える。\', \'type\': \'土地 — ウルザの・塔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99484&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40f1e915-48c1-48a0-9714-315df4cd815a\', \'multiverseId\': 99484}, \'multiverseid\': 99484}, {\'name\': \'Torre de Urza\', \'text\': \'{T}: Adiciona {1} à sua reserva de mana. Se você controlar uma Mina de Urza e uma Usina de Urza, em vez disso, adiciona {3} à sua reserva de mana.\', \'type\': \'Terreno — Torre de Urza\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99edc7df-7585-4c67-8ed2-7a4b72a20e32\', \'multiverseId\': 99844}, \'multiverseid\': 99844}, {\'name\': \'Башня Урзы\', \'text\': \'{T}: Добавьте {1} в запас маны. Если вы контролируете Шахту Урзы и Электростанцию Урзы, вместо этого добавьте {3} в запас маны.\', \'type\': \'Земля — Башня Урзы\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110115&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce80ea05-c0bb-4331-80fa-c69b7bd85a8a\', \'multiverseId\': 110115}, \'multiverseid\': 110115}, {\'name\': \'克撒的塔\', \'text\': \'{T}：加{1}到你的法术力池中。 如果你操控克撒的矿脉和克撒的动力炉，则改为加{3}到你的法术力池中。\', \'type\': \'地～克撒的塔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98044&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e87c8ad-5423-4899-9a55-55862db31318\', \'multiverseId\': 98044}, \'multiverseid\': 98044}]', '[{\'name\': \'Utopia-Baum\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Kreatur — Pflanze\', \'flavor\': \'Die Früchte dieses sagenumworbenen Baumes schmecken immer nach deinem Lieblingsessen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98765&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e9e3c89e-4aee-47d1-b65f-7bbff6495af7\', \'multiverseId\': 98765}, \'multiverseid\': 98765}, {\'name\': \'Árbol de utopía\', \'text\': \'{T}: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Criatura — Planta\', \'flavor\': \'El fruto de este árbol mítico toma el sabor de la comida que más te guste.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100205&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ecfa905e-d15b-4acb-9b33-ff4e2beac4bf\', \'multiverseId\': 100205}, \'multiverseid\': 100205}, {\'name\': "Arbre de l\'Utopie", \'text\': \'{T} : Ajoutez un mana de la couleur de votre choix à votre réserve.\', \'type\': \'Créature : plante\', \'flavor\': \'Le fruit de cet arbre fabuleux a le goût de votre nourriture préférée.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98405&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2766c27e-755b-49fd-a701-62ef47fb3154\', \'multiverseId\': 98405}, \'multiverseid\': 98405}, {\'name\': "Albero dell\'Utopia", \'text\': \'{T}: Aggiungi un mana di un qualsiasi colore alla tua riserva.\', \'type\': \'Creatura — Pianta\', \'flavor\': \'Il frutto di questo mitico albero prende il sapore del tuo cibo preferito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99125&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87fb328c-7a34-45c8-995e-8644e269442a\', \'multiverseId\': 99125}, \'multiverseid\': 99125}, {\'name\': \'ユートピアの木\', \'text\': \'{T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。\', \'type\': \'クリーチャー — 植物\', \'flavor\': \'この伝説に名高い木の果物は、あなたが一番好きな食べ物の味になるんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99485&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d0dd04a-ef3f-4850-9b23-f283b0263d23\', \'multiverseId\': 99485}, \'multiverseid\': 99485}, {\'name\': \'Árvore da Utopia\', \'text\': \'{T}: Adiciona uma mana de qualquer cor à sua reserva de mana.\', \'type\': \'Criatura — Planta\', \'flavor\': \'O fruto desta árvore lendária tem o sabor da comida que você mais gosta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99845&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d10ea30e-7525-4515-9c8b-37cb7cec6b4e\', \'multiverseId\': 99845}, \'multiverseid\': 99845}, {\'name\': \'Утопическое дерево\', \'text\': \'{T}: Добавьте один пункт маны любого цвета в запас маны.\', \'type\': \'Существо — Растение\', \'flavor\': \'Плоды этого чудесного дерева по вкусу напоминают пищу, которую вы любите больше всего.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110116&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'788013b4-06b8-46a5-8ca0-4efeb0d4a678\', \'multiverseId\': 110116}, \'multiverseid\': 110116}, {\'name\': \'乌托树\', \'text\': \'{T}：加一点任意颜色的法术力到你的法术力池中。\', \'type\': \'生物～植物\', \'flavor\': \'这传说之树的果实，足以和任何美味相比拟。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98045&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df16138b-790e-4425-b054-713cb399e09c\', \'multiverseId\': 98045}, \'multiverseid\': 98045}]', '[{\'name\': \'Verborgenes Wissen\', \'text\': \'Zu Beginn des Ziehsegments eines Spielers zieht dieser Spieler zusätzlich eine Karte, falls das Verborgene Wissen nicht getappt ist.\', \'type\': \'Artefakt\', \'flavor\': \'Die Legende sagt, dass auch das Wissen derer verborgen ist, die vergeblich danach gesucht haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98577&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c9097fc-0fbb-408a-a812-a5f4588995b4\', \'multiverseId\': 98577}, \'multiverseid\': 98577}, {\'name\': \'Mina aullante\', \'text\': \'Al inicio del paso de robar de cada jugador, si la Mina aullante está enderezada, ese jugador roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Dice la leyenda que la mina aúlla las últimas palabras de aquéllos que murieron dentro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100017&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43e035b6-3c96-4dd3-9715-a8a82386df80\', \'multiverseId\': 100017}, \'multiverseid\': 100017}, {\'name\': \'Mine rugissante\', \'text\': "Au début de l\'étape de pioche de chaque joueur, si la Mine rugissante est dégagée, ce joueur pioche une carte.", \'type\': \'Artefact\', \'flavor\': \'La légende veut que la mine crie les derniers mots de ceux qui y sont morts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98217&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29da4b18-5914-46a2-a4c6-8d6ae4168a7b\', \'multiverseId\': 98217}, \'multiverseid\': 98217}, {\'name\': \'Miniera Ululante\', \'text\': "All\'inizio della propria acquisizione, se la Miniera Ululante è STAPpata, ciascun giocatore pesca una carta.", \'type\': \'Artefatto\', \'flavor\': \'La leggenda vuole che la miniera ululi le ultime parole di coloro che sono morti al suo interno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98937&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'331e3302-14c0-4ecd-909b-a0293eae9b75\', \'multiverseId\': 98937}, \'multiverseid\': 98937}, {\'name\': \'吠えたける鉱山\', \'text\': \'各プレイヤーのドロー・ステップの開始時に、吠えたける鉱山がアンタップ状態である場合、そのプレイヤーはカードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'伝説によれば、その鉱山は中で死んだ者たちの最後の言葉をわめくのだという。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99297&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1779ae9-efd0-4548-9b23-af287eb994dc\', \'multiverseId\': 99297}, \'multiverseid\': 99297}, {\'name\': \'Mina Uivadora\', \'text\': \'No início da etapa de compra de cada jogador, se Mina Uivadora estiver desvirada, aquele jogador compra um card.\', \'type\': \'Artefato\', \'flavor\': \'Diz a lenda que a mina uiva as últimas palavras daqueles que morreram lá dentro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99657&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b1743a6d-a1ac-4be0-b561-b8e1dcf226be\', \'multiverseId\': 99657}, \'multiverseid\': 99657}, {\'name\': \'Воющая шахта\', \'text\': \'В начале этапа взятия карт любого игрока, если Воющая шахта не повернута, этот игрок берет карту.\', \'type\': \'Артефакт\', \'flavor\': \'Легенда гласит, что вой этой пещеры это последние слова тех, кто погиб в ней.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109928&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'faf9b353-65fc-461b-84f5-e94baa4dfd45\', \'multiverseId\': 109928}, \'multiverseid\': 109928}, {\'name\': \'嚎叫的矿井\', \'text\': \'在每位牌手的抓牌步骤开始时，若嚎叫的矿井并未横置，则该牌手抓一张牌。\', \'type\': \'神器\', \'flavor\': \'传说中，那矿井会嘶吼着死在其中者的临终话语。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97857&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a039803c-a63d-4bde-91d1-8eb9bfbb4cf8\', \'multiverseId\': 97857}, \'multiverseid\': 97857}]', '[{\'name\': \'Verbrannte Steppe\', \'text\': \'Jeder Spieler opfert vier Länder. Verbrannte Steppe fügt jeder Kreatur 4 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'Feuer ist in der Nahrungskette immer ganz oben, und es hat gewaltigen Appetit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56b10eb4-f1f0-48f5-82e2-69b283fa4b06\', \'multiverseId\': 98782}, \'multiverseid\': 98782}, {\'name\': \'Incendio destructor\', \'text\': \'Cada jugador sacrifica cuatro tierras. El Incendio destructor hace 4 puntos de daño a cada criatura.\', \'type\': \'Conjuro\', \'flavor\': \'El fuego siempre está en la cima de la cadena alimenticia, y tiene un gran apetito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100222&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'952d842d-d260-42eb-a8ca-28dcb54ce5e1\', \'multiverseId\': 100222}, \'multiverseid\': 100222}, {\'name\': \'Feu dévastateur\', \'text\': \'Chaque joueur sacrifie quatre terrains. Le Feu dévastateur inflige 4 blessures à chaque créature.\', \'type\': \'Rituel\', \'flavor\': \'Le feu est toujours en haut de la chaîne alimentaire, et il a un gros appétit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98422&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94c3f52a-0d4e-4323-8993-2871a10b2f00\', \'multiverseId\': 98422}, \'multiverseid\': 98422}, {\'name\': \'Incendio Selvaggio\', \'text\': \'Ogni giocatore sacrifica quattro terre. Il Fuoco Selvaggio infligge 4 danni a ogni creatura.\', \'type\': \'Stregoneria\', \'flavor\': "Il fuoco è sempre all\'apice della catena alimentare e il suo appetito ègrande.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99142&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0f67806-a015-41b8-8e2b-f6f3ea0fc1d5\', \'multiverseId\': 99142}, \'multiverseid\': 99142}, {\'name\': \'燎原の火\', \'text\': \'各プレイヤーは土地を４つ生け贄に捧げる。 燎原の火は各クリーチャーにそれぞれ４点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'火は食物連鎖の頂点にいる。しかもその食欲はすごい。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99502&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'65ca3beb-8d6d-4d6d-b686-1047002699d8\', \'multiverseId\': 99502}, \'multiverseid\': 99502}, {\'name\': \'Fogo Grego\', \'text\': \'Cada jogador sacrifica quatro terrenos. Fogo Grego causa 4 pontos de dano a cada criatura.\', \'type\': \'Feitiço\', \'flavor\': \'O fogo está sempre no topo da cadeia alimentar e ele tem um apetite enorme.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'704395cc-5ab9-476e-a812-27a05339ba45\', \'multiverseId\': 99862}, \'multiverseid\': 99862}, {\'name\': \'Пожар\', \'text\': \'Каждый игрок приносит в жертву четыре земли. Пожар наносит 4 повреждения каждому существу.\', \'type\': \'Волшебство\', \'flavor\': \'Огонь всегда на верхушке пищевой цепи, и у него отличный аппетит.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110133&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc96a040-bb61-47b2-afff-8948a42faf4a\', \'multiverseId\': 110133}, \'multiverseid\': 110133}, {\'name\': \'野火\', \'text\': \'每位牌手牺牲四个地。 野火对每个生物各造成4点伤害。\', \'type\': \'法术\', \'flavor\': \'火焰永远在食物链的顶端，而且它的胃口很大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c16cc96-fe4d-4771-b96b-0fcd0d34a320\', \'multiverseId\': 98062}, \'multiverseid\': 98062}]', '[{\'name\': \'Verfolgung\', \'text\': \'Bestimme eine Farbe. Ein Spieler deiner Wahl zeigt die Karten auf seiner Hand offen vor und wirft alle Karten dieser Farbe ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Den einzigen Fehler, den man machen kann, wenn man verfolgt wird, ist sich fangen zu lassen." —Yotischer Flüchtling\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b672c106-7ab4-4c8c-bb09-2c0f9d83ccd6\', \'multiverseId\': 98651}, \'multiverseid\': 98651}, {\'name\': \'Perseguir\', \'text\': \'Elige un color. El jugador objetivo muestra su mano y descarta todas las cartas de ese color.\', \'type\': \'Conjuro\', \'flavor\': \'"De todas las tiranías sobre la raza humana, la peor es la que persigue a la mente." —John Dryden, "La cierva y la pantera"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100091&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'979af6f8-4f84-4260-90e3-3b87077d19f0\', \'multiverseId\': 100091}, \'multiverseid\': 100091}, {\'name\': \'Persécution\', \'text\': \'Choisissez une couleur. Le joueur ciblé révèle sa main et se défausse de toutes les cartes de la couleur choisie.\', \'type\': \'Rituel\', \'flavor\': "« Mais... mais je n\'ai rien fait » « Si, tu existes. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98291&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46a3b571-911c-4712-800e-84eb74d4f00d\', \'multiverseId\': 98291}, \'multiverseid\': 98291}, {\'name\': \'Perseguitare\', \'text\': \'Scegli un colore. Il giocatore bersaglio rivela la propria mano e scarta tutte le carte di quel colore.\', \'type\': \'Stregoneria\', \'flavor\': \'"Di tutte le tirannie del genere umano La peggiore è quella che molesta la mente." —John Dryden, "La Cerva e la Pantera"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99011&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2a02a76-f7e1-4f0a-ad22-b80c1fc9f38a\', \'multiverseId\': 99011}, \'multiverseid\': 99011}, {\'name\': \'迫害\', \'text\': \'色を１色選ぶ。 プレイヤー１人を対象とする。そのプレイヤーは自分の手札を公開し、選ばれた色のすべてのカードを捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'人なす暴虐その数莫大 中で悪しきが思想の迫害 ――ジョン・ドライデン 「雌鹿と豹」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99371&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da67e075-44a9-4d69-8713-67247713cdd4\', \'multiverseId\': 99371}, \'multiverseid\': 99371}, {\'name\': \'Perseguir\', \'text\': \'Escolha uma cor. O jogador alvo revela sua própria mão e descarta todos os cards daquela cor.\', \'type\': \'Feitiço\', \'flavor\': \'"De todas a tiranias que o homem é capaz A pior é aquela que da mente vai atrás." — John Dryden, "A Corça e a Pantera"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99731&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7b7caca8-ac3d-4c69-9979-23f6b81f7e40\', \'multiverseId\': 99731}, \'multiverseid\': 99731}, {\'name\': \'Преследование\', \'text\': \'Выберите цвет. Целевой игрок открывает руку и сбрасывает все карты этого цвета.\', \'type\': \'Волшебство\', \'flavor\': \'"Из всех тиранов, правящих людьми, Страшнее тот, что властвует умами". — Джон Драйден, "Лань и пантера"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110002&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'be1d58f8-32c1-4c0c-b605-5672e1128f14\', \'multiverseId\': 110002}, \'multiverseid\': 110002}, {\'name\': \'迫害\', \'text\': \'选择一种颜色。 目标牌手展示其手牌，并从中弃掉所有该颜色的牌。\', \'type\': \'法术\', \'flavor\': \'「人类暴行极致 莫如迫害心智。」 ～约翰‧德来登， 「牝鹿与豹」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97931&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b157fb3-a6bb-4ee9-8180-913706d51747\', \'multiverseId\': 97931}, \'multiverseid\': 97931}]', "[{'name': 'Verseuchte Verbindung', 'text': 'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nImmer wenn die verzauberte Kreatur angreift oder blockt, verliert ihr Beherrscher 3 Lebenspunkte.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98485&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e955123f-5a99-4d7d-bc1e-f447516cca4e', 'multiverseId': 98485}, 'multiverseid': 98485}, {'name': 'Vínculo contaminado', 'text': 'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nSiempre que la criatura encantada ataque o bloquee, su controlador pierde 3 vidas.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99925&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '56f4a0cc-d83b-4e31-a610-f9216c1f33ef', 'multiverseId': 99925}, 'multiverseid': 99925}, {'name': 'Lien contaminé', 'text': 'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nÀ chaque fois que la créature enchantée attaque ou bloque, son contrôleur perd 3 points de vie.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98125&type=card', 'language': 'French', 'identifiers': {'scryfallId': '82198edc-e729-4451-9cd2-30a75c96a1dc', 'multiverseId': 98125}, 'multiverseid': 98125}, {'name': 'Legame Contaminato', 'text': 'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nOgniqualvolta la creatura incantata attacca o blocca, il suo controllore perde 3 punti vita.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98845&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '40cacd2f-5288-4ad7-bcd9-2ef6183330ed', 'multiverseId': 98845}, 'multiverseid': 98845}, {'name': '汚染された結合', 'text': 'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーが攻撃やブロックに参加するたび、それのコントローラーは３点のライフを失う。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99205&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '84ec1f2e-3ada-4847-9a9a-74df6e2751cf', 'multiverseId': 99205}, 'multiverseid': 99205}, {'name': 'Elo Contaminado', 'text': 'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nToda vez que a criatura encantada atacar ou bloquear, o seu controlador perde 3 pontos de vida.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99565&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6aa531fb-b6e2-4d2f-a900-0b70edb75b96', 'multiverseId': 99565}, 'multiverseid': 99565}, {'name': 'Зараженные оковы', 'text': 'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nКаждый раз, когда зачарованное существо нападает или блокирует, контролирующий его игрок теряет 3 пункта жизни.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109836&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '936cc091-d1d1-47d4-be01-94ce1029d2b9', 'multiverseId': 109836}, 'multiverseid': 109836}, {'name': '污化羁绊', 'text': '生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n每当受此结界的生物进行攻击或阻挡时，此生物的操控者失去3点生命。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97765&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b7b3df31-aab0-41f1-97cf-781a9b571527', 'multiverseId': 97765}, 'multiverseid': 97765}]", "[{'name': 'Verteidigungsraster', 'text': 'Während des Zuges jedes Spielers kosten die Zaubersprüche anderer Spieler beim Ausspielen je {3} mehr.', 'type': 'Artefakt', 'flavor': 'Franz ließ sich nur ungern beim Zaubern stören ...', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98499&type=card', 'language': 'German', 'identifiers': {'scryfallId': '34732281-3cda-49f9-8ad3-2c86049e9203', 'multiverseId': 98499}, 'multiverseid': 98499}, {'name': 'Rejilla de defensa', 'text': 'Durante el turno de cada jugador, a cada uno de los demás jugadores le cuesta {3} más jugar sus hechizos.', 'type': 'Artefacto', 'flavor': 'Ilumina el cielo, atrayéndo a los enemigos sólo para repelerlos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99939&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '93203a73-c0fa-410f-919b-09b5014f70b8', 'multiverseId': 99939}, 'multiverseid': 99939}, {'name': 'Grille de défense', 'text': 'Pendant le tour de chaque joueur, les sorts de chacun des autres joueurs coûtent {3} de plus à jouer.', 'type': 'Artefact', 'flavor': 'Elle éclaire le ciel, attirant les ennemis pour ensuite les repousser.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98139&type=card', 'language': 'French', 'identifiers': {'scryfallId': '24311261-1309-4170-8ed7-edbdc0a7e473', 'multiverseId': 98139}, 'multiverseid': 98139}, {'name': 'Griglia di Difesa', 'text': 'Durante il turno di ciascun giocatore, le magie di ogni altro giocatore costano {3} in più per essere giocate.', 'type': 'Artefatto', 'flavor': 'Illumina il cielo, attirando i nemici solo per poi scacciarli.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98859&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '356fccd3-bf09-4f80-88e2-4b7cbcfa03bc', 'multiverseId': 98859}, 'multiverseid': 98859}, {'name': '防御の光網', 'text': '各プレイヤーのターンの間、他のプレイヤーがプレイする呪文は、それをプレイするためのコストが{3}多くなる。', 'type': 'アーティファクト', 'flavor': 'それは空を照らし、追い払うだけのために敵を引き付ける。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99219&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5b62003a-ae44-44e2-8f58-a0fefede88f2', 'multiverseId': 99219}, 'multiverseid': 99219}, {'name': 'Perímetro Defensivo', 'text': 'Durante o turno de cada jogador, as mágicas de cada um dos outros jogadores custam {3} a mais para serem jogadas.', 'type': 'Artefato', 'flavor': 'Ele ilumina o céu, chamando os inimigos apenas para poder repeli-los.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99579&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd3705714-6de6-4445-9d74-b0d60c76c739', 'multiverseId': 99579}, 'multiverseid': 99579}, {'name': 'Оборонительное сооружение', 'text': 'Во время хода любого из игроков каждое заклинание его оппонента стоит на {3} дороже.', 'type': 'Артефакт', 'flavor': 'Она освещает небо, маня врага, и отражает его натиск.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109850&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e1416bcc-76ff-4531-bd71-27349e159554', 'multiverseId': 109850}, 'multiverseid': 109850}, {'name': '阻御网', 'text': '于每位牌手的回合中，其它牌手使用的咒语费用增加{3}来使用。', 'type': '神器', 'flavor': '网的光芒照亮天际，将所吸引来的敌人一一逐退。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97779&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bbfa950b-a57a-48f8-9703-f11eeae86109', 'multiverseId': 97779}, 'multiverseid': 97779}]", '[{\'name\': \'Verwalter der Hölle\', \'text\': \'{T}, opfere eine Kreatur: Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück. Spiele diese Fähigkeit nur während deines Versorgungssegments.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98568&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56d1915e-77a1-418e-8fcb-39456f41dcf1\', \'multiverseId\': 98568}, \'multiverseid\': 98568}, {\'name\': \'Vigilante del Averno\', \'text\': \'{T}, sacrificar una criatura: Regresa la carta de criatura objetivo de tu cementerio al juego. Juega esta habilidad sólo durante tu mantenimiento.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100008&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'12e424a9-41e5-468e-95a5-60d7bd77e525\', \'multiverseId\': 100008}, \'multiverseid\': 100008}, {\'name\': "Concierge de l\'enfer", \'text\': "{T}, sacrifiez une créature : Renvoyez en jeu la carte de créature ciblée depuis votre cimetière. Ne jouez cette capacité que pendant votre étape d\'entretien.", \'type\': \'Créature : horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98208&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d503d32-024a-470f-a7bd-3900d9aa09b5\', \'multiverseId\': 98208}, \'multiverseid\': 98208}, {\'name\': "Traghettatore d\'Anime", \'text\': \'{T}, Sacrifica una creatura: Rimetti in gioco una carta creatura bersaglio dal tuo cimitero. Gioca questa abilità solo durante il tuo mantenimento.\', \'type\': \'Creatura — Orrore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98928&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d438dcd-3f9f-4724-8e32-c9d1099d5ce8\', \'multiverseId\': 98928}, \'multiverseid\': 98928}, {\'name\': \'地獄の番人\', \'text\': \'{T}, クリーチャーを１体生け贄に捧げる：あなたの墓地にあるクリーチャー・カード１枚を対象とし、それを場に戻す。 この能力は、あなたのアップキープにのみプレイできる。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99288&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79f3fb46-30be-4401-92b3-9f3238bb8167\', \'multiverseId\': 99288}, \'multiverseid\': 99288}, {\'name\': \'Vigia do Inferno\', \'text\': \'{T}, Sacrifique uma criatura: Devolve para o jogo o card alvo de criatura de seu cemitério. Use esta habilidade somente durante sua manutenção.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99648&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'739845a0-dcd0-4cf1-b9bf-9945931a835c\', \'multiverseId\': 99648}, \'multiverseid\': 99648}, {\'name\': \'Смотритель ада\', \'text\': \'{T}, принесите в жертву существо: верните целевое существо с кладбища в игру. Вы можете разыграть эту способность только во время своего этапа поддержки.\', \'type\': \'Существо — Ужас\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109919&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6fcd69a7-a55e-4261-979c-f8dd7ef5217f\', \'multiverseId\': 109919}, \'multiverseid\': 109919}, {\'name\': \'地狱总管\', \'text\': \'{T}，牺牲一个生物：将目标生物牌从你的坟墓场移回场上。 你只可以于你的维持中使用此异能。\', \'type\': \'生物～惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97848&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4c4898c9-12f7-44a3-bca3-82ff1f9541b6\', \'multiverseId\': 97848}, \'multiverseid\': 97848}]', '[{\'name\': \'Viashino-Sandläufer\', \'text\': \'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen.)\\nBringe am Ende des Zuges den Viashino-Sandläufer auf die Hand seines Besitzers zurück. (Bringe ihn nur zurück, falls er im Spiel ist.)\', \'type\': \'Kreatur — Viashino-Krieger\', \'flavor\': \'„Manche glauben, die Sandläufer existieren nur in der Einbildung. Diejenigen mit Narben wissen es besser." —Zhalfirinischer Wüstenführer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98771&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1fb093b8-da4b-471f-997a-be849aa3179c\', \'multiverseId\': 98771}, \'multiverseid\': 98771}, {\'name\': \'Cazador de la arena viashino\', \'text\': \'Prisa. (Esta criatura puede atacar el turno en que entre bajo tu control.)\\nAl final del turno, regresa el Cazador de la arena viashino a la mano de su propietario. (Regrésalo sólo si está en juego.)\', \'type\': \'Criatura — Guerrero viashino\', \'flavor\': \'"Algunos creen que los cazadores de la arena son ilusiones; los que tienen cicatrices saben que no lo son". —Guía zhalfirin del desierto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100211&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'535884ca-5afb-4262-bc0b-b97c24af4ea9\', \'multiverseId\': 100211}, \'multiverseid\': 100211}, {\'name\': \'Pisteur des sables viashino\', \'text\': "Célérité (Cette créature peut attaquer dès le tour où elle arrive sous votre contrôle.)\\nÀ la fin du tour, renvoyez le Pisteur des sables viashino dans la main de son propriétaire. (Renvoyez-le seulement s\'il est en jeu.)", \'type\': \'Créature : viashino et guerrier\', \'flavor\': "« Certains pensent que les pisteurs des sables sont des mirages ; ceux qui en portent les cicatrices savent qu\'il n\'en est rien. » —Guide du désert zhalfirín", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98411&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8cfbe379-5a86-4cef-ad56-e2575871b110\', \'multiverseId\': 98411}, \'multiverseid\': 98411}, {\'name\': \'Cacciatore delle Sabbie Viashino\', \'text\': \'Rapidità (Questa creatura può attaccare nel turno in cui entra sotto il tuo controllo.)\\nAlla fine del turno, il proprietario riprende in mano il Cacciatore delle Sabbie Viashino. (Soltanto se è in gioco.)\', \'type\': \'Creatura — Guerriero Viashino\', \'flavor\': \'"Alcuni credono che i cacciatori delle sabbie siano illusioni; quelli che portano cicatrici sanno che non è così." —Guida al deserto di Zhalfir\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99131&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e577f5c-fa8d-4c4e-a1df-7a9285104576\', \'multiverseId\': 99131}, \'multiverseid\': 99131}, {\'name\': \'ヴィーアシーノの砂漠の狩人\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になったターンに攻撃に参加してもよい。）\\nターン終了時に、ヴィーアシーノの砂漠の狩人をオーナーの手札に戻す。 （場にある場合にのみ戻す。）\', \'type\': \'クリーチャー — ヴィーアシーノ・戦士\', \'flavor\': \'なかには、砂漠の狩人など幻にすぎないと信じる者もいる。だが、傷持つ者はそれほど愚かではない。 ――ザルファーの砂漠の旅の案内\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99491&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3288fde4-0715-410d-98a0-c9dc1487423b\', \'multiverseId\': 99491}, \'multiverseid\': 99491}, {\'name\': \'Caçador das Areias Viashino\', \'text\': \'Ímpeto (Esta criatura pode atacar no turno em que entra em jogo sob seu controle.)\\nNo final do turno, devolva Caçador das Areias Viashino para a mão de seu dono. (Devolva-o apenas se ele estiver em jogo.)\', \'type\': \'Criatura — Guerreiro Viashino\', \'flavor\': \'"Alguns acham que os caçadores das areias não passam de ilusões. Mas os que têm as cicatrizes sabem da verdade." — Zhalfirin Guia do Deserto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99851&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4e266f81-4e29-462a-b462-6412b95fdb4c\', \'multiverseId\': 99851}, \'multiverseid\': 99851}, {\'name\': \'Песчаный странник Виашино\', \'text\': \'Ускорение (Это существо может нападать во время того хода, когда оно попало под ваш контроль).\\nВ конце хода верните Песчаного странника Виашино в руку владельца. (Только если он в игре).\', \'type\': \'Существо — Виашино Воин\', \'flavor\': \'"Некоторые думают, что песчаные странники это иллюзия. Те, на чьем теле остались шрамы, знают наверняка, что это не так". — Цалфирийский путеводитель по пустыне\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110122&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4905e5c2-a2d3-4bc4-a1bb-3c932915ce89\', \'multiverseId\': 110122}, \'multiverseid\': 110122}, {\'name\': \'凡尔西诺沙潜者\', \'text\': \'敏捷（你操控此生物的该回合中，它便可以攻击）\\n在回合结束时，将凡尔西诺沙潜者移回其拥有者手上。 （若它在场上，才将其移回手上）\', \'type\': \'生物～凡尔西诺／战士\', \'flavor\': \'「有些人认为沙潜者只是些幻影；但带着伤疤的人要更了解实情。」 ～赛费林沙漠导览\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98051&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3f6762fc-e440-45d1-8e49-d8b6161e7f0a\', \'multiverseId\': 98051}, \'multiverseid\': 98051}]', '[{\'name\': \'Viridischer Schamane\', \'text\': \'Wenn der Viridische Schamane ins Spiel kommt, zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Die Schamanen symbolisieren die natürliche Welt und leben als Feinde der Kräfte, die die Welt bedrohen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98772&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f9fe8dd5-5f36-447b-b524-f6de4b6b996b\', \'multiverseId\': 98772}, \'multiverseid\': 98772}, {\'name\': \'Chamán viridiana\', \'text\': \'Cuando la Chamán viridiana entre en juego destruye el artefacto objetivo.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Ella se alza como un símbolo viviente del mundo natural y como un enemigo de las fuerzas que lo amenazan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100212&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf7f6fd1-e295-4bd1-ad43-2b05f561783a\', \'multiverseId\': 100212}, \'multiverseid\': 100212}, {\'name\': \'Shamane viridiane\', \'text\': "Quand la Shamane viridiane arrive en jeu, détruisez l\'artefact ciblé.", \'type\': \'Créature : elfe et shamane\', \'flavor\': "Elle est le symbole vivant du monde de la nature et l\'ennemie des forces qui la menacent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'402639f5-2d9e-4697-9cff-13ba543610dc\', \'multiverseId\': 98412}, \'multiverseid\': 98412}, {\'name\': \'Sciamana Viridiana\', \'text\': \'Quando la Sciamana Viridiana entra in gioco, distruggi un artefatto bersaglio.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'È il simbolo vivente del mondo naturale e il nemico delle forze che lo minacciano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99132&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'21c59f89-69bc-4e1d-bce2-5f30221fe20b\', \'multiverseId\': 99132}, \'multiverseid\': 99132}, {\'name\': \'ヴィリジアンのシャーマン\', \'text\': \'ヴィリジアンのシャーマンが場に出たとき、アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'彼女の姿は、自然の世界の生ける象徴であり、それを脅かす物に対しては敵と映る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99492&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad2c25cd-28b1-4dd6-8fbf-066b15df2b33\', \'multiverseId\': 99492}, \'multiverseid\': 99492}, {\'name\': \'Xamã Viridiana\', \'text\': \'Quando Xamã Viridiana entra em jogo, destrói o artefato alvo.\', \'type\': \'Criatura — Xamã Elfo\', \'flavor\': \'Ela é um símbolo vivo do mundo natural e uma inimiga para as forças que a ameaçam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99852&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6b4f347c-738d-44bd-9747-c0ea14d2682f\', \'multiverseId\': 99852}, \'multiverseid\': 99852}, {\'name\': \'Виридийский шаман\', \'text\': \'Когда Виридийский шаман вступает в игру, уничтожьте целевой артефакт.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Он стоит, как живой символ мира природы и враг всех сил, угрожающих ему.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110123&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d4d43887-3bd6-45bd-972f-5029a2555409\', \'multiverseId\': 110123}, \'multiverseid\': 110123}, {\'name\': \'暗碧族祭师\', \'text\': \'当暗碧族祭师进场时，消灭目标神器。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'对自然世界而言，她是个鲜活象征；对自然之敌而言，她是位难缠对手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98052&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49094dff-ec95-48d5-894a-ff988902389e\', \'multiverseId\': 98052}, \'multiverseid\': 98052}]', "[{'name': 'Vulkanhammer', 'text': 'Der Vulkanhammer fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Feuer formt sich in der Hitze der Esse.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98774&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fadf62eb-1240-4ab5-b5b1-90f96d7472e4', 'multiverseId': 98774}, 'multiverseid': 98774}, {'name': 'Martillo volcánico', 'text': 'El Martillo volcánico hace 3 puntos de daño a la criatura o jugador objetivo.', 'type': 'Conjuro', 'flavor': 'El fuego encuentra su forma en el calor de la forja.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100214&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c3f2a6e5-cf62-4dff-996e-6795ec1f0a7e', 'multiverseId': 100214}, 'multiverseid': 100214}, {'name': 'Marteau volcanique', 'text': 'Le Marteau volcanique inflige 3 blessures à une cible, créature ou joueur.', 'type': 'Rituel', 'flavor': 'Le feu prend forme au fond de la forge.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98414&type=card', 'language': 'French', 'identifiers': {'scryfallId': '48e93ee0-89d9-4a1d-8f99-b10a64aca4c5', 'multiverseId': 98414}, 'multiverseid': 98414}, {'name': 'Martello Vulcanico', 'text': 'Il Martello Vulcanico infligge 3 danni a una creatura o a un giocatore bersaglio.', 'type': 'Stregoneria', 'flavor': 'Il fuoco trova la propria forma nel calore della forgia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99134&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ab7df919-eb85-4bed-ab8c-ff54d81fb142', 'multiverseId': 99134}, 'multiverseid': 99134}, {'name': '火山の鎚', 'text': 'クリーチャー１体かプレイヤー１人を対象とする。火山の鎚はそれに３点のダメージを与える。', 'type': 'ソーサリー', 'flavor': '火は、炉の中でこそ真の形を見せる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99494&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8143f1cf-7b95-49e6-a976-acba8e7fb627', 'multiverseId': 99494}, 'multiverseid': 99494}, {'name': 'Martelo Vulcânico', 'text': 'Martelo Vulcânico causa 3 pontos de dano à criatura ou ao jogador alvo.', 'type': 'Feitiço', 'flavor': 'O fogo encontra sua forma no calor da forja.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99854&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2532c9cf-ef56-458a-a267-c90161fc91da', 'multiverseId': 99854}, 'multiverseid': 99854}, {'name': 'Вулканический молот', 'text': 'Вулканический молот наносит 3 повреждения целевому существу или игроку.', 'type': 'Волшебство', 'flavor': 'В жаркой кузнице огонь обретает форму.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110125&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fdbf2acd-aabe-4ada-8887-6711e643c96b', 'multiverseId': 110125}, 'multiverseid': 110125}, {'name': '火山锤', 'text': '火山锤对目标生物或牌手造成3点伤害。', 'type': '法术', 'flavor': '火焰在炎热的锻冶炉中找到自己的形式。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98054&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7a882fa7-d3d8-4035-9921-1f56ca27b5fb', 'multiverseId': 98054}, 'multiverseid': 98054}]", '[{\'name\': \'Vulshok-Morgenstern\', \'text\': \'Die ausgerüstete Kreatur erhält +2/+2.\\nAusrüsten {2} ({2}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98775&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1880b7da-4028-4da3-a52e-b167836649c0\', \'multiverseId\': 98775}, \'multiverseid\': 98775}, {\'name\': \'Mangual vúlshok\', \'text\': \'La criatura equipada obtiene +2/+2.\\nEquipar {2} ({2}: Anexa este equipo a la criatura objetivo que controles. Juega la habilidad de equipar como un conjuro).\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100215&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97ce772a-b24a-4b86-be4d-d59ce45367c4\', \'multiverseId\': 100215}, \'multiverseid\': 100215}, {\'name\': \'Morgenstern vulshok\', \'text\': "La créature équipée gagne +2/+2.\\nÉquipement {2} ({2} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez jouer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53acca75-e66f-40a3-9450-85bbbcbab415\', \'multiverseId\': 98415}, \'multiverseid\': 98415}, {\'name\': \'Mazzafrusto Vulshok\', \'text\': \'La creatura equipaggiata prende +2/+2.\\nEquipaggiare {2} ({2}: Assegnalo a una creatura bersaglio che controlli. Equipaggialo solo come una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99135&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9206a866-c8b6-4abe-b55e-ef6beba3caa6\', \'multiverseId\': 99135}, \'multiverseid\': 99135}, {\'name\': \'ヴァルショクの鉄球\', \'text\': \'装備しているクリーチャーは+2/+2の修整を受ける。\\n装備 {2} ({2}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。 装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99495&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0300698c-6834-448c-8cc3-35405b36e0d0\', \'multiverseId\': 99495}, \'multiverseid\': 99495}, {\'name\': \'Maça-estrela dos Vulshoques\', \'text\': \'A criatura equipada recebe +2/+2.\\nEquipar {2} ({2}: Anexe à criatura alvo que você controla. Equipe somente quando puder jogar um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99855&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5f570017-3243-4e78-ab2c-748ecfc0b258\', \'multiverseId\': 99855}, \'multiverseid\': 99855}, {\'name\': \'Палица Вулшока\', \'text\': \'Существо со снаряжением получает +2/+2.\\nСнарядить {2} ({2}: прикрепите к целевому существу, которое вы контролируете. Только как волшебство).\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110126&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0550d4af-7919-4f61-a32d-246d8e50eef1\', \'multiverseId\': 110126}, \'multiverseid\': 110126}, {\'name\': \'瓦许克晨星锤\', \'text\': \'佩带此武具的生物得+2/+2。\\n佩带{2}（{2}：装备在目标由你操控的生物上； 佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98055&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'150cb477-8cd2-4cca-b15b-c713c4b6f137\', \'multiverseId\': 98055}, \'multiverseid\': 98055}]', '[{\'name\': \'Waffenrock\', \'text\': \'Jede Kreatur erhält +1/+1 für jede andere Kreatur im Spiel, mit der sie einen Kreaturentyp teilt. (Sind zum Beispiel ein „Goblin, Krieger" sowie ein „Goblin, Späher" und ein „Zombie, Goblin" im Spiel, erhalten alle +2/+2.)\', \'type\': \'Artefakt\', \'flavor\': \'„Links, zwo, vier, fumpf, Serra hat ein Loch im Strumpf."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e020c850-fe64-4ce8-abd9-cb898ac7147c\', \'multiverseId\': 98481}, \'multiverseid\': 98481}, {\'name\': \'Escudo de armas\', \'text\': \'Cada criatura obtiene +1/+1 por cada otra criatura que haya en juego que comparta un tipo de criatura con ella. (Por ejemplo, si hay un Guerrero trasgo, un Explorador trasgo y un Trasgo zombie en juego, cada uno obtiene +2/+2.)\', \'type\': \'Artefacto\', \'flavor\': \'"Uno, dos, tres, cuatro, sólo sé contar hasta cuatro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99921&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f77a4f3-21a0-46b9-b584-887a6832a63e\', \'multiverseId\': 99921}, \'multiverseid\': 99921}, {\'name\': \'Blason\', \'text\': \'Chaque créature gagne +1/+1 pour chaque autre créature en jeu qui partage un type de créature avec elle. (Par exemple, si un gobelin et guerrier, un gobelin et éclaireur et un zombie et gobelin sont en jeu, chacun gagne +2/+2.)\', \'type\': \'Artefact\', \'flavor\': "« Un, deux, quatre, neuf, Pour c\'qui est d\'compter, je suis un chef. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98121&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'016737e1-bc8f-4482-9f9a-a8a601e5a408\', \'multiverseId\': 98121}, \'multiverseid\': 98121}, {\'name\': \'Stemma Araldico\', \'text\': \'Ciascuna creatura prende +1/+1 per ogni altra creatura in gioco che ha almeno un tipo di creatura in comune con essa. (Per esempio, se ci sono in gioco un Guerriero Goblin, un Esploratore Goblin e un Goblin Zombie, ciascuno di essi prende +2/+2.)\', \'type\': \'Artefatto\', \'flavor\': \'"Un, due, tre, dopo più non so che c\\\'è."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98841&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b10ae933-c985-4306-af61-4c524de059ba\', \'multiverseId\': 98841}, \'multiverseid\': 98841}, {\'name\': \'旗印\', \'text\': \'各クリーチャーは、場に出ているそれと共通のクリーチャー・タイプを持つ他のクリーチャー１体につき+1/+1の修整を受ける。 （例えば、ゴブリン・戦士とゴブリン・スカウトとゾンビ・ゴブリンが各１体ずつ場にいる場合、それぞれは+2/+2の修整を受ける。）\', \'type\': \'アーティファクト\', \'flavor\': \'おいっち、にぃ、さん、しぃ、おあとは、しらんしぃ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99201&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9bab07e1-836f-4e9e-8d73-f3d1de2eeaa0\', \'multiverseId\': 99201}, \'multiverseid\': 99201}, {\'name\': \'Escudo de Armas\', \'text\': \'Cada criatura recebe +1/+1 para cada uma das outras criaturas em jogo que compartilhar um tipo de criatura com ela. (Por exemplo, se um Guerreiro Goblin, um Batedor Goblin e um Goblin Zumbi estão em jogo, cada um recebe +2/+2.)\', \'type\': \'Artefato\', \'flavor\': \'"Um, dois, três, quatro, não sei mais contar . . . que chato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99561&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'509fd2da-446c-43b5-81a5-28456a3e35f5\', \'multiverseId\': 99561}, \'multiverseid\': 99561}, {\'name\': \'Гербовый щит\', \'text\': \'Каждое существо получает +1/+1 за каждое существо такого же типа, находящееся в игре. (Например, если в игре Гоблин Воин, Гоблин Разведчик и Зомби Гоблин, каждый из них получает +2/+2).\', \'type\': \'Артефакт\', \'flavor\': \'"Раз, два, три, четыре, пять. До пяти могу считать".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109832&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb53c818-c85d-48cf-94c2-2212b673b567\', \'multiverseId\': 109832}, \'multiverseid\': 109832}, {\'name\': \'武装外衣\', \'text\': \'我们不会往下数。」 对每个生物而言，场上每有一个具共通之生物类别的其它生物，它便得+1/+1。（例如，若有三个精灵在场上，则它们各得+2/+2）\', \'type\': \'神器\', \'flavor\': \'「哈，二，三，四，\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97761&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7edd03e3-429a-45eb-bf49-e823b7654562\', \'multiverseId\': 97761}, \'multiverseid\': 97761}]', '[{\'name\': \'Wagemutiger Lehrling\', \'text\': \'{T}, opfere den Wagemutigen Lehrling: Neutralisiere einen Zauberspruch deiner Wahl.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Jeder große Zauberer schart ein paar entbehrliche Lehrlinge um sich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98495&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'12d44f71-7f67-4875-9051-700f6634b7c3\', \'multiverseId\': 98495}, \'multiverseid\': 98495}, {\'name\': \'Aprendiz temerario\', \'text\': \'{T}, sacrificar el Aprendiz temerario: Contrarresta el hechizo objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Frente a cada gran hechicero hay un aprendiz condenado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99935&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1585dd17-17b9-4939-b086-52370333cf6d\', \'multiverseId\': 99935}, \'multiverseid\': 99935}, {\'name\': \'Apprentie audacieuse\', \'text\': "{T}, sacrifiez l\'Apprentie audacieuse : Contrecarrez le sort ciblé.", \'type\': \'Créature : humain et sorcier\', \'flavor\': \'Un grand sorcier se cache derrière tout apprenti potentiellement calciné.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98135&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0fe762d2-74f7-4d4e-80d7-18f406b83256\', \'multiverseId\': 98135}, \'multiverseid\': 98135}, {\'name\': \'Apprendista Audace\', \'text\': "{T}, Sacrifica l\'Apprendista Audace: Neutralizza una magia bersaglio.", \'type\': \'Creatura — Mago Umano\', \'flavor\': "Davanti a ogni grande stregone c\'è un apprendista condannato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98855&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56575e97-7604-4e27-89a9-d0b5efe3b54d\', \'multiverseId\': 98855}, \'multiverseid\': 98855}, {\'name\': \'果敢な弟子\', \'text\': \'{T}, 果敢な弟子を生け贄に捧げる：呪文１つを対象とし、それを打ち消す。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'全ての偉大なウィザードの陰には、非業の弟子の存在がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99215&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d45d2d7-3e31-4168-bddd-b521f687e830\', \'multiverseId\': 99215}, \'multiverseid\': 99215}, {\'name\': \'Aprendiz Arrojado\', \'text\': \'{T}, Sacrifique Aprendiz Arrojado: Anula a mágica alvo.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'Em frente de todo grande mago há um aprendiz condenado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99575&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6a0bd235-2bb8-4d4a-b075-46810d1c76f1\', \'multiverseId\': 99575}, \'multiverseid\': 99575}, {\'name\': \'Способный ученик\', \'text\': \'{T}, Принесите в жертву Способного ученика: прервите целевое заклинание.\', \'type\': \'Существо — Человек Мудрец\', \'flavor\': \'У каждого великого мудреца есть покорный ученик.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109846&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'924464f5-2fc8-49f4-ae27-fe4704a7514c\', \'multiverseId\': 109846}, \'multiverseid\': 109846}, {\'name\': \'大胆的学徒\', \'text\': \'{T}，牺牲大胆的学徒：反击目标咒语。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'每个伟大的法师，都曾是必败的学徒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97775&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'807ef8b6-fc37-44fe-80aa-dbb7de868721\', \'multiverseId\': 97775}, \'multiverseid\': 97775}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98538&type=card', 'language': 'German', 'identifiers': {'scryfallId': '64e74005-a99e-4673-89ff-a8eb9abbe142', 'multiverseId': 98538}, 'multiverseid': 98538}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99978&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd54e9c9e-5d9a-4b26-804b-9978c3826ae6', 'multiverseId': 99978}, 'multiverseid': 99978}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98178&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9c3ea403-9351-4428-9cf0-6a184e0705eb', 'multiverseId': 98178}, 'multiverseid': 98178}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98898&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '42ae61ea-dad6-4133-9d0b-e706d4fe6809', 'multiverseId': 98898}, 'multiverseid': 98898}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99258&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '56944096-ef60-4246-8109-930873089ffb', 'multiverseId': 99258}, 'multiverseid': 99258}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99618&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '004fe9ae-1bea-4f35-949d-3af6651c11d7', 'multiverseId': 99618}, 'multiverseid': 99618}, {'name': 'Лес', 'type': 'Базовая земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109889&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '880e516f-14f3-44c0-9f4f-0caa47f6a799', 'multiverseId': 109889}, 'multiverseid': 109889}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97818&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '53c62c4a-816a-4509-bd96-de0d79c7c8c5', 'multiverseId': 97818}, 'multiverseid': 97818}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98539&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bd14d247-5672-4327-af18-5c142a8b5d5e', 'multiverseId': 98539}, 'multiverseid': 98539}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99979&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a5fe71f2-e3e9-45c6-825f-97e66e9a4727', 'multiverseId': 99979}, 'multiverseid': 99979}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98179&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3ee54f9d-47fa-45bd-9d08-83709e8c3512', 'multiverseId': 98179}, 'multiverseid': 98179}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98899&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '824a624c-8247-4585-b35f-e3064442bf8c', 'multiverseId': 98899}, 'multiverseid': 98899}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99259&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '231f4dc7-c097-4ce3-bdba-b2a0c30e6a42', 'multiverseId': 99259}, 'multiverseid': 99259}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99619&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3780ca10-45f7-4459-8aa5-307f19aaeea1', 'multiverseId': 99619}, 'multiverseid': 99619}, {'name': 'Лес', 'type': 'Базовая земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109890&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '114f8a66-fd52-46a4-a62f-90a9949f0d6a', 'multiverseId': 109890}, 'multiverseid': 109890}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97819&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5cda663d-1bff-4534-b742-e1cf0be5c42e', 'multiverseId': 97819}, 'multiverseid': 97819}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98540&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fb38f1c7-c8a3-4c59-86c0-d2eb71847219', 'multiverseId': 98540}, 'multiverseid': 98540}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99980&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5691cfe1-a257-4533-8366-87dc8d50c042', 'multiverseId': 99980}, 'multiverseid': 99980}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98180&type=card', 'language': 'French', 'identifiers': {'scryfallId': '728d40c1-66b8-4d19-b24e-8a8b1d81bfdf', 'multiverseId': 98180}, 'multiverseid': 98180}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98900&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '504324b1-5701-4038-9d7d-640fa3f2a25d', 'multiverseId': 98900}, 'multiverseid': 98900}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99260&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e93199c2-ef84-4801-9f0b-3178ee0fc908', 'multiverseId': 99260}, 'multiverseid': 99260}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99620&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '03461270-51ad-4a14-8768-7e0eb45b0882', 'multiverseId': 99620}, 'multiverseid': 99620}, {'name': 'Лес', 'type': 'Базовая земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109891&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '727ef30e-38ec-4ff8-808e-1c82f1eec5bd', 'multiverseId': 109891}, 'multiverseid': 109891}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97820&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fe63f703-b163-49c1-964a-9ce4f22f9ee2', 'multiverseId': 97820}, 'multiverseid': 97820}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98541&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1c9c5bf8-1fcb-4d6e-a97c-6409621dcd6e', 'multiverseId': 98541}, 'multiverseid': 98541}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99981&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd0fb3952-f088-42b2-a5eb-3a193820bb2d', 'multiverseId': 99981}, 'multiverseid': 99981}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98181&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a1c06a9c-d184-4650-8207-c6b9401a0338', 'multiverseId': 98181}, 'multiverseid': 98181}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98901&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '04ebff88-851a-4081-8163-eabe34f428d6', 'multiverseId': 98901}, 'multiverseid': 98901}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99261&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bea7da00-a1fc-47db-ace2-737357cf7bec', 'multiverseId': 99261}, 'multiverseid': 99261}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99621&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a490a09d-b584-47da-b630-0b04ff75c35a', 'multiverseId': 99621}, 'multiverseid': 99621}, {'name': 'Лес', 'type': 'Базовая земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109892&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9772f8db-bf16-40df-976b-24ea3ef1ec58', 'multiverseId': 109892}, 'multiverseid': 109892}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97821&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f886e543-5317-4624-ba45-d94c2ef2d982', 'multiverseId': 97821}, 'multiverseid': 97821}]", '[{\'name\': \'Waldelfen\', \'text\': \'Wenn die Waldelfen ins Spiel kommen, durchsuche deine Bibliothek nach einem Wald und bringe ihn ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Kreatur — Elf, Späher\', \'flavor\': \'Jeder Zweig eine Kreuzung, jede Ranke ein Fortbewegungsmittel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98786&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'96d78f7c-d35f-4a94-b2ca-708f1c99e5c1\', \'multiverseId\': 98786}, \'multiverseid\': 98786}, {\'name\': \'Elfos del bosque\', \'text\': \'Cuando los Elfos del bosque entren en juego, busca una carta de bosque en tu biblioteca y pon esa carta en juego. Luego baraja tu biblioteca.\', \'type\': \'Criatura — Explorador elfo\', \'flavor\': \'Cada rama es una encrucijada, cada enredadera es un corcel raudo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100226&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da8f3914-8388-4f95-a455-aa375da79a91\', \'multiverseId\': 100226}, \'multiverseid\': 100226}, {\'name\': \'Elfe des bois\', \'text\': "Quand l\'Elfe des bois arrive en jeu, cherchez une carte de forêt dans votre bibliothèque et mettez cette carte en jeu. Mélangez ensuite votre bibliothèque.", \'type\': \'Créature : elfe et éclaireur\', \'flavor\': \'Chaque branche est un embranchement, chaque bouture une monture.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98426&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4feedb80-44cd-4877-808a-4f106d686005\', \'multiverseId\': 98426}, \'multiverseid\': 98426}, {\'name\': \'Elfi dei Boschi\', \'text\': \'Quando gli Elfi dei Boschi entrano in gioco, passa in rassegna il tuo grimorio, scegli una carta Foresta e metti in gioco quella carta. Poi rimescola il tuo grimorio.\', \'type\': \'Creatura — Esploratore Elfo\', \'flavor\': \'Ogni ramo è un crocevia, ogni liana un veloce destriero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99146&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b3e74cb1-0dfb-454f-913f-9b1210dbf38d\', \'multiverseId\': 99146}, \'multiverseid\': 99146}, {\'name\': \'ウッド・エルフ\', \'text\': \'ウッド・エルフが場に出たとき、あなたのライブラリーから森カードを１枚探し、そのカードを場に出す。 その後、あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — エルフ・スカウト\', \'flavor\': \'枝はすべて交差路、蔓はすべて駿馬。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99506&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53b2ed49-6d96-462c-8e5a-6e4e9452eb3f\', \'multiverseId\': 99506}, \'multiverseid\': 99506}, {\'name\': \'Elfos da Floresta\', \'text\': \'Quando Elfos da Floresta entra em jogo, procure em seu grimório por um card de Floresta e coloque-o em jogo. Depois, embaralhe seu grimório.\', \'type\': \'Criatura — Batedor Elfo\', \'flavor\': \'Cada galho uma encruzilhada, cada vinha um veloz garanhão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9501664e-8aab-4c79-aff3-e7358269a946\', \'multiverseId\': 99866}, \'multiverseid\': 99866}, {\'name\': \'Лесные эльфы\', \'text\': \'Когда Лесные эльфы вступают в игру, найдите в своей библиотеке карту леса и введите ее в игру. Затем перетасуйте библиотеку.\', \'type\': \'Существо — Эльф Разведчик\', \'flavor\': \'Каждая ветвь перекресток, каждая лиана резвый конь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110137&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c189dc4-727e-47e6-8568-e43c5baf18da\', \'multiverseId\': 110137}, \'multiverseid\': 110137}, {\'name\': \'林木地精\', \'text\': \'当林木地精进场时，从你的牌库中搜寻一张树林牌，并将之放置进场。 然后将你的牌库洗牌。\', \'type\': \'生物～地精／斥候\', \'flavor\': \'每道分枝都是岔路，每条藤蔓都是快马。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98066&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7835d778-8b64-4ac0-99e5-d4e339fe82e6\', \'multiverseId\': 98066}, \'multiverseid\': 98066}]', '[{\'name\': \'Wandergardist-Wachposten\', \'text\': \'Wenn der Wandergardist-Wachposten ins Spiel kommt, schaue dir die Karten auf der Hand eines Spielers deiner Wahl an.\', \'type\': \'Kreatur — Drohne\', \'flavor\': \'Er gibt denen mit gefährlichen Waffen den Weg frei. Aber nicht denen mit gefährlichen Gedanken.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98776&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8f2a2b79-09bb-4974-9f4c-cbed592d1c52\', \'multiverseId\': 98776}, \'multiverseid\': 98776}, {\'name\': \'Centinela vagabundo\', \'text\': \'Cuando el Centinela vagabundo entre en juego, mira la mano del oponente objetivo.\', \'type\': \'Criatura — Zángano\', \'flavor\': \'Permite pasar a aquellos con armar peligrosas. Pero no a aquellos con pensamientos peligrosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100216&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'229a56c1-651c-4e2c-86c6-7106a79c92fc\', \'multiverseId\': 100216}, \'multiverseid\': 100216}, {\'name\': \'Sentinelle garderrance\', \'text\': "Quand cette Sentinelle garderrance arrive en jeu, regardez la main de l\'adversaire ciblé.", \'type\': \'Créature : drone\', \'flavor\': \'Elle laisse passer ceux qui portent des armes dangereuses. Mais pas ceux dont les pensées sont dangereuses.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98416&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'143ff5c6-3685-4998-b608-fddc442bf5fe\', \'multiverseId\': 98416}, \'multiverseid\': 98416}, {\'name\': \'Sentinella Suolocustode\', \'text\': \'Quando la Sentinella Suolocustode entra in gioco, guarda la mano di un avversario bersaglio.\', \'type\': \'Creatura — Drone\', \'flavor\': \'Cede il passo a chi porta armi pericolose. Ma non a chi reca pensieri pericolosi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99136&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce2ca81d-0357-41b3-b964-c23d1b53a242\', \'multiverseId\': 99136}, \'multiverseid\': 99136}, {\'name\': \'地護りの歩哨\', \'text\': \'地護りの歩哨が場に出たとき、対戦相手１人を対象とし、そのプレイヤーの手札を見る。\', \'type\': \'クリーチャー — ドローン\', \'flavor\': \'危険な武器を持つだけなら通してもくれよう。 危険な思想となればそうもいかぬ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99496&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe8fc672-4cbb-4976-884b-d7181d99292f\', \'multiverseId\': 99496}, \'multiverseid\': 99496}, {\'name\': \'Sentinela da Guarda-errante\', \'text\': \'Quando Sentinela da Guarda-errante entra em jogo, olhe os cards da mão do oponente alvo.\', \'type\': \'Criatura — Zangão\', \'flavor\': \'Ele permite que passem os que levam armas perigosas. Mas não os que têm pensamentos perigosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c52bbe2-6cee-451e-98c4-438fcc8905b8\', \'multiverseId\': 99856}, \'multiverseid\': 99856}, {\'name\': \'Караульный\', \'text\': \'Когда Караульный вступает в игру, посмотрите руку целевого оппонента.\', \'type\': \'Существо — Дрон\', \'flavor\': \'Он позволит пройти людям с опасным оружием. Но не с опасными мыслями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110127&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'640eb461-2351-4093-8277-61139b86252b\', \'multiverseId\': 110127}, \'multiverseid\': 110127}, {\'name\': \'巡卫哨兵\', \'text\': \'当巡卫哨兵进场时，检视目标对手的手牌。\', \'type\': \'生物～钉兽\', \'flavor\': \'它不会挡下带有危险武器的人， 而是挡下藏着危险思想的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98056&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'857057f7-51f8-43ce-8a40-14b9126c86c0\', \'multiverseId\': 98056}, \'multiverseid\': 98056}]', '[{\'name\': \'Wassermangel\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98500&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6903f440-52b5-4ae9-80a3-1e295688a78b\', \'multiverseId\': 98500}, \'multiverseid\': 98500}, {\'name\': \'Deshidratación\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85e484bc-812c-4f3e-b5cb-9fb8a4137452\', \'multiverseId\': 99940}, \'multiverseid\': 99940}, {\'name\': \'Déshydratation\', \'text\': "Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98140&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'662f59d0-6d7a-4464-9a5a-61835a97f4d6\', \'multiverseId\': 98140}, \'multiverseid\': 98140}, {\'name\': \'Disidratazione\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata non STAPpa durante lo STAP del proprio controllore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98860&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca7ecc50-4494-4550-bb34-1cfb8363ea59\', \'multiverseId\': 98860}, \'multiverseid\': 98860}, {\'name\': \'脱水\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99220&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'edc969c4-b80b-46cb-bfc9-5c93d8f44c7e\', \'multiverseId\': 99220}, \'multiverseid\': 99220}, {\'name\': \'Desidratação\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99580&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'937a8ce7-5b98-444b-9a4b-79a27b4a1a91\', \'multiverseId\': 99580}, \'multiverseid\': 99580}, {\'name\': \'Иссушение\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо не разворачивается на этапе разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109851&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'65a94da4-3509-4627-bf22-4fd335cfd5fb\', \'multiverseId\': 109851}, \'multiverseid\': 109851}, {\'name\': \'脱水\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物于其操控者的重置步骤中不能重置。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97780&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2f564668-63b8-42ff-b53e-bfbd728ec92b\', \'multiverseId\': 97780}, \'multiverseid\': 97780}]', '[{\'name\': \'Weiser Avior\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)Wenn der Weise Avior ins Spiel kommt, betrachte die obersten vier Karten deiner Bibliothek und lege sie in beliebiger Reihenfolge zurück.\', \'type\': \'Kreatur — Vogel, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98691&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6e2d8e4-ca4a-4b9f-b270-18aa53229805\', \'multiverseId\': 98691}, \'multiverseid\': 98691}, {\'name\': \'Sabio aven\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.) Cuando el Sabio aven entre en juego, mira las cuatro cartas de la parte superior de tu biblioteca, luego regrésalas en cualquier orden.\', \'type\': \'Criatura — Hechicero ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100131&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66bd7f64-cd11-411d-95af-bcc94e31f4df\', \'multiverseId\': 100131}, \'multiverseid\': 100131}, {\'name\': \'Avemain savant\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.) Quand l\'Avemain savant arrive en jeu, regardez les quatre cartes du dessus de votre bibliothèque puis remettez-les dessus dans l\'ordre de votre choix.", \'type\': \'Créature : oiseau et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98331&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5bf0ee23-f262-48b8-b6a8-33bdfbb53859\', \'multiverseId\': 98331}, \'multiverseid\': 98331}, {\'name\': \'Aviano Saggio\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.) Quando l\'Aviano Saggio entra in gioco, guarda le prime quattro carte del tuo grimorio, poi rimettile a posto nell\'ordine che preferisci.", \'type\': \'Creatura — Mago Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99051&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ab633914-130e-4168-890b-0c06c0d72314\', \'multiverseId\': 99051}, \'multiverseid\': 99051}, {\'name\': \'エイヴンの賢人\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\u2028エイヴンの賢人が場に出たとき、あなたのライブラリーの一番上から４枚のカードを見る。その後、それらを好きな順番で戻す。\', \'type\': \'クリーチャー — 鳥・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99411&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d7a9e59-50af-476e-aa78-c6bb5e8485a7\', \'multiverseId\': 99411}, \'multiverseid\': 99411}, {\'name\': \'Aviano Sábio\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.) Quando Aviano Sábio entra em jogo, olhe os quatro cards do topo de seu grimório e depois coloque-os de volta em qualquer ordem.\', \'type\': \'Criatura — Mago Pássaro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99771&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c306e683-90e2-40e0-aa9a-3752e046a1bb\', \'multiverseId\': 99771}, \'multiverseid\': 99771}, {\'name\': \'Мудрая птица\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nКогда мудрая птица вступает в игру, посмотрите четыре верхних карты вашей библиотеки и положите их обратно в произвольном порядке.\', \'type\': \'Существо — Птица Мудрец\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110042&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dff7807f-76c8-4713-b7c5-ae84873ad79f\', \'multiverseId\': 110042}, \'multiverseid\': 110042}, {\'name\': \'艾文智者\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）当艾文智者进场时，检视你牌库顶的四张牌，再将它们以任意顺序放回。\', \'type\': \'生物～鸟／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97971&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e515235e-0bb0-4cc3-a30b-bb03e66b8a01\', \'multiverseId\': 97971}, \'multiverseid\': 97971}]', "[{'name': 'Wettergegerbter Wanderer', 'text': '{W}, {T}: Durchsuche deine Bibliothek nach einem Land, zeige diese Karte offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek. Spiele diese Fähigkeit nur, falls ein Gegner mehr Länder kontrolliert als du.', 'type': 'Kreatur — Mensch, Nomade, Kleriker', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98778&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4ae02897-5773-452c-a8d5-95eb22381b18', 'multiverseId': 98778}, 'multiverseid': 98778}, {'name': 'Caminante curtido', 'text': '{W}, {T}: Busca en tu biblioteca una carta de tierra, muéstrala y ponla en tu mano. Luego baraja tu biblioteca. Juega esta habilidad sólo si un oponente controla más tierras que tú.', 'type': 'Criatura — Clérigo nómada humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100218&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3671b954-17e3-45a3-8afe-1a10c74c57f8', 'multiverseId': 100218}, 'multiverseid': 100218}, {'name': 'Voyageur hâlé', 'text': '{W}, {T} : Cherchez dans votre bibliothèque une carte de terrain, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque. Ne jouez cette capacité que si au moins un adversaire contrôle plus de terrains que vous.', 'type': 'Créature : humain et nomade et clerc', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98418&type=card', 'language': 'French', 'identifiers': {'scryfallId': '10e73ef6-6df8-45b6-8ae8-33d7a1a54cf6', 'multiverseId': 98418}, 'multiverseid': 98418}, {'name': 'Viandante Navigato', 'text': '{W}, {T}: Passa in rassegna il tuo grimorio, scegli una carta terra, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio. Gioca questa abilità solo se almeno un avversario controlla più terre di te.', 'type': 'Creatura — Chierico Nomade Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99138&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3a1b3191-edb5-4b69-925d-45b2eadde825', 'multiverseId': 99138}, 'multiverseid': 99138}, {'name': '雨ざらしの旅人', 'text': '{W}, {T}：あなたのライブラリーから土地カードを１枚探し、それを公開した上であなたの手札に加える。 その後、あなたのライブラリーを切り直す。 この能力は、いずれかの対戦相手があなたよりも多くの土地をコントロールしている場合にのみプレイできる。', 'type': 'クリーチャー — 人間・ノーマッド・クレリック', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99498&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e1fd4606-2156-4715-a9a3-7734e0aa3e8b', 'multiverseId': 99498}, 'multiverseid': 99498}, {'name': 'Viajante Enrijecido', 'text': '{W}, {T}: Procure em seu grimório por um card de terreno, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório. Use esta habilidade apenas se seu oponente controlar mais terrenos do que você.', 'type': 'Criatura — Clérigo Nômade Humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99858&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cf2855ba-35f6-4611-94b3-588de05c278b', 'multiverseId': 99858}, 'multiverseid': 99858}, {'name': 'Закаленный путник', 'text': '{W}, {T}: Найдите в своей библиотеке карту земли, откройте ее и поместите в свою руку. Затем перетасуйте библиотеку. Разыграйте эту способность только в том случае, если оппонент контролирует больше земель, чем вы.', 'type': 'Существо — Человек Бродяга Священник', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110129&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3bab7870-8260-4cb5-90a1-c516cde4db0a', 'multiverseId': 110129}, 'multiverseid': 110129}, {'name': '历艰旅者', 'text': '{W}，{T}：从你的牌库中搜寻一张地牌，展示该牌，并将它置于你手上。 然后将你的牌库洗牌。 你只可以于任一对手操控的地比你多时使用此异能。', 'type': '生物～人类／游牧人／僧侣', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98058&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eefd4fbc-b101-470c-9818-66eeec3b3413', 'multiverseId': 98058}, 'multiverseid': 98058}]", '[{\'name\': \'Windsceada\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'„Dort drob schießt sie durch Luft und Licht, Weit über jeder Ruh, Die Last der Erde bind\\\'t sie nicht, Kein Schatten setzt ihr zu." —Thomas Moore, „Oh wenn ich Flügel hätt"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'614c1786-85a5-4f24-b2ea-da76d4dde0ad\', \'multiverseId\': 98784}, \'multiverseid\': 98784}, {\'name\': \'Draco del viento\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Draco\', \'flavor\': \'"Pero se remonta en lo alto a través del aire y la luz, sobre todos los obstáculos, donde nada terrenal limita su vuelo, y ninguna sombra oscurece su camino." —Thomas Moore, "Oh si tuviera yo alas"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100224&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5157acf7-4ea7-4448-899e-f95e70b197c5\', \'multiverseId\': 100224}, \'multiverseid\': 100224}, {\'name\': \'Drakôn des vents\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : drakôn\', \'flavor\': "« L\'aigle alors jette au loin ces dépouilles opimes Et, l\'aile ouverte au vent, vole vers le soleil. » —Verlaine, Poèmes saturniens", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98424&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0423d92-6486-405e-9cf1-527b9179ea09\', \'multiverseId\': 98424}, \'multiverseid\': 98424}, {\'name\': \'Draghetto del Vento\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Draghetto\', \'flavor\': \'"Ma vola alta attraverso l\\\'aria e la luce, Sopra a qualsiasi infima barriera, Dove niente di terreno impedisce il suo volo, Né l\\\'ombra oscura la sua strada". —Thomas Moore, "Oh that I had Wings"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99144&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9107927-f487-4d6a-84db-e7be33d548b5\', \'multiverseId\': 99144}, \'multiverseid\': 99144}, {\'name\': \'風のドレイク\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — ドレイク\', \'flavor\': \'空高く彼女は飛ぶ、大気と光の中を、 あらゆるものを飛び越えて。 その飛翔をさえぎるものなく、 その行く手を曇らす影なし。 ――トーマス・ムーア「我に翼あらば」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99504&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84d6bfdf-42e6-453a-ab5c-6cf1c9262725\', \'multiverseId\': 99504}, \'multiverseid\': 99504}, {\'name\': \'Dragonete do Vento\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Dragonete\', \'flavor\': \'"Para o alto ela vai, risca o ar e a luz, Sobre tudo o que abaixo atrasa e reduz, Onde nada da terra seu vôo prende, Nem sombra qualquer sua rota surpreende" — Thomas Moore, "Ah, se eu tivesse Asas"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99864&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d249af1-9429-49bd-a852-ff8f8eab5d08\', \'multiverseId\': 99864}, \'multiverseid\': 99864}, {\'name\': \'Ветряной дрейк\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Существо — Дрейк\', \'flavor\': \'"Она стремится ввысь, где свет, Прочь от земных сует. Там тьма не застилает путь, Нет ненавистных пут". — Томас Мор, "Если бы у меня были крылья"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110135&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b572d5c-f576-45d4-8894-907954bfa565\', \'multiverseId\': 110135}, \'multiverseid\': 110135}, {\'name\': \'风龙兽\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'生物～龙兽\', \'flavor\': \'「但她穿越天际与白昼 直到所有牵挂之上 彼处无尘俗羁绊她的飞翔 也没有阴影蒙蔽道路」 ～托玛斯‧摩尔，「假如我有翅膀」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98064&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e4e5fe12-04fb-47ae-a743-5b8c58de47e9\', \'multiverseId\': 98064}, \'multiverseid\': 98064}]', "[{'name': 'Wucherndes Wachstum', 'text': 'Durchsuche deine Bibliothek nach einem Standardland und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die Natur lässt die Lösungen für ihre Probleme einfach sprießen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98669&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ea714dff-b5c1-4e17-b0c1-b2b6457dafc7', 'multiverseId': 98669}, 'multiverseid': 98669}, {'name': 'Crecimiento exuberante', 'text': 'Busca en tu biblioteca una carta de tierra básica y pon en juego esa carta girada. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'La naturaleza cultiva soluciones para sus problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100109&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '53683680-9219-4d9e-b1fc-81113834e778', 'multiverseId': 100109}, 'multiverseid': 100109}, {'name': 'Croissance luxuriante', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base et mettez cette carte en jeu engagée. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'La nature crée des solutions à ses problèmes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98309&type=card', 'language': 'French', 'identifiers': {'scryfallId': '78435d4d-0643-4438-8005-4703f0f1f94a', 'multiverseId': 98309}, 'multiverseid': 98309}, {'name': 'Crescita Inarrestabile', 'text': 'Passa in rassegna il tuo grimorio, scegli una carta terra base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'La natura genera soluzioni ai propri problemi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99029&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fa7e74ac-3f1d-43ea-8cf5-351387317612', 'multiverseId': 99029}, 'multiverseid': 99029}, {'name': '不屈の自然', 'text': 'あなたのライブラリーから基本土地カードを１枚探し、そのカードをタップ状態で場に出す。 その後、あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': '自然は問題の解決法を自ら育て上げる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99389&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3f75d0b6-4845-4fbc-9134-b9c073359b1f', 'multiverseId': 99389}, 'multiverseid': 99389}, {'name': 'Crescimento Exuberante', 'text': 'Procure em seu grimório por um card de terreno básico e coloque-o em jogo virado. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'A natureza cria soluções para seus problemas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99749&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fcc16b83-0601-45a8-9705-cf8eb964a212', 'multiverseId': 99749}, 'multiverseid': 99749}, {'name': 'Буйный рост', 'text': 'Найдите в своей библиотеке карту базовой земли и введите ее в игру повернутой. Затем перетасуйте библиотеку.', 'type': 'Волшебство', 'flavor': 'Решения проблем природы вырастают сами.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110020&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '970b540b-826c-43a4-85bf-5fc346a595a8', 'multiverseId': 110020}, 'multiverseid': 110020}, {'name': '徒长', 'text': '从你的牌库中搜寻一张基本地牌，并将之横置进场。 然后将你的牌库洗牌。', 'type': '法术', 'flavor': '大自然为她的问题而栽培答案。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97949&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '87ba1c66-90a6-4c07-89a8-6e87af1ed2af', 'multiverseId': 97949}, 'multiverseid': 97949}]", '[{\'name\': \'Wunschtier\', \'text\': \'Bringe zu Beginn deines Versorgungssegments das Wunschtier auf die Hand seines Besitzers zurück, falls du mindestens eine Karte auf der Hand hast.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'„Es ist mir nachgelaufen. Kann ich es behalten?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5acc9862-a84f-4038-8e19-e6c19451849e\', \'multiverseId\': 98581}, \'multiverseid\': 98581}, {\'name\': \'Mascota imaginaria\', \'text\': \'Al comienzo de tu mantenimiento, si tienes una carta en la mano, regresa la Mascota imaginaria a la mano de su propietario.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'"Me siguió a casa. ¿Puedo quedármelo?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100021&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c748d156-79a2-40ed-8ebc-aa1b95c5813f\', \'multiverseId\': 100021}, \'multiverseid\': 100021}, {\'name\': \'Animal imaginaire\', \'text\': "Au début de votre entretien, si vous avez une carte en main, renvoyez l\'Animal imaginaire dans la main de son propriétaire.", \'type\': \'Créature : illusion\', \'flavor\': "« Il m\'a suivie jusqu\'à la maison. Je peux le garder ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98221&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d6f640de-9912-4873-840c-2b0bc3694603\', \'multiverseId\': 98221}, \'multiverseid\': 98221}, {\'name\': \'Cucciolo Immaginario\', \'text\': "All\'inizio del tuo mantenimento, se hai almeno una carta in mano, il proprietario riprende in mano il Cucciolo Immaginario.", \'type\': \'Creatura — Illusione\', \'flavor\': \'"Mi ha seguito a casa. Posso tenerlo?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98941&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b0d2ee6-407a-438d-8250-e57921f1c4c3\', \'multiverseId\': 98941}, \'multiverseid\': 98941}, {\'name\': \'想像上のペット\', \'text\': \'あなたのアップキープの開始時に、あなたの手札にカードがある場合、想像上のペットをオーナーの手札に戻す。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'家までついて来ちゃったんだよ。 ねえ、飼ってもいい？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99301&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed8354b7-165d-4603-8a86-e51c89b611ea\', \'multiverseId\': 99301}, \'multiverseid\': 99301}, {\'name\': \'Mascote Imaginário\', \'text\': \'No início de sua manutenção, se você tiver um card em sua mão, devolva Mascote Imaginário para a mão de seu dono.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'"Ele me seguiu até aqui. Posso ficar com ele?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99661&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f819ff32-fca2-4305-a56a-ff17ce05723a\', \'multiverseId\': 99661}, \'multiverseid\': 99661}, {\'name\': \'Воображаемый питомец\', \'text\': \'В начале вашего этапа поддержки, если у вас в руке есть хотя бы одна карта, верните Воображаемого питомца в руку владельца.\', \'type\': \'Существо — Иллюзия\', \'flavor\': \'"Он шел со мной до самого дома. Можно мне его оставить?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109932&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16bc6ede-1fd0-4a70-9a50-e636dca0ae5e\', \'multiverseId\': 109932}, \'multiverseid\': 109932}, {\'name\': \'虚幻宠物\', \'text\': \'在你的维持开始时，若你有任一张手牌，则将虚幻宠物移回其拥有者手上。\', \'type\': \'生物～虚影\', \'flavor\': \'「它跟着我回来。 我能养它吗？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97861&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c856aaf-b9e6-49a4-b3e7-907a6a753119\', \'multiverseId\': 97861}, \'multiverseid\': 97861}]', '[{\'name\': \'Wurmzahn\', \'text\': \'Immer wenn ein Spieler einen grünen Zauberspruch spielt, kannst du 1 Lebenspunkt dazu erhalten.\', \'type\': \'Artefakt\', \'flavor\': \'Ein Wurm kann sich nicht verstellen. Wenn er sein Maul öffnet, plant er, dich zu verspeisen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98789&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea114695-307a-4b98-95ac-fe71acb0d0a1\', \'multiverseId\': 98789}, \'multiverseid\': 98789}, {\'name\': \'Diente de sierpe\', \'text\': \'Siempre que un jugador juegue un hechizo verde, puedes ganar una vida.\', \'type\': \'Artefacto\', \'flavor\': \'Una sierpe no sabe de engaños. Si abre la boca, planea comerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100229&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59729b22-0bcd-4694-b68a-210f3487833c\', \'multiverseId\': 100229}, \'multiverseid\': 100229}, {\'name\': \'Dent de la guivre\', \'text\': "À chaque fois qu\'un joueur joue un sort vert, vous pouvez gagner 1 point de vie.", \'type\': \'Artefact\', \'flavor\': "La guivre n\'est pas bavarde. Si elle ouvre la gueule, c\'est pour vous dévorer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98429&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2ab4ce8-8703-4b58-a1c9-2fdfd495a180\', \'multiverseId\': 98429}, \'multiverseid\': 98429}, {\'name\': \'Dente del Wurm\', \'text\': \'Ogniqualvolta un giocatore gioca una magia verde, puoi guadagnare 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': "Un wurm non sa cosa sia l\'inganno. Se apre la bocca, vuole semplicemente mangiarti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99149&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c7d8af9b-888a-453a-94b4-4c360a8263e0\', \'multiverseId\': 99149}, \'multiverseid\': 99149}, {\'name\': \'ワームの歯\', \'text\': \'いずれかのプレイヤーが緑の呪文をプレイするたび、あなたは１点のライフを得てもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'ワームは欺かない。 そいつの口が開いたら、お前を食うつもりだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99509&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb6ad4c9-e829-40e9-8eb5-296fca43a68a\', \'multiverseId\': 99509}, \'multiverseid\': 99509}, {\'name\': \'Dente de Vorme\', \'text\': \'Toda vez que um jogador jogar uma mágica verde, você pode ganhar 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Um vorme não sabe nada sobre engodos. Se ele abre a boca, ele quer comê-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0bef7a4a-23c6-40e7-8cd7-f7dafdd32534\', \'multiverseId\': 99869}, \'multiverseid\': 99869}, {\'name\': \'Клык вурма\', \'text\': \'Каждый раз, когда разыгрывается зеленое заклинание, вы получаете 1 пункт жизни.\', \'type\': \'Артефакт\', \'flavor\': \'Вурм никогда не прибегает к обману. Если он раскрыл пасть, значит, он собирается вас съесть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110140&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4f42a4d-1601-4e55-97b3-e0d0a18e7464\', \'multiverseId\': 110140}, \'multiverseid\': 110140}, {\'name\': \'亚龙巨牙\', \'text\': \'每当牌手使用任何绿色咒语时，你可以获得1点生命。\', \'type\': \'神器\', \'flavor\': \'亚龙不会说谎。 它若张开嘴巴，就是要把你吃掉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98069&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'36062246-6737-4ff7-bdf7-877035819675\', \'multiverseId\': 98069}, \'multiverseid\': 98069}]', '[{\'name\': \'Wurzelbrechender Wurm\', \'text\': \'Verursacht Trampelschaden (Falls diese Kreatur ihren Blockern genug Schaden zufügen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler zufügen lassen.)\', \'type\': \'Kreatur — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98685&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3ec05e7-167c-4864-b366-7eb23fbf5e03\', \'multiverseId\': 98685}, \'multiverseid\': 98685}, {\'name\': \'Sierpe quiebraraíces\', \'text\': \'Arrolla. (Si esta criatura fuera a hacer suficiente daño de combate a sus bloqueadores como para destruirlos, puedes hacer que le haga el resto del daño al jugador defensor.)\', \'type\': \'Criatura — Sierpe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100125&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88e53a75-837c-43bd-b81a-9867b29974a0\', \'multiverseId\': 100125}, \'multiverseid\': 100125}, {\'name\': \'Guivre brise-racines\', \'text\': "Piétinement (Si cette créature inflige suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle inflige le reste de ses blessures au joueur défenseur.)", \'type\': \'Créature : guivre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98325&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'440e9e3f-d9a3-41b9-bcba-b91cef90dbb6\', \'multiverseId\': 98325}, \'multiverseid\': 98325}, {\'name\': \'Wurm Spezzaradici\', \'text\': \'Travolgere (Se questa creatura infligge alle creature che la bloccano un ammontare di danni da combattimento sufficiente a distruggerle, puoi farle infliggere i danni rimanenti al giocatore in difesa.)\', \'type\': \'Creatura — Wurm\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b500a883-04c1-40ed-a979-ee2153163979\', \'multiverseId\': 99045}, \'multiverseid\': 99045}, {\'name\': \'根切りワーム\', \'text\': \'トランプル （このクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分な戦闘ダメージを与える場合、あなたはそれの残りのダメージを防御プレイヤーに与えてもよい。）\', \'type\': \'クリーチャー — ワーム\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99405&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cce63818-a444-4047-8e21-e897560a5de2\', \'multiverseId\': 99405}, \'multiverseid\': 99405}, {\'name\': \'Vorme Romperraízes\', \'text\': \'Atropelar (Se esta criatura fosse causar dano de combate suficiente para destruir seus bloqueadores, você pode fazer com que ela cause o resto de seu dano ao jogador defensor.)\', \'type\': \'Criatura — Vorme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99765&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3fd6540c-0474-42d8-9f41-ebe3bb05c834\', \'multiverseId\': 99765}, \'multiverseid\': 99765}, {\'name\': \'Подрывающий корни вурм\', \'text\': \'Пробивающий удар (Если это существо нанесло достаточно повреждений, чтобы уничтожить блокирующих, остальные повреждения оно может нанести обороняющемуся игроку).\', \'type\': \'Существо — Вурм\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110036&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c6d28fe0-8feb-4d14-9f39-c0391ebea27d\', \'multiverseId\': 110036}, \'multiverseid\': 110036}, {\'name\': \'破根亚龙\', \'text\': \'践踏（若此生物将造成的战斗伤害足以消灭所有阻挡它的生物，你可以使它对防御牌手造成所剩余数量的伤害）\', \'type\': \'生物～亚龙\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97965&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'52bea599-a359-4dde-a694-0bd48216c0dc\', \'multiverseId\': 97965}, \'multiverseid\': 97965}]', '[{\'name\': \'Wurzeleidechse\', \'text\': \'{1}{G}: Die Wurzeleidechse erhält +2/+2 bis zum Ende des Zuges. Spiele diese Fähigkeit nur einmal pro Zug.\', \'type\': \'Kreatur — Eidechse\', \'flavor\': \'Wenn du versuchst, dich an eine Wurzeleidechse heranzuschleichen, wirst du plötzlich merken, dass sie auch darauf gefasst war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98686&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8bcc292c-44a1-4284-901d-cffbc45842b0\', \'multiverseId\': 98686}, \'multiverseid\': 98686}, {\'name\': \'Raizguana\', \'text\': \'{1}{G}: La Raizguana obtiene +2/+2 hasta el final del turno. Juega esta habilidad sólo una vez cada turno.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'Si tratas de enfrentarte a una raizguana, puedes encontrarte luchando con dos veces ese lagarto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100126&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e6ba97f-cbbe-4b29-82ef-1a58a9c487a1\', \'multiverseId\': 100126}, \'multiverseid\': 100126}, {\'name\': \'Agame des souches\', \'text\': "{1}{G} : L\'Agame des souches gagne +2/+2 jusqu\'à la fin du tour. Ne jouez cette capacité qu\'une seule fois par tour.", \'type\': \'Créature : lézard\', \'flavor\': "Si vous tentez de surprendre l\'agame des souches, c\'est vous qui risquez d\'être surpris.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98326&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b66e55ea-e208-425f-898f-0b00b83a0c18\', \'multiverseId\': 98326}, \'multiverseid\': 98326}, {\'name\': \'Lucertola delle Radici\', \'text\': \'{1}{G}: La Lucertola delle Radici prende +2/+2 fino alla fine del turno. Gioca questa abilità solo una volta per turno.\', \'type\': \'Creatura — Lucertola\', \'flavor\': "Se cerchi di prendere di sorpresa una lucertola delle radici, ti ritrovi all\'improvviso a fronteggiare il doppio delle lucertole.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99046&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8b7d705-be8a-4ea9-bffd-10c8c70a6372\', \'multiverseId\': 99046}, \'multiverseid\': 99046}, {\'name\': \'ルートワラ\', \'text\': \'{1}{G}：ルートワラはターン終了時まで+2/+2の修整を受ける。 この能力は、毎ターン１回のみプレイできる。\', \'type\': \'クリーチャー — トカゲ\', \'flavor\': \'ルートワラにこっそりと忍び寄ろうとしてみれば、正面から堂々といくより倍も難しいことに突然気がつくだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99406&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ce45ede-2477-4a60-a09f-a4f5dc5a9c81\', \'multiverseId\': 99406}, \'multiverseid\': 99406}, {\'name\': \'Rizowalla\', \'text\': \'{1}{G}: Rizowalla recebe +2/+2 até o final do turno. Use esta habilidade apenas uma vez por turno.\', \'type\': \'Criatura — Lagarto\', \'flavor\': \'Se você tentar se desviar sorrateiramente de um rizowalla, de repente se verá frente a frente com um lagarto duas vezes maior.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99766&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'150d9d4f-c61c-4060-9d8a-0a91109186d9\', \'multiverseId\': 99766}, \'multiverseid\': 99766}, {\'name\': \'Рутвалла\', \'text\': \'{1}{G}: Рутвалла получает +2/+2 до конца хода. В течение одного хода разыгрывайте эту способность только один раз.\', \'type\': \'Существо — Ящерица\', \'flavor\': \'Если вы попытаетесь схватить рутваллу, вы вдруг увидите, что перед вами две ящерицы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110037&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c9a0c498-bcee-415b-9fb0-aea70d044e7f\', \'multiverseId\': 110037}, \'multiverseid\': 110037}, {\'name\': \'萝特瓦拉\', \'text\': \'{1}{G}：萝特瓦拉得+2/+2直到回合结束。 此异能每回合中只能使用一次。\', \'type\': \'生物～蜥蜴\', \'flavor\': \'想要偷袭萝特瓦拉的话，你将会发现自己得面对两倍大的蜥蜴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97966&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68846a08-631e-454a-a48c-e5f80fcec84a\', \'multiverseId\': 97966}, \'multiverseid\': 97966}]', '[{\'name\': \'Wächter des Heiligtums\', \'text\': \'Opfere den Wächter des Heiligtums: Wenn eine Quelle, die du bestimmst, das nächste Mal in diesem Zug einer Kreatur oder einem Spieler deiner Wahl Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98693&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e86bda2f-4798-467c-ac56-eb8092ebcde3\', \'multiverseId\': 98693}, \'multiverseid\': 98693}, {\'name\': \'Guardián del lugar sagrado\', \'text\': \'Sacrificar el Guardián del lugar sagrado: La próxima vez que una fuente de tu elección fuera a hacer daño a la criatura o jugador objetivo este turno, prevén ese daño.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100133&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'827594c8-53b1-4798-900f-ae670c282763\', \'multiverseId\': 100133}, \'multiverseid\': 100133}, {\'name\': \'Vigile du sanctuaire\', \'text\': "Sacrifiez le Vigile du sanctuaire : La prochaine fois qu\'une source de votre choix devrait blesser une cible, créature ou joueur, ce tour-ci, prévenez ces blessures.", \'type\': \'Créature : humain et clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b5dd34e4-9652-428d-93b8-d1047e46b9ef\', \'multiverseId\': 98333}, \'multiverseid\': 98333}, {\'name\': \'Guardiano del Santuario\', \'text\': \'Sacrifica il Guardiano del Santuario: La prossima volta che una fonte a tua scelta sta per infliggere danno a una creatura o a un giocatore bersaglio in questo turno, previeni quel danno.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99053&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'472a7dec-d6ad-43a2-b497-5fef0c8fab79\', \'multiverseId\': 99053}, \'multiverseid\': 99053}, {\'name\': \'聖域の守護者\', \'text\': \'聖域の守護者を生け贄に捧げる：クリーチャー１体かプレイヤー１人を対象とする。このターン、あなたが選んだ発生源１つが次にそれに与えるダメージをすべて軽減し、０にする。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99413&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1be518f1-d276-495a-a775-6c4e588e85e2\', \'multiverseId\': 99413}, \'multiverseid\': 99413}, {\'name\': \'Guardião do Santuário\', \'text\': \'Sacrifique Guardião do Santuário: Na próxima vez que uma fonte a sua escolha fosse causar dano à criatura ou ao jogador alvo neste turno, previna aquele dano.\', \'type\': \'Criatura — Clérigo Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99773&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6743cc73-247f-4651-b0c5-f096a0a51aa7\', \'multiverseId\': 99773}, \'multiverseid\': 99773}, {\'name\': \'Страж святыни\', \'text\': \'Принесите Стража святыни в жертву: в следующий раз, когда в этот ход указанный вами источник будет наносить повреждения целевому существу или игроку, предотвратите повреждения.\', \'type\': \'Существо — Человек Священник\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110044&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4c642a6e-dc93-42ce-a194-588eeec1f94b\', \'multiverseId\': 110044}, \'multiverseid\': 110044}, {\'name\': \'圣域守护者\', \'text\': \'牺牲圣域守护者：选择一个来源，于本回合中，防止该来源下一次将对目标生物或牌手造成的伤害。\', \'type\': \'生物～人类／僧侣\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97973&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1947ae56-8b9f-487a-b190-c3a43c8068f2\', \'multiverseId\': 97973}, \'multiverseid\': 97973}]', '[{\'name\': \'Wütender Goblin\', \'text\': \'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen.)\', \'type\': \'Kreatur — Goblin, Berserker\', \'flavor\': \'Er tobte gegen die Welt, gegen seine Familie, gegen sein Leben. Aber hauptsächlich tobte er.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98667&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b342b88-ae1f-4717-8eaa-66ef6e5ff09c\', \'multiverseId\': 98667}, \'multiverseid\': 98667}, {\'name\': \'Trasgo furioso\', \'text\': \'Prisa. (Esta criatura puede atacar el turno en que entre bajo tu control.)\', \'type\': \'Criatura — Berserker trasgo\', \'flavor\': \'Estaba furioso con su mundo, con su familia, con su vida. Pero principalmente, sólo estaba furioso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100107&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3631b05-dca5-46d6-b848-52eb4b5e3ee4\', \'multiverseId\': 100107}, \'multiverseid\': 100107}, {\'name\': \'Gobelin enragé\', \'text\': \'Célérité (Cette créature peut attaquer dès le tour où elle arrive sous votre contrôle.)\', \'type\': \'Créature : gobelin et berserker\', \'flavor\': "Il enrageait contre le monde, contre sa famille, contre lui-même. Mais en fait, il n\'avait pas vraiment besoin d\'enrager contre quelque chose de précis.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98307&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b3a9776-a314-49a4-bd64-3c04dd0b952b\', \'multiverseId\': 98307}, \'multiverseid\': 98307}, {\'name\': \'Goblin Furioso\', \'text\': \'Rapidità (Questa creatura può attaccare nel turno in cui entra sotto il tuo controllo.)\', \'type\': \'Creatura — Berserker Goblin\', \'flavor\': \'È arrabbiato con il mondo, con la propria famiglia e con la vita. Più che altro è arrabbiato e basta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99027&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c96c799-aec9-4049-b228-d931d1f65330\', \'multiverseId\': 99027}, \'multiverseid\': 99027}, {\'name\': \'怒り狂うゴブリン\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になったターンに攻撃に参加してもよい。）\', \'type\': \'クリーチャー — ゴブリン・狂戦士\', \'flavor\': \'彼は世界に対して怒り、家族に対して怒り、自分の人生に対して怒っていた。 だが、だいたいは理由もなく怒っていたんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99387&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c8e3d07-73b0-41d5-8e80-31048154298a\', \'multiverseId\': 99387}, \'multiverseid\': 99387}, {\'name\': \'Goblin Enfurecido\', \'text\': \'Ímpeto (Esta criatura pode atacar no turno em que entra em jogo sob seu controle.)\', \'type\': \'Criatura — Goblin Amoque\', \'flavor\': \'Ele se enfurecia com o mundo, com sua família, com sua vida. Mas acima de tudo, ele se enfurecia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99747&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1305aaf7-5f5c-4c3d-9655-6410dc5c1e1a\', \'multiverseId\': 99747}, \'multiverseid\': 99747}, {\'name\': \'Разъяренный гоблин\', \'text\': \'Ускорение (Это существо может нападать во время того хода, когда оно попало под ваш контроль).\', \'type\': \'Существо — Гоблин Берсеркер\', \'flavor\': \'Он злится на мир, на семью, на свою жизнь. А вообще-то, он злится просто так.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110018&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5d142ea5-93c5-403b-83f5-3743251d66a9\', \'multiverseId\': 110018}, \'multiverseid\': 110018}, {\'name\': \'愤怒精灵\', \'text\': \'敏捷（你操控此生物的该回合中，它便可以攻击）\', \'type\': \'生物～精灵／狂战士\', \'flavor\': \'他对世界、家庭和他的生活都感到愤怒。 但大多时候他只是纯粹愤怒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97947&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ad38442f-754d-4bce-bbf2-142abf6936f8\', \'multiverseId\': 97947}, \'multiverseid\': 97947}]', '[{\'name\': \'Wütendwerden\', \'text\': \'Eine Kreatur deiner Wahl erhält +X/+0 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Barbaren nennen es „die Seele des Drachen berühren".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98519&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e63f5d1e-e114-4548-be7d-8130f1d7f32f\', \'multiverseId\': 98519}, \'multiverseid\': 98519}, {\'name\': \'Encolerizar\', \'text\': \'La criatura objetivo obtiene +X/+0 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Los bárbaros lo llaman "tocar el alma del dragón."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99959&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a5e3ff3-6b9c-4f56-a64f-94a5931ccf0b\', \'multiverseId\': 99959}, \'multiverseid\': 99959}, {\'name\': \'Enrager\', \'text\': "La créature ciblée gagne +X/+0 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Les barbares appellent cela « toucher l\'âme du dragon. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98159&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ccaaa70-de65-4463-8fa1-cf25cf3b598e\', \'multiverseId\': 98159}, \'multiverseid\': 98159}, {\'name\': \'Infuriare\', \'text\': \'La creatura bersaglio prende +X/+0 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'I barbari lo definiscono "toccare l\\\'anima del drago".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98879&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef5498bd-e2e0-4bef-abfe-b2c1d630270d\', \'multiverseId\': 98879}, \'multiverseid\': 98879}, {\'name\': \'怒髪天\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで+X/+0の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'蛮族はそれを「ドラゴンの魂に触れること」と呼ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99239&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc97d293-fb19-4753-99a3-b1ad0151e605\', \'multiverseId\': 99239}, \'multiverseid\': 99239}, {\'name\': \'Enfurecer\', \'text\': \'A criatura alvo recebe +X/+0 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os bárbaros a chamam de "tocar a alma do dragão".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99599&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'287624d8-d250-465a-abfe-14d9086b89a5\', \'multiverseId\': 99599}, \'multiverseid\': 99599}, {\'name\': \'Ярость\', \'text\': \'Целевое существо получает +X/+0 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Варвары называют это "задеть дракона за живое".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109870&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b1fa0405-3f6c-419e-b571-20cfb07f2dfa\', \'multiverseId\': 109870}, \'multiverseid\': 109870}, {\'name\': \'激怒\', \'text\': \'目标生物得+X/+0直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'野蛮人称之为「碰触龙魂」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97799&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c10494cd-a272-4b66-9887-d039de521e84\', \'multiverseId\': 97799}, \'multiverseid\': 97799}]', '[{\'name\': \'Yavimayablütenzauberin\', \'text\': \'Die Yavimayablütenzauberin erhält +1/+1 für jede Verzauberung im Spiel.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'Ihre Wurzeln verbinden sie mit den Wünschen des Waldes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04c03674-021a-4da5-93bb-f7006d7e9b33\', \'multiverseId\': 98791}, \'multiverseid\': 98791}, {\'name\': \'Hechicera de Yavimaya\', \'text\': \'La Hechicera de Yavimaya obtiene +1/+1 por cada encantamiento que haya en juego.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'Sus raíces la conectan con los deseos del bosque.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100231&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df3f503a-5b60-48c2-b503-f935eac5f7b4\', \'multiverseId\': 100231}, \'multiverseid\': 100231}, {\'name\': \'Enchanteresse de la Yavimaya\', \'text\': "L\'Enchanteresse de la Yavimaya gagne +1/+1 pour chaque enchantement en jeu.", \'type\': \'Créature : humain et druide\', \'flavor\': \'Ses racines la relient aux désirs de la forêt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98431&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ee02a54-29ed-4857-b9f0-9a0254743153\', \'multiverseId\': 98431}, \'multiverseid\': 98431}, {\'name\': \'Incantatrice di Yavimaya\', \'text\': "L\'Incantatrice di Yavimaya prende +1/+1 per ogni incantesimo in gioco.", \'type\': \'Creatura — Druido Umano\', \'flavor\': \'Le sue radici la tengono in contatto con i desideri della foresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99151&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3906c886-ea4f-4229-9445-d105c2c7706c\', \'multiverseId\': 99151}, \'multiverseid\': 99151}, {\'name\': \'ヤヴィマヤの女魔術師\', \'text\': \'ヤヴィマヤの女魔術師は、場に出ているエンチャント１つにつき+1/+1の修整を受ける。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'彼女の根は、彼女と森の願望とをつないでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99511&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd257fa8-765f-48a5-83d1-b2b9be07b65e\', \'multiverseId\': 99511}, \'multiverseid\': 99511}, {\'name\': \'Encantadora de Yavimaya\', \'text\': \'Encantadora de Yavimaya recebe +1/+1 para cada encantamento em jogo.\', \'type\': \'Criatura — Druida Humano\', \'flavor\': \'Suas raízes a conectam aos desejos da floresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99871&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f9572f4-1f06-4c4a-9f44-36716b3674fe\', \'multiverseId\': 99871}, \'multiverseid\': 99871}, {\'name\': \'Явимайская чародейка\', \'text\': \'Явимайская чародейка получает +1/+1 за каждые чары, находящиеся в игре.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'Через корни она узнает о желаниях леса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110142&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'49d09c9f-550f-49d8-8574-30deed885940\', \'multiverseId\': 110142}, \'multiverseid\': 110142}, {\'name\': \'亚维马雅咒术师\', \'text\': \'场上每有一个结界，亚维马雅咒术师便得+1/+1。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'她的根让自己与森林的愿望连结。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98071&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a101515f-96d8-46cc-90f7-895ace2abcec\', \'multiverseId\': 98071}, \'multiverseid\': 98071}]', "[{'name': 'Yavimayaküste', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {G} oder {U}. Die Yavimayaküste fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98790&type=card', 'language': 'German', 'identifiers': {'scryfallId': '23c57b17-5263-4b0c-89ec-034fbe912e51', 'multiverseId': 98790}, 'multiverseid': 98790}, {'name': 'Costa de Yavimaya', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {G} o {U} a tu reserva de maná. La Costa de Yavimaya te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100230&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ff90b443-2c66-432b-bc83-870876169948', 'multiverseId': 100230}, 'multiverseid': 100230}, {'name': 'Côte de la Yavimaya', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {G} ou {U} à votre réserve. La Côte de la Yavimaya vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98430&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1e94d418-1d31-4c72-a1ed-604300fb3ce5', 'multiverseId': 98430}, 'multiverseid': 98430}, {'name': 'Costa di Yavimaya', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {G} o {U} alla tua riserva di mana. La Costa di Yavimaya ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99150&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd5ef227f-235f-46de-9205-8fe0cd9ecfd9', 'multiverseId': 99150}, 'multiverseid': 99150}, {'name': 'ヤヴィマヤの沿岸', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{G}か{U}を加える。 ヤヴィマヤの沿岸はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99510&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4a68f722-adc9-473b-b842-78fa492be642', 'multiverseId': 99510}, 'multiverseid': 99510}, {'name': 'Costa de Yavimaya', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {G} ou {U} à sua reserva de mana. Costa de Yavimaya causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99870&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '79a5661e-7705-4f17-aee5-6f4e0398c962', 'multiverseId': 99870}, 'multiverseid': 99870}, {'name': 'Явимайское побережье', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {G} или {U} в запас маны. Явимайское побережье наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110141&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ce4cc3e2-8949-40ce-9dad-f6375d8d2984', 'multiverseId': 110141}, 'multiverseid': 110141}, {'name': '亚维马雅海岸', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{G}或{U}到你的法术力池中。 亚维马雅海岸对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98070&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '40355e3f-a131-41d2-bb3c-41ff2e8404f3', 'multiverseId': 98070}, 'multiverseid': 98070}]", '[{\'name\': \'Yawgmoth-Dämon\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nErstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\\nZu Beginn deines Versorgungssegments kannst du ein Artefakt opfern. Falls du dies nicht tust, tappe den Yawgmoth-Dämonen, und er fügt dir 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98792&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2d16e8f6-25bb-4ff5-b85e-b17e59996f7f\', \'multiverseId\': 98792}, \'multiverseid\': 98792}, {\'name\': \'Demonio de Yawgmoth\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nDaña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\\nAl comienzo de tu mantenimiento, puedes sacrificar un artefacto. Si no lo haces, gira el Demonio de Yawgmoth y te hace 2 puntos de daño.\', \'type\': \'Criatura — Demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e701fae9-8d31-4f65-8845-055f2d7d1e9e\', \'multiverseId\': 100232}, \'multiverseid\': 100232}, {\'name\': \'Démon de Yaugzebul\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nInitiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)\\nAu début de votre entretien, vous pouvez sacrifier un artefact. Si vous ne le faites pas, engagez le Démon de Yaugzebul et il vous inflige 2 blessures.", \'type\': \'Créature : démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98432&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'99fd7d30-6bf0-4dce-becd-86e815452600\', \'multiverseId\': 98432}, \'multiverseid\': 98432}, {\'name\': \'Demone di Yawgmoth\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nAttacco improvviso (Questa creatura infligge il danno da combattimento prima delle creature senza attacco improvviso.)\\nAll\'inizio del tuo mantenimento, puoi sacrificare un artefatto. Se non lo fai, TAPpa il Demone di Yawgmoth ed esso ti infligge 2 danni.", \'type\': \'Creatura — Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99152&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e262d77a-4d7d-4b87-a55b-434aa9f123b2\', \'multiverseId\': 99152}, \'multiverseid\': 99152}, {\'name\': \'ヨーグモスの悪魔\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n先制攻撃 （このクリーチャーは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\\nあなたのアップキープの開始時に、あなたはアーティファクトを１つ生け贄に捧げてもよい。 そうしない場合、ヨーグモスの悪魔をタップし、それはあなたに２点のダメージを与える。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99512&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c04a5ce-6545-49f1-9f40-53acef483ef2\', \'multiverseId\': 99512}, \'multiverseid\': 99512}, {\'name\': \'Demônio de Yawgmoth\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nIniciativa (Esta criatura causa dano de combate antes de criaturas sem a habilidade de iniciativa.)\\nNo início de sua manutenção, você pode sacrificar um artefato. Se você não o fizer, vire Demônio de Yawgmoth e ele causa 2 pontos de dano a você.\', \'type\': \'Criatura — Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99872&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b2917a72-54e5-40ad-af45-b60d49dc06de\', \'multiverseId\': 99872}, \'multiverseid\': 99872}, {\'name\': \'Демон Ягмота\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nПервый удар (Это существо наносит боевые повреждения раньше существ без способности первого удара).\\nВ начале вашего этапа поддержки вы можете принести в жертву артефакт. Если вы этого не делаете, поверните Демона Ягмота, при этом он наносит вам 2 повреждения.\', \'type\': \'Существо — Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110143&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9d426136-0f57-4852-9f54-277a91225ba0\', \'multiverseId\': 110143}, \'multiverseid\': 110143}, {\'name\': \'约格莫夫恶魔\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n先攻（此生物会比不具先攻异能的生物提前造成战斗伤害。）\\n在你的维持开始时，你可以牺牲一个神器。 若你未如此作，则横置约格莫夫恶魔，且它对你造成2点伤害。\', \'type\': \'生物～恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'10457cca-4597-4c17-a963-5d908ee8a028\', \'multiverseId\': 98072}, \'multiverseid\': 98072}]', '[{\'name\': \'Zauberbuch\', \'text\': \'Es gibt keine Obergrenze für die Anzahl der Karten, die du auf der Hand halten darfst.\', \'type\': \'Artefakt\', \'flavor\': \'„Alles, was die weise Frau lernte, schrieb sie in ihr Buch, und als die Seiten schwarz vor Tinte waren, nahm sie weiße Tinte und begann von vorn." —Karn, Silbergolem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98721&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'90340347-d6f5-4b87-8187-0402f23531c4\', \'multiverseId\': 98721}, \'multiverseid\': 98721}, {\'name\': \'Libro de hechizos\', \'text\': \'Tu mano no tiene tamaño máximo.\', \'type\': \'Artefacto\', \'flavor\': \'"Todo lo que la mujer sabia aprendió lo escribió en un libro, y cuando las páginas estuvieron negras de tinta, tomó tinta blanca y comenzó de nuevo." —Karn, gólem de plata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100161&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'70b96729-1c7f-4a06-be81-0c263c794caa\', \'multiverseId\': 100161}, \'multiverseid\': 100161}, {\'name\': \'Livre de sorts\', \'text\': "Il n\'y a pas de limite au nombre de cartes dans votre main.", \'type\': \'Artefact\', \'flavor\': "« Tout ce que la femme sage apprit, elle le consigna dans un livre. Et quand toutes les pages furent couvertes d\'encre noire, elle prit de l\'encre blanche et recommença. » —Karn, golem d\'argent", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98361&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'00988602-d0fb-4af2-b93b-13a756a6ea0c\', \'multiverseId\': 98361}, \'multiverseid\': 98361}, {\'name\': \'Libro delle Magie\', \'text\': \'Non hai più il limite di carte nella mano.\', \'type\': \'Artefatto\', \'flavor\': \'"La saggia era solita annotare tutto ciò che imparava e, quando le pagine furono nere d\\\'inchiostro, prese l\\\'inchiostro bianco e ricominciò." —Karn, golem d\\\'argento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99081&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6b2c9784-1148-4740-8203-d9a4c1d8d0a2\', \'multiverseId\': 99081}, \'multiverseid\': 99081}, {\'name\': \'呪文書\', \'text\': \'あなたの手札の上限はなくなる。\', \'type\': \'アーティファクト\', \'flavor\': \'あの賢い女性は学んだことをすべて本に書き記したんです。ページがインクで真っ黒になると、白いインクでまた書き始めたんです。 ――銀のゴーレム、カーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99441&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb8de473-200a-482a-9352-9fb2aed7f84e\', \'multiverseId\': 99441}, \'multiverseid\': 99441}, {\'name\': \'Livro de Mágicas\', \'text\': \'Não há limite para o número máximo de cards em sua mão.\', \'type\': \'Artefato\', \'flavor\': \'"Tudo o que a mulher sábia aprendia, ela escrevia num livro e, quando as páginas estavam negras de tinta, ela pegava tinta branca e recomeçava a escrever." — Karn, golem de prata\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99801&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a57fd107-0862-4e72-b3d4-e43eb69cdf71\', \'multiverseId\': 99801}, \'multiverseid\': 99801}, {\'name\': \'Книга заклинаний\', \'text\': \'Размер вашей руки неограничен.\', \'type\': \'Артефакт\', \'flavor\': \'"Все, что узнавала мудрая женщина, она записывала в книгу. Когда же страницы стали черными от чернил, она взяла белые чернила и начала все заново". — Карн, серебряный голем\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110072&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1d696eee-79ce-43a8-93e0-349485bc3fa2\', \'multiverseId\': 110072}, \'multiverseid\': 110072}, {\'name\': \'法术书\', \'text\': \'你的手牌数量没有上限。\', \'type\': \'神器\', \'flavor\': \'「这个聪慧女子将所学的每样东西都写进书里；最后每一页都被墨水涂黑了，她又改用白墨水，重新开始。」 ～银魔像卡恩\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98001&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c488db9-7eae-4557-9f46-1fa55c9ddc8e\', \'multiverseId\': 98001}, \'multiverseid\': 98001}]', '[{\'name\': \'Zeitebbe\', \'text\': \'Lege eine Kreatur deiner Wahl oben auf die Bibliothek ihres Besitzers.\', \'type\': \'Hexerei\', \'flavor\': \'Du musst noch viel ruhiger werden ...\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98751&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0991d08f-6b13-47e6-a28d-56ed29fabecf\', \'multiverseId\': 98751}, \'multiverseid\': 98751}, {\'name\': \'La compensación del tiempo\', \'text\': \'Pon el permanente objetivo en la parte superior de la biblioteca de su propietario.\', \'type\': \'Conjuro\', \'flavor\': \'Como la marea, el tiempo fluye y regresa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100191&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ff40463-a8bc-4769-bf80-11a1dffda7bc\', \'multiverseId\': 100191}, \'multiverseid\': 100191}, {\'name\': \'Temps du jusant\', \'text\': \'Mettez la créature ciblée au-dessus de la bibliothèque de son propriétaire.\', \'type\': \'Rituel\', \'flavor\': "Le temps subit les mêmes marées que l\'océan.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98391&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f9a366be-b512-42c9-854d-6bc70c889d4c\', \'multiverseId\': 98391}, \'multiverseid\': 98391}, {\'name\': \'Riflusso Temporale\', \'text\': \'Metti una creatura bersaglio in cima al grimorio del suo proprietario.\', \'type\': \'Stregoneria\', \'flavor\': \'Come la marea, il tempo fluisce e rifluisce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99111&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e255711f-c1b5-4f79-9634-3e13d74dffd2\', \'multiverseId\': 99111}, \'multiverseid\': 99111}, {\'name\': \'時の引き潮\', \'text\': \'クリーチャー１体を対象とし、それをオーナーのライブラリーの一番上に置く。\', \'type\': \'ソーサリー\', \'flavor\': \'海と同じく、時も満ち干を繰り返す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99471&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7ddbaa7-b94b-412d-a627-c5443d7a748e\', \'multiverseId\': 99471}, \'multiverseid\': 99471}, {\'name\': \'Refluxo do Tempo\', \'text\': \'Coloca a criatura alvo no topo do grimório de seu dono.\', \'type\': \'Feitiço\', \'flavor\': \'Como a maré, o tempo reflui.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99831&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8defd3e-a003-439c-b84d-219ddf3e1f28\', \'multiverseId\': 99831}, \'multiverseid\': 99831}, {\'name\': \'Временной отлив\', \'text\': \'Положите целевое существо в библиотеку владельца сверху.\', \'type\': \'Волшебство\', \'flavor\': \'Словно морская волна, время приходит и отходит.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110102&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb06920a-800a-414a-a368-a50f6a0d62b2\', \'multiverseId\': 110102}, \'multiverseid\': 110102}, {\'name\': \'时光退潮\', \'text\': \'将目标生物置于其拥有者的牌库顶。\', \'type\': \'法术\', \'flavor\': \'时光涨落如潮汐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98031&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cfe79094-818e-4157-9f95-a28e07b30fe6\', \'multiverseId\': 98031}, \'multiverseid\': 98031}]', '[{\'name\': \'Zeittalent\', \'text\': \'{U}{U}{U}, {T}: Bringe eine bleibende Karte deiner Wahl auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Falls gestern vorgestern morgen war, ist dann übermorgen heute oder gestern?" —Zeitmanipulation, Examensfrage, Akademie von Tolaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98743&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8df66bac-cbe1-4ee0-ac5b-06e625ff02e8\', \'multiverseId\': 98743}, \'multiverseid\': 98743}, {\'name\': \'Perito temporal\', \'text\': \'{U}{U}{U}, {T}: Regresa el permanente objetivo a la mano de su propietario.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Si ayer fue hace dos días mañana, ¿el día después de mañana será hoy o ayer?" —Examen final de Fundamentos de la manipulación temporal, Academia tolariana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100183&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7936845-046b-4485-b8e6-17d5b7ec9d6e\', \'multiverseId\': 100183}, \'multiverseid\': 100183}, {\'name\': \'Expert en temporalité\', \'text\': \'{U}{U}{U}, {T} : Renvoyez le permanent ciblé dans la main de son propriétaire.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Si hier était deux jours plus tôt demain, après-demain sera-t-il aujourd\'hui ou hier ? » —Examen final de Manipulation temporelle 101, Académie tolariane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98383&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8fad884-8b46-47e7-acc4-758e2bffc040\', \'multiverseId\': 98383}, \'multiverseid\': 98383}, {\'name\': \'Cronomante\', \'text\': \'{U}{U}{U}, {T}: Il proprietario riprende in mano un permanente bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Se ieri era due giorni fa domani, dopodomani sarà oggi o ieri?" —Manipolazioni temporali 101, esame finale Accademia di Tolaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99103&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97d75b88-f4d8-4278-aeb5-1d31d9f67ff2\', \'multiverseId\': 99103}, \'multiverseid\': 99103}, {\'name\': \'時間の名人\', \'text\': \'{U}{U}{U}, {T}： パーマネント１つを対象とし、それをオーナーの手札に戻す。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'昨日が明日の二日前である場合、明日の次の日は今日であるか昨日であるか？ ――トレイリアのアカデミーにおける 時間操作入門クラス最終試験\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99463&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'687e096a-29a7-48b7-a8ba-786c0afa9f7e\', \'multiverseId\': 99463}, \'multiverseid\': 99463}, {\'name\': \'Adepto Temporal\', \'text\': \'{U}{U}{U}, {T}: Devolve a permanente alvo para a mão de seu dono.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'"Se ontem foi a dois dias atrás de amanhã, o dia depois de amanhã será hoje ou ontem?" — Prova final de Manipulação Temporal 101, Academia Tolariana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99823&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b965c0c0-b380-4e0b-a11c-194ba4ab5efa\', \'multiverseId\': 99823}, \'multiverseid\': 99823}, {\'name\': \'Служитель времени\', \'text\': \'{U}{U}{U}, {T}: Верните целевой перманент в руку владельца.\', \'type\': \'Существо — Человек Мудрец\', \'flavor\': \'"Если вчера уже прошло два дня после завтра, послезавтра будет сегодня или вчера?" — 101 выпускной экзамен по Управлению временем, Толарийская академия\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110094&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57088660-f292-4d74-8ce5-5ecac9773a8b\', \'multiverseId\': 110094}, \'multiverseid\': 110094}, {\'name\': \'时间专家\', \'text\': \'{U}{U}{U}，{T}：将目标永久物移回其拥有者手上。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「如果昨天到了明天会变成两天前，试问后天应该是今天或是昨天？」 ～时间操纵绪论期末考， 陶拉里亚大学院\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98023&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cf14b543-539d-4340-96a7-8b44584b1418\', \'multiverseId\': 98023}, \'multiverseid\': 98023}]', '[{\'name\': \'Zersplittern\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98709&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eb71f14e-fd87-4c7d-a6f0-5b338e8cd875\', \'multiverseId\': 98709}, \'multiverseid\': 98709}, {\'name\': \'Romper\', \'text\': \'Destruye el artefacto objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100149&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c6974349-88ed-4f9b-a5c8-980d6faea6b9\', \'multiverseId\': 100149}, \'multiverseid\': 100149}, {\'name\': \'Fracasser\', \'text\': "Détruisez l\'artefact ciblé.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98349&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2747f0c-7772-4838-b4e5-31e2c70035fb\', \'multiverseId\': 98349}, \'multiverseid\': 98349}, {\'name\': \'Distruggi Artefatto\', \'text\': \'Distruggi un artefatto bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99069&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'957be4c9-082f-40e0-a631-9acdbc951b02\', \'multiverseId\': 99069}, \'multiverseid\': 99069}, {\'name\': \'粉砕\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99429&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d2c360d-06f3-48f2-bef2-38bd001f9ca4\', \'multiverseId\': 99429}, \'multiverseid\': 99429}, {\'name\': \'Estilhaçar\', \'text\': \'Destrói o artefato alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99789&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8d93957b-5672-44fe-b389-30e904d22972\', \'multiverseId\': 99789}, \'multiverseid\': 99789}, {\'name\': \'Раскол\', \'text\': \'Уничтожьте целевой артефакт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110060&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1516644c-3957-4254-8e2e-6096da728d3d\', \'multiverseId\': 110060}, \'multiverseid\': 110060}, {\'name\': \'粉碎\', \'text\': \'消灭目标神器。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97989&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05979862-1124-4911-8269-c6f68005d8d9\', \'multiverseId\': 97989}, \'multiverseid\': 97989}]', "[{'name': 'Zodiakaffe', 'text': 'Waldtarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler einen Wald kontrolliert.)', 'type': 'Kreatur — Menschenaffe', 'flavor': 'Er ernährt sich von Früchten, Blättern und gelegentlich einer Nase.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98794&type=card', 'language': 'German', 'identifiers': {'scryfallId': '63eed334-d5b1-464e-b9a8-96ac18e40a2e', 'multiverseId': 98794}, 'multiverseid': 98794}, {'name': 'Mono del zodíaco', 'text': 'Cruza bosques. (Esta criatura es imbloqueable mientras el jugador defensor controle un bosque.)', 'type': 'Criatura — Simio', 'flavor': 'Se alimenta principalmente de frutas, hojas, y alguna que otra nariz.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100234&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '96437954-913a-4913-a94a-4a47d5763d53', 'multiverseId': 100234}, 'multiverseid': 100234}, {'name': 'Singe du zodiaque', 'text': 'Traversée des forêts (Cette créature est imblocable tant que le joueur défenseur contrôle au moins une forêt.)', 'type': 'Créature : grand singe', 'flavor': 'Il se nourrit de fruits, de feuilles et parfois de nez.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98434&type=card', 'language': 'French', 'identifiers': {'scryfallId': '684c8728-19e9-4422-9e28-36b7aaa209d7', 'multiverseId': 98434}, 'multiverseid': 98434}, {'name': 'Scimmia dello Zodiaco', 'text': 'Passa-foreste (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla almeno una Foresta.)', 'type': 'Creatura — Scimpanzé', 'flavor': 'Si nutre principalmente di frutta, foglie e qualche naso.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99154&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5efe2aa1-d0bb-4819-9f56-a9317f6e466c', 'multiverseId': 99154}, 'multiverseid': 99154}, {'name': '黄道の猿', 'text': '森渡り （このクリーチャーは防御プレイヤーが森をコントロールしている限りブロックされない。）', 'type': 'クリーチャー — 類人猿', 'flavor': 'そいつの主食は果物や葉、ときとして鼻。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99514&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '608e3dfe-b329-4cf8-8791-cb46e7b8c925', 'multiverseId': 99514}, 'multiverseid': 99514}, {'name': 'Macaco do Zodíaco', 'text': 'Travessia de Floresta (Esta criatura não pode ser bloqueada desde que o jogador defensor controle uma Floresta.)', 'type': 'Criatura — Símio', 'flavor': 'Ele se alimenta principalmente de frutas, folhas e um ou outro nariz.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99874&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '452a1129-5a4e-4f9f-b10d-2fdd8640148e', 'multiverseId': 99874}, 'multiverseid': 99874}, {'name': 'Зодиакальная обезьяна', 'text': 'Знание лесов (Это существо невозможно заблокировать, пока обороняющийся игрок контролирует Лес).', 'type': 'Существо — Обезьяна', 'flavor': 'Питается она в основном фруктами и листьями. Если ей попадется чей-нибудь нос, она не прочь полакомиться и носом.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110145&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5376787b-1b05-4177-9dca-0448b07d7b0b', 'multiverseId': 110145}, 'multiverseid': 110145}, {'name': '十二生肖‧猴', 'text': '树林行者（只要防御牌手操控树林，此生物便不能被阻挡）', 'type': '生物～猿猴', 'flavor': '通常以水果与树叶为食，偶尔也尝尝鼻子。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98074&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'de9327a2-0b93-496d-834c-569a7c393f69', 'multiverseId': 98074}, 'multiverseid': 98074}]", '[{\'name\': \'Zombifizierung\', \'text\': \'Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Hexerei\', \'flavor\': \'„Die erste Geburt feiert das Leben. Die zweite Geburt verhöhnt es." —Älterer Mystiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9b87a51-235b-4c7f-8772-3e135a8fbd57\', \'multiverseId\': 98795}, \'multiverseid\': 98795}, {\'name\': \'Zombificar\', \'text\': \'Regresa la carta de criatura objetivo de tu cementerio al juego.\', \'type\': \'Conjuro\', \'flavor\': \'"El primer nacimiento celebra la vida. El segundo nacimiento se burla de ella." —Anciano místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'331b4e43-b542-43ac-97b3-03b89823f1cf\', \'multiverseId\': 100235}, \'multiverseid\': 100235}, {\'name\': \'Zombification\', \'text\': \'Renvoyez en jeu la carte de créature ciblée de votre cimetière.\', \'type\': \'Rituel\', \'flavor\': "« La première naissance célèbre la vie. La seconde s\'en moque. » —Un doyen des mystiques", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98435&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5fb5a91c-d805-49aa-a515-b638ed487fc6\', \'multiverseId\': 98435}, \'multiverseid\': 98435}, {\'name\': \'Zombificare\', \'text\': \'Rimetti in gioco una carta creatura bersaglio dal tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"La prima nascita celebra la vita. La seconda la sbeffeggia." —Anziano mistico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99155&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7fd85491-94cb-48ce-9ba0-b9cc4e2bd242\', \'multiverseId\': 99155}, \'multiverseid\': 99155}, {\'name\': \'ゾンビ化\', \'text\': \'あなたの墓地にあるクリーチャー・カード１枚を対象とし、それを場に出す。\', \'type\': \'ソーサリー\', \'flavor\': \'第一の誕生は命を祝福する。 第二の誕生は命を模倣する。 ――秘教の古老\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99515&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'baa86820-392b-4f87-af90-bc9be9673be7\', \'multiverseId\': 99515}, \'multiverseid\': 99515}, {\'name\': \'Zumbificar\', \'text\': \'Devolve para o jogo o card alvo de criatura de seu cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'"O primeiro nascimento celebra a vida. O segundo nascimento zomba dela." — Ancião místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99875&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'69a582d9-4149-44f1-814d-6dd8d74ef6dd\', \'multiverseId\': 99875}, \'multiverseid\': 99875}, {\'name\': \'Зомбирование\', \'text\': \'Верните целевое существо с кладбища в игру.\', \'type\': \'Волшебство\', \'flavor\': \'"Первое рождение восхваляет жизнь. Второе рождение смеется над ней". — Старший жрец\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110146&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'087affb7-9a91-4ab7-a379-6cb4ca20760a\', \'multiverseId\': 110146}, \'multiverseid\': 110146}, {\'name\': \'灵俑化\', \'text\': \'将目标生物牌从你的坟墓场移回场上。\', \'type\': \'法术\', \'flavor\': \'「初次诞生是对生命的礼赞。 再次诞生则是对生命的嘲弄。」 ～秘教长老\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98075&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'31421a17-2d64-4493-ad22-aa9c86fd60da\', \'multiverseId\': 98075}, \'multiverseid\': 98075}]', "[{'name': 'Zorn Gottes', 'text': 'Zerstöre alle Kreaturen. Sie können nicht regeneriert werden.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98788&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bd77be57-22ce-4604-a68f-349aef713802', 'multiverseId': 98788}, 'multiverseid': 98788}, {'name': 'Ira de Dios', 'text': 'Destruye todas las criaturas. No pueden ser regeneradas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100228&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c5d6154e-1e82-4824-8b0b-0286d2f590ce', 'multiverseId': 100228}, 'multiverseid': 100228}, {'name': 'Colère de Dieu', 'text': 'Détruisez toutes les créatures. Elles ne peuvent pas être régénérées.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98428&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bc7f60ae-c643-413b-b403-b29e71e04406', 'multiverseId': 98428}, 'multiverseid': 98428}, {'name': 'Ira di Dio', 'text': 'Distruggi tutte le creature. Non possono essere rigenerate.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99148&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a4dcb966-8bb8-495d-8f92-950e3fbcb2a0', 'multiverseId': 99148}, 'multiverseid': 99148}, {'name': '神の怒り', 'text': 'すべてのクリーチャーを破壊する。 それらは再生できない。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99508&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4e41e0ba-93b6-46ee-bf8f-aa926f761521', 'multiverseId': 99508}, 'multiverseid': 99508}, {'name': 'Cólera de Deus', 'text': 'Destrói todas as criaturas. Elas não podem ser regeneradas.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99868&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1c04ed3a-4d3d-4b1a-b0a6-fae67d48843b', 'multiverseId': 99868}, 'multiverseid': 99868}, {'name': 'Гнев божий', 'text': 'Уничтожьте все существа. Они не могут быть регенерированы.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110139&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '86117e3f-0aae-443d-a71e-d35b821106d0', 'multiverseId': 110139}, 'multiverseid': 110139}, {'name': '神之愤怒', 'text': '消灭所有生物。 它们不能重生。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98068&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '821ce8c3-20cc-4e4c-8840-378e09e440ef', 'multiverseId': 98068}, 'multiverseid': 98068}]", '[{\'name\': \'Zurs bizarre Welt\', \'text\': \'Alle Spieler spielen mit offenen Karten.\\nFalls ein Spieler eine Karte ziehen würde, zeigt er sie stattdessen offen vor. Dann kann jeder andere Spieler 2 Lebenspunkte bezahlen. Falls ein Spieler dies tut, lege die Karte auf den Friedhof ihres Besitzers. Sonst zieht dieser Spieler die Karte.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98796&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2e278f9-aa36-418c-8659-4f53636df22a\', \'multiverseId\': 98796}, \'multiverseid\': 98796}, {\'name\': \'Presagio de Zur\', \'text\': \'Los jugadores juegan mostrando sus manos.\\nSi un jugador fuera a robar una carta, en vez de eso, la muestra. Luego cualquier otro jugador puede pagar 2 vidas. Si algún jugador lo hace, pon esa carta en el cementerio de su propietario. De lo contrario, el jugador roba la carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100236&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f645cdc-3956-4069-8008-0a937d99bec3\', \'multiverseId\': 100236}, \'multiverseid\': 100236}, {\'name\': \'Déterminisme selon Zur\', \'text\': "Les joueurs jouent avec leurs mains révélées.\\nSi un joueur devait piocher une carte, il la révèle à la place. N\'importe quel autre joueur peut ensuite payer 2 points de vie. Si c\'est le cas, mettez cette carte dans le cimetière de son propriétaire. Sinon, ce joueur pioche la carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98436&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9425cea3-1e82-46f5-af33-846563b84f91\', \'multiverseId\': 98436}, \'multiverseid\': 98436}, {\'name\': \'Malia di Zur\', \'text\': \'I giocatori giocano a carte scoperte.\\nSe un giocatore sta per pescare una carta, invece la rivela. Poi ogni altro giocatore può pagare 2 punti vita. Se un giocatore paga, metti quella carta nel cimitero del suo proprietario. Altrimenti, quel giocatore pesca la carta.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99156&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'114a19ea-d155-4c72-94a1-7e6aba5bec22\', \'multiverseId\': 99156}, \'multiverseid\': 99156}, {\'name\': \'ズアーの運命支配\', \'text\': \'プレイヤーは手札を公開したままプレイする。\\nいずれかのプレイヤーがカードを１枚引く場合、代わりにそのプレイヤーはそれを公開する。 その後、他のいずれかのプレイヤーは２点のライフを支払ってもよい。 いずれかのプレイヤーがそうした場合、そのカードをオーナーの墓地に置く。 そうでない場合、そのプレイヤーはそのカードを引く。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99516&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02d31d02-3470-4309-88df-140966ebdc21\', \'multiverseId\': 99516}, \'multiverseid\': 99516}, {\'name\': \'Fatalidade de Zur\', \'text\': \'Os jogadores jogam com os cards de suas mãos revelados.\\nSe um jogador fosse comprar um card, ele próprio o revela em vez disso. Depois, qualquer outro jogador pode pagar 2 pontos de vida. Se um jogador o fizer, coloque aquele card no cemitério de seu dono. Se não, aquele jogador compra o card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'18230a0d-ce79-47d5-bf5b-ab5995b3579f\', \'multiverseId\': 99876}, \'multiverseid\': 99876}, {\'name\': \'Предопределение Зура\', \'text\': \'Игроки играют с открытыми руками.\\nЕсли игрок берет карту, он открывает ее. Затем любой из игроков может заплатить 2 пункта жизни. Если он это делает, карта помещается на кладбище владельца. В противном случае игрок берет эту карту.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110147&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9c7f20c2-cfaa-4b5b-bec1-76f9d46bd620\', \'multiverseId\': 110147}, \'multiverseid\': 110147}, {\'name\': \'祖尔的奥秘\', \'text\': \'牌手以展示手牌的方式进行游戏。\\n如果任何牌手将要抓一张牌，则他改为展示该牌。 然后其它任何牌手可以支付2点生命。 若有牌手如此做，则将该牌置入其拥有者的坟墓场。 若无人支付，则该牌手抓该张牌。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98076&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'94a209cd-776e-4479-b174-f24173a4d3be\', \'multiverseId\': 98076}, \'multiverseid\': 98076}]', '[{\'name\': \'Zurückdrehen\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl und enttappe dann bis zu vier Länder.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Lass uns das noch einmal durchgehen..."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98680&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'16422cdb-ead7-4063-99f9-39d52f194071\', \'multiverseId\': 98680}, \'multiverseid\': 98680}, {\'name\': \'Retroceder\', \'text\': \'Contrarresta el hechizo objetivo, luego endereza hasta cuatro tierras.\', \'type\': \'Instantáneo\', \'flavor\': \'"Repasemos esto una vez más . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100120&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c9fede7-0a83-4771-b5b7-da2041ac229a\', \'multiverseId\': 100120}, \'multiverseid\': 100120}, {\'name\': \'Rembobinage\', \'text\': "Contrecarrez le sort ciblé, et dégagez ensuite jusqu\'à quatre terrains.", \'type\': \'Éphémère\', \'flavor\': \'« Encore une fois . . . »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98320&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b9caf9e-6a06-467c-9e1a-af20e1f6619e\', \'multiverseId\': 98320}, \'multiverseid\': 98320}, {\'name\': \'Rifare\', \'text\': \'Neutralizza una magia bersaglio, poi STAPpa fino a quattro terre.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ripetiamolo ancora una volta. . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99040&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0a348f5-a1e2-4ce1-874d-670cd267f563\', \'multiverseId\': 99040}, \'multiverseid\': 99040}, {\'name\': \'巻き直し\', \'text\': \'呪文１つを対象とし、それを打ち消す。その後、土地を最大４つまでアンタップする。\', \'type\': \'インスタント\', \'flavor\': \'もう一度やろうか … … 。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99400&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fbbd066c-e216-4602-ae7b-a58b6c099568\', \'multiverseId\': 99400}, \'multiverseid\': 99400}, {\'name\': \'Retroceder\', \'text\': \'Anula a mágica alvo e depois desvira até quatro terrenos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Vamos recapitular mais uma vez. . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c1539c77-390a-4687-b851-a27b7f5a0ef8\', \'multiverseId\': 99760}, \'multiverseid\': 99760}, {\'name\': \'Перемотка\', \'text\': \'Прервите целевое заклинание и разверните до четырех земель.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Давайте пройдем это еще раз . . ."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110031&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'df3cf561-f371-4862-a730-88c3533a2850\', \'multiverseId\': 110031}, \'multiverseid\': 110031}, {\'name\': \'倒退\', \'text\': \'反击目标咒语，然后重置至多四个地。\', \'type\': \'瞬间\', \'flavor\': \'「那我们再重新来过吧. . . .」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97960&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'364a81c5-e310-4d9b-905d-49ddb16f2c38\', \'multiverseId\': 97960}, \'multiverseid\': 97960}]', '[{\'name\': \'Zurückerinnern\', \'text\': \'Ein Spieler deiner Wahl mischt seinen Friedhof in seine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Es reicht schon, die Tür zur Vergangenheit nur ein klein wenig offen zu lassen, damit sie ganz aus ihren Angeln gehoben werden kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98677&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e47ea06-9dfb-4200-bbe5-bd32cfb1f6b7\', \'multiverseId\': 98677}, \'multiverseid\': 98677}, {\'name\': \'Rememorar\', \'text\': \'El jugador objetivo baraja su cementerio en su biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Si dejas la puerta al pasado aunque sea un poquito entreabierta, podrían arrancarla de sus goznes\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100117&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f704a7fd-9b64-421e-bd35-2456061920dc\', \'multiverseId\': 100117}, \'multiverseid\': 100117}, {\'name\': \'Réminiscence\', \'text\': \'Le joueur ciblé mélange son cimetière à sa bibliothèque.\', \'type\': \'Rituel\', \'flavor\': "« Si vous laissez la porte du passé entr\'ouverte, elle ne demandera qu\'à s\'ouvrir. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98317&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf33a654-4a4a-4d39-af1e-77f6378a5de8\', \'multiverseId\': 98317}, \'multiverseid\': 98317}, {\'name\': \'Reminiscenza\', \'text\': \'Il giocatore bersaglio rimescola il proprio cimitero nel proprio grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'Lascia uno spiraglio, anche minuscolo, nella porta sul passato e questa potrà essere scardinata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99037&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fdb69cd9-9d82-46e5-8d0c-0acd154de4ff\', \'multiverseId\': 99037}, \'multiverseid\': 99037}, {\'name\': \'追憶\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは自分のライブラリーに自分の墓地を加えて切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'過去への扉が少しでも開いていれば、過去がその蝶番を吹き飛ばしてしまう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99397&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1fb8f7c4-eb26-45c3-b0c2-7684ddaa56fb\', \'multiverseId\': 99397}, \'multiverseid\': 99397}, {\'name\': \'Entregar-se a Reminescências\', \'text\': \'O jogador alvo embaralha seu próprio cemitério em seu próprio grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Deixe a porta para o passado levemente entreaberta e ela poderá ser arrancada de suas dobradiças.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99757&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5c11c1c-0f7b-4a77-bf95-c3db29dec126\', \'multiverseId\': 99757}, \'multiverseid\': 99757}, {\'name\': \'Воспоминания\', \'text\': \'Целевой игрок перемещает карты с кладбища в библиотеку и тасует ее.\', \'type\': \'Волшебство\', \'flavor\': \'Если оставить дверь в прошлое приоткрытой, ее может снести с петель.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110028&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a59e1709-1b57-4728-8797-34ffeb7fc4f5\', \'multiverseId\': 110028}, \'multiverseid\': 110028}, {\'name\': \'追忆过往\', \'text\': \'目标牌手将其坟墓场洗回牌库。\', \'type\': \'法术\', \'flavor\': \'就算只替往事留个小门缝，泉涌的回忆也可能让门招架不住。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97957&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0819c9b0-0fde-4fe0-8e90-feb06e6a27df\', \'multiverseId\': 97957}, \'multiverseid\': 97957}]', '[{\'name\': \'Zwangsabgabe\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Bestimme eine Karte davon. Dieser Spieler wirft diese Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Von allem, was ich verloren habe, vermisse ich mein Gehirn am meisten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98482&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42aa68da-357f-49a0-ba24-008d7a71d4f5\', \'multiverseId\': 98482}, \'multiverseid\': 98482}, {\'name\': \'Coerción\', \'text\': \'El oponente objetivo muestra su mano. Elige una carta de ahí. Ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'"De todo lo que perdí, lo que más extraño es mi mente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99922&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a4752508-4d1f-4ccb-a49f-54c0d7462e8f\', \'multiverseId\': 99922}, \'multiverseid\': 99922}, {\'name\': \'Coercition\', \'text\': "L\'adversaire ciblé révèle sa main. Choisissez-y une carte. Ce joueur se défausse de cette carte.", \'type\': \'Rituel\', \'flavor\': "« De tout ce que j\'ai perdu, c\'est mon esprit qui me manque le plus. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98122&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d97414f-8f20-4c49-9d72-5e965d56b897\', \'multiverseId\': 98122}, \'multiverseid\': 98122}, {\'name\': \'Coercizione\', \'text\': "L\'avversario bersaglio rivela la propria mano. Scegli una carta da essa. Quel giocatore scarta quella carta.", \'type\': \'Stregoneria\', \'flavor\': \'"Di tutto ciò che ho perduto, la cosa che rimpiango di più è il mio senno."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98842&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6448decd-e8f7-4083-b001-8fa7eb54d613\', \'multiverseId\': 98842}, \'multiverseid\': 98842}, {\'name\': \'強要\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。 その中の１枚を選ぶ。 そのプレイヤーはそのカードを捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'失ってきた物の中じゃ、記憶が一番辛いな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99202&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64cf92e3-b5f9-4ddd-8641-a5af03cfb021\', \'multiverseId\': 99202}, \'multiverseid\': 99202}, {\'name\': \'Coerção\', \'text\': \'O oponente alvo revela sua própria mão. Escolha um card dela. Aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'"De tudo o que perdi, é de minha mente que mais sinto falta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99562&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9591e61-dfcb-4374-adf1-d196a0b5f132\', \'multiverseId\': 99562}, \'multiverseid\': 99562}, {\'name\': \'Принуждение\', \'text\': \'Целевой оппонент открывает руку. Выберите карту из руки оппонента. Целевой игрок сбрасывает эту карту.\', \'type\': \'Волшебство\', \'flavor\': \'"Из всего, что я потерял, больше всего мне не хватает разума".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109833&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1bd5c971-830a-4dee-804c-0936e00930d9\', \'multiverseId\': 109833}, \'multiverseid\': 109833}, {\'name\': \'威迫\', \'text\': \'目标对手展示其手牌。 选择其中一张牌， 该牌手弃掉该牌。\', \'type\': \'法术\', \'flavor\': \'「在所失去的东西里头，我最怀念的就是自己的心智。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97762&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c99786a7-6ce9-4731-80ff-ec49b6814606\', \'multiverseId\': 97762}, \'multiverseid\': 97762}]', '[{\'name\': \'Zwiespaltsszepter\', \'text\': \'{3}, {T}: Ein Spieler deiner Wahl wirft eine Karte aus seiner Hand ab. Spiele diese Fähigkeit nur während deines Zuges.\', \'type\': \'Artefakt\', \'flavor\': \'„Wahre Macht ist, wenn du nicht nur die Herzen deiner Opfer, sondern auch ihre Gedanken kontrollierst."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b706f502-c70e-48c2-8ba4-534892917a36\', \'multiverseId\': 98505}, \'multiverseid\': 98505}, {\'name\': \'Cetro disruptor\', \'text\': \'{3}, {T}: El jugador objetivo descarta una carta. Juega esta habilidad sólo durante tu turno.\', \'type\': \'Artefacto\', \'flavor\': \'"El poder verdadero es controlar no sólo los corazones de tus súbditos, sino también sus mentes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99945&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c35e062c-3e05-4c84-8285-8422ac0ad4f5\', \'multiverseId\': 99945}, \'multiverseid\': 99945}, {\'name\': \'Sceptre de dislocation\', \'text\': "{3}, {T} : Le joueur ciblé se défausse d\'une carte. Ne jouez cette capacité que pendant votre tour.", \'type\': \'Artefact\', \'flavor\': "« Être véritablement puissant, c\'est contrôler le cœur de ses sujets, mais aussi leurs esprits. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98145&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'03f62e4e-2dbf-4c66-8c11-489c00ee67c1\', \'multiverseId\': 98145}, \'multiverseid\': 98145}, {\'name\': \'Scettro Devastante\', \'text\': \'{3}, {T}: Il giocatore bersaglio scarta una carta. Gioca questa abilità solo durante il tuo turno.\', \'type\': \'Artefatto\', \'flavor\': \'"Il vero potere è controllare non solo i cuori dei tuoi sottoposti, ma anche le loro menti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98865&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a05e92bf-f669-489a-9ab3-d6cc16e4ea63\', \'multiverseId\': 98865}, \'multiverseid\': 98865}, {\'name\': \'破裂の王笏\', \'text\': \'{3}, {T}：プレイヤー１人を対象とする。そのプレイヤーはカードを１枚捨てる。 この能力は、あなたのターンにのみプレイできる。\', \'type\': \'アーティファクト\', \'flavor\': \'真の力というものは、人々の関心ばかりでなく、その精神をも操るのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99225&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43499553-b6a2-4fef-a680-66312acb6bef\', \'multiverseId\': 99225}, \'multiverseid\': 99225}, {\'name\': \'Cetro Desintegrador\', \'text\': \'{3}, {T}: O jogador alvo descarta um card. Use esta habilidade apenas durante o seu próprio turno.\', \'type\': \'Artefato\', \'flavor\': \'"O verdadeiro poder reside não apenas no controle dos corações de seus súditos, mas também de suas mentes."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99585&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1bae1182-0b33-4aad-a650-5fb08ac72825\', \'multiverseId\': 99585}, \'multiverseid\': 99585}, {\'name\': \'Разрушающий скипетр\', \'text\': \'{3}, {T}: Целевой игрок сбрасывает карту. Вы можете разыграть эту способность только во время своего хода.\', \'type\': \'Артефакт\', \'flavor\': \'"Истинная власть состоит в том, чтобы править не только сердцами подданных, но и их умами".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109856&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2973187b-db96-40e5-8a85-03cc7e181025\', \'multiverseId\': 109856}, \'multiverseid\': 109856}, {\'name\': \'扰乱权杖\', \'text\': \'{3}，{T}：目标牌手弃一张牌。 你只可以于你的回合中使用此异能。\', \'type\': \'神器\', \'flavor\': \'「真正的权力不只是控制你臣民的心灵，还要控制他们的理智。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97785&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71eb7258-5fd4-4ae8-9081-20547ffc94e3\', \'multiverseId\': 97785}, \'multiverseid\': 97785}]', '[{\'name\': \'Züchtigen\', \'text\': \'Zerstöre eine angreifende Kreatur deiner Wahl. Du erhältst Lebenspunkte in Höhe ihrer Stärke dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Warum beten wir zu der Ahnfrau? Weil Sie uns zuhört." —Älterer Mystiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98477&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'077f6fcf-9cd9-4501-a0e6-1d9e4d623555\', \'multiverseId\': 98477}, \'multiverseid\': 98477}, {\'name\': \'Reprender\', \'text\': \'Destruye la criatura atacante objetivo. Ganas una cantidad de vida igual a su fuerza.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Por qué le rezamos a la Antepasada? Porque Ella escucha." —Anciano místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99917&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c01a009a-ccf9-445f-a078-583c878ab85e\', \'multiverseId\': 99917}, \'multiverseid\': 99917}, {\'name\': \'Punition\', \'text\': \'Détruisez la créature attaquante ciblée. Vous gagnez autant de points de vie que sa force.\', \'type\': \'Éphémère\', \'flavor\': "« Pourquoi prions-nous l\'Ancêtre ? Parce qu\'Elle écoute. » —Un doyen des mystiques", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98117&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a487fe2-96e0-4a4a-8254-a813620ad0f6\', \'multiverseId\': 98117}, \'multiverseid\': 98117}, {\'name\': \'Castigare\', \'text\': \'Distruggi una creatura attaccante bersaglio. Guadagni un ammontare di punti vita pari alla sua forza.\', \'type\': \'Istantaneo\', \'flavor\': \'"Perché preghiamo l\\\'Antenata? Perché ci ascolta." —Anziano mistico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98837&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5450720e-3ba5-444c-99ba-40948fb06f87\', \'multiverseId\': 98837}, \'multiverseid\': 98837}, {\'name\': \'懲罰\', \'text\': \'攻撃クリーチャー１体を対象とし、それを破壊する。 あなたはそのクリーチャーのパワーに等しい値のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'何故に祖神様に祈るのか？ それは聞きとめてくださるからだ。 ――秘教の古老\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99197&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d87334e-5d34-4344-9ac6-1aeed88d312e\', \'multiverseId\': 99197}, \'multiverseid\': 99197}, {\'name\': \'Castigar\', \'text\': \'Destrói a criatura alvo atacante. Você ganha uma quantidade de pontos de vida igual ao poder dela.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Por que rezamos para a Ancestral? Porque Ela escuta." — Ancião místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99557&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'32f4ccbc-c482-4bf8-ae4f-10b7f48c8d54\', \'multiverseId\': 99557}, \'multiverseid\': 99557}, {\'name\': \'Кара\', \'text\': \'Уничтожьте целевое нападающее существо. Вы получаете число пунктов жизни, равное его силе.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Почему мы молимся Предку? Потому что Он слушает нас". — Старший жрец\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109828&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'12697cde-1523-4f14-aeaa-403a9d120c1f\', \'multiverseId\': 109828}, \'multiverseid\': 109828}, {\'name\': \'惩戒\', \'text\': \'消灭目标进行攻击的生物。 你获得等同于其力量的生命。\', \'type\': \'瞬间\', \'flavor\': \'「为何要向圣祖灵祷告？ 因为她必细心聆听。」 ～秘教长老\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97757&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'763abfcd-4608-4ccb-9806-b40bcce64ded\', \'multiverseId\': 97757}, \'multiverseid\': 97757}]', "[{'name': 'Übermäßiges Wachstum', 'text': 'Landverzauberung (Bestimme ein Land als Ziel, sowie du diese Karte spielst. Diese Karte kommt an das Land angelegt ins Spiel.)\\nImmer wenn das verzauberte Land für Mana getappt wird, erhöht sein Beherrscher seinen Manavorrat zusätzlich um {G}{G}.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98645&type=card', 'language': 'German', 'identifiers': {'scryfallId': '232344de-dec5-4e93-8668-b22c080c81ef', 'multiverseId': 98645}, 'multiverseid': 98645}, {'name': 'Crecimiento desmedido', 'text': 'Encantar tierra. (Haz objetivo a una tierra al jugarlo. Esta carta entra en juego anexada a esa tierra.)\\nSiempre que la tierra encantada se gire para obtener maná, su controlador agrega {G}{G} a su reserva de maná.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100085&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '32b43813-94e7-44de-8896-a9263d366a4a', 'multiverseId': 100085}, 'multiverseid': 100085}, {'name': 'Luxuriance', 'text': 'Enchanter : terrain (Ciblez un terrain au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à ce terrain.)\\nÀ chaque fois que le terrain enchanté est engagé pour du mana, son contrôleur ajoute {G}{G} à sa réserve.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98285&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7f207b5e-087a-4a86-a0f3-875c0088bbb3', 'multiverseId': 98285}, 'multiverseid': 98285}, {'name': 'Vegetazione Rigogliosa', 'text': 'Incanta terra (Scegli come bersaglio una terra mentre giochi questa magia. Questa carta entra in gioco assegnata a quella terra.)\\nOgniqualvolta la terra incantata viene TAPpata per attingere mana, il suo controllore aggiunge {G}{G} alla propria riserva.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99005&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a624bdc8-1e24-4e81-abaf-b35fb74afa68', 'multiverseId': 99005}, 'multiverseid': 99005}, {'name': 'はびこり', 'text': 'エンチャント（土地） （これをプレイする際に、土地１つを対象とする。 このカードはその土地につけられている状態で場に出る。）\\nエンチャントされている土地がマナを引き出す目的でタップされるたび、それのコントローラーは自分のマナ・プールに{G}{G}を加える。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99365&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2600232f-7dfe-4745-8554-6a82df052618', 'multiverseId': 99365}, 'multiverseid': 99365}, {'name': 'Vegetação Exuberante', 'text': 'Encantar terreno (Vise um terreno conforme jogar este card. Este card entra em jogo anexado àquele terreno.)\\nToda vez que o terreno encantado for virado para gerar mana, seu controlador adiciona {G}{G} à sua própria reserva de mana.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99725&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '612748e4-c433-4ba3-8cb5-2ec84b17c2c6', 'multiverseId': 99725}, 'multiverseid': 99725}, {'name': 'Избыточный рост', 'text': 'Зачаровать землю (Когда вы разыгрываете эту карту, целью является земля. Карта вступает в игру вместе с этой землей).\\nКаждый раз, когда зачарованная земля поворачивается и платится мана, контролирующий ее игрок добавляет {G}{G} в запас маны.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109996&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '83055622-5d66-4890-b7d4-fe67312ce143', 'multiverseId': 109996}, 'multiverseid': 109996}, {'name': '过度生长', 'text': '地结界（于使用时指定一个地为目标。 此牌进场时结附在该地上）\\n每当受此结界的地横置以产生法术力时，其操控者加{G}{G}到他的法术力池中。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97925&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eefaf2be-ec32-4847-8c06-98dc106a4bed', 'multiverseId': 97925}, 'multiverseid': 97925}]"]
