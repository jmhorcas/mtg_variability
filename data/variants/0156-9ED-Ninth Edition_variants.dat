': {'scryfallId': '0dfaeef8-65cc-4b05-9230-2ee10bc67f14', 'multiverseId': 99382}, 'multiverseid': 99382}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99742&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e0511de9-1358-4013-b04b-2546fea4cf47', 'multiverseId': 99742}, 'multiverseid': 99742}, {'name': 'Равнины', 'type': 'Базовая земля — Равнины', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110013&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3d809d79-9149-4650-89b7-23fe05051d27', 'multiverseId': 110013}, 'multiverseid': 110013}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97942&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7e90b638-c4c2-4efa-b15b-335247fe188f', 'multiverseId': 97942}, 'multiverseid': 97942}]", '[{\'name\': \'Ehrengarde\', \'text\': \'{W}: Die Ehrengarde erhält +0/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Die Stärke von einem, den Mut von zehn.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98574&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d80fe65b-93c6-4bf8-ae64-88ff5700de91\', \'multiverseId\': 98574}, \'multiverseid\': 98574}, {\'name\': \'Guardia de honor\', \'text\': \'{W}: El Guardia de honor obtiene +0/+1 hasta el final del turno.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'La fuerza de uno. El valor de diez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100014&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6da63d81-fd88-429d-ac51-d3b976334c3b\', \'multiverseId\': 100014}, \'multiverseid\': 100014}, {\'name\': "Garde d\'honneur", \'text\': "{W} : La Garde d\'honneur gagne +0/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et soldat\', \'flavor\': "La force d\'un. Le courage de dix.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98214&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eb27768a-5347-4a67-9498-042f1f6ba028\', \'multiverseId\': 98214}, \'multiverseid\': 98214}, {\'name\': "Guardia d\'Onore", \'text\': "{W}: La Guardia d\'Onore prende +0/+1 fino alla fine del turno.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'La forza di uno. Il coraggio di dieci.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98934&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'93e6f790-afd4-4f05-a6c3-f98758a884ab\', \'multiverseId\': 98934}, \'multiverseid\': 98934}, {\'name\': \'儀仗兵\', \'text\': \'{W}：儀仗兵はターン終了時まで+0/+1の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'一人の力は 十人の勇気。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99294&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10b5dcb6-82f5-4145-89b4-419e3120954c\', \'multiverseId\': 99294}, \'multiverseid\': 99294}, {\'name\': \'Guarda de Honra\', \'text\': \'{W}: Guarda de Honra recebe +0/+1 até o final do turno.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'A força de um. A coragem de dez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99654&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f77d2ef7-f4a8-42f0-a1f9-4404a4ebf4fc\', \'multiverseId\': 99654}, \'multiverseid\': 99654}, {\'name\': \'Почетный караул\', \'text\': \'{W}: Почетный караул получает +0/+1 до конца хода.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Сила одного. Храбрость десяти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109925&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0e5df4b9-78d5-4813-8fc8-d20ddff04312\', \'multiverseId\': 109925}, \'multiverseid\': 109925}, {\'name\': \'仪队兵\', \'text\': \'{W}：仪队兵得+0/+1直到回合结束。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'一分力量， 十分勇气。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97854&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'11166472-3187-4565-b360-938d43ddb33e\', \'multiverseId\': 97854}, \'multiverseid\': 97854}]', '[{\'name\': \'Ehrwürdiger Mönch\', \'text\': \'Wenn der Ehrwürdige Mönch ins Spiel kommt, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Mensch, Mönch, Kleriker\', \'flavor\': \'Zeit heilt Wunden, verwandelt sie aber gleichzeitig in Runzeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5ce5feeb-1bf2-41bf-9ac4-b24d4bb0508b\', \'multiverseId\': 98766}, \'multiverseid\': 98766}, {\'name\': \'Monje venerable\', \'text\': \'Cuando el Monje venerable entre en juego, gana 2 vidas.\', \'type\': \'Criatura — Clérigo monje humano\', \'flavor\': \'La edad desgasta el cuerpo pero exalta el alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100206&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6032f17e-254c-4557-9f88-3054bc356554\', \'multiverseId\': 100206}, \'multiverseid\': 100206}, {\'name\': \'Moine vénérable\', \'text\': \'Quand le Moine vénérable arrive en jeu, vous gagnez 2 points de vie.\', \'type\': \'Créature : humain et moine et clerc\', \'flavor\': "L\'âge use la chair, mais renforce l\'âme.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98406&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8494f9bd-4b10-4b37-b783-c5ab0bfc7b34\', \'multiverseId\': 98406}, \'multiverseid\': 98406}, {\'name\': \'Monaco Venerabile\', \'text\': \'Quando il Monaco Venerabile entra in gioco, guadagni 2 punti vita.\', \'type\': \'Creatura — Chierico Monaco Umano\', \'flavor\': "L\'età consuma la carne ma galvanizza l\'anima.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99126&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1f9b36a2-1925-4233-8b1a-833e5e92f94e\', \'multiverseId\': 99126}, \'multiverseid\': 99126}, {\'name\': \'ありがたい老修道士\', \'text\': \'ありがたい老修道士が場に出たとき、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — 人間・モンク・クレリック\', \'flavor\': \'加齢によって肉体は衰えていくが、魂は活気づいていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99486&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de00f9f7-2763-4be7-85cd-31e47fca97ba\', \'multiverseId\': 99486}, \'multiverseid\': 99486}, {\'name\': \'Monge Venerável\', \'text\': \'Quando Monge Venerável entra em jogo, você ganha 2 pontos de vida.\', \'type\': \'Criatura — Clérigo Monge Humano\', \'flavor\': \'A idade desgasta a carne mas fortalece a alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99846&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0db1fa8-f4cd-44d5-ada0-2d75f913877a\', \'multiverseId\': 99846}, \'multiverseid\': 99846}, {\'name\': \'Почтенный монах\', \'text\': \'Когда Почтенный монах вступает в игру, вы получаете 2 пункта жизни.\', \'type\': \'Существо — Человек Монах Священник\', \'flavor\': \'С годами изнашивается тело, но закаляется душа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110117&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d91ab06a-46ce-4b43-a34d-d15abc49b10c\', \'multiverseId\': 110117}, \'multiverseid\': 110117}, {\'name\': \'可敬的修行僧\', \'text\': \'当可敬的修行僧进场时，你获得2点生命。\', \'type\': \'生物～人类／修行僧／僧侣\', \'flavor\': \'岁月磨蚀肉身，却光亮了心灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98046&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d95acf4-0593-420a-a06a-969df82105f9\', \'multiverseId\': 98046}, \'multiverseid\': 98046}]', "[{'name': 'Einsammeln', 'text': 'Bleibende-Karten-Verzauberung (Bestimme eine bleibende Karte als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die bleibende Karte angelegt ins Spiel.)\\nDu kontrollierst die verzauberte bleibende Karte.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98483&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fe44e086-3c0f-4209-9e48-0e837e7877d1', 'multiverseId': 98483}, 'multiverseid': 98483}, {'name': 'Confiscar', 'text': 'Encantar permanente (Haz objetivo a un permanente al jugarlo. Esta carta entra en juego anexada a ese permanente.)\\nTú controlas el permanente encantado.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99923&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5c7c158f-452e-468b-a4db-d1ceca43f134', 'multiverseId': 99923}, 'multiverseid': 99923}, {'name': 'Confiscation', 'text': 'Enchanter : permanent (Ciblez un permanent au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à ce permanent.)\\nVous contrôlez le permanent enchanté.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98123&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a822cd5d-9e89-45ac-9e0a-06f0f1d03c4e', 'multiverseId': 98123}, 'multiverseid': 98123}, {'name': 'Confiscare', 'text': 'Incanta permanente (Scegli come bersaglio un permanente mentre giochi questa magia. Questa carta entra in gioco assegnata a quel permanente.)\\nTu controlli il permanente incantato.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98843&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e5105a2b-c64c-44b0-872f-dcae3bae46ed', 'multiverseId': 98843}, 'multiverseid': 98843}, {'name': '押収', 'text': 'エンチャント（パーマネント） （これをプレイする際に、パーマネント１つを対象とする。 このカードはそのパーマネントにつけられている状態で場に出る。）\\nあなたはエンチャントされているパーマネントをコントロールする。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99203&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd58b388a-b217-46c2-859f-e35c0a943e23', 'multiverseId': 99203}, 'multiverseid': 99203}, {'name': 'Confiscar', 'text': 'Encantar permanente (Vise uma permanente conforme jogar este card. Este card entra em jogo anexado àquela permanente.)\\nVocê controla a permanente encantada.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99563&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'deac1333-a5b4-444b-ae52-54df6770bfa3', 'multiverseId': 99563}, 'multiverseid': 99563}, {'name': 'Конфискация', 'text': 'Зачаровать перманент (Когда вы разыгрываете эту карту, целью является перманент. Карта вступает в игру вместе с этим перманентом).\\nВы контролируете зачарованный перманент.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109834&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ffd0461c-7d40-4781-8931-e159ce3af813', 'multiverseId': 109834}, 'multiverseid': 109834}, {'name': '没收', 'text': '永久物结界（于使用时指定一个永久物为目标。 此牌进场时结附在该永久物上）\\n你操控受此结界的永久物。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97763&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c4c8bad3-bd4a-46b2-9789-40b180c0f25a', 'multiverseId': 97763}, 'multiverseid': 97763}]", '[{\'name\': \'Eiskalter Manipulator\', \'text\': \'{1}, {T}: Tappe ein Artefakt, eine Kreatur oder ein Land deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'Im Feuer steckt der Funke des Chaos und der Zerstörung, der Samen des Lebens. Im Eis ist perfekte Ausgeglichenheit, perfekte Ordnung und die Stille des Todes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98580&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bda1114f-882e-4c5e-9cb2-1e6621ab91e9\', \'multiverseId\': 98580}, \'multiverseid\': 98580}, {\'name\': \'Manipulador gélido\', \'text\': \'{1}, {T}: Gira el artefacto, la criatura o la tierra objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'En el fuego está la chispa del caos y la destrucción, la semilla de la vida. En el hielo está la tranquilidad perfecta, el orden perfecto, el silencio de la muerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100020&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e09bc146-4f0a-470d-9f54-25562d377d27\', \'multiverseId\': 100020}, \'multiverseid\': 100020}, {\'name\': \'Manipulateur glacial\', \'text\': "{1}, {T} : Engagez l\'artefact ciblé, la créature ciblée, ou le terrain ciblé.", \'type\': \'Artefact\', \'flavor\': "Le feu contient l\'étincelle du chaos et de la destruction, la graine de la vie. La glace renferme la tranquillité et l\'ordre parfaits, et le silence de la mort.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98220&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d452789-cb65-4941-b714-56b22c68755f\', \'multiverseId\': 98220}, \'multiverseid\': 98220}, {\'name\': \'Manipolatore Glaciale\', \'text\': \'{1}, {T}: TAPpa un artefatto, una creatura o una terra bersaglio.\', \'type\': \'Artefatto\', \'flavor\': "Nel fuoco c\'è la scintilla del caos e della distruzione, il seme della vita. Nel ghiaccio ci sono la tranquillità assoluta, l\'ordine perfetto e il silenzio della morte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98940&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b2353d16-6a45-4707-9b37-95a7963064ff\', \'multiverseId\': 98940}, \'multiverseid\': 98940}, {\'name\': \'氷の干渉器\', \'text\': \'{1}, {T}：アーティファクト１つかクリーチャー１体か土地１つを対象とし、それをタップする。\', \'type\': \'アーティファクト\', \'flavor\': \'炎の中には混沌の火花と、命の種である破壊とがある。 氷の中には完璧な平穏と、完璧な秩序と、静かなる死とがある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99300&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'56374212-d17a-40b2-9da7-73ba15184e15\', \'multiverseId\': 99300}, \'multiverseid\': 99300}, {\'name\': \'Manipulador Gélido\', \'text\': \'{1}, {T}: Vira o artefato, a criatura ou o terreno alvo.\', \'type\': \'Artefato\', \'flavor\': \'No fogo há a centelha do caos e da destruição, a semente da vida. No gelo há a tranquilidade perfeita, a ordem perfeita e o silêncio da morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99660&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89421cce-29a7-4067-9075-3880069dcc1d\', \'multiverseId\': 99660}, \'multiverseid\': 99660}, {\'name\': \'Ледяной манипулятор\', \'text\': \'{1}, {T}: Поверните целевой артефакт, существо или землю.\', \'type\': \'Артефакт\', \'flavor\': \'Огонь это хаос и разрушение, основы жизни. Лед это абсолютное спокойствие, великолепный порядок и молчание смерти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109931&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3b69f611-598c-412a-8c54-f3451f1dc7e6\', \'multiverseId\': 109931}, \'multiverseid\': 109931}, {\'name\': \'寒冰操弄器\', \'text\': \'{1}，{T}：横置目标神器，生物或地。\', \'type\': \'神器\', \'flavor\': \'火焰蕴含着浑沌与毁灭的鼓动，以及生命的种子。 寒冰蕴含着安宁与秩序的完善，以及死亡的寂静。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97860&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'75e06e66-4740-443e-ae5a-68a1cabb0995\', \'multiverseId\': 97860}, \'multiverseid\': 97860}]', '[{\'name\': \'Eiternder Goblin\', \'text\': \'Wenn der Eiternde Goblin aus dem Spiel auf den Friedhof gelegt wird, erhält eine Kreatur deiner Wahl -1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zombie, Goblin\', \'flavor\': \'In seinem Leben war er ein stinkendes, verseuchtes Ding. Als er tot war, änderte sich daran nicht viel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98525&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e17d1eed-b1fb-46c7-82e6-9225dce03c90\', \'multiverseId\': 98525}, \'multiverseid\': 98525}, {\'name\': \'Trasgo purulento\', \'text\': \'Cuando el Trasgo purulento vaya a un cementerio desde el juego, la criatura objetivo obtiene -1/-1 hasta el final del turno.\', \'type\': \'Criatura — Trasgo zombie\', \'flavor\': \'En vida, era una cosa fétida, llena de enfermedades. Una vez muerto, no cambió mucho.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99965&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98ecffc8-efb6-4c68-8ca1-c516035e92ca\', \'multiverseId\': 99965}, \'multiverseid\': 99965}, {\'name\': \'Gobelin pourrissant\', \'text\': "Quand le Gobelin pourrissant est mis dans un cimetière depuis le jeu, la créature ciblée gagne -1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : zombie et gobelin\', \'flavor\': "Vivant, c\'était une chose fétide, rongée par la maladie. La mort n\'a pas changé grand chose.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98165&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'622cad1c-ae90-48d9-86a9-9d317005e8f3\', \'multiverseId\': 98165}, \'multiverseid\': 98165}, {\'name\': \'Goblin in Putrefazione\', \'text\': \'Quando il Goblin in Putrefazione viene messo in un cimitero dal gioco, la creatura bersaglio prende -1/-1 fino alla fine del turno.\', \'type\': \'Creatura — Goblin Zombie\', \'flavor\': \'In vita era una cosa fetida e piena di malattie. Dopo la morte non è cambiato di molto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98885&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e1ac844-dd27-4ca4-a940-0749feb6d8b8\', \'multiverseId\': 98885}, \'multiverseid\': 98885}, {\'name\': \'ただれたゴブリン\', \'text\': \'ただれたゴブリンが場からいずれかの墓地に置かれたとき、クリーチャー１体を対象とする。それはターン終了時まで-1/-1の修整を受ける。\', \'type\': \'クリーチャー — ゾンビ・ゴブリン\', \'flavor\': \'生きてたころ、奴は臭くて病気持ちだった。 死んでからだって、そんなに変わらないよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99245&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24ad83a1-9042-41d6-9524-74d3b4c22286\', \'multiverseId\': 99245}, \'multiverseid\': 99245}, {\'name\': \'Goblin Apodrecido\', \'text\': \'Quando Goblin Apodrecido for colocado num cemitério vindo de jogo, a criatura alvo recebe -1/-1 até o final do turno.\', \'type\': \'Criatura — Goblin Zumbi\', \'flavor\': \'Em vida, era uma coisa fétida e doentia. Na morte, não mudou muito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99605&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4703cab6-9e5c-400e-92f6-32dbadc6fecd\', \'multiverseId\': 99605}, \'multiverseid\': 99605}, {\'name\': \'Разлагающийся гоблин\', \'text\': \'Когда Разлагающийся гоблин выходит из игры и попадает на кладбище, целевое существо получает -1/-1 до конца хода.\', \'type\': \'Существо — Зомби Гоблин\', \'flavor\': \'Он и при жизни распространял вокруг себя болезни и гнусный запах. После смерти мало что изменилось.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109876&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'baa166ee-31bc-430c-a910-8b5f4f601111\', \'multiverseId\': 109876}, \'multiverseid\': 109876}, {\'name\': \'溃伤精灵\', \'text\': \'当溃伤精灵从场上进入坟墓场时，目标生物得-1/-1直到回合结束。\', \'type\': \'生物～灵俑／精灵\', \'flavor\': \'活着的时候是个活动垃圾堆， 死后也没啥变化。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97805&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c704b1b-9ff4-421e-99df-a923daa2d3d9\', \'multiverseId\': 97805}, \'multiverseid\': 97805}]', '[{\'name\': \'Ekelbold\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nDu verlierst 2 Lebenspunkte, wenn der Ekelbold ins Spiel kommt.\', \'type\': \'Kreatur — Bold\', \'flavor\': \'Der Bold war sich seines eigenen Gestanks nicht bewusst bis er nach Luft schnappen musste und sofort starb.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98543&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'68db2266-17b0-47cd-8569-a87a49b91eb8\', \'multiverseId\': 98543}, \'multiverseid\': 98543}, {\'name\': \'Diablillo pestilente\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nCuando el Diablillo pestilente entre en juego, pierde 2 vidas.\', \'type\': \'Criatura — Diablillo\', \'flavor\': \'El diablillo, ignorate de su propio olor, se detuvo para recuperar el aliento. . . y murió.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99983&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bb3fd32f-afdc-4fb4-bb2b-597bf981742c\', \'multiverseId\': 99983}, \'multiverseid\': 99983}, {\'name\': \'Diablotin flétri\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nQuand le Diablotin flétri arrive en jeu, vous perdez 2 points de vie.\', \'type\': \'Créature : diablotin\', \'flavor\': "Le diablotin, qui n\'avait pas conscience de son odeur, prit une grande inspiration . . . et mourut asphyxié.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98183&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18304289-fc0c-4355-80ad-08f59f4c2966\', \'multiverseId\': 98183}, \'multiverseid\': 98183}, {\'name\': \'Demonietto Fetido\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nQuando il Demonietto Fetido entra in gioco, perdi 2 punti vita.\', \'type\': \'Creatura — Demonietto\', \'flavor\': "Il demonietto, inconsapevole del proprio odore, si fermò a prendere fiato. . . e morì all\'istante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98903&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'830e1cee-dcd4-4cdb-b96f-a3d54083f2e9\', \'multiverseId\': 98903}, \'multiverseid\': 98903}, {\'name\': \'悪臭のインプ\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n悪臭のインプが場に出たとき、あなたは２点のライフを失う。\', \'type\': \'クリーチャー — インプ\', \'flavor\': \'インプは自分の体臭には気がついていないので、元気を取り戻すために立ち止まって息を深く吸い込んだ … … そしてたちまち死んでしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99263&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f846d56d-176d-4143-8890-d1f05b3e229c\', \'multiverseId\': 99263}, \'multiverseid\': 99263}, {\'name\': \'Diabrete Abominável\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nQuando Diabrete Abominável entra em jogo, você perde 2 pontos de vida.\', \'type\': \'Criatura — Diabrete\', \'flavor\': \'O diabrete, inconsciente de seu próprio cheiro, parou para recuperar o folêgo. . . e morreu em seguida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99623&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4bd24b44-7311-41c9-85dc-0c85d1d8ef09\', \'multiverseId\': 99623}, \'multiverseid\': 99623}, {\'name\': \'Вонючий бес\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nКогда Вонючий бес вступает в игру, вы теряете 2 пункта жизни.\', \'type\': \'Существо — Бес\', \'flavor\': \'Бес, не думая, что от него исходит такое зловоние, остановился перевести дух. . . и тут же помер.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109894&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'845dfa3a-5f03-48ad-aed2-1dfa087c6153\', \'multiverseId\': 109894}, \'multiverseid\': 109894}, {\'name\': \'腐味小恶魔\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n当腐味小恶魔进场时，你失去2点生命。\', \'type\': \'生物～小恶魔\', \'flavor\': \'这只小恶魔没察觉自己的气味，停下来吸了一口气之后. . . 突然就死了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97823&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fb5db425-8f49-4d66-8bef-337c548af9c6\', \'multiverseId\': 97823}, \'multiverseid\': 97823}]', '[{\'name\': \'Elfenbarde\', \'text\': \'Alle Kreaturen, die den Elfenbarden blocken können, tun dies.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Von der Melodie herbeigelockt mussten die Feinde des Barden schnell erkennen, dass hier mehr als nur ein Lied auf sie wartete.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d28c9e0-f36b-4251-9c6f-1bded0d47a7c\', \'multiverseId\': 98511}, \'multiverseid\': 98511}, {\'name\': \'Bardo élfico\', \'text\': \'Todas las criaturas que puedan bloquear al Bardo élfico lo hacen.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Inexorablemente atraídos, los enemigos del bardo rápidamente hallan más que una canción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99951&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe97a00d-c97b-43d7-a229-c53cfe9d0efe\', \'multiverseId\': 99951}, \'multiverseid\': 99951}, {\'name\': \'Barde elfe\', \'text\': \'Toutes les créatures capables de bloquer le Barde elfe le font.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': "Attirés malgré eux, les ennemis du barde découvrent rapidement qu\'ils ne trouveront pas qu\'une chanson.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98151&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53b31ad5-9d8f-4af2-afd2-0eab21dffe05\', \'multiverseId\': 98151}, \'multiverseid\': 98151}, {\'name\': \'Bardo degli Elfi\', \'text\': \'Tutte le creature che possono bloccare il Bardo degli Elfi lo bloccano.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'Attirati senza poter opporre resistenza, i nemici del bardo si rendono ben presto conto di trovare ben più che canzoni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98871&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b889290b-abe1-4fbc-8c3f-571346b2901b\', \'multiverseId\': 98871}, \'multiverseid\': 98871}, {\'name\': \'エルフの吟遊詩人\', \'text\': \'エルフの吟遊詩人をブロックできるすべてのクリーチャーは、それのブロックに参加する。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'どうしようもなく惹かれてしまった吟遊詩人の敵は、すぐに彼らを待ちうけるのが歌ばかりでないことを知る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99231&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69361f57-43a6-4c79-8723-0d05b250c3f0\', \'multiverseId\': 99231}, \'multiverseid\': 99231}, {\'name\': \'Bardo Elfo\', \'text\': \'Todas as criaturas aptas a bloquear Bardo Elfo o fazem.\', \'type\': \'Criatura — Xamã Elfo\', \'flavor\': \'Irremediavelmente atraídos, os inimigos do bardo perceberam rapidamente que algo além da música os aguardava.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99591&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5effb43c-74e5-4a0d-8f64-616e42853161\', \'multiverseId\': 99591}, \'multiverseid\': 99591}, {\'name\': \'Эльфийский бард\', \'text\': \'Все существа, способные блокировать Эльфийского барда, блокируют его.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Завлеченные обманом, беспомощные враги барда быстро смекнули, что песня не единственное его оружие.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109862&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b42c6552-ea3c-4363-b9d0-b5a8f9fbb9ff\', \'multiverseId\': 109862}, \'multiverseid\': 109862}, {\'name\': \'地精吟游诗人\', \'text\': \'所有能够阻挡地精吟游诗人的生物皆须阻挡之。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'不由自主地被曲调吸引来之后，吟游诗人的敌手很快便发现：等着他的不只是音乐而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97791&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'811dd532-5ffd-4924-84ed-fba617c83800\', \'multiverseId\': 97791}, \'multiverseid\': 97791}]', '[{\'name\': \'Elfenbeinmaske\', \'text\': \'Du kannst nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Maske, erschaffen aus den Hoffnungen ihres Trägers, sorgt dafür, dass diese Hoffnungen sich auch erfüllen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98589&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22062556-939f-40fc-a07b-ea2e387a0ae0\', \'multiverseId\': 98589}, \'multiverseid\': 98589}, {\'name\': \'Máscara de marfil\', \'text\': \'No puedes ser objetivo de hechizos o habilidades.\', \'type\': \'Encantamiento\', \'flavor\': \'Hecha de las esperanzas de su portador, la máscara asegura que esas esperanzas se realizarán.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100029&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9139b0d6-b483-4824-a9e0-13911c7f1979\', \'multiverseId\': 100029}, \'multiverseid\': 100029}, {\'name\': "Masque d\'ivoire", \'text\': \'Vous ne pouvez pas être la cible de sorts ou de capacités.\', \'type\': \'Enchantement\', \'flavor\': \'Formé par les espoirs du porteur, le masque assure que ceux-ci deviendront réalité.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98229&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4757e577-abba-48d1-885f-fe762b18bc8e\', \'multiverseId\': 98229}, \'multiverseid\': 98229}, {\'name\': \'Maschera di Avorio\', \'text\': \'Non puoi essere bersaglio di magie o abilità.\', \'type\': \'Incantesimo\', \'flavor\': \'Costruita con le speranze di chi la indossa, la maschera garantisce che quelle stesse speranze divengano realtà.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98949&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'842a4693-e49b-4821-a901-bc22bddaf83f\', \'multiverseId\': 98949}, \'multiverseid\': 98949}, {\'name\': \'象牙の仮面\', \'text\': \'あなたは呪文や能力の対象にならない。\', \'type\': \'エンチャント\', \'flavor\': \'その仮面は、身に着ける者の希望を糧とし、その希望が満たされることを保障する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99309&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9350c034-1c10-468b-aa36-bd9e441e95bb\', \'multiverseId\': 99309}, \'multiverseid\': 99309}, {\'name\': \'Máscara de Marfim\', \'text\': \'Você não pode ser alvo de mágicas ou habilidades.\', \'type\': \'Encantamento\', \'flavor\': \'Feita das esperanças de seu usuário, a máscara garante que aquelas esperanças se realizem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99669&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'06eec376-3a57-41b5-966f-6f01479af75b\', \'multiverseId\': 99669}, \'multiverseid\': 99669}, {\'name\': \'Маска из слоновой кости\', \'text\': \'Вы не можете стать целью заклинания или способности.\', \'type\': \'Чары\', \'flavor\': \'Она создана из надежд того, кто ее носит. И эти надежды непременно сбудутся.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109940&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'004d8a02-1e98-4cff-ba7b-fe3dda9c33e7\', \'multiverseId\': 109940}, \'multiverseid\': 109940}, {\'name\': \'象牙面具\', \'text\': \'你不能成为咒语或异能的目标。\', \'type\': \'结界\', \'flavor\': \'此面具为戴用者愿望之具现，用以确保这些愿望能够实现。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97869&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'302dccea-998e-4f4f-b6a2-b7e7364ca917\', \'multiverseId\': 97869}, \'multiverseid\': 97869}]', '[{\'name\': \'Elfenberserker\', \'text\': \'Immer wenn der Elfenberserker geblockt wird, erhält er für jede Kreatur, die ihn blockt, +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Berserker\', \'flavor\': \'Sein Zorn scheucht Feinde auseinander, als wären sie ein Haufen trockener Blätter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98512&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29436c5b-9891-4a16-a56e-b16abc053a3d\', \'multiverseId\': 98512}, \'multiverseid\': 98512}, {\'name\': \'Berserker élfico\', \'text\': \'Siempre que el Berserker élfico sea bloqueado, obtiene +1/+1 hasta el final del turno por cada criatura que lo bloquee.\', \'type\': \'Criatura — Berserker elfo\', \'flavor\': \'Su furia desparrama enemigos como pilas de hojas secas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99952&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a1e2fe31-1ad1-410b-b1da-4f569f5f5064\', \'multiverseId\': 99952}, \'multiverseid\': 99952}, {\'name\': \'Berserker elfe\', \'text\': "À chaque fois que le Berserker elfe devient bloqué, il gagne +1/+1 jusqu\'à la fin du tour pour chaque créature qui le bloque.", \'type\': \'Créature : elfe et berserker\', \'flavor\': \'Leur furie éparpille leurs ennemis comme autant de feuilles mortes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98152&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a57eb36-8bef-40b0-b33a-c9e6dd8665a1\', \'multiverseId\': 98152}, \'multiverseid\': 98152}, {\'name\': \'Elfo Berserker\', \'text\': "Ogniqualvolta l\'Elfo Berserker viene bloccato, prende +1/+1 fino alla fine del turno per ogni creatura che lo blocca.", \'type\': \'Creatura — Berserker Elfo\', \'flavor\': \'La loro furia disperde i nemici come se fossero foglie secche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98872&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fefca3c3-f80c-4450-807c-0fb4b2f0ae92\', \'multiverseId\': 98872}, \'multiverseid\': 98872}, {\'name\': \'エルフの狂戦士\', \'text\': \'エルフの狂戦士がブロックされた状態になるたび、それはターン終了時まで、自身をブロックしているクリーチャー１体につき+1/+1の修整を受ける。\', \'type\': \'クリーチャー — エルフ・狂戦士\', \'flavor\': \'怒り狂った狂戦士が暴れると、敵は枯れ葉の掃き寄せが吹き散るように蹴散らされてしまう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99232&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5424b48-1f67-4baa-8da9-060bafe51c80\', \'multiverseId\': 99232}, \'multiverseid\': 99232}, {\'name\': \'Elfo Enfurecido\', \'text\': \'Toda vez que Elfo Enfurecido for bloqueado, ele recebe +1/+1 até o final do turno para cada criatura que o está bloqueando.\', \'type\': \'Criatura — Elfo Amoque\', \'flavor\': \'A sua fúria dispersa os inimigos como se eles fossem uma pilha de folhas secas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99592&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0444cbe2-258f-4037-904d-c3295e7aaff1\', \'multiverseId\': 99592}, \'multiverseid\': 99592}, {\'name\': \'Эльфийский берсеркер\', \'text\': \'Каждый раз, когда Эльфийского берсеркера блокируют, он получает +1/+1 до конца хода за каждое блокирующее его существо.\', \'type\': \'Существо — Эльф Берсеркер\', \'flavor\': \'От их ярости враги разлетаются, как горстка сухих листьев.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109863&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3c8cec1b-f1fb-4cc6-baa4-bc4e9c00c831\', \'multiverseId\': 109863}, \'multiverseid\': 109863}, {\'name\': \'地精狂战士\', \'text\': \'每当地精狂战士被阻挡时，每有一个生物阻挡它，它便得+1/+1直到回合结束。\', \'type\': \'生物～地精／狂战士\', \'flavor\': \'敌人当之披靡，宛如秋风扫落叶般。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97792&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'35547aba-4172-4b1b-a2e7-67eecf35cd5f\', \'multiverseId\': 97792}, \'multiverseid\': 97792}]', '[{\'name\': \'Elfenkrieger\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': \'„Am Lagerfeuer soll ich immer meine alten Kriegsgeschichten erzählen, obwohl ich viel lieber anderes berichten will."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98515&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00a5d093-e45c-4550-a4cf-84a80418093c\', \'multiverseId\': 98515}, \'multiverseid\': 98515}, {\'name\': \'Guerrero élfico\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': \'"Mis anécdotas de guerra son las que más se piden alrededor de una fogata en la noche, pero son las que menos me interesa contar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99955&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'78bb0201-4c89-4398-8cc7-fca0804945ff\', \'multiverseId\': 99955}, \'multiverseid\': 99955}, {\'name\': \'Guerrier elfe\', \'type\': \'Créature : elfe et guerrier\', \'flavor\': "« Mes récits de guerre sont les histoires de feu de camp les plus populaires, mais je n\'aime guère les raconter. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98155&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73a3c774-a3d1-4a8f-bc5f-d39523c3dd5f\', \'multiverseId\': 98155}, \'multiverseid\': 98155}, {\'name\': \'Guerriero Elfico\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': \'"I miei racconti di guerra sono i più richiesti intorno al fuoco serale, ma sono anche quelli che racconto meno volentieri."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98875&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'122db5a9-1758-4f5b-bbec-0535c5fceff9\', \'multiverseId\': 98875}, \'multiverseid\': 98875}, {\'name\': \'エルフの戦士\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': \'夜に焚き火を囲むと、皆が私に戦ってきた戦争の話をせがむが、私にとっては一番話したくないことなんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99235&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c8d06080-2c1a-428d-84ae-ddd5806be8dd\', \'multiverseId\': 99235}, \'multiverseid\': 99235}, {\'name\': \'Guerreiro Élfico\', \'type\': \'Criatura — Guerreiro Elfo\', \'flavor\': \'"Meus contos de guerra são as histórias mais pedidas à noite em volta da fogueira, mas são as que menos gosto de contar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99595&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87ce408e-432b-481b-998e-808dcef6d67d\', \'multiverseId\': 99595}, \'multiverseid\': 99595}, {\'name\': \'Эльфийский воин\', \'type\': \'Существо — Эльф Воин\', \'flavor\': \'"Сражения вот о чем чаще всего меня просят рассказать, когда мы ночью сидим у костра, но о них-то мне меньше всего хочется говорить".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109866&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'062dc5b3-9eab-44d2-96a3-9d64237cbc31\', \'multiverseId\': 109866}, \'multiverseid\': 109866}, {\'name\': \'地精勇士\', \'type\': \'生物～地精／战士\', \'flavor\': \'「最多人想听的营火故事便是我的战场经历，但那也是我最不想提的。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97795&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b77e1f84-815d-497f-9dce-2bd40978c60f\', \'multiverseId\': 97795}, \'multiverseid\': 97795}]', '[{\'name\': \'Elfischer Pfeifer\', \'text\': \'{G}, {T}: Bringe eine Kreaturenkarte aus deiner Hand ins Spiel.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': "Aus Gaea wuchs die Welt, und sie war still. Aus Gaea wuchsen die Elfen, und das war\'s dann mit der Ruhe. —Mythos der Elfen", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98514&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3aa40880-73a3-4c2f-8983-6a08c1b48864\', \'multiverseId\': 98514}, \'multiverseid\': 98514}, {\'name\': \'Flautista élfica\', \'text\': \'{G}, {T}: Pon en juego una carta de criatura de tu mano.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'De Gaia, creció el mundo, y el mundo estuvo en silencio. De Gaia, crecieron los elfos del mundo, y el mundo dejó de estar el silencio. —Enseñanza élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99954&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3ec1d33-dd99-4900-a165-577073876780\', \'multiverseId\': 99954}, \'multiverseid\': 99954}, {\'name\': \'Joueuse de flûte elfe\', \'text\': \'{G}, {T} : Mettez en jeu une carte de créature de votre main.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': \'Gaia créa le monde et il était silencieux. Gaia créa les elfes et il ne le fut plus. —Enseignement elfe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98154&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1d4cfbd-68ee-42d2-99ec-b93549b97410\', \'multiverseId\': 98154}, \'multiverseid\': 98154}, {\'name\': \'Pifferaio Elfico\', \'text\': \'{G}, {T}: Metti in gioco una carta creatura dalla tua mano.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'Da Gaea venne il mondo, e il mondo era silente. Da Gaea vennero gli elfi del mondo, e il mondo non fu più in silenzio. —Insegnamento elfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98874&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca73c589-e08e-4269-b0d6-bd64fd1e446e\', \'multiverseId\': 98874}, \'multiverseid\': 98874}, {\'name\': \'エルフの笛吹き\', \'text\': \'{G}, {T}：あなたの手札にあるクリーチャー・カード１枚を場に出す。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'ガイアから世界が始まり、世界は静かだった。 ガイアから世界のエルフが生まれ、世界はもはや静かではなくなった。 ――エルフの教え\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99234&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ece9065-0288-4d73-beda-3084b49ded7b\', \'multiverseId\': 99234}, \'multiverseid\': 99234}, {\'name\': \'Elfo Flautista\', \'text\': \'{G}, {T}: Coloque em jogo um card de criatura de sua mão.\', \'type\': \'Criatura — Xamã Elfo\', \'flavor\': \'De Gaia nasceu o mundo, e o mundo era quieto. De Gaia nasceram os elfos do mundo, e o mundo já não mais era quieto. — Ensinamento dos elfos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99594&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd347b5f-b9d0-40cf-a162-c7b85bbacc12\', \'multiverseId\': 99594}, \'multiverseid\': 99594}, {\'name\': \'Эльфийский дудочник\', \'text\': \'{G}, {T}: Введите в игру карту из руки.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Из Гаэи возник мир. И была тишина в мире. Из Гаэи возникли эльфы мира сего. И не стало тишины в мире. — Уроки эльфов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109865&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'148c2508-cdb0-4663-b280-4cf4bde9cb17\', \'multiverseId\': 109865}, \'multiverseid\': 109865}, {\'name\': \'地精吹笛手\', \'text\': \'{G}，{T}：将一张生物牌从你手上放置进场。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'盖亚肇生世界，而后世界一片沉寂。 盖亚肇生世界中之地精，而后世界不再沉寂。 ～地精教诲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97794&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea0e17f1-474e-47d1-9338-78b26096c1b7\', \'multiverseId\': 97794}, \'multiverseid\': 97794}]', '[{\'name\': \'Engel der Gnade\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nWenn der Engel der Gnade ins Spiel kommt, erhältst du 3 Lebenspunkte dazu.\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98444&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee933072-336d-4bdf-a8c3-6a9c881fa616\', \'multiverseId\': 98444}, \'multiverseid\': 98444}, {\'name\': \'Ángel de piedad\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nCuando el Ángel de piedad entre en juego, gana 3 vidas.\', \'type\': \'Criatura — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99884&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'209c4a4a-bb15-4164-b4a1-85921c2cd918\', \'multiverseId\': 99884}, \'multiverseid\': 99884}, {\'name\': \'Ange de miséricorde\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nQuand l\'Ange de miséricorde arrive en jeu, vous gagnez 3 points de vie.", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98084&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'59161971-8e18-4b05-bdc5-75c0b512d5f0\', \'multiverseId\': 98084}, \'multiverseid\': 98084}, {\'name\': \'Angelo della Misericordia\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nQuando l\'Angelo della Misericordia entra in gioco, guadagni 3 punti vita.", \'type\': \'Creatura — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98804&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7d629e70-806d-4738-93ec-b8e50c57cb97\', \'multiverseId\': 98804}, \'multiverseid\': 98804}, {\'name\': \'慈悲の天使\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n慈悲の天使が場に出たとき、あなたは３点のライフを得る。\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99164&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'827ea60a-92e2-4f18-86b8-f6c91ea76d3d\', \'multiverseId\': 99164}, \'multiverseid\': 99164}, {\'name\': \'Anjo de Misericórdia\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nQuando Anjo de Misericórdia entra em jogo, você ganha 3 pontos de vida.\', \'type\': \'Criatura — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99524&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50d1f1b8-46d8-4a9b-a2ee-a5daf36dd725\', \'multiverseId\': 99524}, \'multiverseid\': 99524}, {\'name\': \'Ангел милосердия\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nКогда Ангел милосердия вступает в игру, вы получаете 3 пункта жизни.\', \'type\': \'Существо — Ангел\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109795&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ded4588e-f091-4c96-8805-f323b65c2b9e\', \'multiverseId\': 109795}, \'multiverseid\': 109795}, {\'name\': \'慈悲天使\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n当慈悲天使进场时，你获得3点生命。\', \'type\': \'生物～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97724&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6d2a9066-8030-473c-a17c-396cd707b23d\', \'multiverseId\': 97724}, \'multiverseid\': 97724}]', '[{\'name\': \'Engelsfeder\', \'text\': \'Immer wenn ein Spieler einen weißen Zauberspruch spielt, kannst du 1 Lebenspunkt dazuerhalten.\', \'type\': \'Artefakt\', \'flavor\': \'Wird sie genommen, schneidet sie die Hand, die sie ergreift. Wird sie gegeben, heilt sie die Hand, die sie hält.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98445&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2499b72-ccb5-444c-9a46-77887c487433\', \'multiverseId\': 98445}, \'multiverseid\': 98445}, {\'name\': \'Pluma de ángel\', \'text\': \'Siempre que un jugador juegue un hechizo blanco, puedes ganar una vida.\', \'type\': \'Artefacto\', \'flavor\': \'Si es tomada, corta la mano que la agarra. Si es dada, cura la mano que la sostiene.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99885&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3959e051-6d8e-488b-952e-7a3ab54131f4\', \'multiverseId\': 99885}, \'multiverseid\': 99885}, {\'name\': "Plume d\'ange", \'text\': "À chaque fois qu\'un joueur joue un sort blanc, vous pouvez gagner 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Volée, elle tranche la main qui la serre. Donnée, elle soigne la main qui la tient.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98085&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2ead597-57d0-4b5e-a8a6-ca702636e449\', \'multiverseId\': 98085}, \'multiverseid\': 98085}, {\'name\': \'Piuma di Angelo\', \'text\': \'Ogniqualvolta un giocatore gioca una magia bianca, puoi guadagnare 1 punto vita.\', \'type\': \'Artefatto\', \'flavor\': "Se viene presa, taglia la mano che l\'afferra. Se viene donata, cura la mano che la stringe.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98805&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'188bdcd5-b722-45fe-a5b7-34c6fa8258c1\', \'multiverseId\': 98805}, \'multiverseid\': 98805}, {\'name\': \'天使の羽根\', \'text\': \'いずれかのプレイヤーが白の呪文をプレイするたび、あなたは１点のライフを得てもよい。\', \'type\': \'アーティファクト\', \'flavor\': \'抜かば、その掴みし手を切る。 与わば、その持ちし手を癒す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99165&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'378418ef-aec6-45e4-8763-563ba6fa0486\', \'multiverseId\': 99165}, \'multiverseid\': 99165}, {\'name\': \'Pluma de Anjo\', \'text\': \'Toda vez que um jogador jogar uma mágica branca, você pode ganhar 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'Se for arrancada, corta a mão de quem a roubou. Se for concedida, cura a mão de quem a segurou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99525&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cff718be-4b1e-40bd-b5d6-f1d39090fe6c\', \'multiverseId\': 99525}, \'multiverseid\': 99525}, {\'name\': \'Перо ангела\', \'text\': \'Каждый раз, когда разыгрывается белое заклинание, вы получаете 1 пункт жизни.\', \'type\': \'Артефакт\', \'flavor\': \'Оно порежет руку того, кто силой его захватит. Оно исцелит руку того, кому будет даровано.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109796&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'91dc42bf-e714-47df-a552-4bd880f2f944\', \'multiverseId\': 109796}, \'multiverseid\': 109796}, {\'name\': \'天使翎羽\', \'text\': \'每当牌手使用任何白色咒语时，你可以获得1点生命。\', \'type\': \'神器\', \'flavor\': \'若遭冒犯，它将划破强夺之手。 若系馈送，它将治愈领受之手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97725&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'36a603f7-d943-4e0a-a657-4babffc61b8f\', \'multiverseId\': 97725}, \'multiverseid\': 97725}]', '[{\'name\': \'Entmystifizieren\', \'text\': \'Zerstöre eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98503&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b061fb4-5010-4366-ac50-e9144f529bab\', \'multiverseId\': 98503}, \'multiverseid\': 98503}, {\'name\': \'Desmitificar\', \'text\': \'Destruye el encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99943&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1989659-14e8-4fd9-ac9b-b0b145343ce9\', \'multiverseId\': 99943}, \'multiverseid\': 99943}, {\'name\': \'Démystification\', \'text\': "Détruisez l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98143&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'51973d41-9def-404a-b67b-208b5dbd1560\', \'multiverseId\': 98143}, \'multiverseid\': 98143}, {\'name\': \'Demistificare\', \'text\': \'Distruggi un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98863&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99381df4-aad2-4811-b998-f6d279f002ed\', \'multiverseId\': 98863}, \'multiverseid\': 98863}, {\'name\': \'啓蒙\', \'text\': \'エンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99223&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc00f02c-4e5a-438f-b4ca-f331f54fa764\', \'multiverseId\': 99223}, \'multiverseid\': 99223}, {\'name\': \'Desmistificar\', \'text\': \'Destrói o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99583&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1ccfb224-70a1-4582-8c9b-a6487fcce190\', \'multiverseId\': 99583}, \'multiverseid\': 99583}, {\'name\': \'Прояснение\', \'text\': \'Уничтожьте целевые чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109854&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7a0b98fa-f111-4681-9cfe-b07cbf20d321\', \'multiverseId\': 109854}, \'multiverseid\': 109854}, {\'name\': \'揭秘\', \'text\': \'消灭目标结界。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97783&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8c7257ad-d53a-41e6-b44c-7883bce0c5e4\', \'multiverseId\': 97783}, \'multiverseid\': 97783}]', '[{\'name\': \'Erfahrener Fußsoldat\', \'text\': \'{T}: Eine angreifende Kreatur deiner Wahl erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Diese Narbe? Das waren die Zähne eines Zombies. Diese Narbe? Das war die Axt eines Barbaren. Diese Narbe? Über diese Narbe will ich nicht reden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98583&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f6f729c-95a6-4774-b308-412e950ab501\', \'multiverseId\': 98583}, \'multiverseid\': 98583}, {\'name\': \'Veterano de infantería\', \'text\': \'{T}: La criatura atacante objetivo obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"¿Esta cicatriz? Del diente de un zombie. ¿Esta cicatriz? Del hacha de un bárbaro. ¿Esa cicatriz? Nunca hablo de esa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100023&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66aaac1c-7639-478b-a42d-1ba903d16f02\', \'multiverseId\': 100023}, \'multiverseid\': 100023}, {\'name\': "Vétéran de l\'infanterie", \'text\': "{T} : La créature attaquante ciblée gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et soldat\', \'flavor\': "« Cette cicatrice ? Les dents d\'un zombie. Celle-ci ? La hache d\'un barbare. Et celle-là ? Je préfère ne pas en parler. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98223&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'deea520c-0332-47db-8dae-7b630dc6e7af\', \'multiverseId\': 98223}, \'multiverseid\': 98223}, {\'name\': \'Fante Veterano\', \'text\': \'{T}: La creatura attaccante bersaglio prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Questa cicatrice? I denti di uno zombie. Questa cicatrice? L\\\'ascia di un barbaro. Questa cicatrice? Di questa non parlo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98943&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ec9644b-b1ed-4026-a73a-565fe6b50ae7\', \'multiverseId\': 98943}, \'multiverseid\': 98943}, {\'name\': \'歴戦の歩兵\', \'text\': \'{T}：攻撃クリーチャー１体を対象とする。それはターン終了時まで+1/+1の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'この傷か？ ゾンビの歯にやられたやつだ。 この傷か？ 蛮人の斧さ。 こっちの傷？ その話はしたくないな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99303&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a0aca6de-1b83-4137-a3de-27c611e4809d\', \'multiverseId\': 99303}, \'multiverseid\': 99303}, {\'name\': \'Veterano da Infantaria\', \'text\': \'{T}: A criatura alvo atacante recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'"Esta cicatriz? Dos dentes de um zumbi. Esta cicatriz? Do machado de um bárbaro. Aquela cicatriz? Não falo sobre aquela cicatriz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99663&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b5cb710-a532-4c85-bd54-61dbe5de2a6c\', \'multiverseId\': 99663}, \'multiverseid\': 99663}, {\'name\': \'Ветеран пехоты\', \'text\': \'{T}: Целевое нападающее существо получает +1/+1 до конца хода.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'"Этот шрам? Его оставили клыки зомби. Этот? Это топор варвара. Этот? Об этом я не рассказываю".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109934&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'446f7714-0da1-402e-86c4-975a2025e8a9\', \'multiverseId\': 109934}, \'multiverseid\': 109934}, {\'name\': \'资深步兵\', \'text\': \'{T}：目标进行攻击的生物得+1/+1直到回合结束。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「这道疤？ 给灵俑咬的。 这道疤？ 给蛮族砍的。 那道疤？ 我不想提。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97863&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2eeef4c0-157e-4935-9a74-ed72b46da1ac\', \'multiverseId\': 97863}, \'multiverseid\': 97863}]', '[{\'name\': \'Erfahrener Marschall\', \'text\': \'Immer wenn der Erfahrene Marschall angreift, kannst du eine Kreatur deiner Wahl tappen.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„An der Aussicht auf eine Niederlage sind Wir nicht interessiert." —Queen Victoria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98701&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58b5ae67-03f7-46ba-8b3b-956159ac88b8\', \'multiverseId\': 98701}, \'multiverseid\': 98701}, {\'name\': \'Mariscal experimentado\', \'text\': \'Siempre que el Mariscal experimentado ataque, puedes girar la criatura objetivo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"No estamos interesados en las posibilidades de derrota." —Reina Victoria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100141&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c83b838-b8aa-47a7-b385-943c67cd6fcd\', \'multiverseId\': 100141}, \'multiverseid\': 100141}, {\'name\': \'Maréchale aguerrie\', \'text\': \'À chaque fois que la Maréchale aguerrie attaque, vous pouvez engager une créature ciblée.\', \'type\': \'Créature : humain et soldat\', \'flavor\': \'« Un bon général doit non seulement connaître le moyen de vaincre, mais aussi savoir quand la victoire est impossible. » —Polybe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98341&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'11a82627-6144-4761-950f-f468c42049e5\', \'multiverseId\': 98341}, \'multiverseid\': 98341}, {\'name\': \'Maresciallo Veterano\', \'text\': \'Ogniqualvolta il Maresciallo Veterano attacca, puoi TAPpare una creatura bersaglio.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Non siamo interessati alle possibilità di sconfitta." —Regina Vittoria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99061&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cebecf05-2e72-429f-ae31-1255da392e31\', \'multiverseId\': 99061}, \'multiverseid\': 99061}, {\'name\': \'歴戦の司令官\', \'text\': \'歴戦の司令官が攻撃に参加するたび、クリーチャー１体を対象とする。あなたはそれをタップしてもよい。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'敗戦の可能性には興味がありません。 ――ヴィクトリア女王\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99421&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'860df7b1-d055-4c9a-888d-57e1b5f4cb36\', \'multiverseId\': 99421}, \'multiverseid\': 99421}, {\'name\': \'Marechal Experiente\', \'text\': \'Toda vez que Marechal Experiente atacar, você pode virar a criatura alvo.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'"Não estamos interessados nas possibilidades de derrota." — Rainha Victoria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99781&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0aa10ec0-7a6f-463b-882c-d1c54465cc3e\', \'multiverseId\': 99781}, \'multiverseid\': 99781}, {\'name\': \'Закаленный маршал\', \'text\': \'Каждый раз, когда Закаленный маршал нападает, вы можете повернуть целевое существо.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'"Нас не интересуют возможные пути к поражению". — Королева Виктория\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110052&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e1d3f674-d445-4c30-a943-e66f4a436695\', \'multiverseId\': 110052}, \'multiverseid\': 110052}, {\'name\': \'经验老到的元帅\', \'text\': \'每当经验老到的元帅攻击时，你可以横置目标生物。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「朕对失败的可能性不感兴趣。」 ～维多利亚女王\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83c5860a-b70e-4a1a-8746-9501bae3008a\', \'multiverseId\': 97981}, \'multiverseid\': 97981}]', '[{\'name\': \'Erfahrener Rittmeister\', \'text\': \'Wachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': \'Der Geist ist das Schwert, und Erfahrung ist der Wetzstein. —Arabisches Sprichwort\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98770&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0115078f-b5bf-4a8d-bac5-f5cce50693d6\', \'multiverseId\': 98770}, \'multiverseid\': 98770}, {\'name\': \'Caballero veterano\', \'text\': \'Vigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Caballero humano\', \'flavor\': \'El espíritu es la espada y la experiencia la piedra de afilar. —Proverbio árabe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100210&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf6bbc06-68d7-47df-a420-001940638688\', \'multiverseId\': 100210}, \'multiverseid\': 100210}, {\'name\': \'Cavalier vétéran\', \'text\': "Vigilance (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : humain et chevalier\', \'flavor\': \'Le foie de mon ennemi est le fourreau de mon épée. —Proverbe tibétain\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98410&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0e136188-a736-46cb-932e-023855f58016\', \'multiverseId\': 98410}, \'multiverseid\': 98410}, {\'name\': \'Cavaliere Veterano\', \'text\': \'Cautela (Questa creatura attacca senza TAPpare.)\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': "Lo spirito è la spada e l\'esperienza la pietra per affilarla. —Proverbio arabo", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99130&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a34e38c2-d8d7-4dbf-aa28-1b37bbb2cd45\', \'multiverseId\': 99130}, \'multiverseid\': 99130}, {\'name\': \'歴戦の騎兵\', \'text\': \'警戒 （このクリーチャーは攻撃に参加してもタップしない。）\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': \'魂は剣であり、経験は砥石である。 ――アラビアの諺\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99490&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ce401c3-0300-4bef-969e-bceeef428c7e\', \'multiverseId\': 99490}, \'multiverseid\': 99490}, {\'name\': \'Cavalariana Veterana\', \'text\': \'Vigilância (Esta criatura não é virada para atacar.)\', \'type\': \'Criatura — Cavaleiro Humano\', \'flavor\': \'O espírito é a espada e, a experiência, a pedra de amolar. — Provérbio árabe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99850&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dfd2472a-76d4-4991-9daf-966c50507230\', \'multiverseId\': 99850}, \'multiverseid\': 99850}, {\'name\': \'Ветеран кавалерии\', \'text\': \'Бдительность (При нападении это существо не поворачивается).\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': \'Дух это меч, опыт точильный камень. — Арабская пословица\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110121&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'56bf350f-6140-46e3-ba77-319ac7488b1a\', \'multiverseId\': 110121}, \'multiverseid\': 110121}, {\'name\': \'资深骑兵\', \'text\': \'警戒（此生物攻击时不需横置）\', \'type\': \'生物～人类／骑士\', \'flavor\': \'若精神是长剑，经验则是磨刀石。 ～阿拉伯谚语\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98050&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ec3929b-23e5-4208-bab5-342b38f0c580\', \'multiverseId\': 98050}, \'multiverseid\': 98050}]', '[{\'name\': \'Erschlagen\', \'text\': \'Zerstöre eine grüne Kreatur deiner Wahl. Sie kann nicht regeneriert werden.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Elfen hatten Vorteile durch List, Können und Tapferkeit. Aber am Ende entschied doch die reine Überzahl.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98717&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'66ebfaff-6aa6-4204-9f12-a79d068eaa9f\', \'multiverseId\': 98717}, \'multiverseid\': 98717}, {\'name\': \'Matar\', \'text\': \'Destruye la criatura objetivo verde. No puede ser regenerada.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Los elfos tenían la ventaja en astucia, destreza y valor. Pero al final, sólo importaba la cantidad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100157&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b5c5b61-ebea-4bc8-a519-cdb791fe34a3\', \'multiverseId\': 100157}, \'multiverseid\': 100157}, {\'name\': \'Assassinat\', \'text\': \'Détruisez la créature verte ciblée. Elle ne peut pas être régénérée.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "Les elfes avaient l\'avantage de la finesse, du talent et de la valeur. Mais à la fin, seul le nombre fit la différence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98357&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18ddc22b-65b5-42c2-9fbc-318ae590302d\', \'multiverseId\': 98357}, \'multiverseid\': 98357}, {\'name\': \'Massacrare\', \'text\': \'Distruggi una creatura bersaglio verde. Non può essere rigenerata.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': "Gli elfi avevano il vantaggio dell\'arguzia, dell\'abilità e del valore. Ma alla fine fu solo la superiorità numerica a contare.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99077&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'76b2b2bc-203f-44a7-b73c-0a930e85dd7f\', \'multiverseId\': 99077}, \'multiverseid\': 99077}, {\'name\': \'殺戮\', \'text\': \'緑のクリーチャー１体を対象とし、それを破壊する。 それは再生できない。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'エルフたちの強みは、ずる賢さと技能と勇気を持っていることだった。 しかし最終的には、それだけでは敵の数に勝てなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99437&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'488277f2-00fd-444c-bfcc-d0b8a5a45a54\', \'multiverseId\': 99437}, \'multiverseid\': 99437}, {\'name\': \'Matar\', \'text\': \'Destrói a criatura verde alvo. Ela não pode ser regenerada.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os elfos tinham a vantagem da inteligência, perícia e valor. Mas no final, só a quantidade interessava.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99797&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3da2c31-c36f-4ad7-aa2d-01fc621ad92b\', \'multiverseId\': 99797}, \'multiverseid\': 99797}, {\'name\': \'Умерщвление\', \'text\': \'Уничтожьте целевое зеленое существо. Оно не может быть регенерировано.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Эльфы были хитры, ловки и доблестны. Но, в конечном счете, имело значение лишь их количество.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110068&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7b115df0-07c7-4580-9aa7-3c0da355463b\', \'multiverseId\': 110068}, \'multiverseid\': 110068}, {\'name\': \'戕杀\', \'text\': \'消灭目标绿色生物。 它不能重生。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'地精有智谋、勇气和技巧， 但到头来只证明了数量还是最重要的。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97997&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e06c238b-26c2-488c-b62d-022f89bbd5cd\', \'multiverseId\': 97997}, \'multiverseid\': 97997}]', '[{\'name\': \'Erschöpfung\', \'text\': \'Kreaturen und Länder, die ein Gegner deiner Wahl kontrolliert, enttappen nicht während seines nächsten Enttappsegments.\', \'type\': \'Hexerei\', \'flavor\': \'Müde ist noch ein viel zu schwacher Ausdruck dafür.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98522&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6941182-9cce-471b-842e-ad3e008a4374\', \'multiverseId\': 98522}, \'multiverseid\': 98522}, {\'name\': \'Agotamiento\', \'text\': \'Las criaturas y las tierras que controla el oponente objetivo no se enderezan durante su próximo paso de enderezar.\', \'type\': \'Conjuro\', \'flavor\': \'Es mucho más que cansancio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99962&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b166b4d3-0987-4510-9f89-eca3799f91c0\', \'multiverseId\': 99962}, \'multiverseid\': 99962}, {\'name\': \'Exténuation\', \'text\': "Les créatures et les terrains contrôlés par l\'adversaire ciblé ne se dégagent pas pendant sa prochaine étape de dégagement.", \'type\': \'Rituel\', \'flavor\': \'Vous ne savez pas ce que le mot fatigue veut dire, croyez-moi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98162&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0a9d855-5936-47d8-8d9d-f35aed2ff936\', \'multiverseId\': 98162}, \'multiverseid\': 98162}, {\'name\': \'Esaurimento\', \'text\': \'Le creature e le terre controllate da un avversario bersaglio non STAPpano durante il suo prossimo STAP.\', \'type\': \'Stregoneria\', \'flavor\': "Dire che sono stanco non rende neppure minimamente l\'idea.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98882&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8b83ce9-9520-450c-b3d2-5f3a61ea9b70\', \'multiverseId\': 98882}, \'multiverseid\': 98882}, {\'name\': \'疲労困憊\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーがコントロールするクリーチャーと土地は、そのプレイヤーの次のアンタップ・ステップにアンタップしない。\', \'type\': \'ソーサリー\', \'flavor\': \'疲れたなんていう言葉では言い表しようがない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99242&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bf718eb2-f638-4d86-aec4-b52cae8209e9\', \'multiverseId\': 99242}, \'multiverseid\': 99242}, {\'name\': \'Exaustão\', \'text\': \'As criaturas e os terrenos que o oponente alvo controla não desviram durante a próxima etapa de desvirar dele.\', \'type\': \'Feitiço\', \'flavor\': \'Cansado não é nem o começo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99602&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'10d8450e-48eb-465e-80b6-586815162d87\', \'multiverseId\': 99602}, \'multiverseid\': 99602}, {\'name\': \'Истощение\', \'text\': \'Существа и земли, контролируемые целевым оппонентом, не разворачиваются во время очередного этапа разворота.\', \'type\': \'Волшебство\', \'flavor\': \'Уставший человек даже не пытается справиться с ним.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109873&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30b689ab-483f-4f2c-b5fc-70f050ddec1b\', \'multiverseId\': 109873}, \'multiverseid\': 109873}, {\'name\': \'精疲力竭\', \'text\': \'由目标对手所操控的生物与地，于他的下一个重置步骤中不可重置。\', \'type\': \'法术\', \'flavor\': \'「累」与它相较之下，根本只算是小意思。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97802&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e624b0b9-7db9-44d7-af5b-cef25ed15376\', \'multiverseId\': 97802}, \'multiverseid\': 97802}]', '[{\'name\': \'Evakuierung\', \'text\': \'Bringe alle Kreaturen auf die Hand ihrer Besitzer zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'Was ist beunruhigender: das Schlachtengetöse, oder die Stille, die ihm folgt?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d907de35-6a95-4cf2-bf16-05158c1400c5\', \'multiverseId\': 98520}, \'multiverseid\': 98520}, {\'name\': \'Evacuación\', \'text\': \'Regresa todas las criaturas a las manos de sus propietarios.\', \'type\': \'Instantáneo\', \'flavor\': \'¿Qué es más inquietante: el rugido de la batalla o el silencio que le sigue?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99960&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9132593f-de12-44b0-a5a6-5d40e338e840\', \'multiverseId\': 99960}, \'multiverseid\': 99960}, {\'name\': \'Évacuation\', \'text\': \'Renvoyez toutes les créatures dans les mains de leurs propriétaires.\', \'type\': \'Éphémère\', \'flavor\': "Le plus inquiétant est-il le fracas de la bataille ou le silence qui s\'en suit ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98160&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2d6bb61f-33e5-4baa-9aae-8af3fda1908d\', \'multiverseId\': 98160}, \'multiverseid\': 98160}, {\'name\': \'Evacuazione\', \'text\': \'I proprietari riprendono in mano tutte le creature.\', \'type\': \'Istantaneo\', \'flavor\': \'Cosa ti disturba di più: il fragore della battaglia o il silenzio che segue?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98880&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'57ee93cd-2fe2-48bd-8505-02ad4edfe7a9\', \'multiverseId\': 98880}, \'multiverseid\': 98880}, {\'name\': \'脱出\', \'text\': \'すべてのクリーチャーをオーナーの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'より不安になるのはどっち？ 戦場の轟音と、その後の静寂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99240&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'14df5496-71d7-4cf8-854f-bd02d339bba2\', \'multiverseId\': 99240}, \'multiverseid\': 99240}, {\'name\': \'Evacuação\', \'text\': \'Devolve todas as criaturas para as mãos de seus donos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O que é mais perturbador: o rugido da batalha ou o silêncio que se segue?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99600&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2668a700-c498-4000-8ee6-822f9b43bf6a\', \'multiverseId\': 99600}, \'multiverseid\': 99600}, {\'name\': \'Эвакуация\', \'text\': \'Верните всех существ в руки их владельцев.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Что пугает больше - рев сражения или тишина, которая наступает после него?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109871&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'98b87cd7-17fa-4627-8e1d-3bbddd93f3b8\', \'multiverseId\': 109871}, \'multiverseid\': 109871}, {\'name\': \'逃难\', \'text\': \'将所有生物移回其拥有者手上。\', \'type\': \'瞬间\', \'flavor\': \'兵灾的怒号与过后的静寂，何者更令人不安？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97800&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54ccb637-86e7-4301-acd1-010f6d2288f3\', \'multiverseId\': 97800}, \'multiverseid\': 97800}]', '[{\'name\': \'Exekution\', \'text\': \'Zerstöre eine weiße Kreatur deiner Wahl. Sie kann nicht regeneriert werden.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Jeder Dummkopf, der für seine Ehre sterben würde, ist auch besser tot." —Patriarch der Kabbalisten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f08daf95-6eb6-4070-8727-97ec0247d9a9\', \'multiverseId\': 98521}, \'multiverseid\': 98521}, {\'name\': \'Ejecutar\', \'text\': \'Destruye la criatura objetivo blanca. No puede ser regenerada.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Cualquier tonto que moriría por honor está mejor muerto". —Patriarca de la Cábala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99961&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e224699b-f372-46e3-83d7-6c06d3f09817\', \'multiverseId\': 99961}, \'multiverseid\': 99961}, {\'name\': \'Exécution\', \'text\': \'Détruisez la créature blanche ciblée. Elle ne peut pas être régénérée.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "« Toute personne prête à mourir pour l\'honneur ferait mieux de rester morte. » —Le patriarche de la Coterie", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98161&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'52545676-6b1d-4b91-92a1-193b53b69ada\', \'multiverseId\': 98161}, \'multiverseid\': 98161}, {\'name\': \'Giustiziare\', \'text\': \'Distruggi una creatura bersaglio bianca. Non può essere rigenerata.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Se un folle vuole morire per onore, dobbiamo accontentarlo". —Patriarca della Cabala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98881&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea33e5c0-4ce2-4d53-9e67-38fe41c3f5e3\', \'multiverseId\': 98881}, \'multiverseid\': 98881}, {\'name\': \'処刑\', \'text\': \'白のクリーチャー１体を対象とし、それを破壊する。 それは再生できない。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'名誉のために死をいとわないという奇特な奴は、死んだほうが幸せだ。 ――陰謀団の総帥\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99241&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6e505a35-92bd-4c46-a781-830cd4ae9553\', \'multiverseId\': 99241}, \'multiverseid\': 99241}, {\'name\': \'Executar\', \'text\': \'Destrói a criatura branca alvo. Ela não pode ser regenerada.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Qualquer tolo que se dispõe a morrer pela honra merece morrer." — Patriarca da Cabala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99601&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e9bf527-ddd8-42e2-909c-fc07206e4ad0\', \'multiverseId\': 99601}, \'multiverseid\': 99601}, {\'name\': \'Расправа\', \'text\': \'Уничтожьте целевое белое существо. Оно не может быть регенерировано.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Если глупец отправляется в могилу ради чести, там ему и место". — Патриарх заговора\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109872&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2492b8f4-a7fc-45ba-98d7-c31068bbed42\', \'multiverseId\': 109872}, \'multiverseid\': 109872}, {\'name\': \'处决\', \'text\': \'消灭目标白色生物。 它不能重生。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「愿意为荣耀而死的笨蛋就去死吧。」 ～柯帮教父\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97801&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a515cb1-054b-48b2-ad43-03a337ebbcfc\', \'multiverseId\': 97801}, \'multiverseid\': 97801}]', '[{\'name\': \'Fanatischer Inquisitor\', \'text\': \'{1}{W}: Der nächste 1 Schadenspunkt, der dem Fanatischen Inquisitor in diesem Zug zugefügt würde, wird stattdessen einer Kreatur deiner Wahl zugefügt.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Wein und Balsam für die Geständnisse der Büßenden. Klingen und Eisen für die Geständnisse derer, die nicht bereuen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98793&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e040c2a-16e1-4532-ad8d-1bff1f1f32e8\', \'multiverseId\': 98793}, \'multiverseid\': 98793}, {\'name\': \'Inquisidor ferviente\', \'text\': \'{1}{W}: El siguiente punto de daño que se le fuera a hacer al Inquisidor ferviente este turno, en vez de eso, se le hace a la criatura objetivo.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Vino y bálsamo para las confesiones de los arrepentidos. Hierros y cuchillas para las confesiones de los que no se arrepienten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100233&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18fef15c-3a36-4561-844b-0d1caa5a00c3\', \'multiverseId\': 100233}, \'multiverseid\': 100233}, {\'name\': \'Inquisiteur zélé\', \'text\': "{1}{W} : La prochaine 1 blessure qui devrait être infligée à l\'Inquisiteur zélé ce tour-ci est infligée à la créature ciblée à la place.", \'type\': \'Créature : humain et clerc\', \'flavor\': "Du vin et des onguents pour récompenser le pénitent. Des rasoirs et des fers rouges pour récompenser l\'impénitent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98433&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ded984b-48fd-47ec-a036-11c1496fb514\', \'multiverseId\': 98433}, \'multiverseid\': 98433}, {\'name\': \'Inquisitore Fanatico\', \'text\': "{1}{W}: Il prossimo punto danno che verrebbe inflitto all\'Inquisitore Fanatico in questo turno viene invece inflitto a una creatura bersaglio.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'Vino e balsamo per le confessioni dei pentiti. Rasoi e acciaio per le confessioni degli impenitenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99153&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6d9ff16a-4712-49d6-92db-78bcc9d795bf\', \'multiverseId\': 99153}, \'multiverseid\': 99153}, {\'name\': \'盲信の審問官\', \'text\': \'{1}{W}：クリーチャー１体を対象とする。このターン、次に盲信の審問官に与えられる１点のダメージは、代わりにそれに与えられる。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'懺悔せし者の告白に葡萄酒と傷薬を。 懺悔せざる者の告白に刃と鋼を。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99513&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc387d2c-d3f2-4250-8755-e9387b687736\', \'multiverseId\': 99513}, \'multiverseid\': 99513}, {\'name\': \'Inquisidor Zeloso\', \'text\': \'{1}{W}: O próximo 1 ponto de dano que seria causado a Inquisidor Zeloso neste turno, em vez disso, é causado à criatura alvo.\', \'type\': \'Criatura — Clérigo Humano\', \'flavor\': \'Vinho e bálsamos às confissões dos penitentes. Lâminas e ferros às confissões dos impenitentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99873&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'34523cb1-4df3-49ae-92d0-d0cae81f0e55\', \'multiverseId\': 99873}, \'multiverseid\': 99873}, {\'name\': \'Рьяный инквизитор\', \'text\': \'{1}{W}: Следующее 1 повреждение, которое будет нанесено Рьяному инквизитору в этот ход, вместо этого будет нанесено целевому существу.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Раскаявшимся вино и елей. Непокорным бритва и раскаленный утюг.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110144&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aeefb18e-5469-4353-8282-967566d15ff6\', \'multiverseId\': 110144}, \'multiverseid\': 110144}, {\'name\': \'狂热审判官\', \'text\': \'{1}{W}：于本回合中，狂热审判官将受到的下1点伤害改为对目标生物造成之。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'为悔悟者的告解赐与美酒与香膏； 向不悟者的告解投以尖刀与利刃。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8674b045-2ff4-4629-99bd-bf00d48f018e\', \'multiverseId\': 98073}, \'multiverseid\': 98073}]', '[{\'name\': \'Feiertag\', \'text\': \'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Friede ist Freiheit in Ruhe." —Cicero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98572&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2605f4a4-124f-494b-afe8-0edfa7df1624\', \'multiverseId\': 98572}, \'multiverseid\': 98572}, {\'name\': \'Día santo\', \'text\': \'Prevén todo el daño de combate que se fuera a hacer este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"El día de los espíritus; el retiro tranquilo de mi alma / ¡que nadie perturba" —Henry Vaughan, "La noche"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100012&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'259417f9-c930-4bd5-88ab-09e69395346c\', \'multiverseId\': 100012}, \'multiverseid\': 100012}, {\'name\': \'Jour saint\', \'text\': \'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.\', \'type\': \'Éphémère\', \'flavor\': "« Nombreux sont ceux qui confondent mysticisme et spiritualité, et qui croient que l\'homme ne peut que ramper, si la religion ne le soulève ; qui croient que seule la religion peut empêcher l\'homme de ramper. » —André Gide", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98212&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f1e6e20-4e9a-4d43-a8b4-82933191c211\', \'multiverseId\': 98212}, \'multiverseid\': 98212}, {\'name\': \'Giorno Sacro\', \'text\': \'Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Il giorno degli Spiriti; il tranquillo rifugio della mia anima/ Che nessuno disturbi" —Henry Vaughan, "La Notte"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98932&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfc2eac3-17c8-4dcf-8bb1-e9241b9e7576\', \'multiverseId\': 98932}, \'multiverseid\': 98932}, {\'name\': \'聖なる日\', \'text\': \'このターンに与えられるすべての戦闘ダメージを軽減し、０にする。\', \'type\': \'インスタント\', \'flavor\': \'精霊の日、わが魂静かに安らぐ/誰にも邪魔はさせぬ！ ――ヘンリー・ヴォーガン「夜」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99292&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6ecf263c-6f2f-47c8-8894-0aa7a33d7c54\', \'multiverseId\': 99292}, \'multiverseid\': 99292}, {\'name\': \'Dia Sagrado\', \'text\': \'Previne todo o dano de combate que seria causado neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O dia dos Espíritos; refúgio tranqüilo de minh\\\'alma / Que ninguém perturba" — Henry Vaughan, "A Noite"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99652&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29b54f7e-9f13-4436-aa8a-ee27afb5426c\', \'multiverseId\': 99652}, \'multiverseid\': 99652}, {\'name\': \'Святой день\', \'text\': \'Предотвратите все боевые повреждения, которые будут нанесены в этот ход.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Приходит время духов. Нет покоя, / Хотя ничто не беспокоит душу". — Генри Воган, "Ночь"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109923&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'70397e0e-b25b-4fb1-beca-5be2b7982784\', \'multiverseId\': 109923}, \'multiverseid\': 109923}, {\'name\': \'圣日\', \'text\': \'于本回合中，防止将造成的所有战斗伤害。\', \'type\': \'瞬间\', \'flavor\': \'「精神的白昼；性灵静憩之处／且不受搅扰！」 ～亨利‧冯恩，「夜」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97852&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'41d58017-2e28-49f6-a931-03cc10144af4\', \'multiverseId\': 97852}, \'multiverseid\': 97852}]', '[{\'name\': \'Feigheit\', \'text\': \'Immer wenn eine Kreatur das Ziel eines Zauberspruchs oder einer Fähigkeit wird, bringe diese Kreatur auf die Hand ihres Besitzers zurück. (Der Zauberspruch bzw. die Fähigkeit hat keine Auswirkungen auf sie.)\', \'type\': \'Verzauberung\', \'flavor\': \'„Der Feige stirbt schon vielmal, eh er stirbt, Die Tapfern kosten einmal nur den Tod." —William Shakespeare, Julius Caesar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98488&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3fa4a7d-8e2e-407a-a8d7-848bb971080a\', \'multiverseId\': 98488}, \'multiverseid\': 98488}, {\'name\': \'Cobardía\', \'text\': \'Siempre que una criatura sea objetivo de un hechizo o habilidad, regresa esa criatura a la mano de su propietario. (El hechizo o la habilidad no la afectarán.)\', \'type\': \'Encantamiento\', \'flavor\': \'"Los cobardes mueren muchas veces antes de morir; los valientes mueren sólo una vez." —William Shakespeare, Julio César\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99928&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'55b6e92a-a3c3-417c-9d09-35aff3f58196\', \'multiverseId\': 99928}, \'multiverseid\': 99928}, {\'name\': \'Couardise\', \'text\': "À chaque fois qu\'une créature devient la cible d\'un sort ou d\'une capacité, renvoyez cette créature dans la main de son propriétaire. (Elle ne sera pas affectée par le sort ou la capacité.)", \'type\': \'Enchantement\', \'flavor\': "« La plus grande couardise consiste à éprouver sa puissance sur la faiblesse d\'autrui. » —Jacques Audiberti", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98128&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'944b5323-87a4-45c4-88a9-b0fe70ccd3bd\', \'multiverseId\': 98128}, \'multiverseid\': 98128}, {\'name\': \'Codardia\', \'text\': "Ogniqualvolta una creatura diventa il bersaglio di una magia o di un\'abilità, il proprietario riprende in mano quella creatura. (Non subisce l\'effetto della magia o dell\'abilità.)", \'type\': \'Incantesimo\', \'flavor\': \'"I codardi muoiono molte volte prima dell\\\'ultima dipartita; I coraggiosi assaporano il gusto della morte solo una volta." —William Shakespeare, Giulio Cesare\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98848&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4718cf13-71fb-4d61-a650-7f0769a989eb\', \'multiverseId\': 98848}, \'multiverseid\': 98848}, {\'name\': \'卑怯\', \'text\': \'いずれかのクリーチャーが呪文や能力の対象になるたび、そのクリーチャーをオーナーの手札に戻す。 （それはその呪文や能力の影響は受けない。）\', \'type\': \'エンチャント\', \'flavor\': \'臆病者は死する前に何度も死とまみえ、 勇者は生涯一度しか死を味わわぬ。 ――ウィリアム・シェークスピア「ジュリアス・シーザー」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99208&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'234be570-2ec5-442c-8584-bb7f694be101\', \'multiverseId\': 99208}, \'multiverseid\': 99208}, {\'name\': \'Covardia\', \'text\': \'Toda vez que uma criatura tornar-se alvo de uma mágica ou habilidade, devolva-a para a mão de seu dono. (Ela não será afetada pela mágica ou habilidade.)\', \'type\': \'Encantamento\', \'flavor\': \'"Os covardes morrem muitas vezes antes de suas mortes; Os bravos jamais provam o sabor da morte mais de uma vez." — William Shakespeare, Júlio César\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99568&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b3f3d4e9-a259-4dd1-b50a-ba54159b2c8e\', \'multiverseId\': 99568}, \'multiverseid\': 99568}, {\'name\': \'Трусость\', \'text\': \'Каждый раз, когда существо становится целью заклинания или способности, верните существо в руку владельца. (Заклинание или способность на него не подействуют).\', \'type\': \'Чары\', \'flavor\': \'"Трус умирает много раз до смерти, А храбрый смерть один лишь раз вкушает" — Уильям Шекспир, Юлий Цезарь\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109839&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b2b3f4c-cacc-46b9-96c9-7758d21e5188\', \'multiverseId\': 109839}, \'multiverseid\': 109839}, {\'name\': \'怯懦\', \'text\': \'每当一个生物成为咒语或异能的目标时，将该生物移回其拥有者手上。 （此生物不会受到该咒语或异能的影响）\', \'type\': \'结界\', \'flavor\': \'「懦夫死过好多次； 勇士只死一次。」 ～威廉‧莎士比亚，《凯撒大帝》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97768&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a2f490fa-1b35-4ab1-ac99-743fca519ab7\', \'multiverseId\': 97768}, \'multiverseid\': 97768}]', '[{\'name\': \'Feldscher\', \'text\': \'{T}: Verhindere den nächsten 1 Schadenspunkt, der in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt würde.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Heiler erlangen schließlich die göttliche Gabe geistiger und körperlicher Einheit. Den Ergebensten von ihnen wird zusätzlich die Fähigkeit zuteil, körperliche Gesundheit an andere weiterzugeben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98692&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c3ac7556-ae2d-49d1-ac14-e41bee32574e\', \'multiverseId\': 98692}, \'multiverseid\': 98692}, {\'name\': \'Sanador samita\', \'text\': \'{T}: Prevén el siguiente 1 punto de daño que se le fuera a hacer a la criatura o jugador objetivo este turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Los curanderos finalmente adquieren los dones divinos de la integridad espiritual y física. A los más devotos también les conceden la habilidad de pasar la integridad física a otros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100132&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'706df0cc-872b-4ece-9c6b-272f0600c3b4\', \'multiverseId\': 100132}, \'multiverseid\': 100132}, {\'name\': \'Guérisseur sanctif\', \'text\': \'{T} : Prévenez, ce tour-ci, la prochaine 1 blessure qui devrait être infligée à une cible, créature ou joueur.\', \'type\': \'Créature : humain et clerc\', \'flavor\': \'Les guérisseurs finissent par acquérir les dons divins de plénitude physique et spirituelle. Les plus fervents se voient donner la capacité de passer cette plénitude à autrui.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98332&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'48cb586a-f29b-418e-8295-a25e8b9cc1ea\', \'multiverseId\': 98332}, \'multiverseid\': 98332}, {\'name\': \'Guaritore Bianco\', \'text\': \'{T}: Previeni il prossimo punto danno che verrebbe inflitto a una creatura o a un giocatore bersaglio in questo turno.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': "I guaritori acquisiscono essenzialmente i doni divini dell\'integrità fisica e spirituale. Solo i più devoti tra loro ricevono anche l\'abilità di passare ad altri l\'integrità fisica.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99052&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f61b6ef2-99d1-4833-ad97-0430bb782929\', \'multiverseId\': 99052}, \'multiverseid\': 99052}, {\'name\': \'サマイトの癒し手\', \'text\': \'{T}：クリーチャー１体かプレイヤー１人を対象とする。このターン、次にそれに与えられるダメージを１点軽減する。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'癒し手は、最終的には、霊的かつ肉体的な完全さという天の賜物を獲得する。 最も献身的な者はまた、その肉体的な完全さを他者に分け与える力を授かる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99412&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'496c2af0-3019-4fca-8f73-6b89b100a77d\', \'multiverseId\': 99412}, \'multiverseid\': 99412}, {\'name\': \'Curandeiro Samita\', \'text\': \'{T}: Previne o próximo 1 ponto de dano que seria causado à criatura ou ao jogador alvo neste turno.\', \'type\': \'Criatura — Clérigo Humano\', \'flavor\': \'Os curandeiros acabam por adquirir os dons divinos da integridade física e espiritual. Aos mais devotos, também é concedida a habilidade de passar a integridade física para outros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99772&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4e0281f4-8a41-4a81-94c5-e119b50dda1d\', \'multiverseId\': 99772}, \'multiverseid\': 99772}, {\'name\': \'Самитский лекарь\', \'text\': \'{T}: Предотвратите следующее 1 повреждение, которое будет нанесено целевому существу или игроку в этот ход.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Лекари получают божественный дар духовной и физической цельности. А самым лучшим из них даруется способность передавать эту цельность окружающим.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110043&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5916cf7e-a4f0-4d39-a4b9-26b3a45b4fae\', \'multiverseId\': 110043}, \'multiverseid\': 110043}, {\'name\': \'撒姆尼人的医疗员\', \'text\': \'{T}：于本回合中，防止接下来将对目标生物或牌手造成的1点伤害。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'医疗员们终究会得到神赐的健全身心。 其中最虔诚者还将获赐使他人身体健全的能力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97972&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9190ba84-94f2-44b8-a838-e486dbb69ed6\', \'multiverseId\': 97972}, \'multiverseid\': 97972}]', "[{'name': 'Feldschmiede', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {W}. Die Feldschmiede fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98458&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fa0574ee-da64-48d8-83dd-a3d5039a8035', 'multiverseId': 98458}, 'multiverseid': 98458}, {'name': 'Forja del campo de batalla', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {R} o {W} a tu reserva de maná. La Forja del campo de batalla te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99898&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e7afafe5-39b5-4600-b7d2-b563f3a9dfb1', 'multiverseId': 99898}, 'multiverseid': 99898}, {'name': 'Forge de campagne', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {R} ou {W} à votre réserve. La Forge de campagne vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98098&type=card', 'language': 'French', 'identifiers': {'scryfallId': '979805ce-8f4d-4307-a8cb-47dd31a62a66', 'multiverseId': 98098}, 'multiverseid': 98098}, {'name': 'Forgia da Campo', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {R} o {W} alla tua riserva di mana. La Forgia da Campo ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98818&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0cee66b3-ea41-4b11-b1d1-aa741999c7a4', 'multiverseId': 98818}, 'multiverseid': 98818}, {'name': '戦場の鍛冶場', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{R}か{W}を加える。 戦場の鍛冶場はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99178&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bc343fb2-b2ca-4f42-bc68-7d2ddbd38902', 'multiverseId': 99178}, 'multiverseid': 99178}, {'name': 'Forjaria do Campo de Batalha', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {R} ou {W} à sua reserva de mana. Forjaria do Campo de Batalha causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99538&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fd9aaec9-18ea-47b6-b1cf-a930d1f48636', 'multiverseId': 99538}, 'multiverseid': 99538}, {'name': 'Кузница на поле боя', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {R} или {W} в запас маны. Кузница на поле боя наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109809&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5564947f-4039-42e6-9ca3-3bd7db0bebe1', 'multiverseId': 109809}, 'multiverseid': 109809}, {'name': '战场融炉', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{R}或{W}到你的法术力池中。 战场融炉对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97738&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '40d9e8c5-838d-4732-9b31-c658c7a1b0f5', 'multiverseId': 97738}, 'multiverseid': 97738}]", '[{\'name\': \'Fellwarstein\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana einer Farbe, das ein Land, das ein Gegner kontrolliert, produzieren könnte.\', \'type\': \'Artefakt\', \'flavor\': \'„Was besitzt du, das ich nicht erlangen kann?" —Mairsil, der Täuscher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa318e41-537d-47d5-ae7a-a0601b4c84c3\', \'multiverseId\': 98524}, \'multiverseid\': 98524}, {\'name\': \'Piedra de Fellwar\', \'text\': \'{T}: Agrega a tu reserva de maná un maná de cualquier color que pudiera producir una tierra que controle un oponente.\', \'type\': \'Artefacto\', \'flavor\': \'"¿Qué tienes que yo no pueda obtener?" —Mairsil, el Usurpador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99964&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8173fcdd-eb62-46e2-a7a9-acfd18290f31\', \'multiverseId\': 99964}, \'multiverseid\': 99964}, {\'name\': \'Pierre de Guermont\', \'text\': "{T} : Ajoutez à votre réserve un mana de n\'importe quelle couleur qu\'un terrain contrôlé par un adversaire pourrait produire.", \'type\': \'Artefact\', \'flavor\': "« Qu\'avez-vous que je ne puisse obtenir ? » —Mairsil, le prétendant", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98164&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d6c9e6b-9c4f-46e4-91dc-a91e3923387e\', \'multiverseId\': 98164}, \'multiverseid\': 98164}, {\'name\': \'Pietra Fellwar\', \'text\': \'{T}: Aggiungi alla tua riserva un mana di un qualsiasi colore che una terra controllata da un avversario può produrre.\', \'type\': \'Artefatto\', \'flavor\': \'"Cosa possiedi che io non possa ottenere?" —Mairsil, il Pretendente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'74138f55-9cda-41b1-bb7c-0bce256dd885\', \'multiverseId\': 98884}, \'multiverseid\': 98884}, {\'name\': \'友なる石\', \'text\': \'{T}：あなたのマナ・プールに、いずれかの対戦相手がコントロールする土地が生み出すことのできる色１色のマナ１点を加える。\', \'type\': \'アーティファクト\', \'flavor\': \'お前は、私が手に入れられない何を持っているのだ？ ――詐欺師メアシル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99244&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e25c1e15-74f1-4c83-a117-bd6039b76cb2\', \'multiverseId\': 99244}, \'multiverseid\': 99244}, {\'name\': \'A Pedra Fellwar\', \'text\': \'{T}: Adiciona à sua reserva de mana uma mana de qualquer cor que um terreno controlado por um oponente possa gerar.\', \'type\': \'Artefato\', \'flavor\': \'"O que você possui que eu não posso conseguir?" — Mairsil, o Impostor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99604&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63e08cf7-98e1-4421-84c6-df9f19747042\', \'multiverseId\': 99604}, \'multiverseid\': 99604}, {\'name\': \'Фелворский камень\', \'text\': \'{T}: Добавьте к запасу маны один пункт маны того цвета, который может производить любая из земель оппонента.\', \'type\': \'Артефакт\', \'flavor\': \'"Что у вас есть такое, что я не могу заполучить?" — Майрсил Притворщик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109875&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e3793e94-080c-4005-b443-494f97f250bc\', \'multiverseId\': 109875}, \'multiverseid\': 109875}, {\'name\': \'战野之石\', \'text\': \'{T}：加一点法术力到你的法术力池中，其颜色为由对手操控的地能产生之任一颜色。\', \'type\': \'神器\', \'flavor\': \'「你有的东西，哪一样我得不到？」 ～伪装者梅西尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97804&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'999802aa-b5cf-4326-a302-8a7f64d6eea3\', \'multiverseId\': 97804}, \'multiverseid\': 97804}]', '[{\'name\': \'Feuermasse\', \'text\': \'Die Feuermasse fügt jeder Kreatur 2 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Wenn die Luft brennt, atmet nur der Tod tief ein." —Bogardanischer Magier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98665&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e0e5768-450d-4f2d-9b4e-6ce2b67de619\', \'multiverseId\': 98665}, \'multiverseid\': 98665}, {\'name\': \'Detonación ígnea\', \'text\': \'La Detonación ígnea hace 2 puntos de daño a cada criatura.\', \'type\': \'Conjuro\', \'flavor\': \'"Cuando el aire quema, sólo la muerte respira profundo." —Mago de Bogardan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100105&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f6d68fa8-6d62-43c6-a7da-ce7383d5b75c\', \'multiverseId\': 100105}, \'multiverseid\': 100105}, {\'name\': \'Pyroclasme\', \'text\': \'Le Pyroclasme inflige 2 blessures à chaque créature.\', \'type\': \'Rituel\', \'flavor\': "« Quand l\'air brûle, seuls les morts respirent encore. » —Un mage de Bogardân", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98305&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'04ebb278-78af-445c-8c83-60e6751f1be4\', \'multiverseId\': 98305}, \'multiverseid\': 98305}, {\'name\': \'Piroclasma\', \'text\': \'Il Piroclasma infligge 2 danni a ogni creatura.\', \'type\': \'Stregoneria\', \'flavor\': \'"Quando l\\\'aria brucia, solo la morte ne trae sollievo." —Mago di Bogardan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99025&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53b5bb3e-739c-4015-9b4f-ed9ebb6ca186\', \'multiverseId\': 99025}, \'multiverseid\': 99025}, {\'name\': \'紅蓮地獄\', \'text\': \'紅蓮地獄は各クリーチャーにそれぞれ２点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'大気が燃えるとき、深呼吸ができるのは死だけです。 ――ボガーダンの魔道士\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99385&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9dd286f7-2669-4c03-8eed-c38abdfb8842\', \'multiverseId\': 99385}, \'multiverseid\': 99385}, {\'name\': \'Piroclasma\', \'text\': \'Piroclasma causa 2 pontos de dano a cada criatura.\', \'type\': \'Feitiço\', \'flavor\': \'"Quando o ar queima, só a morte respira mais fundo." — Mago de Bogardan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99745&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6699d198-b38e-4c50-ada9-b0428ef9da77\', \'multiverseId\': 99745}, \'multiverseid\': 99745}, {\'name\': \'Пироклазм\', \'text\': \'Пироклазм наносит каждому существу 2 повреждения.\', \'type\': \'Волшебство\', \'flavor\': \'"Когда воздух горит, только смерти легко дышится". — Богардский маг\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110016&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ff2391ab-d910-4245-b213-319ab85b50dd\', \'multiverseId\': 110016}, \'multiverseid\': 110016}, {\'name\': \'烈火断层\', \'text\': \'烈火断层对每个生物各造成2点伤害。\', \'type\': \'法术\', \'flavor\': \'「空气燃烧时，只有死亡才能深呼吸。」 ～博卡登法术师\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97945&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f98d5d1a-6078-4ad8-9065-679866961e69\', \'multiverseId\': 97945}, \'multiverseid\': 97945}]', '[{\'name\': \'Feuerodem\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\n{R}: Die verzauberte Kreatur erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98527&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b07c24ab-7c93-4664-9b9e-68b522561d51\', \'multiverseId\': 98527}, \'multiverseid\': 98527}, {\'name\': \'Hálito de fuego\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\n{R}: La criatura encantada obtiene +1/+0 hasta el final del turno.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99967&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3117e81f-aa48-418b-ba5f-5bd2358120d7\', \'multiverseId\': 99967}, \'multiverseid\': 99967}, {\'name\': \'Souffle ardent\', \'text\': "Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\n{R} : La créature enchantée gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98167&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc816169-230f-48b6-b2cb-fa4a6f51d5d9\', \'multiverseId\': 98167}, \'multiverseid\': 98167}, {\'name\': \'Soffio del Drago\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\n{R}: La creatura incantata prende +1/+0 fino alla fine del turno.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a614de86-f482-4f53-8cec-060a7cdf6b1b\', \'multiverseId\': 98887}, \'multiverseid\': 98887}, {\'name\': \'炎のブレス\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\n{R}：エンチャントされているクリーチャーはターン終了時まで+1/+0の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99247&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8e27e5c6-7396-40f5-83ff-a5d1493fac65\', \'multiverseId\': 99247}, \'multiverseid\': 99247}, {\'name\': \'Hálito de Fogo\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\n{R}: A criatura encantada recebe +1/+0 até o final do turno.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99607&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90845fed-60f4-4007-b950-54df6f484168\', \'multiverseId\': 99607}, \'multiverseid\': 99607}, {\'name\': \'Огненное дыхание\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\n{R}: Зачарованное существо получает +1/+0 до конца хода.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109878&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'67087b12-e497-49fc-b866-f8a5531477d8\', \'multiverseId\': 109878}, \'multiverseid\': 109878}, {\'name\': \'炎息\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n{R}：受此结界的生物得+1/+0直到回合结束。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97807&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c506483-82ca-41cb-ac23-604216c832cf\', \'multiverseId\': 97807}, \'multiverseid\': 97807}]', '[{\'name\': \'Flammenblut-Koloss\', \'text\': \'{R}, opfere den Flammenblut-Koloss: Der Flammenblut-Koloss fügt allen Kreaturen und allen Spielern 6 Schadenspunkte zu.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Es kostet ihn viel Kraft, sich zusammenzunehmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98468&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'30b43d3d-d018-4ed7-8d9b-b3b3b57b68b2\', \'multiverseId\': 98468}, \'multiverseid\': 98468}, {\'name\': \'Coloso Sangrefuego\', \'text\': \'{R}, sacrificar el Coloso Sangrefuego: El Coloso Sangrefuego hace 6 puntos de daño a cada criatura y a cada jugador.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Necesitó toda su fuerza para contener su fuego interno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99908&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2d6de21-9542-41a5-8aa5-1b9bcb3a85a4\', \'multiverseId\': 99908}, \'multiverseid\': 99908}, {\'name\': \'Colosse hématopyre\', \'text\': \'{R}, sacrifiez le Colosse hématopyre : Le Colosse hématopyre inflige 6 blessures à chaque créature et à chaque joueur.\', \'type\': \'Créature : géant\', \'flavor\': "Contenir le feu qui l\'habite lui prend toute sa force.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98108&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ccf6298-d89e-44af-9343-761fa97df0ae\', \'multiverseId\': 98108}, \'multiverseid\': 98108}, {\'name\': \'Colosso Sangue-di-Fuoco\', \'text\': \'{R}, Sacrifica il Colosso Sangue-di-Fuoco: Il Colosso Sangue-di-Fuoco infligge 6 danni a ogni creatura e a ogni giocatore.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Occorse tutta la sua forza per contenere le fiamme che ardevano dentro di lui.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98828&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2e75ccd9-ba39-4631-ab70-692f6e53f6e1\', \'multiverseId\': 98828}, \'multiverseid\': 98828}, {\'name\': \'沸血の巨像\', \'text\': \'{R}, 沸血の巨像を生け贄に捧げる：沸血の巨像は、各クリーチャーと各プレイヤーにそれぞれ６点のダメージを与える。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'体内の炎を抑えるには、あらんかぎりの力を使わなければならなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99188&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1d3a960f-4dd9-47e2-91d5-2f5c7c0e74e0\', \'multiverseId\': 99188}, \'multiverseid\': 99188}, {\'name\': \'Colosso Sangue Quente\', \'text\': \'{R}, Sacrifique Colosso Sangue Quente: Colosso Sangue Quente causa 6 pontos de dano a cada criatura e a cada jogador.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Ele precisou de toda a sua força para conter o fogo interior.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99548&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7da8d972-f8f5-49d1-bddc-0a40df20587b\', \'multiverseId\': 99548}, \'multiverseid\': 99548}, {\'name\': \'Кроваво-огненный колосс\', \'text\': \'{R}, Принесите Кроваво-огненный колосс в жертву: Кроваво-огненный колосс наносит 6 повреждений каждому существу и каждому игроку.\', \'type\': \'Существо — Гигант\', \'flavor\': \'Ему стоило огромных усилий сдержать огонь внутри себя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109819&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c53ad4c5-3699-4e0b-bda8-cdeb25d2d8e5\', \'multiverseId\': 109819}, \'multiverseid\': 109819}, {\'name\': \'血焰巨像\', \'text\': \'{R}，牺牲血焰巨像：血焰巨像对每个生物和每位牌手各造成6点伤害。\', \'type\': \'生物～巨人\', \'flavor\': \'它得花上全力来维持内在的怒火。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97748&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3eaa73b4-33ad-43d9-a3db-8e02fea5f7ce\', \'multiverseId\': 97748}, \'multiverseid\': 97748}]', '[{\'name\': \'Flammenwelle\', \'text\': \'Die Flammenwelle fügt einem Spieler deiner Wahl und allen Kreaturen, die er kontrolliert, 4 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich höre das Rauschen einer Welle, deren Wasser rot und deren Gischt schwarz ist." —Oracle en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e479c867-02d5-43d9-9421-28304d248e04\', \'multiverseId\': 98529}, \'multiverseid\': 98529}, {\'name\': \'Ola de llamas\', \'text\': \'La Ola de llamas hace 4 puntos de daño al jugador objetivo y a cada criatura que controla.\', \'type\': \'Conjuro\', \'flavor\': \'"Oigo el rugir de una ola cuyas aguas son rojas y cuyas brumas son negras." —Oráculo en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99969&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00fe13cd-c959-4de7-b191-abe467246325\', \'multiverseId\': 99969}, \'multiverseid\': 99969}, {\'name\': \'Vague de flammes\', \'text\': "La Vague de flammes inflige 4 blessures au joueur ciblé et à chaque créature qu\'il contrôle.", \'type\': \'Rituel\', \'flavor\': "« J\'entends rugir une vague dont les eaux sont rouges et l\'écume, noire. » —Oracle en-Vec", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98169&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4bcc5ba6-7368-4e58-b516-2ee4f5254ffb\', \'multiverseId\': 98169}, \'multiverseid\': 98169}, {\'name\': \'Onda di Fiamme\', \'text\': "L\'Onda di Fiamme infligge 4 danni a un giocatore bersaglio e a ogni creatura che egli controlla.", \'type\': \'Stregoneria\', \'flavor\': \'"Odo il fragore di un\\\'onda dalle acque rosse e dai vapori neri." —Oracolo en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98889&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c06e1eb-4f97-4261-94c7-796a0b7aafa1\', \'multiverseId\': 98889}, \'multiverseid\': 98889}, {\'name\': \'炎の波\', \'text\': \'プレイヤー１人を対象とする。炎の波は、そのプレイヤーとそのプレイヤーがコントロールする各クリーチャーにそれぞれ４点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'うねる波の音が聞こえる。その波の水は赤く、その煙は黒い。 ――ヴェクの巫女\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99249&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6463548-395a-47c9-abaa-3712a2174504\', \'multiverseId\': 99249}, \'multiverseid\': 99249}, {\'name\': \'Onda de Chamas\', \'text\': \'Onda de Chamas causa 4 pontos de dano ao jogador alvo e a cada criatura que ele próprio controla.\', \'type\': \'Feitiço\', \'flavor\': \'"Ouço o fragor de uma onda cujas águas são vermelhas e a bruma é negra." — Oráculo en-Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99609&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07fe1f92-6078-4215-91e8-5e066424e629\', \'multiverseId\': 99609}, \'multiverseid\': 99609}, {\'name\': \'Волна пламени\', \'text\': \'Волна пламени наносит 4 повреждения целевому игроку и каждому существу, которое он контролирует.\', \'type\': \'Волшебство\', \'flavor\': \'"Я слышу рев волны. Она несет красные воды и черные туманы". — Оракул эн-Век\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109880&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'075b9d5a-c160-4b2f-ae18-1a1d5e50eefc\', \'multiverseId\': 109880}, \'multiverseid\': 109880}, {\'name\': \'火焰波\', \'text\': \'火焰波对目标牌手以及他所操控的生物各造成4点伤害。\', \'type\': \'法术\', \'flavor\': \'「我听到波浪的狂吼，它的水是红的，浪花是黑的。」 ～维克族神谕使\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97809&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'99662d44-f9cb-4691-b6e7-78c966e3f69c\', \'multiverseId\': 97809}, \'multiverseid\': 97809}]', "[{'name': 'Flaschengnome', 'text': 'Opfere die Flaschengnome: Du erhältst 3 Lebenspunkte dazu.', 'type': 'Artefaktkreatur — Gnom', 'flavor': 'Verstärkungen . . . oder Erfrischungen?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98474&type=card', 'language': 'German', 'identifiers': {'scryfallId': '51f8615a-dc94-4b48-b214-559ec467e0ae', 'multiverseId': 98474}, 'multiverseid': 98474}, {'name': 'Gnomos frasco', 'text': 'Sacrificar los Gnomos frasco: Ganas 3 vidas.', 'type': 'Criatura artefacto — Gnomo', 'flavor': 'Refuerzos o. . . ¿refrescos?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99914&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1319ebaf-216e-474a-aa2b-40629cdfc0e4', 'multiverseId': 99914}, 'multiverseid': 99914}, {'name': 'Glob-gnomes', 'text': 'Sacrifiez les Glob-gnomes : Vous gagnez 3 points de vie.', 'type': 'Créature-artefact : gnome', 'flavor': 'Renforts . . . ou rafraîchissements ?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98114&type=card', 'language': 'French', 'identifiers': {'scryfallId': '16e0c95d-b8f7-4f0e-9419-e92f2ff484ba', 'multiverseId': 98114}, 'multiverseid': 98114}, {'name': 'Gnomi della Bottiglia', 'text': 'Sacrifica gli Gnomi della Bottiglia: Guadagni 3 punti vita.', 'type': 'Creatura Artefatto — Gnomo', 'flavor': 'Rinforzi . . . o rinfreschi?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98834&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4de724c2-fa91-4d27-be18-f61ba3f0c808', 'multiverseId': 98834}, 'multiverseid': 98834}, {'name': 'ボトルのノーム', 'text': 'ボトルのノームを生け贄に捧げる：あなたは３点のライフを得る。', 'type': 'アーティファクト・クリーチャー — ノーム', 'flavor': '補強 … … それとも保養？', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99194&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3609232f-403f-4a79-b4f5-17b185f4dd4c', 'multiverseId': 99194}, 'multiverseid': 99194}, {'name': 'Gnomos de Garrafa', 'text': 'Sacrifique Gnomos de Garrafa: Você ganha 3 pontos de vida.', 'type': 'Criatura Artefato — Gnomo', 'flavor': 'Reforços . . . ou refrescos?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99554&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e9e6e651-8f61-48f5-bb8c-e2ff42dfc354', 'multiverseId': 99554}, 'multiverseid': 99554}, {'name': 'Бутылочные гномы', 'text': 'Принесите Бутылочных гномов в жертву: вы получаете 3 пункта жизни.', 'type': 'Артефактное существо — Гном', 'flavor': 'Подкрепление. . . или прохладительные напитки?', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109825&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '29ee1da4-fd80-4156-beb7-249c2828a16c', 'multiverseId': 109825}, 'multiverseid': 109825}, {'name': '瓶子侏儒', 'text': '牺牲瓶子侏儒：你获得3点生命。', 'type': '神器生物～地侏', 'flavor': '增援. . . 或是点心？', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97754&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c312946b-ad9e-43c0-9320-e31ff8b531ee', 'multiverseId': 97754}, 'multiverseid': 97754}]", '[{\'name\': \'Flickende Finger\', \'text\': \'Verhindere die nächsten 4 Schadenspunkte, die in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt werden würden.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich kann ihre Blutungen stoppen, ihr Fleisch nähen und ihre Knochen flicken. Aber ihre Hoffnung kann ich nicht zurückbringen." —Sanfthand, Kitsune-Heilerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98620&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b730e968-a369-4ab9-9e4c-9a017b7d24c1\', \'multiverseId\': 98620}, \'multiverseid\': 98620}, {\'name\': \'Manos reparadoras\', \'text\': \'Prevén los siguientes 4 puntos de daño que se le fueran a hacer a la criatura o jugador objetivo este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Puedo retener su sangre, cerrar su carne, soldar sus huesos. Pero no puedo devolverles la esperanza." —Mano atenta, sanadora kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100060&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0bb3f0b3-53f1-492a-bc53-ee1b7ad70855\', \'multiverseId\': 100060}, \'multiverseid\': 100060}, {\'name\': \'Mains réparatrices\', \'text\': \'Prévenez, ce tour-ci, les prochaines 4 blessures qui devraient être infligées à une cible, créature ou joueur.\', \'type\': \'Éphémère\', \'flavor\': \'« Je peux éponger leur sang, réparer leurs chairs, souder leurs os. Mais je ne peux pas leur redonner espoir. » —Tendre-main, guérisseuse kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98260&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3cf16ab-79d5-4245-ad4f-33022e0fb93d\', \'multiverseId\': 98260}, \'multiverseid\': 98260}, {\'name\': \'Mani Curatrici\', \'text\': \'Previeni i prossimi 4 danni che verrebbero inflitti a una creatura o a un giocatore bersaglio in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Posso tamponare il loro sangue, rattoppare la loro carne, aggiustare le loro ossa. Ma non posso restituire loro la speranza." —Mano-Gentile, guaritore kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98980&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'427757d5-2348-46b4-90e7-eedba9cd9f9f\', \'multiverseId\': 98980}, \'multiverseid\': 98980}, {\'name\': \'繕いの手\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。このターン、それに与えられる次のダメージを４点軽減する。\', \'type\': \'インスタント\', \'flavor\': \'私は血を止めることも、身体を癒すことも、骨を接ぐこともできよう。 だが希望を取り戻すことはできぬ。 ――狐の癒し手、和手\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'00d656e5-4993-41a7-9cde-e4d707262b13\', \'multiverseId\': 99340}, \'multiverseid\': 99340}, {\'name\': \'Mãos Reparadoras\', \'text\': \'Previne os próximos 4 pontos de dano que seriam causados à criatura ou ao jogador alvo neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Posso estancar-lhes o sangue, remendar-lhes a carne e unir-lhes os ossos. Mas não sou capaz de restaurar-lhes a esperança." — Mão-Zelosa, curandeira kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99700&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a73a561-62da-4cea-928e-4c8018561460\', \'multiverseId\': 99700}, \'multiverseid\': 99700}, {\'name\': \'Умелые руки\', \'text\': \'Предотвратите следующие 4 повреждения, которые будут нанесены целевому существу или игроку в этот ход.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Я умею останавливать кровь, штопать плоть и сращивать кости. Только вот надежды я возвращать не умею". — Мягкие Руки, лекарь китсуне\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109971&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'870af311-1b18-4aad-ad50-ce568574bb91\', \'multiverseId\': 109971}, \'multiverseid\': 109971}, {\'name\': \'施以援手\', \'text\': \'于本回合中，防止接下来将对目标生物或牌手造成的4点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「我能替他们止住出血，修补伤口，接合断骨。 但我无法让他们重拾信念。」 ～狐医和手\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97900&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'090aeea1-26d8-44d6-9195-fd687209e506\', \'multiverseId\': 97900}, \'multiverseid\': 97900}]', '[{\'name\': \'Flimmergeist\', \'text\': \'{0}: Bringe den Flimmergeist auf die Hand seines Besitzers zurück.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Schau es nicht an Vielleicht geht es von alleine weg" —Ib Halbherz, Goblin-Taktiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98466&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'380f22db-87f5-4627-a636-2c7bcbbe0af9\', \'multiverseId\': 98466}, \'multiverseid\': 98466}, {\'name\': \'Espíritu titilante\', \'text\': \'{0}: Regresa el Espíritu titilante a la mano de su propietario.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"¡No lo mires ¡A lo mejor se va" —Ib Corazón de ratón, estratega trasgo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99906&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'818237fe-2f99-42e6-a34c-80d7380c74d1\', \'multiverseId\': 99906}, \'multiverseid\': 99906}, {\'name\': \'Esprit fugace\', \'text\': "{0} : Renvoyez l\'Esprit fugace dans la main de son propriétaire.", \'type\': \'Créature : esprit\', \'flavor\': "« Ne le regardez pas Il finira bien par s\'en aller » —Ib Micœur, tacticien gobelin", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98106&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8a15366-9e2b-409f-a88a-93ebc179608b\', \'multiverseId\': 98106}, \'multiverseid\': 98106}, {\'name\': \'Spirito Intermittente\', \'text\': \'{0}: Il proprietario riprende in mano lo Spirito Intermittente.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"Non guardarlo Magari se ne andrà" —Ib Halfheart, stratega goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98826&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65864808-df44-47d6-8a83-33344879eedd\', \'multiverseId\': 98826}, \'multiverseid\': 98826}, {\'name\': \'またたくスピリット\', \'text\': \'{0}：またたくスピリットをオーナーの手札に戻す。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'見るんじゃねえ！ 消えてくれるかも知れねえだろ！ ――ゴブリンの戦術家、イブ・ハーフハート\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99186&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b32b5403-b2a4-47a9-8f0f-cdf336bf8977\', \'multiverseId\': 99186}, \'multiverseid\': 99186}, {\'name\': \'Espírito Lampejante\', \'text\': \'{0}: Devolve Espírito Lampejante para a mão de seu dono.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"Não olhe para ele Talvez ele vá embora" — Ib Halfheart, estrategista goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99546&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2030d9cb-0934-4fb2-a315-3396962c35cf\', \'multiverseId\': 99546}, \'multiverseid\': 99546}, {\'name\': \'Мерцающий дух\', \'text\': \'{0}: Верните Мерцающий дух в руку владельца.\', \'type\': \'Существо — Дух\', \'flavor\': \'"Не смотри на него Может, он уберется прочь" — Иб Халфхарт, тактик гоблинов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109817&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'491aa6e5-c0f1-4270-8962-fd58e942be67\', \'multiverseId\': 109817}, \'multiverseid\': 109817}, {\'name\': \'闪动精怪\', \'text\': \'{0}：将闪动精怪移回其拥有者手上。\', \'type\': \'生物～精怪\', \'flavor\': \'「别看它！ 搞不好它会跑掉的！」 ～精灵战术家依部．哈夫哈特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97746&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'67811918-21a2-417b-9012-98c7912186ff\', \'multiverseId\': 97746}, \'multiverseid\': 97746}]', "[{'name': 'Flugfähigkeit', 'text': 'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur hat Flugfähigkeit. (Sie kann nur von fliegenden Kreaturen geblockt werden.)', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98532&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8e5ef257-403b-4870-9927-41a08611a85e', 'multiverseId': 98532}, 'multiverseid': 98532}, {'name': 'Volar', 'text': 'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada tiene la habilidad de volar. (No puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99972&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '696c9076-c3c5-4bb0-a69a-9f718a76c900', 'multiverseId': 99972}, 'multiverseid': 99972}, {'name': 'Vol', 'text': 'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée a le vol. (Elle ne peut être bloquée que par des créatures avec le vol.)', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98172&type=card', 'language': 'French', 'identifiers': {'scryfallId': '27bdb732-fcc4-4139-acf9-f142d98c501d', 'multiverseId': 98172}, 'multiverseid': 98172}, {'name': 'Volare', 'text': 'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata ha volare. (Non può essere bloccata tranne che da creature con volare.)', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98892&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '316a6557-3169-41f5-99b9-7e137dd636b0', 'multiverseId': 98892}, 'multiverseid': 98892}, {'name': '飛行', 'text': 'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは飛行を持つ。 （それは飛行を持たないクリーチャーによってブロックされない。）', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99252&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '88a3e6ee-b25c-41eb-bc81-828ee0c30387', 'multiverseId': 99252}, 'multiverseid': 99252}, {'name': 'Vôo', 'text': 'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada tem a habilidade de voar. (Ela só pode ser bloqueada por criaturas com a habilidade de voar.)', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99612&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '356519a3-859d-485c-9212-9cddbf398b68', 'multiverseId': 99612}, 'multiverseid': 99612}, {'name': 'Полет', 'text': 'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает способность полета. (Оно может быть заблокировано только существом со способностью полета).', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109883&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a4f5d28f-b1c5-4dc6-b043-3600304a3ef0', 'multiverseId': 109883}, 'multiverseid': 109883}, {'name': '舞空术', 'text': '生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物具有飞行异能。 （只有具飞行异能的生物才能阻挡它。）', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97812&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2438fe03-8fb8-46f5-a911-562371a03c4a', 'multiverseId': 97812}, 'multiverseid': 97812}]", '[{\'name\': \'Flussbär\', \'text\': \'Inseltarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler eine Insel kontrolliert.)\', \'type\': \'Kreatur — Bär\', \'flavor\': \'Die Bären waren für Jahrhunderte auf einer Insel isoliert, bis die Insel eines Tages sank und die Bären nicht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98682&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6754318-1659-41b8-9d68-1bb545479350\', \'multiverseId\': 98682}, \'multiverseid\': 98682}, {\'name\': \'Oso de río\', \'text\': \'Cruza islas. (Esta criatura es imbloqueable mientras el jugador defensor controle una isla.)\', \'type\': \'Criatura — Oso\', \'flavor\': \'Los osos habían estado aislados en una isla durante cientos de años, hasta que la isla se hundió y los osos no.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100122&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b7c194d-3363-4656-baa8-7217898d4b18\', \'multiverseId\': 100122}, \'multiverseid\': 100122}, {\'name\': \'Ours des rivières\', \'text\': \'Traversée des îles (Cette créature est imblocable tant que le joueur défenseur contrôle au moins une île.)\', \'type\': \'Créature : ours\', \'flavor\': "Les ours avaient été isolés sur une île pendant des centaines d\'années. L\'île fut engloutie, mais pas les ours.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dfcaf75f-5f3b-4996-ad42-f53e6c02cfd8\', \'multiverseId\': 98322}, \'multiverseid\': 98322}, {\'name\': \'Orso di Fiume\', \'text\': "Passa-isole (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla almeno un\'Isola.)", \'type\': \'Creatura — Orso\', \'flavor\': "Gli orsi sono stati emarginati su un\'isola per centinaia di anni, finché l\'isola è affondata e gli orsi no.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99042&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d19cef38-df35-4ad3-889f-e60f15ca73ef\', \'multiverseId\': 99042}, \'multiverseid\': 99042}, {\'name\': \'河熊\', \'text\': \'島渡り （このクリーチャーは防御プレイヤーが島をコントロールしている限りブロックされない。）\', \'type\': \'クリーチャー — 熊\', \'flavor\': \'その熊がある島に隔離されたまま数百年が経過した。そしてその島は水中に没したが、熊は沈まなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99402&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dbfd427c-a569-426e-80eb-c1373dec1fff\', \'multiverseId\': 99402}, \'multiverseid\': 99402}, {\'name\': \'Urso do Rio\', \'text\': \'Travessia de ilha (Esta criatura não pode ser bloqueada desde que o jogador defensor controle uma Ilha.)\', \'type\': \'Criatura — Urso\', \'flavor\': \'Os ursos foram isolados numa ilha durante séculos, até o dia em que a ilha afundou e os ursos não.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99762&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3294719-0c60-422b-b453-dbddafcf3ae1\', \'multiverseId\': 99762}, \'multiverseid\': 99762}, {\'name\': \'Речной медведь\', \'text\': \'Знание островов (Это существо невозможно заблокировать, пока обороняющийся игрок контролирует Остров).\', \'type\': \'Существо — Медведь\', \'flavor\': \'Медведи жили на острове, отрезанном от всего остального мира; потом остров затонул, а медведи остались.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110033&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ccacc1b-7103-4c5e-a041-e687f2238e57\', \'multiverseId\': 110033}, \'multiverseid\': 110033}, {\'name\': \'河流棕熊\', \'text\': \'海岛行者（只要防御牌手操控海岛，此生物便不能被阻挡）\', \'type\': \'生物～熊\', \'flavor\': \'数百年前，这些熊便在某个与世隔绝的岛屿上生息；之后岛屿沉入汪洋，熊群却依然留存。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97962&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f2f0805-9ad0-44e7-a142-9f0120c386fa\', \'multiverseId\': 97962}, \'multiverseid\': 97962}]', '[{\'name\': \'Flüchtige Erscheinung\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\n{1}{U}: Bringe die Flüchtige Erscheinung auf die Hand ihres Besitzers zurück.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'„Nicht allen erscheinen Unsterbliche sichtbar." —Homer, Odyssee\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd16ec9e-bc6e-42df-8339-c1c949400b5a\', \'multiverseId\': 98531}, \'multiverseid\': 98531}, {\'name\': \'Imagen efímera\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\n{1}{U}: Regresa la Imagen efímera a la mano de su propietario.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'"Ten cuidado o perderás lo que tienes por tratar de apoderarte del reflejo." —Esopo, Fábulas, versión de Jacobs\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99971&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'801619d4-a977-4259-9dc9-e96b49723ca2\', \'multiverseId\': 99971}, \'multiverseid\': 99971}, {\'name\': \'Image fugitive\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\n{1}{U} : Renvoyez l\'Image fugitive dans la main de son propriétaire.", \'type\': \'Créature : illusion\', \'flavor\': "« L\'illusion est une foi démesurée. » —Honoré de Balzac", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98171&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e7f58a22-a45b-4e7e-a8f1-31c0eadec09e\', \'multiverseId\': 98171}, \'multiverseid\': 98171}, {\'name\': \'Immagine Sfuggente\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\n{1}{U}: Il proprietario riprende in mano l\'Immagine Sfuggente.", \'type\': \'Creatura — Illusione\', \'flavor\': \'"Fai attenzione a non perdere la sostanza nel dare la caccia alle ombre." —Esopo, Favole\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98891&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'024908c1-28dd-4540-8405-83570c2296a6\', \'multiverseId\': 98891}, \'multiverseid\': 98891}, {\'name\': \'束の間の映像\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n{1}{U}：束の間の映像をオーナーの手札に戻す。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'影をつかもうとして実態を逃さないことだ。 ――イソップ「寓話」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99251&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1014d5b8-4152-4a59-a97e-068c58a225fa\', \'multiverseId\': 99251}, \'multiverseid\': 99251}, {\'name\': \'Visão Fugaz\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\n{1}{U}: Devolve Visão Fugaz para a mão de seu dono.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'"Cuidado para não perderes a substância por tentares agarrar a sombra." — Fábulas de Esopo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99611&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a72a8be1-2bc1-4967-bda2-47ffa90fa19d\', \'multiverseId\': 99611}, \'multiverseid\': 99611}, {\'name\': \'Мимолетное видение\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\n{1}{U}: Верните мимолетное видение в руку владельца.\', \'type\': \'Существо — Иллюзия\', \'flavor\': \'"Смотри, не упусти суть, гоняясь за тенью". — Эзоп, Басни, перев. Jacobs\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109882&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8bee27e9-c29d-4c4d-952b-d1f540e58957\', \'multiverseId\': 109882}, \'multiverseid\': 109882}, {\'name\': \'飞逝幻象\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n{1}{U}：将飞逝幻象移回其拥有者手上。\', \'type\': \'生物～虚影\', \'flavor\': \'「勿因捕捉影子而失去财产。」 ～《伊索寓言》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97811&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dc22fff2-e3e0-4f80-9d99-9308aa91da7a\', \'multiverseId\': 97811}, \'multiverseid\': 97811}]', '[{\'name\': \'Form des Drachens\', \'text\': \'Zu Beginn deines Versorgungssegments fügt Form des Drachens einer Kreatur oder einem Spieler deiner Wahl 5 Schadenspunkte zu.\\nAm Ende jedes Zuges geht dein Lebenspunktestand auf 5.\\nNichtfliegende Kreaturen können dich nicht angreifen.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98542&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'901fd61f-d92a-4d1e-912d-be5737a3da2b\', \'multiverseId\': 98542}, \'multiverseid\': 98542}, {\'name\': \'Forma del dragón\', \'text\': \'Al comienzo de tu mantenimiento, la Forma del dragón hace 5 puntos de daño a la criatura o jugador objetivo.\\nAl final de cada turno, tu total de vida es 5.\\nLas criaturas que no tengan la habilidad de volar no pueden atacarte.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99982&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce0dde87-a422-4871-aaf5-5e0158889acf\', \'multiverseId\': 99982}, \'multiverseid\': 99982}, {\'name\': \'Forme du dragon\', \'text\': \'Au début de votre entretien, la Forme du dragon inflige 5 blessures à une cible, créature ou joueur.\\nÀ la fin de chaque tour, votre total de points de vie devient 5.\\nLes créatures sans le vol ne peuvent pas vous attaquer.\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98182&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05f339ed-43e1-4013-9903-124ee45981da\', \'multiverseId\': 98182}, \'multiverseid\': 98182}, {\'name\': \'Forma del Drago\', \'text\': "All\'inizio del tuo mantenimento, la Forma del Drago infligge 5 danni a una creatura o a un giocatore bersaglio.\\nAlla fine di ogni turno, il tuo totale dei punti vita diventa 5.\\nLe creature senza volare non possono attaccarti.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98902&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'42df9a26-e85a-4974-ae62-ce2c5f9ed868\', \'multiverseId\': 98902}, \'multiverseid\': 98902}, {\'name\': \'ドラゴン変化\', \'text\': \'あなたのアップキープの開始時に、クリーチャー１体かプレイヤー１人を対象とする。ドラゴン変化はそれに５点のダメージを与える。\\n各ターンの終了時に、あなたのライフの総量は５点になる。\\n飛行を持たないクリーチャーは、あなたへの攻撃に参加できない。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99262&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'77b702f6-3e77-46aa-8e0f-253efa887ae7\', \'multiverseId\': 99262}, \'multiverseid\': 99262}, {\'name\': \'Forma do Dragão\', \'text\': \'No início de sua manutenção, Forma do Dragão causa 5 pontos de dano à criatura ou ao jogador alvo.\\nNo final de cada turno, o seu total de pontos de vida torna-se 5.\\nAs criaturas sem a habilidade de voar não podem atacá-lo.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99622&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ca328b1-d061-4925-ad19-31877ceca268\', \'multiverseId\': 99622}, \'multiverseid\': 99622}, {\'name\': \'Обличье дракона\', \'text\': \'В начале вашего этапа поддержки Обличье дракона наносят 5 повреждений целевому существу или игроку.\\nВ конце каждого хода общее количество вашей жизни равняется 5.\\nСущества, не обладающие способностью полета, не могут вас атаковать.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109893&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d1780287-096a-4508-a2c1-606873b5d1a7\', \'multiverseId\': 109893}, \'multiverseid\': 109893}, {\'name\': \'化身巨龙\', \'text\': \'在你的维持开始时，化身巨龙对目标生物或牌手造成5点伤害。\\n在每个回合结束时，你的总生命成为5。\\n不具飞行异能的生物不能攻击你。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97822&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a4cf840-afb6-4ff4-a295-eb8930b5d2c5\', \'multiverseId\': 97822}, \'multiverseid\': 97822}]', '[{\'name\': \'Freies Denken\', \'text\': \'{W}, wirf eine Karte ab: Du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Was bekommt ein Bauer umsonst, was ein Kaiser für kein Geld kaufen kann?" —Dal-Rätsel\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3a0e662b-af50-4b05-b768-1c6c70992178\', \'multiverseId\': 98649}, \'multiverseid\': 98649}, {\'name\': \'Armonía mental\', \'text\': \'{W}, descartar una carta: Ganas 3 vidas.\', \'type\': \'Encantamiento\', \'flavor\': \'"¿Que puede obtener gratis un campesino que el emperador nunca podrá comprar?" —Acertijo Dal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100089&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'212947ff-ec72-4be3-b712-17f87541df8b\', \'multiverseId\': 100089}, \'multiverseid\': 100089}, {\'name\': "Paix de l\'esprit", \'text\': "{W}, Défaussez-vous d\'une carte : Vous gagnez 3 points de vie.", \'type\': \'Enchantement\', \'flavor\': "« Qu\'est-ce qu\'un paysan obtient gratuitement et qu\'un empereur doit payer ? » —Devinette Dal", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98289&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18d1c89d-9d2a-4ad4-bd11-ed270d4759b6\', \'multiverseId\': 98289}, \'multiverseid\': 98289}, {\'name\': \'Pace della Mente\', \'text\': \'{W}, Scarta una carta: Guadagni 3 punti vita.\', \'type\': \'Incantesimo\', \'flavor\': \'"Qual è la cosa che un contadino può avere senza pagare e che un imperatore non potrà mai comprare?" —Indovinello Dal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99009&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'708c285d-e902-4610-8254-0458d7fd3d2a\', \'multiverseId\': 99009}, \'multiverseid\': 99009}, {\'name\': \'安らぎ\', \'text\': \'{W}, カードを１枚捨てる：あなたは３点のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': \'農民にはタダなのに、王様には絶対に買えないものなあに？ ――ダルの謎々\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99369&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43c3e680-9985-450f-bb43-a68815f5f725\', \'multiverseId\': 99369}, \'multiverseid\': 99369}, {\'name\': \'Paz de Espírito\', \'text\': \'{W}, Descarte um card: Você ganha 3 pontos de vida.\', \'type\': \'Encantamento\', \'flavor\': \'"O que um camponês pode conseguir de graça que um imperador nunca poderá comprar?" — Enigma de Dal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99729&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57f39fac-a8e8-4e29-919d-f182e78a490f\', \'multiverseId\': 99729}, \'multiverseid\': 99729}, {\'name\': \'Покой разума\', \'text\': \'{W}, Сбросьте карту: вы получаете 3 пункта жизни.\', \'type\': \'Чары\', \'flavor\': \'"Что крестьянин получит бесплатно, а император не купит ни за какие деньги?" — Загадка Даля\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110000&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'77e12014-23de-4aee-9381-f4ae70a8446e\', \'multiverseId\': 110000}, \'multiverseid\': 110000}, {\'name\': \'内心宁静\', \'text\': \'{W}，弃掉一张牌：你获得3点生命。\', \'type\': \'结界\', \'flavor\': \'「什么东西让皇帝想买买不到，农夫却垂手可得？」 ～达奥谜语\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97929&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'da217439-8cf9-46f8-9eae-5fe631a7c7eb\', \'multiverseId\': 97929}, \'multiverseid\': 97929}]', '[{\'name\': \'Frühernte\', \'text\': \'Ein Spieler deiner Wahl enttappt alle Standardländer, die er kontrolliert.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Hüll\\\' und Füll\\\' gedeihen immer, Scheun\\\' und Boden ledig nimmer; Reben, hoch voll Trauben rankend; Pflanzen, von der Bürde wankend." —William Shakespeare, Der Sturm\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98510&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'529d9d88-b2d2-4c07-bea4-1380114a1dca\', \'multiverseId\': 98510}, \'multiverseid\': 98510}, {\'name\': \'Cosecha temprana\', \'text\': \'El jugador objetivo endereza todas las tierras básicas que controla.\', \'type\': \'Instantáneo\', \'flavor\': \'"Que los frutos de la tierra, la abundancia, vuestras granjas y graneros nunca se vean vacíos; que se acrecienten las viñas con densos racimos; que se curven las plantas con el peso de su rendimiento." —William Shakespeare, La Tempestad\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99950&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c72e3fa8-a86a-480f-a316-0cb243292e37\', \'multiverseId\': 99950}, \'multiverseid\': 99950}, {\'name\': \'Récolte précoce\', \'text\': "Le joueur ciblé dégage tous les terrains de base qu\'il contrôle.", \'type\': \'Éphémère\', \'flavor\': "« C\'est à force de répandre le bon grain qu\'une semence finit par tomber dans un sillon fertile. » —Jules Verne, Les naufragés du Jonathan", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98150&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ec39e2d-54b1-4d4f-acc3-5a5dfde44b65\', \'multiverseId\': 98150}, \'multiverseid\': 98150}, {\'name\': \'Raccolto di Primizie\', \'text\': \'Il giocatore bersaglio STAPpa tutte le terre base che controlla.\', \'type\': \'Istantaneo\', \'flavor\': \'"Per voi la Terra sia sempre feconda, E pieni sempre i vostri granai: Le vigne cariche di grappoli; Gli alberi curvi sotto il peso dei frutti." —William Shakespeare, La Tempesta\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98870&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c091d6c-3db2-4989-bf86-11b8c146160e\', \'multiverseId\': 98870}, \'multiverseid\': 98870}, {\'name\': \'早摘み\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、自分がコントロールするすべての基本土地をアンタップする。\', \'type\': \'インスタント\', \'flavor\': \'地に満ちる滋養いよいよ増し 納屋や穀倉の空くことなし もつれ合う蔦は丈を誇れり 実る草木は頭を垂れり ウィリアム・シェークスピア「嵐」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99230&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'420f7768-f83d-4a62-b3d6-6f33233d050f\', \'multiverseId\': 99230}, \'multiverseid\': 99230}, {\'name\': \'Colheita Precoce\', \'text\': \'O jogador alvo desvira todos os terrenos básicos que ele controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Frutos da terra fértil, com fartura, Celeiros e granjas jamais vazios, Vinhas pesadas de compactos cachos, Plantas curvadas aos maduros frutos." — William Shakespeare, A Tempestade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99590&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2094fa4f-b796-4670-af50-185c43c03d7f\', \'multiverseId\': 99590}, \'multiverseid\': 99590}, {\'name\': \'Ранний урожай\', \'text\': \'Целевой игрок разворачивает все базовые земли, которые он контролирует.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Урожайной жатвы волны, Закрома, овины полны, Гроздья сочные берутся, От плодов деревья гнутся". — Уильям Шекспир, Буря\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109861&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f16d6a7-d995-43aa-8266-9480f0e266f2\', \'multiverseId\': 109861}, \'multiverseid\': 109861}, {\'name\': \'提早收成\', \'text\': \'目标牌手重置所有由他操控的基本地。\', \'type\': \'瞬间\', \'flavor\': \'「田多落穗， 积榖盈仓； 葡萄成簇， 摘果满筐。」 ～莎士比亚，《暴风雨》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97790&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b23e7ed8-cc35-4da9-9d48-0d7952ee635e\', \'multiverseId\': 97790}, \'multiverseid\': 97790}]', '[{\'name\': \'Furcht\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur verursacht Furcht. (Sie kann nur von Artefaktkreaturen und/oder schwarzen Kreaturen geblockt werden.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Fürchte dich nicht vor der Dunkelheit. Fürchte das, was sich in ihr versteckt." —Remin, ehrwürdiger Mönch\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed0b3b8d-ee78-4c84-89c2-01db14b2ce06\', \'multiverseId\': 98523}, \'multiverseid\': 98523}, {\'name\': \'Inspirar temor\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada tiene la habilidad de inspirar temor. (No puede ser bloqueada excepto por criaturas artefacto y/o criaturas negras.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"No temas a la oscuridad. Teme a lo que esconde." —Remin, monje venerable\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99963&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b9f5a90d-579a-4700-8a4b-2814719006a4\', \'multiverseId\': 99963}, \'multiverseid\': 99963}, {\'name\': \'Peur\', \'text\': \'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée a la peur. (Elle ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures noires.)\', \'type\': \'Enchantement : aura\', \'flavor\': "« N\'ayez aucune crainte des ténèbres. Craignez plutôt ce qu\'elles dissimulent. » —Remin, moine vénérable", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98163&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36a15629-baef-4b4e-b0c5-40caac04d9d3\', \'multiverseId\': 98163}, \'multiverseid\': 98163}, {\'name\': \'Paura\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata ha paura. (Non può essere bloccata tranne che da creature artefatto e/o da creature nere.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Non temere l\\\'oscurità. Temi ciò che essa nasconde." —Remin, monaco venerabile\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98883&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f8849a60-7d61-4956-b2bf-d483cc61ec0c\', \'multiverseId\': 98883}, \'multiverseid\': 98883}, {\'name\': \'畏怖\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは畏怖を持つ。 （それはアーティファクトでも黒でもないクリーチャーによってブロックされない。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'闇を恐れるな。 その中に潜むものを怖れよ。 ――神々しき老修道士、レミン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99243&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b11d62c-783f-4b8f-8caf-66ce7d805d69\', \'multiverseId\': 99243}, \'multiverseid\': 99243}, {\'name\': \'Amedrontar\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada tem a habilidade de amedrontar. (Ela só pode ser bloqueada por criaturas artefato e/ou criaturas pretas.)\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Não tema a escuridão. Tema o que ela esconde." — Remin, monge venerável\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99603&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fd6f8def-479d-4dc9-8f7c-33702461cc22\', \'multiverseId\': 99603}, \'multiverseid\': 99603}, {\'name\': \'Страх\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает способность страха. (Оно может быть заблокировано только артефактным существом и/или черным существом).\', \'type\': \'Чары — Аура\', \'flavor\': \'"Не бойтесь тьмы. Бойтесь того, что она скрывает". — Ремин, почтенный монах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109874&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'222719a2-7f6f-42f1-9c01-ef6215156c4d\', \'multiverseId\': 109874}, \'multiverseid\': 109874}, {\'name\': \'恐惧\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物具有恐惧异能。 （此生物只能被神器和／或黑色生物阻挡。）\', \'type\': \'结界～灵气\', \'flavor\': \'「黑暗并不足惧； 该提防的是掩蔽其中之物。」 ～可敬的修行僧睿明\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97803&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'744d27c9-1ff8-4f59-9e01-e67f989819e2\', \'multiverseId\': 97803}, \'multiverseid\': 97803}]', '[{\'name\': \'Fußsoldaten\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Der Aufmarsch der Infanterie ist eine Kunst, deine Truppen am falschen Ort zum richtigen Zeitpunkt einzusetzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98536&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'06a02442-19fa-43ce-9a3c-a936fc9d7d08\', \'multiverseId\': 98536}, \'multiverseid\': 98536}, {\'name\': \'Soldados de infantería\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Desplegar infantería es el arte de poner tus tropas en el lugar equivocado en el momento correcto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99976&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cef34ba3-4bc7-4207-bae6-33b183a840ef\', \'multiverseId\': 99976}, \'multiverseid\': 99976}, {\'name\': \'Fantassin\', \'type\': \'Créature : humain et soldat\', \'flavor\': "Le déploiement d\'infanterie est l\'art de placer vos troupes au mauvais endroit et au bon moment.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98176&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3da53c35-9d24-4469-9dc3-655fb2f03b4e\', \'multiverseId\': 98176}, \'multiverseid\': 98176}, {\'name\': \'Soldati Appiedati\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': "Lo schieramento della fanteria è l\'arte di mettere le tue truppe nel posto sbagliato al momento giusto.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98896&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1bd54fe-24c0-4676-ba10-9f57a91183fe\', \'multiverseId\': 98896}, \'multiverseid\': 98896}, {\'name\': \'歩兵部隊\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'歩兵部隊の展開とは、結局、指揮下の部隊を正しいときに間違った場所に配置する技である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99256&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a8bb225a-951e-4a39-978e-00ba6776edea\', \'multiverseId\': 99256}, \'multiverseid\': 99256}, {\'name\': \'Soldados a Pé\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'Distribuição de infantaria é a arte de colocar suas tropas no lugar errado na hora certa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99616&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'faea3b04-0b2f-46fa-8b9d-f9ce1ae6075d\', \'multiverseId\': 99616}, \'multiverseid\': 99616}, {\'name\': \'Пехотинцы\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Развертывание пехоты это искусство разместить войска в нужное время в самом неподходящем месте.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109887&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e22bcb21-9676-4d98-a7cf-6e06fdda8100\', \'multiverseId\': 109887}, \'multiverseid\': 109887}, {\'name\': \'步行军队\', \'type\': \'生物～人类／士兵\', \'flavor\': \'步兵调度的精妙之处，是把处于最佳状态的部队放到最糟的地方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97816&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71659fe7-65a3-4599-8d39-54bf62ba6350\', \'multiverseId\': 97816}, \'multiverseid\': 97816}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98628&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e5fd7c3f-64c4-4c35-a5ef-d1fe34f577b3', 'multiverseId': 98628}, 'multiverseid': 98628}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100068&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '27f40d34-5395-4f49-8ef6-782d51bd498e', 'multiverseId': 100068}, 'multiverseid': 100068}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98268&type=card', 'language': 'French', 'identifiers': {'scryfallId': '09be4d32-c2f4-497f-8026-a9855e22b2a7', 'multiverseId': 98268}, 'multiverseid': 98268}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98988&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a232982d-d237-4e1f-addc-5902505549ca', 'multiverseId': 98988}, 'multiverseid': 98988}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99348&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd7a9c93d-c42d-43f6-a25e-dc12801c130c', 'multiverseId': 99348}, 'multiverseid': 99348}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99708&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dc0156ed-372a-42be-bb95-b8cef816ac99', 'multiverseId': 99708}, 'multiverseid': 99708}, {'name': 'Гора', 'type': 'Базовая земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109979&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a4790e55-0f55-4496-b10c-e78e8c9869aa', 'multiverseId': 109979}, 'multiverseid': 109979}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97908&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '91ec1501-c1c2-4107-80e0-555db629c7e7', 'multiverseId': 97908}, 'multiverseid': 97908}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98629&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6e0ebb47-b862-43ff-87a9-b8df32bdf0ed', 'multiverseId': 98629}, 'multiverseid': 98629}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100069&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8cf4e434-d7c6-43bc-bdce-70b5ae639647', 'multiverseId': 100069}, 'multiverseid': 100069}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98269&type=card', 'language': 'French', 'identifiers': {'scryfallId': '067f1820-e3c9-405d-b5f0-4bc23713fa50', 'multiverseId': 98269}, 'multiverseid': 98269}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98989&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7c4b1b27-591b-4fed-bb9e-00375f881c45', 'multiverseId': 98989}, 'multiverseid': 98989}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99349&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '12bec5ef-c6f1-4299-b053-f6a5730dc13b', 'multiverseId': 99349}, 'multiverseid': 99349}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99709&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ff36638c-154b-40b1-8b4b-9fc18765f148', 'multiverseId': 99709}, 'multiverseid': 99709}, {'name': 'Гора', 'type': 'Базовая земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109980&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ca53dc08-65d9-4718-b7b3-969d765449eb', 'multiverseId': 109980}, 'multiverseid': 109980}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97909&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd270b141-4ede-41e0-ad34-8dca98cd8382', 'multiverseId': 97909}, 'multiverseid': 97909}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98630&type=card', 'language': 'German', 'identifiers': {'scryfallId': '50ea0988-c13b-48ea-b5ad-3ab228861e30', 'multiverseId': 98630}, 'multiverseid': 98630}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100070&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd4cd4af7-a4cf-412b-a17c-0b84d81fb35e', 'multiverseId': 100070}, 'multiverseid': 100070}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98270&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3677588d-349b-484a-b42f-ee2be57c2c07', 'multiverseId': 98270}, 'multiverseid': 98270}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98990&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a82d5ccb-96fa-42c6-865c-7dfe1afe59fd', 'multiverseId': 98990}, 'multiverseid': 98990}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99350&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '69420284-ac77-4fb8-8316-7cac760b27cb', 'multiverseId': 99350}, 'multiverseid': 99350}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99710&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '349b1d1d-534f-424a-b374-68bec9b86142', 'multiverseId': 99710}, 'multiverseid': 99710}, {'name': 'Гора', 'type': 'Базовая земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109981&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd5965d73-5f21-41e5-b50c-35d3fb753401', 'multiverseId': 109981}, 'multiverseid': 109981}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97910&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c712a76c-040c-4022-a1ca-4fe7dec33155', 'multiverseId': 97910}, 'multiverseid': 97910}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98631&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a9760716-1f6e-4962-824f-71e53f7cbd6e', 'multiverseId': 98631}, 'multiverseid': 98631}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100071&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2ea2ab0d-9193-4c1a-b61a-86dc72c928ff', 'multiverseId': 100071}, 'multiverseid': 100071}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98271&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ccdfc453-d5ae-4d56-818e-fd826c80cb2c', 'multiverseId': 98271}, 'multiverseid': 98271}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98991&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9fb167f5-068f-40de-b6e0-87377101c9ae', 'multiverseId': 98991}, 'multiverseid': 98991}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99351&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8386bcd6-c7ae-439e-868b-fe85f5cea283', 'multiverseId': 99351}, 'multiverseid': 99351}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99711&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e68d5626-cc2a-47b5-9c09-ae3ca93d4aac', 'multiverseId': 99711}, 'multiverseid': 99711}, {'name': 'Гора', 'type': 'Базовая земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109982&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8eadb2d6-d348-45b3-8323-c36e0d14f868', 'multiverseId': 109982}, 'multiverseid': 109982}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97911&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e6c0e207-1393-4522-a736-5351cc40a939', 'multiverseId': 97911}, 'multiverseid': 97911}]", '[{\'name\': \'Gedankenzersetzung\', \'text\': \'Ein Spieler deiner Wahl wirft zwei Karten ab.\', \'type\': \'Hexerei\', \'flavor\': \'„Das Elegante an Angriffen auf die Erinnerung ist, dass deine Opfer sich nie daran erinnern können."Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98624&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd1bf4b7-030d-401e-97f5-726d74ba9061\', \'multiverseId\': 98624}, \'multiverseid\': 98624}, {\'name\': \'Podredumbre mental\', \'text\': \'El jugador objetivo descarta dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La belleza de los ataques mentales es que tus víctimas nunca los recuerdan."Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100064&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f66708cf-ef14-4109-b6cf-4490a976dadd\', \'multiverseId\': 100064}, \'multiverseid\': 100064}, {\'name\': \'Pourrissement cérébral\', \'text\': \'Le joueur ciblé se défausse de deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« La beauté des attaques mentales, c\'est que vos victimes ne s\'en souviennent jamais. »Wöhlrajh", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98264&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6c323a1-691d-486d-83b4-4f8a0527aa6c\', \'multiverseId\': 98264}, \'multiverseid\': 98264}, {\'name\': \'Cancrena della Mente\', \'text\': \'Il giocatore bersaglio scarta due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il bello degli attacchi mentali è che le tue vittime non possono ricordarsene."Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98984&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'591324db-f265-44cb-998a-f6cef5c90b4b\', \'multiverseId\': 98984}, \'multiverseid\': 98984}, {\'name\': \'精神腐敗\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'精神攻撃の一番美しいところは、犠牲者がそれを覚えていないことだ。――ヴォルラス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99344&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a74a3431-a368-403b-a9ff-c5dededdaa81\', \'multiverseId\': 99344}, \'multiverseid\': 99344}, {\'name\': \'Estiolar a Mente\', \'text\': \'O jogador alvo descarta dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"A beleza dos ataques mentais é que suas vítima nunca se lembram deles." Volrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7af22a58-e0b8-488d-90c0-53e16cf7cad2\', \'multiverseId\': 99704}, \'multiverseid\': 99704}, {\'name\': \'Гниение разума\', \'text\': \'Целевой игрок сбрасывает две карты.\', \'type\': \'Волшебство\', \'flavor\': \'"Вся прелесть промывания мозгов в том, что жертва никогда о нем не помнит". — Волрат\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109975&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ab12d37-374c-4bb1-8914-dd1aaca7c765\', \'multiverseId\': 109975}, \'multiverseid\': 109975}, {\'name\': \'心之衰\', \'text\': \'目标牌手弃两张牌。\', \'type\': \'法术\', \'flavor\': \'「精神攻击最美妙之处，就是中招者根本不记得自己中了招。」～瓦拉司\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97904&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e996ccc-bf48-454a-8e61-fd61c5fe0bca\', \'multiverseId\': 97904}, \'multiverseid\': 97904}]', '[{\'name\': \'Gedankenübermittler\', \'text\': \'{T}: Ziehe eine Karte und wirf dann eine Karte aus deiner Hand ab.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Es ist für jeden etwas dabei: tiefe Gedanken, flüchtige, schmutzige, reine, wissenschaftliche, philosophische, falsche und richtige. Hat alles nur seinen Preis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8da4213-162d-41bc-8e5b-d1479e695e49\', \'multiverseId\': 98745}, \'multiverseid\': 98745}, {\'name\': \'Mensajero del pensamiento\', \'text\': \'{T}: Roba una carta, luego descarta una carta.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Existe un surtido para satisfacer todas tus necesitades: profundo, fugaz, sucio, puro, científico, filosófico, reflexivo e incluso premonitorio. Por un precio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100185&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5a7c465-9f5e-4fd8-8d7b-0a7e3cf6de19\', \'multiverseId\': 100185}, \'multiverseid\': 100185}, {\'name\': \'Messager des pensées\', \'text\': "{T} : Piochez une carte, puis défaussez-vous d\'une carte.", \'type\': \'Créature : humain et sorcier\', \'flavor\': "« J\'ai des pensées pour tous les goûts : profondes, fugaces, érotiques, pures, scientifiques, philosophiques, arrières et même mauvaises. Il faut juste y mettre le prix. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98385&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'de0a21ae-b99e-42c4-97a8-825ac96415fc\', \'multiverseId\': 98385}, \'multiverseid\': 98385}, {\'name\': \'Messaggero Psichico\', \'text\': \'{T}: Pesca una carta, poi scarta una carta.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"C\\\'è un assortimento sufficiente a soddisfare tutti i tuoi bisogni: profondo, fuggevole, sporco, puro, scientifico, filosofico, posteriore e anche anteriore. Per il giusto prezzo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99105&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8cb4278a-ffaa-4f5c-a4f6-2c81d1ac917a\', \'multiverseId\': 99105}, \'multiverseid\': 99105}, {\'name\': \'思考の急使\', \'text\': \'{T}：カードを１枚引き、その後カードを１枚捨てる。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'ご希望を満たす物なら一通りありますよ。沈思、逡巡、姑息、純粋、理論、空論、回顧、それに予知あたりも。 いずれもお値打ちです。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99465&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1cde8794-aa6b-4291-a5cf-16d510690a42\', \'multiverseId\': 99465}, \'multiverseid\': 99465}, {\'name\': \'Mensageiro de Pensamentos\', \'text\': \'{T}: Compre um card e depois descarte um card.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'"Existe um sortimento para satisfazer todas as suas necessidades: profundo, fugaz, sujo, puro, científico, filosófico, posterior, e até anterior. Por um preço."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15a90eef-cdd6-4fd3-9149-cb18804c25ca\', \'multiverseId\': 99825}, \'multiverseid\': 99825}, {\'name\': \'Посланник мысли\', \'text\': \'{T}: Возьмите карту, затем сбросьте карту.\', \'type\': \'Существо — Человек Мудрец\', \'flavor\': \'"У меня есть мысли на все случаи жизни: глубокие и мимолетные, чистые, грязные, научные, философские, мысли, приходящие слишком поздно, и даже предвидения. Но не бесплатно".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110096&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'43315eee-d756-48de-a5a7-83d2fde2dd1e\', \'multiverseId\': 110096}, \'multiverseid\': 110096}, {\'name\': \'心念讯使\', \'text\': \'{T}：抓一张牌，然后弃一张牌。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「有种类别可以满足你所有需求：专注，浮动，污秽，纯净，科学，哲理，之后，甚至事前。 只要点代价。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98025&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e2e85b9-0cd2-4a3b-a977-1e855bd35521\', \'multiverseId\': 98025}, \'multiverseid\': 98025}]', "[{'name': 'Geflüchteter Zauberer', 'type': 'Kreatur — Mensch, Zauberer', 'flavor': 'Die Zauberschule von Lat-Nam sieht sich oft gezwungen, Studenten auszuschließen, deren Experimente zu riskant oder zu grausam werden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98544&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5f28a6b5-1c2e-46bd-a4bf-0bc45fcc9e92', 'multiverseId': 98544}, 'multiverseid': 98544}, {'name': 'Hechicero fugitivo', 'type': 'Criatura — Hechicero humano', 'flavor': 'La Universidad de Lat-Nam frecuentemente se ve obligada a expulsar a aquellos estudiantes cuyos experimentos se vuelven demasiado riesgosos o demasiado crueles.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99984&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9bda5eb3-b14a-45fd-8b51-16241079bb5a', 'multiverseId': 99984}, 'multiverseid': 99984}, {'name': 'Sorcier fugitif', 'type': 'Créature : humain et sorcier', 'flavor': 'Le collège de Lat-Nam est souvent contraint de renvoyer les étudiants dont les expériences sont trop dangereuses ou trop cruelles.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98184&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'db4caf28-c0b8-4e76-84e2-745ef7e53321', 'multiverseId': 98184}, 'multiverseid': 98184}, {'name': 'Mago Fuggitivo', 'type': 'Creatura — Mago Umano', 'flavor': 'Il Collegio di Lat-Nam è spesso costretto a espellere gli studenti i cui esperimenti sono divenuti troppo pericolosi o crudeli.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98904&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bd1e9569-d8f0-40d2-8932-948c1ddad431', 'multiverseId': 98904}, 'multiverseid': 98904}, {'name': '脱走魔術師', 'type': 'クリーチャー — 人間・ウィザード', 'flavor': 'ラト＝ナム大学では、実験があまりにも危険過ぎたり残酷すぎたりした生徒が強制退学させられることがよくある。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99264&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2de818e3-d3d7-4145-a6b8-f6a85c155628', 'multiverseId': 99264}, 'multiverseid': 99264}, {'name': 'Mago Fugitivo', 'type': 'Criatura — Mago Humano', 'flavor': 'A Faculdade de Lat-Nam é freqüentemente forçada a expulsar alunos cujos experimentos tornam-se muito perigosos ou cruéis.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99624&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '97af197f-2500-458b-aa19-1ce47b10024a', 'multiverseId': 99624}, 'multiverseid': 99624}, {'name': 'Чародей-изгнанник', 'type': 'Существо — Человек Мудрец', 'flavor': 'Руководство Колледжа в Лат-Наме нередко вынуждено исключать студентов, эксперименты которых становятся слишком опасными и жестокими.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109895&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3f27fb95-1ca9-411c-a995-fc10e543a822', 'multiverseId': 109895}, 'multiverseid': 109895}, {'name': '漂泊法术师', 'type': '生物～人类／法术师', 'flavor': '拉特南学院经常被迫把作了太危险或太残忍实验的学生逐走。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97824&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eac85341-cad8-4e59-afc6-5d966aea651d', 'multiverseId': 97824}, 'multiverseid': 97824}]", '[{\'name\': \'Gefolgsmann des Orakels\', \'text\': \'{T}: Aller Schaden, der einer Kreatur deiner Wahl in diesem Zug von einer Quelle, die du bestimmst, zugefügt würde, wird stattdessen dem Gefolgsmann des Orakels zugefügt.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Sie folgen der Prophezeiung zu jedem neuen Propheten und beschützen die Zukunft vor der Gegenwart.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3a276a0d-1ba0-4acc-a2e5-f4793fbe74fd\', \'multiverseId\': 98641}, \'multiverseid\': 98641}, {\'name\': \'Asistentes de la Oráculo\', \'text\': \'{T}: Todo el daño que una fuente de tu elección fuera a hacerle a la criatura objetivo este turno, en vez de eso, se le hace a los Asistentes de la Oráculo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Siguen la profecía con cada nuevo profeta, protegiendo el futuro del presente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100081&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e3883c08-675e-4521-bc2f-ee030f3b3411\', \'multiverseId\': 100081}, \'multiverseid\': 100081}, {\'name\': "Suivants de l\'Oracle", \'text\': "{T} : Toutes les blessures qui devraient, ce tour-ci, être infligées à une créature ciblée par une source de votre choix, sont infligées aux Suivants de l\'Oracle à la place.", \'type\': \'Créature : humain et soldat\', \'flavor\': "Ils suivent la prophétie avec chaque nouveau prophète, protégeant l\'avenir contre le présent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98281&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aacd422d-5172-4186-9dd3-750249894739\', \'multiverseId\': 98281}, \'multiverseid\': 98281}, {\'name\': "Attendenti dell\'Oracolo", \'text\': "{T}: Tutto il danno che verrebbe inflitto a una creatura bersaglio in questo turno da una fonte a tua scelta viene invece inflitto agli Attendenti dell\'Oracolo.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Tramandano la profezia a ogni nuovo profeta, proteggendo il futuro dal presente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99001&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51ef7be3-a748-4924-a51d-dd821c15b774\', \'multiverseId\': 99001}, \'multiverseid\': 99001}, {\'name\': \'巫女の従者\', \'text\': \'{T}：クリーチャー１体を対象とする。このターン、あなたが選んだ発生源１つがそれに与えるすべてのダメージは、代わりに巫女の従者に与えられる。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'彼らは預言者の新たな預言に従い続けることで、未来を現在から守っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99361&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2267d71a-881d-40f4-91ad-c3f87ea3e107\', \'multiverseId\': 99361}, \'multiverseid\': 99361}, {\'name\': \'Ajudantes do Oráculo\', \'text\': \'{T}: Todo o dano que seria causado à criatura alvo neste turno por uma fonte a sua escolha, em vez disso, é causado a Ajudantes do Oráculo.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'Eles seguem a profecia de cada novo profeta, protegendo o futuro do presente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99721&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2cec5d9d-07e5-4fed-a4d1-fe1a442eafb3\', \'multiverseId\': 99721}, \'multiverseid\': 99721}, {\'name\': \'Свита оракула\', \'text\': \'{T}: Все повреждения, которые в этот ход наносятся целевому существу со стороны выбранного вами источника вместо этого будут нанесены Свите оракула.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Они передают предсказания от пророка к пророку, ограждая будущее от настоящего.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109992&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7d4d12df-6caf-4852-8371-95b6c129a7f5\', \'multiverseId\': 109992}, \'multiverseid\': 109992}, {\'name\': \'神谕使随员\', \'text\': \'{T}：选择一个来源，把此来源于本回合中将对目标生物造成的所有伤害，改为对神谕使随员造成之。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'他们依循预言指示来追随历代先知，为着未来而抵御现势。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97921&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c0886be-1692-4ce7-be8f-d48266f2e147\', \'multiverseId\': 97921}, \'multiverseid\': 97921}]', '[{\'name\': \'Gefräßiger Zombie\', \'text\': \'Furcht (Diese Kreatur kann nur von Artefaktkreaturen und/oder schwarzen Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Gier und Gefräßigkeit führten zu seinem Tod. Nun sind sie seine wertvollsten Hilfsmittel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98553&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de5bf25e-5707-4094-9ef5-de3a0ca99dae\', \'multiverseId\': 98553}, \'multiverseid\': 98553}, {\'name\': \'Zombie glotón\', \'text\': \'Inspirar temor. (Esta criatura no puede ser bloqueada excepto por criaturas artefacto y/o criaturas negras.)\', \'type\': \'Criatura — Zombie\', \'flavor\': \'La codicia y la gula lo llevaron a la muerte. Ahora son sus principales cualidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99993&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b80b0ae-ce8b-4eb4-a94d-7c5ed2713436\', \'multiverseId\': 99993}, \'multiverseid\': 99993}, {\'name\': \'Zombie glouton\', \'text\': \'Peur (Cette créature ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures noires.)\', \'type\': \'Créature : zombie\', \'flavor\': "L\'avidité et la gloutonnerie l\'ont mené à sa perte. Aujourd\'hui, ce sont ses deux meilleurs atouts.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98193&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8caa3bbf-3048-4fe4-a928-3c3f46fa3426\', \'multiverseId\': 98193}, \'multiverseid\': 98193}, {\'name\': \'Zombie Vorace\', \'text\': \'Paura (Questa creatura non può essere bloccata tranne che da creature artefatto e/o da creature nere.)\', \'type\': \'Creatura — Zombie\', \'flavor\': \'Bramosia e voracità lo hanno portato alla morte. Ora sono le sue migliori qualità.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98913&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0b37996c-8d4c-41da-9ef3-fe8e1c565e77\', \'multiverseId\': 98913}, \'multiverseid\': 98913}, {\'name\': \'暴食するゾンビ\', \'text\': \'畏怖 （このクリーチャーはアーティファクトでも黒でもないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'強欲と大食が彼に死をもたらした。 今となっては、それは彼の財産だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99273&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'280132be-a1d1-4fb5-8124-a493451ce306\', \'multiverseId\': 99273}, \'multiverseid\': 99273}, {\'name\': \'Zumbi Glutão\', \'text\': \'Amedrontar (Esta criatura só pode ser bloqueada por criaturas pretas e/ou criaturas artefato.)\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'A gula e a cobiça o levaram à morte. Agora estes são seus maiores trunfos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99633&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cbbc24d8-2935-4377-a7dc-d5f31d279375\', \'multiverseId\': 99633}, \'multiverseid\': 99633}, {\'name\': \'Ненасытный зомби\', \'text\': \'Страх (Это существо может быть заблокировано только артефактным существом и/или черным существом).\', \'type\': \'Существо — Зомби\', \'flavor\': \'Жадность и обжорство сгубили его. А теперь это его главные козыри.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109904&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eb6bbdd0-94dc-4679-875a-58e73814294d\', \'multiverseId\': 109904}, \'multiverseid\': 109904}, {\'name\': \'暴食灵俑\', \'text\': \'恐惧（此生物只能被神器和／或黑色生物阻挡。）\', \'type\': \'生物～灵俑\', \'flavor\': \'贪婪与暴食让他死亡。 现在这是他最大的两样资产。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97833&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee6bf2d8-b856-4641-9603-eac855c10b35\', \'multiverseId\': 97833}, \'multiverseid\': 97833}]', '[{\'name\': \'Gehirnzerschneider\', \'text\': \'Wenn der Gehirnzerschneider aus dem Spiel auf einen Friedhof gelegt wird, werfen alle Spieler die Karten auf ihrer Hand ab.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Manche merken zu spät, dass tatsächlich Monster unterm Bett leben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98625&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84879210-e4e5-4fba-b2a0-b246d15c5f12\', \'multiverseId\': 98625}, \'multiverseid\': 98625}, {\'name\': \'Rebanamentes\', \'text\': \'Cuando el Rebanamentes vaya a un cementerio desde el juego, cada jugador descarta su mano.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Ésa es la cosa que hace ruidos misteriosos en la noche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100065&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c94fadcb-7430-4644-92e7-4a0b02360d35\', \'multiverseId\': 100065}, \'multiverseid\': 100065}, {\'name\': \'Cérébrotrancheur\', \'text\': \'Quand le Cérébrotrancheur est mis dans un cimetière depuis le jeu, chaque joueur se défausse de sa main.\', \'type\': \'Créature : horreur\', \'flavor\': "« Les biens de la terre ne font que creuser l\'âme et en augmenter le vide (...) » —François René de Chateaubriand", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98265&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c91216b1-0983-4818-b657-6da5f6b17b62\', \'multiverseId\': 98265}, \'multiverseid\': 98265}, {\'name\': \'Squarta Menti\', \'text\': \'Quando lo Squarta Menti viene messo in un cimitero dal gioco, ogni giocatore scarta la propria mano.\', \'type\': \'Creatura — Orrore\', \'flavor\': \'Questa è la cosa che si annida nella notte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98985&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e8463a68-c663-4f58-9091-31ecf261f91b\', \'multiverseId\': 98985}, \'multiverseid\': 98985}, {\'name\': \'精神を刻むもの\', \'text\': \'精神を刻むものが場から墓地に置かれたとき、すべてのプレイヤーはそれぞれ自分の手札を捨てる。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': \'あいつこそ、一番恐ろしい亡霊だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99345&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'09708dd5-0126-4e5f-870e-7fc2da5adb21\', \'multiverseId\': 99345}, \'multiverseid\': 99345}, {\'name\': \'Fatiador de Mentes\', \'text\': \'Quando Fatiador de Mentes for colocado num cemitério vindo de jogo, cada jogador descarta sua própria mão.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Ele é a coisa que faz ruídos arrepiantes na noite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99705&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3c84cac-68ac-4857-8461-26ea66fb7ebd\', \'multiverseId\': 99705}, \'multiverseid\': 99705}, {\'name\': \'Режущий мысли\', \'text\': \'Когда Режущий мысли выходит из игры и попадает на кладбище, каждый игрок сбрасывает карты из руки.\', \'type\': \'Существо — Ужас\', \'flavor\': \'Вот кто действительно шумит по ночам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109976&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9d80d36c-c8fd-4ddd-9874-4af341da57b2\', \'multiverseId\': 109976}, \'multiverseid\': 109976}, {\'name\': \'削心兽\', \'text\': \'当削心兽从场上置入坟墓场时，每位牌手各弃掉其手牌。\', \'type\': \'生物～惊惧兽\', \'flavor\': \'它就是在暗夜里弄出奇怪声音的家伙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97905&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14350ced-4cf9-4c91-9757-1124ea3f5e97\', \'multiverseId\': 97905}, \'multiverseid\': 97905}]', "[{'name': 'Geisteskontakt', 'text': 'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nImmer wenn die verzauberte Kreatur Schaden zufügt, erhältst du ebensoviele Lebenspunkte dazu.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98724&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd1800bf3-39a5-46fd-b7d0-87f5a94ddd37', 'multiverseId': 98724}, 'multiverseid': 98724}, {'name': 'Vínculo espiritual', 'text': 'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nSiempre que la criatura encantada haga daño, ganas esa cantidad de vida.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100164&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '012752da-0329-4ee6-a25b-75768249de9f', 'multiverseId': 100164}, 'multiverseid': 100164}, {'name': 'Liaison psychique', 'text': 'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nÀ chaque fois que la créature enchantée inflige des blessures, vous gagnez autant de points de vie.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98364&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5a5d2c6a-11af-439e-bd57-b0e099bceb3c', 'multiverseId': 98364}, 'multiverseid': 98364}, {'name': 'Legame Spirituale', 'text': 'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nOgniqualvolta la creatura incantata infligge danno, guadagni altrettanti punti vita.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99084&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0ce7862e-37e6-4d67-8d6f-4704e29c4408', 'multiverseId': 99084}, 'multiverseid': 99084}, {'name': '魂の絆', 'text': 'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーがダメージを与えるたび、あなたはそれに等しい点数のライフを得る。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99444&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '266e9122-41e8-4c92-afea-144c92ca4b47', 'multiverseId': 99444}, 'multiverseid': 99444}, {'name': 'Vínculo Espiritual', 'text': 'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nToda vez que a criatura encantada causar dano, você ganha aquela quantidade em pontos de vida.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99804&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f22e1753-eacc-4226-adb9-9f9e2329ab81', 'multiverseId': 99804}, 'multiverseid': 99804}, {'name': 'Духовная связь', 'text': 'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nКаждый раз, когда зачарованное существо наносит повреждения, вы получаете столько пунктов жизни, сколько повреждений было нанесено.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110075&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e26cff63-c668-4d98-9d08-f321bb2fd353', 'multiverseId': 110075}, 'multiverseid': 110075}, {'name': '心灵羁绊', 'text': '生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n每当受此结界的生物造成伤害时，你获得等量的生命。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98004&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '31a84144-49f1-4fba-8f8c-a5816f0e3b7f', 'multiverseId': 98004}, 'multiverseid': 98004}]", '[{\'name\': \'Geistesverbrauch\', \'text\': \'Verwende nur schwarzes Mana für X.\\nGeistesverbrauch fügt einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu. Du erhältst X Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'„Dein Blut, dein Mark, dein Geist alles für mich." —Mayvar, Diener von Geth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98484&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b332639e-1e60-4dd2-993f-7c42085d74c7\', \'multiverseId\': 98484}, \'multiverseid\': 98484}, {\'name\': \'Consumir el espíritu\', \'text\': \'Usa sólo maná negro para pagar X.\\nConsumir el espíritu hace X puntos de daño a la criatura o jugador objetivo. Ganas X vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"Tu sangre, tu tuétano, tu espíritu... todo es mío." —Mayvar, lacayo de Geth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99924&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'340a526d-b900-4c68-b2f3-ce3444b79931\', \'multiverseId\': 99924}, \'multiverseid\': 99924}, {\'name\': "Absorption de l\'esprit", \'text\': "Ne dépensez que du mana noir pour X.\\nL\'Absorption de l\'esprit inflige X blessures à une cible, créature ou joueur. Vous gagnez X points de vie.", \'type\': \'Rituel\', \'flavor\': "« Ton sang, ta moelle, ton esprit — tous m\'appartiennent. » —Mayvar, mignon de Geth", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98124&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a9ebf11b-067c-47cd-ac52-6af0637bd866\', \'multiverseId\': 98124}, \'multiverseid\': 98124}, {\'name\': \'Spirito Struggente\', \'text\': \'Spendi solo mana nero per pagare X.\\nLo Spirito Struggente infligge X danni a una creatura o a un giocatore bersaglio. Tu guadagni X punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il tuo sangue, il tuo midollo, il tuo spirito: sono tutti miei." —Mayvar, tirapiedi di Geth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98844&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5f859c20-7371-43cf-bc1c-968a8f5173ca\', \'multiverseId\': 98844}, \'multiverseid\': 98844}, {\'name\': \'魂の消耗\', \'text\': \'Ｘは黒マナでしか支払えない。\\nクリーチャー１体かプレイヤー１人を対象とする。魂の消耗はそれにＸ点のダメージを与える。 あなたはＸ点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'お前の血、お前の骨、お前の魂――みんな私のもの。 ――ゲスの下僕、メイヴァー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99204&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'01f885b7-4c73-454e-b76f-599d824907b8\', \'multiverseId\': 99204}, \'multiverseid\': 99204}, {\'name\': \'Consumir o Espírito\', \'text\': \'Use somente mana preta para pagar X.\\nConsumir o Espírito causa X pontos de dano à criatura ou ao jogador alvo. Você ganha X pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"O seu sangue, a sua medula, o seu espírito são todos meus." — Mayvar, assecla de Geth\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99564&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'449fb697-c6eb-4f6a-953c-adb62cee3f0a\', \'multiverseId\': 99564}, \'multiverseid\': 99564}, {\'name\': \'Истребление духа\', \'text\': \'На X расходуйте только черную ману.\\nИстребление духа наносит X повреждений целевому существу или игроку. Вы получаете X пунктов жизни.\', \'type\': \'Волшебство\', \'flavor\': \'"Твоя кровь, твой разум, твой дух это все мое". — Майвар, любимец Гета\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109835&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0505de87-e684-48eb-9edb-fea95ee75655\', \'multiverseId\': 109835}, \'multiverseid\': 109835}, {\'name\': \'吞噬灵魂\', \'text\': \'只能以黑色法术力支付X。\\n吞噬灵魂对目标生物或牌手造成X点伤害。 你获得X点生命。\', \'type\': \'法术\', \'flavor\': \'「你的血肉，你的骨髓，你的精魂～全属于我。」 ～盖司属下梅瓦\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97764&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e5aac4b-c784-4f68-a474-89066a328f63\', \'multiverseId\': 97764}, \'multiverseid\': 97764}]', '[{\'name\': \'Geistiges Duell\', \'text\': \'Falls du zu Beginn deines Versorgungssegments 200 oder mehr Karten in deiner Bibliothek hast, gewinnst du das Spiel.\', \'type\': \'Verzauberung\', \'flavor\': \'Ein Zauberer, der tausend Bücher gelesen hat, ist mächtig. Ein Zauberer, der tausend Bücher auswendig gelernt hat, ist irre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98457&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7cf41a8c-1ba0-4fe3-9b18-b2f7bf1c1155\', \'multiverseId\': 98457}, \'multiverseid\': 98457}, {\'name\': \'Batalla de ingenio\', \'text\': \'Al comienzo de tu mantenimiento, si tienes 200 ó más cartas en tu biblioteca, ganas el juego.\', \'type\': \'Encantamiento\', \'flavor\': \'El hechicero que lee mil libros es poderoso. El hechicero que memoriza mil libros está loco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99897&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a6af108-b53f-4391-8ba0-223c34efaf34\', \'multiverseId\': 99897}, \'multiverseid\': 99897}, {\'name\': "Jeu d\'esprits", \'text\': \'Au début de votre entretien, si vous avez 200 cartes ou plus dans votre bibliothèque, vous gagnez la partie.\', \'type\': \'Enchantement\', \'flavor\': "Le magicien qui a lu un millier d\'ouvrages est puissant. Le magicien qui a mémorisé un millier d\'ouvrages est fou.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98097&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6bf1c0f-c071-426b-aaf6-380b07cabaae\', \'multiverseId\': 98097}, \'multiverseid\': 98097}, {\'name\': \'Scontro di Intelletti\', \'text\': "All\'inizio del tuo mantenimento, se hai almeno 200 carte nel tuo grimorio, vinci la partita.", \'type\': \'Incantesimo\', \'flavor\': \'Il mago che legge un migliaio di libri è potente. Il mago che impara a memoria un migliaio di libri è folle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98817&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7bf21c27-c7d2-4029-9aeb-3ecb65527a5b\', \'multiverseId\': 98817}, \'multiverseid\': 98817}, {\'name\': \'機知の戦い\', \'text\': \'あなたのアップキープの開始時に、あなたのライブラリーに200枚以上のカードがある場合、あなたはこのゲームに勝利する。\', \'type\': \'エンチャント\', \'flavor\': \'千冊の本を読破した魔術師は強力な魔術師になる。 千冊の本を記憶した魔術師は狂気の魔術師になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99177&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'daf47ef3-94c2-4021-b14b-1fb2e6bccd6f\', \'multiverseId\': 99177}, \'multiverseid\': 99177}, {\'name\': \'Batalha de Raciocínio\', \'text\': \'No início de sua manutenção, se você tiver 200 ou mais cards em seu grimório, você vence o duelo.\', \'type\': \'Encantamento\', \'flavor\': \'O mago que lê mil livros é poderoso. O mago que memoriza mil livros é demente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99537&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29573907-9c44-41b0-96a3-949e99746995\', \'multiverseId\': 99537}, \'multiverseid\': 99537}, {\'name\': \'Борьба умов\', \'text\': \'Если к началу этапа поддержки в вашей библиотеке 200 карт или больше, вы выигрываете игру.\', \'type\': \'Чары\', \'flavor\': \'Мудрец, прочитавший тысячу книг, всесилен. Мудрец, запомнивший тысячу книг наизусть, безумен.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109808&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'23a2ae52-4370-4b16-acab-a618d7edbd45\', \'multiverseId\': 109808}, \'multiverseid\': 109808}, {\'name\': \'斗智\', \'text\': \'在你的维持开始时，若你的牌库中有200张或更多的牌，你便赢得此盘游戏。\', \'type\': \'结界\', \'flavor\': \'读过几千本书的法术师很强， 但能背诵几千本书的法术师则是疯子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97737&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3fceecea-e80f-4eed-afd3-73a47fbd09a2\', \'multiverseId\': 97737}, \'multiverseid\': 97737}]', '[{\'name\': \'Gejagter Wumpus\', \'text\': \'Wenn der Gejagte Wumpus ins Spiel kommt, kann jeder andere Spieler eine Kreaturenkarte aus seiner Hand ins Spiel bringen.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Einer alleine kann schon ein Dutzend Leute für einen Monat ernähren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98578&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34081c13-f6d4-4063-80e9-234c4d545816\', \'multiverseId\': 98578}, \'multiverseid\': 98578}, {\'name\': \'Wumpus perseguido\', \'text\': \'Cuando el Wumpus perseguido entre en juego, cada uno de los demás jugadores puede poner en juego una carta de criatura de su mano.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Uno solo alimenta a una docena de personas durante un mes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100018&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6ebcb379-7b3d-4e7a-b328-3a8dc5a5e0ba\', \'multiverseId\': 100018}, \'multiverseid\': 100018}, {\'name\': \'Wumpus au rabais\', \'text\': \'Quand le Wumpus au rabais arrive en jeu, chaque autre joueur peut mettre en jeu une carte de créature de sa main.\', \'type\': \'Créature : bête\', \'flavor\': "Il en suffit d\'un pour nourrir une dizaine de personnes pendant un mois.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98218&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92cfa516-691e-4091-bcbf-d66335ae158d\', \'multiverseId\': 98218}, \'multiverseid\': 98218}, {\'name\': \'Wumpus Braccato\', \'text\': \'Quando il Wumpus Braccato entra in gioco, ogni altro giocatore può mettere in gioco una carta creatura dalla propria mano.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Un solo esemplare può saziare una dozzina di persone per un mese.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98938&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b1c2e7f-9879-4f08-bdd6-e8551dee27fc\', \'multiverseId\': 98938}, \'multiverseid\': 98938}, {\'name\': \'狩り立てられたウンパス\', \'text\': \'狩り立てられたウンパスが場に出たとき、他の各プレイヤーは、自分の手札からクリーチャー・カードを１枚、場に出してもよい。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'一匹獲れば、十二人もの人間の一ヶ月分の食料になるんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99298&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53718579-b619-4b4b-a55a-1299ae41a611\', \'multiverseId\': 99298}, \'multiverseid\': 99298}, {\'name\': \'Wumpus Caçado\', \'text\': \'Quando Wumpus Caçado entra em jogo, cada um dos outros jogadores pode colocar em jogo um card de criatura de sua própria mão.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Um desses é capaz de alimentar uma dúzia de pessoas durante um mês.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99658&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'699fc41b-f064-4d43-8b9b-efaeaeb37a21\', \'multiverseId\': 99658}, \'multiverseid\': 99658}, {\'name\': \'Загнанный вумпус\', \'text\': \'Когда Загнанный вумпус вступает в игру, каждый другой игрок может ввести в игру одну карту существа из руки.\', \'type\': \'Существо — Зверь\', \'flavor\': \'Одним вумпусом может в течение месяца питаться дюжина людей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109929&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1997da3e-e75a-4a28-b46f-52a17710601b\', \'multiverseId\': 109929}, \'multiverseid\': 109929}, {\'name\': \'捕获的狮头象\', \'text\': \'当捕获的狮头象进场时，其它每位牌手都可以从其手上将一张生物牌放置进场。\', \'type\': \'生物～野兽\', \'flavor\': \'只要一只就能让一打人整个月不饿肚子。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97858&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3b523b1-d47c-4db9-8109-8990b3250f7f\', \'multiverseId\': 97858}, \'multiverseid\': 97858}]', '[{\'name\': \'Gesegneter Boden\', \'text\': \'Immer wenn ein Zauberspruch oder eine Fähigkeit unter der Kontrolle eines Gegners deiner Wahl dazu führt, dass ein Land aus dem Spiel auf deinen Friedhof gelegt wird, bringe das Land ins Spiel zurück.\', \'type\': \'Verzauberung\', \'flavor\': \'Der Ritter kniete nieder und betete, zuerst um die Unantastbarkeit seines Landes und dann um die Stärke, die Eindringlinge abzuwehren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98689&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eabcb227-25b1-4244-9cb7-2f8d29f89e7f\', \'multiverseId\': 98689}, \'multiverseid\': 98689}, {\'name\': \'Tierra santa\', \'text\': \'Siempre que un hechizo o habilidad que controle un oponente haga que una tierra sea puesta en tu cementerio desde el juego, regresa esa tierra al juego.\', \'type\': \'Encantamiento\', \'flavor\': \'El caballero se arrodilló y rezó, primero por la santidad de su tierra y luego por la fuerza para repeler a sus invasores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100129&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'147c27b9-2476-45bd-9236-fdb2eaa9c56c\', \'multiverseId\': 100129}, \'multiverseid\': 100129}, {\'name\': \'Sol consacré\', \'text\': "À chaque fois qu\'un sort ou une capacité contrôlé par un adversaire quelconque met un terrain depuis le jeu dans votre cimetière, renvoyez ce terrain en jeu.", \'type\': \'Enchantement\', \'flavor\': "Le chevalier s\'agenouilla. Il pria d\'abord pour l\'inviolabilité de sa terre et ensuite, pour avoir la force nécessaire de repousser les envahisseurs.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'86a8d7c9-c763-40d0-a085-07fdb367cbba\', \'multiverseId\': 98329}, \'multiverseid\': 98329}, {\'name\': \'Terreno Consacrato\', \'text\': "Ogniqualvolta una magia o un\'abilità controllata da un avversario fa finire nel tuo cimitero una terra dal gioco, rimetti in gioco quella terra.", \'type\': \'Incantesimo\', \'flavor\': "Il cavaliere si inginocchiò e pregò, prima per l\'inviolabilità della propria terra e poi per ricevere la forza necessaria a scacciare gli invasori.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99049&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a2de792-2e84-468d-94b8-000c93c7c95b\', \'multiverseId\': 99049}, \'multiverseid\': 99049}, {\'name\': \'聖なる場\', \'text\': \'対戦相手がコントロールする呪文や能力によって土地が場からあなたの墓地に置かれるたび、その土地を場に戻す。\', \'type\': \'エンチャント\', \'flavor\': \'騎士はひざまずき、まずこの地の神聖さのために祈り、そしてそれを侵す者どもを追い払う力のために祈った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99409&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54b09963-5fad-4ee0-b579-2f7f3d8b6097\', \'multiverseId\': 99409}, \'multiverseid\': 99409}, {\'name\': \'Solo Consagrado\', \'text\': \'Toda vez que uma mágica ou habilidade que um oponente controla fizer com que um terreno seja colocado em seu cemitério vindo de jogo, devolva aquele terreno para o jogo.\', \'type\': \'Encantamento\', \'flavor\': \'O cavaleiro ajoelhou e rezou, primeiro pela santidade de sua terra e depois para ter a força para explusar os seus invasores.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39a170f3-cfa7-4396-8208-133a15a17bb3\', \'multiverseId\': 99769}, \'multiverseid\': 99769}, {\'name\': \'Святая земля\', \'text\': \'Каждый раз, когда заклинание или способность, которую контролирует оппонент, перемещает землю на кладбище, верните эту землю в игру.\', \'type\': \'Чары\', \'flavor\': \'Рыцарь преклонил колени и молился, молился о том, чтобы его земли остались нетронутыми и просил дать ему силы победить захватчиков.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110040&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'80f4da7a-bd28-483f-999f-c8364787c275\', \'multiverseId\': 110040}, \'multiverseid\': 110040}, {\'name\': \'圣洁大地\', \'text\': \'每当由对手所操控的咒语或异能将一个地从场上置入你的坟墓场时，将该地移回场上。\', \'type\': \'结界\', \'flavor\': \'骑士下跪祝祷，首先祈求家园不受侵扰，接着祈求护持力量以驱敌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97969&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03b760fc-5acb-440a-bd7e-8fbf1ca81513\', \'multiverseId\': 97969}, \'multiverseid\': 97969}]', '[{\'name\': \'Gesegneter Redner\', \'text\': \'Andere Kreaturen, die du kontrollierst, erhalten +0/+1.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'„Er sprach mit Engelszungen; wir kämpften mit Löwenstärke." —Hardil, Fußsoldat\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98464&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ddc8bd4-f898-4a5f-8e73-b82a94eb0b74\', \'multiverseId\': 98464}, \'multiverseid\': 98464}, {\'name\': \'Orador bendito\', \'text\': \'Las otras criaturas que controles obtienen +0/+1.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'"Él habló con la lengua de los ángeles; nosotros peleamos con la fuerza de los leones." —Handel, soldado de infantería\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99904&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e76bd8b0-da85-429a-809a-42d871438815\', \'multiverseId\': 99904}, \'multiverseid\': 99904}, {\'name\': \'Orateur béni\', \'text\': \'Les autres créatures que vous contrôlez gagnent +0/+1.\', \'type\': \'Créature : humain et clerc\', \'flavor\': "« Il se servit de la langue des anges pour nous donner la force des lions. » —Handel, soldat d\'infanterie", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98104&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ddb473d1-73a9-46ae-87e5-accd87512b95\', \'multiverseId\': 98104}, \'multiverseid\': 98104}, {\'name\': \'Oratore Benedetto\', \'text\': \'Le altre creature che controlli prendono +0/+1.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'"Egli parlava con la lingua degli Angeli; noi combattevamo con la forza dei leoni." —Handel, soldato di fanteria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98824&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb0d4a26-ae20-4270-b277-448d6bd4993b\', \'multiverseId\': 98824}, \'multiverseid\': 98824}, {\'name\': \'祝福された語り部\', \'text\': \'あなたがコントロールする他のクリーチャーは+0/+1の修整を受ける。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'彼が天使の舌で語れば、我々は獅子の力で戦う。 ――歩兵ハンデル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99184&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a8b1d5bf-007f-4cef-90c2-2a4422b1554d\', \'multiverseId\': 99184}, \'multiverseid\': 99184}, {\'name\': \'Orador Abençoado\', \'text\': \'As outras criaturas que você controla recebem +0/+1.\', \'type\': \'Criatura — Clérigo Humano\', \'flavor\': \'"Ele falava a língua dos Anjos; nós lutávamos com a força de leões." — Handel, soldado de infantaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99544&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'861a7b92-e508-46de-87b4-97ac8ebad160\', \'multiverseId\': 99544}, \'multiverseid\': 99544}, {\'name\': \'Благословенный оратор\', \'text\': \'Другие существа, которых вы контролируете, получают +0/+1.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'"Он говорил ангельским голосом, мы же сражались с бесстрашием львов". — Гандел, солдат пехоты\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109815&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d77d45e0-2bb4-4e65-a020-b3bf28999403\', \'multiverseId\': 109815}, \'multiverseid\': 109815}, {\'name\': \'受祝福的雄辩家\', \'text\': \'其它由你操控的生物得+0/+1。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'「他藉由上天使者的言词来演说，我们则以大地雄狮的力量来作战。」 ～步兵韩德尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97744&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cbd42d59-e1d1-490b-9056-a65edf6653ff\', \'multiverseId\': 97744}, \'multiverseid\': 97744}]', "[{'name': 'Gestrüppland', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {G} oder {W}. Das Gestrüppland fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98475&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4ea4023f-c917-4de4-b610-733c34c8551b', 'multiverseId': 98475}, 'multiverseid': 98475}, {'name': 'Matorrales', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {G} o {W} a tu reserva de maná. Los Matorrales te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99915&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '46816262-cd43-4892-b2c2-932e78294874', 'multiverseId': 99915}, 'multiverseid': 99915}, {'name': 'Broussaille', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {G} ou {W} à votre réserve. La Broussaille vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98115&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7034b203-e7fa-4bb4-9453-38e624950c8a', 'multiverseId': 98115}, 'multiverseid': 98115}, {'name': 'Boscaglia', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {G} o {W} alla tua riserva di mana. La Boscaglia ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98835&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f1d399e8-a176-4a98-abe4-83c45a90050a', 'multiverseId': 98835}, 'multiverseid': 98835}, {'name': '低木林地', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{G}か{W}を加える。 低木林地はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99195&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6210e0c1-4674-47a5-a663-ff177a4bbf25', 'multiverseId': 99195}, 'multiverseid': 99195}, {'name': 'Macegal', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {G} ou {W} à sua reserva de mana. Macegal causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99555&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6ffbeef5-d541-473f-b0a7-c165abc19197', 'multiverseId': 99555}, 'multiverseid': 99555}, {'name': 'Пустырь', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {G} или {W} в запас маны. Пустырь наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109826&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'bf0a58ca-4618-4111-818a-3a17b380f0ad', 'multiverseId': 109826}, 'multiverseid': 109826}, {'name': '矮丛林地', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{G}或{W}到你的法术力池中。 矮丛林地对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97755&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1a130f08-0a4d-4c2d-91b1-4e75c421ca0f', 'multiverseId': 97755}, 'multiverseid': 97755}]", "[{'name': 'Gezeitenkrake', 'text': 'Der Gezeitenkrake ist unblockbar.', 'type': 'Kreatur — Kraken', 'flavor': 'Für Meermänner sind Piraten lästig. Für Piraten sind Meermänner gefährlich. Für den Kraken sind sie alle nur lecker.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98749&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bd59c275-081d-4278-b7e5-56cb32bce835', 'multiverseId': 98749}, 'multiverseid': 98749}, {'name': 'Kraken de la marea', 'text': 'El Kraken de la marea es imbloqueable.', 'type': 'Criatura — Kraken', 'flavor': 'Para los tritones, los piratas son una molestia. Para los piratas, los tritones son una amenaza. Para el kraken, ambos son aperitivos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100189&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4d7ed738-3336-4fe2-9fdb-faafa2866979', 'multiverseId': 100189}, 'multiverseid': 100189}, {'name': 'Kraken des marées', 'text': 'Le Kraken des marées est imblocable.', 'type': 'Créature : kraken', 'flavor': 'Pour les ondins, les pirates sont une nuisance. Pour les pirates, les ondins sont une menace. Pour le kraken, pirates et ondins sont des amuse-gueule.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98389&type=card', 'language': 'French', 'identifiers': {'scryfallId': '27b0bdb6-808b-4286-a23a-efdc5e35f7f7', 'multiverseId': 98389}, 'multiverseid': 98389}, {'name': 'Kraken delle Maree', 'text': 'Il Kraken delle Maree non può essere bloccato.', 'type': 'Creatura — Kraken', 'flavor': 'Per i tritoni, i pirati sono una seccatura. Per i pirati, i tritoni sono una minaccia. Per il kraken, sono entrambi degli spuntini.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99109&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'aeb5fdb5-956a-4f9c-894a-d0bd166bdd57', 'multiverseId': 99109}, 'multiverseid': 99109}, {'name': '高潮のクラーケン', 'text': '高潮のクラーケンはブロックされない。', 'type': 'クリーチャー — クラーケン', 'flavor': 'マーフォークにとって海賊は厄介者だ。 海賊にとってマーフォークは脅威だ。 しかしクラーケンにとって、そのどちらも食欲を増進させるオードブルのようなものだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99469&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2e19626d-7521-4a78-ac7c-efddb87fc233', 'multiverseId': 99469}, 'multiverseid': 99469}, {'name': 'Kraken das Marés', 'text': 'Kraken das Marés não pode ser bloqueado.', 'type': 'Criatura — Kraken', 'flavor': 'Para os tritões, os piratas são um incômodo. Para os piratas, os tritões são uma ameaça. Para os krakens, são ambos aperitivos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99829&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ce7ea832-17fc-4abb-a888-27e34865f337', 'multiverseId': 99829}, 'multiverseid': 99829}, {'name': 'Приливный кракен', 'text': 'Приливного кракена невозможно блокировать.', 'type': 'Существо — Кракен', 'flavor': 'Для обитателей моря пираты неприятность. Для пиратов обитатели моря опасность. Для кракена и те, и другие вкусный обед.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110100&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '12ef3edd-11a0-4937-809b-f001d2739b6e', 'multiverseId': 110100}, 'multiverseid': 110100}, {'name': '潮汐巨怪', 'text': '潮汐巨怪不能被阻挡。', 'type': '生物～巨海兽', 'flavor': '对人鱼而言，海盗是麻烦； 而对海盗来说，人鱼是威胁。 但对巨怪来说，他们都是开胃菜。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98029&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5b840411-16d2-47d2-b44c-5446837940ee', 'multiverseId': 98029}, 'multiverseid': 98029}]", "[{'name': 'Gezähmtes Armodon', 'type': 'Kreatur — Elefant', 'flavor': 'Armodons werden dazu trainiert, auf Dinge zu treten. Auf feindliche Dinge.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98753&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ad1740ea-f466-4d5e-b0f0-f146153e2ea6', 'multiverseId': 98753}, 'multiverseid': 98753}, {'name': 'Armodón adiestrado', 'type': 'Criatura — Elefante', 'flavor': 'Los armodones están entrenados para pisar cosas. Cosas enemigas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100193&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5abef9ab-dadc-45a3-868a-4f8351c247b3', 'multiverseId': 100193}, 'multiverseid': 100193}, {'name': 'Armodon dressé', 'type': 'Créature : éléphant', 'flavor': 'Les armodons sont entraînés à marcher sur des choses. Des choses ennemies.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98393&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a9134957-987e-4e6f-8c6d-996b185d0d3c', 'multiverseId': 98393}, 'multiverseid': 98393}, {'name': 'Armodonte Addestrato', 'type': 'Creatura — Elefante', 'flavor': 'Gli armodonti vengono addestrati a calpestare le cose. Le cose nemiche.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99113&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9b7ee1fb-9448-4677-a552-04ee347ea90d', 'multiverseId': 99113}, 'multiverseid': 99113}, {'name': '訓練されたアーモドン', 'type': 'クリーチャー — 象', 'flavor': 'アーモドンは物を踏みつけるように訓練されている。 敵である物を。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99473&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0f24606f-a3cf-4d30-ae16-88599cf82d26', 'multiverseId': 99473}, 'multiverseid': 99473}, {'name': 'Armodonte Adestrado', 'type': 'Criatura — Elefante', 'flavor': 'Os armodontes são treinados para pisotear as coisas. As coisas inimigas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99833&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ca939672-095c-4382-bd7d-387721195b27', 'multiverseId': 99833}, 'multiverseid': 99833}, {'name': 'Дрессированный армодон', 'type': 'Существо — Слон', 'flavor': 'Армодоны обучены наступать на вещи. На вещи противника.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110104&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4b2e5efe-7a10-4c3d-b730-ee4c36083e77', 'multiverseId': 110104}, 'multiverseid': 110104}, {'name': '驯使的盾皮象', 'type': '生物～象', 'flavor': '盾皮象是训练来踩东西的。 敌人的东西。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98033&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9e74564a-7009-444b-a86e-05ce2980bd2c', 'multiverseId': 98033}, 'multiverseid': 98033}]", '[{\'name\': \'Gierige Ratten\', \'text\': \'Wenn die Gierigen Ratten ins Spiel kommen, wirft ein Gegner deiner Wahl eine Karte aus seiner Hand ab.\', \'type\': \'Kreatur — Ratte\', \'flavor\': \'Den Ratten ist nichts heilig. Alles ist nur eine weitere Mahlzeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98671&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'30acde82-a622-46e4-95c5-f6477f3621ed\', \'multiverseId\': 98671}, \'multiverseid\': 98671}, {\'name\': \'Ratas rapaces\', \'text\': \'Cuando las Ratas rapaces entren en juego, el oponente objetivo descarta una carta de su mano.\', \'type\': \'Criatura — Rata\', \'flavor\': \'Nada es sagrado para las ratas. Todo es simplemente otra comida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100111&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c32fd67-3c53-4085-94b0-7a33940f039c\', \'multiverseId\': 100111}, \'multiverseid\': 100111}, {\'name\': \'Rats voraces\', \'text\': "Quand ces Rats voraces arrivent en jeu, l\'adversaire ciblé se défausse d\'une carte.", \'type\': \'Créature : rat\', \'flavor\': "Pour les rats, rien n\'est sacré. La vie n\'est qu\'un continuel repas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98311&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7f7bacd-e457-4362-9c82-31259c8f445a\', \'multiverseId\': 98311}, \'multiverseid\': 98311}, {\'name\': \'Ratti Famelici\', \'text\': "Quando i Ratti Famelici entrano in gioco, l\'avversario bersaglio scarta una carta.", \'type\': \'Creatura — Ratto\', \'flavor\': \'Niente è sacro per i ratti: tutte le cose sono considerate alla stregua di un pasto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99031&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a4fe8177-5a68-4110-a35c-3206f484b321\', \'multiverseId\': 99031}, \'multiverseid\': 99031}, {\'name\': \'貪欲なるネズミ\', \'text\': \'貪欲なるネズミが場に出たとき、対戦相手１人を対象とする。そのプレイヤーはカードを１枚捨てる。\', \'type\': \'クリーチャー — ネズミ\', \'flavor\': \'このネズミらにとって敬意を表すべきものなんか何もない。 何を見てもエサだと思うんだから。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99391&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37703169-745a-4b90-a4b4-65740548acd7\', \'multiverseId\': 99391}, \'multiverseid\': 99391}, {\'name\': \'Ratos Vorazes\', \'text\': \'Quando Ratos Vorazes entra em jogo, o oponente alvo descarta um card.\', \'type\': \'Criatura — Rato\', \'flavor\': \'Nada é sagrado para os ratos. Tudo é apenas mais uma refeição.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99751&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bacb7997-7d23-4397-a989-841ebc51f950\', \'multiverseId\': 99751}, \'multiverseid\': 99751}, {\'name\': \'Прожорливые крысы\', \'text\': \'Когда Прожорливые крысы вступают в игру, целевой оппонент сбрасывает карту.\', \'type\': \'Существо — Крыса\', \'flavor\': \'Для крыс нет ничего святого. Для них весь мир еда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110022&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6eb0246f-3d78-412f-850a-4daf8952bf35\', \'multiverseId\': 110022}, \'multiverseid\': 110022}, {\'name\': \'贪吃老鼠\', \'text\': \'当贪吃老鼠进场时，目标对手弃一张牌。\', \'type\': \'生物～老鼠\', \'flavor\': \'老鼠的眼中没有神圣之物， 所有东西都是一顿饱餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97951&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8659d78e-86e4-41df-935c-4f91720ac9ce\', \'multiverseId\': 97951}, \'multiverseid\': 97951}]', "[{'name': 'Glorreiche Hymne', 'text': 'Kreaturen, die du kontrollierst, erhalten +1/+1.', 'type': 'Verzauberung', 'flavor': 'Jeder Sieg führt zu einer neuen Strophe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98551&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a40a946c-7f1a-4d70-a76c-2b18219f8bd2', 'multiverseId': 98551}, 'multiverseid': 98551}, {'name': 'Himno glorioso', 'text': 'Las criaturas que controles obtienen +1/+1.', 'type': 'Encantamiento', 'flavor': 'Cada victoria agrega un verso nuevo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99991&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '64526b7b-cfed-4735-a8f0-2cf3ba4b3e31', 'multiverseId': 99991}, 'multiverseid': 99991}, {'name': 'Antienne glorieuse', 'text': 'Les créatures que vous contrôlez gagnent +1/+1.', 'type': 'Enchantement', 'flavor': 'Chaque victoire y ajoute un verset.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98191&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5b3213b9-698b-4b0a-bbd5-5d390fc01859', 'multiverseId': 98191}, 'multiverseid': 98191}, {'name': 'Inno Glorioso', 'text': 'Le creature che controlli prendono +1/+1.', 'type': 'Incantesimo', 'flavor': 'Ogni vittoria aggiunge una nuova strofa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98911&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c0d1240e-9780-4300-9bb4-6d5a2a6e392c', 'multiverseId': 98911}, 'multiverseid': 98911}, {'name': '栄光の頌歌', 'text': 'あなたがコントロールするクリーチャーは+1/+1の修整を受ける。', 'type': 'エンチャント', 'flavor': '勝利がさらなる詩を生み出す。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99271&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '220cf079-78be-4547-8d20-df8092f08765', 'multiverseId': 99271}, 'multiverseid': 99271}, {'name': 'Antífona Gloriosa', 'text': 'As criaturas que você controla recebem +1/+1.', 'type': 'Encantamento', 'flavor': 'Cada vitória acrescenta um novo verso.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99631&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c5e916ec-9844-4314-be4d-283cf73e79f6', 'multiverseId': 99631}, 'multiverseid': 99631}, {'name': 'Славный гимн', 'text': 'Существа, которых вы контролируете, получают +1/+1.', 'type': 'Чары', 'flavor': 'Новая победа новый стих.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109902&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '511c059a-2fd2-4d94-98e9-b23b7d442e0f', 'multiverseId': 109902}, 'multiverseid': 109902}, {'name': '辉煌的赞美诗', 'text': '由你操控的生物得+1/+1。', 'type': '结界', 'flavor': '每场胜利都替诗篇增色。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97831&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8a98e817-0c01-4a70-aeb0-009d0502a44d', 'multiverseId': 97831}, 'multiverseid': 97831}]", '[{\'name\': \'Goblin-Bergsteiger\', \'text\': \'Gebirgstarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler ein Gebirge kontrolliert.)\', \'type\': \'Kreatur — Goblin, Späher\', \'flavor\': \'Das einzige, was schlimmer als ein Goblin ist, ist ein Goblin, der sich auskennt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98558&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4c1de5b-197e-4637-8589-459e7be81eb6\', \'multiverseId\': 98558}, \'multiverseid\': 98558}, {\'name\': \'Montañista trasgo\', \'text\': \'Cruza montañas. (Esta criatura es imbloqueable mientras el jugador defensor controle una montaña.)\', \'type\': \'Criatura — Explorador trasgo\', \'flavor\': \'Lo único peor que un trasgo es un trasgo que sabe a dónde va.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99998&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'47c5993a-affc-403c-bbda-b52b3d9a067b\', \'multiverseId\': 99998}, \'multiverseid\': 99998}, {\'name\': \'Montagnard gobelin\', \'text\': \'Traversée des montagnes (Cette créature est imblocable tant que le joueur défenseur contrôle au moins une montagne.)\', \'type\': \'Créature : gobelin et éclaireur\', \'flavor\': "La seule chose qui soit pire qu\'un gobelin, c\'est un gobelin qui connaisse son chemin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98198&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3fbbf27f-37d7-4e38-a676-1202c76bd07e\', \'multiverseId\': 98198}, \'multiverseid\': 98198}, {\'name\': \'Goblin di Montagna\', \'text\': \'Passa-montagne (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla almeno una Montagna.)\', \'type\': \'Creatura — Esploratore Goblin\', \'flavor\': \'La sola cosa peggiore di un goblin è un goblin che sa come muoversi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98918&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'64f87fe3-05f4-45e0-8ae1-b6f34613760b\', \'multiverseId\': 98918}, \'multiverseid\': 98918}, {\'name\': \'ゴブリンの山岳民\', \'text\': \'山渡り （このクリーチャーは防御プレイヤーが山をコントロールしている限りブロックされない。）\', \'type\': \'クリーチャー — ゴブリン・スカウト\', \'flavor\': \'ゴブリンより悪いものは、逃げ方を知ってるゴブリンだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99278&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ed7c2dcf-d3e3-424a-bd49-ca7bd08f7faa\', \'multiverseId\': 99278}, \'multiverseid\': 99278}, {\'name\': \'Goblin Montanhês\', \'text\': \'Travessia de Montanha (Esta criatura não pode ser bloqueada desde que o jogador defensor controle uma Montanha.)\', \'type\': \'Criatura — Batedor Goblin\', \'flavor\': \'A única coisa pior que um goblin é um goblin que sabe se virar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99638&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'787a91ca-6148-4d59-8272-b026b2e566df\', \'multiverseId\': 99638}, \'multiverseid\': 99638}, {\'name\': \'Гоблин-скалолаз\', \'text\': \'Знание гор (Это существо невозможно заблокировать, пока обороняющийся игрок контролирует Гору).\', \'type\': \'Существо — Гоблин Разведчик\', \'flavor\': \'Хуже гоблина может быть только гоблин, который знает, куда он идет.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109909&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6839f6db-dc0a-4cdc-a72a-6bc32c1bc23c\', \'multiverseId\': 109909}, \'multiverseid\': 109909}, {\'name\': \'精灵登山家\', \'text\': \'山脉行者（只要防御牌手操控山脉，此生物便不能被阻挡）\', \'type\': \'生物～精灵／斥候\', \'flavor\': \'若说有比精灵更糟糕的东西，那就是认得路的精灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97838&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'151214de-8b70-4bc8-a174-4f0662a5b88e\', \'multiverseId\': 97838}, \'multiverseid\': 97838}]', '[{\'name\': \'Goblin-Himmelsräuber\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Das Goblin-Wort für „fliegen" entspricht in anderen Sprachen eher „langsam fallen".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98561&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cdf376fb-2556-40fa-82be-47035ac217ac\', \'multiverseId\': 98561}, \'multiverseid\': 98561}, {\'name\': \'Incursor aéreo trasgo\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'La palabra de los trasgos para "volar" se traduce más precisamente como "caer lentamente".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100001&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b05c3425-2c0e-42fd-9cb3-3f2f595cf969\', \'multiverseId\': 100001}, \'multiverseid\': 100001}, {\'name\': \'Pillard céleste gobelin\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'Le terme gobelin pour « voler » signifie plus précisément « tomber moins vite ».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98201&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63c85cb6-f7ab-432c-a1a8-5c5bab9ed46f\', \'multiverseId\': 98201}, \'multiverseid\': 98201}, {\'name\': \'Predone dei Cieli Goblin\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'La parola usata dai goblin per "volare" significa letteralmente "cadere piano".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98921&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a3253d03-0dc1-4181-b908-e467e1fb2102\', \'multiverseId\': 98921}, \'multiverseid\': 98921}, {\'name\': \'ゴブリンの空襲部隊\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'ゴブリン語の「飛行」をもう少し正確に訳すと「遅い落下」になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99281&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d24b6250-5659-4ac1-9137-bd888402f4e8\', \'multiverseId\': 99281}, \'multiverseid\': 99281}, {\'name\': \'Goblin Atacante Celeste\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Guerreiro Goblin\', \'flavor\': \'"Traduzida ao pé da letra, a palavra "voar" na língua dos goblins significa "cair lentamente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99641&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'624df21a-6d5c-465a-a88f-6017b7c60e65\', \'multiverseId\': 99641}, \'multiverseid\': 99641}, {\'name\': \'Гоблин-налетчик\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'"Летать" на языке гоблинов дословно означает "медленно падать".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109912&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f66349b-fbbd-4d83-94af-d2d62297d0bf\', \'multiverseId\': 109912}, \'multiverseid\': 109912}, {\'name\': \'精灵空击队\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'生物～精灵／战士\', \'flavor\': \'精灵语里面的「飞行」，翻译起来其实比较接近「慢慢掉下来」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97841&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d13d16fb-1aba-42a0-b051-a84f9a269443\', \'multiverseId\': 97841}, \'multiverseid\': 97841}]', '[{\'name\': \'Goblin-Lanzenträger\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Sobald sie das spitze Ende gefunden haben, werden sie zum Wachdienst befördert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98559&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d46e63ed-b854-432b-8260-92690cb4c592\', \'multiverseId\': 98559}, \'multiverseid\': 98559}, {\'name\': \'Lancero trasgo\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Cuando descubrió qué extremo de la cosa era puntiagudo, fue ascendido al servicio de guardia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99999&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a35f70ae-2b8a-456e-9065-0a627a194f51\', \'multiverseId\': 99999}, \'multiverseid\': 99999}, {\'name\': \'Piquier gobelin\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Une fois qu\'il eût découvert quelle extrémité était tranchante, il fut promu garde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98199&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea8fb411-b200-4529-8bcf-610154206b64\', \'multiverseId\': 98199}, \'multiverseid\': 98199}, {\'name\': \'Picchiere Goblin\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Quando riuscì a capire quale delle due estremità era appuntita, venne promosso ai servizi di guardia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98919&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cfbca18f-6774-429f-9d24-e42046c18ba9\', \'multiverseId\': 98919}, \'multiverseid\': 98919}, {\'name\': \'ゴブリンの長槍使い\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'棒のどっちが尖っているか理解ができたことで、彼は警備役に昇格した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99279&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5cf2410-184c-4651-90a1-7db70345e4f0\', \'multiverseId\': 99279}, \'multiverseid\': 99279}, {\'name\': \'Goblin Piqueiro\', \'type\': \'Criatura — Guerreiro Goblin\', \'flavor\': \'Assim que ele aprendeu qual das pontas era afiada, foi promovido à função de guarda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99639&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3421bfa2-1a9e-4b9c-84fb-1eb9ad74366c\', \'multiverseId\': 99639}, \'multiverseid\': 99639}, {\'name\': \'Гоблин-копейщик\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Когда он выучил, где у копья острый конец, ему доверили нести караульную службу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109910&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'313b02ce-29a0-44e1-bbae-c2a2ec4ce46b\', \'multiverseId\': 109910}, \'multiverseid\': 109910}, {\'name\': \'精灵长矛兵\', \'type\': \'生物～精灵／战士\', \'flavor\': \'当他搞清楚这东西哪一头是尖端时，便晋升为守卫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97839&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'05c4f4e1-7a8e-4ef7-8668-4d5b0e43478d\', \'multiverseId\': 97839}, \'multiverseid\': 97839}]', '[{\'name\': \'Goblin-Wagenlenker\', \'text\': \'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Der härteste Teil seiner Ausbildung ist es, ihm beizubringen, dass er das Wildschwein nicht essen darf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98556&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c528e24-9e18-4c2c-a815-bc807480dc94\', \'multiverseId\': 98556}, \'multiverseid\': 98556}, {\'name\': \'Carro trasgo\', \'text\': \'Prisa. (Esta criatura puede atacar el turno en que entre bajo tu control.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'La parte más difícil de su entrenamiento es aprender a no comerse el jabalí.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99996&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3e982a16-0787-47e4-8f7b-07bc0aeec12b\', \'multiverseId\': 99996}, \'multiverseid\': 99996}, {\'name\': \'Chariot gobelin\', \'text\': \'Célérité (Cette créature peut attaquer dès le tour où elle arrive sous votre contrôle.)\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "L\'entraînement est assez difficile. Il faut apprendre à ne pas manger le sanglier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98196&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b072c8f4-05d2-4272-95c1-f14c12d7c9a0\', \'multiverseId\': 98196}, \'multiverseid\': 98196}, {\'name\': \'Carro Goblin\', \'text\': \'Rapidità (Questa creatura può attaccare nel turno in cui entra sotto il tuo controllo.)\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'La parte più difficile del suo addestramento è fargli capire che non deve mangiare il cinghiale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98916&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2106c14-a78d-4633-889f-71bb3c4a9281\', \'multiverseId\': 98916}, \'multiverseid\': 98916}, {\'name\': \'ゴブリンの戦車\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になったターンに攻撃に参加してもよい。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'こいつの訓練で一番難しい点は、豚を食べないことを覚えさせることなんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99276&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5c2b39f-5b86-4001-aeb6-1971cc546abc\', \'multiverseId\': 99276}, \'multiverseid\': 99276}, {\'name\': \'Carruagem Goblin\', \'text\': \'Ímpeto (Esta criatura pode atacar no turno em que entra em jogo sob seu controle.)\', \'type\': \'Criatura — Guerreiro Goblin\', \'flavor\': \'A parte mais difícil de seu treinamento é aprender a não comer o javali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99636&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'194a0cc5-93b5-4864-ada3-c6f0ac047f2d\', \'multiverseId\': 99636}, \'multiverseid\': 99636}, {\'name\': \'Колесница гоблинов\', \'text\': \'Ускорение (Это существо может нападать во время того хода, когда оно попало под ваш контроль).\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Самое сложное для него удержаться и не полакомиться вепрем.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109907&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'381841db-8525-4d08-84cc-d94c2034c288\', \'multiverseId\': 109907}, \'multiverseid\': 109907}, {\'name\': \'精灵战车\', \'text\': \'敏捷（你操控此生物的该回合中，它便可以攻击）\', \'type\': \'生物～精灵／战士\', \'flavor\': \'他的训练中最困难之部分是：学会不要吃这只野猪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97836&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e36a0815-7029-4a78-82d8-e2789507f5e1\', \'multiverseId\': 97836}, \'multiverseid\': 97836}]', "[{'name': 'Goblinbrigand', 'text': 'Der Goblinbrigand greift in jedem Zug an, wenn möglich.', 'type': 'Kreatur — Goblin, Krieger', 'flavor': 'Wie eine geladene Armbrust spannen und loslassen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98555&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dbee13d5-ef65-43f3-95fa-16b0e894e94f', 'multiverseId': 98555}, 'multiverseid': 98555}, {'name': 'Bandolero trasgo', 'text': 'El Bandolero trasgo ataca cada turno si puede.', 'type': 'Criatura — Guerrero trasgo', 'flavor': 'Como un cañón cargado: apunta y dispara.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99995&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4a80e823-39f6-4388-a554-b33aac92b039', 'multiverseId': 99995}, 'multiverseid': 99995}, {'name': 'Brigand gobelin', 'text': 'Le Brigand gobelin attaque à chaque tour si possible.', 'type': 'Créature : gobelin et guerrier', 'flavor': 'Un vrai canon chargé : il vise et il tire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98195&type=card', 'language': 'French', 'identifiers': {'scryfallId': '56e9ce4c-21b0-41b9-ab86-f791b0973f19', 'multiverseId': 98195}, 'multiverseid': 98195}, {'name': 'Brigante Goblin', 'text': 'Il Brigante Goblin attacca ad ogni turno se può farlo.', 'type': 'Creatura — Guerriero Goblin', 'flavor': 'Come un cannone carico: punta e spara.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98915&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c5e4ac61-57ca-4193-891f-876b7a4b9d8e', 'multiverseId': 98915}, 'multiverseid': 98915}, {'name': 'ゴブリンの盗賊', 'text': 'ゴブリンの盗賊は、可能ならば毎ターン攻撃に参加する。', 'type': 'クリーチャー — ゴブリン・戦士', 'flavor': '弾のこめられた大砲みたいなもんだ――狙ったら、突っ込むだけ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99275&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fde51c4b-4a2d-47e7-9826-8d4bdf4b79db', 'multiverseId': 99275}, 'multiverseid': 99275}, {'name': 'Bandoleiro Goblin', 'text': 'Bandoleiro Goblin ataca a cada turno se estiver apto.', 'type': 'Criatura — Guerreiro Goblin', 'flavor': 'Como um canhão carregado mire e atire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99635&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '42f42e90-2a04-4f82-8bc7-3cf3b250d422', 'multiverseId': 99635}, 'multiverseid': 99635}, {'name': 'Гоблин-грабитель', 'text': 'Гоблин-грабитель нападает во время каждого хода, если может.', 'type': 'Существо — Гоблин Воин', 'flavor': 'Он словно заряженная пушка наводи да стреляй.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109906&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '87d92b88-9052-42b2-8fad-c472b180eaff', 'multiverseId': 109906}, 'multiverseid': 109906}, {'name': '精灵强盗', 'text': '精灵强盗每回合若能攻击，则必须攻击。', 'type': '生物～精灵／战士', 'flavor': '就像上膛大炮～一瞄就射。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97835&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '29ab7371-bbd5-4da4-9832-c45ca61a5366', 'multiverseId': 97835}, 'multiverseid': 97835}]", "[{'name': 'Goblinkönig', 'text': 'Andere Goblins erhalten +1/+1 und Gebirgstarnung. (Sie sind unblockbar, solange der verteidigende Spieler ein Gebirge kontrolliert.)', 'type': 'Kreatur — Goblin, Herrscher', 'flavor': 'Um König zu werden, tötete Numsgil Blog, der Unkful getötet hatte, der Viddle getötet hatte, der Loll getötet hatte, der Alrok getötet hatte...', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98557&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5dbfb0aa-d488-4a04-83a9-f41c51b24074', 'multiverseId': 98557}, 'multiverseid': 98557}, {'name': 'Rey trasgo', 'text': 'Los otros Trasgos obtienen +1/+1 y tienen la habilidad de cruzar montañas. (Son imbloqueables mientras el jugador defensor controle una montaña.)', 'type': 'Criatura — Señor trasgo', 'flavor': 'Para ser rey, Numsgil liquidó a Blog, quien liquidó a Unkful, quien liquidó a Viddle, quien liquidó a Loll, quien liquidó a Alrok . . .', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99997&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bd8fe7c0-0023-4b30-b423-c5a8e64243d2', 'multiverseId': 99997}, 'multiverseid': 99997}, {'name': 'Roi des gobelins', 'text': 'Les autres gobelins gagnent +1/+1 et ont la traversée des montagnes. (Ils sont imblocables tant que le joueur défenseur contrôle au moins une montagne.)', 'type': 'Créature : gobelin et seigneur', 'flavor': 'Pour être roi, Numsgil avait occis Blog, qui avait occis Unkful, qui avait occis Viddle, qui avait occis Loll, et occis de suite . . . .', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98197&type=card', 'language': 'French', 'identifiers': {'scryfallId': '66779b05-3ac8-4ca7-8204-f18bb42952dd', 'multiverseId': 98197}, 'multiverseid': 98197}, {'name': 'Re dei Goblin', 'text': 'Gli altri Goblin prendono +1/+1 e guadagnano passa-montagne. (Non possono essere bloccati fintanto che il giocatore in difesa controlla almeno una Montagna.)', 'type': 'Creatura — Lord Goblin', 'flavor': 'Numsgil, per diventare Re dei Goblin, uccise Blog, che uccise Unkful, che uccise Viddle, che uccise Loll, che uccise Alrok. . . .', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98917&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cf825bea-a0da-4989-8223-42ef99303a2c', 'multiverseId': 98917}, 'multiverseid': 98917}, {'name': 'ゴブリンの王', 'text': '他のゴブリンは+1/+1の修整を受けるとともに山渡りを持つ。 （それらは防御プレイヤーが山をコントロールしている限りブロックされない。）', 'type': 'クリーチャー — ゴブリン・ロード', 'flavor': '王となるため、ナムスギルはブログを謀殺した。そのブログもアンクフルを、アンクフルはヴィッデルを、ヴィッデルはロルを、ロルはアルロックを … …', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99277&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'edbb2633-1f3c-438a-804b-70ecce5c4b9a', 'multiverseId': 99277}, 'multiverseid': 99277}, {'name': 'Rei dos Goblins', 'text': 'Os outros Goblins recebem +1/+1 e têm travessia de Montanha. (Eles não podem ser bloqueados desde que o jogador defensor controle uma Montanha.)', 'type': 'Criatura — Senhor Goblin', 'flavor': 'Para ser rei, Numsgil matou Blog, que matou Unkful, que matou Viddle, que matou Loll, que matou Alrok. . . .', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99637&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa736903-84a9-49f5-9846-4e7ba4a87f06', 'multiverseId': 99637}, 'multiverseid': 99637}, {'name': 'Король гоблинов', 'text': 'Остальные Гоблины получают +1/+1 и знание гор. (Их невозможно блокировать, пока обороняющийся игрок контролирует Гору).', 'type': 'Существо — Гоблин Предводитель', 'flavor': 'Чтобы стать королем, Намсгил прикончил Блога, который прикончил Анкфула, который прикончил Виддла, который прикончил Лолла, который прикончил Алрока . . .', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109908&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ea8b12bf-11ba-4b6c-a9b4-90d73c79e03f', 'multiverseId': 109908}, 'multiverseid': 109908}, {'name': '精灵王', 'text': '其它精灵得+1/+1，并具有山脉行者异能。 （只要防御牌手操控山脉，这些生物便不能被阻挡）', 'type': '生物～精灵／领主', 'flavor': '为了成为国王，奴斯吉尔对布罗格作了布罗格对乌克富、乌克富对维多、维多对洛尔，以及洛尔对奥罗克. . . .等所作的事。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97837&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e96fb9cb-876a-4923-a1f6-e6c30ab12f09', 'multiverseId': 97837}, 'multiverseid': 97837}]", '[{\'name\': \'Grausames Edikt\', \'text\': \'Ein Gegner deiner Wahl opfert eine Kreatur.\', \'type\': \'Hexerei\', \'flavor\': \'„Oft muss ich bitter weinen, dass Du gestorben bist, / Und mancher von den Deinen Dich lebenslang vergisst." —Novalis, „Wenn alle untreu werden"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98493&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84a55be3-7f5d-420f-913a-0e5ad5d542a4\', \'multiverseId\': 98493}, \'multiverseid\': 98493}, {\'name\': \'Edicto cruel\', \'text\': \'El oponente objetivo sacrifica una criatura.\', \'type\': \'Conjuro\', \'flavor\': \'"Ya no hay burlas para ellos; ni oraciones ni campanas, / Ni una voz lastimosa salvo los coros,— / Los coros estridentes, demenciales, de los caparazones gimientes." —Wilfred Owen, "Himno para los Jóvenes Condenados"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99933&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d156c3a5-7be8-4138-bf87-48f41b24026a\', \'multiverseId\': 99933}, \'multiverseid\': 99933}, {\'name\': \'Édit cruel\', \'text\': "L\'adversaire ciblé sacrifie une créature.", \'type\': \'Rituel\', \'flavor\': "« Je hais, entre autres vices, cruellement la cruauté, et par nature et par jugement, comme l\'extrême de tous les vices. » —Michel de Montaigne, Essais", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98133&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6815d158-fb5e-4446-940b-f2e5da853032\', \'multiverseId\': 98133}, \'multiverseid\': 98133}, {\'name\': \'Editto Crudele\', \'text\': \'Il giocatore bersaglio sacrifica una creatura.\', \'type\': \'Stregoneria\', \'flavor\': \'"Nessuno scherno ormai per loro; nessuna preghiera né campana, / Neppure un lamento di dolore, tranne i cori,— / I cori striduli e dementi dei gusci che gemono." —Wilfred Owen, "Anthem for Doomed Youth"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98853&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc607220-d027-445c-87ec-de12ae92e61c\', \'multiverseId\': 98853}, \'multiverseid\': 98853}, {\'name\': \'残酷な布告\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーはクリーチャーを１体生け贄に捧げる。\', \'type\': \'ソーサリー\', \'flavor\': \'今や彼らに嘲りも、祈りも鐘もともに無し/嘆きの声すら聞こえずも、ただ歌声は響きたり――/狂えとばかりに甲高き、砲弾の声のいと悲し ――ウィルフレッド・オーウェン 「死すべき定めの若者のための賛歌」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99213&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c682cb8b-cb4f-434a-8e6d-0e9ba453408e\', \'multiverseId\': 99213}, \'multiverseid\': 99213}, {\'name\': \'Édito Cruel\', \'text\': \'O oponente alvo sacrifica uma criatura.\', \'type\': \'Feitiço\', \'flavor\': \'"Nenhuma zombaria para eles agora; nenhuma oração nem sinos, / Nenhuma voz de pesar salvo os coros, / Os coros estridentes e ensandecidos de conchas lamuriosas." — Wilfred Owen, "Hino para a Juventude Amaldiçoada"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99573&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'68328d10-20e7-42d1-b9df-c7b060582b98\', \'multiverseId\': 99573}, \'multiverseid\': 99573}, {\'name\': \'Жестокий указ\', \'text\': \'Целевой оппонент приносит в жертву существо.\', \'type\': \'Волшебство\', \'flavor\': \'"Они не слышат смеха и молитв, / Не слышат панихид церковных хоров / Лишь вой безумный бешеных моторов". — Уилфрид Оуэн, "Гимн осужденной молодости"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109844&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'824b98b8-46d6-4a4d-aa11-95835419d527\', \'multiverseId\': 109844}, \'multiverseid\': 109844}, {\'name\': \'残酷勒令\', \'text\': \'目标对手牺牲一个生物。\', \'type\': \'法术\', \'flavor\': \'「再也无人嘲弄他们的样子；没人为其祈祷或鸣钟，／也没有悼念之声可略掩那合奏，／～刺耳，令人发狂的尖啸子弹合奏曲。」 ～威尔菲德‧欧文， 「献给注定丧命之青年的圣歌」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97773&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62c43c88-ac7e-4005-9db3-b62431af6b9a\', \'multiverseId\': 97773}, \'multiverseid\': 97773}]', '[{\'name\': \'Grizzlybären\', \'type\': \'Kreatur — Bär\', \'flavor\': \'Versuche nicht, vor einem Dominariagrizzly davonzulaufen. Er wird dich kriegen, niederwerfen und fressen. Du kannst dich freilich auf einen Baum flüchten. Dann hast du wenigstens eine nette Aussicht, bis der Bär den Baum niederreißt und dich doch noch frisst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98565&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8028f4d-2f57-41dd-8500-2489e4c2d7ec\', \'multiverseId\': 98565}, \'multiverseid\': 98565}, {\'name\': \'Osos pardos\', \'type\': \'Criatura — Oso\', \'flavor\': \'No trates de correr más rápido que uno de los osos pardos de Dominaria. Te alcanzará, te derribará y te comerá. Claro, podrías subirte a un árbol. En ese caso disfrutarás de una linda vista antes de que derribe el árbol y te coma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100005&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'70a1f000-9517-425d-b03b-720b01904bba\', \'multiverseId\': 100005}, \'multiverseid\': 100005}, {\'name\': \'Grizzlis\', \'type\': \'Créature : ours\', \'flavor\': "N\'essayez pas d\'échapper aux grizzlis de Dominaria ; ils vous rattraperont, vous écraseront et vous mangeront. Bien sûr, vous avez la solution de grimper dans un arbre. Cela vous permettra de contempler une dernière fois le paysage avant que les ours n\'abattent l\'arbre et ne vous dévorent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98205&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ed0fa01-6025-4a1b-818c-ca1ee4394166\', \'multiverseId\': 98205}, \'multiverseid\': 98205}, {\'name\': \'Orso Grizzly\', \'type\': \'Creatura — Orso\', \'flavor\': "Non cercare di sfuggire a un grizzly di Dominaria: ti raggiungerebbe, ti getterebbe a terra e ti divorerebbe. Potresti invece arrampicarti su un albero. In quel caso, godrai di una bella vista prima che abbatta l\'albero e ti divori.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98925&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f663d4b6-9af9-457c-84dd-eabbd7957589\', \'multiverseId\': 98925}, \'multiverseid\': 98925}, {\'name\': \'灰色熊\', \'type\': \'クリーチャー — 熊\', \'flavor\': \'ドミナリアの灰色熊から走って逃げてもむだだ。追いつかれ、たたきのめされたあげくの果てに食われちまうのがオチだ。 もちろん、木に登るのは手だろうさ。 そうすれば、灰色熊が木を倒してお前さんを食っちまう前に、ちょっとした風景を楽しめるからな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99285&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c6cf2523-545c-4c5d-accc-323ecf8bdce1\', \'multiverseId\': 99285}, \'multiverseid\': 99285}, {\'name\': \'Ursos Cinzentos\', \'type\': \'Criatura — Urso\', \'flavor\': \'Não tente correr mais que um urso cinzento de Dominaria; ele vai pegá-lo, derrubá-lo e comê-lo. É claro que você poderia subir numa árvore. Nesse caso, você poderá desfrutar de uma bela paisagem antes dele derrubar a árvore e comê-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99645&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4fe55265-48f8-4785-b832-3351c3872c4e\', \'multiverseId\': 99645}, \'multiverseid\': 99645}, {\'name\': \'Гризли\', \'type\': \'Существо — Медведь\', \'flavor\': \'Не пытайтесь убежать от гризли Доминарии. Он догонит вас, собьет с ног и сожрет. Конечно, можно залезть на дерево. Тогда вы сможете полюбоваться прекрасным видом, прежде чем гризли повалит дерево и сожрет вас.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109916&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea55d869-b529-47ac-9682-f54109fba00e\', \'multiverseId\': 109916}, \'multiverseid\': 109916}, {\'name\': \'灰棕熊\', \'type\': \'生物～熊\', \'flavor\': \'莫尝试与多明纳里亚的灰棕熊赛跑，它会抓住你、弄倒你，并吃掉你。 当然，你也可以逃上树， 如此一来，在他弄倒树并吃掉你前，你还能欣赏一阵子风景。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97845&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1facc6c9-2fbf-4aa3-9ea6-ae6222a3cc03\', \'multiverseId\': 97845}, \'multiverseid\': 97845}]', '[{\'name\': \'Größeres Wohl\', \'text\': \'Opfere eine Kreatur: Ziehe eine Anzahl Karten in Höhe der Stärke der geopferten Kreatur und wirf dann drei Karten aus deiner Hand ab.\', \'type\': \'Verzauberung\', \'flavor\': \'„Verschlungen schon hat ihn der schwarze Mund ..." —Friedrich Schiller, Der Taucher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98564&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'427b0cd5-3d14-477a-95e3-e0d0728ce40d\', \'multiverseId\': 98564}, \'multiverseid\': 98564}, {\'name\': \'Beneficio superior\', \'text\': \'Sacrificar una criatura: Roba un número de cartas igual a la fuerza de la criatura sacrificada, luego descarta tres cartas.\', \'type\': \'Encantamiento\', \'flavor\': \'"Para examinar las causas de la vida, primero debes recurrir a la muerte." —Mary Shelley, Frankenstein\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100004&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6c3e1e40-3809-42fe-bcda-5052785484dc\', \'multiverseId\': 100004}, \'multiverseid\': 100004}, {\'name\': \'Pour le plus grand bien\', \'text\': \'Sacrifiez une créature : Piochez un nombre de cartes égal à la force de la créature sacrifiée, puis défaussez-vous de trois cartes.\', \'type\': \'Enchantement\', \'flavor\': "« Le mal se fait sans effort, naturellement, par fatalité ; le bien est toujours le produit d\'un art. » —Charles Beaudelaire", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98204&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f38b063-a777-4332-b484-1938cbddfeaf\', \'multiverseId\': 98204}, \'multiverseid\': 98204}, {\'name\': \'Bene Supremo\', \'text\': \'Sacrifica una creatura: Pesca un numero di carte pari alla forza della creatura sacrificata, poi scarta tre carte.\', \'type\': \'Incantesimo\', \'flavor\': \'"Per esaminare le cause della vita, dobbiamo prima fare ricorso alla morte." —Mary Shelley, Frankenstein\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98924&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1817c599-f6b3-4a78-b1ae-ddc6e392ba6d\', \'multiverseId\': 98924}, \'multiverseid\': 98924}, {\'name\': \'よりよい品物\', \'text\': \'クリーチャーを１体生け贄に捧げる：あなたは生け贄に捧げたクリーチャーのパワーに等しい枚数のカードを引き、その後カードを３枚捨てる。\', \'type\': \'エンチャント\', \'flavor\': \'生命の何たるかを調べるには、まず死を頼りとせねばならぬ。 ――メアリー・シェリー「フランケンシュタイン」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99284&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7af74ef-9bad-4c88-bcd4-f5eec8622caf\', \'multiverseId\': 99284}, \'multiverseid\': 99284}, {\'name\': \'Bem Maior\', \'text\': \'Sacrifique uma criatura: Compre uma quantidade de cards igual ao poder da criatura sacrificada, depois descarte três cards.\', \'type\': \'Encantamento\', \'flavor\': \'"Para examinar as causas da vida, devemos primeiro recorrer à morte." — Mary Shelley, Frankenstein\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99644&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d7f921b-f383-4056-8dba-92df57fda529\', \'multiverseId\': 99644}, \'multiverseid\': 99644}, {\'name\': \'Великое благо\', \'text\': \'Принесите в жертву существо: возьмите число карт, равное значению силы существа, принесенного в жертву, затем сбросьте три карты.\', \'type\': \'Чары\', \'flavor\': \'"Чтобы исследовать жизнь, нужно прежде обратиться к смерти". — Мэри Шелли, Франкенштейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109915&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'daafa1d4-bb63-4974-8ba8-6499352d4fb4\', \'multiverseId\': 109915}, \'multiverseid\': 109915}, {\'name\': \'牺牲小我\', \'text\': \'牺牲一个生物：抓等同于被牺牲生物力量值的牌，再选择并弃掉三张牌。\', \'type\': \'结界\', \'flavor\': \'「为了考察生命的意义，我们得先向死亡求助。」 ～玛丽雪莱，《科学怪人》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97844&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'781bd6dd-cecb-4a05-af9d-c172fc3c91d6\', \'multiverseId\': 97844}, \'multiverseid\': 97844}]', '[{\'name\': \'Grüne Kraft\', \'text\': \'Bringe zu Beginn des Versorgungssegments jedes Spielers einen 1/1 grünen Saproling-Spielstein unter deiner Kontrolle ins Spiel.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98768&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3325267a-08c6-4d34-96c3-43e9520144b0\', \'multiverseId\': 98768}, \'multiverseid\': 98768}, {\'name\': \'Fuerza verde\', \'text\': \'Al comienzo del mantenimiento de cada jugador, pon en juego bajo tu control una ficha de criatura Saprolín verde 1/1.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100208&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4fc3b665-e5b2-444b-8280-0dff2f8c2905\', \'multiverseId\': 100208}, \'multiverseid\': 100208}, {\'name\': \'Force verdoyante\', \'text\': "Au début de l\'entretien de chaque joueur, mettez en jeu, sous votre contrôle, un jeton de créature 1/1 verte Saprobionte.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98408&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8cd413b7-f5e0-4954-961e-b3a623e30238\', \'multiverseId\': 98408}, \'multiverseid\': 98408}, {\'name\': \'Forza della Vegetazione\', \'text\': "All\'inizio del mantenimento di ogni giocatore, metti in gioco una pedina creatura Saprolingio 1/1 verde sotto il tuo controllo.", \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99128&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1eaf85bc-4ce8-40a9-8b91-30c63e2b93df\', \'multiverseId\': 99128}, \'multiverseid\': 99128}, {\'name\': \'新緑の魔力\', \'text\': \'各プレイヤーのアップキープの開始時に、緑の1/1の苗木クリーチャー・トークンを１体、あなたのコントロールの下で場に出す。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99488&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a13a50b2-f8fa-45ea-b4eb-c3507693e1a7\', \'multiverseId\': 99488}, \'multiverseid\': 99488}, {\'name\': \'Força Verdejante\', \'text\': \'No início da manutenção de cada jogador, coloque em jogo sob o seu controle uma ficha de criatura verde 1/1 do tipo Saprófita.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99848&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'072d2f37-ca3a-42cd-9c24-a2305b69a7df\', \'multiverseId\': 99848}, \'multiverseid\': 99848}, {\'name\': \'Зеленая сила\', \'text\': \'В начале этапа поддержки каждого игрока введите в игру под вашим контролем фишку зеленого существа Сапролинга со значением силы 1/1.\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110119&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a80e0d8e-10e2-412f-ac49-999f1eb66cda\', \'multiverseId\': 110119}, \'multiverseid\': 110119}, {\'name\': \'新绿使者\', \'text\': \'在每位牌手的维持开始时，将一个1/1绿色的腐生物衍生物放置进场，并由你操控。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98048&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dfa8de25-124b-4e71-b7a8-57d11d75e283\', \'multiverseId\': 98048}, \'multiverseid\': 98048}]', '[{\'name\': \'Guerillataktik\', \'text\': \'Die Guerillataktik fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\\nWenn ein Zauberspruch oder eine Fähigkeit, der bzw. die von einem Gegner kontrolliert wird, dazu führt, dass du die Guerillataktik aus deiner Hand abwirfst, fügt die Guerillataktik einer Kreatur oder einem Spieler deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99561268-a802-4b04-92c4-9879ccab8ed4\', \'multiverseId\': 98567}, \'multiverseid\': 98567}, {\'name\': \'Guerra de guerrillas\', \'text\': \'La Guerra de guerrillas hace 2 puntos de daño a la criatura o jugador objetivo.\\nCuando un hechizo o habilidad que controle un oponente te haga descartar la Guerra de guerrillas, la Guerra de guerrillas hace 4 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100007&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a81b053a-973a-4975-a58d-718e61bb4c3b\', \'multiverseId\': 100007}, \'multiverseid\': 100007}, {\'name\': \'Tactiques de guérilla\', \'text\': \'Les Tactiques de guérilla infligent 2 blessures à une cible, créature ou joueur.\\nQuand un sort ou une capacité contrôlée par un adversaire vous contraint à vous défausser des Tactiques de guérilla, les Tactiques de guérilla infligent 4 blessures à une cible, créature ou joueur.\', \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98207&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6142efc-0765-46f7-a0b2-11e8726d3e5f\', \'multiverseId\': 98207}, \'multiverseid\': 98207}, {\'name\': \'Tattiche di Guerriglia\', \'text\': "Le Tattiche di Guerriglia infliggono 2 danni a una creatura o a un giocatore bersaglio.\\nQuando una magia o un\'abilità controllata da un avversario ti fa scartare le Tattiche di Guerriglia, le Tattiche di Guerriglia infliggono 4 danni a una creatura o a un giocatore bersaglio.", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98927&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a5fab2e-ec2c-4ba5-b3ef-6145a2895e3f\', \'multiverseId\': 98927}, \'multiverseid\': 98927}, {\'name\': \'ゲリラ戦術\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。ゲリラ戦術はそれに２点のダメージを与える。\\n対戦相手がコントロールする呪文や能力によって、あなたがゲリラ戦術を捨てさせられたとき、クリーチャー１体かプレイヤー１人を対象とする。ゲリラ戦術はそれに４点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99287&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6069986-9aa3-4e26-94bc-fcf96173b94c\', \'multiverseId\': 99287}, \'multiverseid\': 99287}, {\'name\': \'Táticas de Guerrilha\', \'text\': \'Táticas de Guerrilha causa 2 pontos de dano à criatura ou ao jogador alvo.Quando um mágica ou habilidade que um oponente controla o fizer descartar Táticas de Guerrilha, Táticas de Guerrilha causa 4 pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99647&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'616854cb-4f0c-44db-8084-59d589748776\', \'multiverseId\': 99647}, \'multiverseid\': 99647}, {\'name\': \'Партизанская тактика\', \'text\': \'Партизанская тактика наносит 2 повреждения целевому существу или игроку.\\nКогда из-за действия заклинания или способности вашего оппонента вы вынуждены сбросить Партизанскую войну, она наносит 4 повреждения целевому существу или игроку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109918&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'69dc6c85-dcc8-4c28-abdc-08ce7d51d10a\', \'multiverseId\': 109918}, \'multiverseid\': 109918}, {\'name\': \'游击策略\', \'text\': \'游击策略对目标生物或牌手造成2点伤害。\\n当由对手所操控的咒语或异能使得你从手上弃掉游击策略时，游击策略对目标生物或牌手造成4点伤害。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97847&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'860d2dfc-1559-4091-ade0-218766afb050\', \'multiverseId\': 97847}, \'multiverseid\': 97847}]', '[{\'name\': \'Handelsrouten\', \'text\': \'{1}: Bringe ein Land deiner Wahl, das du kontrollierst, auf die Hand seines Besitzers zurück.\\n{1}, wirf ein Land aus deiner Hand ab: Ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Weisen, die Rechtschaffenen, die Mächtigen sie alle könnten ohne den Kaufmann nicht überleben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98752&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'330e4d2e-af43-49bb-a1fb-52e01cb39ee2\', \'multiverseId\': 98752}, \'multiverseid\': 98752}, {\'name\': \'Rutas comerciales\', \'text\': \'{1}: Regresa la tierra objetivo que controles a la mano de su propietario.\\n{1}, descartar una carta de tierra de tu mano: Roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': \'El comerciante alimenta a todos: al sabio, al justo, al poderoso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100192&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0b379f9f-33e7-4bb5-856b-daeac23ba487\', \'multiverseId\': 100192}, \'multiverseid\': 100192}, {\'name\': \'Routes marchandes\', \'text\': "{1} : Renvoyez le terrain ciblé que vous contrôlez dans la main de son propriétaire.\\n{1}, défaussez-vous d\'une carte de terrain : Piochez une carte.", \'type\': \'Enchantement\', \'flavor\': \'Sage, juste, puissant — qui que vous soyez, le marchand vous nourrit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98392&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e53ba648-6c7e-4665-a16f-0dba12ee69e3\', \'multiverseId\': 98392}, \'multiverseid\': 98392}, {\'name\': \'Rotte Commerciali\', \'text\': \'{1}: Il proprietario riprende in mano una terra bersaglio che tu controlli.\\n{1}, Scarta una carta terra: Pesca una carta.\', \'type\': \'Incantesimo\', \'flavor\': \'Il saggio, il giusto, il potente: sono i mercanti a nutrirli tutti quanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99112&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91d69c9c-43ca-45c7-9104-fa57182838b7\', \'multiverseId\': 99112}, \'multiverseid\': 99112}, {\'name\': \'交易路\', \'text\': \'{1}：あなたがコントロールする土地１つを対象とし、それをオーナーの手札に戻す。\\n{1}, 土地カードを１枚捨てる：カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'賢き者、正しき者、力ある者――すべてを支えるのは商う者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99472&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5689916c-1986-4068-a600-fb2b943015f3\', \'multiverseId\': 99472}, \'multiverseid\': 99472}, {\'name\': \'Rotas de Comércio\', \'text\': \'{1}: Devolve o terreno alvo que você controla para a mão de seu dono.\\n{1}, Descarte um card de terreno: Compre um card.\', \'type\': \'Encantamento\', \'flavor\': \'Os sábios, os justos, os fortes o mercador alimenta a todos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99832&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'385049f3-d415-4d6c-848a-483516384ca0\', \'multiverseId\': 99832}, \'multiverseid\': 99832}, {\'name\': \'Торговые пути\', \'text\': \'{1}: Верните целевую землю, которую вы контролируете, в руку владельца.\\n{1}, Сбросьте карту земли: возьмите карту.\', \'type\': \'Чары\', \'flavor\': \'Мудрого, справедливого, властного всех их кормит торговец.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110103&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'500398e1-6c82-40c6-bdb8-a20b94f3bc7f\', \'multiverseId\': 110103}, \'multiverseid\': 110103}, {\'name\': \'贸易路线\', \'text\': \'{1}：将目标由你操控的地移回其拥有者手上。\\n{1}，弃掉一张地牌：抓一张牌。\', \'type\': \'结界\', \'flavor\': \'智者，仁者，勇者～商人都能搞定。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3b1afd33-c44c-4101-b3f5-4f60a17e8894\', \'multiverseId\': 98032}, \'multiverseid\': 98032}]', '[{\'name\': \'Heer der geplagten Skelette\', \'text\': \'{B}: Regeneriere das Heer der geplagten Skelette. (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Kreatur — Skelett\', \'flavor\': \'„Die Toten geben gute Soldaten ab. Sie können keine Befehle verweigern, geben nie auf, und hören nicht auf zu kämpfen, wenn mal ein Körperteil abgeschlagen wird."Nevinyrral, Handbuch für Zauberer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98508&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'faecb4ae-f082-4c0e-95c4-1c1d39f852a9\', \'multiverseId\': 98508}, \'multiverseid\': 98508}, {\'name\': \'Esqueletos esclavos\', \'text\': \'{B}: Regenera a los Esqueletos esclavos. (La próxima vez que esta criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Criatura — Esqueleto\', \'flavor\': \'"Los muertos son buenos soldados. No pueden desobedecer órdenes, nunca se rinden y no dejan de pelear cuando se les cae una parte del cuerpo."Nevinyrral, Manual del Nigromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99948&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f3305ed-39a8-45df-a8d9-70fed5947f28\', \'multiverseId\': 99948}, \'multiverseid\': 99948}, {\'name\': \'Squelettes serviles\', \'text\': "{B} : Régénérez ces Squelettes serviles. (La prochaine fois que cette créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Créature : squelette\', \'flavor\': \'« Les morts font de bons soldats. Ils ne peuvent désobéir, ils ne se rendent pas, et ils ne cessent pas le combat quand un morceau de leur corps vient à tomber. »—Nevinyrral, Le manuel du nécromancien\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98148&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'13e5ad7e-48f1-4ec4-a77d-32279f76cc4c\', \'multiverseId\': 98148}, \'multiverseid\': 98148}, {\'name\': \'Scheletri Maledetti\', \'text\': \'{B}: Rigenera gli Scheletri Maledetti. (La prossima volta che questa creatura sta per essere distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi tutti i danni da essa e rimuovila dal combattimento.)\', \'type\': \'Creatura — Scheletro\', \'flavor\': \'"I morti sono ottimi soldati. Non possono disobbedire agli ordini, non si arrendono mai e non si fermano quando perdono una parte del corpo in battaglia."Nevinyrral, Manuale del Necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98868&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'019ff220-96a4-46bd-a5e2-10a72dc71522\', \'multiverseId\': 98868}, \'multiverseid\': 98868}, {\'name\': \'蠢く骸骨\', \'text\': \'{B}：蠢く骸骨を再生する。 （このターン、次にこのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'クリーチャー — スケルトン\', \'flavor\': \'死者は兵士に絶好である。 命令に逆らうこともなければ、降伏することもありえない。しかも、身体のどこかが取れたぐらいでは戦いをやめないのだから。――ネビニラル「ネクロマンサーの手引き」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99228&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ab48d6f-6698-4cec-93ce-27d1c5b91cdd\', \'multiverseId\': 99228}, \'multiverseid\': 99228}, {\'name\': \'Esqueletos de Carga\', \'text\': \'{B}: Regenera Esqueletos de Carga. (Na próxima vez em que esta criatura seria destruída neste turno, ela não o é Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Criatura — Esqueleto\', \'flavor\': \'"Os mortos dão bons soldados. Não podem desobedecer ordens, jamais se rendem e não param de lutar quando perdem alguma parte do corpo." Nevinyrral, Manual dos Necromantes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99588&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99381d45-36b7-465a-975f-4bea04d2a43f\', \'multiverseId\': 99588}, \'multiverseid\': 99588}, {\'name\': \'Неутомимые скелеты\', \'text\': \'{B}: Регенерируйте Неутомимых скелетов. (Если в течение этого хода это существо будет уничтожено, оно не отправляется на кладбище. Вместо этого поверните его, снимите с него все повреждения и выведите его из боя).\', \'type\': \'Существо — Скелет\', \'flavor\': \'"Из мертвых получаются хорошие солдаты. Они не могут не подчиняться приказам, никогда не сдаются, не прекращают сражения, даже если отвалилась какая-то часть тела". — Невиниррал, Справочник некроманта\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109859&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40455b27-709d-49ff-a515-304b756ad77a\', \'multiverseId\': 109859}, \'multiverseid\': 109859}, {\'name\': \'苦力骷髅妖\', \'text\': \'{B}：重生苦力骷髅妖。 （如果此生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除所受的所有伤害，并将它移出战斗。）\', \'type\': \'生物～骷髅妖\', \'flavor\': \'「死者可成为良好的士兵。它们不会违背命令，它们从不投降，它们也不会因为身上随便哪块部份掉下来就停止战斗。」 ～妮维亚洛，《死灵术士手册》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97788&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'769b6176-7362-457d-81d7-ba15acd7906b\', \'multiverseId\': 97788}, \'multiverseid\': 97788}]', '[{\'name\': \'Heilige Stärke\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur erhält +1/+2.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Solche Kraft schützt den Körper mit der Stärke der Seele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98573&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a47ac39-49da-402d-9588-3b0e7bcae93e\', \'multiverseId\': 98573}, \'multiverseid\': 98573}, {\'name\': \'Fuerza sagrada\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada obtiene +1/+2.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Un poder así protege al cuerpo con la fuerza del alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100013&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2183571a-f24e-41aa-89db-2eef38bd8812\', \'multiverseId\': 100013}, \'multiverseid\': 100013}, {\'name\': \'Force sacrée\', \'text\': \'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée gagne +1/+2.\', \'type\': \'Enchantement : aura\', \'flavor\': "Elle protège le corps avec la force de l\'âme.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98213&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d529bf14-ce8d-4b56-bb91-9e60c8f74b07\', \'multiverseId\': 98213}, \'multiverseid\': 98213}, {\'name\': \'Forza Sacra\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata prende +1/+2.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Un tale potere protegge il corpo con la forza dell\'anima.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98933&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c414800f-e528-484f-bf2a-ce51426f9367\', \'multiverseId\': 98933}, \'multiverseid\': 98933}, {\'name\': \'聖なる力\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは+1/+2の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'それは魂の強さで肉体を守る力だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99293&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'414e89c7-4137-4ddc-a06e-3e352caf6b1f\', \'multiverseId\': 99293}, \'multiverseid\': 99293}, {\'name\': \'Força Divina\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)A criatura encantada recebe +1/+2.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Esse poder protege o corpo com a força da alma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99653&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f38584b7-ad06-4ee0-9545-21728c334986\', \'multiverseId\': 99653}, \'multiverseid\': 99653}, {\'name\': \'Святая сила\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает +1/+2.\', \'type\': \'Чары — Аура\', \'flavor\': \'Она защищает тело всеми силами души.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109924&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'94232256-ae0d-4efd-a8bd-6f416e6abf85\', \'multiverseId\': 109924}, \'multiverseid\': 109924}, {\'name\': \'神圣之力\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物得+1/+2。\', \'type\': \'结界～灵气\', \'flavor\': \'此等力量强魂以护体。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97853&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8fa4f3b4-db00-468c-91c2-6a4c5beeb0b0\', \'multiverseId\': 97853}, \'multiverseid\': 97853}]', '[{\'name\': \'Heiliger Nektar\', \'text\': \'Du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'„Ja, nun weiß ich deinen holden Namen. — Welch ein Nektar Welch ein Zaubertrank Alle, die, o Freundschaft, zu dir kamen, Trinken deinen Becher lebenslang." —Karoline Rudolphi, „Die Freundschaft"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cb51849f-be3c-4809-81bb-c5a269e79243\', \'multiverseId\': 98690}, \'multiverseid\': 98690}, {\'name\': \'Néctar sagrado\', \'text\': \'Gana 4 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"Sobre las montañas plateadas, donde brotan las fuentes de néctar, allí besaré el tazón de la dicha; y beberé hasta saciarme eternamente . . ." —Sir Walter Raleigh, "El peregrinaje"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100130&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a94a21b-d779-40c8-8ce3-0e0ffb34fcc0\', \'multiverseId\': 100130}, \'multiverseid\': 100130}, {\'name\': \'Nectar sacré\', \'text\': \'Vous gagnez 4 points de vie.\', \'type\': \'Rituel\', \'flavor\': \'On accepte une coupe de poison de celui qui vous a offert cent coupes de nectar. —Proverbe indien\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d634674-d716-4ba5-9807-36188fdb0bbb\', \'multiverseId\': 98330}, \'multiverseid\': 98330}, {\'name\': \'Nettare Sacro\', \'text\': \'Guadagni 4 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"Oltre le montagne d\\\'argento, Dove sgorgano le fontane del nettare, Là bacerò La coppa della beatitudine; E sazierò la mia sete eterna. . . ." —Sir Walter Raleigh, "The Pilgrimage"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99050&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b905ed1-8aef-4015-94cf-ded993e20199\', \'multiverseId\': 99050}, \'multiverseid\': 99050}, {\'name\': \'聖なる蜜\', \'text\': \'あなたは４点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'白銀の山遥かに越え 神酒の泉の地に憩え 至福たる杯 我が唇近づき その渇き永遠に満たされり … … 。 ――ウォルター・ローリー卿「巡礼」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99410&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ec282c5-d7e0-473a-b6d0-c67c23d568da\', \'multiverseId\': 99410}, \'multiverseid\': 99410}, {\'name\': \'Néctar Sagrado\', \'text\': \'Você ganha 4 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"Por sobre as montanhas de prata, Onde as montanhas de néctar jorram em cascata, Ali beijarei O cálice da satisfação; E beberei da eternidade o meu quinhão. . . ." — Sir Walter Raleigh, "A Peregrinação"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99770&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f22839cc-194a-421d-b434-011daf88d769\', \'multiverseId\': 99770}, \'multiverseid\': 99770}, {\'name\': \'Святой нектар\', \'text\': \'Вы получаете 4 пункта жизни.\', \'type\': \'Волшебство\', \'flavor\': \'"Среди посеребренных гор, Где плещется нектар, Я счастье познал, Я источник нашел, Источник живой воды . . ." — Сэр Вальтер Ралей, "Паломничество"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110041&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b13341b5-5d62-4abf-844b-c6819285956e\', \'multiverseId\': 110041}, \'multiverseid\': 110041}, {\'name\': \'圣洁琼浆\', \'text\': \'你获得4点生命。\', \'type\': \'法术\', \'flavor\': \'「在银白圣山上， 琼浆泉涌之处， 我将亲吻 狂喜之杯； 畅饮灵魂喜乐. . . .」 ～瓦尔特‧雷利爵士，「朝圣」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97970&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f012bc89-d6b3-493b-afbe-05cf9bd272c2\', \'multiverseId\': 97970}, \'multiverseid\': 97970}]', "[{'name': 'Heiße Glut', 'text': 'Heiße Glut fügt einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Das Feuer stirbt nie alleine.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98463&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9f6d7372-d115-4a80-b33c-b29a8803b5fa', 'multiverseId': 98463}, 'multiverseid': 98463}, {'name': 'Llamarada', 'text': 'La Llamarada hace X puntos de daño a la criatura o jugador objetivo.', 'type': 'Conjuro', 'flavor': 'El fuego nunca muere solo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99903&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c640634b-becf-462b-95ed-195a7ff72666', 'multiverseId': 99903}, 'multiverseid': 99903}, {'name': 'Brasier', 'text': 'Le Brasier inflige X blessures à une cible, créature ou joueur.', 'type': 'Rituel', 'flavor': 'Le feu ne meurt jamais seul.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98103&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'adac8566-12cb-4d92-8047-9d939a484416', 'multiverseId': 98103}, 'multiverseid': 98103}, {'name': 'Fiammata', 'text': 'La Fiammata infligge X danni a una creatura o a un giocatore bersaglio.', 'type': 'Stregoneria', 'flavor': 'Il fuoco non muore mai da solo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98823&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bee57b24-96de-42cb-9254-3c095be57b11', 'multiverseId': 98823}, 'multiverseid': 98823}, {'name': '猛火', 'text': 'クリーチャー１体かプレイヤー１人を対象とする。猛火はそれにＸ点のダメージを与える。', 'type': 'ソーサリー', 'flavor': '炎は、決して一人だけでは燃え尽きない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99183&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '23002646-521d-4541-b050-af89a690db96', 'multiverseId': 99183}, 'multiverseid': 99183}, {'name': 'Labareda', 'text': 'Labareda causa X pontos de dano à criatura ou ao jogador alvo.', 'type': 'Feitiço', 'flavor': 'O fogo jamais morre só.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99543&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7ffbecd0-c91e-4cd0-a966-5eea82650edf', 'multiverseId': 99543}, 'multiverseid': 99543}, {'name': 'Ослепительный свет', 'text': 'Ослепительный свет наносит X повреждений целевому существу или игроку.', 'type': 'Волшебство', 'flavor': 'Пламя никогда не умирает одно.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109814&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fe9fdc86-3f37-44df-ab4b-c7f14d07e6d6', 'multiverseId': 109814}, 'multiverseid': 109814}, {'name': '焰球', 'text': '焰球对目标生物或牌手造成X点伤害。', 'type': '法术', 'flavor': '火焰永不会独自熄灭。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97743&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4d3ce459-2a75-4482-938c-ba10bca74eeb', 'multiverseId': 97743}, 'multiverseid': 97743}]", '[{\'name\': \'Himmeljäger-Streife\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nWachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Katze, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98715&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'acf33cda-bce0-4ec8-beaf-b76ce72625e7\', \'multiverseId\': 98715}, \'multiverseid\': 98715}, {\'name\': \'Rondadora cazacielos\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nVigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Caballero felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100155&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c420e81e-e459-4c6e-bfa5-55000ea3ec55\', \'multiverseId\': 100155}, \'multiverseid\': 100155}, {\'name\': \'Rôdeuse chasseciel\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nVigilance (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : chat et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea87e453-4cf7-4daa-900f-ebaf3aa4c489\', \'multiverseId\': 98355}, \'multiverseid\': 98355}, {\'name\': \'Predatore Solcacielo\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nCautela (Questa creatura attacca senza TAPpare.)\', \'type\': \'Creatura — Cavaliere Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99075&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63e8b3ba-4ff4-432d-bf8b-db3d94383eec\', \'multiverseId\': 99075}, \'multiverseid\': 99075}, {\'name\': \'うろつく空狩人\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n警戒 （このクリーチャーは攻撃に参加してもタップしない。）\', \'type\': \'クリーチャー — 猫・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99435&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'53405405-eef6-40bb-91ce-5d85987e0dec\', \'multiverseId\': 99435}, \'multiverseid\': 99435}, {\'name\': \'Caçadora Celeste Espreitadora\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nVigilância (Esta criatura não é virada para atacar.)\', \'type\': \'Criatura — Cavaleiro Felino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99795&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c1c79fa-7812-472b-a7ef-0ce75587daa1\', \'multiverseId\': 99795}, \'multiverseid\': 99795}, {\'name\': \'Небесный охотник\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nБдительность (При нападении это существо не поворачивается).\', \'type\': \'Существо — Кошка Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110066&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1646b509-655b-4380-81c7-dd2c31bf8edd\', \'multiverseId\': 110066}, \'multiverseid\': 110066}, {\'name\': \'游掠空猎者\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n警戒（此生物攻击时不需横置）\', \'type\': \'生物～猫／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97995&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'172c9979-4866-45dd-92fe-68641fadc609\', \'multiverseId\': 97995}, \'multiverseid\': 97995}]', '[{\'name\': \'Himmlischer Segen\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+3 und Flugfähigkeit bis zum Ende des Zuges. (Sie kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Hexerei\', \'flavor\': \'Nur demjenigen Krieger, der sterbliche Schwäche zugeben kann, wird unsterbliche Stärke gewährt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98446&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3bfb34e4-46fd-4c10-abc1-37ea93a0a26c\', \'multiverseId\': 98446}, \'multiverseid\': 98446}, {\'name\': \'Bendición angélica\', \'text\': \'La criatura objetivo obtiene +3/+3 y gana la habilidad de volar hasta el final del turno. (No puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Conjuro\', \'flavor\': \'Sólo el guerrero que pueda admitir debilidad mortal será auxiliado con fuerza inmortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99886&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'70374d92-69a5-4f62-b94e-53a5bcefeff2\', \'multiverseId\': 99886}, \'multiverseid\': 99886}, {\'name\': \'Bénédiction angélique\', \'text\': "La créature ciblée gagne +3/+3 et acquiert le vol jusqu\'à la fin du tour. (Elle ne peut être bloquée que par des créatures avec le vol.)", \'type\': \'Rituel\', \'flavor\': \'Seul le guerrier qui admet une faiblesse mortelle peut recevoir la force immortelle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98086&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a2daf20-6cdb-4d91-92d6-f0af2528b44e\', \'multiverseId\': 98086}, \'multiverseid\': 98086}, {\'name\': \'Benedizione Angelica\', \'text\': \'La creatura bersaglio prende +3/+3 e guadagna volare fino alla fine del turno. (Non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Stregoneria\', \'flavor\': \'Solo il guerriero capace di ammettere la propria fragilità mortale sarà sostenuto dalla forza immortale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98806&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e22d3866-f880-4a59-b643-ac59f278a863\', \'multiverseId\': 98806}, \'multiverseid\': 98806}, {\'name\': \'天使の祝福\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで+3/+3の修整を受けるとともに飛行を得る。 （それは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'ソーサリー\', \'flavor\': \'必滅の身であることを知っている戦士だけが、不滅の力に支えられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99166&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'30de3947-9016-4b77-a9b4-d19ec8a85220\', \'multiverseId\': 99166}, \'multiverseid\': 99166}, {\'name\': \'Bênção Angelical\', \'text\': \'A criatura alvo recebe +3/+3 e ganha a habilidade de voar até o final do turno. (Ela só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Feitiço\', \'flavor\': \'Somente o guerreiro que for capaz de admitir sua própria fragilidade mortal será favorecido com força imortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99526&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e2de1e1-d582-4a00-b528-8a537a1d42c1\', \'multiverseId\': 99526}, \'multiverseid\': 99526}, {\'name\': \'Благословение ангела\', \'text\': \'Целевое существо получает +3/+3 и наделяется способностью полета до конца хода. (Оно может быть заблокировано только существом со способностью полета).\', \'type\': \'Волшебство\', \'flavor\': \'Только тот воин, что признает в себе слабости смертных, будет наделен силой бессмертных.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109797&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f2e66096-85eb-4109-b686-052e189b7a27\', \'multiverseId\': 109797}, \'multiverseid\': 109797}, {\'name\': \'天使的祝福\', \'text\': \'目标生物得+3/+3并获得飞行异能直到回合结束。 （只有具飞行异能的生物才能阻挡它）\', \'type\': \'法术\', \'flavor\': \'只有勇于正视自身致命弱点的战士，才能受到超凡力量的庇护。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97726&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'86ff1290-6522-442f-bde7-be7f711602ce\', \'multiverseId\': 97726}, \'multiverseid\': 97726}]', '[{\'name\': \'Hornschildkröte\', \'type\': \'Kreatur — Schildkröte\', \'flavor\': \'Sie mag eigentlich keine Besucher, höchstens als Nachtisch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98575&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff45bc70-a889-49b9-b55e-5da19de6e9fd\', \'multiverseId\': 98575}, \'multiverseid\': 98575}, {\'name\': \'Tortuga astada\', \'type\': \'Criatura — Tortuga\', \'flavor\': \'No le gusta tener visitas. . . a menos que sea para almorzárselas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100015&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1389eeeb-89b0-464e-8cd9-1c9751408e8b\', \'multiverseId\': 100015}, \'multiverseid\': 100015}, {\'name\': \'Tortue cornue\', \'type\': \'Créature : tortue terrestre\', \'flavor\': "Elle n\'aime les visiteurs qu\'à l\'heure du repas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98215&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36ff214f-596d-437f-b952-2f50026b0b68\', \'multiverseId\': 98215}, \'multiverseid\': 98215}, {\'name\': \'Tartaruga Cornuta\', \'type\': \'Creatura — Tartaruga\', \'flavor\': \'Non le piace avere visite. . . a meno che arrivino per pranzo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98935&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'98e8c53f-a964-4eed-b988-f1528c2918ea\', \'multiverseId\': 98935}, \'multiverseid\': 98935}, {\'name\': \'角海亀\', \'type\': \'クリーチャー — 海亀\', \'flavor\': \'あいつは訪問客が好きじゃないんだ … … エサになる訪問客なら別だがね。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99295&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc1f664a-81a6-48c8-9b87-423bec48d33b\', \'multiverseId\': 99295}, \'multiverseid\': 99295}, {\'name\': \'Tartaruga Marinha com Chifres\', \'type\': \'Criatura — Tartaruga Marinha\', \'flavor\': \'Ela não aprecia visitantes . . . a menos que venham para o almoço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99655&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2079c416-3a77-4f57-88ac-ad9ef705b2b9\', \'multiverseId\': 99655}, \'multiverseid\': 99655}, {\'name\': \'Рогатая черепаха\', \'type\': \'Существо — Черепаха\', \'flavor\': \'Она не любит посетителей. . . разве что на завтрак.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109926&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b74eef83-8a59-4af5-a425-5d0f8cd18419\', \'multiverseId\': 109926}, \'multiverseid\': 109926}, {\'name\': \'角龟\', \'type\': \'生物～龟\', \'flavor\': \'他不喜欢访客. . . 只喜欢拿他们当午餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97855&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'24e9e3bd-9169-4d5d-bd57-a57eea65ef86\', \'multiverseId\': 97855}, \'multiverseid\': 97855}]', '[{\'name\': \'Hypnotisierendes Gespenst\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nImmer wenn das Hypnotisierende Gespenst einem Gegner Schaden zufügt, wirft dieser Spieler eine zufällig bestimmte Karte aus seiner Hand ab.\', \'type\': \'Kreatur — Specter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98579&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'638a2d56-28b7-44c3-bcd8-8131e24d4c61\', \'multiverseId\': 98579}, \'multiverseid\': 98579}, {\'name\': \'Espectro hipnótico\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nSiempre que el Espectro hipnótico haga daño a un oponente, ese jugador descarta una carta al azar.\', \'type\': \'Criatura — Espectro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100019&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a91a408-32c4-4890-a2ac-dd3124f0ab03\', \'multiverseId\': 100019}, \'multiverseid\': 100019}, {\'name\': \'Spectre hypnotiseur\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nÀ chaque fois que le Spectre hypnotiseur inflige des blessures à un adversaire, ce joueur se défausse au hasard d\'une carte.", \'type\': \'Créature : spectre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98219&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ad6c011-4f60-458a-8e5f-87c8e6b977cb\', \'multiverseId\': 98219}, \'multiverseid\': 98219}, {\'name\': \'Spettro Ipnotico\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nOgniqualvolta lo Spettro Ipnotico infligge danno a un avversario, quel giocatore scarta una carta a caso.\', \'type\': \'Creatura — Spettro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98939&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9694c60f-0770-4949-8828-3e1ca82d3528\', \'multiverseId\': 98939}, \'multiverseid\': 98939}, {\'name\': \'惑乱の死霊\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n惑乱の死霊がいずれかの対戦相手にダメージを与えるたび、そのプレイヤーはカードを１枚無作為に選んで捨てる。\', \'type\': \'クリーチャー — スペクター\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99299&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4537d7cf-6891-4aa6-a5e1-f5ec7a0c4e32\', \'multiverseId\': 99299}, \'multiverseid\': 99299}, {\'name\': \'Espectro Hipnótico\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nToda vez que Espectro Hipnótico causar dano a um oponente, aquele jogador descarta um card aleatoriamente.\', \'type\': \'Criatura — Espectro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99659&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b0cbced-89a0-41f5-baf8-63322342d800\', \'multiverseId\': 99659}, \'multiverseid\': 99659}, {\'name\': \'Усыпляющий призрак\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nКаждый раз, когда Усыпляющий призрак наносит повреждения оппоненту, тот сбрасывает одну случайно выбранную карту.\', \'type\': \'Существо — Призрак\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109930&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9985cd2a-51a2-4de0-8fe8-fe158fbe3ebb\', \'multiverseId\': 109930}, \'multiverseid\': 109930}, {\'name\': \'催眠幽灵\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n每当深渊幽灵向对手造成伤害时，该牌手随机弃一张牌。\', \'type\': \'生物～幽灵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97859&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eaef9ac7-557e-4dae-a14f-318b358f8725\', \'multiverseId\': 97859}, \'multiverseid\': 97859}]', "[{'name': 'Höhlen von Koilos', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {W} oder {B}. Die Höhlen von Koilos fügen dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98476&type=card', 'language': 'German', 'identifiers': {'scryfallId': '720797ce-dab4-4e5a-a9c6-fc11117583ae', 'multiverseId': 98476}, 'multiverseid': 98476}, {'name': 'Cuevas de Koilos', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {W} o {B} a tu reserva de maná. Las Cuevas de Koilos te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99916&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd5dcfdc9-7789-4323-93d3-6b38c80ea3fc', 'multiverseId': 99916}, 'multiverseid': 99916}, {'name': 'Cavernes de Koïlos', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {W} ou {B} à votre réserve. Ces Cavernes de Koïlos vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98116&type=card', 'language': 'French', 'identifiers': {'scryfallId': '660ff36a-e4d1-46b2-aed8-80fe65853294', 'multiverseId': 98116}, 'multiverseid': 98116}, {'name': 'Caverne di Koilos', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {W} o {B} alla tua riserva di mana. Le Caverne di Koilos ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98836&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '39655029-b2c9-4dcc-8ee7-b8e519366394', 'multiverseId': 98836}, 'multiverseid': 98836}, {'name': 'コイロスの洞窟', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{W}か{B}を加える。 コイロスの洞窟はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99196&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '137478cd-4c4c-4a70-8e5c-91842ed677a4', 'multiverseId': 99196}, 'multiverseid': 99196}, {'name': 'Cavernas de Koilos', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {W} ou {B} à sua reserva de mana. Cavernas de Koilos causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99556&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '986efb38-cd21-485f-836f-88005da5340a', 'multiverseId': 99556}, 'multiverseid': 99556}, {'name': 'Пещеры Койлоса', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {W} или {B} в запас маны. Пещеры Койлоса наносят вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109827&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c65c3aa9-73d7-4267-88d9-db7fc0e679a5', 'multiverseId': 109827}, 'multiverseid': 109827}, {'name': '喀洛斯洞窟', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{W}或{B}到你的法术力池中。 喀洛斯洞窟对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97756&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9f66a8b7-25fc-4bf8-8ae8-1b678e28c7a2', 'multiverseId': 97756}, 'multiverseid': 97756}]", '[{\'name\': \'Höhlenhunde\', \'text\': \'Immer wenn die Höhlenhunde angreifen, erhalten sie +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Ein Höhlenhund ist nie allein. Er wird stets von seinem Hunger nach Beute begleitet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98571&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2a9753d6-2801-4bb1-8fda-43d6587c1ba2\', \'multiverseId\': 98571}, \'multiverseid\': 98571}, {\'name\': \'Perros huecos\', \'text\': \'Siempre que los Perros huecos ataquen, obtienen +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Perro\', \'flavor\': \'Un perro hueco nunca está vacío. Está lleno de hambre de caza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100011&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c10cb300-cd9d-4812-ae22-feaee3ecaeca\', \'multiverseId\': 100011}, \'multiverseid\': 100011}, {\'name\': \'Chiens creux\', \'text\': "À chaque fois que ces Chiens creux attaquent, ils gagnent +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : chien de chasse\', \'flavor\': "Un chien creux n\'est pas vide. Il est empli de sa soif de chasser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98211&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bf1ddf63-331f-44d4-bedc-60a1d6b71661\', \'multiverseId\': 98211}, \'multiverseid\': 98211}, {\'name\': \'Cani Cavi\', \'text\': \'Ogniqualvolta i Cani Cavi attaccano, prendono +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Segugio\', \'flavor\': \'Un cane cavo non è mai vuoto: è pieno della sua fame per la caccia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98931&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d468cd6a-4986-4345-87a0-11783c2e5fd6\', \'multiverseId\': 98931}, \'multiverseid\': 98931}, {\'name\': \'虚ろの犬\', \'text\': \'虚ろの犬が攻撃に参加するたび、それはターン終了時まで+2/+0の修整を受ける。\', \'type\': \'クリーチャー — 猟犬\', \'flavor\': \'虚ろの犬は空っぽということはない。 狩りへの渇望で満たされているんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99291&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97e4069a-b45c-48e4-85a2-262dfe852dd1\', \'multiverseId\': 99291}, \'multiverseid\': 99291}, {\'name\': \'Cães Ocos\', \'text\': \'Toda vez que Cães Ocos atacar, ele recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Cão de Caça\', \'flavor\': \'Um cão oco nunca está vazio. Ele está cheio com a sede pela caçada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99651&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76120e39-d83e-49a5-a639-b81695cb72f6\', \'multiverseId\': 99651}, \'multiverseid\': 99651}, {\'name\': \'Пустотелые псы\', \'text\': \'Каждый раз, когда Пустотелые псы нападают, они получают +2/+0 до конца хода.\', \'type\': \'Существо — Пес\', \'flavor\': \'Пустотелый пес не пуст. В нем всегда есть жажда крови.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109922&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e2eb2df9-6a91-48c7-9878-5681a52b2728\', \'multiverseId\': 109922}, \'multiverseid\': 109922}, {\'name\': \'空腹狗群\', \'text\': \'每当空腹狗群攻击时，它得+2/+0直到回合结束。\', \'type\': \'生物～猎犬\', \'flavor\': \'空腹狗并不空虚， 它充满了狩猎的饥渴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97851&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12988bce-c49a-4707-b907-616879ba61cd\', \'multiverseId\': 97851}, \'multiverseid\': 97851}]', '[{\'name\': \'Hügelriese\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Glücklicherweise haben Hügelriesen große tote Winkel, in denen sich ein Mensch leicht verstecken kann. Leider jedoch befinden sich diese toten Winkel genau unter ihren Fußsohlen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98570&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9d9064d7-a2c6-4299-89c4-c09bf52b1544\', \'multiverseId\': 98570}, \'multiverseid\': 98570}, {\'name\': \'Gigante de las colinas\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Afortunadamente, los gigantes de las colinas tienen un punto ciego donde un humano puede fácilmente esconderse. Desafortunadamente, ese punto ciego está bajo sus pies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100010&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c5f5572-11e9-49e6-841b-cbab7fb6476d\', \'multiverseId\': 100010}, \'multiverseid\': 100010}, {\'name\': \'Géant des collines\', \'type\': \'Créature : géant\', \'flavor\': "Heureusement, il est facile de se cacher du regard d\'un géant des collines. Malheureusement, ces cachettes sont toutes sous la plante de leurs pieds.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98210&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea166395-ef87-498a-a9b0-840d3773ed91\', \'multiverseId\': 98210}, \'multiverseid\': 98210}, {\'name\': \'Gigante delle Colline\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Per fortuna i giganti delle colline hanno grandi zone cieche in cui un uomo può nascondersi. Purtroppo queste zone sono sotto ai loro piedi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98930&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03e8d3e0-9928-4249-b0a2-6884d80b37e2\', \'multiverseId\': 98930}, \'multiverseid\': 98930}, {\'name\': \'丘巨人\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'幸運なことに、丘巨人には人間が簡単に隠れられる大きな死角がある。 不幸なのは、この死角が彼らの足の裏の下にあることだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99290&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c2120e41-d367-47a8-aa2b-3231573c8d52\', \'multiverseId\': 99290}, \'multiverseid\': 99290}, {\'name\': \'Gigante da Colina\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Felizmente, os gigantes da colina têm grandes pontos cegos, nos quais um ser humano pode se esconder com facilidade. Infelizmente, estes pontos ficam debaixo da sola de seus pés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99650&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8336e4e3-dfe3-4641-8bca-59ea1e236304\', \'multiverseId\': 99650}, \'multiverseid\': 99650}, {\'name\': \'Гигант с холмов\', \'type\': \'Существо — Гигант\', \'flavor\': \'К счастью, есть области, которые не попадают в поле зрения Гиганта с холмов, там люди могут легко от него укрыться. К несчастью, эти области находятся под его пятками.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109921&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f7e13f9-36bf-47da-b5ba-355698b3c0f9\', \'multiverseId\': 109921}, \'multiverseid\': 109921}, {\'name\': \'山丘巨人\', \'type\': \'生物～巨人\', \'flavor\': \'幸运地，山丘巨人有着可让人类轻易躲藏的大盲点；不幸地，这些盲点正位于其脚底下。 但很不幸地，这些盲点是位于他们的脚底板下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97850&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b052047c-2034-4a18-a3c0-dbf452954845\', \'multiverseId\': 97850}, \'multiverseid\': 97850}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98585&type=card', 'language': 'German', 'identifiers': {'scryfallId': '348b7389-17dc-4e8e-8832-514adad2005c', 'multiverseId': 98585}, 'multiverseid': 98585}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100025&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6cf0b991-7f2c-4eca-99d6-fe437d3b491f', 'multiverseId': 100025}, 'multiverseid': 100025}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98225&ty