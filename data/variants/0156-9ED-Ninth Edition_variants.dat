866}, 'multiverseid': 97866}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98587&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8af0ceb0-6ef2-4d0f-95f2-9aa4083bf93e', 'multiverseId': 98587}, 'multiverseid': 98587}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100027&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '272b0839-b8fc-4a5a-a131-27da13e85448', 'multiverseId': 100027}, 'multiverseid': 100027}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98227&type=card', 'language': 'French', 'identifiers': {'scryfallId': '62ad975a-abc9-48ba-87fe-0887bdccf8e7', 'multiverseId': 98227}, 'multiverseid': 98227}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98947&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '37d0d279-f607-49e4-aca2-133fc333927f', 'multiverseId': 98947}, 'multiverseid': 98947}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99307&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '85a5cae6-3f40-44e4-84ae-8e4009624877', 'multiverseId': 99307}, 'multiverseid': 99307}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99667&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c81c17e1-7786-4877-91d7-11456f0f9816', 'multiverseId': 99667}, 'multiverseid': 99667}, {'name': 'Остров', 'type': 'Базовая земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109938&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0aa8523c-0591-438f-a317-9df06fcb7a3c', 'multiverseId': 109938}, 'multiverseid': 109938}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97867&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c942db6f-fefa-4b1a-8e45-fc57333e05d7', 'multiverseId': 97867}, 'multiverseid': 97867}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98588&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6021b703-f31a-4077-98ca-c3c8aacc9f12', 'multiverseId': 98588}, 'multiverseid': 98588}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100028&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ce78a722-6280-4c35-8318-2ecd74c33961', 'multiverseId': 100028}, 'multiverseid': 100028}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98228&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ae52bcc7-86bf-41e8-ae78-dd23b6fa02d0', 'multiverseId': 98228}, 'multiverseid': 98228}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98948&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dfb58883-0701-4e0b-8c72-7b1139af8e6f', 'multiverseId': 98948}, 'multiverseid': 98948}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99308&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c1110782-4c89-4238-b67e-42722d8514a2', 'multiverseId': 99308}, 'multiverseid': 99308}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99668&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2979031d-d92a-46d1-aea4-1b79d8b8a5db', 'multiverseId': 99668}, 'multiverseid': 99668}, {'name': 'Остров', 'type': 'Базовая земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109939&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'bdde700f-c0db-4c41-826d-030f332319fc', 'multiverseId': 109939}, 'multiverseid': 109939}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97868&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0977df50-7f18-4e20-8a49-736ed8a70f70', 'multiverseId': 97868}, 'multiverseid': 97868}]", '[{\'name\': \'Irrlichter\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\n{B}: Regeneriere die Irrlichter. (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Kreatur — Geist\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98783&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5529c12a-4f0d-4960-86c9-f59a6d4bbbde\', \'multiverseId\': 98783}, \'multiverseid\': 98783}, {\'name\': \'Fuego fatuo\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\n{B}: Regenera el Fuego fatuo (La próxima vez que esta criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Criatura — Espíritu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100223&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'159149f8-950c-48b1-90cc-9e5db56d8dc1\', \'multiverseId\': 100223}, \'multiverseid\': 100223}, {\'name\': \'Feu follet\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\n{B} : Régénérez le Feu follet. (La prochaine fois que cette créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Créature : esprit\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98423&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b9c8d2c-7368-4ad5-86d6-4b33a9e7a222\', \'multiverseId\': 98423}, \'multiverseid\': 98423}, {\'name\': \'Fuoco Fatuo\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\n{B}: Rigenera il Fuoco Fatuo. (La prossima volta che questa creatura verrebbe distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi tutti i danni da essa e rimuovila dal combattimento.)\', \'type\': \'Creatura — Spirito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99143&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86485b24-b9fd-4bb9-9ca1-e2be304bcbb9\', \'multiverseId\': 99143}, \'multiverseid\': 99143}, {\'name\': \'鬼火\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n{B}：鬼火を再生する。 （このターン、次にこのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'クリーチャー — スピリット\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99503&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5cdb6cf-94f9-4a84-8e50-d68a3b760dc3\', \'multiverseId\': 99503}, \'multiverseid\': 99503}, {\'name\': \'Fogo-fátuo\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\n{B}: Regenera Fogo-fátuo. (Na próxima vez em que esta criatura seria destruída neste turno, ela não o é Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Criatura — Espírito\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99863&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c11b9ed-930e-4703-87f0-fdeec8be4f54\', \'multiverseId\': 99863}, \'multiverseid\': 99863}, {\'name\': \'Блуждающий огонек\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\n{B}: Регенерируйте Блуждающий огонек. (Если в течение этого хода это существо будет уничтожено, оно не отправляется на кладбище. Вместо этого поверните его, снимите с него все повреждения и выведите его из боя).\', \'type\': \'Существо — Дух\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110134&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8628906a-d42c-49d1-88d4-cd2318eb0566\', \'multiverseId\': 110134}, \'multiverseid\': 110134}, {\'name\': \'鬼火\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n{B}：重生鬼火。 （如果此生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除所受的所有伤害，并将它移出战斗。）\', \'type\': \'生物～精怪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98063&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'07c210f5-16a5-43dd-894f-4c54a4f1bfec\', \'multiverseId\': 98063}, \'multiverseid\': 98063}]', '[{\'name\': \'Jadestatue\', \'text\': \'{2}: Die Jadestatue wird bis zum Ende des Kampfes zu einer 3/6 Artefaktkreatur. Spiele diese Fähigkeit nur während des Kampfes.\', \'type\': \'Artefakt\', \'flavor\': \'„Das Paradoxe an Jadestatuen ist, dass ihre Opfer nie wirklich mit einem Angriff rechnen, andererseits aber auch nie völlig überrascht sind." —Kabel, Tolarianischer Archivar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98590&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe7335d2-08f4-456d-8dcc-bced754e45bd\', \'multiverseId\': 98590}, \'multiverseid\': 98590}, {\'name\': \'Estatua de jade\', \'text\': \'{2}: La Estatua de jade se convierte en una criatura artefacto 3/6 hasta el final del combate. Juega esta habilidad sólo durante el combate.\', \'type\': \'Artefacto\', \'flavor\': \'"La paradoja de las estatuas de jade es que sus víctimas nunca esperan realmente el ataque, pero tampoco están completamente sorprendidas." —Kabel, archivista tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100030&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'833212d2-9cf8-4ddf-87bb-fa8a540c7a54\', \'multiverseId\': 100030}, \'multiverseid\': 100030}, {\'name\': \'Statue de jade\', \'text\': "{2} : La Statue de jade devient une créature-artefact 3/6 jusqu\'à la fin du combat. Ne jouez cette capacité que pendant le combat.", \'type\': \'Artefact\', \'flavor\': "« Le paradoxe des statues de jade, c\'est que leurs victimes ne s\'attendent jamais à être attaquées, mais qu\'elles ne sont jamais vraiment surprises non plus. » —Kabel, archiviste tolarian", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98230&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b1f582d-4287-4b9e-9df7-f3c21d74cc11\', \'multiverseId\': 98230}, \'multiverseid\': 98230}, {\'name\': \'Statua di Giada\', \'text\': \'{2}: La Statua di Giada diventa una creatura artefatto 3/6 fino alla fine del combattimento. Gioca questa abilità solo durante il combattimento.\', \'type\': \'Artefatto\', \'flavor\': \'"Il paradosso delle statue di giada è che le loro vittime non si aspettano mai veramente di essere attaccate, ma non sono mai completamente sorprese." —Kabel, archivista tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98950&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cf77c8c-7392-42aa-95dd-47c181c051de\', \'multiverseId\': 98950}, \'multiverseid\': 98950}, {\'name\': \'翡翠像\', \'text\': \'{2}：翡翠像は戦闘終了時まで3/6のアーティファクト・クリーチャーになる。 この能力は、戦闘中にしかプレイできない。\', \'type\': \'アーティファクト\', \'flavor\': \'翡翠像の持つ矛盾とは、犠牲者が誰もその攻撃を予期していないにもかかわらず、完璧な奇襲を受けたと思ってもいないことだ。 ――トレイリアの文書管理人、ケイベル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99310&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1e7d00e-16d2-4817-8652-aa5c087aa64b\', \'multiverseId\': 99310}, \'multiverseid\': 99310}, {\'name\': \'Estátua de Jade\', \'text\': \'{2}: Estátua de Jade torna-se uma criatura artefato 3/6 até o final do combate. Use esta habilidade apenas durante o combate.\', \'type\': \'Artefato\', \'flavor\': \'"As estátuas de jade são um paradoxo, suas vítimas nunca esperam realmente o ataque, mas nunca são completamente surpreendidas por ele." — Kabel, arquivista Tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99670&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af4599ff-cb4d-4a70-8d14-32aabc510a89\', \'multiverseId\': 99670}, \'multiverseid\': 99670}, {\'name\': \'Нефритовая статуя\', \'text\': \'{2}: Нефритовая статуя становится артефактом со значением силы 3/6 до конца боя. Разыгрывайте эту способность только во время боя.\', \'type\': \'Артефакт\', \'flavor\': \'"Парадокс заключается в том, что жертвы нефритовой статуи никогда не готовы к нападению, и все же нападение никогда не является для них полной неожиданностью". — Кабел, толарийский архивариус\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109941&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'43ed72a0-8e91-42d7-97dc-2e9ef4cf4e78\', \'multiverseId\': 109941}, \'multiverseid\': 109941}, {\'name\': \'翠玉雕偶\', \'text\': \'{2}：翠玉雕偶成为3/6神器生物直到战斗结束。 此异能只能在战斗中使用。\', \'type\': \'神器\', \'flavor\': \'「关于翠玉雕偶的奇谈：命丧其手的人固然都是猝然遇袭，但他们也并非全无防备。」 ～陶拉里亚书库辖员卡贝尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97870&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cdc13dcb-1955-4797-9532-18b8b861bfb5\', \'multiverseId\': 97870}, \'multiverseid\': 97870}]', '[{\'name\': \'Kadaverreißer\', \'text\': \'Stärke und Widerstandskraft des Kadaverreißers sind gleich der Anzahl der Kreaturenkarten auf allen Friedhöfen.\\n{B}: Regeneriere den Kadaverreißer. (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Kreatur — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98627&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e42d1771-b9ab-462d-9e4c-5c7003201e4f\', \'multiverseId\': 98627}, \'multiverseid\': 98627}, {\'name\': \'Mortívoro\', \'text\': \'Tanto la fuerza como la resistencia del Mortívoro son iguales al número de cartas de criatura que haya en todos los cementerios.\\n{B}: Regenera al Mortívoro. (La próxima vez que esta criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100067&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81303b0d-52dc-496b-9710-b22b84b9fb6f\', \'multiverseId\': 100067}, \'multiverseid\': 100067}, {\'name\': \'Nécrovore\', \'text\': "La force et l\'endurance du Nécrovore sont chacune égale au nombre de cartes de créature dans tous les cimetières.\\n{B} : Régénérez le Nécrovore. (La prochaine fois que cette créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Créature : lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98267&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e757cb4d-d29b-4575-bffd-fea43fb365f0\', \'multiverseId\': 98267}, \'multiverseid\': 98267}, {\'name\': \'Mortivoro\', \'text\': \'La forza e la costituzione del Mortivoro sono pari ciascuna al numero di carte creatura presenti in tutti i cimiteri.\\n{B}: Rigenera il Mortivoro. (La prossima volta che questa creatura sta per essere distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi tutti i danni da essa e rimuovila dal combattimento.)\', \'type\': \'Creatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98987&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f2e1395-7fdc-49d5-b81b-969b57a6abf8\', \'multiverseId\': 98987}, \'multiverseid\': 98987}, {\'name\': \'死を食うもの\', \'text\': \'死を食うもののパワーとタフネスは、それぞれすべての墓地にあるクリーチャー・カードの枚数に等しい。\\n{B}：死を食うものを再生する。 （このターン、次にこのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'クリーチャー — ルアゴイフ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99347&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6381c03-e055-47da-8898-855267675d31\', \'multiverseId\': 99347}, \'multiverseid\': 99347}, {\'name\': \'Mortívoro\', \'text\': \'O poder e a resistência de Mortívoro são ambos iguais ao número de cards de criatura em todos os cemitérios.\\n{B}: Regenera Mortívoro. (Na próxima vez em que esta criatura seria destruída neste turno, ela não o é Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99707&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed451ac0-6f3d-4184-a26c-274105566364\', \'multiverseId\': 99707}, \'multiverseid\': 99707}, {\'name\': \'Мортивор\', \'text\': \'Сила и здоровье Мортивора равняются числу карт существ на всех кладбищах.\\n{B}: Регенерируйте Мортивора. (Если в течение этого хода это существо будет уничтожено, оно не отправляется на кладбище. Вместо этого поверните его, снимите с него все повреждения и выведите его из боя).\', \'type\': \'Существо — Лургойф\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109978&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55c99fe4-e1fa-4fa9-a387-bfe832927edc\', \'multiverseId\': 109978}, \'multiverseid\': 109978}, {\'name\': \'噬殁兽\', \'text\': \'噬殁兽的力量和防御力各等同于所有坟墓场中的生物牌之数量。\\n{B}：重生噬殁兽。 （如果此生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除所受的所有伤害，并将它移出战斗。）\', \'type\': \'生物～拉高耶夫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97907&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7af270b-b52b-49da-974f-ad4df9ac701c\', \'multiverseId\': 97907}, \'multiverseid\': 97907}]', "[{'name': 'Kaiserkrokodil', 'text': 'Wenn du keine anderen Kreaturen kontrollierst, opfere das Kaiserkrokodil.', 'type': 'Kreatur — Krokodil', 'flavor': 'Der Fürst der Gewässer Yavimayas ist fast rührend um seine Untertanen besorgt und genießt ihre Verherrlichung sehr.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98516&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fa565822-7d4b-4e48-bb61-977956e6bfa1', 'multiverseId': 98516}, 'multiverseid': 98516}, {'name': 'Cocodrilo emperador', 'text': 'Cuando no controles ninguna otra criatura, sacrifica el Cocodrilo emperador.', 'type': 'Criatura — Cocodrilo', 'flavor': 'El rey de las aguas de Yavimaya presta constante atención a sus súbditos . . . y prospera con su adulación.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99956&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8f23299d-7e67-45b9-9d64-cf08b965ea6a', 'multiverseId': 99956}, 'multiverseid': 99956}, {'name': 'Crocodile empereur', 'text': 'Quand vous ne contrôlez aucune autre créature, sacrifiez le Crocodile empereur.', 'type': 'Créature : crocodile', 'flavor': 'Le roi des eaux de la Yavimaya fait particulièrement attention à ses sujets . . . et se repaît de leur adoration.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98156&type=card', 'language': 'French', 'identifiers': {'scryfallId': '23f856d4-f0c4-43ae-b5fa-bc6dbc2152d5', 'multiverseId': 98156}, 'multiverseid': 98156}, {'name': 'Coccodrillo Imperatore', 'text': 'Quando non controlli altre creature, sacrifica il Coccodrillo Imperatore.', 'type': 'Creatura — Coccodrillo', 'flavor': 'Il re delle acque di Yavimaya presta sempre attenzione ai propri sudditi. . . e prospera grazie alla loro adulazione.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98876&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6cecb94f-1f3f-44d3-b873-c9d3c4ed9c19', 'multiverseId': 98876}, 'multiverseid': 98876}, {'name': '皇帝クロコダイル', 'text': 'あなたが他にクリーチャーを１体もコントロールしてないとき、皇帝クロコダイルを生け贄に捧げる。', 'type': 'クリーチャー — クロコダイル', 'flavor': 'ヤヴィマヤの水路の王者は、自分の家来たちに絶え間ない注意を払っている … … そして家来たちの追従を生き甲斐にしている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99236&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8a98f31a-5a8c-47ee-85a1-2c2c692de53d', 'multiverseId': 99236}, 'multiverseid': 99236}, {'name': 'Crocodilo Imperador', 'text': 'Quando você não controlar outras criaturas, sacrifique Crocodilo Imperador.', 'type': 'Criatura — Crocodilo', 'flavor': 'O rei das águas de Yavimaya presta muita atenção a seus súditos . . . e alimenta-se de sua adulação.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99596&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a3f04a6e-1f5c-4be3-8d72-2d3a7973d673', 'multiverseId': 99596}, 'multiverseid': 99596}, {'name': 'Царь крокодилов', 'text': 'Если из существ вы контролируете только Царя крокодилов, принесите его в жертву.', 'type': 'Существо — Крокодил', 'flavor': 'Король вод Явимайи особое внимание уделяет своим подданным. . . и расцветает от их лести.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109867&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '87f5534a-a105-4eb8-ab6f-4dc3e7ba2517', 'multiverseId': 109867}, 'multiverseid': 109867}, {'name': '帝王鳄鱼', 'text': '当你未操控其它生物时，牺牲帝王鳄鱼。', 'type': '生物～鳄鱼', 'flavor': '亚维马雅水域之王者持续地照护其臣民. . . 并且因着他们的奉承而繁盛不息。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97796&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'aae8cdff-ef72-4282-a50e-b929d2fb99aa', 'multiverseId': 97796}, 'multiverseid': 97796}]", '[{\'name\': \'Kami des alten Steins\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Hier war eine Mauer. Nun ist sie Staub. Ein Turm wuchs hier empor. Nun ist er zerfallen. Eine Armee kämpfte hier. Nun ist sie tot. Ein Geist war hier. Nur er bleibt übrig." —Schneepelz, Kitsune-Dichter\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98592&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7084df1-582a-4ce1-9e1a-3cbcae73c7c7\', \'multiverseId\': 98592}, \'multiverseid\': 98592}, {\'name\': \'Kami de piedra vieja\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"Aquí había una pared. Ahora es polvo. Aquí se alzaba una torre. Ahora es escombros. Aquí luchó un ejército. Ahora está muerto. Aquí había un espíritu. Y es todo lo que queda." —Pelaje-nevado, poeta kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100032&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1647c8ab-a902-4f3e-a572-560920b4917c\', \'multiverseId\': 100032}, \'multiverseid\': 100032}, {\'name\': \'Kami des vieilles pierres\', \'type\': \'Créature : esprit\', \'flavor\': "« Jadis il y avait un mur. Il n\'est plus que poussière. Jadis il y avait une tour. Elle n\'est plus qu\'un tas de pierres. Jadis, il y avait une armée. Elle n\'est plus de ce monde. Jadis, il y avait un esprit. Il est tout ce qui reste. » —Fourrure-de-neige, poète kitsune", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98232&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c320d57c-5f77-42d2-a813-ea5fa4c6399c\', \'multiverseId\': 98232}, \'multiverseid\': 98232}, {\'name\': \'Kami della Vecchia Pietra\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"C\\\'era un muro in questo punto. Ora c\\\'è solo polvere. Qui sorgeva una torre. Ora è caduta. Un esercito ha combattuto qui. Sono tutti morti. E qui c\\\'era uno spirito. È l\\\'unica cosa rimasta." —Pelo-di-Neve, poeta kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98952&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30fe8bfa-d059-4cb6-aaff-d66dbfd2116e\', \'multiverseId\': 98952}, \'multiverseid\': 98952}, {\'name\': \'古石の神\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'ここに壁あり、 いまや塵。 ここに塔あり、 いまや落つ。 ここに兵あり、 いまや死す。 ここに霊あり、 ただ残りたり。 ――狐の詩人、雪毛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99312&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'97290695-1950-4115-9eac-83b4146fb83b\', \'multiverseId\': 99312}, \'multiverseid\': 99312}, {\'name\': \'Kami da Pedra Velha\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"Aqui havia uma muralha. Agora, ela é pó. Aqui ergueu-se uma torre. Agora ela está caída. Aqui lutou um exército. Agora ele está morto. Aqui havia um espírito. Ele é tudo o que resta." — Pêlo de Neve, poeta kitsune\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99672&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8326e95a-be55-480d-8b4d-7f918b58a581\', \'multiverseId\': 99672}, \'multiverseid\': 99672}, {\'name\': \'Ками древнего камня\', \'type\': \'Существо — Дух\', \'flavor\': \'"Там стояла стена. А теперь там пыль. Там высилась башня. Теперь ее нет. Там сходились воины в схватке. И пали. И лишь дух, что парил там, до сих пор не покинул тех мест". — Снежный Мех, поэт китсуне\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109943&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd77b992-3b19-493a-8278-887ae488a4ec\', \'multiverseId\': 109943}, \'multiverseid\': 109943}, {\'name\': \'古岩神\', \'type\': \'生物～精怪\', \'flavor\': \'「宫墙今成灰， 巍塔早倾颓； 勇士尽入土， 英魂胡不归。」 ～狐诗人雪毛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97872&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8fee1c97-cec6-4de6-b899-4a8bf9f6bf00\', \'multiverseId\': 97872}, \'multiverseid\': 97872}]', "[{'name': 'Karplusanischer Wald', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {G}. Der Karplusanische Wald fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98593&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6e0f6ca7-1512-4bf1-b503-076cedc03bee', 'multiverseId': 98593}, 'multiverseid': 98593}, {'name': 'Foresta karplusana', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {R} o {G} a tu reserva de maná. La Foresta karplusana te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100033&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6c71c7a6-4eb3-48fe-a66b-026e952ab5ec', 'multiverseId': 100033}, 'multiverseid': 100033}, {'name': 'Forêt de Karpluse', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {R} ou {G} à votre réserve. La Forêt de Karpluse vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98233&type=card', 'language': 'French', 'identifiers': {'scryfallId': '333ca6ed-211b-4bdf-a75d-e403523648bf', 'multiverseId': 98233}, 'multiverseid': 98233}, {'name': 'Foresta di Karplus', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {R} o {G} alla tua riserva di mana. La Foresta di Karplus ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98953&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e31798ae-1d86-4f8b-9e50-64026daa53e2', 'multiverseId': 98953}, 'multiverseid': 98953}, {'name': 'カープルーザンの森', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{R}か{G}を加える。 カープルーザンの森はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99313&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a6579fe7-03ed-4897-9401-78b5ae2b4350', 'multiverseId': 99313}, 'multiverseid': 99313}, {'name': 'Floresta Karplusana', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {R} ou {G} à sua reserva de mana. Floresta Karplusana causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99673&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7016e0d5-f2f5-4f12-b532-9e219e8366df', 'multiverseId': 99673}, 'multiverseid': 99673}, {'name': 'Карплюсанский лес', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {R} или {G} в запас маны. Карплюсанский лес наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109944&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '861f12ac-739b-4e83-a521-d16cbbbc055b', 'multiverseId': 109944}, 'multiverseid': 109944}, {'name': '卡普路桑森林', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{R}或{G}到你的法术力池中。 卡普路桑森林对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97873&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4246462e-ce15-460a-9f28-1450ac6ed87c', 'multiverseId': 97873}, 'multiverseid': 97873}]", "[{'name': 'Karplusanischer Yeti', 'text': '{T}: Der Karplusanische Yeti fügt einer Kreatur deiner Wahl Schadenspunkte in Höhe seiner Stärke zu. Diese Kreatur fügt dem Karplusanischen Yeti Schaden in Höhe ihrer Stärke zu.', 'type': 'Kreatur — Yeti', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98594&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c53656c8-f774-425f-b361-8e55409583b4', 'multiverseId': 98594}, 'multiverseid': 98594}, {'name': 'Yeti karplusano', 'text': '{T}: El Yeti karplusano hace una cantidad de daño igual a su fuerza a la criatura objetivo. Esa criatura hace una cantidad de daño igual a su fuerza al Yeti karplusano.', 'type': 'Criatura — Yeti', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100034&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a76f4bf1-565c-4ac7-97ee-a75f4d946229', 'multiverseId': 100034}, 'multiverseid': 100034}, {'name': 'Yeti karpluséan', 'text': '{T} : Le Yeti karpluséan inflige un nombre de blessures égal à sa force à la créature ciblée. Cette créature inflige un nombre de blessures égal à sa force au Yeti karpluséan.', 'type': 'Créature : yeti', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98234&type=card', 'language': 'French', 'identifiers': {'scryfallId': '53ae9890-23cd-415e-a384-954ef9573acd', 'multiverseId': 98234}, 'multiverseid': 98234}, {'name': 'Yeti di Karplus', 'text': '{T}: Lo Yeti di Karplus infligge un ammontare di danni pari alla propria forza a una creatura bersaglio. Quella creatura infligge un ammontare di danni pari alla propria forza allo Yeti di Karplus', 'type': 'Creatura — Yeti', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98954&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7e07bb0f-f91c-4a75-bc41-bf2b99728e75', 'multiverseId': 98954}, 'multiverseid': 98954}, {'name': 'カープルーザンのイエティ', 'text': '{T}：クリーチャー１体を対象とする。カープルーザンのイエティはそれに、自身のパワーに等しい値のダメージを与える。 そのクリーチャーはカープルーザンのイエティに、そのクリーチャーのパワーに等しい値のダメージを与える。', 'type': 'クリーチャー — イエティ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99314&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9056374b-1d32-40ec-8f3d-39fadc31a752', 'multiverseId': 99314}, 'multiverseid': 99314}, {'name': 'Yeti Karplusano', 'text': '{T}: Yeti Karplusano causa uma quantidade de dano igual ao seu poder à criatura alvo. Aquela criatura causa uma quantidade de dano igual ao seu poder a Yeti Karplusano.', 'type': 'Criatura — Yeti', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99674&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2418cc05-d3c9-435c-bb6b-b78640455030', 'multiverseId': 99674}, 'multiverseid': 99674}, {'name': 'Карплюсанский йети', 'text': '{T}: Целевому существу количество повреждений, равное силе карплюсанского йети. Карплюсанскому йети наносится количество повреждений, равное силе этого существа.', 'type': 'Существо — Йети', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109945&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b7fbf344-4c02-49e5-9189-3dffe89c510c', 'multiverseId': 109945}, 'multiverseid': 109945}, {'name': '卡普路桑雪怪', 'text': '{T}：卡普路桑雪怪对目标生物造成等同于卡普路桑雪怪力量的伤害。 该生物对卡普路桑雪怪造成等同于该生物力量的伤害。', 'type': '生物～雪怪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97874&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd1a75cca-3769-498c-9b8d-e4887c4acf5f', 'multiverseId': 97874}, 'multiverseid': 97874}]", '[{\'name\': \'Kird der Menschenaffe\', \'text\': \'Kird der Menschenaffe erhält +1/+2, solange du einen Wald kontrollierst.\', \'type\': \'Kreatur — Menschenaffe\', \'flavor\': \'Sein Zorn ist so legendär wie seine Zotteln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98597&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ccaf1d33-a0f8-4d65-9690-c759c3c268d0\', \'multiverseId\': 98597}, \'multiverseid\': 98597}, {\'name\': \'Simio de Kird\', \'text\': \'El Simio de Kird obtiene +1/+2 mientras controles un bosque.\', \'type\': \'Criatura — Simio\', \'flavor\': \'Le pone la piel a la pelea.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100037&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'07b9e687-cd93-4c44-a343-e2c7ee02e6b7\', \'multiverseId\': 100037}, \'multiverseid\': 100037}, {\'name\': \'Gorille beringeï\', \'text\': \'Le Gorille beringeï gagne +1/+2 tant que vous contrôlez une forêt.\', \'type\': \'Créature : grand singe\', \'flavor\': \'La « fourrure » en « furie. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98237&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b1b580f-d4ce-4e00-998c-281ad624d042\', \'multiverseId\': 98237}, \'multiverseid\': 98237}, {\'name\': \'Gorilla di Kird\', \'text\': \'Il Gorilla di Kird prende +1/+2 fintanto che controlli almeno una Foresta.\', \'type\': \'Creatura — Scimpanzé\', \'flavor\': \'Una massa di pelo e ferocia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98957&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c7603f5-2013-4a1e-8e7f-3ab753a76059\', \'multiverseId\': 98957}, \'multiverseid\': 98957}, {\'name\': \'密林の猿人\', \'text\': \'密林の猿人は、あなたが森をコントロールしているかぎり+1/+2の修整を受ける。\', \'type\': \'クリーチャー — 類人猿\', \'flavor\': \'体毛の下の獰猛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99317&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d9f5939-1abd-46b7-8501-55f37a9d9a01\', \'multiverseId\': 99317}, \'multiverseid\': 99317}, {\'name\': \'Símio Kird\', \'text\': \'Símio Kird recebe +1/+2 desde que você controle uma Floresta.\', \'type\': \'Criatura — Símio\', \'flavor\': \'Ele é tão "peludo" quanto "perigoso".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99677&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e42d438-aea9-4147-aa29-d290464edc27\', \'multiverseId\': 99677}, \'multiverseid\': 99677}, {\'name\': \'Обезьяна Кирд\', \'text\': \'Обезьяна Кирд получает +1/+2, пока вы контролируете Лес.\', \'type\': \'Существо — Обезьяна\', \'flavor\': \'Она превращает "зверя" в "зверство".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109948&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d0076f1d-e0ed-4c76-b120-e990b2b5a019\', \'multiverseId\': 109948}, \'multiverseid\': 109948}, {\'name\': \'柯德猿猴\', \'text\': \'只要你操控树林，柯德猿猴便得+1/+2。\', \'type\': \'生物～猿猴\', \'flavor\': \'他披著名为「泼皮」的毛皮。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97877&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f33d27a1-3c98-40ed-855c-426ed4ebc310\', \'multiverseId\': 97877}, \'multiverseid\': 97877}]', '[{\'name\': \'Kletterkavu\', \'text\': \'Wenn der Kletterkavu ins Spiel kommt, ziehe eine Karte.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'„Zweige zerbrachen, Blätter raschelten, dann ließ ein Brüllen alles erzittern. Unsere Gruppe hatte keine Chance, als der Tod von oben kam." —Taseen, Elfenbarde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98595&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6f5f3755-8b86-41ad-84a0-9549af241a2e\', \'multiverseId\': 98595}, \'multiverseid\': 98595}, {\'name\': \'Kavu escalador\', \'text\': \'Cuando el Kavu escalador entre en juego, roba una carta.\', \'type\': \'Criatura — Kavu\', \'flavor\': \'"Hubo un crujir de ramas, ruido de hojas y un tremendo rugido. Nuestro grupo no tuvo ninguna oportunidad cuando la muerte descendió sobre nosotros." —Taseen, bardo élfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100035&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b9093f49-f427-4321-bb8f-a5f1efe5e4d8\', \'multiverseId\': 100035}, \'multiverseid\': 100035}, {\'name\': \'Kavru grimpeur\', \'text\': \'Quand le Kavru grimpeur arrive en jeu, piochez une carte.\', \'type\': \'Créature : kavru\', \'flavor\': \'« Il y eu un craquement de branches, un bruissement de feuilles, puis un terrible rugissement. La mort tomba sans prévenir sur notre groupe. » —Taseen, barde elfe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98235&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0e8a5c91-ff5a-42b0-9239-d497ee39095d\', \'multiverseId\': 98235}, \'multiverseid\': 98235}, {\'name\': \'Scalatore Kavu\', \'text\': \'Quando lo Scalatore Kavu entra in gioco, pesca una carta.\', \'type\': \'Creatura — Kavu\', \'flavor\': \'"Udimmo il rumore di rami spezzati, un fruscio di foglie e poi un tremendo ruggito. Il nostro gruppo non aveva speranze mentre la morte piombava dall\\\'alto." —Taseen, bardo elfico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98955&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b45071f6-3457-4f1d-b554-7378884ea835\', \'multiverseId\': 98955}, \'multiverseid\': 98955}, {\'name\': \'木登りカヴー\', \'text\': \'木登りカヴーが場に出たとき、カードを１枚引く。\', \'type\': \'クリーチャー — カヴー\', \'flavor\': \'枝の折れる音や葉の擦れる音がして、その直後にすさまじいうなり声が上がったんだ。 私の仲間は、上から降ってきた死を逃れる術すら無かったよ。 ――エルフの吟遊詩人、タシーン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99315&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'baf7408f-2e87-47c2-ac95-5d0714781aa4\', \'multiverseId\': 99315}, \'multiverseid\': 99315}, {\'name\': \'Escalador Kavu\', \'text\': \'Quando Escalador Kavu entra em jogo, compre um card.\', \'type\': \'Criatura — Kavu\', \'flavor\': \'"Houve um estalido de galhos, um farfalhar de folhas e depois um rugido terrível. Nosso grupo não tinha chance conforme a morte descia." — Taseen, bardo elfo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99675&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9db0bce5-fc76-4391-8a9d-215574080f1b\', \'multiverseId\': 99675}, \'multiverseid\': 99675}, {\'name\': \'Скалолаз Каву\', \'text\': \'Когда Скалолаз Каву вступает в игру, возьмите карту.\', \'type\': \'Существо — Каву\', \'flavor\': \'"Мы услышали хруст веток, шорох листьев, а затем ужасный рев. У нас не было шансов спастись: смерть пришла к нам сверху". — Тасеен, эльфийский бард\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109946&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d08f8145-ae61-4a12-9890-1c92a069df5b\', \'multiverseId\': 109946}, \'multiverseid\': 109946}, {\'name\': \'攀爬卡甫\', \'text\': \'当攀爬卡甫进场时，抓一张牌。\', \'type\': \'生物～卡甫\', \'flavor\': \'「几根树枝断裂，树叶飒飒作响，接着一声震天狂吼。 当死亡从天而降，我们一行人毫无机会逃离。」 ～地精吟游诗人塔欣\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97875&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'47bc0293-87cb-41c6-922e-58b54a1a5b57\', \'multiverseId\': 97875}, \'multiverseid\': 97875}]', "[{'name': 'Klon', 'text': 'Sowie der Klon ins Spiel kommt, kannst du eine Kreatur im Spiel bestimmen. Falls du dies tust, kommt der Klon als eine Kopie dieser Kreatur ins Spiel.', 'type': 'Kreatur — Gestaltwandler', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98480&type=card', 'language': 'German', 'identifiers': {'scryfallId': '61a718d5-b026-47af-b51e-3be1ef0a2857', 'multiverseId': 98480}, 'multiverseid': 98480}, {'name': 'Clon', 'text': 'En cuanto el Clon entre en juego, puedes elegir una criatura en juego. Si lo haces, el Clon entra en juego como una copia de esa criatura.', 'type': 'Criatura — Metamorfo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99920&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9047f1d1-bb2a-49ce-ac5b-973915dea092', 'multiverseId': 99920}, 'multiverseid': 99920}, {'name': 'Clone', 'text': 'Au moment où le Clone arrive en jeu, vous pouvez choisir une créature en jeu. Si vous faites ainsi, le Clone arrive en jeu comme une copie de cette créature.', 'type': 'Créature : changeforme', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98120&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0aac56ab-db08-4131-b48b-ce9e66624d62', 'multiverseId': 98120}, 'multiverseid': 98120}, {'name': 'Clone', 'text': 'Mentre il Clone entra in gioco, puoi scegliere una creatura in gioco. Se lo fai, il Clone entra in gioco come una copia di quella creatura.', 'type': 'Creatura — Polimorfo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98840&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '074de3bb-e1a6-4957-8621-c7da71b440f0', 'multiverseId': 98840}, 'multiverseid': 98840}, {'name': 'クローン', 'text': 'クローンが場に出るに際し、あなたは場に出ているクリーチャー１体を選んでもよい。 そうした場合、クローンはそのクリーチャーのコピーとして場に出る。', 'type': 'クリーチャー — 多相の戦士', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99200&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9250d946-9bbc-4b9c-aa45-d4c4e0b60c7f', 'multiverseId': 99200}, 'multiverseid': 99200}, {'name': 'Clone', 'text': 'Conforme Clone entra em jogo, você pode escolher uma criatura em jogo. Se o fizer, Clone entra em jogo como uma cópia daquela criatura.', 'type': 'Criatura — Metamorfo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99560&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '41c36983-1a39-4f6d-b179-2da8a8cf8d2c', 'multiverseId': 99560}, 'multiverseid': 99560}, {'name': 'Клон', 'text': 'Как только клон вступает в игру, выберите существо, которое находится в игре. В таком случае Клон вступает в игру в качестве копии выбранного существа.', 'type': 'Существо — Оборотень', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109831&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4882c453-9ff8-479c-8938-764daf3046a4', 'multiverseId': 109831}, 'multiverseid': 109831}, {'name': '仿生妖', 'text': '于仿生妖进场时，你可以选择场上的一个生物。 若你如此作，则仿生妖进场时为该生物的复制。', 'type': '生物～变形兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97760&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '635e6c85-4c5c-4067-879b-a4e9fa227a19', 'multiverseId': 97760}, 'multiverseid': 97760}]", '[{\'name\': \'Knäuelblüte\', \'text\': \'{1}, {T}: Du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Die Blüte enthält keine Samen. Ihr einziger Zweck ist es, die Waldbewohner zu ernähren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98739&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'262b6057-f280-4346-b08f-c70184b30847\', \'multiverseId\': 98739}, \'multiverseid\': 98739}, {\'name\': \'Fruto de la Maraña\', \'text\': \'{1}, {T}: Ganas 1 vida.\', \'type\': \'Artefacto\', \'flavor\': \'El fruto no tiene semillas. Su único propósito es alimentar a los habitantes del bosque.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100179&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c81b6c6-87bb-4cae-a592-17847968968e\', \'multiverseId\': 100179}, \'multiverseid\': 100179}, {\'name\': \'Floraison de la Filandre\', \'text\': \'{1}, {T} : Vous gagnez 1 point de vie.\', \'type\': \'Artefact\', \'flavor\': "La fleur ne contient pas de graines. Elle ne sert qu\'à nourrir les habitants de la forêt.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98379&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'87d3ddee-508c-4c2e-b275-57e21b972946\', \'multiverseId\': 98379}, \'multiverseid\': 98379}, {\'name\': \'Germoglio del Groviglio\', \'text\': \'{1}, {T}: Guadagni un punto vita.\', \'type\': \'Artefatto\', \'flavor\': \'Il germoglio non contiene semi. Serve solo a nutrire gli abitanti della foresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99099&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e51066c9-6db8-4d85-82c0-3e4dddbeffbd\', \'multiverseId\': 99099}, \'multiverseid\': 99099}, {\'name\': \'絡み花\', \'text\': \'{1}, {T}：１点のライフを得る。\', \'type\': \'アーティファクト\', \'flavor\': \'その花は実を結ばない。 森の住人たちに栄養を与えるために咲くのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99459&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a735e79-9fb8-4ed4-a5e6-dcf4ce24363b\', \'multiverseId\': 99459}, \'multiverseid\': 99459}, {\'name\': \'Emaranhadina\', \'text\': \'{1}, {T}: Você ganha 1 ponto de vida.\', \'type\': \'Artefato\', \'flavor\': \'A flor não contém sementes. Ela serve apenas para alimentar os habitantes da floresta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99819&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d47a09a6-c24c-49a0-9398-0f601ff69966\', \'multiverseId\': 99819}, \'multiverseid\': 99819}, {\'name\': \'Цветок зарослей\', \'text\': \'{1}, {T}: Вы получаете 1 пункт жизни.\', \'type\': \'Артефакт\', \'flavor\': \'Цветок этот не даст семян. Он нужен только для того, чтобы прокормить лесных жителей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110090&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'60099b04-3a7a-46b8-8794-e48a7487c3d4\', \'multiverseId\': 110090}, \'multiverseid\': 110090}, {\'name\': \'铬铜花\', \'text\': \'{1}，{T}：你获得1点生命。\', \'type\': \'神器\', \'flavor\': \'此花长不出种子， 纯粹是为了滋养树林居民而生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98019&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'353b6d49-3931-4ed9-9521-1c2fdc50f946\', \'multiverseId\': 98019}, \'multiverseid\': 98019}]', "[{'name': 'Kochendes Meer', 'text': 'Zerstöre alle Inseln.', 'type': 'Hexerei', 'flavor': 'Was das Land verbrennt, bringt das Meer zum Brodeln.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98471&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cdc6f97f-23e8-4bad-892b-38baa4a4a885', 'multiverseId': 98471}, 'multiverseid': 98471}, {'name': 'Mares hirvientes', 'text': 'Destruye todas las islas.', 'type': 'Conjuro', 'flavor': 'Lo que quema la tierra, hace hervir los mares.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99911&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8c8c68e1-5f24-4b9a-83ad-8cd090a078a4', 'multiverseId': 99911}, 'multiverseid': 99911}, {'name': 'Mers bouillonnantes', 'text': 'Détruisez toutes les îles.', 'type': 'Rituel', 'flavor': 'Ce qui brûle la terre fait bouillir les mers.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98111&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd8d9b883-ef91-4826-bc31-0c11e4573522', 'multiverseId': 98111}, 'multiverseid': 98111}, {'name': 'Mari Ribollenti', 'text': 'Distruggi tutte le Isole.', 'type': 'Stregoneria', 'flavor': 'Ciò che arde la terra fa ribollire i mari.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98831&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4bda8783-0cf9-446c-8a84-04e9cfbaea94', 'multiverseId': 98831}, 'multiverseid': 98831}, {'name': '沸き立つ海', 'text': 'すべての島を破壊する。', 'type': 'ソーサリー', 'flavor': '大地を焼くものは、海も沸騰させる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99191&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3489a537-835d-4c4c-af80-4a81261fdae5', 'multiverseId': 99191}, 'multiverseid': 99191}, {'name': 'Mares Fervilhantes', 'text': 'Destrói todas as Ilhas.', 'type': 'Feitiço', 'flavor': 'O que queima a terra, ferve os mares.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99551&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '47d3b1ac-ed5e-42e6-a8e2-ad2b2d5be909', 'multiverseId': 99551}, 'multiverseid': 99551}, {'name': 'Кипящее море', 'text': 'Уничтожить все Острова.', 'type': 'Волшебство', 'flavor': 'Земля горит, воды в морях кипят.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109822&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'dc0379a7-c841-4393-b136-5b5322a6c400', 'multiverseId': 109822}, 'multiverseid': 109822}, {'name': '沸腾之海', 'text': '消灭所有海岛。', 'type': '法术', 'flavor': '燃烧大地之物亦能使大海沸腾。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97751&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e9fae5b2-4978-4d71-b8e9-cc75d50ca225', 'multiverseId': 97751}, 'multiverseid': 97751}]", '[{\'name\': \'Kriegerehre\', \'text\': \'Kreaturen, die du kontrollierst, erhalten +1/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Niemand wurde jemals dafür geehrt, was er erhalten hat. Ehre ist die Belohnung für das, was man gegeben hat."Calvin Coolidge\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98777&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad72b2e3-b573-4db9-88d9-811f3cc2b1d2\', \'multiverseId\': 98777}, \'multiverseid\': 98777}, {\'name\': \'Honor de guerrero\', \'text\': \'Las criaturas que controles obtienen +1/+1 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Ninguna persona fue honrada por lo que él recibió. El honor fue la recompensa por lo que él dio."Calvin Coolidge\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100217&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'974c7ca3-e545-4efa-b1a4-23c6c6b72034\', \'multiverseId\': 100217}, \'multiverseid\': 100217}, {\'name\': \'Honneur du guerrier\', \'text\': "Les créatures que vous contrôlez gagnent +1/+1 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "« L\'honneur perdu ne se retrouve plus. »Proverbe français", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98417&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4dbf5ad5-d8a0-4d2e-a7dd-cbc14e3a8fe0\', \'multiverseId\': 98417}, \'multiverseid\': 98417}, {\'name\': \'Onore del Guerriero\', \'text\': \'Le creature che controlli prendono +1/+1 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Nessuno è mai stato onorato per ciò che ha ricevuto. L\\\'onore è una ricompensa per ciò che si è dato."Calvin Coolidge\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99137&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cdef8a1a-fc87-47d0-bb14-5c2802164b76\', \'multiverseId\': 99137}, \'multiverseid\': 99137}, {\'name\': \'戦士の誉れ\', \'text\': \'あなたがコントロールするクリーチャーは、ターン終了時まで+1/+1の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'受けた物によって名誉を得た者はいない。 名誉は与えた物によって得る物なのだ。――カルヴィン・クーリッジ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99497&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2480d90a-26bb-443d-a7d9-8183c1386cf0\', \'multiverseId\': 99497}, \'multiverseid\': 99497}, {\'name\': \'Honra de Guerreiro\', \'text\': \'As criaturas que você controla recebem +1/+1 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Nunca nenhuma pessoa foi honrada pelo que ele recebeu. A honra foi a recompensa pelo que ele deu." Calvin Coolidge\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99857&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'372c7abe-8115-47fa-914f-71d769cda72c\', \'multiverseId\': 99857}, \'multiverseid\': 99857}, {\'name\': \'Честь воина\', \'text\': \'Существа, которых вы контролируете, получают +1/+1 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Ни один человек еще не прославился за то, что он получил. Слава это награда за то, что человек отдает". — Кельвин Кулидж\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110128&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c44824e-826f-489d-97ed-54c03256c1f2\', \'multiverseId\': 110128}, \'multiverseid\': 110128}, {\'name\': \'战士之光\', \'text\': \'由你操控的生物得+1/+1直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「没人是因为得到了什么而受尊敬。尊敬是因其付出而获得的回报。」 ～凯文‧科立芝\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98057&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'488228c7-d9e0-4ea2-8c12-1a27fce92b23\', \'multiverseId\': 98057}, \'multiverseid\': 98057}]', '[{\'name\': \'Königsgepard\', \'text\': \'Du kannst den Königsgepard zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.\', \'type\': \'Kreatur — Katze\', \'flavor\': "Werden dein Freund und du von einem Königsgepard gejagt, hast du nur eine Chance: Bring deinen Freund ins Stolpern. —Weisheit der Suq\'Ata", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98596&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9350015c-d8b8-4ae0-92ab-ce5fc1ec4287\', \'multiverseId\': 98596}, \'multiverseid\': 98596}, {\'name\': \'Rey guepardo\', \'text\': \'Puedes jugar el Rey guepardo en cualquier momento en que pudieras jugar un instantáneo.\', \'type\': \'Criatura — Felino\', \'flavor\': "Si te encuentras en la situación de estar con un amigo siendo perseguidos por un rey guepardo, tienes una única oportunidad: haz tropezar a tu amigo. —Sabiduría Suq\'Ata", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100036&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c110c928-32f2-48bb-9b9e-0cd49a1d0525\', \'multiverseId\': 100036}, \'multiverseid\': 100036}, {\'name\': \'Guépard royal\', \'text\': \'Vous pouvez jouer le Guépard royal à tout moment où vous pourriez jouer un éphémère.\', \'type\': \'Créature : chat\', \'flavor\': "Si toi et ton ami êtes poursuivis par un guépard royal, tu n\'as qu\'une chance de survie : faire trébucher ton ami. —Proverbe souk\'ata", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98236&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f385d783-eb63-4ec7-bdf0-41bbdca02cd2\', \'multiverseId\': 98236}, \'multiverseid\': 98236}, {\'name\': \'Ghepardo Reale\', \'text\': \'Puoi giocare il Ghepardo Reale in qualsiasi momento in cui potresti giocare un istantaneo.\', \'type\': \'Creatura — Felino\', \'flavor\': "Se tu e un amico siete inseguiti da un ghepardo reale, hai una sola possibilità: fare lo sgambetto al tuo amico. —Saggezza di Suq\'Ata", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98956&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9d5273a-c213-4e9a-a191-1e927db6b904\', \'multiverseId\': 98956}, \'multiverseid\': 98956}, {\'name\': \'キング・チータ\', \'text\': \'あなたはキング・チータを、あなたがインスタントをプレイできるときならいつでもプレイしてよい。\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'友達と二人のときに、キング・チータに追いかけられるはめになったら、生き延びる道は一つしかない。友達をつまずかせるのだ。 ――スークアタの知恵\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99316&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87552d66-c7e1-4af1-961b-c1b2a4181beb\', \'multiverseId\': 99316}, \'multiverseid\': 99316}, {\'name\': \'Guepardo Rei\', \'text\': \'Você pode jogar Guepardo Rei a qualquer momento em que puder jogar uma mágica instantânea.\', \'type\': \'Criatura — Felino\', \'flavor\': "Se você e um amigo estiverem sendo caçados por um guepardo rei, você só tem uma alternativa: Passe uma rasteira em seu amigo. — Sabedoria de Suq\'Ata", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99676&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a71d51e6-2734-43c9-899e-5583b893062b\', \'multiverseId\': 99676}, \'multiverseid\': 99676}, {\'name\': \'Король гепардов\', \'text\': \'Вы можете разыграть Короля гепардов тогда же, когда вы можете разыграть мгновенное заклинание.\', \'type\': \'Существо — Кошка\', \'flavor\': \'Если за тобой и твоим другом охотится король гепардов, есть один шанс спастись подставить ножку другу. — Мудрость Сукуота\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109947&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'df4e3e0b-2644-4f4c-8c6d-89f30e5d073b\', \'multiverseId\': 109947}, \'multiverseid\': 109947}, {\'name\': \'帝王猎豹\', \'text\': \'你可以于你能够使用瞬间的时机下，使用帝王猎豹。\', \'type\': \'生物～猫\', \'flavor\': \'当你和朋友同时被帝王猎豹追逐，你活下来的唯一机会是：把朋友绊倒。 ～舒夸塔哲语\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97876&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac5a6368-fe9a-40d5-854b-7b159ba97077\', \'multiverseId\': 97876}, \'multiverseid\': 97876}]', '[{\'name\': \'Landbewahrer\', \'text\': \'{1}{G}: Bringe ein Standardland deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'„Soldaten reden immer davon, den Heimatboden zu verteidigen, aber sie meinen damit ihr Volk. Mich interessieren Völker nicht, sondern wirklich nur die Erde."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98566&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ca50d89f-f25e-441f-8c9e-f860ea22ccc9\', \'multiverseId\': 98566}, \'multiverseid\': 98566}, {\'name\': \'Cuidador de cementerio\', \'text\': \'{1}{G}: Regresa la carta de tierra básica de tu cementerio a tu mano.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'"Los soldados hablan de defender la tierra, pero sólo les importan sus naciones. A mí no me importan las naciones, pero mucho la tierra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100006&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e778b7a-5491-437b-9552-46c089f27ead\', \'multiverseId\': 100006}, \'multiverseid\': 100006}, {\'name\': \'Gardien des terres\', \'text\': \'{1}{G} : Renvoyez la carte de terrain de base ciblée depuis votre cimetière dans votre main.\', \'type\': \'Créature : humain et druide\', \'flavor\': "« Les soldats parlent de défendre la terre, mais ils ne s\'intéressent qu\'à leur nation. Je me moque des nations et je défends vraiment la terre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98206&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'94d4640a-15d0-4946-95f1-40cbe8779367\', \'multiverseId\': 98206}, \'multiverseid\': 98206}, {\'name\': \'Guardiano del Suolo\', \'text\': \'{1}{G}: Riprendi in mano una carta terra base bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': \'"I soldati parlano di difesa del territorio, ma in realtà pensano solo alla propria patria. A me non importa niente delle loro patrie: per me conta soltanto il territorio."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98926&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6aa20082-bfab-4a7a-9c1e-d717152d507b\', \'multiverseId\': 98926}, \'multiverseid\': 98926}, {\'name\': \'土地守\', \'text\': \'{1}{G}：あなたの墓地にある基本土地カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'兵士はこの地を守ると言うが、真に守るは国のみ。 私には国は何ものでもなく、真に守るはこの地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99286&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f213b911-9679-48eb-8b86-92238834b4c6\', \'multiverseId\': 99286}, \'multiverseid\': 99286}, {\'name\': \'Mateiro\', \'text\': \'{1}{G}: Devolve o card alvo de terreno básico de seu cemitério para a sua mão.\', \'type\': \'Criatura — Druida Humano\', \'flavor\': \'"Os soldados falam sobre defender o solo, mas eles se importam apenas com suas nações. Não me importo nem um pouco com suas nações, mas me importo muito com o solo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99646&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'da99f218-c421-48f0-bf40-78fd376e8c8a\', \'multiverseId\': 99646}, \'multiverseid\': 99646}, {\'name\': \'Хранитель земель\', \'text\': \'{1}{G}: Верните целевую базовую землю с кладбища в руку.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'"Солдаты говорят о том, что они защищают свою землю, хотя их волнуют только люди, которые живут на этой земле. Мне нет дела до людей, мне важна только земля".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109917&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'061e8acb-9028-44ee-acbd-099e508cb07d\', \'multiverseId\': 109917}, \'multiverseid\': 109917}, {\'name\': \'家园守卫\', \'text\': \'{1}{G}：将目标基本地牌从你的坟墓场移回你手上。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'「军士虽口口声声要保卫国土，心中却只悬念着他们的国家。 我愿全心照护这片家园，对他们的国家可一点兴趣也没有。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97846&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'458c3820-c83b-41b9-92d0-1069117d2e37\', \'multiverseId\': 97846}, \'multiverseid\': 97846}]', '[{\'name\': \'Landschenkung\', \'text\': \'Hat ein Gegner mehr Länder als du, durchsuche deine Bibliothek nach bis zu drei Ebenen, zeige sie offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98550&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e641608-912e-42db-b5a5-b32c9ea2cbd2\', \'multiverseId\': 98550}, \'multiverseid\': 98550}, {\'name\': \'Regalo de fincas\', \'text\': \'Si un oponente tiene más tierras que tú, busca en tu biblioteca hasta tres cartas de llanura, muéstralas y ponlas en tu mano. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99990&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b3adf36b-ec3c-4511-b609-1331a5ccc34c\', \'multiverseId\': 99990}, \'multiverseid\': 99990}, {\'name\': \'Don de domaines\', \'text\': "Si un adversaire a plus de terrains que vous, cherchez dans votre bibliothèque jusqu\'à trois cartes de plaine, révélez-les et mettez-les dans votre main. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98190&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a16557ca-caa8-426a-a3ea-9b0e2a4382a9\', \'multiverseId\': 98190}, \'multiverseid\': 98190}, {\'name\': "Dono dell\'Estate", \'text\': \'Se un avversario ha più terre di te, passa in rassegna il tuo grimorio, scegli fino a tre carte Pianura, rivelale e aggiungile alla tua mano. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98910&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'668b2a44-5bf7-48a4-847b-e44dd0c87d84\', \'multiverseId\': 98910}, \'multiverseid\': 98910}, {\'name\': \'土地の寄進\', \'text\': \'いずれかの対戦相手があなたより多くの土地をコントロールしている場合、あなたのライブラリーから平地カードを最大３枚まで探し、それらを公開してあなたの手札に加えてもよい。 その後、あなたのライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99270&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8724fe99-78c9-4b7a-818f-1e2558e16f55\', \'multiverseId\': 99270}, \'multiverseid\': 99270}, {\'name\': \'Presente de Propriedades\', \'text\': \'Se um oponente tem mais terrenos que você, procure em seu grimório por até três cards de Planície, revele-os, e coloque-os em sua mão. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99630&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db966050-cb3c-4da8-ab28-2f4c1aa7debe\', \'multiverseId\': 99630}, \'multiverseid\': 99630}, {\'name\': \'Дарованные земли\', \'text\': \'Если у вашего оппонента больше земель, чем у вас, выберите из библиотеки три карты Равнин, откройте их и поместите в руку. Затем перетасуйте библиотеку.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109901&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e72f53ad-28bb-4c3f-86d2-539783cdc044\', \'multiverseId\': 109901}, \'multiverseid\': 109901}, {\'name\': \'献地\', \'text\': \'若任一对手的地比你多，则从你的牌库中搜寻至多三张平原牌，展示该些牌，并置于你手上， 然后将你的牌库洗牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97830&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79c355ad-236e-4b83-8866-89f659570850\', \'multiverseId\': 97830}, \'multiverseid\': 97830}]', '[{\'name\': \'Lasttier\', \'text\': \'Stärke und Widerstandskraft des Lasttiers sind gleich der Anzahl an Kreaturen im Spiel.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Obwohl es für zivile Zwecke konstruiert worden war, dauerte es nicht lange, bis es auch im Krieg eingesetzt wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98459&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c284a97-9e15-413f-90fc-1b9e7ddc2f70\', \'multiverseId\': 98459}, \'multiverseid\': 98459}, {\'name\': \'Bestia de carga\', \'text\': \'Tanto la fuerza como la resistencia de la Bestia de carga son iguales al número de criaturas que haya en juego.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Aunque fue construida como un instrumento de trabajo, no pasó mucho hasta que se convirtiera en un instrumento de guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99899&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'212846f4-b022-4cb9-86e6-21b46d0670e1\', \'multiverseId\': 99899}, \'multiverseid\': 99899}, {\'name\': \'Bête de somme\', \'text\': \'La Bête de somme a une force et une endurance chacune égale au nombre de créatures en jeu.\', \'type\': \'Créature-artefact : golem\', \'flavor\': "Bien qu\'elle fût construite pour le labeur, elle devint rapidement un instrument de guerre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98099&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'53666180-754f-4f2c-b9b6-976d856aa549\', \'multiverseId\': 98099}, \'multiverseid\': 98099}, {\'name\': \'Bestia da Soma\', \'text\': \'La forza e la costituzione della Bestia da Soma sono pari ciascuna al numero di creature in gioco.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'Venne realizzata come strumento di lavoro, ma in poco tempo fu trasformata in uno strumento di guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98819&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53928eac-c957-4df7-85cd-63cb2bc9b222\', \'multiverseId\': 98819}, \'multiverseid\': 98819}, {\'name\': \'役畜\', \'text\': \'役畜のパワーとタフネスは、それぞれ場に出ているクリーチャーの総数に等しい。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'それは労働の道具として作られたが、戦争の道具となるまでは長くはかからなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99179&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5771a85e-1b9a-4159-844e-53d743957a9a\', \'multiverseId\': 99179}, \'multiverseid\': 99179}, {\'name\': \'Besta de Carga\', \'text\': \'O poder e a resistência de Besta de Carga são ambos iguais ao número de criaturas em jogo.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Mesmo tendo sido construído como um instrumento de trabalho, não tardou para que se tornasse um instrumento de guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99539&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ba2a977-bb05-4523-9cd2-291d0f5e0a14\', \'multiverseId\': 99539}, \'multiverseid\': 99539}, {\'name\': \'Обремененное создание\', \'text\': \'Сила и здоровье Обремененного создания равняются числу существ в игре.\', \'type\': \'Артефактное существо — Голем\', \'flavor\': \'Созданный для мирного труда, очень скоро он превратился в орудие убийства.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109810&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6ea1780a-1953-4e1b-87fb-da428d02ba7a\', \'multiverseId\': 109810}, \'multiverseid\': 109810}, {\'name\': \'重驮兽\', \'text\': \'重驮兽的力量和防御力各等同于场上生物的数量。\', \'type\': \'神器生物～魔像\', \'flavor\': \'虽然原本的用途是劳动工具，却很快地被当成战争工具。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97739&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c1b35da-04b6-4e95-997f-14746617a873\', \'multiverseId\': 97739}, \'multiverseid\': 97739}]', '[{\'name\': \'Lavaaxt\', \'text\': \'Lavaaxt fügt einem Spieler deiner Wahl 5 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Fang"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98599&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5775b01-bfeb-4fa7-9262-afc625a6bb41\', \'multiverseId\': 98599}, \'multiverseid\': 98599}, {\'name\': \'Hacha de lava\', \'text\': \'El Hacha de lava hace 5 puntos de daño al jugador objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"¡Atrapa"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100039&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1abdf681-c4a9-4105-a41d-6ac3f00e481d\', \'multiverseId\': 100039}, \'multiverseid\': 100039}, {\'name\': \'Hache de lave\', \'text\': \'La Hache de lave inflige 5 blessures au joueur ciblé.\', \'type\': \'Rituel\', \'flavor\': \'« Attrape ça »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98239&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78d50fcb-aab0-4b12-997e-2099efcb8597\', \'multiverseId\': 98239}, \'multiverseid\': 98239}, {\'name\': \'Ascia di Lava\', \'text\': "L\'Ascia di Lava infligge 5 danni a un giocatore bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'"Lascia"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98959&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a431230-009b-4c9a-85ba-eea06cdb8c60\', \'multiverseId\': 98959}, \'multiverseid\': 98959}, {\'name\': \'溶岩の斧\', \'text\': \'プレイヤー１人を対象とする。溶岩の斧はそのプレイヤーに５点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'そらよッ！\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99319&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7e5ee3f-08be-4d8e-84a1-015a910ef72d\', \'multiverseId\': 99319}, \'multiverseid\': 99319}, {\'name\': \'Machado de Lava\', \'text\': \'Machado de Lava causa 5 pontos de dano ao jogador alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Pega aí"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99679&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f46b462c-2a6e-4cae-b9e7-768889fb5ac5\', \'multiverseId\': 99679}, \'multiverseid\': 99679}, {\'name\': \'Лавовый топор\', \'text\': \'Лавовый топор наносит 5 повреждений целевому игроку.\', \'type\': \'Волшебство\', \'flavor\': \'"Хватай"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109950&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bf0ef0ed-553b-45ae-8586-64771aea7f3f\', \'multiverseId\': 109950}, \'multiverseid\': 109950}, {\'name\': \'熔岩斧\', \'text\': \'熔岩斧对目标牌手造成5点伤害。\', \'type\': \'法术\', \'flavor\': \'「接招！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97879&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55cd66cd-ad5b-44a5-b0f0-c15109c48a92\', \'multiverseId\': 97879}, \'multiverseid\': 97879}]', "[{'name': 'Lebensquelle', 'text': 'Ein Spieler deiner Wahl erhält X Lebenspunkte dazu.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98729&type=card', 'language': 'German', 'identifiers': {'scryfallId': '850d1ff4-75f6-444f-b8f1-1d4f99e2718b', 'multiverseId': 98729}, 'multiverseid': 98729}, {'name': 'Manantial de vida', 'text': 'El jugador objetivo gana X vidas.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100169&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0d63f502-dfe5-45c3-97a1-f7f523d50b8e', 'multiverseId': 100169}, 'multiverseid': 100169}, {'name': 'Source de vie', 'text': 'Le joueur ciblé gagne X points de vie.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98369&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1a033e56-7688-4307-a177-b239c2178c37', 'multiverseId': 98369}, 'multiverseid': 98369}, {'name': 'Fonte della Vita', 'text': 'Il giocatore bersaglio guadagna X punti vita.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99089&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f4c691e6-0272-4838-b876-747bdb0b9344', 'multiverseId': 99089}, 'multiverseid': 99089}, {'name': '命の川', 'text': 'プレイヤー１人を対象とする。そのプレイヤーはＸ点のライフを得る。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99449&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '38793815-a4ff-4e04-a222-722d9f40ce1d', 'multiverseId': 99449}, 'multiverseid': 99449}, {'name': 'Fluxo de Vida', 'text': 'O jogador alvo ganha X pontos de vida.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99809&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a958af43-e420-4295-8084-504af31ff1bc', 'multiverseId': 99809}, 'multiverseid': 99809}, {'name': 'Поток жизни', 'text': 'Целевой игрок получает Х пунктов жизни.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110080&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'bf63bd96-dbfb-4270-a22b-45f98d178759', 'multiverseId': 110080}, 'multiverseid': 110080}, {'name': '生命之源', 'text': '目标牌手获得X点生命。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98009&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '168c3c16-3405-4bce-bfaf-9e8db65a563d', 'multiverseId': 98009}, 'multiverseid': 98009}]", '[{\'name\': \'Lebertran\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur hat Inseltarnung. (Diese Kreatur ist unblockbar, solange der verteidigende Spieler eine Insel kontrolliert.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98528&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'140af025-f25a-42f1-a4de-05bc5668d523\', \'multiverseId\': 98528}, \'multiverseid\': 98528}, {\'name\': \'Aceite de hígado de pescado\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada tiene la habilidad de cruzar islas. (Esta criatura es imbloqueable mientras el jugador defensor controle una isla.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99968&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04f71280-c912-4efd-8611-1a02e14fedcf\', \'multiverseId\': 99968}, \'multiverseid\': 99968}, {\'name\': \'Huile de foie de morue\', \'text\': \'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée a la traversée des îles. (Cette créature est imblocable tant que le joueur défenseur contrôle au moins une île.)\', \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98168&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f42e514e-80be-49fb-95f3-483168b42434\', \'multiverseId\': 98168}, \'multiverseid\': 98168}, {\'name\': \'Unguento di Fegato di Pesce\', \'text\': "Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata ha passa-isole. (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla almeno un\'Isola.)", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98888&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea4de22c-4915-4196-8101-0bffe6f8ff2f\', \'multiverseId\': 98888}, \'multiverseid\': 98888}, {\'name\': \'魚の肝の油\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは島渡りを持つ。 （このクリーチャーは防御プレイヤーが島をコントロールしている限りブロックされない。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99248&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24c70dac-68c1-48f2-938d-5ed4892ea5f0\', \'multiverseId\': 99248}, \'multiverseid\': 99248}, {\'name\': \'Óleo de Fígado de Peixe\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada tem travessia de ilha. (Esta criatura não pode ser bloqueada desde que o jogador defensor controle uma Ilha.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99608&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'beba7fe5-9812-47e0-8458-377841a812f9\', \'multiverseId\': 99608}, \'multiverseid\': 99608}, {\'name\': \'Рыбий жир\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает знание островов. (Это существо невозможно заблокировать, пока обороняющийся игрок контролирует Остров).\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109879&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e199b44a-e16b-42ea-b049-554f842770d6\', \'multiverseId\': 109879}, \'multiverseid\': 109879}, {\'name\': \'鱼肝油\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物具有海岛行者异能。 （只要防御牌手操控海岛，此生物就不能被阻挡）\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97808&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1c4e903-8f92-4f8b-a806-ef226b95b97a\', \'multiverseId\': 97808}, \'multiverseid\': 97808}]', "[{'name': 'Leoniden-Himmeljäger', 'text': 'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)', 'type': 'Kreatur — Katze, Ritter', 'flavor': 'Die Himmeljäger entstanden, als die ersten Leoniden in die Lüfte schauten und wünschten, sie könnten die Vögel über ihnen jagen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98600&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e97a7da5-99a8-4974-93e6-01d365ff9876', 'multiverseId': 98600}, 'multiverseid': 98600}, {'name': 'Cazacielos leonina', 'text': 'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)', 'type': 'Criatura — Caballero felino', 'flavor': 'Los cazacielos leoninos nacieron cuando el primer leonino miró fijamente a los cielos y deseó cazar las aves.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100040&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '03bcfe22-e9f7-48d7-8a5c-da83b8653372', 'multiverseId': 100040}, 'multiverseid': 100040}, {'name': 'Chasseciel léonin', 'text': 'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)', 'type': 'Créature : chat et chevalier', 'flavor': 'Les chasseciels naquirent quand le premier léonin contempla le ciel et souhaita chasser les oiseaux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98240&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e37899bf-c390-475f-8925-7a4fda71ac17', 'multiverseId': 98240}, 'multiverseid': 98240}, {'name': 'Solcacielo Leonid', 'text': 'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)', 'type': 'Creatura — Cavaliere Felino', 'flavor': 'I solcacielo sono nati quando il primo leonid levò gli occhi al cielo e desiderò dare la caccia agli uccelli che lo sorvolavano.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98960&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '227b6853-3053-4b84-8c75-f4f9cf4ed29c', 'multiverseId': 98960}, 'multiverseid': 98960}, {'name': 'レオニンの空狩人', 'text': '飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）', 'type': 'クリーチャー — 猫・騎士', 'flavor': '最初のレオニンが空を見つめ、頭上を舞う鳥を狩ることを願ったとき、そこに空狩人が生まれた。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99320&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'af2fa2dc-c56f-4a88-bf41-b8f7c3034279', 'multiverseId': 99320}, 'multiverseid': 99320}, {'name': 'Caçadora Celeste Leonina', 'text': 'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)', 'type': 'Criatura — Cavaleiro Felino', 'flavor': 'As caçadoras celestes nasceram quando a primeira leonina olhou para os céus e desejou caçar os pássaros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99680&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '47ec3756-3075-448f-8714-9f0d2d836c39', 'multiverseId': 99680}, 'multiverseid': 99680}, {'name': 'Леонийский небесный охотник', 'text': 'Полет (Это существо может быть блокировано только существом со способностью полета).', 'type': 'Существо — Кошка Рыцарь', 'flavor': 'Небесные охотники появились тогда, когда первый леониец, глядя в небо, мечтал там, высоко, охотиться на птиц.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109951&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5e7a8d3f-8cf7-4c44-9b9c-0e6ba4d838ac', 'multiverseId': 109951}, 'multiverseid': 109951}, {'name': '狮族空猎者', 'text': '飞行（只有具飞行异能的生物才能阻挡它。）', 'type': '生物～猫／骑士', 'flavor': '曾有个狮族仰望天空，想要猎捕头顶上的飞鸟；空猎者就此诞生。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97880&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd42dee6d-4193-4bb9-9514-dd57415e184d', 'multiverseId': 97880}, 'multiverseid': 97880}]", '[{\'name\': \'Letzte Bestrafung\', \'text\': \'Ein Spieler deiner Wahl verliert so viele Lebenspunkte, wie ihm in diesem Zug bereits Schaden zugefügt wurde.\', \'type\': \'Hexerei\', \'flavor\': \'Die Schmerzen eines ganzen Lebens jede Schramme, jede Krankheit, jede Verletzung verdichtet in einen einzigen Moment.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98526&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c218494e-8bf3-4640-be63-f8c475d2cb90\', \'multiverseId\': 98526}, \'multiverseid\': 98526}, {\'name\': \'Castigo final\', \'text\': \'El jugador objetivo pierde una cantidad de vida igual al daño que ya haya recibido este turno.\', \'type\': \'Conjuro\', \'flavor\': \'El dolor de una vida -cada raspón, enfermedad y moretón- condensado en un solo momento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99966&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88d970e9-6103-4749-898c-ed18af5d79c4\', \'multiverseId\': 99966}, \'multiverseid\': 99966}, {\'name\': \'Punition finale\', \'text\': "Le joueur ciblé perd un nombre de points de vie égal au nombre de blessures qu\'il a déjà subi pendant ce tour.", \'type\': \'Rituel\', \'flavor\': \'Vivre en un seul instant toutes les souffrances de toute une vie — la moindre égratignure, la moindre maladie, le moindre mal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98166&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0d97648-a4f9-4699-815b-35213b3652f4\', \'multiverseId\': 98166}, \'multiverseid\': 98166}, {\'name\': \'Punizione Definitiva\', \'text\': \'Il giocatore bersaglio perde un ammontare di punti vita pari ai danni che gli sono già stati inflitti in questo turno.\', \'type\': \'Stregoneria\', \'flavor\': "Il dolore di un\'intera vita ogni graffio, malattia e ferita condensato in un singolo istante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98886&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0eaf2e71-221a-4bf6-bb4c-f39828a7d485\', \'multiverseId\': 98886}, \'multiverseid\': 98886}, {\'name\': \'最後の罰\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、このターンそのプレイヤーに与えられたダメージに等しい値のライフを失う。\', \'type\': \'ソーサリー\', \'flavor\': \'一瞬に濃縮された、かすり傷、病苦、打撲――一生分の苦痛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99246&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f448480b-8ea3-4c1f-915b-a2e03d3f24f0\', \'multiverseId\': 99246}, \'multiverseid\': 99246}, {\'name\': \'Punição Final\', \'text\': \'O jogador alvo perde uma quantidade de pontos de vida igual ao dano já causado a ele próprio neste turno.\', \'type\': \'Feitiço\', \'flavor\': \'A dor de uma vida cada arranhão, doença e machucado condensada num único momento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99606&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'755349fd-fcf3-4bf8-8d63-d0b8c0c8ce97\', \'multiverseId\': 99606}, \'multiverseid\': 99606}, {\'name\': \'Последнее наказание\', \'text\': \'Целевой игрок теряет столько пунктов жизни, сколько повреждений ему уже было нанесено во время этого хода.\', \'type\': \'Волшебство\', \'flavor\': \'Неприятности всей жизни все передряги, болезни, оскорбления уместились в одно единственное мгновение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109877&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6daf1f3e-f869-431e-8504-6d20c4b99427\', \'multiverseId\': 109877}, \'multiverseid\': 109877}, {\'name\': \'终极刑罚\', \'text\': \'目标牌手失去生命，其数量等同于他本回合已受的伤害。\', \'type\': \'法术\', \'flavor\': \'一生中的痛苦～每次刮伤，病痛，挫伤～浓缩于一刻。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97806&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fbc233f-5b9c-4f1d-aba0-0847a27f7695\', \'multiverseId\': 97806}, \'multiverseid\': 97806}]', '[{\'name\': \'Levitation\', \'text\': \'Alle Kreaturen, die du kontrollierst, erhalten Flugfähigkeit. (Sie können nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Verzauberung\', \'flavor\': \'Barrins Stolz auf seinen Lehrling wurde ein wenig getrübt, als er die anderen wieder herunterholen musste.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'482d0ee4-5bb7-4920-8956-d7aaeffc7f30\', \'multiverseId\': 98601}, \'multiverseid\': 98601}, {\'name\': \'Levitación\', \'text\': \'Las criaturas que controles tienen la habilidad de volar. (No pueden ser bloqueadas excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Encantamiento\', \'flavor\': \'El orgullo que sentía Barrin por su aprendiz disminuía un poco cuando tenía que hacer descender a los otros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100041&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52a7b656-ac20-4872-83f4-c16f09393421\', \'multiverseId\': 100041}, \'multiverseid\': 100041}, {\'name\': \'Lévitation\', \'text\': \'Les créatures que vous contrôlez ont le vol. (Elles ne peuvent être bloquées que par des créatures avec le vol.)\', \'type\': \'Enchantement\', \'flavor\': \'Barrin se sentit moins fier de son apprenti quand il dut faire descendre tout le monde au sol.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98241&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd9adbff-4501-4def-808b-32bb851a1199\', \'multiverseId\': 98241}, \'multiverseid\': 98241}, {\'name\': \'Levitazione\', \'text\': \'Le creature che controlli hanno volare. (Non possono essere bloccate tranne che da creature con volare.)\', \'type\': \'Incantesimo\', \'flavor\': "L\'orgoglio di Barrin per il proprio apprendista subì un duro colpo quando dovette far ridiscendere gli altri.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98961&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'44e2366c-47dc-4e56-8fb5-4d47f1c7aaab\', \'multiverseId\': 98961}, \'multiverseid\': 98961}, {\'name\': \'空中浮遊\', \'text\': \'あなたがコントロールするクリーチャーは飛行を持つ。 （それらは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'エンチャント\', \'flavor\': \'バリンが自分の弟子に持っていた誇りは、他の物を自分の手で降ろす羽目になったことでしぼんでしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99321&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'752d86c7-6714-4f3c-a2da-7bf0a0956c92\', \'multiverseId\': 99321}, \'multiverseid\': 99321}, {\'name\': \'Levitação\', \'text\': \'As criaturas que você controla têm a habilidade de voar. (Elas só podem ser bloqueadas por criaturas com a habilidade de voar.)\', \'type\': \'Encantamento\', \'flavor\': \'O orgulho que Barrin sentia de seu aprendiz diminuiu um pouco quando ele teve de trazer os outros de volta ao chão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99681&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d42e1a12-8ac5-497d-b9ec-05822c056303\', \'multiverseId\': 99681}, \'multiverseid\': 99681}, {\'name\': \'Левитация\', \'text\': \'Существа, которых вы контролируете, получают способность полета. (Они могут быть заблокированы только существом со способностью полета).\', \'type\': \'Чары\', \'flavor\': \'Баррин гордился своим учеником, правда, был несколько недоволен тем, что остальных ему пришлось возвращать на землю.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109952&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9436e6fc-bd04-4f5c-a537-bff455281558\', \'multiverseId\': 109952}, \'multiverseid\': 109952}, {\'name\': \'飘浮\', \'text\': \'由你操控的生物具有飞行异能。 （只有具飞行异能的生物才能阻挡它们。）\', \'type\': \'结界\', \'flavor\': \'当巴林发现原来他必须帮许多学生回到地面时，以他们为傲的感觉便已不再。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97881&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d40b0409-21af-489a-a9a5-e816deaf7bc0\', \'multiverseId\': 97881}, \'multiverseid\': 97881}]', '[{\'name\': \'Leydruide\', \'text\': \'{T}: Enttappe ein Land deiner Wahl.\', \'type\': \'Kreatur — Mensch, Druide\', \'flavor\': \'Nach Jahren der Übung wird der Druide eins mit der Natur: Er bezieht Macht aus dem Land und gibt sie zurück, sobald sie gebraucht wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98602&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0530dfe7-6b45-433d-a697-93524944fa60\', \'multiverseId\': 98602}, \'multiverseid\': 98602}, {\'name\': \'Druida de Lei\', \'text\': \'{T}: Endereza la tierra objetivo.\', \'type\': \'Criatura — Druida humano\', \'flavor\': \'Luego de años de entrenamiento, el druida se convierte en uno con la naturaleza, extrayendo poder de la tierra y regresándolo cuando es necesario.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100042&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a099976-171a-4789-8a81-e900f1eef00f\', \'multiverseId\': 100042}, \'multiverseid\': 100042}, {\'name\': \'Druide des leys\', \'text\': \'{T} : Dégagez un terrain ciblé.\', \'type\': \'Créature : humain et druide\', \'flavor\': "Au bout d\'années d\'entraînement, le druide ne fait plus qu\'un avec la nature. Il puise l\'énergie de la terre et la rend quand c\'est nécessaire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98242&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a88d6926-4a39-4b2e-b819-f408000bc0e8\', \'multiverseId\': 98242}, \'multiverseid\': 98242}, {\'name\': \'Druido della Forza\', \'text\': \'{T}: STAPpa una terra bersaglio.\', \'type\': \'Creatura — Druido Umano\', \'flavor\': "Dopo anni di addestramento, il druido diviene un tutt\'uno con la natura, attingendo potere dalla terra e restituendolo quando è necessario.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98962&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03858bf9-489d-46a1-9375-f5e71c481536\', \'multiverseId\': 98962}, \'multiverseid\': 98962}, {\'name\': \'草原のドルイド僧\', \'text\': \'{T}：土地１つを対象とし、それをアンタップする。\', \'type\': \'クリーチャー — 人間・ドルイド\', \'flavor\': \'長年の修行の末、ドルイド僧は自然とひとつになる。彼らは必要に応じて大地より力を引き出し、また戻す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99322&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9d35764-5e0e-4430-85a1-6c0a62354840\', \'multiverseId\': 99322}, \'multiverseid\': 99322}, {\'name\': \'Druida da Pradaria\', \'text\': \'{T}: Desvira o terreno alvo.\', \'type\': \'Criatura — Druida Humano\', \'flavor\': \'Depois de anos de aprendizagem, o druida une-se à natureza, retirando energia da terra e devolvendo-a quando necessário.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99682&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5e6add2-a809-41f9-92d3-e2755614ba8e\', \'multiverseId\': 99682}, \'multiverseid\': 99682}, {\'name\': \'Друид с пастбищ\', \'text\': \'{T}: Разверните целевую землю.\', \'type\': \'Существо — Человек Друид\', \'flavor\': \'После нескольких лет тренировки друид становится частью природы, он берет силы от земли и возвращает их, если нужно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109953&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f931fd68-9775-47dc-86f0-10ac2df11a64\', \'multiverseId\': 109953}, \'multiverseid\': 109953}, {\'name\': \'莱德鲁伊特\', \'text\': \'{T}：重置目标地。\', \'type\': \'生物～人类／德鲁伊\', \'flavor\': \'历经多年的训练，德鲁伊已与大自然合一，可从土地汲取能量，并在必要时归还之。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97882&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c47785d6-74f3-496c-9ef0-4359eebf9641\', \'multiverseId\': 97882}, \'multiverseid\': 97882}]', '[{\'name\': \'Lied des Brodelns\', \'text\': \'Erhöhe deinen Manavorrat um {R}{R}{R}{R}{R}.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das reinste Erz wird im heißesten Schmelzofen erzeugt, und der hellste Blitz entstammt dem dunkelsten Sturm." —Charles Colton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98703&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e9ac49a-1273-41fc-88c4-8e6de5ea27a0\', \'multiverseId\': 98703}, \'multiverseid\': 98703}, {\'name\': \'Canción hirviente\', \'text\': \'Agrega {R}{R}{R}{R}{R} a tu reserva de maná.\', \'type\': \'Instantáneo\', \'flavor\': \'"El metal más puro se produce en la fragua más caliente, y el relámpago más brillante en la tormenta más oscura." —Charles Colton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100143&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73d305b1-a179-41ca-bbb8-d4656e5bf079\', \'multiverseId\': 100143}, \'multiverseid\': 100143}, {\'name\': \'Chant bouillonnant\', \'text\': \'Ajoutez {R}{R}{R}{R}{R} à votre réserve.\', \'type\': \'Éphémère\', \'flavor\': "« D\'une lave en fusion, d\'une pâte d\'étoile, d\'une cellule vivante germée par miracle nous sommes issus, et, peu à peu, nous nous sommes élevés jusqu\'à écrire des cantates et à peser des voies lactées. » —Antoine de Saint-Exupéry", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98343&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1167168e-0ee9-42b2-9226-500f407737ca\', \'multiverseId\': 98343}, \'multiverseid\': 98343}, {\'name\': \'Canzone Ribollente\', \'text\': \'Aggiungi {R}{R}{R}{R}{R} alla tua riserva di mana.\', \'type\': \'Istantaneo\', \'flavor\': \'"I metalli più puri sono prodotti dalla fornace più calda e i fulmini più accecanti provengono dalla tempesta più oscura." —Charles Colton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99063&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e8f4a251-6677-44cf-8b4b-f87d91b542a5\', \'multiverseId\': 99063}, \'multiverseid\': 99063}, {\'name\': \'煮えたぎる歌\', \'text\': \'あなたのマナ・プールに{R}{R}{R}{R}{R}を加える。\', \'type\': \'インスタント\', \'flavor\': \'最も熱い炉から最も清純な鋼が生まれ、最も暗い嵐から最も明るい稲妻が生まれる。 ――チャールズ・コルトン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99423&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36096ef1-c577-4191-b0b9-be9774f6ddf9\', \'multiverseId\': 99423}, \'multiverseid\': 99423}, {\'name\': \'Canção Fervilhante\', \'text\': \'Adiciona {R}{R}{R}{R}{R} à sua reserva de mana.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O minério mais puro é produzido nas fornalhas mais quentes, e o raio mais brilhante surge da mais negra tempestade." — Charles Colton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99783&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d1ac1ed-7f56-4f99-ac90-1bd17499cf76\', \'multiverseId\': 99783}, \'multiverseid\': 99783}, {\'name\': \'Песнь кипения\', \'text\': \'Добавьте {R}{R}{R}{R}{R} в запас маны.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Самый чистый металл рождается в самой горячей печи, а самая яркая молния в самой черной туче". — Чарльз Колтон\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110054&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d4f57b81-48a1-4221-9466-322d31572c83\', \'multiverseId\': 110054}, \'multiverseid\': 110054}, {\'name\': \'热血战歌\', \'text\': \'加{R}{R}{R}{R}{R}到你的法术力池中。\', \'type\': \'瞬间\', \'flavor\': \'「最纯的黄金出自最热的熔炉，最亮的闪电出自最毒的暴风。」 ～查理‧柯尔顿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97983&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'090d8402-36a5-4490-8f12-669cf46752d1\', \'multiverseId\': 97983}, \'multiverseid\': 97983}]', '[{\'name\': \'Listiger Wegbereiter\', \'text\': \'{T}: Eine Kreatur deiner Wahl mit Stärke 2 oder weniger kann in diesem Zug nicht geblockt werden.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Dem Wegbereiter folgen —Otarianischer Ausdruck für „schnell verschwinden"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98489&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'561ae67b-ed27-4581-9c12-90a319625652\', \'multiverseId\': 98489}, \'multiverseid\': 98489}, {\'name\': \'Mago alternativo astuto\', \'text\': \'{T}: La criatura objetivo con fuerza de 2 o menos es imbloqueable este turno.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Sigue al mago alternativo —Expresión otariana que significa "escapa rápido"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99929&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'634d5d59-eabe-44f1-a90c-22fc795574c7\', \'multiverseId\': 99929}, \'multiverseid\': 99929}, {\'name\': \'Sentemage astucieuse\', \'text\': \'{T} : La créature ciblée de force 2 ou moins est imblocable ce tour-ci.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': \'Suivre le sentemage —Expression otarianne signifiant « détaler »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98129&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b83f5a6-668e-4652-b7c1-8a4a0564cf04\', \'multiverseId\': 98129}, \'multiverseid\': 98129}, {\'name\': \'Mago dei Sentieri Astuto\', \'text\': \'{T}: La creatura bersaglio con forza pari o inferiore a 2 non può essere bloccata in questo turno.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'Segui il Mago dei Sentieri —Espressione di Otaria che significa "scappa velocemente".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98849&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f8077ee-bdb7-4174-8f27-d1a8bdbd3348\', \'multiverseId\': 98849}, \'multiverseid\': 98849}, {\'name\': \'狡猾な抜け道魔道士\', \'text\': \'{T}：パワーが２以下のクリーチャー１体を対象とする。このターン、それはブロックされない。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'抜け道魔道士に従う。 ――オタリアの言い回しで 「素早く逃げる」の意\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99209&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db34c7ba-fb39-40ad-b8c4-f24312440621\', \'multiverseId\': 99209}, \'multiverseid\': 99209}, {\'name\': \'Magi-trilhadora Ladina\', \'text\': \'{T}: A criatura alvo com poder menor ou igual a 2 não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'Siga a magi-trilhadora — Expressão Otariana que significa "fuja depressa"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99569&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'927d4670-c432-490b-835c-c48a927084fd\', \'multiverseId\': 99569}, \'multiverseid\': 99569}, {\'name\': \'Искусный проводник\', \'text\': \'{T}: Целевое существо с силой 2 или меньше в этот ход не блокируется.\', \'type\': \'Существо — Человек Мудрец\', \'flavor\': \'Уйти вслед за проводником — Отарское выражение, означающее "быстро скрыться"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109840&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'68ae6b82-5a41-43ac-ac2b-a4cbd60053e6\', \'multiverseId\': 109840}, \'multiverseid\': 109840}, {\'name\': \'狡智径法师\', \'text\': \'{T}：目标力量等于或小于2的生物本回合不能被阻挡。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'跟着径法师 ～欧塔利亚用语，意指 「迅速逃离」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97769&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e613c35d-8435-463d-a58c-c1193d97f34b\', \'multiverseId\': 97769}, \'multiverseid\': 97769}]', '[{\'name\': \'Llanowar-Behemoth\', \'text\': \'Tappe eine ungetappte Kreatur, die du kontrollierst: Der Llanowar-Behemoth erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Die meisten Leute können noch nicht einmal aus Stein oder Stahl gute Waffen herstellen. Die Elfen dagegen brauchen anscheinend nur Lehm und Ranken." —Gerrard von der Wetterlicht\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98604&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4aa2e8c5-be41-49a2-be6d-e37de724f579\', \'multiverseId\': 98604}, \'multiverseid\': 98604}, {\'name\': \'Behemot de Llanowar\', \'text\': \'Girar una criatura enderezada que controles: El Behemot de Llanowar obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"La mayoría de la gente no puede fabricar armas decentes con piedra ni con acero. Confía en que los elfos pueden hacerlo con solo lodo y lianas." —Gerrard del Vientoligero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100044&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66011602-60d3-4caa-bbc9-fa5cf464d1dd\', \'multiverseId\': 100044}, \'multiverseid\': 100044}, {\'name\': \'Béhémoth de Llanowar\', \'text\': "Engagez une créature dégagée que vous contrôlez : Le Béhémoth de Llanowar gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : élémental\', \'flavor\': "« La plupart des gens ne savent même pas fabriquer de bonnes armes avec la pierre et l\'acier — alors que les elfes en font avec de la boue et des lianes. » —Gerrard de l\'Aquilon", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98244&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b1882aa-935b-42dc-bc04-09439c49150f\', \'multiverseId\': 98244}, \'multiverseid\': 98244}, {\'name\': \'Behemoth di Llanowar\', \'text\': \'TAPpa una creatura STAPpata che controlli: Il Behemoth di Llanowar prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Molte persone non riescono a costruire armi decenti neppure con la pietra o il metallo. Gli elfi ci riescono usando solo fango e liane." —Gerrard della Cavalcavento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98964&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2aee393-4be6-407b-850f-a074afab3e4b\', \'multiverseId\': 98964}, \'multiverseid\': 98964}, {\'name\': \'ラノワールのビヒモス\', \'text\': \'あなたがコントロールするアンタップ状態のクリーチャーを１体タップする：ラノワールのビヒモスはターン終了時まで+1/+1の修整を受ける。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'たいていの種族は、石や鋼があってもまともな武器を作ることができない。 エルフの連中なら、きっと泥とツタだけで立派な武器をつくってみせるだろう。 ――ウェザーライト号のジェラード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99324&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1cc294e8-13d8-4d6a-abde-ffbb21dcd9bd\', \'multiverseId\': 99324}, \'multiverseid\': 99324}, {\'name\': \'Behemoth de Llanowar\', \'text\': \'Vire um criatura desvirada que você controla: Behemoth de Llanowar recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"A maioria das pessoas não é capaz de fabricar armas decentes de pedra ou de aço. Pode ter certeza de que os elfos são capazes de fazê-lo, usando apenas barro e ramos de trepadeiras." — Gerrard do Bons Ventos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99684&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d0f7b18-0950-401b-9aa9-ae7a334f3cb2\', \'multiverseId\': 99684}, \'multiverseid\': 99684}, {\'name\': \'Лановарский бегемот\', \'text\': \'Поверните неповернутых существ, которых вы контролируете: Лановарский бегемот получает +1/+1 до конца хода.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'"Не каждый человек сделает достойное оружие из камня и стали. Доверьте это дело эльфам они сделают вам оружие из вина и грязи". — Джерард Везерлайт\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109955&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cb12b0d6-92b4-4c17-88ad-4f978bf04436\', \'multiverseId\': 109955}, \'multiverseid\': 109955}, {\'name\': \'罗堰贝西摩斯\', \'text\': \'横置一个由你操控且未横置的生物：罗堰贝西摩斯得+1/+1直到回合结束。\', \'type\': \'生物～元素\', \'flavor\': \'「大部份的人用铁石都无法做出象样的武器， 地精们却只要用泥巴和藤蔓就办得到。」 ～晴空号的杰拉尔德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97884&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e41233e9-bb74-4ed8-b982-482a03e49536\', \'multiverseId\': 97884}, \'multiverseid\': 97884}]', "[{'name': 'Llanowar-Ödland', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {B} oder {G}. Das Llanowar-Ödland fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98606&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2e64fb9e-964a-4297-8590-e5400ae1c508', 'multiverseId': 98606}, 'multiverseid': 98606}, {'name': 'Yermos de Llanowar', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {B} o {G} a tu reserva de maná. Los Yermos de Llanowar te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100046&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'dc120ee8-68f9-487a-bc3b-a5da067a548b', 'multiverseId': 100046}, 'multiverseid': 100046}, {'name': 'Landes de Llanowar', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {B} ou {G} à votre réserve. Ces Landes de Llanowar vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98246&type=card', 'language': 'French', 'identifiers': {'scryfallId': '94dc60d7-f9b4-4cc0-9a8d-e41452da9ab5', 'multiverseId': 98246}, 'multiverseid': 98246}, {'name': 'Distese di Llanowar', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {B} o {G} alla tua riserva di mana. Le Distese di Llanowar ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98966&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e07d4110-f3bc-4548-90ae-aad6a9567cab', 'multiverseId': 98966}, 'multiverseid': 98966}, {'name': 'ラノワールの荒原', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{B}か{G}を加える。 ラノワールの荒原はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99326&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7c27b793-1b34-4265-8132-24fd5eeff8f6', 'multiverseId': 99326}, 'multiverseid': 99326}, {'name': 'Regiões Agrestes de Llanowar', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {B} ou {G} à sua reserva de mana. Regiões Agrestes de Llanowar causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99686&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd01f4ec9-d1f1-4a42-b33e-c513374ac99d', 'multiverseId': 99686}, 'multiverseid': 99686}, {'name': 'Лановарские пустоши', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {B} или {G} в запас маны. Лановарские пустоши наносят вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109957&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '44118147-2dc7-4389-8bdd-64cf350c7eea', 'multiverseId': 109957}, 'multiverseid': 109957}, {'name': '罗堰荒野', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{B}或{G}到你的法术力池中。 罗堰荒野对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97886&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1d875b5d-cb0d-45a3-8c15-8ecb9763f0d0', 'multiverseId': 97886}, 'multiverseid': 97886}]", "[{'name': 'Llanowarelfen', 'text': '{T}: Erhöhe deinen Manavorrat um {G}.', 'type': 'Kreatur — Elf, Druide', 'flavor': 'Ein zerbrochener Knochen für jeden zertretenen Zweig. —Strafe der Llanowar für Waldfriedensbruch', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98605&type=card', 'language': 'German', 'identifiers': {'scryfallId': '20e0dc9a-b748-4738-b94a-848ac85632c9', 'multiverseId': 98605}, 'multiverseid': 98605}, {'name': 'Elfos de Llanowar', 'text': '{T}: Agrega {G} a tu reserva de maná.', 'type': 'Criatura — Druida elfo', 'flavor': 'Un hueso roto por cada rama partida. —Castigo llanowar a los intrusos', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100045&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9934b870-2760-4161-b24a-38384eff9a5d', 'multiverseId': 100045}, 'multiverseid': 100045}, {'name': 'Elfes de Llanowar', 'text': '{T} : Ajoutez {G} à votre réserve.', 'type': 'Créature : elfe et druide', 'flavor': 'Un os brisé pour chaque branche cassée. —Punition de Llanowar pour les intrus', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98245&type=card', 'language': 'French', 'identifiers': {'scryfallId': '06374256-61c6-40d0-b039-b6f4ab625dcb', 'multiverseId': 98245}, 'multiverseid': 98245}, {'name': 'Elfi di Llanowar', 'text': '{T}: Aggiungi {G} alla tua riserva di mana.', 'type': 'Creatura — Druido Elfo', 'flavor': 'Un osso rotto per ogni ramoscello calpestato. —Punizione di Llanowar per gli intrusi', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98965&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'baca6e23-ad70-4af3-997a-8c7011c373db', 'multiverseId': 98965}, 'multiverseid': 98965}, {'name': 'ラノワールのエルフ', 'text': '{T}：あなたのマナ・プールに{G}を加える。', 'type': 'クリーチャー — エルフ・ドルイド', 'flavor': '小枝を踏み折れば、骨を折ってあがないとする。 ――ラノワールのエルフの、侵入者への処罰', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99325&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '914de291-2ec3-4c9c-9a06-cdd59e079b88', 'multiverseId': 99325}, 'multiverseid': 99325}, {'name': 'Elfos de Llanowar', 'text': '{T}: Adiciona {G} à sua reserva de mana.', 'type': 'Criatura — Druida Elfo', 'flavor': 'Um osso quebrado para cada broto de planta espezinhado. — Pena por invasão em Llanowar', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99685&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '75160b1b-3b79-434a-9e94-adf36a414eeb', 'multiverseId': 99685}, 'multiverseid': 99685}, {'name': 'Лановарские эльфы', 'text': '{T}: Добавьте {G} в запас маны.', 'type': 'Существо — Эльф Друид', 'flavor': 'Сломать одну кость за каждую веточку, хрустнувшую под ногами. — Наказание за нарушение границ у лановаров', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109956&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fe5939c3-1026-4725-a20f-80d4786e7757', 'multiverseId': 109956}, 'multiverseid': 109956}, {'name': '罗堰地精', 'text': '{T}：加{G}到你的法术力池中。', 'type': '生物～地精／德鲁伊', 'flavor': '每踩断脚下一根树枝就打断一根骨头。 ～罗堰族对非法入侵者的罚则', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97885&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '02d24e57-b533-41fd-89ab-94c6ef156b7b', 'multiverseId': 97885}, 'multiverseid': 97885}]", '[{\'name\': \'Loxodon-Kriegshammer\', \'text\': \'Die ausgerüstete Kreatur erhält +3/+0, verursacht Trampelschaden und hat „Immer wenn diese Kreatur Schaden zufügt, erhältst du ebenso viele Lebenspunkte dazu".\\nAusrüsten {3} ({3}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ebcc880c-7b94-4cff-873a-4e5226314d3a\', \'multiverseId\': 98609}, \'multiverseid\': 98609}, {\'name\': \'Martillo de guerra loxodón\', \'text\': \'La criatura equipada obtiene +3/+0, tiene la habilidad de arrollar y tiene "Siempre que esta criatura haga daño, ganas esa cantidad de vida."\\nEquipar {3}. ({3}: Anexa este equipo a la criatura objetivo que controles. Juega la habilidad de equipar como un conjuro).\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100049&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f09e839-050b-47b4-ade2-bb194542b404\', \'multiverseId\': 100049}, \'multiverseid\': 100049}, {\'name\': \'Marteau de guerre loxodon\', \'text\': "La créature équipée gagne +3/+0, a le piétinement et « À chaque fois que cette créature inflige des blessures, vous gagnez autant de points de vie. »\\nÉquipement {3} ({3} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez jouer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98249&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3935f738-7331-491b-b532-760cb882fbc2\', \'multiverseId\': 98249}, \'multiverseid\': 98249}, {\'name\': \'Martello da Guerra Lossodonte\', \'text\': \'La creatura equipaggiata prende +3/+0, ha travolgere e ha "Ogniqualvolta questa creatura infligge danno, guadagni un pari ammontare di punti vita".\\nEquipaggiare {3} ({3}: Assegnalo a una creatura bersaglio che controlli. Equipaggialo solo come una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98969&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6d6c074-74c3-41dd-aec5-1560a809638c\', \'multiverseId\': 98969}, \'multiverseid\': 98969}, {\'name\': \'ロクソドンの戦槌\', \'text\': \'装備しているクリーチャーは+3/+0の修整を受けるとともにトランプルと「このクリーチャーがダメージを与えるたび、あなたはその点数に等しい点数のライフを得る。」の能力を持つ。\\n装備 {3} ({3}：あなたがコントロールするクリーチャー１体を対象とし、これをつける。 装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99329&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'86dfcc47-d21d-41fc-aa92-cf72441a6cad\', \'multiverseId\': 99329}, \'multiverseid\': 99329}, {\'name\': \'Martelo de Batalha dos Loxodontes\', \'text\': \'A criatura equipada recebe +3/+0, tem a habilidade de atropelar e tem "Toda vez que esta criatura causar dano, você ganha aquela quantidade em pontos de vida".\\nEquipar {3} ({3}: Anexe à criatura alvo que você controla. Equipe somente quando puder jogar um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99689&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'612da48a-b36c-4422-873f-0e90da116a30\', \'multiverseId\': 99689}, \'multiverseid\': 99689}, {\'name\': \'Локсодонский боевой молот\', \'text\': \'Существо со снаряжением получает +3/+0, имеет способность пробивающего удара. Каждый раз, когда это существо наносит повреждения, вы получаете столько же пунктов жизни, сколько нанесено повреждений.\\nСнарядить {3} ({3}: прикрепите к целевому существу, которое вы контролируете. Только как волшебство).\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109960&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51dedc60-20ea-43f2-907a-6739c1f9e041\', \'multiverseId\': 109960}, \'multiverseid\': 109960}, {\'name\': \'象族战锤\', \'text\': \'佩带此武具的生物得+3/+0，具有践踏异能，且具有「每当此生物造成伤害时，你获得等量的生命。」\\n佩带{3}（{3}：装备在目标由你操控的生物上； 佩带的时机视同法术。）\', \'type\': \'神器～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97889&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c8b575e8-121b-41cc-9c0e-00cff4819a5a\', \'multiverseId\': 97889}, \'multiverseid\': 97889}]', '[{\'name\': \'Luftelementar\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Du kannst nur hoffen, dass du es nicht aus Versehen einatmest.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98438&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ec0fb40-6efc-4c64-8cff-5d99d83b0c67\', \'multiverseId\': 98438}, \'multiverseid\': 98438}, {\'name\': \'Elemental de aire\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Ruega porque no busque la seguridad de tus pulmones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99878&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0284dba2-53ae-4f20-8290-36f192e5ac5c\', \'multiverseId\': 99878}, \'multiverseid\': 99878}, {\'name\': "Élémental d\'air", \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : élémental\', \'flavor\': "Priez pour qu\'il ne trouve pas refuge dans vos poumons.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98078&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20a4b55f-ed79-41c1-ab99-3abab8a27bc0\', \'multiverseId\': 98078}, \'multiverseid\': 98078}, {\'name\': "Elementale dell\'Aria", \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Elementale\', \'flavor\': \'Prega che non cerchi la protezione dei tuoi polmoni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98798&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8fff03c2-5ceb-4edd-bc40-5dad56227055\', \'multiverseId\': 98798}, \'multiverseid\': 98798}, {\'name\': \'大気の精霊\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'そいつがお前の肺に逃げ込まないよう祈るんだな。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99158&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04a166b0-1b66-43b0-a3ae-b1fbcdefadc4\', \'multiverseId\': 99158}, \'multiverseid\': 99158}, {\'name\': \'Elemental do Ar\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Reza para que ele não busque a segurança dos teus pulmões.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99518&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8dc242ba-598b-4f7f-9783-5afb7c6226b8\', \'multiverseId\': 99518}, \'multiverseid\': 99518}, {\'name\': \'Элементаль воздуха\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Моли бога о том, чтобы он не добрался до твоих легких.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109789&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'75d3599c-cbfb-4936-afe2-60d05dded46c\', \'multiverseId\': 109789}, \'multiverseid\': 109789}, {\'name\': \'大气元素\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'生物～元素\', \'flavor\': \'祈祷它不会突然关心起你的肺部健康。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97718&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2bb24c3a-bbcd-4a49-a39d-b876453644e0\', \'multiverseId\': 97718}, \'multiverseid\': 97718}]', '[{\'name\': \'Lumengridaufseher\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Die anderen holen sich ihr Wissen aus alten Büchern, die in dunklen Türmen verborgen sind. Er findet Wissen in der Einsamkeit seines Lebens, das er damit verbringt, die Quecksilbersee zu beobachten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98610&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93c34d39-9da5-4ca7-951d-1139df4ffafb\', \'multiverseId\': 98610}, \'multiverseid\': 98610}, {\'name\': \'Encargado de Lúmengrid\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'Sus pares extraen el conocimiento de antiguos tomos guardados en oscuras torres. Él encuentra el conocimiento en la soledad de una vida entera observando el mar de mercurio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100050&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b33dc44b-b596-4399-affe-8b8caa5d7520\', \'multiverseId\': 100050}, \'multiverseid\': 100050}, {\'name\': \'Garde de Lumengrid\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "Ses pairs trouvent la connaissance dans d\'anciens tomes enfermés dans des tours noires. Lui la découvre dans la solitude d\'une vie passée à observer la Mer de Vif-argent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98250&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83a635e8-c2d4-4797-b77b-3fe50cb2b021\', \'multiverseId\': 98250}, \'multiverseid\': 98250}, {\'name\': \'Guardiano del Lumengrid\', \'type\': \'Creatura — Mago Umano\', \'flavor\': "I suoi pari traggono la conoscenza da antichi tomi rinchiusi in guglie oscure. Lui ha trovato la conoscenza nella solitudine di un\'esistenza trascorsa a osservare il Mare di Mercurio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98970&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0f96b188-80ab-4fed-b6f3-35adaf49f58b\', \'multiverseId\': 98970}, \'multiverseid\': 98970}, {\'name\': \'ルーメングリッドの管理人\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'彼の同僚は、暗い塔に封じられていた古代の魔法所から知識を導き出す。 彼は一生の間独りで見る水銀海から知識を得る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99330&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ef5da6d-346f-4fe6-a313-b069a73aaab4\', \'multiverseId\': 99330}, \'multiverseid\': 99330}, {\'name\': \'Encarregado de Lumengrid\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'Os seus colegas obtêm conhecimento de tomos antigos trancados em torres sombrias. Ele encontra conhecimento na solidão de uma vida passada observando o Mar de Mercúrio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99690&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a320d4f1-afa6-4519-9164-c1d6f7420163\', \'multiverseId\': 99690}, \'multiverseid\': 99690}, {\'name\': \'Дозорный Луменгрида\', \'type\': \'Существо — Человек Мудрец\', \'flavor\': \'Другие черпают знания в древних фолиантах, скрытых в темных башнях. Он же черпает знания в вечном одиночестве жизни, проведенной у Ртутного моря.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109961&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'97ee1d6e-fb01-4ef2-b7e7-8a4f0c00f75a\', \'multiverseId\': 109961}, \'multiverseid\': 109961}, {\'name\': \'博识都护持师\', \'type\': \'生物～人类／法术师\', \'flavor\': \'他此生此世都将独身伫立水银海旁， 凝视着深锁于黑暗尖塔的古籍，自中汲取知识。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97890&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'30364caa-b592-499b-8a9b-fe3f12696e4e\', \'multiverseId\': 97890}, \'multiverseid\': 97890}]', '[{\'name\': \'Macht der Eichen\', \'text\': \'Eine Kreatur deiner Wahl erhält +7/+7 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Rat mal, wo ich das hinpflanzen werde"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98621&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4edf2a15-dce0-4ce0-9aef-9e4a0384a70c\', \'multiverseId\': 98621}, \'multiverseid\': 98621}, {\'name\': \'Poder de los robles\', \'text\': \'La criatura objetivo obtiene +7/+7 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Adivina dónde voy a plantar esto"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100061&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0644e86-320b-4083-9745-f1f3863b51c8\', \'multiverseId\': 100061}, \'multiverseid\': 100061}, {\'name\': \'Puissance des chênaies\', \'text\': "La créature ciblée gagne +7/+7 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Oh Oh Oh Il est vraiment des chênaies. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98261&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc7abd48-b273-4030-92f9-fcaca4ac8d98\', \'multiverseId\': 98261}, \'multiverseid\': 98261}, {\'name\': \'Forza delle Querce\', \'text\': \'La creatura bersaglio prende +7/+7 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Indovina dove pianterò questo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98981&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bfa4fcf3-c623-48fa-987e-a95d57971369\', \'multiverseId\': 98981}, \'multiverseid\': 98981}, {\'name\': \'樫の力\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで+7/+7の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'おいらがこいつをどこに植えるか、当ててみな！\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99341&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'848ce425-3598-428d-b6f6-27db433543a5\', \'multiverseId\': 99341}, \'multiverseid\': 99341}, {\'name\': \'Força dos Carvalhos\', \'text\': \'A criatura alvo recebe +7/+7 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Adivinha onde vou plantar este"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99701&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc6ff24f-4426-4a3a-8606-ed71f17325ab\', \'multiverseId\': 99701}, \'multiverseid\': 99701}, {\'name\': \'Сила дубов\', \'text\': \'Целевое существо получает +7/+7 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Догадайся, где я его посажу"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109972&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0c144c2f-1768-4101-bf64-7781089f166c\', \'multiverseId\': 109972}, \'multiverseid\': 109972}, {\'name\': \'橡树之力\', \'text\': \'目标生物得+7/+7直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「猜猜看，我要把它插在哪里！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97901&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8817f671-4f78-4cc8-a4ad-b8818e568e60\', \'multiverseId\': 97901}, \'multiverseid\': 97901}]', '[{\'name\': \'Machtmampfer\', \'text\': \'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen.)\\nStärke und Widerstandskraft des Machtmampfers sind gleich der Anzahl an Hexereikarten auf allen Friedhöfen.\', \'type\': \'Kreatur — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98611&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e431049-fa41-4846-b8bf-8cfe6a94dc6c\', \'multiverseId\': 98611}, \'multiverseid\': 98611}, {\'name\': \'Magnívoro\', \'text\': \'Prisa. (Esta criatura puede atacar el turno en que entre bajo tu control.)\\nTanto la fuerza como la resistencia del Magnívoro son iguales al número de cartas de conjuro que haya en todos los cementerios.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100051&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acf53f9d-a2da-43f7-bb92-53771a345cae\', \'multiverseId\': 100051}, \'multiverseid\': 100051}, {\'name\': \'Magnivore\', \'text\': "Célérité (Cette créature peut attaquer dès le tour où elle arrive sous votre contrôle.)\\nLa force et l\'endurance du Magnivore sont chacune égale au nombre de cartes de rituel dans tous les cimetières.", \'type\': \'Créature : lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98251&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ff0af8df-f36a-4764-bca9-e077a46075e2\', \'multiverseId\': 98251}, \'multiverseid\': 98251}, {\'name\': \'Magnivoro\', \'text\': \'Rapidità (Questa creatura può attaccare nel turno in cui entra sotto il tuo controllo.)\\nLa forza e la costituzione del Magnivoro sono pari ciascuna al numero di carte stregoneria presenti in tutti i cimiteri.\', \'type\': \'Creatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98971&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f540d57-07e0-4890-ad0c-37082382a3ef\', \'multiverseId\': 98971}, \'multiverseid\': 98971}, {\'name\': \'猛烈に食うもの\', \'text\': \'速攻 （このクリーチャーは、あなたのコントロール下になったターンに攻撃に参加してもよい。）\\n猛烈に食うもののパワーとタフネスは、それぞれすべての墓地にあるソーサリー・カードの枚数に等しい。\', \'type\': \'クリーチャー — ルアゴイフ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99331&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0554125-78d1-4796-a7c0-d9ac84be7682\', \'multiverseId\': 99331}, \'multiverseid\': 99331}, {\'name\': \'Magnívoro\', \'text\': \'Ímpeto (Esta criatura pode atacar no turno em que entra em jogo sob seu controle.)\\nO poder e a resistência de Magnívoro são ambos iguais ao número de cards de feitiço em todos os cemitérios.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99691&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'170a3b74-2a7b-4524-9e28-bb30d879860f\', \'multiverseId\': 99691}, \'multiverseid\': 99691}, {\'name\': \'Магнивор\', \'text\': \'Ускорение (Это существо может нападать во время того хода, когда оно попало под ваш контроль).\\nСила и здоровье Магнивора равняются числу карт волшебства на всех кладбищах.\', \'type\': \'Существо — Лургойф\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109962&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec6e41bc-37d2-4758-b084-23295ac98614\', \'multiverseId\': 109962}, \'multiverseid\': 109962}, {\'name\': \'噬咒兽\', \'text\': \'敏捷（你操控此生物的该回合中，它便可以攻击）\\n噬咒兽的力量和防御力各等同于所有坟墓场中法术牌的数量。\', \'type\': \'生物～拉高耶夫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97891&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5a004fe-698f-4909-85dd-08ab71ce408f\', \'multiverseId\': 97891}, \'multiverseid\': 97891}]', '[{\'name\': \'Mahamoti-Dschinn\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Dschinn\', \'flavor\': \'Als König der Geister der Lüfte reitet der Mahamoti-Dschinn auf den Flügeln der Winde. Im Kampf und im Spiel ist er ein gefährlicher Gegner, und zudem ein Meister der Täuschung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98612&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'60ba2692-6def-45a8-8e63-092cac688e0f\', \'multiverseId\': 98612}, \'multiverseid\': 98612}, {\'name\': \'Djinn Mahamoti\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Djinn\', \'flavor\': \'De sangre real entre los espíritus del aire, el djinn Mahamoti cabalga sobre las alas de los vientos. Es tan peligroso en el salón de juego como en batalla, y es un maestro del engaño y la información errónea.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100052&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6861e6b3-d0ce-4a1d-bb68-919e392927f5\', \'multiverseId\': 100052}, \'multiverseid\': 100052}, {\'name\': \'Djinn mahâmot\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : djinn\', \'flavor\': "Noble d\'entre les plus nobles esprits de l\'air, le djinn mahâmot voyage sur les ailes du vent. Maître de la ruse et du mensonge, il est aussi redoutable au jeu que sur le champ de bataille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98252&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2751eb56-974e-4da9-935c-df3f2ba26006\', \'multiverseId\': 98252}, \'multiverseid\': 98252}, {\'name\': \'Genio Mahamoti\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Genio\', \'flavor\': "Di sangue nobile tra gli spiriti dell\'aria, il genio Mahamoti cavalca sulle ali del vento. Pericoloso nelle sale da gioco come in battaglia, è un maestro degli inganni e delle truffe.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98972&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63caa554-b206-4e5a-b2db-ef99e257c07f\', \'multiverseId\': 98972}, \'multiverseid\': 98972}, {\'name\': \'マハモティ・ジン\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — ジン\', \'flavor\': \'マハモティ・ジンは大気の精霊たちの中でも高貴な血筋につながり、風の翼で空を駆ける。 彼は計略と詐術の名手であり、戦場はもちろん、賭博場においても危険な存在となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99332&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82bd5742-0038-4998-be46-d3438ff2690e\', \'multiverseId\': 99332}, \'multiverseid\': 99332}, {\'name\': \'Gênio Mahamoti\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Gênio\', \'flavor\': \'Sangue real entre os espíritos do ar, o gênio Mahamoti cavalga nas asas dos ventos. Tão perigoso nos salões de jogos como na batalha, ele é um mestre dos truques e engodos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99692&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6310a8b9-31a1-4f4f-bdd7-fc1f2706e22c\', \'multiverseId\': 99692}, \'multiverseid\': 99692}, {\'name\': \'Джинн Магамоти\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Существо — Джинн\', \'flavor\': \'Джинн Магамоти, дух воздуха королевских кровей, летает на крыльях ветра. Он опасен как в казино, так и в битве. Никто лучше него не умеет обманывать и сбивать с пути.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109963&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16254e38-cf61-4fd6-b4db-dbe1b61f3dd6\', \'multiverseId\': 109963}, \'multiverseid\': 109963}, {\'name\': \'神灯巨灵\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'生物～巨灵\', \'flavor\': \'神灯巨灵乘着风的翅膀，拥有大气精怪中的高贵血统。 他是诡计与误导的专家，不论身处赌场或战场都是一等高手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97892&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a99e6f7b-562e-4a1f-bcc3-17236d18926f\', \'multiverseId\': 97892}, \'multiverseid\': 97892}]', '[{\'name\': \'Manakollision\', \'text\': \'Ein Gegner deiner Wahl und du werfen beide eine Münze. Manakollision fügt jedem Spieler, dessen Münze „Zahl" zeigt, 1 Schadenspunkt zu. Wiederholt diesen Prozess, bis beide Münzen im selben Wurf „Kopf" zeigen.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98613&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'756cbed5-284a-48b4-85ec-1606c4bbc831\', \'multiverseId\': 98613}, \'multiverseid\': 98613}, {\'name\': \'Choque de maná\', \'text\': \'Tanto tú como el oponente objetivo lanzan una moneda al aire. El Choque de maná hace 1 punto de daño a cada jugador que haya sacado cruz. Se repite este proceso hasta que ambos jugadores sacan cara en el mismo lanzamiento.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100053&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3b4528b-a61f-441a-b211-9a7f935772bc\', \'multiverseId\': 100053}, \'multiverseid\': 100053}, {\'name\': \'Choc de mana\', \'text\': "Vous et l\'adversaire ciblé lancez chacun une pièce en l\'air. Le Choc de mana inflige 1 blessure à chaque joueur dont la pièce retombe sur pile. Répétez la procédure jusqu\'à ce que les deux pièces tombent sur face en même temps.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98253&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21dd11b4-7493-477b-99b5-dcc06d38a24b\', \'multiverseId\': 98253}, \'multiverseid\': 98253}, {\'name\': \'Contesa di Magia\', \'text\': "Tu e l\'avversario bersaglio lanciate una moneta ciascuno. La Contesa di Magia infligge 1 danno a ogni giocatore che ottiene croce. Ripeti il procedimento fino a quando entrambi i giocatori ottengono testa con lo stesso lancio.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98973&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2853988a-3732-445c-ab2c-5f3f4d3f28b4\', \'multiverseId\': 98973}, \'multiverseid\': 98973}, {\'name\': \'魔力激突\', \'text\': \'対戦相手１人を対象とする。あなたとそのプレイヤーはコイン投げをする。 魔力激突は、コインが裏だった各プレイヤーに１点のダメージを与える。 これを、両方のプレイヤーのコインが同時に表になるまで繰り返す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99333&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a9dea49-6236-44fd-9cb3-6d5a63088883\', \'multiverseId\': 99333}, \'multiverseid\': 99333}, {\'name\': \'Duelo de Mana\', \'text\': \'Você e o oponente alvo lançam uma moeda. Duelo de Mana causa 1 ponto de dano a cada jogador que tirar coroa. Repita o processo até que as moedas dos dois jogadores dêem cara ao mesmo tempo.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99693&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'983e2425-f6b9-4a7b-adee-f6931216aec2\', \'multiverseId\': 99693}, \'multiverseid\': 99693}, {\'name\': \'Звон маны\', \'text\': \'Вы и целевой оппонент бросаете по монете. Звон маны наносит 1 повреждение игроку, у которого выпала решка. Бросайте монеты, пока у обоих игроков одновременно не выпадет орел.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109964&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'db5ab3d0-9ea0-468d-bd96-79d9e866f65f\', \'multiverseId\': 109964}, \'multiverseid\': 109964}, {\'name\': \'法术力碰撞\', \'text\': \'你和目标对手各掷一枚硬币， 法术力碰撞对每位掷出反面的牌手各造成1点伤害。 重复此步骤，直到双方的硬币同时出现正面为止。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97893&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5d4e36a-61c1-4c34-a3d2-0a043ec42c52\', \'multiverseId\': 97893}, \'multiverseid\': 97893}]', '[{\'name\': \'Manaleck\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, falls sein Beherrscher nicht {3} bezahlt.\', \'type\': \'Spontanzauber\', \'flavor\': \'Viele Pläne scheitern an der Annahme, man wüsste mehr als der Gegner.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98614&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0431dc65-7e54-4876-81f2-27e5a3f0f855\', \'multiverseId\': 98614}, \'multiverseid\': 98614}, {\'name\': \'Fuga de maná\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {3}.\', \'type\': \'Instantáneo\', \'flavor\': \'El error fatídico de todos los planes es la suposición de que sabemos más que nuestro enemigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100054&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b64ba105-23f1-444d-a1a2-8b1b8508d363\', \'multiverseId\': 100054}, \'multiverseid\': 100054}, {\'name\': \'Fuite de mana\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paye {3}.\', \'type\': \'Éphémère\', \'flavor\': "C\'est toujours une erreur de croire que l\'on en sait plus que son ennemi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98254&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5335cb1f-b7e6-481e-97f1-5533c92144ae\', \'multiverseId\': 98254}, \'multiverseid\': 98254}, {\'name\': \'Indebolimento Magico\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore spenda {3}.\', \'type\': \'Istantaneo\', \'flavor\': \'Il punto debole di qualsiasi piano è dare per scontato che tu ne sappia di più del tuo nemico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98974&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28dfd073-ae77-4d5b-8965-79fa5af14631\', \'multiverseId\': 98974}, \'multiverseid\': 98974}, {\'name\': \'マナ漏出\', \'text\': \'呪文１つを対象とする。そのコントローラーが{3}を支払わない限り、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'どんな計画でも、敵よりも自分の方がよく知っていると思うことが致命的な欠陥となるのさ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99334&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b471949-cfe0-4b32-9f1f-f88f78181ccf\', \'multiverseId\': 99334}, \'multiverseid\': 99334}, {\'name\': \'Fuga de Mana\', \'text\': \'Anula a mágica alvo a menos que seu controlador pague {3}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A falha fatal em qualquer plano é a presunção de que você sabe mais do que o seu inimigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99694&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d15aceb8-41e2-47e0-97ce-8c35d497c44f\', \'multiverseId\': 99694}, \'multiverseid\': 99694}, {\'name\': \'Утечка маны\', \'text\': \'Прервите целевое заклинание, если игрок, контролирующий его не заплатит {3}.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Если противник делает ошибку за ошибкой, значит, вы знаете больше, чем он.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109965&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4fe8e54e-cc57-43ba-94b6-8877bae177c5\', \'multiverseId\': 109965}, \'multiverseid\': 109965}, {\'name\': \'魔力流失\', \'text\': \'除非目标咒语的操控者支付{3}，否则反击该咒语。\', \'type\': \'瞬间\', \'flavor\': \'任何计划中最大的漏洞，即是假设你所知道的比敌人多。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97894&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c981dfe8-4e62-4ad1-8737-f699d20a2d23\', \'multiverseId\': 97894}, \'multiverseid\': 97894}]', '[{\'name\': \'Marionettenkönig\', \'text\': \'{U}, {T}: Tappe oder enttappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Wenn man Leute dazu bringen will, das zu tun, was man von ihnen will, muss man ihnen das sagen, was sie gerne hören wollen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e180119-61d3-4d15-bb7d-324f12f5d117\', \'multiverseId\': 98664}, \'multiverseid\': 98664}, {\'name\': \'Titiritero\', \'text\': \'{U}, {T}: Gira o endereza la criatura objetivo.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Hacer que la gente haga lo que quieres es meramente cuestión de decirles lo que quieren oír."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100104&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d02d6fe7-9862-4eb6-ba09-075f178417e3\', \'multiverseId\': 100104}, \'multiverseid\': 100104}, {\'name\': \'Sculpteur de marionnettes\', \'text\': \'{U}, {T} : Engagez ou dégagez la créature ciblée.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Pour qu\'ils fassent ce que vous voulez, dites-leur ce qu\'ils veulent entendre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98304&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09b2ffdc-2e01-446b-8639-d137a965ac17\', \'multiverseId\': 98304}, \'multiverseid\': 98304}, {\'name\': \'Burattinaio\', \'text\': \'{U}, {T}: TAPpa o STAPpa una creatura bersaglio.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"Indurre le persone a fare quello che vuoi dipende semplicemente dal saper dire loro quello che vogliono sentire."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99024&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1693f66c-12f1-4793-be9c-f254ddb0f242\', \'multiverseId\': 99024}, \'multiverseid\': 99024}, {\'name\': \'くぐつ師\', \'text\': \'{U}, {T}：クリーチャー１体を対象とし、それをタップまたはアンタップする。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'やってもらいたいことを人にやらせるには、彼らが聞きたいことを言ってやることですよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99384&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a13c199d-b3eb-4b9c-b78b-b95f1048f124\', \'multiverseId\': 99384}, \'multiverseid\': 99384}, {\'name\': \'Titeriteiro\', \'text\': \'{U}, {T}: Vira ou desvira a criatura alvo.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'"Fazer com que as pessoas façam o que você quer é apenas uma questão de lhes dizer o que elas querem ouvir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99744&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0340a366-d320-40c3-83cc-4e94e813a7e2\', \'multiverseId\': 99744}, \'multiverseid\': 99744}, {\'name\': \'Кукольник\', \'text\': \'{U}, {T}: Поверните или разверните целевое существо.\', \'type\': \'Существо — Человек Мудрец\', \'flavor\': \'"Чтобы заставить людей делать то, что ты хочешь, нужно просто говорить им то, что они хотят услышать".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110015&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b51406a-3960-45c0-9a24-60af04fac1b1\', \'multiverseId\': 110015}, \'multiverseid\': 110015}, {\'name\': \'操偶师\', \'text\': \'{U}，{T}：横置或重置目标生物。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「驱使别人去做你想要他做的事，最好的方法就是说他想听的话。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97944&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b602a3cd-1050-4d7f-9864-c26f3a03ea53\', \'multiverseId\': 97944}, \'multiverseid\': 97944}]', '[{\'name\': \'Marmortitan\', \'text\': \'Kreaturen mit Stärke 3 oder größer enttappen nicht während der Enttappsegmente ihrer Beherrscher.\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Er betrat den Tempel mit so viel Pomp und Gehabe wie ein Stein, der einen Goblinschädel einschlägt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98615&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a6245f1-d8a6-4699-a1cd-34b9e6224897\', \'multiverseId\': 98615}, \'multiverseid\': 98615}, {\'name\': \'Titán de mármol\', \'text\': \'Las criaturas con fuerza de 3 ó más no se enderezan durante los pasos de enderezar de sus controladores.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Entró al templo con toda la pompa y el decoro de una roca golpeando el cráneo de un trasgo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100055&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdea55d7-1d7a-47bd-b882-4e69661073b3\', \'multiverseId\': 100055}, \'multiverseid\': 100055}, {\'name\': \'Titan de marbre\', \'text\': "Les créatures dont la force est de 3 ou plus ne se dégagent pas pendant l\'étape de dégagement de leurs contrôleurs.", \'type\': \'Créature : géant\', \'flavor\': "Il entra dans le temple avec toute la grâce et l\'élégance d\'un rocher écrasant le crâne d\'un gobelin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98255&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'578eda4f-5714-48f9-bd9c-8fd75e1eaf30\', \'multiverseId\': 98255}, \'multiverseid\': 98255}, {\'name\': \'Titano di Marmo\', \'text\': \'Le creature con forza pari o superiore a 3 non STAPpano durante lo STAP dei loro controllori.\', \'type\': \'Creatura — Gigante\', \'flavor\': \'Entrò nel tempio con tutto lo sfarzo e il decoro di una roccia che colpisce il cranio di un goblin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98975&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bdc0d9d5-b3cf-4091-bef9-890976d9671a\', \'multiverseId\': 98975}, \'multiverseid\': 98975}, {\'name\': \'大理石のタイタン\', \'text\': \'パワーが３以上のクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'クリーチャー — 巨人\', \'flavor\': \'それはゴブリンの頭に当たった岩の荘厳さと端正さを携えて寺院に入った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99335&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ce4be21-ab0d-4978-ad2e-67f8f34d1418\', \'multiverseId\': 99335}, \'multiverseid\': 99335}, {\'name\': \'Titã de Mármore\', \'text\': \'As criaturas com poder maior ou igual a 3 não desviram durante as etapas de desvirar de seus controladores.\', \'type\': \'Criatura — Gigante\', \'flavor\': \'Ele entrou no templo com toda pompa e decoro de uma rocha acertando o crânio de um goblin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99695&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a5f122b2-84ae-4e0c-94fe-e645922312d3\', \'multiverseId\': 99695}, \'multiverseid\': 99695}, {\'name\': \'Мраморный титан\', \'text\': \'Существа со значением силы 3 или более не разворачиваются во время этапа разворота игрока, который их контролирует.\', \'type\': \'Существо — Гигант\', \'flavor\': \'Он вошел в храм с торжественностью и тактичностью камня, попавшего гоблину по макушке.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109966&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f746d54-92ae-4b2b-8a88-2e0a25a385ce\', \'multiverseId\': 109966}, \'multiverseid\': 109966}, {\'name\': \'洁白泰坦巨人\', \'text\': \'力量大于或等于3的生物于其操控者的重置步骤中不可重置。\', \'type\': \'生物～巨人\', \'flavor\': \'就一块能打烂精灵头壳的石头来说，能够入殿为人供奉真算是无上的礼遇与光荣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97895&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d0440b18-1344-4c68-b7a6-4c7f7cfd384b\', \'multiverseId\': 97895}, \'multiverseid\': 97895}]', "[{'name': 'Maro', 'text': 'Stärke und Widerstandskraft des Maro sind gleich der Anzahl der Karten auf deiner Hand.', 'type': 'Kreatur — Elementarwesen', 'flavor': 'Es haben noch keine zwei Leute denselben Maro gesehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98616&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c4c4c133-8a73-4e5e-956a-b8404de1f07c', 'multiverseId': 98616}, 'multiverseid': 98616}, {'name': 'Maro', 'text': 'Tanto la fuerza como la resistencia del Maro son iguales al número de cartas que haya en tu mano.', 'type': 'Criatura — Elemental', 'flavor': 'Un mismo maro no puede ser visto por dos seres.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100056&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '68a9651f-3e8b-4631-bafe-e46a792ee7fe', 'multiverseId': 100056}, 'multiverseid': 100056}, {'name': 'Maro', 'text': 'Le Maro a une force et une endurance chacune égale au nombre de cartes dans votre main.', 'type': 'Créature : élémental', 'flavor': 'Chacun voit un maro différent.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98256&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9efc6d8c-e2dc-4c0d-ad7c-76e6b486710f', 'multiverseId': 98256}, 'multiverseid': 98256}, {'name': 'Maro', 'text': 'La forza e la costituzione del Maro sono pari ciascuna al numero di carte che hai in mano.', 'type': 'Creatura — Elementale', 'flavor': 'Due persone non vedono mai lo stesso Maro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98976&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5a20d8b6-74df-435c-b98a-97935030ea04', 'multiverseId': 98976}, 'multiverseid': 98976}, {'name': 'マロー', 'text': 'マローのパワーとタフネスは、それぞれあなたの手札のカードの枚数に等しい。', 'type': 'クリーチャー — エレメンタル', 'flavor': '同じマローを見る者は二人といない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99336&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '35e31f8c-cf72-451f-bf3b-f3dd71be4a0e', 'multiverseId': 99336}, 'multiverseid': 99336}, {'name': 'Maro', 'text': 'O poder e a resistência de Maro são ambos iguais ao número de cards em sua mão.', 'type': 'Criatura — Elemental', 'flavor': 'Não se vê o mesmo Maro duas vezes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99696&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1f65dd98-54ca-4cba-a021-f9c3b8ae7d4a', 'multiverseId': 99696}, 'multiverseid': 99696}, {'name': 'Маро', 'text': 'Сила и здоровье Маро равняются числу карт в вашей руке.', 'type': 'Существо — Элементаль', 'flavor': 'Разные люди видят разных Маро.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109967&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '14d04714-c981-4d6d-8b24-6d2e315efed9', 'multiverseId': 109967}, 'multiverseid': 109967}, {'name': '玛洛', 'text': '玛洛的力量和防御力各等同于你的手牌数量。', 'type': '生物～元素', 'flavor': '没人看过同样的玛洛。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97896&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bbd9dd66-3af7-4911-8b9c-0088bb048591', 'multiverseId': 97896}, 'multiverseid': 97896}]", '[{\'name\': \'Meisterhafter Köder\', \'text\': \'{W}, {T}: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Ein erfahrener Köder kann deine Feinde von ihrem Pfad abbringen. Ein meisterhafter Köder kann überleben, um es noch mal zu tun.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98617&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'efc3e60d-87d9-4e15-8e31-4bbebd6241fb\', \'multiverseId\': 98617}, \'multiverseid\': 98617}, {\'name\': \'Maestro en señuelos\', \'text\': \'{W}, {T}: Gira la criatura objetivo.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Un señuelo hábil puede hacer que tus enemigos dejen de seguirte el rastro. Un señuelo experto puede sobrevivir para volver a hacerlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100057&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25cc52d8-4ab2-4642-af1a-bef6969981e0\', \'multiverseId\': 100057}, \'multiverseid\': 100057}, {\'name\': \'Maître leurreur\', \'text\': \'{W}, {T} : Engagez la créature ciblée.\', \'type\': \'Créature : humain et soldat\', \'flavor\': \'Un leurreur expérimenté peut faire perdre votre trace à vos adversaires. Un maître leurreur peut survivre et recommencer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98257&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88c15992-a4e7-4c70-925c-594324a4ea64\', \'multiverseId\': 98257}, \'multiverseid\': 98257}, {\'name\': "Maestro d\'Astuzia", \'text\': \'{W}, {T}: TAPpa una creatura bersaglio.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': "Un bravo adescatore può sviare i nemici dalle tue tracce. Un maestro d\'astuzia riesce a sopravvivere per farlo ancora.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98977&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7e408753-11e9-4ce8-8e66-7c1a9efd0804\', \'multiverseId\': 98977}, \'multiverseid\': 98977}, {\'name\': \'おとりの達人\', \'text\': \'{W}, {T}：クリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'腕のいいおとりを使えば、敵をしりぞけることができる。 おとりの達人ともなれば、生き延びてふたたび敵をしりぞけてくれる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99337&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f18a9d1a-ba10-4a47-931d-9ce19cdc3e84\', \'multiverseId\': 99337}, \'multiverseid\': 99337}, {\'name\': \'Chamariz Magistral\', \'text\': \'{W}, {T}: Vira a criatura alvo.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'Um chamariz habilidoso é capaz de afastar teus inimigos de teu caminho. Um chamariz magistral é capaz de sobreviver para repetir a façanha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99697&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3928265c-1923-42a7-877c-86d69a835553\', \'multiverseId\': 99697}, \'multiverseid\': 99697}, {\'name\': \'Мастер ловушек\', \'text\': \'{W}, {T}: Поверните целевое существо.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Опытный обманщик может увести врагов с вашего следа. Мастер ловушек после этого выживет и сделает это снова.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109968&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'750f615d-d56b-4612-8ebb-ee7d6b1b490c\', \'multiverseId\': 109968}, \'multiverseid\': 109968}, {\'name\': \'诱敌专家\', \'text\': \'{W}，{T}：横置目标生物。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'技巧好的诱敌兵有办法让敌人跟丢。 最顶尖的诱敌兵则还能确保自身安全以再显身手。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97897&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d71cc16-2e01-46bc-ae67-b185520efad7\', \'multiverseId\': 97897}, \'multiverseid\': 97897}]', '[{\'name\': \'Meisterheiler\', \'text\': \'{T}: Verhindere die nächsten 4 Schadenspunkte, die in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt würden.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Hinter seinen Augen lebt die Qual jedes Soldaten, den seine Hände je geheilt haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98618&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c8c18c3-58c4-4150-896f-eaf7c453b9c2\', \'multiverseId\': 98618}, \'multiverseid\': 98618}, {\'name\': \'Sanador experto\', \'text\': \'{T}: Prevén los siguientes 4 puntos de daño que se le fueran a hacer a la criatura o jugador objetivo este turno.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Tras sus ojos está el dolor de cada soldado que sus manos han sanado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100058&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a2d2b28-cf7a-43cf-b75d-ae848fd0b89f\', \'multiverseId\': 100058}, \'multiverseid\': 100058}, {\'name\': \'Maître guérisseur\', \'text\': \'{T} : Prévenez, ce tour-ci, les prochaines 4 blessures qui devrait être infligées à une cible, créature ou joueur.\', \'type\': \'Créature : humain et clerc\', \'flavor\': "Derrière son regard se cachent les souffrances de tous les soldats qu\'il a soignés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98258&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb26786e-eae6-4c13-b919-278607baf0c7\', \'multiverseId\': 98258}, \'multiverseid\': 98258}, {\'name\': \'Mastro Guaritore\', \'text\': \'{T}: Previeni i prossimi 4 danni che verrebbero inflitti a una creatura o a un giocatore bersaglio in questo turno.\', \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'Dietro ai suoi occhi si cela il dolore di ogni soldato curato dalle sue mani.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98978&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b899e00-ee7c-402b-897d-d5617f581d6d\', \'multiverseId\': 98978}, \'multiverseid\': 98978}, {\'name\': \'練達の癒し手\', \'text\': \'{T}：クリーチャー１体かプレイヤー１人を対象とする。このターン、次にそれに与えられるダメージを４点軽減する。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'彼女の心には、その手で癒した兵士ひとりひとりの苦痛の有様が焼きついている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99338&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c1dd8edb-91cc-42e4-92d1-dcdf5c578d8b\', \'multiverseId\': 99338}, \'multiverseid\': 99338}, {\'name\': \'Mestre Curandeiro\', \'text\': \'{T}: Previne os próximos 4 pontos de dano que seriam causados à criatura ou ao jogador alvo neste turno.\', \'type\': \'Criatura — Clérigo Humano\', \'flavor\': \'Por trás de seus olhos esconde-se a dor de todos os soldados que suas mãos curaram.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99698&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9bf9d651-108f-4701-a316-53274a381c8d\', \'multiverseId\': 99698}, \'multiverseid\': 99698}, {\'name\': \'Искусный целитель\', \'text\': \'{T}: Предотвратите следующие 4 повреждения, которые будут нанесены целевому существу или игроку в этот ход.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Перед его глазами стоят солдаты, чью боль он исцелил своими руками.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109969&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'85f466f7-6122-4284-ad50-091d6d97e807\', \'multiverseId\': 109969}, \'multiverseid\': 109969}, {\'name\': \'疗疾神医\', \'text\': \'{T}：于本回合中，防止接下来将对目标生物或牌手造成的4点伤害。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'他眼中深埋了每个曾亲手医治之士兵的苦痛。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97898&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4c462b62-c2ff-44ee-b267-9834cb23a3a2\', \'multiverseId\': 97898}, \'multiverseid\': 97898}]', '[{\'name\': \'Meistermeuchler\', \'text\': \'{T}: Zerstöre eine getappte Kreatur deiner Wahl.\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': \'In den Künsten der Verschwörung wohl ausgebildet, wählen die Meistermeuchler ihre Opfer sorgfältig. Sie verlassen sich lieber auf den rechten Zeitpunkt und Präzision als auf rohe Gewalt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98687&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10fb7878-fa9a-4628-ae93-a771f9c08355\', \'multiverseId\': 98687}, \'multiverseid\': 98687}, {\'name\': \'Asesino real\', \'text\': \'{T}: Destruye la criatura objetivo girada.\', \'type\': \'Criatura — Asesino humano\', \'flavor\': \'Entrenados en las artes del sigilo, los asesinos reales eligen a sus víctimas cuidadosamente basándose en el momento indicado y la precisión, en vez de en la fuerza bruta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100127&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'215930bc-6445-435f-b6a9-8b7cd7be5897\', \'multiverseId\': 100127}, \'multiverseid\': 100127}, {\'name\': \'Assassin royal\', \'text\': \'{T} : Détruisez la créature engagée ciblée.\', \'type\': \'Créature : humain et assassin\', \'flavor\': \'Entraînés aux arts furtifs, les assassins royaux choisissent tout particulièrement leurs victimes, préférant la préparation et la précision à la force brute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98327&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0fc31165-70e2-497a-a048-a989362826c3\', \'multiverseId\': 98327}, \'multiverseid\': 98327}, {\'name\': \'Assassino Reale\', \'text\': \'{T}: Distruggi una creatura TAPpata bersaglio.\', \'type\': \'Creatura — Assassino Umano\', \'flavor\': "Addestrati nell\'arte del sotterfugio, gli assassini reali scelgono le loro vittime con cura e si affidano al tempismo e alla precisione piuttosto che alla forza bruta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99047&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'74eacaa0-5526-421b-96fa-7b4dc28b336d\', \'multiverseId\': 99047}, \'multiverseid\': 99047}, {\'name\': \'凄腕の暗殺者\', \'text\': \'{T}：タップ状態のクリーチャー１体を対象とし、それを破壊する。\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': \'隠密行動に長けた凄腕の暗殺者は、注意深く犠牲者を選ぶ。彼らが頼むのは腕っぷしではなく、タイミングと正確さだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99407&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e31d80d2-13b7-41e2-99ea-9008103de532\', \'multiverseId\': 99407}, \'multiverseid\': 99407}, {\'name\': \'Assassino da Realeza\', \'text\': \'{T}: Destrói a criatura alvo virada.\', \'type\': \'Criatura — Assassino Humano\', \'flavor\': \'Treinados nas artes da furtividade, os assassinos da realeza escolhem suas vítimas com cuidado, contando mais com o senso de oportunidade e a precisão do que com a força bruta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99767&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6927a6ce-3f23-419c-9be6-0e975546b93b\', \'multiverseId\': 99767}, \'multiverseid\': 99767}, {\'name\': \'Королевский убийца\', \'text\': \'{T}: Уничтожьте целевое повернутое существо.\', \'type\': \'Существо — Человек Убийца\', \'flavor\': \'Королевские убийцы хорошо обучены своему ремеслу, они аккуратно выбирают жертв, полагаясь больше на точность и расчет, нежели на грубую силу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110038&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f7998e6-0b24-4338-8917-bb2106f42b8e\', \'multiverseId\': 110038}, \'multiverseid\': 110038}, {\'name\': \'皇家刺客\', \'text\': \'{T}：消灭目标已横置的生物。\', \'type\': \'生物～人类／杀手\', \'flavor\': \'修习匿踪技艺的皇家刺客总是细心选择其牺牲品，不倚仗蛮力，实时且精准地行动。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97967&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'343dbcf9-2c5c-4cbb-9c53-c6b7701a0ec7\', \'multiverseId\': 97967}, \'multiverseid\': 97967}]', '[{\'name\': \'Minenfalle\', \'text\': \'Sowie die Minenfalle ins Spiel kommt, nenne eine Karte außer einem Standardland und bestimme einen Gegner. Dieser Spieler zeigt jede Karte, die er zieht, offen vor. Wenn der Spieler die genannte Karte zieht, opfere die Minenfalle. Falls du dies tust, fügt die Minenfalle diesem Spieler 10 Schadenspunkte zu.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98472&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'552dc7e4-a91a-435b-9cfc-8976a698156a\', \'multiverseId\': 98472}, \'multiverseid\': 98472}, {\'name\': \'Trampa explosiva\', \'text\': \'En cuanto la Trampa explosiva entre en juego, nombra una carta que no sea una tierra básica y elige un oponente. El jugador elegido muestra cada carta que roba. Cuando el jugador elegido robe la carta nombrada, sacrifica la Trampa explosiva. Si lo haces, la Trampa explosiva hace 10 puntos de daño a ese jugador.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99912&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97347b22-53ae-40bf-ad5f-7af04ef687f2\', \'multiverseId\': 99912}, \'multiverseid\': 99912}, {\'name\': \'Piège explosif\', \'text\': "Au moment où le Piège explosif arrive en jeu, nommez une carte autre qu\'une carte de terrain de base et choisissez un adversaire. Le joueur choisi révèle chaque carte qu\'il pioche. Quand le joueur choisi pioche la carte nommée, sacrifiez le Piège explosif. Si vous faites ainsi, le Piège explosif inflige 10 blessures à ce joueur.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98112&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74d2f8cd-c5e6-4bef-ac60-f330b5e9457e\', \'multiverseId\': 98112}, \'multiverseid\': 98112}, {\'name\': \'Trappola Esplosiva\', \'text\': \'Mentre la Trappola Esplosiva entra in gioco, nomina una carta diversa da una carta terra base e scegli un avversario. Il giocatore scelto rivela ogni carta che pesca. Quando il giocatore scelto pesca la carta nominata, sacrifica la Trappola Esplosiva. Se lo fai, la Trappola Esplosiva infligge 10 danni a quel giocatore.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98832&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'be6197be-f0f8-4771-98bd-1e27b681620b\', \'multiverseId\': 98832}, \'multiverseid\': 98832}, {\'name\': \'ブービートラップ\', \'text\': \'ブービートラップが場に出るに際し、基本土地でないカードを１つ指定し、対戦相手を１人選ぶ。 選ばれたプレイヤーは、自分が引く各カードを公開する。 選ばれたプレイヤーが指定されたカードを引いたとき、ブービートラップを生け贄に捧げる。 そうした場合、ブービートラップはそのプレイヤーに10点のダメージを与える。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99192&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c14e6adf-a136-44f8-81f3-9fb84041b743\', \'multiverseId\': 99192}, \'multiverseid\': 99192}, {\'name\': \'Armadilha Escondida\', \'text\': \'Conforme Armadilha Escondida entra em jogo, nomeie um card que não seja um terreno básico e escolha um oponente. O jogador escolhido revela cada card que ele próprio comprar. Quando o jogador escolhido comprar o card nomeado, sacrifique Armadilha Escondida. Se o fizer, Armadilha Escondida causa 10 pontos de dano àquele jogador.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99552&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e577fd8e-71f7-420f-8b63-e66605d91b0f\', \'multiverseId\': 99552}, \'multiverseid\': 99552}, {\'name\': \'Ловушка\', \'text\': \'Как только Ловушка вступает в игру, назовите карту (но не карту базовой земли) и оппонента.\\nУказанный игрок показывает каждую карту, которую он берет.\\nКогда указанный игрок возьмет названную карту, принесите Ловушку в жертву. Если вы сделаете это, ловушка нанесет 10 повреждений указанному игроку.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109823&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c9d2e5ad-549f-4587-9d4a-03b1243b9811\', \'multiverseId\': 109823}, \'multiverseid\': 109823}, {\'name\': \'诡雷\', \'text\': \'于诡雷进场时，说出一个基本地之外的牌名，并选择一位对手。 该牌手每次抓牌时，都必须展示所抓的牌。 当该牌手抓到该名称的牌时，牺牲诡雷。 若你如此作，则诡雷对该牌手造成10点伤害。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97752&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cefb5f91-d576-4772-8af9-35061ce74930\', \'multiverseId\': 97752}, \'multiverseid\': 97752}]', '[{\'name\': \'Mogg-Wachposten\', \'text\': \'Immer wenn ein Gegner einen Zauberspruch spielt, erhält der Mogg-Wachposten +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Nichts ärgert einen Mogg mehr, als aufwachen zu müssen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98626&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7b6308b9-146f-4f5d-89ba-daf6c1bae534\', \'multiverseId\': 98626}, \'multiverseid\': 98626}, {\'name\': \'Centinela mogg\', \'text\': \'Siempre que un oponente juegue un hechizo, el Centinela mogg obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Nada enoja tanto a un mogg como tener que despertarse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100066&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8995d9c8-74cd-4baf-ae59-45dde3f9c64b\', \'multiverseId\': 100066}, \'multiverseid\': 100066}, {\'name\': \'Sentinelle mogg\', \'text\': "À chaque fois qu\'un adversaire joue un sort, la Sentinelle mogg gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "N\'offrez jamais au mogg un café.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98266&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22e3a025-c2bc-491c-879d-0ddfe34dfd8c\', \'multiverseId\': 98266}, \'multiverseid\': 98266}, {\'name\': \'Sentinella Mogg\', \'text\': \'Ogniqualvolta un avversario gioca una magia, la Sentinella Mogg prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Niente rende più furioso un mogg del fatto di doversi svegliare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98986&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dcc99efe-ceaa-40b7-b190-d3c459c9aeb3\', \'multiverseId\': 98986}, \'multiverseid\': 98986}, {\'name\': \'モグの歩哨\', \'text\': \'いずれかの対戦相手が呪文をプレイするたび、モグの歩哨はターン終了時まで+2/+2の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'モグを怒らせるには、起こすのが一番だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99346&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8060f3ee-1c81-4cbf-aefa-a1c0fe96c9e0\', \'multiverseId\': 99346}, \'multiverseid\': 99346}, {\'name\': \'Sentinela Mogg\', \'text\': \'Toda vez que um oponente jogar uma mágica, Sentinela Mogg recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Guerreiro Goblin\', \'flavor\': \'Nada deixa um mogg mais furioso do que ter que acordar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99706&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab802276-16c7-4979-8c35-8ccd1beaac6c\', \'multiverseId\': 99706}, \'multiverseid\': 99706}, {\'name\': \'Могг-страж\', \'text\': \'Каждый раз, когда оппонент разыгрывает заклинание, Могг-страж получает +2/+2 до конца хода.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Если вы разбудите могга, он впадет в бешенство.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109977&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b4dda19-707c-47f5-9564-3b452f411215\', \'multiverseId\': 109977}, \'multiverseid\': 109977}, {\'name\': \'莫葛哨兵\', \'text\': \'每当对手使用咒语时，莫葛哨兵得+2/+2直到回合结束。\', \'type\': \'生物～精灵／战士\', \'flavor\': \'莫葛最恨被叫醒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97906&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02986dd2-43ed-44e0-b9de-5809b2b086ba\', \'multiverseId\': 97906}, \'multiverseid\': 97906}]', '[{\'name\': \'Muse des Samenflugs\', \'text\': \'Enttappe während der Enttappsegmente aller anderen Spieler alle bleibenden Karten, die du kontrollierst.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Ihre Stimme ist die der Wildnis, ungezähmt und rein." —Kamahl, Druidennovize\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98702&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac8db888-58e4-48dd-9ff4-7cabb3d872d1\', \'multiverseId\': 98702}, \'multiverseid\': 98702}, {\'name\': \'Musa nacida de la semilla\', \'text\': \'Durante el paso de enderezar de cada uno de los demás jugadores, enderezas todos los permanentes que controles.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"Su voz es naturaleza, salvaje y pura". —Kamahl, acólito druida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100142&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90822d93-72c2-4f02-8880-8847e63fd38f\', \'multiverseId\': 100142}, \'multiverseid\': 100142}, {\'name\': \'Muse née des graines\', \'text\': "Dégagez tous les permanents que vous contrôlez pendant l\'étape de dégagement de chaque autre joueur.", \'type\': \'Créature : esprit\', \'flavor\': \'« Sa voix est celle de la forêt, sauvage et pure. » —Kamahl, acolyte druide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98342&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b9c6a95a-8fa8-43a4-b6d4-58b8817c49c9\', \'multiverseId\': 98342}, \'multiverseid\': 98342}, {\'name\': \'Musa Semigena\', \'text\': \'STAPpa tutti i permanenti che controlli durante lo STAP di ogni altro giocatore.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"La sua voce è selvaggia, indomita e pura." —Kamahl, accolito druido\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e57d1999-bcb9-457b-a5a1-0c825e95e350\', \'multiverseId\': 99062}, \'multiverseid\': 99062}, {\'name\': \'種子生まれの詩神\', \'text\': \'他のプレイヤーのアンタップ・ステップに、あなたがコントロールするすべてのパーマネントをアンタップする。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'彼女の声は、野生であり獰猛であり純真だ。 ――ドルイドの見習いカマール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99422&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'162b9479-565f-4e83-931f-f2b9f386fe27\', \'multiverseId\': 99422}, \'multiverseid\': 99422}, {\'name\': \'Musa Nascida da Semente\', \'text\': \'Desvira todas as permanentes que você controla durante a etapa de desvirar de cada um dos outros jogadores.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"Sua voz é a natureza, selvagem e pura." — Kamahl, acólito druida\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99782&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a19d6364-97bc-405e-9f6b-4c25e83ad5a0\', \'multiverseId\': 99782}, \'multiverseid\': 99782}, {\'name\': \'Муза, рожденная из семени\', \'text\': \'Разверните все перманенты, которых вы контролируете, во время этапа разворота каждого из игроков.\', \'type\': \'Существо — Дух\', \'flavor\': \'"Ее голос голос дикой природы, неприрученной и неоскверненной." — Камал, священник друидов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110053&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2f32c1e0-0ce3-4d32-9f61-367bf9a36873\', \'multiverseId\': 110053}, \'multiverseid\': 110053}, {\'name\': \'苗生谬思\', \'text\': \'在其它牌手的重置步骤中，重置所有由你操控的永久物。\', \'type\': \'生物～精怪\', \'flavor\': \'「她的声音蕴含野性，不羁而纯净。」 ～德鲁伊侍僧卡马尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97982&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'37f47876-f09c-4ac2-a626-56bc35ae4c71\', \'multiverseId\': 97982}, \'multiverseid\': 97982}]', '[{\'name\': \'Mühlstein\', \'text\': \'{2}, {T}: Ein Spieler deiner Wahl legt die obersten beiden Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Artefakt\', \'flavor\': \'Das Geräusch des unablässigen Mahlens des Mühlsteins hat schon mehr als einen Magier in den Wahnsinn getrieben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98622&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3a911170-e6c0-441c-b8ef-65c5bdb8b37a\', \'multiverseId\': 98622}, \'multiverseid\': 98622}, {\'name\': \'Rueda de molino\', \'text\': \'{2}, {T}: El jugador objetivo pone las dos primeras cartas de su biblioteca en su cementerio .\', \'type\': \'Artefacto\', \'flavor\': \'Más de un mago se ha vuelto loco por el sonido de la rueda de molino triturando inexorablemente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100062&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'645bf11a-6d99-4084-a93b-66a51343a0ca\', \'multiverseId\': 100062}, \'multiverseid\': 100062}, {\'name\': \'Meule\', \'text\': \'{2}, {T} : Le joueur ciblé met dans son cimetière les deux cartes du dessus de sa bibliothèque.\', \'type\': \'Artefact\', \'flavor\': "Plus d\'un mage a été rendu fou par le bruit implacable de la meule, grinçant sans trêve ni repos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98262&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8f23ca02-bda9-47f1-a717-3a17c59c85c5\', \'multiverseId\': 98262}, \'multiverseid\': 98262}, {\'name\': \'Pietra da Macina Magica\', \'text\': \'{2}, {T}: Il giocatore bersaglio mette nel proprio cimitero le prime due carte del proprio grimorio.\', \'type\': \'Artefatto\', \'flavor\': \'Più di un mago è impazzito al suono della macina che pressa inesorabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98982&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d66193d5-b264-47e1-b64d-240d14394096\', \'multiverseId\': 98982}, \'multiverseid\': 98982}, {\'name\': \'石臼\', \'text\': \'{2}, {T}：プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上のカード２枚を自分の墓地に置く。\', \'type\': \'アーティファクト\', \'flavor\': \'ひとりならぬ魔術師が、石臼の無慈悲な挽き音によって狂気に追いやられた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99342&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f871e26c-6059-4e53-858c-a466b2ebff9e\', \'multiverseId\': 99342}, \'multiverseid\': 99342}, {\'name\': \'Mó\', \'text\': \'{2}, {T}: O jogador alvo coloca os dois cards do topo de seu próprio grimório em seu próprio cemitério.\', \'type\': \'Artefato\', \'flavor\': \'Vários magos enlouqueceram com o incessante ranger da mó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99702&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4cda067f-9b59-44b3-8855-9f2a24624e9a\', \'multiverseId\': 99702}, \'multiverseid\': 99702}, {\'name\': \'Мельничный жернов\', \'text\': \'{2}, {T}: Целевой игрок перемещает две верхних карты из своей библиотеки на кладбище.\', \'type\': \'Артефакт\', \'flavor\': \'Не одного мага свел с ума звук мельничных жерновов, бесконечно трущихся друг о друга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109973&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d7e358ce-bb0b-4a8f-bc28-b2459ff625b4\', \'multiverseId\': 109973}, \'multiverseid\': 109973}, {\'name\': \'研磨石轮\', \'text\': \'{2}，{T}：目标牌手将其牌库顶的两张牌置入其坟墓场。\', \'type\': \'神器\', \'flavor\': \'石轮日夜不息地转动，所发出的恐怖声响将许多法师逼得发狂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97902&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5da6369-f7a9-4a84-890d-67b87cb564fa\', \'multiverseId\': 97902}, \'multiverseid\': 97902}]', '[{\'name\': \'Nachtmahr\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nStärke und Widerstandskraft des Nachtmahrs sind gleich der Anzahl der Sümpfe, die du kontrollierst.\', \'type\': \'Kreatur — Nachtmahr\', \'flavor\': \'Der Donner seiner Hufe verwandelt Träume in Verzweiflung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98638&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9616250-d559-4541-97ed-e1a6823f325a\', \'multiverseId\': 98638}, \'multiverseid\': 98638}, {\'name\': \'Pesadilla\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nTanto la fuerza como la resistencia de la Pesadilla son iguales al número de pantanos que controles.\', \'type\': \'Criatura — Pesadilla\', \'flavor\': \'El estruendo de sus cascos pisa los sueños hasta convertirlos en desesperación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100078&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24ae3713-7554-413f-b77f-087ab253a2d4\', \'multiverseId\': 100078}, \'multiverseid\': 100078}, {\'name\': \'Cheval de cauchemar\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nLe Cheval de cauchemar a une force et une endurance chacune égale au nombre de marais que vous contrôlez.\', \'type\': \'Créature : cheval de cauchemar\', \'flavor\': \'« Cauchemars entrevus dans le sommeil sans bornes, Sirènes aux seins nus, mélusines, licornes (…) » —Victor Hugo, La Légende des siècles\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98278&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f6c0bdd-c648-495e-9055-038e7aaa57a3\', \'multiverseId\': 98278}, \'multiverseid\': 98278}, {\'name\': \'Incubo\', \'text\': "Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nLa forza e la costituzione dell\'Incubo sono pari ciascuna al numero di Paludi che controlli.", \'type\': \'Creatura — Incubo\', \'flavor\': \'Il rombo dei suoi zoccoli trasforma i sogni in disperazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98998&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef62504c-babd-4866-9695-7b0dfb485e4d\', \'multiverseId\': 98998}, \'multiverseid\': 98998}, {\'name\': \'夢魔\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n夢魔のパワーとタフネスは、それぞれあなたがコントロールする沼の総数に等しい。\', \'type\': \'クリーチャー — ナイトメア\', \'flavor\': \'その蹄の響きは、夢を絶望に変えてしまう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99358&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'96abce4d-10b2-4080-83f0-7ac1ded4bed0\', \'multiverseId\': 99358}, \'multiverseid\': 99358}, {\'name\': \'Pesadelo\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nO poder e a resistência de Pesadelo são ambos iguais ao número de Pântanos que você controla.\', \'type\': \'Criatura — Pesadelo\', \'flavor\': \'O ressoar de seus cascos leva os sonhos ao desespero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99718&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c03dd67a-0d0b-4f5f-ad88-968906a4dbfb\', \'multiverseId\': 99718}, \'multiverseid\': 99718}, {\'name\': \'Кошмар\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nСила и здоровье Кошмара равняются количеству Болот, которые вы контролируете.\', \'type\': \'Существо — Кошмар\', \'flavor\': \'От грохота его копыт добрые сны приходят в отчаяние.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109989&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7bc9c591-532b-46c4-9425-5ddba57f45f4\', \'multiverseId\': 109989}, \'multiverseid\': 109989}, {\'name\': \'梦魇\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n梦魇的力量及防御力各等同于由你操控的沼泽之数量。\', \'type\': \'生物～梦魇\', \'flavor\': \'它的铁蹄巨响将梦击入绝境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97918&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'80479356-f4cb-4504-9d1a-ff9b4a75318d\', \'multiverseId\': 97918}, \'multiverseid\': 97918}]', '[{\'name\': \'Nantukohülle\', \'text\': \'Opfere eine Kreatur: Die Nantukohülle erhält +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zombie, Insekt\', \'flavor\': \'Die Seele spendet Licht, der Tod ist ihr Schatten. Wenn das Licht erlischt, begegnen sich Leben und Tod. —Lehre der Nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98632&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3944d6a7-8a24-44be-a1a2-854e59bc1a4f\', \'multiverseId\': 98632}, \'multiverseid\': 98632}, {\'name\': \'Caparazón nantuko\', \'text\': \'Sacrificar una criatura: El Caparazón nantuko obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Insecto zombie\', \'flavor\': \'El alma emite luz y la muerte es su sombra. Cuando la luz se atenúa, la vida y la muerte se abrazan. —Enseñanza nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100072&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'610c0b39-7d38-44c6-8ed5-b7f3a03cf201\', \'multiverseId\': 100072}, \'multiverseid\': 100072}, {\'name\': \'Carapace de nantuko\', \'text\': "Sacrifiez une créature : La Carapace de nantuko gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : zombie et insecte\', \'flavor\': "L\'âme libère de la lumière, et la mort est son ombre. Quand la lumière s\'éteint, vie et mort s\'étreignent. —Enseignement nantuko", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98272&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3fdfdaf-0416-4d6b-ba13-fa22348e03b7\', \'multiverseId\': 98272}, \'multiverseid\': 98272}, {\'name\': \'Guscio Nantuko\', \'text\': \'Sacrifica una creatura: Il Guscio Nantuko prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Insetto Zombie\', \'flavor\': "L\'anima getta le proprie luci, la morte le proprie ombre. Quando la luce si attenua, la vita e la morte si incontrano. —Insegnamento nantuko", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98992&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1ead472c-2237-4cbb-876f-9b6a85050ad3\', \'multiverseId\': 98992}, \'multiverseid\': 98992}, {\'name\': \'ナントゥーコの鞘虫\', \'text\': \'クリーチャーを１体生け贄に捧げる：ナントゥーコの鞘虫は、ターン終了時まで+2/+2の修整を受ける。\', \'type\': \'クリーチャー — ゾンビ・昆虫\', \'flavor\': \'魂は光を投げかけ、死はその影となる。 光がかすれていくとき、生と死は一つになる。 ――ナントゥーコの教え\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99352&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c8c2b928-4377-4268-8914-2e3d8e3b2f13\', \'multiverseId\': 99352}, \'multiverseid\': 99352}, {\'name\': \'Folhelho Nantuko\', \'text\': \'Sacrifique uma criatura: Folhelho Nantuko recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Inseto Zumbi\', \'flavor\': \'A alma esparze luz e a morte é sua sombra. Quando obscurece-se a luz, vida e morte abraçam-se. — Ensinamento dos nantukos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99712&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89720f96-f636-4ee1-bf06-b3c9fdcb22fb\', \'multiverseId\': 99712}, \'multiverseid\': 99712}, {\'name\': \'Оболочка нантуко\', \'text\': \'Принесите в жертву существо: Оболочка нантуко получает +2/+2 до конца хода.\', \'type\': \'Существо — Зомби Насекомое\', \'flavor\': \'Душа заслоняет свет, а смерть это ее тень. Когда свет тускнеет, жизнь и смерть сливаются в объятиях. — Уроки нантуко\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109983&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f38fd223-bd08-4fb8-b00d-db0511b64c7a\', \'multiverseId\': 109983}, \'multiverseid\': 109983}, {\'name\': \'空壳螳人\', \'text\': \'牺牲一个生物：空壳螳人得+2/+2直到回合结束。\', \'type\': \'生物～灵俑／昆虫\', \'flavor\': \'灵魂发散光芒，死亡为其暗影。 光芒渐微之时，生与死终结合。 ～螳人教诲\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97912&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'26af0a64-a101-4ac9-baf5-eaf96eada3d3\', \'multiverseId\': 97912}, \'multiverseid\': 97912}]', '[{\'name\': \'Narrenkappe\', \'text\': \'{2}, {T}, opfere die Narrenkappe: Durchsuche die Bibliothek eines Spieler deiner Wahl nach drei Karten und entferne diese ganz aus dem Spiel. Dieser Spieler mischt dann seine Bibliothek.\', \'type\': \'Artefakt\', \'flavor\': \'„Manche Narren tragen auch einen spitzen Hut." —Arcum Dagsson, Soldevischer Maschinist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98591&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff38d1d4-e1e6-4b84-b300-7d0f1e4430c6\', \'multiverseId\': 98591}, \'multiverseid\': 98591}, {\'name\': \'Gorro de bufón\', \'text\': \'{2}, {T}, sacrificar el Gorro de bufón: Busca en la biblioteca del jugador objetivo tres cartas y remuévelas del juego. Luego ese jugador baraja su biblioteca.\', \'type\': \'Artefacto\', \'flavor\': \'"Conoce las fortalezas de tus enemigos así como sus debilidades." —Arcum Dagsson, mecánico soldevi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100031&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ed02c10f-0679-4bfa-ae29-1867fc7164d1\', \'multiverseId\': 100031}, \'multiverseid\': 100031}, {\'name\': \'Bonnet du bouffon\', \'text\': \'{2}, {T}, Sacrifiez le Bonnet du bouffon : Cherchez trois cartes dans la bibliothèque du joueur ciblé et retirez-les de la partie. Ce joueur mélange ensuite sa bibliothèque.\', \'type\': \'Artefact\', \'flavor\': \'« Connais aussi bien les forces de tes ennemis que leurs faiblesses. » —Arcum Dagsson, machiniste soldevi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98231&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'385fef4d-2330-4f0e-8b48-78172cf9723e\', \'multiverseId\': 98231}, \'multiverseid\': 98231}, {\'name\': \'Cappello del Giullare\', \'text\': \'{2}, {T}, Sacrifica il Cappello del Giullare: Passa in rassegna il grimorio di un giocatore bersaglio, scegli tre carte e rimuovile dal gioco. Poi quel giocatore rimescola il proprio grimorio.\', \'type\': \'Artefatto\', \'flavor\': \'"Devi conoscere i punti di forza dei tuoi nemici così come le loro debolezze." —Arcum Dagsson, macchinista di Soldevi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98951&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eb41dae8-e17a-4f07-ac35-09c9ae5115a6\', \'multiverseId\': 98951}, \'multiverseid\': 98951}, {\'name\': \'道化の帽子\', \'text\': \'{2}, {T}, 道化の帽子を生け贄に捧げる：プレイヤー１人を対象とする。あなたはそのプレイヤーのライブラリーからカードを３枚探し、それらをゲームから取り除く。 その後、そのプレイヤーは自分のライブラリーを切り直す。\', \'type\': \'アーティファクト\', \'flavor\': \'敵の弱みだけでなく、強みも調べることだ。 ――ソルデヴィの機械魔術師、アーカム・ダグスン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99311&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd66dd70-28e0-470d-933d-ce4e361b4f0d\', \'multiverseId\': 99311}, \'multiverseid\': 99311}, {\'name\': \'Gorro do Bufão\', \'text\': \'{2}, {T}, Sacrifique Gorro do Bufão: Procure no grimório do jogador alvo por três cards e remova-os de jogo. Depois, aquele jogador embaralha seu próprio grimório.\', \'type\': \'Artefato\', \'flavor\': \'"Conhece tanto os pontos fortes, como as fraquezas dos teus oponentes." — Arcum Dagsson, maquinista Soldeviano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99671&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b134653-dc6a-4092-a4ca-b45d84b1f5c4\', \'multiverseId\': 99671}, \'multiverseid\': 99671}, {\'name\': \'Шутовской колпак\', \'text\': \'{2}, {T}, Принесите в жертву Шутовской колпак: выберите из библиотеки целевого игрока три карты и выведите их из игры. Затем целевой игрок тасует библиотеку.\', \'type\': \'Артефакт\', \'flavor\': \'"Изучайте и сильные стороны противника, и слабые его стороны". — Аркум Дагссон, сольдевский машинист\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109942&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b0c5a230-2302-410c-a316-08ac656545e5\', \'multiverseId\': 109942}, \'multiverseid\': 109942}, {\'name\': \'小丑帽\', \'text\': \'{2}，{T}，牺牲小丑帽：从目标对手的牌库中搜寻三张牌，并将它们移出对战。 然后该牌手将他的牌库洗牌。\', \'type\': \'神器\', \'flavor\': \'「要了解敌人的弱点，也要了解敌人的优点。」 ～索地威工匠阿肯．达格森\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97871&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3c8bb01-04de-4356-96e5-3fe124c3db7e\', \'multiverseId\': 97871}, \'multiverseid\': 97871}]', '[{\'name\': \'Naturalisieren\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Nun, man kann auch einen schönen Blumentopf daraus machen ..." —Arcum Dagsson, Soldevischer Maschinist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bf90de5c-91d6-4d1a-ae05-b030de868904\', \'multiverseId\': 98635}, \'multiverseid\': 98635}, {\'name\': \'Naturalizar\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Bueno, también podría ser un lindo florero. . . ." —Arcum Dagsson, mecánico soldevi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100075&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'21b1ae87-6358-4176-8bc5-072d2b1e77f3\', \'multiverseId\': 100075}, \'multiverseid\': 100075}, {\'name\': \'Naturalisation\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': "« Au moins, c\'est un joli pot de fleurs . . . » —Arcum Dagsson, machiniste soldevi", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98275&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a50bf0a5-9bb5-4fec-b2aa-ce5ea9d7ada6\', \'multiverseId\': 98275}, \'multiverseid\': 98275}, {\'name\': \'Ritorno alla Natura\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"E inoltre è anche un magnifico vaso per i fiori. . . ." —Arcum Dagsson, macchinista di Soldevi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98995&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1fa4473-7e28-43b7-a33b-5c740045c4cf\', \'multiverseId\': 98995}, \'multiverseid\': 98995}, {\'name\': \'帰化\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'まあ、なかなかの花瓶にはなるだろうな … … 。 ――ソルデヴィの機械魔術師、アーカム・ダグスン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99355&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6555e528-9528-4f07-a16f-5afa5b31fcb2\', \'multiverseId\': 99355}, \'multiverseid\': 99355}, {\'name\': \'Naturalizar\', \'text\': \'Destrói o artefato ou o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Bom, ele também serve como um lindo vaso de flores. . . ." — Arcum Dagsson, maquinista Soldeviano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99715&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2b6a80b4-9146-4362-8a4c-ccb70b541505\', \'multiverseId\': 99715}, \'multiverseid\': 99715}, {\'name\': \'Приживание\', \'text\': \'Уничтожьте целевой артефакт или чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Что же, из него выйдет неплохой цветочный горшок . . ." — Аркум Дагссон, сольдевский машинист\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109986&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c7984f93-9275-4cd6-95aa-45acfc78beda\', \'multiverseId\': 109986}, \'multiverseid\': 109986}, {\'name\': \'回归自然\', \'text\': \'消灭目标神器或结界。\', \'type\': \'瞬间\', \'flavor\': \'「嗯，还有个漂亮花瓶可用呢. . . .」 ～索地威工匠阿肯．达格森\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97915&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f0206006-31c6-4d0b-9986-de43afeda9b0\', \'multiverseId\': 97915}, \'multiverseid\': 97915}]', '[{\'name\': \'Naturgewalten\', \'text\': \'Verursacht Trampelschaden (Falls diese Kreatur ihren Blockern genug Schaden zufügen würde, um sie zu zerstören, kannst du sie den Rest des Schadens dem verteidigenden Spieler zufügen lassen.)\\nZu Beginn deines Versorgungssegments fügen dir die Naturgewalten 8 Schadenspunkte zu, falls du nicht {G}{G}{G}{G} bezahlst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98537&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ac70bf2-fc95-4d6b-b759-f8ab29aea582\', \'multiverseId\': 98537}, \'multiverseid\': 98537}, {\'name\': \'Fuerza de la naturaleza\', \'text\': \'Arrolla. (Si esta criatura fuera a hacer suficiente daño de combate a sus bloqueadores como para destruirlos, puedes hacer que le haga el resto del daño al jugador defensor.)\\nAl comienzo de tu mantenimiento, la Fuerza de la naturaleza te hace 8 puntos de daño a menos que pagues {G}{G}{G}{G}.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99977&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f64ee9c-2752-41a9-8180-bd24b8a14001\', \'multiverseId\': 99977}, \'multiverseid\': 99977}, {\'name\': \'Force de la Nature\', \'text\': "Piétinement (Si cette créature inflige suffisamment de blessures de combat à ses bloqueurs pour les détruire, vous pouvez faire qu\'elle inflige le reste de ses blessures au joueur défenseur.)\\nAu début de votre entretien, la Force de la Nature vous inflige 8 blessures à moins que vous ne payiez {G}{G}{G}{G}.", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98177&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'025afabc-ddeb-4c19-8794-eb7602df16c1\', \'multiverseId\': 98177}, \'multiverseid\': 98177}, {\'name\': \'Forza della Natura\', \'text\': "Travolgere (Se questa creatura infligge alle creature che la bloccano un ammontare di danni da combattimento sufficiente a distruggerle, puoi farle infliggere i danni rimanenti al giocatore in difesa.)\\nAll\'inizio del tuo mantenimento, la Forza della Natura ti infligge 8 danni a meno che tu spenda {G}{G}{G}{G}.", \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98897&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'94b93e6d-b8ac-46e8-920f-4fcc96939713\', \'multiverseId\': 98897}, \'multiverseid\': 98897}, {\'name\': \'大地の怒り\', \'text\': \'トランプル （このクリーチャーが、自身をブロックしているすべてのクリーチャーを破壊するのに十分な戦闘ダメージを与える場合、あなたはそれの残りのダメージを防御プレイヤーに与えてもよい。）\\nあなたのアップキープの開始時に、あなたが{G}{G}{G}{G}を支払わない限り、大地の怒りはあなたに８点のダメージを与える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99257&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'31e4e062-85e3-4436-9c56-330741e1c1b3\', \'multiverseId\': 99257}, \'multiverseid\': 99257}, {\'name\': \'Força da Natureza\', \'text\': \'Atropelar (Se esta criatura fosse causar dano de combate suficiente para destruir seus bloqueadores, você pode fazer com que ela cause o resto de seu dano ao jogador defensor.)\\nNo início de sua manutenção, Força da Natureza causa 8 pontos de dano a você a menos que você pague {G}{G}{G}{G}.\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99617&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a79db171-12e3-4fda-a558-09d9189b598a\', \'multiverseId\': 99617}, \'multiverseid\': 99617}, {\'name\': \'Сила природы\', \'text\': \'Пробивающий удар (Если это существо нанесло достаточно повреждений, чтобы уничтожить блокирующих, остальные повреждения оно может нанести обороняющемуся игроку).\\nВ начале этапа поддержки Сила природы наносят вам 8 повреждений, если вы не заплатите {G}{G}{G}{G}.\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109888&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3630aeed-a172-4ce1-a847-48495f82ae24\', \'multiverseId\': 109888}, \'multiverseid\': 109888}, {\'name\': \'万物元气兽\', \'text\': \'践踏（若此生物将造成的战斗伤害足以消灭所有阻挡它的生物，你可以使它对防御牌手造成所剩余数量的伤害）\\n在你的维持开始时，除非你支付{G}{G}{G}{G}，否则万物元气兽对你造成8点伤害。\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97817&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2a16f453-1d2b-46f7-926c-546420fff4e0\', \'multiverseId\': 97817}, \'multiverseid\': 97817}]', '[{\'name\': \'Natürliche Beziehung\', \'text\': \'Bis zum Ende des Zuges werden alle Länder zu 2/2 Kreaturen, die auch noch Länder sind.\', \'type\': \'Spontanzauber\', \'flavor\': \'Solange die Dryaden ein Teil des Waldes sind, ist der Wald ein Teil der Armee.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98633&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e78c7144-812a-4577-8768-81b05104918e\', \'multiverseId\': 98633}, \'multiverseid\': 98633}, {\'name\': \'Afinidad natural\', \'text\': \'Hasta el final del turno, todas las tierras son criaturas 2/2 que siguen siendo tierras.\', \'type\': \'Instantáneo\', \'flavor\': \'Mientras las dríadas sean parte del bosque, el bosque es parte del ejército.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100073&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f78e9db-0143-4583-980c-a646cac1213a\', \'multiverseId\': 100073}, \'multiverseid\': 100073}, {\'name\': \'Affinité naturelle\', \'text\': "Jusqu\'à la fin du tour, tous les terrains deviennent des créatures 2/2 qui sont toujours des terrains.", \'type\': \'Éphémère\', \'flavor\': "Tant que les dryades sont dans la forêt, la forêt est partie intégrante de l\'armée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98273&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e96ff1d-dac6-46ec-aabe-9393c115281f\', \'multiverseId\': 98273}, \'multiverseid\': 98273}, {\'name\': \'Affinità Naturale\', \'text\': \'Fino alla fine del turno, tutte le terre diventano creature 2/2 che sono ancora terre.\', \'type\': \'Istantaneo\', \'flavor\': "Fintanto che le driadi sono parte della foresta, la foresta è parte dell\'esercito.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98993&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cc9c281d-1178-49e3-bf9f-071db3cd8f79\', \'multiverseId\': 98993}, \'multiverseid\': 98993}, {\'name\': \'自然の類似\', \'text\': \'ターン終了時まで、すべての土地は2/2のクリーチャーになる。それらは土地でもある。\', \'type\': \'インスタント\', \'flavor\': \'ドライアドが森の一部であるかぎり、森は軍隊の一部である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99353&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1787e0d2-8918-4040-81d9-5c395a7db787\', \'multiverseId\': 99353}, \'multiverseid\': 99353}, {\'name\': \'Afinidade Natural\', \'text\': \'Até o final do turno, todos os terrenos tornam-se criaturas 2/2 que ainda são terrenos.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Enquanto as dríades forem uma parte da floresta, a floresta será uma parte do exército.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99713&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3167a488-7f38-4b79-9891-57f3fcf34d9a\', \'multiverseId\': 99713}, \'multiverseid\': 99713}, {\'name\': \'Единение с природой\', \'text\': \'До конца хода все земли становятся существами со значением силы 2/2, оставаясь при этом землями.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Пока дриады не покинули лес, он тоже составляет часть армии.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109984&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6b22f690-b207-406c-b60f-aef4334cfb8f\', \'multiverseId\': 109984}, \'multiverseid\': 109984}, {\'name\': \'自然血缘\', \'text\': \'直到回合结束，所有地都成为2/2生物，且仍视为地。\', \'type\': \'瞬间\', \'flavor\': \'只要树灵仍是森林的一部份，森林就会是军队的一员。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97913&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d55349f2-6aab-4a90-9cf4-02ceb6ecb893\', \'multiverseId\': 97913}, \'multiverseid\': 97913}]', '[{\'name\': \'Natürliche Quelle\', \'text\': \'Ein Spieler deiner Wahl erhält 8 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Die Sterbenden bitten um Wasser, da sie wissen, dass es Leben enthält.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98634&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'face8651-9ac7-4103-b9a1-d7eccf75a962\', \'multiverseId\': 98634}, \'multiverseid\': 98634}, {\'name\': \'Manantial natural\', \'text\': \'El jugador objetivo gana 8 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'Los moribundos piden agua porque saben que contiene vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100074&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad7868ee-cf79-44c9-ae0d-f6234c42a534\', \'multiverseId\': 100074}, \'multiverseid\': 100074}, {\'name\': \'Source naturelle\', \'text\': \'Le joueur ciblé gagne 8 points de vie.\', \'type\': \'Rituel\', \'flavor\': "Les mourants réclament de l\'eau parce qu\'ils savent qu\'elle contient la vie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98274&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29827c13-4f67-4aa9-9836-ce01b0299f62\', \'multiverseId\': 98274}, \'multiverseid\': 98274}, {\'name\': \'Sorgente Naturale\', \'text\': \'Il giocatore bersaglio guadagna 8 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': "Chi sta per morire chiede l\'acqua poiché sa che contiene la vita.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'42a0f67e-0f2b-4aa1-819d-4d5cbae3fce5\', \'multiverseId\': 98994}, \'multiverseid\': 98994}, {\'name\': \'自然の泉\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは８点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'必死に水を求めるのは、そこに命があるからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99354&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47947362-f7d0-4069-94b9-199b611c6e5a\', \'multiverseId\': 99354}, \'multiverseid\': 99354}, {\'name\': \'Fonte Natural\', \'text\': \'O jogador alvo ganha 8 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'Os moribundos pedem por água porque sabem que ela contém vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99714&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01719605-1ee8-4544-bc45-7dbe7608b73e\', \'multiverseId\': 99714}, \'multiverseid\': 99714}, {\'name\': \'Природный источник\', \'text\': \'Целевой игрок получает 8 пунктов жизни.\', \'type\': \'Волшебство\', \'flavor\': \'Умирающий просит воды, потому что знает, что она несет жизнь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109985&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cf75fd21-18f4-4abe-9ed1-69d72de02b40\', \'multiverseId\': 109985}, \'multiverseid\': 109985}, {\'name\': \'天然泉水\', \'text\': \'目标牌手获得8点生命。\', \'type\': \'法术\', \'flavor\': \'濒死者总想喝水，因为知道里面蕴含着生命。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97914&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'26cdf4ec-a07f-4fde-9d9a-2170a2f1b089\', \'multiverseId\': 97914}, \'multiverseid\': 97914}]', '[{\'name\': \'Nekrataal\', \'text\': \'Erstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\\nWenn der Nekrataal ins Spiel kommt, zerstöre eine nichtschwarze Nichtartefaktkreatur deiner Wahl. Diese Kreatur kann nicht regeneriert werden.\', \'type\': \'Kreatur — Mensch, Assassine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98637&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e9e903d-4c93-432e-82b6-a5122759cca3\', \'multiverseId\': 98637}, \'multiverseid\': 98637}, {\'name\': \'Nekrataal\', \'text\': \'Daña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\\nCuando el Nekrataal entre en juego, destruye la criatura objetivo que no sea artefacto y que no sea negra. Esa criatura no puede ser regenerada.\', \'type\': \'Criatura — Asesino humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100077&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0315a2eb-70a1-48c5-bc56-73ed51a7e8e9\', \'multiverseId\': 100077}, \'multiverseid\': 100077}, {\'name\': \'Nékrataal\', \'text\': "Initiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)\\nQuand le Nékrataal arrive en jeu, détruisez la créature non-artefact, non-noire ciblée. Cette créature ne peut pas être régénérée.", \'type\': \'Créature : humain et assassin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98277&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1f4ac76c-1382-422a-b072-37587d32aa82\', \'multiverseId\': 98277}, \'multiverseid\': 98277}, {\'name\': \'Nekrataal\', \'text\': \'Attacco improvviso (Questa creatura infligge il danno da combattimento prima delle creature senza attacco improvviso.)\\nQuando il Nekrataal entra in gioco, distruggi una creatura bersaglio non artefatto, non nera. Quella creatura non può essere rigenerata.\', \'type\': \'Creatura — Assassino Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98997&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7e36a28-be59-4f61-ba65-667e4e8ba403\', \'multiverseId\': 98997}, \'multiverseid\': 98997}, {\'name\': \'ネクラタル\', \'text\': \'先制攻撃 （このクリーチャーは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\\nネクラタルが場に出たとき、アーティファクトでも黒でもないクリーチャー１体を対象とし、それを破壊する。 そのクリーチャーは再生できない。\', \'type\': \'クリーチャー — 人間・暗殺者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99357&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19fc0acd-26dd-4a81-8e11-5e4c1cea8c19\', \'multiverseId\': 99357}, \'multiverseid\': 99357}, {\'name\': \'Nekrataal\', \'text\': \'Iniciativa (Esta criatura causa dano de combate antes de criaturas sem a habilidade de iniciativa.)\\nQuando Nekrataal entra em jogo, destrói a criatura alvo que não seja preta nem artefato. Aquela criatura não pode ser regenerada.\', \'type\': \'Criatura — Assassino Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99717&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e3e603a-488f-4040-a848-0b1b4fc91af7\', \'multiverseId\': 99717}, \'multiverseid\': 99717}, {\'name\': \'Некраталь\', \'text\': \'Первый удар (Это существо наносит боевые повреждения раньше существ без способности первого удара).\\nКогда Некраталь вступает в игру, уничтожьте целевое неартефактное нечерное существо. Это существо не может быть регенерировано.\', \'type\': \'Существо — Человек Убийца\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109988&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'188fe36c-4956-41ae-835c-3665f3af4b60\', \'multiverseId\': 109988}, \'multiverseid\': 109988}, {\'name\': \'尼可拉塔\', \'text\': \'先攻（此生物会比不具先攻异能的生物提前造成战斗伤害。）\\n当尼可拉塔进场时，消灭目标非神器且非黑色的生物。 该生物不能重生。\', \'type\': \'生物～人类／杀手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97917&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac5ede43-f820-4c5c-9b4e-ccc085a03d4c\', \'multiverseId\': 97917}, \'multiverseid\': 97917}]', '[{\'name\': \'Neuer Anspruch\', \'text\': \'Lege eine Karte deiner Wahl aus deinem Friedhof oben auf deine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wer weise ist, achtet genauso auf das, was er wegschmeißt, wie auf das, was er behält.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98673&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'753f1172-7295-4374-a731-68d7b209a352\', \'multiverseId\': 98673}, \'multiverseid\': 98673}, {\'name\': \'Recobrar\', \'text\': \'Pon la carta objetivo de tu cementerio en la parte superior de tu biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'Los sabios le prestan tanta atención a lo que tiran como a lo que guardan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100113&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1c3f35fa-d0c2-40cf-bc4e-a80a655128f4\', \'multiverseId\': 100113}, \'multiverseid\': 100113}, {\'name\': \'Récupération\', \'text\': \'Mettez la carte ciblée en provenance de votre cimetière au-dessus de votre bibliothèque.\', \'type\': \'Éphémère\', \'flavor\': "Les sages ont autant de respect pour ce qu\'ils jettent que pour ce qu\'ils gardent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d885093-3e8f-46e0-9de0-2845dc00b26e\', \'multiverseId\': 98313}, \'multiverseid\': 98313}, {\'name\': \'Riciclare\', \'text\': \'Metti in cima al tuo grimorio una carta bersaglio dal tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'Colui che è saggio presta molta attenzione sia a ciò che butta, sia a ciò che tiene.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4043d6f3-c3d6-4f85-949a-ea9325613aa8\', \'multiverseId\': 99033}, \'multiverseid\': 99033}, {\'name\': \'回収\', \'text\': \'あなたの墓地にあるカード１枚を対象とし、それをあなたのライブラリーの一番上に置く。\', \'type\': \'インスタント\', \'flavor\': \'賢者は、とっておく物に注意を払うのと同じように、捨てる物にも注意を払う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99393&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1e3b5fd6-d083-4085-be51-9ad727b3d6cb\', \'multiverseId\': 99393}, \'multiverseid\': 99393}, {\'name\': \'Restituir\', \'text\': \'Coloque o card alvo de seu cemitério no topo de seu grimório.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os sábios prestam tanta atenção ao que jogam fora como ao que guardam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01214bdc-abf7-4342-8357-bb601de0d29d\', \'multiverseId\': 99753}, \'multiverseid\': 99753}, {\'name\': \'Отказ\', \'text\': \'Поместите целевую карту с кладбища в библиотеку сверху.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Мудрец в равной степени уделяет внимание тому, что он выбрасывает, и тому, что он оставляет.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110024&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9732e3cc-acc9-4027-8937-57dc9488c13b\', \'multiverseId\': 110024}, \'multiverseid\': 110024}, {\'name\': \'再利用\', \'text\': \'将目标牌从你坟墓场置于你的牌库顶。\', \'type\': \'瞬间\', \'flavor\': \'在必须舍弃的事物上，智者投注了和值得保有的事物同等的心力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97953&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0a77c5ee-751c-4621-99bf-37ebfc426a55\', \'multiverseId\': 97953}, \'multiverseid\': 97953}]', '[{\'name\': \'Norwaldläufer\', \'type\': \'Kreatur — Elf, Späher\', \'flavor\': \'Die Melodie des Waldes ist in perfekter Harmonie. Stimmt auch nur der leiseste Ton nicht, werden die Elfen die Ursache dafür finden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98639&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a51a15a3-2fb0-4cc3-a14a-248264169d20\', \'multiverseId\': 98639}, \'multiverseid\': 98639}, {\'name\': \'Guardabosque de Norwood\', \'type\': \'Criatura — Explorador elfo\', \'flavor\': \'La canción del bosque está en perfecta armonía. Si una sola nota está fuera de lugar, los elfos encontrarán su fuente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100079&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'efdf4d9f-651d-4ad3-9771-1ab4a113adbd\', \'multiverseId\': 100079}, \'multiverseid\': 100079}, {\'name\': \'Ranger de Norbois\', \'type\': \'Créature : elfe et éclaireur\', \'flavor\': \'Le chant de la forêt est une parfaite harmonie, dans laquelle les elfes entendront la fausse note la plus discrète.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98279&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'84c3aec1-c4c5-481a-937a-7d7774be5fea\', \'multiverseId\': 98279}, \'multiverseid\': 98279}, {\'name\': \'Ranger di Norwood\', \'type\': \'Creatura — Esploratore Elfo\', \'flavor\': "La canzone della foresta è in perfetta armonia. Se ci dovesse essere una stonatura, gli elfi ne troverebbero l\'origine.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98999&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5819c0d9-f0c3-4a64-9f87-dc08461960fc\', \'multiverseId\': 98999}, \'multiverseid\': 98999}, {\'name\': \'ノーウッドのレインジャー\', \'type\': \'クリーチャー — エルフ・スカウト\', \'flavor\': \'森の歌は完璧な調和を奏でる。 それを乱す音があれば、エルフがその源を見つける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99359&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1d79e789-d2f2-4487-ac86-cee1f959edc4\', \'multiverseId\': 99359}, \'multiverseid\': 99359}, {\'name\': \'Patrulheiro de Norwood\', \'type\': \'Criatura — Batedor Elfo\', \'flavor\': \'A canção da floresta está em perfeita harmonia. Se uma única nota estiver fora do lugar, os elfos encontrarão sua fonte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99719&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e8aa2e79-9b2f-4845-a288-4a47a2d436c1\', \'multiverseId\': 99719}, \'multiverseid\': 99719}, {\'name\': \'Норвудский лесничий\', \'type\': \'Существо — Эльф Разведчик\', \'flavor\': \'Песнь леса совершенство гармонии. Если даже одна единственная нота не на месте, эльфы быстро отыщут ее источник.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109990&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'533bece7-ae00-4bf1-abc8-6abbeb770d52\', \'multiverseId\': 109990}, \'multiverseid\': 109990}, {\'name\': \'诺梧林护林兵\', \'type\': \'生物～地精／斥候\', \'flavor\': \'树林之歌和谐无比。 只要一个音符走调，地精都能找出源头。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97919&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c6c0a2e8-8ee3-40f3-9905-6174f4a19eb4\', \'multiverseId\': 97919}, \'multiverseid\': 97919}]', '[{\'name\': \'Ogerscherge\', \'text\': \'Der Ogerscherge kann nicht blocken.\', \'type\': \'Kreatur — Oger\', \'flavor\': "Drei kleine Goblins, die kochen \'nen Brei. Sie bekleckern einen Oger, da warn\'s nur noch zwei.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98640&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'abc0f78f-e556-428c-82e9-3dc5835ab399\', \'multiverseId\': 98640}, \'multiverseid\': 98640}, {\'name\': \'Capataz ogro\', \'text\': \'El Capataz ogro no puede bloquear.\', \'type\': \'Criatura — Ogro\', \'flavor\': \'Tres pequeños trasgos, disfrutando su bebida. Uno golpeó a un ogro, y sólo quedan dos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100080&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf2c5ec7-5e99-4636-8d72-fa1f70cf91a7\', \'multiverseId\': 100080}, \'multiverseid\': 100080}, {\'name\': \'Surveillant ogre\', \'text\': \'Le Surveillant ogre ne peut pas bloquer.\', \'type\': \'Créature : ogre\', \'flavor\': "Trois petits gobelins s\'en allèrent se soûler. L\'un d\'eux bouscula un ogre, et il n\'en resta plus que deux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98280&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1111d69c-8557-46f1-a6f5-49815b17ea5a\', \'multiverseId\': 98280}, \'multiverseid\': 98280}, {\'name\': \'Sorvegliante Ogre\', \'text\': \'Il Sorvegliante Ogre non può bloccare.\', \'type\': \'Creatura — Ogre\', \'flavor\': \'Tre piccoli goblin si godevano la loro birra. Uno andò a sbattere contro un ogre e così rimasero in due.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99000&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'daba8e36-8880-47a0-bea3-48da4062963b\', \'multiverseId\': 99000}, \'multiverseid\': 99000}, {\'name\': \'オーガの監督官\', \'text\': \'オーガの監督官はブロックに参加できない。\', \'type\': \'クリーチャー — オーガ\', \'flavor\': \'ゴブリン三匹、みな酒びたり。 オーガにかち合い、残るは二人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99360&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'560359e6-c879-4f81-a3c4-bc3d363c2e40\', \'multiverseId\': 99360}, \'multiverseid\': 99360}, {\'name\': \'Capataz Ogre\', \'text\': \'Capataz Ogre não pode bloquear.\', \'type\': \'Criatura — Ogre\', \'flavor\': \'Três goblinzinhos sua cerveja tomavam. Um esbarrou num ogre e depois só restaram dois.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99720&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f3650426-eba1-455a-b17f-d2792e38570d\', \'multiverseId\': 99720}, \'multiverseid\': 99720}, {\'name\': \'Огр-десятник\', \'text\': \'Огр-десятник не может блокировать.\', \'type\': \'Существо — Людоед\', \'flavor\': \'Эй, гоблин, пей пиво, покуда вас трое. Ударь людоеда и станет вас двое.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109991&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'395d7e16-9eb2-4fb3-9e0e-a30f57d2ad3e\', \'multiverseId\': 109991}, \'multiverseid\': 109991}, {\'name\': \'食人魔工头\', \'text\': \'食人魔工头不能进行阻挡。\', \'type\': \'生物～食人魔\', \'flavor\': \'三个精灵来饮酒， 工头撞见逃不久。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97920&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ed359b9-16b4-4eb2-8d65-176f2e7e7c35\', \'multiverseId\': 97920}, \'multiverseid\': 97920}]', '[{\'name\': \'Orden der heiligen Glocke\', \'type\': \'Kreatur — Mensch, Mönch\', \'flavor\': \'„Mein Bruder, es mag nun an der Zeit sein, die Glocke zu läuten und um Hilfe zu bitten."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98643&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4246198f-36c2-4364-9a05-0b8ad699f6ad\', \'multiverseId\': 98643}, \'multiverseid\': 98643}, {\'name\': \'Orden de la campana sagrada\', \'type\': \'Criatura — Monje humano\', \'flavor\': \'"Hermano, tal vez sea tiempo de sonar la campana y pedir ayuda."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100083&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5514c2a7-3a66-40aa-ba50-94636e8bda99\', \'multiverseId\': 100083}, \'multiverseid\': 100083}, {\'name\': \'Ordre de la Cloche sacrée\', \'type\': \'Créature : humain et moine\', \'flavor\': "« Mon frère, je pense qu\'il est temps de sonner la cloche et d\'appeler à l\'aide. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98283&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cb6f9ab3-80bf-4676-8f6b-c9bf90bcc2b3\', \'multiverseId\': 98283}, \'multiverseid\': 98283}, {\'name\': \'Ordine della Sacra Campana\', \'type\': \'Creatura — Monaco Umano\', \'flavor\': \'"Fratello, potrebbe essere il momento di suonare la campana e chiedere aiuto."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99003&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7211e77-9736-446d-9a09-fda597356bb7\', \'multiverseId\': 99003}, \'multiverseid\': 99003}, {\'name\': \'聖鐘の僧団\', \'type\': \'クリーチャー — 人間・モンク\', \'flavor\': \'同胞よ、今こそ鐘を鳴らし、助けを求めるときかもしれぬ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99363&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd4ccb0a-5b9a-4207-8be4-e26fa658c156\', \'multiverseId\': 99363}, \'multiverseid\': 99363}, {\'name\': \'Ordem do Sino Sagrado\', \'type\': \'Criatura — Monge Humano\', \'flavor\': \'"Meu irmão, talvez seja o momento de soar o sino e pedir ajuda."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99723&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11f4cc91-2189-4502-aae3-88aedc5eb724\', \'multiverseId\': 99723}, \'multiverseid\': 99723}, {\'name\': \'Орден Священного колокола\', \'type\': \'Существо — Человек Монах\', \'flavor\': \'"Брат мой, кажется, пришло время звонить в колокол и звать на помощь".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109994&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'157bddf8-d176-458c-8b4a-ee526164e513\', \'multiverseId\': 109994}, \'multiverseid\': 109994}, {\'name\': \'圣钟教士团\', \'type\': \'生物～人类／修行僧\', \'flavor\': \'「弟兄，是时候敲钟求援了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97923&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'94ed1a80-1cdf-4e7a-884e-04b67bf28965\', \'multiverseId\': 97923}, \'multiverseid\': 97923}]', '[{\'name\': \'Ork-Artillerie\', \'text\': \'{T}: Die Ork-Artillerie fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte und dir 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Ork, Krieger\', \'flavor\': \'Da Orks weder mathematisch noch sozial veranlagt sind, konnte ihnen der Nachteil eigener Verluste nie erklärt werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'07fda4d2-54e4-400c-9c70-340db6e4a200\', \'multiverseId\': 98642}, \'multiverseid\': 98642}, {\'name\': \'Artillería orca\', \'text\': \'{T}: La Artillería orca hace 2 puntos de daño a la criatura o jugador objetivo y 3 puntos de daño a ti.\', \'type\': \'Criatura — Guerrero orco\', \'flavor\': \'"¿Quieren matar a mis hombres? Pues dos pueden jugar ese juego." —General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100082&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c83fde29-caa7-4502-ab68-8e6342415880\', \'multiverseId\': 100082}, \'multiverseid\': 100082}, {\'name\': \'Artillerie orque\', \'text\': "{T} : L\'Artillerie orque inflige 2 blessures à une cible, créature ou joueur, et vous inflige 3 blessures.", \'type\': \'Créature : orque et guerrier\', \'flavor\': \'« Alors ils veulent tuer mes hommes ? Eh bien on peut être deux pour jouer à ce jeu-là » —Général Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98282&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b48f719-aa2d-496c-a964-f777f6a81fc3\', \'multiverseId\': 98282}, \'multiverseid\': 98282}, {\'name\': \'Artiglieria Orchesca\', \'text\': "{T}: L\'Artiglieria Orchesca infligge 2 danni a una creatura o a un giocatore bersaglio e 3 danni a te.", \'type\': \'Creatura — Guerriero Orco\', \'flavor\': \'"Vogliono uccidere i miei uomini? Beh, questo è un gioco che si può fare in due." —Generale Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99002&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e29416b1-d97f-4411-bfb9-fb0144a8efff\', \'multiverseId\': 99002}, \'multiverseid\': 99002}, {\'name\': \'オーク弩弓隊\', \'text\': \'{T}：クリーチャー１体かプレイヤー１人を対象とする。オーク弩弓隊はそれに２点のダメージを与え、あなたに３点のダメージを与える。\', \'type\': \'クリーチャー — オーク・戦士\', \'flavor\': \'奴らが俺の兵を殺したがってるって？ つき合ったろうじゃないか。 ――カーゾグ将軍\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99362&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9ad2f29-42bd-4286-91ce-690a54b46a87\', \'multiverseId\': 99362}, \'multiverseid\': 99362}, {\'name\': \'Artilharia Órquica\', \'text\': \'{T}: Artilharia Órquica causa 2 pontos de dano à criatura ou ao jogador alvo e 3 pontos de dano a você.\', \'type\': \'Criatura — Guerreiro Orc\', \'flavor\': \'"Então eles querem matar meus homens? Muito bem, então. Dois podem fazer esse jogo." — General Khurzog\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99722&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bbd00bd-ce07-466b-8be3-b8f75d30b751\', \'multiverseId\': 99722}, \'multiverseid\': 99722}, {\'name\': \'Артиллерия орков\', \'text\': \'{T}: Артиллерия орков наносит 2 повреждения целевому существу или игроку и 3 повреждения вам.\', \'type\': \'Существо — Орк Воин\', \'flavor\': \'"Так они хотят перебить моих людей? Что же, двое из них вполне могут попробовать". — Генерал Курцог\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109993&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'31df1aec-0b22-4e58-b46b-75a78a846fba\', \'multiverseId\': 109993}, \'multiverseid\': 109993}, {\'name\': \'半兽人的大炮\', \'text\': \'{T}：半兽人的大炮对目标生物或牌手造成2点伤害，并且对你造成3点伤害。\', \'type\': \'生物～半兽人／战士\', \'flavor\': \'「想宰我的部下？ 找两个人陪他们玩玩。」 ～喀左格将军\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97922&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2ec3cfda-7710-45f3-953c-8c01f4590455\', \'multiverseId\': 97922}, \'multiverseid\': 97922}]', '[{\'name\': \'Ornithopter\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Artefaktkreatur — Thopter\', \'flavor\': \'„Es war mir eine Ehre, den ursprünglichen Entwurf der Thran zu verbessern. Vielleicht wird mein Werk später ein wenig in die Geschichte eingehen." —Urza, als Lehrling\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98644&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e42c15b8-8298-4056-90f1-6b2606bae6b8\', \'multiverseId\': 98644}, \'multiverseid\': 98644}, {\'name\': \'Ornitóptero\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura artefacto — Tóptero\', \'flavor\': \'"Fue un honor para mí mejorar el diseño thran original. Tal vez la historia me recuerde en algún pequeño aspecto por mi trabajo." —Urza, durante su aprendizaje\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100084&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b81deb2f-dc39-4ab2-b5eb-8c58a3c4db90\', \'multiverseId\': 100084}, \'multiverseid\': 100084}, {\'name\': \'Ornithoptère\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature-artefact — mécanoptère\', \'flavor\': "« Ce fut un honneur d\'améliorer la conception thran originale. Peut-être l\'histoire gardera-t-elle une trace de mon travail ? » —Urza, pendant son apprentissage", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98284&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c53f2028-d93f-498b-b5c4-e48e9fa0f602\', \'multiverseId\': 98284}, \'multiverseid\': 98284}, {\'name\': \'Ornitottero\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura Artefatto — Tottero\', \'flavor\': \'"Ho avuto l\\\'onore di migliorare il progetto originale di Thran. Forse qualcosa di me rimarrà nella storia grazie al mio lavoro." —Urza, durante il proprio apprendistato\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99004&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4a416d31-504a-46f3-8613-eba4801572d2\', \'multiverseId\': 99004}, \'multiverseid\': 99004}, {\'name\': \'羽ばたき飛行機械\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'アーティファクト・クリーチャー — 飛行機械\', \'flavor\': \'スラン帝国の遺物の改良を任せていただき、これほど光栄なことはありません。 この業績によってわたしの名が歴史の片隅に残ることになれば、それは望外の幸せ。 ――徒弟時代のウルザ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99364&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efcc98ad-eb09-4b12-aece-dca05e0a69f0\', \'multiverseId\': 99364}, \'multiverseid\': 99364}, {\'name\': \'Ornitóptero\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura Artefato — Tóptero\', \'flavor\': \'"Tive a honra de fazer melhorias no projeto de Thran. Talvez a história me dê algum crédito pelo meu trabalho." — Urza, durante seu aprendizado\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99724&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d586aa83-a661-4289-93b3-b88185b41e39\', \'multiverseId\': 99724}, \'multiverseid\': 99724}, {\'name\': \'Орнитоптер\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Артефактное существо — Топтер\', \'flavor\': \'"Я гордился тем, что улучшил конструкцию Трана. Может хоть крупица моей работы останется в истории". — Урза, в ученичестве\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109995&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4e38d0ec-f904-4993-bc22-dc9d5f4556a5\', \'multiverseId\': 109995}, \'multiverseid\': 109995}, {\'name\': \'扑翼机\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'神器生物～振翼机\', \'flavor\': \'「能改良索蓝原始设计是我的荣幸。 也许历史会为我的成果记下一小笔功劳。」 ～学徒时期的克撒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97924&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5b0e0a2-3a52-4f64-bdd3-e8f1faaedb40\', \'multiverseId\': 97924}, \'multiverseid\': 97924}]', '[{\'name\': \'Paladin en-Vec\', \'text\': \'Erstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\\nSchutz vor Schwarz, Schutz vor Rot (Diese Kreatur kann von nichts Schwarzem oder Rotem geblockt oder als Ziel bestimmt werden, von ihm Schaden zugefügt bekommen oder von ihm verzaubert werden.)\', \'type\': \'Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98647&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'03bde810-fc02-4139-b190-d1d7e6664e9d\', \'multiverseId\': 98647}, \'multiverseid\': 98647}, {\'name\': \'Paladín en-Vec\', \'text\': \'Daña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\\nProtección contra negro, protección contra rojo. (Esta criatura no puede ser bloqueada, hecha objetivo, recibir daño de o ser encantada por nada negro o rojo.)\', \'type\': \'Criatura — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100087&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'423b14d8-cdb5-4293-b089-a5f6e22df080\', \'multiverseId\': 100087}, \'multiverseid\': 100087}, {\'name\': \'Paladin en-Vec\', \'text\': "Initiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)\\nProtection contre le noir, protection contre le rouge (Cette créature ne peut pas être bloquée, ciblée, blessée ou enchantée par une source noire ou rouge.)", \'type\': \'Créature : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98287&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6119948-6d7a-4d41-ac12-f8784b55b880\', \'multiverseId\': 98287}, \'multiverseid\': 98287}, {\'name\': \'Paladino en-Vec\', \'text\': \'Attacco improvviso (Questa creatura infligge il danno da combattimento prima delle creature senza attacco improvviso.)\\nProtezione dal nero, protezione dal rosso (Questa creatura non può essere bloccata, scelta come bersaglio, danneggiata o incantata da alcuna fonte nera o rossa.)\', \'type\': \'Creatura — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99007&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a6f30c3f-3798-483e-9a57-0f532a0c30a4\', \'multiverseId\': 99007}, \'multiverseid\': 99007}, {\'name\': \'ヴェクの聖騎士\', \'text\': \'先制攻撃 （このクリーチャーは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\\nプロテクション（黒）、プロテクション（赤） （このクリーチャーは、黒や赤の何かによって、ブロックされたり、対象になったり、ダメージを与えられたり、エンチャントされたりしない。）\', \'type\': \'クリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99367&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'527cd0ef-d58a-49ba-adcc-f6840347193d\', \'multiverseId\': 99367}, \'multiverseid\': 99367}, {\'name\': \'Paladino en-Vec\', \'text\': \'Iniciativa (Esta criatura causa dano de combate antes de criaturas sem a habilidade de iniciativa.)\\nProteção contra o preto, proteção contra o vermelho (Esta criatura não pode ser bloqueada, visada, sofrer dano, ou ser encantada por nada que seja preto ou vermelho.)\', \'type\': \'Criatura — Cavaleiro Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99727&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54e5b54b-c45d-4477-b7d3-8cdbefe00e30\', \'multiverseId\': 99727}, \'multiverseid\': 99727}, {\'name\': \'Паладин эн-Век\', \'text\': \'Первый удар (Это существо наносит боевые повреждения раньше существ без способности первого удара).\\nЗащита от черного, защита от красного (Ничто черное и красное не может блокировать, зачаровывать это существо, наносить ему повреждения и делать его своей целью).\', \'type\': \'Существо — Человек Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109998&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'092203ff-302d-4fb8-85e7-d2cd944c73cf\', \'multiverseId\': 109998}, \'multiverseid\': 109998}, {\'name\': \'维克族神圣武士\', \'text\': \'先攻（此生物会比不具先攻异能的生物提前造成战斗伤害。）\\n反黑保护，反红保护（此生物不能被任何黑色或红色的东西所阻挡，指定为目标，造成伤害，或是被结附）\', \'type\': \'生物～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97927&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'226dfb67-4971-4c12-a4b7-c46ccd7a284d\', \'multiverseId\': 97927}, \'multiverseid\': 97927}]', "[{'name': 'Panikanfall', 'text': 'Bis zu drei Kreaturen deiner Wahl können in diesem Zug nicht blocken.', 'type': 'Hexerei', 'flavor': 'Manchmal passiert es, dass alle gleichzeitig Hilfe holen gehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98648&type=card', 'language': 'German', 'identifiers': {'scryfallId': '36c69f1d-4526-4ed9-a61d-e3382ba707e9', 'multiverseId': 98648}, 'multiverseid': 98648}, {'name': 'Ataque de pánico', 'text': 'Hasta tres criaturas objetivo no pueden bloquear este turno.', 'type': 'Conjuro', 'flavor': 'A veces todos deciden ir por ayuda al mismo tiempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100088&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8b021bcf-0794-4199-879f-c6004bd0b9db', 'multiverseId': 100088}, 'multiverseid': 100088}, {'name': 'Attaque paniquante', 'text': 'Un maximum de trois créatures ciblées ne peuvent pas bloquer ce tour-ci.', 'type': 'Rituel', 'flavor': 'Pas tous à la fois', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98288&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c30faac4-89e6-48d7-b304-364e4c30e881', 'multiverseId': 98288}, 'multiverseid': 98288}, {'name': 'Attacco di Panico', 'text': 'Fino a tre creature bersaglio non possono bloccare in questo turno.', 'type': 'Stregoneria', 'flavor': 'A volte decidono tutti di andare a cercare aiuto nello stesso momento.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99008&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '455db5af-23b4-46f1-887d-f19f2d805a0e', 'multiverseId': 99008}, 'multiverseid': 99008}, {'name': '恐ろしき攻撃', 'text': 'クリーチャーを最大３体まで対象とする。それらはこのターン、ブロックに参加できない。', 'type': 'ソーサリー', 'flavor': 'ときどき、みんなが同時に助けを求めに行こうとするときがあるんだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99368&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9bdcceca-4292-4b57-9859-b00d322a0dbe', 'multiverseId': 99368}, 'multiverseid': 99368}, {'name': 'Ataque de Pânico', 'text': 'Até três criaturas alvo não podem bloquear neste turno.', 'type': 'Feitiço', 'flavor': 'Às vezes, todo mundo resolve ir pedir ajuda ao mesmo tempo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99728&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '68fafba9-9706-4b21-8f61-056a3030f4b4', 'multiverseId': 99728}, 'multiverseid': 99728}, {'name': 'Паника от атаки', 'text': 'От одного до трех существ лишаются возможности блокировать в этот ход.', 'type': 'Волшебство', 'flavor': 'Бывает так, что все решают прийти на помощь одновременно.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109999&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2ea4dce5-3f29-49a0-9ca5-fd10adbc4a45', 'multiverseId': 109999}, 'multiverseid': 109999}, {'name': '惊慌失措', 'text': '至多三个目标生物本回合不能进行阻挡。', 'type': '法术', 'flavor': '有时候人们会同时想去搬救兵。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97928&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5f0d1e3e-8ae4-429f-ba05-d84fe1c9457b', 'multiverseId': 97928}, 'multiverseid': 97928}]", "[{'name': 'Pazifismus', 'text': 'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur kann nicht angreifen oder blocken.', 'type': 'Verzauberung — Aura', 'flavor': 'Ein Friedlicher ist einer, der sich totschießen lässt, um zu beweisen, dass der andere der Aggressor gewesen ist.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98646&type=card', 'language': 'German', 'identifiers': {'scryfallId': '67b03569-4739-4907-b882-a06197a69e7b', 'multiverseId': 98646}, 'multiverseid': 98646}, {'name': 'Pacifismo', 'text': 'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada no puede atacar ni bloquear.', 'type': 'Encantamiento — Aura', 'flavor': 'Por primera vez en su vida, Grakk sintió ternura en su interior.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100086&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '59808e3a-7fe2-42ae-9f9d-719a3ce2bb44', 'multiverseId': 100086}, 'multiverseid': 100086}, {'name': 'Pacifisme', 'text': 'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée ne peut ni attaquer ni bloquer.', 'type': 'Enchantement : aura', 'flavor': 'Pour la première fois dans sa vie, Grakk sentit une douce chaleur se répandre en lui.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98286&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2316a6d0-9035-47b5-9f54-cb890b18d85f', 'multiverseId': 98286}, 'multiverseid': 98286}, {'name': 'Pacifismo', 'text': 'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata non può attaccare né bloccare.', 'type': 'Incantesimo — Aura', 'flavor': 'Per la prima volta nella propria vita, Grakk sentì una sensazione di calore e confusione dentro di sé.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99006&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd55ad145-c73d-4d05-983c-971bdf967269', 'multiverseId': 99006}, 'multiverseid': 99006}, {'name': '平和な心', 'text': 'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは、攻撃やブロックに参加できない。', 'type': 'エンチャント — オーラ', 'flavor': 'グラックは生まれて初めて、ほんわかふわふわした気持ちになった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99366&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cec5fdb5-86c9-4aa0-9cf0-0de1c9d0d63f', 'multiverseId': 99366}, 'multiverseid': 99366}, {'name': 'Pacifismo', 'text': 'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada não pode atacar nem bloquear.', 'type': 'Encantamento — Aura', 'flavor': 'Pela primeira vez na vida, Grakk sentiu-se aquecido e confuso por dentro.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99726&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '53c37e8e-a7e0-4152-8a86-5f5145c75d46', 'multiverseId': 99726}, 'multiverseid': 99726}, {'name': 'Пацифизм', 'text': 'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо не может нападать и блокировать.', 'type': 'Чары — Аура', 'flavor': 'Впервые в жизни Гракк с удивлением почувствовал что-то теплое внутри.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109997&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b5a4d633-07af-4617-80de-32b69be7f073', 'multiverseId': 109997}, 'multiverseid': 109997}, {'name': '和平主义', 'text': '生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物不能进行攻击或阻挡。', 'type': '结界～灵气', 'flavor': '在葛瑞克的一生中，这是他首次感到内心的温情与暖意。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97926&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7cbe4ad6-e12b-41e9-b5ed-905542fb75b9', 'multiverseId': 97926}, 'multiverseid': 97926}]", '[{\'name\': \'Peitschender Sturm\', \'text\': \'Der Peitschende Sturm fügt jeder fliegenden Kreatur 4 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'Wer jetzt keine Höhle hat, braucht auch nie wieder eine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98636&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'88ce933e-ff53-460b-a52b-04bb53514723\', \'multiverseId\': 98636}, \'multiverseid\': 98636}, {\'name\': \'Tormenta de púas\', \'text\': \'La Tormenta de púas hace 4 puntos de daño a cada criatura que tenga la habilidad de volar.\', \'type\': \'Conjuro\', \'flavor\': \'La lluvia cae como clavos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100076&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f4a3257-a7ce-4d7e-94a9-8f1f1fe452a4\', \'multiverseId\': 100076}, \'multiverseid\': 100076}, {\'name\': "Tempête d\'aiguilles", \'text\': "La Tempête d\'aiguilles inflige 4 blessures à chaque créature avec le vol.", \'type\': \'Rituel\', \'flavor\': \'Le martèlement de la pluie était insupportable.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98276&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ddc916e7-5622-4d05-a8a0-e1d096634ab2\', \'multiverseId\': 98276}, \'multiverseid\': 98276}, {\'name\': "Tempesta d\'Aghi", \'text\': "La Tempesta d\'Aghi infligge 4 danni a ogni creatura con volare.", \'type\': \'Stregoneria\', \'flavor\': \'Le gocce di pioggia si conficcano come chiodi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98996&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c08ea40-91c6-4adc-a7af-e6821bef1f5a\', \'multiverseId\': 98996}, \'multiverseid\': 98996}, {\'name\': \'針の嵐\', \'text\': \'針の嵐は、飛行を持つ各クリーチャーにそれぞれ４点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'釘のような雨が降りしきる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99356&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f0c3883-4521-47a9-ab90-3f001b66acd9\', \'multiverseId\': 99356}, \'multiverseid\': 99356}, {\'name\': \'Tempestade de Acúleos\', \'text\': \'Tempestade de Acúleos causa 4 pontos de dano a cada criatura com a habilidade de voar.\', \'type\': \'Feitiço\', \'flavor\': \'A chuva se crava como pregos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99716&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a4cc335-92b8-40cc-aced-6891aa464080\', \'multiverseId\': 99716}, \'multiverseid\': 99716}, {\'name\': \'Буря игл\', \'text\': \'Буря игл наносит 4 повреждения каждому существу со способностью полета.\', \'type\': \'Волшебство\', \'flavor\': \'Капли дождя впиваются в землю, словно гвозди.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109987&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7eed42dd-4a28-4d4d-9c35-9f0553cfdf67\', \'multiverseId\': 109987}, \'multiverseid\': 109987}, {\'name\': \'针刺风暴\', \'text\': \'针刺风暴对每个具飞行异能的生物各造成4点伤害。\', \'type\': \'法术\', \'flavor\': \'暴雨如钉般倾落而下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97916&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fdf9b423-ad07-407f-806b-ff499416d681\', \'multiverseId\': 97916}, \'multiverseid\': 97916}]', '[{\'name\': \'Peitschwebel\', \'text\': \'{R}: Eine Kreatur deiner Wahl erhält Eile bis zum Ende des Zuges. (Sie kann in diesem Zug angreifen.)\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Keldonische Soldaten lernen, sich schneller zu bewegen als die Peitsche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'04fe3652-f072-4140-88d7-f1970cbd6909\', \'multiverseId\': 98781}, \'multiverseid\': 98781}, {\'name\': \'Sargento del látigo\', \'text\': \'{R}: La criatura objetivo gana la habilidad de prisa hasta el final del turno. (Puede atacar este turno.)\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Los soldados keldon aprenden a moverse más rápido que el látigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100221&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e6434ff-93db-4053-b1a1-8156b41e09d6\', \'multiverseId\': 100221}, \'multiverseid\': 100221}, {\'name\': \'Sergent au fouet\', \'text\': "{R} : La créature ciblée acquiert la célérité jusqu\'à la fin du tour. (Elle peut attaquer ce tour-ci.)", \'type\': \'Créature : humain et soldat\', \'flavor\': \'Les soldats keldes apprennent à être plus rapides que le fouet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98421&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4415c4c-32f3-4331-a553-dc739d102e61\', \'multiverseId\': 98421}, \'multiverseid\': 98421}, {\'name\': \'Sergente Fustigatore\', \'text\': \'{R}: La creatura bersaglio guadagna rapidità fino alla fine del turno. (Può attaccare in questo turno.)\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'I soldati di Keld hanno imparato a muoversi più rapidamente della frusta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99141&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'85024ded-47c1-434f-9b33-4fb03bd00862\', \'multiverseId\': 99141}, \'multiverseid\': 99141}, {\'name\': \'鞭打ち兵長\', \'text\': \'{R}：クリーチャー１体を対象とする。それはターン終了時まで速攻を得る。 （それはこのターン攻撃に参加してもよい。）\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'ケルドの兵士たちは、鞭よりも素早く動くことを学ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99501&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'01173502-d62d-4153-8979-c2c38553eb04\', \'multiverseId\': 99501}, \'multiverseid\': 99501}, {\'name\': \'Sargento Açoitador\', \'text\': \'{R}: A criatura alvo ganha a habilidade de ímpeto até o final do turno. (Ela pode atacar neste turno.)\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'Os soldados Keldonianos aprendem a mover-se mais rápido que o chicote.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7669130b-925a-4584-9907-5bda9f520553\', \'multiverseId\': 99861}, \'multiverseid\': 99861}, {\'name\': \'Погоняющий сержант\', \'text\': \'{R}: Целевое существо получает способность ускорения до конца хода. (Оно может нападать в этот ход).\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Солдаты Келдона стали проворнее, чем хлыст.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110132&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1d2ac4ef-01bb-4310-9c2a-c51c4a27e569\', \'multiverseId\': 110132}, \'multiverseid\': 110132}, {\'name\': \'持鞭士官\', \'text\': \'{R}：目标生物获得敏捷异能直到回合结束。 （它此回合便可以攻击）\', \'type\': \'生物～人类／士兵\', \'flavor\': \'凯尔顿的士兵都学会比鞭子快。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98061&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e62a2a07-57a7-4059-8efb-281c1d416edd\', \'multiverseId\': 98061}, \'multiverseid\': 98061}]', '[{\'name\': \'Phantomkrieger\', \'text\': \'Der Phantomkrieger ist unblockbar.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'„Illusionen dienen als Ruhekissen, und es gibt so viele wie Flocken in einem Schneesturm. Wir wachen aus einem Traum in den nächsten auf." —Ralph Waldo Emerson, „Illusionen"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98652&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'629385f1-1433-4b8c-92be-020e84acc2e6\', \'multiverseId\': 98652}, \'multiverseid\': 98652}, {\'name\': \'Guerrero fantasmal\', \'text\': \'El Guerrero fantasmal es imbloqueable.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'"Hay tantas almohadas de ilusión como copos en una tormenta de nieve. Nos despertamos de un sueño a otro sueño." —Ralph Waldo Emerson, "Ilusiones"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100092&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'314365dc-d114-4973-a5f5-886b5fd452e0\', \'multiverseId\': 100092}, \'multiverseid\': 100092}, {\'name\': \'Guerrier fantomatique\', \'text\': \'Le Guerrier fantomatique est imblocable.\', \'type\': \'Créature : illusion\', \'flavor\': "« La crainte cherche le mal pour s\'en affliger avant qu\'il ne soit arrivé ; elle ne s\'entretient que d\'illusions et de fantômes. » —Antoine Gombaud, chevalier de Méré", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98292&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d6712d96-30ae-4fee-9d49-40eca375145e\', \'multiverseId\': 98292}, \'multiverseid\': 98292}, {\'name\': \'Guerriero Fantasma\', \'text\': \'Il Guerriero Fantasma non può essere bloccato.\', \'type\': \'Creatura — Illusione\', \'flavor\': \'"Ci sono tanti cuscini di illusione quanti sono i fiocchi in una tempesta di neve. Ci svegliamo da un sogno per ritrovarci in un altro." —Ralph Waldo Emerson, "Illusioni"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99012&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41ac9619-ac89-48c8-b9c1-bf0bf2d24832\', \'multiverseId\': 99012}, \'multiverseid\': 99012}, {\'name\': \'幻影の戦士\', \'text\': \'幻影の戦士はブロックされない。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'この世界には吹雪の中の雪片と同じほどの幻影の床がある。 我々は一つの夢から覚めて別の夢に至るのだ。 ――ラルフ・ウォルド・エマーソン「幻想」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99372&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5cd5a096-45c0-44d7-a9b5-778cd078b2d8\', \'multiverseId\': 99372}, \'multiverseid\': 99372}, {\'name\': \'Guerreiro Fantasma\', \'text\': \'Guerreiro Fantasma não pode ser bloqueado.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'"Existem tantas almofadas de ilusão quanto flocos em uma nevasca. Nós acordamos de um sonho em outro." — Ralph Waldo Emerson, "Ilusões"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99732&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bb0f023-e0e4-42e8-9ed0-4b6876b9b5dc\', \'multiverseId\': 99732}, \'multiverseid\': 99732}, {\'name\': \'Призрачный воин\', \'text\': \'Призрачного воина невозможно блокировать.\', \'type\': \'Существо — Иллюзия\', \'flavor\': \'"Иллюзий вокруг не меньше, чем хлопьев снега в метель. Просыпаясь, мы переходим из одного сна в другой". — Ральф Вальдо Эммерсон, "Иллюзии"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110003&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aad6a645-f159-4f81-a464-b69cb25c84bb\', \'multiverseId\': 110003}, \'multiverseid\': 110003}, {\'name\': \'幽魅战士\', \'text\': \'幽魅战士不能被阻挡。\', \'type\': \'生物～虚影\', \'flavor\': \'「幻影梦枕犹如漫天雪花无尽。 我们自梦境醒转，又进入另一个梦境。」 ～拉尔夫‧沃尔多‧爱默生，《幻影》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97932&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d2af9eed-df78-4644-a2a3-28a22f6dae6a\', \'multiverseId\': 97932}, \'multiverseid\': 97932}]', '[{\'name\': \'Phyrexianische Arena\', \'text\': \'Zu Beginn deines Versorgungssegments ziehst du eine Karte und verlierst 1 Lebenspunkt.\', \'type\': \'Verzauberung\', \'flavor\': \'Eine Flut der Macht kostet immer ein Stück deiner Menschlichkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98653&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7b69be3-b3a7-4c1a-ad75-664cfb6cc21f\', \'multiverseId\': 98653}, \'multiverseid\': 98653}, {\'name\': \'Arena pirexiana\', \'text\': \'Al comienzo de tu mantenimiento, roba una carta y pierde 1 vida.\', \'type\': \'Encantamiento\', \'flavor\': \'Una gota de humanidad para un mar de poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100093&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b8560ed-20df-4950-8192-f7e3dbadfbe8\', \'multiverseId\': 100093}, \'multiverseid\': 100093}, {\'name\': \'Arène phyrexiane\', \'text\': \'Au début de votre entretien, vous piochez une carte et vous perdez 1 point de vie.\', \'type\': \'Enchantement\', \'flavor\': "Une goutte d\'humanité pour un océan de puissance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98293&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'811e4ddd-c7aa-4438-975d-5152dd08d99c\', \'multiverseId\': 98293}, \'multiverseid\': 98293}, {\'name\': \'Arena di Phyrexia\', \'text\': "All\'inizio del tuo mantenimento, peschi una carta e perdi 1 punto vita.", \'type\': \'Incantesimo\', \'flavor\': \'Una goccia di umanità per un mare di potere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99013&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'502dce05-9661-4857-acbf-491fc1d18b8e\', \'multiverseId\': 99013}, \'multiverseid\': 99013}, {\'name\': \'ファイレクシアの闘技場\', \'text\': \'あなたのアップキープの開始時に、あなたはカードを１枚引き、１点のライフを失う。\', \'type\': \'エンチャント\', \'flavor\': \'力の海のための一滴の人間性。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99373&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5a68c6e7-cc24-4cd6-9b8a-8bbdc65cedfd\', \'multiverseId\': 99373}, \'multiverseid\': 99373}, {\'name\': \'Arena Phyrexiana\', \'text\': \'No início de sua manutenção, você compra um card e perde 1 ponto de vida.\', \'type\': \'Encantamento\', \'flavor\': \'Uma gota de humanidade num oceano de poder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99733&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e7e02af1-f4d8-4fc7-8549-0aca98bdb31f\', \'multiverseId\': 99733}, \'multiverseid\': 99733}, {\'name\': \'Фирексийская арена\', \'text\': \'В начале этапа поддержки вы берете карту и теряете 1 пункт жизни.\', \'type\': \'Чары\', \'flavor\': \'Капля человечности в море власти.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110004&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd304fc1-4b0d-4148-91a5-cedeef63499a\', \'multiverseId\': 110004}, \'multiverseid\': 110004}, {\'name\': \'非瑞克西亚斗技场\', \'text\': \'在你的维持开始时，你抓一张牌且失去1点生命。\', \'type\': \'结界\', \'flavor\': \'人性滴落力量汪洋。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97933&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66777731-8325-4ad3-82fe-e798ee9ba6e7\', \'multiverseId\': 97933}, \'multiverseid\': 97933}]', "[{'name': 'Phyrexianischer Gargantua', 'text': 'Wenn der Phyrexianische Gargantua ins Spiel kommt, ziehst du zwei Karten und verlierst 2 Lebenspunkte.', 'type': 'Kreatur — Schrecken', 'flavor': 'Selbst andere Phyrexianer fürchten sich vor dem Gargantua.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98654&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'edcc2de5-cd51-4115-beb7-4579c0eac1c6', 'multiverseId': 98654}, 'multiverseid': 98654}, {'name': 'Gargantúa pirexiano', 'text': 'Cuando el Gargantúa pirexiano entre en juego, roba dos cartas y pierde 2 vidas.', 'type': 'Criatura — Horror', 'flavor': 'Otros pirexianos tienen pesadillas acerca de los gargantúa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100094&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7f1ce517-1538-4837-8346-429276951dd9', 'multiverseId': 100094}, 'multiverseid': 100094}, {'name': 'Gargantua phyrexian', 'text': 'Quand le Gargantua phyrexian arrive en jeu, vous piochez deux cartes et vous perdez 2 points de vie.', 'type': 'Créature : horreur', 'flavor': 'Le gargantua donne des cauchemars même aux autres phyrexians.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98294&type=card', 'language': 'French', 'identifiers': {'scryfallId': '08969b5b-7865-480c-b40d-1298fe8a73ec', 'multiverseId': 98294}, 'multiverseid': 98294}, {'name': 'Gargantua di Phyrexia', 'text': 'Quando il Gargantua di Phyrexia entra in gioco, peschi due carte e perdi 2 punti vita.', 'type': 'Creatura — Orrore', 'flavor': 'Gli altri abitanti di Phyrexia incontrano il gargantua nei loro peggiori incubi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99014&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3760298e-b043-47be-82a8-f72f23887f4e', 'multiverseId': 99014}, 'multiverseid': 99014}, {'name': 'ファイレクシアのガルガンチュア', 'text': 'ファイレクシアのガルガンチュアが場に出たとき、あなたはカードを２枚引き、２点のライフを失う。', 'type': 'クリーチャー — ホラー', 'flavor': 'ファイレクシアの者たちでさえ、ガルガンチュアの夢にうなされる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99374&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bc89625d-e981-4189-b6fa-d3b44601cc55', 'multiverseId': 99374}, 'multiverseid': 99374}, {'name': 'Gargantua Phyrexiano', 'text': 'Quando Gargantua Phyrexiano entra em jogo, você compra dois cards e perde 2 pontos de vida.', 'type': 'Criatura — Horror', 'flavor': 'Outros Phyrexianos têm pesadelos com o gargantua.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99734&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bab78387-2dfb-4c3b-bee8-586e48009f4c', 'multiverseId': 99734}, 'multiverseid': 99734}, {'name': 'Фирексийский великан', 'text': 'Когда Фирексийский великан вступает в игру, вы берете две карты и теряете 2 пункта жизни.', 'type': 'Существо — Ужас', 'flavor': 'Другим фирексийцам этот великан снится в страшных снах.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110005&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0dd94285-a9d5-477d-8605-6175e52d7831', 'multiverseId': 110005}, 'multiverseid': 110005}, {'name': '非瑞克西亚巨罡兽', 'text': '当非瑞克西亚巨罡兽进场时，你抓两张牌，并且失去2点生命。', 'type': '生物～惊惧兽', 'flavor': '其它的非瑞克西亚人，都曾在恶梦中见过这巨兽。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97934&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '50c8c42f-8844-4561-bd11-9640a8787869', 'multiverseId': 97934}, 'multiverseid': 97934}]", '[{\'name\': \'Phyrexianischer Moloch\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Er denkt nicht nach. Er fühlt auch nichts. Er weint nie oder lacht. Früh fängt er mit dem Töten an, Was er bis abends macht. —Oneanischer Kinderreim\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f9dc47b-4a23-4465-99b9-7268e1129e43\', \'multiverseId\': 98655}, \'multiverseid\': 98655}, {\'name\': \'Titán pirexiano\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'No piensa. No siente. No ríe ni llora. Lo único que hace del atardecer al amanecer es hacer morir a los soldados. Rima infantil oneana\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100095&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7460d932-394e-4a77-816a-c0bb97b1a64f\', \'multiverseId\': 100095}, \'multiverseid\': 100095}, {\'name\': \'Carcasse phyrexiane\', \'type\': \'Créature-artefact : golem\', \'flavor\': "Il ne pense pas. Il ne sent pas. Il ne pleure et ne rit pas. Tout ce qu\'il fait, matin ou soir C\'est de jouer l\'aplatissoir. —Comptine onéane", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98295&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f23b21f8-05d7-4d28-81ac-05e26bdb4a05\', \'multiverseId\': 98295}, \'multiverseid\': 98295}, {\'name\': \'Carcassa di Phyrexia\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': "Non pensa. Non ha tornaconto. Non ride e non sente. Tutto ciò che fa dall\'alba al tramonto È far morire la gente. —Rima dei bambini oneani", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99015&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8a1e34c7-d0e0-4fb9-8deb-80d433d8996a\', \'multiverseId\': 99015}, \'multiverseid\': 99015}, {\'name\': \'ファイレクシアの大男\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'なんにも考えないし、 感じない ぜんぜん笑わないし、泣きもしない 朝から晩まで一生懸命 兵隊さん殺すしかやりゃしない ――オネイアンの童謡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99375&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fce2ab33-a59b-488d-b989-c7d4adb87399\', \'multiverseId\': 99375}, \'multiverseid\': 99375}, {\'name\': \'Brutamontes Phyrexiano\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Ele não pensa. Ele não sente. Ele não ri nem chora. Tudo que faz do entardecer à aurora É levar soldados à morte, incontinente. — Verso infantil de Oneah\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99735&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'deada3a3-0139-402a-97b9-d081296e8423\', \'multiverseId\': 99735}, \'multiverseid\': 99735}, {\'name\': \'Огромный фирексиец\', \'type\': \'Артефактное существо — Голем\', \'flavor\': \'Ни мыслей нет. Ни сердца нет. Ни смеха нет, ни слез. Толпу солдат за много лет В могилу он унес. — Онеанский детский стишок\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110006&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e37658d6-36d8-4ec5-8e16-4a183d45a342\', \'multiverseId\': 110006}, \'multiverseid\': 110006}, {\'name\': \'非瑞克西亚巨汉\', \'type\': \'神器生物～魔像\', \'flavor\': \'它没思想。 它没感觉。 它不会笑也不会哭。 从晚到早所做的 就是让士兵阵亡。 ～欧尼亚童谣\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97935&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'743a3d54-51e4-4dcd-9bfc-aa587ed2f096\', \'multiverseId\': 97935}, \'multiverseid\': 97935}]', '[{\'name\': \'Plötzlicher Aufprall\', \'text\': \'Der Plötzliche Aufprall fügt einem Spieler deiner Wahl Schadenspunkte in Höhe der Anzahl an Karten auf seiner Hand zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es gibt Leute, die sagen, man soll denken, bevor man handelt. Und während diese Leute alle Möglichkeiten bedenken, habe ich genug Zeit, sie zu töten."—Dravus, Lavamagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98730&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'25a352f6-839e-4a7c-9f40-63124e04da24\', \'multiverseId\': 98730}, \'multiverseid\': 98730}, {\'name\': \'Impacto súbito\', \'text\': \'El Impacto súbito hace una cantidad de daño igual al número de cartas que haya en la mano del jugador objetivo a ese jugador.\', \'type\': \'Instantáneo\', \'flavor\': \'"Algunos dicen que es mejor pensar antes de actuar. Mientras esa gente considera las opciones; entonces es cuando las mato."Dravus, mago de lava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100170&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'40e9c04a-1991-4fbc-934f-920ece21bcae\', \'multiverseId\': 100170}, \'multiverseid\': 100170}, {\'name\': \'Choc soudain\', \'text\': \'Le Choc soudain inflige au joueur ciblé un nombre de blessures égal au nombre de cartes dans la main de ce joueur.\', \'type\': \'Éphémère\', \'flavor\': "« Certains disent qu\'il vaut mieux réfléchir avant d\'agir. Et c\'est pendant que ces gens réfléchissent que je les tue. »Dravus, mage des laves", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98370&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'095ebe66-6d6a-4ba5-bf28-d27ea7bdd49d\', \'multiverseId\': 98370}, \'multiverseid\': 98370}, {\'name\': \'Impatto Improvviso\', \'text\': "L\'Impatto Improvviso infligge a un giocatore bersaglio un ammontare di danni pari al numero di carte presenti nella mano di quel giocatore.", \'type\': \'Istantaneo\', \'flavor\': \'"Alcuni dicono che sia meglio pensare prima di agire. E mentre considerano tutte le opzioni, io li uccido."Dravus, mago della lava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99090&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7c2e7f68-b35d-4739-b88e-65ff8e37e4f2\', \'multiverseId\': 99090}, \'multiverseid\': 99090}, {\'name\': \'突然の衝撃\', \'text\': \'プレイヤー１人を対象とする。突然の衝撃はそのプレイヤーに、そのプレイヤーの手札のカードの枚数に等しい点数のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'何かする前に考えた方がいいなんてやつもいるさ。 そいつらが選択肢を考えてるときに、大抵俺が殺しちまってるんだけどな。――溶岩魔道士のドレイヴァス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99450&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca6a2ac3-89c7-4dfc-ac29-ad4c0273610b\', \'multiverseId\': 99450}, \'multiverseid\': 99450}, {\'name\': \'Impacto Súbito\', \'text\': \'Impacto Súbito causa ao jogador alvo uma quantidade de dano igual ao número de cards na mão daquele jogador.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Algumas pessoas dizem que é melhor pensar antes de agir. Enquanto essas pessoas estão considerando todas as opções, é quando normalmente eu as mato." Dravus, mago da lava\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5bb60e4-4012-499e-ac27-fb10da277e36\', \'multiverseId\': 99810}, \'multiverseid\': 99810}, {\'name\': \'Внезапный удар\', \'text\': \'Внезапный удар наносит целевому игроку столько повреждений, сколько карт находится в его руке.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Некоторые полагают, что лучше сначала думать, а потом делать. Вот пока они обдумывают все возможности, я их обычно и убиваю". — Дравус, маг лавы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110081&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57227606-f8bd-4210-be33-6f8f1e71a7c0\', \'multiverseId\': 110081}, \'multiverseid\': 110081}, {\'name\': \'猛然撞击\', \'text\': \'猛然撞击对目标牌手造成等同于该牌手之手牌数量的伤害。\', \'type\': \'瞬间\', \'flavor\': \'「有人认为先考虑再行动才稳当。 我拿下的人头通常都还在考虑各种应对之道。」～熔岩法师赭拉瓦\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98010&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'885f1ba0-235c-43c2-820b-4fb933d12a0c\', \'multiverseId\': 98010}, \'multiverseid\': 98010}]', '[{\'name\': \'Polymorph\', \'text\': \'Zerstöre eine Kreatur deiner Wahl. Sie kann nicht regeneriert werden. Ihr Beherrscher deckt Karten oben von seiner Bibliothek auf, bis er eine Kreaturenkarte aufdeckt. Der Spieler bringt diese Karte ins Spiel und mischt alle anderen auf diese Weise aufgedeckten Karten in seine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98663&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8e4dc7f-6529-42e3-b28d-5bcc9ce2db12\', \'multiverseId\': 98663}, \'multiverseid\': 98663}, {\'name\': \'Transmutar\', \'text\': \'Destruye la criatura objetivo. No puede ser regenerada. El controlador de esa criatura muestra cartas de la parte superior de su biblioteca hasta que muestre una carta de criatura. Ese jugador pone esa carta en juego y baraja todas las otras cartas mostradas de esta manera en su biblioteca.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100103&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'169787c7-02ea-4b10-ba61-2bf1dfbde361\', \'multiverseId\': 100103}, \'multiverseid\': 100103}, {\'name\': \'Polymorphisme\', \'text\': "Détruisez la créature ciblée. Elle ne peut pas être régénérée. Son contrôleur révèle les cartes du dessus de sa bibliothèque jusqu\'à ce qu\'il révèle une carte de créature. Ce joueur met en jeu cette carte et mélange toutes les autres cartes révélées de cette manière dans sa bibliothèque.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'094e827a-3941-40ae-b9e4-2c209d436761\', \'multiverseId\': 98303}, \'multiverseid\': 98303}, {\'name\': \'Polimorfismo\', \'text\': \'Distruggi una creatura bersaglio. Non può essere rigenerata. Il suo controllore rivela carte dalla cima del proprio grimorio fino a quando rivela una carta creatura. Il giocatore mette in gioco quella carta e rimescola nel proprio grimorio tutte le altre carte rivelate in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99023&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b658147-dda5-483d-bda8-c6064c47bb16\', \'multiverseId\': 99023}, \'multiverseid\': 99023}, {\'name\': \'変身\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。 それは再生できない。 それのコントローラーは、自分のライブラリーの一番上のカードを、クリーチャー・カードが公開されるまで公開し続ける。 そのプレイヤーはそのカードを場に出し、この方法で公開された他のすべてのカードを自分のライブラリーに加えた上で切り直す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99383&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c9e8875-4a50-43d4-9e23-57081023d39c\', \'multiverseId\': 99383}, \'multiverseid\': 99383}, {\'name\': \'Polimorfismo\', \'text\': \'Destrói a criatura alvo. Ela não pode ser regenerada. O controlador daquela criatura revela cards do topo de seu próprio grimório até revelar um card de criatura. O jogador coloca aquele card em jogo e embaralha todos os outros cards revelados dessa maneira em seu próprio grimório.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99743&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ada21eb1-6d5b-4268-bbe8-e0d3c3b05e88\', \'multiverseId\': 99743}, \'multiverseid\': 99743}, {\'name\': \'Полиморф\', \'text\': \'Уничтожьте целевое существо. Оно не может быть регенерировано. Игрок, контролирующий целевое существо, открывает карты из библиотеки по одной, начиная с верхней, пока не откроет карту существа. Игрок вводит эту карту в игру, возвращает открытые карты в библиотеку и тасует ее.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110014&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3c63f51-14d9-4f88-b620-14e1f576fe13\', \'multiverseId\': 110014}, \'multiverseid\': 110014}, {\'name\': \'型态转变\', \'text\': \'消灭目标生物。 它不能重生。 其操控者自他的牌库顶开始展示牌，直到展示出一张生物牌为止。 该玩家将该牌放置进场，并将所有其它以此法展示的牌洗入其牌库中。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97943&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e8593436-fff7-47ff-ad91-8451beffae54\', \'multiverseId\': 97943}, \'multiverseid\': 97943}]', "[{'name': 'Rathidrache', 'text': 'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nWenn der Rathidrache ins Spiel kommt, opfere ihn, falls du nicht zwei Gebirge opferst.', 'type': 'Kreatur — Drache', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98670&type=card', 'language': 'German', 'identifiers': {'scryfallId': '03e958df-d921-47ea-8fde-802813b50a5c', 'multiverseId': 98670}, 'multiverseid': 98670}, {'name': 'Dragón de Rath', 'text': 'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nCuando el Dragón de Rath entre en juego, sacrifícalo a menos que sacrifiques dos montañas.', 'type': 'Criatura — Dragón', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100110&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '19de4b84-3ff3-483c-9934-9cfe796c0c97', 'multiverseId': 100110}, 'multiverseid': 100110}, {'name': 'Dragon rajhi', 'text': 'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nQuand le Dragon rajhi arrive en jeu, sacrifiez-le à moins que vous ne sacrifiiez deux montagnes.', 'type': 'Créature : dragon', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98310&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2cce6484-8957-412f-ab4c-8e59a379b33d', 'multiverseId': 98310}, 'multiverseid': 98310}, {'name': 'Drago di Rath', 'text': 'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nQuando il Drago di Rath entra in gioco, sacrificalo a meno che tu sacrifichi due Montagne.', 'type': 'Creatura — Drago', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99030&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a0999233-5231-4bdb-b703-6a50c63b38d8', 'multiverseId': 99030}, 'multiverseid': 99030}, {'name': 'ラースのドラゴン', 'text': '飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\nラースのドラゴンが場に出たとき、山を２つ生け贄に捧げない限り、それを生け贄に捧げる。', 'type': 'クリーチャー — ドラゴン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99390&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5b25d6ee-baec-4a39-a086-78e112ce4bd7', 'multiverseId': 99390}, 'multiverseid': 99390}, {'name': 'Dragão de Rath', 'text': 'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nQuando Dragão de Rath entra em jogo, sacrifique-o a menos que você sacrifique duas Montanhas.', 'type': 'Criatura — Dragão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99750&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '80c71ec2-6cf7-46de-9f14-cb061a14223f', 'multiverseId': 99750}, 'multiverseid': 99750}, {'name': 'Дракон Рати', 'text': 'Полет (Это существо может быть блокировано только существом со способностью полета).\\nКогда Дракон Рати вступает в игру, принесите его в жертву или принесите в жертву две Горы.', 'type': 'Существо — Дракон', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110021&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '85087418-9aa6-4e0d-a078-e06186e37efc', 'multiverseId': 110021}, 'multiverseid': 110021}, {'name': '瑞斯之龙', 'text': '飞行（只有具飞行异能的生物才能阻挡它。）\\n当瑞斯之龙进场时，牺牲两个山脉，否则牺牲瑞斯之龙。', 'type': '生物～龙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97950&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '75206ae0-0842-49b6-8823-00753b593e7e', 'multiverseId': 97950}, 'multiverseid': 97950}]", '[{\'name\': \'Ratschlag der Soratami\', \'text\': \'Ziehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Weisheit ist nicht das Zählen aller Tropfen im Wasserfall. Weisheit ist zu lernen, warum das Wasser die Erde sucht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98487&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9914e85-0fa4-4d07-8fd3-c2c64fa2dcb9\', \'multiverseId\': 98487}, \'multiverseid\': 98487}, {\'name\': \'Consejo de los soratami\', \'text\': \'Roba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"La sabiduría no consiste en contar todas las gotas de una cascada. La sabiduría consiste en aprender por qué el agua busca la tierra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99927&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9af51c9f-9b7c-4f60-a6a3-0ea1aa669b38\', \'multiverseId\': 99927}, \'multiverseid\': 99927}, {\'name\': \'Conseil des soratami\', \'text\': \'Piochez deux cartes.\', \'type\': \'Rituel\', \'flavor\': "« Le sage ne compte pas les gouttes de la cascade. Il cherche à savoir pourquoi l\'eau désire retrouver la terre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98127&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90f59f80-79c5-4cf0-8d1d-549a43699aa5\', \'multiverseId\': 98127}, \'multiverseid\': 98127}, {\'name\': \'Consiglio dei Soratami\', \'text\': \'Pesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"La saggezza non è contare tutte le gocce di una cascata. La saggezza è comprendere perché l\\\'acqua cerca la terra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98847&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb2fcaa3-9e6c-421e-b0c1-980416de1bf6\', \'multiverseId\': 98847}, \'multiverseid\': 98847}, {\'name\': \'空民の助言\', \'text\': \'カードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'知恵とは滝の中の水滴を数える事にあらず。 知恵とはなぜ水が大地を求めるかを知ることなり。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99207&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1c86af0f-d17a-46a5-a16d-93d712d05f69\', \'multiverseId\': 99207}, \'multiverseid\': 99207}, {\'name\': \'Conselho dos Soratamis\', \'text\': \'Compre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'"Ser sábio não é contar todas as gotas de uma queda d\\\'água. Ser sábio é aprender o porquê da água procurar a terra."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99567&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0287477-c05e-49d1-b597-4f047bdce50b\', \'multiverseId\': 99567}, \'multiverseid\': 99567}, {\'name\': \'Совет Соратами\', \'text\': \'Возьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'"Мудрый не считает капли в водопаде. Мудрый пытается понять, почему вода стремится к земле".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109838&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b1b98129-b38a-4dcb-9d13-08a2d7afb94d\', \'multiverseId\': 109838}, \'multiverseid\': 109838}, {\'name\': \'空民商议\', \'text\': \'抓两张牌。\', \'type\': \'法术\', \'flavor\': \'「智慧不是去计数瀑布中有多少水滴， 而是学习为何水要奔向土地。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97767&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02d5dc2c-4ae2-4482-b1a7-0158afab6306\', \'multiverseId\': 97767}, \'multiverseid\': 97767}]', '[{\'name\': \'Rattenschwarm\', \'text\': \'Die Stärke des Rattenschwarms ist gleich der Anzahl an Ratten, die du kontrollierst.\', \'type\': \'Kreatur — Ratte\', \'flavor\': \'„Da krabbeln sie nun, wie die Ratten auf der Keule des Herkules..." —Friedrich Schiller, Die Räuber\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98738&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac887ba6-a2ad-4050-8551-18195f7d400e\', \'multiverseId\': 98738}, \'multiverseid\': 98738}, {\'name\': \'Aluvión de ratas\', \'text\': \'La fuerza del Aluvión de ratas es igual al número de Ratas que controles.\', \'type\': \'Criatura — Rata\', \'flavor\': \'"¡Ratas, ratas, ratas Cientos, miles, millones de ellas, y cada una de ellas es una vida." —Bram Stoker, Drácula\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100178&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5e7d03f4-f8d4-48d7-a8b0-6060f5cb8718\', \'multiverseId\': 100178}, \'multiverseid\': 100178}, {\'name\': \'Colonie de rats\', \'text\': \'La force de la Colonie de rats est égale au nombre de rats que vous contrôlez.\', \'type\': \'Créature : rat\', \'flavor\': "« Des rats Par centaines, par milliers, par millions... Et chacun d\'eux une vie distinctive. » —Bram Stoker, Dracula", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98378&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4a6be03f-affd-45d7-a677-1338432eabf4\', \'multiverseId\': 98378}, \'multiverseid\': 98378}, {\'name\': \'Sciame di Ratti\', \'text\': \'La forza dello Sciame di Ratti è pari al numero di Ratti che controlli.\', \'type\': \'Creatura — Ratto\', \'flavor\': \'"Ratti, ratti, ratti Centinaia, migliaia, milioni di essi, e ciascuno una vita." —Bram Stoker, Dracula\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99098&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'397cce26-2539-4cd3-a69b-aee6cb4fbc8b\', \'multiverseId\': 99098}, \'multiverseid\': 99098}, {\'name\': \'ネズミの大群\', \'text\': \'ネズミの大群のパワーは、あなたがコントロールするネズミの数に等しい。\', \'type\': \'クリーチャー — ネズミ\', \'flavor\': \'鼠、鼠、鼠！ 何百、何千、何万といて、それぞれが生きている。 ――ブラム・ストーカー「吸血鬼ドラキュラ」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99458&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'46da7ce7-3dd4-4e90-b134-2e2dae310a21\', \'multiverseId\': 99458}, \'multiverseid\': 99458}, {\'name\': \'Rataria\', \'text\': \'O poder de Rataria é igual ao número de Ratos que você controla.\', \'type\': \'Criatura — Rato\', \'flavor\': \'"Ratos, ratos, ratos Centenas, milhares, milhões deles. E cada um é uma vida." — Bram Stoker, Drácula\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99818&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'194808ad-98f7-4d26-8d8c-16f8b7ff9790\', \'multiverseId\': 99818}, \'multiverseid\': 99818}, {\'name\': \'Стая крыс\', \'text\': \'Сила Стаи крыс равняется числу Крыс, которых вы контролируете.\', \'type\': \'Существо — Крыса\', \'flavor\': \'"Крысы, крысы, крысы Сотни, тысячи, миллионы крыс, и в каждой из них частичка жизни". — Брем Стокер, Дракула\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110089&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b74f7fd-3e6f-4641-9baf-798dc094005a\', \'multiverseId\': 110089}, \'multiverseid\': 110089}, {\'name\': \'老鼠暴群\', \'text\': \'老鼠暴群的力量等同于由你操控之老鼠的数量。\', \'type\': \'生物～老鼠\', \'flavor\': \'「老鼠，老鼠，老鼠！ 上百，上千，上万的老鼠，个个都是一条生命。」 ～伯兰‧史杜克，《吸血鬼》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'007d4e13-cc3d-4ae8-9d13-3a09a4349958\', \'multiverseId\': 98018}, \'multiverseid\': 98018}]', '[{\'name\': \'Rechtschaffenheit\', \'text\': \'Eine blockende Kreatur deiner Wahl erhält +7/+7 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Manchmal ist die Stärke der Überzeugung stärker als alles andere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98681&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e04a1906-3936-4771-a3ad-0ecfdb296d3c\', \'multiverseId\': 98681}, \'multiverseid\': 98681}, {\'name\': \'Rectitud\', \'text\': \'La criatura bloqueadora objetivo obtiene +7/+7 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'A veces la mayor fuerza es la fuerza de la convicción.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100121&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'264ed191-4243-4dee-ae9d-ff6d760a1132\', \'multiverseId\': 100121}, \'multiverseid\': 100121}, {\'name\': \'Droiture\', \'text\': "La créature bloqueuse ciblée gagne +7/+7 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Dieu donne à la franchise, à la fidélité, à la droiture un accent qui ne peut être ni contrefait, ni méconnu. »Joseph, comte de Maistre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'092c87f3-7c55-4708-8e65-66c81e25e104\', \'multiverseId\': 98321}, \'multiverseid\': 98321}, {\'name\': \'Rettitudine\', \'text\': \'La creatura bloccante bersaglio prende +7/+7 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'A volte la forza più grande è la forza del convincimento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99041&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a65bd6bc-2f78-4808-8218-c068a6158bd5\', \'multiverseId\': 99041}, \'multiverseid\': 99041}, {\'name\': \'高潔のあかし\', \'text\': \'ブロックに参加しているクリーチャー１体を対象とする。それはターン終了時まで+7/+7の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': \'信じることの力が最も強い力となることもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99401&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bcd68ac1-f84e-401a-841c-f8d2e4a1b472\', \'multiverseId\': 99401}, \'multiverseid\': 99401}, {\'name\': \'Integridade\', \'text\': \'A criatura alvo bloqueadora recebe +7/+7 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Às vezes a maior força é a força da convicção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99761&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b062e03-9177-4d46-89f2-66cf44ac354f\', \'multiverseId\': 99761}, \'multiverseid\': 99761}, {\'name\': \'Праведность\', \'text\': \'Целевое блокирующее существо получает +7/+7 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Иногда главная сила сила убеждения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110032&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c523c552-d539-464a-8cc8-ea5a9167f542\', \'multiverseId\': 110032}, \'multiverseid\': 110032}, {\'name\': \'正气\', \'text\': \'目标进行阻挡的生物得+7/+7直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'有时候，最强大的力量便是信念之力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97961&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e59a559f-01df-4195-bef4-46620e67c4ce\', \'multiverseId\': 97961}, \'multiverseid\': 97961}]', '[{\'name\': \'Reflexe\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur hat Erstschlag. (Sie fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98674&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c0d3fc0-7503-4af6-8eb9-4a700d9f017d\', \'multiverseId\': 98674}, \'multiverseid\': 98674}, {\'name\': \'Reflejos\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada tiene la habilidad de dañar primero. (Hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100114&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68dbdc17-4981-4c09-8d5b-baa1e10a858d\', \'multiverseId\': 100114}, \'multiverseid\': 100114}, {\'name\': \'Réflexes\', \'text\': "Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée a l\'initiative. (Elle inflige des blessures de combat avant les créatures sans l\'initiative.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98314&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be282244-02ba-4e0f-958d-7030b87e54b4\', \'multiverseId\': 98314}, \'multiverseid\': 98314}, {\'name\': \'Riflessi\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata ha attacco improvviso. (Infligge il danno da combattimento prima delle creature senza attacco improvviso.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99034&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c71b3213-de41-42d5-8d62-63310f20ee20\', \'multiverseId\': 99034}, \'multiverseid\': 99034}, {\'name\': \'速やかな反応\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは先制攻撃を持つ。 （それは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99394&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6a25eb4-fa07-4b70-b955-eb1a3d055320\', \'multiverseId\': 99394}, \'multiverseid\': 99394}, {\'name\': \'Reflexos\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada tem a habilidade de iniciativa. (Ela causa dano antes de criaturas sem a habilidade de iniciativa.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99754&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f4877ce4-f8aa-4941-bda8-bed9e67099b6\', \'multiverseId\': 99754}, \'multiverseid\': 99754}, {\'name\': \'Рефлексы\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает способность первого удара. (Оно наносит боевые повреждения раньше, чем существа без способности первого удара).\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110025&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef0e0dab-590e-48f1-81f2-07c8bd489872\', \'multiverseId\': 110025}, \'multiverseid\': 110025}, {\'name\': \'反射动作\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物具有先攻异能。 （此生物会比不具先攻异能的生物提前造成战斗伤害。）\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97954&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d54a838-39a4-4fad-b4fb-25e4cfe66134\', \'multiverseId\': 97954}, \'multiverseid\': 97954}]', '[{\'name\': \'Regeneration\', \'text\': \'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\n{G}: Regeneriere die verzauberte Kreatur. (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98675&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2f6d7afa-3683-4f6a-be46-d081a9e727fe\', \'multiverseId\': 98675}, \'multiverseid\': 98675}, {\'name\': \'Regeneración\', \'text\': \'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\n{G}: Regenera a la criatura encantada. (La próxima vez que esa criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100115&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4de7bee-4b43-4241-a386-1314b8b9a2a4\', \'multiverseId\': 100115}, \'multiverseid\': 100115}, {\'name\': \'Régénération\', \'text\': "Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\n{G} : Régénérez la créature enchantée. (La prochaine fois que cette créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98315&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'98530e18-c21f-4517-865d-820bcd669eaf\', \'multiverseId\': 98315}, \'multiverseid\': 98315}, {\'name\': \'Rigenerazione\', \'text\': \'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\n{G}: Rigenera la creatura incantata. (La prossima volta che quella creatura sta per essere distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi tutti i danni da essa e rimuovila dal combattimento.)\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99035&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc795850-5049-441a-a16e-2532d6132054\', \'multiverseId\': 99035}, \'multiverseid\': 99035}, {\'name\': \'再生\', \'text\': \'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\n{G}：エンチャントされているクリーチャーを再生する。 （このターン、次にそのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99395&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'634bdd1c-ce13-457c-b579-4a278cc81d3b\', \'multiverseId\': 99395}, \'multiverseid\': 99395}, {\'name\': \'Regeneração\', \'text\': \'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\n{G}: Regenera a criatura encantada. (Na próxima vez em que uma criatura seria destruída neste turno, ela não o é. Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99755&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64cb8bfd-4454-4736-9d33-b600cff13c67\', \'multiverseId\': 99755}, \'multiverseid\': 99755}, {\'name\': \'Регенерация\', \'text\': \'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\n{G}: Регенерируйте зачарованное существо. (Если в течение этого хода это существо будет уничтожено, оно не отправляется на кладбище. Вместо этого поверните его, снимите с него все повреждения и выведите его из боя).\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110026&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'36786980-c6be-482a-b290-6342c515a1fd\', \'multiverseId\': 110026}, \'multiverseid\': 110026}, {\'name\': \'重生\', \'text\': \'生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n{G}：重生受此结界的生物。 （如果该生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除所受的所有伤害，并将它移出战斗。）\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97955&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'01f4cfc6-82d1-4857-a8f0-eece23491591\', \'multiverseId\': 97955}, \'multiverseid\': 97955}]', '[{\'name\': \'Riesenschabe\', \'type\': \'Kreatur — Insekt\', \'flavor\': \'Toren war im Laufe seines Lebens schon auf eine Menge Käfer getreten. Daher war es etwas schockierend für ihn, als plötzlich ein Käfer ihn zertrat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98546&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'426c6295-cb15-4871-b049-f071b68f991c\', \'multiverseId\': 98546}, \'multiverseid\': 98546}, {\'name\': \'Cucaracha gigante\', \'type\': \'Criatura — Insecto\', \'flavor\': \'Toren había pisado muchos insectos durante su vida, así que no pudo evitar sentirse avergonzado al ser pisado por un insecto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99986&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a102aa7f-0511-4971-9ec6-f9fa82fa4ae9\', \'multiverseId\': 99986}, \'multiverseid\': 99986}, {\'name\': \'Cafard géant\', \'type\': \'Créature : insecte\', \'flavor\': \'Toren avait souvent écrasé des insectes. Maintenant il recevait la monnaie de sa pièce.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98186&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77731081-172f-44c2-9635-1d8f0af5f5e6\', \'multiverseId\': 98186}, \'multiverseid\': 98186}, {\'name\': \'Scarafaggio Gigante\', \'type\': \'Creatura — Insetto\', \'flavor\': "Toren aveva schiacciato un\'infinità di insetti nella propria vita, così non poté fare a meno di sentirsi imbarazzato quando venne calpestato da uno scarafaggio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98906&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2f475944-0cab-4a73-8730-8af189a8be6b\', \'multiverseId\': 98906}, \'multiverseid\': 98906}, {\'name\': \'巨大ゴキブリ\', \'type\': \'クリーチャー — 昆虫\', \'flavor\': \'トーレンは今までに虫を踏んづけたことは何度もあったが、今度は自分が虫に踏んづけられたなんて恥ずかしくてたまらなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99266&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6036944c-e76d-43fb-8e98-6a7b65088af0\', \'multiverseId\': 99266}, \'multiverseid\': 99266}, {\'name\': \'Barata Gigante\', \'type\': \'Criatura — Inseto\', \'flavor\': \'Toren havia pisoteado muitos insetos durante sua vida, portanto não pôde evitar sentir-se constrangido quando um inseto o pisoteou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99626&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aaa185cb-b156-41dd-ad93-eefef3ece109\', \'multiverseId\': 99626}, \'multiverseid\': 99626}, {\'name\': \'Гигантский таракан\', \'type\': \'Существо — Насекомое\', \'flavor\': \'Торен за свою жизнь растоптал столько жуков, что не мог не изумиться, когда жук наступил на него.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109897&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dfe9813f-8a79-44ef-9340-24185a841c39\', \'multiverseId\': 109897}, \'multiverseid\': 109897}, {\'name\': \'巨型蟑螂\', \'type\': \'生物～昆虫\', \'flavor\': \'陶伦的这大半辈子曾从许许多多的虫身上踩过；所以当一只虫居然从他身上踏过时，他不禁感到惊慌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97826&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d38faf69-98ae-4037-ae62-0bf753a75b2c\', \'multiverseId\': 97826}, \'multiverseid\': 97826}]', '[{\'name\': \'Riesenspinne\', \'text\': \'Die Riesenspinne kann blocken, als ob sie Flugfähigkeit hätte.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Das Spinnennetz beobachten —Llanowar-Ausdruck für „auf das Falsche konzentrieren"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e81a8fc4-1877-4c4d-aee4-f13afa49bf22\', \'multiverseId\': 98549}, \'multiverseid\': 98549}, {\'name\': \'Araña gigante\', \'text\': \'La Araña gigante puede bloquear como si tuviera la habilidad de volar.\', \'type\': \'Criatura — Araña\', \'flavor\': \'Observando la telaraña —Expresión de Llanowar que significa "enfocándose en la cosa equivocada"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99989&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe2cfc73-5702-4812-a24a-68293f88ae70\', \'multiverseId\': 99989}, \'multiverseid\': 99989}, {\'name\': \'Araignée géante\', \'text\': "L\'Araignée géante peut bloquer comme si elle avait le vol.", \'type\': \'Créature : araignée\', \'flavor\': "Regarder la toile de l\'araignée —Expression de la Llanowar signifiant « regarder dans la mauvaise direction »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98189&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aa54268d-1a62-435e-8b5c-ac36f437be26\', \'multiverseId\': 98189}, \'multiverseid\': 98189}, {\'name\': \'Ragno Gigante\', \'text\': \'Il Ragno Gigante può bloccare come se avesse volare.\', \'type\': \'Creatura — Ragno\', \'flavor\': \'Guardare la tela del ragno —Espressione di Llanowar, che significa "concentrarsi sulla cosa sbagliata".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98909&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3189560b-090c-4c89-96c9-d747d4e0c8cc\', \'multiverseId\': 98909}, \'multiverseid\': 98909}, {\'name\': \'大蜘蛛\', \'text\': \'大蜘蛛は飛行を持っているかのようにブロックに参加できる。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'蜘蛛の網を見る ――ラノワールの言い回しで 「関心の寄せどころが違っている。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99269&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c40ba1c4-f27f-41e0-81d3-18d6f9f0df03\', \'multiverseId\': 99269}, \'multiverseid\': 99269}, {\'name\': \'Aranha Gigante\', \'text\': \'Aranha Gigante pode bloquear como se tivesse a habilidade de voar.\', \'type\': \'Criatura — Aranha\', \'flavor\': \'Observar a teia da aranha — Expressão de Llanowar que significa "concentrar-se na coisa errada"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99629&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fdd5dad0-ed12-4985-827b-166649499547\', \'multiverseId\': 99629}, \'multiverseid\': 99629}, {\'name\': \'Гигантский паук\', \'text\': \'Гигантский паук может блокировать, как если бы он обладал способностью полета.\', \'type\': \'Существо — Паук\', \'flavor\': \'Смотреть в паучью сеть — Лановарское выражение, означающее "обращать внимание не на то"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109900&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8e4b5140-d498-44d2-9143-187784f47b9f\', \'multiverseId\': 109900}, \'multiverseid\': 109900}, {\'name\': \'巨型蜘蛛\', \'text\': \'巨型蜘蛛能视同具有飞行异能地进行阻挡。\', \'type\': \'生物～蜘蛛\', \'flavor\': \'盯着蜘蛛网 ～罗堰用语，意指 「搞错重点」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97829&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b3b848c6-8e05-4bf5-91bf-c1cea61f87f6\', \'multiverseId\': 97829}, \'multiverseid\': 97829}]', '[{\'name\': \'Riesenwuchs\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+3 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98547&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fbcd6264-a8e0-4519-add4-cf9c52bc3e19\', \'multiverseId\': 98547}, \'multiverseid\': 98547}, {\'name\': \'Crecimiento gigante\', \'text\': \'La criatura objetivo obtiene +3/+3 hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99987&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'357fb722-5ddc-4543-9042-26b84790b5a7\', \'multiverseId\': 99987}, \'multiverseid\': 99987}, {\'name\': \'Croissance gigantesque\', \'text\': "La créature ciblée gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98187&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da2dec5d-bb28-48cb-bd0c-2432321c5019\', \'multiverseId\': 98187}, \'multiverseid\': 98187}, {\'name\': \'Crescita Gigante\', \'text\': \'La creatura bersaglio prende +3/+3 fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98907&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2eb0a17a-03a6-4917-b8e7-e2cc6a0dbe7f\', \'multiverseId\': 98907}, \'multiverseid\': 98907}, {\'name\': \'巨大化\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで+3/+3の修整を受ける。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99267&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'557432e5-3b95-4513-b099-10e8efee8bbb\', \'multiverseId\': 99267}, \'multiverseid\': 99267}, {\'name\': \'Crescimento Desenfreado\', \'text\': \'A criatura alvo recebe +3/+3 até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99627&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'317b5863-760a-482d-bc3f-c5cb4ea34fd9\', \'multiverseId\': 99627}, \'multiverseid\': 99627}, {\'name\': \'Исполинский рост\', \'text\': \'Целевое существо получает +3/+3 до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109898&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d8fd251e-1354-4b65-8387-5d53ba7898b4\', \'multiverseId\': 109898}, \'multiverseid\': 109898}, {\'name\': \'变巨术\', \'text\': \'目标生物得+3/+3直到回合结束。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97827&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5ce0c4e-9dab-43f5-895f-fafb00e12c3d\', \'multiverseId\': 97827}, \'multiverseid\': 97827}]', '[{\'name\': \'Ruhmsucher\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Das Schlachtenglück kehrt immer mit dem einen Soldaten zurück, der es sich anders überlegt und sich wieder in den Kampf stürzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98552&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2328ca6-0c62-4338-9cec-7d8b4b5080ab\', \'multiverseId\': 98552}, \'multiverseid\': 98552}, {\'name\': \'Buscador de gloria\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'El cambio de la suerte siempre comienza con la decisión de un soldado de regresar a la lucha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99992&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a6122185-91d3-4ab9-b981-1d2a174e3258\', \'multiverseId\': 99992}, \'multiverseid\': 99992}, {\'name\': \'Chercheur de gloire\', \'type\': \'Créature : humain et soldat\', \'flavor\': "Un seul soldat retourne au combat, et l\'espoir change de camp.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98192&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a214410b-fa17-40be-8bb5-59ca8b6c1b49\', \'multiverseId\': 98192}, \'multiverseid\': 98192}, {\'name\': \'Cacciatore di Gloria\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Le sorti della battaglia sono destinate a mutare quando un soldato decide di tornare a gettarsi nella mischia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98912&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ea0f0b3-62a0-4954-b279-0bed32b4c629\', \'multiverseId\': 98912}, \'multiverseid\': 98912}, {\'name\': \'栄光の探求者\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'戦場の風向きは、いつだって一人の兵士が争いの場に踵を返すことから変わり始めるものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99272&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6147720d-7ecb-4263-9925-a5e0efd5164c\', \'multiverseId\': 99272}, \'multiverseid\': 99272}, {\'name\': \'Perseguidor da Glória\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'A mudança da maré sempre tem início com a decisão de um soldado de voltar para a luta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99632&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9179913-2027-4038-a06a-d80e6ea5cf05\', \'multiverseId\': 99632}, \'multiverseid\': 99632}, {\'name\': \'Искатель славы\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'Переломный момент всегда начинается с решения одного из солдат броситься в бой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109903&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'65a55ca8-36ef-449e-8ce1-334981f8b9fd\', \'multiverseId\': 109903}, \'multiverseid\': 109903}, {\'name\': \'荣耀追求者\', \'type\': \'生物～人类／士兵\', \'flavor\': \'战局的逆转总是起于某位士兵带头返身奋战。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97832&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0813c5b4-3f93-451c-8a18-618f20711097\', \'multiverseId\': 97832}, \'multiverseid\': 97832}]', '[{\'name\': \'Rukh-Ei\', \'text\': \'Wenn das Rukh-Ei aus dem Spiel auf den Friedhof gelegt wird, bringe am Ende des Zuges einen 4/4 roten Vogel-Spielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Kreatur — Ei\', \'flavor\': \'Rukhs, in den Ebenen oft „Steinfedern" genannt, stammen angeblich von einem Phoenix ab, der seine Flamme gegen einen steinernen Körper eingetauscht haben soll.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb2bb7e3-a018-462c-b7a5-9cefecd35dc1\', \'multiverseId\': 98688}, \'multiverseid\': 98688}, {\'name\': \'Huevo de rukh\', \'text\': \'Cuando el Huevo de rukh vaya a un cementerio desde el juego, pon en juego una ficha de criatura Ave roja 4/4 con la habilidad de volar al final del turno.\', \'type\': \'Criatura — Huevo\', \'flavor\': \'Muchas personas de las tierras bajas los llaman "plumas de piedra". Se piensa que los rukh descienden de un fénix que sacrificó su llama por un cuerpo de piedra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100128&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f437d226-0277-466d-a1d6-0b10fa7aaf9f\', \'multiverseId\': 100128}, \'multiverseid\': 100128}, {\'name\': \'Œuf de rukh\', \'text\': "Quand l\'Œuf de rukh est mis dans un cimetière depuis le jeu, mettez en jeu, à la fin du tour, un jeton de créature 4/4 rouge Oiseau avec le vol.", \'type\': \'Créature : œuf\', \'flavor\': "Appelés « Plumepierres » par les gens des basses terres, les rukhs seraient les descendants d\'un phénix qui, un jour, sacrifia sa flamme pour obtenir un corps de pierre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98328&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96abbe5f-f1e2-462a-b103-123cc40872e3\', \'multiverseId\': 98328}, \'multiverseid\': 98328}, {\'name\': \'Uovo di Rukh\', \'text\': "Quando l\'Uovo di Rukh viene messo in un cimitero dal gioco, metti in gioco una pedina creatura Uccello 4/4 rossa con volare alla fine del turno.", \'type\': \'Creatura — Uovo\', \'flavor\': \'Chiamati "pietrapiuma" da molti abitanti del bassopiano, si pensa che i rukh siano discendenti di una fenice che ha sacrificato il proprio fuoco in cambio di un corpo di pietra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99048&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3d341c4b-35df-42f0-9a5f-891aa4c58c44\', \'multiverseId\': 99048}, \'multiverseid\': 99048}, {\'name\': \'ルフ鳥の卵\', \'text\': \'ルフ鳥の卵が場から墓地に置かれたとき、ターン終了時に、飛行を持つ4/4の赤の鳥クリーチャー・トークンを１個場に出す。\', \'type\': \'クリーチャー — 卵\', \'flavor\': \'ルフ鳥は、低地に住む者からは"石の羽"と呼ばれ、炎を犠牲にする代わりに石の体を手に入れた不死鳥だと考えられている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99408&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2adbc430-436b-4a87-8852-ea9d2e9ebf0f\', \'multiverseId\': 99408}, \'multiverseid\': 99408}, {\'name\': \'Ovo de Rukh\', \'text\': \'Quando Ovo de Rukh é colocado num cemitério vindo de jogo, coloque em jogo no final do turno uma ficha de criatura vermelha 4/4 do tipo Pássaro com a habilidade de voar.\', \'type\': \'Criatura — Ovo\', \'flavor\': \'Chamados de "penas de pedra" por muitos das terras baixas, acredita-se que os rukhs descendem de uma fênix que sacrificou sua chama para ter um corpo de pedra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99768&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50fd2502-b550-4962-b4b2-e5107e0e85be\', \'multiverseId\': 99768}, \'multiverseid\': 99768}, {\'name\': \'Яйцо птицы рух\', \'text\': \'Когда Яйцо птицы рух выходит из игры и попадает на кладбище, введите в игру фишку красной Птицы со значением силы 4/4 до конца хода.\', \'type\': \'Существо — Яйцо\', \'flavor\': \'Многие жители равнин называют птицу рух "каменной птицей". Говорят, в нее превратилась птица феникс, променявшая свой огонь на каменное тело.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110039&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f5fa6cf8-6254-467d-b8bf-04e826e6f5e0\', \'multiverseId\': 110039}, \'multiverseid\': 110039}, {\'name\': \'鲁克鸟蛋\', \'text\': \'当鲁克鸟蛋从场上进入坟墓场，在回合结束时将一个4/4红色，具飞行异能的鸟衍生物放置进场。\', \'type\': \'生物～蛋\', \'flavor\': \'许多低地人唤作「石羽毛」的鲁克鸟，传说中起源自某只献祭其火焰以换取坚石身躯的凤凰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97968&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e4b2a337-fd48-434d-aef0-63c62b4de3ee\', \'multiverseId\': 97968}, \'multiverseid\': 97968}]', '[{\'name\': \'Räubernder Kavu\', \'text\': \'Immer wenn der Räubernde Kavu allein angreift, erhält er +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kavu\', \'flavor\': \'In jedem Wurf Kavu findet sich ein Junges, das sich weigert, mit dem Rudel zu jagen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98684&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d7152e70-fa7c-4f50-ae77-12609f51b8a0\', \'multiverseId\': 98684}, \'multiverseid\': 98684}, {\'name\': \'Kavu aislado\', \'text\': \'Siempre que el Kavu aislado ataque solo, obtiene +2/+0 hasta el final del turno.\', \'type\': \'Criatura — Kavu\', \'flavor\': \'Cada camada de kavu tiene un cachorro que se niega a cazar con la manada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100124&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5483189-b0cd-45e1-854b-8dfb459e4036\', \'multiverseId\': 100124}, \'multiverseid\': 100124}, {\'name\': \'Kavru solitaire\', \'text\': "À chaque fois que le Kavru solitaire attaque seul, il gagne +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : kavru\', \'flavor\': \'Chaque portée de kavru a un petit qui refuse de chasser avec la meute.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98324&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b4d1b1f-0506-4263-86f0-19ee5af75465\', \'multiverseId\': 98324}, \'multiverseid\': 98324}, {\'name\': \'Kavu Solitario\', \'text\': \'Ogniqualvolta il Kavu Solitario attacca da solo, prende +2/+0 fino alla fine del turno.\', \'type\': \'Creatura — Kavu\', \'flavor\': \'Ogni cucciolata di kavu comprende un esemplare che si rifiuta di cacciare con il branco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99044&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bbd389df-d35e-4a7a-bd29-557835d407f0\', \'multiverseId\': 99044}, \'multiverseid\': 99044}, {\'name\': \'はぐれカヴー\', \'text\': \'はぐれカヴーが単独で攻撃に参加するたび、それはターン終了時まで+2/+0の修整を受ける。\', \'type\': \'クリーチャー — カヴー\', \'flavor\': \'どんなカヴーの子供の中にも、群れの狩りに参加しないものが一匹はいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99404&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'12f1e440-f82a-415f-85bf-6347c0044893\', \'multiverseId\': 99404}, \'multiverseid\': 99404}, {\'name\': \'Kavu Desgarrado\', \'text\': \'Toda vez que Kavu Desgarrado atacar sozinho, ele recebe +2/+0 até o final do turno.\', \'type\': \'Criatura — Kavu\', \'flavor\': \'Toda ninhada de kavus tem um filhote que se recusa a caçar com o grupo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99764&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8d31839e-273f-40d0-a814-6f9262de0cf7\', \'multiverseId\': 99764}, \'multiverseid\': 99764}, {\'name\': \'Негодяй Каву\', \'text\': \'Каждый раз, когда Негодяй каву нападает один, он получает +2/+0 до конца хода.\', \'type\': \'Существо — Каву\', \'flavor\': \'В каждом семействе каву найдется сынок, который откажется охотиться вместе со всеми.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110035&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4be397c5-4b11-4040-9d7e-aa71ff311ffd\', \'multiverseId\': 110035}, \'multiverseid\': 110035}, {\'name\': \'独行卡甫\', \'text\': \'每当独行卡甫单独攻击时，它便得+2/+0直到回合结束。\', \'type\': \'生物～卡甫\', \'flavor\': \'每窝卡甫幼兽里，总会有一只不愿随群捕猎。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97964&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0cc53cb8-ecc6-4fb4-94df-d85b808ae6c0\', \'multiverseId\': 97964}, \'multiverseid\': 97964}]', '[{\'name\': \'Sagenkreis\', \'text\': \'Bestimme eine Farbe, sowie der Sagenkreis ins Spiel kommt.\\n{W}: Sobald eine Quelle der bestimmten Farbe, die du bestimmst, dir das nächste Mal in diesem Zug Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5339f5c8-2417-4db7-a833-2ca8dfd3f805\', \'multiverseId\': 98728}, \'multiverseid\': 98728}, {\'name\': \'Círculo de historias\', \'text\': \'En cuanto el Círculo de historias entre en juego, elige un color.\\n{W}: La próxima vez que una fuente de tu elección del color elegido fuera a hacerte daño este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100168&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1fc75265-de03-470f-8ac8-7e0ac0bf5dce\', \'multiverseId\': 100168}, \'multiverseid\': 100168}, {\'name\': \'Théâtre en cercle\', \'text\': "Au moment où le Théâtre en cercle arrive en jeu, choisissez une couleur.\\n{W} : La prochaine fois qu\'une source de votre choix de la couleur choisie devrait vous blesser ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98368&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54c99292-b8c3-432c-b9b0-23e3a9d527eb\', \'multiverseId\': 98368}, \'multiverseid\': 98368}, {\'name\': \'Circolo della Storia\', \'text\': \'Mentre il Circolo della Storia entra in gioco, scegli un colore.\\n{W}: La prossima volta che una fonte a tua scelta del colore scelto ti sta per infliggere danno in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99088&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'895f03f5-db9f-4302-8878-b6c5f928d211\', \'multiverseId\': 99088}, \'multiverseid\': 99088}, {\'name\': \'物語の円\', \'text\': \'物語の円が場に出るに際し、色を１色選ぶ。\\n{W}：このターン、あなたが選んだ、選ばれた色の発生源１つが次にあなたに与えるダメージをすべて軽減し、０にする。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99448&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'76884297-0c79-4c0b-ba06-63e5ba1dfb90\', \'multiverseId\': 99448}, \'multiverseid\': 99448}, {\'name\': \'Círculo de Histórias\', \'text\': \'Conforme Círculo de Histórias entra em jogo, escolha uma cor.\\n{W}: Na próxima vez que uma fonte de sua escolha da cor escolhida fosse causar dano a você neste turno, previna aquele dano.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99808&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5ce1cc96-02a8-4b63-b758-fefd41d993b3\', \'multiverseId\': 99808}, \'multiverseid\': 99808}, {\'name\': \'Круг истории\', \'text\': \'Когда Круг истории вступает в игру, выберите цвет.\\n{W}: В следующий раз, когда в этот ход источник указанного вами цвета будет наносить вам повреждения, предотвратите повреждения.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110079&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'85d17081-cac5-4f59-84e3-6d9a9138c55a\', \'multiverseId\': 110079}, \'multiverseid\': 110079}, {\'name\': \'诵传仪典\', \'text\': \'于诵传仪典进场时，选择一种颜色。\\n{W}：选择一个该色的伤害来源，于本回合中，防止该来源下一次将对你造成的伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98008&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ad5064cc-ba90-42ca-b22b-b1696f2c1b39\', \'multiverseId\': 98008}, \'multiverseid\': 98008}]', '[{\'name\': \'Sandsteinkrieger\', \'text\': \'Erstschlag (Diese Kreatur fügt Kampfschaden vor Kreaturen ohne Erstschlag zu.)\\n{R}: Der Sandsteinkrieger erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24fe3861-0d65-41f8-b378-0535beb1ffb5\', \'multiverseId\': 98694}, \'multiverseid\': 98694}, {\'name\': \'Guerrero de arenisca\', \'text\': \'Daña primero. (Esta criatura hace daño de combate antes que las criaturas sin la habilidad de dañar primero.)\\n{R}: El Guerrero de arenisca obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100134&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b8a9eb8-eba0-4efa-b720-815615ff5b50\', \'multiverseId\': 100134}, \'multiverseid\': 100134}, {\'name\': \'Guerrier de grès\', \'text\': "Initiative (Cette créature inflige des blessures de combat avant les créatures sans l\'initiative.)\\n{R} : Le Guerrier de grès gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98334&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'27091e07-8153-4eda-9eff-ee3a318bc8f7\', \'multiverseId\': 98334}, \'multiverseid\': 98334}, {\'name\': \'Guerriero di Arenaria\', \'text\': \'Attacco improvviso (Questa creatura infligge il danno da combattimento prima delle creature senza attacco improvviso.)\\n{R}: Il Guerriero di Arenaria prende +1/+0 fino alla fine del turno\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99054&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b46e5c49-1ad5-4823-b317-4cfb4f9ed273\', \'multiverseId\': 99054}, \'multiverseid\': 99054}, {\'name\': \'砂岩の戦士\', \'text\': \'先制攻撃 （このクリーチャーは先制攻撃を持たないクリーチャーよりも先に戦闘ダメージを与える。）\\n{R}：砂岩の戦士はターン終了時まで+1/+0の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99414&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82911007-a17d-458d-bde1-f150badaed2b\', \'multiverseId\': 99414}, \'multiverseid\': 99414}, {\'name\': \'Guerreiro de Arenito\', \'text\': \'Iniciativa (Esta criatura causa dano de combate antes de criaturas sem a habilidade de iniciativa.)\\n{R}: Guerreiro de Arenito recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99774&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'29fb85f8-dd8c-4ac6-a969-04f8e0bb0b9a\', \'multiverseId\': 99774}, \'multiverseid\': 99774}, {\'name\': \'Воин песчанника\', \'text\': \'Первый удар (Это существо наносит боевые повреждения раньше существ без способности первого удара).\\n{R}: Воин песчанника получает +1/+0 до конца хода.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110045&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'14777844-a4eb-4ecc-ba2e-80878dbd130a\', \'multiverseId\': 110045}, \'multiverseid\': 110045}, {\'name\': \'砂岩战士\', \'text\': \'先攻（此生物会比不具先攻异能的生物提前造成战斗伤害。）\\n{R}：砂岩战士得+1/+0直到回合结束。\', \'type\': \'生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97974&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd2ef7ed-43db-4eec-8d29-d76c1ca3cead\', \'multiverseId\': 97974}, \'multiverseid\': 97974}]', '[{\'name\': \'Savannenlöwen\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Selbst die Tapfersten werden dreifach vom Löwen erschreckt: erst von seinen Spuren, dann von seinem Brüllen, und schließlich von seinem Angesicht. —Sprichwort aus Somalia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8f7edb4-f16f-43fe-a685-fd00db5fee81\', \'multiverseId\': 98695}, \'multiverseid\': 98695}, {\'name\': \'Leones de la sabana\', \'type\': \'Criatura — Felino\', \'flavor\': \'Incluso los valientes se asustan con el león tres veces: primero, al ver sus huellas; luego, al oír su rugido; y finalmente, al verlo cara a cara. —Proverbio somalí\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100135&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5f131bc-2b79-4e66-9cdd-eb4561f2d161\', \'multiverseId\': 100135}, \'multiverseid\': 100135}, {\'name\': \'Lions des savanes\', \'type\': \'Créature : chat\', \'flavor\': "Par trois fois, le plus brave est effrayé par le lion : d\'abord en voyant ses traces, ensuite en entendant son rugissement, et finalement en l\'affrontant. —Proverbe somalien", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98335&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'320e9f12-12ea-49a4-90a9-d29345b745c0\', \'multiverseId\': 98335}, \'multiverseid\': 98335}, {\'name\': \'Leoni della Savana\', \'type\': \'Creatura — Felino\', \'flavor\': \'Anche il coraggioso viene spaventato tre volte dal leone: prima dalle sue tracce, poi dal suo ruggito e infine dalla vista delle sue fauci. —Proverbio somalo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99055&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad18541a-fec3-4d41-9615-8b0ea6ff085c\', \'multiverseId\': 99055}, \'multiverseid\': 99055}, {\'name\': \'サバンナ・ライオン\', \'type\': \'クリーチャー — 猫\', \'flavor\': \'勇者たれども、ライオンには三度驚かされる。一度は足跡に、一度は咆哮に、一度は直面して。 ――ソマリの諺\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99415&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85b35b18-a3d1-4d9a-ae47-d9e9b82eedcb\', \'multiverseId\': 99415}, \'multiverseid\': 99415}, {\'name\': \'Leões da Savana\', \'type\': \'Criatura — Felino\', \'flavor\': \'Até os bravos são assustados três vezes por um leão: primeiro por suas pegadas, depois por seu rugido e, por último, pela encarada. — Provérbio Somali\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99775&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'50a50980-967d-4e7e-b438-5dc2c3747ba7\', \'multiverseId\': 99775}, \'multiverseid\': 99775}, {\'name\': \'Львы саванны\', \'type\': \'Существо — Кошка\', \'flavor\': \'Даже самый смелый пугается льва в трех случаях: когда видит его следы, когда слышит его рык и когда сталкивается с ним нос к носу. — Сомалийская пословица\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110046&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2db3f595-2ed7-4836-a7fa-f92b2e97430c\', \'multiverseId\': 110046}, \'multiverseid\': 110046}, {\'name\': \'草原雄狮\', \'type\': \'生物～猫\', \'flavor\': \'连勇士都会给狮子惊吓三次：先是其踪迹，接下来是其吼声，而面对面则是最后一次。 ～索马利谚语\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97975&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'29eb746d-6d39-4597-80d6-cd9cc080bd96\', \'multiverseId\': 97975}, \'multiverseid\': 97975}]', '[{\'name\': \'Scharfzahnratten\', \'text\': \'Furcht (Diese Kreatur kann nur von Artefaktkreaturen und/oder schwarzen Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Ratte\', \'flavor\': \'„Sowohl Männer als auch Ratten lüstert es: uns nach unserem Spielzeug, den Ratten nach uns."—Crovax, Aufsteigender Evincar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98672&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'51d99e19-02ab-4820-a606-d718288c393c\', \'multiverseId\': 98672}, \'multiverseid\': 98672}, {\'name\': \'Ratas voraces\', \'text\': \'Inspirar temor. (Esta criatura no puede ser bloqueada excepto por criaturas artefacto y/o criaturas negras.)\', \'type\': \'Criatura — Rata\', \'flavor\': \'"Los hombres y las ratas anhelan: nosotros nuestros juguetes; ellas, a nosotros."Crovax, évincar predominante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100112&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4b185b4-d2b9-43de-b89b-56e611642502\', \'multiverseId\': 100112}, \'multiverseid\': 100112}, {\'name\': \'Rats aux dents tranchantes\', \'text\': \'Peur (Cette créature ne peut pas être bloquée excepté par des créatures-artefacts et/ou des créatures noires.)\', \'type\': \'Créature : rat\', \'flavor\': \'« Les hommes salivent autant que les rats : nous, en songeant aux plaisirs de la chair ; eux, en songeant au goût de la nôtre. »Crovax, incarmal\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'efe861e1-d1a9-43de-9eec-dbac7fc9e3a5\', \'multiverseId\': 98312}, \'multiverseid\': 98312}, {\'name\': \'Ratti dai Denti di Rasoio\', \'text\': \'Paura (Questa creatura non può essere bloccata tranne che da creature artefatto e/o da creature nere.)\', \'type\': \'Creatura — Ratto\', \'flavor\': \'"Sia gli uomini sia i ratti hanno i loro appetiti: noi per i nostri gingilli; loro, per noi."Crovax, evincaro dominante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99032&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fc2795b5-7282-4f98-842b-0772b3e7ce1c\', \'multiverseId\': 99032}, \'multiverseid\': 99032}, {\'name\': \'カミソリネズミ\', \'text\': \'畏怖 （このクリーチャーはアーティファクトでも黒でもないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — ネズミ\', \'flavor\': \'人もネズミも飢えている。われら人間は退屈しのぎに。そしてネズミは、われわれに。――隆盛なるエヴィンカー、クロウヴァクス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99392&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1d0b9d91-017d-496a-8c2d-b9cfba98f5b2\', \'multiverseId\': 99392}, \'multiverseid\': 99392}, {\'name\': \'Ratos de Dentes Navalhados\', \'text\': \'Amedrontar (Esta criatura só pode ser bloqueada por criaturas pretas e/ou criaturas artefato.)\', \'type\': \'Criatura — Rato\', \'flavor\': \'"Homens e ratos, ambos temos anseios: nós, por nossos brinquedos; eles, por nós." Crovax, evincar ascendente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99752&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'002c6f81-f5e2-434e-893e-1c8b7fa8d774\', \'multiverseId\': 99752}, \'multiverseid\': 99752}, {\'name\': \'Саблезубые крысы\', \'text\': \'Страх (Это существо может быть заблокировано только артефактным существом и/или черным существом).\', \'type\': \'Существо — Крыса\', \'flavor\': \'"И люди, и крысы изголодались: мы, люди, - по зрелищам, а крысы по нам". — Кровакс, правящий эвинкар\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110023&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d4050caf-9dd1-415f-a067-5786ee91b82e\', \'multiverseId\': 110023}, \'multiverseid\': 110023}, {\'name\': \'利齿鼠\', \'text\': \'恐惧（此生物只能被神器和／或黑色生物阻挡。）\', \'type\': \'生物～老鼠\', \'flavor\': \'「人和鼠都会饿：我们吃我们的玩物，老鼠却吃我们。」～天威大魔将寇维克斯\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97952&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'43e9dde0-ea1b-4a16-9bf9-1a4e17f0ef04\', \'multiverseId\': 97952}, \'multiverseid\': 97952}]', '[{\'name\': \'Schatzhort\', \'text\': \'{2}{U}{U}: Ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'„... der Mensch begehrt alles an sich zu reißen, um nur nach Belieben damit schalten und walten zu können." —Johann Wolfgang von Goethe, „Lehrjahre"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98755&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6abce62f-56e9-476f-af2d-8ddc7372354e\', \'multiverseId\': 98755}, \'multiverseid\': 98755}, {\'name\': \'Descubrimiento del tesoro\', \'text\': \'{2}{U}{U}: Roba una carta.\', \'type\': \'Encantamiento\', \'flavor\': \'"La riqueza es poder; el poder de someter, de aplastar, de explotar, el poder de esclavizar, de ultrajar, de degradar." —Emma Goldman, "Anarquismo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100195&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df943078-9763-468d-8d0c-2a46016c700a\', \'multiverseId\': 100195}, \'multiverseid\': 100195}, {\'name\': \'Caverne au trésor\', \'text\': \'{2}{U}{U} : Piochez une carte.\', \'type\': \'Enchantement\', \'flavor\': "« Ou le luxe est l\'effet des richesses, ou il les rend nécessaires ; il corrompt à la fois le riche et le pauvre, l\'un par la possession, l\'autre par la convoitise. » —Jean-Jacques Rousseau", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98395&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a1aedef9-c2e7-422d-ba2d-22162b6b0652\', \'multiverseId\': 98395}, \'multiverseid\': 98395}, {\'name\': \'Tesoro Ritrovato\', \'text\': \'{2}{U}{U}: Pesca una carta\', \'type\': \'Incantesimo\', \'flavor\': \'"La ricchezza significa potere; il potere di sottomettere, di schiacciare, di sfruttare, il potere di schiavizzare, di oltraggiare, di degradare." —Emma Goldman, "Anarchia"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84b3e0bd-9bfc-42e1-80d2-4364cd4526be\', \'multiverseId\': 99115}, \'multiverseid\': 99115}, {\'name\': \'貴重な収集品\', \'text\': \'{2}{U}{U}：カードを１枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'富は力である。征服し、破壊し、搾取する力であり、隷属させ、踏みにじり、堕落させる力である。 ――エマ・ゴールドマン「無政府主義」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99475&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d0dda268-8080-469c-978e-32f2be6e6e48\', \'multiverseId\': 99475}, \'multiverseid\': 99475}, {\'name\': \'Reintegração do Tesouro\', \'text\': \'{2}{U}{U}: Compre um card.\', \'type\': \'Encantamento\', \'flavor\': \'"A riqueza significa poder; o poder para subjugar, massacrar, explorar, o poder para escravizar, ultrajar, degradar." — Emma Goldman, "Anarquismo"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99835&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3b4c382c-a21d-4d89-afd0-392ef7ffbbcc\', \'multiverseId\': 99835}, \'multiverseid\': 99835}, {\'name\': \'Сокровищница\', \'text\': \'{2}{U}{U}: Возьмите карту.\', \'type\': \'Чары\', \'flavor\': \'"Богатство это власть, власть подчинять, ломать, использовать, власть порабощать, впадать в бешенство и деградировать". — Эмма Голдман, "Анархизм"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110106&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aa5d8667-d648-427c-9d0b-399c19d104c8\', \'multiverseId\': 110106}, \'multiverseid\': 110106}, {\'name\': \'发掘物\', \'text\': \'{2}{U}{U}：抓一张牌。\', \'type\': \'结界\', \'flavor\': \'「财富即力量；是征服，压榨，剥削的力量，是奴役，施暴，堕落的力量。」 ～艾玛‧高德曼，「无政府主义」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eee533d1-5333-4faa-a508-948bb3423f9e\', \'multiverseId\': 98035}, \'multiverseid\': 98035}]', '[{\'name\': \'Schiefertafel der Ahnen\', \'text\': \'{4}, {T}, wirf alle Karten aus deiner Hand ab: Ziehe für jede Kreatur, die du kontrollierst, eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Das Muster des Lebens kann wie ein Buch gelesen werden, wenn du die Systematik kennst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98716&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a411e96-de7c-4c13-8e0a-63e1814b047b\', \'multiverseId\': 98716}, \'multiverseid\': 98716}, {\'name\': \'Pizarra de los ancestros\', \'text\': \'{4}, {T}, descartar tu mano: Roba una carta por cada criatura que controles.\', \'type\': \'Artefacto\', \'flavor\': \'El patrón de la vida puede estudiarse como un libro si se sabe cómo leerlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100156&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'162250c0-1460-4a9b-974c-0949f3cdc0f5\', \'multiverseId\': 100156}, \'multiverseid\': 100156}, {\'name\': "Ardoise de l\'Ascendance", \'text\': \'{4}, {T}, Défaussez-vous de votre main : Piochez une carte pour chaque créature que vous contrôlez.\', \'type\': \'Artefact\', \'flavor\': "L\'empreinte de la vie peut être étudiée comme un livre, si on sait comment la déchiffrer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98356&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f883d6b9-c8f3-4d0d-af74-92d046ee05b8\', \'multiverseId\': 98356}, \'multiverseid\': 98356}, {\'name\': \'Tavola del Principio\', \'text\': \'{4}, {T}, Scarta la tua mano: Pesca una carta per ogni creatura che controlli.\', \'type\': \'Artefatto\', \'flavor\': \'La trama della vita può essere studiata come un libro, se sai come leggerla.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99076&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b7b2b2e-bd66-4864-becb-acf953c527f5\', \'multiverseId\': 99076}, \'multiverseid\': 99076}, {\'name\': \'系図の石版\', \'text\': \'{4}, {T}, あなたの手札をすべて捨てる：あなたがコントロールするクリーチャー１体につきカードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'生命のパターンは、本と同じように学ぶことができる。読み方がわかればの話だが。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99436&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'00f65e9f-e292-4a8b-8c0c-ffa713fdcd51\', \'multiverseId\': 99436}, \'multiverseid\': 99436}, {\'name\': \'Registro de Genealogia\', \'text\': \'{4}, {T}, Descarte sua mão: Compre um card para cada criatura que você controla.\', \'type\': \'Artefato\', \'flavor\': \'O padrão da vida pode ser estudado como um livro, se você souber como lê-lo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99796&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'53b8b3e9-f111-4a08-80d4-118bd3f4cad3\', \'multiverseId\': 99796}, \'multiverseid\': 99796}, {\'name\': \'Табличка древнего рода\', \'text\': \'{4}, {T}, Сбросьте руку: возьмите столько карт, сколько существ вы контролируете.\', \'type\': \'Артефакт\', \'flavor\': \'Образ жизни можно изучать, как книгу, нужно только научиться ее читать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110067&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f69ea7c-5be8-4e96-9423-f19ef92a5ca1\', \'multiverseId\': 110067}, \'multiverseid\': 110067}, {\'name\': \'古传石板\', \'text\': \'{4}，{T}，弃掉你的手牌：你每操控一个生物，便抓一张牌。\', \'type\': \'神器\', \'flavor\': \'只要通晓解读之法，便能尽览生命奥秘。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97996&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4a2f44c5-c91e-42cc-a688-dae3bea5b45d\', \'multiverseId\': 97996}, \'multiverseid\': 97996}]', "[{'name': 'Schlangenkrieger', 'text': 'Du verlierst 3 Lebenspunkte, wenn der Schlangenkrieger ins Spiel kommt.', 'type': 'Kreatur — Ophis, Krieger', 'flavor': 'Sie sind von Sumpfgasen infiziert und schärfen ihre Fangzähne an Zombiefleisch. Mit Schlangenkriegern ist nicht zu spaßen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98705&type=card', 'language': 'German', 'identifiers': {'scryfallId': '51efbcdf-9fb7-47de-be58-620cd79039b8', 'multiverseId': 98705}, 'multiverseid': 98705}, {'name': 'Guerrero serpiente', 'text': 'Cuando el Guerrero serpiente entre en juego, pierde 3 vidas.', 'type': 'Criatura — Guerrero víbora', 'flavor': 'Los incuban gases del pantano y afilan los dientes en carne de zombie. Nunca tomes a la ligera a los guerreros serpiente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100145&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '15505d31-f935-459d-9671-6118591a8c81', 'multiverseId': 100145}, 'multiverseid': 100145}, {'name': 'Guerrier serpentiforme', 'text': 'Quand le Guerrier serpentiforme arrive en jeu, vous perdez 3 points de vie.', 'type': 'Créature : serpent et guerrier', 'flavor': 'Ils sont allaités aux gaz des marais et ils se font les dents sur les zombies. On ne badine pas avec les guerriers serpentiformes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98345&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f55e9fb4-628b-4c73-a66a-7b223c5d3479', 'multiverseId': 98345}, 'multiverseid': 98345}, {'name': 'Guerriero Serpente', 'text': 'Quando il Guerriero Serpente entra in gioco, perdi 3 punti vita.', 'type': 'Creatura — Guerriero Serpente', 'flavor': 'Sono covati dai gas della palude e si fanno i denti con la carne di zombie. I guerrieri serpenti non vanno presi alla leggera.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99065&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '33545eac-84db-4e29-8c1c-7f022a5dc613', 'multiverseId': 99065}, 'multiverseid': 99065}, {'name': '蛇人間の戦士', 'text': '蛇人間の戦士が場に出たとき、あなたは３点のライフを失う。', 'type': 'クリーチャー — 蛇・戦士', 'flavor': '彼らは沼の瘴気の中で孵り、ゾンビの肉で経験を積む。 蛇人間の戦士をあなどっちゃいけない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99425&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '24f72590-2e41-4c95-a5a5-4be89d6ee4f5', 'multiverseId': 99425}, 'multiverseid': 99425}, {'name': 'Guerreiro Serpente', 'text': 'Quando Guerreiro Serpente entra em jogo, você perde 3 pontos de vida.', 'type': 'Criatura — Guerreiro Cobra', 'flavor': 'Eles são chocados pelos gases do pântano e afiam seus dentes em carne de zumbi. Guerreiros serpentes não devem ser menosprezados.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99785&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dc5cae13-2d4b-48ee-b61f-59c4e88b1b7d', 'multiverseId': 99785}, 'multiverseid': 99785}, {'name': 'Змей-воин', 'text': 'Когда Змей-воин вступает в игру, вы теряете 3 пункта жизни.', 'type': 'Существо — Змея Воин', 'flavor': 'Они выросли среди болотных испарений и наточили зубы о тела зомби. Со Змеями-воинами шутки плохи.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110056&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6b207b47-6164-4a6f-9d8f-277a4f4fabe9', 'multiverseId': 110056}, 'multiverseid': 110056}, {'name': '巨蛇战士', 'text': '当巨蛇战士进场时，你失去3点生命。', 'type': '生物～蛇／战士', 'flavor': '瘴气育其身躯，灵俑饱其肚腹； 巨蛇战士绝不可等闲视之。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97985&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fd9e8c3f-9fdb-4f92-bef8-60af12af50fe', 'multiverseId': 97985}, 'multiverseid': 97985}]", '[{\'name\': \'Schleichender Schimmel\', \'text\': \'Zerstöre ein Artefakt, eine Verzauberung oder ein Land deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Der Schimmel kroch über die Mauern und in jede Spalte, bis der glänzende weiße Stein sich verformte und zerbarst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83657de4-5a2b-4bf8-9cf9-419e58bd945e\', \'multiverseId\': 98491}, \'multiverseid\': 98491}, {\'name\': \'Moho reptante\', \'text\': \'Destruye el artefacto, encantamiento o tierra objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'El moho subió por los muros y entró en todas las grietas hasta que la brillante piedra blanca no aguantó más y se rompió.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99931&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9df2950d-f7d6-4147-b6c4-7e6eccf71f47\', \'multiverseId\': 99931}, \'multiverseid\': 99931}, {\'name\': \'Moisissure rampante\', \'text\': "Détruisez l\'artefact ciblé, l\'enchantement ciblé ou le terrain ciblé.", \'type\': \'Rituel\', \'flavor\': "« Il tombait en désuétude. La moisissure l\'envahissait, les fleurs le quittaient. » —Victor Hugo, Les Misérables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98131&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0b7bbaf6-b4f8-4d8c-a750-af87425d0fc8\', \'multiverseId\': 98131}, \'multiverseid\': 98131}, {\'name\': \'Muffa Insidiosa\', \'text\': \'Distruggi un artefatto, un incantesimo o una terra bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'La muffa si arrampicò sulle mura e si insinuò in ogni crepa, fino a quando la bianca e scintillante pietra cedette ed esplose.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98851&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'58301fcf-fff3-4c2a-9b31-cfd6e80158ff\', \'multiverseId\': 98851}, \'multiverseid\': 98851}, {\'name\': \'忍び寄るカビ\', \'text\': \'アーティファクト１つかエンチャント１つか土地１つを対象とし、それを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'カビは壁を越えて石の割れ目に入り込んだ。光る白い石はとうとう耐え切れずに破裂した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99211&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2a5dc40-6cd2-4a7a-ab41-fc6b2dc5b13d\', \'multiverseId\': 99211}, \'multiverseid\': 99211}, {\'name\': \'Bolor Invasor\', \'text\': \'Destrói o artefato, o encntamento ou o terreno alvo.\', \'type\': \'Feitiço\', \'flavor\': \'O bolor espalhou-se pelas paredes e penetrou cada fenda, até que a reluzente pedra branca deformou-se e explodiu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99571&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fe34ece4-6cbc-4302-a7e6-b5ce48396373\', \'multiverseId\': 99571}, \'multiverseid\': 99571}, {\'name\': \'Ползучая плесень\', \'text\': \'Уничтожьте целевой артефакт, чары или землю.\', \'type\': \'Волшебство\', \'flavor\': \'Плесень покрыла все стены, проникла в каждую щель, пока блестящий белый камень не рассыпался от ее натиска.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109842&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'605a9974-efa0-4324-a4de-5011309231d0\', \'multiverseId\': 109842}, \'multiverseid\': 109842}, {\'name\': \'爬行腐霉\', \'text\': \'消灭目标神器，结界，或地。\', \'type\': \'法术\', \'flavor\': \'腐霉爬过墙垣，侵入每处缝隙，直到白净的岩石支撑不住而爆裂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97771&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dcb11d69-7c91-454e-846f-13cbf5e9484f\', \'multiverseId\': 97771}, \'multiverseid\': 97771}]', '[{\'name\': \'Schmelzsteinbeißer\', \'text\': \'{R}: Der Schmelzsteinbeißer erhält +1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Was ist besser als Dinge mit Steinen zu zertrümmern? Ein Stein, der aufsteht und Dinge für dich zertrümmert." —Toggo, Goblin-Waffenschmied\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98533&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11ad4aed-6b98-40e2-85bc-67643e29a3e9\', \'multiverseId\': 98533}, \'multiverseid\': 98533}, {\'name\': \'Triturador de piedra variable\', \'text\': \'{R}: El Triturador de piedra variable obtiene +1/-1 hasta el final del turno.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'"¿Qué es mejor que aplastar cosas con piedras? Una piedra que se levanta y aplasta cosas por tí." —Toggo, armero trasgo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99973&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34bc278b-61bb-4266-8083-5cd43d794e71\', \'multiverseId\': 99973}, \'multiverseid\': 99973}, {\'name\': \'Écrabouilleur de fluipierre\', \'text\': "{R} : L\'Écrabouilleur de fluipierre gagne +1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : bête\', \'flavor\': "« Qu\'y a-t-il de mieux que tout casser avec une pierre ? Avoir une pierre qui bouge et qui casse tout pour vous. » —Toggo, forgeur d\'armes gobelin", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98173&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2869cc38-325b-41f1-bedd-6410670fad6d\', \'multiverseId\': 98173}, \'multiverseid\': 98173}, {\'name\': \'Sgretolatore di Mutaroccia\', \'text\': \'{R}: Lo Sgretolatore di Mutaroccia prende +1/-1 fino alla fine del turno.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'"Cosa c\\\'è di meglio che spaccare le cose con una roccia? Una roccia che si alza e spacca le cose al tuo posto." —Toggo, fabbro goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98893&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'93fd7fec-6383-4ab3-9723-48e156b32825\', \'multiverseId\': 98893}, \'multiverseid\': 98893}, {\'name\': \'流動石の粉砕獣\', \'text\': \'{R}：流動石の粉砕獣はターン終了時まで+1/-1の修整を受ける。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'石で殴るよりいいこと知ってるか？ お前のために動いて殴ってくれる石さ。 ――ゴブリンの武器鍛冶、トーゴ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99253&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c64ce527-bfdd-453b-b92a-30e51f69f809\', \'multiverseId\': 99253}, \'multiverseid\': 99253}, {\'name\': \'Esmagador de Rochafluente\', \'text\': \'{R}: Esmagador de Rochafluente recebe +1/-1 até o final do turno.\', \'type\': \'Criatura — Besta\', \'flavor\': \'"O que é melhor do que destruir coisas com uma rocha? Uma rocha que levanta e destrói as coisas para você." — Toggo, armeiro goblin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99613&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95b25124-1cbd-4419-82a5-25abc481ff48\', \'multiverseId\': 99613}, \'multiverseid\': 99613}, {\'name\': \'Каменный разрушитель\', \'text\': \'{R}: Каменный разрушитель получает +1/-1 до конца хода.\', \'type\': \'Существо — Зверь\', \'flavor\': \'"Что может быть лучше, чем крушить все вокруг огромным камнем? Лучше, когда камень сам крушит все вокруг". — Тогго, гоблин-оружейник\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109884&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5056844f-a1c5-4fde-845b-6d4b22b4cc53\', \'multiverseId\': 109884}, \'multiverseid\': 109884}, {\'name\': \'液石碾破兽\', \'text\': \'{R}：液石碾破兽得+1/-1直到回合结束。\', \'type\': \'生物～野兽\', \'flavor\': \'「知道什么比用石头打烂东西还棒吗？ 就是会自己跳起来替你打烂东西的石头。」 ～精灵武器匠挞勾\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97813&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'419f7fe1-26ed-4c0d-a722-2cdb9a468fce\', \'multiverseId\': 97813}, \'multiverseid\': 97813}]', '[{\'name\': \'Schmelzsteinrutsch\', \'text\': \'Alle Kreaturen erhalten +X/-X bis zum Ende des Zuges.\', \'type\': \'Hexerei\', \'flavor\': \'Es mag wohl wie fester Boden erscheinen, doch ist es von Natur her heimtückisch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2afa6343-4400-4540-aabd-f3714e4d2bb6\', \'multiverseId\': 98535}, \'multiverseid\': 98535}, {\'name\': \'Alud de piedra variable\', \'text\': \'Todas las criaturas obtienen +X/-X hasta el final del turno.\', \'type\': \'Conjuro\', \'flavor\': \'Puede parecer tierra, pero su naturaleza es la malicia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99975&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0d163b07-283d-43d6-b7b8-62feddde1be6\', \'multiverseId\': 99975}, \'multiverseid\': 99975}, {\'name\': \'Coulée de fluipierre\', \'text\': "Toutes les créatures gagnent +X/-X jusqu\'à la fin du tour.", \'type\': \'Rituel\', \'flavor\': \'Elle a beau ressembler à de la boue, elle est tout de même de nature malicieuse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a37f1a6-c4f0-4a52-886e-951d03cef5ab\', \'multiverseId\': 98175}, \'multiverseid\': 98175}, {\'name\': \'Valanga di Mutaroccia\', \'text\': \'Tutte le creature prendono +X/-X fino alla fine del turno.\', \'type\': \'Stregoneria\', \'flavor\': \'Può sembrare normale terreno, ma ha una natura malevola.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98895&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'861468c9-0710-46b4-82f1-d5a88bb9254c\', \'multiverseId\': 98895}, \'multiverseid\': 98895}, {\'name\': \'流動石の山崩れ\', \'text\': \'すべてのクリーチャーは、ターン終了時まで+X/-Xの修整を受ける。\', \'type\': \'ソーサリー\', \'flavor\': \'一見すると普通の土のようだが、その性質の悪さといったらね。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99255&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce8779c9-6102-4917-8530-c5cb81c097c5\', \'multiverseId\': 99255}, \'multiverseid\': 99255}, {\'name\': \'Deslize de Rochafluente\', \'text\': \'Todas as criaturas recebem +X/-X até o final do turno.\', \'type\': \'Feitiço\', \'flavor\': \'Pode parecer com solo, mas a sua natureza é maligna.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99615&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f849bbf2-4e42-4137-92c7-907b17fc7ab4\', \'multiverseId\': 99615}, \'multiverseid\': 99615}, {\'name\': \'Каменный оползень\', \'text\': \'Все существа получают +X/-X до конца хода.\', \'type\': \'Волшебство\', \'flavor\': \'Может показаться, что это твердая почва, но за ним кроются злобные силы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109886&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e1ec8e8f-c1a2-4c3e-9f5c-3ef08727d883\', \'multiverseId\': 109886}, \'multiverseid\': 109886}, {\'name\': \'液石滑动\', \'text\': \'所有生物得+X/-X直到回合结束。\', \'type\': \'法术\', \'flavor\': \'它外表像是土壤，里面却包藏祸心。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97815&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74c0f770-58cc-4896-96cb-e4f1845a1157\', \'multiverseId\': 97815}, \'multiverseid\': 97815}]', '[{\'name\': \'Schmelzsteinwanderer\', \'text\': \'{R}: Der Schmelzsteinwanderer erhält +1/-1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Schmelzsteinwanderer taugen nicht als Soldaten sie können einfach nicht im Gleichschritt marschieren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98534&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'78304875-5953-4d9c-a629-49bc44170b2b\', \'multiverseId\': 98534}, \'multiverseid\': 98534}, {\'name\': \'Arrastrapies de piedra variable\', \'text\': \'{R}: El Arrastrapies de piedra variable obtiene +1/-1 hasta el final del turno.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Es notoriamente complicado mantener las tropas de piedra variable en formación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99974&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'81d7bca9-dd55-4098-be15-9f3ed44faf16\', \'multiverseId\': 99974}, \'multiverseid\': 99974}, {\'name\': \'Escogriffe de fluipierre\', \'text\': "{R} : L\'Escogriffe de fluipierre gagne +1/-1 jusqu\'à la fin du tour.", \'type\': \'Créature : bête\', \'flavor\': \'Il est toujours difficile de maintenir des troupes de fluipierre en formation.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98174&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6717df52-417f-426d-be6e-a6be1daa9128\', \'multiverseId\': 98174}, \'multiverseid\': 98174}, {\'name\': \'Errante di Mutaroccia\', \'text\': "{R}: L\'Errante di Mutaroccia prende +1/-1 fino alla fine del turno.", \'type\': \'Creatura — Bestia\', \'flavor\': \'Le truppe di mutaroccia sono notoriamente difficili da tenere in formazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98894&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b571c3b8-eff5-46a6-8b75-b2a594c364c4\', \'multiverseId\': 98894}, \'multiverseid\': 98894}, {\'name\': \'流動石のシャンブラー\', \'text\': \'{R}：流動石のシャンブラーはターン終了時まで+1/-1の修整を受ける。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'流動石の軍隊は、隊列を保つことができないので有名だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99254&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a3ab981f-1fb4-45fa-ace2-5b274ca54c6e\', \'multiverseId\': 99254}, \'multiverseid\': 99254}, {\'name\': \'Trôpego de Rochafluente\', \'text\': \'{R}: Trôpego de Rochafluente recebe +1/-1 até o final do turno.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Tropas de rochafluente são notoriamente difíceis de manter em formação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99614&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cef4e467-ddfa-4c7a-9fc7-e35813776b51\', \'multiverseId\': 99614}, \'multiverseid\': 99614}, {\'name\': \'Каменный бродяга\', \'text\': \'{R}: Каменный бродяга получает +1/-1 до конца хода.\', \'type\': \'Существо — Зверь\', \'flavor\': \'Доподлинно известно, что непросто собрать вместе каменных воинов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109885&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c943455f-9b04-40ec-917c-4c2b3627bdde\', \'multiverseId\': 109885}, \'multiverseid\': 109885}, {\'name\': \'液石跛行兽\', \'text\': \'{R}：液石跛行兽得到+1/-1直到回合结束。\', \'type\': \'生物～野兽\', \'flavor\': \'液石军团以队形散乱而出名。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aeb78b92-a4f4-49de-b952-0636ad38d1d2\', \'multiverseId\': 97814}, \'multiverseid\': 97814}]', '[{\'name\': \'Schock\', \'text\': \'Schock fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Ich habe einmal einen Goblin gesehen, der einen Sturm anbrüllte. Er verlor diesen Streit sehr schnell." —Wandernder Magier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98712&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56e0ae08-6587-41fb-abf1-682db549020e\', \'multiverseId\': 98712}, \'multiverseid\': 98712}, {\'name\': \'Choque\', \'text\': \'El Choque hace 2 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Una vez vi a un trasgo gritándole a una tormenta eléctrica. Perdió la discusión bastante rápido." —Mago errante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100152&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8a82b212-6e01-42d0-a250-723006072d1f\', \'multiverseId\': 100152}, \'multiverseid\': 100152}, {\'name\': \'Choc\', \'text\': \'Le Choc inflige 2 blessures à une cible, créature ou joueur.\', \'type\': \'Éphémère\', \'flavor\': "« Une fois, j\'ai vu un gobelin crier sur la tempête. La dispute s\'est rapidement terminée. » —Un mage itinérant", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98352&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1411f5aa-5be3-403d-ad84-a8e0cb806a0e\', \'multiverseId\': 98352}, \'multiverseid\': 98352}, {\'name\': \'Shock\', \'text\': \'Lo Shock infligge 2 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Una volta ho visto un goblin urlare contro un temporale. Ha avuto la peggio piuttosto in fretta." —Mago ramingo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99072&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d8457506-1bc7-4f5f-aaf0-38ddfcddaab1\', \'multiverseId\': 99072}, \'multiverseid\': 99072}, {\'name\': \'ショック\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。ショックはそれに２点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'ゴブリンが雷雨の中で叫んでたのを見たことがあるよ。 あっという間にその口論に負けてたがな。 ――放浪の魔道士\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99432&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e8081e8a-6897-41eb-80f8-465442138b13\', \'multiverseId\': 99432}, \'multiverseid\': 99432}, {\'name\': \'Choque\', \'text\': \'Choque causa 2 pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Uma vez eu vi um goblin gritando para uma tempestade de raios. Ele perdeu a discussão bem rápido." — Mago errante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99792&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5cdd0e59-9398-45a6-a7e8-2a55e1cf42cb\', \'multiverseId\': 99792}, \'multiverseid\': 99792}, {\'name\': \'Шок\', \'text\': \'Шок наносит 2 повреждения целевому существу или игроку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'"Однажды я услышал, как гоблин орет на грозовую тучу. Очень быстро у него закончились аргументы". — Странствующий маг\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110063&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5200be6e-3b2c-48d6-aa4f-8e5e002a0557\', \'multiverseId\': 110063}, \'multiverseid\': 110063}, {\'name\': \'电震\', \'text\': \'电震对目标生物或牌手造成2点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「我曾见过精灵向着雷霆风暴咆哮。 这场架他很快就吵输了。」 ～流浪法师\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97992&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f79d4538-ef08-4654-83ac-0cf6f73712d4\', \'multiverseId\': 97992}, \'multiverseid\': 97992}]', '[{\'name\': \'Schrecken der Schrecken\', \'text\': \'Opfere einen Sumpf: Regeneriere eine schwarze Kreatur deiner Wahl. (Das nächste Mal, dass diese Kreatur in diesem Zug zerstört würde, wird sie nicht zerstört. Tappe sie stattdessen, entferne allen Schaden von ihr und entferne sie aus dem Kampf.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98576&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dcf1d335-b181-4e4c-8857-c580b4915254\', \'multiverseId\': 98576}, \'multiverseid\': 98576}, {\'name\': \'Horror de horrores\', \'text\': \'Sacrificar un pantano: Regenera la criatura objetivo negra. (La próxima vez que esa criatura fuera a ser destruida este turno, no lo es. En vez de eso, gírala, remueve todo el daño de ella y remuévela del combate.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100016&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db5af1ec-39f4-41d1-93b8-57adab164d71\', \'multiverseId\': 100016}, \'multiverseid\': 100016}, {\'name\': \'Horreur des horreurs\', \'text\': "Sacrifiez un marais : Régénérez la créature noire ciblée. (La prochaine fois que cette créature devrait être détruite ce tour-ci, elle ne l\'est pas. À la place, engagez-la, retirez-lui toutes ses blessures et retirez-la du combat.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98216&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'186a49e2-94e8-4871-8502-51aedfd5f422\', \'multiverseId\': 98216}, \'multiverseid\': 98216}, {\'name\': \'Orrore degli Orrori\', \'text\': \'Sacrifica una Palude: Rigenera una creatura bersaglio nera. (La prossima volta che quella creatura sta per essere distrutta in questo turno, non viene distrutta. Invece TAPpala, rimuovi tutti i danni da essa e rimuovila dal combattimento.)\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98936&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'582457b8-5e9b-442d-810c-ba519d0cd881\', \'multiverseId\': 98936}, \'multiverseid\': 98936}, {\'name\': \'恐怖の中の恐怖\', \'text\': \'沼を１つ生け贄に捧げる：黒のクリーチャー１体を対象とし、それを再生する。 （このターン、次にそのクリーチャーが破壊される場合、破壊されない。 代わりに、それをタップし、それに与えられているダメージをすべて取り除き、それを戦闘から取り除く。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99296&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32f915a0-9971-4040-9832-8b1a83e8d173\', \'multiverseId\': 99296}, \'multiverseid\': 99296}, {\'name\': \'Horror dos Horrores\', \'text\': \'Sacrifique um Pântano: Regenera a criatura preta alvo . (Na próxima vez em que uma criatura seria destruída neste turno, ela não o é. Em vez disso, vire-a, remova todo o dano dela e remova-a do combate.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99656&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0d962fa2-b052-4ae1-b9eb-23cf7d34fb87\', \'multiverseId\': 99656}, \'multiverseid\': 99656}, {\'name\': \'Ужас ужасов\', \'text\': \'Принесите в жертву Болото: регенерируйте целевое черное существо. (Если в течение этого хода это существо будет уничтожено, оно не отправляется на кладбище. Вместо этого поверните его, снимите с него все повреждения и выведите его из боя).\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109927&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9252f714-022f-449f-be08-a80d498adec4\', \'multiverseId\': 109927}, \'multiverseid\': 109927}, {\'name\': \'究极惊惧\', \'text\': \'牺牲一个沼泽：重生目标黑色生物。 （如果该生物下一次于本回合中将被消灭，则它不会被消灭， 而是改为将它横置，移除所受的所有伤害，并将它移出战斗。）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97856&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa71105e-eb27-4bcb-890a-a7ac9a30c1ce\', \'multiverseId\': 97856}, \'multiverseid\': 97856}]', '[{\'name\': \'Schuppenwurm\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Diese Würmer werden so groß, dass eine einzelne Schuppe den Menschen als Dach einer Hütte dienen kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98696&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'62ab862a-89bc-4381-9c67-2a12054429fc\', \'multiverseId\': 98696}, \'multiverseid\': 98696}, {\'name\': \'Sierpe escamosa\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'Las sierpes crecen tanto, que una escama sola puede usarse como techo de una casa humana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100136&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a779d4b-8ed1-42d2-9dbe-b240dc5ed0a0\', \'multiverseId\': 100136}, \'multiverseid\': 100136}, {\'name\': \'Guivre écailleuse\', \'type\': \'Créature : guivre\', \'flavor\': "Les guivres étaient devenues si grandes qu\'une seule de leurs écailles suffisait pour couvrir une habitation humaine.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98336&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0f51ee4-de2e-44b1-a300-32c431e31808\', \'multiverseId\': 98336}, \'multiverseid\': 98336}, {\'name\': \'Wurm Squamato\', \'type\': \'Creatura — Wurm\', \'flavor\': "I wurm diventano così grandi che una singola scaglia può essere usata come tetto per un\'abitazione umana.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99056&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cbadb471-54c6-4ceb-81ff-31172e5a7c54\', \'multiverseId\': 99056}, \'multiverseid\': 99056}, {\'name\': \'甲鱗のワーム\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'このワームは非常に大きくなるため、鱗一枚で人間の住居の屋根が作れる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99416&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d11117c6-1e6d-454d-8a32-12ecde959401\', \'multiverseId\': 99416}, \'multiverseid\': 99416}, {\'name\': \'Serpente Terrestre Escamada\', \'type\': \'Criatura — Vorme\', \'flavor\': \'Os vormes se tornam tão grandes que uma simples escama pode ser usada como telhado para uma morada humana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99776&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba810cb0-d37d-4245-bc24-26caef799ea9\', \'multiverseId\': 99776}, \'multiverseid\': 99776}, {\'name\': \'Чешуйчатый вурм\', \'type\': \'Существо — Вурм\', \'flavor\': \'Вурмы стали так огромны, что из одной их чешуйки можно сделать крышу для человеческого жилища.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110047&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'abd2c965-7c47-4597-b2e7-ab31a6142c84\', \'multiverseId\': 110047}, \'multiverseid\': 110047}, {\'name\': \'锐鳞亚龙\', \'type\': \'生物～亚龙\', \'flavor\': \'亚龙愈长愈大，光是一片鳞甲便可让人当成住家屋顶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97976&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8774f22f-6171-433c-8ea0-d7d3f7189a44\', \'multiverseId\': 97976}, \'multiverseid\': 97976}]', '[{\'name\': \'Schutzkreis gegen Rot\', \'text\': \'{1}: Sobald eine rote Quelle, die du bestimmst, dir das nächste Mal in diesem Zug Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98479&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2c8e8c23-a688-457c-8325-12c63c29db05\', \'multiverseId\': 98479}, \'multiverseid\': 98479}, {\'name\': \'Círculo de protección: rojo\', \'text\': \'{1}: La próxima vez que una fuente roja de tu elección fuera a hacerte daño este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99919&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a1ede85-0762-4eaa-bf7e-f258efca96ef\', \'multiverseId\': 99919}, \'multiverseid\': 99919}, {\'name\': \'Cercle de protection : rouge\', \'text\': "{1} : La prochaine fois qu\'une source rouge de votre choix devrait vous blesser ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98119&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e9deda7-df97-479b-ac4a-ef30d1570b4f\', \'multiverseId\': 98119}, \'multiverseid\': 98119}, {\'name\': \'Circolo di Protezione: Rosso\', \'text\': \'{1}: La prossima volta che una fonte rossa a tua scelta ti sta per infliggere danno in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98839&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4d74205b-7f34-4ef0-9acf-44ebec9b28db\', \'multiverseId\': 98839}, \'multiverseid\': 98839}, {\'name\': \'赤の防御円\', \'text\': \'{1}：このターン、あなたが選んだ赤の発生源１つが次にあなたに与えるダメージをすべて軽減し、０にする。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99199&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'218cf369-a10b-43f2-99b7-e57133dcc83a\', \'multiverseId\': 99199}, \'multiverseid\': 99199}, {\'name\': \'Círculo de Proteção: Vermelho\', \'text\': \'{1}: Na próxima vez em que uma fonte vermelha a sua escolha lhe fosse causar dano neste turno, previna aquele dano.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99559&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2a7e4e9d-f855-459a-861b-58b6c1a39a49\', \'multiverseId\': 99559}, \'multiverseid\': 99559}, {\'name\': \'Круг защиты: Красный\', \'text\': \'{1}: В следующий раз, когда выбранная вами красная карта в этот ход будет наносить вам повреждения, предотвратите повреждения.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109830&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28bfe791-d77a-4da4-aaec-ceb5affa155b\', \'multiverseId\': 109830}, \'multiverseid\': 109830}, {\'name\': \'反红保护环\', \'text\': \'{1}：选择一个红色的来源。于本回合中，防止该来源下一次将对你造成的伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97759&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'80e21556-a38c-4eb9-bdf2-d8398da7f409\', \'multiverseId\': 97759}, \'multiverseid\': 97759}]', '[{\'name\': \'Schutzkreis gegen Schwarz\', \'text\': \'{1}: Sobald eine schwarze Quelle, die du bestimmst, dir das nächste Mal in diesem Zug Schaden zufügen würde, verhindere diesen Schaden.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98478&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a781f6c7-b742-4361-a754-f7e2f455288d\', \'multiverseId\': 98478}, \'multiverseid\': 98478}, {\'name\': \'Círculo de protección: negro\', \'text\': \'{1}: La próxima vez que una fuente negra de tu elección fuera a hacerte daño este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99918&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'186a188f-2bbd-45a7-b457-db093c043f65\', \'multiverseId\': 99918}, \'multiverseid\': 99918}, {\'name\': \'Cercle de protection : noir\', \'text\': "{1} : La prochaine fois qu\'une source noire de votre choix devrait vous blesser ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29721db3-d64a-4536-a9d4-32875c62862d\', \'multiverseId\': 98118}, \'multiverseid\': 98118}, {\'name\': \'Circolo di Protezione: Nero\', \'text\': \'{1}: La prossima volta che una fonte nera a tua scelta ti sta per infliggere danno in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98838&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b69d7e5d-c9fe-45a3-a0e6-0418e054ca68\', \'multiverseId\': 98838}, \'multiverseid\': 98838}, {\'name\': \'黒の防御円\', \'text\': \'{1}：このターン、あなたが選んだ黒の発生源１つが次にあなたに与えるダメージをすべて軽減し、０にする。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99198&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69518039-8e29-4a61-bb08-e98ae116eda5\', \'multiverseId\': 99198}, \'multiverseid\': 99198}, {\'name\': \'Círculo de Proteção: Preto\', \'text\': \'{1}: Na próxima vez em que uma fonte preta a sua escolha lhe fosse causar dano neste turno, previna aquele dano.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99558&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab58dc9f-10fb-4fc4-a7fd-c0d78bf9c701\', \'multiverseId\': 99558}, \'multiverseid\': 99558}, {\'name\': \'Круг защиты: Черный\', \'text\': \'{1}: В следующий раз, когда выбранная вами черная карта в этот ход будет наносить вам повреждения, предотвратите повреждения.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109829&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'03264c28-3fad-447d-8489-ef213617e34f\', \'multiverseId\': 109829}, \'multiverseid\': 109829}, {\'name\': \'反黑保护环\', \'text\': \'{1}：选择一个黑色的来源。于本回合中，防止该来源下一次将对你造成的伤害。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97758&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee6f9003-8243-462e-9bdc-19b02f92c07d\', \'multiverseId\': 97758}, \'multiverseid\': 97758}]', "[{'name': 'Schwefelquellen', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {B} oder {R}. Die Schwefelquellen fügen dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98731&type=card', 'language': 'German', 'identifiers': {'scryfallId': '94606b7d-ffa7-4bc4-9eac-cc08c64eac2b', 'multiverseId': 98731}, 'multiverseid': 98731}, {'name': 'Manantiales sulfurosos', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {B} o {R} a tu reserva de maná. Los Manantiales sulfurosos te hacen 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100171&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'be425f0e-cc54-405a-9e57-6f269802982b', 'multiverseId': 100171}, 'multiverseid': 100171}, {'name': 'Sources sulfureuses', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {B} ou {R} à votre réserve. Ces Sources sulfureuses vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98371&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2c23ce0e-09ea-4c2f-a5d0-7850bdb9beb7', 'multiverseId': 98371}, 'multiverseid': 98371}, {'name': 'Sorgenti Sulfuree', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {B} o {R} alla tua riserva di mana. Le Sorgenti Sulfuree ti infliggono 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99091&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f5b40140-dcc2-4ac0-88c6-019e60012625', 'multiverseId': 99091}, 'multiverseid': 99091}, {'name': '硫黄泉', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{B}か{R}を加える。 硫黄泉はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99451&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'efcab6fb-92f6-4d9b-805c-bddd8fc01df7', 'multiverseId': 99451}, 'multiverseid': 99451}, {'name': 'Fontes Sulfurosas', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {B} ou {R} à sua reserva de mana. Fontes Sulfurosas causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99811&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ae3a05f3-9679-4290-a7f8-bdfa610d48fd', 'multiverseId': 99811}, 'multiverseid': 99811}, {'name': 'Серные источники', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {B} или {R} в запас маны. Серные источники наносят вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110082&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '18dbde34-7a5e-4bf6-b044-c581ba635d84', 'multiverseId': 110082}, 'multiverseid': 110082}, {'name': '硫磺温泉', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{B}或{R}到你的法术力池中。 硫磺温泉对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98011&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'de347b74-5c2f-4d7d-bab9-5b2b2ca941f1', 'multiverseId': 98011}, 'multiverseid': 98011}]", '[{\'name\': \'Schwermut\', \'text\': \'Immer wenn ein Gegner eine Karte abwirft, fügt Schwermut diesem Spieler 2 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'„Du kannst dem Schmerz nicht entfliehen, denn du ermüdest schneller als der Schmerz."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98619&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0559c17f-5e6b-48a6-a979-c67611d3d61f\', \'multiverseId\': 98619}, \'multiverseid\': 98619}, {\'name\': \'Jaqueca\', \'text\': \'Siempre que un oponente descarte una carta, la Jaqueca hace 2 puntos de daño a ese jugador.\', \'type\': \'Encantamiento\', \'flavor\': \'"Puedes escapar de tu dolor, pero te cansarás antes que él."Gerrard del Vientoligero\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100059&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3a1de4c8-f893-44e7-87ef-77b7ed6d713b\', \'multiverseId\': 100059}, \'multiverseid\': 100059}, {\'name\': \'Céphalalgie\', \'text\': "À chaque fois qu\'un adversaire se défausse d\'une carte, la Céphalalgie lui inflige 2 blessures.", \'type\': \'Enchantement\', \'flavor\': \'« Cloués au sol, de honte et de céphalalgies... »Arthur Rimbaud, Poésies\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98259&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c25d81e-26f2-4545-b302-9482ceca6808\', \'multiverseId\': 98259}, \'multiverseid\': 98259}, {\'name\': \'Emicrania\', \'text\': "Ogniqualvolta un avversario scarta una carta, l\'Emicrania infligge 2 danni a quel giocatore.", \'type\': \'Incantesimo\', \'flavor\': \'"Puoi fuggire dal tuo dolore, ma ti stancherai prima di lui."Gerrard della Cavalcavento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98979&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5ad20e14-edfc-4687-a24a-843c1a92aaf7\', \'multiverseId\': 98979}, \'multiverseid\': 98979}, {\'name\': \'偏頭痛\', \'text\': \'いずれかの対戦相手がカードを１枚捨てるたび、偏頭痛はそのプレイヤーに２点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'痛みから逃れることはできるさ。その前に自分がへばるけどな。――ウェザーライト号のジェラード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99339&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc5858bb-cf18-4836-93b5-df61503e12f2\', \'multiverseId\': 99339}, \'multiverseid\': 99339}, {\'name\': \'Enxaqueca\', \'text\': \'Toda vez que um oponente descartar um card, Enxaqueca causa 2 pontos de dano àquele jogador.\', \'type\': \'Encantamento\', \'flavor\': \'"Podes fugir da tua dor, mas vais cansar-te antes dela." Gerrard do Bons Ventos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99699&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'04f5cf9f-5dc8-492e-ad7d-47a585a4f014\', \'multiverseId\': 99699}, \'multiverseid\': 99699}, {\'name\': \'Мигрень\', \'text\': \'Каждый раз, когда оппонент сбрасывает карту, Мигрень наносит ему 2 повреждения.\', \'type\': \'Чары\', \'flavor\': \'"Можешь пытаться убежать от боли, но ты устанешь раньше, чем она". — Джерард Везерлайт\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=109970&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17bd832b-9398-42c3-99b5-4670779db030\', \'multiverseId\': 109970}, \'multiverseid\': 109970}, {\'name\': \'偏头痛\', \'text\': \'每当对手弃一张牌时，偏头痛对该牌手造成2点伤害。\', \'type\': \'结界\', \'flavor\': \'「你可以逃避苦痛，但终究无法逃离。」～晴空号的杰拉尔德\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97899&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0554a6d5-9d94-4a72-a597-aae40a99b963\', \'multiverseId\': 97899}, \'multiverseid\': 97899}]', '[{\'name\': \'Seelenlose Zombies\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'„Sie stöhnten und bewegten sich, erhoben sich alsbald, Sie sprachen nicht, die Augen starr; Selbst in \\\'nem Traum wär\\\'s sonderbar, Die Toten aufersteh\\\'n zu seh\\\'n, die blassen Leichen kalt." —Samuel Taylor Coleridge, „Die Ballade vom alten Seemann"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98697&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'355fa45d-0d3c-4fc9-a949-9f413b2a2774\', \'multiverseId\': 98697}, \'multiverseid\': 98697}, {\'name\': \'Zombies dañinos\', \'type\': \'Criatura — Zombie\', \'flavor\': \'"Gimieron, se agitaron, todos se levantaron, Ni hablaron ni movieron los ojos; Hasta en un sueño hubiera sido extraño, Ver a aquellos muertos levantarse." —Samuel Taylor Coleridge, "La balada del viejo marinero"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100137&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6778815e-c268-4557-ba4a-a6efbcc1a2c6\', \'multiverseId\': 100137}, \'multiverseid\': 100137}, {\'name\': \'Zombies dévastateurs\', \'type\': \'Créature : zombie\', \'flavor\': "« Comme un nageur venant du profond de son plonge, Tous sortent de la mort, comme l\'on sort d\'un songe. » —Agrippa d\'Aubigné, La résurrection des morts", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98337&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85059d05-ab99-40dd-acc7-03dd19b01f2a\', \'multiverseId\': 98337}, \'multiverseid\': 98337}, {\'name\': \'Zombi della Distruzione\', \'type\': \'Creatura — Zombie\', \'flavor\': \'"Con un gemito, tesero i muscoli e si levarono, Non dissero verbo o ruotarono gli occhi, Era ben strano anche in un sogno, Vedere i morti rialzarsi dal sonno." —Samuel Taylor Coleridge, "La Ballata del Vecchio Marinaio"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99057&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b45dcded-936c-435d-80cd-997ce7920724\', \'multiverseId\': 99057}, \'multiverseid\': 99057}, {\'name\': \'スケイズ・ゾンビ\', \'type\': \'クリーチャー — ゾンビ\', \'flavor\': \'うなり、うごめき、そいつらは立ち上がる。 言葉もなし、その目に動きもなし。 それは夢だとしても、あまりに奇妙なこと。 こんな死人が蘇るなど。 ――サミュエル・コールリッジ 「老水夫行」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99417&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71b866e4-91cf-4fd3-b3d3-b8f8b7790c51\', \'multiverseId\': 99417}, \'multiverseid\': 99417}, {\'name\': \'Zumbis de Scathe\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'"Gemeram, se moveram e depois se ergueram, Sem falar, sem olhar; Mesmo em sonho, era estranho ver tanto homem Do chão se levantar." — Samuel Taylor Coleridge, "A Balada do Velho Marinheiro"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99777&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d07ab472-4386-4119-8048-f2505ef6e345\', \'multiverseId\': 99777}, \'multiverseid\': 99777}, {\'name\': \'Смертоносные зомби\', \'type\': \'Существо — Зомби\', \'flavor\': \'"Они восстали со страшным воем, Взгляд неподвижный вперед устремив. И страшно было подумать, кто мог им, Умершим, жизнь возвратить". — Самюель Тэйлор Колеридж, "Песнь старого моряка"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110048&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6a3bc955-963b-4bca-a5c9-760f969de20c\', \'multiverseId\': 110048}, \'multiverseid\': 110048}, {\'name\': \'枯萎灵俑\', \'type\': \'生物～灵俑\', \'flavor\': \'「它们呻吟、碰撞，站起身来， 口不言语，眼不理睬； 看到死人如此复生， 即使在梦中，还是很古怪。」 ～山缪‧泰勒‧柯律芝， 「古舟子咏」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97977&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5383a3ca-77f5-4d9a-b69c-f7f09c1a301a\', \'multiverseId\': 97977}, \'multiverseid\': 97977}]', '[{\'name\': \'Seelenmahlzeit\', \'text\': \'Ein Spieler deiner Wahl verliert 4 Lebenspunkte, und du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Du bist, was du isst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98719&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'558bd1f3-4d55-4b06-8bd5-bcc6e30e04b5\', \'multiverseId\': 98719}, \'multiverseid\': 98719}, {\'name\': \'Festín de alma\', \'text\': \'El jugador objetivo pierde 4 vidas y tú ganas 4 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'Eres lo que comes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100159&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3cb6648-aec0-4250-be70-5ea596312722\', \'multiverseId\': 100159}, \'multiverseid\': 100159}, {\'name\': "Festin d\'âmes", \'text\': \'Le joueur ciblé perd 4 points de vie et vous gagnez 4 points de vie.\', \'type\': \'Rituel\', \'flavor\': \'Vous êtes ce que vous mangez.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98359&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9e92234a-4246-475c-9a52-2243a9d9d4a8\', \'multiverseId\': 98359}, \'multiverseid\': 98359}, {\'name\': "Banchetto dell\'Anima", \'text\': \'Il giocatore bersaglio perde 4 punti vita e tu guadagni 4 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'Dimmi chi mangi e ti dirò chi sei.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99079&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2295a3dd-f15f-4367-b14a-98da66f57a3a\', \'multiverseId\': 99079}, \'multiverseid\': 99079}, {\'name\': \'魂の饗宴\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは４点のライフを失い、あなたは４点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'魂ほど美味いものはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99439&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eca93235-5572-4c52-a558-38b4d46a8378\', \'multiverseId\': 99439}, \'multiverseid\': 99439}, {\'name\': \'Festim de Almas\', \'text\': \'O jogador alvo perde 4 pontos de vida e você ganha 4 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'Você é aquilo que come.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99799&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48c8a532-c4be-4a27-9cac-88760989b680\', \'multiverseId\': 99799}, \'multiverseid\': 99799}, {\'name\': \'Пир души\', \'text\': \'Целевой игрок теряет 4 пункта жизни, а вы получаете 4 пункта жизни.\', \'type\': \'Волшебство\', \'flavor\': \'Ты же сам себя поедаешь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110070&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'20790371-4a7a-452e-ad80-8493da86ed5f\', \'multiverseId\': 110070}, \'multiverseid\': 110070}, {\'name\': \'灵魂盛宴\', \'text\': \'目标牌手失去4点生命且你获得4点生命。\', \'type\': \'法术\', \'flavor\': \'吃谁就会像谁。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97999&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14c9319d-3180-42f3-b815-16637aad7ed1\', \'multiverseId\': 97999}, \'multiverseid\': 97999}]', '[{\'name\': \'Seelenvernichtung\', \'text\': \'Neutralisiere einen Kreaturenzauber deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wenn deinen Feinden keine Soldaten vergönnt sind, ist ihnen auch kein Sieg vergönnt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'87f493aa-1aa6-4692-9cba-b54b459e9e5f\', \'multiverseId\': 98678}, \'multiverseid\': 98678}, {\'name\': \'Robar el alma\', \'text\': \'Contrarresta el hechizo objetivo de criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'Cuando tus enemigos no tienen soldados, no tienen victoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100118&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67d74869-999b-4189-ba23-627e70ac8c00\', \'multiverseId\': 100118}, \'multiverseid\': 100118}, {\'name\': "Retrait d\'âme", \'text\': \'Contrecarrez le sort de créature ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'Quand vos ennemis sont privés de soldats, ils sont privés de victoire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98318&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6283aa66-3665-4993-975b-0adcbec4f38a\', \'multiverseId\': 98318}, \'multiverseid\': 98318}, {\'name\': "Estirpare l\'Anima", \'text\': \'Neutralizza una magia creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Quando ai tuoi nemici vengono negati i soldati, viene negata loro anche la vittoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99038&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'710809ba-4464-46cc-a376-df42abd91f0e\', \'multiverseId\': 99038}, \'multiverseid\': 99038}, {\'name\': \'霊魂放逐\', \'text\': \'クリーチャー呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'敵に兵士が与えられなければ、勝利も与えられない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99398&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'291fd94f-9678-4c0a-8204-eafca20237fa\', \'multiverseId\': 99398}, \'multiverseid\': 99398}, {\'name\': \'Remover a Alma\', \'text\': \'Anula a mágica de criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Quando seus inimigos são soldados rejeitados, para eles é negada a vitória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99758&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f2cd7012-9181-437f-8a8a-785807f12942\', \'multiverseId\': 99758}, \'multiverseid\': 99758}, {\'name\': \'Удаление души\', \'text\': \'Прервите заклинание целевого существа.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Когда от ваших врагов отвернутся солдаты, от них отвернется победа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110029&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3a7380ff-7818-42e6-a16a-c066c18bca6f\', \'multiverseId\': 110029}, \'multiverseid\': 110029}, {\'name\': \'移魂术\', \'text\': \'反击目标生物咒语。\', \'type\': \'瞬间\', \'flavor\': \'当敌手无兵可用，便是你胜利之时。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97958&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d2e1403f-f52d-40a1-9ecd-9dd3fa4514de\', \'multiverseId\': 97958}, \'multiverseid\': 97958}]', '[{\'name\': \'Seelenwächter\', \'text\': \'Immer wenn eine andere Kreatur ins Spiel kommt, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Zähle die Seelen sorgfältig, damit keine verlorengeht. —Lehre der Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98720&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed15e1e6-d7d2-460a-8b34-d54b9175cd15\', \'multiverseId\': 98720}, \'multiverseid\': 98720}, {\'name\': \'Protectora de almas\', \'text\': \'Siempre que otra criatura entre en juego, ganas 1 vida.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'Cuenta cuidadosamente las almas y comprueba que no se haya perdido ninguna. —Enseñanza vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100160&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a30da7d2-7794-4927-9fa2-eb5b8f40d4ca\', \'multiverseId\': 100160}, \'multiverseid\': 100160}, {\'name\': \'Garde des âmes\', \'text\': "À chaque fois qu\'une autre créature arrive en jeu, vous gagnez 1 point de vie.", \'type\': \'Créature : humain et clerc\', \'flavor\': \'CSP\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98360&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'03e5034b-6185-48ad-80eb-b15b5c1ac002\', \'multiverseId\': 98360}, \'multiverseid\': 98360}, {\'name\': "Guardiano dell\'Anima", \'text\': "Ogniqualvolta un\'altra creatura entra in gioco, guadagni 1 punto vita.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'Conta attentamente le anime e assicurati che nessuna si sia persa. —Insegnamento Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99080&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1eca212b-e9d8-4f74-88af-29222de37d69\', \'multiverseId\': 99080}, \'multiverseid\': 99080}, {\'name\': \'魂の管理人\', \'text\': \'いずれかのクリーチャーが場に出るたび、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'魂はよく注意して数えよ。失われた魂がないかどうか確認せよ。 ――ヴェクの教え\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99440&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'772b2b78-c909-4c11-806a-07602620792e\', \'multiverseId\': 99440}, \'multiverseid\': 99440}, {\'name\': \'Encarregado das Almas\', \'text\': \'Toda vez que outra criatura entrar em jogo, você ganha 1 ponto de vida.\', \'type\': \'Criatura — Clérigo Humano\', \'flavor\': \'Conta as almas com cuidado e certifica-te que nenhuma se perdeu. — Ensinamento de Vec\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99800&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93ecf9a6-312b-49db-9b6a-94e219d3367a\', \'multiverseId\': 99800}, \'multiverseid\': 99800}, {\'name\': \'Страж души\', \'text\': \'Каждый раз, когда другое существо вступает в игру, вы получаете 1 пункт жизни.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'Хорошенько пересчитай души, чтобы ни одна не пропала. — Уроки Века\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110071&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3c68cdc3-e90e-4a48-b6c6-455881c74fdb\', \'multiverseId\': 110071}, \'multiverseid\': 110071}, {\'name\': \'护灵师\', \'text\': \'每当另一个生物进场时，你获得1点生命。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'仔细照护灵魂，勿使之迷途。 ～维克族教谕\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b692077c-9f87-4e2e-96a7-52f2b1522d40\', \'multiverseId\': 98000}, \'multiverseid\': 98000}]', '[{\'name\': \'Seidenpeitschen-Spinne\', \'text\': \'Die Seidenpeitschen-Spinne kann blocken, als ob sie Flugfähigkeit hätte.\\n{X}{G}{G}: Die Seidenpeitschen-Spinne fügt allen fliegenden Kreaturen X Schadenspunkte zu.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Über dem Krosa-Wald fliegt nur eines der Wind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98714&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fcf8eac3-9bcf-40bc-bedb-cdfb044bc092\', \'multiverseId\': 98714}, \'multiverseid\': 98714}, {\'name\': \'Araña azotaseda\', \'text\': \'La Araña azotaseda puede bloquear como si tuviera la habilidad de volar.\\n{X}{G}{G}: La Araña azotaseda hace X puntos de daño a cada criatura que tenga la habilidad de volar.\', \'type\': \'Criatura — Araña\', \'flavor\': \'Lo único que vuela sobre el Bosque de Krosa es el viento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100154&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a68b28f1-4647-48db-9323-600fe2e9a789\', \'multiverseId\': 100154}, \'multiverseid\': 100154}, {\'name\': \'Araignée fouettesoie\', \'text\': "L\'Araignée fouettesoie peut bloquer comme si elle avait le vol.\\n{X}{G}{G} : L\'Araignée fouettesoie inflige X blessures à chaque créature avec le vol.", \'type\': \'Créature : araignée\', \'flavor\': \'Seul le vent peut survoler la Krosia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98354&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26fd9270-7c5d-421d-956f-b63a86d5f4e7\', \'multiverseId\': 98354}, \'multiverseid\': 98354}, {\'name\': \'Ragno Setafrusta\', \'text\': \'Il Ragno Setafrusta può bloccare come se avesse volare.\\n{X}{G}{G}: Il Ragno Setafrusta infligge X danni a ogni creatura con volare.\', \'type\': \'Creatura — Ragno\', \'flavor\': "L\'unica cosa che può sorvolare la Foresta di Krosa è il vento.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99074&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'887aaae1-fa0f-4877-86b0-45641581b96c\', \'multiverseId\': 99074}, \'multiverseid\': 99074}, {\'name\': \'絹鎖の蜘蛛\', \'text\': \'絹鎖の蜘蛛は飛行を持っているかのようにブロックに参加できる。\\n{X}{G}{G}：絹鎖の蜘蛛は飛行を持つ各クリーチャーにそれぞれＸ点のダメージを与える。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'風だけがクローサの森を飛び越えられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99434&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ae9e8f96-4dd8-4ceb-ab65-d05fd0c7fbac\', \'multiverseId\': 99434}, \'multiverseid\': 99434}, {\'name\': \'Aranha do Chicote de Seda\', \'text\': \'Aranha do Chicote de Seda pode bloquear como se tivesse a habilidade de voar.\\n{X}{G}{G}: Aranha do Chicote de Seda causa X pontos de dano a cada criatura com a habilidade de voar.\', \'type\': \'Criatura — Aranha\', \'flavor\': \'A única coisa que sobrevoa a Floresta Krosana é o vento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99794&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8822a9f7-1709-418c-b5a3-b61ca6ec4917\', \'multiverseId\': 99794}, \'multiverseid\': 99794}, {\'name\': \'Паук-шелкопряд\', \'text\': \'Паук-шелкопряд может блокировать, как если бы он обладал способностью полета.\\n{X}{G}{G}: Паук-шелкопряд наносит X повреждений каждому существу со способностью полета.\', \'type\': \'Существо — Паук\', \'flavor\': \'Только ветер летает над Кросанским лесом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c130e715-cde2-4bdb-be39-9167181066c1\', \'multiverseId\': 110065}, \'multiverseid\': 110065}, {\'name\': \'丝鞭蜘蛛\', \'text\': \'丝鞭蜘蛛能视同具有飞行异能地进行阻挡。\\n{X}{G}{G}：丝鞭蜘蛛对每个具飞行异能的生物各造成X点伤害。\', \'type\': \'生物～蜘蛛\', \'flavor\': \'能自克洛萨树林飞过的，唯有风而已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97994&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'63065da4-779e-41bc-a6bf-fd5a3c5d31ed\', \'multiverseId\': 97994}, \'multiverseid\': 97994}]', '[{\'name\': \'Seltsame Ernte\', \'text\': \'Jeder Spieler kann seine Bibliothek nach bis zu X Kreaturenkarten durchsuchen, diese offen vorzeigen und auf seine Hand nehmen. Danach mischt jeder Spieler, der auf diese Weise seine Bibliothek durchsucht hat, diese.\', \'type\': \'Hexerei\', \'flavor\': \'Krosas entstellte Haine tragen seltsame Früchte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98780&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f6966aea-9d43-41c5-9056-3ccffb6029d7\', \'multiverseId\': 98780}, \'multiverseid\': 98780}, {\'name\': \'Cosecha extraña\', \'text\': \'Cada jugador puede buscar en su biblioteca hasta X cartas de criatura, mostrarlas y ponerlas en su mano. Luego cada jugador que buscó en su biblioteca de esta manera la baraja.\', \'type\': \'Conjuro\', \'flavor\': \'Las arboledas deformadas de Krosa dan frutos extraños.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100220&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'066a65a6-d4f0-41d1-92bf-c4e4d1994128\', \'multiverseId\': 100220}, \'multiverseid\': 100220}, {\'name\': \'Étrange moisson\', \'text\': "Chaque joueur peut chercher dans sa bibliothèque jusqu\'à X cartes de créature, révéler ces cartes et les mettre dans sa main. Ensuite, chaque joueur qui a cherché dans sa bibliothèque de cette manière la mélange.", \'type\': \'Rituel\', \'flavor\': \'Les arbres des vergers transfigurés de la Krosia portent des fruits bien étranges.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98420&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6057e560-dc65-4a85-a1c5-f52e534b4ff2\', \'multiverseId\': 98420}, \'multiverseid\': 98420}, {\'name\': \'Raccolto Insolito\', \'text\': \'Ogni giocatore può passare in rassegna il proprio grimorio, scegliere fino a X carte creatura, rivelarle e aggiungerle alla propria mano. Poi ogni giocatore che ha passato in rassegna il proprio grimorio in questo modo lo rimescola.\', \'type\': \'Stregoneria\', \'flavor\': \'I deformi frutteti di Krosa generano strani frutti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99140&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7d83cc92-927b-4c38-8b2d-aabf57f7b566\', \'multiverseId\': 99140}, \'multiverseid\': 99140}, {\'name\': \'奇妙な収穫\', \'text\': \'各プレイヤーは、自分のライブラリーから最大Ｘ枚までのクリーチャー・カードを探し、それらを公開して自分の手札に加えてもよい。 その後、この方法で自分のライブラリーを探した各プレイヤーは、自分のライブラリーを切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'クローサの歪んだ林は奇妙な実を結ぶ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99500&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6bf09d00-804f-4333-8979-a803027f9252\', \'multiverseId\': 99500}, \'multiverseid\': 99500}, {\'name\': \'Colheita Estranha\', \'text\': \'Cada jogador pode procurar em seu próprio grimório por X cards de criatura, revelá-los e colocá-los em sua própria mão. Depois, cada jogador que procurou pelos cards em seu próprio grimório embaralha-o.\', \'type\': \'Feitiço\', \'flavor\': \'Os arvoretes distorcidos de Krosa produzem frutos estranhos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'08ff8a80-d450-4fcb-8d7a-83a3a42fbbd5\', \'multiverseId\': 99860}, \'multiverseid\': 99860}, {\'name\': \'Странный урожай\', \'text\': \'Каждый игрок может выбрать в своей библиотеке до X карт существ, открыть эти карты и поместить их в свою руку. Затем каждый игрок, который выбирал карты, тасует библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Искалеченные крозанские рощи приносят странные плоды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110131&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'41b87414-a386-472e-aa9e-3b0f991ce29b\', \'multiverseId\': 110131}, \'multiverseid\': 110131}, {\'name\': \'奇异收成\', \'text\': \'每位牌手可以各从其牌库中搜寻至多X张生物牌，展示该些牌，然后将它们置于其手上。 然后每位以此法搜寻牌库的牌手将其牌库洗牌。\', \'type\': \'法术\', \'flavor\': \'克洛萨的扭曲树丛孕育出奇特花果。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7bb7edf5-a4d0-4051-a234-1f06fc6a05be\', \'multiverseId\': 98060}, \'multiverseid\': 98060}]', '[{\'name\': \'Sengir-Vampir\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nImmer wenn eine Kreatur, der in diesem Zug Schaden durch den Sengir-Vampir zugefügt wurde, auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf den Sengir-Vampir.\', \'type\': \'Kreatur — Vampir\', \'flavor\': \'Reiche blühen auf und zerfallen wieder, aber das Böse bleibt ewig bestehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98704&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'758e5820-66e1-4ec6-889c-1abf33651477\', \'multiverseId\': 98704}, \'multiverseid\': 98704}, {\'name\': \'Vampiro de Sengir\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nSiempre que una criatura que haya recibido daño del Vampiro de Sengir este turno vaya a un cementerio, pon un contador +1/+1 sobre el Vampiro de Sengir.\', \'type\': \'Criatura — Vampiro\', \'flavor\': \'Los imperios tienen su esplendor y su decadencia, pero el mal es eterno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100144&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'923ae505-11bf-4b56-82e9-1af5870b173b\', \'multiverseId\': 100144}, \'multiverseid\': 100144}, {\'name\': \'Vampire sengien\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nÀ chaque fois qu\'une créature blessée par le Vampire sengien ce tour-ci est mise dans un cimetière, mettez un marqueur +1/+1 sur le Vampire sengien.", \'type\': \'Créature : vampire\', \'flavor\': "Les empires naissent et s\'effondrent, mais le mal est éternel.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'041e2bd7-f916-43ce-bdda-2526acf92f66\', \'multiverseId\': 98344}, \'multiverseid\': 98344}, {\'name\': \'Vampiro di Sengir\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nOgniqualvolta una creatura a cui sia stato inflitto danno dal Vampiro di Sengir in questo turno viene messa in un cimitero, metti un segnalino +1/+1 sul Vampiro di Sengir.\', \'type\': \'Creatura — Vampiro\', \'flavor\': \'Gli imperi sorgono e cadono, ma il male è eterno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99064&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec9f52a6-47f9-439c-8e25-fee191969327\', \'multiverseId\': 99064}, \'multiverseid\': 99064}, {\'name\': \'センギアの吸血鬼\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\nこのターン、センギアの吸血鬼によってダメージを与えられたクリーチャーが墓地に置かれるたび、センギアの吸血鬼の上に+1/+1カウンターを１個置く。\', \'type\': \'クリーチャー — 吸血鬼\', \'flavor\': \'帝国には栄枯盛衰があるが、邪悪さは不滅だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99424&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0697a805-c3d9-4322-b746-46610b58f5e1\', \'multiverseId\': 99424}, \'multiverseid\': 99424}, {\'name\': \'Vampiro de Sengir\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nToda vez que uma criatura que sofreu dano do Vampiro de Sengir neste turno seria colocada num cemitério, coloque um marcador +1/+1 em Vampiro de Sengir.\', \'type\': \'Criatura — Vampiro\', \'flavor\': \'Impérios vêm e vão, mas o mal é eterno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7952959a-5a39-4ea6-b96d-210abda68d97\', \'multiverseId\': 99784}, \'multiverseid\': 99784}, {\'name\': \'Сенгирский вампир\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nКаждый раз, когда существо, которому в этот ход наносил повреждения Сенгирский вампир, попадает на кладбище, добавьте Сенгирскому вампиру +1/+1.\', \'type\': \'Существо — Вампир\', \'flavor\': \'Империи рождаются и погибают, а зло вечно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110055&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'69094cb1-8c0a-487d-bf10-6b13f3c4f028\', \'multiverseId\': 110055}, \'multiverseid\': 110055}, {\'name\': \'辛格氏吸血鬼\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n每当本回合中曾受到辛格氏吸血鬼伤害的生物置入坟墓场时，在辛格氏吸血鬼上放置一个+1/+1指示物。\', \'type\': \'生物～吸血鬼\', \'flavor\': \'帝国兴落，邪恶永存。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97984&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79b5df08-9825-4c4d-8211-468848c2b8ba\', \'multiverseId\': 97984}, \'multiverseid\': 97984}]', '[{\'name\': \'Serra-Engel\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nWachsamkeit (Diese Kreatur wird beim Angreifen nicht getappt.)\', \'type\': \'Kreatur — Engel\', \'flavor\': \'Ich werde einen Engel schicken, der dir vorausgeht. Er soll dich auf dem Weg schützen.Die Bibel, Exodus 23:20\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98706&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd4f46d6-dc04-4bf1-be2e-393df95e9145\', \'multiverseId\': 98706}, \'multiverseid\': 98706}, {\'name\': \'Ángel de Serra\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nVigilancia. (Esta criatura no se gira al atacar.)\', \'type\': \'Criatura — Ángel\', \'flavor\': \'Cuando vuela sobre los buenos, se consideran bendecidos. Cuando vuela sobre los perversos, se consideran muertos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100146&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'547f8e0f-c690-499f-9abe-b1609d72364f\', \'multiverseId\': 100146}, \'multiverseid\': 100146}, {\'name\': \'Ange de Serra\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nVigilance (Attaquer avec cette créature ne la fait pas s\'engager.)", \'type\': \'Créature : ange\', \'flavor\': \'« Les anges sont peut-être irréels, mais leurs épées sont bien forgées. » —Un barbare profane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d87dec0-6362-4164-8c68-ba5f82d294c9\', \'multiverseId\': 98346}, \'multiverseid\': 98346}, {\'name\': \'Angelo di Serra\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nCautela (Questa creatura attacca senza TAPpare.)\', \'type\': \'Creatura — Angelo\', \'flavor\': \'Quando sorvola i giusti, essi si considerano benedetti. Quando sorvola i corrotti, essi si considerano morti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99066&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca5ceb88-c7ad-4fa4-ac94-680de21b6281\', \'multiverseId\': 99066}, \'multiverseid\': 99066}, {\'name\': \'セラの天使\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n警戒 （このクリーチャーは攻撃に参加してもタップしない。）\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'彼女が善良なる者たちの上を飛ぶとき、彼らは祝福を感じる。 彼女が邪悪なる者たちの上を飛ぶとき、彼らは死を感じる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99426&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'087ecb2f-9d6f-4e18-b8b9-b91426f2afa3\', \'multiverseId\': 99426}, \'multiverseid\': 99426}, {\'name\': \'Anjo Serra\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nVigilância (Esta criatura não é virada para atacar.)\', \'type\': \'Criatura — Anjo\', \'flavor\': \'Quando ela voa sobre os justos, eles se consideram abençoados. Quando ela voa sobre ímpios, eles se consideram mortos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99786&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9780fdb7-5b02-46c3-accb-cdadf43525af\', \'multiverseId\': 99786}, \'multiverseid\': 99786}, {\'name\': \'Ангел Серры\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nБдительность (При нападении это существо не поворачивается).\', \'type\': \'Существо — Ангел\', \'flavor\': \'Когда он парит над головами добрых людей, он ранит их. Когда он парит над головами подлых людей, он убивает их.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110057&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e45a6c22-9ec0-4b2b-ae3b-2895b976c0d8\', \'multiverseId\': 110057}, \'multiverseid\': 110057}, {\'name\': \'撒拉天使\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n警戒（此生物攻击时不需横置）\', \'type\': \'生物～天使\', \'flavor\': \'当她翱翔于善人头顶，他们感到蒙福； 当她翱翔于恶人头顶，他们只想降服。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97986&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'60e43306-5a11-45de-bf20-07fe9210798e\', \'multiverseId\': 97986}, \'multiverseid\': 97986}]', '[{\'name\': \'Serras Segen\', \'text\': \'Alle Kreaturen, die du kontrollierst, haben Wachsamkeit. (Sie werden beim Angreifen nicht getappt.)\', \'type\': \'Verzauberung\', \'flavor\': \'„Erhebe dich, und ich werde dir zeigen, wie du läufst, ohne zu ermüden, kämpfst, ohne zu zürnen, und fliegst, ohne Flügel zu haben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98707&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b71421db-a6e5-4825-ab58-d404d7bb8d69\', \'multiverseId\': 98707}, \'multiverseid\': 98707}, {\'name\': \'Bendición de Serra\', \'text\': \'Las criaturas que controles tienen la habilidad de vigilancia. (No se giran al atacar.)\', \'type\': \'Encantamiento\', \'flavor\': \'"Levántense, y les mostraré como correr sin cansarse, pelear sin enfurecerse y volar sin alas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100147&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1abbd580-4938-4ef9-a9ce-da75741378b8\', \'multiverseId\': 100147}, \'multiverseid\': 100147}, {\'name\': \'Bénédiction selon Serra\', \'text\': "Les créatures que vous contrôlez ont la vigilance. (Attaquer avec ces créatures ne les fait pas s\'engager.)", \'type\': \'Enchantement\', \'flavor\': \'« Lève-toi. Je te montrerai comment courir sans faiblir, comment combattre sans rage et comment voler sans ailes. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98347&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8e44b5c7-00a0-4cae-85c0-44969dc1fa78\', \'multiverseId\': 98347}, \'multiverseid\': 98347}, {\'name\': \'Benedizione di Serra\', \'text\': \'Le creature che controlli hanno cautela. (Attaccano senza TAPpare.)\', \'type\': \'Incantesimo\', \'flavor\': \'"Alzati e ti mostrerò come correre senza stancarti, come combattere senza infuriarti e come volare senza ali."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99067&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a801bc4-b21b-4759-a037-495cf4e71b8f\', \'multiverseId\': 99067}, \'multiverseid\': 99067}, {\'name\': \'セラの祝福\', \'text\': \'あなたがコントロールするクリーチャーは警戒を持つ。 （それらは攻撃に参加してもタップしない。）\', \'type\': \'エンチャント\', \'flavor\': \'起ちなさい。疲れ無く走る術を、怒り無く戦う術を、翼無く飛ぶ術を教えましょう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99427&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a0f6ed13-56df-40e8-8258-6fea8e0421e2\', \'multiverseId\': 99427}, \'multiverseid\': 99427}, {\'name\': \'Bênção de Serra\', \'text\': \'As criaturas que você controla têm a habilidade de vigilância. (Elas não são viradas para atacar.)\', \'type\': \'Encantamento\', \'flavor\': \'"Levante-se, e eu lhe mostrarei como correr sem fatigar-se, lutar sem enfurecer-se, e voar sem asas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99787&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b29a6017-eb15-4db6-a9ff-a231ccfa7e10\', \'multiverseId\': 99787}, \'multiverseid\': 99787}, {\'name\': \'Благословение Серры\', \'text\': \'Существа, которых вы контролируете, получают бдительность. (При нападении они не поворачиваются).\', \'type\': \'Чары\', \'flavor\': \'"Встань, и я научу тебя бегать без устали, сражаться без ярости и летать без крыльев".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110058&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'303054e4-4bd0-4f3a-a83e-96083c3b06c6\', \'multiverseId\': 110058}, \'multiverseid\': 110058}, {\'name\': \'撒拉的祝福\', \'text\': \'由你操控的生物具有警戒异能。 （它们攻击时不需横置）\', \'type\': \'结界\', \'flavor\': \'「奋起吧，我将让你知晓如何奔跑而不感疲累，战斗而不兴暴怒，飞翔而不需羽翼。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97987&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5881f6aa-a5e6-4bb0-8568-44f2bb9dd4dc\', \'multiverseId\': 97987}, \'multiverseid\': 97987}]', "[{'name': 'Seuchenkäfer', 'text': 'Sumpftarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler einen Sumpf kontrolliert.)', 'type': 'Kreatur — Insekt', 'flavor': 'Niemand weiß, ob sie nach den Seuchen, die sie verbreiten, oder nach der Geschwindigkeit ihrer Vermehrung benannt wurden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98657&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c11f14f5-2c27-4698-b874-61f51cf88af3', 'multiverseId': 98657}, 'multiverseid': 98657}, {'name': 'Escarabajo de la peste', 'text': 'Cruza pantanos. (Esta criatura es imbloqueable mientras el jugador defensor controle un pantano.)', 'type': 'Criatura — Insecto', 'flavor': 'Nadie sabe si fueron nombrados por la enfermedad que portan o por la velocidad con la que se multiplican.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100097&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5f9c5a33-ec1a-4ac2-bfb6-8407c0909472', 'multiverseId': 100097}, 'multiverseid': 100097}, {'name': 'Scarabée de la Peste', 'text': 'Traversée des marais (Cette créature est imblocable tant que le joueur défenseur contrôle au moins un marais.)', 'type': 'Créature : insecte', 'flavor': '« Dans le danger, le porc-épic se hérisse, le scarabée fait le mort (…) » —Victor Hugo, Les Misérables', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98297&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4dea375c-35dc-4989-9f15-ad4405ca29f8', 'multiverseId': 98297}, 'multiverseid': 98297}, {'name': 'Coleottero della Peste', 'text': 'Passa-paludi (Questa creatura non può essere bloccata fintanto che il giocatore in difesa controlla almeno una Palude.)', 'type': 'Creatura — Insetto', 'flavor': 'Nessuno sa se devono il proprio nome alla malattia che trasmettono o alla velocità con cui si moltiplicano.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99017&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e2f3776d-c458-4a1f-878f-eacfb6d2bc92', 'multiverseId': 99017}, 'multiverseid': 99017}, {'name': '疫病甲虫', 'text': '沼渡り （このクリーチャーは防御プレイヤーが沼をコントロールしている限りブロックされない。）', 'type': 'クリーチャー — 昆虫', 'flavor': 'この名前がつけられたのは奴らが伝染させる病気からなのか、それとも奴らが繁殖するその速さからなのか、誰も知らない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99377&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '03ef3877-4734-4064-9719-3d7937d21be6', 'multiverseId': 99377}, 'multiverseid': 99377}, {'name': 'Besouro Pestilento', 'text': 'Travessia de Pântano (Esta criatura não pode ser bloqueada desde que o jogador defensor controle um Pântano.)', 'type': 'Criatura — Inseto', 'flavor': 'Ninguém sabe se seu nome vem da doença que transmite ou da velocidade com que se multiplica.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99737&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '27e1a489-bc94-45fa-89be-6a38183fb134', 'multiverseId': 99737}, 'multiverseid': 99737}, {'name': 'Чумной жук', 'text': 'Знание болот (Это существо невозможно заблокировать, пока обороняющийся игрок контролирует Болото).', 'type': 'Существо — Насекомое', 'flavor': 'Никто не знает, назвали его так, оттого что он переносит чуму или оттого что он размножается с невероятной скоростью.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110008&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'df5e9634-9aa0-4054-b4ac-c3c46b9aec60', 'multiverseId': 110008}, 'multiverseid': 110008}, {'name': '疫病甲虫', 'text': '沼泽行者（只要防御牌手操控沼泽，此生物便不能被阻挡）', 'type': '生物～昆虫', 'flavor': '没人知道它们的称呼是源于身上所带的疾病，或是它们繁殖的速度。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97937&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e820f47a-eb7d-40ad-9071-6b31bd0753a6', 'multiverseId': 97937}, 'multiverseid': 97937}]", '[{\'name\': \'Seuchenwind\', \'text\': \'Zerstöre alle Kreaturen, die du nicht kontrollierst. Sie können nicht regeneriert werden.\', \'type\': \'Hexerei\', \'flavor\': \'„Der zweite Wind der Himmelfahrt ist der Schnitter, der die Unwürdigen niederwirft." —Keldischer Siegesgesang\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98658&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ab0d6895-6e0d-4293-bc49-81f3455171e7\', \'multiverseId\': 98658}, \'multiverseid\': 98658}, {\'name\': \'Viento pestilente\', \'text\': \'Destruye todas las criaturas que no controles. No pueden ser regeneradas.\', \'type\': \'Conjuro\', \'flavor\': \'"El segundo viento de ascensión es Desgarrador, matando al que no es merecedor." —Keld Triunfante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100098&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8602ff4b-a601-44d7-8c7f-25e74abfa244\', \'multiverseId\': 100098}, \'multiverseid\': 100098}, {\'name\': \'Vent de peste\', \'text\': \'Détruisez toutes les créatures que vous ne contrôlez pas. Elles ne peuvent pas être régénérées.\', \'type\': \'Rituel\', \'flavor\': "« Le deuxième vent de l\'ascension est Pilleur, tueur d\'infâmes. » —Keld triomphant", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98298&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a0f5258-c7d6-4a57-9a73-6d06e74488ad\', \'multiverseId\': 98298}, \'multiverseid\': 98298}, {\'name\': \'Vento Pestilenziale\', \'text\': \'Distruggi tutte le creature che non controlli. Non possono essere rigenerate.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il secondo vento dell\\\'ascensione è il Predatore, sterminatore di indegni." —Keld Trionfante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99018&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c228e0f-73c6-479c-b937-15817eafa259\', \'multiverseId\': 99018}, \'multiverseid\': 99018}, {\'name\': \'疫病風\', \'text\': \'あなたがコントロールしていない、すべてのクリーチャーを破壊する。 それらは再生できない。\', \'type\': \'ソーサリー\', \'flavor\': \'昇天の第二の風は、もぎ取る者の風なり。価値なき物を破壊する風なり。 ――輝かしきケルドの書\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99378&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1bcc9aae-b3d0-4432-8d34-e31b0828a13d\', \'multiverseId\': 99378}, \'multiverseid\': 99378}, {\'name\': \'Vento Pestilento\', \'text\': \'Destrói todas as criaturas que você não controla. Elas não podem ser regeneradas.\', \'type\': \'Feitiço\', \'flavor\': \'"O segundo vento da ascensão é o Arrebatador, que extermina os ímpios." — Triunfante de Keld\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99738&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f71e249-843f-46f0-a33d-0656a8877d57\', \'multiverseId\': 99738}, \'multiverseid\': 99738}, {\'name\': \'Чумной ветер\', \'text\': \'Уничтожьте все существа, которых вы не контролируете. Они не могут быть регенерированы.\', \'type\': \'Волшебство\', \'flavor\': \'"Вторым придет Грабитель, уничтожающий недостойных". — Келд Победитель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110009&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da35c1e7-5703-46ed-95e1-720e0e40c31c\', \'multiverseId\': 110009}, \'multiverseid\': 110009}, {\'name\': \'疫病之风\', \'text\': \'消灭所有不由你操控的生物。 它们不能重生。\', \'type\': \'法术\', \'flavor\': \'「升华次风，风名掠火，除灭普天鄙陋。」 ～凯尔顿凯旋志\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97938&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1734bf7e-4349-4ec8-98cb-f712cd512afc\', \'multiverseId\': 97938}, \'multiverseid\': 97938}]', '[{\'name\': \'Shivan-Drache\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\n{R}: Der Shivan-Drache erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Er ist der uneingeschränkte Herrscher der shivanischen Berge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98710&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee102e30-5409-475b-aa88-8d40bbe9f070\', \'multiverseId\': 98710}, \'multiverseid\': 98710}, {\'name\': \'Dragón shivano\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\n{R}: El Dragón shivano obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Es el señor indisputable de las montañas de Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100150&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b704ffdd-6bc6-43bc-9289-0851818c0fc6\', \'multiverseId\': 100150}, \'multiverseid\': 100150}, {\'name\': \'Dragon shivân\', \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\n{R} : Le Dragon shivân gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : dragon\', \'flavor\': "C\'est le maître incontesté des montagnes de Shiv.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98350&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2a863e9-0d49-4971-90e5-1ba93d5b87e9\', \'multiverseId\': 98350}, \'multiverseid\': 98350}, {\'name\': \'Drago di Shivan\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\n{R}: Il Drago di Shivan prende +1/+0 fino alla fine del turno\', \'type\': \'Creatura — Drago\', \'flavor\': \'Il Signore incontrastato delle montagne di Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99070&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cdee5db8-04a3-4f31-82f3-7c0e6c2e3086\', \'multiverseId\': 99070}, \'multiverseid\': 99070}, {\'name\': \'シヴ山のドラゴン\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n{R}：シヴ山のドラゴンはターン終了時まで+1/+0の修整を受ける。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'まぎれもなくシヴの山々の主である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99430&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f3caea95-467e-47ec-b1c9-b2a0bdffb2f1\', \'multiverseId\': 99430}, \'multiverseid\': 99430}, {\'name\': \'Dragão de Shiva\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\n{R}: Dragão de Shiva recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'O senhor inquestionável das montanhas de Shiv.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99790&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9fc2322-950e-493b-a4ac-5da9f7259182\', \'multiverseId\': 99790}, \'multiverseid\': 99790}, {\'name\': \'Шиванский дракон\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\n{R}: Шиванский дракон получает +1/+0 до конца хода.\', \'type\': \'Существо — Дракон\', \'flavor\': \'Неоспоримый хозяин Шиванских гор.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110061&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93d8584b-e125-4213-aced-6f33dadc2713\', \'multiverseId\': 110061}, \'multiverseid\': 110061}, {\'name\': \'西瓦巨龙\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n{R}：西瓦巨龙得+1/+0直到回合结束。\', \'type\': \'生物～龙\', \'flavor\': \'西瓦山脉无庸置疑的主人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97990&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ed6d2215-c26d-42ca-95b4-2bc1bf209abc\', \'multiverseId\': 97990}, \'multiverseid\': 97990}]', "[{'name': 'Shivanisches Riff', 'text': '{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {U} oder {R}. Das Shivanische Riff fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98711&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0801e165-3612-4e93-9dc7-7e1bb6389c0e', 'multiverseId': 98711}, 'multiverseid': 98711}, {'name': 'Arrecife shivano', 'text': '{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {U} o {R} a tu reserva de maná. El Arrecife shivano te hace 1 punto de daño.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100151&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '095e9181-f476-49f4-ad12-ac0db74b2341', 'multiverseId': 100151}, 'multiverseid': 100151}, {'name': 'Brisants shivâns', 'text': '{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {U} ou {R} à votre réserve. Ces Brisants shivâns vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98351&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ebe396ea-2781-4a6f-bec6-69aa83178828', 'multiverseId': 98351}, 'multiverseid': 98351}, {'name': 'Barriera di Shiv', 'text': '{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {U} o {R} alla tua riserva di mana. La Barriera di Shiv ti infligge 1 danno.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99071&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '98715019-7877-4ed4-913b-40d02f284588', 'multiverseId': 99071}, 'multiverseid': 99071}, {'name': 'シヴの浅瀬', 'text': '{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{U}か{R}を加える。 シヴの浅瀬はあなたに１点のダメージを与える。', 'type': '土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99431&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9e45b72c-b9b5-41f9-b030-bccc279f7e34', 'multiverseId': 99431}, 'multiverseid': 99431}, {'name': 'Recifes de Shiv', 'text': '{T}: Adiciona {1} à sua reserva de mana.\\n{T}: Adiciona {U} ou {R} à sua reserva de mana. Recifes de Shiv causa 1 ponto de dano a você.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99791&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9c352cac-10b4-4063-96de-603680caf4c7', 'multiverseId': 99791}, 'multiverseid': 99791}, {'name': 'Шиванский риф', 'text': '{T}: Добавьте {1} в запас маны.\\n{T}: Добавьте {U} или {R} в запас маны. Шиванский риф наносит вам 1 повреждение.', 'type': 'Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110062&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'eb96e7ac-298e-4bc3-a8e8-a4232a8d62c4', 'multiverseId': 110062}, 'multiverseid': 110062}, {'name': '西瓦暗礁', 'text': '{T}：加{1}到你的法术力池中。\\n{T}：加{U}或{R}到你的法术力池中。 西瓦暗礁对你造成1点伤害。', 'type': '地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97991&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3576a746-3431-44a9-af46-c8372789f0b9', 'multiverseId': 97991}, 'multiverseid': 97991}]", '[{\'name\': \'Skrupelloser Dieb\', \'text\': \'Der Skrupellose Dieb kann nicht blocken.\', \'type\': \'Kreatur — Zombie, Söldner\', \'flavor\': \'Was ihm an Rückgrat fehlt, macht er durch Grausamkeit wieder wett.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98723&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f8fa47c4-7d34-4060-9076-5ab08553f40b\', \'multiverseId\': 98723}, \'multiverseid\': 98723}, {\'name\': \'Malhechor cobarde\', \'text\': \'El Malhechor cobarde no puede bloquear.\', \'type\': \'Criatura — Mercenario zombie\', \'flavor\': \'Lo que le falta de determinación, lo tiene de crueldad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100163&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4e04016-3cfd-4cdd-a539-63c3632fbc66\', \'multiverseId\': 100163}, \'multiverseid\': 100163}, {\'name\': \'Étrangleur mou\', \'text\': "L\'Étrangleur mou ne peut pas bloquer.", \'type\': \'Créature : zombie et mercenaire\', \'flavor\': \'Ce qui lui manque en fermeté, il le rattrape en cruauté.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98363&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67701e9c-47f6-4c0f-a130-d13666571a13\', \'multiverseId\': 98363}, \'multiverseid\': 98363}, {\'name\': \'Thug Codardo\', \'text\': \'Il Thug Codardo non può bloccare.\', \'type\': \'Creatura — Mercenario Zombie\', \'flavor\': \'Quello che gli manca in termini di coraggio lo compensa con la crudeltà.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99083&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d3b6c9e2-a651-48f6-b162-30837f9f98e2\', \'multiverseId\': 99083}, \'multiverseid\': 99083}, {\'name\': \'骨なしの凶漢\', \'text\': \'骨なしの凶漢はブロックに参加できない。\', \'type\': \'クリーチャー — ゾンビ・傭兵\', \'flavor\': \'奴らは背骨がない分、残忍さで埋め合わせているんだよ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99443&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71ba7bd5-2503-43da-a26f-47bb45471fea\', \'multiverseId\': 99443}, \'multiverseid\': 99443}, {\'name\': \'Rufia Vacilante\', \'text\': \'Rufia Vacilante não pode bloquear.\', \'type\': \'Criatura — Mercenário Zumbi\', \'flavor\': \'O que lhe falta em firmeza ele compensa em crueldade.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99803&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'593fabf6-72f6-41ea-a0e1-b29bcf237b97\', \'multiverseId\': 99803}, \'multiverseid\': 99803}, {\'name\': \'Беспозвоночный убийца\', \'text\': \'Беспозвоночный убийца не может блокировать.\', \'type\': \'Существо — Зомби Наемник\', \'flavor\': \'Недостаток костей он восполняет жестокостью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110074&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'376cc8c1-8070-41f6-8bea-17b0c50cccc6\', \'multiverseId\': 110074}, \'multiverseid\': 110074}, {\'name\': \'软脚流氓\', \'text\': \'软脚流氓不能进行阻挡。\', \'type\': \'生物～灵俑／佣兵\', \'flavor\': \'这没骨气的家伙硬是摆出副凶残模样。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98003&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dfed2b55-199d-45f0-98d0-ab1f4b3bf640\', \'multiverseId\': 98003}, \'multiverseid\': 98003}]', '[{\'name\': \'Sommerblüte\', \'text\': \'Du kannst in diesem Zug bis zu drei zusätzliche Länder spielen.\', \'type\': \'Hexerei\', \'flavor\': \'Der Sommer sendet mit Wärme und blühendem Leben seinen Gruß.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98732&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dce36c91-8e38-4bb3-927d-d6e9476c3a44\', \'multiverseId\': 98732}, \'multiverseid\': 98732}, {\'name\': \'Floración estival\', \'text\': \'Puedes jugar hasta tres tierras adicionales este turno.\', \'type\': \'Conjuro\', \'flavor\': \'El verano envía su beso con calor y vida floreciente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100172&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82737b5e-d49c-458e-a61f-39c95d425ec9\', \'multiverseId\': 100172}, \'multiverseid\': 100172}, {\'name\': \'Floraison estivale\', \'text\': "Vous pouvez jouer jusqu\'à trois terrains supplémentaires ce tour-ci.", \'type\': \'Rituel\', \'flavor\': "Le baiser de l\'été sent la chaleur et la vie qui s\'épanouit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98372&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ab0cfb06-5f76-4da9-b649-92b70dbca25c\', \'multiverseId\': 98372}, \'multiverseid\': 98372}, {\'name\': \'Fioritura Estiva\', \'text\': \'Puoi giocare fino a tre terre addizionali in questo turno.\', \'type\': \'Stregoneria\', \'flavor\': "L\'estate trasmette i propri doni tramite il tepore e la fioritura.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99092&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee39cc78-e4b7-445c-a71d-fc7be08aba6a\', \'multiverseId\': 99092}, \'multiverseid\': 99092}, {\'name\': \'花盛りの夏\', \'text\': \'このターン、あなたはさらに３枚までの土地をプレイしてもよい。\', \'type\': \'ソーサリー\', \'flavor\': \'ぬくもりと花開く生命をこめて、夏がくちづけを送る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99452&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de95e05a-0fcd-43ed-a09d-4b1ceeaa25b5\', \'multiverseId\': 99452}, \'multiverseid\': 99452}, {\'name\': \'Floração Estival\', \'text\': \'Você pode baixar até três terrenos adicionais neste turno.\', \'type\': \'Feitiço\', \'flavor\': \'O verão manda seus beijos com calor e vida viçosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99812&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41f624eb-0cd0-4084-a0ce-8a4c82c1f9b1\', \'multiverseId\': 99812}, \'multiverseid\': 99812}, {\'name\': \'Летнее цветение\', \'text\': \'В этот ход вы можете разыграть до трех дополнительных земель.\', \'type\': \'Волшебство\', \'flavor\': \'Поцелуи лета это тепло и цветущая жизнь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110083&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f4286f3-58e8-45e2-8ab8-7ac73580e9ce\', \'multiverseId\': 110083}, \'multiverseid\': 110083}, {\'name\': \'仲夏之花\', \'text\': \'你本回合至多可以额外使用三个地。\', \'type\': \'法术\', \'flavor\': \'盛夏用温暖与生生不息的生命来亲吻世界。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'475988c8-8781-4aba-91f0-0435f45e1c8d\', \'multiverseId\': 98012}, \'multiverseid\': 98012}]', '[{\'name\': \'Sonnenschwanz-Falke\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Sein Auge ist wie die brennende Sonne, sein Ruf wie der scharfe Wind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'823ec8de-9857-4996-9280-e1881144b732\', \'multiverseId\': 98733}, \'multiverseid\': 98733}, {\'name\': \'Halcón colasol\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\', \'type\': \'Criatura — Ave\', \'flavor\': \'Su ojo es el sol deslumbrador, su grito es el viento cortante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100173&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b9043fc0-02f7-4828-9acf-4dcc629e012d\', \'multiverseId\': 100173}, \'multiverseid\': 100173}, {\'name\': \'Faucon mordoré\', \'text\': \'Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\', \'type\': \'Créature : oiseau\', \'flavor\': "Son regard a la radiance du soleil ; son cri, l\'intensité du vent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98373&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bd3b71c-fac7-4b2e-ae6e-0e1c568fe5e1\', \'multiverseId\': 98373}, \'multiverseid\': 98373}, {\'name\': \'Falco Astrocoda\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\', \'type\': \'Creatura — Uccello\', \'flavor\': \'Il suo occhio è il sole abbagliante, il suo grido è il vento tagliente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99093&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d7f03713-a13a-42f6-9318-c7a53b56db92\', \'multiverseId\': 99093}, \'multiverseid\': 99093}, {\'name\': \'陽光尾の鷹\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'その眼は輝く太陽、その叫びは身を切る風。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99453&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1f29213-ad40-4f33-955e-71062bb70e45\', \'multiverseId\': 99453}, \'multiverseid\': 99453}, {\'name\': \'Falcão da Cauda Solar\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\', \'type\': \'Criatura — Pássaro\', \'flavor\': \'Seu olho, o sol fulgurante; seu grito, o vento penetrante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'043d5b12-1c22-410a-a7b4-0e79693c0730\', \'multiverseId\': 99813}, \'multiverseid\': 99813}, {\'name\': \'Солнечный ястреб\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\', \'type\': \'Существо — Птица\', \'flavor\': \'Взор его яркое солнце, крик его воющий ветер.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110084&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'efa4e05c-03e0-437d-bd8c-5ce8b706c8c2\', \'multiverseId\': 110084}, \'multiverseid\': 110084}, {\'name\': \'旭羽翔鹰\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\', \'type\': \'生物～鸟\', \'flavor\': \'目如炫日，鸣似寒风。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0dd252ee-81ae-4d78-8eab-a1e5097cff19\', \'multiverseId\': 98013}, \'multiverseid\': 98013}]', "[{'name': 'Speichermatrix', 'text': 'Solange die Speichermatrix nicht getappt ist, bestimmt jeder Spieler während seines Enttappsegments Artefakt, Kreatur oder Land. Dieser Spieler kann in diesem Segment nur bleibende Karten dieses Typs enttappen.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98726&type=card', 'language': 'German', 'identifiers': {'scryfallId': '94503a49-7a22-4c49-a6d5-5842d760dfa4', 'multiverseId': 98726}, 'multiverseid': 98726}, {'name': 'Matriz de almacenaje', 'text': 'Mientras la Matriz de almacenaje esté enderezada, cada jugador elige entre artefacto, criatura o tierra durante su paso de enderezar. Ese jugador endereza sólo los permanentes del tipo elegido este paso.', 'type': 'Artefacto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100166&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0629d186-fa2e-4bea-808f-cbc4438266e7', 'multiverseId': 100166}, 'multiverseid': 100166}, {'name': 'Matrice de stockage', 'text': 'Tant que la Matrice de stockage est dégagée, chaque joueur choisit artefact, créature ou terrain pendant son étape de dégagement. Ce joueur ne peut dégager que les permanents du type choisi pendant cette étape.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98366&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b45156d3-f695-4d7c-a4fa-770490d44f46', 'multiverseId': 98366}, 'multiverseid': 98366}, {'name': 'Matrice di Deposito', 'text': 'Fintanto che la Matrice di Deposito è STAPpata, ciascun giocatore sceglie tra artefatto, creatura o terra durante il proprio STAP. Quel giocatore può STAPpare solo i permanenti del tipo scelto in questa interfase.', 'type': 'Artefatto', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99086&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '34163766-ba13-41cf-8c34-2e4c2cc1c2be', 'multiverseId': 99086}, 'multiverseid': 99086}, {'name': '保管庫集合所', 'text': '保管庫集合所がアンタップ状態である限り、各プレイヤーは自分のアンタップ・ステップに、アーティファクト、クリーチャー、土地のいずれか１つを選ぶ。 そのプレイヤーは、このステップで選んだタイプのパーマネントのみをアンタップする。', 'type': 'アーティファクト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99446&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c2201a5a-71fd-4049-a119-dc0452a4f2e8', 'multiverseId': 99446}, 'multiverseid': 99446}, {'name': 'Matriz de Armazenagem', 'text': 'Enquanto Matriz de Armazenagem estiver desvirado, cada jogador escolhe artefato, criatura ou terreno durante sua própria etapa de desvirar. Aquele jogador só pode desvirar as permanentes do tipo escolhido nesta etapa.', 'type': 'Artefato', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99806&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c49499ba-00f7-40bb-96c9-0d6d8f5f6fc7', 'multiverseId': 99806}, 'multiverseid': 99806}, {'name': 'Запоминающая матрица', 'text': 'Пока Запоминающая матрица не повернута, каждый игрок выбирает артефакт, существо или землю во время своего этапа разворота. Во время этого хода игрок может развернуть только перманенты выбранного типа.', 'type': 'Артефакт', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110077&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a7d466b4-b774-4a6e-9e14-b75840626a5b', 'multiverseId': 110077}, 'multiverseid': 110077}, {'name': '储藏密室', 'text': '只要储藏密室未横置，则每位牌手于其重置步骤中选择神器，生物或地。 该牌手于此步骤中只能重置所选择之类别的永久物。', 'type': '神器', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98006&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '984cb677-7bc3-4a0f-bd5b-4f0882a51032', 'multiverseId': 98006}, 'multiverseid': 98006}]", "[{'name': 'Spinnennetz', 'text': 'Kreaturenverzauberung (Bestimme eine Kreatur als Ziel, sowie du diese Karte spielst. Diese Karte kommt an die Kreatur angelegt ins Spiel.)\\nDie verzauberte Kreatur erhält +0/+2 und kann blocken, als ob sie Flugfähigkeit hätte.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98779&type=card', 'language': 'German', 'identifiers': {'scryfallId': '455e48dd-bb04-46fa-94fe-b4aa4ca8e2ff', 'multiverseId': 98779}, 'multiverseid': 98779}, {'name': 'Telaraña', 'text': 'Encantar criatura (Haz objetivo a una criatura al jugarlo. Esta carta entra en juego anexada a esa criatura.)\\nLa criatura encantada obtiene +0/+2 y puede bloquear como si tuviera la habilidad de volar', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100219&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b8620894-32ba-47d2-b9b9-9239cb7b8cec', 'multiverseId': 100219}, 'multiverseid': 100219}, {'name': 'Tisseur de toile', 'text': 'Enchanter : créature (Ciblez une créature au moment où vous jouez cette carte. Cette carte arrive en jeu attachée à cette créature.)\\nLa créature enchantée gagne +0/+2 et elle peut bloquer comme si elle avait le vol.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98419&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bfda7db5-55f6-481d-b89d-56dc88011886', 'multiverseId': 98419}, 'multiverseid': 98419}, {'name': 'Ragnatela', 'text': 'Incanta creatura (Scegli come bersaglio una creatura mentre giochi questa magia. Questa carta entra in gioco assegnata a quella creatura.)\\nLa creatura incantata prende +0/+2 e può bloccare come se avesse volare.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99139&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '98f96680-0e19-4a78-9653-c7c81fc6536e', 'multiverseId': 99139}, 'multiverseid': 99139}, {'name': '蜘蛛の巣', 'text': 'エンチャント（クリーチャー） （これをプレイする際に、クリーチャー１体を対象とする。 このカードはそのクリーチャーにつけられている状態で場に出る。）\\nエンチャントされているクリーチャーは+0/+2の修整を受けるとともに、それが飛行を持っているかのようにブロックに参加できる。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99499&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd1464f8b-8b35-4b79-b624-d8271a2156f0', 'multiverseId': 99499}, 'multiverseid': 99499}, {'name': 'Teia', 'text': 'Encantar criatura (Vise uma criatura conforme jogar este card. Este card entra em jogo anexado àquela criatura.)\\nA criatura encantada recebe +0/+2 e pode bloquear como se tivesse a habilidade de voar.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99859&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '821c8789-f540-4513-b459-df6317dde3b8', 'multiverseId': 99859}, 'multiverseid': 99859}, {'name': 'Паутина', 'text': 'Зачаровать существо (Когда вы разыгрываете эту карту, целью является существо. Карта вступает в игру вместе с этим существом).\\nЗачарованное существо получает +0/+2 и может блокировать, как если бы она обладала способностью полета.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110130&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '34324051-aed1-428c-8bce-d08e52895091', 'multiverseId': 110130}, 'multiverseid': 110130}, {'name': '天网', 'text': '生物结界（于使用时指定一个生物为目标。 此牌进场时结附在该生物上）\\n受此结界的生物得+0/+2，且能视同具飞行异能地进行阻挡。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98059&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '303eb170-9081-4c03-9561-a8e3a645ed45', 'multiverseId': 98059}, 'multiverseid': 98059}]", '[{\'name\': \'Splitterphoenix\', \'text\': \'Fliegend (Diese Kreatur kann nur von fliegenden Kreaturen geblockt werden.)\\nOpfere den Splitterphoenix: Der Splitterphoenix fügt allen nichtfliegenden Kreaturen 2 Schadenspunkte zu.\\n{R}{R}{R}: Bringe den Splitterphoenix aus deinem Friedhof auf deine Hand zurück. Spiele diese Fähigkeit nur während deines Versorgungssegments.\', \'type\': \'Kreatur — Phoenix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98708&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf80b930-07ab-402a-8ed5-62492d4866f3\', \'multiverseId\': 98708}, \'multiverseid\': 98708}, {\'name\': \'Fénix de astillas\', \'text\': \'Vuela. (Esta criatura no puede ser bloqueada excepto por criaturas que tengan la habilidad de volar.)\\nSacrificar el Fénix de astillas: El Fénix de astillas hace 2 puntos de daño a cada criatura que no tenga la habilidad de volar.\\n{R}{R}{R}: Regresa el Fénix de astillas de tu cementerio a tu mano. Juega esta habilidad sólo durante tu mantenimiento.\', \'type\': \'Criatura — Fénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100148&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22c04ca5-ca8e-4881-9730-3f47ffa3aaad\', \'multiverseId\': 100148}, \'multiverseid\': 100148}, {\'name\': "Phénix d\'échardes", \'text\': "Vol (Cette créature ne peut être bloquée que par des créatures avec le vol.)\\nSacrifiez le Phénix d\'échardes : Le Phénix d\'échardes inflige 2 blessures à chaque créature sans le vol.\\n{R}{R}{R} : Renvoyez le Phénix d\'échardes depuis votre cimetière dans votre main. Ne jouez cette capacité que pendant votre entretien.", \'type\': \'Créature : phénix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98348&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e9e8ba0-6867-4402-9a22-04d3c1423335\', \'multiverseId\': 98348}, \'multiverseid\': 98348}, {\'name\': \'Fenice di Schegge\', \'text\': \'Volare (Questa creatura non può essere bloccata tranne che da creature con volare.)\\nSacrifica la Fenice di Schegge: La Fenice di Schegge infligge 2 danni a ogni creatura senza volare.\\n{R}{R}{R}: Riprendi in mano la Fenice di Schegge dal tuo cimitero. Gioca questa abilità solo durante il tuo mantenimento.\', \'type\': \'Creatura — Fenice\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99068&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8fe1b9d7-06b4-4dcc-add3-9732b82d304a\', \'multiverseId\': 99068}, \'multiverseid\': 99068}, {\'name\': \'陶片のフェニックス\', \'text\': \'飛行 （このクリーチャーは飛行を持たないクリーチャーによってブロックされない。）\\n陶片のフェニックスを生け贄に捧げる：陶片のフェニックスは、飛行を持たない各クリーチャーにそれぞれ２点のダメージを与える。\\n{R}{R}{R}：あなたの墓地にある陶片のフェニックスをあなたの手札に戻す。 この能力は、あなたのアップキープの間にのみプレイできる。\', \'type\': \'クリーチャー — フェニックス\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99428&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eab6c852-6674-49ed-a344-b3c62fdf5ef3\', \'multiverseId\': 99428}, \'multiverseid\': 99428}, {\'name\': \'Fênix Fragmentária\', \'text\': \'Voar (Esta criatura só pode ser bloqueada por criaturas com a habilidade de voar.)\\nSacrifique Fênix Fragmentária: Fênix Fragmentária causa 2 pontos de dano a cada criatura sem a habilidade de voar.\\n{R}{R}{R}: Devolve Fênix Fragmentária de seu cemitério para a sua mão. Use esta habilidade somente durante sua manutenção.\', \'type\': \'Criatura — Fênix\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=99788&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3dc3d73-7145-4bab-bb5c-492ccd0f273e\', \'multiverseId\': 99788}, \'multiverseid\': 99788}, {\'name\': \'Осколочный феникс\', \'text\': \'Полет (Это существо может быть блокировано только существом со способностью полета).\\nПринесите Растерзанного феникса в жертву: Осколочный феникс наносит 2 повреждения каждому существу без способности полета.\\n{R}{R}{R}: Верните Осколочного феникса с кладбища в руку. Вы можете разыграть эту способность только во время своего этапа поддержки.\', \'type\': \'Существо — Феникс\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=110059&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6306af04-34f1-40c6-aa9e-28c1e4b8b6da\', \'multiverseId\': 110059}, \'multiverseid\': 110059}, {\'name\': \'碎翼凤凰\', \'text\': \'飞行（只有具飞行异能的生物才能阻挡它。）\\n牺牲碎翼凤凰：碎翼凤凰对每个不具飞行异能的生物各造成2点伤害。\\n{R}{R}{R}：将碎翼凤凰从你的坟墓场移回你手上。 你只可以于你的维持中使用此异能。\', \'type\': \'生物～凤凰\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=97988&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'abbb5721-f852-4817-a799-761a4ec09b3b\', \'multiverseId\': 97988}, \'multiverseid\': 97988}]', "[{'name': 'Stab des Verderbens', 'text': '{3}, {T}: Der Stab des Verderbens fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.', 'type': 'Artefakt', 'flavor': 'Der Stab ist ein Überbleibsel aus alten Zeiten... grausamen, verderbten, gemeinen Zeiten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=98683&type=card', 'language': 'German', 'identifiers': {'scryfallId': '473a8cbc-38e5-4075-9c62-64b5c8593662', 'multiverseId': 98683}, 'multiverseid': 98683}, {'name': 'Bastón de destrucción', 'text': '{3}, {T}: El Bastón de destrucción hace 1 punto de daño a la criatura o jugador objetivo.', 'type': 'Artefacto', 'flavor': 'El bastón es una reliquia de tiempos antiguos . . . tiempos crueles, malvados y malignos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=100123&type=card', 'language': 'Spanish', 'identifiers': {'s