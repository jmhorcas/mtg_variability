printings: ['10E', '2ED', '2X2', '2XM', '30A', '3ED', '40K', '4BB', '4ED', '5DN', '5ED', '6ED', '7ED', '8ED', '9ED', 'A25', 'AFC', 'AKR', 'ALA', 'ANB', 'ARB', 'ARC', 'BBD', 'BRB', 'BRC', 'BRR', 'BTD', 'C13', 'C14', 'C15', 'C16', 'C17', 'C18', 'C19', 'C20', 'C21', 'CC1', 'CC2', 'CED', 'CEI', 'CHK', 'CLB', 'CLU', 'CM1', 'CM2', 'CMA', 'CMD', 'CMM', 'CMR', 'CN2', 'CNS', 'CST', 'DD1', 'DD2', 'DDC', 'DDD', 'DDE', 'DDG', 'DDH', 'DDI', 'DDJ', 'DDK', 'DDM', 'DDO', 'DDR', 'DDS', 'DKA', 'DMC', 'DMR', 'DVD', 'E01', 'E02', 'ELD', 'EMA', 'EVG', 'F02', 'F04', 'F05', 'F07', 'F08', 'F09', 'F10', 'F11', 'FBB', 'G05', 'GK1', 'GN3', 'GPT', 'GVL', 'HA2', 'HA3', 'HA7', 'HOP', 'ICE', 'IMA', 'INV', 'J12', 'J15', 'J16', 'J17', 'J18', 'J21', 'J22', 'JMP', 'JUD', 'JVC', 'KHC', 'LCC', 'LEA', 'LEB', 'LEG', 'LTC', 'M11', 'M12', 'M13', 'M21', 'ME1', 'ME2', 'ME3', 'ME4', 'MED', 'MH1', 'MH2', 'MIC', 'MKC', 'MM2', 'MM3', 'MMA', 'MMQ', 'MOC', 'MP2', 'MPS', 'MRD', 'MUL', 'NCC', 'NEC', 'NPH', 'OC14', 'OC15', 'OCMD', 'OLGC', 'ONC', 'ONS', 'OTC', 'P07', 'P08', 'P10E', 'P30A', 'PC2', 'PCA', 'PCLB', 'PCMD', 'PCMP', 'PCMR', 'PCY', 'PF19', 'PIDW', 'PIP', 'PJ21', 'PJAS', 'PJJT', 'PJSE', 'PL23', 'PLC', 'PLG22', 'PLS', 'PLST', 'PM21', 'PMEI', 'POR', 'PPRO', 'PRM', 'PSAL', 'PSUS', 'PTC', 'PTK', 'PUMA', 'PW22', 'PW23', 'PW24', 'PZ1', 'RAV', 'REN', 'REX', 'ROE', 'RVR', 'SCD', 'SCG', 'SHM', 'SIS', 'SLD', 'SLP', 'SPG', 'SS1', 'SS2', 'SS3', 'STA', 'STH', 'SUM', 'TD0', 'TD2', 'TMP', 'TOR', 'TPR', 'TSP', 'TSR', 'UDS', 'ULG', 'UMA', 'USG', 'V10', 'V13', 'V14', 'VIS', 'VMA', 'VOC', 'WC00', 'WC01', 'WC02', 'WC03', 'WC04', 'WC98', 'WC99', 'WHO', 'WOC', 'WOT', 'WWK', 'ZEN', 'ZNC']
