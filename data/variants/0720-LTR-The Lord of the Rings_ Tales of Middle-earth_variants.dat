er.wizards.com/Handlers/Image.ashx?multiverseid=619057&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '54ed9f89-398c-43bb-94d5-1c19f2c8cbdc', 'multiverseId': 619057}, 'multiverseid': 619057}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619067&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'db6cfc06-9b5b-47c5-872b-fc7a228d20a9', 'multiverseId': 619067}, 'multiverseid': 619067}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619077&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '100c4282-6206-40ce-9b97-bd55cd2bc08e', 'multiverseId': 619077}, 'multiverseid': 619077}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619018&type=card', 'language': 'German', 'identifiers': {'scryfallId': '34c53b6b-57e4-41b4-8f8c-0990907b5611', 'multiverseId': 619018}, 'multiverseid': 619018}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619028&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '79f29f85-2997-415c-ab62-863bef82a052', 'multiverseId': 619028}, 'multiverseid': 619028}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619038&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bf0e70f0-4906-45fe-87db-f28240200981', 'multiverseId': 619038}, 'multiverseid': 619038}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619048&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '802c19cc-64c4-4a5c-9dac-1549ba1c9c32', 'multiverseId': 619048}, 'multiverseid': 619048}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619058&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd6100b75-b7d9-4aae-a4d6-ae46f574580c', 'multiverseId': 619058}, 'multiverseid': 619058}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619068&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '582711c5-9c56-4ce9-bb5f-65ea988aa45b', 'multiverseId': 619068}, 'multiverseid': 619068}, {'name': '树林', 'type': '基本地 ～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619078&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fecf2596-78e8-4caf-9de0-5de52f34a3d7', 'multiverseId': 619078}, 'multiverseid': 619078}]", '[{\'name\': \'Waldläufer aus Ithilien\', \'text\': \'Wachsamkeit\\nWenn die Waldläufer aus Ithilien ins Spiel kommen, übernimm die Kontrolle über bis zu eine Kreatur deiner Wahl mit niedrigerer Stärke, solange du die Waldläufer aus Ithilien kontrollierst. Dann führt der Ring dich in Versuchung.\', \'type\': \'Kreatur — Mensch, Waldläufer\', \'flavor\': \'„Wir haben eine neue Mission auf dieser Reise: die Menschen aus Harad zu überfallen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617157&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c9fd691-3efd-4771-8149-d21cdd298774\', \'multiverseId\': 617157}, \'multiverseid\': 617157}, {\'name\': \'Montaraces de Ithilien\', \'text\': \'Vigilancia.\\nCuando los Montaraces de Ithilien entren al campo de batalla, gana el control de hasta una criatura objetivo con menor fuerza mientras controles los Montaraces de Ithilien. Luego, el Anillo te tienta.\', \'type\': \'Criatura — Guardabosque humano\', \'flavor\': \'"Tenemos una nueva misión en nuestro viaje: tender una emboscada a los hombres de Harad".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617418&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'490ca3d8-cdd0-40ac-ba5f-b077cb270446\', \'multiverseId\': 617418}, \'multiverseid\': 617418}, {\'name\': "Rangers d\'Ithilien", \'text\': "Vigilance\\nQuand les Rangers d\'Ithilien arrivent sur le champ de bataille, acquérez le contrôle de jusqu\'à une créature de force inférieure ciblée tant que vous contrôlez les Rangers d\'Ithilien. Puis l\'Anneau vous tente.", \'type\': \'Créature : humain et ranger\', \'flavor\': \'« Nous avons une nouvelle mission pour ce voyage : tendre une embuscade aux hommes de Harad. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617679&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7107e05-16b7-4553-a91b-51931e63ede9\', \'multiverseId\': 617679}, \'multiverseid\': 617679}, {\'name\': \'Raminghi di Ithilien\', \'text\': "Cautela\\nQuando i Raminghi di Ithilien entrano nel campo di battaglia, prendi il controllo di fino a una creatura bersaglio con forza inferiore fintanto che controlli i Raminghi di Ithilien. Poi l\'Anello ti tenta.", \'type\': \'Creatura — Ranger Umano\', \'flavor\': \'"Un nuovo compito si aggiunge al nostro viaggio: tendere un agguato agli Uomini di Harad."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617940&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b842de26-b674-457e-a0e4-4c1f869aaef9\', \'multiverseId\': 617940}, \'multiverseid\': 617940}, {\'name\': \'イシリアンのレンジャー\', \'text\': \'警戒\\nイシリアンのレンジャーが戦場に出たとき、パワーがイシリアンのレンジャーより小さいクリーチャー最大１体を対象とする。あなたがイシリアンのレンジャーをコントロールし続けているかぎり、それのコントロールを得る。その後、指輪があなたを誘惑する。\', \'type\': \'クリーチャー — 人間・レインジャー\', \'flavor\': \'「この旅の任務は、ハラドの兵を奇襲することだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618201&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d10e9ed-f763-4b98-9d2b-86bb0d0c0659\', \'multiverseId\': 618201}, \'multiverseid\': 618201}, {\'name\': \'Caminheiros de Ithilien\', \'text\': \'Vigilância\\nQuando Caminheiros de Ithilien entrar no campo de batalha, ganhe o controle de até uma criatura alvo com poder inferior enquanto você controlar Caminheiros de Ithilien. Depois, o Anel tenta você.\', \'type\': \'Criatura — Humano Guardião\', \'flavor\': \'"Temos uma nova incumbência nessa jornada: emboscar os Homens de Harad."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618462&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'55fb3b54-62e9-4353-978f-023b68ba0f9e\', \'multiverseId\': 618462}, \'multiverseid\': 618462}, {\'name\': \'伊希利恩突击队\', \'text\': \'警戒\\n当伊希利恩突击队进战场时，于你操控伊希利恩突击队的时段内，获得至多一个目标力量比它小的生物之操控权。然后魔戒引诱你。\', \'type\': \'生物 ～人类／游侠\', \'flavor\': \'「我们此行有新使命：伏击哈拉德的人类。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618723&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6be68f1-538f-49f4-bd8b-957c8be19ae9\', \'multiverseId\': 618723}, \'multiverseid\': 618723}]', '[{\'name\': \'Waldläufer aus Ithilien\', \'text\': \'Wachsamkeit\\nWenn die Waldläufer aus Ithilien ins Spiel kommen, übernimm die Kontrolle über bis zu eine Kreatur deiner Wahl mit niedrigerer Stärke, solange du die Waldläufer aus Ithilien kontrollierst. Dann führt der Ring dich in Versuchung.\', \'type\': \'Kreatur — Mensch, Waldläufer\', \'flavor\': \'„Wir haben eine neue Mission auf dieser Reise: die Menschen aus Harad zu überfallen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619199&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2bc29a1f-75a2-46e9-9c63-6996feb53f53\', \'multiverseId\': 619199}, \'multiverseid\': 619199}, {\'name\': "Rangers d\'Ithilien", \'text\': "Vigilance\\nQuand les Rangers d\'Ithilien arrivent sur le champ de bataille, acquérez le contrôle de jusqu\'à une créature de force inférieure ciblée tant que vous contrôlez les Rangers d\'Ithilien. Puis l\'Anneau vous tente.", \'type\': \'Créature : humain et ranger\', \'flavor\': \'« Nous avons une nouvelle mission pour ce voyage : tendre une embuscade aux hommes de Harad. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619236&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4f0f189-20ae-4c21-ba9e-dc9dbd350774\', \'multiverseId\': 619236}, \'multiverseid\': 619236}, {\'name\': \'イシリアンのレンジャー\', \'text\': \'警戒\\nイシリアンのレンジャーが戦場に出たとき、パワーがイシリアンのレンジャーより小さいクリーチャー最大１体を対象とする。あなたがイシリアンのレンジャーをコントロールし続けているかぎり、それのコントロールを得る。その後、指輪があなたを誘惑する。\', \'type\': \'クリーチャー — 人間・レインジャー\', \'flavor\': \'「この旅の任務は、ハラドの兵を奇襲することだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619273&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7fe6a5d7-2ccf-4d2e-88e6-98d0b9659a02\', \'multiverseId\': 619273}, \'multiverseid\': 619273}, {\'name\': \'伊希利恩突击队\', \'text\': \'警戒\\n当伊希利恩突击队进战场时，于你操控伊希利恩突击队的时段内，获得至多一个目标力量比它小的生物之操控权。然后魔戒引诱你。\', \'type\': \'生物 ～人类／游侠\', \'flavor\': \'「我们此行有新使命：伏击哈拉德的人类。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619310&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1339ed7-84cf-439a-84e2-4ce5093e607b\', \'multiverseId\': 619310}, \'multiverseid\': 619310}]', '[{\'name\': \'Waldläufer der Dúnedain\', \'text\': \'Landung — Immer wenn ein Land unter deiner Kontrolle ins Spiel kommt und falls du keinen Ringträger kontrollierst, führt der Ring dich in Versuchung.\', \'type\': \'Kreatur — Mensch, Waldläufer\', \'flavor\': \'„Aragorn braucht die Unterstützung seiner Sippe. Lasst die Dúnedain nach Rohan ziehen, um sich ihm anzuschließen!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617250&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'00e693d4-5f3a-4f76-8d64-1d1688c29275\', \'multiverseId\': 617250}, \'multiverseid\': 617250}, {\'name\': \'Montaraces dúnedain\', \'text\': \'Aterrizaje — Siempre que una tierra entre al campo de batalla bajo tu control, si no controlas un portador del Anillo, el Anillo te tienta.\', \'type\': \'Criatura — Guardabosque humano\', \'flavor\': \'"Aragorn necesita el auxilio de los suyos. ¡Que los dúnedain lo acompañen en Rohan!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617511&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71cbdac5-f0fa-4d30-b032-86ae09103aac\', \'multiverseId\': 617511}, \'multiverseid\': 617511}, {\'name\': \'Rangers dúnedains\', \'text\': "Toucheterre — À chaque fois qu\'un terrain arrive sur le champ de bataille sous votre contrôle, si vous ne contrôlez pas de porteur de l\'Anneau, l\'Anneau vous tente.", \'type\': \'Créature : humain et ranger\', \'flavor\': \'« Aragorn a besoin des siens. Que les Dúnedains aillent le rejoindre en Rohan ! »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617772&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'12723d0a-26f0-4de3-852f-19d3f6d1b402\', \'multiverseId\': 617772}, \'multiverseid\': 617772}, {\'name\': \'Raminghi Dúnedain\', \'text\': "Terraferma — Ogniqualvolta una terra entra nel campo di battaglia sotto il tuo controllo, se non controlli un Portatore dell\'Anello, l\'Anello ti tenta.", \'type\': \'Creatura — Ranger Umano\', \'flavor\': \'"Aragorn ha bisogno della sua gente. Che i Dúnedain lo raggiungano a Rohan!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618033&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f387e56b-4187-4719-929f-fd70522530d1\', \'multiverseId\': 618033}, \'multiverseid\': 618033}, {\'name\': \'ドゥネダインのレンジャー\', \'text\': \'上陸 ― 土地１つがあなたのコントロール下で戦場に出るたび、あなたが指輪所持者をコントロールしていない場合、指輪があなたを誘惑する。\', \'type\': \'クリーチャー — 人間・レインジャー\', \'flavor\': \'「アラゴルンには一族の助けが必要だ。ドゥネダインをローハンにいる彼の元へ送れ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618294&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2875b4fc-f723-4ca4-a94f-0d602ac84926\', \'multiverseId\': 618294}, \'multiverseid\': 618294}, {\'name\': \'Caminheiros Dúnedain\', \'text\': \'Aterragem — Toda vez que um terreno entra no campo de batalha sob seu controle, se você não controla um Guardião do Anel, o Anel tenta você.\', \'type\': \'Criatura — Humano Guardião\', \'flavor\': \'"Aragorn precisa de seu povo. Que os Dúnedain sigam para encontrá-lo em Rohan!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618555&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d863a8ee-b674-423d-80cc-085f93dd7e41\', \'multiverseId\': 618555}, \'multiverseid\': 618555}, {\'name\': \'杜内丹游民\', \'text\': \'地落～每当一个地在你的操控下进战场时，若你未操控持戒人，则魔戒引诱你。\', \'type\': \'生物 ～人类／游侠\', \'flavor\': \'「阿拉贡需要自己的族人。让杜内丹人追随他去洛汗！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618816&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'60c9d742-13b3-4af3-a87f-9f4144e5dbfd\', \'multiverseId\': 618816}, \'multiverseid\': 618816}]', '[{\'name\': \'Wegefinder der Galadrim\', \'text\': \'Wenn der Wegefinder der Galadrim ins Spiel kommt, wende Hellsicht 2 an.\', \'type\': \'Kreatur — Elf, Späher\', \'flavor\': \'„Ich werde euch gut führen und die Pfade sind eben und gerade."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617259&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa31018a-f7ef-4ab5-b906-56fa8bd72354\', \'multiverseId\': 617259}, \'multiverseid\': 617259}, {\'name\': \'Guía galadrim\', \'text\': \'Cuando el Guía galadrim entre al campo de batalla, adivina 2.\', \'type\': \'Criatura — Explorador elfo\', \'flavor\': \'"Te guiaré bien, y las sendas son planas y rectas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617520&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba9f9019-f296-4332-a968-b880d84db47a\', \'multiverseId\': 617520}, \'multiverseid\': 617520}, {\'name\': \'Guide galadhrim\', \'text\': \'Quand le Guide galadhrim arrive sur le champ de bataille, regard 2.\', \'type\': \'Créature : elfe et éclaireur\', \'flavor\': \'« Je vous guiderai bien, et les chemins sont droits et plats. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617781&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0243399b-b556-45ba-9ae8-bc404d6cb097\', \'multiverseId\': 617781}, \'multiverseid\': 617781}, {\'name\': \'Guida Galadhrim\', \'text\': \'Quando la Guida Galadhrim entra nel campo di battaglia, profetizza 2.\', \'type\': \'Creatura — Esploratore Elfo\', \'flavor\': \'"Seguite i miei passi e il sentiero sarà facile e regolare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618042&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'93b1a69b-1bd3-4c9c-9030-0373f8e86f19\', \'multiverseId\': 618042}, \'multiverseid\': 618042}, {\'name\': \'ガラズリムの道案内\', \'text\': \'ガラズリムの道案内が戦場に出たとき、占術２を行う。\', \'type\': \'クリーチャー — エルフ・スカウト\', \'flavor\': \'「平坦で、歩みの軽い正しき道へ導こう。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618303&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'14903184-b62d-493e-a66a-bbc3403e3dc0\', \'multiverseId\': 618303}, \'multiverseid\': 618303}, {\'name\': \'Guia Galadhrim\', \'text\': \'Quando Guia Galadhrim entrar no campo de batalha, use vidência 2.\', \'type\': \'Criatura — Elfo Batedor\', \'flavor\': \'"Eu os guiarei bem, e as trilhas são suaves e diretas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618564&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ed0a868-dda8-4928-9b1e-7d7fe3423fda\', \'multiverseId\': 618564}, \'multiverseid\': 618564}, {\'name\': \'加拉兹民向导\', \'text\': \'当加拉兹民向导进战场时，占卜2。\', \'type\': \'生物 ～妖精／斥候\', \'flavor\': \'「我会好好地领着你们，那些路又平又直。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618825&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5d6b6b1b-b00d-4a88-8d41-2f1c48dcbedb\', \'multiverseId\': 618825}, \'multiverseid\': 618825}]', '[{\'name\': \'Weiden-Wind\', \'text\': \'Fliegend\\nWenn Weiden-Wind ins Spiel kommt, wende Hellsicht 2 an.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Die Äste der Weide begannen, sich heftig zu wiegen. Frodo schrie um Hilfe, aber er konnte seine eigene Stimme kaum vernehmen: Sie wurde ihm vom Weiden-Wind genommen und im Getöse der Blätter erstickt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617167&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'844222ba-055b-45ac-bffe-54cbf3850e8e\', \'multiverseId\': 617167}, \'multiverseid\': 617167}, {\'name\': \'Viento del sauce\', \'text\': \'Vuela.\\nCuando el Viento del sauce entre al campo de batalla, adivina 2.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Las ramas del sauce empezaron a balancearse con violencia. Frodo pidió auxilio, pero apenas podía oír su propia voz: se la llevó el viento del sauce, ahogándola en un clamor de hojas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617428&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c450ae54-206d-43bb-9e2a-5caab7eb63e6\', \'multiverseId\': 617428}, \'multiverseid\': 617428}, {\'name\': \'Vent du saule\', \'text\': \'Vol\\nQuand le Vent du saule arrive sur le champ de bataille, regard 2.\', \'type\': \'Créature : élémental\', \'flavor\': "Les branches du saule vacillèrent de plus en plus violemment. Frodo appela à l\'aide, mais il pouvait à peine entendre sa propre voix : elle était emportée par le vent du saule et se noyait dans la clameur des feuilles.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617689&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'363ae05b-4775-457e-9a1b-260412f46359\', \'multiverseId\': 617689}, \'multiverseid\': 617689}, {\'name\': \'Vento del Salice\', \'text\': \'Volare\\nQuando il Vento del Salice entra nel campo di battaglia, profetizza 2.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'I rami del salice iniziarono a ondeggiare con veemenza. Frodo chiamò aiuto, ma sentiva a malapena la propria voce, rubata dal vento del salice e soffocata dal clamore delle foglie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617950&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f5db9c3-8407-4e6d-a38b-9ddb69737673\', \'multiverseId\': 617950}, \'multiverseid\': 617950}, {\'name\': \'柳風\', \'text\': \'飛行\\n柳風が戦場に出たとき、占術２を行う。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'柳の枝が吹き乱れた。フロドは助けを呼んだが、激しい柳風と枝葉の音で自分の声すらかき消されてしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618211&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dbbc93ed-358d-4dc4-8d2d-ef7b77e63d0a\', \'multiverseId\': 618211}, \'multiverseid\': 618211}, {\'name\': \'Vento do Salgueiro\', \'text\': \'Voar\\nQuando Vento do Salgueiro entrar no campo de batalha, use vidência 2.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Os galhos do salgueiro começaram a balançar violentamente. Frodo pediu ajuda, mas mal conseguia ouvir a própria voz: ela foi soprada para longe pelo vento do salgueiro e afogada num clamor de folhas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618472&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c88e48f9-192e-4cd2-9c87-4489ddba8d97\', \'multiverseId\': 618472}, \'multiverseid\': 618472}, {\'name\': \'清柳风\', \'text\': \'飞行\\n当清柳风进战场时，占卜2。\', \'type\': \'生物 ～元素\', \'flavor\': \'柳树的枝叶开始剧烈摆动。弗罗多虽然高声呼救，但他甚至都听不到自己的声音：话语甫一出口，就被柳树的风吹走，淹没在树叶的喧嚣中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618733&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'454b1ffc-bd13-410b-b252-3e07cdc4b143\', \'multiverseId\': 618733}, \'multiverseid\': 618733}]', "[{'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617205&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f45f1f28-908a-4705-8238-e8c27a81c52b', 'multiverseId': 617205}, 'multiverseid': 617205}, {'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617466&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '638a08ee-0373-4411-972b-6decf7e358b7', 'multiverseId': 617466}, 'multiverseid': 617466}, {'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617727&type=card', 'language': 'French', 'identifiers': {'scryfallId': '66f5f202-dc1e-4e0c-bc78-1cfd602ce504', 'multiverseId': 617727}, 'multiverseid': 617727}, {'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617988&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cea592ea-b520-4d5b-a9ff-af2323415052', 'multiverseId': 617988}, 'multiverseid': 617988}, {'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618249&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b0440c03-baea-43a6-a2ef-732badc920eb', 'multiverseId': 618249}, 'multiverseid': 618249}, {'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618510&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6f8d28a7-4375-4398-89dc-d94ce92d5f93', 'multiverseId': 618510}, 'multiverseid': 618510}, {'name': 'Witch-king of Angmar', 'text': 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'type': 'Legendary Creature — Wraith Noble', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618771&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2660b924-5123-44bd-8df6-2908c549a6c4', 'multiverseId': 618771}, 'multiverseid': 618771}]", '[{\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620116&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'03e4f962-52a9-4ca1-900d-9bcbc0b6aa80\', \'multiverseId\': 620116}, \'multiverseid\': 620116}, {\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620126&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ee98e33-d80d-4289-a160-d747ef2ec5d8\', \'multiverseId\': 620126}, \'multiverseid\': 620126}, {\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620136&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e4c27a82-ed96-4198-9066-7e9f35214212\', \'multiverseId\': 620136}, \'multiverseid\': 620136}, {\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620146&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a10a7db1-b936-484e-b003-899cb1c16ef3\', \'multiverseId\': 620146}, \'multiverseid\': 620146}, {\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620156&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f0209f89-d8fc-41ed-9219-49cabd8c329d\', \'multiverseId\': 620156}, \'multiverseid\': 620156}, {\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620166&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3917b8eb-4be3-49f4-92ab-7f6e9ecac80d\', \'multiverseId\': 620166}, \'multiverseid\': 620166}, {\'name\': \'Witch-king, Bringer of Ruin\', \'text\': \'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.\', \'type\': \'Legendary Creature — Wraith Noble\', \'flavor\': \'"No living man may hinder me!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620176&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cfbe3cf6-8e33-49ca-8a58-710cad6df44d\', \'multiverseId\': 620176}, \'multiverseid\': 620176}]', '[{\'name\': \'Wunde vom Morgulmesser\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält -3/-0 und „Zu Beginn deines Versorgungssegments schickst du diese Kreatur ins Exil, es sei denn, du bezahlst 2 Lebenspunkte."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Frodo spürte einen Schmerz, als hätte ein Pfeil aus vergiftetem Eis seine Schulter durchbohrt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617189&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea390ce2-fd11-4b90-9fa7-328462e6c190\', \'multiverseId\': 617189}, \'multiverseid\': 617189}, {\'name\': \'Herida de puñal de Morgul\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene -3/-0 y tiene "Al comienzo de tu mantenimiento, exilia esta criatura a menos que pagues 2 vidas".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Frodo sintió dolor, como si un dardo de hielo emponzoñado le hubiese atravesado el hombro izquierdo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617450&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'746c00f8-7041-4c84-9bfe-a50aac72c167\', \'multiverseId\': 617450}, \'multiverseid\': 617450}, {\'name\': \'Blessure du couteau de Morgul\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne -3/-0 et a « Au début de votre entretien, exilez cette créature à moins que vous ne payiez 2 points de vie. »\', \'type\': \'Enchantement : aura\', \'flavor\': "Frodo ressentit une douleur, telle une fléchette de glace empoisonnée lui transperçant l\'épaule gauche.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617711&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ea4b91a-6a99-486d-bbfd-2d88b68dc49d\', \'multiverseId\': 617711}, \'multiverseid\': 617711}, {\'name\': \'Ferita del Pugnale Morgul\', \'text\': \'Incanta creatura\\nLa creatura incantata prende -3/-0 e ha "All\\\'inizio del tuo mantenimento, esilia questa creatura a meno che tu non paghi 2 punti vita".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Frodo provò dolore come se un dardo di ghiaccio avvelenato gli avesse trafitto la spalla sinistra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617972&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2f520b9-ca9f-42b4-8ae0-a27caa994312\', \'multiverseId\': 617972}, \'multiverseid\': 617972}, {\'name\': \'モルグルの刃による傷\', \'text\': \'エンチャント（クリーチャー）\\n エンチャントしているクリーチャーは－３/－０の修整を受け「あなたのアップキープの開始時に、あなたが２点のライフを支払わないかぎり、このクリーチャーを追放する。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'フロドは氷の毒針に刺されたかのような痛みを左肩に感じた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618233&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'916e9b78-0b22-4a21-a417-23693c8d8f22\', \'multiverseId\': 618233}, \'multiverseid\': 618233}, {\'name\': \'Ferida de Punhal de Morgul\', \'text\': \'Encantar criatura\\nA criatura encantada recebe -3/-0 e tem "No início de sua manutenção, exile esta criatura, a menos que você pague 2 pontos de vida".\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Frodo sentiu uma dor como se um dardo de gelo envenenado lhe tivesse perfurado o ombro esquerdo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618494&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'db483289-2cc1-4cac-be59-df94fdbe86be\', \'multiverseId\': 618494}, \'multiverseid\': 618494}, {\'name\': \'魔古尔刃伤\', \'text\': \'结附于生物\\n所结附的生物得-3/-0且具有「在你的维持开始时，除非你支付2点生命，否则放逐此生物。」\', \'type\': \'结界 ～灵气\', \'flavor\': \'弗罗多感到左肩传来痛楚，有种被寒冰毒镖刺穿的感觉。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618755&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b71cc1e5-8afa-4c6b-82c2-8f48e268972d\', \'multiverseId\': 618755}, \'multiverseid\': 618755}]', "[{'name': 'Wurfmaschine aus Mordor', 'text': 'Verteidiger\\nImmer wenn du mit einem oder mehreren Goblins und/oder Orks angreifst, erzeuge einen getappten und angreifenden 2/1 farblosen Konstrukt-Artefaktkreaturenspielstein mit Flugfähigkeit namens Wurfgeschoss. Opfere den Spielstein am Ende des Kampfes.', 'type': 'Artefaktkreatur — Mauer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617188&type=card', 'language': 'German', 'identifiers': {'scryfallId': '575f1f0b-db64-4f16-8008-f447bb48a0b7', 'multiverseId': 617188}, 'multiverseid': 617188}, {'name': 'Catapulta de Mordor', 'text': 'Defensor.\\nSiempre que ataques con uno o más Trasgos y/u Orcos, crea una ficha de criatura artefacto Constructo incolora 2/1 con la habilidad de volar llamada Roca balística que está girada y atacando. Sacrifica esa ficha al final del combate.', 'type': 'Criatura artefacto — Muro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617449&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '642ae20a-aa8c-4ca1-a395-32798b94a8ae', 'multiverseId': 617449}, 'multiverseid': 617449}, {'name': 'Trébuchet du Mordor', 'text': 'Défenseur\\nÀ chaque fois que vous attaquez avec au moins un gobelin et/ou un orque, créez un jeton de créature-artefact 2/1 incolore Construction avec le vol appelé Rocher balistique, engagé et attaquant. Sacrifiez ce jeton à la fin du combat.', 'type': 'Créature-artefact : mur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617710&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a28ce84c-754d-4811-94ce-558937ab7c00', 'multiverseId': 617710}, 'multiverseid': 617710}, {'name': 'Trabucco di Mordor', 'text': 'Difensore\\nOgniqualvolta attacchi con uno o più Goblin e/o Orchi, crea una pedina creatura artefatto Costrutto 2/1 incolore con volare chiamata Masso Balistico TAPpata e attaccante. Sacrifica quella pedina alla fine del combattimento.', 'type': 'Creatura Artefatto — Muro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617971&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ac0e015b-df0f-4881-9719-5d93fa6b3c07', 'multiverseId': 617971}, 'multiverseid': 617971}, {'name': 'モルドールの投石機', 'text': '防衛\\nあなたがゴブリンやオークのうち１体以上で攻撃するたび、「バリスタの石弾」という名前で飛行を持つ無色の２/１の構築物・アーティファクト・クリーチャー・トークン１体をタップ状態かつ攻撃している状態で生成する。戦闘終了時に、そのトークンを生け贄に捧げる。', 'type': 'アーティファクト・クリーチャー — 壁', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618232&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'aeec30c7-a79a-420c-aa6c-6f23de9807e4', 'multiverseId': 618232}, 'multiverseid': 618232}, {'name': 'Trabuco de Mordor', 'text': 'Defensor\\nToda vez que você atacar com um ou mais Goblins e/ou Orcs, crie uma ficha de criatura artefato Constructo incolor 2/1 com voar virada e atacando com o nome Rocha Balística. Sacrifique aquela ficha no final do combate.', 'type': 'Criatura Artefato — Barreira', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618493&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '24106a13-3089-45bc-97a6-2ee1c03417b7', 'multiverseId': 618493}, 'multiverseid': 618493}, {'name': '魔多抛石机', 'text': '守军\\n每当你以一个或数个鬼怪和／或半兽人攻击时，派出一个2/1无色，名称为抛石弹，具飞行异能的组构体衍生神器生物，其为横置且正进行攻击。在战斗结束时牺牲该衍生物。', 'type': '神器生物 ～墙', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618754&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7b7a3bb2-7986-4478-9ccf-d31697537a9e', 'multiverseId': 618754}, 'multiverseid': 618754}]", '[{\'name\': \'Wächterin des Spiegelsees\', \'text\': \'Wenn die Wächterin des Spiegelsees stirbt, führt der Ring dich in Versuchung.\', \'type\': \'Kreatur — Zwerg, Soldat\', \'flavor\': \'„Auch heute noch die Sterne steh\\\'n\\nim windlos dunklen Spiegelsee;\\nDort ruht die Kron\\\' als schwere Last,\\nbis Durin wacht aus tiefer Rast."\\n—Gimlis Lied\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617270&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ceec2fc-5b20-40e5-8859-e5d3a09f9a3a\', \'multiverseId\': 617270}, \'multiverseid\': 617270}, {\'name\': \'Guardiana del Lago Espejo\', \'text\': \'Cuando la Guardiana del Lago Espejo muera, el Anillo te tienta.\', \'type\': \'Criatura — Soldado enano\', \'flavor\': \'"Las estrellas ahogadas aparecen sin cesar\\nen la oscuridad y el silencio del Lago Espejo,\\ny hasta que Durin vuelva a despertar\\nen el agua profunda la corona emite su reflejo".\\n—Canción de Gimli\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617531&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'98fbfe1e-0642-452f-89e6-6c667201e0a7\', \'multiverseId\': 617531}, \'multiverseid\': 617531}, {\'name\': \'Vigile du Lac du Miroir\', \'text\': "Quand le Vigile du Lac du Miroir meurt, l\'Anneau vous tente.", \'type\': \'Créature : nain et soldat\', \'flavor\': "« Mais toujours les étoiles englouties se font voir\\nDans le sombre et paisible Lac du Miroir ;\\nSa couronne repose au fond des eaux,\\nJusqu\'à ce que Durin s\'éveille à nouveau. »\\n—Chanson de Gimli", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617792&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c45beb4b-2121-4327-bf7d-8b0a669710d3\', \'multiverseId\': 617792}, \'multiverseid\': 617792}, {\'name\': \'Guardiana del Mirolago\', \'text\': "Quando la Guardiana del Mirolago muore, l\'Anello ti tenta.", \'type\': \'Creatura — Soldato Nano\', \'flavor\': \'"Ma ancora appaiono le stelle morenti\\nNel Mirolago oscuro e senza venti;\\nLa sua corona giace in quegli abissi,\\nFinché Durin riaprirà gli occhi fissi."\\n—Canzone di Gimli\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618053&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6b4d88c-44d6-4f00-8a92-5156c1ff42e4\', \'multiverseId\': 618053}, \'multiverseid\': 618053}, {\'name\': \'鏡の湖の守護者\', \'text\': \'鏡の湖の守護者が死亡したとき、指輪があなたを誘惑する。\', \'type\': \'クリーチャー — ドワーフ・兵士\', \'flavor\': \'「沈みし星はなお光る、\\n暗く凪たる鏡の湖。\\n深きに眠る彼の王冠、\\nドゥリンが再び目覚むまで。」\\n——ギムリの歌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618314&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'332108e6-8e2e-4946-88b0-0ae0cd989a22\', \'multiverseId\': 618314}, \'multiverseid\': 618314}, {\'name\': \'Guardiã do Lago-espelho\', \'text\': \'Quando Guardiã do Lago-espelho morre, o Anel tenta você.\', \'type\': \'Criatura — Anão Soldado\', \'flavor\': \'"Ainda as estrelas submersas vêm dentro\\nDo Lago-espelho, escuro e sem vento\\nSua coroa nas águas profundas jaz lá\\nAté Dúrin de novo do sono acordar. "\\n— Canção de Gimli\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618575&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a67c0f67-4c50-4f6f-acae-b62dd4334c26\', \'multiverseId\': 618575}, \'multiverseid\': 618575}, {\'name\': \'镜影湖守护者\', \'text\': \'当镜影湖守护者死去时，魔戒引诱你。\', \'type\': \'生物 ～矮人／士兵\', \'flavor\': \'「沉沦星辰今犹见，\\n静湖镜影幽底现；\\n都林冠冕匿水间，\\n唯待苏醒重赋衔。」\\n～吉姆利之歌\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618836&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8d96ed8-ba6b-4afb-b6ee-660e34ee3f04\', \'multiverseId\': 618836}, \'multiverseid\': 618836}]', '[{\'name\': \'Zorn des Ents\', \'text\': \'Lege eine +1/+1-Marke auf eine Kreatur deiner Wahl, die du kontrollierst, falls ihre Stärke 4 oder mehr ist. Dann erhält die Kreatur +1/+1 bis zum Ende des Zuges und kämpft gegen eine Kreatur deiner Wahl, die du nicht kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich kam und rief die Bäume bei ihren langen Namen, doch sie hörten nicht und blieben stumm — sie lagen tot am Boden."\\n—Flinkbaum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617255&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f79d36e2-8c26-43e0-8f42-808ac6ab0216\', \'multiverseId\': 617255}, \'multiverseid\': 617255}, {\'name\': \'Furia del ent\', \'text\': \'Pon un contador +1/+1 sobre la criatura objetivo que controlas si su fuerza es de 4 o más. Luego, esa criatura obtiene +1/+1 hasta el final del turno y lucha contra la criatura objetivo que no controlas.\', \'type\': \'Conjuro\', \'flavor\': \'"Llegué y llamé a los árboles por sus largos nombres, pero no me oyeron ni respondieron: estaban todos muertos".\\n—Ramaviva\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617516&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f983e27-4c52-4f81-90fc-bac9aeb34196\', \'multiverseId\': 617516}, \'multiverseid\': 617516}, {\'name\': "Fureur d\'Ent", \'text\': "Mettez un marqueur +1/+1 sur une créature ciblée que vous contrôlez si sa force est supérieure ou égale à 4. Puis cette créature gagne +1/+1 jusqu\'à la fin du tour et se bat contre une créature ciblée que vous ne contrôlez pas.", \'type\': \'Rituel\', \'flavor\': "« Je suis venu et j\'ai appelé les arbres par leurs grands noms, mais ils n\'ont ni entendu ni répondu... Ils étaient morts. »\\n—Vifsorbier", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617777&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ccb37a77-c9ac-44ab-8bd9-98e02e2a3242\', \'multiverseId\': 617777}, \'multiverseid\': 617777}, {\'name\': "Furia dell\'Ent", \'text\': \'Metti un segnalino +1/+1 su una creatura bersaglio che controlli se la sua forza è pari o superiore a 4. Poi quella creatura prende +1/+1 fino alla fine del turno e lotta con una creatura bersaglio che non controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'"Arrivai e chiamai gli alberi per nome, ma non potevano sentirmi o rispondermi: giacevano morti."\\n—Sveltolampo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618038&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'db035168-d205-4d2c-9f57-e533b9881ae2\', \'multiverseId\': 618038}, \'multiverseid\': 618038}, {\'name\': \'エントの憤怒\', \'text\': \'あなたがコントロールしているクリーチャー１体と、あなたがコントロールしていないクリーチャー１体を対象とする。その前者のパワーが４以上であるなら、それの上に＋１/＋１カウンター１個を置く。その後、ターン終了時まで、その前者は＋１/＋１の修整を受ける。その前者はその後者と格闘を行う。\', \'type\': \'ソーサリー\', \'flavor\': \'「そこに出向いて、彼らの長い名前で木々を呼んだが返事もなければ聞かれもしなかった。彼らは死んでいたんだ。」\\n――せっかち\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618299&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a69b5cd2-f8d6-4e10-9499-3f59b243a700\', \'multiverseId\': 618299}, \'multiverseid\': 618299}, {\'name\': \'Fúria do Ent\', \'text\': \'Coloque um marcador +1/+1 na criatura alvo que você controla se o poder dela for igual ou superior a 4. Em seguida, aquela criatura recebe +1/+1 até o final do turno e luta contra a criatura alvo que você não controla.\', \'type\': \'Feitiço\', \'flavor\': \'"Eu fui e chamei as árvores por seus nomes longos, mas elas não ouviram, nem responderam — elas jaziam mortas."\\n— Tronquesperto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618560&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7d16f1be-e001-48b9-bf4b-56cad7999948\', \'multiverseId\': 618560}, \'multiverseid\': 618560}, {\'name\': \'恩特怒火\', \'text\': \'如果目标由你操控之生物的力量等于或大于4，则在其上放置一个+1/+1指示物。然后该生物得+1/+1直到回合结束，且与目标不由你操控的生物互斗。\', \'type\': \'法术\', \'flavor\': \'「我去到该处，用长长的名字叫那些树，但无人听闻、没有回应～都倒在地上死了。」\\n～急楸\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618821&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dccca53b-c020-423e-8a01-3d86d7a8b1b2\', \'multiverseId\': 618821}, \'multiverseid\': 618821}]', '[{\'name\': \'Zufällig begegnete Elfen\', \'text\': \'Immer wenn du Hellsicht anwendest, lege eine +1/+1-Marke auf die Zufällig begegneten Elfen. Diese Fähigkeit wird nur einmal pro Zug ausgelöst.\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': \'„Man sagt: ‚Bitte Elben nicht um Rat, denn sie werden gleichzeitig mit Nein und Ja antworten.\\\'"\\n—Frodo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617248&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b2930281-c61f-4226-abab-ced30d24aba0\', \'multiverseId\': 617248}, \'multiverseid\': 617248}, {\'name\': \'Elfos inesperados\', \'text\': \'Siempre que adivines, pon un contador +1/+1 sobre los Elfos inesperados. Esta habilidad solo se dispara una vez por turno.\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': \'"Se dice que no pidas consejo a los elfos, pues te dirán al mismo tiempo que sí y que no".\\n—Frodo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617509&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'101c2464-149d-4327-a8c9-828de169a8a2\', \'multiverseId\': 617509}, \'multiverseid\': 617509}, {\'name\': \'Elfes rencontrés par hasard\', \'text\': "À chaque fois que vous appliquez le regard, mettez un marqueur +1/+1 sur les Elfes rencontrés par hasard. Cette capacité ne se déclenche qu\'une seule fois par tour.", \'type\': \'Créature : elfe et guerrier\', \'flavor\': \'« On dit : "Ne cherche pas conseil auprès des elfes, car ils te diront à la fois oui et non." »\\n—Frodo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617770&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a778df32-8035-4f8a-84b9-e1a5f0bb6a92\', \'multiverseId\': 617770}, \'multiverseid\': 617770}, {\'name\': \'Elfi Fortuiti\', \'text\': \'Ogniqualvolta profetizzi, metti un segnalino +1/+1 sugli Elfi Fortuiti. Questa abilità si innesca solo una volta per turno.\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': \'"Suole dirsi, \\\'Non chiedere consiglio agli Elfi, giacché risponderanno sia sì che no\\\'."\\n—Frodo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618031&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'765ef273-7b81-4876-b01b-c41bbf6dd89a\', \'multiverseId\': 618031}, \'multiverseid\': 618031}, {\'name\': \'偶然出会ったエルフ\', \'text\': \'あなたが占術を行うたび、偶然出会ったエルフの上に＋１/＋１カウンター１個を置く。この能力は、毎ターン１回しか誘発しない。\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': \'「聞くところによると、『相談事はエルフにするな。肯定と否定を同時にするからだ。』だそうだ。」\\n――フロド\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618292&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02c49676-e866-41e5-81c6-d8878ee952ca\', \'multiverseId\': 618292}, \'multiverseid\': 618292}, {\'name\': \'Elfos do Encontro Fortuito\', \'text\': \'Toda vez que você usar vidência, coloque um marcador +1/+1 em Elfos do Encontro Fortuito. Esta habilidade é desencadeada apenas uma vez a cada turno.\', \'type\': \'Criatura — Elfo Guerreiro\', \'flavor\': \'"O que dizem é \\\'Não peça conselho aos Elfos, pois eles dirão tanto não quanto sim.\\\'"\\n— Frodo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618553&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35a7fef6-3c02-4c8a-ad14-ce9723be1250\', \'multiverseId\': 618553}, \'multiverseid\': 618553}, {\'name\': \'相逢精灵\', \'text\': \'每当你占卜时，在相逢精灵上放置一个+1/+1指示物。此异能每回合只会触发一次。\', \'type\': \'生物 ～妖精／战士\', \'flavor\': \'「俗话说，『找谁也别找精灵开会，他们行与不行都说尽。』」\\n～弗罗多\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618814&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b24f7bf1-66df-4bc3-8539-d6e0975021ea\', \'multiverseId\': 618814}, \'multiverseid\': 618814}]', '[{\'name\': \'Zweites Frühstück\', \'text\': \'Bis zu zwei Kreaturen deiner Wahl erhalten +2/+1 bis zum Ende des Zuges. Erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Hobbits des Auenlands waren an sechs Mahlzeiten pro Tag gewohnt — wenn möglich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617120&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'85ce501d-4de5-4274-a41d-3a8f2e2ef3c2\', \'multiverseId\': 617120}, \'multiverseid\': 617120}, {\'name\': \'Segundo desayuno\', \'text\': \'Hasta dos criaturas objetivo obtienen +2/+1 cada una hasta el final del turno. Crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Instantáneo\', \'flavor\': \'A los hobbits de la Comarca les gustaba comer seis veces al día (si podían).\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617381&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e9a2fae-a041-48f5-801f-7a942b7a1f2a\', \'multiverseId\': 617381}, \'multiverseid\': 617381}, {\'name\': \'Deuxième petit-déjeuner\', \'text\': "Jusqu\'à deux créatures ciblées gagnent chacune +2/+1 jusqu\'à la fin du tour. Créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Éphémère\', \'flavor\': \'Les hobbits de la Comté appréciaient six repas par jour... quand ils pouvaient les avoir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617642&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ca5ab9f-090f-4b91-a45e-51d907b1277d\', \'multiverseId\': 617642}, \'multiverseid\': 617642}, {\'name\': \'Seconda Colazione\', \'text\': \'Fino a due creature bersaglio prendono +2/+1 fino alla fine del turno. Crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Istantaneo\', \'flavor\': \'Gli Hobbit della Contea erano soliti consumare sei pasti al giorno... quando possibile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617903&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b40f67f4-0a25-4ce1-bf0b-1461de474bf5\', \'multiverseId\': 617903}, \'multiverseid\': 617903}, {\'name\': \'二度目の朝食\', \'text\': \'クリーチャー最大２体を対象とする。ターン終了時まで、それらはそれぞれ＋２/＋１の修整を受ける。食物・トークン１つを生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'インスタント\', \'flavor\': \'ホビット庄の民達は、暇があれば日に六度も食事を取ったそうだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618164&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3712c88a-4471-46c9-bf2d-384ce67a0ba7\', \'multiverseId\': 618164}, \'multiverseid\': 618164}, {\'name\': \'Segundo Café da Manhã\', \'text\': \'Até duas criaturas alvo recebem +2/+1 cada uma até o final do turno. Crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida".)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os Hobbits do Condado gostavam de fazer seis refeições por dia, quando podiam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618425&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48a45b5e-38e9-4a48-bf56-c6bee8175c74\', \'multiverseId\': 618425}, \'multiverseid\': 618425}, {\'name\': \'二次早餐\', \'text\': \'至多两个目标生物各得+2/+1直到回合结束。派出一个食品衍生物。（它是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'瞬间\', \'flavor\': \'夏尔的霍比特人喜欢一天吃六餐～当他们吃得到的时候。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618686&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'62f9f338-b48a-47a6-b0ef-8a9ec0c5d936\', \'multiverseId\': 618686}, \'multiverseid\': 618686}]', '[{\'name\': \'Éomer von der Riddermark\', \'text\': \'Eile\\nImmer wenn Éomer von der Riddermark angreift und falls du eine Kreatur mit der höchsten Stärke unter den Kreaturen im Spiel kontrollierst, erzeuge einen 1/1 weißen Mensch-Soldat-Kreaturenspielstein.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': \'Doch Éomer führte die große Schar der Rohirrim, die er erneut versammelt und um sich geschart hatte, unter seinem weißen Wappen gen Norden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617212&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8d05dc8d-42a6-416d-994f-ea6d5a2e54c9\', \'multiverseId\': 617212}, \'multiverseid\': 617212}, {\'name\': \'Éomer de la Marca de los Jinetes\', \'text\': \'Prisa.\\nSiempre que Éomer de la Marca de los Jinetes ataque, si controlas una criatura con la mayor fuerza entre las criaturas en el campo de batalla, crea una ficha de criatura Soldado Humano blanca 1/1.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': \'Pero, en el norte, otra vez reunida y capitaneada por Éomer, tras el penacho blanco de su cimera, marchaba la gran vanguardia de los rohirrim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'87417218-8094-4fe5-a840-bf854a19d8ba\', \'multiverseId\': 617473}, \'multiverseid\': 617473}, {\'name\': \'Éomer du Riddermark\', \'text\': "Célérité\\nÀ chaque fois qu\'Éomer du Riddermark attaque, si vous contrôlez une créature avec la force la plus élevée parmi les créatures sur le champ de bataille, créez un jeton de créature 1/1 blanche Humain et Soldat.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': "Mais au nord, la crête blanche d\'Éomer menait la grande première ligne des Rohirrim qu\'il avait à nouveau rassemblés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617734&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6379ece1-1643-431a-947d-311886f93bfa\', \'multiverseId\': 617734}, \'multiverseid\': 617734}, {\'name\': \'Éomer del Riddermark\', \'text\': \'Rapidità\\nOgniqualvolta Éomer del Riddermark attacca, se controlli una creatura con la forza maggiore tra le creature sul campo di battaglia, crea una pedina creatura Soldato Umano 1/1 bianca.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': \'Verso nord il bianco vessillo di Éomer guidava il fronte dei Rohirrim, che aveva nuovamente radunato e condotto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617995&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2489c3dd-961b-4aad-bb0c-334c0e644790\', \'multiverseId\': 617995}, \'multiverseid\': 617995}, {\'name\': \'騎士国のエオメル\', \'text\': \'速攻\\n騎士国のエオメルが攻撃するたび、あなたが戦場にあるクリーチャーの中で最大のパワーを持つクリーチャーをコントロールしている場合、白の１/１の人間・兵士・クリーチャー・トークン１体を生成する。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': \'しかし北では、彼が再び結集したエオメルの白紋章がロヒアリムでの前線に赴いていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618256&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c7c5dc36-5f63-44ca-af7a-252bdb04b8a7\', \'multiverseId\': 618256}, \'multiverseid\': 618256}, {\'name\': \'Éomer da Marca dos Cavaleiros\', \'text\': \'Ímpeto\\nToda vez que Éomer da Marca dos Cavaleiros atacar, se você controlar uma criatura com o maior poder entre as criaturas no campo de batalha, crie uma ficha de criatura Humano Soldado branca 1/1.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': \'Mas ao norte o brasão branco de Éomer liderava a grande hoste dos Rohirrim, que ele voltara a reagrupar e organizar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618517&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7a94d4d4-97e6-4b1f-a1fe-f8a993e20aa7\', \'multiverseId\': 618517}, \'multiverseid\': 618517}, {\'name\': \'里德马克的伊奥梅尔\', \'text\': \'敏捷\\n每当里德马克的伊奥梅尔攻击时，若你操控力量为战场上生物中最大值的生物，则派出一个1/1白色人类／士兵衍生生物。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': \'但在北边，伊梅奥尔重新集结起了洛希尔人，他们在国王白色马尾盔冠的率领下形成一道强壮锋线。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618778&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1f6c1751-ba32-455f-9dc8-e746799f155f\', \'multiverseId\': 618778}, \'multiverseid\': 618778}]', '[{\'name\': \'Éomer, Marschall von Rohan\', \'text\': \'Eile\\nImmer wenn eine oder mehrere andere angreifende legendäre Kreaturen, die du kontrollierst, sterben, enttappe alle Kreaturen, die du kontrollierst. Nach dieser Phase gibt es eine zusätzliche Kampfphase. Diese Fähigkeit wird nur einmal pro Zug ausgelöst.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': \'„Die Not duldet keinen Aufschub und doch ist spät besser als nie."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617211&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94ea4247-8d03-4477-8f88-8a0fcf1c60e2\', \'multiverseId\': 617211}, \'multiverseid\': 617211}, {\'name\': \'Éomer, mariscal de Rohan\', \'text\': \'Prisa.\\nSiempre que una o más otras criaturas legendarias atacantes que controlas mueran, endereza todas las criaturas que controlas. Después de esta fase, hay una fase de combate adicional. Esta habilidad solo se dispara una vez por turno.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': \'"La necesidad no admite demora, pero más vale tarde que nunca".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617472&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3db13acc-56fb-4cba-820b-dbb7b26f88c5\', \'multiverseId\': 617472}, \'multiverseid\': 617472}, {\'name\': \'Éomer, maréchal du Rohan\', \'text\': "Célérité\\nÀ chaque fois qu\'au moins une autre créature légendaire attaquante que vous contrôlez meurt, dégagez toutes les créatures que vous contrôlez. Cette phase est suivie d\'une phase de combat supplémentaire. Cette capacité ne se déclenche qu\'une seule fois par tour.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': \'« Le besoin ne tolère aucun délai, pourtant mieux vaut tard que jamais. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617733&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b4854fd0-94fa-4711-850b-58299f6abda9\', \'multiverseId\': 617733}, \'multiverseid\': 617733}, {\'name\': \'Éomer, Maresciallo di Rohan\', \'text\': "Rapidità\\nOgniqualvolta una o più altre creature leggendarie attaccanti che controlli muoiono, STAPpa tutte le creature che controlli. Dopo questa fase, c\'è una fase di combattimento addizionale. Questa abilità si innesca solo una volta per turno.", \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': \'"Il bisogno non ammette indugi, eppure tardi è meglio che mai."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617994&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4935d912-b8c5-4811-9dca-befea4267ab9\', \'multiverseId\': 617994}, \'multiverseid\': 617994}, {\'name\': \'ローハンの軍団長、エオメル\', \'text\': \'速攻\\nあなたがコントロールしていてこれでなく攻撃している１体以上の伝説のクリーチャーが死亡するたび、あなたがコントロールしているすべてのクリーチャーをアンタップする。このフェイズの後に、追加の戦闘フェイズ１つを加える。この能力は、毎ターン１回しか誘発しない。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': \'「一刻の猶予もない。しかし、遅れてもこないよりはましだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618255&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5712bbd-0e85-4a7c-865e-8082f3fb4a8e\', \'multiverseId\': 618255}, \'multiverseid\': 618255}, {\'name\': \'Éomer, Marechal de Rohan\', \'text\': \'Ímpeto\\nToda vez que uma ou mais outras criaturas atacantes lendárias que você controla morrerem, desvire todas as criaturas que você controla. Depois dessa fase, há uma fase de combate adicional. Esta habilidade é desencadeada apenas uma vez a cada turno.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': \'"A necessidade não admite atrasos, porém tarde é melhor que nunca."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618516&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f3e863ff-bbc4-4f4b-b5b7-504d0a4f20e5\', \'multiverseId\': 618516}, \'multiverseid\': 618516}, {\'name\': \'洛汗元帅伊奥梅尔\', \'text\': \'敏捷\\n每当一个或数个由你操控且正进行攻击的其他传奇生物死去时，重置所有由你操控的生物。在此阶段后，额外多出一个战斗阶段。此异能每回合只会触发一次。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': \'「需求虽刻不容缓，迟到仍胜过不到。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618777&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'659bd207-3204-4d58-a0a3-fe6f406d4572\', \'multiverseId\': 618777}, \'multiverseid\': 618777}]', '[{\'name\': \'Éomer, Marschall von Rohan\', \'text\': \'Eile\\nImmer wenn eine oder mehrere andere angreifende legendäre Kreaturen, die du kontrollierst, sterben, enttappe alle Kreaturen, die du kontrollierst. Nach dieser Phase gibt es eine zusätzliche Kampfphase. Diese Fähigkeit wird nur einmal pro Zug ausgelöst.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619758&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c25ed677-4015-47ad-80f2-4c31cd7b9baf\', \'multiverseId\': 619758}, \'multiverseid\': 619758}, {\'name\': \'Éomer, mariscal de Rohan\', \'text\': \'Prisa.\\nSiempre que una o más otras criaturas legendarias atacantes que controlas mueran, endereza todas las criaturas que controlas. Después de esta fase, hay una fase de combate adicional. Esta habilidad solo se dispara una vez por turno.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619801&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e355a37b-8064-4652-abf1-a2ccd06c8ee1\', \'multiverseId\': 619801}, \'multiverseid\': 619801}, {\'name\': \'Éomer, maréchal du Rohan\', \'text\': "Célérité\\nÀ chaque fois qu\'au moins une autre créature légendaire attaquante que vous contrôlez meurt, dégagez toutes les créatures que vous contrôlez. Cette phase est suivie d\'une phase de combat supplémentaire. Cette capacité ne se déclenche qu\'une seule fois par tour.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619844&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af0db777-c697-4614-83d3-f61be7c570f3\', \'multiverseId\': 619844}, \'multiverseid\': 619844}, {\'name\': \'Éomer, Maresciallo di Rohan\', \'text\': "Rapidità\\nOgniqualvolta una o più altre creature leggendarie attaccanti che controlli muoiono, STAPpa tutte le creature che controlli. Dopo questa fase, c\'è una fase di combattimento addizionale. Questa abilità si innesca solo una volta per turno.", \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a3ae3ec-1d0a-493c-84ae-47c844c3ec3c\', \'multiverseId\': 619887}, \'multiverseid\': 619887}, {\'name\': \'ローハンの軍団長、エオメル\', \'text\': \'速攻\\nあなたがコントロールしていてこれでなく攻撃している１体以上の伝説のクリーチャーが死亡するたび、あなたがコントロールしているすべてのクリーチャーをアンタップする。このフェイズの後に、追加の戦闘フェイズ１つを加える。この能力は、毎ターン１回しか誘発しない。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619930&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7efab4c-9dab-4863-a1cc-d401115689b8\', \'multiverseId\': 619930}, \'multiverseid\': 619930}, {\'name\': \'Éomer, Marechal de Rohan\', \'text\': \'Ímpeto\\nToda vez que uma ou mais outras criaturas atacantes lendárias que você controla morrerem, desvire todas as criaturas que você controla. Depois dessa fase, há uma fase de combate adicional. Esta habilidade é desencadeada apenas uma vez a cada turno.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619973&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af289d5a-5001-42f4-bda9-d1feb575b0e9\', \'multiverseId\': 619973}, \'multiverseid\': 619973}, {\'name\': \'洛汗元帅伊奥梅尔\', \'text\': \'敏捷\\n每当一个或数个由你操控且正进行攻击的其他传奇生物死去时，重置所有由你操控的生物。在此阶段后，额外多出一个战斗阶段。此异能每回合只会触发一次。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620016&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'92d83580-1959-4257-ab64-cb6a06e82ddd\', \'multiverseId\': 620016}, \'multiverseid\': 620016}]', '[{\'name\': \'Éowyn, Herrin von Rohan\', \'text\': \'Zu Beginn des Kampfes in deinem Zug erhält eine Kreatur deiner Wahl bis zum Ende des Zuges entweder Erstschlag oder Wachsamkeit (du entscheidest). Falls jene Kreatur ausgerüstet ist, erhält sie stattdessen bis zum Ende des Zuges Erstschlag und Wachsamkeit.\\nAusrüsten-Fähigkeiten, die du aktivierst, kosten beim Aktivieren {1} weniger.\', \'type\': \'Legendäre Kreatur — Mensch, Adliger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617101&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3fc53908-06f5-4475-bcfb-783fa75e744e\', \'multiverseId\': 617101}, \'multiverseid\': 617101}, {\'name\': \'Éowyn, dama de Rohan\', \'text\': \'Al comienzo del combate en tu turno, la criatura objetivo gana a tu elección la habilidad de dañar primero o vigilancia hasta el final del turno. Si esa criatura está equipada, en vez de eso, gana las habilidades de dañar primero y vigilancia hasta el final del turno.\\nTe cuesta {1} menos activar las habilidades de equipar.\', \'type\': \'Criatura legendaria — Noble humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617362&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'37a523b0-dc46-4adf-b43e-0d66c84b3b64\', \'multiverseId\': 617362}, \'multiverseid\': 617362}, {\'name\': \'Éowyn, Dame de Rohan\', \'text\': "Au début du combat pendant votre tour, une créature ciblée acquiert, selon votre choix, l\'initiative ou la vigilance jusqu\'à la fin du tour. Si cette créature est équipée, elle acquiert l\'initiative et la vigilance jusqu\'à la fin du tour à la place.\\nLes capacités d\'équipement que vous activez coûtent {1} de moins à activer.", \'type\': \'Créature légendaire : humain et noble\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617623&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c56fadf7-c0e8-4c73-b24a-13174a765171\', \'multiverseId\': 617623}, \'multiverseid\': 617623}, {\'name\': \'Éowyn, Signora di Rohan\', \'text\': "All\'inizio del combattimento nel tuo turno, una creatura bersaglio ha a tua scelta attacco improvviso o cautela fino alla fine del turno. Se quella creatura è equipaggiata, ha invece attacco improvviso e cautela fino alla fine del turno.\\nLe abilità equipaggiare che attivi costano {1} in meno per essere attivate.", \'type\': \'Creatura Leggendaria — Nobile Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e457fb5-2edc-4b35-96be-032ed0a5400f\', \'multiverseId\': 617884}, \'multiverseid\': 617884}, {\'name\': \'ローハンの姫君、エオウィン\', \'text\': \'あなたのターンの戦闘の開始時に、クリーチャー１体を対象とする。ターン終了時まで、それは先制攻撃や警戒のうちあなたが選んだ能力１つを得る。そのクリーチャーに装備品がついているなら、代わりに、ターン終了時まで、それは先制攻撃と警戒を得る。\\nあなたが装備能力を起動するためのコストは{1}少なくなる。\', \'type\': \'伝説のクリーチャー — 人間・貴族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618145&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc517336-ce08-4d8c-ae02-56dd35c1423e\', \'multiverseId\': 618145}, \'multiverseid\': 618145}, {\'name\': \'Éowyn, Senhora de Rohan\', \'text\': \'No início do combate no seu turno, a criatura alvo ganha iniciativa ou vigilância, à sua escolha, até o final do turno. Se aquela criatura estiver equipada, em vez disso, ela ganha iniciativa e vigilância até o final do turno.\\nAs habilidades equipar que você ativa custam {1} a menos para serem ativadas.\', \'type\': \'Criatura Lendária — Humano Nobre\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618406&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d7fa4e83-7859-4a94-a0f8-7957b6ed50da\', \'multiverseId\': 618406}, \'multiverseid\': 618406}, {\'name\': \'洛汗公主伊奥温\', \'text\': \'在你回合的战斗开始时，目标生物依你的选择获得先攻异能或警戒异能直到回合结束。若该生物佩带武具，则改为它获得先攻与警戒直到回合结束。\\n你起动的佩带异能减少{1}来起动。\', \'type\': \'传奇生物 ～人类／贵族\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618667&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e05a4c1-a78e-44b3-b2b1-db0f64787786\', \'multiverseId\': 618667}, \'multiverseid\': 618667}]', '[{\'name\': \'Éowyn, furchtlose Ritterin\', \'text\': \'Eile\\nWenn Éowyn, furchtlose Ritterin, ins Spiel kommt, schicke eine Kreatur deiner Wahl mit größerer Stärke, die ein Gegner kontrolliert, ins Exil. Legendäre Kreaturen, die du kontrollierst, erhalten bis zum Ende des Zuges Schutz vor jeder Farbe jener Kreatur.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': \'„Stamme ich nicht vom Hause Eorls ab? Lange genug habe ich gepflegt und bedient."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617292&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c3b386c-2657-4a1f-bf37-fb88ed98989e\', \'multiverseId\': 617292}, \'multiverseid\': 617292}, {\'name\': \'Éowyn, caballero valiente\', \'text\': \'Prisa.\\nCuando Éowyn, caballero valiente entre al campo de batalla, exilia la criatura objetivo que controla un oponente con mayor fuerza. Las criaturas legendarias que controlas ganan protección contra todos los colores de esa criatura hasta el final del turno.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': \'"¿Acaso no soy de la Casa de Eorl? Ya bastante esperé con las rodillas flojas".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617553&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e027f638-d32a-4b33-8054-f5ca66878f63\', \'multiverseId\': 617553}, \'multiverseid\': 617553}, {\'name\': \'Éowyn, chevalière intrépide\', \'text\': "Célérité\\nQuand Éowyn, chevalière intrépide arrive sur le champ de bataille, exilez une créature ciblée de force supérieure qu\'un adversaire contrôle. Les créatures légendaires que vous contrôlez acquièrent la protection contre chacune des couleurs de cette créature jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': "« Ne fais-je pas partie de la Maison d\'Eorl ? J\'ai attendu assez longtemps. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617814&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6ef08f99-8627-48f0-8c35-fb9483c398f5\', \'multiverseId\': 617814}, \'multiverseid\': 617814}, {\'name\': \'Éowyn, Cavaliera Indomita\', \'text\': \'Rapidità\\nQuando Éowyn, Cavaliera Indomita entra nel campo di battaglia, esilia una creatura bersaglio controllata da un avversario con forza superiore. Le creature leggendarie che controlli hanno protezione da ogni colore di quella creatura fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': \'"Non sono io forse della Casa di Eorl? Ho atteso con passo incerto troppo a lungo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618075&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e03ce9e6-a119-40bc-99bd-feb5a76455e3\', \'multiverseId\': 618075}, \'multiverseid\': 618075}, {\'name\': \'恐れを知らぬ騎士、エオウィン\', \'text\': \'速攻\\n恐れを知らぬ騎士、エオウィンが戦場に出たとき、対戦相手がコントロールしていてこれより大きなパワーを持つクリーチャー１体を対象とする。それを追放する。ターン終了時まで、あなたがコントロールしているすべての伝説のクリーチャーはプロテクション（その対象としたクリーチャーの各色）を得る。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': \'「私はエオルの一族ではなかったの？二の足を踏むのはもうたくさん。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618336&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d69158a0-9664-41d1-9c07-388ef3a61c50\', \'multiverseId\': 618336}, \'multiverseid\': 618336}, {\'name\': \'Éowyn, Cavaleira Destemida\', \'text\': \'Ímpeto\\nQuando Éowyn, Cavaleira Destemida, entrar no campo de batalha, exile a criatura alvo entre as que um oponente controla com maior poder. As criaturas lendárias que você controla ganham proteção contra cada uma das cores daquela criatura até o final do turno.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': \'"Eu não sou da Casa de Eorl? Já servi a pés vacilantes por tempo suficiente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618597&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1a03b6ca-dc7f-47c8-8921-3ee8bf66fa5f\', \'multiverseId\': 618597}, \'multiverseid\': 618597}, {\'name\': \'无畏骑士伊奥温\', \'text\': \'敏捷\\n当无畏骑士伊奥温进战场时，放逐目标由对手操控且力量比它大的生物。每个由你操控的传奇生物均获得反所放逐生物之各色的保护异能直到回合结束。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': \'「难道我不是埃奥尔家族的一员吗？我已经迟疑着等得足够久了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618858&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c478a503-f301-4d4b-aec8-6903865efbf4\', \'multiverseId\': 618858}, \'multiverseid\': 618858}]', '[{\'name\': \'Éowyn, furchtlose Ritterin\', \'text\': \'Eile\\nWenn Éowyn, furchtlose Ritterin, ins Spiel kommt, schicke eine Kreatur deiner Wahl mit größerer Stärke, die ein Gegner kontrolliert, ins Exil. Legendäre Kreaturen, die du kontrollierst, erhalten bis zum Ende des Zuges Schutz vor jeder Farbe jener Kreatur.\', \'type\': \'Legendäre Kreatur — Mensch, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619760&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3c634ff0-5a5b-4026-907a-3f835918e122\', \'multiverseId\': 619760}, \'multiverseid\': 619760}, {\'name\': \'Éowyn, caballero valiente\', \'text\': \'Prisa.\\nCuando Éowyn, caballero valiente entre al campo de batalla, exilia la criatura objetivo que controla un oponente con mayor fuerza. Las criaturas legendarias que controlas ganan protección contra todos los colores de esa criatura hasta el final del turno.\', \'type\': \'Criatura legendaria — Caballero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619803&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3bd4eecf-5c0c-49b6-aa25-c49df1c4459f\', \'multiverseId\': 619803}, \'multiverseid\': 619803}, {\'name\': \'Éowyn, chevalière intrépide\', \'text\': "Célérité\\nQuand Éowyn, chevalière intrépide arrive sur le champ de bataille, exilez une créature ciblée de force supérieure qu\'un adversaire contrôle. Les créatures légendaires que vous contrôlez acquièrent la protection contre chacune des couleurs de cette créature jusqu\'à la fin du tour.", \'type\': \'Créature légendaire : humain et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1d185b01-1309-4ff9-bf46-c053d0f57c25\', \'multiverseId\': 619846}, \'multiverseid\': 619846}, {\'name\': \'Éowyn, Cavaliera Indomita\', \'text\': \'Rapidità\\nQuando Éowyn, Cavaliera Indomita entra nel campo di battaglia, esilia una creatura bersaglio controllata da un avversario con forza superiore. Le creature leggendarie che controlli hanno protezione da ogni colore di quella creatura fino alla fine del turno.\', \'type\': \'Creatura Leggendaria — Cavaliere Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619889&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a47dad73-27c9-40aa-8a29-e6b33bb30072\', \'multiverseId\': 619889}, \'multiverseid\': 619889}, {\'name\': \'恐れを知らぬ騎士、エオウィン\', \'text\': \'速攻\\n恐れを知らぬ騎士、エオウィンが戦場に出たとき、対戦相手がコントロールしていてこれより大きなパワーを持つクリーチャー１体を対象とする。それを追放する。ターン終了時まで、あなたがコントロールしているすべての伝説のクリーチャーはプロテクション（その対象としたクリーチャーの各色）を得る。\', \'type\': \'伝説のクリーチャー — 人間・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619932&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b2f214f-8c53-49f1-af4e-81fe8e1b2666\', \'multiverseId\': 619932}, \'multiverseid\': 619932}, {\'name\': \'Éowyn, Cavaleira Destemida\', \'text\': \'Ímpeto\\nQuando Éowyn, Cavaleira Destemida, entrar no campo de batalha, exile a criatura alvo entre as que um oponente controla com maior poder. As criaturas lendárias que você controla ganham proteção contra cada uma das cores daquela criatura até o final do turno.\', \'type\': \'Criatura Lendária — Humano Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=619975&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9f522b6b-bab9-4e1a-82c2-f0a369323ad9\', \'multiverseId\': 619975}, \'multiverseid\': 619975}, {\'name\': \'无畏骑士伊奥温\', \'text\': \'敏捷\\n当无畏骑士伊奥温进战场时，放逐目标由对手操控且力量比它大的生物。每个由你操控的传奇生物均获得反所放逐生物之各色的保护异能直到回合结束。\', \'type\': \'传奇生物 ～人类／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=620018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bf3c9cfd-d955-4d22-ad9e-00ca7e2df435\', \'multiverseId\': 620018}, \'multiverseid\': 620018}]', '[{\'name\': \'Überlebende aus Pelargir\', \'text\': \'{T}: Erzeuge ein Mana einer beliebigen Farbe. Gib dieses Mana nur aus, um einen Spontanzauber oder eine Hexerei zu wirken.\\n{5}{U}, {T}: Ein Spieler deiner Wahl millt drei Karten. (Er legt die obersten drei Karten seiner Bibliothek auf seinen Friedhof.)\', \'type\': \'Kreatur — Mensch, Gesinde\', \'flavor\': \'„Ein Überfall der Korsaren! Zurück! Zurück in die Stadt, bevor sie uns allesamt abschlachten!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617155&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc67c81b-8dfb-4a91-afce-e6f34cc8b87f\', \'multiverseId\': 617155}, \'multiverseid\': 617155}, {\'name\': \'Superviviente de Pelargir\', \'text\': \'{T}: Agrega un maná de cualquier color. Usa este maná solo para lanzar un hechizo de instantáneo o de conjuro.\\n{5}{U}, {T}: El jugador objetivo muele tres cartas. (Pone las tres primeras cartas de su biblioteca en su cementerio.)\', \'type\': \'Criatura — Plebeyo humano\', \'flavor\': \'"¡Los corsarios están aquí! ¡Retornen a los muros! ¡Vuelvan a la ciudad antes de que arrasen con nosotros!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617416&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'041ca5d0-21a2-46f0-b06e-9f9f1ed4f505\', \'multiverseId\': 617416}, \'multiverseid\': 617416}, {\'name\': \'Survivante de Pelargir\', \'text\': "{T} : Ajoutez un mana de la couleur de votre choix. Ne dépensez ce mana que pour lancer un sort d\'éphémère ou de rituel.\\n{5}{U}, {T} : Un joueur ciblé meule trois cartes. (Il met les trois cartes du dessus de sa bibliothèque dans son cimetière.)", \'type\': \'Créature : humain et paysan\', \'flavor\': "« Les pirates sont à nos portes ! Repliez-vous dans l\'enceinte ! Retournez à la cité avant qu\'ils ne nous anéantissent ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617677&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78e0c560-f2f0-4f6a-a1ee-1057a9f1ed2e\', \'multiverseId\': 617677}, \'multiverseid\': 617677}, {\'name\': \'Sopravvissuta di Pelargir\', \'text\': \'{T}: Aggiungi un mana di un qualsiasi colore. Spendi questo mana solo per lanciare una magia istantaneo o stregoneria.\\n{5}{U}, {T}: Un giocatore bersaglio macina tre carte. (Mette nel suo cimitero le prime tre carte del suo grimorio.)\', \'type\': \'Creatura — Popolano Umano\', \'flavor\': \'"I Corsari sono vicini! Ritiratevi alle mura! Tornate in Città prima di essere sopraffatti!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=617938&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4071c904-eb85-47d2-876f-ddc312647c40\', \'multiverseId\': 617938}, \'multiverseid\': 617938}, {\'name\': \'ペラルギルの生き残り\', \'text\': \'{T}：好きな色１色のマナ１点を加える。このマナは、インスタントやソーサリーである呪文を唱えるためにしか支払えない。\\n{5}{U}, {T}：プレイヤー１人を対象とする。そのプレイヤーはカード３枚を切削する。（そのプレイヤーは自分のライブラリーの一番上にあるカード３枚を自分の墓地に置く。）\', \'type\': \'クリーチャー — 人間・農民\', \'flavor\': \'「海賊が来たぞ！壁まで引くのだ！奴らに押し潰される前に、街へ戻れ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618199&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9604fd1f-4be4-4881-b8cc-e1ea8ae34e34\', \'multiverseId\': 618199}, \'multiverseid\': 618199}, {\'name\': \'Sobrevivente de Pelargir\', \'text\': \'{T}: Adicione um mana de qualquer cor. Gaste este mana apenas para conjurar uma mágica instantânea ou um feitiço.\\n{5}{U}, {T}: O jogador alvo tritura três cards. (Ele coloca os três cards do topo do próprio grimório no próprio cemitério.)\', \'type\': \'Criatura — Humano Plebeu\', \'flavor\': \'"Os Corsários chegaram! De volta para as muralhas! Para a cidade antes que tudo se perca!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618460&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f77887ee-7a53-4163-ad43-da88d14d4289\', \'multiverseId\': 618460}, \'multiverseid\': 618460}, {\'name\': \'佩拉基尔幸存者\', \'text\': \'{T}：加一点任意颜色的法术力。此法术力只能用来施放瞬间或法术咒语。\\n{5}{U}，{T}：目标牌手磨三张牌。（他将其牌库顶的三张牌置入其坟墓场。）\', \'type\': \'生物 ～人类／平民\', \'flavor\': \'「海盗来了！回到墙里来！在全军覆灭前回到石城里来！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=618721&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'30d796c1-193f-4f3e-8d4d-2780581d7e72\', \'multiverseId\': 618721}, \'multiverseid\': 618721}]']
printings: ['10E', '2ED', '2XM', '30A', '3ED', '40K', '4BB', '4ED', '5ED', '6ED', '7ED', '8ED', '9ED', 'AFR', 'AKH', 'AKR', 'ALA', 'ANA', 'ANB', 'ARC', 'ARN', 'ATH', 'AVR', 'BBD', 'BFZ', 'BLB', 'BRB', 'BRC', 'BRO', 'BTD', 'C13', 'C14', 'C15', 'C16', 'C17', 'C18', 'C19', 'CED', 'CEI', 'CHK', 'CLB', 'CLU', 'CM2', 'CMA', 'CMD', 'CMM', 'CMR', 'CST', 'DD1', 'DD2', 'DDC', 'DDD', 'DDE', 'DDF', 'DDG', 'DDH', 'DDI', 'DDJ', 'DDK', 'DDL', 'DDM', 'DDN', 'DDO', 'DDP', 'DDQ', 'DDR', 'DDS', 'DDT', 'DDU', 'DKM', 'DMR', 'DMU', 'DOM', 'DPA', 'DTK', 'DVD', 'E01', 'ELD', 'EVG', 'FBB', 'FRF', 'G17', 'GK1', 'GK2', 'GN2', 'GN3', 'GNT', 'GRN', 'GS1', 'GVL', 'H09', 'HBG', 'HOP', 'HOU', 'ICE', 'IKO', 'INV', 'ISD', 'ITP', 'J14', 'J22', 'JMP', 'JVC', 'KHM', 'KLD', 'KLR', 'KTK', 'LCI', 'LEA', 'LEB', 'LRW', 'LTR', 'M10', 'M11', 'M12', 'M13', 'M14', 'M15', 'M19', 'M20', 'M21', 'MBS', 'MD1', 'ME1', 'ME3', 'MH2', 'MH3', 'MID', 'MIR', 'MKM', 'MMQ', 'MOM', 'MRD', 'NEO', 'NPH', 'ODY', 'OLEP', 'ONC', 'ONE', 'ONS', 'ORI', 'OTC', 'OTJ', 'P02', 'P23', 'PAL00', 'PAL01', 'PAL02', 'PAL03', 'PAL04', 'PAL05', 'PAL06', 'PAL99', 'PALP', 'PANA', 'PARL', 'PC2', 'PCA', 'PD2', 'PD3', 'PDGM', 'PELP', 'PF19', 'PF20', 'PF23', 'PGPX', 'PGRU', 'PHUK', 'PIP', 'PL24', 'PLST', 'PLTR', 'PMPS', 'PMPS06', 'PMPS07', 'PMPS08', 'PMPS09', 'PMPS10', 'PMPS11', 'POR', 'PPP1', 'PRM', 'PRW2', 'PRWK', 'PS11', 'PSAL', 'PSS2', 'PSS3', 'PSS4', 'PTC', 'PTK', 'PZ2', 'RAV', 'REX', 'RIX', 'RNA', 'ROE', 'RQS', 'RTR', 'S99', 'SCD', 'SHM', 'SIR', 'SLD', 'SNC', 'SOI', 'SOM', 'STX', 'SUM', 'TD0', 'TD2', 'THB', 'THS', 'TMP', 'TPR', 'TSP', 'UGL', 'UND', 'UNF', 'UNH', 'USG', 'UST', 'VOW', 'WAR', 'WC00', 'WC01', 'WC02', 'WC03', 'WC04', 'WC97', 'WC98', 'WC99', 'WHO', 'WOE', 'XANA', 'XLN', 'ZEN', 'ZNR']
original_text: ["(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — Amass Orcs 1. (Put a +1/+1 counter on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)\\nII — Amass Orcs 2.\\nIII — Creatures you control get +1/+0 and gain menace until end of turn.", '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — Gain control of up to one target artifact for as long as you control Scroll of Isildur. The Ring tempts you.\\nII — Tap up to two target creatures. Put a stun counter on each of them.\\nIII — Draw a card for each tapped creature target opponent controls.', '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — Scry 2.\\nII — Put two +1/+1 counters on target creature you control.\\nIII — Until end of turn, target creature you control gains "When this creature dies, draw two cards." Then that creature fights up to one other target creature.', '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — Target creature you control gains indestructible for as long as you control Tale of Tinúviel.\\nII — Return target creature card from your graveyard to the battlefield.\\nIII — Up to two target creatures you control each gain lifelink until end of turn.', "(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — The Ring tempts you, then each player mills cards equal to your Ring-bearer's power.\\nII — Destroy all nonlegendary creatures.\\nIII — Each opponent loses 1 life for each creature card in that player's graveyard.", '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — Up to one target creature can\'t block for as long as you control There and Back Again. The Ring tempts you.\\nII — Search your library for a Mountain card, put it onto the battlefield, then shuffle.\\nIII — Create Smaug, a legendary 6/6 red Dragon creature token with flying, haste, and "When this creature dies, create fourteen Treasure tokens."', '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI — You and target opponent each create a Food token.\\nII — Each opponent loses 3 life. Create a Treasure token.\\nIII — Create three tapped 1/1 white Spirit creature tokens with flying.', '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI, II — Draw two cards, then discard a card.\\nIII — Shuffle any number of target cards from your graveyard into your library. Add {U}{U}.', '(As this Saga enters and after your draw step, add a lore counter. Sacrifice after III.)\\nI, II — Search your library for a legendary creature card, reveal it, put it into your hand, then shuffle.\\nIII — Creatures you control gain double strike until end of turn. The Ring tempts you.', "(As this Saga enters and after your draw step, add a lore counter. Sacrifice after VI.)\\nI, II, III, IV, V, VI — Note a creature type that hasn't been noted for Long List of the Ents. When you cast your next creature spell of that type this turn, that creature enters the battlefield with an additional +1/+1 counter on it.", '(You may cast a legendary instant only if you control a legendary creature or planeswalker.)\\nDestroy target creature. If its controller has more than four cards in hand, they exile cards from their hand equal to the difference.', "Activated abilities of lands your opponents control can't be activated unless they're mana abilities.\\nSharkey, Tyrant of the Shire has all activated abilities of lands your opponents control except mana abilities.\\nMana of any type can be spent to activate Sharkey's abilities.", "Amass Orcs 2. When you do, Foray of Orcs deals X damage to target creature an opponent controls, where X is the amassed Army's power.", "Amass Orcs 2. When you do, Foray of Orcs deals X damage to target creature an opponent controls, where X is the amassed Army's power. (To amass Orcs 2, put two +1/+1 counters on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)", "Amass Orcs 3, then target player mills X cards, where X is the amassed Army's power. (To amass Orcs 3, put three +1/+1 counters on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)", 'Amass Orcs X, then Goblins and Orcs you control gain double strike and haste until end of turn.', "Amass Orcs X, then Goblins and Orcs you control gain double strike and haste until end of turn. (To amass Orcs X, put X +1/+1 counters on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)", 'Arwen, Mortal Queen enters the battlefield with an indestructible counter on it.\\n{1}, Remove an indestructible counter from Arwen: Another target creature gains indestructible until end of turn. Put a +1/+1 counter and a lifelink counter on that creature and a +1/+1 counter and a lifelink counter on Arwen.', 'As an additional cost to cast this spell, discard a card.\\nDraw two cards and create a 1/1 white Human Soldier creature token.', 'As an additional cost to cast this spell, sacrifice a creature or pay {4}.\\nDestroy target creature.', 'As an additional cost to cast this spell, sacrifice a creature.\\nDraw two cards. If the sacrificed creature was legendary, draw three cards instead.', 'As an additional cost to cast this spell, sacrifice an artifact or creature.\\nImprovised Club deals 4 damage to any target.', "As long as it's your turn, equipped creature has hexproof and can't be blocked.\\nWhenever equipped creature attacks alone, you draw a card and you lose 1 life.\\nEquip Halfling {1} ({1}: Attach to target Halfling you control. Equip only as a sorcery.)\\nEquip {4} ({4}: Attach to target creature you control. Equip only as a sorcery.)", "As long as it's your turn, equipped creature has hexproof and can't be blocked.\\nWhenever equipped creature attacks alone, you draw a card and you lose 1 life.\\nEquip Halfling {1}\\nEquip {4}", 'As long as there are four or more lore counters among Sagas you control, Tom Bombadil has hexproof and indestructible.\\nWhenever the final chapter ability of a Saga you control resolves, reveal cards from the top of your library until you reveal a Saga card. Put that card onto the battlefield and the rest on the bottom of your library in a random order. This ability triggers only once each turn.', 'At the beginning of combat on your turn, target creature gains your choice of first strike or vigilance until end of turn. If that creature is equipped, it gains first strike and vigilance until end of turn instead.\\nEquip abilities you activate cost {1} less to activate.', "At the beginning of your end step, choose an opponent. At the beginning of that player's next end step, you draw a card if they didn't attack you that turn. Otherwise, create three 1/1 white Human Soldier creature tokens.", 'At the beginning of your end step, if a creature died under your control this turn, create a 1/1 white Human Soldier creature token.\\n{2}, Sacrifice another creature: Each opponent loses 1 life and you gain 1 life.', 'At the beginning of your end step, if a creature died under your control this turn, draw a card.\\nWhenever the Ring tempts you, if you chose a creature other than Faramir, Field Commander as your Ring-bearer, create a 1/1 white Human Soldier creature token.', 'At the beginning of your end step, if a creature died under your control this turn, the Ring tempts you.\\nWhenever the Ring tempts you, target opponent reveals cards from the top of their library until they reveal a land card. Put that card onto the battlefield tapped under your control and the rest into their graveyard.', 'At the beginning of your end step, if you don\'t control a Food, create a Food token. (It\'s an artifact with "{2}, {T}, Sacrifice this artifact: You gain 3 life.")', "At the beginning of your end step, put an influence counter on Palantír of Orthanc and scry 2. Then target opponent may have you draw a card. If that player doesn't, you mill X cards, where X is the number of influence counters on Palantír of Orthanc, and that player loses life equal to the total mana value of those cards.", 'At the beginning of your upkeep, the Ring tempts you.\\nWhenever you choose a creature as your Ring-bearer, you may pay 2 life. If you do, draw a card.', 'Barad-dûr enters the battlefield tapped unless you control a legendary creature.\\n{T}: Add {B}.\\n{X}{X}{B}, {T}: Amass Orcs X. Activate only if a creature died this turn.', 'Choose an opponent. They look at the top four cards of your library and separate them into a face-down pile and a face-up pile. Put one pile into your hand and the other into your graveyard. The Ring tempts you.', 'Choose one —\\n• Cast into the Fire deals 1 damage to each of up to two target creatures.\\n• Exile target artifact.', 'Choose one. If you control a Wizard as you cast this spell, you may choose two instead.\\n• Target player draws two cards.\\n• Destroy target artifact.\\n• Flame of Anor deals 5 damage to target creature.', 'Counter target creature spell with power or toughness 2 or less.', 'Counter target creature spell. If it was a legendary spell, the Ring tempts you.', "Counter target spell.\\nAmass Orcs 1. (Put a +1/+1 counter on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)", 'Create a Treasure token. (It\'s an artifact with "{T}, Sacrifice this artifact: Add one mana of any color.")\\nAmass Orcs 2. (Put two +1/+1 counters on an Army you control. It\'s also an Orc. If you don\'t control an Army, create a 0/0 black Orc Army creature token first.)', 'Create two 1/1 white Human Soldier creature tokens. Humans you control gain haste until end of turn.', 'Create two tapped 1/1 white Spirit creature tokens with flying.', 'Creatures you control have haste.\\nLegendary creatures you control get +1/+0.', 'Creatures your opponents control get -1/-1 until end of turn. The Ring tempts you.', "Damage can't be prevented this turn. Fear, Fire, Foes deals X damage to target creature and 1 damage to each other creature with the same controller.", 'Dawn of a New Age enters the battlefield with a hope counter on it for each creature you control.\\nAt the beginning of your end step, remove a hope counter from Dawn of a New Age. If you do, draw a card. Then if Dawn of a New Age has no hope counters on it, sacrifice it and you gain 4 life.', 'Deathtouch, ward {2}\\nOther Spiders you control have deathtouch and ward {2}.\\nWhenever another creature dealt damage this turn by a Spider you controlled dies, create a token that\'s a copy of that creature, except it\'s a Food artifact with "{2}, {T}, Sacrifice this artifact: You gain 3 life," and it loses all other card types.', 'Deathtouch\\nWhen Nazgûl enters the battlefield, the Ring tempts you.\\nWhenever the Ring tempts you, put a +1/+1 counter on each Wraith you control.\\nA deck can have up to nine cards named Nazgûl.', 'Deathtouch\\nWhenever Mirkwood Spider attacks, target legendary creature you control gains deathtouch until end of turn.', "Defender\\nWhenever you attack with one or more Goblins and/or Orcs, create a 2/1 colorless Construct artifact creature token with flying named Ballistic Boulder that's tapped and attacking. Sacrifice that token at end of combat.", 'Defender\\n{1}: Add one mana of any color. Activate only once each turn.', 'Destroy all creatures with power 3 or greater. Then create a Food token for each creature you control.', 'Destroy all creatures with power 3 or greater. Then create a Food token for each creature you control. (It\'s an artifact with "{2}, {T}, Sacrifice this artifact: You gain 3 life.")', "Destroy target artifact or land. Creatures without flying can't block this turn.", 'Destroy target artifact, enchantment, or creature with flying. Scry 1.', 'Destroy target creature that blocked or was blocked by a legendary creature this turn.', 'Destroy target creature. The Ring tempts you.', 'Double strike\\nWhenever a Goblin or Orc you control deals combat damage to a player, exile the top card of your library. You may play that card this turn.', 'Draw a card. The Ring tempts you.', "Draw a card.\\nWhenever you scry, if you control an Island, you may exile Council's Deliberation from your graveyard. If you do, draw a card.", 'Draw three cards.\\nIslandcycling {1} ({1}, Discard this card: Search your library for an Island card, reveal it, put it into your hand, then shuffle.)', 'Each player sacrifices a creature. If you sacrificed a creature this way, you may return another permanent card from your graveyard to the battlefield.', 'Enchant creature\\nEnchanted creature gets -3/-0 and has "At the beginning of your upkeep, exile this creature unless you pay 2 life."', "Enchant creature\\nEnchanted creature is a Spirit and can't attack or block. (It loses all other creature types.)", 'Enchant creature\\nWhen Bewitching Leechcraft enters the battlefield, tap enchanted creature.\\nEnchanted creature has "If this creature would untap during your untap step, remove a +1/+1 counter from it instead. If you do, untap it." (Otherwise, it doesn\'t untap.)', "Equipped creature gets +1/+1 and has haste.\\nAt the beginning of each combat, untap equipped creature.\\nEquipped creature has first strike as long as it's blocking or blocked by a Goblin or Orc.\\nEquip {2}", 'Equipped creature gets +1/+1.\\nWhenever equipped creature blocks or becomes blocked by a creature, that creature loses all abilities until end of turn.\\nEquip {1} ({1}: Attach to target creature you control. Equip only as a sorcery.)', 'Equipped creature gets +2/+1.\\nEquip Human {1}\\nEquip {3} ({3}: Attach to target creature you control. Equip only as a sorcery.)', "Equipped creature gets +3/+0.\\nAs long as equipped creature is legendary, it has menace. (It can't be blocked except by two or more creatures.)\\nEquip {2} ({2}: Attach to target creature you control. Equip only as a sorcery.)", 'Equipped creature gets +3/+1.\\nWhenever equipped creature attacks, create two tapped 1/1 white Spirit creature tokens with flying. If that creature is legendary, instead create two of those tokens that are tapped and attacking.\\nEquip {2}', 'Equipped creature has first strike and gets +1/+0 for each instant and sorcery card in your graveyard.\\nWhenever equipped creature deals combat damage to a player, you may cast an instant or sorcery spell from your hand with mana value less than or equal to that damage without paying its mana cost.\\nEquip {3}', 'Equipped creature has nonbasic landwalk.\\nEquip {2}', "Exile all creature cards from target player's graveyard. You may cast spells from among those cards for as long as they remain exiled, and mana of any type can be spent to cast them.", 'Exile target creature you own, then return it to the battlefield under your control. The Ring tempts you.', 'Flash\\nEnchant creature\\nWhen Gift of Strands enters the battlefield, scry 2.\\nEnchanted creature gets +3/+3.', 'Flash\\nFlying\\nWhen Soldier of the Grey Host enters the battlefield, target creature gets +2/+0 until end of turn.', 'Flash\\nIndestructible\\nWhen Mithril Coat enters the battlefield, attach it to target legendary creature you control.\\nEquipped creature has indestructible.\\nEquip {3}', "Flash\\nMenace\\nWhen Lobelia Sackville-Baggins enters the battlefield, exile target creature card from an opponent's graveyard that was put there from the battlefield this turn, then create X Treasure tokens, where X is the exiled card's power.", 'Flash\\nWhen Galadhrim Bow enters the battlefield, attach it to target creature you control. Untap that creature.\\nEquipped creature gets +1/+2 and has reach.\\nEquip {2} ({2}: Attach to target creature you control. Equip only as a sorcery.)', 'Flash\\nWhen Grey Havens Navigator enters the battlefield, scry 1.', 'Flash\\nWhen Orcish Bowmasters enters the battlefield and whenever an opponent draws a card except the first one they draw in each of their draw steps, Orcish Bowmasters deals 1 damage to any target. Then amass Orcs 1.', 'Flash\\nWhen Samwise the Stouthearted enters the battlefield, choose up to one target permanent card in your graveyard that was put there from the battlefield this turn. Return it to your hand. Then the Ring tempts you.', 'Flash\\nYou may cast legendary spells and artifact spells as though they had flash.\\nIf a legendary permanent or an artifact entering or leaving the battlefield causes a triggered ability of a permanent you control to trigger, that ability triggers an additional time.', 'Flash\\nYou may cast sorcery spells as though they had flash.\\nWhenever the Ring tempts you, if you chose a creature other than Gandalf, Friend of the Shire as your Ring-bearer, draw a card.', 'Flying\\nWhen Dunland Crebain enters the battlefield, amass Orcs 2.', "Flying\\nWhen Dunland Crebain enters the battlefield, amass Orcs 2. (Put two +1/+1 counters on an Army you control. It's also an Orc. If you don't control an Army, create a 0/0 black Orc Army creature token first.)", 'Flying\\nWhen Eagles of the North enters the battlefield, creatures you control get +1/+0 and gain first strike until end of turn.\\nPlainscycling {1} ({1}, Discard this card: Search your library for a Plains card, reveal it, put it into your hand, then shuffle.)', 'Flying\\nWhen Ithilien Kingfisher dies, draw a card.', 'Flying\\nWhen Voracious Fell Beast enters the battlefield, each opponent sacrifices a creature. Create a Food token for each creature sacrificed this way.', 'Flying\\nWhen Voracious Fell Beast enters the battlefield, each opponent sacrifices a creature. Create a Food token for each creature sacrificed this way. (It\'s an artifact with "{2}, {T}, Sacrifice this artifact: You gain 3 life.")', 'Flying\\nWhen Willow-Wind enters the battlefield, scry 2.', "Flying\\nWhenever King of the Oathbreakers or another Spirit you control becomes the target of a spell, it phases out. (Treat it and anything attached to it as though they don't exist until your next turn.)\\nWhenever King of the Oathbreakers or another Spirit you control phases in, create a tapped 1/1 white Spirit creature token with flying.", 'Flying\\nWhenever King of the Oathbreakers or another Spirit you control becomes the target of a spell, it phases out.\\nWhenever King of the Oathbreakers or another Spirit you control phases in, create a tapped 1/1 white Spirit creature token with flying.', 'Flying\\nWhenever Meneldor, Swift Savior deals combat damage to a player, exile up to one target creature you own, then return it to the battlefield under your control.', 'Flying\\nWhenever Witch-king, Bringer of Ruin attacks, defending player sacrifices a creature with the least power among creatures they control.', 'Flying\\nWhenever one or more creatures deal combat damage to you, each opponent sacrifices a creature that dealt combat damage to you this turn. The Ring tempts you.\\nDiscard a card: Witch-king of Angmar gains indestructible until end of turn. Tap it.', 'Flying\\nWhenever two or more creatures you control attack a player, target attacking creature without flying gains flying until end of turn.', 'Flying\\nWhenever you create or sacrifice a token, each opponent loses 1 life.', "Gandalf's Sanction deals X damage to target creature, where X is the number of instant and sorcery cards in your graveyard. Excess damage is dealt to that creature's controller instead.", "Gimli, Mournful Avenger has indestructible as long as two or more creatures died under your control this turn.\\nWhenever another creature you control dies, put a +1/+1 counter on Gimli. When this ability resolves for the third time this turn, Gimli fights up to one target creature you don't control.", "Haste\\nMerry, Esquire of Rohan has first strike as long as it's equipped.\\nWhenever you attack with Merry and another legendary creature, draw a card.", "Haste\\nWhen Éowyn, Fearless Knight enters the battlefield, exile target creature an opponent controls with greater power. Legendary creatures you control gain protection from each of that creature's colors until end of turn.", 'Haste\\nWhenever one or more other attacking legendary creatures you control die, untap all creatures you control. After this phase, there is an additional combat phase. This ability triggers only once each turn.', 'Haste\\nWhenever Éomer of the Riddermark attacks, if you control a creature with the greatest power among creatures on the battlefield, create a 1/1 white Human Soldier creature token.', "Hobbit's Sting deals X damage to target creature, where X is the number of creatures you control plus the number of Foods you control.", 'Horses you control have haste. (They can attack and {T} as soon as they come under your control.)\\nWhenever Shadowfax, Lord of Horses attacks, you may put a creature card with lesser power from your hand onto the battlefield tapped and attacking.', "If a creature an opponent controls would die, exile it instead.\\n{2}, {T}, Sacrifice Stone of Erech: Exile target player's graveyard. Draw a card.", 'If one or more tokens would be created under your control, those tokens plus an additional Food token are created instead. (It\'s an artifact with "{2}, {T}, Sacrifice this artifact: You gain 3 life.")\\nSacrifice three Foods: Draw a card.', 'If one or more tokens would be created under your control, those tokens plus an additional Food token are created instead.\\nSacrifice three Foods: Draw a card.', 'If you would draw a card while you have no cards in hand, draw two cards instead.\\nIf you would gain life while you have 5 or less life, you gain twice that much life instead.\\n{T}: Add one mana of any color.', 'Indestructible\\nWhen The One Ring enters the battlefield, if you cast it, you gain protection from everything until your next turn.\\nAt the beginning of your upkeep, you lose 1 life for each burden counter on The One Ring.\\n{T}: Put a burden counter on The One Ring, then draw a card for each burden counter on The One Ring.', "Landfall — Whenever a land enters the battlefield under your control, if you don't control a Ring-bearer, the Ring tempts you.", 'Landfall — Whenever a land enters the battlefield under your control, target creature gets +1/+1 until end of turn. Then if that creature has power 4 or greater, it gains first strike until end of turn.', 'Legendary creatures you control get +2/+1 and have ward {1}.\\nNonlegendary creatures you control get +1/+1.', "Menace (This creature can't be blocked except by two or more creatures.)\\nAs long as you control a Goblin or Orc, Snarling Warg gets +1/+0.", "Menace (This creature can't be blocked except by two or more creatures.)\\nWhen Rohirrim Lancer dies, the Ring tempts you.", 'Menace\\nIf one or more +1/+1 counters would be put on an Army, Goblin, or Orc you control, that many plus one +1/+1 counters are put on it instead.', "Menace\\nWhenever Sauron, the Necromancer attacks, exile target creature card from your graveyard. Create a tapped and attacking token that's a copy of that card, except it's a 3/3 black Wraith with menace. At the beginning of the next end step, exile that token unless Sauron is your Ring-bearer.", 'Minas Tirith enters the battlefield tapped unless you control a legendary creature.\\n{T}: Add {W}.\\n{1}{W}, {T}: Draw a card. Activate only if you attacked with two or more creatures this turn.', 'Mines of Moria enters the battlefield tapped unless you control a legendary creature.\\n{T}: Add {R}.\\n{3}{R}, {T}, Exile three cards from your graveyard: Create two Treasure tokens.', "Old Man Willow's power and toughness are each equal to the number of lands you control.\\nWhenever Old Man Willow attacks