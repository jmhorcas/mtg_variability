s.com/Handlers/Image.ashx?multiverseid=178903&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3e7abfd7-c677-4593-aed4-e217d6d8eded', 'multiverseId': 178903}, 'multiverseid': 178903}]", "[{'name': 'Sumpf', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176049&type=card', 'language': 'German', 'identifiers': {'scryfallId': '118f2400-a2ca-4624-b71e-7cc5c56c8d15', 'multiverseId': 176049}, 'multiverseid': 176049}, {'name': 'Pantano', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177461&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ef37fb32-9f6e-4404-aeaf-0d572a112903', 'multiverseId': 177461}, 'multiverseid': 177461}, {'name': 'Marais', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176401&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9f5fd0b3-575d-4df4-815e-2e9fded9d650', 'multiverseId': 176401}, 'multiverseid': 176401}, {'name': 'Palude', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176910&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2b601bd4-fba2-4563-80a8-d4b4a7b946a1', 'multiverseId': 176910}, 'multiverseid': 176910}, {'name': '沼', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '666a37b4-78b5-490e-80c7-690c7d67bb3d'}, 'multiverseid': None}, {'name': 'Pântano', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178904&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e92cd725-b3f8-4253-8de4-1659f5b910ec', 'multiverseId': 178904}, 'multiverseid': 178904}]", "[{'name': 'Sumpf', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176050&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0caeabed-5429-4cc1-8a16-b4b9c5f0a3b3', 'multiverseId': 176050}, 'multiverseid': 176050}, {'name': 'Pantano', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177462&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd0394cc9-a8cc-4fed-9686-c203e09719d2', 'multiverseId': 177462}, 'multiverseid': 177462}, {'name': 'Marais', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176402&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b145b299-7afc-46f3-bd79-9e49ee04ec4e', 'multiverseId': 176402}, 'multiverseid': 176402}, {'name': 'Palude', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176911&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '29abb4ec-71a9-49ca-94c3-c27100e5b589', 'multiverseId': 176911}, 'multiverseid': 176911}, {'name': '沼', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b98325b7-5620-4df0-8119-dbd8e8022fe2'}, 'multiverseid': None}, {'name': 'Pântano', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178905&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '05d2dbc0-fccb-465a-92ae-d9d0ed5b0662', 'multiverseId': 178905}, 'multiverseid': 178905}]", "[{'name': 'Teuflischer Lehrmeister', 'text': 'Durchsuche deine Bibliothek nach einer Karte und nimm diese Karte auf deine Hand. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die besten Ideen kommen oft aus den verdrehtesten Hirnen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175837&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'cf176b89-516d-4b4f-9677-54eb49420b95', 'multiverseId': 175837}, 'multiverseid': 175837}, {'name': 'Tutor diabólico', 'text': 'Busca en tu biblioteca una carta y pon esa carta en tu mano. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'Las mejores ideas frecuentemente vienen de las peores mentes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177249&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '35074aba-0a0b-44da-b730-c9524dce952f', 'multiverseId': 177249}, 'multiverseid': 177249}, {'name': 'Précepteur démoniaque', 'text': 'Cherchez une carte dans votre bibliothèque et mettez cette carte dans votre main. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'Les meilleures idées viennent parfois des pires esprits.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176189&type=card', 'language': 'French', 'identifiers': {'scryfallId': '96b2e96c-ec0e-4182-a2da-a7bf920f0070', 'multiverseId': 176189}, 'multiverseid': 176189}, {'name': 'Tutore Diabolico', 'text': 'Passa in rassegna il tuo grimorio, scegli una carta e aggiungila alla tua mano. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'Le idee migliori spesso vengono dalle menti peggiori.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176698&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ee734fea-15ae-4f66-963b-fb54eb848a8b', 'multiverseId': 176698}, 'multiverseid': 176698}, {'name': '魔性の教示者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'dce6c7a4-1aed-48af-9015-ed8a90f5ec36'}, 'multiverseid': None}, {'name': 'Tutor Diabólico', 'text': 'Procure em seu grimório por um card e coloque-o em sua mão. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'As melhores idéias costumam vir das piores mentes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178692&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '81211aef-7cbc-4ebd-ae4d-170253d927ad', 'multiverseId': 178692}, 'multiverseid': 178692}]", '[{\'name\': \'Tieranger\', \'text\': \'Das verzauberte Land hat "{T}, opfere eine Kreatur: Du erhältst Lebenspunkte in Höhe der Widerstandskraft dieser Kreatur dazu."\', \'type\': \'Landverzauberung\', \'flavor\': \'„Die Geister der Tiere sind die Enkel der Ahnfrau. Gedenket ihrer." —Älterer Mystiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175712&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'875101e6-e157-4cb5-8b63-e1557b1e8d3a\', \'multiverseId\': 175712}, \'multiverseid\': 175712}, {\'name\': \'Cementerio de animales\', \'text\': \'La tierra encantada tiene: "{T}, sacrificar una criatura: Gana una cantidad de vida igual a la resistencia de esa criatura".\', \'type\': \'Encantar tierra\', \'flavor\': \'"Los espíritus de los animales son los nietos de la Antepasada. Recuérdenlos." —Anciano místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177124&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1403d562-345f-48b5-b44b-6c5dc9de5767\', \'multiverseId\': 177124}, \'multiverseid\': 177124}, {\'name\': "Ossuaire d\'animaux", \'text\': "Le terrain enchanté a « {T}, sacrifiez une créature : Vous gagnez autant de points de vie que l\'endurance de cette créature. »", \'type\': \'Enchanter : terrain\', \'flavor\': \'« Les esprits des animaux sont les petits-enfants des Ancêtres. Ne les oubliez pas. » —Un doyen des mystiques.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176064&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'140dfb17-67da-47df-862e-1b7e4e8f22f0\', \'multiverseId\': 176064}, \'multiverseid\': 176064}, {\'name\': \'Cimitero degli Animali\', \'text\': \'La terra incantata ha "{T}, Sacrifica una creatura: Guadagni un ammontare di punti vita pari alla costituzione di quella creatura".\', \'type\': \'Incanta Terra\', \'flavor\': \'"Gli spiriti degli animali sono i discendenti degli Antenati. Non dimenticarli". —anziano mistico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176573&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'99dc1408-7bca-4c30-ad12-8ffe8ce837dc\', \'multiverseId\': 176573}, \'multiverseid\': 176573}, {\'name\': \'獣の墓場\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d720cae8-4175-4e73-9646-867b68f13ace\'}, \'multiverseid\': None}, {\'name\': \'Cemitério de Animais\', \'text\': \'O terreno encantado tem "{T}, Sacrifique uma criatura: Você ganha uma quantidade de pontos de vida igual à resistência daquela criatura."\', \'type\': \'Encantar Terreno\', \'flavor\': \'"Os espíritos dos animais são os netos da Ancestral. Lembra-te deles." — Ancião místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178567&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'46cb6277-f6e0-4dd8-97ac-c8ff31d48e3a\', \'multiverseId\': 178567}, \'multiverseid\': 178567}]', '[{\'name\': \'Todes-Riten\', \'text\': \'Wirf eine beliebige Anzahl Karten aus deiner Hand ab. Ein Spieler deiner Wahl zeigt die Karten auf seiner Hand offen vor. Dann bestimmst du für jede Karte, die du auf diese Weise abgeworfen hast, eine Karte darunter, die kein Land ist. Dieser Spieler wirft diese Karten ab.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175854&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8018af18-538c-4e75-bba6-ab40ad1706cd\', \'multiverseId\': 175854}, \'multiverseid\': 175854}, {\'name\': \'Ritos de la extremaunción\', \'text\': \'Descarta cualquier número de cartas de tu mano. El jugador objetivo muestra su mano, luego tú eliges de ahí una carta que no sea tierra por cada carta descartada de esta manera. Ese jugador descarta esas cartas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'175baab5-252a-43e4-91e9-4ee84c93d2b7\', \'multiverseId\': 177266}, \'multiverseid\': 177266}, {\'name\': \'Derniers sacrements\', \'text\': "Défaussez-vous de n\'importe quel nombre de cartes de votre main. Le joueur ciblé révèle sa main, puis vous y choisissez une carte non-terrain pour chaque carte défaussée de cette manière. Ce joueur se défausse des cartes que vous avez choisies.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176206&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e2ad7ebc-8c0e-4d8c-a388-55fa41127beb\', \'multiverseId\': 176206}, \'multiverseid\': 176206}, {\'name\': \'Estrema Unzione\', \'text\': \'Scarta un qualsiasi numero di carte dalla tua mano. Il giocatore bersaglio rivela la propria mano, poi tu scegli una carta non terra da essa per ogni carta che hai scartato in questo modo. Quel giocatore scarta quelle carte.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176715&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bbef3a9c-e4e4-4275-9473-d546f426bc13\', \'multiverseId\': 176715}, \'multiverseid\': 176715}, {\'name\': \'最後の儀式\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b418e692-1858-4acd-a552-f356ad0b58d8\'}, \'multiverseid\': None}, {\'name\': \'Últimos Ritos\', \'text\': \'Descarte um número qualquer de cards de sua mão. O jogador alvo revela sua própria mão e depois você escolhe um card que não seja um terreno da mão dele para cada card descartado dessa maneira. Aquele jogador descarta aqueles cards.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178709&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d4e9499c-5361-428a-bbe9-760e3c3a346d\', \'multiverseId\': 178709}, \'multiverseid\': 178709}]', '[{\'name\': \'Tollwütiger Elefant\', \'text\': \'Immer wenn der Tollwütige Elefant geblockt wird, erhält er für jede Kreatur, die ihn blockt, +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elefant\', \'flavor\': \'Im Zweifelsfall einfach zertreten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175971&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'341840e1-8eae-4b4b-8d8e-9b71948b44ec\', \'multiverseId\': 175971}, \'multiverseid\': 175971}, {\'name\': \'Elefante rabioso\', \'text\': \'Siempre que el Elefante rabioso sea bloqueado, obtiene +2/+2 hasta el final del turno por cada criatura que lo bloquee.\', \'type\': \'Criatura — Elefante\', \'flavor\': \'Cuando dudes, pisotea.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177383&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ba29349-faa1-4ebb-8e5a-11889f7b76fe\', \'multiverseId\': 177383}, \'multiverseid\': 177383}, {\'name\': \'Éléphant enragé\', \'text\': "À chaque fois que l\'Éléphant enragé devient bloqué, il gagne +2/+2 jusqu\'à la fin du tour pour chaque créature qui le bloque.", \'type\': \'Créature : éléphant\', \'flavor\': "Il n\'hésite pas, il écrase.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176323&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'38348acc-9c50-4497-808e-466cf75d61e6\', \'multiverseId\': 176323}, \'multiverseid\': 176323}, {\'name\': \'Elefante Imbizzarrito\', \'text\': "Ogniqualvolta l\'Elefante Imbizzarrito viene bloccato, prende +2/+2 fino alla fine del turno per ogni creatura che lo sta bloccando.", \'type\': \'Creatura — Elefante\', \'flavor\': \'Quando hai dei dubbi, travolgi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176832&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df4f6088-b3ef-494b-8eff-2bfa5cb45cbf\', \'multiverseId\': 176832}, \'multiverseid\': 176832}, {\'name\': \'凶暴象\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c185a92-3a81-4f0f-bf52-c4f9c54b80bb\'}, \'multiverseid\': None}, {\'name\': \'Elefante Raivoso\', \'text\': \'Toda vez que Elefante Raivoso for bloqueado, ele recebe +2/+2 até o final do turno para cada criatura que o está bloqueando.\', \'type\': \'Criatura — Elefante\', \'flavor\': \'Na dúvida, pé na tábua.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178826&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'78c4f74c-233c-4c36-be1d-89c550b9c6ac\', \'multiverseId\': 178826}, \'multiverseid\': 178826}]', "[{'name': 'Totengräber', 'text': 'Wenn der Totengräber ins Spiel kommt, kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurücknehmen.', 'type': 'Kreatur — Zombie', 'flavor': 'Seltsamerweise hinterfragte niemand die Entscheidung der Kabbalisten, einen Zombie für die Friedhofsarbeiten einzustellen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175848&type=card', 'language': 'German', 'identifiers': {'scryfallId': '07629706-ce7b-43fe-a998-a2c368fd4146', 'multiverseId': 175848}, 'multiverseid': 175848}, {'name': 'Sepulturero', 'text': 'Cuando el Sepulturero entre en juego, puedes regresar la carta objetivo de criatura de tu cementerio a tu mano.', 'type': 'Criatura — Zombie', 'flavor': 'Curiosamente, nadie cuestionó la sabiduría de la Cábala al contratar a un zombie para trabajar en el cementerio.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177260&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6a796781-dfa5-4c46-97e8-69d3fc4f9974', 'multiverseId': 177260}, 'multiverseid': 177260}, {'name': 'Fossoyeur', 'text': 'Quand le Fossoyeur arrive en jeu, vous pouvez renvoyer une carte de créature ciblée depuis votre cimetière dans votre main.', 'type': 'Créature : zombie', 'flavor': 'Seule la Coterie pouvait engager un zombie pour garder le cimetière.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176200&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6b3f30e8-fea2-4a1c-867c-2d94947f20f3', 'multiverseId': 176200}, 'multiverseid': 176200}, {'name': 'Scavatombe', 'text': 'Quando lo Scavatombe entra in gioco, puoi riprendere in mano una carta creatura bersaglio dal tuo cimitero.', 'type': 'Creatura — Zombie', 'flavor': 'Stranamente nessuno mise in discussione la decisione della Cabala di assumere uno zombie per lavorare al cimitero.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176709&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2bf7c049-369e-4a9b-9d0a-efcea2ddbe26', 'multiverseId': 176709}, 'multiverseid': 176709}, {'name': 'グレイブディガー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4eaac3ec-a442-4e05-8dcb-f102ec74c3c2'}, 'multiverseid': None}, {'name': 'Coveiro', 'text': 'Quando Coveiro entra em jogo, você pode devolver o card de criatura alvo de seu cemitério para a sua mão.', 'type': 'Criatura — Zumbi', 'flavor': 'Por estranho que pareça, ninguém questionou o critério da Cabala ao contratar um zumbi para trabalhar no cemitério.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178703&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8fa33ed1-f446-4dd0-a7ea-633307a3cd0e', 'multiverseId': 178703}, 'multiverseid': 178703}]", '[{\'name\': \'Traumatisierung\', \'text\': \'Ein Spieler deiner Wahl legt die obere Hälfte seiner Bibliothek (abgerundet) auf seinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'Dreads hatte sich schon halb durchgerungen, einfach zu gehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fd742ca6-6997-476d-84d6-c200c2a081ab\', \'multiverseId\': 175818}, \'multiverseid\': 175818}, {\'name\': \'Traumatizar\', \'text\': \'El jugador objetivo pone la mitad superior de su biblioteca, redondeada hacia abajo, en su cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'Dreads consideró escapar . . . aunque lo hizo a medias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e8a316cb-1c6d-4cdd-a9bd-ba6f7f83a5b1\', \'multiverseId\': 177230}, \'multiverseid\': 177230}, {\'name\': \'Traumatisme\', \'text\': "Le joueur ciblé met la moitié des cartes (arrondie à l\'inférieur) du dessus de sa bibliothèque dans son cimetière.", \'type\': \'Rituel\', \'flavor\': "Dreds ne se battait plus qu\'avec un demi cerveau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176170&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22b3fbd1-fc04-4caa-b636-4c7a9816ba95\', \'multiverseId\': 176170}, \'multiverseid\': 176170}, {\'name\': \'Traumatizzare\', \'text\': \'Il giocatore bersaglio mette la metà superiore del proprio grimorio, arrotondata per difetto, nel proprio cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'Dreds aveva una mezza idea di andarsene.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176679&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d4fe833-93dc-46c4-a12c-01a0f204cab5\', \'multiverseId\': 176679}, \'multiverseid\': 176679}, {\'name\': \'心の傷跡\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71789568-4c16-44b8-91b9-be691ec0ab8a\'}, \'multiverseid\': None}, {\'name\': \'Traumatizar\', \'text\': \'O jogador alvo coloca a metade superior de seu próprio grimório, arredondada para baixo, em seu próprio cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'Dreads teve uma certa vontade de partir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178673&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'87b3f291-aa82-4949-89bf-3b18fbf2aeea\', \'multiverseId\': 178673}, \'multiverseid\': 178673}]', '[{\'name\': \'Traumverzehrer\', \'text\': \'Fliegend\\nStärke und Widerstandskraft des Traumverzehrers sind gleich der Anzahl an Spontanzauberkarten in allen Friedhöfen.\', \'type\': \'Kreatur — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175785&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3633a224-125c-4e14-9c0c-de14be605cb8\', \'multiverseId\': 175785}, \'multiverseid\': 175785}, {\'name\': \'Cognívoro\', \'text\': \'Vuela.\\nTanto la fuerza como la resistencia del Cognívoro son iguales al número de cartas de instantáneo que haya en todos los cementerios.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177197&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9868e813-83e7-4cbe-8bfc-f5a3e48c917b\', \'multiverseId\': 177197}, \'multiverseid\': 177197}, {\'name\': \'Cognivore\', \'text\': "Vol\\nLa force et l\'endurance du Cognivore sont chacune égale au nombre de cartes d\'éphémère dans tous les cimetières.", \'type\': \'Créature : lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176137&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4006f1b4-05d2-401e-beed-8320ab368235\', \'multiverseId\': 176137}, \'multiverseid\': 176137}, {\'name\': \'Cognivoro\', \'text\': \'Volare\\nLa forza e la costituzione del Cognivoro sono pari ciascuna al numero di carte istantaneo presenti in tutti i cimiteri.\', \'type\': \'Creatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176646&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90fc40a6-b446-487d-a097-af707f866032\', \'multiverseId\': 176646}, \'multiverseid\': 176646}, {\'name\': \'認識を食うもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5d010f5e-fe4a-4826-8399-4b216cf3e362\'}, \'multiverseid\': None}, {\'name\': \'Cognívoro\', \'text\': \'Voar\\nO poder e a resistência do Cognívoro são iguais ao número de mágicas instantâneas em todos os cemitérios.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178640&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b04f1187-7b21-4bee-8530-de611fbd066a\', \'multiverseId\': 178640}, \'multiverseid\': 178640}]', '[{\'name\': \'Traumwinder\', \'text\': \'Der Traumwinder kann nicht angreifen, falls der verteidigende Spieler keine Insel kontrolliert.\\n{U}, opfere eine Insel: Ein Land deiner Wahl wird bis zum Ende des Zuges zu einer Insel.\', \'type\': \'Kreatur — Schlange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175791&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'034df3e8-dc18-45dd-b325-2e5a7cd9b300\', \'multiverseId\': 175791}, \'multiverseid\': 175791}, {\'name\': \'Devanador de sueños\', \'text\': \'El Devanador de sueños no puede atacar a menos que el jugador defensor controle una isla.\\n{U}, sacrificar una isla: La tierra objetivo es una isla hasta el final del turno.\', \'type\': \'Criatura — Serpiente\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177203&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'24565930-813f-44d5-a7ce-e4145678bd63\', \'multiverseId\': 177203}, \'multiverseid\': 177203}, {\'name\': \'Porterêve\', \'text\': "Le Porterêve ne peut pas attaquer à moins que le joueur défenseur ne contrôle au moins une île.\\n{U}, sacrifiez une île : Le terrain ciblé devient une île jusqu\'à la fin du tour.", \'type\': \'Créature : serpent\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176143&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d73d88a3-5fd4-4695-8de3-2e3106a7b958\', \'multiverseId\': 176143}, \'multiverseid\': 176143}, {\'name\': \'Attorciglia Sogni\', \'text\': "L\'Attorciglia Sogni non può attaccare a meno che il giocatore in difesa controlli almeno un\'isola.\\n{U}, Sacrifica un\'isola: La terra bersaglio diventa un\'isola fino alla fine del turno.", \'type\': \'Creatura — Serpe\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176652&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5dc83fa1-daa5-4165-8369-4d69fd5fc017\', \'multiverseId\': 176652}, \'multiverseid\': 176652}, {\'name\': \'夢繰り\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4c01a5e-d138-4688-bd42-0c6be8f526f5\'}, \'multiverseid\': None}, {\'name\': \'Serpente dos Sonhos\', \'text\': \'Serpente dos Sonhos não pode atacar a menos que o jogador defensor controle uma ilha.\\n{U}, Sacrifique uma ilha: O terreno alvo torna-se uma ilha até o final do turno.\', \'type\': \'Criatura — Serpente\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178646&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63770758-8a3c-474c-ae14-ba83728bc993\', \'multiverseId\': 178646}, \'multiverseid\': 178646}]', "[{'name': 'Tribut der Ahnen', 'text': 'Für jede Karte in deinem Friedhof erhältst Du 2 Lebenspunkte dazu.\\nRückblende {9}{W}{W}{W} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175710&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e7bf55b7-7293-417b-9bde-21108471c4ff', 'multiverseId': 175710}, 'multiverseid': 175710}, {'name': 'Tributo ancestral', 'text': 'Gana 2 vidas por cada carta que haya en tu cementerio.\\nRetrospectiva {9}{W}{W}{W}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177122&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ffe891e2-b57f-47d4-b1bc-26b219fee8c4', 'multiverseId': 177122}, 'multiverseid': 177122}, {'name': 'Hommage ancestral', 'text': 'Vous gagnez 2 points de vie pour chaque carte dans votre cimetière.\\nFlashback {9}{W}{W}{W} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176062&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8defdd1a-0ba1-4222-ac62-9e2946098204', 'multiverseId': 176062}, 'multiverseid': 176062}, {'name': 'Tributo Ancestrale', 'text': 'Guadagni 2 punti vita per ogni carta presente nel tuo cimitero.\\nFlashback {9}{W}{W}{W} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176571&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd76263ac-02ba-4a5c-be41-807577f654b8', 'multiverseId': 176571}, 'multiverseid': 176571}, {'name': '先祖からの貢ぎ物', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c142c38c-516e-4b61-856c-959593a44980'}, 'multiverseid': None}, {'name': 'Tributo Ancestral', 'text': 'Você ganha 2 pontos de vida para cada card em seu cemitério.\\nRecapitular {9}{W}{W}{W} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178565&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'aab3a7d7-fc3b-4aba-95e5-d0116664d53b', 'multiverseId': 178565}, 'multiverseid': 178565}]", '[{\'name\': \'Umleiten\', \'text\': \'Ändere das Ziel eines Zauberspruchs deiner Wahl zu einem anderen einzelnen Ziel, falls der Beherrscher des Zauberspruchs nicht {2} bezahlt.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wo bleibt der Spaß daran, ein Zauberer zu sein, wenn man nicht in anderer Leute Köpfe herumpfuschen darf?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175790&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2a3f343-cc4a-4808-a8a6-1a50e75b9d83\', \'multiverseId\': 175790}, \'multiverseid\': 175790}, {\'name\': \'Distraer\', \'text\': \'Cambia el objetivo del hechizo objetivo que tenga un solo objetivo a menos que el controlador de ese hechizo pague {2}.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Qué tiene de divertido ser hechicero si no puedes confundir la mente de la gente?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177202&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5a4e951-b581-44bc-87c3-f3a2b950182a\', \'multiverseId\': 177202}, \'multiverseid\': 177202}, {\'name\': \'Diversion\', \'text\': \'Changez la cible du sort ciblé qui a une cible unique, à moins que le contrôleur du sort ne paye {2}.\', \'type\': \'Éphémère\', \'flavor\': "« À quoi bon être sorcier si on ne peut pas jouer avec l\'esprit des gens ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176142&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a78b33c-9685-4835-8bb1-270a4195460b\', \'multiverseId\': 176142}, \'multiverseid\': 176142}, {\'name\': \'Distrarre\', \'text\': \'Cambia il bersaglio di una magia bersaglio con un singolo bersaglio a meno che il controllore di quella magia spenda {2}.\', \'type\': \'Istantaneo\', \'flavor\': \'"Che divertimento c\\\'è a essere un mago se non puoi giocare con la mente della gente?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176651&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'02819db8-4bb4-47fa-994b-9cba69463af6\', \'multiverseId\': 176651}, \'multiverseid\': 176651}, {\'name\': \'方向転換\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'73e9ff38-77ae-407a-9ba5-ea1b433b4489\'}, \'multiverseid\': None}, {\'name\': \'Desviar\', \'text\': \'Muda o alvo da mágica alvo que tenha apenas um alvo a não ser que seu controlador pague {2}.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Qual é a graça de ser um mago se você não pode confundir a cabeça das pessoas?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178645&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1bff4de7-feab-4754-9638-44a63fff798f\', \'multiverseId\': 178645}, \'multiverseid\': 178645}]', "[{'name': 'Umwälzung', 'text': 'Bringe alle bleibenden Karten auf die Hand ihrer Besitzer zurück.', 'type': 'Hexerei', 'flavor': 'Die Ruhe kommt immer erst nach dem Sturm.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175821&type=card', 'language': 'German', 'identifiers': {'scryfallId': '73f3fe28-dfad-413e-b6c2-5aa60a96c174', 'multiverseId': 175821}, 'multiverseid': 175821}, {'name': 'Alzamiento', 'text': 'Regresa todos los permanentes a las manos de sus propietarios.', 'type': 'Conjuro', 'flavor': 'La calma llega después de la tormenta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177233&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '091d3059-a8e0-4ef2-a17f-de158281f0aa', 'multiverseId': 177233}, 'multiverseid': 177233}, {'name': 'Bouleversement', 'text': 'Renvoyez tous les permanents dans les mains de leurs propriétaires.', 'type': 'Rituel', 'flavor': 'Après la tempête viennent le calme et le beau temps.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176173&type=card', 'language': 'French', 'identifiers': {'scryfallId': '462c036d-157f-4d2a-9448-fb013d171712', 'multiverseId': 176173}, 'multiverseid': 176173}, {'name': 'Sconvolgimento', 'text': 'I proprietari riprendono in mano tutti i permanenti.', 'type': 'Stregoneria', 'flavor': 'La calma viene dopo la tempesta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176682&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '30ba393d-a278-42ab-b01c-50b8bfd4d9b8', 'multiverseId': 176682}, 'multiverseid': 176682}, {'name': '激動', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c48b20bc-586f-4126-9070-bc4e355f7883'}, 'multiverseid': None}, {'name': 'Sublevação', 'text': 'Devolva todas as permanentes para as maõs de seus donos.', 'type': 'Feitiço', 'flavor': 'A calmaria sucede a tormenta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178676&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6bc12912-b310-43d7-a210-d1c549d32a82', 'multiverseId': 178676}, 'multiverseid': 178676}]", '[{\'name\': \'Unratgolem\', \'text\': \'Der Unratgolem kommt mit drei +1/+1-Marken ins Spiel.\\nOpfere zu Beginn deines Versorgungssegments den Unratgolem, falls du nicht eine +1/+1-Marke von ihm entfernst.\\n{1}, wirf eine Karte aus deiner Hand ab: Lege eine +1/+1-Marke auf den Unratgolem.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176008&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d72067e4-56a7-410e-b601-7ef1c81852ce\', \'multiverseId\': 176008}, \'multiverseid\': 176008}, {\'name\': \'Gólem de chatarra\', \'text\': \'El Gólem de chatarra entra en juego con tres contadores +1/+1 sobre él.\\nAl comienzo de tu mantenimiento, sacrifica el Gólem de chatarra a menos que remuevas un contador +1/+1 de él.\\n{1}, descartar una carta de tu mano: Pon un contador +1/+1 sobre el Gólem de chatarra.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177420&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef940956-f28d-4d37-b4ae-ed1ef46460b4\', \'multiverseId\': 177420}, \'multiverseid\': 177420}, {\'name\': \'Golem de ferrailles\', \'text\': "Le Golem de ferrailles arrive en jeu avec trois marqueurs +1/+1 sur lui.\\nAu début de votre entretien, sacrifiez le Golem de ferrailles à moins que vous n\'en retiriez un marqueur +1/+1.\\n{1}, défaussez-vous d\'une carte de votre main: Mettez un marqueur +1/+1 sur le Golem de ferrailles.", \'type\': \'Créature-artefact : golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176360&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fc77d5b-6bab-4de7-906c-d869626796bf\', \'multiverseId\': 176360}, \'multiverseid\': 176360}, {\'name\': \'Golem di Ciarpame\', \'text\': "Il Golem di Ciarpame entra in gioco con tre segnalini +1/+1 su di esso.\\nAll\'inizio del tuo mantenimento, sacrifica il Golem di Ciarpame a meno che tu rimuova un segnalino +1/+1 da esso.\\n{1}, Scarta una carta dalla tua mano: Metti un segnalino +1/+1 sul Golem di Ciarpame.", \'type\': \'Creatura Artefatto — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176869&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'046d92b6-c331-4c6b-b7d9-332573f038ef\', \'multiverseId\': 176869}, \'multiverseid\': 176869}, {\'name\': \'ガラクタのゴーレム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c4719763-f868-416b-9b15-486fd123edbd\'}, \'multiverseid\': None}, {\'name\': \'Golem de Sucata\', \'text\': \'Golem de Sucata entra em jogo com três marcadores +1/+1 sobre ele.\\nNo início de sua manutenção, sacrifique Golem de Sucata a não ser que você remova um marcador +1/+1 dele.\\n{1}, Descarte um card de sua mão: Coloque um marcador +1/+1 em Golem de Sucata.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178863&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'75e05811-25a0-4b56-9963-450c1de26f4c\', \'multiverseId\': 178863}, \'multiverseid\': 178863}]', '[{\'name\': \'Unsteter Doppelgänger\', \'text\': \'{3}{U}, entferne den Unsteten Doppelgänger ganz aus dem Spiel: Bringe eine Kreaturenkarte aus deiner Hand ins Spiel. Diese Kreatur erhält Eile bis zum Ende des Zuges. Opfere am Ende des Zuges diese Kreatur. Falls du dies tust, bringe den Unsteten Doppelgänger ins Spiel zurück.\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175809&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eab734bd-b47a-4334-b83c-44dd7c866b60\', \'multiverseId\': 175809}, \'multiverseid\': 175809}, {\'name\': \'Doble astuto\', \'text\': \'{3}{U}, remover del juego el Doble astuto: Pon una carta de criatura de tu mano en juego. Esa criatura gana la habilidad de prisa hasta el final del turno. Al final del turno, sacrifica esa criatura. Si lo haces, regresa el Doble astuto al juego.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177221&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a6868f5-998e-4366-99e9-b390661f8dca\', \'multiverseId\': 177221}, \'multiverseid\': 177221}, {\'name\': \'Doppelganger sournois\', \'text\': "{3}{U}, retirez le Doppelganger sournois de la partie : Mettez en jeu une carte de créature de votre main. Cette créature acquiert la célérité jusqu\'à la fin du tour. À la fin du tour, sacrifiez cette créature. Si vous faites ainsi, renvoyez en jeu le Doppelganger sournois.", \'type\': \'Créature : changeforme\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176161&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0ee4288-ea63-4f02-b75c-1d3f65a1abfa\', \'multiverseId\': 176161}, \'multiverseid\': 176161}, {\'name\': \'Mutaforma Sfuggente\', \'text\': \'{3}{U}, Rimuovi dal gioco il Mutaforma Sfuggente: Metti in gioco una carta creatura dalla tua mano. Quella creatura guadagna rapidità fino alla fine del turno. Alla fine del turno, sacrifica quella creatura. Se lo fai, rimetti in gioco il Mutaforma Sfuggente.\', \'type\': \'Creatura — Polimorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176670&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bd928229-5520-4928-b5d0-ade5b3c6f9b3\', \'multiverseId\': 176670}, \'multiverseid\': 176670}, {\'name\': \'変容するドッペルゲンガー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4ec393a-3d1d-416a-a1cb-c98f49230789\'}, \'multiverseid\': None}, {\'name\': \'Doppelganger Astuto\', \'text\': \'{3}{U}, Remova Doppelganger Astuto do jogo: Coloque em jogo um card de criatura de sua mão. Aquela criatura ganha ímpeto até o final do turno. No final do turno, sacrifique aquela criatura. Se você o fizer, devolva Doppelganger Astuto para o jogo.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178664&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff569062-0f87-4ff8-9543-1db4e468362e\', \'multiverseId\': 178664}, \'multiverseid\': 178664}]', '[{\'name\': \'Unterbinden\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, falls sein Beherrscher nicht {X} bezahlt. Wenn der Zauberspruch auf diese Weise neutralisiert wird, entferne ihn ganz aus dem Spiel, anstatt ihn auf den Friedhof seines Besitzers zu legen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Erinnerungen können nicht einfach weggewaschen werden; das Gedächtnis muss schon sauber geschrubbt werden." —Botschafter Laquatus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175811&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0934186d-77b5-4661-be88-f579a96ef7b0\', \'multiverseId\': 175811}, \'multiverseid\': 175811}, {\'name\': \'Sincopar\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {X}. Si ese hechizo es contrarrestado de esta manera, remuévelo del juego en vez de ponerlo en el cementerio de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'"A los recuerdos no se los lleva el viento. Hay que restregar la mente hasta que desaparezcan." —Embajador Laquatus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177223&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25682a98-9838-4dba-ad54-21c5754cf151\', \'multiverseId\': 177223}, \'multiverseid\': 177223}, {\'name\': \'Syncope\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paye {X}. Si ce sort est contrecarré de cette manière, retirez-le de la partie au lieu de le mettre dans le cimetière de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': "« Effacer les souvenirs ne suffit pas, il faut ensuite récurer le cerveau. » —L\'ambassadeur Laquatus.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176163&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec06adcf-49f8-48d6-92a9-9b3c1c689074\', \'multiverseId\': 176163}, \'multiverseid\': 176163}, {\'name\': \'Sincopare\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore spenda {X}. Se quella magia viene neutralizzata in questo modo, rimuovila dal gioco invece di metterla nel cimitero del suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'"Le memorie non possono essere semplicemente sciacquate via. La mente deve essere scrostata a forza". —Ambasciatore Laquatus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176672&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ea77e9a0-baa2-4689-b08e-fc48d2cb45cd\', \'multiverseId\': 176672}, \'multiverseid\': 176672}, {\'name\': \'中略\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c49bc47-6a95-452b-8b7c-eac5ee6e3e32\'}, \'multiverseid\': None}, {\'name\': \'Sincopar\', \'text\': \'Anula a mágica alvo a menos que seu controlador pague {X}. Se aquela mágica for anulada dessa maneira, remova-a do jogo em vez de colocá-la no cemitério de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"As memórias não podem ser apenas enxaguadas. A mente deve ser apagada por completo." — Embaixador Laquatus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178666&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79b1a6c5-6566-4422-bb86-790a54e8df76\', \'multiverseId\': 178666}, \'multiverseid\': 178666}]', '[{\'name\': \'Unterschlupf\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält bis zum Ende des Zuges Schutz vor einer Farbe, die du bestimmst.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Gute Strategen nutzen Möglichkeiten aus. Große Strategen erschaffen sich welche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175754&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23317521-674e-4d21-8371-728a658eefc0\', \'multiverseId\': 175754}, \'multiverseid\': 175754}, {\'name\': \'Refugiar\', \'text\': \'La criatura objetivo que controles gana protección contra el color de tu elección hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Los estrategas buenos aprovechan las oportunidades. Los estrategas grandiosos crean las suyas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177166&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dfbe19a2-dd90-49f0-acfd-cbdc0ded922c\', \'multiverseId\': 177166}, \'multiverseid\': 177166}, {\'name\': \'Abri\', \'text\': "La créature ciblée que vous contrôlez acquiert la protection contre la couleur de votre choix jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'Les bons stratèges saisissent les bonnes occasions. Les grands stratèges les créent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176106&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60cb69d1-8df3-4d18-b4c5-a0231b92b4a3\', \'multiverseId\': 176106}, \'multiverseid\': 176106}, {\'name\': \'Rifugio\', \'text\': \'La creatura bersaglio che controlli guadagna protezione da un colore a tua scelta fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'I buoni strateghi approfittano delle opportunità. I grandi strateghi se le creano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176615&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb8cef3c-4477-4b02-be87-26dfa7f48155\', \'multiverseId\': 176615}, \'multiverseid\': 176615}, {\'name\': \'避難\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'98f6d32b-f7e0-4547-9ebb-24d6dde3ebd8\'}, \'multiverseid\': None}, {\'name\': \'Abrigo\', \'text\': \'A criatura alvo que você controla ganha proteção contra a cor de sua escolha até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Bons estrategistas agarram as oportunidades. Os grandes estrategistas criam-nas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178609&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb82a6a1-a3a8-44a4-b818-c6e689742a6e\', \'multiverseId\': 178609}, \'multiverseid\': 178609}]', '[{\'name\': \'Unverwüstlicher Wanderer\', \'text\': \'Erstschlag\\nWirf eine Karte aus deiner Hand ab: Der Unverwüstliche Wanderer erhält bis zum Ende des Zuges Schutz vor einer Farbe, die du bestimmst.\', \'type\': \'Kreatur — Nomade\', \'flavor\': \'Nomaden verstehen viele Kulturen und wandern daher ohne Furcht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175751&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4117cd7-b7c4-4b11-9ace-6950f7302457\', \'multiverseId\': 175751}, \'multiverseid\': 175751}, {\'name\': \'Vagabunda flexible\', \'text\': \'Daña primero.\\nDescartar una carta de tu mano: La Vagabunda flexible gana protección contra el color de tu elección hasta el final del turno.\', \'type\': \'Criatura — Nómada\', \'flavor\': \'Los nómadas entienden muchas culturas, y por lo tanto, viajan sin miedo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177163&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'df8c81c9-1da4-44ef-9ad1-d97123824362\', \'multiverseId\': 177163}, \'multiverseid\': 177163}, {\'name\': \'Vagabonde résistante\', \'text\': "Initiative\\nDéfaussez-vous d\'une carte de votre main : La Vagabonde résistante acquiert la protection contre la couleur de votre choix jusqu\'à la fin du tour.", \'type\': \'Créature : nomade\', \'flavor\': "« L\'optimisme des nomades verse sur nous ses bénédictions. »— Colette, Belles saisons.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176103&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7815ac31-27e2-42de-8ee5-9ab2a5fb953d\', \'multiverseId\': 176103}, \'multiverseid\': 176103}, {\'name\': \'Girovaga Tenace\', \'text\': \'Attacco improvviso\\nScarta una carta dalla tua mano: La Girovaga Tenace guadagna protezione da un colore a tua scelta fino alla fine del turno.\', \'type\': \'Creatura — Nomade\', \'flavor\': \'I nomadi comprendono molte culture e per questo viaggiano senza paura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176612&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df6a8cc3-9aed-41a7-8fe2-2d6e87e1850d\', \'multiverseId\': 176612}, \'multiverseid\': 176612}, {\'name\': \'気力あふれる放浪者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82735768-1077-4868-9caf-b74dc056cf4f\'}, \'multiverseid\': None}, {\'name\': \'Viajante Resiliente\', \'text\': \'Iniciativa\\nDescarte um card de sua mão: Viajante Resiliente ganha proteção contra a cor de sua escolha até o final do turno.\', \'type\': \'Criatura — Nômade\', \'flavor\': \'Os nômades conhecem muitas culturas, e por isso viajam sem medo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178606&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'709fc51c-2628-42e4-942e-5b70a2ed4e1e\', \'multiverseId\': 178606}, \'multiverseid\': 178606}]', '[{\'name\': \'Urtümliche Kampfeslust\', \'text\': \'Die verzauberte Kreatur verursacht Trampelschaden.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Tue seinen Zorn nicht als hirnlose Wut ab. Ich kann dir versichern, das hat schon seinen Zweck." —Seton, Zentaurendruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175970&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6166d439-38d0-406e-9d66-fbc881c0d166\', \'multiverseId\': 175970}, \'multiverseid\': 175970}, {\'name\': \'Frenesí primitivo\', \'text\': \'La criatura encantada tiene la habilidad de arrollar.\', \'type\': \'Encantar criatura\', \'flavor\': \'"No descartes su enojo como furia irreflexiva. Te aseguro que tiene un propósito." —Seton, druida centauro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177382&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50c5f60e-aa5a-43a7-bbdd-97c460e9dcf2\', \'multiverseId\': 177382}, \'multiverseid\': 177382}, {\'name\': \'Frénésie primale\', \'text\': \'La créature enchantée a le piétinement.\', \'type\': \'Enchanter : créature\', \'flavor\': "« Sa fureur n\'est pas gratuite. Il sait ce qu\'il veut, il sait où il va. » —Selton, druide centaure.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee56088f-dff6-404c-b084-c45dbdbe2557\', \'multiverseId\': 176322}, \'multiverseid\': 176322}, {\'name\': \'Frenesia Primordiale\', \'text\': \'La creatura incantata ha travolgere.\', \'type\': \'Incanta Creatura\', \'flavor\': \'"Non credere che la sua rabbia sia solo furia selvaggia. Ti assicuro, ha i suoi propositi". —Seton, druido centauro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176831&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1c135bc2-b7e8-4add-bf22-872a3bf5b62c\', \'multiverseId\': 176831}, \'multiverseid\': 176831}, {\'name\': \'原初の激情\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8b3804c2-9656-4c91-845c-9de93863a6dc\'}, \'multiverseid\': None}, {\'name\': \'Frenesi Primordial\', \'text\': \'A criatura encantada tem a habilidade de atropelar.\', \'type\': \'Encantar Criatura\', \'flavor\': \'"Não tomes sua raiva por fúria insana. Ela tem motivos, eu te asseguro." — Seton, druida centauro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1bc5e90e-a1b0-49bf-8f8b-93b8ef97ca90\', \'multiverseId\': 178825}, \'multiverseid\': 178825}]', '[{\'name\': \'Vampirdrache\', \'text\': \'Fliegend\\nImmer wenn eine Kreatur, der in diesem Zug Schaden durch den Vampirdrachen zugefügt wurde, auf einen Friedhof gelegt wird, lege eine +1/+1-Marke auf den Vampirdrachen.\\n{1}{R}: Der Vampirdrache fügt einer Kreatur deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Vampir, Drache\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176004&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'82f4e81c-fac4-4792-b402-af116dd33e95\', \'multiverseId\': 176004}, \'multiverseid\': 176004}, {\'name\': \'Dragón vampírico\', \'text\': \'Vuela.\\nSiempre que una criatura que haya recibido daño del Dragón vampírico este turno vaya a un cementerio, pon un contador +1/+1 sobre el Dragón vampírico.\\n{1}{R}: El Dragón vampírico hace 1 punto de daño a la criatura objetivo.\', \'type\': \'Criatura — Dragón vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177416&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'833b06cc-5132-4eb0-bdee-ebc9dced1f21\', \'multiverseId\': 177416}, \'multiverseid\': 177416}, {\'name\': \'Dracovampire\', \'text\': "Vol\\nÀ chaque fois qu\'une créature qui a subi des blessures infligées par le Dracovampire ce tour-ci est mise dans un cimetière, mettez un marqueur +1/+1 sur le Dracovampire.\\n{1}{R}: Le Dracovampire inflige 1 blessure à la créature ciblée.", \'type\': \'Créature : vampire et dragon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176356&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b75ccf23-cbd2-4ff0-97b2-0ce688c2e178\', \'multiverseId\': 176356}, \'multiverseid\': 176356}, {\'name\': \'Drago Vampiro\', \'text\': \'Volare\\nOgniqualvolta una creatura a cui è stato inflitto del danno dal Drago Vampiro in questo turno viene messa in un cimitero, metti un segnalino +1/+1 sul Drago Vampiro.\\n{1}{R}: Il Drago Vampiro infligge 1 danno a una creatura bersaglio.\', \'type\': \'Creatura — Drago Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176865&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0727aba6-03d4-48d9-abb3-250b6c3d7058\', \'multiverseId\': 176865}, \'multiverseid\': 176865}, {\'name\': \'吸血ドラゴン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'62752e81-a419-4060-8cfe-0dd100cb8145\'}, \'multiverseid\': None}, {\'name\': \'Dragão Vampírico\', \'text\': \'Voar\\nToda vez que uma criatura que sofreu dano causado por Dragão Vampírico for colocada em um cemitério, coloque um marcador +1/+1 em Dragão Vampírico.\\n{1}{R}: Dragão Vampírico causa 1 ponto de dano à criatura alvo.\', \'type\': \'Criatura — Dragão Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178859&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b7d37225-6b0a-4b41-ae34-4601c4a9e59b\', \'multiverseId\': 178859}, \'multiverseid\': 178859}]', '[{\'name\': \'Verbissener Jäger\', \'text\': \'{T}: Zerstöre einen Kreaturen-Spielstein deiner Wahl.\', \'type\': \'Kreatur — Nomade\', \'flavor\': \'Das Verhältnis zwischen Jäger und Gejagtem kennt keine Bündnisse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14773fdd-9f2c-4c59-9527-e5df068df573\', \'multiverseId\': 175728}, \'multiverseid\': 175728}, {\'name\': \'Cazador tenaz\', \'text\': \'{T}: Destruye la ficha de criatura objetivo.\', \'type\': \'Criatura — Nómada\', \'flavor\': \'La relación entre el cazador y el cazado no conoce alianzas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177140&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7917b2e2-53cd-45a2-9406-a6af361a5e62\', \'multiverseId\': 177140}, \'multiverseid\': 177140}, {\'name\': \'Chasseur tenace\', \'text\': \'{T}: Détruisez la créature-jeton ciblée.\', \'type\': \'Créature : nomade\', \'flavor\': "Entre chasseur et chassé, il n\'y a pas d\'accord possible.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176080&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c082033d-07c6-4e18-a721-adc609000d4b\', \'multiverseId\': 176080}, \'multiverseid\': 176080}, {\'name\': \'Cacciatore Caparbio\', \'text\': \'{T}: Distruggi una pedina creatura bersaglio.\', \'type\': \'Creatura — Nomade\', \'flavor\': \'Il rapporto tra cacciatore e preda non prevede alleanze.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176589&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'202934b0-e679-486a-88d8-0584d1b105af\', \'multiverseId\': 176589}, \'multiverseid\': 176589}, {\'name\': \'根気強いハンター\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4fcbcf10-ac3a-40a3-b68a-e0c81881c5c5\'}, \'multiverseid\': None}, {\'name\': \'Caçador Obstinado\', \'text\': \'{T}: Destrói a ficha de criatura alvo.\', \'type\': \'Criatura — Nômade\', \'flavor\': \'O relacionamento entre caçador e caçado não reconhece alianças.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178583&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95819d59-8b41-4692-ba9e-f9f124b5e873\', \'multiverseId\': 178583}, \'multiverseid\': 178583}]', '[{\'name\': \'Vereinfachung\', \'text\': \'Jeder Spieler opfert eine Verzauberung.\', \'type\': \'Hexerei\', \'flavor\': \'Die Blütenblätter schließen sich nach innen, um den Frost auszuschließen. —Lehre der Nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175977&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'481ee6b7-ac1c-4e56-85bc-5c0584f01f8e\', \'multiverseId\': 175977}, \'multiverseid\': 175977}, {\'name\': \'Simplificar\', \'text\': \'Cada jugador sacrifica un encantamiento.\', \'type\': \'Conjuro\', \'flavor\': \'Los pétalos de un botón se cierran para dejar fuera a la helada. —Enseñanza nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177389&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6844a71d-a999-4a9a-8de7-99055580e22e\', \'multiverseId\': 177389}, \'multiverseid\': 177389}, {\'name\': \'Simplification\', \'text\': \'Chaque joueur sacrifie un enchantement.\', \'type\': \'Rituel\', \'flavor\': "Les pétales d\'une fleur se referment pour la protéger du froid. —Enseignement nantuko.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96a47cd4-5616-4195-828c-0ffb341328a8\', \'multiverseId\': 176329}, \'multiverseid\': 176329}, {\'name\': \'Semplificare\', \'text\': \'Ogni giocatore sacrifica un incantesimo.\', \'type\': \'Stregoneria\', \'flavor\': \'I petali di un fiore si richiudono per bloccare il freddo. —insegnamento nantuko\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176838&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'40c518f2-3def-44c4-82fd-99528b323549\', \'multiverseId\': 176838}, \'multiverseid\': 176838}, {\'name\': \'簡略化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81eb631c-8f6c-4ec8-b38a-afee03675505\'}, \'multiverseid\': None}, {\'name\': \'Simplificar\', \'text\': \'Cada jogador sacrifica um encantamento.\', \'type\': \'Feitiço\', \'flavor\': \'As pétalas de uma flor em botão fecham-se para barrar a geada. — Ensinamento dos nantukos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178832&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e375c38-8566-42b1-be82-bf9e0ead07ee\', \'multiverseId\': 178832}, \'multiverseid\': 178832}]', '[{\'name\': \'Verfaulen\', \'text\': \'Entferne bis zu drei Karten deiner Wahl aus einem Friedhof ganz aus dem Spiel.\', \'type\': \'Hexerei\', \'flavor\': \'„Verdammt Wie soll ich mir denn jetzt meinen Lebensunterhalt verdienen?" —Kabbalistischer Grabräuber\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175836&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a2b08701-339a-4dfe-adfd-a9c35ecde51c\', \'multiverseId\': 175836}, \'multiverseid\': 175836}, {\'name\': \'Descomponerse\', \'text\': \'Remueve del juego hasta tres cartas objetivo de un solo cementerio.\', \'type\': \'Conjuro\', \'flavor\': \'"¡Caramba ¿Cómo se supone que voy a ganarme la vida en este lugar?" —Roba tumbas de la Cábala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177248&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7dce5a7a-2e85-4afb-852a-503908bec570\', \'multiverseId\': 177248}, \'multiverseid\': 177248}, {\'name\': \'Putrescence\', \'text\': "Retirez de la partie jusqu\'à trois cartes ciblées d\'un cimetière unique.", \'type\': \'Rituel\', \'flavor\': \'« Holà Comment vais-je pouvoir vivre décemment ici ? » —Un pilleur de tombes de la Coterie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176188&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a0915023-c911-4789-b23a-d6a7bd5b05e5\', \'multiverseId\': 176188}, \'multiverseid\': 176188}, {\'name\': \'Decomporre\', \'text\': \'Rimuovi dal gioco fino a tre carte bersaglio presenti in un singolo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Puah Come pensate che possa sopravvivere da queste parti?" —ladro di tombe della Cabala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176697&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8c353ad-4051-4d1c-892c-269fc4062583\', \'multiverseId\': 176697}, \'multiverseid\': 176697}, {\'name\': \'腐朽\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a78da912-40ed-4e1c-95f9-c04ff27f00fd\'}, \'multiverseid\': None}, {\'name\': \'Decompor\', \'text\': \'Remova de jogo até três cards alvo de um único cemitério.\', \'type\': \'Feitiço\', \'flavor\': \'"Silêncio Como achas que se pode ganhar a vida decentemente por aqui?" — Ladrão de túmulos da Cabala\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178691&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'80480671-589f-4ac1-a8d1-c0b836ad62d6\', \'multiverseId\': 178691}, \'multiverseid\': 178691}]', '[{\'name\': \'Verfluchte Monstrosität\', \'text\': \'Fliegend\\nImmer wenn die Verfluchte Monstrosität das Ziel eines Zauberspruchs oder einer Fähigkeit ist, opfere sie, falls du nicht ein Land aus deiner Hand abwirfst.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'„Lauf, Hans, lauf Es ist ein... ach egal, lauf" —Nomadenwachposten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175834&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b64c7e1-b834-48b3-917d-94d9f4d6ff62\', \'multiverseId\': 175834}, \'multiverseid\': 175834}, {\'name\': \'Monstruosidad maldita\', \'text\': \'Vuela.\\nSiempre que la Monstruosidad maldita sea objetivo de un hechizo o habilidad, sacrifícala a menos que descartes una carta de tierra de tu mano.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"¡Huyan ¡Es un . . . eh . . . huyan" —Centinela nómada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177246&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a01dd4a1-d45b-4799-980c-feac0902a58c\', \'multiverseId\': 177246}, \'multiverseid\': 177246}, {\'name\': \'Monstruosité maudite\', \'text\': "Vol\\nÀ chaque fois que la Monstruosité maudite devient la cible d\'un sort ou d\'une capacité, sacrifiez-la à moins que vous ne vous défaussiez d\'une carte de terrain de votre main.", \'type\': \'Créature : horreur\', \'flavor\': "« Courez C\'est un... une... courez » —Une sentinelle des nomades.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176186&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ba56cac-2dc3-481b-9558-fa4fa5d414b1\', \'multiverseId\': 176186}, \'multiverseid\': 176186}, {\'name\': \'Mostruosità Maledetta\', \'text\': "Volare\\nOgniqualvolta la Mostruosità Maledetta diventa bersaglio di una magia o di un\'abilità, sacrificala a meno che tu scarti una carta terra dalla tua mano.", \'type\': \'Creatura — Orrore\', \'flavor\': \'"Scappa È un. . . um . . . scappa" —sentinella nomade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176695&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0b64c0f-d661-42f4-888b-597a2d7b4de3\', \'multiverseId\': 176695}, \'multiverseid\': 176695}, {\'name\': \'呪われた大怪物\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'42641f29-7e16-4926-a28a-99326cbdd4ce\'}, \'multiverseid\': None}, {\'name\': \'Monstruosidade Amaldiçoada\', \'text\': \'Voar\\nToda vez que Monstruosidade Amaldiçoada for alvo de uma mágica ou de uma habilidade, sacrifique-a a não ser que você descarte de sua mão um card de terreno.\', \'type\': \'Criatura — Horror\', \'flavor\': \'"Corra É um... um... corra" — Sentinela nômade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178689&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a258757f-5986-4687-90b1-08efe6f73e2c\', \'multiverseId\': 178689}, \'multiverseid\': 178689}]', '[{\'name\': \'Vergeistigen\', \'text\': \'Immer wenn bis zum Ende des Zuges eine Kreatur deiner Wahl Schaden zufügt, erhältst du ebenso viele Lebenspunkte dazu.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Reinheit ist in allem, selbst im Hass." —Leutnant Kirtar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175761&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b410d962-f15a-42b7-95c2-5774632c7f89\', \'multiverseId\': 175761}, \'multiverseid\': 175761}, {\'name\': \'Espiritualizar\', \'text\': \'Hasta el final del turno, siempre que la criatura objetivo haga daño, ganas esa cantidad de vida.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Hay pureza en todas las cosas. Incluso en el odio." —Teniente Kírtar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177173&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4c9db27-c4d5-4948-803f-ef6a29eb1b87\', \'multiverseId\': 177173}, \'multiverseid\': 177173}, {\'name\': \'Spiritualisation\', \'text\': "Jusqu\'à la fin du tour, à chaque fois que la créature ciblée inflige des blessures, vous gagnez autant de points de vie.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'« Il y a de la pureté en toutes choses. Même dans la haine. » —Lieutenant Kirtar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176113&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'adf44e23-ffee-48a1-ace2-6646dbf59a39\', \'multiverseId\': 176113}, \'multiverseid\': 176113}, {\'name\': \'Spiritualizzare\', \'text\': \'Fino alla fine del turno, ogniqualvolta la creatura bersaglio infligge danno, guadagni un pari ammontare di punti vita.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"In tutte le cose c\\\'è purezza. Anche nell\\\'odio". —Luogotenente Kirtar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176622&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ec0e404f-be1f-4dc3-a029-e73ede53283b\', \'multiverseId\': 176622}, \'multiverseid\': 176622}, {\'name\': \'霊化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f9f35660-b5c4-48f8-9c0d-649376aa6d69\'}, \'multiverseid\': None}, {\'name\': \'Espiritualizar\', \'text\': \'Até o final do turno, toda vez que a criatura alvo causa dano, você ganha aquela quantidade de pontos de vida.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Há pureza em tudo. Até no ódio." — Tenente Kirtar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178616&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ebd8817c-07be-405c-ae0f-4d1420923e47\', \'multiverseId\': 178616}, \'multiverseid\': 178616}]', '[{\'name\': \'Verlangen des Patriarchen\', \'text\': \'Die verzauberte Kreatur erhält +2/-2\\nGrenzwert Die verzauberte Kreatur erhält zusätzlich +2/-2. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreaturenverzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175864&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e99d56e-a584-4821-8ec9-ebb52c662ac5\', \'multiverseId\': 175864}, \'multiverseid\': 175864}, {\'name\': \'Deseo del Patriarca\', \'text\': \'La criatura encantada obtiene +2/-2.\\nUmbral La criatura encantada obtiene +2/-2 adicionales. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Encantar criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177276&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'848d2211-4fb5-4924-a68d-5717171ed3b7\', \'multiverseId\': 177276}, \'multiverseid\': 177276}, {\'name\': \'Désir selon le Patriarche\', \'text\': "La créature enchantée gagne +2/-2.\\nSeuil — La créature enchantée gagne un +2/-2 supplémentaire. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Enchanter : créature\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176216&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4351a676-b2a5-4fbe-a53a-85f0a1ab7ba3\', \'multiverseId\': 176216}, \'multiverseid\': 176216}, {\'name\': \'Desiderio del Patriarca\', \'text\': \'La creatura incantata prende +2/-2.\\nSoglia La creatura incantata prende +2/-2 addizionale (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Incanta Creatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176725&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'17b17dc1-67c8-4589-9939-de7451765378\', \'multiverseId\': 176725}, \'multiverseid\': 176725}, {\'name\': \'総帥の願望\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5c376da-b600-4248-abed-f0e65027abbb\'}, \'multiverseid\': None}, {\'name\': \'Desejo do Patriarca\', \'text\': \'A criatura encantada recebe +2/-2.\\nLimiar — A criatura encantada recebe um +2/-2 adicional. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Encantar Criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178719&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5507f4f0-ddd1-408a-8422-d5d005e58dcb\', \'multiverseId\': 178719}, \'multiverseid\': 178719}]', "[{'name': 'Verlassener Tempel', 'text': '{T}: Erhöhe deinen Manavorrat um ein farbloses Mana.\\n{1}, {T}: Enttappe ein Land deiner Wahl.', 'type': 'Land', 'flavor': 'Einst ein Monument langvergessener Götter, dient er jetzt als ein Mahnmal an die Vergänglichkeit des menschlichen Seins.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176028&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a2992e01-91ed-4d11-8a01-9f9ec7de3791', 'multiverseId': 176028}, 'multiverseid': 176028}, {'name': 'Templo desierto', 'text': '{T}: Agrega un maná incoloro a tu reserva de maná.\\n{1}, {T}: Endereza la tierra objetivo.', 'type': 'Tierra', 'flavor': 'Es un monumento a dioses olvidados hace mucho tiempo que permanece como tributo a la naturaleza efímera de las costumbres humanas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177440&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd68229c7-2fee-4a12-b4d3-7c51e68f786d', 'multiverseId': 177440}, 'multiverseid': 177440}, {'name': 'Temple déserté', 'text': '{T}: Ajoutez un mana incolore à votre réserve.\\n{1}, {T}: Dégagez le terrain ciblé.', 'type': 'Terrain', 'flavor': 'Un monument à des dieux oubliés, un tribut à la versatilité humaine.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176380&type=card', 'language': 'French', 'identifiers': {'scryfallId': '61f76ce9-b415-49b5-8a47-c8ebfdc76222', 'multiverseId': 176380}, 'multiverseid': 176380}, {'name': 'Tempio Abbandonato', 'text': '{T}: Aggiungi un mana incolore alla tua riserva.\\n{1}, {T}: STAPpa una terra bersaglio.', 'type': 'Terra', 'flavor': 'Un monumento dedicato a divinità da tempo dimenticate, ora è un tributo alla natura mortale di tutto ciò che è umano.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176889&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4dadb250-923e-4ef6-adde-ff5b33989690', 'multiverseId': 176889}, 'multiverseid': 176889}, {'name': 'さびれた寺院', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '053d1691-52e4-4cef-8fcf-50ba1b470819'}, 'multiverseid': None}, {'name': 'Templo Deserto', 'text': '{T}: Adiciona uma mana incolor à sua reserva de mana.\\n{1}, {T}: Desvira o terreno alvo.', 'type': 'Terreno', 'flavor': 'Um monumento a deuses há muito esquecidos, ele assoma como um tributo à natureza volúvel dos costumes dos humanos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178883&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7fc328d7-41f5-4966-8f5b-81da268ce912', 'multiverseId': 178883}, 'multiverseid': 178883}]", "[{'name': 'Verrottender Riese', 'text': 'Immer wenn der Verrottende Riese angreift oder blockt, opfere ihn, falls du nicht eine Karte aus deinem Friedhof ganz aus dem Spiel entfernst.', 'type': 'Kreatur — Zombie, Riese', 'flavor': 'Bedeckt mit Moder mordet und zerstört er.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175866&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c564cfd4-8c19-4ca3-8cfc-55b4b5ad7f3a', 'multiverseId': 175866}, 'multiverseid': 175866}, {'name': 'Gigante pudriéndose', 'text': 'Siempre que el Gigante pudriéndose ataque o bloquee, sacrifícalo a menos que remuevas del juego una carta de tu cementerio.', 'type': 'Criatura — Gigante zombie', 'flavor': 'Atormentado por la podredumbre, derruye y arruina.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177278&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a0088d68-88c6-4455-aab6-403520474dec', 'multiverseId': 177278}, 'multiverseid': 177278}, {'name': 'Géant pourrissant', 'text': 'À chaque fois que le Géant pourris-sant attaque ou bloque, sacrifiez-le à moins que vous ne retiriez de la partie une carte de votre cimetière.', 'type': 'Créature : zombie et géant', 'flavor': 'Il précipite les ruines avec la sienne.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176218&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0370bedb-6b57-40da-9dd3-d7f645c896c9', 'multiverseId': 176218}, 'multiverseid': 176218}, {'name': 'Gigante in Decomposizione', 'text': 'Ogniqualvolta il Gigante in Decomposizione attacca o blocca, sacrificalo a meno che tu rimuova dal gioco una carta presente nel tuo cimitero.', 'type': 'Creatura — Gigante Zombie', 'flavor': 'Distrutto dalla putrefazione, sfascia e demolisce.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176727&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a2bf3d81-bad0-45d9-b0ba-360ab0207e7f', 'multiverseId': 176727}, 'multiverseid': 176727}, {'name': '朽ちゆく巨人', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5aaef5f5-2bac-4376-ae68-791b66f77882'}, 'multiverseid': None}, {'name': 'Gigante em Decomposição', 'text': 'Toda vez que Gigante em Decomposição atacar ou bloquear, sacrifique-o a não ser que você remova de jogo um card de seu cemitério.', 'type': 'Criatura — Gigante Zumbi', 'flavor': 'Deteriorado pela podridão, ele se decompõe em destruição.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178721&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '55dbf95a-92f0-481d-9078-885db19e1efa', 'multiverseId': 178721}, 'multiverseid': 178721}]", '[{\'name\': \'Verrückter Hund\', \'text\': \'Falls der Verrückte Hund nicht in diesem Zug unter deiner Kontrolle gekommen ist, opfere ihn am Ende deines Zuges, falls er in diesem Zug nicht angegriffen hat.\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Die Knochen, die er verbuddelt, könnten deine sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175910&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'295adbe2-f106-4b1d-aa3b-404aee0456dc\', \'multiverseId\': 175910}, \'multiverseid\': 175910}, {\'name\': \'Perro rabioso\', \'text\': \'Al final de tu turno, si el Perro rabioso no atacó o no entró bajo tu control este turno, sacrifícalo.\', \'type\': \'Criatura — Perro\', \'flavor\': \'Los huesos que entierra podrían ser los tuyos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177322&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93bff20e-63a7-4256-9904-810e57835126\', \'multiverseId\': 177322}, \'multiverseid\': 177322}, {\'name\': \'Chien fou\', \'text\': "À la fin de votre tour, si le Chien fou n\'a pas attaqué ou n\'est pas arrivé sous votre contrôle ce tour-ci, sacrifiez-le.", \'type\': \'Créature : chien de chasse\', \'flavor\': "Les os qu\'il enterre pourraient être les vôtres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176262&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5f803ab0-fa84-4226-a9f6-154e11874cfd\', \'multiverseId\': 176262}, \'multiverseid\': 176262}, {\'name\': \'Cane Pazzo\', \'text\': \'Alla fine del tuo turno, se il Cane Pazzo non ha attaccato o non è entrato sotto il tuo controllo in questo turno, sacrificalo.\', \'type\': \'Creatura — Segugio\', \'flavor\': \'Le ossa che seppellisce potrebbero essere le vostre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176771&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6f885968-f468-45b9-8835-f9227dac3449\', \'multiverseId\': 176771}, \'multiverseid\': 176771}, {\'name\': \'狂犬\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3c6e7f46-05e5-4d2a-91e9-5f75c1e1cc06\'}, \'multiverseid\': None}, {\'name\': \'Cachorro Louco\', \'text\': \'No final do seu turno, se Cachorro Louco não atacou nem veio para seu controle neste turno, sacrifique-o.\', \'type\': \'Criatura — Sabujo\', \'flavor\': \'Os ossos que ele enterra podem ser os teus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178765&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'680834b2-e5d6-45e7-8bba-3969841dc914\', \'multiverseId\': 178765}, \'multiverseid\': 178765}]', "[{'name': 'Versteinertes Feld', 'text': '{T}: Erhöhe deinen Manavorrat um ein farbloses Mana.\\n{T}, opfere das Versteinerte Feld: Bringe ein Land deiner Wahl aus deinem Friedhof auf deine Hand zurück.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176031&type=card', 'language': 'German', 'identifiers': {'scryfallId': '97ebb95b-ddd3-4816-84f9-76392895909b', 'multiverseId': 176031}, 'multiverseid': 176031}, {'name': 'Campo petrificado', 'text': '{T}: Agrega un maná incoloro a tu reserva de maná.\\n{T}, sacrificar el Campo petrificado: Regresa la carta objetivo de tierra de tu cementerio a tu mano.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177443&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2d87dba5-091a-46a9-a25a-a66e683b6a86', 'multiverseId': 177443}, 'multiverseid': 177443}, {'name': 'Champ pétrifié', 'text': '{T}: Ajoutez un mana incolore à votre réserve.\\n{T}, sacrifiez le Champ pétrifié : Renvoyez la carte de terrain ciblée depuis votre cimetière dans votre main.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176383&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b3285275-11a3-4b68-a21f-4b78bd5f95a5', 'multiverseId': 176383}, 'multiverseid': 176383}, {'name': 'Campo Pietrificato', 'text': '{T}: Aggiungi un mana incolore alla tua riserva.\\n{T}, Sacrifica il Campo Pietrificato: Riprendi in mano una carta terra bersaglio dal tuo cimitero.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176892&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '20bb479a-0950-47d5-8eba-4a706c8b075e', 'multiverseId': 176892}, 'multiverseid': 176892}, {'name': '石化した原野', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9a3227f8-a01c-42df-8e71-e0bb322d9b07'}, 'multiverseid': None}, {'name': 'Campo Petrificado', 'text': '{T}: Adiciona uma mana incolor à sua reserva de mana.\\n{T}, Sacrifique Campo Petrificado: Devolva para sua mão o card de terreno alvo de seu cemitério.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178886&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd50bfbd9-fd6e-417d-a284-b94f99921aaf', 'multiverseId': 178886}, 'multiverseid': 178886}]", '[{\'name\': \'Verunsichern\', \'text\': \'Ein Spieler deiner Wahl zeigt die obersten vier Karten seiner Bibliothek offen vor. Bestimme zwei dieser Karten und lege sie auf den Friedhof dieses Spielers. Lege die restlichen Karten in beliebiger Reihenfolge oben auf seine Bibliothek zurück.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175776&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'283c8971-f116-4904-a535-7af0303e259c\', \'multiverseId\': 175776}, \'multiverseid\': 175776}, {\'name\': \'Timar\', \'text\': \'El jugador objetivo muestra las primeras cuatro cartas de la parte superior de su biblioteca. Tú eliges dos de esas cartas y las pones en su cementerio. Pon el resto en la parte superior de su biblioteca en cualquier orden.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177188&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2be3cc4f-33c0-4dd5-b95b-e7f3ecde2a36\', \'multiverseId\': 177188}, \'multiverseid\': 177188}, {\'name\': \'Duperie\', \'text\': "Le joueur ciblé révèle les quatre cartes du dessus de sa bibliothèque. Vous choisissez deux de ces cartes et les mettez dans son cimetière. Mettez les autres au-dessus de sa bibliothèque dans l\'ordre de votre choix.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176128&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3aa4b0df-e1a3-467c-be2c-d2859428077d\', \'multiverseId\': 176128}, \'multiverseid\': 176128}, {\'name\': \'Turlupinare\', \'text\': "Il giocatore bersaglio rivela le prime quattro carte del proprio grimorio. Scegli due di quelle carte e mettile nel suo cimitero. Metti le rimanenti in cima al suo grimorio nell\'ordine che preferisci.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176637&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37bfae81-cdef-480d-b2ac-ac4a2be705c9\', \'multiverseId\': 176637}, \'multiverseid\': 176637}, {\'name\': \'だまし\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e2bc2080-0ea4-4bf2-b0c9-aafcb16f994b\'}, \'multiverseid\': None}, {\'name\': \'Lograr\', \'text\': \'O jogador alvo revela os quatro primeiros cards de seu próprio grimório. Você escolhe dois desses cards e os coloca no cemitério dele. Coloque o resto no topo do grimório dele em qualquer ordem.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178631&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'937c39bf-932a-4561-8d83-4b6b445abee5\', \'multiverseId\': 178631}, \'multiverseid\': 178631}]', '[{\'name\': \'Verwesende Erde\', \'text\': \'Entferne zu Beginn deines Versorgungssegments eine Karte aus deinem Friedhof ganz aus dem Spiel.\\nGrenzwert Immer wenn eine Nicht-Spielsteinkreatur aus dem Spiel auf deinen Friedhof gelegt wird, kannst du {1} bezahlen. Falls du dies tust, bringe jene Karte auf deine Hand zurück. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175835&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'912508b0-4020-4d16-b97e-7cf0f332fac1\', \'multiverseId\': 175835}, \'multiverseid\': 175835}, {\'name\': \'Tierra pútrida\', \'text\': \'Al comienzo de tu mantenimiento, remueve del juego una carta de tu cementerio.\\nUmbral Siempre que una criatura que no sea ficha vaya a tu cementerio desde el juego, puedes pagar {1}. Si lo haces, regresa esa carta a tu mano. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177247&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a67f3066-3c0a-401b-ad73-6a4b20ecbf0f\', \'multiverseId\': 177247}, \'multiverseid\': 177247}, {\'name\': \'Sol en décomposition\', \'text\': "Au début de votre entretien, retirez de la partie une carte de votre cimetière.\\nSeuil — À chaque fois qu\'une créature non-jeton est mise dans votre cimetière depuis le jeu, vous pouvez payer {1}. Si vous faites ainsi, renvoyez cette carte dans votre main. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176187&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'338a049d-fa3a-41c2-84f5-9ed3edfc8bce\', \'multiverseId\': 176187}, \'multiverseid\': 176187}, {\'name\': \'Terreno Putrescente\', \'text\': "All\'inizio del tuo mantenimento, rimuovi dal gioco una carta presente nel tuo cimitero.\\nSoglia Ogniqualvolta una creatura non pedina viene messa nel tuo cimitero dal gioco, puoi spendere {1}. Se lo fai, riprendi in mano quella carta. (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176696&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b1b5dbb2-f345-445f-8355-04b0ad35b9be\', \'multiverseId\': 176696}, \'multiverseid\': 176696}, {\'name\': \'衰微する土\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'784ab626-3626-4078-aca4-2e1d765079ec\'}, \'multiverseid\': None}, {\'name\': \'Solo Decadente\', \'text\': \'No início de sua manutenção, remova de jogo um card de seu cemitério.\\nLimiar — Toda vez que uma criatura que não seja uma ficha for colocada em seu cemitério vinda de jogo, você pode pagar {1}. Se o fizer, devolva aquele card para sua mão. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178690&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7e0a23ff-661b-495d-86e0-967188d23409\', \'multiverseId\': 178690}, \'multiverseid\': 178690}]', '[{\'name\': \'Verwüstetes Hochland\', \'text\': \'Das Verwüstete Hochland kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {R}.\\n{T}, opfere das Verwüstete Hochland: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176032&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81a99583-3ab4-4c2c-993c-1b0885315312\', \'multiverseId\': 176032}, \'multiverseid\': 176032}, {\'name\': \'Tierras altas devastadas\', \'text\': \'Las Tierras altas devastadas entran en juego giradas.\\n{T}: Agrega {R} a tu reserva de maná.\\n{T}, sacrificar las Tierras altas devastadas: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177444&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'844b6a1d-e448-41aa-bcb3-53a01f06cf64\', \'multiverseId\': 177444}, \'multiverseid\': 177444}, {\'name\': \'Hautes terres dévastées\', \'text\': \'Ces Hautes terres dévastées arrivent en jeu engagées.\\n{T} : Ajoutez {R} à votre réserve.\\n{T}, sacrifiez ces Hautes terres dévastées: Ajoutez un mana de la couleur de votre choix à votre réserve.\', \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176384&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ef9e627-d57e-40d6-b0c3-07255d12a0ae\', \'multiverseId\': 176384}, \'multiverseid\': 176384}, {\'name\': \'Altopiano in Rovina\', \'text\': "L\'Altopiano in Rovina entra in gioco TAPpato.\\n{T}: Aggiungi {R} alla tua riserva di mana.\\n{T}, Sacrifica l\'Altopiano in Rovina: Aggiungi un mana di un qualsiasi colore alla tua riserva.", \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176893&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8366760-804c-47bd-96be-d16d4c3c5cec\', \'multiverseId\': 176893}, \'multiverseid\': 176893}, {\'name\': \'荒らされた高地\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'655cbdaf-a675-4f77-9012-7ac7b6027427\'}, \'multiverseid\': None}, {\'name\': \'Planalto Devastado\', \'text\': \'Planalto Devastado entra em jogo virado.\\n{T}: Adiciona {R} à sua reserva de mana.\\n{T}, Sacrifique Planalto Devastado: Adiciona uma mana de qualquer cor a sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178887&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d73f9e5-26bc-43a3-83bd-54087f135422\', \'multiverseId\': 178887}, \'multiverseid\': 178887}]', '[{\'name\': \'Verzögernder Schild\', \'text\': \'Falls dir Schaden zugefügt würde, lege stattdessen ebenso viele Verzögerungsmarken auf den Verzögernden Schild.\\nEntferne zu Beginn deines Versorgungssegments alle Verzögerungsmarken vom Verzögernden Schild. Du verlierst für jede Verzögerungsmarke, die auf diese Weise entfernt wird, 1 Lebenspunkt, wenn du nicht für sie {1}{W} bezahlst.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175725&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'150f8b89-2ada-4cf2-966e-ba469f379342\', \'multiverseId\': 175725}, \'multiverseid\': 175725}, {\'name\': \'Escudo dilatorio\', \'text\': \'Si se te fuera a hacer daño, en vez de eso, pon ese mismo número de contadores de dilación sobre el Escudo dilatorio.\\nAl comienzo de tu mantenimiento, remueve todos los contadores de dilación del Escudo Dilatorio. Por cada contador removido de esta manera, pierde 1 vida a menos que pagues {1}{W}.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177137&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0aa21715-a7f4-45a5-8d51-d21090d857d8\', \'multiverseId\': 177137}, \'multiverseid\': 177137}, {\'name\': \'Bouclier retardateur\', \'text\': \'Si vous deviez vous voir infliger des blessures, mettez à la place autant de marqueurs « retard» sur le Bouclier retardateur.\\nAu début de votre entretien, retirez tous les marqueurs « retard » du Bouclier retardateur. Pour chaque marqueur « retard » retiré de cette manière, vous perdez 1 point de vie à moins que vous ne payiez {1}{W}.\', \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176077&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'57420b95-87c4-48c8-9b2f-5c098206d189\', \'multiverseId\': 176077}, \'multiverseid\': 176077}, {\'name\': \'Scudo Ritardante\', \'text\': "Se ti viene inflitto del danno, metti invece sullo Scudo Ritardante un numero di segnalini ritardo pari all\'ammontare del danno.\\nAll\'inizio del tuo mantenimento, rimuovi dallo Scudo Ritardante tutti i segnalini ritardo. Per ogni segnalino ritardo rimosso in questo modo, perdi 1 punto vita a meno che tu spenda {1}{W}.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176586&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c8ef3309-461a-4e7e-b9b7-4f9028762df0\', \'multiverseId\': 176586}, \'multiverseid\': 176586}, {\'name\': \'遅延の盾\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85393725-b421-417d-b4f9-b83110de40e7\'}, \'multiverseid\': None}, {\'name\': \'Escudo Retardador\', \'text\': \'Se você fosse receber dano, ao invés disso coloque tantos marcadores de atraso em Escudo Retardador quanto os pontos de dano que lhe seriam causados.\\nNo início de sua manutenção, remova todos os marcadores de atraso de Escudo Retardador. Para cada marcador removido dessa maneira, você perde 1 ponto de vida a não ser que você pague {1}{W}.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178580&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23468685-bec0-40ce-ba44-c27b79b65a34\', \'multiverseId\': 178580}, \'multiverseid\': 178580}]', "[{'name': 'Vorhersagen', 'text': 'Benenne eine Karte und lege dann die oberste Karte der Bibliothek eines Spielers deiner Wahl auf dessen Friedhof. Falls diese Karte die genannte Karte ist, ziehe zwei Karten. Ziehe sonst eine Karte.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175802&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e7767bd6-ba43-4a64-b125-537c96919785', 'multiverseId': 175802}, 'multiverseid': 175802}, {'name': 'Predecir', 'text': 'Nombra una carta, luego pon la carta de la parte superior de la biblioteca del jugador objetivo en su cementerio. Si esa carta es la carta nombrada, robas dos cartas. Si no lo es, robas una carta.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177214&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3198f18b-1206-4793-ac84-0c4e61e0c6f6', 'multiverseId': 177214}, 'multiverseid': 177214}, {'name': 'Prédiction', 'text': 'Nommez une carte, puis mettez la carte du dessus de la bibliothèque du joueur ciblé dans son cimetière. Si cette carte est la carte nommée, vous piochez deux cartes ; sinon, vous piochez une carte.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176154&type=card', 'language': 'French', 'identifiers': {'scryfallId': '72301436-85b9-4185-b1ff-c43d9e1da156', 'multiverseId': 176154}, 'multiverseid': 176154}, {'name': 'Profetizzare', 'text': 'Nomina una carta, poi metti la prima carta del grimorio di un giocatore bersaglio nel suo cimitero. Se quella carta è la carta che hai nominato, peschi due carte. Altrimenti, peschi una carta.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176663&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1e752fae-842d-4697-a8df-d50d67ff98ad', 'multiverseId': 176663}, 'multiverseid': 176663}, {'name': '予報', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '11f1092f-96ec-47e2-b324-d4a4500e9904'}, 'multiverseid': None}, {'name': 'Predizer', 'text': 'Nomeie um card e depois coloque o card do topo do grimório do jogador alvo no cemitério dele. Se aquele card for o card nomeado, você compra dois cards. Caso contrário, você compra um card.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178657&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c869a40d-9dc5-40a3-8332-510e34d852a2', 'multiverseId': 178657}, 'multiverseid': 178657}]", "[{'name': 'Vulkanische Spritzer', 'text': 'Die Vulkanischen Spritzer fügen jeder nichtfliegenden Kreatur und jedem Spieler 1 Schadenspunkt zu.\\nRückblende {1}{R} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175934&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6095583a-2622-4e3d-aa9b-d213dc773aa7', 'multiverseId': 175934}, 'multiverseid': 175934}, {'name': 'Rocío volcánico', 'text': 'El Rocío volcánico hace 1 punto de daño a cada criatura que no tenga la habilidad de volar y a cada jugador.\\nRetrospectiva {1}{R}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177346&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7f8dea1d-6129-423f-8cd8-c6c96d880e7d', 'multiverseId': 177346}, 'multiverseid': 177346}, {'name': 'Giclée volcanique', 'text': 'La Giclée volcanique inflige 1 blessure à chaque créature sans le vol et à chaque joueur.\\nFlashback {1}{R} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176286&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7e96e10d-ee22-4ddb-b5d2-e8e53aedcbeb', 'multiverseId': 176286}, 'multiverseid': 176286}, {'name': 'Getto Vulcanico', 'text': 'Il Getto Vulcanico infligge 1 danno a ogni creatura senza volare e a ogni giocatore.\\nFlashback {1}{R} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176795&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '37e61e37-c7f4-44b3-8695-06f6b988a310', 'multiverseId': 176795}, 'multiverseid': 176795}, {'name': '溶岩の飛散', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '78fadf6c-6de9-4632-83fd-d0de50e2fe4b'}, 'multiverseid': None}, {'name': 'Jorro Vulcânico', 'text': 'Jorro Vulcânico causa 1 ponto de dano a cada criatura sem a habilidade de voar e a cada jogador.\\nRecapitular {1}{R} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178789&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b7c0d73b-4b8d-4b3f-b31b-3ca00ba0edf3', 'multiverseId': 178789}, 'multiverseid': 178789}]", '[{\'name\': \'Wahnsinniger Barbar\', \'text\': \'{2}{R}, opfere den Wahnsinnigen Barbar: Der Wahnsinnige Barbar fügt einer Kreatur deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Barbar\', \'flavor\': \'„Ich habe einmal einen einzelnen Barbaren gesehen, der es mit einer Gruppe von zwanzig Nomaden aufgenommen hat. Ich hab aber auch schon andere Verrückte gesehen." —Nomadenwachposten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175883&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24252389-65b6-41e1-bd72-9b20fed37dd5\', \'multiverseId\': 175883}, \'multiverseid\': 175883}, {\'name\': \'Bárbaro lunático\', \'text\': \'{2}{R}, sacrificar el Bárbaro lunático: El Bárbaro lunático hace 2 puntos de daño a la criatura objetivo.\', \'type\': \'Criatura — Bárbaro\', \'flavor\': \'"Una vez vi a un bárbaro cargar contra una banda de veinte nómadas. También he visto a algunos locos." —Centinela nómada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177295&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f9017eb-eb5e-42cb-a65e-2e4dcc0a82d2\', \'multiverseId\': 177295}, \'multiverseid\': 177295}, {\'name\': \'Barbare dément\', \'text\': \'{2}{R}, sacrifiez le Barbare dément : Le Barbare dément inflige 2 blessures à la créature ciblée.\', \'type\': \'Créature : barbare\', \'flavor\': "« J\'ai vu, de mes yeux vu, un barbare charger une bande de vingt nomades. Et celui là n\'était qu\'à demi fou. » —Une sentinelle des nomades.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176235&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'853f7e7f-9c6f-46e0-91e9-af3cd1d7fb13\', \'multiverseId\': 176235}, \'multiverseid\': 176235}, {\'name\': \'Barbaro Lunatico\', \'text\': \'{2}{R}, Sacrifica il Barbaro Lunatico: Il Barbaro Lunatico infligge 2 danni a una creatura bersaglio.\', \'type\': \'Creatura — Barbaro\', \'flavor\': \'"Una volta ho visto un solo barbaro caricare una banda di venti nomadi. E poi ne ho visti anche alcuni pazzi". —sentinella nomade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176744&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e0e83b03-29d3-4b31-a956-3dc9cec8a363\', \'multiverseId\': 176744}, \'multiverseid\': 176744}, {\'name\': \'蛮族の狂人\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'054d4d0c-065f-4d8c-8c4e-cc4e7aca402c\'}, \'multiverseid\': None}, {\'name\': \'Bárbaro Lunático\', \'text\': \'{2}{R}, Sacrifique Bárbaro Lunático: Bárbaro Lunático causa 2 pontos de dano à criatura alvo.\', \'type\': \'Criatura — Bárbaro\', \'flavor\': \'"Uma vez eu vi um bárbaro atacar sozinho um bando de vinte nômades. Já vi algumas maluquices também." — Sentinela nômade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178738&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5cafb957-1cf4-48ac-b892-ed84079bd0fb\', \'multiverseId\': 178738}, \'multiverseid\': 178738}]', "[{'name': 'Wald', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176055&type=card', 'language': 'German', 'identifiers': {'scryfallId': '690f2681-73c9-4335-8795-2b856b34e09b', 'multiverseId': 176055}, 'multiverseid': 176055}, {'name': 'Bosque', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177467&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e0007004-8ed5-48b1-bcd2-d73d445be293', 'multiverseId': 177467}, 'multiverseid': 177467}, {'name': 'Forêt', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176407&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fc9ce8e5-c2be-465f-bd54-350b517973ab', 'multiverseId': 176407}, 'multiverseid': 176407}, {'name': 'Foresta', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176916&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f95b40e2-e1c3-4937-84a8-6541badf0587', 'multiverseId': 176916}, 'multiverseid': 176916}, {'name': '森', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'a2bfc524-6edb-468b-b35c-67926a9a04a2'}, 'multiverseid': None}, {'name': 'Floresta', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178910&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scr