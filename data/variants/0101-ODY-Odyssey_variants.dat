'name': 'Montanha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178907&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3a3a4a59-0723-4028-9304-09a8758afa52', 'multiverseId': 178907}, 'multiverseid': 178907}]", "[{'name': 'Gebirge', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176053&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b8eacccb-aad1-4278-bf31-304ec6f209d6', 'multiverseId': 176053}, 'multiverseid': 176053}, {'name': 'Montaña', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177465&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f8c46bf0-6d86-4b11-a251-fb044c7de9f3', 'multiverseId': 177465}, 'multiverseid': 177465}, {'name': 'Montagne', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176405&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c7816b6b-6019-4fe5-8607-c03232d37d8f', 'multiverseId': 176405}, 'multiverseid': 176405}, {'name': 'Montagna', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176914&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '07b15563-b6b3-4246-a3cd-fe58ca76820d', 'multiverseId': 176914}, 'multiverseid': 176914}, {'name': '山', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd26290bf-dedd-426e-85e6-81431d80de8a'}, 'multiverseid': None}, {'name': 'Montanha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178908&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '358c82a1-be9d-48d5-92cf-1649c23acc6d', 'multiverseId': 178908}, 'multiverseid': 178908}]", "[{'name': 'Gebirge', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176054&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bd502364-4e9b-4478-9fe4-4862dabfb8ef', 'multiverseId': 176054}, 'multiverseid': 176054}, {'name': 'Montaña', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177466&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c83a8343-f0fc-4034-b014-14d481bba22a', 'multiverseId': 177466}, 'multiverseid': 177466}, {'name': 'Montagne', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176406&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'f2b67068-d18e-42d5-9733-341e50581f1b', 'multiverseId': 176406}, 'multiverseid': 176406}, {'name': 'Montagna', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176915&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9e26fdc3-8af4-4544-8c7e-ee2aa0c6a419', 'multiverseId': 176915}, 'multiverseid': 176915}, {'name': '山', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e5a14530-510d-42f7-94cf-2e8d398595db'}, 'multiverseid': None}, {'name': 'Montanha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178909&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e9cebda8-9288-4783-859f-f0725946e5e3', 'multiverseId': 178909}, 'multiverseid': 178909}]", '[{\'name\': \'Gedankenflucht\', \'text\': \'Ein Spieler deiner Wahl wirft X Karten aus seiner Hand ab, wobei X eins plus die Anzahl an GedankenfluchtKarten in allen Friedhöfen ist.\', \'type\': \'Hexerei\', \'flavor\': \'So gruselig wie der Fluch eines Zombies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175856&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47fdc92b-a923-4469-8053-2676b7ca8d1a\', \'multiverseId\': 175856}, \'multiverseid\': 175856}, {\'name\': \'Estallido mental\', \'text\': \'El jugador objetivo descarta X cartas de su mano, donde X es 1 más el número de cartas de Estallido mental que haya en todos los cementerios.\', \'type\': \'Conjuro\', \'flavor\': \'Tan perturbador como la maldición de un zombie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177268&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'324eacd9-678e-40e4-add3-c54721a9caeb\', \'multiverseId\': 177268}, \'multiverseid\': 177268}, {\'name\': \'Explosion cérébrale\', \'text\': "Le joueur ciblé se défausse de X cartes de sa main, où X est égal à un plus le nombre de cartes d\'Explosion cérébrale dans tous les cimetières.", \'type\': \'Rituel\', \'flavor\': "Aussi implacable que la malédiction d\'un zombie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176208&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'341ef0e5-8d47-4e80-9e88-f10fc871719b\', \'multiverseId\': 176208}, \'multiverseid\': 176208}, {\'name\': \'Esplosione Mentale\', \'text\': \'Il giocatore bersaglio scarta X carte dalla propria mano, dove X è pari a uno più il numero di carte Esplosione Mentale presenti in tutti i cimiteri.\', \'type\': \'Stregoneria\', \'flavor\': \'Ossessionante come la maledizione di uno zombie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176717&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb36cd22-9cd3-41ee-9933-8de1d10da614\', \'multiverseId\': 176717}, \'multiverseid\': 176717}, {\'name\': \'精神噴出\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb2f41b5-8915-4fb4-bf82-e6305243a184\'}, \'multiverseid\': None}, {\'name\': \'Explosão Mental\', \'text\': \'O jogador alvo descarta X cards de sua própria mão, onde X é igual a um mais o número de cards de Explosão Mental em todos os cemitérios.\', \'type\': \'Feitiço\', \'flavor\': \'Tão assustadora quanto a maldição de um zumbi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178711&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffe349ec-3814-4cab-9152-3551bcc1bccf\', \'multiverseId\': 178711}, \'multiverseid\': 178711}]', '[{\'name\': \'Gedankenfutterer\', \'text\': \'Fliegend\\nDeine maximale Handkartenzahl ist um drei reduziert.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Das allererste, was es aus dem Gedächtnis seines Opfers herausfischt, ist, wie man es loswerden kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175814&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ad00af8-3314-4360-8543-a7714084da4c\', \'multiverseId\': 175814}, \'multiverseid\': 175814}, {\'name\': \'Comepensamientos\', \'text\': \'Vuela.\\nEl tamaño máximo de tu mano se reduce en tres.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'El primer recuerdo que absorbe de su huésped es cómo deshacerse de él.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177226&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af17b417-a75f-476f-abd9-1375e0becc62\', \'multiverseId\': 177226}, \'multiverseid\': 177226}, {\'name\': \'Mangeur de pensées\', \'text\': \'Vol\\nLa taille maximale de votre main est réduite de trois.\', \'type\': \'Créature : bête\', \'flavor\': "Le premier souvenir qu\'il vous vole, c\'est celui qui vous aurait permis de vous débarrasser de lui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176166&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'31238c75-e862-4693-aa42-3d0e94be134d\', \'multiverseId\': 176166}, \'multiverseid\': 176166}, {\'name\': \'Mangiapensieri\', \'text\': \'Volare\\nIl numero massimo di carte che puoi tenere in mano è ridotto di tre.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'La prima memoria che succhia via è come sbarazzarsi di lui.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176675&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dd84fe65-33aa-4221-bd8e-07f320fe5e52\', \'multiverseId\': 176675}, \'multiverseid\': 176675}, {\'name\': \'思考を食うもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8651312c-7c4f-41df-8f12-cf6b612b7904\'}, \'multiverseid\': None}, {\'name\': \'Engolidor de Pensamentos\', \'text\': \'Voar\\nO número máximo permitido de cards em sua mão é reduzido em três.\', \'type\': \'Criatura — Besta\', \'flavor\': \'A primeira memória que ele suga de seu hospedeiro é a de como se livrar dele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178669&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'14fe9fb8-d155-4d1b-b13c-1ae6eda81f91\', \'multiverseId\': 178669}, \'multiverseid\': 178669}]', "[{'name': 'Gedankenknabberer', 'text': 'Fliegend\\nDeine maximale Handkartenzahl ist um zwei reduziert.', 'type': 'Kreatur — Bestie', 'flavor': 'Balshanische Zauberer nutzten sie lange Zeit, um unerwünschte Erinnerungen wegzunagen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175815&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5862a167-4a3d-4053-9e97-43c35fb6e26c', 'multiverseId': 175815}, 'multiverseid': 175815}, {'name': 'Roepensamientos', 'text': 'Vuela.\\nEl tamaño máximo de tu mano se reduce en dos.', 'type': 'Criatura — Bestia', 'flavor': 'Los hechiceros de Balshan los han usado desde hace mucho tiempo para deshacerse de los recuerdos que desean olvidar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177227&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2c44ecff-fce0-444f-aa3f-1e993f617337', 'multiverseId': 177227}, 'multiverseid': 177227}, {'name': 'Grignoteur de pensées', 'text': 'Vol\\nLa taille maximale de votre main est réduite de deux.', 'type': 'Créature : bête', 'flavor': 'Les sorciers du Balshan les ont longtemps utilisés pour effacer quelques souvenirs indésirables.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176167&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ab305120-df4a-4505-b7fa-6d7ea0272bf6', 'multiverseId': 176167}, 'multiverseid': 176167}, {'name': 'Corrodipensiero', 'text': 'Volare\\nIl numero massimo di carte che puoi tenere in mano è ridotto di due.', 'type': 'Creatura — Bestia', 'flavor': 'I maghi di Balshan li usano da tempo per rimuovere i ricordi che vogliono dimenticare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176676&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '81442cf2-ef28-4f2d-8ae0-8288a41f99eb', 'multiverseId': 176676}, 'multiverseid': 176676}, {'name': '思考をかじるもの', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '7e6adc6b-7524-487b-991a-d6ebfb5bf443'}, 'multiverseid': None}, {'name': 'Mordiscador de Pensamentos', 'text': 'Voar\\nO número máximo permitido de cards em sua mão é reduzido em dois.', 'type': 'Criatura — Besta', 'flavor': 'Os magos balshanos os têm usado há muito tempo para corroer as memórias que desejam esquecer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178670&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c2e41073-416a-4282-b32e-9ff44ed4750d', 'multiverseId': 178670}, 'multiverseid': 178670}]", '[{\'name\': \'Gedankenverschlinger\', \'text\': \'Fliegend\\nDeine maximale Handkartenzahl ist um vier reduziert.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Denken fällt schwer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175813&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c28096d-1f18-426e-8941-f934ea733cfd\', \'multiverseId\': 175813}, \'multiverseid\': 175813}, {\'name\': \'Devorapensamientos\', \'text\': \'Vuela.\\nEl tamaño máximo de tu mano se reduce en cuatro.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Pensar es difícil.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177225&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be9e971b-6326-4d8c-b69d-3045853746d6\', \'multiverseId\': 177225}, \'multiverseid\': 177225}, {\'name\': \'Dévoreur de pensées\', \'text\': \'Vol\\nLa taille maximale de votre main est réduite de quatre.\', \'type\': \'Créature : bête\', \'flavor\': "Penser, c\'est dur, et ça fatigue.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176165&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b76fe83b-e0dc-4202-b5fa-3eb45bd7e04d\', \'multiverseId\': 176165}, \'multiverseid\': 176165}, {\'name\': \'Divorapensieri\', \'text\': \'Volare\\nIl numero massimo di carte che puoi tenere in mano è ridotto di quattro.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Pensare è difficile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176674&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6e1a6d41-6b53-4bcb-9ec1-49d03c68f798\', \'multiverseId\': 176674}, \'multiverseid\': 176674}, {\'name\': \'思考を貪るもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1626d687-29ea-4f84-85b7-4dfd15d22c50\'}, \'multiverseid\': None}, {\'name\': \'Devorador de Pensamentos\', \'text\': \'Voar\\nO número máximo permitido de cards em sua mão é reduzido em quatro.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Pensar é difícil.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178668&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a31d4df-2346-4328-9019-43feaeb39429\', \'multiverseId\': 178668}, \'multiverseid\': 178668}]', '[{\'name\': \'Gehirnzerschneider\', \'text\': \'Wenn der Gehirnzerschneider aus dem Spiel auf einen Friedhof gelegt wird, werfen alle Spieler die Karten auf ihrer Hand ab.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': \'Manche merken zu spät, dass tatsächlich Monster unterm Bett leben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175857&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'edfcec85-9828-4cfc-960d-d2e0b90b7955\', \'multiverseId\': 175857}, \'multiverseid\': 175857}, {\'name\': \'Rebanamentes\', \'text\': \'Cuando el Rebanamentes vaya a un cementerio desde el juego, cada jugador descarta su mano.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Ésa es la cosa que hace ruidos misteriosos en la noche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177269&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'480c809f-6e91-4361-b70b-a52b82aa177d\', \'multiverseId\': 177269}, \'multiverseid\': 177269}, {\'name\': \'Cérébrotrancheur\', \'text\': \'Quand le Cérébrotrancheur est mis dans un cimetière depuis le jeu, chaque joueur se défausse de sa main.\', \'type\': \'Créature : horreur\', \'flavor\': "« Les biens de la terre ne font que creuser l\'âme et en augmenter le vide (...) »— Chateaubriand.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176209&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ebe86190-39db-4db1-b99a-e934fab6a928\', \'multiverseId\': 176209}, \'multiverseid\': 176209}, {\'name\': \'Squarta Menti\', \'text\': \'Quando lo Squarta Menti viene messo in un cimitero dal gioco, ogni giocatore scarta la propria mano.\', \'type\': \'Creatura — Orrore\', \'flavor\': \'Questa è la cosa che si annida nella notte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176718&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2d0db449-ff61-4b92-81f3-b46342bd7315\', \'multiverseId\': 176718}, \'multiverseid\': 176718}, {\'name\': \'精神を刻むもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1018a495-fbb2-41bc-92c5-a576b3a887b6\'}, \'multiverseid\': None}, {\'name\': \'Fatiador de Mentes\', \'text\': \'Quando Fatiador de Mentes for colocado num cemitério vindo de jogo, cada jogador descarta sua própria mão.\', \'type\': \'Criatura — Horror\', \'flavor\': \'Ele é a coisa que faz ruídos arrepiantes na noite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178712&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ca0af3d5-3dc9-409c-973a-6ed456ba661d\', \'multiverseId\': 178712}, \'multiverseid\': 178712}]', '[{\'name\': \'Geistiges Duell\', \'text\': \'Falls du zu Beginn deines Versorgungssegments 200 oder mehr Karten in deiner Bibliothek hast, gewinnst du das Spiel.\', \'type\': \'Verzauberung\', \'flavor\': \'Ein Zauberer, der tausend Bücher gelesen hat, ist mächtig. Ein Zauberer, der tausend Bücher auswendig gelernt hat, ist irre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175777&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e39d05eb-2c5b-4166-a10d-a5676c4910ce\', \'multiverseId\': 175777}, \'multiverseid\': 175777}, {\'name\': \'Batalla de ingenio\', \'text\': \'Al comienzo de tu mantenimiento, si tienes 200 ó más cartas en tu biblioteca, ganas el juego.\', \'type\': \'Encantamiento\', \'flavor\': \'El hechicero que lee mil libros es poderoso. El hechicero que memoriza mil libros está loco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177189&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4cefa8ec-246c-4d3b-922f-b3195900e184\', \'multiverseId\': 177189}, \'multiverseid\': 177189}, {\'name\': "Jeu d\'esprits", \'text\': \'Au début de votre entretien, si vous avez 200 cartes ou plus dans votre bibliothèque, vous gagnez la partie.\', \'type\': \'Enchantement\', \'flavor\': "Le magicien qui a lu un millier d\'ouvrages est puissant. Le magicien qui a mémorisé un millier d\'ouvrages est fou.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176129&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdcd9547-5793-4fad-9359-68306a90c83f\', \'multiverseId\': 176129}, \'multiverseid\': 176129}, {\'name\': \'Scontro di Intelletti\', \'text\': "All\'inizio del tuo mantenimento, se hai almeno 200 carte nel tuo grimorio, vinci la partita.", \'type\': \'Incantesimo\', \'flavor\': \'Il mago che legge un migliaio di libri è potente. Il mago che impara a memoria un migliaio di libri è folle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176638&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97826456-823f-4aa3-898b-7128f85655ca\', \'multiverseId\': 176638}, \'multiverseid\': 176638}, {\'name\': \'機知の戦い\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cbcf2f70-a9cd-4fca-8ffa-11001da4b26d\'}, \'multiverseid\': None}, {\'name\': \'Batalha de Raciocínio\', \'text\': \'No início de sua manutenção, se você tiver 200 ou mais cards em seu grimório, você vence o duelo.\', \'type\': \'Encantamento\', \'flavor\': \'O mago que lê mil livros é poderoso. O mago que memoriza mil livros é demente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178632&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dfbdccc8-6b09-48eb-900f-f6b69709b15f\', \'multiverseId\': 178632}, \'multiverseid\': 178632}]', '[{\'name\': \'Gerechtigkeit des Schicksals\', \'text\': \'Immer wenn ein Zauberspruch oder eine Fähigkeit, die ein Gegner kontrolliert, eine bleibende Karte, die du kontrollierst und die keine Kreatur ist, zerstört, kannst du eine bleibende Karte deiner Wahl, die dieser Gegner kontrolliert, zerstören.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175734&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8ec7f5c6-3154-4b78-aeee-bf3990b396a4\', \'multiverseId\': 175734}, \'multiverseid\': 175734}, {\'name\': \'Justicia kármica\', \'text\': \'Siempre que un hechizo o habilidad que controle un oponente destruya un permanente que controles que no sea criatura, puedes destruir el permanente objetivo que controle ese oponente.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177146&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b8416607-08c4-43dd-9718-b743d552044b\', \'multiverseId\': 177146}, \'multiverseid\': 177146}, {\'name\': \'Justice karmique\', \'text\': "À chaque fois qu\'un sort ou une capacité qu\'un adversaire contrôle détruit un permanent non-créature que vous contrôlez, vous pouvez détruire un permanent ciblé que cet adversaire contrôle.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176086&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6af2239-0102-46c2-8103-8cd9be76abe2\', \'multiverseId\': 176086}, \'multiverseid\': 176086}, {\'name\': \'Giustizia Karmica\', \'text\': "Ogniqualvolta una magia o un\'abilità controllata da un avversario distrugge un permanente non creatura che controlli, puoi distruggere un permanente bersaglio controllato da quell\'avversario.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176595&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'21863307-da23-4cfe-89d8-3dbc58c36a44\', \'multiverseId\': 176595}, \'multiverseid\': 176595}, {\'name\': \'霊体の正義\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'261bb228-b3ee-458c-b854-61405a82428a\'}, \'multiverseid\': None}, {\'name\': \'Justiça Cármica\', \'text\': \'Toda vez que uma mágica ou habilidade que um oponente controla destrói uma permanente que você controla que não seja uma criatura, você pode destruir a permanente alvo que o oponente controla.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178589&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a226d55f-0d0a-4599-848c-4123b80d4d2a\', \'multiverseId\': 178589}, \'multiverseid\': 178589}]', '[{\'name\': \'Gesegneter Redner\', \'text\': \'Andere Kreaturen, die du kontrollierst, erhalten +0/+1.\', \'type\': \'Kreatur — Kleriker\', \'flavor\': \'Seine ruhigen Worte verklingen in der Kälte der Nacht, doch sie haben sich in das Gedächtnis seiner Zuhörer mit der Kraft von tausend Sonnen eingebrannt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175720&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff85724e-5fc9-4d3e-9251-72a2a02325a1\', \'multiverseId\': 175720}, \'multiverseid\': 175720}, {\'name\': \'Orador bendito\', \'text\': \'Las demás criaturas que controles obtienen +0/+1.\', \'type\': \'Criatura — Clérigo\', \'flavor\': \'Sus serenas palabras se desvanecen en el frío de la noche, sin embargo, se plasman ardientemente en la mente de quienes lo escuchan con todo el poder de mil soles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177132&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97c2cdee-a723-4537-85d7-6aa0be5b7eae\', \'multiverseId\': 177132}, \'multiverseid\': 177132}, {\'name\': \'Orateur béni\', \'text\': \'Les autres créatures que vous contrôlez gagnent +0/+1.\', \'type\': \'Créature : clerc\', \'flavor\': "Ses mots s\'éloignaient dans le froid de la nuit, mais ils continuaient à réchauffer le cœur de ses auditeurs avec la force d\'un millier de soleils.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176072&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c805f254-aeb7-44a6-a67a-743b78fad290\', \'multiverseId\': 176072}, \'multiverseid\': 176072}, {\'name\': \'Oratore Benedetto\', \'text\': \'Le altre creature che controlli prendono +0/+1.\', \'type\': \'Creatura — Chierico\', \'flavor\': \'Le sue tranquille parole si dissolvono nel gelo della notte, eppure bruciano nella mente di chi le ascolta con la forza di mille soli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176581&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9a9e816f-1df2-4d24-9956-4392fdc86546\', \'multiverseId\': 176581}, \'multiverseid\': 176581}, {\'name\': \'祝福された語り部\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dea9b5dd-b63c-41c3-a171-87ab14865c6b\'}, \'multiverseid\': None}, {\'name\': \'Orador Abençoado\', \'text\': \'As outras criaturas que você controla recebem +0/+1.\', \'type\': \'Criatura — Clérigo\', \'flavor\': \'Suas palavras serenas desaparecem no frio da noite, ainda que queimem na mente de seus ouvintes com todo o poder de mil sóis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178575&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a9283bca-6b1d-455c-b579-c50f5fa96e72\', \'multiverseId\': 178575}, \'multiverseid\': 178575}]', '[{\'name\': \'Geweihter Heiler\', \'text\': \'{T}: Verhindere die nächsten 2 Schadenspunkte, die in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt würden.\\nGrenzwert {T}: Verhindere die nächsten 4 Schadenspunkte, die in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt würden. (Spiele diese Fähigkeit nur, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Kleriker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83b65a54-aa82-4c24-9b56-718784a250f3\', \'multiverseId\': 175733}, \'multiverseid\': 175733}, {\'name\': \'Sanadora consagrada\', \'text\': \'{T}: Prevén los siguientes 2 puntos de daño que se le fuera a hacer a la criatura o jugador objetivo este turno.\\nUmbral {T}: Prevén los siguientes 4 puntos de daño que se le fuera a hacer a la criatura o jugador objetivo este turno. (Juega esta habilidad sólo si hay siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177145&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ffacb25d-ea63-430a-b929-be3e91f3672d\', \'multiverseId\': 177145}, \'multiverseid\': 177145}, {\'name\': \'Guérisseuse sacrée\', \'text\': "{T}: Prévenez, ce tour-ci, les prochaines 2 blessures qui devraient être infligées à une cible, créature ou joueur.\\nSeuil — {T}: Prévenez, ce tour-ci, les prochaines 4 blessures qui devraient être infligées à une cible, créature ou joueur. (Ne jouez cette capacité que s\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : clerc\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176085&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'686b78ac-d85c-4d30-8aa0-1f2c630bcd8a\', \'multiverseId\': 176085}, \'multiverseid\': 176085}, {\'name\': \'Guaritore Consacrato\', \'text\': \'{T}: Previeni i prossimi 2 danni che vengono inflitti a una creatura o a un giocatore bersaglio in questo turno.\\nSoglia - {T}: Previeni i prossimi 4 danni che vengono inflitti a una creatura o a un giocatore bersaglio in questo turno (gioca questa abilità solo se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Chierico\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176594&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03d914af-3971-47b8-a20a-ea961337814e\', \'multiverseId\': 176594}, \'multiverseid\': 176594}, {\'name\': \'尊い癒し手\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8194f031-69fe-4ba0-b39e-7eb2c646825c\'}, \'multiverseid\': None}, {\'name\': \'Curandeiro Santificado\', \'text\': \'{T}: Previne os próximos 2 pontos de dano que seriam causados à criatura alvo ou ao jogador alvo neste turno.\\nLimiar - {T}: Previne os próximos 4 pontos de dano que seriam causados à criatura alvo ou ao jogador alvo neste turno. (Use esta habilidade apenas se você tiver sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Clérigo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178588&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b38ab04f-b6d0-47ee-b848-9486c602dbf7\', \'multiverseId\': 178588}, \'multiverseid\': 178588}]', '[{\'name\': \'Gewissenhafte Gefolgschaft\', \'text\': \'Jede Kreatur hat Schutz vor ihren eigenen Farben.\', \'type\': \'Verzauberung\', \'flavor\': \'„Es gibt genug Unfrieden auf dieser Welt. Wo kämen wir hin, wenn wir uns auch noch gegeneinander stellen würden?" —Pianna, Nomaden-Oberhaupt\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175729&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6fc7a77e-45c1-4ec5-ae28-266642899697\', \'multiverseId\': 175729}, \'multiverseid\': 175729}, {\'name\': \'Compañerismo fervoroso\', \'text\': \'Cada criatura tiene protección contra sus propios colores.\', \'type\': \'Encantamiento\', \'flavor\': \'"Ya hay suficiente antagonismo en el mundo. ¿Dónde estaríamos si peleáramos entre nosotros?" —Píanna, capitana nómada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177141&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'89405f2e-44a2-41fb-8505-c3fd75e3a795\', \'multiverseId\': 177141}, \'multiverseid\': 177141}, {\'name\': \'Camaraderie sincère\', \'text\': \'Chaque créature a la protection contre ses propres couleurs.\', \'type\': \'Enchantement\', \'flavor\': "« Il y a déjà assez de haine en ce monde, n\'allons pas en plus nous retourner contre nos semblables. » —Pianna, capitaine des nomades.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176081&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6043f6e7-f984-42d6-8b92-2e51330083c3\', \'multiverseId\': 176081}, \'multiverseid\': 176081}, {\'name\': \'Compagnia Sincera\', \'text\': \'Ogni creatura ha protezione dai propri colori.\', \'type\': \'Incantesimo\', \'flavor\': \'"Nel mondo ci sono già abbastanza lotte. Dove andremmo a finire se iniziassimo anche a litigare tra di noi?" —Pianna, Capitano Nomade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176590&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2df7b8b-efb3-4b35-a26d-5197d61c247b\', \'multiverseId\': 176590}, \'multiverseid\': 176590}, {\'name\': \'大切な仲間\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'15626219-daa5-49fc-989f-2c2969e6fb81\'}, \'multiverseid\': None}, {\'name\': \'Companheirismo Zeloso\', \'text\': \'Cada criatura tem proteção contra suas próprias cores.\', \'type\': \'Encantamento\', \'flavor\': \'"O mundo já tem conflitos suficientes. O que nos aconteceria se nos virássemos uns contra os outros?" — Pianna, capitão nômade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178584&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9215652-3ec4-44a4-935b-2d2f5d9ed15d\', \'multiverseId\': 178584}, \'multiverseid\': 178584}]', '[{\'name\': \'Glaubensbeweis\', \'text\': \'{X}: Der Glaubensbeweis wird zu einer X/X Mauer-Kreatur bis zum Ende des Zuges. Es ist immer noch eine Verzauberung. (Mauern können nicht angreifen.)\', \'type\': \'Verzauberung\', \'flavor\': \'„Der Glaube an die Ahnfrau ist bewundernswert, aber gegen unsere Gegner braucht man oft etwas ... handfesteres." —Pianna, Nomaden-Oberhaupt\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175763&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d84c2606-2e2f-4480-8c19-fa7ad0051700\', \'multiverseId\': 175763}, \'multiverseid\': 175763}, {\'name\': \'Testamento de fe\', \'text\': \'{X}: El Testamento de fe es una criatura Muro X/X hasta el final del turno. Sigue siendo un encantamiento. (Los Muros no pueden atacar.)\', \'type\': \'Encantamiento\', \'flavor\': \'"Creer en la Antepasada es admirable, pero nuestros enemigos frecuentemente exigen algo más . . . tangible." —Píanna, capitana nómada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177175&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2af2ec22-c5ec-4e7a-ae50-3043fd87e59a\', \'multiverseId\': 177175}, \'multiverseid\': 177175}, {\'name\': \'Profession de foi\', \'text\': "{X}: La Profession de foi devient une créature mur X/X jusqu\'à la fin du tour. Elle est toujours un enchantement. (Les murs ne peuvent pas attaquer.)", \'type\': \'Enchantement\', \'flavor\': "« La foi dans les Ancêtres est admirable, mais nos ennemis ont parfois besoin d\'arguments plus tangibles. » —Pianna, capitaine des nomades.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176115&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22909ee0-e7cc-4bab-8cf2-666cceb241cc\', \'multiverseId\': 176115}, \'multiverseid\': 176115}, {\'name\': \'Testamento di Fede\', \'text\': \'{X}: Il Testamento di Fede diventa una creatura Muro X/X fino alla fine del turno. È ancora un incantesimo. (I muri non possono attaccare).\', \'type\': \'Incantesimo\', \'flavor\': \'"La fede negli Antenati è ammirevole, ma per i nostri nemici spesso si rende necessario qualcosa di più . . . concreto". —Pianna, Capitano Nomade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176624&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cdd4086-df06-4c69-a946-b39daf31c9b5\', \'multiverseId\': 176624}, \'multiverseid\': 176624}, {\'name\': \'信仰の証\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5650cae-e491-4f2d-a41b-31d940cc2b5b\'}, \'multiverseid\': None}, {\'name\': \'Testemunho de Fé\', \'text\': \'{X}: Testemunho de Fé torna-se uma Barreira X/X até o final do turno. Ela ainda conta como um encantamento. (As Barreiras não podem atacar.)\', \'type\': \'Encantamento\', \'flavor\': \'"A crença na Ancestral é admirável, mas nossos inimigos frequentemente necessitam de algo mais... tangível." — Pianna, capitão nômade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178618&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c650f07a-e515-416f-ac39-8cc7fc35e453\', \'multiverseId\': 178618}, \'multiverseid\': 178618}]', '[{\'name\': \'Glutbestie\', \'text\': \'Die Glutbestie kann weder alleine angreifen noch alleine blocken.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Sieh ein Glutvieh? Hau es weg Noch ein zweites? Böser Schreck —Redewendung unter Zwergen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175898&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'80ef2856-8b24-49a7-84f8-1d3b7ab7622a\', \'multiverseId\': 175898}, \'multiverseid\': 175898}, {\'name\': \'Bestia de brasa\', \'text\': \'La Bestia de brasa no puede atacar o bloquear sola.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Si ves una bestia de brasa, atácala. Si ves una segunda, mejor retrocede. —Refrán enano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177310&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae6826b0-e527-4828-8656-5b6c28c08db1\', \'multiverseId\': 177310}, \'multiverseid\': 177310}, {\'name\': "Bête d\'ambre", \'text\': "La Bête d\'ambre ne peut pas attaquer ou bloquer seule.", \'type\': \'Créature : bête\', \'flavor\': "Une bête d\'ambre devant, à l\'attaque Deux en vue, retour à la baraque —Dicton nain.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176250&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a39a758-dba6-40d6-a210-c48172cddebe\', \'multiverseId\': 176250}, \'multiverseid\': 176250}, {\'name\': \'Bestia di Brace\', \'text\': \'La Bestia di Brace non può attaccare o bloccare da sola.\', \'type\': \'Creatura — Bestia\', \'flavor\': \'Se vedi una bestia di brace, attacca. Se ne vedi una seconda, ritirati. —detto nanesco\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176759&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d8f47049-fa7b-4272-8a38-84aceaa33ff5\', \'multiverseId\': 176759}, \'multiverseid\': 176759}, {\'name\': \'くすぶり獣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2c4a8edf-f8b5-4762-b676-2a2b3ef61154\'}, \'multiverseid\': None}, {\'name\': \'Besta Ígnea\', \'text\': \'Besta Ígnea não pode atacar nem bloquear sozinha.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Se vês uma besta ígnea, ataca sem vacilar. Mas se vês uma segunda, debanda sem hesitar. — Dito dos anões\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f96ed4b4-343c-4648-922d-d0fa77436139\', \'multiverseId\': 178753}, \'multiverseid\': 178753}]', "[{'name': 'Glühendes Geschoss', 'text': 'Das Glühende Geschoss fügt einem Spieler deiner Wahl 4 Schadenspunkte zu.\\nRückblende {9}{R} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175927&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2c747b04-78bc-476f-9fd6-1dae48f36258', 'multiverseId': 175927}, 'multiverseid': 175927}, {'name': 'Misil abrasador', 'text': 'El Misil abrasador hace 4 puntos de daño al jugador objetivo.\\nRetrospectiva {9}{R}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177339&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '01c633a0-c70e-4263-a464-cb60598f513b', 'multiverseId': 177339}, 'multiverseid': 177339}, {'name': 'Missile dévastateur', 'text': 'Le Missile dévastateur inflige 4 blessures au joueur ciblé.\\nFlashback {9}{R} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176279&type=card', 'language': 'French', 'identifiers': {'scryfallId': '96f20403-2004-40ce-88fa-12e9c2cf03e4', 'multiverseId': 176279}, 'multiverseid': 176279}, {'name': 'Proiettile Incandescente', 'text': 'Il Proiettile Incandescente infligge 4 danni a un giocatore bersaglio.\\nFlashback {9}{R} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176788&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '275fa19e-be9c-4a6a-9863-40c348c22a3d', 'multiverseId': 176788}, 'multiverseid': 176788}, {'name': '焦熱の飛弾', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '42bdf930-5182-4f5d-9eb0-9a8234fd4095'}, 'multiverseid': None}, {'name': 'Projétil Abrasador', 'text': 'Projétil Abrasador causa 4 pontos de dano ao jogador alvo.\\nRecapitular {9}{R} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178782&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '77b7d8b5-bd37-40d5-ac23-8092d81b04ae', 'multiverseId': 178782}, 'multiverseid': 178782}]", '[{\'name\': \'Gorilla-Titan\', \'text\': \'Verursacht Trampelschaden\\nDer Gorilla-Titan erhält +4/+4, solange keine Karten in deinem Friedhof sind.\', \'type\': \'Kreatur — Menschenaffe\', \'flavor\': \'„Ich will eine Banane, die soooo groß ist"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175949&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'23190185-07e6-4599-b938-2230332161dd\', \'multiverseId\': 175949}, \'multiverseid\': 175949}, {\'name\': \'Gorila titán\', \'text\': \'Arrolla.\\nEl Gorila titán obtiene +4/+4 mientras no haya cartas en tu cementerio.\', \'type\': \'Criatura — Simio\', \'flavor\': \'"¡Quiero un plátano así de grande"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177361&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e192657-f227-4fa0-a247-5d14cd829258\', \'multiverseId\': 177361}, \'multiverseid\': 177361}, {\'name\': \'Gorille titanesque\', \'text\': "Piétinement\\nLe Gorille titanesque gagne +4/+4 tant qu\'il n\'y a pas de cartes dans votre cimetière.", \'type\': \'Créature : grand singe\', \'flavor\': \'« Je veux une grosse banane »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176301&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c513387-7ece-4f63-97ce-91c0e92427c3\', \'multiverseId\': 176301}, \'multiverseid\': 176301}, {\'name\': \'Titano Gorilla\', \'text\': \'Travolgere\\nIl Titano Gorilla prende +4/+4 fintanto che non ci sono carte nel tuo cimitero.\', \'type\': \'Creatura — Scimpanzé\', \'flavor\': \'"Voglio delle noccioline grosse così"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176810&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90d8551a-dcb0-4c32-849a-22652c654100\', \'multiverseId\': 176810}, \'multiverseid\': 176810}, {\'name\': \'ゴリラのタイタン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9fd14c63-263f-425e-81f9-8071a2aa246c\'}, \'multiverseid\': None}, {\'name\': \'Titã Gorila\', \'text\': \'Atropelar\\nTitã Gorila recebe +4/+4 desde que não haja cards em seu cemitério.\', \'type\': \'Criatura — Símio\', \'flavor\': \'"Eu quero uma banana desse tamanho"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178804&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'454b8e6c-cf97-458d-ae35-8cd3a4da3660\', \'multiverseId\': 178804}, \'multiverseid\': 178804}]', '[{\'name\': \'Grausiges Ableben\', \'text\': \'Zerstöre eine nichtschwarze Kreatur deiner Wahl, wenn ihre Widerstandskraft kleiner oder gleich der Anzahl an Karten in deinem Friedhof ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Jeder kann mit den Fingern schnipsen und Seelen einkassieren. Ich töte lieber kreativ." —Braids, Wahnwitz-Beschwörerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175847&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f56c99ce-bf3e-4a8e-b8eb-d89261ba7e01\', \'multiverseId\': 175847}, \'multiverseid\': 175847}, {\'name\': \'Fallecimiento espantoso\', \'text\': \'Destruye la criatura objetivo que no sea negra si su resistencia es menor o igual al número de cartas que haya en tu cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'"Cualquiera puede chasquear los dedos y arrancar un alma. Yo prefiero matar creativamente." —Trenzas, invocadora de demencia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177259&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4054c9b4-01b1-48c6-8519-75554e3dfc10\', \'multiverseId\': 177259}, \'multiverseid\': 177259}, {\'name\': \'Décès abominable\', \'text\': \'Détruisez la créature non-noire ciblée si son endurance est inférieure ou égale au nombre de cartes de votre cimetière.\', \'type\': \'Éphémère\', \'flavor\': "« N\'importe qui peut tuer Moi, je ne tue pas, je crée, car chacun de mes meurtres est une œuvre d\'art. » —Nattes, invocatrice de démences.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176199&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4828303-4586-4e5f-a553-70dd3a7b9bb2\', \'multiverseId\': 176199}, \'multiverseid\': 176199}, {\'name\': \'Dipartita Agghiacciante\', \'text\': \'Distruggi una creatura bersaglio non nera se la sua costituzione è pari o inferiore al numero di carte presenti nel tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'"Chiunque può schioccare le dita per estirpare un\\\'anima. Io preferisco uccidere in modo creativo". —-Braids, evocatore di dementia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176708&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c864ad26-77b0-4a52-9893-60d390a596ef\', \'multiverseId\': 176708}, \'multiverseid\': 176708}, {\'name\': \'恐ろしい死\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6a8eeb6-b2c3-4f05-a82a-3c516ae7ca3c\'}, \'multiverseid\': None}, {\'name\': \'Abdicação Forçada\', \'text\': \'Destrói a criatura alvo que não seja preta se sua resistência for menor ou igual ao número de cards em seu cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Qualquer um é capaz de estalar os dedos e arrancar uma alma. Eu prefiro matar com criatividade." —Braids, invocadora da demência\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178702&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5d10e40e-c97c-4fc6-ae21-b6b60d5bf5c4\', \'multiverseId\': 178702}, \'multiverseid\': 178702}]', '[{\'name\': \'Gräbersturm\', \'text\': \'Zu Beginn deines Versorgungssegments kann ein Gegner deiner Wahl eine Karte aus seinem Friedhof ganz aus dem Spiel entfernen. Falls dieser Spieler das nicht tut, kannst du eine Karte ziehen.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175849&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce727440-9289-427b-9770-2b3115083ff7\', \'multiverseId\': 175849}, \'multiverseid\': 175849}, {\'name\': \'Tormenta sepulcral\', \'text\': \'Al comienzo de tu mantenimiento, el oponente objetivo puede remover del juego una carta de su cementerio. Si ese jugador no lo hace, puedes robar una carta.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177261&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11a506f1-4fc0-4949-94b3-e77938e27ad7\', \'multiverseId\': 177261}, \'multiverseid\': 177261}, {\'name\': \'Tomborage\', \'text\': "Au début de votre entretien, l\'adversaire ciblé peut retirer de la partie une carte de son cimetière. Si ce joueur ne le fait pas, vous pouvez piocher une carte.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176201&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc40cc0c-81f8-4433-bb6c-fbbbc52d79e3\', \'multiverseId\': 176201}, \'multiverseid\': 176201}, {\'name\': \'Tempesta Tombale\', \'text\': "All\'inizio del tuo mantenimento, l\'avversario bersaglio può rimuovere dal gioco una carta presente nel suo cimitero. Se quel giocatore non lo fa, puoi pescare una carta.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176710&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c183337b-b2ef-4759-8c5d-3135ab948c05\', \'multiverseId\': 176710}, \'multiverseid\': 176710}, {\'name\': \'墓所の嵐\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'01a2ab97-96b7-4cbd-acda-b21c97063038\'}, \'multiverseid\': None}, {\'name\': \'Perturbação Tumular\', \'text\': \'No início de sua manutenção, o oponente alvo pode remover de jogo um card de seu próprio cemitério. Se aquele jogador não o fizer, você pode comprar um card.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178704&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c1608f28-a622-49b5-8c51-3ec9126262b0\', \'multiverseId\': 178704}, \'multiverseid\': 178704}]', '[{\'name\': \'Göttliches Sakrament\', \'text\': \'Weiße Kreaturen erhalten +1/+1.\\nGrenzwert Weiße Kreaturen erhalten zusätzlich +1/+1. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Verzauberung\', \'flavor\': \'Ihre geflüsterten Gebete ermutigen die Nomaden besser als jeder Kriegsruf es könnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3b71cfbd-7f8e-4cef-9e55-bfcdc1589ab2\', \'multiverseId\': 175727}, \'multiverseid\': 175727}, {\'name\': \'Sacramento divino\', \'text\': \'Las criaturas blancas obtienen +1/+1.\\nUmbral Las criaturas blancas obtienen un +1/+1 adicional. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Encantamiento\', \'flavor\': \'Sus oraciones susurradas reúnen a los nómadas mejor que cualquier grito de guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177139&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0ff524e2-1139-4df8-9e20-f766325dc009\', \'multiverseId\': 177139}, \'multiverseid\': 177139}, {\'name\': \'Sacrement divin\', \'text\': "Les créatures blanches gagnent +1/+1.\\nSeuil — Les créatures blanches gagnent un +1/+1 supplémentaire. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Enchantement\', \'flavor\': "Leurs prières chuchotées rassemblaient les nomades comme aucun cri de guerre ne l\'aurait pu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176079&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'747c0029-f3c7-4807-8949-b32bfaa1d847\', \'multiverseId\': 176079}, \'multiverseid\': 176079}, {\'name\': \'Sacramento Divino\', \'text\': \'Le creature bianche prendono +1/+1.\\nSoglia - Le creature bianche prendono +1/+1 addizionale (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Incantesimo\', \'flavor\': \'Le loro preghiere sussurrate incoraggiano i nomadi più di qualsiasi urlo di battaglia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176588&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2ba4b1c-4b82-49a8-abb0-a191817ab250\', \'multiverseId\': 176588}, \'multiverseid\': 176588}, {\'name\': \'聖餐式\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f8cc6595-f346-4272-92bc-29bcc3bc47aa\'}, \'multiverseid\': None}, {\'name\': \'Sacramento Divino\', \'text\': \'As criaturas brancas recebem +1/+1.\\nLimiar - As criaturas brancas recebem um adicional de +1/+1. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Encantamento\', \'flavor\': \'Suas preces sussurradas reúnem as tropas nômades com mais eficiência que qualquer grito de guerra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178582&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5be460f-8ef3-47ad-bc97-786307c6051d\', \'multiverseId\': 178582}, \'multiverseid\': 178582}]', '[{\'name\': \'Halle des Gesinnungswandels\', \'text\': \'Das verzauberte Land hat "{T}, wirf eine Karte aus deiner Hand ab: Übernimm die Kontrolle über eine Kreatur deiner Wahl bis zum Ende des Zuges."\', \'type\': \'Landverzauberung\', \'flavor\': \'Politik ist nur eine unterschwellige Art der Gedankenkontrolle und Zephaliden sind perfekte Politiker.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175784&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'07d01ba2-e0e5-4ba5-9063-c5ac291c6c32\', \'multiverseId\': 175784}, \'multiverseid\': 175784}, {\'name\': \'Cámara de manipulación\', \'text\': \'La tierra encantada tiene: "{T}, descartar una carta de tu mano: Gana el control de la criatura objetivo hasta el final del turno".\', \'type\': \'Encantar tierra\', \'flavor\': \'La política sólo es una forma sutil de controlar la mente; y los cefálidos son políticos expertos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177196&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9fcbdcd6-551c-4b5a-a1a6-306c936e3e99\', \'multiverseId\': 177196}, \'multiverseid\': 177196}, {\'name\': \'Chambre de manipulation\', \'text\': "Le terrain enchanté a « {T}, défaussez-vous d\'une carte de votre main : Acqué-rez le contrôle de la créature ciblée jusqu\'à la fin du tour. »", \'type\': \'Enchanter : terrain\', \'flavor\': "La politique n\'est qu\'une forme de contrôle mental — et les céphalides sont des maîtres politiciens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176136&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c7b2e23-65b4-4a77-9161-a74d36a58e7e\', \'multiverseId\': 176136}, \'multiverseid\': 176136}, {\'name\': \'Camera della Manipolazione\', \'text\': \'La terra incantata ha "{T}, Scarta una carta dalla tua mano: Prendi il controllo di una creatura bersaglio fino alla fine del turno".\', \'type\': \'Incanta Terra\', \'flavor\': \'La politica è solo una sottile forma di controllo mentale. . . e i cefalidi sono eccellenti politici.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176645&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'45f98a53-df72-48f0-b918-a875d0a86098\', \'multiverseId\': 176645}, \'multiverseid\': 176645}, {\'name\': \'操作室\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a91969e-4257-4fbd-b25e-023135a9c7cd\'}, \'multiverseid\': None}, {\'name\': \'Câmara de Manipulação\', \'text\': \'O terreno encantado tem "{T}, Descarte um card de sua mão: Ganhe o controle da criatura alvo até o final do turno."\', \'type\': \'Encantar Terreno\', \'flavor\': \'A política é apenas uma forma sutil de controle da mente e os cefálidas são políticos magistrais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178639&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc93e30b-47e8-4b98-b733-472393868343\', \'multiverseId\': 178639}, \'multiverseid\': 178639}]', '[{\'name\': \'Hang zur Hast\', \'text\': \'Opfere ein Land: Eine Kreatur deiner Wahl erhält bis zum Ende des Zuges Eile.\', \'type\': \'Verzauberung\', \'flavor\': \'Seine Füße wölbten den Boden, seine Hände zerteilten den Wind, und weg war er.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175917&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bbce5f87-f7b2-46fe-b54c-d8e53a79e54c\', \'multiverseId\': 175917}, \'multiverseid\': 175917}, {\'name\': \'Necesidad de velocidad\', \'text\': \'Sacrificar una tierra: La criatura objetivo gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Encantamiento\', \'flavor\': \'Sus pies combaron el suelo, sus manos hicieron trizas el viento, y desapareció.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177329&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f3be586a-80af-4e4b-8cef-fa8801982d91\', \'multiverseId\': 177329}, \'multiverseid\': 177329}, {\'name\': \'Besoin de vitesse\', \'text\': "Sacrifiez un terrain : La créature ciblée acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': "« Ô ses souffles, ses têtes, ses courses : la terrible célérité de la perfection des formes et de l\'action »— Arthur Rimbaud, les Illuminations.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176269&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aab7c606-11a1-49cc-86a6-8fbb901e4b31\', \'multiverseId\': 176269}, \'multiverseid\': 176269}, {\'name\': \'Brama di Velocità\', \'text\': \'Sacrifica una terra: La creatura bersaglio guadagna rapidità fino alla fine del turno.\', \'type\': \'Incantesimo\', \'flavor\': \'I suoi piedi deformarono il terreno, le sua mani tagliarono il vento e di lui non ci fu più traccia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176778&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'06005b9e-db60-44d8-b87f-50d015fab8e3\', \'multiverseId\': 176778}, \'multiverseid\': 176778}, {\'name\': \'さらなる速さ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3005b134-a7a1-45bb-bf45-a3f3471c8445\'}, \'multiverseid\': None}, {\'name\': \'Necessidade de Velocidade\', \'text\': \'Sacrifique um terreno: A criatura alvo ganha ímpeto até o final do turno.\', \'type\': \'Encantamento\', \'flavor\': \'Seus pés deformaram o solo, suas mãos cortaram o vento em tiras, e ele se foi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178772&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41b6163c-fcdd-49ee-bc4c-f3f0cbe5f781\', \'multiverseId\': 178772}, \'multiverseid\': 178772}]', '[{\'name\': \'Heilige Rituale\', \'text\': \'Wirf eine beliebige Anzahl Karten aus deiner Hand ab. Kreaturen, die du kontrollierst, erhalten für jede auf diese Weise abgeworfene Karte +0/+1 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175752&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'102fb71f-fabb-4a94-ab91-30fa31f8c78f\', \'multiverseId\': 175752}, \'multiverseid\': 175752}, {\'name\': \'Ritos sagrados\', \'text\': \'Descarta cualquier número de cartas de tu mano. Las criaturas que controles obtienen +0/+1 hasta el final del turno por cada carta descartada de esta manera.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177164&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'571eec94-037a-419c-b77e-fc397e23d0df\', \'multiverseId\': 177164}, \'multiverseid\': 177164}, {\'name\': \'Sacres et rites\', \'text\': "Défaussez-vous de n\'importe quel nombre de cartes de votre main. Les créatures que vous contrôlez gagnent +0/+1 jusqu\'à la fin du tour pour chaque carte défaussée de cette manière.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176104&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f5cd3d6f-9d60-43a2-a371-d9af9c0815dc\', \'multiverseId\': 176104}, \'multiverseid\': 176104}, {\'name\': \'Riti Sacri\', \'text\': \'Scarta un qualsiasi numero di carte dalla tua mano. Le creature che controlli prendono +0/+1 fino alla fine del turno per ogni carta scartata in questo modo.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176613&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'172ecddc-2457-49f2-8738-e2ff4fe83a2a\', \'multiverseId\': 176613}, \'multiverseid\': 176613}, {\'name\': \'聖なる儀式\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cae96d10-9e24-462e-aa17-a5ccc0fe1359\'}, \'multiverseid\': None}, {\'name\': \'Ritos Sagrados\', \'text\': \'Descarte um número qualquer de cards de sua mão. As criaturas que você controla recebem +0/+1 até o final do turno para cada card descartado dessa maneira.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178607&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ff822c04-ef7f-433f-ab6d-6b24525c7cc8\', \'multiverseId\': 178607}, \'multiverseid\': 178607}]', '[{\'name\': \'Heldenhafte Tat\', \'text\': \'Eine blockende Kreatur deiner Wahl erhält +4/+4 bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Mutige erreicht in einem einzigen Moment mehr als der Ängstliche in seinem ganzen Leben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175731&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0e4dc3b-bed5-46d9-b988-7ca1f1094b74\', \'multiverseId\': 175731}, \'multiverseid\': 175731}, {\'name\': \'Gallardía\', \'text\': \'La criatura objetivo bloqueadora obtiene +4/+4 hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Los valientes logran más en un solo momento que los cobardes en toda su vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177143&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e3f99df7-17db-4702-8d4e-dd6e693ff2a1\', \'multiverseId\': 177143}, \'multiverseid\': 177143}, {\'name\': \'Galanterie\', \'text\': "La créature bloqueuse ciblée gagne +4/+4 jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'« Le moyen de bien recevoir des gens qui sont tout à fait incongrus en galanterie ? »— Molière, les Précieuses ridicules.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176083&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90a298ff-cb8d-4a31-9a14-41eb5fd52b73\', \'multiverseId\': 176083}, \'multiverseid\': 176083}, {\'name\': \'Prodezza\', \'text\': \'La creatura bloccante bersaglio prende +4/+4 fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'I coraggiosi realizzano in un solo istante più di quanto riescano a fare i codardi in tutta una vita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176592&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03fe0bdf-ed8b-4ffb-a92a-894e5f618ced\', \'multiverseId\': 176592}, \'multiverseid\': 176592}, {\'name\': \'勇敢な行為\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b3db5261-6580-44c1-8df4-14aeb8ff043a\'}, \'multiverseid\': None}, {\'name\': \'Galanteria\', \'text\': \'A criatura alvo bloqueadora recebe +4/+4 até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O corajoso realiza mais em um único momento do que um covarde durante toda a vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178586&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'efd1e166-6375-43c1-b3ee-6437b29fada4\', \'multiverseId\': 178586}, \'multiverseid\': 178586}]', "[{'name': 'Hellebardier', 'text': 'Erstschlag', 'type': 'Kreatur — Barbar', 'flavor': 'Sein Ruf eilt ihm voraus ebenso wie seine Waffe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175904&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3af3d699-a51c-42a9-972f-5c75716ae8c0', 'multiverseId': 175904}, 'multiverseid': 175904}, {'name': 'Alabardero', 'text': 'Daña primero.', 'type': 'Criatura — Bárbaro', 'flavor': 'Su reputación lo precede, igual que su arma.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177316&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8e7b5466-71ac-4021-9b65-43038f24ac82', 'multiverseId': 177316}, 'multiverseid': 177316}, {'name': 'Hallebardier', 'text': 'Initiative', 'type': 'Créature : barbare', 'flavor': 'Sa réputation le précède. Son arme aussi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176256&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0370f29e-1947-4421-8d8b-62dcdf8c0a21', 'multiverseId': 176256}, 'multiverseid': 176256}, {'name': 'Alabardiere', 'text': 'Attacco improvviso', 'type': 'Creatura — Barbaro', 'flavor': 'La sua reputazione lo precede. . . e così anche la sua arma.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176765&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bace8720-eed8-40a8-85a0-064ae24bafd3', 'multiverseId': 176765}, 'multiverseid': 176765}, {'name': '矛槍兵', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e3265dfd-e0fc-4f76-941f-1288dd07ee8d'}, 'multiverseid': None}, {'name': 'Alabardeiro', 'text': 'Iniciativa', 'type': 'Criatura — Bárbaro', 'flavor': 'Assim como sua espada, sua reputação o precede.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178759&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1ab6825e-0ca9-4c8b-9261-bfc30ed85f6a', 'multiverseId': 178759}, 'multiverseid': 178759}]", "[{'name': 'Herausziehen', 'text': 'Durchsuche die Bibliothek eines Spielers deiner Wahl. Bestimme eine Karte davon, und entferne diese Karte ganz aus dem Spiel. Dieser Spieler mischt dann seine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Zu sagen, Nixar hätte stechende Kopfschmerzen, wäre ein eindeutiges Understatement.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175793&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd5684042-0713-496d-81e5-694cfdf3b154', 'multiverseId': 175793}, 'multiverseid': 175793}, {'name': 'Extraer', 'text': 'Busca en la biblioteca del jugador objetivo una carta y remueve esa carta del juego. Luego ese jugador baraja su biblioteca.', 'type': 'Conjuro', 'flavor': 'Decir que Níxar tenía un dolor de cabeza enloquecedor sería hacer un juicio modesto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177205&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'fa7c86ea-ca7b-4de2-bce2-0e0bc7e2aecb', 'multiverseId': 177205}, 'multiverseid': 177205}, {'name': 'Extraction', 'text': 'Cherchez une carte dans la bibliothèque du joueur ciblé et retirez cette carte de la partie. Ce joueur mélange ensuite sa bibliothèque.', 'type': 'Rituel', 'flavor': 'Dire que Nixar avait un mal de tête dévastateur serait un euphémisme.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176145&type=card', 'language': 'French', 'identifiers': {'scryfallId': '693749f3-3cbb-43b0-8c8a-13b78f0a3e5e', 'multiverseId': 176145}, 'multiverseid': 176145}, {'name': 'Estrarre', 'text': 'Passa in rassegna il grimorio di un giocatore bersaglio, scegli una carta e rimuovila dal gioco. Poi quel giocatore rimescola il proprio grimorio.', 'type': 'Stregoneria', 'flavor': 'Dire che Nixar aveva la testa spaccata dal dolore sarebbe un eufemismo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176654&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2607b1b5-a3c6-429c-9122-cbe97cdeb7cf', 'multiverseId': 176654}, 'multiverseid': 176654}, {'name': '摘出', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '70abf371-d3b4-44b3-a634-3226410c3d5a'}, 'multiverseid': None}, {'name': 'Extrair', 'text': 'Procure por um card no grimório do jogador alvo e remova-o de jogo. Depois, aquele jogador embaralha seu próprio grimório.', 'type': 'Feitiço', 'flavor': 'Dizer que Nixar teve uma dor de cabeça lancinante seria subestimar um pouco o fato.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178648&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '11ea3a98-4d75-4597-af46-6f707bba532c', 'multiverseId': 178648}, 'multiverseid': 178648}]", "[{'name': 'Heulender Sturm', 'text': 'Der Heulende Sturm fügt jeder fliegenden Kreatur und jedem Spieler 1 Schadenspunkt zu.\\nRückblende {1}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175952&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1acf16ec-3e96-4086-8485-2e90339d2d27', 'multiverseId': 175952}, 'multiverseid': 175952}, {'name': 'Vendaval aullante', 'text': 'El Vendaval aullante hace 1 punto de daño a cada criatura que tenga la habilidad de volar y a cada jugador.\\nRetrospectiva {1}{G}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177364&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '95742410-1892-4637-93d2-d408ced4ad70', 'multiverseId': 177364}, 'multiverseid': 177364}, {'name': 'Vent hurlant', 'text': 'Le Vent hurlant inflige 1 blessure à chaque créature avec le vol et à chaque joueur.\\nFlashback {1}{G} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176304&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'bd63a874-44ce-4b80-a164-884542afd099', 'multiverseId': 176304}, 'multiverseid': 176304}, {'name': 'Burrasca Furiosa', 'text': 'La Burrasca Furiosa infligge 1 danno a ogni creatura con volare e a ogni giocatore.\\nFlashback {1}{G} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176813&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '761a2561-ae51-4360-bccc-44985b5b3bb8', 'multiverseId': 176813}, 'multiverseid': 176813}, {'name': '吠えたける強風', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '75b6275e-e9ad-449d-bfa1-38efc68366ce'}, 'multiverseid': None}, {'name': 'Vendaval Uivante', 'text': 'Vendaval Uivante causa 1 ponto de dano a cada criatura com a habilidade de voar e a cada jogador.\\nRecapitular {1}{G} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178807&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ef2e8d7b-84b9-45e1-850b-e3b77f089988', 'multiverseId': 178807}, 'multiverseid': 178807}]", '[{\'name\': \'Himmelsschütze\', \'text\': \'Der Himmelsschütze kann blocken, als ob er Flugfähigkeit hätte.\\n{T}, opfere den Himmelsschützen: Zerstöre eine fliegende angreifende oder blockende Kreatur deiner Wahl.\', \'type\': \'Kreatur — Zentaur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175978&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a25b868-31c1-4282-a58b-1e560ffe0e4d\', \'multiverseId\': 175978}, \'multiverseid\': 175978}, {\'name\': \'Tirador aéreo\', \'text\': \'El Tirador aéreo puede bloquear como si tuviera la habilidad de volar.\\n{T}, sacrificar el Tirador aéreo: Destruye la criatura objetivo atacante o bloqueadora que tenga la habilidad de volar.\', \'type\': \'Criatura — Centauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177390&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74024ec4-7f02-4d0a-bdf4-abac7757b99b\', \'multiverseId\': 177390}, \'multiverseid\': 177390}, {\'name\': \'Celui qui tire dans le ciel\', \'text\': "Celui qui tire dans le ciel peut bloquer comme s\'il avait le vol.\\n{T}, sacrifiez Celui qui tire dans le ciel : Détruisez la créature avec le vol attaquante ou bloqueuse ciblée.", \'type\': \'Créature : centaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176330&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0bd39aa-3cc7-4ca4-8f57-648362222d82\', \'multiverseId\': 176330}, \'multiverseid\': 176330}, {\'name\': \'Cacciatore dei Cieli\', \'text\': \'Il Cacciatore dei Cieli può bloccare come se avesse volare.\\n{T}, Sacrifica il Cacciatore dei Cieli: Distruggi una creatura attaccante o bloccante con volare.\', \'type\': \'Creatura — Centauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176839&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7dfa3187-5812-4437-a1f7-3d5bd44e77db\', \'multiverseId\': 176839}, \'multiverseid\': 176839}, {\'name\': \'空に射るもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43659ef5-0041-4b47-8ebd-1c886761dfff\'}, \'multiverseid\': None}, {\'name\': \'Alvejador Anti-Aéreo\', \'text\': \'Alvejador Anti-Aéreo pode bloquear como se tivesse a habilidade de voar.\\n{T}, Sacrifique Alvejador Anti-Aéreo: Destrói a criatura voadora alvo atacante ou bloqueadora.\', \'type\': \'Criatura — Centauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178833&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e07ccf45-d2c9-47bd-aa97-09fd02c4b2ad\', \'multiverseId\': 178833}, \'multiverseid\': 178833}]', '[{\'name\': \'Himmelswolken-Ei\', \'text\': \'{2}, {T}, opfere das Himmelswolken-Ei: Erhöhe deinen Manavorrat um {W}{U}. Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'„Wurden deine Träume von einer besseren Welt zu einer Wahnvorstellung?" —Watnik, Glasbläsermeister\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176017&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f50a701b-8678-4afe-af28-ffa498e04947\', \'multiverseId\': 176017}, \'multiverseid\': 176017}, {\'name\': \'Huevo Nubeceleste\', \'text\': \'{2}, {T}, sacrificar el Huevo Nubeceleste: Agrega {W}{U} a tu reserva de maná. Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'"¿Tus sueños de una mejor sociedad se convirtieron en una obsesión?" —Wátnik, soplavidrio experto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177429&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67d86c26-484c-40b8-9ac4-65d193a95e23\', \'multiverseId\': 177429}, \'multiverseid\': 177429}, {\'name\': \'Œuf de Cielcouvert\', \'text\': "{2}, {T}, sacrifiez l\'Œuf de Cielcouvert: Ajoutez {W}{U} à votre réserve. Piochez une carte.", \'type\': \'Artefact\', \'flavor\': \'« Vos rêves de monde meilleur sont-ils devenus une obsession ? » —Warnik, maître souffleur de verre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176369&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ee2e3b2-6801-44f5-b366-26056e5c0699\', \'multiverseId\': 176369}, \'multiverseid\': 176369}, {\'name\': \'Uovo di Cielonube\', \'text\': "{2}, {T}, Sacrifica l\'Uovo di Cielonube: Aggiungi {W}{U} alla tua riserva di mana. Pesca una carta.", \'type\': \'Artefatto\', \'flavor\': \'"I tuoi sogni di una società migliore stanno diventando un\\\'ossessione?" —Watnik, mastro vetraio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176878&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4da743d7-9298-4912-a49e-055355907b70\', \'multiverseId\': 176878}, \'multiverseid\': 176878}, {\'name\': \'スカイクラウドの卵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'39e015f8-a21c-4fa8-b2be-7dabff838bac\'}, \'multiverseid\': None}, {\'name\': \'Ovo de Skycloud\', \'text\': \'{2}, {T}, Sacrifique Ovo de Skycloud: Adiciona {W}{U} a sua reserva de mana. Compre um card.\', \'type\': \'Artefato\', \'flavor\': \'"Teus sonhos de uma sociedade melhor tornaram-se uma obsessão?" — Watnik, mestre vidreiro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178872&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'343083e1-8122-49d6-abd8-34d9d507f389\', \'multiverseId\': 178872}, \'multiverseid\': 178872}]', '[{\'name\': \'Himmelswolken-Weite\', \'text\': \'{1}, {T}: Erhöhe deinen Manavorrat um {W}{U}.\', \'type\': \'Land\', \'flavor\': \'Der Horizont von Otaria glitzert, wenn die Sonne von oben und das Meer von unten zusammentreffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176035&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'10d01109-9ef4-4428-b298-86dd4be08ae9\', \'multiverseId\': 176035}, \'multiverseid\': 176035}, {\'name\': \'Expansión Nubeceleste\', \'text\': \'{1}, {T}: Agrega {W}{U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Desde Otaria, el sol se encuentra con el mar en un horizonte fulgurante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c930d598-7484-4978-8a28-7b1a89f995ef\', \'multiverseId\': 177447}, \'multiverseid\': 177447}, {\'name\': \'Immensité de Cielcouvert\', \'text\': \'{1}, {T}: Ajoutez {W}{U} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Vu d\'Otaria, l\'horizon est un nuage scintillant où se confondent le ciel, le soleil et la mer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176387&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1766da74-3f0f-415d-93a0-f4f628045559\', \'multiverseId\': 176387}, \'multiverseid\': 176387}, {\'name\': \'Distesa di Cielonube\', \'text\': \'{1}, {T}: Aggiungi {W}{U} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'Da Otaria, il sole incontra il mare in un orizzonte abbagliante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176896&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7fa9f1bb-ca15-489f-9564-d27275bcbfc8\', \'multiverseId\': 176896}, \'multiverseid\': 176896}, {\'name\': \'広漠なるスカイクラウド\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b393b70f-023e-4630-847f-7d3bbf0a39f4\'}, \'multiverseid\': None}, {\'name\': \'Vastidão de Skycloud\', \'text\': \'{1}, {T}: Adiciona {W}{U} a sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Em Otaria, o sol desce até encontrar o mar em um horizonte fulgurante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178890&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'76e25421-a93a-429f-a873-e18dd8d4a0d0\', \'multiverseId\': 178890}, \'multiverseid\': 178890}]', "[{'name': 'Holistische Weisheit', 'text': '{2}, entferne eine Karte aus deiner Hand ganz aus dem Spiel: Bringe eine Karte deiner Wahl aus deinem Friedhof auf deine Hand, falls sie einen Kartentyp mit der auf diese Weise entfernten Karte gemeinsam hat. (Die Kartentypen sind Artefakt, Kreatur, Verzauberung, Spontanzauber, Land und Hexerei.)', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175951&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f0369801-8159-4413-8a5e-5687fc8e6430', 'multiverseId': 175951}, 'multiverseid': 175951}, {'name': 'Sabiduría integral', 'text': '{2}, remover del juego una carta de tu mano: Regresa la carta objetivo de tu cementerio a tu mano si comparte un tipo con la carta removida de esta manera. (Los tipos de carta son artefacto, criatura, encantamiento, instantáneo, tierra y conjuro.)', 'type': 'Encantamiento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177363&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd673ebd6-7077-42da-9313-2c359e02acbc', 'multiverseId': 177363}, 'multiverseid': 177363}, {'name': 'Sagesse holistique', 'text': '{2}, retirez de la partie une carte de votre main : Renvoyez la carte ciblée depuis votre cimetière dans votre main si elle partage un type avec la carte retirée de cette manière. (Les types de carte sont artefact, créature, enchantement, éphémère, terrain et rituel.)', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176303&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a35ea999-56f7-4ab4-bb71-6982117203e4', 'multiverseId': 176303}, 'multiverseid': 176303}, {'name': 'Saggezza Olistica', 'text': '{2}, Rimuovi dal gioco una carta presente nella tua mano: Riprendi in mano una carta bersaglio dal tuo cimitero se ha almeno un tipo in comune con la carta rimossa in questo modo (I tipi di carta sono artefatto, creatura, incantesimo, istantaneo, terra e stregoneria.)', 'type': 'Incantesimo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176812&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a615fa46-eecc-48ff-ae16-c3ee3b92a92f', 'multiverseId': 176812}, 'multiverseid': 176812}, {'name': '総体の知識', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '796a8284-ea57-4e8e-bab4-ff893502d688'}, 'multiverseid': None}, {'name': 'Sabedoria Holística', 'text': '{2}, Remova de jogo um card de sua mão: Devolve o card alvo de seu cemitério para a sua mão se ele partilhar um tipo com o card removido dessa maneira. (Os tipos de cards são artefato, criatura, encantamento, mágica instantânea, terreno e feitiço.)', 'type': 'Encantamento', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178806&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ea0e2f87-d4e7-4235-b852-ce1f506acd2d', 'multiverseId': 178806}, 'multiverseid': 178806}]", '[{\'name\': \'Impulsive Manöver\', \'text\': \'Immer wenn eine Kreatur angreift, wirf eine Münze. Falls du den Münzwurf gewinnst, fügt diese Kreatur das nächste Mal, sobald sie in diesem Zug Kampfschaden zufügen würde, stattdessen den doppelten Schaden zu. Falls du den Münzwurf verlierst, verhindere den Schaden, sobald diese Kreatur in diesem Zug das nächte Mal Kampfschaden zufügen würde.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175905&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'11e81e50-6787-4126-8a3f-26abd84ee081\', \'multiverseId\': 175905}, \'multiverseid\': 175905}, {\'name\': \'Maniobras impulsivas\', \'text\': \'Siempre que una criatura ataque, lanza una moneda. Si ganas el lanzamiento, la siguiente vez que esa criatura fuera a hacer daño de combate este turno, en vez de eso, hace el doble del daño. Si pierdes el lanzamiento, la siguiente vez que esa criatura fuera a hacer daño de combate este turno, prevén ese daño.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177317&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2fd786f4-a8f3-491e-9bae-4abb33aa07eb\', \'multiverseId\': 177317}, \'multiverseid\': 177317}, {\'name\': \'Manœuvres impulsives\', \'text\': "À chaque fois qu\'une créature attaque, jouez à pile ou face. Si vous gagnez, la prochaine fois que cette créature devrait infliger des blessures de combat ce tour-ci, elle inflige le double de ces blessures à la place. Si vous perdez, la prochaine fois que cette créature devrait infliger des blessures de combat ce tour-ci, prévenez ces blessures.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176257&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'89021479-02c8-4b74-94fe-56c5cbd3b04c\', \'multiverseId\': 176257}, \'multiverseid\': 176257}, {\'name\': \'Manovre Impulsive\', \'text\': \'Ogniqualvolta una creatura attacca, lancia una moneta. Se vinci il lancio, la prossima volta che quella creatura infligge danno da combattimento in questo turno, infligge invece il doppio di quel danno. Se perdi il lancio, la prossima volta che quella creatura infligge danno da combattimento in questo turno, previeni quel danno.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176766&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7fadd4d-1bfc-41da-b722-697ea938c40f\', \'multiverseId\': 176766}, \'multiverseid\': 176766}, {\'name\': \'突発的な行動\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f2c82f2-124f-4246-a333-db72ae00e274\'}, \'multiverseid\': None}, {\'name\': \'Manobras Impulsivas\', \'text\': \'Toda vez que uma criatura ataca, jogue uma moeda. Se você vencer, na próxima vez que aquela criatura fosse causar dano de combate neste turno, ela causa o dobro daquele dano. Se você perder, na próxima vez que aquela criatura fosse causar dano de combate neste turno, previna aquele dano.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178760&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6dd3fdf4-c15d-4708-bf52-ee1ec7edd07b\', \'multiverseId\': 178760}, \'multiverseid\': 178760}]', '[{\'name\': \'In Stücke schlagen\', \'text\': \'Zerstöre ein Artefakt deiner Wahl.\\nRückblende {4}{R}{R} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175884&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d5dcdff2-15b0-4583-88bd-d666ee078897\', \'multiverseId\': 175884}, \'multiverseid\': 175884}, {\'name\': \'Convertir en pedazos\', \'text\': \'Destruye el artefacto objetivo.\\nRetrospectiva {4}{R}{R}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177296&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'09546459-e5ec-4d2e-aa31-d2a93f90929e\', \'multiverseId\': 177296}, \'multiverseid\': 177296}, {\'name\': \'Réduction en miettes\', \'text\': "Détruisez l\'artefact ciblé.\\nFlashback {4}{R}{R} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176236&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3818f1ae-c77f-43c1-9f6b-21f49cac41bd\', \'multiverseId\': 176236}, \'multiverseid\': 176236}, {\'name\': \'Fare a Brandelli\', \'text\': \'Distruggi un artefatto bersaglio.\\nFlashback {4}{R}{R} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176745&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6c6f510-3ddc-4334-8395-037192c56fa6\', \'multiverseId\': 176745}, \'multiverseid\': 176745}, {\'name\': \'ぶち壊し\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e5803b4a-e7c7-4582-b594-b30bb9874fc0\'}, \'multiverseid\': None}, {\'name\': \'Fazer em Pedaços\', \'text\': \'Destrói o artefato alvo.\\nRecapitular {4}{R}{R} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178739&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b5dbdb14-fe9e-4552-aedc-2d987270defb\', \'multiverseId\': 178739}, \'multiverseid\': 178739}]', '[{\'name\': \'Infizierter Nager\', \'text\': \'{2}{B}: Der Infizierte Nager fügt jeder Kreatur und jedem Spieler 1 Schadenspunkt zu.\\nGrenzwert {3}{B}: Der Infizierte Nager fügt jeder Kreatur und jedem Spieler 3 Schadenspunkte zu. (Spiele diese Fähigkeit nur, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Ratte\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175852&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'55bc1013-59dd-4b95-ba7a-80f794cd997a\', \'multiverseId\': 175852}, \'multiverseid\': 175852}, {\'name\': \'Alimaña infectada\', \'text\': \'{2}{B}: La Alimaña infectada hace 1 punto de daño a cada criatura y a cada jugador.\\nUmbral {3}{B}: La Alimaña infectada hace 3 puntos de daño a cada criatura y a cada jugador. (Juega esta habilidad sólo si hay siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Rata\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177264&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22be9801-e300-4a3e-84bf-a62a64ab4ab6\', \'multiverseId\': 177264}, \'multiverseid\': 177264}, {\'name\': \'Vermine infectée\', \'text\': "{2}{B}: La Vermine infectée inflige 1 blessure à chaque créature et à chaque joueur.\\nSeuil — {3}{B}: La Vermine infectée inflige 3 blessures à chaque créature et à chaque joueur. (Ne jouez cette capacité que s\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : rat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176204&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c3004ee3-cd52-4f5b-82ef-ee03965be8d5\', \'multiverseId\': 176204}, \'multiverseid\': 176204}, {\'name\': \'Parassita Infetto\', \'text\': \'{2}{B}: Il Parassita Infetto infligge 1 danno a ogni creatura e a ogni giocatore.\\nSoglia {3}{B}: Il Parassita Infetto infligge 3 danni a ogni creatura e a ogni giocatore (gioca questa abilità solo se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Ratto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176713&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'55e19f32-1722-4508-9a4e-91ba07755fa3\', \'multiverseId\': 176713}, \'multiverseid\': 176713}, {\'name\': \'保菌獣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49ab4ab1-eb0e-44fa-8349-598527ca97d5\'}, \'multiverseid\': None}, {\'name\': \'Parasita Infectado\', \'text\': \'{2}{B}: Parasita Infectado causa 1 ponto de dano a cada criatura e a cada jogador.\\nLimiar — {3}{B}: Parasita Infectado causa 3 pontos de dano a cada criatura e a cada jogador. (Use esta habilidade apenas se você tiver sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Rato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178707&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'585a5c25-7c5b-4ee8-8971-24a335e7515c\', \'multiverseId\': 178707}, \'multiverseid\': 178707}]', "[{'name': 'Insel', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176043&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dd0ba484-860f-4c81-9672-bc42dca58408', 'multiverseId': 176043}, 'multiverseid': 176043}, {'name': 'Isla', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177455&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '76eb1c58-d0d2-436c-9ae8-95eac5a2b531', 'multiverseId': 177455}, 'multiverseid': 177455}, {'name': 'Île', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176395&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fb6ab489-21b7-4d4f-952d-77d3961dcf5f', 'multiverseId': 176395}, 'multiverseid': 176395}, {'name': 'Isola', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176904&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1097c387-848f-41bd-b687-c04edc7c4663', 'multiverseId': 176904}, 'multiverseid': 176904}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8fdcb7dc-1c3b-4805-8845-9c863f70fdb4'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178898&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'eb60d4b4-5492-425a-815e-c1c2be77f78b', 'multiverseId': 178898}, 'multiverseid': 178898}]", "[{'name': 'Insel', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176044&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6c47da04-dad1-4690-b16a-81bfc841c162', 'multiverseId': 176044}, 'multiverseid': 176044}, {'name': 'Isla', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177456&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '159ad10a-fd6f-4ea2-945a-f9c675ca0cea', 'multiverseId': 177456}, 'multiverseid': 177456}, {'name': 'Île', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176396&type=card', 'language': 'French', 'identifiers': {'scryfallId': '30f69c59-30e2-4f61-bd89-56ab632a3c04', 'multiverseId': 176396}, 'multiverseid': 176396}, {'name': 'Isola', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176905&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9e27c350-182f-4c20-abb3-88d5ccb52e77', 'multiverseId': 176905}, 'multiverseid': 176905}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0cf9a2d8-8742-4cfc-b1a1-b6a3b84073fe'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178899&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3b6dca36-bb09-4af2-b7dc-adb542582c8e', 'multiverseId': 178899}, 'multiverseid': 178899}]", "[{'name': 'Insel', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176045&type=card', 'language': 'German', 'identifiers': {'scryfallId': '40737625-dbed-4c0f-9751-2d8d67a94070', 'multiverseId': 176045}, 'multiverseid': 176045}, {'name': 'Isla', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177457&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e26e98d0-20cb-4fe4-bbdb-bc453410757d', 'multiverseId': 177457}, 'multiverseid': 177457}, {'name': 'Île', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176397&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3cfb6fe6-1f5c-4f45-9798-9e8f09e1a2e2', 'multiverseId': 176397}, 'multiverseid': 176397}, {'name': 'Isola', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176906&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '59eead41-b106-4ce8-8744-d08afe12d686', 'multiverseId': 176906}, 'multiverseid': 176906}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3b6dfaac-cace-4f28-8302-66fc599dfc34'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178900&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7a4db837-ecfc-4a35-a6ec-e93109e64f43', 'multiverseId': 178900}, 'multiverseid': 178900}]", "[{'name': 'Insel', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176046&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9de6924a-2a88-4ebf-806d-f2f201020aea', 'multiverseId': 176046}, 'multiverseid': 176046}, {'name': 'Isla', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177458&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '62466d43-6f61-4ec0-adb5-f59459c4b8f5', 'multiverseId': 177458}, 'multiverseid': 177458}, {'name': 'Île', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176398&type=card', 'language': 'French', 'identifiers': {'scryfallId': '053f4d7a-cd65-46c7-9069-14dcc49ffcba', 'multiverseId': 176398}, 'multiverseid': 176398}, {'name': 'Isola', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176907&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b36eeb62-b1d8-4166-89fd-60c537f70b76', 'multiverseId': 176907}, 'multiverseid': 176907}, {'name': '島', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '839d5d6a-a219-45e7-af94-b63b67800393'}, 'multiverseid': None}, {'name': 'Ilha', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178901&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '716c3259-307e-4f38-a90f-e5b23323dd86', 'multiverseId': 178901}, 'multiverseid': 178901}]", '[{\'name\': \'Junger Bold\', \'text\': \'{B}, wirf eine Karte aus deiner Hand ab: Der Junge Bold erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bold\', \'flavor\': \'Bolde können nicht von Geburt an fliegen nur anderen auf die Nerven gehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175845&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'66866ee2-c9a1-4d33-9b71-cf20460f2bd3\', \'multiverseId\': 175845}, \'multiverseid\': 175845}, {\'name\': \'Cría de diablillo\', \'text\': \'{B}, descartar una carta de tu mano: La Cría de diablillo gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Diablillo\', \'flavor\': \'Los diablillos no nacen sabiendo volar, sólo nacen sabiendo molestar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177257&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb905b5c-4e23-4aaa-95fc-01007897f72c\', \'multiverseId\': 177257}, \'multiverseid\': 177257}, {\'name\': \'Diablotaillon\', \'text\': "{B}, défaussez-vous d\'une carte de votre main : Le Diablotaillon acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : diablotin\', \'flavor\': \'Volant, certes, mais surtout blessant, énervant, irritant.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176197&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'db3c93de-50ec-450e-a2d3-214d3c7a0603\', \'multiverseId\': 176197}, \'multiverseid\': 176197}, {\'name\': \'Demonietto Novello\', \'text\': \'{B}, Scarta una carta dalla tua mano: Il Demonietto Novello guadagna volare fino alla fine del turno.\', \'type\': \'Creatura — Demonietto\', \'flavor\': \'Quando nascono i demonietti non sanno volare, ma sono già bravissimi a dare fastidio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176706&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ecb6601b-15dd-4265-896d-051054e94e20\', \'multiverseId\': 176706}, \'multiverseid\': 176706}, {\'name\': \'巣立つインプ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a4ea0f5-c0ca-4dd5-a205-5cf48912533b\'}, \'multiverseid\': None}, {\'name\': \'Diabrete Inexperiente\', \'text\': \'{B}, Descarte um card de sua mão: Diabrete Inexperiente ganha a habilidade de voar até o final do turno.\', \'type\': \'Criatura — Diabrete\', \'flavor\': \'Os diabretes não nascem sabendo voar — só sabem atormentar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178700&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1e1978d8-7862-4e25-965b-74e6f80ae83e\', \'multiverseId\': 178700}, \'multiverseid\': 178700}]', '[{\'name\': \'Kabbalisten-Grube\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {B}. Die Kabbalisten-Grube fügt dir 1 Schadenspunkt zu.\\nGrenzwert {B}, {T}, opfere die Kabbalisten-Grube: Eine Kreatur deiner Wahl erhält -2/-2 bis zum Ende des Zuges. (Spiele diese Fähigkeit nur, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176023&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d351ac8-e0f5-4753-aa27-a8d63e5b9a52\', \'multiverseId\': 176023}, \'multiverseid\': 176023}, {\'name\': \'Foso de la Cábala\', \'text\': \'{T}: Agrega {B} a tu reserva de maná. El Foso de la Cábala te hace 1 punto de daño.\\nUmbral {B}, {T}, sacrificar el Foso de la Cábala: La criatura objetivo obtiene -2/-2 hasta el final del turno. (Juega esta habilidad sólo si hay siete o más cartas en tu cementerio.)\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177435&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1fcdbbbc-397a-407e-a156-e1942f330784\', \'multiverseId\': 177435}, \'multiverseid\': 177435}, {\'name\': \'Rahba de la Coterie\', \'text\': "{T} : Ajoutez {B} à votre réserve. La Rahba de la Coterie vous inflige 1 blessure.\\nSeuil — {B}, {T}, sacrifiez la Rahba de la Coterie : La créature ciblée gagne -2/-2 jusqu\'à la fin du tour. (Ne jouez cette capacité que s\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176375&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee4da00b-27ab-4db8-b248-330d2a38fbe6\', \'multiverseId\': 176375}, \'multiverseid\': 176375}, {\'name\': \'Fossa della Cabala\', \'text\': \'{T}: Aggiungi {B} alla tua riserva di mana. La Fossa della Cabala ti infligge 1 danno.\\nSoglia {B}, {T}, Sacrifica la Fossa della Cabala: La creatura bersaglio prende -2/-2 fino alla fine del turno (gioca questa abilità solo se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176884&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'22e3a71c-ce86-418d-ba2c-cb45a1fe3403\', \'multiverseId\': 176884}, \'multiverseid\': 176884}, {\'name\': \'陰謀団のピット\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e6e4fed-7b3c-45e3-8ccf-4b9bc72a5a0e\'}, \'multiverseid\': None}, {\'name\': \'Liça da Cabala\', \'text\': \'{T}: Adiciona {B} à sua reserva de mana. Liça da Cabala causa 1 ponto de dano a você.\\nLimiar — {B}, {T}, Sacrifique Liça da Cabala: A criatura alvo recebe -2/-2 até o final do turno. (Use esta habilidade apenas se você tiver sete ou mais cards em seu cemitério.)\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178878&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cd128cb9-cd82-47f0-a5f9-3eb46ddc9084\', \'multiverseId\': 178878}, \'multiverseid\': 178878}]', '[{\'name\': \'Kabbalisten-Inquisitor\', \'text\': \'Grenzwert {1}{B}, {T}, entferne zwei Karten aus deinem Friedhof ganz aus dem Spiel: Ein Spieler deiner Wahl wirft eine Karte aus seiner Hand ab. Spiele diese Fähigkeit nur zu einem Zeitpunkt, zu dem du auch eine Hexerei spielen könntest. (Spiele diese Fähigkeit nur, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Diener\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175827&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57647659-a20c-4365-a1b8-f18ce5d92700\', \'multiverseId\': 175827}, \'multiverseid\': 175827}, {\'name\': \'Inquisidor de la Cábala\', \'text\': \'Umbral {1}{B}, {T}, remover del juego dos cartas de tu cementerio: El jugador objetivo descarta una carta de su mano. Juega esta habilidad sólo en cualquier momento en que pudieras jugar un conjuro. (Juega esta habilidad sólo si hay siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Sicario\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177239&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f0acf76-1836-4b7a-b253-2bb4836ea5b2\', \'multiverseId\': 177239}, \'multiverseid\': 177239}, {\'name\': \'Inquisiteur de la Coterie\', \'text\': "Seuil — {1}{B}, {T}, retirez de la partie deux cartes de votre cimetière : Le joueur ciblé se défausse d\'une carte de sa main. Ne jouez cette capacité que lorsque vous pourriez jouer un rituel. (Ne jouez cette capacité que s\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : mignon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176179&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a343c90-acfb-47d2-9731-db1c6a98f00f\', \'multiverseId\': 176179}, \'multiverseid\': 176179}, {\'name\': \'Inquisitore della Cabala\', \'text\': \'Soglia {1}{B}, {T}, Rimuovi dal gioco due carte presenti nel tuo cimitero: Il giocatore bersaglio scarta una carta dalla propria mano. Gioca questa abilità solo quando potresti giocare una stregoneria. (gioca questa abilità solo se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Servitore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176688&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0c047e8-bd99-458a-a161-97eb0b355035\', \'multiverseId\': 176688}, \'multiverseid\': 176688}, {\'name\': \'陰謀団の尋問者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b38bc97d-5524-4b5c-a686-f49dc8cbf3ad\'}, \'multiverseid\': None}, {\'name\': \'Inquisidor da Cabala\', \'text\': \'Limiar — {1}{B}, {T}, Remova de jogo dois cards de seu cemitério: O jogador alvo descarta um card de sua própria mão. Use esta habilidade somente quando pudesse jogar um feitiço. (Use esta habilidade apenas se você tiver sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Assecla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178682&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e31843a-0b84-4b91-8db7-b620be50ff58\', \'multiverseId\': 178682}, \'multiverseid\': 178682}]', '[{\'name\': \'Kabbalisten-Schrein\', \'text\': \'Immer wenn ein Spieler einen Zauberspruch ausspielt, wirft er X Karten aus seiner Hand ab, wobei X die Anzahl der Karten mit dem gleichen Namen wie dieser Zauberspruch in allen Friedhöfen ist.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175829&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9380fc0e-1f8c-4c00-9994-8467044123c5\', \'multiverseId\': 175829}, \'multiverseid\': 175829}, {\'name\': \'Altar de la Cábala\', \'text\': \'Siempre que un jugador juegue un hechizo, ese jugador descarta X cartas de su mano, donde X es el número de cartas que haya en todos los cementerios que tengan el mismo nombre que ese hechizo.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177241&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a832132-3701-49ea-ad12-c85edddf9672\', \'multiverseId\': 177241}, \'multiverseid\': 177241}, {\'name\': \'Reliquaire de la Coterie\', \'text\': "À chaque fois qu\'un joueur joue un sort, ce joueur se défausse de X cartes de sa main, X étant le nombre de cartes dans tous les cimetières ayant le même nom que ce sort.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176181&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3c16914b-1b1f-4834-b61b-22c3b122224b\', \'multiverseId\': 176181}, \'multiverseid\': 176181}, {\'name\': \'Santuario della Cabala\', \'text\': \'Ogniqualvolta un giocatore gioca una magia, quel giocatore scarta X carte dalla propria mano, dove X è pari al numero di carte presenti in tutti i cimiteri con lo stesso nome di quella magia.\', \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176690&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e62a42d2-9a9c-4fa8-a01f-e4333436fb1a\', \'multiverseId\': 176690}, \'multiverseid\': 176690}, {\'name\': \'陰謀団の祭殿\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59b7918e-147c-4452-8fd6-fef8dfb164f6\'}, \'multiverseid\': None}, {\'name\': \'Sacrário da Cabala\', \'text\': \'Toda vez que um jogador joga uma mágica, aquele jogador descarta X cards de sua própria mão, onde X é igual ao número de cards com o mesmo nome daquela mágica em todos os cemitérios.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178684&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fefffa8c-7936-4126-ae7a-02f26e2e4170\', \'multiverseId\': 178684}, \'multiverseid\': 178684}]', '[{\'name\': \'Kadaverreißer\', \'text\': \'Stärke und Widerstandskraft des Kadaverreißers sind gleich der Anzahl der Kreaturenkarten auf allen Friedhöfen.\\n{B}: Regeneriere den Kadaverreißer.\', \'type\': \'Kreatur — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175860&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'083ea7e8-69f1-462a-aa4a-70890d0143cf\', \'multiverseId\': 175860}, \'multiverseid\': 175860}, {\'name\': \'Mortívoro\', \'text\': \'Tanto la fuerza como la resistencia del Mortívoro son iguales al número de cartas de criatura que haya en todos los cementerios.\\n{B}: Regenera al Mortívoro.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6324896d-46d3-41ca-bb99-3c96adb39806\', \'multiverseId\': 177272}, \'multiverseid\': 177272}, {\'name\': \'Nécrovore\', \'text\': "La force et l\'endurance du Nécrovore sont chacune égale au nombre de cartes de créature dans tous les cimetières.\\n{B}: Régénérez le Nécrovore.", \'type\': \'Créature : lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176212&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6e2c89b8-1688-4ed0-888b-d644b590719a\', \'multiverseId\': 176212}, \'multiverseid\': 176212}, {\'name\': \'Mortivoro\', \'text\': \'La forza e la costituzione del Mortivoro sono pari ciascuna al numero di carte creatura presenti in tutti i cimiteri.\\n{B}: Rigenera il Mortivoro.\', \'type\': \'Creatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176721&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6077b870-a52b-40ac-97d7-bc9b7203b915\', \'multiverseId\': 176721}, \'multiverseid\': 176721}, {\'name\': \'死を食うもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c281c25-5648-4420-a459-824460d49c50\'}, \'multiverseid\': None}, {\'name\': \'Mortívoro\', \'text\': \'O poder e a resistência de Mortívoro são ambos iguais ao número de cards de criatura em todos os cemitérios.\\n{B}: Regenera Mortívoro.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178715&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'833c359b-6623-4706-a092-b57a0d17f41b\', \'multiverseId\': 178715}, \'multiverseid\': 178715}]', '[{\'name\': \'Kaiser Aboshan\', \'text\': \'Tappe einen ungetappten Zephaliden, den du kontrollierst: Tappe eine bleibende Karte deiner Wahl.\\n{U}{U}{U}: Tappe alle nichtfliegenden Kreaturen.\', \'type\': \'Kreatur — Zephalid, Legende\', \'flavor\': \'„Niemand kann ewig gegen die Flut ankämpfen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175766&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'85eaad7b-a610-48d0-bce5-f6d8e2b0b39a\', \'multiverseId\': 175766}, \'multiverseid\': 175766}, {\'name\': \'Áboshan, Emperador cefálido\', \'text\': \'Girar un Cefálido enderezado que controles: Gira el permanente objetivo.\\n{U}{U}{U}: Gira todas las criaturas que no tengan la habilidad de volar.\', \'type\': \'Criatura — Cefálido legendario\', \'flavor\': \'"Nadie puede luchar eternamente contra la marea."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177178&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'77c7bf96-7867-44cf-b6a1-9d13f1c68ed7\', \'multiverseId\': 177178}, \'multiverseid\': 177178}, {\'name\': \'Aboshân, empereur des Céphalides\', \'text\': \'Engagez un céphalide dégagé que vous contrôlez : Engagez le permanent ciblé.\\n{U}{U}{U}: Engagez toutes les créatures sans le vol.\', \'type\': \'Créature : céphalide et légende\', \'flavor\': \'« On ne peut se battre sans arrêt contre la marée. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176118&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c03af1db-48fa-4303-8d3d-6e8b034379cb\', \'multiverseId\': 176118}, \'multiverseid\': 176118}, {\'name\': \'Aboshan, Imperatore Cefalide\', \'text\': \'TAPpa un Cefalide STAPpato che controlli: TAPpa un permanente bersaglio.\\n{U}{U}{U}: TAPpa tutte le creature senza volare.\', \'type\': \'Creatura — Leggenda Cefalide\', \'flavor\': \'"Nessuno può combattere la corrente in eterno".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176627&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bb63f05b-1263-4db0-bc99-1742a86f7a87\', \'multiverseId\': 176627}, \'multiverseid\': 176627}, {\'name\': \'セファリッドの皇帝アボシャン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6661a6da-30c0-4985-8e46-7cf1e21e6475\'}, \'multiverseid\': None}, {\'name\': \'Aboshan, Imperador Cefálida\', \'text\': \'Vire um Cefálida desvirado que você controla: Vira a permanente alvo.\\n{U}{U}{U}: Vira todas as criaturas sem a habilidade de voar.\', \'type\': \'Criatura — Cefálida Lenda\', \'flavor\': \'"Ninguém pode lutar contra a maré para sempre."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178621&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f89ae381-8f60-4ced-8e1c-d566a03c81b9\', \'multiverseId\': 178621}, \'multiverseid\': 178621}]', '[{\'name\': \'Kalksteingolem\', \'text\': \'{2}, opfere den Kalksteingolem: Ein Spieler deiner Wahl zieht eine Karte.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Man sagt Zwergen nach, dass sie selbst ihre eigenen Schöpfungen mit Pickeln bearbeiten, in der Hoffnung, Schätze darin zu finden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176009&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ee32503-d651-4113-8d06-36a6354d0a74\', \'multiverseId\': 176009}, \'multiverseid\': 176009}, {\'name\': \'Gólem de piedra caliza\', \'text\': \'{2}, sacrificar el Gólem de piedra caliza: El jugador objetivo roba una carta.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Se sabe que los enanos han destruido con zapapico sus propias creaciones esperando encontrar tesoros dentro de ellas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177421&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'70d95058-e246-4000-83d6-1a0b9d0cd620\', \'multiverseId\': 177421}, \'multiverseid\': 177421}, {\'name\': \'Golem de calcaire\', \'text\': \'{2}, sacrifiez le Golem de calcaire : Le joueur ciblé pioche une carte.\', \'type\': \'Créature-artefact : golem\', \'flavor\': \'On prétend que des nains ont démoli certaines de leurs propres créations, espérant y découvrir des trésors oubliés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176361&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69a29887-c847-4a0c-9369-815d2c594ead\', \'multiverseId\': 176361}, \'multiverseid\': 176361}, {\'name\': \'Golem di Calcare\', \'text\': \'{2}, Sacrifica il Golem di Calcare: Il giocatore bersaglio pesca una carta.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': "Si racconta che i nani distruggano a colpi d\'ascia le proprie creazioni, per vedere se al loro interno si nasconde qualche tesoro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176870&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'67c722c7-6577-49e9-a585-38712cd0dd9f\', \'multiverseId\': 176870}, \'multiverseid\': 176870}, {\'name\': \'石灰石のゴーレム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bcabab42-07e0-4bfb-a6ac-b4399ebe34dd\'}, \'multiverseid\': None}, {\'name\': \'Golem de Calcário\', \'text\': \'{2}, Sacrifique Golem de Calcário: O jogador alvo compra um card.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Os anões são conhecidos por dar picaretadas em suas próprias criações, na esperança de encontrar tesouros dentro delas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178864&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e25e8da6-2422-4c58-b4a7-b7b50e5856ad\', \'multiverseId\': 178864}, \'multiverseid\': 178864}]', '[{\'name\': \'Kamahl, der Grubenkämpfer\', \'text\': \'Eile\\n{T}: Kamahl, der Grubenkämpfer fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Barbar, Legende\', \'flavor\': \'„Ich bin nicht zum Spielen hergekommen. Ich kam, um zu siegen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175906&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eda697fc-37d2-4e89-9a1d-44a647bddfe7\', \'multiverseId\': 175906}, \'multiverseid\': 175906}, {\'name\': \'Kamahl, luchador del foso\', \'text\': \'Prisa.\\n{T}: Kamahl, luchador del foso hace 3 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Bárbaro legendario\', \'flavor\': \'"No vine a jugar. Vine a ganar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177318&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9e6b3edb-ac2f-4dee-93e2-869dcfa28ad7\', \'multiverseId\': 177318}, \'multiverseid\': 177318}, {\'name\': \'Kamahl, sangrahbaire\', \'text\': \'Célérité\\n{T}: Kamahl, sangrahbaire, inflige 3 blessures à une cible, créature ou joueur.\', \'type\': \'Créature : barbare et légende\', \'flavor\': \'« Je ne suis pas venu pour jouer. Je suis venu pour gagner. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176258&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da1b27a5-ed4e-4b80-a7f7-ec176a966077\', \'multiverseId\': 176258}, \'multiverseid\': 176258}, {\'name\': "Kamahl, Combattente dell\'Arena", \'text\': "Rapidità\\n{T}: Kamahl, Combattente dell\'Arena infligge 3 danni a una creatura o a un giocatore bersaglio.", \'type\': \'Creatura — Leggenda Barbara\', \'flavor\': \'"Non sono qui per partecipare. Sono qui per vincere".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176767&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'837cc5f2-c91c-4bd2-a053-ba3e46510bbd\', \'multiverseId\': 176767}, \'multiverseid\': 176767}, {\'name\': \'ピット・ファイター、カマール\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a73939e-58c8-4f93-884a-2ce08f2ad235\'}, \'multiverseid\': None}, {\'name\': \'Kamahl, Lutador da Liça\', \'text\': \'Ímpeto\\n{T}: Kamahl, Lutador da Liça causa 3 pontos de dano à criatura alvo ou ao jogador alvo.\', \'type\': \'Criatura — Bárbaro Lenda\', \'flavor\': \'"Eu não vim para competir. Vim para ganhar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178761&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0f8ca5e5-917a-4b36-8f75-4a405aebad99\', \'multiverseId\': 178761}, \'multiverseid\': 178761}]', '[{\'name\': \'Kamahls Verlangen\', \'text\': \'Die verzauberte Kreatur hat Erstschlag.\\nGrenzwert Die verzauberte Kreatur erhält +3/+0. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreaturenverzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175907&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'577e9c6a-3015-49fd-ba12-d6a3de44d282\', \'multiverseId\': 175907}, \'multiverseid\': 175907}, {\'name\': \'Deseo de Kamahl\', \'text\': \'La criatura encantada tiene la habilidad de dañar primero.\\nUmbral La criatura encantada obtiene +3/+0. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Encantar criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177319&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ab7d93a-0a0f-4162-babe-8e3d7b0e1009\', \'multiverseId\': 177319}, \'multiverseid\': 177319}, {\'name\': \'Désir selon Kamahl\', \'text\': "La créature enchantée a l\'initiative.\\nSeuil — La créature enchantée gagne +3/+0. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Enchanter : créature\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176259&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'df69c9c8-7075-4961-9950-6a7e122f8f36\', \'multiverseId\': 176259}, \'multiverseid\': 176259}, {\'name\': \'Desiderio di Kamahl\', \'text\': \'La creatura incantata ha attacco improvviso.\\nSoglia - La creatura incantata prende +3/+0 (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Incanta Creatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176768&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'35e81149-55ea-42bb-a2d0-9c6e6df81912\', \'multiverseId\': 176768}, \'multiverseid\': 176768}, {\'name\': \'カマールの願望\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'617a9d21-3ebb-41c4-a96f-a1285924b7ef\'}, \'multiverseid\': None}, {\'name\': \'Desejo de Kamahl\', \'text\': \'A criatura encantada tem iniciativa.\\nLimiar — A criatura encantada recebe +3/+0. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Encantar Criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178762&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e6d1cbb2-289a-402d-9559-2b0952e43641\', \'multiverseId\': 178762}, \'multiverseid\': 178762}]', '[{\'name\': \'Kampfstrapaze\', \'text\': \'Immer wenn eine Kreatur blockt, fügt Kampfstrapaze dem Beherrscher dieser Kreatur 1 Schadenspunkt zu.\', \'type\': \'Verzauberung\', \'flavor\': \'Die Gruben schlucken die Schwachen, wie die Raubvögel ihre Beute verschlingen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175885&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52287c36-62f7-4962-9cb9-2082d155752b\', \'multiverseId\': 175885}, \'multiverseid\': 175885}, {\'name\': \'Agotamiento por la batalla\', \'text\': \'Siempre que una criatura bloquee, el Agotamiento por la batalla hace 1 punto de daño al controlador de esa criatura.\', \'type\': \'Encantamiento\', \'flavor\': \'Los fosos se tragan a los débiles como los depredadores se tragan a las presas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177297&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c9d1f26d-e388-44b6-be1d-914662697bc9\', \'multiverseId\': 177297}, \'multiverseid\': 177297}, {\'name\': \'Tension de la bataille\', \'text\': "À chaque fois qu\'une créature bloque, la Tension de la bataille inflige 1 blessure au contrôleur de cette créature.", \'type\': \'Enchantement\', \'flavor\': \'Les rahbas éliminent les faibles comme les prédateurs leurs proies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176237&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce1f0507-1dc6-4798-8f2c-0a7548a931b5\', \'multiverseId\': 176237}, \'multiverseid\': 176237}, {\'name\': \'Affaticamento da Battaglia\', \'text\': "Ogniqualvolta una creatura blocca, l\'Affaticamento da Battaglia infligge 1 danno al controllore di quella creatura.", \'type\': \'Incantesimo\', \'flavor\': "L\'arena inghiotte i deboli così come i predatori inghiottono le prede.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176746&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'319823a9-c09a-4b76-9903-8358970081b3\', \'multiverseId\': 176746}, \'multiverseid\': 176746}, {\'name\': \'戦いの重圧\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bacc5370-458e-40d5-80f1-2ac9ed7cad38\'}, \'multiverseid\': None}, {\'name\': \'Tensão da Batalha\', \'text\': \'Toda vez que uma criatura bloquear, Tensão da Batalha causa 1 ponto de dano ao controlador daquela criatura.\', \'type\': \'Encantamento\', \'flavor\': \'A liça engole os fracos assim como os predadores engolem suas presas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178740&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'49612b86-79f9-477c-8f87-b2eaf55de629\', \'multiverseId\': 178740}, \'multiverseid\': 178740}]', '[{\'name\': \'Kartenzeichner\', \'text\': \'Wenn der Kartenzeichner ins Spiel kommt, kannst du ein Land deiner Wahl aus deinem Friedhof auf deine Hand zurückbringen.\', \'type\': \'Kreatur — Stadtbewohner\', \'flavor\': \'„Einmal den Weg finden ist eine glückliche Fügung. Zweimal den Weg finden bedeutet eine gute Karte zu haben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b4aa320-2b28-4edb-9d8a-fbeaa81c628f\', \'multiverseId\': 175940}, \'multiverseid\': 175940}, {\'name\': \'Cartógrafo\', \'text\': \'Cuando el Cartógrafo entre en juego, puedes regresar la carta objetivo de tierra de tu cementerio a tu mano.\', \'type\': \'Criatura — Ciudadano\', \'flavor\': \'"Encontrar el camino una vez es suerte. Encontrar el camino dos veces requiere de un buen mapa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177352&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71d53cd0-e580-4d56-a017-da543d13ef8c\', \'multiverseId\': 177352}, \'multiverseid\': 177352}, {\'name\': \'Cartographe\', \'text\': \'Quand la Cartographe arrive en jeu, vous pouvez renvoyer une carte de terrain ciblée depuis votre cimetière dans votre main.\', \'type\': \'Créature : citadin\', \'flavor\': \'« Pour trouver son chemin, il faut un peu de chance ; pour le retrouver, mieux vaut une bonne carte. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176292&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ebef0fc2-b3ea-4947-89cf-53314bede788\', \'multiverseId\': 176292}, \'multiverseid\': 176292}, {\'name\': \'Cartografo\', \'text\': \'Quando il Cartografo entra in gioco, puoi riprendere in mano una carta terra bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Cittadino\', \'flavor\': \'"Trovare la strada una volta è questione di fortuna. Trovarla una seconda è questione di mappe".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176801&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5be198d3-df3f-4b51-b696-70e41ba33b53\', \'multiverseId\': 176801}, \'multiverseid\': 176801}, {\'name\': \'地図作り\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63d1444a-450d-4d1e-ab10-27dab445666e\'}, \'multiverseid\': None}, {\'name\': \'Cartógrafo\', \'text\': \'Quando Cartógrafo entra em jogo, você pode devolver o card de terreno alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Citadino\', \'flavor\': \'"Encontrar o caminho uma vez é pura sorte. Para encontrá-lo duas vezes é preciso ter um bom mapa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178795&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5a943e55-9985-4304-a8e8-c689027b10e5\', \'multiverseId\': 178795}, \'multiverseid\': 178795}]', '[{\'name\': \'Katalysatorstein\', \'text\': \'Rückblendekosten, die du bezahlst, kosten bis zu {2} weniger.\\nRückblendekosten, die deine Gegner bezahlen, kosten {2} mehr.\', \'type\': \'Artefakt\', \'flavor\': \'Das Weißglühen des Edelsteins wandert durch die Träume aller, die ihn gesehen haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176005&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e6e894b2-81b6-4fce-ab46-4461388f45df\', \'multiverseId\': 176005}, \'multiverseid\': 176005}, {\'name\': \'Piedra catalizadora\', \'text\': \'Te cuesta hasta {2} menos pagar los costes de retrospectiva.\\nA tus oponentes les cuesta {2} más pagar los costes de retrospectiva.\', \'type\': \'Artefacto\', \'flavor\': \'La incandescencia de las gemas invade los sueños de todos los que las ven.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177417&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2516c936-c4ba-417b-ae16-139f6a50b4a7\', \'multiverseId\': 177417}, \'multiverseid\': 177417}, {\'name\': \'Pierre catalytique\', \'text\': "Les coûts de flashback vous coûtent jusqu\'à {2} de moins à payer.\\nLes coûts de flashback coûtent à vos adversaires {2} de plus à payer.", \'type\': \'Artefact\', \'flavor\': \'Iridescentes, incandescentes, adamantines, les gemmes envahissent les rêves.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176357&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a458acb7-500a-441b-8c60-aca6478b98a7\', \'multiverseId\': 176357}, \'multiverseid\': 176357}, {\'name\': \'Pietra Catalizzante\', \'text\': \'I costi di flashback che tu paghi costano fino a {2} in meno.\\nI costi di flashback che i tuoi avversari pagano costano {2} in più.\', \'type\': \'Artefatto\', \'flavor\': "L\'incandescenza delle gemme invade i sogni di chi le vede.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176866&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'859f32c8-ce2c-4230-9bec-4c75975b82aa\', \'multiverseId\': 176866}, \'multiverseid\': 176866}, {\'name\': \'触媒石\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'308ff7dd-fda4-4a87-9085-3e042f51e434\'}, \'multiverseid\': None}, {\'name\': \'Pedra Catalisadora\', \'text\': \'Os custos de recapitulação que você paga custam até {2} a menos.\\nOs custos de recapitulação que o seu oponente paga custam {2} a mais.\', \'type\': \'Artefato\', \'flavor\': \'A incandescência das gemas invade os sonhos de todos que as vêem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd40ab37-e991-4c95-8665-9cd1e73cef89\', \'multiverseId\': 178860}, \'multiverseid\': 178860}]', '[{\'name\': \'Kettenschleuderer\', \'text\': \'{1}{R}, {T}: Der Kettenschleuderer fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\\nGrenzwert {2}{R}, {T}: Der Kettenschleuderer fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu. (Spiele diese Fähigkeit nur, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175889&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6aa2e188-f56a-43a0-a4b1-8c8e79af68c5\', \'multiverseId\': 175889}, \'multiverseid\': 175889}, {\'name\': \'Tiracadenas\', \'text\': \'{1}{R}, {T}: El Tiracadenas hace 1 punto de daño a la criatura o jugador objetivo.\\nUmbral {2}{R}, {T}: El Tiracadenas hace 2 puntos de daño a la criatura o jugador objetivo. (Juega esta habilidad sólo si hay siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177301&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27baca6f-89ab-483e-95dd-48fb3292c8fb\', \'multiverseId\': 177301}, \'multiverseid\': 177301}, {\'name\': \'Celui qui lance des chaînes\', \'text\': "{1}{R}, {T}: Celui qui lance des chaînes inflige 1 blessure à une cible, créature ou joueur.\\nSeuil — {2}{R}, {T}: Celui qui lance des chaînes inflige 2 blessures à une cible, créature ou joueur. (Ne jouez cette capacité que s\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176241&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f824fc62-6512-4d36-bcd7-4dce92c1262c\', \'multiverseId\': 176241}, \'multiverseid\': 176241}, {\'name\': \'Scaglia Catena\', \'text\': \'{1}{R}, {T}: Lo Scaglia Catena infligge 1 danno a una creatura o a un giocatore bersaglio.\\nSoglia - {2}{R}, {T}: Lo Scaglia Catena infligge 2 danni a una creatura o a un giocatore bersaglio (gioca questa abilità solo se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176750&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6739b68a-de55-4bda-a1ea-c77952ff16b2\', \'multiverseId\': 176750}, \'multiverseid\': 176750}, {\'name\': \'投鎖獣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0dd6666b-01c6-449a-85fa-bec23139e173\'}, \'multiverseid\': None}, {\'name\': \'Atirador de Correntes\', \'text\': \'{1}{R}, {T}: Atirador de Correntes causa 1 ponto de dano à criatura alvo ou ao jogador alvo.\\nLimiar — {2}{R}, {T}: Atirador de Correntes causa 2 pontos de dano à criatura alvo ou ao jogador alvo. (Use esta habilidade apenas se você tiver sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178744&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'215ba227-6b01-4301-97b3-e7fc3794311a\', \'multiverseId\': 178744}, \'multiverseid\': 178744}]', '[{\'name\': \'Kinderschreck\', \'text\': \'Fliegend\\nGrenzwert Der Kinderschreck erhält +2/+2 und kann nicht blocken. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175831&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b09121b1-ea83-448b-8454-e34df3eac2b0\', \'multiverseId\': 175831}, \'multiverseid\': 175831}, {\'name\': \'Horror de infancia\', \'text\': \'Vuela.\\nUmbral El Horror de infancia obtiene +2/+2 y no puede bloquear. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177243&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b26e978-8595-4046-92a3-93f2582a0cf4\', \'multiverseId\': 177243}, \'multiverseid\': 177243}, {\'name\': \'Horreur enfantine\', \'text\': "Vol\\nSeuil — L\'Horreur enfantine gagne +2/+2 et ne peut pas bloquer. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176183&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5fb6a632-f258-4426-a850-e11a7ab91b82\', \'multiverseId\': 176183}, \'multiverseid\': 176183}, {\'name\': "Orrore dell\'Infanzia", \'text\': "Volare\\nSoglia L\'Orrore dell\'Infanzia prende +2/+2 e non può bloccare (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).", \'type\': \'Creatura — Orrore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176692&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cba81122-ab05-48bb-89ef-d00da0b6c85c\', \'multiverseId\': 176692}, \'multiverseid\': 176692}, {\'name\': \'幼年期の怪物\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b7c61735-2466-4943-a1eb-c4a2d994ced4\'}, \'multiverseid\': None}, {\'name\': \'Horror da Infância\', \'text\': \'Voar\\nLimiar — Horror da Infância recebe +2/+2 e não pode bloquear. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178686&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed2e049e-d43d-4491-b976-f5fd06ed675d\', \'multiverseId\': 178686}, \'multiverseid\': 178686}]', '[{\'name\': \'Kirtars Verlangen\', \'text\': \'Die verzauberte Kreatur kann nicht angreifen.\\nGrenzwert Die verzauberte Kreatur kann nicht blocken. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreaturenverzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c3673e1c-cf9b-4bdf-a702-6cf30c07bedd\', \'multiverseId\': 175735}, \'multiverseid\': 175735}, {\'name\': \'Deseo de Kírtar\', \'text\': \'La criatura encantada no puede atacar.\\nUmbral La criatura encantada no puede bloquear. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Encantar criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177147&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25a2b752-df10-48cd-884c-a0042759779b\', \'multiverseId\': 177147}, \'multiverseid\': 177147}, {\'name\': \'Désir selon Kirtar\', \'text\': "La créature enchantée ne peut pas attaquer.\\nSeuil — La créature enchantée ne peut pas bloquer. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Enchanter : créature\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176087&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe20c21c-2de4-4d0d-8c96-5cb3b8213093\', \'multiverseId\': 176087}, \'multiverseid\': 176087}, {\'name\': \'Desiderio di Kirtar\', \'text\': \'La creatura incantata non può attaccare.\\nSoglia - La creatura incantata non può bloccare (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Incanta Creatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176596&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c38063b3-34b3-4c70-8f20-f81e962f5d3a\', \'multiverseId\': 176596}, \'multiverseid\': 176596}, {\'name\': \'カーターの願望\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'56aed351-c743-40f6-bae1-6c755ef11d9b\'}, \'multiverseid\': None}, {\'name\': \'Desejo de Kirtar\', \'text\': \'A criatura encantada não pode atacar.\\nLimiar - A criatura encantada não pode bloquear. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Encantar Criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178590&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d0f407a3-2937-4314-82ce-5abf1e19088f\', \'multiverseId\': 178590}, \'multiverseid\': 178590}]', "[{'name': 'Kirtars Zorn', 'text': 'Zerstöre alle Kreaturen. Sie können nicht regeneriert werden.\\nGrenzwert Zerstöre stattdessen alle Kreaturen und bringe dann zwei 1/1 weiße Geist-Spielsteine mit Flugfähigkeit ins Spiel. Kreaturen, die auf diese Weise zerstört werden, können nicht regeneriert werden. (Du hast den Grenzwert erreicht, falls sieben oder mehr Karten in deinem Friedhof sind.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175736&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8ec7c95a-77c3-4d00-b2a3-02e7e62a79c6', 'multiverseId': 175736}, 'multiverseid': 175736}, {'name': 'Ira de Kírtar', 'text': 'Destruye todas las criaturas. No pueden ser regeneradas.\\nUmbral En vez de eso, destruye todas las criaturas, luego pon en juego dos fichas de criatura Espíritu blanca 1/1 con la habilidad de volar. Las criaturas destruidas de esta manera no pueden ser regeneradas. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177148&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5ba7a6e6-42db-4b70-91ee-408ab6ecb5ca', 'multiverseId': 177148}, 'multiverseid': 177148}, {'name': 'Colère selon Kirtar', 'text': 'Détruisez toutes les créatures. Elles ne peuvent pas être régénérées.\\nSeuil — Détruisez à la place toutes les créatures, puis mettez en jeu deux jetons de créature 1/1 blanche Esprit avec le vol. Les créatures détruites de cette manière ne peuvent pas être régénérées. (Vous avez le seuil si sept cartes ou plus sont dans votre cimetière.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176088&type=card', 'language': 'French', 'identifiers': {'scryfallId': '852a8983-ea26-475c-873f-8551b388fb1e', 'multiverseId': 176088}, 'multiverseid': 176088}, {'name': 'Ira di Kirtar', 'text': 'Distruggi tutte le creature. Non possono essere rigenerate.\\nSoglia - Distruggi invece tutte le creature, poi metti in gioco due pedine creatura Spirito 1/1 bianche con volare. Le creature distrutte in questo modo non possono essere rigenerate. (hai soglia se ci sono almeno sette carte nel tuo cimitero).', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176597&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3eb8066e-5cd8-486d-9b5c-4affb860fc59', 'multiverseId': 176597}, 'multiverseid': 176597}, {'name': 'カーターの怒り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ed0ba36c-4f4a-4207-9c93-e0ec7ba0ab9d'}, 'multiverseid': None}, {'name': 'Ira de Kirtar', 'text': 'Destrói todas as criaturas. Elas não podem ser regeneradas.\\nLimiar - Ao invés disso, destrua todas as criaturas e depois coloque em jogo duas fichas de criatura branca 1/1 com a habilidade de voar, do tipo Espírito. As criaturas destruídas desta maneira não podem ser regeneradas. (Você atinge o limiar se houver sete ou mais cards em seu cemitério.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178591&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'da873790-3d4b-4aa4-a3d9-11b058b8a47c', 'multiverseId': 178591}, 'multiverseid': 178591}]", "[{'name': 'Knochen-Hellseherei', 'text': 'Entferne als zusätzliche Kosten, um Knochen-Hellseherei zu spielen, X Karten aus deinem Friedhof ganz aus dem Spiel.\\nDu ziehst X Karten und verlierst X Lebenspunkte.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175869&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dfdd03e7-1827-40f6-83c6-69acf94d27c4', 'multiverseId': 175869}, 'multiverseid': 175869}, {'name': 'Adivinación esquelética', 'text': 'Como coste adicional para jugar la Adivinación esquelética, remueve del juego X cartas de tu cementerio.\\nRoba X cartas y pierde X vidas.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177281&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1f255d1a-5adf-4517-9187-4a7a2c79de38', 'multiverseId': 177281}, 'multiverseid': 177281}, {'name': 'Regard du squelette', 'text': 'En tant que coût supplémentaire pour jouer le Regard du squelette, retirez de la partie X cartes de votre cimetière de la partie.\\nVous piochez X cartes et vous perdez X points de vie.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176221&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6e6c32eb-a19b-43b1-947d-e036dff97a4c', 'multiverseId': 176221}, 'multiverseid': 176221}, {'name': 'Premonizione Scheletrica', 'text': 'Come costo addizionale per giocare la Premonizione Scheletrica, rimuovi dal gioco X carte presenti nel tuo cimitero.\\nPeschi X carte e perdi X punti vita.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176730&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '75b6bb0a-ffaf-4694-b134-f7e59c284723', 'multiverseId': 176730}, 'multiverseid': 176730}, {'name': '占骨術', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'fdc67d02-7fd0-4a83-90fd-81c768dbeb0f'}, 'multiverseid': None}, {'name': 'Osseomancia', 'text': 'Como um custo adicional para jogar Osteomancia, remova de jogo X cards de seu cemitério.\\nVocê compra X cards e perde X pontos de vida.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178724&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd4151a55-e74a-4109-86e9-d32aa27b9087', 'multiverseId': 178724}, 'multiverseid': 178724}]", '[{\'name\': \'Kohlenregen\', \'text\': \'Der Kohlenregen fügt bis zu drei Kreaturen und/oder Spielern deiner Wahl je 2 Schadenspunkte zu.\\nGrenzwert Der Kohlenregen fügt diesen Kreaturen und/oder Spielern stattdessen 4 Schadenspunkte zu. (Du hast den Grenzwert erreicht, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175929&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a9dfb4d7-4d85-4768-91d6-65b6e14ec1b5\', \'multiverseId\': 175929}, \'multiverseid\': 175929}, {\'name\': \'Lluvia de carbones\', \'text\': \'La Lluvia de carbones hace 2 puntos de daño a cada una de hasta tres criaturas y/o jugadores objetivo.\\nUmbral En vez de eso, la Lluvia de carbones hace 4 puntos de daño a cada una de esas criaturas y/o jugadores. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177341&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd094776-c8df-4332-91a1-5e5360155a18\', \'multiverseId\': 177341}, \'multiverseid\': 177341}, {\'name\': \'Douche de charbons ardents\', \'text\': "La Douche de charbons ardents cible jusqu\'à trois créatures et/ou joueurs et leur inflige à chacun 2 blessures.\\nSeuil — La Douche de charbons ardents cible jusqu\'à trois créatures et/ou joueurs et leur inflige à chacun 4 blessures à la place. (Vous avez le seuil si sept cartes ou plus sont dans votre cimetière.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176281&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'234b1acd-41e6-49e5-be82-ad49f9b55329\', \'multiverseId\': 176281}, \'multiverseid\': 176281}, {\'name\': \'Pioggia di Carboni Ardenti\', \'text\': \'La Pioggia di Carboni Ardenti infligge 2 danni ciascuno a un massimo di tre creature e/o giocatori bersaglio.\\nSoglia - La Pioggia di Carboni Ardenti infligge invece 4 danni ciascuno a quelle creature e/o giocatori (hai soglia se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176790&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9dd0a869-81d2-40a8-afaa-93f58d42f21d\', \'multiverseId\': 176790}, \'multiverseid\': 176790}, {\'name\': \'降り注ぐ塊炭\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8fe20aaf-ccc6-4594-8496-c21a835b24af\'}, \'multiverseid\': None}, {\'name\': \'Chuva de Hulha\', \'text\': \'Chuva de Hulha causa 2 pontos de dano em cada uma de até três criaturas alvo e/ou jogadores alvo.\\nLimiar — Ao invés disso, Chuva de Hulha causa 4 pontos de dano àquelas criaturas e/ou jogadores. (Você atinge o limiar se houver sete ou mais cards em seu cemitério.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178784&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'06c26680-6de7-4877-93a5-85d28e6b0fe1\', \'multiverseId\': 178784}, \'multiverseid\': 178784}]', '[{\'name\': \'Konzentrieren\', \'text\': \'Ziehe drei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Schätze in meinem Gedächtnis sind mit allem weltlichen Ruhm nicht aufzuwiegen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175786&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cea6744c-8d54-4ce4-8610-a003da5be32c\', \'multiverseId\': 175786}, \'multiverseid\': 175786}, {\'name\': \'Concentrarse\', \'text\': \'Roba tres cartas.\', \'type\': \'Conjuro\', \'flavor\': \'"El tesoro en mi mente es más grande que cualquier gloria mundana."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177198&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3418749-3774-45be-91d3-a3ead918adda\', \'multiverseId\': 177198}, \'multiverseid\': 177198}, {\'name\': \'Concentration\', \'text\': \'Piochez trois cartes.\', \'type\': \'Rituel\', \'flavor\': \'« Je préfère les trésors de mon esprit à toutes les richesses de la terre. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176138&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b419995d-8b2b-4e9a-9a2b-6b284416f0c3\', \'multiverseId\': 176138}, \'multiverseid\': 176138}, {\'name\': \'Concentrare\', \'text\': \'Pesca tre carte.\', \'type\': \'Stregoneria\', \'flavor\': \'"Il tesoro che c\\\'è nella mia mente è più grande di tutti i beni terreni".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176647&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e5bed4e5-3290-429e-8fb4-1f6a60403f89\', \'multiverseId\': 176647}, \'multiverseid\': 176647}, {\'name\': \'集中\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'da7d1e15-e161-4396-b429-642d2035a6bd\'}, \'multiverseid\': None}, {\'name\': \'Concentrar\', \'text\': \'Compre três cards.\', \'type\': \'Feitiço\', \'flavor\': \'"O tesouro em minha mente é maior que qualquer glória mundana."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178641&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee380a16-4a29-4883-aa6b-1efb2485183a\', \'multiverseId\': 178641}, \'multiverseid\': 178641}]', '[{\'name\': \'Kristallsteinbruch\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein farbloses Mana.\\n{5}, {T}: Erhöhe deinen Manavorrat um {W}{U}{B}{R}{G}.\', \'type\': \'Land\', \'flavor\': \'„Wie tragisch, dass Gier die Schönheit verdunkelt." —Seton, Zentaurendruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176026&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af5de01a-9e80-4cee-b387-eb8c4c0b1de6\', \'multiverseId\': 176026}, \'multiverseid\': 176026}, {\'name\': \'Cantera de cristal\', \'text\': \'{T}: Agrega un maná incoloro a tu reserva de maná.\\n{5}, {T}: Agrega {W}{U}{B}{R}{G} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'"Qué trágico es que la codicia eclipse a la belleza." —Seton, druida centauro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177438&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e40ebe3-6fdc-4e8b-be87-7a7985a0bf57\', \'multiverseId\': 177438}, \'multiverseid\': 177438}, {\'name\': \'Carrière de cristal\', \'text\': \'{T}: Ajoutez un mana incolore à votre réserve.\\n{5}, {T}: Ajoutez {W}{U}{B}{R}{G} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': \'« Quelle tragédie quand la cupidité éclipse la beauté. » —Selton, druide centaure.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176378&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6b888b2-4c2e-4484-8b45-3f458380c4e3\', \'multiverseId\': 176378}, \'multiverseid\': 176378}, {\'name\': \'Cava di Cristallo\', \'text\': \'{T}: Aggiungi un mana incolore alla tua riserva.\\n{5}, {T}: Aggiungi {W}{U}{B}{R}{G} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': \'"È una tragedia che l\\\'avidità oscuri la bellezza". —Seton, druido centauro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176887&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'778ed18c-3c43-4870-807b-ebd96e3cf92e\', \'multiverseId\': 176887}, \'multiverseid\': 176887}, {\'name\': \'水晶の採石場\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'63fb053e-0e1e-44ca-8cb3-01ba39f1b0fa\'}, \'multiverseid\': None}, {\'name\': \'Mina de Cristal\', \'text\': \'{T}: Adiciona uma mana incolor à sua reserva de mana.\\n{5}, {T}: Adiciona {W}{U}{B}{R}{G} a sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'"É tão trágico que a cobiça oculte a beleza." — Seton, druida centauro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178881&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8414395a-d168-4918-b617-b372e8635052\', \'multiverseId\': 178881}, \'multiverseid\': 178881}]', '[{\'name\': \'Krosanische Bestie\', \'text\': \'Grenzwert Die Krosanische Bestie erhält +7/+7. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Eichhörnchen, Bestie\', \'flavor\': \'Wer die die Eichhörnchen im Winter dabei beobachtet, wie sie sich in Erdhöhlen verkriechen, ahnt selten, was im Frühling wieder aus diesen Höhlen herauskriecht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175956&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6073543a-48c6-4ceb-8ad6-9e37955e9a38\', \'multiverseId\': 175956}, \'multiverseid\': 175956}, {\'name\': \'Bestia krosana\', \'text\': \'Umbral La Bestia krosana obtiene +7/+7. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Bestia ardilla\', \'flavor\': \'Los que ven a las ardillas ir bajo tierra en el invierno no están listos para lo que emerge en la primavera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177368&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'34e75709-19d3-498e-a856-f048c88ec135\', \'multiverseId\': 177368}, \'multiverseid\': 177368}, {\'name\': \'Bête de la Krosia\', \'text\': "Seuil — La Bête de la Krosia gagne +7/+7. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : écureuil et bête\', \'flavor\': "Ceux qui voient les écureuils se calfeutrer pour l\'hiver ne peuvent imaginer ce qui surgit au printemps.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176308&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a34f5cf6-7cfa-4eee-96b2-eba6a799efa4\', \'multiverseId\': 176308}, \'multiverseid\': 176308}, {\'name\': \'Bestia di Krosa\', \'text\': \'Soglia La Bestia di Krosa prende +7/+7 (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Bestia Scoiattolo\', \'flavor\': "Coloro che vedono gli scoiattoli andare sottoterra per l\'inverno non sono preparati a ciò che riemerge in primavera.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176817&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5752b81c-f064-4812-91f5-483d4e2a51ba\', \'multiverseId\': 176817}, \'multiverseid\': 176817}, {\'name\': \'クローサの獣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d81d56a-8f26-4462-ad91-c722ac71005f\'}, \'multiverseid\': None}, {\'name\': \'Besta Krosana\', \'text\': \'Limiar — Besta Krosana recebe +7/+7. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Besta Esquilo\', \'flavor\': \'Aqueles que vêem os esquilos se entocarem no inverno não estão preparados para o que emerge na primavera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178811&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8bf5fd67-98c3-42e1-ac32-df7b87327540\', \'multiverseId\': 178811}, \'multiverseid\': 178811}]', '[{\'name\': \'Krosanische Rächerin\', \'text\': \'Verursacht Trampelschaden\\nGrenzwert {1}{G}: Regeneriere die Krosanische Rächerin. (Spiele diese Fähigkeit nur, falls sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Druide\', \'flavor\': \'Sie könnte sich einen Namen machen — wenn sie Überlebende hinterlassen würde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175955&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a9d2db0d-19b5-43ea-8efd-bfc2bb3df865\', \'multiverseId\': 175955}, \'multiverseid\': 175955}, {\'name\': \'Vengadora krosana\', \'text\': \'Arrolla.\\nUmbral {1}{G}: Regenera a la Vengadora krosana. (Juega esta habilidad sólo si hay siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Druida\', \'flavor\': \'Tendría una reputación temible si dejara sobrevivientes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177367&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc35c402-0c0b-48cf-a720-ec3fee6e1521\', \'multiverseId\': 177367}, \'multiverseid\': 177367}, {\'name\': \'Vengeresse krosiane\', \'text\': "Piétinement\\nSeuil — {1}{G}: Régénérez la Vengeresse krosiane. (Ne jouez cette capacité que s\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : druide\', \'flavor\': \'Elle aurait eu une réputation redoutable si elle avait laissé parfois des survivants.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176307&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'722f3039-a53a-4242-960b-57f86e67ff7d\', \'multiverseId\': 176307}, \'multiverseid\': 176307}, {\'name\': \'Vendicatore di Krosa\', \'text\': \'Travolgere\\nSoglia {1}{G}: Rigenera il Vendicatore di Krosa (gioca questa abilità solo se ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Druido\', \'flavor\': \'Avrebbe una temibile reputazione se solo lasciasse qualche sopravvissuto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176816&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0d97f1a4-9a5a-4564-b916-658ce9230e7c\', \'multiverseId\': 176816}, \'multiverseid\': 176816}, {\'name\': \'クローサの報復者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'84dbd513-8458-4911-81f0-b434c045f5fa\'}, \'multiverseid\': None}, {\'name\': \'Vingadora Krosana\', \'text\': \'Atropelar\\nLimiar — {1}{G}: Regenera Vingadora Krosana. (Use esta habilidade apenas se você tiver sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Druida\', \'flavor\': \'Ela teria uma reputação terrível se deixasse sobreviventes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'74a12d4f-0d0a-404d-b29b-1edd15990b0b\', \'multiverseId\': 178810}, \'multiverseid\': 178810}]', '[{\'name\': \'Krosanischer Bogenschütze\', \'text\': \'Der Krosanische Bogenschütze kann blocken, als ob er Flugfähigkeit hätte.\\n{G}, wirf eine Karte aus deiner Hand ab: Der Krosanische Bogenschütze erhält +0/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zentaur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175954&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'795298da-a681-48f5-979e-964139591994\', \'multiverseId\': 175954}, \'multiverseid\': 175954}, {\'name\': \'Arquero krosano\', \'text\': \'El Arquero krosano puede bloquear como si tuviera la habilidad de volar.\\n{G}, descartar una carta de tu mano: El Arquero krosano obtiene +0/+2 hasta el final del turno.\', \'type\': \'Criatura — Centauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177366&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db6f04f9-de98-43b9-8722-9946116ad32c\', \'multiverseId\': 177366}, \'multiverseid\': 177366}, {\'name\': \'Archer krosian\', \'text\': "L\'Archer krosian peut bloquer comme s\'il avait le vol.\\n{G}, défaussez-vous d\'une carte de votre main : L\'Archer krosian gagne +0/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : centaure\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176306&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e12bd61d-c618-4523-9ec2-4fe158f2cb21\', \'multiverseId\': 176306}, \'multiverseid\': 176306}, {\'name\': \'Arciere di Krosa\', \'text\': "L\'Arciere di Krosa può bloccare come se avesse volare.\\n{G}, Scarta una carta dalla tua mano: L\'Arciere di Krosa prende +0/+2 fino alla fine del turno.", \'type\': \'Creatura — Centauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176815&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca7069d8-8f51-41a7-8fb9-584389542464\', \'multiverseId\': 176815}, \'multiverseid\': 176815}, {\'name\': \'クローサの射手\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd1d1729-f55c-4737-b1a2-bde97f665a64\'}, \'multiverseid\': None}, {\'name\': \'Arqueiro Krosano\', \'text\': \'Arqueiro Krosano pode bloquear como se tivesse a habilidade de voar.\\n{G}, Descarte um card de sua mão: Arqueiro Krosano recebe +0/+2 até o final do turno.\', \'type\': \'Criatura — Centauro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e9d82f6-c923-498a-9c3f-b63924c1db0a\', \'multiverseId\': 178809}, \'multiverseid\': 178809}]', '[{\'name\': \'Kryptenkriecher\', \'text\': \'Opfere den Kryptenkriecher: Entferne eine Karte deiner Wahl in einem Friedhof ganz aus dem Spiel.\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'Um seine Mahlzeiten auszugraben, beerdigt er sich selber.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175833&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b72d2984-15a0-442f-9c0b-e7a696fba6a4\', \'multiverseId\': 175833}, \'multiverseid\': 175833}, {\'name\': \'Rastrero de la cripta\', \'text\': \'Sacrificar el Rastrero de la cripta: Remueve del juego la carta objetivo de un cementerio.\', \'type\': \'Criatura — Zombie\', \'flavor\': \'Para desenterrar su cena, se entierra a sí mismo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177245&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'561ae569-3e26-45f7-8a34-4bfe8b15bbaa\', \'multiverseId\': 177245}, \'multiverseid\': 177245}, {\'name\': \'Fureteur des cryptes\', \'text\': "Sacrifiez le Fureteur des cryptes : Retirez de la partie la carte ciblée d\'un cimetière.", \'type\': \'Créature : zombie\', \'flavor\': "Pour déterrer son dîner, il s\'enterre lui-même.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176185&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4e84e5ed-186b-4c45-b8ec-8af236d1e48b\', \'multiverseId\': 176185}, \'multiverseid\': 176185}, {\'name\': \'Strisciante della Cripta\', \'text\': \'Sacrifica lo Strisciante della Cripta: Rimuovi dal gioco una carta bersaglio presente in un cimitero.\', \'type\': \'Creatura — Zombie\', \'flavor\': \'Per dissotterrare il proprio pranzo, si seppellisce da solo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176694&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97526e48-6263-42a7-8c21-aceb4dcc1729\', \'multiverseId\': 176694}, \'multiverseid\': 176694}, {\'name\': \'墓所を歩くもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c96dd6a3-6146-4e4a-b66f-88330c648b55\'}, \'multiverseid\': None}, {\'name\': \'Rastejador da Cripta\', \'text\': \'Sacrifique Rastejador da Cripta: Remove de jogo o card alvo que esteja em um cemitério.\', \'type\': \'Criatura — Zumbi\', \'flavor\': \'Para desenterrar seu jantar, ele próprio se enterra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178688&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'47552925-c29e-43b6-8892-d6325b5bd194\', \'multiverseId\': 178688}, \'multiverseid\': 178688}]', '[{\'name\': \'Kulturaustausch\', \'text\': \'Bestimme eine beliebige Anzahl an Kreaturen, die ein Spieler deiner Wahl kontrolliert. Bestimme die selbe Anzahl an Kreaturen unter der Kontrolle eines anderen Spielers deiner Wahl. Diese Spieler tauschen die Kontrolle über diese Kreaturen aus. (Dieser Effekt endet nicht am Ende des Zuges.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175787&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e15d15ab-e82b-4c9c-8c2b-f6bf84f2695a\', \'multiverseId\': 175787}, \'multiverseid\': 175787}, {\'name\': \'Intercambio cultural\', \'text\': \'Elige cualquier número de criaturas que controle el jugador objetivo. Elige el mismo número de criaturas que controle otro jugador objetivo. Esos jugadores intercambian el control de esas criaturas. (Este efecto no termina al final del turno.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177199&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60b9de6e-260f-4588-83a8-26de477281a8\', \'multiverseId\': 177199}, \'multiverseid\': 177199}, {\'name\': \'Échange culturel\', \'text\': "Choisissez n\'importe quel nombre de créatures que le joueur ciblé contrôle. Choisissez le même nombre de créatures qu\'un autre joueur ciblé contrôle. Ces joueurs échangent le contrôle de ces créatures. (Cet effet ne s\'arrête pas à la fin du tour.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176139&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92aefe42-0797-4c91-89b5-e6f93c1394ab\', \'multiverseId\': 176139}, \'multiverseid\': 176139}, {\'name\': \'Scambio Culturale\', \'text\': \'Scegli un qualsiasi numero di creature controllate da un giocatore bersaglio. Scegli uno stesso numero di creature controllate da un altro giocatore bersaglio. Quei giocatori scambiano il controllo di quelle creature (Questo effetto non termina alla fine del turno.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176648&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4588015b-70fd-46bf-96f4-cb8e8442b454\', \'multiverseId\': 176648}, \'multiverseid\': 176648}, {\'name\': \'文化交流\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f1ded76-0e0c-4ee4-a83d-0c453981b46c\'}, \'multiverseid\': None}, {\'name\': \'Intercâmbio Cultural\', \'text\': \'Escolha um número qualquer de criaturas que o jogador alvo controla. Escolha o mesmo número de criaturas que um outro jogador alvo controla. Aqueles jogadores permutam o controle daquelas criaturas. (Este efeito não cessa no final do turno.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178642&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79010915-3a7f-4f33-abdb-d04bc6d0b422\', \'multiverseId\': 178642}, \'multiverseid\': 178642}]', '[{\'name\': \'Körperwandelnder Wurm\', \'text\': \'Grenzwert Der Körperwandelnde Wurm erhält +4/+4. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Elefant, Wurm\', \'flavor\': \'Nur eine Handvoll Leute haben je einer Umwandlung zugesehen. Oder, aus dem Blickwinkel des Wurms, nur ein Rachenvoll.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175958&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35bc2581-9ea3-47b2-b123-6d0e2018802e\', \'multiverseId\': 175958}, \'multiverseid\': 175958}, {\'name\': \'Sierpe metamórfica\', \'text\': \'Umbral La Sierpe metamórfica obtiene +4/+4. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Sierpe elefante\', \'flavor\': \'Sólo un puñado la han visto transformarse. O, desde la perspectiva de la sierpe, sólo un bocado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177370&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'767420b3-729f-4d2d-b0c9-6703a842b0e9\', \'multiverseId\': 177370}, \'multiverseid\': 177370}, {\'name\': \'Guivre métamorphe\', \'text\': "Seuil — La Guivre métamorphe gagne +4/+4. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : éléphant et guivre\', \'flavor\': "Une poignée d\'hommes seulement l\'ont vue se transformer. Ou, du point de vue de la guivre, une bouchée d\'hommes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176310&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2990e587-0221-4236-8d9d-2af7c002e250\', \'multiverseId\': 176310}, \'multiverseid\': 176310}, {\'name\': \'Wurm Mutaforma\', \'text\': \'Soglia Il Wurm Mutaforma prende +4/+4 (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Wurm Elefante\', \'flavor\': \'Solo una manciata di persone lo ha visto trasformarsi. O, dal suo punto di vista, solo un boccone di persone. . .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176819&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f76c89c1-a41f-40e8-8eca-071554a56999\', \'multiverseId\': 176819}, \'multiverseid\': 176819}, {\'name\': \'変態するワーム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc194c50-cba9-4517-85d5-89653e525ce5\'}, \'multiverseid\': None}, {\'name\': \'Vorme Metamórfico\', \'text\': \'Limiar — Vorme Metamórfico recebe +4/+4. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Vorme Elefante\', \'flavor\': \'Apenas um punhado de pessoas já o viram tranformar-se. Ou, do ponto de vista do vorme, apenas um bocado delas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb608d42-00e7-46bd-961d-28539db74135\', \'multiverseId\': 178813}, \'multiverseid\': 178813}]', "[{'name': 'Lavablase', 'text': 'Zerstöre ein Nichtstandardland deiner Wahl, falls der Beherrscher dieses Lands nicht sich stattdessen von der Lavablase 6 Schadenspunkte zufügen lässt.', 'type': 'Hexerei', 'flavor': 'Um Fleischwunden zu behandeln, verwende Erde. Um Erdwunden zu behandeln, verwende Fleisch. —Redewendung unter Barbaren', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175908&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2ddbbdec-627f-44b4-a8c9-d2f5cd0f5d10', 'multiverseId': 175908}, 'multiverseid': 175908}, {'name': 'Ampolla de lava', 'text': 'Destruye la tierra objetivo que no sea básica a menos que su controlador elija que la Ampolla de lava le haga 6 puntos de daño a él.', 'type': 'Conjuro', 'flavor': 'Para tratar heridas superficiales, usa tierra. Para tratar heridas en la tierra, usa carne y huesos. —Refrán bárbaro', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177320&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '25c33e1c-b5ce-4ecf-bc91-66026b79cc60', 'multiverseId': 177320}, 'multiverseid': 177320}, {'name': 'Soulèvement de lave', 'text': 'Détruisez le terrain non-base ciblé à moins que son contrôleur ne choisisse que le Soulèvement de lave lui inflige 6 blessures à la place.', 'type': 'Rituel', 'flavor': 'Pour soigner les blessures de la chair, utilisez de la terre. Pour soigner les blessures de la terre, utilisez de la chair. —Dicton barbare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176260&type=card', 'language': 'French', 'identifiers': {'scryfallId': '898b78e7-6a03-49ee-9b4d-f0492589ef66', 'multiverseId': 176260}, 'multiverseid': 176260}, {'name': 'Piaga da Lava', 'text': 'Distruggi una terra non base bersaglio a meno che il suo controllore si faccia infliggere 6 danni dalla Piaga da Lava.', 'type': 'Stregoneria', 'flavor': 'Per curare le ferite della carne, utilizza la terra. Per curare le ferite della terra, utilizza la carne. —detto barbaro', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176769&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b31ef5c1-5fbf-48df-98b6-7e41a2ec018e', 'multiverseId': 176769}, 'multiverseid': 176769}, {'name': '溶岩のあぶく', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '35f69ada-0162-42f0-8506-7f4adaa500eb'}, 'multiverseid': None}, {'name': 'Empola de Lava', 'text': 'Destrói o terreno não-básico alvo a não ser que seu controlador faça com que Empola de Lava cause 6 pontos de dano a ele próprio.', 'type': 'Feitiço', 'flavor': 'Para curar ferimentos na carne, use terra. Para curar ferimentos na terra, use carne. — Dito dos bárbaros', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178763&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6b2e25b4-b40f-4ca9-8fdf-dacfe1ef03b3', 'multiverseId': 178763}, 'multiverseid': 178763}]", '[{\'name\': \'Leben geben\', \'text\': \'Ein Land deiner Wahl wird bis zum Ende des Zuges zu einer 3/3 Kreatur. Es ist immer noch ein Land.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'In der Nähe des Waldrandes von Krosa passen die Bauern auf ihre Felder auf, damit diese nicht aufstehen und davonwandern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175989&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ecc29a2-2325-46a5-9c43-006cee4cebdc\', \'multiverseId\': 175989}, \'multiverseid\': 175989}, {\'name\': \'Vivificar\', \'text\': \'La tierra objetivo es una criatura 3/3 hasta el final del turno. Sigue siendo una tierra.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Cerca de la frontera krosana, los agricultores vigilan sus campos para que el césped no se levante y se vaya.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177401&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'29d53feb-2b98-412d-a03c-4f5605d2e2c1\', \'multiverseId\': 177401}, \'multiverseid\': 177401}, {\'name\': \'Vivifaction\', \'text\': "Le terrain ciblé devient une créature 3/3 jusqu\'à la fin du tour. C\'est toujours un terrain.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "Près de la frontière de la Krosia, les fermiers surveillent leurs terres, par crainte qu\'elles ne se lèvent et ne s\'en aillent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176341&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6d26142-0f15-4cda-8949-a8cd551d50c4\', \'multiverseId\': 176341}, \'multiverseid\': 176341}, {\'name\': \'Vivificare\', \'text\': \'La terra bersaglio diventa una creatura 3/3 fino alla fine del turno. È ancora una terra.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Vicino al confine di Krosa, i contadini sorvegliano i propri campi per evitare che si alzino e se ne vadano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176850&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a62d5528-17b2-4146-9116-6da176953e74\', \'multiverseId\': 176850}, \'multiverseid\': 176850}, {\'name\': \'活気\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d711126e-d0c1-4270-a0f6-7e8defad2841\'}, \'multiverseid\': None}, {\'name\': \'Vivificar\', \'text\': \'O terreno alvo torna-se uma criatura 3/3 até o final do turno. Ela ainda conta como um terreno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Perto da fronteira de Krosa, os fazendeiros mantêm seus campos sob vigilância, temendo que a céspede se erga e se vá.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d90891ea-a59b-4dda-8772-0ef967fc8f5f\', \'multiverseId\': 178844}, \'multiverseid\': 178844}]', '[{\'name\': \'Lebendig begraben\', \'text\': \'Durchsuche deine Bibliothek nach bis zu drei Kreaturenkarten und lege diese auf deinen Friedhof. Mische danach deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Das Kratzen der Schaufeln und der Fall der kalten Erdklumpen erstickten bald das Flehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175826&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6b0d0bc-8c7d-4bec-bb8d-d1a710ab50e9\', \'multiverseId\': 175826}, \'multiverseid\': 175826}, {\'name\': \'Entierro en vida\', \'text\': \'Busca en tu biblioteca hasta tres cartas de criatura y ponlas en tu cementerio. Luego baraja tu biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'El rascar de las palas y la caída de la tierra fría pronto atenuaron sus súplicas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7c21d09a-c192-4785-8cbb-431d2d0c89ea\', \'multiverseId\': 177238}, \'multiverseid\': 177238}, {\'name\': \'Enterré vivant\', \'text\': "Cherchez jusqu\'à trois cartes de créature dans votre bibliothèque et mettez-les dans votre cimetière. Mélangez ensuite votre bibliothèque.", \'type\': \'Rituel\', \'flavor\': \'Le raclement des pelles et les fournées de terre étouffèrent rapidement leurs plaintes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176178&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9b3633f1-84a8-4f16-8234-74d23665a0d9\', \'multiverseId\': 176178}, \'multiverseid\': 176178}, {\'name\': \'Sepolto Vivo\', \'text\': \'Passa in rassegna il tuo grimorio, scegli fino a tre carte creatura e mettile nel tuo cimitero. Poi rimescola il tuo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': \'I colpi della pala e i tonfi della terra umida coprirono presto le loro grida imploranti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176687&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee4a0b7f-2222-462f-909e-741cc49509cb\', \'multiverseId\': 176687}, \'multiverseid\': 176687}, {\'name\': \'生き埋め\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eabbc7a1-fdff-4712-acc6-a0fc97e7eba9\'}, \'multiverseid\': None}, {\'name\': \'Enterrado Vivo\', \'text\': \'Procure em seu grimório por até três cards de criatura e coloque-os em seu cemitério. Depois, embaralhe seu grimório.\', \'type\': \'Feitiço\', \'flavor\': \'O ruído das pás e da terra fria sendo tombada logo abafaram suas súplicas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178681&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'675e7995-4c88-4b49-a879-fb1572cbfdc9\', \'multiverseId\': 178681}, \'multiverseid\': 178681}]', '[{\'name\': \'Lebensschwall\', \'text\': \'Ein Spieler deiner Wahl erhält 4 Lebenspunkte dazu, dann erhält er 4 Lebenspunkte für jede Lebensschwall-Karte in allen Friedhöfen dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'So erbaulich wie die Träume eines Mystikers.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175738&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fdd6f69a-5008-438a-beab-4edb893d6acc\', \'multiverseId\': 175738}, \'multiverseid\': 175738}, {\'name\': \'Estallido de vida\', \'text\': \'El jugador objetivo gana 4 vidas, luego gana 4 vidas por cada carta de Estallido de vida que haya en cada cementerio.\', \'type\': \'Instantáneo\', \'flavor\': \'Tan edificante como los sueños de un místico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177150&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c1dae11-ecd6-4165-b1b7-eb1dfb645269\', \'multiverseId\': 177150}, \'multiverseid\': 177150}, {\'name\': \'Explosion vitale\', \'text\': "Le joueur ciblé gagne 4 points de vie, puis gagne 4 points de vie pour chaque carte d\'Explosion vitale dans chaque cimetière.", \'type\': \'Éphémère\', \'flavor\': "Enivrant comme le rêve d\'un mystique.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176090&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09e9794c-7408-4f54-98c6-ac61f2963ef8\', \'multiverseId\': 176090}, \'multiverseid\': 176090}, {\'name\': \'Esplosione di Vita\', \'text\': \'Il giocatore bersaglio guadagna 4 punti vita, poi guadagna 4 punti vita per ogni carta Esplosione di Vita presente in ogni cimitero.\', \'type\': \'Istantaneo\', \'flavor\': \'Incoraggiante come i sogni di un mistico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176599&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a296d429-a8f4-4664-a42d-3622f90d1300\', \'multiverseId\': 176599}, \'multiverseid\': 176599}, {\'name\': \'生命の噴出\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e238c431-b96f-4024-8e78-ae4b0c98bdf5\'}, \'multiverseid\': None}, {\'name\': \'Explosão de Vida\', \'text\': \'O jogador alvo ganha 4 pontos de vida e depois ganha 4 pontos de vida para cada card de Explosão de Vida em cada cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Tão enaltecedor quanto o sonho de um místico.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178593&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2bba61f-63b5-4078-8f12-bf115a7547b6\', \'multiverseId\': 178593}, \'multiverseid\': 178593}]', '[{\'name\': \'Leichenhausraub\', \'text\': \'Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\\nRückblende {4}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175859&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d12a3634-c46d-4d36-8e9f-4e079826a9ac\', \'multiverseId\': 175859}, \'multiverseid\': 175859}, {\'name\': \'Robo en la morgue\', \'text\': \'Regresa la carta objetivo de criatura de tu cementerio a tu mano.\\nRetrospectiva {4}{B}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177271&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4b14c3d4-bab9-4d4d-b32c-63d230976d4f\', \'multiverseId\': 177271}, \'multiverseid\': 177271}, {\'name\': \'Vol à la morgue\', \'text\': \'Renvoyez une carte de créature ciblée depuis votre cimetière dans votre main.\\nFlashback {4}{B} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176211&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb844b32-64c5-4fcb-81d5-c13aa07f302a\', \'multiverseId\': 176211}, \'multiverseid\': 176211}, {\'name\': "Furto dall\'Obitorio", \'text\': \'Riprendi in mano una carta creatura bersaglio dal tuo cimitero.\\nFlashback {4}{B} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176720&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d243b6b6-1edd-42c3-9c73-f3c62716305b\', \'multiverseId\': 176720}, \'multiverseid\': 176720}, {\'name\': \'モルグの窃盗\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2faff3fb-54b0-437a-8c3e-36efb20ff7fe\'}, \'multiverseid\': None}, {\'name\': \'Roubo no Necrotério\', \'text\': \'Devolve o card de criatura alvo de seu cemitério para sua mão.\\nRecapitular {4}{B} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178714&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa01c79c-4cda-45af-851a-77128bcb6bce\', \'multiverseId\': 178714}, \'multiverseid\': 178714}]', '[{\'name\': \'Leiden lassen\', \'text\': \'Eine Kreatur deiner Wahl erhält -1/-1 bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Patriarch schüttelte nur kurz seinem Finger, wenn einer seiner Champions ihn enttäuschte. Das reichte bereits.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175823&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2a55d50e-273b-41d8-822e-657a32bab8c5\', \'multiverseId\': 175823}, \'multiverseid\': 175823}, {\'name\': \'Afligir\', \'text\': \'La criatura objetivo obtiene -1/-1 hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Cuando uno de los campeones del Patriarca le desagradaba, él sólo sacudía su dedo. Eso era suficiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177235&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e692cbfb-b68e-492d-93fe-35c4e706bc47\', \'multiverseId\': 177235}, \'multiverseid\': 177235}, {\'name\': \'Affliction\', \'text\': "La créature ciblée gagne -1/-1 jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "Quand l\'un des champions du Patriarche lui a déplu, il bouge légèrement son doigt. Cela suffit.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176175&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4057c605-49aa-4074-9008-d0b47b145feb\', \'multiverseId\': 176175}, \'multiverseid\': 176175}, {\'name\': \'Tormentare\', \'text\': \'La creatura bersaglio prende -1/-1 fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Quando uno dei campioni del Patriarca lo deludeva, si limitava a scuotere un dito. Era sufficiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176684&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0494dd1-75e6-4298-9957-2fc9b37adec0\', \'multiverseId\': 176684}, \'multiverseid\': 176684}, {\'name\': \'苦悩\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c38a82e-4b70-4795-b129-349778a8bc38\'}, \'multiverseid\': None}, {\'name\': \'Afligir\', \'text\': \'A criatura alvo recebe -1/-1 até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Quando um dos campeões do Patriarca o desagradava, ele apenas balançava seu dedo. Aquilo era o suficiente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178678&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33ee19fe-ec89-4872-ab57-fb02c88e6fee\', \'multiverseId\': 178678}, \'multiverseid\': 178678}]', '[{\'name\': \'Leidenschaftliche Ablehnung\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl.\\nRückblende {5}{U}{U} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Eure Hartnäckigkeit ist bewundernswert. Und zwecklos." —Kaiser Aboshan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175794&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'49e01bbe-0be0-4496-b098-330bf9d76b98\', \'multiverseId\': 175794}, \'multiverseid\': 175794}, {\'name\': \'Negación ferviente\', \'text\': \'Contrarresta el hechizo objetivo.\\nRetrospectiva {5}{U}{U}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': \'"Tu tenacidad es admirable. Y fútil." —Emperador Áboshan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177206&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'65900b3b-561c-4054-9cf5-63321ed34c26\', \'multiverseId\': 177206}, \'multiverseid\': 177206}, {\'name\': \'Déni catégorique\', \'text\': \'Contrecarrez le sort ciblé.\\nFlashback {5}{U}{U} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)\', \'type\': \'Éphémère\', \'flavor\': "« Votre ténacité est admirable. Mais futile. » —L\'empereur Aboshân.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176146&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0660ba05-adce-4b25-bab1-bbf417123f30\', \'multiverseId\': 176146}, \'multiverseid\': 176146}, {\'name\': \'Rifiuto Deciso\', \'text\': \'Neutralizza una magia bersaglio.\\nFlashback {5}{U}{U} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': \'"La tua tenacia è ammirevole. E futile". —Imperatore Aboshan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176655&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f458cced-97dd-41d4-be2a-3c5332aed947\', \'multiverseId\': 176655}, \'multiverseid\': 176655}, {\'name\': \'全面否定\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d2c780b-fd8b-4247-865f-775210b412c8\'}, \'multiverseid\': None}, {\'name\': \'Negacão Ardorosa\', \'text\': \'Anula a mágica alvo.\\nRecapitular {5}{U}{U} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Tua tenacidade é admirável. E fútil." — Imperador Aboshan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178649&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33411066-727d-43d3-9aee-70d0d1a7840b\', \'multiverseId\': 178649}, \'multiverseid\': 178649}]', '[{\'name\': \'Leuchtender Wächter\', \'text\': \'{W}: Der Leuchtende Wächter erhält +0/+1 bis zum Ende des Zuges.\\n{2}: Der Leuchtende Wächter kann in diesem Zug eine zusätzliche Kreatur blocken.\', \'type\': \'Kreatur — Wächter\', \'flavor\': \'„Es gibt keinen Sieg ohne Tugend."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175739&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd6f8ba6-705b-416d-919b-ac5176f74543\', \'multiverseId\': 175739}, \'multiverseid\': 175739}, {\'name\': \'Guardiana luminosa\', \'text\': \'{W}: La Guardiana luminosa obtiene +0/+1 hasta el final del turno.\\n{2}: La Guardiana luminosa puede bloquear a una criatura adicional este turno.\', \'type\': \'Criatura — Guardián\', \'flavor\': \'"No hay victoria sin virtud."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177151&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'43f7fc74-5695-4a42-a577-1e3172c52fcf\', \'multiverseId\': 177151}, \'multiverseid\': 177151}, {\'name\': \'Vigile lumineux\', \'text\': "{W}: Le Vigile lumineux gagne +0/+1 jusqu\'à la fin du tour.\\n{2}: Le Vigile lumineux peut bloquer une créature supplémentaire ce tour-ci.", \'type\': \'Créature : vigile\', \'flavor\': "« La victoire n\'est rien sans la vertu. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176091&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5ff4df5-ded2-45b3-bfd3-324a7a7a4a24\', \'multiverseId\': 176091}, \'multiverseid\': 176091}, {\'name\': \'Guardiano Lucente\', \'text\': \'{W}: Il Guardiano Lucente prende +0/+1 fino alla fine del turno.\\n{2}: Il Guardiano Lucente può bloccare una creatura addizionale in questo turno.\', \'type\': \'Creatura — Guardiano\', \'flavor\': \'"Non c\\\'è vittoria senza virtù".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176600&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d749d152-1738-41c7-93ff-c63d7dcbbed6\', \'multiverseId\': 176600}, \'multiverseid\': 176600}, {\'name\': \'光明の守護者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'94c4863e-d1a8-4851-8b0b-68b0218ad6df\'}, \'multiverseid\': None}, {\'name\': \'Guardião Luminoso\', \'text\': \'{W}: Guardião Luminoso recebe +0/+1 até o final do turno.\\n{2}: Guardião Luminoso pode bloquear uma criatura adicional neste turno.\', \'type\': \'Criatura — Guardião\', \'flavor\': \'"Não há vitória sem virtude."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178594&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2938cf31-d044-4de9-b760-052c3aef155e\', \'multiverseId\': 178594}, \'multiverseid\': 178594}]', '[{\'name\': \'Leutnant Kirtar\', \'text\': \'Fliegend\\n{1}{W}, opfere Leutnant Kirtar: Entferne eine angreifende Kreatur deiner Wahl ganz aus dem Spiel.\', \'type\': \'Kreatur — Vogel, Soldat, Legende\', \'flavor\': \'„Seine Stärken sind sein Stolz, seine Hingabe und sein Ehrgeiz. Seine Schwächen sind dieselben. —Pianna, Nomaden-Oberhaupt\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175737&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ddbed15a-9be5-430e-ae94-e2ba2c544227\', \'multiverseId\': 175737}, \'multiverseid\': 175737}, {\'name\': \'Teniente Kírtar\', \'text\': \'Vuela.\\n{1}{W}, sacrificar el Teniente Kírtar: Remueve del juego la criatura objetivo atacante.\', \'type\': \'Criatura — Soldado ave legendario\', \'flavor\': \'"Sus fortalezas son el orgullo, la devoción y la ambición. Sus debilidades son las mismas." —Píanna, capitana nómada\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177149&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a12ee0c-e544-4451-8c75-e3b6f15c0615\', \'multiverseId\': 177149}, \'multiverseid\': 177149}, {\'name\': \'Lieutenant Kirtar\', \'text\': \'Vol\\n{1}{W}, sacrifiez Le Lieutenant Kirtar : Retirez la créature attaquante ciblée de la partie.\', \'type\': \'Créature : oiseau et soldat et légende\', \'flavor\': "« Ses forces sont la fierté, la dévotion et l\'ambition. Ce sont aussi ses faiblesses. » —Pianna, capitaine des nomades.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176089&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66668af5-033b-4c4f-809a-0a9b40de53ca\', \'multiverseId\': 176089}, \'multiverseid\': 176089}, {\'name\': \'Luogotentente Kirtar\', \'text\': \'Volare\\n{1}{W}, Sacrifica il Luogotenente Kirtar: Rimuovi dal gioco una creatura attaccante bersaglio.\', \'type\': \'Creatura — Leggenda Soldato Uccello\', \'flavor\': \'"Le sue doti sono l\\\'orgoglio, la devozione e l\\\'ambizione. Ma sono anche le sue debolezze". —Pianna, Capitano Nomade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176598&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fc9a6ae-11ba-49b0-9ba4-448f53d951f6\', \'multiverseId\': 176598}, \'multiverseid\': 176598}, {\'name\': \'隊長補佐カーター\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa031de6-18cc-4bac-a591-21e16fbca30f\'}, \'multiverseid\': None}, {\'name\': \'Tenente Kirtar\', \'text\': \'Voar\\n{1}{W}, Sacrifique Tenente Kirtar: Remove do jogo a criatura alvo atacante.\', \'type\': \'Criatura — Soldado Pássaro Lenda\', \'flavor\': \'"Suas forças, assim como suas fraquezas, são o orgulho, a devoção e a ambição." — Pianna, capitão nômade\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178592&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c1bb6d6-00f3-4ca7-a806-ec656e62aa2b\', \'multiverseId\': 178592}, \'multiverseid\': 178592}]', '[{\'name\': \'Lähmende Tinte\', \'text\': \'Die verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\\nDie verzauberte Kreatur hat: "{1}, wirf eine Karte aus deiner Hand ab: Enttappe diese Kreatur."\', \'type\': \'Kreaturenverzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175795&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fba10d74-cbbb-4cc7-9335-329dfd2c9483\', \'multiverseId\': 175795}, \'multiverseid\': 175795}, {\'name\': \'Tinta inmobilizadora\', \'text\': \'La criatura encantada no se endereza durante el paso de enderezar de su controlador.\\nLa criatura encantada tiene: "{1}, descartar una carta de tu mano: Endereza esta criatura".\', \'type\': \'Encantar criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177207&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0fcbe4c9-81b5-4abd-a84f-7fffe371bd6f\', \'multiverseId\': 177207}, \'multiverseid\': 177207}, {\'name\': \'Encre immobilisante\', \'text\': "La créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.\\nLa créature enchantée a « {1}, défaus-sez-vous d\'une carte de votre main : Dégagez cette créature. »", \'type\': \'Enchanter : créature\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176147&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9aac5b56-0273-41da-b505-9e7393cfdb12\', \'multiverseId\': 176147}, \'multiverseid\': 176147}, {\'name\': \'Inchiostro Paralizzante\', \'text\': \'La creatura incantata non STAPpa durante lo STAP del proprio controllore.\\nLa creatura incantata ha "{1}, Scarta una carta dalla tua mano: STAPpa questa creatura".\', \'type\': \'Incanta Creatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176656&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00f85847-8fcf-4a92-b3e4-79aca9ccacb1\', \'multiverseId\': 176656}, \'multiverseid\': 176656}, {\'name\': \'固めの墨\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'846d17d0-31d5-4c62-b944-3cf4fd435089\'}, \'multiverseid\': None}, {\'name\': \'Tinta Imobilizadora\', \'text\': \'A criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\\nA criatura encantada tem "{1}, Descarte um card de sua mão: Desvira esta criatura."\', \'type\': \'Encantar Criatura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178650&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ec37c7d2-a43e-4606-aa53-8f8cb305ba54\', \'multiverseId\': 178650}, \'multiverseid\': 178650}]', '[{\'name\': \'Macht des Waldes\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 und verursacht bis zum Ende des Zuges Trampelschaden.\\nRückblende {2}{G}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175985&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ea1c83a-ef01-44ea-9f48-3e7dd481e94f\', \'multiverseId\': 175985}, \'multiverseid\': 175985}, {\'name\': \'Poderío silvestre\', \'text\': \'La criatura objetivo obtiene +2/+2 y gana la habilidad de arrollar hasta el final del turno.\\nRetrospectiva {2}{G}{G}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177397&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d3c909ee-37f6-464b-be1c-105088680f99\', \'multiverseId\': 177397}, \'multiverseid\': 177397}, {\'name\': \'Puissance sylvestre\', \'text\': "La créature ciblée gagne +2/+2 et acquiert le piétinement jusqu\'à la fin du tour.\\nFlashback {2}{G}{G} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176337&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f505fbfd-86bf-4c25-a43f-f15fbbdc985c\', \'multiverseId\': 176337}, \'multiverseid\': 176337}, {\'name\': \'Potenza Silvestre\', \'text\': \'La creatura bersaglio prende +2/+2 e guadagna travolgere fino alla fine del turno.\\nFlashback {2}{G}{G} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176846&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6bb68d12-411a-4fa4-b8a5-b9cdc9e06d3e\', \'multiverseId\': 176846}, \'multiverseid\': 176846}, {\'name\': \'森の力\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6e725d34-08cd-4a05-ac92-5872e0232301\'}, \'multiverseid\': None}, {\'name\': \'Força Silvestre\', \'text\': \'A criatura alvo recebe +2/+2 e ganha a habilidade de atropelar até o final do turno.\\nRecapitular {2}{G}{G} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178840&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e802be05-5e58-427e-a351-f979a6ac04cf\', \'multiverseId\': 178840}, \'multiverseid\': 178840}]', '[{\'name\': \'Machtmampfer\', \'text\': \'Eile\\nStärke und Widerstandskraft des Machtmampfers sind gleich der Anzahl an Hexereikarten auf allen Friedhöfen.\', \'type\': \'Kreatur — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175912&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'98c73190-9803-4225-a285-cfedf9d20acd\', \'multiverseId\': 175912}, \'multiverseid\': 175912}, {\'name\': \'Magnívoro\', \'text\': \'Prisa.\\nTanto la fuerza como la resistencia del Magnívoro son iguales al número de cartas de conjuro que haya en todos los cementerios.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177324&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0e060a62-a6e7-4857-ba6a-02e4da6ab9a1\', \'multiverseId\': 177324}, \'multiverseid\': 177324}, {\'name\': \'Magnivore\', \'text\': "Célérité\\nLa force et l\'endurance du Magnivore sont chacune égale au nombre de cartes de rituel dans tous les cimetières.", \'type\': \'Créature : lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176264&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2bd1e783-5378-42b2-8bb4-b2f8f196e602\', \'multiverseId\': 176264}, \'multiverseid\': 176264}, {\'name\': \'Magnivoro\', \'text\': \'Rapidità\\nLa forza e la costituzione del Magnivoro sono pari ciascuna al numero di carte stregoneria presenti in tutti i cimiteri.\', \'type\': \'Creatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176773&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f49384d5-6cf7-4123-8c27-c6b9edad5b4e\', \'multiverseId\': 176773}, \'multiverseid\': 176773}, {\'name\': \'猛烈に食うもの\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d24cd99a-6782-416d-8971-0f0504ada575\'}, \'multiverseid\': None}, {\'name\': \'Magnívoro\', \'text\': \'Ímpeto\\nO poder e a resistência de Magnívoro são ambos iguais ao número de cards de feitiço em todos os cemitérios.\', \'type\': \'Criatura — Lhurgoyf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178767&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23015f15-ac64-4f83-92bf-938ae6b025d6\', \'multiverseId\': 178767}, \'multiverseid\': 178767}]', '[{\'name\': \'Magmaadern\', \'text\': \'{R}, opfere ein Land: Die Magmaadern fügen jeder nichtfliegenden Kreatur 1 Schadenspunkt zu.\', \'type\': \'Verzauberung\', \'flavor\': \'Neben einem Vulkan stehen —Barbarenausdruck für „um Prügel bitten"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'375f3212-46cd-45f7-adbe-76b38dbdd92b\', \'multiverseId\': 175911}, \'multiverseid\': 175911}, {\'name\': \'Veta de magma\', \'text\': \'{R}, sacrificar una tierra: La Veta de magma hace 1 punto de daño a cada criatura que no tenga la habilidad de volar.\', \'type\': \'Encantamiento\', \'flavor\': \'Pararse cerca de un volcán. Expresión bárbara que significa "buscar problemas"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177323&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'05c90b9a-0f4a-4c58-9903-1f9ccb23e544\', \'multiverseId\': 177323}, \'multiverseid\': 177323}, {\'name\': \'Veine de magma\', \'text\': \'{R}, sacrifiez un terrain : La Veine de magma inflige 1 blessure à chaque créature sans le vol.\', \'type\': \'Enchantement\', \'flavor\': "Il est resté au pied du volcan. — Expression barbare signifiant « Il l\'a bien cherché ».", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176263&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d646db05-c6ca-4357-9e09-354733a4a4ec\', \'multiverseId\': 176263}, \'multiverseid\': 176263}, {\'name\': \'Vena di Magma\', \'text\': \'{R}, Sacrifica una terra: La Vena di Magma infligge 1 danno a ogni creatura senza volare.\', \'type\': \'Incantesimo\', \'flavor\': \'Stare vicino a un vulcano -espressione barbara che significa "andare in cerca di guai"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176772&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'280c04ce-d542-4e9b-af77-55d6bfc17914\', \'multiverseId\': 176772}, \'multiverseid\': 176772}, {\'name\': \'マグマ鉱脈\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f737f02-9901-4285-94d2-6fe7ff437ed9\'}, \'multiverseid\': None}, {\'name\': \'Veio de Magma\', \'text\': \'{R}, Sacrifique um terreno: Veio de Magma causa 1 ponto de dano a cada criatura sem a habilidade de voar.\', \'type\': \'Encantamento\', \'flavor\': \'Ficar perto de um vulcão — Expressão dos bárbaros que significa "pedindo por isso"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178766&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a781f641-f0e1-4f13-ae35-1d7082d88d10\', \'multiverseId\': 178766}, \'multiverseid\': 178766}]', '[{\'name\': \'Marionettenkönig\', \'text\': \'{U}, {T}: Tappe oder enttappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Zauberer\', \'flavor\': \'„Wenn man Leute dazu bringen will, das zu tun, was man von ihnen will, muss man ihnen das sagen, was sie gerne hören wollen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175805&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'452de632-254f-4abd-a9a0-9ad40bbfb691\', \'multiverseId\': 175805}, \'multiverseid\': 175805}, {\'name\': \'Titiritero\', \'text\': \'{U}, {T}: Gira o endereza la criatura objetivo.\', \'type\': \'Criatura — Hechicero\', \'flavor\': \'"Hacer que la gente haga lo que quieres es meramente cuestión de decirles lo que quieren oír."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177217&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a36ac20-a5d6-4e4f-aa53-4438c2ad2d89\', \'multiverseId\': 177217}, \'multiverseid\': 177217}, {\'name\': \'Sculpteur de marionnettes\', \'text\': \'{U}, {T}: Engagez ou dégagez la créature ciblée.\', \'type\': \'Créature : sorcier\', \'flavor\': "« Pour qu\'ils fassent ce que vous voulez, dites-leur ce qu\'ils veulent entendre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176157&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bf51eb0d-b9c9-4f24-880a-3ebb92eeb827\', \'multiverseId\': 176157}, \'multiverseid\': 176157}, {\'name\': \'Burattinaio\', \'text\': \'{U}, {T}: TAPpa o STAPpa una creatura bersaglio.\', \'type\': \'Creatura — Mago\', \'flavor\': \'"Far fare quello che vuoi alle persone dipende semplicemente dal saper dire quello che vogliono sentire".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176666&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'166e9312-3381-4fe7-a1bb-862dafb96d09\', \'multiverseId\': 176666}, \'multiverseid\': 176666}, {\'name\': \'くぐつ師\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a431fdd9-e157-45a1-8288-fdb3d2358167\'}, \'multiverseid\': None}, {\'name\': \'Titeriteiro\', \'text\': \'{U}, {T}: Vira ou desvira a criatura alvo.\', \'type\': \'Criatura — Mago\', \'flavor\': \'"Fazer com que as pessoas façam o que você quer é apenas uma questão de lhes dizer o que elas querem ouvir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178660&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8f107aa-2c57-4fc6-9eb0-6dd21cf51d69\', \'multiverseId\': 178660}, \'multiverseid\': 178660}]', '[{\'name\': \'Markerschütterer\', \'text\': \'Fliegend\\nLege zu Beginn deines Versorgungssegments die oberste Karte deiner Bibliothek auf deinen Friedhof.\\nGrenzwert Der Markerschütterer erhält +1/+1 und hat "Entferne am Ende deines Zuges zwei Karten aus deinem Friedhof ganz aus dem Spiel." (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175824&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'66619d9c-2710-4fbf-8968-81ee03aa37ed\', \'multiverseId\': 175824}, \'multiverseid\': 175824}, {\'name\': \'Hielasangre\', \'text\': \'Vuela.\\nAl comienzo de tu mantenimiento, pon la carta de la parte superior de tu biblioteca en tu cementerio.\\nUmbral El Hielasangre obtiene +1/+1 y tiene: "Al final de tu turno, remueve del juego dos cartas de tu cementerio". (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177236&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94a1b9c6-6ed6-4172-b4c0-74423f778981\', \'multiverseId\': 177236}, \'multiverseid\': 177236}, {\'name\': \'Celui qui glace le sang\', \'text\': "Vol\\nAu début de votre entretien, mettez la carte du dessus de votre bibliothèque dans votre cimetière.\\nSeuil — Celui qui glace le sang gagne +1/+1 et a « À la fin de votre tour, retirez de la partie deux cartes de votre cimetière. » (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176176&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a12b929b-17cb-4bbb-b9f6-33f45b1d2db5\', \'multiverseId\': 176176}, \'multiverseid\': 176176}, {\'name\': \'Raggelasangue\', \'text\': \'Volare\\nAll\\\'inizio del tuo mantenimento, metti nel tuo cimitero la prima carta del tuo grimorio.\\nSoglia Il Raggelasangue prende +1/+1 e ha "Alla fine del turno, rimuovi dal gioco due carte presenti nel tuo cimitero" (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Orrore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176685&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ef80bb60-0114-476e-aa01-bb6f8a318442\', \'multiverseId\': 176685}, \'multiverseid\': 176685}, {\'name\': \'凍血鬼\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d1300a1-810c-45bb-ad95-27f23924789c\'}, \'multiverseid\': None}, {\'name\': \'Gela-Sangue\', \'text\': \'Voar\\nNo início de sua manutenção, coloque o card do topo de seu grimório em seu cemitério.\\nLimiar — Gela-Sangue recebe +1/+1 e tem "No final do seu turno, remova de jogo dois cards de seu cemitério." (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178679&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1d0046d0-b86e-4e07-be1f-269759f716e2\', \'multiverseId\': 178679}, \'multiverseid\': 178679}]', '[{\'name\': \'Mauer der Engel\', \'text\': \'(Mauern können nicht angreifen.)\\nFliegend\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'„Die Ahnfrau beschützt uns in einer Weise, die wir kaum erfassen können. —Älterer Mystiker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175711&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'54d75077-0a77-4e39-9814-60d6b4cdeb29\', \'multiverseId\': 175711}, \'multiverseid\': 175711}, {\'name\': \'Muro angelical\', \'text\': \'(Los Muros no pueden atacar.)\\nVuela.\', \'type\': \'Criatura — Muro\', \'flavor\': \'"La Antepasada nos protege en maneras que distan mucho de ser comprendidas." —Anciano místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177123&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a49bdae-2615-491f-9287-ce91ce440834\', \'multiverseId\': 177123}, \'multiverseid\': 177123}, {\'name\': \'Mur angélique\', \'text\': \'(Les murs ne peuvent pas attaquer.)\\nVol\', \'type\': \'Créature : mur\', \'flavor\': \'« Les Ancêtres nous protègent par des moyens que nous commençons seulement à comprendre. » —Un doyen des mystiques.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176063&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'af17cf96-a464-4ea2-b710-5c2102781f90\', \'multiverseId\': 176063}, \'multiverseid\': 176063}, {\'name\': \'Muro Angelico\', \'text\': \'(I muri non possono attaccare).\\nVolare\', \'type\': \'Creatura — Muro\', \'flavor\': \'"Gli Antenati ci proteggono in un modo che non possiamo neppure comprendere". —anziano mistico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176572&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f035c64f-24e0-45cc-9dd9-801f69b5f967\', \'multiverseId\': 176572}, \'multiverseid\': 176572}, {\'name\': \'天使の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79158de1-271c-4eae-9c18-83bdec40006d\'}, \'multiverseid\': None}, {\'name\': \'Barreira Angelical\', \'text\': \'(As Barreiras não podem atacar.)\\nVoar\', \'type\': \'Criatura — Barreira\', \'flavor\': \'"A Ancestral nos protege de maneiras que nos é difícil começar a compreender." — Ancião místico\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178566&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ec2857d-7d82-487c-ad6d-f8b307d0a66b\', \'multiverseId\': 178566}, \'multiverseid\': 178566}]', "[{'name': 'Meeresgrundtrümmer', 'text': 'Die Meeresgrundtrümmer kommen getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U}.\\n{T}, opfere die Meeresgrundtrümmer: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176033&type=card', 'language': 'German', 'identifiers': {'scryfallId': '141573eb-c811-48e6-8c84-9cc160df0106', 'multiverseId': 176033}, 'multiverseid': 176033}, {'name': 'Escombros en el suelo marino', 'text': 'Los Escombros en el suelo marino entran en juego girados.\\n{T}: Agrega {U} a tu reserva de maná.\\n{T}, sacrificar los Escombros en el suelo marino: Agrega un maná de cualquier color a tu reserva de maná.', 'type': 'Tierra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177445&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd97a4cb5-53cd-48de-af1c-1b6c670a2a88', 'multiverseId': 177445}, 'multiverseid': 177445}, {'name': 'Débris des fonds marins', 'text': 'Ces Débris des fonds marins arrivent en jeu engagés.\\n{T} : Ajoutez {U} à votre réserve.\\n{T}, sacrifiez ces Débris des fonds marins : Ajoutez un mana de la couleur de votre choix à votre réserve.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176385&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7fc793af-5290-4e2a-a69b-8aa6af1b1086', 'multiverseId': 176385}, 'multiverseid': 176385}, {'name': 'Detriti del Fondale', 'text': 'I Detriti del Fondale entrano in gioco TAPpati.\\n{T}: Aggiungi {U} alla tua riserva di mana.\\n{T}, Sacrifica i Detriti del Fondale: Aggiungi un mana di un qualsiasi colore alla tua riserva.', 'type': 'Terra', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176894&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9d5a9a6b-fc60-4b95-925b-a54643e03acb', 'multiverseId': 176894}, 'multiverseid': 176894}, {'name': '海底の瓦礫', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '86053a3b-0ee6-4b39-9606-1e5368edf8a1'}, 'multiverseid': None}, {'name': 'Escombros Submersos', 'text': 'Escombros Submersos entra em jogo virado.\\n{T}: Adiciona {U} à sua reserva de mana.\\n{T}, Sacrifique Escombros Submersos: Adiciona uma mana de qualquer cor a sua reserva de mana.', 'type': 'Terreno', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178888&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'eb69d119-e808-4e13-8510-02842bad297b', 'multiverseId': 178888}, 'multiverseid': 178888}]", '[{\'name\': \'Meinungsänderung\', \'text\': \'Entferne eine angreifende Kreatur deiner Wahl ganz aus dem Spiel.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Plötzlich dämmerte es Jorin, dass auch das Bauerntum ein ehrwürdiger Beruf ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175753&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f869474d-c256-46a9-b081-7ab3bb143081\', \'multiverseId\': 175753}, \'multiverseid\': 175753}, {\'name\': \'Dudas\', \'text\': \'Remueve del juego la criatura objetivo atacante.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Repentinamente fue claro para Jorin que la agricultura era una profesión muy noble.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177165&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86bdf338-324f-425a-81b9-4f6a7026fb57\', \'multiverseId\': 177165}, \'multiverseid\': 177165}, {\'name\': \'Après réflexion\', \'text\': \'Retirez la créature attaquante ciblée de la partie.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "Après réflexion, Jorin se dit que fermier n\'était pas un sot métier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176105&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4379c713-f866-4abf-9736-3b38cac683ef\', \'multiverseId\': 176105}, \'multiverseid\': 176105}, {\'name\': \'Rivalutazione\', \'text\': \'Rimuovi dal gioco una creatura attaccante bersaglio.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Improvvisamente Jorin si accorse che quella del contadino era una professione decisamente apprezzabile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176614&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e075a9e2-bb97-4ae3-96f0-4a228c6e3172\', \'multiverseId\': 176614}, \'multiverseid\': 176614}, {\'name\': \'考え直し\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d96b1fd0-ece5-435e-b3c8-7a12630afe38\'}, \'multiverseid\': None}, {\'name\': \'Segundas Intenções\', \'text\': \'Remova do jogo a criatura alvo atacante.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'De repente Jorin começou a compreender que a lavoura era uma profissão até que nobre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178608&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23f9cca4-2204-4023-abcd-62199b4e0925\', \'multiverseId\': 178608}, \'multiverseid\': 178608}]', '[{\'name\': \'Meister-Apotheker\', \'text\': \'Tappe einen ungetappten Kleriker, den du kontrollierst: Verhindere die nächsten 2 Schadenspunkte, die einer Kreatur oder einem Spieler deiner Wahl in diesem Zug zugefügt würden.\', \'type\': \'Kreatur — Kleriker\', \'flavor\': \'Nur ein bemerkenswerter Kleriker kann eine Gruppe Heiler zu einem Hospital machen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175740&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b986ee5-2d50-41f7-9382-2a4c1d17d7d4\', \'multiverseId\': 175740}, \'multiverseid\': 175740}, {\'name\': \'Boticario experto\', \'text\': \'Girar un Clérigo enderezado que controles: Prevén los siguientes 2 puntos de daño que se le fuera a hacer a la criatura o jugador objetivo este turno.\', \'type\': \'Criatura — Clérigo\', \'flavor\': \'Se requiere a un clérigo admirable para convertir a un grupo de sanadores en un hospital.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177152&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c40e0c1d-ec91-4820-b13d-1724214e7af4\', \'multiverseId\': 177152}, \'multiverseid\': 177152}, {\'name\': \'Maître apothicaire\', \'text\': \'Engagez un clerc dégagé que vous contrôlez : Prévenez, ce tour-ci, les prochaines 2 blessures qui devraient être infligées à une cible, créature ou joueur.\', \'type\': \'Créature : clerc\', \'flavor\': "D\'un groupe de guérisseurs, il fait un hôpital.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176092&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4e81f3b-b9b7-4600-913d-e0aee88f3720\', \'multiverseId\': 176092}, \'multiverseid\': 176092}, {\'name\': \'Maestro Speziale\', \'text\': \'TAPpa un Chierico STAPpato che controlli: Previeni i prossimi 2 danni che vengono inflitti a una creatura o a un giocatore bersaglio in questo turno.\', \'type\': \'Creatura — Chierico\', \'flavor\': \'Ci vuole un chierico notevole per trasformare un gruppo di guaritori in un ospedale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176601&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b37426ef-232b-4c5f-a2c0-824c5d7988bd\', \'multiverseId\': 176601}, \'multiverseid\': 176601}, {\'name\': \'熟練の薬剤師\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4bda8de-acfb-43e1-865f-eb02d93c5962\'}, \'multiverseid\': None}, {\'name\': \'Mestre Boticário\', \'text\': \'Vire um Clérigo desvirado que você controla: Previne os próximos 2 pontos de dano que seriam causados à criatura alvo ou ao jogador alvo neste turno.\', \'type\': \'Criatura — Clérigo\', \'flavor\': \'É preciso um clérigo extraordinário para transformar um grupo de curandeiros em um hospital.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178595&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b33c9c3-7ed9-4cc9-bffe-c70f0cc7490f\', \'multiverseId\': 178595}, \'multiverseid\': 178595}]', '[{\'name\': \'Meuchelnder Zombie\', \'text\': \'{T}, entferne zwei Karten aus deinem Friedhof und den Meuchelnden Zombie ganz aus dem Spiel: Zerstöre eine nichtschwarze Kreatur deiner Wahl. Sie kann nicht regeneriert werden.\', \'type\': \'Kreatur — Zombie, Assassine\', \'flavor\': \'„Zombies töten nicht. Sie rekrutieren." —Braids, Wahnwitz-Beschwörerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175876&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8cdcf24a-f0c9-4850-83c7-e23c8d272b38\', \'multiverseId\': 175876}, \'multiverseid\': 175876}, {\'name\': \'Asesino zombie\', \'text\': \'{T}, remover del juego dos cartas de tu cementerio y el Asesino zombie: Destruye la criatura objetivo que no sea negra. No puede ser regenerada.\', \'type\': \'Criatura — Asesino zombie\', \'flavor\': \'"Los zombies no mata. Reclutan." —Trenzas, invocadora de demencia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177288&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31082617-4d36-4dea-9b16-185e507f0196\', \'multiverseId\': 177288}, \'multiverseid\': 177288}, {\'name\': \'zombie et assassin\', \'text\': "{T}, retirez de la partie deux cartes de votre cimetière et l\'Assassin zombie : Détruisez la créature non-noire ciblée. Elle ne peut pas être régénérée.", \'type\': \'Créature : zombie et assassin\', \'flavor\': \'« Les zombies ne tuent pas, ils recrutent. » —Nattes, invocatrice de démences.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176228&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3675957a-7221-4c04-ad24-b667947f3312\', \'multiverseId\': 176228}, \'multiverseid\': 176228}, {\'name\': \'Assassino Zombie\', \'text\': "{T}, Rimuovi dal gioco due carte presenti nel tuo cimitero e l\'Assassino Zombie: Distruggi una creatura bersaglio non nera. Non può essere rigenerata.", \'type\': \'Creatura — Assassino Zombie\', \'flavor\': \'"Gli Zombie non uccidono: reclutano". —-Braids, evocatore di dementia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176737&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d6f95c26-ca07-4aeb-8109-6dbc754562f6\', \'multiverseId\': 176737}, \'multiverseid\': 176737}, {\'name\': \'ゾンビの暗殺者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b96be06b-d7d3-422e-bf0f-04e365165e0c\'}, \'multiverseid\': None}, {\'name\': \'Assassino Zumbi\', \'text\': \'{T}, Remova de jogo dois cards de seu cemitério e Assassino Zumbi: Destrói a criatura alvo que não seja preta. Ela não pode ser regenerada.\', \'type\': \'Criatura — Assassino Zumbi\', \'flavor\': \'"Os zumbis não matam, eles recrutam." —Braids, invocadora da demência\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178731&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39d40fbf-6742-4ef5-88d7-12ca95fa77a7\', \'multiverseId\': 178731}, \'multiverseid\': 178731}]', '[{\'name\': \'Minenleger\', \'text\': \'{1}{R}, {T}: Lege eine Minenmarke auf ein Land deiner Wahl.\\nImmer wenn ein Land, auf dem eine Minenmarke liegt, getappt wird, zerstöre es.\\nEntferne alle Minenmarken von allen Ländern, wenn der Minenleger das Spiel verlässt.\', \'type\': \'Kreatur — Zwerg\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175913&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0e08aac4-25a0-4f85-926c-dd8c1161a0c3\', \'multiverseId\': 175913}, \'multiverseid\': 175913}, {\'name\': \'Siembraminas\', \'text\': \'{1}{R}, {T}: Pon un contador de mina sobre la tierra objetivo.\\nSiempre que se gire una tierra que tenga un contador de mina sobre ella, destrúyela.\\nCuando el Siembraminas salga del juego, remueve todos los contadores de minas de todas las tierras.\', \'type\': \'Criatura — Enano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177325&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d68e889d-845c-4b3a-93ac-d8e362f5f0fe\', \'multiverseId\': 177325}, \'multiverseid\': 177325}, {\'name\': \'Chercheur de filons\', \'text\': "{1}{R}, {T}: Mettez un marqueur « mine » sur le terrain ciblé.\\nÀ chaque fois qu\'un terrain avec un marqueur « mine » sur lui devient engagé, détruisez-le.\\nQuand le Chercheur de filons quitte le jeu, retirez tous les marqueurs « mine » de tous les terrains.", \'type\': \'Créature : nain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176265&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f41ca85c-1a87-418f-bd0f-33596067d2ff\', \'multiverseId\': 176265}, \'multiverseid\': 176265}, {\'name\': \'Posa Mine\', \'text\': \'{1}{R}, {T}: Metti un segnalino mina su una terra bersaglio.\\nOgniqualvolta una terra con un segnalino mina diventa TAPpata, distruggila.\\nQuando il Posa Mine lascia il gioco, rimuovi tutti i segnalini mina da tutte le terre.\', \'type\': \'Creatura — Nano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176774&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3c6a8bfc-0f0b-4108-91d2-6dca8e6fd211\', \'multiverseId\': 176774}, \'multiverseid\': 176774}, {\'name\': \'地雷の敷設者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5ff7bf92-7dce-42e2-9970-f28684bac4b0\'}, \'multiverseid\': None}, {\'name\': \'Lança-Minas\', \'text\': \'{1}{R}, {T}: Coloque um marcador de mina no terreno alvo.\\nToda vez que um terreno com um marcador de mina for virado, detrua-o.\\nQuando Lança-Minas sai de jogo, remova todos os marcadores de mina de todos os terrenos.\', \'type\': \'Criatura — Anão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178768&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a33f7375-a0f5-4026-b0b4-f12a620fb505\', \'multiverseId\': 178768}, \'multiverseid\': 178768}]', '[{\'name\': \'Minotaurischer Erforscher\', \'text\': \'Opfere den Minotaurischen Erforscher, wenn er ins Spiel kommt, falls du nicht eine zufällig bestimmte Karte aus deiner Hand abwirfst.\', \'type\': \'Kreatur — Minotaurus\', \'flavor\': \'Nachdem die Invasion die Stämme der Talruum und der Hurloon fast vernichtet hatte, begannen die Überlebenden, nach anderen Minotauren zu suchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175914&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af643b5e-70fd-468f-9fe9-8dc0e7e93ca7\', \'multiverseId\': 175914}, \'multiverseid\': 175914}, {\'name\': \'Minotauro explorador\', \'text\': \'Cuando el Minotauro explorador entre en juego, sacrifícalo a menos que descartes una carta al azar de tu mano.\', \'type\': \'Criatura — Minotauro\', \'flavor\': \'Después de que la invasión devastó las tribus de Talruum y Hurloon, los sobrevivientes comenzaron a buscar otros minotauros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177326&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f9a82cd-3bea-4cf2-973f-0de9632cf887\', \'multiverseId\': 177326}, \'multiverseid\': 177326}, {\'name\': \'Explorateur minotaure\', \'text\': "Quand l\'Explorateur minotaure arrive en jeu, sacrifiez-le à moins que vous ne vous défaussiez au hasard d\'une carte de votre main.", \'type\': \'Créature : minotaure\', \'flavor\': "L\'invasion avait presque éradiqué les tribus de l\'Hurloon et les Talruúms, et les rares survivants partirent à la recherche d\'autres minotaures.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176266&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'10d896bd-dc3a-4540-b201-af350e2baa2b\', \'multiverseId\': 176266}, \'multiverseid\': 176266}, {\'name\': \'Esploratore Minotauro\', \'text\': "Quando l\'Esploratore Minotauro entra in gioco, sacrificalo a meno che tu scarti una carta a caso dalla tua mano.", \'type\': \'Creatura — Minotauro\', \'flavor\': "Dopo che l\'invasione ebbe devastato le tribù di Talruum e Hurloon, i sopravvissuti cominciarono a cercare altri minotauri.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176775&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7046892-3e90-4f10-8fe9-1dfbb8b00ae8\', \'multiverseId\': 176775}, \'multiverseid\': 176775}, {\'name\': \'ミノタウルスの探検者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c377b01-640a-428c-a355-a8506d487476\'}, \'multiverseid\': None}, {\'name\': \'Minotauro Explorador\', \'text\': \'Quando Minotauro Explorador entra em jogo, sacrifique-o a menos que você descarte um card aleatoriamente de sua mão.\', \'type\': \'Criatura — Minotauro\', \'flavor\': \'Depois da invasão devastar as tribos de Talruum e Hurloon, os sobreviventes começaram a procurar por outros minotauros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178769&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9119a196-9090-420e-b169-a0e5233a9f80\', \'multiverseId\': 178769}, \'multiverseid\': 178769}]', '[{\'name\': \'Mirari\', \'text\': \'Immer wenn du einen Spontanzauber oder eine Hexerei spielst, kannst du {3} bezahlen. Falls du dies tust, lege eine Kopie dieses Zauberspruchs auf den Stapel. Du kannst andere Ziele für die Kopie bestimmen.\', \'type\': \'Legendäres Artefakt\', \'flavor\': \'„Er bietet dir, was du willst, nicht was du brauchst." —Braids, Wahnwitz-Beschwörerin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176011&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37487b0a-53b6-4b11-b300-51b356afbdeb\', \'multiverseId\': 176011}, \'multiverseid\': 176011}, {\'name\': \'Mirari\', \'text\': \'Siempre que juegues un hechizo de instantáneo o de conjuro, puedes pagar {3}. Si lo haces, pon una copia de ese hechizo en la pila. Puedes elegir nuevos objetivos para esa copia.\', \'type\': \'Artefacto legendario\', \'flavor\': \'"Te ofrece lo que quieres, no lo que necesitas." —Trenzas, invocadora de demencia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177423&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fa86414e-717f-4d22-a6fa-2a552a0d7059\', \'multiverseId\': 177423}, \'multiverseid\': 177423}, {\'name\': \'Mirari\', \'text\': "À chaque fois que vous jouez un sort d\'éphémère ou de rituel, vous pouvez payer {3}. Si vous faites ainsi, mettez une copie de ce sort sur la pile. Vous pouvez choisir de nouvelles cibles pour cette copie.", \'type\': \'Artefact légendaire\', \'flavor\': \'« Il offre toujours ce que vous désirez, rarement ce dont vous avez besoin. » —Nattes, invocatrice de démences.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176363&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3542a88-4c61-48ee-b312-be69b4546da3\', \'multiverseId\': 176363}, \'multiverseid\': 176363}, {\'name\': \'Mirari\', \'text\': \'Ogniqualvolta giochi una magia istantaneo o stregoneria, puoi spendere {3}. Se lo fai, metti sulla pila una copia di quella magia. Puoi scegliere nuovi bersagli per quella copia.\', \'type\': \'Artefatto Leggendario\', \'flavor\': \'"Ti offre ciò che vuoi, non ciò di cui hai bisogno". —-Braids, evocatore di dementia\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176872&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fa7e6ffd-716a-4916-81db-eae5590fabf6\', \'multiverseId\': 176872}, \'multiverseid\': 176872}, {\'name\': \'ミラーリ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'31b2698a-d83e-4dc5-8016-415314c7c030\'}, \'multiverseid\': None}, {\'name\': \'Mirari\', \'text\': \'Toda vez que você jogar uma mágica instantânea ou um feitiço, você pode pagar {3}. Se o fizer, coloque uma cópia daquela mágica na pilha. Você pode escolher novos alvos para aquela cópia.\', \'type\': \'Artefato Lendário\', \'flavor\': \'"Ele te oferece o que queres, não o que precisas." —Braids, invocadora da demência\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cd3795f5-a826-4bec-81d7-306c00926b6d\', \'multiverseId\': 178866}, \'multiverseid\': 178866}]', "[{'name': 'Moment des Friedens', 'text': 'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.\\nRückblende {2}{G} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175959&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6fe9d7ca-09c5-4b6f-b738-33b14186ff3a', 'multiverseId': 175959}, 'multiverseid': 175959}, {'name': 'Paz del momento', 'text': 'Prevén todo el daño de combate que se fuera a hacer este turno.\\nRetrospectiva {2}{G}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177371&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2261d1ef-35c1-40f0-96a7-853765b5eb32', 'multiverseId': 177371}, 'multiverseid': 177371}, {'name': 'Moment de paix', 'text': 'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.\\nFlashback {2}{G} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176311&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd7b69d6e-3ab9-4705-8578-869d47523644', 'multiverseId': 176311}, 'multiverseid': 176311}, {'name': 'Pace Momentanea', 'text': 'Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno.\\nFlashback {2}{G} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176820&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '58ff3066-dcd6-4fa3-8afa-7a548efecf45', 'multiverseId': 176820}, 'multiverseid': 176820}, {'name': '一瞬の平和', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '736ac598-4a4e-4c67-b84f-12d324db3cdc'}, 'multiverseid': None}, {'name': 'Paz Momentânea', 'text': 'Previne todo o dano de combate que seria causado neste turno.\\nRecapitular {2}{G} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178814&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3e6e5e5f-8376-4510-bcca-8d9c9c1556fa', 'multiverseId': 178814}, 'multiverseid': 178814}]", '[{\'name\': \'Moosfeuer-Ei\', \'text\': \'{2}, {T}, opfere das Moosfeuer-Ei: Erhöhe deinen Manavorrat um {R}{G}. Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'„Kannst du spüren, wie deine Instinkte deine Vernunft überwältigen?" —Watnik, Glasbläsermeister\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176012&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de61702b-fb2f-4b50-8918-930071c19693\', \'multiverseId\': 176012}, \'multiverseid\': 176012}, {\'name\': \'Huevo Fuegomusgo\', \'text\': \'{2}, {T}, sacrificar el Huevo Fuegomusgo: Agrega {R}{G} a tu reserva de maná. Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'"¿Puedes sentir cómo tus instintos abruman a tu razón?" —Wátnik, soplavidrio experto\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177424&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'711c4db0-56f9-4070-8d7e-140deb7b10f4\', \'multiverseId\': 177424}, \'multiverseid\': 177424}, {\'name\': \'Œuf de Moussefeu\', \'text\': "{2}, {T}, sacrifiez l\'Œuf de Moussefeu: Ajoutez {R}{G} à votre réserve. Piochez une carte.", \'type\': \'Artefact\', \'flavor\': "« Vos instincts l\'ont-ils emporté sur votre raison ? » —Warnik, maître souffleur de verre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176364&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'628decd1-4f85-45e5-884d-a7f9f4ce173f\', \'multiverseId\': 176364}, \'multiverseid\': 176364}, {\'name\': \'Uovo di Piromuschio\', \'text\': "{2}, {T}, Sacrifica l\'Uovo di Piromuschio: Aggiungi {R}{G} alla tua riserva di mana. Pesca una carta.", \'type\': \'Artefatto\', \'flavor\': \'"Senti che i tuoi istinti stanno per sopraffare la tua ragione?" —Watnik, mastro vetraio\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176873&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b98fd2c-1d76-47f9-8a4e-46c83b3dda87\', \'multiverseId\': 176873}, \'multiverseid\': 176873}, {\'name\': \'モスファイアの卵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d564aed-b3c9-48d4-a4d8-89153db53a1d\'}, \'multiverseid\': None}, {\'name\': \'Ovo de Mossfire\', \'text\': \'{2}, {T}, Sacrifique Ovo de Mossfire: Adiciona {R}{G} a sua reserva de mana. Compre um card.\', \'type\': \'Artefato\', \'flavor\': \'"Podes sentir teus instintos sobrepujarem tua razão?" — Watnik, mestre vidreiro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178867&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'99bbb95a-59c1-4d89-913d-53fab364cf9c\', \'multiverseId\': 178867}, \'multiverseid\': 178867}]', "[{'name': 'Moosfeuer-Tal', 'text': '{1}, {T}: Erhöhe deinen Manavorrat um {R}{G}.', 'type': 'Land', 'flavor': 'Üppiges Wachstum breitet sich wie ein grausamer Feuersturm über die Hügel von Otaria aus.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176029&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'df8e546d-4bbc-47d8-a2cd-c09aac431cf1', 'multiverseId': 176029}, 'multiverseid': 176029}, {'name': 'Valle Fuegomusgo', 'text': '{1}, {T}: Agrega {R}{G} a tu reserva de maná.', 'type': 'Tierra', 'flavor': 'El crecimiento frondoso se disemina como una llamarada feroz a través de las colinas otarianas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177441&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '08be4233-fdab-4da2-8e21-990e352858c3', 'multiverseId': 177441}, 'multiverseid': 177441}, {'name': 'Vallée de Moussefeu', 'text': '{1}, {T}: Ajoutez {R}{G} à votre réserve.', 'type': 'Terrain', 'flavor': 'Comme un feu ravageur, la luxuriance gagne une à une les collines.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176381&type=card', 'language': 'French', 'identifiers': {'scryfallId': '31b3b599-9c96-42e1-8dcb-2af4beb94cb9', 'multiverseId': 176381}, 'multiverseid': 176381}, {'name': 'Valle di Piromuschio', 'text': '{1}, {T}: Aggiungi {R}{G} alla tua riserva di mana.', 'type': 'Terra', 'flavor': 'La vegetazione ha ricoperto le colline di Otaria con la velocità di un incendio.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176890&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '29f3fc64-9bb0-4924-853b-ca00789ca16b', 'multiverseId': 176890}, 'multiverseid': 176890}, {'name': 'モスファイアの谷', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b8a58092-8b3c-4917-97c1-9ddc80804d7d'}, 'multiverseid': None}, {'name': 'Vale de Mossfire', 'text': '{1}, {T}: Adiciona {R}{G} a sua reserva de mana.', 'type': 'Terreno', 'flavor': 'Uma vegetação luxuriante se alastra como um incêndio pelas encostas Otarianas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178884&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c2a64ac4-4730-4014-82ea-4b38da58292a', 'multiverseId': 178884}, 'multiverseid': 178884}]", "[{'name': 'Morbider Hunger', 'text': 'Morbider Hunger fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu. Du erhältst 3 Lebenspunkte dazu.\\nRückblende {7}{B}{B} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175858&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7369d085-909f-4437-9810-df00517693fe', 'multiverseId': 175858}, 'multiverseid': 175858}, {'name': 'Hambre mórbida', 'text': 'El Hambre mórbida hace 3 puntos de daño a la criatura o jugador objetivo. Ganas 3 vidas.\\nRetrospectiva {7}{B}{B}. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177270&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '33efc4f6-1110-40bb-9edf-234ca25ed78b', 'multiverseId': 177270}, 'multiverseid': 177270}, {'name': 'Faim morbide', 'text': 'La Faim morbide inflige 3 blessures à une cible, créature ou joueur. Vous gagnez 3 points de vie.\\nFlashback {7}{B}{B} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176210&type=card', 'language': 'French', 'identifiers': {'scryfallId': '75cf26da-16d8-477a-a804-bd874906ce2b', 'multiverseId': 176210}, 'multiverseid': 176210}, {'name': 'Fame Morbosa', 'text': 'La Fame Morbosa infligge 3 danni a una creatura o a un giocatore bersaglio. Guadagni 3 punti vita.\\nFlashback {7}{B}{B} (puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176719&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f8bb66c7-c517-46a7-b7cb-fa49e8a5e74b', 'multiverseId': 176719}, 'multiverseid': 176719}, {'name': '病的な飢え', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'aa668147-19fc-4b39-a710-c4b900e15d85'}, 'multiverseid': None}, {'name': 'Fome Doentia', 'text': 'Fome Doentia causa 3 pontos de dano à criatura alvo ou ao jogador alvo. Você ganha 3 pontos de vida.\\nRecapitular {7}{B}{B} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178713&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '31863b6f-fc72-4dda-bfcf-863f68f48a67', 'multiverseId': 178713}, 'multiverseid': 178713}]", '[{\'name\': \'Muskelspiel\', \'text\': \'Eine Kreatur deiner Wahl erhält +X/+X bis zum Ende des Zuges, wobei X gleich 3 plus der Anzahl an Muskelspiel-Karten in allen Friedhöfen ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'So stark wie der Wille eines Zentauren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175960&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc2d6d3f-595c-4c72-8667-18b51db5dcf8\', \'multiverseId\': 175960}, \'multiverseid\': 175960}, {\'name\': \'Estallido de músculo\', \'text\': \'La criatura objetivo obtiene +X/+X hasta el final del turno, donde X es 3 más el número de cartas de Estallido de músculo que haya en todos los cementerios.\', \'type\': \'Instantáneo\', \'flavor\': \'Tan fuerte como la voluntad de un centauro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177372&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2a277f83-6c89-4e62-bb3b-da1d5987e021\', \'multiverseId\': 177372}, \'multiverseid\': 177372}, {\'name\': \'Explosion musculaire\', \'text\': "La créature ciblée gagne +X/+X jusqu\'à la fin du tour, où X est égal à 3 plus le nombre de cartes d\'Explosion musculaire dans tous les cimetières.", \'type\': \'Éphémère\', \'flavor\': "Aussi fort que la volonté d\'un centaure.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ecd66fe9-2b02-412e-846b-d626ae86e70e\', \'multiverseId\': 176312}, \'multiverseid\': 176312}, {\'name\': \'Esplosione Muscolare\', \'text\': \'La creatura bersaglio prende +X/+X fino alla fine del turno, dove X è pari a 3 più il numero di carte Esplosione Muscolare presenti in tutti i cimiteri.\', \'type\': \'Istantaneo\', \'flavor\': \'Forte come la volontà di un centauro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176821&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'243cdd60-7cb2-4c92-9f29-a2dd2954563b\', \'multiverseId\': 176821}, \'multiverseid\': 176821}, {\'name\': \'筋力急伸\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f91f590f-263d-460d-9993-aac06204437b\'}, \'multiverseid\': None}, {\'name\': \'Explosão de Músculos\', \'text\': \'A criatura alvo recebe +X/+X até o final do turno, onde X é igual a 3 mais o número de cards de Explosão de Músculos em todos os cemitérios.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Tão forte como a vontade de um centauro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'617119fc-5700-4fe7-9cf5-92321bb54501\', \'multiverseId\': 178815}, \'multiverseid\': 178815}]', '[{\'name\': \'Mystischer Büßer\', \'text\': \'Der Mystische Büßer wird beim Angreifen nicht getappt.\\nGrenzwert Der Mystische Büßer erhält +1/+1 und Flugfähigkeit. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Nomade, Mystiker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175742&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7496ebe8-cdc2-446a-8713-5ca4201b6a96\', \'multiverseId\': 175742}, \'multiverseid\': 175742}, {\'name\': \'Penitente místico\', \'text\': \'El Penitente místico no se gira al atacar.\\nUmbral El Penitente místico obtiene +1/+1 y tiene la habilidad de volar. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Místico nómada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177154&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5965ff95-b37e-4803-96bd-6c57f853466e\', \'multiverseId\': 177154}, \'multiverseid\': 177154}, {\'name\': \'Pénitent mystique\', \'text\': "Attaquer avec le Pénitent mystique ne le fait pas s\'engager.\\nSeuil — Le Pénitent mystique gagne +1/+1 et a le vol. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : nomade et mystique\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176094&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09ed442b-5afd-42d8-851a-0a61989e4cb7\', \'multiverseId\': 176094}, \'multiverseid\': 176094}, {\'name\': \'Penitente Mistico\', \'text\': \'Il Penitente Mistico attacca senza TAPpare.\\nSoglia - Il Penitente Mistico prende +1/+1 e ha volare (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Mistico Nomade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176603&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a03e9bf-2025-4f28-9b2f-0574ed566b54\', \'multiverseId\': 176603}, \'multiverseid\': 176603}, {\'name\': \'秘教の改悛者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be34e66f-8891-4c4b-9c37-5b7cac2e6b67\'}, \'multiverseid\': None}, {\'name\': \'Penitente Místico\', \'text\': \'Penitente Místico não é virado para atacar.\\nLimiar - Penitente Místico recebe +1/+1 e tem a habilidade de voar. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Místico Nômade\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178597&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01cb0ad4-0d75-4206-a51a-6ebb568ce38b\', \'multiverseId\': 178597}, \'multiverseid\': 178597}]', '[{\'name\': \'Mystischer Eiferer\', \'text\': \'Grenzwert Der Mystische Eiferer erhält +1/+1 und hat Flugfähigkeit. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Nomade, Mystiker\', \'flavor\': \'Es gibt für junge Nomaden zwei mögliche Lebenswege: Priester oder Kämpfer. Insgeheim träumen sie aber davon, beides zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d35d6a19-2e2f-4398-96a3-7b6b03277e04\', \'multiverseId\': 175744}, \'multiverseid\': 175744}, {\'name\': \'Fanático místico\', \'text\': \'Umbral El Fanático místico obtiene +1/+1 y tiene la habilidad de volar. (Tienes umbral mientras haya siete o más cartas en tu cementerio.)\', \'type\': \'Criatura — Místico nómada\', \'flavor\': \'Los jóvenes nómadas aspiran a uno de dos papeles en la tribu: sacerdote o guerrero. Su sueño secreto es convertirse en ambos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177156&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e0f806ac-e4f4-4531-9870-31c889ff4f40\', \'multiverseId\': 177156}, \'multiverseid\': 177156}, {\'name\': \'Zélateur mystique\', \'text\': "Seuil — Le Zélateur mystique gagne +1/+1 et a le vol. (Vous avez le seuil tant qu\'il y a sept cartes ou plus dans votre cimetière.)", \'type\': \'Créature : nomade et mystique\', \'flavor\': \'Les jeunes nomades aspirent à être prêtre ou guerrier, mais leur rêve secret est de devenir les deux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176096&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c7a65bd6-0bf3-4aad-ad7d-48d099791333\', \'multiverseId\': 176096}, \'multiverseid\': 176096}, {\'name\': \'Zelota Mistico\', \'text\': \'Soglia - Lo Zelota Mistico prende +1/+1 e ha volare (hai soglia fintanto che ci sono almeno sette carte nel tuo cimitero).\', \'type\': \'Creatura — Mistico Nomade\', \'flavor\': \'I giovani nomadi aspirano a due ruoli nella tribù: quella del sacerdote e quella del guerriero. Il loro sogno segreto è di diventare entrambi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=176605&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'58ceffa2-5912-42a5-a1d5-17e483525ff2\', \'multiverseId\': 176605}, \'multiverseid\': 176605}, {\'name\': \'秘教の盲信者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de9059a2-36bc-4772-8f9e-d75651245644\'}, \'multiverseid\': None}, {\'name\': \'Zelote Místico\', \'text\': \'Limiar - Zelote Místico recebe +1/+1 e tem a habilidade de voar. (Você atinge o limiar desde que haja sete ou mais cards em seu cemitério.)\', \'type\': \'Criatura — Místico Nômade\', \'flavor\': \'Jovens nômades aspiram a um de dois papéis na tribo: clérigo ou guerreiro. Seu sonho secreto é tornar-se ambos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=178599&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'01b8af3e-e0bc-498a-9234-fb73a2f39fcc\', \'multiverseId\': 178599}, \'multiverseid\': 178599}]', '[{\'name\': \'Mystischer Kreuzritter\', \'text\': \'Schutz vor Schwarz und vor Rot\\nGrenzwert Der Mystische Kreuzritter erhält +1/+1 und Flugfähigkeit. (Du hast den Grenzwert erreicht, solange sieben oder mehr Karten in deinem Friedhof sind.)\', \'type\': \'Kreatur — Nomade, Mystiker\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=175741&type=card\