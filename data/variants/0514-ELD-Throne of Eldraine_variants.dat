ype=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e0f68872-c391-442d-89a0-33e52ce3739c', 'multiverseId': 475107}, 'multiverseid': 475107}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475376&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8aadd6d8-92f5-4959-bba2-869cefed6ae3', 'multiverseId': 475376}, 'multiverseid': 475376}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475645&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '289f037b-ad9c-44ee-a313-598ab6d2ae62', 'multiverseId': 475645}, 'multiverseid': 475645}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475914&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '78c375e8-6948-4d7e-8bde-f48af031d742', 'multiverseId': 475914}, 'multiverseid': 475914}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473494&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4b5b4712-4255-429f-ac34-cec0ff581cd2', 'multiverseId': 473494}, 'multiverseid': 473494}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473763&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '77bad189-b7a9-4781-ac4f-6fa1b31e7d9b', 'multiverseId': 473763}, 'multiverseid': 473763}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474032&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2c6bcd67-d84e-478e-8711-84a4a50656ed', 'multiverseId': 474032}, 'multiverseid': 474032}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474301&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9f654c2b-c367-45d6-9bd0-348fc3f516e9', 'multiverseId': 474301}, 'multiverseid': 474301}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474570&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b748c4ca-f155-4fad-a697-89ed92d4b954', 'multiverseId': 474570}, 'multiverseid': 474570}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474839&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '79f91da5-591b-4a88-ade1-6b7a09dbac46', 'multiverseId': 474839}, 'multiverseid': 474839}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475108&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9d5c7720-7bf9-4f62-ba58-ccbdbba28bfc', 'multiverseId': 475108}, 'multiverseid': 475108}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475377&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fe120e86-d450-400c-80d1-2de26b113d83', 'multiverseId': 475377}, 'multiverseid': 475377}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475646&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2d2f7980-0369-4da7-b26c-6d352544e753', 'multiverseId': 475646}, 'multiverseid': 475646}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475915&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'baf5231c-b0e6-405c-8e62-eb4794b8c2d1', 'multiverseId': 475915}, 'multiverseid': 475915}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473495&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ae843b6d-3ff9-487c-a532-8469f2a8f408', 'multiverseId': 473495}, 'multiverseid': 473495}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473764&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1b005914-b178-4b15-8f24-6630a6a4080d', 'multiverseId': 473764}, 'multiverseid': 473764}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474033&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a40ac134-1c10-4c9b-8be9-ae3a80f04d74', 'multiverseId': 474033}, 'multiverseid': 474033}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474302&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8e1328fa-f1ef-47d7-8193-acf07acf1138', 'multiverseId': 474302}, 'multiverseid': 474302}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474571&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ae26419a-4e81-414c-afcc-daee44b48f6c', 'multiverseId': 474571}, 'multiverseid': 474571}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474840&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '89a761f2-1e53-4782-ad98-684984a5629b', 'multiverseId': 474840}, 'multiverseid': 474840}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475109&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5e8b29d3-ccff-4f23-ba08-228d6f50883a', 'multiverseId': 475109}, 'multiverseid': 475109}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475378&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '66561220-836e-437d-825f-fcb6c9e53e62', 'multiverseId': 475378}, 'multiverseid': 475378}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475647&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e3436aea-aa5a-4502-8ecb-3203502d7508', 'multiverseId': 475647}, 'multiverseid': 475647}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475916&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c61b9c90-fdc8-4a30-920b-6fe3b6a01afa', 'multiverseId': 475916}, 'multiverseid': 475916}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473496&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8d45f6bf-5775-428c-a8b4-4efff27d3c7f', 'multiverseId': 473496}, 'multiverseid': 473496}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473765&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1c1cfe30-dc50-46df-a7fe-42fbbc8a56f5', 'multiverseId': 473765}, 'multiverseid': 473765}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474034&type=card', 'language': 'French', 'identifiers': {'scryfallId': '77fce76a-7674-459f-ba44-db8e47433f7c', 'multiverseId': 474034}, 'multiverseid': 474034}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474303&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c2d07840-b088-42ac-9933-954c7ac25864', 'multiverseId': 474303}, 'multiverseid': 474303}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474572&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f473efe5-c7b3-4d7a-9d25-a9fac56b0657', 'multiverseId': 474572}, 'multiverseid': 474572}, {'name': '산', 'type': '기본 대지 — 산', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474841&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '6e0592f2-266a-49fc-9d97-eb885d9db3b7', 'multiverseId': 474841}, 'multiverseid': 474841}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475110&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '9ea486c0-aa82-4950-bb48-488e28863940', 'multiverseId': 475110}, 'multiverseid': 475110}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475379&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '303b8afe-99b2-4fd3-88a9-be2413c6337d', 'multiverseId': 475379}, 'multiverseid': 475379}, {'name': '山脉', 'type': '基本地 ～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475648&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd2f4ad3a-17e4-44d0-a42a-368259681e7a', 'multiverseId': 475648}, 'multiverseid': 475648}, {'name': '山脈', 'type': '基本地 ～山脈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475917&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'c1e87f8a-2481-405f-89d6-5a7b1e13b731', 'multiverseId': 475917}, 'multiverseid': 475917}]", '[{\'name\': \'Gedankenraub\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst davon eine Nichtland-Karte. Der Spieler wirft die bestimmte Karte ab. Du kannst eine Karte mit einem Abenteuer, die der Spieler besitzt, aus dem Exil auf den Friedhof des Spielers legen.\', \'type\': \'Hexerei\', \'flavor\': \'In der Wildnis stehlen die Raben weit mehr als nur Tand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473327&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0255d814-2db7-44e4-a340-8f5528979e7d\', \'multiverseId\': 473327}, \'multiverseid\': 473327}, {\'name\': \'Robo de recuerdos\', \'text\': \'El oponente objetivo muestra su mano. Tú eliges de ahí una carta que no sea tierra. Ese jugador descarta esa carta. Puedes poner en el cementerio de ese jugador desde el exilio una carta de la cual ese jugador sea propietario que tenga una Aventura.\', \'type\': \'Conjuro\', \'flavor\': \'En las tierras salvajes, los cuervos no solo roban baratijas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473596&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'33717d9f-7551-4459-9fd8-a93d6adeaf53\', \'multiverseId\': 473596}, \'multiverseid\': 473596}, {\'name\': \'Vol de mémoire\', \'text\': "L\'adversaire ciblé révèle sa main. Vous y choisissez une carte non-terrain. Ce joueur se défausse de cette carte. Vous pouvez mettre, depuis l\'exil, une carte avec une aventure que ce joueur possède dans le cimetière de ce joueur.", \'type\': \'Rituel\', \'flavor\': \'Dans les friches, les corbeaux ne volent pas que des babioles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473865&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82800cf3-d6f8-43dc-bb56-3cc002476d12\', \'multiverseId\': 473865}, \'multiverseid\': 473865}, {\'name\': \'Sottrazione di Memoria\', \'text\': "Un avversario bersaglio rivela la sua mano. Scegli una carta non terra da quella mano. Quel giocatore scarta quella carta. Puoi mettere una carta che ha un\'Avventura e di cui quel giocatore è proprietario dall\'esilio nel cimitero di quel giocatore.", \'type\': \'Stregoneria\', \'flavor\': \'Nelle terre selvagge, i corvi rubano molto più che gingilli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474134&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'51979080-1b74-45e9-b0ff-f222e1053605\', \'multiverseId\': 474134}, \'multiverseid\': 474134}, {\'name\': \'記憶盗み\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはその中から土地でないカード１枚を選ぶ。そのプレイヤーはそのカードを捨てる。あなたは、追放領域からそのプレイヤーがオーナーであり出来事を持つカード１枚を、そのプレイヤーの墓地に置いてもよい。\', \'type\': \'ソーサリー\', \'flavor\': \'僻境では、カラスが盗むのはつまらない物ではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474403&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'920b36ad-5f78-414d-abde-ee4b4910e12c\', \'multiverseId\': 474403}, \'multiverseid\': 474403}, {\'name\': \'기억 도둑\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 그중 대지가 아닌 카드 한 장을 선택한다. 그 플레이어는 그 카드를 버린다. 당신은 추방 영역에서 그 플레이어가 소유한 모험을 가진 카드 한 장을 그 플레이어의 무덤에 넣을 수 있다.\', \'type\': \'집중마법\', \'flavor\': \'야생지에서, 까마귀들은 그냥 반짝이는 것들보다 더 많은 것들을 훔친다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474672&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'772ced03-8765-4dda-a811-82a0d244c1f6\', \'multiverseId\': 474672}, \'multiverseid\': 474672}, {\'name\': \'Roubo de Memória\', \'text\': \'O oponente alvo revela a própria mão. Você escolhe um card que não seja um terreno da mão dele. Aquele jogador descarta aquele card. Você pode colocar no cemitério daquele jogador do exílio um card que aquele jogador possua com uma Aventura.\', \'type\': \'Feitiço\', \'flavor\': \'Nas terras selvagens, os corvos roubam muito mais do que bugigangas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474941&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b1a55d6c-e172-469f-93ea-9cf4dfac3716\', \'multiverseId\': 474941}, \'multiverseid\': 474941}, {\'name\': \'Кража Воспоминаний\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете из нее карту, не являющуюся землей. Тот игрок сбрасывает ту карту. Вы можете положить принадлежащую тому игроку карту с Приключением из изгнания на кладбище того игрока.\', \'type\': \'Волшебство\', \'flavor\': \'В диких дебрях вороны крадут куда больше, чем простые безделушки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475210&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7978e23f-f2af-40c2-9899-cc902f9447e8\', \'multiverseId\': 475210}, \'multiverseid\': 475210}, {\'name\': \'窃取记忆\', \'text\': \'目标对手展示其手牌。你选择其中一张非地牌。该牌手弃掉该牌。你可以将一张由该牌手拥有且具有历险的牌从放逐区置入该牌手的坟墓场。\', \'type\': \'法术\', \'flavor\': \'幻野之中的乌鸦，偷的可不只有饰品。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475479&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e11e7b15-c69f-49bf-a9d4-4f862d16f763\', \'multiverseId\': 475479}, \'multiverseid\': 475479}, {\'name\': \'竊取記憶\', \'text\': \'目標對手展示其手牌。你選擇其中一張非地牌。該玩家棄掉該牌。你可以將一張由該玩家擁有且具有歷險的牌從放逐區置入該玩家的墳墓場。\', \'type\': \'巫術\', \'flavor\': \'幻野之中的烏鴉，偷的可不只有飾品。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475748&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c8b9ac86-268f-490b-83d9-9de48709ef4b\', \'multiverseId\': 475748}, \'multiverseid\': 475748}]', '[{\'name\': \'Gefangen im Turm\', \'text\': \'Verzaubert eine nichtfliegende Kreatur\\nDie verzauberte Kreatur kann nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht aktiviert werden.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Zumindest habe ich hier oben meine Ruhe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473264&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c13c1ab-1b80-4389-a8b9-5c7594f8549a\', \'multiverseId\': 473264}, \'multiverseid\': 473264}, {\'name\': \'Atrapada en la torre\', \'text\': \'Encantar criatura sin la habilidad de volar.\\nLa criatura encantada no puede atacar ni bloquear y no pueden activarse sus habilidades activadas.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Al menos aquí arriba tengo un poco de tranquilidad...".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473533&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6a8c7653-8e6c-404f-85ce-fc13d2d2f648\', \'multiverseId\': 473533}, \'multiverseid\': 473533}, {\'name\': \'Prisonnière de la tour\', \'text\': \'Enchanter : créature sans le vol\\nLa créature enchantée ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être activées.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Au moins ici je suis en paix et au calme. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473802&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a474bbe6-da36-415c-ae03-b02dd90e86ed\', \'multiverseId\': 473802}, \'multiverseid\': 473802}, {\'name\': \'Intrappolata nella Torre\', \'text\': \'Incanta creatura senza volare\\nLa creatura incantata non può attaccare o bloccare e le sue abilità attivate non possono essere attivate.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Almeno quassù ho un po\\\' di pace e tranquillità."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474071&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9cd3cf6-e5bf-4617-ace1-2c54d9cfc099\', \'multiverseId\': 474071}, \'multiverseid\': 474071}, {\'name\': \'塔への閉じ込め\', \'text\': \'エンチャント（飛行を持たないクリーチャー）\\nエンチャントしているクリーチャーでは攻撃もブロックもできず、それの起動型能力は起動できない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「少なくともここには平穏と静けさがあるわ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474340&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f070db3-bc34-4287-b037-c8765143ac3c\', \'multiverseId\': 474340}, \'multiverseid\': 474340}, {\'name\': \'탑에 갇히다\', \'text\': \'비행이 없는 생물에게 부여\\n부여된 생물은 공격하거나 방어할 수 없으며, 그 생물의 활성화능력은 활성화될 수 없다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'"최소한 이 위에는 평화와 고요함이 조금이나마 있어."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474609&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'2fa5839d-beb7-4a01-b3c3-a1c33951698a\', \'multiverseId\': 474609}, \'multiverseid\': 474609}, {\'name\': \'Aprisionada na Torre\', \'text\': \'Encantar criatura sem voar\\nA criatura encantada não pode atacar nem bloquear e suas habilidades ativadas não podem ser ativadas.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Pelo menos aqui em cima eu tenho paz e sossego."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474878&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'460b698e-d1eb-45d8-bb1d-259d22e350c5\', \'multiverseId\': 474878}, \'multiverseid\': 474878}, {\'name\': \'Заточение в Башне\', \'text\': \'Зачаровать существо без Полета\\nЗачарованное существо не может атаковать или блокировать, и его активируемые способности не могут быть активированы.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Здесь хотя бы тихо и спокойно».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475147&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'749861df-9525-4a33-904c-8bd705502235\', \'multiverseId\': 475147}, \'multiverseid\': 475147}, {\'name\': \'受困高塔\', \'text\': \'结附于不具飞行异能的生物\\n所结附的生物不能进行攻击或阻挡，且其起动式异能都不能起动。\', \'type\': \'结界 ～灵气\', \'flavor\': \'「至少在这上面我还能有一丝清静。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475416&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'83b7d7cb-80ce-42cf-af21-d35879c5e268\', \'multiverseId\': 475416}, \'multiverseid\': 475416}, {\'name\': \'受困高塔\', \'text\': \'結附於不具飛行異能的生物\\n所結附的生物不能進行攻擊或阻擋，且其起動式異能都不能起動。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'「至少在這上面我還能有一絲清靜。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475685&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'67307364-0183-4d80-9e43-d3d2941f1ce8\', \'multiverseId\': 475685}, \'multiverseid\': 475685}]', '[{\'name\': \'Geliebte Prinzessin\', \'text\': \'Lebensverknüpfung\\nDie Geliebte Prinzessin kann von Kreaturen mit Stärke 3 oder mehr nicht geblockt werden.\', \'type\': \'Kreatur — Mensch, Adliger\', \'flavor\': \'Manchmal gelangt ein weicher Schuh dorthin, wo ein gepanzerter Stiefel abgewiesen wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473238&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e98df9a2-17b4-4941-8339-8cba439e3c50\', \'multiverseId\': 473238}, \'multiverseid\': 473238}, {\'name\': \'Princesa querida\', \'text\': \'Vínculo vital.\\nLa Princesa querida no puede ser bloqueada por criaturas con fuerza de 3 o más.\', \'type\': \'Criatura — Noble humano\', \'flavor\': \'A veces, un zapato gentil puede viajar allá donde a una bota de hierro se le vetó el paso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473507&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a3ab1264-1c47-4463-bb32-ba84ad0e909d\', \'multiverseId\': 473507}, \'multiverseid\': 473507}, {\'name\': \'Princesse adorée\', \'text\': \'Lien de vie\\nLa Princesse adorée ne peut pas être bloquée par des créatures de force supérieure ou égale à 3.\', \'type\': \'Créature : humain et noble\', \'flavor\': "Parfois, une pantoufle délicate peut s\'aventurer où un solide soleret n\'a pas pied.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473776&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba6078a6-8afc-4bf1-894e-12d21fcf0eba\', \'multiverseId\': 473776}, \'multiverseid\': 473776}, {\'name\': \'Principessa Adorata\', \'text\': \'Legame vitale\\nLa Principessa Adorata non può essere bloccata da creature con forza pari o superiore a 3.\', \'type\': \'Creatura — Nobile Umano\', \'flavor\': \'Talvolta una graziosa scarpetta può raggiungere luoghi preclusi a uno stivale corazzato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474045&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d02a8396-7923-4849-b65a-6ccc076c07a7\', \'multiverseId\': 474045}, \'multiverseid\': 474045}, {\'name\': \'敬愛される王女\', \'text\': \'絆魂\\n敬愛される王女は、パワーが３以上のクリーチャーによってはブロックされない。\', \'type\': \'クリーチャー — 人間・貴族\', \'flavor\': \'頑丈なブーツを拒む場所へ、上品な靴が行きつけることもある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474314&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3d09a610-ecf6-4254-8e63-5ab422043731\', \'multiverseId\': 474314}, \'multiverseid\': 474314}, {\'name\': \'사랑받는 공주\', \'text\': \'생명연결\\n사랑받는 공주는 공격력이 3 이상인 생물에게 방어될 수 없다.\', \'type\': \'생물 — 인간 귀족\', \'flavor\': \'때로는 장갑을 두른 장화가 거절되는 곳에 우아한 슬리퍼가 들어갈 수 있다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474583&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'8fa82fcb-110e-4911-a6d2-8efc99b4550f\', \'multiverseId\': 474583}, \'multiverseid\': 474583}, {\'name\': \'Princesa Adorada\', \'text\': \'Vínculo com a vida\\nPrincesa Adorada não pode ser bloqueada por criaturas de poder igual ou superior a 3.\', \'type\': \'Criatura — Humano Nobre\', \'flavor\': \'Às vezes uma sapatilha delicada consegue ir a lugares proibidos às grevas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474852&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eed8e9f8-6370-432c-b815-d829570a6096\', \'multiverseId\': 474852}, \'multiverseid\': 474852}, {\'name\': \'Обожаемая Принцесса\', \'text\': \'Цепь жизни\\nОбожаемая Принцесса не может быть заблокирована существами с силой 3 или больше.\', \'type\': \'Существо — Человек Аристократ\', \'flavor\': \'Порой изящная туфелька может попасть туда, куда заказан вход железному сапогу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475121&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f9472bbb-3ce6-486e-ba54-978cc8595ab4\', \'multiverseId\': 475121}, \'multiverseid\': 475121}, {\'name\': \'甜美公主\', \'text\': \'系命\\n甜美公主不能被力量等于或大于3的生物阻挡。\', \'type\': \'生物 ～人类／贵族\', \'flavor\': \'有时候穿着轻巧便鞋，能够去到武装战靴不得入内之处。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475390&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fe830470-dfb0-4a90-bdc3-3e21260036a9\', \'multiverseId\': 475390}, \'multiverseid\': 475390}, {\'name\': \'甜美公主\', \'text\': \'繫命\\n甜美公主不能被力量等於或大於3的生物阻擋。\', \'type\': \'生物 ～人類／貴族\', \'flavor\': \'有時候穿著輕巧便鞋，能夠去到武裝戰靴不得入內之處。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475659&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'8b91d657-343b-47ca-89d2-ed9d9f7e0767\', \'multiverseId\': 475659}, \'multiverseid\': 475659}]', '[{\'name\': \'Gerissene Jägerin\', \'text\': \'Immer wenn die Gerissene Jägerin angreift oder blockt, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\\nOpfere zwei Speisen: Ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': \'Keiner der anderen Dorfbewohner wagt sich in die Wildnis hinaus, also versorgt sie den ganzen Weiler selbst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473431&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'923304f6-ce89-4cb7-9f93-f31f23b5bfd8\', \'multiverseId\': 473431}, \'multiverseid\': 473431}, {\'name\': \'Cazadora avezada\', \'text\': \'Siempre que la Cazadora avezada ataque o bloquee, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\\nSacrificar dos Comidas. Roba una carta.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': \'Ninguno de los demás aldeanos se atreve a aventurarse en las tierras salvajes, así que ella alimenta sola a todo el pueblo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473700&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2f601085-17fd-4dd6-ab91-e86fddb183d8\', \'multiverseId\': 473700}, \'multiverseid\': 473700}, {\'name\': \'Chasseuse éclairée\', \'text\': "À chaque fois que la Chasseuse éclairée attaque ou bloque, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)\\nSacrifiez deux nourritures : Piochez une carte.", \'type\': \'Créature : humain et guerrier\', \'flavor\': "Aucun autre villageois n\'ose s\'aventurer dans les friches, c\'est pourquoi elle assure à elle-seule la subsistance de tout le hameau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473969&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d21bef69-3f05-4800-9008-0ba8f6e9bc37\', \'multiverseId\': 473969}, \'multiverseid\': 473969}, {\'name\': \'Cacciatrice Esperta\', \'text\': \'Ogniqualvolta la Cacciatrice Esperta attacca o blocca, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\\nSacrifica due Cibi: Pesca una carta.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': "Nessun altro abitante del villaggio osa avventurarsi nelle terre selvagge, così si occupa lei di sfamare l\'intero borgo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474238&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d3fb8d31-9203-47aa-be1b-1ebe5f0d1f92\', \'multiverseId\': 474238}, \'multiverseid\': 474238}, {\'name\': \'抜け目ない狩人\', \'text\': \'抜け目ない狩人が攻撃するかブロックするたび、食物・トークンを１つ生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\\n食物２つを生け贄に捧げる：カードを１枚引く。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': \'他の村人は誰も僻境へ入ろうとしないので、彼女が一人で村の食料を賄っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474507&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0825bb28-3884-4412-99f0-973e08653a54\', \'multiverseId\': 474507}, \'multiverseid\': 474507}, {\'name\': \'요령 있는 사냥꾼\', \'text\': \'요령 있는 사냥꾼이 공격하거나 방어할 때마다, 음식 토큰 한 개를 만든다. (음식 토큰은 "{2}, {T}, 이 마법물체를 희생한다: 당신은 생명 3점을 얻는다."를 가진 마법물체이다.)\\n음식 두 개를 희생한다: 카드 한 장을 뽑는다.\', \'type\': \'생물 — 인간 전사\', \'flavor\': \'다른 마을 사람들은 누구도 감히 야생지에 들어가려 하지 않기에, 그녀가 마을 전체를 혼자서 먹여 살린다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474776&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'585ff621-352a-46a1-8bf6-29f6f8095db3\', \'multiverseId\': 474776}, \'multiverseid\': 474776}, {\'name\': \'Caçadora Calejada\', \'text\': \'Toda vez que Caçadora Calejada atacar ou bloquear, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida.")\\nSacrifique duas Comidas: Compre um card.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': \'Nenhum dos demais aldeões ousa se aventurar nas terras selvagens. Assim, ela mesma alimenta a aldeia inteira.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475045&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e6876d55-eec0-43a6-a9cc-bb3c9ddf95d6\', \'multiverseId\': 475045}, \'multiverseid\': 475045}, {\'name\': \'Толковая Охотница\', \'text\': \'Каждый раз, когда Толковая Охотница атакует или блокирует, создайте одну фишку Еды. (Она является артефактом со способностью «{2}, {T}, пожертвуйте этот артефакт: вы получаете 3 жизни».)\\nПожертвуйте две Еды: возьмите карту.\', \'type\': \'Существо — Человек Воин\', \'flavor\': \'Никто из других жителей деревни не отваживался заходить в дикие дебри, так что она одна кормила все селение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475314&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'90c00d57-b8fa-469d-8cdc-e4584d112def\', \'multiverseId\': 475314}, \'multiverseid\': 475314}, {\'name\': \'机敏猎人\', \'text\': \'每当机敏猎人进行攻击或阻挡时，派出一个食品衍生物。（食品衍生物是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\\n牺牲两个食品：抓一张牌。\', \'type\': \'生物 ～人类／战士\', \'flavor\': \'其他村民都不敢踏进幻野，她得凭一己之力养活整个村庄。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475583&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'661bdca0-7ee5-4271-9582-97300e4ef9e5\', \'multiverseId\': 475583}, \'multiverseid\': 475583}, {\'name\': \'機敏獵人\', \'text\': \'每當機敏獵人進行攻擊或阻擋時，派出一個食品衍生物。（食品衍生物是具有「{2}，{T}，犧牲此神器：你獲得3點生命」的神器。）\\n犧牲兩個食品：抽一張牌。\', \'type\': \'生物 ～人類／戰士\', \'flavor\': \'其他村民都不敢踏進幻野，她得憑一己之力養活整個村莊。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475852&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'224b9108-c1d5-43e4-a076-093ad5354691\', \'multiverseId\': 475852}, \'multiverseid\': 475852}]', "[{'name': 'Geschenk des Kessels', 'text': 'Adamant — Falls drei oder mehr schwarze Mana ausgegeben wurden, um diesen Zauberspruch zu wirken, lege die obersten vier Karten deiner Bibliothek auf deinen Friedhof.\\nDu kannst eine Kreaturenkarte in deinem Friedhof bestimmen. Falls du dies tust, bringe sie mit einer zusätzlichen +1/+1-Marke ins Spiel zurück.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473314&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'edefc812-7bd7-42df-ab7d-c9c84a52c7f1', 'multiverseId': 473314}, 'multiverseid': 473314}, {'name': 'Regalo del Caldero', 'text': 'Tesón — Si se usaron al menos tres manás negros para lanzar este hechizo, pon las cuatro primeras cartas de tu biblioteca en tu cementerio.\\nPuedes elegir una carta de criatura en tu cementerio. Si lo haces, regrésala al campo de batalla con un contador +1/+1 adicional sobre ella.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473583&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'c7ec56c1-15d0-4f6e-9785-77b9d2b35de9', 'multiverseId': 473583}, 'multiverseid': 473583}, {'name': 'Don du chaudron', 'text': 'Inflexible — Si au moins trois manas noirs ont été dépensés pour lancer ce sort, mettez les quatre cartes du dessus de votre bibliothèque dans votre cimetière.\\nVous pouvez choisir une carte de créature dans votre cimetière. Si vous faites ainsi, renvoyez-la sur le champ de bataille avec un marqueur +1/+1 supplémentaire sur elle.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473852&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1e510751-9faa-4405-a44f-275ef3335815', 'multiverseId': 473852}, 'multiverseid': 473852}, {'name': 'Dono del Calderone', 'text': 'Adamantino — Se sono stati spesi almeno tre mana neri per lanciare questa magia, metti nel tuo cimitero le prime quattro carte del tuo grimorio.\\nPuoi scegliere una carta creatura nel tuo cimitero. Se lo fai, rimettila sul campo di battaglia con un segnalino +1/+1 addizionale.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474121&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '05afd703-419d-49a4-b12a-9098d9a23b77', 'multiverseId': 474121}, 'multiverseid': 474121}, {'name': '大釜の贈り物', 'text': '一徹 ― この呪文を唱えるために黒マナが３点以上支払われていたなら、あなたのライブラリーの一番上からカードを４枚あなたの墓地に置く。\\nあなたはあなたの墓地にあるクリーチャー・カード１枚を選んでもよい。そうしたなら、それを＋１/＋１カウンターが追加で１個置かれた状態で戦場に戻す。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474390&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e5623aa9-4efc-4e83-b9da-f4ee19a13a97', 'multiverseId': 474390}, 'multiverseid': 474390}, {'name': '가마솥의 선물', 'text': '단호 — 이 주문을 발동하는 데 적어도 흑색 마나 세 개가 지불되었다면, 당신의 서고 맨 위 카드 네 장을 당신의 무덤에 넣는다.\\n당신은 당신의 무덤에서 생물 카드 한 장을 선택할 수 있다. 그렇게 한다면, 그 카드를 +1/+1 카운터 한 개를 추가로 가진 채로 전장으로 되돌린다.', 'type': '집중마법', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474659&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '86fef149-c618-4aa4-a2b9-b0524aaf216a', 'multiverseId': 474659}, 'multiverseid': 474659}, {'name': 'Dádiva do Caldeirão', 'text': 'Obstinação — Se ao menos três manas pretos tiverem sido gastos para conjurar esta mágica, coloque os quatro cards do topo de seu grimório em seu cemitério.\\nVocê pode escolher um card de criatura em seu cemitério. Se fizer isso, devolva-o ao campo de batalha com um marcador +1/+1 adicional.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474928&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4b144e97-4bf5-4d7d-a293-55f7c0d59b4c', 'multiverseId': 474928}, 'multiverseid': 474928}, {'name': 'Дар Котла', 'text': 'Твердость — Если на разыгрывание этого заклинания было потрачено три или больше черной маны, положите четыре верхние карты вашей библиотеки на ваше кладбище.\\nВы можете выбрать карту существа на вашем кладбище. Если вы это делаете, верните ее на поле битвы с одним дополнительным жетоном +1/+1 на ней.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475197&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3b5861e4-7145-4c00-95e9-f3634c08d2e6', 'multiverseId': 475197}, 'multiverseid': 475197}, {'name': '鼎镬赋礼', 'text': '固色～如果施放此咒语时支付过至少三点黑色法术力，则将你牌库顶的四张牌置入你的坟墓场。\\n你可以选择一张在你坟墓场中的生物牌。如果你如此作，则将它移回战场，且上面额外有一个+1/+1指示物。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475466&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '632d12f0-79de-4496-91c5-760a3c99e541', 'multiverseId': 475466}, 'multiverseid': 475466}, {'name': '鼎鑊賦禮', 'text': '固色～如果施放此咒語時支付過至少三點黑色魔法力，則將你牌庫頂的四張牌置入你的墳墓場。\\n你可以選擇一張在你墳墓場中的生物牌。如果你如此作，則將它移回戰場，且上面額外有一個+1/+1指示物。', 'type': '巫術', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475735&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'd283b193-4e5a-43af-9b43-052d7c12f196', 'multiverseId': 475735}, 'multiverseid': 475735}]", '[{\'name\': \'Geschätzter Greif\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Greif\', \'flavor\': \'„Ich schrieb diese Geschichten mit einer Greifenfeder. Wie ich an die Feder gekommen bin, ist selbst eine spannende Geschichte."\\n—Chulane der Geschichtenerzähler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473255&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6eb962cf-c975-486a-8e0e-ecb4159a5a18\', \'multiverseId\': 473255}, \'multiverseid\': 473255}, {\'name\': \'Grifo preciado\', \'text\': \'Vuela.\', \'type\': \'Criatura — Grifo\', \'flavor\': \'"La pluma con la que escribí estas historias provenía de un grifo. Y cómo la conseguí... Bueno, eso ya es una historia en sí misma".\\n—Chulane, cuentacuentos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473524&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3ee4a923-9587-476c-8fdf-2d0408985bbc\', \'multiverseId\': 473524}, \'multiverseid\': 473524}, {\'name\': \'Griffon prisé\', \'text\': \'Vol\', \'type\': \'Créature : griffon\', \'flavor\': "« J\'ai écrit ces épopées avec une plume de griffon. L\'obtention de cette plume a elle-même été toute une épopée. »\\n—Chulane, conteur de fables", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473793&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a81ee7c-9a5d-48da-ace6-a2a890dd4715\', \'multiverseId\': 473793}, \'multiverseid\': 473793}, {\'name\': \'Grifone Ambito\', \'text\': \'Volare\', \'type\': \'Creatura — Grifone\', \'flavor\': \'"Ho scritto questi racconti con una penna ricavata da una piuma di grifone. E come sono riuscito a ottenere quella piuma è di per sé una storia incredibile."\\n—Chulene, Narratore di Racconti\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474062&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'79bca800-13f8-4ce0-9dec-8a80b710c437\', \'multiverseId\': 474062}, \'multiverseid\': 474062}, {\'name\': \'尊きグリフィン\', \'text\': \'飛行\', \'type\': \'クリーチャー — グリフィン\', \'flavor\': \'「この物語はグリフィンの羽でできたペンで書いたのだ。その羽を手に入れるまでの経緯も、まるで一つの物語だよ。」\\n――伝承の語り部、チュレイン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474331&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b38584b9-9f4e-4b94-b413-9a65194baaa6\', \'multiverseId\': 474331}, \'multiverseid\': 474331}, {\'name\': \'귀중한 그리핀\', \'text\': \'비행\', \'type\': \'생물 — 그리핀\', \'flavor\': \'"나는 그리핀의 깃털로 만들어진 깃펜으로 이 이야기들을 써 내려갔어. 그 깃털을 얻어낸 일도 그 자체로 이야깃거리가 된다고."\\n—이야기꾼, 출레인\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474600&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'ddee7c6b-586a-4740-8702-8850617ccfa4\', \'multiverseId\': 474600}, \'multiverseid\': 474600}, {\'name\': \'Grifo Cobiçado\', \'text\': \'Voar\', \'type\': \'Criatura — Grifo\', \'flavor\': \'"Escrevi estes contos com uma pena de grifo. E a conquista dessa pena também é um conto e tanto."\\n— Chulane, Narrador de Contos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f05bbbde-8d17-4aaa-85df-0117ac5d4655\', \'multiverseId\': 474869}, \'multiverseid\': 474869}, {\'name\': \'Ценный Грифон\', \'text\': \'Полет\', \'type\': \'Существо — Грифон\', \'flavor\': \'«Я записал эти истории пером, которое добыл у грифона. А как я его добыл — сама по себе история!»\\n— сказочник Чулейн\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475138&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'98b0d9fc-9a58-4b3a-b93d-5dc272e93b90\', \'multiverseId\': 475138}, \'multiverseid\': 475138}, {\'name\': \'珍奇狮鹫\', \'text\': \'飞行\', \'type\': \'生物 ～狮鹫\', \'flavor\': \'「书中传奇故事乃是用一根狮鹫羽毛制成的羽毛笔写就。而这跟羽毛的来历本身就是一段传奇。」\\n～说书人楚兰\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475407&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4295b24f-9fc3-456f-9d5b-b2180896cf57\', \'multiverseId\': 475407}, \'multiverseid\': 475407}, {\'name\': \'珍奇獅鷲\', \'text\': \'飛行\', \'type\': \'生物 ～獅鷲\', \'flavor\': \'「書中傳奇故事乃是用一根獅鷲羽毛製成的羽毛筆寫就。而這根羽毛的來歷本身就是一段傳奇。」\\n～說書人楚蘭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475676&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'3aa0a034-bebb-4027-9332-5d17ac6b2e6a\', \'multiverseId\': 475676}, \'multiverseid\': 475676}]', '[{\'name\': \'Gieriges Verlangen\', \'text\': \'Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst eine Nichtland-Karte im Friedhof oder auf der Hand jenes Spielers und schickst sie ins Exil. Du kannst die Karte wirken, solange sie im Exil ist, und um sie zu wirken kannst du Mana ausgeben, als wäre es Mana einer beliebigen Farbe.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473438&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc8cb852-5499-4293-b349-82b023dd4ef3\', \'multiverseId\': 473438}, \'multiverseid\': 473438}, {\'name\': \'Ansia codiciosa\', \'text\': \'El oponente objetivo muestra su mano. Elige una carta que no sea tierra del cementerio o la mano de ese jugador y exíliala. Puedes lanzar esa carta mientras permanezca exiliada, y puedes usar maná como si fuera maná de cualquier color para lanzarla.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473707&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3388c754-99ae-4afc-b180-1309fa6919d0\', \'multiverseId\': 473707}, \'multiverseid\': 473707}, {\'name\': \'Pulsion cupide\', \'text\': "L\'adversaire ciblé révèle sa main. Vous choisissez une carte non-terrain dans le cimetière ou la main de ce joueur et vous l\'exilez. Vous pouvez lancer cette carte tant qu\'elle reste exilée, et vous pouvez dépenser du mana comme s\'il s\'agissait de mana de n\'importe quelle couleur pour lancer ce sort.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473976&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c2d4e0bc-0409-48d7-9feb-7b577b80783e\', \'multiverseId\': 473976}, \'multiverseid\': 473976}, {\'name\': \'Impulso Bramoso\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta non terra dal cimitero o dalla mano di quel giocatore ed esiliala. Puoi lanciare quella carta fintanto che rimane esiliata e puoi spendere mana come se fosse mana di qualsiasi colore per lanciarla.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474245&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'68af5176-54a5-4e4b-a155-ad37dcfa90fe\', \'multiverseId\': 474245}, \'multiverseid\': 474245}, {\'name\': \'欲深い衝動\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。あなたはそのプレイヤーの墓地か手札から土地でないカード１枚を選び、それを追放する。それが追放され続けているかぎり、あなたはそのカードを唱えてもよく、その呪文を唱えるために任意のマナを望む色のマナであるかのように支払ってもよい。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474514&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f104480-6333-410a-87ae-845920e4adba\', \'multiverseId\': 474514}, \'multiverseid\': 474514}, {\'name\': \'갈망하는 충동\', \'text\': \'상대를 목표로 정한다. 그 플레이어는 자신의 손을 공개한다. 당신은 그 플레이어의 무덤 또는 손에서 대지가 아닌 카드 한 장을 골라 추방한다. 당신은 그 카드가 추방된 상태로 남아 있는 한 그 카드를 발동할 수 있으며, 그 주문을 발동하기 위한 마나는 당신이 원하는 색의 마나인 것처럼 사용할 수 있다.\', \'type\': \'집중마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474783&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'09dc181a-7ab5-4469-b51b-4ea8e28398eb\', \'multiverseId\': 474783}, \'multiverseid\': 474783}, {\'name\': \'Impulso Cobiçoso\', \'text\': \'O oponente alvo revela a própria mão. Você escolhe um card que não seja um terreno do cemitério ou da mão daquele jogador e o exila. Você pode conjurar aquele card enquanto ele permanecer exilado, e pode gastar mana como se fosse de qualquer cor para conjurar aquela mágica.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475052&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90117e63-b16a-41f8-9550-76e6c793f7f1\', \'multiverseId\': 475052}, \'multiverseid\': 475052}, {\'name\': \'Алчный Порыв\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете карту, не являющуюся землей, из кладбища или руки того игрока и изгоняете ее. Вы можете разыграть ту карту, пока она остается в изгнании, и вы можете тратить ману на разыгрывание того заклинания, как если бы это была мана любого цвета.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475321&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'45e499d8-a95b-4b15-8402-8cb3e7376f67\', \'multiverseId\': 475321}, \'multiverseid\': 475321}, {\'name\': \'贪婪索求\', \'text\': \'目标对手展示其手牌。你从该牌手的坟墓场或手牌选择一张非地牌将该牌放逐。于该牌持续放逐的时段内，你可以施放该牌，且你可以将法术力视同任意颜色的法术力来支付施放该咒语的费用。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475590&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8473e961-3607-40fe-9312-e9f4397960fc\', \'multiverseId\': 475590}, \'multiverseid\': 475590}, {\'name\': \'貪婪索求\', \'text\': \'目標對手展示其手牌。你從該玩家的墳墓場或手牌選擇一張非地牌並將該牌放逐。於該牌持續放逐的時段內，你可以施放該牌，且你可以將魔法力視同任意顏色的魔法力來支付施放該咒語的費用。\', \'type\': \'巫術\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475859&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f3d825d3-0265-4438-b4db-4065fc17263f\', \'multiverseId\': 475859}, \'multiverseid\': 475859}]', "[{'name': 'Glitzerjägerin', 'text': 'Fliegend, Wachsamkeit\\nDie Glitzerjägerin erhält +1/+1, solange du ein Artefakt kontrollierst.\\nDie Glitzerjägerin erhält +1/+1, solange du eine Verzauberung kontrollierst.', 'type': 'Kreatur — Feenwesen', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473432&type=card', 'language': 'German', 'identifiers': {'scryfallId': '723ce61f-c902-4e43-83a7-adf4c222d9b2', 'multiverseId': 473432}, 'multiverseid': 473432}, {'name': 'Rastreabrillos', 'text': 'Vuela, vigilancia.\\nLa Rastreabrillos obtiene +1/+1 mientras controles un artefacto.\\nLa Rastreabrillos obtiene +1/+1 mientras controles un encantamiento.', 'type': 'Criatura — Hada', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473701&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4f70b710-d93b-465a-9c65-718a248a2725', 'multiverseId': 473701}, 'multiverseid': 473701}, {'name': 'Chassebrille', 'text': 'Vol, vigilance\\nLa Chassebrille gagne +1/+1 tant que vous contrôlez un artefact.\\nLa Chassebrille gagne +1/+1 tant que vous contrôlez un enchantement.', 'type': 'Créature : peuple fée', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473970&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'db13c6bf-f33f-4c9d-96f6-9a027c29b003', 'multiverseId': 473970}, 'multiverseid': 473970}, {'name': 'Cacciasplendore', 'text': 'Volare, cautela\\nLa Cacciasplendore prende +1/+1 fintanto che controlli un artefatto.\\nLa Cacciasplendore prende +1/+1 fintanto che controlli un incantesimo.', 'type': 'Creatura — Spiritello', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474239&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '03bc5d47-63ad-4efc-b414-fa0f198a81eb', 'multiverseId': 474239}, 'multiverseid': 474239}, {'name': '輝き追い', 'text': '飛行、警戒\\nあなたがアーティファクトをコントロールしているかぎり、輝き追いは＋１/＋１の修整を受ける。\\nあなたがエンチャントをコントロールしているかぎり、輝き追いは＋１/＋１の修整を受ける。', 'type': 'クリーチャー — フェアリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474508&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '380047b5-de11-4b0f-abc6-d59d92b4e5fb', 'multiverseId': 474508}, 'multiverseid': 474508}, {'name': '반짝이추적꾼', 'text': '비행, 경계\\n당신이 마법물체를 조종하는 한 반짝이추적꾼은 +1/+1을 받는다.\\n당신이 부여마법을 조종하는 한 반짝이추적꾼은 +1/+1을 받는다.', 'type': '생물 — 페어리', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474777&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '377aa2bc-7190-421f-9e43-aaf1e35c8bfd', 'multiverseId': 474777}, 'multiverseid': 474777}, {'name': 'Buscabrilho', 'text': 'Voar, vigilância\\nBuscabrilho recebe +1/+1 enquanto você controla um artefato.\\nBuscabrilho recebe +1/+1 enquanto você controla um encantamento.', 'type': 'Criatura — Fada', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475046&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0a43852a-9ffa-4b67-9f6f-70ea13305544', 'multiverseId': 475046}, 'multiverseid': 475046}, {'name': 'Блескоискательница', 'text': 'Полет, Бдительность\\nБлескоискательница получает +1/+1, пока вы контролируете артефакт.\\nБлескоискательница получает +1/+1, пока вы контролируете чары.', 'type': 'Существо — Фея', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475315&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '6e3d1864-4af0-432f-bc85-f3dbd7117ff2', 'multiverseId': 475315}, 'multiverseid': 475315}, {'name': '逐宝仙灵', 'text': '飞行，警戒\\n只要你操控神器，逐宝仙灵便得+1/+1。\\n只要你操控结界，逐宝仙灵便得+1/+1。', 'type': '生物 ～仙灵', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475584&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '42a3e147-3c64-48d3-a481-3d2a5c40b679', 'multiverseId': 475584}, 'multiverseid': 475584}, {'name': '逐寶仙靈', 'text': '飛行，警戒\\n只要你操控神器，逐寶仙靈便得+1/+1。\\n只要你操控結界，逐寶仙靈便得+1/+1。', 'type': '生物 ～仙靈', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475853&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': '14d8b0d6-94e3-45ae-ab64-0398a8c31078', 'multiverseId': 475853}, 'multiverseid': 475853}]", '[{\'name\': \'Glänzende Rüstung\', \'text\': \'Aufblitzen\\nWenn die Glänzende Rüstung ins Spiel kommt, lege sie an einen Ritter deiner Wahl an, den du kontrollierst.\\nDie ausgerüstete Kreatur erhält +0/+2 und hat Wachsamkeit.\\nAusrüsten {3} ({3}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473260&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9e8a15dd-44a7-4372-a15f-5ddc7e026226\', \'multiverseId\': 473260}, \'multiverseid\': 473260}, {\'name\': \'Armadura brillante\', \'text\': \'Destello.\\nCuando la Armadura brillante entre al campo de batalla, anéxala al Caballero objetivo que controlas.\\nLa criatura equipada obtiene +0/+2 y tiene la habilidad de vigilancia.\\nEquipar {3}. ({3}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473529&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d76fb39c-dfa5-4ad9-b8c2-84a1a908831e\', \'multiverseId\': 473529}, \'multiverseid\': 473529}, {\'name\': \'Armure étincelante\', \'text\': "Flash\\nQuand l\'Armure étincelante arrive sur le champ de bataille, attachez-la à un chevalier ciblé que vous contrôlez.\\nLa créature équipée gagne +0/+2 et a la vigilance.\\nÉquipement {3} ({3} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473798&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcdc3ce5-27a0-4539-a175-5f94d4463ed2\', \'multiverseId\': 473798}, \'multiverseid\': 473798}, {\'name\': \'Armatura Lucente\', \'text\': "Lampo\\nQuando l\'Armatura Lucente entra nel campo di battaglia, assegnala a un Cavaliere bersaglio che controlli.\\nLa creatura equipaggiata prende +0/+2 e ha cautela.\\nEquipaggiare {3} ({3}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)", \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474067&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'66783c77-145f-4482-b9d4-1eada8b77883\', \'multiverseId\': 474067}, \'multiverseid\': 474067}, {\'name\': \'輝く鎧\', \'text\': \'瞬速\\n輝く鎧が戦場に出たとき、あなたがコントロールしている騎士１体を対象とし、これをそれにつける。\\n装備しているクリーチャーは＋０/＋２の修整を受け警戒を持つ。\\n装備{3}（{3}：あなたがコントロールしているクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474336&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac60b310-6587-4288-a62f-467c97c3c773\', \'multiverseId\': 474336}, \'multiverseid\': 474336}, {\'name\': \'빛나는 갑옷\', \'text\': \'섬광\\n빛나는 갑옷이 전장에 들어올 때, 당신이 조종하는 기사를 목표로 정한다. 빛나는 갑옷을 그 기사에 부착한다.\\n장착된 생물은 +0/+2를 받고 경계를 가진다.\\n장착 {3} ({3}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474605&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e99d6e04-645d-4668-8776-929db53030a5\', \'multiverseId\': 474605}, \'multiverseid\': 474605}, {\'name\': \'Armadura Brilhante\', \'text\': \'Lampejo\\nQuando Armadura Brilhante entrar no campo de batalha, anexe-a ao Cavaleiro alvo que você controla.\\nA criatura equipada recebe +0/+2 e tem vigilância.\\nEquipar {3} ({3}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474874&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ad7c62a-ddbc-4e65-8b9d-d65434b0debe\', \'multiverseId\': 474874}, \'multiverseid\': 474874}, {\'name\': \'Сияющие Доспехи\', \'text\': \'Миг\\nКогда Сияющие Доспехи выходят на поле битвы, прикрепите их к целевому Рыцарю под вашим контролем.\\nСнаряженное существо получает +0/+2 и имеет Бдительность.\\nСнарядить {3} ({3}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475143&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e155db24-2efa-4af7-a6c2-3983ab656445\', \'multiverseId\': 475143}, \'multiverseid\': 475143}, {\'name\': \'闪光盔甲\', \'text\': \'闪现\\n当闪光盔甲进战场时，将它装备在目标由你操控的骑士上。\\n佩带此武具的生物得+0/+2且具有警戒异能。\\n佩带{3}（{3}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475412&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c760378-bdc8-43cd-8a82-7e566f54a8df\', \'multiverseId\': 475412}, \'multiverseid\': 475412}, {\'name\': \'閃光盔甲\', \'text\': \'閃現\\n當閃光盔甲進戰場時，將它裝備在目標由你操控的騎士上。\\n佩帶此武具的生物得+0/+2且具有警戒異能。\\n佩帶{3}（{3}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器 ～武具\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475681&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bad1c536-6092-4065-b431-7352b5465fb2\', \'multiverseId\': 475681}, \'multiverseid\': 475681}]', '[{\'name\': \'Gläserner Sarg\', \'text\': \'Wenn der Gläserne Sarg ins Spiel kommt, schicke eine Kreatur deiner Wahl mit umgewandelten Manakosten von 3 oder weniger, die ein Gegner kontrolliert, ins Exil, bis der Gläserne Sarg das Spiel verlässt.\', \'type\': \'Artefakt\', \'flavor\': \'Das Schicksal wird entscheiden, ob er eine vorübergehende oder eine letzte Ruhestätte sein wird.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473246&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5050c7b6-8d1e-4675-81e7-d7f2f2fba535\', \'multiverseId\': 473246}, \'multiverseid\': 473246}, {\'name\': \'Féretro de cristal\', \'text\': \'Cuando el Féretro de cristal entre al campo de batalla, exilia la criatura objetivo que controla un oponente con coste de maná convertido de 3 o menos hasta que el Féretro de cristal deje el campo de batalla.\', \'type\': \'Artefacto\', \'flavor\': \'El destino decidirá si es un lecho o una tumba.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473515&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3bcd4050-adca-4a7e-9f74-75bd8fe0a8b0\', \'multiverseId\': 473515}, \'multiverseid\': 473515}, {\'name\': \'Cercueil de verre\', \'text\': "Quand le Cercueil de verre arrive sur le champ de bataille, exilez une créature ciblée avec un coût converti de mana inférieur ou égal à 3 qu\'un adversaire contrôle jusqu\'à ce que le Cercueil de verre quitte le champ de bataille.", \'type\': \'Artefact\', \'flavor\': "Le destin décidera s\'il s\'agit d\'un lit ou d\'un tombeau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7d9ab29-bbad-4f57-bb1f-efbb3d97f7cc\', \'multiverseId\': 473784}, \'multiverseid\': 473784}, {\'name\': \'Feretro di Cristallo\', \'text\': \'Quando il Feretro di Cristallo entra nel campo di battaglia, esilia una creatura bersaglio controllata da un avversario con costo di mana convertito pari o inferiore a 3 finché il Feretro di Cristallo non lascia il campo di battaglia.\', \'type\': \'Artefatto\', \'flavor\': \'Sarà il destino a decidere se è un giaciglio o una tomba.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474053&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c2789ed-6e5c-4178-b849-76282e68568b\', \'multiverseId\': 474053}, \'multiverseid\': 474053}, {\'name\': \'ガラスの棺\', \'text\': \'ガラスの棺が戦場に出たとき、対戦相手がコントロールしていて点数で見たマナ・コストが３以下のクリーチャー１体を対象とし、ガラスの棺が戦場を離れるまでそれを追放する。\', \'type\': \'アーティファクト\', \'flavor\': \'ベッドか墓かは運命次第。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474322&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b147eb39-c8f0-412a-94bf-e10b502ecaf7\', \'multiverseId\': 474322}, \'multiverseid\': 474322}, {\'name\': \'유리 장식함\', \'text\': \'유리 장식함이 전장에 들어올 때, 상대가 조종하는 전환마나비용이 3 이하인 생물을 목표로 정한다. 유리 장식함이 전장을 떠날 때까지 그 생물을 추방한다.\', \'type\': \'마법물체\', \'flavor\': \'침대일지 무덤일지는 운명이 정할 것이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474591&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'965eaa8a-2a16-441e-83b8-5594216c2913\', \'multiverseId\': 474591}, \'multiverseid\': 474591}, {\'name\': \'Féretro de Vidro\', \'text\': \'Quando Féretro de Vidro entrar no campo de batalha, exile a criatura alvo que um oponente controla com custo de mana convertido igual ou inferior a 3 até que Féretro de Vidro deixe o campo de batalha.\', \'type\': \'Artefato\', \'flavor\': \'O destino decidirá se é uma cama ou uma tumba.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474860&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'927d5187-4637-42b0-985d-a4798f98dd2a\', \'multiverseId\': 474860}, \'multiverseid\': 474860}, {\'name\': \'Стеклянный Гроб\', \'text\': \'Когда Стеклянный Гроб выходит на поле битвы, изгоните целевое существо под контролем оппонента с конвертированной мана-стоимостью не более 3 до тех пор, пока Стеклянный Гроб не покинет поле битвы.\', \'type\': \'Артефакт\', \'flavor\': \'Судьба решит, что это — ложе или могила.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475129&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9da93736-f974-45ae-bc13-28a5e8d349ff\', \'multiverseId\': 475129}, \'multiverseid\': 475129}, {\'name\': \'玻璃棺\', \'text\': \'当玻璃棺进战场时，放逐目标由对手操控且总法术力费用等于或小于3的生物，直到玻璃棺离开战场为止。\', \'type\': \'神器\', \'flavor\': \'是卧榻或灵棺，全看命运安排。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475398&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8dccfd63-3e92-47eb-b4ec-414628c9c5c0\', \'multiverseId\': 475398}, \'multiverseid\': 475398}, {\'name\': \'玻璃棺\', \'text\': \'當玻璃棺進戰場時，放逐目標由對手操控且總魔法力費用等於或小於3的生物，直到玻璃棺離開戰場為止。\', \'type\': \'神器\', \'flavor\': \'是臥榻或靈棺，全看命運安排。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475667&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'d900bb48-dde5-4ab7-ab01-bfe3147ab2dc\', \'multiverseId\': 475667}, \'multiverseid\': 475667}]', '[{\'name\': \'Gläserner Schuh\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+0 und hat Eile.\\nAusrüsten {1} ({1}: Lege diese Karte an eine Kreatur deiner Wahl an, die du kontrollierst. Spiele Ausrüsten wie eine Hexerei.)\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'„Nach dem Tod ihrer Mutter stellte Cassia fest, dass Dinge, die zerbrechlich wirken, ungemein stark sein können."\\n—*Jenseits des Großen Steinkreises*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473350&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f2f06b3b-ed35-47fd-9a46-05c0e0f66c36\', \'multiverseId\': 473350}, \'multiverseid\': 473350}, {\'name\': \'Zapato de cristal\', \'text\': \'La criatura equipada obtiene +1/+0 y tiene la habilidad de prisa.\\nEquipar {1}. ({1}: Anexa este Equipo a la criatura objetivo que controlas. Activa la habilidad de equipar como un conjuro.)\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'"Tras la muerte de su madre, Cassia descubrió que las cosas que parecían frágiles podían ser muy fuertes".\\n—*Más allá del Gran Crómlech*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473619&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'166883ac-7f1e-473e-841e-d6f99bb50194\', \'multiverseId\': 473619}, \'multiverseid\': 473619}, {\'name\': \'Pantoufle de cristal\', \'text\': "La créature équipée gagne +1/+0 et a la célérité.\\nÉquipement {1} ({1} : Attachez à la créature ciblée que vous contrôlez. N\'attachez l\'équipement que lorsque vous pourriez lancer un rituel.)", \'type\': \'Artefact : équipement\', \'flavor\': "« Après la mort de sa mère, Cassia apprit qu\'une apparente fragilité pouvait dissimuler une grande force. »\\n—*Au-delà du Grand Cromlech*", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473888&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd7386c4-5677-45b5-bb36-2e416fceb1b4\', \'multiverseId\': 473888}, \'multiverseid\': 473888}, {\'name\': \'Scarpetta di Cristallo\', \'text\': \'La creatura equipaggiata prende +1/+0 e ha rapidità.\\nEquipaggiare {1} ({1}: Assegna a una creatura bersaglio che controlli. Equipaggia solo quando potresti lanciare una stregoneria.)\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'"Dopo la morte di sua madre, Cassia scoprì che le cose in apparenza fragili possono rivelarsi invece molto forti."\\n—*Oltre il Grande Monolito*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474157&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9e33271a-9719-4dbe-8fcb-f2c69f3ae342\', \'multiverseId\': 474157}, \'multiverseid\': 474157}, {\'name\': \'水晶の靴\', \'text\': \'装備しているクリーチャーは＋１/＋０の修整を受け速攻を持つ。\\n装備{1}（{1}：あなたがコントロールしているクリーチャー１体を対象とし、これをそれにつける。装備はソーサリーとしてのみ行う。）\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'「母親が死んでから、カシアは一見壊れやすいものでも立派に強くなれるということを知った。」\\n――*グレートヘンジを超えて*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474426&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d2b0e424-452a-4cde-a1c9-12b4bb2f0a33\', \'multiverseId\': 474426}, \'multiverseid\': 474426}, {\'name\': \'수정 슬리퍼\', \'text\': \'장착된 생물은 +1/+0을 받고 신속을 가진다.\\n장착 {1} ({1}: 당신이 조종하는 생물을 목표로 정한다. 그 생물에 이 장비를 부착한다. 당신이 집중마법을 발동할 수 있는 시기에만 장착할 수 있다.)\', \'type\': \'마법물체 — 장비\', \'flavor\': \'"어머니의 죽음 이후로, 카시아는 연약해 보이는 것들이 실제로는 매우 강할 수 있다는 것을 알아차렸다."\\n—*거대한 헨지 저편*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474695&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'da956d4a-80ef-4bad-9919-d8b195aa0365\', \'multiverseId\': 474695}, \'multiverseid\': 474695}, {\'name\': \'Sapatinho de Cristal\', \'text\': \'A criatura equipada recebe +1/+0 e tem ímpeto.\\nEquipar {1} ({1}: Anexe este equipamento à criatura alvo que você controla. Equipe somente como um feitiço.)\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'"Depois da morte da mãe, Cassia descobriu que coisas que parecem frágeis podem na verdade ser muito fortes."\\n— *Além do Grande Círculo*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474964&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63a66467-6d76-4f71-828a-c32b36fc4177\', \'multiverseId\': 474964}, \'multiverseid\': 474964}, {\'name\': \'Хрустальная Туфелька\', \'text\': \'Снаряженное существо получает +1/+0 и имеет Ускорение.\\nСнарядить {1} ({1}: прикрепите к целевому существу под вашим контролем. Снаряжайте только как волшебство.)\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'«После смерти матери Кассия узнала, что вещи, которые кажутся такими хрупкими, на деле могут быть удивительно прочны».\\n— *«За Великим Кромлехом»*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475233&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d4205a1c-d022-4734-aa35-1b7c2e7dca68\', \'multiverseId\': 475233}, \'multiverseid\': 475233}, {\'name\': \'水晶舞鞋\', \'text\': \'佩带此武具的生物得+1/+0且具有敏捷异能。\\n佩带{1}（{1}：装备在目标由你操控的生物上。佩带的时机视同法术。）\', \'type\': \'神器 ～武具\', \'flavor\': \'「母亲去世后，卡熙雅才发现，原来外表脆弱之人，内心也可以如此坚强。」\\n～*《圆石阵奇谭》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475502&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fa37d49a-dcf2-44d0-b588-dc5410fda1e7\', \'multiverseId\': 475502}, \'multiverseid\': 475502}, {\'name\': \'水晶舞鞋\', \'text\': \'佩帶此武具的生物得+1/+0且具有敏捷異能。\\n佩帶{1}（{1}：裝備在目標由你操控的生物上。佩帶的時機視同巫術。）\', \'type\': \'神器 ～武具\', \'flavor\': \'「母親去世後，卡熙雅才發現，原來外表脆弱之人，內心也可以如此堅強。」\\n～*《圓石陣奇譚》*\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475771&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'0aadc729-84d3-4d36-8e4f-6c755f6b6190\', \'multiverseId\': 475771}, \'multiverseid\': 475771}]', '[{\'name\': \'Glücklich bis ans Ende\', \'text\': \'Wenn Glücklich bis ans Ende ins Spiel kommt, erhält jeder Spieler 5 Lebenspunkte dazu und zieht eine Karte.\\nZu Beginn deines Versorgungssegments und falls bleibende Karten, die du kontrollierst, gemeinsam fünf Farben haben, bleibende Karten, die du kontrollierst, und/oder Karten, die sich in deinem Friedhof befinden, gemeinsam sechs oder mehr Kartentypen haben und dein Lebenspunktestand größer oder gleich deiner Startlebenspunktezahl ist, gewinnst du die Partie.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473247&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3af3efd-555a-4d29-88d0-cc64337d5f85\', \'multiverseId\': 473247}, \'multiverseid\': 473247}, {\'name\': \'Felices para siempre\', \'text\': \'Cuando Felices para siempre entre al campo de batalla, cada jugador gana 5 vidas y roba una carta.\\nAl comienzo de tu mantenimiento, si hay cinco colores entre los permanentes que controlas, hay seis o más tipos de cartas entre los permanentes que controlas y/o las cartas en tu cementerio, y tu total de vidas es mayor o igual que tu total de vidas inicial, ganas el juego.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473516&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f18a9c3-83ae-404f-9389-157395e4deed\', \'multiverseId\': 473516}, \'multiverseid\': 473516}, {\'name\': \'Ils vécurent heureux...\', \'text\': "Quand Ils vécurent heureux... arrive sur le champ de bataille, chaque joueur gagne 5 points de vie et pioche une carte.\\nAu début de votre entretien, s\'il y a cinq couleurs parmi les permanents que vous contrôlez, s\'il y a au moins six types de carte parmi les permanents que vous contrôlez et/ou les cartes de votre cimetière, et si votre total de points de vie est supérieur ou égal à votre total de points de vie de départ, vous gagnez la partie.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473785&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef9e1d41-9a75-49b1-a223-f61beccb182e\', \'multiverseId\': 473785}, \'multiverseid\': 473785}, {\'name\': \'Per Sempre Felici e Contenti\', \'text\': "Quando Per Sempre Felici e Contenti entra nel campo di battaglia, ogni giocatore guadagna 5 punti vita e pesca una carta.\\nAll\'inizio del tuo mantenimento, se ci sono cinque colori tra i permanenti che controlli, ci sono sei o più tipi di carta tra i permanenti che controlli e/o le carte nel tuo cimitero e i tuoi punti vita sono pari o superiori ai tuoi punti vita iniziali, vinci la partita.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474054&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'80066153-f4a1-489e-9adb-914333ac32bd\', \'multiverseId\': 474054}, \'multiverseid\': 474054}, {\'name\': \'めでたしめでたし\', \'text\': \'めでたしめでたしが戦場に出たとき、各プレイヤーはそれぞれ、５点のライフを得てカードを１枚引く。\\nあなたのアップキープの開始時に、あなたがコントロールしているパーマネントに色が５色含まれていて、あなたがコントロールしているパーマネントやあなたの墓地にあるカードにカード・タイプが６種類以上含まれていて、あなたのライフ総量があなたの初期ライフ総量以上であった場合、あなたはこのゲームに勝利する。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474323&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32130cc2-b25c-4a52-9462-5ddf06e3be65\', \'multiverseId\': 474323}, \'multiverseid\': 474323}, {\'name\': \'그 후로 행복하게\', \'text\': \'그 후로 행복하게가 전장에 들어올 때, 각 플레이어는 생명 5점을 얻고 카드 한 장을 뽑는다.\\n당신의 유지단 시작에, 당신이 조종하는 지속물들이 다섯 가지 색을 가지고 있고, 당신이 조종하는 지속물들 및/또는 당신의 무덤에 있는 카드들에 카드 유형이 6가지 이상 있으며, 당신의 생명 총점이 당신의 시작 생명 총점 이상이라면, 당신은 게임에서 승리한다.\', \'type\': \'부여마법\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474592&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f823b541-7f44-4dee-85bd-3e7c9a331b2e\', \'multiverseId\': 474592}, \'multiverseid\': 474592}, {\'name\': \'Felizes para Sempre\', \'text\': \'Quando Felizes para Sempre entra no campo de batalha, cada jogador ganha 5 pontos de vida e compra um card.\\nNo início de sua manutenção, se houver cinco cores entre as permanentes que você controla, houver seis ou mais tipos de card entre as permanentes que você controla e/ou entre os cards de seu cemitério e seu total de pontos de vida for igual ou superior a seu total de pontos de vida inicial, você vence o jogo.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62bb0a61-891e-4ab2-a1d6-d18745f4eaeb\', \'multiverseId\': 474861}, \'multiverseid\': 474861}, {\'name\': \'Жить Долго и Счастливо\', \'text\': \'Когда Жить Долго и Счастливо выходит на поле битвы, каждый игрок получает 5 жизней и берет карту.\\nВ начале вашего шага поддержки, если среди перманентов под вашим контролем есть пять цветов, среди перманентов под вашим контролем и (или) карт на вашем кладбище есть не менее шести типов карт, а количество ваших жизней равняется или превышает ваше начальное количество жизней, то вы выигрываете партию.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475130&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae7a0f60-16a4-43eb-b3ef-97322fd01cbd\', \'multiverseId\': 475130}, \'multiverseid\': 475130}, {\'name\': \'圆满结局\', \'text\': \'当圆满结局进战场时，每位牌手获得5点生命且各抓一张牌。\\n在你的维持开始时，若由你操控的永久物之中所包括的颜色有五种，且由你操控的永久物和／或在你坟墓场中的牌之中牌张类别有六种或更多，且你的总生命等于或大于你的起始总生命，则你赢得这盘游戏。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475399&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6acf509-02fd-4907-a753-2513c6e71049\', \'multiverseId\': 475399}, \'multiverseid\': 475399}, {\'name\': \'圓滿結局\', \'text\': \'當圓滿結局進戰場時，每位玩家獲得5點生命且各抽一張牌。\\n在你的維持開始時，若由你操控的永久物之中所包括的顏色有五種，且由你操控的永久物和／或在你墳墓場中的牌之中牌張類別有六種或更多，且你的總生命等於或大於你的起始總生命，則你贏得這盤遊戲。\', \'type\': \'結界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475668&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'dcf6ce0a-8dbf-46a5-98ee-ee4484f98dc3\', \'multiverseId\': 475668}, \'multiverseid\': 475668}]', '[{\'name\': \'Goldene Gans\', \'text\': \'Fliegend\\nWenn die Goldene Gans ins Spiel kommt, erzeuge einen Speise-Spielstein. (Er ist ein Artefakt mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\\n{1}{G}, {T}: Erzeuge einen Speise-Spielstein.\\n{T}, opfere eine Speise: Erzeuge ein Mana einer beliebigen Farbe.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473391&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'382368d1-d5c5-4929-83b4-ed7d75c89381\', \'multiverseId\': 473391}, \'multiverseid\': 473391}, {\'name\': \'Gansa dorada\', \'text\': \'Vuela.\\nCuando la Gansa dorada entre al campo de batalla, crea una ficha de Comida. (Es un artefacto con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\\n{1}{G}, {T}: Crea una ficha de Comida.\\n{T}, sacrificar una Comida: Agrega un maná de cualquier color.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473660&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'260cd0c7-c93b-4eb3-b953-14925285edac\', \'multiverseId\': 473660}, \'multiverseid\': 473660}, {\'name\': "Oie d\'or", \'text\': "Vol\\nQuand l\'Oie d\'or arrive sur le champ de bataille, créez un jeton Nourriture. (C\'est un artefact avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)\\n{1}{G}, {T} : Créez un jeton Nourriture.\\n{T}, sacrifiez une nourriture : Ajoutez un mana de la couleur de votre choix.", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473929&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cf6ec3de-022b-4f93-b3c7-498953eba2a3\', \'multiverseId\': 473929}, \'multiverseid\': 473929}, {\'name\': "Oca d\'Oro", \'text\': \'Volare\\nQuando l\\\'Oca d\\\'Oro entra nel campo di battaglia, crea una pedina Cibo. (È un artefatto con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\\n{1}{G}, {T}: Crea una pedina Cibo.\\n{T}, Sacrifica un Cibo: Aggiungi un mana di un qualsiasi colore.\', \'type\': \'Creatura — Uccello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474198&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c065b460-9288-4bdb-9e54-2734840fc2de\', \'multiverseId\': 474198}, \'multiverseid\': 474198}, {\'name\': \'金のガチョウ\', \'text\': \'飛行\\n金のガチョウが戦場に出たとき、食物・トークンを１つ生成する。（それは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\\n{1}{G}, {T}：食物・トークンを１つ生成する。\\n{T}, 食物１つを生け贄に捧げる：好きな色１色のマナ１点を加える。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474467&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0e886a25-c37a-4537-b2c9-d1897af70e95\', \'multiverseId\': 474467}, \'multiverseid\': 474467}, {\'name\': \'금박 거위\', \'text\': \'비행\\n금박 거위가 전장에 들어올 때, 음식 토큰 한 개를 만든다. (음식 토큰은 "{2}, {T}, 이 마법물체를 희생한다: 당신은 생명 3점을 얻는다."를 가진 마법물체이다.)\\n{1}{G}, {T}: 음식 토큰 한 개를 만든다.\\n{T}, 음식 한 개를 희생한다: 원하는 색의 마나 한 개를 추가한다.\', \'type\': \'생물 — 조류\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474736&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'f7b4bb54-0196-42df-bc03-a61393120d8e\', \'multiverseId\': 474736}, \'multiverseid\': 474736}, {\'name\': \'Ganso Dourado\', \'text\': \'Voar\\nQuando Ganso Dourado entrar no campo de batalha, crie uma ficha de Comida. (Ela é um artefato com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida.")\\n{1}{G}, {T}: Crie uma ficha de Comida.\\n{T}, sacrifique uma Comida: Adicione um mana de qualquer cor.\', \'type\': \'Criatura — Ave\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475005&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24fe732a-550d-4239-a927-9c30e1c17584\', \'multiverseId\': 475005}, \'multiverseid\': 475005}, {\'name\': \'Золоченая Гусыня\', \'text\': \'Полет\\nКогда Золоченая Гусыня выходит на поле битвы, создайте одну фишку Еды. (Она является артефактом со способностью «{2}, {T}, пожертвуйте этот артефакт: вы получаете 3 жизни».)\\n{1}{G}, {T}: создайте одну фишку Еды.\\n{T}, пожертвуйте Еду: добавьте одну ману любого цвета.\', \'type\': \'Существо — Птица\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475274&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6648b815-27dd-4ca8-be73-96ba47309805\', \'multiverseId\': 475274}, \'multiverseid\': 475274}, {\'name\': \'金鹅\', \'text\': \'飞行\\n当金鹅进战场时，派出一个食品衍生物。（食品衍生物是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\\n{1}{G}，{T}：派出一个食品衍生物。\\n{T}，牺牲一个食品：加一点任意颜色的法术力。\', \'type\': \'生物 ～鸟\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475543&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a3e0b003-a13a-4b41-b4d7-6814b9fe008d\', \'multiverseId\': 475543}, \'multiverseid\': 475543}, {\'name\': \'金鵝\', \'text\': \'飛行\\n當金鵝進戰場時，派出一個食品衍生物。（食品衍生物是具有「{2}，{T}，犧牲此神器：你獲得3點生命」的神器。）\\n{1}{G}，{T}：派出一個食品衍生物。\\n{T}，犧牲一個食品：加一點任意顏色的魔法力。\', \'type\': \'生物 ～鳥\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475812&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'b6f93f9f-a353-4b43-b6f5-7062d4169839\', \'multiverseId\': 475812}, \'multiverseid\': 475812}]', '[{\'name\': \'Goldenes Ei\', \'text\': \'Wenn das Goldene Ei ins Spiel kommt, ziehe eine Karte.\\n{1}, {T}, opfere das Goldene Ei: Erzeuge ein Mana einer beliebigen Farbe.\\n{2}, {T}, opfere das Goldene Ei: Du erhältst 3 Lebenspunkte dazu.\', \'type\': \'Artefakt — Speise\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473451&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b6ac574-64c3-4d64-a7f9-c3642d1c469f\', \'multiverseId\': 473451}, \'multiverseid\': 473451}, {\'name\': \'Huevo dorado\', \'text\': \'Cuando el Huevo dorado entre al campo de batalla, roba una carta.\\n{1}, {T}, sacrificar el Huevo dorado: Agrega un maná de cualquier color.\\n{2}, {T}, sacrificar el Huevo dorado: Ganas 3 vidas.\', \'type\': \'Artefacto — Comida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473720&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'424fc51a-439f-45ef-8661-7673c1d0cfd5\', \'multiverseId\': 473720}, \'multiverseid\': 473720}, {\'name\': "Œuf d\'or", \'text\': "Quand l\'Œuf d\'or arrive sur le champ de bataille, piochez une carte.\\n{1}, {T}, sacrifiez l\'Œuf d\'or : Ajoutez un mana de la couleur de votre choix.\\n{2}, {T}, sacrifiez l\'Œuf d\'or : Vous gagnez 3 points de vie.", \'type\': \'Artefact : nourriture\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473989&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'272bd00b-03c2-4bbe-8bd1-a51d976e67b2\', \'multiverseId\': 473989}, \'multiverseid\': 473989}, {\'name\': "Uovo d\'Oro", \'text\': "Quando l\'Uovo d\'Oro entra nel campo di battaglia, pesca una carta.\\n{1}, {T}, Sacrifica l\'Uovo d\'Oro: Aggiungi un mana di un qualsiasi colore.\\n{2}, {T}, Sacrifica l\'Uovo d\'Oro: Guadagni 3 punti vita.", \'type\': \'Artefatto — Cibo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474258&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3675af22-2c69-4cac-9c4d-cc9d8d8ba047\', \'multiverseId\': 474258}, \'multiverseid\': 474258}, {\'name\': \'黄金の卵\', \'text\': \'黄金の卵が戦場に出たとき、カードを１枚引く。\\n{1}, {T}, 黄金の卵を生け贄に捧げる：好きな色１色のマナ１点を加える。\\n{2}, {T}, 黄金の卵を生け贄に捧げる：あなたは３点のライフを得る。\', \'type\': \'アーティファクト — 食物\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474527&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e76b4f3-226d-40bb-aa38-7051b95e0707\', \'multiverseId\': 474527}, \'multiverseid\': 474527}, {\'name\': \'황금 달걀\', \'text\': \'황금 달걀이 전장에 들어올 때, 카드 한 장을 뽑는다.\\n{1}, {T}, 황금 달걀을 희생한다: 원하는 색의 마나 한 개를 추가한다.\\n{2}, {T}, 황금 달걀을 희생한다: 당신은 생명 3점을 얻는다.\', \'type\': \'마법물체 — 음식\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474796&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'6c6f71df-1892-4258-b436-63063b0c406c\', \'multiverseId\': 474796}, \'multiverseid\': 474796}, {\'name\': \'Ovo de Ouro\', \'text\': \'Quando Ovo de Ouro entrar no campo de batalha, compre um card.\\n{1}, {T}, sacrifique Ovo de Ouro: Adicione um mana de qualquer cor.\\n{2}, {T}, sacrifique Ovo de Ouro: Você ganha 3 pontos de vida.\', \'type\': \'Artefato — Comida\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475065&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8d969e07-358a-4223-8736-16e1e4c5e3ac\', \'multiverseId\': 475065}, \'multiverseid\': 475065}, {\'name\': \'Золотое Яйцо\', \'text\': \'Когда Золотое Яйцо выходит на поле битвы, возьмите карту.\\n{1}, {T}, пожертвуйте Золотое Яйцо: добавьте одну ману любого цвета.\\n{2}, {T}, пожертвуйте Золотое Яйцо: вы получаете 3 жизни.\', \'type\': \'Артефакт — Еда\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475334&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99934ec0-6c75-4439-bd36-c7dad380c7cd\', \'multiverseId\': 475334}, \'multiverseid\': 475334}, {\'name\': \'金蛋\', \'text\': \'当金蛋进战场时，抓一张牌。\\n{1}，{T}，牺牲金蛋：加一点任意颜色的法术力。\\n{2}，{T}，牺牲金蛋：你获得3点生命。\', \'type\': \'神器 ～食品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475603&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aac34a2f-3c84-416e-aa49-281db53167a8\', \'multiverseId\': 475603}, \'multiverseid\': 475603}, {\'name\': \'金蛋\', \'text\': \'當金蛋進戰場時，抽一張牌。\\n{1}，{T}，犧牲金蛋：加一點任意顏色的魔法力。\\n{2}，{T}，犧牲金蛋：你獲得3點生命。\', \'type\': \'神器 ～食品\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475872&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'73301cf5-e974-49e1-9b07-ed84389f1d8f\', \'multiverseId\': 475872}, \'multiverseid\': 475872}]', '[{\'name\': \'Grabhügelhexen\', \'text\': \'Wenn die Grabhügelhexen ins Spiel kommen, bringe eine Ritter-Karte deiner Wahl aus deinem Friedhof auf deine Hand zurück.\', \'type\': \'Kreatur — Mensch, Hexenmeister\', \'flavor\': \'„Schmecke die Süße, Hauch für Hauch.\\nSorge für Ausgleich, wie der Tod auch."\\n—Beschwörungsformel der Grabhügelhexen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473308&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2d00485a-8b31-4a03-b54b-07f1e4a2fd33\', \'multiverseId\': 473308}, \'multiverseid\': 473308}, {\'name\': \'Brujas de los túmulos\', \'text\': \'Cuando las Brujas de los túmulos entren al campo de batalla, regresa la carta de Caballero objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Brujo humano\', \'flavor\': \'"Poción dulce, muerte solventa.\\nOjo por ojo, equilibrio sustenta".\\n—Sortilegio de las brujas de los túmulos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473577&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'16bda528-f3bd-4ed4-8fbc-8a241594cbeb\', \'multiverseId\': 473577}, \'multiverseid\': 473577}, {\'name\': \'Envoûteurs des tumulus\', \'text\': \'Quand les Envoûteurs des tumulus arrivent sur le champ de bataille, renvoyez une carte de chevalier ciblée depuis votre cimetière dans votre main.\', \'type\': \'Créature : humain et psychagogue\', \'flavor\': "« Goûtez la douceur, une inspiration après l\'autre.\\nMaintenez l\'équilibre, une mort après l\'autre. »\\n—Incantation de l\'Envoûteuse des tumulus", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473846&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'497d580e-9b70-4a25-bb30-f68ddffa9fb7\', \'multiverseId\': 473846}, \'multiverseid\': 473846}, {\'name\': \'Streghe dei Tumuli\', \'text\': \'Quando le Streghe dei Tumuli entrano nel campo di battaglia, riprendi in mano una carta Cavaliere bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Warlock Umano\', \'flavor\': \'"Respiro per respiro, la dolcezza va assaporata.\\nMorte per morte, l\\\'armonia va conservata."\\n—Incantesimo delle streghe dei tumuli\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474115&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a75381a6-350e-424b-b2bc-25e2db15f546\', \'multiverseId\': 474115}, \'multiverseid\': 474115}, {\'name\': \'墳丘の魔女\', \'text\': \'墳丘の魔女が戦場に出たとき、あなたの墓地から騎士・カード１枚を対象とし、それをあなたの手札に戻す。\', \'type\': \'クリーチャー — 人間・邪術師\', \'flavor\': \'「甘さを味わえ、息から息へ。\\n調和を保て、死から死へ。」\\n――墳丘の魔女の詠唱\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474384&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ff0cf47a-5cad-4718-b646-23f599497410\', \'multiverseId\': 474384}, \'multiverseid\': 474384}, {\'name\': \'고분 마녀\', \'text\': \'고분 마녀가 전장에 들어올 때, 당신의 무덤에 있는 기사 카드를 목표로 정한다. 그 카드를 당신의 손으로 되돌린다.\', \'type\': \'생물 — 인간 흑마법사\', \'flavor\': \'"달콤함을 맛보아라, 숨결에는 숨결을.\\n균형을 유지해라, 죽음에는 죽음을."\\n—고분 마녀 주문\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474653&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'cf7f4078-30ae-4ee8-9234-23d82d449711\', \'multiverseId\': 474653}, \'multiverseid\': 474653}, {\'name\': \'Bruxas da Mamoa\', \'text\': \'Quando Bruxas da Mamoa entrar no campo de batalha, devolva o card de Cavaleiro alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Humano Bruxo\', \'flavor\': \'"Prove a doçura, alento por alento.\\nMantenha o equilíbrio a cada passamento."\\n— Encantamento de bruxa da mamoa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474922&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac781b7d-36de-4583-888b-0af7df14a601\', \'multiverseId\': 474922}, \'multiverseid\': 474922}, {\'name\': \'Курганные Ведьмы\', \'text\': \'Когда Курганные Ведьмы выходят на поле битвы, верните целевую карту Рыцаря из вашего кладбища в вашу руку.\', \'type\': \'Существо — Человек Колдун\', \'flavor\': \'«Вздох за вздохом — сладкий страх,\\nСмерть за смертью на весах».\\n— заклинание курганных ведьм\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475191&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'99540985-fa31-4fc3-8ef9-2d860c0ca02b\', \'multiverseId\': 475191}, \'multiverseid\': 475191}, {\'name\': \'荒野巫婆\', \'text\': \'当荒野巫婆进战场时，将目标骑士牌从你的坟墓场移回你手上。\', \'type\': \'生物 ～人类／邪术师\', \'flavor\': \'「甜美气息，口口相继。\\n平衡生死，命命相抵。」\\n～荒野巫婆咒文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475460&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'08e15e67-403f-4339-830f-a3bbd5adcd0d\', \'multiverseId\': 475460}, \'multiverseid\': 475460}, {\'name\': \'荒野巫婆\', \'text\': \'當荒野巫婆進戰場時，將目標騎士牌從你的墳墓場移回你手上。\', \'type\': \'生物 ～人類／邪術師\', \'flavor\': \'「甜美氣息，口口相繼。\\n平衡生死，命命相抵。」\\n～荒野巫婆咒文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475729&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'2e4d0c23-87c5-49db-81e2-68517f3c78bb\', \'multiverseId\': 475729}, \'multiverseid\': 475729}]', '[{\'name\': \'Greif der Garnison\', \'text\': \'Fliegend\\nImmer wenn der Greif der Garnison angreift, erhält ein Ritter deiner Wahl, den du kontrollierst, Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Greif\', \'flavor\': \'Die scharfäugigen Wächter von Ardenthal sind stets wachsam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475933&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26c43940-bdcd-4b15-9a69-97eda4a24ef9\', \'multiverseId\': 475933}, \'multiverseid\': 475933}, {\'name\': \'Grifo del baluarte\', \'text\': \'Vuela.\\nSiempre que el Grifo del baluarte ataque, el Caballero objetivo que controlas gana la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Los guardianes de ojos perspicaces del Valle de Arden siempre están alerta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475943&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90190edf-b112-47dc-b152-d3ae9f4402a0\', \'multiverseId\': 475943}, \'multiverseid\': 475943}, {\'name\': \'Griffon de garnison\', \'text\': "Vol\\nÀ chaque fois que le Griffon de garnison attaque, un chevalier ciblé que vous contrôlez acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature : griffon\', \'flavor\': "Les gardiens d\'Ardenval ont des yeux d\'aigle et sont toujours aux aguets.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475953&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4164acf5-ccfc-42b5-838c-7f6472362f5b\', \'multiverseId\': 475953}, \'multiverseid\': 475953}, {\'name\': \'Grifone della Guarnigione\', \'text\': \'Volare\\nOgniqualvolta il Grifone della Guarnigione attacca, un Cavaliere bersaglio che controlli ha volare fino alla fine del turno.\', \'type\': \'Creatura — Grifone\', \'flavor\': "I guardiani di Ardenvalle, con la loro vista acuta, sono sempre all\'erta.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475963&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8b084120-619d-432b-a58b-71524796e0a3\', \'multiverseId\': 475963}, \'multiverseid\': 475963}, {\'name\': \'駐屯地のグリフィン\', \'text\': \'飛行\\n駐屯地のグリフィンが攻撃するたび、あなたがコントロールしている騎士１体を対象とする。ターン終了時まで、それは飛行を得る。\', \'type\': \'クリーチャー — グリフィン\', \'flavor\': \'アーデンベイルの鋭い目の見張りは、常に警戒を怠らない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475973&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'73bc76c9-dc31-4267-8a72-4e6c883f266c\', \'multiverseId\': 475973}, \'multiverseid\': 475973}, {\'name\': \'수비대 그리핀\', \'text\': \'비행\\n수비대 그리핀이 공격할 때마다, 당신이 조종하는 기사를 목표로 정한다. 그 기사는 턴종료까지 비행을 얻는다.\', \'type\': \'생물 — 그리핀\', \'flavor\': \'날카로운 눈썰미를 가진 아르덴베일의 수호자들은 항상 경계 중이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475983&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'c9429ef8-4fe9-4964-9a7d-9fe6fcad4b8c\', \'multiverseId\': 475983}, \'multiverseid\': 475983}, {\'name\': \'Grifo da Guarnição\', \'text\': \'Voar\\nToda vez que Grifo da Guarnição ataca, o Cavaleiro alvo que você controla ganha voar até o final do turno.\', \'type\': \'Criatura — Grifo\', \'flavor\': \'Os guardiões de olhos aguçados do Vale Arden estão sempre em alerta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475993&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'98673afd-7299-4b93-a13e-9fae0e69471d\', \'multiverseId\': 475993}, \'multiverseid\': 475993}, {\'name\': \'Гарнизонный Грифон\', \'text\': \'Полет\\nКаждый раз, когда Гарнизонный Грифон атакует, целевой Рыцарь под вашим контролем получает Полет до конца хода.\', \'type\': \'Существо — Грифон\', \'flavor\': \'Остроглазые стражи Арденвейла всегда начеку.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=476003&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5bcbd65a-e1c5-4e68-8273-6c357225ba7d\', \'multiverseId\': 476003}, \'multiverseid\': 476003}, {\'name\': \'卫戍狮鹫\', \'text\': \'飞行\\n每当卫戍狮鹫攻击时，目标由你操控的骑士获得飞行异能直到回合结束。\', \'type\': \'生物 ～狮鹫\', \'flavor\': \'雅登瓦目光锐利的守卫从不松懈防务。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=476013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3f6b3b41-ba81-4132-88a4-44afa5751660\', \'multiverseId\': 476013}, \'multiverseid\': 476013}, {\'name\': \'衛戍獅鷲\', \'text\': \'飛行\\n每當衛戍獅鷲攻擊時，目標由你操控的騎士獲得飛行異能直到回合結束。\', \'type\': \'生物 ～獅鷲\', \'flavor\': \'雅登瓦目光銳利的守衛從不鬆懈防務。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=476023&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'4a4c4b0b-8d59-44d5-8bff-1fc83b736516\', \'multiverseId\': 476023}, \'multiverseid\': 476023}]', '[{\'name\': \'Groß wie eine Bohnenranke\', \'text\': \'Verzaubert eine Kreatur\\nDie verzauberte Kreatur erhält +3/+3, hat Reichweite und ist zusätzlich zu ihren anderen Typen ein Riese.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Er begriff ein bisschen zu spät, dass er die magischen Bohnen *pflanzen* sollte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473409&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c538ee2e-4c47-473c-917b-16c803b9e0f5\', \'multiverseId\': 473409}, \'multiverseid\': 473409}, {\'name\': \'Crecer con habichuelas mágicas\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +3/+3, tiene la habilidad de alcance y es un Gigante además de sus otros tipos.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Se dio cuenta, un poco tarde, de que habría tenido que *plantar* las habichuelas mágicas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473678&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11d6cbce-2dfd-4de8-a108-8fd5ce7abf45\', \'multiverseId\': 473678}, \'multiverseid\': 473678}, {\'name\': \'Grand comme une tige de haricot\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +3/+3, a la portée et est un géant en plus de ses autres types.\', \'type\': \'Enchantement : aura\', \'flavor\': "Il comprit un peu tard qu\'il aurait dû *planter* les haricots magiques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473947&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e7cf2d4b-81a6-4215-910d-ea74eae7b272\', \'multiverseId\': 473947}, \'multiverseid\': 473947}, {\'name\': \'Alto come un Fagiolo\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +3/+3, ha raggiungere ed è un Gigante in aggiunta ai suoi altri tipi.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Capì un po\' troppo tardi che avrebbe dovuto *piantare* i fagioli magici.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474216&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e6651ee-e091-4abb-8b2e-0a32602c6ef8\', \'multiverseId\': 474216}, \'multiverseid\': 474216}, {\'name\': \'伸びゆく豆の木\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントしているクリーチャーは、＋３/＋３の修整を受け、到達を持ち、それの他のタイプに加えて巨人でもある。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'魔法の豆は*植える*ものなのだと、気づいたのが少し遅かった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474485&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'11061648-28a1-418f-91c0-0c9e57b0dbb1\', \'multiverseId\': 474485}, \'multiverseid\': 474485}, {\'name\': \'콩줄기만큼 큰\', \'text\': \'생물에게 부여\\n부여된 생물은 +3/+3을 받고 대공을 가지며, 자신의 다른 유형에 더불어 거인이다.\', \'type\': \'부여마법 — 마법진\', \'flavor\': \'그가 그 마법의 콩들을 *심었어야* 한다는 것을 깨달았을 때는 이미 늦어 있었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474754&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'d9c7be89-827c-4270-b8e8-2ecd2fb2a9be\', \'multiverseId\': 474754}, \'multiverseid\': 474754}, {\'name\': \'Alto como um Pé de Feijão\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +3/+3, tem alcance e é um Gigante além de seus outros tipos.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Ele percebeu tarde demais que deveria ter *plantado* os feijões mágicos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475023&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'389544ab-55b7-44b3-b8c2-408d5421246e\', \'multiverseId\': 475023}, \'multiverseid\': 475023}, {\'name\': \'Выше Бобового Ростка\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +3/+3, имеет Захват и является Гигантом в дополнение к своим другим типам.\', \'type\': \'Чары — Аура\', \'flavor\': \'Он слишком поздно сообразил, что волшебные бобы надо было *посадить*.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475292&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eae382b0-1fad-401e-bb95-8b4cb70279cd\', \'multiverseId\': 475292}, \'multiverseid\': 475292}, {\'name\': \'豆茎高耸\', \'text\': \'结附于生物\\n所结附的生物得+3/+3，具有延势异能，且额外具有巨人此类别。\', \'type\': \'结界 ～灵气\', \'flavor\': \'等到他反应过来魔豆该是拿来*种*的时候，已为时过晚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475561&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5fa325c4-b9a9-4925-be54-dcebbd7fc787\', \'multiverseId\': 475561}, \'multiverseid\': 475561}, {\'name\': \'豆莖高聳\', \'text\': \'結附於生物\\n所結附的生物得+3/+3，具有延勢異能，且額外具有巨人此類別。\', \'type\': \'結界 ～靈氣\', \'flavor\': \'等到他反應過來魔豆該是拿來*種*的時候，已為時過晚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475830&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'bcd4f93f-cab0-40f2-97bb-6fdf10d26fca\', \'multiverseId\': 475830}, \'multiverseid\': 475830}]', '[{\'name\': \'Grumgully der Großzügige\', \'text\': \'Jede andere Nicht-Mensch-Kreatur, die du kontrollierst, kommt mit einer zusätzlichen +1/+1-Marke ins Spiel.\', \'type\': \'Legendäre Kreatur — Goblin, Schamane\', \'flavor\': \'„Spielt es eine Rolle, was es ist? Nimm es und sei dankbar!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473423&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'357eadd5-a2a5-4ce7-8ac1-e3e0e3905dc4\', \'multiverseId\': 473423}, \'multiverseid\': 473423}, {\'name\': \'Grumgully, el Generoso\', \'text\': \'Cada otra criatura que no sea Humano que controlas entra al campo de batalla con un contador +1/+1 adicional sobre ella.\', \'type\': \'Criatura legendaria — Chamán trasgo\', \'flavor\': \'"¿Acaso importa lo que sean? ¡Llévatelos y da las gracias!".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473692&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58674b7d-7321-43f5-9d7e-7e907de31a9c\', \'multiverseId\': 473692}, \'multiverseid\': 473692}, {\'name\': \'Grumgully, le généreux\', \'text\': \'Chaque autre créature non-Humain que vous contrôlez arrive sur le champ de bataille avec un marqueur +1/+1 supplémentaire sur elle.\', \'type\': \'Créature légendaire : gobelin et shamane\', \'flavor\': "« Est-ce vraiment important de savoir ce que c\'est ? Prends-le et remercie-moi ! »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473961&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0b0e57b-8de0-49fb-a4a9-b43ae279ff01\', \'multiverseId\': 473961}, \'multiverseid\': 473961}, {\'name\': \'Grumgully, il Generoso\', \'text\': \'Ogni altra creatura non Umano che controlli entra nel campo di battaglia con un segnalino +1/+1 addizionale.\', \'type\': \'Creatura Leggendaria — Sciamano Goblin\', \'flavor\': \'"Ha importanza cosa sia? Prendilo e sii riconoscente."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474230&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e337ab98-32b8-4756-ab2c-8ed9877c36d3\', \'multiverseId\': 474230}, \'multiverseid\': 474230}, {\'name\': \'太っ腹、グラングリー\', \'text\': \'あなたがコントロールしていて人間でない他の各クリーチャーはそれぞれ＋１/＋１カウンターが追加で１個置かれた状態で戦場に出る。\', \'type\': \'伝説のクリーチャー — ゴブリン・シャーマン\', \'flavor\': \'「これが何かがそんなに大事か？食べればきっと感謝するぞ！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474499&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8fb5ea0d-e6d8-4f0b-9bf8-3a73bc9e645f\', \'multiverseId\': 474499}, \'multiverseid\': 474499}, {\'name\': \'관대한 자, 그럼걸리\', \'text\': \'당신이 조종하는 인간이 아닌 다른 생물은 +1/+1 카운터 한 개를 추가로 가지고 전장에 들어온다.\', \'type\': \'전설적 생물 — 고블린 주술사\', \'flavor\': \'"그게 뭔지가 중요해? 그냥 받고 고마워 해."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474768&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'48bc5756-a331-4ff6-9fa7-1b7a9c5290b7\', \'multiverseId\': 474768}, \'multiverseid\': 474768}, {\'name\': \'Grumgully, o Generoso\', \'text\': \'Cada outra criatura que você controla que não seja do tipo Humano entra no campo de batalha com um marcador +1/+1 adicional.\', \'type\': \'Criatura Lendária — Goblin Xamã\', \'flavor\': \'"E importa o que é isso? Pegue e agradeça!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475037&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4ebc969b-7d7c-4b4e-99e3-06008f681471\', \'multiverseId\': 475037}, \'multiverseid\': 475037}, {\'name\': \'Грумгулли, Великодушный\', \'text\': \'Каждое другое не являющееся Человеком существо под вашим контролем выходит на поле битвы с одним дополнительным жетоном +1/+1 на нем.\', \'type\': \'Легендарное Существо — Гоблин Шаман\', \'flavor\': \'«Какая разница, что это такое? Бери и скажи спасибо!»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475306&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e96a516-b17d-445f-8be5-9b823ab75230\', \'multiverseId\': 475306}, \'multiverseid\': 475306}, {\'name\': \'慷慨的咕加力\', \'text\': \'每个由你操控的其他非人类生物进战场时上面均额外有一个+1/+1指示物。\', \'type\': \'传奇生物 ～鬼怪／祭师\', \'flavor\': \'「别问东问西的，只管吃下去，谢谢我就对了！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475575&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'08aadcf3-7bda-4314-ac34-1cf743f7f295\', \'multiverseId\': 475575}, \'multiverseid\': 475575}, {\'name\': \'慷慨的咕加力\', \'text\': \'每個由你操控的其他非人類生物進戰場時上面均額外有一個+1/+1指示物。\', \'type\': \'傳奇生物 ～鬼怪／祭師\', \'flavor\': \'「別問東問西的，只管吃下去，謝謝我就對了！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475844&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'f0a86b18-8d19-4b87-8358-434222a5f438\', \'multiverseId\': 475844}, \'multiverseid\': 475844}]', '[{\'name\': \'Harmonischer Archon\', \'text\': \'Fliegend\\nNicht-Archon-Kreaturen haben Basis-Stärke und -Widerstandskraft 3/3.\\nWenn der Harmonische Archon ins Spiel kommt, erzeuge zwei 1/1 weiße Mensch-Kreaturenspielsteine.\', \'type\': \'Kreatur — Archon\', \'flavor\': \'Erster unter Gleichen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473248&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4070d4cd-2255-4bbd-906a-602daccc0327\', \'multiverseId\': 473248}, \'multiverseid\': 473248}, {\'name\': \'Arconte armonioso\', \'text\': \'Vuela.\\nLas criaturas que no sean Arconte tienen una fuerza y resistencia base de 3/3.\\nCuando el Arconte armonioso entre al campo de batalla, crea dos fichas de criatura Humano blancas 1/1.\', \'type\': \'Criatura — Arconte\', \'flavor\': \'El primero entre los iguales.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473517&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d45f0ce3-3b85-494f-b42d-2ce34887d376\', \'multiverseId\': 473517}, \'multiverseid\': 473517}, {\'name\': \'Archonte harmonieux\', \'text\': "Vol\\nLes créatures non-Archonte ont une force et une endurance de base de 3/3.\\nQuand l\'Archonte harmonieux arrive sur le champ de bataille, créez deux jetons de créature 1/1 blanche Humain.", \'type\': \'Créature : archonte\', \'flavor\': \'Premier parmi ses pairs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473786&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fc6009f-78fe-413a-ae4c-9914a6697c7e\', \'multiverseId\': 473786}, \'multiverseid\': 473786}, {\'name\': \'Arconte Armonioso\', \'text\': "Volare\\nLe creature non Arconte hanno forza e costituzione base 3/3.\\nQuando l\'Arconte Armonioso entra nel campo di battaglia, crea due pedine creatura Umano 1/1 bianche.", \'type\': \'Creatura — Arconte\', \'flavor\': \'Primo tra i suoi pari.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474055&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'743e3437-b6ba-4a7d-9abd-3b89cc817d16\', \'multiverseId\': 474055}, \'multiverseid\': 474055}, {\'name\': \'調和のアルコン\', \'text\': \'飛行\\n執政官でないクリーチャーは基本のパワーとタフネスが３/３になる。\\n調和のアルコンが戦場に出たとき、白の１/１の人間・クリーチャー・トークンを２体生成する。\', \'type\': \'クリーチャー — 執政官\', \'flavor\': \'全ての上に立つもの。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474324&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'635ff1f3-6e31-4238-912a-5e388b48ebb8\', \'multiverseId\': 474324}, \'multiverseid\': 474324}, {\'name\': \'조화로운 집정관\', \'text\': \'비행\\n집정관이 아닌 생물들은 기본 공격력과 방어력이 3/3이 된다.\\n조화로운 집정관이 전장에 들어올 때, 1/1 백색 인간 생물 토큰 두 개를 만든다.\', \'type\': \'생물 — 집정관\', \'flavor\': \'동등한 자들 중 최고이다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474593&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'3032f6e1-f39b-4ac1-95b6-347eaad72ffc\', \'multiverseId\': 474593}, \'multiverseid\': 474593}, {\'name\': \'Arconte Harmonioso\', \'text\': \'Voar\\nAs criaturas que não sejam do tipo Arconte têm poder e resistência básicos 3/3.\\nQuando Arconte Harmonioso entrar no campo de batalha, crie duas fichas de criatura branca 1/1 do tipo Humano.\', \'type\': \'Criatura — Arconte\', \'flavor\': \'O primeiro entre iguais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474862&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'681b6aee-d889-4c40-a953-a2de6385a746\', \'multiverseId\': 474862}, \'multiverseid\': 474862}, {\'name\': \'Архонт Гармонии\', \'text\': \'Полет\\nНе являющиеся Архонтами существа имеют базовые силу и выносливость 3/3.\\nКогда Архонт Гармонии выходит на поле битвы, создайте две фишки существа 1/1 белый Человек.\', \'type\': \'Существо — Архонт\', \'flavor\': \'Первый среди равных.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475131&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8216e657-f299-45a7-b74c-81283386aaed\', \'multiverseId\': 475131}, \'multiverseid\': 475131}, {\'name\': \'谐和统领\', \'text\': \'飞行\\n非统领生物的基础力量与防御力为3/3。\\n当谐和统领进战场时，派出两个1/1白色人类衍生生物。\', \'type\': \'生物 ～统领\', \'flavor\': \'众生之首。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475400&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c537e22f-c1bf-47ad-91be-0aa09fc894d3\', \'multiverseId\': 475400}, \'multiverseid\': 475400}, {\'name\': \'諧和統領\', \'text\': \'飛行\\n非統領生物的基礎力量與防禦力為3/3。\\n當諧和統領進戰場時，派出兩個1/1白色人類衍生生物。\', \'type\': \'生物 ～統領\', \'flavor\': \'眾生之首。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475669&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'05930dec-539c-49a2-bb9b-bbaed73f80c1\', \'multiverseId\': 475669}, \'multiverseid\': 475669}]', '[{\'name\': \'Heimtückischer Adliger\', \'text\': \'{2}, opfere ein Artefakt oder eine andere Kreatur: Lege eine +1/+1-Marke auf den Heimtückischen Adligen.\', \'type\': \'Kreatur — Mensch, Adliger\', \'flavor\': \'Er hat ein Dutzend Hexen getötet, wobei er jede mit dem Versprechen frischer Kinderknochen anlockte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473326&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99d846d3-ce53-4cbc-b907-9938f4d66b5a\', \'multiverseId\': 473326}, \'multiverseid\': 473326}, {\'name\': \'Noble malévolo\', \'text\': \'{2}, sacrificar un artefacto u otra criatura: Pon un contador +1/+1 sobre el Noble malévolo.\', \'type\': \'Criatura — Noble humano\', \'flavor\': \'Ha matado a muchas brujas después de atraer a cada una con la promesa de huesos frescos de niño.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473595&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'97dafd51-f05b-46da-a6bb-648179735352\', \'multiverseId\': 473595}, \'multiverseid\': 473595}, {\'name\': \'Noble maléfique\', \'text\': \'{2}, sacrifiez un artefact ou une autre créature : Mettez un marqueur +1/+1 sur le Noble maléfique.\', \'type\': \'Créature : humain et noble\', \'flavor\': "Il a occis une douzaine d\'envoûteuses, en les attirant avec la promesse d\'os d\'enfants frais.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473864&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c8e5a9c8-fda1-48ee-9f00-b6c6d6094fab\', \'multiverseId\': 473864}, \'multiverseid\': 473864}, {\'name\': \'Nobile Malevolo\', \'text\': "{2}, Sacrifica un artefatto o un\'altra creatura: Metti un segnalino +1/+1 sul Nobile Malevolo.", \'type\': \'Creatura — Nobile Umano\', \'flavor\': \'Ha ucciso una decina di streghe, attirando ognuna con la promessa di ossa fresche di bambini.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474133&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5d13d0d-01d2-4cac-9632-527db06a55f1\', \'multiverseId\': 474133}, \'multiverseid\': 474133}, {\'name\': \'邪悪な貴族\', \'text\': \'{2}, アーティファクト１つか他のクリーチャー１体を生け贄に捧げる：邪悪な貴族の上に＋１/＋１カウンターを１個置く。\', \'type\': \'クリーチャー — 人間・貴族\', \'flavor\': \'彼は何人もの魔女を殺してきた。新鮮な子どもの骨を渡すという約束を餌にして。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474402&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bb7b9ce7-0823-4592-b662-1077da5df0e2\', \'multiverseId\': 474402}, \'multiverseid\': 474402}, {\'name\': \'악의적인 귀족\', \'text\': \'{2}, 마법물체 또는 다른 생물을 희생한다: 악의적인 귀족에 +1/+1 카운터 한 개를 올려놓는다.\', \'type\': \'생물 — 인간 귀족\', \'flavor\': \'그는 아이들의 신선한 뼈를 주겠다고 약속하며 마녀들을 꾀어내, 수많은 마녀를 죽였다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474671&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'a62eddc3-3383-4a33-bde4-33d06a66b653\', \'multiverseId\': 474671}, \'multiverseid\': 474671}, {\'name\': \'Nobre Malévolo\', \'text\': \'{2}, sacrifique um artefato ou outra criatura: Coloque um marcador +1/+1 em Nobre Malévolo.\', \'type\': \'Criatura — Humano Nobre\', \'flavor\': \'Ele já matou uma dúzia de bruxas, atraindo cada uma com promessas de ossos frescos de criança.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474940&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3aca3c19-f594-41bf-b196-184a8ea66a0a\', \'multiverseId\': 474940}, \'multiverseid\': 474940}, {\'name\': \'Злонравный Вельможа\', \'text\': \'{2}, пожертвуйте артефакт или другое существо: положите один жетон +1/+1 на Злонравного Вельможу.\', \'type\': \'Существо — Человек Аристократ\', \'flavor\': \'Он прикончил дюжину ведьм, завлекая каждую из них свежими детскими костями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475209&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24d8daba-836f-48c6-842a-018f77bcde86\', \'multiverseId\': 475209}, \'multiverseid\': 475209}, {\'name\': \'恶毒贵族\', \'text\': \'{2}，牺牲一个神器或另一个生物：在恶毒贵族上放置一个+1/+1指示物。\', \'type\': \'生物 ～人类／贵族\', \'flavor\': \'他以新鲜孩童尸骨作饵，藉此猎杀巫婆达十数人之众。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475478&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ac5804ab-2b01-426a-858d-15cfb98f9330\', \'multiverseId\': 475478}, \'multiverseid\': 475478}, {\'name\': \'惡毒貴族\', \'text\': \'{2}，犧牲一個神器或另一個生物：在惡毒貴族上放置一個+1/+1指示物。\', \'type\': \'生物 ～人類／貴族\', \'flavor\': \'他以新鮮孩童屍骨作餌，藉此獵殺巫婆達十數人之眾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475747&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'9a75a6ae-672e-444e-9cf1-f273b8c5fbdb\', \'multiverseId\': 475747}, \'multiverseid\': 475747}]', '[{\'name\': \'Hereinplatzen\', \'text\': \'Eine angreifende Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges. Angreifende Nicht-Mensch-Kreaturen verursachen Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Riese hatte zwar von Schlössern gehört, aber noch keine Tür gefunden, die er nicht öffnen konnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473343&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cac9ddf9-4502-40b9-b28c-1bbfb7f34da5\', \'multiverseId\': 473343}, \'multiverseid\': 473343}, {\'name\': \'Entrar por la cara\', \'text\': \'La criatura atacante objetivo obtiene +2/+2 hasta el final del turno. Cada criatura atacante que no sea Humano gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'El gigante había oído hablar de las cerraduras, pero aún no se había topado con una puerta que no pudiera abrir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473612&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4a9897f-f414-4e2a-b930-23b7c2ae16c3\', \'multiverseId\': 473612}, \'multiverseid\': 473612}, {\'name\': \'Faire irruption\', \'text\': "La créature attaquante ciblée gagne +2/+2 jusqu\'à la fin du tour. Chaque créature non-Humain attaquante acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Le géant avait entendu parler des serrures, mais il n\'avait jamais été confronté à une porte qu\'il ne pouvait pas ouvrir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473881&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b15f7654-252e-4d79-948f-bacdd524aad4\', \'multiverseId\': 473881}, \'multiverseid\': 473881}, {\'name\': \'Prorompere\', \'text\': \'Una creatura attaccante bersaglio prende +2/+2 fino alla fine del turno. Ogni creatura non Umano attaccante ha travolgere fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Il gigante aveva sentito parlare di serrature, ma non aveva ancora trovato una porta che non fosse in grado di aprire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474150&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f37c709-01fc-4091-8a73-cb1c79cc5e15\', \'multiverseId\': 474150}, \'multiverseid\': 474150}, {\'name\': \'突き破り\', \'text\': \'攻撃クリーチャー１体を対象とする。ターン終了時まで、それは＋２/＋２の修整を受ける。ターン終了時まで、人間でない各攻撃クリーチャーはそれぞれトランプルを得る。\', \'type\': \'インスタント\', \'flavor\': \'巨人はこれまで鍵のかかる音を何度も聞いてきたが、自分に開けられない扉には出会ったことがなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474419&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d0998594-e3fa-40ae-8f94-548bd3cc451f\', \'multiverseId\': 474419}, \'multiverseid\': 474419}, {\'name\': \'불쑥 끼어들기\', \'text\': \'공격 중인 생물을 목표로 정한다. 그 생물은 턴종료까지 +2/+2를 받는다. 인간이 아닌 공격 중인 각 생물은 턴종료까지 돌진을 얻는다.\', \'type\': \'순간마법\', \'flavor\': \'거인은 자물쇠란 것에 대해 들어 보긴 했지만, 지금까지는 열지 못했던 문을 찾아볼 수 없었다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474688&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'618ec968-9008-4e5a-8b2b-bf79c7f35486\', \'multiverseId\': 474688}, \'multiverseid\': 474688}, {\'name\': \'Forçar a Entrada\', \'text\': \'A criatura atacante alvo recebe +2/+2 até o final do turno. Cada criatura atacante que não seja do tipo Humano ganha atropelar até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O gigante já tinha ouvido falar de fechaduras, mas ainda não havia encontrado uma porta que ele não conseguisse abrir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474957&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4454f527-791e-45f3-b25d-179601b5d007\', \'multiverseId\': 474957}, \'multiverseid\': 474957}, {\'name\': \'Вломиться\', \'text\': \'Целевое атакующее существо получает +2/+2 до конца хода. Каждое атакующее не являющееся Человеком существо получает Пробивной удар до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Великан слышал о замках, но еще не встречал двери, которую не мог бы открыть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475226&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0297121c-be2c-4884-baac-4f0562ce3257\', \'multiverseId\': 475226}, \'multiverseid\': 475226}, {\'name\': \'鲁莽闯入\', \'text\': \'目标进行攻击的生物得+2/+2直到回合结束。每个进行攻击的非人类生物均获得践踏异能直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'虽然这巨人知道有种东西叫做锁，但他到现在还没遇到过打不开的门。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475495&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'99f161d6-c79b-4b96-b411-1ce13a84d927\', \'multiverseId\': 475495}, \'multiverseid\': 475495}, {\'name\': \'魯莽闖入\', \'text\': \'目標進行攻擊的生物得+2/+2直到回合結束。每個進行攻擊的非人類生物均獲得踐踏異能直到回合結束。\', \'type\': \'瞬間\', \'flavor\': \'雖然這巨人知道有種東西叫做鎖，但他到現在還沒遇到過打不開的門。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475764&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'c2b75065-59c0-4934-ae64-2415107584b6\', \'multiverseId\': 475764}, \'multiverseid\': 475764}]', '[{\'name\': \'Hexenhaus\', \'text\': \'({T}: Erzeuge {B}.)\\nDas Hexenhaus kommt getappt ins Spiel, es sei denn, du kontrollierst drei oder mehr andere Sümpfe.\\nWenn das Hexenhaus ungetappt ins Spiel kommt, kannst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof oben auf deine Bibliothek legen.\', \'type\': \'Land — Sumpf\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473480&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4a928bd2-2091-40d6-8b6e-9b2f9254c9ca\', \'multiverseId\': 473480}, \'multiverseid\': 473480}, {\'name\': \'Cabaña de la bruja\', \'text\': \'({T}: Agrega {B}.)\\nLa Cabaña de la bruja entra al campo de batalla girada a menos que controles otros tres o más Pantanos.\\nCuando la Cabaña de la bruja entre al campo de batalla enderezada, puedes poner la carta de criatura objetivo de tu cementerio en la parte superior de tu biblioteca.\', \'type\': \'Tierra — Pantano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473749&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6950c1f7-a3eb-47d1-b519-e40ce217d86c\', \'multiverseId\': 473749}, \'multiverseid\': 473749}, {\'name\': "Maison de l\'envoûteuse", \'text\': "({T} : Ajoutez {B}.)\\nLa Maison de l\'envoûteuse arrive sur le champ de bataille engagée à moins que vous ne contrôliez au moins trois autres marais.\\nQuand la Maison de l\'envoûteuse arrive sur le champ de bataille dégagée, vous pouvez mettre une carte de créature ciblée depuis votre cimetière au-dessus de votre bibliothèque.", \'type\': \'Terrain : marais\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474018&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'14e3d87d-2cca-40c2-9696-b825e77ff5d9\', \'multiverseId\': 474018}, \'multiverseid\': 474018}, {\'name\': \'Capanna della Strega\', \'text\': \'({T}: Aggiungi {B}.)\\nLa Capanna della Strega entra nel campo di battaglia TAPpata a meno che tu non controlli tre o più altre Paludi.\\nQuando la Capanna della Strega entra nel campo di battaglia STAPpata, puoi mettere una carta creatura bersaglio dal tuo cimitero in cima al tuo grimorio.\', \'type\': \'Terra — Palude\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474287&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86a397b6-67c3-4228-8d69-df6eee847105\', \'multiverseId\': 474287}, \'multiverseid\': 474287}, {\'name\': \'魔女の小屋\', \'text\': \'（{T}：{B}を加える。）\\nあなたが他の沼を３つ以上コントロールしているのでないかぎり、魔女の小屋はタップ状態で戦場に出る。\\n魔女の小屋がアンタップ状態で戦場に出たとき、あなたの墓地からクリーチャー・カード１枚を対象とする。あなたはそれをあなたのライブラリーの一番上に置いてもよい。\', \'type\': \'土地 — 沼\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474556&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b04112be-615d-4667-a619-26623674c49a\', \'multiverseId\': 474556}, \'multiverseid\': 474556}, {\'name\': \'마녀의 오두막집\', \'text\': \'({T}: {B}를 추가한다.)\\n당신이 다른 늪을 세 개 이상 조종하지 않는 한 마녀의 오두막집은 탭된 채로 전장에 들어온다.\\n마녀의 오두막집이 언탭되어 전장에 들어올 때, 당신의 무덤에 있는 생물 카드를 목표로 정한다. 당신은 그 카드를 당신의 서고 맨 위에 놓을 수 있다.\', \'type\': \'대지 — 늪\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474825&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'e793e8a5-8657-4af3-8150-f69b8968d255\', \'multiverseId\': 474825}, \'multiverseid\': 474825}, {\'name\': \'Casebre da Bruxa\', \'text\': \'({T}: Adicione {B}.)\\nCasebre da Bruxa entra no campo de batalha virado, a menos que você controle três ou mais outros Pântanos.\\nQuando Casebre da Bruxa entra no campo de batalha desvirado, você pode colocar o card de criatura alvo de seu cemitério no topo de seu grimório.\', \'type\': \'Terreno — Pântano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475094&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7198c27e-7fc5-48df-905d-902c40904afa\', \'multiverseId\': 475094}, \'multiverseid\': 475094}, {\'name\': \'Ведьмина Избушка\', \'text\': \'({T}: добавьте {B}.)\\nВедьмина Избушка выходит на поле битвы повернутой, если под вашим контролем менее трех других Болот.\\nКогда Ведьмина Избушка выходит на поле битвы развернутой, вы можете положить целевую карту существа из вашего кладбища на верх вашей библиотеки.\', \'type\': \'Земля — Болото\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475363&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'65391d87-a8ca-49a0-836d-494d08a20acf\', \'multiverseId\': 475363}, \'multiverseid\': 475363}, {\'name\': \'巫婆小屋\', \'text\': \'（{T}：加{B}。）\\n除非你操控三个或更多其他沼泽，否则巫婆小屋须横置进战场。\\n当巫婆小屋进战场且未横置时，你可以将目标生物牌从你的坟墓场置于你的牌库顶。\', \'type\': \'地 ～沼泽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475632&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2390fef3-d2e9-40fa-86a6-d81ddc1d7c44\', \'multiverseId\': 475632}, \'multiverseid\': 475632}, {\'name\': \'巫婆小屋\', \'text\': \'（{T}：加{B}。）\\n除非你操控三個或更多其他沼澤，否則巫婆小屋須橫置進戰場。\\n當巫婆小屋進戰場且未橫置時，你可以將目標生物牌從你的墳墓場置於你的牌庫頂。\', \'type\': \'地 ～沼澤\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475901&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'6fdb44b3-9a5d-43ab-b5af-55204efa324c\', \'multiverseId\': 475901}, \'multiverseid\': 475901}]', '[{\'name\': \'Hexenofen\', \'text\': \'{T}, opfere eine Kreatur: Erzeuge einen Speise-Spielstein. Falls die Widerstandskraft der geopferten Kreatur 4 oder mehr war, erzeuge stattdessen zwei Speise-Spielsteine. (Sie sind Artefakte mit „{2}, {T}, opfere dieses Artefakt: Du erhältst 3 Lebenspunkte dazu.")\', \'type\': \'Artefakt\', \'flavor\': \'Die wabernden Düfte sind ebenso appetitanregend wie verdächtig.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473468&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af346a95-57ac-457f-8398-cacfdc580c81\', \'multiverseId\': 473468}, \'multiverseid\': 473468}, {\'name\': \'Horno de la bruja\', \'text\': \'{T}, sacrificar una criatura: Crea una ficha de Comida. Si la resistencia de la criatura sacrificada era de 4 o más, en vez de eso, crea dos fichas de Comida. (Son artefactos con "{2}, {T}, sacrificar este artefacto: Ganas 3 vidas".)\', \'type\': \'Artefacto\', \'flavor\': \'Los olores que trae el viento son tan deliciosos como sospechosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473737&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b98f89f6-9f51-4267-9a6d-fda8543c78a4\', \'multiverseId\': 473737}, \'multiverseid\': 473737}, {\'name\': "Four de l\'envoûteuse", \'text\': "{T}, sacrifiez une créature : Créez un jeton Nourriture. Si l\'endurance de la créature sacrifiée était supérieure ou égale à 4, créez deux jetons Nourriture à la place. (Ce sont des artefacts avec « {2}, {T}, sacrifiez cet artefact : Vous gagnez 3 points de vie. »)", \'type\': \'Artefact\', \'flavor\': "Des odeurs à la fois délicieuses et suspicieuses flottent dans l\'air.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474006&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee981917-4187-4861-947f-835e45f8b86a\', \'multiverseId\': 474006}, \'multiverseid\': 474006}, {\'name\': \'Forno della Strega\', \'text\': \'{T}, Sacrifica una creatura: Crea una pedina Cibo. Se la costituzione della creatura sacrificata era pari o superiore a 4, crea invece due pedine Cibo. (Sono artefatti con "{2}, {T}, Sacrifica questo artefatto: Guadagni 3 punti vita".)\', \'type\': \'Artefatto\', \'flavor\': \'I profumi che si diffondono sono al contempo deliziosi e sospetti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474275&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5c956da6-4681-4665-af71-431d54244a64\', \'multiverseId\': 474275}, \'multiverseid\': 474275}, {\'name\': \'魔女のかまど\', \'text\': \'{T}, クリーチャー１体を生け贄に捧げる：食物・トークンを１つ生成する。その生け贄に捧げたクリーチャーのタフネスが４以上であったなら、代わりに食物・トークンを２つ生成する。（それらは、「{2}, {T}, このアーティファクトを生け贄に捧げる：あなたは３点のライフを得る。」を持つアーティファクトである。）\', \'type\': \'アーティファクト\', \'flavor\': \'漂ってくる香りは、おいしそうでもあり、怪しげでもあった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474544&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'005fabb4-19d3-453e-b872-8032369d35c7\', \'multiverseId\': 474544}, \'multiverseid\': 474544}, {\'name\': \'마녀의 오븐\', \'text\': \'{T}, 생물 한 개를 희생한다: 음식 토큰 한 개를 만든다. 희생된 생물의 방어력이 4 이상이라면, 대신 음식 토큰 두 개를 만든다. (그 토큰들은 "{2}, {T}, 이 마법물체를 희생한다: 당신은 생명 3점을 얻는다."를 가진 마법물체들이다.)\', \'type\': \'마법물체\', \'flavor\': \'그것에서 흘러나오는 냄새는 고약하고 의심스럽다.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474813&type=card\', \'language\': \'Korean\', \'identifiers\': {\'scryfallId\': \'b9d1e4d0-d434-48aa-a6b4-644d09d282dd\', \'multiverseId\': 474813}, \'multiverseid\': 474813}, {\'name\': \'Forno da Bruxa\', \'text\': \'{T}, sacrifique uma criatura: Crie uma ficha de Comida. Se a resistência da criatura sacrificada era igual ou superior a 4, em vez disso, crie duas fichas de Comida. (Elas são artefatos com "{2}, {T}, sacrifique este artefato: Você ganha 3 pontos de vida.")\', \'type\': \'Artefato\', \'flavor\': \'Os aromas são, ao mesmo tempo, saborosos e suspeitos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475082&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a7a7027-b680-46d0-94e1-d48de10bd979\', \'multiverseId\': 475082}, \'multiverseid\': 475082}, {\'name\': \'Ведьмина Печь\', \'text\': \'{T}, пожертвуйте существо: создайте одну фишку Еды. Если выносливость пожертвованного существа была равна 4 или больше, вместо этого создайте две фишки Еды. (Они являются артефактами со способностью «{2}, {T}, пожертвуйте этот артефакт: вы получаете 3 жизни».)\', \'type\': \'Артефакт\', \'flavor\': \'От исходящих из печи запахов текли слюнки и бежали мурашки по коже.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475351&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bbeea6fc-0c5e-423c-b71c-adfcb34d1258\', \'multiverseId\': 475351}, \'multiverseid\': 475351}, {\'name\': \'巫婆炉灶\', \'text\': \'{T}，牺牲一个生物：派出一个食品衍生物。如果所牺牲的生物之防御力等于或大于4，则改为派出两个食品衍生物。（食品衍生物是具有「{2}，{T}，牺牲此神器：你获得3点生命」的神器。）\', \'type\': \'神器\', \'flavor\': \'飘来的香味既馋人又可疑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475620&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'768a0656-1e21-4b9a-b0b8-c9515ae3fcf0\', \'multiverseId\': 475620}, \'multiverseid\': 475620}, {\'name\': \'巫婆爐灶\', \'text\': \'{T}，犧牲一個生物：派出一個食品衍生物。如果所犧牲的生物之防禦力等於或大於4，則改為派出兩個食品衍生物。（食品衍生物是具有「{2}，{T}，犧牲此神器：你獲得3點生命」的神器。）\', \'type\': \'神器\', \'flavor\': \'飄來的香味既饞人又可疑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475889&type=card\', \'language\': \'Chinese Traditional\', \'identifiers\': {\'scryfallId\': \'af91cbad-2b04-45e3-a75c-fefb9444f98c\', \'multiverseId\': 475889}, \'multiverseid\': 475889}]', "[{'name': 'Hypnotisierende Sylphide // Blendender Glanz', 'text': 'Fliegend', 'type': 'Kreatur — Feenwesen', 'flavor': None, 'faceName': 'Hypnotisierende Sylphide', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473280&type=card', 'language': 'German', 'identifiers': {'scryfallId': '25f87e89-bb09-4eee-921a-44171d147eef', 'multiverseId': 473280}, 'multiverseid': 473280}, {'name': 'Hada hipnótica // Brillo fascinante', 'text': 'Vuela.', 'type': 'Criatura — Hada', 'flavor': None, 'faceName': 'Hada hipnótica', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473549&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '13f17619-27d5-42e3-9765-2e3285b2a8d2', 'multiverseId': 473549}, 'multiverseid': 473549}, {'name': 'Farfadet hypnotique // Regard mesmérique', 'text': 'Vol', 'type': 'Créature : peuple fée', 'flavor': None, 'faceName': 'Farfadet hypnotique', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=473818&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e684a984-f6b0-4007-89ca-d17a1e3e1155', 'multiverseId': 473818}, 'multiverseid': 473818}, {'name': 'Folletto Ipnotico // Bagliore Ammaliante', 'text': 'Volare', 'type': 'Creatura — Spiritello', 'flavor': None, 'faceName': 'Folletto Ipnotico', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474087&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1ab377cd-b9ca-4180-9ad1-9cc8df32f5d9', 'multiverseId': 474087}, 'multiverseid': 474087}, {'name': '惑乱スプライト // 催眠の輝き', 'text': '飛行', 'type': 'クリーチャー — フェアリー', 'flavor': None, 'faceName': '惑乱スプライト', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474356&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '086203a2-8e6c-480a-84c9-b5ccc6213f4d', 'multiverseId': 474356}, 'multiverseid': 474356}, {'name': '최면 요정 // 넋이 나가는 눈빛', 'text': '비행', 'type': '생물 — 페어리', 'flavor': None, 'faceName': '최면 요정', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474625&type=card', 'language': 'Korean', 'identifiers': {'scryfallId': '74cb6d08-a0d1-4064-b7b6-b67f1333e4ae', 'multiverseId': 474625}, 'multiverseid': 474625}, {'name': 'Sílfide Hipnótica // Fulgor Mesmerizante', 'text': 'Voar', 'type': 'Criatura — Fada', 'flavor': None, 'faceName': 'Sílfide Hipnótica', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=474894&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c1c8a250-ab3d-4914-8796-d2c339d54f1d', 'multiverseId': 474894}, 'multiverseid': 474894}, {'name': 'Пикси-Гипнотизер // Дурманящий Взор', 'text': 'Полет', 'type': 'Существо — Фея', 'flavor': None, 'faceName': 'Пикси-Гипнотизер', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475163&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd700a9b4-357f-4bc6-889a-76dc71ea4b59', 'multiverseId': 475163}, 'multiverseid': 475163}, {'name': '催眠仙子 // 失神逼视', 'text': '飞行', 'type': '生物 ～仙灵', 'flavor': None, 'faceName': '催眠仙子', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475432&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a616b49c-898a-495d-84cf-5ae5cf89d964', 'multiverseId': 475432}, 'multiverseid': 475432}, {'name': '催眠仙子 // 失神逼視', 'text': '飛行', 'type': '生物 ～仙靈', 'flavor': None, 'faceName': '催眠仙子', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=475701&type=card', 'language': 'Chinese Traditional', 'identifiers': {'scryfallId': 'aed153f9-7ed4-45c0-ab46-b67bf46aa80d', 'multiverseId': 475701}, 'multiverseid': 475701}]", '[{\'name\': \'Händler des Tals // Feilschen\', \'text\': \'{2}{R}, wirf eine Karte ab: Ziehe eine Karte.\', \'type\': \'Kreatur — Mensch, Gesinde\', \'flavor\': \'„Ich kaufe alten, abgenutzten Schrott und verkaufe wahrlich wertvolle Wunder."\', \'faceName\': \