type: ['Artifact', 'Artifact Creature — Beast', 'Artifact Creature — Construct', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Bat', 'Creature — Bear', 'Creature — Bird', 'Creature — Boar', 'Creature — Elephant', 'Creature — Elf', 'Creature — Elf Archer', 'Creature — Faerie', 'Creature — Giant', 'Creature — Goblin', 'Creature — Human Monk', 'Creature — Human Wizard', 'Creature — Imp', 'Creature — Merfolk', 'Creature — Orc', 'Creature — Orc Warrior', 'Creature — Pegasus', 'Creature — Skeleton Wall', 'Creature — Spirit Minion', 'Creature — Unicorn', 'Creature — Wraith', 'Creature — Zombie', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Sorcery']
