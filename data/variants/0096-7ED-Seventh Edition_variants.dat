048-44f8-856e-121d8ac49fd0'}, 'multiverseid': None}]", '[{\'name\': \'Ehrengarde\', \'text\': \'{W}: Die Ehrengarde erhält +0/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Die Stärke von einem, den Mut von zehn.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182661&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7bbe7706-cf61-44c7-9790-d9c5678dcba6\', \'multiverseId\': 182661}, \'multiverseid\': 182661}, {\'name\': \'Guardia de honor\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7bf2caba-ff7a-43fc-811d-987be6ccffab\'}, \'multiverseid\': None}, {\'name\': "Garde d\'honneur", \'text\': "{W}: La Garde d\'honneur gagne +0/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : soldat\', \'flavor\': "La force d\'un seul. Le courage de dix.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184077&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8e43cb7-2b1d-4fa8-9999-cace50de4b5a\', \'multiverseId\': 184077}, \'multiverseid\': 184077}, {\'name\': \'儀仗兵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74908c54-ed41-4f3a-abf2-35036406847a\'}, \'multiverseid\': None}, {\'name\': \'Guarda de Honra\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8f7e0601-a859-40d3-9ae3-bbc1766736fd\'}, \'multiverseid\': None}]', '[{\'name\': \'Ehrwürdiger Mönch\', \'text\': \'Wenn der Ehrwürdige Mönch ins Spiel kommt, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Kleriker\', \'flavor\': \'„Ich verlasse mich eher auf den Übermut der Jugend als auf die Weisheit des Alters."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182693&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'52380aaf-732f-446e-8780-8e2479c55515\', \'multiverseId\': 182693}, \'multiverseid\': 182693}