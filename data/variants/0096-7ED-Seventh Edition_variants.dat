'name\': \'Lord von Atlantis\', \'text\': \'Alles Meervolk erhält +1/+1 und Inseltarnung. (Es ist unblockbar, solange der verteidigende Spieler eine Insel kontrolliert.)\', \'type\': \'Kreatur — Herrscher\', \'flavor\': \'Der Herrscher von Atlantis ist als Taktiker so berüchtigt, dass seine bloße Anwesenheit seine Krieger stärker macht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182723&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e24bc60-c671-4cdf-9ab5-0a2dd45f8ea1\', \'multiverseId\': 182723}, \'multiverseid\': 182723}, {\'name\': \'Señor de la Atlántida\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1cbb414b-cca7-4733-a58f-ebf6bf1542d6\'}, \'multiverseid\': None}, {\'name\': "Seigneur de l\'Atlantide", \'text\': \'Tous les ondins gagnent +1/+1 et acquièrent la traversée des îles. (Ils sont imblocables si le joueur défenseur contrôle au moins une île.)\', \'type\': \'Créature : seigneur\', \'flavor\': "Le seigneur de l\'Atlantide, dès qu\'il monte en tête de ses armées, donne un courage redoublé à son peuple.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184139&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4407a54c-6772-43ab-816e-0a523bb91c3a\', \'multiverseId\': 184139}, \'multiverseid\': 184139}, {\'name\': \'アトランティスの王\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9eebb3db-884e-4204-9968-8251d43cbe6a\'}, \'multiverseid\': None}, {\'name\': \'Senhor da Atlântida\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9fb35823-8c92-4046-8d2a-13ccb47c430c\'}, \'multiverseid\': None}]', '[{\'name\': \'Luftelementar\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Hier sind krankes Hirn und Wirbelsturm vereinigt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182698&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'540f45c8-708f-4b87-9dd1-3d3ab5ac4d19\', \'multiverseId\': 182698}, \'multiverseid\': 182698}, {\'name\': \'Elemental del aire\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74d00002-e0cf-4c0f-a78a-335b26f69540\'}, \'multiverseid\': None}, {\'name\': "Élémental d\'air", \'text\': \'Vol\', \'type\': \'Créature : élémental\', \'flavor\': \'La synthèse du cyclone et du tueur psychopathe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184114&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82703713-e7ab-4350-8498-0827ce3d5872\', \'multiverseId\': 184114}, \'multiverseid\': 184114}, {\'name\': \'大気の精霊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13c7105c-31a8-4fe0-a5e6-54c597f6603d\'}, \'multiverseid\': None}, {\'name\': \'Elemental do Ar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'812c37aa-c202-4656-ac31-5c88ab41b2b5\'}, \'multiverseid\': None}]', '[{\'name\': \'Luftmauer\', \'text\': \'(Mauern können nicht angreifen.)\\nFliegend\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'„Lass\\\' doch die Luft dich beschützen, sie ist ja überall." —Meisterzauberer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182751&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4361348d-654c-4a24-8614-5919bc8b64c3\', \'multiverseId\': 182751}, \'multiverseid\': 182751}, {\'name\': \'Muro de aire\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f58ea069-e827-40d7-8e98-3d45a69fb9ff\'}, \'multiverseid\': None}, {\'name\': "Mur d\'air", \'text\': \'(Les murs ne peuvent pas attaquer.)\\nVol\', \'type\': \'Créature : mur\', \'flavor\': "« Que l\'air qui tout entoure vous protège.» — Un maître magicien.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184167&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e37bb028-7272-47c2-aab8-7585546e3cf4\', \'multiverseId\': 184167}, \'multiverseid\': 184167}, {\'name\': \'大気の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3e8c9e9a-f524-4af5-91a8-8fe73fd3b60c\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Ar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'173e1605-7222-454b-9bda-e01ed74d4de7\'}, \'multiverseid\': None}]', '[{\'name\': \'Lumpensammler\', \'text\': \'{B}{B}{B}, {T}: Ein Gegner deiner Wahl zeigt die Karten auf seiner Hand offen vor und wirft eine zufällig ermittelte Kreaturenkarte davon ab. Spiele diese Fähigkeit nur während deines Zuges.\', \'type\': \'Kreatur — Diener\', \'flavor\': \'Er jagt dem nach, was hätte sein können.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182796&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f7f05aea-530b-419e-a368-69d1547f1ec7\', \'multiverseId\': 182796}, \'multiverseid\': 182796}, {\'name\': \'Pordiosero\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6d90cfdc-c38f-43ab-917c-18a392f4ea60\'}, \'multiverseid\': None}, {\'name\': \'Loqueteux\', \'text\': "{B}{B}{B}, {T}: L\'adversaire ciblé révèle sa main et se défausse, au hasard, d\'une carte de créature. Ne jouez cette capacité que pendant votre tour.", \'type\': \'Créature : mignon\', \'flavor\': "Il fait sa proie de ce qu\'il aurait pu devenir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184212&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a0a9e9c-2a49-42de-92c3-5688c49b140f\', \'multiverseId\': 184212}, \'multiverseid\': 184212}, {\'name\': \'人さらい\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2eceed7c-2bc8-4438-8b41-2b477052dc06\'}, \'multiverseid\': None}, {\'name\': \'Trapeiro\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'364375d4-4248-431c-ba96-68877dc1b15b\'}, \'multiverseid\': None}]', '[{\'name\': \'Löwenrudel\', \'text\': \'Du kannst das Löwenrudel seinen Kampfschaden dem verteidigenden Spieler zufügen lassen, als ob es nicht geblockt worden wäre.\', \'type\': \'Kreatur — Katze\', \'flavor\': \'Es gibt nur eine schlimmere Sache als einen hungrigen Löwen — viele hungrige Löwen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182901&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a2d8073-3c3f-4926-a7b6-06d784e783e7\', \'multiverseId\': 182901}, \'multiverseid\': 182901}, {\'name\': \'Orgullo de los leones\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25d80a27-e665-4b8a-94be-ca5e1aa0db88\'}, \'multiverseid\': None}, {\'name\': \'Bande de lions\', \'text\': "Vous pouvez faire que les blessures infligées par la Bande de lions au joueur défenseur le soient comme si elle n\'était pas bloquée.", \'type\': \'Créature : chat\', \'flavor\': "Il y a pire qu\'un lion affamé Plein de lions affamés.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184317&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae2dc428-6cf8-4a0b-ae65-d8a962fb2b7c\', \'multiverseId\': 184317}, \'multiverseid\': 184317}, {\'name\': \'ライオンの群れ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'34bdf72a-1c3c-4f33-93b3-621af568aaae\'}, \'multiverseid\': None}, {\'name\': \'Bando de Leões\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39569979-1382-4041-87bd-b15f718d518d\'}, \'multiverseid\': None}]', '[{\'name\': \'Macht der Eichen\', \'text\': \'Eine Kreatur deiner Wahl erhält +7/+7 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Rat mal, wo ich das hinpflanzen werde"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182897&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7946cbee-ea13-432e-b295-c4d8454ff1f6\', \'multiverseId\': 182897}, \'multiverseid\': 182897}, {\'name\': \'Poder de los robles\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'553192ee-406d-417b-b1dd-9cc6b919c24f\'}, \'multiverseid\': None}, {\'name\': \'Puissance des chênaies\', \'text\': "La créature ciblée gagne +7/+7 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Oh Oh Oh Il est vraiment des chênaies. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7e75e2a-9d32-4be9-89c8-9b387172dbf4\', \'multiverseId\': 184313}, \'multiverseid\': 184313}, {\'name\': \'樫の力\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d01856e-144d-4abb-b74f-2b3a9cc01c1d\'}, \'multiverseid\': None}, {\'name\': \'Força dos Carvalhos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b14967d2-5c93-40ee-97dc-ad009bc0942c\'}, \'multiverseid\': None}]', '[{\'name\': \'Mahamoti-Dschinn\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Dschinn\', \'flavor\': \'Als König der Geister der Lüfte reitet der Mahamoti-Dschinn auf den Flügeln der Winde. Im Kampf und im Spiel ist er ein gefährlicher Gegner, und zudem ein Meister der Täuschung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182724&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c44763d-5fbb-4050-92e1-b61b1a5269a5\', \'multiverseId\': 182724}, \'multiverseid\': 182724}, {\'name\': \'Djinn Mahamoti\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'343cf171-9f9f-496c-8d3c-ef07c2f1de72\'}, \'multiverseid\': None}, {\'name\': \'Djinn mahâmot\', \'text\': \'Vol\', \'type\': \'Créature : djinn\', \'flavor\': "Noble d\'entre les plus nobles esprits de l\'air, le djinn mahâmot voyage sur les ailes du vent. Maître de la ruse et du mensonge, il est aussi dangereux aux énigmes que sur le champ de bataille.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184140&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9f20275c-b1c7-48dd-8733-a77611790a39\', \'multiverseId\': 184140}, \'multiverseid\': 184140}, {\'name\': \'マハモティ・ジン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d1deb5fb-c6f6-49c9-a783-2fabfb4c550d\'}, \'multiverseid\': None}, {\'name\': \'Gênio Mahamoti\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02918aa7-577c-4df9-b0d4-9dea12e4f2af\'}, \'multiverseid\': None}]', '[{\'name\': \'Manabruch\', \'text\': \'Immer wenn ein Spieler einen Zauberspruch ausspielt, bringt er ein Land, das er kontrolliert, auf die Hand seines Besitzers zurück.\', \'type\': \'Verzauberung\', \'flavor\': \'Das Mana, das die Welt zusammenhält, kann sie auch auseinanderreißen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182725&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2a9a4d5-01a0-4f32-b33d-55e663216e6d\', \'multiverseId\': 182725}, \'multiverseid\': 182725}, {\'name\': \'Brecha de maná\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ecfb1388-731b-45d5-913b-4ca1ce5c8bc4\'}, \'multiverseid\': None}, {\'name\': \'Brèche de mana\', \'text\': "À chaque fois qu\'un joueur joue un sort, ce joueur renvoie un terrain qu\'il contrôle dans la main de son propriétaire.", \'type\': \'Enchantement\', \'flavor\': \'Le mana qui maintient le monde peut aussi bien le détruire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184141&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'adfd5f31-cc20-4d8f-bc9f-db2f9739b8e2\', \'multiverseId\': 184141}, \'multiverseid\': 184141}, {\'name\': \'マナ侵害\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b927a9d2-564c-4b8e-8d3f-9dbe136bc457\'}, \'multiverseid\': None}, {\'name\': \'Brecha de Mana\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8adeb729-49c4-4f03-b36d-87cbfb0e8224\'}, \'multiverseid\': None}]', '[{\'name\': \'Manakollision\', \'text\': \'Ein Gegner deiner Wahl und du werfen beide eine Münze. Manakollision fügt jedem Spieler, dessen Münze „Zahl" zeigt, 1 Schadenspunkt zu. Wiederholt diesen Prozess, bis beide Münzen im selben Wurf „Kopf" zeigen.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182842&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6cea431b-817e-47aa-8161-bbabfa587ac6\', \'multiverseId\': 182842}, \'multiverseid\': 182842}, {\'name\': \'Choque de maná\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'51616960-88b5-4c36-b33a-d8d3479c9ad3\'}, \'multiverseid\': None}, {\'name\': \'Choc de mana\', \'text\': "Vous et l\'adversaire ciblé lancez chacun une pièce en l\'air. Le Choc de mana inflige 1 blessure à chaque joueur dont la pièce retombe sur pile. Répétez la procédure jusqu\'à ce que les deux pièces tombent sur face en même temps.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184258&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e43463a0-4a9c-43a6-9dc0-22fe83df78e8\', \'multiverseId\': 184258}, \'multiverseid\': 184258}, {\'name\': \'魔力激突\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9357a7ab-07b8-4286-8e20-26ee42597b3b\'}, \'multiverseid\': None}, {\'name\': \'Duelo de Mana\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0062a856-46f6-4d99-9f65-20c0cb3054b1\'}, \'multiverseid\': None}]', '[{\'name\': \'Manamangel\', \'text\': \'Tappe alle Länder, die ein Spieler deiner Wahl kontrolliert, und leere seinen Manavorrat.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wenn du ihnen die Kraft nimmst, wird auch ihr Kampfeswille abnehmen." —Tolarianischer Zauberer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182726&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'81495e2a-e487-4430-abe6-0280d35c11da\', \'multiverseId\': 182726}, \'multiverseid\': 182726}, {\'name\': \'Escasez de maná\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1bb0a97c-de74-4dcc-870e-2cafa49846cc\'}, \'multiverseid\': None}, {\'name\': \'Pénurie de mana\', \'text\': \'Engagez tous les terrains que le joueur ciblé contrôle et videz sa réserve.\', \'type\': \'Éphémère\', \'flavor\': \'« Amputez leur pouvoir, et leur combativité faiblira. » — Un magicien tolarian.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184142&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0744e430-8764-4af7-8241-0b731434edef\', \'multiverseId\': 184142}, \'multiverseid\': 184142}, {\'name\': \'枯渇\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0439e5e4-a87b-43fb-abfc-38c3ecafdc5d\'}, \'multiverseid\': None}, {\'name\': \'Escoadouro de Mana\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2d1799d3-1a84-4912-95d1-f36d04ee7439\'}, \'multiverseid\': None}]', "[{'name': 'Maro', 'text': 'Stärke und Widerstandskraft des Maro sind gleich der Anzahl der Karten auf deiner Hand.', 'type': 'Kreatur — Elementarwesen', 'flavor': 'Es haben noch keine zwei Leute denselben Maro gesehen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182896&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0c629cf3-4092-4dc7-a1e9-632f784681de', 'multiverseId': 182896}, 'multiverseid': 182896}, {'name': 'Maro', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '46ca2419-24e2-444c-8135-9276de68365c'}, 'multiverseid': None}, {'name': 'Maro', 'text': 'Le Maro a une force et une endurance chacune égale au nombre de cartes dans votre main.', 'type': 'Créature : élémental', 'flavor': 'Chacun voit un maro différent.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184312&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2ab143f8-f9d7-4fda-ab42-71786213280f', 'multiverseId': 184312}, 'multiverseid': 184312}, {'name': 'マロー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '40ab7196-655a-4906-9a9b-ac3dcf1b06c7'}, 'multiverseid': None}, {'name': 'Maro', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2c5823f4-20c8-4fad-afe3-6356ff50a0a9'}, 'multiverseid': None}]", '[{\'name\': \'Massenschlacht\', \'text\': \'Kreaturen können nicht blocken.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Generale waren tot. Die Schlachtpläne vergessen. Jetzt ging es jedem nur noch um seine eigene Haut."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182814&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58446500-a706-4668-a492-263236699f3f\', \'multiverseId\': 182814}, \'multiverseid\': 182814}, {\'name\': \'Bulla\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c8f96eec-8069-4808-888d-654a7a51bfa8\'}, \'multiverseid\': None}, {\'name\': \'Foutoir\', \'text\': \'Les créatures ne peuvent pas bloquer.\', \'type\': \'Enchantement\', \'flavor\': \'Les généraux sont morts. Les plans de bataille perdus. Chacun pour soi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184230&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'665ad787-a1d7-400c-b6d6-1c100b679ae5\', \'multiverseId\': 184230}, \'multiverseid\': 184230}, {\'name\': \'精神異常\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d9f8aade-452b-4a88-a8e1-b19a0befb9c4\'}, \'multiverseid\': None}, {\'name\': \'Tumultuar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dccba35a-fb5b-4775-8f83-6f64f3ce4618\'}, \'multiverseid\': None}]', '[{\'name\': \'Mawcor\', \'text\': \'Fliegend\\n{T}: Mawcor fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Keiner der beiden Köpfe hat ein Gehirn — das sitzt irgendwo in der Brust —, aber mit vier Augen kann man besser zielen als mit zwei.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a78983d4-e853-43bc-9a6f-1db3b1c359cd\', \'multiverseId\': 182727}, \'multiverseid\': 182727}, {\'name\': \'Maucor\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'786070f5-527f-487d-acb4-7123217743dc\'}, \'multiverseid\': None}, {\'name\': \'Corgueule\', \'text\': \'Vol\\n{T}: Le Corgueule inflige 1 blessure à une cible, créature ou joueur.\', \'type\': \'Créature : bête\', \'flavor\': "Aucune des deux têtes n\'a de cerveau — il est niché dans son poitrail — mais quatre yeux valent mieux que deux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184143&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'58662fd0-99b8-4c79-a2e9-3491da5e4c84\', \'multiverseId\': 184143}, \'multiverseid\': 184143}, {\'name\': \'大口獣\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a2c2789c-6e62-498e-a83e-355aead87d2f\'}, \'multiverseid\': None}, {\'name\': \'Mawcor\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb4c00ed-d79a-48f8-89ed-db1d586043dc\'}, \'multiverseid\': None}]', '[{\'name\': \'Meervolk des Perlendreizacks\', \'type\': \'Kreatur — Meervolk\', \'flavor\': \'„Die Paladine wären weise, wenn sie das Perlendreizackvolk nicht unterschätzen würden. Die Meermannkrieger haben schon so manchen Krieg der Menschen entschieden... und ich bezweifele nicht, dass sie es wieder tun werden." —Oneanischer Lehrer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182730&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8bbeabe-d4f9-4dfa-96a2-3116c2f8a26d\', \'multiverseId\': 182730}, \'multiverseid\': 182730}, {\'name\': \'Tritones del Tridente Perlado\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'662c2768-3fa1-4d9a-a81c-a8432568bc7d\'}, \'multiverseid\': None}, {\'name\': \'Ondins du Trident nacré\', \'type\': \'Créature : ondin\', \'flavor\': "« Les paladins seraient bien sages de ne pas oublier le Trident nacré. Les soldats ondins ont décidé du destin de plus d\'une guerre humaine… Et je suis sûr qu\'ils le feront encore. » — Un érudit onéan.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184146&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9a11f38-32d8-4ab3-b0d8-f86579cf3283\', \'multiverseId\': 184146}, \'multiverseid\': 184146}, {\'name\': \'真珠三叉矛の人魚\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f087e689-6de0-4a49-b1d7-2d5d176ff7e6\'}, \'multiverseid\': None}, {\'name\': \'Tritões do Tridente Perolado\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'723dabf3-ffcc-4df7-abff-70fdb4e25f1d\'}, \'multiverseid\': None}]', '[{\'name\': \'Meisterbogenschützen\', \'text\': \'{T}: Die Meisterbogenschützen fügen einer angreifenden oder blockenden Kreatur deiner Wahl 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Sie fiedern ihre Pfeile mit den Federn von Engeln.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182655&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eef9ad59-0563-416c-b383-47c7d93be83f\', \'multiverseId\': 182655}, \'multiverseid\': 182655}, {\'name\': \'Arqueros de élite\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'027d033f-8f88-429d-a0cd-c2ef2d36824e\'}, \'multiverseid\': None}, {\'name\': "Archers d\'élite", \'text\': "{T}: Ces Archers d\'élite infligent 3 blessures à la créature attaquante ou bloqueuse ciblée.", \'type\': \'Créature : soldat\', \'flavor\': "Ils empennent leurs flèches de plumes d\'anges.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184071&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'96f0fe76-92f6-49dd-b3b4-2a615b883c79\', \'multiverseId\': 184071}, \'multiverseid\': 184071}, {\'name\': \'精鋭なる射手\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d99d2b12-a657-4e33-a5ff-661ddf38a0dd\'}, \'multiverseid\': None}, {\'name\': \'Arqueiros de Elite\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62857ec5-ac16-4153-9182-575c6233f2b5\'}, \'multiverseid\': None}]', "[{'name': 'Meisterheiler', 'text': '{T}: Verhindere die nächsten 4 Schadenspunkte, die in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt werden.', 'type': 'Kreatur — Kleriker', 'flavor': 'Ihr Herz enthält die Angst jedes Soldaten, den sie je geheilt hat.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182667&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ddb22612-95dc-42e2-99e0-853e963b2bbe', 'multiverseId': 182667}, 'multiverseid': 182667}, {'name': 'Sanador experto', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '32721e7b-d0b3-415e-985a-8a4eba5667d3'}, 'multiverseid': None}, {'name': 'Maître guérisseur', 'text': '{T}: Prévenez, ce tour-ci, les prochaines 4 blessures sur une cible, créature ou joueur.', 'type': 'Créature : clerc', 'flavor': '« Je le soignais, Dieu le guérit. » — Ambroise Paré.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184083&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5eff00b2-5888-4950-b62c-3d13a67e856a', 'multiverseId': 184083}, 'multiverseid': 184083}, {'name': '練達の癒し手', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '4f52358e-e5a4-428d-a15f-711f24b341a0'}, 'multiverseid': None}, {'name': 'Mestre Curandeiro', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fc0db56b-81ab-45a1-b43d-6374604f4d4c'}, 'multiverseid': None}]", '[{\'name\': \'Messingstadt\', \'text\': \'Immer wenn die Messingstadt getappt wird, fügt sie dir 1 Schadenspunkt zu.{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182967&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'eba45306-f84b-4881-805b-148cb6815ac9\', \'multiverseId\': 182967}, \'multiverseid\': 182967}, {\'name\': \'Ciudad de bronce\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'af59d885-cea7-4661-8274-84af30471260\'}, \'multiverseid\': None}, {\'name\': "Cité d\'airain", \'text\': "À chaque fois que la Cité d\'airain devient engagée, elle vous inflige 1 blessure.\\n{T}: Ajoutez un mana d\'une couleur de votre choix à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184383&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b6047fa4-6915-4315-a4fd-9048a6f91153\', \'multiverseId\': 184383}, \'multiverseid\': 184383}, {\'name\': \'真鍮の都\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71ff5260-a7c9-49c8-a050-f21f9b724a32\'}, \'multiverseid\': None}, {\'name\': \'Cidade de Bronze\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'df8bed54-9749-4591-91d7-389da87752ca\'}, \'multiverseid\': None}]', '[{\'name\': \'Meuchler der Felsenburg\', \'text\': \'{T}, opfere eine Kreatur: Zerstöre eine nichtschwarze Kreatur deiner Wahl.\', \'type\': \'Kreatur — Assassine\', \'flavor\': \'Der Meuchler sieht nur Kehlen und hört nur Herzschläge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182806&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae99f81e-84dc-43ae-bfae-5354df2ebd04\', \'multiverseId\': 182806}, \'multiverseid\': 182806}, {\'name\': \'Asesino de la Fortaleza\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04d391c5-0c5d-46e0-9638-ca87722c5e43\'}, \'multiverseid\': None}, {\'name\': \'Assassin de la Forteresse\', \'text\': \'{T}, sacrifiez une créature : Détruisez la créature non-noire ciblée.\', \'type\': \'Créature : assassin\', \'flavor\': "L\'assassin ne voit que des gorges et n\'entend que des battements de cœur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184222&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7577f5e8-4855-4f8c-aff0-834b4798f2d9\', \'multiverseId\': 184222}, \'multiverseid\': 184222}, {\'name\': \'要塞の暗殺者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b2d64e8e-ab31-4cdd-886c-55796a4a6f07\'}, \'multiverseid\': None}, {\'name\': \'Assassino da Fortaleza\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b25b9167-213e-491c-bbff-1c1eb3af1750\'}, \'multiverseid\': None}]', '[{\'name\': \'Misere\', \'text\': \'Misere fügt jeder weißen Kreatur und jedem Spieler, der eine weiße Kreatur kontrolliert, 2 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Feuer tut fast so weh wie das Chaos, das danach kommt. Fast." —Der Paladin des Westens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182819&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93e045cc-1d27-4837-88c9-7596cf20aebf\', \'multiverseId\': 182819}, \'multiverseid\': 182819}, {\'name\': \'Desorden\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e7252b7-4e7f-4a63-ab5b-1e6da438f4d1\'}, \'multiverseid\': None}, {\'name\': \'Désordre\', \'text\': \'Le Désordre inflige 2 blessures à chaque créature blanche et à chaque joueur qui contrôle au moins une créature blanche.\', \'type\': \'Rituel\', \'flavor\': "« Le feu les blesse presque autant que le chaos. Presque. » — Le Paladin de l\'Ouest.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184235&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7241312e-531e-41be-971d-91fd1cc013c3\', \'multiverseId\': 184235}, \'multiverseid\': 184235}, {\'name\': \'無秩序\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54153b40-0892-4a95-b7a2-8bc3f741619c\'}, \'multiverseid\': None}, {\'name\': \'Desordem\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'932cc60e-ca17-4aa4-8bcb-2db9c82dfd77\'}, \'multiverseid\': None}]', '[{\'name\': \'Mittelmäßigkeitswahn\', \'text\': \'Wenn der Mittelmäßigkeitswahn ins Spiel kommt, erhältst du 10 Lebenspunkte dazu.\\nWenn der Mittelmäßigkeitswahn das Spiel verlässt, verlierst du 10 Lebenspunkte.\', \'type\': \'Verzauberung\', \'flavor\': \'Manchmal muss es die zweitbeste Lösung sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182710&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d28fc0a4-d513-4397-9ff2-aeadfb43061f\', \'multiverseId\': 182710}, \'multiverseid\': 182710}, {\'name\': \'Delirios de mediocridad\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84bb6acf-9c75-486e-ab34-e1ca1d96636f\'}, \'multiverseid\': None}, {\'name\': \'Désillusions des médiocres\', \'text\': \'Quand ces Désillusions des médiocres arrivent en jeu, vous gagnez 10 points de vie.\\nQuand ces Désillusions des médiocres quittent le jeu, vous perdez 10 points de vie.\', \'type\': \'Enchantement\', \'flavor\': "Quand on n\'a pas le choix, on fait avec.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184126&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1c19ae0c-7ae4-4579-9d92-37e6d9055d8a\', \'multiverseId\': 184126}, \'multiverseid\': 184126}, {\'name\': \'凡人の錯覚\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'418726e1-d242-470c-9e90-3074b93c69d4\'}, \'multiverseid\': None}, {\'name\': \'Ilusões de Mediocridade\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d13ec05c-937b-4305-9ce9-02b0ad8ba98e\'}, \'multiverseid\': None}]', "[{'name': 'Moosdiamant', 'text': 'Der Moosdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {G}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182949&type=card', 'language': 'German', 'identifiers': {'scryfallId': '44a95e96-c9a5-481d-819b-765e40f83b63', 'multiverseId': 182949}, 'multiverseid': 182949}, {'name': 'Diamante mohoso', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'aa454a6e-2bf2-48d9-9f04-48c84b717faa'}, 'multiverseid': None}, {'name': 'Diamant de la mousse', 'text': 'Le Diamant de la mousse arrive en jeu engagé.\\n{T} : Ajoutez {G} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184365&type=card', 'language': 'French', 'identifiers': {'scryfallId': '65e5253c-a547-4533-b91a-c275418a01fe', 'multiverseId': 184365}, 'multiverseid': 184365}, {'name': '苔色のダイアモンド', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd827a435-7658-4370-b571-cbc2cb016934'}, 'multiverseid': None}, {'name': 'Diamante de Limo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fde808b9-c3f2-4574-9f92-905e7115befc'}, 'multiverseid': None}]", '[{\'name\': \'Mure\', \'text\': \'Mauern können angreifen, als ob sie keine Mauern wären.\', \'type\': \'Verzauberung\', \'flavor\': \'„Wir haben drei Wochen lang versucht, diese Mauer niederzureißen. Jetzt reißt sie uns nieder." —Oneanischer Hauptmann\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182675&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'283d9200-3c18-470e-b6d3-167aea4e922b\', \'multiverseId\': 182675}, \'multiverseid\': 182675}, {\'name\': \'Piedras animadas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ac04ca2d-174c-40a6-b02c-5bf7d0341525\'}, \'multiverseid\': None}, {\'name\': \'Pierres agressives\', \'text\': "Les murs peuvent attaquer comme s\'ils n\'étaient pas des murs.", \'type\': \'Enchantement\', \'flavor\': "« Nous avons passé trois semaines à tenter de briser ce mur. Et maintenant c\'est lui qui nous brise. » — Un sergent onéan.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184091&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6ddde55-7aae-473d-87ee-0258c9c67793\', \'multiverseId\': 184091}, \'multiverseid\': 184091}, {\'name\': \'ローリング・ストーンズ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'90443d89-990c-4c15-889d-c4b47c196f83\'}, \'multiverseid\': None}, {\'name\': \'Pedras Rolantes\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f23c5a73-0bef-45a0-8ae4-3e809971fe98\'}, \'multiverseid\': None}]', '[{\'name\': \'Mühlstein\', \'text\': \'{2}, {T}: Ein Spieler deiner Wahl legt die obersten beiden Karten seiner Bibliothek auf seinen Friedhof.\', \'type\': \'Artefakt\', \'flavor\': \'Das Geräusch des unablässigen Mahlens des Mühlsteins hat schon mehr als einen Magier in den Wahnsinn getrieben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182948&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf6da976-6ebf-4291-848c-ecb08e23b2eb\', \'multiverseId\': 182948}, \'multiverseid\': 182948}, {\'name\': \'Rueda de molino\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d7a17117-e1ab-4602-87f0-f8ae53facb3d\'}, \'multiverseid\': None}, {\'name\': \'Meule\', \'text\': \'{2}, {T}: Le joueur ciblé met dans son cimetière les deux cartes du dessus de sa bibliothèque.\', \'type\': \'Artefact\', \'flavor\': "Plus d\'un mage a été rendu fou par le bruit implacable de la meule, grinçant sans trêve ni repos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184364&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ea34d66-692f-4c9d-8a89-245e55f306f9\', \'multiverseId\': 184364}, \'multiverseid\': 184364}, {\'name\': \'石臼\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cb55dc6c-6993-4f78-95a4-594c2090e6b7\'}, \'multiverseid\': None}, {\'name\': \'Mó\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6700baec-6fb2-42fd-b40d-aee722c5be01\'}, \'multiverseid\': None}]', "[{'name': 'Nachblüte', 'text': 'Zeige die erste Karte, die du in jedem Zug ziehst, offen vor. Immer wenn du dabei ein Standardland vorzeigst, ziehe eine Karte.', 'type': 'Verzauberung', 'flavor': 'Diejenigen, die den Wald verstehen, wissen auch, wie man seine Erträge erntet.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182906&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a6bcb2ae-3f78-438a-ab96-db89e6c65a67', 'multiverseId': 182906}, 'multiverseid': 182906}, {'name': 'Segunda cosecha', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '70f79fd3-90b2-4e70-b015-47fd026a1f4f'}, 'multiverseid': None}, {'name': 'Varenne', 'text': 'Révélez la première carte que vous piochez à chaque tour. À chaque fois que vous révélez de cette manière une carte de terrain de base, piochez une carte.', 'type': 'Enchantement', 'flavor': 'Ceux qui comprennent la forêt peuvent y prendre leur tribut.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184322&type=card', 'language': 'French', 'identifiers': {'scryfallId': '913b7996-a08f-4cd4-ac1b-0d527e6220bc', 'multiverseId': 184322}, 'multiverseid': 184322}, {'name': '二度目の収穫', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '06159d28-6917-4ffe-b7ba-f2239e6a7bbc'}, 'multiverseid': None}, {'name': 'Outonada', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a3698844-be72-46e2-8315-803356f2d0f7'}, 'multiverseid': None}]", "[{'name': 'Nachtdiamant', 'text': 'Der Nachtdiamant kommt getappt ins Spiel.{T}: Erhöhe deinen Manavorrat um {B}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182929&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1937cb39-a4ca-4b88-af0b-e00110b8392d', 'multiverseId': 182929}, 'multiverseid': 182929}, {'name': 'Diamante carbonífero', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e8e627b7-0a6a-4881-b008-a411ab4b0feb'}, 'multiverseid': None}, {'name': 'Diamant du charbon', 'text': 'Le Diamant du charbon arrive en jeu engagé.\\n{T} : Ajoutez {B} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184345&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0483f0ae-ad24-4e42-922b-f017bf532312', 'multiverseId': 184345}, 'multiverseid': 184345}, {'name': '炭色のダイアモンド', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '20b5a1f7-409d-4891-8c7f-50587a2045e3'}, 'multiverseid': None}, {'name': 'Diamante de Carvão', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b68ced06-3502-4047-957b-3dcb2d20e447'}, 'multiverseid': None}]", "[{'name': 'Nachtmahr', 'text': 'Fliegend\\nStärke und Widerstandskraft des Nachtmahrs sind gleich der Anzahl der Sümpfe, die du kontrollierst.', 'type': 'Kreatur — Nachtmahr', 'flavor': 'Der Donner seiner Hufe verwandelt Träume in Verzweiflung.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182790&type=card', 'language': 'German', 'identifiers': {'scryfallId': '15db21e7-20b8-47c9-aeec-22907c73cf42', 'multiverseId': 182790}, 'multiverseid': 182790}, {'name': 'Pesadilla', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a16c5078-03d9-48f3-be22-a7df41e4aa3e'}, 'multiverseid': None}, {'name': 'Cheval de cauchemar', 'text': 'Vol\\nLe Cheval de cauchemar a une force et une endurance chacune égale au nombre de marais que vous contrôlez.', 'type': 'Créature : cauchemar', 'flavor': '« Cauchemars entrevus dans le sommeil sans bornes, Sirènes aux seins nus, mélusines, licornes (…) » —Victor Hugo, La Légende des siècles', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184206&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0a715fbf-9b94-4810-aa77-9d03325faac4', 'multiverseId': 184206}, 'multiverseid': 184206}, {'name': '夢魔', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'a591b3ad-6eba-4c92-baa9-943fcb091813'}, 'multiverseid': None}, {'name': 'Pesadelo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '356b2022-4bdf-427a-a55d-695e92028072'}, 'multiverseid': None}]", "[{'name': 'Nebel', 'text': 'Verhindere allen Kampfschaden, der in diesem Zug zugefügt würde.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182885&type=card', 'language': 'German', 'identifiers': {'scryfallId': '88b87a55-c6d6-42d8-80e0-9c427d63d365', 'multiverseId': 182885}, 'multiverseid': 182885}, {'name': 'Niebla', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8e236980-2f6f-4419-a404-02367f2cee8c'}, 'multiverseid': None}, {'name': 'Brouillard', 'text': 'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184301&type=card', 'language': 'French', 'identifiers': {'scryfallId': '61ad5eae-4cdf-489c-970f-664240a1405a', 'multiverseId': 184301}, 'multiverseid': 184301}, {'name': '濃霧', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0c142a56-b0dc-497c-8ab6-812454e565cb'}, 'multiverseid': None}, {'name': 'Neblina', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7d8eea15-7fff-4a02-9fd4-401a34e7c216'}, 'multiverseid': None}]", '[{\'name\': \'Neuer Anspruch\', \'text\': \'Lege eine Karte deiner Wahl aus deinem Friedhof oben auf deine Bibliothek.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wer weise ist, achtet genauso auf das, was er wegschmeißt, wie auf das, was er behält.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182903&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e2683efe-b6f5-4f9c-8911-1a80b15ee6d3\', \'multiverseId\': 182903}, \'multiverseid\': 182903}, {\'name\': \'Recobrar\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'48e512e7-1164-4e5a-88af-2ce7adc3e154\'}, \'multiverseid\': None}, {\'name\': \'Récupération\', \'text\': \'Mettez la carte ciblée en provenance de votre cimetière au-dessus de votre bibliothèque.\', \'type\': \'Éphémère\', \'flavor\': "Les sages ont autant de respect pour ce qu\'ils jettent que pour ce qu\'ils gardent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184319&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb38fa79-f996-4ec5-9066-c42a1c7cc2c4\', \'multiverseId\': 184319}, \'multiverseid\': 184319}, {\'name\': \'回収\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c463210e-fd68-44d7-b7a4-19a2ea097cd0\'}, \'multiverseid\': None}, {\'name\': \'Restituir\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af266037-e75c-4a33-8149-3ce3e1f76e9f\'}, \'multiverseid\': None}]', '[{\'name\': \'Ogerscherge\', \'text\': \'Der Ogerscherge kann nicht blocken.\', \'type\': \'Kreatur — Oger\', \'flavor\': \'Oger lernen, wie man Sachen zerstört, sogar bevor sie lernen, wie man läuft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182843&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bce26fe2-0f59-4947-ad7f-0cc0cc7d9db3\', \'multiverseId\': 182843}, \'multiverseid\': 182843}, {\'name\': \'Capataz ogro\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'929f2d5f-2578-4d0d-83a6-4f605798d571\'}, \'multiverseid\': None}, {\'name\': \'Surveillant ogre\', \'text\': \'Le Surveillant ogre ne peut pas bloquer.\', \'type\': \'Créature : ogre\', \'flavor\': "Les ogres apprennent à frapper avant d\'apprendre à marcher.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184259&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d501dd5d-0d5a-4ee2-9d78-c5e3d6f69c39\', \'multiverseId\': 184259}, \'multiverseid\': 184259}, {\'name\': \'オーガの監督官\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d97c26d8-0eb3-48c5-9fca-9771a095aa34\'}, \'multiverseid\': None}, {\'name\': \'Capataz Ogre\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b2b66f9-e836-4519-ad33-d203981d3f88\'}, \'multiverseid\': None}]', '[{\'name\': \'Okk\', \'text\': \'Der Okk kann nur angreifen, wenn eine Kreatur mit größerer Stärke ebenfalls angreift.\\nDer Okk kann nur blocken, wenn eine Kreatur mit größerer Stärke ebenfalls blockt.\', \'type\': \'Kreatur — Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182844&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bce17f9c-7128-41bf-8f70-a721d792eeec\', \'multiverseId\': 182844}, \'multiverseid\': 182844}, {\'name\': \'Okk\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f38bcc3-bcf5-41b6-b5bc-90840eaf308a\'}, \'multiverseid\': None}, {\'name\': \'Okk\', \'text\': "L\'Okk ne peut pas attaquer à moins qu\'une créature avec une force plus grande attaque aussi.\\nL\'Okk ne peut pas bloquer à moins qu\'une créature avec une force plus grande bloque aussi.", \'type\': \'Créature : gobelin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184260&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b09fb4d5-e9f3-4c70-8d38-1b4a6bea6bad\', \'multiverseId\': 184260}, \'multiverseid\': 184260}, {\'name\': \'オック\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9a11b98c-039d-489c-ac2f-9d565d1396b6\'}, \'multiverseid\': None}, {\'name\': \'Okk\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a114ef80-661d-4d52-a042-851b107b34e5\'}, \'multiverseid\': None}]', '[{\'name\': \'Opposition\', \'text\': \'Tappe eine ungetappte Kreatur, die du kontrollierst: Tappe ein Artefakt, eine Kreatur oder ein Land deiner Wahl.\', \'type\': \'Verzauberung\', \'flavor\': \'Einen Zauberer zu erschöpfen kann ziemlich erschöpfend sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182732&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'13cc2bc9-0a52-487a-bcf5-3ffb11bd685b\', \'multiverseId\': 182732}, \'multiverseid\': 182732}, {\'name\': \'Oposición\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4c969fb7-4a6b-44e4-9b6a-1370b469b5e7\'}, \'multiverseid\': None}, {\'name\': \'Opposition\', \'text\': "Engagez une créature dégagée que vous contrôlez : Engagez l\'artefact ciblé, la créature ciblée ou le terrain ciblé.", \'type\': \'Enchantement\', \'flavor\': "Épuiser un magicien peut s\'avérer épuisant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184148&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7a6ad18-ebc5-4bd1-87cb-3d46048e94ec\', \'multiverseId\': 184148}, \'multiverseid\': 184148}, {\'name\': \'対立\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'07885ea5-df3e-4647-a09d-36fe35f894d5\'}, \'multiverseid\': None}, {\'name\': \'Oposição\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d5f7803-07ec-4b13-a119-bf295d41ef13\'}, \'multiverseid\': None}]', '[{\'name\': \'Ork-Artillerie\', \'text\': \'{T}: Die Ork-Artillerie fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte und dir 3 Schadenspunkte zu.\', \'type\': \'Kreatur — Ork\', \'flavor\': \'„Bereit Zielen... Feuer frei" „Autsch"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182845&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a8954bd-279d-4006-b3d4-0ed3a9b5b587\', \'multiverseId\': 182845}, \'multiverseid\': 182845}, {\'name\': \'Artillería orca\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b6614da4-3100-4a32-bd84-5914ba9a33b6\'}, \'multiverseid\': None}, {\'name\': \'Artillerie orque\', \'text\': "{T}: L\'Artillerie orque inflige 2 blessures à une cible, créature ou joueur, et vous inflige 3 blessures.", \'type\': \'Créature : orque\', \'flavor\': \'« Prêts… Visez… Feu » « Ouille »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184261&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88773252-11df-4805-9161-064e6e8b25bc\', \'multiverseId\': 184261}, \'multiverseid\': 184261}, {\'name\': \'オーク弩弓隊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc8591ff-c0bb-4232-a6e0-87c65464387e\'}, \'multiverseid\': None}, {\'name\': \'Artilharia Órquica\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8dc2413-5ddd-45fd-aba2-98c7e5d7c4da\'}, \'multiverseid\': None}]', '[{\'name\': \'Paladin des Nordens\', \'text\': \'{W}{W}, {T}: Zerstöre eine schwarze bleibende Karte deiner Wahl.\', \'type\': \'Kreatur — Ritter\', \'flavor\': \'„Wie sanft sein Gesicht ist, wie gerade seine Gedanken. Ich freue mich schon darauf, seinen kraftvollen Willen zu brechen." —Der Paladin des Ostens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182668&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'695e0b64-891e-456c-b69f-305479b076df\', \'multiverseId\': 182668}, \'multiverseid\': 182668}, {\'name\': \'Paladín del norte\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e34c13a-810b-4283-a0d7-b153ad702ed0\'}, \'multiverseid\': None}, {\'name\': \'Paladin du Nord\', \'text\': \'{W}{W}, {T}: Détruisez le permanent noir ciblé.\', \'type\': \'Créature : chevalier\', \'flavor\': "« Si gracieux que soit son visage, si sûre que soit sa pensée, je briserai un jour sa volonté admirable. » — Le Paladin de l\'Est.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184084&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f6e500e4-1d6f-457b-ade2-a6dd107581ed\', \'multiverseId\': 184084}, \'multiverseid\': 184084}, {\'name\': \'北の聖騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cc6b9d59-de20-4df6-ad71-faa32a80f0f6\'}, \'multiverseid\': None}, {\'name\': \'Paladino do Norte\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e692143d-45ac-4db4-af65-ffa7f61849e3\'}, \'multiverseid\': None}]', '[{\'name\': \'Paladin des Ostens\', \'text\': \'{B}{B}, {T}: Zerstöre eine grüne Kreatur deiner Wahl.\', \'type\': \'Kreatur — Ritter\', \'flavor\': \'„Es gibt keinen schlimmeren Gegner. Seine Leidenschaft für den Tod grenzt nicht bloß an den Wahnsinn, sie suhlt sich darin." —Der Paladin des Südens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182772&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'09968309-cb94-4223-af17-574946e181d0\', \'multiverseId\': 182772}, \'multiverseid\': 182772}, {\'name\': \'Paladín oriental\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67c65187-3023-4ebf-a7f8-3ac36cae6e8d\'}, \'multiverseid\': None}, {\'name\': "Paladin de l\'Est", \'text\': \'{B}{B}, {T}: Détruisez la créature verte ciblée.\', \'type\': \'Créature : chevalier\', \'flavor\': "« Il n\'y a pas pire ennemi. Il est fou de la mort, et la mort est folle de lui. » —Le Paladin du Sud.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184188&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8be66e60-de3c-431d-8e8e-68d04cb24cd8\', \'multiverseId\': 184188}, \'multiverseid\': 184188}, {\'name\': \'東の聖騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7aa3ceb8-f6fb-4dc6-9c39-9f712fb8676d\'}, \'multiverseid\': None}, {\'name\': \'Paladino do Leste\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'abf4e5ee-1e42-448c-8a4a-bd06130b699c\'}, \'multiverseid\': None}]', '[{\'name\': \'Paladin des Südens\', \'text\': \'{W}{W}, {T}: Zerstöre eine rote bleibende Karte deiner Wahl.\', \'type\': \'Kreatur — Ritter\', \'flavor\': \'„Wie kann einer so viel kämpfen und es so wenig genießen?" —Der Paladin des Westens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182686&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d7581195-c768-438e-83b8-d51dd18bc1d9\', \'multiverseId\': 182686}, \'multiverseid\': 182686}, {\'name\': \'Paladín del sur\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d566a6f8-e38d-42d8-9a1a-2046cb78cc76\'}, \'multiverseid\': None}, {\'name\': \'Paladin du Sud\', \'text\': \'{W}{W}, {T}: Détruisez le permanent rouge ciblé.\', \'type\': \'Créature : chevalier\', \'flavor\': "« Comment peut-on se battre aussi souvent sans y prendre plaisir ? » — Le Paladin de l\'Ouest.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184102&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'794f7550-a18c-409a-aedf-f7ab4c6de863\', \'multiverseId\': 184102}, \'multiverseid\': 184102}, {\'name\': \'南の聖騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'58f63e44-a887-43ec-a18e-deec5ab0252b\'}, \'multiverseid\': None}, {\'name\': \'Paladino do Sul\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d91e3978-5731-451e-ab95-d19f7c2957ab\'}, \'multiverseid\': None}]', '[{\'name\': \'Paladin des Westens\', \'text\': \'{B}{B}, {T}: Zerstöre eine weiße Kreatur deiner Wahl.\', \'type\': \'Kreatur — Ritter\', \'flavor\': \'„Erwarte nichts von ihm außer Hohn, Schmeichelei und Lügen. Und drehe ihm niemals den Rücken zu." —Der Paladin des Nordens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182810&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2520415a-ba48-4239-b513-47e72f3f3391\', \'multiverseId\': 182810}, \'multiverseid\': 182810}, {\'name\': \'Paladín occidental\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd9661f3-6be3-418f-a1f3-7673c04e1ff9\'}, \'multiverseid\': None}, {\'name\': "Paladin de l\'Ouest", \'text\': \'{B}{B}, {T}: Détruisez la créature blanche ciblée.\', \'type\': \'Créature : chevalier\', \'flavor\': "« N\'attendez rien de lui si ce n\'est veulerie, flatterie et mensonges. Et ne lui tournez jamais le dos. » — Le Paladin du Nord.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184226&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cd24491b-d424-4a69-8acf-7dfd9e8d05da\', \'multiverseId\': 184226}, \'multiverseid\': 184226}, {\'name\': \'西の聖騎士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eb8b7645-7514-47ba-9938-80c400ac0662\'}, \'multiverseid\': None}, {\'name\': \'Paladino do Oeste\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'16590853-99f3-4cc1-8021-26619e29c7bc\'}, \'multiverseid\': None}]', '[{\'name\': \'Paradiesvögel\', \'text\': \'Fliegend{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182871&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'98c65950-1553-4486-a2bd-babe6f2895e6\', \'multiverseId\': 182871}, \'multiverseid\': 182871}, {\'name\': \'Aves del paraíso\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'67fb5b59-b88d-41cc-b100-304463d42171\'}, \'multiverseid\': None}, {\'name\': \'Oiseaux de paradis\', \'text\': "Vol\\n{T}: Ajoutez un mana d\'une couleur de votre choix à votre réserve.", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184287&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dfc55c9e-00c9-4b1f-99a1-d05bdcead009\', \'multiverseId\': 184287}, \'multiverseid\': 184287}, {\'name\': \'極楽鳥\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8999043d-ecba-464f-9ad0-d2d1dddc8e33\'}, \'multiverseid\': None}, {\'name\': \'Aves do Paraíso\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b74d8629-1468-42f7-8420-b1b8a4d191c0\'}, \'multiverseid\': None}]', '[{\'name\': \'Pariah\', \'text\': \'Aller Schaden, der dir zugefügt würde, wird stattdessen der verzauberten Kreatur zugefügt.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'Eines tapferen Kriegers Leben hat ohne Ehre keinen Sinn.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182670&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34a1e3a5-f5b3-4e49-8365-3f0d3c9457a1\', \'multiverseId\': 182670}, \'multiverseid\': 182670}, {\'name\': \'Paria\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9930ab6a-d901-4d3d-b0a4-a703f4dc6df9\'}, \'multiverseid\': None}, {\'name\': \'Paria\', \'text\': \'Toutes les blessures qui devraient vous être infligées sont infligées à la créature enchantée à la place.\', \'type\': \'Enchanter : créature\', \'flavor\': "« Ainsi qu\'un paria, Il erra tout le jour (…) » — Victor Hugo, les Rayons et les Ombres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184086&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b8aaf92d-d1ab-47c9-a947-8960d6c74ef1\', \'multiverseId\': 184086}, \'multiverseid\': 184086}, {\'name\': \'最下層民\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ab2f4ef-5494-4eb9-a41e-f0ada229fa2f\'}, \'multiverseid\': None}, {\'name\': \'Pária\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad78c938-8e08-44ba-8272-f74b11b66e29\'}, \'multiverseid\': None}]', '[{\'name\': \'Patagiagolem\', \'text\': \'{3}: Der Patagiagolem erhält Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Eigentlich waren seine Flügel nur als Zierde gedacht, aber er lernte schnell, sie auch zu nutzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182950&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20840e17-29e3-44fc-b69e-9c91624651a3\', \'multiverseId\': 182950}, \'multiverseid\': 182950}, {\'name\': \'Gólem membranoso\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86ebe98d-0658-4e10-96a0-5f917dbf5255\'}, \'multiverseid\': None}, {\'name\': \'Golem à patagia\', \'text\': "{3}: Le Golem à patagia acquiert le vol jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : golem\', \'flavor\': "Ses ailes n\'étaient à l\'origine qu\'ornementales, mais il a appris à s\'en servir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184366&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8ddd7b87-eaf4-40a9-aa47-33dae58b568c\', \'multiverseId\': 184366}, \'multiverseid\': 184366}, {\'name\': \'翼膜のゴーレム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68c3fa75-7fb3-4ef9-b3cd-bbd067fc8a02\'}, \'multiverseid\': None}, {\'name\': \'Golem com Patágio\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'908e1a40-6eef-459b-9048-1c740341f503\'}, \'multiverseid\': None}]', '[{\'name\': \'Pazifismus\', \'text\': \'Die verzauberte Kreatur kann nicht angreifen oder blocken.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'Ohne Krieger kann es keinen Krieg geben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182669&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f32c575b-0a3e-4621-94de-2f221a492afa\', \'multiverseId\': 182669}, \'multiverseid\': 182669}, {\'name\': \'Pacifismo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50cc4678-b19e-4f42-9f4c-f521cf033007\'}, \'multiverseid\': None}, {\'name\': \'Pacifisme\', \'text\': \'La créature enchantée ne peut ni attaquer ni bloquer.\', \'type\': \'Enchanter : créature\', \'flavor\': "Sans guerriers il n\'y a pas de guerre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184085&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed6d3320-e69f-4fc4-8cfd-8dd748245157\', \'multiverseId\': 184085}, \'multiverseid\': 184085}, {\'name\': \'平和な心\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'32b50c2d-5c46-4ede-8837-8251720d2091\'}, \'multiverseid\': None}, {\'name\': \'Pacifismo\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b308e1e2-9d8d-4d6e-963f-a90c42fda675\'}, \'multiverseid\': None}]', '[{\'name\': \'Phantomkrieger\', \'text\': \'Der Phantomkrieger ist unblockbar.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'Er kann durch feste Materie schlüpfen — aber nimm niemals an, er sei harmlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'44a2a021-44b5-4ce3-af89-69c68cab0618\', \'multiverseId\': 182733}, \'multiverseid\': 182733}, {\'name\': \'Guerrero fantasmal\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f550b56-4dc3-4034-bfb8-1d93fd2e3ba3\'}, \'multiverseid\': None}, {\'name\': \'Guerrier fantomatique\', \'text\': \'Le Guerrier fantomatique est imblocable.\', \'type\': \'Créature : illusion\', \'flavor\': "Je peux passer à travers la matière, mais cela ne veut pas dire que c\'est sans danger.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184149&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f2fd6b5-920b-46b7-a4c9-2c13d0354c49\', \'multiverseId\': 184149}, \'multiverseid\': 184149}, {\'name\': \'幻影の戦士\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29b592f2-cadd-4cac-93be-a8c2fb06cbaf\'}, \'multiverseid\': None}, {\'name\': \'Guerreiro Fantasma\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'755db834-a9f8-4cf2-908f-63c50dbe8e2f\'}, \'multiverseid\': None}]', "[{'name': 'Phyrexianischer Koloss', 'text': 'Der Phyrexianische Koloss enttappt nicht während deines Enttappsegments.\\nBezahle 8 Lebenspunkte: Enttappe den Phyrexianischen Koloss.\\nDer Phyrexianische Koloss kann nicht von weniger als drei Kreaturen geblockt werden.', 'type': 'Artefaktkreatur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182951&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b8b6b374-fc8e-45c5-9747-a2c94d1d0195', 'multiverseId': 182951}, 'multiverseid': 182951}, {'name': 'Coloso pirexiano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '65295c66-7a57-43a9-90fc-9672f4714610'}, 'multiverseid': None}, {'name': 'Colosse phyrexian', 'text': 'Le Colosse phyrexian ne se dégage pas pendant votre étape de dégagement.\\nPayez 8 points de vie : Dégagez le Colosse phyrexian.\\nLe Colosse phyrexian ne peut pas être bloqué excepté par trois créatures ou plus.', 'type': 'Créature-artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184367&type=card', 'language': 'French', 'identifiers': {'scryfallId': '780a2696-fbd1-44a3-a1c8-b3f64da95855', 'multiverseId': 184367}, 'multiverseid': 184367}, {'name': 'ファイレクシアの巨像', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ba239ffd-6c18-43ff-9add-1c3a6d3aad04'}, 'multiverseid': None}, {'name': 'Colosso Phyrexiano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ea0478ac-6b7a-44bd-a4e7-0b6d4c7b5bc8'}, 'multiverseid': None}]", '[{\'name\': \'Phyrexianischer Moloch\', \'type\': \'Artefaktkreatur\', \'flavor\': \'Er denkt nicht nach. Er fühlt auch nichts. Er weint nie oder lacht. Früh fängt er mit dem Töten an, Was er bis abends macht. —Oneanischer Kinderreim\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182952&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7002f3a-35b7-4e89-be55-481722a724b7\', \'multiverseId\': 182952}, \'multiverseid\': 182952}, {\'name\': \'Titán pirexiano\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc20bcc2-2e04-4208-acde-6e0a1cb9106d\'}, \'multiverseid\': None}, {\'name\': \'Carcasse phyrexiane\', \'type\': \'Créature-artefact\', \'flavor\': "Il ne pense pas. Il ne sent pas. Il ne pleure et ne rit pas. Tout ce qu\'il fait, matin ou soir C\'est de jouer l\'aplatissoir. — Comptine onéane.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184368&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f69f5cc5-f7ff-4532-bb15-2f9d5569bc5b\', \'multiverseId\': 184368}, \'multiverseid\': 184368}, {\'name\': \'ファイレクシアの大男\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bba5173d-dc75-4ec1-a59f-0a42d46431e2\'}, \'multiverseid\': None}, {\'name\': \'Brutamontes Phyrexiano\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bad499ad-d39d-48b1-88da-71c23887bba0\'}, \'multiverseid\': None}]', '[{\'name\': \'Plötzlicher Aufprall\', \'text\': \'Der Plötzliche Aufprall fügt einem Spieler deiner Wahl Schadenspunkte in Höhe der Anzahl an Karten auf seiner Hand zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Auf der falschen Hand erwischt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182863&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9082740b-f394-4317-b0b0-896e437169dd\', \'multiverseId\': 182863}, \'multiverseid\': 182863}, {\'name\': \'Impacto súbito\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf776a6c-78d3-4dc6-8664-b4908a4f6479\'}, \'multiverseid\': None}, {\'name\': \'Choc soudain\', \'text\': \'Le Choc soudain inflige au joueur ciblé un nombre de blessures égal au nombre de cartes dans la main de ce joueur.\', \'type\': \'Éphémère\', \'flavor\': "C\'est le jeu de la main chaude.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184279&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92a9ac07-29f1-4635-93db-baee333b41a9\', \'multiverseId\': 184279}, \'multiverseid\': 184279}, {\'name\': \'突然の衝撃\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ea77309e-a25a-4217-a516-dd5834e91e7c\'}, \'multiverseid\': None}, {\'name\': \'Impacto Súbito\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b05a121d-5874-460e-9ddb-934e93f0692c\'}, \'multiverseid\': None}]', "[{'name': 'Plündernde Meermänner', 'text': '{T}: Ziehe eine Karte und wirf dann eine Karte aus deiner Hand ab.', 'type': 'Kreatur — Meervolk', 'flavor': 'Wenn du eine Menge Schiffe versenkst, ist es nicht schwer, versunkene Schätze zu finden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182729&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8696aa47-114d-4a6a-9633-c1e9349c3a67', 'multiverseId': 182729}, 'multiverseid': 182729}, {'name': 'Saqueador tritón', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd5d62ac0-106a-4a2e-ba17-fa26aba7f59d'}, 'multiverseid': None}, {'name': 'Détrousseur ondin', 'text': '{T}: Piochez une carte, puis choisissez une carte et défaussez-vous en.', 'type': 'Créature : ondin', 'flavor': 'Plus vous coulez de navires, plus vous aurez de chances de trouver des trésors engloutis.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184145&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2852389c-7bed-451f-9c68-94ab22195828', 'multiverseId': 184145}, 'multiverseid': 184145}, {'name': 'マーフォークの物あさり', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '14a05608-9ed5-4e9f-b3b2-56a3b975b6ec'}, 'multiverseid': None}, {'name': 'Tritão Saqueador', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd71d748c-8258-47b0-8698-d9c968fc5d33'}, 'multiverseid': None}]", '[{\'name\': \'Plünderung\', \'text\': \'Zerstöre ein Artefakt oder ein Land deiner Wahl. Sie kann nicht regeneriert werden.\', \'type\': \'Hexerei\', \'flavor\': \'„Verbrenne ihre Hütten. Versalze ihr Land. Nichts wird überleben." —Der Paladin des Westens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182847&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7df1a478-f676-494c-be2b-0c87b15e3256\', \'multiverseId\': 182847}, \'multiverseid\': 182847}, {\'name\': \'Saqueo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db82da56-c409-40ea-a3b0-fd88cca558c8\'}, \'multiverseid\': None}, {\'name\': \'Pillage\', \'text\': "Détruisez l\'artefact ciblé ou le terrain ciblé. Il ne peut pas être régénéré.", \'type\': \'Rituel\', \'flavor\': "« Brûlez leurs maisons, salez leurs terres. Rien ne doit survivre. » — Le Paladin de l\'Ouest.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184263&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'255e258d-5124-4a40-a065-46b83ef0ab74\', \'multiverseId\': 184263}, \'multiverseid\': 184263}, {\'name\': \'略奪\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5cdfe80f-ea6d-41dc-9974-eb65af770c28\'}, \'multiverseid\': None}, {\'name\': \'Pilhagem\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4e344391-ac5f-4a32-af61-c56f3033a0ef\'}, \'multiverseid\': None}]', "[{'name': 'Purpurdiamant', 'text': 'Der Purpurdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {R}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182936&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8eb4147a-5e7f-487b-ae91-3b8b325cd603', 'multiverseId': 182936}, 'multiverseid': 182936}, {'name': 'Diamante flamígero', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'b8ea2f67-d06d-4cac-9a79-89cc442fe58c'}, 'multiverseid': None}, {'name': 'Diamant du feu', 'text': 'Le Diamant du feu arrive en jeu engagé.\\n{T} : Ajoutez {R} à votre réserve.', 'type': 'Artefact', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184352&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'af6238ae-2fd4-4e3b-83bf-add5ea47be60', 'multiverseId': 184352}, 'multiverseid': 184352}, {'name': '緋色のダイアモンド', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '44e1e21e-7519-4474-8517-4ca8bb88a3ef'}, 'multiverseid': None}, {'name': 'Diamante de Fogo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f63ef4c8-8460-46e2-8b49-d7697c3f35ad'}, 'multiverseid': None}]", '[{\'name\': \'Pyrotechnik\', \'text\': \'Pyrotechnik fügt 4 Schadenspunkte zu, deren Verteilung auf eine beliebige Anzahl an Kreaturen und/oder Spielern deiner Wahl du bestimmst.\', \'type\': \'Hexerei\', \'flavor\': \'„Wer hat gesagt, dass der Blitz nie zweimal zuschlägt?" —Sturmschamane\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182850&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a0e9e00c-66ec-42fe-b5c2-2a5b006c1bd6\', \'multiverseId\': 182850}, \'multiverseid\': 182850}, {\'name\': \'Pirotecnia\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f4a10a5c-e62b-4de8-84b7-ded9ada5c88d\'}, \'multiverseid\': None}, {\'name\': \'Pyrotechnie\', \'text\': \'La Pyrotechnie inflige 4 blessures réparties de la manière que vous choisissez parmi un nombre quelconque de cibles, créatures et/ou joueurs.\', \'type\': \'Rituel\', \'flavor\': "« Qui a dit que l\'éclair ne frappait jamais deux fois la même cible ? » — Une shamane de l\'orage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184266&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'016f8a87-cd91-4ea1-81a6-d9eb7608e7a5\', \'multiverseId\': 184266}, \'multiverseid\': 184266}, {\'name\': \'発火\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9a58377-d2f9-4d8c-8075-efba21d6e93e\'}, \'multiverseid\': None}, {\'name\': \'Pirotécnica\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f9a4d712-d5a0-40d7-8e56-bdfae477d723\'}, \'multiverseid\': None}]', '[{\'name\': \'Rache\', \'text\': \'Zerstöre eine getappte Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'„Es ist die Pflicht der Starken, denen gegenüberzutreten, die die Schwachen bedrohen." —Der Paladin des Südens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a85da35-6e1c-410e-8c2d-01594eff7309\', \'multiverseId\': 182694}, \'multiverseid\': 182694}, {\'name\': \'Venganza\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bf5e5a79-4347-4e5c-9435-06e0135582c4\'}, \'multiverseid\': None}, {\'name\': \'Vengeance\', \'text\': \'Détruisez la créature engagée ciblée.\', \'type\': \'Rituel\', \'flavor\': "« C\'est le devoir des forts que de protéger les faibles. » —Le Paladin du Sud.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184110&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ebf21b1-c734-4f92-9015-1d903a803ef6\', \'multiverseId\': 184110}, \'multiverseid\': 184110}, {\'name\': \'復讐\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'91bd7733-3c42-4152-b2c4-ad21b482f941\'}, \'multiverseid\': None}, {\'name\': \'Vingança\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a7a600c-8876-4035-981d-6b34edc06a4d\'}, \'multiverseid\': None}]', "[{'name': 'Rasiermesserklauen-Greif', 'text': 'Fliegend, Erstschlag', 'type': 'Kreatur — Greif', 'flavor': 'Wie ein Meteor stürzt er ohne Warnung von oben auf dich herab. Anders als ein Meteor trägt er dich davon und frisst dich auf.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182672&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4b43bb4e-1c98-4bcd-8cf7-964df2023957', 'multiverseId': 182672}, 'multiverseid': 182672}, {'name': 'Grifo pienavaja', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '62edd7ba-beed-48f7-a295-3888cbf9c00e'}, 'multiverseid': None}, {'name': 'Griffon serres-rasoir', 'text': 'Vol, initiative', 'type': 'Créature : griffon', 'flavor': 'Comme un éclair il fond sur vous. Mais un éclair ne vous déchire pas pour vous dévorer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184088&type=card', 'language': 'French', 'identifiers': {'scryfallId': '65690a62-5e3e-45af-b99c-b4c588b2c585', 'multiverseId': 184088}, 'multiverseid': 184088}, {'name': 'カミソリ足のグリフィン', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c34eeabf-956b-4990-aae0-2a3dda97d567'}, 'multiverseid': None}, {'name': 'Grifo Garra-de-Navalha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'afc1c645-48f0-4b7b-949c-97bb6fa3b0b4'}, 'multiverseid': None}]", '[{\'name\': \'Reflexe\', \'text\': \'Die verzauberte Kreatur hat Erstschlag.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Sei so schnell wie der Blitz, und du wirst genauso tödlich sein." —Kampftrainer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182853&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5bb946ea-5edf-4efc-9dd1-a9579eeba5c7\', \'multiverseId\': 182853}, \'multiverseid\': 182853}, {\'name\': \'Reflejos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d871cec6-3932-42af-9601-ade119e48e39\'}, \'multiverseid\': None}, {\'name\': \'Réflexes\', \'text\': "La créature enchantée a l\'initiative.", \'type\': \'Enchanter : créature\', \'flavor\': "« Soyez rapide comme l\'éclair, vous serez dangereux comme l\'éclair. » — Un entraîneur de combat.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184269&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'049e9a7a-e11c-4620-aa84-420772076dbd\', \'multiverseId\': 184269}, \'multiverseid\': 184269}, {\'name\': \'速やかな反応\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ddaec80e-9e9d-4732-8a20-4400d6eb13d9\'}, \'multiverseid\': None}, {\'name\': \'Reflexos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ef1d72e3-cab1-4283-8b2a-c152eab12d47\'}, \'multiverseid\': None}]', '[{\'name\': \'Regeneration\', \'text\': \'{G}: Regeneriere die verzauberte Kreatur.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Warum sollte der Tod immer das letzte Wort haben?" —Llanowardruide\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182905&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'337bf5c4-2ea2-4b0d-baa9-12569b5c5ebe\', \'multiverseId\': 182905}, \'multiverseid\': 182905}, {\'name\': \'Regeneración\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6b4bf280-be6f-4270-bc2c-216f1ed96bb2\'}, \'multiverseid\': None}, {\'name\': \'Régénération\', \'text\': \'{G}: Régénérez la créature enchantée.\', \'type\': \'Enchanter : créature\', \'flavor\': \'« Pourquoi la mort aurait-elle le dernier mot ? » — Un druide de la Llanowar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1392afb8-1d19-43a5-8d5c-0fbc2e4f918e\', \'multiverseId\': 184321}, \'multiverseid\': 184321}, {\'name\': \'再生\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'497f4a4f-ef21-4dfb-acda-7874c002a2d9\'}, \'multiverseid\': None}, {\'name\': \'Regeneração\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e2612ab9-7397-4ba3-ac3c-a3170034743b\'}, \'multiverseid\': None}]', '[{\'name\': \'Reinigung\', \'text\': \'Zerstöre alle Artefakte und Verzauberungen.\', \'type\': \'Hexerei\', \'flavor\': \'„Wir können diesen Plunder nicht gebrauchen. Wir brauchen nur die Stärke unserer Schwerter und die Tugend unserer Herzen." —Der Paladin des Nordens\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182671&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fe3341f9-ee6a-4f71-8799-4e52a5d0bb57\', \'multiverseId\': 182671}, \'multiverseid\': 182671}, {\'name\': \'Purificar\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dd0a1c09-d10e-448d-b433-79044b6a5644\'}, \'multiverseid\': None}, {\'name\': \'Purification\', \'text\': \'Détruisez tous les artefacts et tous les enchantements.\', \'type\': \'Rituel\', \'flavor\': "« Nous n\'avons que faire de fétiches. Nous suffisent la force de nos épées et la vertu en nos cœurs. » — Le Paladin du Nord.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184087&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca1fc802-da7b-4a78-84e6-f4ba33789314\', \'multiverseId\': 184087}, \'multiverseid\': 184087}, {\'name\': \'浄化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ace5e105-6107-4362-b58c-a9d0758354d2\'}, \'multiverseid\': None}, {\'name\': \'Purificar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93c7d695-2478-4e66-936c-28c4fcdd6a6b\'}, \'multiverseid\': None}]', "[{'name': 'Revolte der Natur', 'text': 'Alle Länder sind 2/2 Kreaturen, die immer noch auch Länder sind.', 'type': 'Verzauberung', 'flavor': 'Das Land erhebt sich, um sich gegen die zu verteidigen, die seine Schönheit verderben wollen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182900&type=card', 'language': 'German', 'identifiers': {'scryfallId': '53ea10a6-b6d1-497b-ab38-13b9e60e59e6', 'multiverseId': 182900}, 'multiverseid': 182900}, {'name': 'Rebelión de la naturaleza', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'dad4a2d4-0163-4356-a5a8-954311eb5cdb'}, 'multiverseid': None}, {'name': 'Révolte de la nature', 'text': 'Tous les terrains sont des créatures 2/2 qui sont toujours des terrains.', 'type': 'Enchantement', 'flavor': 'La terre se lèvera pour se défendre contre ceux qui voudront altérer sa beauté.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184316&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'df8f373a-6d79-40dc-add3-d7bc29b934c6', 'multiverseId': 184316}, 'multiverseid': 184316}, {'name': '自然の反乱', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '64815a46-db10-4d37-97b2-5f17ba607159'}, 'multiverseid': None}, {'name': 'Revolta da Natureza', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '254fc882-29c5-4b29-acbd-ad232b75e86a'}, 'multiverseid': None}]", '[{\'name\': \'Revolte\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit Stärke 4 oder gößer. Diese kann nicht regeneriert werden.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Keine Angst mehr deswegen"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182673&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d9b5a40-e784-4658-8aec-6cec2f95f654\', \'multiverseId\': 182673}, \'multiverseid\': 182673}, {\'name\': \'Represalia\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3497a688-820b-4f09-b5fe-ca15073c5cec\'}, \'multiverseid\': None}, {\'name\': \'Représailles\', \'text\': \'Détruisez la créature ciblée dont la force vaut 4 ou plus. Elle ne peut pas être régénérée.\', \'type\': \'Éphémère\', \'flavor\': "« N\'ayez plus peur »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184089&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'10302d4a-4b39-44ef-82a7-2d064d3408cb\', \'multiverseId\': 184089}, \'multiverseid\': 184089}, {\'name\': \'復仇\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b4a42c02-bf32-4d86-bbd1-36a7d8aa8184\'}, \'multiverseid\': None}, {\'name\': \'Represália\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'316aca32-7daa-4af9-8685-6791312944dd\'}, \'multiverseid\': None}]', '[{\'name\': \'Riesenoktopus\', \'type\': \'Kreatur — Oktopus\', \'flavor\': \'Das einzige, was schneller als Wasser fließt, ist die Furcht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182717&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47365552-ca3c-4088-bd70-e8e86f90ad11\', \'multiverseId\': 182717}, \'multiverseid\': 182717}, {\'name\': \'Pulpo gigante\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b60c94ee-ed9b-41fd-afde-0f11d2f0c28f\'}, \'multiverseid\': None}, {\'name\': \'Pieuvre géante\', \'type\': \'Créature : pieuvre\', \'flavor\': "La peur vous envahit plus vite que l\'eau ne s\'écoule.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184133&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6e897dd-b01f-4a11-929c-697428c65335\', \'multiverseId\': 184133}, \'multiverseid\': 184133}, {\'name\': \'大ダコ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d80c43f-a309-4cf6-9e0b-d5725136d17a\'}, \'multiverseid\': None}, {\'name\': \'Polvo Gigante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1b07730e-3515-4936-a750-cd36ad52ebe6\'}, \'multiverseid\': None}]', "[{'name': 'Riesenschabe', 'type': 'Kreatur — Insekt', 'flavor': 'Toren war im Laufe seines Lebens schon auf eine Menge Käfer getreten. Daher war es etwas schockierend für ihn, als plötzlich ein Käfer ihn zertrat.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182778&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8bf100f2-30cd-4c86-9c3e-ee5f49f2377a', 'multiverseId': 182778}, 'multiverseid': 182778}, {'name': 'Cucaracha gigante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c445d6f0-400f-49b1-bbd1-1f0d02042dca'}, 'multiverseid': None}, {'name': 'Cafard géant', 'type': 'Créature : insecte', 'flavor': 'Toren avait souvent écrasé des insectes. Maintenant il recevait la monnaie de sa pièce.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184194&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e5329927-d6d3-4092-8642-cc5513bc9a1e', 'multiverseId': 184194}, 'multiverseid': 184194}, {'name': '巨大ゴキブリ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '1e1cea9b-34ef-4bb3-bd74-cc406b33a2fe'}, 'multiverseid': None}, {'name': 'Barata Gigante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '222effca-0d93-4b35-8bc3-c10270261a04'}, 'multiverseid': None}]", '[{\'name\': \'Riesenspinne\', \'text\': \'Die Riesenspinne kann blocken, als ob sie Flugfähigkeit hätte.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Das Spinnennetz beobachten —Llanowar-Ausdruck für „auf das Falsche konzentrieren"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182889&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea667d09-3c39-4aab-81b3-facc2dd201d6\', \'multiverseId\': 182889}, \'multiverseid\': 182889}, {\'name\': \'Araña gigante\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b5743486-dd4c-44a5-8b26-3b136f52721e\'}, \'multiverseid\': None}, {\'name\': \'Araignée géante\', \'text\': "L\'Araignée géante peut bloquer comme si elle avait le vol.", \'type\': \'Créature : araignée\', \'flavor\': "Regarder la toile de l\'araignée —Expression de la Llanowar signifiant « regarder dans la mauvaise direction »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184305&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c4d79c10-777e-488e-b607-e194da7d87bc\', \'multiverseId\': 184305}, \'multiverseid\': 184305}, {\'name\': \'大蜘蛛\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75bec281-f704-4045-b43e-b7aa4c87f762\'}, \'multiverseid\': None}, {\'name\': \'Aranha Gigante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63052d2d-c98f-4319-a31e-cd89609197b9\'}, \'multiverseid\': None}]', '[{\'name\': \'Riesenwuchs\', \'text\': \'Eine Kreatur deiner Wahl erhält +3/+3 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182888&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6133973b-1f2f-4950-867c-55cc3f4cc7e6\', \'multiverseId\': 182888}, \'multiverseid\': 182888}, {\'name\': \'Crecimiento gigante\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'040d3613-f379-456d-98c3-7b17d008350b\'}, \'multiverseid\': None}, {\'name\': \'Croissance gigantesque\', \'text\': "La créature ciblée gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184304&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7179b356-f0aa-4fc3-a929-35dd6bf311d9\', \'multiverseId\': 184304}, \'multiverseid\': 184304}, {\'name\': \'巨大化\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d7cbed53-4349-4d24-955d-858b9747e4da\'}, \'multiverseid\': None}, {\'name\': \'Crescimento Desenfreado\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a87e4392-f26a-41bb-9e25-310c8254e4cb\'}, \'multiverseid\': None}]', '[{\'name\': \'Ritterschaft\', \'text\': \'Alle Kreaturen, die du kontrollierst, haben Erstschlag.\', \'type\': \'Verzauberung\', \'flavor\': \'Nicht Könige erzeugen Ritter, sondern Heldentaten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182665&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'72f7ce87-836b-4917-a7ef-30923dc449d4\', \'multiverseId\': 182665}, \'multiverseid\': 182665}, {\'name\': \'Caballería\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8f3f88f5-365f-4c6d-85a9-08fde9c9786a\'}, \'multiverseid\': None}, {\'name\': \'Chevalerie\', \'text\': "Les créatures que vous contrôlez acquièrent l\'initiative.", \'type\': \'Enchantement\', \'flavor\': \'Ce ne sont pas les rois qui font les chevaliers, ce sont leurs actes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184081&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'149673eb-7964-453b-80fa-2f3681ac479f\', \'multiverseId\': 184081}, \'multiverseid\': 184081}, {\'name\': \'騎士道\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ead2f557-eaf1-456e-8802-2af16b789de3\'}, \'multiverseid\': None}, {\'name\': \'Ordem de Cavalaria\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1081d71b-5083-41a8-8151-b6428095b8ae\'}, \'multiverseid\': None}]', '[{\'name\': \'Rotwildherde\', \'text\': \'Immer wenn die Rotwildherde geblockt wird, erhält sie +2/+2 für jede Kreatur, die sie blockt.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'„Ich fühlte die Erde erzittern, daher versteckte ich mich in meinem Zelt, bis das Erdbeben vorbei war. Es ging vorüber, und es hinterließ Hufspuren." —Femerefspäher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182887&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f97b5c0-5045-498b-aab1-b9d993191b00\', \'multiverseId\': 182887}, \'multiverseid\': 182887}, {\'name\': \'Manada de alces\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'39a17789-0413-4a4a-a2e2-a2b9f424a4e1\'}, \'multiverseid\': None}, {\'name\': \'Groupe de wapitis\', \'text\': "À chaque fois que le Groupe de wapitis devient bloqué, il gagne +2/+2 jusqu\'à la fin du tour pour chaque créature qui le bloque.", \'type\': \'Créature : bête\', \'flavor\': "« J\'ai senti le sol trembler et je me suis réfugié dans ma tente le temps que le tremblement de terre se finisse. En sortant j\'ai vu des traces de sabots. » — Un explorateur fémeiref.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f08af3d7-5a41-4c60-9130-e227a07b7d85\', \'multiverseId\': 184303}, \'multiverseid\': 184303}, {\'name\': \'大鹿の一団\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0b1ee972-1089-4509-a06b-b25356c490d5\'}, \'multiverseid\': None}, {\'name\': \'Manada de Alces\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3452884-9655-4158-bb21-11718c5b38ea\'}, \'multiverseid\': None}]', "[{'name': 'Rückruf', 'text': 'Bringe eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182748&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a367d67a-e671-4605-bb08-311a32a2e1fc', 'multiverseId': 182748}, 'multiverseid': 182748}, {'name': 'Anular invocación', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8dde8cce-d007-46eb-a075-19e2a93e6951'}, 'multiverseid': None}, {'name': 'Désinvocation', 'text': 'Renvoyez la créature ciblée dans la main de son propriétaire.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184164&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a2796aea-8814-40d2-98e6-4a67fca6202c', 'multiverseId': 184164}, 'multiverseid': 184164}, {'name': '送還', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9cdadb4f-0e5b-4322-8de8-023171d61bab'}, 'multiverseid': None}, {'name': 'Esconjurar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd3f0698d-0ab7-49c6-8806-f560e9f4269c'}, 'multiverseid': None}]", "[{'name': 'Scharfzahnratten', 'text': 'Scharfzahnratten können nur von schwarzen und/oder Artefaktkreaturen geblockt werden.', 'type': 'Kreatur — Ratte', 'flavor': 'Sie nagen sich durch Rüstung, Fleisch und Knochen. Sie nagen sich sogar gegenseitig durch, wenn sie hungrig genug sind.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182798&type=card', 'language': 'German', 'identifiers': {'scryfallId': '634da7f1-1a7e-4a5b-acae-f18e2e8dbc92', 'multiverseId': 182798}, 'multiverseid': 182798}, {'name': 'Ratas voraces', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1ebdf5de-a45f-4f26-8c8c-460089f7dd4f'}, 'multiverseid': None}, {'name': 'Rats aux dents tranchantes', 'text': 'Ces Rats aux dents tranchantes ne peuvent pas être bloqués excepté par des créatures-artefacts ou des créatures noires.', 'type': 'Créature : rat', 'flavor': 'Ils mordent à travers armures, chairs et os. Ils se mordent aussi les uns les autres.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184214&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c46b86cd-e0d4-4de7-86ec-88a3e4698fbe', 'multiverseId': 184214}, 'multiverseid': 184214}, {'name': 'カミソリネズミ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '70a22c4c-3942-4788-90f6-83de7bce3dae'}, 'multiverseid': None}, {'name': 'Ratos de Dentes Navalhados', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e953db2b-f49b-4bef-b8c0-52db95a708e6'}, 'multiverseid': None}]", '[{\'name\': \'Schatzhort\', \'text\': \'{2}{U}{U}: Ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'„Nö, hier ist auch nix. Geht doch schon mal vor, ich komm\\\' in einer Minute nach... Juhu"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aa090552-a4eb-4497-a9bd-cf40d3869f86\', \'multiverseId\': 182746}, \'multiverseid\': 182746}, {\'name\': \'Descubrimiento del tesoro\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'32e35067-aafc-46af-a6f9-83a6502da6d2\'}, \'multiverseid\': None}, {\'name\': \'Caverne au trésor\', \'text\': \'{2}{U}{U}: Piochez une carte.\', \'type\': \'Enchantement\', \'flavor\': "« Non, il n\'y a rien ici, vous pouvez partir les gars, je vous rejoins dans une minute… Ouaouhh »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184162&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'357f9a89-23fc-4a60-9398-628b73622834\', \'multiverseId\': 184162}, \'multiverseid\': 184162}, {\'name\': \'貴重な収集品\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6c9c0f9d-6e73-4fc6-bf9d-7478b73eea6e\'}, \'multiverseid\': None}, {\'name\': \'Reintegração do Tesouro\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'06ef0aee-8e14-49c8-b7da-c51823c36ece\'}, \'multiverseid\': None}]', '[{\'name\': \'Scheinheiligkeit\', \'text\': \'Immer wenn ein Gegner ein Gebirge für Mana tappt, kannst du einen Lebenspunkt dazuerhalten.\', \'type\': \'Verzauberung\', \'flavor\': \'„Die Bauern arbeiten in meine Tasche. Ich erkenne das an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'794b2f85-aeae-4860-9d98-8d14f3aba4a4\', \'multiverseId\': 182679}, \'multiverseid\': 182679}, {\'name\': \'Santurronería\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0f3f02fb-3c39-4ede-9a03-92873a4e835f\'}, \'multiverseid\': None}, {\'name\': \'Tartuferie\', \'text\': "À chaque fois que l\'un de vos adversaires engage une montagne pour du mana, vous pouvez gagner 1 point de vie.", \'type\': \'Enchantement\', \'flavor\': "« Certains prient, d\'autres travaillent. Tel est l\'ordre de la nature. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184095&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a88d9b34-bc52-49fc-a110-9a8702512bd6\', \'multiverseId\': 184095}, \'multiverseid\': 184095}, {\'name\': \'偽の信心\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'408a0d17-016b-4309-8d1d-1714b454cdc9\'}, 