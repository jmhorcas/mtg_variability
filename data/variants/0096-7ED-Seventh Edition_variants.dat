imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182866&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f49c0358-de77-4b2d-9a4a-2e29d1a5cdd8', 'multiverseId': 182866}, 'multiverseid': 182866}, {'name': 'Martillo volcánico', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6337ba8c-3e9f-4943-a139-5ad6f9da9701'}, 'multiverseid': None}, {'name': 'Marteau volcanique', 'text': 'Le Marteau volcanique inflige 3 blessures à une cible, créature ou joueur.', 'type': 'Rituel', 'flavor': 'Le feu prend forme au fond de la forge.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184282&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4f4afe54-3387-40d9-86fd-d9b530af203f', 'multiverseId': 184282}, 'multiverseid': 184282}, {'name': '火山の鎚', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'a6e3e511-a5d6-4b37-b3c4-e5252802200b'}, 'multiverseid': None}, {'name': 'Martelo Vulcânico', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '47640c51-96ba-4184-8730-e0d6589d07d3'}, 'multiverseid': None}]", "[{'name': 'Wachsamer Sceada', 'text': 'Fliegend\\n{2}{U}: Enttappe den Wachsamen Sceada', 'type': 'Kreatur — Sceada', 'flavor': 'Er kann wochenlang in der Luft bleiben, mit wenig oder gar keinem Schlaf.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182749&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd626d227-bfed-4356-ad96-480e602993a7', 'multiverseId': 182749}, 'multiverseid': 182749}, {'name': 'Draco vigilante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd8f630c2-42ae-48fc-9714-9e7bcdf1916b'}, 'multiverseid': None}, {'name': 'Drakôn vigilant', 'text': 'Vol\\n{2}{U}: Dégagez le Drakôn vigilant.', 'type': 'Créature : drakôn', 'flavor': 'Il peut rester éveillé des semaines durant.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184165&type=card', 'language': 'French', 'identifiers': {'scryfallId': '950fe3d9-5114-4113-b48f-491d6f5a53a2', 'multiverseId': 184165}, 'multiverseid': 184165}, {'name': '用心深いドレイク', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '09a5c854-7e28-42e7-b7c5-5670c7fa34e1'}, 'multiverseid': None}, {'name': 'Dragonete Vigilante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'befca2a6-bc0e-4086-a401-888fb788d40d'}, 'multiverseid': None}]", '[{\'name\': \'Waffenrock\', \'text\': \'Jede Kreatur erhält +1/+1 für jede andere Kreatur im Spiel, mit der sie einen Kreaturentyp teilt. (Wenn zum Beispiel drei Goblins im Spiel sind, erhalten alle +2/+2.)\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182930&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6bd3f847-56fc-4ae1-8c2a-bcd16401e0f4\', \'multiverseId\': 182930}, \'multiverseid\': 182930}, {\'name\': \'Escudo de armas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7ba51aed-0ad4-46f2-9c2a-006a43589725\'}, \'multiverseid\': None}, {\'name\': \'Blason\', \'text\': "Chaque créature gagne +1/+1 pour chaque autre créature en jeu qui partage un type de créature avec elle. (Par exemple, s\'il y a trois gobelins en jeu, chacun d\'eux gagne +2/+2.)", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a2e3f74e-9f45-4277-9802-a5a50e16aa71\', \'multiverseId\': 184346}, \'multiverseid\': 184346}, {\'name\': \'旗印\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9c638450-a393-462c-a9b9-f7c617c9c7bc\'}, \'multiverseid\': None}, {\'name\': \'Escudo de Armas\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e0aa6a6d-9c4c-41e7-aeb0-1