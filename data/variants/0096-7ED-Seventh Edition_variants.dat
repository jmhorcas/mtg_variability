 182677}, \'multiverseid\': 182677}, {\'name\': \'Néctar sagrado\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d658b02a-ef33-41c5-8bbd-1d6e2f4d8fd2\'}, \'multiverseid\': None}, {\'name\': \'Nectar sacré\', \'text\': \'Vous gagnez 4 points de vie.\', \'type\': \'Rituel\', \'flavor\': "« Pourtant, sous la tutelle invisible d\'un Ange, L\'Enfant déshérité s\'enivre de soleil Et dans tout ce qu\'il boit et dans tout ce qu\'il mange Retrouve l\'ambroisie et le nectar vermeil. » — Baudelaire, Les Fleurs du Mal.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184093&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7cd5dc7c-dc5a-4e18-9e43-725e87a53204\', \'multiverseId\': 184093}, \'multiverseid\': 184093}, {\'name\': \'聖なる蜜\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'386dc6b0-dec1-4c82-b973-6293622590f3\'}, \'multiverseid\': None}, {\'name\': \'Nectar Sagrado\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8dc084b1-860f-4043-bac5-19c30d1f1a85\'}, \'multiverseid\': None}]', '[{\'name\': \'Heißblütige Miliz\', \'text\': \'Die Heißblütige Miliz wird beim Angreifen nicht getappt.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Ritter kämpfen für Ehre, Söldner für Gold. Die Miliz jedoch kämpft nur für Heim und Herd.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc556971-69e8-45e3-b389-ad8111e10718\', \'multiverseId\': 182642}, \'multiverseid\': 182642}, {\'name\': \'Milicianos ardorosos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15fcbdf3-2bcc-43cc-83a4-072427c971e1\'}, \'multiverseid\': None}, {\'name\': \'Milice ardente\', \'text\': "Attaquer avec la Milice ardente ne la fait pas s\'engager.", \'type\': \'Créature : soldat\', \'flavor\': "Certains se battent pour l\'honneur, d\'autres pour l\'or. La milice se bat pour sa terre et sa maison.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184058&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9982ac8f-829b-48f0-a685-1d9681ebd4a8\', \'multiverseId\': 184058}, \'multiverseid\': 184058}, {\'name\': \'献身的民兵団\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7a71a2f6-4644-48ea-9388-d1c6b5f5d1c1\'}, \'multiverseid\': None}, {\'name\': \'Milícia Fervorosa\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'47a41585-4081-48a0-9e5b-7e2dcdfcfa36\'}, \'multiverseid\': None}]', "[{'name': 'Heiße Glut', 'text': 'Heiße Glut fügt einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Das Feuer stirbt nie alleine.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182815&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f9894865-d009-44dc-be65-67a12299dbb5', 'multiverseId': 182815}, 'multiverseid': 182815}, {'name': 'Llamarada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '23d5b141-103f-44ad-9dce-46c19eccd0b2'}, 'multiverseid': None}, {'name': 'Brasier', 'text': 'Le Brasier inflige X blessures à une cible, créature ou joueur.', 'type': 'Rituel', 'flavor': 'Le feu ne meurt jamais seul.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184231&type=card', 'language': 'French', 'identifiers': {'scryfallId': '615f2b3e-ea82-4e13-94d2-2bef1234543c', 'multiverseId': 184231}, 'multiverseid': 184231}, {'name': '猛火', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8749fe99-fb3c-4d53-8c6f-c1dd79f0061b'}, 'multiverseid': None}, {'name': 'Labareda', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7ede9da3-f13d-4439-b763-19161d6593d5'}, 'multiverseid': None}]", '[{\'name\': \'Heulen aus dem Jenseits\', \'text\': \'Eine Kreatur deiner Wahl erhält +X/+0 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': \'Egal, ob es vor Hunger oder aus Freude heult — das Problem bleibt für dich identisch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182782&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9a5dc679-4715-418e-a327-33287ba9d0ec\', \'multiverseId\': 182782}, \'multiverseid\': 182782}, {\'name\': \'Aullido del más allá\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7da80b0e-7310-4af5-aa3d-84969db3971e\'}, \'multiverseid\': None}, {\'name\': "Rugissement de l\'au-delà", \'text\': "La créature ciblée gagne +X/+0 jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': "Qu\'il rugisse de faim ou de plaisir, cela ne présage rien de bon.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184198&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3d657f72-b6b1-438d-84d8-28f70d1e3868\', \'multiverseId\': 184198}, \'multiverseid\': 184198}, {\'name\': \'彼方からの雄叫び\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68fc441e-2447-4725-b32c-ef3d7a9cb5c7\'}, \'multiverseid\': None}, {\'name\': \'Uivo do Além\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3c297ee-0786-4eb8-88d3-28f99bd83866\'}, \'multiverseid\': None}]', "[{'name': 'Himmelsdiamant', 'text': 'Der Himmelsdiamant kommt getappt ins Spiel.\\n{T}: Erhöhe deinen Manavorrat um {U}.', 'type': 'Artefakt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182956&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c54809fb-23b9-41a8-a961-ca1257caaf04', 'multiverseId': 182956}, 'multiverseid': 182956}, {'name': 'Diamante celeste', 'flavor': None, 'language': 'Spanish', 'identifiers': {'s