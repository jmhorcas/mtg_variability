ashx?multiverseid=182683&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'783f689b-7bff-4875-8473-e5639f8d6dc6\', \'multiverseId\': 182683}, \'multiverseid\': 182683}, {\'name\': \'Abrazo de Serra\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88508b34-4ef7-449a-8638-7347ae5fac08\'}, \'multiverseid\': None}, {\'name\': \'Étreinte de Serra\', \'text\': "La créature enchantée gagne +2/+2, a le vol, et attaquer avec elle ne la fait pas s\'engager.", \'type\': \'Enchanter : créature\', \'flavor\': "« L\'ange nouveau-né prit son envol dans un souffle… et le monde retint le sien. » — Le livre de Serra.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184099&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3305f19d-eb51-46f9-9829-95b4d423641a\', \'multiverseId\': 184099}, \'multiverseid\': 184099}, {\'name\': \'セラの抱擁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92a7a4e7-2f79-4489-a7a6-012bb6b34330\'}, \'multiverseid\': None}, {\'name\': \'Abraço de Serra\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4201d7c1-7794-4953-9aeb-dc05be9b5cd9\'}, \'multiverseid\': None}]', "[{'name': 'Seuchenkäfer', 'text': 'Sumpftarnung (Diese Kreatur ist unblockbar, solange der verteidigende Spieler einen Sumpf kontrolliert.)', 'type': 'Kreatur — Insekt', 'flavor': 'Niemand weiß, ob sie nach den Seuchen, die sie verbreiten, oder nach der Geschwindigkeit ihrer Vermehrung benannt wurden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182795&type=card', 'language': 'German', 'identifiers': {'scryfallId': '451034ee-ef3d-48bd-9ca6-299a7ccb35c8', 'multiverseId': 182795}, 'multiverseid': 182795}, {'name': 'Escarabajo de la peste', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5bd9609b-ed29-4b82-8f07-234bc0925296'}, 'multiverseid': None}, {'name': 'Scarabée de la Peste', 'text': 'Traversée des marais (Cette créature est imblocable tant que le joueur défenseur contrôle au moins un marais.)', 'type': 'Créature : insecte', 'flavor': '« Dans le danger, le porc-épic se hérisse, le scarabée fait le mort (…) » — Victor Hugo, Les Misérables.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184211&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd89316bd-7c68-4004-bb9e-c9b499c23959', 'multiverseId': 184211}, 'multiverseid': 184211}, {'name': '疫病甲虫', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b5d1ba1b-e5be-423c-b1b5-d507bc70532b'}, 'multiverseid': None}, {'name': 'Besouro Pestilento', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1d24860b-d822-4cc9-95d6-f9159b187cec'}, 'multiverseid': None}]", '[{\'name\': \'Shivan-Drache\', \'text\': \'Fliegend\\n{R}: Der Shivan-Drache erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Er ist der uneingeschränkte Herrscher der shivanischen Berge.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182858&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e9ad8d1-b08f-4343-8274-8a82f781a09d\', \'multiverseId\': 182858}, \'multiverseid\': 182858}, {\'name\': \'Dragón shivano\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'989c03d1-252d-4dbe-8550-566f1e23af9c\'}, \'multiverseid\': None}, {\'name\': \'Dragon shivân\', \'text\': "Vol\\n{R}: Le Dragon shivân gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : dragon\', \'flavor\': "C\'est le maître incontesté des montagnes de Shiv.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184274&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fc65f365-2c60-4f7a-88aa-4df3c02ccd7a\', \'multiverseId\': 184274}, \'multiverseid\': 184274}, {\'name\': \'シヴ山のドラゴン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c610c9a8-3229-4366-b50f-f94a2ec256b7\'}, \'multiverseid\': None}, {\'name\': \'Dragão de Shiva\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fabae28f-130e-4b5c-95df-b71cb3feb465\'}, \'multiverseid\': None}]', '[{\'name\': \'Sisays Ring\', \'text\': \'{T}: Erhöhe deinen Manavorrat um zwei farblose Mana.\', \'type\': \'Artefakt\', \'flavor\': \'„Ich bin normalerweise nicht für hübsche Sachen," sagte Sisay, „wenn sie nicht ebenfalls hübsch nützlich sind."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182955&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8dfbcae0-50ce-4c1b-9a80-26b7e494a0b0\', \'multiverseId\': 182955}, \'multiverseid\': 182955}, {\'name\': \'Anillo de Sisay\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'762b4faf-6672-4023-a0b8-e300f65aca64\'}, \'multiverseid\': None}, {\'name\': \'Anneau de Sissay\', \'text\': \'{T}: Ajoutez deux manas incolores à votre réserve.\', \'type\': \'Artefact\', \'flavor\': "« Les jolies choses ne m\'intéressent pas », dit Sissay. « Sauf si elles sont aussi utiles.»", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184371&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca4a95d8-79dc-475b-8da0-176cfe44b277\', \'multiverseId\': 184371}, \'multiverseid\': 184371}, {\'name\': \'シッセイの指輪\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e4dadae4-7d55-45e6-8fc9-cec81a4192e8\'}, \'multiverseid\': None}, {\'name\': \'Anel de Sisay\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'43ba7bdd-8f70-41c8-886c-bdd7dfb0eb43\'}, \'multiverseid\': None}]', '[{\'name\': \'Skrupelloser Dieb\', \'text\': \'Der Skrupellose Dieb kann nicht blocken.\', \'type\': \'Kreatur — Söldner\', \'flavor\': \'Was ihm an Rückgrat fehlt, macht er durch Grausamkeit wieder wett.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182804&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71396dfd-85a2-4a1f-91d7-1dcb2eebeca5\', \'multiverseId\': 182804}, \'multiverseid\': 182804}, {\'name\': \'Malhechor cobarde\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d828d4f5-8884-4930-82cd-6ee894aece0e\'}, \'multiverseid\': None}, {\'name\': \'Étrangleur mou\', \'text\': "L\'Étrangleur mou ne peut pas bloquer.", \'type\': \'Créature : mercenaire\', \'flavor\': \'Ce qui lui manque en fermeté, il le rattrape en cruauté.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184220&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07f013ab-5ac3-40da-a9dc-47f41b2545fb\', \'multiverseId\': 184220}, \'multiverseid\': 184220}, {\'name\': \'骨なしの凶漢\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'762f8890-5110-4cba-a685-66270cd97940\'}, \'multiverseid\': None}, {\'name\': \'Rufia Vacilante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'82440139-130d-4c9f-868d-d0ddca622aa3\'}, \'multiverseid\': None}]', '[{\'name\': \'Sonnenlichtsucher\', \'text\': \'{T}: Enttappe eine Kreatur deiner Wahl.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'Sonnenlichtsucher verbringen ihr Leben damit, eine Heimat zu beschützen, die sie eigentlich nur selten sehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182908&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'920e8ad9-e156-46ed-985a-9dba0de75312\', \'multiverseId\': 182908}, \'multiverseid\': 182908}, {\'name\': \'Buscador de la luz celeste\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5914a9b0-ace1-44de-b253-a17b4b9a2492\'}, \'multiverseid\': None}, {\'name\': \'Chercheur de trouées de ciel\', \'text\': \'{T}: Dégagez la créature ciblée.\', \'type\': \'Créature : elfe\', \'flavor\': "Les chercheurs passent leurs vies à protéger une maison qu\'ils habitent peu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184324&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'032fc62f-75f1-4064-905d-9de94b5b07ab\', \'multiverseId\': 184324}, \'multiverseid\': 184324}, {\'name\': \'天光を求める者\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e6fd00d-1b83-4073-be44-38ca4529f019\'}, \'multiverseid\': None}, {\'name\': \'Perscrutador da Fenda do Céu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9647c7c-7049-4a2d-92f5-4a230de1c09d\'}, \'multiverseid\': None}]', "[{'name': 'Sonnennetz', 'text': '(Mauern können nicht angreifen.)\\nFliegend\\nDas Sonnennetz kann Kreaturen mit Stärke 2 oder weniger nicht blocken.', 'type': 'Kreatur — Mauer', 'flavor': 'Manchmal weigern sich die Flügel von gefallenen Drachen, den Himmel zu verlassen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182691&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'deda71e8-1e03-4d00-97aa-3ceff6d686a8', 'multiverseId': 182691}, 'multiverseid': 182691}, {'name': 'Telaraña solar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8243aab7-fa7c-4840-b1e7-0ef4d3e22185'}, 'multiverseid': None}, {'name': 'Toile solaire', 'text': '(Les murs ne peuvent pas attaquer.)\\nVol\\nLa Toile solaire ne peut pas bloquer les créatures dont la force est de 2 ou moins.', 'type': 'Créature : mur', 'flavor': 'Parfois, les ailes des dragons morts refusent de quitter les cieux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184107&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e0f31828-1a8c-46c5-85c0-9cad3575b276', 'multiverseId': 184107}, 'multiverseid': 184107}, {'name': '太陽の網', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'cbbcf250-0bf8-4bab-8559-f080717fbed3'}, 'multiverseid': None}, {'name': 'Teia Solar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '17838a69-f2d3-40f8-8de3-5804f380dea8'}, 'multiverseid': None}]", '[{\'name\': \'Speermauer\', \'text\': \'(Mauern können nicht angreifen.)Erstschlag\', \'type\': \'Artefaktkreatur — Mauer\', \'flavor\': \'„Ein Stock ist ein Freund. Ein angespitzter Stock ist ein guter Freund. Eine Armee von angespitzten Stöcken ist der beste Freund von allen." —Oneanischer Hauptmann\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182963&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8a8832c6-6059-42fa-ad70-61cbd8dd5929\', \'multiverseId\': 182963}, \'multiverseid\': 182963}, {\'name\': \'Muro de lanzas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9fa00827-b2b1-4c46-b661-8ea3196a20a0\'}, \'multiverseid\': None}, {\'name\': \'Mur de lances\', \'text\': \'(Les murs ne peuvent pas attaquer.)\\nInitiative\', \'type\': \'Créature-artefact : mur\', \'flavor\': \'« Un bâton est votre ami. Un bâton pointu est un bon ami. Une armée de bâtons pointus est votre meilleure amie. » — Un sergent onéan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184379&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2b047941-bf3e-4e3a-840c-59cc3ef018f2\', \'multiverseId\': 184379}, \'multiverseid\': 184379}, {\'name\': \'槍の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4de290cd-a8c8-45bf-920d-f047905c2b5d\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Lanças\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02d0be71-a3da-4b3c-9312-5a740a27a5d5\'}, \'multiverseid\': None}]', "[{'name': 'Stab des Verderbens', 'text': '{3}, {T}: Der Stab des Verderbens fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.', 'type': 'Artefakt', 'flavor': 'Der Stab ist ein Überbleibsel aus alten Zeiten... grausamen, verderbten, gemeinen Zeiten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182954&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3b467294-b44f-48bd-9566-e1f8196ba297', 'multiverseId': 182954}, 'multiverseid': 182954}, {'name': 'Bastón de destrucción', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '03cbd797-4500-4d36-ac91-2a5e87e6f502'}, 'multiverseid': None}, {'name': 'Baguette de ruine', 'text': '{3}, {T}: La Baguette de ruine inflige 1 blessure à une cible, créature ou joueur.', 'type': 'Artefact', 'flavor': 'La baguette est une relique des temps anciens... des temps cruels, vicieux et brutaux.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184370&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd5e41951-3c97-4277-b6de-1b88e200b07f', 'multiverseId': 184370}, 'multiverseid': 184370}, {'name': '破滅のロッド', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0a5dd1c1-ee95-407a-b4d1-069b75fc3aa6'}, 'multiverseid': None}, {'name': 'Bastão da Ruína', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cfe7362a-1368-4073-88b7-f74e707788de'}, 'multiverseid': None}]", "[{'name': 'Standarte der Orks', 'text': 'Angreifende Kreaturen, die du kontrollierst, erhalten +1/+0.', 'type': 'Verzauberung', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182846&type=card', 'language': 'German', 'identifiers': {'scryfallId': '70c2acd6-fb0d-4353-8d62-d3c6e136ad8e', 'multiverseId': 182846}, 'multiverseid': 182846}, {'name': 'Oriflama orca', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c29bf1cc-9ba1-40df-9f18-61304adfcc68'}, 'multiverseid': None}, {'name': 'Oriflamme orque', 'text': 'Les créatures attaquantes que vous contrôlez gagnent +1/+0.', 'type': 'Enchantement', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184262&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'af6abc12-64c5-40a3-aec9-ff943d679b0f', 'multiverseId': 184262}, 'multiverseid': 184262}, {'name': 'オークの軍旗', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ec0c5689-e9b6-4a18-9606-af025031903c'}, 'multiverseid': None}, {'name': 'Auriflama Órquica', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '18de7e55-05b6-4b9f-aadf-e047fc743728'}, 'multiverseid': None}]", '[{\'name\': \'Statische Sphäre\', \'text\': \'Wenn die Statische Sphäre nicht getappt ist, können Spieler nicht mehr als zwei bleibende Karten während ihres Enttappsegments enttappen.\', \'type\': \'Artefakt\', \'flavor\': \'Die Krieger kämpften gegen die lähmenden Wellen, bis selbst ihre Gedanken festgefroren waren.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182959&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a95df82e-97ea-4788-bd03-1fdfaf3ba180\', \'multiverseId\': 182959}, \'multiverseid\': 182959}, {\'name\': \'Esfera estática\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'86413d38-28bc-4c3d-8d7f-9b85a6922e03\'}, \'multiverseid\': None}, {\'name\': \'Orbe statique\', \'text\': "Si l\'Orbe statique est dégagée, les joueurs ne peuvent pas dégager plus de deux permanents pendant leur étape de dégagement.", \'type\': \'Artefact\', \'flavor\': "Les guerriers luttaient contre les vagues de paralysie jusqu\'à ce que leurs esprits aussi se figent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184375&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'64077170-ff9d-4892-967a-d8a1906e5dd9\', \'multiverseId\': 184375}, \'multiverseid\': 184375}, {\'name\': \'静態の宝珠\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'75402160-0ca9-4d45-8219-e5f4a65865a5\'}, \'multiverseid\': None}, {\'name\': \'Orbe Estática\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7992bc7a-fae6-4612-8ec1-85ac9cc58956\'}, \'multiverseid\': None}]', '[{\'name\': \'Stehende Truppen\', \'text\': \'Die Stehenden Truppen werden beim Angreifen nicht getappt.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'„Sie kämpfen so dicht an dicht, dass nicht einmal ein Mäuschen durchschlüpfen könnte."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a17716d4-7cd6-4cee-9815-5856433ad605\', \'multiverseId\': 182688}, \'multiverseid\': 182688}, {\'name\': \'Tropas firmes\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0090fe9-b7aa-418b-875b-3e12a6837ea7\'}, \'multiverseid\': None}, {\'name\': \'Troupes régulières\', \'text\': "Attaquer avec ces Troupes régulières ne les fait pas s\'engager.", \'type\': \'Créature : soldat\', \'flavor\': "Ils se battent en rangs si serrés qu\'une souris ne pourrait s\'y faufiler.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184104&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b5952d47-a44c-42c5-ac14-b57be72c4529\', \'multiverseId\': 184104}, \'multiverseid\': 184104}, {\'name\': \'常備軍\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f90de36a-600e-46b0-928d-d2b30a2b6027\'}, \'multiverseid\': None}, {\'name\': \'Tropas Posicionadas\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'681b0f7f-ee5b-4e4a-a895-b1b61196038d\'}, \'multiverseid\': None}]', '[{\'name\': \'Stein des Sanftmuts\', \'text\': \'Kreaturen mit Stärke 3 oder größer enttappen nicht während der Enttappsegmente ihrer Beherrscher.\', \'type\': \'Artefakt\', \'flavor\': \'Je größer sie sind, desto mehr wirkt der Stein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182947&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3349d79f-cfe8-4731-83a6-58da633148d2\', \'multiverseId\': 182947}, \'multiverseid\': 182947}, {\'name\': \'Piedra de la mansedumbre\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2dc42529-41d2-4678-85dc-fe6ac146081e\'}, \'multiverseid\': None}, {\'name\': \'Pierre de soumission\', \'text\': "Les créatures dont la force est de 3 ou plus ne se dégagent pas pendant l\'étape de dégagement de leurs contrôleurs.", \'type\': \'Artefact\', \'flavor\': \'Plus ils sont gros, plus lourd est leur joug.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184363&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9d099414-4083-46df-85e5-cb4799c7121a\', \'multiverseId\': 184363}, \'multiverseid\': 184363}, {\'name\': \'弱者の石\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'faf96bce-a97c-4d98-861d-6adc0a9c134c\'}, \'multiverseid\': None}, {\'name\': \'Pedra da Submissão\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac764043-787e-40fb-9c82-6eec55903d16\'}, \'multiverseid\': None}]', "[{'name': 'Steinhagel', 'text': 'Zerstöre ein Land deiner Wahl.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182861&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1baaa043-3034-4b84-b998-8e2c5a525f9a', 'multiverseId': 182861}, 'multiverseid': 182861}, {'name': 'Lluvia de piedras', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '61109469-f196-4a75-bed8-a461ebd1b9a7'}, 'multiverseid': None}, {'name': 'Pluie de pierres', 'text': 'Détruisez le terrain ciblé.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184277&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'eeb5a728-3b06-4152-8259-8901892d1418', 'multiverseId': 184277}, 'multiverseid': 184277}, {'name': '石の雨', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '1db6ec3f-2b6f-4640-91f5-9a370bf625b0'}, 'multiverseid': None}, {'name': 'Chuva de Pedras', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a463e44c-f5a1-459f-bfe1-f313a093b9f2'}, 'multiverseid': None}]", '[{\'name\': \'Sternenlicht\', \'text\': \'Du erhältst für jede schwarze Kreatur, die ein Gegner deiner Wahl kontrolliert, 3 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'„Sogar in tiefster Nächte Dunkel sieht man der Sterne hell Gefunkel." —Oneanischer Kinderreim\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182689&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'659e1d6f-6337-4108-9b19-d164c6a94110\', \'multiverseId\': 182689}, \'multiverseid\': 182689}, {\'name\': \'Luz de las estrellas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e8bfb7d9-bfe6-41a8-97b4-44519f97b4ce\'}, \'multiverseid\': None}, {\'name\': \'Lumière stellaire\', \'text\': "Vous gagnez 3 points de vie pour chaque créature noire que l\'adversaire ciblé contrôle,", \'type\': \'Rituel\', \'flavor\': \'« Même dans la nuit la plus noire Anges et étoiles brillent comme miroirs. » — Comptine onéane.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184105&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac081d76-07d0-4c31-8293-cdef0408878e\', \'multiverseId\': 184105}, \'multiverseid\': 184105}, {\'name\': \'星明かり\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b751a71a-7b15-4972-840e-f3698aa0d505\'}, \'multiverseid\': None}, {\'name\': \'Luz das Estrelas\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'563110f0-9ad4-48ec-af9c-149fc537fbc8\'}, \'multiverseid\': None}]', "[{'name': 'Stränge der Nacht', 'text': '{B}{B}, bezahle 2 Lebenspunkte, opfere einen Sumpf: Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel.', 'type': 'Verzauberung', 'flavor': 'Wenn der Strang ruft, antworten nur die Toten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182805&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2741d88e-15f3-4e49-8b01-ab0eea0e6a91', 'multiverseId': 182805}, 'multiverseid': 182805}, {'name': 'Hebras de la noche', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '9e566a90-c809-481b-b7b1-aafafe72c633'}, 'multiverseid': None}, {'name': 'Filins de la nuit', 'text': '{B}{B}, payez 2 points de vie, sacrifiez un marais : Renvoyez en jeu une carte de créature ciblée de votre cimetière.', 'type': 'Enchantement', 'flavor': 'Seuls les morts répondent au vent lugubre qui souffle dans les filins de la nuit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184221&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3ec448da-07f2-4069-af6a-cd07eee9b2a7', 'multiverseId': 184221}, 'multiverseid': 184221}, {'name': '夜の断片', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '691fe184-d7a0-4bfc-8af9-a7a76ab58f03'}, 'multiverseid': None}, {'name': 'Filamentos da Noite', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8f53e0f5-63ef-44d4-96f9-07c3792f4d7a'}, 'multiverseid': None}]", '[{\'name\': \'Sturmkessel\', \'text\': \'Spieler dürfen ein zusätzliches Land während ihres Zuges ausspielen.\\nImmer wenn ein Land für Mana getappt wird, bringe es auf die Hand seines Besitzers zurück.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182960&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b26a2f78-23e4-40d5-a777-daeaaaa49021\', \'multiverseId\': 182960}, \'multiverseid\': 182960}, {\'name\': \'Caldero de la tormenta\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'80e76398-e7cc-4f67-84c7-23d7fd6a5dd7\'}, \'multiverseid\': None}, {\'name\': "Chaudron de l\'orage", \'text\': "Chaque joueur peut jouer un terrain supplémentaire pendant chacun de ses tours.\\nÀ chaque fois qu\'un terrain est engagé pour du mana, renvoyez-le dans la main de son propriétaire.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184376&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2c875f7c-7af5-4f4b-97b3-4fe63ab15930\', \'multiverseId\': 184376}, \'multiverseid\': 184376}, {\'name\': \'嵐の大釜\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'46729f01-9212-4718-8cf1-6c28e5b81e13\'}, \'multiverseid\': None}, {\'name\': \'Caldeirão da Tempestade\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3adf8497-abe6-43e3-85e9-276adb7055e5\'}, \'multiverseid\': None}]', '[{\'name\': \'Sturmkrähe\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Die Sturmkrähe galt in vielen Gebieten als Vorbote des Winters, was unzählige Bauernregeln belegen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182740&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc2a8cbb-6b06-45e4-b584-0f7282993829\', \'multiverseId\': 182740}, \'multiverseid\': 182740}, {\'name\': \'Cuervo de la tempestad\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2cc2b71-e7cb-4d1e-85db-7a7a4313ffcf\'}, \'multiverseid\': None}, {\'name\': "Corbeau de l\'orage", \'text\': \'Vol\', \'type\': \'Créature : oiseau\', \'flavor\': "Le corbeau de l\'orage descend, l\'hiver s\'installe. Le corbeau de l\'orage s\'en va, l\'été commence.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184156&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7a78f240-4920-48f0-8259-e92ecc665dbd\', \'multiverseId\': 184156}, \'multiverseid\': 184156}, {\'name\': \'嵐雲のカラス\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9d29fe48-f131-42b7-85aa-6d95d95bae86\'}, \'multiverseid\': None}, {\'name\': \'Corvo da Tempestade\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4fb196e1-8567-4051-b88b-a15eae635886\'}, \'multiverseid\': None}]', '[{\'name\': \'Sturmschamane\', \'text\': \'{R}: Der Sturmschamane erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kleriker\', \'flavor\': \'„Er spricht mit der Stimme der Winde, und die Erde zittert."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182862&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'995a93ce-48ba-4974-97bb-15928fb4ea55\', \'multiverseId\': 182862}, \'multiverseid\': 182862}, {\'name\': \'Chamán de la tormenta\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'68bb8908-58ca-4023-9645-dc2aae0740f8\'}, \'multiverseid\': None}, {\'name\': "Shamane de l\'orage", \'text\': "{R}: La Shamane de l\'orage gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : clerc\', \'flavor\': \'Elle parle avec la voix des vents et la terre tremble.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184278&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'73d25b64-c619-4a6f-bc80-2127778b51fb\', \'multiverseId\': 184278}, \'multiverseid\': 184278}, {\'name\': \'嵐のシャーマン\', \'flavor\': None, \'language\': \'Japanese\', \'ide