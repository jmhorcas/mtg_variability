\'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc5e392f-f90a-464c-a6fc-ba8e205b54b0\'}, \'multiverseid\': None}]', '[{\'name\': \'Hurrikan\', \'text\': \'Der Hurrikan fügt allen fliegenden Kreaturen und allen Spielern X Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182892&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6118f62f-2b12-496d-ba9c-03d92fd7f1b1\', \'multiverseId\': 182892}, \'multiverseid\': 182892}, {\'name\': \'Huracán\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'563cd41e-afac-4b38-a3f0-dbc1acbb83db\'}, \'multiverseid\': None}, {\'name\': \'Ouragan\', \'text\': "L\'Ouragan inflige X blessures à chaque créature avec le vol et à chaque joueur.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184308&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9644a6fc-665c-4ee2-a7d0-8bc83ccadf07\', \'multiverseId\': 184308}, \'multiverseid\': 184308}, {\'name\': \'ハリケーン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b02113c8-da41-4a6a-a458-b2938ee024b1\'}, \'multiverseid\': None}, {\'name\': \'Furacão\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9cba0d79-913a-492f-b2ed-008446cb4d4e\'}, \'multiverseid\': None}]', '[{\'name\': \'Höhlenhunde\', \'text\': \'Immer wenn die Höhlenhunde angreifen, erhalten sie +2/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Ein Höhlenhund ist immer erfüllt mit den Blutdurst einer guten Jagd.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182781&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f05e74e-f3f4-4bcc-9859-c0737a652213\', \'multiverseId\': 182781}, \'multiverseid\': 182781}, {\'name\': \'Perros huecos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a73a5574-43f1-4048-b893-703ff9c3f296\'}, \'multiverseid\': None}, {\'name\': \'Chiens creux\', \'text\': "À chaque fois que ces Chiens creux attaquent, ils gagnent +2/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : chien de chasse\', \'flavor\': "Un chien creux n\'est pas vide. Il est empli de sa soif de chasser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184197&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6c716798-efa3-4ef7-af33-018a502632ed\', \'multiverseId\': 184197}, \'multiverseid\': 184197}, {\'name\': \'虚ろの犬\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c954c348-24a4-40f3-bc01-7c48864728e8\'}, \'multiverseid\': None}, {\'name\': \'Cães Ôcos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'788495ac-d529-40f6-929f-ff88ac601e98\'}, \'multiverseid\': None}]', '[{\'name\': \'Höllischer Vertrag\', \'text\': \'Ziehe vier Karten. Du verlierst die Hälfte (aufgerundet) deiner Lebenspunkte.\', \'type\': \'Hexerei\', \'flavor\': \'„Ost und West vereint, die Engel verzagen. Der Himmel wird dunkel, wenn sie sich vertragen." —„Die Ballade der Paladine"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182783&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7d70e1ae-d224-4489-8037-14a7a44ccf82\', \'multiverseId\': 182783}, \'multiverseid\': 182783}, {\'name\': \'Contrato infernal\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c064f091-9ca9-4ae8-9706-bde07aad11c5\'}, \'multiverseid\': None}, {\'name\': \'Pacte avec les enfers\', \'text\': \'Piochez quatre cartes. Vous perdez la moitié de vos points de vie, perte arrondie au supérieur.\', \'type\': \'Rituel\', \'flavor\': "« L\'Est et l\'Ouest se rencontrent et les anges pleurent. Une force impie obscurcit le ciel. » — « La ballade des Paladins ».", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184199&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f68d746a-07b0-4abd-8314-a4d6e2e04161\', \'multiverseId\': 184199}, \'multiverseid\': 184199}, {\'name\': \'冥府の契約\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ec335f5-d947-4d63-b0a5-b1ee1025d41b\'}, \'multiverseid\': None}, {\'name\': \'Contrato Infernal\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb8da200-1001-4609-aebe-6f5bec5feba2\'}, \'multiverseid\': None}]', '[{\'name\': \'Hügelriese\', \'type\': \'Kreatur — Riese\', \'flavor\': \'Hügelriesen sind meistens einfach nur groß. Allerdings reicht das fast immer auch aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182836&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e797234-7071-4bcf-96db-7d4cd436eb37\', \'multiverseId\': 182836}, \'multiverseid\': 182836}, {\'name\': \'Gigante de las colinas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c428f029-49e2-438e-911e-89bbd22e89ab\'}, \'multiverseid\': None}, {\'name\': \'Géant des collines\', \'type\': \'Créature : géant\', \'flavor\': "Les géants des collines sont tout simplement grands. Bon, bien sûr, ce n\'est pas négligeable.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184252&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3fa284c8-5c59-4892-b209-69116169512f\', \'multiverseId\': 184252}, \'multiverseid\': 184252}, {\'name\': \'丘巨人\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'08b0bf3a-6e04-415a-b1fa-da10a7d84b3d\'}, \'multiverseid\': None}, {\'name\': \'Gigante da Colina\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67f2b273-0dbc-4e58-ac5b-7634a6f683cb\'}, \'multiverseid\': None}]', '[{\'name\': \'Inferno\', \'text\': \'Inferno fügt allen Spielern und allen Kreaturen 6 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Manche sagen, dass reine Zerstörung keinen Spaß macht. Weißt du was? Sie sind alle tot." —Wandernder Magier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182838&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc5db275-e65e-48d5-84bb-b984fd5129e2\', \'multiverseId\': 182838}, \'multiverseid\': 182838}, {\'name\': \'Infierno\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'314475d4-80b3-42cb-af5e-d23fd8211855\'}, \'multiverseid\': None}, {\'name\': \'Fournaise\', \'text\': \'La Fournaise inflige 6 blessures à chaque créature et à chaque joueur.\', \'type\': \'Éphémère\', \'flavor\': "« Certains disent qu\'il n\'y a pas de finesse dans la destruction. Vous savez quoi ? Ils sont morts. » — Un mage itinérant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184254&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c282d04-c789-4b1a-82e3-34de746ef636\', \'multiverseId\': 184254}, \'multiverseid\': 184254}, {\'name\': \'インフェルノ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04981080-1dd8-4bc8-ae46-80609836b0ae\'}, \'multiverseid\': None}, {\'name\': \'Inferno\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ed37ea9e-a006-4888-9fc1-3b30a9150a0c\'}, \'multiverseid\': None}]', "[{'name': 'Insel', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182972&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6f82a144-672f-46dc-b15a-061ca37d69b8', 'multiverseId': 182972}, 'multiverseid': 182972}, {'name': 'Isla', 'flavor': None, 'language': 'Sp