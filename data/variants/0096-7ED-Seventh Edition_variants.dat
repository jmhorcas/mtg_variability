: 182970}, {'name': 'Bosque', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0246d15a-f202-431f-b6f7-1af243d10189'}, 'multiverseid': None}, {'name': 'Forêt', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184386&type=card', 'language': 'French', 'identifiers': {'scryfallId': '52f7b545-2767-49b5-a178-3eb6c1187385', 'multiverseId': 184386}, 'multiverseid': 184386}, {'name': '森', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '86c816ac-ad0b-4aef-8e99-9e72631bbe92'}, 'multiverseid': None}, {'name': 'Floresta', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b84e9b29-e5de-48c9-b18c-bcd4ac3a57ca'}, 'multiverseid': None}]", "[{'name': 'Wald', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182971&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5347e0ec-688e-4b5f-b2f7-5d9d7ff7e5b4', 'multiverseId': 182971}, 'multiverseid': 182971}, {'name': 'Bosque', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0ba7f89f-df86-4a50-8b61-59d5e790ebbd'}, 'multiverseid': None}, {'name': 'Forêt', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184387&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c0825c6a-c363-4eeb-bdd2-42fcec953eb1', 'multiverseId': 184387}, 'multiverseid': 184387}, {'name': '森', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9185fe74-90b8-4662-b552-940c59aaf5fd'}, 'multiverseid': None}, {'name': 'Floresta', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bda8a37d-1d46-49a8-afcd-a4d9995db80f'}, 'multiverseid': None}]", '[{\'name\': \'Waldelfen\', \'text\': \'Durchsuche deine Bibliothek nach einem Wald und bringe ihn ins Spiel, wenn die Waldelfen ins Spiel kommen. Mische danach deine Bibliothek.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'Jeder Zweig eine Kreuzung, jede Ranke ein Fortbewegungsmittel.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182924&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5d24aee-8f4c-4638-a859-cbec07efa96c\', \'multiverseId\': 182924}, \'multiverseid\': 182924}, {\'name\': \'Elfos del bosque\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69e8e943-68c7-43f5-9d82-2424fa058599\'}, \'multiverseid\': None}, {\'name\': \'Elfe des bois\', \'text\': "Quand l\'Elfe des bois arrive en jeu, cherchez une carte de forêt dans votre bibliothèque et mettez cette forêt en jeu. Mélangez ensuite votre bibliothèque.", \'type\': \'Créature : elfe\', \'flavor\': \'Chaque branche est un embranchement, chaque bouture une monture.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184340&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3555e2d3-2b23-4502-8e25-c4a9c20de559\', \'multiverseId\': 184340}, \'multiverseid\': 184340}, {\'name\': \'ウッド・エルフ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8857ff87-71c1-4e3a-a8d2-4502033e3dc2\'}, \'multiverseid\': None}, {\'name\': \'Elfos da Floresta\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9c57bc9c-0eec-4b06-8956-47416b080345\'}, \'multiverseid\': None}]', '[{\'name\': \'Weise Eule\', \'text\': \'Fliegend\\nWenn die Weise Eule ins Spiel kommt, schaue dir die obersten vier Karten deiner Bibliothek an und lege sie in beliebiger Reihenfolge zurück.\', \'type\': \'Kreatur — Vogel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182736&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7154d2e9-be3a-46ba-a6fd-8a4eacfd34b0\', \'multiverseId\': 182736}, \'multiverseid\': 182736}, {\'name\': \'Búho sabio\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31fb51e7-2d57-4865-9b78-a58739a1ea4c\'}, \'multiverseid\': None}, {\'name\': \'Hibou savant\', \'text\': "Vol\\nQuand le Hibou savant arrive en jeu, regardez les quatre cartes du dessus de votre bibliothèque et remettez-les y dans l\'ordre de votre choix.", \'type\': \'Créature : oiseau\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184152&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72108d81-cb5a-4b68-aec8-2e28cc2b95b7\', \'multiverseId\': 184152}, \'multiverseid\': 184152}, {\'name\': \'物知りフクロウ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40a82faa-bfbc-4c91-b16c-c85090d143fb\'}, \'multiverseid\': None}, {\'name\': \'Coruja Sábia\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7c4a0636-9d71-4184-801b-e16c38c8e16d\'}, \'multiverseid\': None}]', '[{\'name\': \'Weiser aus dem Fyndhorn\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {G}{G}.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'„Es ist nützlich, dass ich mit den Bäumen sprechen kann. Und es ist fabelhaft, dass ich ihnen auch zuhören kann."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182886&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5d1a658-5025-4340-bc1d-a35d66c6f5d0\', \'multiverseId\': 182886}, \'multiverseid\': 182886}, {\'name\': \'Anciano de Fyndhorn\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'46f93900-14c1-47f0-b932-5f4805f0c5b8\'}, \'multiverseid\': None}, {\'name\': \'Ancêtre cordellien\', \'text\': \'{T}: Ajoutez {G}{G} à votre réserve.\', \'type\': \'Créature : elfe\', \'flavor\': "« C\'est utile de savoir parler aux arbres. Mais plus encore de savoir les écouter. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184302&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'386ae72b-b90a-4878-a597-9568dc332f10\', \'multiverseId\': 184302}, \'multiverseid\': 184302}, {\'name\': \'フィンドホーンの古老\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b37acc30-1e0d-4e86-9071-62efefe51e41\'}, \'multiverseid\': None}, {\'name\': \'Ancião de Fyndhorn\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1f12241b-1837-4991-a91c-fc802e1d17a7\'}, \'multiverseid\': None}]', '[{\'name\': \'Wiedererwachen der Natur\', \'text\': \'Jeder Spieler zieht für jede Kreaturenkarte in seinem Friedhof eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Toten flüstern den Lebenden zu. Wenn du zuhörst, kannst du viel lernen." —Maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182899&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'073c46b5-0210-40d5-8107-88a7cfda3259\', \'multiverseId\': 182899}, \'multiverseid\': 182899}, {\'name\': \'Resurgir de la naturaleza\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'33f0aa8f-11d5-484a-96f3-e024f2bcd93b\'}, \'multiverseid\': None}, {\'name\': \'Renouveau de la nature\', \'text\': \'Chaque joueur pioche une carte pour chaque carte de créature dans son cimetière.\', \'type\': \'Rituel\', \'flavor\': \'« Les morts murmurent pour les vivants. Si vous écoutez, vous apprendrez. » — Maro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184315&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0da768e2-1c28-47a6-9f83-afdb40f8680b\', \'multiverseId\': 184315}, \'multiverseid\': 184315}, {\'name\': \'自然の復活\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6f4cb30-86f5-4a5e-a5ca-a3a3c91a1a7f\'}, \'multiverseid\': None}, {\'name\': \'Ressurgência da Natureza\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5509ccf7-a456-4410-982a-ee17cc86b9a2\'}, \'multiverseid\': None}]', '[{\'name\': \'Wiederverwertung\', \'text\': \'Opfere eine beliebige Anzahl an Artefakten, Kreaturen und/oder Ländern. Ziehe für jede bleibende Karte, die du auf diese Art geopfert hast, eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'Das Ende der Schlacht ist der Beginn des Fressens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182799&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6cdc05c9-599a-4f4f-a363-df6cf49a864c\', \'multiverseId\': 182799}, \'multiverseid\': 182799}, {\'name\': \'Reprocesar\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7a484d11-ec3d-40bb-9ad3-641673aaf8b2\'}, \'multiverseid\': None}, {\'name\': \'Retraitement\', \'text\': "Sacrifiez un nombre quelconque d\'artefacts, de créatures et/ou de terrains. Piochez une carte pour chaque permanent sacrifié de cette manière.", \'type\': \'Rituel\', \'flavor\': \'La fin de la bataille est le début du repas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184215&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'20784329-b505-4c22-9515-873496dba5cf\', \'multiverseId\': 184215}, \'multiverseid\': 184215}, {\'name\': \'再処理\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37dd939c-9368-4aa7-b196-a0c172f589a4\'}, \'multiverseid\': None}, {\'name\': \'Reprocessar\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'37177793-96ac-4f5a-a742-eef515b53961\'}, \'multiverseid\': None}]', '[{\'name\': \'Wildwuchs\', \'text\': \'Immer wenn das verzauberte Land für Mana getappt wird, erhöht sein Beherrscher seinen Manavorrat um ein zusätzliches {G}.\', \'type\': \'Landverzauberung\', \'flavor\': \'Wenn du stehenbleibst, um zu lauschen, kannst du es wachsen hören.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182922&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18b7ef48-6e35-412a-8786-1b403a4c3da1\', \'multiverseId\': 182922}, \'multiverseid\': 182922}, {\'name\': \'Crecimiento salvaje\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4732e65-1cb5-4a5d-bf41-9ec51e2ba52b\'}, \'multiverseid\': None}, {\'name\': \'Végétation luxuriante\', \'text\': \'À chaque fois que le terrain enchanté est engagé pour du mana, son contrôleur ajoute {G} à sa réserve.\', \'type\': \'Enchanter : terrain\', \'flavor\': "Si vous arrêtez d\'écouter, vous l\'entendrez penser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184338&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee5f3bdf-49fd-4531-b1c3-c965e1132430\', \'multiverseId\': 184338}, \'multiverseid\': 184338}, {\'name\': \'繁茂\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'053aebfd-8bb8-4a44-af5e-dda3a7361944\'}, \'multiverseid\': None}, {\'name\': \'Crescimento Virente\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa85cc1b-6474-4a98-b0bf-3a1f46780650\'}, \'multiverseid\': None}]', '[{\'name\': \'Windböen\', \'text\': \'Die Windböen fügen jeder fliegenden Kreatur 2 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Heut\\\' Nacht erheben sich die Winde Und rauschen das Lied des vergang\\\'nen Tags: Das letzte Herbstblatt fortgeweht, Die Krähen in der Luft verstreut..." —Alfred Lord Tennyson, "In Memoriam A. H. H."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182911&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2acc13c7-f6f8-4c60-9533-c2dc515d3541\', \'multiverseId\': 182911}, \'multiverseid\': 182911}, {\'name\': \'Ráfaga\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82e9199d-9207-441b-9fa9-f418df8bdfbc\'}, \'multiverseid\': None}, {\'name\': \'Bourrasque\', \'text\': \'La Bourrasque inflige 2 blessures à chaque créature avec le vol.\', \'type\': \'Rituel\', \'flavor\': "« Et je m\'en vais Deçà, delà Au vent mauvais » — Verlaine, Poèmes saturniens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184327&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56cd2e76-af83-4d82-962c-bcf338ab1b1e\', \'multiverseId\': 184327}, \'multiverseid\': 184327}, {\'name\': \'突風\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'371115f5-2938-44f0-96b7-50b78524f14d\'}, \'multiverseid\': None}, {\'name\': \'Borrasca\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'264c59c6-f315-4ced-aca0-b3c1c0d6a160\'}, \'multiverseid\': None}]', '[{\'name\': \'Windsceada\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'„Dort drob schießt sie durch Luft und Licht, Weit über jeder Ruh, Die Last der Erde bind\\\'t sie nicht, Kein Schatten setzt ihr zu." —Thomas Moore, „Oh wenn ich Flügel hätt"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182754&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6930fd59-dae5-453d-b39c-81fceec4e250\', \'multiverseId\': 182754}, \'multiverseid\': 182754}, {\'name\': \'Draco del viento\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0dd51c58-b277-4903-9ab5-41511747e8bf\'}, \'multiverseid\': None}, {\'name\': \'Drakôn des vents\', \'text\': \'Vol\', \'type\': \'Créature : drakôn\', \'flavor\': "« L\'aigle alors jette au loin ces dépouilles opimes Et, l\'aile ouverte au vent, vole vers le soleil. » — Verlaine, Poèmes saturniens.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184170&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d69339f-2ec4-40d6-929d-94bbd566efa1\', \'multiverseId\': 184170}, \'multiverseid\': 184170}, {\'name\': \'風のドレイク\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5db09053-16f4-4f73-a8ad-05a0db39c4cb\'}, \'multiverseid\': None}, {\'name\': \'Dragonete do Vento\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'594ad67c-3611-4002-a8e3-b805f6c72119\'}, \'multiverseid\': None}]', '[{\'name\': \'Winterschlaf\', \'text\': \'Bringe alle grünen bleibenden Karten auf die Hand ihrer Besitzer zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der tiefe Schlaf im Winter ist nicht immer erholsam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182719&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c76d2560-424b-4af0-a73d-cfda5ee405fe\', \'multiverseId\': 182719}, \'multiverseid\': 182719}, {\'name\': \'Hibernación\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6bef3396-5115-446a-b15d-ec824e7d25f0\'}, \'multiverseid\': None}, {\'name\': \'Hibernation\', \'text\': \'Renvoyez tous les permanents verts dans les mains de leurs propriétaires.\', \'type\': \'Éphémère\', \'flavor\': "Le sommeil hivernal n\'est pas de tout repos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184135&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d4146ab1-e08b-42a4-b0c4-53e37a6018c7\', \'multiverseId\': 184135}, \'multiverseid\': 184135}, {\'name\': \'冬眠\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'59bb21ee-409b-49fc-b955-e039d6adb625\'}, \'multiverseid\': None}, {\'name\': \'Hibernação\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f34e230b-a563-4285-84ae-974ff2385f28\'}, \'multiverseid\': None}]', '[{\'name\': \'Wissen der Ahnen\', \'text\': \'Schau dir die obersten sieben Karten deiner Bibliothek an. Nimm zwei davon auf deine Hand und lege die anderen fünf auf deinen Friedhof.\', \'type\': \'Hexerei\', \'flavor\': \'Bis heute konnte sich noch nie jemand an die Zukunft erinnern, immer nur an die Vergangenheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182699&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af8b5c91-2ad0-41cc-9555-b86615ae2f97\', \'multiverseId\': 182699}, \'multiverseid\': 182699}, {\'name\': \'Recuerdos ancestrales\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d471990e-5958-4237-891d-b7a33935fac0\'}, \'multiverseid\': None}, {\'name\': \'Souvenirs ancestraux\', \'text\': "Regardez les sept cartes du dessus de votre bibliothèque et mettez deux d\'entre elles dans votre main. Mettez les autres dans votre cimetière.", \'type\': \'Rituel\', \'flavor\': "« J\'ai plus de souvenirs que si j\'avais mille ans. » — Baudelaire, Spleen.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184115&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ef0ec7c-036d-4102-85d9-929f703620fa\', \'multiverseId\': 184115}, \'multiverseid\': 184115}, {\'name\': \'祖先の記憶\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6683a6d-4394-4803-af2b-26480c74243a\'}, \'multiverseid\': None}, {\'name\': \'Memórias Ancestrais\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d3a3c2f-c9b7-4ac9-8016-bb32ce334106\'}, \'multiverseid\': None}]', '[{\'name\': \'Wolkenjagdadler\', \'text\': \'Fliegend\\nZerstöre eine Verzauberung deiner Wahl, wenn der Wolkenjagdadler ins Spiel kommt.\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Die meisten Adler jagen Kleingetier. Die Wolkenjäger jagen Magie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'058775c0-2457-4856-a6ce-ef2b54f7296c\', \'multiverseId\': 182651}, \'multiverseid\': 182651}, {\'name\': \'Águila cazanubes\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c761837-e67d-4a27-bf2f-0b6ee147d7b8\'}, \'multiverseid\': None}, {\'name\': \'Aigle chasse-nuages\', \'text\': "Vol\\nQuand l\'Aigle chasse-nuages arrive en jeu, détruisez l\'enchantement ciblé.", \'type\': \'Créature : oiseau\', \'flavor\': "La plupart des aigles se nourrissent de rongeurs. Les chasse-nuages s\'enivrent de magie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184067&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4d57227-57fd-4c6a-ae6f-c29e08895131\', \'multiverseId\': 184067}, \'multiverseid\': 184067}, {\'name\': \'雲を追う鷲\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57a80528-67e3-47d8-b7b0-e1f3c88fde8f\'}, \'multiverseid\': None}, {\'name\': \'Águia Caça-nuvens\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6d17651-5b95-46a5-9305-4568e12a31ba\'}, \'multiverseid\': None}]', '[{\'name\': \'Wolkenschleierhabicht\', \'text\': \'Fliegend\\nDer Wolkenschleierhabicht wird beim Angreifen nicht getappt\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Die ersten Druiden glaubten, der Habicht hätte den Himmel aufgerissen, um das Sonnenlicht hindurchzulassen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182685&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f334878-e27c-43fd-8152-48c231e8e2ae\', \'multiverseId\': 182685}, \'multiverseid\': 182685}, {\'name\': \'Halcón de Veloceleste\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eefb5292-95d0-4d6d-a568-d93bf1410def\'}, \'multiverseid\': None}, {\'name\': \'Faucon de Linciel\', \'text\': "Vol\\nAttaquer avec le Faucon de Linciel ne le fait pas s\'engager.", \'type\': \'Créature : oiseau\', \'flavor\': \'Les anciens mystiques croyaient que le faucon déchirait le ciel pour laisser passer la lumière.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184101&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5681446-c2f1-403b-a696-b5440b3719d8\', \'multiverseId\': 184101}, \'multiverseid\': 184101}, {\'name\': \'スカイシュラウドの隼\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f0ff270-91f6-4a43-af76-f1034e9b89e5\'}, \'multiverseid\': None}, {\'name\': \'Falcão de Skyshroud\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b9ed821-7a85-4916-85ea-ee9205841c1d\'}, \'multiverseid\': None}]', "[{'name': 'Wucherndes Wachstum', 'text': 'Durchsuche deine Bibliothek nach einem Standardland und bringe diese Karte getappt ins Spiel. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Die Natur lässt die Lösungen für ihre Probleme einfach sprießen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182902&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5fbfb09f-babf-4001-8f0a-bf73c1077ca5', 'multiverseId': 182902}, 'multiverseid': 182902}, {'name': 'Crecimiento exuberante', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'fbec4da7-dba0-4659-a646-075d971d7cf4'}, 'multiverseid': None}, {'name': 'Croissance luxuriante', 'text': 'Cherchez dans votre bibliothèque une carte de terrain de base et mettez cette carte en jeu engagée. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'La Nature fait pousser les solutions à ses problèmes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184318&type=card', 'language': 'French', 'identifiers': {'scryfallId': '104e72e3-058e-4839-a838-2b1cd7969126', 'multiverseId': 184318}, 'multiverseid': 184318}, {'name': '不屈の自然', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b8d6231f-9861-41d6-bca3-851f24db0baa'}, 'multiverseid': None}, {'name': 'Crescimento Exuberante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e2f066a4-8dca-4f99-ad50-9191469e36c8'}, 'multiverseid': None}]", '[{\'name\': \'Wundersame Mauer\', \'text\': \'(Mauern können nicht angreifen.)\\n{2}{U}{U}: Die Wundersame Mauer erhält +4/-4 bis zum Ende des Zuges und kann angreifen, als ob sie keine Mauer wäre.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'Sie wunderten sich über die Größe der Mauer. Die Mauer wunderte sich, wer am besten schmecken würde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182752&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7158b0d8-dff7-4ac7-aa8e-aa38ff52a7ac\', \'multiverseId\': 182752}, \'multiverseid\': 182752}, {\'name\': \'Muro de maravillas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b40f2af7-ae09-4e9f-8d24-40a26e9d9c5a\'}, \'multiverseid\': None}, {\'name\': \'Mur des merveilles\', \'text\': "(Les murs ne peuvent pas attaquer.)\\n{2}{U}{U}: Le Mur des merveilles gagne +4/-4 jusqu\'à la fin du tour et peut attaquer ce tour-ci comme s\'il n\'était pas un mur.", \'type\': \'Créature : mur\', \'flavor\': "« Et sur ces mouvantes merveilles Planait (terrible nouveauté Tout pour l\'œil, rien pour les oreilles) Un silence d\'éternité. » — Baudelaire, Les Fleurs du Mal.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184168&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0abdbb56-7e80-4f91-a433-ec3793eb57e7\', \'multiverseId\': 184168}, \'multiverseid\': 184168}, {\'name\': \'驚きの壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'92c11be8-34a8-475f-9813-214bd5ee7580\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Assombro\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45fb32c5-64fd-4005-b86a-bb9f1258c3e6\'}, \'multiverseid\': None}]', '[{\'name\': \'Wurzelkraft\', \'text\': \'Immer wenn ein Spieler einen grünen Zauberspruch spielt, kannst du {1} bezahlen. Wenn du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Durch tausend Glieder gestärkt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182964&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94d09b96-5e7c-4db8-ab80-be157e38a4ab\', \'multiverseId\': 182964}, \'multiverseid\': 182964}, {\'name\': \'Esfera de madera\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ffe6cb6f-d0b0-4848-8357-ce1769d76d5e\'}, \'multiverseid\': None}, {\'name\': \'Sphère de bois\', \'text\': "À chaque fois qu\'un joueur joue un sort vert, vous pouvez payer {1}. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Portée par un millier de bras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184380&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54b449bb-18ae-4ba2-af70-ebfd55a738c5\', \'multiverseId\': 184380}, \'multiverseid\': 184380}, {\'name\': \'森の宝球\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efa1a1ed-0b39-464c-850e-5590f4f0a48d\'}, \'multiverseid\': None}, {\'name\': \'Esfera de Madeira\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7694a547-6964-4e63-9a4c-0aff4948794e\'}, \'multiverseid\': None}]', "[{'name': 'Wütender Goblin', 'text': 'Eile (Diese Kreatur kann in dem Zug, in dem sie unter deine Kontrolle kommt, angreifen und {T}.)', 'type': 'Kreatur — Goblin', 'flavor': 'Er tobte gegen die Welt, gegen seine Familie, gegen sein Leben. Aber hauptsächlich tobte er.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182851&type=card', 'language': 'German', 'identifiers': {'scryfallId': '382a8997-fa14-45e2-b4bc-5ac04f507395', 'multiverseId': 182851}, 'multiverseid': 182851}, {'name': 'Trasgo furioso', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a3e7e31e-e87b-4ab4-a586-dd23ca1b02f1'}, 'multiverseid': None}, {'name': 'Gobelin enragé', 'text': 'Célérité (Cette créature peut attaquer et {T} dès le tour où elle arrive sous votre contrôle.)', 'type': 'Créature : gobelin', 'flavor': 'Il enrageait contre le monde, contre sa famille, contre lui-même. Et parfois juste pour le plaisir.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184267&type=card', 'language': 'French', 'identifiers': {'scryfallId': '85eb9bbd-ef1a-441c-988b-62ac079dafb6', 'multiverseId': 184267}, 'multiverseid': 184267}, {'name': '怒り狂うゴブリン', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c5f0dcda-e911-46ab-acd8-b4048f96fbd0'}, 'multiverseid': None}, {'name': 'Goblin Enfurecido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f3491fad-c85f-4331-bf68-11c9671a7ba5'}, 'multiverseid': None}]", '[{\'name\': \'Yavimayablütenzauberin\', \'text\': \'Die Yavimayablütenzauberin erhält +1/+1 für jede Verzauberung im Spiel.\', \'type\': \'Kreatur — Druide\', \'flavor\': \'Ihre Wurzeln verbinden sie mit den Wünschen des Waldes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182925&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc592a20-1de5-40e7-86f2-71aa6796f1e6\', \'multiverseId\': 182925}, \'multiverseid\': 182925}, {\'name\': \'Hechicera de Yavimaya\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'20422d17-5aad-49ac-b3bb-0085ce5cef9a\'}, \'multiverseid\': None}, {\'name\': \'Enchanteresse de la Yavimaya\', \'text\': "L\'Enchanteresse de la Yavimaya gagne +1/+1 pour chaque enchantement en jeu.", \'type\': \'Créature : druide\', \'flavor\': \'Ses racines la relient aux désirs de la forêt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184341&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69b9696c-1fc7-4194-9153-8eed6648ce94\', \'multiverseId\': 184341}, \'multiverseid\': 184341}, {\'name\': \'ヤヴィマヤの女魔術師\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cddf1e3c-cdaf-46b6-b099-2859cd3803b8\'}, \'multiverseid\': None}, {\'name\': \'Encantadora de Yavimaya\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3070f035-42c8-4484-83d6-ee9bcd133e60\'}, \'multiverseid\': None}]', '[{\'name\': \'Yawgmoths Edikt\', \'text\': \'Immer wenn ein Gegner einen weißen Zauberspruch spielt, verliert dieser Spieler 1 Lebenspunkt und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Verzauberung\', \'flavor\': \'Das Verkrümmen von Körpern und Seelen wurde zum Zentrum von Yawgmoths Existenz.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182811&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c6af46b-6e05-4ed2-816a-b6d467c6a3dc\', \'multiverseId\': 182811}, \'multiverseid\': 182811}, {\'name\': \'Edicto de Yawgmoth\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83e4b9e5-701a-4df1-8c2d-5df75cb50719\'}, \'multiverseid\': None}, {\'name\': \'Édit de Yaugzebul\', \'text\': "À chaque fois que l\'un de vos adversaires joue un sort blanc, ce joueur perd 1 point de vie et vous gagnez 1 point de vie.", \'type\': \'Enchantement\', \'flavor\': \'Yaugzebul ne vit plus que pour déformer corps et âmes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184227&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'135ee89b-9455-452c-88ba-42700454ad04\', \'multiverseId\': 184227}, \'multiverseid\': 184227}, {\'name\': \'ヨーグモ