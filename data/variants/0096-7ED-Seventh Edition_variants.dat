182721&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2094c334-43e0-4306-b546-145eedcfd0d7', 'multiverseId': 182721}, 'multiverseid': 182721}, {'name': 'Inspiración', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '40ecf116-5daa-4f3f-a2c4-b2f0e8f93f46'}, 'multiverseid': None}, {'name': 'Inspiration', 'text': 'Le joueur ciblé pioche deux cartes.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184137&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2fe2dd58-ad7c-4af2-b551-95c92e57209c', 'multiverseId': 184137}, 'multiverseid': 184137}, {'name': '霊感', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '76c467dc-4540-408d-8f5f-52e71618bea9'}, 'multiverseid': None}, {'name': 'Inspiração', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '265fb99d-4d8f-4965-bc54-899626f888ef'}, 'multiverseid': None}]", "[{'name': 'Jandors Satteltaschen', 'text': '{3}, {T}: Enttappe eine Kreatur deiner Wahl.', 'type': 'Artefakt', 'flavor': 'Was dein Herz sich wünscht, findest du hier. —Inschrift der Satteltaschen', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182944&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bc1d2a67-76a0-440d-b8a0-4a41ab0ed20f', 'multiverseId': 182944}, 'multiverseid': 182944}, {'name': 'Alforjas de Jandor', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '064ea852-96aa-40bd-ab7c-d5a2f45d94e5'}, 'multiverseid': None}, {'name': 'Fontes de Jouder', 'text': '{3}, {T}: Dégagez la créature ciblée.', 'type': 'Artefact', 'flavor': '« Ô Jouder, ce sac est enchanté » — Les Mille et une Nuits.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184360&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'fc435669-7cc4-45e5-98b0-60a66afd32e0', 'multiverseId': 184360}, 'multiverseid': 184360}, {'name': 'ジャンドールの鞍袋', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e68d23c7-975a-4fb5-8dae-fea4d451542f'}, 'multiverseid': None}, {'name': 'Alforjes de Jandor', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f912eb05-9d9b-4833-b28d-010ae05d2702'}, 'multiverseid': None}]", '[{\'name\': \'Karmesinroter Höllendrache\', \'text\': \'Fliegend\\n{X}, {T}: Der Karmesinrote Höllendrache fügt einer Kreatur deiner Wahl X Schadenspunkte zu. Du kannst für diese Fähigkeit nur rotes Mana ausgeben.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'„Die Höllendrachen sind Künstler der Flammen, sie malen die Welt mit Feuer an."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182818&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fed0053e-6bca-431d-a4f9-0cde9cff5d3c\', \'multiverseId\': 182818}, \'multiverseid\': 182818}, {\'name\': \'Engendro carmesí\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d72e53cc-ca0a-44e9-a1c9-86575ac182b3\'}, \'multiverseid\': None}, {\'name\': \'Escouflenfer pourpre\', \'text\': "Vol\\n{X}, {T}: L\'Escouflenfer pourpre inflige X blessures à la créature ciblée. Ne dépensez de cette manière que du mana rouge.", \'type\': \'Créature : dragon\', \'flavor\': \'Les escouflenfers sont des artistes des flammes, peignant le monde de feux.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184234&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'48354fa2-9027-4dc4-8b58-a0ee0c2f4818\', \'multiverseId\': 184234}, \'multiverseid\': 184234}, {\'name\': \'真紅のヘルカイト\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81e35fd5-60f0-479e-8e95-04baf26879c8\'}, \'multiverseid\': None}, {\'name\': \'Dragão Avérneo Escarlate\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'588d6b02-d5c7-4d3d-a831-397cc8195c53\'}, \'multiverseid\': None}]', "[{'name': 'Karplusanischer Wald', 'text': '{T}: Erhöhe deinen Manavorrat um ein farbloses Mana.\\n{T}: Erhöhe deinen Manavorrat um {R} oder {G}. Der Karplusanische Wald fügt dir 1 Schadenspunkt zu.', 'type': 'Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182976&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4e399833-f999-4f05-b365-a65e117951df', 'multiverseId': 182976}, 'multiverseid': 182976}, {'name': 'Foresta karplusana', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a5952489-f0d6-4962-b7f3-ccba51cc58d4'}, 'multiverseid': None}, {'name': 'Forêt de Karpluse', 'text': '{T}: Ajoutez un mana incolore à votre réserve.\\n{T}: Ajoutez {R} ou {G} à votre réserve. La Forêt de Karpluse vous inflige 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184392&type=card', 'language': 'French', 'identifiers': {'scryfallId': '43c5f61f-be6b-4840-805c-466241c90c43', 'multiverseId': 184392}, 'multiverseid': 184392}, {'name': 'カープルーザンの森', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '837290fd-bf22-419f-a4ac-33de5f67c324'}, 'multiverseid': None}, {'name': 'Floresta Karplusana', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '73354146-0582-4503-b118-73815b6f7151'}, 'multiverseid': None}]", "[{'name': 'Kartätsche', 'text': '{T}: Die Kartätsche fügt einer fliegenden Kreatur deiner Wahl 1 Schadenspunkt zu.', 'type': 'Artefaktkreatur', 'flavor': 'Der Paladin des Südens lehrte fliegendes Ungeziefer die Angst vor dem Sturm, der von unten hochregnet.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182939&type=card', 'language': 'German', 'identifiers': {'scryfallId': '187c23df-50a7-48df-bed9-df03e83e55b0', 'multiverseId': 182939}, 'multiverseid': 182939}, {'name': 'Catapulta de metralla', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '73325876-da7a-451d-b946-dd083afe55de'}, 'multiverseid': None}, {'name': 'Catapulte à mitraille', 'text': '{T}: La Catapulte à mitraille inflige 1 blessure à la créature avec le vol ciblée.', 'type': 'Créature-artefact', 'flavor': 'Le Paladin du Sud apprit à la vermine ailée à craindre la pluie qui vient du sol.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184355&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a022f411-6686-4788-ae5d-87aacf440603', 'multiverseId': 184355}, 'multiverseid': 184355}, {'name': 'ぶどう弾カタパルト', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'bde7ce6f-0e02-4d8e-bf8f-ce25c8fd458a'}, 'multiverseid': None}, {'name': 'Catapulta de Metralha', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8042acbf-c23c-4874-9a4f-cd3ac6be2da3'}, 'multiverseid': None}]", "[{'name': 'Kjeldoranische Hofgarde', 'text': '{T}: Aller Kampfschaden, den dir in diesem Zug ungeblockte Kreaturen zufügen würden, wird stattdessen der Kjeldoranischen Hofgarde zugefügt.', 'type': 'Kreatur — Soldat', 'flavor': 'Ehrenhaft im Kampfe, edel im Tode. —Motto der Kjeldoranische Hofgarde', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182663&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3180468d-3227-4105-97f7-40e98fc7a13b', 'multiverseId': 182663}, 'multiverseid': 182663}, {'name': 'Guardia Real kjeldorana', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f89ffeb1-2af2-4f2d-8333-577c312ac14d'}, 'multiverseid': None}, {'name': 'Garde royale du Kjeldor', 'text': '{T}: Toutes les blessures de combat qui devraient vous être infligées ce tour-ci par des créatures non bloquées sont, à la place, infligées à la Garde royale du Kjeldor.', 'type': 'Créature : soldat', 'flavor': '« Nobles dans la bataille, généreux dans la mort. » — Devise de la garde royale du Kjeldor.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184079&type=card', 'language': 'French', 'identifiers': {'scryfallId': '34e96fbc-2412-4f85-8556-5269f9ca0cd3', 'multiverseId': 184079}, 'multiverseid': 184079}, {'name': 'キイェルドーの近衛隊', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b501500f-0ef1-4662-8c41-6fe9b341c7c9'}, 'multiverseid': None}, {'name': 'Guarda Real Kjeldorana', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7f834dd5-daaa-42e9-93f0-5a0d3d240fc8'}, 'multiverseid': None}]", '[{\'name\': \'Knochenhron\', \'text\': \'Immer wenn ein Spieler einen schwarzen Zauberspruch spielt, kannst du {1} bezahlen. Wenn du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Durch tausend Ängste beschmutzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182962&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6107e2c1-5070-4f5d-afe1-41d607063e9d\', \'multiverseId\': 182962}, \'multiverseid\': 182962}, {\'name\': \'Trono de hueso\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'32652951-2066-44f2-b94f-af62c1af064f\'}, \'multiverseid\': None}, {\'name\': "Trône d\'os", \'text\': "À chaque fois qu\'un joueur joue un sort noir, vous pouvez payer {1}. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Souillée par un millier de peurs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184378&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c15bb747-4cbb-4383-a069-d1a36f97be89\', \'multiverseId\': 184378}, \'multiverseid\': 184378}, {\'name\': \'骨の玉座\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21391e5f-d853-4422-993b-dc4abd02251b\'}, \'multiverseid\': None}, {\'name\': \'Trono de Ossos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'74a13a37-79c1-4a00-aa3b-2701a1535062\'}, \'multiverseid\': None}]', '[{\'name\': \'Knochenmauer\', \'text\': \'(Mauern können nicht angreifen.)\\n{B}: Regeneriere die Knochenmauer.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'Eine Skelettmauer, verstärkt durch die Seelen von Verrätern, umringt die Stadt des Paladins des Ostens.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182809&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'365455ee-36ca-4852-af0b-71cddd6ccf74\', \'multiverseId\': 182809}, \'multiverseid\': 182809}, {\'name\': \'Muro de huesos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'371edde1-df03-4cf3-9b3d-86f2ff80b4b0\'}, \'multiverseid\': None}, {\'name\': "Mur d\'ossements", \'text\': "(Les murs ne peuvent pas attaquer.)\\n{B}: Régénérez le Mur d\'ossements.", \'type\': \'Créature : mur\', \'flavor\': "Un mur d\'ossements, renforcé par les âmes des traîtres, entoure la cité du Paladin de l\'Est.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184225&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b11aeb3-0bda-4237-8dd3-a37d44eb61b4\', \'multiverseId\': 184225}, \'multiverseid\': 184225}, {\'name\': \'骨の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c498806b-3a1e-4ac7-81f0-304439beeeda\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Ossos\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c71c538-7b16-43d8-afa3-8c75523ed52c\'}, \'multiverseid\': None}]', '[{\'name\': \'Kochende Erde\', \'text\': \'Kochende Erde fügt einer Kreatur deiner Wahl Schadenspunkte in Höhe der Anzahl der Gebirge, die du kontrollierst, zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Wir waren geschützt gegen Angriffe von vorne, von den Seiten oder von hinten — aber der Magier erwischte uns von unten." —Kriegerveteran\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182860&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8406b490-053d-40cd-bf23-774b6d9dfb7a\', \'multiverseId\': 182860}, \'multiverseid\': 182860}, {\'name\': \'Sacudida telúrica\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e37e51d5-991d-47dd-907e-2140676cd3ed\'}, \'multiverseid\': None}, {\'name\': \'Expectoration tellurique\', \'text\': "L\'Expectoration tellurique inflige à la créature ciblée un nombre de blessures égal au nombre de montagnes que vous contrôlez.", \'type\': \'Rituel\', \'flavor\': "« Nous étions préparés aux attaques de front, de flanc ou de l\'arrière. Mais le mage nous attaqua d\'en dessous. » — Un soldat vétéran.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184276&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdb251ab-324a-4a06-875c-cb7192b5dd94\', \'multiverseId\': 184276}, \'multiverseid\': 184276}, {\'name\': \'大地の飛礫\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f6a7c6a4-6306-432d-b94e-cddcceb4c875\'}, \'multiverseid\': None}, {\'name\': \'Golfada de Terra\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d9602a2-5112-456b-8dbd-8272b6500513\'}, \'multiverseid\': None}]', '[{\'name\': \'Kochende See\', \'text\': \'Zerstöre alle Inseln.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Es ist Mord, es ist der Tod eines Meeres. Sprich nie wieder davon." —Der Herrscher von Atlantis\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182817&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6bb3f58-7058-49ac-9f34-bc08f00fd3e7\', \'multiverseId\': 182817}, \'multiverseid\': 182817}, {\'name\': \'Ebullición\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'118b1ce4-d85a-4195-9c40-a13039062faa\'}, \'multiverseid\': None}, {\'name\': \'Bouillonnement\', \'text\': \'Détruisez toutes les îles.\', \'type\': \'Éphémère\', \'flavor\': "« C\'est un massacre, la mort des mers. Ne m\'en parlez plus jamais. » — Le seigneur de l\'Atlantide.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184233&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'22673d03-dee8-4ac3-9917-d370f07e7710\', \'multiverseId\': 184233}, \'multiverseid\': 184233}, {\'name\': \'沸騰\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de29ca66-db35-413a-bd20-13d50312d6ca\'}, \'multiverseid\': None}, {\'name\': \'Ferver\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0bde3d83-4a1c-4b03-ac09-4d3bed83a496\'}, \'multiverseid\': None}]', '[{\'name\': \'Komposthaufen\', \'text\': \'Immer wenn eine schwarze Karte auf den Friedhof eines Gegners gelegt wird, kannst du eine Karte ziehen.\', \'type\': \'Verzauberung\', \'flavor\': \'Eine Frucht muss erst verrotten, bevor ihr Samen aufgehen kann. —Redewendung der Yavimaya-Elfen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182875&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3f8f9c0c-711e-4bf0-b376-0ecda486ab11\', \'multiverseId\': 182875}, \'multiverseid\': 182875}, {\'name\': \'Abono\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0605a5ec-fa89-4bb5-b444-439a285f5045\'}, \'multiverseid\': None}, {\'name\': \'Compost\', \'text\': "À chaque fois qu\'une carte noire est mise dans l\'un des cimetières de vos adversaires, vous pouvez piocher une carte.", \'type\': \'Enchantement\', \'flavor\': "Le fruit doit pourrir pour que les graines s\'en échappent. — Dicton de la Yavimaya.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184291&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7336aa3d-c400-4308-b31d-38edf8491d89\', \'multiverseId\': 184291}, \'multiverseid\': 184291}, {\'name\': \'たい肥\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f44d469-6f15-4859-a4da-9b6cc6d0bb4a\'}, \'multiverseid\': None}, {\'name\': \'Adubo\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c8e18ed3-2747-4727-872a-f0e6775aa3c3\'}, \'multiverseid\': None}]', "[{'name': 'Korallenmeervolk', 'type': 'Kreatur — Meervolk', 'flavor': 'Das Korallenmeervolk ringt gerne mit seinen Gegnern, um sie dabei unauffällig an den scharfen Kanten ihres Riffes aufzuschlitzen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182706&type=card', 'language': 'German', 'identifiers': {'scryfallId': '002f2e45-7392-44b1-b729-46a15481d19e', 'multiverseId': 182706}, 'multiverseid': 182706}, {'name': 'Tritón del coral', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c0addbb9-3590-4709-a7a6-8fa19d4c38a9'}, 'multiverseid': None}, {'name': 'Ondin des coraux', 'type': 'Créature : ondin', 'flavor': 'Les ondins des coraux aiment lutter contre leurs ennemis, les dépeçant vivants sur les récifs acérés.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184122&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a825cd1a-6950-4cc6-932c-377d687346f7', 'multiverseId': 184122}, 'multiverseid': 184122}, {'name': '珊瑚マーフォーク', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '31520b0b-54cd-4626-a03b-18ba4e7efdf4'}, 'multiverseid': None}, {'name': 'Tritões dos Corais', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1cdeb8e8-ada6-4054-af87-c705d1258bbd'}, 'multiverseid': None}]", "[{'name': 'Korruption', 'text': 'Korruption fügt einer Kreatur oder einem Spieler deiner Wahl Schadenspunkte in Höhe der Anzahl der Sümpfe, die du kontrollierst, zu. Du erhältst so viele Lebenspunkte dazu, wie auf diese Weise Schadenspunkte zugefügt wurden.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182764&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9586836b-b443-41f7-8582-4505a836d1ef', 'multiverseId': 182764}, 'multiverseid': 182764}, {'name': 'Corromper', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ad546f07-07b0-40f6-b7a3-78d1852e74ef'}, 'multiverseid': None}, {'name': 'Corruption', 'text': 'La Corruption inflige à une cible, créature ou joueur, autant de blessures que le nombre de marais que vous contrôlez. Vous gagnez autant de points de vie que de blessures infligées de cette manière.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184180&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2e5def3a-84e8-4a6e-9e3b-bb036c6e8d96', 'multiverseId': 184180}, 'multiverseid': 184180}, {'name': '堕落', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5a3b50ea-a0f3-492f-ad1f-0cd67cc2a852'}, 'multiverseid': None}, {'name': 'Corromper', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1f7bb148-2339-4101-b84a-c13573206f1f'}, 'multiverseid': None}]", '[{\'name\': \'Kriegstrommeln der Goblins\', \'text\': \'Jede Kreatur, die du kontrollierst, kann nicht geblockt werden, außer von zwei oder mehr Kreaturen.\', \'type\': \'Verzauberung\', \'flavor\': \'„Musik bedeutet für Goblins, irgendetwas mit einem Stock zu hauen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182834&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c36c0e27-a73e-456c-a844-25f2f9a47a7f\', \'multiverseId\': 182834}, \'multiverseid\': 182834}, {\'name\': \'Tambores de guerra trasgos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e275c26b-bf0c-4f81-bf01-70ae00982ce2\'}, \'multiverseid\': None}, {\'name\': \'Tambours de guerre gobelins\', \'text\': \'Chaque créature que vous contrôlez ne peut être bloquée excepté par deux créatures ou plus.\', \'type\': \'Enchantement\', \'flavor\': "Pour les gobelins, faire de la musique c\'est frapper quelque chose avec un bâton.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184250&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d36c537b-7db6-48bd-8a93-18405eec6335\', \'multiverseId\': 184250}, \'multiverseid\': 184250}, {\'name\': \'ゴブリン・ウォー・ドラム\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e53bad79-cdb0-428b-8fdb-a1d86d7382ac\'}, \'multiverseid\': None}, {\'name\': \'Tambores de Guerra dos Goblins\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab62c4d5-9da9-4650-9010-7db09969aebf\'}, \'multiverseid\': None}]', '[{\'name\': \'Kristallstab\', \'text\': \'Immer wenn ein Spieler einen blauen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, erhältst du 1 Lebenspunkt dazu.\', \'type\': \'Artefakt\', \'flavor\': \'Durch tausend Wellen blankpoliert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182931&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86026c96-8547-4b5b-adbd-9d5b6de897db\', \'multiverseId\': 182931}, \'multiverseid\': 182931}, {\'name\': \'Vara de cristal\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1cd6bf0c-eda1-4695-9e4e-96d7e5a005aa\'}, \'multiverseid\': None}, {\'name\': \'Baguette de cristal\', \'text\': "À chaque fois qu\'un joueur joue un sort bleu, vous pouvez payer {1}. Si vous faites ainsi, vous gagnez 1 point de vie.", \'type\': \'Artefact\', \'flavor\': \'Polie par un millier de vagues.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184347&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5210cc5-4541-4a41-a9dc-bf1bc8212281\', \'multiverseId\': 184347}, \'multiverseid\': 184347}, {\'name\': \'水晶のロッド\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7783f901-8dac-43ff-8060-c96470c2b196\'}, \'multiverseid\': None}, {\'name\': \'Bastão de Cristal\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa0cd46b-0d1a-47d3-97da-7fc44e54913d\'}, \'multiverseid\': None}]', '[{\'name\': \'Krähenfüße\', \'text\': \'Immer wenn eine Kreatur angreift, fügen ihr die Krähenfüße 1 Schadenspunkt zu.\', \'type\': \'Artefakt\', \'flavor\': \'Der Paladin des Ostens kannte die Vorliebe seines Rivalen des Südens für Pferde und bereitete ihm einen stachligen Empfang.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182928&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e18316e4-60c0-41ce-869e-62c7c254b3f1\', \'multiverseId\': 182928}, \'multiverseid\': 182928}, {\'name\': \'Abrojos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'84be6802-d14c-41a4-995f-03c9ebf47af4\'}, \'multiverseid\': None}, {\'name\': \'Chausse-trapes\', \'text\': "À chaque fois qu\'une créature attaque, ces Chausse-trapes lui infligent 1 blessure.", \'type\': \'Artefact\', \'flavor\': "Le Paladin de l\'Est savait combien son rival du Sud aimait les chevaux. Il lui prépara un accueil adapté.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'10386629-866e-4ace-9833-2d21874350f3\', \'multiverseId\': 184344}, \'multiverseid\': 184344}, {\'name\': \'鉄びし\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a4a3c1be-a6f5-4944-8abd-302b00dcb760\'}, \'multiverseid\': None}, {\'name\': \'Estrepes\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'61ced17a-8910-4586-bf46-41b6e1ff5f35\'}, \'multiverseid\': None}]', '[{\'name\': \'Kämpfender Sceada\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Sceada\', \'flavor\': \'Zauberlehrer in ihren Elfenbeintürmen nennen sie die „Himmelshaie". Zauberlehrer auf der Straße haben dafür meist keine Zeit mehr.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182713&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b6aa8d9-890d-4267-8971-c71d623445db\', \'multiverseId\': 182713}, \'multiverseid\': 182713}, {\'name\': \'Draco de lucha\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'559428a5-0652-43af-9310-c3cf5d31441d\'}, \'multiverseid\': None}, {\'name\': \'Drakôn combattant\', \'text\': \'Vol\', \'type\': \'Créature : drakôn\', \'flavor\': "Les érudits dans leurs tours d\'ivoire les appellent les « requins du ciel ». Ceux qui sont sur les routes préfèrent ne pas les appeler.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184129&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'90c6819d-0b78-4129-9e83-f16abea0bb13\', \'multiverseId\': 184129}, \'multiverseid\': 184129}, {\'name\': \'ファイティング・ドレイク\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'40bf752e-fb56-4711-9782-848ae3d5c784\'}, \'multiverseid\': None}, {\'name\': \'Dragonete Combatente\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b92ea88-dbae-4d36-9f7b-5a2c42174b62\'}, \'multiverseid\': None}]', '[{\'name\': \'Köder\', \'text\': \'Alle Kreaturen, die die verzauberte Kreatur blocken können, tun dies.\', \'type\': \'Kreaturenverzauberung\', \'flavor\': \'„Wenn der Wald etwas will, kann kein sterbliches Hirn ihm widerstehen." —Maro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182895&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e8a8d3f-3eda-409f-83b8-1e96abd07426\', \'multiverseId\': 182895}, \'multiverseid\': 182895}, {\'name\': \'Señuelo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'15427bf8-bfd1-4194-a6f3-15a33607692b\'}, \'multiverseid\': None}, {\'name\': \'Leurre\', \'text\': \'Toutes les créatures capables de bloquer la créature enchantée le font.\', \'type\': \'Enchanter : créature\', \'flavor\': \'« Quand la forêt veut quelque chose, aucun esprit mortel ne peut lui résister.» — Maro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184311&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1f1d0c0e-6e0b-40a6-b67b-5ff15a35e33d\', \'multiverseId\': 184311}, \'multiverseid\': 184311}, {\'name\': \'寄せ餌\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b6ddbed2-ff91-4404-9af6-f42d882f0679\'}, \'multiverseid\': None}, {\'name\': \'Isca\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8658a002-5302-471b-bd74-113b63b207e4\'}, \'multiverseid\': None}]', '[{\'name\': \'Langbogenschütze\', \'text\': \'Erstschlag\\nDer Langbogenschütze kann blocken, als ob er Flugfähigkeit hätte.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'Manche glauben, das Blut der Falken fließe durch ihre Adern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182666&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f4ba8838-bdc6-49de-ba07-adeac4ecd6db\', \'multiverseId\': 182666}, \'multiverseid\': 182666}, {\'name\': \'Tirador de arco largo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e264edff-69f5-4b81-bfa3-3463201dfe14\'}, \'multiverseid\': None}, {\'name\': "Archer à l\'arc long", \'text\': "Initiative\\nL\'Archer à l\'arc long peut bloquer comme s\'il avait le vol.", \'type\': \'Créature : soldat\', \'flavor\': \'Le sang du faucon coule-t-il dans leurs veines ?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184082&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'810b8e6f-1a64-4567-98f5-bbefc51f4391\', \'multiverseId\': 184082}, \'multiverseid\': 184082}, {\'name\': \'長弓兵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8ad5e522-15b3-4279-9842-cbd70582c60c\'}, \'multiverseid\': None}, {\'name\': \'Arqueiro de Arco Longo\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'34176787-c67e-4de8-9a2a-2e5075977c24\'}, \'multiverseid\': None}]', "[{'name': 'Lastvieh', 'text': 'Stärke und Widerstandskraft des Lasttiers sind gleich der Anzahl an Kreaturen im Spiel.', 'type': 'Artefaktkreatur', 'flavor': 'Je schwerer die Last, desto härter arbeitet es.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182927&type=card', 'language': 'German', 'identifiers': {'scryfallId': '590a3b35-201c-4aeb-82dc-374da592196b', 'multiverseId': 182927}, 'multiverseid': 182927}, {'name': 'Bestia de carga', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'df393cc4-2063-4db7-b3a7-08c2800c4ec6'}, 'multiverseid': None}, {'name': 'Bête de somme', 'text': 'La Bête de somme a une force et une endurance chacune égale au nombre de créatures en jeu.', 'type': 'Créature-artefact', 'flavor': 'Plus lourde est la charge, plus dur elle travaille.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184343&type=card', 'language': 'French', 'identifiers': {'scryfallId': '146e6e5f-64ef-40db-a341-b25bb87dd740', 'multiverseId': 184343}, 'multiverseid': 184343}, {'name': '役畜', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '5431895b-5b3c-46ed-86a2-72726624fddf'}, 'multiverseid': None}, {'name': 'Besta de Carga', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd82c