85}, 'multiverseid': 182985}, {'name': 'Manantiales sulfurosos', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'c522f70e-64cb-4742-bc88-20e1bc12bdc8'}, 'multiverseid': None}, {'name': 'Sources sulfureuses', 'text': '{T}: Ajoutez un mana incolore à votre réserve.\\n{T}: Ajoutez {B} or {R} à votre réserve. Ces Sources sulfureuses vous infligent 1 blessure.', 'type': 'Terrain', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184401&type=card', 'language': 'French', 'identifiers': {'scryfallId': '68664a7d-1f88-4b5f-b432-b3e3c6e832f8', 'multiverseId': 184401}, 'multiverseid': 184401}, {'name': '硫黄泉', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'da51a460-9e8e-4b2f-8d66-8d2abc6bed0c'}, 'multiverseid': None}, {'name': 'Fontes Sulfurosas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '80b2981d-9a9f-4c71-b665-cf9f215ecda6'}, 'multiverseid': None}]", '[{\'name\': \'Schwere Ballista\', \'text\': \'{T}: Die schwere Ballista fügt einer angreifenden oder blockenden Kreatur deiner Wahl 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Soldat\', \'flavor\': \'18 Goblins, 11 Bolde, 22 23 Skelette —Strichliste, eingeritzt in die Ballista\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182659&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'692d0ef8-8820-4c17-af2c-55e26ab4f0c7\', \'multiverseId\': 182659}, \'multiverseid\': 182659}, {\'name\': \'Balista pesada\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'811ea0ac-3658-438f-be93-1c8cb8d2a9b3\'}, \'multiverseid\': None}, {\'name\': \'Baliste lourde\', \'text\': \'{T}: La Baliste lourde inflige 2 blessures à la créature attaquante ou bloqueuse ciblée.\', \'type\': \'Créature : soldat\', \'flavor\': "« Les soldats s\'épuisent et les ennemis tombent, mais jamais la baliste ne fatigue.» — Un capitaine de baliste.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184075&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'51fe962c-0b27-42e1-8db3-d9410f018908\', \'multiverseId\': 184075}, \'multiverseid\': 184075}, {\'name\': \'重バリスタ部隊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c2e1294-ae70-4399-affd-9b1e378199e3\'}, \'multiverseid\': None}, {\'name\': \'Balista Pesada\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a3abf35a-3c29-4b40-9348-d81f5e10bbc5\'}, \'multiverseid\': None}]', '[{\'name\': \'Schwermut\', \'text\': \'Immer wenn ein Gegner eine Karte abwirft, fügt Schwermut diesem Spieler 2 Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'Erinnerungen, aus dem Gehirn verbannt, können äußerst wehtun.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182786&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fc9580bd-cd1a-4453-a4bc-17ce1a243f5d\', \'multiverseId\': 182786}, \'multiverseid\': 182786}, {\'name\': \'Jaqueca\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e1edf41-f3d5-4993-b3e9-ac349ff53022\'}, \'multiverseid\': None}, {\'name\': \'Céphalalgie\', \'text\': "À chaque fois qu\'un adversaire se défausse d\'une carte, la Céphalalgie lui inflige 2 blessures.", \'type\': \'Enchantement\', \'flavor\': \'« Cloués au sol, de honte et de céphalalgies … » — Arthur Rimbaud, Poésies.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184202&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a9757e0c-e892-4e0e-bcc0-788e41dce356\', \'multiverseId\': 184202}, \'multiverseid\': 184202}, {\'name\': \'偏頭痛\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d049e62c-6f72-4308-a40b-0545f34f4057\'}, \'multiverseid\': None}, {\'name\': \'Enxaqueca\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d83b1b89-6141-42a1-99a3-d8b74142a2a5\'}, \'multiverseid\': None}]', '[{\'name\': \'Schwertmauer\', \'text\': \'(Mauern können nicht angreifen.)\\nFliegend\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'Schärfer als der Wind, leichter als die Luft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9bfc0706-79a7-473f-989e-2dc271c8f07e\', \'multiverseId\': 182695}, \'multiverseid\': 182695}, {\'name\': \'Muro de espadas\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c1fb420d-b013-459f-912b-7068b3313ad2\'}, \'multiverseid\': None}, {\'name\': "Mur d\'épées", \'text\': \'(Les murs ne peuvent pas attaquer.)\\nVol\', \'type\': \'Créature : mur\', \'flavor\': "Plus aiguisé que le vent, plus léger que l\'air.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184111&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d8da7452-734d-48d8-9756-3109302e541c\', \'multiverseId\': 184111}, \'multiverseid\': 184111}, {\'name\': \'剣の壁\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'083bb7b1-9534-4ba1-a26f-02f2444d379e\'}, \'multiverseid\': None}, {\'name\': \'Barreira de Espadas\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35402ce7-68a8-48ab-8461-f7b63c5b0aab\'}, \'multiverseid\': None}]', '[{\'name\': \'Seelenlose Zombies\', \'type\': \'Kreatur — Zombie\', \'flavor\': \'„Sie stöhnten und bewegten sich, erhoben sich alsbald, Sie sprachen nicht, die Augen starr; Selbst in \\\'nem Traum wär\\\'s sonderbar, Die Toten aufersteh\\\'n zu seh\\\'n, die blassen Leichen kalt." —Samuel Taylor Coleridge, „Die Ballade vom alten Seemann"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182801&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'90003ae7-ffad-4e35-bf05-1748216d3e68\', \'multiverseId\': 182801}, \'multiverseid\': 182801}, {\'name\': \'Zombies dañinos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'afcbe50e-58ce-427e-9ff0-5806520c8dfc\'}, \'multiverseid\': None}, {\'name\': \'Zombies dévastateurs\', \'type\': \'Créature : zombie\', \'flavor\': "« Comme un nageur venant du profond de son plonge Tous sortent de la mort, comme l\'on sort d\'un songe. » —Agrippa d\'Aubigné, La résurrection des morts", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184217&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'706834ef-f2fb-4277-9dc8-3f8c1c00a50c\', \'multiverseId\': 184217}, \'multiverseid\': 184217}, {\'name\': \'スケイズ・ゾンビ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7ecd9b5a-3121-4cb8-8af5-e741cf1659e3\'}, \'multiverseid\': None}, {\'name\': \'Zumbis de Scathe\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b74f29b6-477e-445c-b1b0-4c934012edbb\'}, \'multiverseid\': None}]', '[{\'name\': \'Seelenmahlzeit\', \'text\': \'Ein Spieler deiner Wahl verliert 4 Lebenspunkte, und du erhältst 4 Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': \'Du bist, was du isst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182803&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0e7a226-3f79-48ce-8b04-131d40627f81\', \'multiverseId\': 182803}, \'multiverseid\': 182803}, {\'name\': \'Festín de alma\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a736daf-26a1-4c72-8667-231901eece8e\'}, \'multiverseid\': None}, {\'name\': "Festin d\'âmes", \'text\': \'Le joueur ciblé perd 4 points de vie et vous gagnez 4 points de vie.\', \'type\': \'Rituel\', \'flavor\': \'Vous êtes ce que vous mangez.\', \