 None}]', '[{\'name\': \'Verborgenes Wissen\', \'text\': \'Wenn das Verborgene Wissen zu Beginn des Ziehsegments eines Spielers nicht getappt ist, zieht dieser Spieler zusätzlich eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Die Legende sagt, dass auch das Wissen derer verborgen ist, die vergeblich danach gesucht haben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182940&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c72a738-c6eb-4051-991b-c4893f1ddc2c\', \'multiverseId\': 182940}, \'multiverseid\': 182940}, {\'name\': \'Mina aullante\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13016cb1-8c32-40a9-83c5-615292b8c2f6\'}, \'multiverseid\': None}, {\'name\': \'Mine rugissante\', \'text\': "Au début de l\'étape de pioche de chaque joueur, si la Mine rugissante est dégagée, ce joueur pioche une carte.", \'type\': \'Artefact\', \'flavor\': \'La légende veut que la mine crie les derniers mots de ceux qui y sont morts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184356&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ac50b2b8-bb11-4161-9ea5-70a829094ded\', \'multiverseId\': 184356}, \'multiverseid\': 184356}, {\'name\': \'吠えたける鉱山\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ecae2f56-cd6f-46ea-9deb-dbac7eda9f26\'}, \'multiverseid\': None}, {\'name\': \'Mina Uivadora\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e96c9dd1-aea2-4fa8-a99f-2c8193c53ce9\'}, \'multiverseid\': None}]', "[{'name': 'Verbrannte Steppe', 'text': 'Jeder Spieler opfert vier Länder. Verbrannte Steppe fügt jeder Kreatur 4 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': 'Feuer ist in der Nahrungskette immer ganz oben, und es hat gewaltigen Appetit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182868&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9761402b-c2f2-497c-b13b-355fe20fe728', 'multiverseId': 182868}, 'multiverseid': 182868}, {'name': 'Incendio destructor', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7b09b028-2f1b-43b8-b180-52a5ae6e4b9c'}, 'multiverseid': None}, {'name': 'Feu dévastateur', 'text': 'Chaque joueur sacrifie quatre terrains. Le Feu dévastateur inflige 4 blessures à chaque créature.', 'type': 'Rituel', 'flavor': 'Le feu est au sommet de la chaîne alimentaire, et il a un gros appétit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184284&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0742ee85-9cbb-4d8b-bc84-804385566e74', 'multiverseId': 184284}, 'multiverseid': 184284}, {'name': '燎原の火', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0d1e6749-037d-484b-a4d2-d764b3ba86b9'}, 'multiverseid': None}, {'name': 'Fogo Grego', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0dff5e77-4a50-4f48-948a-7534bce05d38'}, 'multiverseid': None}]", '[{\'name\': \'Vereinsamung\', \'text\': \'Immer wenn eine grüne Kreatur aus dem Spiel auf einen Friedhof gelegt wird, wirft ihr Beherrscher eine Karte aus seiner Hand ab.\', \'type\': \'Verzauberung\', \'flavor\': \'Kummer ist ein Messer, das die Seele verletzt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182760&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'acd1cda0-fc32-4554-9690-e7db68d5090a\', \'multiverseId\': 182760}, \'multiverseid\': 182760}, {\'name\': \'Desconsuelo\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c041dd2e-597e-430e-bf6d-aa3ff8cb0f4f\'}, \'multiverseid\': None}, {\'name\': \'Deuil\', \'text\': "À chaque fois qu\'une créature verte est mise depuis le jeu dans un cimetière, son contrôleur choisit une carte de sa main et s\'en défausse.", \'type\': \'Enchantement\', \'fla