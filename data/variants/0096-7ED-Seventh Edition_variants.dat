'identifiers\': {\'scryfallId\': \'326aa964-83d8-4ed5-855c-c6fb344903e8\', \'multiverseId\': 184251}, \'multiverseid\': 184251}, {\'name\': \'花崗岩の装着\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'efd9e202-bfac-4fc3-89e5-2686d0fe02f6\'}, \'multiverseid\': None}, {\'name\': \'Aperto de Granito\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'252ebd96-f841-4a1a-9ea0-91be3561b259\'}, \'multiverseid\': None}]', "[{'name': 'Grizzlybären', 'type': 'Kreatur — Bär', 'flavor': 'Sie haben Klauen, so lang wie dein Arm. Und sie sind grantig, verdammt grantig sogar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182891&type=card', 'language': 'German', 'identifiers': {'scryfallId': '31ceddb2-b03b-4b9e-b9ee-920202f3c222', 'multiverseId': 182891}, 'multiverseid': 182891}, {'name': 'Osos pardos', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8935727d-136f-424e-bf68-79ac95d2f29d'}, 'multiverseid': None}, {'name': 'Grizzlis', 'type': 'Créature : ours', 'flavor': 'Ils ont des griffes grandes comme vos bras. Et ils sont grognons. Oui, très très grognons.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184307&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cef8f1e9-6ff5-46a4-9a98-75f5d0a64ee1', 'multiverseId': 184307}, 'multiverseid': 184307}, {'name': '灰色熊', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2a07ec1e-12c1-497c-ac9f-a69fb18558e6'}, 'multiverseid': None}, {'name': 'Ursos Cinzentos', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a81f4ef2-f3d7-4f74-a8ff-b8adea939cce'}, 'multiverseid': None}]", '[{\'name\': \'Gruftratten\', \'text\': \'{X}: Gruftratten fügen jeder Kreatur und jedem Spieler X Schadenspunkte zu. Du kannst dabei nur schwarzes Mana ausgeben.\', \'type\': \'Kreatur — Ratte\', \'flavor\': \'Fürchte alles, was zwischen den Toten geboren wurde. —Tolarianisches Sprichwort\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182765&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5dfa5e56-a49d-4952-8396-ba8967ff6f11\', \'multiverseId\': 182765}, \'multiverseid\': 182765}, {\'name\': \'Ratas de cripta\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'90b2d1b1-6e36-4c3f-9f5e-8108aac0c468\'}, \'multiverseid\': None}, {\'name\': \'Rats des cryptes\', \'text\': \'{X}: Ces Rats des cryptes infligent X blessures à chaque créature et à chaque joueur. Ne dépensez que du mana noir de cette manière.\', \'type\': \'Créature : rat\', \'flavor\': "Méfiez-vous de tout ce qui naît d\'entre les morts. — Dicton tolarian.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184181&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'48b173c7-b6bb-4070-b280-4af99c8fb178\', \'multiverseId\': 184181}, \'multiverseid\': 184181}, {\'name\': \'墓所のネズミ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'13db8f12-a1e5-433f-951d-3419136c5369\'}, \'multiverseid\': None}, {\'name\': \'Ratos da Cripta\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e842515f-985e-47c9-9c70-e8bab4cf7369\'}, \'multiverseid\': None}]', '[{\'name\': \'Habgier\', \'text\': \'{B}, bezahle 2 Lebenspunkte: Ziehe eine Karte.\', \'type\': \'Verzauberung\', \'flavor\': \'Ein Berater fragte einst den Paladin des Westens, wieviel Gold denn genug sei. „Ich brauche keine Leute, die das Wort \\\'genug\\\' kennen," antwortete dieser der Leiche des Beraters.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182780&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce713bbc-576b-4b25-aef8-cedf2930ca00\', \'multiverseId\': 182780}, \'multiverseid\': 182780}, {\'name\': \'Avaricia\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2ee6a40e-7b23-4709-900b-213662c4fc84\'}, \'multiverseid\': None}, {\'name\': \'Avidité\', \'text\': \'{B}, payez 2 points de vie : Piochez une carte.\', \'type\': \'Enchantement\', \'flavor\': "Un conseiller demanda un jour au Paladin de l\'Ouest quand il aurait assez d\'or. « J\'ai rayé le mot assez de mon vocabulaire », dit-il au cadavre du conseiller.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184196&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f958e5b9-c2f2-4ffc-84e2-c9bc17791e13\', \'multiverseId\': 184196}, \'multiverseid\': 184196}, {\'name\': \'強欲\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d073ee15-28c5-47c9-a0e0-d3654c7d9d68\'}, \'multiverseid\': None}, {\'name\': \'Cobiça\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'afd31a37-8461-4702-ab20-4d24b7b171e3\'}, \'multiverseid\': None}]', '[{\'name\': \'Heer der geplagten Skelette\', \'text\': \'{B}: Regeneriere das Heer der geplagten Skelette.\', \'type\': \'Kreatur — Skelett\', \'flavor\': \'„Die Toten geben gute Soldaten ab. Sie können keine Befehle verweigern, sie geben nie auf, und sie hören nicht auf zu kämpfen, wenn mal ein Körperteil abgeschlagen wird." —Nevinyrral, Handbuch für Zauberer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182770&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7bb76557-051e-4fa0-982e-4bfaaf8db1cf\', \'multiverseId\': 182770}, \'multiverseid\': 182770}, {\'name\': \'Esqueletos esclavos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'894679df-5f58-4d56-b42e-67c121eddd56\'}, \'multiverseid\': None}, {\'name\': \'Squelettes serviles\', \'text\': \'{B}: Régénérez ces Squelettes serviles.\', \'type\': \'Créature : squelette\', \'flavor\': \'« Les morts font de bons soldats. Ils ne peuvent désobéir, ils ne se rendent pas, et ils ne cessent pas le combat quand un morceau de leur corps vient à tomber. » —Nevinyrral, Le manuel du nécromancien.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184186&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad01de19-68d9-41e5-83f2-94642cb5a0f9\', \'multiverseId\': 184186}, \'multiverseid\': 184186}, {\'name\': \'蠢く骸骨\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10881d75-351c-4ce3-8225-7c09d681fe63\'}, \'multiverseid\': None}, {\'name\': \'Esqueletos de Carga\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35382ecf-4722-4761-9ad4-766769f35709\'}, \'multiverseid\': None}]', '[{\'name\': \'Heilbalsam\', \'text\': \'Bestimme eines ein Spieler deiner Wahl erhält 3 Lebenspunkte dazu, oder verhindere in diesem Zug die nächsten 3 Schadenspunkte bei einer Kreatur oder einem Spieler deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182658&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'763f524c-a25e-47f7-9297-6b8583739703\', \'multiverseId\': 182658}, \'multiverseid\': 182658}, {\'name\': \'Bálsamo de curación\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1113b309-1358-40b2-a5ba-3a82d31bdf7d\'}, \'multiverseid\': None}, {\'name\': \'Onguent de soins\', \'text\': "Choisissez l\'un Le joueur ciblé gagne 3 points de vie ; ou prévenez, ce tour-ci, les prochaines 3 blessures sur une cible, créature ou joueur.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184074&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fb7b0d9-2067-4c47-a2fc-faa751a9cff1\', \'multiverseId\': 184074}, \'multiverseid\': 184074}, {\'name\': \'