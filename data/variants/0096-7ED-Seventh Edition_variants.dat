ntifiers\': {\'scryfallId\': \'88440d88-f2b3-4231-a791-54e690c24c63\'}, \'multiverseid\': None}, {\'name\': \'Dernière chance\', \'text\': \'Jouez un autre tour après celui-ci. À la fin de ce tour supplémentaire, vous perdez la partie.\', \'type\': \'Éphémère\', \'flavor\': "Une récompense ne sert à rien à qui n\'est plus là pour en profiter.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184238&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'715587fb-5555-4f89-8ad1-45b7088169d2\', \'multiverseId\': 184238}, \'multiverseid\': 184238}, {\'name\': \'最後の賭け\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ba655445-a716-4659-9c46-5fb28c0af27a\'}, \'multiverseid\': None}, {\'name\': \'Último Recurso\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'286a4671-e65b-4cdd-80db-78eee09eb3f8\'}, \'multiverseid\': None}]', '[{\'name\': \'Levitation\', \'text\': \'Alle Kreaturen, die du kontrollierst, erhalten Flugfähigkeit.\', \'type\': \'Verzauberung\', \'flavor\': \'„Wir werden einfache Ziele abgeben, wenn wir am Boden bleiben. Also lasst uns sie besuchen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=182722&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5abcdfe2-c871-4af0-aa5c-82eac96e2031\', \'multiverseId\': 182722}, \'multiverseid\': 182722}, {\'name\': \'Levitación\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c68bdf2e-819c-489e-af44-29129ae8e682\'}, \'multiverseid\': None}, {\'name\': \'Lévitation\', \'text\': \'Les créatures que vous contrôlez acquièrent le vol.\', \'type\': \'Enchantement\', \'flavor\': \'« Si nous restons au sol, nous mourrons. Voyons plus haut. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=184138&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'900516da