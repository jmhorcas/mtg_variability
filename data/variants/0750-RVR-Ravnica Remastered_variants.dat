7c9b091d6c', 'e807cd52-bb7f-5533-a102-4e778e1acf57', 'e81b17c8-5751-526b-8612-924961d3c8a2', 'e856cf15-5286-549c-978b-c8909ffc049c', 'e870fc49-bc66-597d-9358-f9c619e2253a', 'e938dc7f-ea45-5b77-bc6e-f74d7b8bdac7', 'e9f06643-500a-506a-af9a-8f1bf5a94014', 'ea693da6-0e0f-5918-90ca-fcc495686418', 'ed38f842-66b5-5ef0-bb1a-b94e3241a9ab', 'edd62b1e-4ebe-5020-8198-6753cb07a5a5', 'eee3d0d0-92af-5bcd-be4c-537ca04da1f1', 'ef3f4db2-4f06-5d4a-8564-bf20df2e693f', 'efb0fe1f-f7b0-549d-a228-a1c0cd5fdf99', 'f079cabc-bd03-5053-8664-f2e5bfc85389', 'f1ce2100-1e42-5e0e-81be-b43d1d809ba4', 'f38ae5ea-9a27-586c-b8fe-3e5ad128386a', 'f3d01673-38e3-5bcc-9398-e1532d60fdd5', 'f426d0db-3313-5b3e-b772-6be8f56685e1', 'f4572c70-0036-53ec-9056-fdc2aac7c1b7', 'f5752ece-001d-56b3-ae4d-13574c06bfb3', 'f6b4489c-e7b8-52d3-99b3-86622aa570ce', 'f6f55ff6-4732-52c2-abdc-c7e55e977ab7', 'f7a0cd3c-426f-51a1-b177-9a6e5de31492', 'f85bb025-9a63-508c-9a67-175acbc3edd7', 'f8a745ce-a14d-5904-86ee-3292817b78aa', 'f8f11bea-c250-5a10-b1b4-6e9e41d18916', 'f962ccde-01f2-5212-b6a8-32c0cd371fe3', 'f9d3b5c0-7dd7-59e6-a734-0ce56abca954', 'fb65c72a-2eb4-5dd4-8ba9-7f06b6654205', 'fb99d587-b4f6-5628-bfd2-d0d2fac0ca9f', 'fc38f24d-79f3-54dc-806d-bed67b85b8aa', 'fd178608-defb-5a4c-9053-f6bc67bd4eef', 'fd357ed3-16bd-59f6-b9d9-fd439a7ef2c8', 'fd96dbc7-215f-52bc-a349-9b9b07effbef', 'fe3c014f-3a72-57b4-8c2e-b37249050bf6', 'feb86dfd-50dd-55c3-8b72-7fe71f329fb8', 'ff04e8c6-5650-5078-9d22-2d9629049e79', 'ff706d32-ee22-5e83-bd31-223ea1d853e7']
watermark: ['azorius', 'boros', 'dimir', 'golgari', 'gruul', 'izzet', 'orzhov', 'rakdos', 'selesnya', 'simic']
border: []
