name: ['Arclight Phoenix', 'Birthing Pod', 'Bloodbraid Elf', 'Bogardan Hellkite', 'Chrome Mox', 'Deathrite Shaman', 'Dragonlord Ojutai', 'Elite Spellbinder', "Elspeth, Sun's Champion", 'Emry, Lurker of the Loch', 'Genesis', 'Glimpse of Nature', 'Heritage Druid', 'Lightning Helix', "Lim-Dûl's Vault", 'Lin Sivvi, Defiant Hero', 'Lotus Field', "Mishra's Factory", "Nashi, Moon Sage's Scion", 'Necropotence', 'Nicol Bolas, God-Pharaoh', 'Ponder', 'Shark Typhoon', 'Shivan Dragon', 'Siege Rhino', 'Smokestack', 'Squee, Goblin Nabob', 'Sun Titan', 'Thalia, Heretic Cathar', 'Tradewind Rider', 'Wild Mongrel']
