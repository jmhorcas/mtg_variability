type: ['Artifact', 'Creature — Dog', 'Creature — Dragon', 'Creature — Elf Berserker', 'Creature — Elf Druid', 'Creature — Elf Shaman', 'Creature — Giant', 'Creature — Human Cleric', 'Creature — Incarnation', 'Creature — Phoenix', 'Creature — Rhino', 'Creature — Spirit', 'Enchantment', 'Instant', 'Land', 'Legendary Creature — Elder Dragon', 'Legendary Creature — Goblin', 'Legendary Creature — Human Rebel', 'Legendary Creature — Human Soldier', 'Legendary Creature — Merfolk Wizard', 'Legendary Creature — Rat Ninja', 'Legendary Planeswalker — Bolas', 'Legendary Planeswalker — Elspeth', 'Sorcery']
