avor': None, 'language': 'German', 'identifiers': {'scryfallId': '6a229e36-3bf6-4925-b594-9f3e9b3402d6'}, 'multiverseid': None}, {'name': 'Sierpe selvática', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5ed0503c-1dc1-4aed-9cf6-b79de72f7993'}, 'multiverseid': None}, {'name': 'Guivre des jungles', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '59eaf3eb-94f5-473f-9d70-6c270c6ef297'}, 'multiverseid': None}, {'name': 'Wurm della Giungla', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4a4c386b-7d71-470e-8ffa-b96e3b4bff5b'}, 'multiverseid': None}, {'name': 'ジャングル・ワーム', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e7a4a5d3-ee91-4100-a86c-bfbffd06d273'}, 'multiverseid': None}, {'name': 'Vorme da Selva', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '14bc5e8a-85ee-4e75-a190-fb15a6ddb006'}, 'multiverseid': None}]", "[{'name': 'Dunkle Knechtschaft', 'text': 'Du kannst die Dunkle Knechtschaft auch als Spontanzauber spielen. Wenn Du dies tust, begrabe sie am Ende des Zuges.\\nDie verzauberte Kreatur erhält +3/-1 und ist schwarz.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '8a7afb3c-9f4d-4319-9747-b041dc05afd5'}, 'multiverseid': None}, {'name': 'Servidumbre de la tumba', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6213e9d9-e8eb-4b9e-b8aa-c3eedbbeb605'}, 'multiverseid': None}, {'name': 'Servitude sépulcrale', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '49499dc5-7af4-4162-b066-d1f7c71e7926'}, 'multiverseid': None}, {'name': 'Schiavitù del Sepolcro', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'b6ab7f94-91e0-404a-b7a1-96fcfb7c8628'}, 'multiverseid': None}, {'name': '死の隷従', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2605d2e8-3288-4557-8fad-81fad69d6089'}, 'multiverseid': None}, {'name': 'Servidão à