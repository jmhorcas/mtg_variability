\': \'French\', \'identifiers\': {\'scryfallId\': \'2975291c-2836-4d66-ad61-c19d936781c8\'}, \'multiverseid\': None}, {\'name\': \'Ascari dalla Lancia Infuocata\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1749a6f2-c3af-4213-9bf3-eae9ac7d1110\'}, \'multiverseid\': None}, {\'name\': \'灼熱の槍のアスカーリ\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69f40e06-2b71-4abc-b2d9-3863b62bc479\'}, \'multiverseid\': None}, {\'name\': \'Askári da Lança Cauterizante\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b88957f1-8ace-40db-8a43-83af78bdd654\'}, \'multiverseid\': None}]', "[{'name': 'Asmira, die heilige Rächerin', 'text': 'Fliegend\\nLege am Ende eines Zuges für jede Kreatur, die in diesem Zug aus dem Spiel auf Deinem Friedhof gelandet ist, eine +1/+1 Marke auf Asmira, die heilige Rächerin.', 'type': 'Beschwörung einer Legende', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9715f173-7fc0-4b77-9016-555574b8ed27'}, 'multiverseid': None}, {'name': 'Asmira, Vengadora Sagrada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'bcb7f0ae-511c-47d7-b828-55b23642eab4'}, 'multiverseid': None}, {'name': 'Azmira, sainte vengeresse', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd8e764e1-9257-44bd-bdb6-009ec78feb94'}, 'multiverseid': None}, {'name': 'Asmira, Vendicatrice Sacra', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '47e12234-4906-49cf-a28e-65b6cc73f53f'}, 'multiverseid': None}, {'name': '聖なる報復者アズマイラ', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'aea9ca34-b7b0-469b-8a19-0aaf6e6da6e1'}, 'multiverseid': None}, {'name': 'Asmira, Vingadora Santa', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e3e64487-f8fa-4996-95e6-135523a0deb1'}, 'multiverseid': None}]", "[{'name': 'Atemräuber', 'text': '{B}: +1/-1 bis zum Ende de