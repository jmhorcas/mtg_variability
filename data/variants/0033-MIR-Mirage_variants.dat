76d\'}, \'multiverseid\': None}, {\'name\': "Griffon de l\'ounyaro", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d20ed8a-c37e-4063-9a39-04556f066b3b\'}, \'multiverseid\': None}, {\'name\': \'Grifone di Unyaro\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c6ea2606-ea83-4779-93a1-7006dd532382\'}, \'multiverseid\': None}, {\'name\': \'ウンヤロ・グリフィン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d9d1290-ba42-4250-a7bd-c4e23a6696d5\'}, \'multiverseid\': None}, {\'name\': \'Grifo de Unyaro\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'af2d1829-4eca-4bfb-b75c-9e613b7586be\'}, \'multiverseid\': None}]', '[{\'name\': \'Urborgpanther\', \'text\': \'{B}, opfere den Urborgpanther: Zerstöre eine Kreatur Deiner Wahl, die den Urborgpanther in diesem Zug geblockt hat.\\nOpfere den Wildschatten, den Atemräuber und den Urborgpanther: Durchsuche Deine Bibliothek nach dem Geist der Nachtschrate und bringe ihn direkt ins Spiel, als ob er gerade gesprochen worden wäre. Mische Deine Bibliothek danach neu.\', \'type\': \'Beschwörung eines Nachtschrats\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8e7da18e-a89a-4b2b-8624-a883b955ac82\'}, \'multiverseid\': None}, {\'name\': \'Pantera de Urborg\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9329d01-88d7-4012-8ac3-bc3157b6f7a4\'}, \'multiverseid\': None}, {\'name\': "Panthère d\'Urborg", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4291441-771f-44f5-8b38-d459ddc1535e\'}, \'multiverseid\': None}, {\'name\': \'Pantera di Urborg\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0477389-1de0-4192-9045-43f6401e845a\'}, \'multiverseid\': None}, {\'name\': \'アーボーグの豹\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce225354-161a-4a8b-9d8b-e0680c857550\'}, \'multiverseid\': None}, {\'name\': \'Pantera de Urborg\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e0d7a97-0197-4416-b058-b38eaf52acf3\'}, \'multiverseid\': None}]', "[{'name': 'Urquell', 'text': 'Wenn der Urquell ins Spiel kommt, übernimm die Kontrolle über das verzauberte Land.\\nDu verlierst die Kontrolle über das verzauberte Land am Ende jedes Deiner Züge.\\nDu erhältst die Kontrolle über das verzauberte Land zu Beginn jedes Deiner Züge.', 'type': 'Verzaubere Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '60c5a364-3d94-41ea-88e9-8b531ed62b88'}, 'multiverseid': None}, {'name': 'Manantial', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '724c5126-d278-4e2a-a2d5-838fe5a8fe29'}, 'multiverseid': None}, {'name': 'Puisement à la source', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6c4081e1-2164-466e-ba41-28deebb36f70'}, 'multiverseid': None}, {'name': 'Pozzo Artesiano', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd351382b-996e-45e4-9464-a0299395aa8f'}, 'multiverseid': None}, {'name': '恵みの井戸', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e0375525-e49b-4f41-9479-41e14b00e5bf'}, 'multiverseid': None}, {'name': 'Manancial', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '099258af-f56c-4255-a61a-0e7529f04d1f'}, 'multiverseid': None}]", "[{'name': 'Ursprünglichkeit', 'text': 'Zerstöre alle gezielten Verzauberungen.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1775e7c8-be3d-4658-89cb-4337cf45088a'}, 'multiverseid': None}, {'name': 'Corazón sereno', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0cd6bad7-99a1-4220-babe-310f0e7e4cbe'}, 'multiverseid': None}, {'name': 'Coeur serein', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a3aa3e99-f42f-4c75-a8e3-317c19d18f04'}, 'multiverseid': None}, {'name': 'Cuore Sereno', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '66b8f77c-144a-4c03-b6c2-fa1a5e937f81'}, 'multiverseid': None}, {'name': '心に静寂', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e64cc2b8-a4f9-4aa3-b67e-f62bc5336396'}, 'multiverseid': None}, {'name': 'Coração Sereno', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ffba1d85-27cd-4024-8015-22f448863037'}, 'multiverseid': None}]", "[{'name': 'Verbotene Auktion', 'text': 'Wähle eine Zielkreatur. Jeder Spieler kann Lebenspunkte bieten, um die Kontrolle über diese Kreatur zu übernehmen. Du beginnst Dein Gebot mit 0. Jeder Spieler kann in der Zugreihenfolge das letzte Gebot überbieten. Die Auktion endet, wenn das letzte Gebot nicht mehr überboten wird. Der Bieter des letzten Gebots verliert Lebenspunkte in der Höhe des letzten Gebots und übernimmt die Kontrolle über diese Kreatur.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '5e5c79ed-d436-4488-b018-b08b1f768c9a'}, 'multiverseid': None}, {'name': 'Subasta ilícita', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'aa591e4f-d1b6-4b07-afee-cc439458f2fd'}, 'multiverseid': None}, {'name': 'Enchères illicites', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'fd771e3f-1b62-4bd7-8711-9228f890746b'}, 'multiverseid': None}, {'name': 'Asta Immorale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a5d64f74-9f29-4443-9cc6-9abd0437fd60'}, 'multiverseid': None}, {'name': '無道の競り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '518bcd6c-f378-4413-b669-b65d8bdd7fd0'}, 'multiverseid': None}, {'name': 'Leilão Ilícito', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f7b7574c-0fcc-428f-9699-0a2786b548ef'}, 'multiverseid': None}]", "[{'name': 'Verbotene Krypta', 'text': 'Immer, wenn Du eine Karte ziehen musst, wähle stattdessen eine Karte Deiner Wahl aus Deinem Friedhof und nimm diese auf Deine Hand. Wenn Du dies nicht kannst, verlierst Du das Spiel.\\nImmer wenn eine Karte auf Deinem Friedhof landet, entferne diese Karte ganz aus dem Spiel.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a68e5fbe-077e-4c9d-9a73-b7c926056572'}, 'multiverseid': None}, {'name': 'Cripta prohibida', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '114c1cdb-b9dd-41cb-a4b7-6e6399482467'}, 'multiverseid': None}, {'name': 'Crypte interdite', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '2435fdf4-c56a-4602-ab43-33e0bab49158'}, 'multiverseid': None}, {'name': 'Cripta Proibita', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e2aa6806-0fcb-427b-b4b8-6d3b837577af'}, 'multiverseid': None}, {'name': '禁忌の墓所', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0e68f107-7aa0-4b05-8627-03f8afc12ba9'}, 'multiverseid': None}, {'name': 'Cripta Proibida', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '49a51154-5993-4dcd-b1f2-8d0a08bed714'}, 'multiverseid': None}]", '[{\'name\': \'Verfall\', \'text\': \'Sprich diese Verzauberung nur auf eine schwarze Kreatur.\\nDie verzauberte Kreatur erhält "Kumulative Versorgung: 1 Lebenspunkt."\\nWenn die verzauberte Kreatur auf dem Friedhof landet, verliert der Beherrscher dieser Kreatur 2 Lebenspunkte.\', \'type\': \'Verzaubere Kreatur\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d7af49a-f4d9-48bf-a5a9-73af8b3e27bd\'}, \'multiverseid\': None}, {\'name\': \'Descomposición\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'423a8652-5c78-41e9-85a4-2e5a190c764b\'}, \'multiverseid\': None}, {\'name\': \'Décomposition\', \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b1