ers': {'scryfallId': 'ad9d12b5-3b26-4117-a939-56327114d82b'}, 'multiverseid': None}, {'name': 'Plaine', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'ca7e0b6c-6141-4ecc-9e60-631c54348b06'}, 'multiverseid': None}, {'name': 'Pianura', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1cf7dc55-689d-4746-8bdc-d14fb262ab99'}, 'multiverseid': None}, {'name': '平地', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'cb2be9ac-25a0-457b-a7d6-c66613dc38ca'}, 'multiverseid': None}, {'name': 'Planície', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '420e6b7e-f47c-4c94-b0ba-a24b7220b7c7'}, 'multiverseid': None}]", '[{\'name\': \'Ebenholzamulett\', \'text\': \'Wähle eines aus: Ein Gegner Deiner Wahl verliert 1 Lebenspunkt und Du erhältst 1 Lebenspunkt dazu; entferne bis zu drei Karten aus dem Friedhof eines Spielers ganz aus dem Spiel; oder eine Kreatur Deiner Wahl kann in diesem Zug nur von Artefaktkreaturen oder schwarzen Kreaturen geblockt werden.\\n(korrigierte Version)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'21dd13ba-b761-4f49-9b06-72ea7c41b8b0\'}, \'multiverseid\': None}, {\'name\': \'Amuleto de ébano\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b6f4527e-0bb0-4bd7-a83a-ac03529dcb79\'}, \'multiverseid\': None}, {\'name\': "Charme d\'ébène", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ec722d0-2920-4124-940c-39c9e4fca83e\'}, \'multiverseid\': None}, {\'name\': \'Monile di Ebano\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d1143d93-e021-4e66-8f6d-6f7216ea47dd\'}, \'multiverseid\': None}, {\'name\': \'黒檀の魔除け\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9bbc029c-a7a9-4107-8e60-6d8e8b692fb5\'}, \'multiverseid\': None}, {\'name\': \'Medalhão de Ébano\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e5b6ece-e8b1-4207-8020-3c232a791fcc\'}, \'multiverseid\': None}]', "[{'name': 'Edler Elefant', 'text': 'Bündnisfähigkeit\\nVerursacht Trampelschaden', 'type': 'Beschwörung eines Elefanten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'da15d127-ffaa-44d4-8cbc-68e50b558a43'}, 'multiverseid': None}, {'name': 'Elefante noble', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'b4d956f1-0ad3-4770-866c-bbee1771662b'}, 'multiverseid': None}, {'name': 'Eléphant noble', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '652591e4-f3e1-465b-9980-838f9f1a6edc'}, 'multiverseid': None}, {'name': 'Nobile Elefante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '07c732f6-18ad-441c-a510-725b26135700'}, 'multiverseid': None}, {'name': '気高き象', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '10671013-64ec-46af-aadf-b75fa3cbeba0'}, 'multiverseid': None}, {'name': 'Elefante Majestoso', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3ca903fe-f4cb-48f1-b7e4-73fc7a3d0ed4'}, 'multiverseid': None}]", "[{'name': 'Eindringender Sand', 'text': 'Zerstöre ein Land Deiner Wahl, das kein Sumpf ist. Wenn dieses Land ein Nicht-Standardland ist, fügt der Eindringende Sand dem Beherrscher dieses Landes 2 Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9d622c18-de57-42ee-8d87-c5f9c3a314f0'}, 'multiverseid': None}, {'name': 'Arenas sofocantes', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e8897447-ffd2-4c4f-812e-dc58e48c5eda'}, 'multiverseid': None}, {'name': 'Ensablement', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '602a5f6c-7f3c-4e22-9aa7-ae10958443b1'}, 'multiverseid': None}, {'name': 'Sabbia Soffocante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '68e84812-c3d8-4bec-a1c4-8d1244267004'}, 'multiverseid': None}, {'name': '押し寄せる砂', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '68b74395-c114-4f4f-a9e8-179105a7085f'}, 'multiverseid': None}, {'name': 'Areias Asfixiantes', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2f1cdfec-47da-49e1-b26a-a5e91b9a8fef'}, 'multiverseid': None}]", "[{'name': 'Einmischung', 'text': 'Ein Zauberspruch Deiner Wahl, der eine einzelne Kreatur als Ziel hat, zielt jetzt auf eine andere Kreatur Deiner Wahl. Das neue Ziel muß erlaubt sein.', 'type': 'Unterbrechungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '74e9e7e1-372b-477a-abf0-6f6833c07ea2'}, 'multiverseid': None}, {'name': 'Intromisión', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1f484cc2-3a4c-4083-a292-7fa6d6b9837a'}, 'multiverseid': None}, {'name': 'Ingérence', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b9e5a8ac-6b3d-4334-92f1-7ee64fef21b2'}, 'multiverseid': None}, {'name': 'Interferenza', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '8751ee16-7fdb-4aa1-8866-6ccaece2b1be'}, 'multiverseid': None}, {'name': '干渉', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '012f0452-eb16-469f-9662-f96da1b15212'}, 'multiverseid': None}, {'name': 'Interposição', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2146c220-3547-4cc5-ae04-e1e974e1360b'}, 'multiverseid': None}]", "[{'name': 'Einäscherung', 'text': 'Die Einäscherung fügt einem Spieler oder einer Kreatur Deiner Wahl 3 Schadenspunkte zu. Eine Kreatur, der durch Einäscherung Schaden zugefügt wurde, kann in diesem Zug nicht regenerieren.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '93155a2f-07c1-419d-b341-828f2de72cd5'}, 'multiverseid': None}, {'name': 'Incinerar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'