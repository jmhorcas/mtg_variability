}]", "[{'name': 'Flexibilität', 'text': 'Eine Kreatur Deiner Wahl, die ein verteidigender Spieler kontrolliert, erhält +3/+0 bis zum Ende des Zuges. Diese Kreatur darf deklariert werden, bis zu drei Kreaturen zu blocken. Alle Blocks müssen erlaubt sein.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'd9617242-7350-45a0-bd28-6ed964adc409'}, 'multiverseid': None}, {'name': 'Presteza', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'bc6517cc-7df0-4c90-b854-e195c7704d1f'}, 'multiverseid': None}, {'name': 'Prestesse', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '00cdd48f-fa92-42e2-89f3-e4fc396fdf6d'}, 'multiverseid': None}, {'name': 'Velocità', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '51a5e019-938d-4b48-b6cb-e96c0e8232a0'}, 'multiverseid': None}, {'name': '早技', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8f704b6c-2e29-4d98-b5e2-31f7f7c4e437'}, 'multiverseid': None}, {'name': 'Velocitas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fb5e1d43-e126-4a22-9dce-a5690d1f8bcf'}, 'multiverseid': None}]", "[{'name': 'Frenetischer Ifrit', 'text': 'Fliegend\\n0: Wirf eine Münze. Während die Münze in der Luft ist, entscheidet sich ein Gegner Deiner Wahl für Kopf oder Zahl. Gewinnst Du, destabilisiert sich der Frenetische Ifrit. Ansonsten begrabe den Frenetischen Ifrit.', 'type': 'Beschwörung eines Ifrits', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'f1bb4652-0556-47b2-b64b-fd18131cc8ac'}, 'multiverseid': None}, {'name': 'Efrit exaltado', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'd50fe0db-94a2-4401-bdd7-8166f6a47e60'}, 'multiverseid': None}, {'name': 'Efrit frénétique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bd191af0-e41d-44ae-999a-89f5780d286f'}, 'multiverseid': None}, {'name': 'Efreet Frenetico', 'flavor': None, 'lang