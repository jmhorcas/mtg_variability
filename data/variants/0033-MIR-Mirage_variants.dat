b-6fa2-4424-856c-8cb7c079c906\'}, \'multiverseid\': None}, {\'name\': \'Grifo de Ekundu\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f49580d-3fd0-4214-8a86-22b0d3626f72\'}, \'multiverseid\': None}, {\'name\': "Griffon de l\'Ekoundou", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68e5d727-2293-42e1-b7d6-aee45f685bd4\'}, \'multiverseid\': None}, {\'name\': \'Grifone Ekundu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'288fe73d-a01f-47dc-838e-08dad715c3c8\'}, \'multiverseid\': None}, {\'name\': \'イーカンドゥー・グリフィン\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4123038-ce95-4a77-bb5c-e126e7bc5861\'}, \'multiverseid\': None}, {\'name\': \'Grifo de Ekundu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad55c7a5-dcda-4584-9cf7-7385c64289e3\'}, \'multiverseid\': None}]', '[{\'name\': \'Ekunduzyklop\', \'text\': \'Wenn irgendeine Kreatur, die Du kontrollierst, angreift, dann greift auch der Ekunduzyklop an, wenn möglich.\', \'type\': \'Beschwörung eines Zyklopen\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ece04b08-51a3-473e-a3a8-5586eeed3daa\'}, \'multiverseid\': None}, {\'name\': \'Cíclope de Ekundu\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ab4cdbd6-f6ff-42d6-924e-0d2d59e4f39c\'}, \'multiverseid\': None}, {\'name\': "Cyclope de l\'Ekoundou", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ce71573d-c23b-4a75-8e15-b9dd3dcc8d87\'}, \'multiverseid\': None}, {\'name\': \'Ciclope di Ekundu\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a53d821a-9494-46c4-8c00-e0ef643ec610\'}, \'multiverseid\': None}, {\'name\': \'イーカンドゥー・サイクロプス\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6145822f-0828-4ea9-80c0-696e19138002\'}, \'multiverseid\': None}, {\'name\': \'Cíclope de Ekundu\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3edac740-db09-4051-a739-e6cba33c9007\'}, \'multiverseid\': None}]', '[{\'name\': \'Elfenbeinamulett\', \'text\': \'Wähle eines aus: Alle Kreaturen erhalten -2/-0 bis zum Ende des Zuge; verhindere 1 Schadenspunkt bei einer Kreatur oder einem Spieler; oder tappe eine Kreatur Deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d99a107c-1501-4052-a0ae-f16cc9eaa257\'}, \'multiverseid\': None}, {\'name\': \'Amuleto de marfil\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'93b9d6ee-6a53-4cd3-aba7-28a5fbf09091\'}, \'multiverseid\': None}, {\'name\': "Charme d\'ivoire", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9ecadd70-a1ff-4fcd-90e6-1cea8c2f3f42\'}, \'multiverseid\': None}, {\'name\': \'Monile di Avorio\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03397651-2831-4869-9005-4eab3c20e587\'}, \'multiverseid\': None}, {\'name\': \'象牙の魔除け\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'edb53b9d-f168-47cf-b8f5-e0b94961e9bb\'}, \'multiverseid\': None}, {\'name\': \'Medalhão de Marfim\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1bc7aad4-0b08-4299-97ee-ee032ab59dea\'}, \'multiverseid\': None}]', '[{\'name\': \'Elite-Infanterie der Goblins\', \'text\': \'Wenn die Elite-Infanterie der Goblins blockt oder geblockt wird, erhält sie -1/-1 bis zum Ende des Zuges.\', \'type\': \'Beschwörung von Goblins\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'201dd247-8b2e-4998-b99b-453913e22592\'}, \'multiverseid\': None}, {\'name\': \'Soldados de élite trasgos\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e3a246a-d08f-4855-bd14-3e32586bb291\'}, \'multiverseid\': None}, {\'name\': "Infanterie gobeline d\'élite", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c9fa79a3-db90-474b-b309-e9f7e7c5dfce\'}, \'multiverseid\': None}, {\'name\': \'Fanteria Scelta dei Goblin\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b6a3a382-5e99-4762-853a-ec8e98afab53\'}, \'multiverseid\': None}, {\'name\': \'ゴブリン精鋭歩兵部隊\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d5d01bc2-a29f-4e4f-938b-f34a092104b3\'}, \'multiverseid\': None}, {\'name\': \'Infantaria de Elite dos Goblins\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ee4e639a-4a0b-4688-ad03-7d43805b62e7\'}, \'multiverseid\': None}]', '[{\'name\': \'Energieentladung\', \'text\': \'Die Energieentladung fügt einem Spieler Deiner Wahl X Schadenspunkte zu, oder ein Spieler Deiner Wahl erhält X Lebenspunkte dazu.\', \'type\': \'Hexerei\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ee317fad-ce3a-449f-b668-e7e2fde243cf\'}, \'multiverseid\': None}, {\'name\': \'Destello de energía\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e2ad41c7-7b8f-47c1-a070-9717dc6921f8\'}, \'multiverseid\': None}, {\'name\': "Eclair d\'énergie", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'69d3e843-2fe2-4cd5-abbd-4510f0b48462\'}, \'multiverseid\': None}, {\'name\': \'Dardo Energetico\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e7f37ab-4feb-4d28-8bc4-3e8ec39f9347\'}, \'multiverseid\': None}, {\'name\': \'エネルギー・ボルト\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'64625791-664d-44b9-bd06-0db957bd025c\'}, \'multiverseid\': None}, {\'name\': \'Raio de Energia\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a9d83f8-6fc6-4b77-a52c-fd33156867da\'}, \'multiverseid\': None}]', '[{\'name\': \'Energiestrudel\', \'text\': \'Wähle einen Gegner, wenn der Energiestrudel ins Spiel kommt.\\nEntferne zu Beginn Deiner Versorgungsphase alle Energiemarken vom Energiestrudel.\\nWährend der Versorgungsphase des gewählten Gegners bezahlt dieser pro Energiemarke, die auf dem Energiestrudel liegt, ein farbloses Mana, oder der Energiestrudel fügt ihm 3 Schadenspunkte zu.\\nX: Lege X Energiemarken auf den Energiestrudel. Benutze diese Fähigkeit nur während Deiner Versorgungsphase.\', \'type\': \'Verzauberung\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'15994c9e-2f57-400f-9330-8566d7dcdec1\'}, \'multiverseid\': None}, {\'name\': \'Vórtice de energía\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'99e1337a-30e5-49fa-ae9d-578b047001e7\'}, \'multiverseid\': None}, {\'name\': "Vortex d\'énergie", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'023cde9e-ec65-4863-8d72-e766004a8a7f\'}, \'multiverseid\': None}, {\'name\': \'Vortice di Energia\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'103ec913-3916-49a3-9b7a-f3496c56d869\'}, \'multiverseid\': None}, {\'name\': \'エネルギーの渦\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2058c85-29ea-4d24-a85a-6ab87b119633\'}, \'multiverseid\': None}, {\'name\': \'Vórtice de Energia\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd9388d6-f79a-4df4-be03-11133892b5e7\'}, \'multiverseid\': None}]', "[{'name': 'Entkräftung', 'text': 'Lege ein Artefakt oder eine Verzauberung Deiner Wahl oben auf die Bibliothek seines Besitzers.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'ae90a1aa-7984-4d68-a3f6-438e64c711c7'}, 'multiverseid': None}, {'name': 'Deponer', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7beaf740-e0f8-4ebd-a4f2-d034f27e1a6e'}, 'multiverseid': None}, {'name': 'Ademption', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '48090eea-e27a-4477-bb6b-f93d4b2b4a9e'}, 'multiverseid': None}, {'name': 'Incapacitare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f5b2b4e9-a0ee-4eae-a3c6-b6c0d001db96'}, 'multiverseid': None}, {'name': '力の消滅', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '236276ac-70ad-46b8-af89-9a44bb8462e4'}, 'multiverseid': None}, {'name': 'Desenergizar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cfd29a42-0de0-41fa-ab0c-198771fd8b6a'}, 'multiverseid': None}]", "[{'name': 'Entzauberung', 'text': 'Zerstöre ein Artefakt oder eine Verzauberung Deiner Wahl.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '76b01f43-38ac-49b8-815a-7c74cb5a5d75'}, 'multiverseid': None}, {'name': 'Desencantar', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '59b567b1-5ac0-4ec9-bc74-4313531c1373'}, 'multiverseid': None}, {'name': 'Désenchantement', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a9c59f5b-2942-4658-845f-5f84eca3e686'}, 'multiverseid': None}, {'name': 'Disincantare', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a3e291cd-1e52-4891-ad3a-af51dd4a8bc3'}, 'multiverseid': None}, {'name': '解呪', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '6ec6ef85-c339-4b5b-853a-3e8450c33924'}, 'multiverseid': None}, {'name': 'Desencantar', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '115cfa4b-2ef6-4bf1-a1dd-5820ed8bc5b2'}, 'multiverseid': None}]", "[{'name': 'Erfinders Stolz', 'text': 'Zerstöre X Artefakte Deiner Wahl. Erfinders Stolz fügt jedes Mal, wenn ein Artefakt auf diese Weise auf dem Friedhof landet, dessen Beherrscher 1 Schadenspunkt zu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '27106f02-3593-4ef4-bc69-a61706b98016'}, 'multiverseid': None}, {'name': 'Maldición del artífice', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'fa350e16-a1ee-464d-a5d0-b31cc4314fb7'}, 'multiverseid': None}, {'name': 'Fléau des bâtisseurs', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '61ea4240-3fb7-4253-a36a-76f56ddbf65a'}, 'multiverseid': None}, {'name': 'Rovina del Costruttore', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd1d4ff88-2d8d-4557-8f2c-6bfcf5cbc993'}, 'multiverseid': None}, {'name': '工匠の破滅', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ec1b3be0-73c1-45c4-8e47-38aad20cdded'}, 'multiverseid': None}, {'name': 'Maldição do Construtor', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4347473c-5171-4e0e-bf13-00ad67abc97f'}, 'multiverseid': None}]", "[{'name': 'Erleuchteter Lehrmeister', 'text': 'Durchsuche Deine Bibliothek nach einer Artefaktoder einer Verzauberungskarte und zeige sie allen Spielern. Mische danach Deine Bibliothek neu und lege die gezeigte Karte oben auf Deine Bibliothek.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '93c5ce9e-3f58-4d40-aa41-3138dcc9d185'}, 'multiverseid': None}, {'name': 'Tutora inspirada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7052536f-b90e-430b-8c10-b6805fdec30c'}, 'multiverseid': None}, {'name': 'Préceptrice éclairée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '55910297-921f-4c95-9ba5-92ca42d7d2e0'}, 'multiverseid': None}, {'name': 'Tutore Illuminato', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6c5c2f2f-d7d7-4a13-adbd-87926a98982e'}, 'multiverseid': None}, {'name': '悟りの教示者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2e8bbb3e-1c57-4ca5-9a3e-a0842bdf1a7e'}, 'multiverseid': None}, {'name': 'Tutor Esclarecido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e09ac7e5-ba80-42e4-97fc-624d798470f3'}, 'multiverseid': None}]", "[{'name': 'Erleuchtung', 'text': 'Neutralisiere einen Artefaktspruch oder einen Verzauberungs-spruch Deiner Wahl. Der Urheber dieses Zauberspruchs erhält Lebenspunkte in Höhe der Spruchkosten dazu.', 'type': 'Unterbrechungszauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '277572c2-cae8-4a7e-b52d-6723a803e9d9'}, 'multiverseid': None}, {'name': 'Iluminación', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '438432d7-67b7-41fe-8719-50455c3e4864'}, 'multiverseid': None}, {'name': 'Illumination', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b4b91e49-6f82-4f56-955b-d6b4e77ebe05'}, 'multiverseid': None}, {'name': 'Illuminazione', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '8ac44937-1a43-443d-8e5d-bcae5945f073'}, 'multiverseid': None}, {'name': '光明', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e7278dd3-5559-4c20-9e95-e58286e62e82'}, 'multiverseid': None}, {'name': 'Iluminação', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7b63bb1b-f425-4fcc-b8b5-ad8abedf883d'}, 'multiverseid': None}]", "[{'name': 'Ewiger Geist', 'text': 'Fliegend, Schutz vor Schwarz', 'type': 'Beschwörung eines Engels', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'aee91b0e-4f37-4e6a-87d2-71e275433389'}, 'multiverseid': None}, {'name': 'Espíritu Melesse', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a5fe44e0-ab53-4e05-80d6-a874899d6227'}, 'multiverseid': None}, {'name': 'Esprit méliséen', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a887a212-2ed0-44c5-a3c2-31e7813805e5'}, 'multiverseid': None}, {'name': 'Spirito di Melesse', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4f1ddb66-d2fa-4951-ac59-fc949a66b71e'}, 'multiverseid': None}, {'name': 'メリース・スピリット', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9c6cf4e9-48ea-4bfd-a9fc-7196e41eaedc'}, 'multiverseid': None}, {'name': 'Espírito Melesse', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '90dbcc83-e5e1-4623-9930-82c93dc8dc7e'}, 'multiverseid': None}]", "[{'name': 'Fauliges Gespenst', 'text': 'Fliegend\\n{1}{B}{B}, {T}: Ein Spieler Deiner Wahl wählt eine Karte aus seiner Hand und wirft diese ab oder legt diese Karte oben auf seine Bibliothek. Wenn die Karte abgeworfen wird, fügt das Faulige Gespenst jeder Kreatur und jedem Spieler 1 Schadenspunkt zu. Spiele diese Fähigkeit wie eine Hexerei.', 'type': 'Beschwörung eines Specters', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '38a76405-cab3-4297-8c9e-a1c4463fc255'}, 'multiverseid': None}, {'name': 'Espectro corrompido', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '27ee831c-6900-44e9-bb32-571147a7a691'}, 'multiverseid': None}, {'name': 'Spectre souillé', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '142345bd-f36c-489a-bcea-73e548c7da0b'}, 'multiverseid': None}, {'name': 'Spettro Contaminato', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '70c2c8c3-e9af-4ded-966d-a339f64e56eb'}, 'multiverseid': None}, {'name': '烙印の死霊', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'e643b2fe-a59c-4f34-b0aa-961dc0a0d020'}, 'multiverseid': None}, {'name': 'Espectro Corrompido', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b2535af3-d54f-4eb1-acb7-261b5f126bd1'}, 'multiverseid': None}]", "[{'name': 'Fegefeuer', 'text': 'Immer wenn eine Beschwörungskarte aus dem Spiel auf Deinem Friedhof landet, lege stattdessen diese Karte offen unter das Fegefeuer.\\nDu kannst während Deiner Versorgungsphase 4 und 2 Lebenspunkte zahlen, um eine beliebige Karte, die unter dem Fegefeuer liegt, direkt ins Spiel zu bringen, als ob sie gerade gesprochen worden wäre.\\nWenn das Fegefeuer das Spiel verlässt, entferne alle Kreaturen darunter ganz aus dem Spiel.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7a6cc2b3-38db-468b-847e-a9a203b5e714'}, 'multiverseid': None}, {'name': 'Purgatorio', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '531dbdd2-8092-4ac2-b7e9-078f16a32519'}, 'multiverseid': None}, {'name': 'Purgatoire', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd3d8d512-57c2-4c65-a856-0af4b1656a4c'}, 'multiverseid': None}, {'name': 'Purgatorio', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '10bd6423-edad-4889-aa86-bb2f71146ade'}, 'multiverseid': None}, {'name': '煉獄', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'c8e9d868-a183-485b-84c3-ef2e151d1fc8'}, 'multiverseid': None}, {'name': 'Purgatório', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c136e16f-9985-4493-917a-cbcb7bfa87bd'}, 'multiverseid': None}]", "[{'name': 'Femeref-Späher', 'type': 'Beschwörung von Spähern', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2951624c-2908-4b09-a4b1-35555c24e7c4'}, 'multiverseid': None}, {'name': 'Rastreadores femeref', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5942c8af-33ee-42da-abac-421cfe334d8b'}, 'multiverseid': None}, {'name': 'Eclaireurs fémeirefs', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'da7a1212-3f06-46dc-9f4f-126f6b07e5fd'}, 'multiverseid': None}, {'name': 'Esploratori Femeref', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '088bde58-d43f-454b-b025-889b9e39a109'}, 'multiverseid': None}, {'name': 'フェメレフの斥候', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '8f5e6ba8-2d5e-4448-88e8-1a11fd023f75'}, 'multiv