type: ['Artifact', 'Basic Land — Forest', 'Basic Land — Swamp', 'Creature — Antelope Beast', 'Creature — Bat', 'Creature — Beast', 'Creature — Boar Beast', 'Creature — Dog', 'Creature — Elf', 'Creature — Faerie Rogue', 'Creature — Human Shaman', 'Creature — Human Spellshaper', 'Creature — Lizard', 'Creature — Phyrexian Horror', 'Creature — Plant Wall', 'Creature — Rat', 'Creature — Skeleton', 'Creature — Skeleton Wall', 'Creature — Spirit', 'Creature — Troll', 'Creature — Vampire Skeleton', 'Creature — Wurm', 'Creature — Zombie Mutant', 'Creature — Zombie Warrior', 'Enchantment', 'Enchantment — Aura', 'Instant', 'Land', 'Legendary Planeswalker — Garruk', 'Legendary Planeswalker — Liliana', 'Sorcery', 'Tribal Enchantment — Treefolk Aura']
