geUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217280&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '6d3a5fa1-60f0-4ce3-bd72-11f2a18b1692', 'multiverseId': 217280}, 'multiverseid': 217280}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215792&type=card', 'language': 'French', 'identifiers': {'scryfallId': '5a61c6b2-2bde-4f4a-bec0-c7694a33802c', 'multiverseId': 215792}, 'multiverseid': 215792}, {'name': 'Pianura', 'text': '{W}', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216536&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b78253b3-190e-4b0c-ab1a-2bca8886ac93', 'multiverseId': 216536}, 'multiverseid': 216536}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216784&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6c6cb147-236a-49c6-87a1-af87d484c6f1', 'multiverseId': 216784}, 'multiverseid': 216784}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217032&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6cec415a-6b15-4bef-96a4-4369de24f53e', 'multiverseId': 217032}, 'multiverseid': 217032}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216040&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '00aeda12-65d1-4587-919a-1175f67e4952', 'multiverseId': 216040}, 'multiverseid': 216040}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216288&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '42ce6541-1165-48aa-bb87-d1846a34913f', 'multiverseId': 216288}, 'multiverseid': 216288}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217530&type=card', 'language': 'German', 'identifiers': {'scryfallId': '467e5f93-dc89-4cd2-8c9b-687fb34b3655', 'multiverseId': 217530}, 'multiverseid': 217530}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217282&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4cb5b839-f8e3-40f8-ad6b-0312ab1a0cef', 'multiverseId': 217282}, 'multiverseid': 217282}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215794&type=card', 'language': 'French', 'identifiers': {'scryfallId': '58453b20-f40f-40e5-89df-581a8eb45f7a', 'multiverseId': 215794}, 'multiverseid': 215794}, {'name': 'Pianura', 'text': '{W}', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216538&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c928fde1-8e48-4262-9291-9fccf45a7d06', 'multiverseId': 216538}, 'multiverseid': 216538}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216786&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e30d9586-a9c3-4d74-993e-6fd708fbd7da', 'multiverseId': 216786}, 'multiverseid': 216786}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217034&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '54f6709c-eb4a-44de-83d8-08386405d22d', 'multiverseId': 217034}, 'multiverseid': 217034}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216042&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3098d698-854a-491f-86a0-30ae2f67cccd', 'multiverseId': 216042}, 'multiverseid': 216042}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216290&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd0204400-06c7-4fab-859c-8bf66ab3965d', 'multiverseId': 216290}, 'multiverseid': 216290}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217536&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bbda9d01-9e0f-42da-b08c-59f2ecad7bbd', 'multiverseId': 217536}, 'multiverseid': 217536}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217288&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '659c2f43-1f4d-453d-b212-6aeeb380fc94', 'multiverseId': 217288}, 'multiverseid': 217288}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215800&type=card', 'language': 'French', 'identifiers': {'scryfallId': '320efce0-92cb-4a68-8cef-6158badd4900', 'multiverseId': 215800}, 'multiverseid': 215800}, {'name': 'Pianura', 'text': '{W}', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216544&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b65a8a59-29f4-45f8-9509-c890435132b3', 'multiverseId': 216544}, 'multiverseid': 216544}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216792&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '32d537da-1691-4cc0-995a-152785709860', 'multiverseId': 216792}, 'multiverseid': 216792}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217040&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '74ea1722-435f-4487-8672-ecfe73df6e63', 'multiverseId': 217040}, 'multiverseid': 217040}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216048&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'c0fbeffc-6b27-4a10-8449-24af883a2388', 'multiverseId': 216048}, 'multiverseid': 216048}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216296&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f398162b-616f-49b2-9a1a-b70f1eaacf97', 'multiverseId': 216296}, 'multiverseid': 216296}]", '[{\'name\': \'Echomagier\', \'text\': \'Stufe aufsteigen {1}{U} ({1}{U}: Lege eine Stufenmarke auf diese Karte. Spiele Stufe aufsteigen wie eine Hexerei.)\\nSTUFE 2-3\\n2/4\\n{U}{U}, {T}: Kopiere einen Spontanzauber oder eine Hexerei deiner Wahl. Du kannst neue Ziele für die Kopie bestimmen.\\nSTUFE 4+\\n2/5\\n{U}{U}, {T}: Kopiere einen Spontanzauber oder eine Hexerei deiner Wahl zweimal. Du kannst neue Ziele für die Kopien bestimmen.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217491&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'57c2d015-a516-4063-ae44-4cacb3b2c4b6\', \'multiverseId\': 217491}, \'multiverseid\': 217491}, {\'name\': \'Mago del eco\', \'text\': \'Subir de nivel {1}{U}. ({1}{U}: Pon un contador de nivel sobre esto. Sube de nivel sólo como un conjuro.)\\nNIVEL 2-3\\n2/4\\n{U}{U}, {T}: Copia el hechizo instantáneo o conjuro objetivo. Puedes elegir nuevos objetivos para la copia.\\nNIVEL 4+\\n2/5\\n{U}{U}, {T}: Copia el hechizo instantáneo o conjuro objetivo dos veces. Puedes elegir nuevos objetivos para las copias.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217243&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9467ae14-b711-4750-a6f2-87f51b3f4a8f\', \'multiverseId\': 217243}, \'multiverseid\': 217243}, {\'name\': "Mage d\'écho", \'text\': "Montée de niveau {1}{U} ({1}{U} : Mettez un marqueur « niveau » sur cette créature. Ne montez de niveau que lorsque vous pourriez lancer un rituel.)\\nNIVEAU 2-3\\n2/4\\n{U}{U}, {T} : Copiez le sort d\'éphémère ou de rituel ciblé. Vous pouvez choisir de nouvelles cibles pour cette copie.\\nNIVEAU 4+\\n2/5\\n{U}{U}, {T} : Copiez le sort d\'éphémère ou de rituel ciblé deux fois. Vous pouvez choisir de nouvelles cibles pour ces copies.", \'type\': \'Créature : humain et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215755&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa0a8692-f722-406a-ac84-4c16437c971b\', \'multiverseId\': 215755}, \'multiverseid\': 215755}, {\'name\': "Mago dell\'Eco", \'text\': \'Aumentare di livello {1}{U} ({1}{U}: Metti un segnalino livello su questa creatura. Aumenta di livello solo quando potresti lanciare una stregoneria.)\\nLIVELLO 2-3\\n2/4\\n{U}{U}, {T}: Copia una magia istantaneo o stregoneria bersaglio. Puoi scegliere nuovi bersagli per la copia.\\nLIVELLO 4+\\n2/5\\n{U}{U}, {T}: Copia una magia istantaneo o stregoneria bersaglio due volte. Puoi scegliere nuovi bersagli per le copie.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216499&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'65a89f5b-3229-452c-a11a-2828c2ea4455\', \'multiverseId\': 216499}, \'multiverseid\': 216499}, {\'name\': \'こだまの魔道士\', \'text\': \'Lvアップ {1}{U} ({1}{U}：この上にLvカウンターを１個置く。 Lvアップはソーサリーとしてのみ行う。）\\nLv 2-3\\n2/4\\n{U}{U}, {T}：インスタント呪文１つかソーサリー呪文１つを対象とし、それをコピーする。 あなたはそのコピーの新しい対象を選んでもよい。\\nLv 4+\\n2/5\\n{U}{U}, {T}：インスタント呪文１つかソーサリー呪文１つを対象とし、それを２回コピーする。 あなたはそれらのコピーの新しい対象を選んでもよい。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216747&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'47a74007-1225-4eaf-85a0-20cde7a5d5cc\', \'multiverseId\': 216747}, \'multiverseid\': 216747}, {\'name\': \'Mago do Eco\', \'text\': \'Subir de nível {1}{U} ({1}{U}: Coloque um marcador de nível nesta criatura. Suba de nível somente quando puder jogar um feitiço.)\\nNÍVEL 2-3\\n2/4\\n{U}{U}, {T}: Copie a mágica instantânea ou o feitiço alvo. Você pode escolher novos alvos para a cópia.\\nNÍVEL 4+\\n2/5\\n{U}{U}, {T}: Copie duas vezes a mágica instantânea ou o feitiço alvo. Você pode escolher novos alvos para as cópias.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216995&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3047e8d3-6ecc-4647-8e6f-d221ea79aea9\', \'multiverseId\': 216995}, \'multiverseid\': 216995}, {\'name\': \'Эхомаг\', \'text\': \'Повышение уровня {1}{U} ({1}{U}: положите один жетон уровня на это существо. Повышайте уровень только как волшебство.)\\nУРОВЕНЬ 2-3\\n2/4\\n{U}{U}, {T}: скопируйте целевое мгновенное заклинание или заклинание волшебства. Вы можете выбрать новые цели для этой копии.\\nУРОВЕНЬ 4+\\n2/5\\n{U}{U}, {T}: скопируйте целевое мгновенное заклинание или заклинание волшебства дважды. Вы можете выбрать новые цели для этих копий.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216003&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'98ea56d7-4b73-4eb0-9760-2876669df849\', \'multiverseId\': 216003}, \'multiverseid\': 216003}, {\'name\': \'回声法师\', \'text\': \'升级{1}{U} （{1}{U}：在其上放置一个等级指示物。 升级的时机视同法术。）\\n等级2-3\\n2/4\\n{U}{U}，{T}：复制目标瞬间或法术咒语。 你可以为该复制品选择新的目标。\\n等级4+\\n2/5\\n{U}{U}，{T}：将目标瞬间或法术咒语复制两次。 你可以为每个复制品选择新的目标。\', \'type\': \'生物～人类／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216251&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4882de7c-ab20-40e8-95e5-2278e7a166fd\', \'multiverseId\': 216251}, \'multiverseid\': 216251}]', '[{\'name\': \'Einsamer Missionar\', \'text\': \'Wenn der Einsame Missionar ins Spiel kommt, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Kreatur — Kor, Mönch\', \'flavor\': \'Seine Mission ist zu einer grausigen Pilgerreise zu den von Eldrazi heimgesuchten Außenposten von Zendikar geworden. Aber er marschiert einsam weiter, so unaufhaltsam wie der kommende Morgen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217305&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f827caff-2456-4766-a8e7-badc35de2eed\', \'multiverseId\': 217305}, \'multiverseid\': 217305}, {\'name\': \'Misionero solitario\', \'text\': \'Cuando el Misionero solitario entre al campo de batalla, ganas 4 vidas.\', \'type\': \'Criatura — Monje kor\', \'flavor\': \'Su misión se ha convertido en un triste peregrinaje, una gira por los destacamentos destruidos por los eldrazi en todo Zendikar. Aun así camina solo, testarudo como el amanecer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217057&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4cecbd2c-ab83-42b2-8362-75538bb91b98\', \'multiverseId\': 217057}, \'multiverseid\': 217057}, {\'name\': \'Missionnaire solitaire\', \'text\': \'Quand le Missionnaire solitaire arrive sur le champ de bataille, vous gagnez 4 points de vie.\', \'type\': \'Créature : kor et moine\', \'flavor\': "Sa mission, la visite des avant-postes frappés par les Eldrazi dans tout Zendikar, est devenue un triste pèlerinage. Mais il s\'évertue à continuer tout seul, aussi têtu que l\'aube quotidienne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215569&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e41471f4-2c8b-4170-8fce-68d23c4cf4c4\', \'multiverseId\': 215569}, \'multiverseid\': 215569}, {\'name\': \'Missionario Solitario\', \'text\': \'Quando il Missionario Solitario entra nel campo di battaglia, guadagni 4 punti vita.\', \'type\': \'Creatura — Monaco Kor\', \'flavor\': \'La sua missione è diventata un macabro pellegrinaggio, un giro degli avamposti colpiti dagli Eldrazi in tutto Zendikar. Ma continua a marciare da solo, ostinato come lo spuntar del giorno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216313&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dac84008-a525-48a5-a0fc-4c5ba2a7681f\', \'multiverseId\': 216313}, \'multiverseid\': 216313}, {\'name\': \'孤独な宣教師\', \'text\': \'孤独な宣教師が戦場に出たとき、あなたは４点のライフを得る。\', \'type\': \'クリーチャー — コー・モンク\', \'flavor\': \'エルドラージの被害を受けた開拓地を廻る彼の旅は、やがて悲惨な巡礼となっていく。 しかし彼は独り、日々上る朝日のように断固として歩き続ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216561&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c1fcf8a2-933f-40fa-a3ce-bbbba957a301\', \'multiverseId\': 216561}, \'multiverseid\': 216561}, {\'name\': \'Missionário Solitário\', \'text\': \'Quando Missionário Solitário entra no campo de batalha, você ganha 4 pontos de vida.\', \'type\': \'Criatura — Kor Monge\', \'flavor\': \'Sua missão se tornou uma peregrinação sinistra, uma viagem através dos postos avançados golpeados pelos Eldrazi por toda Zendikar. Mas ele continua a marchar sozinho, obstinado como a aurora diária.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09ebd3b6-190b-4553-b462-4b79382bfc70\', \'multiverseId\': 216809}, \'multiverseid\': 216809}, {\'name\': \'Миссионер-Одиночка\', \'text\': \'Когда Миссионер-Одиночка выходит на поле битвы, вы получаете 4 жизни.\', \'type\': \'Существо — Кор Монах\', \'flavor\': \'Его миссия превратилась в мрачное паломничество, поход по отдаленным поселениям Зендикара, подвергшимся нападению Эльдрази. Но он продолжает свой путь — в одиночестве, упрямый, как утренний рассвет.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215817&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5f564439-6f4d-4ec8-b101-1ef15505ffde\', \'multiverseId\': 215817}, \'multiverseid\': 215817}, {\'name\': \'独行传教士\', \'text\': \'当独行传教士进战场时，你获得4点生命。\', \'type\': \'生物～寇族／修行僧\', \'flavor\': \'他的任务已成为灰暗的朝圣路途，在赞迪卡各处遭奥札奇袭击的哨站之间前进。 但他依旧独身前行，一如每日坚持升起的朝阳。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216065&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce4cd75b-3dd5-4587-8b9c-d2d1b8fd0827\', \'multiverseId\': 216065}, \'multiverseid\': 216065}]', '[{\'name\': \'Eldrazi-Tempel\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{T}: Erhöhe deinen Manavorrat um {2}. Verwende dieses Mana nur, um farblose Eldrazi-Zaubersprüche zu wirken oder Fähigkeiten von farblosen Eldrazi zu aktivieren.\', \'type\': \'Land\', \'flavor\': \'Jeder Tempel ist ein Durchgang in eine schreckliche Zukunft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217522&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20c75f22-0058-46e3-a3a4-d16c69e0b314\', \'multiverseId\': 217522}, \'multiverseid\': 217522}, {\'name\': \'Templo eldrazi\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{T}: Agrega {2} a tu reserva de maná. Usa este maná sólo para lanzar hechizos Eldrazi incoloros o para activar habilidades de Eldrazi incoloros.\', \'type\': \'Tierra\', \'flavor\': \'Cada templo es una puerta a un horrible futuro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217274&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fb513e3e-4389-4ae6-9c2d-931ce9b7821a\', \'multiverseId\': 217274}, \'multiverseid\': 217274}, {\'name\': \'Temple eldrazi\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{T} : Ajoutez {2} à votre réserve. Ne dépensez ce mana que pour lancer des sorts incolores d\'eldrazi ou activer les capacités d\'eldrazi incolores.", \'type\': \'Terrain\', \'flavor\': "Chaque temple est une porte s\'ouvrant sur un avenir horrible.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215786&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7dcc252d-8490-47ed-aea5-25d18ecb9307\', \'multiverseId\': 215786}, \'multiverseid\': 215786}, {\'name\': \'Tempio Eldrazi\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{T}: Aggiungi {2} alla tua riserva di mana. Spendi questo mana solo per lanciare magie Eldrazi incolori o attivare abilità di Eldrazi incolori.\', \'type\': \'Terra\', \'flavor\': \'Ogni tempio è una porta verso un futuro orribile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216530&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bcd1a551-8249-4cac-98e4-7aa605f7d68c\', \'multiverseId\': 216530}, \'multiverseid\': 216530}, {\'name\': \'エルドラージの寺院\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{T}：あなたのマナ・プールに{2}を加える。 このマナは、無色のエルドラージ呪文を唱えるためか、無色のエルドラージの能力を起動するためにのみ支払える。\', \'type\': \'土地\', \'flavor\': \'寺院はどれも恐怖の未来への扉だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216778&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24842d65-f807-4152-be16-a0b1fd642ec0\', \'multiverseId\': 216778}, \'multiverseid\': 216778}, {\'name\': \'Templo dos Eldrazi\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{T}: Adicione {2} à sua reserva de mana. Gaste este mana somente para conjurar mágicas do tipo Eldrazi incolores ou ativar habilidades do tipo Eldrazi incolores.\', \'type\': \'Terreno\', \'flavor\': \'Cada templo é uma porta para um futuro horrível.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217026&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'40143bd2-cfb5-4687-ae47-77a652d25700\', \'multiverseId\': 217026}, \'multiverseid\': 217026}, {\'name\': \'Храм Эльдрази\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{T}: добавьте {2} в ваше хранилище маны. Тратьте эту ману только на разыгрывание бесцветных заклинаний Эльдрази или на активацию способностей бесцветных Эльдрази.\', \'type\': \'Земля\', \'flavor\': \'Каждый храм — это дверь в ужасное будущее.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216034&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'25cc1e47-ec77-40d1-8bdb-92fbee8e2c57\', \'multiverseId\': 216034}, \'multiverseid\': 216034}, {\'name\': \'奥札奇殿堂\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{T}：加{2}到你的法术力池中。 此法术力只能用来施放无色奥札奇咒语，或是起动无色奥札奇的起动式异能。\', \'type\': \'地\', \'flavor\': \'每座殿堂都是通往可怕未来的门户。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216282&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'28da069e-8894-4ff1-aca6-2242beaf9bcb\', \'multiverseId\': 216282}, \'multiverseid\': 216282}]', '[{\'name\': \'Eldrazi-Zwangsverpflichtung\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +10/+10, Vernichter 2 und verursacht Trampelschaden. (Immer wenn sie angreift, opfert der verteidigende Spieler zwei bleibende Karten.)\', \'type\': \'Stammesverzauberung — Eldrazi, Aura\', \'flavor\': \'Schon die kleinste Kostprobe der Macht der Eldrazi zerstört sowohl Kontinente als auch Persönlichkeiten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217353&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0d2baf5f-b0d0-4074-9e89-f88ece4917fe\', \'multiverseId\': 217353}, \'multiverseid\': 217353}, {\'name\': \'Conscripción eldrazi\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +10/+10 y tiene las habilidades de arrollar y aniquilador 2. (Siempre que ataque, el jugador defensor sacrifica dos permanentes.)\', \'type\': \'Encantamiento tribal — Aura eldrazi\', \'flavor\': \'La más mínima porción del poder de los eldrazi destruye reinos e identidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217105&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9658edac-e580-437d-adc1-2867c485abe4\', \'multiverseId\': 217105}, \'multiverseid\': 217105}, {\'name\': \'Conscription eldrazi\', \'text\': "Enchanter : créature\\nLa créature enchantée gagne +10/+10 et a le piétinement et annihilateur 2. (À chaque fois qu\'elle attaque, le joueur défenseur sacrifie deux permanents.)", \'type\': \'Enchantement tribal : eldrazi et aura\', \'flavor\': \'La moindre étincelle de puissance eldrazi détruit les royaumes tout comme les identités.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215617&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc8c3bc9-7482-46d1-81d6-812404c71f77\', \'multiverseId\': 215617}, \'multiverseid\': 215617}, {\'name\': \'Arruolamento Eldrazi\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +10/+10 e ha travolgere e annientatore 2. (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica due permanenti.)\', \'type\': \'Incantesimo Tribale — Aura Eldrazi\', \'flavor\': \'Il mero assaggio del potere degli Eldrazi distrugge sia i reami che le identità.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216361&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2b622598-3516-47c8-b325-4754182c6c77\', \'multiverseId\': 216361}, \'multiverseid\': 216361}, {\'name\': \'エルドラージの徴兵\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは＋10/＋10の修整を受けるとともにトランプルと「滅殺 ２」を持つ。 （それが攻撃するたび、防御プレイヤーはパーマネントを２つ生け贄に捧げる。）\', \'type\': \'部族エンチャント — エルドラージ・オーラ\', \'flavor\': \'エルドラージの力をほんの少し味わうだけで、、王国と自我の両方が粉砕される。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216609&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ca92b2b-84d6-4226-bbb1-132f16b4bea4\', \'multiverseId\': 216609}, \'multiverseid\': 216609}, {\'name\': \'Conscrição dos Eldrazi\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +10/+10 e tem atropelar e aniquilador 2. (Toda vez que esta criatura ataca, o jogador defensor sacrifica duas permanentes.)\', \'type\': \'Encantamento Tribal — Aura Eldrazi\', \'flavor\': \'Até mesmo uma pequena fração do poder dos Eldrazi é suficiente para destruir reinos e identidades.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216857&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a7a538e9-ce75-4210-80ab-f3343ffc9eb1\', \'multiverseId\': 216857}, \'multiverseid\': 216857}, {\'name\': \'Мобилизация Эльдрази\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +10/+10 и имеет Пробивной удар и Аннигилятор 2. (Каждый раз когда оно атакует, защищающийся игрок приносит в жертву два перманента.)\', \'type\': \'Племенные Чары — Эльдрази Аура\', \'flavor\': \'Малейший вкус власти Эльдрази заставляет пошатнуться и чужие царства, и даже самосознание.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215865&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9c1b95ce-e76a-4628-90e5-7a7871ac9bf7\', \'multiverseId\': 215865}, \'multiverseid\': 215865}, {\'name\': \'奥札奇征召\', \'text\': \'结附于生物\\n所结附的生物得+10/+10并具有践踏异能与歼灭2。 （每当它攻击时，防御牌手牺牲两个永久物。）\', \'type\': \'部族结界～奥札奇／灵气\', \'flavor\': \'奥札奇最赤裸裸的力量能打破境界与认同。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216113&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1497c014-f9f7-4e2f-93f8-8b17616a8da0\', \'multiverseId\': 216113}, \'multiverseid\': 216113}]', '[{\'name\': \'Emrakul, die zerfetzten Zeitalter\', \'text\': \'Emrakul, die zerfetzten Zeitalter kann nicht neutralisiert werden.\\nWenn du Emrakul wirkst, erhältst du nach diesem Zug einen zusätzlichen Zug.\\nFliegend, Schutz vor farbigen Zaubersprüchen, Vernichter 6\\nWenn Emrakul von irgendwoher auf den Friedhof gelegt wird, mischt sein Besitzer seinen Friedhof in seine Bibliothek.\', \'type\': \'Legendäre Kreatur — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217324&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'de6b3547-2041-4fa6-b8f0-5368e5b32b20\', \'multiverseId\': 217324}, \'multiverseid\': 217324}, {\'name\': \'Emrakul, los eones desgarrados\', \'text\': \'Emrakul, los eones desgarrados no puede ser contrarrestado.\\nCuando lances a Emrakul, toma un turno adicional después de éste.\\nVuela, protección contra hechizos de color, aniquilador 6.\\nCuando Emrakul vaya a un cementerio desde cualquier parte, su propietario baraja su cementerio en su biblioteca.\', \'type\': \'Criatura legendaria — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217076&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d0f216b-9778-436b-a3c6-31e714ab26f2\', \'multiverseId\': 217076}, \'multiverseid\': 217076}, {\'name\': \'Emrakul, Déchirure des Éons\', \'text\': "Emrakul, Déchirure des Éons ne peut pas être contrecarré.\\nQuand vous lancez Emrakul, jouez un tour supplémentaire après celui-ci.\\nVol, protection contre les sorts colorés, annihilateur 6\\nQuand Emrakul est mis dans un cimetière depuis n\'importe où, son propriétaire mélange son cimetière à sa bibliothèque.", \'type\': \'Créature légendaire : eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215588&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbd28474-3a18-40f1-b899-24808216113e\', \'multiverseId\': 215588}, \'multiverseid\': 215588}, {\'name\': \'Emrakul, lo Strazio Eterno\', \'text\': \'Emrakul, lo Strazio Eterno non può essere neutralizzato.\\nQuando lanci Emrakul, gioca un altro turno dopo questo.\\nVolare, protezione dalle magie colorate, annientatore 6\\nQuando Emrakul viene messo in un cimitero da qualsiasi zona, il suo proprietario rimescola il suo cimitero nel suo grimorio.\', \'type\': \'Creatura Leggendaria — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216332&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'64c49535-93f7-4a0e-82c1-aef423edceaf\', \'multiverseId\': 216332}, \'multiverseid\': 216332}, {\'name\': \'引き裂かれし永劫、エムラクール\', \'text\': \'引き裂かれし永劫、エムラクールは打ち消されない。\\nあなたが引き裂かれし永劫、エムラクールを唱えたとき、このターンに続いて追加の１ターンを行う。\\n飛行、プロテクション（有色の呪文）、滅殺 ６\\n引き裂かれし永劫、エムラクールがいずれかの領域からいずれかの墓地に置かれたとき、オーナーは自分の墓地を自分のライブラリーに加えて切り直す。\', \'type\': \'伝説のクリーチャー — エルドラージ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216580&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bfe9ce2c-596c-4ea4-9800-2a5be65ca1c9\', \'multiverseId\': 216580}, \'multiverseid\': 216580}, {\'name\': \'Emrakul, o Fragmento dos Éons\', \'text\': \'Emrakul, o Fragmento dos Éons, não pode ser anulado.\\nQuando conjurar Emrakul, jogue um turno extra após este.\\nVoar, proteção contra mágicas coloridas, aniquilador 6\\nQuando Emrakul é colocado num cemitério vindo de qualquer lugar, seu dono embaralha seu próprio cemitério em seu próprio grimório.\', \'type\': \'Criatura Lendária — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216828&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b32fef92-13e9-4489-9123-8d63dd5a7137\', \'multiverseId\': 216828}, \'multiverseid\': 216828}, {\'name\': \'Эмракул, Изорванная Вечность\', \'text\': \'Эмракул, Изорванная Вечность не может быть отменен.\\nКогда вы разыгрываете Эмракула, сделайте дополнительный ход вслед за этим.\\nПолет, Защита от цветных заклинаний, Аннигилятор 6\\nКогда Эмракул попадает откуда-либо на кладбище, его владелец втасовывает свое кладбище в свою библиотеку.\', \'type\': \'Легендарное Существо — Эльдрази\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215836&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ca875a3f-c5ea-4897-b70f-28822867596c\', \'multiverseId\': 215836}, \'multiverseid\': 215836}, {\'name\': \'万世创伤伊莫库\', \'text\': \'万世创伤伊莫库不能被反击。\\n当你施放伊莫库时，于本回合后进行额外的一个回合。\\n飞行，反有色咒语保护，歼灭6\\n当伊莫库从任何地方置入坟墓场时，其拥有者将其坟墓场洗入其牌库。\', \'type\': \'传奇生物～奥札奇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216084&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb277b7e-ddb3-4145-8bdd-bd9c1c96b7e7\', \'multiverseId\': 216084}, \'multiverseid\': 216084}]', '[{\'name\': \'Emrakuls Amme\', \'text\': \'Wenn Emrakuls Amme ins Spiel kommt, bringe drei 0/1 farblose (Eldrazi, Ausgeburt)-Kreaturenspielsteine ins Spiel. Sie haben „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Kreatur — Eldrazi, Drohne\', \'flavor\': \'Wortlos führt sie ihre widerliche Brut an.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217348&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb8713f4-401f-446d-976f-8656730e6141\', \'multiverseId\': 217348}, \'multiverseid\': 217348}, {\'name\': \'Incubador de Emrakul\', \'text\': \'Cuando el Incubador de Emrakul entre al campo de batalla, pon en el campo de batalla tres fichas de criatura Engendro Eldrazi incoloras 0/1. Tienen "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Criatura — Zángano eldrazi\', \'flavor\': \'Sin palabras, lidera su aberrante progenie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217100&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9a1db65-deea-4ec6-9b34-887e22a7ef2c\', \'multiverseId\': 217100}, \'multiverseid\': 217100}, {\'name\': "Couveur d\'Emrakul", \'text\': "Quand le Couveur d\'Emrakul arrive sur le champ de bataille, mettez sur le champ de bataille trois jetons de créature 0/1 incolore Eldrazi et Engeance. Ils ont « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »", \'type\': \'Créature : eldrazi et drone\', \'flavor\': \'Il dirige son engeance répugnante sans un mot.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215612&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'557ca5e1-7064-4a63-bc69-b7f7e82a7e2f\', \'multiverseId\': 215612}, \'multiverseid\': 215612}, {\'name\': \'Incubatrice di Emrakul\', \'text\': \'Quando l\\\'Incubatrice di Emrakul entra nel campo di battaglia, metti sul campo di battaglia tre pedine creatura Progenie Eldrazi 0/1 incolori. Hanno "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Creatura — Parassita Eldrazi\', \'flavor\': \'Senza una parola guida la sua ripugnante covata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216356&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a9bc71dc-76c1-4be6-9c9f-1f6d3ab27249\', \'multiverseId\': 216356}, \'multiverseid\': 216356}, {\'name\': \'エムラクールの孵化者\', \'text\': \'エムラクールの孵化者が戦場に出たとき、無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを３体戦場に出す。 それらは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'クリーチャー — エルドラージ・ドローン\', \'flavor\': \'それは黙ったまま忌まわしき子らを率いる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216604&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9cdc31e-cdd5-416b-9a9e-5804984eef2a\', \'multiverseId\': 216604}, \'multiverseid\': 216604}, {\'name\': \'Incubador de Emrakul\', \'text\': \'Quando Incubador de Emrakul entrar no campo de batalha, coloque no campo de batalha três fichas de criatura incolor 0/1 do tipo Prole Eldrazi. Elas têm "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\', \'type\': \'Criatura — Zangão Eldrazi\', \'flavor\': \'Silenciosamente, ele lidera sua ninhada abominável.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216852&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66bfa176-14b5-4806-904a-6ba5dd2946ee\', \'multiverseId\': 216852}, \'multiverseid\': 216852}, {\'name\': \'Высиживатель Эмракула\', \'text\': \'Когда Высиживатель Эмракула выходит на поле битвы, положите на поле битвы три фишки существа 0/1 бесцветный Эльдрази Порождение. У них есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\', \'type\': \'Существо — Эльдрази Дрон\', \'flavor\': \'Бессловно он ведет вперед свое мерзкое потомство.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215860&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3d22893-b563-4218-8006-1d8039a223a5\', \'multiverseId\': 215860}, \'multiverseid\': 215860}, {\'name\': \'伊莫库育恶兽\', \'text\': \'当伊莫库育恶兽进战场时，将三个0/1无色奥札奇／后裔衍生物放进战场。 它们具有「牺牲此生物：加{1}到你的法术力池中。」\', \'type\': \'生物～奥札奇／奴兽\', \'flavor\': \'不用多加说明，它正是自己可憎巢窝的领袖。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216108&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e49d838d-2999-40ce-b887-84bcbd637fa4\', \'multiverseId\': 216108}, \'multiverseid\': 216108}]', '[{\'name\': \'Emrakuls Hand\', \'text\': \'Du kannst vier (Eldrazi, Ausgeburt) opfern, anstatt die Manakosten von Emrakuls Hand zu bezahlen.\\nVernichter 1 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler eine bleibende Karte.)\', \'type\': \'Kreatur — Eldrazi\', \'flavor\': \'„Ich glaubte an eine wunderschöne Göttin. Aber das hier ist das wahre Gesicht der Himmlischen." —Ayli, Klerikerin von Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217433&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'89b463d5-f0ad-48ab-b117-82b1c8ed19f6\', \'multiverseId\': 217433}, \'multiverseid\': 217433}, {\'name\': \'Mano de Emrakul\', \'text\': \'Puedes sacrificar cuatro Engendro Eldrazi en lugar de pagar el coste de maná de la Mano de Emrakul.\\nAniquilador 1. (Siempre que esta criatura ataque, el jugador defensor sacrifica un permanente.)\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'"Yo creía en una diosa hermosa. Pero éste es el verdadero rostro de la divinidad." —Ayli, clériga de Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217185&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f61737df-c640-492c-84eb-9d919f805ba9\', \'multiverseId\': 217185}, \'multiverseid\': 217185}, {\'name\': "Main d\'Emrakul", \'text\': "Vous pouvez sacrifier quatre permanents Eldrazi et Engeance à la place de payer le coût de mana de la Main d\'Emrakul.\\nAnnihilateur 1 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie un permanent.)", \'type\': \'Créature : eldrazi\', \'flavor\': \'« Je croyais en un dieu de beauté. Mais ceci est le vrai visage du divin. » —Ayli, clerc de Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215697&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'376b4d83-5eca-4886-917e-f4acb7bba75d\', \'multiverseId\': 215697}, \'multiverseid\': 215697}, {\'name\': \'Mano di Emrakul\', \'text\': \'Puoi sacrificare quattro Progenie Eldrazi invece di pagare il costo di mana della Mano di Emrakul.\\nAnnientatore 1 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica un permanente.)\', \'type\': \'Creatura — Eldrazi\', \'flavor\': \'"Credevo in una divinità meravigliosa. Ma questo è il vero volto del divino." —Ayli, chierica di Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216441&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8923d717-8e31-40b9-92cb-7a23cd6eecc2\', \'multiverseId\': 216441}, \'multiverseid\': 216441}, {\'name\': \'エムラクールの手\', \'text\': \'あなたはエムラクールの手のマナ・コストを支払うのではなく、エルドラージ・落し子を４体生け贄に捧げてもよい。\\n滅殺 １ （このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを１つ生け贄に捧げる。）\', \'type\': \'クリーチャー — エルドラージ\', \'flavor\': \'「私は美しき神を信じていました。 しかし、これが神の真の顔です。」 ――カムサの僧侶、アイリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216689&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dfc68b60-2b64-477e-a2ee-7e8a276a87ee\', \'multiverseId\': 216689}, \'multiverseid\': 216689}, {\'name\': \'Mão de Emrakul\', \'text\': \'Você pode sacrificar quatro Prole Eldrazi em vez de pagar o custo de mana de Mão de Emrakul.\\nAniquilador 1 (Toda vez que esta criatura ataca, o jogador defensor sacrifica uma permanente.)\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'"Eu acredito num deus belo. Mas esta é a verdadeira face do divino." — Ayli, clérigo de Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216937&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cada69c8-0ec2-49c1-82a6-768664069130\', \'multiverseId\': 216937}, \'multiverseid\': 216937}, {\'name\': \'Рука Эмракула\', \'text\': \'Вы можете пожертвовать четыре Эльдрази Порождения вместо уплаты мана-стоимости Руки Эмракула.\\nАннигилятор 1 (Каждый раз когда это существо атакует, защищающийся игрок приносит в жертву один перманент.)\', \'type\': \'Существо — Эльдрази\', \'flavor\': \'«Я верила в прекрасного бога. Но вот оно, истинное лицо божестенного». — Айли, служительница Камсы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215945&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'788d59dd-9264-475a-a050-6b0d5688b3d6\', \'multiverseId\': 215945}, \'multiverseid\': 215945}, {\'name\': \'伊莫库之手\', \'text\': \'你可以牺牲四个同时为奥札奇与后裔的永久物，而不支付伊莫库之手的法术力费用。\\n歼灭1 （每当此生物攻击时，防御牌手牺牲一个永久物。）\', \'type\': \'生物～奥札奇\', \'flavor\': \'「我所崇敬的是位美丽神明。 但这才是神明的真实面貌。」 ～肯莎僧侣艾栗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216193&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a88ec962-e99c-4824-8c1f-e5ea9964b5b0\', \'multiverseId\': 216193}, \'multiverseid\': 216193}]', '[{\'name\': \'Enatu-Golem\', \'text\': \'Wenn der Enatu-Golem aus dem Spiel auf einen Friedhof gelegt wird, erhältst du 4 Lebenspunkte dazu.\', \'type\': \'Artefaktkreatur — Golem\', \'flavor\': \'Golems, die aus den Trümmern des Tempels von Enatu erschaffen wurden, gaben eine robuste und entbehrliche erste Verteidigungslinie gegen die Eldrazi ab.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217438&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29e145f8-91d2-47bd-a54a-cf2ffdd6f5fe\', \'multiverseId\': 217438}, \'multiverseid\': 217438}, {\'name\': \'Gólem de Enatu\', \'text\': \'Cuando el Gólem de Enatu vaya a un cementerio desde el campo de batalla, ganas 4 vidas.\', \'type\': \'Criatura artefacto — Gólem\', \'flavor\': \'Los gólems invocados de los restos del Templo de Enatu sirvieron como una sólida y a la vez prescindible primera línea de defensa contra los eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217190&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01f448b9-133e-4697-92ce-eb147a85d386\', \'multiverseId\': 217190}, \'multiverseid\': 217190}, {\'name\': "Golem d\'Enatu", \'text\': "Quand le Golem d\'Enatu est mis dans un cimetière depuis le champ de bataille, vous gagnez 4 points de vie.", \'type\': \'Créature-artefact : golem\', \'flavor\': "Les golems conjurés à partir des débris du Temple d\'Enatu fournirent une solide première ligne de défense, certes sacrifiable, contre les Eldrazi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215702&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1db4b46d-9486-4bdb-8c03-b1eaae1aafcf\', \'multiverseId\': 215702}, \'multiverseid\': 215702}, {\'name\': \'Golem di Enatu\', \'text\': \'Quando il Golem di Enatu viene messo in un cimitero dal campo di battaglia, guadagni 4 punti vita.\', \'type\': \'Creatura Artefatto — Golem\', \'flavor\': \'I golem evocati dalle macerie del Tempio Enatu fornirono una prima linea di difesa solida ma spendibile contro gli Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216446&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9f776527-7478-4542-90ba-550123a7d1cd\', \'multiverseId\': 216446}, \'multiverseid\': 216446}, {\'name\': \'エナートゥのゴーレム\', \'text\': \'エナートゥのゴーレムが戦場からいずれかの墓地に置かれたとき、あなたは４点のライフを得る。\', \'type\': \'アーティファクト・クリーチャー — ゴーレム\', \'flavor\': \'エナートゥ寺院の瓦礫から生み出されたゴーレムは、エルドラージに対し頑強な使い捨ての防衛最前線となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216694&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5bc98c01-f68d-4c59-98b5-17d140b3fdfd\', \'multiverseId\': 216694}, \'multiverseid\': 216694}, {\'name\': \'Golem de Enatu\', \'text\': \'Quando Golem de Enatu é colocado num cemitério vindo do campo de batalha, você ganha 4 pontos de vida.\', \'type\': \'Criatura Artefato — Golem\', \'flavor\': \'Os golens conjurados a partir dos destroços do Templo de Enatu proporcionaram uma primeira linha de defesa robusta mas descartável contra os Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216942&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1ebbc8b5-86cd-453a-a2f8-331927faa8ec\', \'multiverseId\': 216942}, \'multiverseid\': 216942}, {\'name\': \'Голем Энату\', \'text\': \'Когда Голем Энату попадает с поля битвы на кладбище, вы получаете 4 жизни.\', \'type\': \'Артефактное Существо — Голем\', \'flavor\': \'Големы, созданные из заколдованных обломков храма Энату, обеспечивали крепкий, но невосстанавливаемый передний край обороны против Эльдрази.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215950&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a8dac691-c460-4e89-a57d-6d83a23e4639\', \'multiverseId\': 215950}, \'multiverseid\': 215950}, {\'name\': \'依拿图魔像\', \'text\': \'当依拿图魔像从战场进入坟墓场时，你获得4点生命。\', \'type\': \'神器生物～魔像\', \'flavor\': \'用依拿图殿堂残骸所召唤出的魔像，提供了对抗奥札奇时坚实又可当炮灰的第一道防线。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216198&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c91e4608-374f-4e19-a18c-faae9fd95133\', \'multiverseId\': 216198}, \'multiverseid\': 216198}]', '[{\'name\': \'Engelherz-Phiole\', \'text\': \'Immer wenn dir Schaden zugefügt wird, kannst du ebenso viele Ladungsmarken auf die Engelherz-Phiole legen.\\n{2}, {T}, entferne vier Ladungsmarken von der Engelherz-Phiole: Du erhältst 2 Lebenspunkte dazu und ziehst eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Sie enthält ein Flüstern von Iona: „Haltet durch!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217312&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d8c392cd-9207-428d-b8d8-a24556443440\', \'multiverseId\': 217312}, \'multiverseid\': 217312}, {\'name\': \'Frasco corazón de ángel\', \'text\': \'Siempre que recibas daño, puedes poner esa misma cantidad de contadores de carga sobre el Frasco corazón de ángel.\\n{2}, {T}, remover cuatro contadores de carga del Frasco corazón de ángel: Gana 2 vidas y roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'Contiene un susurro de Iona: "Resiste".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217064&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5d610f3-f4f3-468b-b67f-e6ae3e053724\', \'multiverseId\': 217064}, \'multiverseid\': 217064}, {\'name\': "Fiole de cœur d\'ange", \'text\': "À chaque fois que vous subissez des blessures, vous pouvez mettre autant de marqueurs « charge » sur la Fiole de cœur d\'ange.\\n{2}, {T}, retirez quatre marqueurs « charge » de la Fiole de cœur d\'ange : Vous gagnez 2 points de vie et vous piochez une carte.", \'type\': \'Artefact\', \'flavor\': "Elle contient un murmure d\'Iona : « Persévère. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215576&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b933436-bbaf-4ed8-843e-489648275636\', \'multiverseId\': 215576}, \'multiverseid\': 215576}, {\'name\': \'Fiala del Cuore Angelico\', \'text\': \'Ogniqualvolta ti viene inflitto danno, puoi mettere altrettanti segnalini carica sulla Fiala del Cuore Angelico.\\n{2}, {T}, Rimuovi quattro segnalini carica dalla Fiala del Cuore Angelico: Guadagni 2 punti vita e peschi una carta.\', \'type\': \'Artefatto\', \'flavor\': \'Contiene un sussurro di Iona: "Perseverare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216320&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ebee6251-952f-47ab-ab2e-b0bd6ccd19c6\', \'multiverseId\': 216320}, \'multiverseid\': 216320}, {\'name\': \'天使心の薬瓶\', \'text\': \'あなたにダメージが与えられるたび、あなたは天使心の薬瓶の上にその点数に等しい数の蓄積カウンターを置いてもよい。\\n{2}, {T}, 天使心の薬瓶から蓄積カウンターを４個取り除く：あなたは２点のライフを得て、カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'そこにはイオナの「耐えよ」という囁きが封じられている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216568&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fc75f0c1-6475-4197-a87f-de729faeb98d\', \'multiverseId\': 216568}, \'multiverseid\': 216568}, {\'name\': \'Frasco de Coração de Anjo\', \'text\': \'Toda vez que sofre dano, você pode colocar uma quantidade equivalente de marcadores de carga em Frasco de Coração de Anjo.\\n{2}, {T}, Remova quatro marcadores de carga de Frasco de Coração de Anjo: Você ganha 2 pontos de vida e compra um card.\', \'type\': \'Artefato\', \'flavor\': \'Ele contém um sussurro de Iona: "Persevere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216816&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2b7987de-51ae-41df-a57a-831a1f4c1768\', \'multiverseId\': 216816}, \'multiverseid\': 216816}, {\'name\': \'Фиал Ангельского Сердца\', \'text\': \'Каждый раз когда вам наносятся повреждения, вы можете положить столько же жетонов заряда на Фиал Ангельского Сердца.\\n{2}, {T}, удалите четыре жетона заряда с Фиала Ангельского Сердца: вы получаете 2 жизни и берете карту.\', \'type\': \'Артефакт\', \'flavor\': \'Внутри хранится шепот Ионы: «Не сдавайся!».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215824&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fec1895b-e069-45c7-a693-e275e6f021e9\', \'multiverseId\': 215824}, \'multiverseid\': 215824}, {\'name\': \'天使心瓶\', \'text\': \'每当你受到伤害时，你可以在天使心瓶上放置等量的充电指示物。\\n{2}，{T}，从天使心瓶上移去四个充电指示物：你获得2点生命并抓一张牌。\', \'type\': \'神器\', \'flavor\': \'里面盛装着艾欧娜的细语：「不屈不挠。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13a04f49-f9b7-49b4-9554-98794ddfa0be\', \'multiverseId\': 216072}, \'multiverseid\': 216072}]', '[{\'name\': \'Entflohene Null\', \'text\': \'Lebensverknüpfung\\nImmer wenn die Entflohene Null blockt oder geblockt wird, erhält sie +5/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Zombie, Berserker\', \'flavor\': \'Von Kozilek ohne Herrn zurückgelassen, wanderte sie durch die Wildnis und tobte in ihrem unablässigen Hunger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217446&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e78cefa-ae3f-4a0c-97a2-d1e6caaef9b4\', \'multiverseId\': 217446}, \'multiverseid\': 217446}, {\'name\': \'Nulo fugado\', \'text\': \'Vínculo vital.\\nSiempre que el Nulo fugado bloquee o sea bloqueado, obtiene +5/+0 hasta el final del turno.\', \'type\': \'Criatura — Berserker zombie\', \'flavor\': \'Sin amo, gracias a Kozilek, vagó por los bosques, delirante y con un hambre sin fin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217198&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'25d7d810-3e81-4031-affc-72da98d0aa4c\', \'multiverseId\': 217198}, \'multiverseid\': 217198}, {\'name\': \'Infécond fuyard\', \'text\': "Lien de vie\\nÀ chaque fois que l\'Infécond fuyard bloque ou devient bloqué, il gagne +5/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : zombie et berserker\', \'flavor\': \'Laissé pour compte par Kozilek, il errait dans la nature, sa soif incurable le plongeant dans la folie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215710&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a562ee3-9c2c-4be8-80d2-dff65c4fb2ff\', \'multiverseId\': 215710}, \'multiverseid\': 215710}, {\'name\': \'Nullo Fuggitivo\', \'text\': \'Legame vitale\\nOgniqualvolta il Nullo Fuggitivo blocca o viene bloccato, prende +5/+0 fino alla fine del turno.\', \'type\': \'Creatura — Berserker Zombie\', \'flavor\': \'Lasciato senza padrone da Kozilek, vagava nelle terre selvagge, delirante nella sua fame infinita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216454&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a586cb66-437d-4211-a9fa-2287b3101445\', \'multiverseId\': 216454}, \'multiverseid\': 216454}, {\'name\': \'逃亡した虚身\', \'text\': \'絆魂\\n逃亡した虚身がブロックするかブロックされた状態になるたび、それはターン終了時まで＋５/＋０の修整を受ける。\', \'type\': \'クリーチャー — ゾンビ・狂戦士\', \'flavor\': \'コジレックのために主を失ったそれは、荒野をうろつき回り、消えることの無い飢えに叫び続けた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216702&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c9ad9393-97aa-4e1c-8e94-bf2bbb5cd5f7\', \'multiverseId\': 216702}, \'multiverseid\': 216702}, {\'name\': \'Nulo Foragido\', \'text\': \'Vínculo com a vida\\nToda vez que Nulo Foragido bloqueia ou é bloqueado, ele recebe +5/+0 até o final do turno.\', \'type\': \'Criatura — Zumbi Amoque\', \'flavor\': \'Depois que Kozilek o deixou sem mestre, ele vagou pelas terras agrestes delirando com sua fome sem fim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216950&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f19eb4ce-71f3-4ccc-b9f7-6444908cc072\', \'multiverseId\': 216950}, \'multiverseid\': 216950}, {\'name\': \'Беглое Ничтожество\', \'text\': \'Цепь жизни\\nКаждый раз когда Беглое Ничтожество блокирует или становится заблокированным, оно получает +5/+0 до конца хода.\', \'type\': \'Существо — Зомби Берсерк\', \'flavor\': \'Оставленное без хозяина по вине Козилека, оно скиталось по пустошам, беснуясь от ненасытного голода.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215958&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'83bb09d4-97c9-477f-84eb-d1addfe9fb12\', \'multiverseId\': 215958}, \'multiverseid\': 215958}, {\'name\': \'脱逃躯壳\', \'text\': \'系命\\n每当脱逃躯壳阻挡或被阻挡时，它得+5/+0直到回合结束。\', \'type\': \'生物～灵俑／狂战士\', \'flavor\': \'它们由于寇基雷而没了主子，于是漫游荒野间，因无止尽的饥饿而嚎叫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216206&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e393c16-47eb-44a8-8762-5d546e5e7b73\', \'multiverseId\': 216206}, \'multiverseid\': 216206}]', '[{\'name\': \'Entmystifizieren\', \'text\': \'Zerstöre eine Verzauberung deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Singende Stadt schwieg, die Steine am Wegrand waren still, und die Winde der Heulenden Spitzen hatten sich gelegt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'447e24b2-86bc-40d9-87f7-40ab72c5836e\', \'multiverseId\': 217523}, \'multiverseid\': 217523}, {\'name\': \'Desmitificar\', \'text\': \'Destruye el encantamiento objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'La Ciudad Cantante estaba en silencio, el camino de piedras, vacío, y los vientos de la Torre Aullante cesaron.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217275&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1ef56df5-110a-480b-aad7-2cf129f46ce9\', \'multiverseId\': 217275}, \'multiverseid\': 217275}, {\'name\': \'Démystification\', \'text\': "Détruisez l\'enchantement ciblé.", \'type\': \'Éphémère\', \'flavor\': "La Ville Chantante était silencieuse, les pierres des chemins s\'éteignirent et les vents de la Cime Rugissante se calmèrent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215787&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e43a2423-569f-42be-99f7-d6283e1b6569\', \'multiverseId\': 215787}, \'multiverseid\': 215787}, {\'name\': \'Demistificare\', \'text\': \'Distruggi un incantesimo bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'La Città Canora era silente, le pietre del selciato erano immobili, quando i venti della Guglia Ululante cessarono.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216531&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb786806-01f2-4c35-87ac-b8e87786d326\', \'multiverseId\': 216531}, \'multiverseid\': 216531}, {\'name\': \'啓蒙\', \'text\': \'エンチャント１つを対象とし、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'歌う都は沈黙し、小道の石は動かず、吼えたける峰の風も消え去った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216779&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cdace5da-e37a-42d1-8b95-e8326e68a7db\', \'multiverseId\': 216779}, \'multiverseid\': 216779}, {\'name\': \'Desmistificar\', \'text\': \'Destrua o encantamento alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'A Cidade Cantante se calou, as pedras do caminho ficaram imóveis e os ventos da Espiral Uivante cessaram.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217027&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3c2d14f0-ea10-44ea-aaa5-5e519fdb7e62\', \'multiverseId\': 217027}, \'multiverseid\': 217027}, {\'name\': \'Прояснение\', \'text\': \'Уничтожьте целевые чары.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В Певчем Граде наступила тишина, мостовые камни лежали не шелохнувшись, а ветры Воющего Шпиля совсем стихли.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216035&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'095abdb3-fe1b-4b26-b1e2-b4faa3176dfb\', \'multiverseId\': 216035}, \'multiverseid\': 216035}, {\'name\': \'揭秘\', \'text\': \'消灭目标结界。\', \'type\': \'瞬间\', \'flavor\': \'歌咏之都安静无声，路径石没有动静，连嚎叫尖塔的风都停歇。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216283&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2898f0a1-9a3f-4673-a8de-7173bb64c3ed\', \'multiverseId\': 216283}, \'multiverseid\': 216283}]', '[{\'name\': \'Erdspaltenöffnung\', \'text\': \'Bestimme eines oder beides — Zerstöre ein Artefakt deiner Wahl; und/oder zerstöre ein Nichtstandardland deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'„Irgendwas da unten hat Appetit auf das, auf dem wir stehen. Hoffentlich will es keinen Nachschlag." —Samila aus Murasas Expeditionsgildenhaus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217498&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'aeebe9e7-db71-48d5-b73c-66bd5def7d33\', \'multiverseId\': 217498}, \'multiverseid\': 217498}, {\'name\': \'Respiradero de fisura\', \'text\': \'Elige uno o ambos: Destruye el artefacto objetivo; y/o destruye la tierra no básica objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"Algo ahí abajo quiere comerse el lugar sobre el que estamos. Esperemos que no quiera un segundo plato." —Samila, Casa expedicionaria de Murasa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217250&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba1b1168-f48e-4e08-83e7-07dcc1c4f1e1\', \'multiverseId\': 217250}, \'multiverseid\': 217250}, {\'name\': \'Conduit de crevasse\', \'text\': "Choisissez l\'un ou les deux — Détruisez l\'artefact ciblé ; et/ou détruisez le terrain non-base ciblé.", \'type\': \'Rituel\', \'flavor\': "« Quelque chose là-dessous a un certain appétit pour ce sur quoi nous nous tenons. Espérons qu\'elle ne vienne pas se reservir. » —Samila, corps expéditionnaire de Murasa", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215762&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aef6641d-7a39-4c9b-9636-f5b6282919e9\', \'multiverseId\': 215762}, \'multiverseid\': 215762}, {\'name\': \'Sfiatatoio della Crepa\', \'text\': \'Scegli uno o entrambi — Distruggi un artefatto bersaglio; e/o distruggi una terra non base bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Qualcosa là sotto ha un certo appetito per ciò su cui ci troviamo. Speriamo che non voglia anche il contorno." —Samila, Casa di Spedizioni di Murasa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216506&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03ad8f56-3908-41e3-92f0-626f282cc9be\', \'multiverseId\': 216506}, \'multiverseid\': 216506}, {\'name\': \'地割れの孔\', \'text\': \'以下の２つから１つまたは２つを選ぶ。「アーティファクト１つを対象とし、それを破壊する。」「基本でない土地１つを対象とし、それを破壊する。」\', \'type\': \'ソーサリー\', \'flavor\': \'「下にある何かが、あたしらの立ってる何かをお気に召したようね。 これ以上望まないことを願うね。」 ――ムラーサ探検隊のサミーラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216754&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f598eb09-3642-4b03-9731-35ff1e46551f\', \'multiverseId\': 216754}, \'multiverseid\': 216754}, {\'name\': \'Abertura na Fissura\', \'text\': \'Escolha um ou ambos — Destrua o artefato alvo; e/ou destrua o terreno alvo não básico.\', \'type\': \'Feitiço\', \'flavor\': \'"Algo lá embaixo está louco para comer aquilo que está sob nossos pés. Tomara que ele não queira um segundo prato." — Samila, Casa Expedicionária de Murasa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217002&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e968ca2-88bd-4ee6-8410-a894252a50ef\', \'multiverseId\': 217002}, \'multiverseid\': 217002}, {\'name\': \'Жерло Расселины\', \'text\': \'Выберите одно или оба — уничтожьте целевой артефакт; и (или) уничтожьте целевую небазовую землю.\', \'type\': \'Волшебство\', \'flavor\': \'«Что-то там внизу с удовольствием лакомится тем, на чем мы стоим. Будем надеяться, что оно не захочет добавки». — Самила из мурасского экспедиционного дома\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216010&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eff290ee-d82f-4d05-ac33-d166acb0191b\', \'multiverseId\': 216010}, \'multiverseid\': 216010}, {\'name\': \'裂缝喷发口\', \'text\': \'选择一项或都选～消灭目标神器；和／或消灭目标非基本地。\', \'type\': \'法术\', \'flavor\': \'「下面某个东西吃了我们所站的地方。 只能希望它不想再吃一顿。」 ～姆拉撒探险队的莎米勒\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216258&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'465984a2-f9c6-495f-8439-379f16f2bd48\', \'multiverseId\': 216258}, \'multiverseid\': 216258}]', '[{\'name\': \'Erinnernde Mauer\', \'text\': \'Verteidiger\\nWenn die Erinnernde Mauer ins Spiel kommt, kannst du eine Spontanzauber- oder Hexereikarte deiner Wahl aus deinem Friedhof auf deine Hand zurückholen.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'„Ich würde daraus eine ganze riesige Festung bauen, falls ich das könnte." —Mzali, Erzmagier des Leuchtturms\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217352&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fed933b1-fb11-4a29-aa5e-6820dc909020\', \'multiverseId\': 217352}, \'multiverseid\': 217352}, {\'name\': \'Muro mnemónico\', \'text\': \'Defensor.\\nCuando el Muro mnemónico entre al campo de batalla, puedes regresar la carta de instantáneo o conjuro objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Muro\', \'flavor\': \'"Construiría toda una fortaleza con ellos si pudiera." —Mzali, archimago del Faro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217104&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ea9bd730-f6ba-48db-a4e8-6924c1b7436f\', \'multiverseId\': 217104}, \'multiverseid\': 217104}, {\'name\': \'Mur mnémonique\', \'text\': "Défenseur\\nQuand le Mur mnémonique arrive sur le champ de bataille, vous pouvez renvoyer une carte d\'éphémère ou de rituel ciblée depuis votre cimetière dans votre main.", \'type\': \'Créature : mur\', \'flavor\': \'« Je les utiliserais pour construire toute une forteresse si je le pouvais. » —Mzali, archimage du phare\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215616&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e374258b-b92f-4d59-ab3d-8b3f1490dcb6\', \'multiverseId\': 215616}, \'multiverseid\': 215616}, {\'name\': \'Muro Mnemonico\', \'text\': \'Difensore\\nQuando il Muro Mnemonico entra nel campo di battaglia, puoi riprendere in mano una carta istantaneo o stregoneria bersaglio dal tuo cimitero.\', \'type\': \'Creatura — Muro\', \'flavor\': \'"Ne costruirei un\\\'intera fortezza, se potessi." —Mzali, arcimago del Faro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216360&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'416edf03-4fcf-4f99-94ff-689e3d2a443a\', \'multiverseId\': 216360}, \'multiverseid\': 216360}, {\'name\': \'記憶の壁\', \'text\': \'防衛\\n記憶の壁が戦場に出たとき、あなたの墓地にあるインスタント・カード１枚かソーサリー・カード１枚を対象とする。あなたはそれをあなたの手札に戻してもよい。\', \'type\': \'クリーチャー — 壁\', \'flavor\': \'「できるもんなら、こいつで要塞を建てようさ。」 ――灯台の大魔導師、ムザーリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216608&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'49c94cd2-28bf-40c8-b155-cf0c66d0268e\', \'multiverseId\': 216608}, \'multiverseid\': 216608}, {\'name\': \'Barreira Mnemônica\', \'text\': \'Defensor\\nQuando Barreira Mnemônica entra no campo de batalha, você pode devolver o card de mágica instantânea ou feitiço alvo de seu cemitério para a sua mão.\', \'type\': \'Criatura — Barreira\', \'flavor\': \'"Eu construiria uma fortaleza inteira com elas se pudesse." — Mzali, arquimago do Farol\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c904f490-3e3c-4f64-87ee-fa2566f76116\', \'multiverseId\': 216856}, \'multiverseid\': 216856}, {\'name\': \'Мнемоническая Стена\', \'text\': \'Защитник\\nКогда Мнемоническая Стена выходит на поле битвы, вы можете вернуть целевую карту мгновенного заклинания или волшебства из вашего кладбища в вашу руку.\', \'type\': \'Существо — Стена\', \'flavor\': \'«Если бы я мог, то построил бы из них целую крепость». — Мзали, архимаг тазимского Маяка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215864&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0d838d0b-514f-455b-bc18-3fd86dbea50e\', \'multiverseId\': 215864}, \'multiverseid\': 215864}, {\'name\': \'记忆墙\', \'text\': \'守军\\n当记忆墙进战场时，你可以将目标瞬间或法术牌从你的坟墓场移回你手上。\', \'type\': \'生物～墙\', \'flavor\': \'「如果可以的话，真想用它们来建造整座堡垒。」 ～灯塔大法师马闸离\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216112&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'235d1bbe-e140-49de-a3c9-a1e38be1421f\', \'multiverseId\': 216112}, \'multiverseid\': 216112}]', '[{\'name\': \'Erobernder Mantikor\', \'text\': \'Fliegend\\nWenn der Erobernde Mantikor ins Spiel kommt, übernimm bis zum Ende des Zuges die Kontrolle über eine Kreatur deiner Wahl, die ein Gegner kontrolliert. Enttappe diese Kreatur. Sie erhält Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Mantikor\', \'flavor\': \'Er äußert keine Befehle, und trotzdem wird ihm immer gehorcht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217335&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1901f78e-eeda-4963-b3c4-fd9ac7736365\', \'multiverseId\': 217335}, \'multiverseid\': 217335}, {\'name\': \'Mantícora conquistadora\', \'text\': \'Vuela.\\nCuando la Mantícora conquistadora entre al campo de batalla, gana el control de la criatura objetivo que controla un oponente hasta el final del turno. Endereza esa criatura. Gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Mantícora\', \'flavor\': \'No da órdenes, pero siempre la obedecen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217087&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce626f1b-cff8-4e6a-972b-bdcadbee0684\', \'multiverseId\': 217087}, \'multiverseid\': 217087}, {\'name\': \'Manticore conquérante\', \'text\': "Vol\\nQuand la Manticore conquérante arrive sur le champ de bataille, acquérez le contrôle d\'une créature ciblée qu\'un adversaire contrôle jusqu\'à la fin du tour. Dégagez cette créature. Elle acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : manticore\', \'flavor\': "Elle ne donne jamais d\'ordre mais elle est toujours obéie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215599&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4997a936-1761-4086-94df-04d115e1621f\', \'multiverseId\': 215599}, \'multiverseid\': 215599}, {\'name\': \'Manticora Vittoriosa\', \'text\': \'Volare\\nQuando la Manticora Vittoriosa entra nel campo di battaglia, prendi il controllo di una creatura bersaglio controllata da un avversario fino alla fine del turno. STAPpa quella creatura. Ha rapidità fino alla fine del turno.\', \'type\': \'Creatura — Manticora\', \'flavor\': \'Non pronuncia alcun ordine ma viene sempre obbedita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216343&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b0e4d5b0-d057-4d84-a7e0-30a2e065b49f\', \'multiverseId\': 216343}, \'multiverseid\': 216343}, {\'name\': \'征服するマンティコア\', \'text\': \'飛行\\n征服するマンティコアが戦場に出たとき、いずれかの対戦相手がコントロールするクリーチャー１体を対象とし、ターン終了時までそれのコントロールを得る。 そのクリーチャーをアンタップする。 それはターン終了時まで速攻を得る。\', \'type\': \'クリーチャー — マンティコア\', \'flavor\': \'それは何も命じないが、必ず服従を受ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216591&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d3372816-caf4-4835-8cb9-21575509b12b\', \'multiverseId\': 216591}, \'multiverseid\': 216591}, {\'name\': \'Manticora Conquistadora\', \'text\': \'Voar\\nQuando Manticora Conquistadora entrar no campo de batalha, ganhe o controle da criatura alvo que um oponente controla até o final do turno. Desvire aquela criatura. Ela ganha ímpeto até o final do turno.\', \'type\': \'Criatura — Manticora\', \'flavor\': \'Ele não dá ordens mas é sempre obedecido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216839&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cde5ef1b-3e81-45d6-bcd2-f024d9588faf\', \'multiverseId\': 216839}, \'multiverseid\': 216839}, {\'name\': \'Мантикора-Покоритель\', \'text\': \'Полет\\nКогда Мантикора-Покоритель выходит на поле битвы, получите контроль над целевым существом под контролем оппонента до конца хода. Разверните то существо. Оно получает Ускорение до конца хода.\', \'type\': \'Существо — Мантикора\', \'flavor\': \'Он не отдает команд, но вызывает беспрекословное повиновение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215847&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bebd43d0-3f35-4aa6-b699-f6697eb33bf7\', \'multiverseId\': 215847}, \'multiverseid\': 215847}, {\'name\': \'威服翼狮\', \'text\': \'飞行\\n当威服翼狮进战场时，获得目标由对手所操控的生物之操控权直到回合结束。 重置该生物。 它获得敏捷异能直到回合结束。\', \'type\': \'生物～翼狮\', \'flavor\': \'从未发号施令，却无人敢不遵服。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216095&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61854e20-8a23-4bd0-939f-fab8487f46fe\', \'multiverseId\': 216095}, \'multiverseid\': 216095}]', '[{\'name\': \'Es, das betrügt\', \'text\': \'Vernichter 2 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler zwei bleibende Karten.)\\nImmer wenn ein Gegner eine bleibende Karte opfert, die kein Spielstein ist, bringe diese Karte unter deiner Kontrolle ins Spiel.\', \'type\': \'Kreatur — Eldrazi\', \'flavor\': \'Dein Flehen um den Tod möge ungehört verhallen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217499&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'79307722-ef31-4a7c-bd5c-1cbe3b77fd7f\', \'multiverseId\': 217499}, \'multiverseid\': 217499}, {\'name\': \'El que traiciona\', \'text\': \'Aniquilador 2. (Siempre que esta criatura ataque, el jugador defensor sacrifica dos permanentes.)\\nSiempre que un oponente sacrifique un permanente que no sea ficha, pon esa carta en el campo de batalla bajo tu control.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'Tus súplicas de muerte no serán oídas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217251&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4dfee717-1beb-4791-afb4-1af1b4b94210\', \'multiverseId\': 217251}, \'multiverseid\': 217251}, {\'name\': \'Lui-qui-trahit\', \'text\': "Annihilateur 2 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie deux permanents.)\\nÀ chaque fois qu\'un adversaire sacrifie un permanent non-jeton, mettez cette carte sur le champ de bataille sous votre contrôle.", \'type\': \'Créature : eldrazi\', \'flavor\': \'Vos supplications pour mourir resteront ignorées.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215763&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'789b69c7-887b-4c8f-af03-b75230cbc7fa\', \'multiverseId\': 215763}, \'multiverseid\': 215763}, {\'name\': \'Ciò che Tradisce\', \'text\': \'Annientatore 2 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica due permanenti.)\\nOgniqualvolta un avversario sacrifica un permanente non pedina, metti sul campo di battaglia quella carta sotto il tuo controllo.\', \'type\': \'Creatura — Eldrazi\', \'flavor\': \'I tuoi appelli alla morte non verranno ascoltati.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216507&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2323bc3d-d21d-4860-967d-483078de3e40\', \'multiverseId\': 216507}, \'multiverseid\': 216507}, {\'name\': \'背くもの\', \'text\': \'滅殺 ２ （このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを２つ生け贄に捧げる。）\\nいずれかの対戦相手がトークンでないパーマネントを１つ生け贄に捧げるたび、そのカードをあなたのコントロール下で戦場に出す。\', \'type\': \'クリーチャー — エルドラージ\', \'flavor\': \'お前の死の懇願は聞き届けられない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216755&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f19db3ae-1459-4c70-90a3-ad839e18a79b\', \'multiverseId\': 216755}, \'multiverseid\': 216755}, {\'name\': \'Aquilo que Trai\', \'text\': \'Aniquilador 2 (Toda vez que esta criatura ataca, o jogador defensor sacrifica duas permanentes.)\\nToda vez que um oponente sacrificar uma permanente que não seja ficha, coloque aquele card no campo de batalha sob o seu controle.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'Suas súplicas para morrer não serão ouvidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217003&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f5b85a6b-ac26-4da3-a3f1-413dd8857bff\', \'multiverseId\': 217003}, \'multiverseid\': 217003}, {\'name\': \'Тот, Кто Предает\', \'text\': \'Аннигилятор 2 (Каждый раз когда это существо атакует, защищающийся игрок приносит в жертву два перманента.)\\nКаждый раз когда оппонент приносит в жертву не являющийся фишкой перманент, положите ту карту на поле битвы под вашим контролем.\', \'type\': \'Существо — Эльдрази\', \'flavor\': \'Ваши мольбы о смерти останутся неуслышанными.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216011&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'44a83092-4d1d-4737-91af-70edef0d3d7e\', \'multiverseId\': 216011}, \'multiverseid\': 216011}, {\'name\': \'背叛恶物\', \'text\': \'歼灭2 （每当此生物攻击时，防御牌手牺牲两个永久物。）\\n每当一位对手牺牲一个非衍生物的永久物时，将该牌在你的操控下放进战场。\', \'type\': \'生物～奥札奇\', \'flavor\': \'你恳求死亡，却终归徒劳。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216259&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'162b055e-4d0f-44bb-9909-fb4c150fd946\', \'multiverseId\': 216259}, \'multiverseid\': 216259}]', '[{\'name\': \'Essenzfütterung\', \'text\': \'Ein Spieler deiner Wahl verliert 3 Lebenspunkte. Du erhältst 3 Lebenspunkte dazu und bringst drei 0/1 farblose (Eldrazi, Ausgeburt)-Kreaturenspielsteine ins Spiel. Sie haben „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Hexerei\', \'flavor\': \'Eldrazi wachsen überall, wo etwas anderes stirbt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217480&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9abdd227-6a5b-4c9c-9546-160979773254\', \'multiverseId\': 217480}, \'multiverseid\': 217480}, {\'name\': \'Alimentarse de la esencia\', \'text\': \'El jugador objetivo pierde 3 vidas. Gana 3 vidas y pon en el campo de batalla tres fichas de criatura Engendro Eldrazi incoloras 0/1. Tienen "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Conjuro\', \'flavor\': \'Los eldrazi crecen donde cualquier otra cosa muere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217232&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'263356ce-b69e-40ef-a15c-2b76165f0d74\', \'multiverseId\': 217232}, \'multiverseid\': 217232}, {\'name\': "Repas d\'essence", \'text\': \'Le joueur ciblé perd 3 points de vie. Vous gagnez 3 points de vie et vous mettez sur le champ de bataille trois jetons de créature 0/1 incolore Eldrazi et Engeance. Ils ont « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »\', \'type\': \'Rituel\', \'flavor\': \'Là où quelquechose trépasse, les Eldrazi croissent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215744&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'40c58dee-74e2-4a9d-aaaf-18e3235704f0\', \'multiverseId\': 215744}, \'multiverseid\': 215744}, {\'name\': "Nutrirsi d\'Essenza", \'text\': \'Un giocatore bersaglio perde 3 punti vita. Guadagni 3 punti vita e metti sul campo di battaglia tre pedine creatura Progenie Eldrazi 0/1 incolori. Hanno "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Stregoneria\', \'flavor\': "Gli Eldrazi crescono ovunque ci sia qualcos\'altro che muore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216488&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'29423552-b144-48e4-9051-1af4861d928b\', \'multiverseId\': 216488}, \'multiverseid\': 216488}, {\'name\': \'本質の給餌\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは３点のライフを失う。 あなたは３点のライフを得て、無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを３体戦場に出す。 それらは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'ソーサリー\', \'flavor\': \'エルドラージは何者かが死すところに育つ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216736&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3ccab824-a316-4000-bd49-fbdb687ea22d\', \'multiverseId\': 216736}, \'multiverseid\': 216736}, {\'name\': \'Alimentar-se da Essência\', \'text\': \'O jogador alvo perde 3 pontos de vida. Você ganha 3 pontos de vida e coloca no campo de batalha três fichas de criatura incolores 0/1 do tipo Prole Eldrazi. Elas têm "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\', \'type\': \'Feitiço\', \'flavor\': \'Os Eldrazi crescem onde alguma outra coisa morre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216984&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84d9d57a-1fa1-4ee0-8e25-a8017f29e489\', \'multiverseId\': 216984}, \'multiverseid\': 216984}, {\'name\': \'Питание Духа\', \'text\': \'Целевой игрок теряет 3 жизни. Вы получаете 3 жизни и кладете на поле битвы три фишки существа 0/1 бесцветный Эльдрази Порождение. У них есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\', \'type\': \'Волшебство\', \'flavor\': \'Эльдрази растут везде, где все остальное умирает.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215992&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2d9bd872-1d22-4d3f-828c-3b015b9e42b3\', \'multiverseId\': 215992}, \'multiverseid\': 215992}, {\'name\': \'摄食菁华\', \'text\': \'目标牌手失去3点生命。 你获得3点生命并将三个0/1无色奥札奇／后裔衍生物放进战场。 它们具有「牺牲此生物：加{1}到你的法术力池中。」\', \'type\': \'法术\', \'flavor\': \'奥札奇兴盛之处，其他东西均死灭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216240&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6e0e1afb-b2af-4f3f-8353-ed8c65d49d4e\', \'multiverseId\': 216240}, \'multiverseid\': 216240}]', '[{\'name\': \'Explosive Offenbarung\', \'text\': \'Bestimme eine Kreatur oder einen Spieler deiner Wahl. Decke Karten oben von deiner Bibliothek auf, bis du eine Karte aufdeckst, die kein Land ist. Die Explosive Offenbarung fügt dieser Kreatur oder diesem Spieler Schadenspunkte in Höhe der umgewandelten Manakosten dieser Karte zu. Nimm die Karte, die kein Land ist, auf deine Hand, und lege den Rest der Karten in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217343&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ecb06e00-7c5a-4993-84ac-89d84fa51837\', \'multiverseId\': 217343}, \'multiverseid\': 217343}, {\'name\': \'Revelación explosiva\', \'text\': \'Elige una criatura o jugador objetivo. Muestra las primeras cartas de tu biblioteca hasta que muestres una carta que no sea tierra. La Revelación explosiva hace daño igual al coste de maná convertido de esa carta a esa criatura o jugador. Pon la carta que no sea tierra en tu mano y el resto en el fondo de tu biblioteca en cualquier orden.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217095&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4569cda4-8fbf-4e58-bc16-d016de0b03ad\', \'multiverseId\': 217095}, \'multiverseid\': 217095}, {\'name\': \'Révélation explosive\', \'text\': "Choisissez une cible, créature ou joueur. Révélez les cartes du dessus de votre bibliothèque jusqu\'à ce que vous révéliez une carte non-terrain. La Révélation explosive inflige à cette créature ou à ce joueur un nombre de blessures égal au coût converti de mana de cette carte. Mettez la carte non-terrain dans votre main et le reste au-dessous de votre bibliothèque dans n\'importe quel ordre.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215607&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d75ddfd5-0ec1-4410-ac0d-f16c51ba714b\', \'multiverseId\': 215607}, \'multiverseid\': 215607}, {\'name\': \'Rivelazione Esplosiva\', \'text\': \'Scegli una creatura o un giocatore bersaglio. Rivela carte dalla cima del tuo grimorio fino a che non riveli una carta non terra. La Rivelazione Esplosiva infligge a quella creatura o a quel giocatore danno pari al costo di mana convertito di quella carta. Aggiungi la carta non terra alla tua mano e metti tutte le altre carte in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216351&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aadac496-16db-4e8e-b235-4bb7f76b1f71\', \'multiverseId\': 216351}, \'multiverseid\': 216351}, {\'name\': \'爆発的天啓\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。 あなたのライブラリーの一番上のカードを、土地でないカードが公開されるまで公開し続ける。爆発的天啓はそのクリーチャーやプレイヤーに、そのカードの点数で見たマナ・コストに等しい点数のダメージを与える。 その土地でないカードをあなたの手札に加え、残りをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216599&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a56267b-cfad-4eb0-8ee2-8d291cf2f3f6\', \'multiverseId\': 216599}, \'multiverseid\': 216599}, {\'name\': \'Revelação Explosiva\', \'text\': \'Escolha a criatura ou o jogador alvo. Revele cards do topo de seu grimório até revelar um card que não seja um terreno. Revelação Explosiva causa uma quantidade de dano igual ao custo de mana convertido daquele card àquela criatura ou jogador. Coloque o card que não seja um terreno na sua mão e os restantes no fundo do seu grimório em qualquer ordem.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216847&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d78ecd7-1cca-454b-9d5c-391b4549413a\', \'multiverseId\': 216847}, \'multiverseid\': 216847}, {\'name\': \'Взрывное Открытие\', \'text\': \'Выберите целевое существо или игрока. Показывайте карты с верха вашей библиотеки, пока вы не покажете не являющуюся землей карту. Взрывное Открытие наносит тому существу или игроку повреждения, равные конвертированной мана-стоимости той карты. Положите ту не являющуюся землей карту в вашу руку, а остальные в низ вашей библиотеки в любом порядке.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215855&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30153134-60e0-44a1-8e56-b4ae7d81f24d\', \'multiverseId\': 215855}, \'multiverseid\': 215855}, {\'name\': \'爆烈启示\', \'text\': \'选择目标生物或牌手。 从你牌库顶开始展示牌，直到你展示出一张非地牌为止。爆烈启示对该生物或牌手造成伤害，其数量等同于所展示牌的总法术力费用。 将此张非地牌置于你手上，其余的牌则以任意顺序置于你的牌库底。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'933a6259-1586-4290-974c-6979ef2c7a0f\', \'multiverseId\': 216103}, \'multiverseid\': 216103}]', '[{\'name\': \'Flammenstreich\', \'text\': \'Der Flammenstreich fügt einer Kreatur deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Hexerei\', \'flavor\': \'Nach Jahrtausenden Schlummer hatten die Eldrazi Zendikars hitziges Temperament und Ablehnung von Fremdem vergessen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217448&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91085337-9ab9-4eb2-96f0-4f118d5e07c4\', \'multiverseId\': 217448}, \'multiverseid\': 217448}, {\'name\': \'Cuchillazo de llamas\', \'text\': \'El Cuchillazo de llamas hace 4 puntos de daño a la criatura objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'Después de siglos durmiendo, los eldrazi habían olvidado el carácter ardiente de Zendikar y su odio hacia los extranjeros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217200&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'26f4aadc-6deb-4f1f-ab15-7e5af1d91c2a\', \'multiverseId\': 217200}, \'multiverseid\': 217200}, {\'name\': \'Balafre de flammes\', \'text\': \'La Balafre de flammes inflige 4 blessures à la créature ciblée.\', \'type\': \'Rituel\', \'flavor\': \'Après des millénaires de sommeil, les Eldrazi avaient oublié le caractère tumultueux et la xénophobie de Zendikar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215712&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'26eda579-3ff5-42dd-a5d0-04c351f3761a\', \'multiverseId\': 215712}, \'multiverseid\': 215712}, {\'name\': \'Frustata Infuocata\', \'text\': \'La Frustata Infuocata infligge 4 danni a una creatura bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': "Dopo aver dormito per millenni, gli Eldrazi avevano ormai dimenticato l\'indole focosa e la xenofobia di Zendikar.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216456&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9376481-07a7-4141-bac4-3b06d3e5f655\', \'multiverseId\': 216456}, \'multiverseid\': 216456}, {\'name\': \'炎の斬りつけ\', \'text\': \'クリーチャー１体を対象とする。炎の斬りつけはそれに４点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'数千年の眠りの後、エルドラージはゼンディカーの怒りとよそ者嫌いをすっかり忘れていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216704&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e08f1e41-ad01-4272-b577-ed14b6ac471e\', \'multiverseId\': 216704}, \'multiverseid\': 216704}, {\'name\': \'Golpe Ardente\', \'text\': \'Golpe Ardente causa 4 pontos de dano à criatura alvo.\', \'type\': \'Feitiço\', \'flavor\': \'Após passar milênios adormecidos, os Eldrazi haviam esquecido o temperamento explosivo e a aversão a estranhos de Zendikar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216952&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2db828aa-7976-4973-9084-e9f56fd6ccad\', \'multiverseId\': 216952}, \'multiverseid\': 216952}, {\'name\': \'Хлещущее Пламя\', \'text\': \'Хлещущее Пламя наносит 4 повреждения целевому существу.\', \'type\': \'Волшебство\', \'flavor\': \'Очнувшись от длившейся тысячелетиями спячки, Эльдрази не помнили о вспыльчивом нраве Зендикара и его неприязни к чужакам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215960&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'620496ae-7092-4d45-bf47-c2d7abbfef96\', \'multiverseId\': 215960}, \'multiverseid\': 215960}, {\'name\': \'火焰飞斩\', \'text\': \'火焰飞斩对目标生物造成4点伤害。\', \'type\': \'法术\', \'flavor\': \'奥札奇沉睡了数千年，早已忘记赞迪卡的火爆脾气与厌恶外人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216208&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ff8093c8-b825-4a79-8626-66230838a522\', \'multiverseId\': 216208}, \'multiverseid\': 216208}]', '[{\'name\': \'Fluch der Zauberei\', \'text\': \'Sowie der Fluch der Zauberei ins Spiel kommt, bestimme eine Farbe.\\nImmer wenn ein Spieler einen Zauberspruch der bestimmten Farbe wirkt, verliert er 1 Lebenspunkt.\', \'type\': \'Verzauberung\', \'flavor\': \'„Wir müssen alle den Schmerz ertragen, um unsere Welt zu heilen." —Ayli, Klerikerin von Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217321&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'faa8f4ba-2970-46ce-9291-58ac2f4d5973\', \'multiverseId\': 217321}, \'multiverseid\': 217321}, {\'name\': \'Maldición de hechicería\', \'text\': \'En cuanto la Maldición de hechicería entre al campo de batalla, elige un color.\\nSiempre que un jugador lance un hechizo del color elegido, ese jugador pierde 1 vida.\', \'type\': \'Encantamiento\', \'flavor\': \'"Todos debemos superar el dolor para curar nuestro mundo." —Ayli, clériga de Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217073&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a0d59d72-f171-4488-94e7-5e1592f03d6d\', \'multiverseId\': 217073}, \'multiverseid\': 217073}, {\'name\': \'Malédiction de sorcellerie\', \'text\': "Au moment où la Malédiction de sorcellerie arrive sur le champ de bataille, choisissez une couleur.\\nÀ chaque fois qu\'un joueur lance un sort de la couleur choisie, ce joueur perd 1 point de vie.", \'type\': \'Enchantement\', \'flavor\': \'« Nous devons tous traverser la souffrance pour guérir notre monde. » —Ayli, clerc de Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215585&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a44af60-9cdd-47dc-97d0-2576195a5fab\', \'multiverseId\': 215585}, \'multiverseid\': 215585}, {\'name\': \'Maledizione della Stregoneria\', \'text\': \'Mentre la Maledizione della Stregoneria entra nel campo di battaglia, scegli un colore.\\nOgniqualvolta un giocatore lancia una magia del colore scelto, perde 1 punto vita.\', \'type\': \'Incantesimo\', \'flavor\': \'"Dobbiamo tutti sopportarne il dolore per guarire il nostro mondo." —Ayli, chierica di Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216329&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9b1981f2-90d7-463a-8ab2-0c42912290f2\', \'multiverseId\': 216329}, \'multiverseid\': 216329}, {\'name\': \'魔術の呪い\', \'text\': \'魔術の呪いが戦場に出るに際し、色を１色選ぶ。\\nいずれかのプレイヤーが選ばれた色の呪文を１つ唱えるたび、そのプレイヤーは１点のライフを失う。\', \'type\': \'エンチャント\', \'flavor\': \'「この世界を癒すために、我々は皆この苦痛を乗り越えなければいけません。」 ――カムサの僧侶、アイリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216577&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71a8d44a-0f42-45c2-99ce-7597b6c772ff\', \'multiverseId\': 216577}, \'multiverseid\': 216577}, {\'name\': \'Maldição da Feitiçaria\', \'text\': \'Conforme Maldição da Feitiçaria entrar no campo de batalha, escolha uma cor.\\nToda vez que um jogador conjura uma mágica da cor escolhida, aquele jogador perde 1 ponto de vida.\', \'type\': \'Encantamento\', \'flavor\': \'"Todos nós precisamos superar a dor para curar nosso mundo." — Ayli, clérigo de Kamsa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9a013b52-3724-4c9c-9c58-322234614800\', \'multiverseId\': 216825}, \'multiverseid\': 216825}, {\'name\': \'Проклятие Чародейства\', \'text\': \'При выходе Проклятия Чародейства на поле битвы выберите цвет.\\nКаждый раз когда игрок разыгрывает заклинание выбранного цвета, тот игрок теряет 1 жизнь.\', \'type\': \'Чары\', \'flavor\': \'«Мы все должны преодолеть боль, чтобы излечить наш мир». — Айли, служительница Камсы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215833&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9444eb28-c4f5-42a6-9789-81585733407b\', \'multiverseId\': 215833}, \'multiverseid\': 215833}, {\'name\': \'术法诅咒\', \'text\': \'于术法诅咒进战场时，选择一种颜色。\\n每当牌手施放该色的咒语时，该牌手失去1点生命。\', \'type\': \'结界\', \'flavor\': \'「我们必得忍受痛苦，才能治愈这世界。」 ～肯莎僧侣艾栗\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'78f4bece-d7e7-4d47-a75e-61ff3deba731\', \'multiverseId\': 216081}, \'multiverseid\': 216081}]', '[{\'name\': \'Flüchtige Ablenkung\', \'text\': \'Eine Kreatur deiner Wahl erhält -1/-0 bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Um einen Erzmagier abzulenken, braucht man unglaubliche Macht. Doch für Einfaltspinsel braucht man nur etwas, das glitzert." —Noyan Dar, Ruhezauberer aus Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1aa04ac-59a6-4198-b286-b42ca24757bd\', \'multiverseId\': 217521}, \'multiverseid\': 217521}, {\'name\': \'Distracción momentánea\', \'text\': \'La criatura objetivo obtiene -1/-0 hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Distraer a un archimago requiere un poder inmenso. Pero para alguien tan simple, algo que brille será suficiente." —Noyan Dar, mago arrullador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217273&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e5d558f-e82e-4fb0-b024-4153b17b43cd\', \'multiverseId\': 217273}, \'multiverseid\': 217273}, {\'name\': \'Distraction fugace\', \'text\': "La créature ciblée gagne -1/-0 jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'« Pour distraire un archimage, il faudrait une incroyable puissance. Mais pour un imbécile, quelques étincelles suffisent. » —Noyan Dar, ataraxmage de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215785&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6d357a98-56d0-4b28-a258-357ec440c481\', \'multiverseId\': 215785}, \'multiverseid\': 215785}, {\'name\': \'Distrazione Fugace\', \'text\': \'Una creatura bersaglio prende -1/-0 fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Per distrarre un arcimago ci vorrebbe un potere incredibile. Ma per un sempliciotto, basterà qualcosa di luccicante." —Noyan Dar, mitigatore di Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216529&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9801735-0358-411c-9ec1-6ae15f9199f8\', \'multiverseId\': 216529}, \'multiverseid\': 216529}, {\'name\': \'一瞬の散漫\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで－１/－０の修整を受ける。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「大魔導師の気を逸らすには、かなりの力が要る。 馬鹿なら何か光物一つで十分だ。」 ――タジームの凪魔道士、ノヤン・ダール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216777&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5890797-6bec-4adb-9307-aa9fe19835e6\', \'multiverseId\': 216777}, \'multiverseid\': 216777}, {\'name\': \'Distração Efêmera\', \'text\': \'A criatura alvo recebe -1/-0 até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Para distrair um arquimago seria necessário um poder incrível. Mas para um tolo, qualquer coisa brilhante serve." — Noyan Dar, Mago Anulador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217025&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b2536a47-04b5-4dcd-8314-8cb02c602a40\', \'multiverseId\': 217025}, \'multiverseid\': 217025}, {\'name\': \'Мимолетное Отвлечение\', \'text\': \'Целевое существо получает -1/-0 до конца хода.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Чтобы отвлечь архимага, нужна невероятная сила. Но для недалекого малого сойдет и просто что-нибудь блестящее». — Нойен Дар, маг-баюн из Тазима\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216033&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'15e0ea8a-0a55-49fb-9038-c38408eba6f2\', \'multiverseId\': 216033}, \'multiverseid\': 216033}, {\'name\': \'飞掠扰神\', \'text\': \'目标生物得-1/-0直到回合结束。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「要让大法师分心，得花上很多力气。 而对傻瓜来说，只要有个闪亮的东西就够了。」 ～塔晋息法师诺言达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216281&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d303094c-c9dd-4f8b-996f-03402af6405c\', \'multiverseId\': 216281}, \'multiverseid\': 216281}]', "[{'name': 'Folgenreicher Fall', 'text': 'Opfere eine Kreatur als zusätzliche Kosten, um Folgenreicher Fall zu wirken.\\nDu ziehst so viele Karten, wie die Stärke der geopferten Kreatur beträgt, dann erhältst du Lebenspunkte in Höhe ihrer Widerstandskraft dazu.', 'type': 'Spontanzauber', 'flavor': 'Es dauerte nicht lange, bis die Elfen für jeden Teil des Eldrazi einen Nutzen gefunden hatten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217356&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'fee4f08e-0b20-43a0-b51f-b597380ce4e6', 'multiverseId': 217356}, 'multiverseid': 217356}, {'name': 'Caída memorable', 'text': 'Como coste adicional para lanzar la Caída memorable, sacrifica una criatura.\\nRobas una cantidad de cartas igual a la fuerza de la criatura sacrificada, luego ganas una cantidad de vidas igual a su resistencia.', 'type': 'Instantáneo', 'flavor': 'Los elfos no tardaron mucho en desarrollar usos para cualquier parte de los eldrazi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217108&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '720a12af-dff8-4312-8968-d29f82fbac2a', 'multiverseId': 217108}, 'multiverseid': 217108}, {'name': 'Chute considérable', 'text': 'En tant que coût supplémentaire pour lancer la Chute considérable, sacrifiez une créature.\\nVous piochez un nombre de cartes égal à la force de la créature sacrifiée, et vous gagnez ensuite un nombre de points de vie égal à son endurance.', 'type': 'Éphémère', 'flavor': 'Il ne fallut pas longtemps aux elfes pour trouver des utilisations à toutes les parties des Eldrazi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215620&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e45d8d94-fcce-44b5-8830-a4d64c19908b', 'multiverseId': 215620}, 'multiverseid': 215620}, {'name': 'Grave Sconfitta', 'text': 'Come costo addizionale per lanciare la Grave Sconfitta, sacrifica una creatura.\\nPeschi carte pari alla forza della creatura sacrificata, poi guadagni punti vita pari alla sua costituzione.', 'type': 'Istantaneo', 'flavor': 'Non ci volle molto prima che gli elfi imparassero a sfruttare ogni singola parte degli Eldrazi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216364&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0369dedd-f109-4e62-a50b-d989a1fedc5f', 'multiverseId': 216364}, 'multiverseid': 216364}, {'name': '重大な落下', 'text': '重大な落下を唱えるための追加コストとして、クリーチャーを１体生け贄に捧げる。\\nあなたはその生け贄に捧げたクリーチャーのパワーに等しい枚数のカードを引き、その後それのタフネスに等しい点数のライフを得る。', 'type': 'インスタント', 'flavor': 'エルフがエルドラージのあらゆる部分の使い方を開発するまで長くはかからなかった。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216612&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b117a65b-4fa0-4882-b620-9dce03c0b3bc', 'multiverseId': 216612}, 'multiverseid': 216612}, {'name': 'Queda Monumental', 'text': 'Como custo adicional para conjurar Queda Monumental, sacrifique uma criatura.\\nVocê compra uma quantidade de cards igual ao poder da criatura sacrificada, e ganha uma quantidade de pontos de vida igual à resistência dela.', 'type': 'Mágica Instantânea', 'flavor': 'Não demorou muito para que os elfos desenvolvessem um uso para cada parte do Eldrazi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216860&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2f5c20e1-34e1-4533-b02f-9314f6d8460a', 'multiverseId': 216860}, 'multiverseid': 216860}, {'name': 'Судьбоносное Падение', 'text': 'В качестве дополнительной стоимости разыгрывания Судьбоносного Падения пожертвуйте существо.\\nВы берете количество карт, равное силе пожертвованного существа, затем вы получаете количество жизней, равное его выносливости.', 'type': 'Мгновенное заклинание', 'flavor': 'Прошло немного времени, и эльфы нашли применение всем частям Эльдрази.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215868&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd8aa4678-a3fa-4467-b432-bb7375cfed52', 'multiverseId': 215868}, 'multiverseid': 215868}, {'name': '重大阵亡', 'text': '牺牲一个生物，以作为施放重大阵亡的额外费用。\\n你抓等同于所牺牲生物之力量的牌，然后你获得等同于其防御力的生命。', 'type': '瞬间', 'flavor': '妖精不需多久便开发出利用奥札奇全身任一部分的方法。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216116&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8e1b02a5-90bd-4a51-aee9-547e57eb7f2b', 'multiverseId': 216116}, 'multiverseid': 216116}]", '[{\'name\': \'Frostwind-Beschwörer\', \'text\': \'Fliegend\\n{8}: Kreaturen, die du kontrollierst, erhalten bis zum Ende des Zuges Flugfähigkeit.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Wir dachten, dass die Forscher und Plünderer den Zorn Zendikars angestachelt hatten. Doch die Welt scheint gespürt zu haben, dass sich die Eldrazi wieder rührten." —Die Geschichten der Beschwörer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217341&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afaf5d77-da07-4466-8dd4-3a04812c5aaa\', \'multiverseId\': 217341}, \'multiverseid\': 217341}, {\'name\': \'Invocador del viento helado\', \'text\': \'Vuela.\\n{8}: Las criaturas que controlas ganan la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"Creíamos que la ira de Zendikar se debía a los exploradores y saqueadores. Pero el mundo sentía el agitar de los eldrazi." —Cuentos de los invocadores\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217093&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba0351bd-e363-48bc-85fa-5fa8fb1c820f\', \'multiverseId\': 217093}, \'multiverseid\': 217093}, {\'name\': \'Invocateur gêlevent\', \'text\': "Vol\\n{8} : Les créatures que vous contrôlez acquièrent le vol jusqu\'à la fin du tour.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "« Nous pensions que la rage de Zendikar avait été attisée par ses pillards et ses explorateurs. Mais le monde avait senti l\'éveil des Eldrazi. » —Les Contes des Invocateurs", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215605&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b41cadc9-fcb6-4e6a-b5f8-745e719a60f3\', \'multiverseId\': 215605}, \'multiverseid\': 215605}, {\'name\': \'Evocatore di Vento Gelido\', \'text\': \'Volare\\n{8}: Le creature che controlli hanno volare fino alla fine del turno.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Pensavamo che l\\\'ira di Zendikar fosse attizzata dai suoi esploratori e predoni. Ma il mondo ha percepito i fermenti degli Eldrazi." —Racconti degli Evocatori\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216349&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a49aa8e3-d63b-4bad-9399-ec2b377afbc5\', \'multiverseId\': 216349}, \'multiverseid\': 216349}, {\'name\': \'霜風の発動者\', \'text\': \'飛行\\n{8}：あなたがコントロールするクリーチャーは、ターン終了時まで飛行を得る。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'「我々は、ゼンディカーの怒りは探検家や略奪者に火をつけられたものだと思っていた。 しかし実際は、世界はエルドラージの活動を感じていたのだ。」 ――「発動者伝」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216597&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eae3cebc-9b9a-421f-bef7-e19f2bef4ed2\', \'multiverseId\': 216597}, \'multiverseid\': 216597}, {\'name\': \'Invocador do Vento Gélido\', \'text\': \'Voar\\n{8}: As criaturas que você controla ganham voar até o final do turno.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"Nós acreditávamos que a ira de Zendikar era alimentada por seus exploradores e saqueadores. Mas o mundo havia percebido a energia ativa dos Eldrazi." — Lendas dos Invocadores\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216845&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b73136d-d062-431c-a028-3a0a10202b25\', \'multiverseId\': 216845}, \'multiverseid\': 216845}, {\'name\': \'Призыватель Морозного Ветра\', \'text\': \'Полет\\n{8}: существа под вашим контролем получают Полет до конца хода.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Мы думали, что ярость Зендикара распалили исследователи и расхитители сокровищ. Но мир уже чувствовал шевеления Эльдрази». — Сказания призывателей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215853&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84201a1b-53d4-40d2-a4c6-e01c18bc7252\', \'multiverseId\': 215853}, \'multiverseid\': 215853}, {\'name\': \'飘风召现师\', \'text\': \'飞行\\n{8}：由你操控的生物获得飞行异能直到回合结束。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'「我们以为赞迪卡的愤怒是被探险家与夺宝者所挑起的。 其实这世界已感知到奥札奇在蠢蠢欲动。」 ～《召现师传说》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216101&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ea343e7e-adb9-4ab6-9c9a-f9ad3ee6180b\', \'multiverseId\': 216101}, \'multiverseid\': 216101}]', "[{'name': 'Fürst vom Schädeltrümmerpass', 'text': 'Stufe aufsteigen {1}{R} ({1}{R}: Lege eine Stufenmarke auf diese Karte. Spiele Stufe aufsteigen wie eine Hexerei.)\\nSTUFE 1-5\\n6/6\\nSTUFE 6+\\n6/6\\nImmer wenn der Fürst vom Schädeltrümmerpass angreift, fügt er allen Kreaturen, die der verteidigende Spieler kontrolliert, 6 Schadenspunkte zu.', 'type': 'Kreatur — Minotaurus, Schamane', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217492&type=card', 'language': 'German', 'identifiers': {'scryfallId': '99e62a0c-71e2-4218-ba18-7c24a42817e3', 'multiverseId': 217492}, 'multiverseid': 217492}, {'name': 'Señor del Paso Aplastacráneos', 'text': 'Subir de nivel {1}{R}. ({1}{R}: Pon un contador de nivel sobre esto. Sube de nivel sólo como un conjuro.)\\nNIVEL 1-5\\n6/6\\nNIVEL 6+\\n6/6\\nSiempre que el Señor del Paso Aplastacráneos ataque, hace 6 puntos de daño a cada criatura que controla el jugador defensor.', 'type': 'Criatura — Chamán minotauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217244&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9533321e-f2f2-4623-8636-2b1aa28e03f2', 'multiverseId': 217244}, 'multiverseid': 217244}, {'name': 'Seigneur du Col de Fracassecrâne', 'text': 'Montée de niveau {1}{R} ({1}{R} : Mettez un marqueur « niveau » sur cette créature. Ne montez de niveau que lorsque vous pourriez lancer un rituel.)\\nNIVEAU 1-5\\n6/6\\nNIVEAU 6+\\n6/6\\nÀ chaque fois que le Seigneur du Col de Fracassecrâne attaque, il inflige 6 blessures à chaque créature que le joueur défenseur contrôle.', 'type': 'Créature : minotaure et shamane', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215756&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1027e095-9bca-4dd6-94b2-b5c1d1648187', 'multiverseId': 215756}, 'multiverseid': 215756}, {'name': 'Signore del Passo Frantumateschio', 'text': 'Aumentare di livello {1}{R} ({1}{R}: Metti un segnalino livello su questa creatura. Aumenta di livello solo quando potresti lanciare una stregoneria.)\\nLIVELLO 1-5\\n6/6\\nLIVELLO 6+\\n6/6\\nOgniqualvolta il Signore del Passo Frantumateschio attacca, infligge 6 danni a ogni creatura controllata dal giocatore in difesa.', 'type': 'Creatura — Sciamano Minotauro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216500&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2b3b20c1-af1e-4bd8-a9c4-39550b156be7', 'multiverseId': 216500}, 'multiverseid': 216500}, {'name': '髑髏砕き峡の王', 'text': 'Lvアップ {1}{R} ({1}{R}：この上にLvカウンターを１個置く。 Lvアップはソーサリーとしてのみ行う。）\\nLv 1-5\\n6/6\\nLv 6+\\n6/6\\n髑髏砕き峡の王が攻撃するたび、それは防御プレイヤーがコントロールする各クリーチャーに、それぞれ６点のダメージを与える。', 'type': 'クリーチャー — ミノタウルス・シャーマン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216748&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c6be5aea-5252-44b6-a72b-7905133e3e36', 'multiverseId': 216748}, 'multiverseid': 216748}, {'name': 'Senhor do Passo de Quebra-Crânio', 'text': 'Subir de nível {1}{R} ({1}{R}: Coloque um marcador de nível nesta criatura. Suba de nível somente quando puder jogar um feitiço.)\\nNÍVEL 1-5\\n6/6\\nNÍVEL 6+\\n6/6\\nToda vez que Senhor do Passo de Quebra-Crânio ataca, ele causa 6 pontos de dano a cada criatura que o jogador defensor controla.', 'type': 'Criatura — Minotauro Xamã', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216996&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'eeed8ce4-0e23-4f7d-acf9-499493be2103', 'multiverseId': 216996}, 'multiverseid': 216996}, {'name': 'Властелин Череполомного Перевала', 'text': 'Повышение уровня {1}{R} ({1}{R}: положите один жетон уровня на это существо. Повышайте уровень только как волшебство.)\\nУРОВЕНЬ 1-5\\n6/6\\nУРОВЕНЬ 6+\\n6/6\\nКаждый раз когда Властелин Череполомного Перевала атакует, он наносит 6 повреждений каждому существу под контролем защищающегося игрока.', 'type': 'Существо — Минотавр Шаман', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216004&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1df62c04-abb3-4b6b-9698-5d32d63ced0f', 'multiverseId': 216004}, 'multiverseid': 216004}, {'name': '碎颅隘口领主', 'text': '升级{1}{R} （{1}{R}：在其上放置一个等级指示物。 升级的时机视同法术。）\\n等级1-5\\n6/6\\n等级6+\\n6/6\\n每当碎颅隘口领主攻击时，它对由防御牌手所操控的每个生物各造成6点伤害。', 'type': '生物～牛头怪／祭师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216252&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'adf4b8f7-5e44-4a27-aab7-1ba93857164a', 'multiverseId': 216252}, 'multiverseid': 216252}]", '[{\'name\': \'Gallertentstehung\', \'text\': \'Bringe X X/X grüne Schlammwesen-Kreaturenspielsteine ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': \'Die marodierenden Eldrazi hinterließen die Welt zerstört und blutig, doch aus den Wunden begann schon wieder neues Leben zu tropfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217360&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f73d57b-75d1-4242-8748-2d3d95f78c66\', \'multiverseId\': 217360}, \'multiverseid\': 217360}, {\'name\': \'Génesis gelatinosa\', \'text\': \'Pon en el campo de batalla X fichas de criatura Cieno verdes X/X.\', \'type\': \'Conjuro\', \'flavor\': \'Cuando el mundo aún sangraba por el ataque de los eldrazi, nueva vida comenzó a surgir de las heridas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217112&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'27187c20-f425-4702-9b02-b4e04184abba\', \'multiverseId\': 217112}, \'multiverseid\': 217112}, {\'name\': \'Genèse gélatineuse\', \'text\': \'Mettez sur le champ de bataille X jetons de créature X/X verte Limon.\', \'type\': \'Rituel\', \'flavor\': "À peine le monde était-il meurtri par les impitoyables Eldrazi qu\'une nouvelle vie commençait à suppurer de ses blessures.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215624&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e9df1b8-da9c-4652-8164-be73d661e216\', \'multiverseId\': 215624}, \'multiverseid\': 215624}, {\'name\': \'Genesi Gelatinosa\', \'text\': \'Metti sul campo di battaglia X pedine creatura Melma X/X verdi.\', \'type\': \'Stregoneria\', \'flavor\': \'Anche dopo che gli Eldrazi lasciarono il mondo spezzato e insanguinato, nuove forme di vita iniziarono a colare dalle sue ferite.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216368&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3dfcbd2a-ce15-41e3-bbe9-3608aa01532a\', \'multiverseId\': 216368}, \'multiverseid\': 216368}, {\'name\': \'軟体の起源\', \'text\': \'緑のＸ/Ｘのウーズ・クリーチャー・トークンをＸ体戦場に出す。\', \'type\': \'ソーサリー\', \'flavor\': \'世界がエルドラージの襲撃に砕け血だらけになった後ですら、その傷跡から新たな生命が滴り落ちていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216616&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7eb56085-66f3-4438-be6f-88b951bf53a2\', \'multiverseId\': 216616}, \'multiverseid\': 216616}, {\'name\': \'Gênese Gelatinosa\', \'text\': \'Coloque no campo de batalha X fichas de criatura verdes X/X do tipo Lodo.\', \'type\': \'Feitiço\', \'flavor\': \'Mesmo com o mundo destroçado e sangrento deixado pelos Eldrazi saqueadores, uma nova vida começou a gotejar de suas feridas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216864&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f2b7abbb-14f6-4ef2-a9d5-c6482d9137e0\', \'multiverseId\': 216864}, \'multiverseid\': 216864}, {\'name\': \'Студенистое Зарождение\', \'text\': \'Положите на поле битвы X фишек существа X/X зеленая Тина.\', \'type\': \'Волшебство\', \'flavor\': \'Даже когда всеопустошающие Эльдрази надломили мир и залили его кровью, новая жизнь начала сочиться из его ран.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215872&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'94a92312-b958-4161-902a-729078990086\', \'multiverseId\': 215872}, \'multiverseid\': 215872}, {\'name\': \'凝胶创生\', \'text\': \'将X个X/X绿色流浆衍生物放进战场。\', \'type\': \'法术\', \'flavor\': \'即使这世界已被侵袭的奥札奇撕裂，新生命依旧从其伤口降临世间。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216120&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4a0a8073-b3cf-4ed1-8c11-ed233f2bb9f1\', \'multiverseId\': 216120}, \'multiverseid\': 216120}]', "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217524&type=card', 'language': 'German', 'identifiers': {'scryfallId': '13482cad-b2fb-4eab-b90d-1e82a6026d41', 'multiverseId': 217524}, 'multiverseid': 217524}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217276&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ce494415-994c-4130-bf4f-73facef29fb9', 'multiverseId': 217276}, 'multiverseid': 217276}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215788&type=card', 'language': 'French', 'identifiers': {'scryfallId': '448acd67-6ef2-4c92-9363-d4548d2bad53', 'multiverseId': 215788}, 'multiverseid': 215788}, {'name': 'Montagna', 'text': '{R}', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216532&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'bbd3d5ba-8d35-4472-8171-2e4530f58092', 'multiverseId': 216532}, 'multiverseid': 216532}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216780&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2e7b3216-609e-4bc2-a44f-a7f9f13e2026', 'multiverseId': 216780}, 'multiverseid': 216780}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217028&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '50f95532-f418-4716-b731-0649c497908f', 'multiverseId': 217028}, 'multiverseid': 217028}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216036&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4d0e4708-113f-4b5b-83fd-db5a01e13106', 'multiverseId': 216036}, 'multiverseid': 216036}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216284&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '35b75506-2415-4fe7-946a-f26fb5de268e', 'multiverseId': 216284}, 'multiverseid': 216284}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217526&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b2c65cf2-090c-41a7-b060-b0579e69398f', 'multiverseId': 217526}, 'multiverseid': 217526}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217278&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '60f37aab-fac9-42a3-8d5d-8ebc98a77433', 'multiverseId': 217278}, 'multiverseid': 217278}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215790&type=card', 'language': 'French', 'identifiers': {'scryfallId': '203179f7-5534-4021-8532-aa50eae02614', 'multiverseId': 215790}, 'multiverseid': 215790}, {'name': 'Montagna', 'text': '{R}', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216534&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '30770df2-e270-4f06-bc1e-a18432e9d976', 'multiverseId': 216534}, 'multiverseid': 216534}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216782&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '80730ed8-9595-4bb1-a9a1-4566ffcee3cf', 'multiverseId': 216782}, 'multiverseid': 216782}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217030&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0f1e47aa-6e52-4c8f-a89c-af011b9fc281', 'multiverseId': 217030}, 'multiverseid': 217030}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216038&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'af3f06a0-a022-47e1-a227-acc8765b1647', 'multiverseId': 216038}, 'multiverseid': 216038}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216286&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '70ed3f89-615d-4ec2-80b8-80dec479b677', 'multiverseId': 216286}, 'multiverseid': 216286}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217535&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a67efa0d-4d54-406a-bba1-5fadabedc42e', 'multiverseId': 217535}, 'multiverseid': 217535}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217287&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4f7716e0-99bd-4d6f-83ad-6669532bf1a2', 'multiverseId': 217287}, 'multiverseid': 217287}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215799&type=card', 'language': 'French', 'identifiers': {'scryfallId': '0cdc003b-ce54-4477-8b55-c87b2fc4b1c1', 'multiverseId': 215799}, 'multiverseid': 215799}, {'name': 'Montagna', 'text': '{R}', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216543&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b53129ff-f21b-4c13-91d8-ea7214294289', 'multiverseId': 216543}, 'multiverseid': 216543}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216791&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'b844161f-e016-430b-aa95-4bf5dce7b99d', 'multiverseId': 216791}, 'multiverseid': 216791}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217039&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '14472da6-d019-44a1-bbe4-24f182a5185c', 'multiverseId': 217039}, 'multiverseid': 217039}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216047&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7ae36e55-7eec-4611-b821-cd98ec51b2bb', 'multiverseId': 216047}, 'multiverseid': 216047}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216295&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c566bb40-fbb1-4f9e-a9cd-7ce9a65c1a2a', 'multiverseId': 216295}, 'multiverseid': 216295}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217543&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ad34ae71-8481-4e66-8fa5-40bd68b35cfb', 'multiverseId': 217543}, 'multiverseid': 217543}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217295&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f6ac0967-d8c4-468e-8182-65bcfc9497a9', 'multiverseId': 217295}, 'multiverseid': 217295}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215807&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e4e961ca-6c3b-448b-af33-9071c7b59993', 'multiverseId': 215807}, 'multiverseid': 215807}, {'name': 'Montagna', 'text': '{R}', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216551&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '346b9ed8-a88b-4c62-b85b-7b27439877f5', 'multiverseId': 216551}, 'multiverseid': 216551}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216799&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '48f791d5-7a90-4214-8e61-dfe8d48d1481', 'multiverseId': 216799}, 'multiverseid': 216799}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217047&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3c5a9648-722d-45ed-8e16-681e067fcb34', 'multiverseId': 217047}, 'multiverseid': 217047}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216055&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '578709b8-50ce-4135-a53b-4e3ac57ad299', 'multiverseId': 216055}, 'multiverseid': 216055}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216303&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '36740d50-5386-4204-ae3c-cf04b35de68f', 'multiverseId': 216303}, 'multiverseid': 216303}]", '[{\'name\': \'Gebären der Brut\', \'text\': \'Falls du eine (Eldrazi, Ausgeburt) kontrollierst, bringe drei 0/1 farblose (Eldrazi, Ausgeburt)-Kreaturenspielsteine ins Spiel. Sie haben „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}". Bringe sonst einen dieser Spielsteine ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217442&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'223017a5-a6bc-4c83-92bc-790002b9a6c3\', \'multiverseId\': 217442}, \'multiverseid\': 217442}, {\'name\': \'Nacimiento de la progenie\', \'text\': \'Si controlas un Engendro Eldrazi, pon en el campo de batalla tres fichas de criatura Engendro Eldrazi incoloras 0/1. Tienen "Sacrificar esta criatura: Agrega {1} a tu reserva de maná". De lo contrario, pon en el campo de batalla una de esas fichas.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217194&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'305b0dff-36a2-4cda-b124-d609f83de59e\', \'multiverseId\': 217194}, \'multiverseid\': 217194}, {\'name\': \'Naissance de la progéniture\', \'text\': \'Si vous contrôlez un eldrazi et engeance, mettez sur le champ de bataille trois jetons de créature 0/1 incolore Eldrazi et Engeance. Ils ont « Sacrifiez cette créature : Ajoutez {1} à votre réserve. » Sinon, mettez un de ces jetons sur le champ de bataille.\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215706&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4fae3304-ed16-4114-ae2e-35a33c871964\', \'multiverseId\': 215706}, \'multiverseid\': 215706}, {\'name\': \'Nascita della Covata\', \'text\': \'Se controlli una Progenie Eldrazi, metti sul campo di battaglia tre pedine creatura Progenie Eldrazi 0/1 incolori. Hanno "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana". Altrimenti, metti sul campo di battaglia una di quelle pedine.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216450&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e92f8df3-0247-4a13-a316-52f4a21c8b46\', \'multiverseId\': 216450}, \'multiverseid\': 216450}, {\'name\': \'群れの誕生\', \'text\': \'あなたがエルドラージ・落し子をコントロールしている場合、無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを３体戦場に出す。 それらは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。 そうでない場合、そのトークンを１体戦場に出す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216698&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'293bc4cd-258c-4ea9-b614-8311c963da3e\', \'multiverseId\': 216698}, \'multiverseid\': 216698}, {\'name\': \'Nascimento da Ninhada\', \'text\': \'Se você controla um Prole Eldrazi, coloque no campo de batalha três fichas de criatura incolores 0/1 do tipo Prole Eldrazi. Elas têm "Sacrifique esta criatura: Adicione {1} à sua reserva de mana." Do contrário, coloque uma dessas fichas no campo de batalha.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216946&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5b946dae-7ff1-4d53-bd3a-44864d778f9f\', \'multiverseId\': 216946}, \'multiverseid\': 216946}, {\'name\': \'Рождение Выводка\', \'text\': \'Если под вашим контролем есть Эльдрази Порождение, положите на поле битвы три фишки существа 0/1 бесцветный Эльдрази Порождение. У них есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны». В противном случае положите на поле битвы одну из тех фишек.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215954&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e5dd5289-3ab9-4902-81c3-5bd8531eae5c\', \'multiverseId\': 215954}, \'multiverseid\': 215954}, {\'name\': \'整巢诞生\', \'text\': \'如果你操控了同时为奥札奇与后裔的永久物，则将三个0/1无色奥札奇／后裔衍生物放进战场。 它们具有「牺牲此生物：加{1}到你的法术力池中。」 若否，则将一个上述的衍生物放进战场。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216202&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'732c9fc7-1b8e-49d2-a249-502cba9c8f62\', \'multiverseId\': 216202}, \'multiverseid\': 216202}]', '[{\'name\': \'Gebärender Atem\', \'text\': \'Der Gebärende Atem fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu. Bringe einen 0/1 farblosen (Eldrazi, Ausgeburt)-Kreaturenspielstein ins Spiel. Er hat „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Spontanzauber\', \'flavor\': \'Mit jedem Tod breitete sich Kozileks Nachwuchs aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217311&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e79b17c-bc2b-41a2-a957-ef4cbd437a04\', \'multiverseId\': 217311}, \'multiverseid\': 217311}, {\'name\': \'Aliento engendrador\', \'text\': \'El Aliento engendrador hace 1 punto de daño a la criatura o jugador objetivo. Pon en el campo de batalla una ficha de criatura Engendro Eldrazi incolora 0/1. Tiene "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Instantáneo\', \'flavor\': \'Muerte tras muerte, el linaje de Kozilek se expande.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217063&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6f0dc518-8209-49c8-95d3-c15c59bea66f\', \'multiverseId\': 217063}, \'multiverseid\': 217063}, {\'name\': \'Souffle de prolifération\', \'text\': \'Le Souffle de prolifération inflige 1 blessure à une cible, créature ou joueur. Mettez sur le champ de bataille un jeton de créature 0/1 incolore Eldrazi et Engeance. Il a « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »\', \'type\': \'Éphémère\', \'flavor\': "À chaque mort, la lignée de Kozilek s\'étendait.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215575&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'92e1a0eb-0254-468a-9d8d-67591ad3f765\', \'multiverseId\': 215575}, \'multiverseid\': 215575}, {\'name\': \'Soffio Progenitore\', \'text\': \'Il Soffio Progenitore infligge 1 danno a una creatura o a un giocatore bersaglio. Metti sul campo di battaglia una pedina creatura Progenie Eldrazi 0/1 incolore. Ha "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Istantaneo\', \'flavor\': "Una morte dopo l\'altra, la stirpe di Kozilek si diffonde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216319&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'008e8348-ee5a-4a44-88fd-b35fe5238e70\', \'multiverseId\': 216319}, \'multiverseid\': 216319}, {\'name\': \'産卵の息\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。産卵の息はそれに１点のダメージを与える。 無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを１体戦場に出す。 それは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'インスタント\', \'flavor\': \'死が増えるたびに、コジレックの系族は広がっていく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216567&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec6fb8a5-cfa7-4c26-a922-188f46703660\', \'multiverseId\': 216567}, \'multiverseid\': 216567}, {\'name\': \'Suspiro Procriador\', \'text\': \'Suspiro Procriador causa 1 ponto de dano à criatura ou ao jogador alvo. Coloque no campo de batalha uma ficha de criatura incolor 0/1 do tipo Prole Eldrazi. Ela tem "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Uma morte após a outra, a linhagem de Kozilek dissemina-se.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216815&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba10ea9d-d73b-4762-adce-ceae3a86e860\', \'multiverseId\': 216815}, \'multiverseid\': 216815}, {\'name\': \'Порождающее Дыхание\', \'text\': \'Порождающее Дыхание наносит 1 повреждение целевому существу или игроку. Положите на поле битвы одну фишку существа 0/1 бесцветный Эльдрази Порождение. У нее есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Смерть за смертью разрастался род Козилека.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215823&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'00425c0e-84a0-4df1-9b79-cb21da931764\', \'multiverseId\': 215823}, \'multiverseid\': 215823}, {\'name\': \'后裔喷息\', \'text\': \'后裔喷息对目标生物或牌手造成1点伤害。 将一个0/1无色奥札奇／后裔衍生物放进战场。 它具有「牺牲此生物：加{1}到你的法术力池中。」\', \'type\': \'瞬间\', \'flavor\': \'死亡绵延，寇基雷的家系也跟着扩展。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216071&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1b2b007-4406-4357-9269-ac4390b78861\', \'multiverseId\': 216071}, \'multiverseid\': 216071}]', '[{\'name\': \'Gedankenverschlinger\', \'text\': \'Verursacht Trampelschaden\\nWenn der Gedankenverschlinger ins Spiel kommt, lege für jede Karte auf deiner Hand eine +1/+1-Marke auf ihn. Falls du dies tust, wirf alle Karten aus deiner Hand ab.\\nWenn der Gedankenverschlinger das Spiel verlässt, ziehe für jede +1/+1-Marke auf ihm eine Karte.\', \'type\': \'Kreatur — Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217327&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af415ee5-67de-4d3f-83fe-a466ce80bf12\', \'multiverseId\': 217327}, \'multiverseid\': 217327}, {\'name\': \'Tragapensamientos\', \'text\': \'Arrolla.\\nCuando el Tragapensamientos entre al campo de batalla, pon un contador +1/+1 sobre él por cada carta en tu mano. Si lo haces, descarta tu mano.\\nCuando el Tragapensamientos deje el campo de batalla, roba una carta por cada contador +1/+1 sobre él.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217079&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb09d93c-cbfd-41e8-ab4c-cb96049fc180\', \'multiverseId\': 217079}, \'multiverseid\': 217079}, {\'name\': \'Avaleur de pensées\', \'text\': "Piétinement\\nQuand l\'Avaleur de pensées arrive sur le champ de bataille, mettez sur lui un marqueur +1/+1 pour chaque carte dans votre main. Si vous faites ainsi, défaussez-vous de votre main.\\nQuand l\'Avaleur de pensées quitte le champ de bataille, piochez une carte pour chaque marqueur +1/+1 sur lui.", \'type\': \'Créature : horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215591&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4fcc25ba-2b46-49bf-80ec-0dc5f1a8deb3\', \'multiverseId\': 215591}, \'multiverseid\': 215591}, {\'name\': \'Ingoiatore di Pensieri\', \'text\': "Travolgere\\nQuando l\'Ingoiatore di Pensieri entra nel campo di battaglia, metti un segnalino +1/+1 su di esso per ogni carta che hai in mano. Se lo fai, scarta la tua mano.\\nQuando l\'Ingoiatore di Pensieri lascia il campo di battaglia, pesca una carta per ogni segnalino +1/+1 su di esso.", \'type\': \'Creatura — Orrore\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216335&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4592ac78-ad0d-4abf-9885-c6bdaaf75763\', \'multiverseId\': 216335}, \'multiverseid\': 216335}, {\'name\': \'思考喰らい\', \'text\': \'トランプル\\n思考喰らいが戦場に出たとき、あなたの手札にあるカード１枚につき、それの上に＋１/＋１カウンターを１個置く。 そうした場合、あなたの手札を捨てる。\\n思考喰らいが戦場を離れたとき、それの上に置かれている＋１/＋１カウンター１個につきカードを１枚引く。\', \'type\': \'クリーチャー — ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216583&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4225060a-5b5d-453e-b6d7-741595ef96f5\', \'multiverseId\': 216583}, \'multiverseid\': 216583}, {\'name\': \'Devorador de Pensamentos\', \'text\': \'Atropelar\\nQuando Devorador de Pensamentos entrar no campo de batalha, coloque um marcador +1/+1 nele para cada card na sua mão. Se fizer isso, descarte sua mão.\\nQuando Devorador de Pensamentos deixar o campo de batalha, compre um card para cada marcador +1/+1 sobre ele.\', \'type\': \'Criatura — Horror\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216831&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1fda5752-41c7-4e1f-8349-e10002cc187f\', \'multiverseId\': 216831}, \'multiverseid\': 216831}, {\'name\': \'Пожиратель Мыслей\', \'text\': \'Пробивной удар\\nКогда Пожиратель Мыслей выходит на поле битвы, положите на него один жетон +1/+1 за каждую карту в вашей руке. Если вы это делаете, сбросьте вашу руку.\\nКогда Пожиратель Мыслей покидает поле битвы, возьмите одну карту за каждый жетон +1/+1 на нем.\', \'type\': \'Существо — Ужас\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215839&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4af904c6-fbec-43ec-a900-f63e532ee584\', \'multiverseId\': 215839}, \'multiverseid\': 215839}, {\'name\': \'思想食客\', \'text\': \'践踏\\n当思想食客进战场时，你每有一张手牌，便在其上放置一个+1/+1指示物 若你如此作，则弃掉你的手牌。\\n当思想食客离开战场时，其上每有一个+1/+1指示物，便抓一张牌。\', \'type\': \'生物～惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216087&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'03142711-c168-4555-bcab-ed8d915be53a\', \'multiverseId\': 216087}, \'multiverseid\': 216087}]', '[{\'name\': \'Gefährtin der Seele\', \'text\': \'Immer wenn eine andere Kreatur ins Spiel kommt, kannst du 1 Lebenspunkt dazuerhalten.\', \'type\': \'Kreatur — Mensch, Kleriker\', \'flavor\': \'Eigentlich war ihr eigener Glauben von Ulamog zertrampelt worden. Sie stellte die Segnung pantomimisch dar und hoffte, dass dadurch andere ermuntert würden, weiter zu kämpfen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217357&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'944116bb-5350-4a7f-84dc-cb9f3b2de226\', \'multiverseId\': 217357}, \'multiverseid\': 217357}, {\'name\': \'Asistente del alma\', \'text\': \'Siempre que otra criatura entre al campo de batalla, puedes ganar 1 vida.\', \'type\': \'Criatura — Clérigo humano\', \'flavor\': \'La verdad es que su propia fe había desaparecido, aplastada por el despertar de Ulamog. Fingió la bendición con la esperanza de que inspiraría a los demás para continuar luchando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217109&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6247a82b-4069-4d32-b498-014124aa90e4\', \'multiverseId\': 217109}, \'multiverseid\': 217109}, {\'name\': "Suivante de l\'âme", \'text\': "À chaque fois qu\'une autre créature arrive sur le champ de bataille, vous pouvez gagner 1 point de vie.", \'type\': \'Créature : humain et clerc\', \'flavor\': "En réalité, sa foi avait péri, piétinée dans le sillage d\'Ulamog. Elle mimait la bénédiction dans l\'espoir d\'inspirer d\'autres à continuer la lutte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215621&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d878a0da-4aa5-44ef-a8ca-e9fa3167a475\', \'multiverseId\': 215621}, \'multiverseid\': 215621}, {\'name\': "Custode dell\'Anima", \'text\': "Ogniqualvolta un\'altra creatura entra nel campo di battaglia, puoi guadagnare 1 punto vita.", \'type\': \'Creatura — Chierico Umano\', \'flavor\': \'In verità, la sua stessa fede era sparita, spinta nella scia di Ulamog. Mimava la benedizione nella speranza che ispirasse gli altri a continuare la battaglia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216365&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'622511df-c094-44b1-9dd5-3ed1bcf62ec4\', \'multiverseId\': 216365}, \'multiverseid\': 216365}, {\'name\': \'魂の従者\', \'text\': \'他のクリーチャーが１体戦場に出るたび、あなたは１点のライフを得てもよい。\', \'type\': \'クリーチャー — 人間・クレリック\', \'flavor\': \'実際は、彼女の信仰はウラモグの目覚めと共に踏みにじられ消えうせていた。 彼女は他人が戦いを続けるための心の拠り所として、祝福の振りを続けていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216613&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5fd36b38-0b44-4178-9387-24f639bec009\', \'multiverseId\': 216613}, \'multiverseid\': 216613}, {\'name\': \'Assistente da Alma\', \'text\': \'Toda vez que outra criatura entra no campo de batalha, você pode ganhar 1 ponto de vida.\', \'type\': \'Criatura — Humano Clérigo\', \'flavor\': \'Na verdade, sua própria fé havia desaparecido, esmagada sob o rastro do Ulamog. Ela pantomimou a bênção na esperança de que pudesse inspirar os outros a continuar lutando.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216861&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57e1fe00-dae8-4c54-9f3a-9ddeb006e9a3\', \'multiverseId\': 216861}, \'multiverseid\': 216861}, {\'name\': \'Помощница Души\', \'text\': \'Каждый раз когда другое существо выходит на поле битвы, вы можете получить 1 жизнь.\', \'type\': \'Существо — Человек Священник\', \'flavor\': \'По правде говоря, ее собственная вера уже была растоптана Уламогом. Теперь она имитировала благословение в надежде, что оно вдохновит других на продолжение борьбы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215869&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e847a3c1-f8bc-4156-ac6d-d17d3be55e85\', \'multiverseId\': 215869}, \'multiverseid\': 215869}, {\'name\': \'灵魂照护僧\', \'text\': \'每当另一个生物进战场时，你可以获得1点生命。\', \'type\': \'生物～人类／僧侣\', \'flavor\': \'事实上，她自身的信念已随着钨拉莫现身而消逝。 她继续施用祝福手势，希望这能够鼓舞他人继续搏斗的意志。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216117&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3a214738-ba34-4682-b88d-a1a3292fc1a8\', \'multiverseId\': 216117}, \'multiverseid\': 216117}]', '[{\'name\': \'Gespaltener Donnerschlag\', \'text\': \'Der Gespaltene Donnerschlag fügt 2 Schadenspunkte zu, deren Aufteilung auf ein oder zwei Ziele deiner Wahl, die Kreaturen und/oder Spieler sein können, du bestimmst.\', \'type\': \'Hexerei\', \'flavor\': \'„Es lohnt nicht, Lieblinge zu haben. Jeder muss irgendwann sterben." —Sprichwort der Funkenmagier\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217366&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'43fad73f-374a-41b4-9ad3-b2d5c3a2213c\', \'multiverseId\': 217366}, \'multiverseid\': 217366}, {\'name\': \'Rayo bifurcado\', \'text\': \'El Rayo bifurcado hace 2 puntos de daño divididos como elijas entre una o dos criaturas y/o jugadores objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'"Sin favoritos. Todos mueren." —Refrán de magochispa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217118&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d6ded43-d2af-4e94-8fdc-97ac66c64fe3\', \'multiverseId\': 217118}, \'multiverseid\': 217118}, {\'name\': \'Éclair fourchu\', \'text\': "L\'Éclair fourchu inflige 2 blessures réparties comme vous le désirez entre une ou deux cibles, créatures et/ou joueurs.", \'type\': \'Rituel\', \'flavor\': \'« Pas de favoritisme. Tout le monde meurt. » —Dicton étincemage\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215630&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4af02aba-b396-441a-90fc-06eb762ea97e\', \'multiverseId\': 215630}, \'multiverseid\': 215630}, {\'name\': \'Fulmine Biforcato\', \'text\': \'Il Fulmine Biforcato infligge 2 danni divisi a tua scelta tra una o due creature e/o giocatori bersaglio.\', \'type\': \'Stregoneria\', \'flavor\': \'"Non si fanno favoritismi. Tutti muoiono." —Motto dei maghiscintilla\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216374&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3a57c33d-f59b-48f8-90ad-661242d5f469\', \'multiverseId\': 216374}, \'multiverseid\': 216374}, {\'name\': \'二股の稲妻\', \'text\': \'クリーチャーやプレイヤーを、１つまたは望む組み合わせで２つ対象とする。二股の稲妻はそれらに、２点のダメージを好きなように分割して与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「選り好みするな。 どうせみんな死ぬ。」 ――火花魔道士の言い回し\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216622&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8ad791cf-1b0c-4e1d-888e-4bd5744d044a\', \'multiverseId\': 216622}, \'multiverseid\': 216622}, {\'name\': \'Raio Bifurcado\', \'text\': \'Raio Bifurcado causa 2 pontos de dano divididos como você escolher entre uma ou duas criaturas e/ou jogadores alvo.\', \'type\': \'Feitiço\', \'flavor\': \'"Não há favoritismo. Todo mundo morre." — Ditado do Mago de Centelhas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216870&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'375f344b-f39a-4399-b440-8ebde40be64e\', \'multiverseId\': 216870}, \'multiverseid\': 216870}, {\'name\': \'Раздвоенная Молния\', \'text\': \'Раздвоенная Молния наносит 2 повреждения, разделенные по вашему выбору между одним или двумя целевыми существами и (или) игроками.\', \'type\': \'Волшебство\', \'flavor\': \'«Не выказывай благосклонность. Умрут все». — поговорка электромагов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215878&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4ca57b1f-d67f-4fac-aa6c-eb19e980ec30\', \'multiverseId\': 215878}, \'multiverseid\': 215878}, {\'name\': \'分叉雷击\', \'text\': \'分叉雷击对一个或两个目标生物和／或牌手造成共2点伤害，你可以任意分配。\', \'type\': \'法术\', \'flavor\': \'「别耍花招。 爱耍的都死了。」 ～火花法师谚语\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216126&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bd42d605-3dad-4acc-9c8f-baefb222b646\', \'multiverseId\': 216126}, \'multiverseid\': 216126}]', "[{'name': 'Geteilte Entdeckung', 'text': 'Tappe als zusätzliche Kosten, um Geteilte Entdeckung zu wirken, vier ungetappte Kreaturen, die du kontrollierst.\\nZiehe drei Karten.', 'type': 'Hexerei', 'flavor': 'Schätze müssen aufgeteilt werden, aber von richtigem Wohlstand kann man abgeben.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217488&type=card', 'language': 'German', 'identifiers': {'scryfallId': '84915655-ec78-49b1-b650-f3fc5159ac80', 'multiverseId': 217488}, 'multiverseid': 217488}, {'name': 'Descubrimiento compartido', 'text': 'Como coste adicional para lanzar el Descubrimiento compartido, gira cuatro criaturas enderezadas que controles.\\nRoba tres cartas.', 'type': 'Conjuro', 'flavor': 'Los tesoros deben ser divididos, pero la verdadera riqueza puede ser compartida.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217240&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3219f470-0fe4-47b4-bff4-e3be02a3db9d', 'multiverseId': 217240}, 'multiverseid': 217240}, {'name': 'Découverte partagée', 'text': 'En tant que coût supplémentaire pour lancer la Découverte partagée, engagez quatre créatures dégagées que vous contrôlez.\\nPiochez trois cartes.', 'type': 'Rituel', 'flavor': 'Les richesses doivent être divisées, mais seule la véritable fortune peut être partagée.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215752&type=card', 'language': 'French', 'identifiers': {'scryfallId': '51b92399-75a6-429d-ac98-fd01a4ad9b3c', 'multiverseId': 215752}, 'multiverseid': 215752}, {'name': 'Scoperta Condivisa', 'text': 'Come costo addizionale per lanciare la Scoperta Condivisa, TAPpa quattro creature STAPpate che controlli.\\nPesca tre carte.', 'type': 'Stregoneria', 'flavor': 'Le ricchezze devono essere divise, ma la vera opulenza può essere condivisa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216496&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '864b64a3-330b-4413-b66f-7805f459c62f', 'multiverseId': 216496}, 'multiverseid': 216496}, {'name': '分かち合う発見', 'text': '分かち合う発見を唱えるための追加コストとして、あなたがコントロールするアンタップ状態のクリーチャーを４体タップする。\\nカードを３枚引く。', 'type': 'ソーサリー', 'flavor': '富は分けなければいけないが、真の財産は分かち合える。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216744&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3adb026c-f2ad-4af0-a09f-2c8e8adf9141', 'multiverseId': 216744}, 'multiverseid': 216744}, {'name': 'Descoberta Compartilhada', 'text': 'Como custo adicional para conjurar Descoberta Compartilhada, vire quatro criaturas desviradas que você controla.\\nCompre três cards.', 'type': 'Feitiço', 'flavor': 'As riquezas podem ser divididas, mas a verdadeira fortuna pode ser compartilhada.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216992&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6e8c17c2-f5f1-4ed6-a0f6-95699c202fa0', 'multiverseId': 216992}, 'multiverseid': 216992}, {'name': 'Совместная Находка', 'text': 'В качестве дополнительной стоимости разыгрывания Совместной Находки поверните четыре неповернутых существа под вашим контролем.\\nВозьмите три карты.', 'type': 'Волшебство', 'flavor': 'Добыча должна быть поделена, но настоящим богатством можно пользоваться сообща.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216000&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f7467660-2585-413c-844d-97f082f0a725', 'multiverseId': 216000}, 'multiverseid': 216000}, {'name': '共享发现', 'text': '横置四个由你操控且未横置的生物，以作为施放共享发现的额外费用。\\n抓三张牌。', 'type': '法术', 'flavor': '金银必须分配，但真正的财富可以共享。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216248&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0fdb9566-6064-4142-bc35-520edf426127', 'multiverseId': 216248}, 'multiverseid': 216248}]", '[{\'name\': \'Gideon Jura\', \'text\': \'+2: Während des nächsten Zuges eines Gegners deiner Wahl greifen alle Kreaturen, die dieser Spieler kontrolliert, Gideon Jura an, falls möglich.\\n-2: Zerstöre eine getappte Kreatur deiner Wahl.\\n0: Bis zum Ende des Zuges wird Gideon Jura eine 6/6 (Mensch, Soldat)-Kreatur, die immer noch ein Planeswalker ist. Verhindere allen Schaden, der ihm in diesem Zug zugefügt würde.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217299&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'15b0394a-69b4-42df-914a-235c011008d6\', \'multiverseId\': 217299}, \'multiverseid\': 217299}, {\'name\': \'Gideon Jura\', \'text\': \'+2: Durante el próximo turno del oponente objetivo, las criaturas que controla ese jugador atacan a Gideon Jura si pueden.\\n-2: Destruye la criatura objetivo girada.\\n0: Hasta el final del turno, Gideon Jura es una criatura Soldado Humano 6/6 que sigue siendo un planeswalker. Prevén todo el daño que se le fuera a hacer a él este turno.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217051&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3b89fc84-f685-4a70-8c77-c4a018b285e5\', \'multiverseId\': 217051}, \'multiverseid\': 217051}, {\'name\': \'Gideon Jura\', \'text\': "+2 : Pendant le prochain tour de l\'adversaire ciblé, les créatures que ce joueur contrôle attaquent Gideon Jura si possible.\\n-2 : Détruisez la créature engagée ciblée.\\n0 : Jusqu\'à la fin du tour, Gideon Jura devient une créature 6/6 Humain et Soldat qui est toujours un planeswalker. Prévenez toutes les blessures qui devraient lui être infligées ce tour-ci.", \'type\': \'Planeswalker : Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215563&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea7a5394-703c-4ec2-ae63-bc47caa7acf5\', \'multiverseId\': 215563}, \'multiverseid\': 215563}, {\'name\': \'Gideon Jura\', \'text\': \'+2: Durante il prossimo turno di un avversario bersaglio, le creature controllate da quel giocatore attaccano Gideon Jura se possono farlo.\\n-2: Distruggi una creatura TAPpata bersaglio.\\n0: Fino alla fine del turno, Gideon Jura diventa una creatura Soldato Umano 6/6 che è ancora un planeswalker. Previeni tutto il danno che gli verrebbe inflitto in questo turno.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216307&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'03ce3f56-4e1d-47c9-a94a-053e6e9b097a\', \'multiverseId\': 216307}, \'multiverseid\': 216307}, {\'name\': \'ギデオン・ジュラ\', \'text\': \'+2: 対戦相手１人を対象とする。そのプレイヤーの次のターン中、そのプレイヤーがコントロールするクリーチャーは可能ならギデオン・ジュラを攻撃する。\\n-2: タップ状態のクリーチャー１体を対象とし、それを破壊する。\\n0: ターン終了時まで、ギデオン・ジュラは６/６の人間・兵士・クリーチャーになる。それはプレインズウォーカーでもある。 このターン、彼に与えられるすべてのダメージを軽減する。\', \'type\': \'プレインズウォーカー — ギデオン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216555&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5e6899a3-67cb-45e6-bc4a-cf7544cd8792\', \'multiverseId\': 216555}, \'multiverseid\': 216555}, {\'name\': \'Gideon Jura\', \'text\': \'+2: Durante o próximo turno do oponente alvo, as criaturas que aquele jogador controla atacam Gideon Jura se estiverem aptas.\\n-2: Destrua a criatura alvo virada.\\n0: Até o final do turno, Gideon Jura torna-se uma criatura 6/6 do tipo Humano Soldado que ainda é um planeswalker. Previna todo o dano que seria causado a ele neste turno.\', \'type\': \'Planeswalker — Gideon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216803&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cd89934f-92e3-4abd-a9dd-1fb711a68b67\', \'multiverseId\': 216803}, \'multiverseid\': 216803}, {\'name\': \'Гидеон Джура\', \'text\': \'+2: во время следующего хода целевого оппонента существа под контролем того игрока атакуют Гидеона Джуру, если могут.\\n-2: уничтожьте целевое повернутое существо.\\n0: до конца хода Гидеон Джура становится существом 6/6 Человек Солдат, которое остается planeswalker-ом. Предотвратите все повреждения, которые должны быть нанесены ему в этом ходу.\', \'type\': \'Planeswalker — Гидеон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215811&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7df02d65-0ebf-4c14-a9db-5382380f8de5\', \'multiverseId\': 215811}, \'multiverseid\': 215811}, {\'name\': \'基定尤拉\', \'text\': \'+2：于目标对手的下个回合中，由该牌手所操控的生物若能攻击基定尤拉，则必须攻击之。\\n-2：消灭目标已横置的生物。\\n0：直到回合结束，基定尤拉成为6/6的人类／士兵生物，且仍然是鹏洛客。 防止本回合中将对他造成的所有伤害。\', \'type\': \'鹏洛客～基定\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216059&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c5af7b8-5097-4801-96bb-a707e9ba5821\', \'multiverseId\': 216059}, \'multiverseid\': 216059}]', '[{\'name\': \'Gigantomagier\', \'text\': \'{1}: Eine Kreatur deiner Wahl, die du kontrollierst, wird bis zum Ende des Zuges 7/7.\', \'type\': \'Kreatur — Mensch, Schamane\', \'flavor\': \'„Alles Leben hat einen unzähmbaren Überlebenswillen. Ich mache daraus nur ... etwas Greifbareres."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217500&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0134fe65-9c2e-4c42-b756-b07f830f5aee\', \'multiverseId\': 217500}, \'multiverseid\': 217500}, {\'name\': \'Gigantomante\', \'text\': \'{1}: La criatura objetivo que controlas es 7/7 hasta el final del turno.\', \'type\': \'Criatura — Chamán humano\', \'flavor\': \'"Todo lo vivo tiene un deseo incontrolable de sobrevivir. Yo simplemente lo convierto en algo más... tangible."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217252&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2dfacd0-8777-4ddf-a6e2-3138cdb64402\', \'multiverseId\': 217252}, \'multiverseid\': 217252}, {\'name\': \'Gigantomancien\', \'text\': "{1} : La créature ciblée que vous contrôlez devient 7/7 jusqu\'à la fin du tour.", \'type\': \'Créature : humain et shamane\', \'flavor\': "« Toute vie est motivée par l\'indomptable volonté de survivre. Je la transforme simplement en quelque chose de plus . . . tangible. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215764&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e8810fdf-b39b-45b4-a06b-8cbf952fd0e5\', \'multiverseId\': 215764}, \'multiverseid\': 215764}, {\'name\': \'Gigantomante\', \'text\': \'{1}: Una creatura bersaglio che controlli diventa 7/7 fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Umano\', \'flavor\': \'"Tutte le forme di vita sono spinte da una volontà indomabile di sopravvivenza. Io semplicemente la trasformo in qualcosa di più. . . tangibile."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216508&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2315c098-47f6-4d83-9d6e-06607276312c\', \'multiverseId\': 216508}, \'multiverseid\': 216508}, {\'name\': \'巨術士\', \'text\': \'{1}：あなたがコントロールするクリーチャー１体を対象とする。それはターン終了時まで７/７になる。\', \'type\': \'クリーチャー — 人間・シャーマン\', \'flavor\': \'「全ての生命は、生き残りのための不屈の意思に動かされている。 私はそれをもう少しだけ……わかりやすくしているだけだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216756&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16b2711a-5200-490b-90cc-b7e77a7038b1\', \'multiverseId\': 216756}, \'multiverseid\': 216756}, {\'name\': \'Gigantomante\', \'text\': \'{1}: A criatura alvo que você controla se torna 7/7 até o final do turno.\', \'type\': \'Criatura — Humano Xamã\', \'flavor\': \'"Toda forma de vida é impulsionada por um indomável instinto de sobrevivência. Eu simplesmente transformo isso em algo mais... tangível."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217004&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'17ab0298-2fd3-4abf-b646-2b71309cac64\', \'multiverseId\': 217004}, \'multiverseid\': 217004}, {\'name\': \'Гигантомант\', \'text\': \'{1}: целевое существо под вашим контролем становится 7/7 до конца хода.\', \'type\': \'Существо — Человек Шаман\', \'flavor\': \'«Всем живым управляет непреодолимое стремление выжить. Я просто обращаю его в нечто более... конкретное».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216012&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6266847-fb2d-4a25-8e1c-e34cdf707386\', \'multiverseId\': 216012}, \'multiverseid\': 216012}, {\'name\': \'庞巨术士\', \'text\': \'{1}：目标由你操控的生物成为7/7直到回合结束。\', \'type\': \'生物～人类／祭师\', \'flavor\': \'「所有生命都由无可遏止的生存欲所驱动。 我只是把它转化得更加...具体。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216260&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b91d12e8-2d9b-436a-b678-4a9048bc638e\', \'multiverseId\': 216260}, \'multiverseid\': 216260}]', '[{\'name\': \'Goblin-Brandstifter\', \'text\': \'Wenn der Goblin-Brandstifter aus dem Spiel auf einen Friedhof gelegt wird, kannst du ihn einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zufügen lassen.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Mit großer Macht kommt auch das große Risiko, getötet zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217458&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7ffcc474-25c7-4f68-ab05-5f4427306287\', \'multiverseId\': 217458}, \'multiverseid\': 217458}, {\'name\': \'Calcinador trasgo\', \'text\': \'Cuando el Calcinador trasgo vaya a un cementerio desde el campo de batalla, puedes hacer que le haga 1 punto de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'Un gran poder conlleva un gran riesgo de hacer que te maten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217210&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c43f95aa-758f-484b-8c06-4ee283433f62\', \'multiverseId\': 217210}, \'multiverseid\': 217210}, {\'name\': \'Incendiaire gobelin\', \'text\': "Quand l\'Incendiaire gobelin est mis dans un cimetière depuis le champ de bataille, vous pouvez faire qu\'il inflige 1 blessure à une cible, créature ou joueur.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': \'Quiconque a un grand pouvoir court le risque de se faire tuer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215722&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8a0bd660-974c-4bcc-b9a7-8cd300c82649\', \'multiverseId\': 215722}, \'multiverseid\': 215722}, {\'name\': \'Goblin Inceneritore\', \'text\': \'Quando il Goblin Inceneritore viene messo in un cimitero dal campo di battaglia, puoi fargli infliggere 1 danno a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Con molto potere ci sono molti rischi di rimanere uccisi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216466&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4e7ac4e-e17b-4714-b025-9e7a286515d3\', \'multiverseId\': 216466}, \'multiverseid\': 216466}, {\'name\': \'ゴブリンの付け火屋\', \'text\': \'ゴブリンの付け火屋が戦場からいずれかの墓地に置かれたとき、クリーチャー１体かプレイヤー１人を対象とする。あなたは「ゴブリンの付け火屋はそれに１点のダメージを与える。」を選んでもよい。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'大きな力は、自分をも殺してしまうほどの大きな危険を伴う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216714&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'149d98f3-64eb-49d5-9e16-e953b3de2f91\', \'multiverseId\': 216714}, \'multiverseid\': 216714}, {\'name\': \'Pirômano Goblin\', \'text\': \'Quando Pirômano Goblin é colocado num cemitério vindo do campo de batalha, você pode fazer com que ele cause 1 ponto de dano à criatura ou ao jogador alvo.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'Um poder grandioso também traz consigo um grande risco de morte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216962&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c23fbf4-5f4c-4e4b-90b2-a473774822e6\', \'multiverseId\': 216962}, \'multiverseid\': 216962}, {\'name\': \'Гоблин-Воспламенитель\', \'text\': \'Когда Гоблин-Воспламенитель попадает с поля битвы на кладбище, вы можете заставить его нанести 1 повреждение целевому существу или игроку.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Чем больше власти, тем больше риск быть убитым.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215970&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'27f82cfa-fc00-45a1-a5f8-ba2a47f018cd\', \'multiverseId\': 215970}, \'multiverseid\': 215970}, {\'name\': \'纵火鬼怪\', \'text\': \'当纵火鬼怪从战场进入坟墓场时，你可以让它对目标生物或牌手造成1点伤害。\', \'type\': \'生物～鬼怪／祭师\', \'flavor\': \'能力越强，丧命的危险越大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216218&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'55287d88-661e-46c7-8cbc-81458eab08fd\', \'multiverseId\': 216218}, \'multiverseid\': 216218}]', '[{\'name\': \'Goblin-Tunnelgräber\', \'text\': \'{T}: Eine Kreatur deiner Wahl mit Stärke 2 oder weniger ist in diesem Zug unblockbar.\', \'type\': \'Kreatur — Goblin, Räuber\', \'flavor\': \'„Man kann nie wissen, was man in Goblingängen findet. Selbst im besten Fall sind dort immer noch Goblins." —Sachir aus Akoums Expeditionsgildenhaus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217309&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5c335d2f-b784-471e-8336-ac2167ac03fa\', \'multiverseId\': 217309}, \'multiverseid\': 217309}, {\'name\': \'Trasgo excavador de túneles\', \'text\': \'{T}: La criatura objetivo con fuerza de 2 o menos es imbloqueable este turno.\', \'type\': \'Criatura — Bribón trasgo\', \'flavor\': \'"Nunca sabes qué sucederá en los túneles de trasgos. Y en el mejor de los casos, todavía habrá trasgos." —Sachir, Casa expedicionaria de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217061&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'581d1dfd-0c68-4c71-80aa-866da2208c81\', \'multiverseId\': 217061}, \'multiverseid\': 217061}, {\'name\': \'Tunnelier gobelin\', \'text\': \'{T} : La créature ciblée de force inférieure ou égale à 2 est imblocable ce tour-ci.\', \'type\': \'Créature : gobelin et gredin\', \'flavor\': "« On ne sait jamais ce qu\'on risque de trouver dans les tunnels gobelins. Même dans le meilleur des cas, il y restera toujours des gobelins. » —Sachir, corps expéditionnaire d\'Akoum", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215573&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'142f2268-6501-4a7b-ad78-fe6a3ea6ff42\', \'multiverseId\': 215573}, \'multiverseid\': 215573}, {\'name\': \'Scavatore Goblin\', \'text\': \'{T}: Una creatura bersaglio con forza pari o inferiore a 2 non può essere bloccata in questo turno.\', \'type\': \'Creatura — Farabutto Goblin\', \'flavor\': \'"Non sai mai cosa troverai nei tunnel dei goblin. Anche nella migliore delle ipotesi, ci troverai pur sempre dei goblin." —Sachir, Casa di Spedizioni di Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216317&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e2795adc-90be-416e-9932-35d37047fc18\', \'multiverseId\': 216317}, \'multiverseid\': 216317}, {\'name\': \'ゴブリンのトンネル掘り\', \'text\': \'{T}：パワーが２以下のクリーチャー１体を対象とする。このターン、それはブロックされない。\', \'type\': \'クリーチャー — ゴブリン・ならず者\', \'flavor\': \'「ゴブリンの掘ったトンネルに何があるか、想像もつかないと思いますよ。 一番まともな状況でも、ゴブリンがごろごろしてますから。」 ――アクーム探検協会のサチャー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216565&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd5af518-217c-4702-97bf-7df8a44337aa\', \'multiverseId\': 216565}, \'multiverseid\': 216565}, {\'name\': \'Cavador de Túneis Goblin\', \'text\': \'{T}: A criatura alvo com poder menor ou igual a 2 não pode ser bloqueada neste turno.\', \'type\': \'Criatura — Goblin Ladino\', \'flavor\': \'"Você nunca sabe o que vai encontrar nos túneis dos goblins. Mesmo na melhor das hipóteses, você ainda encontrará goblins." — Sachir, Casa Expedicionária de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e506d042-53cd-495c-bbf5-c2449863aeaf\', \'multiverseId\': 216813}, \'multiverseid\': 216813}, {\'name\': \'Гоблин-Проходчик\', \'text\': \'{T}: целевое существо с силой 2 или меньше не может быть заблокировано в этом ходу.\', \'type\': \'Существо — Гоблин Бродяга\', \'flavor\': \'«Откуда знать, что может встретиться в гоблинских туннелях. Даже в лучшем случае там все равно будут гоблины». — Сачир из акумского экспедиционного дома\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215821&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'22b26508-c60c-4893-b1a1-56659c6485ab\', \'multiverseId\': 215821}, \'multiverseid\': 215821}, {\'name\': \'穿隧鬼怪\', \'text\': \'{T}：目标力量等于或小于2的生物本回合不能被阻挡。\', \'type\': \'生物～鬼怪／浪客\', \'flavor\': \'「你永远料不到鬼怪隧道里面会有些什么东西。 就算在最好的情况下，里面也会有鬼怪。」 ～阿库姆探险队的莎琦儿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216069&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dfe47f44-45e9-4fbc-b6c2-ee7c921066d1\', \'multiverseId\': 216069}, \'multiverseid\': 216069}]', "[{'name': 'Gomazoa-Wachposten', 'text': 'Verteidiger, Fliegend\\nVerhindere allen Kampfschaden, der dem Gomazoa-Wachposten zugefügt würde.', 'type': 'Kreatur — Qualle', 'flavor': 'Er hält sich in der Nähe der Makindi-Gräben auf und sorgt damit unfreiwillig für eine weitere Schutzschicht.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217423&type=card', 'language': 'German', 'identifiers': {'scryfallId': '56b06901-ca9f-4282-aa5c-caa3b75dd981', 'multiverseId': 217423}, 'multiverseid': 217423}, {'name': 'Gomazoa guardiana', 'text': 'Defensor, vuela.\\nPrevén todo el daño de combate que se le fuera a hacer a la Gomazoa guardiana.', 'type': 'Criatura — Medusa', 'flavor': 'Acecha cerca de los destacamentos de las Trincheras Makindi, añadiendo sin querer otra línea de defensa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217175&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1c6837d3-57ed-4688-be54-ad78d28a310c', 'multiverseId': 217175}, 'multiverseid': 217175}, {'name': 'Garde gomazoaire', 'text': 'Défenseur, volPrévenez toutes les blessures de combat qui devraient être infligées au Garde gomazoaire.', 'type': 'Créature : méduse', 'flavor': 'Il rôde près des avant-postes des Fosses de Makindi, leur donnant par inadvertance un système de défense supplémentaire.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215687&type=card', 'language': 'French', 'identifiers': {'scryfallId': '88856dad-3543-42ed-8c6f-11b6788967f4', 'multiverseId': 215687}, 'multiverseid': 215687}, {'name': 'Gomazoa di Guardia', 'text': 'Difensore, volare\\nPrevieni tutto il danno da combattimento che verrebbe inflitto alla Gomazoa di Guardia.', 'type': 'Creatura — Medusa', 'flavor': 'Si sofferma vicino agli avamposti delle Fosse di Makindi, garantendo suo malgrado un ulteriore livello di difese.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216431&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '85e58044-d8d6-4813-9e46-2540476ce08e', 'multiverseId': 216431}, 'multiverseid': 216431}, {'name': '護衛のゴーマゾア', 'text': '防衛、飛行\\n護衛のゴーマゾアに与えられるすべての戦闘ダメージを軽減する。', 'type': 'クリーチャー — クラゲ', 'flavor': 'それはマキンディ溝の前哨地の近くに居座り、偶然にも追加の防衛線となっている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216679&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '4a37b96e-64b6-419f-98d4-7abfeaa6a5f3', 'multiverseId': 216679}, 'multiverseid': 216679}, {'name': 'Gomazoa de Guarda', 'text': 'Defensor, voar\\nPrevina todo o dano de combate que seria causado a Gomazoa de Guarda.', 'type': 'Criatura — Água-viva', 'flavor': 'Ela vagueia pelos postos avançados das Trincheiras de Makindi, involuntariamente fornecendo um nível a mais de defesa.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216927&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '09d82652-b7ea-4b9d-b4d7-9bf90e51969d', 'multiverseId': 216927}, 'multiverseid': 216927}, {'name': 'Сторожевой Гомазоа', 'text': 'Защитник, Полет\\nПредотвратите все боевые повреждения, которые должны быть нанесены Сторожевому Гомазоа.', 'type': 'Существо — Медуза', 'flavor': 'Он обитает неподалеку от застав у Разломов Макинди, совершенно непреднамеренно обеспечивая дополнительную линию обороны.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215935&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5ca9629a-bdb1-4ee6-a4b6-fc9ee3b31b3c', 'multiverseId': 215935}, 'multiverseid': 215935}, {'name': '卫士格玛佐雅', 'text': '守军，飞行\\n防止将对卫士格玛佐雅造成之所有战斗伤害。', 'type': '生物～水母', 'flavor': '它在马钦迪战壕附近的哨站徘徊不去，无意间形成了另一道防线。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216183&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '958c83dc-22c3-4eb0-8d16-dce6c8d10a98', 'multiverseId': 216183}, 'multiverseid': 216183}]", "[{'name': 'Gravitationsänderung', 'text': 'Fliegende Kreaturen erhalten +2/+0.\\nNichtfliegende Kreaturen erhalten -2/-0.', 'type': 'Verzauberung', 'flavor': 'Als sie erwachten, machten die Eldrazi ihre Kontrolle über alle Naturkräfte Zendikars wieder geltend.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217329&type=card', 'language': 'German', 'identifiers': {'scryfallId': '980cdff9-5033-4994-a83f-99654f46ad2c', 'multiverseId': 217329}, 'multiverseid': 217329}, {'name': 'Cambio gravitacional', 'text': 'Las criaturas con la habilidad de volar obtienen +2/+0.\\nLas criaturas sin la habilidad de volar obtienen -2/-0.', 'type': 'Encantamiento', 'flavor': 'Al despertar, los Eldrazi retomaron su control sobre todas las fuerzas naturales de Zendikar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217081&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8a12a72f-c3dd-447e-ad7c-3707eb0b9508', 'multiverseId': 217081}, 'multiverseid': 217081}, {'name': 'Bouleversement gravitationnel', 'text': 'Les créatures avec le vol gagnent +2/+0.\\nLes créatures sans le vol gagnent -2/-0.', 'type': 'Enchantement', 'flavor': 'Dès leur réveil, les Eldrazi réaffirmèrent le contrôle des forces naturelles de Zendikar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215593&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b2dc520e-31f8-4920-86a5-67687fd537e6', 'multiverseId': 215593}, 'multiverseid': 215593}, {'name': 'Scarto Gravitazionale', 'text': 'Le creature con volare prendono +2/+0.\\nLe creature senza volare prendono -2/-0.', 'type': 'Incantesimo', 'flavor': 'Man mano che si risvegliavano, gli Eldrazi ristabilirono il loro potere su tutte le forze naturali di Zendikar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216337&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a1e31518-5cd5-466c-a169-d23f9a82fdea', 'multiverseId': 216337}, 'multiverseid': 216337}, {'name': '重力の変容', 'text': '飛行を持つクリーチャーは＋２/＋０の修整を受ける。\\n飛行を持たないクリーチャーは－２/－０の修整を受ける。', 'type': 'エンチャント', 'flavor': 'エルドラージは目覚めると、ゼンディカーの自然の勢力全てに対して己の支配を再び知らしめようとした。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216585&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e1108c86-d44f-4bac-92e8-4cbdfffe11e3', 'multiverseId': 216585}, 'multiverseid': 216585}, {'name': 'Desvio Gravitacional', 'text': 'As criaturas com voar recebem +2/+0.\\nAs criaturas sem voar recebem -2/-0.', 'type': 'Encantamento', 'flavor': 'Conforme despertaram, os Eldrazi reafirmaram seu domínio sobre todas as forças naturais de Zendikar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216833&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd70eb23f-4c2f-4467-91fe-41a183ca415d', 'multiverseId': 216833}, 'multiverseid': 216833}, {'name': 'Гравитационное Смещение', 'text': 'Существа с Полетом получают +2/+0.\\nСущества без Полета получают -2/-0.', 'type': 'Чары', 'flavor': 'После пробуждения Эльдрази восстановили свое господство над силами природы по всему Зендикару.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215841&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '72bfdbc3-8ba7-4b30-bebf-681b8bb4e5b2', 'multiverseId': 215841}, 'multiverseid': 215841}, {'name': '引力翻转', 'text': '具飞行异能的生物得+2/+0。\\n不具飞行异能的生物得-2/-0。', 'type': '结界', 'flavor': '随着奥札奇醒转，他们再次对所有赞迪卡自然势力宣扬自己的主权。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216089&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7d0add0e-8f99-4d0c-b549-39f96dbc2c64', 'multiverseId': 216089}, 'multiverseid': 216089}]", '[{\'name\': \'Grotag-Belagerungsstürmer\', \'text\': \'{R}, opfere den Grotag-Belagerungsstürmer: Zerstöre eine Kreatur deiner Wahl mit Verteidiger. Der Grotag-Belagerungsstürmer fügt dem Beherrscher dieser Kreatur 2 Schadenspunkte zu.\', \'type\': \'Kreatur — Goblin, Räuber\', \'flavor\': \'„Ich glaube nicht, dass er die Post bringt..." —Nundari, Hauptmann der Miliz von Seetor\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217355&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39b4dc00-3c3f-42a3-9572-eeeb9c24915c\', \'multiverseId\': 217355}, \'multiverseid\': 217355}, {\'name\': \'Mensajero de asedio grotag\', \'text\': \'{R}, sacrificar el Mensajero de asedio grotag: Destruye la criatura objetivo con la habilidad de defensor. El Mensajero de asedio grotag hace 2 puntos de daño al controlador de esa criatura.\', \'type\': \'Criatura — Bribón trasgo\', \'flavor\': \'"No creo que esté trayendo el correo..." —Nundari, capitán de la milicia de Portal Marino\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217107&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bbee025e-226d-445d-9e3f-4118d3253b5a\', \'multiverseId\': 217107}, \'multiverseid\': 217107}, {\'name\': \'Coureur de siège grotag\', \'text\': \'{R}, sacrifiez le Coureur de siège grotag : Détruisez la créature ciblée avec le défenseur. Le Coureur de siège grotag inflige 2 blessures au contrôleur de cette créature.\', \'type\': \'Créature : gobelin et gredin\', \'flavor\': "« Je ne pense pas qu\'il vienne livrer le courrier.... » —Nundari, capitaine de la milice de Porte des Mers", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215619&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb7d24f7-3f88-42c5-926f-1e62e1c64350\', \'multiverseId\': 215619}, \'multiverseid\': 215619}, {\'name\': \'Messaggero Grotag\', \'text\': \'{R}, Sacrifica il Messaggero Grotag: Distruggi una creatura con difensore bersaglio. Il Messaggero Grotag infligge 2 danni al controllore di quella creatura.\', \'type\': \'Creatura — Farabutto Goblin\', \'flavor\': \'"Non credo stia portando dentro la posta. . . ." —Nundari, capitano di milizia di Portale Marino\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216363&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77f96e45-b09d-4f39-b10f-7012bea6123b\', \'multiverseId\': 216363}, \'multiverseid\': 216363}, {\'name\': \'グロータグの包囲抜け\', \'text\': \'{R}, グロータグの包囲抜けを生け贄に捧げる：防衛を持つクリーチャー１体を対象とし、それを破壊する。 グロータグの包囲抜けはそのクリーチャーのコントローラーに２点のダメージを与える。\', \'type\': \'クリーチャー — ゴブリン・ならず者\', \'flavor\': \'「手紙を持ってきたようには見えねえな……」 ――海の門の民兵隊長、ナンダーリ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216611&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10e5b12e-aec5-4568-a62f-394979b4e87b\', \'multiverseId\': 216611}, \'multiverseid\': 216611}, {\'name\': \'Mensageiro de Cerco Grotag\', \'text\': \'{R}, Sacrifique Mensageiro de Cerco Grotag: Destrua a criatura alvo com defensor. Mensageiro de Cerco Grotag causa 2 pontos de dano ao controlador daquela criatura.\', \'type\': \'Criatura — Goblin Ladino\', \'flavor\': \'"Não me parece que ele esteja trazendo a correspondência..." — Nundari, Capitão da milícia do Portão Marinho\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216859&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0492272e-2015-4d42-b73e-bc9536b9e504\', \'multiverseId\': 216859}, \'multiverseid\': 216859}, {\'name\': \'Посыльный Осаждающих Гротагцев\', \'text\': \'{R}, пожертвуйте Посыльного Осаждающих Гротагцев: уничтожьте целевое существо со способностью Защитника. Посыльный Осаждающих Гротагцев наносит 2 повреждения игроку, контролирующему то существо.\', \'type\': \'Существо — Гоблин Бродяга\', \'flavor\': \'«По-моему, он несет нам не почту...» — Нундари, капитан мореградского ополчения\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215867&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'203fb7a7-c93c-4ab9-89a9-80d924498b11\', \'multiverseId\': 215867}, \'multiverseid\': 215867}, {\'name\': \'葛塔攻城亡命徒\', \'text\': \'{R}，牺牲葛塔攻城亡命徒：消灭目标具守军异能的生物。 葛塔攻城亡命徒对该生物的操控者造成2点伤害。\', \'type\': \'生物～鬼怪／浪客\', \'flavor\': \'「我不觉得他是来送信的...。」 ～海户义勇军队长努达力\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216115&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6973626c-61d7-4cf7-9804-eeaf9233b7d9\', \'multiverseId\': 216115}, \'multiverseid\': 216115}]', '[{\'name\': \'Harmloser Ansturm\', \'text\': \'Verhindere allen Kampfschaden, der in diesem Zug von angreifenden Kreaturen zugefügt würde.\', \'type\': \'Spontanzauber\', \'flavor\': \'Nachdem er einen Eldrazi in einem lähmenden Lichtstrahl eingehüllt hatte, studierte der Engel das Wesen, wie ein Kind einen Käfer betrachtet: neugierig und furchtlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217493&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dfae09e4-afca-4a19-ac71-481e3104e8d2\', \'multiverseId\': 217493}, \'multiverseid\': 217493}, {\'name\': \'Asalto inofensivo\', \'text\': \'Prevén todo el daño de combate que fueran a hacer este turno las criaturas atacantes.\', \'type\': \'Instantáneo\', \'flavor\': \'Después de encerrarlo en un haz de luz paralizante, el ángel estudió al eldrazi como un niño estudiaría a un insecto, con curiosidad y sin miedo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217245&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e64e27db-864a-4e2e-b67b-f95566f5273e\', \'multiverseId\': 217245}, \'multiverseid\': 217245}, {\'name\': \'Assaut inoffensif\', \'text\': \'Prévenez toutes les blessures de combat qui devraient être infligées ce tour-ci par des créatures attaquantes.\', \'type\': \'Éphémère\', \'flavor\': "Après l\'avoir emprisonné dans un rayon de lumière paralysant, l\'ange étudia l\'Eldrazi comme un enfant contemple un insecte, avec curiosité et sans crainte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215757&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ee4bd1d3-0ab9-4978-962b-15ee34e7a755\', \'multiverseId\': 215757}, \'multiverseid\': 215757}, {\'name\': \'Assalto Inoffensivo\', \'text\': \'Previeni tutto il danno da combattimento che verrebbe inflitto in questo turno dalle creature attaccanti.\', \'type\': \'Istantaneo\', \'flavor\': "Dopo averlo avvolto in un raggio di luce paralizzante, l\'angelo studiò l\'Eldrazi come un bambino osserverebbe un insetto, con curiosità ma senza alcuna paura.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216501&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9c25fb1c-a014-41b8-bc6b-29e81bb304fc\', \'multiverseId\': 216501}, \'multiverseid\': 216501}, {\'name\': \'無害な突撃\', \'text\': \'このターン、攻撃クリーチャーが与えるすべての戦闘ダメージを軽減する。\', \'type\': \'インスタント\', \'flavor\': \'麻痺の光の中に閉じ込めた後、天使はまるで子供が虫を研究するように、興味深くかつ恐れを知らずにエルドラージを観察し始めた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216749&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3063051f-1663-4105-9703-c4eaa2deba97\', \'multiverseId\': 216749}, \'multiverseid\': 216749}, {\'name\': \'Ataque Inofensivo\', \'text\': \'Previna todo o dano de combate que seria causado neste turno por criaturas atacantes.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Após envolvê-lo num raio de luz paralisante, o anjo estudou o Eldrazi como uma criança estuda um inseto, com curiosidade e sem medo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216997&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8a612b3-1ec7-4b10-9477-90ec3d4cdf13\', \'multiverseId\': 216997}, \'multiverseid\': 216997}, {\'name\': \'Безобидное Нападение\', \'text\': \'Предотвратите все боевые повреждения, которые должны быть нанесены в этом ходу атакующими существами.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Заключив Эльдрази в парализующий поток света, ангел рассматривал его, словно ребенок букашку, с любопытством и без страха.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216005&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b2f7425-005b-4ca9-b791-5fba2e498992\', \'multiverseId\': 216005}, \'multiverseid\': 216005}, {\'name\': \'无伤突袭\', \'text\': \'于本回合中，防止进行攻击的生物将造成的所有战斗伤害。\', \'type\': \'瞬间\', \'flavor\': \'天使利用麻痹光束将这奥札奇捕获后，有如孩童般不含惧意地好奇端详着它。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216253&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5f281c75-bc38-46aa-ab7b-1b152f9c4ec4\', \'multiverseId\': 216253}, \'multiverseid\': 216253}]', '[{\'name\': \'Hitzestrahl\', \'text\': \'Der Hitzestrahl fügt einer Kreatur deiner Wahl X Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das war eindeutig ein Schrei. Ich bin mir nur nicht sicher, ob auch ein Mund dazugehörte." —Sachir aus Akoums Expeditionsgildenhaus\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217449&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'59aa5f9e-f44a-4585-b7a3-19ddb2fd7f21\', \'multiverseId\': 217449}, \'multiverseid\': 217449}, {\'name\': \'Rayo de calor\', \'text\': \'El Rayo de calor hace X puntos de daño a la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Estoy seguro de que hubo un grito. Lo que no puedo asegurar es que hubiera una boca." —Sachir, Casa expedicionaria de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217201&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71a32553-e2f4-422a-81ad-9d46b9f3516b\', \'multiverseId\': 217201}, \'multiverseid\': 217201}, {\'name\': \'Rayon de chaleur\', \'text\': \'Le Rayon de chaleur inflige X blessures à la créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« J\'ai clairement entendu un cri. Mais je ne suis pas sûr d\'avoir vu une bouche. » —Sachir, corps expéditionnaire d\'Akoum", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215713&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9c4b0892-21e3-41ac-a93c-569861c7629e\', \'multiverseId\': 215713}, \'multiverseid\': 215713}, {\'name\': \'Raggio di Calore\', \'text\': \'Il Raggio di Calore infligge X danni a una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"C\\\'è sicuramente stato un urlo. Non sono sicura ci fosse anche una bocca." —Sachir, Casa di Spedizioni di Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216457&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'626bb187-0952-43e2-9105-e8e9c3907cf4\', \'multiverseId\': 216457}, \'multiverseid\': 216457}, {\'name\': \'熱光線\', \'text\': \'クリーチャー１体を対象とする。熱光線はそれにＸ点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'「確かにあれは叫び声です。 ただ、口があったかどうかはわかりませんね。」 ――アクーム探検協会のサチャー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216705&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bda0bf5d-de35-492a-b681-b0e804e1e782\', \'multiverseId\': 216705}, \'multiverseid\': 216705}, {\'name\': \'Raio de Calor\', \'text\': \'Raio de Calor causa X pontos de dano à criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Com certeza houve um grito. Mas não estou certo de que havia uma boca." — Sachir, Casa Expedicionária de Akoum\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216953&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6237850-880f-4bfa-a89d-264d4ad41e7e\', \'multiverseId\': 216953}, \'multiverseid\': 216953}, {\'name\': \'Луч Жара\', \'text\': \'Луч Жара наносит X повреждений целевому существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Крик точно был. А вот рта, может, и не было». — Сачир из акумского экспедиционного дома\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215961&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'09aa2279-93ae-49bb-a3f1-e0ecfd3fbe09\', \'multiverseId\': 215961}, \'multiverseid\': 215961}, {\'name\': \'热射线\', \'text\': \'热射线对目标生物造成X点伤害。\', \'type\': \'瞬间\', \'flavor\': \'「先前确实听到尖叫声。 但我不确定哪边是嘴。」 ～阿库姆探险队的莎琦儿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216209&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b9c5c56f-9bf0-481c-988f-d34dd41727ff\', \'multiverseId\': 216209}, \'multiverseid\': 216209}]', '[{\'name\': \'Höllenformender Dämon\', \'text\': \'Fliegend\\nImmer wenn der Höllenformende Dämon einem Spieler Kampfschaden zufügt, opfere alle anderen bleibenden Karten, die du kontrollierst, und wirf alle Karten aus deiner Hand ab. Schicke die obersten sechs Karten deiner Bibliothek ins Exil. Du kannst eine beliebige Anzahl der Karten, die auf diese Weise ins Exil geschickt wurden und die kein Land sind, wirken, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Kreatur — Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217453&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0a5b89cc-aaa5-4a2a-b8da-5a6baf065fa3\', \'multiverseId\': 217453}, \'multiverseid\': 217453}, {\'name\': \'Demonio tallador infernal\', \'text\': \'Vuela.\\nSiempre que el Demonio tallador infernal haga daño de combate a un jugador, sacrifica todos los otros permanentes que controlas y descarta tu mano. Exilia las primeras seis cartas de tu biblioteca. Puedes lanzar cualquier cantidad de cartas que no sean tierra exiliadas de esta manera sin pagar sus costes de maná.\', \'type\': \'Criatura — Demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217205&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bea00956-c2a2-486c-81a1-6f301ecb4635\', \'multiverseId\': 217205}, \'multiverseid\': 217205}, {\'name\': \'Démon sculptenfer\', \'text\': "Vol\\nÀ chaque fois que le Démon sculptenfer inflige des blessures de combat à un joueur, sacrifiez tous les autres permanents que vous contrôlez et défaussez-vous de votre main. Exilez les six cartes du dessus de votre bibliothèque. Vous pouvez lancer n\'importe quel nombre de cartes non-terrain exilées de cette manière sans payer leurs coûts de mana.", \'type\': \'Créature : démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215717&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bdd2c40b-63dd-40ab-aebf-949458a6ed7d\', \'multiverseId\': 215717}, \'multiverseid\': 215717}, {\'name\': \'Demone Tagliainferno\', \'text\': \'Volare\\nOgniqualvolta il Demone Tagliainferno infligge danno da combattimento a un giocatore, sacrifica tutti gli altri permanenti che controlli e scarta la tua mano. Esilia le prime sei carte del tuo grimorio. Puoi lanciare un qualsiasi numero di carte non terra esiliate in questo modo senza pagare i loro costi di mana.\', \'type\': \'Creatura — Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216461&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1d795746-7a61-427a-a905-df82c9c0a9f5\', \'multiverseId\': 216461}, \'multiverseid\': 216461}, {\'name\': \'地獄彫りの悪魔\', \'text\': \'飛行\\n地獄彫りの悪魔がいずれかのプレイヤーに戦闘ダメージを与えるたび、あなたがコントロールする他の全てのパーマネントを生け贄に捧げ、あなたの手札を捨てる。 あなたのライブラリーの一番上から６枚のカードを追放する。 あなたはこれにより追放された土地でないカードを、望む枚数それらのマナ・コストを支払うことなく唱えてもよい。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216709&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d6c04c4d-e64f-4fbb-86a1-6967686f586d\', \'multiverseId\': 216709}, \'multiverseid\': 216709}, {\'name\': \'Demônio Escultor do Inferno\', \'text\': \'Voar\\nToda vez que Demônio Escultor do Inferno causar dano de combate a um jogador, sacrifique todas as outras permanentes que você controla e descarte a sua mão. Exile os seis primeiros cards do topo de seu grimório. Você pode conjurar um número qualquer de cards que não sejam terrenos exilados dessa maneira sem pagar seus custos de mana.\', \'type\': \'Criatura — Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216957&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c84fa60f-e028-43af-98d2-ec26fd6a5ba2\', \'multiverseId\': 216957}, \'multiverseid\': 216957}, {\'name\': \'Демон, Реставратор Ада\', \'text\': \'Полет\\nКаждый раз когда Демон, Реставратор Ада наносит боевые повреждения игроку, пожертвуйте все другие перманенты под вашим контролем и сбросьте вашу руку. Изгоните шесть верхних карт вашей библиотеки. Вы можете разыграть любое количество не являющихся землями карт, изгнанных таким образом, без уплаты их мана-стоимости.\', \'type\': \'Существо — Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215965&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2a28bc87-2b60-4dbe-8956-a6b285dc1bf3\', \'multiverseId\': 215965}, \'multiverseid\': 215965}, {\'name\': \'狱雕恶魔\', \'text\': \'飞行\\n每当狱雕恶魔对牌手造成战斗伤害时，牺牲所有由你操控的其他永久物并弃掉你的手牌。 放逐你牌库顶的六张牌。 你可以施放任意数量以此法放逐的非地牌，且不需支付其法术力费用。\', \'type\': \'生物～恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216213&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7630c89d-2964-4c14-a915-3c9e2d4705c9\', \'multiverseId\': 216213}, \'multiverseid\': 216213}]', '[{\'name\': \'In Flammen einhüllen\', \'text\': \'In Flammen einhüllen fügt bis zu drei Kreaturen deiner Wahl je 1 Schadenspunkt zu. Diese Kreaturen können in diesem Zug nicht blocken.\', \'type\': \'Hexerei\', \'flavor\': \'„Die Flammen unserer Pyromagier konnten sie nicht töten, gaben uns aber dringend benötigte Zeit." —Die Kriegstagebücher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217400&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75b510e7-bc20-430b-912f-c0459b2432e8\', \'multiverseId\': 217400}, \'multiverseid\': 217400}, {\'name\': \'Envolver en llamas\', \'text\': \'Envolver en llamas hace 1 punto de daño a cada una de hasta tres criaturas objetivo. Esas criaturas no pueden bloquear este turno.\', \'type\': \'Conjuro\', \'flavor\': \'"Las llamas de nuestros piromantes pueden no haberlo matado, pero nos dieron el tiempo que necesitábamos." —Los diarios de guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217152&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fc40cd41-3b42-4194-a2fa-0f19396da59f\', \'multiverseId\': 217152}, \'multiverseid\': 217152}, {\'name\': \'Enveloppe de flammes\', \'text\': "L\'Enveloppe de flammes cible jusqu\'à trois créatures et leur inflige à chacune 1 blessure. Ces créatures ne peuvent pas bloquer ce tour-ci.", \'type\': \'Rituel\', \'flavor\': \'« Les flammes de notre pyromancien ne les ont peut-être pas tués, mais elles nous ont permis de gagner un temps précieux. » —Les journaux de la Guerre\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215664&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9aa5b4d2-b691-431f-a22d-ddfe58d295fe\', \'multiverseId\': 215664}, \'multiverseid\': 215664}, {\'name\': \'Avvolgere di Fiamme\', \'text\': \'Scegli fino a tre creature bersaglio. Avvolgere di Fiamme infligge 1 danno a ognuna di esse. Quelle creature non possono bloccare in questo turno.\', \'type\': \'Stregoneria\', \'flavor\': \'"Le fiamme del nostro piromante forse non li hanno uccisi, ma ci hanno fornito il tempo necessario." —I Diari di Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216408&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d09b1084-77f3-489a-8e38-783c67492f32\', \'multiverseId\': 216408}, \'multiverseid\': 216408}, {\'name\': \'炎の覆い\', \'text\': \'クリーチャーを最大３体まで対象とする。炎の覆いはそれらに、それぞれ１点のダメージを与える。 このターン、それらではブロックできない。\', \'type\': \'ソーサリー\', \'flavor\': \'「我々の紅蓮術士では奴らを殺せはしないが、必要なだけの時間は稼いでくれる。」 ――「戦争日誌」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216656&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6441a7be-19c2-4ed5-b350-4e01a5add07a\', \'multiverseId\': 216656}, \'multiverseid\': 216656}, {\'name\': \'Envolver em Chamas\', \'text\': \'Envolver em Chamas causa 1 ponto de dano a cada uma de até três criaturas alvo. Essas criaturas não podem bloquear neste turno.\', \'type\': \'Feitiço\', \'flavor\': \'"As chamas de nossos piromantes podem não ter os matado, mas nos deram o tempo de que precisávamos." — Os Diários da Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216904&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'52e02384-21de-4b33-a770-ce0a44c9fb2b\', \'multiverseId\': 216904}, \'multiverseid\': 216904}, {\'name\': \'Окутать Пламенем\', \'text\': \'Окутать Пламенем наносит 1 повреждение каждому из не более трех целевых существ. Те существа не могут блокировать в этом ходу.\', \'type\': \'Волшебство\', \'flavor\': \'«Языки пламени, выпущенные нашим пиромантом, может быть и не убили их, но дали нам немного драгоценного времени». —Дневники войны\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215912&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'774cd1eb-0a1a-4b5e-aa48-43b8d142a29a\', \'multiverseId\': 215912}, \'multiverseid\': 215912}, {\'name\': \'火焰包覆\', \'text\': \'火焰包覆对至多三个目标生物各造成1点伤害。 这些生物本回合不能进行阻挡。\', \'type\': \'法术\', \'flavor\': \'「我军烈焰术士的火焰也许不足以杀掉他们，但足以为我们争取时间。」 ～《战场札记》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216160&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4d67c037-38b9-40f5-992b-da6ae8062d8c\', \'multiverseId\': 216160}, \'multiverseid\': 216160}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217531&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c4a87ee2-f8a5-4945-8b1f-b919d38199c8', 'multiverseId': 217531}, 'multiverseid': 217531}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217283&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2f7fa4d0-0b78-48c9-9bfa-3ea4d5a3f407', 'multiverseId': 217283}, 'multiverseid': 217283}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215795&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e4ce7517-9fed-4fdd-9a16-d317a0b2f92b', 'multiverseId': 215795}, 'multiverseid': 215795}, {'name': 'Isola', 'text': '{U}', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216539&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '84f71e47-7ca4-42f1-a92d-aa62b8f1a4ec', 'multiverseId': 216539}, 'multiverseid': 216539}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216787&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '90af6f1f-0a00-4292-9b17-6291203dd277', 'multiverseId': 216787}, 'multiverseid': 216787}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217035&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '07725a07-af37-4225-b0b0-eae0a3cdd7ec', 'multiverseId': 217035}, 'multiverseid': 217035}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216043&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7da59a91-a50f-4eee-9971-67e999044bc3', 'multiverseId': 216043}, 'multiverseid': 216043}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216291&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7d897884-7339-4284-8430-b1aa269fedfe', 'multiverseId': 216291}, 'multiverseid': 216291}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217537&type=card', 'language': 'German', 'identifiers': {'scryfallId': '82262c70-c8f0-407b-ad50-84f58659d555', 'multiverseId': 217537}, 'multiverseid': 217537}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217289&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '19f442db-7cdd-421d-b56b-f048e31e81f8', 'multiverseId': 217289}, 'multiverseid': 217289}, {'name': 'Île', 'type': 'Terrain de base 