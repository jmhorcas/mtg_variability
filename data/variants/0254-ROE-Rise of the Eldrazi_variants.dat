il)', 'identifiers': {'scryfallId': '91bd55c1-ddaa-4756-afa9-a3eb93709b3e', 'multiverseId': 217043}, 'multiverseid': 217043}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216051&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e27e1ec0-9b29-410e-845d-f10677e1d02b', 'multiverseId': 216051}, 'multiverseid': 216051}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216299&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cfe0e056-b273-4b58-8a7e-b004c4c50a6c', 'multiverseId': 216299}, 'multiverseid': 216299}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217540&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c2ca2992-d6af-4352-8225-40210d416190', 'multiverseId': 217540}, 'multiverseid': 217540}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217292&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '91666498-db15-441f-81a2-dc554dc1a54f', 'multiverseId': 217292}, 'multiverseid': 217292}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215804&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd3865589-9323-47ba-956b-a1151fa7fe10', 'multiverseId': 215804}, 'multiverseid': 215804}, {'name': 'Palude', 'text': '{B}', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216548&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '448e4897-957a-41c1-ad00-cc6b9990d0c2', 'multiverseId': 216548}, 'multiverseid': 216548}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216796&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd3eb8b25-d6a6-4c19-a310-74cbc09d689b', 'multiverseId': 216796}, 'multiverseid': 216796}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217044&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0049643c-fd04-4794-9a0d-1277d0e0bf11', 'multiverseId': 217044}, 'multiverseid': 217044}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216052&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '03ee80b9-ba18-4bbb-96fa-4907c99563be', 'multiverseId': 216052}, 'multiverseid': 216052}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216300&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f94f7e9f-769c-4209-a194-f95f20b3bb94', 'multiverseId': 216300}, 'multiverseid': 216300}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217544&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8c9570dd-d617-47be-b659-d4b4f8109775', 'multiverseId': 217544}, 'multiverseid': 217544}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217296&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '64359b85-a9d2-46e0-8573-df92cc26467e', 'multiverseId': 217296}, 'multiverseid': 217296}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215808&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2ac67a3f-b4cc-4f89-84e9-6d3ea1511291', 'multiverseId': 215808}, 'multiverseid': 215808}, {'name': 'Palude', 'text': '{B}', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216552&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '738c5ba3-1244-45b2-84db-bcc63f19eed2', 'multiverseId': 216552}, 'multiverseid': 216552}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216800&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1c5f0507-1ae9-4d3f-92fb-21e964ef7fc4', 'multiverseId': 216800}, 'multiverseid': 216800}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217048&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '3bd9b23c-b8ae-4d55-af17-c2461498e087', 'multiverseId': 217048}, 'multiverseid': 217048}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216056&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f99f39bc-833c-4251-8225-7ad07bc54146', 'multiverseId': 216056}, 'multiverseid': 216056}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216304&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4e32f48d-0fea-4053-90a0-26a5fe3410d5', 'multiverseId': 216304}, 'multiverseid': 216304}]", '[{\'name\': \'Surrakar-Haudegen\', \'text\': \'Immer wenn du einen Spontanzauber oder eine Hexerei wirkst, kannst du eine Ladungsmarke auf den Surrakar-Haudegen legen.\\nImmer wenn der Surrakar-Haudegen einem Spieler Kampfschaden zufügt, kannst du X Karten ziehen, wobei X gleich der Anzahl an Ladungsmarken auf ihm ist.\', \'type\': \'Kreatur — Surrakar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6baeb519-5b9c-4d8b-88fa-be01409e3ef8\', \'multiverseId\': 217520}, \'multiverseid\': 217520}, {\'name\': \'Hojahechizo surrakar\', \'text\': \'Siempre que lances un hechizo instantáneo o conjuro, puedes poner un contador de carga sobre el Hojahechizo surrakar.\\nSiempre que el Hojahechizo surrakar haga daño de combate a un jugador, puedes robar X cartas, donde X es el número de contadores de carga sobre él.\', \'type\': \'Criatura — Surrakar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217272&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69769ba6-7b14-415a-8d05-ff5d408336fa\', \'multiverseId\': 217272}, \'multiverseid\': 217272}, {\'name\': \'Lamesort surrakar\', \'text\': "À chaque fois que vous lancez un sort d\'éphémère ou de rituel, vous pouvez mettre un marqueur « charge » sur le Lamesort surrakar.\\nÀ chaque fois que le Lamesort surrakar inflige des blessures de combat à un joueur, vous pouvez piocher X cartes, X étant le nombre de marqueurs « charge » sur lui.", \'type\': \'Créature : surrakar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'15f43798-361c-49a8-86f3-f8d38610490a\', \'multiverseId\': 215784}, \'multiverseid\': 215784}, {\'name\': \'Surrakar delle Lame Magiche\', \'text\': \'Ogniqualvolta lanci una magia istantaneo o stregoneria, puoi mettere un segnalino carica sul Surrakar delle Lame Magiche.\\nOgniqualvolta il Surrakar delle Lame Magiche infligge danno da combattimento a un giocatore, puoi pescare X carte, dove X è il numero di segnalini carica su di esso.\', \'type\': \'Creatura — Surrakar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216528&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af45939f-d95a-4756-bb9d-89ff9fb8bf34\', \'multiverseId\': 216528}, \'multiverseid\': 216528}, {\'name\': \'サラカーの呪文刃\', \'text\': \'あなたがインスタント呪文かソーサリー呪文を１つ唱えるたび、あなたはサラカーの呪文刃の上に蓄積カウンターを１個置いてもよい。\\nサラカーの呪文刃がいずれかのプレイヤーに戦闘ダメージを与えるたび、あなたはカードをＸ枚引いてもよい。Ｘはその上の蓄積カウンターの数に等しい。\', \'type\': \'クリーチャー — サラカー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216776&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a6137f92-4d94-4e30-943a-0ebd145abb95\', \'multiverseId\': 216776}, \'multiverseid\': 216776}, {\'name\': \'Lâmina Mágica Surrakar\', \'text\': \'Toda vez que conjura uma mágica instantânea ou feitiço, você pode colocar um marcador de carga em Lâmina Mágica Surrakar.\\nToda vez que Lâmina Mágica Surrakar causa dano de combate a um jogador, você pode comprar X cards, sendo X igual ao número de marcadores de carga nele.\', \'type\': \'Criatura — Surrakar\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217024&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e127a0c-922d-4879-8d18-9698f9731923\', \'multiverseId\': 217024}, \'multiverseid\': 217024}, {\'name\': \'Сурракар Заговоренных Клинков\', \'text\': \'Каждый раз когда вы разыгрываете мгновенное заклинание или заклинание волшебства, вы можете положить жетон заряда на Сурракара Заговоренных Клинков.\\nКаждый раз когда Сурракар Заговоренных Клинков наносит боевые повреждения игроку, вы можете взять X карт, где X — количество жетонов заряда на нем.\', \'type\': \'Существо — Сурракар\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216032&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'744cf433-8bc3-4459-b5c2-3b77abb942ed\', \'multiverseId\': 216032}, \'multiverseid\': 216032}, {\'name\': \'咒刃苏拉卡\', \'text\': \'每当你施放瞬间或法术咒语时，你可以在咒刃苏拉卡上放置一个充电指示物。\\n每当咒刃苏拉卡对一位牌手造成战斗伤害时，你可以抓X张牌，X为其上的充电指示物数量。\', \'type\': \'生物～苏拉卡\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216280&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba0dc107-11e3-4669-a55e-1cbfc6881c26\', \'multiverseId\': 216280}, \'multiverseid\': 216280}]', '[{\'name\': \'Surreale Denkschrift\', \'text\': \'Bringe eine zufällig bestimmte Spontanzauberkarte aus deinem Friedhof auf deine Hand zurück.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217506&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'165d4f6d-14d8-4e09-937f-df3709a8a91a\', \'multiverseId\': 217506}, \'multiverseid\': 217506}, {\'name\': \'Memoria surrealista\', \'text\': \'Regresa una carta de instantáneo al azar de tu cementerio a tu mano.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217258&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc43c936-793c-4dc2-9688-10c5ffc7bcf9\', \'multiverseId\': 217258}, \'multiverseid\': 217258}, {\'name\': \'Mémoire surréaliste\', \'text\': "Renvoyez une carte d\'éphémère choisie au hasard depuis votre cimetière dans votre main.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215770&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3237402-790e-4c42-ac00-336dabc7eb7f\', \'multiverseId\': 215770}, \'multiverseid\': 215770}, {\'name\': \'Memorie Surreali\', \'text\': "Riprendi in mano una carta istantaneo a caso dal tuo cimitero.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216514&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a51ef170-c862-4527-96df-c0def3f0871d\', \'multiverseId\': 216514}, \'multiverseid\': 216514}, {\'name\': \'現実離れした回顧\', \'text\': \'あなたの墓地にあるインスタント・カードを無作為に１枚選び、それをあなたの手札に戻す。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216762&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ac25d231-d0ad-4272-bd5a-6b43fba7ecea\', \'multiverseId\': 216762}, \'multiverseid\': 216762}, {\'name\': \'Memórias Surreais\', \'text\': \'Devolva um card de mágica instantânea aleatório de seu cemitério para sua mão.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217010&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'60bb8df1-584a-4688-90ac-a316c59add53\', \'multiverseId\': 217010}, \'multiverseid\': 217010}, {\'name\': \'Сюрреалистическое Воспоминание\', \'text\': \'Верните случайно выбранную карту мгновенного заклинания из вашего кладбища в вашу руку.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216018&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'483df71a-af6d-459d-8545-bd7e78a41852\', \'multiverseId\': 216018}, \'multiverseid\': 216018}, {\'name\': \'虚幻回忆\', \'text\': \'随机将一张瞬间牌从你的坟墓场移回你手上。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216266&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'98e1ffd6-afca-4cf1-9b8b-dfd82284cf86\', \'multiverseId\': 216266}, \'multiverseid\': 216266}]', '[{\'name\': \'Tajuru-Erhalter\', \'text\': \'Zaubersprüche und Fähigkeiten, die deine Gegner kontrollieren, können dich nicht dazu bringen, bleibende Karten zu opfern.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Kein Blut soll mehr vergossen werden, um die verblendete Lust eines Anderen nach Macht zu befriedigen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217323&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'596c8fd5-14f7-4eff-9f60-5e9cdfef9e64\', \'multiverseId\': 217323}, \'multiverseid\': 217323}, {\'name\': \'Preservador de Tajuru\', \'text\': \'Los hechizos y habilidades que controlan tus oponentes no te pueden hacer sacrificar permanentes.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"No se derramará más sangre para satisfacer el ansia de poder de otro."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217075&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0af074b8-99cb-4d0a-9e77-3d1196fe4aed\', \'multiverseId\': 217075}, \'multiverseid\': 217075}, {\'name\': \'Préservateur de Tajuru\', \'text\': \'Les sorts et les capacités que vos adversaires contrôlent ne peuvent pas vous faire sacrifier de permanents.\', \'type\': \'Créature : elfe et shamane\', \'flavor\': "« Le sang ne sera plus versé pour satisfaire la soif de puissance d\'autrui. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215587&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18cfdb5b-6ba5-4a53-9141-bd35544aced5\', \'multiverseId\': 215587}, \'multiverseid\': 215587}, {\'name\': \'Protettore dei Tajuru\', \'text\': \'Le magie e le abilità controllate dai tuoi avversari non possono farti sacrificare permanenti.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"Non si dovrà più versare sangue per soddisfare l\\\'altrui illusoria brama di potere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216331&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'16ec13f7-752e-4b57-b1f7-053f8fa11f43\', \'multiverseId\': 216331}, \'multiverseid\': 216331}, {\'name\': \'タジュールの保護者\', \'text\': \'あなたの対戦相手がコントロールする呪文や能力は、あなたにパーマネントを生け贄に捧げさせることができない。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「力への渇望に惑わされた者を満たすために、これ以上の血は流させるものか。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216579&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ff993f8c-4d44-40aa-8ca4-9bf8b7ee5636\', \'multiverseId\': 216579}, \'multiverseid\': 216579}, {\'name\': \'Preservador Tajuru\', \'text\': \'As mágicas e habilidades que seus oponentes controlam não podem fazer com que você sacrifique permanentes.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"Nem mais uma gota de sangue será derramada para satisfazer o desejo de poder de outro iludido."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216827&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bddb1c5d-74e0-4208-8258-7d354975cf54\', \'multiverseId\': 216827}, \'multiverseid\': 216827}, {\'name\': \'Таджурский Спаситель\', \'text\': \'Заклинания и способности под контролем ваших оппонентов не могут заставить вас приносить в жертву перманенты.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«Довольно кровопролития ради удовлетворения чужой ненасытной жажды власти».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215835&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ed63431a-1391-44f8-9eee-cb5fbc0b0818\', \'multiverseId\': 215835}, \'multiverseid\': 215835}, {\'name\': \'特裘如存护师\', \'text\': \'由对手所操控的咒语或异能无法让你牺牲永久物。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'「不该再有鲜血为了他人的力量妄想而平白流下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216083&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14a647b7-fb62-45f8-ad57-f48e4b7bca93\', \'multiverseId\': 216083}, \'multiverseid\': 216083}]', '[{\'name\': \'Taumelschock\', \'text\': \'Der Taumelschock fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217405&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'46cdee2e-bd5d-42f9-b2fb-a5156eab3e79\', \'multiverseId\': 217405}, \'multiverseid\': 217405}, {\'name\': \'Choque tambaleador\', \'text\': \'El Choque tambaleador hace 2 puntos de daño a la criatura o jugador objetivo.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217157&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'83fe536d-301c-4136-9caf-f7dcd4c1231a\', \'multiverseId\': 217157}, \'multiverseid\': 217157}, {\'name\': \'Ébranlechoc\', \'text\': "L\'Ébranlechoc inflige 2 blessures à une cible, créature ou joueur.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215669&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6c83e1c-f705-401b-9ef8-0e6c0e1f5a71\', \'multiverseId\': 215669}, \'multiverseid\': 215669}, {\'name\': \'Colpo Barcollante\', \'text\': "Il Colpo Barcollante infligge 2 danni a una creatura o a un giocatore bersaglio.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216413&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'67fb4c80-2b35-477f-be9d-660f03303475\', \'multiverseId\': 216413}, \'multiverseid\': 216413}, {\'name\': \'よろめきショック\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。よろめきショックはそれに２点のダメージを与える。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216661&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d8894530-6c66-491e-abec-0f9c25613637\', \'multiverseId\': 216661}, \'multiverseid\': 216661}, {\'name\': \'Tonto-choque\', \'text\': \'Tonto-choque causa 2 pontos de dano à criatura ou ao jogador alvo.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216909&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8eb5283e-6a5d-4a5a-b0a6-5eeac95a9d63\', \'multiverseId\': 216909}, \'multiverseid\': 216909}, {\'name\': \'Сотрясающий Шок\', \'text\': \'Сотрясающий Шок наносит 2 повреждения целевому существу или игроку.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215917&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'51f63c26-8166-493f-a111-0f048b9b4a70\', \'multiverseId\': 215917}, \'multiverseid\': 215917}, {\'name\': \'撼动击\', \'text\': \'撼动击对目标生物或牌手造成2点伤害。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216165&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'506b8bf5-a033-4d86-9a28-ceb27910c8e6\', \'multiverseId\': 216165}, \'multiverseid\': 216165}]', '[{\'name\': \'Todeskultist\', \'text\': \'Opfere den Todeskultisten: Ein Spieler deiner Wahl verliert 1 Lebenspunkt, und du erhältst 1 Lebenspunkt dazu.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'Der Tod verführt unausweichlich alle, die sich mit ihm beschäftigen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b131fdbe-4e72-4aec-a636-5dee5f490823\', \'multiverseId\': 217486}, \'multiverseid\': 217486}, {\'name\': \'Cultista de la muerte\', \'text\': \'Sacrificar el Cultista de la muerte: El jugador objetivo pierde 1 vida y tú ganas 1 vida.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'La muerte seduce inevitablemente a todo el que la estudia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217238&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'329be581-46a8-4f62-97c6-8b878d85937a\', \'multiverseId\': 217238}, \'multiverseid\': 217238}, {\'name\': \'Cultiste de la mort\', \'text\': \'Sacrifiez le Cultiste de la mort : Le joueur ciblé perd 1 point de vie et vous gagnez 1 point de vie.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "La mort finit toujours par séduire ceux qui l\'étudient.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215750&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b4766763-af0f-4df0-8b2c-746a754a6f7c\', \'multiverseId\': 215750}, \'multiverseid\': 215750}, {\'name\': \'Cultista della Morte\', \'text\': \'Sacrifica il Cultista della Morte: Un giocatore bersaglio perde 1 punto vita e tu guadagni 1 punto vita.\', \'type\': \'Creatura — Mago Umano\', \'flavor\': \'La morte inevitabilmente seduce tutti coloro che la studiano.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216494&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31a2a32c-e421-4a4c-8e4e-cfcd22fd5db2\', \'multiverseId\': 216494}, \'multiverseid\': 216494}, {\'name\': \'死の信者\', \'text\': \'死の信者を生け贄に捧げる：プレイヤー１人を対象とする。そのプレイヤーは１点のライフを失い、あなたは１点のライフを得る。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'死はそれを学ぶ者全てを否応無く引き寄せる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216742&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'73054995-a648-4c6a-8d9a-c481dec47be1\', \'multiverseId\': 216742}, \'multiverseid\': 216742}, {\'name\': \'Cultista da Morte\', \'text\': \'Sacrifique Cultista da Morte: O jogador alvo perde 1 ponto de vida e você ganha 1 ponto de vida.\', \'type\': \'Criatura — Humano Mago\', \'flavor\': \'A morte seduz inevitavelmente todos que a estudam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216990&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8261c779-69fc-41cb-8ca2-ffd530a4dbc1\', \'multiverseId\': 216990}, \'multiverseid\': 216990}, {\'name\': \'Последователь Культа Смерти\', \'text\': \'Пожертвуйте Последователя Культа Смерти: целевой игрок теряет 1 жизнь, а вы получаете 1 жизнь.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'Смерть неизбежно соблазняет всех, кто ее изучает.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215998&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9bae8039-2443-4444-8384-59658ced2001\', \'multiverseId\': 215998}, \'multiverseid\': 215998}, {\'name\': \'死亡教众\', \'text\': \'{B}，牺牲死亡教众：目标牌手失去1点生命且你获得1点生命。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'死亡总诱惑着研究它的人。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216246&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4281cb47-d275-496a-a3b8-8c49c88ed81a\', \'multiverseId\': 216246}, \'multiverseid\': 216246}]', '[{\'name\': \'Totemgelenktes Hartebeest\', \'text\': \'Wenn das Totemgelenkte Hartebeest ins Spiel kommt, kannst du deine Bibliothek nach einer Aura-Karte durchsuchen, sie offen vorzeigen, auf deine Hand nehmen und danach deine Bibliothek mischen.\', \'type\': \'Kreatur — Antilope\', \'flavor\': \'Die Kor verfolgen Hartebeests und hoffen, dabei auf Magie zu stoßen, die ihnen im Kampf gegen die Eldrazi hilft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217503&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8511e8aa-33b1-466f-8e3f-fdd4f69d22b8\', \'multiverseId\': 217503}, \'multiverseid\': 217503}, {\'name\': \'Alcelafo guía de tótem\', \'text\': \'Cuando el Alcelafo guía de tótem entre al campo de batalla, puedes buscar en tu biblioteca una carta de aura, mostrarla, ponerla en tu mano y luego barajar tu biblioteca.\', \'type\': \'Criatura — Antílope\', \'flavor\': \'Los kor siguen a los alcelafos con la esperanza de encontrar alguna magia que los ayude a luchar contra los eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217255&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0dbc227d-7114-43f1-b0d8-7488e501c3d2\', \'multiverseId\': 217255}, \'multiverseid\': 217255}, {\'name\': \'Bubale guide totémique\', \'text\': "Quand le Bubale guide totémique arrive sur le champ de bataille, vous pouvez chercher dans votre bibliothèque une carte d\'aura, la révéler, la mettre dans votre main et mélanger ensuite votre bibliothèque.", \'type\': \'Créature : antilope\', \'flavor\': "Les Kor pistent les bubales dans l\'espoir de trouver une magie qui les aidera à combattre les Eldrazi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215767&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aafe703b-55ed-4302-ba28-b853681e5343\', \'multiverseId\': 215767}, \'multiverseid\': 215767}, {\'name\': \'Alcefalo Totemico\', \'text\': "Quando l\'Alcefalo Totemico entra nel campo di battaglia, puoi passare in rassegna il tuo grimorio per una carta Aura, rivelarla, aggiungerla alla tua mano, poi rimescolare il tuo grimorio.", \'type\': \'Creatura — Antilope\', \'flavor\': \'I kor cacciano gli alcefali nella speranza di trovare la magia che li aiuti a combattere gli Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216511&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f471e085-a784-4b56-b322-4929e229048a\', \'multiverseId\': 216511}, \'multiverseid\': 216511}, {\'name\': \'族霊導きの鹿羚羊\', \'text\': \'族霊導きの鹿羚羊が戦場に出たとき、あなたはあなたのライブラリーからオーラ・カードを１枚探してもよい。そうしたなら、それを公開してあなたの手札に加え、その後あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — アンテロープ\', \'flavor\': \'コーが鹿羚羊を追うのは、エルドラージと戦う助けとなる魔法を見つけようとしているが故だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216759&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'659140f5-66a0-441b-b54f-409b6180174a\', \'multiverseId\': 216759}, \'multiverseid\': 216759}, {\'name\': \'Búbalo Guia-Totem\', \'text\': \'Quando Búbalo Guia-Totem entra no campo de batalha, você pode procurar um card de Aura em seu grimório, revelá-lo, colocá-lo na sua mão e depois embaralhar seu grimório.\', \'type\': \'Criatura — Antílope\', \'flavor\': \'Os kor seguem os búbalos na esperança de encontrar magia para ajudar a enfrentar os Eldrazi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217007&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'74cecf6c-a914-4c74-8165-e6fbe8196a38\', \'multiverseId\': 217007}, \'multiverseid\': 217007}, {\'name\': \'Бубал, Тотемный Проводник\', \'text\': \'Когда Бубал, Тотемный Проводник выходит на поле битвы, вы можете найти в вашей библиотеке карту Ауры, показать ее, положить ее в вашу руку, затем перетасовать вашу библиотеку.\', \'type\': \'Существо — Антилопа\', \'flavor\': \'Коры идут вслед за бубалами в надежде найти магию, которая поможет им противостоять Эльдрази.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216015&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0299f254-e95c-45c4-ae0b-eb7f563b21e1\', \'multiverseId\': 216015}, \'multiverseid\': 216015}, {\'name\': \'图腾导狷羚\', \'text\': \'当图腾导狷羚进战场时，你可以从你牌库中搜寻一张灵气牌，展示该牌，并将它置入你手上，然后将你的牌库洗牌。\', \'type\': \'生物～羚羊\', \'flavor\': \'寇族追踪狷羚，希望能找到可协助对抗奥札奇的法术。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216263&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cbbb161e-1d1c-4641-9ffa-f64ca2b8e0f4\', \'multiverseId\': 216263}, \'multiverseid\': 216263}]', '[{\'name\': \'Traumscheußlichkeit\', \'text\': \'Verteidiger\\nWenn die Traumscheußlichkeit das Ziel eines Zauberspruchs oder einer Fähigkeit wird, opfere sie.\', \'type\': \'Kreatur — Illusion\', \'flavor\': \'Wenn du Illusionen erzeugen kannst, die für andere die Realität ersetzen, dann kannst du alle beherrschen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217502&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b48d90ad-6aa8-41bb-885d-2557501d25be\', \'multiverseId\': 217502}, \'multiverseid\': 217502}, {\'name\': \'Abominación fantasmal\', \'text\': \'Defensor.\\nCuando la Abominación fantasmal sea objetivo de un hechizo o habilidad, sacrifícala.\', \'type\': \'Criatura — Ilusión\', \'flavor\': \'Crea una ilusión tan fuerte que se convierta en la realidad de otro, y podrás dominarlo todo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217254&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'410fa156-90fe-4fb8-8623-6c1775c3fba5\', \'multiverseId\': 217254}, \'multiverseid\': 217254}, {\'name\': \'Abomination phantasmatique\', \'text\': "Défenseur\\nQuand l\'Abomination phantasmatique devient la cible d\'un sort ou d\'une capacité, sacrifiez-la.", \'type\': \'Créature : illusion\', \'flavor\': "Créez une illusion si forte qu\'elle devient la réalité pour autrui, et vous pourrez devenir le maître du tout.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215766&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6dc8aee5-56c9-4954-9e17-14f4915a67da\', \'multiverseId\': 215766}, \'multiverseid\': 215766}, {\'name\': \'Abominio Fantasma\', \'text\': "Difensore\\nQuando l\'Abominio Fantasma diventa bersaglio di una magia o abilità, sacrificalo.", \'type\': \'Creatura — Illusione\', \'flavor\': "Crea un\'illusione così forte da diventare la realtà di un altro e tu puoi diventare il padrone di tutti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216510&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'427d5107-1f10-4dfe-8bc7-d513a830b7a9\', \'multiverseId\': 216510}, \'multiverseid\': 216510}, {\'name\': \'幻影の嫌悪者\', \'text\': \'防衛\\n幻影の嫌悪者が呪文や能力の対象になったとき、それを生け贄に捧げる。\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': \'生み出した幻影があまりにも強力だと、それは別の現実となり、やがてお前はすべての支配者となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216758&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f1c01f9-67a4-45ab-b2b9-3f2f98f1c05c\', \'multiverseId\': 216758}, \'multiverseid\': 216758}, {\'name\': \'Abominação Fantasmal\', \'text\': \'Defensor\\nQuando Abominação Fantasmal se tornar alvo de uma mágica ou habilidade, sacrifique-a.\', \'type\': \'Criatura — Ilusão\', \'flavor\': \'Crie uma ilusão tão potente que se torne a realidade de outro, e você se tornará o mestre de tudo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217006&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9c524aa-1548-4d0d-b94a-b3bab48db566\', \'multiverseId\': 217006}, \'multiverseid\': 217006}, {\'name\': \'Призрачная Мерзость\', \'text\': \'Защитник\\nКогда Призрачная Мерзость становится целью заклинания или способности, пожертвуйте ее.\', \'type\': \'Существо — Иллюзия\', \'flavor\': \'Создайте иллюзию настолько сильную, чтобы остальным она казалась реальностью, и вы сможете стать повелителем всего.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216014&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'770988b1-bf6c-42f8-9894-8c74aa399c04\', \'multiverseId\': 216014}, \'multiverseid\': 216014}, {\'name\': \'幻象憎恨兽\', \'text\': \'守军\\n当幻象憎恨兽成为咒语或异能的目标时，将它牺牲。\', \'type\': \'生物～虚影\', \'flavor\': \'如果所制造的幻象强大到能成为他人的现实，你就能成为万物的主宰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216262&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c13c8981-9d59-42c5-bb87-f0ba71c1d340\', \'multiverseId\': 216262}, \'multiverseid\': 216262}]', '[{\'name\': \'Traumstein-Polyeder\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {3}.\\n{3}, {T}, opfere den Traumstein-Polyeder: Ziehe drei Karten.\', \'type\': \'Artefakt\', \'flavor\': \'Nur der Verstand der Eldrazi kann so verworren denken, wie es notwendig ist, um die Polyeder zu öffnen und an die in ihnen eingeschlossene Macht zu kommen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217359&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'262f6c01-fa4f-4636-b40e-ed49b2764d23\', \'multiverseId\': 217359}, \'multiverseid\': 217359}, {\'name\': \'Edro piedra del sueño\', \'text\': \'{T}: Agrega {3} a tu reserva de maná.\\n{3}, {T}, sacrificar el Edro piedra del sueño: Roba tres cartas.\', \'type\': \'Artefacto\', \'flavor\': \'Sólo la mente de los eldrazi funciona de la retorcida forma que se requiere para abrir los edros y obtener el poder que hay dentro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217111&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4010c10-fdc0-46bb-9862-403467b4c162\', \'multiverseId\': 217111}, \'multiverseid\': 217111}, {\'name\': \'Hèdron pierre de rêve\', \'text\': "{T} : Ajoutez {3} à votre réserve.\\n{3}, {T}, sacrifiez l\'Hèdron pierre de rêve : Piochez trois cartes.", \'type\': \'Artefact\', \'flavor\': "Seul l\'esprit eldrazi est assez tordu pour ouvrir les hèdrons et puiser leur puissance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215623&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'468fce17-46f1-4bb9-b6aa-beb82a5f20fe\', \'multiverseId\': 215623}, \'multiverseid\': 215623}, {\'name\': \'Edro della Pietra Onirica\', \'text\': "{T}: Aggiungi {3} alla tua riserva di mana.\\n{3}, {T}, Sacrifica l\'Edro della Pietra Onirica: Pesca tre carte.", \'type\': \'Artefatto\', \'flavor\': \'Solo la mente degli Eldrazi può seguire le linee contorte necessarie ad aprire gli edri e attingere il loro potere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216367&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b4ad2b1d-8f82-4f69-9ba6-eae4f56156c8\', \'multiverseId\': 216367}, \'multiverseid\': 216367}, {\'name\': \'夢石の面晶体\', \'text\': \'{T}：あなたのマナ・プールに{3}を加える。\\n{3}, {T}, 夢石の面晶体を生け贄に捧げる：カードを３枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'エルドラージの精神のみが、面晶体を開きその力を自らの物にするための歪んだ道筋をたどることができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216615&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8f70d1a6-a331-46e2-840f-3485c0b52e32\', \'multiverseId\': 216615}, \'multiverseid\': 216615}, {\'name\': \'Edro da Pedra Onírica\', \'text\': \'{T}: Adicione {3} à sua reserva de mana.\\n{3}, {T}, Sacrifique Edro da Pedra Onírica: Compre três cards.\', \'type\': \'Artefato\', \'flavor\': \'Somente a mente dos Eldrazi consegue pensar no padrão distorcido necessário para abrir os edros e utilizar o poder no seu interior.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216863&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6566b18-3d93-48d7-89ee-58937ba9d61b\', \'multiverseId\': 216863}, \'multiverseid\': 216863}, {\'name\': \'Эдр из Камня Сновидений\', \'text\': \'{T}: добавьте {3} в ваше хранилище маны.\\n{3}, {T}, пожертвуйте Эдр из Камня Сновидений: возьмите три карты.\', \'type\': \'Артефакт\', \'flavor\': \'Только разум Эльдрази мыслит такими извилистыми путями, чтобы вскрывать эдры и выкачивать хранящуюся в них силу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215871&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0b8361d6-719b-4d71-a9ea-ee3da1bbcdca\', \'multiverseId\': 215871}, \'multiverseid\': 215871}, {\'name\': \'梦想晶石\', \'text\': \'{T}：加{3}到你的法术力池中。\\n{3}，{T}，牺牲梦想晶石：抓三张牌。\', \'type\': \'神器\', \'flavor\': \'只有透过奥札奇心灵的歪曲思考路径，才能敲开晶石来汲取其间力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216119&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'de68ec6b-df29-4847-a8f6-46ab4963a0de\', \'multiverseId\': 216119}, \'multiverseid\': 216119}]', '[{\'name\': \'Tuktuk der Erforscher\', \'text\': \'Eile\\nWenn Tuktuk der Erforscher aus dem Spiel auf einen Friedhof gelegt wird, bringe einen legendären 5/5 farblosen (Goblin, Golem)-Artefaktkreaturenspielstein namens Tuktuk der Zurückgekehrte ins Spiel.\', \'type\': \'Legendäre Kreatur — Goblin\', \'flavor\': \'Tuktuk, der durch Eldrazi-Magie wieder zusammengesetzt worden war, inspirierte einen ganzen Clan fehlgeleiteter Goblins.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e0ed6727-5d7f-4dfa-9c7b-73a61e208a6c\', \'multiverseId\': 217481}, \'multiverseid\': 217481}, {\'name\': \'Tuktuk el explorador\', \'text\': \'Prisa.\\nCuando Tuktuk el explorador vaya a un cementerio desde el campo de batalla, pon en el campo de batalla una ficha de criatura artefacto legendaria Gólem Trasgo incolora 5/5 llamada Tuktuk el regresado.\', \'type\': \'Criatura legendaria — Trasgo\', \'flavor\': \'Recreado por magia eldrazi, Tuktuk inspiró todo un clan de trasgos insensatos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217233&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'61fba461-2518-4dc8-88b1-3e38bd77ce6b\', \'multiverseId\': 217233}, \'multiverseid\': 217233}, {\'name\': "Tuktuk l\'Explorateur", \'text\': "Célérité\\nQuand Tuktuk l\'Explorateur est mis dans un cimetière depuis le champ de bataille, mettez sur le champ de bataille un jeton de créature-artefact légendaire 5/5 incolore Gobelin et Golem nommé Tuktuk le Reparu.", \'type\': \'Créature légendaire : gobelin\', \'flavor\': \'Transmuté par la magie eldrazi, Tuktuk inspira tout un clan de gobelins malavisés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215745&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'696218f0-c6dc-45a7-9125-265c2e3abca5\', \'multiverseId\': 215745}, \'multiverseid\': 215745}, {\'name\': "Tuktuk l\'Esploratore", \'text\': "Rapidità\\nQuando Tuktuk l\'Esploratore viene messo in un cimitero dal campo di battaglia, metti sul campo di battaglia una pedina creatura artefatto leggendaria Golem Goblin 5/5 incolore chiamata Tuktuk il Reduce.", \'type\': \'Creatura Leggendaria — Goblin\', \'flavor\': \'Ricreato dalla magia degli Eldrazi, Tuktuk ispirò un intero clan di goblin maldestri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216489&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e231c97a-afc9-48cd-8700-430dcd920ce3\', \'multiverseId\': 216489}, \'multiverseid\': 216489}, {\'name\': \'探検家タクタク\', \'text\': \'速攻\\n探検家タクタクが戦場からいずれかの墓地に置かれたとき、「復活のタクタク」という名前の無色の５/５の伝説のゴブリン・ゴーレム・アーティファクト・クリーチャー・トークンを１体戦場に出す。\', \'type\': \'伝説のクリーチャー — ゴブリン\', \'flavor\': \'エルドラージの魔法に作り変えられたタクタクは、見当違いのゴブリンたちの種族全体を煽り立てている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216737&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'587c1718-19ea-48d0-9b0c-1a3f648e37c9\', \'multiverseId\': 216737}, \'multiverseid\': 216737}, {\'name\': \'Tuktuk, o Explorador\', \'text\': \'Ímpeto\\nQuando Tuktuk, o Explorador, for colocado num cemitério vindo do campo de batalha, coloque no campo de batalha uma ficha de criatura artefato lendária incolor 5/5 do tipo Goblin Golem com o nome Tuktuk, o Retornado.\', \'type\': \'Criatura Lendária — Goblin\', \'flavor\': \'Recriado pela magia dos Eldrazi, Tuktuk inspirou um clã inteiro de goblins desencaminhados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216985&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'542350b0-0017-4b96-a65a-f0d48dbfad62\', \'multiverseId\': 216985}, \'multiverseid\': 216985}, {\'name\': \'Туктук Исследователь\', \'text\': \'Ускорение\\nКогда Туктук Исследователь попадает с поля битвы на кладбище, положите на поле битвы одну фишку легендарного артефактного существа 5/5 бесцветный Гоблин Голем с именем Туктук Возвращенец.\', \'type\': \'Легендарное Существо — Гоблин\', \'flavor\': \'Переделанный с помощью магии Эльдрази, Туктук послужил вдохновением целому клану недальновидных гоблинов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215993&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55d13aa6-4992-4d92-ae80-a6f0b65ed7ce\', \'multiverseId\': 215993}, \'multiverseid\': 215993}, {\'name\': \'探险家图图\', \'text\': \'敏捷\\n当探险家图图从战场进入坟墓场时，将一个传奇的5/5，名称为归来的图图之无色鬼怪／魔像神器生物衍生物放进战场。\', \'type\': \'传奇生物～鬼怪\', \'flavor\': \'图图被奥札奇法术重制之后，点醒了一整族被带入歧途的鬼怪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216241&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'eda67da9-5084-4c41-805f-b34d4a7269bd\', \'multiverseId\': 216241}, \'multiverseid\': 216241}]', '[{\'name\': \'Ulamog, der unendliche Wirbel\', \'text\': \'Wenn du Ulamog, den unendlichen Wirbel, wirkst, zerstöre eine bleibende Karte deiner Wahl.\\nVernichter 4 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler vier bleibende Karten.)\\nUlamog ist unzerstörbar.\\nWenn Ulamog von irgendwoher auf den Friedhof gelegt wird, mischt sein Besitzer seinen Friedhof in seine Bibliothek.\', \'type\': \'Legendäre Kreatur — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217462&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'22327949-d1fb-4de3-b8f0-51b22ac58a6a\', \'multiverseId\': 217462}, \'multiverseid\': 217462}, {\'name\': \'Ulamog, la espiral infinita\', \'text\': \'Cuando lances a Ulamog, la espiral infinita, destruye el permanente objetivo.\\nAniquilador 4. (Siempre que esta criatura ataque, el jugador defensor sacrifica cuatro permanentes.)\\nUlamog es indestructible.\\nCuando Ulamog vaya a un cementerio desde cualquier parte, su propietario baraja su cementerio en su biblioteca.\', \'type\': \'Criatura legendaria — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217214&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c51553c-8beb-48f2-b9da-547646d52e35\', \'multiverseId\': 217214}, \'multiverseid\': 217214}, {\'name\': "Ulamog, l\'Épicycle Infini", \'text\': "Quand vous lancez Ulamog, l\'Épicycle Infini, détruisez un permanent ciblé.\\nAnnihilateur 4 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie quatre permanents.)\\nUlamog est indestructible.\\nQuand Ulamog est mis dans un cimetière depuis n\'importe où, son propriétaire mélange son cimetière à sa bibliothèque.", \'type\': \'Créature légendaire : eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215726&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c6418771-1f58-40bb-9d5d-293c7bc7af45\', \'multiverseId\': 215726}, \'multiverseid\': 215726}, {\'name\': \'Ulamog, il Cerchio Infinito\', \'text\': \'Quando lanci Ulamog, il Cerchio Infinito distruggi un permanente bersaglio.\\nAnnientatore 4 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica quattro permanenti.)\\nUlamog è indistruttibile.\\nQuando Ulamog viene messo in un cimitero da qualsiasi zona, il suo proprietario rimescola il suo cimitero nel suo grimorio.\', \'type\': \'Creatura Leggendaria — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216470&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd639532-c11f-459d-a1eb-ae6772d74aac\', \'multiverseId\': 216470}, \'multiverseid\': 216470}, {\'name\': \'無限に廻るもの、ウラモグ\', \'text\': \'あなたが無限に廻るもの、ウラモグを唱えたとき、パーマネント１つを対象とし、それを破壊する。\\n滅殺 ４ （このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを４つ生け贄に捧げる。）\\n無限に廻るもの、ウラモグは破壊されない。\\n無限に廻るもの、ウラモグがいずれかの領域からいずれかの墓地に置かれたとき、そのオーナーは自分の墓地を自分のライブラリーに加えて切り直す。\', \'type\': \'伝説のクリーチャー — エルドラージ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216718&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'294822b2-b3fa-449f-8647-fee444ac0ce5\', \'multiverseId\': 216718}, \'multiverseid\': 216718}, {\'name\': \'Ulamog, o Vórtice Infinito\', \'text\': \'Quando conjurar Ulamog, o Vórtice Infinito, destrua a permanente alvo.\\nAniquilador 4 (Toda vez que esta criatura ataca, o jogador defensor sacrifica quatro permanentes.)\\nUlamog é indestrutível.\\nQuando Ulamog é colocado num cemitério vindo de qualquer lugar, seu dono embaralha seu próprio cemitério em seu próprio grimório.\', \'type\': \'Criatura Lendária — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216966&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d534904a-ac72-43a9-a2df-4018e708548a\', \'multiverseId\': 216966}, \'multiverseid\': 216966}, {\'name\': \'Уламог, Бесконечный Вихрь\', \'text\': \'Когда вы разыгрываете Уламога, Бесконечный Вихрь, уничтожьте целевой перманент.\\nАннигилятор 4 (Каждый раз когда это существо атакует, защищающийся игрок приносит в жертву четыре перманента.)\\nУламог не может быть уничтожен.\\nКогда Уламог попадает откуда-либо на кладбище, его владелец втасовывает свое кладбище в свою библиотеку.\', \'type\': \'Легендарное Существо — Эльдрази\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215974&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1bfe1520-63b9-4654-819f-f79a02dcaff3\', \'multiverseId\': 215974}, \'multiverseid\': 215974}, {\'name\': \'无尽轮回钨拉莫\', \'text\': \'当你施放无尽轮回钨拉莫时，消灭目标永久物。\\n歼灭4 （每当此生物攻击时，防御牌手牺牲四个永久物。）\\n钨拉莫不会毁坏。\\n当钨拉莫从任何地方置入坟墓场时，其拥有者将其坟墓场洗入其牌库。\', \'type\': \'传奇生物～奥札奇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216222&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f2f9b358-0e76-4ac2-868f-2c8aec1707ba\', \'multiverseId\': 216222}, \'multiverseid\': 216222}]', '[{\'name\': \'Ulamogs Ausgeburtserzeuger\', \'text\': \'Vernichter 1 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler eine bleibende Karte.)\\n{4}: Bringe zwei 0/1 farblose (Eldrazi, Ausgeburt)-Kreaturenspielsteine ins Spiel. Sie haben „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\\n{20}: Wirke eine beliebige Anzahl von Eldrazi-Karten, die sich außerhalb des Spiels befinden, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Kreatur — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217381&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'94ee59d3-530d-4273-b787-0ded7de4f777\', \'multiverseId\': 217381}, \'multiverseid\': 217381}, {\'name\': \'Señor de engendros de Ulamog\', \'text\': \'Aniquilador 1. (Siempre que esta criatura ataque, el jugador defensor sacrifica un permanente.)\\n{4}: Pon en el campo de batalla dos fichas de criatura Engendro Eldrazi incoloras 0/1. Tienen "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\\n{20}: Lanza cualquier cantidad de cartas Eldrazi que poseas que estén fuera del juego sin pagar sus costes de maná.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217133&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'222920d2-107e-4fcc-85d6-2c0898b41742\', \'multiverseId\': 217133}, \'multiverseid\': 217133}, {\'name\': "Père-couveur d\'Ulamog", \'text\': "Annihilateur 1 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie un permanent.)\\n{4} : Mettez sur le champ de bataille deux jetons de créature 0/1 incolore Eldrazi et Engeance. Ils ont « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »\\n{20} : Lancez n\'importe quel nombre de cartes d\'eldrazi que vous possédez en dehors de la partie sans payer leurs coûts de mana.", \'type\': \'Créature : eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215645&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca9b0d5c-1f34-45d6-ab61-b3061d7bc47d\', \'multiverseId\': 215645}, \'multiverseid\': 215645}, {\'name\': \'Progenitore di Ulamog\', \'text\': \'Annientatore 1 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica un permanente.)\\n{4}: Metti sul campo di battaglia due pedine creatura Progenie Eldrazi 0/1 incolori. Hanno "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\\n{20}: Lancia un qualsiasi numero di carte Eldrazi che possiedi al di fuori della partita senza pagare i loro costi di mana.\', \'type\': \'Creatura — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216389&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'757e6cb4-4b37-41b0-8a28-9239ace520dd\', \'multiverseId\': 216389}, \'multiverseid\': 216389}, {\'name\': \'ウラモグの種父\', \'text\': \'滅殺 １ （このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを１つ生け贄に捧げる。）\\n{4}：無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを２体戦場に出す。 それらは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\\n{20}：望む枚数のゲーム外のあなたがオーナーであるエルドラージ・カードを、それらのマナ・コストを支払うことなく唱える。\', \'type\': \'クリーチャー — エルドラージ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216637&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4aac193-7214-4c6a-8c87-f16973719deb\', \'multiverseId\': 216637}, \'multiverseid\': 216637}, {\'name\': \'Progenitor da Prole de Ulamog\', \'text\': \'Aniquilador 1 (Toda vez que esta criatura ataca, o jogador defensor sacrifica uma permanente.)\\n{4}: Coloque no campo de batalha duas fichas de criatura incolores 0/1 do tipo Prole Eldrazi. Elas têm "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\\n{20}: Conjure um número qualquer de cards do tipo Eldrazi seus que estejam fora do jogo sem pagar seus custos de mana.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216885&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'772e4bd3-ed6f-47c1-a9d9-ebf48d36cb52\', \'multiverseId\': 216885}, \'multiverseid\': 216885}, {\'name\': \'Рассадник Уламога\', \'text\': \'Аннигилятор 1 (Каждый раз когда это существо атакует, защищающийся игрок приносит в жертву один перманент.)\\n{4}: положите на поле битвы две фишки существа 0/1 бесцветный Эльдрази Порождение. У них есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\\n{20}: разыграйте любое количество находящихся вне игры карт Эльдрази, владельцем которых вы являетесь, без уплаты их мана-стоимости.\', \'type\': \'Существо — Эльдрази\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215893&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d9bb4837-4061-4dfe-be44-fdfbff059875\', \'multiverseId\': 215893}, \'multiverseid\': 215893}, {\'name\': \'钨拉莫孳息者\', \'text\': \'歼灭1 （每当此生物攻击时，防御牌手牺牲一个永久物。）\\n{4}：将两个0/1无色奥札奇／后裔衍生物放进战场。 它们具有「牺牲此生物：加{1}到你的法术力池中。」\\n{20}：从游戏外施放任意数量由你拥有的奥札奇牌，且不需支付其法术力费用。\', \'type\': \'生物～奥札奇\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216141&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a4c375c4-93a7-4d22-8e83-2f3490479506\', \'multiverseId\': 216141}, \'multiverseid\': 216141}]', '[{\'name\': \'Ulamogs Schläger\', \'text\': \'Vernichter 2 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler zwei bleibende Karten.)\\nUlamogs Schläger greift in jedem Zug an, falls möglich.\', \'type\': \'Kreatur — Eldrazi\', \'flavor\': \'„Was auch der Zweck der Eldrazi sein mag, es hat nichts mit so etwas Unbedeutendem wie uns zu tun." —Nirthu, einsamer Missionar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217461&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e3a09cd-8c30-4115-908a-e56143dc0687\', \'multiverseId\': 217461}, \'multiverseid\': 217461}, {\'name\': \'Triturador de Ulamog\', \'text\': \'Aniquilador 2. (Siempre que esta criatura ataque, el jugador defensor sacrifica dos permanentes.)\\nEl Triturador de Ulamog ataca cada turno si puede.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'"Cualquiera sea el propósito de los eldrazi, no tiene nada que ver con algo tan insignificante como nosotros." —Nirthu, misionero solitario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217213&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4e4f91f-65e8-4224-b94e-0b108a46d234\', \'multiverseId\': 217213}, \'multiverseid\': 217213}, {\'name\': "Écrabouilleur d\'Ulamog", \'text\': "Annihilateur 2 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie deux permanents.)\\nL\'Écrabouilleur d\'Ulamog attaque à chaque tour si possible.", \'type\': \'Créature : eldrazi\', \'flavor\': "« Quel que soit l\'objectif des Eldrazi, nous sommes trop insignifiants pour en faire partie. » —Nirthu, missionnaire solitaire", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215725&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a7100ae2-a102-4164-9222-efc620d9ad5a\', \'multiverseId\': 215725}, \'multiverseid\': 215725}, {\'name\': \'Frantumatore di Ulamog\', \'text\': \'Annientatore 2 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica due permanenti.)\\nIl Frantumatore di Ulamog attacca ogni turno, se può farlo.\', \'type\': \'Creatura — Eldrazi\', \'flavor\': \'"Qualunque sia lo scopo degli Eldrazi, non ha a che fare con nulla di così insignificante come noi." —Nirthu, missionario solitario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216469&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'737b92f5-e944-450f-b046-20ca12dbbd9f\', \'multiverseId\': 216469}, \'multiverseid\': 216469}, {\'name\': \'ウラモグの破壊者\', \'text\': \'滅殺 ２ （このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを２つ生け贄に捧げる。）\\nウラモグの破壊者は可能なら毎ターン攻撃する。\', \'type\': \'クリーチャー — エルドラージ\', \'flavor\': \'「エルドラージの目的が何であれ、我等の如き取るに足らないものとは何の関係も無いことだ。」 ――孤独な宣教師、ニルトゥ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216717&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'364be326-72fa-468c-a6bd-8a101de8235a\', \'multiverseId\': 216717}, \'multiverseid\': 216717}, {\'name\': \'Triturador de Ulamog\', \'text\': \'Aniquilador 2 (Toda vez que esta criatura ataca, o jogador defensor sacrifica duas permanentes.)\\nTriturador de Ulamog ataca a cada turno se estiver apto.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'"Seja qual for o propósito dos Eldrazi, não há nada a ver com algo tão insignificante como nós." — Nirthu, missionário solitário\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216965&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'740b0e6a-c5a3-4741-8311-b3ef99db0a92\', \'multiverseId\': 216965}, \'multiverseid\': 216965}, {\'name\': \'Крушитель Уламога\', \'text\': \'Аннигилятор 2 (Каждый раз когда это существо атакует, защищающийся игрок приносит в жертву два перманента.)\\nКрушитель Уламога атакует в каждом ходу, если может.\', \'type\': \'Существо — Эльдрази\', \'flavor\': \'«Какая бы ни была цель у Эльдрази, она не имеет ничего общего с такими пустяками, как мы». — Нирту, миссионер-одиночка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215973&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d43ba42c-554a-486f-9b99-348ceb3fbb44\', \'multiverseId\': 215973}, \'multiverseid\': 215973}, {\'name\': \'钨拉莫猛击手\', \'text\': \'歼灭2 （每当此生物攻击时，防御牌手牺牲两个永久物。）\\n钨拉莫猛击手每回合若能攻击，则必须攻击。\', \'type\': \'生物～奥札奇\', \'flavor\': \'「不论奥札奇的目的为何，都不是针对我们这些微不足道的居民。」 ～独行传教士讷图\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216221&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5e9e0d3-3516-4722-b1a8-bc43cf782f34\', \'multiverseId\': 216221}, \'multiverseid\': 216221}]', '[{\'name\': \'Ulamogs Spielfigur\', \'text\': \'Immer wenn Ulamogs Spielfigur oder eine andere Kreatur, die du kontrollierst und die kein Spielstein ist, aus dem Spiel auf einen Friedhof gelegt wird, kannst du einen 0/1 farblosen (Eldrazi, Ausgeburt)-Kreaturenspielstein ins Spiel bringen. Er hat „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Kreatur — Vampir, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217460&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7a1a3ccb-43ca-495a-976a-72c4b1e64f83\', \'multiverseId\': 217460}, \'multiverseid\': 217460}, {\'name\': \'Peón de Ulamog\', \'text\': \'Siempre que el Peón de Ulamog u otra criatura que no sea ficha que controles vaya a un cementerio desde el campo de batalla, puedes poner en el campo de batalla una ficha de criatura Engendro Eldrazi incolora 0/1. Tiene "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Criatura — Chamán vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217212&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8114e6e4-67f9-4fe1-a752-1f0945e8dd15\', \'multiverseId\': 217212}, \'multiverseid\': 217212}, {\'name\': "Pion d\'Ulamog", \'text\': "À chaque fois que le Pion d\'Ulamog ou qu\'une autre créature non-jeton que vous contrôlez est mis dans un cimetière depuis le champ de bataille, vous pouvez mettre sur le champ de bataille un jeton de créature 0/1 incolore Eldrazi et Engeance. Il a « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »", \'type\': \'Créature : vampire et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215724&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fd79a25d-d4a2-4334-a0b5-62a31cff2a5c\', \'multiverseId\': 215724}, \'multiverseid\': 215724}, {\'name\': \'Pedina di Ulamog\', \'text\': \'Ogniqualvolta la Pedina di Ulamog o un\\\'altra creatura non pedina che controlli viene messa in un cimitero dal campo di battaglia, puoi mettere sul campo di battaglia una pedina creatura Progenie Eldrazi 0/1 incolore. Ha "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Creatura — Sciamano Vampiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216468&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4f5c1bff-3815-4c50-a3a6-774c2734a120\', \'multiverseId\': 216468}, \'multiverseid\': 216468}, {\'name\': \'ウラモグの手先\', \'text\': \'ウラモグの手先かあなたがコントロールする他のトークンでないクリーチャーが１体戦場からいずれかの墓地に置かれるたび、あなたは無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを１体戦場に出してもよい。 それは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'クリーチャー — 吸血鬼・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216716&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16d430d8-7ef6-4908-abea-32a1449b86da\', \'multiverseId\': 216716}, \'multiverseid\': 216716}, {\'name\': \'Peão de Ulamog\', \'text\': \'Toda vez que Peão de Ulamog ou outra criatura que não seja ficha que você controla for colocada no cemitério vinda do campo de batalha, você pode colocar no campo de batalha uma ficha de criatura incolor 0/1 do tipo Prole Eldrazi. Ela tem "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\', \'type\': \'Criatura — Vampiro Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216964&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'03d8e165-2933-45c7-886a-02245095fdbc\', \'multiverseId\': 216964}, \'multiverseid\': 216964}, {\'name\': \'Пешка Уламога\', \'text\': \'Каждый раз когда Пешка Уламога или другое не являющееся фишкой существо под вашим контролем попадает с поля битвы на кладбище, вы можете положить на поле битвы одну фишку существа 0/1 бесцветный Эльдрази Порождение. У нее есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\', \'type\': \'Существо — Вампир Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215972&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7731bc85-1d5a-4571-8889-120d1889f710\', \'multiverseId\': 215972}, \'multiverseid\': 215972}, {\'name\': \'钨拉莫兵卒\', \'text\': \'每当钨拉莫兵卒或另一个由你操控、且非衍生物的生物从战场进入坟墓场时，你可以将一个0/1无色奥札奇／后裔衍生物放进战场。 它具有「牺牲此生物：加{1}到你的法术力池中。」\', \'type\': \'生物～吸血鬼／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216220&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'97037af4-d3b3-4f9f-9cd3-ead873686842\', \'multiverseId\': 216220}, \'multiverseid\': 216220}]', '[{\'name\': \'Ulamogs Wegbereiter\', \'text\': \'Vernichter 3 (Immer wenn diese Kreatur angreift, opfert der verteidigende Spieler drei bleibende Karten.)\\nUlamogs Wegbereiter kann nicht geblockt werden, außer von drei oder mehr Kreaturen.\', \'type\': \'Kreatur — Eldrazi\', \'flavor\': \'Keine Gedanken außer an Hunger. Keine Strategie außer Zerstörung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217426&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cc040d6b-41a3-4fee-aeb5-23018b6da09f\', \'multiverseId\': 217426}, \'multiverseid\': 217426}, {\'name\': \'Arrasacaminos de Ulamog\', \'text\': \'Aniquilador 3. (Siempre que esta criatura ataque, el jugador defensor sacrifica tres permanentes.)\\nEl Arrasacaminos de Ulamog no puede ser bloqueado excepto por tres o más criaturas.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'No piensa, devora. No planea, destruye.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217178&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'baf39a44-1c0b-49e7-a984-677dca1f3040\', \'multiverseId\': 217178}, \'multiverseid\': 217178}, {\'name\': "Terrasseur d\'Ulamog", \'text\': "Annihilateur 3 (À chaque fois que cette créature attaque, le joueur défenseur sacrifie trois permanents.)\\nLe Terrasseur d\'Ulamog ne peut pas être bloqué excepté par trois créatures ou plus.", \'type\': \'Créature : eldrazi\', \'flavor\': \'La faim comme seule pensée. La destruction comme seule stratégie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215690&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d28fb7e9-6886-407a-893a-50d7ecde56c9\', \'multiverseId\': 215690}, \'multiverseid\': 215690}, {\'name\': \'Spianasentieri di Ulamog\', \'text\': \'Annientatore 3 (Ogniqualvolta questa creatura attacca, il giocatore in difesa sacrifica tre permanenti.)\\nLo Spianasentieri di Ulamog non può essere bloccato tranne che da tre o più creature.\', \'type\': \'Creatura — Eldrazi\', \'flavor\': \'Nessun pensiero, se non la fame. Nessuna strategia, se non la distruzione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216434&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad617988-5010-415b-bc7e-6c358dfaace5\', \'multiverseId\': 216434}, \'multiverseid\': 216434}, {\'name\': \'ウラモグの道滅ぼし\', \'text\': \'滅殺 ３ （このクリーチャーが攻撃するたび、防御プレイヤーはパーマネントを３つ生け贄に捧げる。）\\nウラモグの道滅ぼしは３体以上のクリーチャーによってしかブロックされない。\', \'type\': \'クリーチャー — エルドラージ\', \'flavor\': \'飢餓以外に思想無し。 破壊以外に戦略無し。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216682&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'93d24362-d72f-49bf-951c-838549f0d5d1\', \'multiverseId\': 216682}, \'multiverseid\': 216682}, {\'name\': \'Raspa-Trilha de Ulamog\', \'text\': \'Aniquilador 3 (Toda vez que esta criatura ataca, o jogador defensor sacrifica três permanentes.)\\nRaspa-Trilha de Ulamog só pode ser bloqueado por três ou mais criaturas.\', \'type\': \'Criatura — Eldrazi\', \'flavor\': \'Nenhum pensamento, só fome. Nenhuma estratégia, só destruição.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216930&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb32451e-5a66-4ec7-bac8-7e460851a274\', \'multiverseId\': 216930}, \'multiverseid\': 216930}, {\'name\': \'Прокладыватель Пути Уламога\', \'text\': \'Аннигилятор 3 (Каждый раз когда это существо атакует, защищающийся игрок приносит в жертву три перманента.)\\nПрокладыватель Пути Уламога не может быть заблокирован менее чем тремя существами.\', \'type\': \'Существо — Эльдрази\', \'flavor\': \'Одна лишь мысль — голод. Одна стратегия — разрушение.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215938&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'70cc489c-850e-4ef6-8fa3-2644fe0cef8a\', \'multiverseId\': 215938}, \'multiverseid\': 215938}, {\'name\': \'钨拉莫夷径者\', \'text\': \'歼灭3 （每当此生物攻击时，防御牌手牺牲三个永久物。）\\n钨拉莫夷径者只能被三个或更多生物阻挡。\', \'type\': \'生物～奥札奇\', \'flavor\': \'没有思想，只知饥渴。 没有计谋，只会破坏。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216186&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d52cb92f-74ad-4006-8348-d0f6ed693e04\', \'multiverseId\': 216186}, \'multiverseid\': 216186}]', "[{'name': 'Unerforschte Reiche', 'text': 'Durchsuche deine Bibliothek nach vier Ländern mit unterschiedlichen Namen und zeige sie offen vor. Ein Gegner bestimmt zwei dieser Karten. Lege die bestimmten Karten auf deinen Friedhof und nimm den Rest auf deine Hand. Mische danach deine Bibliothek.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217425&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3da5ec30-6abb-433f-b38e-cfc39c122cd5', 'multiverseId': 217425}, 'multiverseid': 217425}, {'name': 'Reinos no mapeados', 'text': 'Busca en tu biblioteca cuatro cartas de tierra con nombres distintos y muéstralas. Un oponente elige dos de esas cartas. Pon las cartas elegidas en tu cementerio y el resto en tu mano. Luego baraja tu biblioteca.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217177&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ec32efd8-c86d-4093-bc9a-3a5885be3a60', 'multiverseId': 217177}, 'multiverseid': 217177}, {'name': 'Royaumes inexplorés', 'text': 'Cherchez dans votre bibliothèque quatre cartes de terrain avec des noms différents et révélez-les. Un adversaire choisit deux de ces cartes. Mettez les cartes choisies dans votre cimetière et les autres dans votre main. Mélangez ensuite votre bibliothèque.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215689&type=card', 'language': 'French', 'identifiers': {'scryfallId': '234a3bd8-1bc5-4742-a70e-9e498404a577', 'multiverseId': 215689}, 'multiverseid': 215689}, {'name': 'Reami Mai Esplorati', 'text': 'Passa in rassegna il tuo grimorio per quattro carte terra con nomi diversi e rivelale. Un avversario sceglie due di quelle carte. Metti le carte scelte nel tuo cimitero e aggiungi le altre alla tua mano. Poi rimescola il tuo grimorio.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216433&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '00925966-777d-4a67-a831-9ade196ff624', 'multiverseId': 216433}, 'multiverseid': 216433}, {'name': '未知な領域', 'text': 'あなたのライブラリーから異なる名前の土地カードを４枚探し、それらを公開する。 いずれかの対戦相手は、それらのカードから２枚を選ぶ。 その選ばれたカードをあなたの墓地に置き、残りをあなたの手札に加える。 その後あなたのライブラリーを切り直す。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216681&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '24548ee2-7bc7-402a-b3be-2d6368432544', 'multiverseId': 216681}, 'multiverseid': 216681}, {'name': 'Reinos Inexplorados', 'text': 'Procure em seu grimório quatro cards de terreno com nomes diferentes e revele-os. Um oponente escolhe dois desses cards. Coloque os cards escolhidos no seu cemitério e o restante em sua mão. Depois, embaralhe seu grimório.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216929&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '79407471-293e-42a7-b204-53c97adec23c', 'multiverseId': 216929}, 'multiverseid': 216929}, {'name': 'Неисследованные Области', 'text': 'Найдите в вашей библиотеке четыре карты земель с разными именами и покажите их. Оппонент выбирает две из тех карт. Положите выбранные карты на ваше кладбище, а остальные — в вашу руку. Затем перетасуйте вашу библиотеку.', 'type': 'Мгновенное заклинание', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215937&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '200282ec-de5c-4610-9c58-33f25e455159', 'multiverseId': 215937}, 'multiverseid': 215937}, {'name': '未标注的地域', 'text': '从你的牌库中搜寻至多四张名称各不相同的地牌并展示之。 由任一对手选择其中两张牌。 将被选中的牌置入你的坟墓场，其余则置于你手上。 然后将你的牌库洗牌。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216185&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3dc8934f-e921-4656-b6ee-61686045bb01', 'multiverseId': 216185}, 'multiverseid': 216185}]", '[{\'name\': \'Ungeschoren davonkommen\', \'text\': \'Eine Kreatur deiner Wahl, die du kontrollierst, erhält bis zum Ende des Zuges Schutz vor einer Farbe, die du bestimmst.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217487&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'720c3cc6-7a05-467a-9346-e36ab8dc289b\', \'multiverseId\': 217487}, \'multiverseid\': 217487}, {\'name\': \'Emerger ileso\', \'text\': \'La criatura objetivo que controlas gana protección contra el color de tu elección hasta el final del turno.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217239&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cc1cfe7e-7561-4ab6-93ee-7f727cc5f20c\', \'multiverseId\': 217239}, \'multiverseid\': 217239}, {\'name\': \'Sans une égratignure\', \'text\': "La créature ciblée que vous contrôlez acquiert la protection contre la couleur de votre choix jusqu\'à la fin du tour.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215751&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'33b2f84f-3a6a-4dec-93cf-b56ac01b0565\', \'multiverseId\': 215751}, \'multiverseid\': 215751}, {\'name\': \'Emergere Incolume\', \'text\': "Una creatura bersaglio che controlli ha protezione da un colore a tua scelta fino alla fine del turno.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216495&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'808f2063-dd15-4008-8b58-98062a2eed60\', \'multiverseId\': 216495}, \'multiverseid\': 216495}, {\'name\': \'無傷の発現\', \'text\': \'あなたがコントロールするクリーチャー１体を対象とする。あなたは色を１色選ぶ。それはターン終了時までプロテクション（その選ばれた色）を得る。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216743&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc04f634-4980-462a-baa0-6b3819e42b98\', \'multiverseId\': 216743}, \'multiverseid\': 216743}, {\'name\': \'Emergir Ileso\', \'text\': \'A criatura alvo que você controla ganha proteção contra a cor de sua escolha até o final do turno.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216991&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0ff699d6-03ca-41f1-926c-808873dfeec4\', \'multiverseId\': 216991}, \'multiverseid\': 216991}, {\'name\': \'Выйти Невредимым\', \'text\': \'Целевое существо под вашим контролем получает Защиту от выбранного вами цвета до конца хода.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215999&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'14f31fd1-2ab0-42db-8813-ad6d1a1762a3\', \'multiverseId\': 215999}, \'multiverseid\': 215999}, {\'name\': \'挣脱困境\', \'text\': \'选择一种颜色，目标由你操控的生物获得反该色保护异能直到回合结束。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216247&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d7a4e61a-5fc7-4396-98ab-bb9992470fef\', \'multiverseId\': 216247}, \'multiverseid\': 216247}]', '[{\'name\': \'Unheilvolles Omen\', \'text\': \'Zu Beginn deines Endsegments kannst du die oberste Karte deiner Bibliothek offen vorzeigen. Falls du das tust, verliert jeder Gegner so viele Lebenspunkte, wie die umgewandelten Manakosten dieser Karte betragen.\', \'type\': \'Verzauberung\', \'flavor\': \'„Oh, es sieht wieder nicht gut für dich aus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217514&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0b26deea-9486-4b63-a421-f414f23e7315\', \'multiverseId\': 217514}, \'multiverseid\': 217514}, {\'name\': \'Presagio funesto\', \'text\': \'Al comienzo de tu paso final, puedes mostrar la primera carta de tu biblioteca. Si lo haces, cada oponente pierde una cantidad de vidas igual al coste de maná convertido de esa carta.\', \'type\': \'Encantamiento\', \'flavor\': \'"Ah, nuevamente la fortuna no te sonríe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217266&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f8aaec1-fee0-47fa-ac8f-7349fd2fbfbc\', \'multiverseId\': 217266}, \'multiverseid\': 217266}, {\'name\': \'Maudit augure\', \'text\': \'Au début de votre étape de fin, vous pouvez révéler la carte du dessus de votre bibliothèque. Si vous faites ainsi, chaque adversaire perd un nombre de points de vie égal au coût converti de mana de cette carte.\', \'type\': \'Enchantement\', \'flavor\': "« Ah, voilà encore qui n\'augure rien de bon pour vous. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215778&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5868b96-66bd-455b-bac1-fbce9cace576\', \'multiverseId\': 215778}, \'multiverseid\': 215778}, {\'name\': \'Presagio Malefico\', \'text\': "All\'inizio della tua sottofase finale, puoi rivelare la prima carta del tuo grimorio. Se lo fai, ogni avversario perde punti vita pari al costo di mana convertito di quella carta.", \'type\': \'Incantesimo\', \'flavor\': \'"Ah, non è certo di buon augurio per te."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216522&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'19980f46-13f8-4d5e-8129-624f8d6e7554\', \'multiverseId\': 216522}, \'multiverseid\': 216522}, {\'name\': \'有害な前兆\', \'text\': \'あなたの終了ステップの開始時に、あなたはあなたのライブラリーの一番上のカードを公開してもよい。 そうした場合、各対戦相手はそれぞれそのカードの点数で見たマナ・コストに等しい点数のライフを失う。\', \'type\': \'エンチャント\', \'flavor\': \'「ああ、これもお前には悪い前兆だ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216770&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'010dabdb-3b5f-4890-97cb-a1a3455e9e42\', \'multiverseId\': 216770}, \'multiverseid\': 216770}, {\'name\': \'Presságio Nefasto\', \'text\': \'No início de sua etapa final, você pode revelar o card do topo do seu grimório. Se fizer isso, cada oponente perde uma quantidade de pontos de vida igual ao custo de mana convertido daquele card.\', \'type\': \'Encantamento\', \'flavor\': \'"Ah, mais uma vez isso não é de bom agouro para você."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217018&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3a3a6916-2eb6-40b3-bb1f-fe1b8f257477\', \'multiverseId\': 217018}, \'multiverseid\': 217018}, {\'name\': \'Пагубный Знак\', \'text\': \'В начале вашего заключительного шага вы можете показать верхнюю карту вашей библиотеки. Если вы это делаете, каждый оппонент теряет количество жизней, равное конвертированной мана-стоимости той карты.\', \'type\': \'Чары\', \'flavor\': \'«Увы, вас снова не ждет ничего хорошего».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216026&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e692e0c0-cde8-4bc1-a1e0-acaa8bd2722f\', \'multiverseId\': 216026}, \'multiverseid\': 216026}, {\'name\': \'有害预兆\', \'text\': \'在你的结束步骤开始时，你可以展示你的牌库顶牌。 若你如此作，每位对手各失去与该牌之总法术力费用等量的生命。\', \'type\': \'结界\', \'flavor\': \'「啊，它又不给你好兆头了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216274&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1650aef9-0fc1-4f1c-8b83-33c7a455d677\', \'multiverseId\': 216274}, \'multiverseid\': 216274}]', '[{\'name\': \'Unsterblicher Engel\', \'text\': \'Fliegend\\n{W}{W}: Eine Kreatur deiner Wahl ist in diesem Zug unzerstörbar.\', \'type\': \'Kreatur — Engel\', \'flavor\': \'„Ich hätte an diesem Tag sterben müssen, habe aber noch nicht einmal einen Kratzer abbekommen. Ich erwachte in einer Blutlache, doch sie stammte nicht von mir." —Die Kriegstagebücher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217440&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'77298224-7440-4d1a-a7dc-414168956bd7\', \'multiverseId\': 217440}, \'multiverseid\': 217440}, {\'name\': \'Ángel inmortal\', \'text\': \'Vuela.\\n{W}{W}: La criatura objetivo es indestructible este turno.\', \'type\': \'Criatura — Ángel\', \'flavor\': \'"Debería haber muerto ese día, pero no sufrí ni un rasguño. Desperté en un lago de sangre, pero no era mía." —Los diarios de guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217192&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3bda2a62-a467-41d3-ab0c-79a94cc46cbf\', \'multiverseId\': 217192}, \'multiverseid\': 217192}, {\'name\': \'Ange faucheur de mort\', \'text\': \'Vol\\n{W}{W} : La créature ciblée est indestructible ce tour-ci.\', \'type\': \'Créature : ange\', \'flavor\': "« J\'aurais dû périr ce jour-là, mais je n\'ai pas reçu une égratignure. Je me suis éveillée dans une mare de sang, mais visiblement pas le mien. » —Les journaux de la Guerre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215704&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbfb8f90-d9ca-4e4e-93ee-42c5f39931fd\', \'multiverseId\': 215704}, \'multiverseid\': 215704}, {\'name\': \'Angelo Immortale\', \'text\': \'Volare\\n{W}{W}: Una creatura bersaglio è indistruttibile in questo turno.\', \'type\': \'Creatura — Angelo\', \'flavor\': \'"Sarei dovuta morire quel giorno, ma non mi sono fatta neanche un graffio. Mi sono svegliata in un lago di sangue, apparentemente non mio." —I Diari di Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216448&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bcafdee4-727e-4ef0-bf94-7a3681a5f6ca\', \'multiverseId\': 216448}, \'multiverseid\': 216448}, {\'name\': \'不死の天使\', \'text\': \'飛行\\n{W}{W}：クリーチャー１体を対象とする。このターン、それは破壊されない。\', \'type\': \'クリーチャー — 天使\', \'flavor\': \'「あの時私は死すべきだったが、かすり傷一つ負ってはいなかった。 私が目覚めたのは血の海の中で、それはあきらかに自分の物ではなかった。」 ――「戦争日誌」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216696&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'21884d55-2f8e-4694-9a7f-72f5f4d4dc03\', \'multiverseId\': 216696}, \'multiverseid\': 216696}, {\'name\': \'Anjo Imortal\', \'text\': \'Voar\\n{W}{W}: A criatura alvo é indestrutível nesse turno.\', \'type\': \'Criatura — Anjo\', \'flavor\': \'"Eu poderia ter morrido naquele dia, mas não sofri nem um arranhão. Acordei num lago de sangue, mas não era o meu." — Os Diários da Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216944&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'431f33a4-3eb5-404f-9ac8-a5b79669c37c\', \'multiverseId\': 216944}, \'multiverseid\': 216944}, {\'name\': \'Бессмертный Ангел\', \'text\': \'Полет\\n{W}{W}: целевое существо не может быть уничтожено в этом ходу.\', \'type\': \'Существо — Ангел\', \'flavor\': \'«В тот день я должен был погибнуть, но не получил ни царапины. Я проснулся в озере крови, но, судя по всему, чужой». — Дневники войны\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215952&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'95be508b-ba77-4a28-9cf8-74634bdf1965\', \'multiverseId\': 215952}, \'multiverseid\': 215952}, {\'name\': \'不亡天使\', \'text\': \'飞行\\n{W}{W}：目标生物本回合中不会毁坏。\', \'type\': \'生物～天使\', \'flavor\': \'「我原本该在那天丧命的，但却全身而退。 我醒来时躺在血泊坑中，且明显地没有一滴属于我。」 ～《战场札记》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216200&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'61b3a8f0-a5ad-4ea5-8ae7-c7f51573c51f\', \'multiverseId\': 216200}, \'multiverseid\': 216200}]', '[{\'name\': \'Unverzagte Schildträger\', \'text\': \'Verteidiger\\nAndere Kreaturen mit Verteidiger, die du kontrollierst, erhalten +0/+2.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'„Haltet die Stellung! Entweder halten wir sie hier auf, oder wir treffen uns gleich in ihrem Magen wieder!" —Tala Vertan, Makindi-Schildbruder\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217375&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7cf4f0a8-3653-4e96-9547-b3626f6fab8d\', \'multiverseId\': 217375}, \'multiverseid\': 217375}, {\'name\': \'Porta escudos denodados\', \'text\': \'Defensor.\\nLas otras criaturas que controlas con la habilidad de defensor obtienen +0/+2.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'"¡Resistan! ¡O los detenemos aquí o despertamos en sus vientres!" —Tala Vertan, escudante de Makindi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217127&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e79ad7b9-4d00-4d6d-9505-cfe73a7ec108\', \'multiverseId\': 217127}, \'multiverseid\': 217127}, {\'name\': \'Vaillants porteurs de bouclier\', \'text\': \'Défenseur\\nLes autres créatures avec le défenseur que vous contrôlez gagnent +0/+2.\', \'type\': \'Créature : humain et soldat\', \'flavor\': \'« Tenez la position ! Ou nous les arrêtons ici, ou nous nous réveillerons dans leurs ventres ! » —Tala Vertan, compagnon bouclier des Makindi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215639&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3cd367ed-3e6a-4299-b70e-4af3704c0e73\', \'multiverseId\': 215639}, \'multiverseid\': 215639}, {\'name\': \'Portatori di Scudo Risoluti\', \'text\': \'Difensore\\nLe altre creature con difensore che controlli prendono +0/+2.\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'"Mantenete le fila! O li fermiamo qui o ci risveglieremo nella loro pancia!" —Tala Vertan, scutifero di Makindi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216383&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9885313d-b3b5-4796-ab81-0b18999b574e\', \'multiverseId\': 216383}, \'multiverseid\': 216383}, {\'name\': \'断固たる盾持ち\', \'text\': \'防衛\\nあなたがコントロールする他の防衛を持つクリーチャーは＋０/＋２の修整を受ける。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'「戦線をしっかり保て！ ここで止められなきゃ、目覚めたら腹の中だぞ！」 ――マキンディの盾の仲間、タラ・ヴェルタン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216631&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c5deb97-f095-4a04-8bc2-8b20f90fef6d\', \'multiverseId\': 216631}, \'multiverseid\': 216631}, {\'name\': \'Escudeiros Robustos\', \'text\': \'Defensor\\nAs outras criaturas que você controla com defensor recebem +0/+2.\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': \'"Mantenham-se em formação! Ou os detemos aqui ou acordamos dentro de seus estômagos!" — Tala Vertan, escudeiro de Makindi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216879&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'728bf102-2240-4419-8cbf-715e977346cd\', \'multiverseId\': 216879}, \'multiverseid\': 216879}, {\'name\': \'Стойкие Щитоносцы\', \'text\': \'Защитник\\nДругие существа под вашим контролем со способностью Защитника получают +0/+2.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'«Держать оборону! Либо мы остановим их здесь, либо мы очнемся у них в желудках!» — Тала Вертан, заступник из Макинди\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215887&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3362bee6-1fc9-4b7b-b116-a09272e5b1dc\', \'multiverseId\': 215887}, \'multiverseid\': 215887}, {\'name\': \'精壮执盾手\', \'text\': \'守军\\n由你操控且具守军异能的其他生物得+0/+2。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'「坚守防线！ 如果不在此将它们挡下，就等着给它们吞掉！」 ～马钦迪护盾手塔勒沃顿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216135&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9604279-d78d-433c-a8a1-05bc78a79416\', \'multiverseId\': 216135}, \'multiverseid\': 216135}]', '[{\'name\': \'Unwiderstehliche Beute\', \'text\': \'Eine Kreatur deiner Wahl muss in diesem Zug geblockt werden, falls möglich.\\nZiehe eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'Die Instinkte des Baloths brodelten, seine Muskeln spannten sich, die Stacheln auf seinem Rücken stellten sich auf, und als er sich umdrehte, sah er — einen kümmerlichen Zwerg.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217377&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b3314a59-223d-463e-a0c5-41d97afcf575\', \'multiverseId\': 217377}, \'multiverseid\': 217377}, {\'name\': \'Presa irresistible\', \'text\': \'La criatura objetivo debe ser bloqueada este turno si se puede.\\nRoba una carta.\', \'type\': \'Conjuro\', \'flavor\': \'Los instintos del báloth se dispararon, sus músculos se tensaron y su cresta se alzó mientras se giraba para enfrentarse a un... miplin diminuto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217129&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'19ef720a-e014-4210-bbba-ed8ac2d7446f\', \'multiverseId\': 217129}, \'multiverseid\': 217129}, {\'name\': \'Proie irrésistible\', \'text\': \'La créature ciblée doit être bloquée ce tour-ci si possible.\\nPiochez une carte.\', \'type\': \'Rituel\', \'flavor\': \'Le baloth frémissait, ses instincts en éveil, ses muscles tendus, ses épines tranchantes dressées. Et il se retourna pour affronter — un tout petit grêlebionte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215641&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e10a39d-b3a8-49a6-9d2c-3a847ee5a56e\', \'multiverseId\': 215641}, \'multiverseid\': 215641}, {\'name\': \'Preda Irresistibile\', \'text\': \'Una creatura bersaglio deve essere bloccata in questo turno, se possibile.\\nPesca una carta.\', \'type\': \'Stregoneria\', \'flavor\': "L\'istinto del baloth ribollì, i muscoli si tesero allo spasimo e i dorsali affilati si rizzarono, quando si volse a guardare... un minuscolo meepling.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216385&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'15c24d97-b33d-4f62-85c1-ea4cebbd12ef\', \'multiverseId\': 216385}, \'multiverseid\': 216385}, {\'name\': \'抑え難い餌食\', \'text\': \'クリーチャー１体を対象とする。このターン、それは可能ならブロックしなければいけない。\\nカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'ベイロスの本能は燃え上がり、筋肉は張り詰め、刃の背は逆立った。彼の目の前にいたのは――小さな餌食だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216633&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c8bd83e-0d88-4752-8046-bff1a6fe2e57\', \'multiverseId\': 216633}, \'multiverseid\': 216633}, {\'name\': \'Presa Irresistível\', \'text\': \'A criatura alvo deve ser bloqueada neste turno se estiver apta.\\nCompre um card.\', \'type\': \'Feitiço\', \'flavor\': \'Os instintos do baloth fervilharam, seus músculos tensionaram-se e suas espinhas pontiagudas eriçaram-se conforme ele virou para se deparar com — um desprezível meepling.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216881&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35712f6c-c351-4271-a25a-9b4a54ca10e4\', \'multiverseId\': 216881}, \'multiverseid\': 216881}, {\'name\': \'Лакомая Добыча\', \'text\': \'Целевое существо должно быть заблокировано в этом ходу, если это возможно.\\nВозьмите карту.\', \'type\': \'Волшебство\', \'flavor\': \'Инстинкты балота закипели, мускулы натянулись, а шипы на хребте встали дыбом. Он повернулся и увидел перед собой... карликового миплинга.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215889&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ee33345-0c39-4f9f-8f3a-4f783194d551\', \'multiverseId\': 215889}, \'multiverseid\': 215889}, {\'name\': \'诱人猎物\', \'text\': \'目标生物本回合若能被阻挡，则须如此作。\\n抓一张牌。\', \'type\': \'法术\', \'flavor\': \'那巴洛西的本能沸腾，肌肉暴张，尖锐骨板立起，转身面对的～却是一个鬼吼鬼叫的小家伙。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216137&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6eb9cbb0-b903-4b4d-9523-e456225a0cb3\', \'multiverseId\': 216137}, \'multiverseid\': 216137}]', '[{\'name\': \'Uralte Regungen\', \'text\': \'Schau dir die obersten fünf Karten deiner Bibliothek an. Du kannst eine farblose Karte darunter offen vorzeigen und sie auf deine Hand nehmen. Lege dann den Rest in beliebiger Reihenfolge unter deine Bibliothek. (Karten ohne farbiges Mana in ihren Manakosten sind farblos. Länder sind ebenfalls farblos.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217313&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6d3d4999-5f8b-451e-9714-6637134e2a24\', \'multiverseId\': 217313}, \'multiverseid\': 217313}, {\'name\': \'Agitamiento antiguo\', \'text\': \'Mira las primeras cinco cartas de tu biblioteca. Puedes mostrar una carta incolora que se encuentre entre ellas y ponerla en tu mano. Luego pon el resto en el fondo de tu biblioteca en cualquier orden. (Las cartas sin coste de maná de color en sus costes de maná son incoloras. Las tierras también son incoloras.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217065&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c6e7758-71aa-488a-80c3-43cfa3cd061f\', \'multiverseId\': 217065}, \'multiverseid\': 217065}, {\'name\': \'Anciens frémissements\', \'text\': "Regardez les cinq cartes du dessus de votre bibliothèque. Vous pouvez révéler une carte incolore parmi elles et la mettre dans votre main. Mettez ensuite le reste au-dessous de votre bibliothèque, dans n\'importe quel ordre. (Les cartes qui n\'ont pas de mana coloré dans leurs coûts de mana sont incolores. Les terrains sont aussi incolores.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215577&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2a5b4da3-54c4-4443-a9fb-702c2708ffa1\', \'multiverseId\': 215577}, \'multiverseid\': 215577}, {\'name\': \'Antichi Fermenti\', \'text\': \'Guarda le prime cinque carte del tuo grimorio. Puoi rivelare una carta incolore tra esse e aggiungerla alla tua mano. Poi metti le altre in fondo al tuo grimorio in qualsiasi ordine. (Le carte che non hanno mana colorato nel costo di mana sono incolori. Anche le terre sono incolori.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216321&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f4f8d6db-0a50-473a-9c6b-f33affdaff20\', \'multiverseId\': 216321}, \'multiverseid\': 216321}, {\'name\': \'古きものの活性\', \'text\': \'あなたのライブラリーの一番上から５枚のカードを見る。 あなたはその中の無色のカードを１枚公開してあなたの手札に加えてもよい。 その後、残りをあなたのライブラリーの一番下に望む順番で置く。 （マナ・コストに色マナが無いカードは無色である。 土地も無色である。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216569&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7dfa5b04-feed-4847-ad95-68e58593d4f2\', \'multiverseId\': 216569}, \'multiverseid\': 216569}, {\'name\': \'Agitações do Passado\', \'text\': \'Olhe os cinco cards do topo de seu grimório. Você pode revelar um card incolor dentre eles e colocá-lo em sua mão. Coloque o resto no fundo de seu grimório em qualquer ordem. (Os cards sem mana colorido em seu custo de mana são incolores. Os terrenos também são incolores.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f15ecf98-e4ce-4d03-9ddd-bd79c6c2e742\', \'multiverseId\': 216817}, \'multiverseid\': 216817}, {\'name\': \'Древние Шевеления\', \'text\': \'Посмотрите пять верхних карт вашей библиотеки. Вы можете показать находящуюся среди них бесцветную карту и положить ее в вашу руку. Затем положите остальные карты в низ вашей библиотеки в любом порядке. (Карты, в мана-стоимости которых нет цветной маны, являются бесцветными. Земли тоже бесцветны.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215825&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ef73ba49-c0bb-46f6-9f28-d3624b3e2228\', \'multiverseId\': 215825}, \'multiverseid\': 215825}, {\'name\': \'唤醒古物\', \'text\': \'检视你牌库顶的五张牌。 你可以展示其中的一张无色牌，并将其置于你手上。 然后将其余的牌以任意顺序置于你牌库底。 （法术力费用中不包含有色法术力符号的牌，便是无色。 地也是无色。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c60e6e2a-f99a-4989-9137-ea3cc3a30f32\', \'multiverseId\': 216073}, \'multiverseid\': 216073}]', '[{\'name\': \'Valakut-Feuerkeiler\', \'text\': \'Immer wenn der Valakut-Feuerkeiler angreift, vertausche seine Stärke und Widerstandskraft bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen, Wildschwein\', \'flavor\': \'„Bewege dich ganz vorsichtig, und bei Ulas Liebe, mach ihn nicht wild." —Chadir der Navigator\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217395&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86d366fd-ea2a-4a18-abcc-bf940a1ff15c\', \'multiverseId\': 217395}, \'multiverseid\': 217395}, {\'name\': \'Jabalí ígneo de Valakut\', \'text\': \'Siempre que el Jabalí ígneo de Valakut ataque, intercambia su fuerza y resistencia hasta el final del turno.\', \'type\': \'Criatura — Jabalí elemental\', \'flavor\': \'"Ahora muévete muy lentamente y, por el amor de Ula, no lo provoques." —Chadir el navegante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217147&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e163a262-f317-4c20-b73d-78b31218e9a9\', \'multiverseId\': 217147}, \'multiverseid\': 217147}, {\'name\': \'Sanglier de feu de Valakut\', \'text\': "À chaque fois que le Sanglier de feu de Valakut attaque, échangez sa force et son endurance jusqu\'à la fin du tour.", \'type\': \'Créature : élémental et sanglier\', \'flavor\': "« Avancez très lentement, et pour l\'amour d\'Ula, ne l\'énervez pas. » —Chadir le navigateur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215659&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d40738f-2bc8-49e2-a5f1-1409c09d1344\', \'multiverseId\': 215659}, \'multiverseid\': 215659}, {\'name\': \'Cinghiale Infuocato di Valakut\', \'text\': \'Ogniqualvolta il Cinghiale Infuocato di Valakut attacca, scambia la sua forza e la sua costituzione fino alla fine del turno.\', \'type\': \'Creatura — Cinghiale Elementale\', \'flavor\': \'"Muoviti lentamente e, per l\\\'amore di Ula, non innervosirlo." —Chadir il Navigatore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216403&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7735673-0df5-4ca5-a947-899b6a75f9df\', \'multiverseId\': 216403}, \'multiverseid\': 216403}, {\'name\': \'ヴァラクートの火猪\', \'text\': \'ヴァラクートの火猪が攻撃するたび、ターン終了時までそれのパワーとタフネスを入れ替える。\', \'type\': \'クリーチャー — エレメンタル・猪\', \'flavor\': \'「ゆっくりと動くんだよ、それからウーラのご加護で、怒らせちゃいけない。」 ――航海士シャーディア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216651&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b19e3ad6-26d9-4f4c-ad34-38a769b19008\', \'multiverseId\': 216651}, \'multiverseid\': 216651}, {\'name\': \'Javali de Fogo de Valakut\', \'text\': \'Toda vez que Javali de Fogo de Valakut atacar, permute seu poder pela sua resistência, e vice-versa, até o final do turno.\', \'type\': \'Criatura — Elemental Javali\', \'flavor\': \'"Apenas se mova bem lentamente, e pelo amor de Ula, não o irrite." — Chadir, o Navegador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216899&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'744f8442-5fff-4def-83e3-c1dff4fca159\', \'multiverseId\': 216899}, \'multiverseid\': 216899}, {\'name\': \'Огненный Вепрь Валакута\', \'text\': \'Каждый раз когда Огненный Вепрь Валакута атакует, переставьте местами значения его силы и выносливости до конца хода.\', \'type\': \'Существо — Элементаль Вепрь\', \'flavor\': \'«Двигайся очень-очень медленно, и, ради Улы, не зли его!» — Чадир-Штурман\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215907&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7426271e-fe95-4612-8568-fa888d8e37bd\', \'multiverseId\': 215907}, \'multiverseid\': 215907}, {\'name\': \'瓦拉库火猪\', \'text\': \'每当瓦拉库火猪攻击时，将其力量与防御力互换直到回合结束。\', \'type\': \'生物～元素／野猪\', \'flavor\': \'「把动作放到最轻，而且看在钨拉的份上，别把他给惹火。」 ～领航者洽迪\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216155&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2be15b04-7dfc-485f-bdf0-321ba928b300\', \'multiverseId\': 216155}, \'multiverseid\': 216155}]', '[{\'name\': \'Vendetta\', \'text\': \'Zerstöre eine nichtschwarze Kreatur deiner Wahl. Sie kann nicht regeneriert werden. Du verlierst Lebenspunkte in Höhe der Widerstandskraft dieser Kreatur.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Du kannst meine Schuld deiner Sippe gegenüber als abgetragen betrachten." —Idrol, Meuchler aus Guul Draz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217469&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'413eaa7a-8e84-4872-99fd-2a330e7f545c\', \'multiverseId\': 217469}, \'multiverseid\': 217469}, {\'name\': \'Vendetta\', \'text\': \'Destruye la criatura objetivo que no sea negra. No puede ser regenerada. Pierdes una cantidad de vidas igual a la resistencia de esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'"Considera mi deuda con los tuyos pagada." —Idrol, asesino de Guul Draz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217221&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f0167467-926e-406e-b385-217530638dd8\', \'multiverseId\': 217221}, \'multiverseid\': 217221}, {\'name\': \'Vendetta\', \'text\': "Détruisez la créature non-noire ciblée. Elle ne peut pas être régénérée. Vous perdez un nombre de points de vie égal à l\'endurance de cette créature.", \'type\': \'Éphémère\', \'flavor\': \'« Considérez ma dette envers les vôtres comme étant payée. » —Idrol, Assassin de Guul Draz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215733&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'714a499c-5592-41e5-a352-bd21a370d2c6\', \'multiverseId\': 215733}, \'multiverseid\': 215733}, {\'name\': \'Rivincita\', \'text\': \'Distruggi una creatura non nera bersaglio. Non può essere rigenerata. Perdi punti vita pari alla costituzione di quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': \'"Considera il mio debito alla tua stirpe ripagato in pieno." —Idrol, assassino di Guul Draz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216477&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8e6e0e80-c5fe-45af-a94f-cad8071696ff\', \'multiverseId\': 216477}, \'multiverseid\': 216477}, {\'name\': \'血の復讐\', \'text\': \'黒でないクリーチャー１体を対象とし、それを破壊する。 それは再生できない。 あなたはそのクリーチャーのタフネスに等しい点数のライフを失う。\', \'type\': \'インスタント\', \'flavor\': \'「お前の仲間への貸しはこれで終了ってことだ。」 ――グール・ドラズの暗殺者、アイドロル\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216725&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'27144ef4-aebc-41f2-87cc-0ba16645b3b3\', \'multiverseId\': 216725}, \'multiverseid\': 216725}, {\'name\': \'Vendeta\', \'text\': \'Destrua a criatura alvo que não seja preta. Ela não pode ser regenerada. Você perde uma quantidade de pontos de vida igual à resistência daquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Considere minha dívida com o seu povo totalmente paga." — Idrol, assassino de Guul Draz\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216973&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'42f9e5bd-c323-431e-a4ed-a16cf65a8547\', \'multiverseId\': 216973}, \'multiverseid\': 216973}, {\'name\': \'Вендетта\', \'text\': \'Уничтожьте целевое нечерное существо. Оно не может быть регенерировано. Вы теряете количество жизней, равное выносливости того существа.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Считай, что я сполна вернул мой долг твоим сородичам». — Айдрол, убийца из Гуул-Драза\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215981&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'acbe17cd-2e9e-4cbd-9b84-2786f0e07eb1\', \'multiverseId\': 215981}, \'multiverseid\': 215981}, {\'name\': \'血仇\', \'text\': \'消灭目标非黑色的生物。 它不能重生。 你失去等同于该生物防御力的生命。\', \'type\': \'瞬间\', \'flavor\': \'「就当作我欠你亲戚的债一笔勾销。」 ～古坠兹杀手艾卓\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216229&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bc0eb930-b3e9-4bba-a9d7-666b3fb19e12\', \'multiverseId\': 216229}, \'multiverseid\': 216229}]', '[{\'name\': \'Vereinter Wille\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, falls du mehr Kreaturen als der Beherrscher jenes Zauberspruchs kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wir sind froh, zu Diensten zu sein: bei deinem Versagen Zuhörer zu sein." —Maizah Shere, Ruhezauberer aus Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217328&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd905e82-2e2e-4a42-b65c-6d595588a0bc\', \'multiverseId\': 217328}, \'multiverseid\': 217328}, {\'name\': \'Voluntad unificada\', \'text\': \'Contrarresta el hechizo objetivo si controlas más criaturas que el controlador de ese hechizo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Es un placer servir de algo... De espectador de tu fracaso." —Maizah Shere, mago arrullador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217080&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e3ff0eb0-7d70-4565-807a-70671d5b97b7\', \'multiverseId\': 217080}, \'multiverseid\': 217080}, {\'name\': \'Volonté unifiée\', \'text\': \'Contrecarrez le sort ciblé si vous contrôlez plus de créatures que le contrôleur de ce sort.\', \'type\': \'Éphémère\', \'flavor\': \'« Nous sommes heureux de vous rendre service — comme témoins de votre échec. » —Maizah Shere, ataraxmage de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215592&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e537db33-f346-4ddd-85dd-ab1088e090f3\', \'multiverseId\': 215592}, \'multiverseid\': 215592}, {\'name\': \'Volontà Unificata\', \'text\': \'Neutralizza una magia bersaglio se controlli più creature del controllore di quella magia.\', \'type\': \'Istantaneo\', \'flavor\': \'"Siamo contenti di essere utili... di essere gli spettatori del tuo fallimento." —Maizah Shere, mitigatore di Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216336&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b13399e7-9059-473c-b8e3-d9f29b7b6fcf\', \'multiverseId\': 216336}, \'multiverseid\': 216336}, {\'name\': \'統一された意思\', \'text\': \'呪文１つを対象とする。あなたがその呪文のコントローラーよりも多くのクリーチャーをコントロールしている場合、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「役に立てて嬉しいよ――お前の失敗を見届ける役だがな。」 ――タジームの凪魔道士、メイザー・シェア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216584&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce90d161-74fe-4354-87b6-28ad48b14ed2\', \'multiverseId\': 216584}, \'multiverseid\': 216584}, {\'name\': \'Desejo Unificado\', \'text\': \'Anule a mágica alvo se você controlar mais criaturas do que o controlador daquela mágica.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Estamos felizes de poder ajudar — como plateia do seu fracasso." — Maizah Shere, Mago Anulador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216832&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'08848d72-6871-4d8f-b1e1-eeeca9a73bd6\', \'multiverseId\': 216832}, \'multiverseid\': 216832}, {\'name\': \'Объединенная Воля\', \'text\': \'Отмените целевое заклинание, если вы контролируете больше существ, чем игрок, контролирующий то заклинание.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мы рады сослужить вам службу — стать свидетелями вашего поражения». — Майза Шер, маг-баюн из Тазима\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215840&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2a1d2273-3147-404a-a4e8-eedb4743e9a7\', \'multiverseId\': 215840}, \'multiverseid\': 215840}, {\'name\': \'齐心一致\', \'text\': \'如果由你操控的生物数量多于该咒语操控者的，则反击目标咒语。\', \'type\': \'瞬间\', \'flavor\': \'「我们乐意为您效劳～替您的失败作见证。」 ～塔晋息法师麦札席尔\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216088&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a550dab6-bdf5-4f94-995b-746774b7a035\', \'multiverseId\': 216088}, \'multiverseid\': 216088}]', '[{\'name\': \'Verendender Gedanke\', \'text\': \'Ein Spieler deiner Wahl zeigt die Karten auf seiner Hand offen vor. Du bestimmst eine Karte darunter. Dieser Spieler mischt diese Karte in seine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': \'Er entfernte nur eine Idee aus ihren Gedanken: Widerstand.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217464&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e814a8e6-6d90-473b-b35d-83a4ddffc43e\', \'multiverseId\': 217464}, \'multiverseid\': 217464}, {\'name\': \'Ni pensarlo\', \'text\': \'El oponente objetivo muestra su mano. Tú eliges de ahí una carta. Ese jugador baraja esa carta en su biblioteca.\', \'type\': \'Conjuro\', \'flavor\': \'Eliminó una sola idea de su mente: la resistencia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217216&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2116844-9751-4fc3-8eb4-86c4ed65abac\', \'multiverseId\': 217216}, \'multiverseid\': 217216}, {\'name\': "N\'y pensez même pas !", \'text\': "L\'adversaire ciblé révèle sa main. Vous y choisissez une carte. Ce joueur mélange cette carte à sa bibliothèque.", \'type\': \'Rituel\', \'flavor\': \'Il lui ôta une seule idée de la tête : la défiance.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215728&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'11e7b843-5a8e-4f18-8d17-f18cb282e209\', \'multiverseId\': 215728}, \'multiverseid\': 215728}, {\'name\': \'Neanche a Pensarci!\', \'text\': \'Un avversario bersaglio rivela la sua mano. Scegli una carta da quella mano. Quel giocatore rimescola quella carta nel suo grimorio.\', \'type\': \'Stregoneria\', \'flavor\': "Rimosse solo un\'idea dalla sua mente: sfida.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216472&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'28907e97-d3ee-4c9a-b609-dd418dd49805\', \'multiverseId\': 216472}, \'multiverseid\': 216472}, {\'name\': \'思考の消滅\', \'text\': \'対戦相手１人を対象とする。そのプレイヤーは自分の手札を公開する。 あなたはその中からカードを１枚選ぶ。 そのプレイヤーは、そのカードを自分のライブラリーに加えて切り直す。\', \'type\': \'ソーサリー\', \'flavor\': \'それは彼女の精神からたった一つの考えを取り除いた。反抗心だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216720&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'67c14134-1f82-462b-ac38-7e3a52900c9e\', \'multiverseId\': 216720}, \'multiverseid\': 216720}, {\'name\': \'Nem Pense Nisso\', \'text\': \'O oponente alvo revela sua própria mão. Você escolhe um card dela. Depois, aquele jogador embaralha aquele card em seu próprio grimório.\', \'type\': \'Feitiço\', \'flavor\': \'Ele removeu apenas uma ideia da mente dela: resistência.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216968&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e96bef87-d80e-4a33-af02-13231e7e6066\', \'multiverseId\': 216968}, \'multiverseid\': 216968}, {\'name\': \'Выкинуть из Головы\', \'text\': \'Целевой оппонент показывает свою руку. Вы выбираете из нее карту. Тот игрок втасовывает ту карту в свою библиотеку.\', \'type\': \'Волшебство\', \'flavor\': \'Он удалил из ее разума лишь одну мысль: о сопротивлении.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215976&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b30f97a5-af07-4c06-bee9-bffe3d93ea89\', \'multiverseId\': 215976}, \'multiverseid\': 215976}, {\'name\': \'打住念头\', \'text\': \'目标对手展示其手牌。 你选择其中一张牌。 该牌手将该牌洗入其牌库。\', \'type\': \'法术\', \'flavor\': \'它只从她心灵中移除一个想法：反抗。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216224&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e8ed339-7f7a-498e-9a43-bfe4d1f975a4\', \'multiverseId\': 216224}, \'multiverseid\': 216224}]', '[{\'name\': \'Verräterischer Instinkt\', \'text\': \'Übernimm die Kontrolle über eine Kreatur deiner Wahl bis zum Ende des Zuges. Enttappe diese Kreatur. Bis zum Ende des Zuges erhält sie +2/+0 und hat Eile.\', \'type\': \'Hexerei\', \'flavor\': \'Der Schrecken schlingerte hin und her wie eine Marionette aus einem Albtraum eines Wahnsinnigen und quetschte seinen Brüdern das Leben aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'86a0ab12-ab16-478b-a7b0-c7c74feb91fc\', \'multiverseId\': 217505}, \'multiverseid\': 217505}, {\'name\': \'Instinto traicionero\', \'text\': \'Gana el control de la criatura objetivo hasta el final del turno. Endereza esa criatura. Hasta el final del turno, obtiene +2/+0 y gana la habilidad de prisa.\', \'type\': \'Conjuro\', \'flavor\': \'La abominación se retorció como una marioneta de la pesadilla de un loco, extrayendo la vida de los suyos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217257&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82d8494e-2377-4cd5-b805-c846a18698a2\', \'multiverseId\': 217257}, \'multiverseid\': 217257}, {\'name\': \'Instinct perfide\', \'text\': "Acquérez le contrôle de la créature ciblée jusqu\'à la fin du tour. Dégagez cette créature. Jusqu\'à la fin du tour, elle gagne +2/+0 et elle acquiert la célérité.", \'type\': \'Rituel\', \'flavor\': "L\'horreur titubait comme une marionnette née du cauchemar d\'un fou, écrasant ses semblables.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215769&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5c7fe0de-a1d9-4135-8cb0-92d07ee315cf\', \'multiverseId\': 215769}, \'multiverseid\': 215769}, {\'name\': \'Istinto Traditore\', \'text\': \'Prendi il controllo di una creatura bersaglio fino alla fine del turno. STAPpa quella creatura. Fino alla fine del turno, prende +2/+0 e ha rapidità.\', \'type\': \'Stregoneria\', \'flavor\': "L\'orrore barcollava come un burattino dall\'incubo di un folle, spremendo la vita dai suoi simili.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216513&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87b9a705-3c02-44c3-b747-7299081579df\', \'multiverseId\': 216513}, \'multiverseid\': 216513}, {\'name\': \'裏切りの本能\', \'text\': \'クリーチャー１体を対象とし、ターン終了時までそれのコントロールを得る。 そのクリーチャーをアンタップする。 ターン終了時まで、それは＋２/＋０の修整を受けるとともに速攻を得る。\', \'type\': \'ソーサリー\', \'flavor\': \'魔物は狂人の悪夢から生まれた傀儡のように襲い掛かり、仲間から生命を吸い取る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216761&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2fbcbd71-73c8-4800-a2d2-1d32dca701a2\', \'multiverseId\': 216761}, \'multiverseid\': 216761}, {\'name\': \'Instinto Traidor\', \'text\': \'Ganhe o controle da criatura alvo até o final do turno. Desvire aquela criatura. Até o final do turno, ela recebe +2/+0 e ganha ímpeto.\', \'type\': \'Feitiço\', \'flavor\': \'O horror vagava como uma marionete de um pesadelo insano, extraindo a vida de seus próprios semelhantes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217009&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'44f70695-f549-4517-b627-81907eed529e\', \'multiverseId\': 217009}, \'multiverseid\': 217009}, {\'name\': \'Предательский Инстинкт\', \'text\': \'Получите контроль над целевым существом до конца хода. Разверните то существо. До конца хода оно получает +2/+0 и Ускорение.\', \'type\': \'Волшебство\', \'flavor\': \'Ужасная тварь дергалась, словно марионетка из кошмарного сна, выжимая жизнь из себе подобных.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216017&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'79516025-c342-4307-bb97-87c5a553058b\', \'multiverseId\': 216017}, \'multiverseid\': 216017}, {\'name\': \'背叛本能\', \'text\': \'获得目标生物的操控权直到回合结束。 重置该生物。 直到回合结束，它得+2/+0并获得敏捷异能。\', \'type\': \'法术\', \'flavor\': \'惊惧兽如同疯子梦魇中的人偶般摇晃前行，连同类都是其下手对象。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216265&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c3faf0b6-230d-4157-b4b3-7826a04f6da2\', \'multiverseId\': 216265}, \'multiverseid\': 216265}]', '[{\'name\': \'Versammlung der Nomaden\', \'text\': \'Bringe für jede Kreatur, die du kontrollierst, einen 1/1 weißen (Kor, Soldat)-Kreaturenspielstein ins Spiel.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217507&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bd06121e-66f3-429f-87b0-93b7bf9dc312\', \'multiverseId\': 217507}, \'multiverseid\': 217507}, {\'name\': \'Asamblea de nómadas\', \'text\': \'Pon en el campo de batalla una ficha de criatura Soldado Kor blanca 1/1 por cada criatura que controlas.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217259&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1361dcb4-06be-47b4-920d-eb0e736695d7\', \'multiverseId\': 217259}, \'multiverseid\': 217259}, {\'name\': \'Rassemblement de nomades\', \'text\': "Mettez sur le champ de bataille un jeton de créature 1/1 blanche Kor et Soldat pour chaque créature que vous contrôlez.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215771&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3e1dd79f-5e86-4bdf-a9fe-199a7852d645\', \'multiverseId\': 215771}, \'multiverseid\': 215771}, {\'name\': \'Adunata dei Nomadi\', \'text\': "Metti sul campo di battaglia una pedina creatura Soldato Kor 1/1 bianca per ogni creatura che controlli.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216515&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6b76a08f-3c46-4313-9b26-2dfacdf011dc\', \'multiverseId\': 216515}, \'multiverseid\': 216515}, {\'name\': \'遊牧の民の集合\', \'text\': \'あなたがコントロールするクリーチャー１体につき、白の１/１のコー・兵士・クリーチャー・トークンを１体戦場に出す。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216763&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'062ac3b8-1a40-4ccb-98a5-07440afb9f6e\', \'multiverseId\': 216763}, \'multiverseid\': 216763}, {\'name\': \'Assembleia dos Nômades\', \'text\': \'Coloque no campo de batalha uma ficha de criatura branca 1/1 do tipo Kor Soldado para cada criatura que você controla.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217011&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cc14ae44-dce4-44d5-97de-e8a3a9088f19\', \'multiverseId\': 217011}, \'multiverseid\': 217011}, {\'name\': \'Сбор Кочевников\', \'text\': \'Положите на поле битвы одну фишку существа 1/1 белый Кор Солдат за каждое существо под вашим контролем.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216019&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f71272d7-72b3-4657-ba08-efa8ffd244c6\', \'multiverseId\': 216019}, \'multiverseid\': 216019}, {\'name\': \'牧民集合号\', \'text\': \'你每操控一个生物，便将一个1/1白色寇族／士兵衍生物放进战场。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216267&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'72d77cf4-d534-43d9-b022-3b0d897bf4ea\', \'multiverseId\': 216267}, \'multiverseid\': 216267}]', '[{\'name\': \'Verseuchtes Gelände\', \'text\': \'Landverzauberung\\nDas verzauberte Land ist ein Sumpf.\\nImmer wenn das verzauberte Land getappt wird, verliert sein Beherrscher 2 Lebenspunkte.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Das Plateau von Na ist verloren. Fragt nicht, was dort passiert ist, und kehrt niemals dorthin zurück." —Nirthu, einsamer Missionar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217427&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'475c1cdb-ba9f-4809-ad01-30207c29d005\', \'multiverseId\': 217427}, \'multiverseid\': 217427}, {\'name\': \'Terreno contaminado\', \'text\': \'Encantar tierra.\\nLa tierra encantada es un pantano.\\nSiempre que la tierra encantada sea girada, su controlador pierde 2 vidas.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"La Meseta Na ya no existe. No preguntes qué pasó y nunca regreses allí." —Nirthu, misionero solitario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217179&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'02a0e6eb-5fd1-4661-b18e-db44420d969a\', \'multiverseId\': 217179}, \'multiverseid\': 217179}, {\'name\': \'Terre contaminée\', \'text\': \'Enchanter : terrain\\nLe terrain enchanté est un marais.\\nÀ chaque fois que le terrain enchanté devient engagé, son contrôleur perd 2 points de vie.\', \'type\': \'Enchantement : aura\', \'flavor\': "« Le Plateau de Na est perdu. Ne demandez pas ce qui s\'y est passé, et n\'y retournez jamais. » —Nirthu, missionnaire solitaire", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215691&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'65c0fff7-594a-49c8-b786-b1dbe3819068\', \'multiverseId\': 215691}, \'multiverseid\': 215691}, {\'name\': \'Terreno Contaminato\', \'text\': \'Incanta terra\\nLa terra incantata è una Palude.\\nOgniqualvolta la terra incantata viene TAPpata, il suo controllore perde 2 punti vita.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"L\\\'Altopiano Na è perso. Non chiedere cosa è successo e non tornarci mai più." —Nirthu, missionario solitario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216435&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70327cb2-1dcb-4795-a107-53bac97528a2\', \'multiverseId\': 216435}, \'multiverseid\': 216435}, {\'name\': \'汚染された地\', \'text\': \'エンチャント（土地）\\nエンチャントされている土地は沼である。\\nエンチャントされている土地がタップ状態になるたび、それのコントローラーは２点のライフを失う。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「ナー高原は失われた。何が起こったか聞くな。そこへ戻ろうともするな。」 ――孤独な宣教師、ニルトゥ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216683&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7cbff139-63e7-442a-a4c1-1d5ac38f839a\', \'multiverseId\': 216683}, \'multiverseid\': 216683}, {\'name\': \'Solo Contaminado\', \'text\': \'Encantar terreno\\nO terreno encantado é um Pântano.\\nToda vez que o terreno encantado for virado, seu controlador perderá 2 pontos de vida.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"O Planalto de Na está perdido. Jamais pergunte o que aconteceu lá, e nunca mais retorne." — Nirthu, missionário solitário\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216931&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33de41bb-21fd-4e9a-8fd2-929c41992b3d\', \'multiverseId\': 216931}, \'multiverseid\': 216931}, {\'name\': \'Зараженная Местность\', \'text\': \'Зачаровать землю\\nЗачарованная земля является Болотом.\\nКаждый раз когда зачарованная земля поворачивается, контролирующий ее игрок теряет 2 жизни.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Плоскогорье На потеряно. Не спрашивайте, что произошло, и никогда туда не возвращайтесь». — Нирту, миссионер-одиночка\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215939&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dab52ae0-ef7f-4f6b-a650-8bd85e904113\', \'multiverseId\': 215939}, \'multiverseid\': 215939}, {\'name\': \'污化地界\', \'text\': \'结附于地\\n所结附的地是沼泽。\\n每当所结附的地成为横置时，其操控者失去2点生命。\', \'type\': \'结界～灵气\', \'flavor\': \'「纳高原已经完了。别追问到底发生什么事，也别再回去那边。」 ～独行传教士讷图\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216187&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9aa33081-7044-4060-b9a2-9c29eb644359\', \'multiverseId\': 216187}, \'multiverseid\': 216187}]', "[{'name': 'Verwüstende Beschwörungen', 'text': 'Opfere X Länder als zusätzliche Kosten, um Verwüstende Beschwörungen zu wirken.\\nBringe zwei X/X rote Elementarwesen-Kreaturenspielsteine ins Spiel.', 'type': 'Hexerei', 'flavor': 'In Magma geborene Wesen sind immer wütend.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217473&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd8f56f39-d810-4df8-8662-8632da1df735', 'multiverseId': 217473}, 'multiverseid': 217473}, {'name': 'Invocaciones devastadoras', 'text': 'Como coste adicional para lanzar las Invocaciones devastadoras, sacrifica X tierras.\\nPon en el campo de batalla dos fichas de criatura Elemental rojas X/X.', 'type': 'Conjuro', 'flavor': 'Las cosas que nacen del magma siempre están furiosas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217225&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e5914668-6314-491b-ae2e-b774e9d3de1c', 'multiverseId': 217225}, 'multiverseid': 217225}, {'name': 'Recrutement dévastateur', 'text': 'En tant que coût supplémentaire pour lancer le Recrutement dévastateur, sacrifiez X terrains.\\nMettez sur le champ de bataille deux jetons de créature X/X rouge Élémental.', 'type': 'Rituel', 'flavor': 'Certaines choses nées du magma sont toujours enragées.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215737&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3edbcfae-6b6b-44c9-9eb4-ff6017ecea72', 'multiverseId': 215737}, 'multiverseid': 215737}, {'name': 'Evocazioni Devastanti', 'text': 'Come costo addizionale per lanciare le Evocazioni Devastanti, sacrifica X terre.\\nMetti sul campo di battaglia due pedine creatura Elementale X/X rosse.', 'type': 'Stregoneria', 'flavor': 'Le cose che nascono nel magma sono sempre furiose.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216481&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'dfeef71d-d344-4b81-9485-26683d7e6648', 'multiverseId': 216481}, 'multiverseid': 216481}, {'name': '壊滅的な召喚', 'text': '壊滅的な召喚を唱えるための追加コストとして、土地をＸ枚生け贄に捧げる。\\n赤のＸ/Ｘのエレメンタル・クリーチャー・トークンを２体戦場に出す。', 'type': 'ソーサリー', 'flavor': 'マグマから生まれたものは常に怒っている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216729&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cc3431d4-e7a1-4270-b533-6063cbb17f3d', 'multiverseId': 216729}, 'multiverseid': 216729}, {'name': 'Invocações Devastadoras', 'text': 'Como custo adicional para conjurar Invocações Devastadoras, sacrifique X terrenos.\\nColoque no campo de batalha duas fichas de criatura vermelhas X/X do tipo Elemental.', 'type': 'Feitiço', 'flavor': 'Tudo aquilo que nasce do magma está sempre faminto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216977&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '72b3a269-868d-4f3c-9bf4-d24b9f9b71f2', 'multiverseId': 216977}, 'multiverseid': 216977}, {'name': 'Разрушительный Вызов', 'text': 'В качестве дополнительной стоимости разыгрывания Разрушительного Вызова пожертвуйте X земель.\\nПоложите на поле битвы две фишки существа X/X красный Элементаль.', 'type': 'Волшебство', 'flavor': 'Рожденные в магме добрыми не бывают.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215985&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '17505fdb-a2e2-4b56-91bc-7c2c8cdc0d74', 'multiverseId': 215985}, 'multiverseid': 215985}, {'name': '毁灭性召唤', 'text': '牺牲X个地，以作为施放毁灭性召唤的额外费用。\\n将两个X/X红色元素衍生物放进战场。', 'type': '法术', 'flavor': '诞生于岩浆的事物总是怒气冲天。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216233&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '06e75eb6-82b3-49b5-b479-00c755f3362a', 'multiverseId': 216233}, 'multiverseid': 216233}]", '[{\'name\': \'Verzehrende Dämpfe\', \'text\': \'Ein Spieler deiner Wahl opfert eine Kreatur. Du erhältst Lebenspunkte in Höhe der Widerstandskraft dieser Kreatur dazu.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217534&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34e0e989-28e3-4d21-ad33-dfb895abeb8e\', \'multiverseId\': 217534}, \'multiverseid\': 217534}, {\'name\': \'Vapores consumidores\', \'text\': \'El jugador objetivo sacrifica una criatura. Ganas vidas igual a la resistencia de esa criatura.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217286&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5d627bb8-ef95-4010-af0e-589809b685b8\', \'multiverseId\': 217286}, \'multiverseid\': 217286}, {\'name\': \'Vapeurs dévorantes\', \'text\': "Le joueur ciblé sacrifie une créature. Vous gagnez un nombre de points de vie égal à l\'endurance de cette créature.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215798&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7c5defac-d483-4118-b55e-c515b524ffc7\', \'multiverseId\': 215798}, \'multiverseid\': 215798}, {\'name\': \'Vapori Distruttivi\', \'text\': "Un giocatore bersaglio sacrifica una creatura. Guadagni punti vita pari alla costituzione di quella creatura.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216542&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'38672793-b7d0-4d6b-b960-e04af0178fe5\', \'multiverseId\': 216542}, \'multiverseid\': 216542}, {\'name\': \'消耗の蒸気\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはクリーチャーを１体生け贄に捧げる。 あなたはそのクリーチャーのタフネスに等しい点数のライフを得る。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216790&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c33c8210-47fd-4672-9318-0ea692e87f7a\', \'multiverseId\': 216790}, \'multiverseid\': 216790}, {\'name\': \'Vapores Devastantes\', \'text\': \'O jogador alvo sacrifica uma criatura. Você ganha uma quantidade de pontos de vida igual à resistência daquela criatura.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217038&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8144f07-7f11-4dd8-9f34-c64ecc2b0222\', \'multiverseId\': 217038}, \'multiverseid\': 217038}, {\'name\': \'Всепоглощающие Пары\', \'text\': \'Целевой игрок приносит в жертву существо. Вы получаете количество жизней, равное выносливости того существа.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216046&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9438df84-5c2b-4e82-bcd8-e16dc6aaedf8\', \'multiverseId\': 216046}, \'multiverseid\': 216046}, {\'name\': \'化骨毒气\', \'text\': \'目标牌手牺牲一个生物。 你获得等同于该生物防御力的生命。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216294&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c397dca5-adb8-4e35-8a9d-11424f707e7e\', \'multiverseId\': 216294}, \'multiverseid\': 216294}]', '[{\'name\': \'Verzweifeln lassen\', \'text\': \'Zeige als zusätzliche Kosten, um Verzweifeln lassen zu wirken, eine Kreaturenkarte aus deiner Hand vor.\\nEine Kreatur deiner Wahl erhält -X/-X bis zum Ende des Zuges, wobei X gleich den umgewandelten Manakosten der vorgezeigten Karte ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Engel konnte nur noch sein eigenes Verhängnis sehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217373&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bc0a6e72-a598-4a58-8f58-87641e99cc2b\', \'multiverseId\': 217373}, \'multiverseid\': 217373}, {\'name\': \'Inducir a la desesperación\', \'text\': \'Como coste adicional para lanzar Inducir a la desesperación, muestra una carta de criatura de tu mano.\\nLa criatura objetivo obtiene -X/-X hasta el final del turno, donde X es el coste de maná convertido de la carta mostrada.\', \'type\': \'Instantáneo\', \'flavor\': \'Todo lo que vio el ángel fue su perdición.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217125&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'779e2164-e68c-4442-9be7-4c8aca43c3a2\', \'multiverseId\': 217125}, \'multiverseid\': 217125}, {\'name\': \'Invitation au désespoir\', \'text\': "En tant que coût supplémentaire pour lancer l\'Invitation au désespoir, révélez une carte de créature de votre main.\\nLa créature ciblée gagne -X/-X jusqu\'à la fin du tour, X étant le coût converti de mana de la carte révélée.", \'type\': \'Éphémère\', \'flavor\': "L\'ange ne vit que sa perte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215637&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bff82390-127a-4fc6-b2ac-13da4542d3dc\', \'multiverseId\': 215637}, \'multiverseid\': 215637}, {\'name\': \'Spingere alla Disperazione\', \'text\': \'Come costo addizionale per lanciare Spingere alla Disperazione, rivela una carta creatura dalla tua mano.\\nUna creatura bersaglio prende -X/-X fino alla fine del turno, dove X è il costo di mana convertito della carta rivelata.\', \'type\': \'Istantaneo\', \'flavor\': "Tutto ciò che vide l\'angelo fu il proprio tragico destino.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216381&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'decfa3e4-46af-483e-8d2c-94aba00327db\', \'multiverseId\': 216381}, \'multiverseid\': 216381}, {\'name\': \'絶望の誘導\', \'text\': \'絶望の誘導を唱えるための追加コストとして、あなたの手札にあるクリーチャー・カードを１枚公開する。\\nクリーチャー１体を対象とする。それはターン終了時まで－Ｘ/－Ｘの修整を受ける。Ｘはその公開されたカードの点数で見たマナ・コストに等しい。\', \'type\': \'インスタント\', \'flavor\': \'天使が見たのは、彼女の悲運だけだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216629&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d545077e-d494-4c13-938a-f462cca7ec3f\', \'multiverseId\': 216629}, \'multiverseid\': 216629}, {\'name\': \'Induzir Desespero\', \'text\': \'Como custo adicional para conjurar Induzir Desespero, revele um card de criatura da sua mão.\\nA criatura alvo recebe -X/-X até o final do turno, sendo X igual ao custo de mana convertido do card revelado.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O anjo viu apenas a sua ruína.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216877&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1234ba2f-9316-4575-84b5-9931fe44d610\', \'multiverseId\': 216877}, \'multiverseid\': 216877}, {\'name\': \'Приступ Отчаяния\', \'text\': \'В качестве дополнительной стоимости разыгрывания Приступа Отчаяния покажите карту существа из вашей руки.\\nЦелевое существо получает -X/-X до конца хода, где X — конвертированная мана-стоимость показанной карты.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Все, что видел ангел, — это собственную гибель.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215885&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c284902-6823-4d92-9c33-e568ae51d116\', \'multiverseId\': 215885}, \'multiverseid\': 215885}, {\'name\': \'引致绝望\', \'text\': \'从你手上展示一张生物牌，以作为施放引致绝望的额外费用。\\n目标生物得-X/-X直到回合结束，X为所展示之牌的总法术力费用。\', \'type\': \'瞬间\', \'flavor\': \'那天使眼中只看得到自己的末路。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216133&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1066fb87-1bfe-4199-8232-8d6c9d9811fc\', \'multiverseId\': 216133}, \'multiverseid\': 216133}]', '[{\'name\': \'Virulenter Hieb\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+0 und Todesberührung bis zum Ende des Zuges.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217512&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a10a0b39-0319-467d-b3f0-079a981d5d9d\', \'multiverseId\': 217512}, \'multiverseid\': 217512}, {\'name\': \'Golpe virulento\', \'text\': \'La criatura objetivo obtiene +2/+0 y gana la habilidad de toque mortal hasta el final del turno.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217264&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f812ae77-9cc0-475b-8dde-c1befe8ee9f2\', \'multiverseId\': 217264}, \'multiverseid\': 217264}, {\'name\': \'Frappe virulente\', \'text\': "La créature ciblée gagne +2/+0 et acquiert le contact mortel jusqu\'à la fin du tour.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215776&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'178cf242-af62-4ab1-998f-4dfdb22ec4f8\', \'multiverseId\': 215776}, \'multiverseid\': 215776}, {\'name\': \'Colpo Virulento\', \'text\': "Una creatura bersaglio prende +2/+0 e ha tocco letale fino alla fine del turno.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216520&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d55441eb-3b85-4b29-a70d-153e0e6f787f\', \'multiverseId\': 216520}, \'multiverseid\': 216520}, {\'name\': \'悪性の強打\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで、＋２/＋０の修整を受けるとともに接死を得る。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216768&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6b0c8dc0-95ec-4223-b81b-295306918242\', \'multiverseId\': 216768}, \'multiverseid\': 216768}, {\'name\': \'Pancada Virulenta\', \'text\': \'A criatura alvo recebe +2/+0 e ganha toque mortífero até o final do turno.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217016&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c771a8e-c16b-4879-93e7-ffac56121041\', \'multiverseId\': 217016}, \'multiverseid\': 217016}, {\'name\': \'Ядовитый Взмах\', \'text\': \'Целевое существо получает +2/+0 и Смертельное касание до конца хода.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216024&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc6eb3af-25b4-4561-bca4-a98f324312aa\', \'multiverseId\': 216024}, \'multiverseid\': 216024}, {\'name\': \'猛毒劈砍\', \'text\': \'目标生物得+2/+0且获得死触异能直到回合结束。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216272&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70830adc-3b74-42e5-8e9a-a58712d2f601\', \'multiverseId\': 216272}, \'multiverseid\': 216272}]', '[{\'name\': \'Vorenthalten\', \'text\': \'Bringe als zusätzliche Kosten, um Vorenthalten zu wirken, ein Land, das du kontrollierst, auf die Hand seines Besitzers zurück.\\nNeutralisiere einen Zauberspruch deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Das hätte dir als Magier nur Schande bereitet. Ich sage dir was: Es bleibt unter uns." —Noyan Dar, Ruhezauberer aus Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217372&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e07d2983-8987-43b1-8e21-8c7d413bbec1\', \'multiverseId\': 217372}, \'multiverseid\': 217372}, {\'name\': \'Vedar\', \'text\': \'Como coste adicional para lanzar Vedar, regresa una tierra que controles a la mano de su propietario.\\nContrarresta el hechizo objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Eso debería darte vergüenza como mago. ¿Sabes qué? Yo guardaré tu secreto." —Noyan Dar, mago arrullador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217124&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ee20af9d-262e-4b50-bc2b-ef0c22dd2d66\', \'multiverseId\': 217124}, \'multiverseid\': 217124}, {\'name\': \'Privation\', \'text\': \'En tant que coût supplémentaire pour lancer la Privation, renvoyez un terrain que vous contrôlez dans la main de son propriétaire.\\nContrecarrez le sort ciblé.\', \'type\': \'Éphémère\', \'flavor\': "« Quelle humiliation pour toi en tant que mage. Ne t\'en fais pas — je garderai ton secret. » —Noyan Dar, ataraxmage de Tazeem", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215636&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5230045a-b5e4-48da-a670-0898dcaf0100\', \'multiverseId\': 215636}, \'multiverseid\': 215636}, {\'name\': \'Privare\', \'text\': \'Come costo addizionale per lanciare Privare, fai tornare una terra che controlli in mano al suo proprietario.\\nNeutralizza una magia bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Questo ti avrebbe disonorato come mago. Sai cosa ti dico... manterrò il tuo segreto." —Noyan Dar, mitigatore di Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216380&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'84d00e6a-44a0-4f99-8236-6abb0e8f2ed9\', \'multiverseId\': 216380}, \'multiverseid\': 216380}, {\'name\': \'剥奪\', \'text\': \'剥奪を唱えるための追加コストとして、あなたがコントロールする土地１つをオーナーの手札に戻す。\\n呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'「魔道士として恥ずかしい目を見るところだったな。 まあ、そうだな――秘密にしておいてやるよ。」 ――タジームの凪魔道士、ノヤン・ダール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216628&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3e947da-e48a-41a4-a2c4-efcd313b3fa8\', \'multiverseId\': 216628}, \'multiverseid\': 216628}, {\'name\': \'Desprover\', \'text\': \'Como custo adicional para conjurar Desprover, devolva um terreno que você controla para a mão de seu dono.\\nAnule a mágica alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Isso seria uma vergonha para você como mago. Sabe de uma coisa, vou guardar o seu segredo." — Noyan Dar, Mago Anulador de Tazeem\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216876&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'51374c07-163e-4f48-a230-72e818bb0bca\', \'multiverseId\': 216876}, \'multiverseid\': 216876}, {\'name\': \'Лишение\', \'text\': \'В качестве дополнительной стоимости разыгрывания Лишения верните землю под вашим контролем в руку ее владельца.\\nОтмените целевое заклинание.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Это бы опозорило тебя как мага. Так и быть, я никому не скажу». — Нойен Дар, маг-баюн из Тазима\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215884&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'34f92e68-fe42-450f-bb24-9ec8ea4e2eca\', \'multiverseId\': 215884}, \'multiverseid\': 215884}, {\'name\': \'剥夺\', \'text\': \'将由你操控的一个地移回其拥有者手上，以作为施放剥夺的额外费用。\\n反击目标咒语。\', \'type\': \'瞬间\', \'flavor\': \'「身为法师，这会让你引以为耻。 知道吗～我会保守你的秘密。」 ～塔晋息法师诺言达\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216132&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'69b01cbd-8557-44ac-801c-892f51e03e3e\', \'multiverseId\': 216132}, \'multiverseid\': 216132}]', '[{\'name\': \'Vorreiter aus Ikiral\', \'text\': \'Stufe aufsteigen {4} ({4}: Lege eine Stufenmarke auf diese Karte. Spiele Stufe aufsteigen wie eine Hexerei.)\\nSTUFE 1-3\\n2/6\\nWachsamkeit\\nSTUFE 4+\\n3/10\\nWachsamkeit\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217504&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8434b7cd-21b6-4201-bee0-34b307828f9d\', \'multiverseId\': 217504}, \'multiverseid\': 217504}, {\'name\': \'Batidor de Ikiral\', \'text\': \'Subir de nivel {4}. ({4}: Pon un contador de nivel sobre esto. Sube de nivel sólo como un conjuro.)\\nNIVEL 1-3\\n2/6\\nVigilancia.\\nNIVEL 4+\\n3/10\\nVigilancia.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217256&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ca7a9917-b63c-4acb-91e9-303251051feb\', \'multiverseId\': 217256}, \'multiverseid\': 217256}, {\'name\': "Cavalier d\'Ikiral", \'text\': \'Montée de niveau {4} ({4} : Mettez un marqueur « niveau » sur cette créature. Ne montez de niveau que lorsque vous pourriez lancer un rituel.)\\nNIVEAU 1-3\\n2/6\\nVigilance\\nNIVEAU 4+\\n3/10\\nVigilance\', \'type\': \'Créature : humain et soldat\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215768&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cb03fed4-6a26-4fed-a654-3c9c9bd25808\', \'multiverseId\': 215768}, \'multiverseid\': 215768}, {\'name\': \'Apripista di Ikiral\', \'text\': \'Aumentare di livello {4} ({4}: Metti un segnalino livello su questa creatura. Aumenta di livello solo quando potresti lanciare una stregoneria.)\\nLIVELLO 1-3\\n2/6\\nCautela\\nLIVELLO 4+\\n3/10\\nCautela\', \'type\': \'Creatura — Soldato Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216512&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'05e413db-6709-49d6-810e-245174a33dc1\', \'multiverseId\': 216512}, \'multiverseid\': 216512}, {\'name\': \'イキーラルの先導\', \'text\': \'Lvアップ {4} ({4}：この上にLvカウンターを１個置く。 Lvアップはソーサリーとしてのみ行う。）\\nLv 1-3\\n2/6\\n警戒\\nLv 4+\\n3/10\\n警戒\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216760&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8c5dbc64-d164-4501-9d55-32f4fd3ac071\', \'multiverseId\': 216760}, \'multiverseid\': 216760}, {\'name\': \'Vanguardeiro de Ikiral\', \'text\': \'Subir de nível {4} ({4}: Coloque um marcador de nível nesta criatura. Suba de nível somente quando puder jogar um feitiço.)\\nNÍVEL 1-3\\n2/6\\nVigilância\\nNÍVEL 4+\\n3/10\\nVigilância\', \'type\': \'Criatura — Humano Soldado\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217008&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ced24e1b-1d13-4d8c-81e4-4e7a20e702c0\', \'multiverseId\': 217008}, \'multiverseid\': 217008}, {\'name\': \'Икиральский Верховой\', \'text\': \'Повышение уровня {4} ({4}: положите один жетон уровня на это существо. Повышайте уровень только как волшебство.)\\nУРОВЕНЬ 1-3\\n2/6\\nБдительность\\nУРОВЕНЬ 4+\\n3/10\\nБдительность\', \'type\': \'Существо — Человек Солдат\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216016&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'903bff0b-1b84-43f5-9823-3bf8fd066421\', \'multiverseId\': 216016}, \'multiverseid\': 216016}, {\'name\': \'伊奇洛前导兵\', \'text\': \'升级{4} （{4}：在其上放置一个等级指示物。 升级的时机视同法术。）\\n等级1-3\\n2/6\\n警戒\\n等级4+\\n3/10\\n警戒\', \'type\': \'生物～人类／士兵\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216264&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'248938ab-f696-4c25-bed7-2ab475e14610\', \'multiverseId\': 216264}, \'multiverseid\': 216264}]', '[{\'name\': \'Wachdienst\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat Verteidiger.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Ich habe gehört, dass dies die Standardausrüstung ist. Sehe ich etwa wie Standard aus?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217320&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91a80ed6-4bad-4f23-b73d-085743a40c8d\', \'multiverseId\': 217320}, \'multiverseid\': 217320}, {\'name\': \'Servicio de guardia\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene la habilidad de defensor.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Me dijeron que esto era lo normal. ¿Acaso parezco normal?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217072&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'948098c9-e3a6-455a-aeba-403d90aa697e\', \'multiverseId\': 217072}, \'multiverseid\': 217072}, {\'name\': \'Service de garde\', \'text\': \'Enchanter : créature\\nLa créature enchantée a le défenseur.\', \'type\': \'Enchantement : aura\', \'flavor\': "« On m\'a dit que c\'était un équipement standard. Est-ce que j\'ai l\'air standard, moi ? »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215584&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62c8636e-99ab-4815-97b2-42c1355ab777\', \'multiverseId\': 215584}, \'multiverseid\': 215584}, {\'name\': \'Servizio di Guardia\', \'text\': \'Incanta creatura\\nLa creatura incantata ha difensore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Mi hanno detto che era una mansione standard. Ti sembro standard?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216328&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bba8edde-aa79-469d-9be9-3767a5149d94\', \'multiverseId\': 216328}, \'multiverseid\': 216328}, {\'name\': \'護衛任務\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは防衛を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「並の武器じゃないかよ。 俺が並の人間に見えるのか？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216576&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5558a947-8cd4-4588-aecc-a59adcde9ac6\', \'multiverseId\': 216576}, \'multiverseid\': 216576}, {\'name\': \'Fazer Guarda\', \'text\': \'Encantar criatura\\nA criatura encantada tem defensor.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Fui informado de que isso era uma coisa normal. Eu lhe pareço normal?"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216824&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c172af3c-1a5c-4488-b1b4-9b3057578e81\', \'multiverseId\': 216824}, \'multiverseid\': 216824}, {\'name\': \'Караульная Служба\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность Защитника.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Мне сказали, что они — обычная проблема. Я кажусь вам обычным?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215832&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'521fd3ea-f68a-4fe2-860e-81c8cd6e9ed4\', \'multiverseId\': 215832}, \'multiverseid\': 215832}, {\'name\': \'卫哨职责\', \'text\': \'结附于生物\\n所结附的生物具有守军异能。\', \'type\': \'结界～灵气\', \'flavor\': \'「据说这是普通问题。 你觉得我很普通吗？」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216080&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0603ce86-1f72-4771-a77b-d1d9051a6b51\', \'multiverseId\': 216080}, \'multiverseid\': 216080}]', '[{\'name\': \'Wachhund aus Affa\', \'text\': \'Aufblitzen\\nWenn der Wachhund aus Affa ins Spiel kommt, erhält eine Kreatur deiner Wahl +0/+3 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Hund\', \'flavor\': \'Einst war Affa ein beliebter Treffpunkt für Forscher, doch es wurde zu einem Ort, wo man lieber seine Zunge hütete und immer auf der Hut war.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'686bcccb-7431-4c8b-bd65-64c2a8cac677\', \'multiverseId\': 217517}, \'multiverseid\': 217517}, {\'name\': \'Perro guardián de Affa\', \'text\': \'Destello.\\nCuando el Perro guardián de Affa entre al campo de batalla, la criatura objetivo obtiene +0/+3 hasta el final del turno.\', \'type\': \'Criatura — Perro\', \'flavor\': \'Una vez fue un lugar que recibía a los exploradores, pero ahora Affa es un lugar de bocas cerradas y defensas rápidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217269&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce368cb5-d2b4-44fc-bd71-0f4cd4e99258\', \'multiverseId\': 217269}, \'multiverseid\': 217269}, {\'name\': "Chien de garde d\'Affa", \'text\': "Flash\\nQuand le Chien de garde d\'Affa arrive sur le champ de bataille, la créature ciblée gagne +0/+3 jusqu\'à la fin du tour.", \'type\': \'Créature : chien de chasse\', \'flavor\': \'Autrefois un centre accueillant pour les explorateurs, Affa était devenu un lieu aux bouches discrètes et aux défenses rapides.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215781&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b95f03fb-0ddb-4dd3-ad78-1c92eda45c4d\', \'multiverseId\': 215781}, \'multiverseid\': 215781}, {\'name\': \'Segugio da Guardia di Affa\', \'text\': \'Lampo\\nQuando il Segugio da Guardia di Affa entra nel campo di battaglia, una creatura bersaglio prende +0/+3 fino alla fine del turno.\', \'type\': \'Creatura — Segugio\', \'flavor\': \'Un tempo rifugio accogliente per gli esploratori, Affa è diventato un luogo di lingue caute e difese rapide.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216525&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ceb61623-4d37-45e7-a425-4d8fae889923\', \'multiverseId\': 216525}, \'multiverseid\': 216525}, {\'name\': \'アーファの番犬\', \'text\': \'瞬速\\nアーファの番犬が戦場に出たとき、クリーチャー１体を対象とする。それはターン終了時まで＋０/＋３の修整を受ける。\', \'type\': \'クリーチャー — 猟犬\', \'flavor\': \'かつて探検家を快く迎え入れていたアーファは、沈黙と素早い守りの地となった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216773&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa14df16-9f77-468f-aada-a005b7290556\', \'multiverseId\': 216773}, \'multiverseid\': 216773}, {\'name\': \'Sabujo de Guarda de Affa\', \'text\': \'Lampejo\\nQuando Sabujo de Guarda de Affa entra no campo de batalha, a criatura alvo recebe +0/+3 até o final do turno.\', \'type\': \'Criatura — Sabujo\', \'flavor\': \'Outrora um ponto de encontro para exploradores, Affa tornou-se um local de línguas vigiadas e defesas rápidas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217021&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'12440439-1c1b-4f1d-96a6-cb4690b833a7\', \'multiverseId\': 217021}, \'multiverseid\': 217021}, {\'name\': \'Сторожевой Пес из Аффы\', \'text\': \'Миг\\nКогда Сторожевой Пес из Аффы выходит на поле битвы, целевое существо получает +0/+3 до конца хода.\', \'type\': \'Существо — Пес\', \'flavor\': \'Некогда дружелюбное поселение, куда стекались исследователи, Аффа превратилась в место, где язык держат за зубами и всегда готовы дать отпор.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216029&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'07da8053-9e67-454d-bc35-fec37a6f2770\', \'multiverseId\': 216029}, \'multiverseid\': 216029}, {\'name\': \'艾法守卫犬\', \'text\': \'闪现\\n当艾法守卫犬进战场时，目标生物得+0/+3直到回合结束。\', \'type\': \'生物～猎犬\', \'flavor\': \'艾法曾是深受探险家欢迎的中途站，现已成为鲜闻语声、防卫森严的地方。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216277&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'304c514c-08f4-45a2-ba27-80017df2c16a\', \'multiverseId\': 216277}, \'multiverseid\': 216277}]', '[{\'name\': \'Wachstumskrämpfe\', \'text\': \'Durchsuche deine Bibliothek nach einem Standardland, bringe es getappt ins Spiel und mische dann deine Bibliothek. Bringe einen 0/1 farblosen (Eldrazi, Ausgeburt)-Kreaturenspielstein ins Spiel. Er hat „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217376&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb04bdaa-96fd-48ab-973a-41175e808be3\', \'multiverseId\': 217376}, \'multiverseid\': 217376}, {\'name\': \'Espasmo de crecimiento\', \'text\': \'Busca en tu biblioteca una carta de tierra básica, ponla en el campo de batalla girada y luego baraja tu biblioteca. Pon en el campo de batalla una ficha de criatura Engendro Eldrazi incolora 0/1. Tiene "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217128&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'734b1cf2-c51e-4d47-91c1-215f586bdf36\', \'multiverseId\': 217128}, \'multiverseid\': 217128}, {\'name\': \'Spasme de croissance\', \'text\': \'Cherchez dans votre bibliothèque une carte de terrain de base, mettez-la sur le champ de bataille engagée et mélangez ensuite votre bibliothèque. Mettez sur le champ de bataille un jeton de créature 0/1 incolore Eldrazi et Engeance. Il a « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215640&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07ad5192-acdf-4dbf-8464-40b6836dd57a\', \'multiverseId\': 215640}, \'multiverseid\': 215640}, {\'name\': \'Spasmo di Crescita\', \'text\': \'Passa in rassegna il tuo grimorio per una carta terra base, mettila sul campo di battaglia TAPpata, poi rimescola il tuo grimorio. Metti sul campo di battaglia una pedina creatura Progenie Eldrazi 0/1 incolore. Ha "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216384&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'add26997-cc74-4b6e-bc0f-326562a4d998\', \'multiverseId\': 216384}, \'multiverseid\': 216384}, {\'name\': \'成長の発作\', \'text\': \'あなたのライブラリーから基本土地カードを１枚探し、それをタップ状態で戦場に出し、その後、あなたのライブラリーを切り直す。 無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを１体戦場に出す。 それは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216632&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e98234bc-5ebf-4c18-a7c9-1dde23c01882\', \'multiverseId\': 216632}, \'multiverseid\': 216632}, {\'name\': \'Espasmo de Crescimento\', \'text\': \'Procure um card de terreno básico no seu grimório e coloque-o no campo de batalha virado e embaralhe seu grimório. Coloque no campo de batalha uma ficha de criatura incolor 0/1 do tipo Prole Eldrazi. Ela tem "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216880&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2366e7a0-675c-4397-8ad0-7ac500a04dc3\', \'multiverseId\': 216880}, \'multiverseid\': 216880}, {\'name\': \'Порыв Роста\', \'text\': \'Найдите в вашей библиотеке карту базовой земли, положите ее на поле битвы повернутой, затем перетасуйте вашу библиотеку. Положите на поле битвы одну фишку существа 0/1 бесцветный Эльдрази Порождение. У нее есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215888&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a3ba2873-d2c0-46c9-996c-efcc9e927153\', \'multiverseId\': 215888}, \'multiverseid\': 215888}, {\'name\': \'成长抽搐\', \'text\': \'从你的牌库中搜寻一张基本地牌，将之横置进战场，然后将你的牌库洗牌。 将一个0/1无色奥札奇／后裔衍生物放进战场。 它具有「牺牲此生物：加{1}到你的法术力池中。」\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216136&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b5aa3104-888c-44d1-b35a-05b10b4d49c9\', \'multiverseId\': 216136}, \'multiverseid\': 216136}]', '[{\'name\': \'Wackerfuß aus Akoum\', \'text\': \'Wenn der Wackerfuß aus Akoum ins Spiel kommt, fügt er einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu.\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': \'„Wenn du in Akoum bist und von oben ein Schatten auf dich fällt, ist es ganz falsch, dich zu ducken." —Chadir der Navigator\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217362&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bb925f66-7aa1-42d6-afac-e35e495989fd\', \'multiverseId\': 217362}, \'multiverseid\': 217362}, {\'name\': \'Piepeñasco de Akoum\', \'text\': \'Cuando el Piepeñasco de Akoum entre al campo de batalla, hace 1 punto de daño a la criatura o jugador objetivo.\', \'type\': \'Criatura — Guerrero gigante\', \'flavor\': \'"Si estás en Akoum y observas una sombra sobre tu cabeza, lo peor que puedes hacer es agacharte." —Chadir el navegante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217114&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'851f950d-84df-4eee-9d35-27e2c7d2302b\', \'multiverseId\': 217114}, \'multiverseid\': 217114}, {\'name\': "Pied-lourd d\'Akoum", \'text\': "Quand le Pied-lourd d\'Akoum arrive sur le champ de bataille, il inflige 1 blessure à une cible, créature ou joueur.", \'type\': \'Créature : géant et guerrier\', \'flavor\': "« En Akoum, si vous voyez soudain une ombre au-dessus de vous, la pire chose à faire, c\'est de vous baisser. » —Chadir le navigateur", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215626&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1bd246c3-6cfe-4d73-8c1f-9430ead6f117\', \'multiverseId\': 215626}, \'multiverseid\': 215626}, {\'name\': \'Piedemacigno di Akoum\', \'text\': \'Quando il Piedemacigno di Akoum entra nel campo di battaglia, infligge 1 danno a una creatura o a un giocatore bersaglio.\', \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': \'"Se sei in Akoum e intravedi un\\\'ombra sopra di te, la cosa peggiore che tu possa fare è chinarti." —Chadir il Navigatore\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216370&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2e9515ef-991e-46b0-b271-65478bf66411\', \'multiverseId\': 216370}, \'multiverseid\': 216370}, {\'name\': \'アクームの岩足\', \'text\': \'アクームの岩足が戦場に出たとき、クリーチャー１体かプレイヤー１人を対象とする。アクームの岩足はそれに１点のダメージを与える。\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': \'「アクームで頭上に影がさしたら、一番やっちゃいけないのはかがむことだな。」 ――航海士シャーディア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216618&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'26a0f6e0-518d-4485-a878-64e9a1c59140\', \'multiverseId\': 216618}, \'multiverseid\': 216618}, {\'name\': \'Pé-de-Pedra de Akoum\', \'text\': \'Quando Pé-de-Pedra de Akoum entra no campo de batalha, ele causa 1 ponto de dano à criatura ou ao jogador alvo.\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': \'"Se estiver em Akoum e avistar uma sombra sobre sua cabeça, a pior coisa a fazer é agachar-se." — Chadir, o Navegador\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cdc27962-1b57-4be6-82fe-560de3358268\', \'multiverseId\': 216866}, \'multiverseid\': 216866}, {\'name\': \'Акумский Глыбоступ\', \'text\': \'Когда Акумский Глыбоступ выходит на поле битвы, он наносит 1 повреждение целевому существу или игроку.\', \'type\': \'Существо — Гигант Воин\', \'flavor\': \'«Если вы находитесь в Акуме и заметили нависшую над головой тень, самое худшее, что вы можете сделать, это пригнуться». — Чадир-Штурман\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215874&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'69288cc4-14b2-4d92-8456-7094347592f6\', \'multiverseId\': 215874}, \'multiverseid\': 215874}, {\'name\': \'阿库姆沉足巨人\', \'text\': \'当阿库姆沉足巨人进战场时，它对目标生物或牌手造成1点伤害。\', \'type\': \'生物～巨人／战士\', \'flavor\': \'「如果你在阿库姆，并且瞥到头上有阴影，弯身低头会是你最糟糕的应变方式。」 ～领航者洽迪\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216122&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f106f54-cd13-438c-83e5-d43af66f7476\', \'multiverseId\': 216122}, \'multiverseid\': 216122}]', "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217527&type=card', 'language': 'German', 'identifiers': {'scryfallId': '70505d49-2587-4976-bd55-475c9fee6269', 'multiverseId': 217527}, 'multiverseid': 217527}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217279&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1e3ffa43-6058-4eb2-808f-4e05856931c5', 'multiverseId': 217279}, 'multiverseid': 217279}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215791&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8c2edbaa-553e-4558-ac9b-a65ccc713ae6', 'multiverseId': 215791}, 'multiverseid': 215791}, {'name': 'Foresta', 'text': '{G}', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216535&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8aabe604-7966-4aa3-863b-6d563ed31c89', 'multiverseId': 216535}, 'multiverseid': 216535}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216783&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cc4ff029-16f3-46a4-8746-a094e6c92f9c', 'multiverseId': 216783}, 'multiverseid': 216783}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217031&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0f23a989-446b-45a9-a41a-006d3dfd2d28', 'multiverseId': 217031}, 'multiverseid': 217031}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216039&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '00909867-0465-46f9-8bc2-46a4a99bd545', 'multiverseId': 216039}, 'multiverseid': 216039}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216287&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '57d5b104-b0aa-4b99-a174-bc83d87d1338', 'multiverseId': 216287}, 'multiverseid': 216287}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217532&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c836a047-5790-4bf9-8221-a8647e67f733', 'multiverseId': 217532}, 'multiverseid': 217532}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217284&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ca14f386-63c2-46d8-8697-53284b0cde81', 'multiverseId': 217284}, 'multiverseid': 217284}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215796&type=card', 'language': 'French', 'identifiers': {'scryfallId': '52ef2a44-31ee-4c1e-aced-9342a29c0b5e', 'multiverseId': 215796}, 'multiverseid': 215796}, {'name': 'Foresta', 'text': '{G}', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216540&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3daf9de0-dc9f-4efd-b383-622d2b9fa853', 'multiverseId': 216540}, 'multiverseid': 216540}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216788&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ced1528c-bd11-4355-b3b1-7630c51816b3', 'multiverseId': 216788}, 'multiverseid': 216788}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217036&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '27adda33-5a8e-4e13-a665-b1b34845053b', 'multiverseId': 217036}, 'multiverseid': 217036}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216044&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '99e128ae-5ee1-4ed0-86e5-433017831f11', 'multiverseId': 216044}, 'multiverseid': 216044}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216292&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '082bdd8f-4ac6-482c-8265-86be91cd01be', 'multiverseId': 216292}, 'multiverseid': 216292}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217533&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0964bfe3-04d0-40c9-b405-48a7ba0d8993', 'multiverseId': 217533}, 'multiverseid': 217533}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217285&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'f17a41e9-d450-43b8-bf89-8431a8d1a7c8', 'multiverseId': 217285}, 'multiverseid': 217285}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215797&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1301edc9-002d-43ac-a920-3c8c3c01f1ea', 'multiverseId': 215797}, 'multiverseid': 215797}, {'name': 'Foresta', 'text': '{G}', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216541&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'fcedd87a-4114-4cbb-b825-ed9783ef7088', 'multiverseId': 216541}, 'multiverseid': 216541}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216789&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '052ed789-2a46-4672-a9e1-45eacb52c700', 'multiverseId': 216789}, 'multiverseid': 216789}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217037&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '96919935-25e3-460f-8b0d-8565b6ba4722', 'multiverseId': 217037}, 'multiverseid': 217037}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216045&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e263ca28-3c2b-4353-b260-902354ac41a0', 'multiverseId': 216045}, 'multiverseid': 216045}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216293&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dddf5c28-a5ef-413a-bde5-dae92c959a53', 'multiverseId': 216293}, 'multiverseid': 216293}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217545&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dacb8366-70fe-4d9c-9aa8-7af76047a5b0', 'multiverseId': 217545}, 'multiverseid': 217545}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217297&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0d5db75d-ed40-4f98-bb0d-20b93791054a', 'multiverseId': 217297}, 'multiverseid': 217297}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215809&type=card', 'language': 'French', 'identifiers': {'scryfallId': '8894eb5d-126d-45ea-ac2c-4223f4c40c4a', 'multiverseId': 215809}, 'multiverseid': 215809}, {'name': 'Foresta', 'text': '{G}', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216553&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e48e27bf-63b6-4190-acaf-9d5e64c522ba', 'multiverseId': 216553}, 'multiverseid': 216553}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216801&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1012220d-af45-4a9b-95b8-68f44ff3c1a3', 'multiverseId': 216801}, 'multiverseid': 216801}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217049&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2edd81ea-3da5-4db8-8261-bf032fd8b328', 'multiverseId': 217049}, 'multiverseid': 217049}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216057&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '058526cc-340a-403b-86e1-afd8c66e579b', 'multiverseId': 216057}, 'multiverseid': 216057}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216305&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b53d2ccb-0064-46f8-9800-d6614693822b', 'multiverseId': 216305}, 'multiverseid': 216305}]", '[{\'name\': \'Wegbahner aus Mul Daya\', \'text\': \'Die oberste Karte deiner Bibliothek ist offen.\\nSolange die oberste Karte deiner Bibliothek eine Kreaturenkarte ist, erhält der Wegbahner aus Mul Daya +3/+3.\\nSolange die oberste Karte deiner Bibliothek ein Land ist, hat der Wegbahner aus Mul Daya „{T}: Erhöhe deinen Manavorrat um zwei Mana genau einer beliebigen Farbe".\', \'type\': \'Kreatur — Elf, Druide, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217495&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e39f6d34-9696-48b6-b15d-6e1ef30d555c\', \'multiverseId\': 217495}, \'multiverseid\': 217495}, {\'name\': \'Canalizadoras Mul Daya\', \'text\': \'Juega mostrando la primera carta de tu biblioteca.\\nMientras la primera carta de tu biblioteca sea una carta de criatura, las Canalizadoras Mul Daya obtienen +3/+3.\\nMientras la primera carta de tu biblioteca sea una carta de tierra, las Canalizadoras Mul Daya tienen "{T}: Agrega dos maná de un color cualquier a tu reserva de maná".\', \'type\': \'Criatura — Chamán druida elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217247&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59e45b25-00ad-4e2c-bbd9-c3b59d13e94c\', \'multiverseId\': 217247}, \'multiverseid\': 217247}, {\'name\': \'Canalisatrices de Mul Daya\', \'text\': "Jouez avec la carte du dessus de votre bibliothèque révélée.\\nTant que la carte du dessus de votre bibliothèque est une carte de créature, les Canalisatrices de Mul Daya gagnent +3/+3.\\nTant que la carte du dessus de votre bibliothèque est une carte de terrain, les Canalisatrices de Mul Daya ont « {T} : Ajoutez deux manas d\'une même couleur de votre choix à votre réserve. »", \'type\': \'Créature : elfe et druide et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215759&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c1eced24-7193-4ad1-8287-aa7efcfad182\', \'multiverseId\': 215759}, \'multiverseid\': 215759}, {\'name\': \'Incanalatrici di Mul Daya\', \'text\': \'Gioca con la prima carta del tuo grimorio rivelata.\\nFintanto che la prima carta del tuo grimorio è una carta creatura, le Incanalatrici di Mul Daya prendono +3/+3.\\nFintanto che la prima carta del tuo grimorio è una carta terra, le Incanalatrici di Mul Daya hanno "{T}: Aggiungi due mana di un qualsiasi colore alla tua riserva di mana".\', \'type\': \'Creatura — Sciamano Druido Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216503&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b8ebacfb-2c88-41c2-bd59-192c631445e1\', \'multiverseId\': 216503}, \'multiverseid\': 216503}, {\'name\': \'ムル・ダヤの媒介者\', \'text\': \'あなたのライブラリーの一番上のカードを公開したままプレイする。\\nあなたのライブラリーの一番上のカードがクリーチャー・カードであるかぎり、ムル・ダヤの媒介者は＋３/＋３の修整を受ける。\\nあなたのライブラリーの一番上のカードが土地カードであるかぎり、ムル・ダヤの媒介者は「{T}：あなたのマナ・プールに、好きな色１色のマナ２点を加える。」を持つ。\', \'type\': \'クリーチャー — エルフ・ドルイド・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216751&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2bc3c3c9-b015-409e-be97-6105e89ce636\', \'multiverseId\': 216751}, \'multiverseid\': 216751}, {\'name\': \'Canalizadores de Mul Daya\', \'text\': \'Jogue com o card do topo de seu grimório revelado.\\nEnquanto o card do topo de seu grimório for um card de criatura, Canalizadores de Mul Daya receberá +3/+3.\\nEnquanto o card do topo de seu grimório for um card de terreno, Canalizadores de Mul Daya terá "{T}: Adicione dois manas de qualquer cor à sua reserva de mana."\', \'type\': \'Criatura — Elfo Druida Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216999&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'84840f84-8361-485f-9ff4-ccf4e348b83d\', \'multiverseId\': 216999}, \'multiverseid\': 216999}, {\'name\': \'Мул-Дайские Проводницы\', \'text\': \'Играйте с открытой верхней картой вашей библиотеки.\\nПока верхняя карта вашей библиотеки — карта существа, Мул-Дайские Проводницы получают +3/+3.\\nПока верхняя карта вашей библиотеки — карта земли, Мул-Дайские Проводницы имеют способность «{T}: добавьте две маны любого одного цвета в ваше хранилище маны».\', \'type\': \'Существо — Эльф Друид Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216007&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'be7344f2-a8b3-4058-b174-9ac408ccd5ad\', \'multiverseId\': 216007}, \'multiverseid\': 216007}, {\'name\': \'慕达雅通念师\', \'text\': \'你以展示牌库顶牌的方式进行游戏。\\n只要你的牌库顶牌是生物牌，慕达雅通念师便得+3/+3。\\n只要你的牌库顶牌是地牌，慕达雅通念师便具有「{T}：加两点任意颜色的单色法术力到你的法术力池中。」\', \'type\': \'生物～妖精／德鲁伊／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216255&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'71d2c5f1-cf53-4d0f-b759-c584319f206e\', \'multiverseId\': 216255}, \'multiverseid\': 216255}]', "[{'name': 'Wellenbeobachter aus Halimar', 'text': 'Stufe aufsteigen {2} ({2}: Lege eine Stufenmarke auf diese Karte. Spiele Stufe aufsteigen wie eine Hexerei.)\\nSTUFE 1-4\\n0/6\\nSTUFE 5+\\n6/6\\nInseltarnung', 'type': 'Kreatur — Meervolk, Soldat', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217485&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'dca0621e-684c-4535-9ba7-81f4da11b616', 'multiverseId': 217485}, 'multiverseid': 217485}, {'name': 'Vigilaolas de Halimar', 'text': 'Subir de nivel {2}. ({2}: Pon un contador de nivel sobre esto. Sube de nivel sólo como un conjuro.)\\nNIVEL 1-4\\n0/6\\nNIVEL 5+\\n6/6\\nCruza islas.', 'type': 'Criatura — Soldado tritón', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217237&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3271155c-b418-4022-96b5-afb36f395acb', 'multiverseId': 217237}, 'multiverseid': 217237}, {'name': 'Veilleurs des vagues de Halimar', 'text': 'Montée de niveau {2} ({2} : Mettez un marqueur « niveau » sur cette créature. Ne montez de niveau que lorsque vous pourriez lancer un rituel.)\\nNIVEAU 1-4\\n0/6\\nNIVEAU 5+\\n6/6\\nTraversée des îles', 'type': 'Créature : ondin et soldat', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215749&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'a81f4d1d-3cb0-4d17-bcb9-464956a7a1a1', 'multiverseId': 215749}, 'multiverseid': 215749}, {'name': 'Pattuglia delle Onde di Halimar', 'text': 'Aumentare di livello {2} ({2}: Metti un segnalino livello su questa creatura. Aumenta di livello solo quando potresti lanciare una stregoneria.)\\nLIVELLO 1-4\\n0/6\\nLIVELLO 5+\\n6/6\\nPassa-Isole', 'type': 'Creatura — Soldato Tritone', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216493&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c211bc69-8f0f-415c-84e6-6dfa3f152f57', 'multiverseId': 216493}, 'multiverseid': 216493}, {'name': 'ハリマーの波見張り', 'text': 'Lvアップ {2} ({2}：この上にLvカウンターを１個置く。 Lvアップはソーサリーとしてのみ行う。）\\nLv 1-4\\n0/6\\nLv 5+\\n6/6\\n島渡り', 'type': 'クリーチャー — マーフォーク･兵士', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216741&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '10e5f15d-c341-4ad5-ab07-c223fc420d64', 'multiverseId': 216741}, 'multiverseid': 216741}, {'name': 'Vigia de Ondas de Halimar', 'text': 'Subir de nível {2} ({2}: Coloque um marcador de nível nesta criatura. Suba de nível somente quando puder jogar um feitiço.)\\nNÍVEL 1-4\\n0/6\\nNÍVEL 5+\\n6/6\\nTravessia de ilha', 'type': 'Criatura — Tritão Soldado', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216989&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '70f90877-4653-4cd3-9570-bedb7598d9e2', 'multiverseId': 216989}, 'multiverseid': 216989}, {'name': 'Халимарский Волновой Дозор', 'text': 'Повышение уровня {2} ({2}: положите один жетон уровня на это существо. Повышайте уровень только как волшебство.)\\nУРОВЕНЬ 1-4\\n0/6\\nУРОВЕНЬ 5+\\n6/6\\nЗнание Островов', 'type': 'Существо — Мерфолк Солдат', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215997&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1cda1570-9b17-4593-aa54-3c5e6fee0fe6', 'multiverseId': 215997}, 'multiverseid': 215997}, {'name': '哈利玛波涛守卫', 'text': '升级{2} （{2}：在其上放置一个等级指示物。 升级的时机视同法术。）\\n等级1-4\\n0/6\\n等级5+\\n6/6\\n海岛行者', 'type': '生物～人鱼／士兵', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216245&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '242beaad-b8ae-47ae-b8c2-331f259ab70c', 'multiverseId': 216245}, 'multiverseid': 216245}]", '[{\'name\': \'Welt im Krieg\', \'text\': \'In diesem Zug gibt es nach der ersten dem Kampf folgenden Hauptphase eine zusätzliche Kampfphase, gefolgt von einer weiteren Hauptphase. Enttappe zu Beginn dieses Kampfes alle Kreaturen, die in diesem Zug angegriffen haben.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217347&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'37c5dda0-ecdc-4065-8198-03d23f6ce09d\', \'multiverseId\': 217347}, \'multiverseid\': 217347}, {\'name\': \'Mundo en guerra\', \'text\': \'Después de la primera fase principal poscombate este turno, hay una fase de combate adicional seguida de una fase principal adicional. Al comienzo de ese combate, endereza todas las criaturas que atacaron este turno.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217099&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1aec833f-7309-4abd-a34e-09c9e6a057b3\', \'multiverseId\': 217099}, \'multiverseid\': 217099}, {\'name\': \'Un monde en guerre\', \'text\': "La première phase principale post-combat ce tour-ci est suivie d\'une phase de combat supplémentaire, puis d\'une phase principale supplémentaire. Au début de ce combat, dégagez toutes les créatures qui ont attaqué ce tour-ci.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215611&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f85e5b1a-635e-4fb7-8fd5-9861285b2482\', \'multiverseId\': 215611}, \'multiverseid\': 215611}, {\'name\': \'Mondo in Guerra\', \'text\': "Dopo la prima fase principale post-combattimento in questo turno, c\'è una fase di combattimento addizionale seguita da una fase principale addizionale. All\'inizio di quel combattimento, STAPpa tutte le creature che hanno attaccato in questo turno.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216355&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b71cc003-6740-4a75-a0a7-bb5c19463f0a\', \'multiverseId\': 216355}, \'multiverseid\': 216355}, {\'name\': \'世界大戦\', \'text\': \'このターンの最初の戦闘後メイン・フェイズの後に、追加の戦闘フェイズとそれに続く追加のメイン・フェイズを加える。 その戦闘の開始時に、このターン攻撃していたすべてのクリーチャーをアンタップする。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216603&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d9948b7-d2dd-4562-930c-bf643ae89a62\', \'multiverseId\': 216603}, \'multiverseid\': 216603}, {\'name\': \'Mundo em Guerra\', \'text\': \'Após a primeira fase principal de pós-combate neste turno, há uma fase de combate adicional seguida por uma fase principal adicional. No início daquele combate, desvire todas as criaturas que atacaram neste turno.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216851&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7232e343-5ecf-4d90-80f8-047c98472043\', \'multiverseId\': 216851}, \'multiverseid\': 216851}, {\'name\': \'Воюющий Мир\', \'text\': \'После первой послебоевой главной фазы в этом ходу идет дополнительная фаза боя, а за ней — дополнительная главная фаза. В начале того боя разверните все существа, атаковавшие в этом ходу.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215859&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4ec1915-f4c3-4584-b031-8243f0f6e4ab\', \'multiverseId\': 215859}, \'multiverseid\': 215859}, {\'name\': \'全世交战\', \'text\': \'在本回合第一个战斗后的行动阶段之后，额外多出一个战斗阶段，以及接于其后之一个额外的行动阶段。 在该次战斗开始时，重置所有于本回合攻击过的生物。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216107&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'77ac0ea2-8ac3-4320-b657-5e78a66076d9\', \'multiverseId\': 216107}, \'multiverseid\': 216107}]', '[{\'name\': \'Wiederkehrende Einblicke\', \'text\': \'Ziehe so viele Karten, wie ein Gegner deiner Wahl auf der Hand hat.\\nAbprall (Falls du diesen Zauberspruch aus deiner Hand wirkst, schicke ihn ins Exil, sowie er verrechnet wird. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217478&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'602bca0e-5059-4eec-9476-53e780b26e84\', \'multiverseId\': 217478}, \'multiverseid\': 217478}, {\'name\': \'Perspicacia recurrente\', \'text\': \'Roba una cantidad de cartas igual al número de cartas en la mano del oponente objetivo.\\nRebote. (Si lanzas este hechizo de tu mano, exílialo en cuanto se resuelve. Al comienzo de tu próximo mantenimiento, puedes lanzar esta carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217230&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0119d0a3-0791-490e-b780-74a5f1be1515\', \'multiverseId\': 217230}, \'multiverseid\': 217230}, {\'name\': \'Perspicacité récurrente\', \'text\': "Piochez un nombre de cartes égal au nombre de cartes dans la main de l\'adversaire ciblé.\\nRebond (Si vous lancez ce sort depuis votre main, exilez-le au moment où il se résout. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215742&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'daf889fd-7638-456b-9e12-7f00faf19b92\', \'multiverseId\': 215742}, \'multiverseid\': 215742}, {\'name\': \'Introspezione Ricorrente\', \'text\': "Pesca un numero di carte pari a quelle in mano a un avversario bersaglio.\\nRipresa (Se lanci questa magia dalla tua mano, esiliala quando si risolve. All\'inizio del tuo prossimo mantenimento, puoi lanciare questa carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216486&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7142b193-13fa-4aa9-afe8-f19f3725b7b2\', \'multiverseId\': 216486}, \'multiverseid\': 216486}, {\'name\': \'繰り返すひらめき\', \'text\': \'対戦相手１人を対象とし、そのプレイヤーの手札にあるカードの枚数に等しい枚数のカードを引く。\\n反復 （あなたがこの呪文をあなたの手札から唱えた場合、それの解決に際し、それを追放する。 あなたの次のアップキープの開始時に、あなたはこのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216734&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1a6fd2bf-ab3d-4f81-81bf-2be110d88eb3\', \'multiverseId\': 216734}, \'multiverseid\': 216734}, {\'name\': \'Ideia Recorrente\', \'text\': \'Compre uma quantidade de cards igual ao número de cards na mão do oponente alvo.\\nRebote (Se conjurar esta mágica da sua mão, exile-a quando ela for resolvida. No início de sua próxima manutenção, você poderá conjurar este card do exílio sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216982&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'814d3b9d-c2e8-479e-aba4-d5f1f6d05ca3\', \'multiverseId\': 216982}, \'multiverseid\': 216982}, {\'name\': \'Повторяющееся Прозрение\', \'text\': \'Возьмите столько карт, сколько карт находится в руке целевого оппонента.\\nОтскок (Если вы разыгрываете это заклинание из вашей руки, изгоните его в момент его разрешения. В начале вашего следующего шага поддержки вы можете разыграть эту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215990&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'75249fe2-2a37-4e15-9d71-84b7d6d88135\', \'multiverseId\': 215990}, \'multiverseid\': 215990}, {\'name\': \'洞察再现\', \'text\': \'抓等同于目标对手之手牌数量的牌。\\n弹回 （如果你从你手上施放此牌，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放此牌，且不须支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216238&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8fe6d582-38cc-48d7-8acd-65008cae7e09\', \'multiverseId\': 216238}, \'multiverseid\': 216238}]', '[{\'name\': \'Wildherz-Beschwörer\', \'text\': \'{8}: Eine Kreatur deiner Wahl erhält +5/+5 und verursacht Trampelschaden bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Das Leben, wie wir es kennen, ist vom Aussterben bedroht. Wir müssen die Stärke zeigen, die sie von uns stehlen wollen." —Die Geschichten der Beschwörer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217300&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c93bd36a-e76d-40ac-a61d-6c83714aaf6f\', \'multiverseId\': 217300}, \'multiverseid\': 217300}, {\'name\': \'Invocadora del corazón salvaje\', \'text\': \'{8}: La criatura objetivo obtiene +5/+5 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"La vida tal y como la conocemos está al borde de la extinción. Debemos mostrar la fuerza que podrían robarnos." —Cuentos de los invocadores\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217052&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1843fb7b-134c-4b59-b7d8-5cdcea6a20b6\', \'multiverseId\': 217052}, \'multiverseid\': 217052}, {\'name\': \'Invocatrice au cœur sauvage\', \'text\': "{8} : La créature ciblée gagne +5/+5 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et shamane\', \'flavor\': "« La vie telle que nous la connaissons vacille au bord de l\'extinction. Nous devons faire preuve du courage dont ils veulent nous déposséder. » —Les Contes des Invocateurs", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215564&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1499b33d-045d-4f54-aa55-103ab51a178e\', \'multiverseId\': 215564}, \'multiverseid\': 215564}, {\'name\': \'Evocatrice di Cuore Selvaggio\', \'text\': \'{8}: Una creatura bersaglio prende +5/+5 e ha travolgere fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"La vita per come la conosciamo è sospesa sull\\\'orlo dell\\\'estinzione. Dobbiamo mostrare la forza che ci vorrebbero sottrarre." —Racconti degli Evocatori\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216308&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4806d41-56e1-476c-896a-9dfd2343d825\', \'multiverseId\': 216308}, \'multiverseid\': 216308}, {\'name\': \'野心の発動者\', \'text\': \'{8}：クリーチャー１体を対象とする。それはターン終了時まで、＋５/＋５の修整を受けるとともにトランプルを得る。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「ご存知の通り、我々の生命は絶滅の淵にぶら下がっている状態だ。 奴らが我々から奪おうとしている物の力を見せようではないか。」 ――「発動者伝」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216556&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4d63b7fb-6f31-4bfc-9fcd-dd38e36584b3\', \'multiverseId\': 216556}, \'multiverseid\': 216556}, {\'name\': \'Invocador do Coração Selvagem\', \'text\': \'{8}: A criatura alvo recebe +5/+5 e ganha atropelar até o final do turno.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"A vida como nós a conhecemos está à beira da extinção. Precisamos mostrar a força que eles roubariam de nós." — Lendas dos Invocadores\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216804&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3dbe4e6a-14cb-4254-b540-3669e8e29650\', \'multiverseId\': 216804}, \'multiverseid\': 216804}, {\'name\': \'Призывательница Дикого Сердца\', \'text\': \'{8}: целевое существо получает +5/+5 и Пробивной удар до конца хода.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«Жизнь, какой мы ее знаем, находится на грани вымирания. Мы должны показать силу, которую у нас хотят отобрать». — Сказания призывателей\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215812&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'828b8cf5-03c1-4d6b-93fa-c3fd6b674fb1\', \'multiverseId\': 215812}, \'multiverseid\': 215812}, {\'name\': \'蛮心召现师\', \'text\': \'{8}：目标生物得+5/+5且获得践踏异能直到回合结束。\', \'type\': \'生物～妖精／祭师\', \'flavor\': \'「我们所熟悉的生活已面临存亡关头。 面对意图将之夺走者，我们必须展现力量。」 ～《召现师传说》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'092d6b55-af5d-4de9-a1e5-68697a3d4d75\', \'multiverseId\': 216060}, \'multiverseid\': 216060}]', '[{\'name\': \'Wimpelklinge\', \'text\': \'Die ausgerüstete Kreatur erhält +1/+1 für jede Kreatur, die du kontrollierst.\\nAusrüsten {4}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Das mit dem Wimpel eines zerstörten Außenposten geschmückte Schwert wurde zum Symbol der sich vereinigenden Völker Zendikars.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217378&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5ba00d6-0000-474d-94a6-99329152a220\', \'multiverseId\': 217378}, \'multiverseid\': 217378}, {\'name\': \'Espada estandarte\', \'text\': \'La criatura equipada obtiene +1/+1 por cada criatura que controlas.\\nEquipar {4}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Envuelta en el estandarte de un destacamento destruido, la espada simboliza a los pueblos unidos de Zendikar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217130&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'57ba842d-1cfb-4591-9b14-19ae75436250\', \'multiverseId\': 217130}, \'multiverseid\': 217130}, {\'name\': \'Lame à pennon\', \'text\': \'La créature équipée gagne +1/+1 pour chaque créature que vous contrôlez.\\nÉquipement {4}\', \'type\': \'Artefact : équipement\', \'flavor\': "Ornée du pennon d\'un avant-poste anéanti, l\'épée finit par symboliser l\'union des peuples de Zendikar.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215642&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'61f4e86a-2209-4339-985a-92a10a63f16a\', \'multiverseId\': 215642}, \'multiverseid\': 215642}, {\'name\': \'Lama del Vessillo\', \'text\': \'La creatura equipaggiata prende +1/+1 per ogni creatura che controlli.\\nEquipaggiare {4}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Avvolta nel vessillo di un avamposto sconfitto, la spada divenne il simbolo dei popoli di Zendikar uniti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216386&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'654562bb-4669-4fe4-9539-a2b769c0ec0f\', \'multiverseId\': 216386}, \'multiverseid\': 216386}, {\'name\': \'団旗の刃\', \'text\': \'装備しているクリーチャーは、あなたがコントロールするクリーチャー１体につき＋１/＋１の修整を受ける。\\n装備 {4}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'倒された前哨地の旗に飾られたその剣は、ゼンディカーの人々が一つになったシンボルとなった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216634&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dc08f3bb-e72a-48e3-b714-7b8e2f11042c\', \'multiverseId\': 216634}, \'multiverseid\': 216634}, {\'name\': \'Espada do Pendão\', \'text\': \'A criatura equipada recebe +1/+1 para cada criatura que você controla.\\nEquipar {4}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'Coberta com o pendão de um posto avançado conquistado, a espada passou a simbolizar a união de todos os povos de Zendikar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216882&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9838c2f2-c3e6-40cf-90b6-6f01e2d89a7f\', \'multiverseId\': 216882}, \'multiverseid\': 216882}, {\'name\': \'Клинок с Вымпелом\', \'text\': \'Снаряженное существо получает +1/+1 за каждое существо под вашим контролем.\\nСнарядить {4}\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'Украшенный вымпелом павшей заставы, этот меч стал символом народов Зендикара, объединившихся перед лицом опасности.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215890&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3795e18f-96b3-4540-9dd3-d16f944d9c77\', \'multiverseId\': 215890}, \'multiverseid\': 215890}, {\'name\': \'旗帜刃\', \'text\': \'你每操控一个生物，佩带此武具的生物便得+1/+1。\\n佩带{4}\', \'type\': \'神器～武具\', \'flavor\': \'此剑饰以陷落的哨站旗帜，象征着赞迪卡的人民齐心合力。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216138&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'474c77af-95bf-418b-be6b-804e55122276\', \'multiverseId\': 216138}, \'multiverseid\': 216138}]', '[{\'name\': \'Wolke des Zorns\', \'text\': \'Verteidiger, Fliegend\\n{1}{R}: Eine Kreatur deiner Wahl greift in diesem Zug an, falls möglich.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Das ganze Dorf wusste, dass dies keine normale Wolke war, als der alte Priester Mandli sich plötzlich eine Axt griff und schreiend in die Hügel rannte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217326&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3e6ec253-8cc8-4156-ab64-67b48b9c7834\', \'multiverseId\': 217326}, \'multiverseid\': 217326}, {\'name\': \'Nimbo de furia\', \'text\': \'Defensor, vuela.\\n{1}{R}: La criatura objetivo ataca este turno si puede.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'El destacamento sabía que algo raro pasaba con la nube cuando el viejo sacerdote Mandli de pronto tomó un hacha y corrió hacia las colinas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217078&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c3cca04c-4b7a-4ced-8a41-b48f25de65b7\', \'multiverseId\': 217078}, \'multiverseid\': 217078}, {\'name\': \'Nimbus de rage\', \'text\': \'Défenseur, vol\\n{1}{R} : La créature ciblée attaque ce tour-ci si possible.\', \'type\': \'Créature : élémental\', \'flavor\': "Toute la communauté comprit que le nuage avait quelque chose de bizarre quand le vieux prêtre Mandli s\'empara d\'une hache et courut vers les collines en hurlant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215590&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4b117ab4-7c81-41e9-9595-d1607cf8cbae\', \'multiverseId\': 215590}, \'multiverseid\': 215590}, {\'name\': "Nembo dell\'Ira", \'text\': \'Difensore, volare\\n{1}{R}: Una creatura bersaglio attacca in questo turno, se può farlo.\', \'type\': \'Creatura — Elementale\', \'flavor\': "L\'insediamento capì che c\'era qualcosa di strano nella nuvola quando il vecchio prete Mandli all\'improvviso afferrò un\'ascia e si lanciò urlando verso le colline.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216334&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ec5544f-b572-402b-b2a0-ee4a8f9a342e\', \'multiverseId\': 216334}, \'multiverseid\': 216334}, {\'name\': \'怒りの雨雲\', \'text\': \'防衛、飛行\\n{1}{R}：クリーチャー１体を対象とする。このターン、それは可能なら攻撃する。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'入植者は、老僧のマンドリが突如斧をつかんで叫びながら丘へ走っていたっとき、その雲が何かおかしい事を知った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216582&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc045f2d-bee5-42b4-baa6-1336ed218770\', \'multiverseId\': 216582}, \'multiverseid\': 216582}, {\'name\': \'Nimbo da Cólera\', \'text\': \'Defensor, voar\\n{1}{R}: A criatura alvo ataca neste turno se estiver apta.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'O assentamento percebeu que havia algo de estranho com a nuvem quando o velho sacerdote Mandli de repente agarrou um machado e correu gritando na direção das colinas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216830&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0cc20a64-7d7c-40eb-9c1a-5e08ed65f84b\', \'multiverseId\': 216830}, \'multiverseid\': 216830}, {\'name\': \'Туча Ярости\', \'text\': \'Защитник, Полет\\n{1}{R}: целевое существо атакует в этом ходу, если может.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Поселяне поняли, что облако какое-то странное, когда старый священник Мандли вдруг схватил топор и с криком бросился в горы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215838&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'69d8b9c7-86f8-49e1-95b6-112e30a69bab\', \'multiverseId\': 215838}, \'multiverseid\': 215838}, {\'name\': \'愤怒玄云\', \'text\': \'守军，飞行\\n{1}{R}：目标生物本回合若能攻击，则必须攻击。\', \'type\': \'生物～元素\', \'flavor\': \'老僧曼德利突然拎起斧头、大叫着冲上山坡，于是聚落的人明白这片云不太对劲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216086&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8be957af-621a-410d-abb5-66fd0dcb4c3b\', \'multiverseId\': 216086}, \'multiverseid\': 216086}]', '[{\'name\': \'Zeit der Helden\', \'text\': \'Jede Kreatur, die du kontrollierst und auf der mindestens eine Stufenmarke liegt, erhält +2/+2.\', \'type\': \'Verzauberung\', \'flavor\': \'Niemand sprach. Das war auch nicht nötig. Die Bedrohung durch die Eldrazi ließ nur zwei Möglichkeiten offen: die Waffen niederzulegen und umsonst zu sterben, oder sie fester zu packen und zumindest für irgendetwas zu sterben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217322&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'814c6e64-254f-4d2a-9067-3b1f4263b1a2\', \'multiverseId\': 217322}, \'multiverseid\': 217322}, {\'name\': \'El tiempo de los héroes\', \'text\': \'Cada criatura que controlas con un contador de nivel sobre ella obtiene +2/+2.\', \'type\': \'Encantamiento\', \'flavor\': \'Nadie habló. No hacía falta. La amenaza de los eldrazi ofrecía una elección simple: dejar las armas y morir por nada, o sostenerlas firmes y morir por algo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217074&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9bc2f570-5079-4b43-a57c-7b8791db0fa7\', \'multiverseId\': 217074}, \'multiverseid\': 217074}, {\'name\': \'Temps des héros\', \'text\': \'Chaque créature que vous contrôlez avec un marqueur « niveau » sur elle gagne +2/+2.\', \'type\': \'Enchantement\', \'flavor\': "Personne ne pipa mot. C\'eut été inutile. La menace eldrazi simplifiait les choix : déposer les armes et mourir pour rien, ou les brandir et mourir pour quelque chose.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215586&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'212b731c-94dd-4301-867c-aec1bcbd0b30\', \'multiverseId\': 215586}, \'multiverseid\': 215586}, {\'name\': \'Il Tempo degli Eroi\', \'text\': \'Ogni creatura con un segnalino livello che controlli prende +2/+2.\', \'type\': \'Incantesimo\', \'flavor\': \'Nessuno parlò. Non fu necessario. La minaccia degli Eldrazi presentava una scelta molto semplice: deporre le armi e morire per nulla o tenerle ben salde e morire per qualcosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216330&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'00e28066-ce48-4815-8bfe-5404c94bbbef\', \'multiverseId\': 216330}, \'multiverseid\': 216330}, {\'name\': \'英雄の時\', \'text\': \'あなたがコントロールするLvカウンターが置かれている各クリーチャーは＋２/＋２の修整を受ける。\', \'type\': \'エンチャント\', \'flavor\': \'誰もが言葉を発しなかった。 その必要が無かったから。 エルドラージの脅威に対しては、単純な選択しかなかった。武器を置いて無力に死すか、武器を握り締めて微力に死すか。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216578&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cca30359-fcb1-4559-9d46-0c22dcc74eeb\', \'multiverseId\': 216578}, \'multiverseid\': 216578}, {\'name\': \'Tempo de Heróis\', \'text\': \'Cada criatura que você controla com um marcador de nível recebe +2/+2.\', \'type\': \'Encantamento\', \'flavor\': \'Ninguém falou. Não houve necessidade. A ameaça dos Eldrazi apresentou uma escolha simples: abaixem suas armas e morram em vão ou se agarrem a elas e morram por uma causa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216826&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9d1d29c0-946d-4254-9369-7bd1b921e5d6\', \'multiverseId\': 216826}, \'multiverseid\': 216826}, {\'name\': \'Время Героев\', \'text\': \'Каждое существо под вашим контролем с жетоном уровня на нем получает +2/+2.\', \'type\': \'Чары\', \'flavor\': \'Никто не проронил ни слова. Да и зачем? Угроза Эльдрази представляла простой выбор: сложить оружие и умереть ни за что, или дать отпор и умереть во имя благой цели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215834&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'586f7c2c-73d6-4475-a4cf-4e0582031f38\', \'multiverseId\': 215834}, \'multiverseid\': 215834}, {\'name\': \'英雄时刻\', \'text\': \'每个由你操控、且上面有等级指示物的生物都得+2/+2。\', \'type\': \'结界\', \'flavor\': \'没人出声。 也没这必要。 奥札奇的威胁当头，选择也很简单：不是放下武器无意义地死去，就是紧握武器为意义而奋战。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216082&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'019d7c6d-2152-41aa-a546-37c15f637528\', \'multiverseId\': 216082}, \'multiverseid\': 216082}]', '[{\'name\': \'Zone des Erwachens\', \'text\': \'Zu Beginn deines Versorgungssegments kannst du einen 0/1 farblosen (Eldrazi, Ausgeburt)-Kreaturenspielstein ins Spiel bringen. Er hat „Opfere diese Kreatur: Erhöhe deinen Manavorrat um {1}".\', \'type\': \'Verzauberung\', \'flavor\': \'Der Boden erbebte im Takt mit dem Surren des Polyeders, es war wie eine Totenklage der letzten Tage.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217363&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0872ddba-e595-4019-a8db-016608f15082\', \'multiverseId\': 217363}, \'multiverseid\': 217363}, {\'name\': \'Zona del despertar\', \'text\': \'Al comienzo de tu mantenimiento, puedes poner en el campo de batalla una ficha de criatura Engendro Eldrazi incolora 0/1. Tiene "Sacrificar esta criatura: Agrega {1} a tu reserva de maná".\', \'type\': \'Encantamiento\', \'flavor\': \'El suelo brotó con el retumbar del edro, un canto fúnebre de los últimos días.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217115&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c5f1f24d-968d-43ba-96bd-6e647e442122\', \'multiverseId\': 217115}, \'multiverseid\': 217115}, {\'name\': "Zone d\'éveil", \'text\': \'Au début de votre entretien, vous pouvez mettre sur le champ de bataille un jeton de créature 0/1 incolore Eldrazi et Engeance. Il a « Sacrifiez cette créature : Ajoutez {1} à votre réserve. »\', \'type\': \'Enchantement\', \'flavor\': "Le sol se fendit au rythme des raclements de l\'Hèdron, un glas annonçant les derniers jours.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215627&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'18844b27-2213-4830-8d39-01a2a3309358\', \'multiverseId\': 215627}, \'multiverseid\': 215627}, {\'name\': \'Zona del Risveglio\', \'text\': \'All\\\'inizio del tuo mantenimento, puoi mettere sul campo di battaglia una pedina creatura Progenie Eldrazi 0/1 incolore. Ha "Sacrifica questa creatura: Aggiungi {1} alla tua riserva di mana".\', \'type\': \'Incantesimo\', \'flavor\': "Il suolo esplose a tempo col tamburellare dell\'edro, una nenia dei giorni passati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216371&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8661aa2c-9ca1-4d49-8a2b-0cc6e67df4e1\', \'multiverseId\': 216371}, \'multiverseid\': 216371}, {\'name\': \'目覚めの領域\', \'text\': \'あなたのアップキープの開始時に、あなたは無色の０/１のエルドラージ・落とし子・クリーチャー・トークンを１体戦場に出してもよい。 それは「このクリーチャーを生け贄に捧げる：あなたのマナ・プールに{1}を加える。」を持つ。\', \'type\': \'エンチャント\', \'flavor\': \'大地は面晶体の音に答えて噴火し、最後の日の葬送曲を奏でた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216619&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db46991b-2e32-48d9-a81e-f005d7a595c8\', \'multiverseId\': 216619}, \'multiverseid\': 216619}, {\'name\': \'Zona do Despertar\', \'text\': \'No início de sua manutenção, você pode colocar no campo de batalha uma ficha de criatura incolor 0/1 do tipo Prole Eldrazi. Ela tem "Sacrifique esta criatura: Adicione {1} à sua reserva de mana."\', \'type\': \'Encantamento\', \'flavor\': \'O solo rompeu-se no momento em que o edro tamborilou, um lamento dos últimos dias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216867&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b6a4be34-6458-4186-bf51-75a943945b29\', \'multiverseId\': 216867}, \'multiverseid\': 216867}, {\'name\': \'Зона Пробуждения\', \'text\': \'В начале вашего шага поддержки вы можете положить на поле битвы одну фишку существа 0/1 бесцветный Эльдрази Порождение. У нее есть способность «Пожертвуйте это существо: добавьте {1} в ваше хранилище маны».\', \'type\': \'Чары\', \'flavor\': \'Земля разверзлась в такт гудению эдра — скорбному плачу о последних днях.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215875&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'19e6b05b-00a1-476d-b4fe-c86b658950fa\', \'multiverseId\': 215875}, \'multiverseid\': 215875}, {\'name\': \'觉醒区域\', \'text\': \'在你的维持开始时，你可以将一个0/1无色奥札奇／后裔衍生物放进战场。 它具有「牺牲此生物：加{1}到你的法术力池中。」\', \'type\': \'结界\', \'flavor\': \'晶石的响声有如末世挽歌，让大地随此节奏爆发。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216123&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d109ef2b-9e1c-46d6-a399-0477a937ea14\', \'multiverseId\': 216123}, \'multiverseid\': 216123}]', '[{\'name\': \'Zu Zeiten gewirkt\', \'text\': \'Spontanzauber und Hexereien, die du kontrollierst, haben Abprall. (Schicke den Zauberspruch ins Exil, sowie er verrechnet wird, falls du ihn aus deiner Hand gewirkt hast. Du kannst zu Beginn deines nächsten Versorgungssegments diese Karte aus dem Exil wirken, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217513&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'29fa35c8-9d1d-4f57-ae3e-9b03760ef00d\', \'multiverseId\': 217513}, \'multiverseid\': 217513}, {\'name\': \'Lanzar a través del tiempo\', \'text\': \'Los hechizos instantáneos y conjuros que controlas tienen la habilidad de rebote. (Exilia el hechizo en cuanto se resuelve si lo lanzaste de tu mano. Al comienzo de tu próximo mantenimiento, puedes lanzar esa carta desde el exilio sin pagar su coste de maná.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217265&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'651beb51-3e09-4dd3-8699-3fa8fe8cf1d0\', \'multiverseId\': 217265}, \'multiverseid\': 217265}, {\'name\': \'Lancement temporel\', \'text\': "Les sorts d\'éphémère et de rituel que vous contrôlez ont le rebond. (Exilez le sort au moment où il se résout si vous l\'avez lancé depuis votre main. Au début de votre prochain entretien, vous pouvez lancer cette carte depuis l\'exil sans payer son coût de mana.)", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215777&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d724e867-60f9-41eb-a281-18dcf9e6dda7\', \'multiverseId\': 215777}, \'multiverseid\': 215777}, {\'name\': \'Lanciare Nel Tempo\', \'text\': "Le magie istantaneo e stregoneria che controlli hanno ripresa. (Esilia la magia quando si risolve, se la lanci dalla tua mano. All\'inizio del tuo prossimo mantenimento, puoi lanciare quella carta dall\'esilio senza pagare il suo costo di mana.)", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216521&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f8b61d4d-b4d6-45ab-a4c9-f8a75f42b01b\', \'multiverseId\': 216521}, \'multiverseid\': 216521}, {\'name\': \'時を越えた詠唱\', \'text\': \'あなたがコントロールするインスタント呪文とソーサリー呪文は反復を持つ。 （その呪文の解決に際し、あなたがそれをあなたの手札からプレイした場合、それを追放する。 あなたの次のアップキープの開始時に、あなたはそのカードを追放領域からマナ・コストを支払うことなく唱えてもよい。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216769&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca61b588-685f-4511-8438-fa060cbd0292\', \'multiverseId\': 216769}, \'multiverseid\': 216769}, {\'name\': \'Conjurar no Tempo\', \'text\': \'Mágicas instantâneas e feitiços que você controla têm rebote. (Exile a mágica conforme ela é resolvida se você a conjurar da sua mão. No início de sua próxima manutenção, você poderá conjurar este card a partir do exílio sem pagar seu custo de mana.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217017&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c69adc2-d026-4d16-8bf0-b4e6a855ade9\', \'multiverseId\': 217017}, \'multiverseid\': 217017}, {\'name\': \'Бросок во Времени\', \'text\': \'Мгновенные заклинания и заклинания волшебства под вашим контролем имеют Отскок. (Изгоните заклинание в момент его разрешения, если вы разыгрываете его из вашей руки. В начале вашего следующего шага поддержки вы можете разыграть ту карту из изгнания без уплаты ее мана-стоимости.)\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216025&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd4c6b6a-88b2-4956-ab56-db2d26b70405\', \'multiverseId\': 216025}, \'multiverseid\': 216025}, {\'name\': \'历时施放\', \'text\': \'由你操控的瞬间与法术咒语具有弹回异能。 （如果你从你手上施放该咒语，于它结算时将之放逐。 在你的下一个维持开始时，你可以从放逐区施放该牌，且不须支付其法术力费用。）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216273&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'70918dea-4003-4065-b8e5-b835ba735e75\', \'multiverseId\': 216273}, \'multiverseid\': 216273}]', '[{\'name\': \'Zulaport-Vollstrecker\', \'text\': \'Stufe aufsteigen {4} ({4}: Lege eine Stufenmarke auf diese Karte. Spiele Stufe aufsteigen wie eine Hexerei.)\\nSTUFE 1-2\\n3/3\\nSTUFE 3+\\n5/5\\nDer Zulaport-Vollstrecker kann nicht geblockt werden, außer von schwarzen Kreaturen.\', \'type\': \'Kreatur — Mensch, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217494&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2cfd0879-b067-4c4a-870e-14c6c18c91f5\', \'multiverseId\': 217494}, \'multiverseid\': 217494}, {\'name\': \'Coaccionador de Zulaport\', \'text\': \'Subir de nivel {4}. ({4}: Pon un contador de nivel sobre esto. Sube de nivel sólo como un conjuro.)\\nNIVEL 1-2\\n3/3\\nNIVEL 3+\\n5/5\\nEl Coaccionador de Zulaport no puede ser bloqueado excepto por criaturas negras.\', \'type\': \'Criatura — Guerrero humano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217246&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f4a6940-925d-4eea-b673-a461342b8bf2\', \'multiverseId\': 217246}, \'multiverseid\': 217246}, {\'name\': \'Argousin de Zulaport\', \'text\': "Montée de niveau {4} ({4} : Mettez un marqueur « niveau » sur cette créature. Ne montez de niveau que lorsque vous pourriez lancer un rituel.)\\nNIVEAU 1-2\\n3/3\\nNIVEAU 3+\\n5/5\\nL\'Argousin de Zulaport ne peut pas être bloqué excepté par des créatures noires.", \'type\': \'Créature : humain et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215758&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4a288b4b-f661-4469-9350-61732454a66f\', \'multiverseId\': 215758}, \'multiverseid\': 215758}, {\'name\': \'Tutore di Zulaport\', \'text\': \'Aumentare di livello {4} ({4}: Metti un segnalino livello su questa creatura. Aumenta di livello solo quando potresti lanciare una stregoneria.)\\nLIVELLO 1-2\\n3/3\\nLIVELLO 3+\\n5/5\\nIl Tutore di Zulaport non può essere bloccato tranne che da creature nere.\', \'type\': \'Creatura — Guerriero Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216502&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b768d27e-4763-4676-a225-b9c75ec3c0eb\', \'multiverseId\': 216502}, \'multiverseid\': 216502}, {\'name\': \'ズーラポートの処罰者\', \'text\': \'Lvアップ {4} ({4}：この上にLvカウンターを１個置く。 Lvアップはソーサリーとしてのみ行う。）\\nLv 1-2\\n3/3\\nLv 3+\\n5/5\\nズーラポートの処罰者は、黒でないクリーチャーによってはブロックされない。\', \'type\': \'クリーチャー — 人間・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216750&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9870c496-504a-4752-94d8-c6915cf0aee0\', \'multiverseId\': 216750}, \'multiverseid\': 216750}, {\'name\': \'Impositor de Zulaport\', \'text\': \'Subir de nível {4} ({4}: Coloque um marcador de nível nesta criatura. Suba de nível somente quando puder jogar um feitiço.)\\nNÍVEL 1-2\\n3/3\\nNÍVEL 3+\\n5/5\\nImpositor de Zulaport só pode ser bloqueado por criaturas pretas.\', \'type\': \'Criatura — Humano Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216998&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e8d0db61-8829-4cd9-adff-65789a1771cb\', \'multiverseId\': 216998}, \'multiverseid\': 216998}, {\'name\': \'Принудитель из Зулапорта\', \'text\': \'Повышение уровня {4} ({4}: положите один жетон уровня на это существо. Повышайте уровень только как волшебство.)\\nУРОВЕНЬ 1-2\\n3/3\\nУРОВЕНЬ 3+\\n5/5\\nПринудитель из Зулапорта может быть заблокирован только черным существом.\', \'type\': \'Существо — Человек Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216006&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8f95b4e2-cf79-4239-8299-cd52ec37167d\', \'multiverseId\': 216006}, \'multiverseid\': 216006}, {\'name\': \'筑拉波执法者\', \'text\': \'升级{4} （{4}：在其上放置一个等级指示物。 升级的时机视同法术。）\\n等级1-2\\n3/3\\n等级3+\\n5/5\\n筑拉波执法者只能被黑色生物阻挡。\', \'type\': \'生物～人类／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216254&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9ea935e4-2c73-4407-95ea-b14d0e24b92f\', \'multiverseId\': 216254}, \'multiverseid\': 216254}]', '[{\'name\': \'Zurückbildung\', \'text\': \'Bringe eine bleibende Karte deiner Wahl auf die Hand ihres Besitzers zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Schau nicht zu tief, dort, wo das Wasser dunkel wird. Was das Meer dort verborgen hat, muss nicht für immer dort bleiben." —Jaby, Nomade vom Silundimeer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217424&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2bd78ec4-6c85-43eb-9f75-4c01db04c50a\', \'multiverseId\': 217424}, \'multiverseid\': 217424}, {\'name\': \'Regresión\', \'text\': \'Regresa el permanente objetivo a la mano de su propietario.\', \'type\': \'Instantáneo\', \'flavor\': \'"Nunca mires hacia las profundidades, donde el agua se vuelve oscura. Lo que el mar tiene escondido puede no quedarse allí para siempre." —Jaby, nómada del Mar Silundi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217176&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ad36cbb9-2195-48be-ad75-7afc949046ca\', \'multiverseId\': 217176}, \'multiverseid\': 217176}, {\'name\': \'Régression\', \'text\': \'Renvoyez le permanent ciblé dans la main de son propriétaire.\', \'type\': \'Éphémère\', \'flavor\': \'« Ne regarde jamais trop en profondeur, là où les eaux deviennent noires. Ce que la mer cache pourrait ne pas y demeurer englouti pour toujours. » —Jaby, nomade de la mer de Silundi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215688&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e7541133-6e44-4d7d-80ad-19db32d97015\', \'multiverseId\': 215688}, \'multiverseid\': 215688}, {\'name\': \'Regredire\', \'text\': \'Fai tornare un permanente bersaglio in mano al suo proprietario.\', \'type\': \'Istantaneo\', \'flavor\': \'"Non guardare mai troppo in profondità, quando le acque si intorbidano. Ciò che il mare nasconde in quel punto potrebbe non rimanere sott\\\'acqua." —Jaby, nomade del Mar Silundi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216432&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'25d57570-cf05-48a5-b76f-3d0259489bd1\', \'multiverseId\': 216432}, \'multiverseid\': 216432}, {\'name\': \'逆行\', \'text\': \'パーマネント１つを対象とし、それをオーナーの手札に戻す。\', \'type\': \'インスタント\', \'flavor\': \'「水が暗くなってるとこじゃ、あんまり深みを見すぎるな。 底に隠れてるものが、ずっとそこにいるとは限らないぞ。」 ――シルンディ海の遊牧民、ジャビー\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216680&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5c3bbb15-b5d6-4235-b23c-02e63aebcaa4\', \'multiverseId\': 216680}, \'multiverseid\': 216680}, {\'name\': \'Regredir\', \'text\': \'Devolva a permanente alvo para a mão de seu dono.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Nunca olhe muito fundo onde as águas escurecem. O que o mar lá escondeu pode não permanecer no fundo para sempre." — Jaby, nômade do Mar de Silundi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216928&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2452183b-eba9-4e0f-85e5-d86911c6cbfd\', \'multiverseId\': 216928}, \'multiverseid\': 216928}, {\'name\': \'Регресс\', \'text\': \'Верните целевой перманент в руку его владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Никогда не смотри слишком глубоко, где воды становятся черными. То, что спрятало море, совсем не обязательно останется там навсегда». — Джаби, кочевник Силундийского моря\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215936&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da3fa822-2ed8-4250-a41f-3444c3431640\', \'multiverseId\': 215936}, \'multiverseid\': 215936}, {\'name\': \'回归\', \'text\': \'将目标永久物移回其拥有者手上。\', \'type\': \'瞬间\', \'flavor\': \'「别误入漆黑的水底。 大海藏在该处的东西不一定会永远待在那边。」 ～希隆迪海牧民捷比\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216184&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6916b0f4-b617-4755-905b-fcf39e426a1f\', \'multiverseId\': 216184}, \'multiverseid\': 216184}]', '[{\'name\': \'Zwillingsspreißel\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat: „{T}: Bringe einen Spielstein ins Spiel, der eine Kopie dieser Kreatur ist. Dieser Spielstein hat Eile. Schicke ihn zu Beginn des nächsten Endsegments ins Exil."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Ich kenne genau die richtige Person für diese Aufgabe."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217339&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d7b7a34b-1253-465a-b171-46fc52e7b60d\', \'multiverseId\': 217339}, \'multiverseid\': 217339}, {\'name\': \'Gemelo astillado\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "{T}: Pon en el campo de batalla una ficha que es una copia de esta criatura. Esa ficha tiene la habilidad de prisa. Exíliala al comienzo del próximo paso final".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Conozco a la persona indicada para ese trabajo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217091&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f970e6b-ce07-459c-82b9-cf9940173661\', \'multiverseId\': 217091}, \'multiverseid\': 217091}, {\'name\': \'Jumeau par scission\', \'text\': \'Enchanter : créature\\nLa créature enchantée a « {T} : Mettez sur le champ de bataille un jeton qui est une copie de cette créature. Ce jeton a la célérité. Exilez-le au début de la prochaine étape de fin. »\', \'type\': \'Enchantement : aura\', \'flavor\': "« J\'ai le candidat rêvé pour ce travail. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215603&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16558f3c-e4e2-4022-aaf8-3c4f320a9649\', \'multiverseId\': 215603}, \'multiverseid\': 215603}, {\'name\': \'Gemellare\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "{T}: Metti sul campo di battaglia una pedina che è una copia di questa creatura. Quella pedina ha rapidità. Esiliala all\\\'inizio della prossima sottofase finale".\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Ho io la persona giusta!"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216347&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63b6ce23-a91d-440c-a50e-a185a57d0048\', \'multiverseId\': 216347}, \'multiverseid\': 216347}, {\'name\': \'欠片の双子\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは「{T}：このクリーチャーのコピーであるトークンを１体戦場に出す。 そのトークンは速攻を持つ。 次の終了ステップの開始時に、それを追放する。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「その仕事専用の担当さ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216595&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'796ec013-cc3f-495f-a641-d77d359cc9f0\', \'multiverseId\': 216595}, \'multiverseid\': 216595}, {\'name\': \'Gêmea Estilhaçadora\', \'text\': \'Encantar criatura\\nA criatura encantada tem "{T}: Coloque no campo de batalha uma ficha que seja uma cópia desta criatura. Aquela ficha tem ímpeto. Exile-a no início da próxima etapa final.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Eu conheço a pessoa certa para aquele trabalho."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216843&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4e26edd6-f906-405e-9bf1-1276d50d518c\', \'multiverseId\': 216843}, \'multiverseid\': 216843}, {\'name\': \'Отщепление Двойника\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность «{T}: положите на поле битвы фишку, являющуюся копией этого существа. Та фишка имеет Ускорение. Изгоните ее в начале следующего заключительного шага».\', \'type\': \'Чары — Аура\', \'flavor\': \'«Я знаю подходящего человека для этого дела».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215851&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'39c9f653-8248-4d4a-8bac-359250077395\', \'multiverseId\': 215851}, \'multiverseid\': 215851}, {\'name\': \'分裂双身\', \'text\': \'结附于生物\\n所结附的生物具有「{T}：将一个衍生物放进战场，该衍生物为此生物之复制。 该衍生物具有敏捷异能。 在下一个结束步骤开始时，将它放逐。」\', \'type\': \'结界～灵气\', \'flavor\': \'「我知道这事情最适合的人选。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216099&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7d5d63d5-99f2-46bc-9830-e27975251bd4\', \'multiverseId\': 216099}, \'multiverseid\': 216099}]', '[{\'name\': \'Überwachsene Festungsmauer\', \'text\': \'Verteidiger\\n{T}: Erhöhe deinen Manavorrat für jede Kreatur mit Verteidiger, die du kontrollierst, um {G}.\', \'type\': \'Kreatur — Mauer\', \'flavor\': \'„Unser Feind ist nichts weniger als das Ende alles Lebens. Wir sollten genügend Verbündete bekommen." —Die Kriegstagebücher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217428&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c54e0a5-18a6-41b1-a31f-086f6a40f680\', \'multiverseId\': 217428}, \'multiverseid\': 217428}, {\'name\': \'Destacamento cubierto de hierbas\', \'text\': \'Defensor.\\n{T}: Agrega {G} a tu reserva de maná por cada criatura con la habilidad de defensor que controles.\', \'type\': \'Criatura — Muro\', \'flavor\': \'"Nuestro enemigo es el fin de toda vida. No nos faltarán aliados." —Los diarios de guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217180&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db2af250-c926-4795-b58b-4e3a0faa978b\', \'multiverseId\': 217180}, \'multiverseid\': 217180}, {\'name\': \'Rempart luxuriant\', \'text\': \'Défenseur\\n{T} : Ajoutez {G} à votre réserve pour chaque créature avec le défenseur que vous contrôlez.\', \'type\': \'Créature : mur\', \'flavor\': "« Notre ennemi n\'est autre que la fin de toute vie. Nous ne manquerons pas d\'alliés. » —Les journaux de la Guerre", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215692&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4cb84a49-83f8-4949-8aa8-e3b42253ed57\', \'multiverseId\': 215692}, \'multiverseid\': 215692}, {\'name\': \'Bastione Troppo Cresciuto\', \'text\': \'Difensore\\n{T}: Aggiungi {G} alla tua riserva di mana per ogni creatura con difensore che controlli.\', \'type\': \'Creatura — Muro\', \'flavor\': \'"Il nostro nemico non è altro che la fine di ogni forma di vita. Non dobbiamo chiamare alcun alleato." —I Diari di Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216436&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ff61029-cd01-4917-9d61-5fb9cd6fa5dd\', \'multiverseId\': 216436}, \'multiverseid\': 216436}, {\'name\': \'草茂る胸壁\', \'text\': \'防衛\\n{T}：あなたがコントロールする防衛を持つクリーチャー１体につき、あなたのマナ・プールに{G}を加える。\', \'type\': \'クリーチャー — 壁\', \'flavor\': \'「我々の敵は、すなわち全ての生命の最期だ。 味方が足りなくなることは無い。」 ――「戦争日誌」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216684&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ad8e651-263b-4360-aa85-ba2879fbf5ee\', \'multiverseId\': 216684}, \'multiverseid\': 216684}, {\'name\': \'Ameia Encoberta\', \'text\': \'Defensor\\n{T}: Adicione {G} à sua reserva de mana para cada criatura com defensor que você controlar.\', \'type\': \'Criatura — Barreira\', \'flavor\': \'"Nosso inimigo nada mais é que o fim de todas as formas de vida. Não nos faltarão aliados." — Os Diários da Guerra\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216932&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'94fb9767-040c-4429-8201-fc4f050d4014\', \'multiverseId\': 216932}, \'multiverseid\': 216932}, {\'name\': \'Заросшая Зубчатая Стена\', \'text\': \'Защитник\\n{T}: добавьте {G} в ваше хранилище маны за каждое существо под вашем контролем со способностью Защитника.\', \'type\': \'Существо — Стена\', \'flavor\': \'«Наш враг — не что иное, как конец всего живого. У нас не будет недостатка в союзниках». — Дневники войны\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215940&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3ae8366-a4d6-4646-99ab-866697acfe7f\', \'multiverseId\': 215940}, \'multiverseid\': 215940}, {\'name\': \'蔓生城垛\', \'text\': \'守军\\n{T}：你每操控一个具守军异能的生物，便加{G}到你的法术力池中。\', \'type\': \'生物～墙\', \'flavor\': \'「我们的敌人一心要消灭所有生灵。 别妄想能与之订立盟约。」 ～《战场札记》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216188&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'353e648e-916a-4ea6-8e2a-fd84855ddc45\', \'multiverseId\': 216188}, \'multiverseid\': 216188}]', '[{\'name\': \'Übungsplätze\', \'text\': \'Aktivierte Fähigkeiten von Kreaturen, die du kontrollierst, kosten beim Aktivieren bis zu {2} weniger. Dieser Effekt kann die Menge Mana, die das Aktivieren einer Fähigkeit kostet, nicht unter ein Mana reduzieren.\', \'type\': \'Verzauberung\', \'flavor\': \'Unter dem Auge des Meisters werden Fähigkeiten geschärft und Zaubersprüche vertieft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217351&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e36de8cb-8bb5-4983-8168-396ff03f9bbd\', \'multiverseId\': 217351}, \'multiverseid\': 217351}, {\'name\': \'Área de entrenamiento\', \'text\': \'Cuesta hasta {2} menos activar las habilidades activadas de las criaturas que controlas. Este efecto no puede reducir la cantidad de maná que cuesta activar una habilidad a menos de un maná.\', \'type\': \'Encantamiento\', \'flavor\': \'Bajo la mirada del amo, las habilidades son perfeccionadas y los hechizos son más efectivos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=217103&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'674bb58f-645b-4421-a2f8-6af5b2171d69\', \'multiverseId\': 217103}, \'multiverseid\': 217103}, {\'name\': "Terrains d\'entraînement", \'text\': "Les capacités activées des créatures que vous contrôlez coûtent jusqu\'à {2} de moins à activer. Cet effet ne peut pas réduire la quantité de mana que coûte une capacité pour s\'activer à moins de un mana.", \'type\': \'Enchantement\', \'flavor\': "Sous le regard du maître, les compétences s\'aiguisent et les sorts s\'affûtent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215615&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b7630332-0975-416e-88d6-386beed5bd16\', \'multiverseId\': 215615}, \'multiverseid\': 215615}, {\'name\': "Zona d\'Addestramento", \'text\': "Le abilità attivate delle creature che controlli costano fino a {2} in meno per essere attivate. Questo effetto non può ridurre la quantità di mana che costa attivare un\'abilità a meno di un mana.", \'type\': \'Incantesimo\', \'flavor\': "Sotto l\'occhio vigile del maestro, le abilità vengono affinate e le magie approfondite.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216359&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ddacbba6-6284-4b2b-ba00-c100cf87ec4b\', \'multiverseId\': 216359}, \'multiverseid\': 216359}, {\'name\': \'訓練場\', \'text\': \'あなたがコントロールするクリーチャーの起動型能力は、それを起動するためのコストが最大{2}少なくなる。 この効果は、いずれかの能力の起動コストのマナの点数を１点未満に減らさない。\', \'type\': \'エンチャント\', \'flavor\': \'師の視線の下で、腕はより強く、呪文はより鋭くなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216607&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68a965df-a832-47e9-a216-f2258469ad35\', \'multiverseId\': 216607}, \'multiverseid\': 216607}, {\'name\': \'Campos de Treinamento\', \'text\': \'As habilidades ativadas das criaturas que você controla custam até {2} a menos para serem ativadas. Este efeito não pode reduzir a quantidade de mana necessária para ativar uma habilidade para menos de um mana.\', \'type\': \'Encantamento\', \'flavor\': \'Sob os olhos do mestre, as habilidades são aprimoradas e as mágicas tornam-se mais poderosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216855&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8c5bd024-b924-4691-adf7-c23fc5fd6026\', \'multiverseId\': 216855}, \'multiverseid\': 216855}, {\'name\': \'Учебный Полигон\', \'text\': \'Активируемые способности существ под вашим контролем стоят до {2} меньше. Этот эффект не может сократить количество маны для оплаты активации способности до менее чем одной маны.\', \'type\': \'Чары\', \'flavor\': \'Под присмотром мастера навыки оттачиваются лучше, а заклинания режут глубже.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=215863&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57c491f1-14a0-4e99-a12f-10b37825c1e3\', \'multiverseId\': 215863}, \'multiverseid\': 215863}, {\'name\': \'训练场\', \'text\': \'由你操控的生物之起动式异能至多减少{2}来起动。 此效应无法让起动异能所需的法术力费用少于一点法术力。\', \'type\': \'结界\', \'flavor\': \'在师父的指导下，技巧更加熟练，咒语也更加强劲。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=216111&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6fadabb6-a0d6-4b33-a565-9b970bbbeff0\', \'multiverseId\': 216111}, \'multiverseid\': 216111}]']
