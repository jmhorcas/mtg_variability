: None}, {'name': 'スレイマンの遺産', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'a0805059-ac1f-418c-9858-64648a14f98f'}, 'multiverseid': None}, {'name': 'Legado de Suleiman', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8c4fcf29-d757-479b-96e6-122fe9a3f2fc'}, 'multiverseid': None}]", "[{'name': 'Sumpfiges Grasland', 'text': 'Das Sumpfige Grasland kommt getappt ins Spiel.\\nWenn das Sumpfige Grasland ins Spiel kommt, bringe einen ungetappten Sumpf, den Du kontrollierst, zurück auf die Hand seines Besitzers oder begrabe das Sumpfige Grasland.\\n{T}: Erhöhe Deinen Manavorrat um {B} und ein farbloses Mana.', 'type': 'Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c88d7621-f39f-46dd-82f0-64151b70d2b0'}, 'multiverseid': None}, {'name': 'Marisma', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '85901a65-dd07-4721-a328-bf9fe334857d'}, 'multiverseid': None}, {'name': 'Everglades', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'dcd7bf56-5a1f-4102-bb7e-c01311d787bb'}, 'multiverseid': None}, {'name': 'Distesa Paludosa', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1f27bc8c-7d6a-492c-9015-35808a647384'}, 'multiverseid': None}, {'name': '大沼沢地', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd1b1b864-19fe-4742-9bae-ce8f1f1053eb'}, 'multiverseid': None}, {'name': 'Pantanal', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '97ce161b-2e39-48c2-9e10-151f87c3b770'}, 'multiverseid': None}]", "[{'name': 'Talruum-Champion', 'text': 'Erstschlag\\nWenn der Talruum-Champion irgendeine Kreatur blockt oder von ihr geblockt wird, verliert diese Kreatur Erstschlag bis zum Ende des Zuges.', 'type': 'Beschwörung eines Minotauren', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '16c5d735-3822-4a8a-8dad-108bf407847e'}, 'multiverseid': None}, {'name': 'Campeón de Talruum', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f32f7037-4fed-4304-b414-52b808207bc6'}, 'multiverseid': None}, {'name': 'Champion talruûm', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a2740eff-bef2-4a85-be82-b43bf70f2133'}, 'multiverseid': None}, {'name': 'Campione di Talruum', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '1a049e5a-e119-4091-a512-899b2868e569'}, 'multiverseid': None}, {'name': 'タールルームの勇者', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '226ea1a0-4d2c-48eb-bd4e-3bd161139a5e'}, 'multiverseid': None}, {'name': 'Campeão de Talruum', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'faf333cb-ec24-48f9-8528-813ae19be1f9'}, 'multiverseid': None}]", "[{'name': 'Talruumpfeifer', 'text': 'Alle fliegenden Kreaturen, die den Talruumpfeifer blocken können, tun dies.', 'type': 'Beschwörung eines Minotauren', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b6694837-524b-4a3b-9113-bed120722c04'}, 'multiverseid': None}, {'name': 'Flautista de Talruum', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a9d95997-79e4-4fcd-8d8e-a46bff0e4461'}, 'multiverseid': None}, {'name': 'Joueur de fifre talruûm', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '271b5047-7436-42dd-aad8-e760ad1305c8'}, 'multiverseid': None}, {'name': 'Pifferaio di Talruum', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'c92cf16d-7ea7-4813-a7b4-a434ef464c2d'}, 'multiverseid': None}, {'name': 'タールルームの笛吹き', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'dab83f04-0dd2-4ceb-9819-41754f051868'}, 'multiverseid': None}, {'name': 'Flautista de Talruum', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1deffeaa-6d1a-44e3-b2ed-735d6baea720'}, 'multiverseid': None}]", '[{\'name\': \'Teferis Ehrengarde\', \'text\': \'Flankenangriff\\n{U}{U}: Destabilisiert sich\', \'type\': \'Beschwörung eines Ritters\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d2e6f484-ec7a-4705-887b-f110d0c5e2ab\'}, \'multiverseid\': None}, {\'name\': \'Guardia de honor de Teferi\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7e2c0adc-e010-436b-91cf-6acfc29778b7\'}, \'multiverseid\': None}, {\'name\': "Garde d\'honneur de Téfeiri", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a2447df-d9a3-4906-b393-0f855ff44338\'}, \'multiverseid\': None}, {\'name\': "Guardia d\'Onore di Teferi", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cbbbca8f-a96a-4af3-89c5-59742452b449\'}, \'multiverseid\': None}, {\'name\': \'テフェリーの儀杖兵\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bad2749c-9a3d-4cc9-8222-056ed16f4cd6\'}, \'multiverseid\': None}, {\'name\': \'Guarda de Honra de Teferi\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b93de154-9364-49ff-9f61-1e72f454f4c8\'}, \'multiverseid\': None}]', "[{'name': 'Teferis Reich', 'text': 'Zu Beginn der Versorgungsphase eines Spielers wählt dieser Artefakte, Kreaturen, Länder oder globale Verzauberungen. Alle Kreaturen des gewählten Typs destabilisieren sich.', 'type': 'Weltenverzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '1e4e74dd-98c2-4395-9887-586588c1fa1d'}, 'multiverseid': None}, {'name': 'Reino de Teferi', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'aa5fff03-c97a-448e-a6db-12eff66c57f1'}, 'multiverseid': None}, {'name': 'Le royaume de Téfeiri', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6004041d-0a39-4fca-87cd-311e31f44955'}, 'multiverseid': None}, {'name': 'Reame di Teferi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '2b440ff0-548c-4a3f-a700-9bace517db1d'}, 'multiverseid': None}, {'name': 'テフェリーの世界', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'ba0970e0-9b64-43a5-a7f0-16144574f7cc'}, 'multiverseid': None}, {'name': 'Reino de Teferi', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd7afc663-91e3-4ac5-9fa3-2af630ec72e3'}, 'multiverseid': None}]", "[{'name': 'Teferis Rätselkiste', 'text': 'Während der Kartenzieh-Phase eines Spielers, zählt dieser die Karten auf seiner Hand und legt diese Karten unter seine Bibliothek. Danach zieht er diese Anzahl an Karten.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c8f60838-c066-4ccf-a231-186bdea55910'}, 'multiverseid': None}, {'name': 'Rompecabezas de Teferi', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4eb5d557-163b-4223-ad79-858e1669b155'}, 'multiverseid': None}, {'name': 'Boîte à mystère de Téfeiri', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b65ff3c5-7881-482e-81a6-c7e2e55090b9'}, 'multiverseid': None}, {'name': 'Scatola degli Enigmi di Teferi', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '184e47e3-fc36-4e74-8f2c-4051575bc716'}, 'multiverseid': None}, {'name': 'テフェリーの細工箱', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9ae0040c-1f16-47e1-9f3c-e87b49afb78b'}, 'multiverseid': None}, {'name': 'Quebra-cabeças de Teferi', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f7c530e0-7a2c-4e44-acaa-498c9811a974'}, 'multiverseid': None}]", "[{'name': 'Todeskundiger', 'text': '{3}{B}{B}, opfere eine Kreatur: Bringe den Todeskundigen direkt ins Spiel. Benutze diese Fähigkeit nur während Deiner Versorgungsphase und nur, wenn der Todeskundige auf Deinem Friedhof ist.', 'type': 'Beschwörung eines Todeskundigen', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'de2834e3-1f63-4718-abcd-1676977b11f0'}, 'multiverseid': None}, {'name': 'Necrósofo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e54f0ab4-8c03-4c6e-83ac-7258a0bd4a36'}, 'multiverseid': None}, {'name': 'Nécrosavant', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd0e66615-4fbd-48c2-8c49-6a7f4b6dcfcc'}, 'multiverseid': None}, {'name': 'Esperto di Necromanzia', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '6a26197b-2587-43ce-9392-e2b0d1de4839'}, 'multiverseid': None}, {'name': 'ネクロサヴァント', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '01e439a0-f600-4fac-9fb7-7a53d58db2a9'}, 'multiverseid': None}, {'name': 'Necrossábio', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7de1107f-cdf8-48df-a2f3-1c13ec18a7cb'}, 'multiverseid': None}]", "[{'name': 'Totenwache', 'text': 'Wenn die verzauberte Kreatur auf dem Friedhof landet, verliert der Beherrscher dieser Kreatur Lebenspunkte in Höhe der Stärke und Du erhältst Lebenspunkte in Höhe der Widerstandskraft der Kreatur dazu.', 'type': 'Verzaubere Kreatur', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'af2874e0-5d59-4716-b04e-0550114effd9'}, 'multiverseid': None}, {'name': 'Vigilia del condenado', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'cecd2819-69a3-4125-ba9a-ca23516ba3e2'}, 'multiverseid': None}, {'name': 'Veillée funèbre', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5c161e52-9496-4e64-86c7-25fc28ad52ce'}, 'multiverseid': None}, {'name': 'Veglia Funebre', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '49637c5a-3c49-40f2-9348-5c98a26b45db'}, 'multiverseid': None}, {'name': '死の見張り', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f493c8d2-3b4e-406a-82a1-f951fb1e3132'}, 'multiverseid': None}, {'name': 'Morte à Espreita', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a3b960b3-f498-4e10-8911-5c7ff46b33d8'}, 'multiverseid': None}]", "[{'name': 'Traumfluten', 'text': 'Kreaturen enttappen nicht während der Enttap-Phase ihres Beherrschers.\\nJeder Beherrscher einer nicht-grünen Kreatur kann während seiner Versorgungsphase zusätzlich 2 bezahlen, um diese Kreatur zu enttappen.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '71401b76-530b-4649-bbfa-0640aee950d1'}, 'multiverseid': None}, {'name': 'Mareas de sueño', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '61d2418d-a579-46dd-8f04-793778c7ff95'}, 'multiverseid': None}, {'name': 'Marées du rêve', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'dbb033f7-c31f-4b24-b0c1-8a8e8849949d'}, 'multiverseid': None}, {'name': 'Maree del Sogno', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5adf7fd1-0223-4928-b75a-5d98ec48c791'}, 'multiverseid': None}, {'name': '夢の潮流', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0aba3a62-8530-4b57-a76a-44c7e231bf08'}, 'multiverseid': None}, {'name': 'Marés Oníricas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fff17bde-782e-4045-9797-daa4259dd3e2'}, 'multiverseid': None}]", "[{'name': 'Treibsand', 'text': '{T}: Erhöhe Deinen Manavorrat um ein farbloses Mana.\\n{T}, opfere den Treibsand: Eine angreifende nichtfliegende Kreatur Deiner Wahl erhält -1/-2 bis zum Ende des Zuges.', 'type': 'Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '10a73d32-633f-42e6-9d4b-7e158dc35411'}, 'multiverseid': None}, {'name': 'Arenas movedizas', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7cfeb04b-e020-445c-8b0b-aaa7156fbbf0'}, 'multiverseid': None}, {'name': 'Sables mouvants', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c1504ef4-431c-489f-a765-158b78a7501a'}, 'multiverseid': None}, {'name': 'Sabbie Mobili', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '62f5e20b-abea-429c-b990-50f77331f