type: ['Artifact', 'Artifact Creature — Golem', 'Artifact Creature — Sphinx', 'Artifact — Equipment', 'Basic Land — Forest', 'Basic Land — Island', 'Basic Land — Mountain', 'Basic Land — Plains', 'Basic Land — Swamp', 'Creature — Avatar', 'Creature — Eldrazi Vampire', 'Creature — Elf Druid', 'Creature — Elf Scout', 'Creature — Human Werewolf', 'Creature — Sphinx', 'Creature — Vampire Horror', 'Creature — Vampire Warrior', 'Creature — Werewolf', 'Enchantment', 'Instant', 'Land', 'Land — Forest Plains', 'Land — Mountain Forest', 'Legendary Artifact', 'Legendary Artifact — Equipment', 'Legendary Artifact — Vehicle', 'Legendary Creature — Bird Cleric', 'Legendary Creature — Demon', 'Legendary Creature — Elder Dinosaur', 'Legendary Creature — Elf Cleric', 'Legendary Creature — Elf Scout', 'Legendary Creature — Elf Warrior', 'Legendary Creature — Fox', 'Legendary Creature — God', 'Legendary Creature — Human Cleric', 'Legendary Creature — Human Druid', 'Legendary Creature — Human Shaman', 'Legendary Creature — Human Soldier', 'Legendary Creature — Human Warlock', 'Legendary Creature — Human Wizard', 'Legendary Creature — Orc Shaman', 'Legendary Creature — Spirit Soldier', 'Legendary Creature — Vampire Warlock', 'Legendary Creature — Zombie', 'Legendary Enchantment', 'Legendary Enchantment — Aura', 'Legendary Land', 'Legendary Planeswalker — Arlinn', 'Legendary Planeswalker — Chandra', 'Legendary Planeswalker — Garruk', 'Legendary Planeswalker — Gideon', 'Legendary Planeswalker — Jace', 'Legendary Planeswalker — Liliana', 'Legendary Planeswalker — Lukka', 'Legendary Planeswalker — Nissa', 'Legendary Planeswalker — Tibalt', 'Legendary Sorcery', 'Snow Land — Forest Island', 'Snow Land — Swamp Forest', 'Sorcery']
