rench', 'identifiers': {'scryfallId': 'f6397dff-2174-49bc-8222-04de3f820dad'}, 'multiverseid': None}, {'name': 'Spirito Intermittente', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '3673e1f6-299f-447b-b3e5-80042dbf5a6b'}, 'multiverseid': None}, {'name': 'Espírito Lampejante', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '63bdf6fb-7b66-43d9-beab-f45487856db8'}, 'multiverseid': None}]", "[{'name': 'Fluch von Marit Lage', 'text': 'Tappe alle Inseln, wenn der Fluch von Marit Lage ins Spiel kommt. Inseln enttappen nicht während der Enttap-Phase ihres Beherrschers.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '28f8934a-b89d-433c-ba06-df44cf36c122'}, 'multiverseid': None}, {'name': 'Maldición de Marit Lage', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e5fc4867-39c7-4fa3-adaa-045d767b59b1'}, 'multiverseid': None}, {'name': 'Malédiction de Marit Lage', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'bba1a933-c60c-4778-ac6f-a541d7194bd0'}, 'multiverseid': None}, {'name': 'Maledizione di Marit Lage', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'bfc8f388-f9f7-40d9-987b-c16e9b885a01'}, 'multiverseid': None}, {'name': 'Maldição de Marit Lage', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '62699895-9186-430d-90bb-0e503e84c5a1'}, 'multiverseid': None}]", "[{'name': 'Flußdelta', 'text': 'Das Flussdelta enttappt nicht während Deiner Enttap-Phase, wenn Raubbau-Spielmarken auf ihm liegen. Entferne zu Beginn Deiner Versorgungsphase eine Raubbau-Spielmarke vom Flussdelta.\\n{T}: Erhöhe Deinen Manavorrat um U. Lege eine Raubbau-Spielmarke auf das Flussdelta.\\n{T}: Erhöhe Deinen Manavorrat um B. Lege eine Raubbau-Spielmarke auf das Flussdelta.', 'type': 'Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b0bb86e3-f8a2-49b2-90fd-ce73b4c80318'}, 'multiverseid': None}, {'name': 'Delta fluvial', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '01ba09ef-045d-4706-b6c0-f6122b4540d3'}, 'multiverseid': None}, {'name': 'Delta du fleuve', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '9f35a94a-efa3-4681-ba6a-b9b59c039e1e'}, 'multiverseid': None}, {'name': 'Delta del Fiume', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '0ad3d77f-38d4-4327-ad2f-984a09cf1559'}, 'multiverseid': None}, {'name': 'Delta de Rio', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bf067bc1-f457-4a09-833b-ded887255fc5'}, 'multiverseid': None}]", "[{'name': 'Formation', 'text': 'Die Zielkreatur erhält Bündnisfähigkeit bis zum Ende des Zuges. Ziehe eine Karte zu Beginn der Versorgungsphase des nächsten Zuges.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '7e8eb25c-b408-46dc-8f99-20eaeaf289ea'}, 'multiverseid': None}, {'name': 'Formación', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1e6109e2-c899-4b6d-a008-8f8df29e5db0'}, 'multiverseid': None}, {'name': 'Formation', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'f2563007-9e3e-4a74-b798-e465a019f064'}, 'multiverseid': None}, {'name': 'Formazione', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '4f69a04e-0100-4d2a-b30a-bde6ab6f6522'}, 'multiverseid': None}, {'name': 'Formação', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '88c89cbf-efd8-4725-a668-1c49fd66d34c'}, 'multiverseid': None}]", "[{'name': 'Freyalises Bittstellerin', 'text': '{T}: Opfere eine weiße oder eine rote Kreatur, damit Freyalises Bittstellerin einer Kreatur oder einem Spieler Deiner Wahl Schadenspunkte in Höhe der Hälfte der Stärke der geopferten Kreatur (abgerundet) zufügt.', 'type': 'Beschwörung einer Klerikerin', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '2563f5f1-911b-4401-abc0-43966c55d550'}, 'multiverseid': None}, {'name': 'Suplicante de Freyalise', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a60328b0-648c-490b-aa03-b12efcac52e7'}, 'multiverseid': None}, {'name': 'Suppliant de Freyalise', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'a49ea935-eb38-46f0-a44e-e07085bf79bd'}, 'multiverseid': None}, {'name': 'Supplicante di Freyalise', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a1790810-1943-4c74-a180-187fd004c1a6'}, 'multiverseid': None}, {'name': 'Devoto de Freyalise', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fa91617f-df4c-4646-a1e5-f30962ac630c'}, 'multiverseid': None}]", "[{'name': 'Freyalises Glücksbringer', 'text': '{G}{G}: Wenn irgendeiner Deiner Gegner erfolgreich einen schwarzen Zauberspruch spricht, ziehe eine Karte. Du kannst diese Eigenschaft nur einmal für jeden schwarzen gesprochenen Zauber benutzen.\\n{G}{G}: Bringe Freyalises Glücksbringer zurück auf die Hand seines Besitzers.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '27da9ab6-443f-42c1-8e04-83ed93648ffe'}, 'multiverseid': None}, {'name': 'Amuleto de Freyalise', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '77a70fe7-dd92-42f0-8c12-5463c35db6ea'}, 'multiverseid': None}, {'name': 'Charme selon Freyalise', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5b89ce5d-9caf-4a5b-98a6-12a5d98c43ff'}, 'multiverseid': None}, {'name': 'Monile di Freyalise', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '74eabef1-588c-4fa8-82ce-3a4c0e2f0bdd'}, 'multiverseid': None}, {'name': 'Amuleto de Freyalise', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5e9bac57-ceb4-4c42-aaa6-13d9440db330'}, 'multiverseid': None}]", "[{'name': 'Freyalises Winde', 'text': 'Lege eine Wind-Marke auf jede bleibende Karte, wenn sie getappt wird. Bleibende Karten, auf denen Wind-Marken liegen, enttappen nicht während der Enttap-Phase ihres Beherrschers; entferne stattdessen alle Wind-Marken von diesen bleibenden Karten.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'edd81b55-e44f-46ea-a45a-5ec83448ae62'}, 'multiverseid': None}, {'name': 'Vientos de Freyalise', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '749eac6d-37b1-4c29-9131-019cb462a8b3'}, 'multiverseid': None}, {'name': 'Vents selon Freyalise', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '633ec597-8605-4748-b4f5-edaf09ae9984'}, 'multiverseid': None}, {'name': 'Venti di Freyalise', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd35e7103-8a8b-46a1-9b24-2eec9590c7ed'}, 'multiverseid': None}, {'name': 'Ventos de Freyalise', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'eff0be69-2344-4983-9b8c-aa28c23a8304'}, 'multiverseid': None}]", "[{'name': 'Frostnebel', 'text': 'Alle Kreaturen, die fliegen können, verlieren diese Fähigkeit bis zum Ende des Zuges.\\nDu kannst ein verschneites Land opfern, wenn der Frostnebel auf Deinem Friedhof liegt, um ihn zurück in Deine Hand zu nehmen.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'cf4fbb40-9fb2-4d8d-a470-7d159532b4de'}, 'multiverseid': None}, {'name': 'Ventisca', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '6ffc5722-d401-4c2d-8b2c-6959e6ea0f21'}, 'multiverseid': None}, {'name': 'Brouillard polaire', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '5c9ab426-63c7-4977-bcfb-14650e42ca4b'}, 'multiverseid': None}, {'name': 'Riflesso Abbagliante', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '8a4f27b9-2715-4b56-b579-16c13c471026'}, 'multiverseid': None}, {'name': 'Nivoso', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8afa8499-088c-4320-8d73-9c3968d7a960'}, 'multiverseid': None}]", "[{'name': 'Frostschatten', 'text': '{B}: +1/+1 bis zum Ende des Zuges.', 'type': 'Beschwörung eines Schatten', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '4c843445-934b-4bf7-ac9f-77094b849061'}, 'multiverseid': None}, {'name': 'Sombra de la escarcha', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0e703ab6-bfaf-424e-bcea-d5205ac99d3c'}, 'multiverseid': None}, {'name': 'Ombre de givre', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '185e250e-5318-4c13-8b50-86956c246ebf'}, 'multiverseid': None}, {'name': 'Ombra della Brina', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '9e5900fa-33a2-48f9-8adf-c3e84dca5c14'}, 'multiverseid': None}, {'name': 'Sombra Álgida', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '21e05748-193e-4a1c-a8eb-ad2cc3544c93'}, 'multiverseid': None}]", "[{'name': 'Fuchsspuren', 'text': 'Enttappe eine angreifende Zielkreatur. Diese Kreatur erleidet in diesem Kampf keinen Schaden, teilt aber auch keinen aus. Ziehe eine Karte zu Beginn der Versorgungsphase des nächsten Zuges.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '699b3a32-11cc-442a-a2b8-8810bb6fa035'}, 'multiverseid': None}, {'name': 'Hongos luminescentes', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1d016d2d-96a8-456f-b55a-678fc6ad04f0'}, 'multiverseid': None}, {'name': 'Chromophores', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '203ed63e-f507-4b44-945b-ae5fdef8e338'}, 'multiverseid': None}, {'name': 'Fuoco di Paglia', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'df847c88-aa10-471d-9489-be6a530b299d'}, 'multiverseid': None}, {'name': 'Ignis Fatuus', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8c750d09-234b-44e0-994d-bf64810c40c1'},