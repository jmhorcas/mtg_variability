e (Brazil)', 'identifiers': {'scryfallId': 'a7908870-a51b-4058-a411-e025216decf0'}, 'multiverseid': None}]", "[{'name': 'Geheimnis der Erde', 'text': 'Mit dem Geheimnis der Erde kannst Du nur ein von Dir kontrolliertes Land verzaubern.\\n0: Tappe das vom Geheimnis der Erde verzauberte Land, um einer blockenden Kreatur +1/+2 bis zum Ende des Zuges zu geben.', 'type': 'Verzaubere Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9a4580ce-d7de-42aa-bf29-4befe7d196db'}, 'multiverseid': None}, {'name': 'Sabiduría terrena', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '7ad7b97a-91bc-4364-828c-7a307229141e'}, 'multiverseid': None}, {'name': 'Sapience tellurique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '0e473c9e-760e-4dc1-8d17-d9f2e8a51104'}, 'multiverseid': None}, {'name': 'Sapere della Terra', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'a0ed2c78-d1c9-4850-9aa2-8d751cb42526'}, 'multiverseid': None}, {'name': 'Conhecimento do Solo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f4043acd-3a3f-4770-9b5a-6a74b9f74187'}, 'multiverseid': None}]", "[{'name': 'Geisterflamme', 'text': 'Sowohl rote und schwarze bleibende Karten und Zaubersprüche gelten jetzt als farblose Schadensquellen.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '9a089209-c983-4fc6-8138-3516c1f409b9'}, 'multiverseid': None}, {'name': 'Llama fantasmal', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'ebf0c849-3dad-460f-bb06-b88ce0a6989c'}, 'multiverseid': None}, {'name': 'Flamme fantomatique', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'e8502700-1878-4c86-9827-972db0da7e92'}, 'multiverseid': None}, {'name': 'Fiamma Spettrale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'f0cfcd97-d9a2-4c1f-8689-94ecb033926a'}, 'multiverseid': None}, {'name': 'Chama Fantasma