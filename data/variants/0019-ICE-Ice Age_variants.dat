 zurano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '3f41d5d9-e57c-45c7-bb27-0ff901644096'}, 'multiverseid': None}, {'name': 'Enchanteur zuranien', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c202a142-0c2a-48ed-bb39-e76c817d3858'}, 'multiverseid': None}, {'name': 'Incantatore di Zur', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd598dcd4-212b-4bc8-831c-deb76a76b8b5'}, 'multiverseid': None}, {'name': 'Encantador Zurano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1f82d0ac-47f4-47da-b7c0-33198e296427'}, 'multiverseid': None}]", "[{'name': 'Zuranischer Zaubermeister', 'text': '{T}: Der Zuranische Zaubermeister fügt einer Kreatur oder einem Spieler Deiner Wahl 1 Schadenspunkt zu.', 'type': 'Beschwörung eines Zauberers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '698def02-fc30-4ebf-a3fb-5da13abf8b0b'}, 'multiverseid': None}, {'name': 'Taumaturgo zurano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '4dcd2ea6-996a-4171-ae64-acd9a80704f7'}, 'multiverseid': None}, {'name': 'Lanceur de sorts zuranien', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6e99c167-6928-4359-a30b-7ed50247b4c8'}, 'multiverseid': None}, {'name': 'Stregone di Zur', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '9ad89e30-376c-4528-8e7e-c4dbf599c59c'}, 'multiverseid': None}, {'name': 'Mágico Zurano', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '195f37d0-9f34-4f14-9998-2f27495f07ed'}, 'multiverseid': None}]", "[{'name': 'Zurs Sphäre', 'text': '0: Opfere ein Land, um 2 Lebenspunkte zu erhalten.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'c6a53322-2426-48ef-a776-4a6f3ffb4964'}, 'multiverseid': None}, {'name': 'Orbe zurano', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '9b5e58af-5aae-4461-aad0-44cd6ece074e'}, 'multiverseid': None}, {'name': 'Orbe zuranienne', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'c3182495-ef49-4e20-968b-32a01ea82309'}, 'multiverseid': None}, {'name': 'Globo di Zur', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '09810a1d-ca28-4b68-9b4d-22f8340a1ecd'}, 'multiverseid': None}, {'name': 'Orbe Zurana', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2451014d-91c2-42de-a8e8-8106ca3d57fd'}, 'multiverseid': None}]", "[{'name': 'Zurs bizarre Welt', 'text': 'Alle Spieler legen die Karten, die sie auf der Hand haben, offen vor sich hin und spielen ab jetzt mit offenen Karten. Immer, wenn ein Spieler eine Karte zieht, kann ein anderer Spieler 2 Lebenspunkte bezahlen, damit dieser Spieler die Karte wieder abwerfen muß. Effekte, die Schaden verhindern oder umleiten, können hier nicht angewendet werden, um den Verlust der Lebenspunkte zu verhindern.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '46b23e4e-85fb-462e-9d44-7a4d8192ccc6'}, 'multiverseid': None}, {'name': 'Presagio de Zur', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '0a799458-6671-47a8-967b-2b89aa14a469'}, 'multiverseid': None}, {'name': 'Déterminisme selon Zur', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '8370563d-3c3e-478a-8bc7-9bb30628e18b'}, 'multiverseid': None}, {'name': 'Malia di Zur', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'ec46a67f-eed6-4236-ac17-ced09a7dc10e'}, 'multiverseid': None}, {'name': 'Fatalidade de Zur', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c3ab2ede-bde1-4f05-bb26-877652795bc8'}, 'multiverseid': None}]", "[{'name': 'Zurückforderung', 'text': 'Keine schwarze Kreatur kann angreifen, wenn ihr Beherrscher nicht ein Land opfert, sobald diese Kreatur angreift.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '0bb0d8ba-8b0c-4ca9-a64e-67701da7a6e2'}, 'multiverseid': None}, {'name': 'Reclamación', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'a2434b94-036c-4423-bab9-145e2573a876'}, 'multiverseid': None}, {'name': 'Défrichement', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '6fb0e079-9801-4877-adb5-3a30a5b8bb5e'}, 'multiverseid': None}, {'name': 'Bonifica', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '235bbfca-4eda-47d9-b81b-a7fa516d27e4'}, 'multiverseid': None}, {'name': 'Recuperação', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'fdb4f838-6393-4bde-bf8a-8f018c7696c1'}, 'multiverseid': None}]", "[{'name': 'Zwergallosaurus', 'text': 'Sumpftarnung', 'type': 'Beschwörung eines Dinosauriers', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3237b537-af5d-4bff-9eb7-43a8777f9dd7'}, 'multiverseid': None}, {'name': 'Alosaurio pigmeo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '1a6dcc4c-821e-4c90-9f2d-22d46af30554'}, 'multiverseid': None}, {'name': 'Allosaure pygmée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd618152e-c416-4068-a96d-85f05a69b5c6'}, 'multiverseid': None}, {'name': 'Allosauro Pigmeo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'bf25b8f3-7362-471a-8458-1245cab8621c'}, 'multiverseid': None}, {'name': 'Alossauro Pigmeu', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f155980c-8fbd-4c30-be61-d4ccf7874a31'}, 'multiverseid': None}]", "[{'name': 'Zwergische Waffenschmiede', 'text': '{2}: Opfere ein Land, um eine +2/+2-Marke auf eine Kreatur Deiner Wahl zu legen. Benutze diese Fähigkeit nur während einer Versorgungsphase.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '4d47c3a0-27a2-4988-81ac-6c46ecbc30df'}, 'multiverseid': None}, {'name': 'Armería enana', 'fla