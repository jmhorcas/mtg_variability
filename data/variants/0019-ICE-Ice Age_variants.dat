one}]", "[{'name': 'Wiitigo', 'text': 'Lege 6 +1/+1 Marken auf den Wiitigo, wenn er ins Spiel kommt.\\nLege während Deiner Versorgungsphase eine +1/+1 Marke auf den Wiitigo, wenn er seit Deiner letzten Versorgungsphase geblockt hat oder geblockt wurde. Ist dies nicht der Fall, entferne eine +1/+1 Marke vom Wiitigo. Ignoriere diesen Effekt, wenn keine +1/+1 Marken auf dem Wiitigo liegen.', 'type': 'Beschwörung eines Wiitigo', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'e58ab8a3-a07c-4bab-97da-846324c9e62d'}, 'multiverseid': None}, {'name': 'Witigo', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'be1a8043-773f-480e-bce7-5b273bb0beb4'}, 'multiverseid': None}, {'name': 'Wytigo', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '201467ca-e2da-4d8a-a2f2-8359898b14dc'}, 'multiverseid': None}, {'name': 'Wiitigo', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'fb95cbd1-08f3-4e5e-812b-b96b541804ec'}, 'multiverseid': None}, {'name': 'Wiitigo', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0b3d7ce2-3008-446f-af24-5a1f19fb36ed'}, 'multiverseid': None}]", "[{'name': 'Wildwuchs', 'text': 'Wildwuchs erhöht Deinen Manavorrat um ein zusätzliches {G}, sobald Du das verzauberte Land für Mana tappst.', 'type': 'Verzaubere Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '085442ab-02b7-447a-b7d3-72ef78edb3db'}, 'multiverseid': None}, {'name': 'Crecimiento salvaje', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'bcc74b0a-d045-45bd-973c-9311b7fce62f'}, 'multiverseid': None}, {'name': 'Végétation luxuriante', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '4699f499-cda8-4f74-8c3d-039b1ca31e14'}, 'multiverseid': None}, {'name': 'Crescita Rigogliosa', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '81346bf7-c733-4d63-b801-fad3d5de36c4'}, 'multiverseid': None}, {'name': 'Crescime