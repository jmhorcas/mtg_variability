, 'identifiers': {'scryfallId': 'e1026899-721c-4ab2-943d-c6793ecb0c4c'}, 'multiverseid': None}, {'name': 'Cura', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b4934f2f-d47e-4e40-a271-2902939373e0'}, 'multiverseid': None}]", "[{'name': 'Heiße Quelle', 'text': 'Die Heiße Quelle kannst Du nur auf ein von Dir kontrolliertes Land sprechen.\\n0: Tappe das von der Heißen Quelle verzauberte Land, um 1 Schadenspunkt an einer Kreatur oder einem Spieler zu verhindern.', 'type': 'Verzaubere Land', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '779c05ef-02b2-4aaa-854b-9c33b5392ade'}, 'multiverseid': None}, {'name': 'Fuentes termales', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'bf5bd995-7b91-47a5-842f-d411acf97a21'}, 'multiverseid': None}, {'name': 'Sources thermales', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '823304c5-98a0-48e6-9f18-1af3f1d68e9b'}, 'multiverseid': None}, {'name': 'Sorgenti Calde', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '132ae261-569c-4ffe-979a-85b1d0822411'}, 'multiverseid': None}, {'name': 'Fontes Aquecidas', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '61373aa8-64cb-4a84-97a2-1afd32d23e77'}, 'multiverseid': None}]", "[{'name': 'Hekatombe', 'text': 'Opfere vier Kreaturen, wenn die Hekatombe ins Spiel kommt, oder begrabe die Hekatombe.\\n0: Tappe einen Sumpf, den Du beherrschst, damit die Hekatombe einer Kreatur oder einem Spieler Deiner Wahl 1 Schadenspunkt zufügt.', 'type': 'Verzauberung', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '25e1a1b1-2a9d-4ad3-a708-fb5a75f54793'}, 'multiverseid': None}, {'name': 'Hecatombe', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '5a2aa631-3506-4a7f-bd81-f43bf6055f45'}, 'multiverseid': None}, {'name': 'Hécatombe', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '11fcf532-e661-4de3-b63e-2fcab79ae8bc'}, 'multiverseid': None}, {'name': 'Ecatombe', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '930365b9-a2fa-47fe-8bd9-f42073d3c9f9'}, 'multiverseid': None}, {'name': 'Hecatombe', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6fa820fd-01b2-4dfc-b661-de6074b8c75d'}, 'multiverseid': None}]", "[{'name': 'Hellsichtigkeit', 'text': 'Schaue Dir die Hand eines Spielers Deiner Wahl an. Ziehe eine Karte zu Beginn der Versorgungsphase des nächsten Zuges.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'a0dad096-7705-4a59-a15c-215676afcd8d'}, 'multiverseid': None}, {'name': 'Clarividencia', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'e1fc554a-1449-44b3-8519-09355fda25b1'}, 'multiverseid': None}, {'name': 'Clairvoyance', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': '7eccfb50-8174-42a9-911e-db2913b7e15c'}, 'multiverseid': None}, {'name': 'Chiaroveggenza', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': '5b58f366-ab2b-47e8-a6aa-9e9b9b0a3744'}, 'multiverseid': None}, {'name': 'Clarividência', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'cc3437cc-e167-465c-985f-542ef4fe5846'}, 'multiverseid': None}]", '[{\'name\': \'Hematittalisman\', \'text\': \'{3}: Enttappe eine bleibende Karte Deiner Wahl. Benutze diese Fähigkeit nur, wenn ein roter Spruch erfolgreich gesprochen wurde, und nur einmal pro Spruch.\', \'type\': \'Artefakt\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d40c07b0-ae80-4d7e-8c29-02d26bf034d5\'}, \'multiverseid\': None}, {\'name\': \'Talismán de hematites\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1f05f6b-f5f8-4527-8bcd-4d3c1a9317c1\'}, \'multiverseid\': None}, {\'name\': "Talisman d\'hématite", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dbf2ec64-586c-4462-bc81-9e82df489cca\'}, \'multiverseid\': None}, {\'name\': \'Talismano di Ematite\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0c1d4161-eb0b-44a8-a318-0a31e3ca7312\'}, \'multiverseid\': None}, {\'name\': \'Talismã de Hematita\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2bcdd2c0-9955-45fe-881f-c54d2d382174\'}, \'multiverseid\': None}]', '[{\'name\': \'Herrscherin des Unsichtbaren\', \'text\': \'{1}{U}, {T}: Enttappe ein Artefakt Deiner Wahl, das ein Gegner beherrscht, und kontrolliere es bis zum Ende des Zuges. Handelt es sich um eine Artefaktkreatur, kann sie angreifen oder Fähigkeiten benutzen, die Tap als Teil der Aktivierungskosten erfordern. Tappe das Artefakt, wenn Du die Kontrolle über es verlierst.\', \'type\': \'Beschwörung einer Zauberin\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2925f798-7b66-47d1-bfd8-a4821d1b9edb\'}, \'multiverseid\': None}, {\'name\': \'Maga de los Invisibles\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1ca6dce8-320b-45af-8dda-dfd06f762424\'}, \'multiverseid\': None}, {\'name\': "Mage de l\'Inapparence", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'064e8352-ee0b-4390-9390-daa95b74f6a4\'}, \'multiverseid\': None}, {\'name\': "Mago dell\'Invisibile", \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'89ee859b-e198-422a-be72-d0060b9c73ec\'}, \'multiverseid\': None}, {\'name\': \'Magus do Ilusionismo\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b929aad8-8368-48ee-8ae9-642438ca0bda\'}, \'multiverseid\': None}]', '[{\'name\': \'Heulen aus dem Jenseits\', \'text\': \'Die Zielkreatur erhält +X/+0 bis zum Ende des Zuges.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0cf8c2cb-2bc2-4aff-b379-2ddbe8319f78\'}, \'multiverseid\': None}, {\'name\': \'Aullido del más allá\', \'flavor\': None, \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe0763d1-4c7b-4af6-8b76-ea76782d9d96\'}, \'multiverseid\': None}, {\'name\': "Rugissement de l\'au-delà", \'flavor\': None, \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82ee6c9c-5f91-41db-8b09-1e19eb6094bc\'}, \'multiverseid\': None}, {\'name\': \'Ululato Infernale\', \'flavor\': None, \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9223d749-1743-4ae6-a0a2-5c3ddee8df57\'}, \'multiverseid\': None}, {\'name\': \'Uivo do Além\', \'flavor\': None, \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'67c55a0d-6b02-4a7a-bc5c-19f22ea12093\'}, \'multiverseid\': None}]', "[{'name': 'Himmelsschwert', 'text': '3, {T}: Eine Kreatur Deiner Wahl, die Du beherrschst, erhält +3/+3 bis zum Ende des Zuges. Begrabe diese Kreatur am Ende des Zuges.', 'type': 'Artefakt', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'ba79df7c-0d9b-46d9-8a4d-788322911680'}, 'multiverseid': None}, {'name': 'Espada celestial', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': 'f5ec5c08-33e8-487c-affd-c484dd5d4ecc'}, 'multiverseid': None}, {'name': 'Epée céleste', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'd9b99d21-725e-452d-96a8-63b3a443208c'}, 'multiverseid': None}, {'name': 'Spada Celestiale', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'df8309a5-72c4-4bc3-9901-adff535c4a0d'}, 'multiverseid': None}, {'name': 'Espada Celestial', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '822938f2-2d62-4789-bf0b-feddf14c79ab'}, 'multiverseid': None}]", "[{'name': 'Himmlischer Beistand', 'text': 'Verhindere bis zu 3 Schadenspunkte an einer Zielkreatur. Lege am Ende des Zuges eine +0/+1-Spielmarke auf diese Kreatur für jeden Schadenspunkt, der durch den Himmlischen Beistand verhindert wurde.', 'type': 'Spontanzauber', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '6bb37133-7ddc-4c55-90d9-cfbf3bcd1d7f'}, 'multiverseid': None}, {'name': 'Dádiva sagrada', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '8dcc5ce7-cc27-4f52-8fd1-b4c3bece0bf5'}, 'multiverseid': None}, {'name': 'Faveur sacrée', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'b983d4c9-0f47-4d0c-a05f-04221872d85f'}, 'multiverseid': None}, {'name': 'Dono Divino', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'd4fab63d-8fad-4651-97a0-ac924c008f8c'}, 'multiverseid': None}, {'name': 'Bênção Sagrada', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6b2b8da1-8625-4b84-8cfa-e9e850658dd6'}, 'multiverseid': None}]", "[{'name': 'Hipparion', 'text': 'Kann nicht deklariert werden, Kreaturen zu blocken, die eine Stärke größer als 3 haben, wenn Du nicht zusätzlich 1 bezahlst.', 'type': 'Beschwörung eines Hipparions', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': 'b8ec6fde-773c-411f-aff9-ab960d39d71d'}, 'multiverseid': None}, {'name': 'Hiparión', 'flavor': None, 'language': 'Spanish', 'identifiers': {'scryfallId': '2da5059e-2b51-4e96-80f8-3575afba60ce'}, 'multiverseid': None}, {'name': 'Hipparion', 'flavor': None, 'language': 'French', 'identifiers': {'scryfallId': 'cd126fd4-6efe-4090-aa30-7a629a92d431'}, 'multiverseid': None}, {'name': 'Ipparione', 'flavor': None, 'language': 'Italian', 'identifiers': {'scryfallId': 'e23e9ed6-4ed7-4ea3-b88f-110eeea43194'}, 'multiverseid': None}, {'name': 'Hifárion', 'flavor': None, 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8e4aefea-f473-4c7e-aa78-f781cae22289'}, 'multiverseid': None}]", "[{'name': 'Hurrikan', 'text': 'Der Hurrikan fügt allen Spielern und allen fliegenden Kreaturen X Schadenspunkte zu.', 'type': 'Hexerei', 'flavor': None, 'language': 'German', 'identifiers': {'scryfallId': '3e136