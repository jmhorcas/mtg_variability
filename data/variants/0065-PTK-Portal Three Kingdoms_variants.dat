ne}]", "[{'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '946931c0-a035-4732-a7ce-46a2c7981eff'}, 'multiverseid': None}, {'name': 'Swamp', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '363e6bd4-505c-427c-b4a8-e8a0bcec2917'}, 'multiverseid': None}]", "[{'name': '消力', 'text': 'ソーサリー呪文１つを対象とし、それを打ち消す。', 'type': 'インスタント', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '90f6340f-815b-4de6-bfb1-6a45f6ccb1a5'}, 'multiverseid': None}, {'name': 'Extinguish', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fb5eb24f-abdc-493a-a748-a00de88cbdb2'}, 'multiverseid': None}]", "[{'name': '深き霧', 'text': '深き霧は攻撃クリーチャー指定ステップの間で、あなたがこのステップで攻撃されているならば唱えられる。\\nこのターン、攻撃クリーチャーがあなたに与えるすべてのダメージを軽減する。', 'type': 'インスタント', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '974e22ff-2cd0-4ee9-ac43-f8dfa0e30283'}, 'multiverseid': None}, {'name': 'Heavy Fog', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ab52daac-bf8c-49b8-ad9a-23fb77d0859e'}, 'multiverseid': None}]", "[{'name': '火攻め', 'text': 'クリーチャー１体かプレイヤー１人を対象とする。火攻めはそれに３点のダメージを与える。', 'type': 'ソーサリー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '146826bc-9d33-4d99-bf21-f74034687054'}, 'multiverseid': None}, {'name': 'Fire Ambush', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5d923d30-8b55-4e22-9ef5-144be47bab48'}, 'multiverseid': None}]", "[{'name': '火矢の弓兵', 'text': '火矢の弓兵を生け贄に捧げる：クリーチャー１体かプレイヤー１人を対象とする。火矢の弓兵はそれに１点のダメージを与える。この能力は、あなたのターンの間で、攻撃クリーチャーが指定される前にのみ起動できる。', 'type': 'クリーチャー — 人間・兵士・射手', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '75c2bc76-eda4-4ec5-b2bd-2b041c493918'}, 'multiverseid': None}, {'name': 'Fire Bowman', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5885cc1a-efd2-4912-a12d-b84962ed191c'}, 'multiverseid': None}]", '[{\'name\': \'災難の補償\', \'text\': \'クリーチャー１体を対象とし、それを破壊する。オーナーは４点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': None, \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'508ca24d-7903-4166-9c0c-0d361beae64e\'}, \'multiverseid\': None}, {\'name\': "Misfortune\'s Gain", \'flavor\': None, \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cd5df752-7a8c-4496-be1d-c4883d384627\'}, \'multiverseid\': None}]', "[{'name': '烈女 祝融夫人', 'text': '馬術（このクリーチャーは、馬術を持たないクリーチャーによってはブロックされない。）', 'type': '伝説のクリーチャー — 人間・兵士・戦士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '3c785923-796e-4e61-8a20-581e8754e9a4'}, 'multiverseid': None}, {'name': 'Lady Zhurong, Warrior Queen', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '62c157ea-cbed-4bbe-9f57-c06070b54ee8'}, 'multiverseid': None}]", "[{'name': '狡猾な参謀', 'text': '(Ｔ)：対戦相手１人を対象とする。そのプレイヤーはカードを１枚捨てる。この能力は、あなたのターンの間で、攻撃クリーチャーが指定される前にのみ起動できる。', 'type': 'クリーチャー — 人間・アドバイザー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '2d6a1b0b-8f44-455b-a153-33c70bd52141'}, 'multiverseid': None}, {'name': 'Cunning Advisor', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '18ac26f4-8dd0-4255-8cbc-f4e478d94a0b'}, 'multiverseid': None}]", "[{'name': '狩りをする豹', 'text': '狩りをする豹が対戦相手にダメージを与えるたび、あなたはあなたのライブラリーから森(Forest)カードを１枚探してもよい。そうした場合、そのカードを公開し、あなたの手札に加える。その後あなたのライブラリーを切り直す。', 'type': 'クリーチャー — 猫', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '0a44bf51-ba9a-4cb1-8d72-d3699484e2f4'}, 'multiverseid': None}, {'name': 'Hunting Cheetah', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fc0b21b6-54e9-441e-995c-d4dc7826e435'}, 'multiverseid': None}]", "[{'name': '独立部隊', 'type': 'クリーチャー — 人間・兵士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '9298578e-74e6-4b33-99da-f31ba6b752b5'}, 'multiverseid': None}, {'name': 'Independent Troops', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6c659248-575f-41c7-9194-445483c4b8cb'}, 'multiverseid': None}]", "[{'name': '狼の群れ', 'text': 'あなたは「狼の群れは、それがブロックされなかったかのようにその戦闘ダメージを割り振られる」ことを選んでもよい。', 'type': 'クリーチャー — 狼', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'd84eba43-c567-4608-81ab-e5ff87eb8cba'}, 'multiverseid': None}, {'name': 'Wolf Pack', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '1be3d01c-86e3-46e2-8163-2ff9fba889b3'}, 'multiverseid': None}]", "[{'name': '猛将 張飛', 'text': '警戒、馬術（このクリーチャーは、馬術を持たないクリーチャーによってはブロックされない。）', 'type': '伝説のクリーチャー — 人間・兵士・戦士', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'b24dc7c8-463c-44ac-a4b4-69fdadb55eb6'}, 'multiverseid': None}, {'name': 'Zhang Fei, Fierce Warrior', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '3dba76c8-1d69-4c8d-a679-9186ede609d7'}, 'multiverseid': None}]", "[{'name': '猛火', 'text': 'クリーチャー１体かプレイヤー１人を対象とする。猛火はそれにＸ点のダメージを与える。', 'type': 'ソーサリー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': 'f7eb651a-c52a-4429-976a-1c20bed8a2bf'}, 'multiverseid': None}, {'name': 'Blaze', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '34931f61-e5d2-4081-ad53-96d60bb3eff9'}, 'multiverseid': None}]", "[{'name': '猛虎', 'text': '猛虎がブロックされた状態になるたび、それはターン終了時まで+2/+2の修整を受ける。', 'type': 'クリーチャー — 猫', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '207a2323-05de-406d-baf7-c22e2918effa'}, 'multiverseid': None}, {'name': 'Slashing Tiger', 'flavor': None, 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e8077d48-ed1f-448d-9dbe-461a2c6f35b3'}, 'multiverseid': None}]", "[{'name': '疲労困憊', 'text': '対戦相手１人を対象とする。そのプレイヤーがコントロールするクリーチャーと土地は、そのプレイヤーの次のアンタップ・ステップにアンタップしない。', 'type': 'ソーサリー', 'flavor': None, 'language': 'Japanese', 'identifiers': {'scryfallId': '83829491-9c6b-4eec-82bd-a3179ed12ff8'}, 'm