}, 'multiverseid': 177731}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177850&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '208c97ff-e0b6-4526-9107-f758a2d290b4', 'multiverseId': 177850}, 'multiverseid': 177850}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177804&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'bcf2a6b3-fa23-440e-8982-0604358de8d9', 'multiverseId': 177804}, 'multiverseid': 177804}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177828&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '41a2fe0c-8e79-47cd-9dd4-4aca637d91e3', 'multiverseId': 177828}, 'multiverseid': 177828}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177875&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e13e03f5-2e91-47b0-a2e4-27bc95da83f1', 'multiverseId': 177875}, 'multiverseid': 177875}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177899&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '33dacaae-de61-4636-973b-d795c93e8625', 'multiverseId': 177899}, 'multiverseid': 177899}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177780&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '261ada97-8c16-455b-8bce-afda5ce4f5f0', 'multiverseId': 177780}, 'multiverseid': 177780}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177756&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f87afd47-f474-469e-89dc-6d277b8a799b', 'multiverseId': 177756}, 'multiverseid': 177756}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177732&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'da5bcbc1-dfc0-4be0-ba0d-dc29f73d1439', 'multiverseId': 177732}, 'multiverseid': 177732}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177851&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '50f57932-2443-41e3-b706-aa785ce6bf6c', 'multiverseId': 177851}, 'multiverseid': 177851}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177805&type=card', 'language': 'German', 'identifiers': {'scryfallId': '811d814b-deba-4fdd-8661-014950699803', 'multiverseId': 177805}, 'multiverseid': 177805}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177829&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4c97dbff-ce93-42ef-9f99-c3e2ad8c324c', 'multiverseId': 177829}, 'multiverseid': 177829}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177876&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ca4f6aac-de09-4f77-904b-60137f426f0c', 'multiverseId': 177876}, 'multiverseid': 177876}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177900&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '686e4f99-f1fe-42ee-ab4e-c8e86b8fba06', 'multiverseId': 177900}, 'multiverseid': 177900}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177781&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f42a9c2a-0d3e-404c-94ed-2a5360880522', 'multiverseId': 177781}, 'multiverseid': 177781}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177757&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '98820949-ae68-4e43-b686-7cff788ddec3', 'multiverseId': 177757}, 'multiverseid': 177757}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177733&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e48940e7-7853-42aa-8b14-d1e0bd672ce9', 'multiverseId': 177733}, 'multiverseid': 177733}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177852&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '91a22b96-ba47-407a-ae0a-c95a2130d70b', 'multiverseId': 177852}, 'multiverseid': 177852}]", "[{'name': 'Egelbefallener Sumpf', 'text': '({T}: Erhöhe deinen Manavorrat um {B}.)\\nDer Egelbefallene Sumpf kommt getappt ins Spiel.\\n{B}, {T}: Jeder Gegner verliert 1 Lebenspunkt. Spiele diese Fähigkeit nur, falls du zwei oder mehr schwarze bleibende Karten kontrollierst.', 'type': 'Land — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174750&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3ff08f8c-8e88-4244-9755-04502ec56c0a', 'multiverseId': 174750}, 'multiverseid': 174750}, {'name': 'Pantano plagado de sanguijuelas', 'text': '({T}: Agrega {B} a tu reserva de maná.)\\nEl Pantano plagado de sanguijuelas entra en juego girado.\\n{B}, {T}: Cada oponente pierde 1 vida. Juega esta habilidad sólo si controlas dos o más permanentes negros.', 'type': 'Tierra — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172944&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd08ecd4b-6d69-4f4b-b78d-8fe6aedd5f4d', 'multiverseId': 172944}, 'multiverseid': 172944}, {'name': 'Marais envahi par les sangsues', 'text': '({T} : Ajoutez {B} à votre réserve.)\\nLe Marais envahi par les sangsues arrive en jeu engagé.\\n{B}, {T} : Chaque adversaire perd 1 point de vie. Ne jouez cette capacité que si vous contrôlez au moins deux permanents noirs.', 'type': 'Terrain : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173546&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd5a2c51e-af18-4156-8e3d-ff7af3f0a45e', 'multiverseId': 173546}, 'multiverseid': 173546}, {'name': 'Palude delle Sanguisughe', 'text': '({T}: Aggiungi {B} alla tua riserva di mana.)\\nLa Palude delle Sanguisughe entra in gioco TAPpata.\\n{B}, {T}: Ogni avversario perde 1 punto vita. Gioca questa abilità solo se controlli due o più permanenti neri.', 'type': 'Terra — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173847&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '11b68832-f86f-449c-89ca-bc7d62dba76e', 'multiverseId': 173847}, 'multiverseid': 173847}, {'name': 'ヒル溜りの沼', 'text': '（{T}：あなたのマナプールに{B}を加える。）\\nヒル溜りの沼はタップ状態で場に出る。\\n{B}, {T}：各対戦相手はそれぞれ１点のライフを失う。 この能力は、あなたが２つ以上の黒のパーマネントをコントロールしている場合にのみプレイできる。', 'type': '土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174148&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'bb79fd24-4a27-48ce-98a0-054b790ed396', 'multiverseId': 174148}, 'multiverseid': 174148}, {'name': 'Pântano das Sanguessugas', 'text': '({T}: Adicione {B} à sua reserva de mana.)\\nPântano das Sanguessugas entra em jogo virado.\\n{B}, {T}: Cada oponente perde 1 ponto de vida. Jogue esta habilidade somente se você controlar duas ou mais permanentes pretas.', 'type': 'Terreno — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172342&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '04203d5d-1f12-49b9-a084-ac1a5eaca215', 'multiverseId': 172342}, 'multiverseid': 172342}, {'name': 'Кишащее Пиявками Болото', 'text': '({T}: добавьте {B} в ваше хранилище маны.)\\nКишащее Пиявками Болото входит в игру повернутым.\\n{B}, {T}: каждый оппонент теряет 1 жизнь. Разыгрывайте эту способность, только если вы контролируете два или более черных перманента.', 'type': 'Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172643&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0dc56910-8ca3-4e60-8364-1826834b0b5c', 'multiverseId': 172643}, 'multiverseid': 172643}, {'name': '遍蛭沼泽', 'text': '（{T}：加{B}到你的法术力池中。）\\n遍蛭沼泽须横置进场。\\n{B}，{T}：每位对手各失去1点生命。 你只可以于你操控两个或更多黑色永久物时使用此异能。', 'type': '地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173245&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '63c0df5d-92f3-4abf-8333-385c79ba1486', 'multiverseId': 173245}, 'multiverseid': 173245}]", '[{\'name\': \'Egelsetzer\', \'text\': \'Der Egelsetzer kommt mit zwei -1/-1-Marken ins Spiel.\\n{U}, {Q}: Bewege eine Marke von einer Kreatur deiner Wahl auf eine andere Kreatur deiner Wahl. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Meervolk, Soldat\', \'flavor\': \'Manche wissen nicht, wie er aussieht, aber seine Haustiere verraten ihn immer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174520&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9f07d74-c743-4c70-9193-a5b46010a1c7\', \'multiverseId\': 174520}, \'multiverseid\': 174520}, {\'name\': \'Ligador de sanguijuelas\', \'text\': \'El Ligador de sanguijuelas entra en juego con dos contadores -1/-1 sobre él.\\n{U}, {Q}: Mueve un contador de la criatura objetivo a otra criatura objetivo. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Soldado tritón\', \'flavor\': \'Algunos no conocen su rostro, pero sus mascotas son muy evidentes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172714&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1fa7f9f3-a4da-4330-8d37-2e157c15cf7a\', \'multiverseId\': 172714}, \'multiverseid\': 172714}, {\'name\': \'Attacheur de sangsues\', \'text\': "L\'Attacheur de sangsues arrive en jeu avec deux marqueurs -1/-1 sur lui.\\n{U}, {Q} : Déplacez un marqueur de la créature ciblée sur une autre créature ciblée. ({Q} est le symbole de dégagement.)", \'type\': \'Créature : ondin et soldat\', \'flavor\': \'Certains ne connaissent pas son visage, mais ses petits familiers sont révélateurs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173316&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a197773a-8693-4ed7-a56d-a43691e3d420\', \'multiverseId\': 173316}, \'multiverseid\': 173316}, {\'name\': \'Dispensatore di Sanguisughe\', \'text\': "Il Dispensatore di Sanguisughe entra in gioco con due segnalini -1/-1.\\n{U}, {Q}: Sposta un segnalino da una creatura bersaglio a un\'altra creatura bersaglio. ({Q} è il simbolo di STAP.)", \'type\': \'Creatura — Soldato Tritone\', \'flavor\': \'Molti non conoscono il suo volto, ma i suoi animaletti sono indizi mortali.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173617&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b97b0cb5-50db-4169-a5d5-dbb550203673\', \'multiverseId\': 173617}, \'multiverseid\': 173617}, {\'name\': \'ヒル結び\', \'text\': \'ヒル結びは－１/－１カウンターが２個置かれた状態で場に出る。\\n{U}, {Q}：クリーチャー１体と他のクリーチャー１体を対象とする。その前者の上に置かれているカウンター１個を、その後者の上に移動する。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — マーフォーク･兵士\', \'flavor\': \'彼の顔を知らない者もいるが、彼のペットを見れば一目瞭然だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173918&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca8d98d1-847b-4ebe-ab5b-52afc07f86a9\', \'multiverseId\': 173918}, \'multiverseid\': 173918}, {\'name\': \'Aplicador de Sanguessuga\', \'text\': \'Aplicador de Sanguessuga entra em jogo com dois marcadores -1/-1.\\n{U}, {Q}: Mova um marcador da criatura alvo para outra criatura alvo. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Tritão Soldado\', \'flavor\': \'Alguns desconhecem seu rosto, mas seus animais de estimação são um presente mortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172112&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'422f03fa-d6c5-49da-9741-dad96f68c172\', \'multiverseId\': 172112}, \'multiverseid\': 172112}, {\'name\': \'Рассадчик Пиявок\', \'text\': \'Рассадчик Пиявок входит в игру с двумя жетонами -1/-1 на нем.\\n{U}, {Q}: переместите один жетон с целевого существа на другое целевое существо. ({Q} символ разворота карты.)\', \'type\': \'Существо — Мерфолк Солдат\', \'flavor\': \'Не все знают кто он такой, но по его питомцам об этом нетрудно догадаться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172413&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d203aba6-788f-4f23-a90d-5cb635dc7cc7\', \'multiverseId\': 172413}, \'multiverseid\': 172413}, {\'name\': \'弄蛭人\', \'text\': \'弄蛭人进场时上面有两个-1/-1指示物。\\n{U}，{Q}：将一个指示物从目标生物移到另一个目标生物上。 （{Q}是重置符号。）\', \'type\': \'生物～人鱼／士兵\', \'flavor\': \'有些人没见过他的长相，但他的宠物是个很好的线索。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173015&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'76f695ed-3b0e-454e-bc2a-ada54c90b6b2\', \'multiverseId\': 173015}, \'multiverseid\': 173015}]', '[{\'name\': \'Eifriger Wächter\', \'text\': \'Aufblitzen\', \'type\': \'Kreatur — Kithkin, Soldat\', \'flavor\': \'Die Brustwehr-Posten patrouillieren den äußersten Rand des Marktfleckens und geben denen Signale, die geduldig im Schatten lauern.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174634&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'944f12c8-769e-4e43-ac56-10d37eccce4e\', \'multiverseId\': 174634}, \'multiverseid\': 174634}, {\'name\': \'Guardián ferviente\', \'text\': \'Destello.\', \'type\': \'Criatura — Soldado kithkin\', \'flavor\': \'Los observadores de parapetos patrullan los bordes exteriores del doun, avisando a los otros que esperan pacientemente en las sombras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172828&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01b66eef-69e0-423f-a554-f379aea306d9\', \'multiverseId\': 172828}, \'multiverseid\': 172828}, {\'name\': \'Vigile zélé\', \'text\': \'Flash\', \'type\': \'Créature : sangami et soldat\', \'flavor\': "Les gardiens de parapet patrouillent le périmètre du doune, faisant signe aux autres qui patientent dans l\'ombre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173430&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7adeb866-9749-48b3-95fe-d436bdc1ddec\', \'multiverseId\': 173430}, \'multiverseid\': 173430}, {\'name\': \'Guardiano Zelante\', \'text\': \'Lampo\', \'type\': \'Creatura — Soldato Kithkin\', \'flavor\': \'Le sentinelle del parapetto pattugliano il margine esterno del doun, segnalando agli altri che aspettano pazientemente nelle ombre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173731&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'08c5e732-9505-4ccf-b824-a10fe8654012\', \'multiverseId\': 173731}, \'multiverseid\': 173731}, {\'name\': \'盲信の守護者\', \'text\': \'瞬速\', \'type\': \'クリーチャー — キスキン・兵士\', \'flavor\': \'胸壁見張りは矮村の端を見回り、影の中にじっと待っている者達に合図を送る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174032&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16c9a3ff-51aa-415e-8e06-8d2a8671555d\', \'multiverseId\': 174032}, \'multiverseid\': 174032}, {\'name\': \'Guardião Zeloso\', \'text\': \'Lampejo\', \'type\': \'Criatura — Kithkin Soldado\', \'flavor\': \'Os vigilantes de parapeito patrulham as extremidades externas do doun, sinalizando aos outros que aguardam pacientemente nas sombras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172226&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'198603a1-c1fe-4ba5-b159-751926f3e532\', \'multiverseId\': 172226}, \'multiverseid\': 172226}, {\'name\': \'Ревностный Страж\', \'text\': \'Миг\', \'type\': \'Существо — Кискен Солдат\', \'flavor\': \'Дозорные патрулируют границы острога, подавая сигналы остальным, терпеливо ждущим под покровом тени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172527&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f3dfe854-41c4-44c9-be29-9cf9916075c0\', \'multiverseId\': 172527}, \'multiverseid\': 172527}, {\'name\': \'热诚守护者\', \'text\': \'闪现\', \'type\': \'生物～洁英／士兵\', \'flavor\': \'胸墙看守在小镇边境巡逻，并对在暗影中耐心守候的同伴打暗号。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173129&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'877a3ce5-5d67-4b0d-86be-5e41bb88d3f7\', \'multiverseId\': 173129}, \'multiverseid\': 173129}]', '[{\'name\': \'Eindringlinge zurücktreiben\', \'text\': \'Bringe zwei 1/1 weiße (Kithkin, Soldat)-Kreaturenspielsteine ins Spiel, falls {W} ausgegeben wurde, um Eindringlinge zurücktreiben zu spielen. Neutralisiere bis zu einen Kreaturenzauber deiner Wahl, falls {U} ausgegeben wurde, um Eindringlinge zurücktreiben zu spielen. (Mache beides, falls {W}{U} ausgegeben wurde.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174624&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1d7d551c-aca6-48d3-a697-dd080d626755\', \'multiverseId\': 174624}, \'multiverseid\': 174624}, {\'name\': \'Repeler a los intrusos\', \'text\': \'Pon en juego dos fichas de criatura Soldado Kithkin blancas 1/1 si se usó {W} paga jugar Repeler a los intrusos. Contrarresta hasta un hechizo de criatura objetivo si se usó {U} paga jugar Repeler a los intrusos. (Haz ambos si se usó {W}{U}.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172818&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fcf380cd-6795-4390-a1d6-1665b448aac0\', \'multiverseId\': 172818}, \'multiverseid\': 172818}, {\'name\': \'Repoussement des intrus\', \'text\': "Mettez en jeu deux jetons de créature 1/1 blanche Sangami et Soldat si {W} a été dépensé pour jouer le Repoussement des intrus. Contrecarrez jusqu\'à un sort de créature ciblé si {U} a été dépensé pour jouer le Repoussement des intrus. (Faites les deux si {W}{U} a été dépensé.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173420&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0f7253f5-c4e6-4b9e-a8cb-b577685baf05\', \'multiverseId\': 173420}, \'multiverseid\': 173420}, {\'name\': \'Respingere gli Intrusi\', \'text\': \'Metti in gioco due pedine creatura Soldato Kithkin 1/1 bianche se è stato speso {W} per giocare Respingere gli Intrusi. Neutralizza fino a una magia creatura bersaglio se è stato speso {U} per giocare Respingere gli Intrusi. (Compi entrambe le azioni se è stato speso {W}{U}.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173721&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3a9144b2-a523-4197-8c2d-4b815956210a\', \'multiverseId\': 173721}, \'multiverseid\': 173721}, {\'name\': \'侵入の追い返し\', \'text\': \'侵入の追い返しをプレイするために{W}が支払われている場合、白の１/１のキスキン・兵士・クリーチャー・トークンを２体場に出す。 侵入の追い返しをプレイするために{U}が支払われている場合、最大１つまでの呪文を対象とし、それを打ち消す。 （{W}{U}が支払われている場合、両方を行う。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174022&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'74829ae0-4264-47d7-a29d-46b561a17819\', \'multiverseId\': 174022}, \'multiverseid\': 174022}, {\'name\': \'Repelir Intrusos\', \'text\': \'Coloque em jogo duas fichas de criatura brancas 1/1 do tipo Kithkin Soldado se {W} foi gasto para jogar Repelir Intrusos. Anule até uma mágica de criatura alvo se {U} foi gasto para jogar Repelir Intrusos. (Faça ambas as coisas se {W}{U} foi gasto.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172216&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e281c27-e233-45dd-87b1-a03b330cb2cb\', \'multiverseId\': 172216}, \'multiverseid\': 172216}, {\'name\': \'Отразить Вторжение\', \'text\': \'Положите в игру две фишки существа 1/1 белый Кискен Солдат, если на разыгрывание Отразить Вторжение было потрачено {W}. Отмените не более одного целевого заклинания существа, если на разыгрывание Отразить Вторжение было потрачено {U}. (Сделайте и то и другое, если было потрачено {W}{U}.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172517&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fcd7ce3c-f248-4565-bd39-f78472e7bbfa\', \'multiverseId\': 172517}, \'multiverseid\': 172517}, {\'name\': \'逐退入侵者\', \'text\': \'如果使用逐退入侵者时支付了{W}，则将两个1/1白色的洁英／士兵衍生物放置进场。 如果使用逐退入侵者时支付了{U}，则反击至多一个目标生物咒语。 （如果支付了{W}{U}，则两者都作。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173119&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'54178e98-71ca-4991-8c3e-33532930265a\', \'multiverseId\': 173119}, \'multiverseid\': 173119}]', '[{\'name\': \'Einschneidende Gurte\', \'text\': \'Kreaturenverzauberung\\nDu kontrollierst die verzauberte Kreatur.\\nLege zu Beginn deines Versorgungssegments eine -1/-1-Marke auf die verzauberte Kreatur.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Eine Verkettung von Lügen, so hart wie Stahl.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174506&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'69891f52-4767-4620-b2fc-b8ae0ec57732\', \'multiverseId\': 174506}, \'multiverseid\': 174506}, {\'name\': \'Cadena mordiente\', \'text\': \'Encantar criatura.\\nTú controlas la criatura encantada.\\nAl comienzo de tu mantenimiento, pon un contador -1/-1 sobre la criatura encantada.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Una cadena de mentiras fuerte como el acero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172700&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4e5f8733-91c0-4c00-a291-86fe2617b8ef\', \'multiverseId\': 172700}, \'multiverseid\': 172700}, {\'name\': \'Chaîne mordante\', \'text\': \'Enchanter : créature\\nVous contrôlez la créature enchantée.\\nAu début de votre entretien, mettez un marqueur -1/-1 sur la créature enchantée.\', \'type\': \'Enchantement : aura\', \'flavor\': "Une chaîne de mensonges aussi résistante que l\'acier.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173302&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16198bec-c58d-4d39-904e-6c377d4c9457\', \'multiverseId\': 173302}, \'multiverseid\': 173302}, {\'name\': \'Catena Sferzante\', \'text\': "Incanta creatura\\nControlli la creatura incantata.\\nAll\'inizio del tuo mantenimento, metti un segnalino -1/-1 sulla creatura incantata.", \'type\': \'Incantesimo — Aura\', \'flavor\': "Una catena di bugie forte come l\'acciaio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173603&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9cb3316-c682-4b5e-8673-fa95215e5314\', \'multiverseId\': 173603}, \'multiverseid\': 173603}, {\'name\': \'食いつくいましめ\', \'text\': \'エンチャント（クリーチャー）\\nあなたはエンチャントされているクリーチャーをコントロールする。\\nあなたのアップキープの開始時に、エンチャントされているクリーチャーの上に－１/－１カウンターを１個置く。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'鋼の如く強い嘘の数々。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173904&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d539fb4-8cef-4ab5-9754-a85cfa093115\', \'multiverseId\': 173904}, \'multiverseid\': 173904}, {\'name\': \'Corrente Mordaz\', \'text\': \'Encantar criatura\\nVocê controla a criatura encantada.\\nNo início de sua manutenção, coloque um marcador -1/-1 na criatura encantada.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Uma corrente de mentiras tão forte quanto o aço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172098&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'60676d7a-5ece-486f-abd3-87e201e778af\', \'multiverseId\': 172098}, \'multiverseid\': 172098}, {\'name\': \'Жалящая Привязь\', \'text\': \'Зачаровать существо\\nВы контролируете зачарованное существо.\\nВ начале вашего шага поддержки положите один жетон -1/-1 на зачарованное существо.\', \'type\': \'Чары — Аура\', \'flavor\': \'Цепь обманов прочна как сталь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172399&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'71e638ac-663d-4e33-a343-e3816b5dcd35\', \'multiverseId\': 172399}, \'multiverseid\': 172399}, {\'name\': \'刺痛栓链\', \'text\': \'生物结界\\n你操控受此结界的生物。\\n在你的维持开始时，在受此结界的生物上放置一个-1/-1指示物。\', \'type\': \'结界～灵气\', \'flavor\': \'谎言锁链坚硬如钢。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173001&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7d03dc3a-aeae-4f99-b6ca-f11009dff10c\', \'multiverseId\': 173001}, \'multiverseid\': 173001}]', '[{\'name\': \'Elementare Überlegenheit\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat „{T}: Bringe X 1/1 rote Elementarwesen-Kreaturenspielsteine mit Eile ins Spiel, wobei X gleich der Stärke dieser Kreatur ist. Entferne die Spielsteine am Ende des Zuges ganz aus dem Spiel."\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174567&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d60c13e8-a386-4d92-b6e9-a76e7e0558fb\', \'multiverseId\': 174567}, \'multiverseid\': 174567}, {\'name\': \'Maestría elemental\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "{T}: Pon en juego X fichas de criatura Elemental rojas 1/1 con la habilidad de prisa, donde X es la fuerza de esta criatura. Remuévelas del juego al final del turno".\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172761&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'78361cda-45bb-4e86-be55-3f5faf4bb2bf\', \'multiverseId\': 172761}, \'multiverseid\': 172761}, {\'name\': \'Maîtrise des élémentaux\', \'text\': \'Enchanter : créature\\nLa créature enchantée a « {T} : Mettez en jeu X jetons de créature 1/1 rouge Élémental avec la célérité, X étant la force de cette créature. Retirez-les de la partie à la fin du tour. »\', \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173363&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d67a6657-6bc0-4d23-be4b-4f921d61367d\', \'multiverseId\': 173363}, \'multiverseid\': 173363}, {\'name\': \'Supremazia Elementale\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "{T}: Metti in gioco X pedine creatura Elementale 1/1 rosse con rapidità, dove X è la forza di questa creatura. Rimuovile dal gioco alla fine del turno."\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173664&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3fab4ac0-cf49-4a46-ae39-658e26107c3b\', \'multiverseId\': 173664}, \'multiverseid\': 173664}, {\'name\': \'精霊術の熟達\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは「{T}：速攻を持つ赤の１/１のエレメンタル・クリーチャー・トークンをＸ体場に出す。Ｘはこのクリーチャーのパワーに等しい。 ターン終了時に、それらをゲームから取り除く。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173965&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e3019fcb-3a13-4005-a2e5-daf211ffa7e4\', \'multiverseId\': 173965}, \'multiverseid\': 173965}, {\'name\': \'Maestria Elemental\', \'text\': \'Encantar criatura\\nA criatura encantada tem "{T}: Coloque em jogo X fichas de criatura vermelhas 1/1 do tipo Elemental com ímpeto, sendo X igual ao poder desta criatura. Remova-as de jogo no final do turno.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172159&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cf3c9e17-989d-4d1e-a414-893586a53103\', \'multiverseId\': 172159}, \'multiverseid\': 172159}, {\'name\': \'Познание Элементов\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность «{T}: положите в игру X фишек существа 1/1 красный Элементаль с Ускорением, где X сила этого существа. Удалите их из игры в конце хода».\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172460&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c8ac21aa-b066-4483-9a9b-eb9555d2c9fe\', \'multiverseId\': 172460}, \'multiverseid\': 172460}, {\'name\': \'精研元素\', \'text\': \'生物结界\\n受此结界的生物具有「{T}：将X个1/1红色，具敏捷异能的元素衍生物放置进场，X为此生物的力量。 在回合结束时将它们移出对战。」\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173062&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4f44f417-0e8c-487d-ac3f-7e9a4b2c2f20\', \'multiverseId\': 173062}, \'multiverseid\': 173062}]', '[{\'name\': \'Elfenschar\', \'text\': \'Stärke und Widerstandskraft der Elfenschar sind gleich der Anzahl der grünen bleibenden Karten, die du kontrollierst.\\nDie Elfenschar kann nicht das Ziel von Zaubersprüchen oder Fähigkeiten sein, die dein Gegner kontrolliert.\', \'type\': \'Kreatur — Elf\', \'flavor\': \'„Das Licht der Schönheit beschützt unseren Weg durch die Dunkelheit."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174589&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2f60db21-7760-4826-8a3c-ee85da7991bb\', \'multiverseId\': 174589}, \'multiverseid\': 174589}, {\'name\': \'Gentío de elfos\', \'text\': \'Tanto la fuerza como la resistencia del Gentío de elfos son iguales a la cantidad de permanentes verdes que controlas.\\nEl Gentío de elfos no puede ser objetivo de hechizos o habilidades que controlen tus oponentes.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'"La luz de la belleza protege nuestros viajes en la oscuridad."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172783&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f098ab9c-b58a-44fb-95a1-39807c467142\', \'multiverseId\': 172783}, \'multiverseid\': 172783}, {\'name\': "Troupe d\'elfes", \'text\': "La force et l\'endurance de la Troupe d\'elfes sont chacune égale au nombre de permanents verts que vous contrôlez.\\nLa Troupe d\'elfes ne peut pas être la cible de sorts ou de capacités que vos adversaires contrôlent.", \'type\': \'Créature : elfe\', \'flavor\': \'« La lumière de la beauté protègent nos voyages dans les ténèbres. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173385&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5acc2df-3a6c-4e1a-a454-bd3465d961a5\', \'multiverseId\': 173385}, \'multiverseid\': 173385}, {\'name\': \'Folla di Elfi\', \'text\': \'La forza e la costituzione della Folla di Elfi sono pari al numero di permanenti verdi che controlli.\\nLa Folla di Elfi non può essere bersaglio di magie o abilità controllate dai tuoi avversari.\', \'type\': \'Creatura — Elfo\', \'flavor\': \'"La luce della bellezza protegge il nostro viaggio attraverso l\\\'oscurità."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173686&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'858b9888-14c9-4b39-9ca2-13f331366fd7\', \'multiverseId\': 173686}, \'multiverseid\': 173686}, {\'name\': \'エルフの集団\', \'text\': \'エルフの集団のパワーとタフネスは、それぞれあなたがコントロールする緑のパーマネントの総数に等しい。\\nエルフの集団は、あなたの対戦相手がコントロールする呪文や能力の対象にならない。\', \'type\': \'クリーチャー — エルフ\', \'flavor\': \'「美の光は、闇の中を進む私たちを守ってくれます。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173987&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'549ccbcb-f2f4-4724-ae56-8b4fac9b3265\', \'multiverseId\': 173987}, \'multiverseid\': 173987}, {\'name\': \'Bando de Elfos\', \'text\': \'O poder e resistência de Bando de Elfos são ambos iguais ao número de permanentes verdes que você controla.\\nBando de Elfos não pode ser alvo de mágicas nem de habilidades controladas por seus oponentes.\', \'type\': \'Criatura — Elfo\', \'flavor\': \'"A luz da beleza protege nossas jornadas através da escuridão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172181&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30567c5e-bbf2-467b-b87c-f286b28c9693\', \'multiverseId\': 172181}, \'multiverseid\': 172181}, {\'name\': \'Стая Эльфов\', \'text\': \'Сила и выносливость Стаи Эльфов равны количеству зеленых перманентов под вашим контролем.\\nСтая Эльфов не может быть целью заклинаний или способностей под контролем ваших оппонентов.\', \'type\': \'Существо — Эльф\', \'flavor\': \'«Свет красоты оберегает нас на пути через тьму».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172482&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f69d128a-484d-487f-8a0c-0a105da02cd7\', \'multiverseId\': 172482}, \'multiverseid\': 172482}, {\'name\': \'地精齐群\', \'text\': \'地精齐群的力量及防御力各等同于由你操控的绿色永久物之数量。\\n地精齐群不能成为由对手所操控之咒语或异能的目标。\', \'type\': \'生物～地精\', \'flavor\': \'「美之光芒保佑我们穿越黑暗。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173084&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0fe9439a-2743-406f-b43a-01a9bf151cf3\', \'multiverseId\': 173084}, \'multiverseid\': 173084}]', '[{\'name\': \'Elfischer Zauberjäger\', \'text\': \'{G/W}, {T}, opfere den Elfischen Zauberjäger: Zerstöre eine Verzauberung deiner Wahl.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'„Im Schattenmoor findet man alle Arten von Flüchen, Krankheiten und Unglücksbringern. Wir verfolgen und vernichten sie, eine gefährliche Suche nach der anderen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174703&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'35244bc0-1502-4a19-b5a6-d4a11bf35276\', \'multiverseId\': 174703}, \'multiverseid\': 174703}, {\'name\': \'Cazamaleficios élfico\', \'text\': \'{G/W}, {T}, sacrificar el Cazamaleficios élfico: Destruye el encantamiento objetivo.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'"Todo tipo de maldiciones, ruinas y brujerías infectan el Páramo Sombrío. Los perseguimos, una arriesgada misión a la vez."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172897&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e0b5b222-6978-46fb-ae7b-83355834b233\', \'multiverseId\': 172897}, \'multiverseid\': 172897}, {\'name\': \'Chassesort elfe\', \'text\': "{G/W}, {T}, sacrifiez le Chassesort elfe : Détruisez l\'enchantement ciblé.", \'type\': \'Créature : elfe et shamane\', \'flavor\': \'« Sombrelande est infectée par toutes sortes de malédictions, de fléaux et malheurs. Nous les chassons, quête périlleuse après quête périlleuse. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173499&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'653c1129-d190-42b0-b9ec-a5111b1f74bd\', \'multiverseId\': 173499}, \'multiverseid\': 173499}, {\'name\': \'Elfo Cacciamaledizioni\', \'text\': "{G/W}, {T}, Sacrifica l\'Elfo Cacciamaledizioni: Distruggi un incantesimo bersaglio.", \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'"La Landa Tenebrosa è infestata da ogni genere di sciagura, avvizzimento e sfortuna. Noi li inseguiamo, una missione pericolosa alla volta."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173800&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8e752a7-26a3-4317-a6e5-a1e5b6417baa\', \'multiverseId\': 173800}, \'multiverseid\': 173800}, {\'name\': \'エルフの呪詛狩り\', \'text\': \'{G/W}, {T}, エルフの呪詛狩りを生け贄に捧げる：エンチャント１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'「シャドウムーアに蔓延したのは、あらゆる種類の呪いや荒廃や不運だった。 我々はその間を抜けながら、危険な任務を一つずつ片付けているのだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174101&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2e8e5141-fbd2-4995-a694-4c5b7a1d7c3b\', \'multiverseId\': 174101}, \'multiverseid\': 174101}, {\'name\': \'Caça-Feitiços Élfico\', \'text\': \'{G/W}, {T}, Sacrifique Caça-Feitiços Élfico: Destrua o encantamento alvo.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'"Todos os tipos de maldições, pragas e infortúnios infestam o Pântano Sombrio. Nós os perseguimos com uma missão perigosa por vez."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172295&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c613e972-5185-4667-a2fa-a20626316f76\', \'multiverseId\': 172295}, \'multiverseid\': 172295}, {\'name\': \'Эльф, Охотник на Сглазы\', \'text\': \'{G/W}, {T}, пожертвуйте Эльфа, Охотника на Сглазы: уничтожьте целевые чары.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'«Шэдоумур наводнен всевозможными проклятиями, напастями и дурными знаками. Мы выслеживаем их один за другим, подвергая себя страшной опасности».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172596&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0cf0b800-dec6-493d-a151-a277f7bddceb\', \'multiverseId\': 172596}, \'multiverseid\': 172596}, {\'name\': \'地精猎邪人\', \'text\': \'{G/W}，{T}，牺牲地精猎邪人：消灭目标结界。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'「暗影荒原传播着各种各样的诅咒，枯萎，以及坏运。 我们则逐一追踪这些祸害。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173198&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8b270d4c-9f81-4471-89ae-9478b6148a14\', \'multiverseId\': 173198}, \'multiverseid\': 173198}]', '[{\'name\': \'Entblößen\', \'text\': \'Zerstöre alle Auren und alle Ausrüstung, die an eine Kreatur deiner Wahl angelegt sind.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Alle Tarnzauber sind verflogen, alle Lügen aufgedeckt, alles Fleisch entblößt." —Awylla, elfische Sichermacherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174501&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18adb3d2-6933-4f1c-977e-8091c97677df\', \'multiverseId\': 174501}, \'multiverseid\': 174501}, {\'name\': \'Desnudar\', \'text\': \'Destruye todos los equipos y auras anexados a la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Sin ilusiones, sin mentiras, con la carne expuesta." —Awylla, refugiante élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172695&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae80b9b2-8cea-4371-9448-595207a98f36\', \'multiverseId\': 172695}, \'multiverseid\': 172695}, {\'name\': \'Mise à nu\', \'text\': \'Détruisez toutes les auras et tous les équipements attachés à la créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': \'« Toutes les illusions sont effacées, tous les mensonges, révélés, et la chair exposée. » —Awylla, protecturge elfe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173297&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'857a8f17-5775-48ca-896a-224bf547f2d4\', \'multiverseId\': 173297}, \'multiverseid\': 173297}, {\'name\': \'Spogliare\', \'text\': \'Distruggi tutte le Aure e gli Equipaggiamenti assegnati a una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ogni insidia evitata, ogni bugia svelata, tutta la carne esposta." —Awylla, salvaincanti elfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173598&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f81906a4-e383-4443-b091-378ea1b2ba04\', \'multiverseId\': 173598}, \'multiverseid\': 173598}, {\'name\': \'剥ぎ取り\', \'text\': \'クリーチャー１体を対象とし、それにつけられているすべてのオーラと装備品を破壊する。\', \'type\': \'インスタント\', \'flavor\': \'「除かれよすべての魔術、暴かれよすべての嘘、晒されよすべての身体。」 ――エルフの守美者、アウィラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173899&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'201f38a0-d7b6-4480-9db6-c2bed078ec80\', \'multiverseId\': 173899}, \'multiverseid\': 173899}, {\'name\': \'Desnudar\', \'text\': \'Destrua todas as Auras e Equipamentos anexados à criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Todo o glamir retirado, todas as mentiras reveladas, toda a carne exposta." — Awylla, pulcro-protetora élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172093&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d8a8a7f8-e8d0-475d-ad88-888d3a6fd07f\', \'multiverseId\': 172093}, \'multiverseid\': 172093}, {\'name\': \'Обнажить Суть\', \'text\': \'Уничтожьте все Ауры и Снаряжения, прикрепленные к целевому существу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Все заговоры сняты, ложь разоблачена, сущность обнажена». — Авилла, эльфийская охранительница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172394&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'00f9ff30-e876-41b2-92da-0475db3cd879\', \'multiverseId\': 172394}, \'multiverseid\': 172394}, {\'name\': \'剥光\', \'text\': \'消灭所有结附或装备在目标生物上的灵气与武具。\', \'type\': \'瞬间\', \'flavor\': \'「幻法消散，谎言现形，原身显露。」 ～地精美境卫艾薇拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172996&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'33504c33-9b68-4b3e-a4a1-883bff130e73\', \'multiverseId\': 172996}, \'multiverseid\': 172996}]', '[{\'name\': \'Erinnerungsplünderung\', \'text\': \'Du kannst eine Spontanzauber- oder Hexereikarte deiner Wahl aus dem Friedhof eines Gegners spielen, ohne ihre Manakosten zu bezahlen.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Vergeltung ist das Echo der eigenen Verbrechen des Opfers." —Grensch, Merrow-Meuchler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174646&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4cf2d413-4b6c-423b-97c7-545952511d46\', \'multiverseId\': 174646}, \'multiverseid\': 174646}, {\'name\': \'Saquear la memoria\', \'text\': \'Puedes jugar la carta de instantáneo o de conjuro objetivo del cementerio de un oponente sin pagar su coste de maná.\', \'type\': \'Instantáneo\', \'flavor\': \'"La venganza es el eco del crimen de la misma víctima." —Grensch, degollador merrow\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172840&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b69c459-0aec-4b40-a24e-1446c32b12b4\', \'multiverseId\': 172840}, \'multiverseid\': 172840}, {\'name\': \'Saccagement de mémoire\', \'text\': "Vous pouvez jouer la carte d\'éphémère ou de rituel ciblée dans le cimetière d\'un adversaire sans payer son coût de mana.", \'type\': \'Éphémère\', \'flavor\': "« La vengeance est l\'écho du propre crime de la victime. » —Grensch, surineur suire", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173442&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'efcf3a8d-8e05-4ed6-8da2-13fb91c6c9b8\', \'multiverseId\': 173442}, \'multiverseid\': 173442}, {\'name\': \'Furto di Memoria\', \'text\': \'Puoi giocare una carta istantaneo o stregoneria bersaglio dal cimitero di un avversario senza pagare il suo costo di mana.\', \'type\': \'Istantaneo\', \'flavor\': \'"La vendetta non è che un\\\'eco del crimine della stessa vittima." —Grensch, tagliagole merrow\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173743&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b89d8b9e-5835-49ec-a262-563f1cc84292\', \'multiverseId\': 173743}, \'multiverseid\': 173743}, {\'name\': \'記憶の略取\', \'text\': \'いずれかの対戦相手の墓地にある、インスタント・カード１枚かソーサリー・カード１枚を対象とする。あなたはそれを、それのマナ・コストを支払うことなくプレイしてもよい。\', \'type\': \'インスタント\', \'flavor\': \'「復讐ってのは犠牲者の罪の照り返しさ。」 ――メロウの殺し屋、グレンシュ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174044&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8fb3a4ce-71f4-4dde-a7b2-9791050f95c3\', \'multiverseId\': 174044}, \'multiverseid\': 174044}, {\'name\': \'Saquear Memória\', \'text\': \'Você pode jogar o card de mágica instantânea ou feitiço alvo no cemitério de um oponente sem pagar seu custo de mana.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"A vingança é o eco do crime da própria vítima." — Grensch, degolador sirenídeo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172238&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15b2466b-c1ad-4cab-ac3f-57de85588e7a\', \'multiverseId\': 172238}, \'multiverseid\': 172238}, {\'name\': \'Хищение Памяти\', \'text\': \'Вы можете разыграть находящуюся на кладбище оппонента целевую карту мгновенного заклинания или волшебства без уплаты ее мана-стоимости.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Месть это лишь эхо преступления самой жертвы». — Гренч, мерроу-головорез\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172539&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2559ac3d-217a-4e1a-b21e-dcb17d572b90\', \'multiverseId\': 172539}, \'multiverseid\': 172539}, {\'name\': \'记忆劫夺\', \'text\': \'你可以使用在对手坟墓场中的目标瞬间或法术牌，且不需支付其法术力费用。\', \'type\': \'瞬间\', \'flavor\': \'「复仇是受害者自身罪恶的回响。」 ～美洛割喉手格兰许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173141&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'34223225-16b9-4238-bdcd-6163d409edc4\', \'multiverseId\': 173141}, \'multiverseid\': 173141}]', "[{'name': 'Erinnerungsschleuse', 'text': 'Ein Spieler deiner Wahl legt die obersten vier Karten seiner Bibliothek auf seinen Friedhof.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere den Zauberspruch; du kannst für die Kopie ein neues Ziel bestimmen.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174647&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a1f6decc-f3c5-47ab-86e7-7fefde73aebd', 'multiverseId': 174647}, 'multiverseid': 174647}, {'name': 'Anegar la memoria', 'text': 'El jugador objetivo pone las primeras cuatro cartas de su biblioteca en su cementerio.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo y puedes elegir un nuevo objetivo para la copia.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172841&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '64d0a8c7-beb4-4fdc-ba09-f4f5acc7fccc', 'multiverseId': 172841}, 'multiverseid': 172841}, {'name': 'Décantation de mémoire', 'text': 'Le joueur ciblé met les quatre cartes du dessus de sa bibliothèque dans son cimetière.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le et vous pouvez choisir une nouvelle cible pour la copie.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173443&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4fb28af3-64d8-437f-ba7f-309450eaf401', 'multiverseId': 173443}, 'multiverseid': 173443}, {'name': 'Lavare Memoria', 'text': 'Un giocatore bersaglio mette nel suo cimitero le prime quattro carte del suo grimorio.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia. Puoi scegliere un nuovo bersaglio per la copia.)', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173744&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '91bfa65b-09d3-44c3-8408-76d1fae0a5ea', 'multiverseId': 173744}, 'multiverseid': 173744}, {'name': '記憶の放流', 'text': 'プレイヤー１人を対象とする。そのプレイヤーは、自分のライブラリーの一番上から４枚のカードを自分の墓地に置く。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。あなたはそのコピーの新たな対象を選んでもよい。）', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174045&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1aa69007-0958-4f28-8f4b-7565096f4324', 'multiverseId': 174045}, 'multiverseid': 174045}, {'name': 'Barragem de Memória', 'text': 'O jogador alvo coloca os quatro primeiros cards de seu grimório em seu cemitério.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela e você poderá escolher um novo alvo para a cópia.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172239&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '50215f6d-cf31-4011-a8ca-003dec580330', 'multiverseId': 172239}, 'multiverseid': 172239}, {'name': 'Промывка Памяти', 'text': 'Целевой игрок кладет четыре верхние карты своей библиотеки на свое кладбище.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его, и вы можете выбрать новую цель для этой копии.)', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172540&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '39ae69fb-c32a-4685-9bf4-51ef04a56dab', 'multiverseId': 172540}, 'multiverseid': 172540}, {'name': '记忆奔流', 'text': '目标牌手将其牌库顶的四张牌置入其坟墓场。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语，且你可以为该复制品选择新的目标。）', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173142&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cf41a93c-a4d7-4d34-8527-d43ea061853b', 'multiverseId': 173142}, 'multiverseid': 173142}]", '[{\'name\': \'Erleuchteter Foliant\', \'text\': \'{1}, {T}, zeige zwei Karten aus deiner Hand offen vor, die eine Farbe gemeinsam haben: Ziehe eine Karte.\', \'type\': \'Artefakt\', \'flavor\': \'Die meisten dieser Bücher bleiben auf ewig geschlossen, weil jeder die Wahrheit fürchtet, die in das Diptychon eingeritzt sein könnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174731&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e1eca433-a77e-45dc-addd-ef37aeafb718\', \'multiverseId\': 174731}, \'multiverseid\': 174731}, {\'name\': \'Folio iluminado\', \'text\': \'{1}, {T}, mostrar dos cartas de tu mano que compartan un color: Roba una carta.\', \'type\': \'Artefacto\', \'flavor\': \'La mayoría de esas reliquias permanecen cerradas por miedo a qué terribles verdades podrían estar inscriptas dentro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172925&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0a563d69-e8f9-4736-b321-95d7e24a710b\', \'multiverseId\': 172925}, \'multiverseid\': 172925}, {\'name\': \'Feuillet illuminé\', \'text\': \'{1}, {T}, révélez deux cartes de votre main qui partagent une couleur : Piochez une carte.\', \'type\': \'Artefact\', \'flavor\': "La plupart de ces reliques restent fermées, de crainte que de mauvais présages soient sculptés à l\'intérieur du diptyque.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173527&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4ed07542-14fc-441e-8a7d-a4b701ba9d15\', \'multiverseId\': 173527}, \'multiverseid\': 173527}, {\'name\': \'Pagina Illuminata\', \'text\': \'{1}, {T}, Rivela due carte dalla tua mano che condividono un colore: Pesca una carta.\', \'type\': \'Artefatto\', \'flavor\': "Molte di queste reliquie rimangono sigillate, per paura di quali sinistre verità possano essere incise nel dittico all\'interno.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173828&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb154a2e-3677-4112-9454-15c4caa84d9e\', \'multiverseId\': 173828}, \'multiverseid\': 173828}, {\'name\': \'光る折り書\', \'text\': \'{1}, {T}, あなたの手札にある共通する色を持つカードを２枚公開する：カードを１枚引く。\', \'type\': \'アーティファクト\', \'flavor\': \'この手の遺物のほとんどは留め具で閉じられたままだ。その中に刻まれた不吉な真実を恐れているのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174129&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'43564bc7-4cd2-44c4-9e02-ac4f3f6ca6cf\', \'multiverseId\': 174129}, \'multiverseid\': 174129}, {\'name\': \'Fólio Iluminado\', \'text\': \'{1}, {T}, Revele dois cards da sua mão que compartilhem uma cor: Compre um card.\', \'type\': \'Artefato\', \'flavor\': \'A maioria dessas relíquias permanece fechada por medo das verdades nefastas que podem estar entalhadas no díptico interno.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172323&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b2c10b8e-9a17-4a48-9e44-2be82be4a971\', \'multiverseId\': 172323}, \'multiverseid\': 172323}, {\'name\': \'Иллюминированный Фолиант\', \'text\': \'{1}, {T}, покажите две карты из вашей руки с одинаковым цветом: возьмите карту.\', \'type\': \'Артефакт\', \'flavor\': \'Большинство подобных реликвий закрыты наглухо из страха перед страшной правдой, которая может быть выгравирована внутри.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172624&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'40878ceb-caf6-4382-92d5-8159f7515b2d\', \'multiverseId\': 172624}, \'multiverseid\': 172624}, {\'name\': \'明亮书页\', \'text\': \'{1}，{T}，从你手上展示两张具有共通颜色的牌：抓一张牌。\', \'type\': \'神器\', \'flavor\': \'这类遗物大多数都会紧紧阖上，以免某些残酷事实会刻印到页面里头。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173226&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a6393e6-f5e1-42d4-b7aa-86596070c388\', \'multiverseId\': 173226}, \'multiverseid\': 173226}]', '[{\'name\': \'Erstarrungsstaub\', \'text\': \'Aufblitzen\\nKreaturenverzauberung\\nDie verzauberte Kreatur erhält -3/-0.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Viele Leute sind heutzutage zu unruhig, um die Träume zu träumen, die wir brauchen. Wir müssen ihnen beibringen, wie sie wieder etwas mehr Ruhe finden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174654&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afdafd46-818b-4cdc-a337-81bed33bad9a\', \'multiverseId\': 174654}, \'multiverseid\': 174654}, {\'name\': \'Polvo de torpor\', \'text\': \'Destello.\\nEncantar criatura.\\nLa criatura encantada obtiene -3/-0.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Están muy agitados últimamente para soñar los sueños que necesitamos. Debemos enseñarles a detenerse y respirar profundo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172848&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ef9c0d98-65c1-4086-8ca2-01571a94d71d\', \'multiverseId\': 172848}, \'multiverseid\': 172848}, {\'name\': \'Poussière de torpeur\', \'text\': \'Flash\\nEnchanter : créature\\nLa créature enchantée gagne -3/-0.\', \'type\': \'Enchantement : aura\', \'flavor\': "« De nos jours, certains sont trop agités pour faire les rêves dont nous avons besoin. Nous devons leur apprendre à s\'arrêter et à souffler un peu. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173450&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'47a06b25-1bf4-475d-b619-348c10ba56a3\', \'multiverseId\': 173450}, \'multiverseid\': 173450}, {\'name\': \'Polvere Intorpidente\', \'text\': \'Lampo\\nIncanta creatura\\nLa creatura incantata prende -3/-0.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Certa gente di questi tempi è troppo turbata per sognare i sogni di cui abbiamo bisogno. Dobbiamo insegnare loro a fermarsi e riprendere fiato."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173751&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'35cd18aa-45fe-4749-9f17-d3639e7f8707\', \'multiverseId\': 173751}, \'multiverseid\': 173751}, {\'name\': \'遅鈍の塵\', \'text\': \'瞬速\\nエンチャント（クリーチャー）\\nエンチャントされているクリーチャーは－３/－０の修整を受ける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「最近は安らかに夢見ることができない人もいるせいで、必要な夢が足りないね。 そんなのやめて一休みしなって教えないと。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174052&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fdc67e34-c6d8-4836-b62e-14a494a38dbf\', \'multiverseId\': 174052}, \'multiverseid\': 174052}, {\'name\': \'Poeira Tórpida\', \'text\': \'Lampejo\\nEncantar criatura\\nA criatura encantada recebe -3/-0.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Algumas pessoas hoje em dia são inquietas demais para sonhar os sonhos de que precisamos. Precisamos ensiná-las a parar e retomar o fôlego."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172246&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dbd913df-4417-4808-b857-10581b735543\', \'multiverseId\': 172246}, \'multiverseid\': 172246}, {\'name\': \'Пыльца Оцепенения\', \'text\': \'Миг\\nЗачаровать существо\\nЗачарованное существо получает -3/-0.\', \'type\': \'Чары — Аура\', \'flavor\': \'«В наше время у чересчур беспокойных личностей не получается видеть нужные нам сны. Приходится учить их делать передышку».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172547&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'420e4782-e3fe-4de3-9a43-61a228b96a99\', \'multiverseId\': 172547}, \'multiverseid\': 172547}, {\'name\': \'迟钝粉尘\', \'text\': \'闪现\\n生物结界\\n受此结界的生物得-3/-0。\', \'type\': \'结界～灵气\', \'flavor\': \'「这阵子有些人过于勤奋，没法子梦到我们需要的眠梦。 得教他们该停下来喘口气才行。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173149&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a24e894c-c2f6-43a1-a09b-ba643a8cf241\', \'multiverseId\': 173149}, \'multiverseid\': 173149}]', '[{\'name\': \'Erstrahlende Mentorin\', \'text\': \'Weiße Kreaturen, die du kontrollierst, haben „{T}: Du erhältst 1 Lebenspunkt dazu".\', \'type\': \'Kreatur — Kithkin, Kleriker\', \'flavor\': \'Das Gedankengewebe gibt dem Begriff der Allgemeinbildung eine neue Bedeutung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174496&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'34e1d32a-1307-4071-956a-9be3e1c380f3\', \'multiverseId\': 174496}, \'multiverseid\': 174496}, {\'name\': \'Mentora resplandeciente\', \'text\': \'Las criaturas blancas que controlas tienen "{T}: Ganas 1 vida".\', \'type\': \'Criatura — Clérigo kithkin\', \'flavor\': \'La trama mental le da un nuevo sentido a la frase "sabiduría popular".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172690&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe110b8b-bdf9-496a-8f6e-5f4501590c39\', \'multiverseId\': 172690}, \'multiverseid\': 172690}, {\'name\': \'Mentor resplendissant\', \'text\': \'Les créatures blanches que vous contrôlez ont « {T} : Vous gagnez 1 point de vie. »\', \'type\': \'Créature : sangami et clerc\', \'flavor\': "La tramepensée donne un nouveau sens à l\'expression « connaissance générale ».", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173292&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'205ea967-7865-419e-ad2e-551031b25a60\', \'multiverseId\': 173292}, \'multiverseid\': 173292}, {\'name\': \'Mentore Risplendente\', \'text\': \'Le creature bianche che controlli hanno "{T}: Guadagni 1 punto vita."\', \'type\': \'Creatura — Chierico Kithkin\', \'flavor\': \'La trama dei pensieri dà un nuovo significato alle parole "conoscenza comune".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173593&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b15b5e19-d0ff-4e95-9a25-d470e4e1b2c5\', \'multiverseId\': 173593}, \'multiverseid\': 173593}, {\'name\': \'光り輝く導師\', \'text\': \'あなたがコントロールする白のクリーチャーは「{T}：あなたは１点のライフを得る。」を持つ。\', \'type\': \'クリーチャー — キスキン・クレリック\', \'flavor\': \'思考の糸のおかげで、「周知の事実」という言葉の意味は変わってしまった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173894&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6932219d-983e-43ac-a9c0-826ed5048e53\', \'multiverseId\': 173894}, \'multiverseid\': 173894}, {\'name\': \'Mentor Resplendente\', \'text\': \'As criaturas brancas que você controla têm "{T}: Você ganha 1 ponto de vida".\', \'type\': \'Criatura — Kithkin Clérigo\', \'flavor\': \'A trama-mental concede um novo significado à expressão "conhecimento comum".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172088&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f1e77047-89e9-4550-8cb4-ba97a0683012\', \'multiverseId\': 172088}, \'multiverseid\': 172088}, {\'name\': \'Блистательная Наставница\', \'text\': \'Белые существа под вашим контролем имеют способность «{T}: вы получаете 1 жизнь».\', \'type\': \'Существо — Кискен Священник\', \'flavor\': \'Узы сплетенных мыслей наделяют новым смыслом слово «общеизвестно».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172389&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dda0689d-d486-4183-b0fe-693539ea8b1c\', \'multiverseId\': 172389}, \'multiverseid\': 172389}, {\'name\': \'华辉明师\', \'text\': \'由你操控的白色生物具有「{T}：你获得1点生命。」\', \'type\': \'生物～洁英／僧侣\', \'flavor\': \'纺思让「常识」一词有了新意义。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172991&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6c9568b5-f3a4-434a-b2eb-38e4d3ed83cb\', \'multiverseId\': 172991}, \'multiverseid\': 172991}]', '[{\'name\': \'Ertränker-Novize\', \'text\': \'Immer wenn ein Spieler einen blauen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, legt ein Spieler deiner Wahl die obersten zwei Karten seiner Bibliothek in seinen Friedhof.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Nichts genießt ein Merrow mehr, als das zu ertränken, was er nicht haben kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174513&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f384f20-3245-44c0-8d07-be04cc8a26ce\', \'multiverseId\': 174513}, \'multiverseid\': 174513}, {\'name\': \'Iniciado ahogador\', \'text\': \'Siempre que un jugador juegue un hechizo azul, puedes pagar {1}. Si lo haces, el jugador objetivo pone las dos primeras cartas de su biblioteca en su cementerio.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'Nada satisface más a un merrow que ahogar lo que no puede tener.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172707&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4bad7e03-807f-4099-8f97-09e7a8d2b222\', \'multiverseId\': 172707}, \'multiverseid\': 172707}, {\'name\': \'Adepte noyeur\', \'text\': "À chaque fois qu\'un joueur joue un sort bleu, vous pouvez payer {1}. Si vous faites ainsi, le joueur ciblé met les deux cartes du dessus de sa bibliothèque dans son cimetière.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "Rien ne satisfait plus un suire que noyer ce qu\'il ne peut posséder.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173309&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9aae224-a048-4bbf-9c7a-6a68cbabea56\', \'multiverseId\': 173309}, \'multiverseid\': 173309}, {\'name\': \'Iniziato Affogatore\', \'text\': \'Ogniqualvolta un giocatore gioca una magia blu, puoi pagare {1}. Se lo fai, un giocatore bersaglio mette nel suo cimitero le prime due carte del suo grimorio.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'Niente soddisfa maggiormente un merrow che affogare ciò che non può avere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173610&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dfbd719f-9c1e-460f-b043-9793243cba53\', \'multiverseId\': 173610}, \'multiverseid\': 173610}, {\'name\': \'溺れさせる者の信徒\', \'text\': \'いずれかのプレイヤーが青の呪文をプレイするたび、プレイヤー１人を対象とする。あなたは{1}を支払ってもよい。 そうした場合、そのプレイヤーは、自分のライブラリーの一番上から２枚のカードを自分の墓地に置く。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'自分の手に入らないものを溺れさせることほど、メロウを満足させることはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173911&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5b33e041-09ca-4afa-92e4-1e7310bf9a30\', \'multiverseId\': 173911}, \'multiverseid\': 173911}, {\'name\': \'Iniciado Afogador\', \'text\': \'Toda vez que um jogador joga uma mágica azul, você pode pagar {1}. Se fizer isso, o jogador alvo colocará os dois cards do topo de seu próprio grimório em seu próprio cemitério.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'Nada dá mais satisfação a um sirenídeo do que afogar o que ele não pode ter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172105&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ea35e85-5834-411b-82b9-0a26842ff179\', \'multiverseId\': 172105}, \'multiverseid\': 172105}, {\'name\': \'Искусный Топитель\', \'text\': \'Каждый раз, когда игрок разыгрывает синее заклинание, вы можете заплатить {1}. Если вы это делаете, целевой игрок кладет две верхние карты своей библиотеки на свое кладбище.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Ничто не приносит мерроу большего удовлетворения, чем затопление того, что ему неподвластно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172406&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d0b9cb37-836f-40a4-8649-2c59f8eaf694\', \'multiverseId\': 172406}, \'multiverseid\': 172406}, {\'name\': \'沉密学徒\', \'text\': \'每当任一牌手使用蓝色咒语时，你可以支付{1}。 若你如此作，则目标牌手将其牌库顶的两张牌置入其坟墓场。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'美洛最大的乐趣，莫过于将自己不能拥有的东西沉到水底。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173008&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74986f2a-006f-49ac-adb3-1ef673b3df73\', \'multiverseId\': 173008}, \'multiverseid\': 173008}]', '[{\'name\': \'Erweiterte Auramagie\', \'text\': \'Andere Verzauberungen, die du kontrollierst, sind Verhüllt.\\nVerzauberte Kreaturen, die du kontrollierst, sind Verhüllt.\', \'type\': \'Verzauberung\', \'flavor\': \'Ein fein gewebter Schleier aus Tarnzaubern kann so robust wie Stahl sein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174484&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ed69a50d-56be-439e-92d6-8f14e9581204\', \'multiverseId\': 174484}, \'multiverseid\': 174484}, {\'name\': \'Auramancia superior\', \'text\': \'Los otros encantamientos que controlas tienen la habilidad de velo.\\nLas criaturas encantadas que controlas tienen la habilidad de velo.\', \'type\': \'Encantamiento\', \'flavor\': \'Un delicado velo de ilusiones puede ser tan fuerte como el hierro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172678&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'71678576-3fc0-4125-84c8-cbb88910665a\', \'multiverseId\': 172678}, \'multiverseid\': 172678}, {\'name\': \'Grande auramancie\', \'text\': \'Les autres enchantements que vous contrôlez ont le linceul.\\nLes créatures enchantées que vous contrôlez ont le linceul.\', \'type\': \'Enchantement\', \'flavor\': "Un voile délicat d\'illusion peut s\'avérer aussi résistant que le fer.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173280&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'131ce1e1-ffbe-4a6e-a646-9823994efe9c\', \'multiverseId\': 173280}, \'multiverseid\': 173280}, {\'name\': \'Auramanzia Potenziata\', \'text\': \'Gli altri incantesimi che controlli hanno velo.\\nLe creature incantate che controlli hanno velo.\', \'type\': \'Incantesimo\', \'flavor\': \'Un delicato velo di insidie può mostrarsi più resistente del ferro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173581&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'258ac90d-20e6-4f4a-8a89-e19054558633\', \'multiverseId\': 173581}, \'multiverseid\': 173581}, {\'name\': \'偉大なるオーラ術\', \'text\': \'あなたがコントロールする他のエンチャントは被覆を持つ。\\nあなたがコントロールしている、エンチャントされている各クリーチャーは被覆を持つ。\', \'type\': \'エンチャント\', \'flavor\': \'繊細な魔法の覆いが鉄より頑丈なこともある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173882&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85c1c128-0725-4b5f-9ce7-4eceb852417c\', \'multiverseId\': 173882}, \'multiverseid\': 173882}, {\'name\': \'Auromancia Superior\', \'text\': \'Os outros encantamentos que você controla têm manto.\\nAs criaturas encantadas que você controla têm manto.\', \'type\': \'Encantamento\', \'flavor\': \'Um delicado véu de glamir pode ser tão forte quanto o aço.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172076&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5bc8c7d-f031-4349-b0a3-261640a39f2e\', \'multiverseId\': 172076}, \'multiverseid\': 172076}, {\'name\': \'Высокая Ауромантия\', \'text\': \'Другие чары под вашим контролем имеют Пелену.\\nЗачарованные существа под вашим контролем имеют Пелену.\', \'type\': \'Чары\', \'flavor\': \'Легкая завеса из заговоров порой прочнее железа.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172377&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3e4e2e89-6001-4140-84da-9361cedf9c2f\', \'multiverseId\': 172377}, \'multiverseid\': 172377}, {\'name\': \'高等灵气术\', \'text\': \'由你操控的其他结界具有帷幕异能。\\n由你操控、且被结附的生物具有帷幕异能。\', \'type\': \'结界\', \'flavor\': \'精巧的幻法屏幔也可以坚硬如钢。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172979&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66aec7ae-5e12-4e99-aaeb-fbe47fd560e5\', \'multiverseId\': 172979}, \'multiverseid\': 172979}]', "[{'name': 'Ewige Qualen', 'text': 'Spieler können keine Lebenspunkte dazuerhalten.\\nSchaden kann nicht verhindert werden.\\nAller Schaden wird zugefügt, als ob seine Quelle Verdorren hätte. (Eine Quelle mit Verdorren fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)', 'type': 'Verzauberung', 'flavor': 'Als die Nacht endlich kam, hatte die ganze Welt Narben.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174663&type=card', 'language': 'German', 'identifiers': {'scryfallId': '98d2b641-c937-4d37-b39a-ab391cdf24f5', 'multiverseId': 174663}, 'multiverseid': 174663}, {'name': 'Tormento eterno', 'text': 'Los jugadores no pueden ganar vida.\\nEl daño no puede ser prevenido.\\nTodo el daño se hace como si su fuente tuviera la habilidad de debilitar. (Una fuente con la habilidad de debilitar hace daño a las criaturas en forma de contadores -1/-1.)', 'type': 'Encantamiento', 'flavor': 'Cuando cayó la noche, el mismo plano fue herido.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172857&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1d8a6e40-c196-44da-bfaf-8d2ca674f65d', 'multiverseId': 172857}, 'multiverseid': 172857}, {'name': 'Tourment sempiternel', 'text': 'Les joueurs ne peuvent pas gagner de points de vie.\\nLes blessures ne peuvent pas être prévenues.\\nToutes les blessures sont infligées comme si leur source avait la flétrissure. (Une source avec la flétrissure inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)', 'type': 'Enchantement', 'flavor': 'Quand la nuit tomba, le plan lui-même était marqué.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173459&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c2ead78d-2700-4022-96b9-a1ac23362f6f', 'multiverseId': 173459}, 'multiverseid': 173459}, {'name': 'Tormento Eterno', 'text': 'I giocatori non possono guadagnare punti vita.\\nIl danno non può essere prevenuto.\\nTutto il danno viene inflitto come se la sua fonte avesse avvizzire. (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)', 'type': 'Incantesimo', 'flavor': 'Quando cadde la notte, il piano stesso ne rimase segnato.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173760&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4ceb7bee-8778-447c-b177-c06b5becf503', 'multiverseId': 173760}, 'multiverseid': 173760}, {'name': '恒久の拷問', 'text': 'プレイヤーはライフを得られない。\\nダメージは軽減できない。\\nすべてのダメージは、その発生源が萎縮を持つかのように与えられる。 （萎縮を持つ発生源からクリーチャーへのダメージは－１/－１カウンターの形で与えられる。）', 'type': 'エンチャント', 'flavor': '夜の帷が降りるとき、この次元自身が傷を負う。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174061&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2a306173-8171-4ef0-9ecd-d4e6e8c2868b', 'multiverseId': 174061}, 'multiverseid': 174061}, {'name': 'Tormento Eterno', 'text': 'Os jogadores não podem ganhar pontos de vida.\\nO dano não pode ser prevenido.\\nTodo dano é causado como se sua fonte tivesse murchar. (Uma fonte com murchar causa dano a criaturas na forma de marcadores -1/-1.)', 'type': 'Encantamento', 'flavor': 'Quando caiu a noite, o próprio plano teve medo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172255&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '018c4a76-88c6-4628-bad3-4552762809a9', 'multiverseId': 172255}, 'multiverseid': 172255}, {'name': 'Вечные Мучения', 'text': 'Игроки не могут получать жизнь.\\nПовреждения не могуть быть предотвращены.\\nВсе повреждения наносятся, как будто у их источника есть Увядание. (Источник со способностью Увядания наносит повреждения существам в виде жетонов -1/-1.)', 'type': 'Чары', 'flavor': 'Когда пришла ночь, сама земля покрылась рубцами.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172556&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9bbf403b-fc11-4766-90f1-12bcff33f21d', 'multiverseId': 172556}, 'multiverseid': 172556}, {'name': '无穷折磨', 'text': '牌手不能获得生命。\\n伤害不能被防止。\\n造成所有伤害时，其来源都视同具有干枯异能。 （具有干枯异能的来源会以-1/-1指示物的方式对生物造成伤害。）', 'type': '结界', 'flavor': '当夜晚降临，时空已遍布伤疤。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173158&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '093563db-fa6b-4303-afde-f0fbe9e7495c', 'multiverseId': 173158}, 'multiverseid': 173158}]", '[{\'name\': \'Falle des Inquisitors\', \'text\': \'Verhindere allen Schaden, den eine angreifende oder blockende Kreatur deiner Wahl in diesem Zug zufügen würde. Falls diese Kreatur schwarz oder rot ist, zerstöre sie.\', \'type\': \'Spontanzauber\', \'flavor\': \'Viele Kithkin sind so paranoid, dass sie ihren Gegnern all die Schmerzen zufügen, die sie ihrer Meinung nach von diesen zugefügt bekommen hätten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174485&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1f486253-7e6d-4ee1-aace-9eb17bbd4392\', \'multiverseId\': 174485}, \'multiverseid\': 174485}, {\'name\': \'Trampa del inquisidor\', \'text\': \'Prevén todo el daño que fuera a hacer la criatura atacante o bloqueadora objetivo este turno. Si esa criatura es negra o roja, destrúyela.\', \'type\': \'Instantáneo\', \'flavor\': \'Empujados por su paranoia, los kithkin infligen a sus enemigos todos los sufrimientos que creen que podrían haberle ocasionado a ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172679&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'88b62a1f-5b3a-48f8-9570-c00139c94e5d\', \'multiverseId\': 172679}, \'multiverseid\': 172679}, {\'name\': "Collet de l\'inquisiteur", \'text\': \'Prévenez toutes les blessures que la créature attaquante ou bloqueuse ciblée devrait infliger ce tour-ci. Si cette créature est noire ou rouge, détruisez-la.\', \'type\': \'Éphémère\', \'flavor\': "Contrôlés par leur paranoïa, les sangamis infligent à leurs ennemis toutes les souffrances qu\'ils penseraient subir.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173281&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e3e9f1a3-e6b1-4852-83f3-cf1d793777c8\', \'multiverseId\': 173281}, \'multiverseid\': 173281}, {\'name\': "Trappola dell\'Inquisitore", \'text\': \'Previeni tutto il danno che una creatura attaccante o bloccante bersaglio infliggerebbe in questo turno. Se quella creatura è nera o rossa, distruggila.\', \'type\': \'Istantaneo\', \'flavor\': \'Spinti dalla propria paranoia, i kithkin infliggono agli avversari ogni agonia che credono possa essere loro inflitta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173582&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'59d1c218-0f13-4880-a390-0e9ab173a2f7\', \'multiverseId\': 173582}, \'multiverseid\': 173582}, {\'name\': \'審問官の罠\', \'text\': \'攻撃かブロックしているクリーチャー１体を対象とする。このターン、それが与えるすべてのダメージを軽減し、０にする。 そのクリーチャーが赤か黒である場合、それを破壊する。\', \'type\': \'インスタント\', \'flavor\': \'偏執に導かれるまま、キスキンは自分たちに向けられたと信じている苦悶をすべて相手に叩きつける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173883&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b435feaa-950a-48be-b652-24657347518c\', \'multiverseId\': 173883}, \'multiverseid\': 173883}, {\'name\': \'Armadilha do Inquisidor\', \'text\': \'Previna todo o dano que a criatura atacante ou bloqueadora alvo causaria neste turno. Se essa criatura for preta ou vermelha, destrua-a.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Motivados pela sua paranóia, os kithkin infligem aos seus inimigos todos os sofrimentos que acreditam que seriam infligidos a eles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172077&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'558ff009-51d0-4140-aa48-a2bf2ebc3a99\', \'multiverseId\': 172077}, \'multiverseid\': 172077}, {\'name\': \'Сети Инквизитора\', \'text\': \'Предотвратите все повреждения, которые нанесет в этом ходу целевое атакующее или блокирующее существо. Если то существо черное или красное, уничтожьте его.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Обуреваемые паническим страхом, кискены насылают на своих врагов все те страдания, которых боятся сами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172378&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eadc1060-b281-41b2-b5f9-bf58bc8eaa3c\', \'multiverseId\': 172378}, \'multiverseid\': 172378}, {\'name\': \'审判官罗网\', \'text\': \'于本回合中，防止目标进行攻击或阻挡的生物将造成的所有伤害。 若该生物是红色或黑色，则将它消灭。\', \'type\': \'瞬间\', \'flavor\': \'由于洁英的妄想，他们会把自己所认定被敌人所引致的苦痛悉数回敬。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172980&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'776add50-1095-4e7e-abf6-227a507de892\', \'multiverseId\': 172980}, \'multiverseid\': 172980}]', '[{\'name\': \'Feenschwarm\', \'text\': \'Fliegend\\nStärke und Widerstandskraft des Feenschwarms sind gleich der Anzahl der blauen bleibenden Karten, die du kontrollierst.\', \'type\': \'Kreatur — Feenwesen\', \'flavor\': \'Oonas Feen wurden als Einzige nicht von der Aurora betroffen und begrüßten die Nacht wie immer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174514&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8563e07b-5ee9-40cb-bceb-3dd29a63fa44\', \'multiverseId\': 174514}, \'multiverseid\': 174514}, {\'name\': \'Enjambre de hadas\', \'text\': \'Vuela.\\nTanto la fuerza como la resistencia del Enjambre de hadas son iguales a la cantidad de permanentes azules que controlas.\', \'type\': \'Criatura — Hada\', \'flavor\': \'Intactas por la Aurora Celeste, las hadas de Oona recibieron la noche como cualquier otro día.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172708&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bc69c36e-9a98-494a-806c-c2459c7bdca7\', \'multiverseId\': 172708}, \'multiverseid\': 172708}, {\'name\': \'Essaim de faeries\', \'text\': "Vol\\nLa force et l\'endurance de l\'Essaim de faeries sont chacune égale au nombre de permanents bleus que vous contrôlez.", \'type\': \'Créature : peuple fée\', \'flavor\': "Épargnées par l\'Aurore, les faeries d\'Oona accueillirent la nuit comme tout autre jour.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173310&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6cf8540f-b177-487b-954c-e75d16f6c339\', \'multiverseId\': 173310}, \'multiverseid\': 173310}, {\'name\': \'Sciame di Spiritelle\', \'text\': \'Volare\\nLa forza e la costituzione dello Sciame di Spiritelle sono pari al numero di permanenti blu che controlli.\', \'type\': \'Creatura — Spiritello\', \'flavor\': \'Intoccati dalla Luminaria, gli spiritelli di Oona salutarono la notte come ogni altra giornata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173611&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'36a2fdf5-f4bc-4d51-a162-37a9bd1ea08b\', \'multiverseId\': 173611}, \'multiverseid\': 173611}, {\'name\': \'群がるフェアリー\', \'text\': \'飛行\\n群がるフェアリーのパワーとタフネスは、それぞれあなたがコントロールする青のパーマネントの総数に等しい。\', \'type\': \'クリーチャー — フェアリー\', \'flavor\': \'オーロラの手の届かないところで、ウーナの妖精たちはその夜を昼と同じぐらい歓迎している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173912&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1179cc89-81cc-4b98-b663-b4bb883d0cca\', \'multiverseId\': 173912}, \'multiverseid\': 173912}, {\'name\': \'Enxame de Fadas\', \'text\': \'Voar\\nO poder e a resistência de Enxame de Fadas são ambos iguais ao número de permanentes azuis que você controla.\', \'type\': \'Criatura — Fada\', \'flavor\': \'Intocadas pela Aurora, as fadas de Oona saudaram a noite como qualquer outro dia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172106&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5d0e2292-0167-487c-8f9f-588f64f1f680\', \'multiverseId\': 172106}, \'multiverseid\': 172106}, {\'name\': \'Рой Фей\', \'text\': \'Полет\\nСила и выносливость Роя Фей равны количеству синих перманентов под вашим контролем.\', \'type\': \'Существо — Фея\', \'flavor\': \'Нетронутые Авророй, феи Уны обрадовались опустившейся на мир ночи, как любому другому дню.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172407&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ab6fb5c0-6ad0-458a-a992-91935f807493\', \'multiverseId\': 172407}, \'multiverseid\': 172407}, {\'name\': \'仙灵大群\', \'text\': \'飞行\\n仙灵大群的力量与防御力各等同于由你操控的蓝色永久物之数量。\', \'type\': \'生物～仙灵\', \'flavor\': \'欧娜的仙灵丝毫不受极光影响，每天如常地迎接夜色降临。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173009&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c61d2dc4-ba1d-40e2-91c1-81f02facce3a\', \'multiverseId\': 173009}, \'multiverseid\': 173009}]', '[{\'name\': \'Feuerbrandstürmer\', \'text\': \'Eile\\n{R}: Der Feuerbrandstürmer erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen, Krieger\', \'flavor\': \'Seine Klinge wurde über brennenden Baumhirten geschmiedet, im besten Winkel zum Kopfabschlagen gekrümmt und durch seine Berührung in vulkanischen Temperaturen gehärtet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174580&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2eb242ad-1eb6-46ad-9dac-60b5a08b4c4a\', \'multiverseId\': 174580}, \'multiverseid\': 174580}, {\'name\': \'Cargador de la pira\', \'text\': \'Prisa.\\n{R}: El Cargador de la pira obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Guerrero elemental\', \'flavor\': \'Su hoja fue forjada sobre los carbones de un arbóreo, curvada en un ángulo óptimo para cortar cabezas y llevada a temperaturas volcánicas con su contacto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172774&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ba822ba9-e3da-4a23-8173-c6597320b955\', \'multiverseId\': 172774}, \'multiverseid\': 172774}, {\'name\': \'Batailleur du bûcher\', \'text\': "Célérité\\n{R} : Le Batailleur du bûcher gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : élémental et guerrier\', \'flavor\': "Sa lame a été forgée sur les braises de sylvins gémissants, recourbée jusqu\'à l\'angle optimal de décapitation, et chauffée à des températures volcaniques par son simple contact.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173376&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05e0279a-33a4-4df9-a114-4b7e50b2a629\', \'multiverseId\': 173376}, \'multiverseid\': 173376}, {\'name\': \'Incendiapire\', \'text\': "Rapidità\\n{R}: L\'Incendiapire prende +1/+0 fino alla fine del turno.", \'type\': \'Creatura — Guerriero Elementale\', \'flavor\': \'La sua lama è stata forgiata dal carbone di silvantropi gementi, curvata alla giusta angolazione per recidere le teste e riscaldata fino alle temperature vulcaniche dal suo tocco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173677&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a331448-29ca-40d4-b69b-cb3f1da59719\', \'multiverseId\': 173677}, \'multiverseid\': 173677}, {\'name\': \'火の突撃者\', \'text\': \'速攻\\n{R}：火の突撃者はターン終了時まで＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — エレメンタル・戦士\', \'flavor\': \'彼の刃は、うめく樹人の炭で鍛えられ、いくつもの頭を切り落とす理想的な角度に曲げられ、自身が触れることで火山の熱を帯びる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173978&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6628a3fe-2b59-45e5-8b02-5b8b7ac75774\', \'multiverseId\': 173978}, \'multiverseid\': 173978}, {\'name\': \'Atacante Pírico\', \'text\': \'Ímpeto\\n{R}: Atacante Pírico recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Elemental Guerreiro\', \'flavor\': \'Sua espada fora forjada com o carvão de um Ent lamuriante, arqueada na angulação ideal para decepar cabeças e aquecida a temperaturas vulcânicas pelo seu toque.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172172&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1cf2c0e5-55be-4de6-8257-fb90bfe35b10\', \'multiverseId\': 172172}, \'multiverseid\': 172172}, {\'name\': \'Огненный Рубака\', \'text\': \'Ускорение\\n{R}: Огненный Рубака получает +1/+0 до конца хода.\', \'type\': \'Существо — Элементаль Воин\', \'flavor\': \'Его клинок был выкован над углями стонущего лесовика, идеально загнут для отрубания голов и нагрет до температуры раскаленной лавы его прикосновением.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172473&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'690b1742-09f7-494d-85b1-d4168a874f55\', \'multiverseId\': 172473}, \'multiverseid\': 172473}, {\'name\': \'葬火冲锋者\', \'text\': \'敏捷\\n{R}：葬火冲锋者得+1/+0直到回合结束。\', \'type\': \'生物～元素／战士\', \'flavor\': \'其刀锋是以哀嚎树妖所制的煤炭加热铸造，弯曲至最大限度好割下头颅，并在他的碰触之下提升至火山般的高热。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173075&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'88b15959-8d18-4aeb-9b3e-f1486bef594d\', \'multiverseId\': 173075}, \'multiverseid\': 173075}]', "[{'name': 'Feuerfontäne', 'text': 'Die Feuerfontäne fügt allen nichtfliegenden Kreaturen 3 Schadenspunkte zu, falls {R} ausgegeben wurde, um die Feuerfontäne zu spielen, und allen fliegenden Kreaturen 3 Schadenspunkte zu, falls {G} ausgegeben wurde, um sie zu spielen. (Mache beides, falls {R}{G} ausgegeben wurde.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174682&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a9186611-eda3-43a7-888d-86f6e5f8a9cb', 'multiverseId': 174682}, 'multiverseid': 174682}, {'name': 'Chorro de fuego', 'text': 'El Chorro de fuego hace 3 puntos de daño a cada criatura sin la habilidad de volar si se usó {R} para jugar el Chorro de fuego y 3 puntos de daño a cada criatura con la habilidad de volar si se usó {G} para jugarlo. (Haz ambos si se usó {R}{G}.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172876&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '51dc9031-3c63-4b11-9f20-43160b42fac4', 'multiverseId': 172876}, 'multiverseid': 172876}, {'name': 'Trombe de feu', 'text': 'La Trombe de feu inflige 3 blessures à chaque créature sans le vol si {R} a été dépensé pour jouer la Trombe de feu et 3 blessures à chaque créature avec le vol si {G} a été dépensé pour la jouer. (Faites les deux si {R}{G} a été dépensé.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173478&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4ab2d585-ab67-49a7-b816-14361e35b2b4', 'multiverseId': 173478}, 'multiverseid': 173478}, {'name': 'Colonna di Fuoco', 'text': 'La Colonna di Fuoco infligge 3 danni a ogni creatura senza volare se è stato speso {R} per giocare la Colonna di Fuoco e 3 danni a ogni creatura con volare se è stato speso {G}. (Compi entrambe le azioni se è stato speso {R}{G}.)', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173779&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '028ecbca-5237-4837-a49d-f8453b8f9f0f', 'multiverseId': 173779}, 'multiverseid': 173779}, {'name': '炎渦竜巻', 'text': '炎渦竜巻をプレイするために{R}が支払われている場合、炎渦竜巻は飛行を持たない各クリーチャーにそれぞれ３点のダメージを与え、炎渦竜巻をプレイするために{G}が支払われている場合、炎渦竜巻は飛行を持つ各クリーチャーにそれぞれ３点のダメージを与える。 （{R}{G}が支払われている場合、両方を行う。）', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174080&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9e5fc960-a9a8-4582-a897-99fed60eb861', 'multiverseId': 174080}, 'multiverseid': 174080}, {'name': 'Esguicho de Fogo', 'text': 'Esguicho de Fogo causa 3 pontos de dano a cada criatura sem voar se {R} foi gasto para jogá-lo e 3 pontos de dano a cada criatura com voar se {G} foi gasto para jogá-lo. (Faça ambas as coisas se {R}{G} foi gasto.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172274&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b8dc98a0-d4a9-43c7-8292-cebc9564afdb', 'multiverseId': 172274}, 'multiverseid': 172274}, {'name': 'Огненный Смерч', 'text': 'Огненный Смерч наносит 3 повреждения каждому существу без Полета, если на разыгрывание Огненного Смерча было потрачено {R}, и 3 повреждения каждому существу с Полетом, если на его разыгрывание было потрачено {G}. (Сделайте и то и другое, если было потрачено {R}{G}.)', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172575&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd2affd4f-0265-4294-834e-4b48f727ca0b', 'multiverseId': 172575}, 'multiverseid': 172575}, {'name': '火龙卷', 'text': '如果使用火龙卷时支付了{R}，则火龙卷对每个不具飞行异能的生物各造成3点伤害；如果使用它时支付了{G}，则它对每个具飞行异能的生物各造成3点伤害。 （如果支付了{R}{G}，则两者都作。）', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173177&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '503a9fe0-96e8-4dbd-a674-917c32a74272', 'multiverseId': 173177}, 'multiverseid': 173177}]", '[{\'name\': \'Feuerhelles Dickicht\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{R/G}, {T}: Erhöhe deinen Manavorrat um {R}{R}, {R}{G} oder {G}{G}.\', \'type\': \'Land\', \'flavor\': \'Jede Nacht ändert sich, wer in der Höhle wohnt, da Boggartbanden ausnahmsweise auch um etwas kämpfen, was sich nicht essen lässt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174748&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f1af37a-e323-4b6b-9798-5fa920064f47\', \'multiverseId\': 174748}, \'multiverseid\': 174748}, {\'name\': \'Maleza encendida\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{R/G}, {T}: Agrega {R}{R}, {R}{G}, o {G}{G} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Quién habita en la guarida cambia todas las noches, ya que las bandas boggart luchan por el control de un lugar que no quieren comer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172942&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2944f6a8-8c95-4bef-98f8-3ea90ec5467c\', \'multiverseId\': 172942}, \'multiverseid\': 172942}, {\'name\': \'Hallier éclairé par le feu\', \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{R/G}, {T} : Ajoutez {R}{R}, {R}{G} ou {G}{G} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "L\'occupation du repaire change d\'une nuit à l\'autre, les gangs de boggarts s\'affrontant pour contrôler un lieu qu\'ils ne veulent pas simplement manger.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173544&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5c00b24-eba6-4138-a68e-90da45b027fe\', \'multiverseId\': 173544}, \'multiverseid\': 173544}, {\'name\': \'Boschetto delle Fiamme\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{R/G}, {T}: Aggiungi {R}{R}, {R}{G}, o {G}{G} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "L\'occupazione della tana cambia da notte a notte, mentre le bande di boggart si sfidano per il controllo di una postazione che non si accontentano di mangiare.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173845&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ca009dd8-853b-47cc-a107-95f77696a731\', \'multiverseId\': 173845}, \'multiverseid\': 173845}, {\'name\': \'火の灯る茂み\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n, {T}：あなたのマナ・プールに{R}{R}か{R}{G}か{G}{G}を加える。\', \'type\': \'土地\', \'flavor\': \'住処の住人は、ボガートが食いたくならないような場所の取り合いで夜毎に変わる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174146&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'451a6743-5ae6-406d-a955-d4edbae420a3\', \'multiverseId\': 174146}, \'multiverseid\': 174146}, {\'name\': \'Bosque das Tochas\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{R/G}, {T}: Adicione {R}{R}, {R}{G} ou {G}{G} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Os ocupantes do covil mudam todas as noites conforme as gangues de papões lutam pelo controle de um lugar que não querem somente para comer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172340&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b37111ed-6277-45fa-888c-df5bc091f10b\', \'multiverseId\': 172340}, \'multiverseid\': 172340}, {\'name\': \'Заросли с Огоньком\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{R/G}, {T}: добавьте {R}{R}, {R}{G} или {G}{G} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Логово еженощно переходит из рук в руки, по мере того как банды боггартов борются за право владения местом, которое они не хотят просто съесть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172641&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'18acdbc4-c85c-487a-967c-493f37541aba\', \'multiverseId\': 172641}, \'multiverseid\': 172641}, {\'name\': \'火光杂木林\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{R/G}，{T}：加{R}{R}，{R}{G}，或{G}{G}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'波尬各帮争夺这不只能用来吃饱肚子的地方，因此洞穴的主人每晚都会换。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173243&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b35fd901-fd92-4fa3-9c75-f6f024546076\', \'multiverseId\': 173243}, \'multiverseid\': 173243}]', '[{\'name\': \'Flammenspeer\', \'text\': \'({2/R} kann mit zwei beliebigen Mana oder mit {R} bezahlt werden. Die umgewandelten Manakosten dieser Karte betragen 6.)\\nDer Flammenspeer fügt einer Kreatur oder einem Spieler deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Gyara Speerschmeißerin wäre für ihre tödliche Genauigkeit bekannt, wenn sie nicht so tödlich genau werfen könnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174569&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'31150c84-202a-481d-a138-5faca301440c\', \'multiverseId\': 174569}, \'multiverseid\': 174569}, {\'name\': \'Jabalina de llamas\', \'text\': \'({2/R} puede pagarse con dos maná cualesquiera o con {R}. El costo de maná convertido de esta carta es 6.)\\nLa Jabalina de llamas hace 4 puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Gyara Arrojalanzas podría haber ganado renombre por su puntería mortal, si no fuera por su puntería mortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172763&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a37b3a79-adf0-4718-bb9e-63213ba5970f\', \'multiverseId\': 172763}, \'multiverseid\': 172763}, {\'name\': \'Javelot de flammes\', \'text\': "({2/R} peut être payé au choix avec n\'importe quelle combinaison de deux manas ou avec {R}. Le coût converti de mana de cette carte est 6.)\\nLe Javelot de flammes inflige 4 blessures à une cible, créature ou joueur.", \'type\': \'Éphémère\', \'flavor\': "Gyara Hastelance aurait été célèbre pour sa précision au lancer si de surcroît elle n\'eût été dotée d\'une précision mortelle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173365&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea95ceeb-a363-4a40-868a-1d73caffd436\', \'multiverseId\': 173365}, \'multiverseid\': 173365}, {\'name\': \'Giavellotto Infuocato\', \'text\': \'({2/R} può essere pagato con due mana qualsiasi o con {R}. Il costo di mana convertito di questa carta è 6.)\\nIl Giavellotto Infuocato infligge 4 danni a una creatura o a un giocatore bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'Gyara Tiralancia sarebbe stata rinomata per la sua precisione mortale, se non fosse stato per la sua precisione mortale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173666&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ae738dc-e8dc-423d-8c29-27426c8539f8\', \'multiverseId\': 173666}, \'multiverseid\': 173666}, {\'name\': \'炎の投げ槍\', \'text\': \'（{2/R}は、任意の２マナか{R}で支払うことができる。 このカードの点数で見たマナ・コストは６である。）\\nクリーチャー１体かプレイヤー１人を対象とする。炎の投げ槍はそれに４点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'彼女にその恐るべき正確さが無かったなら、槍放りのギャラは恐るべき正確さで名をはせただろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173967&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bd1c1b9e-2dfe-4034-8684-2e50c2ce7169\', \'multiverseId\': 173967}, \'multiverseid\': 173967}, {\'name\': \'Azagaia Ardente\', \'text\': \'({2/R} pode ser pago com quaisquer dois manas ou com {R}. O custo de mana convertido desse card é 6.)\\nAzagaia Ardente causa 4 pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Gyara Atiralança teria sido conhecida pela sua precisão mortal, se não fosse pela sua precisão mortal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172161&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ea512e4-933e-4442-8bd8-aabddcf23e11\', \'multiverseId\': 172161}, \'multiverseid\': 172161}, {\'name\': \'Пламенное Копье\', \'text\': \'(За {2/R} можно заплатить две любые маны или {R}. Конвертированная мана-стоимость этой карты равна 6.)\\nПламенное Копье наносит 4 повреждения целевому существу или игроку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Убийственная точность Гиары Копьеметательницы могла бы сделать ее знаменитой, если бы оставались свидетели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172462&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'94f28c80-9e86-4761-9e8a-0221be3558f6\', \'multiverseId\': 172462}, \'multiverseid\': 172462}, {\'name\': \'火焰标枪\', \'text\': \'（能用任意两点法术力或是{R}来支付{2/R}。 此牌的总法术力费用为6。）\\n火焰标枪对目标生物或牌手造成4点伤害。\', \'type\': \'瞬间\', \'flavor\': \'掷枪手嘉拉总能精确命中，让她精确夺命的名号难以传扬开来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173064&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2a0378ed-2ca1-4a14-a088-849e53c890c1\', \'multiverseId\': 173064}, \'multiverseid\': 173064}]', '[{\'name\': \'Flaumschleier\', \'text\': \'Aufblitzen\\nFliegend, Verteidiger\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Er war riesig, wie eine Wand aus Flügeln, und ebenso leise. Damit hatten wir nicht gerechnet, dass uns der Blick auf die Kithkin-Festung versperrt werden könnte." —Grensch, Merrow-Meuchler\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174622&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f5729787-989c-44ec-a9a1-18ca6de0c9a6\', \'multiverseId\': 174622}, \'multiverseid\': 174622}, {\'name\': \'Velo de plumas\', \'text\': \'Destello.\\nVuela, defensor.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Era inmenso, una gran extensión de alas flotando silenciosas. Nos tomó desprevenidos y bloqueó nuestra visión de la fortaleza kithkin." —Grensch, degollador merrow\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172816&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db9601da-0c56-4685-a8a9-a4117948c1f2\', \'multiverseId\': 172816}, \'multiverseid\': 172816}, {\'name\': \'Plumevoile\', \'text\': \'Flash\\nVol, défenseur\', \'type\': \'Créature : élémental\', \'flavor\': "« C\'était une immense surface composée d\'ailes au battement silencieux. Elle nous surprit et bloqua notre vue de la forteresse sangamie. » —Grensch, surineur suire", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173418&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dd46ac73-3e04-4f63-81e5-7a88e4a83f4e\', \'multiverseId\': 173418}, \'multiverseid\': 173418}, {\'name\': \'Piumavelata\', \'text\': \'Lampo\\nVolare, difensore\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Era immensa, un enorme lenzuolo di ali galleggianti e altrettanto silenziosa. Ci colse di sorpresa oscurandoci la visuale della fortezza kithkin." —Grensch, tagliagole merrow\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173719&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5ed8e75c-4004-4b74-bb71-c4e93a301523\', \'multiverseId\': 173719}, \'multiverseid\': 173719}, {\'name\': \'羽毛覆い\', \'text\': \'瞬速\\n飛行、防衛\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「そいつは空にそびえる巨大な翼みたいで、同じぐらいに静かだった。 そいつは突然やってきたかと思ったら、キスキンの砦の視界を遮りやがったんだ。」 ――メロウの殺し屋、グレンシュ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174020&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'665ae96f-ac71-4b05-ba98-654976de6016\', \'multiverseId\': 174020}, \'multiverseid\': 174020}, {\'name\': \'Plumovéu\', \'text\': \'Lampejo\\nVoar, defensor\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Era enorme, uma grande barreira de asas esvoaçantes, e ainda assim silencioso. Pegou-nos desprevenidos e bloqueou nossa visão da fortaleza kithkin." — Grensch, degolador sirenídeo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172214&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1ca78c33-aea6-4666-aae0-b39b073ad1ed\', \'multiverseId\': 172214}, \'multiverseid\': 172214}, {\'name\': \'Крылопад\', \'text\': \'Миг\\nПолет, Защитник\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Это было необъятное полотно расправленных крыльев, величавое и бесшумное. Оно застало нас врасплох и заслонило собой вид кискенской крепости». — Гренч, мерроу-головорез\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172515&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'854b388a-8857-4f70-912a-883e3d6c6284\', \'multiverseId\': 172515}, \'multiverseid\': 172515}, {\'name\': \'羽帘灵\', \'text\': \'闪现\\n飞行，守军\', \'type\': \'生物～元素\', \'flavor\': \'「那是片极大极广的滑翔翅膀，完全无声。 它突然地出现，挡住我们望向洁英要塞的视线。」 ～美洛割喉手格兰许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173117&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e856b91c-2e93-4a7c-9f63-36d36faeb3f7\', \'multiverseId\': 173117}, \'multiverseid\': 173117}]', '[{\'name\': \'Fledderflatterer\', \'text\': \'Fliegend\\nAuf den Fledderflatterer können keine Marken gelegt werden.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'„Ich habe ihn aus Draht und Resten zusammengeschustert, doch irgendwie finde ich ihn perfekt, so wie er ist." —Braenna, Flickschmiedin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174741&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'489dd51d-d549-4d70-878c-7900432a5368\', \'multiverseId\': 174741}, \'multiverseid\': 174741}, {\'name\': \'Barrilete de harapos\', \'text\': \'Vuela.\\nEl Barrilete de harapos no puede tener contadores sobre él.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'"Lo armé a partir de chatarra y mimbre, y sin embargo lo encuentro prácticamente perfecto." —Braenna, artesana remendona\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172935&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6fb5e658-f1b5-4176-9a2a-5f080bcd3578\', \'multiverseId\': 172935}, \'multiverseid\': 172935}, {\'name\': \'Loque volante\', \'text\': \'Vol\\nLa Loque volante ne peut pas avoir de marqueur placé sur elle.\', \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "« Je l\'ai construit avec de l\'osier et des loques, mais je le trouve parfait sous toutes les coutures. » —Braenna, ravaudeuse", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173537&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6e2bbcd9-363f-4724-a8cc-2616d0b513a4\', \'multiverseId\': 173537}, \'multiverseid\': 173537}, {\'name\': \'Straccio Volante\', \'text\': \'Volare\\nLo Straccio Volante non può avere segnalini.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': \'"L\\\'ho messo insieme con vimini e stracci, eppure lo trovo assolutamente perfetto." —Braenna, rattoppatrice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173838&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'50e82f80-887f-4e49-bb51-a1c5231d5e57\', \'multiverseId\': 173838}, \'multiverseid\': 173838}, {\'name\': \'破れ翼トビ\', \'text\': \'飛行\\n破れ翼トビの上にはカウンターを配置できない。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'「枝と屑鉄をつなぎ合わせたんだけど、どうした加減か調整抜きで完璧に決まったんだ。」 ――纏め鍛治のブラエナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174139&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bce09495-1aac-4c11-87bc-bf899d757666\', \'multiverseId\': 174139}, \'multiverseid\': 174139}, {\'name\': \'Farrapo-Pipa\', \'text\': \'Voar\\nFarrapo-Pipa não pode ter marcadores.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'"Eu a preparei usando vime e sucata, mas de certo modo acho que ela é inalteravelmente perfeita." — Braenna, espantalheira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172333&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'874bb4bc-ddfb-48b4-a35f-3a2193995351\', \'multiverseId\': 172333}, \'multiverseid\': 172333}, {\'name\': \'Летучий Оборвашка\', \'text\': \'Полет\\nНа Летучего Оборвашку нельзя поместить жетоны.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'«Я смастерила его из прутьев и ветоши, и все равно мне почему-то кажется, что оно просто идеально». — Браенна, мастерица пугал\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172634&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ded01eb5-b1f1-441e-9688-c7c741be4f50\', \'multiverseId\': 172634}, \'multiverseid\': 172634}, {\'name\': \'破布鸢\', \'text\': \'飞行\\n破布鸢上不能放置指示物。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'「我只用柳条与废铁把它组起来，却不知为何觉得它完美得无可改造。」 ～工匠布列娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173236&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73b41909-4e57-4398-a022-e0a0c4bad652\', \'multiverseId\': 173236}, \'multiverseid\': 173236}]', '[{\'name\': \'Florierende Verteidigung\', \'text\': \'Immer wenn eine -1/-1-Marke auf eine Kreatur gelegt wird, kannst du einen 1/1 grünen (Elf, Krieger)-Kreaturenspielstein ins Spiel bringen.\', \'type\': \'Verzauberung\', \'flavor\': \'Viele Schrecken schlucken den Köder eines alleine herumstreifenden Elfen, nur um den Klingen der verborgen wartenden Retter zum Opfer zu fallen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174591&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b62aaf37-e917-4c29-88b6-b38ece58d6a1\', \'multiverseId\': 174591}, \'multiverseid\': 174591}, {\'name\': \'Defensas florecientes\', \'text\': \'Siempre que se coloque un contador -1/-1 sobre una criatura, puedes poner en juego una ficha de criatura Guerrero Elfo verde 1/1.\', \'type\': \'Encantamiento\', \'flavor\': \'Muchos horrores pican con la carnada de un elfo valiente que camina solo, para caer bajo las espadas de los rescatadores escondidos en las cercanías.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172785&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a0392b5-dd26-41d1-88ad-7e5717e0a909\', \'multiverseId\': 172785}, \'multiverseid\': 172785}, {\'name\': \'Défenses abondantes\', \'text\': "À chaque fois qu\'un marqueur -1/-1 est placé sur une créature, vous pouvez mettre en jeu un jeton de créature 1/1 verte Elfe et Guerrier.", \'type\': \'Enchantement\', \'flavor\': "Bon nombre d\'horreurs mordent à l\'appât quand ils voient des volontaires elfes solitaires, et succombent sous les coups des sauveteurs embusqués.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173387&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'36bb4549-4632-42e7-ad70-93bfcf2b9a1b\', \'multiverseId\': 173387}, \'multiverseid\': 173387}, {\'name\': \'Difese in Allerta\', \'text\': \'Ogniqualvolta viene messo un segnalino -1/-1 su una creatura, puoi mettere in gioco una pedina creatura Guerriero Elfo 1/1 verde.\', \'type\': \'Incantesimo\', \'flavor\': \'Molti orrori cadono nella trappola di coraggiosi volontari elfici che vagano solitari, per essere poi trafitti dalle lame dei salvatori che perlustrano i dintorni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173688&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a0e7ed9-5453-4588-a065-e919b9bfa63c\', \'multiverseId\': 173688}, \'multiverseid\': 173688}, {\'name\': \'栄華の防衛\', \'text\': \'いずれかのクリーチャーの上に－１/－１カウンターが配置されるたび、あなたは緑の１/１のエルフ・戦士・クリーチャー・トークンを１体場に出してもよい。\', \'type\': \'エンチャント\', \'flavor\': \'多くの悪霊が一人で出歩いている勇敢なエルフの志願兵に釣られるが、結局はその近くに潜んでいる仲間の刃に倒れてしまう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173989&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5a7f1922-5e37-4f13-8ad6-3f98bbb58a50\', \'multiverseId\': 173989}, \'multiverseid\': 173989}, {\'name\': \'Defesas Florescentes\', \'text\': \'Toda vez que um marcador -1/-1 for colocado numa criatura, você poderá colocar em jogo uma ficha de criatura verde 1/1 do tipo Elfo Guerreiro.\', \'type\': \'Encantamento\', \'flavor\': \'Muitos horrores mordem a isca dos bravos elfos voluntários que caminham solitários, e logo se deparam com as lâminas dos defensores que espreitam ao redor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172183&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'899219e8-0782-42d8-a537-8c357237167d\', \'multiverseId\': 172183}, \'multiverseid\': 172183}, {\'name\': \'Расцвет Обороны\', \'text\': \'Каждый раз, когда жетон -1/-1 помещается на существо, вы можете положить в игру одну фишку существа 1/1 зеленый Эльф Воин.\', \'type\': \'Чары\', \'flavor\': \'Спеша поживиться легкой добычей, ужасные твари нападают на отважных эльфийских добровольцев, передвигающихся в одиночку. Они и не подозревают, что примут смерть от клинков притаившихся поблизости спасателей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172484&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2691fa50-fd70-4bf2-ae23-edc0fbbbcb50\', \'multiverseId\': 172484}, \'multiverseid\': 172484}, {\'name\': \'茁壮防卫\', \'text\': \'每当在任一生物上放置一个-1/-1指示物时，你可以将一个1/1绿色的地精／战士衍生物放置进场。\', \'type\': \'结界\', \'flavor\': \'许多惊惧邪兽被勇敢的独行地精引上勾，成了一旁躲藏的援兵之刀下亡魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173086&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1b4aa961-a2bb-4386-92d0-defee836848b\', \'multiverseId\': 173086}, \'multiverseid\': 173086}]', '[{\'name\': \'Fluch der Ketten\', \'text\': \'Kreaturenverzauberung\\nTappe zu Beginn jedes Versorgungssegments die verzauberte Kreatur.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Die wirkliche Strafe für den Riesen war der kurze Moment, als er aufstehen konnte, bevor er wieder in die Knie gezerrt wurde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174616&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7b389b3-a42e-40f9-a444-ff5ae8c5e023\', \'multiverseId\': 174616}, \'multiverseid\': 174616}, {\'name\': \'Maldición de cadenas\', \'text\': \'Encantar criatura.\\nAl comienzo de cada mantenimiento, gira la criatura encantada.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'El verdadero castigo del gigante fue ese instante en que se le permitió pararse antes de volver a ponerlo de rodillas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172810&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b6ff2efd-80cf-4875-a622-ad83d1603453\', \'multiverseId\': 172810}, \'multiverseid\': 172810}, {\'name\': \'Malédiction des chaînes\', \'text\': \'Enchanter : créature\\nAu début de chaque entretien, engagez la créature enchantée.\', \'type\': \'Enchantement : aura\', \'flavor\': "La véritable punition du géant, c\'était cet instant où on le laissait se redresser avant d\'être à nouveau forcé à s\'agenouiller.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173412&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bb72ecdf-c736-45ea-9df6-1c7cda7a7d2e\', \'multiverseId\': 173412}, \'multiverseid\': 173412}, {\'name\': \'Maledizione delle Catene\', \'text\': "Incanta creatura\\nAll\'inizio di ogni mantenimento, TAPpa la creatura incantata.", \'type\': \'Incantesimo — Aura\', \'flavor\': "La vera punizione del gigante era l\'attimo fugace in cui gli veniva consentito di alzarsi prima di essere rimesso in ginocchio.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173713&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d2c832b2-e6de-406a-b0f7-4b156372c890\', \'multiverseId\': 173713}, \'multiverseid\': 173713}, {\'name\': \'鎖の呪い\', \'text\': \'エンチャント（クリーチャー）\\n各アップキープの開始時に、エンチャントされているクリーチャーをタップする。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'巨人にとっての真の罰とは、再び引きずり倒される前に、逃げるために立ち上がることを許される瞬間だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174014&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87b8bd5c-7fdf-460a-9872-8fd733840a5b\', \'multiverseId\': 174014}, \'multiverseid\': 174014}, {\'name\': \'Maldição de Correntes\', \'text\': \'Encantar criatura\\nNo início de cada manutenção, vire a criatura encantada.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'A verdadeira punição do gigante ocorreu no momento em que permitiram que ele se levantasse antes de ser forçado a ajoelhar-se novamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172208&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9371e8f6-0547-4ddf-b3be-67cf9af9d345\', \'multiverseId\': 172208}, \'multiverseid\': 172208}, {\'name\': \'Проклятие Цепей\', \'text\': \'Зачаровать существо\\nВ начале каждого шага поддержки поверните зачарованное существо.\', \'type\': \'Чары — Аура\', \'flavor\': \'Истинным наказанием для гиганта был тот короткий момент, когда ему разрешили встать, чтобы затем опять бросить вниз на колени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172509&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd494dfa-f2f7-4175-b841-278696d58585\', \'multiverseId\': 172509}, \'multiverseid\': 172509}, {\'name\': \'锁链诅咒\', \'text\': \'生物结界\\n在每个维持开始时，横置受此结界的生物。\', \'type\': \'结界～灵气\', \'flavor\': \'当巨人从站姿再度给强拉跪地前的那段短暂时光，才是对他真正的惩罚。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173111&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'657e8eca-218e-4e71-a567-492e8b487fcd\', \'multiverseId\': 173111}, \'multiverseid\': 173111}]', '[{\'name\': \'Fluchfänger\', \'text\': \'Opfere den Fluchfänger: Neutralisiere einen Spontanzauber oder eine Hexerei deiner Wahl, falls sein Beherrscher nicht {1} bezahlt.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Von allen Sachen, die einem genommen werden können, ist die Gelegenheit die wertvollste."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174511&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a3b5b454-b8c6-4564-84c6-21eb10dfd2fe\', \'multiverseId\': 174511}, \'multiverseid\': 174511}, {\'name\': \'Atrapamaldiciones\', \'text\': \'Sacrificar el Atrapamaldiciones: Contrarresta el hechizo objetivo de instantáneo o de conjuro a menos que su controlador pague {1}.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"De todo lo que puede ser robado, la oportunidad es lo más valioso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172705&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6411c065-62bc-4311-9f89-19aeb85c9dd9\', \'multiverseId\': 172705}, \'multiverseid\': 172705}, {\'name\': \'Attrapeur de malédictions\', \'text\': "Sacrifiez l\'Attrapeur de malédictions : Contrecarrez le sort d\'éphémère ou de rituel ciblé à moins que son contrôleur ne paie {1}.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "« Parmi tout ce qui est saisissable, l\'opportunité a le plus de valeur. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173307&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83eacb3b-1d5f-41cb-a5ca-3f6ec962d48f\', \'multiverseId\': 173307}, \'multiverseid\': 173307}, {\'name\': \'Catturamagie\', \'text\': \'Sacrifica il Catturamagie: Neutralizza una magia istantaneo o stregoneria bersaglio a meno che il suo controllore non paghi {1}.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Tra tutte le cose che possono essere rubate, l\\\'opportunità è la più preziosa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173608&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a5c948a5-d7d0-431c-a3ca-07ca0f8b268e\', \'multiverseId\': 173608}, \'multiverseid\': 173608}, {\'name\': \'呪い捕らえ\', \'text\': \'呪い捕らえを生け贄に捧げる：インスタント呪文１つかソーサリー呪文１つを対象とする。それのコントローラーが{1}を支払わないかぎり、それを打ち消す。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'「盗むことのできるあらゆる物の中で、機会が一番価値がある。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173909&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b37dbe0e-384d-481a-a6d6-508b5fa7bf9b\', \'multiverseId\': 173909}, \'multiverseid\': 173909}, {\'name\': \'Caça-Maldição\', \'text\': \'Sacrifique Caça-Maldição: Anule a mágica instantânea ou de feitiço alvo, a menos que seu controlador pague {1}.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"Dentre todas as coisas que podem ser roubadas, a oportunidade é a mais valiosa."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172103&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cba40279-75ac-4991-a41a-cb21a7b4afc4\', \'multiverseId\': 172103}, \'multiverseid\': 172103}, {\'name\': \'Ловец Проклятий\', \'text\': \'Пожертвуйте Ловца Проклятий: отмените целевое мгновенное заклинание или заклинание волшебства, если контролирующий его игрок не заплатит {1}.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Самое ценное, что только можно похитить, это возможность».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172404&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6d68b961-9a89-49a9-a8f0-1947d45e70ad\', \'multiverseId\': 172404}, \'multiverseid\': 172404}, {\'name\': \'捕咒师\', \'text\': \'牺牲捕咒师：除非目标瞬间或法术咒语的操控者支付{1}，否则反击之。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'「在会给偷走的东西里面，最宝贵的就是机会。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173006&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5b891baa-7b71-4910-b2e4-b9965a4a6cfc\', \'multiverseId\': 173006}, \'multiverseid\': 173006}]', '[{\'name\': \'Flusskelpie\', \'text\': \'Immer wenn der Flusskelpie oder eine andere bleibende Karte aus einem Friedhof ins Spiel gebracht wird, ziehe eine Karte.\\nImmer wenn ein Zauberspruch aus einem Friedhof gespielt wird, ziehe eine Karte.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Bestie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174526&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ae405500-8659-4e84-ad41-5752eba16fdf\', \'multiverseId\': 174526}, \'multiverseid\': 174526}, {\'name\': \'Kelpie del río\', \'text\': \'Siempre que el Kelpie del río u otro permanente sea puesto en juego desde el cementerio, roba una carta.\\nSiempre que un hechizo se juegue desde el cementerio, roba una carta.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172720&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1a4ca50e-22f4-4418-a0ed-0dc8dded9a91\', \'multiverseId\': 172720}, \'multiverseid\': 172720}, {\'name\': \'Kelpie des rivières\', \'text\': "À chaque fois que le Kelpie des rivières ou qu\'un autre permanent est mis en jeu depuis un cimetière, piochez une carte.\\nÀ chaque fois qu\'un sort est joué depuis un cimetière, piochez une carte.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : bête\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173322&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'60e2e2d8-fda6-4529-a853-d164d3abea89\', \'multiverseId\': 173322}, \'multiverseid\': 173322}, {\'name\': \'Kelpie Fluviale\', \'text\': \'Ogniqualvolta il Kelpie Fluviale o un altro permanente viene messo in gioco da un cimitero, pesca una carta.\\nOgniqualvolta una magia viene giocata da un cimitero, pesca una carta.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Bestia\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173623&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'97e3b32f-c336-4dc4-ba6f-1e874e509c35\', \'multiverseId\': 173623}, \'multiverseid\': 173623}, {\'name\': \'川のケルピー\', \'text\': \'川のケルピーか他のパーマネントがいずれかの墓地から場に置かれるたび、カードを１枚引く。\\nいずれかの呪文が墓地からプレイされるたび、カードを１枚引く。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — ビースト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173924&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7d9ed5dd-c93d-4579-8376-f982722a3259\', \'multiverseId\': 173924}, \'multiverseid\': 173924}, {\'name\': \'Kelpie do Rio\', \'text\': \'Toda vez que Kelpie do Rio ou outra permanente for colocada em jogo vinda de um cemitério, compre um card.\\nToda vez que uma mágica for jogada de um cemitério, compre um card.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Besta\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172118&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b06cd0e-322e-455e-8181-a4636028f2ae\', \'multiverseId\': 172118}, \'multiverseid\': 172118}, {\'name\': \'Речной Келпи\', \'text\': \'Каждый раз, когда Речной Келпи или другой перманент попадает из кладбища в игру, возьмите карту.\\nКаждый раз, когда заклинание разыгрывается из кладбища, возьмите карту.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Зверь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172419&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'49550c9c-951b-4b7e-983f-20b354bc0f23\', \'multiverseId\': 172419}, \'multiverseid\': 172419}, {\'name\': \'河流凯尔比\', \'text\': \'每当河流凯尔比或另一个永久物从场上置入坟墓场时，抓一张牌。\\n每当有咒语从坟墓场使用时，抓一张牌。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～野兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173021&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'92d7b54b-93e4-4092-8c70-9ef473ffb962\', \'multiverseId\': 173021}, \'multiverseid\': 173021}]', '[{\'name\': \'Flügelhüter-Vogelscheuche\', \'text\': \'Die Flügelhüter-Vogelscheuche hat Wachsamkeit, solange du eine weiße Kreatur kontrollierst.\\nDie Flügelhüter-Vogelscheuche hat Flugfähigkeit, solange du eine blaue Kreatur kontrollierst.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Die Flügel halten durch Drahtstäbe zusammen. Die Stäbe halten durch reines Vertrauen zusammen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174745&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c19307d7-8492-40fa-912f-03f2b5b77689\', \'multiverseId\': 174745}, \'multiverseid\': 174745}, {\'name\': \'Espantapájaros alas atentas\', \'text\': \'El Espantapájaros alas atentas tiene la habilidad de vigilancia mientras controles una criatura blanca.\\nEl Espantapájaros alas atentas tiene la habilidad de volar mientras controles una criatura azul.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'Las alas se mantienen en su lugar por varas de mimbre. Las varas se mantienen en su lugar por un acto de fe.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172939&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'70d4957a-4164-4618-87ef-1b49d3d2eb5f\', \'multiverseId\': 172939}, \'multiverseid\': 172939}, {\'name\': \'Épouvantail ailegarde\', \'text\': "L\'Épouvantail ailegarde a la vigilance tant que vous contrôlez une créature blanche.\\nL\'Épouvantail ailegarde a le vol tant que vous contrôlez une créature bleue.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': \'Les ailes sont maintenues en place par des baguettes en osier. Les baguettes sont maintenues en place par la foi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173541&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'651753be-90d8-4165-a4f1-8ad9fc09ca00\', \'multiverseId\': 173541}, \'multiverseid\': 173541}, {\'name\': \'Spaventapasseri Guardiapiuma\', \'text\': \'Lo Spaventapasseri Guardiapiuma ha cautela fintanto che controlli una creatura bianca.\\nLo Spaventapasseri Guardiapiuma ha volare fintanto che controlli una creatura blu.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': \'Le ali sono tenute assieme da rami di vimini. I rami sono tenuti assieme dalla fede incondizionata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173842&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f0c4f72-bf13-40e3-a478-4fc4c56b3e64\', \'multiverseId\': 173842}, \'multiverseid\': 173842}, {\'name\': \'見張り翼のカカシ\', \'text\': \'見張り翼のカカシは、あなたが白のクリーチャーをコントロールしているかぎり警戒を持つ。\\n見張り翼のカカシは、あなたが青のクリーチャーをコントロールしているかぎり飛行を持つ。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'翼は小枝の杖に支えられている。 杖は純粋な信仰に支えられている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174143&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'588bf599-10af-4b77-be51-1677c0fb9b5c\', \'multiverseId\': 174143}, \'multiverseid\': 174143}, {\'name\': \'Espantalho das Asas Vigilantes\', \'text\': \'Espantalho das Asas Vigilantes terá vigilância enquanto você controlar uma criatura branca.\\nEspantalho das Asas Vigilantes terá voar enquanto você controlar uma criatura azul.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'As asas são sustentadas por varas de vime. As varas são sustentadas por pura fé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172337&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f042bfaa-c2ad-4fab-8cd2-40966e4a87dc\', \'multiverseId\': 172337}, \'multiverseid\': 172337}, {\'name\': \'Пугало Воздушного Дозора\', \'text\': \'Пугало Воздушного Дозора имеет Бдительность, пока вы контролируете белое существо.\\nПугало Воздушного Дозора имеет Полет, пока вы контролируете синее существо.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Крылья держатся на прутьях. Прутья держатся на чистой вере.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172638&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c415b6a4-951f-4249-9458-91da6c4a316e\', \'multiverseId\': 172638}, \'multiverseid\': 172638}, {\'name\': \'守翼稻草人\', \'text\': \'只要你操控白色生物，守翼稻草人便具有警戒异能。\\n只要你操控蓝色生物，守翼稻草人便具有飞行异能。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'柳条杆稳固了翅翼； 真信念稳固了柳杆。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173240&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7ac72a3c-0a6b-4249-8cd5-8cc3376a3fce\', \'multiverseId\': 173240}, \'multiverseid\': 173240}]', '[{\'name\': \'Flügelrassel-Vogelscheuche\', \'text\': \'Die Flügelrassel-Vogelscheuche hat Flugfähigkeit, solange du eine blaue Kreatur kontrollierst.\\nDie Flügelrassel-Vogelscheuche hat Beharrlichkeit, solange du eine schwarze Kreatur kontrollierst. (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174747&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5a087c5-a302-4b65-889f-faf0f13b9d2a\', \'multiverseId\': 174747}, \'multiverseid\': 174747}, {\'name\': \'Espantapájaros alas traqueteantes\', \'text\': \'El Espantapájaros alas traqueteantes tiene la habilidad de volar mientras controles una criatura azul.\\nEl Espantapájaros alas traqueteantes tiene la habilidad de persistir mientras controles una criatura negra. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172941&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4c6f851-4b1e-4fb0-8d5d-927e01dac916\', \'multiverseId\': 172941}, \'multiverseid\': 172941}, {\'name\': \'Épouvantail à ailes cliquetantes\', \'text\': "L\'Épouvantail à ailes cliquetantes a le vol tant que vous contrôlez une créature bleue.\\nL\'Épouvantail à ailes cliquetantes a la persistance tant que vous contrôlez une créature noire. (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173543&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9cc0dd06-a866-4f20-bc23-8c3b43451ef1\', \'multiverseId\': 173543}, \'multiverseid\': 173543}, {\'name\': \'Spaventapasseri Scuotipiuma\', \'text\': \'Lo Spaventapasseri Scuotipiuma ha volare fintanto che controlli una creatura blu.\\nLo Spaventapasseri Scuotipiuma ha persistere fintanto che controlli una creatura nera. (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173844&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86e4e7bc-804e-4e98-8549-6f9664676562\', \'multiverseId\': 173844}, \'multiverseid\': 173844}, {\'name\': \'翼鳴らしのカカシ\', \'text\': \'翼鳴らしのカカシは、あなたが青のクリーチャーをコントロールしているかぎり飛行を持つ。\\n翼鳴らしのカカシは、あなたが黒のクリーチャーをコントロールしているかぎり頑強を持つ。 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174145&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71260277-946e-4b07-a247-b4fae32e1676\', \'multiverseId\': 174145}, \'multiverseid\': 174145}, {\'name\': \'Espantalho da Sucata Alada\', \'text\': \'Espantalho da Sucata Alada terá voar enquanto você controlar uma criatura azul.\\nEspantalho da Sucata Alada terá persistir enquanto você controlar uma criatura preta. (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172339&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b51fdd2c-c0ba-4c3f-a8b2-587cbe671175\', \'multiverseId\': 172339}, \'multiverseid\': 172339}, {\'name\': \'Гремучекрылое Пугало\', \'text\': \'Гремучекрылое Пугало имеет Полет, пока вы контролируете синее существо.\\nГремучекрылое Пугало имеет Упорство, пока вы контролируете черное существо. (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172640&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c5b389df-5906-4b06-9fdf-c366382d1f92\', \'multiverseId\': 172640}, \'multiverseid\': 172640}, {\'name\': \'翼颤稻草人\', \'text\': \'只要你操控蓝色生物，翼颤稻草人便具有飞行异能。\\n只要你操控黑色生物，翼颤稻草人便具有留存异能。 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'神器生物～稻草人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173242&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'19927802-8a21-4591-be6c-a242c070b31d\', \'multiverseId\': 173242}, \'multiverseid\': 173242}]', '[{\'name\': \'Folterung\', \'text\': \'Kreaturenverzauberung\\n{1}{B}: Lege eine -1/-1-Marke auf die verzauberte Kreatur.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Was die Lebenskraft aufbaut, zieht der Schmerz wieder herunter.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174557&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cca2f726-64b9-44f8-ac19-aa9afbf3f7e6\', \'multiverseId\': 174557}, \'multiverseid\': 174557}, {\'name\': \'Tortura\', \'text\': \'Encantar criatura.\\n{1}{B}: Pon un contador -1/-1 sobre la criatura encantada.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Lo que el vigor de la vida construye, la agonía lo vuelve a destruir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172751&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2cd3fe4d-eff5-4d46-9a28-91f8ae94739d\', \'multiverseId\': 172751}, \'multiverseid\': 172751}, {\'name\': \'Torture\', \'text\': \'Enchanter : créature\\n{1}{B} : Mettez un marqueur -1/-1 sur la créature enchantée.\', \'type\': \'Enchantement : aura\', \'flavor\': \'Ce que la vigueur de la vie construit, la souffrance détruit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173353&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b89803cb-93c5-4f50-821c-795664d25da1\', \'multiverseId\': 173353}, \'multiverseid\': 173353}, {\'name\': \'Tortura\', \'text\': \'Incanta creatura\\n{1}{B}: Metti un segnalino -1/-1 sulla creatura incantata.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Ciò che il vigore della vita costruisce, l\'agonia lo demolisce.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173654&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5e56e0eb-5687-45e7-9f82-3a7812d2e334\', \'multiverseId\': 173654}, \'multiverseid\': 173654}, {\'name\': \'拷問\', \'text\': \'エンチャント（クリーチャー）\\n{1}{B}：エンチャントされているクリーチャーの上に－１/－１カウンターを１個置く。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'活力が築き上げた物は、苦悶が再び引き裂き倒す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173955&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3b5a561a-7a1b-4238-8bca-763018fe6702\', \'multiverseId\': 173955}, \'multiverseid\': 173955}, {\'name\': \'Tortura\', \'text\': \'Encantar criatura\\n{1}{B}: Coloque um marcador -1/-1 na criatura encantada.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'O que o vigor da vida constrói, a agonia destrói novamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172149&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e158e1dd-5a3b-4b12-a991-e0b46c9025b5\', \'multiverseId\': 172149}, \'multiverseid\': 172149}, {\'name\': \'Пытка\', \'text\': \'Зачаровать существо\\n{1}{B}: положите один жетон -1/-1 на зачарованное существо.\', \'type\': \'Чары — Аура\', \'flavor\': \'То, что создается с помощью жизненной силы, снова разрушается мукой и страданиями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172450&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e23d84d9-1860-49cd-b6c8-23bea3859ca6\', \'multiverseId\': 172450}, \'multiverseid\': 172450}, {\'name\': \'折磨\', \'text\': \'生物结界\\n{1}{B}：在受此结界的生物上放置一个-1/-1指示物。\', \'type\': \'结界～灵气\', \'flavor\': \'生命活力所成就的，会被苦痛再度毁灭。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173052&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bc88066c-ec86-46d5-b66c-2447abaeb12e\', \'multiverseId\': 173052}, \'multiverseid\': 173052}]', '[{\'name\': \'Fossilienfund\', \'text\': \'Bringe eine zufällig bestimmte Karte aus deinem Friedhof auf deine Hand zurück und sortiere dann deinen Friedhof, wie du willst.\', \'type\': \'Hexerei\', \'flavor\': \'„Manche Geheimnisse wollen einfach aufgedeckt werden. Sie bohren sich einfach aus eigenem Antrieb an die Oberfläche durch." —Dindun aus der Kulrathmine\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174683&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'24448652-dc0a-4f73-bf54-fec397f15da2\', \'multiverseId\': 174683}, \'multiverseid\': 174683}, {\'name\': \'Encontrar un fósil\', \'text\': \'Regresa a tu mano una carta al azar de tu cementerio, luego reordena tu cementerio como quieras.\', \'type\': \'Conjuro\', \'flavor\': \'"Algunos secretos quieren ser revelados. Brotan del suelo por voluntad propia." —Dindun de la mina de Kulrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172877&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bba53d47-1c54-449d-8202-6eae803d6c02\', \'multiverseId\': 172877}, \'multiverseid\': 172877}, {\'name\': \'Découverte fossile\', \'text\': \'Renvoyez une carte au hasard de votre cimetière dans votre main, puis réorganisez votre cimetière comme vous le désirez.\', \'type\': \'Rituel\', \'flavor\': \'« Certains secrets veulent être révélés. Ils jaillissent du sol par eux-mêmes. » —Dindun de la mine de Kulrajh\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173479&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'153cd83b-a061-462d-8c14-3bf428b19645\', \'multiverseId\': 173479}, \'multiverseid\': 173479}, {\'name\': \'Ritrovamento di Fossili\', \'text\': \'Riprendi in mano una carta a caso dal tuo cimitero, poi riordina a tua scelta il tuo cimitero.\', \'type\': \'Stregoneria\', \'flavor\': \'"Alcuni segreti vogliono essere rivelati. Emergono dal terreno di propria volontà." —Dindun della Miniera di Kulrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173780&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'593ac40a-813c-4bc3-b830-83d2f606f278\', \'multiverseId\': 173780}, \'multiverseid\': 173780}, {\'name\': \'化石の発見\', \'text\': \'あなたの墓地にあるカードを１枚無作為に選び、それをあなたの手札に加える。その後、あなたの墓地をあなたが望む順番に並べ替える。\', \'type\': \'ソーサリー\', \'flavor\': \'「明かされるのを待っている秘密もあるのさ。 そいつは自分の意思で土の下から飛び出してくるんだ。」 ――クルラス鉱山のディンダン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174081&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1651346d-cb2a-40d8-a7dd-a89b51c8d08f\', \'multiverseId\': 174081}, \'multiverseid\': 174081}, {\'name\': \'Encontrar Fóssil\', \'text\': \'Devolva um card aleatoriamente de seu cemitério para sua mão e depois reorganize seu cemitério como quiser.\', \'type\': \'Feitiço\', \'flavor\': \'"Alguns segredos querem ser revelados. Eles explodem no solo voluntariamente." — Dindun, da Mina de Kulrath\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172275&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9e3ddc1a-b8a3-43d2-adf0-bf42f55c060e\', \'multiverseId\': 172275}, \'multiverseid\': 172275}, {\'name\': \'Находка Окаменелостей\', \'text\': \'Верните случайно выбранную карту из вашего кладбища в вашу руку, затем измените порядок карт в вашем кладбище по вашему усмотрению.\', \'type\': \'Волшебство\', \'flavor\': \'«Некоторые тайны жаждут разглашения. Они вырываются из почвы по собственному желанию». — Диндан с приисков Кулрата\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172576&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'382f6d78-f544-4def-a7a3-8d6ad2b0e6e8\', \'multiverseId\': 172576}, \'multiverseid\': 172576}, {\'name\': \'寻找化石\', \'text\': \'随机将一张牌从你的坟墓场移回你手上，然后你以任意顺序来排列你的坟墓场。\', \'type\': \'法术\', \'flavor\': \'「有些秘密想要被揭露。 它们是自愿从土壤冒出来的。」 ～库拉斯矿脉的丁顿\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173178&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8a690b1f-3d55-4c68-a32a-5c91fa30e134\', \'multiverseId\': 173178}, \'multiverseid\': 173178}]', '[{\'name\': \'Friedhofsphooka\', \'text\': \'Immer wenn eine Kreatur aus dem Spiel auf einen Friedhof gelegt wird, kannst du {1} bezahlen. Falls du dies tust, wird der Friedhofsphooka zu einer Kopie dieser Kreatur und erhält diese Fähigkeit.\', \'type\': \'Kreatur — Gestaltwandler\', \'flavor\': \'„Das ist schon eine seltsame Kreatur, die sich am Unterlegenen orientiert, nicht am Sieger." —Awylla, elfische Sichermacherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174635&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e7c62f2d-a4d7-48af-b872-c33ee5acec1e\', \'multiverseId\': 174635}, \'multiverseid\': 174635}, {\'name\': \'Puca del cementerio\', \'text\': \'Siempre que una criatura vaya a un cementerio desde el juego, puedes pagar {1}. Si lo haces, el Puca del cementerio es una copia de esa criatura y gana esta habilidad.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'"Es una criatura muy extraña... prefiere al vencido sobre el vencedor." —Awylla, refugiante élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172829&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2cb7c777-f841-4fce-9eb6-9762df1aa5e2\', \'multiverseId\': 172829}, \'multiverseid\': 172829}, {\'name\': \'Pucca de cimetière\', \'text\': "À chaque fois qu\'une créature est mise dans un cimetière depuis le jeu, vous pouvez payer {1}. Si vous faites ainsi, le Pucca de cimetière devient une copie de cette créature et acquiert cette capacité.", \'type\': \'Créature : changeforme\', \'flavor\': "« C\'est une bien étrange créature qui choisit le vaincu au lieu du vainqueur. » —Awylla, protecturge elfe", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173431&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c53bbaa1-c964-4761-9b0c-d42340c43d4e\', \'multiverseId\': 173431}, \'multiverseid\': 173431}, {\'name\': \'Puca del Cimitero\', \'text\': \'Ogniqualvolta una creatura viene messa in un cimitero dal gioco, puoi pagare {1}. Se lo fai, il Puca del Cimitero diventa una copia di quella creatura e ha questa abilità.\', \'type\': \'Creatura — Polimorfo\', \'flavor\': \'"\\\'Davvero una strana creatura, preferisce lo sconfitto al vincitore." —Awylla, salvaincanti elfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173732&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'189b3be4-3ad7-4cf2-adf7-8c72fb27f508\', \'multiverseId\': 173732}, \'multiverseid\': 173732}, {\'name\': \'墓地のプーカ\', \'text\': \'いずれかのクリーチャーが場からいずれかの墓地に置かれるたび、あなたは{1}を支払ってもよい。 そうした場合、墓地のプーカはそのクリーチャーのコピーになるとともにこの能力を得る。\', \'type\': \'クリーチャー — 多相の戦士\', \'flavor\': \'「勝者に屠られるを選ぶは何と奇怪なる生き物か。」 ――エルフの守美者、アウィラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174033&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ec869e86-41a6-4e28-b614-858b0fd50745\', \'multiverseId\': 174033}, \'multiverseid\': 174033}, {\'name\': \'Puca de Cemitério\', \'text\': \'Toda vez que uma criatura é colocada num cemitério vinda do jogo, você pode pagar {1}. Se fizer isso, Puca de Cemitério se tornará uma cópia daquela criatura e ganhará esta habilidade.\', \'type\': \'Criatura — Metamorfo\', \'flavor\': \'"Só uma criatura muito estranha prefere o derrotado ao vencedor." — Awylla, pulcro-protetora élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172227&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0c0b4d7e-4a6b-4cd1-b4af-14c58a88e1e2\', \'multiverseId\': 172227}, \'multiverseid\': 172227}, {\'name\': \'Кладбищенский Пука\', \'text\': \'Каждый раз, когда существо попадает на кладбище из игры, вы можете заплатить {1}. Если вы это делаете, Кладбищенский Пука становится копией того существа и получает эту способность.\', \'type\': \'Существо — Имитатор\', \'flavor\': \'«Это очень странное существо оно выбирает побежденных, а не победителя». — Авилла, эльфийская охранительница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172528&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'309e8c29-af85-49c7-b385-32fe057a87ec\', \'multiverseId\': 172528}, \'multiverseid\': 172528}, {\'name\': \'墓地铺卡\', \'text\': \'每当一个生物从场上置入坟墓场时，你可以支付{1}。 如果你如此作，则墓地铺卡成为该生物的复制，并获得此异能。\', \'type\': \'生物～变形兽\', \'flavor\': \'「这真是个怪家伙，宁愿选败者而不选胜者。」 ～地精美境卫艾薇拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173130&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b0384bb-8096-4332-bb81-a315fde128a6\', \'multiverseId\': 173130}, \'multiverseid\': 173130}]', '[{\'name\': \'Funkenschlag-Duo\', \'text\': \'Immer wenn du einen schwarzen Zauber spielst, erhält das Funkenschlag-Duo +1/+1 bis zum Ende des Zuges.\\nImmer wenn du einen roten Zauber spielst, erhält das Funkenschlag-Duo bis zum Ende des Zuges Erstschlag.\', \'type\': \'Kreatur — Elementarwesen, Krieger, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174662&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7682a382-fcd6-401b-a510-c513ba38c63b\', \'multiverseId\': 174662}, \'multiverseid\': 174662}, {\'name\': \'Dúo golpe de brasas\', \'text\': \'Siempre que juegues un hechizo negro el Dúo golpe de brasas obtiene +1/+1 hasta el final del turno.\\nSiempre que juegues un hechizo rojo el Dúo golpe de brasas gana la habilidad de dañar primero hasta el final del turno.\', \'type\': \'Criatura — Chamán guerrero elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172856&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7b520d2a-6acf-4e5d-93e8-8daa48392353\', \'multiverseId\': 172856}, \'multiverseid\': 172856}, {\'name\': \'Duo frappebraise\', \'text\': "À chaque fois que vous jouez un sort noir, le Duo frappebraise gagne +1/+1 jusqu\'à la fin du tour.\\nÀ chaque fois que vous jouez un sort rouge, le Duo frappebraise acquiert l\'initiative jusqu\'à la fin du tour.", \'type\': \'Créature : élémental et guerrier et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173458&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ae7f1e3a-608d-4226-845c-69be038729c9\', \'multiverseId\': 173458}, \'multiverseid\': 173458}, {\'name\': \'Duo Colpodibrace\', \'text\': \'Ogniqualvolta giochi una magia nera, il Duo Colpodibrace prende +1/+1 fino alla fine del turno.\\nOgniqualvolta giochi una magia rossa, il Duo Colpodibrace ha attacco improvviso fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Sciamano Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173759&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a8096751-dbdc-4ff2-b738-9df419fef58c\', \'multiverseId\': 173759}, \'multiverseid\': 173759}, {\'name\': \'燃えさし打ちの二人組\', \'text\': \'あなたが黒の呪文をプレイするたび、燃えさし打ちの二人組はターン終了時まで＋１/＋１の修整を受ける。\\nあなたが赤の呪文をプレイするたび、燃えさし打ちの二人組はターン終了時まで先制攻撃を得る。\', \'type\': \'クリーチャー — エレメンタル・戦士・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174060&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7e91bb9f-44b5-4371-bde6-2bccab05d224\', \'multiverseId\': 174060}, \'multiverseid\': 174060}, {\'name\': \'Duo Ataque-Inflamado\', \'text\': \'Toda vez que você joga uma mágica preta, Duo Ataque-Inflamado recebe +1/+1 até o final do turno.\\nToda vez que você joga uma mágica vermelha, Duo Ataque-Inflamado ganha iniciativa até o final do turno.\', \'type\': \'Criatura — Elemental Guerreiro Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172254&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38c00533-0dca-40d5-8393-24e5a4cde373\', \'multiverseId\': 172254}, \'multiverseid\': 172254}, {\'name\': \'Искрометные Напарники\', \'text\': \'Каждый раз, когда вы разыгрываете черное заклинание, Искрометные Напарники получают +1/+1 до конца хода.\\nКаждый раз, когда вы разыгрываете красное заклинание, Искрометные Напарники получают Первый удар до конца хода.\', \'type\': \'Существо — Элементаль Воин Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172555&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e2c861cd-168c-463b-af54-0027a985c549\', \'multiverseId\': 172555}, \'multiverseid\': 172555}, {\'name\': \'烬击搭档\', \'text\': \'每当你使用一个黑色咒语时，烬击搭档得+1/+1直到回合结束。\\n每当你使用一个红色咒语时，烬击搭档获得先攻异能直到回合结束。\', \'type\': \'生物～元素／战士／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173157&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'842cf265-46cd-4545-9166-9ae8cef2668e\', \'multiverseId\': 173157}, \'multiverseid\': 173157}]', '[{\'name\': \'Furchteinflößer-Novize\', \'text\': \'Immer wenn ein Spieler einen roten Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, kann eine Kreatur deiner Wahl in diesem Zug nicht blocken.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Stehe ihm besser nicht im Weg, denn sein Weg ist voll mit spitzen Dingen und Feuer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174573&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ace0faa-9186-4177-b0db-676e4250a3d2\', \'multiverseId\': 174573}, \'multiverseid\': 174573}, {\'name\': \'Iniciado amedrentador\', \'text\': \'Siempre que un jugador juegue un hechizo rojo, puedes pagar {1}. Si lo haces, la criatura objetivo no puede bloquear este turno.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'No te interpongas en su camino, porque su camino está lleno de fuego y cosas pinchudas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172767&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1740bac6-6e6f-4dbc-a353-c0eb7d60630b\', \'multiverseId\': 172767}, \'multiverseid\': 172767}, {\'name\': \'Adepte intimidateur\', \'text\': "À chaque fois qu\'un joueur joue un sort rouge, vous pouvez payer {1}. Si vous faites ainsi, la créature ciblée ne peut pas bloquer ce tour-ci.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': \'Ne restez pas sur sa route, elle est pavée de douleurs et brûlures.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173369&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9dc7b7c2-3dd2-479c-830a-4e5a6b5d7711\', \'multiverseId\': 173369}, \'multiverseid\': 173369}, {\'name\': \'Iniziato Intimidatore\', \'text\': \'Ogniqualvolta un giocatore gioca una magia rossa, puoi pagare {1}. Se lo fai, una creatura bersaglio non può bloccare in questo turno.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Non ostacolargli il cammino, è pieno di fiamme e arnesi appuntiti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173670&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'93572a04-1ded-4965-a17a-47b7738d84ce\', \'multiverseId\': 173670}, \'multiverseid\': 173670}, {\'name\': \'威嚇者の信徒\', \'text\': \'いずれかのプレイヤーが赤の呪文をプレイするたび、クリーチャー１体を対象とする。あなたは{1}を支払ってもよい。 そうした場合、このターン、それではブロックできない。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'奴の道を塞ぐな。山ほどの尖った先と火のお出迎えにあうぞ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173971&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'594848e1-b485-4c01-8755-bc3c82eb3a1b\', \'multiverseId\': 173971}, \'multiverseid\': 173971}, {\'name\': \'Iniciado Intimidador\', \'text\': \'Toda vez que um jogador joga uma mágica vermelha, você pode pagar {1}. Se fizer isso, a criatura alvo não poderá bloquear neste turno.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'Não fique no seu caminho, pois ele é cheio de coisas pontiagudas e de fogo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172165&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'570ab5a4-51dd-4c7e-a163-282866218c82\', \'multiverseId\': 172165}, \'multiverseid\': 172165}, {\'name\': \'Искусный Устрашитель\', \'text\': \'Каждый раз, когда игрок разыгрывает красное заклинание, вы можете заплатить {1}. Если вы это делаете, целевое существо не может блокировать в этом ходу.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Не стойте у него на пути, ибо путь его устлан огнем и смертельными остриями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172466&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b4ea9a97-abe3-456a-8976-0c9fa7f0b47d\', \'multiverseId\': 172466}, \'multiverseid\': 172466}, {\'name\': \'威吓学徒\', \'text\': \'每当任一牌手使用红色咒语时，你可以支付{1}。 若你如此作，则目标生物本回合不能进行阻挡。\', \'type\': \'生物～精灵／祭师\', \'flavor\': \'别挡他的路，那上面遍布尖刺与火焰。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173068&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9f116d6d-ae04-4107-8101-17b75ffb7284\', \'multiverseId\': 173068}, \'multiverseid\': 173068}]', '[{\'name\': \'Futterfetzen-Duo\', \'text\': \'Immer wenn du einen roten Zauber spielst, erhält das Futterfetzen-Duo +1/+1 bis zum Ende des Zuges.\\nImmer wenn du einen grünen Zauber spielst, erhält das Futterfetzen-Duo bis zum Ende des Zuges Waldtarnung.\', \'type\': \'Kreatur — Goblin, Krieger, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174695&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4b765182-b056-42c5-93a7-62e301485a18\', \'multiverseId\': 174695}, \'multiverseid\': 174695}, {\'name\': \'Dúo de Gruñeharapos\', \'text\': \'Siempre que juegues un hechizo rojo, el Dúo de Gruñeharapos obtiene +1/+1 hasta el final del turno.\\nSiempre que juegues un hechizo verde, el Dúo de Gruñeharapos gana la habilidad de cruzar bosques hasta el final del turno.\', \'type\': \'Criatura — Chamán guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172889&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0200f7a6-7b71-4159-b748-e56265f65601\', \'multiverseId\': 172889}, \'multiverseid\': 172889}, {\'name\': \'Duo de Croquemiette\', \'text\': "À chaque fois que vous jouez un sort rouge, le Duo de Croquemiette gagne +1/+1 jusqu\'à la fin du tour.\\nÀ chaque fois que vous jouez un sort vert, le Duo de Croquemiette acquiert la traversée des forêts jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et guerrier et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173491&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e737e2fe-2e1d-493d-b52c-609c9eb8d6e5\', \'multiverseId\': 173491}, \'multiverseid\': 173491}, {\'name\': \'Duo di Mangiastracci\', \'text\': \'Ogniqualvolta giochi una magia rossa, il Duo di Mangiastracci prende +1/+1 fino alla fine del turno.\\nOgniqualvolta giochi una magia verde, il Duo di Mangiastracci ha passa-Foreste fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Sciamano Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173792&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'779cc1fc-352c-4117-bd01-d598c347f6a2\', \'multiverseId\': 173792}, \'multiverseid\': 173792}, {\'name\': \'ぼろ布食いの二人組\', \'text\': \'あなたが赤の呪文をプレイするたび、ぼろ布食いの二人組はターン終了時まで＋１/＋１の修整を受ける。\\nあなたが緑の呪文をプレイするたび、ぼろ布食いの二人組はターン終了時まで森渡りを得る。\', \'type\': \'クリーチャー — ゴブリン･戦士・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174093&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd0d092d-7c4c-47b9-8bdb-d8d65df04300\', \'multiverseId\': 174093}, \'multiverseid\': 174093}, {\'name\': \'Duo de Masca-Trapo\', \'text\': \'Toda vez que você joga uma mágica vermelha, Duo de Masca-Trapo recebe +1/+1 até o final do turno.\\nToda vez que você joga uma mágica verde, Duo de Masca-Trapo ganha travessia de floresta até o final do turno.\', \'type\': \'Criatura — Goblin Guerreiro Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172287&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b2a5135f-af34-4f34-a2ba-b11330733452\', \'multiverseId\': 172287}, \'multiverseid\': 172287}, {\'name\': \'Напарники Клочкогрызы\', \'text\': \'Каждый раз, когда вы разыгрываете красное заклинание, Напарники Клочкогрызы получают +1/+1 до конца хода.\\nКаждый раз, когда вы разыгрываете зеленое заклинание, Напарники Клочкогрызы получают Знание Лесов до конца хода.\', \'type\': \'Существо — Гоблин Воин Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172588&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e47f62f2-66cf-429a-9249-ff975bb18e3d\', \'multiverseId\': 172588}, \'multiverseid\': 172588}, {\'name\': \'碎嘴搭档\', \'text\': \'每当你使用一个红色咒语时，碎嘴搭档得+1/+1直到回合结束。\\n每当你使用一个绿色咒语时，碎嘴搭档获得树林行者异能直到回合结束。\', \'type\': \'生物～精灵／战士／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173190&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8dcacbb8-4b98-4014-8798-d1e9a47554c8\', \'multiverseId\': 173190}, \'multiverseid\': 173190}]', "[{'name': 'Futterfetzen-Fanatiker', 'text': 'Der Futterfetzen-Fanatiker greift in jedem Zug an, falls möglich.', 'type': 'Kreatur — Goblin, Krieger', 'flavor': 'Zum Essen kleidet er sich gerne in das Gerippe seiner letzten Mahlzeit.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174696&type=card', 'language': 'German', 'identifiers': {'scryfallId': '0a8d1ba6-dac7-49fa-ac22-69235bec976c', 'multiverseId': 174696}, 'multiverseid': 174696}, {'name': 'Maniático de Gruñeharapos', 'text': 'El Maniático de Gruñeharapos ataca cada turno si puede.', 'type': 'Criatura — Guerrero trasgo', 'flavor': 'Llega a una cena vistiendo la carcasa de la anterior.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172890&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3ecdb1c6-b1c6-4c87-8902-04e8abb90ecc', 'multiverseId': 172890}, 'multiverseid': 172890}, {'name': 'Maniaque de Croquemiette', 'text': 'Le Maniaque de Croquemiette attaque à chaque tour si possible.', 'type': 'Créature : gobelin et guerrier', 'flavor': 'Quand il vient manger, il porte encore la carcasse de son repas précédent.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173492&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6f62307e-265a-434c-af77-6ac6b9c1b521', 'multiverseId': 173492}, 'multiverseid': 173492}, {'name': 'Maniaco di Mangiastracci', 'text': 'Il Maniaco di Mangiastracci attacca ogni turno, se può farlo.', 'type': 'Creatura — Guerriero Goblin', 'flavor': 'Si presenta a un pranzo indossando la carcassa del precedente.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173793&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '54831ca5-a3a7-4a46-a4b3-cd8a4c12c81e', 'multiverseId': 173793}, 'multiverseid': 173793}, {'name': 'ぼろ布食いの偏執狂', 'text': 'ぼろ布食いの偏執狂は、毎ターン可能ならば攻撃する。', 'type': 'クリーチャー — ゴブリン・戦士', 'flavor': 'それは最期を迎えた死体の着物を食うために顔を出す。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174094&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '91420ca2-4007-4d85-b3a9-19b0f1ddd149', 'multiverseId': 174094}, 'multiverseid': 174094}, {'name': 'Maníaco de Masca-Trapo', 'text': 'Maníaco de Masca-Trapo ataca a cada turno se estiver apto.', 'type': 'Criatura — Goblin Guerreiro', 'flavor': 'Ele chega a uma refeição vestido com a carcaça da última.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172288&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a4bde857-bb78-4c7e-a966-6391f60b6410', 'multiverseId': 172288}, 'multiverseid': 172288}, {'name': 'Клочкогрыз-Маньяк', 'text': 'Клочкогрыз-Маньяк атакует в каждом ходу, если может.', 'type': 'Существо — Гоблин Воин', 'flavor': 'Он заявляется к столу, облаченный в останки своей предыдущей трапезы.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172589&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f5ca3810-1ff5-408a-8265-170627c1fa5e', 'multiverseId': 172589}, 'multiverseid': 172589}, {'name': '碎嘴狂人', 'text': '碎嘴狂人每回合若能攻击，则必须攻击。', 'type': '生物～精灵／战士', 'flavor': '他进餐时把上一顿的猎物穿在身上。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173191&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6615b0fe-0593-4043-9cd7-e166654aaf71', 'multiverseId': 173191}, 'multiverseid': 173191}]", '[{\'name\': \'Futterfetzenhexe\', \'text\': \'{R}{G}: Jede geblockte Kreatur erhält +1/+0 und verursacht bis zum Ende des Zuges Trampelschaden.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Die Futterfetzenbande kennt keine Bezeichnung für den Zauber, der ihre instinktive Wut in Raserei verwandelt. Sie wissen nur, dass sie ihn lieben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174697&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14d02e13-6e0e-449e-b404-b0dca7443da6\', \'multiverseId\': 174697}, \'multiverseid\': 174697}, {\'name\': \'Bruja de Gruñeharapos\', \'text\': \'{R}{G}: Cada criatura bloqueada obtiene +1/+0 y gana la habilidad de arrollar hasta el final del turno.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'La banda Gruñeharapos no tiene palabras para el hechizo que transforma su ira en frenesí. Sólo saben que les gusta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172891&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4211ee96-a8bc-47ec-94e7-a5f8d0d78720\', \'multiverseId\': 172891}, \'multiverseid\': 172891}, {\'name\': \'Envoûteur de Croquemiette\', \'text\': "{R}{G} : Chaque créature bloquée gagne +1/+0 et acquiert le piétinement jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et shamane\', \'flavor\': "Le gang de Croquemiette n\'a pas de mot pour désigner le sort qui enfle leur rage instinctive en folie meurtrière. Ce qui ne l\'empêche pas de l\'utiliser.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173493&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d15f3823-bbdc-45d3-bb52-e620e5b29b70\', \'multiverseId\': 173493}, \'multiverseid\': 173493}, {\'name\': \'Stregone di Mangiastracci\', \'text\': \'{R}{G}: Ogni creatura bloccata prende +1/+0 e ha travolgere fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'La banda di Mangiastracci non ha parole per descrivere la magia che trasforma la loro ira istintiva in vera e propria furia. Sanno solo che a loro piace.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173794&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1fe7f896-9a24-4d92-b1c8-3377521d5d5f\', \'multiverseId\': 173794}, \'multiverseid\': 173794}, {\'name\': \'ぼろ布食いの魔女\', \'text\': \'{R}{G}：ブロックされている各クリーチャーは、ターン終了時まで＋１/＋０の修整を受けるとともにトランプルを得る。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'ぼろ布食いの連中は、自分たちの本能の怒りを狂乱へと焚きつける呪文の名を知らない。 ただ、彼らはそれが気に入っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174095&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e79fd7ad-48c0-41b7-bebe-e2866f347394\', \'multiverseId\': 174095}, \'multiverseid\': 174095}, {\'name\': \'Bruxa de Masca-Trapo\', \'text\': \'{R}{G}: Cada criatura bloqueada recebe +1/+0 e ganha atropelar até o final do turno.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'A gangue de Masca-Trapo não tem palavras para a mágica que induz sua ira instintiva a um frenesi. Eles sabem apenas que gostam dela.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172289&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d72e828-ca6c-4a09-ad78-51513b737df2\', \'multiverseId\': 172289}, \'multiverseid\': 172289}, {\'name\': \'Ведьма из Клана Клочкогрызов\', \'text\': \'{R}{G}: каждое заблокированное существо получает +1/+0 и Пробивной удар до конца хода.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'У банды клочкогрызов нет слова для заклинания, превращающего их инстинктивную ярость в исступление. Они знают только, что это им нравится.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172590&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9c508661-c6bc-41c2-a45f-4dd661a3a34f\', \'multiverseId\': 172590}, \'multiverseid\': 172590}, {\'name\': \'碎嘴法术师\', \'text\': \'{R}{G}：每个被阻挡的生物得+1/+0且获得践踏异能直到回合结束。\', \'type\': \'生物～精灵／祭师\', \'flavor\': \'碎嘴帮不懂将直觉愤怒变成狂热的咒语该怎么写。 他们只知道这很棒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173192&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'473271ab-38fe-47bf-9158-85bfd86d07d6\', \'multiverseId\': 173192}, \'multiverseid\': 173192}]', "[{'name': 'Fäulnis-Sichel', 'text': 'Die ausgerüstete Kreatur erhält +1/+0 und hat Verdorren. (Sie fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nAusrüsten {2}', 'type': 'Artefakt — Ausrüstung', 'flavor': 'Die Narben schmerzen mehr als der Schnitt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174724&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b362de19-cad7-4b95-b5bc-af9b9040df5c', 'multiverseId': 174724}, 'multiverseid': 174724}, {'name': 'Hoz de ruina', 'text': 'La criatura equipada obtiene +1/+0 y tiene la habilidad de debilitar. (Hace daño a las criaturas en forma de contadores -1/-1.)\\nEquipar {2}.', 'type': 'Artefacto — Equipo', 'flavor': 'Sus cortes van más profundo que su hoja.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172918&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e8f6f2ab-af85-4f9c-a1ea-ba1223408208', 'multiverseId': 172918}, 'multiverseid': 172918}, {'name': 'Faucille de flétrissement', 'text': 'La créature équipée gagne +1/+0 et a la flétrissure. (Elle inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nÉquipement {2}', 'type': 'Artefact : équipement', 'flavor': 'Ses cicatrices sont plus profondes que son entaille.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173520&type=card', 'language': 'French', 'identifiers': {'scryfallId': '931e2e54-6113-4726-8df2-ce6336a79327', 'multiverseId': 173520}, 'multiverseid': 173520}, {'name': 'Falcetto Avvizzente', 'text': 'La creatura equipaggiata prende +1/+0 e ha avvizzire. (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nEquipaggiare {2}', 'type': 'Artefatto — Equipaggiamento', 'flavor': 'Le sue cicatrici tagliano più a fondo della sua lama.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173821&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '411dffa3-aee6-49f6-84b6-e126a36b1162', 'multiverseId': 173821}, 'multiverseid': 173821}, {'name': '荒廃の鎌', 'text': '装備しているクリーチャーは＋１/＋０の修整を受けるとともに萎縮を持つ。 （それはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\n装備 {2}', 'type': 'アーティファクト — 装備品', 'flavor': 'それは刃よりも深い傷を刻む。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174122&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1c75ff89-d4b6-4dab-8971-90e097ea47ab', 'multiverseId': 174122}, 'multiverseid': 174122}, {'name': 'Foice da Desgraça', 'text': 'A criatura equipada recebe +1/+0 e tem murchar. (Ele causa dano a criaturas na forma de marcadores -1/-1.)\\nEquipar {2}', 'type': 'Artefato — Equipamento', 'flavor': 'Suas cicatrizes cortam mais fundo que sua lâmina.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172316&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7eaf520e-2824-4be9-be93-4db1f88bc502', 'multiverseId': 172316}, 'multiverseid': 172316}, {'name': 'Серп Гнили', 'text': 'Снаряженное существо получает +1/+0 и имеет Увядание. (Оно наносит повреждения существам в виде жетонов -1/-1.)\\nСнарядить {2}', 'type': 'Артефакт — Снаряжение', 'flavor': 'Нанесенные им шрамы проникают глубже, чем само острие.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172617&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8ff08a8c-4675-451a-8fa8-89ddd959879b', 'multiverseId': 172617}, 'multiverseid': 172617}, {'name': '枯萎镰刀', 'text': '佩带此武具的生物得+1/+0且具有干枯异能。 （它会以-1/-1指示物的方式对生物造成伤害。）\\n佩带{2}', 'type': '神器～武具', 'flavor': '它引致的伤疤比其锋刃砍得更深。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173219&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f133399d-9bbd-417f-a301-6dc7d28555c4', 'multiverseId': 173219}, 'multiverseid': 173219}]", '[{\'name\': \'Fäuste des Halbgottes\', \'text\': \'Kreaturenverzauberung\\nSolange die verzauberte Kreatur schwarz ist, erhält sie +1/+1 und hat Verdorren. (Sie fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nSolange die verzauberte Kreatur rot ist, erhält sie +1/+1 und hat Erstschlag.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174664&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f75506fb-e464-4e43-a106-e9293f1130ba\', \'multiverseId\': 174664}, \'multiverseid\': 174664}, {\'name\': \'Puños del semidios\', \'text\': \'Encantar criatura.\\nMientras la criatura encantada sea negra, obtiene +1/+1 y tiene la habilidad de debilitar. (Hace daño a las criaturas en forma de contadores -1/-1.)\\nMientras la criatura encantada sea roja, obtiene +1/+1 y tiene la habilidad de dañar primero.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172858&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1ad90195-cd03-40db-bab7-f606ee743168\', \'multiverseId\': 172858}, \'multiverseid\': 172858}, {\'name\': \'Poings du Demi-dieu\', \'text\': "Enchanter : créature\\nTant que la créature enchantée est noire, elle gagne +1/+1 et elle a la flétrissure. (Elle inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nTant que la créature enchantée est rouge, elle gagne +1/+1 et elle a l\'initiative.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173460&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1c921de5-1f89-49ce-8913-22fb11b0a864\', \'multiverseId\': 173460}, \'multiverseid\': 173460}, {\'name\': \'Pugni del Semidio\', \'text\': \'Incanta creatura\\nFintanto che la creatura incantata è nera, prende +1/+1 e ha avvizzire. (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nFintanto che la creatura incantata è rossa, prende +1/+1 e ha attacco improvviso.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173761&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2e1a4e7b-88cf-48c3-96b0-72ad218be426\', \'multiverseId\': 173761}, \'multiverseid\': 173761}, {\'name\': \'亜神の拳\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーが黒であるかぎり、それは＋１/＋１の修整を受けるとともに萎縮を持つ。 （それはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\nエンチャントされているクリーチャーが赤であるかぎり、それは＋１/＋１の修整を受けるとともに先制攻撃を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174062&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c88a73de-9477-4d21-88a4-e8b75eaf14ec\', \'multiverseId\': 174062}, \'multiverseid\': 174062}, {\'name\': \'Punhos do Semideus\', \'text\': \'Encantar criatura\\nEnquanto a criatura encantada for preta, ela receberá +1/+1 e terá murchar. (Ela causa dano a criaturas na forma de marcadores -1/-1.)\\nEnquanto a criatura encantada for vermelha, ela receberá +1/+1 e terá iniciativa.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172256&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e5800afe-511d-42e6-a9ad-2ff6439375e5\', \'multiverseId\': 172256}, \'multiverseid\': 172256}, {\'name\': \'Кулаки Полубога\', \'text\': \'Зачаровать существо\\nПока зачарованное существо черное, оно получает +1/+1 и имеет Увядание. (Оно наносит повреждения существам в виде жетонов -1/-1.)\\nПока зачарованное существо красное, оно получает +1/+1 и имеет Первый удар.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172557&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'70828f13-0eeb-4e38-bf56-2c9d834dfba3\', \'multiverseId\': 172557}, \'multiverseid\': 172557}, {\'name\': \'半神之拳\', \'text\': \'生物结界\\n只要受此结界的生物是黑色，它便得+1/+1且具有干枯异能。 （它会以-1/-1指示物的方式对生物造成伤害。）\\n只要受此结界的生物是红色，它便得+1/+1且具有先攻异能。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173159&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bc28cc2e-e7a7-44e2-b449-6370640a1419\', \'multiverseId\': 173159}, \'multiverseid\': 173159}]', "[{'name': 'Gebirge des Wahnsinns', 'text': '({T}: Erhöhe deinen Manavorrat um {R}.)\\nDas Gebirge des Wahnsinns kommt getappt ins Spiel.\\n{R}, {T}: Mische deine Bibliothek. Spiele diese Fähigkeit nur, falls du zwei oder mehr rote bleibende Karten kontrollierst.', 'type': 'Land — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174751&type=card', 'language': 'German', 'identifiers': {'scryfallId': '51245dea-1cbd-4719-b419-b5008b29dd5c', 'multiverseId': 174751}, 'multiverseid': 174751}, {'name': 'Montaña ceguera demente', 'text': '({T}: Agrega {R} a tu reserva de maná.)\\nLa Montaña ceguera demente entra en juego girada.\\n{R}, {T}: Baraja tu biblioteca. Juega esta habilidad sólo si controlas dos o más permanentes rojos.', 'type': 'Tierra — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172945&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '95d26eb4-8c87-45a4-962f-db3902a23dfb', 'multiverseId': 172945}, 'multiverseid': 172945}, {'name': 'Montagne de la Folie aveugle', 'text': '({T} : Ajoutez {R} à votre réserve.)\\nLa Montagne de la Folie aveugle arrive en jeu engagée.{R}, {T} : Mélangez votre bibliothèque. Ne jouez cette capacité que si vous contrôlez au moins deux permanents rouges.', 'type': 'Terrain : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173547&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2c12644c-4db0-4abd-ba75-a50c6c494727', 'multiverseId': 173547}, 'multiverseid': 173547}, {'name': 'Monte Furia Cieca', 'text': '({T}: Aggiungi {R} alla tua riserva di mana.)\\nIl Monte Furia Cieca entra in gioco TAPpato.\\n{R}, {T}: Rimescola il tuo grimorio. Gioca questa abilità solo se controlli due o più permanenti rossi.', 'type': 'Terra — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173848&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1e58529c-6ee6-4410-8863-5cd6b563e91c', 'multiverseId': 173848}, 'multiverseid': 173848}, {'name': '狂気盲いの山', 'text': '（{T}：あなたのマナプールに{R}を加える。）\\n狂気盲いの山はタップ状態で場に出る。\\n{R}, {T}：あなたのライブラリーを切り直す。 この能力は、あなたが２つ以上の赤のパーマネントをコントロールしている場合にのみプレイできる。', 'type': '土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174149&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7c209366-ecb0-4b0a-b8d9-9ac44e1f9795', 'multiverseId': 174149}, 'multiverseid': 174149}, {'name': 'Montanha da Névoa Insana', 'text': '({T}: Adicione {R} à sua reserva de mana.)\\nMontanha da Névoa Insana entra em jogo virado.\\n{R}, {T}: Embaralhe seu grimório. Jogue esta habilidade somente se você controlar duas ou mais permanentes vermelhas.', 'type': 'Terreno — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172343&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd884fea1-d2c7-4fde-9dfa-b56624e4a5f5', 'multiverseId': 172343}, 'multiverseid': 172343}, {'name': 'Шальная Гора', 'text': '({T}: добавьте {R} в ваше хранилище маны.)\\nШальная Гора входит в игру повернутой.\\n{R}, {T}: перетасуйте вашу библиотеку. Разыгрывайте эту способность, только если вы контролируете два или более красных перманента.', 'type': 'Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172644&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ab1f30f3-dd7e-436c-b3a7-6146bcb8d1c9', 'multiverseId': 172644}, 'multiverseid': 172644}, {'name': '盲乱山脉', 'text': '（{T}：加{R}到你的法术力池中。）\\n盲乱山脉须横置进场。\\n{R}，{T}：将你的牌库洗牌。 你只可以于你操控两个或更多红色永久物时使用此异能。', 'type': '地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173246&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '28ed41fe-9701-46ab-a95f-4ffa50131c59', 'multiverseId': 173246}, 'multiverseid': 173246}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177814&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8a64bccc-c26c-4ef3-9573-46d45fe0ee46', 'multiverseId': 177814}, 'multiverseid': 177814}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177838&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '99cb6727-e1e8-46ca-9a13-95da9c9db91e', 'multiverseId': 177838}, 'multiverseid': 177838}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177885&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3b383799-0b34-49cc-b3bb-33f52b86b7ad', 'multiverseId': 177885}, 'multiverseid': 177885}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177909&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cb5ffff2-8c1c-49de-b500-30177d969116', 'multiverseId': 177909}, 'multiverseid': 177909}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177790&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fad93da6-0863-4c82-a00d-1fa75b37dc9d', 'multiverseId': 177790}, 'multiverseid': 177790}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177766&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '195f0708-d000-47dc-babd-d4855f88e992', 'multiverseId': 177766}, 'multiverseid': 177766}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177742&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2502ac65-3fd8-4f4a-841d-3b38860aa683', 'multiverseId': 177742}, 'multiverseid': 177742}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177861&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a937ea50-2b8a-4c2c-b719-da5fcc553e5a', 'multiverseId': 177861}, 'multiverseid': 177861}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177815&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8114a0a3-fef5-41ac-9778-c7945fc80c1b', 'multiverseId': 177815}, 'multiverseid': 177815}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177839&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '44dbda9b-cf1c-4243-8b87-f6674339bbee', 'multiverseId': 177839}, 'multiverseid': 177839}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177886&type=card', 'language': 'French', 'identifiers': {'scryfallId': '412f2b64-329b-41f6-b10f-46efbd38798c', 'multiverseId': 177886}, 'multiverseid': 177886}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177910&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '203be9bd-6a1c-4b9d-aadf-33fe1b67f420', 'multiverseId': 177910}, 'multiverseid': 177910}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177791&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cbda05d5-c711-4efe-acaa-b310c39c17bc', 'multiverseId': 177791}, 'multiverseid': 177791}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177767&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '04e9dd64-e85d-45e3-a03f-142ad33f9187', 'multiverseId': 177767}, 'multiverseid': 177767}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177743&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0d5fd7d2-a924-490c-9965-820375f5ea55', 'multiverseId': 177743}, 'multiverseid': 177743}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177862&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ecc186fd-2ca9-403e-a777-8254cbb1816f', 'multiverseId': 177862}, 'multiverseid': 177862}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177816&type=card', 'language': 'German', 'identifiers': {'scryfallId': '86bab147-0720-4c04-8457-e46d583be7f6', 'multiverseId': 177816}, 'multiverseid': 177816}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177840&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '73557aa9-be42-4f56-9e64-f9a3126f876b', 'multiverseId': 177840}, 'multiverseid': 177840}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177887&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ffa1c051-bb1a-4968-a5f4-213cc1adb806', 'multiverseId': 177887}, 'multiverseid': 177887}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177911&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '395408c1-a525-49c4-ac4e-c047ffd6d08e', 'multiverseId': 177911}, 'multiverseid': 177911}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177792&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6f747e82-cb69-4387-9dc3-5a4b66e2a60d', 'multiverseId': 177792}, 'multiverseid': 177792}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177768&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '0b43f790-87b8-4165-9406-68117869a486', 'multiverseId': 177768}, 'multiverseid': 177768}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177744&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '528c0baa-0f0e-40cb-9323-9b77866a5d55', 'multiverseId': 177744}, 'multiverseid': 177744}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177863&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '7dfed430-fde3-439f-955f-af880e2f02db', 'multiverseId': 177863}, 'multiverseid': 177863}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177817&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2c9b11e2-a5b8-44df-8750-4a8c13797bb8', 'multiverseId': 177817}, 'multiverseid': 177817}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177841&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7891e6aa-d77e-4f05-b889-a69c72ed290d', 'multiverseId': 177841}, 'multiverseid': 177841}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177888&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7a408d92-d152-47d0-a297-39087ee48d9f', 'multiverseId': 177888}, 'multiverseid': 177888}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177912&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e1c378bc-ab99-4beb-bc86-5804b6a12df6', 'multiverseId': 177912}, 'multiverseid': 177912}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177793&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '9e1e4020-7335-4bdb-b36c-54fe5834b827', 'multiverseId': 177793}, 'multiverseid': 177793}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177769&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'dec4c3ec-af90-48a8-bca0-000a9eed73e8', 'multiverseId': 177769}, 'multiverseid': 177769}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177745&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '16e8baa0-9873-45ef-81aa-dcaef1d5c004', 'multiverseId': 177745}, 'multiverseid': 177745}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177864&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2e77d21b-c1f7-4ea5-97de-7490d7acf230', 'multiverseId': 177864}, 'multiverseid': 177864}]", '[{\'name\': \'Gedankengewebe-Gambit\', \'text\': \'Tappe alle Kreaturen, die deine Gegner kontrollieren, und enttappe alle Kreaturen, die du kontrollierst.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Gedankenverbund der Kithkin ist im Schattenmoor noch enger geworden und festigt die Einheit innerhalb ihrer Gemeinschaft so sehr, dass sie in Fremdenfeindlichkeit umkippt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174631&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'636b7924-3db7-4ff9-a0c4-66cde4f6a060\', \'multiverseId\': 174631}, \'multiverseid\': 174631}, {\'name\': \'Gambito de la trama mental\', \'text\': \'Gira todas las criaturas que controlan tus oponentes y endereza todas las criaturas que controlas.\', \'type\': \'Instantáneo\', \'flavor\': \'El lazo mental de los kithkin es más estrecho en el Páramo sombrío, reforzando la unidad de su comunidad al punto de la xenofobia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172825&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d867db85-6f01-42a7-83dd-4599d185f5ed\', \'multiverseId\': 172825}, \'multiverseid\': 172825}, {\'name\': \'Pari de tramepensée\', \'text\': \'Engagez toutes les créatures que vos adversaires contrôlent et dégagez toutes les créatures que vous contrôlez.\', \'type\': \'Éphémère\', \'flavor\': "Le lien télépathique des sangamis est encore plus fort sur Sombrelande. L\'unité de leur communauté est telle qu\'elle éveille leur xénophobie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173427&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9c86e057-6e35-4a01-908e-c4b8406c52d6\', \'multiverseId\': 173427}, \'multiverseid\': 173427}, {\'name\': \'Avvio della Trama dei Pensieri\', \'text\': \'TAPpa tutte le creature controllate dai tuoi avversari e STAPpa tutte le creature che controlli.\', \'type\': \'Istantaneo\', \'flavor\': "Il legame mentale kithkin è ancora più stretto nella Landa Tenebrosa, rinforzando l\'unità della comunità fino alla xenofobia.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173728&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1228391-9f48-4041-9a83-4f64326eff29\', \'multiverseId\': 173728}, \'multiverseid\': 173728}, {\'name\': \'思考の糸の計略\', \'text\': \'対戦相手がコントロールするすべてのクリーチャーをタップし、あなたがコントロールするすべてのクリーチャーをアンタップする。\', \'type\': \'インスタント\', \'flavor\': \'キスキンの精神のつながりはシャドウムーアではいっそう堅固で、他族を毛嫌いする点で彼らの結束を再び固めている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174029&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd9285f0-265d-4a58-8c4f-60370cd4a732\', \'multiverseId\': 174029}, \'multiverseid\': 174029}, {\'name\': \'Gambito da Trama-Mental\', \'text\': \'Vire todas as criaturas que seus oponentes controlam e desvire todas as criaturas que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O elo mental dos kithkin é ainda mais estreito em Pântano Sombrio, reforçando a unidade da comunidade no limiar da xenofobia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172223&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5dcd033f-7a16-4f1e-b1a6-8a4532d88957\', \'multiverseId\': 172223}, \'multiverseid\': 172223}, {\'name\': \'Гамбит Сплетенных Мыслей\', \'text\': \'Поверните все существа под контролем ваших оппонентов и разверните все существа под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Узы сплетенных мыслей у кискенов в Шэдоумуре еще прочнее, а единство их племени так крепко, что порождает настоящую ксенофобию.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172524&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'381afa50-8a06-4850-93a8-019b4f87120a\', \'multiverseId\': 172524}, \'multiverseid\': 172524}, {\'name\': \'纺思探先\', \'text\': \'横置由全部对手所操控的所有生物，并重置所有由你操控的生物。\', \'type\': \'瞬间\', \'flavor\': \'洁英的心灵连结在暗影荒原更加紧密，让其群体的团结性高涨到极度排外的地步。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173126&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5501f229-6df6-424f-854d-d73e5a487839\', \'multiverseId\': 173126}, \'multiverseid\': 173126}]', '[{\'name\': \'Gedankenspiegelung\', \'text\': \'Falls du eine Karte ziehen würdest, ziehe stattdessen zwei Karten.\', \'type\': \'Verzauberung\', \'flavor\': \'Wissen füllt den Verstand eines Dummkopfs und öffnet den eines Weisen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174530&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6ad1d397-b670-4bcc-8d7f-978572cf818f\', \'multiverseId\': 174530}, \'multiverseid\': 174530}, {\'name\': \'Reflejo del pensamiento\', \'text\': \'Si fueras a robar una carta, en vez de eso, roba dos cartas.\', \'type\': \'Encantamiento\', \'flavor\': \'El conocimiento llena la mente de un tonto y abre la mente de un sabio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172724&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5b521460-aa38-4133-b431-e55e46851a43\', \'multiverseId\': 172724}, \'multiverseid\': 172724}, {\'name\': \'Réverbération de pensée\', \'text\': \'Si vous deviez piocher une carte, piochez deux cartes à la place.\', \'type\': \'Enchantement\', \'flavor\': "Le savoir emplit l\'esprit de l\'imbécile et ouvre celui du sage.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173326&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4045e191-b888-4143-b07f-a7f8f3eb8e31\', \'multiverseId\': 173326}, \'multiverseid\': 173326}, {\'name\': \'Riflesso di Pensiero\', \'text\': \'Se stai per pescare una carta, pesca invece due carte.\', \'type\': \'Incantesimo\', \'flavor\': \'La sapienza riempie la mente del folle e apre quella del saggio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173627&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'095618d0-c17b-4a77-9f2d-cca2b208bc48\', \'multiverseId\': 173627}, \'multiverseid\': 173627}, {\'name\': \'思考の反射\', \'text\': \'あなたがカードを１枚引く場合、代わりにカードを２枚引く。\', \'type\': \'エンチャント\', \'flavor\': \'知識は愚か者の精神を満たし、賢者の精神を開く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173928&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d184f3d5-447d-4856-a57b-f40ef3fc682b\', \'multiverseId\': 173928}, \'multiverseid\': 173928}, {\'name\': \'Reflexo de Pensamento\', \'text\': \'Se você for comprar um card, em vez disso, compre dois cards.\', \'type\': \'Encantamento\', \'flavor\': \'O conhecimento preenche a mente de um tolo e abre a mente de um sábio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172122&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'09f8f9d1-ca11-4e43-a7b5-1509cc6716a8\', \'multiverseId\': 172122}, \'multiverseid\': 172122}, {\'name\': \'Отражение Мысли\', \'text\': \'Если вы должны взять карту, возьмите две карты вместо этого.\', \'type\': \'Чары\', \'flavor\': \'Знание заполняет разум глупца и расширяет горизонты умного.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172423&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea04af43-97d8-49df-b02e-44786be93f49\', \'multiverseId\': 172423}, \'multiverseid\': 172423}, {\'name\': \'心念映象\', \'text\': \'若你将抓一张牌，则改为抓两张牌。\', \'type\': \'结界\', \'flavor\': \'知识盈满愚人的心灵，打开智者的心灵。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173025&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7e418c04-a5c5-4806-8321-cfba4f02d671\', \'multiverseId\': 173025}, \'multiverseid\': 173025}]', '[{\'name\': \'Gedankenstaker\', \'text\': \'Der Gedankenstaker kann nicht angreifen, falls der verteidigende Spieler keine blaue bleibende Karte kontrolliert.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'„Gedanken? Täuschung? Fortschritt? Du machst ihm nur Hunger." —Abral, Kithkinalchimist\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174531&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ab1dcc0-3738-48e3-91dd-a4f17d7c7d92\', \'multiverseId\': 174531}, \'multiverseid\': 174531}, {\'name\': \'Vadeador de antojos\', \'text\': \'El Vadeador de antojos no puede atacar a menos que el jugador defensor controle un permanente azul.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"¿Pensamiento? ¿Engaño? ¿Progreso? ¡Le estás dando hambre" —Abral, alquimista kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172725&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a08d5c59-ebf9-409c-9890-3b944ee1e3c6\', \'multiverseId\': 172725}, \'multiverseid\': 172725}, {\'name\': \'Ondoyeur des lubies\', \'text\': "L\'Ondoyeur des lubies ne peut pas attaquer, à moins que le joueur défenseur ne contrôle au moins un permanent bleu.", \'type\': \'Créature : élémental\', \'flavor\': \'« Songe ? Tromperie ? Progrès ? Attention, vous lui donnez faim. » —Abral, alchimiste sangami\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173327&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'797a2036-a7d6-4aac-af14-d8be3f5a6139\', \'multiverseId\': 173327}, \'multiverseid\': 173327}, {\'name\': \'Scrutapensieri\', \'text\': \'Lo Scrutapensieri non può attaccare a meno che il giocatore in difesa non controlli un permanente blu.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'"Pensiero? Inganno? Progresso? Ora lo stai rendendo sempre più famelico." —Abral, alchimista kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173628&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ba037fd-bac3-4bf9-9c4a-252adebd0829\', \'multiverseId\': 173628}, \'multiverseid\': 173628}, {\'name\': \'気紛れ歩き\', \'text\': \'気紛れ歩きは、防御プレイヤーが青のパーマネントをコントロールしていないかぎり攻撃できない。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'「思考？ 欺瞞？ 発展？ やつの腹を減らすだけだぞ。」 ――キスキンの錬金術師、アブラール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173929&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e38af550-e748-4851-a4c2-3b147a356d1d\', \'multiverseId\': 173929}, \'multiverseid\': 173929}, {\'name\': \'Andarilho Mental\', \'text\': \'Andarilho Mental não pode atacar, a menos que o jogador defensor controle uma permanente azul.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'"Pensamento? Trapaça? Progresso? Você só está o deixando faminto." — Abral, alquimista kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172123&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a4f980f6-e4e8-41f2-badc-ffce09658dc6\', \'multiverseId\': 172123}, \'multiverseid\': 172123}, {\'name\': \'Мыслеброд\', \'text\': \'Мыслеброд не может атаковать, если защищающийся игрок не контролирует синий перманент.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'«Мысль? Обман? Развитие? Ваши думы только заставляют его нагулять аппетит». — Абрал, кискен-алхимик\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172424&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1e77c1d-a6a9-4df5-a987-5c9d65ef08f5\', \'multiverseId\': 172424}, \'multiverseid\': 172424}, {\'name\': \'循思灵\', \'text\': \'除非防御牌手操控蓝色永久物，否则循思灵不能攻击。\', \'type\': \'生物～元素\', \'flavor\': \'「想法？ 诡计？ 进展？ 这下你只让它更饿了。」 ～洁英炼金术士艾帛\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173026&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5affde1a-1e95-4584-9c3c-567cb0c7c093\', \'multiverseId\': 173026}, \'multiverseid\': 173026}]', '[{\'name\': \'Geflochtener Kampfkrabbler\', \'text\': \'Immer wenn der Geflochtene Kampfkrabbler angreift oder blockt, lege am Ende des Kampfes eine -1/-1-Marke auf ihn.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Er ist die verrückte Erfindung eines Kithkin-Wahrsagers, der von sehr großen Krähen träumte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174746&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'bdee3140-a7ae-41fd-b931-e155ba522f6c\', \'multiverseId\': 174746}, \'multiverseid\': 174746}, {\'name\': \'Rondador guerrero de mimbre\', \'text\': \'Siempre que el Rondador guerrero de mimbre ataque o bloquee, pon un contador -1/-1 sobre él al final del combate.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'Es la creación retorcida de un adivinador kithkin que soñaba con cuervos muy grandes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172940&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13e52939-7d97-4154-a3dc-e76afa08c647\', \'multiverseId\': 172940}, \'multiverseid\': 172940}, {\'name\': \'Rampeguerre en osier\', \'text\': \'À chaque fois que le Rampeguerre en osier attaque ou bloque, mettez un marqueur -1/-1 sur lui à la fin du combat.\', \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "C\'est la création corrompue d\'un devineur sangami qui rêvait d\'immenses corbeaux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173542&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'85d7969b-77cc-4913-80f7-76644e82ff57\', \'multiverseId\': 173542}, \'multiverseid\': 173542}, {\'name\': \'Strisciavimini da Guerra\', \'text\': \'Ogniqualvolta lo Strisciavimini da Guerra attacca o blocca, metti un segnalino -1/-1 su di esso alla fine del combattimento.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': \'È la contorta creazione di un indovino kithkin che aveva sognato cornacchie di dimensioni enormi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173843&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3e09cf9d-d2e6-4782-9c20-c936e0aae92f\', \'multiverseId\': 173843}, \'multiverseid\': 173843}, {\'name\': \'小枝の戦這い\', \'text\': \'小枝の戦這いが攻撃かブロックするたび、戦闘終了時にそれの上に－１/－１カウンターを１個置く。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'それは巨大なカラスの夢を見たキスキンの占い師のねじくれた創造物だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174144&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b6cb934-586d-42b1-987d-6291c043d5c7\', \'multiverseId\': 174144}, \'multiverseid\': 174144}, {\'name\': \'Rastejador Vimíneo\', \'text\': \'Toda vez que Rastejador Vimíneo atacar ou bloquear, coloque um marcador -1/-1 nele no final do combate.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'É uma criação deformada de um adivinho kithkin que sonhou com corvos muito grandes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172338&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f6cc54d9-ab7f-4a87-923f-4235f066e9fc\', \'multiverseId\': 172338}, \'multiverseid\': 172338}, {\'name\': \'Плетеный Многоног\', \'text\': \'Каждый раз, когда Плетеный Многоног атакует или блокирует, положите на него один жетон -1/-1 в конце боя.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Это исковерканное создание кискенского предсказателя, которому снились ну очень большие вороны.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172639&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dd8bd810-bd65-45b2-9c83-1beb1455cd64\', \'multiverseId\': 172639}, \'multiverseid\': 172639}, {\'name\': \'柳条战草人\', \'text\': \'每当柳条战草人攻击或阻挡，在战斗结束时于其上放置一个-1/-1指示物。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'某个洁英占卜师梦见非常大的乌鸦，于是造出此等怪物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173241&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4a72c674-815f-45d2-a563-48d59cb8912e\', \'multiverseId\': 173241}, \'multiverseid\': 173241}]', '[{\'name\': \'Gefängnisstrafe\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur kann nicht angreifen oder blocken, und ihre aktivierten Fähigkeiten können nicht gespielt werden.\\nImmer wenn eine Kreatur unter der Kontrolle eines Gegners ins Spiel kommt, kannst du die Gefängnisstrafe an diese Kreatur anlegen.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Mach die Zelle leer. Stecke den nächsten Gefangenen hinein.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174495&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4e9a25a2-5718-43d5-b718-a54260c85901\', \'multiverseId\': 174495}, \'multiverseid\': 174495}, {\'name\': \'Tiempo en prisión\', \'text\': \'Encantar criatura.\\nLa criatura encantada no puede atacar o bloquear y no pueden jugarse sus habilidades activadas.\\nSiempre que una criatura entre en juego bajo el control de un oponente, puedes anexarle el Tiempo en prisión a esa criatura.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Limpien la celda. Traigan el próximo prisionero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172689&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'94d968fc-6356-4dd4-8ccd-c2a14f7f8b85\', \'multiverseId\': 172689}, \'multiverseid\': 172689}, {\'name\': \'Peine de prison\', \'text\': "Enchanter : créature\\nLa créature enchantée ne peut ni attaquer ni bloquer et ses capacités activées ne peuvent pas être jouées.\\nÀ chaque fois qu\'une créature arrive en jeu sous le contrôle d\'un adversaire, vous pouvez attacher la Peine de prison à cette créature.", \'type\': \'Enchantement : aura\', \'flavor\': \'Videz la cellule. Au suivant\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173291&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d18256e-c41e-4d6e-8eec-9de2d59bd93f\', \'multiverseId\': 173291}, \'multiverseid\': 173291}, {\'name\': "Stato d\'Arresto", \'text\': "Incanta creatura\\nLa creatura incantata non può attaccare o bloccare e le sue abilità attivate non possono essere giocate.\\nOgniqualvolta una creatura entra in gioco sotto il controllo di un avversario, puoi assegnare lo Stato d\'Arresto a quella creatura.", \'type\': \'Incantesimo — Aura\', \'flavor\': \'Pulisci la cella. Mettici il prossimo prigioniero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173592&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4231ddf7-ed7b-4251-ad72-337e8a220b59\', \'multiverseId\': 173592}, \'multiverseid\': 173592}, {\'name\': \'禁固刑\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは攻撃もブロックもできず、また、それの起動型能力はプレイできない。\\nいずれかのクリーチャーがいずれかの対戦相手のコントロール下で場に出るたび、あなたはそのクリーチャーに禁固刑をつけてもよい。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'牢屋を空けろ。 次の囚人を連れて来い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173893&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be4cb31c-42c0-497f-923e-51085637da5e\', \'multiverseId\': 173893}, \'multiverseid\': 173893}, {\'name\': \'Período na Prisão\', \'text\': \'Encantar criatura\\nA criatura encantada não pode atacar nem bloquear e suas habilidades ativadas não podem ser jogadas.\\nToda vez que uma criatura entrar em jogo sob o controle de um oponente, você poderá anexar Período na Prisão àquela criatura.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Limpem a cela. Tragam o próximo prisioneiro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172087&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4d636be7-87fb-42d9-9ae0-6130d9c5aa33\', \'multiverseId\': 172087}, \'multiverseid\': 172087}, {\'name\': \'Тюремный Срок\', \'text\': \'Зачаровать существо\\nЗачарованное существо не может атаковать или блокировать, и его активируемые способности нельзя разыгрывать.\\nКаждый раз, когда в игру входит существо под контролем оппонента, вы можете прикрепить Тюремный Срок к тому существу.\', \'type\': \'Чары — Аура\', \'flavor\': \'Освободите камеру. Приведите следующего узника.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172388&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0284076-ba2a-4174-9c78-43b081dc250d\', \'multiverseId\': 172388}, \'multiverseid\': 172388}, {\'name\': \'刑期\', \'text\': \'生物结界\\n受此结界的生物不能进行攻击或阻挡，其起动式异能也不能使用。\\n每当一个生物在对手的操控下进场时，你可以将刑期结附在该生物上。\', \'type\': \'结界～灵气\', \'flavor\': \'把牢房清空。 带下一个囚人进来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172990&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13fb8e07-f0d2-40e6-8be4-864a183d63f3\', \'multiverseId\': 172990}, \'multiverseid\': 172990}]', '[{\'name\': \'Gefühl des Versinkens\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\\nDie verzauberte Kreatur hat „{1}, lege eine -1/-1-Marke auf diese Kreatur: Enttappe diese Kreatur."\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174528&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'91b105ef-d627-4b7d-8d3f-fbca4b123653\', \'multiverseId\': 174528}, \'multiverseid\': 174528}, {\'name\': \'Desaliento\', \'text\': \'Encantar criatura.\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\\nLa criatura encantada tiene "{1}, poner un contador -1/-1 sobre esta criatura: Endereza esta criatura".\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172722&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'effd76c9-f6ef-4cb2-b9fd-1590e840f885\', \'multiverseId\': 172722}, \'multiverseid\': 172722}, {\'name\': "Sentiment d\'immersion", \'text\': "Enchanter : créature\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.\\nLa créature enchantée a « {1}, mettez un marqueur -1/-1 sur cette créature : Dégagez cette créature. »", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173324&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7d85dad0-2056-4a8f-b8f7-c92607e67169\', \'multiverseId\': 173324}, \'multiverseid\': 173324}, {\'name\': \'Sensazione di Sprofondare\', \'text\': \'Incanta creatura\\nLa creatura incantata non STAPpa durante lo STAP del suo controllore.\\nLa creatura incantata ha "{1}, Metti un segnalino -1/-1 su questa creatura: STAPpa questa creatura."\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173625&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5a837ebb-bafd-4a96-a134-f399022c1274\', \'multiverseId\': 173625}, \'multiverseid\': 173625}, {\'name\': \'沈む感覚\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\\nエンチャントされているクリーチャーは「{1}, このクリーチャーの上に－１/－１カウンターを１個置く：このクリーチャーをアンタップする。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173926&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7c3cc7b-4501-4d15-b1c0-0cb6909399b1\', \'multiverseId\': 173926}, \'multiverseid\': 173926}, {\'name\': \'Sensação de Afundar\', \'text\': \'Encantar criatura\\nA criatura encantada não desvira durante a etapa de desvirar de seu controlador.\\nA criatura encantada tem "{1}, Coloque um marcador -1/-1 nesta criatura: Desvire esta criatura."\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172120&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1e763355-0e0a-4799-8753-fd707021f3fd\', \'multiverseId\': 172120}, \'multiverseid\': 172120}, {\'name\': \'Ощущение Провала\', \'text\': \'Зачаровать существо\\nЗачарованное существо не разворачивается во время шага разворота контролирующего его игрока.\\nЗачарованное существо имеет способность «{1}, положите один жетон -1/-1 на это существо: разверните это существо».\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172421&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'486d3e2e-8c53-4085-b89d-0ac469edbec8\', \'multiverseId\': 172421}, \'multiverseid\': 172421}, {\'name\': \'沉落感\', \'text\': \'生物结界\\n受此结界的生物于其操控者的重置步骤中不能重置。\\n受此结界的生物具有「{1}，在此生物上放置一个-1/-1指示物：重置此生物。」\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173023&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1de35399-e156-4112-bf93-f82037dd05b8\', \'multiverseId\': 173023}, \'multiverseid\': 173023}]', '[{\'name\': \'Geisterprozession\', \'text\': \'({2/W} kann mit zwei beliebigen Mana oder mit {W} bezahlt werden. Die umgewandelten Manakosten dieser Karte betragen 6.)\\nBringe drei 1/1 weiße Geist-Kreaturenspielsteine mit Flugfähigkeit ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': \'„Den Toten geht es ohnehin gut. Sie müssen nicht mehr leiden. Wenn das Stören ihrer Ruhe den Lebenden hilft, sollen sie sich nicht beklagen." —Olka, Nebelwiesenhexe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174500&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a831afc1-809c-42de-bc30-2f57cf4995b7\', \'multiverseId\': 174500}, \'multiverseid\': 174500}, {\'name\': \'Procesión espectral\', \'text\': \'({2/W} puede pagarse con dos maná cualesquiera o con {W}. El costo de maná convertido de esta carta es 6.)\\nPon en juego tres fichas de criatura Espíritu blancas 1/1 con la habilidad de volar.\', \'type\': \'Conjuro\', \'flavor\': \'"Es fácil para los muertos. Ya no sufren. Si perturbar su descanso ayuda a los vivos, que así sea." —Olka, bruja de Pradera Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172694&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'82dbfb14-c0be-448d-a2a8-20027a09edaf\', \'multiverseId\': 172694}, \'multiverseid\': 172694}, {\'name\': \'Procession spectrale\', \'text\': "({2/W} peut être payé au choix avec n\'importe quelle combinaison de deux manas ou avec {W}. Le coût converti de mana de cette carte est 6.)\\nMettez en jeu trois jetons de créature 1/1 blanche Esprit avec le vol.", \'type\': \'Rituel\', \'flavor\': \'« Les morts ont de la chance, ils ne souffrent plus. On peut bien interrompre leur repos pour aider les vivants. » —Olka, envoûteuse de Brumeprairie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173296&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a071306e-36e9-489d-a7fe-6e48838977fa\', \'multiverseId\': 173296}, \'multiverseid\': 173296}, {\'name\': \'Processione Spettrale\', \'text\': \'({2/W} può essere pagato con due mana qualsiasi o con {W}. Il costo di mana convertito di questa carta è 6.)\\nMetti in gioco tre pedine creatura Spirito 1/1 bianche con volare.\', \'type\': \'Stregoneria\', \'flavor\': \'"Per i morti è semplice. Loro non soffrono più. Se interrompere il loro riposo può aiutare i viventi, così sia." —Olka, strega della Prateria Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173597&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'790e3f4f-3946-487d-89ac-f5f136a8f1ae\', \'multiverseId\': 173597}, \'multiverseid\': 173597}, {\'name\': \'幽体の行列\', \'text\': \'（{2/W}は、任意の２マナか{W}で支払うことができる。 このカードの点数で見たマナ・コストは６である。）\\n飛行を持つ白の１/１のスピリット・クリーチャー・トークンを３体場に出す。\', \'type\': \'ソーサリー\', \'flavor\': \'「死んだ奴らは安らかさ。 これ以上苦しまないんだからね。 生きてるもののためにその眠りを覚ますんなら、それはそれじゃないか。」 ――ミストメドウの魔女、オルカ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173898&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3743efb5-cd23-40db-b6f6-c898dc2ae399\', \'multiverseId\': 173898}, \'multiverseid\': 173898}, {\'name\': \'Procissão Espectral\', \'text\': \'({2/W} pode ser pago com quaisquer dois manas ou com {W}. O custo de mana convertido desse card é 6.)\\nColoque em jogo três fichas de criatura brancas 1/1 do tipo Espírito com voar.\', \'type\': \'Feitiço\', \'flavor\': \'"Para os mortos é fácil. Eles não sofrem mais. Se uma interrupção no seu descanso ajudar os vivos, então que assim seja." — Olka, bruxa de nevoplanície\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172092&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb7befe0-77e8-4075-ac3d-145260622112\', \'multiverseId\': 172092}, \'multiverseid\': 172092}, {\'name\': \'Призрачная Процессия\', \'text\': \'(За {2/W} можно заплатить две любые маны или {W}. Конвертированная мана-стоимость этой карты равна 6.)\\nПоложите в игру три фишки существа 1/1 белый Дух с Полетом.\', \'type\': \'Волшебство\', \'flavor\': \'«Мертвым легко, их страдания позади. Если, нарушив их покой, можно помочь живым, так быть по сему». — Олка, ведьма из Туманолужья\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172393&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0ebfe899-14aa-4ccc-9ae1-0476eb0900db\', \'multiverseId\': 172393}, \'multiverseid\': 172393}, {\'name\': \'幽灵行列\', \'text\': \'（能用任意两点法术力或是{W}来支付{2/W}。 此牌的总法术力费用为6。）\\n将三个1/1白色，具有飞行异能的精怪衍生物放置进场。\', \'type\': \'法术\', \'flavor\': \'「死人可以轻松胜任； 它们再也不会感到伤痛。 如果打扰它们的安眠能帮助活人，那就作吧。」 ～雾牧地法术师欧卡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172995&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3c0ecb1c-6ce2-4c7f-b93a-6b8de4eb9e03\', \'multiverseId\': 172995}, \'multiverseid\': 172995}]', '[{\'name\': \'Geköderte Vogelscheuche\', \'text\': \'Sowie die Geköderte Vogelscheuche ins Spiel kommt, bestimme eine Farbe.\\nWenn du keine bleibenden Karten der bestimmten Farbe kontrollierst, opfere die Geköderte Vogelscheuche.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Es ist ein Rennen für Narren, wenn alles verloren ist, sollte es gewonnen werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174733&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6c4b91e-6852-4574-b48a-1a3130f7a3d8\', \'multiverseId\': 174733}, \'multiverseid\': 174733}, {\'name\': \'Espantapájaros atado al señuelo\', \'text\': \'En cuanto el Espantapájaros atado al señuelo entre en juego, elige un color.\\nCuando no controles permanentes del color elegido, sacrifica el Espantapájaros atado al señuelo.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'Es una carrera de tontos si todo estará perdido si alguien la gana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172927&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b77b94e3-f689-420b-b214-63b274f67094\', \'multiverseId\': 172927}, \'multiverseid\': 172927}, {\'name\': \'Épouvantail brideleurre\', \'text\': "Au moment où l\'Épouvantail brideleurre arrive en jeu, choisissez une couleur.\\nQuand vous ne contrôlez pas de permanent de la couleur choisie, sacrifiez l\'Épouvantail brideleurre.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': \'Pour gagner, il ne faut pas participer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173529&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d3b390ea-2717-4599-9ce9-bf92185883ef\', \'multiverseId\': 173529}, \'multiverseid\': 173529}, {\'name\': \'Spaventapasseri Seguimagie\', \'text\': \'Mentre lo Spaventapasseri Seguimagie entra in gioco, scegli un colore.\\nQuando non controlli permanenti del colore scelto, sacrifica lo Spaventapasseri Seguimagie.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': "E\' una corsa folle in cui gareggiare se tutto è perso quando si vince.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173830&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'efe5b119-cc8d-4966-a4de-844ca8476cea\', \'multiverseId\': 173830}, \'multiverseid\': 173830}, {\'name\': \'魅了縛りのカカシ\', \'text\': \'魅了縛りのカカシが場に出るに際し、色を１色選ぶ。\\nあなたが選ばれた色のパーマネントをコントロールしていないとき、魅了縛りのカカシを生け贄に捧げる。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'こいつが勝ったら全員が負ける競争から逃げるのは愚か者だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174131&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'790a872a-9a14-4ec1-84eb-2f75634dbe15\', \'multiverseId\': 174131}, \'multiverseid\': 174131}, {\'name\': \'Espantalho da Isca Mágica\', \'text\': \'Conforme Espantalho da Isca Mágica entra em jogo, escolha uma cor.\\nQuando você não controlar nenhuma permanente da cor escolhida, sacrifique Espantalho da Isca Mágica.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'Esta é uma corrida sem sentido, pois tudo estará perdido se ele restar sozinho.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172325&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9deff53d-3700-4734-a387-c043d9031666\', \'multiverseId\': 172325}, \'multiverseid\': 172325}, {\'name\': \'Пугало с Приманкой\', \'text\': \'При входе Пугала с Приманкой в игру выберите цвет.\\nКогда под вашим контролем нет перманентов выбранного цвета, пожертвуйте Пугало с Приманкой.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Какая нелепая гонка даже сам победитель обречен на верную смерть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172626&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f762b66b-2eb7-4c9e-b9a1-357c4cac6fe5\', \'multiverseId\': 172626}, \'multiverseid\': 172626}, {\'name\': \'诱缚稻草人\', \'text\': \'于诱缚稻草人进场时，选择一种颜色。\\n当你未操控该色的永久物时，牺牲诱缚稻草人。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'此等无谓的追逐，若拿第一尽成空。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173228&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0327bdc8-106a-4d28-b175-4685603e508b\', \'multiverseId\': 173228}, \'multiverseid\': 173228}]', '[{\'name\': \'Gepanzerter Höhenflug\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält für jede Ebene, die du kontrollierst, +1/+1 und hat Flugfähigkeit.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Warum sollte man Federn verzaubern, damit sie stabil werden, wenn man auch Schilde verzaubern kann, so dass sie fliegen?" —Braenna, Flickschmiedin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174479&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'024ec5a2-1278-489f-a703-a37bad665995\', \'multiverseId\': 174479}, \'multiverseid\': 174479}, {\'name\': \'Ascenso acorazado\', \'text\': \'Encantar criatura.\\nLa criatura encantada obtiene +1/+1 por cada llanura que controles y tiene la habilidad de volar.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"¿Por qué encantar plumas para hacerlas más resistentes cuando podemos encantar escudos para hacerlos volar?" —Braenna, artesana remendona\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172673&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aa0d1a5e-e12f-459d-a6b2-79ef01096514\', \'multiverseId\': 172673}, \'multiverseid\': 172673}, {\'name\': \'Ascension cuirassée\', \'text\': \'Enchanter : créature\\nLa créature enchantée gagne +1/+1 pour chaque plaine que vous contrôlez et elle a le vol.\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Pourquoi enchanter des plumes pour les renforcer quand on peut faire voler des boucliers ? » —Braenna, ravaudeuse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173275&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3b61452-0c5d-4f8d-a995-ad3b0a6a4b3e\', \'multiverseId\': 173275}, \'multiverseid\': 173275}, {\'name\': \'Ascensione Corazzata\', \'text\': \'Incanta creatura\\nLa creatura incantata prende +1/+1 per ogni Pianura che controlli e ha volare.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Perché incantare le piume per renderle più resistenti quando possiamo incantare gli scudi e farli volare?" —Braenna, rattoppatrice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173576&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3ea54d09-a464-4225-b9b1-ff18d04f7cf5\', \'multiverseId\': 173576}, \'multiverseid\': 173576}, {\'name\': \'鎧をまとった上昇\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、あなたがコントロールする平地１つにつき＋１/＋１の修整を受けるとともに飛行を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「盾に魔法をかけて飛ばすことができるなら、羽に魔法をかけて頑丈にすることはないでしょう？」 ――纏め鍛治のブラエナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173877&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad4b695a-5430-43cd-b1e9-4614b9304e3c\', \'multiverseId\': 173877}, \'multiverseid\': 173877}, {\'name\': \'Ascensão Armada\', \'text\': \'Encantar criatura\\nA criatura encantada recebe +1/+1 para cada Planície que você controla e tem voar.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Por que encantar penas para torná-las resistentes quando podemos encantar escudos para fazê-los voar?" — Braenna, espantalheira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172071&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'59a37885-2a3d-465c-bf94-4b2323374810\', \'multiverseId\': 172071}, \'multiverseid\': 172071}, {\'name\': \'Вознесение в Доспехах\', \'text\': \'Зачаровать существо\\nЗачарованное существо получает +1/+1 за каждую Равнину под вашим контролем и имеет Полет.\', \'type\': \'Чары — Аура\', \'flavor\': \'«Зачем зачаровывать перья и делать их жестче, когда можно зачаровать щиты и заставить их летать?» — Браенна, мастерица пугал\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172372&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a2b90a0e-bef4-4259-b3f8-56aa301a68be\', \'multiverseId\': 172372}, \'multiverseid\': 172372}, {\'name\': \'武装飞腾\', \'text\': \'生物结界\\n你每操控一个平原，受此结界的生物便得+1/+1且具有飞行异能。\', \'type\': \'结界～灵气\', \'flavor\': \'「既然我们能缄咒让盾牌飞起来，又何必要缄咒让羽毛变得坚固？」 ～工匠布列娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172974&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'04c51d4a-2f0f-42d0-bafd-97c0e473f694\', \'multiverseId\': 172974}, \'multiverseid\': 172974}]', '[{\'name\': \'Gesegneter Rindenmantel\', \'text\': \'Eine Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere den Zauberspruch; du kannst für die Kopie ein neues Ziel bestimmen.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174701&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cf8c6fe1-a4c6-4836-b792-38fa49e43548\', \'multiverseId\': 174701}, \'multiverseid\': 174701}, {\'name\': \'Bendición de cubrecorteza\', \'text\': \'La criatura objetivo obtiene +2/+2 hasta el final del turno.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo y puedes elegir un nuevo objetivo para la copia.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172895&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'45c2b177-1577-4171-acc9-6fa52c55f049\', \'multiverseId\': 172895}, \'multiverseid\': 172895}, {\'name\': \'Bénédiction de coquécorce\', \'text\': "La créature ciblée gagne +2/+2 jusqu\'à la fin du tour.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le et vous pouvez choisir une nouvelle cible pour la copie.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173497&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d231ca95-fda0-4445-bd15-8428fa94cf2d\', \'multiverseId\': 173497}, \'multiverseid\': 173497}, {\'name\': \'Benedizione della Dura Corteccia\', \'text\': \'Una creatura bersaglio prende +2/+2 fino alla fine del turno.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia. Puoi scegliere un nuovo bersaglio per la copia.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173798&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3dc5423b-8145-433c-88dc-cb2ce3da9d8a\', \'multiverseId\': 173798}, \'multiverseid\': 173798}, {\'name\': \'樹皮殻の祝福\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで＋２/＋２の修整を受ける。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。あなたはそのコピーの新たな対象を選んでもよい。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174099&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'51153a71-7d93-45fa-aa94-4d5e94b1bc8d\', \'multiverseId\': 174099}, \'multiverseid\': 174099}, {\'name\': \'Bênção da Couraça Lenhosa\', \'text\': \'A criatura alvo recebe +2/+2 até o final do turno.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela e você poderá escolher um novo alvo para a cópia.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172293&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'107b11d1-2303-4785-ab92-37252a359d9c\', \'multiverseId\': 172293}, \'multiverseid\': 172293}, {\'name\': \'Благословение Коры\', \'text\': \'Целевое существо получает +2/+2 до конца хода.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его, и вы можете выбрать новую цель для этой копии.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172594&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c92fe299-240e-43ae-b453-27d913d2e301\', \'multiverseId\': 172594}, \'multiverseid\': 172594}, {\'name\': \'树皮甲加持\', \'text\': \'目标生物得+2/+2直到回合结束。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语，且你可以为该复制品选择新的目标。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173196&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'df5b626c-d037-4bed-a7e1-6adc59f0fbdb\', \'multiverseId\': 173196}, \'multiverseid\': 173196}]', '[{\'name\': \'Getöse der Feuerherde\', \'text\': \'Bringe einen 5/5 schwarzen und roten Elementarwesen-Kreaturenspielstein ins Spiel. Ein Gegner deiner Wahl opfert eine Kreatur für jede schwarze Kreatur, die du kontrollierst, und opfert dann ein Land für jede rote Kreatur, die du kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'Rache auf viel zu vielen Beinen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174661&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'78155e1b-526c-46c7-a041-4f468e1eff76\', \'multiverseId\': 174661}, \'multiverseid\': 174661}, {\'name\': \'Estrépito de la horda de fuego\', \'text\': \'Pon en juego una ficha de criatura Elemental negra y roja 5/5. El oponente objetivo sacrifica una criatura por cada criatura negra que controlas, luego sacrifica una tierra por cada criatura roja que controlas.\', \'type\': \'Conjuro\', \'flavor\': \'La venganza en forma de estampida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172855&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec673682-8238-4c0c-94b5-224489f074d7\', \'multiverseId\': 172855}, \'multiverseid\': 172855}, {\'name\': \'Vacarme du troupeau de feu\', \'text\': "Mettez en jeu un jeton de créature 5/5 noire et rouge Élémental. L\'adversaire ciblé sacrifie une créature pour chaque créature noire que vous contrôlez, puis il sacrifie un terrain pour chaque créature rouge que vous contrôlez.", \'type\': \'Rituel\', \'flavor\': \'La vengeance au galop.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173457&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8af2e99c-3a0c-4476-9124-812380984e33\', \'multiverseId\': 173457}, \'multiverseid\': 173457}, {\'name\': \'Frastuono del Branco Infuocato\', \'text\': \'Metti in gioco una pedina creatura Elementale 5/5 rossa e nera. Un avversario bersaglio sacrifica una creatura per ogni creatura nera che controlli, poi sacrifica una terra per ogni creatura rossa che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'La vendetta sotto forma di un branco di bisonti in carica.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173758&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e4a200ef-3d47-468d-8a41-0c604185bdf2\', \'multiverseId\': 173758}, \'multiverseid\': 173758}, {\'name\': \'火群れのどよめき\', \'text\': \'対戦相手１人を対象とする。黒であり赤である５/５のエレメンタル・クリーチャー・トークンを１体場に出す。 そのプレイヤーは、あなたがコントロールする黒のクリーチャー１体につきクリーチャーを１体生け贄に捧げ、その後あなたがコントロールする赤のクリーチャー１体につき土地を１つ生け贄に捧げる。\', \'type\': \'ソーサリー\', \'flavor\': \'殺到する復讐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174059&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'39ae0016-a4eb-489e-b766-0fc48444e034\', \'multiverseId\': 174059}, \'multiverseid\': 174059}, {\'name\': \'Estrondo da Piromanada\', \'text\': \'Coloque em jogo uma ficha de criatura preta e vermelha 5/5 do tipo Elemental. O oponente alvo sacrifica uma criatura para cada criatura preta que você controla e então sacrifica um terreno para cada criatura vermelha que você controla.\', \'type\': \'Feitiço\', \'flavor\': \'Vingança em forma de estouro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172253&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'daf2532a-36fc-41ca-a267-2c12ea9958de\', \'multiverseId\': 172253}, \'multiverseid\': 172253}, {\'name\': \'Топот Огненного Стада\', \'text\': \'Положите в игру одну фишку существа 5/5 черный и красный Элементаль. Целевой оппонент приносит в жертву существо за каждое черное существо под вашим контролем, затем приносит в жертву землю за каждое красное существо под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'Месть в облике табуна.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172554&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'43e80878-daa3-4947-97b9-9370e9940903\', \'multiverseId\': 172554}, \'multiverseid\': 172554}, {\'name\': \'炎骏喧闹\', \'text\': \'将一个5/5，黑红双色的元素衍生物放置进场。 你每操控一个黑色生物，目标对手便牺牲一个生物，然后你每操控一个红色生物，该对手便牺牲一个地。\', \'type\': \'法术\', \'flavor\': \'复仇的狂奔形式。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173156&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'60712f6a-9617-4f5d-8572-1154c4b60db3\', \'multiverseId\': 173156}, \'multiverseid\': 173156}]', '[{\'name\': \'Gilblaub-Reiter\', \'text\': \'Wachsamkeit\', \'type\': \'Kreatur — Elf, Ritter\', \'flavor\': \'Jedem Elfen im Schattenmoor ist von Geburt an die schreckliche Bürde auferlegt, gegen die Hässlichkeit und die Dunkelheit zu kämpfen, auch wenn sie überall und scheinbar endlos sind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174721&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'be8232aa-fce7-47a5-bc7f-3a79e7414867\', \'multiverseId\': 174721}, \'multiverseid\': 174721}, {\'name\': \'Caballeros de Hojas Marchitas\', \'text\': \'Vigilancia.\', \'type\': \'Criatura — Caballero elfo\', \'flavor\': \'Todos los elfos de Páramo Sombrío tienen una obligación desde su nacimiento: combatir la oscuridad y la fealdad, incluso cuando éstas los rodean y no parecen tener fin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172915&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b086546c-1f56-45d3-b74c-67fea7a90319\', \'multiverseId\': 172915}, \'multiverseid\': 172915}, {\'name\': \'Cavaliers de Feuilleterne\', \'text\': \'Vigilance\', \'type\': \'Créature : elfe et chevalier\', \'flavor\': "Chaque elfe de Sombrelande se voit chargé d\'un terrible fardeau : lutter contre la laideur et les ténèbres, même si elles sont partout et apparemment sans fin.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173517&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cb266f3b-ca43-4e80-b750-e73b36209223\', \'multiverseId\': 173517}, \'multiverseid\': 173517}, {\'name\': \'Cavalieri di Foglia Secca\', \'text\': \'Cautela\', \'type\': \'Creatura — Cavaliere Elfo\', \'flavor\': "Ogni elfo della Landa Tenebrosa nasce con un terribile dovere da compiere: sconfiggere l\'oscurità e la bruttezza, anche se si trovano dappertutto e sembrano non finire mai.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173818&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'89fe8213-bb90-4278-806d-29c581cc4199\', \'multiverseId\': 173818}, \'multiverseid\': 173818}, {\'name\': \'萎れ葉の騎兵\', \'text\': \'警戒\', \'type\': \'クリーチャー — エルフ・騎士\', \'flavor\': \'シャドウムーアのエルフは生まれながらにひどい義務を負っている。醜悪さや闇に対して反撃することだ。たとえそれが満ち満ちていて、終わりが無い様に見えるとしても。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174119&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5683f94-b8ec-4cff-9ae4-3f9ad69f4359\', \'multiverseId\': 174119}, \'multiverseid\': 174119}, {\'name\': \'Cavaleiros de Folha Seca\', \'text\': \'Vigilância\', \'type\': \'Criatura — Elfo Cavaleiro\', \'flavor\': \'Cada elfo do Pântano Sombrio recebe, desde o nascimento, o fardo de uma terrível responsabilidade: a de lutar contra o horror e a escuridão, embora estejam por toda parte e pareçam não ter fim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172313&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'617911fd-4ee9-44c0-ab3c-c4ce2d19f7dd\', \'multiverseId\': 172313}, \'multiverseid\': 172313}, {\'name\': \'Всадники Темнолесья\', \'text\': \'Бдительность\', \'type\': \'Существо — Эльф Рыцарь\', \'flavor\': \'Каждому эльфу в Шэдоумуре с рождения дана тяжелейшая обязанность: бороться против уродства и темноты, какими бы безграничными они не казались.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172614&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c9209bc8-2310-48b4-9613-06efaebe1159\', \'multiverseId\': 172614}, \'multiverseid\': 172614}, {\'name\': \'枯叶骑兵\', \'text\': \'警戒\', \'type\': \'生物～地精／骑士\', \'flavor\': \'暗影荒原的每个地精从降生以来就背负着可怕的责任：挺身反抗丑恶与黑暗，即使它们无所不在，看似永无止境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173216&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9d14b2ff-2efa-4114-864b-3c02eb9bb93b\', \'multiverseId\': 173216}, \'multiverseid\': 173216}]', '[{\'name\': \'Glühender Sturm\', \'text\': \'Kreaturen, die ein Spieler deiner Wahl kontrolliert, können in diesem Zug nicht blocken. Der Glühende Sturm fügt jeder weißen und/oder blauen Kreatur, die jener Spieler kontrolliert, 1 Schadenspunkt zu.\', \'type\': \'Hexerei\', \'flavor\': \'„Der Wind war schrecklich. Er peitschte Funken in unsere Haut hinein und erhitzte sie immer weiter" —Bowen, Kapitän der Wache von Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174568&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2304e180-23ff-4c83-8928-979d926eb38a\', \'multiverseId\': 174568}, \'multiverseid\': 174568}, {\'name\': \'Vendaval de brasas\', \'text\': \'Las criaturas que controla el jugador objetivo no pueden bloquear este turno. El Vendaval de brasas hace 1 punto de daño a cada criatura blanca y/o azul que controla ese jugador.\', \'type\': \'Conjuro\', \'flavor\': \'"Un viento terrible. Nos golpeaba con chispas en la piel, ¡y luego las avivaba" —Bowen, capitán de la guardia de Bárrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172762&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01359f7c-3fa4-4ce0-ad4f-7bab11b17a71\', \'multiverseId\': 172762}, \'multiverseid\': 172762}, {\'name\': \'Bourrasque de braises\', \'text\': \'Les créatures que le joueur ciblé contrôle ne peuvent pas bloquer ce tour-ci. La Bourrasque de braises inflige 1 blessure à chaque créature blanche et/ou bleue que ce joueur contrôle.\', \'type\': \'Rituel\', \'flavor\': "« Un vent redoutable. Il nous criblait d\'étincelles qu\'il attisait pour graver notre peau de leur ardente brûlure » —Bowen, capitaine de la garde de Barrenton", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173364&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'09342220-69cb-4ad3-8078-3b1f687323e8\', \'multiverseId\': 173364}, \'multiverseid\': 173364}, {\'name\': \'Tempesta di Braci\', \'text\': \'Le creature controllate da un giocatore bersaglio non possono bloccare in questo turno. La Tempesta di Braci infligge 1 danno a ogni creatura bianca e/o blu controllata da quel giocatore.\', \'type\': \'Stregoneria\', \'flavor\': \'"Un vento tremendo. Sferzava scintille contro di noi, rendendole ancora più bollenti" —Bowen, capitano delle guardie di Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173665&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'943989f7-a78e-4b7d-b47c-b890981b6d81\', \'multiverseId\': 173665}, \'multiverseid\': 173665}, {\'name\': \'燃えさしの突風\', \'text\': \'プレイヤー１人を対象とする。このターン、そのプレイヤーがコントロールするクリーチャーではブロックできない。 燃えさしの突風はそのプレイヤーがコントロールする白か青の各クリーチャーに、それぞれ１点のダメージを与える。\', \'type\': \'ソーサリー\', \'flavor\': \'「ひどい風だな。 我々の皮膚を叩いて火花を起こし、それを焚き付けてさらに熱くするんだからな！」 ――バレントンの護衛長、ボウエン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173966&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5602bbb7-ae9a-4c99-a432-116aa9d01dc1\', \'multiverseId\': 173966}, \'multiverseid\': 173966}, {\'name\': \'Ventania Incandescente\', \'text\': \'As criaturas que o jogador alvo controla não podem bloquear neste turno. Ventania Incandescente causa 1 ponto de dano a cada criatura branca e/ou azul que aquele jogador controla.\', \'type\': \'Feitiço\', \'flavor\': \'"Um vento terrível que fustigava nossa pele com centelhas e então as atiçava para que ardessem com mais intensidade" — Bowen, capitão da guarda de Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172160&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2c8540ac-a521-4db3-b8a8-a5771e4ada86\', \'multiverseId\': 172160}, \'multiverseid\': 172160}, {\'name\': \'Угольный Буран\', \'text\': \'Существа под контролем целевого игрока не могут блокировать в этом ходу. Угольный Буран наносит 1 повреждение каждому белому и (или) синему существу под контролем того игрока.\', \'type\': \'Волшебство\', \'flavor\': \'«Ужасный ветер Сначала в кожу впились угольки, а следующий порыв разжег их еще сильнее» — Боуэн, командир стражников Баррентона\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172461&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a7d33021-0f80-40b7-9671-9d25b64b18d1\', \'multiverseId\': 172461}, \'multiverseid\': 172461}, {\'name\': \'烬风\', \'text\': \'由目标牌手操控的生物本回合不能进行阻挡。 烬风对由该牌手操控的每个白色和／或蓝色生物各造成1点伤害。\', \'type\': \'法术\', \'flavor\': \'「好恐怖的风势。 它把皮肤鞭打得有如火灼，还让势头越来越强。」 ～八连屯卫队长伯文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173063&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9afed574-cd12-44d2-bafb-9e95165f8288\', \'multiverseId\': 173063}, \'multiverseid\': 173063}]', '[{\'name\': \'Glühendes Dieflyn\', \'text\': \'Fliegend\\n{B/R}: Das Glühende Dieflyn erhält +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bold\', \'flavor\': \'Jeder Kithkinschmied würde um sein Leben gern ein Dieflyn für seinen Ofen haben, da er sich dann nie mehr um Brennstoff kümmern müsste.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174559&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'99c49e87-a875-49f5-be4c-d39aacde7f8b\', \'multiverseId\': 174559}, \'multiverseid\': 174559}, {\'name\': \'Dieflyn candente\', \'text\': \'Vuela.\\n{B/R}: El Dieflyn candente obtiene +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Diablillo\', \'flavor\': \'A cualquier herrero kithkin le encantaría atrapar un dieflyn para su horno, salvándole así tener que volver a buscar leña.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172753&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1e9e3766-8e55-4336-acbd-b3bce9c36e99\', \'multiverseId\': 172753}, \'multiverseid\': 172753}, {\'name\': \'Dieflyn incandescent\', \'text\': "Vol\\n{B/R} : Le Dieflyn incandescent gagne +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : diablotin\', \'flavor\': \'Les forgeronnes sangamies aimeraient toutes capturer un dieflyn dans leur four pour ne jamais plus avoir à alimenter le feu.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173355&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'10014172-5c56-4dff-9e67-2e9242f10afe\', \'multiverseId\': 173355}, \'multiverseid\': 173355}, {\'name\': \'Dieflyn Ribollente\', \'text\': \'Volare\\n{B/R}: Il Dieflyn Ribollente prende +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Imp\', \'flavor\': \'Ogni fabbro kithkin sogna di catturare un dieflyn per la propria fornace, per non dover mai più raccogliere del combustibile.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173656&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7b20a8e6-bf4c-4c3f-bb81-3555ee6e2447\', \'multiverseId\': 173656}, \'multiverseid\': 173656}, {\'name\': \'焦熱のダイフリン\', \'text\': \'飛行\\n{B/R}：焦熱のダイフリンはターン終了時まで＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — インプ\', \'flavor\': \'キスキンの鍛治なら誰でも、ダイフリンを捕まえて炉につなぎ、今後の燃料の心配を無くそうと考える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173957&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1ed78e73-54cf-4e3a-9df3-5fe027c5fedb\', \'multiverseId\': 173957}, \'multiverseid\': 173957}, {\'name\': \'Dieflyn Ardente\', \'text\': \'Voar\\n{B/R}: Dieflyn Ardente recebe +1/+0 até o final do turno.\', \'type\': \'Criatura — Diabrete\', \'flavor\': \'Qualquer ferreiro kithkin adoraria capturar um dieflyn para seu forno, pois assim nunca mais precisaria coletar combustível novamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172151&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4f5b1501-83be-4eb7-a49b-a724082d7bd8\', \'multiverseId\': 172151}, \'multiverseid\': 172151}, {\'name\': \'Обжигающий Дайфлин\', \'text\': \'Полет\\n{B/R}: Обжигающий Дайфлин получает +1/+0 до конца хода.\', \'type\': \'Существо — Бес\', \'flavor\': \'Любой кискен-кузнец был бы рад поймать дайфлина для своей печи, чтобы навсегда избавиться от необходимости собирать хворост.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172452&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'26863374-e562-4f5f-b5a5-2bd75e8348e7\', \'multiverseId\': 172452}, \'multiverseid\': 172452}, {\'name\': \'迅猛戴夫林\', \'text\': \'飞行\\n{B/R}：迅猛戴夫林得+1/+0直到回合结束。\', \'type\': \'生物～小恶魔\', \'flavor\': \'每位洁英铁匠都想抓个戴夫林放到炉子里，这样就不用再去找燃油了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173054&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aceb712a-a3f9-49e9-8d5d-fecebee6aae9\', \'multiverseId\': 173054}, \'multiverseid\': 173054}]', '[{\'name\': \'Gnadentod\', \'text\': \'Der Beherrscher einer Kreatur deiner Wahl opfert sie und bringt dann X 1/1 grüne und weiße (Elf, Krieger)-Kreaturenspielsteine ins Spiel, wobei X gleich der Stärke der Kreatur ist.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wir geben dir den Frieden, den du suchst, auch wenn du noch nicht weißt, dass du ihn suchst."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174708&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1531be63-b21f-4966-9fd5-37d70179e210\', \'multiverseId\': 174708}, \'multiverseid\': 174708}, {\'name\': \'Muerte piadosa\', \'text\': \'El controlador de la criatura objetivo la sacrifica, luego pone en juego X fichas de criatura Guerrero Elfo verdes y blancas 1/1, donde X es la fuerza de esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'"Te daremos la paz que buscas, aunque todavía no sepas que la buscas."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172902&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dcd4ad92-be40-41d8-894b-000ecd488d5a\', \'multiverseId\': 172902}, \'multiverseid\': 172902}, {\'name\': \'Euthanasie\', \'text\': \'Le contrôleur de la créature ciblée la sacrifie, puis il met en jeu X jetons de créature 1/1 verte et blanche Elfe et Guerrier, X étant la force de cette créature.\', \'type\': \'Éphémère\', \'flavor\': \'« Nous vous donnerons la paix que vous cherchez, même si vous ignorez encore que vous la cherchez. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173504&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e1eb8a3e-a148-4738-87c0-f54b293dd476\', \'multiverseId\': 173504}, \'multiverseid\': 173504}, {\'name\': \'Uccisione Misericordiosa\', \'text\': \'Il controllore di una creatura bersaglio la sacrifica, poi mette in gioco X pedine creatura Guerriero Elfo 1/1 bianche e verdi, dove X è la forza di quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ti daremo la pace che stai cercando, anche se non ti sei ancora accorto di cercarla davvero."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173805&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8821c678-574c-4077-ae06-9417534f2daa\', \'multiverseId\': 173805}, \'multiverseid\': 173805}, {\'name\': \'安楽死\', \'text\': \'クリーチャー１体を対象とする。そのクリーチャーのコントローラーはそれを生け贄に捧げる。その後、緑であり白である１/１のエルフ・戦士・クリーチャー・トークンをＸ体場に出す。Ｘはそのクリーチャーのパワーに等しい。\', \'type\': \'インスタント\', \'flavor\': \'「お前が求めている平安を与えよう。もっとも、それを求めていることをまだ知りはしないだろうが。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174106&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'023c3b86-dff9-4fa5-ac8c-6d24dfee7125\', \'multiverseId\': 174106}, \'multiverseid\': 174106}, {\'name\': \'Assassinato por Misericórdia\', \'text\': \'O controlador da criatura alvo sacrifica-a e coloca em jogo X fichas de criatura verde e branca 1/1 do tipo Elfo Guerreiro, sendo X igual ao poder daquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Ele lhe dará a paz que procura, embora você possa ainda não saber que a procura."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172300&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd0b5e11-063b-4345-8749-aec94aa4f504\', \'multiverseId\': 172300}, \'multiverseid\': 172300}, {\'name\': \'Убийство из Сострадания\', \'text\': \'Игрок, контролирующий целевое существо, приносит его в жертву, затем кладет в игру X фишек существа 1/1 зеленый и белый Эльф Воин, где X значение силы того существа.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мы подарим вам мир, который вы стремитесь обрести, хотя, может быть, пока сами того не знаете».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172601&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93843b91-2417-4eb9-b487-cbd66bc5a586\', \'multiverseId\': 172601}, \'multiverseid\': 172601}, {\'name\': \'人道杀害\', \'text\': \'目标生物的操控者将它牺牲，然后将X个1/1，绿白双色的地精／战士衍生物放置进场，X为该生物的力量。\', \'type\': \'瞬间\', \'flavor\': \'「我们会带给你所寻求的平静，虽然你可能还不知道你在寻求它。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173203&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'deea86c9-3797-4e0c-a88e-ba0dc161f5d4\', \'multiverseId\': 173203}, \'multiverseid\': 173203}]', "[{'name': 'Goldglanzmotte', 'text': 'Fliegend\\nImmer wenn die Goldglanzmotte blockt, kannst du 4 Lebenspunkte dazuerhalten.', 'type': 'Kreatur — Insekt', 'flavor': 'Sie ist immer von gewöhnlichen Motten umgeben, die von ihrem Licht angezogen werden.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174483&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'ee0d628c-4b7a-4f93-9ded-275f22f89679', 'multiverseId': 174483}, 'multiverseid': 174483}, {'name': 'Polilla brillo dorado', 'text': 'Vuela.\\nSiempre que la Polilla brillo dorado bloquee, puedes ganar 4 vidas.', 'type': 'Criatura — Insecto', 'flavor': 'Las polillas comunes la siguen, atraídas por su luz.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172677&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0da1259e-e56a-45cc-a82f-2c1f605402fa', 'multiverseId': 172677}, 'multiverseid': 172677}, {'name': 'Phalène au halo doré', 'text': 'Vol\\nÀ chaque fois que la Phalène au halo doré bloque, vous pouvez gagner 4 points de vie.', 'type': 'Créature : insecte', 'flavor': 'Les papillons de nuit la suivent, attirés par sa lueur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173279&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ae565271-d503-45a6-95d8-272aa0930571', 'multiverseId': 173279}, 'multiverseid': 173279}, {'name': 'Falena Lucedorata', 'text': 'Volare\\nOgniqualvolta la Falena Lucedorata blocca, puoi guadagnare 4 punti vita.', 'type': 'Creatura — Insetto', 'flavor': 'Le comuni falene la seguono, attratte dalla sua luce.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173580&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c467be79-a4a4-4011-9383-6939b4b9554f', 'multiverseId': 173580}, 'multiverseid': 173580}, {'name': '黄金光の蛾', 'text': '飛行\\n黄金光の蛾がブロックするたび、あなたは４点のライフを得てもよい。', 'type': 'クリーチャー — 昆虫', 'flavor': '普通の蛾はその光に引かれて後を追う。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173881&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '93505028-17f9-44bb-9cfc-21aee074fe1a', 'multiverseId': 173881}, 'multiverseid': 173881}, {'name': 'Mariposa da Luz Dourada', 'text': 'Voar\\nToda vez que Mariposa da Luz Dourada bloqueia, você pode ganhar 4 pontos de vida.', 'type': 'Criatura — Inseto', 'flavor': 'As mariposas comuns a seguem, atraídas pela sua luz.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172075&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c51c2927-f6c4-4772-982a-f5d4ac8ae4e1', 'multiverseId': 172075}, 'multiverseid': 172075}, {'name': 'Золотистый Мотылек', 'text': 'Полет\\nКаждый раз, когда Золотистый Мотылек блокирует, вы можете получить 4 жизни.', 'type': 'Существо — Насекомое', 'flavor': 'Обычные мотыльки летят вслед за ним, влекомые его светом.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172376&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'a9d55983-2550-42a1-97f9-e5e8ecc0bfc1', 'multiverseId': 172376}, 'multiverseid': 172376}, {'name': '澄闪蛾', 'text': '飞行\\n每当澄闪蛾阻挡时，你可以获得4点生命', 'type': '生物～昆虫', 'flavor': '一般的蛾会受其光芒所吸引而随之飞翔。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172978&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '713aa682-2515-4f98-954d-c1548ee4dcad', 'multiverseId': 172978}, 'multiverseid': 172978}]", '[{\'name\': \'Gonds Ausstrahlung\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat „{T}: Bringe einen 1/1 grünen (Elf, Krieger)-Kreaturenspielstein ins Spiel."\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'„Hier liegt Gond, der Held der Trutzburg Taldwen. Möge seine Kraft immer bei uns sein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174602&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f3cf016-3ef2-41bf-a0b1-a97b04d3c4f9\', \'multiverseId\': 174602}, \'multiverseid\': 174602}, {\'name\': \'Presencia de Gond\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "{T}: Pon en juego una ficha de criatura Guerrero Elfo verde 1/1".\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'"Aquí yace Gond, héroe del refugio seguro Taldwen. Que siempre guíe nuestra búsqueda."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172796&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'384cf67b-dd86-4e91-b7bd-243b1baf5e57\', \'multiverseId\': 172796}, \'multiverseid\': 172796}, {\'name\': \'Présence de Gond\', \'text\': \'Enchanter : créature\\nLa créature enchantée a « {T} : Mettez en jeu un jeton de créature 1/1 verte Elfe et Guerrier. »\', \'type\': \'Enchantement : aura\', \'flavor\': \'« Ci-gît Gond, héros de la Ferté Taldwen. Puisse-t-il nous guider un jour dans notre quête. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173398&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9da0cc8b-6caa-413b-8301-ca9ac898060c\', \'multiverseId\': 173398}, \'multiverseid\': 173398}, {\'name\': \'Presenza di Gond\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "{T}: Metti in gioco una pedina creatura Guerriero Elfo 1/1 verde."\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'"Qui giace Gond, eroe del Fortincanto Taldwen. Possa egli guidare sempre la nostra missione."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173699&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2b03ace-f8c2-4a10-9d92-3a114dd7f794\', \'multiverseId\': 173699}, \'multiverseid\': 173699}, {\'name\': \'ゴンドの存在\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは「{T}：緑の１/１のエルフ・戦士・クリーチャー・トークンを１体場に出す。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'「トールドウェン安寧砦の英雄ゴンド、ここに眠る。 我等の試練に彼の守りあらんことを。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174000&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d361845a-d0ef-43e6-a959-060e990fee2a\', \'multiverseId\': 174000}, \'multiverseid\': 174000}, {\'name\': \'Presença de Gond\', \'text\': \'Encantar criatura\\nA criatura encantada tem "{T}: Coloque em jogo uma ficha de criatura verde 1/1 do tipo Elfo Guerreiro.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'"Aqui jaz Gond, herói do Refúgio Taldwen. Que ele guie sempre a nossa missão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172194&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e7e6f8af-5740-47c6-a039-cc04ac3cdccd\', \'multiverseId\': 172194}, \'multiverseid\': 172194}, {\'name\': \'Присутствие Гонда\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность: «{T}: положите в игру одну фишку существа 1/1 зеленый Эльф Воин».\', \'type\': \'Чары — Аура\', \'flavor\': \'«Здесь лежит Гонд, герой убежища Тальдвен. Пусть он всегда указывает нам дорогу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172495&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f559928c-c549-4960-8b2c-21633435126e\', \'multiverseId\': 172495}, \'multiverseid\': 172495}, {\'name\': \'刚德现身\', \'text\': \'生物结界\\n受此结界的生物具有「{T}：将一个1/1绿色的地精／战士衍生物放置进场。」\', \'type\': \'结界～灵气\', \'flavor\': \'「刚德，塔德温华域的英雄，在此长眠。 愿他永远领导我们的探索。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173097&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d9e00bcf-e240-4b70-8563-388c966cdaab\', \'multiverseId\': 173097}, \'multiverseid\': 173097}]', '[{\'name\': \'Gottheit der Ehrfurcht\', \'text\': \'Fliegend\\nAlle anderen Kreaturen sind 1/1.\', \'type\': \'Kreatur — Geist, Avatar\', \'flavor\': \'„Als sie sah, was auf der Welt herumkreuchte, schauderte es ihr. Und dennoch konnte sie ihren Blick nicht abwenden." —Die Parabeln der Seherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174619&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c28a2cc3-e5c0-416d-8a6e-fae277567919\', \'multiverseId\': 174619}, \'multiverseid\': 174619}, {\'name\': \'Deidad de la veneración\', \'text\': \'Vuela.\\nLas otras criaturas son 1/1.\', \'type\': \'Criatura — Espíritu avatar\', \'flavor\': \'"Lo que vio reptando sobre el mundo le repugnó. Pero no pudo apartar la mirada." —Las parábolas de la vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172813&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dff26519-5fa3-4670-a605-9acde2bd8191\', \'multiverseId\': 172813}, \'multiverseid\': 172813}, {\'name\': \'Divinité de respect\', \'text\': \'Vol\\nLes autres créatures sont 1/1.\', \'type\': \'Créature : esprit et avatar\', \'flavor\': "« Ce qu\'elle vit ramper sur ce monde l\'horrifia. Cependant, elle ne put détourner les yeux. » —Les paraboles de l\'Oracle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173415&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a8e5fced-e8d5-4595-9d4e-ab6dec74f3c2\', \'multiverseId\': 173415}, \'multiverseid\': 173415}, {\'name\': \'Divinità delle Meraviglie\', \'text\': \'Volare\\nLe altre creature sono 1/1.\', \'type\': \'Creatura — Spirito Avatar\', \'flavor\': \'"Ciò che vide in questo mondo la inorridì. Eppure non fu in grado di volgere altrove il suo sguardo." —Le Parabole della Veggente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173716&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'eda13520-817a-48f5-a9b7-9ef9235a3182\', \'multiverseId\': 173716}, \'multiverseid\': 173716}, {\'name\': \'畏敬の神格\', \'text\': \'飛行\\n他のクリーチャーは１/１である。\', \'type\': \'クリーチャー — スピリット・アバター\', \'flavor\': \'「彼女が世界の上に蠢いているものを見たとき、それは彼女を拒否した。 それでも彼女は視線をそらすことができなかった。」 ――「予見者の寓話」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174017&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'16515ff6-6446-4aa0-837c-b3cb38149991\', \'multiverseId\': 174017}, \'multiverseid\': 174017}, {\'name\': \'Divindade do Pavor\', \'text\': \'Voar\\nAs outras criaturas são 1/1.\', \'type\': \'Criatura — Espírito Avatar\', \'flavor\': \'"O que ela viu rastejando neste mundo a encheu de repulsa. No entanto, ela não conseguiu desviar o olhar." — Parábolas da Vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172211&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aea5f38f-271f-41a1-bc76-ea0c69a93b83\', \'multiverseId\': 172211}, \'multiverseid\': 172211}, {\'name\': \'Богиня Благоговения\', \'text\': \'Полет\\nДругие существа являются 1/1.\', \'type\': \'Существо — Дух Аватара\', \'flavor\': \'«Увидев подползающие к этому миру ужасы, она почувствовала отвращение. И все же она не могла отвести взгляд». — Притчи провидицы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172512&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'982e478c-dfb8-4004-84c3-1ddf62a6a9e5\', \'multiverseId\': 172512}, \'multiverseid\': 172512}, {\'name\': \'敬畏神性\', \'text\': \'飞行\\n其他生物均为1/1。\', \'type\': \'生物～精怪／圣者\', \'flavor\': \'「充斥这世上的东西令她反感。 但她又没法子不看。」 ～《预言师寓言》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173114&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5826ee1c-f243-4fed-85a1-7531dda9dcc7\', \'multiverseId\': 173114}, \'multiverseid\': 173114}]', '[{\'name\': \'Grausige Entdeckung\', \'text\': \'Ziehe zwei Karten und wirf dann eine Karte aus deiner Hand ab.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere ihn.)\', \'type\': \'Hexerei\', \'flavor\': \'Korrigan sind weibliche Brunnengeister. Wer sie beim Bade stört, muss sie innerhalb von drei Tagen heiraten — oder sterben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174516&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3176f5cf-4f74-4d2c-80a6-0ca9a44eae5a\', \'multiverseId\': 174516}, \'multiverseid\': 174516}, {\'name\': \'Descubrimiento espantoso\', \'text\': \'Roba dos cartas, luego descarta una carta.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo.)\', \'type\': \'Conjuro\', \'flavor\': \'Los korrigans, espíritus vinculados a fuentes de agua, gritan cuando se encuentran con sus propios cuerpos ahogados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172710&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2b37362b-6f55-4bb5-b33c-86e0555afb49\', \'multiverseId\': 172710}, \'multiverseid\': 172710}, {\'name\': \'Découverte abominable\', \'text\': "Piochez deux cartes, puis défaussez-vous d\'une carte.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le.)", \'type\': \'Rituel\', \'flavor\': \'Les korrigans, esprits liés aux sources, hurlent quand ils trouvent leurs propres cadavres noyés.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173312&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'170b37ab-7677-466e-b4aa-3167355b1f6d\', \'multiverseId\': 173312}, \'multiverseid\': 173312}, {\'name\': \'Scoperta Agghiacciante\', \'text\': \'Pesca due carte, poi scarta una carta.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia.)\', \'type\': \'Stregoneria\', \'flavor\': "Le korrigan, spiriti legati alle sorgenti d\'acqua, urlano quando si imbattono nei loro stessi corpi annegati.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173613&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb695db6-3f07-4327-b4fa-96963159e80d\', \'multiverseId\': 173613}, \'multiverseid\': 173613}, {\'name\': \'恐ろしい発見\', \'text\': \'カードを２枚引き、その後カードを１枚捨てる。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。）\', \'type\': \'ソーサリー\', \'flavor\': \'水に結び付けられた精霊であるコリガンは、自らの溺れた死体に出会うと金切り声を上げる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173914&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de926fdc-fef2-4e46-89c8-93da00bc2804\', \'multiverseId\': 173914}, \'multiverseid\': 173914}, {\'name\': \'Descoberta Cadavérica\', \'text\': \'Compre dois cards e depois descarte um card.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela.)\', \'type\': \'Feitiço\', \'flavor\': \'As korrigans, espíritos ligados a fontes de água, gritam quando se deparam com seus próprios corpos afogados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172108&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d6e47bfb-5959-439c-a0e6-6dec9d017478\', \'multiverseId\': 172108}, \'multiverseid\': 172108}, {\'name\': \'Страшная Находка\', \'text\': \'Возьмите две карты, затем сбросьте карту.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его.)\', \'type\': \'Волшебство\', \'flavor\': \'Корриганы духи, населяющие источники воды, пронзительно кричат, когда встречают свои собственные утопленные трупы.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172409&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c845dc9-247e-4cdf-a740-afd50e92c989\', \'multiverseId\': 172409}, \'multiverseid\': 172409}, {\'name\': \'恐怖发现\', \'text\': \'抓两张牌，然后弃一张牌。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语。）\', \'type\': \'法术\', \'flavor\': \'夜水妖是被水体所束缚的灵魂，碰上自己溺死的尸体时会惊恐尖叫。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173011&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'799e04d2-b7d8-4613-a64d-0ec381d76e13\', \'multiverseId\': 173011}, \'multiverseid\': 173011}]', '[{\'name\': \'Grimmiges Püppchen\', \'text\': \'Das Grimmige Püppchen kommt mit drei -1/-1-Marken ins Spiel.\\nEntferne eine -1/-1-Marke vom Grimmigen Püppchen: Lege eine -1/-1-Marke auf eine andere Kreatur deiner Wahl.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Hüte dich vor Vogelscheuchen, auch wenn sie dir Geschenke überreichen wollen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174729&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f7d38a1b-f688-4f3c-9cef-e4c798fb64f1\', \'multiverseId\': 174729}, \'multiverseid\': 174729}, {\'name\': \'Títere siniestro\', \'text\': \'El Títere siniestro entra en juego con tres contadores -1/-1 sobre él.\\nRemover un contador -1/-1 del Títere siniestro: Pon un contador -1/-1 sobre otra criatura objetivo.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'Ten cuidado de un espantapájaros que lleve regalos, especialmente si son frascos de ácido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172923&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'208d7516-a670-43a5-9d24-922c46bbb1a3\', \'multiverseId\': 172923}, \'multiverseid\': 172923}, {\'name\': \'Fantogre sinistre\', \'text\': \'Le Fantogre sinistre arrive en jeu avec trois marqueurs -1/-1 sur lui.\\nRetirez un marqueur -1/-1 du Fantogre sinistre : Mettez un marqueur -1/-1 sur une autre créature ciblée.\', \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "Méfie-toi de l\'épouvantail chargé de présents... surtout quand il porte des baquets d\'acide.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173525&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62779e59-1750-44d2-8c44-fa1761b791f6\', \'multiverseId\': 173525}, \'multiverseid\': 173525}, {\'name\': \'Burattino Sinistro\', \'text\': "Il Burattino Sinistro entra in gioco con tre segnalini -1/-1.\\nRimuovi un segnalino -1/-1 dal Burattino Sinistro: Metti un segnalino -1/-1 su un\'altra creatura bersaglio.", \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': "Diffida di uno spaventapasseri che porta doni: soprattutto se agita contenitori d\'acido.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173826&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'86cfae81-4616-450c-bbcf-91886d1ef6f1\', \'multiverseId\': 173826}, \'multiverseid\': 173826}, {\'name\': \'不気味な戯れ児\', \'text\': \'不気味な戯れ児は、－１/－１カウンターが３個置かれた状態で場に出る。\\n不気味な戯れ児から－１/－１カウンターを１個取り除く：他のクリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'贈り物を携えたカカシには気をつけろ――特に、酸の跳ねる器のやつには。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174127&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a2cb57b9-a230-4804-964e-c407c3252dc0\', \'multiverseId\': 174127}, \'multiverseid\': 174127}, {\'name\': \'Fantoche Sinistro\', \'text\': \'Fantoche Sinistro entra em jogo com três marcadores -1/-1.\\nRemova um marcador -1/-1 de Fantoche Sinistro: Coloque um marcador -1/-1 em outra criatura alvo.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'Tome cuidado com um espantalho oferecendo um brinde especialmente barris sacolejantes de ácido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172321&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'438b2dc7-8b1d-4037-b86f-97dc9339fa04\', \'multiverseId\': 172321}, \'multiverseid\': 172321}, {\'name\': \'Зловещая Марионетка\', \'text\': \'Зловещая Марионетка входит в игру с тремя жетонами -1/-1 на ней.\\nУдалите один жетон -1/-1 со Зловещей Марионетки: положите один жетон -1/-1 на другое целевое существо.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Бойся пугал, дары приносящих, особенно, если это бочонки с расплескивающейся кислотой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172622&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cbe01446-03c5-40b8-8bab-3a29f5f792a1\', \'multiverseId\': 172622}, \'multiverseid\': 172622}, {\'name\': \'残酷草人\', \'text\': \'残酷草人进场时上面有三个-1/-1指示物。\\n从残酷草人上移去一个-1/-1指示物：在另一个目标生物上放置一个-1/-1指示物。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'小心带着礼物的稻草人～尤其是会溅出酸液那种。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173224&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a46d4277-3828-4617-9ddf-d2c22725d2ce\', \'multiverseId\': 173224}, \'multiverseid\': 173224}]', '[{\'name\': \'Grünender Hauch\', \'text\': \'Eine Kreatur deiner Wahl wird grün und erhält +1/+0 bis zum Ende des Zuges.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Und im Hauch dieser Nacht sah der einst so schreckhafte Boggart, zu welch blutigen Taten er in der Lage war. Und er genoss es.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174609&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f647947a-5424-44c4-ba59-7764cf7bcd67\', \'multiverseId\': 174609}, \'multiverseid\': 174609}, {\'name\': \'Centellas verdosas\', \'text\': \'La criatura objetivo es verde y obtiene +1/+0 hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'El otrora tímido boggart vio en las centellas de esa noche todas las cosas terribles y sangrientas de las que era capaz. Y fue glorioso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172803&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fe6dd4bf-e373-4aee-bcb9-2d4d9530f942\', \'multiverseId\': 172803}, \'multiverseid\': 172803}, {\'name\': \'Feux viridescents\', \'text\': "La créature ciblée devient verte et gagne +1/+0 jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': "Cette nuit-là, dans les feux, le boggart autrefois timide vit toutes les horribles choses dont il était capable. Et c\'était une vision glorieuse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173405&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b48a0b3-92df-4848-9d17-f9642213cf50\', \'multiverseId\': 173405}, \'multiverseid\': 173405}, {\'name\': \'Fuochi Fatui Verdastri\', \'text\': \'Una creatura bersaglio diventa verde e prende +1/+0 fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Nei fuochi fatui di quella notte, il boggart un tempo timido intravide tutte le azioni sanguinarie di cui era capace. E ne rimase estasiato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173706&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'12f76127-bd81-4c46-9aa5-534ee6325050\', \'multiverseId\': 173706}, \'multiverseid\': 173706}, {\'name\': \'たなびく緑青\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで緑になるとともに＋１/＋０の修整を受ける。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'その夜の鬼火の中、臆病なボガートが目にしたのは、彼に感じることのできる精一杯の恐ろしく残酷なものだった。 そして、それはすばらしく愉快なことだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174007&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa697132-4d20-4d56-a4c1-342129b70fd0\', \'multiverseId\': 174007}, \'multiverseid\': 174007}, {\'name\': \'Fogos-Fátuos Verdejantes\', \'text\': \'A criatura alvo torna-se verde e recebe +1/+0 até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Nos fogos-fátuos daquela noite, o papão tímido de outrora viu todas as coisas terríveis e sanguinárias que era capaz de fazer. E ficou maravilhado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172201&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eb2f6fea-c57f-4a2e-a246-0a100f8afabc\', \'multiverseId\': 172201}, \'multiverseid\': 172201}, {\'name\': \'Зеленоватые Огоньки\', \'text\': \'Целевое существо становится зеленым и получает +1/+0 до конца хода.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Той ночью некогда робкий боггарт увидел в огоньках все кровавые злодеяния, на которые он был способен. И это было великолепно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172502&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7527834a-549b-4331-a3f4-48dc74f364c3\', \'multiverseId\': 172502}, \'multiverseid\': 172502}, {\'name\': \'碧绿鬼火\', \'text\': \'直到回合结束，目标生物成为绿色且得+1/+0。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'在那晚的鬼火中，一向胆小的波尬看到了自己能成就的所有恐怖、血腥事迹。 那看起来真是美好。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173104&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0ea2c2e6-34f2-4435-8e52-58755d2d5dbd\', \'multiverseId\': 173104}, \'multiverseid\': 173104}]', '[{\'name\': \'Gutturale Antwort\', \'text\': \'Neutralisiere einen blauen Spontanzauber deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'Wurz hatte einen Kampfschrei, der Stahl verbiegen, Auras zum Schmelzen bringen und Gegenzauber in Stücke schneiden konnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174685&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1580031e-774d-48e7-9079-3081581cb55b\', \'multiverseId\': 174685}, \'multiverseid\': 174685}, {\'name\': \'Respuesta gutural\', \'text\': \'Contrarresta el hechizo instantáneo azul objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'Mosto tenía un grito de batalla que podía quebrar el acero, fundir auras y partir contramagia a la mitad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172879&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'902ce5a4-e52c-4a30-bbf4-ebc1927dd539\', \'multiverseId\': 172879}, \'multiverseid\': 172879}, {\'name\': \'Réponse gutturale\', \'text\': "Contrecarrez le sort d\'éphémère bleu ciblé.", \'type\': \'Éphémère\', \'flavor\': "Le beuglement de raid de Moût était tel qu\'il brisait l\'acier, dissolvait les auras et tranchait les contresorts.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173481&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0e03fdd7-442b-41a5-bf14-814308db1c34\', \'multiverseId\': 173481}, \'multiverseid\': 173481}, {\'name\': \'Risposta Gutturale\', \'text\': \'Neutralizza una magia istantaneo blu bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': "Larva aveva un urlo da incursione che poteva spezzare l\'acciaio, sciogliere le aure e tagliare in due le contromagie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173782&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'006d51ba-4bd5-4379-9624-dee748da1951\', \'multiverseId\': 173782}, \'multiverseid\': 173782}, {\'name\': \'耳障りな反応\', \'text\': \'青のインスタント呪文１つを対象とし、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'汁婆の雄叫びは鋼を砕き、結界を溶かし、対抗呪文を切り刻む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174083&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eddb28ea-a061-4b8c-bed3-c9591178d6d3\', \'multiverseId\': 174083}, \'multiverseid\': 174083}, {\'name\': \'Resposta Gutural\', \'text\': \'Anule a mágica instantânea alvo azul.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Mosto tinha um grito de ataque que era capaz de estilhaçar o aço, derreter auras e partir contramágicas em duas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172277&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2135c075-f3f2-403b-98ac-521a5a09d5db\', \'multiverseId\': 172277}, \'multiverseid\': 172277}, {\'name\': \'Гортанный Отклик\', \'text\': \'Отмените целевое синее мгновенное заклинание.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'От разбойного рева мамаши Бражки крошилась сталь, плавились ауры, а встречные заклинания раскалывались надвое.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172578&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'004e3e1d-6575-4945-bc0a-ffa120e09e84\', \'multiverseId\': 172578}, \'multiverseid\': 172578}, {\'name\': \'喉音回应\', \'text\': \'反击目标蓝色瞬间咒语。\', \'type\': \'瞬间\', \'flavor\': \'麦汁的袭击战吼可以粉碎精钢，融解灵气，斩断反击法术。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173180&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'703ac38c-8a8d-4f68-8309-b426ad18568f\', \'multiverseId\': 173180}, \'multiverseid\': 173180}]', '[{\'name\': \'Halbgott der Rache\', \'text\': \'Fliegend, Eile\\nWenn du den Halbgott der Rache spielst, bringe alle Karten namens Halbgott der Rache aus deinem Friedhof ins Spiel zurück.\', \'type\': \'Kreatur — Geist, Avatar\', \'flavor\': \'„Sein bellendes, dröhnendes und tödliches Lachen zerfetzt den Himmel und bringt ihn zum Bluten." —Die Parabeln der Seherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174660&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f86dbdcc-8ae2-446e-94ca-9c1561203b86\', \'multiverseId\': 174660}, \'multiverseid\': 174660}, {\'name\': \'Semidios de la venganza\', \'text\': \'Vuela, prisa.\\nCuando juegues el Semidios de la venganza, regresa al juego todas las cartas llamadas Semidios de la venganza de tu cementerio.\', \'type\': \'Criatura — Espíritu avatar\', \'flavor\': \'"Su risa, una campanada mortal, parte los cielos, haciéndolos sangrar." —Las parábolas de la vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172854&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'418ecad6-4903-43fd-8591-e88a6fcd9390\', \'multiverseId\': 172854}, \'multiverseid\': 172854}, {\'name\': \'Demi-dieu de la revanche\', \'text\': \'Vol, célérité\\nQuand vous jouez le Demi-dieu de la revanche, renvoyez en jeu toutes les cartes appelées Demi-dieu de la revanche de votre cimetière.\', \'type\': \'Créature : esprit et avatar\', \'flavor\': "« Son rire, vacarme horrible, tranche les cieux pour les mettre à sang. » —Les paraboles de l\'Oracle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173456&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'76d775b2-8ab4-468a-95ba-d8ee7aa3fa7e\', \'multiverseId\': 173456}, \'multiverseid\': 173456}, {\'name\': \'Semidio della Vendetta\', \'text\': \'Volare, rapidità\\nQuando giochi il Semidio della Vendetta, rimetti in gioco tutte le carte con nome Semidio della Vendetta dal tuo cimitero.\', \'type\': \'Creatura — Spirito Avatar\', \'flavor\': \'"La sua risata, un belluino frastuono mortale, penetra nei cieli facendoli sanguinare." —Le Parabole della Veggente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173757&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e7c3a837-26cb-4060-898e-e5d806317b36\', \'multiverseId\': 173757}, \'multiverseid\': 173757}, {\'name\': \'復讐の亜神\', \'text\': \'飛行、速攻\\nあなたが復讐の亜神をプレイしたとき、あなたの墓地にある「復讐の亜神」という名前のカードをすべて場に戻す。\', \'type\': \'クリーチャー — スピリット・アバター\', \'flavor\': \'「彼は天を切り刻みながら、それが死人のような叫び声を上げて血を流すのを見て笑ったのだ。」 ――「予見者の寓話」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174058&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69e76ff0-9751-4db7-975c-1c5d661235db\', \'multiverseId\': 174058}, \'multiverseid\': 174058}, {\'name\': \'Semideus da Vingança\', \'text\': \'Voar, ímpeto\\nQuando você jogar Semideus da Vingança, devolva todos os cards com nome Semideus da Vingança do seu cemitério para o jogo.\', \'type\': \'Criatura — Espírito Avatar\', \'flavor\': \'"Seu riso, um ruído alto e mortal, retalha os céus, fazendo-os sangrar." — Parábolas da Vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172252&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'88c9932f-a075-44cd-93ae-08b06460812d\', \'multiverseId\': 172252}, \'multiverseid\': 172252}, {\'name\': \'Полубог Отмщения\', \'text\': \'Полет, Ускорение\\nКогда вы разыгрываете Полубога Отмщения, верните все карты с именем Полубог Отмщения из вашего кладбища в игру.\', \'type\': \'Существо — Дух Аватара\', \'flavor\': \'«Навевая смертельный ужас, громовые раскаты его хохота рассекают небеса и заставляют их истекать кровью». — Притчи провидицы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172553&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'01ba34b5-3fe7-403b-a6b6-279c5947dd42\', \'multiverseId\': 172553}, \'multiverseid\': 172553}, {\'name\': \'复仇半神\', \'text\': \'飞行，敏捷\\n当你使用复仇半神时，将你坟墓场中所有名称为复仇半神的牌返回场上。\', \'type\': \'生物～精怪／圣者\', \'flavor\': \'「他笑声如狂嚎般喧嚣，从天际横扫而过，留下长长血痕。」 ～《预言师寓言》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173155&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7f45788-12ec-4845-9837-a150ad2d3829\', \'multiverseId\': 173155}, \'multiverseid\': 173155}]', '[{\'name\': \'Harpunenkämpfer aus Kinscaer\', \'text\': \'Fliegend\\nImmer wenn der Harpunenkämpfer aus Kinscaer angreift, kannst du eine Kreatur deiner Wahl bis zum Ende des Zuges ihre Flugfähigkeit verlieren lassen.\', \'type\': \'Kreatur — Kithkin, Soldat\', \'flavor\': \'Die argwöhnischen Kithkin von Kinscaer überwachen die Lüfte und halten nach den Umrissen von Fremden Ausschau.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174518&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'502b1c11-7e96-42cb-9f11-8a44064e7281\', \'multiverseId\': 174518}, \'multiverseid\': 174518}, {\'name\': \'Arponero de Kinscaer\', \'text\': \'Vuela.\\nSiempre que el Arponero de Kinscaer ataque, puedes hacer que la criatura objetivo pierda la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Soldado kithkin\', \'flavor\': \'Los sospechosos kithkin de Kinscaer patrullan el cielo, con los ojos muy atentos a las siluetas de extranjeros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172712&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bcb21bfb-2a67-448f-9726-816b9b53b216\', \'multiverseId\': 172712}, \'multiverseid\': 172712}, {\'name\': \'Harponneur de Kinscaër\', \'text\': "Vol\\nÀ chaque fois que le Harponneur de Kinscaër attaque, vous pouvez faire que la créature ciblée perde le vol jusqu\'à la fin du tour.", \'type\': \'Créature : sangami et soldat\', \'flavor\': \'Les sangamis paranoïaques de Kinscaër patrouillent les cieux, leurs yeux entraînés à reconnaître la forme des étrangers.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173314&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6a004e18-152c-4d8c-af67-85a1b63533f5\', \'multiverseId\': 173314}, \'multiverseid\': 173314}, {\'name\': \'Fiociniere di Kinscaer\', \'text\': \'Volare\\nOgniqualvolta il Fiociniere di Kinscaer attacca, puoi fare perdere volare a una creatura bersaglio fino alla fine del turno.\', \'type\': \'Creatura — Soldato Kithkin\', \'flavor\': \'I sospettosi kithkin di Kinscaer pattugliano il cielo, focalizzando i loro sguardi sulle forme degli stranieri.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173615&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9147b50b-fa72-42d2-a363-6973749d27c0\', \'multiverseId\': 173615}, \'multiverseid\': 173615}, {\'name\': \'キンザーの銛打ち\', \'text\': \'飛行\\nキンザーの銛打ちが攻撃するたび、クリーチャー１体を対象とする。あなたは「それはターン終了時まで飛行を失う。」を選んでもよい。\', \'type\': \'クリーチャー — キスキン・兵士\', \'flavor\': \'空を見回るキンザーの疑り深いキスキンの目は、よそ者の姿を見分けるのに特化している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173916&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'24b0e3e1-358b-4159-941c-4fa946b4504b\', \'multiverseId\': 173916}, \'multiverseid\': 173916}, {\'name\': \'Arpoeiro de Kinscaer\', \'text\': \'Voar\\nToda vez que Arpoeiro de Kinscaer ataca, você pode fazer com que a criatura alvo perca voar até o final do turno.\', \'type\': \'Criatura — Kithkin Soldado\', \'flavor\': \'Os kithkin desconfiados de Kinscaer patrulham os céus com olhos aguçados em busca de forasteiros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172110&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd303d2a-2cd9-4e88-9f24-93baa1fbfd0c\', \'multiverseId\': 172110}, \'multiverseid\': 172110}, {\'name\': \'Гарпунщик из Кинсара\', \'text\': \'Полет\\nКаждый раз, когда Гарпунщик из Кинсара атакует, вы можете лишить целевое существо способности Полета до конца хода.\', \'type\': \'Существо — Кискен Солдат\', \'flavor\': \'Недоверчивые кискены из Кинсара облетают дозором небесные выси, зорко высматривая очертания незнакомцев.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172411&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ad364551-b2f3-49bf-a4cc-ff2ad9868af3\', \'multiverseId\': 172411}, \'multiverseid\': 172411}, {\'name\': \'英刹园鱼叉手\', \'text\': \'飞行\\n每当英刹园鱼叉手攻击时，你可以让目标生物失去飞行异能直到回合结束。\', \'type\': \'生物～洁英／士兵\', \'flavor\': \'英刹园多疑的洁英在空中巡逻，双眼留意着外来者踪影。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173013&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'de92be74-7cfb-4789-a18a-2ba8707338d2\', \'multiverseId\': 173013}, \'multiverseid\': 173013}]', "[{'name': 'Harztropfen-Wald', 'text': '({T}: Erhöhe deinen Manavorrat um {G}.)\\nDer Harztropfen-Wald kommt getappt ins Spiel.\\n{G}, {T}: Du erhältst 1 Lebenspunkt dazu. Spiele diese Fähigkeit nur, falls du zwei oder mehr grüne bleibende Karten kontrollierst.', 'type': 'Land — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174756&type=card', 'language': 'German', 'identifiers': {'scryfallId': '267e6cbf-e362-40c7-bc6c-ee6c42ca801e', 'multiverseId': 174756}, 'multiverseid': 174756}, {'name': 'Bosque savia rezumada', 'text': '({T}: Agrega {G} a tu reserva de maná.)\\nEl Bosque savia rezumada entra en juego girado.\\n{G}, {T}: Ganas una vida. Juega esta habilidad sólo si controlas dos o más permanentes verdes.', 'type': 'Tierra — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172950&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b9cf8215-a9d3-4af3-befa-9ed81d84a747', 'multiverseId': 172950}, 'multiverseid': 172950}, {'name': 'Forêt de Suintesève', 'text': '({T} : Ajoutez {G} à votre réserve.)\\nLa Forêt de Suintesève arrive en jeu engagée.\\n{G}, {T} : Vous gagnez 1 point de vie. Ne jouez cette capacité que si vous contrôlez au moins deux permanents verts.', 'type': 'Terrain : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173552&type=card', 'language': 'French', 'identifiers': {'scryfallId': '49049c25-100d-4d79-b7e6-4ecb21ff96a4', 'multiverseId': 173552}, 'multiverseid': 173552}, {'name': 'Bosco della Linfa Gocciolante', 'text': '({T}: Aggiungi {G} alla tua riserva di mana.)\\nIl Bosco della Linfa Gocciolante entra in gioco TAPpato.\\n{G}, {T}: Guadagni 1 punto vita. Gioca questa abilità solo se controlli due o più permanenti verdi.', 'type': 'Terra — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173853&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9741cf94-e7bf-4ec9-80b0-4de3612b7a43', 'multiverseId': 173853}, 'multiverseid': 173853}, {'name': '樹液染みの森', 'text': '（{T}：あなたのマナプールに{G}を加える。）\\n樹液染みの森はタップ状態で場に出る。\\n{G}, {T}：あなたは１点のライフを得る。 この能力は、あなたが２つ以上の緑のパーマネントをコントロールしている場合にのみプレイできる。', 'type': '土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174154&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '818cfac2-c72b-4be9-9b26-05ad029c0377', 'multiverseId': 174154}, 'multiverseid': 174154}, {'name': 'Floresta da Seiva Gotejante', 'text': '({T}: Adicione {G} à sua reserva de mana.)\\nFloresta da Seiva Gotejante entra em jogo virado.\\n{G}, {T}: Você ganha 1 ponto de vida. Jogue esta habilidade somente se você controlar duas ou mais permanentes verdes.', 'type': 'Terreno — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172348&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f715091e-3675-4423-a2fe-52f04d869907', 'multiverseId': 172348}, 'multiverseid': 172348}, {'name': 'Лес Светящейся Смолы', 'text': '({T}: добавьте {G} в ваше хранилище маны.)\\nЛес Светящейся Смолы входит в игру повернутым.\\n{G}, {T}: вы получаете 1 жизнь. Разыгрывайте эту способность, только если вы контролируете два или более зеленых перманента.', 'type': 'Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172649&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0c2d8a63-5865-4735-a849-d3e2b5b97713', 'multiverseId': 172649}, 'multiverseid': 172649}, {'name': '渗汁树林', 'text': '（{T}：加{G}到你的法术力池中。）\\n渗汁树林须横置进场。\\n{G}，{T}：你获得1点生命。 你只可以于你操控两个或更多绿色永久物时使用此异能。', 'type': '地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173251&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '971b1cdc-6b61-4584-91c2-4acbd2d8e862', 'multiverseId': 173251}, 'multiverseid': 173251}]", '[{\'name\': \'Helm des Schauderfürsten\', \'text\': \'Kreaturenverzauberung\\nSolange die verzauberte Kreatur blau ist, erhält sie +1/+1 und hat „Immer wenn diese Kreatur einem Gegner Schaden zufügt, ziehe eine Karte".\\nSolange die verzauberte Kreatur schwarz ist, erhält sie +1/+1 und hat „Immer wenn diese Kreatur einem Gegner Schaden zufügt, wirft dieser Gegner eine Karte aus seiner Hand ab".\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174643&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dbbc3ff1-31e1-4263-a36a-76de3d37f15c\', \'multiverseId\': 174643}, \'multiverseid\': 174643}, {\'name\': \'Yelmo del Señor espectral\', \'text\': \'Encantar criatura.\\nMientras la criatura encantada sea azul, obtiene +1/+1 y tiene "Siempre que esta criatura haga daño a un oponente, roba una carta".\\nMientras la criatura encantada sea negra, obtiene +1/+1 y tiene "Siempre que esta criatura haga daño a un oponente, ese jugador descarta una carta".\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172837&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2ae480d8-f680-48b9-8744-4a1a6e46a129\', \'multiverseId\': 172837}, \'multiverseid\': 172837}, {\'name\': \'Casque du Seigneur pâle\', \'text\': "Enchanter : créature\\nTant que la créature enchantée est bleue, elle gagne +1/+1 et elle a « À chaque fois que cette créature inflige des blessures à un adversaire, piochez une carte. »\\nTant que la créature enchantée est noire, elle gagne +1/+1 et elle a « À chaque fois que cette créature inflige des blessures à un adversaire, ce joueur se défausse d\'une carte. »", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173439&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'aaaf8785-2912-4656-922b-7fd862524f4b\', \'multiverseId\': 173439}, \'multiverseid\': 173439}, {\'name\': \'Elmo del Tetro Signore\', \'text\': \'Incanta creatura\\nFintanto che la creatura incantata è blu, prende +1/+1 e ha "Ogniqualvolta questa creatura infligge danno a un avversario, pesca una carta."\\nFintanto che la creatura incantata è nera, prende +1/+1 e ha "Ogniqualvolta questa creatura infligge danno a un avversario, quel giocatore scarta una carta."\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173740&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77e4835d-d375-4b90-9bfc-041d0a3f18c5\', \'multiverseId\': 173740}, \'multiverseid\': 173740}, {\'name\': \'恐君主の兜\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーが青であるかぎり、それは＋１/＋１の修整を受けるとともに「このクリーチャーがいずれかの対戦相手にダメージを与えるたび、カードを１枚引く。」を持つ。\\nエンチャントされているクリーチャーが黒であるかぎり、それは＋１/＋１の修整を受けるとともに「このクリーチャーがいずれかの対戦相手にダメージを与えるたび、そのプレイヤーはカードを１枚捨てる。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174041&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ada4816c-178e-47ec-bfee-feba124f2221\', \'multiverseId\': 174041}, \'multiverseid\': 174041}, {\'name\': \'Elmo do Lorde Fantasmal\', \'text\': \'Encantar criatura\\nEnquanto a criatura encantada for azul, ela receberá +1/+1 e terá "Toda vez que esta criatura causar dano a um oponente, compre um card."\\nEnquanto a criatura encantada for preta, ela receberá +1/+1 e terá "Toda vez que esta criatura causar dano a um oponente, aquele jogador descartará um card."\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172235&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d36fcb53-9da4-4483-91aa-f2de8d934260\', \'multiverseId\': 172235}, \'multiverseid\': 172235}, {\'name\': \'Кормило Владыки\', \'text\': \'Зачаровать существо\\nПока зачарованное существо синее, оно получает +1/+1 и имеет способность «Каждый раз, когда это существо наносит повреждения оппоненту, возьмите карту».\\nПока зачарованное существо черное, оно получает +1/+1 и имеет способность «Каждый раз, когда это существо наносит повреждения оппоненту, тот игрок сбрасывает карту».\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172536&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d8263626-5ade-407e-a7f4-202891518609\', \'multiverseId\': 172536}, \'multiverseid\': 172536}, {\'name\': \'惧侯头盔\', \'text\': \'生物结界\\n只要受此结界的生物是蓝色，它便得+1/+1且具有「每当此生物向对手造成伤害时，抓一张牌。」\\n只要受此结界的生物是黑色，它便得+1/+1且具有「每当此生物向对手造成伤害时，该牌手弃一张牌。」\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173138&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cb1b6772-abe5-433e-9f93-c6cc2515fda7\', \'multiverseId\': 173138}, \'multiverseid\': 173138}]', '[{\'name\': \'Herzenflicker\', \'text\': \'Entferne zu Beginn deines Versorgungssegments eine -1/-1-Marke von jeder Kreatur, die du kontrollierst.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174705&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ea49c9d5-bec9-4b3e-b752-2d8943d8fa42\', \'multiverseId\': 174705}, \'multiverseid\': 174705}, {\'name\': \'Reparacorazón\', \'text\': \'Al comienzo de tu mantenimiento, remueve un contador -1/-1 de cada criatura que controles.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172899&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fde167b0-f0e1-4d18-9b98-4da9ebb85a9b\', \'multiverseId\': 172899}, \'multiverseid\': 172899}, {\'name\': \'Guéricœur\', \'text\': "Au début de votre entretien, retirez un marqueur -1/-1 de chaque créature que vous contrôlez.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : élémental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173501&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b0196d05-eb3c-4a41-8581-51fe4929a67f\', \'multiverseId\': 173501}, \'multiverseid\': 173501}, {\'name\': \'Salvacuori\', \'text\': "All\'inizio del tuo mantenimento, rimuovi un segnalino -1/-1 da ogni creatura che controlli.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)", \'type\': \'Creatura — Elementale\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173802&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7377a29f-357a-4538-961b-b7faf9b3fa7d\', \'multiverseId\': 173802}, \'multiverseid\': 173802}, {\'name\': \'心臓癒し\', \'text\': \'あなたのアップキープの開始時に、あなたがコントロールする各クリーチャーから、それぞれ－１/－１カウンターを１個取り除く。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174103&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'423f837d-1bbe-4c18-aa72-8c5cccec455a\', \'multiverseId\': 174103}, \'multiverseid\': 174103}, {\'name\': \'Curandeiro do Coração\', \'text\': \'No início de sua manutenção, remova um marcador -1/-1 de cada criatura que você controla.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Elemental\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172297&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'48c3f4df-3107-42b9-952d-a213da4ed7f6\', \'multiverseId\': 172297}, \'multiverseid\': 172297}, {\'name\': \'Исцелитель Сердец\', \'text\': \'В начале вашего шага поддержки удалите один жетон -1/-1 с каждого существа под вашим контролем.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Элементаль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172598&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'81404d54-9d22-479b-8bcc-0c98cc70fd38\', \'multiverseId\': 172598}, \'multiverseid\': 172598}, {\'name\': \'愈心灵\', \'text\': \'在你的维持开始时，从每个由你操控的生物上移去一个-1/-1指示物。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～元素\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173200&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'adf7732e-9d96-47b1-ab33-68aa7557902e\', \'multiverseId\': 173200}, \'multiverseid\': 173200}]', "[{'name': 'Hetzjagd der Riesen', 'text': 'Bringe einen 4/4 roten und grünen (Riese, Krieger)-Kreaturenspielstein mit Eile ins Spiel. Entferne ihn am Ende des Zuges ganz aus dem Spiel.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere ihn.)', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174684&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4e895188-f7d1-4e62-802c-14590e736737', 'multiverseId': 174684}, 'multiverseid': 174684}, {'name': 'Carnada para gigantes', 'text': 'Pon en juego una ficha de criatura Guerrero Gigante verde y roja 4/4 con la habilidad de prisa. Remuévela del juego al final del turno.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo.)', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172878&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a6eb2ec6-e714-4726-bacf-fa12ec203dda', 'multiverseId': 172878}, 'multiverseid': 172878}, {'name': 'Appât à géant', 'text': 'Mettez en jeu un jeton de créature 4/4 rouge et verte Géant et Guerrier avec la célérité. Retirez-le de la partie à la fin du tour.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le.)', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173480&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'db24fa46-10d2-4fcf-b6b3-430b8ce24a5b', 'multiverseId': 173480}, 'multiverseid': 173480}, {'name': 'Esca dei Giganti', 'text': 'Metti in gioco una pedina creatura Guerriero Gigante 4/4 rossa e verde con rapidità. Rimuovila dal gioco alla fine del turno.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia.)', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173781&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '48177031-9d4d-4b27-85cd-868a9ac2972a', 'multiverseId': 173781}, 'multiverseid': 173781}, {'name': '巨人釣り', 'text': '速攻を持つ赤であり緑である４/４の巨人・戦士・クリーチャー・トークンを１体場に出す。 ターン終了時に、それをゲームから取り除く。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。）', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174082&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '2cce618a-1e93-43c4-80d4-b5862f71b029', 'multiverseId': 174082}, 'multiverseid': 174082}, {'name': 'Isca de Gigante', 'text': 'Coloque em jogo uma ficha de criatura vermelha e verde 4/4 do tipo Gigante Guerreiro com ímpeto. Remova-a do jogo no final do turno.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela.)', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172276&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b3b3d93d-ceed-4fd0-9754-d9f19d76cecd', 'multiverseId': 172276}, 'multiverseid': 172276}, {'name': 'Приманивание Гиганта', 'text': 'Положите в игру одну фишку существа 4/4 красный и зеленый Гигант Воин с Ускорением. Удалите ее из игры в конце хода.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его.)', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172577&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'bcc9b7a4-21d9-4763-8951-9181b13afca2', 'multiverseId': 172577}, 'multiverseid': 172577}, {'name': '饵诱巨人', 'text': '将一个4/4，红绿双色，具敏捷异能的巨人／战士衍生物放置进场。 在回合结束时将它移出对战。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语。）', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173179&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5e833510-bc49-4d2e-b37e-acbd9bc59d48', 'multiverseId': 173179}, 'multiverseid': 173179}]", "[{'name': 'Heulen des Nachtrudels', 'text': 'Bringe für jeden Wald, den du kontrollierst, einen 2/2 grünen Wolf-Kreaturenspielstein ins Spiel.', 'type': 'Hexerei', 'flavor': 'Das Rabenrevier ist für seine mörderischen Schrecken berüchtigt, aber selbst hier wird alles ruhig, wenn die Nachtwölfe heulen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174596&type=card', 'language': 'German', 'identifiers': {'scryfallId': '33a713b1-96e8-40e7-95ed-ac2acaae5211', 'multiverseId': 174596}, 'multiverseid': 174596}, {'name': 'Aullido de la manada nocturna', 'text': 'Pon en juego una ficha de criatura Lobo verde 2/2 por cada bosque que controles.', 'type': 'Conjuro', 'flavor': 'Los horrores de Coto de Cuervos son legendarios, pero incluso ese lugar embrujado calla cuando aúllan los lobos nocturnos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172790&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1cb4dffc-a335-4016-a3a3-a600247c2242', 'multiverseId': 172790}, 'multiverseid': 172790}, {'name': 'Hurlement de la meute nocturne', 'text': 'Mettez en jeu un jeton de créature 2/2 verte Loup pour chaque forêt que vous contrôlez.', 'type': 'Rituel', 'flavor': 'Les horreurs meurtrières de la Garenne du Corbeau sont légendaires, mais même ce lieu hanté se tait quand les loups nocturnes commencent à hurler.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173392&type=card', 'language': 'French', 'identifiers': {'scryfallId': '29492ad8-1d3c-4d7a-8cbd-685138dce1e2', 'multiverseId': 173392}, 'multiverseid': 173392}, {'name': 'Ululato del Branco Notturno', 'text': 'Metti in gioco una pedina creatura Lupo 2/2 verde per ogni Foresta che controlli.', 'type': 'Stregoneria', 'flavor': 'Gli orrori omicida di Volo del Corvo sono leggendari, ma anche questo posto infestato si acquieta quando ululano i lupi notturni.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173693&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2929093c-4567-45e2-a010-9e481bd46000', 'multiverseId': 173693}, 'multiverseid': 173693}, {'name': '夜の群れの雄叫び', 'text': 'あなたがコントロールする森１つにつき、緑の２/２の狼・クリーチャー・トークンを１体場に出す。', 'type': 'ソーサリー', 'flavor': 'レイヴンの地は、そのおぞましい恐怖で伝説となっているが、そんな呪われた場所でも夜狼の吠える時には静かになる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173994&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '60cd72a0-923f-46e6-9fe9-37c83d50ee2f', 'multiverseId': 173994}, 'multiverseid': 173994}, {'name': 'Uivo da Matilha Noturna', 'text': 'Coloque em jogo uma ficha de criatura verde 2/2 do tipo Lobo para cada Floresta que você controla.', 'type': 'Feitiço', 'flavor': 'Os horrores assassinos da Toca do Corvo são lendários, mas até mesmo esse lugar assombrado fica em silêncio quando os lobos noturnos uivam.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172188&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd258f44f-c9f0-4d08-9fd0-17e4f33ea44f', 'multiverseId': 172188}, 'multiverseid': 172188}, {'name': 'Вой Ночной Стаи', 'text': 'Положите в игру одну фишку существа 2/2 зеленый Волк за каждый Лес под вашим контролем.', 'type': 'Волшебство', 'flavor': 'О кровожадных ужасах Вороновых Угодий сложены легенды, но даже это жуткое место замолкает при вое ночных волков.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172489&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd42e4d27-2d9d-4731-9626-9a0093872fe6', 'multiverseId': 172489}, 'multiverseid': 172489}, {'name': '夜狼群之吼', 'text': '你每操控一个树林，便将一个2/2绿色的狼衍生物放置进场。', 'type': '法术', 'flavor': '生息于黑鸦地的凶猛惊惧兽非常闻名，但当夜狼长嚎，即使此般鬼境也会为之静默。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173091&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '04e1c0c3-f8d9-4052-b902-09f81aa2538c', 'multiverseId': 173091}, 'multiverseid': 173091}]", '[{\'name\': \'Himmelshauch\', \'text\': \'Eine Kreatur deiner Wahl wird bis zum Ende des Zuges blau. Enttappe diese Kreatur.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Wenn du geisterhafte Lichter am Flussufer siehst, beiße dreimal in eine Sumpfwurzel, damit dich der Kelpie nicht holt." —Kithkin-Aberglaube\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174508&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7c7bc7a6-f330-45b8-ba58-7aa846185fdb\', \'multiverseId\': 174508}, \'multiverseid\': 174508}, {\'name\': \'Centellas cerúleas\', \'text\': \'La criatura objetivo es azul hasta el final del turno. Endereza esa criatura.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'"Si ves luces fantasmales en el río, come tres ramas de raíz del pantano para alejar a los kelpies." —Superstición kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172702&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'272f0f7f-c257-4f20-87fc-642d3449900d\', \'multiverseId\': 172702}, \'multiverseid\': 172702}, {\'name\': \'Feux céruléens\', \'text\': "La créature ciblée devient bleue jusqu\'à la fin du tour. Dégagez cette créature.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'« Si vous voyez des lueurs spectrales près de la rivière, mangez trois brindilles de racine de palud pour éloigner les kelpies. » —Superstition sangamie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173304&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fe7b9161-a3ca-45b1-8fe2-22090a09498f\', \'multiverseId\': 173304}, \'multiverseid\': 173304}, {\'name\': \'Fuochi Fatui Cerulei\', \'text\': \'Una creatura bersaglio diventa blu fino alla fine del turno. STAPpa quella creatura.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'"Se vedi delle luci spettrali vicino al fiume, mangia tre ramoscelli di radice palustre per tenere lontani i kelpie." —Superstizione kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173605&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9c0eda9-5360-4d12-880a-141db3d95be6\', \'multiverseId\': 173605}, \'multiverseid\': 173605}, {\'name\': \'たなびく紺碧\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは青になる。 そのクリーチャーをアンタップする。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'「川辺でぼんやりとした光を見かけたら、沼根っこの枝を三本食べてケルピー避けにしろ。」 ――キスキンの迷信\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173906&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8e636c0c-fe01-4bbe-ab74-f67999b7f120\', \'multiverseId\': 173906}, \'multiverseid\': 173906}, {\'name\': \'Fogo-Fátuo Azulado\', \'text\': \'A criatura alvo torna-se azul até o final do turno. Desvire aquela criatura.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Se você vir luzes fantasmagóricas na beira do rio, coma três brotos de raiz-do-pântano para afastar os kelpies." — Superstição kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172100&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e55ce993-7651-476c-b2e3-828d5ae81e1e\', \'multiverseId\': 172100}, \'multiverseid\': 172100}, {\'name\': \'Небесно-Голубые Огоньки\', \'text\': \'Целевое существо становится синим до конца хода. Разверните то существо.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Если увидишь у реки призрачные огоньки, съешь три веточки кермека, чтобы отпугнуть келпи». — Поверье кискенов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172401&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1fac6671-4e89-4e00-a696-5b4c853e3163\', \'multiverseId\': 172401}, \'multiverseid\': 172401}, {\'name\': \'蔚蓝鬼火\', \'text\': \'目标生物成为蓝色直到回合结束。 重置该生物。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'「如果在河畔看到鬼魅火光，吃下三条葵根就可以让凯尔比不上身。」 ～洁英的迷信\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173003&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cf3b482e-f2c5-42b0-aa24-6306cec0c117\', \'multiverseId\': 173003}, \'multiverseid\': 173003}]', '[{\'name\': \'Holzapfel-Kohorte\', \'text\': \'Die Holzapfel-Kohorte erhält +1/+1, solange du eine andere grüne Kreatur kontrollierst.\', \'type\': \'Kreatur — Baumhirte, Krieger\', \'flavor\': \'Sieben Frauen machten sieben Kuchen aus sieben Äpfeln, die sie von seinen Ästen gepflückt hatten. Nun ist er kahl und bitter, und der Preis hat sich geändert: Jeder Apfel kostet einen gebrochenen Knochen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174586&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b86b7f76-d8e8-4a03-a32f-63ee498b0642\', \'multiverseId\': 174586}, \'multiverseid\': 174586}, {\'name\': \'Cohorte de Manzano Silvestre\', \'text\': \'El Cohorte de Manzano Silvestre obtiene +1/+1 mientras controles otra criatura verde.\', \'type\': \'Criatura — Guerrero pueblo-arbóreo\', \'flavor\': \'Siete esposas hicieron siete pasteles de siete manzanas, cada una obtenida de sus ramas. Ya viejo y gastado viene a cobrar su precio: un hueso por cada manzana.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172780&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'995638b9-e3f0-4578-b260-7161ceb9fe7c\', \'multiverseId\': 172780}, \'multiverseid\': 172780}, {\'name\': \'Cohorte de la pomme sauvage\', \'text\': \'La Cohorte de la pomme sauvage gagne +1/+1 tant que vous contrôlez une autre créature verte.\', \'type\': \'Créature : sylvin et guerrier\', \'flavor\': \'Sept femmes ont préparé sept tartes avec sept pommes, chacune cueillie sur ses branches. Dénudé et amer, il revient faire payer le prix de cette infamie : une pomme pour un os.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173382&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'55189279-5de1-4d1f-93be-da74bca4e564\', \'multiverseId\': 173382}, \'multiverseid\': 173382}, {\'name\': \'Coorte del Melo Selvatico\', \'text\': "La Coorte del Melo Selvatico prende +1/+1 fintanto che controlli un\'altra creatura verde.", \'type\': \'Creatura — Guerriero Silvantropo\', \'flavor\': \'Sette mogli fecero sette torte da sette mele, ciascuna colta dalle sue fronde. Adesso nudo e spoglio, ha arrotondato le sue tariffe: una mela, un osso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173683&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'29fe72cc-1ff4-49e4-8bce-26619ef0dcde\', \'multiverseId\': 173683}, \'multiverseid\': 173683}, {\'name\': \'野リンゴの群勢\', \'text\': \'野リンゴの群勢は、あなたが他の緑のクリーチャーをコントロールしているかぎり＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — ツリーフォーク・戦士\', \'flavor\': \'七人の女房が、七個のリンゴを枝からもいで、こしらえたのは七つのパイ。 剥かれて苦しんだ代償は、リンゴ一個に骨一体。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173984&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0160bb7e-3a9e-4699-89ec-51ab0ba41309\', \'multiverseId\': 173984}, \'multiverseid\': 173984}, {\'name\': \'Coorte de Maçã Ácida\', \'text\': \'Coorte de Maçã Ácida recebe +1/+1 enquanto você controlar outra criatura verde.\', \'type\': \'Criatura — Ent Guerreiro\', \'flavor\': \'Sete esposas fizeram sete tortas de sete maçãs, cada uma delas colhida de seus galhos. Hoje despido e amargurado, ele veio acertar as contas: para cada maçã, um osso.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172178&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'26ed2c28-c054-46f8-a6b1-1f9cbdb93113\', \'multiverseId\': 172178}, \'multiverseid\': 172178}, {\'name\': \'Пособник Дикой Яблони\', \'text\': \'Пособник Дикой Яблони получает +1/+1, пока вы контролируете другое зеленое существо.\', \'type\': \'Существо — Лесовик Воин\', \'flavor\': \'Семь тетушек испекли семь пирогов из семи яблок, оборвав всю яблоню. Теперь, ободранная и злая, она пришла требовать расплаты: за каждое яблочко по косточке.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172479&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8eeed440-40d5-449c-a35c-e87d79e45e2d\', \'multiverseId\': 172479}, \'multiverseid\': 172479}, {\'name\': \'山楂助拳人\', \'text\': \'只要你操控其他绿色生物，山楂助拳人便得+1/+1。\', \'type\': \'生物～树妖／战士\', \'flavor\': \'七个老婆用七个苹果作七个派，每个都从这枝干上面拔下来。 它给拔个光秃秃后来索债：每个苹果用一根骨头来换。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173081&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'45bba9ef-806c-4328-b847-3e5d45cf499f\', \'multiverseId\': 173081}, \'multiverseid\': 173081}]', '[{\'name\': \'Hoppeltrottel\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\\n{T}: Eine Kreatur deiner Wahl hat bis zum Ende des Zuges eine oder mehrere Farben, die du bestimmst.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Er war gebaut worden, um Waren vom Fluss in die Stadt zu transportieren, und riss sich los, als er gerade einen Kessel voll Färbemittel schleppte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174740&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d82bc16e-97b6-4c4d-8936-bf854e3f41ec\', \'multiverseId\': 174740}, \'multiverseid\': 174740}, {\'name\': \'Canasta simplona\', \'text\': \'{T}: Agrega un maná de cualquier color a tu reserva de maná.\\n{T}: La criatura objetivo es del color o colores de tu elección hasta el final del turno.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'Construido para transportar mercancías del río, un día se fue, llevándose un caldero de tintes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172934&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b4aeed67-301a-4808-9a8c-b60eeee0c7fb\', \'multiverseId\': 172934}, \'multiverseid\': 172934}, {\'name\': \'Troussecabot\', \'text\': "{T} : Ajoutez un mana de la couleur de votre choix à votre réserve.\\n{T} : La créature ciblée devient de la couleur ou des couleurs de votre choix jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "Construit pour transporter des marchandises depuis la rivière, il est parti un jour chargé d\'un chaudron de teintures.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173536&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6a469bc-0284-47bd-8815-ea588dc71a27\', \'multiverseId\': 173536}, \'multiverseid\': 173536}, {\'name\': \'Sommozzatore Fedele\', \'text\': \'{T}: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana.\\n{T}: Una creatura bersaglio diventa di uno o più colori a tua scelta fino alla fine del turno.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': "Fabbricato per trasportare merci da una riva all\'altra del fiume, un giorno sparì mentre trasportava un calderone di tinture.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173837&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cfda7143-d562-4a77-a5f0-f7395fac285e\', \'multiverseId\': 173837}, \'multiverseid\': 173837}, {\'name\': \'小走り犬\', \'text\': \'{T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。\\n{T}：クリーチャー１体を対象とする。ターン終了時まで、それの色はあなたが選んだ色（１色または複数の色の組み合わせ）になる。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'川から物品を往復するために作られたそれは、ある日染料の瓶を持って姿を消した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174138&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a630a87e-f1df-4148-a6b3-14a59f6b7d31\', \'multiverseId\': 174138}, \'multiverseid\': 174138}, {\'name\': \'Corredor Bufão\', \'text\': \'{T}: Adicione um mana de qualquer cor à sua reserva de mana.\\n{T}: A criatura alvo torna-se da cor ou cores de sua escolha até o final do turno.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'Criado para transportar coisas do rio, um dia ele foi embora carregando um caldeirão de tintas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172332&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7f82f58f-4d45-465e-8d1b-d759957d586e\', \'multiverseId\': 172332}, \'multiverseid\': 172332}, {\'name\': \'Бродяжка\', \'text\': \'{T}: добавьте одну ману любого цвета в ваше хранилище маны.\\n{T}: цвет целевого существа изменяется на любые выбранные вами цвет или цвета до конца хода.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Сделанное, чтобы таскать грузы от реки, в один прекрасный день оно отправилось бродить по свету, прихватив с собой котелок с красками.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172633&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c2fe128b-d217-405a-9998-f3a6c73785ff\', \'multiverseId\': 172633}, \'multiverseid\': 172633}, {\'name\': \'急跑草人\', \'text\': \'{T}：加一点任意颜色的法术力到你的法术力池中。\\n{T}：直到回合结束，目标生物的颜色成为由你选择的颜色或颜色组合。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'它原本是用来从河流载运物品，有一天在运送整锅染料时决定要放个假。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173235&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'269cb702-7328-4cee-a5c7-fa8c20ea0ecf\', \'multiverseId\': 173235}, \'multiverseid\': 173235}]', '[{\'name\': \'Horn der ausgelassenen Lieder\', \'text\': \'{1}, {T}, tappe eine ungetappte Kreatur, die du kontrollierst: Eine Kreatur deiner Wahl erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Artefakt\', \'flavor\': \'Selbst ein schwacher Seufzer wird durch das Horn zu einer fröhlichen Melodie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174738&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0eed97e4-4035-4512-866f-4f24a52f9455\', \'multiverseId\': 174738}, \'multiverseid\': 174738}, {\'name\': \'Cuerno de canción alegre\', \'text\': \'{1}, {T}, girar una criatura enderezada que controlas: La criatura objetivo obtiene +1/+1 hasta el final del turno.\', \'type\': \'Artefacto\', \'flavor\': \'Un simple suspiro lanzado dentro del cuerno emerge como una melodía inspiradora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172932&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60f95b7b-c08c-42d9-9f01-3e2672e4edb1\', \'multiverseId\': 172932}, \'multiverseid\': 172932}, {\'name\': \'Cor au chant réjouissant\', \'text\': "{1}, {T}, engagez une créature dégagée que vous contrôlez : La créature ciblée gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Artefact\', \'flavor\': "Un soupir de désespoir résonne dans le cor comme une mélodie pleine d\'inspiration.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173534&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d078aa57-533d-4ea1-ae8f-5bbe72398911\', \'multiverseId\': 173534}, \'multiverseid\': 173534}, {\'name\': \'Corno Rivelacanti\', \'text\': \'{1}, {T}, TAPpa una creatura STAPpata che controlli: Una creatura bersaglio prende +1/+1 fino alla fine del turno.\', \'type\': \'Artefatto\', \'flavor\': \'Un piatto sospiro soffiato nel corno produce una melodia ispiratrice.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173835&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bf6626be-fc73-4a42-a4e1-3ceaac368892\', \'multiverseId\': 173835}, \'multiverseid\': 173835}, {\'name\': \'お祭り歌の角笛\', \'text\': \'{1}, {T}, あなたがコントロールするアンタップ状態のクリーチャー１体をタップする：クリーチャー１体を対象とする。それはターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'アーティファクト\', \'flavor\': \'落ち込んだため息すら、この角笛を通せば元気の出る旋律となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174136&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'11c5016b-8ef2-48f4-905f-d9f5a04e83e5\', \'multiverseId\': 174136}, \'multiverseid\': 174136}, {\'name\': \'Trombeta Jubilante\', \'text\': \'{1}, {T}, Vire uma criatura desvirada que você controla: A criatura alvo recebe +1/+1 até o final do turno.\', \'type\': \'Artefato\', \'flavor\': \'Um humilde suspiro sussurrado no chifre emerge como uma melodia inspiradora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172330&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'acd89114-3e44-4569-8625-8692e7bc3e5b\', \'multiverseId\': 172330}, \'multiverseid\': 172330}, {\'name\': \'Рог Вдохновения\', \'text\': \'{1}, {T}, поверните неповернутое существо под вашим контролем: целевое существо получает +1/+1 до конца хода.\', \'type\': \'Артефакт\', \'flavor\': \'Тяжелый вздох, пропущенный через этот рог, вырывается наружу вдохновляющей песней.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172631&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6a5bc1e-8a18-48b3-8375-ce491ead2374\', \'multiverseId\': 172631}, \'multiverseid\': 172631}, {\'name\': \'欢曲号角\', \'text\': \'{1}，{T}，横置一个由你操控且未横置的生物：目标生物得+1/+1直到回合结束。\', \'type\': \'神器\', \'flavor\': \'将泄气的叹息吹入此号角中，也能传出令人精神一振的旋律。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173233&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'39598e9c-8953-47d5-abce-ddec4e47d90e\', \'multiverseId\': 173233}, \'multiverseid\': 173233}]', '[{\'name\': \'Hungriger Spriggan\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn der Hungrige Spriggan angreift, erhält er +3/+3 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Wenn die Augen eines Spriggans größer als sein Magen waren, hat er Methoden, das auszugleichen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174597&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d67ca078-9fd4-4b96-a0be-f2edad7a8354\', \'multiverseId\': 174597}, \'multiverseid\': 174597}, {\'name\': \'Spriggan hambriento\', \'text\': \'Arrolla.\\nSiempre que el Spriggan hambriento ataque, obtiene +3/+3 hasta el final del turno.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Si los ojos de un spriggan son más grandes que su estómago, tiene modo de remediarlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172791&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f60c69e9-0603-46e6-bdcc-82984a728d6c\', \'multiverseId\': 172791}, \'multiverseid\': 172791}, {\'name\': \'Spriggan affamé\', \'text\': "Piétinement\\nÀ chaque fois que le Spriggan affamé attaque, il gagne +3/+3 jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': \'Si un spriggan a les yeux plus grands que le ventre, il a toujours un moyen de remédier à la situation.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173393&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72819336-3d2c-4e01-84e9-ce7b407c4579\', \'multiverseId\': 173393}, \'multiverseid\': 173393}, {\'name\': \'Spriggan Affamato\', \'text\': \'Travolgere\\nOgniqualvolta lo Spriggan Affamato attacca, prende +3/+3 fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Se gli occhi di uno spriggan sono più grandi del suo stomaco, ha molti modi per rimediare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173694&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9edf9058-2b63-4902-8a04-a8ab399fe72b\', \'multiverseId\': 173694}, \'multiverseid\': 173694}, {\'name\': \'飢えたスプリガン\', \'text\': \'トランプル\\n飢えたスプリガンが攻撃するたび、それはターン終了時まで＋３/＋３の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'スプリガンの目が胃袋よりもデカかったら、この状況を何とかする手段があるだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173995&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e67d23ad-8a4b-464e-b22a-57adc4ee239b\', \'multiverseId\': 173995}, \'multiverseid\': 173995}, {\'name\': \'Spriggan Faminto\', \'text\': \'Atropelar\\nToda vez que Spriggan Faminto ataca, ele recebe +3/+3 até o final do turno.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Se os olhos de um spriggan são maiores que sua barriga, ele tem meios de remediar a situação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172189&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'41e0280b-390e-4013-bf01-48ad9df1e805\', \'multiverseId\': 172189}, \'multiverseid\': 172189}, {\'name\': \'Голодный Спригган\', \'text\': \'Пробивной удар\\nКаждый раз, когда Голодный Спригган атакует, он получает +3/+3 до конца хода.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Если глаза сприггана оказываются больше желудка, то он всегда найдет способ это исправить.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172490&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'35ecaa8a-8791-473e-8ae9-9e98ee7d979a\', \'multiverseId\': 172490}, \'multiverseid\': 172490}, {\'name\': \'饥饿斯皮肯\', \'text\': \'践踏\\n每当饥饿斯皮肯攻击时，它得+3/+3直到回合结束。\', \'type\': \'生物～精灵／战士\', \'flavor\': \'如果斯皮肯的眼睛比胃大，才有办法改善处境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173092&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f83c1bf2-6220-433b-bf09-0abbb436d0b4\', \'multiverseId\': 173092}, \'multiverseid\': 173092}]', '[{\'name\': \'Hurtigwindraptor\', \'text\': \'Fliegend\\nAngreifende Kreaturen, die du kontrollierst, haben Lebensverknüpfung.\', \'type\': \'Kreatur — Vogel\', \'flavor\': \'Als er erwachte, hatte sich der Himmel verdüstert und stank. Sein rechtschaffener Zorn ließ den Horizont erbeben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174503&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6e7019e1-71f4-4cc2-8d50-36147ac57583\', \'multiverseId\': 174503}, \'multiverseid\': 174503}, {\'name\': \'Rapaz viento vigorizante\', \'text\': \'Vuela.\\nLas criaturas atacantes que controlas tienen la habilidad de vínculo vital.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Se despertó bajo un cielo plomizo y denso, y respondió con una ira justa que sacudió los cielos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172697&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b1e60bd6-e289-4ba7-af8d-e838c561fd71\', \'multiverseId\': 172697}, \'multiverseid\': 172697}, {\'name\': \'Rapace de Ventabrupt\', \'text\': \'Vol\\nLes créatures attaquantes que vous contrôlez ont le lien de vie.\', \'type\': \'Créature : oiseau\', \'flavor\': "Il s\'éveilla sous un ciel souillé par les ténèbres et sa juste colère fit trembler le firmament.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173299&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6805741d-e4e9-42b6-a2fb-879b7a72d97c\', \'multiverseId\': 173299}, \'multiverseid\': 173299}, {\'name\': \'Rapace di Vento Pungente\', \'text\': \'Volare\\nLe creature attaccanti che controlli hanno legame vitale.\', \'type\': \'Creatura — Uccello\', \'flavor\': \'Si svegliò in un cielo notturno e rispose con una giusta furia che scosse le alture celesti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173600&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fb867d05-4eca-4075-b15b-1dc6a8d29a94\', \'multiverseId\': 173600}, \'multiverseid\': 173600}, {\'name\': \'風立ての猛禽\', \'text\': \'飛行\\nあなたがコントロールする攻撃しているクリーチャーは絆魂を持つ。\', \'type\': \'クリーチャー — 鳥\', \'flavor\': \'それは陰鬱に汚された空を感じ取り、天をも揺るがす正義の怒りで応える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173901&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04fcf5de-571d-47ca-bbf7-0d578a2f5e45\', \'multiverseId\': 173901}, \'multiverseid\': 173901}, {\'name\': \'Raptor dos Ventos Velozes\', \'text\': \'Voar\\nAs criaturas atacantes que você controla têm vínculo com a vida.\', \'type\': \'Criatura — Ave\', \'flavor\': \'Ele despertou com um céu anuviado e sombrio e respondeu com uma cólera justificável que estremeceu o firmamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172095&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6f36a582-161b-473c-a66c-0b0641039eb9\', \'multiverseId\': 172095}, \'multiverseid\': 172095}, {\'name\': \'Хищница Свежего Ветра\', \'text\': \'Полет\\nАтакующие существа под вашим контролем имеют Цепь жизни.\', \'type\': \'Существо — Птица\', \'flavor\': \'Она пробудилась навстречу хмурому небу и ответила праведным гневом, от которого содрогнулись небеса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172396&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ddee692b-c6a1-4501-aa24-7ec54bf2ad74\', \'multiverseId\': 172396}, \'multiverseid\': 172396}, {\'name\': \'迅风猎鸟\', \'text\': \'飞行\\n由你操控、且进行攻击的生物具有系命异能。\', \'type\': \'生物～鸟\', \'flavor\': \'他面临这昏暗无光的天际，以正义之怒震撼长空。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172998&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f9aa1a22-e3ee-460f-a045-d1da04ba0760\', \'multiverseId\': 172998}, \'multiverseid\': 172998}]', '[{\'name\': \'Höhlen-Barghest\', \'text\': \'Falls du zu Beginn deines Versorgungssegments keine Karten auf deiner Hand hast, verliert jeder Gegner 2 Lebenspunkte.\\nFalls zu Beginn des Versorgungssegments eines Gegners dieser keine Karten auf der Hand hat, verliert er 2 Lebenspunkte.\', \'type\': \'Kreatur — Dämon, Hund\', \'flavor\': \'Er hinterlässt eine Spur aus zerdrückten Bäumen und entflohenen Träumen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174545&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'58818ec1-79e5-432c-99b2-5eacdaeaecd7\', \'multiverseId\': 174545}, \'multiverseid\': 174545}, {\'name\': \'Barghest de Diente Aullador\', \'text\': \'Al comienzo de tu mantenimiento, si no tienes cartas en la mano, cada oponente pierde 2 vidas.\\nAl comienzo del mantenimiento de cada oponente, si ese jugador no tiene cartas en su mano, él pierde 2 vidas.\', \'type\': \'Criatura — Perro demonio\', \'flavor\': \'Deja un rastro de árboles estrujados y sueños frustrados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172739&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'30423d9c-19f9-43cb-9238-c68cc1fa038a\', \'multiverseId\': 172739}, \'multiverseid\': 172739}, {\'name\': \'Barghest de Hurledent\', \'text\': "Au début de votre entretien, si vous n\'avez aucune carte en main, chaque adversaire perd 2 points de vie.\\nAu début de l\'entretien de chaque adversaire, si ce joueur n\'a aucune carte en main, il perd 2 points de vie.", \'type\': \'Créature : démon et chien de chasse\', \'flavor\': \'Il laisse derrière lui arbres renversés et rêves anéantis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173341&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0999f0cb-95fd-4ee3-a26f-14ac60390d58\', \'multiverseId\': 173341}, \'multiverseid\': 173341}, {\'name\': \'Barghest del Dente Ululato\', \'text\': "All\'inizio del tuo mantenimento, se non hai carte in mano, ogni avversario perde 2 punti vita.\\nAll\'inizio del mantenimento di ogni avversario, se quel giocatore non ha carte in mano, perde 2 punti vita.", \'type\': \'Creatura — Segugio Demone\', \'flavor\': \'Lascia una scia di alberi abbattuti e sogni infranti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173642&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c7f9ea59-1c0a-4d5f-96b9-9dd2e1f6a873\', \'multiverseId\': 173642}, \'multiverseid\': 173642}, {\'name\': \'うろ穴生まれのバーゲスト\', \'text\': \'あなたのアップキープの開始時に、あなたの手札にカードが無い場合、各対戦相手は２点のライフを失う。\\n各対戦相手のアップキープの開始時に、そのプレイヤーの手札にカードが無い場合、そのプレイヤーは２点のライフを失う。\', \'type\': \'クリーチャー — デーモン・猟犬\', \'flavor\': \'それは踏み潰された樹と砕かれた夢を後に残していく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173943&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'506d3e81-57e2-4e79-a5a6-81e43b17c729\', \'multiverseId\': 173943}, \'multiverseid\': 173943}, {\'name\': \'Barghest de Dente Uivante\', \'text\': \'No início de sua manutenção, se você não tiver nenhum card na mão, cada oponente perderá 2 pontos de vida.\\nNo início da manutenção de cada oponente, se o respectivo jogador não tiver nenhum card na mão, ele perderá 2 pontos de vida.\', \'type\': \'Criatura — Demônio Sabujo\', \'flavor\': \'Ele deixa um rastro de árvores curvadas e sonhos frustrados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172137&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4eea0676-a9e1-4d34-b0e2-2c2ad7d679da\', \'multiverseId\': 172137}, \'multiverseid\': 172137}, {\'name\': \'Баргест-Рыкозуб\', \'text\': \'В начале вашего шага поддержки, если у вас в руке нет карт, каждый оппонент теряет 2 жизни.\\nВ начале шага поддержки каждого оппонента, если у того игрока в руке нет карт, он теряет 2 жизни.\', \'type\': \'Существо — Демон Пес\', \'flavor\': \'Он оставляет за собой поломанные деревья и разбитые мечты.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172438&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9a53383c-24de-495d-a1d7-e46f6811401a\', \'multiverseId\': 172438}, \'multiverseid\': 172438}, {\'name\': \'洼生犬魔\', \'text\': \'在你的维持开始时，若你没有手牌，则每位对手各失去2点生命。\\n在每位对手的维持开始时，若该牌手没有手牌，则该牌手失去2点生命。\', \'type\': \'生物～恶魔／猎犬\', \'flavor\': \'倾倒树木与破碎梦想是它沿路留下的痕迹。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173040&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b2569374-d5c6-4293-bbc3-a1b0650ea979\', \'multiverseId\': 173040}, \'multiverseid\': 173040}]', '[{\'name\': \'Hügelrücken-Anrufung\', \'text\': \'{X}, wirf eine Karte mit umgewandelten Manakosten von X aus deiner Hand ab: Die Hügelrücken-Anrufung fügt einer Kreatur oder einem Spieler deiner Wahl X Schadenspunkte zu.\', \'type\': \'Verzauberung\', \'flavor\': \'Von der Macht der Flammen in Versuchung geführt versammelten sich Hexen zum Lernen in den Ruinen auf dem Rückenfels-Hügelchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174576&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'afc6cdff-be29-4452-b7c6-7d491670aa6f\', \'multiverseId\': 174576}, \'multiverseid\': 174576}, {\'name\': \'Invocación loma espinosa\', \'text\': \'{X}, descartar una carta con coste de maná convertido de X: La Invocación loma espinosa hace X puntos de daño a la criatura o jugador objetivo.\', \'type\': \'Encantamiento\', \'flavor\': \'Las brujas tentadas por el poder de la llama se reunían a estudiar en las ruinas de la loma espina rocosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172770&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11bcb00a-1893-4e21-b791-5f8fcb70f7cd\', \'multiverseId\': 172770}, \'multiverseid\': 172770}, {\'name\': \'Invocation de Tertrépine\', \'text\': "{X}, défaussez-vous d\'une carte ayant un coût converti de mana X : L\'Invocation de Tertrépine inflige X blessures à une cible, créature ou joueur.", \'type\': \'Enchantement\', \'flavor\': \'Les sorcières tentées par la puissance des flammes se rassemblaient pour étudier dans les ruines du tertre de Rochépine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173372&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4686f35b-987a-4a31-be9d-aa9db6974b97\', \'multiverseId\': 173372}, \'multiverseid\': 173372}, {\'name\': \'Invocazione di Spina Rocciosa\', \'text\': "{X}, Scarta una carta con costo di mana convertito pari a X: L\'Invocazione di Spina Rocciosa infligge X danni a una creatura o a un giocatore bersaglio.", \'type\': \'Incantesimo\', \'flavor\': \'Le streghe tentate dal potere delle fiamme si radunano a studiare nelle rovine del Poggio Spina Rocciosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173673&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7a211657-b578-4716-beb4-1de91a354c12\', \'multiverseId\': 173673}, \'multiverseid\': 173673}, {\'name\': \'山背骨の発動\', \'text\': \'{X}, 点数で見たマナ・コストがＸのカードを１枚捨てる：クリーチャー１体かプレイヤー１人を対象とする。山背骨の発動はそれにＸ点のダメージを与える。\', \'type\': \'エンチャント\', \'flavor\': \'炎の力に魅かれる魔女たちは、背骨岩の小山の廃虚にそれを集めて研究を行なっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173974&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e18bc0c1-e8c5-4728-9851-649f82882640\', \'multiverseId\': 173974}, \'multiverseid\': 173974}, {\'name\': \'Invocação da Colina Espinhosa\', \'text\': \'{X}, Descarte um card com custo de mana convertido igual a X: Invocação da Colina Espinhosa causa X pontos de dano à criatura ou ao jogador alvo.\', \'type\': \'Encantamento\', \'flavor\': \'Atraídas pelo poder da chama, as bruxas se reuniram para estudar nas ruínas da Colina da Rocha Espinhosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172168&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e3cad5d1-c3d6-4026-82c7-d7f0a58bb204\', \'multiverseId\': 172168}, \'multiverseid\': 172168}, {\'name\': \'Колдовство Горного Хребта\', \'text\': \'{X}, сбросьте карту с конвертированной мана-стоимостью X: Колдовство Горного Хребта наносит X повреждений целевому существу или игроку.\', \'type\': \'Чары\', \'flavor\': \'Завлеченные силой огня и обуреваемые жаждой знаний, ведьмы собрались на руинах Хребтокаменного Холма.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172469&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'913881e6-7533-4b07-8483-8874e042a012\', \'multiverseId\': 172469}, \'multiverseid\': 172469}, {\'name\': \'丘脊祝愿\', \'text\': \'{X}，弃掉一张总法术力费用为X的牌：丘脊祝愿对目标生物或牌手造成X点伤害。\', \'type\': \'结界\', \'flavor\': \'追逐火焰力量的法师聚众研究脊石圆丘的遗迹。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173071&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2f395b30-08ae-475a-86a8-0ca012fb0701\', \'multiverseId\': 173071}, \'multiverseid\': 173071}]', '[{\'name\': \'Hügelrücken-Drache\', \'text\': \'Fliegend\\nWenn der Hügelrücken-Drache ins Spiel kommt, kannst du alle Karten aus deiner Hand abwerfen und so viele Karten ziehen, wie einem Gegner deiner Wahl in diesem Zug Schadenspunkte zugefügt wurden.\', \'type\': \'Kreatur — Drache\', \'flavor\': \'Er erwachte in einer leeren Welt, die nach einem Gebieter verlangte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174575&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d6e77159-434f-4cb5-a0a6-13568bdbb984\', \'multiverseId\': 174575}, \'multiverseid\': 174575}, {\'name\': \'Dragón loma espinosa\', \'text\': \'Vuela.\\nCuando el Dragón loma espinosa entre en juego, puedes descartar tu mano y robar un número de cartas igual al daño hecho al oponente objetivo este turno.\', \'type\': \'Criatura — Dragón\', \'flavor\': \'Despertó para encontrar un mundo inmenso necesitado de un amo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172769&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7b99cc9-215c-45e8-9dc9-9995223caeb0\', \'multiverseId\': 172769}, \'multiverseid\': 172769}, {\'name\': \'Dragon de Tertrépine\', \'text\': "Vol\\nQuand le Dragon de Tertrépine arrive en jeu, vous pouvez vous défausser de votre main et piocher un nombre de cartes égal au nombre de blessures infligées à l\'adversaire ciblé ce tour.", \'type\': \'Créature : dragon\', \'flavor\': "Il s\'éveilla pour découvrir un vaste monde ayant besoin d\'un maître.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173371&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07e13990-d050-4317-9a41-0dc3e445bc47\', \'multiverseId\': 173371}, \'multiverseid\': 173371}, {\'name\': \'Drago di Spina Rocciosa\', \'text\': \'Volare\\nQuando il Drago di Spina Rocciosa entra in gioco, puoi scartare la tua mano e pescare un numero di carte pari al danno inflitto in questo turno a un avversario bersaglio.\', \'type\': \'Creatura — Drago\', \'flavor\': \'Si svegliò per trovare un mondo illimitato in cerca di un padrone.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173672&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e251c9e4-a625-47d1-b37e-840dced24459\', \'multiverseId\': 173672}, \'multiverseid\': 173672}, {\'name\': \'山背骨のドラゴン\', \'text\': \'飛行\\n山背骨のドラゴンが場に出たとき、対戦相手１人を対象とする。あなたは手札を捨ててもよい。そうしたなら、そのプレイヤーにこのターン与えられたダメージの点数に等しい枚数のカードを引く。\', \'type\': \'クリーチャー — ドラゴン\', \'flavor\': \'それが目覚めたのは、支配者を必要としている広大な世界だった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173973&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2852e211-67af-4e84-9efa-51ba2742eaca\', \'multiverseId\': 173973}, \'multiverseid\': 173973}, {\'name\': \'Dragão da Colina Espinhosa\', \'text\': \'Voar\\nQuando Dragão da Colina Espinhosa entra em jogo, você pode descartar a sua mão e comprar um número de cards igual ao dano causado ao oponente alvo neste turno.\', \'type\': \'Criatura — Dragão\', \'flavor\': \'Ao despertar, ele encontrou um vasto mundo necessitando de um mestre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172167&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4c37e119-e0bd-43cb-baa7-da109cf4f730\', \'multiverseId\': 172167}, \'multiverseid\': 172167}, {\'name\': \'Дракон Горного Хребта\', \'text\': \'Полет\\nКогда Дракон Горного Хребта входит в игру, вы можете сбросить вашу руку и взять столько карт, сколько повреждений было нанесено целевому оппоненту в этом ходу.\', \'type\': \'Существо — Дракон\', \'flavor\': \'Когда он проснулся, пред ним предстал необъятный мир, которому обязательно нужен был хозяин.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172468&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cbde0dde-fa24-4cb4-8b74-f8b24e3c8c52\', \'multiverseId\': 172468}, \'multiverseid\': 172468}, {\'name\': \'丘脊巨龙\', \'text\': \'飞行\\n当丘脊巨龙进场时，你可以弃掉你的手牌并抓若干牌，其数量等同于目标对手本回合受过的伤害数量。\', \'type\': \'生物～龙\', \'flavor\': \'他张眼便见到个广大而欠缺主宰的世界。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173070&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd6fa2c9-71db-4441-b862-f67805697817\', \'multiverseId\': 173070}, \'multiverseid\': 173070}]', '[{\'name\': \'Ideenfluss\', \'text\': \'Ziehe für jede Insel, die du kontrollierst, eine Karte.\', \'type\': \'Hexerei\', \'flavor\': \'„Vorsicht vor den Merrow, deren Gier und Habsucht selbst die der gefräßigen Strudel übertrifft, in denen sie leben." —Das Buch der anderen Völker\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174515&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1ec9f42a-8173-427a-8eca-45f0e2c4e5f9\', \'multiverseId\': 174515}, \'multiverseid\': 174515}, {\'name\': \'Flujo de ideas\', \'text\': \'Roba una carta por cada isla que controles.\', \'type\': \'Conjuro\', \'flavor\': \'"Ten cuidado de los merrow, cuya envidia y avaricia es mayor incluso que la de los remolinos en los que habitan." —El Libro de Otros Pueblos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172709&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cb68c625-0c65-4a2d-8e7d-4a41fa79e449\', \'multiverseId\': 172709}, \'multiverseid\': 172709}, {\'name\': "Flot d\'idées", \'text\': \'Piochez une carte pour chaque île que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "« Prenez garde aux suires, dont l\'envie et l\'avidité surpassent l\'appétit des tourbillons dans lesquels ils se terrent. » —Le livre des Autres", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173311&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3920ff91-a2a2-4c01-8d12-d3102a1e7867\', \'multiverseId\': 173311}, \'multiverseid\': 173311}, {\'name\': \'Flusso di Idee\', \'text\': \'Pesca una carta per ogni Isola che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'"Diffida dei merrow, le cui invidia e avidità superano persino quelle dei vortici affamati in cui vivono." —Il Tomo delle Altre Genti\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173612&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c1bab113-65d6-4bdb-a61f-3da2ba78c722\', \'multiverseId\': 173612}, \'multiverseid\': 173612}, {\'name\': \'発想の流れ\', \'text\': \'あなたがコントロールする島１つにつきカードを１枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'「メロウどもに気をつけよ。その嫉妬や強欲さは、奴らの住む貪欲な渦をも超える。」 ――「他族の書」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173913&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'711fc846-0fcb-44cf-b44c-958c6ab1524b\', \'multiverseId\': 173913}, \'multiverseid\': 173913}, {\'name\': \'Fluxo de Idéias\', \'text\': \'Compre um card para cada Ilha que você controla.\', \'type\': \'Feitiço\', \'flavor\': \'"Cuidado com os sirenídeos, cuja inveja e ganância superam até mesmo a dos vorazes redemoinhos em que moram." — O Livro dos Outros Povos\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172107&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39824cd0-5cba-4b5c-86c4-7c93831c57b1\', \'multiverseId\': 172107}, \'multiverseid\': 172107}, {\'name\': \'Поток Идей\', \'text\': \'Возьмите одну карту за каждый Остров под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'«Остерегайся мерроу, чья зависть и алчность страшнее, чем ненасытность омутов, в которых они обитают». — Кискенская книга о других народах\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172408&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'17954cc2-2378-484c-b952-77b30463ba91\', \'multiverseId\': 172408}, \'multiverseid\': 172408}, {\'name\': \'源源灵感\', \'text\': \'你每操控一个海岛，就抓一张牌。\', \'type\': \'法术\', \'flavor\': \'「要特别提防美洛，他们忌妒又贪婪，比所居住的无餍漩涡更危险。」 ～《他族通论》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173010&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'884ced37-1088-47d5-a571-061f304a3510\', \'multiverseId\': 173010}, \'multiverseid\': 173010}]', '[{\'name\': \'In Stückchen zerschmettern\', \'text\': \'Zerstöre ein Artefakt deiner Wahl. In Stückchen zerschmettern fügt dem Beherrscher dieses Artefakts 3 Schadenspunkte zu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Der Riese Tarvik träumte, dass Schmuckstücke und Maschinen an allem Übel der Welt schuld seien. Als er aus seinem unruhigen Schlaf erwachte, nannte er sich Tarvik Gerümpelzerschmetterer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174584&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b9ebf802-c068-4c8f-9ebe-a51282ae4487\', \'multiverseId\': 174584}, \'multiverseid\': 174584}, {\'name\': \'Hacer añicos\', \'text\': \'Destruye el artefacto objetivo. Hacer añicos hace 3 puntos de daño al controlador de ese artefacto.\', \'type\': \'Instantáneo\', \'flavor\': \'El gigante Tarvik soñó que las máquinas y artefactos eran los responsables de los males del mundo. Cuando despertó de sus pesadillas, asumió el nombre Tarvik Aplastareliquias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172778&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'11401e1d-effd-4203-acc6-879f12728e0d\', \'multiverseId\': 172778}, \'multiverseid\': 172778}, {\'name\': \'En mille morceaux\', \'text\': "Détruisez l\'artefact ciblé. En mille morceaux inflige 3 blessures au contrôleur de cet artefact.", \'type\': \'Éphémère\', \'flavor\': "Tarvik le géant rêva que les colifichets et les machines étaient responsables de tous les malheurs du monde. Quand il s\'éveilla de son sommeil troublé, il prit le nom de Tarvik Broyeur-de-reliques.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173380&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7d81b2a4-2809-455a-a133-a1428c10c947\', \'multiverseId\': 173380}, \'multiverseid\': 173380}, {\'name\': \'Sbriciolare\', \'text\': "Distruggi un artefatto bersaglio. Sbriciolare infligge 3 danni al controllore di quell\'artefatto.", \'type\': \'Istantaneo\', \'flavor\': \'Il gigante Tarvik sognò che le macchine e i gingilli erano la causa di tutto il dolore del mondo. Quando si risvegliò dal suo sonno agitato, prese il nome di Tarvik Spaccareliquie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173681&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fb61022-4c18-418c-b3fb-8bb5649b6849\', \'multiverseId\': 173681}, \'multiverseid\': 173681}, {\'name\': \'粉々\', \'text\': \'アーティファクト１つを対象とし、それを破壊する。 粉々はそのアーティファクトのコントローラーに３点のダメージを与える。\', \'type\': \'インスタント\', \'flavor\': \'巨人のターヴィックは世界に災厄をもたらす輝石と機械の夢を見た。 その休まらない眠りから目覚めたとき、彼は自らを遺物壊しのターヴィックと名乗ることにした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173982&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e79537bb-4f3c-4ac4-b812-9afb9d0a912c\', \'multiverseId\': 173982}, \'multiverseid\': 173982}, {\'name\': \'Reduzir a Cacos\', \'text\': \'Destrua o artefato alvo. Reduzir a Cacos causa 3 pontos de dano ao controlador daquele artefato.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'O gigante Tarvik sonhou que as quinquilharias e as máquinas haviam causado todo o mal do mundo. Quando acordou de seu sono perturbado, mudou seu nome para Tarvik Esmaga-Relíquia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172176&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6fb57147-29d2-48a8-b118-c65256d5c0a5\', \'multiverseId\': 172176}, \'multiverseid\': 172176}, {\'name\': \'Разнести в Щепки\', \'text\': \'Уничтожьте целевой артефакт. Разнести в Щепки наносит 3 повреждения игроку, контролирующему тот артефакт.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Гиганту Тарвику снилось, что всякие безделушки и механизмы были истинными виновниками вселенского горя. Когда он пробудился от своего беспокойного сна, он принял имя Тарвика Крушителя Реликвий.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172477&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce73b822-a11e-4b13-821f-75998327b9ee\', \'multiverseId\': 172477}, \'multiverseid\': 172477}, {\'name\': \'砸成碎片\', \'text\': \'消灭目标神器。 砸成碎片对该神器的操控者造成3点伤害。\', \'type\': \'瞬间\', \'flavor\': \'巨人塔巍克梦到琐物与机器替世界带来灾祸。 当他自恶梦醒来后，便有了砸器塔巍克的名号。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173079&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9a20db55-3476-4187-8a87-d263b4b0e8ca\', \'multiverseId\': 173079}, \'multiverseid\': 173079}]', '[{\'name\': \'Infusion mit Morgentropfen\', \'text\': \'Du erhältst X Lebenspunkte dazu, falls {G} ausgegeben wurde, um Infusion mit Morgentropfen zu spielen, und X Lebenspunkte dazu, falls {W} ausgegeben wurde, um sie zu spielen. (Mache beides, falls {G}{W} ausgegeben wurde.)\', \'type\': \'Hexerei\', \'flavor\': \'Die Blüte des Morgenfingerhuts ist ein wirksames Geheimmittel, doch die Morgentropfen, die aus ihrem Saft gebraut werden, sind das reine Leben.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174702&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b00344ec-dd44-40a8-8e21-643c0a9a01f2\', \'multiverseId\': 174702}, \'multiverseid\': 174702}, {\'name\': \'Infusión de solanera\', \'text\': \'Ganas X vidas si se usó {G} para jugar la Infusión de solanera y X vidas si se usó {W} para jugarla. (Haz ambos si se usó {G}{W}.)\', \'type\': \'Conjuro\', \'flavor\': \'La flor de la solanera es una panacea potente, pero el extracto del mismo nombre hecho con su savia es la vida misma.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172896&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5f891914-dfca-4ae8-b720-ee2d505adab1\', \'multiverseId\': 172896}, \'multiverseid\': 172896}, {\'name\': \'Infusion de solariane\', \'text\': "Vous gagnez X points de vie si {G} a été dépensé pour jouer l\'Infusion de solariane et X points de vie si {W} a été dépensé pour la jouer. (Faites les deux si {G}{W} a été dépensé.)", \'type\': \'Rituel\', \'flavor\': \'La fleur de digitale solaire est un remède puissant, mais la solariane distillée de sa sève est un pur extrait de vie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173498&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c29b11dd-cf3b-4562-ba09-2146750feb63\', \'multiverseId\': 173498}, \'multiverseid\': 173498}, {\'name\': \'Infuso di Ardore Aurorale\', \'text\': "Guadagni X punti vita se è stato speso {G} per giocare l\'Infuso di Ardore Aurorale e X punti vita se è stato speso {W}. (Compi entrambe le azioni se è stato speso {G}{W}.)", \'type\': \'Stregoneria\', \'flavor\': "Il fiore di digitale aurorale è un\'ottima panacea, ma l\'ardore aurorale estratto dalla sua linfa è nientemeno che la vita stessa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173799&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'abc859f6-c0dc-42a2-8bb4-c00d4cf77f04\', \'multiverseId\': 173799}, \'multiverseid\': 173799}, {\'name\': \'アケノヒカリの注入\', \'text\': \'アケノヒカリの注入をプレイするために{G}が支払われている場合、あなたはＸ点のライフを得る。アケノヒカリの注入をプレイするために{W}が支払われている場合、あなたはＸ点のライフを得る。 （{G}{W}が支払われている場合、両方を行う。）\', \'type\': \'ソーサリー\', \'flavor\': \'アケノテブクロは強力な秘薬だが、その樹液から得られるアケノヒカリは生命そのものに他ならない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174100&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4dad61f8-23f3-44cf-bc68-77253e64772e\', \'multiverseId\': 174100}, \'multiverseid\': 174100}, {\'name\': \'Infusão de Brilhalba\', \'text\': \'Você ganha X pontos de vida se {G} foi gasto para jogá-lo e X pontos de vida se {W} foi gasto para jogá-lo. (Faça ambas as coisas se {G}{W} foi gasto.)\', \'type\': \'Feitiço\', \'flavor\': \'A flor da luvalba é uma panacéia potente, mas o preparado de brilhalba feito com sua seiva nada mais é do que a própria vida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172294&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'39fb187f-08b2-47a9-93d9-578b76dae303\', \'multiverseId\': 172294}, \'multiverseid\': 172294}, {\'name\': \'Настой Зарецвета\', \'text\': \'Вы получаете X жизней, если на разыгрывание Настоя Зарецвета было потрачено {G}, и X жизней, если на его разыгрывание было потрачено {W}. (Сделайте и то и другое, если было потрачено {G}{W}.)\', \'type\': \'Волшебство\', \'flavor\': \'Цветок зарецвета сильное лекарство, а настой, приготовленный из его сока не что иное, как сама жизнь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172595&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'25af3c8c-582c-4dc6-bb63-aecc341e81d5\', \'multiverseId\': 172595}, \'multiverseid\': 172595}, {\'name\': \'晨华灌输\', \'text\': \'如果使用晨华灌输时支付了{G}，则你获得X点生命；如果使用它时支付了{W}，则你获得X点生命。 （如果支付了{G}{W}，则两者都作。）\', \'type\': \'法术\', \'flavor\': \'晨地黄花朵已是现成的强效药，而其汁液煎成的晨华更有惊人疗效。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173197&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3331df13-736a-40a3-9a50-b80f8b84a18c\', \'multiverseId\': 173197}, \'multiverseid\': 173197}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177806&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'f4451790-5e2c-4e1c-aafc-2769a2a742ce', 'multiverseId': 177806}, 'multiverseid': 177806}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177830&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '91ca1b28-c905-4b1f-9d0c-c3306ead6b67', 'multiverseId': 177830}, 'multiverseid': 177830}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177877&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'c39584f3-dfb0-4551-ba62-b998ef42123b', 'multiverseId': 177877}, 'multiverseid': 177877}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177901&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '233348cd-92ce-4504-84e0-10f391b903c9', 'multiverseId': 177901}, 'multiverseid': 177901}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177782&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c5061ca8-96cc-457c-bb14-3ebb10554e88', 'multiverseId': 177782}, 'multiverseid': 177782}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177758&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '71c4ab42-0a06-440b-a52d-56d3eb9a2623', 'multiverseId': 177758}, 'multiverseid': 177758}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177734&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ddbde2f3-be8e-442a-88f6-7e33c6f5e41d', 'multiverseId': 177734}, 'multiverseid': 177734}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177853&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b695548c-2eaa-43fe-8877-3b6d860fe653', 'multiverseId': 177853}, 'multiverseid': 177853}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177807&type=card', 'language': 'German', 'identifiers': {'scryfallId': '747dd0c9-0a08-47da-9e49-59b757c3267d', 'multiverseId': 177807}, 'multiverseid': 177807}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177831&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '01c6de65-cd03-4d30-af3f-a8ec8ec953bd', 'multiverseId': 177831}, 'multiverseid': 177831}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177878&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7a7c82c7-ecd7-408e-b0b0-0f9126fef74d', 'multiverseId': 177878}, 'multiverseid': 177878}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177902&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd1476526-09ca-4b71-951f-23bfa6a94ca1', 'multiverseId': 177902}, 'multiverseid': 177902}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177783&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '300cfc42-9af0-4a02-b5ab-fb7fdaa1939d', 'multiverseId': 177783}, 'multiverseid': 177783}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177759&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a6df8536-93f5-424a-a2e4-eb3ea70d57df', 'multiverseId': 177759}, 'multiverseid': 177759}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177735&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ab73c886-9777-47d3-b577-7fbc0255c205', 'multiverseId': 177735}, 'multiverseid': 177735}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177854&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bc57cbb9-6a43-4d85-9f93-f665e8328106', 'multiverseId': 177854}, 'multiverseid': 177854}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177808&type=card', 'language': 'German', 'identifiers': {'scryfallId': '92072ce3-8016-45c4-a78d-c3d90abea5ec', 'multiverseId': 177808}, 'multiverseid': 177808}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177832&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1b9ca00d-d6fc-452d-a273-438fb910dd69', 'multiverseId': 177832}, 'multiverseid': 177832}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177879&type=card', 'language': 'French', 'identifiers': {'scryfallId': '153872fb-7c98-4ca5-8ea7-26f49d6a442d', 'multiverseId': 177879}, 'multiverseid': 177879}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177903&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3b4c586e-d452-4736-901a-c739a1e61f6d', 'multiverseId': 177903}, 'multiverseid': 177903}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177784&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a5625eb0-e0a2-4762-b5c6-44495791d031', 'multiverseId': 177784}, 'multiverseid': 177784}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177760&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f6d25255-9af7-40a9-91d6-96a0228b53d9', 'multiverseId': 177760}, 'multiverseid': 177760}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177736&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '45f5658d-03ce-4ba1-b6ad-d6064a439c1e', 'multiverseId': 177736}, 'multiverseid': 177736}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177855&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c8b4faed-4915-4360-ad86-6a7948c7da25', 'multiverseId': 177855}, 'multiverseid': 177855}]", "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177809&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7a43154f-024f-4be1-9aa0-8489e6b78292', 'multiverseId': 177809}, 'multiverseid': 177809}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177833&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e68d8ea6-09d9-433a-9891-dde62456c543', 'multiverseId': 177833}, 'multiverseid': 177833}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177880&type=card', 'language': 'French', 'identifiers': {'scryfallId': '91683fe6-af1b-46cd-a970-ae797eb4a42d', 'multiverseId': 177880}, 'multiverseid': 177880}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177904&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c18dec1b-de3f-4dd7-9720-42ded3bfd8a8', 'multiverseId': 177904}, 'multiverseid': 177904}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177785&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6f3afe75-2aba-464a-b63d-a191fad277eb', 'multiverseId': 177785}, 'multiverseid': 177785}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177761&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ee8050d7-6d0b-4aab-abbd-c5d8b46e882f', 'multiverseId': 177761}, 'multiverseid': 177761}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177737&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'aac79a74-8f14-494f-8855-35525f0923bc', 'multiverseId': 177737}, 'multiverseid': 177737}, {'name': '海岛', 'type': '基本地～海岛', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177856&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'cd950399-6a44-42b4-95c3-a3c28d56c986', 'multiverseId': 177856}, 'multiverseid': 177856}]", '[{\'name\': \'Inselrücken-Ausgeburt\', \'text\': \'Verhüllt\\nDie Inselrücken-Ausgeburt erhält +4/+8, solange sich in irgendeiner Bibliothek zwanzig oder weniger Karten befinden.\', \'type\': \'Kreatur — Kraken\', \'flavor\': \'Je tödlicher das Monster im See ist, desto kürzer sind die Geschichten darüber.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174517&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d173b188-6127-4dee-a0f1-b142a2d6aed5\', \'multiverseId\': 174517}, \'multiverseid\': 174517}, {\'name\': \'Engendro isla caparazón\', \'text\': \'Velo.\\nEl Engendro isla caparazón obtiene +4/+8 mientras una biblioteca tenga veinte o menos cartas.\', \'type\': \'Criatura — Kraken\', \'flavor\': \'Cuanto más mortal es el monstruo del lago, más corto es el cuento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172711&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74412a5d-28a6-492e-9aaa-0585d3d40540\', \'multiverseId\': 172711}, \'multiverseid\': 172711}, {\'name\': \'Engeance havréchine\', \'text\': "Linceul\\nL\'Engeance havréchine gagne +4/+8 tant qu\'une bibliothèque contient vingt cartes ou moins.", \'type\': \'Créature : kraken\', \'flavor\': \'Plus le monstre du lac est dangereux, moins le conte est long.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173313&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'642d5f5a-2dd6-4e82-bfee-14fa70d10db6\', \'multiverseId\': 173313}, \'multiverseid\': 173313}, {\'name\': \'Progenie del Bacino delle Conchiglie\', \'text\': \'Velo\\nLa Progenie del Bacino delle Conchiglie prende +4/+8 fintanto che ci sono venti o meno carte in un grimorio.\', \'type\': \'Creatura — Kraken\', \'flavor\': \'Più un mostro del lago è letale, più è corta la sua storia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173614&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82e290b6-32ce-4c21-b96c-52cdc6a72075\', \'multiverseId\': 173614}, \'multiverseid\': 173614}, {\'name\': \'島背の落とし子\', \'text\': \'被覆\\n島背の落とし子は、いずれかのライブラリーのカードが20枚以下であるかぎり＋４/＋８の修整を受ける。\', \'type\': \'クリーチャー — クラーケン\', \'flavor\': \'湖の怪物がより恐ろしいほど、それにまつわる話は短い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173915&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'497322c4-0cec-4ae5-a8c1-fd91e10b81ae\', \'multiverseId\': 173915}, \'multiverseid\': 173915}, {\'name\': \'Rebento do Dorso Insular\', \'text\': \'Manto\\nRebento do Dorso Insular recebe +4/+8 enquanto um grimório tiver vinte cards ou menos.\', \'type\': \'Criatura — Kraken\', \'flavor\': \'Quanto mais mortal o monstro do lago, mais curto o conto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172109&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'65c35ef9-77a6-46a1-aabe-aba41832f803\', \'multiverseId\': 172109}, \'multiverseid\': 172109}, {\'name\': \'Исчадие Панцирного Острова\', \'text\': \'Пелена\\nИсчадие Панцирного Острова получает +4/+8, пока в какой-либо библиотеке находится двадцать или менее карт.\', \'type\': \'Существо — Кракен\', \'flavor\': \'Чем опаснее озерное чудовище, тем короче о нем сказ.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172410&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f1ef642e-93e5-490c-bbe1-e23c8328553e\', \'multiverseId\': 172410}, \'multiverseid\': 172410}, {\'name\': \'岛背后裔\', \'text\': \'帷幕\\n只要任一牌库为二十张牌或更少，岛背后裔便得+4/+8。\', \'type\': \'生物～巨海兽\', \'flavor\': \'湖中怪物越恐怖，其传说就越短。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173012&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'07f7102f-95cb-460f-8af6-cb9b199532a1\', \'multiverseId\': 173012}, \'multiverseid\': 173012}]', "[{'name': 'Junge Düsterwitwe', 'text': 'Reichweite (Diese Kreatur kann fliegende Kreaturen blocken.)\\nVerdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)', 'type': 'Kreatur — Spinne', 'flavor': 'Das Gift der Düsterwitwe ist während der ersten Jahre der Spinne besonders hinterhältig, solange sie hauptsächlich am Boden jagt.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174598&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a8b9b457-e52b-45d2-9e87-9654c4c93302', 'multiverseId': 174598}, 'multiverseid': 174598}, {'name': 'Viuda lúgubre juvenil', 'text': 'Alcance. (Puede bloquear criaturas con la habilidad de volar.)\\nDebilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)', 'type': 'Criatura — Araña', 'flavor': 'El veneno de las viudas lúgubres es particularmente violento durante los primeros años de la araña, cuando caza principalmente cerca del piso del bosque.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172792&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e2ca8084-34c1-477c-a47e-28fda0ff4690', 'multiverseId': 172792}, 'multiverseid': 172792}, {'name': 'Veuve obscure juvénile', 'text': 'Portée (Cette créature peut bloquer les créatures avec le vol.)\\nFlétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)', 'type': 'Créature : araignée', 'flavor': 'Le venin de veuve obscure est particulièrement virulent durant les premières années de sa vie, quand elle chasse principalement au niveau du sol forestier.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173394&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'afc3aecc-8e08-4ca7-a48d-c6ed1be04fb0', 'multiverseId': 173394}, 'multiverseid': 173394}, {'name': 'Cucciolo di Vedova di Tenebra', 'text': 'Raggiungere (Può bloccare le creature con volare.)\\nAvvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)', 'type': 'Creatura — Ragno', 'flavor': 'Il veleno della vedova di tenebra è particolarmente virulento nei primi anni di vita, quando caccia prevalentemente nel sottobosco.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173695&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ee1ff6e5-a345-4173-a680-d4ab75b6a044', 'multiverseId': 173695}, 'multiverseid': 173695}, {'name': '未熟な鬱後家蜘蛛', 'text': '到達 （これは飛行を持つクリーチャーをブロックできる。）\\n萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）', 'type': 'クリーチャー — 蜘蛛', 'flavor': '鬱後家蜘蛛の毒は、森の地面に近い場所で狩りをする生まれて一年目は特に毒性が高い。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173996&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1615ac98-d83b-4d0b-b291-b1aba113b985', 'multiverseId': 173996}, 'multiverseid': 173996}, {'name': 'Viúva-Sombria Juvenil', 'text': 'Alcance (Esta criatura pode bloquear criaturas com a habilidade de voar.)\\nMurchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)', 'type': 'Criatura — Aranha', 'flavor': 'A peçonha de uma viúva-sombria é particularmente venenosa durante os primeiros anos de vida da aranha, quando ela caça a maior parte do tempo próxima ao solo da floresta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172190&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '177f854b-6c65-4808-ab6f-93c3f21b8bbf', 'multiverseId': 172190}, 'multiverseid': 172190}, {'name': 'Детеныш Мрачной Вдовы', 'text': 'Захват (Этот объект может блокировать существа с Полетом.)\\nУвядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)', 'type': 'Существо — Паук', 'flavor': 'Яд мрачной вдовы действует особенно сильно в первые годы жизни, когда паук охотится в основном у подножия деревьев.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172491&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd91663fa-4042-4c6b-b4c8-65b8eb9d6a72', 'multiverseId': 172491}, 'multiverseid': 172491}, {'name': '幼年暗寡妇', 'text': '延势 （它能阻挡具飞行异能的生物。）\\n干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）', 'type': '生物～蜘蛛', 'flavor': '暗寡妇的毒液在初生的那年特别致命，并且多半在树林底层猎食。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173093&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5368071d-0296-4752-b2ea-268f4a9fbaef', 'multiverseId': 173093}, 'multiverseid': 173093}]", '[{\'name\': \'Kessel der Seelen\', \'text\': \'{T}: Bestimme eine beliebige Anzahl an Kreaturen deiner Wahl. Jede dieser Kreaturen erhält Beharrlichkeit bis zum Ende des Zuges. (Wenn sie aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174725&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1a15b969-5d83-4921-8b7f-f532548ee18a\', \'multiverseId\': 174725}, \'multiverseid\': 174725}, {\'name\': \'Caldero de almas\', \'text\': \'{T}: Elige cualquier cantidad de criaturas objetivo. Cada una de esas criaturas gana la habilidad de persistir hasta el final del turno. (Cuando vaya a un cementerio desde el juego, si no tiene contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172919&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f13d7cf3-bb32-4a47-8d4a-95559959c98d\', \'multiverseId\': 172919}, \'multiverseid\': 172919}, {\'name\': \'Chaudron des âmes\', \'text\': "{T} : Choisissez un nombre quelconque de créatures ciblées. Chacune de ces créatures acquiert la persistance jusqu\'à la fin du tour. (Quand elle est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173521&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ae57b10-7b37-4727-8e3c-95fd63dce6b3\', \'multiverseId\': 173521}, \'multiverseid\': 173521}, {\'name\': \'Calderone delle Anime\', \'text\': \'{T}: Scegli un qualsiasi numero di creature bersaglio. Ognuna di quelle creature ha persistere fino alla fine del turno. (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173822&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41035f5b-fecc-4982-9362-b1b806b928aa\', \'multiverseId\': 173822}, \'multiverseid\': 173822}, {\'name\': \'魂の大鍋\', \'text\': \'{T}：望む数のクリーチャーを対象とする。 それらのクリーチャーはターン終了時まで頑強を得る。 （それが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていない場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174123&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'78692500-da90-4cb8-890e-5f95df97f29f\', \'multiverseId\': 174123}, \'multiverseid\': 174123}, {\'name\': \'Caldeirão de Almas\', \'text\': \'{T}: Escolha um número qualquer de criaturas alvo. Cada uma dessas criaturas ganha persistir até o final do turno. (Quando for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172317&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30a50a44-990b-40e4-b760-2d66c9e174bd\', \'multiverseId\': 172317}, \'multiverseid\': 172317}, {\'name\': \'Котел Душ\', \'text\': \'{T}: выберите любое количество целевых существ. Каждое из тех существ получает Упорство до конца хода. (Когда оно попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172618&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7ea61266-9fb5-48a9-abdd-116f6f316c43\', \'multiverseId\': 172618}, \'multiverseid\': 172618}, {\'name\': \'灵魂鼎镬\', \'text\': \'{T}：选择任意数量的目标生物。 这些生物均获得留存异能直到回合结束。 （当它从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173220&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9476cf96-a352-4954-a976-899d83042f9e\', \'multiverseId\': 173220}, \'multiverseid\': 173220}]', "[{'name': 'Kettenbrecher', 'text': 'Der Kettenbrecher kommt mit zwei -1/-1-Marken ins Spiel.\\n{3}, {T}: Entferne eine -1/-1-Marke von einer Kreatur deiner Wahl.', 'type': 'Artefaktkreatur — Vogelscheuche', 'flavor': 'Vogelscheuchen, die als zu böswillig gelten, um frei herumzulaufen, werden an Felsen oder Dolmen festgebunden. Ihre Feindseligkeit hält allerdings länger als ihre Ketten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174726&type=card', 'language': 'German', 'identifiers': {'scryfallId': '72388a70-af56-4e86-86eb-7d31a12c322d', 'multiverseId': 174726}, 'multiverseid': 174726}, {'name': 'Rompecadenas', 'text': 'El Rompecadenas entra en juego con dos contadores -1/-1 sobre él.\\n{3}, {T}: Remueve un contador -1/-1 de la criatura objetivo.', 'type': 'Criatura artefacto — Espantapájaros', 'flavor': 'Los espantapájaros demasiado malvados para andar libres son encadenados a dólmenes o piedras. Su animosidad normalmente sobrevive a las cadenas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172920&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '28fd6647-8a11-4297-bca8-b1634fb52b63', 'multiverseId': 172920}, 'multiverseid': 172920}, {'name': 'Brisechaîne', 'text': 'Le Brisechaîne arrive en jeu avec deux marqueurs -1/-1 sur lui.\\n{3}, {T} : Retirez un marqueur -1/-1 à la créature ciblée.', 'type': 'Créature-artefact : épouvantail', 'flavor': 'Les épouvantails trop maléfiques sont enchaînés à des rochers ou des dolmens. Leur animosité a souvent raison des chaînes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173522&type=card', 'language': 'French', 'identifiers': {'scryfallId': '88426603-d522-4731-8d88-e226d86ba923', 'multiverseId': 173522}, 'multiverseid': 173522}, {'name': 'Spezzacatene', 'text': 'Lo Spezzacatene entra in gioco con due segnalini -1/-1.\\n{3}, {T}: Rimuovi un segnalino -1/-1 da una creatura bersaglio.', 'type': 'Creatura Artefatto — Spaventapasseri', 'flavor': 'Gli spaventapasseri ritenuti troppo malevoli per vagare in libertà vengono incatenati a grosse pietre o monoliti. La loro animosità solitamente sopravvive alle catene.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173823&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ce4b49c3-6625-4411-af2f-981e160c4ff7', 'multiverseId': 173823}, 'multiverseid': 173823}, {'name': '鎖千切り', 'text': '鎖千切りは－１/－１カウンターが２個置かれた状態で場に出る。\\n{3}, {T}：クリーチャー１体を対象とし、それの上に置かれている－１/－１カウンターを１個取り除く。', 'type': 'アーティファクト・クリーチャー — カカシ', 'flavor': '自由にうろつかせるには悪意がありすぎるとみなされているカカシは、岩や巨石等につながれている。 しかし、彼らの恨みは鎖よりも長生きだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174124&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '411db531-07a0-4623-a5ec-6446d275baa7', 'multiverseId': 174124}, 'multiverseid': 174124}, {'name': 'Rompe-Correntes', 'text': 'Rompe-Correntes entra em jogo com dois marcadores -1/-1.\\n{3}, {T}: Remova um marcador -1/-1 da criatura alvo.', 'type': 'Criatura Artefato — Espantalho', 'flavor': 'Os espantalhos considerados malignos demais para vagar livremente são amarrados a rochedos ou a dólmens. Sua hostilidade geralmente é mais forte que as correntes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172318&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '4e4d578d-125f-4679-9c4f-cf14ea341723', 'multiverseId': 172318}, 'multiverseid': 172318}, {'name': 'Разрыватель Цепей', 'text': 'Разрыватель Цепей входит в игру с двумя жетонами -1/-1 на нем.\\n{3}, {T}: удалите один жетон -1/-1 с целевого существа.', 'type': 'Артефактное Существо — Пугало', 'flavor': 'Если пугало слишком злобное, чтобы отпустить его на свободу, его приковывают цепями к валунам или дольменам. Обычно его враждебность оказывается сильнее кандалов.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172619&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '21c36789-6956-4bbf-95a3-b4c60b94dc9e', 'multiverseId': 172619}, 'multiverseid': 172619}, {'name': '破链草人', 'text': '破链草人进场时上面有两个-1/-1指示物。\\n{3}，{T}：从目标生物上移去一个-1/-1指示物。', 'type': '神器生物～稻草人', 'flavor': '被认定太坏而不能自由乱跑的稻草人，会给拴在巨石或石桌墓门上。 而他们的恶意通常会赢过锁链。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173221&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b56854d1-aa8f-4d41-9204-830519cf974b', 'multiverseId': 173221}, 'multiverseid': 173221}]", '[{\'name\': \'Kiefer aus Stein\', \'text\': \'Die Kiefer aus Stein fügen X Schadenspunkte zu, deren Verteilung auf eine beliebige Anzahl an Kreaturen und Spieler deiner Wahl du bestimmst, wobei X gleich der Anzahl der Gebirge ist, die du kontrollierst, sowie du Kiefer aus Stein spielst.\', \'type\': \'Hexerei\', \'flavor\': \'Wenn Riesen unerwünschten Besuch in ihren Bergen bekommen, haben sie eine reiche Auswahl an Möglichkeiten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174574&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4eaebe2a-3316-4137-b09c-48151d898499\', \'multiverseId\': 174574}, \'multiverseid\': 174574}, {\'name\': \'Mandíbulas de piedra\', \'text\': \'Las Mandíbulas de piedra hacen X puntos de daño divididos como elijas entre cualquier número de criaturas y/o jugadores objetivo, donde X es el número de montañas que controlas mientras juegas las Mandíbulas de piedra.\', \'type\': \'Conjuro\', \'flavor\': \'Cuando los gigantes encuentran sus hogares en las montañas ocupados, tienen todo un arsenal de soluciones.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172768&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10d100c7-d83d-4590-b81b-a3d72bf259a1\', \'multiverseId\': 172768}, \'multiverseid\': 172768}, {\'name\': \'Mâchoires de pierre\', \'text\': "Les Mâchoires de pierre infligent X blessures réparties comme vous le désirez entre n\'importe quel nombre de cibles, créatures et/ou joueurs, X étant le nombre de montagnes que vous contrôlez au moment où vous jouez les Mâchoires de pierre.", \'type\': \'Rituel\', \'flavor\': \'Quand les géants découvrent que leur foyer montagnard est infesté, ils trouvent toujours solution à leur problème.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173370&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ef9f4c3-2876-44c8-8c81-3d314dcea3f2\', \'multiverseId\': 173370}, \'multiverseid\': 173370}, {\'name\': \'Mascelle di Pietra\', \'text\': \'Le Mascelle di Pietra infliggono X danni divisi a tua scelta tra un qualsiasi numero di creature e/o giocatori bersaglio, dove X è il numero di Montagne che controlli mentre giochi le Mascelle di Pietra.\', \'type\': \'Stregoneria\', \'flavor\': \'Quando i giganti trovano invasi i loro rifugi montani, hanno una vasta gamma di soluzioni.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173671&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b273f6da-0334-441a-9ed9-da497b9e81ab\', \'multiverseId\': 173671}, \'multiverseid\': 173671}, {\'name\': \'石の顎\', \'text\': \'望む数のクリーチャーかプレイヤー（またはその組み合わせ）を対象とする。石の顎はそれらにＸ点のダメージをあなたの好きなように割り振って与える。Ｘは、あなたが石の顎をプレイした際にあなたがコントロールしていた山の総数に等しい。\', \'type\': \'ソーサリー\', \'flavor\': \'自分の住処の山に何者かが横行していると知った巨人は、ありとあらゆる手段で解決に向かう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173972&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'eeff84d3-b81a-44e1-a588-e249a840f1b6\', \'multiverseId\': 173972}, \'multiverseid\': 173972}, {\'name\': \'Mandíbulas de Pedra\', \'text\': \'Mandíbulas de Pedra causa X pontos de dano distribuídos à sua escolha entre qualquer número de criaturas e/ou jogadores alvo, sendo X igual ao número de Montanhas que você controla conforme joga Mandíbulas de Pedra.\', \'type\': \'Feitiço\', \'flavor\': \'Quando os gigantes encontram seus lares montanhosos infestados, eles têm várias soluções.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172166&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8063ed7-ac79-4869-832f-4968576c5703\', \'multiverseId\': 172166}, \'multiverseid\': 172166}, {\'name\': \'Каменные Челюсти\', \'text\': \'Каменные Челюсти наносят X повреждений, распределенных по вашему выбору между любым количеством целевых существ и (или) игроков, где X количество Гор под вашим контролем при разыгрывании Каменных Челюстей.\', \'type\': \'Волшебство\', \'flavor\': \'Когда гиганты обнаруживают, что их дома в горах кишат всякой заразой, они могут расправиться с ней самыми различными способами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172467&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4b26b4b3-83dc-455e-9abb-67f0d8274559\', \'multiverseId\': 172467}, \'multiverseid\': 172467}, {\'name\': \'岩石夹击\', \'text\': \'岩石夹击对任意数量的目标生物和／或牌手造成共X点伤害，你可以任意分配；X为你使用岩石夹击时所操控之山脉的数量。\', \'type\': \'法术\', \'flavor\': \'巨人发现自己山中家园被侵扰时，他们有很多种解决方法。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173069&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'852edcb9-80a1-44d3-85fd-9c7368b2f80c\', \'multiverseId\': 173069}, \'multiverseid\': 173069}]', '[{\'name\': \'Kithkin-Schildwirbler\', \'text\': \'{W}, {T}: Eine blockende Kreatur deiner Wahl erhält +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Kithkin, Soldat\', \'flavor\': \'Die Nova-Glyphe ist ein mächtiges Symbol. Ein Schild, der mit ihr verziert ist, kann selbst der Wucht eines zu allem entschlossenen Riesen widerstehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174487&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'079fd9db-1046-42f4-aa4c-865beaec6917\', \'multiverseId\': 174487}, \'multiverseid\': 174487}, {\'name\': \'Escudo osado kithkin\', \'text\': \'{W}, {T}: La criatura bloqueadora objetivo obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Soldado kithkin\', \'flavor\': \'El grabado de la nova es un símbolo potente. Un escudo con él puede resistir incluso el golpe de un gigante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172681&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'dc2d5f25-eb95-44d0-addb-20ac7185eadd\', \'multiverseId\': 172681}, \'multiverseid\': 172681}, {\'name\': \'Défieur au bouclier sangami\', \'text\': "{W}, {T} : La créature bloqueuse ciblée gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : sangami et soldat\', \'flavor\': \'Le glyphe nova est un puissant symbole. Un bouclier qui en est gravé peut résister à la force du géant le plus déterminé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173283&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ab68bc84-cf2c-4bdc-9197-51fbf7511ba9\', \'multiverseId\': 173283}, \'multiverseid\': 173283}, {\'name\': \'Scudo Ardito Kithkin\', \'text\': \'{W}, {T}: Una creatura bloccante bersaglio prende +2/+2 fino alla fine del turno.\', \'type\': \'Creatura — Soldato Kithkin\', \'flavor\': \'Il sigillo di nova è un simbolo potente. Uno scudo incantato con esso può resistere persino alla forza del gigante più determinato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173584&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7dd6ce72-c4a5-41a6-bbc3-e8a506e5d55a\', \'multiverseId\': 173584}, \'multiverseid\': 173584}, {\'name\': \'キスキンの盾挑み\', \'text\': \'{W}, {T}：ブロックしているクリーチャー１体を対象とする。それはターン終了時まで＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — キスキン・兵士\', \'flavor\': \'新星の象形は強力な印だ。 それが刻まれた盾は、最もやる気満々の巨人の力にすら耐える。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173885&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b4d9bfd9-d4e5-471f-8fc8-4b9f61cc5313\', \'multiverseId\': 173885}, \'multiverseid\': 173885}, {\'name\': \'Escudo-Ousado Kithkin\', \'text\': \'{W}, {T}: A criatura alvo bloqueadora recebe +2/+2 até o final do turno.\', \'type\': \'Criatura — Kithkin Soldado\', \'flavor\': \'O glifo de estrela é um símbolo poderoso. Um escudo com a imagem dele cinzelada pode resistir à força até mesmo do mais determinado dos gigantes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172079&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54e86a7c-6039-4785-822b-659065cda9d9\', \'multiverseId\': 172079}, \'multiverseid\': 172079}, {\'name\': \'Кискен, Вооруженный Щитом\', \'text\': \'{W}, {T}: целевое блокирующее существо получает +2/+2 до конца хода.\', \'type\': \'Существо — Кискен Солдат\', \'flavor\': \'Знак новой звезды могущественный символ. Щит, на котором он отчеканен, сможет устоять против силы даже самого решительного гиганта.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172380&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'58bc3eec-0a9f-4af0-a972-318d626539dd\', \'multiverseId\': 172380}, \'multiverseid\': 172380}, {\'name\': \'洁英持盾客\', \'text\': \'{W}，{T}：目标进行阻挡的生物得+2/+2直到回合结束。\', \'type\': \'生物～洁英／士兵\', \'flavor\': \'上面的新星雕饰是强大符号。 有这符号的盾牌甚至能够挡下巨人的奋力一击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172982&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4e2e0cb3-694b-4d33-9ba6-289003bc1937\', \'multiverseId\': 172982}, \'multiverseid\': 172982}]', '[{\'name\': \'Kithkinpöbel\', \'text\': \'Wachsamkeit\\nStärke und Widerstandskraft des Kithkinpöbels sind gleich der Anzahl der weißen bleibenden Karten, die du kontrollierst.\', \'type\': \'Kreatur — Kithkin\', \'flavor\': \'Sobald sich auch nur der leiseste Anflug von Panik im Gedankengewebe breit macht, lassen Bäcker, Töpfer und sogar Heiler ihre Werkzeuge und Salben fallen und greifen zu den Waffen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174486&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'27f5fe47-74ec-442f-b89b-30210f11a574\', \'multiverseId\': 174486}, \'multiverseid\': 174486}, {\'name\': \'Multitud kithkin\', \'text\': \'Vigilancia.\\nTanto la fuerza como la resistencia de la Multitud kithkin son iguales a la cantidad de permanentes blancos que controlas.\', \'type\': \'Criatura — Kithkin\', \'flavor\': \'Si el menor signo de pánico entra en la trama mental, los panaderos, artesanos e incluso los médicos dejan sus cucharas y bálsamos para tomar las armas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172680&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'acb6aad1-bba1-435c-8eda-29a41d198e01\', \'multiverseId\': 172680}, \'multiverseid\': 172680}, {\'name\': \'Plèbe sangamie\', \'text\': "Vigilance\\nLa force et l\'endurance de la Plèbe sangamie sont chacune égale au nombre de permanents blancs que vous contrôlez.", \'type\': \'Créature : sangami\', \'flavor\': \'Au moindre indice de panique dans la tramepensée, les boulangers, potiers, et même les carabins lâchent leurs cuillères et leurs onguents pour prendre les armes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173282&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'208c37fc-f764-4190-9ce4-2f829860652f\', \'multiverseId\': 173282}, \'multiverseid\': 173282}, {\'name\': \'Tumulto di Kithkin\', \'text\': \'Cautela\\nLa forza e la costituzione del Tumulto di Kithkin sono pari al numero di permanenti bianchi che controlli.\', \'type\': \'Creatura — Kithkin\', \'flavor\': \'Se anche il più sottile segno di panico attraversa la trama dei pensieri, i fornai, i vasai e persino i medici mollano i loro arnesi e corrono ad armarsi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173583&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0fd00cf5-cfbb-4b8d-bfb9-bdd66fa97886\', \'multiverseId\': 173583}, \'multiverseid\': 173583}, {\'name\': \'キスキンの扇動者\', \'text\': \'警戒\\nキスキンの扇動者のパワーとタフネスは、それぞれあなたがコントロールする白のパーマネントの総数に等しい。\', \'type\': \'クリーチャー — キスキン\', \'flavor\': \'思考の糸にほんの少しでもパニックが忍び込むと、パン屋や焼き物師や医者でさえ、スプーンや軟膏を投げ捨てて武器を取る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173884&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9efe039b-bb7a-424a-b69a-bf6d987051c4\', \'multiverseId\': 173884}, \'multiverseid\': 173884}, {\'name\': \'Horda Kithkin\', \'text\': \'Vigilância\\nO poder e a resistência de Horda Kithkin são ambos iguais ao número de permanentes brancas que você controla.\', \'type\': \'Criatura — Kithkin\', \'flavor\': \'Se o menor sinal de pânico penetra na trama-mental, os padeiros, oleiros e até mesmo os médicos deixam suas colheres e pomadas para pegar suas armas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172078&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dba027d1-4cb3-47ab-afa8-1c9e82359f91\', \'multiverseId\': 172078}, \'multiverseid\': 172078}, {\'name\': \'Кискенская Чернь\', \'text\': \'Бдительность\\nСила и выносливость Кискенской Черни равны количеству белых перманентов под вашим контролем.\', \'type\': \'Существо — Кискен\', \'flavor\': \'Если хотя бы малейший намек на панику проникает в сплетенные мысли кискенов, пекари, гончары и даже врачеватели оставляют ложки и склянки и бросаются к оружию.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172379&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'da00d0e9-d935-4789-96fc-e0d02fcc055c\', \'multiverseId\': 172379}, \'multiverseid\': 172379}, {\'name\': \'洁英齐众\', \'text\': \'警戒\\n洁英齐众的力量与防御力各等同于由你操控的白色永久物之数量。\', \'type\': \'生物～洁英\', \'flavor\': \'就算是最细微的惊慌进入纺思之间，所有面包师父、陶匠，甚至治疗师都会丢下汤匙与药膏、拿起武器来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172981&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0c034cfd-6e13-4b36-b6cb-ea369e31d7d9\', \'multiverseId\': 172981}, \'multiverseid\': 172981}]', '[{\'name\': \'Klippenläufer aus Barrenton\', \'text\': \'Der Klippenläufer aus Barrenton kann von roten Kreaturen nicht geblockt werden.\', \'type\': \'Kreatur — Kithkin, Späher\', \'flavor\': \'„Um Boggarts kommt man leicht herum. Man wirft einfach Hammelfleisch in die andere Richtung. Bei Riesen ist es schon schwerer. Man muss flink sein, um ihnen nicht unter die Füße zu gelangen. Rußwesen sind am schwierigsten, aber auch sie haben Angst, die man ausnutzen kann."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174615&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8195ed64-36c3-4da3-bf93-6a3d9d4750da\', \'multiverseId\': 174615}, \'multiverseid\': 174615}, {\'name\': \'Explorarriscos de Bárrenton\', \'text\': \'Los Explorarriscos de Bárrenton no pueden ser bloqueados por criaturas rojas.\', \'type\': \'Criatura — Explorador kithkin\', \'flavor\': \'"Los boggarts son fáciles de engañar. Simplemente arroja un trozo de carne hacia otro lado. Los gigantes son un poco más difíciles. Debes ser rápido para evitar su pisada. Los cenicientos son los más difíciles, pero ellos también tienen miedos que pueden aprovecharse."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172809&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7fac96f8-f26c-4bba-829f-6405e9e1ca96\', \'multiverseId\': 172809}, \'multiverseid\': 172809}, {\'name\': \'Escaladeurs de Barrenton\', \'text\': \'Les Escaladeurs de Barrenton ne peuvent pas être bloqués par les créatures rouges.\', \'type\': \'Créature : sangami et éclaireur\', \'flavor\': "« Les boggarts sont faciles à contourner. Il suffit de balancer de la viande de mouton dans la direction opposée. Les géants, c\'est plus difficile. Il faut être rapide pour éviter leurs pas. Les scoriacés sont plus coriaces, mais ils ont toujours des peurs à exploiter. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173411&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'77f92dd8-a5bb-4248-ad7a-fd31b7c5ba00\', \'multiverseId\': 173411}, \'multiverseid\': 173411}, {\'name\': \'Rocciatori di Barrenton\', \'text\': \'I Rocciatori di Barrenton non possono essere bloccati dalle creature rosse.\', \'type\': \'Creatura — Esploratore Kithkin\', \'flavor\': \'"I boggart sono facili da aggirare. Basta lanciare della carne di montone nella direzione opposta. Con i giganti è un po\\\' più difficile. Devi essere rapido per evitare i loro passi. I cinerei sono i più difficili, ma anch\\\'essi hanno delle paure che possono essere sfruttate."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173712&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'61bfc822-35e4-4dbc-ad8a-ea721e64261f\', \'multiverseId\': 173712}, \'multiverseid\': 173712}, {\'name\': \'バレントンの岩山踏み\', \'text\': \'バレントンの岩山踏みは赤のクリーチャーによってはブロックされない。\', \'type\': \'クリーチャー — キスキン・スカウト\', \'flavor\': \'「ボガートを避けて回るのは簡単だ。 羊肉を別な方向に投げればいい。 巨人だともう少し面倒だ。 奴らの足をかわすには素早くなくちゃいけない。 燃えがらどもは厄介だけど、奴らにも利用できるだけの恐怖心はあるのさ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174013&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b5a96042-1d49-4148-9b85-45f85ae188e4\', \'multiverseId\': 174013}, \'multiverseid\': 174013}, {\'name\': \'Trilha-Penhasco de Barrenton\', \'text\': \'Trilha-Penhasco de Barrenton não pode ser bloqueado por criaturas vermelhas.\', \'type\': \'Criatura — Kithkin Batedor\', \'flavor\': \'"É fácil se livrar dos papões. Basta jogar um pouco de carne de carneiro em outra direção. Já com os gigantes é um pouco mais difícil. Você precisa ser muito rápido para evitá-los. Os cinzeríneos são os mais difíceis, mas até mesmo eles têm medos a serem explorados."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172207&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'93bce0a1-8b00-4f2b-8b84-366c7a982eb8\', \'multiverseId\': 172207}, \'multiverseid\': 172207}, {\'name\': \'Баррентонские Горопроходцы\', \'text\': \'Баррентонские Горопроходцы не могут быть заблокированы красными существами.\', \'type\': \'Существо — Кискен Разведчик\', \'flavor\': \'«От боггартов легко отделаться можно просто бросить кусок баранины в противоположном направлении. С гигантами немного сложнее. Надо успевать уворачиваться, чтобы не попасть им под ноги. Золовики вот с кем по-настоящему трудно, но даже у них есть страхи, которые можно обернуть в свою пользу».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172508&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a0382c56-7bb3-4649-8827-29ae9f12cecd\', \'multiverseId\': 172508}, \'multiverseid\': 172508}, {\'name\': \'八连屯峭行人\', \'text\': \'八连屯峭行人不能被红色生物阻挡。\', \'type\': \'生物～洁英／斥候\', \'flavor\': \'「波尬很容易甩开； 只要往其他方向扔块羊肉即可。 巨人就难一点； 必须够快闪开他们的脚踩。 烬身则最难，但就算他们也有可资利用的恐惧。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173110&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5c7950ee-d2b3-40e7-8f6b-697c49cdc371\', \'multiverseId\': 173110}, \'multiverseid\': 173110}]', '[{\'name\': \'Kniffstibitzer-Clique\', \'text\': \'Fliegend\\n{1}{U}, {Q}: Ein Gegner deiner Wahl entfernt die oberste Karte seiner Bibliothek ganz aus dem Spiel. Bis zum Ende des Zuges kannst du diese Karte spielen. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Feenwesen, Räuber\', \'flavor\': \'Die meisten ihrer Ideen holte die Kniffstibitzer-Clique aus den Köpfen anderer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174519&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0c680282-5cfa-48b0-b075-e35cd232ada7\', \'multiverseId\': 174519}, \'multiverseid\': 174519}, {\'name\': \'Pandilla Sierrahábil\', \'text\': \'Vuela.\\n{1}{U}, {Q}: El oponente objetivo remueve del juego la primera carta de su biblioteca. Hasta el final del turno, puedes jugar esa carta. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Bribón hada\', \'flavor\': \'La mayoría de las habilidades de la Pandilla Sierrahábil provienen de las mentes de otros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172713&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'097c18dd-b999-455f-ab04-a963393085d6\', \'multiverseId\': 172713}, \'multiverseid\': 172713}, {\'name\': \'Clique Scietalent\', \'text\': "Vol\\n{1}{U}, {Q} : L\'adversaire ciblé retire de la partie la carte du dessus de sa bibliothèque. Jusqu\'à la fin du tour, vous pouvez jouer cette carte. ({Q} est le symbole de dégagement.)", \'type\': \'Créature : peuple fée et gredin\', \'flavor\': "La plupart des talents de la clique Scietalent étaient puisés dans les esprits d\'autrui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173315&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4c34ed6-f279-450f-a529-e29d477e4fa3\', \'multiverseId\': 173315}, \'multiverseid\': 173315}, {\'name\': \'Cricca Seghetta\', \'text\': \'Volare\\n{1}{U}, {Q}: Un avversario bersaglio rimuove dal gioco la prima carta del suo grimorio. Fino alla fine del turno, puoi giocare quella carta. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Farabutto Spiritello\', \'flavor\': \'Molte delle abilità della cricca Seghetta erano ritagliate dalle menti altrui.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173616&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'55bfe559-0e2e-48a1-8438-629145d624d9\', \'multiverseId\': 173616}, \'multiverseid\': 173616}, {\'name\': \'技鋸の徒党\', \'text\': \'飛行\\n{1}{U}, {Q}：対戦相手１人を対象とする。そのプレイヤーは自分のライブラリーの一番上のカードをゲームから取り除く。 ターン終了時まで、あなたはそのカードをプレイしてもよい。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — フェアリー・ならず者\', \'flavor\': \'技鋸の徒党の技のほとんどは、他人の思考を切り落としたものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173917&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7c8e97a9-d64d-4057-a3fe-9fa643a8bab3\', \'multiverseId\': 173917}, \'multiverseid\': 173917}, {\'name\': \'Facção do Serrote\', \'text\': \'Voar\\n{1}{U}, {Q}: O oponente alvo remove do jogo o card do topo de seu próprio grimório. Até o final do turno, você pode jogar aquele card. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Fada Ladino\', \'flavor\': \'A maioria das habilidades da facção do Serrote foi extirpada das mentes dos outros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172111&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23433d4c-a63e-4fc7-982e-51c1b485210d\', \'multiverseId\': 172111}, \'multiverseid\': 172111}, {\'name\': \'Вооруженная Пилами Клика\', \'text\': \'Полет\\n{1}{U}, {Q}: целевой оппонент удаляет из игры верхнюю карту своей библиотеки. До конца хода вы можете разыграть ту карту. ({Q} символ разворота карты.)\', \'type\': \'Существо — Фея Бродяга\', \'flavor\': \'Почти все умения этой клики были выпилены из чужого разума.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172412&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3c728e10-a5d2-4137-aa51-d72aea5f966e\', \'multiverseId\': 172412}, \'multiverseid\': 172412}, {\'name\': \'巧锯聚群\', \'text\': \'飞行\\n{1}{U}，{Q}：目标对手将其牌库顶牌移出对战。 直到回合结束，你可以使用该牌。 （{Q}是重置符号。）\', \'type\': \'生物～仙灵／浪客\', \'flavor\': \'巧锯聚群所会的大部分技巧都是自他人心灵窃取而来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173014&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cc7c652a-fa96-4d56-b08a-4094d6069138\', \'multiverseId\': 173014}, \'multiverseid\': 173014}]', '[{\'name\': \'Kohorte aus Aschenmoor\', \'text\': \'Die Kohorte aus Aschenmoor erhält +1/+1, solange du eine andere schwarze Kreatur kontrollierst.\', \'type\': \'Kreatur — Elementarwesen, Krieger\', \'flavor\': \'„Niemand wird freiwillig einen Platz für uns auf dieser Welt freimachen. Doch wenn es keinen Platz für uns gibt, dann sollen sie auch keinen haben. Wir werden nicht ruhen, bis die Welt in kalter Asche erstickt." —Illulia von der Nachtesse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174533&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dca5c0da-b06a-4bda-a49e-e14d50571606\', \'multiverseId\': 174533}, \'multiverseid\': 174533}, {\'name\': \'Cohorte de Páramo Ceniciento\', \'text\': \'El Cohorte de Páramo Ceniciento obtiene +1/+1 mientras controles otra criatura negra.\', \'type\': \'Criatura — Guerrero elemental\', \'flavor\': \'"Nadie nos dará un lugar en este mundo. Y si no es para nosotros, tampoco será para ellos. No descansaremos hasta ahogarlos en cenizas." —Illulia de Fogón Nocturno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172727&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cdb654b8-fcce-47aa-92a7-9c497617f52f\', \'multiverseId\': 172727}, \'multiverseid\': 172727}, {\'name\': \'Cohorte de Cendrelande\', \'text\': \'La Cohorte de Cendrelande gagne +1/+1 tant que vous contrôlez une autre créature noire.\', \'type\': \'Créature : élémental et guerrier\', \'flavor\': "« Nul ne nous cèdera une place en ce monde. S\'il ne peut pas nous appartenir, il n\'appartiendra à personne. Nous n\'aurons pas de repos tant qu\'ils n\'auront pas étouffé dans ses cendres froides. » —Illulia des Noctâtres", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173329&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'747b9d63-1eb8-4c8f-925b-9a131814057a\', \'multiverseId\': 173329}, \'multiverseid\': 173329}, {\'name\': \'Coorte della Brughiera Grigia\', \'text\': "La Coorte della Brughiera Grigia prende +1/+1 fintanto che controlli un\'altra creatura nera.", \'type\': \'Creatura — Guerriero Elementale\', \'flavor\': \'"Nessuno ci concederà un posto in questo mondo. Se non è per noi, non dovrà esserlo per nessuno. Non ci riposeremo finché non soffocheranno nelle sue fredde ceneri." —Illulia del Tetro Focolare\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173630&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6a136a62-9435-4070-82f9-0d3da9eb77dd\', \'multiverseId\': 173630}, \'multiverseid\': 173630}, {\'name\': \'アッシェンムーアの群勢\', \'text\': \'アッシェンムーアの群勢は、あなたが他の黒のクリーチャーをコントロールしているかぎり＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — エレメンタル・戦士\', \'flavor\': \'「世界中の誰も我々のための場所を与えはしない。 我々の物でないならば、奴らの物にもしないだけ。 奴らがその地の冷たい灰に息を詰まらせるまで、我々が休むことは無い。」 ――ナイトハースのイルリア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173931&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7769ee29-f395-47d9-8d9c-f3eb64cc4c68\', \'multiverseId\': 173931}, \'multiverseid\': 173931}, {\'name\': \'Coorte de Pântano das Cinzas\', \'text\': \'Coorte de Pântano das Cinzas recebe +1/+1 enquanto você controlar outra criatura preta.\', \'type\': \'Criatura — Elemental Guerreiro\', \'flavor\': \'"Ninguém nos concederá um lugar neste mundo. Se isso não é possível para nós, também não será para eles. Não descansaremos enquanto eles não se asfixiarem em suas cinzas frias." — Illulia, dos Larescuro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172125&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63b68d12-321f-40f5-9172-32427f6955b4\', \'multiverseId\': 172125}, \'multiverseid\': 172125}, {\'name\': \'Пособник Выжженной Пустоши\', \'text\': \'Пособник Выжженной Пустоши получает +1/+1, пока вы контролируете другое черное существо.\', \'type\': \'Существо — Элементаль Воин\', \'flavor\': \'«Никто не видит места для нас в этом мире. Если он не для нас, то и не для наших врагов. Мы не будем знать покоя, пока они не задохнутся в его остывшем пепле». — Иллулия из культа темносветов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172426&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'15abbc62-c34d-426b-bf1a-80ebf605f5fd\', \'multiverseId\': 172426}, \'multiverseid\': 172426}, {\'name\': \'灰原助拳人\', \'text\': \'只要你操控其他黑色生物，灰原助拳人便得+1/+1。\', \'type\': \'生物～元素／战士\', \'flavor\': \'「没人会给我们让出个容身之处。 如果我们待不了，他们也别想留下。 直到他们给自己冷却的灰烬覆盖，我们绝不罢手。」 ～夜炉的伊璐里\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173028&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7bc7d4f8-8f49-4142-8457-5f50e7b7a989\', \'multiverseId\': 173028}, \'multiverseid\': 173028}]', '[{\'name\': \'Kohorte aus Ballynock\', \'text\': \'Erstschlag\\nDie Kohorte aus Ballynock erhält +1/+1, solange du eine andere weiße Kreatur kontrollierst.\', \'type\': \'Kreatur — Kithkin, Soldat\', \'flavor\': \'Der schlimmste Feind eines Kithkin ist die Einsamkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174480&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'08a3c703-89ea-4c4b-9e98-fd77a5b68e9a\', \'multiverseId\': 174480}, \'multiverseid\': 174480}, {\'name\': \'Cohorte de Bállynock\', \'text\': \'Daña primero.\\nLa Cohorte de Bállynock obtiene +1/+1 mientras controles otra criatura blanca.\', \'type\': \'Criatura — Soldado kithkin\', \'flavor\': \'El peor enemigo de un kithkin es la soledad.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172674&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce88311c-6aef-4bc2-b6ec-2d3d379e243e\', \'multiverseId\': 172674}, \'multiverseid\': 172674}, {\'name\': \'Cohorte de Damnejonc\', \'text\': \'Initiative\\nLa Cohorte de Damnejonc gagne +1/+1 tant que vous contrôlez une autre créature blanche.\', \'type\': \'Créature : sangami et soldat\', \'flavor\': \'La solitude est le pire ennemi du sangami.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173276&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'411db22d-5981-4887-bfa1-8c4623c03c42\', \'multiverseId\': 173276}, \'multiverseid\': 173276}, {\'name\': \'Coorte di Ballynock\', \'text\': "Attacco improvviso\\nLa Coorte di Ballynock prende +1/+1 fintanto che controlli un\'altra creatura bianca.", \'type\': \'Creatura — Soldato Kithkin\', \'flavor\': \'Il peggior nemico di un kithkin è la solitudine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173577&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d3355087-d4eb-4913-821b-1fbaff6c8b2b\', \'multiverseId\': 173577}, \'multiverseid\': 173577}, {\'name\': \'バリーノックの群勢\', \'text\': \'先制攻撃\\nバリーノックの群勢は、あなたが他の白のクリーチャーをコントロールしているかぎり＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — キスキン・兵士\', \'flavor\': \'キスキンの最悪の敵は孤立だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173878&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f737720-6c73-4675-9ff5-1ddacfea32b5\', \'multiverseId\': 173878}, \'multiverseid\': 173878}, {\'name\': \'Coorte de Ballynock\', \'text\': \'Iniciativa\\nCoorte de Ballynock recebe +1/+1 enquanto você controlar outra criatura branca.\', \'type\': \'Criatura — Kithkin Soldado\', \'flavor\': \'O pior inimigo de um kithkin é a solidão.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172072&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1ba22342-4bd8-47d7-b9f4-140b6c558b07\', \'multiverseId\': 172072}, \'multiverseid\': 172072}, {\'name\': \'Пособница из Балинока\', \'text\': \'Первый удар\\nПособница из Балинока получает +1/+1, пока вы контролируете другое белое существо.\', \'type\': \'Существо — Кискен Солдат\', \'flavor\': \'Одиночество вот злейший враг кискена.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172373&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'84984728-8338-4f01-8076-1a05391cbf93\', \'multiverseId\': 172373}, \'multiverseid\': 172373}, {\'name\': \'巴立纳助拳人\', \'text\': \'先攻\\n只要你操控其他白色生物，巴立纳助拳人便得+1/+1。\', \'type\': \'生物～洁英／士兵\', \'flavor\': \'洁英最难应付的敌人就是孤立。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172975&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'deb95475-6361-4ccd-8ed5-f80a487bd503\', \'multiverseId\': 172975}, \'multiverseid\': 172975}]', '[{\'name\': \'Kohorte der Schlammringer\', \'text\': \'Eile\\nDie Kohorte der Schlammringer erhält +1/+1, solange du eine andere rote Kreatur kontrollierst.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Vor jedem Überfall heizen sich die Mitglieder der Wurz-Bande gegenseitig an, indem sie über ihren Hunger erzählen und wie sie ihn stillen wollen, wobei jeder seinen Vorredner übertrumpft.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174577&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61132c6d-6ec2-41ba-808f-157c14a00dd8\', \'multiverseId\': 174577}, \'multiverseid\': 174577}, {\'name\': \'Cohorte de Alboroto Fangoso\', \'text\': \'Prisa.\\nEl Cohorte de Alboroto Fangoso obtiene +1/+1 mientras controles otra criatura roja.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Antes de una incursión los miembros de la banda de Mosto se dan aires de su hambre y cuentan lo que harán para saciarlo, una historia más impresionante que la otra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172771&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ce13f9e5-31b8-4b1e-bbbd-046160a67bca\', \'multiverseId\': 172771}, \'multiverseid\': 172771}, {\'name\': \'Cohorte de Baugehutin\', \'text\': \'Célérité\\nLa Cohorte de Baugehutin gagne +1/+1 tant que vous contrôlez une autre créature rouge.\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Avant chaque pillage, les membres du gang de Moût échangent leurs histoires de faim et leurs solutions pour la satisfaire, chacun essayant de surpasser l\'autre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173373&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d7efcecb-fc5d-45cb-b3c5-f091b587e3d2\', \'multiverseId\': 173373}, \'multiverseid\': 173373}, {\'name\': \'Coorte di Rissaiolo Fangoso\', \'text\': "Rapidità\\nLa Coorte di Rissaiolo Fangoso prende +1/+1 fintanto che controlli un\'altra creatura rossa.", \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Prima di una razzia, i membri della banda di Larva si istigano a vicenda con storie sulla loro fame e su come faranno a saziarla, ciascuno superando il precedente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173674&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'855a08b8-5c85-4f48-b15e-f02757518a2e\', \'multiverseId\': 173674}, \'multiverseid\': 173674}, {\'name\': \'泥騒ぎの群勢\', \'text\': \'速攻\\n泥騒ぎの群勢は、あなたが他の赤のクリーチャーをコントロールしているかぎり＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'襲撃の前、汁婆の手下達は、自分の飢えとそれをどう満たすかの話で、どんどん事を大げさにして互いを煽りあう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173975&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'8d99f680-9c87-4872-8019-320d06f80190\', \'multiverseId\': 173975}, \'multiverseid\': 173975}, {\'name\': \'Coorte de Rixalama\', \'text\': \'Ímpeto\\nCoorte de Rixalama recebe +1/+1 enquanto você controlar outra criatura vermelha.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Antes de um ataque, os membros da gangue de Mosto encorajavam-se uns aos outros com contos sobre sua fome e o que fariam para satisfazê-la, e se superavam um após o outro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172169&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4640de99-ce17-49a6-8943-59512f05b33d\', \'multiverseId\': 172169}, \'multiverseid\': 172169}, {\'name\': \'Пособник из Клана Буянов\', \'text\': \'Ускорение\\nПособник из Клана Буянов получает +1/+1, пока вы контролируете другое красное существо.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Перед набегом члены банды мамаши Бражки подстрекают друг друга рассказами о своем голоде и о том, что они сделают, чтобы его утолить, один пуще другого.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172470&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7def8ede-d8a4-4b82-b486-03a3b68a249a\', \'multiverseId\': 172470}, \'multiverseid\': 172470}, {\'name\': \'泥闹助拳人\', \'text\': \'敏捷\\n只要你操控其他红色生物，泥闹助拳人便得+1/+1。\', \'type\': \'生物～精灵／战士\', \'flavor\': \'麦汁这帮在打劫之前会分别讲述故事，用自己的渴求与满足之道来互相怂恿，并且一个讲得比一个夸张。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173072&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'53e247c1-aca6-460a-b224-9bf9014f7b06\', \'multiverseId\': 173072}, \'multiverseid\': 173072}]', '[{\'name\': \'Korruption\', \'text\': \'Korruption fügt einer Kreatur oder einem Spieler deiner Wahl Schadenspunkte in Höhe der Anzahl der Sümpfe, die du kontrollierst, zu. Du erhältst so viele Lebenspunkte dazu, wie auf diese Weise Schadenspunkte zugefügt wurden.\', \'type\': \'Hexerei\', \'flavor\': \'Im trüben Wasser warten Wesen, für die der Nebel ein Eintopf ist, eine dünne Brühe, die dringend mehr Fleisch benötigt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174539&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'570cf904-af48-4ea6-aa48-a8eaea5e2f7f\', \'multiverseId\': 174539}, \'multiverseid\': 174539}, {\'name\': \'Corromper\', \'text\': \'Corromper hace una cantidad de daño igual al número de pantanos que controles a la criatura o jugador objetivo. Ganas una cantidad de vida igual al daño hecho de esta manera.\', \'type\': \'Conjuro\', \'flavor\': \'Hay cosas bajo el fango para los cuales el pantano es un caldo soso que necesita carne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172733&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4d72d16e-d551-482e-8d88-6ff67c40dd6a\', \'multiverseId\': 172733}, \'multiverseid\': 172733}, {\'name\': \'Corruption\', \'text\': \'La Corruption inflige à une cible, créature ou joueur, un nombre de blessures égal au nombre de marais que vous contrôlez. Vous gagnez autant de points de vie que de blessures infligées de cette manière.\', \'type\': \'Rituel\', \'flavor\': "Il y en a pour qui le marais n\'est rien d\'autre qu\'un ragoût, un bouillon léger en manque de viande.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173335&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b687bb48-6e65-4c79-9995-db0a7bcb0468\', \'multiverseId\': 173335}, \'multiverseid\': 173335}, {\'name\': \'Corrompere\', \'text\': \'Corrompere infligge danno pari al numero di Paludi che controlli a una creatura o a un giocatore bersaglio. Guadagni punti vita pari ai danni inflitti in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': "Ci sono cose nell\'oscurità per le quali la palude è un grosso stufato, un povero brodo in cerca di carne.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173636&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1fb7a0f8-2e22-45a3-ab9d-406296455bb8\', \'multiverseId\': 173636}, \'multiverseid\': 173636}, {\'name\': \'堕落\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。堕落はそれに、あなたがコントロールする沼の総数に等しい点数のダメージを与える。 あなたはこれにより与えたダメージに等しい点数のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'暗黒の中に潜むものにとって、泥沼は肉の足りない薄い出汁のシチューのようなものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173937&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0148211f-c7d1-4613-9892-e3a99d45264b\', \'multiverseId\': 173937}, \'multiverseid\': 173937}, {\'name\': \'Corromper\', \'text\': \'Corromper causa à criatura ou ao jogador alvo dano igual ao número de Pântanos que você controla. Você ganha uma quantidade de pontos de vida igual ao dano causado desta maneira.\', \'type\': \'Feitiço\', \'flavor\': \'Na escuridão há seres para os quais o pântano é um ensopado, um caldo ralo que precisa de carne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172131&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a8bffbfc-bc79-467c-8896-01ef10105612\', \'multiverseId\': 172131}, \'multiverseid\': 172131}, {\'name\': \'Разложение\', \'text\': \'Разложение наносит целевому существу или игроку повреждения, равные количеству Болот под вашим контролем. Вы получаете столько жизней, сколько повреждений было нанесено таким образом.\', \'type\': \'Волшебство\', \'flavor\': \'В черной трясине обитают твари, для которых болото это варево, жиденькая похлебка, в которой явно не хватает мяса.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172432&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'895f6153-9cc0-4fc3-995f-70fb32cae2bc\', \'multiverseId\': 172432}, \'multiverseid\': 172432}, {\'name\': \'腐化\', \'text\': \'腐化对目标生物或牌手造成伤害，其数量等同于由你操控的沼泽数量。 你获得等同于以此法所造成的伤害之生命。\', \'type\': \'法术\', \'flavor\': \'对藏身泥泞下之物来说，沼泽是锅无味淡汤，得加点肉才行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173034&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'82969c3f-86c1-4d36-baf6-f5391681c65e\', \'multiverseId\': 173034}, \'multiverseid\': 173034}]', '[{\'name\': \'Kulrath-Ritter\', \'text\': \'Fliegend\\nVerdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nKreaturen, die deine Gegner kontrollieren und auf denen Marken liegen, können nicht angreifen oder blocken.\', \'type\': \'Kreatur — Elementarwesen, Ritter\', \'flavor\': \'Berittene Rußwesen umkreisen den zerstörten Gipfel des Kulrath und jagen die Auslöscherin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174667&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8701098-77c3-41aa-9453-26c27e0cdf50\', \'multiverseId\': 174667}, \'multiverseid\': 174667}, {\'name\': \'Caballero de Kulrath\', \'text\': \'Vuela.\\nDebilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\\nLas criaturas con contadores sobre ellas que controlan tus oponentes no pueden atacar ni bloquear.\', \'type\': \'Criatura — Caballero elemental\', \'flavor\': \'Los cenicientos montados merodean el pico destruido de Kulrath, persiguiendo a la Extinguidora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172861&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cf78f381-75f4-4124-9fab-0402b15cb4e5\', \'multiverseId\': 172861}, \'multiverseid\': 172861}, {\'name\': \'Chevalier de Kulrajh\', \'text\': \'Vol\\nFlétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nLes créatures avec des marqueurs sur elles que vos adversaires contrôlent ne peuvent ni attaquer, ni bloquer.\', \'type\': \'Créature : élémental et chevalier\', \'flavor\': "Les cavaliers scoriacés chassent l\'Extincteur autour du pic foudroyé de Kulrajh.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173463&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82b05567-1cb3-4a60-81cd-b8df64f62931\', \'multiverseId\': 173463}, \'multiverseid\': 173463}, {\'name\': \'Cavaliere di Kulrath\', \'text\': \'Volare\\nAvvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nLe creature con segnalini controllate dai tuoi avversari non possono attaccare o bloccare.\', \'type\': \'Creatura — Cavaliere Elementale\', \'flavor\': "Cavalieri cinerei perlustrano il picco inaridito di Kulrath, alla caccia dell\'Estintrice.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173764&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a0b54a8e-48be-447b-ad27-65f94c4cb846\', \'multiverseId\': 173764}, \'multiverseid\': 173764}, {\'name\': \'クルラスの騎士\', \'text\': \'飛行\\n萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\nあなたの対戦相手がコントロールするカウンターが置かれているクリーチャーは攻撃もブロックもできない。\', \'type\': \'クリーチャー — エレメンタル・騎士\', \'flavor\': \'燃えがらの乗り手達はクルラスの吹き飛ばされた頂で輪を描き、「鎮める者」を狩り立てている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174065&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a9274910-eb79-4106-8644-0caf7dd51359\', \'multiverseId\': 174065}, \'multiverseid\': 174065}, {\'name\': \'Cavaleiro de Kulrath\', \'text\': \'Voar\\nMurchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\\nAs criaturas que seus oponentes controlam com marcadores não podem atacar nem bloquear.\', \'type\': \'Criatura — Elemental Cavaleiro\', \'flavor\': \'Cinzeríneos montados circundam o deteriorado pico de Kulrath, em busca da Extintora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172259&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'92ebc3b7-619c-44da-b094-8e96e24babd6\', \'multiverseId\': 172259}, \'multiverseid\': 172259}, {\'name\': \'Рыцарь Кулрата\', \'text\': \'Полет\\nУвядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\\nСущества с жетонами под контролем ваших оппонентов не могут атаковать или блокировать.\', \'type\': \'Существо — Элементаль Рыцарь\', \'flavor\': \'Неутомимые наездники, золовики кружат над разрушенной вершиной Кулрата, преследуя Гасительницу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172560&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'586d1248-9c7b-4088-b44e-f4e4f0f6258b\', \'multiverseId\': 172560}, \'multiverseid\': 172560}, {\'name\': \'库拉斯骑士\', \'text\': \'飞行\\n干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\\n由对手操控、且上面有指示物的生物不能进行攻击或阻挡。\', \'type\': \'生物～元素／骑士\', \'flavor\': \'烬身乘座骑在库拉斯毁坏的山峰附近打转，想要追猎熄焰者。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173162&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8464de5b-a128-4d80-acaf-377fcafc4700\', \'multiverseId\': 173162}, \'multiverseid\': 173162}]', "[{'name': 'Kummertyrann', 'text': 'Der Kummertyrann kommt mit vier -1/-1-Marken ins Spiel.\\nWenn der Kummertyrann aus dem Spiel auf den Friedhof gelegt wird, lege für jede -1/-1-Marke auf ihm eine -1/-1-Marke auf eine Kreatur deiner Wahl.', 'type': 'Kreatur — Schrecken', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174666&type=card', 'language': 'German', 'identifiers': {'scryfallId': '65b170ba-b844-44e8-8496-8347ea95e3ae', 'multiverseId': 174666}, 'multiverseid': 174666}, {'name': 'Tirano de la aflicción', 'text': 'El Tirano de la aflicción entra en juego con cuatro contadores -1/-1 sobre él.\\nCuando el Tirano de la aflicción vaya a un cementerio desde el juego, pon un contador -1/-1 sobre la criatura objetivo por cada contador -1/-1 sobre el Tirano de la aflicción.', 'type': 'Criatura — Horror', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172860&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9f97b919-7a14-4a30-b511-54de65497e88', 'multiverseId': 172860}, 'multiverseid': 172860}, {'name': 'Tyran du chagrin', 'text': 'Le Tyran du chagrin arrive en jeu avec quatre marqueurs -1/-1 sur lui.\\nQuand le Tyran du chagrin est mis dans un cimetière depuis le jeu, mettez un marqueur -1/-1 sur la créature ciblée pour chaque marqueur -1/-1 sur le Tyran du chagrin.', 'type': 'Créature : horreur', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173462&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4b143e6c-8256-4262-a5ba-e0ed8741fd58', 'multiverseId': 173462}, 'multiverseid': 173462}, {'name': 'Tiranno del Dolore', 'text': 'Il Tiranno del Dolore entra in gioco con quattro segnalini -1/-1.\\nQuando il Tiranno del Dolore viene messo in un cimitero dal gioco, metti un segnalino -1/-1 su una creatura bersaglio per ogni segnalino -1/-1 che aveva il Tiranno del Dolore.', 'type': 'Creatura — Orrore', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173763&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'df49e51b-55d0-4ce8-a3ef-f897245b2a36', 'multiverseId': 173763}, 'multiverseid': 173763}, {'name': '悲嘆の暴君', 'text': '悲嘆の暴君は－１/－１カウンターが４個置かれた状態で場に出る。\\n悲嘆の暴君が場からいずれかの墓地に置かれたとき、クリーチャー１体を対象とする。それの上に、悲嘆の暴君の上に置かれていた－１/－１カウンター１個につき、－１/－１カウンターを１個置く。', 'type': 'クリーチャー — ホラー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174064&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ea799612-752b-49a9-bbfb-d6e5037e46c0', 'multiverseId': 174064}, 'multiverseid': 174064}, {'name': 'Tirano da Tristeza', 'text': 'Tirano da Tristeza entra em jogo com quatro marcadores -1/-1.\\nQuando Tirano da Tristeza for colocado no cemitério vindo do jogo, coloque um marcador -1/-1 na criatura alvo para cada marcador -1/-1 em Tirano da Tristeza.', 'type': 'Criatura — Horror', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172258&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e9b2f03a-e1e1-43ce-9eb9-85e3602f2dbe', 'multiverseId': 172258}, 'multiverseid': 172258}, {'name': 'Гореносный Тиран', 'text': 'Гореносный Тиран входит в игру с четырьмя жетонами -1/-1 на нем.\\nКогда Гореносный Тиран попадает из игры на кладбище, положите на целевое существо один жетон -1/-1 за каждый жетон -1/-1 на Гореносном Тиране.', 'type': 'Существо — Ужас', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172559&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'caa53347-32ae-48c2-8781-41fb86107ce5', 'multiverseId': 172559}, 'multiverseid': 172559}, {'name': '传悲暴君', 'text': '传悲暴君进场时上面有四个-1/-1指示物。\\n当传悲暴君从场上置入坟墓场时，其上每有一个-1/-1指示物，就在目标生物上放置一个-1/-1指示物。', 'type': '生物～惊惧兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173161&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ab70f499-544f-4c04-b481-01d2651198e8', 'multiverseId': 173161}, 'multiverseid': 173161}]", '[{\'name\': \'König der Schnitter\', \'text\': \'({2/W} kann mit zwei beliebigen Mana oder mit {W} bezahlt werden. Die umgewandelten Manakosten dieser Karte betragen 10.)\\nAndere Vogelscheuchen-Kreaturen, die du kontrollierst, erhalten +1/+1.\\nImmer wenn eine andere Vogelscheuche unter deiner Kontrolle ins Spiel kommt, zerstöre eine bleibende Karte deiner Wahl.\', \'type\': \'Legendäre Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Es ist Erntezeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174737&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4db47d18-0cfd-41bb-987a-41d48fdae034\', \'multiverseId\': 174737}, \'multiverseid\': 174737}, {\'name\': \'Rey segador\', \'text\': \'({2/W} puede pagarse con dos maná cualesquiera o con {W}. El costo de maná convertido de esta carta es 10.)\\nLas otras criaturas Espantapájaros que controlas obtienen +1/+1.\\nSiempre que otro Espantapájaros entre en juego bajo tu control, destruye el permanente objetivo.\', \'type\': \'Criatura artefacto legendaria — Espantapájaros\', \'flavor\': \'Es tiempo de cosecha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172931&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e27fd5f2-c919-4fb8-9cc0-7f61036ae84a\', \'multiverseId\': 172931}, \'multiverseid\': 172931}, {\'name\': \'Roi faucheur\', \'text\': "({2/W} peut être payé au choix avec n\'importe quelle combinaison de deux manas ou avec {W}. Le coût converti de mana de cette carte est 10.)\\nLes autres créatures Épouvantail que vous contrôlez gagnent +1/+1.\\nÀ chaque fois qu\'un autre épouvantail arrive en jeu sous votre contrôle, détruisez le permanent ciblé.", \'type\': \'Créature-artefact légendaire : épouvantail\', \'flavor\': "C\'est le temps de la récolte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173533&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'387c7554-9f81-4869-aff5-c6a66194a30f\', \'multiverseId\': 173533}, \'multiverseid\': 173533}, {\'name\': \'Re Mietitore\', \'text\': \'({2/W} può essere pagato con due mana qualsiasi o con {W}. Il costo di mana convertito di questa carta è 10.)\\nLe altre creature Spaventapasseri che controlli prendono +1/+1.\\nOgniqualvolta un altro Spaventapasseri entra in gioco sotto il tuo controllo, distruggi un permanente bersaglio.\', \'type\': \'Creatura Artefatto Leggendaria — Spaventapasseri\', \'flavor\': \'È tempo di mietitura.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173834&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f088bbcf-c119-47fe-9831-6739de6192d5\', \'multiverseId\': 173834}, \'multiverseid\': 173834}, {\'name\': \'刈り取りの王\', \'text\': \'（{2/W}は、任意の２マナか{W}で支払うことができる。 このカードの点数で見たマナ・コストは10である。）\\nあなたがコントロールする他のカカシ・クリーチャーは＋１/＋１の修整を受ける。\\n他のカカシがあなたのコントロール下で場に出るたび、パーマネント１つを対象とし、それを破壊する。\', \'type\': \'伝説のアーティファクト・クリーチャー — カカシ\', \'flavor\': \'刈りの時間だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174135&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'359cbcbb-234c-473a-97df-496e33b29626\', \'multiverseId\': 174135}, \'multiverseid\': 174135}, {\'name\': \'Rei Ceifador\', \'text\': \'({2/W} pode ser pago com quaisquer dois manas ou com {W}. O custo de mana convertido desse card é 10.)\\nAs outras criaturas do tipo Espantalho que você controla recebem +1/+1.\\nToda vez que outro Espantalho entrar em jogo sob seu controle, destrua a permanente alvo.\', \'type\': \'Criatura Artefato Lendária — Espantalho\', \'flavor\': \'É tempo de colheita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172329&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'690c7bb7-426b-4bd1-a712-1448e1513fbe\', \'multiverseId\': 172329}, \'multiverseid\': 172329}, {\'name\': \'Король Жнецов\', \'text\': \'(За {2/W} можно заплатить две любые маны или {W}. Конвертированная мана-стоимость этой карты равна 10.)\\nДругие существа-Пугала под вашим контролем получают +1/+1.\\nКаждый раз, когда другое Пугало входит в игру под вашим контролем, уничтожьте целевой перманент.\', \'type\': \'Легендарное Артефактное Существо — Пугало\', \'flavor\': \'Время собирать урожай.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172630&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f6f8a7ab-d89d-4d6d-998f-0f9c747b32c8\', \'multiverseId\': 172630}, \'multiverseid\': 172630}, {\'name\': \'夺命王者\', \'text\': \'（能用任意两点法术力或是{W}来支付{2/W}。 此牌的总法术力费用为10。）\\n由你操控的其他稻草人生物得+1/+1。\\n每当另一个稻草人在你的操控下进场时，消灭目标永久物。\', \'type\': \'传奇神器生物～稻草人\', \'flavor\': \'该收割了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173232&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'95a07e8f-9a17-4a5e-a5c5-fe8fa98adf89\', \'multiverseId\': 173232}, \'multiverseid\': 173232}]', '[{\'name\': \'Küchenhutzel\', \'text\': \'Wenn die Küchenhutzel ins Spiel kommen, erhältst du 2 Lebenspunkte dazu.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Buboh\', \'flavor\': \'Nimm eine gute Tat eines Bubohs an, und du bist gezwungen, auch noch eine zweite über dich ergehen zu lassen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174706&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65c78c2b-9e61-444f-8506-c61708cd8e89\', \'multiverseId\': 174706}, \'multiverseid\': 174706}, {\'name\': \'Despreciables de cocina\', \'text\': \'Cuando los Despreciables de cocina entren en juego, gana 2 vidas.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Oufé\', \'flavor\': \'Acepta un favor de un oufé y estás condenado a aceptar otro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172900&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13d23c30-add7-4b79-8a0e-6c8f2bed25e4\', \'multiverseId\': 172900}, \'multiverseid\': 172900}, {\'name\': \'Fourbes de cuisine\', \'text\': "Quand les Fourbes de cuisine arrivent en jeu, vous gagnez 2 points de vie.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : orphe\', \'flavor\': "Acceptez une faveur d\'un orphe, et vous êtes condamné à le faire à nouveau.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173502&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'54ee0738-1d59-4842-96ad-48b00428d2c5\', \'multiverseId\': 173502}, \'multiverseid\': 173502}, {\'name\': \'Crumiri della Cucina\', \'text\': \'Quando i Crumiri della Cucina entrano in gioco, guadagni 2 punti vita.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Ouphe\', \'flavor\': \'Accetta un favore da un ouphe e sarai destinato a doverne accettare ancora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173803&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'77013862-a3c8-4a82-9345-5e608dadb3fe\', \'multiverseId\': 173803}, \'multiverseid\': 173803}, {\'name\': \'台所の嫌がらせ屋\', \'text\': \'台所の嫌がらせ屋が場に出たとき、あなたは２点のライフを得る。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — アウフ\', \'flavor\': \'アウフの頼みを一つ引き受たら、さらに引き受ける羽目になる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174104&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81e30df3-8113-4746-a0da-43c79d2d1464\', \'multiverseId\': 174104}, \'multiverseid\': 174104}, {\'name\': \'Informantes de Cozinha\', \'text\': \'Quando Informantes de Cozinha entra em jogo, você ganha 2 pontos de vida.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Trasgo\', \'flavor\': \'Aceite um favor de um trasgo e você estará fadado a aceitar outro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172298&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6a6152e9-a7f1-4d7f-902f-fb555ac581db\', \'multiverseId\': 172298}, \'multiverseid\': 172298}, {\'name\': \'Кухонные Прохвосты\', \'text\': \'Когда Кухонные Прохвосты входят в игру, вы получаете 2 жизни.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Уф\', \'flavor\': \'Если позволить уфу сделать одно одолжение, то второго не избежать.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172599&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'97743063-cacd-4a89-ad55-e8ee090e278c\', \'multiverseId\': 172599}, \'multiverseid\': 172599}, {\'name\': \'帮厨奥夫\', \'text\': \'当帮厨奥夫进场时，你获得2点生命。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～奥夫\', \'flavor\': \'接受一次奥夫的好意，你就注定倒楣得接受第二次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173201&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2f71a591-ba11-4539-908f-0d5981862757\', \'multiverseId\': 173201}, \'multiverseid\': 173201}]', '[{\'name\': \'Leckerbissenhamsterer\', \'text\': \'Der Leckerbissenhamsterer kommt mit zwei -1/-1-Marken ins Spiel.\\nEntferne eine -1/-1-Marke vom Leckerbissenhamsterer: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Er durchsucht die Hügel nach allem, was lebt, und genießt selbst den Geschmack von Giftpilzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174689&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d704f599-dbd3-41d3-a82a-a41217d7ca74\', \'multiverseId\': 174689}, \'multiverseid\': 174689}, {\'name\': \'Guardabocados\', \'text\': \'El Guardabocados entra en juego con dos contadores -1/-1 sobre él.\\nRemover un contador -1/-1 del Guardabocados: Agrega un maná de cualquier color a tu reserva de maná.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Depura las colinas de materia viva, saboreando hasta el gusto de los hongos venenosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172883&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a03c101f-a8ac-4a88-a5ca-d49700a7b63d\', \'multiverseId\': 172883}, \'multiverseid\': 172883}, {\'name\': \'Entassemanne\', \'text\': "L\'Entassemanne arrive en jeu avec deux marqueurs -1/-1 sur lui.\\nRetirez un marqueur -1/-1 de l\'Entassemanne : Ajoutez un mana de la couleur de votre choix à votre réserve.", \'type\': \'Créature : élémental\', \'flavor\': "Il récure toute matière vivante sur les collines, savourant même l\'amertume des champignons vénéneux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173485&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3afa062b-fb27-4597-be52-bdc86d628d38\', \'multiverseId\': 173485}, \'multiverseid\': 173485}, {\'name\': \'Ammassagruzzoli\', \'text\': "L\'Ammassagruzzoli entra in gioco con due segnalini -1/-1.\\nRimuovi un segnalino -1/-1 dall\'Ammassagruzzoli: Aggiungi un mana di qualsiasi colore alla tua riserva di mana.", \'type\': \'Creatura — Elementale\', \'flavor\': \'Setaccia le colline in cerca di materia vivente, assaporando persino il veleno dei funghi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173786&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'df9906a6-757c-40c3-927a-796afea89897\', \'multiverseId\': 173786}, \'multiverseid\': 173786}, {\'name\': \'つまみ食い貯め\', \'text\': \'つまみ食い貯めは－１/－１カウンターが２個置かれた状態で場に出る。\\nつまみ食い貯めから－１/－１カウンターを１個取り除く：あなたのマナ・プールに好きな色１色のマナ１点を加える。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'それは丘じゅうを生き物を求めて探し回り、毒茸の臭いさえも喜びとした。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174087&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'975d632c-efe6-49e6-99e9-2b98bd9ee659\', \'multiverseId\': 174087}, \'multiverseid\': 174087}, {\'name\': \'Abocanhador\', \'text\': \'Abocanhador entra em jogo com dois marcadores -1/-1.\\nRemova um marcador -1/-1 de Abocanhador: Adicione um mana de qualquer cor à sua reserva de mana.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Ele vasculha as colinas em busca de matéria viva, saboreando até mesmo o amargor dos fungos venenosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172281&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'33a36e5e-bada-47d1-a6e2-5bbbd12de8db\', \'multiverseId\': 172281}, \'multiverseid\': 172281}, {\'name\': \'Собиратель Лакомых Кусков\', \'text\': \'Собиратель Лакомых Кусков входит в игру с двумя жетонами -1/-1 на нем.\\nУдалите один жетон -1/-1 с Собирателя Лакомых Кусков: добавьте одну ману любого цвета в ваше хранилище маны.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Он прочесывает холмы в поисках живой материи, смакуя даже горечь ядовитых грибов.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172582&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ea037a9c-5f73-443b-b315-72ac185ef5bb\', \'multiverseId\': 172582}, \'multiverseid\': 172582}, {\'name\': \'藏馐灵\', \'text\': \'藏馐灵进场时上面有两个-1/-1指示物。\\n从藏馐灵上移去一个-1/-1指示物：加一点任意颜色的法术力到你的法术力池中。\', \'type\': \'生物～元素\', \'flavor\': \'它在山丘上搜索活物，连毒蕈的气味都不放过。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173184&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f8265dfd-7840-4b60-aa6a-3483e0fe5a18\', \'multiverseId\': 173184}, \'multiverseid\': 173184}]', '[{\'name\': \'Lehmkrustenriese\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': \'Riesen schlafen tief und lang — manchmal sogar so lang, dass eine Schicht aus Moos und Dreck über sie wächst. Doch irgendetwas beendet immer und unvermeidlich ihren Schlaf, und sie sind beim Aufwachen daher nicht wirklich glücklich.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174687&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'47b72fc5-bf7f-4328-a90a-5e11c4af865b\', \'multiverseId\': 174687}, \'multiverseid\': 174687}, {\'name\': \'Gigante arrastrabarro\', \'type\': \'Criatura — Guerrero gigante\', \'flavor\': \'Los gigantes duermen tanto tiempo que una capa de tierra y musgo crece sobre ellos. Pero inevitablemente alguien perturba su sueño, y no se despiertan felices.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172881&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f2a83f88-a0dc-450b-a053-d50fb0bd029c\', \'multiverseId\': 172881}, \'multiverseid\': 172881}, {\'name\': \'Géant traîne-terreau\', \'type\': \'Créature : géant et guerrier\', \'flavor\': "Les géants ont un sommeil aussi lourd que long, au point que parfois, une croûte de terre et de mousse les recouvre. Mais quelque chose vient invariablement troubler leur sommeil, et ils s\'éveillent, de mauvaise humeur.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173483&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b319d7de-3b18-4a29-a920-ab1d810ca426\', \'multiverseId\': 173483}, \'multiverseid\': 173483}, {\'name\': \'Gigante Trascinaterra\', \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': \'I giganti dormono profondamente e a lungo, talvolta tanto a lungo da far crescere zolle di terra e muschio sopra di essi. Ma inevitabilmente qualcosa disturba il loro riposo e si svegliano scontenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173784&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b025a65-644f-42a4-87d5-ad7e630bc658\', \'multiverseId\': 173784}, \'multiverseid\': 173784}, {\'name\': \'土引きずりの巨人\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': \'巨人は長くぐっすりと眠る。時にはそれが長すぎて、上に土が積もり苔が生す事もある。 しかし、何かが否応なくその眠りを覚ますとき、彼らの機嫌は良くはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174085&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b90afcad-6af5-4e4a-95de-d9ffcefe4cde\', \'multiverseId\': 174085}, \'multiverseid\': 174085}, {\'name\': \'Gigante Reboca-Musgo\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': \'Os gigantes têm um sono longo e profundo, algumas vezes tão longo que cresce uma crosta de terra e um pouco de musgo sobre eles. Mas, inevitavelmente, algo perturba seu sono e eles acordam contrariados.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172279&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'63dc7759-219e-47f7-891f-7735cefefcc1\', \'multiverseId\': 172279}, \'multiverseid\': 172279}, {\'name\': \'Гигант с Земляным Шлейфом\', \'type\': \'Существо — Гигант Воин\', \'flavor\': \'Гиганты спят крепко и долго, иногда так долго, что покрываются землей и обрастают мхом. Но, неизбежно, что-нибудь нарушает их глубокий сон, и они просыпаются раздраженные и злые.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172580&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8c14d90e-f487-41c6-a3e9-7d7a65994632\', \'multiverseId\': 172580}, \'multiverseid\': 172580}, {\'name\': \'曳土巨人\', \'type\': \'生物～巨人／战士\', \'flavor\': \'巨人睡得又熟又长，甚至会到身上覆满泥土、青苔遍布的程度。 但终究会有人打扰他们的安眠，让他们不高兴地醒来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173182&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'50b2e50b-8e21-4ff1-8f0c-38e4685668c9\', \'multiverseId\': 173182}, \'multiverseid\': 173182}]', '[{\'name\': \'Leichenverbrenner aus Cragganwick\', \'text\': \'Wenn der Leichenverbrenner aus Cragganwick ins Spiel kommt, wirf eine zufällig bestimmte Karte aus deiner Hand ab. Falls du auf diese Weise eine Kreaturenkarte abgeworfen hast, fügt der Leichenverbrenner aus Cragganwick einem Spieler deiner Wahl Schadenspunkte in Höhe der Stärke dieser Karte zu.\', \'type\': \'Kreatur — Riese, Schamane\', \'flavor\': \'In jeder Nacht, in der sich seine Schale füllt, trauert ein Dorf.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174564&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'074b3637-a066-48d6-b773-83b321ee3991\', \'multiverseId\': 174564}, \'multiverseid\': 174564}, {\'name\': \'Incinerador de Cragganwick\', \'text\': \'Cuando el Incinerador de Cragganwick entre en juego, descarta una carta al azar. Si descartas una carta de criatura de esta manera, el Incinerador de Cragganwick hace una cantidad de daño igual a la fuerza de esa carta al jugador objetivo.\', \'type\': \'Criatura — Chamán gigante\', \'flavor\': \'Cada noche que su cuenco se llena, un pueblo está de luto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172758&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'058e51e1-b735-4e37-8b88-aa4a3c09fe8b\', \'multiverseId\': 172758}, \'multiverseid\': 172758}, {\'name\': \'Incinérateur de Ciergeroc\', \'text\': "Quand l\'Incinérateur de Ciergeroc arrive en jeu, défaussez-vous au hasard d\'une carte. Si vous vous défaussez d\'une carte de créature de cette manière, l\'Incinérateur de Ciergeroc inflige au joueur ciblé un nombre de blessures égal à la force de cette carte.", \'type\': \'Créature : géant et shamane\', \'flavor\': \'Un village pleure chaque nuit où son bol se remplit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173360&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'838f3081-b421-4cf6-b31b-1097a3f0f9b6\', \'multiverseId\': 173360}, \'multiverseid\': 173360}, {\'name\': \'Crematore di Cragganwick\', \'text\': \'Quando il Crematore di Cragganwick entra in gioco, scarta una carta a caso. Se scarti una carta creatura in questo modo, il Crematore di Cragganwick infligge danno pari alla forza di quella carta a un giocatore bersaglio.\', \'type\': \'Creatura — Sciamano Gigante\', \'flavor\': \'Ogni notte in cui la sua pentola si riempie, un villaggio è in lutto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173661&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'32ca5480-fb3d-4c63-b04b-466f157fc120\', \'multiverseId\': 173661}, \'multiverseid\': 173661}, {\'name\': \'クラガンウィックの死体焼却者\', \'text\': \'クラガンウィックの死体焼却者が場に出たとき、プレイヤー１人を対象とする。あなたはカードを１枚無作為に選んで捨てる。 これによりあなたがクリーチャー・カードを捨てた場合、クラガンウィックの死体焼却者はそのカードのパワーに等しい点数のダメージをそのプレイヤーに与える。\', \'type\': \'クリーチャー — 巨人・シャーマン\', \'flavor\': \'彼の鉢が満たされる夜毎、村は死者を悼む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173962&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'99456d06-bec6-4a3d-bcc7-60da1960f32b\', \'multiverseId\': 173962}, \'multiverseid\': 173962}, {\'name\': \'Cremador de Cragganwick\', \'text\': \'Quando Cremador de Cragganwick entrar em jogo, descarte um card aleatoriamente. Se você descartar um card de criatura desse modo, Cremador de Cragganwick causará dano igual ao poder daquele card ao jogador alvo.\', \'type\': \'Criatura — Gigante Xamã\', \'flavor\': \'Há um vilarejo de luto para cada noite em que sua vasilha é preenchida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172156&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1c3f189f-4a90-4890-b3d7-da8cacec0827\', \'multiverseId\': 172156}, \'multiverseid\': 172156}, {\'name\': \'Сжигатель из Крагганвика\', \'text\': \'Когда Сжигатель из Крагганвика входит в игру, сбросьте случайно выбранную карту. Если вы сбрасываете таким образом карту существа, Сжигатель из Крагганвика наносит целевому игроку повреждения, равные силе той карты.\', \'type\': \'Существо — Гигант Шаман\', \'flavor\': \'В ночь, когда его чаша наполняется до краев, одна из деревушек надевает траур.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172457&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'86c1768e-8f68-485f-8909-01550249c8b9\', \'multiverseId\': 172457}, \'multiverseid\': 172457}, {\'name\': \'喀干伟火葬师\', \'text\': \'当喀干伟火葬师进场时，随机弃一张牌。 如果你以此法弃掉一张生物牌，则喀干伟火葬师对目标牌手造成伤害，其数量等同于该牌的力量。\', \'type\': \'生物～巨人／祭师\', \'flavor\': \'在他享受丰盛晚餐时，会有个村子整夜哀悼。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173059&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68607682-3bc4-4e78-ba50-50fa683c37b6\', \'multiverseId\': 173059}, \'multiverseid\': 173059}]', '[{\'name\': \'Leidabsauger\', \'text\': \'{W}, {T}: Entferne eine -1/-1-Marke von einer Kreatur deiner Wahl. Falls du dies tust, erhältst du 2 Lebenspunkte dazu.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Der eine Kopf spürt den Fluch auf. Der zweite löst ihn von der Seele. Der dritte verschlingt ihn wie einen erfrischenden Dunst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174504&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4f707e27-5d72-43b7-b252-463c22004a34\', \'multiverseId\': 174504}, \'multiverseid\': 174504}, {\'name\': \'Sanguijuela de miseria\', \'text\': \'{W}, {T}: Remueve un contador -1/-1 de la criatura objetivo. Si lo haces, ganas 2 vidas.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Una cabeza detecta la maldición. La segunda la libera del alma. La tercera la aspira como una niebla perfumada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172698&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'22271e51-976d-4bbf-9694-8070f413a81f\', \'multiverseId\': 172698}, \'multiverseid\': 172698}, {\'name\': \'Sangsue du malheur\', \'text\': \'{W}, {T} : Retirez un marqueur -1/-1 à la créature ciblée. Si vous faites ainsi, vous gagnez 2 points de vie.\', \'type\': \'Créature : élémental\', \'flavor\': "Une tête repère la malédiction. La deuxième l\'extrait de l\'âme. La troisième l\'aspire sous forme d\'une brume revigorante.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173300&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'effe7683-464d-484b-a643-88c5b9cb6d01\', \'multiverseId\': 173300}, \'multiverseid\': 173300}, {\'name\': \'Divoratore di Disgrazie\', \'text\': \'{W}, {T}: Rimuovi un segnalino -1/-1 da una creatura bersaglio. Se lo fai, guadagni 2 punti vita.\', \'type\': \'Creatura — Elementale\', \'flavor\': "Una testa percepisce la maledizione. La seconda la libera dall\'anima. La terza la beve come un fluido rinvigorente.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173601&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'23ec6332-a8ff-403a-bb39-aa1427a43d9b\', \'multiverseId\': 173601}, \'multiverseid\': 173601}, {\'name\': \'悲哀吸い\', \'text\': \'{W}, {T}：クリーチャー１体を対象とし、それの上に置かれている－１/－１カウンターを１個取り除く。 そうした場合、あなたは２点のライフを得る。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'一つめの頭は呪いを感知する。 二つめはそれを魂から解き放つ。 三つめはそれを強壮の霧として飲み込む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173902&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'02654594-1dd5-4410-aa99-8ce892b50780\', \'multiverseId\': 173902}, \'multiverseid\': 173902}, {\'name\': \'Suga-Desgraça\', \'text\': \'{W}, {T}: Remova um marcador -1/-1 da criatura alvo. Se fizer isso, você ganhará 2 pontos de vida.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Uma cabeça reconhece a maldição. A segunda a libera da alma. A terceira a bebe como uma névoa revigorante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172096&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bb27d933-969f-4e1c-8c6c-93ef2e649264\', \'multiverseId\': 172096}, \'multiverseid\': 172096}, {\'name\': \'Поглотитель Невзгод\', \'text\': \'{W}, {T}: удалите один жетон -1/-1 с целевого существа. Если вы это делаете, вы получаете 2 жизни.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Первая голова чует проклятье. Вторая отделяет его от души. Третья же пьет его, словно живительную влагу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172397&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8b8b2249-583c-4253-b20c-2ec062de10ce\', \'multiverseId\': 172397}, \'multiverseid\': 172397}, {\'name\': \'消灾蛭灵\', \'text\': \'{W}，{T}：从目标生物上移去一个-1/-1指示物。 若你如此作，则你获得2点生命。\', \'type\': \'生物～元素\', \'flavor\': \'第一个头感受到诅咒。 第二个头将它自心灵松脱。 第三个头将它一饮而尽，宛如提神之雾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172999&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1ff4e224-ad80-4ae0-bffa-c6904613e0dd\', \'multiverseId\': 172999}, \'multiverseid\': 172999}]', '[{\'name\': \'Letzter Atemzug\', \'text\': \'Entferne eine Kreatur deiner Wahl mit Stärke 2 oder weniger ganz aus dem Spiel. Ihr Beherrscher erhält 4 Lebenspunkte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Na sowas. Man hätte glauben können, dass diese garstigen Merrow wüssten, wie man die Luft anhält." —Olka, Nebelwiesenhexe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174488&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6dba981e-7e9f-4213-9309-43eac431c778\', \'multiverseId\': 174488}, \'multiverseid\': 174488}, {\'name\': \'Último aliento\', \'text\': \'Remueve del juego la criatura objetivo con fuerza de 2 o menos. Su controlador gana 4 vidas.\', \'type\': \'Instantáneo\', \'flavor\': \'"Tsk. Uno creería que esos feos merrow sabrían cómo aguantar la respiración." —Olka, bruja de Pradera Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172682&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d8ba717f-6b1a-4b57-8cdb-6d9d0f990657\', \'multiverseId\': 172682}, \'multiverseid\': 172682}, {\'name\': \'Dernier souffle\', \'text\': \'Retirez de la partie la créature ciblée de force 2 ou moins. Son contrôleur gagne 4 points de vie.\', \'type\': \'Éphémère\', \'flavor\': \'« Tsss. On pourrait croire que ces horribles suires sauraient retenir leur respiration. » —Olka, envoûteuse de Brumeprairie\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173284&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7f96e190-ad30-4adf-9367-c3a90d4cbdc1\', \'multiverseId\': 173284}, \'multiverseid\': 173284}, {\'name\': \'Ultimo Respiro\', \'text\': \'Rimuovi dal gioco una creatura bersaglio con forza pari o inferiore a 2. Il suo controllore guadagna 4 punti vita.\', \'type\': \'Istantaneo\', \'flavor\': \'"Tsk. Penseresti che questi odiosi merrow sappiano almeno come trattenere il respiro." —Olka, strega della Prateria Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173585&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'73e0a64a-cbd3-4543-a43a-484d163c3536\', \'multiverseId\': 173585}, \'multiverseid\': 173585}, {\'name\': \'今わの際\', \'text\': \'パワーが２以下のクリーチャー１体を対象とし、それをゲームから取り除く。 そのコントローラーは４点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'「チッ。 あのいやらしいメロウどもなら息を止める方法を知ってると思ってたんだがね。」 ――ミストメドウの魔女、オルカ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173886&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ab9f1713-71cc-496d-a6e4-19e52f7bc245\', \'multiverseId\': 173886}, \'multiverseid\': 173886}, {\'name\': \'Último Fôlego\', \'text\': \'Remova do jogo a criatura alvo com poder menor ou igual a 2. O controlador dela ganha 4 pontos de vida.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'" Aqueles sirenídeos perversos deveriam saber como prender o fôlego." — Olka, bruxa de nevoplanície\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172080&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ac3565dc-aedc-499c-a37e-92f8cb9c3690\', \'multiverseId\': 172080}, \'multiverseid\': 172080}, {\'name\': \'Последний Выдох\', \'text\': \'Удалите из игры целевое существо с силой 2 или меньше. Контролирующий его игрок получает 4 жизни.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Ну-ну, а ведь эти гадкие мерроу вроде бы должны уметь задерживать дыхание». — Олка, ведьма из Туманолужья\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172381&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'47666489-cf16-4ef9-8953-b753eda8072d\', \'multiverseId\': 172381}, \'multiverseid\': 172381}, {\'name\': \'咽气\', \'text\': \'将目标力量等于或小于2的生物移出对战。 其操控者获得4点生命。\', \'type\': \'瞬间\', \'flavor\': \'「啐。 还以为这些鬼祟的美洛有办法屏息多久呢。」 ～雾牧地法术师欧卡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172983&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'72df0a4a-d968-491a-a1dc-551cc99a749d\', \'multiverseId\': 172983}, \'multiverseid\': 172983}]', '[{\'name\': \'Leuchtholzeiche\', \'text\': \'{R/G}{R/G}{R/G}: Die Leuchtholzeiche erhält +3/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Baumhirte, Schamane\', \'flavor\': \'„Die Brüder werden in einem unnatürlichen Feuer brennen, und die Flammen werden unseren Zorn verzehren und reinigen." —Gruselgeschichte der Baumhirten\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174592&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5bdb0fba-085b-4902-8873-c7baee111a44\', \'multiverseId\': 174592}, \'multiverseid\': 174592}, {\'name\': \'Roble luminiscente\', \'text\': \'{R/G}{R/G}{R/G}: El Roble luminiscente obtiene +3/+0 hasta el final del turno.\', \'type\': \'Criatura — Chamán pueblo-arbóreo\', \'flavor\': \'"Los hermanos arderán con fuego sobrenatural, y las llamas consumirán y purificarán nuestra ira." —Mito arbóreo de la catástrofe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172786&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8599293f-8839-4297-b24b-e1b04ad609f2\', \'multiverseId\': 172786}, \'multiverseid\': 172786}, {\'name\': \'Chêne aux chromophores\', \'text\': "{R/G}{R/G}{R/G} : Le Chêne aux chromophores gagne +3/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : sylvin et shamane\', \'flavor\': "« Les frères s\'embraseront d\'un feu surnaturel, et les flammes purificatrices consumeront notre rage. » —Mythe du Désastre sylvin", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173388&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'828bf400-df87-4aac-a2cb-42c4719c97f5\', \'multiverseId\': 173388}, \'multiverseid\': 173388}, {\'name\': \'Quercia Infiammata\', \'text\': \'{R/G}{R/G}{R/G}: La Quercia Infiammata prende +3/+0 fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Silvantropo\', \'flavor\': \'"I miei fratelli si incendieranno di un fuoco innaturale e le fiamme consumeranno e purificheranno la nostra furia." —Mito della catastrofe dei silvantropi\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173689&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6cabf654-de9a-4508-8565-03272f82219a\', \'multiverseId\': 173689}, \'multiverseid\': 173689}, {\'name\': \'狐火の樫\', \'text\': \'{R/G}{R/G}{R/G}：狐火の樫はターン終了時まで＋３/＋０の修整を受ける。\', \'type\': \'クリーチャー — ツリーフォーク・シャーマン\', \'flavor\': \'「輩は尋常ならざる猛火に焼かれ、炎は我等の怒りを吸い上げ清めるであろう。」 ――樹人の終末神話\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173990&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cd488a81-7ef0-4690-a616-c3dd2c0981fa\', \'multiverseId\': 173990}, \'multiverseid\': 173990}, {\'name\': \'Carvalho do Fogo-Fátuo\', \'text\': \'{R/G}{R/G}{R/G}: Carvalho do Fogo-Fátuo recebe +3/+0 até o final do turno.\', \'type\': \'Criatura — Ent Xamã\', \'flavor\': \'"Os irmãos arderão com um fogo sobrenatural, e a chama consumirá e purificará nossa ira." — Mito de catástrofe dos ents\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172184&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'816920e9-371b-415a-a85b-33bd3876ae41\', \'multiverseId\': 172184}, \'multiverseid\': 172184}, {\'name\': \'Дуб-Гнилушка\', \'text\': \'{R/G}{R/G}{R/G}: Дуб-Гнилушка получает +3/+0 до конца хода.\', \'type\': \'Существо — Лесовик Шаман\', \'flavor\': \'«И братья вспыхнут странным огнем, и это пламя поглотит и искупит наш гнев». — Лесовики: миф о Катастрофе\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172485&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c051dc3a-7c18-4420-a849-8e9b88fc4290\', \'multiverseId\': 172485}, \'multiverseid\': 172485}, {\'name\': \'狐火橡树\', \'text\': \'{R/G}{R/G}{R/G}：狐火橡树得+3/+0直到回合结束。\', \'type\': \'生物～树妖／祭师\', \'flavor\': \'「弟兄将绽放超凡火焰，将我们的愤怒吞噬并净化。」 ～树妖末世谭\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173087&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'47d232dc-b0bd-40d0-aa7c-008e41ef4e4f\', \'multiverseId\': 173087}, \'multiverseid\': 173087}]', "[{'name': 'Loch im Kopf', 'text': 'Neutralisiere einen Zauberspruch deiner Wahl. Durchsuche den Friedhof, die Hand und die Bibliothek seines Besitzers nach allen Karten mit dem gleichen Namen wie jener Zauberspruch und entferne sie ganz aus dem Spiel. Dieser Spieler mischt dann seine Bibliothek.', 'type': 'Spontanzauber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174510&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aaa6e3b7-32cb-4708-8c08-018b5800b7fa', 'multiverseId': 174510}, 'multiverseid': 174510}, {'name': 'Contrataladro', 'text': 'Contrarresta el hechizo objetivo. Busca en el cementerio, mano y biblioteca de su controlador todas las cartas con el mismo nombre que ese hechizo y remuévelas del juego. Luego ese jugador baraja su biblioteca.', 'type': 'Instantáneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172704&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '38d2d465-a0f5-4f8b-9745-5a35df4c73e7', 'multiverseId': 172704}, 'multiverseid': 172704}, {'name': 'Contreforet', 'text': 'Contrecarrez le sort ciblé. Cherchez dans le cimetière, la main et la bibliothèque de son contrôleur toutes les cartes ayant le même nom que ce sort et retirez-les de la partie. Ce joueur mélange ensuite sa bibliothèque.', 'type': 'Éphémère', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173306&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2f1c06df-ba17-4943-8c00-2758651cd218', 'multiverseId': 173306}, 'multiverseid': 173306}, {'name': 'Foro Neutralizzatore', 'text': 'Neutralizza una magia bersaglio. Passa in rassegna il cimitero, la mano e il grimorio del suo controllore per tutte le carte con lo stesso nome di quella magia e rimuovile dal gioco. Poi quel giocatore rimescola il suo grimorio.', 'type': 'Istantaneo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173607&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'a71dbd07-fa17-45e5-9a8f-24e2f7785054', 'multiverseId': 173607}, 'multiverseid': 173607}, {'name': '呪文穿ち', 'text': '呪文１つを対象とし、それを打ち消す。 それのコントローラーの墓地と手札とライブラリーから、その呪文と同じ名前を持つカードをすべて探し、それらをゲームから取り除く。 その後、そのプレイヤーは自分のライブラリーを切り直す。', 'type': 'インスタント', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173908&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7f46e37d-8834-4f5e-a6f0-ca2614ab996d', 'multiverseId': 173908}, 'multiverseid': 173908}, {'name': 'Nuliperfurador', 'text': 'Anule a mágica alvo. Procure no cemitério, na mão e no grimório de seu controlador por todos os cards com o mesmo nome daquela mágica e remova-os de jogo. Depois, aquele jogador embaralha seu próprio grimório.', 'type': 'Mágica Instantânea', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172102&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '233577cc-40f9-43fd-8919-687d41ce9b68', 'multiverseId': 172102}, 'multiverseid': 172102}, {'name': 'Высверливание', 'text': 'Отмените целевое заклинание. Найдите на кладбище, в руке и в библиотеке контролирующего его игрока все карты с тем же именем, что и то заклинание, и удалите их из игры. Затем тот игрок тасует свою библиотеку.', 'type': 'Мгновенное заклинание', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172403&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7387716b-d8bd-4ed1-8b62-2e7ce384b613', 'multiverseId': 172403}, 'multiverseid': 172403}, {'name': '反击锥孔', 'text': '反击目标咒语。 自其操控者的坟墓场、手牌、以及牌库中搜寻与该咒语同名的牌，并将这些牌移出对战。 然后该牌手将他的牌库洗牌。', 'type': '瞬间', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173005&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6f0bf59a-257c-410b-918d-17e94e6a870c', 'multiverseId': 173005}, 'multiverseid': 173005}]", '[{\'name\': \'Loderdorn-Vogelscheuche\', \'text\': \'Die Loderdorn-Vogelscheuche hat Eile, solange du eine rote Kreatur kontrollierst.\\nDie Loderdorn-Vogelscheuche hat Verdorren, solange du eine grüne Kreatur kontrollierst. (Sie fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174723&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'180e53df-84b6-4d6b-a32a-f90910f5179a\', \'multiverseId\': 174723}, \'multiverseid\': 174723}, {\'name\': \'Espantapájaros espinas ardientes\', \'text\': \'El Espantapájaros espinas ardientes tiene la habilidad de prisa mientras controles una criatura roja.\\nEl Espantapájaros espinas ardientes tiene la habilidad de debilitar mientras controles una criatura verde. (Hace daño a las criaturas en forma de contadores -1/-1.)\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172917&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'74fe285d-6f70-4be5-a3f1-afd590a8a4a3\', \'multiverseId\': 172917}, \'multiverseid\': 172917}, {\'name\': \'Épouvantail brasépine\', \'text\': "L\'Épouvantail brasépine a la célérité tant que vous contrôlez une créature rouge.\\nL\'Épouvantail brasépine a la flétrissure tant que vous contrôlez une créature verte. (Il inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173519&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'57699417-ac5d-4970-8b07-6ece9e14a51f\', \'multiverseId\': 173519}, \'multiverseid\': 173519}, {\'name\': \'Spaventapasseri Fiammaspina\', \'text\': \'Lo Spaventapasseri Fiammaspina ha rapidità fintanto che controlli una creatura rossa.\\nLo Spaventapasseri Fiammaspina ha avvizzire fintanto che controlli una creatura verde. (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173820&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a49794a1-3622-44d7-b617-5ea9985106ed\', \'multiverseId\': 173820}, \'multiverseid\': 173820}, {\'name\': \'猛火茨のカカシ\', \'text\': \'猛火茨のカカシは、あなたが赤のクリーチャーをコントロールしているかぎり速攻を持つ。\\n猛火茨のカカシは、あなたが緑のクリーチャーをコントロールしているかぎり萎縮を持つ。 （それはクリーチャーに－１/－１カウンターの形でダメージを与える。）\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174121&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f3b97e5-5257-4fd2-a044-c4879536a14d\', \'multiverseId\': 174121}, \'multiverseid\': 174121}, {\'name\': \'Espantalho do Espinho Ardente\', \'text\': \'Espantalho do Espinho Ardente tem ímpeto enquanto você controlar uma criatura vermelha.\\nEspantalho do Espinho Ardente tem murchar enquanto você controlar uma criatura verde. (Ele causa dano a criaturas na forma de marcadores -1/-1.)\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172315&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4518833c-f76f-404f-9d5e-ed6ae1525169\', \'multiverseId\': 172315}, \'multiverseid\': 172315}, {\'name\': \'Жгучее Пугало\', \'text\': \'Жгучее Пугало имеет Ускорение, пока вы контролируете красное существо.\\nЖгучее Пугало имеет Увядание, пока вы контролируете зеленое существо. (Оно наносит повреждения существам в виде жетонов -1/-1.)\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172616&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aaf1aa4c-2055-45dd-8c49-7640cc317900\', \'multiverseId\': 172616}, \'multiverseid\': 172616}, {\'name\': \'焰荆稻草人\', \'text\': \'只要你操控红色生物，焰荆稻草人便具有敏捷异能。\\n只要你操控绿色生物，焰荆稻草人便具有干枯异能。 （它会以-1/-1指示物的方式对生物造成伤害。）\', \'type\': \'神器生物～稻草人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173218&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16c8ab73-908b-4c61-b20d-51a258367b8f\', \'multiverseId\': 173218}, \'multiverseid\': 173218}]', '[{\'name\': \'Loderrassel-Vogelscheuche\', \'text\': \'Die Loderrassel-Vogelscheuche hat Beharrlichkeit, solange du eine schwarze Kreatur kontrollierst. (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\\nDie Loderrassel-Vogelscheuche hat Eile, solange du eine rote Kreatur kontrollierst.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174736&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0f831bab-c616-4fc3-9f22-daf3d56bce28\', \'multiverseId\': 174736}, \'multiverseid\': 174736}, {\'name\': \'Espantapájaros traqueteo ardiente\', \'text\': \'El Espantapájaros traqueteo ardiente tiene la habilidad de persistir mientras controles una criatura negra. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\\nEl Espantapájaros traqueteo ardiente tiene la habilidad de prisa mientras controles una criatura roja.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172930&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ac3a9b8a-4e5f-4672-921b-353101e73d6e\', \'multiverseId\': 172930}, \'multiverseid\': 172930}, {\'name\': \'Épouvantail trémulefeu\', \'text\': "L\'Épouvantail trémulefeu a la persistance tant que vous contrôlez une créature noire. (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)\\nL\'Épouvantail trémulefeu a la célérité tant que vous contrôlez une créature rouge.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173532&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'46a460ae-0b5c-430d-8a45-7e92f7b63460\', \'multiverseId\': 173532}, \'multiverseid\': 173532}, {\'name\': \'Spaventapasseri Scuotifiamma\', \'text\': \'Lo Spaventapasseri Scuotifiamma ha persistere fintanto che controlli una creatura nera. (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\\nLo Spaventapasseri Scuotifiamma ha rapidità fintanto che controlli una creatura rossa.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173833&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2fb3fded-d1d0-4bbb-af4c-4ee6c0a5d5b3\', \'multiverseId\': 173833}, \'multiverseid\': 173833}, {\'name\': \'鳴らし猛火のカカシ\', \'text\': \'鳴らし猛火のカカシは、あなたが黒のクリーチャーをコントロールしているかぎり頑強を持つ。 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\\n鳴らし猛火のカカシは、あなたが赤のクリーチャーをコントロールしているかぎり速攻を持つ。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174134&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6d0305ab-86d1-4d8b-9624-b7b0db8c5a08\', \'multiverseId\': 174134}, \'multiverseid\': 174134}, {\'name\': \'Espantalho da Sucata Flamejante\', \'text\': \'Espantalho da Sucata Flamejante terá persistir enquanto você controlar uma criatura preta. (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\\nEspantalho da Sucata Flamejante terá ímpeto enquanto você controlar uma criatura vermelha.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172328&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fec791f9-77ed-422c-91fa-910001504ae5\', \'multiverseId\': 172328}, \'multiverseid\': 172328}, {\'name\': \'Огненно-Дребезжащее Пугало\', \'text\': \'Огненно-Дребезжащее Пугало имеет Упорство, пока вы контролируете черное существо. (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\\nОгненно-Дребезжащее Пугало имеет Ускорение, пока вы контролируете красное существо.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172629&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2b3ecfac-9c2d-4fa5-a081-515fa5c329c9\', \'multiverseId\': 172629}, \'multiverseid\': 172629}, {\'name\': \'颤焰稻草人\', \'text\': \'只要你操控黑色生物，颤焰稻草人便具有留存异能。 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\\n只要你操控红色生物，颤焰稻草人便具有敏捷异能。\', \'type\': \'神器生物～稻草人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173231&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'357f36f1-09a2-4c2d-a234-6d6e4e1b7527\', \'multiverseId\': 173231}, \'multiverseid\': 173231}]', '[{\'name\': \'Lästiger Flüsterer\', \'text\': \'Der Lästige Flüsterer kann nicht neutralisiert werden.\\n{R/G}: Ein Zauberspruch deiner Wahl kann nicht von Zaubersprüchen oder Fähigkeiten neutralisiert werden.\', \'type\': \'Kreatur — Goblin, Schamane\', \'flavor\': \'Der Mundgeruch nach Fliegenpilz wehrt bereits einen großen Teil der Magie ab, besonders in Verbindung mit einem langgezogenen „Psssssssst".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174699&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d68bcf5e-dcb2-4cb7-a49b-fcfe72d2193b\', \'multiverseId\': 174699}, \'multiverseid\': 174699}, {\'name\': \'Silenciador irritante\', \'text\': \'El Silenciador irritante no puede ser contrarrestado.\\n{R/G}: El hechizo objetivo no puede ser contrarrestado por hechizos o habilidades.\', \'type\': \'Criatura — Chamán trasgo\', \'flavor\': \'El hedor de los hongos en el aliento es suficiente para repeler la magia más potente, especialmente al combinarlo con un cántico especial: "Shhh".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172893&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'59d5a262-a809-422c-a6fb-fb4d831ac5c1\', \'multiverseId\': 172893}, \'multiverseid\': 172893}, {\'name\': \'Museleur vexatoire\', \'text\': \'Le Museleur vexatoire ne peut pas être contrecarré.\\n{R/G} : Le sort ciblé ne peut pas être contrecarré par des sorts ou des capacités.\', \'type\': \'Créature : gobelin et shamane\', \'flavor\': \'Les champignons rouges donnent une haleine puante qui protège contre les sorts les plus puissants, surtout combinée à une incantation complexe : « Chuutt »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173495&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e4543d1a-10cf-4805-90b5-88db0424dca4\', \'multiverseId\': 173495}, \'multiverseid\': 173495}, {\'name\': \'Silenziatore Irritante\', \'text\': \'Il Silenziatore Irritante non può essere neutralizzato.\\n{R/G}: Una magia bersaglio non può essere neutralizzata da magie o abilità.\', \'type\': \'Creatura — Sciamano Goblin\', \'flavor\': \'Il tanfo di funghi velenosi del suo fiato è abbastanza per respingere anche le magie più potenti, specialmente se combinato con una formula speciale: "Shhh".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173796&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'81e94f7f-5766-4182-82bd-64649d36011d\', \'multiverseId\': 173796}, \'multiverseid\': 173796}, {\'name\': \'難問の鎮め屋\', \'text\': \'難問の鎮め屋は打ち消されない。\\n{R/G}：呪文１つを対象とする。それは呪文や能力によって打ち消されない。\', \'type\': \'クリーチャー — ゴブリン・シャーマン\', \'flavor\': \'ブラッドキャップの息にただよう茸の臭いは、最も強力な呪文すら弾く結界になる。特にその効き目がある言葉は「シーッ」だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174097&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f2e7b42-37fa-46c1-8cd5-328d09a10cae\', \'multiverseId\': 174097}, \'multiverseid\': 174097}, {\'name\': \'Silenciador Irritante\', \'text\': \'Silenciador Irritante não pode ser anulado.\\n{R/G}: A mágica alvo não pode ser anulada por mágicas nem habilidades.\', \'type\': \'Criatura — Goblin Xamã\', \'flavor\': \'O fedor dos cogumelos chapéu-sangrento no hálito já é suficiente para evitar até as mais potentes mágicas, especialmente quando combinado a um canto especial: "Pssss".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172291&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'71c8611c-6278-4547-b49a-f2e33500573a\', \'multiverseId\': 172291}, \'multiverseid\': 172291}, {\'name\': \'Шикающий Зануда\', \'text\': \'Шикающий Зануда не может быть отменен.\\n{R/G}: целевое заклинание не может быть отменено заклинаниями или способностями.\', \'type\': \'Существо — Гоблин Шаман\', \'flavor\': \'Его зловонного дыхания, отдающего кровавыми поганками, достаточно, чтобы отвратить даже самое сильное колдовство, особенно если при этом он беспрестанно повторяет: «Ш-ш-ш»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172592&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f6670d5-321c-4f83-af21-72d192e9c7e1\', \'multiverseId\': 172592}, \'multiverseid\': 172592}, {\'name\': \'嘘声捣乱人\', \'text\': \'嘘声捣乱人不能被反击。\\n{R/G}：目标咒语不能被咒语或异能反击。\', \'type\': \'生物～精灵／祭师\', \'flavor\': \'只要闻一闻血帽蘑菇的臭味，就足以挡下大部分的强大咒语，尤其是配合上特殊的歌词之后：「嘘～」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173194&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e77f76d-af8d-4a51-8483-2e1e93a9008d\', \'multiverseId\': 173194}, \'multiverseid\': 173194}]', '[{\'name\': \'Macht des Feuers\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat „{T}: Diese Kreatur fügt einer Kreatur oder einem Spieler deiner Wahl 1 Schadenspunkt zu".\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Die Rußwesen glauben, dass ihnen ihre Flamme von einer gestohlen wurde, die sie „die Auslöscherin" nennen. Jetzt müssen all jene ihren Zorn fürchten, die Feuer als Waffe einsetzen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174578&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fa281ae1-e0d5-4ca6-b37f-cac4d8218b49\', \'multiverseId\': 174578}, \'multiverseid\': 174578}, {\'name\': \'Poder del fuego\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene "{T}: Esta criatura hace 1 punto de daño a la criatura o jugador objetivo."\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Los cenicientos creen que su llama fue robada por aquella a la que llaman Extinguidora. Todos los que usan el fuego atraen su ira desesperada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172772&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'10d2eea1-f7c5-478d-a91a-a6ec51e493ea\', \'multiverseId\': 172772}, \'multiverseid\': 172772}, {\'name\': \'Pouvoir du feu\', \'text\': \'Enchanter : créature\\nLa créature enchantée a « {T} : Cette créature inflige 1 blessure à une cible, créature ou joueur. »\', \'type\': \'Enchantement : aura\', \'flavor\': "Les scoriacés croient que leur flamme a été volée par l\'être qu\'ils nomment l\'Extincteur. Désormais, quiconque contrôle le feu attire leur rage désespérée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173374&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d12f4bbe-afc4-4137-85bf-656530a5dc11\', \'multiverseId\': 173374}, \'multiverseid\': 173374}, {\'name\': \'Potere del Fuoco\', \'text\': \'Incanta creatura\\nLa creatura incantata ha "{T}: Questa creatura infligge 1 danno a una creatura o a un giocatore bersaglio."\', \'type\': \'Incantesimo — Aura\', \'flavor\': "I cinerei credono che le loro fiamme siano state rubate da colei che chiamano l\'Estintrice. Tutti coloro che adesso utilizzano il fuoco incorrono nella loro furia disperata.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173675&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'adb1ed61-387c-46cd-a150-231fc64b2f8c\', \'multiverseId\': 173675}, \'multiverseid\': 173675}, {\'name\': \'火の力\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは「{T}：クリーチャー１体かプレイヤー１人を対象とする。このクリーチャーはそれに１点のダメージを与える。」を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'燃えがらは、自分たちの炎が「鎮める者」と呼んでいるものに奪われたと信じている。 今や、炎を使うすべての者は彼らの必死の怒りの的となっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173976&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dd0ce324-b2d8-4636-bdb4-146fbcfac4e6\', \'multiverseId\': 173976}, \'multiverseid\': 173976}, {\'name\': \'Poder do Fogo\', \'text\': \'Encantar criatura\\nA criatura encantada tem "{T}: Esta criatura causa 1 ponto de dano à criatura ou ao jogador alvo."\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Os cinzeríneos acreditam que sua chama foi roubada por alguém chamado de a Extintora. Todos os que detêm alguma forma de fogo despertam sua ira desesperada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172170&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3327bb9f-0547-4260-915f-860db46cbfb9\', \'multiverseId\': 172170}, \'multiverseid\': 172170}, {\'name\': \'Сила Огня\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет способность «{T}: это существо наносит 1 повреждение целевому существу или игроку».\', \'type\': \'Чары — Аура\', \'flavor\': \'Золовики верят, что их пламя было похищено той, кого они называют Гасительницей. Теперь каждый, кто владеет огнем, навлекает на себя гнев их отчаяния.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172471&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3c162c4-590e-4b21-8154-7308d42da421\', \'multiverseId\': 172471}, \'multiverseid\': 172471}, {\'name\': \'火焰之力\', \'text\': \'生物结界\\n受此结界的生物具有「{T}：此生物对目标生物或牌手造成1点伤害。」\', \'type\': \'结界～灵气\', \'flavor\': \'烬身相信该族的火焰是给称作熄焰者的人所偷走。 所有还挥舞着火光的人都会招致他们盲目的愤怒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173073&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8e8ff9f3-3a58-4348-80ab-fb1e52333fde\', \'multiverseId\': 173073}, \'multiverseid\': 173073}]', "[{'name': 'Mahlzeit der Düsterwitwen', 'text': 'Zerstöre eine fliegende Kreatur deiner Wahl. Falls diese Kreatur blau oder schwarz war, bringe einen 1/2 grünen Spinnen-Kreaturenspielstein mit Reichweite ins Spiel. (Er kann fliegende Kreaturen blocken.)', 'type': 'Spontanzauber', 'flavor': 'Jede Nacht jagen Düsterwitwen frische Opfer für ihren gefräßigen Nachwuchs.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174595&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd8082842-8146-47fa-b5b3-cb2621d3656f', 'multiverseId': 174595}, 'multiverseid': 174595}, {'name': 'Festín de la viuda lúgubre', 'text': 'Destruye la criatura objetivo que tenga la habilidad de volar. Si esa criatura era azul o negra, pon en juego una ficha de criatura Araña verde 1/2 con la habilidad de alcance. (Puede bloquear criaturas\\ncon la habilidad de volar.)', 'type': 'Instantáneo', 'flavor': 'Todas las noches las viudas lúgubres buscan presas frescas para sus hambrientos descendientes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172789&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5e1c3c7f-288f-4e6a-832e-5a44b3941056', 'multiverseId': 172789}, 'multiverseid': 172789}, {'name': 'Festin de la veuve obscure', 'text': 'Détruisez une créature avec le vol ciblée. Si cette créature était bleue ou noire, mettez en jeu un jeton de créature 1/2 verte Araignée avec la portée. (Elle peut bloquer les créatures\\navec le vol.)', 'type': 'Éphémère', 'flavor': 'Chaque nuit, les veuves obscures rapportent des proies fraîchement tuées à leur progéniture affamée.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173391&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2b4bee3c-7050-4f83-93c1-72edfb6e9170', 'multiverseId': 173391}, 'multiverseid': 173391}, {'name': 'Banchetto della Vedova di Tenebra', 'text': 'Distruggi una creatura bersaglio con volare. Se quella creatura era blu o nera, metti in gioco una pedina creatura Ragno 1/2 verde con raggiungere. (Può bloccare le creature\\ncon volare.)', 'type': 'Istantaneo', 'flavor': 'Ogni notte, le vedove di tenebra raccolgono prede fresche per i loro piccoli affamati.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173692&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '67c3d931-f946-4675-8797-66ed27c31b92', 'multiverseId': 173692}, 'multiverseid': 173692}, {'name': '鬱後家蜘蛛の饗宴', 'text': '飛行を持つクリーチャー１体を対象とし、それを破壊する。 そのクリーチャーが青か黒である場合、到達を持つ緑の１/２の蜘蛛・クリーチャー・トークンを１体場に出す。 （それは飛行を持つクリーチャーを\\nブロックできる。）', 'type': 'インスタント', 'flavor': '鬱後家蜘蛛は貪欲な子蜘蛛のために、毎晩新鮮な獲物を集めてくる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173993&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ef01ba67-2b45-4fe9-8cde-39af34c760e2', 'multiverseId': 173993}, 'multiverseid': 173993}, {'name': 'Banquete da Viúva-Sombria', 'text': 'Destrua a criatura alvo com voar. Se aquela criatura for azul ou preta, coloque em jogo uma ficha de criatura verde 1/2 do tipo Aranha com alcance. (Ela pode bloquear criaturas\\ncom voar.)', 'type': 'Mágica Instantânea', 'flavor': 'Todas as noites, as viúvas-sombrias selecionam suas presas frescas para suas vorazes crias.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172187&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8ca7a926-cbd0-4bf6-b558-dcc16c7d8d38', 'multiverseId': 172187}, 'multiverseid': 172187}, {'name': 'Пир Мрачной Вдовы', 'text': 'Уничтожьте целевое существо с Полетом. Если то существо было синим или черным, положите в игру одну фишку существа 1/2 зеленый Паук с Захватом. (Она может блокировать существа\\nс Полетом.)', 'type': 'Мгновенное заклинание', 'flavor': 'Каждую ночь мрачные вдовы тщательно выбирают свежую добычу для своих ненасытных паучат.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172488&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '8605c0bb-18df-4d31-b710-cb19e6c55257', 'multiverseId': 172488}, 'multiverseid': 172488}, {'name': '暗寡妇盛宴', 'text': '消灭目标具飞行异能的生物。 如果该生物是蓝色或黑色，则将一个1/2绿色，具延势异能的蜘蛛衍生物放置进场。 （它能阻挡\\n具飞行异能的生物。）', 'type': '瞬间', 'flavor': '暗寡妇每个夜晚都替自己大胃口的孩子挑选新鲜猎物。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173090&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c8fdab4f-96c9-43d0-b449-b6d005733a85', 'multiverseId': 173090}, 'multiverseid': 173090}]", '[{\'name\': \'Makabre Fee\', \'text\': \'Fliegend\\nWirf die Makabre Fee aus deiner Hand ab: Entferne bis zu zwei Karten deiner Wahl aus Friedhöfen ganz aus dem Spiel.\', \'type\': \'Kreatur — Feenwesen, Räuber\', \'flavor\': \'Die Trennlinie zwischen Traum und Tod ist kaum sichtbar und leicht durchdringbar. Die Fee leitet alle, die ihr zu nahe kommen, von einer Seite auf die andere.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174543&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ee3b314-160f-413a-a7ec-a8d02a10ae49\', \'multiverseId\': 174543}, \'multiverseid\': 174543}, {\'name\': \'Hada macabra\', \'text\': \'Vuela.\\nDescartar el Hada macabra: Remueve del juego hasta dos cartas objetivo en cementerios.\', \'type\': \'Criatura — Bribón hada\', \'flavor\': \'La línea divisoria entre el sueño y la muerte es frágil. Ella guía a quienes están muy cerca para un lado o para el otro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172737&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'489ac25a-0c83-4d28-b81c-198a62533c8e\', \'multiverseId\': 172737}, \'multiverseid\': 172737}, {\'name\': \'Faerie macabre\', \'text\': "Vol\\nDéfaussez-vous de la Faerie macabre : Retirez de la partie jusqu\'à deux cartes ciblées dans des cimetières.", \'type\': \'Créature : peuple fée et gredin\', \'flavor\': "Le voile séparant le rêve de la mort est fragile et diaphane. Elle conduit quiconque approche trop d\'un côté dans l\'autre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173339&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'76fb5277-be45-4773-a14d-015b9de5b6af\', \'multiverseId\': 173339}, \'multiverseid\': 173339}, {\'name\': \'Spiritella Macabra\', \'text\': \'Volare\\nScarta la Spiritella Macabra: Rimuovi dal gioco fino a due carte bersaglio dai cimiteri.\', \'type\': \'Creatura — Farabutto Spiritello\', \'flavor\': "La linea che separa il sogno dalla morte è fragile e trasparente. Conduce coloro troppo vicini a essa da un lato all\'altro.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173640&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b9ebabc3-acd2-482b-b7a8-a5f7f79351a2\', \'multiverseId\': 173640}, \'multiverseid\': 173640}, {\'name\': \'フェアリーの忌み者\', \'text\': \'飛行\\nフェアリーの忌み者を捨てる：墓地にあるカードを最大２枚まで対象とし、それらをゲームから取り除く。\', \'type\': \'クリーチャー — フェアリー・ならず者\', \'flavor\': \'夢と死の境界は薄く儚い。 彼女は境目に近づきすぎた者達を逆へと誘う。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173941&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f827a5e-33f6-4fc5-9a3b-e8713e26a792\', \'multiverseId\': 173941}, \'multiverseid\': 173941}, {\'name\': \'Fada Macabra\', \'text\': \'Voar\\nDescarte Fada Macabra: Remova do jogo até dois cards alvo em cemitérios.\', \'type\': \'Criatura — Fada Ladino\', \'flavor\': \'A linha entre o sonho e a morte é sutil e frágil. Ele guia de um lado para o outro os que chegam perto demais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172135&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'967497a2-755d-4176-8025-8ac3212e6b66\', \'multiverseId\': 172135}, \'multiverseid\': 172135}, {\'name\': \'Фея Смерти\', \'text\': \'Полет\\nСбросьте Фею Смерти: удалите из игры не более двух целевых карт, находящихся на кладбищах.\', \'type\': \'Существо — Фея Бродяга\', \'flavor\': \'Между сном и смертью лишь тонкая и хрупкая грань. Эта фея помогает тем, кто подходит к ней слишком близко, перейти с одной стороны на другую.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172436&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'72acb894-e5ab-4010-bfcf-2a0b3699cacc\', \'multiverseId\': 172436}, \'multiverseid\': 172436}, {\'name\': \'渡亡仙灵\', \'text\': \'飞行\\n弃掉渡亡仙灵：将至多两张目标牌从任何坟墓场中移出对战。\', \'type\': \'生物～仙灵／浪客\', \'flavor\': \'幻梦与死亡之间的界线既薄又脆弱。 她将太接近者从此处拉到彼处。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173038&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9b35f397-87ca-41cf-8fb0-78d9bdc511a5\', \'multiverseId\': 173038}, \'multiverseid\': 173038}]', '[{\'name\': \'Manamorphose\', \'text\': \'Erhöhe deinen Manavorrat um zwei Mana einer beliebigen Farbkombination.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Einen Augenblick lang schimmerten Objekte aus reinem Mana in den Händen des fassungslosen Boggarts. Eine Sekunde später befanden sie sich in seinem Mund, und er kaute genüsslich auf ihnen herum.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174688&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9fd111d-3ab4-4cb4-bd0b-515bb194cca3\', \'multiverseId\': 174688}, \'multiverseid\': 174688}, {\'name\': \'Manamorfosis\', \'text\': \'Agrega dos maná de cualquier combinación de color a tu reserva de maná.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Por un momento objetos de maná puro brillaron en las manos del sorprendido boggart. Al instante siguiente estaban en su boca, mientras masticaba contento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172882&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4f5fb16-5c71-412f-8b4e-366cb02c69a5\', \'multiverseId\': 172882}, \'multiverseid\': 172882}, {\'name\': \'Manamorphose\', \'text\': \'Ajoutez deux manas de la combinaison de mana coloré de votre choix à votre réserve.\\nPiochez une carte.\', \'type\': \'Éphémère\', \'flavor\': "Un instant, des objets de mana pur scintillaient dans les mains du boggart émerveillé. L\'instant d\'après, ils étaient dans sa bouche et il les mâchait d\'un air satisfait.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173484&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'63af9c6a-165f-4f1b-89c9-7f011104c036\', \'multiverseId\': 173484}, \'multiverseid\': 173484}, {\'name\': \'Manamorfosi\', \'text\': \'Aggiungi due mana in qualsiasi combinazione di colori alla tua riserva di mana.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Per un attimo, oggetti di puro mana scintillarono nelle mani del boggart meravigliato. Un secondo dopo, si trovavano nella sua bocca, mentre il boggart masticava allegramente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173785&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a6f78b98-4cdd-4964-befe-47295fd71f77\', \'multiverseId\': 173785}, \'multiverseid\': 173785}, {\'name\': \'魔力変\', \'text\': \'あなたのマナ・プールに、好きな色の組み合わせのマナ２点を加える。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'あるとき、手の内に光る純粋な魔力を秘めた物にボガートは目を見張った。 次の瞬間、彼はそれを口に放り込み、満足そうに噛み砕いた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174086&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85b3ab78-b287-43d8-bebb-d17e251bb2f0\', \'multiverseId\': 174086}, \'multiverseid\': 174086}, {\'name\': \'Manamorfose\', \'text\': \'Adicione dois manas em qualquer combinação de cores à sua reserva de mana.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Por um momento, objetos de puro mana brilharam nas mãos maravilhadas do papão. No momento seguinte, eles estavam na sua boca e ele mastigou com satisfação.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172280&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5b2ca6b2-20c2-4086-897e-80d6899c7f82\', \'multiverseId\': 172280}, \'multiverseid\': 172280}, {\'name\': \'Манаморфоза\', \'text\': \'Добавьте две маны любых цветов в ваше хранилище маны.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'На какое-то мгновение творения чистейшей маны сверкнули в руках пораженного боггарта. В следующее мгновение они уже были у него в пасти, и он, довольный, задвигал челюстями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172581&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d1c3452c-853b-4c7b-9d65-75bed3511d32\', \'multiverseId\': 172581}, \'multiverseid\': 172581}, {\'name\': \'魔力塑型\', \'text\': \'加两点法术力到你的法术力池中，其颜色组合由你选择。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'纯净法术力的块体曾在惊奇不已的波尬手上发光。 而在下一刻，波尬已满足地嚼着它。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173183&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d8f3dac-70cc-489c-82dc-bf76c80fcb77\', \'multiverseId\': 173183}, \'multiverseid\': 173183}]', '[{\'name\': \'Manaschmelzen-Rußwesen\', \'text\': \'{1}: Erhöhe deinen Manavorrat um {B} oder {R}. Spiele diese Fähigkeit nicht öfter als dreimal pro Zug.\', \'type\': \'Kreatur — Elementarwesen, Schamane\', \'flavor\': \'Die Mystiker der Rußwesen stellen Fallen auf, um Sluaghs und andere Flammengeister zu fangen, und versuchen, ihnen das Geheimnis des Feuers zu entlocken, das ihnen selbst verlorengegangen ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174668&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'450f944b-eadd-445c-8bbd-bd9aee5de6e8\', \'multiverseId\': 174668}, \'multiverseid\': 174668}, {\'name\': \'Cenicienta forja de maná\', \'text\': \'{1}: Agrega {B} o {R} a tu reserva de maná. No juegues esta habilidad más de tres veces por turno.\', \'type\': \'Criatura — Chamán elemental\', \'flavor\': \'Los místicos cenicientos preparan trampas para los espíritus de la llama, buscando extraer los secretos del fuego que sus propios corazones perdieron.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172862&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'514cb3bb-b655-424f-b14a-72ade2710c0a\', \'multiverseId\': 172862}, \'multiverseid\': 172862}, {\'name\': \'Scoriacée forgemana\', \'text\': \'{1} : Ajoutez {B} ou {R} à votre réserve. Ne jouez pas cette capacité plus de trois fois à chaque tour.\', \'type\': \'Créature : élémental et shamane\', \'flavor\': "Les mystiques scoriacés tendent des pièges aux sluaghs et aux autres esprits des flammes, cherchant à en extraire les secrets du feu qu\'ils ont perdus.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173464&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a42fcb5a-7392-41a0-a380-7f923da90bec\', \'multiverseId\': 173464}, \'multiverseid\': 173464}, {\'name\': \'Forgiamana Cinerea\', \'text\': \'{1}: Aggiungi {B} o {R} alla tua riserva di mana. Gioca questa abilità non più di tre volte per turno.\', \'type\': \'Creatura — Sciamano Elementale\', \'flavor\': \'I mistici cinerei posizionano le trappole per sluagh e altri spiriti delle fiamme, cercando di carpire il segreto del fuoco che i loro stessi cuori hanno perduto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173765&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0a198712-0c4c-4f7b-9548-58ab45615e4e\', \'multiverseId\': 173765}, \'multiverseid\': 173765}, {\'name\': \'魔力炉の燃えがら\', \'text\': \'{1}：あなたのマナ・プールに{B}か{R}を加える。 この能力は、毎ターン３回までしかプレイできない。\', \'type\': \'クリーチャー — エレメンタル・シャーマン\', \'flavor\': \'燃えがらの神秘家はスルーアや他の炎の精霊を捕まえるための罠を仕掛け、自分の心臓が失ってしまった火の秘密を抽出しようとしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174066&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2782d343-0125-4820-83a6-99c461849851\', \'multiverseId\': 174066}, \'multiverseid\': 174066}, {\'name\': \'Cinzeríneo Forja-Mana\', \'text\': \'{1}: Adicione {B} ou {R} à sua reserva de mana. Jogue esta habilidade no máximo três vezes a cada turno.\', \'type\': \'Criatura — Elemental Xamã\', \'flavor\': \'Os místicos cinzeríneos colocam armadilhas para capturar sluaghs e outros espíritos das chamas, procurando extrair os segredos do fogo que seus próprios corações perderam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172260&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4b7fb2dc-939e-4a52-ac85-89c64cbacba0\', \'multiverseId\': 172260}, \'multiverseid\': 172260}, {\'name\': \'Золовик, Кузнец Маны\', \'text\': \'{1}: добавьте {B} или {R} в ваше хранилище маны. Разыгрывайте эту способность не более трех раз за ход.\', \'type\': \'Существо — Элементаль Шаман\', \'flavor\': \'Золовики-мистики устраивают западни для слуа и прочих духов пламени, пытаясь вытянуть из них тайны огня, утраченные их собственными сердцами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172561&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1f9e8345-7faf-47f9-9040-ace2dceb6ec2\', \'multiverseId\': 172561}, \'multiverseid\': 172561}, {\'name\': \'魔铸烬身\', \'text\': \'{1}：加{B}或{R}到你的法术力池中。 此异能每回合中最多只能使用三次。\', \'type\': \'生物～元素／祭师\', \'flavor\': \'烬身秘教徒设陷阱捕猎恶灵与其他火焰精怪，以设法解答他们已失去的心灵火焰秘密。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173163&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'701884de-6f08-44ab-b6ad-846c716edaef\', \'multiverseId\': 173163}, \'multiverseid\': 173163}]', '[{\'name\': \'Manaspiegelung\', \'text\': \'Falls du eine bleibende Karte für Mana tappst, erzeugt sie stattdessen das Doppelte dieses Manas.\', \'type\': \'Verzauberung\', \'flavor\': \'Trotz der Dunkelheit hat das Schattenmoor keinen Mangel an Wachstum. Legionen kriechender Wesen vermehren sich in den Schatten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174599&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93495d90-adab-4399-b969-c1a370080095\', \'multiverseId\': 174599}, \'multiverseid\': 174599}, {\'name\': \'Reflejo de maná\', \'text\': \'Si giras un permanente para obtener maná, en vez de eso, produce el doble de esa cantidad de maná.\', \'type\': \'Encantamiento\', \'flavor\': \'A pesar de la oscuridad, el Páramo Sombrío no extraña el crecimiento. Hordas de cosas reptantes crecen a la sombra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172793&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6544f670-aa5a-4b05-8728-c3ffcc283ffb\', \'multiverseId\': 172793}, \'multiverseid\': 172793}, {\'name\': \'Réverbération de mana\', \'text\': \'Si vous engagez un permanent pour du mana, il produit deux fois cette quantité de mana à la place.\', \'type\': \'Enchantement\', \'flavor\': "En dépit des ténèbres, Sombrelande ne manque pas de vie. Des légions de petites choses grouillent dans l\'obscurité.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173395&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1222c262-e812-4b72-9fdd-3071384aaef2\', \'multiverseId\': 173395}, \'multiverseid\': 173395}, {\'name\': \'Riflesso di Mana\', \'text\': \'Se TAPpi un permanente per attingere mana, produce invece il doppio di quel mana.\', \'type\': \'Incantesimo\', \'flavor\': "Nonostante l\'oscurità, la Landa Tenebrosa non ha problemi di crescita. Legioni di orrori striscianti prosperano nelle ombre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173696&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e54d2238-5df8-4d88-8718-38f1aa666b6d\', \'multiverseId\': 173696}, \'multiverseid\': 173696}, {\'name\': \'マナの反射\', \'text\': \'あなたがマナを生み出す目的でパーマネントをタップする場合、代わりにそれはその２倍のマナを生み出す。\', \'type\': \'エンチャント\', \'flavor\': \'シャドウムーアは、その闇の深さにもかかわらず、成長を欠いているわけではない。 その闇の中にはうごめくものどもが群れ成しているのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173997&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6a154271-3c69-4fd2-9343-38b10a0faf77\', \'multiverseId\': 173997}, \'multiverseid\': 173997}, {\'name\': \'Reflexo de Mana\', \'text\': \'Se você virar uma permanente para gerar mana, em vez disso, ela produzirá o dobro daquela quantidade de mana.\', \'type\': \'Encantamento\', \'flavor\': \'Apesar da sua escuridão, o Pântano Sombrio não deseja crescer. Legiões de seres rastejantes florescem nas sombras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172191&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eecfcf64-feb0-4aca-9add-6dcf1f21cf1c\', \'multiverseId\': 172191}, \'multiverseid\': 172191}, {\'name\': \'Отражение Маны\', \'text\': \'Если вы поворачиваете перманент для получения маны, он производит вдвое больше той маны вместо этого.\', \'type\': \'Чары\', \'flavor\': \'Несмотря на темноту, в Шэдоумуре не останавливается рост. Полчища ползучих тварей процветают в тени.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172492&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d837ee41-6f78-426d-b236-f2bd2de3c9c9\', \'multiverseId\': 172492}, \'multiverseid\': 172492}, {\'name\': \'魔力映象\', \'text\': \'如果你横置任一永久物来产生法术力，则改为它产生两倍的该类法术力。\', \'type\': \'结界\', \'flavor\': \'除了黑暗之外，暗影荒原没东西能成长。 数不清的可怕东西在阴影中求生。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173094&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7d4c27f5-fa8f-43a6-b863-b90d0050694a\', \'multiverseId\': 173094}, \'multiverseid\': 173094}]', "[{'name': 'Massenversteinerung', 'text': 'Zerstöre alle nichtweißen Kreaturen.', 'type': 'Hexerei', 'flavor': 'Die Toten dienen als ihre eigenen Grabsteine.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174489&type=card', 'language': 'German', 'identifiers': {'scryfallId': '86ad7887-26ce-468b-8011-c75aec2dff26', 'multiverseId': 174489}, 'multiverseid': 174489}, {'name': 'Calcificación masiva', 'text': 'Destruye todas las criaturas que no sean blancas.', 'type': 'Conjuro', 'flavor': 'Los muertos sirven como sus propias lápidas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172683&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'be97ed00-f0d0-4b2e-a904-5859a3b9920e', 'multiverseId': 172683}, 'multiverseid': 172683}, {'name': 'Calcification de masse', 'text': 'Détruisez toutes les créatures non-blanches.', 'type': 'Rituel', 'flavor': 'Les morts deviennent leur propre pierre tombale.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173285&type=card', 'language': 'French', 'identifiers': {'scryfallId': '14e9bde1-ba8d-4b33-a3b5-7fdb0868ea86', 'multiverseId': 173285}, 'multiverseid': 173285}, {'name': 'Calcificazione di Massa', 'text': 'Distruggi tutte le creature non bianche.', 'type': 'Stregoneria', 'flavor': 'I morti fungono da pietre tombali per loro stessi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173586&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e604df52-91e8-43e9-819d-0414abca1273', 'multiverseId': 173586}, 'multiverseid': 173586}, {'name': '集団の石灰化', 'text': 'すべての白でないクリーチャーを破壊する。', 'type': 'ソーサリー', 'flavor': 'その死体は自らの墓石となる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173887&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '458cf57a-f44b-44f1-9c01-4f2a4e9f2d4f', 'multiverseId': 173887}, 'multiverseid': 173887}, {'name': 'Calcificar em Massa', 'text': 'Destrua todas as criaturas que não sejam brancas.', 'type': 'Feitiço', 'flavor': 'Os mortos se tornam suas próprias lápides.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172081&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7fbb596d-a50a-46a4-9f99-2ea06c5402bf', 'multiverseId': 172081}, 'multiverseid': 172081}, {'name': 'Массовое Окаменение', 'text': 'Уничтожьте все небелые существа.', 'type': 'Волшебство', 'flavor': 'Покойники становятся своими собственными надгробиями.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172382&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'eb701c86-40b4-4895-8f35-e71071269067', 'multiverseId': 172382}, 'multiverseid': 172382}, {'name': '全面钙化', 'text': '消灭所有非白色的生物。', 'type': '法术', 'flavor': '亡者正好能当成自己的墓碑。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172984&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '57829109-2333-4cd5-99ce-988e1deee67a', 'multiverseId': 172984}, 'multiverseid': 172984}]", '[{\'name\': \'Medizinüberbringer\', \'text\': \'Wenn der Medizinüberbringer ins Spiel kommt, kannst du eine Marke von einer bleibenden Karte deiner Wahl entfernen.\', \'type\': \'Kreatur — Elf, Kleriker\', \'flavor\': \'Elfenheiler tragen Ampullen mit einem Balsam bei sich, der als Morgentropfen bekannt ist und der dort angewandt wird, wo Kräuter nicht mehr helfen können.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174707&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b3b959a2-d0e2-47f6-a899-3373d5ea62d9\', \'multiverseId\': 174707}, \'multiverseid\': 174707}, {\'name\': \'Mensajera de medicina\', \'text\': \'Cuando la Mensajera de medicina entre en juego, puedes remover un contador del permanente objetivo.\', \'type\': \'Criatura — Clérigo elfo\', \'flavor\': \'Los sanadores élficos llevan viales con el bálsamo conocido como solanera, que guardan para aquellas heridas que las hierbas no pueden tratar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172901&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e7c5185-ea08-41ae-8d79-617f10ac2da9\', \'multiverseId\': 172901}, \'multiverseid\': 172901}, {\'name\': \'Coureuse de remèdes\', \'text\': \'Quand la Coureuse de remèdes arrive en jeu, vous pouvez retirer un marqueur du permanent ciblé.\', \'type\': \'Créature : elfe et clerc\', \'flavor\': "Les guérisseurs elfes transportent tous un baume appelé solariane qu\'ils réservent pour les blessures contre lesquelles les herbes ne peuvent rien.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173503&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'168480f4-cf20-4b66-99cd-4e5ac8f37ccc\', \'multiverseId\': 173503}, \'multiverseid\': 173503}, {\'name\': \'Velocista Guaritrice\', \'text\': \'Quando la Velocista Guaritrice entra in gioco, puoi rimuovere un segnalino da un permanente bersaglio.\', \'type\': \'Creatura — Chierico Elfo\', \'flavor\': \'Gli elfi guaritori trasportano sempre fiale del balsamo conosciuto come ardore aurorale, conservandolo per quelle ferite che le erbe non possono curare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173804&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a2cb08b6-7de4-4839-93f1-75ae80cd364f\', \'multiverseId\': 173804}, \'multiverseid\': 173804}, {\'name\': \'薬の走り手\', \'text\': \'薬の走り手が場に出たとき、パーマネント１つを対象とする。あなたはそれの上からカウンターを１つ取り除いてもよい。\', \'type\': \'クリーチャー — エルフ・クレリック\', \'flavor\': \'エルフの癒し手はアケノヒカリとして知られる軟膏の瓶を持ち歩き、薬草では癒すことのできない傷に対して用いている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174105&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a487b42-5b8c-44fa-a5fe-aa237d751a1f\', \'multiverseId\': 174105}, \'multiverseid\': 174105}, {\'name\': \'Mensageiro dos Remédios\', \'text\': \'Quando Mensageiro dos Remédios entra em jogo, você pode remover um marcador da permanente alvo.\', \'type\': \'Criatura — Elfo Clérigo\', \'flavor\': \'Os curandeiros élficos carregam frascos do bálsamo conhecido como brilhalba, e o reservam para aquelas feridas que as ervas não curam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172299&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'73df10b0-fa8e-4f48-965b-040e51c5a53f\', \'multiverseId\': 172299}, \'multiverseid\': 172299}, {\'name\': \'Гонец с Лекарством\', \'text\': \'Когда Гонец с Лекарством входит в игру, вы можете удалить один жетон с целевого перманента.\', \'type\': \'Существо — Эльф Священник\', \'flavor\': \'Эльфийские целители носят с собой пузырьки с настойкой зарецвета, приберегая его для таких ран, которые невозможно залечить травами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172600&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8078549b-0b6d-4139-b9ae-636965761cb3\', \'multiverseId\': 172600}, \'multiverseid\': 172600}, {\'name\': \'救急医士\', \'text\': \'当救急医士进场时，你可以从目标永久物上移去一个指示物。\', \'type\': \'生物～地精／僧侣\', \'flavor\': \'地精治疗师药瓶里的药膏称为晨华，专用来医护药草无法应付的伤势。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173202&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c1ecc041-327c-4245-9a5a-2b9dc4c77670\', \'multiverseId\': 173202}, \'multiverseid\': 173202}]', '[{\'name\': \'Meister der Wahrsagerei\', \'text\': \'Immer wenn der Meister der Wahrsagerei einem Spieler Kampfschaden zufügt, zeige die oberste Karte deiner Bibliothek offen vor und nimm sie auf deine Hand. Du erhältst Lebenspunkte in Höhe ihrer umgewandelten Manakosten dazu.\', \'type\': \'Kreatur — Kithkin, Zauberer\', \'flavor\': \'Mondsteine helfen kaum bei der Vorhersage, dafür umso mehr in anderen Bereichen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177801&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad93e181-2507-4ee3-b621-4e91d03d7e7e\', \'multiverseId\': 177801}, \'multiverseid\': 177801}, {\'name\': \'Perita de augurios\', \'text\': \'Siempre que la Perita de augurios haga daño de combate a un jugador, muestra la primera carta de tu biblioteca y ponla en tu mano. Ganas una cantidad de vida igual a su coste de maná convertido.\', \'type\': \'Criatura — Hechicero kithkin\', \'flavor\': \'Las piedras lunares dan un poder oracular limitado, pero ilimitadas ventajas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177825&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'63847b61-9933-4af7-97c4-9932c36b8ec5\', \'multiverseId\': 177825}, \'multiverseid\': 177825}, {\'name\': "Experte de l\'augure", \'text\': "À chaque fois que l\'Experte de l\'augure inflige des blessures de combat à un joueur, révélez la carte du dessus de votre bibliothèque et mettez cette carte dans votre main. Vous gagnez autant de points de vie que son coût converti de mana.", \'type\': \'Créature : sangami et sorcier\', \'flavor\': "L\'effet des pierres de lune est limité dans les prévisions, mais pas dans ses avantages.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177872&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f25164b8-dc32-4fae-b21c-e8e7e3e2fed6\', \'multiverseId\': 177872}, \'multiverseid\': 177872}, {\'name\': \'Adepta Augure\', \'text\': "Ogniqualvolta l\'Adepta Augure infligge danno da combattimento a un giocatore, rivela la prima carta del tuo grimorio e aggiungila alla tua mano. Guadagni punti vita pari al costo di mana convertito di quella carta.", \'type\': \'Creatura — Mago Kithkin\', \'flavor\': \'Le seleniti garantiscono una preveggenza limitata, ma un vantaggio infinito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177896&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7bcaff8d-d70d-4224-a3d3-ffcbffb53bec\', \'multiverseId\': 177896}, \'multiverseid\': 177896}, {\'name\': \'占いの達人\', \'text\': \'占いの達人がいずれかのプレイヤーに戦闘ダメージを与えるたび、あなたのライブラリーの一番上のカードを公開し、それをあなたの手札に加える。 あなたはそれの点数で見たマナ・コストに等しい点数のライフを得る。\', \'type\': \'クリーチャー — キスキン・ウィザード\', \'flavor\': \'月長石は限りある未来しか見せないが、それは限りない優位となる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177777&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be399a78-8d68-4a84-a979-8ce1d04fe6c1\', \'multiverseId\': 177777}, \'multiverseid\': 177777}, {\'name\': \'Adepto do Agouro\', \'text\': \'Toda vez que Adepto do Agouro causar dano de combate a um jogador, revele o card do topo de seu grimório e coloque-o na sua mão. Você ganha uma quantidade de pontos de vida igual ao seu custo de mana convertido.\', \'type\': \'Criatura — Kithkin Mago\', \'flavor\': \'As selenitas proporcionam uma previsão limitada, mas vantagens ilimitadas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177753&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0b55ca50-3037-4bc6-b4f6-b2ccfbcf6441\', \'multiverseId\': 177753}, \'multiverseid\': 177753}, {\'name\': \'Адепт Предсказаний\', \'text\': \'Каждый раз, когда Адепт Предсказаний наносит боевые повреждения игроку, покажите верхнюю карту вашей библиотеки и положите ту карту в вашу руку. Вы получаете количество жизней, равное ее конвертированной мана-стоимости.\', \'type\': \'Существо — Кискен Чародей\', \'flavor\': \'Лунные камни наделяют вас ограниченным даром предвидения, но безграничными возможностями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177729&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16b58b1b-6799-4693-a6a5-6fdfe60b5c16\', \'multiverseId\': 177729}, \'multiverseid\': 177729}, {\'name\': \'卜算专家\', \'text\': \'每当卜算专家对任一牌手造成战斗伤害时，展示你的牌库顶牌，并将该牌置于你手上。 你获得等同于其总法术力费用的生命。\', \'type\': \'生物～洁英／法术师\', \'flavor\': \'月石提供的预知能力有限，却能带来无限优势。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177848&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'47bae197-80d3-4197-9ddd-254432e05821\', \'multiverseId\': 177848}, \'multiverseid\': 177848}]', "[{'name': 'Mentor der tiefsten Gewässer', 'text': 'Blaue Kreaturen, die du kontrollierst, sind unblockbar.', 'type': 'Kreatur — Meervolk, Räuber', 'flavor': 'Reisende und Händler sind auf den Flüssen nicht mehr sicher. Nur noch Plünderer sind auf den Wasserstraßen unterwegs und hinterlassen Blut und Leid.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174512&type=card', 'language': 'German', 'identifiers': {'scryfallId': '44da9348-22a2-4e4b-ac29-dec0a1a4df7c', 'multiverseId': 174512}, 'multiverseid': 174512}, {'name': 'Mentor canal profundo', 'text': 'Las criaturas azules que controlas son imbloqueables.', 'type': 'Criatura — Bribón tritón', 'flavor': 'Los ríos ya no pueden dar un pasaje seguro a los viajantes y el comercio. Sólo sirven como vías para los incursores y canales para la sangre y la maldad.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172706&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ee288505-e68a-4376-a178-edeb3b21a64e', 'multiverseId': 172706}, 'multiverseid': 172706}, {'name': 'Mentor plongechenal', 'text': 'Les créatures bleues que vous contrôlez sont imblocables.', 'type': 'Créature : ondin et gredin', 'flavor': 'Les rivières ne sont plus sûres pour les voyageurs et le commerce. Ce sont des viviers pour les pillards et des canaux qui portent sang et malheur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173308&type=card', 'language': 'French', 'identifiers': {'scryfallId': '14aeef5a-4872-40e0-afbe-6f3613569cb1', 'multiverseId': 173308}, 'multiverseid': 173308}, {'name': 'Mentore dei Canali Profondi', 'text': 'Le creature blu che controlli non possono essere bloccate.', 'type': 'Creatura — Farabutto Tritone', 'flavor': 'I fiumi non possono più fornire un passaggio sicuro per viaggiatori e commercianti. Servono solo come strade maestre per i razziatori e canali per il sangue e la disperazione.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173609&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '40f04c7e-39e3-480c-be86-b6491dff575b', 'multiverseId': 173609}, 'multiverseid': 173609}, {'name': '深水路の導師', 'text': 'あなたがコントロールする青のクリーチャーはブロックされない。', 'type': 'クリーチャー — マーフォーク・ならず者', 'flavor': '旅人や商人にとっては、川はもはや安全な道筋とは言えない。 それは襲撃者にとっての通路であり、血と悲哀の流れるところである。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173910&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'fb3ab040-c7eb-41f2-8587-43b2edb7d343', 'multiverseId': 173910}, 'multiverseid': 173910}, {'name': 'Mentor dos Canais Profundos', 'text': 'As criaturas azuis que você controla não podem ser bloqueadas.', 'type': 'Criatura — Tritão Ladino', 'flavor': 'Os rios não podem mais proporcionar uma travessia segura nem para os viajantes nem para o comércio. São apenas vias para baderneiros e canais de sangue e desgraças.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172104&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd5cb6101-3599-423f-9e37-bd3efa468e20', 'multiverseId': 172104}, 'multiverseid': 172104}, {'name': 'Подводный Наставник', 'text': 'Синие существа под вашим контролем не могут быть заблокированы.', 'type': 'Существо — Мерфолк Бродяга', 'flavor': 'Реки перестали быть безопасными для путешественников и торговцев. Это пути, на которых хозяйничают бандиты, и в их руслах текут потоки крови и страданий.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172405&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '42af06e1-4d32-4d5e-a7b2-bc2ba22fe01a', 'multiverseId': 172405}, 'multiverseid': 172405}, {'name': '通渠明师', 'text': '由你操控的蓝色生物不能被阻挡。', 'type': '生物～人鱼／浪客', 'flavor': '河流再也无法替旅人与贸易提供安全路途。 它们只是盗匪的大道、血光之捷径。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173007&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '00627895-9f08-4299-aee6-79c93472e9ee', 'multiverseId': 173007}, 'multiverseid': 173007}]", '[{\'name\': \'Merropportunist\', \'text\': \'Immer wenn der Merropportunist enttappt wird, kannst du einen Spieler deiner Wahl eine Karte aus der Hand abwerfen lassen.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Man sagt, dass sich die Gedanken der intriganten Merropportunisten nur um die dunklen Nächte drehen, die kommen werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174546&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'811890de-7ada-4bbe-af83-55b8ca1955a5\', \'multiverseId\': 174546}, \'multiverseid\': 174546}, {\'name\': \'Sabio hueco\', \'text\': \'Siempre que el Sabio hueco sea enderezado, puedes hacer que el jugador objetivo descarte una carta.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'Se cuenta que en las mentes de los sabios huecos anidan los sueños de las noches oscuras que vendrán.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172740&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2ece03cd-d93b-460c-ae3d-8e340a89388e\', \'multiverseId\': 172740}, \'multiverseid\': 172740}, {\'name\': \'Sage des tréfonds\', \'text\': "À chaque fois que le Sage des tréfonds devient dégagé, vous pouvez faire que le joueur ciblé se défausse d\'une carte.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': \'On prétend que les rêves noirs des nuits à venir hantent les esprits des sages des tréfonds comploteurs.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173342&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'88bbb003-6937-41cd-bdfb-93bedac9498b\', \'multiverseId\': 173342}, \'multiverseid\': 173342}, {\'name\': \'Saggio Incupito\', \'text\': \'Ogniqualvolta il Saggio Incupito viene STAPpato, puoi fare scartare una carta a un giocatore bersaglio.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'Si dice che i sogni delle notti oscure si mescolino nelle menti degli scaltri saggi incupiti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173643&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ba04cf69-b7e2-4bc6-a632-33d255602d8f\', \'multiverseId\': 173643}, \'multiverseid\': 173643}, {\'name\': \'虚賢者\', \'text\': \'虚賢者がアンタップ状態になるたび、プレイヤー１人を対象とする。あなたは「そのプレイヤーはカードを１枚捨てる。」を選んでもよい。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'来るべき暗い夜の夢は、策を練る虚賢者の心から生まれると言われている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173944&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b074b8cf-d3a6-413b-b968-674c4bf3c3ef\', \'multiverseId\': 173944}, \'multiverseid\': 173944}, {\'name\': \'Nulosábio\', \'text\': \'Toda vez que Nulosábio se tornar desvirado, você poderá fazer com que o jogador alvo descarte um card.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'Dizem que os sonhos das noites sombrias por vir pululam nas mentes dos ardilosos nulosábios.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172138&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c9987b2b-d69f-4741-bfbf-8943fca0fc2a\', \'multiverseId\': 172138}, \'multiverseid\': 172138}, {\'name\': \'Коварный Мудрец-Пустынник\', \'text\': \'Каждый раз, когда Коварный Мудрец-Пустынник разворачивается, вы можете заставить целевого игрока сбросить карту.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Говорят, что в думах коварных пустынников живут мечты о грядущих темных ночах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172439&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d2b46729-1c2a-4c94-b11e-d3f1d7ca8dd3\', \'multiverseId\': 172439}, \'multiverseid\': 172439}, {\'name\': \'寂空贤者\', \'text\': \'每当寂空贤者成为未横置时，你可以令目标牌手弃一张牌。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'将临的黑暗夜晚，据说总让满腹阴谋的寂空贤者振奋不已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173041&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'290e1a1d-92f0-438f-84b1-ecc0b7d6c926\', \'multiverseId\': 173041}, \'multiverseid\': 173041}]', '[{\'name\': \'Merrow-Dreckschießer\', \'text\': \'{1}{U/B}, {Q}: Eine Kreatur deiner Wahl erhält -2/-0 bis zum Ende des Zuges. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Dreckschießer verbringen so viel Zeit in den Dunklen Mäandern, dass sie einen Teil davon immer mit sich mitschleppen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174648&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c714b5ae-3f01-4e3f-9c27-cf898a817d54\', \'multiverseId\': 174648}, \'multiverseid\': 174648}, {\'name\': \'Merrow arrojamugre\', \'text\': \'{1}{U/B}, {Q}: La criatura objetivo obtiene -2/-0 hasta el final del turno. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'Los arrojamugre pasan tanto tiempo en los Meandros Oscuros que pueden llevar un poco donde quiera que vayan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172842&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8396a950-9988-42cd-a383-0edfe77f4ed1\', \'multiverseId\': 172842}, \'multiverseid\': 172842}, {\'name\': \'Crachelimon suire\', \'text\': "{1}{U/B}, {Q} : La créature ciblée gagne -2/-0 jusqu\'à la fin du tour. ({Q} est le symbole de dégagement.)", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "Les crachelimons passent tant de temps dans les Méandres obscurs qu\'ils restent toujours avec eux où qu\'ils aillent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173444&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0c1af3d7-9bfd-4b43-9b7e-3de016f4d830\', \'multiverseId\': 173444}, \'multiverseid\': 173444}, {\'name\': \'Spruzzamelma Merrow\', \'text\': \'{1}{U/B}, {Q}: Una creatura bersaglio prende -2/-0 fino alla fine del turno. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'Gli spruzzamelma passano tanto di quel tempo nei Meandri Oscuri che sono in grado di portarne con sé ovunque decidano di andare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173745&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9bf20a26-8f72-4211-8543-ed038dc064f4\', \'multiverseId\': 173745}, \'multiverseid\': 173745}, {\'name\': \'メロウの垢吐き\', \'text\': \'{1}{U/B}, {Q}：クリーチャー１体を対象とする。それはターン終了時まで－２/－０の修整を受ける。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'垢吐きは闇うねりの中に長く潜みすぎたせいで、その欠片を自分の行く先のどこでも持ち込むことができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174046&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9694dda9-5358-4842-8d37-e1810a2da3dd\', \'multiverseId\': 174046}, \'multiverseid\': 174046}, {\'name\': \'Sirenídeo Espirra-Gosma\', \'text\': \'{1}{U/B}, {Q}: A criatura alvo recebe -2/-0 até o final do turno. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'Os espirra-gosma passam tanto tempo nos Meandros Escuros que podem trazer uma parte consigo por onde quer que andem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172240&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f09edf02-a837-45ee-b810-833a71a55747\', \'multiverseId\': 172240}, \'multiverseid\': 172240}, {\'name\': \'Стреляющий Грязью Мерроу\', \'text\': \'{1}{U/B}, {Q}: целевое существо получает -2/-0 до конца хода. ({Q} символ разворота карты.)\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Грязестрелы проводят в Темных Меандрах так много времени, что они могут взять с собой кусочек этой жуткой стихии, куда бы они не отправлялись.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172541&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4055ad25-3b6a-43de-b93a-3b3faeb912ed\', \'multiverseId\': 172541}, \'multiverseid\': 172541}, {\'name\': \'美洛墨隐师\', \'text\': \'{1}{U/B}，{Q}：目标生物得-2/-0直到回合结束。 （{Q}是重置符号。）\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'墨隐师花很多时间留在暗曲礁，让自己不论到何方都能随身带着该处的一小部分。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173143&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3dc87931-e4f5-4e05-a116-e34c302d2bf9\', \'multiverseId\': 173143}, \'multiverseid\': 173143}]', '[{\'name\': \'Merrow-Wellenbrecher\', \'text\': \'{1}{U}, {Q}: Die Merrow-Wellenbrecher erhalten bis zum Ende des Zuges Flugfähigkeit. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Meervolk, Soldat\', \'flavor\': \'Die Beute der Merrow hatte sich vom Ufer zurückgezogen, daher mussten sie lernen, wie man ihr folgt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174521&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df1f1f5d-8d8e-4c66-933f-b678b89e4d00\', \'multiverseId\': 174521}, \'multiverseid\': 174521}, {\'name\': \'Rompeolas merrow\', \'text\': \'{1}{U}, {Q}: Los Rompeolas merrow ganan la habilidad de volar hasta el final del turno. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Soldado tritón\', \'flavor\': \'Las presas de los merrow huyeron de la orilla, así que aprendieron a seguirlas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172715&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ddf3958e-b2ab-40f6-b830-a57588f6373d\', \'multiverseId\': 172715}, \'multiverseid\': 172715}, {\'name\': \'Briselames suires\', \'text\': "{1}{U}, {Q} : Les Briselames suires acquièrent le vol jusqu\'à la fin du tour. ({Q} est le symbole de dégagement.)", \'type\': \'Créature : ondin et soldat\', \'flavor\': \'Les proies des suires se sont éloignées du rivage, alors ils ont appris à les suivre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173317&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'21fca09b-239e-4954-9905-12efee21a6c1\', \'multiverseId\': 173317}, \'multiverseid\': 173317}, {\'name\': \'Spezzaonde Merrow\', \'text\': \'{1}{U}, {Q}: Gli Spezzaonde Merrow hanno volare fino alla fine del turno. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Soldato Tritone\', \'flavor\': \'Le prede dei merrow si sono ritirate dalla riva e questi hanno imparato a seguirle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173618&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1dcac7c0-726f-4c65-ac53-1950d49e2e12\', \'multiverseId\': 173618}, \'multiverseid\': 173618}, {\'name\': \'メロウの波破り\', \'text\': \'{1}{U}, {Q}：メロウの波破りはターン終了時まで飛行を得る。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — マーフォーク･兵士\', \'flavor\': \'メロウの獲物は岸から離れてしまったので、彼らも追う術を学んだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173919&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a46c8703-bcc3-43c8-8d49-da05a52f0409\', \'multiverseId\': 173919}, \'multiverseid\': 173919}, {\'name\': \'Sirenídeos Saltadores\', \'text\': \'{1}{U}, {Q}: Sirenídeos Saltadores ganha voar até o final do turno. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Tritão Soldado\', \'flavor\': \'As presas dos sirenídeos afastaram-se da costa, então eles aprenderam a segui-las.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172113&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'38ac48e4-419c-4bee-9b91-9de62954f491\', \'multiverseId\': 172113}, \'multiverseid\': 172113}, {\'name\': \'Летучие Мерроу\', \'text\': \'{1}{U}, {Q}: Летучие Мерроу получают Полет до конца хода. ({Q} символ разворота карты.)\', \'type\': \'Существо — Мерфолк Солдат\', \'flavor\': \'Добыча мерроу постепенно покинула побережье, поэтому им пришлось научиться охотиться по-новому.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172414&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'02bc5e78-7d4d-4e11-93bd-8a464c8a8bbc\', \'multiverseId\': 172414}, \'multiverseid\': 172414}, {\'name\': \'破浪美洛\', \'text\': \'{1}{U}，{Q}：破浪美洛获得飞行异能直到回合结束。 （{Q}是重置符号。）\', \'type\': \'生物～人鱼／士兵\', \'flavor\': \'美洛的猎物已自海岸撤退，他们因此学会如何跟进。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173016&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8cd1c7ea-1230-4c93-b59b-52c1c13021f9\', \'multiverseId\': 173016}, \'multiverseid\': 173016}]', "[{'name': 'Metzelfieber', 'text': 'Kreaturenverzauberung\\nDie verzauberte Kreatur greift in jedem Zug an, falls möglich.', 'type': 'Verzauberung — Aura', 'flavor': 'Rußwesenmagier lieben es, wenn ihre Opfer in Blutrausch verfallen — und hinterher unvermeidbar in Reue.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174561&type=card', 'language': 'German', 'identifiers': {'scryfallId': '983e175b-963f-4522-a69e-c444a7c5ee90', 'multiverseId': 174561}, 'multiverseid': 174561}, {'name': 'Fiebre de sangre', 'text': 'Encantar criatura.\\nLa criatura encantada ataca cada turno si puede.', 'type': 'Encantamiento — Aura', 'flavor': 'Los magos cenicientos disfrutan viendo a sus víctimas retorciéndose con sed de sangre y viendo el arrepentimiento que inevitablemente le sigue.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172755&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'aed50d7c-ed2d-43ca-b2e2-c667bb3c97ee', 'multiverseId': 172755}, 'multiverseid': 172755}, {'name': 'Fièvre du sang versé', 'text': 'Enchanter : créature\\nLa créature enchantée attaque à chaque tour si possible.', 'type': 'Enchantement : aura', 'flavor': 'Les magiciens scoriacés aiment voir leurs victimes succomber à la soif de sang — puis regretter immédiatement leurs actes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173357&type=card', 'language': 'French', 'identifiers': {'scryfallId': '42790cfc-6070-4f03-9078-aa8384b38ba7', 'multiverseId': 173357}, 'multiverseid': 173357}, {'name': 'Febbre Massacrante', 'text': 'Incanta creatura\\nLa creatura incantata attacca ogni turno, se può farlo.', 'type': 'Incantesimo — Aura', 'flavor': 'I maghi cinerei si divertono nel vedere le loro vittime in preda a una furia sanguinaria... e nel vedere il rimorso che inevitabilmente ne consegue.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173658&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3428db81-c56a-4440-b665-c6863ddc10a6', 'multiverseId': 173658}, 'multiverseid': 173658}, {'name': '流血の熱病', 'text': 'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、毎ターン可能ならば攻撃する。', 'type': 'エンチャント — オーラ', 'flavor': '燃えがらの魔道士には、犠牲者が殺戮の苦悩に襲われること――そして、その後避けえぬ後悔の念を眺めるのが楽しみの一つだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173959&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '0e0a2800-1317-466f-9de8-d1d4682039c6', 'multiverseId': 173959}, 'multiverseid': 173959}, {'name': 'Febre Sanguinária', 'text': 'Encantar criatura\\nA criatura encantada ataca a cada turno se estiver apta.', 'type': 'Encantamento — Aura', 'flavor': 'Os magos cinzeríneos gostam de ver suas vítimas se esfalfando na sua sede de sangue e o arrependimento inevitável que se segue.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172153&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '1759a472-c3d9-492a-b1a3-03463c513828', 'multiverseId': 172153}, 'multiverseid': 172153}, {'name': 'Безумное Кровопролитие', 'text': 'Зачаровать существо\\nЗачарованное существо атакует в каждом ходу, если может.', 'type': 'Чары — Аура', 'flavor': 'Магам-золовикам нравится видеть свои жертвы, обуреваемые жаждой крови, и наблюдать неизбежно следующее за этим раскаяние.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172454&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f5e87031-b556-45f0-b3fb-81b8220890cc', 'multiverseId': 172454}, 'multiverseid': 172454}, {'name': '浴血狂热', 'text': '生物结界\\n受此结界的生物每回合若能攻击，则必须攻击。', 'type': '结界～灵气', 'flavor': '烬身法师喜欢看苦主因嗜血欲望而痛苦挣扎～以及观察他们因注定后果而后悔的样子。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173056&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f7e299bb-cc41-45f6-8bd0-c3b8eb177664', 'multiverseId': 173056}, 'multiverseid': 173056}]", '[{\'name\': \'Minengrabung\', \'text\': \'Bringe eine Artefakt- oder Verzauberungskarte deiner Wahl aus einem Friedhof auf die Hand ihres Besitzers zurück.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere den Zauberspruch; du kannst für die Kopie ein neues Ziel bestimmen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174490&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'61afe765-b76d-48b7-b9c0-e86b463bfeec\', \'multiverseId\': 174490}, \'multiverseid\': 174490}, {\'name\': \'Excavar la mina\', \'text\': \'Regresa la carta de artefacto o encantamiento objetivo en un cementerio a la mano de su propietario.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo y puedes elegir un nuevo objetivo para la copia.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172684&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da3658fb-5181-4e3e-9d2f-bf1795f4b7fb\', \'multiverseId\': 172684}, \'multiverseid\': 172684}, {\'name\': \'Excavation minière\', \'text\': "Renvoyez la carte d\'artefact ou d\'enchantement ciblée dans un cimetière dans la main de son propriétaire.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le et vous pouvez choisir une nouvelle cible pour la copie.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173286&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2ecd1a36-062f-4a7e-8e41-533b6cb0cf4d\', \'multiverseId\': 173286}, \'multiverseid\': 173286}, {\'name\': \'Scavi in Miniera\', \'text\': \'Fai tornare una carta artefatto o incantesimo bersaglio in un cimitero in mano al suo proprietario.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia. Puoi scegliere un nuovo bersaglio per la copia.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173587&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1698a85-154e-46b1-9539-d56504df9675\', \'multiverseId\': 173587}, \'multiverseid\': 173587}, {\'name\': \'鉱山の採掘\', \'text\': \'いずれかの墓地にあるアーティファクト・カード１枚かエンチャント・カード１枚を対象とし、それをオーナーの手札に戻す。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。あなたはそのコピーの新たな対象を選んでもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173888&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0890dc84-9fd5-4748-84e9-92b04be3b5e4\', \'multiverseId\': 173888}, \'multiverseid\': 173888}, {\'name\': \'Escavação de Mina\', \'text\': \'Devolva para a mão de seu dono o card de artefato ou encantamento alvo num cemitério.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela e você poderá escolher um novo alvo para a cópia.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172082&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'124a6b13-fac7-447b-b457-7f366bd72f05\', \'multiverseId\': 172082}, \'multiverseid\': 172082}, {\'name\': \'Раскопки Шахты\', \'text\': \'Верните находящуюся на кладбище целевую карту артефакта или чар в руку ее владельца.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его, и вы можете выбрать новую цель для этой копии.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172383&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28c25d7f-8461-4b1a-bc6b-dfadac9ec6b6\', \'multiverseId\': 172383}, \'multiverseid\': 172383}, {\'name\': \'开挖宝库\', \'text\': \'将目标神器或结界牌从坟墓场移回其拥有者手上。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语，且你可以为该复制品选择新的目标。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172985&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce6ace2c-4d01-4954-a9ed-01b033120994\', \'multiverseId\': 172985}, \'multiverseid\': 172985}]', '[{\'name\': \'Mitternachts-Todesfee\', \'text\': \'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nLege zu Beginn deines Versorgungssegments eine -1/-1-Marke auf alle nichtschwarzen Kreaturen.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Viele haben den Anfang ihres tiefen, anhaltenden Klagerufs vernommen, doch nur wenige das Ende.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174549&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'14f50ab1-a01a-407b-bab2-61f93e94b5a5\', \'multiverseId\': 174549}, \'multiverseid\': 174549}, {\'name\': \'Banshee de medianoche\', \'text\': \'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\\nAl comienzo de tu mantenimiento, pon un contador -1/-1 sobre cada criatura que no sea negra.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Muchos han escuchado el comienzo de su grito, pero muy pocos el final.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172743&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b7014588-40d4-4e1e-8edd-5e1203899f05\', \'multiverseId\': 172743}, \'multiverseid\': 172743}, {\'name\': \'Banshee de minuit\', \'text\': \'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nAu début de votre entretien, mettez un marqueur -1/-1 sur chaque créature non-noire.\', \'type\': \'Créature : esprit\', \'flavor\': \'Beaucoup ont entendu le début de son long cri glaçant, mais peu en ont entendu la fin.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173345&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'97ef3475-c763-444d-8687-b9b2e53f8b02\', \'multiverseId\': 173345}, \'multiverseid\': 173345}, {\'name\': \'Banshee di Mezzanotte\', \'text\': "Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nAll\'inizio del tuo mantenimento, metti un segnalino -1/-1 su ogni creatura non nera.", \'type\': \'Creatura — Spirito\', \'flavor\': "Molti hanno udito l\'inizio del suo urlo basso e costante, ma pochi la fine.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173646&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'649ccd84-f14c-4f6e-966c-cbbd64234389\', \'multiverseId\': 173646}, \'multiverseid\': 173646}, {\'name\': \'真夜中のバンシー\', \'text\': \'萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\nあなたのアップキープの開始時に、黒でない各クリーチャーの上にそれぞれ－１/－１カウンターを１個置く。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'その低く続く鳴き声の最初を聞く者は多いが、最後を聞く者は少ない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173947&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36662558-b6b1-4fe4-a374-52678baf70b5\', \'multiverseId\': 173947}, \'multiverseid\': 173947}, {\'name\': \'Banshee da Meia-Noite\', \'text\': \'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\\nNo início de sua manutenção, coloque um marcador -1/-1 em cada criatura que não seja preta.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Muitos já ouviram o início de seu grito baixo e uniforme, mas poucos seu fim.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172141&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b442ac60-c806-4404-9578-5a934d46317a\', \'multiverseId\': 172141}, \'multiverseid\': 172141}, {\'name\': \'Полуночная Баньши\', \'text\': \'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\\nВ начале вашего шага поддержки положите один жетон -1/-1 на каждое нечерное существо.\', \'type\': \'Существо — Дух\', \'flavor\': \'Многие слышали начало ее протяжного низкого вопля, но мало кто слышал его конец.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172442&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ace2fa61-a359-49d4-8002-92c94d8962c6\', \'multiverseId\': 172442}, \'multiverseid\': 172442}, {\'name\': \'午夜女妖\', \'text\': \'干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\\n在你的维持开始时，在每个非黑色生物上各放置一个-1/-1指示物。\', \'type\': \'生物～精怪\', \'flavor\': \'许多人听过它低沉、绵长尖叫的开头，但很少有人听到结尾。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173044&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f90c201-615e-4af4-8921-30e81ef9b0d1\', \'multiverseId\': 173044}, \'multiverseid\': 173044}]', '[{\'name\': \'Mondring-Insel\', \'text\': \'({T}: Erhöhe deinen Manavorrat um {U}.)\\nDie Mondring-Insel kommt getappt ins Spiel.\\n{U}, {T}: Schaue dir die oberste Karte der Bibliothek eines Spielers deiner Wahl an. Spiele diese Fähigkeit nur, falls du zwei oder mehr blaue bleibende Karten kontrollierst.\', \'type\': \'Land — Insel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174753&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'757aaae9-0144-4b8b-a80b-81e2f9d7d01a\', \'multiverseId\': 174753}, \'multiverseid\': 174753}, {\'name\': \'Isla anillo lunar\', \'text\': \'({T}: Agrega {U} a tu reserva de maná.)\\nLa Isla anillo lunar entra en juego girada.\\n{U}, {T}: Mira la primera carta de la biblioteca del jugador objetivo. Juega esta habilidad sólo si controlas dos o más permanentes azules.\', \'type\': \'Tierra — Isla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172947&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'45476c30-a0f4-4072-aa3b-714ccc17a887\', \'multiverseId\': 172947}, \'multiverseid\': 172947}, {\'name\': "Île de l\'Anneau-lune", \'text\': "({T} : Ajoutez {U} à votre réserve.)\\nL\'Île de l\'Anneau-lune arrive en jeu engagée.\\n{U}, {T} : Regardez la carte du dessus de la bibliothèque du joueur ciblé. Ne jouez cette capacité que si vous contrôlez au moins deux permanents bleus.", \'type\': \'Terrain : île\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173549&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'debe585c-8046-44c1-82ec-fd06183abfc2\', \'multiverseId\': 173549}, \'multiverseid\': 173549}, {\'name\': \'Isola Anello di Luna\', \'text\': "({T}: Aggiungi {U} alla tua riserva di mana.)\\nL\'Isola Anello di Luna entra in gioco TAPpata.\\n{U}, {T}: Guarda la prima carta del grimorio di un giocatore bersaglio. Gioca questa abilità solo se controlli due o più permanenti blu.", \'type\': \'Terra — Isola\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173850&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'63470649-76e0-44ac-8814-0614c8c6a40d\', \'multiverseId\': 173850}, \'multiverseid\': 173850}, {\'name\': \'月の輪の島\', \'text\': \'（{T}：あなたのマナプールに{U}を加える。）\\n月の輪の島はタップ状態で場に出る。\\n{U}, {T}：プレイヤー１人を対象とし、そのプレイヤーのライブラリーの一番上のカードを見る。 この能力は、あなたが２つ以上の青のパーマネントをコントロールしている場合にのみプレイできる。\', \'type\': \'土地 — 島\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174151&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0728fd38-e547-41f3-bc76-06739aa61bba\', \'multiverseId\': 174151}, \'multiverseid\': 174151}, {\'name\': \'Ilha do Anel Lunar\', \'text\': \'({T}: Adicione {U} à sua reserva de mana.)\\nIlha do Anel Lunar entra em jogo virado.\\n{U}, {T}: Olhe o card do topo do grimório do jogador alvo. Jogue esta habilidade somente se você controlar duas ou mais permanentes azuis.\', \'type\': \'Terreno — Ilha\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172345&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4537a77c-9f3e-4c0d-b5a5-c3e21662f294\', \'multiverseId\': 172345}, \'multiverseid\': 172345}, {\'name\': \'Остров Лунного Кольца\', \'text\': \'({T}: добавьте {U} в ваше хранилище маны.)\\nОстров Лунного Кольца входит в игру повернутым.\\n{U}, {T}: посмотрите верхнюю карту библиотеки целевого игрока. Разыгрывайте эту способность, только если вы контролируете два или более синих перманента.\', \'type\': \'Земля — Остров\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172646&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0cc391b9-e838-4e1f-b01c-af24daeb6261\', \'multiverseId\': 172646}, \'multiverseid\': 172646}, {\'name\': \'月轮岛\', \'text\': \'（{T}：加{U}到你的法术力池中。）\\n月轮岛须横置进场。\\n{U}，{T}：检视目标牌手的牌库顶牌。 你只可以于你操控两个或更多蓝色永久物时使用此异能。\', \'type\': \'地～海岛\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173248&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6e4264b3-b243-43b6-ba35-5cbf43cfb1dd\', \'multiverseId\': 173248}, \'multiverseid\': 173248}]', '[{\'name\': \'Moosbrückentroll\', \'text\': \'Falls der Moosbrückentroll zerstört würde, regeneriere ihn.\\nTappe eine beliebige Anzahl an ungetappten Kreaturen außer dem Moosbrückentroll, die du kontrollierst und die zusammen mindestens Stärke 10 haben: Der Moosbrückentroll erhält +20/+20 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Troll\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174600&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dfc62083-38a8-40a1-9498-959f0a11a938\', \'multiverseId\': 174600}, \'multiverseid\': 174600}, {\'name\': \'Trol puente de musgo\', \'text\': \'Si el Trol puente de musgo fuera a ser destruido, regenéralo.\\nGirar cualquier cantidad de criaturas enderezadas que controles que no sean el Trol puente de musgo con una fuerza total de 10 o más: El Trol puente de musgo obtiene +20/+20 hasta el final del turno.\', \'type\': \'Criatura — Trol\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172794&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60fb2053-bab2-4eb9-813b-d9278e999048\', \'multiverseId\': 172794}, \'multiverseid\': 172794}, {\'name\': \'Troll de moussepont\', \'text\': "Si le Troll de moussepont devait être détruit, régénérez-le.\\nEngagez n\'importe quel nombre de créatures dégagées que vous contrôlez autre que le Troll de moussepont ayant une force totale supérieure ou égale à 10 : Le Troll de moussepont gagne +20/+20 jusqu\'à la fin du tour.", \'type\': \'Créature : troll\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173396&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'28227344-f386-4d6b-8999-5d4678ac476e\', \'multiverseId\': 173396}, \'multiverseid\': 173396}, {\'name\': \'Troll del Ponte Muscoso\', \'text\': \'Se il Troll del Ponte Muscoso sta per essere distrutto, rigeneralo.\\nTAPpa un qualsiasi numero di creature STAPpate che controlli diverse dal Troll del Ponte Muscoso con forza totale pari o superiore a 10: Il Troll del Ponte Muscoso prende +20/+20 fino alla fine del turno.\', \'type\': \'Creatura — Troll\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173697&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6ff8a50d-d101-493e-ba07-6eb7b572be20\', \'multiverseId\': 173697}, \'multiverseid\': 173697}, {\'name\': \'苔橋のトロール\', \'text\': \'苔橋のトロールが破壊される場合、それを再生する。\\n苔橋のトロール以外の、パワーの合計が10以上になる望む数のあなたがコントロールするアンタップ状態のクリーチャーをタップする：苔橋のトロールはターン終了時まで＋20/＋20の修整を受ける。\', \'type\': \'クリーチャー — トロール\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173998&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'48053943-e27f-4438-87f0-2bd55b53ecf8\', \'multiverseId\': 173998}, \'multiverseid\': 173998}, {\'name\': \'Trol da Ponte Musgosa\', \'text\': \'Se Trol da Ponte Musgosa for ser destruído, regenere-o.\\nVire qualquer número de criaturas desviradas que você controla excluindo Trol da Ponte Musgosa com poder total maior ou igual a 10: Trol da Ponte Musgosa recebe +20/+20 até o final do turno.\', \'type\': \'Criatura — Trol\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172192&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'11897bcf-1ee7-4034-bb26-b15644a96463\', \'multiverseId\': 172192}, \'multiverseid\': 172192}, {\'name\': \'Тролль Замшелого Моста\', \'text\': \'Если Тролль Замшелого Моста должен быть уничтожен, регенерируйте его.\\nПоверните любое количество неповернутых существ под вашим контролем, отличных от Тролля Замшелого Моста, суммарная сила которых равна 10 или более: Тролль Замшелого Моста получает +20/+20 до конца хода.\', \'type\': \'Существо — Тролль\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172493&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'960c8408-b168-4b42-a3e5-cf5b40f3cc4d\', \'multiverseId\': 172493}, \'multiverseid\': 172493}, {\'name\': \'苔桥巨魔\', \'text\': \'如果苔桥巨魔将被消灭，则重生之。\\n横置任意数量由你操控、不包括苔桥巨魔、且力量总和为10或更多的未横置生物：苔桥巨魔得+20/+20直到回合结束。\', \'type\': \'生物～巨魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173095&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aab666be-0dae-4d25-9909-5aefe681743f\', \'multiverseId\': 173095}, \'multiverseid\': 173095}]', '[{\'name\': \'Mystisches Tor\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{W/U}, {T}: Erhöhe deinen Manavorrat um {W}{W}, {W}{U} oder {U}{U}.\', \'type\': \'Land\', \'flavor\': \'In das Tor zu jedem Kithkin-Marktflecken ist eine hinterhältige Falle eingebaut, um unerwünschte Besucher in eine Fallgrube stürzen zu lassen, aus der es kein Entkommen gibt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174754&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c6370673-df19-433d-a28a-3c7158b2f08f\', \'multiverseId\': 174754}, \'multiverseid\': 174754}, {\'name\': \'Portal místico\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{W/U}, {T}: Agrega {W}{W}, {W}{U}, o {U}{U} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'El portal de todo doun kithkin es una trampa astuta, que podría dejar caer a los visitantes en una mazmorra de la cual no hay salida.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172948&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c7c3f38f-7646-4f1c-918d-cace889cb2c1\', \'multiverseId\': 172948}, \'multiverseid\': 172948}, {\'name\': \'Porte mystique\', \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{W/U}, {T} : Ajoutez {W}{W}, {W}{U} ou {U}{U} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "La porte de chaque doune sangami est un piège rusé qui plonge les visiteurs dans une oubliette dont ils ne pourront jamais s\'échapper.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173550&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a12590d-b4a3-4f9a-bddc-635f2424104e\', \'multiverseId\': 173550}, \'multiverseid\': 173550}, {\'name\': \'Cancello Mistico\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{W/U}, {T}: Aggiungi {W}{W}, {W}{U}, o {U}{U} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "Il cancello di ogni doun kithkin è un\'astuta trappola, fatta per accogliere i visitatori all\'interno di una segreta senza possibilità di fuga.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173851&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'34fd6673-da96-4f14-b0a4-56ba6be38589\', \'multiverseId\': 173851}, \'multiverseid\': 173851}, {\'name\': \'秘教の門\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n, {T}：あなたのマナ・プールに{W}{W}か{W}{U}か{U}{U}を加える。\', \'type\': \'土地\', \'flavor\': \'キスキンの矮村の門はどれも狡猾な罠で、訪れた者を逃げ場の無い牢獄へと誘い込む。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174152&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e1158f2d-d4b8-4103-824d-01a94ddb7ea3\', \'multiverseId\': 174152}, \'multiverseid\': 174152}, {\'name\': \'Portão Místico\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{W/U}, {T}: Adicione {W}{W}, {W}{U} ou {U}{U} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'O portão de todos os doun kithkin é uma ardilosa armadilha, cuja intenção é lançar os visitantes em uma masmorra da qual não há saída.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172346&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d1ad9319-b686-448e-ba2e-8909e25a80a6\', \'multiverseId\': 172346}, \'multiverseid\': 172346}, {\'name\': \'Загадочные Врата\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{W/U}, {T}: добавьте {W}{W}, {W}{U} или {U}{U} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Ворота каждого кискенского острога это хитроумная ловушка, бросающая незваных гостей в подземную темницу, из которой нет дороги назад.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172647&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0865bc2-d67a-40de-a6c5-e593235b5989\', \'multiverseId\': 172647}, \'multiverseid\': 172647}, {\'name\': \'神秘门户\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{W/U}，{T}：加{W}{W}，{W}{U}，或{U}{U}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'每个洁英小镇的门都是精心设计的陷阱，好让外来客摔到没有出口的地牢中。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173249&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fcb93fce-bb7a-4689-bc99-13fcf9f59993\', \'multiverseId\': 173249}, \'multiverseid\': 173249}]', '[{\'name\': \'Mörderische Blutkappe\', \'text\': \'Wenn die Mörderische Blutkappe ins Spiel kommt, fügt sie einer Kreatur oder einem Spieler deiner Wahl Schadenspunkte in Höhe ihrer Stärke zu.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Goblin, Assassine\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174669&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7dfbe5e4-80f4-467f-8a80-6628c9dc4cf3\', \'multiverseId\': 174669}, \'multiverseid\': 174669}, {\'name\': \'Asesino gorro rojo\', \'text\': \'Cuando el Asesino gorro rojo entre en juego le hace una cantidad de daño igual a su fuerza a la criatura o jugador objetivo.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Asesino trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172863&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c4bf0fd6-9c57-4e78-acb1-cb8691a7d872\', \'multiverseId\': 172863}, \'multiverseid\': 172863}, {\'name\': \'Bonnet-rouge meurtrier\', \'text\': "Quand le Bonnet-rouge meurtrier arrive en jeu, il inflige un nombre de blessures égal à sa force à une cible, créature ou joueur.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : gobelin et assassin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173465&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e30fc8b8-31de-466c-852f-0dd2b41df68b\', \'multiverseId\': 173465}, \'multiverseid\': 173465}, {\'name\': \'Omicida dal Berretto Rosso\', \'text\': "Quando l\'Omicida dal Berretto Rosso entra in gioco, infligge danno pari alla propria forza a una creatura o a un giocatore bersaglio.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)", \'type\': \'Creatura — Assassino Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173766&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'487e66d8-052a-48de-80b4-4990784bc0cb\', \'multiverseId\': 173766}, \'multiverseid\': 173766}, {\'name\': \'残忍なレッドキャップ\', \'text\': \'残忍なレッドキャップが場に出たとき、クリーチャー１体かプレイヤー１人を対象とする。残忍なレッドキャップはそれに自身のパワーに等しい点数のダメージを与える。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — ゴブリン・暗殺者\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174067&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'29fe58f6-035f-4c25-8457-e51b3ad1ed93\', \'multiverseId\': 174067}, \'multiverseid\': 174067}, {\'name\': \'Barrete Vermelho Assassino\', \'text\': \'Quando Barrete Vermelho Assassino entra em jogo, ele causa dano igual ao seu poder à criatura ou ao jogador alvo.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Goblin Assassino\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172261&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ad550b42-ca06-49d7-b4a4-94ca0bc04f59\', \'multiverseId\': 172261}, \'multiverseid\': 172261}, {\'name\': \'Кровожадный Красный Колпак\', \'text\': \'Когда Кровожадный Красный Колпак входит в игру, он наносит целевому существу или игроку количество повреждений, равное своей силе.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Гоблин Убийца\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172562&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bfc68ad8-2b21-4658-b021-fa0e0d47cce0\', \'multiverseId\': 172562}, \'multiverseid\': 172562}, {\'name\': \'夺魂红帽客\', \'text\': \'当夺魂红帽客进场时，它对目标生物或牌手造成伤害，其数量等同于其力量。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～精灵／杀手\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173164&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fcb86aa-94ba-46a9-a950-82fcd6a6cdfd\', \'multiverseId\': 173164}, \'multiverseid\': 173164}]', '[{\'name\': \'Mühsam erkämpfter Ruhm\', \'text\': \'Du erhältst je 1 Lebenspunkt für alle getappten Artefakte, Kreaturen und Länder, die du kontrollierst.\', \'type\': \'Hexerei\', \'flavor\': \'Die Kriegerin, die als einzige in ihrer Patrouille überlebte, erwartete bei ihrer Rückkehr ins Lager Enttäuschung und Verachtung. Doch das Gegenteil war der Fall. „Du bist noch am Leben Das ist ein Grund zum Feiern."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174607&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ecd0b78c-ffe7-4331-a4d0-2bbadbcbf74b\', \'multiverseId\': 174607}, \'multiverseid\': 174607}, {\'name\': \'Trabajar por renombre\', \'text\': \'Ganas 1 vida por cada artefacto, criatura y tierra girada que controles.\', \'type\': \'Conjuro\', \'flavor\': \'Como último sobreviviente de su patrulla, la guerrera volvió esperando desdén y rechazo. En lugar de eso encontró gratitud. "Estás viva. Eso es suficiente para celebrar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172801&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d92ae124-1dbd-443a-bd12-9af3f2e353b7\', \'multiverseId\': 172801}, \'multiverseid\': 172801}, {\'name\': \'Renommée par épreuve\', \'text\': \'Vous gagnez 1 point de vie pour chaque artefact, créature et terrain engagés que vous contrôlez.\', \'type\': \'Rituel\', \'flavor\': "Unique survivante de sa patrouille, la guerrière s\'attendait à ce que son retour soit accueilli avec mépris et déception. En fait, la gratitude l\'attendait. « Tu es en vie. C\'est une bonne chose à célébrer. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173403&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ea23de86-bc86-4ed9-9f5a-5df799190adf\', \'multiverseId\': 173403}, \'multiverseid\': 173403}, {\'name\': \'Sudare per la Fama\', \'text\': \'Guadagni 1 punto vita per ogni artefatto, creatura e terra TAPpati che controlli.\', \'type\': \'Stregoneria\', \'flavor\': \'Ultima sopravvissuta della sua pattuglia, la guerriera fece ritorno aspettandosi scherno e disappunto. Invece trovò gratitudine. "Sei ancora viva. Un buon motivo per festeggiare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173704&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'bde66aab-0afe-4162-8175-790ef8630a64\', \'multiverseId\': 173704}, \'multiverseid\': 173704}, {\'name\': \'高名への苦役\', \'text\': \'あなたは、あなたがコントロールするタップ状態の、アーティファクトかクリーチャーか土地１つにつき１点のライフを得る。\', \'type\': \'ソーサリー\', \'flavor\': \'巡回兵の最後の生き残りの戦士は、失望と軽蔑を受けることを思いながら帰還した。 しかし、彼女が示したのは感謝だった。 「生きて帰ってきたのですから。 祝賀に値することです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174005&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'cef02441-a108-4d21-b56d-a41b2ae529da\', \'multiverseId\': 174005}, \'multiverseid\': 174005}, {\'name\': \'Trabalhar pela Reputação\', \'text\': \'Você ganha 1 ponto de vida para cada artefato, criatura e terreno virado que você controla.\', \'type\': \'Feitiço\', \'flavor\': \'Como última sobrevivente de sua patrulha, a guerreira retornou esperando somente decepção e escárnio. Mas, em vez disso, encontrou gratidão. "Você está viva. Isso é motivo de celebração."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172199&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9fa04a76-145a-492e-a08c-df162a7356fd\', \'multiverseId\': 172199}, \'multiverseid\': 172199}, {\'name\': \'Труд Ради Славы\', \'text\': \'Вы получаете 1 жизнь за каждый повернутый артефакт, существо и землю под вашим контролем.\', \'type\': \'Волшебство\', \'flavor\': \'Последняя выжившая из всех патрульных, воительница вернулась, ожидая встретить разочарование и презрение. Вместо этого, она была принята с благодарностью. «Ты жива, и это большая радость».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172500&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'15e6f735-c5ea-419b-8fbb-16a75e8f492c\', \'multiverseId\': 172500}, \'multiverseid\': 172500}, {\'name\': \'历险孚望\', \'text\': \'你每操控一个横置的神器，生物，以及地，便获得1点生命。\', \'type\': \'法术\', \'flavor\': \'巡逻队的最后一名生还战士逃了回来，已有给失望的长官痛骂一顿的觉悟。 而迎接她的却是一份感激心意。 「你还活着。 这就足以庆祝了。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173102&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'68cbf892-3adb-4971-8d82-2915e62a0468\', \'multiverseId\': 173102}, \'multiverseid\': 173102}]', '[{\'name\': \'Müllhaufenpuppe\', \'text\': \'Opfere die Müllhaufenpuppe: Entferne eine Karte deiner Wahl in einem Friedhof ganz aus dem Spiel.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'„Ich weiß, dass sie eines Nachts nicht mehr zurückkommen wird. Aber das heißt dann auch, dass sie ihre Aufgabe erfüllt hat." —Braenna, Flickschmiedin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174730&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'210c0b89-79c4-4798-b77d-0105aa51013d\', \'multiverseId\': 174730}, \'multiverseid\': 174730}, {\'name\': \'Muñeca de paja\', \'text\': \'Sacrificar la Muñeca de paja: Remueve del juego la carta objetivo de un cementerio.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'"Sé que una noche no volverá. Entonces sabré que realmente hizo su trabajo." —Braenna, artesana remendona\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172924&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d907e3c7-a766-4313-8f97-e00e01787c53\', \'multiverseId\': 172924}, \'multiverseid\': 172924}, {\'name\': \'Poupée de ferraille\', \'text\': "Sacrifiez la Poupée de ferraille : Retirez de la partie la carte ciblée d\'un cimetière.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "« Je sais qu\'une nuit, elle ne reviendra pas. Cela voudra dire qu\'elle aura accompli sa tâche. » —Braenna, ravaudeuse", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173526&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0ff6fa63-09d8-48e3-85a3-49084c81a643\', \'multiverseId\': 173526}, \'multiverseid\': 173526}, {\'name\': \'Cumulo di Bambole\', \'text\': \'Sacrifica il Cumulo di Bambole: Rimuovi dal gioco una carta bersaglio da un cimitero.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': \'"So che una di queste notti non tornerà. Allora saprò che ha portato a termine il suo lavoro." —Braenna, rattoppatrice\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173827&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'14a1d01c-7151-4763-b5e8-69f2a0b2b9c2\', \'multiverseId\': 173827}, \'multiverseid\': 173827}, {\'name\': \'屑山の人形\', \'text\': \'屑山の人形を生け贄に捧げる：いずれかの墓地にあるカード１枚を対象とし、それをゲームから取り除く。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'「どこかの晩で、戻ってこなくなるんだろうね。 そしたら、そいつの仕事は本当に終わったって事さ。」 ――纏め鍛治のブラエナ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174128&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3837c8d4-dcd7-4607-bc08-bb7a794f74ea\', \'multiverseId\': 174128}, \'multiverseid\': 174128}, {\'name\': \'Boneco Cata-Lixo\', \'text\': \'Sacrifique Boneco Cata-Lixo: Remova de jogo o card alvo que esteja num cemitério.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'"Eu sei que uma noite ele não voltará. Então saberei que ele realmente cumpriu sua tarefa." — Braenna, espantalheira\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172322&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7d3c6603-4827-4c09-99c4-04bc1b0bf031\', \'multiverseId\': 172322}, \'multiverseid\': 172322}, {\'name\': \'Кукла Мусорных Куч\', \'text\': \'Пожертвуйте Куклу Мусорных Куч: удалите из игры находящуюся на кладбище целевую карту.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'«Я знаю, в одну прекрасную ночь она не вернется. Тогда-то я и буду уверена, что она сослужила мне хорошую службу». — Браенна, мастерица пугал\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172623&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46d9d71e-8b9a-4a0f-b870-01054edd557d\', \'multiverseId\': 172623}, \'multiverseid\': 172623}, {\'name\': \'堆积人偶\', \'text\': \'牺牲堆积人偶：将目标牌从坟墓场移出对战。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'「我知道它有天晚上不会回来。 然后我就会晓得它的工作完成了。」 ～工匠布列娜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173225&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cbe75a26-1799-4621-812d-7f06fe16d494\', \'multiverseId\': 173225}, \'multiverseid\': 173225}]', '[{\'name\': \'Mürrisches Abbild\', \'text\': \'{4}, {T}: Lege eine -1/-1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'„Stücke von zusammengebrochenen Vogelscheuchen, Bänder aus Elfenhautleder, Zähne von einem Merrow-Axtkämpfer — wer fleißig ist, kann für alles noch eine Verwendung finden." —Mowagh der Gwyll\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174728&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'097092dd-1ce3-4918-90df-7aefc19a57d0\', \'multiverseId\': 174728}, \'multiverseid\': 174728}, {\'name\': \'Efigie retorcida\', \'text\': \'{4}, {T}: Pon un contador -1/-1 sobre la criatura objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'"Pedazos de espantapájaros, cintas de cuero élfico, dientes de un merrow escuálido hacha . . . Un alma laboriosa puede encontrar nuevos usos para las cosas más mundanas." —Mowagh la Gwyllion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172922&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'29a35430-f0e2-4426-a7b3-16b6ff48580b\', \'multiverseId\': 172922}, \'multiverseid\': 172922}, {\'name\': \'Effigie noueuse\', \'text\': \'{4}, {T} : Mettez un marqueur -1/-1 sur la créature ciblée.\', \'type\': \'Artefact\', \'flavor\': "« Des bouts d\'épouvantail, des lacets de cuir d\'elfe, les dents d\'un fauchesquale suire... Un esprit imaginatif peut trouver de nouvelles utilisations pour les objets les plus banals. » —Mowagh des Gwyllion", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173524&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'32904099-6c5e-4d80-9535-3030ee6e7302\', \'multiverseId\': 173524}, \'multiverseid\': 173524}, {\'name\': \'Effige Nodosa\', \'text\': \'{4}, {T}: Metti un segnalino -1/-1 su una creatura bersaglio.\', \'type\': \'Artefatto\', \'flavor\': \'"Pezzi di spaventapasseri caduti, parti di armature di cuoio elfiche, denti di asciasquali merrow. . . Un\\\'anima laboriosa può trovare un nuovo utilizzo per l\\\'oggetto più quotidiano che esista." —Mowagh la gwyllion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173825&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e0f32d0-c4f2-4a09-a629-2ff0bb69a151\', \'multiverseId\': 173825}, \'multiverseid\': 173825}, {\'name\': \'節くれの彫像\', \'text\': \'{4}, {T}：クリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'アーティファクト\', \'flavor\': \'「壊れたカカシの欠片、エルフの皮の紐、斧鮫メロウの歯……手工の魂があれば、どんなありふれたものにも新たな使い道があるんだ。」 ――グウィリオンのモワフ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174126&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9719b740-4ea7-49d4-8510-8efcccdc52e4\', \'multiverseId\': 174126}, \'multiverseid\': 174126}, {\'name\': \'Efígie Nodosa\', \'text\': \'{4}, {T}: Coloque um marcador -1/-1 na criatura alvo.\', \'type\': \'Artefato\', \'flavor\': \'"Pedaços de um espantalho morto, fitas de couro de elfoderme, dentes de um sirenídeo tubarão-machado . . . Uma alma habilidosa pode encontrar novos usos para as coisas mais comuns." — Mowagh, o Gwyllion\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172320&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3e3e11c2-15db-4f0c-af2b-48eeb0345094\', \'multiverseId\': 172320}, \'multiverseid\': 172320}, {\'name\': \'Корявая Фигурка\', \'text\': \'{4}, {T}: положите один жетон -1/-1 на целевое существо.\', \'type\': \'Артефакт\', \'flavor\': \'«Кусочки развалившегося пугала, тесемочки из эльфийской кожи, зубы хищных мерроу... Прилежная душа всегда найдет новое применение самым обычным вещам». — Гвиллиона Моуэй\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172621&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'49417a76-a2bb-48ce-8bcb-1d1f00bf4d34\', \'multiverseId\': 172621}, \'multiverseid\': 172621}, {\'name\': \'粗制刍像\', \'text\': \'{4}，{T}：在目标生物上放置一个-1/-1指示物。\', \'type\': \'神器\', \'flavor\': \'「稻草人的残骸，地精皮革制成的饰边，美洛斧人鱼的牙齿. . .勤劳的人可以在最平凡的东西中找到新用途。」 ～山妪墨娃\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173223&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'95c01e02-f1db-4e60-8d7e-957ca3621261\', \'multiverseId\': 173223}, \'multiverseid\': 173223}]', '[{\'name\': \'Narbenschuppen-Ritual\', \'text\': \'Lege als zusätzliche Kosten, um das Narbenschuppen-Ritual zu spielen, eine -1/-1-Marke auf eine Kreatur, die du kontrollierst.\\nZiehe zwei Karten.\', \'type\': \'Hexerei\', \'flavor\': \'Manche Worte sind zu wichtig, um sie etwas so flüchtigem wie einer Erinnerung anzuvertrauen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174652&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d4de323e-0e35-4abe-8ae5-ccbde01b3255\', \'multiverseId\': 174652}, \'multiverseid\': 174652}, {\'name\': \'Ritual de escamas cicatrizadas\', \'text\': \'Como coste adicional para jugar el Ritual de escamas cicatrizadas, pon un contador -1/-1 sobre una criatura que controlas.\\nRoba dos cartas.\', \'type\': \'Conjuro\', \'flavor\': \'Algunas palabras son demasiado importantes como para confiarlas a algo tan frágil como la memoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172846&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1efef874-6f4b-4703-9e2d-29f9970a1a97\', \'multiverseId\': 172846}, \'multiverseid\': 172846}, {\'name\': "Rituel de scarification d\'écaille", \'text\': "En tant que coût supplémentaire pour jouer le Rituel de scarification d\'écaille, mettez un marqueur -1/-1 sur une créature que vous contrôlez.\\nPiochez deux cartes.", \'type\': \'Rituel\', \'flavor\': \'Certains mots sont trop importants pour les confier à une chose aussi fragile que la mémoire.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173448&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'365a937d-c522-4508-9074-32428545be02\', \'multiverseId\': 173448}, \'multiverseid\': 173448}, {\'name\': \'Rituale di Cicatrizzazione delle Scaglie\', \'text\': \'Come costo addizionale per giocare il Rituale di Cicatrizzazione delle Scaglie, metti un segnalino -1/-1 su una creatura che controlli.\\nPesca due carte.\', \'type\': \'Stregoneria\', \'flavor\': \'Alcune parole sono troppo importanti per essere affidate a qualcosa di fragile come i ricordi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173749&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cfe34d06-aae7-47d1-bf78-84140d32360b\', \'multiverseId\': 173749}, \'multiverseid\': 173749}, {\'name\': \'傷鱗の儀式\', \'text\': \'傷鱗の儀式をプレイするための追加コストとして、あなたがコントロールするクリーチャー１体の上に－１/－１カウンターを１個置く。\\nカードを２枚引く。\', \'type\': \'ソーサリー\', \'flavor\': \'記憶と同じぐらいおぼろげで、信用できないほど重要な言葉がある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174050&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'432af5e0-6771-46f6-8dad-c348f18e17c3\', \'multiverseId\': 174050}, \'multiverseid\': 174050}, {\'name\': \'Ritual de Escamo-Tatuagem\', \'text\': \'Como custo adicional para jogar Ritual de Escamo-Tatuagem, coloque um marcador -1/-1 numa criatura que você controla.\\nCompre dois cards.\', \'type\': \'Feitiço\', \'flavor\': \'Algumas palavras são importantes demais para confiar a algo tão frágil como a memória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172244&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'02f07111-bccc-4a60-a602-017cb177094c\', \'multiverseId\': 172244}, \'multiverseid\': 172244}, {\'name\': \'Ритуал Рубцевания\', \'text\': \'В качестве дополнительной стоимости разыгрывания Ритуала Рубцевания положите один жетон -1/-1 на существо под вашим контролем.\\nВозьмите две карты.\', \'type\': \'Волшебство\', \'flavor\': \'Некоторые слова слишком важны, чтобы доверять их такой хрупкой вещице, как память.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172545&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'767a9bab-e987-40f3-a839-30ac0859bff1\', \'multiverseId\': 172545}, \'multiverseid\': 172545}, {\'name\': \'疤鳞祭仪\', \'text\': \'在一个由你操控的生物上放置一个-1/-1指示物，以作为使用疤鳞祭仪的额外费用。\\n抓两张牌。\', \'type\': \'法术\', \'flavor\': \'有些字词重要无比，不能仰赖记忆这等脆弱事物。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173147&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'881c37e1-d7ac-4145-aced-de213ce25bee\', \'multiverseId\': 173147}, \'multiverseid\': 173147}]', "[{'name': 'Nebelschleier-Ebene', 'text': '({T}: Erhöhe deinen Manavorrat um {W}.)\\nDie Nebelschleier-Ebene kommt getappt ins Spiel.\\n{W}, {T}: Lege eine Karte deiner Wahl aus deinem Friedhof unter deine Bibliothek. Spiele diese Fähigkeit nur, falls du zwei oder mehr weiße bleibende Karten kontrollierst.', 'type': 'Land — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174752&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9cf2f7fa-d69d-44a9-bb1e-7f390263ae53', 'multiverseId': 174752}, 'multiverseid': 174752}, {'name': 'Llanura velo de niebla', 'text': '({T}: Agrega {W} a tu reserva de maná.)\\nLa Llanura velo de niebla entra en juego girada.\\n{W}, {T}: Pon la carta objetivo de tu cementerio en el fondo de tu biblioteca. Juega esta habilidad sólo si controlas dos o más permanentes blancos.', 'type': 'Tierra — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172946&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '8b6d25ce-4b4a-40c1-ae93-27fa76520640', 'multiverseId': 172946}, 'multiverseid': 172946}, {'name': 'Plaine de Voilebrume', 'text': '({T} : Ajoutez {W} à votre réserve.)\\nLa Plaine de Voilebrume arrive en jeu engagée.\\n{W}, {T} : Mettez la carte ciblée de votre cimetière au-dessous de votre bibliothèque. Ne jouez cette capacité que si vous contrôlez au moins deux permanents blancs.', 'type': 'Terrain : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173548&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3395320b-6a8a-408b-9fa5-dbb237272773', 'multiverseId': 173548}, 'multiverseid': 173548}, {'name': 'Radura della Nebbia Eterna', 'text': '({T}: Aggiungi {W} alla tua riserva di mana.)\\nLa Radura della Nebbia Eterna entra in gioco TAPpata.\\n{W}, {T}: Metti in fondo al tuo grimorio una carta bersaglio dal tuo cimitero. Gioca questa abilità solo se controlli due o più permanenti bianchi.', 'type': 'Terra — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173849&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ca891833-09c3-4901-b131-ffc091682d2f', 'multiverseId': 173849}, 'multiverseid': 173849}, {'name': '霧覆いの平地', 'text': '（{T}：あなたのマナプールに{W}を加える。）\\n霧覆いの平地はタップ状態で場に出る。\\n{W}, {T}：あなたの墓地にあるカード１枚を対象とし、それをあなたのライブラリーの一番下に置く。 この能力は、あなたが２つ以上の白のパーマネントをコントロールしている場合にのみプレイできる。', 'type': '土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174150&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6942f947-ece1-4a2e-8fb5-1f8c87aa5de1', 'multiverseId': 174150}, 'multiverseid': 174150}, {'name': 'Planície do Véu Nebuloso', 'text': '({T}: Adicione {W} à sua reserva de mana.)\\nPlanície do Véu Nebuloso entra em jogo virado.\\n{W}, {T}: Coloque o card alvo de seu cemitério no fundo de seu grimório. Jogue esta habilidade somente se você controlar duas ou mais permanentes brancas.', 'type': 'Terreno — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172344&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ac6bac19-2031-48f1-86ff-8a0ce6b879d4', 'multiverseId': 172344}, 'multiverseid': 172344}, {'name': 'Отуманенная Равнина', 'text': '({T}: добавьте {W} в ваше хранилище маны.)\\nОтуманенная Равнина входит в игру повернутой.\\n{W}, {T}: положите находящуюся на вашем кладбище целевую карту в низ вашей библиотеки. Разыгрывайте эту способность, только если вы контролируете два или более белых перманента.', 'type': 'Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172645&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd8006294-4af5-4d1d-b948-24bf60525ecd', 'multiverseId': 172645}, 'multiverseid': 172645}, {'name': '雾幔平原', 'text': '（{T}：加{W}到你的法术力池中。）\\n雾幔平原须横置进场。\\n{W}，{T}：将目标牌从你的坟墓场置于你的牌库底。 你只可以于你操控两个或更多白色永久物时使用此异能。', 'type': '地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173247&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '808ecc4f-748c-4910-84fd-66c3ccaabf97', 'multiverseId': 173247}, 'multiverseid': 173247}]", '[{\'name\': \'Nebelwiesenhexe\', \'text\': \'{2}{W}{U}: Entferne eine Kreatur deiner Wahl ganz aus dem Spiel. Bringe diese Karte am Ende des Zuges unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Kreatur — Kithkin, Zauberer\', \'flavor\': \'Olka sammelte jahrelang jeden Abend den Nebel und studierte seine Geheimnisse. Sobald sie hinter seine Zusammensetzung gekommen war, konnte sie mit einem Gedanken verschwinden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174621&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c346763a-2406-4e29-b9a2-e12de76e3f66\', \'multiverseId\': 174621}, \'multiverseid\': 174621}, {\'name\': \'Bruja de Pradera Brumosa\', \'text\': \'{2}{W}{U}: Remueve del juego la criatura objetivo. Regresa esa carta al juego bajo el control de su propietario al final del turno.\', \'type\': \'Criatura — Hechicero kithkin\', \'flavor\': \'Olka recogió la niebla del atardecer por años, estudiando sus secretos. Una vez que los dominó, pudo desvanecerse con sólo pensarlo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172815&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d9432b3a-33cc-4c1a-82c5-15276020ffa1\', \'multiverseId\': 172815}, \'multiverseid\': 172815}, {\'name\': \'Envoûteuse de Brumeprairie\', \'text\': \'{2}{W}{U} : Retirez la créature ciblée de la partie. Renvoyez cette carte en jeu sous le contrôle de son propriétaire à la fin du tour.\', \'type\': \'Créature : sangami et sorcier\', \'flavor\': "Olka avait récupéré la brume du soir pendant des années pour étudier ses secrets. Une fois qu\'elle les avait appris, elle pouvait disparaître rien qu\'en y pensant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173417&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a4dae8bd-c6c3-47c9-9fd5-c4cd1ea6218d\', \'multiverseId\': 173417}, \'multiverseid\': 173417}, {\'name\': \'Strega della Prateria Brumosa\', \'text\': \'{2}{W}{U}: Rimuovi dal gioco una creatura bersaglio. Rimetti in gioco quella carta sotto il controllo del suo proprietario alla fine del turno.\', \'type\': \'Creatura — Mago Kithkin\', \'flavor\': \'Olka raccolse la nebbia serale per anni, studiandone i segreti. Una volta appresa la sua essenza, divenne in grado di svanire col solo pensiero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173718&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ed7713dd-3e50-422b-ae4a-3f8d8966158c\', \'multiverseId\': 173718}, \'multiverseid\': 173718}, {\'name\': \'ミストメドウの魔女\', \'text\': \'{2}{W}{U}：クリーチャー１体を対象とし、それをゲームから取り除く。 ターン終了時に、そのカードをオーナーのコントロール下で場に戻す。\', \'type\': \'クリーチャー — キスキン・ウィザード\', \'flavor\': \'オルカは何年にも渡り夜の霧を集めては、その秘密を研究している。 彼女がその核心を学んだなら、彼女は思っただけで消えることができるだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174019&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'68ffe791-e7bb-4de1-b132-5ae05aa2d488\', \'multiverseId\': 174019}, \'multiverseid\': 174019}, {\'name\': \'Bruxa de Nevoplanície\', \'text\': \'{2}{W}{U}: Remova a criatura alvo do jogo. Devolva aquele card ao jogo sob o controle de seu dono no final do turno.\', \'type\': \'Criatura — Kithkin Mago\', \'flavor\': \'Olka coletou a bruma da noite por anos, estudando seus segredos. Quando conheceu sua essência, pode desaparecer com um pensamento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172213&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7441e717-580e-4120-b940-c6a364dfa395\', \'multiverseId\': 172213}, \'multiverseid\': 172213}, {\'name\': \'Ведьма из Туманолужья\', \'text\': \'{2}{W}{U}: удалите целевое существо из игры. В конце хода верните ту карту в игру под контролем ее владельца.\', \'type\': \'Существо — Кискен Чародей\', \'flavor\': \'Олка собирала вечерний туман годами, изучая его тайные свойства. Когда ведьма постигла его суть, она научилась исчезать одним лишь усилием мысли.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172514&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce75d120-49ae-43da-9fe5-5de8c705f93a\', \'multiverseId\': 172514}, \'multiverseid\': 172514}, {\'name\': \'雾牧地法术师\', \'text\': \'{2}{W}{U}：将目标生物移出对战。 在回合结束时，将该牌在其拥有者的操控下移回场上。\', \'type\': \'生物～洁英／法术师\', \'flavor\': \'欧卡收集暮雾数年，好研究其间秘密。 而当她通晓精华后，即可在转念间消失身形。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173116&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'01efc3e5-5232-4bd2-9819-b21aa60ba7c6\', \'multiverseId\': 173116}, \'multiverseid\': 173116}]', "[{'name': 'Nebelwiesenschleicher', 'text': 'Lebensverknüpfung, Schutz vor umgewandelten Manakosten von 3 oder höher', 'type': 'Kreatur — Kithkin, Räuber', 'flavor': 'Doyo vermutete, dass die Boggarts einen Raubzug auf seine Ernte planten. Daher senste er das Getreide ab, um bessere Sicht zu haben.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174491&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'aeb6bf8b-bbd6-4977-b009-5889415f1af3', 'multiverseId': 174491}, 'multiverseid': 174491}, {'name': 'Furtivo de Pradera Brumosa', 'text': 'Vínculo vital, protección contra coste de maná convertido de 3 o mayor.', 'type': 'Criatura — Bribón kithkin', 'flavor': 'Doyo sospechaba que los boggarts estaban conspirando contra su cosecha, así que segó todo su grano para que nada entorpeciera la visión.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172685&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'e4f1054e-885f-4e92-b3fe-72997a7a83e6', 'multiverseId': 172685}, 'multiverseid': 172685}, {'name': 'Indolent brumeprairie', 'text': 'Lien de vie, protection contre le coût converti de mana 3 ou plus', 'type': 'Créature : sangami et gredin', 'flavor': 'Doyo soupçonnait que les boggarts préparaient un mauvais coup, alors il faucha son blé pour avoir une vision dégagée du champ.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173287&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1cc37ccf-67ce-49ac-85b6-4e4b1550fba6', 'multiverseId': 173287}, 'multiverseid': 173287}, {'name': 'Lavativo della Prateria Brumosa', 'text': 'Legame vitale, protezione da costo di mana convertito pari o superiore a 3.', 'type': 'Creatura — Farabutto Kithkin', 'flavor': 'Doyo sospettava che i boggart stessero tramando qualche complotto contro il suo raccolto, quindi falciò il grano per liberare la visuale.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173588&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '31735f47-b927-4375-b815-047edda828a8', 'multiverseId': 173588}, 'multiverseid': 173588}, {'name': 'ミストメドウの身隠し', 'text': '絆魂、プロテクション（点数で見たマナ・コストが３以上）', 'type': 'クリーチャー — キスキン・ならず者', 'flavor': '自分の農作物に悪巧みを働くボガートがいると信じたドーヨーは、見通しを良くするために畑を全部刈り取った。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173889&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '685f0b63-3627-4065-aee9-daa28b771284', 'multiverseId': 173889}, 'multiverseid': 173889}, {'name': 'Camuflador de Nevoplanície', 'text': 'Vínculo com a vida, proteção contra custo de mana convertido maior ou igual a 3.', 'type': 'Criatura — Kithkin Ladino', 'flavor': 'Doyo suspeitava que os papões planejavam um ataque à sua plantação, portanto ceifou sua seara para visualizar o horizonte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172083&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '7d5bfca4-165a-4189-9b13-c8fce3d5efda', 'multiverseId': 172083}, 'multiverseid': 172083}, {'name': 'Скрытник из Туманолужья', 'text': 'Цепь жизни, Защита от конвертированной мана-стоимости 3 или больше', 'type': 'Существо — Кискен Бродяга', 'flavor': 'Когда Дойо заподозрил, что боггарты замышляют недоброе против его посевов, он скосил хлеба, чтобы улучшить обзор.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172384&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '58e05910-015b-4d50-af3c-422365e14e63', 'multiverseId': 172384}, 'multiverseid': 172384}, {'name': '雾牧地潜伏客', 'text': '系命，保护（总法术力大于或等于3）', 'type': '生物～洁英／浪客', 'flavor': '多佑怀疑波尬正打他的谷物主意，于是把谷子全刈平好让视野畅通。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172986&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f17fa561-651c-43eb-a754-47b3bbef01da', 'multiverseId': 172986}, 'multiverseid': 172986}]", '[{\'name\': \'Nektarorakel\', \'text\': \'{X}, {T}: Du erhältst X Lebenspunkte dazu.\', \'type\': \'Kreatur — Elf, Kleriker\', \'flavor\': \'Wo Elfen einen Quell der Schönheit finden, beschützen sie ihn auch. Wo Schönheit ist, gibt es auch Hoffnung.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174710&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9ab09065-bebc-4a91-ba2a-be5d79a01b54\', \'multiverseId\': 174710}, \'multiverseid\': 174710}, {\'name\': \'Oráculo de néctares\', \'text\': \'{X}, {T}: Ganas X vidas.\', \'type\': \'Criatura — Clérigo elfo\', \'flavor\': \'Cuando los elfos encuentran una fuente de belleza, la protegen. Donde hay belleza, hay esperanza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172904&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8fb7a02f-5756-4a90-9687-b241a499a162\', \'multiverseId\': 172904}, \'multiverseid\': 172904}, {\'name\': \'Oracle des nectars\', \'text\': \'{X}, {T} : Vous gagnez X points de vie.\', \'type\': \'Créature : elfe et clerc\', \'flavor\': \'Quand les elfes trouvent une source de beauté, ils la protègent. Là où il y a beauté, il y a espoir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173506&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'29c7e566-c72f-4bad-89b2-aeded0b1012a\', \'multiverseId\': 173506}, \'multiverseid\': 173506}, {\'name\': \'Oracolo dei Nettari\', \'text\': \'{X}, {T}: Guadagni X punti vita.\', \'type\': \'Creatura — Chierico Elfo\', \'flavor\': "Quando gli elfi trovano una sorgente di bellezza, la proteggono. Dove c\'è bellezza, c\'è speranza.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173807&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d64a68d0-1084-4787-a839-b78e9658fd09\', \'multiverseId\': 173807}, \'multiverseid\': 173807}, {\'name\': \'聖蜜の巫女\', \'text\': \'{X}, {T}：あなたはＸ点のライフを得る。\', \'type\': \'クリーチャー — エルフ・クレリック\', \'flavor\': \'エルフは美の源を見つけたなら、そこを守る。 美のあるところ、希望があるからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174108&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'260d5b7d-7774-46c6-90cc-7479a56e4e06\', \'multiverseId\': 174108}, \'multiverseid\': 174108}, {\'name\': \'Oráculo dos Néctares\', \'text\': \'{X}, {T}: Você ganha X pontos de vida.\', \'type\': \'Criatura — Elfo Clérigo\', \'flavor\': \'Quando os elfos encontram uma fonte de beleza, eles a protegem. Onde há beleza, há esperança.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172302&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79c2f50d-0f90-4ff2-bb62-e85261e28ea5\', \'multiverseId\': 172302}, \'multiverseid\': 172302}, {\'name\': \'Оракул Нектаров\', \'text\': \'{X}, {T}: вы получаете X жизней.\', \'type\': \'Существо — Эльф Священник\', \'flavor\': \'Когда эльфы находят источник красоты, они его защищают. Где есть красота, там есть надежда.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172603&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'804da01e-cdcd-4da8-8dcd-85eef3f061a4\', \'multiverseId\': 172603}, \'multiverseid\': 172603}, {\'name\': \'琼浆先知\', \'text\': \'{X}，{T}：你获得X点生命。\', \'type\': \'生物～地精／僧侣\', \'flavor\': \'当地精找到美丽的根源，必加以保护。 只要有美丽，就会有希望。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173205&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e1165225-4cab-4caf-aa21-0f7a8835b7f5\', \'multiverseId\': 173205}, \'multiverseid\': 173205}]', '[{\'name\': \'Neu stricken\', \'text\': \'Regeneriere eine bleibende Karte deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Eine Axt kann an einer Schärpe zerbrechen, wenn der Wille der Schärpe stärker ist." —Awylla, elfische Sichermacherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174713&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e4457686-5aed-406d-a5d1-becdcbd0ab7c\', \'multiverseId\': 174713}, \'multiverseid\': 174713}, {\'name\': \'Resoldar\', \'text\': \'Regenera el permanente objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Un hacha podría quebrarse sobre una cinta si la voluntad de la cinta fuera la más fuerte." —Awylla, refugiante élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172907&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'973e3cdc-3e40-4135-9b57-aac59452a5e2\', \'multiverseId\': 172907}, \'multiverseid\': 172907}, {\'name\': \'Ressouder\', \'text\': \'Régénérez le permanent ciblé.\', \'type\': \'Éphémère\', \'flavor\': \'« Une hache se brisera sur un ruban si la volonté du ruban est la plus forte. » —Awylla, protecturge elfe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173509&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'91cd7060-9bbc-45bf-88ee-f1f392b37d64\', \'multiverseId\': 173509}, \'multiverseid\': 173509}, {\'name\': \'Risaldare\', \'text\': \'Rigenera un permanente bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Un\\\'ascia può anche rompersi su un nastro, se la volontà del nastro è più forte." —Awylla, salvaincanti elfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173810&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2ca175d-b51a-41b1-9eff-db36d450fbd9\', \'multiverseId\': 173810}, \'multiverseid\': 173810}, {\'name\': \'編み上げ直し\', \'text\': \'パーマネント１つを対象とし、それを再生する。\', \'type\': \'インスタント\', \'flavor\': \'「飾り帯の意が強ければ、斧とて飾り帯に砕けることもあろう。」 ――エルフの守美者、アウィラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174111&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6adf94d1-a861-4b8d-924c-40b6a0c84278\', \'multiverseId\': 174111}, \'multiverseid\': 174111}, {\'name\': \'Retramar\', \'text\': \'Regenere a permanente alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Um machado pode se rachar diante de uma fita, se a força de vontade da fita for mais forte." — Awylla, pulcro-protetora élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172305&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'264d0677-fbdf-4b85-a872-90c57fe3c6dc\', \'multiverseId\': 172305}, \'multiverseid\': 172305}, {\'name\': \'Сплести Заново\', \'text\': \'Регенерируйте целевой перманент.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Топор может сломаться о тесьму, если воля тесьмы сильнее». — Авилла, эльфийская охранительница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172606&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'33fff8bc-3eb0-4c91-b255-49eedc863259\', \'multiverseId\': 172606}, \'multiverseid\': 172606}, {\'name\': \'重织\', \'text\': \'重生目标永久物。\', \'type\': \'瞬间\', \'flavor\': \'「如果缎带的意志强过劈下的斧头，断裂的该会是斧头。」 ～地精美境卫艾薇拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173208&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'231b22ad-1c5e-453c-b3bb-d2916b714120\', \'multiverseId\': 173208}, \'multiverseid\': 173208}]', '[{\'name\': \'Oberster Holzeinschläger\', \'text\': \'Verursacht Trampelschaden\\nWenn der Oberste Holzeinschläger ins Spiel kommt, zerstöre eine bleibende Karte deiner Wahl, die keine Kreatur ist.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Baumhirte, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174612&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'334d4890-d570-4688-a986-7b08a1944c6a\', \'multiverseId\': 174612}, \'multiverseid\': 174612}, {\'name\': \'Primus pudremadera\', \'text\': \'Arrolla.\\nCuando Primus pudremadera entre en juego, destruye el permanente objetivo que no sea criatura.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Chamán pueblo-arbóreo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172806&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'80a4db11-9c3d-45c0-983a-84439c18c535\', \'multiverseId\': 172806}, \'multiverseid\': 172806}, {\'name\': \'Primus chutebois\', \'text\': "Piétinement\\nQuand le Primus chutebois arrive en jeu, détruisez le permanent non-créature ciblé.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : sylvin et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173408&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba771259-1ba0-4be9-b7da-6eaa9113f28f\', \'multiverseId\': 173408}, \'multiverseid\': 173408}, {\'name\': \'Primus della Foresta Caduta\', \'text\': \'Travolgere\\nQuando il Primus della Foresta Caduta entra in gioco, distruggi un permanente non creatura bersaglio.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Sciamano Silvantropo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173709&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cd748229-7497-43bc-b443-e3271fe60049\', \'multiverseId\': 173709}, \'multiverseid\': 173709}, {\'name\': \'森滅ぼしの最長老\', \'text\': \'トランプル\\n森滅ぼしの最長老が場に出たとき、クリーチャーでないパーマネント１つを対象とし、それを破壊する。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — ツリーフォーク・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174010&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'01306043-c0c0-4981-a803-a9f57113476b\', \'multiverseId\': 174010}, \'multiverseid\': 174010}, {\'name\': \'Primaz Desmatador\', \'text\': \'Atropelar\\nQuando Primaz Desmatador entrar em jogo, destrua a permanente alvo que não seja criatura.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Ent Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172204&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'89714c49-04dd-4a56-b325-b05565274eb0\', \'multiverseId\': 172204}, \'multiverseid\': 172204}, {\'name\': \'Губитель Лесов\', \'text\': \'Пробивной удар\\nКогда Губитель Лесов входит в игру, уничтожьте целевой перманент, не являющийся существом.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Лесовик Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172505&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'213ebc2e-4c8a-422b-99d0-9fb64a7ad69d\', \'multiverseId\': 172505}, \'multiverseid\': 172505}, {\'name\': \'摧木督长\', \'text\': \'践踏\\n当摧木督长进场时，消灭目标非生物的永久物。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～树妖／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173107&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d00084e-23a1-422c-8a75-183d30e9db80\', \'multiverseId\': 173107}, \'multiverseid\': 173107}]', '[{\'name\': \'Oona, Königin der Feen\', \'text\': \'Fliegend\\n{X}{U/B}: Bestimme eine Farbe. Ein Gegner deiner Wahl entfernt die obersten X Karten seiner Bibliothek ganz aus dem Spiel. Bringe für jede Karte der bestimmten Farbe, die auf diese Weise ganz aus dem Spiel entfernt wurde, einen 1/1 blauen und schwarzen (Feenwesen, Räuber)-Kreaturenspielstein mit Flugfähigkeit ins Spiel.\', \'type\': \'Legendäre Kreatur — Feenwesen, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174649&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e4c3609-8659-42a2-a8cc-141269e2a5b3\', \'multiverseId\': 174649}, \'multiverseid\': 174649}, {\'name\': \'Oona, reina de las hadas\', \'text\': \'Vuela.\\n{X}{U/B}: Elige un color. El oponente objetivo remueve del juego las primeras X cartas de su biblioteca. Por cada carta del color elegido removida de esta manera pon en juego una ficha de criatura Bribón Hada azul y negra 1/1 con la habilidad de volar.\', \'type\': \'Criatura legendaria — Hechicero hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172843&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7f90d3e8-935e-45c8-85a6-b6a3218ae7eb\', \'multiverseId\': 172843}, \'multiverseid\': 172843}, {\'name\': \'Oona, reine des faeries\', \'text\': "Vol\\n{X}{U/B} : Choisissez une couleur. L\'adversaire ciblé retire de la partie X cartes du dessus de sa bibliothèque. Pour chaque carte de la couleur choisie retirée de cette manière, mettez en jeu un jeton de créature 1/1 bleue et noire Peuple fée et Gredin avec le vol.", \'type\': \'Créature légendaire : peuple fée et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173445&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c81eb1f9-f0fb-4423-88b5-4ef7acd0295d\', \'multiverseId\': 173445}, \'multiverseid\': 173445}, {\'name\': \'Oona, Regina degli Spiritelli\', \'text\': \'Volare\\n{X}{U/B}: Scegli un colore. Un avversario bersaglio rimuove dal gioco le prime X carte del suo grimorio. Per ogni carta del colore scelto rimossa in questo modo, metti in gioco una pedina creatura Farabutto Spiritello 1/1 blu e nera con volare.\', \'type\': \'Creatura Leggendaria — Mago Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173746&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1cb4b5c-30ad-4d6c-bac0-c2dc3203b1ad\', \'multiverseId\': 173746}, \'multiverseid\': 173746}, {\'name\': \'妖精の女王、ウーナ\', \'text\': \'飛行\\n{X}{U/B}：対戦相手１人を対象とする。色を１色選ぶ。 そのプレイヤーは自分のライブラリーの一番上からＸ枚のカードをゲームから取り除く。 これにより取り除かれた選ばれた色のカード１枚につき、飛行を持つ青であり黒である１/１のフェアリー・ならず者・クリーチャー・トークンを１体場に出す。\', \'type\': \'伝説のクリーチャー — フェアリー・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174047&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'241cd9ed-da3a-42b3-a128-a603a357e062\', \'multiverseId\': 174047}, \'multiverseid\': 174047}, {\'name\': \'Oona, Rainha das Fadinas\', \'text\': \'Voar\\n{X}{U/B}: Escolha uma cor. O oponente alvo remove do jogo os X cards do topo de seu grimório. Para cada card da cor escolhida removido desse modo, coloque em jogo uma ficha de criatura azul e preta 1/1 do tipo Fada Ladino com voar.\', \'type\': \'Criatura Lendária — Fada Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172241&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dc5ab8bc-bb53-4f86-927a-d4f58bc9fde5\', \'multiverseId\': 172241}, \'multiverseid\': 172241}, {\'name\': \'Уна, Королева Фей\', \'text\': \'Полет\\n{X}{U/B}: выберите цвет. Целевой оппонент удаляет из игры Х верхних карт своей библиотеки. За каждую удаленную таким образом карту выбранного цвета положите в игру одну фишку существа 1/1 синяя и черная Фея Бродяга с Полетом.\', \'type\': \'Легендарное Существо — Фея Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172542&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ad23b503-2865-4759-9d6c-a8a0bc38330c\', \'multiverseId\': 172542}, \'multiverseid\': 172542}, {\'name\': \'仙儿女王欧娜\', \'text\': \'飞行\\n{X}{U/B}：选择一种颜色。 目标对手将其牌库顶的X张牌移出对战。 每以此法将一张该颜色的牌移出对战，便将一个1/1，蓝黑双色，且具飞行异能的仙灵／浪客衍生物放置进场。\', \'type\': \'传奇生物～仙灵／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173144&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1e75c92c-21e1-4402-9cf8-5e212d0736fa\', \'multiverseId\': 173144}, \'multiverseid\': 173144}]', '[{\'name\': \'Oonas Torhüter\', \'text\': \'Fliegend, Verteidiger\\nVerdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\', \'type\': \'Kreatur — Feenwesen, Soldat\', \'flavor\': \'„Nun hast du also die Elendraschlucht gesehen. Schau dich gut um. Es wird das letzte sein, was du je in deinem Leben siehst."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174650&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'56e50901-abea-4fd9-89db-75106043e545\', \'multiverseId\': 174650}, \'multiverseid\': 174650}, {\'name\': \'Portera de Oona\', \'text\': \'Vuela, defensor.\\nDebilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\', \'type\': \'Criatura — Soldado hada\', \'flavor\': \'"Has visto el Valle Elendra. Míralo bien. Será lo último que verás."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172844&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'279b1301-6654-4d8c-a221-ccabd0b7239f\', \'multiverseId\': 172844}, \'multiverseid\': 172844}, {\'name\': "Gardienne des portes d\'Oona", \'text\': \'Vol, défenseur\\nFlétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\', \'type\': \'Créature : peuple fée et soldat\', \'flavor\': "« Alors, vous avez vu le Vallon d\'Elendra. Profitez-en bien. Ce sera la dernière chose que vous verrez. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173446&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5d7f833c-9dce-4c28-8cc1-f0958c780a76\', \'multiverseId\': 173446}, \'multiverseid\': 173446}, {\'name\': \'Guardia del Cancello di Oona\', \'text\': \'Volare, difensore\\nAvvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\', \'type\': \'Creatura — Soldato Spiritello\', \'flavor\': \'"Così ora hai visto Gola Elendra. Guardala bene. Sarà l\\\'ultima cosa che riuscirai a vedere."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173747&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0e74accc-1755-48c4-b2c5-7cb75f0f68c4\', \'multiverseId\': 173747}, \'multiverseid\': 173747}, {\'name\': \'ウーナの門の管理人\', \'text\': \'飛行、防衛\\n萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\', \'type\': \'クリーチャー — フェアリー・兵士\', \'flavor\': \'「エレンドラ谷を見たんだね。 ちゃんと見ておくんだよ。 最後に見たものになるんだから。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174048&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e147b3a7-0f84-4188-8a6e-951a05c10c3e\', \'multiverseId\': 174048}, \'multiverseid\': 174048}, {\'name\': \'Guardião dos Portões de Oona\', \'text\': \'Voar, defensor\\nMurchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\', \'type\': \'Criatura — Fada Soldado\', \'flavor\': \'"Agora que você viu Glen Elendra, dê uma boa olhada. Será a última coisa que verá."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172242&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6d5fdc1d-cc96-4752-bb5a-6b2c12d97a59\', \'multiverseId\': 172242}, \'multiverseid\': 172242}, {\'name\': \'Привратница Уны\', \'text\': \'Полет, Защитник\\nУвядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\', \'type\': \'Существо — Фея Солдат\', \'flavor\': \'«Вот вы и увидели Глен-Элендру. Хорошенько посмотрите вокруг. Это последнее, что вы когда-либо увидите».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172543&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'df3ff2ae-3dbb-47e4-ad98-21a8edd2efd8\', \'multiverseId\': 172543}, \'multiverseid\': 172543}, {\'name\': \'欧娜的门卫\', \'text\': \'飞行，守军\\n干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\', \'type\': \'生物～仙灵／士兵\', \'flavor\': \'「既然你看到艾蓝卓幽谷了， 就好好地看吧。 这会是你这辈子最后看到的东西。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173145&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'66f5c683-20dc-46b4-84be-089b42520c26\', \'multiverseId\': 173145}, \'multiverseid\': 173145}]', '[{\'name\': \'Orden des Weißlehms\', \'text\': \'{1}{W}{W}, {Q}: Bringe eine Kreaturenkarte deiner Wahl mit umgewandelten Manakosten von 3 oder weniger aus deinem Friedhof ins Spiel zurück. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Kithkin, Kleriker\', \'flavor\': \'Die Gesichtsbemalung der Priester wird aus dem Lehm der Grabhügel gefertigt und ist ein Zeichen des Respekts gegenüber denen, deren Ruhe sie stören.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174493&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5f4b7653-def8-4f6b-ae2a-a9e92826b6b5\', \'multiverseId\': 174493}, \'multiverseid\': 174493}, {\'name\': \'Orden del Barro Blanco\', \'text\': \'{1}{W}{W}, {Q}: Regresa la carta de criatura objetivo con coste de maná convertido de 3 o menos de tu cementerio al juego. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Clérigo kithkin\', \'flavor\': \'Hecha con el barro de las tumbas, la pintura facial de los sacerdotes es un signo de su respeto por aquellos cuyo descanso interrumpen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172687&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c4bea01-55d9-4af1-bde7-ccf7b0414470\', \'multiverseId\': 172687}, \'multiverseid\': 172687}, {\'name\': \'Ordre de Blanchargile\', \'text\': \'{1}{W}{W}, {Q} : Renvoyez en jeu depuis votre cimetière une carte de créature ciblée dont le coût converti de mana est inférieur ou égal à 3. ({Q} est le symbole de dégagement.)\', \'type\': \'Créature : sangami et clerc\', \'flavor\': "Les prêtres utilisent l\'argile des tertres funéraires pour leur peinture faciale en signe de respect pour ceux dont ils interrompent le repos.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173289&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ca2ec374-7c8b-407a-83c2-3ae5fcd44d18\', \'multiverseId\': 173289}, \'multiverseid\': 173289}, {\'name\': \'Ordine di Biancargilla\', \'text\': \'{1}{W}{W}, {Q}: Rimetti in gioco una carta creatura bersaglio con costo di mana convertito pari o inferiore a 3 dal tuo cimitero. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Chierico Kithkin\', \'flavor\': "Tracciati con l\'argilla dei tumuli sepolcrali, i colori sui visi dei sacerdoti sono un segno di rispetto per quelli di cui hanno interrotto il riposo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173590&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4e1730f2-9521-4555-966d-fe28867def53\', \'multiverseId\': 173590}, \'multiverseid\': 173590}, {\'name\': \'白粘土の教団\', \'text\': \'{1}{W}{W}, {Q}：あなたの墓地にある点数で見たマナ・コストが３以下のクリーチャー・カード１枚を対象とし、それを場に戻す。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — キスキン・クレリック\', \'flavor\': \'埋葬塚の土から作られた僧侶の顔の文様は、安らかな眠りを破られた者に対する彼らの敬意の印である。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173891&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f71d1b01-6b64-4bb4-8c20-6b22fd1bab0a\', \'multiverseId\': 173891}, \'multiverseid\': 173891}, {\'name\': \'Ordem da Argila Branca\', \'text\': \'{1}{W}{W}, {Q}:Devolva o card de criatura alvo com custo de mana convertido menor ou igual a 3 de seu cemitério para o jogo. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Kithkin Clérigo\', \'flavor\': \'Feita com a lama de sepulturas, a pintura facial dos sacerdotes é um sinal de seu respeito por aqueles cujo descanso eles interrompem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172085&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3ec81acf-239a-4015-aab7-72854b08588b\', \'multiverseId\': 172085}, \'multiverseid\': 172085}, {\'name\': \'Орден Белой Глины\', \'text\': \'{1}{W}{W}, {Q}: верните целевую карту существа с конвертированной мана-стоимостью 3 или меньше из вашего кладбища в игру. ({Q} символ разворота карты.)\', \'type\': \'Существо — Кискен Священник\', \'flavor\': \'Приготовленная из глины могильных холмов, краска на лицах жрецов это знак их уважения к тем, чей покой они нарушают.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172386&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d100abc5-9f29-4bb8-a34c-2c3093bae76a\', \'multiverseId\': 172386}, \'multiverseid\': 172386}, {\'name\': \'白土教士團\', \'text\': \'{1}{W}{W}，{Q}：将目标总法术力费用等于或小于3的生物牌从你的坟墓场移回场上。 （{Q}是重置符号。）\', \'type\': \'生物～洁英／僧侣\', \'flavor\': \'教士脸上粉彩取自墓冢白土，以对受其惊扰的逝者表示尊重。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172988&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'4b94338f-30dd-44c6-80a0-61de9dce803a\', \'multiverseId\': 172988}, \'multiverseid\': 172988}]', '[{\'name\': \'Pflege-Novizin\', \'text\': \'Immer wenn ein Spieler einen grünen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, erhält eine Kreatur deiner Wahl +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Nur die Elfen bewahren die letzten Reste an Schönheit. Es ist sonst niemand übrig geblieben, der sich dafür interessiert.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174601&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'741ee6c6-0742-4f20-b080-1f30c61c78df\', \'multiverseId\': 174601}, \'multiverseid\': 174601}, {\'name\': \'Iniciada nutriente\', \'text\': \'Siempre que un jugador juegue un hechizo verde, puedes pagar {1}. Si lo haces, la criatura objetivo obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Sólo los elfos preservan los restos de belleza. A nadie más le importa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172795&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0bdb131a-7fde-4523-991b-f11b93ac1747\', \'multiverseId\': 172795}, \'multiverseid\': 172795}, {\'name\': \'Adepte nourricière\', \'text\': "À chaque fois qu\'un joueur joue un sort vert, vous pouvez payer {1}. Si vous faites ainsi, la créature ciblée gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et shamane\', \'flavor\': "Les elfes sont les seuls à préserver le peu qui reste de la beauté, car personne d\'autre ne s\'y intéresse.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173397&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fb3b9d40-d085-4b47-a11b-3f82e2f033bc\', \'multiverseId\': 173397}, \'multiverseid\': 173397}, {\'name\': \'Iniziata Conservatrice\', \'text\': \'Ogniqualvolta un giocatore gioca una magia verde, puoi pagare {1}. Se lo fai, una creatura bersaglio prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'Solo gli elfi conservano i pochi frammenti di bellezza rimasti. A nessun altro interessa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173698&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b4a9d1e1-2762-43e6-95fb-53f8f88039df\', \'multiverseId\': 173698}, \'multiverseid\': 173698}, {\'name\': \'養育者の信徒\', \'text\': \'いずれかのプレイヤーが緑の呪文をプレイするたび、クリーチャー１体を対象とする。あなたは{1}を支払ってもよい。 そうした場合、そのクリーチャーはターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'そのエルフは、わずかな美の欠片を一人守り続けている。 他の誰もがそれを気に留めないからだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173999&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6bac2e74-58be-4c35-8b6a-0464216955db\', \'multiverseId\': 173999}, \'multiverseid\': 173999}, {\'name\': \'Iniciado Nutridor\', \'text\': \'Toda vez que um jogador joga uma mágica verde, você pode pagar {1}. Se você fizer isso, a criatura alvo receberá +1/+1 até o final do turno.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'Somente os elfos preservam os poucos fragmentos de beleza que restam. Ninguém mais se importa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172193&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'daafaa60-ed28-4e9d-b311-da63ec694ab3\', \'multiverseId\': 172193}, \'multiverseid\': 172193}, {\'name\': \'Искусная Кормилица\', \'text\': \'Каждый раз, когда игрок разыгрывает зеленое заклинание, вы можете заплатить {1}. Если вы это делаете, целевое существо получает +1/+1 до конца хода.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Одни только эльфы хранят оставшиеся крупицы прекрасного. Никому больше нет до них никакого дела.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172494&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52ce62dd-cce3-438b-9a11-6302a50cc79b\', \'multiverseId\': 172494}, \'multiverseid\': 172494}, {\'name\': \'滋养学徒\', \'text\': \'每当任一牌手使用绿色咒语时，你可以支付{1}。 若你如此作，则目标生物得+1/+1直到回合结束。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'地精独力保存少数仅剩的美物片段。 他族对此都不感兴趣。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173096&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8bb11fd7-4e1a-4776-b8f6-8d950a1598b8\', \'multiverseId\': 173096}, \'multiverseid\': 173096}]', '[{\'name\': \'Pili-Pala\', \'text\': \'Fliegend\\n{2}, {Q}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe. ({Q} ist das Enttappsymbol.)\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Niemand hatte erwartet, dass sie fliegen würde. Allerdings hatte auch niemand gedacht, dass sie sich überhaupt bewegen könnte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174735&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'540ed66b-4bed-4b79-a666-0781d077148c\', \'multiverseId\': 174735}, \'multiverseid\': 174735}, {\'name\': \'Pili-Pala\', \'text\': \'Vuela.\\n{2}, {Q}: Agrega un maná de cualquier color a tu reserva de maná. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'No se suponía que volara. Bueno, tampoco se suponía que se moviera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172929&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8d213a19-03c0-491c-85ca-efb1d336f6b8\', \'multiverseId\': 172929}, \'multiverseid\': 172929}, {\'name\': \'Pili-Pala\', \'text\': \'Vol\\n{2}, {Q} : Ajoutez un mana de la couleur de votre choix à votre réserve. ({Q} est le symbole de dégagement.)\', \'type\': \'Créature-artefact : épouvantail\', \'flavor\': "Il n\'était pas vraiment sensé voler. Vous me direz, il n\'était pas sensé bouger non plus.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173531&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d9b5b533-026e-43a4-88b0-5a4bdbedd72c\', \'multiverseId\': 173531}, \'multiverseid\': 173531}, {\'name\': \'Sfarfallante\', \'text\': \'Volare\\n{2}, {Q}: Aggiungi un mana di qualsiasi colore alla tua riserva di mana. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': "Non avrebbe dovuto volare davvero. D\'altro canto, non avrebbe dovuto neanche muoversi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173832&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b648ac82-01e9-45aa-8cc7-3e19d08d5146\', \'multiverseId\': 173832}, \'multiverseid\': 173832}, {\'name\': \'ピリ＝パラ\', \'text\': \'飛行\\n{2}, {Q}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'それは飛ぶとは思われていなかった。 と言うか、そもそも動くとすら思われていなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174133&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'937240fb-1516-4cc1-9dcd-f838af47a025\', \'multiverseId\': 174133}, \'multiverseid\': 174133}, {\'name\': \'Pili-Pala\', \'text\': \'Voar\\n{2}, {Q}: Adicione um mana de qualquer cor à sua reserva de mana. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'Ele não deveria voar. Na verdade, ele também não deveria se mover.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172327&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'62e5a284-8ebc-4af1-b7fd-86957176e157\', \'multiverseId\': 172327}, \'multiverseid\': 172327}, {\'name\': \'Пили-Пала\', \'text\': \'Полет\\n{2}, {Q}: добавьте одну ману любого цвета в ваше хранилище маны. ({Q} символ разворота карты.)\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Никто не ожидал, что оно сможет летать. По правде говоря, оно и двигаться-то не должно было.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172628&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c319d4c8-527c-4ca5-a1a7-7473023dfd03\', \'multiverseId\': 172628}, \'multiverseid\': 172628}, {\'name\': \'劈哩啪拉\', \'text\': \'飞行\\n{2}，{Q}：加一点任意颜色的法术力到你的法术力池中。 （{Q}是重置符号。）\', \'type\': \'神器生物～稻草人\', \'flavor\': \'造出它的人原本并没想到它能飞。 话说回来，原来也并没想到它能动。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173230&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3be611e2-d403-4456-973b-140895288bf3\', \'multiverseId\': 173230}, \'multiverseid\': 173230}]', '[{\'name\': \'Plündernde Schlammringer\', \'text\': \'Die Plündernden Schlammringer können von blauen Kreaturen nicht geblockt werden.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Um zur Schlucht des Wanderessigflusses zu kommen, sollten sie die Abkürzung „durch die Berge" nehmen. Niemand ahnte, dass sie das wörtlich nehmen würden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174690&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2df01621-35a8-49a7-a13e-0589dead723f\', \'multiverseId\': 174690}, \'multiverseid\': 174690}, {\'name\': \'Incursores de Alboroto Fangoso\', \'text\': \'Los Incursores de Alboroto Fangoso no pueden ser bloqueados por criaturas azules.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Para alcanzar la hondonada del Río Lágrimaerrante, les dijeron que tomaran el atajo "por las montañas". Siguieron las instrucciones al pie de la letra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172884&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f7f2c92f-fac6-4519-a98f-e34596ee30dc\', \'multiverseId\': 172884}, \'multiverseid\': 172884}, {\'name\': \'Pillards de Baugehutin\', \'text\': \'Les Pillards de Baugehutin ne peuvent pas être bloqués par les créatures bleues.\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Pour atteindre le ravin de la rivière de Bruinerrance, on leur a dit qu\'ils devraient « traverser les montagnes ». Ils ont suivi ces instructions à la lettre.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173486&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1ab8db4c-2b72-474b-a294-308d413048c7\', \'multiverseId\': 173486}, \'multiverseid\': 173486}, {\'name\': \'Razziatori di Rissaiolo Fangoso\', \'text\': \'I Razziatori di Rissaiolo Fangoso non possono essere bloccati dalle creature blu.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': \'Era stato detto loro che per raggiungere il burrone del Fiume Brina Errante avrebbero dovuto prendere la scorciatoia "attraverso le montagne". Presero quel consiglio alla lettera.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173787&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'acddbb7e-c34e-4453-a71d-bb5f62626e1f\', \'multiverseId\': 173787}, \'multiverseid\': 173787}, {\'name\': \'泥騒ぎの略奪者\', \'text\': \'泥騒ぎの略奪者は青のクリーチャーによってはブロックされない。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'ワンダーブラインの峡谷にたどり着くためには、「山を抜けていく」のが近道だと言われていた。 彼らは文字通りそれに従った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174088&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'dee49690-16f6-4a2b-81c9-6fda834241ef\', \'multiverseId\': 174088}, \'multiverseid\': 174088}, {\'name\': \'Salteadores de Rixalama\', \'text\': \'Salteadores de Rixalama não pode ser bloqueado por criaturas azuis.\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'Para alcançar a ravina do Rio Vinherrante, disseram a eles para tomar o atalho "através das montanhas". Eles seguiram as indicações ao pé da letra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172282&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4bb1d4a7-24d8-47e3-88ea-9af4c9f5545c\', \'multiverseId\': 172282}, \'multiverseid\': 172282}, {\'name\': \'Налетчики из Клана Буянов\', \'text\': \'Налетчики из Клана Буянов не могут быть заблокированы синими существами.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Чтобы добраться до ущелья реки Уондербрайн, им было сказано пойти коротким путем «сквозь горы». Они восприняли совет в буквальном смысле.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172583&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0aa44449-419f-4ce8-b6b3-35f623e11ef8\', \'multiverseId\': 172583}, \'multiverseid\': 172583}, {\'name\': \'泥闹突击队\', \'text\': \'泥闹突击队不能被蓝色生物阻挡。\', \'type\': \'生物～精灵／战士\', \'flavor\': \'有人告诉他们：如果要去漫涩河的河谷，就得走「穿越山脉」的捷径。 而他们就按照字面上的意义作了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173185&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'079e424c-ceec-400e-a2cf-524889b4e834\', \'multiverseId\': 173185}, \'multiverseid\': 173185}]', "[{'name': 'Prismatisches Omen', 'text': 'Länder, die du kontrollierst, haben zusätzlich zu ihren anderen Typen alle Standardlandtypen.', 'type': 'Verzauberung', 'flavor': 'In Zeiten von Omen verändert sich das Land passend zu den Siegeln, die brennend am Himmel erscheinen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174603&type=card', 'language': 'German', 'identifiers': {'scryfallId': '74cda741-acd5-4ae5-88e5-982ad7ff36f0', 'multiverseId': 174603}, 'multiverseid': 174603}, {'name': 'Presagio prismático', 'text': 'Las tierras que controlas son de todos los tipos de tierra básica además de sus otros tipos.', 'type': 'Encantamiento', 'flavor': 'En tiempos de adversidad, la tierra toma su forma de acuerdo a los signos que arden en el cielo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172797&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '794222bd-3f47-48e8-8798-de9aae7c3f3b', 'multiverseId': 172797}, 'multiverseid': 172797}, {'name': 'Augure prismatique', 'text': 'Les terrains que vous contrôlez ont chaque type de terrain de base en plus de leurs autres types de terrain.', 'type': 'Enchantement', 'flavor': 'Dans les temps de présage, la terre se sculpte en fonction des sigles marquant le ciel.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173399&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e25550db-4ecc-47bc-9ad8-4b905f496913', 'multiverseId': 173399}, 'multiverseid': 173399}, {'name': 'Presagio Prismatico', 'text': 'Le terre che controlli hanno tutti i tipi di terra base in aggiunta ai loro altri tipi.', 'type': 'Incantesimo', 'flavor': 'In tempi di prodigi, la terra si scolpisce secondo i sigilli marchiati a fuoco nel cielo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173700&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7261addb-a4e2-4fcf-bc82-2d9eba25d4b5', 'multiverseId': 173700}, 'multiverseid': 173700}, {'name': '虹色の前兆', 'text': 'あなたがコントロールする土地は、それ自身のタイプに加えてすべての基本土地タイプでもある。', 'type': 'エンチャント', 'flavor': '兆しの時、その地は空に炎で刻まれた紋章を自身に刻んだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174001&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1c91678f-8534-4d0a-9e73-b50ad24c6a53', 'multiverseId': 174001}, 'multiverseid': 174001}, {'name': 'Agouro Prismático', 'text': 'Os terrenos que você controla são de todos os tipos de terreno básico além de seus outros tipos.', 'type': 'Encantamento', 'flavor': 'Nos momentos de presságio, a terra se esculpe de acordo com os símbolos que ardem nos céus.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172195&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'e7768b49-261f-47b0-8893-a138a6532e7a', 'multiverseId': 172195}, 'multiverseid': 172195}, {'name': 'Призматическое Знамение', 'text': 'Земли под вашим контролем обладают всеми типами базовых земель в дополнение к своим другим типам.', 'type': 'Чары', 'flavor': 'Когда случается предзнаменование, земля принимает форму запечатленных на небе знаков.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172496&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5574aedc-477d-4ae1-912a-6aee55fc59f0', 'multiverseId': 172496}, 'multiverseid': 172496}, {'name': '五彩预兆', 'text': '由你操控的地均额外具有所有基本地类别。', 'type': '结界', 'flavor': '在预兆之时，大地将依照天空燃烧的印记形状来型塑自身。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173098&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'fb7e239d-fa9e-418a-89bd-8292f981941d', 'multiverseId': 173098}, 'multiverseid': 173098}]", '[{\'name\': \'Prismensog-Merrow\', \'text\': \'Aufblitzen\\nWenn der Prismensog-Merrow ins Spiel kommt, bestimme die Farbe oder Farben, die eine bleibende Karte deiner Wahl bis zum Ende des Zuges hat.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'„Ich glaube nur, was ich sehe" — dieses Vorurteil nutzen Merrow beim Handeln mit anderen Völkern von Schattenmoor gnadenlos aus.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174523&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5f1c1d4-8e9a-48f1-a32b-b87be5576c19\', \'multiverseId\': 174523}, \'multiverseid\': 174523}, {\'name\': \'Merrow estela prismática\', \'text\': \'Destello.\\nCuando el Merrow estela prismática entre en juego, el permanente objetivo es del color o colores de tu elección hasta el final del turno.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'"Ver es creer" es un hecho que muchos merrow aprovechan en sus tratos con otros residentes del Páramo Sombrío.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172717&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d4ede7e3-a5b6-42be-8d41-f6041075afa8\', \'multiverseId\': 172717}, \'multiverseid\': 172717}, {\'name\': \'Suire au sillage prismatique\', \'text\': "Flash\\nQuand le Suire au sillage prismatique arrive en jeu, le permanent ciblé devient de la couleur ou des couleurs de votre choix jusqu\'à la fin du tour.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': \'« Voir pour le croire » est une expression que les suires exploitent à outrance dans leurs rapports avec les autres résidents de Sombrelande.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173319&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'baf18b0e-0192-476e-b2b4-19c1ea91e539\', \'multiverseId\': 173319}, \'multiverseid\': 173319}, {\'name\': \'Merrow dalla Scia Prismatica\', \'text\': \'Lampo\\nQuando il Merrow dalla Scia Prismatica entra in gioco, un permanente bersaglio diventa di uno o più colori a tua scelta fino alla fine del turno.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'"Vedere per credere" è un detto che i merrow sfruttano senza pietà nei loro affari con gli altri abitanti della Landa Tenebrosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173620&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'441714fd-7aa8-4de7-bd53-f3d943fcf4a8\', \'multiverseId\': 173620}, \'multiverseid\': 173620}, {\'name\': \'虹跡のメロウ\', \'text\': \'瞬速\\n虹跡のメロウが場に出たとき、パーマネント１つを対象とする。それはターン終了時まであなたが選んだ色（１色または複数の色の組み合わせ）になる。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'いかにメロウがシャドウムーアの他の住人たちとの取引で無慈悲な搾取を見せているかは、まさに「百聞は一見にしかず」だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173921&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ce654a8-7d10-4bdf-9d52-ca5c172dfa4a\', \'multiverseId\': 173921}, \'multiverseid\': 173921}, {\'name\': \'Sirenídeo Rastro-Prísmeo\', \'text\': \'Lampejo\\nQuando Sirenídeo Rastro-Prísmeo entra em jogo, a permanente alvo torna-se da cor ou das cores de sua escolha até o final do turno.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'"Ver para crer" é um fato explorado implacavelmente pelos sirenídeos quando lidam com os outros habitantes de Pântano Sombrio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172115&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b9ca3a31-2c20-4c16-b95a-10311afbe934\', \'multiverseId\': 172115}, \'multiverseid\': 172115}, {\'name\': \'Мерроу Радужного Следа\', \'text\': \'Миг\\nКогда Мерроу Радужного Следа входит в игру, цвет целевого перманента изменяется на выбранные вами цвет или цвета до конца хода.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'«Увидеть значит поверить», вот принцип, которым безжалостно злоупотребляют мерроу в своих отношениях с другими обитателями Шэдоумура.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172416&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'154467f7-015c-4ca7-b7c5-a065e5aba313\', \'multiverseId\': 172416}, \'multiverseid\': 172416}, {\'name\': \'彩迹美洛\', \'text\': \'闪现\\n当彩迹美洛进场时，目标永久物的颜色成为由你选择的颜色或颜色组合直到回合结束。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'美洛与暗影荒原其他居民交易时奉行不渝的准则，便是「眼见为凭」。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173018&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b1ba30ce-3c7d-484e-b5ce-7502a98c7e64\', \'multiverseId\': 173018}, \'multiverseid\': 173018}]', '[{\'name\': \'Punktierender Donnerkeil\', \'text\': \'Der Punktierende Donnerkeil fügt einer Kreatur deiner Wahl 1 Schadenspunkt zu. Lege eine -1/-1-Marke auf diese Kreatur.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die Pyromagier der Rußwesen messen ihren Erfolg daran, wie viele Brandlöcher der Gegner hat.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174579&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20cbd607-5832-45e2-9671-dbbca2229cc1\', \'multiverseId\': 174579}, \'multiverseid\': 174579}, {\'name\': \'Rayo punzante\', \'text\': \'El Rayo punzante hace 1 punto de daño a la criatura objetivo. Pon un contador -1/-1 sobre esa criatura.\', \'type\': \'Instantáneo\', \'flavor\': \'Los piromantes cenicientos miden su éxito contando los agujeros humeantes que dejan sus enemigos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172773&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'154801bf-1606-4d80-b81d-7f2a5ffe6a3b\', \'multiverseId\': 172773}, \'multiverseid\': 172773}, {\'name\': \'Éclair perforant\', \'text\': "L\'Éclair perforant inflige 1 blessure à la créature ciblée. Mettez un marqueur -1/-1 sur cette créature.", \'type\': \'Éphémère\', \'flavor\': \'Les pyromanciens scoriacés déterminent leur degré de réussite en comptant les trous fumants dans les corps de leurs ennemis.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173375&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'68f497c0-2ed0-4047-8515-764b69363ee4\', \'multiverseId\': 173375}, \'multiverseid\': 173375}, {\'name\': \'Fulmine Perforante\', \'text\': \'Il Fulmine Perforante infligge 1 danno a una creatura bersaglio. Metti un segnalino -1/-1 su quella creatura.\', \'type\': \'Istantaneo\', \'flavor\': \'I piromanti cinerei misurano i loro successi contando le buche fumanti dei loro nemici.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173676&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'92815870-a5bd-44e5-bb5e-0f4f17c41f67\', \'multiverseId\': 173676}, \'multiverseid\': 173676}, {\'name\': \'刺す稲妻\', \'text\': \'クリーチャー１体を対象とする。刺す稲妻はそれに１点のダメージを与える。 そのクリーチャーの上に－１/－１カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': \'燃えがらの紅蓮術士は、敵の身体にあいた煙を吹く穴を数えて、どれだけうまくやったかを計る。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173977&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'203b49db-9ad2-456d-9af3-4bad55865f47\', \'multiverseId\': 173977}, \'multiverseid\': 173977}, {\'name\': \'Raio Perfurante\', \'text\': \'Raio Perfurante causa 1 ponto de dano à criatura alvo. Coloque um marcador -1/-1 naquela criatura.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os piromânticos cinzeríneos medem seu sucesso contando os buracos fumegantes de seus inimigos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172171&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'90336d6a-d0ef-4570-9ea9-5d90de02ea35\', \'multiverseId\': 172171}, \'multiverseid\': 172171}, {\'name\': \'Пронзающий Удар\', \'text\': \'Пронзающий Удар наносит 1 повреждение целевому существу. Положите один жетон -1/-1 на то существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Для золовиков-пиромантов мерой успеха является количество дымящихся дыр во вражеских телах.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172472&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7fce90b7-9911-4016-ae28-2cc138529eed\', \'multiverseId\': 172472}, \'multiverseid\': 172472}, {\'name\': \'穿刺击\', \'text\': \'穿刺击对目标生物造成1点伤害。 在该生物上放置一个-1/-1指示物。\', \'type\': \'瞬间\', \'flavor\': \'烬身烈焰术士是用敌人身上冒烟洞孔的数量来论高下。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173074&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'51a1d894-685c-4e5d-85ed-631b0186010d\', \'multiverseId\': 173074}, \'multiverseid\': 173074}]', '[{\'name\': \'Puppenspieler-Clique\', \'text\': \'Fliegend\\nWenn die Puppenspieler-Clique ins Spiel kommt, bringe eine Kreaturenkarte deiner Wahl aus dem Friedhof eines Gegners unter deiner Kontrolle ins Spiel. Sie hat Eile. Entferne sie am Ende deines Zuges ganz aus dem Spiel.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Feenwesen, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174552&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'78b27cc8-00d0-4466-a282-72ef15bee800\', \'multiverseId\': 174552}, \'multiverseid\': 174552}, {\'name\': \'Pandilla de titiriteros\', \'text\': \'Vuela.\\nCuando la Pandilla de titiriteros entre en juego, pon en juego bajo tu control la carta de criatura objetivo del cementerio de un oponente. Tiene la habilidad de prisa. Al final de tu turno, remuévela del juego.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Hechicero hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172746&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7972bba5-36d3-40f0-9f64-75b16e2303dc\', \'multiverseId\': 172746}, \'multiverseid\': 172746}, {\'name\': \'Clique des marionnettistes\', \'text\': "Vol\\nQuand la Clique des marionnettistes arrive en jeu, mettez en jeu, sous votre contrôle, la carte de créature ciblée du cimetière d\'un adversaire. Elle a la célérité. À la fin de votre tour, retirez-la de la partie.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : peuple fée et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173348&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b04b8da-4218-4470-b084-474c3bdd3337\', \'multiverseId\': 173348}, \'multiverseid\': 173348}, {\'name\': \'Cricca di Burattinai\', \'text\': \'Volare\\nQuando la Cricca di Burattinai entra in gioco, metti in gioco sotto il tuo controllo una carta creatura bersaglio in un cimitero di un avversario. Ha rapidità. Alla fine del tuo turno, rimuovila dal gioco.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Mago Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173649&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c2c66f14-a210-4cef-8b98-2351df4c93a9\', \'multiverseId\': 173649}, \'multiverseid\': 173649}, {\'name\': \'くぐつ師の徒党\', \'text\': \'飛行\\nくぐつ師の徒党が場に出たとき、いずれかの対戦相手の墓地にあるクリーチャー・カード１枚を対象とし、それをあなたのコントロール下で場に出す。 それは速攻を持つ。 あなたのターンの終了時に、それをゲームから取り除く。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — フェアリー・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173950&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4c30907-f740-4dc3-afb0-4770cf2fad75\', \'multiverseId\': 173950}, \'multiverseid\': 173950}, {\'name\': \'Facção Titeriteira\', \'text\': \'Voar\\nQuando Facção Titeriteira entrar em jogo, coloque um card de criatura alvo que está no cemitério de um oponente em jogo sob seu controle. Ele tem ímpeto. No final de seu turno, remova-o de jogo.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Fada Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172144&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c5130ad7-d1fa-43ca-b08e-616ef3048113\', \'multiverseId\': 172144}, \'multiverseid\': 172144}, {\'name\': \'Клика Кукловодов\', \'text\': \'Полет\\nКогда Клика Кукловодов входит в игру, положите целевую карту существа из кладбища оппонента в игру под вашим контролем. Она имеет Ускорение. В конце вашего хода удалите ее из игры.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Фея Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172445&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16cec942-6ba6-4441-977b-43668faac4fa\', \'multiverseId\': 172445}, \'multiverseid\': 172445}, {\'name\': \'操偶聚群\', \'text\': \'飞行\\n当操偶聚群进场时，将目标生物牌在你的操控下从对手的坟墓场放置进场。 它具有敏捷。 在你的回合结束时，将它移出对战。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～仙灵／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173047&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'db1f8deb-5416-45e0-89c7-1fa3ad2801d7\', \'multiverseId\': 173047}, \'multiverseid\': 173047}]', '[{\'name\': \'Rasende Kopfschmerzen\', \'text\': \'Bestimme eines Ein Spieler deiner Wahl wirft zwei Karten aus seiner Hand ab; oder ein Spieler deiner Wahl zeigt die Karten auf seiner Hand offen vor, du bestimmst eine davon, und dieser Spieler wirft dann diese Karte ab.\', \'type\': \'Hexerei\', \'flavor\': \'Alle Feen sind hinter Träumen her. Doch nicht alle warten, bis ihre Opfer eingeschlafen sind.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174556&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42110b28-d6ca-4420-9a47-574236d22958\', \'multiverseId\': 174556}, \'multiverseid\': 174556}, {\'name\': \'Dolor de cabeza fracturante\', \'text\': \'Elige uno: El jugador objetivo descarta dos cartas; o el jugador objetivo muestra su mano, tú eliges una carta de ahí y ese jugador descarta esa carta.\', \'type\': \'Conjuro\', \'flavor\': \'Todas las hadas buscan sueños. Pero no todas esperan que sus víctimas se duerman.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172750&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8c9aba94-ade4-4495-a946-33497a291a17\', \'multiverseId\': 172750}, \'multiverseid\': 172750}, {\'name\': \'Atroce mal de tête\', \'text\': "Choisissez l\'un — Le joueur ciblé se défausse de deux cartes ; ou le joueur ciblé révèle sa main, vous y choisissez une carte, et ce joueur se défausse ensuite de cette carte.", \'type\': \'Rituel\', \'flavor\': "Toutes les faeries chassent les rêves. Mais certaines n\'attendent pas que leurs victimes soient endormies.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173352&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1b579606-69b0-4c74-9730-3b008328f03a\', \'multiverseId\': 173352}, \'multiverseid\': 173352}, {\'name\': \'Mal di Testa che Spacca\', \'text\': \'Scegli uno Un giocatore bersaglio scarta due carte; oppure un giocatore bersaglio rivela la sua mano, tu scegli una carta da essa, poi quel giocatore scarta quella carta.\', \'type\': \'Stregoneria\', \'flavor\': \'Tutti gli spiritelli desiderano i sogni. Ma non tutti aspettano che le loro vittime si addormentino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173653&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1949ce22-1615-4dac-9bd6-1aee9601a94a\', \'multiverseId\': 173653}, \'multiverseid\': 173653}, {\'name\': \'割れるような頭痛\', \'text\': \'以下の２つから１つを選ぶ。「プレイヤー１人を対象とする。そのプレイヤーはカードを２枚捨てる。」「プレイヤー１人を対象とする。そのプレイヤーは自分の手札を公開し、あなたはそこからカードを１枚選ぶ。その後、そのプレイヤーはそのカードを捨てる。」\', \'type\': \'ソーサリー\', \'flavor\': \'妖精はみんな夢を掘り起こす。 しかし、被害者が眠るまで待つとは限らない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173954&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1b7163f7-364c-4998-83ba-7f79546de64d\', \'multiverseId\': 173954}, \'multiverseid\': 173954}, {\'name\': \'Enxaqueca Dilacerante\', \'text\': \'Escolha um O jogador alvo descarta dois cards; ou o jogador alvo revela sua mão, você escolhe um card dela e aquele jogador descarta aquele card.\', \'type\': \'Feitiço\', \'flavor\': \'Todas as fadas buscam sonhos. Mas nem todas esperam que suas vítimas adormeçam.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172148&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'65188f00-5e6a-414e-a1ef-629618d508e9\', \'multiverseId\': 172148}, \'multiverseid\': 172148}, {\'name\': \'Пронзительная Боль\', \'text\': \'Выберите одно целевой игрок сбрасывает две карты; или целевой игрок показывает свою руку, вы выбираете из нее карту, затем тот игрок сбрасывает ту карту.\', \'type\': \'Волшебство\', \'flavor\': \'Все феи собирают сновидения, но не все ждут, пока их жертва заснет.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172449&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'707b6915-4348-42e5-8d99-6bce7d8a7190\', \'multiverseId\': 172449}, \'multiverseid\': 172449}, {\'name\': \'头痛欲裂\', \'text\': \'选择一项～目标牌手弃两张牌；或目标牌手展示其手牌，你选择其中一张，然后该牌手弃掉该牌。\', \'type\': \'法术\', \'flavor\': \'所有仙灵都会探索幻梦。 但不是每个都愿等到苦主睡着。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173051&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d1ffe574-df57-42b7-8f11-1571834f880d\', \'multiverseId\': 173051}, \'multiverseid\': 173051}]', '[{\'name\': \'Ratschlag der Fee\', \'text\': \'({2/U} kann mit zwei beliebigen Mana oder mit {U} bezahlt werden. Die umgewandelten Manakosten dieser Karte betragen 6.)\\nSchaue dir die obersten fünf Karten deiner Bibliothek an. Kontrollierst du mehr Kreaturen als jeder andere Spieler, nimm zwei dieser Karten auf deine Hand. Nimm sonst eine davon auf deine Hand. Lege dann den Rest in beliebiger Reihenfolge unter deine Bibliothek.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174505&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'199c5558-f561-48f2-9457-c66f0a0a95d0\', \'multiverseId\': 174505}, \'multiverseid\': 174505}, {\'name\': \'Consejo de las hadas\', \'text\': \'({2/U} puede pagarse con dos maná cualesquiera o con {U}. El costo de maná convertido de esta carta es 6.)\\nMira las primeras cinco cartas de tu biblioteca. Si controlas más criaturas que cualquiera de los otros jugadores, pon dos de esas cartas en tu mano. De lo contrario, pon una de ellas en tu mano. Luego pon el resto en el fondo de tu biblioteca en cualquier orden.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172699&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'56a5681b-32a1-47b4-ae3b-9c5b41948882\', \'multiverseId\': 172699}, \'multiverseid\': 172699}, {\'name\': \'Recommandation des faeries\', \'text\': "({2/U} peut être payé au choix avec n\'importe quelle combinaison de deux manas ou avec {U}. Le coût converti de mana de cette carte est 6.)\\nRegardez les cinq cartes du dessus de votre bibliothèque. Si vous contrôlez plus de créatures que chacun des autres joueurs, mettez deux de ces cartes dans votre main. Sinon, mettez l\'une d\'elles dans votre main. Mettez ensuite les autres au-dessous de votre bibliothèque, dans n\'importe quel ordre.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173301&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f275f9c4-1bb2-4015-8938-46e7767008e8\', \'multiverseId\': 173301}, \'multiverseid\': 173301}, {\'name\': \'Consiglio degli Spiritelli\', \'text\': \'({2/U} può essere pagato con due mana qualsiasi o con {U}. Il costo di mana convertito di questa carta è 6.)\\nGuarda le prime cinque carte del tuo grimorio. Se controlli più creature di qualsiasi altro giocatore, aggiungi alla tua mano due di quelle carte. Altrimenti, aggiungi alla tua mano una di quelle carte. Poi metti le altre in fondo al tuo grimorio in qualsiasi ordine.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173602&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'10eeab0d-b816-4f93-b4e7-fabe1dc4ee45\', \'multiverseId\': 173602}, \'multiverseid\': 173602}, {\'name\': \'妖精からの助言\', \'text\': \'（{2/U}は、任意の２マナか{U}で支払うことができる。 このカードの点数で見たマナ・コストは６である。）\\nあなたのライブラリーの一番上から５枚のカードを見る。 あなたが他の各プレイヤーよりも多くのクリーチャーをコントロールしている場合、それらのカードのうちの２枚をあなたの手札に加える。 そうでない場合、それらのうちの１枚をあなたの手札に加える。 その後、残りをあなたのライブラリーの一番下に望む順番で置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173903&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'19862dd1-6367-4827-ab23-a800f9132b1e\', \'multiverseId\': 173903}, \'multiverseid\': 173903}, {\'name\': \'Conselho das Fadinas\', \'text\': \'({2/U} pode ser pago com quaisquer dois manas ou com {U}. O custo de mana convertido desse card é 6.)\\nOlhe os cinco cards do topo de seu grimório. Se você controlar mais criaturas do que qualquer outro jogador, coloque dois desses cards na sua mão. Do contrário, coloque um deles na sua mão. Coloque o resto no fundo de seu grimório em qualquer ordem.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172097&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b01e881f-c63e-4b9c-8590-15e0368d1475\', \'multiverseId\': 172097}, \'multiverseid\': 172097}, {\'name\': \'Советы Фей\', \'text\': \'(За {2/U} можно заплатить две любые маны или {U}. Конвертированная мана-стоимость этой карты равна 6.)\\nПосмотрите пять верхних карт вашей библиотеки. Если вы контролируете больше существ, чем любой другой игрок, положите две из тех карт в вашу руку. В противном случае положите в вашу руку одну из них. Затем положите остальные карты в низ вашей библиотеки в любом порядке.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172398&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'922f50ed-339f-481f-8e74-2c89380ff956\', \'multiverseId\': 172398}, \'multiverseid\': 172398}, {\'name\': \'仙儿建言\', \'text\': \'（能用任意两点法术力或是{U}来支付{2/U}。 此牌的总法术力费用为6。）\\n检视你牌库顶的五张牌。 如果由你操控的生物数量比其他每位牌手都多，则将其中两张置于你手上。 若否，则将其中一张置于你手上。 然后将其余的牌以任意顺序置于你牌库底。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173000&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5658a7c8-3f62-4d17-9c14-c776482ba306\', \'multiverseId\': 173000}, \'multiverseid\': 173000}]', '[{\'name\': \'Reinsichtiger Merrow\', \'text\': \'{W/U}, {Q}: Schaue dir die oberste Karte deiner Bibliothek an. Du kannst diese Karte ganz aus dem Spiel entfernen. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Nachdem man ihm das Augenlicht geraubt hatte, stellte er sich immer das Idealbild vor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174623&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e49930a-4d4e-4509-a6ad-834259025159\', \'multiverseId\': 174623}, \'multiverseid\': 174623}, {\'name\': \'Merrow visión pura\', \'text\': \'{W/U}, {Q}: Mira la primera carta de tu biblioteca. Puedes remover del juego esa carta. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'Despojado de su visión, fue libre para ver sólo el ideal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172817&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8fe14570-f1e5-4114-9f7a-e9e0c49a158e\', \'multiverseId\': 172817}, \'multiverseid\': 172817}, {\'name\': \'Suire clairevue\', \'text\': \'{W/U}, {Q} : Regardez la carte du dessus de votre bibliothèque. Vous pouvez retirer cette carte de la partie. ({Q} est le symbole de dégagement.)\', \'type\': \'Créature : ondin et sorcier\', \'flavor\': "Privé de la vue, il était à présent libre de ne voir que l\'idéal.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173419&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d0bfa18e-1361-46ac-b9f8-c66fbbd81cb9\', \'multiverseId\': 173419}, \'multiverseid\': 173419}, {\'name\': \'Sguardopuro Merrow\', \'text\': \'{W/U}, {Q}: Guarda la prima carta del tuo grimorio. Puoi rimuovere dal gioco quella carta. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': \'Privato della vista, era libero di vedere solo ciò che voleva.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173720&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'83c90c90-7584-4c7b-9a94-f425b26e3a2f\', \'multiverseId\': 173720}, \'multiverseid\': 173720}, {\'name\': \'純視のメロウ\', \'text\': \'{W/U}, {Q}：あなたのライブラリーの一番上のカードを見る。 あなたはそのカードをゲームから取り除いてもよい。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'視界を切り裂かれた彼は、いまや自由に理想を見ることができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174021&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f17154b-9f04-4bca-85e4-8cbf5f50dccc\', \'multiverseId\': 174021}, \'multiverseid\': 174021}, {\'name\': \'Sirenídeo Visão-Pura\', \'text\': \'{W/U}, {Q}: Olhe o card do topo de seu grimório. Você pode remover aquele card do jogo. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'Despido de sua visão, ele podia ver somente o ideal.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172215&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a6bb5b90-6769-4760-9a54-b6d22535f0c8\', \'multiverseId\': 172215}, \'multiverseid\': 172215}, {\'name\': \'Ясновидящий Мерроу\', \'text\': \'{W/U}, {Q}: посмотрите верхнюю карту вашей библиотеки. Вы можете удалить ту карту из игры. ({Q} символ разворота карты.)\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Лишенный зрения, он мог свободно видеть только совершенство.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172516&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0addb71d-cabf-49a1-9092-b90a91523cb5\', \'multiverseId\': 172516}, \'multiverseid\': 172516}, {\'name\': \'净景美洛\', \'text\': \'{W/U}，{Q}：检视你的牌库顶牌。 你可以将该牌移出对战。 （{Q}是重置符号。）\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'视力虽失，却能看清理想。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173118&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'596b0178-3ef4-4c87-b7cb-7a852cf15625\', \'multiverseId\': 173118}, \'multiverseid\': 173118}]', '[{\'name\': \'Restekorb\', \'text\': \'{1}: Der Restekorb hat bis zum Ende des Zuges alle Farben.\', \'type\': \'Artefaktkreatur — Vogelscheuche\', \'flavor\': \'Einst hatten Kithkinbauern sie auf den Feldern aufgestellt, doch jetzt ziehen die durch rustikale Magie animierten Vogelscheuchen durch das ganze Schattenmoor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174739&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8d5b5434-226c-4f66-b6b0-a3ec868d5521\', \'multiverseId\': 174739}, \'multiverseid\': 174739}, {\'name\': \'Cesto de desechos\', \'text\': \'{1}: El Cesto de desechos es de todos los colores hasta el final del turno.\', \'type\': \'Criatura artefacto — Espantapájaros\', \'flavor\': \'Aunque alguna vez fueron herramientas de los granjeros kithkin, los espantapájaros de miles de formas ahora se arrastran por todo el Páramo sombrío, animados por magia residual.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172933&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f9328ee-0fe4-4c10-ae84-f42194f19a94\', \'multiverseId\': 172933}, \'multiverseid\': 172933}, {\'name\': \'Corbeiller\', \'text\': "{1} : Le Corbeiller devient de toutes les couleurs jusqu\'à la fin du tour.", \'type\': \'Créature-artefact : épouvantail\', \'flavor\': \'Autrefois les outils des fermiers sangamis, des épouvantails de toutes formes hantent les champs de Sombrelande, animés par une magie rustique résiduelle.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173535&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05af95a4-1d9f-4bfc-b82b-22192233f3a7\', \'multiverseId\': 173535}, \'multiverseid\': 173535}, {\'name\': \'Cesto degli Scarti\', \'text\': \'{1}: Il Cesto degli Scarti diventa di tutti i colori fino alla fine del turno.\', \'type\': \'Creatura Artefatto — Spaventapasseri\', \'flavor\': \'Un tempo attrezzi dei contadini kithkin, spaventapasseri di qualsiasi forma vagano adesso nella Landa Tenebrosa, animati dai residui delle magie rustiche.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173836&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53addb5c-973a-448c-9f54-782a25f081f6\', \'multiverseId\': 173836}, \'multiverseid\': 173836}, {\'name\': \'屑鉄カゴ\', \'text\': \'{1}：ターン終了時まで、屑鉄カゴはすべての色になる。\', \'type\': \'アーティファクト・クリーチャー — カカシ\', \'flavor\': \'かつてはキスキンの農夫の道具だった様々なカカシは、純朴な魔法の残滓に操られながら、シャドウムーア全土を渡り潜んでいる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174137&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4791d28b-50fa-456f-b928-9a787e0f9468\', \'multiverseId\': 174137}, \'multiverseid\': 174137}, {\'name\': \'Cesto Remendado\', \'text\': \'{1}: Cesto Remendado torna-se de todas as cores até o final do turno.\', \'type\': \'Criatura Artefato — Espantalho\', \'flavor\': \'Outrora uma ferramenta dos fazendeiros kithkin, os espantalhos de todas as formas agora sacolejam por Pântano Sombrio, animados por restos de magias rústicas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172331&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'96b36aa6-aa7c-4672-81ee-ffc64cb898e7\', \'multiverseId\': 172331}, \'multiverseid\': 172331}, {\'name\': \'Коробок\', \'text\': \'{1}: Коробок становится всеми цветами до конца хода.\', \'type\': \'Артефактное Существо — Пугало\', \'flavor\': \'Когда-то служившие орудиями кискенских фермеров, пугала всевозможных обликов теперь носятся и шатаются по всему Шэдоумуру, оживляемые еще сохранившимися деревенскими заклинаниями.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172632&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'88897bc0-55e9-4f3a-827a-6d7d12cf5362\', \'multiverseId\': 172632}, \'multiverseid\': 172632}, {\'name\': \'破篓草人\', \'text\': \'{1}：破篓草人成为所有颜色直到回合结束。\', \'type\': \'神器生物～稻草人\', \'flavor\': \'各种外型的稻草人曾是洁英农夫的工具，现在仍受残余的乡村法术所操弄，摇摇晃晃地在暗影荒原出没。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173234&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a3789338-b143-403e-ac79-bd7d81ec3ed9\', \'multiverseId\': 173234}, \'multiverseid\': 173234}]', '[{\'name\': \'Rhys der Rehabilitierte\', \'text\': \'{2}{G/W}, {T}: Bringe einen 1/1 grünen und weißen (Elf, Krieger)-Kreaturenspielstein ins Spiel.\\n{4}{G/W}{G/W}, {T}: Bringe für jeden Kreaturenspielstein, den du kontrollierst, einen Spielstein ins Spiel, der eine Kopie dieser Kreatur ist.\', \'type\': \'Legendäre Kreatur — Elf, Krieger\', \'flavor\': \'Ehre und Hörner sind wiederhergestellt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174714&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a8530061-f387-45a1-a07b-863ad39ca0f1\', \'multiverseId\': 174714}, \'multiverseid\': 174714}, {\'name\': \'Rhys el redimido\', \'text\': \'{2}{G/W}, {T}: Pon en juego una ficha de criatura Guerrero Elfo verde y blanca 1/1.\\n{4}{G/W}{G/W}, {T}: Por cada ficha de criatura que controles, pon en juego una ficha que es una copia de esa criatura.\', \'type\': \'Criatura legendaria — Guerrero elfo\', \'flavor\': \'Nuevamente completo, en honor y en cuernos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172908&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3f419178-1f23-4acc-b993-1217e74785ee\', \'multiverseId\': 172908}, \'multiverseid\': 172908}, {\'name\': "Rhys l\'Affranchi", \'text\': \'{2}{G/W}, {T} : Mettez en jeu un jeton de créature 1/1 verte et blanche Elfe et Guerrier.\\n{4}{G/W}{G/W}, {T} : Pour chaque jeton de créature que vous contrôlez, mettez en jeu un jeton qui est une copie de cette créature.\', \'type\': \'Créature légendaire : elfe et guerrier\', \'flavor\': \'Enfin complet par honneur et par corne.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173510&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4d221687-f18c-41b4-a5ae-d2cba04a0a5f\', \'multiverseId\': 173510}, \'multiverseid\': 173510}, {\'name\': \'Rhys il Redento\', \'text\': \'{2}{G/W}, {T}: Metti in gioco una pedina creatura Guerriero Elfo 1/1 bianca e verde.\\n{4}{G/W}{G/W}, {T}: Per ogni pedina creatura che controlli, metti in gioco una pedina che è una copia di quella creatura.\', \'type\': \'Creatura Leggendaria — Guerriero Elfo\', \'flavor\': \'Di nuovo intero, in corna e onore.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173811&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b157d5ab-d279-4f5a-a172-9669d222cd34\', \'multiverseId\': 173811}, \'multiverseid\': 173811}, {\'name\': \'贖われし者、ライズ\', \'text\': \'{2}{G/W}, {T}：緑であり白である１/１のエルフ・戦士・クリーチャー・トークンを１体場に出す。\\n{4}{G/W}{G/W}, {T}：あなたがコントロールするクリーチャー・トークン１体につき、そのクリーチャーのコピーであるトークンを１体場に出す。\', \'type\': \'伝説のクリーチャー — エルフ・戦士\', \'flavor\': \'名誉と角を再びすべて取り戻す。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174112&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'54048591-09cb-4061-8e99-cb7ad7ad4868\', \'multiverseId\': 174112}, \'multiverseid\': 174112}, {\'name\': \'Rhys, o Redimido\', \'text\': \'{2}{G/W}, {T}: Coloque em jogo uma ficha de criatura verde e branca 1/1 do tipo Elfo Guerreiro.\\n{4}{G/W}{G/W}, {T}: Para cada ficha de criatura que você controla, coloque em jogo uma ficha que seja uma cópia daquela criatura.\', \'type\': \'Criatura Lendária — Elfo Guerreiro\', \'flavor\': \'Inteiro novamente, honra e chifre.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172306&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ea64bc1f-6edc-41f0-b696-436806cbf980\', \'multiverseId\': 172306}, \'multiverseid\': 172306}, {\'name\': \'Риз Возвращенный\', \'text\': \'{2}{G/W}, {T}: положите в игру одну фишку существа 1/1 зеленый и белый Эльф Воин.\\n{4}{G/W}{G/W}, {T}: за каждую фишку существа под вашим контролем положите в игру одну фишку, являющуюся копией того существа.\', \'type\': \'Легендарное Существо — Эльф Воин\', \'flavor\': \'И вот опять он цел и невредим, почет ему и слава.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172607&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'42275601-0678-4e2e-aa8d-660fb0d459d4\', \'multiverseId\': 172607}, \'multiverseid\': 172607}, {\'name\': \'复耀黎兹\', \'text\': \'{2}{G/W}，{T}：将一个1/1，绿白双色的地精／战士衍生物放置进场。\\n{4}{G/W}{G/W}，{T}：对每个由你操控的衍生物而言，将一个衍生物放置进场，且是前者的复制。\', \'type\': \'传奇生物～地精／战士\', \'flavor\': \'名声重挽，犄角复归。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173209&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8baefb72-cf56-4740-917b-caeca4eefb33\', \'multiverseId\': 173209}, \'multiverseid\': 173209}]', "[{'name': 'Ritual der Auszehrung', 'text': 'Opfere eine Kreatur als zusätzliche Kosten, um das Ritual der Auszehrung zu spielen.\\nDas Ritual der Auszehrung fügt einem Spieler deiner Wahl Schadenspunkte in Höhe der Stärke der geopferten Kreatur zu. Du erhältst so viele Lebenspunkte dazu, wie auf diese Weise Schadenspunkte zugefügt wurden.', 'type': 'Hexerei', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174553&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c9c4ed50-d18a-4e4b-b808-b656680beadb', 'multiverseId': 174553}, 'multiverseid': 174553}, {'name': 'Rito de consunción', 'text': 'Como coste adicional para jugar el Rito de consunción, sacrifica una criatura.\\nEl Rito de consunción hace una cantidad de daño igual a la fuerza de la criatura sacrificada al jugador objetivo. Ganas una cantidad de vida igual al daño hecho de esta manera.', 'type': 'Conjuro', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172747&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a03b7230-4ed2-495c-99b6-352397f93d24', 'multiverseId': 172747}, 'multiverseid': 172747}, {'name': 'Rite de phtisie', 'text': 'En tant que coût supplémentaire pour jouer le Rite de phtisie, sacrifiez une créature.\\nLe Rite de phtisie inflige au joueur ciblé un nombre de blessures égal à la force de la créature sacrifiée. Vous gagnez autant de points de vie que de blessures infligées de cette manière.', 'type': 'Rituel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173349&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4fe97aa4-74e3-471b-a78a-ff2ef8e4b004', 'multiverseId': 173349}, 'multiverseid': 173349}, {'name': 'Rito di Consumo', 'text': 'Come costo addizionale per giocare il Rito di Consumo, sacrifica una creatura.\\nIl Rito di Consumo infligge danno pari alla forza della creatura sacrificata a un giocatore bersaglio. Guadagni punti vita pari ai danni inflitti in questo modo.', 'type': 'Stregoneria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173650&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6d50d709-c834-4cae-afd5-4b4de87b2a78', 'multiverseId': 173650}, 'multiverseid': 173650}, {'name': '消耗の儀式', 'text': '消耗の儀式をプレイするための追加コストとして、クリーチャーを１体生け贄に捧げる。\\nプレイヤー１人を対象とする。消耗の儀式はそのプレイヤーに、生け贄に捧げられたクリーチャーのパワーに等しい点数のダメージを与える。 あなたはこれにより与えたダメージに等しい点数のライフを得る。', 'type': 'ソーサリー', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173951&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '1b2a5854-699d-4c01-a500-4b8f29aa7696', 'multiverseId': 173951}, 'multiverseid': 173951}, {'name': 'Rito de Consumação', 'text': 'Como custo adicional para jogar Rito de Consumação, sacrifique uma criatura.\\nRito de Consumação causa dano igual ao poder da criatura sacrificada ao jogador alvo. Você ganha uma quantidade de pontos de vida igual ao dano causado desta maneira.', 'type': 'Feitiço', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172145&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'ce25d22e-5d5b-4849-aa5c-88134b960850', 'multiverseId': 172145}, 'multiverseid': 172145}, {'name': 'Обряд Поглощения', 'text': 'В качестве дополнительной стоимости разыгрывания Обряда Поглощения пожертвуйте существо.\\nОбряд Поглощения наносит целевому игроку количество повреждений, равное силе пожертвованного существа. Вы получаете столько жизней, сколько повреждений было нанесено таким образом.', 'type': 'Волшебство', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172446&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4f5175c0-46ca-4c09-a3de-63f61680e139', 'multiverseId': 172446}, 'multiverseid': 172446}, {'name': '耗竭仪式', 'text': '牺牲一个生物，以作为使用耗竭仪式的额外费用。\\n耗竭仪式对目标牌手造成伤害，其数量等同于所牺牲生物的力量。 你获得等同于以此法所造成的伤害之生命。', 'type': '法术', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173048&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '647f77e3-46bc-450e-9a06-1b1ed7e3bfbd', 'multiverseId': 173048}, 'multiverseid': 173048}]", '[{\'name\': \'Rosheen Mäanderer\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {4}. Verwende dieses Mana nur für Kosten, die {X} enthalten.\', \'type\': \'Legendäre Kreatur — Riese, Schamane\', \'flavor\': \'Nacht um Nacht erzählte Rosheen von einer vergangenen, sonnenüberfluteten Welt, doch alles, was sie sagte, wurde als Geplapper einer Verrückten abgetan.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174691&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c5521dbb-80cf-49a9-8c75-172ecc07fa7c\', \'multiverseId\': 174691}, \'multiverseid\': 174691}, {\'name\': \'Rosheen Meanderer\', \'text\': \'{T}: Agrega {4} a tu reserva de maná. Usa este maná sólo en costes que contengan {X}.\', \'type\': \'Criatura legendaria — Chamán gigante\', \'flavor\': \'Noche tras noche, Rosheen balbucea sobre un mundo soleado, pero sus palabras son tratadas como el parloteo de un loco.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172885&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'beb2fc12-b58f-4309-826f-760de7353818\', \'multiverseId\': 172885}, \'multiverseid\': 172885}, {\'name\': "Rosheen l\'Erratique", \'text\': \'{T} : Ajoutez {4} à votre réserve. Ne dépensez ce mana que pour des coûts qui contiennent {X}.\', \'type\': \'Créature légendaire : géant et shamane\', \'flavor\': "Chaque nuit, Rosheen balbutiait quelque chose à propos d\'un monde baigné de soleil, ce que tout le monde considérait comme les divagations d\'une folle.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173487&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6beb9846-90a1-41af-867e-13fa549f9819\', \'multiverseId\': 173487}, \'multiverseid\': 173487}, {\'name\': \'Rosheen dei Vaneggiamenti\', \'text\': \'{T}: Aggiungi {4} alla tua riserva di mana. Spendi questo mana solo per costi che contengono {X}.\', \'type\': \'Creatura Leggendaria — Sciamano Gigante\', \'flavor\': \'Notte dopo notte, Rosheen balbettava di un mondo scomparso di luce solare, ma ogni sua singola parola veniva considerata il vaneggiare di un donna impazzita.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173788&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e99ffe2e-8e8b-4cf7-be6c-26d7e71a139d\', \'multiverseId\': 173788}, \'multiverseid\': 173788}, {\'name\': \'曲がりくねりのロシーン\', \'text\': \'{T}：あなたのマナ・プールに{4}を加える。 このマナは{X}を含むコストにのみ使用できる。\', \'type\': \'伝説のクリーチャー — 巨人・シャーマン\', \'flavor\': \'毎夜、ロシーンは過ぎ去った陽の照る世界のことをつぶやいていたが、彼女の言葉は狂人の振る舞いとして片付けられていた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174089&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a834be69-80c9-4dcd-bf86-6e00a8c20bf1\', \'multiverseId\': 174089}, \'multiverseid\': 174089}, {\'name\': \'Rosheen Logorréia\', \'text\': \'{T}: Adicione {4} à sua reserva de mana. Gaste este mana apenas com custos que contenham {X}.\', \'type\': \'Criatura Lendária — Gigante Xamã\', \'flavor\': \'Noite após noite, Rosheen tagarelava sobre um mundo ensolarado do passado, cada palavra desprezada como delírios de uma velha louca.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172283&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ffbab2aa-e06a-43a0-9186-71b75b9f06ce\', \'multiverseId\': 172283}, \'multiverseid\': 172283}, {\'name\': \'Роушин Пустомеля\', \'text\': \'{T}: добавьте {4} в ваше хранилище маны. Тратьте эту ману только для оплаты стоимостей, в которых есть {X}.\', \'type\': \'Легендарное Существо — Гигант Шаман\', \'flavor\': \'Ночь за ночью Роушин бормотала об ушедшем мире, залитом солнцем, но никто не верил ни одному ее слову, считая ее сказания бредом сумасшедшей старухи.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172584&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'58c9796a-e650-44c9-82be-c9a50439e6bb\', \'multiverseId\': 172584}, \'multiverseid\': 172584}, {\'name\': \'漫步人罗欣\', \'text\': \'{T}：加{4}到你的法术力池中。 此法术力只能用来支付包含{X}的费用。\', \'type\': \'传奇生物～巨人／祭师\', \'flavor\': \'罗欣每晚都絮叨着某个已逝的阳光充盈世界，而每字每句都只给当成疯女人的胡言乱语。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173186&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b01f5fed-3fd0-4119-9952-af90e555b757\', \'multiverseId\': 173186}, \'multiverseid\': 173186}]', "[{'name': 'Rostklingen-Schlächter', 'text': 'Erstschlag\\nVerdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)', 'type': 'Kreatur — Goblin, Krieger', 'flavor': 'Die Klingen von Tantchen Wurzens Bande sind mit Blut gesalzen und mit Rost gepfeffert: Schlachtung und Würzung mit einem Hieb.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174582&type=card', 'language': 'German', 'identifiers': {'scryfallId': '14002ac7-b41d-40d6-a891-a0d22db4a508', 'multiverseId': 174582}, 'multiverseid': 174582}, {'name': 'Carnicero filo oxidado', 'text': 'Daña primero.\\nDebilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)', 'type': 'Criatura — Guerrero trasgo', 'flavor': 'La hoja de un carnicero está sazonada con sangre y óxido, matando y condimentando con un solo corte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172776&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '96ef63fb-f07c-4f78-bd7b-e3d23f8fcbea', 'multiverseId': 172776}, 'multiverseid': 172776}, {'name': 'Boucher rouillerasoir', 'text': 'Initiative\\nFlétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)', 'type': 'Créature : gobelin et guerrier', 'flavor': 'La lame des Sanguinaires est salée au sang et poivrée à la rouille pour un massacre bien assaisonné.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173378&type=card', 'language': 'French', 'identifiers': {'scryfallId': '771fd33b-6f95-4ff9-9ae2-d9de6b7fce98', 'multiverseId': 173378}, 'multiverseid': 173378}, {'name': 'Macellaio dalla Lama Rugginosa', 'text': 'Attacco improvviso\\nAvvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)', 'type': 'Creatura — Guerriero Goblin', 'flavor': 'La lama di una larva sanguinaria è salata con il sangue e pepata con la ruggine, in modo da insaporire e uccidere in un colpo solo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173679&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '35aadff2-4ebe-4e06-b299-20a9506c243c', 'multiverseId': 173679}, 'multiverseid': 173679}, {'name': '錆び剃刀の解体者', 'text': '先制攻撃\\n萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）', 'type': 'クリーチャー — ゴブリン・戦士', 'flavor': '血汁の刃は、血の塩と錆の胡椒で味付けされ、一振りで料理と猟奇が完成する。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173980&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ac3f8555-b10b-43da-b954-da5255073423', 'multiverseId': 173980}, 'multiverseid': 173980}, {'name': 'Carniceiro da Lâmina Enferrujada', 'text': 'Iniciativa\\nMurchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)', 'type': 'Criatura — Goblin Guerreiro', 'flavor': 'A lâmina de um Mosto Sangrento é salgada com sangue e apimentada com ferrugem, temperando e abatendo num único golpe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172174&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '85a0fd6f-a6a0-4050-86ae-d174a4db9160', 'multiverseId': 172174}, 'multiverseid': 172174}, {'name': 'Мясник Ржавых Ножей', 'text': 'Первый удар\\nУвядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)', 'type': 'Существо — Гоблин Воин', 'flavor': 'Нож боггарта-кровохлеба соленый от крови и острый от резни приправа и расправа в едином взмахе.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172475&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'f55cbfe1-f345-4b4f-bf0a-618c8627191a', 'multiverseId': 172475}, 'multiverseid': 172475}, {'name': '锈刃屠夫', 'text': '先攻\\n干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）', 'type': '生物～精灵／战士', 'flavor': '血汁族的刀刃是用血当盐巴、拿锈充胡椒，只消一劈就可收调味与屠宰之效。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173077&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'eea0d697-2f3e-46cd-ae10-7372dde56c28', 'multiverseId': 173077}, 'multiverseid': 173077}]", '[{\'name\': \'Rotte von Rußwesen\', \'text\': \'Verursacht Furcht\\nStärke und Widerstandskraft der Rotte von Rußwesen sind gleich der Anzahl der schwarzen bleibenden Karten, die du kontrollierst.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Sie beneiden andere so sehr um deren lebensspendende Hitze, dass sie versuchen, sie ihnen zu entreißen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174540&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dbea8099-63d9-4f1b-81a4-9d37c54be6a8\', \'multiverseId\': 174540}, \'multiverseid\': 174540}, {\'name\': \'Companía de cenicientos\', \'text\': \'Inspirar temor.\\nTanto la fuerza como la resistencia de la Companía de cenicientos son iguales a la cantidad de permanentes negros que controlas.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Envidian tanto el calor vital que lo arrancan de los que aún lo poseen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172734&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'be86399c-8b9a-493c-80cf-4aef5e2fdc37\', \'multiverseId\': 172734}, \'multiverseid\': 172734}, {\'name\': \'Foule de scoriacés\', \'text\': "Peur\\nLa force et l\'endurance de la Foule de scoriacés sont chacune égale au nombre de permanents noirs que vous contrôlez.", \'type\': \'Créature : élémental\', \'flavor\': "Leur envie de chaleur vitale est telle qu\'ils l\'arrachent à quiconque la possède encore.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173336&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e5d09735-1fa2-4149-9f97-3464b5f68305\', \'multiverseId\': 173336}, \'multiverseid\': 173336}, {\'name\': \'Folla di Cinerei\', \'text\': \'Paura\\nLa forza e la costituzione della Folla di Cinerei sono pari al numero di permanenti neri che controlli.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'Invidiano così tanto il calore della vita che lo strappano da coloro che ancora lo possiedono.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173637&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b66b47cd-79a1-4914-9de3-508d791ea9be\', \'multiverseId\': 173637}, \'multiverseid\': 173637}, {\'name\': \'燃えがらの群集\', \'text\': \'畏怖\\n燃えがらの群集のパワーとタフネスは、それぞれあなたがコントロールする黒のパーマネントの総数に等しい。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'彼らは命を育む熱を妬む――だからそれを持つ者から引き剥がすのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173938&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5daf90dc-d32a-4d74-a01b-6e72708405c2\', \'multiverseId\': 173938}, \'multiverseid\': 173938}, {\'name\': \'Multidão de Cinzeríneos\', \'text\': \'Amedrontar\\nO poder e a resistência de Multidão de Cinzeríneos são ambos iguais ao número de permanentes pretas que você controla.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Eles cobiçam tanto o calor vitalizador que o arrancam dos que ainda o possuem.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172132&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba3f3fa8-46b8-4722-b86a-ab800dd4e2eb\', \'multiverseId\': 172132}, \'multiverseid\': 172132}, {\'name\': \'Толпа Золовиков\', \'text\': \'Страх\\nСила и выносливость Толпы Золовиков равны количеству черных перманентов под вашим контролем.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Они так сильно завидуют жизнедающему теплу, что отнимают его у всех тех, кто им еще обладает.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172433&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9b1ea50-3f8e-4e08-9174-55b354cac656\', \'multiverseId\': 172433}, \'multiverseid\': 172433}, {\'name\': \'烬身集众\', \'text\': \'恐惧\\n烬身集众的力量及防御力各等同于由你操控的黑色永久物之数量。\', \'type\': \'生物～元素\', \'flavor\': \'他们极为忌妒能给予生命的热力，甚至要从仍持有热力者之处抢过来。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173035&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'af94bed2-09f0-4068-8489-978ebb036ee1\', \'multiverseId\': 173035}, \'multiverseid\': 173035}]', '[{\'name\': \'Runen des Allvaters\', \'text\': \'Kreaturenverzauberung\\nSolange die verzauberte Kreatur rot ist, erhält sie +1/+1 und hat Doppelschlag. (Sie fügt sowohl Erstschlags- als auch normalen Kampfschaden zu.)\\nSolange die verzauberte Kreatur grün ist, erhält sie +1/+1 und verursacht Trampelschaden.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174692&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4d1d7016-aea5-4027-91fd-489a23217721\', \'multiverseId\': 174692}, \'multiverseid\': 174692}, {\'name\': \'Runas del Deus\', \'text\': \'Encantar criatura.\\nMientras la criatura encantada sea roja, obtiene +1/+1 y tiene la habilidad de dañar dos veces. (Esta criatura daña primero y también hace daño de combate normal.)\\nMientras la criatura encantada sea verde, obtiene +1/+1 y tiene la habilidad de arrollar.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172886&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'f5ff8254-42f9-421d-acdc-3f498890445b\', \'multiverseId\': 172886}, \'multiverseid\': 172886}, {\'name\': \'Runes du Deus\', \'text\': "Enchanter : créature\\nTant que la créature enchantée est rouge, elle gagne +1/+1 et elle a la double initiative. (Elle inflige des blessures de combat d\'initiative et des blessures de combat normales.)\\nTant que la créature enchantée est verte, elle gagne +1/+1 et elle a le piétinement.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173488&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e00c7fb4-a15b-4b2e-afbc-4b4e1dfa5ba8\', \'multiverseId\': 173488}, \'multiverseid\': 173488}, {\'name\': \'Rune del Dio\', \'text\': \'Incanta creatura\\nFintanto che la creatura incantata è rossa, prende +1/+1 e ha doppio attacco. (Infligge sia danno da combattimento da attacco improvviso che danno da combattimento regolare.)\\nFintanto che la creatura incantata è verde, prende +1/+1 e ha travolgere.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173789&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'365a4389-2bf4-43ba-a091-f10ef8de9301\', \'multiverseId\': 173789}, \'multiverseid\': 173789}, {\'name\': \'大神のルーン\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーが赤であるかぎり、それは＋１/＋１の修整を受けるとともに二段攻撃を持つ。 （それは先制攻撃と通常の２回の戦闘ダメージを与える。）\\nエンチャントされているクリーチャーが緑であるかぎり、それは＋１/＋１の修整を受けるとともにトランプルを持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174090&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7028867b-772f-4292-a39f-050b7e387d24\', \'multiverseId\': 174090}, \'multiverseid\': 174090}, {\'name\': \'Runas do Deus\', \'text\': \'Encantar criatura\\nEnquanto a criatura encantada for vermelha, ela receberá +1/+1 e terá golpe duplo. (Ela causa tanto o dano da iniciativa quanto o dano de combate normal.)\\nEnquanto a criatura encantada for verde, ela receberá +1/+1 e terá atropelar.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172284&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'00f32924-be7c-4296-bc94-7946e14f2dbd\', \'multiverseId\': 172284}, \'multiverseid\': 172284}, {\'name\': \'Руны Божества\', \'text\': \'Зачаровать существо\\nПока зачарованное существо красное, оно получает +1/+1 и имеет Двойной удар. (Оно наносит боевые повреждения как на этапе Первого удара, так и на этапе обычных повреждений.)\\nПока зачарованное существо зеленое, оно получает +1/+1 и имеет Пробивной удар.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172585&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'46d80d77-7a9c-46c0-8f50-3b7abd15d1df\', \'multiverseId\': 172585}, \'multiverseid\': 172585}, {\'name\': \'神明符文\', \'text\': \'生物结界\\n只要受此结界的生物是红色，它便得+1/+1且具有连击异能。 （它能造成先攻与普通战斗伤害。）\\n只要受此结界的生物是绿色，它便得+1/+1且具有践踏异能。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173187&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2c1f1271-f262-4ff3-88bb-7410ee1d8259\', \'multiverseId\': 173187}, \'multiverseid\': 173187}]', '[{\'name\': \'Runencervin-Reiter\', \'text\': \'Fliegend\\n{G/W}{G/W}: Der Runencervin-Reiter erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elf, Ritter\', \'flavor\': \'Alles, was schön ist, befindet sich ständig in Gefahr. Die Reiter bringen es in Sicherheit und retten es vor der herankriechenden Dunkelheit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174497&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'449b808b-bb36-474c-b3ff-885b89cbf951\', \'multiverseId\': 174497}, \'multiverseid\': 174497}, {\'name\': \'Jinete de cérvido rúnico\', \'text\': \'Vuela.\\n{G/W}{G/W}: El Jinete de cérvido rúnico obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Caballero elfo\', \'flavor\': \'Las cosas bellas están en constante peligro. Los jinetes las llevan a un lugar seguro, lejos de la oscuridad amenazante.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172691&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0c6c6c20-3ca0-4bc9-bb0e-18dda7fcd9c9\', \'multiverseId\': 172691}, \'multiverseid\': 172691}, {\'name\': \'Chevaucheur de cervin aux runes\', \'text\': "Vol\\n{G/W}{G/W} : Le Chevaucheur de cervin aux runes gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et chevalier\', \'flavor\': "La beauté est en péril constant. Les chevaucheurs l\'emportent pour la mettre en sécurité, devançant les ténèbres.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173293&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8d409eba-d5a7-48dc-bac7-e80bfa907d11\', \'multiverseId\': 173293}, \'multiverseid\': 173293}, {\'name\': \'Cavaliere del Cervide\', \'text\': \'Volare\\n{G/W}{G/W}: Il Cavaliere del Cervide prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Cavaliere Elfo\', \'flavor\': "Gli oggetti meravigliosi sono in pericolo costante. I cavalieri li portano al sicuro, lontano dall\'oscurità che avanza.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173594&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'56e2c8e8-0f11-46a5-8a3c-e7de3020266e\', \'multiverseId\': 173594}, \'multiverseid\': 173594}, {\'name\': \'ルーン鹿乗り\', \'text\': \'飛行\\n{G/W}{G/W}：ルーン鹿乗りはターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — エルフ・騎士\', \'flavor\': \'美を携えるものは常に危機にある。 乗り手たちは迫り来る闇に先んじて、それらを安全な場所へと動かしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173895&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f30be26-7f27-4d38-adcc-9fcce66af31f\', \'multiverseId\': 173895}, \'multiverseid\': 173895}, {\'name\': \'Ginete de Cervin Rúnico\', \'text\': \'Voar\\n{G/W}{G/W}: Ginete de Cervin Rúnico recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Elfo Cavaleiro\', \'flavor\': \'Os seres belos estão em perigo constante. Os ginetes os conduzem a lugares seguros, antecipando-se à escuridão invasora.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172089&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2e2ecf98-3035-411d-b625-8f460a5d3853\', \'multiverseId\': 172089}, \'multiverseid\': 172089}, {\'name\': \'Наездник Рунной Лани\', \'text\': \'Полет\\n{G/W}{G/W}: Наездник Рунной Лани получает +1/+1 до конца хода.\', \'type\': \'Существо — Эльф Рыцарь\', \'flavor\': \'Наделенные красотой предметы находятся под постоянной угрозой. Наездники уносят их в безопасные места, обгоняя подступающую тьму.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172390&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7c99ff5b-e1a1-4724-b7a0-fbc5001ccd22\', \'multiverseId\': 172390}, \'multiverseid\': 172390}, {\'name\': \'符驹骑兵\', \'text\': \'飞行\\n{G/W}{G/W}：符驹骑兵得+1/+1直到回合结束。\', \'type\': \'生物～地精／骑士\', \'flavor\': \'美丽事物时时面临危机。 在黑暗入侵之前，骑兵会迅速将之移入安境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172992&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bcc61e7c-e0ae-4237-ace3-a40b410fa6da\', \'multiverseId\': 172992}, \'multiverseid\': 172992}]', '[{\'name\': \'Runenverzierter Schein\', \'text\': \'Sowie der Runenverzierte Schein ins Spiel kommt, benenne eine Karte.\\nDu hast Schutz vor dem bestimmten Namen. (Nichts mit diesem Namen kann dich als Ziel bestimmen, dir Schaden zufügen oder dich verzaubern.)\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174498&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7a7cf0e-ec17-4982-8bec-fde3cf3193e1\', \'multiverseId\': 174498}, \'multiverseid\': 174498}, {\'name\': \'Halo rúnico\', \'text\': \'En cuanto el Halo rúnico entre en juego, nombra una carta.\\nTienes protección contra el nombre elegido. (No puedes ser objetivo, recibir daño o estar encantado por nada con ese nombre.)\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172692&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'835f8f7b-31e1-4a77-96e8-e2a1749d90df\', \'multiverseId\': 172692}, \'multiverseid\': 172692}, {\'name\': \'Halo serti de runes\', \'text\': \'Au moment où le Halo serti de runes arrive en jeu, nommez une carte.\\nVous avez la protection contre le nom choisi. (Vous ne pouvez pas être ciblé, blessé ou enchanté par quoi que ce soit qui a ce nom.)\', \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173294&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8b8036ae-f763-4b76-8d75-1fe258661644\', \'multiverseId\': 173294}, \'multiverseid\': 173294}, {\'name\': \'Aureola Runica\', \'text\': "Mentre l\'Aureola Runica entra in gioco, nomina una carta.\\nHai protezione dal nome scelto. (Non puoi essere bersagliato, non ti può essere inflitto danno, né puoi essere incantato da qualcosa con il nome scelto.)", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173595&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a06625e1-e905-4b6c-8c02-554960dcb22f\', \'multiverseId\': 173595}, \'multiverseid\': 173595}, {\'name\': \'ルーンの光輪\', \'text\': \'ルーンの光輪が場に出るに際し、カード名を１つ指定する。\\nあなたは選ばれたカード名に対するプロテクションを持つ。 （あなたはそのカード名を持つものから対象にならず、ダメージを与えられず、エンチャントされない。）\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173896&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2d75670c-7a20-4153-9872-be20a7d06eb7\', \'multiverseId\': 173896}, \'multiverseid\': 173896}, {\'name\': \'Auréola Rúnica\', \'text\': \'Conforme Auréola Rúnica entra em jogo, nomeie um card.\\nVocê tem proteção contra o nome escolhido. (Você não pode ser alvo, sofrer dano nem ser encantado por nada com aquele nome.)\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172090&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'dac9bebb-76a0-4a5e-8db1-214fff5caee0\', \'multiverseId\': 172090}, \'multiverseid\': 172090}, {\'name\': \'Рунный Нимб\', \'text\': \'При входе Рунного Нимба в игру назовите карту.\\nВы имеете Защиту от выбранного имени. (Ни один объект с тем именем не может сделать вас целью, нанести вам повреждения или зачаровать.)\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172391&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d0ff4488-e101-4c77-8cdb-604c68dd63c7\', \'multiverseId\': 172391}, \'multiverseid\': 172391}, {\'name\': \'符文光晕\', \'text\': \'于符文光晕进场时，说出一个牌名。\\n你具有反该名称保护异能。 （你不能被该名称的东西指定为目标，造成伤害，或是被结附）\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172993&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'708111d1-3fbf-4292-8465-d4eb9ce7dbb0\', \'multiverseId\': 172993}, \'multiverseid\': 172993}]', '[{\'name\': \'Rußiger Anfacher\', \'text\': \'Eile\\n{T}: Eine schwarze oder rote Kreatur deiner Wahl erhält Eile bis zum Ende des Zuges.\', \'type\': \'Kreatur — Elementarwesen, Schamane\', \'flavor\': \'„Nichts erwärmt mein Herz mehr als ein Geist, der vor Zorn glüht."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174672&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'762af5a9-93ad-42fd-a7d8-feace7bed489\', \'multiverseId\': 174672}, \'multiverseid\': 174672}, {\'name\': \'Avivadora de hollín\', \'text\': \'Prisa.\\n{T}: La criatura objetivo negra o roja gana la habilidad de prisa hasta el final del turno.\', \'type\': \'Criatura — Chamán elemental\', \'flavor\': \'"Nada me enternece más que un espíritu encendido de furia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172866&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'44238af1-608d-426c-97e6-96c5b12d724d\', \'multiverseId\': 172866}, \'multiverseid\': 172866}, {\'name\': \'Embraseur chauffesuie\', \'text\': "Célérité\\n{T} : La créature noire ou rouge ciblée acquiert la célérité jusqu\'à la fin du tour.", \'type\': \'Créature : élémental et shamane\', \'flavor\': "« Rien ne me réchauffe plus le cœur qu\'un esprit attisé par la rage. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173468&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1a26c8e6-d372-4710-9697-ba569e40225e\', \'multiverseId\': 173468}, \'multiverseid\': 173468}, {\'name\': \'Attizzafuliggine\', \'text\': \'Rapidità\\n{T}: Una creatura rossa o nera bersaglio ha rapidità fino alla fine del turno.\', \'type\': \'Creatura — Sciamano Elementale\', \'flavor\': \'"Niente scalda il mio cuore più di uno spirito acceso dall\\\'ira."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173769&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fda552ef-2cac-414f-b8a3-c536716906af\', \'multiverseId\': 173769}, \'multiverseid\': 173769}, {\'name\': \'煤の焚きつけ屋\', \'text\': \'速攻\\n{T}：黒か赤のクリーチャー１体を対象とする。それはターン終了時まで速攻を得る。\', \'type\': \'クリーチャー — エレメンタル・シャーマン\', \'flavor\': \'「怒りに燃え上がった精霊ぐらい、俺の心を暖めるものはない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174070&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3bc915c6-0e34-453d-a9ff-09d09f103d22\', \'multiverseId\': 174070}, \'multiverseid\': 174070}, {\'name\': \'Atiça-Fuligem\', \'text\': \'Ímpeto\\n{T}: A criatura alvo preta ou vermelha ganha ímpeto até o final do turno.\', \'type\': \'Criatura — Elemental Xamã\', \'flavor\': \'"Nada aquece mais meu coração que um espírito iluminado pela raiva."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172264&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'57ebf92f-afda-4dc1-85c3-bd5398b0a031\', \'multiverseId\': 172264}, \'multiverseid\': 172264}, {\'name\': \'Разжигательница Страстей\', \'text\': \'Ускорение\\n{T}: целевое черное или красное существо получает Ускорение до конца хода.\', \'type\': \'Существо — Элементаль Шаман\', \'flavor\': \'«Ничто так не согревает мое сердце, как распаленный яростью дух».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172565&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bf5b630c-7648-4669-b484-c76981ed5f9b\', \'multiverseId\': 172565}, \'multiverseid\': 172565}, {\'name\': \'燎烬师\', \'text\': \'敏捷\\n{T}：目标黑色或红色生物获得敏捷异能直到回合结束。\', \'type\': \'生物～元素／祭师\', \'flavor\': \'「被愤怒点燃的灵魂最能温暖我的心。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173167&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a44d8f6a-91c5-4445-8108-ac1c680ec3e7\', \'multiverseId\': 173167}, \'multiverseid\': 173167}]', "[{'name': 'Rußknochen', 'text': 'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\n{1}{B}: Regeneriere die Rußknochen.', 'type': 'Kreatur — Elementarwesen, Skelett', 'flavor': 'Nicht alle Kohlestücke liegen in ihren Betten aus kalter Asche.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174536&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4d2455f5-b6e6-4808-85fd-8cf66bb48a29', 'multiverseId': 174536}, 'multiverseid': 174536}, {'name': 'Huesos cenicientos', 'text': 'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\\n{1}{B}: Regenera los Huesos cenicientos.', 'type': 'Criatura — Esqueleto elemental', 'flavor': 'No todos los carbones se quedan quietos en sus lechos de cenizas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172730&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b6327907-02bd-4706-92c0-e8b20a3f2d14', 'multiverseId': 172730}, 'multiverseid': 172730}, {'name': 'Scoriacios', 'text': 'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\n{1}{B} : Régénérez le Scoriacios.', 'type': 'Créature : élémental et squelette', 'flavor': 'Toutes les braises ne dorment pas dans leur lit de cendres froides.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173332&type=card', 'language': 'French', 'identifiers': {'scryfallId': '4656f05d-a450-43de-857d-21c7b5665537', 'multiverseId': 173332}, 'multiverseid': 173332}, {'name': 'Scheletro Cinereo', 'text': 'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\n{1}{B}: Rigenera lo Scheletro Cinereo.', 'type': 'Creatura — Scheletro Elementale', 'flavor': 'Non tutto il carbone giace quieto nel suo letto di fredda cenere.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173633&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '2202c75f-2eef-4980-9bee-5a21dce4cc7e', 'multiverseId': 173633}, 'multiverseid': 173633}, {'name': '燃えがら骨', 'text': '萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\n{1}{B}：燃えがら骨を再生する。', 'type': 'クリーチャー — エレメンタル・スケルトン', 'flavor': 'すべての石炭が、冷たい灰床でおとなしくしているわけではない。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173934&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '59869323-bd51-46f1-8a01-48481a850739', 'multiverseId': 173934}, 'multiverseid': 173934}, {'name': 'Cinzeríneo Esquelético', 'text': 'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\\n{1}{B}: Regenere Cinzeríneo Esquelético.', 'type': 'Criatura — Elemental Esqueleto', 'flavor': 'Nem todos os carvões permanecem imóveis em seus estratos de cinzas frias.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172128&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '34a15612-0ef4-4ffb-a636-24c19820438f', 'multiverseId': 172128}, 'multiverseid': 172128}, {'name': 'Истлевший Золовик', 'text': 'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\\n{1}{B}: регенерируйте Истлевшего Золовика.', 'type': 'Существо — Элементаль Скелет', 'flavor': 'Не все угли лежат спокойно на остывшем пепелище.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172429&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b4ed5882-088b-4452-af20-a9c461579b7f', 'multiverseId': 172429}, 'multiverseid': 172429}, {'name': '骨烬身', 'text': '干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\\n{1}{B}：重生骨烬身。', 'type': '生物～元素／骷髅妖', 'flavor': '并非所有煤块都会安静躺在自己冷冰冰的煤床上。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173031&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'd125b6c3-0c5f-4769-b717-7e17746c5510', 'multiverseId': 173031}, 'multiverseid': 173031}]", '[{\'name\': \'Rußschleierschurke\', \'text\': \'{T}: Ein Spieler deiner Wahl wirft eine Karte aus seiner Hand ab. Spiele diese Fähigkeit nur während deines Zuges.\\nLege eine -1/-1-Marke auf den Rußschleierschurken: Enttappe den Rußschleierschurken.\', \'type\': \'Kreatur — Elementarwesen, Schamane\', \'flavor\': \'Dicker Rauch wabert und verformt sich zu beunruhigenden, kichernden Gesichtern mit klappernden Zähnen aus aufplatzenden Kohlen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174537&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9f10f4f3-5289-40b0-966e-80613dc9b79f\', \'multiverseId\': 174537}, \'multiverseid\': 174537}, {\'name\': \'Engendro bruma cenicienta\', \'text\': \'{T}: El jugador objetivo descarta una carta. Juega esta habilidad sólo durante tu turno.\\nPoner un contador -1/-1 sobre el Engendro bruma cenicienta: Endereza el Engendro bruma cenicienta.\', \'type\': \'Criatura — Chamán elemental\', \'flavor\': \'Un humo denso ondula y se retuerce formando rostros perturbadores que carcajean y rechinan sus dientes a las brasas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172731&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6682cf3c-58b0-4148-a275-411d5a3c0f79\', \'multiverseId\': 172731}, \'multiverseid\': 172731}, {\'name\': \'Misérable scoriacé enfumé\', \'text\': "{T} : Le joueur ciblé se défausse d\'une carte. Ne jouez cette capacité que pendant votre tour.\\nMettez un marqueur -1/-1 sur le Misérable scoriacé enfumé : Dégagez le Misérable scoriacé enfumé.", \'type\': \'Créature : élémental et shamane\', \'flavor\': "L\'épaisse fumée tourbillonne pour former de dérangeants visages caquetants aux dents de braise.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173333&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'559c70c3-5cbc-48a3-a6c7-ca2e9b943d23\', \'multiverseId\': 173333}, \'multiverseid\': 173333}, {\'name\': \'Corruttore Incendiario\', \'text\': \'{T}: Un giocatore bersaglio scarta una carta. Gioca questa abilità solo durante il tuo turno.\\nMetti un segnalino -1/-1 sul Corruttore Incendiario: STAPpa il Corruttore Incendiario.\', \'type\': \'Creatura — Sciamano Elementale\', \'flavor\': \'Una spessa fuliggine ondeggia e vortica originando inquietanti volti che sghignazzano e serrano i denti attorno alle braci scoppiettanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173634&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'934adac7-cab3-424c-a2d3-50164bc8db8d\', \'multiverseId\': 173634}, \'multiverseid\': 173634}, {\'name\': \'燃えがらもやの卑劣漢\', \'text\': \'{T}：プレイヤー１人を対象とする。そのプレイヤーはカードを１枚捨てる。この能力はあなたのターンにのみプレイできる。\\n燃えがらもやの卑劣漢の上に－１/－１カウンターを１個置く：燃えがらもやの卑劣漢をアンタップする。\', \'type\': \'クリーチャー — エレメンタル・シャーマン\', \'flavor\': \'濃い煙はうねりねじれながら、はぜる燃えさしの上に現れる歯をガタガタ鳴らす顔を成していく。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173935&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'693b5b85-4110-496d-b339-31a68dd93995\', \'multiverseId\': 173935}, \'multiverseid\': 173935}, {\'name\': \'Miserável Cinerobruma\', \'text\': \'{T}: O jogador alvo descarta um card. Jogue esta habilidade somente durante seu turno.\\nColoque um marcador -1/-1 em Miserável Cinerobruma: Desvire Miserável Cinerobruma.\', \'type\': \'Criatura — Elemental Xamã\', \'flavor\': \'Uma fumaça densa se contorce em ondas, criando rostos perturbadores que dão gargalhadas e rangem os dentes para as espirais de fumaça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172129&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd74410f-42aa-4557-b0d4-c6b732ab7c6b\', \'multiverseId\': 172129}, \'multiverseid\': 172129}, {\'name\': \'Дымящий Отравой Золовик\', \'text\': \'{T}: целевой игрок сбрасывает карту. Разыгрывайте эту способность только во время вашего хода.\\nПоложите один жетон -1/-1 на Дымящего Отравой Золовика: разверните Дымящего Отравой Золовика.\', \'type\': \'Существо — Элементаль Шаман\', \'flavor\': \'Густой дым клубится и принимает жуткие формы лиц, которые противно смеются и щелкают зубами в такт потрескивающим уголькам.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172430&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'32080841-5bea-4620-aca6-63b1e1ccfae3\', \'multiverseId\': 172430}, \'multiverseid\': 172430}, {\'name\': \'卑劣雾烬身\', \'text\': \'{T}：目标牌手弃一张牌。你只可以于你的回合中使用此异能。\\n在卑劣雾烬身上放置一个-1/-1指示物：重置卑劣雾烬身。\', \'type\': \'生物～元素／祭师\', \'flavor\': \'浓雾嘶吼、扭曲成古怪面孔，放声尖笑时喷出如牙烬火。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173032&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'56ee9a17-4bef-4e33-b8ac-8914ab1707bb\', \'multiverseId\': 173032}, \'multiverseid\': 173032}]', '[{\'name\': \'Rußwanderer\', \'text\': \'Der Rußwanderer kann von weißen Kreaturen nicht geblockt werden.\', \'type\': \'Kreatur — Elementarwesen, Räuber\', \'flavor\': \'„Warum sollen die Feuer von anderen brennen, wenn unsere es nicht tun? Warum sollen sie zufrieden sein, während wir leiden? Wenn es Elend geben muss, dann wollen wir es mit allen teilen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174673&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6940153a-27fb-4d0d-b3d7-e4679baae8e9\', \'multiverseId\': 174673}, \'multiverseid\': 174673}, {\'name\': \'Caminantes de hollín\', \'text\': \'Los Caminantes de hollín no pueden ser bloqueados por criaturas blancas.\', \'type\': \'Criatura — Bribón elemental\', \'flavor\': \'"¿Por qué permitir que ardan los fuegos de otros y los nuestros no? ¿Por qué dejarlos contentos, mientras nosotros sufrimos? Si habrá miseria, que sea para todos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172867&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fd03cece-7112-4433-a239-4d7898a6ecbe\', \'multiverseId\': 172867}, \'multiverseid\': 172867}, {\'name\': \'Marchesuies\', \'text\': \'Les Marchesuies ne peuvent pas être bloqués par les créatures blanches.\', \'type\': \'Créature : élémental et gredin\', \'flavor\': "« Pourquoi permettre aux feux des autres de bruler, quand les nôtres sont éteints ? Pourquoi supporter leur joie alors que nous souffrons ? Si misère il y a, qu\'elle soit partagée. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173469&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1047020b-9f69-4c77-b5cc-30cda85ae81c\', \'multiverseId\': 173469}, \'multiverseid\': 173469}, {\'name\': \'Erranti della Fuliggine\', \'text\': \'Gli Erranti della Fuliggine non possono essere bloccati dalle creature bianche.\', \'type\': \'Creatura — Farabutto Elementale\', \'flavor\': \'"Perché permettere alle fiamme degli altri di bruciare, quando le nostre non lo fanno? Perché lasciarli allegri, mentre noi soffriamo? Se qui regna la miseria, portiamola a tutti."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173770&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a1f9e701-def3-461f-812a-29e2da2f73bb\', \'multiverseId\': 173770}, \'multiverseid\': 173770}, {\'name\': \'煤歩き\', \'text\': \'煤歩きは白のクリーチャーによってはブロックされない。\', \'type\': \'クリーチャー — エレメンタル・ならず者\', \'flavor\': \'「他の奴の火は燃やすことができるのに、なぜ我々のはだめなんだ？ なぜ奴らは満たされ、我々は苦しむんだ？ こんな苦難があるのなら、みんなに味わわせてやる。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174071&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'04459df3-1242-415c-a5e4-e15d66194a29\', \'multiverseId\': 174071}, \'multiverseid\': 174071}, {\'name\': \'Andarilhos da Fuligem\', \'text\': \'Andarilhos da Fuligem não pode ser bloqueado por criaturas brancas.\', \'type\': \'Criatura — Elemental Ladino\', \'flavor\': \'"Por que permitir que a chama dos outros ardam se a nossa não o faz? Por que deixá-los contentes enquanto nós sofremos? Se deve haver sofrimento, que seja suportado por todos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172265&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8dc7f150-2d62-4498-aa6d-ea123062ecbc\', \'multiverseId\': 172265}, \'multiverseid\': 172265}, {\'name\': \'Пепельные Странники\', \'text\': \'Пепельные Странники не могут быть заблокированы белыми существами.\', \'type\': \'Существо — Элементаль Бродяга\', \'flavor\': \'«С какой стати позволять чужому огню гореть, когда наш гореть не может? С какой стати другие будут радоваться, когда мы мучаемся? Если уж есть страдание, так пусть оно будет для всех».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172566&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'24b39cb6-163d-4464-9149-1d98127b1d87\', \'multiverseId\': 172566}, \'multiverseid\': 172566}, {\'name\': \'煤烟行者\', \'text\': \'煤烟行者不能被白色生物阻挡。\', \'type\': \'生物～元素／浪客\', \'flavor\': \'「既然我们无火可燃，为何要让其他人能烧？ 我们处境悲惨，为何要让其他人安逸？ 既然世间有痛苦，就该让所有人分担。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173168&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9dc91532-acd0-4464-9057-c10c6ba7f704\', \'multiverseId\': 173168}, \'multiverseid\': 173168}]', '[{\'name\': \'Rücksichtsloser Mentor\', \'text\': \'Grüne Kreaturen, die du kontrollierst, verursachen Trampelschaden.\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': \'Er hörte weder die Schreie der Baumhirten, deren Äste er abbrach, noch die der Elfen, die er zertrat. Er hatte nur Augen für den Weg, der vor ihm lag.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174605&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8c549a96-2601-4822-9235-9827ce4962b5\', \'multiverseId\': 174605}, \'multiverseid\': 174605}, {\'name\': \'Mentor atropellador\', \'text\': \'Las criaturas verdes que controlas tienen la habilidad de arrollar.\', \'type\': \'Criatura — Guerrero gigante\', \'flavor\': \'No escucha los lamentos de los arbóreos cuyas ramas parte, o de los elfos atrapados bajo sus pies. Sólo tiene ojos para el camino.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172799&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ab1cb2f-b15b-4154-a129-93c8d6872a52\', \'multiverseId\': 172799}, \'multiverseid\': 172799}, {\'name\': \'Mentor impérieux\', \'text\': \'Les créatures vertes que vous contrôlez ont le piétinement.\', \'type\': \'Créature : géant et guerrier\', \'flavor\': "Il n\'entendait pas les cris des sylvins dont il brisait les branches, ou des elfes qu\'il piétinait. Il n\'avait d\'yeux que pour sa voie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173401&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed7543fe-6ae3-4114-9612-00656dbda92e\', \'multiverseId\': 173401}, \'multiverseid\': 173401}, {\'name\': \'Mentore Dispotico\', \'text\': \'Le creature verdi che controlli hanno travolgere.\', \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': \'Non udì le urla dei silvantropi a cui spezzava i rami, né quelle degli elfi che calpestava. Aveva occhi solo per il cammino dinanzi a sé.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173702&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d84b1372-2d38-409c-9ca8-d78101fb6500\', \'multiverseId\': 173702}, \'multiverseid\': 173702}, {\'name\': \'非道な導師\', \'text\': \'あなたがコントロールする緑のクリーチャーはトランプルを持つ。\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': \'彼には、自分が枝を折った樹人の悲鳴も、踏み潰したエルフの泣き声も聞こえなかった。 彼が見ていたのはこの先の道だけだった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174003&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad552dbe-dc3f-4ec0-8034-78d0a63c1870\', \'multiverseId\': 174003}, \'multiverseid\': 174003}, {\'name\': \'Mentor Grosseirão\', \'text\': \'As criaturas verdes que você controla têm atropelar.\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': \'Ele não ouviu os gritos dos ents cujos galhos arrancava, nem dos elfos que esmagava sob seus pés. Ele via somente o caminho à sua frente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172197&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21d1c932-04ee-454b-aac8-70f87d60d6f8\', \'multiverseId\': 172197}, \'multiverseid\': 172197}, {\'name\': \'Деспотичный Наставник\', \'text\': \'Зеленые существа под вашим контролем имеют Пробивной удар.\', \'type\': \'Существо — Гигант Воин\', \'flavor\': \'Он не слышал ни криков лесовиков, чьи ветви он слепо обламывал, ни воплей эльфов, попадавших ему под ноги. Он видел только тропу впереди себя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172498&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9ac34f7a-afd0-4cb6-950e-86c04a333ba9\', \'multiverseId\': 172498}, \'multiverseid\': 172498}, {\'name\': \'凶横明师\', \'text\': \'由你操控的绿色生物具有践踏异能。\', \'type\': \'生物～巨人／战士\', \'flavor\': \'他听不到树枝被其折断之树妖哀嚎，也听不到脚板下给他踩到的地精惨号。 他眼睛只顾着看前方的路。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173100&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d79f1fb2-1e6c-40ea-806b-3ee3dec6d3a8\', \'multiverseId\': 173100}, \'multiverseid\': 173100}]', '[{\'name\': \'Samenschaukelhexe\', \'text\': \'{2}{G}{W}: Eine Kreatur deiner Wahl erhält +3/+3 bis zum Ende des Zuges. Enttappe diese Kreatur.\', \'type\': \'Kreatur — Elf, Schamane\', \'flavor\': \'Im Flüsterton betete sie um Stärke, und ihre Wünsche wehten wie Samen im Wind fort.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174718&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'982ca064-0c42-4a97-bd88-c3f66d946100\', \'multiverseId\': 174718}, \'multiverseid\': 174718}, {\'name\': \'Bruja cuna de semillas\', \'text\': \'{2}{G}{W}: La criatura objetivo obtiene +3/+3 hasta el final del turno. Endereza esa criatura.\', \'type\': \'Criatura — Chamán elfo\', \'flavor\': \'Susurró una plegaria pidiendo fuerza, y sus deseos volaron como semillas en el viento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172912&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7012c833-1847-441a-87e3-8aebc7cd4c00\', \'multiverseId\': 172912}, \'multiverseid\': 172912}, {\'name\': \'Envoûteuse bercegraine\', \'text\': "{2}{G}{W} : La créature ciblée gagne +3/+3 jusqu\'à la fin du tour. Dégagez cette créature.", \'type\': \'Créature : elfe et shamane\', \'flavor\': "Elle murmura une prière de force, et ses souhaits s\'envolèrent comme des graines portées par le vent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173514&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e0e2af7e-3148-492e-b27d-53963967a7da\', \'multiverseId\': 173514}, \'multiverseid\': 173514}, {\'name\': \'Strega della Culla dei Semi\', \'text\': \'{2}{G}{W}: Una creatura bersaglio prende +3/+3 fino alla fine del turno. STAPpa quella creatura.\', \'type\': \'Creatura — Sciamano Elfo\', \'flavor\': \'Sussurrò una preghiera fortificatrice, ma i suoi desideri si sparpagliarono come semi al vento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173815&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b323bac-7e6b-4a75-84e7-1350dafa2eac\', \'multiverseId\': 173815}, \'multiverseid\': 173815}, {\'name\': \'種かごの魔女\', \'text\': \'{2}{G}{W}：クリーチャー１体を対象とする。それはターン終了時まで＋３/＋３の修整を受ける。 そのクリーチャーをアンタップする。\', \'type\': \'クリーチャー — エルフ・シャーマン\', \'flavor\': \'彼女は力への祈りを囁き、彼女の願いは風に舞う種のように漂っていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174116&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4ce71797-d882-4e26-9fa3-167c9ce982ad\', \'multiverseId\': 174116}, \'multiverseid\': 174116}, {\'name\': \'Bruxa Semeadora\', \'text\': \'{2}{G}{W}: A criatura alvo recebe +3/+3 até o final do turno. Desvire aquela criatura.\', \'type\': \'Criatura — Elfo Xamã\', \'flavor\': \'Ela sussurrou uma reza para obter força, e seus desejos espalharam-se como sementes ao vento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172310&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bd538252-ec8a-49d5-b73b-f4f4310d2100\', \'multiverseId\': 172310}, \'multiverseid\': 172310}, {\'name\': \'Ведьма-Покровительница\', \'text\': \'{2}{G}{W}: целевое существо получает +3/+3 до конца хода. Разверните то существо.\', \'type\': \'Существо — Эльф Шаман\', \'flavor\': \'Она прошептала молитву, прося силы, и ее желания унеслись вдаль, как семена на ветру.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172611&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55f7707a-02c1-4aa3-8ccb-d9c7874a8fff\', \'multiverseId\': 172611}, \'multiverseid\': 172611}, {\'name\': \'育苗法术师\', \'text\': \'{2}{G}{W}：目标生物得+3/+3直到回合结束。 重置该生物。\', \'type\': \'生物～地精／祭师\', \'flavor\': \'她悄声祈求力量，而此愿望如种子随风飘散。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173213&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c52dfac0-28a7-46ad-86ed-53ddccea893b\', \'multiverseId\': 173213}, \'multiverseid\': 173213}]', '[{\'name\': \'Sanitäter aus Barrenton\', \'text\': \'{T}: Verhindere den nächsten 1 Schadenspunkt, der in diesem Zug einer Kreatur oder einem Spieler deiner Wahl zugefügt würde.\\nLege eine -1/-1-Marke auf den Sanitäter aus Barrenton: Enttappe den Sanitäter aus Barrenton.\', \'type\': \'Kreatur — Kithkin, Kleriker\', \'flavor\': \'Er träumt nur noch von giftigem Pulver und klirrenden Fläschchen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174481&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dc68e12b-5f31-42d6-b771-0906d982316a\', \'multiverseId\': 174481}, \'multiverseid\': 174481}, {\'name\': \'Médico de Bárrenton\', \'text\': \'{T}: Prevén el siguiente 1 punto de daño que se le fuera a hacer a la criatura o jugador objetivo este turno.\\nPon un contador -1/-1 sobre el Médico de Bárrenton: Endereza el Médico de Bárrenton.\', \'type\': \'Criatura — Clérigo kithkin\', \'flavor\': \'Sus sueños están llenos de polvos nocivos y viales ruidosos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172675&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01270856-6cfa-4b55-a8e4-ef131581b6f6\', \'multiverseId\': 172675}, \'multiverseid\': 172675}, {\'name\': \'Carabin de Barrenton\', \'text\': \'{T} : Prévenez, ce tour-ci, la prochaine 1 blessure qui devrait être infligée à une cible, créature ou joueur.\\nMettez un marqueur -1/-1 sur le Carabin de Barrenton : Dégagez le Carabin de Barrenton.\', \'type\': \'Créature : sangami et clerc\', \'flavor\': "Ses rêves sont peuplés de poudres malodorantes et de fioles qui s\'entrechoquent.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173277&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'41d67723-a401-44fc-8080-0dbdc56d0699\', \'multiverseId\': 173277}, \'multiverseid\': 173277}, {\'name\': \'Medico di Barrenton\', \'text\': \'{T}: Previeni il prossimo punto danno che verrebbe inflitto a una creatura o a un giocatore bersaglio in questo turno.\\nMetti un segnalino -1/-1 sul Medico di Barrenton: STAPpa il Medico di Barrenton.\', \'type\': \'Creatura — Chierico Kithkin\', \'flavor\': \'I suoi sogni sono pieni di polveri nocive e fiale tintinnanti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173578&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'98329ce1-195b-4430-b30f-418f878d12de\', \'multiverseId\': 173578}, \'multiverseid\': 173578}, {\'name\': \'バレントンの衛生兵\', \'text\': \'{T}：クリーチャー１体かプレイヤー１人を対象とする。このターン、次にそれに与えられるダメージを１点軽減する。\\nバレントンの衛生兵の上に－１/－１カウンターを１個置く：バレントンの衛生兵をアンタップする。\', \'type\': \'クリーチャー — キスキン・クレリック\', \'flavor\': \'彼の夢は毒の粉とカラカラ鳴る瓶とで満たされている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173879&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5774e5ef-a514-4ade-a10f-be2bcaa25a44\', \'multiverseId\': 173879}, \'multiverseid\': 173879}, {\'name\': \'Médico de Barrenton\', \'text\': \'{T}: Previna o próximo 1 ponto de dano que seria causado à criatura ou ao jogador alvo neste turno.\\nColoque um marcador -1/-1 em Médico de Barrenton: Desvire Médico de Barrenton.\', \'type\': \'Criatura — Kithkin Clérigo\', \'flavor\': \'Seus sonhos são repletos de pós nocivos e do retinir de frascos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172073&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fc4129d8-dbff-4d5e-bfa3-67afe1633eeb\', \'multiverseId\': 172073}, \'multiverseid\': 172073}, {\'name\': \'Баррентонский Медик\', \'text\': \'{T}: предотвратите следующее 1 повреждение, которое будет нанесено целевому существу или игроку в этом ходу.\\nПоложите один жетон -1/-1 на Баррентонского Медика: разверните Баррентонского Медика.\', \'type\': \'Существо — Кискен Священник\', \'flavor\': \'В его снах лишь ядовитые порошки да звон склянок.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172374&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5460d8ed-9acc-48c8-88bf-508ce0359977\', \'multiverseId\': 172374}, \'multiverseid\': 172374}, {\'name\': \'八连屯医护员\', \'text\': \'{T}：于本回合中，防止接下来将对目标生物或牌手造成的1点伤害。\\n在八连屯医护员上放置一个-1/-1指示物：重置八连屯医护员。\', \'type\': \'生物～洁英／僧侣\', \'flavor\': \'他的梦境充满了毒粉与当啷作响的药瓶。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172976&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'dac9138f-e3c8-4a46-8130-20f6e63e564a\', \'multiverseId\': 172976}, \'multiverseid\': 172976}]', '[{\'name\': \'Schattenhafter Mantel\', \'text\': \'Die ausgerüstete Kreatur hat „{3}, {Q}: Diese Kreatur erhält +2/+2 bis zum Ende des Zuges." ({Q} ist das Enttappsymbol.)\\nAusrüsten {0}\', \'type\': \'Artefakt — Ausrüstung\', \'flavor\': \'Er bändigt die Kraft der Nacht in einem Land, wo sich das Tageslicht kaum durchzudringen traut.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174744&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e8148c7-3398-48f9-aeba-f19b4b8fcbfc\', \'multiverseId\': 174744}, \'multiverseid\': 174744}, {\'name\': \'Manto umbral\', \'text\': \'La criatura equipada tiene "{3}, {Q}: Esta criatura obtiene +2/+2 hasta el final del turno". ({Q} es el símbolo de enderezar.)\\nEquipar {0}.\', \'type\': \'Artefacto — Equipo\', \'flavor\': \'Domina el poder de la noche en una tierra donde la luz del día tiene miedo de mostrarse.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172938&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8ec8301c-f7cc-47db-8547-a407e25b6973\', \'multiverseId\': 172938}, \'multiverseid\': 172938}, {\'name\': "Manteau d\'ombre", \'text\': "La créature équipée a « {3}, {Q} : Cette créature gagne +2/+2 jusqu\'à la fin du tour. » ({Q} est le symbole de dégagement.)\\nÉquipement {0}", \'type\': \'Artefact : équipement\', \'flavor\': \'Il utilise la puissance de la nuit dans un monde où la lumière du jour craint de se montrer.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173540&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ef3c25a5-5d70-4da0-915f-2320feb13e3f\', \'multiverseId\': 173540}, \'multiverseid\': 173540}, {\'name\': "Mantello d\'Ombra", \'text\': \'La creatura equipaggiata ha "{3}, {Q}: Questa creatura prende +2/+2 fino alla fine del turno." ({Q} è il simbolo di STAP.)\\nEquipaggiare {0}\', \'type\': \'Artefatto — Equipaggiamento\', \'flavor\': \'Imbriglia il potere della notte in una terra dove la luce del sole ha paura di mostrarsi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173841&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'de9e3ad0-5943-4990-ba26-02394b584dbf\', \'multiverseId\': 173841}, \'multiverseid\': 173841}, {\'name\': \'暗黒のマントル\', \'text\': \'装備しているクリーチャーは「{3}, {Q}：このクリーチャーはターン終了時まで＋２/＋２の修整を受ける。」を持つ。 （{Q}はアンタップ・シンボルである。）\\n装備 {0}\', \'type\': \'アーティファクト — 装備品\', \'flavor\': \'それは陽の光すら恐れて姿を見せない地の夜の力をつなぎ止めている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174142&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'707a4785-48a2-4d68-aa27-b4ae7916c970\', \'multiverseId\': 174142}, \'multiverseid\': 174142}, {\'name\': \'Manto Umbral\', \'text\': \'A criatura equipada tem "{3}, {Q}: Esta criatura recebe +2/+2 até o final do turno." ({Q} é o símbolo de desvirar.)\\nEquipar {0}\', \'type\': \'Artefato — Equipamento\', \'flavor\': \'Ele controla o poder da noite numa terra onde a luz do dia tem medo de se mostrar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172336&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'397f1f6f-206c-43a1-a523-c182e39cbe88\', \'multiverseId\': 172336}, \'multiverseid\': 172336}, {\'name\': \'Мантия Тени\', \'text\': \'Снаряженное существо имеет способность «{3}, {Q}: это существо получает +2/+2 до конца хода». ({Q} символ разворота карты.)\\nСнарядить {0}\', \'type\': \'Артефакт — Снаряжение\', \'flavor\': \'Она укрощает силу ночи в краю, где дневной свет боится показаться.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172637&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'42f135ba-aa14-421a-b367-bc980102f225\', \'multiverseId\': 172637}, \'multiverseid\': 172637}, {\'name\': \'暗影披风\', \'text\': \'佩带此武具的生物具有「{3}，{Q}：此生物得+2/+2直到回合结束。」 （{Q}是重置符号。）\\n佩带{0}\', \'type\': \'神器～武具\', \'flavor\': \'在日光羞于见人的大地，它充分利用了黑夜力量。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173239&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'81b88e45-5dfe-4989-b397-6c764350e735\', \'multiverseId\': 173239}, \'multiverseid\': 173239}]', '[{\'name\': \'Schauderfürst des Wandertriebs\', \'text\': \'Der Schauderfürst des Wandertriebs ist unblockbar.\\nImmer wenn der Schauderfürst des Wandertriebs einem Spieler Kampfschaden zufügt, zeigt dieser Spieler die Karten auf seiner Hand offen vor. Bestimme eine Karte davon. Dieser Spieler entfernt diese Karte ganz aus dem Spiel.\', \'type\': \'Kreatur — Geist, Avatar\', \'flavor\': \'„Er ist ein Geist, der nie das Leben kennen gelernt hat." —Die Parabeln der Seherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174639&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'fb77ded4-775e-4abb-8193-9ffd41331d76\', \'multiverseId\': 174639}, \'multiverseid\': 174639}, {\'name\': \'Señor espectral de la amnesia\', \'text\': \'El Señor espectral de la amnesia es imbloqueable.\\nSiempre que el Señor espectral de la amnesia haga daño de combate a un jugador, ese jugador muestra su mano. Elige una carta de ahí. Ese jugador remueve del juego esa carta.\', \'type\': \'Criatura — Espíritu avatar\', \'flavor\': \'"Es un fantasma que nunca estuvo vivo." —Las parábolas de la vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172833&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb82bdf4-7774-44bd-a2ca-ca2227494d9b\', \'multiverseId\': 172833}, \'multiverseid\': 172833}, {\'name\': \'Seigneur pâle de la Fugue\', \'text\': \'Le Seigneur pâle de la Fugue est imblocable.\\nÀ chaque fois que le Seigneur pâle de la Fugue inflige des blessures de combat à un joueur, ce joueur révèle sa main. Choisissez-y une carte. Ce joueur retire cette carte de la partie.\', \'type\': \'Créature : esprit et avatar\', \'flavor\': "« C\'est un fantôme qui n\'a jamais connu la vie. » —Les paraboles de l\'Oracle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173435&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'456a73ea-9936-45f0-a664-d64bbf036828\', \'multiverseId\': 173435}, \'multiverseid\': 173435}, {\'name\': "Tetro Signore dell\'Evasione", \'text\': "Il Tetro Signore dell\'Evasione non può essere bloccato.\\nOgniqualvolta il Tetro Signore dell\'Evasione infligge danno da combattimento a un giocatore, quel giocatore rivela la sua mano. Scegli una carta da essa. Quel giocatore rimuove dal gioco quella carta.", \'type\': \'Creatura — Spirito Avatar\', \'flavor\': \'"È un fantasma che non ha mai conosciuto la vita." —Le Parabole della Veggente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173736&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'66092f6d-1013-48c7-9134-a39b4be135f5\', \'multiverseId\': 173736}, \'multiverseid\': 173736}, {\'name\': \'遁走の恐君主\', \'text\': \'遁走の恐君主はブロックされない。\\n遁走の恐君主がいずれかのプレイヤーに戦闘ダメージを与えるたび、そのプレイヤーは自分の手札を公開する。 そのうちのカードを１枚選ぶ。 そのプレイヤーはそのカードをゲームから取り除く。\', \'type\': \'クリーチャー — スピリット・アバター\', \'flavor\': \'「彼は生命を知らぬ幽霊だ。」 ――「予見者の寓話」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174037&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'df7b2f3f-b712-47d1-a11f-f100619423f2\', \'multiverseId\': 174037}, \'multiverseid\': 174037}, {\'name\': \'Lorde Fantasmal da Fuga\', \'text\': \'Lorde Fantasmal da Fuga não pode ser bloqueado.\\nToda vez que Lorde Fantasmal da Fuga causa dano de combate a um jogador, esse jogador revela sua própria mão. Escolha um card dela. Aquele jogador remove aquele card do jogo.\', \'type\': \'Criatura — Espírito Avatar\', \'flavor\': \'"Ele é um fantasma que nunca conheceu a vida." — Parábolas da Vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172231&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21426c1e-5121-4d88-8d65-bfcb369631fe\', \'multiverseId\': 172231}, \'multiverseid\': 172231}, {\'name\': \'Владыка Беспамятства\', \'text\': \'Владыка Беспамятства не может быть заблокирован.\\nКаждый раз, когда Владыка Беспамятства наносит боевые повреждения игроку, тот игрок показывает свою руку. Выберите из нее карту. Тот игрок удаляет ту карту из игры.\', \'type\': \'Существо — Дух Аватара\', \'flavor\': \'«Он призрак, не знавший жизни». — Притчи провидицы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172532&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b9403dd6-c234-43ba-a312-892c84adda26\', \'multiverseId\': 172532}, \'multiverseid\': 172532}, {\'name\': \'昏乱惧侯\', \'text\': \'昏乱惧侯不能被阻挡。\\n每当昏乱惧侯对牌手造成战斗伤害时，该牌手展示其手牌。 选择其中一张牌， 该牌手将该牌移出对战。\', \'type\': \'生物～精怪／圣者\', \'flavor\': \'「他是个不知生之滋味的鬼魅。」 ～《预言师寓言》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173134&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e1b005ca-e316-4bc8-b51d-c74d0a1dd867\', \'multiverseId\': 173134}, \'multiverseid\': 173134}]', '[{\'name\': \'Schicksalstransfer\', \'text\': \'Bewege alle Marken von einer Kreatur deiner Wahl auf eine andere Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Rußwesen finden im Leiden anderer innere Stärke, Elfen in der Schönheit. Doch wenn du einen Elfen leiden lässt, wird er schwächer. Ich frage mich, was geschieht, wenn man ein Rußwesen schön werden lässt?" —Hrugash, Egelsetzer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174638&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'819a9f5c-c7f5-4a2d-9e99-e61b53a83c64\', \'multiverseId\': 174638}, \'multiverseid\': 174638}, {\'name\': \'Transferencia de destino\', \'text\': \'Mueve todos los contadores de la criatura objetivo a otra criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"Los cenicientos se regocijan con el sufrimiento, los elfos con la belleza. Pero si haces sufrir a un elfo, se debilita. Me pregunto ¿qué pasaría si haces bello a un ceniciento?" —Hrugash, ligador de sanguijuelas\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172832&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fed2d0fd-9253-458f-baef-e54d1fbd6837\', \'multiverseId\': 172832}, \'multiverseid\': 172832}, {\'name\': \'Transfert de destin\', \'text\': "Déplacez tous les marqueurs d\'une créature ciblée sur une autre créature ciblée.", \'type\': \'Éphémère\', \'flavor\': \'« Les scoriacés trouvent leur force dans la souffrance ; les elfes, dans la beauté. Mais si vous faites souffrir un elfe, il faiblit. Je me demande ce qui se passerait si vous donniez la beauté à un scoriacé ? » —Hrugash, attacheur de sangsues\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173434&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'4f85f4fd-b02e-43be-a6bd-012b292ab680\', \'multiverseId\': 173434}, \'multiverseid\': 173434}, {\'name\': \'Trasferimento del Fato\', \'text\': "Sposta tutti i segnalini da una creatura bersaglio a un\'altra creatura bersaglio.", \'type\': \'Istantaneo\', \'flavor\': \'"I cinerei trovano la forza nella sofferenza, gli elfi nella bellezza. Ma se fai soffrire un elfo, si indebolisce. Chissà cosa succede se rendi bello un cinereo?" —Hrugash, dispensatore di sanguisughe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173735&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'90a3e7df-7e93-4353-b61c-0db0602d8e2e\', \'multiverseId\': 173735}, \'multiverseid\': 173735}, {\'name\': \'命運の転送\', \'text\': \'クリーチャー１体と他のクリーチャー１体を対象とする。その前者の上に置かれているすべてのカウンターを、その後者の上に移動する。\', \'type\': \'インスタント\', \'flavor\': \'「燃えがらどもは苦痛の中に強さを見つけるし、エルフなら美の中だ。 でもエルフに苦痛を与えたら、奴らは弱くなっちまう。 それじゃ燃えがらを美しくしたら何が起こるんだろうな？」 ――ヒル結びのフルガシュ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174036&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c0658f14-bcba-41fc-879d-86f3a209d8a7\', \'multiverseId\': 174036}, \'multiverseid\': 174036}, {\'name\': \'Transferência de Destino\', \'text\': \'Mova todos os marcadores da criatura alvo para outra criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Os cinzeríneos encontram forças no sofrimento, os elfos na beleza. Mas se você fizer um elfo sofrer, ele ficará mais fraco. Imagino o que acontecerá se tornarmos um cinzeríneo belo?" — Hrugash, aplicador de sanguessuga\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172230&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'5c1ec90f-bdbd-4c33-b125-a53388f361d5\', \'multiverseId\': 172230}, \'multiverseid\': 172230}, {\'name\': \'Перенос Судьбы\', \'text\': \'Переместите все жетоны с целевого существа на другое целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Золовики обретают силу в страданиях, эльфы в красоте. Если заставить эльфа страдать, он станет слабее. Интересно, а что будет, если сделать золовика прекрасным?» — Хругаш, рассадчик пиявок\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172531&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4081bd9a-8842-42c9-aa40-f81d9dc4ec41\', \'multiverseId\': 172531}, \'multiverseid\': 172531}, {\'name\': \'交换命运\', \'text\': \'将目标生物上的所有指示物移到另一个目标生物上。\', \'type\': \'瞬间\', \'flavor\': \'「烬身在苦痛中找到力量，地精则在美丽中寻求。 如果你让地精受苦，他就会衰弱。 若让烬身变得美丽，又会发生什么事？」 ～弄蛭人胡噶许\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173133&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e0ce7c02-e588-4755-82f7-f97c363b1a70\', \'multiverseId\': 173133}, \'multiverseid\': 173133}]', '[{\'name\': \'Schild der Überseele\', \'text\': \'Kreaturenverzauberung\\nSolange die verzauberte Kreatur grün ist, erhält sie +1/+1 und ist unzerstörbar. (Tödlicher Schaden und Effekte, die sie „zerstören", zerstören sie nicht. Beträgt ihre Widerstandskraft 0 oder weniger, wird sie weiterhin auf den Friedhof ihres Besitzers gelegt.)\\nSolange die verzauberte Kreatur weiß ist, erhält sie +1/+1 und hat Flugfähigkeit.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174719&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f05da34b-c8f1-48c9-9534-d7ec9f964f0d\', \'multiverseId\': 174719}, \'multiverseid\': 174719}, {\'name\': \'Escudo del Alma suprema\', \'text\': \'Encantar criatura.\\nMientras la criatura encantada sea verde, obtiene +1/+1 y es indestructible. (Los efectos que dicen "destruir" y el daño letal no la destruyen. Si su resistencia es 0 o menos, igual va al cementerio de su propietario.)\\nMientras la criatura encantada sea blanca, obtiene +1/+1 y tiene la habilidad de volar.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172913&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'41a49524-b066-4c68-88d0-c22002651d45\', \'multiverseId\': 172913}, \'multiverseid\': 172913}, {\'name\': \'Bouclier de la Gouve\', \'text\': \'Enchanter : créature\\nTant que la créature enchantée est verte, elle gagne +1/+1 et elle est indestructible. (Les blessures mortelles et les effets qui disent « détruisez » ne la détruisent pas. Si son endurance est inférieure ou égale à 0, elle est toujours mise dans le cimetière de son propriétaire.)\\nTant que la créature enchantée est blanche, elle gagne +1/+1 et elle a le vol.\', \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173515&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'23dc7bf7-8a34-4d4b-917c-2e2442b2a6ec\', \'multiverseId\': 173515}, \'multiverseid\': 173515}, {\'name\': "Scudo dell\'Anima Eccelsa", \'text\': \'Incanta creatura\\nFintanto che la creatura incantata è verde, prende +1/+1 ed è indistruttibile. (Il danno letale e gli effetti che dicono "distruggi" non la distruggono. Se la sua costituzione è pari o inferiore a 0, viene comunque messa nel cimitero del suo proprietario.)\\nFintanto che la creatura incantata è bianca, prende +1/+1 e ha volare.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173816&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'478fb50a-b09a-4b37-a988-2942eaf0547b\', \'multiverseId\': 173816}, \'multiverseid\': 173816}, {\'name\': \'大霊の盾\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーが緑であるかぎり、それは＋１/＋１の修整を受けるとともに破壊されない。 （致死ダメージや"破壊する"効果ではそれは破壊されない。 それのタフネスが０以下である場合は、それはオーナーの墓地に置かれる。）\\nエンチャントされているクリーチャーが白であるかぎり、それは＋１/＋１の修整を受けるとともに飛行を持つ。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174117&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2a4fd949-bf7b-4ce2-a5e8-30aaa5477a34\', \'multiverseId\': 174117}, \'multiverseid\': 174117}, {\'name\': \'Escudo da Alma Suprema\', \'text\': \'Encantar criatura\\nEnquanto a criatura encantada for verde, ela receberá +1/+1 e será indestrutível. (Nem dano letal nem efeitos que dizem "destrua" podem destruí-la. Se a sua resistência for menor ou igual a 0, ela ainda será colocada no cemitério de seu dono.)\\nEnquanto a criatura encantada for branca, ela receberá +1/+1 e terá voar.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172311&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0797e041-d09a-4296-aa5c-5527c6eb70c9\', \'multiverseId\': 172311}, \'multiverseid\': 172311}, {\'name\': \'Щит Сверхдуши\', \'text\': \'Зачаровать существо\\nПока зачарованное существо зеленое, оно получает +1/+1 и является неразрушимым. (Смертельные повреждения и эффекты с указанием «уничтожьте» не уничтожают его. Если его выносливость равна 0 или меньше, оно все равно помещается на кладбище своего владельца.)\\nПока зачарованное существо белое, оно получает +1/+1 и имеет Полет.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172612&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2c21bb00-5e9b-4727-9c3d-a18b801f20c6\', \'multiverseId\': 172612}, \'multiverseid\': 172612}, {\'name\': \'超灵之盾\', \'text\': \'生物结界\\n只要受此结界的生物是绿色，它便得+1/+1且不会毁坏。 （致命伤害以及注明「消灭」的效应都不会将它消灭。 如果其防御力降到0或更少，它仍会置入其拥有者的坟墓场。）\\n只要受此结界的生物是白色，它便得+1/+1且具有飞行异能。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173214&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fd07e9df-87ca-48cd-8f62-d2d509e8b3f6\', \'multiverseId\': 173214}, \'multiverseid\': 173214}]', '[{\'name\': \'Schlafmagier\', \'text\': \'Wenn der Schlafmagier ins Spiel kommt, kannst du eine Kreatur deiner Wahl tappen.\', \'type\': \'Kreatur — Kithkin, Zauberer\', \'flavor\': \'„Bist du müde? Du siehst müde aus."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174626&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c7691bb2-5f34-4a94-8cb7-2dc8108826c0\', \'multiverseId\': 174626}, \'multiverseid\': 174626}, {\'name\': \'Somnomante\', \'text\': \'Cuando la Somnomante entre en juego, puedes girar la criatura objetivo.\', \'type\': \'Criatura — Hechicero kithkin\', \'flavor\': \'"¿Estás cansado? Pareces cansado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172820&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'284e48d8-d09e-4f72-8e00-c4385ad64b36\', \'multiverseId\': 172820}, \'multiverseid\': 172820}, {\'name\': \'Somnomancienne\', \'text\': \'Quand la Somnomancienne arrive en jeu, vous pouvez engager la créature ciblée.\', \'type\': \'Créature : sangami et sorcier\', \'flavor\': "« Vous êtes fatigué ? Vous avez l\'air fatigué. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173422&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a20752cb-41dc-4f40-b42d-5b4d97e1f7b4\', \'multiverseId\': 173422}, \'multiverseid\': 173422}, {\'name\': \'Sonnomante\', \'text\': \'Quando la Sonnomante entra in gioco, puoi TAPpare una creatura bersaglio.\', \'type\': \'Creatura — Mago Kithkin\', \'flavor\': \'"Sei stanco? Sembri stanco."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173723&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3b1db176-d2b5-443b-8b3f-ad4bbaa17105\', \'multiverseId\': 173723}, \'multiverseid\': 173723}, {\'name\': \'睡魔術師\', \'text\': \'睡魔術師が場に出たとき、クリーチャー１体を対象とする。あなたはそれをタップしてもよい。\', \'type\': \'クリーチャー — キスキン・ウィザード\', \'flavor\': \'「疲れたのかい？ 疲れてるんだろ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174024&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'155ddaf4-75cf-47be-991a-e9ee5ccfa191\', \'multiverseId\': 174024}, \'multiverseid\': 174024}, {\'name\': \'Sonomântico\', \'text\': \'Quando Sonomântico entra em jogo, você pode virar a criatura alvo.\', \'type\': \'Criatura — Kithkin Mago\', \'flavor\': \'"Você está cansado? Parece estar cansado."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172218&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'64d13d85-f864-4d05-a5fa-abb802b655d8\', \'multiverseId\': 172218}, \'multiverseid\': 172218}, {\'name\': \'Усыпительница\', \'text\': \'Когда Усыпительница входит в игру, вы можете повернуть целевое существо.\', \'type\': \'Существо — Кискен Чародей\', \'flavor\': \'«Вы устали? Похоже, что да».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172519&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e822fc6e-bae7-4e47-a7b3-22cd41ef5a8b\', \'multiverseId\': 172519}, \'multiverseid\': 172519}, {\'name\': \'入梦术士\', \'text\': \'当入梦术士进场时，你可以横置目标生物。\', \'type\': \'生物～洁英／法术师\', \'flavor\': \'「累了吗？ 你看来很累。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173121&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13f90e6c-bd24-4874-a877-bf97801ab056\', \'multiverseId\': 173121}, \'multiverseid\': 173121}]', '[{\'name\': \'Schlehenbeeren-Kohorte\', \'text\': \'Fliegend\\nDie Schlehenbeeren-Kohorte erhält +1/+1, solange du eine andere blaue Kreatur kontrollierst.\', \'type\': \'Kreatur — Feenwesen, Soldat\', \'flavor\': \'Eine Clique kann deutlich mehr Unheil anrichten als eine Fee alleine.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174507&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'882e82c9-7e49-4a2d-a749-4a5f4fc5ae28\', \'multiverseId\': 174507}, \'multiverseid\': 174507}, {\'name\': \'Cohorte baya de zarza\', \'text\': \'Vuela.\\nLa Cohorte baya de zarza obtiene +1/+1 mientras controles otra criatura azul.\', \'type\': \'Criatura — Soldado hada\', \'flavor\': \'Una pandilla puede ocasionar muchas más travesuras que un hada sola.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172701&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'50015740-662d-4083-9985-c4322afe8dab\', \'multiverseId\': 172701}, \'multiverseid\': 172701}, {\'name\': \'Cohorte des églantines\', \'text\': \'Vol\\nLa Cohorte des églantines gagne +1/+1 tant que vous contrôlez une autre créature bleue.\', \'type\': \'Créature : peuple fée et soldat\', \'flavor\': "Une clique peut créer bien plus de désordre qu\'une faerie solitaire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173303&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a1623669-d4ee-43a8-8c3d-c8285b932196\', \'multiverseId\': 173303}, \'multiverseid\': 173303}, {\'name\': "Coorte di Bacca d\'Erica", \'text\': "Volare\\nLa Coorte di Bacca d\'Erica prende +1/+1 fintanto che controlli un\'altra creatura blu.", \'type\': \'Creatura — Soldato Spiritello\', \'flavor\': \'Una cricca può causare enormemente più danno di un singolo spiritello.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173604&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d137187a-6c85-4d87-90f5-46e3993b3c5c\', \'multiverseId\': 173604}, \'multiverseid\': 173604}, {\'name\': \'茨苺の群勢\', \'text\': \'飛行\\n茨苺の群勢は、あなたが他の青のクリーチャーをコントロールしているかぎり＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — フェアリー・兵士\', \'flavor\': \'妖精一人がする悪戯よりも、徒党を組んで行うほうがずっと利く。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173905&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'18361665-407a-42af-97a1-9a8f6b29adf6\', \'multiverseId\': 173905}, \'multiverseid\': 173905}, {\'name\': \'Coorte de Briarberry\', \'text\': \'Voar\\nCoorte de Briarberry recebe +1/+1 enquanto você controlar outra criatura azul.\', \'type\': \'Criatura — Fada Soldado\', \'flavor\': \'Uma facção pode provocar mais confusão do que uma fada sozinha.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172099&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'30ea3550-2fa4-4896-8ca2-d68314a0d9e7\', \'multiverseId\': 172099}, \'multiverseid\': 172099}, {\'name\': \'Пособница Колючего Шиповника\', \'text\': \'Полет\\nПособница Колючего Шиповника получает +1/+1, пока вы контролируете другое синее существо.\', \'type\': \'Существо — Фея Солдат\', \'flavor\': \'Клика может натворить куда больше бед, чем одна фея сама по себе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172400&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'45357244-73b1-4be1-b227-5f65083db81a\', \'multiverseId\': 172400}, \'multiverseid\': 172400}, {\'name\': \'荆莓助拳人\', \'text\': \'飞行\\n只要你操控其他蓝色生物，荆莓助拳人便得+1/+1。\', \'type\': \'生物～仙灵／士兵\', \'flavor\': \'比起一个仙灵，一个聚群能搞出更大规模的恶戏。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173002&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8cf9737f-21be-4853-a37e-04bc23669b93\', \'multiverseId\': 173002}, \'multiverseid\': 173002}]', '[{\'name\': \'Schleichender Riese\', \'text\': \'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nImmer wenn der Schleichende Riese blockt oder geblockt wird, erhält er -3/-0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Riese, Räuber\', \'flavor\': \'„Ich brauche ein besseres Versteck."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177799&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b1fb5914-6e2d-452f-9a7f-1cbfdb6d2bba\', \'multiverseId\': 177799}, \'multiverseid\': 177799}, {\'name\': \'Gigante furtivo\', \'text\': \'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\\nSiempre que el Gigante furtivo bloquee o sea bloqueado, obtiene -3/-0 hasta el final del turno.\', \'type\': \'Criatura — Bribón gigante\', \'flavor\': \'"Necesito un mejor escondite."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177823&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a77d6cd7-edaa-49a5-871d-aca5e6fda758\', \'multiverseId\': 177823}, \'multiverseid\': 177823}, {\'name\': \'Géant furtif\', \'text\': "Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nÀ chaque fois que le Géant furtif bloque ou devient bloqué, il gagne -3/-0 jusqu\'à la fin du tour.", \'type\': \'Créature : géant et gredin\', \'flavor\': "« Faut vraiment que j\'trouve une meilleure cachette. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177870&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'946afc06-ab36-424a-ae50-20a1a10f13ed\', \'multiverseId\': 177870}, \'multiverseid\': 177870}, {\'name\': \'Gigante Furtivo\', \'text\': \'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nOgniqualvolta il Gigante Furtivo blocca o viene bloccato, prende -3/-0 fino alla fine del turno.\', \'type\': \'Creatura — Farabutto Gigante\', \'flavor\': \'"Ho bisogno di un nascondiglio migliore."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177894&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6313d9a1-ef00-478a-89ce-13b423a087c0\', \'multiverseId\': 177894}, \'multiverseid\': 177894}, {\'name\': \'人目避けの大男\', \'text\': \'萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\n人目避けの大男がブロックするかブロックされた状態になるたび、それはターン終了時まで－３/－０の修整を受ける。\', \'type\': \'クリーチャー — 巨人・ならず者\', \'flavor\': \'「もっといい隠れ場所はないかな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177775&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4bb4c0aa-bfd3-4e4c-8a0e-4b6e03eab350\', \'multiverseId\': 177775}, \'multiverseid\': 177775}, {\'name\': \'Gigante Fujão\', \'text\': \'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\\nToda vez que Gigante Fujão bloqueia ou é bloqueado, ele recebe -3/-0 até o final do turno.\', \'type\': \'Criatura — Gigante Ladino\', \'flavor\': \'"Preciso de um esconderijo melhor."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177751&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3bec2f15-0808-410c-bf93-47ab0c929f7f\', \'multiverseId\': 177751}, \'multiverseid\': 177751}, {\'name\': \'Притаившийся Гигант\', \'text\': \'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\\nКаждый раз, когда Притаившийся Гигант блокирует или становится заблокированным, он получает -3/-0 до конца хода.\', \'type\': \'Существо — Гигант Бродяга\', \'flavor\': \'«Надо бы найти местечко поукромнее».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177727&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'208dd9ca-b5c0-4651-8c67-a56693516b0d\', \'multiverseId\': 177727}, \'multiverseid\': 177727}, {\'name\': \'潜行巨人\', \'text\': \'干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\\n每当潜行巨人阻挡或被阻挡时，它得-3/-0直到回合结束。\', \'type\': \'生物～巨人／浪客\', \'flavor\': \'「我得找个更好的藏身处。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177846&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f5fa8160-17e0-49eb-b588-48786d685386\', \'multiverseId\': 177846}, \'multiverseid\': 177846}]', '[{\'name\': \'Schlängelnder Ablaicher\', \'text\': \'Verursacht Trampelschaden\\nImmer wenn der Schlängelnde Ablaicher einem Spieler Kampfschaden zufügt, bringe einen Spielstein ins Spiel, der eine Kopie des Schlängelnden Ablaichers ist.\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Seine Opfer spüren meist nur ein juckendes, zuckendes Gefühl dicht unter der Haut. Doch dann ist es bereits viel zu spät.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177800&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6c2c2a50-9804-4d1f-a64b-a70e7c1c0f02\', \'multiverseId\': 177800}, \'multiverseid\': 177800}, {\'name\': \'Engendro serpenteante\', \'text\': \'Arrolla.\\nSiempre que el Engendro serpenteante haga daño de combate a un jugador, pon en juego una ficha que es una copia del Engendro serpenteante.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Sus víctimas sólo sienten un cosquilleo bajo la piel. Entonces ya es muy tarde.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177824&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e2a9ef2-a569-48a1-a796-a8338f05cea4\', \'multiverseId\': 177824}, \'multiverseid\': 177824}, {\'name\': \'Amphybane\', \'text\': "Piétinement\\nÀ chaque fois que l\'Amphybane inflige des blessures de combat à un joueur, mettez en jeu un jeton qui est une copie de l\'Amphybane.", \'type\': \'Créature : élémental\', \'flavor\': \'Ses victimes éprouvent un grouillement désagréable sous leur peau. Mais il est déjà trop tard.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177871&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9bfc1d57-16bf-468b-b7b6-7a2fa645667d\', \'multiverseId\': 177871}, \'multiverseid\': 177871}, {\'name\': \'Serpifero\', \'text\': \'Travolgere\\nOgniqualvolta il Serpifero infligge danno da combattimento a un giocatore, metti in gioco una pedina che è la copia del Serpifero.\', \'type\': \'Creatura — Elementale\', \'flavor\': \'Le sue vittime sentono solo un fastidioso prurito proprio sotto la pelle. A quel punto, è già troppo tardi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177895&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3cc2fb7a-912f-434b-a5e6-1c24259ba00c\', \'multiverseId\': 177895}, \'multiverseid\': 177895}, {\'name\': \'落とし悶え\', \'text\': \'トランプル\\n落とし悶えがいずれかのプレイヤーに戦闘ダメージを与えるたび、落とし悶えのコピーであるトークンを１体場に出す。\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'犠牲者が感じるのは、皮膚の下に何かが這うような痒みだけだ。 しかし、その時にはすでに手遅れだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177776&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9be776d8-a773-4c09-ad76-e64ccc6b323e\', \'multiverseId\': 177776}, \'multiverseid\': 177776}, {\'name\': \'Serpentóide\', \'text\': \'Atropelar\\nToda vez que Serpentóide causar dano de combate a um jogador, coloque em jogo uma ficha que seja uma cópia de Serpentóide.\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Suas vítimas sentem apenas uma coceirinha sob a pele. Mas então já é tarde demais.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177752&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'45675199-d393-4351-b3cc-377f63f71fef\', \'multiverseId\': 177752}, \'multiverseid\': 177752}, {\'name\': \'Плодящийся Червь\', \'text\': \'Пробивной удар\\nКаждый раз, когда Плодящийся Червь наносит боевые повреждения игроку, положите в игру одну фишку, являющуюся копией Плодящегося Червя.\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Его жертвы чувствуют только, как под кожей что-то неприятно шевелится. Но тогда уже слишком поздно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177728&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'6e9656a1-52b7-48df-a82f-8c7f331e7c5a\', \'multiverseId\': 177728}, \'multiverseid\': 177728}, {\'name\': \'盘蛇灵\', \'text\': \'践踏\\n每当盘蛇灵对任一牌手造成战斗伤害时，将一个衍生物放置进场，此衍生物为盘蛇灵之复制。\', \'type\': \'生物～元素\', \'flavor\': \'受害者只会感到皮下有阵搔痒、蠕动的感觉。 而那时候早已太迟了。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177847&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9f85505d-6a6f-4417-bfbd-ad2653b4a45d\', \'multiverseId\': 177847}, \'multiverseid\': 177847}]', '[{\'name\': \'Schmeißfliegenbefall\', \'text\': \'Immer wenn eine Kreatur aus dem Spiel auf einen Friedhof gelegt wird und falls mindestens eine -1/-1-Marke auf ihr lag, lege eine -1/-1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Verzauberung\', \'flavor\': \'Als der Riese Tollek Weltenschlächter fiel, entstand eine Fäulnis in seinem Körper, die seinem Namen alle Ehre machte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174535&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'42f2dad6-e459-46a1-a952-bdac60609ee6\', \'multiverseId\': 174535}, \'multiverseid\': 174535}, {\'name\': \'Infestación de moscardas\', \'text\': \'Siempre que una criatura vaya a un cementerio desde el juego, si tenía un contador -1/-1 sobre ella, pon un contador -1/-1 sobre la criatura objetivo.\', \'type\': \'Encantamiento\', \'flavor\': \'Cuando murió el gigante Tollek Destruyemundos, la corrupción brotó de su cuerpo para continuar su misión.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172729&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58011b53-18f8-46f5-9613-3a8fef576289\', \'multiverseId\': 172729}, \'multiverseid\': 172729}, {\'name\': \'Infestation de luciles impériales\', \'text\': "À chaque fois qu\'une créature est mise dans un cimetière depuis le jeu, si elle avait un marqueur -1/-1 sur elle, mettez un marqueur -1/-1 sur la créature ciblée.", \'type\': \'Enchantement\', \'flavor\': \'Du cadavre du géant Tollek Pourfendeur de monde explosa une déferlante de corruption digne de son nom.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173331&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ddcecd89-aaa7-4170-9562-08e2ba77ebd7\', \'multiverseId\': 173331}, \'multiverseid\': 173331}, {\'name\': \'Infestazione di Mosche Cadaveriche\', \'text\': \'Ogniqualvolta una creatura viene messa in un cimitero dal gioco, se aveva un segnalino -1/-1, metti un segnalino -1/-1 su una creatura bersaglio.\', \'type\': \'Incantesimo\', \'flavor\': \'Quando il gigante Tollek Ammazzamondo giunse alla fine dei suoi giorni, uno sciame corrotto eruppe dal suo corpo per diffondere il suo nome.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173632&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c4277705-4166-483a-be8f-fed39db6ed0c\', \'multiverseId\': 173632}, \'multiverseid\': 173632}, {\'name\': \'殴りハエの蔓延\', \'text\': \'いずれかのクリーチャーが場からいずれかの墓地に置かれるたび、それの上に－１/－１カウンターが置かれていた場合、クリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'エンチャント\', \'flavor\': \'巨人の世界薙ぎのトレクが死んだとき、彼の死体からその名を広めるべく腐敗が湧き出した。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173933&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'30e340e8-e29c-4878-b88d-4a0b5eacef60\', \'multiverseId\': 173933}, \'multiverseid\': 173933}, {\'name\': \'Infestação de Mosca-Varejeira\', \'text\': \'Toda vez que uma criatura é colocada no cemitério vinda do jogo, se ela tiver um marcador -1/-1, coloque um marcador -1/-1 na criatura alvo.\', \'type\': \'Encantamento\', \'flavor\': \'Quando o gigante Tollek Matamundo caiu morto, de seu cadáver brotou uma forma pútrida para dar continuidade ao seu nome.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172127&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'674dea8a-d8ad-4dc8-a4bd-3186a8237220\', \'multiverseId\': 172127}, \'multiverseid\': 172127}, {\'name\': \'Нашествие Падальных Мух\', \'text\': \'Каждый раз, когда существо попадает из игры на кладбище, если на нем был жетон -1/-1, положите один жетон -1/-1 на целевое существо.\', \'type\': \'Чары\', \'flavor\': \'Когда гигант Толлек Мироубийца пал, из трупа роем вырвалось Разложение, не давая забыть его имя.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172428&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2d5c0545-1048-416d-bc7a-cb50f6b79114\', \'multiverseId\': 172428}, \'multiverseid\': 172428}, {\'name\': \'绿蝇侵扰\', \'text\': \'每当一个生物从场上置入坟墓场时，若其上有-1/-1指示物，则在目标生物上放置一个-1/-1指示物。\', \'type\': \'结界\', \'flavor\': \'当巨人灭世托列克倒下时，一股腐化势力从他身上冒出，继承了他的名号。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173030&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9a8b8ec8-3eae-468b-ac7d-346ccb00df20\', \'multiverseId\': 173030}, \'multiverseid\': 173030}]', '[{\'name\': \'Schmutzrücken-Marodeure\', \'text\': \'Verursacht Trampelschaden\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174693&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ce521261-2521-49e0-ba71-4866c63424f3\', \'multiverseId\': 174693}, \'multiverseid\': 174693}, {\'name\': \'Merodeadores Scuzzback\', \'text\': \'Arrolla.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172887&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6e187d89-2249-408e-9c62-fdac9f306b8e\', \'multiverseId\': 172887}, \'multiverseid\': 172887}, {\'name\': \'Maraudeurs de Crassedos\', \'text\': "Piétinement\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173489&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5dc43c88-5c69-45bc-b3d4-b97dd6355513\', \'multiverseId\': 173489}, \'multiverseid\': 173489}, {\'name\': \'Predoni di Scozzaschiena\', \'text\': \'Travolgere\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173790&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1415a18f-9551-4c69-a588-fa60d1d9d7e2\', \'multiverseId\': 173790}, \'multiverseid\': 173790}, {\'name\': \'汚れ背の匪賊\', \'text\': \'トランプル\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174091&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'bc4aaab9-f372-4425-b2c2-4418cbeb8063\', \'multiverseId\': 174091}, \'multiverseid\': 174091}, {\'name\': \'Saqueadores de Costas Sujas\', \'text\': \'Atropelar\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172285&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3cc2a7f1-f383-489c-86dd-8e6e19bce05e\', \'multiverseId\': 172285}, \'multiverseid\': 172285}, {\'name\': \'Грязеспины-Мародеры\', \'text\': \'Пробивной удар\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172586&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3b52ea63-9e49-42e6-806a-0c30cf1fa82c\', \'multiverseId\': 172586}, \'multiverseid\': 172586}, {\'name\': \'杂背劫掠者\', \'text\': \'践踏\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～精灵／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173188&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'74b69be9-43f9-4618-9ecc-a46eacd2a34f\', \'multiverseId\': 173188}, \'multiverseid\': 173188}]', '[{\'name\': \'Schmutzrücken-Raufbold\', \'text\': \'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Die Schmutzrückenbande hüllt sich in rostige Rüstungen mit spitzen Stacheln. Nur weniges ist wirksamer als die Angst vor Infektionen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174694&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ad14434b-e090-44ab-9acc-93163c6a27b1\', \'multiverseId\': 174694}, \'multiverseid\': 174694}, {\'name\': \'Pendenciero Scuzzback\', \'text\': \'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'La banda Scuzzback carroñea armaduras oxidadas cubiertas de pinches. Ninguna amenaza es más efectiva que la amenaza de infección.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172888&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0452d5d3-5135-4788-8c5c-2b1943d96b23\', \'multiverseId\': 172888}, \'multiverseid\': 172888}, {\'name\': \'Ferrailleur de Crassedos\', \'text\': \'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\', \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Le gang de Crassedos récupère les armures rouillées recouvertes de protrusions barbelées. Rien n\'est plus efficace que la menace d\'une infection.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173490&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'62074c44-9d02-44fb-81e8-09c6da3d726c\', \'multiverseId\': 173490}, \'multiverseid\': 173490}, {\'name\': \'Rissoso di Scozzaschiena\', \'text\': \'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': "La banda di Scozzaschiena utilizza armature rugginose ricoperte di sporgenze spinate. Nessuna minaccia è più efficace di quella di un\'infezione.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173791&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6b27bc81-32bd-4e4a-b7e2-89a64d35ead7\', \'multiverseId\': 173791}, \'multiverseid\': 173791}, {\'name\': \'汚れ背の潰し屋\', \'text\': \'萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'汚れ背の連中は、トゲの突き出た錆びた鎧を漁り返している。 病以上に彼らに脅しとなるものは無いのだろう。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174092&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e99782ce-ad31-49a4-8400-8cb48c3f988a\', \'multiverseId\': 174092}, \'multiverseid\': 174092}, {\'name\': \'Sucateiro de Costas Sujas\', \'text\': \'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\', \'type\': \'Criatura — Goblin Guerreiro\', \'flavor\': \'A gangue de Costas Sujas recolhe as armaduras enferrujadas cobertas por protuberâncias pontiagudas. Nenhuma ameaça é mais eficaz do que a ameaça de infecção.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172286&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c4914493-033d-4103-837f-ac0fbaf7840c\', \'multiverseId\': 172286}, \'multiverseid\': 172286}, {\'name\': \'Грязеспин-Забияка\', \'text\': \'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Банда грязеспинов собирает повсюду ржавые доспехи с острыми выступами и зазубринами. Нет более действенной угрозы, чем опасность заражения.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172587&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'52bccd33-f710-4ea4-9f66-6d4db476d203\', \'multiverseId\': 172587}, \'multiverseid\': 172587}, {\'name\': \'杂背拆解手\', \'text\': \'干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\', \'type\': \'生物～精灵／战士\', \'flavor\': \'杂背帮捡拾布满倒勾尖刺的的生锈铠甲。 引致感染的恐惧比任何威胁都有效。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173189&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ff87109c-7ca6-4266-bc9f-d7db71845352\', \'multiverseId\': 173189}, \'multiverseid\': 173189}]', '[{\'name\': \'Schneehauch\', \'text\': \'Eine Kreatur deiner Wahl wird bis zum Ende des Zuges weiß. Tappe diese Kreatur.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'In einer Welt ohne Sonne leuchten nur die freudlosen Feuer und die wandernden Geister der Toten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174492&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1cfb6d79-d633-41b3-a8b7-b3d6a52f676e\', \'multiverseId\': 174492}, \'multiverseid\': 174492}, {\'name\': \'Centellas níveas\', \'text\': \'La criatura objetivo es blanca hasta el final del turno. Gira esa criatura.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'En un mundo sin sol, la luz proviene de los tristes fuegos o los espíritus vagabundos de los muertos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172686&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'731daa69-cb22-4f37-8e20-08ff249b0a57\', \'multiverseId\': 172686}, \'multiverseid\': 172686}, {\'name\': \'Feux nivéens\', \'text\': "La créature ciblée devient blanche jusqu\'à la fin du tour. Engagez cette créature.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'Dans un monde sans soleil, la lumière émane des feux sans chaleur ou des esprits errants des morts.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173288&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'da4f8a74-bf79-4b25-b3c7-db370b69fc34\', \'multiverseId\': 173288}, \'multiverseid\': 173288}, {\'name\': \'Fuochi Fatui Perlacei\', \'text\': \'Una creatura bersaglio diventa bianca fino alla fine del turno. TAPpa quella creatura.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': "In un mondo senza sole, l\'illuminazione giunge dai tristi focolari o dagli spiriti erranti dei morti.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173589&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2945870c-a40c-4a1a-a20a-04a68051d897\', \'multiverseId\': 173589}, \'multiverseid\': 173589}, {\'name\': \'たなびく純白\', \'text\': \'クリーチャー１体を対象とする。ターン終了時まで、それは白になる。 そのクリーチャーをタップする。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'太陽の無い世界では、光はわびしい炎やさまよう死者の魂から発せられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173890&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e85430b2-7d36-47cd-a3a6-74b78ef806fa\', \'multiverseId\': 173890}, \'multiverseid\': 173890}, {\'name\': \'Fogo-Fátuo Nevado\', \'text\': \'A criatura alvo torna-se branca até o final do turno. Vire aquela criatura.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Num mundo desprovido de sol, a iluminação vem de tristes fogueiras ou dos espíritos andarilhos dos mortos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172084&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9bec280e-3cb3-497e-9022-7d29835639c7\', \'multiverseId\': 172084}, \'multiverseid\': 172084}, {\'name\': \'Белесые Огоньки\', \'text\': \'Целевое существо становится белым до конца хода. Поверните то существо.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'В мире, лишенном солнца, свет исходит от унылых огоньков или от блуждающих духов умерших.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172385&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b44944ec-bc5c-4496-b72e-f99e5b3cd378\', \'multiverseId\': 172385}, \'multiverseid\': 172385}, {\'name\': \'雪白鬼火\', \'text\': \'目标生物成为白色直到回合结束。 横置该生物。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'在暗无天日的世界中，启发之光是来自无精打采的火焰，或是游荡的亡者灵魂。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172987&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'beb0e6ee-57ad-4707-9e0b-038825cba81a\', \'multiverseId\': 172987}, \'multiverseid\': 172987}]', '[{\'name\': \'Schotterkiemen-Axtkämpfer\', \'text\': \'Beharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Meervolk, Soldat\', \'flavor\': \'„Ihre scharfen Schuppen gäben eine gute Rüstung ab — wenn sie bloß tot bleiben würden." —Taeryn, Rüstmeister der Rußwesen\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174641&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2eb1e46c-ea9d-4f40-9a81-490bb7ea5a2c\', \'multiverseId\': 174641}, \'multiverseid\': 174641}, {\'name\': \'Escuálido hacha de Branquia Arenosa\', \'text\': \'Persistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Soldado tritón\', \'flavor\': \'"Sus escamas afiladas servirían muy bien para armaduras, si tan solo se quedaran muertos." —Taeryn, armero ceniciento\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172835&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b5e8e4fe-1b4e-47b7-8982-672bd9dcead9\', \'multiverseId\': 172835}, \'multiverseid\': 172835}, {\'name\': "Fauchesquale d\'Ouisablon", \'text\': "Persistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : ondin et soldat\', \'flavor\': "« Leurs écailles tranchantes seraient parfaites pour une armure, s\'ils voulaient bien mourir. » —Taeryn, armurier scoriacé", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173437&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3856c29c-3e5c-4e88-be5a-e1eda6a4d48f\', \'multiverseId\': 173437}, \'multiverseid\': 173437}, {\'name\': \'Asciasqualo della Branchiaghiaiosa\', \'text\': \'Persistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Soldato Tritone\', \'flavor\': \'"Le loro scaglie affilate potrebbero diventare ottime armature, se solo restassero morte." —Taeryn, armaiolo cinereo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173738&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'000b071f-4427-4294-bb98-00095744ea34\', \'multiverseId\': 173738}, \'multiverseid\': 173738}, {\'name\': \'砂利エラの斧鮫\', \'text\': \'頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — マーフォーク･兵士\', \'flavor\': \'「やつらの鋭い鱗ならいい鎧ができるだろう。やつらが死んでてくれるんならな。」 ――燃えがらの鎧直し、テーリン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174039&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'85f373b3-efa1-4b33-badc-7a9cfe6497c9\', \'multiverseId\': 174039}, \'multiverseid\': 174039}, {\'name\': \'Tubarão-Machado Petreobrânquio\', \'text\': \'Persistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Tritão Soldado\', \'flavor\': \'"Suas escamas afiadas dariam uma boa armadura, se permanecessem mortas." — Taeryn, armeiro cinzeríneo\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172233&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'35375bce-26a1-42a0-8a1d-cae21c28d3ba\', \'multiverseId\': 172233}, \'multiverseid\': 172233}, {\'name\': \'Камнежаберный Хищник\', \'text\': \'Упорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Мерфолк Солдат\', \'flavor\': \'«Из их острой чешуи вышли бы отличные доспехи, если бы только они не пытались восстать из мертвых». — Тайрин, кователь доспехов из племени золовиков\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172534&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'27d1556c-27b5-4872-ab70-653459b73ffb\', \'multiverseId\': 172534}, \'multiverseid\': 172534}, {\'name\': \'砂鳃斧人鱼\', \'text\': \'留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～人鱼／士兵\', \'flavor\': \'「他们的锋利鳞片可以作成好铠甲，前提是他们真得乖乖死掉。」 ～烬身铠匠铁霖\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173136&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fbb97382-6224-445f-9176-ecb86a77346b\', \'multiverseId\': 173136}, \'multiverseid\': 173136}]', '[{\'name\': \'Schotterkiemen-Duo\', \'text\': \'Immer wenn du einen blauen Zauber spielst, erhält das Schotterkiemen-Duo +1/+1 bis zum Ende des Zuges.\\nImmer wenn du einen schwarzen Zauber spielst, verursacht das Schotterkiemen-Duo bis zum Ende des Zuges Furcht.\', \'type\': \'Kreatur — Meervolk, Räuber, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174642&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'18f66fb0-8e1c-4f33-8e5c-f0cee0231899\', \'multiverseId\': 174642}, \'multiverseid\': 174642}, {\'name\': \'Dúo de Branquia Arenosa\', \'text\': \'Siempre que juegues un hechizo azul, el Dúo de Branquia Arenosa obtiene +1/+1 hasta el final del turno.\\nSiempre que juegues un hechizo negro, el Dúo de Branquia Arenosa gana la habilidad de inspirar temor hasta el final del turno.\', \'type\': \'Criatura — Guerrero bribón tritón\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172836&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e77248a9-25d4-4b00-b6f1-06c024f47438\', \'multiverseId\': 172836}, \'multiverseid\': 172836}, {\'name\': "Duo d\'Ouisablon", \'text\': "À chaque fois que vous jouez un sort bleu, le Duo d\'Ouisablon gagne +1/+1 jusqu\'à la fin du tour.\\nÀ chaque fois que vous jouez un sort noir, le Duo d\'Ouisablon acquiert la peur jusqu\'à la fin du tour.", \'type\': \'Créature : ondin et gredin et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173438&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'463dee1b-29e8-48da-86fb-f3b7f71c944e\', \'multiverseId\': 173438}, \'multiverseid\': 173438}, {\'name\': \'Duo della Branchiaghiaiosa\', \'text\': \'Ogniqualvolta giochi una magia blu, il Duo della Branchiaghiaiosa prende +1/+1 fino alla fine del turno.\\nOgniqualvolta giochi una magia nera, il Duo della Branchiaghiaiosa ha paura fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Farabutto Tritone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173739&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4c61b15e-9c94-4170-ae2c-a790fae83d7e\', \'multiverseId\': 173739}, \'multiverseid\': 173739}, {\'name\': \'砂利エラの二人組\', \'text\': \'あなたが青の呪文をプレイするたび、砂利エラの二人組はターン終了時まで＋１/＋１の修整を受ける。\\nあなたが黒の呪文をプレイするたび、砂利エラの二人組はターン終了時まで畏怖を得る。\', \'type\': \'クリーチャー — マーフォーク・ならず者・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174040&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'03aade18-c488-41a2-9130-af131e9c3ab4\', \'multiverseId\': 174040}, \'multiverseid\': 174040}, {\'name\': \'Duo Petreobrânquio\', \'text\': \'Toda vez que você joga uma mágica azul, Duo Petreobrânquio recebe +1/+1 até o final do turno.\\nToda vez que você joga uma mágica preta, Duo Petreobrânquio ganha amedrontar até o final do turno.\', \'type\': \'Criatura — Tritão Ladino Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172234&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'21622150-f42b-49bf-9ef2-38712a4bec03\', \'multiverseId\': 172234}, \'multiverseid\': 172234}, {\'name\': \'Камнежаберные Напарники\', \'text\': \'Каждый раз, когда вы разыгрываете синее заклинание, Камнежаберные Напарники получают +1/+1 до конца хода.\\nКаждый раз, когда вы разыгрываете черное заклинание, Камнежаберные Напарники получают Страх до конца хода.\', \'type\': \'Существо — Мерфолк Бродяга Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172535&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'68b1784f-f9c3-4fe5-882f-65df3115b227\', \'multiverseId\': 172535}, \'multiverseid\': 172535}, {\'name\': \'砂鳃搭档\', \'text\': \'每当你使用一个蓝色咒语时，砂鳃搭档得+1/+1直到回合结束。\\n每当你使用一个黑色咒语时，砂鳃搭档获得恐惧异能直到回合结束。\', \'type\': \'生物～人鱼／浪客／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173137&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cd74b74-e7e5-4c3b-abc6-57ab71bf6f2a\', \'multiverseId\': 173137}, \'multiverseid\': 173137}]', '[{\'name\': \'Schwelender Novize\', \'text\': \'Immer wenn ein Spieler einen schwarzen Zauberspruch spielt, kannst du {1} bezahlen. Falls du dies tust, verliert ein Spieler deiner Wahl 1 Lebenspunkt.\', \'type\': \'Kreatur — Elementarwesen, Schamane\', \'flavor\': \'„Das Leben ist ein Kreis. Der Tod ist ein Teufelskreis."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174555&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a9ff057d-c1f4-41b8-bfda-e55503a59cc6\', \'multiverseId\': 174555}, \'multiverseid\': 174555}, {\'name\': \'Iniciado humeante\', \'text\': \'Siempre que un jugador juegue un hechizo negro, puedes pagar {1}. Si lo haces, el jugador objetivo pierde 1 vida.\', \'type\': \'Criatura — Chamán elemental\', \'flavor\': \'"La vida es un círculo. La muerte es un círculo vicioso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172749&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fbba7cdc-c53e-4e32-b528-d9d1bcffd71b\', \'multiverseId\': 172749}, \'multiverseid\': 172749}, {\'name\': \'Adepte fumant\', \'text\': "À chaque fois qu\'un joueur joue un sort noir, vous pouvez payer {1}. Si vous faites ainsi, le joueur ciblé perd 1 point de vie.", \'type\': \'Créature : élémental et shamane\', \'flavor\': \'« La vie est un cercle. La mort est un cercle vicieux. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173351&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7db2edd7-ef6f-43d3-8d28-49d4ce96acc8\', \'multiverseId\': 173351}, \'multiverseid\': 173351}, {\'name\': \'Iniziato Ardente\', \'text\': \'Ogniqualvolta un giocatore gioca una magia nera, puoi pagare {1}. Se lo fai, un giocatore bersaglio perde 1 punto vita.\', \'type\': \'Creatura — Sciamano Elementale\', \'flavor\': \'"La vita è un circolo. La morte un circolo vizioso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173652&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'155d0ac9-2910-429b-a34e-bdf5ba929849\', \'multiverseId\': 173652}, \'multiverseid\': 173652}, {\'name\': \'薄煙の信徒\', \'text\': \'いずれかのプレイヤーが黒の呪文をプレイするたび、プレイヤー１人を対象とする。あなたは{1}を支払ってもよい。 そうした場合、そのプレイヤーは１点のライフを失う。\', \'type\': \'クリーチャー — エレメンタル・シャーマン\', \'flavor\': \'「生は円を成す。 死は邪悪な円を成す。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173953&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a4c30249-69dd-4321-ac91-7e52f476d439\', \'multiverseId\': 173953}, \'multiverseid\': 173953}, {\'name\': \'Iniciado Ignitor\', \'text\': \'Toda vez que um jogador joga uma mágica preta, você pode pagar {1}. Se fizer isso, o jogador alvo perderá 1 ponto de vida.\', \'type\': \'Criatura — Elemental Xamã\', \'flavor\': \'"A vida é um círculo. A morte é um círculo vicioso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172147&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'705c1096-6456-4a4c-b3b9-c422eb932668\', \'multiverseId\': 172147}, \'multiverseid\': 172147}, {\'name\': \'Искусный Поджигатель\', \'text\': \'Каждый раз, когда игрок разыгрывает черное заклинание, вы можете заплатить {1}. Если вы это делаете, целевой игрок теряет 1 жизнь.\', \'type\': \'Существо — Элементаль Шаман\', \'flavor\': \'«Жизнь это круг. Смерть же порочный круг».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172448&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'16ef32ab-c05f-4d4e-a398-6879fd4ae79f\', \'multiverseId\': 172448}, \'multiverseid\': 172448}, {\'name\': \'窒烟学徒\', \'text\': \'每当任一牌手使用黑色咒语时，你可以支付{1}。 如果你如此作，则目标牌手失去1点生命。\', \'type\': \'生物～元素／祭师\', \'flavor\': \'「生命是个循环。 死亡则是恶毒的循环。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173050&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87407bf3-957c-4ebd-811f-d65b31b28f9a\', \'multiverseId\': 173050}, \'multiverseid\': 173050}]', "[{'name': 'Schwäne von Bryn Argoll', 'text': 'Fliegend\\nFalls eine Quelle den Schwänen von Bryn Argoll Schaden zufügen würde, verhindere diesen Schaden. Der Beherrscher dieser Quelle zieht so viele Karten, wie auf diese Weise Schadenspunkte verhindert wurden.', 'type': 'Kreatur — Vogel, Geist', 'flavor': 'Jedes Wesen, das ihnen Böses antut, lernt die Lektion schnell.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174628&type=card', 'language': 'German', 'identifiers': {'scryfallId': '7c5aff60-e3b2-464b-ad70-a5bd3f4e833d', 'multiverseId': 174628}, 'multiverseid': 174628}, {'name': 'Cisnes de Bryn Árgoll', 'text': 'Vuela.\\nSi una fuente fuera a hacer daño a los Cisnes de Bryn Árgoll, prevén ese daño. El controlador de la fuente roba una cantidad de cartas igual al daño prevenido de esta manera.', 'type': 'Criatura — Espíritu ave', 'flavor': 'Cualquier ser que los daña aprende rápido la lección.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172822&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd1dfa963-677b-46d2-a76b-ce76b09fcdb5', 'multiverseId': 172822}, 'multiverseid': 172822}, {'name': 'Cygnes de Bryn Argoll', 'text': 'Vol\\nSi une source devait infliger des blessures aux Cygnes de Bryn Argoll, prévenez ces blessures. Le contrôleur de cette source pioche un nombre de cartes égal au nombre de blessures prévenues de cette manière.', 'type': 'Créature : oiseau et esprit', 'flavor': 'Quiconque les blesse comprend vite son erreur.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173424&type=card', 'language': 'French', 'identifiers': {'scryfallId': '65422318-6f01-4e61-9298-4645cc8423a3', 'multiverseId': 173424}, 'multiverseid': 173424}, {'name': 'Cigni di Bryn Argoll', 'text': 'Volare\\nSe una fonte sta per infliggere danno ai Cigni di Bryn Argoll, previeni quel danno. Il controllore di quella fonte pesca un numero di carte pari al danno prevenuto in questo modo.', 'type': 'Creatura — Uccello Spirito', 'flavor': 'Ogni essere che fa loro del male impara presto la lezione.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173725&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '08ce566b-0211-419d-b298-8dfc062fd1ff', 'multiverseId': 173725}, 'multiverseid': 173725}, {'name': 'ブリン・アーゴルの白鳥', 'text': '飛行\\nいずれかの発生源がブリン・アーゴルの白鳥にダメージを与える場合、それをすべて軽減し、０にする。 その発生源のコントローラーは、これにより軽減されたダメージの点数に等しい枚数のカードを引く。', 'type': 'クリーチャー — 鳥・スピリット', 'flavor': 'それを傷つけようとした者は、すぐにその教訓を学ぶことになる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174026&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '5ff0fac0-cb62-4079-9581-2632ca51b9b3', 'multiverseId': 174026}, 'multiverseid': 174026}, {'name': 'Cisnes de Bryn Argoll', 'text': 'Voar\\nSe uma fonte for causar dano a Cisnes de Bryn Argoll, previna aquele dano. O controlador da fonte compra um número de cards igual ao dano prevenido dessa maneira.', 'type': 'Criatura — Ave Espírito', 'flavor': 'Qualquer ser que os machuque logo aprende a lição.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172220&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '080bea78-8b62-4114-8ff3-e057569004fe', 'multiverseId': 172220}, 'multiverseid': 172220}, {'name': 'Лебеди Брин-Аргола', 'text': 'Полет\\nЕсли источник должен нанести повреждения Лебедям Брин-Аргола, предотвратите эти повреждения. Контролирующий этот источник игрок берет столько карт, сколько повреждений было предотвращено таким образом.', 'type': 'Существо — Птица Дух', 'flavor': 'Любое существо, причиняющее им вред, быстро извлекает из этого хороший урок.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172521&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ff41a55e-f58c-4ddf-bff5-e4b60fa45ee2', 'multiverseId': 172521}, 'multiverseid': 172521}, {'name': '布莱雅各天鹅', 'text': '飞行\\n若任一来源将对布莱雅各天鹅造成伤害，则防止此伤害。 该来源的操控者抓若干牌，其数量等同于以此法所防止的伤害。', 'type': '生物～鸟／精怪', 'flavor': '伤害他们者很快就会学到教训。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173123&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '0f0b4403-1d17-4c2a-a33e-93e704e80399', 'multiverseId': 173123}, 'multiverseid': 173123}]", '[{\'name\': \'Seen-Korrigan\', \'text\': \'{U/B}: Die Seen-Korrigan erhält +1/+1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'„Blicke nicht in ruhendes Wasser, ohne vorher die Oberfläche zu stören. Sonst fängt dich die Korrigan mit ihrem Blick und holt dich zu sich." —Kithkin-Aberglaube\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174548&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'840c8dd1-cc77-440e-b267-105fff2859b1\', \'multiverseId\': 174548}, \'multiverseid\': 174548}, {\'name\': \'Korrigan del lago\', \'text\': \'{U/B}: La Korrigan del lago obtiene +1/+1 hasta el final del turno.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'"No te asomes a estanques tranquilos sin disturbar la superficie primero. La korrigan te capturará con su mirada y te arrastrará a tu muerte." —Superstición kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172742&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a5d6e46a-0d6d-4f54-aaf4-241e125afadc\', \'multiverseId\': 172742}, \'multiverseid\': 172742}, {\'name\': \'Korrigan des lochs\', \'text\': "{U/B} : La Korrigan des lochs gagne +1/+1 jusqu\'à la fin du tour.", \'type\': \'Créature : esprit\', \'flavor\': "« Ne contemple pas les eaux calmes sans en avoir au préalable troublé la surface d\'une pierre. La korrigan croiserait ton regard et t\'attirerait dans ta tombe aquatique. » —Superstition sangamie", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173344&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'19228780-a323-4bef-8b6b-add153e5cb1f\', \'multiverseId\': 173344}, \'multiverseid\': 173344}, {\'name\': \'Korrigan Lacustre\', \'text\': \'{U/B}: La Korrigan Lacustre prende +1/+1 fino alla fine del turno.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'"Non scrutare nelle acque ferme senza prima averne smosso la superficie. O la korrigan ti coglierà con il suo sguardo e ti condurrà alla morte." —Superstizione kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173645&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'70648cdd-c2c9-4b2c-92e1-960a85f05f40\', \'multiverseId\': 173645}, \'multiverseid\': 173645}, {\'name\': \'湖のコリガン\', \'text\': \'{U/B}：湖のコリガンはターン終了時まで＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'「静かな水面は、覗き込む前に一度かき乱せ。 さもなくば、コリガンの眼差しに捕らえられ、引き込まれて死んでしまうだろう。」 ――キスキンの迷信\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173946&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fd543b2a-e74e-49d9-bdf3-cca186a3c0fd\', \'multiverseId\': 173946}, \'multiverseid\': 173946}, {\'name\': \'Korrigan do Lago\', \'text\': \'{U/B}: Korrigan do Lago recebe +1/+1 até o final do turno.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'"Não olhe para águas paradas sem primeiro quebrar a superfície. A korrigan o prenderá com seu olhar e o arrastará para a morte." — Superstição kithkin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172140&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c0b02b89-5bff-4395-b4c5-e0a1297e225e\', \'multiverseId\': 172140}, \'multiverseid\': 172140}, {\'name\': \'Озерная Корригана\', \'text\': \'{U/B}: Озерная Корригана получает +1/+1 до конца хода.\', \'type\': \'Существо — Дух\', \'flavor\': \'«Не смотри на стоячую воду, не потревожив поверхность. Корригана поймает тебя своим взглядом и утащит на верную смерть». — Поверье кискенов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172441&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'dc865d76-7441-4603-a98a-19ca65b5c03e\', \'multiverseId\': 172441}, \'multiverseid\': 172441}, {\'name\': \'湖岸夜水妖\', \'text\': \'{U/B}：湖岸夜水妖得+1/+1直到回合结束。\', \'type\': \'生物～精怪\', \'flavor\': \'「在看着静水之前，一定要先将水面弄皱。 否则夜水妖会用眼神定住你，把你拖下水溺死。」 ～洁英的迷信\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173043&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c697e333-2bce-45d3-82f6-fd539473adef\', \'multiverseId\': 173043}, \'multiverseid\': 173043}]', '[{\'name\': \'Seidenfesselfee\', \'text\': \'Fliegend\\n{1}{W/U}, {Q}: Tappe eine Kreatur deiner Wahl. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Feenwesen, Räuber\', \'flavor\': \'„Je größer sie sind, desto lustiger ist es, wenn sie sich auf die Schnauze legen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174625&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e5bd288f-b4f1-430c-8145-8a0a66aa7fac\', \'multiverseId\': 174625}, \'multiverseid\': 174625}, {\'name\': \'Hada enlazaseda\', \'text\': \'Vuela.\\n{1}{W/U}, {Q}: Gira la criatura objetivo. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Bribón hada\', \'flavor\': \'"Cuanto más grandes son, más divertido es verlos caer con la cara al piso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172819&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'23a91438-dd9b-4c45-a717-0583ad8502ff\', \'multiverseId\': 172819}, \'multiverseid\': 172819}, {\'name\': \'Faerie bridesoie\', \'text\': \'Vol\\n{1}{W/U}, {Q} : Engagez la créature ciblée. ({Q} est le symbole de dégagement.)\', \'type\': \'Créature : peuple fée et gredin\', \'flavor\': \'« Plus ils sont gros, plus il est amusant de les voir tomber la tête la première. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173421&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6b5a17e5-578c-45ed-ad94-898e26641def\', \'multiverseId\': 173421}, \'multiverseid\': 173421}, {\'name\': \'Spiritella Filo di Seta\', \'text\': \'Volare\\n{1}{W/U}, {Q}: TAPpa una creatura bersaglio. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Farabutto Spiritello\', \'flavor\': \'"Più grandi sono, più è divertente vederli cadere di faccia."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173722&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ce97301-4229-40d2-b407-3cdf7bbad664\', \'multiverseId\': 173722}, \'multiverseid\': 173722}, {\'name\': \'絹縛りのフェアリー\', \'text\': \'飛行\\n{1}{W/U}, {Q}：クリーチャー１体を対象とし、それをタップする。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — フェアリー・ならず者\', \'flavor\': \'「相手が大きいほど、うつぶせにばったり倒れたのを見るのは楽しくなるんだ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174023&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9fa2f6b3-2bdf-475c-a0fd-a1374252281b\', \'multiverseId\': 174023}, \'multiverseid\': 174023}, {\'name\': \'Fada Laço-de-Seda\', \'text\': \'Voar\\n{1}{W/U}, {Q}: Vire a criatura alvo. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Fada Ladino\', \'flavor\': \'"Quanto maiores, mais divertido é observá-los enquanto caem de cara no chão."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172217&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a316b1ef-0a23-434a-ac45-e131a13486ec\', \'multiverseId\': 172217}, \'multiverseid\': 172217}, {\'name\': \'Фея Шелковых Уз\', \'text\': \'Полет\\n{1}{W/U}, {Q}: поверните целевое существо. ({Q} символ разворота карты.)\', \'type\': \'Существо — Фея Бродяга\', \'flavor\': \'«Чем они больше, тем смешнее смотреть, как они падают прямо вниз лицом».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172518&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d6e2c8d8-f820-4886-9316-795e5c7ed3d4\', \'multiverseId\': 172518}, \'multiverseid\': 172518}, {\'name\': \'丝缚仙灵\', \'text\': \'飞行\\n{1}{W/U}，{Q}：横置目标生物。 （{Q}是重置符号。）\', \'type\': \'生物～仙灵／浪客\', \'flavor\': \'「他们个头越大，摔倒的狼狈样就越好笑。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173120&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9fbf2d23-741d-43da-b561-6fd9e3465561\', \'multiverseId\': 173120}, \'multiverseid\': 173120}]', '[{\'name\': \'Sich ausbreitende Fäulnis\', \'text\': \'Lege eine -1/-1-Marke auf eine Kreatur deiner Wahl, zwei -1/-1-Marken auf eine andere Kreatur deiner Wahl und drei -1/-1-Marken auf eine dritte Kreatur deiner Wahl.\', \'type\': \'Hexerei\', \'flavor\': \'Im Schattenmoor wachsen Verfall, Schleim und Verzweiflung am besten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174547&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'501bf444-ced6-4c6b-962c-c2f56dac4c8f\', \'multiverseId\': 174547}, \'multiverseid\': 174547}, {\'name\': \'Ruina incrementada\', \'text\': \'Pon un contador -1/-1 sobre la criatura objetivo, dos contadores -1/-1 sobre otra criatura objetivo y tres contadores -1/-1 sobre una tercera criatura objetivo.\', \'type\': \'Conjuro\', \'flavor\': \'Las principales cosechas del Páramo Sombrío son la podredumbre, el fango y la desesperación.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172741&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'13995f4f-c75c-4b01-bf2f-58bcec91276a\', \'multiverseId\': 172741}, \'multiverseid\': 172741}, {\'name\': \'Flétrissement progressif\', \'text\': \'Mettez un marqueur -1/-1 sur une créature ciblée, deux marqueurs -1/-1 sur une autre créature ciblée, et trois marqueurs -1/-1 sur une troisième créature ciblée.\', \'type\': \'Rituel\', \'flavor\': \'Les cultures principales de Sombrelande sont la pourriture, la boue et le désespoir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173343&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1445c147-84ef-40ad-9f7f-42e40e49be17\', \'multiverseId\': 173343}, \'multiverseid\': 173343}, {\'name\': \'Incremento di Avvizzimento\', \'text\': "Metti un segnalino -1/-1 su una creatura bersaglio, due segnalini -1/-1 su un\'altra creatura bersaglio e tre segnalini -1/-1 su una terza creatura bersaglio.", \'type\': \'Stregoneria\', \'flavor\': \'I raccolti principali della Landa Tenebrosa sono putrefazione, melma e disperazione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173644&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3f7d6176-f6e5-4545-954d-6ab1544b2ea1\', \'multiverseId\': 173644}, \'multiverseid\': 173644}, {\'name\': \'増え続ける荒廃\', \'text\': \'クリーチャー１体と、他のクリーチャー１体と、他のクリーチャー１体を対象とする。その１体目の上に－１/－１カウンターを１個置き、その２体目の上に－１/－１カウンターを２個置き、その３体目の上に－１/－１カウンターを３個置く。\', \'type\': \'ソーサリー\', \'flavor\': \'シャドウムーアの主産物は、腐敗と粘体と絶望だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173945&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9548a2f7-bf46-4881-8da5-9c27f1d756ba\', \'multiverseId\': 173945}, \'multiverseid\': 173945}, {\'name\': \'Ensoamento Incremental\', \'text\': \'Coloque um marcador -1/-1 na criatura alvo, dois marcadores -1/-1 em outra criatura alvo, e três marcadores -1/-1 em uma terceira criatura alvo.\', \'type\': \'Feitiço\', \'flavor\': \'As principais plantações de Pântano Sombrio são de podridão, lodo e desespero.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172139&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'34c48b04-b417-4633-9a8d-f5b0576fbbef\', \'multiverseId\': 172139}, \'multiverseid\': 172139}, {\'name\': \'Поэтапное Гниение\', \'text\': \'Положите один жетон -1/-1 на целевое существо, два жетона -1/-1 на другое целевое существо и три жетона -1/-1 на третье целевое существо.\', \'type\': \'Волшебство\', \'flavor\': \'Главный урожай в Шэдоумуре это гниль, грязь и безысходность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172440&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'13eaf491-1355-4d72-93b9-35bd4fed907f\', \'multiverseId\': 172440}, \'multiverseid\': 172440}, {\'name\': \'加速枯萎\', \'text\': \'在目标生物上放置一个-1/-1指示物，另一个目标生物上放置两个-1/-1指示物，并在第三个目标生物上放置三个-1/-1指示物。\', \'type\': \'法术\', \'flavor\': \'暗影荒原盛产腐坏、烂泥与绝望。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173042&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1c7dff71-a0a1-408a-b3c2-f05a0718b3b5\', \'multiverseId\': 173042}, \'multiverseid\': 173042}]', '[{\'name\': \'Sichelschlitzer\', \'text\': \'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\', \'type\': \'Kreatur — Elementarwesen, Krieger\', \'flavor\': \'Seine Sichel wurde in der Hitze des Scheiterhaufens eines anderen Rußwesens geschmiedet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174554&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a6988b72-682f-42da-93ab-37a10dd9fc23\', \'multiverseId\': 174554}, \'multiverseid\': 174554}, {\'name\': \'Desgarrador de la hoz\', \'text\': \'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\', \'type\': \'Criatura — Guerrero elemental\', \'flavor\': \'Su hoz fue forjada en el calor de la pira funeraria de otro ceniciento.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172748&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6dda0b99-1e1e-4deb-918c-05bc13044fcf\', \'multiverseId\': 172748}, \'multiverseid\': 172748}, {\'name\': \'Éventreur à la faucille\', \'text\': \'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\', \'type\': \'Créature : élémental et guerrier\', \'flavor\': "Sa faucille a été forgée dans la chaleur du brasier funéraire d\'un autre scoriacé.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173350&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f4da55e5-e83b-4ff1-bd37-911f06969802\', \'multiverseId\': 173350}, \'multiverseid\': 173350}, {\'name\': \'Falcetto Lacerante\', \'text\': \'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\', \'type\': \'Creatura — Guerriero Elementale\', \'flavor\': \'Il suo falcetto fu forgiato nel calore della pira funeraria di un altro cinereo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173651&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f0d608b5-d688-438a-a6e8-74082b9a0158\', \'multiverseId\': 173651}, \'multiverseid\': 173651}, {\'name\': \'鎌の切り裂き魔\', \'text\': \'萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\', \'type\': \'クリーチャー — エレメンタル・戦士\', \'flavor\': \'彼の鎌は、別な燃えがらの葬送の火で焼き入れられている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173952&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3a68ecf4-cd5d-4307-a25a-a93fc6e847d7\', \'multiverseId\': 173952}, \'multiverseid\': 173952}, {\'name\': \'Estripador da Foice\', \'text\': \'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\', \'type\': \'Criatura — Elemental Guerreiro\', \'flavor\': \'Sua foice fora forjada na pira funerária de outro cinzeríneo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172146&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8fd65cf6-af89-4bdc-b3ac-ac1e897773e1\', \'multiverseId\': 172146}, \'multiverseid\': 172146}, {\'name\': \'Потрошитель с Серпом\', \'text\': \'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\', \'type\': \'Существо — Элементаль Воин\', \'flavor\': \'Его серп был выкован на огне погребального костра другого золовика.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172447&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9b326444-36d2-4814-910f-cf18d81cfb01\', \'multiverseId\': 172447}, \'multiverseid\': 172447}, {\'name\': \'镰刀夺魂妖\', \'text\': \'干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\', \'type\': \'生物～元素／战士\', \'flavor\': \'其镰刀系以其他烬身的葬火所加温打造。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173049&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44bab2c9-468e-4495-b4e2-d37e2e8fd41f\', \'multiverseId\': 173049}, \'multiverseid\': 173049}]', '[{\'name\': \'Sonne-und-Mond-Rad\', \'text\': \'Spielerverzauberung\\nFalls eine Karte von irgendwoher auf den Friedhof des verzauberten Spielers gelegt würde, wird die Karte stattdessen offen vorgezeigt und unter die Bibliothek dieses Spielers gelegt.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Jedes Leben endet irgendwann, nur das Leben selbst nie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174720&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'49201816-4ff6-4660-9955-052418732c35\', \'multiverseId\': 174720}, \'multiverseid\': 174720}, {\'name\': \'Rueda del sol y la luna\', \'text\': \'Encantar jugador.\\nSi una carta fuera a ser puesta en el cementerio del jugador encantado desde cualquier parte, en vez de eso, se muestra esa carta y se la pone en el fondo de la biblioteca de ese jugador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Toda vida termina, pero la vida misma no lo hace.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172914&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a198e40d-375b-43da-8548-ae4eb7e7298e\', \'multiverseId\': 172914}, \'multiverseid\': 172914}, {\'name\': \'Roue du soleil et de la lune\', \'text\': "Enchanter : joueur\\nSi une carte devait être mise dans le cimetière du joueur enchanté depuis n\'importe où, cette carte est révélée et mise au-dessous de la bibliothèque de ce joueur à la place.", \'type\': \'Enchantement : aura\', \'flavor\': "Chaque vie se termine, mais la vie elle-même n\'en finit pas.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173516&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec888105-2427-4ad1-870f-ee1614c4ade8\', \'multiverseId\': 173516}, \'multiverseid\': 173516}, {\'name\': \'Ruota del Sole e della Luna\', \'text\': \'Incanta giocatore\\nSe una carta sta per essere messa nel cimitero del giocatore incantato da qualsiasi zona, quella carta viene invece rivelata e messa in fondo al grimorio di quel giocatore.\', \'type\': \'Incantesimo — Aura\', \'flavor\': \'Ogni vita termina, ma mai la vita stessa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173817&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'87ebe86a-ea9d-442a-b430-ee71b499bce7\', \'multiverseId\': 173817}, \'multiverseid\': 173817}, {\'name\': \'太陽と月の輪\', \'text\': \'エンチャント（プレイヤー）\\nいずれかのカードがいずれかの領域からエンチャントされているプレイヤーの墓地に置かれる場合、代わりにそのカードを公開してそのプレイヤーのライブラリーの一番下に置く。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'すべての生命には終わりがあるが、生命自身が終わることはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174118&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f5dc7188-0cfe-417c-9683-0bae095c4b86\', \'multiverseId\': 174118}, \'multiverseid\': 174118}, {\'name\': \'Roda do Sol e da Lua\', \'text\': \'Encantar jogador\\nSe um card for ser colocado no cemitério do jogador encantado vindo de qualquer lugar, em vez disso, aquele card será revelado e colocado no fundo do grimório daquele jogador.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Todas as vidas terminam, mas a vida em si nunca termina.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172312&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d654f818-14fb-4bbe-a4d1-32a97c9b87e1\', \'multiverseId\': 172312}, \'multiverseid\': 172312}, {\'name\': \'Колесо Солнца и Луны\', \'text\': \'Зачаровать игрока\\nЕсли карта должна быть положена откуда-либо на кладбище зачарованного игрока, вместо этого та карта показывается и кладется в низ библиотеки того игрока.\', \'type\': \'Чары — Аура\', \'flavor\': \'Жизни каждого приходит конец, но сама жизнь никогда не кончается.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172613&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0974290-0fa1-4239-8b5c-7dd6591b7c2e\', \'multiverseId\': 172613}, \'multiverseid\': 172613}, {\'name\': \'日月回轮\', \'text\': \'牌手结界\\n若任一张牌将从任何区域置入受此结界之牌手的坟墓场，则改为展示该牌并将它置于该牌手的牌库底。\', \'type\': \'结界～灵气\', \'flavor\': \'每个生命都会结束，但生命本身没有尽头。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173215&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e205050e-0c99-4c84-af3c-42cc5770e003\', \'multiverseId\': 173215}, \'multiverseid\': 173215}]', '[{\'name\': \'Spiegelgewebe\', \'text\': \'Alle anderen Kreaturen werden bis zum Ende des Zuges zu einer Kopie einer nichtlegendären Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Diejenigen, die nicht sind wie wir, sind unzuverlässig und unberechenbar. Lege deine Sicherheit in die Hände deines eigenen Volkes." —Bowen, Kapitän der Wache von Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174620&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'85e34fd1-c5a2-4418-b146-b748cbed497e\', \'multiverseId\': 174620}, \'multiverseid\': 174620}, {\'name\': \'Tejido especular\', \'text\': \'Cada otra criatura es una copia de la criatura objetivo que no sea legendaria hasta el final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Aquellos que son distintos no son confiables, son impredecibles. Pon tu seguridad en manos de tu propia gente." —Bowen, capitán de la guardia de Bárrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172814&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9efe232d-a918-4e59-aabc-37d59b12a360\', \'multiverseId\': 172814}, \'multiverseid\': 172814}, {\'name\': \'Tisse-miroir\', \'text\': "Chaque autre créature devient une copie de la créature non-légendaire ciblée jusqu\'à la fin du tour.", \'type\': \'Éphémère\', \'flavor\': \'« Ceux qui sont différents sont imprévisibles et traîtres. Place ta sécurité entre les mains de tes congénères. » —Bowen, capitaine de la garde de Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173416&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b312cc0c-509d-4445-88cc-87455d447637\', \'multiverseId\': 173416}, \'multiverseid\': 173416}, {\'name\': \'Trama a Specchio\', \'text\': \'Ogni altra creatura diventa una copia di una creatura non leggendaria bersaglio fino alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Coloro che sono differenti non meritano fiducia, sono imprevedibili. Affida la tua sicurezza a quelli della tua stirpe." —Bowen, capitano delle guardie di Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173717&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'71d136bd-7e05-4a84-9e30-831428eebf7f\', \'multiverseId\': 173717}, \'multiverseid\': 173717}, {\'name\': \'鏡編み\', \'text\': \'伝説でないクリーチャー１体を対象とする。ターン終了時まで、他の各クリーチャーはそれのコピーになる。\', \'type\': \'インスタント\', \'flavor\': \'「違ってる奴は、信頼もできないし、予想もできない。 安全ってものは自分の仲間の手の中にしまっとくもんだ。」 ――バレントンの護衛長、ボウエン\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174018&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'b357cb0c-a835-4882-b62b-5c0e12fd552d\', \'multiverseId\': 174018}, \'multiverseid\': 174018}, {\'name\': \'Espelho Prolífero\', \'text\': \'Cada outra criatura se torna uma cópia da criatura alvo que não seja lendária até o final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Aqueles que são diferentes são traiçoeiros e imprevisíveis. Coloque sua segurança nas mãos do seu próprio povo." — Bowen, capitão da guarda de Barrenton\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172212&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8c302234-45cb-4b44-86c6-ca637a879313\', \'multiverseId\': 172212}, \'multiverseid\': 172212}, {\'name\': \'Зеркальный Узор\', \'text\': \'Каждое другое существо становится копией целевого нелегендарного существа до конца хода.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Те, кто не похожи на нас, непредсказуемы и не заслуживают доверия. Вверяй свою безопасность только в руки своих соплеменников». — Боуэн, командир стражников Баррентона\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172513&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'50dae945-b284-4702-b8f6-24ab0c89bc5e\', \'multiverseId\': 172513}, \'multiverseid\': 172513}, {\'name\': \'纺镜咒\', \'text\': \'所有其他生物成为目标非传奇生物的复制直到回合结束。\', \'type\': \'瞬间\', \'flavor\': \'「那些跟我们不一样的家伙既不可靠又难以捉摸。 把安全交在自己人手上吧。」 ～八连屯卫队长伯文\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173115&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a310406a-915c-4f75-94dc-ed23c2bc7d1a\', \'multiverseId\': 173115}, \'multiverseid\': 173115}]', '[{\'name\': \'Stahl der Gottheit\', \'text\': \'Kreaturenverzauberung\\nSolange die verzauberte Kreatur weiß ist, erhält sie +1/+1 und hat Lebensverknüpfung. (Immer wenn die Kreatur Schaden zufügt, erhält ihr Beherrscher ebenso viele Lebenspunkte dazu.)\\nSolange die verzauberte Kreatur blau ist, erhält sie +1/+1 und ist unblockbar.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174627&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'17e0c9f6-4fe5-40dc-9676-63bd59e98edd\', \'multiverseId\': 174627}, \'multiverseid\': 174627}, {\'name\': \'Acero de la deidad\', \'text\': \'Encantar criatura.\\nMientras la criatura encantada sea blanca, obtiene +1/+1 y tiene la habilidad de vínculo vital. (Siempre que haga daño, su controlador gana esa cantidad de vida.)\\nMientras la criatura encantada sea azul, obtiene +1/+1 y es imbloqueable.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172821&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ec05e837-e3e6-49ff-b4f3-0b90c48c1165\', \'multiverseId\': 172821}, \'multiverseid\': 172821}, {\'name\': \'Acier de la divinité\', \'text\': "Enchanter : créature\\nTant que la créature enchantée est blanche, elle gagne +1/+1 et elle a le lien de vie. (À chaque fois qu\'elle inflige des blessures, son contrôleur gagne autant de points de vie.)\\nTant que la créature enchantée est bleue, elle gagne +1/+1 et elle est imblocable.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173423&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5f22a75-7ac1-4e40-95b7-6db4e3b7b162\', \'multiverseId\': 173423}, \'multiverseid\': 173423}, {\'name\': \'Acciaio della Divinità\', \'text\': \'Incanta creatura\\nFintanto che la creatura incantata è bianca, prende +1/+1 e ha legame vitale. (Ogniqualvolta questa creatura infligge danno, il suo controllore guadagna altrettanti punti vita.)\\nFintanto che la creatura incantata è blu, prende +1/+1 e non può essere bloccata.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173724&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d0a3165e-c045-47e7-8a01-6cab2b5cf881\', \'multiverseId\': 173724}, \'multiverseid\': 173724}, {\'name\': \'神格の鋼\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーが白であるかぎり、それは＋１/＋１の修整を受けるとともに絆魂を持つ。 （それがダメージを与えるたび、それのコントローラーはその点数に等しい点数のライフを得る。）\\nエンチャントされているクリーチャーが青であるかぎり、それは＋１/＋１の修整を受けるとともにブロックされない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174025&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9bfd191-c8c2-4ad0-bb97-3e654b8477ff\', \'multiverseId\': 174025}, \'multiverseid\': 174025}, {\'name\': \'Aço da Divindade\', \'text\': \'Encantar criatura\\nEnquanto a criatura encantada for branca, ela receberá +1/+1 e terá vínculo com a vida. (Toda vez que causa dano, seu controlador ganha uma quantidade correspondente de pontos de vida.)\\nEnquanto a criatura encantada for azul, ela receberá +1/+1 e não poderá ser bloqueada.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172219&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4a03eb75-22da-4d2a-b411-2871d1287ee7\', \'multiverseId\': 172219}, \'multiverseid\': 172219}, {\'name\': \'Сталь Богини\', \'text\': \'Зачаровать существо\\nПока зачарованное существо белое, оно получает +1/+1 и имеет Цепь жизни. (Каждый раз, когда оно наносит повреждения, контролирующий его игрок получает столько же жизней.)\\nПока зачарованное существо синее, оно получает +1/+1 и не может быть заблокировано.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172520&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'02f6b5f3-ab34-4a03-8fcd-fa1967170d76\', \'multiverseId\': 172520}, \'multiverseid\': 172520}, {\'name\': \'神性兵器\', \'text\': \'生物结界\\n只要受此结界的生物是白色，它便得+1/+1且具有系命异能。 （每当它造成伤害时，其操控者获得等量的生命。）\\n只要受此结界的生物是蓝色，它便得+1/+1且不能被阻挡。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173122&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'e12d98b7-a9ad-4f86-8063-965eda0a8e76\', \'multiverseId\': 173122}, \'multiverseid\': 173122}]', '[{\'name\': \'Stegreifüberfall\', \'text\': \'{2}{R/G}: Decke die oberste Karte deiner Bibliothek auf. Falls es keine Kreaturenkarte ist, lege sie auf deinen Friedhof. Bringe sonst die Karte ins Spiel. Die Kreatur hat Eile. Opfere sie am Ende des Zuges.\', \'type\': \'Verzauberung\', \'flavor\': \'Für die Schmutzrückenbande ist es immer Angriffszeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174686&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8b348e3c-d3b7-4581-aa48-a44b5486bc56\', \'multiverseId\': 174686}, \'multiverseid\': 174686}, {\'name\': \'Incursión improvisada\', \'text\': \'{2}{R/G}: Muestra la primera carta de tu biblioteca. Si no es una carta de criatura, ponla en tu cementerio. De lo contrario, pon en juego esa carta. Esa criatura tiene la habilidad de prisa. Sacrifícala al final del turno.\', \'type\': \'Encantamiento\', \'flavor\': \'Para la banda Scuzzback, siempre es "hora de una incursión"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172880&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'89f7fcd5-56a7-4f79-904f-46a123da9508\', \'multiverseId\': 172880}, \'multiverseid\': 172880}, {\'name\': \'Raid impromptu\', \'text\': "{2}o(r/g) : Révélez la carte du dessus de votre bibliothèque. Si ce n\'est pas une carte de créature, mettez-la dans votre cimetière. Sinon, mettez cette carte en jeu. Cette créature a la célérité. Sacrifiez-la à la fin du tour.", \'type\': \'Enchantement\', \'flavor\': \'Avec le gang de Crassedos, ça tue toujours « raide ».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173482&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'311695c6-4419-4ad6-8a75-04cc2a2a0534\', \'multiverseId\': 173482}, \'multiverseid\': 173482}, {\'name\': \'Razzia Improvvisata\', \'text\': \'{2}{R/G}: Rivela la prima carta del tuo grimorio. Se non è una carta creatura, mettila nel tuo cimitero. Altrimenti, metti in gioco quella carta. Quella creatura ha rapidità. Sacrificala alla fine del turno.\', \'type\': \'Incantesimo\', \'flavor\': \'Per la banda di Scozzaschiena, è sempre "l\\\'ora di razziare".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173783&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7472bf01-71bb-4a92-bbb6-96ee70c82272\', \'multiverseId\': 173783}, \'multiverseid\': 173783}, {\'name\': \'場当たりな襲撃\', \'text\': \'{2}{R/G}：あなたのライブラリーの一番上のカードを公開する。 それがクリーチャー・カードでない場合、それをあなたの墓地に置く。そうでない場合、そのカードを場に出す。 そのクリーチャーは速攻を持つ。 ターン終了時にそれを生け贄に捧げる。\', \'type\': \'エンチャント\', \'flavor\': \'汚れ背の連中にとっては、いつだって「襲い時」だ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174084&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3f1a6ea8-d0a7-4668-8977-c3fdc319322f\', \'multiverseId\': 174084}, \'multiverseid\': 174084}, {\'name\': \'Ataque Improvisado\', \'text\': \'{2}{R/G}: Revele o card do topo de seu grimório. Se não for um card de criatura, coloque-o no seu cemitério. Do contrário, coloque-o em jogo. Aquela criatura tem ímpeto. Sacrifique-a no final do turno.\', \'type\': \'Encantamento\', \'flavor\': \'Para a gangue de Costas Sujas, é sempre "hora de ataque".\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172278&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7ed5f46f-aa22-4108-be0e-acc9d74a17ec\', \'multiverseId\': 172278}, \'multiverseid\': 172278}, {\'name\': \'Неожиданный Набег\', \'text\': \'{2}{R/G}: покажите верхнюю карту вашей библиотеки. Если это не карта существа, положите ее на ваше кладбище. В противном случае, положите ту карту в игру. То существо имеет Ускорение. В конце хода пожертвуйте его.\', \'type\': \'Чары\', \'flavor\': \'Для банды грязеспинов любой час хорош для набега.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172579&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3866cecf-f530-4dc6-847d-44841385a97b\', \'multiverseId\': 172579}, \'multiverseid\': 172579}, {\'name\': \'随兴掠夺\', \'text\': \'{2}{R/G}：展示你的牌库顶牌。 若该牌不是生物牌，则将它置入你的坟墓场。若是生物牌，则将该牌放置进场。 该生物具有敏捷异能。 在回合结束时将之牺牲。\', \'type\': \'结界\', \'flavor\': \'对杂背帮来说，天天都是打劫天。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173181&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e3b5d1c-de59-4f62-a16b-d881ef4f7577\', \'multiverseId\': 173181}, \'multiverseid\': 173181}]', '[{\'name\': \'Stolperschlinge\', \'text\': \'{2}, {T}: Tappe eine Kreatur deiner Wahl.\', \'type\': \'Artefakt\', \'flavor\': \'Eine Schlaufe und ein straff gespannter Auslöser bewirken oft Wunder.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174743&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'5e259c0c-f036-4db8-8c22-6185cb8bbbdf\', \'multiverseId\': 174743}, \'multiverseid\': 174743}, {\'name\': \'Trampa nudo de horca\', \'text\': \'{2}, {T}: Gira la criatura objetivo.\', \'type\': \'Artefacto\', \'flavor\': \'Un nudo de horca tenso es lo único que se alza entre tú y tu voluntad de alzarte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172937&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eb3b68b5-ec05-4684-899c-42debb8e39c1\', \'multiverseId\': 172937}, \'multiverseid\': 172937}, {\'name\': \'Collet\', \'text\': \'{2}, {T} : Engagez la créature ciblée.\', \'type\': \'Artefact\', \'flavor\': \'Un simple nœud coulant est la seule chose qui vous empêche de tenir debout.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173539&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f461d5ed-ab28-4148-bf74-1c642828ce56\', \'multiverseId\': 173539}, \'multiverseid\': 173539}, {\'name\': \'Calappio Intralciante\', \'text\': \'{2}, {T}: TAPpa una creatura bersaglio.\', \'type\': \'Artefatto\', \'flavor\': "Un calappio teso a terra e pronto a scattare è l\'unica cosa che separa te dalla terra.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173840&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1cd98e3b-a989-4652-b2e8-9d586167addd\', \'multiverseId\': 173840}, \'multiverseid\': 173840}, {\'name\': \'首吊り罠\', \'text\': \'{2}, {T}：クリーチャー１体を対象とし、それをタップする。\', \'type\': \'アーティファクト\', \'flavor\': \'ぴんと張った結び綱は、お前の立場を立ち消えにする唯一のものだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174141&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f7d8ded2-989e-4d47-9f02-d066ddd943e6\', \'multiverseId\': 174141}, \'multiverseid\': 174141}, {\'name\': \'Nó de Viagem\', \'text\': \'{2}, {T}: Vire a criatura alvo.\', \'type\': \'Artefato\', \'flavor\': \'Um gatilho com nós corrediços rígidos é a única coisa que há entre você e sua posição estática.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172335&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'4cb887db-7a4e-40ec-912c-3c19f8410ab8\', \'multiverseId\': 172335}, \'multiverseid\': 172335}, {\'name\': \'Петля-Подножка\', \'text\': \'{2}, {T}: поверните целевое существо.\', \'type\': \'Артефакт\', \'flavor\': \'Хитроумно затянутый узел может стать для вас головоломным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172636&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d5097e81-c9ed-4832-ab03-33b38abc26e7\', \'multiverseId\': 172636}, \'multiverseid\': 172636}, {\'name\': \'绊索绳套\', \'text\': \'{2}，{T}：横置目标生物。\', \'type\': \'神器\', \'flavor\': \'拉紧的活结起动机制，是你与站姿之间唯一的障碍。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173238&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a9f1fd66-4c67-482e-ba34-1e64503fae4e\', \'multiverseId\': 173238}, \'multiverseid\': 173238}]', "[{'name': 'Strahlenspiegelung', 'text': 'Falls du Lebenspunkte dazuerhalten würdest, erhältst du stattdessen doppelt so viele Lebenspunkte dazu.', 'type': 'Verzauberung', 'flavor': 'Kithkinheiler singen über dem dampfenden Gebräu die Clanlieder beider Elternteile, um den Heileffekt zu verdoppeln.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174482&type=card', 'language': 'German', 'identifiers': {'scryfallId': '43d8a74d-8030-440c-b3f4-9552c9b4d85b', 'multiverseId': 174482}, 'multiverseid': 174482}, {'name': 'Reflejo de dádiva', 'text': 'Si fueras a ganar vida, en vez de eso, ganas el doble de esas vidas.', 'type': 'Encantamiento', 'flavor': 'Los sanadores kithkin cantan las canciones del clan de sus dos padres sobre el caldo para duplicar su efecto curativo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172676&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '56022398-ea94-4485-b824-0461ccf66357', 'multiverseId': 172676}, 'multiverseid': 172676}, {'name': 'Réverbération de faveur', 'text': 'Si vous deviez gagner des points de vie, vous gagnez deux fois ce nombre de points de vie à la place.', 'type': 'Enchantement', 'flavor': 'Les guérisseurs sangamis psalmodient le chant du clan de leurs deux parents au-dessus du bouillon pour doubler ses effets curatifs.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173278&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ff39fe66-ec00-4260-a694-3312c4e5ffad', 'multiverseId': 173278}, 'multiverseid': 173278}, {'name': 'Riflesso di Guarigione', 'text': 'Se stai per guadagnare punti vita, guadagni invece il doppio di quei punti vita.', 'type': 'Incantesimo', 'flavor': 'I guaritori kithkin intonano le canzoni dei clan di entrambi i loro genitori per raddoppiare gli effetti curativi della brodaglia.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173579&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'e51ea3f8-54c0-48e9-8217-8ac0b78d6555', 'multiverseId': 173579}, 'multiverseid': 173579}, {'name': '加護の反射', 'text': 'あなたがライフを得る場合、代わりにあなたはその２倍の点数のライフを得る。', 'type': 'エンチャント', 'flavor': 'キスキンの癒し手は、両親それぞれの一族の歌を薬の煮汁に捧げることで、治療の力を倍化させている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173880&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '6a898249-0823-4bac-9994-c5951930c293', 'multiverseId': 173880}, 'multiverseid': 173880}, {'name': 'Reflexo de Dádiva', 'text': 'Se você for ganhar pontos de vida, em vez disso, ganhará o dobro daquela quantidade em pontos de vida.', 'type': 'Encantamento', 'flavor': 'Os curandeiros kithkin cantam os cânticos dos clãs dos pais e das mães durante a preparação do caldo para duplicar seu efeito curativo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172074&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '2353435d-2afe-4f28-8331-4e5a212e93aa', 'multiverseId': 172074}, 'multiverseid': 172074}, {'name': 'Отражение Блага', 'text': 'Если вы должны получить определенное количество жизней, вы получаете их вдвое больше вместо этого.', 'type': 'Чары', 'flavor': 'Кискенские лекари распевают песни клана обоих родителей, колдуя над отваром, чтобы удвоить его целебные свойства.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172375&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'aa976c85-76ae-4266-8d43-45e51caa479a', 'multiverseId': 172375}, 'multiverseid': 172375}, {'name': '恩泽映象', 'text': '若你将获得生命，则改为你获得该数量两倍的生命。', 'type': '结界', 'flavor': '洁英医者煮药汤时，会吟诵父母双方的部族歌谣，好让医疗效果加倍。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172977&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'dfb593ab-04b9-4643-8de9-10896fb01c68', 'multiverseId': 172977}, 'multiverseid': 172977}]", '[{\'name\': \'Sturzbach aus Seelen\', \'text\': \'Bringe bis zu einer Kreatur deiner Wahl aus deinem Friedhof ins Spiel zurück, falls {B} ausgegeben wurde, um Sturzbach aus Seelen zu spielen. Alle Kreaturen, die ein Spieler deiner Wahl kontrolliert, erhalten bis zum Ende des Zuges Eile und +2/+0, falls {R} ausgegeben wurde, um Sturzbach aus Seelen zu spielen. (Mache beides, falls {B}{R} ausgegeben wurde.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174676&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e11959ce-c79d-4f04-be96-e5319f32d39b\', \'multiverseId\': 174676}, \'multiverseid\': 174676}, {\'name\': \'Torrente de almas\', \'text\': \'Regresa al juego hasta una carta de criatura objetivo de tu cementerio si se usó {B} para jugar el Torrente de almas. Las criaturas que controla el jugador objetivo obtienen +2/+0 y ganan la habilidad de prisa hasta el final del turno si se usó {R} para jugar el Torrente de almas. (Haz ambos si se usó {B}{R}.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172870&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'66bc69e0-a0b2-4e53-be0a-a2ee42275090\', \'multiverseId\': 172870}, \'multiverseid\': 172870}, {\'name\': "Torrent d\'âmes", \'text\': "Renvoyez en jeu jusqu\'à une carte de créature ciblée de votre cimetière si {B} a été dépensé pour jouer le Torrent d\'âmes. Les créatures que le joueur ciblé contrôle gagnent +2/+0 et acquièrent la célérité jusqu\'à la fin du tour si {R} a été dépensé pour jouer le Torrent d\'âmes. (Faites les deux si {B}{R} a été dépensé.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173472&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'11e42e39-97f5-43ce-aea3-c2ff57d980a4\', \'multiverseId\': 173472}, \'multiverseid\': 173472}, {\'name\': \'Torrente delle Anime\', \'text\': \'Rimetti in gioco fino a una carta creatura bersaglio dal tuo cimitero se è stato speso {B} per giocare il Torrente delle Anime. Le creature controllate da un giocatore bersaglio prendono +2/+0 e hanno rapidità fino alla fine del turno, se è stato speso {R} per giocare il Torrente delle Anime. (Compi entrambe le azioni se è stato speso {B}{R}.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173773&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b4a02fc4-0cd8-445c-8801-2a98c90528b4\', \'multiverseId\': 173773}, \'multiverseid\': 173773}, {\'name\': \'魂魄流\', \'text\': \'魂魄流をプレイするために{B}が支払われている場合、あなたの墓地にあるクリーチャー・カードを最大１枚まで対象とし、それを場に戻す。 魂魄流をプレイするために{R}が支払われている場合、プレイヤー１人を対象とする。ターン終了時まで、そのプレイヤーがコントロールするクリーチャーは＋２/＋０の修整を受けるとともに速攻を得る。 （{B}{R}が支払われている場合、両方を行う。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174074&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'874e1ebb-7690-4220-8171-2bc7c7da49d9\', \'multiverseId\': 174074}, \'multiverseid\': 174074}, {\'name\': \'Torrente de Almas\', \'text\': \'Devolva até um card de criatura alvo de seu cemitério ao jogo se {B} foi gasto para jogar Torrente de Almas. As criaturas que o jogador alvo controla recebem +2/+0 e ganham ímpeto até o final do turno se {R} foi gasto para jogar Torrente de Almas. (Faça ambas as coisas se {B}{R} foi gasto.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172268&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'464fe2fa-933a-4ff1-958f-b1b9de498095\', \'multiverseId\': 172268}, \'multiverseid\': 172268}, {\'name\': \'Поток Душ\', \'text\': \'Верните не более одной целевой карты существа из вашего кладбища в игру, если на разыгрывание Потока Душ было потрачено {B}. Существа под контролем целевого игрока получают +2/+0 и Ускорение до конца хода, если на разыгрывание Потока Душ было потрачено {R}. (Сделайте и то и другое, если было потрачено {B}{R}.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172569&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'cdd020c1-00a0-4785-873f-54f97b728030\', \'multiverseId\': 172569}, \'multiverseid\': 172569}, {\'name\': \'灵魂奔流\', \'text\': \'如果使用灵魂奔流时支付了{B}，则将至多一张目标生物牌从你的坟墓场移回场上。 如果使用灵魂奔流时支付了{R}，则直到回合结束，由目标牌手操控的生物得+2/+0且获得敏捷异能。 （如果支付了{B}{R}，则两者都作。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173171&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9b84e63f-e36c-4b92-88fc-4e9b3e028cc2\', \'multiverseId\': 173171}, \'multiverseid\': 173171}]', "[{'name': 'Suche der Sichermacher', 'text': 'Durchsuche deine Bibliothek nach einer Wald- oder Ebenenkarte, zeige diese Karte offen vor und nimm sie auf deine Hand. Mische danach deine Bibliothek.', 'type': 'Hexerei', 'flavor': 'Elfen suchen nach Resten von Schönheit in einer Welt der Nacht. Währenddessen dürstet es der Welt der Nacht nach dem Blut der Elfen.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174717&type=card', 'language': 'German', 'identifiers': {'scryfallId': '968041e0-d991-4baa-a345-91410168fece', 'multiverseId': 174717}, 'multiverseid': 174717}, {'name': 'Misión del refugiante', 'text': 'Busca en tu biblioteca una carta de bosque o llanura, muéstrala y ponla en tu mano. Luego baraja tu biblioteca.', 'type': 'Conjuro', 'flavor': 'Los elfos buscan fuentes de belleza en un mundo nocturno. Mientras tanto, el mundo nocturno busca la sangre de los elfos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172911&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '962ac81b-0e4e-4e2d-b1d8-27c2c50b9ef8', 'multiverseId': 172911}, 'multiverseid': 172911}, {'name': 'Quête du protecturge', 'text': 'Cherchez dans votre bibliothèque une carte de forêt ou de plaine, révélez-la et mettez-la dans votre main. Mélangez ensuite votre bibliothèque.', 'type': 'Rituel', 'flavor': 'Les elfes recherchent des sources de beauté dans un monde enveloppé par la nuit. Pendant ce temps, le monde enveloppé par la nuit recherche le sang des elfes.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173513&type=card', 'language': 'French', 'identifiers': {'scryfallId': '39c5035f-65ab-4192-b7f9-8aa2a22fa5c5', 'multiverseId': 173513}, 'multiverseid': 173513}, {'name': 'Missione dei Salvaincanti', 'text': 'Passa in rassegna il tuo grimorio per una carta Foresta o Pianura, rivelala e aggiungila alla tua mano. Poi rimescola il tuo grimorio.', 'type': 'Stregoneria', 'flavor': 'Gli elfi cercano fonti di bellezza in un mondo oscurato. Nel frattempo, il mondo oscurato brama il sangue degli elfi.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173814&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b299807d-7b89-4968-80b6-0f8cd38933c9', 'multiverseId': 173814}, 'multiverseid': 173814}, {'name': '守美者の探索', 'text': 'あなたのライブラリーから森カードか平地カードを１枚探し、それを公開してあなたの手札に加える。 その後あなたのライブラリーを切り直す。', 'type': 'ソーサリー', 'flavor': 'エルフは夜に覆われた世界に美の源を求めている。 一方で、夜に覆われた世界はエルフの血を求めている。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174115&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3b4a0ef0-a400-4d39-84e8-4717f35d03ac', 'multiverseId': 174115}, 'multiverseid': 174115}, {'name': 'Missão do Pulcro-Protetor', 'text': 'Procure em seu grimório por um card de Floresta ou de Planície, revele-o e coloque-o em sua mão. Depois, embaralhe seu grimório.', 'type': 'Feitiço', 'flavor': 'Os elfos buscam por fontes de beleza num mundo anoitecido. Enquanto isso, o mundo anoitecido busca o sangue dos elfos.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172309&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '86217b69-59a6-43aa-9254-332ce1945618', 'multiverseId': 172309}, 'multiverseid': 172309}, {'name': 'Поход Охранителей', 'text': 'Найдите в вашей библиотеке карту Леса или Равнины, покажите ее и положите в вашу руку. Затем перетасуйте вашу библиотеку.', 'type': 'Волшебство', 'flavor': 'Эльфы ищут источники красоты в темном как ночь мире. А в это самое время ночной мир ищет крови эльфов.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172610&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '65855701-22c1-4523-bf7e-991644cb9412', 'multiverseId': 172610}, 'multiverseid': 172610}, {'name': '美境卫的探索', 'text': '从你的牌库中搜寻一张树林或平原牌，展示该牌，并将它置于你手上。 然后将你的牌库洗牌。', 'type': '法术', 'flavor': '地精在永夜世界中寻觅美的来源。 同时，这永夜世界也寻觅着地精的血。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173212&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a3022e0b-5df2-4c01-b430-ae0b095388a4', 'multiverseId': 173212}, 'multiverseid': 173212}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177810&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a0b65c02-2644-4ca4-9c0b-79238ecad67c', 'multiverseId': 177810}, 'multiverseid': 177810}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177834&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'bc9af40d-f89e-4fed-a0ce-cf1d6619162e', 'multiverseId': 177834}, 'multiverseid': 177834}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177881&type=card', 'language': 'French', 'identifiers': {'scryfallId': '844c8880-2f21-4293-b642-020feac22556', 'multiverseId': 177881}, 'multiverseid': 177881}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177905&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f06030d1-3324-45b5-9b42-6388410cb7c4', 'multiverseId': 177905}, 'multiverseid': 177905}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177786&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cf3547a9-14a7-4295-9c8d-06e50cd29ecb', 'multiverseId': 177786}, 'multiverseid': 177786}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177762&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '359a1bff-215f-48ab-bfa9-08cf6a6273bc', 'multiverseId': 177762}, 'multiverseid': 177762}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177738&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'e3c8f64c-a222-49fb-8e15-46825552beb4', 'multiverseId': 177738}, 'multiverseid': 177738}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177857&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '77c6708d-5071-4820-8109-2ae9251352ec', 'multiverseId': 177857}, 'multiverseid': 177857}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177811&type=card', 'language': 'German', 'identifiers': {'scryfallId': '959de3fe-57ed-45d8-8343-9e646c4a115d', 'multiverseId': 177811}, 'multiverseid': 177811}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177835&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd3f4aa28-f126-4443-b2bb-37156a188335', 'multiverseId': 177835}, 'multiverseid': 177835}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177882&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'e1c3cf1d-b282-4bfa-be07-75b34b8c3402', 'multiverseId': 177882}, 'multiverseid': 177882}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177906&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8b964901-cb69-4783-8f1f-fbbff08bc659', 'multiverseId': 177906}, 'multiverseid': 177906}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177787&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c928029a-5500-472d-8232-1e3295cf061d', 'multiverseId': 177787}, 'multiverseid': 177787}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177763&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '79ab2f68-5881-4c0c-858a-b4c9ac0a155b', 'multiverseId': 177763}, 'multiverseid': 177763}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177739&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0695631e-f9ad-4d15-91e4-ead6f272c43b', 'multiverseId': 177739}, 'multiverseid': 177739}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177858&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '93960c5e-74d0-4423-81ab-48342d4d5b04', 'multiverseId': 177858}, 'multiverseid': 177858}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177812&type=card', 'language': 'German', 'identifiers': {'scryfallId': '892e7a2e-59db-4afd-bff3-a7e1637130fb', 'multiverseId': 177812}, 'multiverseid': 177812}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177836&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '2476a45a-c15e-46a0-8075-d74da93b5912', 'multiverseId': 177836}, 'multiverseid': 177836}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177883&type=card', 'language': 'French', 'identifiers': {'scryfallId': '9093ed58-c350-4c0b-a7e6-4c67da00830a', 'multiverseId': 177883}, 'multiverseid': 177883}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177907&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'cf2cd864-9525-4784-9c80-5b346752d4f9', 'multiverseId': 177907}, 'multiverseid': 177907}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177788&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a1eb925e-6952-44db-b2b7-88d5d73e582d', 'multiverseId': 177788}, 'multiverseid': 177788}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177764&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '670022a4-c99b-4050-b455-1b94278e5f93', 'multiverseId': 177764}, 'multiverseid': 177764}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177740&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '7540dea8-1c90-486a-bc69-bab9ef54acbd', 'multiverseId': 177740}, 'multiverseid': 177740}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177859&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '658e9284-0769-4b35-af94-1a0e869ff2dc', 'multiverseId': 177859}, 'multiverseid': 177859}]", "[{'name': 'Sumpf', 'type': 'Standardland — Sumpf', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177813&type=card', 'language': 'German', 'identifiers': {'scryfallId': '9db08f8d-1df3-4c22-b646-392fb65e60a5', 'multiverseId': 177813}, 'multiverseid': 177813}, {'name': 'Pantano', 'type': 'Tierra básica — Pantano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177837&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd68d6242-32f8-4efe-ab1a-f342c78137ba', 'multiverseId': 177837}, 'multiverseid': 177837}, {'name': 'Marais', 'type': 'Terrain de base : marais', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177884&type=card', 'language': 'French', 'identifiers': {'scryfallId': '02c70a22-6c44-4e80-861c-131f7b196074', 'multiverseId': 177884}, 'multiverseid': 177884}, {'name': 'Palude', 'type': 'Terra Base — Palude', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177908&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c9f63655-32b1-4695-84a3-464f0265faa2', 'multiverseId': 177908}, 'multiverseid': 177908}, {'name': '沼', 'type': '基本土地 — 沼', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177789&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'd09d5c0b-c7a3-4be8-9c1a-7d796860d0c7', 'multiverseId': 177789}, 'multiverseid': 177789}, {'name': 'Pântano', 'type': 'Terreno Básico — Pântano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177765&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'd43af874-f154-46e1-a7d6-b3ea3886d575', 'multiverseId': 177765}, 'multiverseid': 177765}, {'name': 'Болото', 'type': 'Базовая Земля — Болото', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177741&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'aca93cd6-35fa-4e7d-ac06-9015c406f315', 'multiverseId': 177741}, 'multiverseid': 177741}, {'name': '沼泽', 'type': '基本地～沼泽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177860&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '8f24b462-6421-454f-ba27-f3ea84b09435', 'multiverseId': 177860}, 'multiverseid': 177860}]", '[{\'name\': \'Sygg, Flussmeuchler\', \'text\': \'Du kannst am Ende des Zuges eine Karte ziehen, falls ein Gegner in diesem Zug 3 oder mehr Lebenspunkte verloren hat. (Schaden verursacht den Verlust von Lebenspunkten.)\', \'type\': \'Legendäre Kreatur — Meervolk, Räuber\', \'flavor\': \'„Es ist egal, wer es verdient hat. Nur auf die Stärke kommt es an. Die Kraft, es festzuhalten, gegen die Kraft, es zu rauben."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174653&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2bb8e0d4-6dec-46d4-af62-f36a7a76308f\', \'multiverseId\': 174653}, \'multiverseid\': 174653}, {\'name\': \'Sygg, degollador del río\', \'text\': \'Al final del turno, si un oponente perdió 3 o más vidas este turno, puedes robar una carta. (El daño causa pérdida de vida.)\', \'type\': \'Criatura legendaria — Bribón tritón\', \'flavor\': \'"El problema no es merecerlo. El problema es la fortaleza. El poder de retener contra el poder de tomar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172847&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60cfcba7-473d-4c35-a668-265cf7f61ead\', \'multiverseId\': 172847}, \'multiverseid\': 172847}, {\'name\': \'Sygg, surineur de rivière\', \'text\': \'À la fin du tour, si un adversaire a perdu au moins 3 points de vie ce tour-ci, vous pouvez piocher une carte. (Les blessures provoquent la perte de points de vie.)\', \'type\': \'Créature légendaire : ondin et gredin\', \'flavor\': "« Ce n\'est pas une question de mérite, mais une question de force. Le pouvoir de garder ou le pouvoir de prendre. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173449&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a5f5a2da-66a0-48f9-bb57-679a96fb87ae\', \'multiverseId\': 173449}, \'multiverseid\': 173449}, {\'name\': \'Sygg, Tagliagole Fluviale\', \'text\': \'Alla fine del turno, se un avversario ha perso 3 o più punti vita in questo turno, puoi pescare una carta. (Il danno causa la perdita di punti vita.)\', \'type\': \'Creatura Leggendaria — Farabutto Tritone\', \'flavor\': \'"Non è una questione di merito. È una questione di forza. La forza di trattenere contro quella di afferrare."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173750&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f5f6b14a-cb0b-480c-93d6-6ee2a3329e88\', \'multiverseId\': 173750}, \'multiverseid\': 173750}, {\'name\': \'川の殺し屋、シグ\', \'text\': \'ターン終了時に、いずれかの対戦相手がこのターンに３点以上のライフを失っている場合、あなたはカードを１枚引いてもよい。 （ダメージによりライフは失われる。）\', \'type\': \'伝説のクリーチャー — マーフォーク・ならず者\', \'flavor\': \'「価値がどうって問題じゃない。 強さが問題なんだ。 守る力と持ち去る力の関係さ。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174051&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a047fac-0f2b-4b21-8764-3eed63f7b6fe\', \'multiverseId\': 174051}, \'multiverseid\': 174051}, {\'name\': \'Sygg, Degolador do Rio\', \'text\': \'No final do turno, se um oponente perdeu 3 ou mais pontos de vida neste turno, você pode comprar um card. (O dano causa perda de pontos de vida.)\', \'type\': \'Criatura Lendária — Tritão Ladino\', \'flavor\': \'"Não é uma questão de merecer. É uma questão de força. O poder de ter versus o poder de tomar."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172245&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'eeba9a41-f8cc-49e7-b2e8-a454d20cd095\', \'multiverseId\': 172245}, \'multiverseid\': 172245}, {\'name\': \'Сигг, Речной Головорез\', \'text\': \'В конце хода, если оппонент потерял 3 или больше жизней в этом ходу, вы можете взять карту. (Повреждения вызывают потерю жизней.)\', \'type\': \'Легендарное Существо — Мерфолк Бродяга\', \'flavor\': \'«Это не вопрос справедливой заслуги. Это вопрос силы. Кто сильнее тот, кто пытается удержать, или тот, кто пытается отнять?»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172546&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ec8ffb0c-2a5a-48af-8967-421c8f2a7f82\', \'multiverseId\': 172546}, \'multiverseid\': 172546}, {\'name\': \'河流割喉人席格\', \'text\': \'在回合结束时，若某位对手在本回合中失去了3点或更多生命，你可以抓一张牌。 （伤害会导致失去生命。）\', \'type\': \'传奇生物～人鱼／浪客\', \'flavor\': \'「这不是有无资格的问题， 而是力量的问题。 这是保有之力与夺取之力的对决。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173148&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'09b162c5-3e2c-4690-8535-04897e13984d\', \'multiverseId\': 173148}, \'multiverseid\': 173148}]', '[{\'name\': \'Tarnzauber-Leger\', \'text\': \'Aufblitzen\\nFliegend\\nWenn der Tarnzauber-Leger ins Spiel kommt, lege alle Auren, die eine bleibende Karte deiner Wahl verzaubern, an eine andere bleibende Karte des gleichen Beherrschers an.\', \'type\': \'Kreatur — Feenwesen, Zauberer\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174618&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d767c618-29c3-4518-b7b2-50ac16fb3d3a\', \'multiverseId\': 174618}, \'multiverseid\': 174618}, {\'name\': \'Hiladoras de ilusiones\', \'text\': \'Destello.\\nVuela.\\nCuando las Hiladoras de ilusiones entren en juego, anexa todas las auras que estén encantando el permanente objetivo a otro permanente objetivo con el mismo controlador.\', \'type\': \'Criatura — Hechicero hada\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172812&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b036099-71cb-4176-b76a-91e0f14d0641\', \'multiverseId\': 172812}, \'multiverseid\': 172812}, {\'name\': "Fileurs d\'illusions", \'text\': "Flash\\nVol\\nQuand les Fileurs d\'illusions arrivent en jeu, attachez toutes les auras enchantant le permanent ciblé à un autre permanent ayant le même contrôleur.", \'type\': \'Créature : peuple fée et sorcier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173414&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e18cdf07-c792-4a2f-92a9-e3303d2bb158\', \'multiverseId\': 173414}, \'multiverseid\': 173414}, {\'name\': \'Tessitori di Insidie\', \'text\': \'Lampo\\nVolare\\nQuando i Tessitori di Insidie entrano in gioco, assegna tutte le Aure che incantano un permanente bersaglio a un altro permanente controllato dallo stesso giocatore.\', \'type\': \'Creatura — Mago Spiritello\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173715&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'da5dbaf9-9971-4186-b059-239c71b302fe\', \'multiverseId\': 173715}, \'multiverseid\': 173715}, {\'name\': \'魔法を回す者\', \'text\': \'瞬速\\n飛行\\n魔法を回す者が場に出たとき、パーマネント１つを対象とする。それにつけられているすべてのオーラを、コントローラーが同じである他のパーマネント１つにつける。\', \'type\': \'クリーチャー — フェアリー・ウィザード\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174016&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0ab44c16-6e06-4772-be8d-a67bcb878332\', \'multiverseId\': 174016}, \'multiverseid\': 174016}, {\'name\': \'Pivotantes de Glamir\', \'text\': \'Lampejo\\nVoar\\nQuando Pivotantes de Glamir entrar em jogo, anexe todas as Auras encantando a permanente alvo a outra permanente com o mesmo controlador.\', \'type\': \'Criatura — Fada Mago\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172210&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2afbf8d3-91e0-4a2c-8291-299d3e0799aa\', \'multiverseId\': 172210}, \'multiverseid\': 172210}, {\'name\': \'Прядильщики Заговоров\', \'text\': \'Миг\\nПолет\\nКогда Прядильщики Заговоров входят в игру, прикрепите все Ауры, зачаровывающие целевой перманент, к другому перманенту под контролем того же игрока.\', \'type\': \'Существо — Фея Чародей\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172511&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a3f6c7f9-ab06-4617-939c-3957dfbf346f\', \'multiverseId\': 172511}, \'multiverseid\': 172511}, {\'name\': \'幻法旋舞师\', \'text\': \'闪现\\n飞行\\n当幻法旋舞师进场时，将结附在目标永久物上的所有灵气结附到另一个永久物上，且两个永久物的操控者须相同。\', \'type\': \'生物～仙灵／法术师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173113&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6227ece-8735-40ff-8715-922a3dbbaec1\', \'multiverseId\': 173113}, \'multiverseid\': 173113}]', "[{'name': 'Tetanus-Schnapper', 'text': 'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nWenn der Tetanus-Schnapper aus dem Spiel auf den Friedhof gelegt wird, lege auf jede Kreatur mit mindestens einer -1/-1-Marke eine weitere -1/-1-Marke.', 'type': 'Artefaktkreatur — Vogelscheuche', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174732&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5a346c43-1cf0-4691-a34d-4eebf98241cd', 'multiverseId': 174732}, 'multiverseid': 174732}, {'name': 'Mordedor trampero', 'text': 'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\\nCuando el Mordedor trampero vaya a un cementerio desde el juego, pon un contador -1/-1 sobre cada criatura con un contador -1/-1 sobre ella.', 'type': 'Criatura artefacto — Espantapájaros', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172926&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '34f9aefc-8a47-44ed-8f5a-4d5312de5f78', 'multiverseId': 172926}, 'multiverseid': 172926}, {'name': 'Claqueur tétanique', 'text': 'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nQuand le Claqueur tétanique est mis dans un cimetière depuis le jeu, mettez un marqueur -1/-1 sur chaque créature avec un marqueur -1/-1 sur elle.', 'type': 'Créature-artefact : épouvantail', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173528&type=card', 'language': 'French', 'identifiers': {'scryfallId': '937dfe5c-7b9b-4db4-a5c6-17ef1ddb56f9', 'multiverseId': 173528}, 'multiverseid': 173528}, {'name': 'Mandibola Mordace', 'text': 'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nQuando la Mandibola Mordace viene messa in un cimitero dal gioco, metti un segnalino -1/-1 su ogni creatura con un segnalino -1/-1.', 'type': 'Creatura Artefatto — Spaventapasseri', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173829&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'feaa2119-50ff-4cc1-9213-454eb26c30b3', 'multiverseId': 173829}, 'multiverseid': 173829}, {'name': '閉じ顎の噛みつき', 'text': '萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\n閉じ顎の噛みつきが場からいずれかの墓地に置かれたとき、－１/－１カウンターが置かれている各クリーチャーの上にそれぞれ－１/－１カウンターを１個置く。', 'type': 'アーティファクト・クリーチャー — カカシ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174130&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'f6ddc1ab-436a-4f59-8005-8119b0dd3116', 'multiverseId': 174130}, 'multiverseid': 174130}, {'name': 'Mordedor com Tetania', 'text': 'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\\nQuando Mordedor com Tetania for colocado no cemitério vindo do jogo, coloque um marcador -1/-1 em cada criatura com um marcador -1/-1.', 'type': 'Criatura Artefato — Espantalho', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172324&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '687b8b01-9b4f-4abf-a5b8-6aa2352a0458', 'multiverseId': 172324}, 'multiverseid': 172324}, {'name': 'Столбнячный Кусака', 'text': 'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\\nКогда Столбнячный Кусака попадает из игры на кладбище, положите один жетон -1/-1 на каждое существо с жетоном -1/-1 на нем.', 'type': 'Артефактное Существо — Пугало', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172625&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'acf3e4cd-8f8f-4f88-8254-aa1fdf02e34d', 'multiverseId': 172625}, 'multiverseid': 172625}, {'name': '紧咬草人', 'text': '干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\\n当紧咬草人从场上置入坟墓场时，在每个上面有-1/-1指示物的生物上各放置一个-1/-1指示物。', 'type': '神器生物～稻草人', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173227&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '5e8bd5e9-10ce-4b08-9f92-8bc58233f0b2', 'multiverseId': 173227}, 'multiverseid': 173227}]", '[{\'name\': \'Tiefroter Hauch\', \'text\': \'Eine Kreatur deiner Wahl wird bis zum Ende des Zuges rot und hat Eile.\\nZiehe eine Karte.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die geflüsterten Töne klingen schleierhaft, doch Rußwesen können immer die dringende Botschaft aus ihnen heraushören.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174565&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4c724060-5978-4a18-9515-64acb70dfb83\', \'multiverseId\': 174565}, \'multiverseid\': 174565}, {\'name\': \'Centellas carmesí\', \'text\': \'La criatura objetivo es roja y gana la habilidad de prisa hasta el final del turno.\\nRoba una carta.\', \'type\': \'Instantáneo\', \'flavor\': \'Los susurros son incomprensibles, pero los cenicientos siempre escuchan un mensaje urgente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172759&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c59b168d-67ab-419b-8f2a-c8a6846cbb7c\', \'multiverseId\': 172759}, \'multiverseid\': 172759}, {\'name\': \'Feux pourpres\', \'text\': "La créature ciblée devient rouge et acquiert la célérité jusqu\'à la fin du tour.\\nPiochez une carte.", \'type\': \'Éphémère\', \'flavor\': \'Les murmures sont incompréhensibles, et pourtant les scoriacés y perçoivent toujours un message urgent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173361&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'34bb73a4-317a-4c82-98be-0978b1a4b97d\', \'multiverseId\': 173361}, \'multiverseid\': 173361}, {\'name\': \'Fuochi Fatui Cremisi\', \'text\': \'Una creatura bersaglio diventa rossa e ha rapidità fino alla fine del turno.\\nPesca una carta.\', \'type\': \'Istantaneo\', \'flavor\': \'Quei sussurri sono incomprensibili, eppure i cinerei vi odono sempre un messaggio di allerta.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173662&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'30f7df67-bb09-4582-84e6-8de9cda6f6db\', \'multiverseId\': 173662}, \'multiverseid\': 173662}, {\'name\': \'たなびく真紅\', \'text\': \'クリーチャー１体を対象とする。それはターン終了時まで赤になるとともに速攻を得る。\\nカードを１枚引く。\', \'type\': \'インスタント\', \'flavor\': \'ささやきは不可解であるが、燃えがら達はその中の緊急のメッセージを常に聞き分ける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173963&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9816b04b-1ddd-43fb-88ea-f0e3758f96c4\', \'multiverseId\': 173963}, \'multiverseid\': 173963}, {\'name\': \'Fogos-Fátuos Escarlates\', \'text\': \'A criatura alvo torna-se vermelha e ganha ímpeto até o final do turno.\\nCompre um card.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os sussurros são incompreensíveis, mas ainda assim os cinzeríneos sempre ouvem uma mensagem urgente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172157&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc80c763-7126-433a-9e33-0f3e56e87afe\', \'multiverseId\': 172157}, \'multiverseid\': 172157}, {\'name\': \'Багровые Огоньки\', \'text\': \'Целевое существо становится красным и получает Ускорение до конца хода.\\nВозьмите карту.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Их шепот и шелест абсолютно непонятны, но золовики всегда услышат срочное послание.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172458&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'668374dc-c62d-4684-84dc-c921537b5a5d\', \'multiverseId\': 172458}, \'multiverseid\': 172458}, {\'name\': \'深红鬼火\', \'text\': \'直到回合结束，目标生物成为红色且具有敏捷异能。\\n抓一张牌。\', \'type\': \'瞬间\', \'flavor\': \'在这难解细语中，烬身依旧能听到紧急讯息。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173060&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a52f64a1-dbdc-4211-be71-447821310cc3\', \'multiverseId\': 173060}, \'multiverseid\': 173060}]', '[{\'name\': \'Tintentiefen-Infiltrator\', \'text\': \'Der Tintentiefen-Infiltrator kann nicht blocken und ist unblockbar.\', \'type\': \'Kreatur — Meervolk, Räuber\', \'flavor\': \'Niemand durchquert das feuchte Labyrinth der Flüsse im Schattenmoor schneller als die grausamen und gierigen Merrow. Sie verwenden die Strömungen, um zu stehlen — und um sich davonzustehlen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174644&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26eff6da-92de-4fc5-941a-665c153643e4\', \'multiverseId\': 174644}, \'multiverseid\': 174644}, {\'name\': \'Espía de Tinta Profunda\', \'text\': \'La Espía de Tinta Profunda es imbloqueable y no puede bloquear.\', \'type\': \'Criatura — Bribón tritón\', \'flavor\': \'Nadie puede navegar el laberinto de ríos del Páramo Sombrío mejor que los crueles merrow. Usan las corrientes para robar y secuestrar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172838&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'071e6a0d-cf01-4b49-846d-d2399278cd42\', \'multiverseId\': 172838}, \'multiverseid\': 172838}, {\'name\': "Infiltratrice d\'Encrebrasse", \'text\': "L\'Infiltratrice d\'Encrebrasse ne peut pas bloquer et elle est imblocable.", \'type\': \'Créature : ondin et gredin\', \'flavor\': \'Personne ne connaît mieux le marécageux labyrinthe des rivières de Sombrelande que les cruels et avides suires. Les courants leur servent pour leurs larcins et leurs enlèvements.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173440&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'78d9ab82-0306-4560-a18d-1e23196683dc\', \'multiverseId\': 173440}, \'multiverseid\': 173440}, {\'name\': \'Infiltrata di Batinchiostro\', \'text\': "L\'Infiltrata di Batinchiostro non può bloccare e non può essere bloccata.", \'type\': \'Creatura — Farabutto Tritone\', \'flavor\': \'Nessuno riesce a navigare negli umidi labirinti fluviali della Landa Tenebrosa meglio dei crudeli e avidi merrow. Sfruttano le correnti per avanzare furtivi... e per rubare.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173741&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2c92efa6-90af-4467-a36a-67c588d30580\', \'multiverseId\': 173741}, \'multiverseid\': 173741}, {\'name\': \'墨深みの浸透者\', \'text\': \'墨深みの浸透者ではブロックできず、それはブロックされない。\', \'type\': \'クリーチャー — マーフォーク・ならず者\', \'flavor\': \'シャドウムーアの川の薄ら寒い迷路を一番うまく抜けるのは、冷酷で強欲なメロウだ。 彼らは水流を盗みに――そして逃走に用いる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174042&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0d73ac21-2e83-441e-8748-73c61010785e\', \'multiverseId\': 174042}, \'multiverseid\': 174042}, {\'name\': \'Infiltrado Braçatinta\', \'text\': \'Infiltrado Braçatinta não pode bloquear e não pode ser bloqueado.\', \'type\': \'Criatura — Tritão Ladino\', \'flavor\': \'Ninguém pode navegar pelos labirintos úmidos dos rios de Pântano Sombrio melhor que os cruéis e gananciosos sirenídeos. Eles usam as correntes para roubar e fugir silenciosamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172236&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3085519d-0b0d-46f6-92cb-f9be38e784b1\', \'multiverseId\': 172236}, \'multiverseid\': 172236}, {\'name\': \'Шпион Черноводья\', \'text\': \'Шпион Черноводья не может блокировать и не может быть заблокирован.\', \'type\': \'Существо — Мерфолк Бродяга\', \'flavor\': \'Никто так хорошо не знаком с илистым лабирнтом рек Шэдоумура, как жестокие и алчные мерроу. Течения помогают им двигаться украдкой и, конечно же, красть.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172537&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'42620d23-a883-4167-a305-4170a6a6277b\', \'multiverseId\': 172537}, \'multiverseid\': 172537}, {\'name\': \'墨湛渗透者\', \'text\': \'墨湛渗透者不能进行阻挡，也不能被阻挡。\', \'type\': \'生物～人鱼／浪客\', \'flavor\': \'只有残酷又贪婪的美洛，才能在暗影荒原河流所形成的潮湿迷阵间为你领航。 他们利用潮流来偷窃与匿踪。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173139&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7491de20-dab6-4b12-ae1e-09d6e5994c24\', \'multiverseId\': 173139}, \'multiverseid\': 173139}]', '[{\'name\': \'Tintentiefenhexer\', \'text\': \'Verursacht Furcht\\n{2}{U}{B}: Alle ungeblockten Kreaturen werden 4/1 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Meervolk, Zauberer\', \'flavor\': \'Der Schlamm im Wanderessig verbirgt unziemliche Rituale, die das Schlechteste in den Merrow hervorbringen sollen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174645&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'93c68b9d-e085-4c79-9dbe-8b05fa950cb6\', \'multiverseId\': 174645}, \'multiverseid\': 174645}, {\'name\': \'Bruja de Tinta Profunda\', \'text\': \'Inspirar temor.\\n{2}{U}{B}: Cada criatura no bloqueada es 4/1 hasta el final del turno.\', \'type\': \'Criatura — Hechicero tritón\', \'flavor\': \'El cieno del Lágrimaerrante esconde rituales diseñados para sacar lo peor de los merrow.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172839&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1d88775-5d80-430d-8aa6-bbdc9353d3ca\', \'multiverseId\': 172839}, \'multiverseid\': 172839}, {\'name\': "Envoûteur d\'Encrebrasse", \'text\': "Peur\\n{2}{U}{B} : Chaque créature non-bloquée devient 4/1 jusqu\'à la fin du tour.", \'type\': \'Créature : ondin et sorcier\', \'flavor\': "Les eaux troubles de la Bruinerrance cachaient de terribles rituels conçus pour éveiller tout ce qu\'il y avait de pire chez les suires.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173441&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c59254b2-0267-4011-bd23-933809df94b0\', \'multiverseId\': 173441}, \'multiverseid\': 173441}, {\'name\': \'Stregone di Batinchiostro\', \'text\': \'Paura\\n{2}{U}{B}: Ogni creatura non bloccata diventa 4/1 fino alla fine del turno.\', \'type\': \'Creatura — Mago Tritone\', \'flavor\': "L\'oscurità del Brina Errante nascose gli indecenti rituali ideati per tirare fuori il peggio dalle menti merrow.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173742&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'31b235ff-3c06-4a3b-9d64-94c5a44a08d2\', \'multiverseId\': 173742}, \'multiverseid\': 173742}, {\'name\': \'墨深みの魔女\', \'text\': \'畏怖\\n{2}{U}{B}：ブロックされていない各クリーチャーはターン終了時まで４/１になる。\', \'type\': \'クリーチャー — マーフォーク・ウィザード\', \'flavor\': \'ワンダーブラインの濁りは、メロウの中でも最悪の者を呼び出す無作法な儀式を覆い隠している。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174043&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5a53d81-5e5f-482c-bd15-66b1a6bfdfcc\', \'multiverseId\': 174043}, \'multiverseid\': 174043}, {\'name\': \'Bruxa Braçatinta\', \'text\': \'Amedrontar\\n{2}{U}{B}: Cada criatura não bloqueada se torna 4/1 até o final do turno.\', \'type\': \'Criatura — Tritão Mago\', \'flavor\': \'As trevas de Salmorerrante escondem rituais indecorosos cujo objetivo é liberar o pior lado dos sirenídeos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172237&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'007d070b-3374-4f45-9b8f-bc88bb4304a5\', \'multiverseId\': 172237}, \'multiverseid\': 172237}, {\'name\': \'Ведьма Черноводья\', \'text\': \'Страх\\n{2}{U}{B}: каждое незаблокированное существо становится 4/1 до конца хода.\', \'type\': \'Существо — Мерфолк Чародей\', \'flavor\': \'Мрачные воды Уондербрайна скрывали отвратительные ритуалы, выявляющие наихудшие черты народа мерроу.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172538&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f25a3d7f-5e93-4540-8b06-e40b78ba1718\', \'multiverseId\': 172538}, \'multiverseid\': 172538}, {\'name\': \'墨湛法术师\', \'text\': \'恐惧\\n{2}{U}{B}：每个未受阻挡的生物均成为4/1直到回合结束。\', \'type\': \'生物～人鱼／法术师\', \'flavor\': \'漫涩河的淤泥有如掩藏了各种粗鲁仪式，把美洛一族教养得更加恶毒。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173140&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'90d674fb-a934-4d4f-82fa-fcfc8d8c8fc1\', \'multiverseId\': 173140}, \'multiverseid\': 173140}]', "[{'name': 'Titan im Tiefschlaf', 'text': 'Der Titan im Tiefschlaf kommt getappt ins Spiel.\\nDer Titan im Tiefschlaf enttappt nicht während deines Enttappsegments.\\nImmer wenn dem Titan im Tiefschlaf Schaden zugefügt wird, enttappe ihn.', 'type': 'Kreatur — Riese, Krieger', 'flavor': 'Bitte nicht stören.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174566&type=card', 'language': 'German', 'identifiers': {'scryfallId': '156db727-3d82-4852-a17f-782bbe447961', 'multiverseId': 174566}, 'multiverseid': 174566}, {'name': 'Titán del sopor profundo', 'text': 'El Titán del sopor profundo entra en juego girado.\\nEl Titán del sopor profundo no se endereza durante tu paso de enderezar.\\nSiempre que el Titán del sopor profundo reciba daño, enderézalo.', 'type': 'Criatura — Guerrero gigante', 'flavor': 'No molestar.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172760&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '9b3dd87b-c683-4ce8-b316-11952fbbef1e', 'multiverseId': 172760}, 'multiverseid': 172760}, {'name': 'Titan au sommeil profond', 'text': 'Le Titan au sommeil profond arrive en jeu engagé.\\nLe Titan au sommeil profond ne se dégage pas pendant votre étape de dégagement.\\nÀ chaque fois que le Titan au sommeil profond subit des blessures, dégagez-le.', 'type': 'Créature : géant et guerrier', 'flavor': 'Ne pas déranger.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173362&type=card', 'language': 'French', 'identifiers': {'scryfallId': '2c610e8d-b384-4428-8d6e-2edd8d40299e', 'multiverseId': 173362}, 'multiverseid': 173362}, {'name': 'Titano dal Sonno Pesante', 'text': 'Il Titano dal Sonno Pesante entra in gioco TAPpato.\\nIl Titano dal Sonno Pesante non STAPpa durante il tuo STAP.\\nOgniqualvolta viene inflitto danno al Titano dal Sonno Pesante, STAPpalo.', 'type': 'Creatura — Guerriero Gigante', 'flavor': 'Non disturbare.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173663&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '3903fe82-6dd5-40c4-8865-0b076c8f08c1', 'multiverseId': 173663}, 'multiverseid': 173663}, {'name': '深い眠りのタイタン', 'text': '深い眠りのタイタンはタップ状態で場に出る。\\n深い眠りのタイタンは、あなたのアンタップ・ステップにアンタップしない。\\n深い眠りのタイタンにダメージが与えられるたび、それをアンタップする。', 'type': 'クリーチャー — 巨人・戦士', 'flavor': '起こすべからず。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173964&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'ed91af63-63f5-4015-992e-8c37e0e4f7d1', 'multiverseId': 173964}, 'multiverseid': 173964}, {'name': 'Titã Sono-Profundo', 'text': 'Titã Sono-Profundo entra em jogo virado.\\nTitã Sono-Profundo não desvira durante sua etapa de desvirar.\\nToda vez que Titã Sono-Profundo sofrer dano, desvire-o.', 'type': 'Criatura — Gigante Guerreiro', 'flavor': 'Não perturbe.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172158&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5d21cd91-f76d-4899-b6cf-9401f35cc42d', 'multiverseId': 172158}, 'multiverseid': 172158}, {'name': 'Титан Векового Сна', 'text': 'Титан Векового Сна входит в игру повернутым.\\nТитан Векового Сна не разворачивется во время вашего шага разворота.\\nКаждый раз, когда Титану Векового Сна наносятся повреждения, разверните его.', 'type': 'Существо — Гигант Воин', 'flavor': 'Не беспокоить', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172459&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'fec17d8e-5ee8-400a-9df9-1a18d6292081', 'multiverseId': 172459}, 'multiverseid': 172459}, {'name': '沉眠泰坦', 'text': '沉眠泰坦须横置进场。\\n沉眠泰坦于你的重置步骤中不能重置。\\n每当沉眠泰坦受到伤害时，将它重置。', 'type': '生物～巨人／战士', 'flavor': '切勿打扰。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173061&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ea92cc3c-06c2-4be1-98e4-196ffc1f3bbc', 'multiverseId': 173061}, 'multiverseid': 173061}]", '[{\'name\': \'Traktieren\', \'text\': \'Ein Spieler deiner Wahl wirft alle Karten aus seiner Hand ab, falls er nicht 7 Lebenspunkte bezahlt.\', \'type\': \'Hexerei\', \'flavor\': \'„Ich kann dich so stechen, dass es wehtut, oder dass du überhaupt nichts verspürst." —Illulia von der Nachtesse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174678&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6a2190f3-22e2-4836-952a-96de7bf6be52\', \'multiverseId\': 174678}, \'multiverseid\': 174678}, {\'name\': \'Tiranizar\', \'text\': \'El jugador objetivo descarta su mano a menos que pague 7 vidas.\', \'type\': \'Conjuro\', \'flavor\': \'"Puedo apuñalarte donde te duela, o donde no sientas nada." —Illulia de Fogón Nocturno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172872&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'52a57c6c-5814-4387-9b69-475aad6f17fc\', \'multiverseId\': 172872}, \'multiverseid\': 172872}, {\'name\': \'Tyranniser\', \'text\': "Le joueur ciblé se défausse de sa main à moins qu\'il ne paie 7 points de vie.", \'type\': \'Rituel\', \'flavor\': \'« Je vous poignarderai là où ça fait mal, ou là où vous ne sentirez absolument rien. » —Illulia des Noctâtres\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173474&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'de7d49ee-d6a4-4bd6-984b-c1b772fcf548\', \'multiverseId\': 173474}, \'multiverseid\': 173474}, {\'name\': \'Tirannizzare\', \'text\': \'Un giocatore bersaglio scarta la sua mano a meno che non paghi 7 punti vita.\', \'type\': \'Stregoneria\', \'flavor\': \'"Posso pugnalarti dove fa male, o dove non sentiresti assolutamente niente." —Illulia del Tetro Focolare\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173775&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41222ae4-e0d7-4945-bbc8-e1cc8b8f6931\', \'multiverseId\': 173775}, \'multiverseid\': 173775}, {\'name\': \'圧制\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーが７点のライフを支払わないかぎり、そのプレイヤーは自分の手札を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': \'「痛いところを刺すことも、ぜんぜん感じないところを刺すこともできるのだよ。」 ――ナイトハースのイルリア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174076&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'123c8661-043c-40ed-a990-708ffd3616e3\', \'multiverseId\': 174076}, \'multiverseid\': 174076}, {\'name\': \'Tiranizar\', \'text\': \'O jogador alvo descarta a própria mão, a menos que ele pague 7 pontos de vida.\', \'type\': \'Feitiço\', \'flavor\': \'"Eu posso apunhalá-lo onde você sentirá dor ou onde não sentirá absolutamente nada." — Illulia, dos Larescuro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172270&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ebb4f2e7-01ca-46ff-9a49-c6f324768367\', \'multiverseId\': 172270}, \'multiverseid\': 172270}, {\'name\': \'Тирания\', \'text\': \'Целевой игрок сбрасывает свою руку, если он не заплатит 7 жизней.\', \'type\': \'Волшебство\', \'flavor\': \'«Я могу ранить вас так, чтоб было очень больно, или так, чтобы вы абсолютно ничего не почувствовали». — Иллулия из культа темносветов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172571&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1b12af02-3e99-45e0-86e9-44a1c776e9e8\', \'multiverseId\': 172571}, \'multiverseid\': 172571}, {\'name\': \'欺压\', \'text\': \'除非目标牌手支付7点生命，否则他弃掉其手牌。\', \'type\': \'法术\', \'flavor\': \'「我可以刺在让你痛苦的地方，或是让你毫无感觉的地方。」 ～夜炉的伊璐里\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173173&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f04ca99-f7bb-4bdd-a9ab-2c73d7c5464f\', \'multiverseId\': 173173}, \'multiverseid\': 173173}]', '[{\'name\': \'Traumbergung\', \'text\': \'Ziehe so viele Karten, wie ein Gegner deiner Wahl in diesem Zug abgeworfen hat.\', \'type\': \'Spontanzauber\', \'flavor\': \'Awylla versuchte, die Schrecken zu vergessen, die sie gesehen hatte. Doch jemand anderes schien genau das verhindern zu wollen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174637&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b2049bf-d46e-4856-aceb-bb7528ed9501\', \'multiverseId\': 174637}, \'multiverseid\': 174637}, {\'name\': \'Botín del sueño\', \'text\': \'Roba una cantidad de cartas igual a la cantidad de cartas que el oponente objetivo descartó este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'Awylla intentó olvidar los horrores que había visto, pero alguien más se había interesado por ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172831&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e23e9fa8-a417-4066-a896-4f0224f20b43\', \'multiverseId\': 172831}, \'multiverseid\': 172831}, {\'name\': \'Récupération de rêve\', \'text\': "Piochez un nombre de cartes égal au nombre de cartes dont l\'adversaire ciblé s\'est défaussé ce tour-ci.", \'type\': \'Éphémère\', \'flavor\': "Awylla essayait d\'oublier les horreurs qu\'elle avait vues, mais quelqu\'un d\'autre s\'y était intéressé de très près.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173433&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a669b9b7-274d-4a40-a4be-31146365f03a\', \'multiverseId\': 173433}, \'multiverseid\': 173433}, {\'name\': \'Riciclo di Sogni\', \'text\': \'Pesca un numero di carte pari a quelle scartate da un avversario bersaglio in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'Awylla tentò con ogni mezzo di dimenticare gli orrori che aveva visto, ma qualcun altro aveva sviluppato un acuto interesse per essi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173734&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'205db746-90bb-4d8d-ae20-8847c2560527\', \'multiverseId\': 173734}, \'multiverseid\': 173734}, {\'name\': \'夢の回収\', \'text\': \'プレイヤー１人を対象とする。このターン、そのプレイヤーが捨てたカードの枚数に等しい枚数のカードを引く。\', \'type\': \'インスタント\', \'flavor\': \'アウィラは自分が見た恐るべきものを懸命に忘れようとしたが、別な誰かはそこに鋭く興味を持った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174035&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82af8edc-9bc2-43b3-b857-0b4b762114a5\', \'multiverseId\': 174035}, \'multiverseid\': 174035}, {\'name\': \'Resgatar Sonhos\', \'text\': \'Compre uma quantidade de cards igual ao número de cards que o oponente alvo descartou neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Awylla tentou de todos os modos esquecer os horrores que vira, mas alguém desenvolveu um grande interesse por eles.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172229&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'79adaadf-3a4f-48a7-936d-b525c2bd32d2\', \'multiverseId\': 172229}, \'multiverseid\': 172229}, {\'name\': \'Спасение Снов\', \'text\': \'Возьмите столько карт, сколько карт целевой оппонент сбросил в этом ходу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Авилла изо всех сил пыталась забыть увиденные ужасы, но кое-кто еще начал проявлять к ним большой интерес.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172530&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ecc20ba9-afcc-43dc-814f-942ba30c1a2c\', \'multiverseId\': 172530}, \'multiverseid\': 172530}, {\'name\': \'回收眠梦\', \'text\': \'抓若干牌，其数量等同于目标对手本回合所弃的牌数量。\', \'type\': \'瞬间\', \'flavor\': \'艾薇拉努力想忘掉曾目睹的恐怖，但早有他人看上了这份记忆。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173132&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12870525-249d-4df6-8f87-5505ba45e42a\', \'multiverseId\': 173132}, \'multiverseid\': 173132}]', '[{\'name\': \'Trotzflammenhexe\', \'text\': \'{B}{R}: Alle Spieler verlieren 1 Lebenspunkt.\', \'type\': \'Kreatur — Elementarwesen, Schamane\', \'flavor\': \'Der Glaube der Rußwesen dreht sich um den Pfad der Sorgen, einem geistigen Abstieg in das Vergessen. Es macht ihnen nichts aus, andere dabei mitzunehmen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174674&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a2d996fe-b253-43fc-abd9-475819ca3c83\', \'multiverseId\': 174674}, \'multiverseid\': 174674}, {\'name\': \'Bruja despecho ardiente\', \'text\': \'{B}{R}: Cada jugador pierde 1 vida.\', \'type\': \'Criatura — Chamán elemental\', \'flavor\': \'Las creencias de los cenicientos se basan en el Camino del Dolor, un descenso espiritual hacia el olvido. No les preocupa arrastrar a otros con ellos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172868&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'75659b79-e3d6-4d0f-b0a3-f05604f2fa73\', \'multiverseId\': 172868}, \'multiverseid\': 172868}, {\'name\': \'Envoûteuse aigreflamme\', \'text\': \'{B}{R} : Chaque joueur perd 1 point de vie.\', \'type\': \'Créature : élémental et shamane\', \'flavor\': "Les croyances scoriacées sont basées sur la Voie de la Tristesse, une descente spirituelle dans le néant. C\'est une quête qu\'ils sont toujours ravis de partager avec autrui.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173470&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6cf5880-0913-4ea0-bf99-aee6a6313be4\', \'multiverseId\': 173470}, \'multiverseid\': 173470}, {\'name\': \'Strega della Fiamma Dispettosa\', \'text\': \'{B}{R}: Ogni giocatore perde 1 punto vita.\', \'type\': \'Creatura — Sciamano Elementale\', \'flavor\': "Le tradizioni cineree si basano sul Sentiero del Dolore, una discesa spirituale nell\'oblio. Non disdegnano di portare altri con loro in questi viaggi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173771&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'af32800c-ed19-42bd-ae38-68f388df9b7d\', \'multiverseId\': 173771}, \'multiverseid\': 173771}, {\'name\': \'悪意炎の魔女\', \'text\': \'{B}{R}：各プレイヤーは１点のライフを失う。\', \'type\': \'クリーチャー — エレメンタル・シャーマン\', \'flavor\': \'燃えがらの信仰は、忘却の彼方へと消えた精霊の系列「悲しみの道」を基盤としている。 だから彼らは、他人をそこへと誘う事をためらわない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174072&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'942a3ca5-29a9-416e-abb1-b0528b64d093\', \'multiverseId\': 174072}, \'multiverseid\': 174072}, {\'name\': \'Bruxa da Chama Maliciosa\', \'text\': \'{B}{R}: Cada jogador perde 1 ponto de vida.\', \'type\': \'Criatura — Elemental Xamã\', \'flavor\': \'As crenças dos cinzeríneos estão relacionadas ao Caminho da Dor, um declínio espiritual em direção ao esquecimento. Eles não se importam de levar outros com eles no caminho para baixo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172266&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7eb09f8f-962a-4bb3-85bd-b4d3e9f6c758\', \'multiverseId\': 172266}, \'multiverseid\': 172266}, {\'name\': \'Ведьма Злобного Пламени\', \'text\': \'{B}{R}: каждый игрок теряет 1 жизнь.\', \'type\': \'Существо — Элементаль Шаман\', \'flavor\': \'Верования золовиков строятся вокруг Пути Страданий погружения в духовное забвение. На пути вниз они не прочь прихватить с собой еще кого-нибудь.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172567&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aeff9b78-d0fe-4b06-a6de-697335b0b45b\', \'multiverseId\': 172567}, \'multiverseid\': 172567}, {\'name\': \'怨火法术师\', \'text\': \'{B}{R}：每位牌手各失去1点生命。\', \'type\': \'生物～元素／祭师\', \'flavor\': \'烬身的信念建立在伤痛之道上面，也就是让精神沉沦入空无的过程。 他们并不介意带人同行。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173169&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f6651c20-87c2-4dc9-ae99-81453bf6626e\', \'multiverseId\': 173169}, \'multiverseid\': 173169}]', '[{\'name\': \'Trutzburg-Duo\', \'text\': \'Immer wenn du einen grünen Zauber spielst, erhält das Trutzburg-Duo +1/+1 bis zum Ende des Zuges.\\nImmer wenn du einen weißen Zauber spielst, erhält das Trutzburg-Duo bis zum Ende des Zuges Wachsamkeit.\', \'type\': \'Kreatur — Elf, Krieger, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174715&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'559288ae-e610-4e67-823b-5b4767968c06\', \'multiverseId\': 174715}, \'multiverseid\': 174715}, {\'name\': \'Dúo del refugio seguro\', \'text\': \'Siempre que juegues un hechizo verde, el Dúo del refugio seguro obtiene +1/+1 hasta el final del turno.\\nSiempre que juegues un hechizo blanco, el Dúo del refugio seguro gana la habilidad de vigilancia hasta el final del turno.\', \'type\': \'Criatura — Chamán guerrero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172909&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e207b2e3-a010-4187-8a16-f5f1aaef5d14\', \'multiverseId\': 172909}, \'multiverseid\': 172909}, {\'name\': \'Duo de la ferté\', \'text\': "À chaque fois que vous jouez un sort vert, le Duo de la ferté gagne +1/+1 jusqu\'à la fin du tour.\\nÀ chaque fois que vous jouez un sort blanc, le Duo de la ferté acquiert la vigilance jusqu\'à la fin du tour.", \'type\': \'Créature : elfe et guerrier et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173511&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d94f6883-9793-4e8b-8bda-a1182219e0a4\', \'multiverseId\': 173511}, \'multiverseid\': 173511}, {\'name\': \'Duo del Fortincanto\', \'text\': \'Ogniqualvolta giochi una magia verde, il Duo del Fortincanto prende +1/+1 fino alla fine del turno.\\nOgniqualvolta giochi una magia bianca, il Duo del Fortincanto ha cautela fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Sciamano Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173812&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b441abfe-6285-4589-b0cc-24cf4b849b75\', \'multiverseId\': 173812}, \'multiverseid\': 173812}, {\'name\': \'安寧砦の二人組\', \'text\': \'あなたが緑の呪文をプレイするたび、安寧砦の二人組はターン終了時まで＋１/＋１の修整を受ける。\\nあなたが白の呪文をプレイするたび、安寧砦の二人組はターン終了時まで警戒を得る。\', \'type\': \'クリーチャー — エルフ・戦士・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174113&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'314f9e75-8672-4ba4-a85d-b96586f94296\', \'multiverseId\': 174113}, \'multiverseid\': 174113}, {\'name\': \'Duo do Refúgio\', \'text\': \'Toda vez que você joga uma mágica verde, Duo do Refúgio recebe +1/+1 até o final do turno.\\nToda vez que você joga uma mágica branca, Duo do Refúgio ganha vigilância até o final do turno.\', \'type\': \'Criatura — Elfo Guerreiro Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172307&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa211e87-f34c-4f1b-a970-aae0e860df39\', \'multiverseId\': 172307}, \'multiverseid\': 172307}, {\'name\': \'Напарники Убежища\', \'text\': \'Каждый раз, когда вы разыгрываете зеленое заклинание, Напарники Убежища получают +1/+1 до конца хода.\\nКаждый раз, когда вы разыгрываете белое заклинание, Напарники Убежища получают Бдительность до конца хода.\', \'type\': \'Существо — Эльф Воин Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172608&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'47fc7e85-d9fb-4304-abae-98c9ba3d9819\', \'multiverseId\': 172608}, \'multiverseid\': 172608}, {\'name\': \'华域搭档\', \'text\': \'每当你使用一个绿色咒语时，华域搭档得+1/+1直到回合结束。\\n每当你使用一个白色咒语时，华域搭档获得警戒异能直到回合结束。\', \'type\': \'生物～地精／战士／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173210&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ccfd3824-b763-4251-9be3-141cbbe9b555\', \'multiverseId\': 173210}, \'multiverseid\': 173210}]', '[{\'name\': \'Trutzburg-Elite\', \'text\': \'Beharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Elf, Späher\', \'flavor\': \'„Ich weigere mich zu sterben — jedenfalls nicht im Kampf mit dir."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174716&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'36b432dd-38bf-4ea0-a0a3-b9c20032702b\', \'multiverseId\': 174716}, \'multiverseid\': 174716}, {\'name\': \'Élite del refugio seguro\', \'text\': \'Persistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Explorador elfo\', \'flavor\': \'"Me niego a morir, por lo menos en manos de alguien como tú."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172910&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'56fc6cd6-d0fd-4d5e-9c94-f2a64cda6058\', \'multiverseId\': 172910}, \'multiverseid\': 172910}, {\'name\': \'Élite de la ferté\', \'text\': "Persistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : elfe et éclaireur\', \'flavor\': "« Je refuse de mourir — du moins pas des mains d\'êtres de votre sorte. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173512&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7150c84b-c817-4383-8bbf-42b5213a79fc\', \'multiverseId\': 173512}, \'multiverseid\': 173512}, {\'name\': \'Elite del Fortincanto\', \'text\': \'Persistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Esploratore Elfo\', \'flavor\': \'"Mi rifiuto di morire... non certo per mano di uno come te."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173813&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7113483f-db9b-47a5-a42c-46645f406913\', \'multiverseId\': 173813}, \'multiverseid\': 173813}, {\'name\': \'安寧砦の精鋭\', \'text\': \'頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — エルフ・スカウト\', \'flavor\': \'「死ぬのはごめんだ――ましてや、お前のような奴の手にかかってはな。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174114&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7e92a735-6edd-4658-b306-6c90db3f5211\', \'multiverseId\': 174114}, \'multiverseid\': 174114}, {\'name\': \'Elite do Refúgio\', \'text\': \'Persistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Elfo Batedor\', \'flavor\': \'"Eu me recuso a morrer não nas mãos de alguém como você."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172308&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'725acc70-31aa-400e-b460-032444de1dbb\', \'multiverseId\': 172308}, \'multiverseid\': 172308}, {\'name\': \'Элита Убежища\', \'text\': \'Упорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Эльф Разведчик\', \'flavor\': \'«Я не собираюсь умирать уж точно не от рук такого, как вы».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172609&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e67c9535-8cb9-4696-9dc7-3e5b88b08c1c\', \'multiverseId\': 172609}, \'multiverseid\': 172609}, {\'name\': \'华域精兵\', \'text\': \'留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～地精／斥候\', \'flavor\': \'「我拒绝死去～尤其是在你这种货色手下。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173211&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'644eca1d-b1b6-45d0-ada6-324a2d428d15\', \'multiverseId\': 173211}, \'multiverseid\': 173211}]', '[{\'name\': \'Trutzburg-Wachposten\', \'text\': \'{2}{W}, {Q}: Der Trutzburg-Wachposten erhält +0/+2 bis zum Ende des Zuges. ({Q} ist das Enttappsymbol.)\', \'type\': \'Kreatur — Elf, Krieger\', \'flavor\': \'„Diese Armschienen hat schon mein Vater und vor ihm auch seine Mutter getragen. Boggartkrallen sind an ihnen zerbrochen. Flammen von Rußwesen sind an ihnen erloschen. Solange ich sie trage, wird die Trutzburg nicht fallen."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174499&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9943ccaa-15ac-47ce-985a-1f747cb2787a\', \'multiverseId\': 174499}, \'multiverseid\': 174499}, {\'name\': \'Centinela del refugio seguro\', \'text\': \'{2}{W}, {Q}: El Centinela del refugio seguro obtiene +0/+2 hasta el final del turno. ({Q} es el símbolo de enderezar.)\', \'type\': \'Criatura — Guerrero elfo\', \'flavor\': \'"Estos brazaletes fueron usados por mi padre y por su madre antes que él. Hubo boggarts que rompieron sus colmillos contra ellos. Las llamas de los cenicientos se debilitan con su contacto. Mientras los use, el refugio seguro no caerá."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172693&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a95251b4-b6b1-4e33-b453-342cfbf2200e\', \'multiverseId\': 172693}, \'multiverseid\': 172693}, {\'name\': \'Sentinelle de la ferté\', \'text\': "{2}{W}, {Q} : La Sentinelle de la ferté gagne +0/+2 jusqu\'à la fin du tour. ({Q} est le symbole de dégagement.)", \'type\': \'Créature : elfe et guerrier\', \'flavor\': "« Ces brassards ont été portés par mon père, et par sa mère avant lui. Les boggarts s\'y sont brisés les crocs. Les scoriacés sont tombés en cendres à leur contact. Tant que je les porte, la ferté est en sécurité. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173295&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'796c21fd-5217-498f-b0ac-d4df90a98228\', \'multiverseId\': 173295}, \'multiverseid\': 173295}, {\'name\': \'Sentinella del Fortincanto\', \'text\': \'{2}{W}, {Q}: La Sentinella del Fortincanto prende +0/+2 fino alla fine del turno. ({Q} è il simbolo di STAP.)\', \'type\': \'Creatura — Guerriero Elfo\', \'flavor\': \'"Questi bracciali sono stati indossati da mio padre e da sua madre prima di lui. Zanne di boggart si sono frantumate su di essi. Fiamme di cinerei si sono spente al loro contatto. Finché li indosso, il fortincanto non cadrà."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173596&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ffa3a17-b6fd-4bb8-86a1-6560cba1b83a\', \'multiverseId\': 173596}, \'multiverseid\': 173596}, {\'name\': \'安寧砦の歩哨\', \'text\': \'{2}{W}, {Q}：安寧砦の歩哨はターン終了時まで＋０/＋２の修整を受ける。 （{Q}はアンタップ・シンボルである。）\', \'type\': \'クリーチャー — エルフ・戦士\', \'flavor\': \'「この盾は私の父が帯びていた物で、その前は彼の母の物だった。 ボガートの牙を砕いたのもこれだ。 燃えがらどもの火を鎮めたのもこれだ。 これを帯びているかぎり、この安寧砦が落ちることはない。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173897&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2ef878bf-b7d5-4bfc-8bf9-1dd8126193a0\', \'multiverseId\': 173897}, \'multiverseid\': 173897}, {\'name\': \'Sentinela do Refúgio\', \'text\': \'{2}{W}, {Q}: Sentinela do Refúgio recebe +0/+2 até o final do turno. ({Q} é o símbolo de desvirar.)\', \'type\': \'Criatura — Elfo Guerreiro\', \'flavor\': \'"Estes braceletes foram usados pelo meu pai e, anteriormente, pela mãe dele. Papões já estraçalharam as presas neles. Chamas de cinzeríneos murcharam ao tocar neles. Enquanto eu os usar, o refúgio estará a salvo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172091&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1360a9cf-262b-42a3-ac69-a30687502e3f\', \'multiverseId\': 172091}, \'multiverseid\': 172091}, {\'name\': \'Страж Убежища\', \'text\': \'{2}{W}, {Q}: Страж Убежища получает +0/+2 до конца хода. ({Q} символ разворота карты.)\', \'type\': \'Существо — Эльф Воин\', \'flavor\': \'«Эти наручи носил мой отец, а до него его мать. О них обламывались клыки боггартов. Пламя золовиков затухало при одном лишь прикосновении к ним. Пока я в них, убежище не падет».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172392&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1ee115c1-1b4c-490c-a0f9-0c59695f16e7\', \'multiverseId\': 172392}, \'multiverseid\': 172392}, {\'name\': \'华域哨兵\', \'text\': \'{2}{W}，{Q}：华域哨兵得+0/+2直到回合结束。 （{Q}是重置符号。）\', \'type\': \'生物～地精／战士\', \'flavor\': \'「我父亲与祖母都戴过这腕甲。 它打碎过波尬牙齿， 熄灭过烬身火焰。 只要我带着它，华域必不会陷落。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172994&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0d284bcb-9ae8-43bd-a705-9241838b55b9\', \'multiverseId\': 172994}, \'multiverseid\': 172994}]', '[{\'name\': \'Tälermacher\', \'text\': \'{T}, opfere ein Gebirge: Der Tälermacher fügt einer Kreatur deiner Wahl 3 Schadenspunkte zu.\\n{T}, opfere einen Wald: Bestimme einen Spieler. Dieser Spieler erhöht seinen Manavorrat um {G}{G}{G}.\', \'type\': \'Kreatur — Riese, Schamane\', \'flavor\': \'Nachdem ihre Heimat von einem Riesen umgepflügt wurde, trauerte die Boggartbande noch lange ihrem Revier nach.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174698&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d9e3962c-d754-419c-b638-e5a714ec5ff8\', \'multiverseId\': 174698}, \'multiverseid\': 174698}, {\'name\': \'Creavalles\', \'text\': \'{T}, sacrificar una montaña: El Creavalles hace 3 puntos de daño a la criatura objetivo.\\n{T}, sacrificar un bosque: Elige un jugador. Ese jugador agrega {G}{G}{G} a su reserva de maná.\', \'type\': \'Criatura — Chamán gigante\', \'flavor\': \'Con su hogar destruido por un gigante, la banda de boggarts lloró por su viejo terreno de caza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172892&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'36615884-ae0f-48be-9bb2-8722dfc29a0e\', \'multiverseId\': 172892}, \'multiverseid\': 172892}, {\'name\': \'Forgeur de vallée\', \'text\': \'{T}, sacrifiez une montagne : Le Forgeur de vallée inflige 3 blessures à la créature ciblée.\\n{T}, sacrifiez une forêt : Choisissez un joueur. Ce joueur ajoute {G}{G}{G} à sa réserve.\', \'type\': \'Créature : géant et shamane\', \'flavor\': "Quand le géant arracha leur foyer, le gang de boggarts se lamenta d\'avoir perdu son repaire.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173494&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'67516a55-9e9d-4d79-bd60-d7e18a980b5c\', \'multiverseId\': 173494}, \'multiverseid\': 173494}, {\'name\': \'Creatore di Vallate\', \'text\': \'{T}, Sacrifica una Montagna: Il Creatore di Vallate infligge 3 danni a una creatura bersaglio.\\n{T}, Sacrifica una Foresta: Scegli un giocatore. Quel giocatore aggiunge {G}{G}{G} alla sua riserva di mana.\', \'type\': \'Creatura — Sciamano Gigante\', \'flavor\': \'Con la casa sradicata da un gigante, la banda di boggart rimpianse il vecchio posto di ritrovo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173795&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0c3a11b2-806c-461b-a764-e440349e2998\', \'multiverseId\': 173795}, \'multiverseid\': 173795}, {\'name\': \'谷刻み\', \'text\': \'{T}, 山を１つ生け贄に捧げる：クリーチャー１体を対象とする。谷刻みはそれに３点のダメージを与える。\\n{T}, 森を１つ生け贄に捧げる：プレイヤーを１人選ぶ。 そのプレイヤーは自分のマナ・プールに{G}{G}{G}を加える。\', \'type\': \'クリーチャー — 巨人・シャーマン\', \'flavor\': \'故郷が巨人にひっくり返されたボガートの連中は、自分たちの慣れ親しんだ溜まり場を嘆き悲しんだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174096&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'81d8c52b-8ac4-42c4-8624-da4e2b5f586d\', \'multiverseId\': 174096}, \'multiverseid\': 174096}, {\'name\': \'Criador de Vales\', \'text\': \'{T}, Sacrifique uma Montanha: Criador de Vales causa 3 pontos de dano à criatura alvo.\\n{T}, Sacrifique uma Floresta: Escolha um jogador. Aquele jogador adiciona {G}{G}{G} à sua própria reserva de mana.\', \'type\': \'Criatura — Gigante Xamã\', \'flavor\': \'Após ter sua casa arrancada por um gigante, a gangue de papões chorou seu velho solo pisoteado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172290&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0e0d0c04-9aa9-43ce-9e56-c3da53637fb2\', \'multiverseId\': 172290}, \'multiverseid\': 172290}, {\'name\': \'Создатель Долин\', \'text\': \'{T}, пожертвуйте Гору: Создатель Долин наносит 3 повреждения целевому существу.\\n{T}, пожертвуйте Лес: выберите игрока. Тот игрок добавляет {G}{G}{G} в свое хранилище маны.\', \'type\': \'Существо — Гигант Шаман\', \'flavor\': \'Когда гигант разрушил их дом, банда боггартов долго горевала о своем старом жилище.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172591&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0bee1098-0635-4cda-a0c9-1f73995958de\', \'multiverseId\': 172591}, \'multiverseid\': 172591}, {\'name\': \'裂谷师\', \'text\': \'{T}，牺牲一个山脉：裂谷师对目标生物造成3点伤害。\\n{T}，牺牲一个树林：选择一位牌手。 该牌手加{G}{G}{G}到他的法术力池中。\', \'type\': \'生物～巨人／祭师\', \'flavor\': \'这帮波尬的家给巨人连根拔起，正哀悼着熟悉的晃动大地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173193&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f339bd57-3721-4beb-a77a-fd7a8b36f2b3\', \'multiverseId\': 173193}, \'multiverseid\': 173193}]', '[{\'name\': \'Umklammerung des Flusses\', \'text\': \'Falls {U} ausgegeben wurde, um Umklammerung des Flusses zu spielen, bringe bis zu eine Kreatur deiner Wahl auf die Hand ihres Besitzers zurück. Falls {B} ausgegeben wurde, um Umklammerung des Flusses zu spielen, zeigt ein Spieler deiner Wahl die Karten auf seiner Hand offen vor, du bestimmst eine Karte darunter, die kein Land ist, und jener Spieler wirft diese Karte ab. (Mache beides, falls {U}{B} ausgegeben wurde.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174651&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'48166204-1f13-4722-b570-0625d9a90c8e\', \'multiverseId\': 174651}, \'multiverseid\': 174651}, {\'name\': \'Abrazo del río\', \'text\': \'Si se usó {U} para jugar el Abrazo del río, regresa hasta una criatura objetivo a la mano de su propietario. Si se usó {B} para jugar el Abrazo del río, el jugador objetivo muestra su mano, tú eliges una carta que no sea tierra de allí y ese jugador descarta esa carta. (Haz ambos si se usó {U}{B}.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172845&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'287623ea-9d5a-41a2-bf97-93436f5df3f0\', \'multiverseId\': 172845}, \'multiverseid\': 172845}, {\'name\': \'Emprise de la rivière\', \'text\': "Si {U} a été dépensé pour jouer l\'Emprise de la rivière, renvoyez jusqu\'à une créature ciblée dans la main de son propriétaire. Si {B} a été dépensé pour jouer l\'Emprise de la rivière, le joueur ciblé révèle sa main, vous y choisissez une carte non-terrain, et ce joueur se défausse ensuite de cette carte. (Faites les deux si {U}{B} a été dépensé.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173447&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fdc9f226-9a95-4e55-a648-ff3e09d60b1f\', \'multiverseId\': 173447}, \'multiverseid\': 173447}, {\'name\': \'Stretta del Fiume\', \'text\': \'Se è stato speso {U} per giocare la Stretta del Fiume, fai tornare fino a una creatura bersaglio in mano al suo proprietario. Se è stato speso {B} per giocare la Stretta del Fiume, un giocatore bersaglio rivela la sua mano, tu scegli una carta non terra da essa, poi quel giocatore scarta quella carta. (Compi entrambe le azioni se è stato speso {U}{B}.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173748&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d4010047-2238-4559-babc-b657242b13a5\', \'multiverseId\': 173748}, \'multiverseid\': 173748}, {\'name\': \'川の掌握\', \'text\': \'川の掌握をプレイするために{U}が支払われている場合、クリーチャーを最大１体まで対象とし、それをオーナーの手札に戻す。 川の掌握をプレイするために{B}が支払われている場合、プレイヤー１人を対象とする。そのプレイヤーは手札を公開し、あなたはその中から土地でないカードを１枚選ぶ。その後そのプレイヤーはそのカードを捨てる。 （{U}{B}が支払われている場合、両方を行う。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174049&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ed913e7-2f22-45b8-93d0-5aaa279b871d\', \'multiverseId\': 174049}, \'multiverseid\': 174049}, {\'name\': \'Garras do Rio\', \'text\': \'Se {U} foi gasto para jogar Garras do Rio, devolva até uma criatura alvo para a mão de seu dono. Se {B} foi gasto para jogar Garras do Rio, o jogador alvo revela sua mão, você escolhe um card que não seja um terreno dela e aquele jogador descarta aquele card. (Faça ambas as coisas se {U}{B} foi gasto.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172243&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'905b8b3a-35c3-4c8d-acf9-f068a950d914\', \'multiverseId\': 172243}, \'multiverseid\': 172243}, {\'name\': \'Речная Хватка\', \'text\': \'Если на разыгрывание Речной Хватки было потрачено {U}, верните не более одного целевого существа в руку его владельца. Если на разыгрывание Речной Хватки было потрачено {B}, целевой игрок показывает свою руку, вы выбираете из нее не являющуюся землей карту, затем тот игрок сбрасывает ту карту. (Сделайте и то и другое, если было потрачено {U}{B}.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172544&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'87c89b9c-d5f6-4805-9759-92ebe470455c\', \'multiverseId\': 172544}, \'multiverseid\': 172544}, {\'name\': \'河流之攫\', \'text\': \'如果使用河流之攫时支付了{U}，则将至多一个目标生物移回其拥有者手上。 如果使用河流之攫时支付了{B}，则目标牌手展示其手牌，你选择其中一张非地的牌，然后该牌手弃掉该牌。 （如果支付了{U}{B}，则两者都作。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173146&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2d53b1ed-7903-493d-a21b-fe60fbe2aed2\', \'multiverseId\': 173146}, \'multiverseid\': 173146}]', '[{\'name\': \'Unentrinnbarer Rohling\', \'text\': \'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\\nDer Unentrinnbare Rohling muss geblockt werden, falls möglich.\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': \'Wenn du glaubst, dich an ihm vorbeigestohlen zu haben, dann spielt er nur mit dir.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174572&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2ee992c9-6ec8-4684-97dd-a26f727bcf4d\', \'multiverseId\': 174572}, \'multiverseid\': 174572}, {\'name\': \'Bruto inescapable\', \'text\': \'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)\\nEl Bruto inescapable debe ser bloqueado si se puede.\', \'type\': \'Criatura — Guerrero gigante\', \'flavor\': \'Si crees que lo pasaste vivo, está jugando contigo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172766&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1d66b9c8-7b56-43d4-8b61-3c0bb282bee1\', \'multiverseId\': 172766}, \'multiverseid\': 172766}, {\'name\': \'Brute incontournable\', \'text\': \'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)\\nLa Brute incontournable doit être bloquée si possible.\', \'type\': \'Créature : géant et guerrier\', \'flavor\': "Si vous pensez le contourner et survivre, c\'est qu\'il joue avec vous.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173368&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1cb2d14d-f53b-4125-91ac-689a14e55f5e\', \'multiverseId\': 173368}, \'multiverseid\': 173368}, {\'name\': \'Bruto Inevitabile\', \'text\': \'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\\nIl Bruto Inevitabile deve essere bloccato, se può esserlo.\', \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': \'Se pensi di averlo superato indenne, sta solo giocando con te.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173669&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'88658901-5451-4529-9966-ec30bc5534d2\', \'multiverseId\': 173669}, \'multiverseid\': 173669}, {\'name\': \'逃れ得ぬ粗暴者\', \'text\': \'萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）\\n逃れ得ぬ粗暴者は、可能ならブロックされなければならない。\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': \'生きて奴をやり過ごしたと思っているなら、奴に遊ばれているだけだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173970&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'57afa0b6-0a86-4377-b0e7-cf86fa5a749a\', \'multiverseId\': 173970}, \'multiverseid\': 173970}, {\'name\': \'Brutamontes Inescapável\', \'text\': \'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)\\nBrutamontes Inescapável deve ser bloqueado se estiver apto.\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': \'Se você acha que passou por ele com vida, ele está apenas brincando com você.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172164&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6318cf89-f813-4216-8691-0ad1c045c084\', \'multiverseId\': 172164}, \'multiverseid\': 172164}, {\'name\': \'Неминуемый Зверюга\', \'text\': \'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)\\nНеминуемый Зверюга должен быть заблокирован, если это возможно.\', \'type\': \'Существо — Гигант Воин\', \'flavor\': \'Если вы думаете, что сумели пройти мимо него живым, не радуйтесь он вас просто дразнит.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172465&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fc4fa680-2f1a-49e6-835f-5c080d809919\', \'multiverseId\': 172465}, \'multiverseid\': 172465}, {\'name\': \'定劫蛮汉\', \'text\': \'干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）\\n若能阻挡定劫蛮汉，则必须阻挡之。\', \'type\': \'生物～巨人／战士\', \'flavor\': \'如果你自认已逃过一劫，那是因为他只在玩弄你。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173067&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'79da61b1-2c3c-41ea-b171-ee5440588d17\', \'multiverseId\': 173067}, \'multiverseid\': 173067}]', '[{\'name\': \'Unfug des Phookas\', \'text\': \'Zu Beginn deines Versorgungssegments kannst du die Kontrolle über eine bleibende Karte deiner Wahl, die kein Land ist und die du kontrollierst, und eine bleibende Karte deiner Wahl, die kein Land ist, die ein Gegner kontrolliert und die gleich hohe oder niedrigere umgewandelte Manakosten hat, tauschen.\', \'type\': \'Verzauberung\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174524&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'716be3d1-f82b-4d55-aac0-343da0319f03\', \'multiverseId\': 174524}, \'multiverseid\': 174524}, {\'name\': \'Diablura de puca\', \'text\': \'Al comienzo de tu mantenimiento, puedes intercambiar el control del permanente objetivo que no sea tierra que controlas y el permanente objetivo que no sea tierra que controla un oponente que tenga un coste de maná convertido igual o menor.\', \'type\': \'Encantamiento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172718&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bdde1923-5baf-43aa-95de-69489729141f\', \'multiverseId\': 172718}, \'multiverseid\': 172718}, {\'name\': \'Malice selon le pucca\', \'text\': "Au début de votre entretien, vous pouvez échanger le contrôle du permanent non-terrain ciblé que vous contrôlez contre celui du permanent non-terrain ciblé qu\'un adversaire contrôle et qui a un coût converti de mana inférieur ou égal.", \'type\': \'Enchantement\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173320&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d1c23050-d876-4ca1-bc19-48120a47a5a6\', \'multiverseId\': 173320}, \'multiverseid\': 173320}, {\'name\': \'Inganno del Puca\', \'text\': "All\'inizio del tuo mantenimento, puoi scambiare il controllo di un permanente non terra bersaglio che controlli e un permanente non terra bersaglio controllato da un avversario con un costo di mana convertito pari o inferiore.", \'type\': \'Incantesimo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173621&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2268c7b2-f8ae-4e4b-a11c-7af54f093f86\', \'multiverseId\': 173621}, \'multiverseid\': 173621}, {\'name\': \'プーカの悪戯\', \'text\': \'あなたのアップキープの開始時に、あなたがコントロールする土地でないパーマネント１つと、いずれかの対戦相手がコントロールする点数で見たマナ・コストがそれ以下の土地でないパーマネント１つを対象とする。あなたはそれらのコントロールを交換してもよい。\', \'type\': \'エンチャント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173922&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'70b76c0a-0b7c-4936-9321-1e1579ae091e\', \'multiverseId\': 173922}, \'multiverseid\': 173922}, {\'name\': \'Travessura de Puca\', \'text\': \'No início de sua manutenção, você pode permutar o controle da permanente alvo (que não seja um terreno) controlada por você com a permanente alvo (que não seja um terreno) controlada por um oponente com um custo de mana convertido, igual ou menor.\', \'type\': \'Encantamento\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172116&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8a78f85d-2ac0-4f71-ae62-0d3a7180d341\', \'multiverseId\': 172116}, \'multiverseid\': 172116}, {\'name\': \'Проделки Пуки\', \'text\': \'В начале вашего шага поддержки вы можете обменять контроль над целевым не являющимся землей перманентом под вашим контролем на контроль над целевым не являющимся землей перманентом под контролем оппонента с равной или меньшей конвертированной мана-стоимостью.\', \'type\': \'Чары\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172417&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8ec6b33f-30e0-429e-810c-6712339a690b\', \'multiverseId\': 172417}, \'multiverseid\': 172417}, {\'name\': \'铺卡的作弄\', \'text\': \'在你的维持开始时，你可以选择目标由你操控的非地永久物，与目标由对手操控、且总法术力费用等于或小于前者的非地永久物，并交换它们的操控权。\', \'type\': \'结界\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173019&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f103fd60-7914-4bf2-a35c-4137c07d9f31\', \'multiverseId\': 173019}, \'multiverseid\': 173019}]', '[{\'name\': \'Ungezieferplage\', \'text\': \'Mit dir beginnend kann reihum jeder Spieler eine beliebige Anzahl an Lebenspunkten bezahlen. Wiederhole diesen Vorgang, bis niemand mehr Lebenspunkte bezahlt. Jeder Spieler bringt für jeden 1 Lebenspunkt, den er auf diese Weise bezahlt hat, einen 1/1 schwarzen Ratten-Kreaturenspielstein ins Spiel.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174550&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f856fbc8-e260-4142-ad57-2b811ee9a5d1\', \'multiverseId\': 174550}, \'multiverseid\': 174550}, {\'name\': \'Plaga de alimañas\', \'text\': \'Comenzando contigo, cada jugador puede pagar cualquier cantidad de vida. Repite este proceso hasta que ninguno pague vida. Cada jugador pone en juego una ficha de criatura Rata negra 1/1 por cada vida que pagó de esta manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172744&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e4a0c244-69dd-40d4-9fc5-8076a145f820\', \'multiverseId\': 172744}, \'multiverseid\': 172744}, {\'name\': \'Propagation de vermine\', \'text\': "En commençant par vous, chaque joueur peut payer le nombre de points de vie de son choix. Répétez ce processus jusqu\'à ce que personne ne paie de points de vie. Chaque joueur met en jeu un jeton de créature 1/1 noire Rat pour chaque 1 point de vie payé de cette manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173346&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0d56dc61-60e2-406a-844e-1146fc4e26d7\', \'multiverseId\': 173346}, \'multiverseid\': 173346}, {\'name\': \'Piaga di Ratti\', \'text\': \'A partire da te, ogni giocatore può pagare un qualsiasi ammontare di punti vita. Ripeti questo procedimento finché nessuno paga punti vita. Ogni giocatore mette in gioco una pedina creatura Ratto 1/1 nera per ogni punto vita pagato in questo modo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173647&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'91c2ed80-5cc3-4767-9efe-c6dcdc210b9a\', \'multiverseId\': 173647}, \'multiverseid\': 173647}, {\'name\': \'害獣の疫病\', \'text\': \'あなたから始めて、各プレイヤーは望む点数のライフを支払ってもよい。 この手順を、誰もライフを支払わなくなるまで繰り返す。 各プレイヤーは、これにより自分が支払ったライフ１点につき、黒の１/１のネズミ・クリーチャー・トークンを１体場に出す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173948&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe418e0b-ae8f-49fd-8290-449a4ee9dd87\', \'multiverseId\': 173948}, \'multiverseid\': 173948}, {\'name\': \'Praga Pestilenta\', \'text\': \'Começando com você, cada jogador pode pagar qualquer quantidade de pontos de vida. Repita esse processo até que ninguém mais pague pontos de vida. Cada jogador coloca em jogo uma ficha de criatura preta 1/1 do tipo Rato para cada 1 ponto de vida que pagou dessa forma.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172142&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3d8c66b7-564e-4165-b4fd-a2d4a515df98\', \'multiverseId\': 172142}, \'multiverseid\': 172142}, {\'name\': \'Нашествие Грызунов\', \'text\': \'Начиная с вас, каждый игрок может заплатить любое количество жизней. Повторяйте этот процесс до тех пор, пока никто не заплатит жизнь. Каждый игрок кладет в игру одну фишку существа 1/1 черная Крыса за каждую 1 жизнь, которую он заплатил таким образом.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172443&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a3b08fec-b083-4e3d-9d1e-a15e215fdebc\', \'multiverseId\': 172443}, \'multiverseid\': 172443}, {\'name\': \'病媒疫疾\', \'text\': \'由你开始，每位牌手可以支付任意数量的生命值。 重复此流程，直到没有人支付生命为止。 对每位牌手而言，他每以此法支付1点生命，就将一个1/1黑色老鼠衍生物放置进场。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173045&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f85b0642-5bc1-4751-bffe-2326346460a9\', \'multiverseId\': 173045}, \'multiverseid\': 173045}]', '[{\'name\': \'Untergeschlüpfter Elf\', \'text\': \'Wenn der Untergeschlüpfte Elf ins Spiel kommt, kannst du deine Bibliothek nach einer Standardländerkarte durchsuchen und diese Karte getappt ins Spiel bringen. Falls du dies tust, mische danach deine Bibliothek.\', \'type\': \'Kreatur — Elf, Druide\', \'flavor\': \'„Das Grün des Wachstums gibt es weiterhin. Es versteckt sich derzeit nur zur Sicherheit."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174590&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'4778577e-6884-4682-a08f-9671f8980039\', \'multiverseId\': 174590}, \'multiverseid\': 174590}, {\'name\': \'Elfo refugio lejano\', \'text\': \'Cuando el Elfo refugio lejano entre en juego, puedes buscar en tu biblioteca una carta de tierra básica y ponerla en juego girada. Si lo haces, baraja tu biblioteca.\', \'type\': \'Criatura — Druida elfo\', \'flavor\': \'"El florecimiento verde existe. Simplemente se esconde por su seguridad."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172784&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cabc27ce-c05d-4f92-8630-43300441d82b\', \'multiverseId\': 172784}, \'multiverseid\': 172784}, {\'name\': \'Elfe des horizons lointains\', \'text\': "Quand l\'Elfe des horizons lointains arrive en jeu, vous pouvez chercher une carte de terrain de base dans votre bibliothèque et la mettre en jeu engagée. Si vous faites ainsi, mélangez votre bibliothèque.", \'type\': \'Créature : elfe et druide\', \'flavor\': \'« La verdure florissante existe. Elle ne se cache que pour éviter sa destruction. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173386&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ed2f4581-0908-48b0-a9f0-6402394fc925\', \'multiverseId\': 173386}, \'multiverseid\': 173386}, {\'name\': \'Elfa del Rifugio Lontano\', \'text\': "Quando l\'Elfa del Rifugio Lontano entra in gioco, puoi passare in rassegna il tuo grimorio per una carta terra base e metterla in gioco TAPpata. Se lo fai, rimescola il tuo grimorio.", \'type\': \'Creatura — Druido Elfo\', \'flavor\': \'"La vegetazione lussureggiante esiste davvero. Si nasconde semplicemente per la propria sicurezza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173687&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ed997833-2d51-4100-bcf0-3cc6c71dd8b9\', \'multiverseId\': 173687}, \'multiverseid\': 173687}, {\'name\': \'彼方地のエルフ\', \'text\': \'彼方地のエルフが場に出たとき、あなたはあなたのライブラリーから基本土地カードを１枚探してタップ状態で場に出してもよい。 そうした場合、あなたのライブラリーを切り直す。\', \'type\': \'クリーチャー — エルフ・ドルイド\', \'flavor\': \'「緑色の花も実在しますよ。 自らの安全のために隠れているだけです。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173988&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c9b043e3-597c-4d7c-aba2-807676176f67\', \'multiverseId\': 173988}, \'multiverseid\': 173988}, {\'name\': \'Elfo Porto-Longínquo\', \'text\': \'Quando Elfo Porto-Longínquo entra em jogo, você pode procurar em seu grimório por um card de terreno básico e colocá-lo em jogo virado. Se fizer isso, embaralhe seu grimório.\', \'type\': \'Criatura — Elfo Druida\', \'flavor\': \'"A florescência verdejante existe. Ela apenas se esconde para sua própria segurança."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172182&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1755f698-53da-4418-966d-d0b52728f600\', \'multiverseId\': 172182}, \'multiverseid\': 172182}, {\'name\': \'Эльф-Первопроходец\', \'text\': \'Когда Эльф-Первопроходец входит в игру, вы можете найти в вашей библиотеке карту базовой земли и положить ее в игру повернутой. Если вы это делаете, перетасуйте вашу библиотеку.\', \'type\': \'Существо — Эльф Друид\', \'flavor\': \'«Зеленый сад существует. Просто он прячется ради собственной безопасности».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172483&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c7b33c22-4fb4-4f64-a3fb-a730a5ea9dc2\', \'multiverseId\': 172483}, \'multiverseid\': 172483}, {\'name\': \'觅境地精\', \'text\': \'当觅境地精进场时，你可以从你的牌库中搜寻一张基本地牌，并将之横置进场。 若你如此作，则将你的牌库洗牌。\', \'type\': \'生物～地精／德鲁伊\', \'flavor\': \'「新绿之花确实存在。 它只是在避难而已。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173085&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'748b70b3-057a-4231-9a21-b63735d40058\', \'multiverseId\': 173085}, \'multiverseid\': 173085}]', '[{\'name\': \'Vasall der Elendraschlucht\', \'text\': \'Fliegend\\nAndere blaue Kreaturen, die du kontrollierst, erhalten +1/+1.\\nAndere schwarze Kreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Kreatur — Feenwesen, Ritter\', \'flavor\': \'Wer es sich mit Oona verscherzt, bekommt bald schon zu spüren, über welche Armeen sie alles verfügt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174640&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ff0c9244-f46f-4f2c-a1ee-50ea2fb1237a\', \'multiverseId\': 174640}, \'multiverseid\': 174640}, {\'name\': \'Siervo del Valle Elendra\', \'text\': \'Vuela.\\nLas otras criaturas azules que controlas obtienen +1/+1.\\nLas otras criaturas negras que controlas obtienen +1/+1.\', \'type\': \'Criatura — Caballero hada\', \'flavor\': \'Aquellos que ofenden a Oona pronto conocen lo vasto de sus ejércitos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172834&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2b9ba20f-34c5-471c-a67f-ce64eeacd639\', \'multiverseId\': 172834}, \'multiverseid\': 172834}, {\'name\': "Noble féal du Vallon d\'Elendra", \'text\': \'Vol\\nLes autres créatures bleues que vous contrôlez gagnent +1/+1.\\nLes autres créatures noires que vous contrôlez gagnent +1/+1.\', \'type\': \'Créature : peuple fée et chevalier\', \'flavor\': "Quiconque déplaît à Oona se rend rapidement compte de la taille des armées qu\'elle commande.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173436&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'e6556f7d-34a9-4b07-b713-a230381d5561\', \'multiverseId\': 173436}, \'multiverseid\': 173436}, {\'name\': \'Vassallo di Gola Elendra\', \'text\': \'Volare\\nLe altre creature blu che controlli prendono +1/+1.\\nLe altre creature nere che controlli prendono +1/+1.\', \'type\': \'Creatura — Cavaliere Spiritello\', \'flavor\': "Coloro che scontentano Oona scoprono presto l\'estensione delle armate che comanda.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173737&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5bb5a3de-7aa7-4e86-9cd5-030075f3ba79\', \'multiverseId\': 173737}, \'multiverseid\': 173737}, {\'name\': \'エレンドラ谷のしもべ\', \'text\': \'飛行\\nあなたがコントロールする他の青のクリーチャーは＋１/＋１の修整を受ける。\\nあなたがコントロールする他の黒のクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — フェアリー・騎士\', \'flavor\': \'ウーナの機嫌を損ねたものは、すぐに彼女の配下の部隊がどれだけ広範囲にいるかを知ることとなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174038&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0f2363fb-2e7c-4917-87cb-ae3f93b4a3d0\', \'multiverseId\': 174038}, \'multiverseid\': 174038}, {\'name\': \'Soberano de Glen Elendra\', \'text\': \'Voar\\nAs outras criaturas azuis que você controla recebem +1/+1.\\nAs outras criaturas pretas que você controla recebem +1/+1.\', \'type\': \'Criatura — Fada Cavaleiro\', \'flavor\': \'Aqueles que desagradam Oona logo tomam conhecimento do tamanho dos exércitos que ela comanda.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172232&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'054c05f6-c6e8-4800-904f-b91385dfbf4f\', \'multiverseId\': 172232}, \'multiverseid\': 172232}, {\'name\': \'Вассал Глен-Элендры\', \'text\': \'Полет\\nДругие синие существа под вашим контролем получают +1/+1.\\nДругие черные существа под вашим контролем получают +1/+1.\', \'type\': \'Существо — Фея Рыцарь\', \'flavor\': \'Те, кто сердят Уну, вскоре узнают, какими огромными армиями она командует.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172533&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2cc38469-dd24-4611-b0e5-d26f84c5b53a\', \'multiverseId\': 172533}, \'multiverseid\': 172533}, {\'name\': \'艾蓝卓幽谷王侯\', \'text\': \'飞行\\n由你操控的其他蓝色生物得+1/+1。\\n由你操控的其他黑色生物得+1/+1。\', \'type\': \'生物～仙灵／骑士\', \'flavor\': \'惹得欧娜不悦者，很快就能体会到她势力范围有多么广大。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173135&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f86daaa9-7a5c-43df-b1ad-03008fc0dcab\', \'multiverseId\': 173135}, \'multiverseid\': 173135}]', '[{\'name\': \'Vasall des Aschenmoors\', \'text\': \'Andere schwarze Kreaturen, die du kontrollierst, erhalten +1/+1.\\nAndere rote Kreaturen, die du kontrollierst, erhalten +1/+1.\\nImmer wenn der Vasall des Aschenmoors das Ziel eines Zauberspruchs oder einer Fähigkeit wird, den bzw. die ein Gegner kontrolliert, verliert dieser Spieler 4 Lebenspunkte.\', \'type\': \'Kreatur — Elementarwesen, Ritter\', \'flavor\': \'Rußwesen tragen einen Generationen alten Groll mit sich herum, der sie nur schwer vertrauen und schnell zurückschlagen lässt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174658&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b6aab151-3b55-448a-8969-56c3c32daa4c\', \'multiverseId\': 174658}, \'multiverseid\': 174658}, {\'name\': \'Siervo de Páramo Ceniciento\', \'text\': \'Las otras criaturas negras que controlas obtienen +1/+1.\\nLas otras criaturas rojas que controlas obtienen +1/+1.\\nSiempre que el Siervo de Páramo Ceniciento sea objetivo de un hechizo o habilidad que controle un oponente, ese jugador pierde 4 vidas.\', \'type\': \'Criatura — Caballero elemental\', \'flavor\': \'Los cenicientos arrastran un antiguo agravio que los hace lentos para confiar y rápidos para tomar represalias.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172852&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fa76c4fb-9389-4a15-91d1-b747388a5da3\', \'multiverseId\': 172852}, \'multiverseid\': 172852}, {\'name\': \'Noble féal de Cendrelande\', \'text\': "Les autres créatures noires que vous contrôlez gagnent +1/+1.\\nLes autres créatures rouges que vous contrôlez gagnent +1/+1.\\nÀ chaque fois que le Noble féal de Cendrelande devient la cible d\'un sort ou d\'une capacité qu\'un adversaire contrôle, ce joueur perd 4 points de vie.", \'type\': \'Créature : élémental et chevalier\', \'flavor\': \'Les scoriacés portent en eux une rancune ancestrale qui les rend lents à faire confiance et rapides à se venger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173454&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f54e25e6-5be2-4f95-bfb3-fdedb1a24496\', \'multiverseId\': 173454}, \'multiverseid\': 173454}, {\'name\': \'Vassallo della Brughiera Grigia\', \'text\': \'Le altre creature nere che controlli prendono +1/+1.\\nLe altre creature rosse che controlli prendono +1/+1.\\nOgniqualvolta il Vassallo della Brughiera Grigia diventa bersaglio di una magia o abilità controllata da un avversario, quel giocatore perde 4 punti vita.\', \'type\': \'Creatura — Cavaliere Elementale\', \'flavor\': \'I cinerei sono arsi da un rancore ancestrale che li rende poco propensi alla fiducia ma pronti alla ritorsione.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173755&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e9aab9c9-ce3a-4449-9a51-4c48650b9c2a\', \'multiverseId\': 173755}, \'multiverseid\': 173755}, {\'name\': \'アッシェンムーアのしもべ\', \'text\': \'あなたがコントロールする他の黒のクリーチャーは＋１/＋１の修整を受ける。\\nあなたがコントロールする他の赤のクリーチャーは＋１/＋１の修整を受ける。\\nアッシェンムーアのしもべがいずれかの対戦相手がコントロールする呪文や能力の対象になるたび、そのプレイヤーは４点のライフを失う。\', \'type\': \'クリーチャー — エレメンタル・騎士\', \'flavor\': \'燃えがらの心にある古き因縁は、信用を得るに遅く、復讐に出るに早い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174056&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a5f61e6a-c09d-4686-aec9-b5bcfede17f8\', \'multiverseId\': 174056}, \'multiverseid\': 174056}, {\'name\': \'Soberano de Pântano das Cinzas\', \'text\': \'As outras criaturas pretas que você controla recebem +1/+1.\\nAs outras criaturas vermelhas que você controla recebem +1/+1.\\nToda vez que Soberano de Pântano das Cinzas se torna alvo de uma mágica ou habilidade que um oponente controla, aquele jogador perde 4 pontos de vida.\', \'type\': \'Criatura — Elemental Cavaleiro\', \'flavor\': \'Os cinzeríneos carregam um rancor ancestral que os torna lentos para confiar e rápidos para retaliar.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172250&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'256d19b6-8317-4726-9236-c774a8507f77\', \'multiverseId\': 172250}, \'multiverseid\': 172250}, {\'name\': \'Вассал Выжженной Пустоши\', \'text\': \'Другие черные существа под вашим контролем получают +1/+1.\\nДругие красные существа под вашим контролем получают +1/+1.\\nКаждый раз, когда Вассал Выжженной Пустоши становится целью заклинания или способности под контролем оппонента, тот игрок теряет 4 жизни.\', \'type\': \'Существо — Элементаль Рыцарь\', \'flavor\': \'Золовики носят в сердцах старинную обиду, поэтому они так неохотно доверяют другим и так быстро наносят ответный удар.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172551&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'61ab3535-9e71-4c7b-a6b3-138beb1c7902\', \'multiverseId\': 172551}, \'multiverseid\': 172551}, {\'name\': \'灰原王侯\', \'text\': \'由你操控的其他黑色生物得+1/+1。\\n由你操控的其他红色生物得+1/+1。\\n每当灰原王侯成为由对手操控的咒语或异能之目标时，该牌手失去4点生命。\', \'type\': \'生物～元素／骑士\', \'flavor\': \'烬身一族背负的长年怀恨，让他们不轻信又爱报复。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173153&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fa8a1550-6d87-47e9-bbc5-51761e5df6cd\', \'multiverseId\': 173153}, \'multiverseid\': 173153}]', '[{\'name\': \'Vasall des Gewaffs\', \'text\': \'Verursacht Trampelschaden\\nAndere rote Kreaturen, die du kontrollierst, erhalten +1/+1.\\nAndere grüne Kreaturen, die du kontrollierst, erhalten +1/+1.\', \'type\': \'Kreatur — Goblin, Ritter\', \'flavor\': \'Der Keiler bringt seinen Reiter in die Schlacht und ahnt nicht, dass er im Siegesfall auch beim Festessen dabei ist.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174679&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a1b23df5-af42-4089-b8d3-e5245dcc7c9f\', \'multiverseId\': 174679}, \'multiverseid\': 174679}, {\'name\': \'Siervo colmillo de jabalí\', \'text\': \'Arrolla.\\nLas otras criaturas rojas que controlas obtienen +1/+1.\\nLas otras criaturas verdes que controlas obtienen +1/+1.\', \'type\': \'Criatura — Caballero trasgo\', \'flavor\': \'El jabalí lleva a su jinete a la victoria en la batalla, pero no sabe cuánto eso lo acerca a ser el festín de la victoria.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172873&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'77f5427d-d037-4bd0-9504-856d00e223fd\', \'multiverseId\': 172873}, \'multiverseid\': 172873}, {\'name\': \'Noble féal de la Hure\', \'text\': \'Piétinement\\nLes autres créatures rouges que vous contrôlez gagnent +1/+1.\\nLes autres créatures vertes que vous contrôlez gagnent +1/+1.\', \'type\': \'Créature : gobelin et chevalier\', \'flavor\': "Le sanglier conduit son cavalier vers la victoire au combat mais ignore qu\'il fera partie du festin qui suivra.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173475&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'794f24f5-f25a-47f2-87ad-d12d92135cd5\', \'multiverseId\': 173475}, \'multiverseid\': 173475}, {\'name\': \'Vassallo Zanna di Cinghiale\', \'text\': \'Travolgere\\nLe altre creature rosse che controlli prendono +1/+1.\\nLe altre creature verdi che controlli prendono +1/+1.\', \'type\': \'Creatura — Cavaliere Goblin\', \'flavor\': \'Il cinghiale condusse il suo cavaliere alla vittoria, ignorando che di lì a poco sarebbe diventato il banchetto dei festeggiamenti.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173776&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'6c7e0d68-79b4-40ad-a58e-aed4e304cb30\', \'multiverseId\': 173776}, \'multiverseid\': 173776}, {\'name\': \'猪牙のしもべ\', \'text\': \'トランプル\\nあなたがコントロールする他の赤のクリーチャーは＋１/＋１の修整を受ける。\\nあなたがコントロールする他の緑のクリーチャーは＋１/＋１の修整を受ける。\', \'type\': \'クリーチャー — ゴブリン・騎士\', \'flavor\': \'猪は乗り手を戦場での勝利へと導くが、勝利の祝宴にどれほど近づいたかはわかっていない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174077&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d4e5ba99-9a5e-4789-8e64-70d0cc108f71\', \'multiverseId\': 174077}, \'multiverseid\': 174077}, {\'name\': \'Soberano Dente-de-Javali\', \'text\': \'Atropelar\\nAs outras criaturas vermelhas que você controla recebem +1/+1.\\nAs outras criaturas verdes que você controla recebem +1/+1.\', \'type\': \'Criatura — Goblin Cavaleiro\', \'flavor\': \'O javali conduz seu ginete à vitória na batalha, mas ele não sabe o quão próximo está de tornar-se o banquete da vitória.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172271&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'66256e3c-c5f3-4695-8384-76c3a8389186\', \'multiverseId\': 172271}, \'multiverseid\': 172271}, {\'name\': \'Вассал Кабаньего Клыка\', \'text\': \'Пробивной удар\\nДругие красные существа под вашим контролем получают +1/+1.\\nДругие зеленые существа под вашим контролем получают +1/+1.\', \'type\': \'Существо — Гоблин Рыцарь\', \'flavor\': \'Вепрь мчит своего наездника навстречу боевой победе, не подозревая, как близок он к тому, чтобы стать главным лакомством на праздничном столе.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172572&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'850c9ebe-25aa-49b7-8ae3-6ae018191d27\', \'multiverseId\': 172572}, \'multiverseid\': 172572}, {\'name\': \'猪刺王侯\', \'text\': \'践踏\\n由你操控的其他红色生物得+1/+1。\\n由你操控的其他绿色生物得+1/+1。\', \'type\': \'生物～精灵／骑士\', \'flavor\': \'猪座骑在战场将背上骑士带向胜利，却不知道自己随时会变成庆功宴大餐。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173174&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9dcc1dc9-0c18-4e8a-b88a-f6f22765b8d3\', \'multiverseId\': 173174}, \'multiverseid\': 173174}]', '[{\'name\': \'Vasall des Gilblaubs\', \'text\': \'Andere grüne Kreaturen, die du kontrollierst, erhalten +1/+1.\\nAndere weiße Kreaturen, die du kontrollierst, erhalten +1/+1.\\nFalls ein Zauberspruch oder eine Fähigkeit, der bzw. die ein Gegner kontrolliert, dazu führt, dass du den Vasall des Gilblaubs aus deiner Hand abwirfst, bringe ihn ins Spiel, anstatt ihn auf deinen Friedhof zu legen.\', \'type\': \'Kreatur — Elf, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174722&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d129e423-1e42-40f4-8363-78e5899cc4db\', \'multiverseId\': 174722}, \'multiverseid\': 174722}, {\'name\': \'Sierva de Hojas Marchitas\', \'text\': \'Las otras criaturas verdes que controlas obtienen +1/+1.\\nLas otras criaturas blancas que controlas obtienen +1/+1.\\nSi un hechizo o habilidad que controle un oponente te hace descartar la Sierva de Hojas Marchitas, ponla en juego en vez de ponerla en tu cementerio.\', \'type\': \'Criatura — Caballero elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172916&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'45a382d2-30b7-4fcf-b21f-82fddb0996a4\', \'multiverseId\': 172916}, \'multiverseid\': 172916}, {\'name\': \'Noble féale de Feuilleterne\', \'text\': "Les autres créatures vertes que vous contrôlez gagnent +1/+1.\\nLes autres créatures blanches que vous contrôlez gagnent +1/+1.\\nSi un sort ou une capacité qu\'un adversaire contrôle vous contraint à vous défausser de la Noble féale de Feuilleterne, mettez-la en jeu à la place de la mettre dans votre cimetière.", \'type\': \'Créature : elfe et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173518&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bcf30eea-bac1-4a23-9129-3439ab20e1c1\', \'multiverseId\': 173518}, \'multiverseid\': 173518}, {\'name\': \'Vassallo di Foglia Secca\', \'text\': \'Le altre creature verdi che controlli prendono +1/+1.\\nLe altre creature bianche che controlli prendono +1/+1.\\nSe una magia o abilità controllata da un avversario ti fa scartare il Vassallo di Foglia Secca, mettilo in gioco invece di metterlo nel tuo cimitero.\', \'type\': \'Creatura — Cavaliere Elfo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173819&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c975bb67-b865-4ecb-affc-4b55258a9e79\', \'multiverseId\': 173819}, \'multiverseid\': 173819}, {\'name\': \'萎れ葉のしもべ\', \'text\': \'あなたがコントロールする他の緑のクリーチャーは＋１/＋１の修整を受ける。\\nあなたがコントロールする他の白のクリーチャーは＋１/＋１の修整を受ける。\\nいずれかの対戦相手がコントロールする呪文や能力によって、あなたが萎れ葉のしもべが捨てる場合、それをあなたの墓地に置く代わりに場に出す。\', \'type\': \'クリーチャー — エルフ・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174120&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'82662cf7-c530-4ad3-a66c-20f54ecb062e\', \'multiverseId\': 174120}, \'multiverseid\': 174120}, {\'name\': \'Soberano de Folha Seca\', \'text\': \'As outras criaturas verdes que você controla recebem +1/+1.\\nAs outras criaturas brancas que você controla recebem +1/+1.\\nSe uma mágica ou habilidade que um oponente controla fizer com que você descarte Soberano de Folha Seca, coloque-o em jogo em vez de colocá-lo no seu cemitério.\', \'type\': \'Criatura — Elfo Cavaleiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172314&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'337fc1fc-dd87-4f2d-ae9e-7a40a2635032\', \'multiverseId\': 172314}, \'multiverseid\': 172314}, {\'name\': \'Вассал Темнолесья\', \'text\': \'Другие зеленые существа под вашим контролем получают +1/+1.\\nДругие белые существа под вашим контролем получают +1/+1.\\nЕсли заклинание или способность под контролем оппонента заставляет вас сбросить Вассала Темнолесья, положите его в игру вместо того, чтобы положить его на ваше кладбище.\', \'type\': \'Существо — Эльф Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172615&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ced006bb-933f-45b4-b3b3-6c2d0e2da18e\', \'multiverseId\': 172615}, \'multiverseid\': 172615}, {\'name\': \'枯叶王侯\', \'text\': \'由你操控的其他绿色生物得+1/+1。\\n由你操控的其他白色生物得+1/+1。\\n如果由对手所操控的咒语或异能使你弃掉枯叶王侯，则改为将它放置进场，而非置入你的坟墓场。\', \'type\': \'生物～地精／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173217&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b0984038-9380-441d-a535-03df1fff83cd\', \'multiverseId\': 173217}, \'multiverseid\': 173217}]', "[{'name': 'Vasall von Distelwollheim', 'text': 'Aufblitzen\\nAndere weiße Kreaturen, die du kontrollierst, erhalten +1/+1.\\nAndere blaue Kreaturen, die du kontrollierst, erhalten +1/+1.', 'type': 'Kreatur — Kithkin, Ritter', 'flavor': 'Das Gedankengewebe ist sein Informant, und er ist dessen erklärter Bewahrer.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174630&type=card', 'language': 'German', 'identifiers': {'scryfallId': '56be926a-13e6-4558-8fc4-f2c18939358c', 'multiverseId': 174630}, 'multiverseid': 174630}, {'name': 'Siervo de Flor del Cardo', 'text': 'Destello.\\nLas otras criaturas blancas que controlas obtienen +1/+1.\\nLas otras criaturas azules que controlas obtienen +1/+1.', 'type': 'Criatura — Caballero kithkin', 'flavor': 'La trama mental es su informante, y él es su fiel guardián.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172824&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'd9e13051-dc71-420b-a1a2-5383b7441b34', 'multiverseId': 172824}, 'multiverseid': 172824}, {'name': 'Noble féal de Buttechardon', 'text': 'Flash\\nLes autres créatures blanches que vous contrôlez gagnent +1/+1.\\nLes autres créatures bleues que vous contrôlez gagnent +1/+1.', 'type': 'Créature : sangami et chevalier', 'flavor': 'Si la tramepensée est son informateur, il en est le gardien dévoué.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173426&type=card', 'language': 'French', 'identifiers': {'scryfallId': '27818765-3ac9-4b1c-a8f5-170d65b64d80', 'multiverseId': 173426}, 'multiverseid': 173426}, {'name': 'Vassallo di Cardo Appassito', 'text': 'Lampo\\nLe altre creature bianche che controlli prendono +1/+1.\\nLe altre creature blu che controlli prendono +1/+1.', 'type': 'Creatura — Cavaliere Kithkin', 'flavor': 'La trama dei pensieri è la sua informatrice e lui il suo guardiano devoto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173727&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'efef983b-fb1c-4fcf-a8db-42ea99b20c73', 'multiverseId': 173727}, 'multiverseid': 173727}, {'name': 'シスルダウンのしもべ', 'text': '瞬速\\nあなたがコントロールする他の白のクリーチャーは＋１/＋１の修整を受ける。\\nあなたがコントロールする他の青のクリーチャーは＋１/＋１の修整を受ける。', 'type': 'クリーチャー — キスキン・騎士', 'flavor': '思考の糸は彼の密告者であり、彼はその忠実な守護者だ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174028&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a612cca3-7bf9-4450-b9f4-c6a9395fbb90', 'multiverseId': 174028}, 'multiverseid': 174028}, {'name': 'Soberano de Cardovale', 'text': 'Lampejo\\nAs outras criaturas brancas que você controla recebem +1/+1.\\nAs outras criaturas azuis que você controla recebem +1/+1.', 'type': 'Criatura — Kithkin Cavaleiro', 'flavor': 'A trama-mental é seu informante, e ele seu devotado guardião.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172222&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '88a51bae-e39b-4ef6-8236-8c3467b38045', 'multiverseId': 172222}, 'multiverseid': 172222}, {'name': 'Вассал Чертополошья', 'text': 'Миг\\nДругие белые существа под вашим контролем получают +1/+1.\\nДругие синие существа под вашим контролем получают +1/+1.', 'type': 'Существо — Кискен Рыцарь', 'flavor': 'Узы сплетенных мыслей его советники, а он их верный страж.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172523&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '534aa9f9-3e2c-40b2-8fe6-a560c7865d33', 'multiverseId': 172523}, 'multiverseid': 172523}, {'name': '蓟丘王侯', 'text': '闪现\\n由你操控的其他白色生物得+1/+1。\\n由你操控的其他蓝色生物得+1/+1。', 'type': '生物～洁英／骑士', 'flavor': '纺思是他的消息来源，他则是纺思的忠诚护卫。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173125&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '16d0c8e9-f8ce-44b3-bb4f-65a6695fd479', 'multiverseId': 173125}, 'multiverseid': 173125}]", '[{\'name\': \'Vergnügliche Sabotage\', \'text\': \'Zerstöre ein Artefakt oder eine Verzauberung deiner Wahl.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere den Zauberspruch; du kannst für die Kopie ein neues Ziel bestimmen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174593&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f9da0c5-6a88-40e3-9f64-030da1a7bea3\', \'multiverseId\': 174593}, \'multiverseid\': 174593}, {\'name\': \'Sabotaje jubiloso\', \'text\': \'Destruye el artefacto o encantamiento objetivo.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo y puedes elegir un nuevo objetivo para la copia.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172787&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'ae50e946-9bad-4476-9f7b-16e6b2583ac3\', \'multiverseId\': 172787}, \'multiverseid\': 172787}, {\'name\': \'Sabotage jubilatoire\', \'text\': "Détruisez l\'artefact ciblé ou l\'enchantement ciblé.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le et vous pouvez choisir une nouvelle cible pour la copie.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173389&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f8c4e8ee-c7e6-4d2b-9006-0297d6a51116\', \'multiverseId\': 173389}, \'multiverseid\': 173389}, {\'name\': \'Sabotaggio Divertente\', \'text\': \'Distruggi un artefatto o un incantesimo bersaglio.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia. Puoi scegliere un nuovo bersaglio per la copia.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173690&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f470ff25-e3cc-4268-a6c4-cb931edabebc\', \'multiverseId\': 173690}, \'multiverseid\': 173690}, {\'name\': \'上機嫌の破壊\', \'text\': \'アーティファクト１つかエンチャント１つを対象とし、それを破壊する。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。あなたはそのコピーの新たな対象を選んでもよい。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173991&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'db7736f6-e01c-49b7-891a-eb7df00dd9b3\', \'multiverseId\': 173991}, \'multiverseid\': 173991}, {\'name\': \'Sabotagem Jubilante\', \'text\': \'Destrua o artefato ou o encantamento alvo.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela e você poderá escolher um novo alvo para a cópia.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172185&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'128e29cb-a91d-4d39-b8cf-eb1e4b184ffb\', \'multiverseId\': 172185}, \'multiverseid\': 172185}, {\'name\': \'Веселый Саботаж\', \'text\': \'Уничтожьте целевой артефакт или чары.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его, и вы можете выбрать новую цель для этой копии.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172486&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'135a5779-0876-4252-9414-68ec14fec11f\', \'multiverseId\': 172486}, \'multiverseid\': 172486}, {\'name\': \'欢乐破坏\', \'text\': \'消灭目标神器或结界。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语，且你可以为该复制品选择新的目标。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173088&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d39dcfd1-68c0-4321-8977-a3ce0500f1eb\', \'multiverseId\': 173088}, \'multiverseid\': 173088}]', '[{\'name\': \'Vernarben\', \'text\': \'Lege eine -1/-1-Marke auf eine Kreatur deiner Wahl.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Was ist eine Narbe? Ein Zeichen von Mut in Gefahrenzeiten? Eine Unreinheit der Haut? Oder eine ständige Erinnerung an Schmerz und die Verrücktheiten des Krieges." —Illulia von der Nachtesse\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174671&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1822b8d6-42c4-4409-839d-e452bae0e9fa\', \'multiverseId\': 174671}, \'multiverseid\': 174671}, {\'name\': \'Dejar una cicatriz\', \'text\': \'Pon un contador -1/-1 sobre la criatura objetivo.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Qué es una cicatriz? ¿Un signo de coraje frente al peligro? ¿Un truco de la carne? O un recordatorio constante del dolor agonizante y la insensatez de la guerra." —Illulia de Fogón Nocturno\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172865&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'31b89df6-9efe-41d2-a61a-3759096bd201\', \'multiverseId\': 172865}, \'multiverseid\': 172865}, {\'name\': \'Cicatrice\', \'text\': \'Mettez un marqueur -1/-1 sur la créature ciblée.\', \'type\': \'Éphémère\', \'flavor\': "« Qu\'est-ce qu\'une cicatrice ? Un signe de courage face au danger ? Un caprice de la peau ? Ou le rappel constant d\'une atroce douleur, et de la folie de la guerre ? » —Illulia des Noctâtres", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173467&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'16e19604-4f5d-488b-b15d-27dba91d7d93\', \'multiverseId\': 173467}, \'multiverseid\': 173467}, {\'name\': \'Cicatrice\', \'text\': \'Metti un segnalino -1/-1 su una creatura bersaglio.\', \'type\': \'Istantaneo\', \'flavor\': \'"Cos\\\'è una cicatrice? Un segno di coraggio e sprezzo del pericolo? Un semplice scherzo della pelle? O un ricordo imperituro del dolore agonizzante e delle follie della guerra." —Illulia del Tetro Focolare\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173768&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'5508bfe3-669a-46d4-a5f7-5f40da5a43cb\', \'multiverseId\': 173768}, \'multiverseid\': 173768}, {\'name\': \'傷跡\', \'text\': \'クリーチャー１体を対象とし、それの上に－１/－１カウンターを１個置く。\', \'type\': \'インスタント\', \'flavor\': \'「傷跡とは何？ 危険に立ち向かった勇気の印？ ただの肉のよじれ？ それとも苦悶の痛みと戦いの愚かさを忘れないためのものなのではないの。」 ――ナイトハースのイルリア\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174069&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5992a4d9-a651-4609-bbbe-49634746431e\', \'multiverseId\': 174069}, \'multiverseid\': 174069}, {\'name\': \'Cicatriz\', \'text\': \'Coloque um marcador -1/-1 na criatura alvo.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O que é uma cicatriz? Um sinal de coragem na face do perigo? Um mero truque da carne? Ou um lembrete constante da dor agonizante e das loucuras da guerra?" — Illulia, dos Larescuro\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172263&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'513fa43f-2dac-4a03-bcf7-89d8cb35e984\', \'multiverseId\': 172263}, \'multiverseid\': 172263}, {\'name\': \'Шрам\', \'text\': \'Положите один жетон -1/-1 на целевое существо.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Что есть шрам? Признак доблести перед лицом опасности? Просто отметина на бренном теле? Или же постоянное напоминание о мучительной боли и безумии войны?» — Иллулия из культа темносветов\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172564&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e747cb39-4764-4230-9e2e-56369eef5f3d\', \'multiverseId\': 172564}, \'multiverseid\': 172564}, {\'name\': \'划疤\', \'text\': \'在目标生物上放置一个-1/-1指示物。\', \'type\': \'瞬间\', \'flavor\': \'「疤痕是什么？ 面临刀尖时的勇气标志？ 仅只是肉体的装饰？ 或者是悲苦伤痛的备忘录，纪录战争的愚行？」 ～夜炉的伊璐里\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173166&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ee5e2326-9580-4ec6-80e6-1ff2bb082f60\', \'multiverseId\': 173166}, \'multiverseid\': 173166}]', '[{\'name\': \'Verschmutzte Verbindungen\', \'text\': \'Immer wenn ein Land unter der Kontrolle eines Gegners ins Spiel kommt, verliert dieser Gegner 2 Lebenspunkte, und du erhältst 2 Lebenspunkte dazu.\', \'type\': \'Verzauberung\', \'flavor\': \'Die mystische Verbindung zwischen Zaubernden und dem Land ist genauso verwundbar wie die Zauberer selbst.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174551&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1c477aa1-9722-4236-ad23-ad4b349aa3ec\', \'multiverseId\': 174551}, \'multiverseid\': 174551}, {\'name\': \'Vínculos polucionados\', \'text\': \'Siempre que una tierra entre en juego bajo el control de un oponente, ese jugador pierde 2 vidas y tú ganas 2 vidas.\', \'type\': \'Encantamiento\', \'flavor\': \'El vínculo místico entre los hechiceros y la tierra es tan fácil de atacar como los mismos hechiceros.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172745&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'fba65b6f-24ee-45a5-bc62-adec8c44f717\', \'multiverseId\': 172745}, \'multiverseid\': 172745}, {\'name\': \'Liens pollués\', \'text\': "À chaque fois qu\'un terrain arrive en jeu sous le contrôle d\'un adversaire, ce joueur perd 2 points de vie et vous gagnez 2 points de vie.", \'type\': \'Enchantement\', \'flavor\': \'Le lien mystique existant entre les lanceurs de sort et la terre est tout aussi vulnérable que les magiciens eux-mêmes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173347&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5e5a25eb-a755-4af8-89c1-e29f7237a5a1\', \'multiverseId\': 173347}, \'multiverseid\': 173347}, {\'name\': \'Legami Inquinati\', \'text\': \'Ogniqualvolta una terra entra in gioco sotto il controllo di un avversario, quel giocatore perde 2 punti vita e tu guadagni 2 punti vita.\', \'type\': \'Incantesimo\', \'flavor\': \'Il legame mistico tra gli incantatori e la terra è tanto vulnerabile agli attacchi quanto gli stessi incantatori.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173648&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ad31479a-f32c-45c6-b94b-1f81bed0a9d7\', \'multiverseId\': 173648}, \'multiverseid\': 173648}, {\'name\': \'穢れた結合\', \'text\': \'いずれかの土地がいずれかの対戦相手のコントロール下で場に出るたび、そのプレイヤーは２点のライフを失い、あなたは２点のライフを得る。\', \'type\': \'エンチャント\', \'flavor\': \'術者と地を結ぶ神秘的な結びつきは、術者自身と同じぐらい攻撃には弱い。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173949&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'45e0161a-12a3-43cc-9e19-212ab81ea452\', \'multiverseId\': 173949}, \'multiverseid\': 173949}, {\'name\': \'Elos Poluídos\', \'text\': \'Toda vez que um terreno entra em jogo sob o controle de um oponente, aquele jogador perde 2 pontos de vida e você ganha 2 pontos de vida.\', \'type\': \'Encantamento\', \'flavor\': \'O elo místico entre os mágicos e a terra é tão vulnerável ao ataque quanto os próprios mágicos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172143&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'23251cf8-82b4-48ac-9b76-6ef0832a7e24\', \'multiverseId\': 172143}, \'multiverseid\': 172143}, {\'name\': \'Оскверненные Узы\', \'text\': \'Каждый раз, когда в игру входит земля под контролем оппонента, тот игрок теряет 2 жизни, а вы получаете 2 жизни.\', \'type\': \'Чары\', \'flavor\': \'Мистические узы между заклинателями и землей так же уязвимы для атаки, как и сами заклинатели.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172444&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'71db7bbc-9950-422d-a09d-09d03eccd0cb\', \'multiverseId\': 172444}, \'multiverseid\': 172444}, {\'name\': \'污物羁绊\', \'text\': \'每当一个地在对手的操控下进场时，该牌手失去2点生命且你获得2点生命。\', \'type\': \'结界\', \'flavor\': \'施术者与大地之间的神秘连结，就如术者本身同样脆弱而不堪一击。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173046&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ba699134-29a6-4752-98a0-af8a2460bccd\', \'multiverseId\': 173046}, \'multiverseid\': 173046}]', '[{\'name\': \'Versunkene Ruinen\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{U/B}, {T}: Erhöhe deinen Manavorrat um {U}{U}, {U}{B} oder {B}{B}.\', \'type\': \'Land\', \'flavor\': \'Ohne die Gezeitenveränderer befinden sich die Rinnen in einem verwahrlosten Zustand. Einige haben ganze Städte überflutet, andere verkümmerten und hinterließen gesprungenen Lehm.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174757&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6dd32e71-ea64-4577-a4de-bb41dbdaef18\', \'multiverseId\': 174757}, \'multiverseid\': 174757}, {\'name\': \'Ruinas hundidas\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{U/B}, {T}: Agrega {U}{U}, {U}{B}, o {B}{B} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': \'Sin la atención de los moldeadores de la marea, las Vías están descuidadas. Algunas inundaron ciudades enteras, otras se convirtieron en barro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172951&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3c98aecb-f4ec-4b5e-9a71-d9c1d52c055d\', \'multiverseId\': 172951}, \'multiverseid\': 172951}, {\'name\': \'Ruines englouties\', \'text\': \'{T} : Ajoutez {1} à votre réserve.\\n{U/B}, {T} : Ajoutez {U}{U}, {U}{B} ou {B}{B} à votre réserve.\', \'type\': \'Terrain\', \'flavor\': "Sans les forge-vagues pour s\'en occuper, les Voies sont à l\'abandon. Certaines ont englouti des villes entières ; d\'autres ne sont plus que des plaines de boue craquelée.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173553&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'07e14ede-5ac3-4bf5-b135-371af2c4ee62\', \'multiverseId\': 173553}, \'multiverseid\': 173553}, {\'name\': \'Rovine Sommerse\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{U/B}, {T}: Aggiungi {U}{U}, {U}{B}, o {B}{B} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': "Senza l\'interessamento dei modellamaree, i Canali vennero trascurati. Alcuni hanno allagato intere città; altri sono diventati fango secco e spezzato.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173854&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d18e5f56-d11b-4766-bff7-aa3c6e641d8b\', \'multiverseId\': 173854}, \'multiverseid\': 173854}, {\'name\': \'沈んだ廃墟\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n, {T}：あなたのマナ・プールに{U}{U}か{U}{B}か{B}{B}を加える。\', \'type\': \'土地\', \'flavor\': \'潮刻みの手入れが無くなった今、「通廊」は忘れ去られたままだった。 あるものは街をすべて飲み込み、またあるものはひび割れた土へと干上がらせた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174155&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3cc3ceb0-9a7f-4c6a-9195-c11e36ec5b33\', \'multiverseId\': 174155}, \'multiverseid\': 174155}, {\'name\': \'Ruínas Submersas\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{U/B}, {T}: Adicione {U}{U}, {U}{B} ou {B}{B} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': \'Sem os cuidados dos molda-marés, as Vias estão abandonadas. Algumas afundaram cidades inteiras; outras secaram até que se tornassem barro ressecado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172349&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cdf6ef17-d08f-4b43-b3e3-f643543e5b1e\', \'multiverseId\': 172349}, \'multiverseid\': 172349}, {\'name\': \'Затопленные Руины\', \'text\': \'{T}: добавьте {1} в ваше хранилище маны.\\n{U/B}, {T}: добавьте {U}{U}, {U}{B} или {B}{B} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': \'Без заботливого ухода волнописцев водотоки пришли в запустение. Некоторые затопили целые города; другие же растрескались сухой грязью.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172650&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'998b93d9-e5e9-4362-9212-fa7f9fcd3f3e\', \'multiverseId\': 172650}, \'multiverseid\': 172650}, {\'name\': \'沉没废墟\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{U/B}，{T}：加{U}{U}，{U}{B}，或{B}{B}到你的法术力池中。\', \'type\': \'地\', \'flavor\': \'渠道没有了塑潮师的维护，就此弃置。 有些将整个村镇淹没；其他的则干涸成龟裂的泥巴。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173252&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3e669213-5066-463e-9ac3-5a30795dc68f\', \'multiverseId\': 173252}, \'multiverseid\': 173252}]', "[{'name': 'Verzauberter Abend', 'text': 'Alle bleibenden Karten sind zusätzlich zu ihren anderen Typen auch Verzauberungen.', 'type': 'Verzauberung', 'flavor': 'In der Spiegelung sah sie, wie die raue Kruste der Welt abbröckelte und die Wahrheit freigab, die darunter schimmerte.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174617&type=card', 'language': 'German', 'identifiers': {'scryfallId': '8dc227b5-56ff-469c-99bb-53f5d903cb1e', 'multiverseId': 174617}, 'multiverseid': 174617}, {'name': 'Atardecer encantado', 'text': 'Todos los permanentes son encantamientos además de sus otros tipos.', 'type': 'Encantamiento', 'flavor': 'En el reflejo, ella vio el cascarón del mundo derrumbándose, mostrando la verdad que brillaba debajo.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172811&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4733b762-9a39-46e8-ac4b-12c823682b6a', 'multiverseId': 172811}, 'multiverseid': 172811}, {'name': 'Soirée enchantée', 'text': 'Tous les permanents sont des enchantements en plus de leurs autres types.', 'type': 'Enchantement', 'flavor': 'Dans le reflet, elle vit la brute carapace du monde se dissoudre, révélant sous elle la vérité scintillante.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173413&type=card', 'language': 'French', 'identifiers': {'scryfallId': '97fb9b75-06da-4b5f-86bf-37f4e15ce3e5', 'multiverseId': 173413}, 'multiverseid': 173413}, {'name': 'Sera Incantata', 'text': 'Tutti i permanenti sono incantesimi in aggiunta ai propri altri tipi.', 'type': 'Incantesimo', 'flavor': 'Nel riflesso, vide il ruvido guscio del mondo scivolare via, rivelando la verità che brillava al di sotto.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173714&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0343430d-f491-4577-920b-adda506f9f73', 'multiverseId': 173714}, 'multiverseid': 173714}, {'name': '魔法の夜', 'text': 'すべてのパーマネントは、自身の他のタイプに加えてエンチャントでもある。', 'type': 'エンチャント', 'flavor': '彼女はその反射の中に、世界の荒々しい殻が剥がれ落ち、その下に光る真実を明かすのを見た。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174015&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '937b7ab5-de37-42a7-9600-433c28857ca2', 'multiverseId': 174015}, 'multiverseid': 174015}, {'name': 'Entardecer Encantado', 'text': 'Todas as permanentes são encantamentos, além de seus outros tipos.', 'type': 'Encantamento', 'flavor': 'No reflexo, ela viu a dura couraça do mundo se desfazendo, revelando a verdade encoberta.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172209&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '170b545c-9a36-4658-9b17-cb92047b3571', 'multiverseId': 172209}, 'multiverseid': 172209}, {'name': 'Чарующий Вечер', 'text': 'Все перманенты являются чарами в дополнение к своим другим типам.', 'type': 'Чары', 'flavor': 'В отражении она увидела, как осыпается грубая оболочка мира, обнажая сияющую под ней правду.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172510&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '635daad3-eb17-40bc-a93b-7a7736a57679', 'multiverseId': 172510}, 'multiverseid': 172510}, {'name': '迷醉傍晚', 'text': '所有永久物额外具有结界此类别。', 'type': '结界', 'flavor': '她在映影中看到世界的粗壳蜕落，展现出内部的真实光辉。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173112&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'b41a82d3-12c9-4e0b-87a6-8d0a8abb1654', 'multiverseId': 173112}, 'multiverseid': 173112}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177818&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'e992a898-9c5d-4b92-9986-566d7eb16ac0', 'multiverseId': 177818}, 'multiverseid': 177818}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177842&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '0206838f-f9b5-4b8c-a5dc-15dc8c22848a', 'multiverseId': 177842}, 'multiverseid': 177842}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177889&type=card', 'language': 'French', 'identifiers': {'scryfallId': '448b2c4c-71be-49ea-8ada-6f7dfeeecb48', 'multiverseId': 177889}, 'multiverseid': 177889}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177913&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '9cb81f4f-9c78-4259-b3ef-e6282b8ac1e6', 'multiverseId': 177913}, 'multiverseid': 177913}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177794&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '516b277c-a0da-4e4b-ac1f-4f1da5186dbf', 'multiverseId': 177794}, 'multiverseid': 177794}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177770&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'f64b99a8-ac8d-45ed-afab-6969a57f80b1', 'multiverseId': 177770}, 'multiverseid': 177770}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177746&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '1190d744-0f6d-4382-b22c-babec5870b55', 'multiverseId': 177746}, 'multiverseid': 177746}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177865&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c7c20402-9012-46bd-aeb0-6b925a15a5d2', 'multiverseId': 177865}, 'multiverseid': 177865}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177819&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd37e3004-5871-46c0-8214-ca2d06d7a86d', 'multiverseId': 177819}, 'multiverseid': 177819}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177843&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '3cacee64-db55-4bf5-96cb-7423aee25f0f', 'multiverseId': 177843}, 'multiverseid': 177843}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177890&type=card', 'language': 'French', 'identifiers': {'scryfallId': '1a530c9e-f236-42ac-98bd-3a785bbafa66', 'multiverseId': 177890}, 'multiverseid': 177890}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177914&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'd6d0555a-f95e-438a-be9e-fb141235aae5', 'multiverseId': 177914}, 'multiverseid': 177914}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177795&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cf5dc6f0-4926-4f67-86c4-03defe11d85d', 'multiverseId': 177795}, 'multiverseid': 177795}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177771&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a25e65a7-fabb-47af-be4e-a51affbcb970', 'multiverseId': 177771}, 'multiverseid': 177771}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177747&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '88164d2a-2c5f-4644-9bc3-435fa9d67293', 'multiverseId': 177747}, 'multiverseid': 177747}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177866&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e9476773-bf77-45ba-88db-df2dbf000f74', 'multiverseId': 177866}, 'multiverseid': 177866}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177820&type=card', 'language': 'German', 'identifiers': {'scryfallId': '5164fe43-72c5-4e9d-8d45-cd90e1a820aa', 'multiverseId': 177820}, 'multiverseid': 177820}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177844&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '37023d1b-f965-4acb-9e61-1e4047676ec6', 'multiverseId': 177844}, 'multiverseid': 177844}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177891&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cc557f02-952e-4680-a28f-b4dc0bbd1734', 'multiverseId': 177891}, 'multiverseid': 177891}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177915&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'ddaa9e80-366e-4c65-8fea-39b2945298fe', 'multiverseId': 177915}, 'multiverseid': 177915}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177796&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'a4258fd7-caec-4aa3-84ec-1cc6a92746af', 'multiverseId': 177796}, 'multiverseid': 177796}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177772&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '96da9643-d647-4dea-abb6-d990036cf9d8', 'multiverseId': 177772}, 'multiverseid': 177772}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177748&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '3b8d06bf-28a9-47cb-a011-353c787dc4e4', 'multiverseId': 177748}, 'multiverseid': 177748}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177867&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '673a0509-2ff5-4376-a93f-1b80a1041fe8', 'multiverseId': 177867}, 'multiverseid': 177867}]", "[{'name': 'Wald', 'type': 'Standardland — Wald', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177821&type=card', 'language': 'German', 'identifiers': {'scryfallId': '3855ae88-59e6-4e22-b813-e4dc1713fcda', 'multiverseId': 177821}, 'multiverseid': 177821}, {'name': 'Bosque', 'type': 'Tierra básica — Bosque', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177845&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '94962a2c-4f7e-4fbf-9409-8fbf458e41a8', 'multiverseId': 177845}, 'multiverseid': 177845}, {'name': 'Forêt', 'type': 'Terrain de base : forêt', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177892&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'cf00e991-10f2-4b18-b398-94e4c9cb77d3', 'multiverseId': 177892}, 'multiverseid': 177892}, {'name': 'Foresta', 'type': 'Terra Base — Foresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177916&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'c5dff7bb-f740-4385-b38b-7dd7d4661e5c', 'multiverseId': 177916}, 'multiverseid': 177916}, {'name': '森', 'type': '基本土地 — 森', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177797&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '79548599-905e-49cb-b877-fa03a8309411', 'multiverseId': 177797}, 'multiverseid': 177797}, {'name': 'Floresta', 'type': 'Terreno Básico — Floresta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177773&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '13fe1ae0-ccb4-4b58-965e-40be3d9500ca', 'multiverseId': 177773}, 'multiverseid': 177773}, {'name': 'Лес', 'type': 'Базовая Земля — Лес', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177749&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '2009f2c6-d833-48c5-b463-1e3bc0afea61', 'multiverseId': 177749}, 'multiverseid': 177749}, {'name': '树林', 'type': '基本地～树林', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=177868&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '4b5e68e1-2809-456d-8465-6c40875351be', 'multiverseId': 177868}, 'multiverseid': 177868}]", "[{'name': 'Wanderessig-Wurzelhacker', 'text': 'Der Wanderessig-Wurzelhacker kann von grünen Kreaturen nicht geblockt werden.', 'type': 'Kreatur — Meervolk, Räuber', 'flavor': 'Die meisten Landbewohner kennen nur die hinterhältigen Merrow, die in den flachen Gewässern leben. Sie kennen das wahre Böse nicht, das in den Dunklen Mäandern lauert.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174655&type=card', 'language': 'German', 'identifiers': {'scryfallId': '66a36804-3afe-4f22-befe-6de4b55d1d2d', 'multiverseId': 174655}, 'multiverseid': 174655}, {'name': 'Cortarraíces de Lágrimaerrante', 'text': 'Los Cortarraíces de Lágrimaerrante no pueden ser bloqueados por criaturas verdes.', 'type': 'Criatura — Bribón tritón', 'flavor': 'La mayoría de los terrestres sólo conocen a los perversos merrow que habitan en los bajíos. Ni siquiera se imaginan la maldad que ronda por los Meandros Oscuros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172849&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '16a831ba-ec1e-4ce8-9a1c-dfab8b62fbd6', 'multiverseId': 172849}, 'multiverseid': 172849}, {'name': 'Couperacines de Bruinerrance', 'text': 'Les Couperacines de Bruinerrance ne peuvent pas être bloqués par les créatures vertes.', 'type': 'Créature : ondin et gredin', 'flavor': 'Les foulepoussières connaissent surtout les suires vicieux qui résident dans les eaux peu profondes. Ils ne peuvent même pas imaginer le mal qui rôde dans les Méandres obscurs.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173451&type=card', 'language': 'French', 'identifiers': {'scryfallId': '438208f2-cbde-485d-9be2-4ff180f45ce5', 'multiverseId': 173451}, 'multiverseid': 173451}, {'name': 'Tagliaradici di Brina Errante', 'text': 'I Tagliaradici di Brina Errante non possono essere bloccati dalle creature verdi.', 'type': 'Creatura — Farabutto Tritone', 'flavor': 'Molti terricoli conoscono solo i corrotti merrow che abitano le acque poco profonde. Non riescono a immaginarsi la malvagità rintanata nei Meandri Oscuri.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173752&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '1180953c-b1e2-428f-bdba-094df5b75bf0', 'multiverseId': 173752}, 'multiverseid': 173752}, {'name': 'ワンダーブラインの根切り', 'text': 'ワンダーブラインの根切りは緑のクリーチャーによってはブロックされない。', 'type': 'クリーチャー — マーフォーク・ならず者', 'flavor': '泥歩きのほとんどは、浅瀬に住む恐るべきメロウのことしか知らない。 闇うねりの中に潜む者の邪悪さを推し量ることなどできないのだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174053&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '45d1647a-fb46-4df3-960d-7158bbc1b792', 'multiverseId': 174053}, 'multiverseid': 174053}, {'name': 'Corta-Raízes de Salmorerrante', 'text': 'Corta-Raízes de Salmorerrante não pode ser bloqueado por criaturas verdes.', 'type': 'Criatura — Tritão Ladino', 'flavor': 'A maioria dos seres rastejantes conhece apenas os cruéis sirenídeos que habitam os charcos. Eles não podem nem imaginar a maldade que se esconde nos Meandros Escuros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172247&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'aaca0640-aed2-48c2-8677-dd4b49025116', 'multiverseId': 172247}, 'multiverseid': 172247}, {'name': 'Корнерезы Уондербрайна', 'text': 'Корнерезы Уондербрайна не могут быть заблокированы зелеными существами.', 'type': 'Существо — Мерфолк Бродяга', 'flavor': 'Большинство грязебродов знакомы только с вредными мерроу, обитающими на мелководье. Они даже представить себе не могут, какое зло скрывается в Темных Меандрах.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172548&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'b9fcb07a-1642-4b54-9ec2-80433719689e', 'multiverseId': 172548}, 'multiverseid': 172548}, {'name': '漫涩河刈根客', 'text': '漫涩河刈根客不能被绿色生物阻挡。', 'type': '生物～人鱼／浪客', 'flavor': '大多数陆行者只见过居住在浅滩的凶猛美洛。 而他们根本还比不上藏在暗曲礁的恶毒份子。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173150&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'e21373b5-8011-4599-a353-2f8bca861649', 'multiverseId': 173150}, 'multiverseid': 173150}]", '[{\'name\': \'Wegpacken\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl. Du kannst bis zu einer Karte deiner Wahl aus deinem Friedhof in deine Bibliothek mischen.\', \'type\': \'Spontanzauber\', \'flavor\': \'Kithkin-Zauberabfüller verwenden die Hälfte ihrer Zeit, alte Erinnerungen aufzubewahren, und die andere Hälfte, neue zu bestrafen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174525&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'8262c46b-2820-4fff-b8f7-6c6f38241075\', \'multiverseId\': 174525}, \'multiverseid\': 174525}, {\'name\': \'Apartar\', \'text\': \'Contrarresta el hechizo objetivo. Puedes barajar hasta una carta objetivo de tu cementerio en tu biblioteca.\', \'type\': \'Instantáneo\', \'flavor\': \'Los embotelladores de hechizos kithkin pasan la mitad de su tiempo preservando viejos recuerdos y la otra mitad castigando los nuevos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172719&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1f0f315f-d54e-4a53-8638-f17fec551c92\', \'multiverseId\': 172719}, \'multiverseid\': 172719}, {\'name\': \'Rangement\', \'text\': "Contrecarrez le sort ciblé. Vous pouvez mélanger jusqu\'à une carte ciblée de votre cimetière dans votre bibliothèque.", \'type\': \'Éphémère\', \'flavor\': "Les embouteilleurs sangamis passent la moitié de leur temps à conserver d\'anciens souvenirs et l\'autre à punir les nouveaux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173321&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7bde13fc-8285-4c30-953f-3e5418c7ea25\', \'multiverseId\': 173321}, \'multiverseid\': 173321}, {\'name\': \'Mettere Via\', \'text\': \'Neutralizza una magia bersaglio. Puoi rimescolare nel tuo grimorio fino a una carta bersaglio nel tuo cimitero.\', \'type\': \'Istantaneo\', \'flavor\': "Gli imbottigliatori di magie kithkin passano metà del loro tempo a conservare le antiche memorie e l\'altra metà a punire quelle nuove.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173622&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e364b069-80b0-4b3d-b814-2def6733ba7f\', \'multiverseId\': 173622}, \'multiverseid\': 173622}, {\'name\': \'片付け\', \'text\': \'呪文１つと、あなたの墓地にあるカードを最大１枚まで対象とする。その前者を打ち消す。 あなたはその後者をあなたのライブラリーに加えて切り直してもよい。\', \'type\': \'インスタント\', \'flavor\': \'キスキンの呪文詰め師は、その時間の半分を古い記憶の貯蔵に、残りの半分を新しいものの酷使に費やしている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173923&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'5dbe1c2e-f8c3-45ea-afe3-1e0a3b23109e\', \'multiverseId\': 173923}, \'multiverseid\': 173923}, {\'name\': \'Guardar\', \'text\': \'Anule a mágica alvo. Você pode embaralhar no seu grimório até um card alvo do seu cemitério.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Os engarrafadores de mágica kithkin passam metade de seu tempo preservando antigas recordações e a outra metade punindo as novas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172117&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95d68719-0f65-436a-ab51-a2fd1fb042de\', \'multiverseId\': 172117}, \'multiverseid\': 172117}, {\'name\': \'Упрятать\', \'text\': \'Отмените целевое заклинание. Вы можете втасовать не более одной целевой карты из вашего кладбища в вашу библиотеку.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Кискенские хранители заклинаний половину времени тратят на то, чтобы сохранить старые воспоминания, а вторую половину на то, чтобы наказать новые.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172418&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bae261db-2370-43ec-99f2-9d67ee12160b\', \'multiverseId\': 172418}, \'multiverseid\': 172418}, {\'name\': \'封存\', \'text\': \'反击目标咒语。 你可以将至多一张目标牌从你坟墓场洗入你的牌库。\', \'type\': \'瞬间\', \'flavor\': \'洁英瓶咒师花上一半时间来保存旧记忆，另一半则拿来惩罚新记忆。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173020&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'975cf1af-4eba-43e9-b079-75f95b6fdfab\', \'multiverseId\': 173020}, \'multiverseid\': 173020}]', '[{\'name\': \'Weltreinigung\', \'text\': \'Bringe alle bleibenden Karten auf die Hand ihrer Besitzer zurück. Jeder Spieler bestimmt bis zu sieben der Karten auf seiner Hand und mischt den Rest dann in seine Bibliothek. Entleere alle Manavorräte.\', \'type\': \'Hexerei\', \'flavor\': \'Die Aurora ist nicht das einzige magische Ereignis, das eine Welt neu erschaffen kann.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174633&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'475bd6dc-aaf3-4c1b-ae5e-f4b14b9a39dc\', \'multiverseId\': 174633}, \'multiverseid\': 174633}, {\'name\': \'Purgar el mundo\', \'text\': \'Regresa todos los permanentes a las manos de sus propietarios. Cada jugador elige hasta siete cartas de su mano, luego baraja el resto en su biblioteca. Vacía todas las reservas de maná.\', \'type\': \'Conjuro\', \'flavor\': \'La Aurora Celeste no es la única magia capaz de reconstruir el mundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172827&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2e6840ad-3b27-488d-9433-5086ae28542b\', \'multiverseId\': 172827}, \'multiverseid\': 172827}, {\'name\': \'Purgemonde\', \'text\': "Renvoyez tous les permanents dans les mains de leurs propriétaires. Chaque joueur choisit jusqu\'à sept cartes dans sa main, et il mélange ensuite le reste dans sa bibliothèque. Videz toutes les réserves de mana.", \'type\': \'Rituel\', \'flavor\': "L\'Aurore n\'est pas la seule magie à pouvoir refaire le monde.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173429&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'0e5c18b8-99ee-4220-8e29-54ef4c907f48\', \'multiverseId\': 173429}, \'multiverseid\': 173429}, {\'name\': \'Purificazione dei Mondi\', \'text\': \'Fai tornare tutti i permanenti in mano ai loro proprietari. Ogni giocatore sceglie fino a sette carte nella propria mano, poi rimescola le altre nel proprio grimorio. Vuota tutte le riserve di mana.\', \'type\': \'Stregoneria\', \'flavor\': "La Luminaria non è l\'unica magia capace di ricostruire un mondo.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173730&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'68345785-f897-4d32-bc43-50c53f71a660\', \'multiverseId\': 173730}, \'multiverseid\': 173730}, {\'name\': \'世界粛清\', \'text\': \'すべてのパーマネントをオーナーの手札に戻す。 各プレイヤーは自分の手札にあるカードを最大７枚まで選び、その後残りを自分のライブラリーに加えて切り直す。 すべてのマナ・プールを空にする。\', \'type\': \'ソーサリー\', \'flavor\': \'世界を作り直すことのできる魔法はオーロラだけではなかった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174031&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e6b38752-d9fb-444d-9b80-11e4756007ef\', \'multiverseId\': 174031}, \'multiverseid\': 174031}, {\'name\': \'Expurga-Mundo\', \'text\': \'Devolva todas as permanentes para as mãos de seus donos. Cada jogador escolhe até sete cards de sua própria mão e embaralha o restante em seu próprio grimório. Esvazie todas as reservas de mana.\', \'type\': \'Feitiço\', \'flavor\': \'A Aurora não é a única mágica capaz de refazer o mundo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172225&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8f2c4175-a4b7-434e-9450-091c3675cd20\', \'multiverseId\': 172225}, \'multiverseid\': 172225}, {\'name\': \'Мироочищение\', \'text\': \'Верните все перманенты в руки их владельцев. Каждый игрок выбирает не более семи карт из своей руки, затем втасовывает остальные в свою библиотеку. Опустошите все хранилища маны.\', \'type\': \'Волшебство\', \'flavor\': \'Аврора не единственная магия, способная переделать мир.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172526&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4caccbfa-4f64-43ea-b223-5e4a5ccc8e48\', \'multiverseId\': 172526}, \'multiverseid\': 172526}, {\'name\': \'涤净世界\', \'text\': \'将所有永久物各移回其拥有者手上。 每位牌手从其手上选择至多七张牌，然后将其余的牌洗入其牌库。 清空所有法术力池。\', \'type\': \'法术\', \'flavor\': \'极光不是唯一能重塑世界的法术。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173128&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'336ccc1e-b103-41ae-8eed-6f252e2d0f11\', \'multiverseId\': 173128}, \'multiverseid\': 173128}]', '[{\'name\': \'Wespenstachel-Lanzenträger\', \'text\': \'Fliegend\', \'type\': \'Kreatur — Feenwesen, Soldat\', \'flavor\': \'„Ich bezweifle, dass Feen verstehen, wie kurz ihr Leben im Vergleich zu unserem ist. Denn wenn sie es täten, würden sie nicht so willig in die Schlacht ziehen und die Gefahren nicht beachten." —Awylla, elfische Sichermacherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174656&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'84bc029b-ac38-42c1-bd3f-7e25f04f60da\', \'multiverseId\': 174656}, \'multiverseid\': 174656}, {\'name\': \'Lancera avispa\', \'text\': \'Vuela.\', \'type\': \'Criatura — Soldado hada\', \'flavor\': \'"Dudo que las hadas entiendan lo cortas que son sus vidas, comparadas con el resto de nosotros. Si lo hicieran, ¿se lanzarían a la batalla, inconcientes del peligro frente a ellas?" —Awylla, refugiante élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172850&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'60994c38-d880-4a0f-ac97-1f704db742c4\', \'multiverseId\': 172850}, \'multiverseid\': 172850}, {\'name\': \'Lancier guêpe\', \'text\': \'Vol\', \'type\': \'Créature : peuple fée et soldat\', \'flavor\': "« Je doute que les faeries comprennent à quel point leur vie est courte comparée à la nôtre. Si c\'était le cas, continueraient-elles de charger au combat sans se soucier du danger ? » —Awylla, protecturge elfe", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173452&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24437fdf-5959-4345-86ae-3eea252d5234\', \'multiverseId\': 173452}, \'multiverseid\': 173452}, {\'name\': \'Lanciere Punta di Vespa\', \'text\': \'Volare\', \'type\': \'Creatura — Soldato Spiritello\', \'flavor\': \'"Dubito che gli spiritelli comprendano quanto brevi siano le loro vite, rispetto alle nostre. Se così fosse, si lancerebbero in battaglia così avventatamente, senza curarsi del pericolo che li attende?" —Awylla, salvaincanti elfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173753&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'daa9d8e1-4564-4d92-a957-febb19cd2b7b\', \'multiverseId\': 173753}, \'multiverseid\': 173753}, {\'name\': \'スズメバチの槍兵\', \'text\': \'飛行\', \'type\': \'クリーチャー — フェアリー・兵士\', \'flavor\': \'「妖精が我々に比べて短い生涯であるなど、あれは知らぬであろう。 知っているなら、もっと望んで戦いに望み、その前にはだかる危難に恐れなどしないだろうに。」 ――エルフの守美者、アウィラ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174054&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'44441500-3962-49f1-be62-6fd2c584bb37\', \'multiverseId\': 174054}, \'multiverseid\': 174054}, {\'name\': \'Lanceiro de Vespa\', \'text\': \'Voar\', \'type\': \'Criatura — Fada Soldado\', \'flavor\': \'"Duvido que aquelas fadas compreendam o quanto a vida delas é curta, em comparação a nós. Se compreendessem, será que entrariam numa batalha tão prontamente, indiferentes ao perigo que as aguarda?" — Awylla, pulcro-protetora élfica\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172248&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1867b5c0-47b1-4831-9eff-4d02250c8676\', \'multiverseId\': 172248}, \'multiverseid\': 172248}, {\'name\': \'Налетчик с Осиным Копьем\', \'text\': \'Полет\', \'type\': \'Существо — Фея Солдат\', \'flavor\': \'«Сомневаюсь, что феи понимают, насколько коротки их жизни по сравнению с нашими. Если бы они отдавали себе в этом отчет, неужели бы они бросались в бой, навстречу опасности, с такой готовностью и безрассудством?» — Авилла, эльфийская охранительница\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172549&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e07edd7-1aca-4ef8-8783-0b3527aa6e47\', \'multiverseId\': 172549}, \'multiverseid\': 172549}, {\'name\': \'蜂矛兵\', \'text\': \'飞行\', \'type\': \'生物～仙灵／士兵\', \'flavor\': \'「自己的一生跟其他族比起来有多短，我怀疑仙灵根本不懂。 如果他们真懂了，还会这样欣然投入战场、毫不在意眼前危险吗？」 ～地精美境卫艾薇拉\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173151&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'31be63f2-8b2c-4c2f-a0b3-4d71f7832ce0\', \'multiverseId\': 173151}, \'multiverseid\': 173151}]', '[{\'name\': \'Wetternder Magier\', \'text\': \'Opfere den Wetternden Magier: Zerstöre ein Nichtstandardland deiner Wahl.\', \'type\': \'Kreatur — Elementarwesen, Schamane\', \'flavor\': \'„Unsicheres Gelände — kein Durchgang" —Schild nahe des ehemaligen Hügelgrabs von Pyrtagh\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174665&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1e42315f-b25f-4de6-b3cf-883bbecce915\', \'multiverseId\': 174665}, \'multiverseid\': 174665}, {\'name\': \'Mago fulminador\', \'text\': \'Sacrificar el Mago fulminador: Destruye la tierra objetivo que no sea básica.\', \'type\': \'Criatura — Chamán elemental\', \'flavor\': \'"Terreno inseguro adelante—Regrese" —Señal cercana a la antigua ubicación del Cairn Pyrtagh\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172859&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'3409c9b7-8c4a-4f9d-8187-b1ef11928ffd\', \'multiverseId\': 172859}, \'multiverseid\': 172859}, {\'name\': \'Mage fulminateur\', \'text\': \'Sacrifiez le Mage fulminateur : Détruisez le terrain non-base ciblé.\', \'type\': \'Créature : élémental et shamane\', \'flavor\': "« Terrain dangereux — Faites demi-tour. » —Panneau proche de l\'ancien site du Cairn de Pyrtagh", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173461&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2211f43a-f4a2-40ac-b9be-e436a1f78de3\', \'multiverseId\': 173461}, \'multiverseid\': 173461}, {\'name\': \'Mago Fulminatore\', \'text\': \'Sacrifica il Mago Fulminatore: Distruggi una terra non base bersaglio.\', \'type\': \'Creatura — Sciamano Elementale\', \'flavor\': \'"Terreno Poco Sicuro. Tornare Indietro" —Cartello vicino al precedente insediamento del Tumulo Pyrtagh\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173762&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'866eaf1c-a22c-47b2-a2c2-635ad9ccd6fb\', \'multiverseId\': 173762}, \'multiverseid\': 173762}, {\'name\': \'大爆発の魔道士\', \'text\': \'大爆発の魔道士を生け贄に捧げる：基本でない土地１つを対象とし、それを破壊する。\', \'type\': \'クリーチャー — エレメンタル・シャーマン\', \'flavor\': \'「この先の地危険――引き返せ」 ――かつてピルタグの石塚があった場所の近くの看板\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174063&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'37177e55-ae4d-4be7-9221-90aa5d852f1b\', \'multiverseId\': 174063}, \'multiverseid\': 174063}, {\'name\': \'Mago Fulminador\', \'text\': \'Sacrifique Mago Fulminador: Destrua o terreno alvo não-básico.\', \'type\': \'Criatura — Elemental Xamã\', \'flavor\': \'"Terreno Perigoso Adiante Volte" — Aviso nas proximidades da antiga localização de Pyrtagh Cairn\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172257&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'519de287-7bbc-49de-855e-14450dbd8efd\', \'multiverseId\': 172257}, \'multiverseid\': 172257}, {\'name\': \'Маг-Детонатор\', \'text\': \'Пожертвуйте Мага-Детонатора: уничтожьте целевую небазовую землю.\', \'type\': \'Существо — Элементаль Шаман\', \'flavor\': \'«Опасная территория поверните назад» — Дорожный указатель рядом с бывшим Пиртагским курганом\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172558&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'668f07aa-ca24-4eba-b7ad-630edbe0db22\', \'multiverseId\': 172558}, \'multiverseid\': 172558}, {\'name\': \'雷鸣法师\', \'text\': \'牺牲雷鸣法师：消灭目标非基本地。\', \'type\': \'生物～元素／祭师\', \'flavor\': \'「前方乃危险地带～请折返」 ～派塔石冢旧址附近的警示\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173160&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cde0b7f9-bbc5-44d9-841d-7174b9789dac\', \'multiverseId\': 173160}, \'multiverseid\': 173160}]', '[{\'name\': \'Widerspiegelnder Teich\', \'text\': \'{T}: Erhöhe deinen Manavorrat um ein Mana eines Typs, das ein Land, das du kontrollierst, produzieren könnte.\', \'type\': \'Land\', \'flavor\': \'Reflektiert er die Zukunft von früher oder die Vergangenheit von bald?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174755&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2695afbd-b2c3-4a2f-a242-733c093ca162\', \'multiverseId\': 174755}, \'multiverseid\': 174755}, {\'name\': \'Estanque reflectante\', \'text\': \'{T}: Agrega a tu reserva de maná un maná de cualquier tipo que pudiera producir una tierra que controles.\', \'type\': \'Tierra\', \'flavor\': \'¿Acaso refleja el futuro que alguna vez fue o el pasado que nunca será?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172949&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e5ade1b5-c786-45d1-be2d-8ad440873505\', \'multiverseId\': 172949}, \'multiverseid\': 172949}, {\'name\': \'Bassin réfléchissant\', \'text\': "{T} : Ajoutez à votre réserve un mana de n\'importe quel type qu\'un terrain que vous contrôlez pourrait produire.", \'type\': \'Terrain\', \'flavor\': "Reflète-t-il l\'avenir qui était ou le passé qui ne sera jamais ?", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173551&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'17cc0dee-b34a-4f97-8f01-69d6bfd6cec3\', \'multiverseId\': 173551}, \'multiverseid\': 173551}, {\'name\': \'Pozza Riflettente\', \'text\': \'{T}: Aggiungi alla tua riserva di mana un mana di un qualsiasi tipo che una terra che controlli potrebbe produrre.\', \'type\': \'Terra\', \'flavor\': \'Riflette forse il futuro che era un tempo o il passato che non sarà mai?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173852&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4ed20c1e-49f0-46a2-8993-54b00dcffb0f\', \'multiverseId\': 173852}, \'multiverseid\': 173852}, {\'name\': \'反射池\', \'text\': \'{T}：あなたのマナ・プールに、あなたがコントロールする土地が生み出すことのできるタイプのマナ１点を加える。\', \'type\': \'土地\', \'flavor\': \'それが映すのは、かつて在りし未来か、在り得ざる過去か？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174153&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e46f236f-b095-4f4d-be23-1a680069f14a\', \'multiverseId\': 174153}, \'multiverseid\': 174153}, {\'name\': \'Lagoa Espelhada\', \'text\': \'{T}: Adicione à sua reserva de mana um mana de qualquer tipo que um terreno que você controla possa produzir.\', \'type\': \'Terreno\', \'flavor\': \'Será que ela reflete o futuro que um dia existiu ou o passado que nunca acontecerá?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172347&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2cad6715-d883-488a-9175-fe637130ed5e\', \'multiverseId\': 172347}, \'multiverseid\': 172347}, {\'name\': \'Отражающее Озерцо\', \'text\': \'{T}: добавьте в ваше хранилище маны одну ману любого типа, который могла бы произвести земля под вашим контролем.\', \'type\': \'Земля\', \'flavor\': \'Что же в нем отражается некогда существовавшее будущее или же невозможное прошлое?\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172648&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bb61d763-ee99-4180-b412-ab8c66f3e849\', \'multiverseId\': 172648}, \'multiverseid\': 172648}, {\'name\': \'映景明湖\', \'text\': \'{T}：加一点法术力到你的法术力池中，其类别为由你操控的地能产生之任一类别。\', \'type\': \'地\', \'flavor\': \'它会映照出曾经的未来，亦或不再的过往？\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173250&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'44ab8d60-8806-433c-9819-4db233104332\', \'multiverseId\': 173250}, \'multiverseid\': 173250}]', '[{\'name\': \'Wilder Schwung\', \'text\': \'Bestimme drei bleibende Karten deiner Wahl, die keine Verzauberungen sind. Bestimme eine davon zufällig und zerstöre sie.\', \'type\': \'Hexerei\', \'flavor\': \'Obwohl die Schamanin selten bekam, was sie wollte, war sie dennoch nie vom Ergebnis enttäuscht.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174585&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c4f0d8c4-c4e9-4b61-9ade-9e812ef533ee\', \'multiverseId\': 174585}, \'multiverseid\': 174585}, {\'name\': \'Golpe salvaje\', \'text\': \'Elige tres permanentes objetivo que no sean encantamientos. Destruye uno de ellos al azar.\', \'type\': \'Conjuro\', \'flavor\': \'Aunque el chamán pocas veces obtenía lo que quería, nunca estaba disconforme con el resultado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172779&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eea757c0-b047-4ab9-8eed-c2cd9433c70b\', \'multiverseId\': 172779}, \'multiverseid\': 172779}, {\'name\': \'Revers sauvage\', \'text\': "Choisissez trois permanents non-enchantement ciblés. Détruisez l\'un d\'eux au hasard.", \'type\': \'Rituel\', \'flavor\': "Si la shamane n\'obtenait jamais ce qu\'elle voulait, elle n\'était cependant jamais déçue du résultat.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173381&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'cbe32936-ea4a-4bba-88da-bd50825a753e\', \'multiverseId\': 173381}, \'multiverseid\': 173381}, {\'name\': \'Colpo Selvaggio\', \'text\': \'Scegli tre permanenti non incantesimo bersaglio. Distruggi uno di essi a caso.\', \'type\': \'Stregoneria\', \'flavor\': \'Nonostante la sciamana ottenesse raramente ciò che desiderava, non fu mai delusa dal risultato.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173682&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3287bfc2-1976-45da-9bcb-e4af4f2d0dba\', \'multiverseId\': 173682}, \'multiverseid\': 173682}, {\'name\': \'大振り\', \'text\': \'エンチャントでないパーマネント３つを対象とする。 それらのうち無作為に選んだ１つを破壊する。\', \'type\': \'ソーサリー\', \'flavor\': \'シャーマンが自らが望むものを手に入れることは稀だが、その結果に落胆することはない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173983&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e7b68a97-7b35-4aed-947d-89167e24a30a\', \'multiverseId\': 173983}, \'multiverseid\': 173983}, {\'name\': \'Varada Selvagem\', \'text\': \'Escolha três permanentes alvo que não sejam encantamentos. Destrua uma delas aleatoriamente.\', \'type\': \'Feitiço\', \'flavor\': \'Embora a xamã raramente obtivesse o que queria, nunca ficava decepcionada com o resultado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172177&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c6c540fd-0f9c-416d-b2f2-6254006e6ec7\', \'multiverseId\': 172177}, \'multiverseid\': 172177}, {\'name\': \'Бесшабашный Взмах\', \'text\': \'Выберите три целевые перманента, не являющиеся чарами. Уничтожьте один из них, выбранный случайно.\', \'type\': \'Волшебство\', \'flavor\': \'И хотя шаманка редко получала то, что хотела, она всегда оставалась довольна результатом.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172478&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4fc9f6c0-e66c-44ba-9b63-2cf9f09f7b6b\', \'multiverseId\': 172478}, \'multiverseid\': 172478}, {\'name\': \'猛力挥击\', \'text\': \'选择三个目标非结界的永久物。 随机消灭其中一个。\', \'type\': \'法术\', \'flavor\': \'虽然祭师很少能得到预定的成果，但结果却总不会让她失望。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173080&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'13346d8b-0529-4944-afce-2213940116fd\', \'multiverseId\': 173080}, \'multiverseid\': 173080}]', "[{'name': 'Wildschlächter-Elfen', 'text': 'Verdorren (Dies fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)', 'type': 'Kreatur — Elf, Krieger', 'flavor': 'Einige Elfen kämpften zu lange im tiefsten Schatten und rammten ihre Schwerter zu oft in verdorbenes Fleisch und vergiftetes Blut.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174610&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd3a81912-5b48-40ea-a43f-64ea582258ba', 'multiverseId': 174610}, 'multiverseid': 174610}, {'name': 'Elfos destructores salvajes', 'text': 'Debilitar. (Esta fuente hace daño a las criaturas en forma de contadores -1/-1.)', 'type': 'Criatura — Guerrero elfo', 'flavor': 'Algunos elfos lucharon demasiado en la oscuridad, con sus espadas clavadas en carne contaminada y sangre envenenada.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172804&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1b1a0b99-a714-4cc9-aad6-6f56f440ca00', 'multiverseId': 172804}, 'multiverseid': 172804}, {'name': 'Elfes tueurs sauvages', 'text': 'Flétrissure (Cette source inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)', 'type': 'Créature : elfe et guerrier', 'flavor': 'Certains elfes avaient combattu depuis trop longtemps dans les ténèbres, et leurs épées avaient trop souvent goûté à la chair corrompue et au sang empoisonné.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173406&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'd6b1f16f-ec4b-406d-9df2-83747643eae5', 'multiverseId': 173406}, 'multiverseid': 173406}, {'name': 'Assassini Selvaggi Elfici', 'text': 'Avvizzire (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)', 'type': 'Creatura — Guerriero Elfo', 'flavor': 'Alcuni elfi hanno combattuto troppo a lungo nelle profonde oscurità e troppo spesso le loro lame sono state immerse in carne corrotta e sangue avvelenato.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173707&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '0898b678-1f36-4976-8fdd-02e821a6b165', 'multiverseId': 173707}, 'multiverseid': 173707}, {'name': '野生薙ぎのエルフ', 'text': '萎縮 （これはクリーチャーに－１/－１カウンターの形でダメージを与える。）', 'type': 'クリーチャー — エルフ・戦士', 'flavor': 'エルフの中には、暗い影の中で長く戦いすぎたため、剣が穢れた肉や毒を帯びた血につかりすぎてしまった者もいる。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174008&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7d462220-3309-4368-942d-0585661aa15d', 'multiverseId': 174008}, 'multiverseid': 174008}, {'name': 'Elfos Matança-Selvagem', 'text': 'Murchar (Esta fonte causa dano a criaturas na forma de marcadores -1/-1.)', 'type': 'Criatura — Elfo Guerreiro', 'flavor': 'Alguns elfos combateram por tempo demais na profunda escuridão, tendo suas espadas enterradas freqüentemente em carnes contaminadas e em sangue envenenado.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172202&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '96cf50a9-d8f2-4f10-a13f-d52ecf726e57', 'multiverseId': 172202}, 'multiverseid': 172202}, {'name': 'Неистовые Эльфы', 'text': 'Увядание (Этот источник наносит повреждения существам в виде жетонов -1/-1.)', 'type': 'Существо — Эльф Воин', 'flavor': 'Некоторые эльфы слишком долго сражались в темноте, их мечи слишком часто вонзались в загнивающую плоть и обагрялись отравленной кровью.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172503&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '497bf9ae-ea89-4b9b-b131-606200f1125e', 'multiverseId': 172503}, 'multiverseid': 172503}, {'name': '伏蛮地精', 'text': '干枯 （此来源会以-1/-1指示物的方式对生物造成伤害。）', 'type': '生物～地精／战士', 'flavor': '在深沉黑暗中战斗太久的地精，剑锋滴下的经常是污毒血肉。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173105&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c1f33fd0-c319-47e4-b312-2780002665ab', 'multiverseId': 173105}, 'multiverseid': 173105}]", '[{\'name\': \'Woandersbuddel\', \'text\': \'Wenn die Woandersbuddel ins Spiel kommt, ziehe eine Karte.\\nOpfere die Woandersbuddel: Bestimme einen Standardlandtyp. Jedes Land, das du kontrollierst, wird bis zum Ende des Zuges zu diesem Typ.\', \'type\': \'Artefakt\', \'flavor\': \'Eines Nachts steckte Oona den Himmel in eine Flasche. In der nächsten Nacht sortierte sie die Sterne neu und ließ den Himmel wieder frei.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174727&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'ac097e34-2a5d-4ab1-bc42-9152fd15b4c7\', \'multiverseId\': 174727}, \'multiverseid\': 174727}, {\'name\': \'Frasco de otro lugar\', \'text\': \'Cuando el Frasco de otro lugar entre en juego, roba una carta.\\nSacrificar el Frasco de otro lugar: Elige un tipo de tierra básica. Cada tierra que controlas es de ese tipo hasta el final del turno.\', \'type\': \'Artefacto\', \'flavor\': \'Una noche Oona embotelló la noche. La noche siguiente alineó las estrellas y la liberó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172921&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1f8c514-ce6d-4b50-94de-8656f766255c\', \'multiverseId\': 172921}, \'multiverseid\': 172921}, {\'name\': "Fiole d\'ailleurs", \'text\': "Quand la Fiole d\'ailleurs arrive en jeu, piochez une carte.\\nSacrifiez la Fiole d\'ailleurs : Choisissez un type de terrain de base. Chaque terrain que vous contrôlez devient ce type jusqu\'à la fin du tour.", \'type\': \'Artefact\', \'flavor\': \'Une nuit, Oona mit le ciel en bouteille. La nuit suivante, elle aligna les étoiles et le libéra.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173523&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9facbc66-bb7a-4f18-8f41-551590d8b8da\', \'multiverseId\': 173523}, \'multiverseid\': 173523}, {\'name\': "Flacone dell\'Altrove", \'text\': "Quando il Flacone dell\'Altrove entra in gioco, pesca una carta.\\nSacrifica il Flacone dell\'Altrove: Scegli un tipo di terra base. Ogni terra che controlli diventa quel tipo di terra base fino alla fine del turno.", \'type\': \'Artefatto\', \'flavor\': \'Una notte Oona imbottigliò il cielo. La notte seguente riallineò le stelle e lo rilasciò.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173824&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'41ad7727-fc5e-47ff-a3e3-24084ad6666d\', \'multiverseId\': 173824}, \'multiverseid\': 173824}, {\'name\': \'他所のフラスコ\', \'text\': \'他所のフラスコが場に出たとき、カードを１枚引く。\\n他所のフラスコを生け贄に捧げる：基本土地タイプを１つ選ぶ。 あなたがコントロールする各土地は、ターン終了時までそのタイプになる。\', \'type\': \'アーティファクト\', \'flavor\': \'ある夜、ウーナは空を瓶に詰めた。 次の夜、彼女は星と手を結び空を解き放った。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174125&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e9eb246d-4d90-4b46-b1c6-04ec04e4810f\', \'multiverseId\': 174125}, \'multiverseid\': 174125}, {\'name\': \'Frasco de Outro Lugar\', \'text\': \'Quando Frasco de Outro Lugar entrar em jogo, compre um card.\\nSacrifique Frasco de Outro Lugar: Escolha um tipo de terreno básico. Cada terreno que você controla torna-se daquele tipo até o final do turno.\', \'type\': \'Artefato\', \'flavor\': \'Uma noite, Oona engarrafou o céu. Na noite seguinte ela alinhou as estrelas e o liberou.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172319&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bc4587c4-f91d-4eac-8536-e49ded74cfa7\', \'multiverseId\': 172319}, \'multiverseid\': 172319}, {\'name\': \'Бутыль из Далека\', \'text\': \'Когда Бутыль из Далека входит в игру, возьмите карту.\\nПожертвуйте Бутыль из Далека: выберите тип базовой земли. Каждая земля под вашим контролем становится тем типом до конца хода.\', \'type\': \'Артефакт\', \'flavor\': \'Однажды ночью Уна упрятала небо в бутыль. Следующей ночью она перестроила звезды и выпустила его обратно.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172620&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b0d729d8-e709-43d1-8e55-f3b710d77dcf\', \'multiverseId\': 172620}, \'multiverseid\': 172620}, {\'name\': \'彼方瓶\', \'text\': \'当彼方瓶进场时，抓一张牌。\\n牺牲彼方瓶：选择一种基本地类别。 由你操控的地均成为该类别直到回合结束。\', \'type\': \'神器\', \'flavor\': \'有一晚，欧娜将天空装进瓶中。 第二晚她调整过星星的排列后，便将之释放。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173222&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b77c82b1-e677-4cec-8eca-6f7afbea200d\', \'multiverseId\': 173222}, \'multiverseid\': 173222}]', '[{\'name\': \'Wundenspiegelung\', \'text\': \'Am Ende jedes Zuges verliert jeder Gegner Lebenspunkte in Höhe der Lebenspunkte, die er in diesem Zug bisher verloren hat. (Schaden verursacht den Verlust von Lebenspunkten.)\', \'type\': \'Verzauberung\', \'flavor\': \'Die Nachtesse, Illulias mörderischer Kult von Rußwesen, hat es sich zur Mission gemacht, jeden Schmerz zu intensivieren, den jemand im Schattenmoor erleidet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174558&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9af47a33-a935-4585-9a01-02f95d41c4f3\', \'multiverseId\': 174558}, \'multiverseid\': 174558}, {\'name\': \'Reflejo de la herida\', \'text\': \'Al final de cada turno, cada oponente pierde una cantidad de vida igual a las vidas que perdió este turno. (El daño causa pérdida de vida.)\', \'type\': \'Encantamiento\', \'flavor\': \'La misión del Fogón Nocturno, el culto de Illulia de cenicientos asesinos, es intensificar todo dolor sufrido en el Páramo Sombrío.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172752&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'7dc1d9af-3b75-4637-89f3-ea119b2d1246\', \'multiverseId\': 172752}, \'multiverseid\': 172752}, {\'name\': \'Réverbération de blessure\', \'text\': "À la fin de chaque tour, chaque adversaire perd un nombre de points de vie égal au nombre de points de vie qu\'il a perdu ce tour. (Les blessures provoquent la perte de points de vie.)", \'type\': \'Enchantement\', \'flavor\': "La mission des Noctâtres, les scoriacés meurtriers du culte d\'Illulia, est d\'intensifier la moindre souffrance ressentie sur Sombrelande.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173354&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'445a5b03-b82d-426d-98d4-fb6b675e3eff\', \'multiverseId\': 173354}, \'multiverseid\': 173354}, {\'name\': \'Riflesso di Ferita\', \'text\': \'Alla fine di ogni turno, ogni avversario perde punti vita pari ai punti vita che ha perso in questo turno. (Il danno causa la perdita di punti vita.)\', \'type\': \'Incantesimo\', \'flavor\': \'Lo scopo del Tetro Focolare, il culto di assassini cinerei di Illulia, è di intensificare ogni dolore sofferto nella Landa Tenebrosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173655&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'37b2e7a4-41d8-4fd2-8537-c9dd5cb9e26d\', \'multiverseId\': 173655}, \'multiverseid\': 173655}, {\'name\': \'傷の反射\', \'text\': \'各ターンの終了時に、各対戦相手はこのターンにそのプレイヤーが失ったライフの点数に等しい点数のライフを失う。 （ダメージによりライフは失われる。）\', \'type\': \'エンチャント\', \'flavor\': \'ナイトハースとは残忍な燃えがら達のイルリアへの崇拝であり、その使命はシャドウムーアに起こるあらゆる苦痛を増大させることだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173956&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ad9e2aa6-bdf9-47e6-8920-52a0c9fd3f09\', \'multiverseId\': 173956}, \'multiverseid\': 173956}, {\'name\': \'Reflexo de Ferida\', \'text\': \'No final de cada turno, cada oponente perde pontos de vida igual à quantidade que perdeu neste turno. (O dano causa perda de pontos de vida.)\', \'type\': \'Encantamento\', \'flavor\': \'A missão dos Larescuros, o culto de Illulia de cinzeríneos assassinos, é intensificar toda dor sofrida em Pântano Sombrio.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172150&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7035292e-846c-4223-97f3-592d6299c2ab\', \'multiverseId\': 172150}, \'multiverseid\': 172150}, {\'name\': \'Отражение Раны\', \'text\': \'В конце каждого хода каждый оппонент теряет столько жизней, сколько жизней он потерял в этом ходу. (Повреждения вызывают потерю жизней.)\', \'type\': \'Чары\', \'flavor\': \'Миссия темносветов созданного Иллулией культа золовиков-убийц состоит в том, чтобы усилить любую боль обитателей Шэдоумура.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172451&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8e3f888e-5d08-4a17-95f7-2edb1378228e\', \'multiverseId\': 172451}, \'multiverseid\': 172451}, {\'name\': \'伤痛映象\', \'text\': \'在每个回合结束时，每位对手各失去若干生命，其数量等同于他在本回合所失去的生命数量。 （伤害会导致失去生命。）\', \'type\': \'结界\', \'flavor\': \'伊璐里领导的烬身教派名为夜炉，其宗旨是让暗影荒原上的一切苦痛更加剧烈。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173053&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d698d45f-2dd6-437c-98c0-8412d16ee92d\', \'multiverseId\': 173053}, \'multiverseid\': 173053}]', '[{\'name\': \'Wurz, die Mutter aller Überfälle\', \'text\': \'Wenn Wurz, die Mutter aller Überfälle, ins Spiel kommt, bringe zwei 1/1 rote und grüne (Goblin, Krieger)-Kreaturenspielsteine ins Spiel.\\nAlle roten oder grünen Spontanzauber oder Hexereien, die du spielst, haben Verschwören. (Sowie du jenen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere den Zauberspruch; du kannst für die Kopie neue Ziele bestimmen.)\', \'type\': \'Legendäre Kreatur — Goblin, Schamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174700&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2e02700a-9156-46db-be56-c20bb0b6be66\', \'multiverseId\': 174700}, \'multiverseid\': 174700}, {\'name\': \'Mosto, madre incursora\', \'text\': \'Cuando Mosto, madre incursora entre en juego, pon en juego dos fichas de criatura Guerrero Trasgo rojas y verdes 1/1.\\nCada hechizo de instantáneo o conjuro rojo o verde que juegues tiene la habilidad de conspirar. (En cuanto juegues el hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo y puedes elegir nuevos objetivos para la copia.)\', \'type\': \'Criatura legendaria — Chamán trasgo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172894&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'e19ccfa4-d773-4ec9-bfa8-ca979e200b5d\', \'multiverseId\': 172894}, \'multiverseid\': 172894}, {\'name\': \'Moût, la Mère-pilleuse\', \'text\': "Quand Moût, la Mère-pilleuse arrive en jeu, mettez en jeu deux jetons de créature 1/1 rouge et verte Gobelin et Guerrier.\\nChaque sort d\'éphémère ou de rituel rouge ou vert que vous jouez a la conspiration. (Au moment où vous jouez le sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le et vous pouvez choisir des nouvelles cibles pour la copie.)", \'type\': \'Créature légendaire : gobelin et shamane\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173496&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'472330d6-f0ea-46c9-ad93-f86f4f1c5af2\', \'multiverseId\': 173496}, \'multiverseid\': 173496}, {\'name\': \'Larva, la Madre Razziatrice\', \'text\': \'Quando Larva, la Madre Razziatrice entra in gioco, metti in gioco due pedine creatura Guerriero Goblin 1/1 rosse e verdi.\\nOgni magia istantaneo o stregoneria verde o rossa che giochi ha cospirare. (Mentre giochi la magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia. Puoi scegliere dei nuovi bersagli per la copia.)\', \'type\': \'Creatura Leggendaria — Sciamano Goblin\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173797&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1bfc1c81-c1f6-4681-ad59-cd8ba428b090\', \'multiverseId\': 173797}, \'multiverseid\': 173797}, {\'name\': \'略奪の母、汁婆\', \'text\': \'略奪の母、汁婆が場に出たとき、赤であり緑である１/１のゴブリン・戦士・クリーチャー・トークンを２体場に出す。\\nあなたがプレイする赤か緑である各インスタント呪文や各ソーサリー呪文は共謀を持つ。 （その呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、その呪文をコピーする。あなたはそのコピーの新たな対象を選んでもよい。）\', \'type\': \'伝説のクリーチャー — ゴブリン・シャーマン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174098&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e92e3dd0-9aef-40bf-b229-230c44af97ff\', \'multiverseId\': 174098}, \'multiverseid\': 174098}, {\'name\': \'Mosto, a Mãe-de-Ataque\', \'text\': \'Quando Mosto, a Mãe-de-Ataque, entrar em jogo, coloque em jogo duas fichas de criatura vermelha e verde 1/1 do tipo Goblin Guerreiro.\\nCada mágica instantânea ou de feitiço vermelha ou verde que você joga tem conspirar. (Conforme você joga a mágica, você pode virar duas criaturas desviradas que você controla que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela e você poderá escolher novos alvos para a cópia.)\', \'type\': \'Criatura Lendária — Goblin Xamã\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172292&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'362e9bda-2f26-4b17-8924-5699cbfedd96\', \'multiverseId\': 172292}, \'multiverseid\': 172292}, {\'name\': \'Бражка, Мамаша Налетчиков\', \'text\': \'Когда Бражка, Мамаша Налетчиков входит в игру, положите в игру две фишки существа 1/1 красный и зеленый Гоблин Воин.\\nКаждое разыгрываемое вами красное или зеленое мгновенное заклинание или заклинание волшебства имеет Заговор. (При разыгрывании такого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его, и вы можете выбрать новые цели для этой копии.)\', \'type\': \'Легендарное Существо — Гоблин Шаман\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172593&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bd01df6c-1f03-4770-bf68-d7be86694dde\', \'multiverseId\': 172593}, \'multiverseid\': 172593}, {\'name\': \'掠夺大妈麦汁\', \'text\': \'当掠夺大妈麦汁进场时，将两个1/1，红绿双色的精灵／战士衍生物放置进场。\\n你使用的每个红色或绿色的瞬间或法术咒语都具有协力异能。 （于你使用该咒语时，你可以横置两个由你操控、且与该咒语有共通颜色的未横置生物。 当你如此作，则复制该咒语，且你可以为该复制品选择新的目标。）\', \'type\': \'传奇生物～精灵／祭师\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173195&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f49ce70f-f20b-4dad-abdc-5e498ba0359e\', \'multiverseId\': 173195}, \'multiverseid\': 173195}]', '[{\'name\': \'Wutspiegelung\', \'text\': \'Alle Kreaturen, die du kontrollierst, haben Doppelschlag.\', \'type\': \'Verzauberung\', \'flavor\': \'Doppelte Rache hält länger.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174581&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83313620-29c4-400b-aefd-bb51a6e23921\', \'multiverseId\': 174581}, \'multiverseid\': 174581}, {\'name\': \'Reflejo de furia\', \'text\': \'Las criaturas que controlas tienen la habilidad de dañar dos veces.\', \'type\': \'Encantamiento\', \'flavor\': \'La venganza es un plato que se sirve mejor dos veces.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172775&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bbe3b9fc-f4fb-437b-9833-da624d3a6161\', \'multiverseId\': 172775}, \'multiverseid\': 172775}, {\'name\': \'Réverbération de rage\', \'text\': \'Les créatures que vous contrôlez ont la double initiative.\', \'type\': \'Enchantement\', \'flavor\': \'La vengeance est un plat qui se mange deux fois.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173377&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ab537d9c-9ed6-447f-94fb-dc2dfd46437a\', \'multiverseId\': 173377}, \'multiverseid\': 173377}, {\'name\': "Riflesso d\'Ira", \'text\': \'Le creature che controlli hanno doppio attacco.\', \'type\': \'Incantesimo\', \'flavor\': \'La vendetta è un piatto che è meglio assaporare due volte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173678&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fe80fa30-3380-43a5-9030-f109acaaf399\', \'multiverseId\': 173678}, \'multiverseid\': 173678}, {\'name\': \'怒りの反射\', \'text\': \'あなたがコントロールするクリーチャーは二段攻撃を持つ。\', \'type\': \'エンチャント\', \'flavor\': \'復讐は二度目が美味くなる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173979&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9caabc50-65b6-4f7b-8e97-144e9c352c92\', \'multiverseId\': 173979}, \'multiverseid\': 173979}, {\'name\': \'Reflexo de Cólera\', \'text\': \'As criaturas que você controla têm golpe duplo.\', \'type\': \'Encantamento\', \'flavor\': \'A vingança é um prato que se serve duas vezes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172173&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'943a88e2-1307-4d14-8a68-ab5d1cb4399f\', \'multiverseId\': 172173}, \'multiverseid\': 172173}, {\'name\': \'Отражение Ярости\', \'text\': \'Существа под вашим контролем имеют Двойной удар.\', \'type\': \'Чары\', \'flavor\': \'Отмщение это блюдо, которое лучше подавать дважды.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172474&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'0f0850cd-ded8-4b43-a0ad-5146bc38ef67\', \'multiverseId\': 172474}, \'multiverseid\': 172474}, {\'name\': \'愤怒映象\', \'text\': \'由你操控的生物具有连击异能。\', \'type\': \'结界\', \'flavor\': \'复仇这道菜最适合上两次。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173076&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'fa626312-7e35-49fe-9d42-38390f317552\', \'multiverseId\': 173076}, \'multiverseid\': 173076}]', '[{\'name\': \'Zaubersauger\', \'text\': \'Neutralisiere einen Zauberspruch deiner Wahl, falls dessen Beherrscher nicht für jede blaue bleibende Karte, die du kontrollierst, {1} bezahlt.\', \'type\': \'Spontanzauber\', \'flavor\': \'Warrik Brutalhexer fühlte sich von seiner Aura hintergangen, die sich lieber in den Tiefen des Wanderessigflusses herumtrieb als um ihn selbst herum.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174529&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'39068b70-9d5b-451a-a6a4-af5699c769aa\', \'multiverseId\': 174529}, \'multiverseid\': 174529}, {\'name\': \'Extraer el hechizo\', \'text\': \'Contrarresta el hechizo objetivo a menos que su controlador pague {1} por cada permanente azul que controles.\', \'type\': \'Instantáneo\', \'flavor\': \'Warrik Brutehexer se sintió traicionado cuando su aura prefirió la profundidad del Río Lágrimaerrante en vez de su lugar correcto, alrededor suyo.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172723&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'da94a9d6-01a6-45f5-aa17-f88ca4862acb\', \'multiverseId\': 172723}, \'multiverseid\': 172723}, {\'name\': \'Siphonner les sorts\', \'text\': \'Contrecarrez le sort ciblé à moins que son contrôleur ne paie {1} pour chaque permanent bleu que vous contrôlez.\', \'type\': \'Éphémère\', \'flavor\': "Warrik Brutecharme se sentit trahi par son aura quand elle cessa de l\'envelopper, lui préférant les profondeurs de la rivière de Bruinerrance.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173325&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'502ed388-7d62-403e-9d02-e9fc45d8b357\', \'multiverseId\': 173325}, \'multiverseid\': 173325}, {\'name\': \'Sifone di Magie\', \'text\': \'Neutralizza una magia bersaglio a meno che il suo controllore non paghi {1} per ogni permanente blu che controlli.\', \'type\': \'Istantaneo\', \'flavor\': \'Warrik Brutehexer si sentì tradito dalla sua aura sospesa attorno a lui, poiché preferiva le profondità del Fiume Brina Errante invece del suo posto originale.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173626&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'53f48fd2-930c-4839-832e-9941748ef5e1\', \'multiverseId\': 173626}, \'multiverseid\': 173626}, {\'name\': \'呪文の吸い上げ\', \'text\': \'呪文１つを対象とする。それのコントローラーが、あなたがコントロールする青のパーマネント１つにつき{1}を支払わないかぎり、それを打ち消す。\', \'type\': \'インスタント\', \'flavor\': \'乱暴術士のワリクは、彼の周りを守るはずの結界がワンダーブライン川の深みの味方についたとき、すっかり裏切られた気持ちになった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173927&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'707a909d-1f07-4d38-9d67-7819534bbdbd\', \'multiverseId\': 173927}, \'multiverseid\': 173927}, {\'name\': \'Sifão de Mágicas\', \'text\': \'Anule a mágica alvo, a menos que seu controlador pague {1} para cada permanente azul que você controla.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'Warrik Bruxobruto sentiu-se traído por sua aura ter preferido as profundezas do Rio Vinherrante ao seu lugar legítimo, pairando ao seu redor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172121&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'15caa6ab-0a2f-45d6-859f-fcf2374095e1\', \'multiverseId\': 172121}, \'multiverseid\': 172121}, {\'name\': \'Сифон Заклинаний\', \'text\': \'Отмените целевое заклинание, если контролирующий его игрок не заплатит {1} за каждый синий перманент под вашим контролем.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Уоррик Ворожей чувствовал себя преданным, оттого что его аура отдавала предпочтение глубинам реки Уондербрайн, а не своему законному месту вокруг него самого.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172422&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'9f08bde8-83c6-45b1-8abe-b68bf81b07c7\', \'multiverseId\': 172422}, \'multiverseid\': 172422}, {\'name\': \'吸咒\', \'text\': \'除非目标咒语的操控者为每个由你操控的蓝色永久物各支付{1}，否则反击之。\', \'type\': \'瞬间\', \'flavor\': \'暴邪咒渥李克感到一阵背叛感：他的灵气居然比较喜欢待在漫涩河底，而不愿乖乖地围绕在他身边。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173024&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9abd7d52-785c-49c2-9332-c4fc0fe41711\', \'multiverseId\': 173024}, \'multiverseid\': 173024}]', '[{\'name\': \'Zerbrechender Windstoß\', \'text\': \'Zerstöre alle Artefakte und Verzauberungen. Du erhältst 2 Lebenspunkte für jede auf diese Weise zerstörte bleibende Karte dazu.\', \'type\': \'Spontanzauber\', \'flavor\': \'Die elfischen Morgenheiler testen den Wert eines Gegenstands, bevor sie ihn mit in die Trutzburg nehmen. Wenn er keinen stärkeren Wind aushält, wird er zurückgelassen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174704&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7f07b8ba-ec96-475d-bf6b-d3928285df32\', \'multiverseId\': 174704}, \'multiverseid\': 174704}, {\'name\': \'Ráfaga fracturadora\', \'text\': \'Destruye todos los artefactos y encantamientos. Ganas 2 vidas por cada permanente destruido de esta manera.\', \'type\': \'Instantáneo\', \'flavor\': \'Los manoáurea élficos prueban el valor de una reliquia antes de llevarla a un refugio seguro. Si no puede soportar una pequeña brisa, se la abandona.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172898&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'aba03053-a95e-4f1e-b1c0-7133b37e877f\', \'multiverseId\': 172898}, \'multiverseid\': 172898}, {\'name\': \'Rafale fracturante\', \'text\': \'Détruisez tous les artefacts et tous les enchantements. Vous gagnez 2 points de vie pour chaque permanent détruit de cette manière.\', \'type\': \'Éphémère\', \'flavor\': "Les solarianeurs elfes testent la puissance d\'une relique avant de la rapporter à la ferté. Si elle ne peut pas résister à une rafale de vent, ils la laissent derrière eux.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173500&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'93b0f681-4468-484b-a010-1dc5d763d7e3\', \'multiverseId\': 173500}, \'multiverseid\': 173500}, {\'name\': \'Raffica Sbriciolante\', \'text\': \'Distruggi tutti gli artefatti e gli incantesimi. Guadagni 2 punti vita per ogni permanente distrutto in questo modo.\', \'type\': \'Istantaneo\', \'flavor\': \'Gli elfi guaritori testano il valore di una reliquia prima di accoglierla nel fortincanto. Se non è in grado di resistere a una severa ventata, viene abbandonata.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173801&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d77d5b6a-33a7-4c97-91cd-a05be678731b\', \'multiverseId\': 173801}, \'multiverseid\': 173801}, {\'name\': \'引き裂く突風\', \'text\': \'すべてのアーティファクトとすべてのエンチャントを破壊する。 これにより破壊されたパーマネント１つにつき、あなたは２点のライフを得る。\', \'type\': \'インスタント\', \'flavor\': \'エルフのアケノテブクロ使いは、遺物を安寧砦に集める前にその価値を試験する。 強い風に耐えることができなければ、それは置いていかれるのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174102&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'71c2d1ff-6e03-457b-9043-4a96a5e578e1\', \'multiverseId\': 174102}, \'multiverseid\': 174102}, {\'name\': \'Rajada Fragmentadora\', \'text\': \'Destrua todos os artefatos e encantamentos. Você ganha 2 pontos de vida para cada permanente destruída dessa maneira.\', \'type\': \'Mágica Instantânea\', \'flavor\': "Os mãos-d\'alba élficos testam a qualidade de uma relíquia antes de levá-la para o refúgio. Se ela não resistir a um vento forte, será deixada para traz.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172296&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'574b9310-9736-490d-9375-8de9c7e7deac\', \'multiverseId\': 172296}, \'multiverseid\': 172296}, {\'name\': \'Разрушительный Порыв\', \'text\': \'Уничтожьте все артефакты и чары. Вы получаете 2 жизни за каждый перманент, уничтоженный таким образом.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'Эльфийские знахари испытывают найденные реликвии на прочность, прежде чем забрать их в убежище. Если они не выдерживают сильного ветра, их оставляют на месте.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172597&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eaf049d3-db55-4422-b121-02c11e5838d2\', \'multiverseId\': 172597}, \'multiverseid\': 172597}, {\'name\': \'毁裂狂风\', \'text\': \'消灭所有神器与结界。 每以此法消灭一个永久物，你便获得2点生命。\', \'type\': \'瞬间\', \'flavor\': \'地精晨华师将遗物带回华域前，会先估计它是否值得保护。 如果连阵强风都经受不住，就不会加以考虑。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173199&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0e4529d5-15e9-440c-bcd2-70b2b9d0a927\', \'multiverseId\': 173199}, \'multiverseid\': 173199}]', "[{'name': 'Zersetzender Mentor', 'text': 'Schwarze Kreaturen, die du kontrollierst, haben Verdorren. (Sie fügen Kreaturen Schaden in Form von -1/-1-Marken zu.)', 'type': 'Kreatur — Elementarwesen, Räuber', 'flavor': 'Flackernde Rußwesen heizen ihre sterbenden Flammen an, indem sie anderen das Licht auspusten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174538&type=card', 'language': 'German', 'identifiers': {'scryfallId': '207b6d7f-9d48-42f7-b29a-6c72ebd0afd5', 'multiverseId': 174538}, 'multiverseid': 174538}, {'name': 'Mentor corrosivo', 'text': 'Las criaturas negras que controlas tienen la habilidad de debilitar. (Hacen daño a las criaturas en forma de contadores -1/-1.)', 'type': 'Criatura — Bribón elemental', 'flavor': 'Los cenicientos avivan sus llamas moribundas apagando la luz de otros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172732&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '597f7863-3d87-450b-8abd-d74525b11109', 'multiverseId': 172732}, 'multiverseid': 172732}, {'name': 'Mentor corrosif', 'text': 'Les créatures noires que vous contrôlez ont la flétrissure. (Elles infligent des blessures aux créatures sous la forme de marqueurs -1/-1.)', 'type': 'Créature : élémental et gredin', 'flavor': 'Les scoriacés vacillants raniment leurs flammes en étouffant la lumière des autres.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173334&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7cc5bce6-b7a7-41f1-a6e7-0a82c20a797e', 'multiverseId': 173334}, 'multiverseid': 173334}, {'name': 'Mentore Corrosivo', 'text': 'Le creature nere che controlli hanno avvizzire. (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)', 'type': 'Creatura — Farabutto Elementale', 'flavor': 'I cinerei baluginanti attizzano le loro fiamme morenti spegnendo quelle degli altri.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173635&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '6b68be2d-0d65-4132-9727-5a9066e1a028', 'multiverseId': 173635}, 'multiverseid': 173635}, {'name': '腐食する導師', 'text': 'あなたがコントロールする黒のクリーチャーは萎縮を持つ。 （それらはクリーチャーに－１/－１カウンターの形でダメージを与える。）', 'type': 'クリーチャー — エレメンタル・ならず者', 'flavor': '寄り集まった燃えがらは、他の者の光を消し去ることで死にかけた火を焚き付ける。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173936&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '756a8b89-04f4-4dd7-b56a-2a4b7fad3480', 'multiverseId': 173936}, 'multiverseid': 173936}, {'name': 'Mentor Corrosivo', 'text': 'As criaturas pretas que você controla têm murchar. (Elas causam dano a criaturas na forma de marcadores -1/-1.)', 'type': 'Criatura — Elemental Ladino', 'flavor': 'Os sórdidos cinzeríneos alimentam suas tênues chamas sorvendo a luz dos outros.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172130&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '40bdf95b-e43f-4eba-94b6-823728852dd8', 'multiverseId': 172130}, 'multiverseid': 172130}, {'name': 'Тлетворный Наставник', 'text': 'Черные существа под вашим контролем имеют Увядание. (Они наносят повреждения существам в виде жетонов -1/-1.)', 'type': 'Существо — Элементаль Бродяга', 'flavor': 'Оплывающие золовики разжигают свое умирающее пламя, задувая чужой огонь..', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172431&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '09577d57-de50-4dc3-b3b0-74cb949c012b', 'multiverseId': 172431}, 'multiverseid': 172431}, {'name': '蚀命明师', 'text': '由你操控的黑色生物具有干枯异能。 （它们会以-1/-1指示物的方式对生物造成伤害。）', 'type': '生物～元素／浪客', 'flavor': '为了扬起自己将熄的火焰，烬身得掐熄他人身上的光亮。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173033&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'ba0d54d3-108e-4286-925f-ae784acae737', 'multiverseId': 173033}, 'multiverseid': 173033}]", '[{\'name\': \'Zornschürender Riese\', \'text\': \'Wenn der Zornschürende Riese ins Spiel kommt, erhalten andere Kreaturen, die du kontrollierst, bis zum Ende des Zuges „{T}: Diese Kreatur fügt einer Kreatur oder einem Spieler deiner Wahl 2 Schadenspunkte zu".\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Riese, Krieger\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174570&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b7e713b1-d745-45ac-a1ca-a73590b5a69c\', \'multiverseId\': 174570}, \'multiverseid\': 174570}, {\'name\': \'Gigante avivafuria\', \'text\': \'Cuando el Gigante avivafuria entre en juego, las otras criaturas que controlas ganan "{T}: Esta criatura hace 2 puntos de daño a la criatura o jugador objetivo" hasta el final del turno.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Guerrero gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172764&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'18c410e8-150e-4fd9-a3cc-20d8553135fe\', \'multiverseId\': 172764}, \'multiverseid\': 172764}, {\'name\': \'Géant chauffefurie\', \'text\': "Quand le Géant chauffefurie arrive en jeu, les autres créatures que vous contrôlez acquièrent « {T} : cette créature inflige 2 blessures à une cible, créature ou joueur » jusqu\'à la fin du tour.\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : géant et guerrier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173366&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ba0cccba-c5cc-49ad-85a5-b838c5097cbc\', \'multiverseId\': 173366}, \'multiverseid\': 173366}, {\'name\': \'Gigante Attizzafuria\', \'text\': \'Quando il Gigante Attizzafuria entra in gioco, le altre creature che controlli hanno "{T}: Questa creatura infligge 2 danni a una creatura o a un giocatore bersaglio" fino alla fine del turno.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Guerriero Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173667&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a282f866-a56c-48e2-a22b-4c31ce50ae43\', \'multiverseId\': 173667}, \'multiverseid\': 173667}, {\'name\': \'憤怒焚きの巨人\', \'text\': \'憤怒焚きの巨人が場に出たとき、あなたがコントロールする他のクリーチャーはターン終了時まで「{T}：クリーチャー１体かプレイヤー１人を対象とする。このクリーチャーはそれに２点のダメージを与える。」を得る。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — 巨人・戦士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173968&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'107f4151-af6a-4b68-a580-56640b565a9e\', \'multiverseId\': 173968}, \'multiverseid\': 173968}, {\'name\': \'Gigante Atiça-Fúria\', \'text\': \'Quando Gigante Atiça-Fúria entra em jogo, as outras criaturas que você controla ganham "{T}: Esta criatura causa 2 pontos de dano à criatura ou ao jogador alvo" até o final do turno.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Gigante Guerreiro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172162&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d2c9c9ed-2443-4cfb-bdbf-aa034729248d\', \'multiverseId\': 172162}, \'multiverseid\': 172162}, {\'name\': \'Разъяренный Гигант\', \'text\': \'Когда Разъяренный Гигант входит в игру, другие существа под вашим контролем получают способность «{T}: это существо наносит 2 повреждения целевому существу или игроку» до конца хода.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Гигант Воин\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172463&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0a93795-357a-47a0-ba0c-7cebe355cdae\', \'multiverseId\': 172463}, \'multiverseid\': 172463}, {\'name\': \'怒炉巨人\', \'text\': \'当怒炉巨人进场时，由你操控的其他生物获得「{T}：此生物对目标生物或牌手造成2点伤害」直到回合结束。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～巨人／战士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173065&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a02f58e5-3dd4-4bf1-a624-659ec7949ed5\', \'multiverseId\': 173065}, \'multiverseid\': 173065}]', '[{\'name\': \'Zu Nebel werden\', \'text\': \'Entferne eine Kreatur deiner Wahl ganz aus dem Spiel. Bringe diese Karte am Ende des Zuges unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Hast du erwartet, dass ich ausweiche? Wie goldig." —Olka, Nebelwiesenhexe\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174632&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'67917312-b1a5-46f6-abcd-778cba48e36b\', \'multiverseId\': 174632}, \'multiverseid\': 174632}, {\'name\': \'Convertirse en niebla\', \'text\': \'Remueve del juego la criatura objetivo. Regresa esa carta al juego bajo el control de su propietario al final del turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"¿Creías que lo esquivaría? Qué bonito." —Olka, bruja de Pradera Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172826&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'527f9140-6c20-4c33-b856-62570eb65330\', \'multiverseId\': 172826}, \'multiverseid\': 172826}, {\'name\': \'Transformation en brume\', \'text\': \'Retirez la créature ciblée de la partie. Renvoyez cette carte en jeu sous le contrôle de son propriétaire à la fin du tour.\', \'type\': \'Éphémère\', \'flavor\': "« Vous pensiez que j\'allais esquiver ? Comme c\'est amusant. » —Olka, envoûteuse de Brumeprairie", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173428&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d14b0fd4-7ba7-4dd7-bf5b-721dc8bf71f7\', \'multiverseId\': 173428}, \'multiverseid\': 173428}, {\'name\': \'Tramutare in Nebbia\', \'text\': \'Rimuovi dal gioco una creatura bersaglio. Rimetti in gioco quella carta sotto il controllo del suo proprietario alla fine del turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Ti aspettavi che lo schivassi? Bizzarro." —Olka, strega della Prateria Brumosa\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173729&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'903b6f52-7924-408b-b61a-7a7226e09385\', \'multiverseId\': 173729}, \'multiverseid\': 173729}, {\'name\': \'霧への変化\', \'text\': \'クリーチャー１体を対象とし、それをゲームから取り除く。 ターン終了時に、そのカードをオーナーのコントロール下で場に戻す。\', \'type\': \'インスタント\', \'flavor\': \'「あたしがよけると思ったのかい？ 変わってるねぇ。」 ――ミストメドウの魔女、オルカ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174030&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'0a429215-6ae3-4f7b-81aa-880e3835c22e\', \'multiverseId\': 174030}, \'multiverseid\': 174030}, {\'name\': \'Transformar em Brumas\', \'text\': \'Remova do jogo a criatura alvo. Devolva aquele card ao jogo sob o controle de seu dono no final do turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Você esperava que eu me esquivasse? Que estranho." — Olka, bruxa de nevoplanície\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172224&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e34eb33b-114f-4a6b-9a56-6f1340533e97\', \'multiverseId\': 172224}, \'multiverseid\': 172224}, {\'name\': \'Превращение в Туман\', \'text\': \'Удалите целевое существо из игры. В конце хода верните ту карту в игру под контролем ее владельца.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Вы действительно подумали, что я просто увернусь? Как примитивно» — Олка, ведьма из Туманолужья\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172525&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'04a19284-9333-4ea1-b995-53654b78bc7e\', \'multiverseId\': 172525}, \'multiverseid\': 172525}, {\'name\': \'化作雾气\', \'text\': \'将目标生物移出对战。 在回合结束时，将该牌在其拥有者的操控下移回场上。\', \'type\': \'瞬间\', \'flavor\': \'「你以为我会躲开？ 真怪。」 ～雾牧地法术师欧卡\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173127&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'23747deb-7302-4645-845e-cec35adf7d69\', \'multiverseId\': 173127}, \'multiverseid\': 173127}]', '[{\'name\': \'Zwielichtshirtin\', \'text\': \'Fliegend, Wachsamkeit\\nWenn die Zwielichtshirtin ins Spiel kommt, bringe alle Karten aus deinem Friedhof auf deine Hand zurück, die in diesem Zug aus dem Spiel dorthin gelegt wurden.\\nBeharrlichkeit (Wenn diese Kreatur aus dem Spiel auf einen Friedhof gelegt wird und keine -1/-1-Marke auf ihr lag, bringe sie mit einer -1/-1-Marke unter der Kontrolle ihres Besitzers ins Spiel zurück.)\', \'type\': \'Kreatur — Engel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174502&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af0f26e3-9be5-404b-8b09-c963f485f4ae\', \'multiverseId\': 174502}, \'multiverseid\': 174502}, {\'name\': \'Pastora del crepúsculo\', \'text\': \'Vuela, vigilancia.\\nCuando la Pastora del crepúsculo entre en juego, regresa a tu mano todas las cartas en tu cementerio que hayan ido allí desde el juego este turno.\\nPersistir. (Cuando esta criatura vaya a un cementerio desde el juego, si no tenía contadores -1/-1 sobre ella, regrésala al juego bajo el control de su propietario con un contador -1/-1.)\', \'type\': \'Criatura — Ángel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172696&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'01d49071-cf4e-45e8-918a-fadde79bdfdb\', \'multiverseId\': 172696}, \'multiverseid\': 172696}, {\'name\': \'Bergère du crépuscule\', \'text\': "Vol, vigilance\\nQuand la Bergère du crépuscule arrive en jeu, renvoyez dans votre main toutes les cartes mises dans votre cimetière depuis le jeu ce tour-ci .\\nPersistance (Quand cette créature est mise dans un cimetière depuis le jeu, si elle n\'avait pas de marqueurs -1/-1 sur elle, renvoyez-la en jeu sous le contrôle de son propriétaire avec un marqueur -1/-1 sur elle.)", \'type\': \'Créature : ange\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173298&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a3054986-ee76-4200-934d-18090fbcd7b0\', \'multiverseId\': 173298}, \'multiverseid\': 173298}, {\'name\': \'Pastorella del Crepuscolo\', \'text\': \'Volare, cautela\\nQuando la Pastorella del Crepuscolo entra in gioco, riprendi in mano tutte le carte che sono state messe nel tuo cimitero dal gioco in questo turno.\\nPersistere (Quando questa creatura viene messa in un cimitero dal gioco, se non aveva segnalini -1/-1, rimettila in gioco sotto il controllo del suo proprietario con un segnalino -1/-1.)\', \'type\': \'Creatura — Angelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173599&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ee93f368-6be7-4e70-bfe3-1b5778a4db1f\', \'multiverseId\': 173599}, \'multiverseid\': 173599}, {\'name\': \'黄昏の番人\', \'text\': \'飛行、警戒\\n黄昏の番人が場に出たとき、このターンに場からあなたの墓地に置かれたすべてのカードをあなたの手札に戻す。\\n頑強 （このクリーチャーが場からいずれかの墓地に置かれたとき、それの上に－１/－１カウンターが置かれていなかった場合、それを－１/－１カウンターが１個置かれた状態でオーナーのコントロール下で場に戻す。）\', \'type\': \'クリーチャー — 天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173900&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d486b133-f1ab-428b-8e3b-3b34935f1f55\', \'multiverseId\': 173900}, \'multiverseid\': 173900}, {\'name\': \'Pastora do Crepúsculo\', \'text\': \'Voar, vigilância\\nQuando Pastora do Crepúsculo entrar em jogo, devolva para a sua mão todos os cards no seu cemitério que foram colocados lá vindos do jogo neste turno.\\nPersistir (Quando esta criatura for colocada num cemitério vinda do jogo, se ela não tiver nenhum marcador -1/-1, devolva-a para o jogo sob o controle de seu dono com um marcador -1/-1.)\', \'type\': \'Criatura — Anjo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172094&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1050c869-38b8-4055-ba17-e0cb3841ae51\', \'multiverseId\': 172094}, \'multiverseid\': 172094}, {\'name\': \'Сумеречный Пастырь\', \'text\': \'Полет, Бдительность\\nКогда Сумеречный Пастырь входит в игру, верните в вашу руку все карты из вашего кладбища, которые попали туда из игры в этом ходу.\\nУпорство (Когда это существо попадает из игры на кладбище, если на нем не было жетонов -1/-1, верните его в игру под контролем его владельца с одним жетоном -1/-1 на нем.)\', \'type\': \'Существо — Ангел\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172395&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'93cfb659-7e84-4ada-9a83-f6cbf15445bd\', \'multiverseId\': 172395}, \'multiverseid\': 172395}, {\'name\': \'微光牧者\', \'text\': \'飞行，警戒\\n当微光牧者进场时，将你坟墓场中于本回合从场上进入该处的所有牌移回你的手上。\\n留存 （当此生物从场上置入坟墓场时，若其上没有-1/-1指示物，则将它在其拥有者的操控下返回场上，且其上有一个-1/-1指示物。）\', \'type\': \'生物～天使\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172997&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c12512f1-0361-4c60-8772-a6b341c87afb\', \'multiverseId\': 172997}, \'multiverseid\': 172997}]', '[{\'name\': \'Äthersog\', \'text\': \'Lege eine angreifende oder blockende Kreatur deiner Wahl oben auf die Bibliothek ihres Besitzers.\\nVerschwören (Sowie du diesen Zauberspruch spielst, kannst du zwei ungetappte Kreaturen tappen, die du kontrollierst und die mindestens eine Farbe mit dem Zauberspruch gemeinsam haben. Wenn du das tust, kopiere den Zauberspruch; du kannst für die Kopie ein neues Ziel bestimmen.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174613&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9567d643-6799-4305-ac39-aa4d552a218f\', \'multiverseId\': 174613}, \'multiverseid\': 174613}, {\'name\': \'Marea del éter\', \'text\': \'Pon la criatura atacante o bloqueadora objetivo en la parte superior de la biblioteca de su propietario.\\nConspirar. (En cuanto juegues este hechizo puedes girar dos criaturas enderezadas que controles que compartan un color con él. Cuando lo hagas, cópialo y puedes elegir un nuevo objetivo para la copia.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172807&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'adc10e83-6d67-43d8-b2a8-962372421aef\', \'multiverseId\': 172807}, \'multiverseid\': 172807}, {\'name\': \'Aethercourant\', \'text\': \'Mettez la créature attaquante ou bloqueuse ciblée au-dessus de la bibliothèque de son propriétaire.\\nConspiration (Au moment où vous jouez ce sort, vous pouvez engager deux créatures dégagées que vous contrôlez qui partagent une couleur avec lui. Quand vous faites ainsi, copiez-le et vous pouvez choisir une nouvelle cible pour la copie.)\', \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173409&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bd09ae83-ce6b-4fb7-9c19-d7d2bc8a91bd\', \'multiverseId\': 173409}, \'multiverseid\': 173409}, {\'name\': "Risacca d\'Etere", \'text\': \'Metti una creatura attaccante o bloccante bersaglio in cima al grimorio del suo proprietario.\\nCospirare (Mentre giochi questa magia, puoi TAPpare due creature STAPpate che controlli che condividono un colore con essa. Quando lo fai, copia la magia. Puoi scegliere un nuovo bersaglio per la copia.)\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173710&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'511ca919-47e5-44a7-9531-275c31b1e8d2\', \'multiverseId\': 173710}, \'multiverseid\': 173710}, {\'name\': \'引き霊気\', \'text\': \'攻撃かブロックしているクリーチャー１体を対象とし、それをオーナーのライブラリーの一番上に置く。\\n共謀 （この呪文をプレイするに際し、あなたはあなたがコントロールするこの呪文と共通の色を持つアンタップ状態のクリーチャー２体をタップしてもよい。 そうした場合、この呪文をコピーする。あなたはそのコピーの新たな対象を選んでもよい。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174011&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'c3c0d70a-1d67-4fac-8253-59fe77ed6271\', \'multiverseId\': 174011}, \'multiverseid\': 174011}, {\'name\': \'Ressaca Etérea\', \'text\': \'Coloque a criatura alvo atacante ou bloqueadora no topo do grimório de seu dono.\\nConspirar (Conforme você joga essa mágica, você pode virar duas criaturas desviradas que você controla e que compartilhem uma cor com ela. Quando fizer isso, faça uma cópia dela e você poderá escolher um novo alvo para a cópia.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172205&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3eb18ff2-511d-4e30-a719-7346e194cc56\', \'multiverseId\': 172205}, \'multiverseid\': 172205}, {\'name\': \'Эфирное Противотечение\', \'text\': \'Положите целевое атакующее или блокирующее существо на верх библиотеки его владельца.\\nЗаговор (При разыгрывании этого заклинания вы можете повернуть два неповернутых существа под вашим контролем, у которых есть такой же цвет, как у него. Когда вы это делаете, скопируйте его, и вы можете выбрать новую цель для этой копии.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172506&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'30365c8b-f748-42e3-aa8d-9925bfd97e75\', \'multiverseId\': 172506}, \'multiverseid\': 172506}, {\'name\': \'乙太拖行\', \'text\': \'将目标进行攻击或阻挡的生物置于其拥有者的牌库顶。\\n协力 （于你使用此咒语时，你可以横置两个由你操控、且与此咒语有共通颜色的未横置生物。 当你如此作，则复制此咒语，且你可以为该复制品选择新的目标。）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173108&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'adc21cd8-bd36-42dd-9d09-970751ca8cc1\', \'multiverseId\': 173108}, \'multiverseid\': 173108}]', '[{\'name\': \'Überragen\', \'text\': \'({2/G} kann mit zwei beliebigen Mana oder mit {G} bezahlt werden. Die umgewandelten Manakosten dieser Karte betragen 6.)\\nBis zum Ende des Zuges erhält eine Kreatur deiner Wahl +4/+4, Verdorren sowie „Wenn diese Kreatur angreift, blockt eine Kreatur deiner Wahl sie in diesem Zug, falls möglich" und verursacht Trampelschaden. (Sie fügt Kreaturen Schaden in Form von -1/-1-Marken zu.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174608&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'621f783d-2095-44c2-a971-a11b3da4330d\', \'multiverseId\': 174608}, \'multiverseid\': 174608}, {\'name\': \'Torrear\', \'text\': \'({2/G} puede pagarse con dos maná cualesquiera o con {G}. El costo de maná convertido de esta carta es 6.)\\nHasta el final del turno la criatura objetivo obtiene +4/+4 y gana las habilidades de debilitar, arrollar y "cuando esta criatura ataque, la criatura objetivo la bloquea este turno si puede". (Hace daño a las criaturas en forma de contadores -1/-1.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172802&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00c05c89-86be-481b-8352-28b819f6a684\', \'multiverseId\': 172802}, \'multiverseid\': 172802}, {\'name\': \'Dominer de haut\', \'text\': "({2/G} peut être payé au choix avec n\'importe quelle combinaison de deux manas ou avec {G}. Le coût converti de mana de cette carte est 6.)\\nJusqu\'à la fin du tour, la créature ciblée gagne +4/+4 et acquiert le piétinement, la flétrissure et « Quand cette créature attaque, la créature ciblée la bloque ce tour si possible. » (Elle inflige des blessures aux créatures sous la forme de marqueurs -1/-1.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173404&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'30e20656-220a-4eda-a8aa-76749d6e2f24\', \'multiverseId\': 173404}, \'multiverseid\': 173404}, {\'name\': \'Torreggiare\', \'text\': \'({2/G} può essere pagato con due mana qualsiasi o con {G}. Il costo di mana convertito di questa carta è 6.)\\nFino alla fine del turno, una creatura bersaglio prende +4/+4 e ha travolgere, avvizzire e "Quando questa creatura attacca, una creatura bersaglio la blocca in questo turno, se può farlo." (Una fonte con avvizzire infligge danno sotto forma di segnalini -1/-1.)\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173705&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'05d0213a-6fd9-41e6-865e-48b1ef4aec2a\', \'multiverseId\': 173705}, \'multiverseid\': 173705}, {\'name\': \'見下し\', \'text\': \'（{2/G}は、任意の２マナか{G}で支払うことができる。 このカードの点数で見たマナ・コストは６である。）\\nクリーチャー１体を対象とする。それはターン終了時まで＋４/＋４の修整を受けるとともにトランプルと萎縮と「このクリーチャーが攻撃したとき、クリーチャー１体を対象とする。それは可能ならこれをブロックする。」を得る。 （それはクリーチャーに－１/－１カウンターの形でダメージを与える。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174006&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ce379c55-88b2-4408-b6ee-80e7f4ed4362\', \'multiverseId\': 174006}, \'multiverseid\': 174006}, {\'name\': \'Proteção Elevada\', \'text\': \'({2/G} pode ser pago com quaisquer dois manas ou com {G}. O custo de mana convertido desse card é 6.)\\nAté o final do turno, a criatura alvo recebe +4/+4 e ganha atropelar, murchar e "Quando esta criatura ataca, a criatura alvo bloqueia-a neste turno se estiver apta." (Ela causa dano a criaturas na forma de marcadores -1/-1.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172200&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'312c096f-9ec2-4bcb-b54e-70b419f6a004\', \'multiverseId\': 172200}, \'multiverseid\': 172200}, {\'name\': \'Возвышение\', \'text\': \'(За {2/G} можно заплатить две любые маны или {G}. Конвертированная мана-стоимость этой карты равна 6.)\\nДо конца хода целевое существо получает +4/+4, а также Пробивной удар, Увядание и способность «Когда это существо атакует, целевое существо блокирует его в этом ходу, если может». (Оно наносит повреждения существам в виде жетонов -1/-1.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172501&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'eaaeaf7c-85f8-4111-bf5f-ba6a23ec8615\', \'multiverseId\': 172501}, \'multiverseid\': 172501}, {\'name\': \'巍然屹立\', \'text\': \'（能用任意两点法术力或是{G}来支付{2/G}。 此牌的总法术力费用为6。）\\n直到回合结束，目标生物得+4/+4且获得践踏与干枯异能，以及「当此生物攻击时，目标生物本回合若能阻挡它，则须阻挡之。」 （它会以-1/-1指示物的方式对生物造成伤害。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173103&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'d5343258-38c0-42ae-8494-2092b5ffdd66\', \'multiverseId\': 173103}, \'multiverseid\': 173103}]', '[{\'name\': \'Überseele des Halbdunkels\', \'text\': \'Schutz vor Blau, vor Schwarz und vor Rot\', \'type\': \'Kreatur — Geist, Avatar\', \'flavor\': \'„Es wird gesagt, sie selbst hätte die Sonne versteckt, um sie vor dem bevorstehenden Erlöschen zu bewahren." —Die Parabeln der Seherin\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174711&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3cfb832a-7fa8-4fd1-b650-08cb02b98c06\', \'multiverseId\': 174711}, \'multiverseid\': 174711}, {\'name\': \'Alma suprema del crepúsculo\', \'text\': \'Protección contra azul, contra negro y contra rojo.\', \'type\': \'Criatura — Espíritu avatar\', \'flavor\': \'"Algunos dicen que ella escondió al mismo sol, en un acto desesperado para salvarlo de la extinción." —Las parábolas de la vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172905&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'026ded04-9af2-4eed-a299-aac9f740dfab\', \'multiverseId\': 172905}, \'multiverseid\': 172905}, {\'name\': \'Gouve du crépuscule\', \'text\': \'Protection contre le bleu, contre le noir et contre le rouge\', \'type\': \'Créature : esprit et avatar\', \'flavor\': "« Certains prétendent qu\'elle a caché le soleil, acte de désespoir pour le sauver de l\'extinction ultime. » —Les paraboles de l\'Oracle", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173507&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'691dab75-fa51-4268-96ba-0bb025056dac\', \'multiverseId\': 173507}, \'multiverseid\': 173507}, {\'name\': \'Anima Eccelsa del Crepuscolo\', \'text\': \'Protezione dal blu, dal nero e dal rosso.\', \'type\': \'Creatura — Spirito Avatar\', \'flavor\': \'"Alcuni dicono che abbia nascosto il sole lei stessa, un\\\'azione disperata per salvarlo dall\\\'estinzione." —Le Parabole della Veggente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173808&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1c934c7-f73d-433b-a7a8-7475ec0ee280\', \'multiverseId\': 173808}, \'multiverseid\': 173808}, {\'name\': \'薄暮の大霊\', \'text\': \'プロテクション（青）、プロテクション（黒）、プロテクション（赤）\', \'type\': \'クリーチャー — スピリット・アバター\', \'flavor\': \'「彼女が自ら太陽を隠したのは、それを究極の死滅から救うための一か八かの行動だったとも言われている。」 ――「予見者の寓話」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=174109&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'3502d8f6-cd32-4e3c-9314-fe15b3a61e81\', \'multiverseId\': 174109}, \'multiverseid\': 174109}, {\'name\': \'Alma Suprema do Ocaso\', \'text\': \'Proteção contra o azul, o preto e o vermelho.\', \'type\': \'Criatura — Espírito Avatar\', \'flavor\': \'"Alguns dizem que ela própria escondeu o sol, num ato desesperado de salvá-lo de sua inevitável extinção." — Parábolas da Vidente\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172303&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cb12dee4-dc43-4f82-8ba7-f4f6c634412d\', \'multiverseId\': 172303}, \'multiverseid\': 172303}, {\'name\': \'Сверхдуша Сумерек\', \'text\': \'Защита от синего, от черного и от красного\', \'type\': \'Существо — Дух Аватара\', \'flavor\': \'«Говорят, что она спрятала само солнце, отчаянно пытаясь спасти его от окончательного угасания». — Притчи провидицы\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=172604&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e58c97fe-9642-493f-ad6e-1a7d8c30a9d4\', \'multiverseId\': 172604}, \'multiverseid\': 172604}, {\'name\': \'暮色超灵\', \'text\': \'反蓝保护，反黑保护，反红保护\', \'type\': \'生物～精怪／圣者\', \'flavor\': \'「有人说是她在绝望之余将太阳藏起来，好让它免于终将面临的灭绝。」 ～《预言师寓言》\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=173206&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f01fb059-e03f-4080-ae44-06d4c55cdaba\', \'multiverseId\': 173206}, \'multiverseid\': 173206}]']
