=132412&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a0b0832f-baa8-4e66-8c02-381181895c65', 'multiverseId': 132412}, 'multiverseid': 132412}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133015&type=card', 'language': 'German', 'identifiers': {'scryfallId': '767fb444-d515-4b06-9986-024b60d91ce8', 'multiverseId': 133015}, 'multiverseid': 133015}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134520&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '4aad4030-1de7-400a-8084-015390bb38f0', 'multiverseId': 134520}, 'multiverseid': 134520}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132714&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'ee287cd0-fae7-4c3d-8a1b-ad5253011200', 'multiverseId': 132714}, 'multiverseid': 132714}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133316&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'f36187b3-88bc-4e8d-bf4a-cf89d28da690', 'multiverseId': 133316}, 'multiverseid': 133316}, {'name': '山', 'type': '基本土地 — 山', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133617&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7b0fe460-a450-4e6c-8b07-1756e7e1eded', 'multiverseId': 133617}, 'multiverseid': 133617}, {'name': 'Montanha', 'type': 'Terreno Básico — Montanha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133918&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'b7c4d450-eb1d-4f0f-a03c-6b0d0e8e4104', 'multiverseId': 133918}, 'multiverseid': 133918}, {'name': 'Гора', 'type': 'Базовая Земля — Гора', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134219&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '4c6dc47b-f478-4239-989d-dcc24388fdc4', 'multiverseId': 134219}, 'multiverseid': 134219}, {'name': '山脉', 'type': '基本地～山脉', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132413&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '6d260b98-5f5d-49fd-900e-7c2b54fe045b', 'multiverseId': 132413}, 'multiverseid': 132413}]", '[{\'name\': \'Gedankenpeitschenremasuri\', \'text\': \'Alle Remasuris haben „{1}, opfere diese Kreatur: Jeder Spieler wirft eine Karte aus seiner Hand ab."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'Obwohl den Remasuris aus Dominaria ohne ihre Königin das gemeinsame Ziel fehlte, bildete sich der Instinkt, sich selbst zu opfern, bei ihnen erstaunlicherweise nicht zurück.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133004&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0d6a480f-fcac-48bf-ba97-4f2e73e77c0f\', \'multiverseId\': 133004}, \'multiverseid\': 133004}, {\'name\': \'Fragmentado látigo mental\', \'text\': \'Todos los Fragmentados tienen "{1}, sacrificar esta criatura: Cada jugador descarta una carta".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'Aunque los fragmentados sin reina de Dominaria no tenían un único propósito, en algunos el instinto de autosacrificio seguía siendo muy fuerte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134509&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1b70fe71-c9a6-4111-a27f-a5683446e9b8\', \'multiverseId\': 134509}, \'multiverseid\': 134509}, {\'name\': \'Slivoïde flagellâme\', \'text\': "Tous les slivoïdes ont « {1}, sacrifiez cette créature : Chaque joueur se défausse d\'une carte. »", \'type\': \'Créature : slivoïde\', \'flavor\': "Bien que les slivoïdes sans reine de Dominaria n\'aient plus d\'objectif, l\'instinct de sacrifice reste chez eux toujours important.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132703&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'827c4889-b739-4084-b1d1-41c296ec7872\', \'multiverseId\': 132703}, \'multiverseid\': 132703}, {\'name\': \'Tramutante Sferzamente\', \'text\': \'Tutti i Tramutanti hanno "{1}, Sacrifica questa creatura: Ogni giocatore scarta una carta."\', \'type\': \'Creatura — Tramutante\', \'flavor\': "Sebbene i tramutanti senza regina di Dominaria siano privi di un unico scopo, in alcuni l\'istinto d\'abnegazione rimane decisamente forte.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133305&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4b7e9b10-3664-4e1a-95eb-b6b9c4deab1c\', \'multiverseId\': 133305}, \'multiverseid\': 133305}, {\'name\': \'心鞭スリヴァー\', \'text\': \'すべてのスリヴァーは「{1}, このクリーチャーを生け贄に捧げる：各プレイヤーはカードを１枚捨てる。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'ドミナリアの女王無きスリヴァーには定まった目的は無かったが、自己犠牲の本能だけは非常に強く残っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133606&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69078fe8-0940-4746-b26a-d8bb08630c7b\', \'multiverseId\': 133606}, \'multiverseid\': 133606}, {\'name\': \'Fractius Chicote Mental\', \'text\': \'Todos os Fractius têm "{1}, Sacrifique esta criatura: Cada jogador descarta um card."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'Embora falte um propósito aos fractius sem rainha de Dominária, em alguns o instinto de auto-sacrifício permanece extremamente forte.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133907&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fb8f2c59-fe7f-43f2-9176-f40cf11cdaf6\', \'multiverseId\': 133907}, \'multiverseid\': 133907}, {\'name\': \'Щепка Умолишения\', \'text\': \'Все Щепки обладают способностью "{1}, Пожертвуйте это существо: Каждый игрок сбрасывает карту."\', \'type\': \'Существо — Щепка\', \'flavor\': \'Потому Доминарийские щепки, потерявшие королеву, не имели единой цели существования, но у некоторых инстинкт к самопожертвованию оставался весьма сильным.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134208&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'2918f170-a698-4e7c-a724-4c6dc081c7ea\', \'multiverseId\': 134208}, \'multiverseid\': 134208}, {\'name\': \'鞭灵裂片妖\', \'text\': \'所有裂片妖具有「{1}，牺牲此生物：每位牌手弃一张牌。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'多明纳里亚的裂片妖没有女王，因此没有任何行动目标；因此某些品种的自我牺牲欲望依旧高涨。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132402&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9347197d-a2ca-45d6-9d49-dc6af0ee7a9c\', \'multiverseId\': 132402}, \'multiverseid\': 132402}]', '[{\'name\': \'Gefallenes Ideal\', \'text\': \'Kreaturenverzauberung\\nDie verzauberte Kreatur hat Flugfähigkeit und „Opfere eine Kreatur: Diese Kreatur erhält +2/+1 bis zum Ende des Zuges."\\nWenn das Gefallene Ideal auf einen Friedhof gelegt wird, bringe das Gefallene Ideal auf die Hand seines Besitzers zurück.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132926&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'7e2072a0-d5c0-40cd-8122-64e912c34ef3\', \'multiverseId\': 132926}, \'multiverseid\': 132926}, {\'name\': \'Ideal caído\', \'text\': \'Encantar criatura.\\nLa criatura encantada tiene la habilidad de volar y "Sacrificar una criatura: Esta criatura obtiene +2/+1 hasta el final del turno".\\nCuando el Ideal caído vaya a un cementerio desde el juego, regresa el Ideal caído a la mano de su propietario.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134431&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'bd26c20f-c075-4537-a5b1-d4be58adf168\', \'multiverseId\': 134431}, \'multiverseid\': 134431}, {\'name\': \'Idéal déchu\', \'text\': "Enchanter : créature\\nLa créature enchantée a le vol et « Sacrifiez une créature : Cette créature gagne +2/+1 jusqu\'à la fin du tour. »\\nQuand l\'Idéal déchu est mis dans un cimetière depuis le jeu, renvoyez l\'Idéal déchu dans la main de son propriétaire.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132625&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'a6273482-363c-4f22-b8e3-6938f03a28d7\', \'multiverseId\': 132625}, \'multiverseid\': 132625}, {\'name\': \'Ideale Fallito\', \'text\': \'Incanta creatura\\nLa creatura incantata ha volare e "Sacrifica una creatura: Questa creatura prende +2/+1 fino alla fine del turno."\\nQuando l\\\'Ideale Fallito viene messo in un cimitero dal gioco, fai tornare l\\\'Ideale Fallito in mano al suo proprietario.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133227&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a56098cc-6d39-46f1-8aed-42c6ae317a2a\', \'multiverseId\': 133227}, \'multiverseid\': 133227}, {\'name\': \'堕ちたる理想\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは飛行と「クリーチャーを１体生け贄に捧げる：このクリーチャーはターン終了時まで＋２/＋１の修整を受ける。」の能力を持つ。\\n堕ちたる理想が場からいずれかの墓地に置かれたとき、堕ちたる理想をオーナーの手札に戻す。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133528&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'be0ed597-dcd8-44d2-a546-94f80a82f118\', \'multiverseId\': 133528}, \'multiverseid\': 133528}, {\'name\': \'Ideal Caído\', \'text\': \'Encantar Criatura\\nA criatura encantada tem voar e "Sacrifique uma criatura: Esta criatura recebe +2/+1 até o final do turno."\\nQuando Ideal Caído for colocado no cemitério vindo do jogo, devolva-o para a mão de seu dono.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133829&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3b34a196-52bf-4c99-8020-94dacd0ba6ea\', \'multiverseId\': 133829}, \'multiverseid\': 133829}, {\'name\': \'Павший Идеал\', \'text\': \'Зачаровать существо\\nЗачарованное существо имеет полет и "Пожертвуйте существо: Это существо получает +2/+1 до конца хода."\\nКогда Павший Идеал попадает на кладбище из игры, верните Павший Идеал в руку его владельца.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134130&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5e68dd46-7e75-4c96-b103-45e19f316ac9\', \'multiverseId\': 134130}, \'multiverseid\': 134130}, {\'name\': \'堕落理念\', \'text\': \'生物结界\\n受此结界的生物具有飞行异能，且具有「牺牲一个生物：此生物得+2/+1直到回合结束。」\\n当堕落理念从场上置入坟墓场时，将堕落理念移回其拥有者手上。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132324&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'a1a2a0e0-004d-4e82-bee2-0487d904093c\', \'multiverseId\': 132324}, \'multiverseid\': 132324}]', '[{\'name\': \'Geisterflammenremasuri\', \'text\': \'Alle Remasuris sind farblos.\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Diese Rasse befindet sich am Scheitelpunkt ihrer Entwicklung. Sie entledigt sich gerade aller Bindungen zu einer Königin, deren Anweisungen sie nicht länger vernimmt. Sie suchen einen neuen Anführer. Vielleicht kann ich ihnen einen geben." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132953&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'75dc666d-2262-46d0-933d-d124b91fcaaa\', \'multiverseId\': 132953}, \'multiverseid\': 132953}, {\'name\': \'Fragmentado llama fantasmal\', \'text\': \'Todos los Fragmentados son incoloros.\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Esta raza es la cúspide de la evolución. Está borrando impacientemente lo que los conectaba a una reina que ya no escucha su llamado. Busca un nuevo amo. Tal vez yo pueda darle uno." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134458&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'226cb388-9d7e-4158-b602-30f76bfda324\', \'multiverseId\': 134458}, \'multiverseid\': 134458}, {\'name\': \'Slivoïde ectoflamme\', \'text\': \'Tous les slivoïdes sont incolores.\', \'type\': \'Créature : slivoïde\', \'flavor\': "« Cette espèce est à la cupside de l\'évolution. Elle brûle les marqueurs génétiques qui la relient à une reine qui ne répond plus à son appel. Elle cherche un nouveau maître. Peut-être puis-je lui en fournir un. » —Freyalise", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132652&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'47bc1c6e-ac5c-47d1-9a2e-837a276d88d8\', \'multiverseId\': 132652}, \'multiverseid\': 132652}, {\'name\': \'Tramutante Fiamma Spettrale\', \'text\': \'Tutti i Tramutanti sono incolori.\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Questa specie è all\\\'apice dell\\\'evoluzione. Brucia i segni che la collegano a una regina di cui non ascolta più il richiamo. Cerca una nuova padrona. Magari potrei procurargliene una." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133254&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'812311f2-844e-4ffa-bd27-f1427071f112\', \'multiverseId\': 133254}, \'multiverseid\': 133254}, {\'name\': \'霊炎スリヴァー\', \'text\': \'すべてのスリヴァーは無色である。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'この種は進化の先端にいます。 それは女王との繋がりを焼き、その声に従わないようになっています。 新しい主を探しているのです。 私が見つけてあげましょう。 ――フレイアリーズ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133555&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9f721c61-b50a-4c70-920d-b6c8d4c8e519\', \'multiverseId\': 133555}, \'multiverseid\': 133555}, {\'name\': \'Fractius da Chama Fantasmal\', \'text\': \'Todos os Fractius são incolores.\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Esta raça está no auge da evolução. Ela queima os sinais que a conectam a uma rainha que não atende mais a seus chamados. Ela procura um novo mestre. Talvez eu possa lhe dar um." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133856&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cecc989e-9ed7-47b1-b962-c5610517bbdb\', \'multiverseId\': 133856}, \'multiverseid\': 133856}, {\'name\': \'Щепка Призрачного Огня\', \'text\': \'Все Щепки бесцветные.\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Этот выводок появился на переломе эволюции. Он изничтожил все отметины, соединяющие его с королевой, которая более не заслуживает его внимания. Он ищет нового хозяина. Возможно, я помогу ему в этом», Фреялиз\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134157&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b2afa8c7-40cd-47b2-9a51-ebea67b3704a\', \'multiverseId\': 134157}, \'multiverseid\': 134157}, {\'name\': \'灵焰裂片妖\', \'text\': \'所有裂片妖均为无色。\', \'type\': \'生物～裂片妖\', \'flavor\': \'「这品种是演化的最尖端。 他把用以连通女王的印记焚毁，不再听任其号令。 他想找新的主人。 我或许能替他找一个。」 ～妃雅丽兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132351&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3b11c4d1-4e60-481c-8174-8abb504b4d53\', \'multiverseId\': 132351}, \'multiverseid\': 132351}]', '[{\'name\': \'Gemmenhautremasuri\', \'text\': \'Alle Remasuris haben "{T}: Erhöhe deinen Manavorrat um ein Mana einer beliebigen Farbe."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Das Land ist müde. Selbst der Wolkenwald ist erschöpft. Wir müssen eine neue Manaquelle erschließen — eine, die auch in dieser untergehenden Welt weiter gedeiht." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132950&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'897d1dfb-da60-4b5e-9167-c442281da68d\', \'multiverseId\': 132950}, \'multiverseid\': 132950}, {\'name\': \'Fragmentado piel de gemas\', \'text\': \'Todos los Fragmentados tienen "{T}: Agrega un maná de cualquier color a tu reserva de maná".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"La tierra está agotada. Incluso Veloceleste está vacío. Debemos encontrar otra fuente de maná, una que crezca a pesar de que nuestro mundo se marchita." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134455&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2eb78de8-daab-4fc0-804e-257c6f57c013\', \'multiverseId\': 134455}, \'multiverseid\': 134455}, {\'name\': \'Slivoïde cuirgemme\', \'text\': \'Tous les slivoïdes ont « {T} : Ajoutez un mana de la couleur de votre choix à votre réserve. »\', \'type\': \'Créature : slivoïde\', \'flavor\': \'« La terre est lasse. Même Linciel manque de puissance. Nous devons trouver une autre source de mana — une source qui ne soit pas tarie par le flétrissement de notre monde. » —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132649&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f21ada3c-08dd-4766-b9c4-7a00ade61442\', \'multiverseId\': 132649}, \'multiverseid\': 132649}, {\'name\': \'Tramutante Pelle di Gemma\', \'text\': \'Tutti i Tramutanti hanno "{T}: Aggiungi un mana di un qualsiasi colore alla tua riserva di mana."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"La terra è esausta. Perfino Cielsudario è svuotato. Dobbiamo trovare un\\\'altra fonte di mana—una che stia crescendo nonostante l\\\'avvizzimento del nostro mondo." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133251&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'b7e75dfa-6aec-4501-bd56-ee88f440646f\', \'multiverseId\': 133251}, \'multiverseid\': 133251}, {\'name\': \'宝革スリヴァー\', \'text\': \'すべてのスリヴァーは「{T}：あなたのマナ・プールに、好きな色１色のマナ１点を加える。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'地は痩せ細っています。 スカイシュラウドですら枯れ尽きています。 新たなマナの源を見つけなければいけません――この弱った世界でも成長するものの中に。 ――フレイアリーズ\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133552&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2cbd2be9-0548-49cf-9cb9-5e1074873099\', \'multiverseId\': 133552}, \'multiverseid\': 133552}, {\'name\': \'Fractius Pele Preciosa\', \'text\': \'Todos os Fractius têm "{T}: Adicione um mana de qualquer cor à sua reserva de mana."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"A terra está esgotada. Até mesmo Skyshroud está exausta. Precisamos encontrar outra fonte de mana uma que esteja crescendo apesar de nosso mundo degenerado." —Freyalise\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133853&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'3912be31-ce9f-431f-82dc-c9d81f12f1a0\', \'multiverseId\': 133853}, \'multiverseid\': 133853}, {\'name\': \'Щепка Цвета Самоцветов\', \'text\': \'Все Щепки обладают способностью "{T}: Добавьте одну ману любого цвета в ваше хранилище маны."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Земля утомлена. Даже Скайшрауд истощен. Мы должны найти другой источник маны тот, что процветает вопреки нашему опустошенному миру», Фреялиз\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134154&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e9aaf15f-9a29-4a09-8da9-2d180f5ace18\', \'multiverseId\': 134154}, \'multiverseid\': 134154}, {\'name\': \'灿衣裂片妖\', \'text\': \'所有裂片妖具有「{T}：加一点任意颜色的法术力到你的法术力池中。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「大地疲惫不堪。 连天帷也已枯竭。 我们必须找到其它的法术力来源～就算在这枯萎世界也能成长的品种。」 ～妃雅丽兹\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132348&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c8765744-14fb-4772-b165-78b3702194c0\', \'multiverseId\': 132348}, \'multiverseid\': 132348}]', '[{\'name\': \'Geschmolzener Schlackehaufen\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {1}.\\n{1}, {T}: Lege eine Speichermarke auf den Geschmolzenen Schlackehaufen.\\n{1}, entferne X Speichermarken vom Geschmolzenen Schlackehaufen: Erhöhe deinen Manavorrat um X Mana einer beliebigen Kombination aus {B} und/oder {R}.\', \'type\': \'Land\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133009&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'454b34e1-8d52-472e-8ae2-285b6981d672\', \'multiverseId\': 133009}, \'multiverseid\': 133009}, {\'name\': \'Escoria fundida\', \'text\': \'{T}: Agrega {1} a tu reserva de maná.\\n{1}, {T}: Pon un contador de almacenaje sobre la Escoria fundida.\\n{1}, remover X contadores de almacenaje de la Escoria fundida: Agrega X maná de cualquier combinación de {B} y/o {R} a tu reserva de maná.\', \'type\': \'Tierra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134514&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b46bc39c-2dd4-4553-bbcf-9c2b76bec493\', \'multiverseId\': 134514}, \'multiverseid\': 134514}, {\'name\': \'Crassier en fusion\', \'text\': "{T} : Ajoutez {1} à votre réserve.\\n{1}, {T} : Mettez un marqueur « stock » sur le Crassier en fusion.\\n{1}, retirez X marqueurs « stock » du Crassier en fusion : Ajoutez X manas de n\'importe quelle combinaison de {B} et/ou {R} à votre réserve.", \'type\': \'Terrain\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132708&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'98416b33-2700-42f9-a636-fbb8f9671ee4\', \'multiverseId\': 132708}, \'multiverseid\': 132708}, {\'name\': \'Cumulo di Scorie Fuso\', \'text\': \'{T}: Aggiungi {1} alla tua riserva di mana.\\n{1}, {T}: Metti un segnalino magazzino sul Cumulo di Scorie Fuso.\\n{1}, Rimuovi X segnalini magazzino dal Cumulo di Scorie Fuso: Aggiungi X mana in qualsiasi combinazione di {B} e/o {R} alla tua riserva di mana.\', \'type\': \'Terra\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133310&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'0315a8ee-aefa-4142-9b47-127d6e3a2936\', \'multiverseId\': 133310}, \'multiverseid\': 133310}, {\'name\': \'溶鉄の金屑場\', \'text\': \'{T}：あなたのマナ・プールに{1}を加える。\\n{1}, {T}：溶鉄の金屑場の上に蓄積カウンターを１個置く。\\n{1}, 溶鉄の金屑場から蓄積カウンターをＸ個取り除く：Ｘ点の{B}か{R}（あるいはその組み合わせ）をあなたのマナ・プールに加える。\', \'type\': \'土地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133611&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'36dce2ba-39c0-418a-9c12-9a46ed008c67\', \'multiverseId\': 133611}, \'multiverseid\': 133611}, {\'name\': \'Escória Fundida\', \'text\': \'{T}: Adicione {1} à sua reserva de mana.\\n{1}, {T}: Coloque um marcador de estocagem sobre Escória Fundida.\\n{1}, Remova X marcadores de estocagem de Escória Fundida: Adicione X manas em qualquer combinação de {B} e/ou {R} à sua reserva de mana.\', \'type\': \'Terreno\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133912&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'0a716395-676a-456c-8646-8bf0d777382d\', \'multiverseId\': 133912}, \'multiverseid\': 133912}, {\'name\': \'Расплавленный Террикон\', \'text\': \'{T}: Добавьте {1} в ваше хранилище маны.\\n{1}, {T}: Положите накопительный жетон на Расплавленный террикон.\\n{1}, Удалите X накопительных жетонов с Расплавленного террикона: Добавьте X маны в любых комбинациях {B} и/или {R} в ваше хранилище маны.\', \'type\': \'Земля\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134213&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'57d0dbe0-7eb5-4ad2-b209-6bea6a0dcedc\', \'multiverseId\': 134213}, \'multiverseid\': 134213}, {\'name\': \'渣滓熔堆\', \'text\': \'{T}：加{1}到你的法术力池中。\\n{1}，{T}：在渣滓熔堆上放置一个储藏指示物。\\n{1}，从渣滓熔堆上移去X个储藏指示物：加X点法术力到你的法术力池中，且为{B}和／或{R}的任意组合。\', \'type\': \'地\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132407&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'691e049e-92f2-4559-959e-d660e7a828b8\', \'multiverseId\': 132407}, \'multiverseid\': 132407}]', '[{\'name\': \'Geschundene Plünderer\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\n{B}: Regeneriere die Geschundenen Plünderer.\', \'type\': \'Kreatur — Skelett\', \'flavor\': \'„Die Oberfläche des Landes ist vom Salz weiß überkrustet, aber die Erde darunter ist rot vom ganzen Blut, das hier vergossen wurde — ein fruchtbarer Boden für Totenbeschwörung." —Lim-Dûl, der Geisterbeschwörer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132914&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'64b3029b-aaaf-4649-b49b-17e034737672\', \'multiverseId\': 132914}, \'multiverseid\': 132914}, {\'name\': \'Desgarradores esclavos\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\n{B}: Regenera los Desgarradores esclavos.\', \'type\': \'Criatura — Esqueleto\', \'flavor\': \'"La superficie de la tierra está blanqueada con sal, pero la tierra debajo está enrojecida con muerte; un terreno fértil para la nigromancia." —Lim-Dûl el Nigromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134419&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'2eaf5de9-c1c9-47a0-9f65-1b02981f9758\', \'multiverseId\': 134419}, \'multiverseid\': 134419}, {\'name\': \'Pillards serviles\', \'text\': \'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\n{B} : Régénérez ces Pillards serviles.\', \'type\': \'Créature : squelette\', \'flavor\': \'« La surface est blanchie par le sel, mais la terre est rougie par la mort — un terrain fertile pour la nécromancie. » —Lim-Dûl, le Nécromancien\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132613&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'82142410-0e39-4f82-8701-815780b39ca1\', \'multiverseId\': 132613}, \'multiverseid\': 132613}, {\'name\': \'Razziatori Facchini\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\n{B}: Rigenera i Razziatori Facchini.\', \'type\': \'Creatura — Scheletro\', \'flavor\': \'"La superficie della terra è sbiancata dal sale, ma il terreno sotto è rosso di morte—un terreno fertile per la necromanzia." —Lim-Dûl il Necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133215&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'60d95367-b320-4138-b1d4-1d48d331b0b1\', \'multiverseId\': 133215}, \'multiverseid\': 133215}, {\'name\': \'蠢く肉裂き\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n{B}：蠢く肉裂きを再生する。\', \'type\': \'クリーチャー — スケルトン\', \'flavor\': \'この地の表面は塩で白く覆われているが、その下の土は死で赤く染まっておる――屍術には豊穣の地よ。 ――屍術師リム＝ドゥール\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133516&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'9ce4d21b-5ce5-4eed-a76c-1214a8aad24e\', \'multiverseId\': 133516}, \'multiverseid\': 133516}, {\'name\': \'Dilaceradores de Carga\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\n{B}: Regenere Dilaceradores de Carga.\', \'type\': \'Criatura — Esqueleto\', \'flavor\': \'"A superfície da terra está esbranquiçada com o sal, mas o solo abaixo está avermelhado com a morte um terreno fértil para a necromancia." —Lim-Dûl, o Necromante\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133817&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'8b637a6d-2f11-4c8f-beec-7ba1b6a5913d\', \'multiverseId\': 133817}, \'multiverseid\': 133817}, {\'name\': \'Наемный Грабитель\', \'text\': \'Миг (Вы можете играть это заклинание в любое время когда вы можете играть мгновенные заклинания.)\\n{B}: Регенерируйте Наемного Грабителя.\', \'type\': \'Существо — Скелет\', \'flavor\': \'«Поверхность земли покрыта солью, но почвы, что ниже, рдеющие смертью плодородье для некромантии», Лим-Дул Некромант\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134118&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c555c988-bfcb-4a6d-8b2f-3bae29ac4789\', \'multiverseId\': 134118}, \'multiverseid\': 134118}, {\'name\': \'苦力裂肢兵\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n{B}：重生苦力裂肢兵。\', \'type\': \'生物～骷髅妖\', \'flavor\': \'「地表覆满白盐，底下却是血壤一片～简直是死冥术的肥沃大地。」 ～死灵术士林杜\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132312&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'73574a04-35ad-42a2-a45b-b3b46491c9d5\', \'multiverseId\': 132312}, \'multiverseid\': 132312}]', '[{\'name\': \'Gesichtsloser Verschlinger\', \'text\': \'Irrealität (Diese Kreatur kann nur Kreaturen mit Irrealität blocken und nur von solchen geblockt werden.)Wenn der Gesichtslose Verschlinger ins Spiel kommt, entferne eine andere Kreatur deiner Wahl mit Irrealität ganz aus dem Spiel.\\nWenn der Gesichtslose Verschlinger das Spiel verlässt, bringe die so ganz aus dem Spiel entfernte Karte unter der Kontrolle ihres Besitzers ins Spiel zurück.\', \'type\': \'Kreatur — Nachtmahr, Schrecken\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132925&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3cad95bf-d55c-45bd-bfae-826199d392ba\', \'multiverseId\': 132925}, \'multiverseid\': 132925}, {\'name\': \'Devorador sin rostro\', \'text\': \'Se desvanece (Esta criatura sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\\nCuando el Devorador sin rostro entre en juego, remueve del juego otra criatura objetivo con la habilidad de desvanecerse.\\nCuando el Devorador sin rostro salga del juego, regresa al juego la carta removida bajo el control de su propietario.\', \'type\': \'Criatura — Horror pesadilla\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134430&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cad94fa2-5f0d-4c7b-8c91-e43bb2933b7e\', \'multiverseId\': 134430}, \'multiverseid\': 134430}, {\'name\': \'Dévoreur sans visage\', \'text\': \'Distorsion (Cette créature ne peut bloquer ou être bloquée que par des créatures avec la distorsion.)\\nQuand le Dévoreur sans visage arrive en jeu, retirez de la partie une autre créature ciblée avec la distorsion.\\nQuand le Dévoreur sans visage quitte le jeu, renvoyez en jeu sous le contrôle de son propriétaire la carte retirée.\', \'type\': \'Créature : cauchemar et horreur\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132624&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7fc49770-a861-44f1-b736-0b0b191dcf60\', \'multiverseId\': 132624}, \'multiverseid\': 132624}, {\'name\': \'Divoratore Senza Volto\', \'text\': "Ombra (Questa creatura può bloccare o essere bloccata soltanto da creature con ombra.)\\nQuando il Divoratore Senza Volto entra in gioco, rimuovi dal gioco un\'altra creatura bersaglio con ombra.\\nQuando il Divoratore Senza Volto lascia il gioco, rimetti in gioco la carta rimossa sotto il controllo del suo proprietario.", \'type\': \'Creatura — Orrore Incubo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133226&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ac6ffb7-02e3-4995-83a6-d821118311fd\', \'multiverseId\': 133226}, \'multiverseid\': 133226}, {\'name\': \'顔なしの貪り食い\', \'text\': \'シャドー （このクリーチャーは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\\n顔なしの貪り食いが場に出たとき、他のシャドーを持つクリーチャー１体を対象とし、それをゲームから取り除く。\\n顔なしの貪り食いが場に離れたとき、その取り除いたカードを、オーナーのコントロール下で場に戻す。\', \'type\': \'クリーチャー — ナイトメア・ホラー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133527&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'05baa809-aebb-4c4a-b110-3197b6ed06aa\', \'multiverseId\': 133527}, \'multiverseid\': 133527}, {\'name\': \'Devorador Sem Rosto\', \'text\': \'Sombra (Esta criatura só pode bloquear ou ser bloqueada por criaturas com sombra.)\\nQuando Devorador Sem Rosto entrar em jogo, remova do jogo outra criatura alvo com sombra.\\nQuando Devorador Sem Rosto sair de jogo, devolva o card removido para o jogo sob o controle de seu dono.\', \'type\': \'Criatura — Horror Pesadelo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133828&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'204cb395-1365-4ae6-af65-33e925569f6c\', \'multiverseId\': 133828}, \'multiverseid\': 133828}, {\'name\': \'Безликий Пожиратель\', \'text\': \'Тень (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\\nКогда Безликий Пожиратель входит в игру, удалите другое целевое существо с тенью из игры.\\nКогда Безликий Пожиратель покидает игру, верните удаленную им карту в игру под контроль ее владельца\', \'type\': \'Существо — Кошмар Ужас\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134129&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a0e1b52-6f3c-4315-aab8-83f5bd1f7fd7\', \'multiverseId\': 134129}, \'multiverseid\': 134129}, {\'name\': \'无面吞噬兽\', \'text\': \'次元幽影（此生物只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\\n当无面吞噬兽进场时，将另一个目标具次元幽影异能的生物移出对战。\\n当无面吞噬兽离场时，将以此法移出对战的牌在其拥有者的操控下移回场上。\', \'type\': \'生物～梦魇／惊惧兽\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132323&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'6b670bcd-1009-426b-a1a2-872e0b37f966\', \'multiverseId\': 132323}, \'multiverseid\': 132323}]', "[{'name': 'Gewitterlinie', 'text': 'Die Gewitterlinie fügt allen fliegenden Kreaturen und allen Spielern X Schadenspunkte zu.', 'type': 'Spontanzauber', 'flavor': 'Die dauernde Verwerfung des Zeitgefüges auf Dominaria richtete auch in der Atmosphäre Verwüstung an, da sich wilde Gewitter aus vergangenen Zeiten austobten.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133087&type=card', 'language': 'German', 'identifiers': {'scryfallId': '4b7daffa-5eff-44a7-a917-ceb6e2e88add', 'multiverseId': 133087}, 'multiverseid': 133087}, {'name': 'Línea de ráfagas', 'text': 'La Línea de ráfagas hace X puntos de daño a cada criatura que tenga la habilidad de volar y a cada jugador.', 'type': 'Instantáneo', 'flavor': 'El cambio constante de la deshilachada línea de tiempo de Dominaria devastó su atmósfera, combinando salvajes tormentas eléctricas de épocas pasadas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134592&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '75d1c3f1-3275-417f-869e-8be4f4f9ae07', 'multiverseId': 134592}, 'multiverseid': 134592}, {'name': 'Front de bourrasque', 'text': 'Le Front de bourrasque inflige X blessures à chaque créature avec le vol et à chaque joueur.', 'type': 'Éphémère', 'flavor': 'Les changements constants de la ligne temporelle de Dominaria semaient le chaos dans son atmosphère, combinant de redoutables orages électriques du passé.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132786&type=card', 'language': 'French', 'identifiers': {'scryfallId': '7eff894a-72cf-49db-895f-dac0cf844db7', 'multiverseId': 132786}, 'multiverseid': 132786}, {'name': 'Linea di Burrasca', 'text': 'La Linea di Burrasca infligge X danni a ogni creatura con volare e a ogni giocatore.', 'type': 'Istantaneo', 'flavor': 'Il costante mutamento delle sfilacciate linee temporali di Dominaria sconvolse la sua atmosfera, combinando violente tempeste elettriche provenienti da ere passate.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133388&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '662d0c73-03b7-4ff9-a806-cf46846803bb', 'multiverseId': 133388}, 'multiverseid': 133388}, {'name': '突風線', 'text': '突風線は飛行を持つ各クリーチャーと各プレイヤーに、それぞれＸ点のダメージを与える。', 'type': 'インスタント', 'flavor': 'ドミナリアの細切れにされた時の流れは、数世代過去の荒々しい電磁嵐とともに気候をもてあそんだ。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133689&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'e120bca8-31ef-49c8-8264-aa5c5137fc9c', 'multiverseId': 133689}, 'multiverseid': 133689}, {'name': 'Linha de Instabilidade', 'text': 'Linha de Instabilidade causa X pontos de dano a cada criatura voadora e a cada jogador.', 'type': 'Mágica Instantânea', 'flavor': 'O desvio constante da fragmentada linha do tempo de Dominária arruinou a atmosfera, reunindo violentas tempestades elétricas de eras passadas.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133990&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '10c4730f-81b1-48c7-8e8f-d6b923f1ea4a', 'multiverseId': 133990}, 'multiverseid': 133990}, {'name': 'Шквальный Порыв', 'text': 'Шквальный Порыв наносит X повреждений каждому существу с полетом и каждому игроку.', 'type': 'Мгновенное заклинание', 'flavor': 'Постоянное перемещение изломанной оси времени нарушало спокойствие атмосферы Доминарии, сталкивая между собой мощнейшие электрические штормы прошлого.', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134291&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '82aa4452-9eb6-467f-b1ce-d2fc865ebc83', 'multiverseId': 134291}, 'multiverseid': 134291}, {'name': '疾风暴线', 'text': '疾风暴线对每个具飞行异能的生物与每位牌手造成X点伤害。', 'type': '瞬间', 'flavor': '多明纳里亚破碎的时间流变幻无常，大气也受其剧烈影响，两者结合成来自远古的强烈雷暴。', 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132485&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'a1863ceb-f0ec-4b48-8405-0da60a5ddb66', 'multiverseId': 132485}, 'multiverseid': 132485}]", '[{\'name\': \'Ghitu-Feuerodem\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)Kreaturenverzauberung\\n{R}: Die verzauberte Kreatur erhält +1/+0 bis zum Ende des Zuges.\\n{R}: Bringe den Ghitu-Feuerodem auf die Hand seines Besitzers zurück.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132952&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a7111d47-c322-4791-9e01-5b10ba868e0e\', \'multiverseId\': 132952}, \'multiverseid\': 132952}, {\'name\': \'Hálito de fuego ghitu\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nEncantar criatura.\\n{R}: La criatura encantada obtiene +1/+0 hasta el final del turno.\\n{R}: Regresa el Hálito de fuego ghitu a la mano de su propietario.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134457&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cd6b91e6-b690-4b46-a3ef-a99a5bfbe3c4\', \'multiverseId\': 134457}, \'multiverseid\': 134457}, {\'name\': \'Souffle ardent guitûk\', \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nEnchanter : créature\\n{R} : La créature enchantée gagne +1/+0 jusqu\'à la fin du tour.\\n{R} : Renvoyez le Souffle ardent guitûk dans la main de son propriétaire.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132651&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'74e2a630-d343-498c-aae3-632c2f5562f0\', \'multiverseId\': 132651}, \'multiverseid\': 132651}, {\'name\': \'Soffio Infuocato Ghitu\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nIncanta creatura\\n{R}: La creatura incantata prende +1/+0 fino alla fine del turno.\\n{R}: Fai tornare il Soffio Infuocato Ghitu in mano al suo proprietario.\', \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133253&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d9906ebd-7537-4bca-ba69-dd09fc4b80f9\', \'multiverseId\': 133253}, \'multiverseid\': 133253}, {\'name\': \'ギトゥの火炎噴射\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nエンチャント（クリーチャー）\\n{R}：エンチャントされているクリーチャーはターン終了時まで＋１/＋０の修整を受ける。\\n{R}：ギトゥの火炎噴射をオーナーの手札に戻す。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133554&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'a7c3e8fd-e2c7-4f7b-8a4c-bbd738b83c30\', \'multiverseId\': 133554}, \'multiverseid\': 133554}, {\'name\': \'Ghitu Hálito de Fogo\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nEncantar Criatura\\n{R}: A criatura encantada recebe +1/+0 até o final do turno.\\n{R}: Devolva Ghitu Hálito de Fogo para a mão de seu dono.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133855&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2abe5bae-8ef6-41d8-a187-6dee95081835\', \'multiverseId\': 133855}, \'multiverseid\': 133855}, {\'name\': \'Огненное Дыхание Гиту\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nЗачаровать существо\\n{R}: Зачарованное существо получает +1/+0 до конца хода.\\n{R}: Верните Огненное Дыхание Гиту в руку владельца.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134156&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'49cfcf53-c4cf-4ee7-b537-f441d629916d\', \'multiverseId\': 134156}, \'multiverseid\': 134156}, {\'name\': \'基图炎息\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n生物结界\\n{R}：受此结界的生物得+1/+0直到回合结束。\\n{R}：将基图炎息移回其拥有者手上。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132350&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'87d1fd53-4941-423b-ab83-e632d48fd4c4\', \'multiverseId\': 132350}, \'multiverseid\': 132350}]', '[{\'name\': \'Glasnatter\', \'text\': \'Immer wenn die Glasnatter einem Spieler Kampfschaden zufügt, verliert dieser Spieler zu Beginn seines nächsten Ziehsegments 2 Lebenspunkte, falls er nicht vor diesem Segment {2} bezahlt.\', \'type\': \'Kreatur — Ophis\', \'flavor\': \'Ihr Gift verursacht Fieberträume, in denen ihre Opfer den schmerzhaften Biss immer wieder erleben müssen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132954&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20745c50-4158-4829-8aae-84ecfcecf8b7\', \'multiverseId\': 132954}, \'multiverseid\': 132954}, {\'name\': \'Áspid de vidrio\', \'text\': \'Siempre que el Áspid de vidrio haga daño de combate a un jugador, ese jugador pierde 2 vidas al comienzo de su próximo paso de robar a menos que pague {2} antes de ese paso.\', \'type\': \'Criatura — Víbora\', \'flavor\': \'Su veneno induce una fiebre que causa que las víctimas revivan el ataque con visiones recurrentes y perturbadoras.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134459&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a2908afb-6c59-498c-a141-4d590a182a57\', \'multiverseId\': 134459}, \'multiverseid\': 134459}, {\'name\': \'Vipère de verre\', \'text\': "À chaque fois que la Vipère de verre inflige des blessures de combat à un joueur, ce joueur perd 2 points de vie au début de sa prochaine étape de pioche à moins qu\'il ne paie {2} avant cette étape.", \'type\': \'Créature : serpent\', \'flavor\': "Son venin provoque une fièvre qui fait revivre l\'attaque à ses victimes dans d\'horribles visions récurrentes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132653&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'66c377bc-05be-48d2-81ab-8122271268f7\', \'multiverseId\': 132653}, \'multiverseid\': 132653}, {\'name\': \'Aspide di Vetro\', \'text\': "Ogniqualvolta l\'Aspide di Vetro infligge danno da combattimento a un giocatore, quel giocatore perde 2 punti vita all\'inizio della sua prossima acquisizione a meno che lui non paghi {2} prima di quella sottofase.", \'type\': \'Creatura — Serpente\', \'flavor\': "Il suo veleno provoca una febbre che fa rivivere l\'attacco alle sue vittime, in ricorrenti visioni ossessive.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133255&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'82a9cc5a-d59c-45c6-8a66-fa6a906f4b21\', \'multiverseId\': 133255}, \'multiverseid\': 133255}, {\'name\': \'ガラスのアスプ\', \'text\': \'ガラスのアスプがいずれかのプレイヤーに戦闘ダメージを与えるたび、そのプレイヤーは自分の次のドロー・ステップの開始時に、そのステップに入る前に{2}を支払わないかぎり、２点のライフを失う。\', \'type\': \'クリーチャー — 蛇\', \'flavor\': \'その毒は高熱をもたらし、被害者は繰り返し付きまとう幻影に襲い掛かられる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133556&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'044123f5-4748-4ca1-b9a0-df923d6c6f4e\', \'multiverseId\': 133556}, \'multiverseid\': 133556}, {\'name\': \'Áspide de Vidro\', \'text\': \'Toda vez que Áspide de Vidro causa dano de combate a um jogador, aquele jogador perde 2 pontos de vida no início de sua próxima etapa de compra, a menos que ele pague {2} antes daquela etapa.\', \'type\': \'Criatura — Cobra\', \'flavor\': \'Seu veneno causa uma febre que faz com que a vítima reviva o ataque em recorrentes visões assombrosas.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133857&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b8a5d7e9-ab93-4ad2-8acd-723d28d923ba\', \'multiverseId\': 133857}, \'multiverseid\': 133857}, {\'name\': \'Стеклянная Гадюка\', \'text\': \'Когда Стеклянная Гадюка наносит боевые повреждения игроку, этот игрок теряет 2 жизни в начале своего следующего шага взятия карты, если он или она до этого шага не заплатит {2}.\', \'type\': \'Существо — Змея\', \'flavor\': \'Ее яд приводит к агонии, заставляющей ее жертв вновь и вновь переживать момент атаки.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134158&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aa80401a-fd36-40d1-ad48-06466e8e9f6c\', \'multiverseId\': 134158}, \'multiverseid\': 134158}, {\'name\': \'玻璃角奎\', \'text\': \'每当玻璃角奎对牌手造成战斗伤害时，则在该牌手的下一个抓牌步骤开始时，除非他在该步骤之前支付{2}，否则他失去2点生命。\', \'type\': \'生物～蛇\', \'flavor\': \'其毒液造成的热病，会让其受害者被遭囓时的幻象纠缠不已。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132352&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'15d31b95-556f-439d-9ef9-d0a93dea14c3\', \'multiverseId\': 132352}, \'multiverseid\': 132352}]', '[{\'name\': \'Gleichgewicht wiederherstellen\', \'text\': \'Gleichgewicht wiederherstellen ist weiß.\\nAussetzen 6 {W}\\nJeder Spieler bestimmt eine Anzahl an Ländern, die er kontrolliert, in Höhe der Anzahl an Ländern, die der Spieler kontrolliert, der die wenigsten Länder kontrolliert, und opfert dann den Rest. Spieler opfern auf diese Weise auch Kreaturen und werfen Karten aus ihrer Hand ab.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133054&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'9b3f7c10-3fa3-4749-8117-f90176c6b35d\', \'multiverseId\': 133054}, \'multiverseid\': 133054}, {\'name\': \'Devolver el equilibrio\', \'text\': \'Devolver el equilibrio es blanco.\\nSuspender 6—{W}.\\nCada jugador elige una cantidad de tierras que controla igual al número de tierras que controla el jugador que controla menos, luego sacrifica el resto. Los jugadores sacrifican criaturas y descartan cartas de la misma manera.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134559&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b7b432f3-9389-4159-a747-3b103dc70002\', \'multiverseId\': 134559}, \'multiverseid\': 134559}, {\'name\': "Rectification de l\'équilibre", \'text\': "La Rectification de l\'équilibre est blanche.\\nSuspend 6 — {W}\\nChaque joueur choisit un nombre de terrains qu\'il contrôle égal au nombre de terrains contrôlés par le joueur qui en contrôle le moins, puis sacrifie les autres. Les joueurs sacrifient des créatures et se défausse de cartes de la même manière.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132753&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6990a142-023a-4488-a692-24275e4002ef\', \'multiverseId\': 132753}, \'multiverseid\': 132753}, {\'name\': \'Ripristinare Equilibrio\', \'text\': \'Ripristinare Equilibrio è bianco.\\nSospendere 6—{W}\\nOgni giocatore sceglie un numero di terre che controlla pari al numero di terre controllate dal giocatore che ne controlla di meno, poi sacrifica quelle rimanenti. I giocatori sacrificano le creature e scartano le carte allo stesso modo.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133355&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'db6c2d5a-faaa-4fdf-9a64-5e16ebcfb1c2\', \'multiverseId\': 133355}, \'multiverseid\': 133355}, {\'name\': \'均衡の復元\', \'text\': \'均衡の復元は白である。\\n待機 ６―{W}\\n各プレイヤーは自分がコントロールしている土地から、最も少ない土地をコントロールしているプレイヤーの土地の総数に等しい数の土地を選び、残りを生け贄に捧げる。 プレイヤーは同様にクリーチャーを生け贄に捧げ、同様に手札を捨てる。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133656&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6f12057c-7424-490c-9eab-c41c43918bf1\', \'multiverseId\': 133656}, \'multiverseid\': 133656}, {\'name\': \'Restaurar o Equilíbrio\', \'text\': \'Restaurar o Equilíbrio é branco.\\nSuspender 6—{W}\\nCada jogador escolhe um número de terrenos que ele próprio controle igual ao número de terrenos controlados pelo jogador que controla o menor número de terrenos e depois sacrifica o resto. Os jogadores sacrificam criaturas e descartam cards do mesmo modo.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133957&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6fcb5a7e-7887-4d7c-886f-48a813c6a95d\', \'multiverseId\': 133957}, \'multiverseid\': 133957}, {\'name\': \'Восстановить Баланс\', \'text\': \'Востановить Баланс является белым.\\nОтсрочка 6—{W}\\nКаждый игрок выбирает то количество земель под своим контролем, которое равно минимальному числу земель под контролем одного из игроков, затем жертвует все остальные. Игроки жертвуют существа и сбрасывают карты подобным образом.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134258&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e3598b7a-b502-43f2-8242-6b6664526141\', \'multiverseId\': 134258}, \'multiverseid\': 134258}, {\'name\': \'恢复均势\', \'text\': \'恢复均势是白色。\\n延缓6～{W}\\n每位牌手选择若干由他所操控的地，其数量等同于所有牌手中操控地最少之牌手的地数量，然后牺牲其余的地。 各牌手也以此法牺牲生物与弃牌。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132452&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'468d1ae8-f5d7-4ce0-8c4e-084e2b284ef2\', \'multiverseId\': 132452}, \'multiverseid\': 132452}]', "[{'name': 'Glücksdiebin', 'text': 'Schaden, der deine Lebenspunkte unter 1 reduzieren würde, reduziert sie stattdessen auf 1.\\nMorph {R}{R} (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)', 'type': 'Kreatur — Mensch, Räuber', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132944&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'b8d5cfb0-59ef-4ef0-8a0d-e65150d8b7b6', 'multiverseId': 132944}, 'multiverseid': 132944}, {'name': 'Ladrona de fortuna', 'text': 'El daño que fuera a reducir tu total de vida a menos de 1, en vez de eso, lo reduce a 1.\\nMetamorfosis {R}{R} (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)', 'type': 'Criatura — Bribón humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134449&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '620fab37-c8c0-4e48-a2b0-970c3e0e1488', 'multiverseId': 134449}, 'multiverseid': 134449}, {'name': 'Voleuse de fortune', 'text': 'Les blessures qui devraient réduire votre total de points de vie à moins de 1 le réduisent à 1 à la place.\\nMue {R}{R} (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)', 'type': 'Créature : humain et gredin', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132643&type=card', 'language': 'French', 'identifiers': {'scryfallId': '349d5d0c-d9a7-4523-a42e-dac7a4ed707d', 'multiverseId': 132643}, 'multiverseid': 132643}, {'name': 'Ladra di Ventura', 'text': 'Qualsiasi danno che ridurrebbe i tuoi punti vita a meno di 1 li riduce invece a 1.\\nMetamorfosi {R}{R} (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)', 'type': 'Creatura — Farabutto Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133245&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'aaa15772-8f4a-40f9-ad7e-67ceec9e8391', 'multiverseId': 133245}, 'multiverseid': 133245}, {'name': '運命の盗人', 'text': 'あなたのライフの総量を１点未満に減少させるダメージは、代わりにあなたのライフの総量が１点になるまで減少させる。\\n変異 {R}{R} （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）', 'type': 'クリーチャー — 人間・ならず者', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133546&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '7852eb91-604e-4022-ab3d-3cd96f67af28', 'multiverseId': 133546}, 'multiverseid': 133546}, {'name': 'Ladra de Sorte', 'text': 'O dano que reduziria seu total de pontos de vida a menos de 1, em vez disso, o reduz a 1.\\nMetamorfose {R}{R} (Você pode baixar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)', 'type': 'Criatura — Ladino Humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133847&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '34a1abf4-fae6-4da7-9781-1c0cd5fb0ea2', 'multiverseId': 133847}, 'multiverseid': 133847}, {'name': 'Воришка Состояния', 'text': 'Повреждения, которые уменьшают вашу жизнь до значения менее 1, вместо этого уменьшают ее до 1.\\nОборотень {R}{R} (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)', 'type': 'Существо — Человек Бродяга', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134148&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'd26ca3ca-477d-44e4-a86b-6acca78f90df', 'multiverseId': 134148}, 'multiverseid': 134148}, {'name': '幸运盗贼', 'text': '将使你的总生命减少至1以下的伤害，改为将它减少至1。\\n变身{R}{R}（你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）', 'type': '生物～人类／浪客', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132342&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2bce1751-21cd-4688-9374-4efe2204024b', 'multiverseId': 132342}, 'multiverseid': 132342}]", '[{\'name\': \'Gnade des Engels\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nDu kannst in diesem Zug das Spiel nicht verlieren und deine Gegner können in diesem Zug das Spiel nicht gewinnen. Bis zum Ende des Zuges reduziert Schaden, der deine Lebenspunkte unter 1 reduzieren würde, sie stattdessen auf 1.\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132861&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'2d573ba7-c2aa-4147-8428-27d168a761f9\', \'multiverseId\': 132861}, \'multiverseid\': 132861}, {\'name\': \'Gracia del ángel\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nTú no puedes perder el juego este turno y tus oponentes no pueden ganar el juego este turno. Hasta el final del turno, el daño que fuera a reducir tu total de vida a menos de 1, en vez de eso, lo reduce a 1.\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134366&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'73a95df5-1683-400d-8614-65aaa0e7d436\', \'multiverseId\': 134366}, \'multiverseid\': 134366}, {\'name\': "Grâce de l\'ange", \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nVous ne pouvez pas perdre la partie ce tour-ci et vos adversaires ne peuvent pas la gagner ce tour-ci. Jusqu\'à la fin du tour, les blessures qui devraient réduire votre total de points de vie à moins de 1 le réduisent à 1 à la place.", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132560&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2682981e-9110-48ca-a57a-b71d089666fe\', \'multiverseId\': 132560}, \'multiverseid\': 132560}, {\'name\': "Grazia dell\'Angelo", \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nIn questo turno, non puoi perdere la partita e i tuoi avversari non possono vincere la partita. Fino alla fine del turno, qualsiasi danno che ridurrebbe i tuoi punti vita a meno di 1 li riduce invece a 1.\', \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133162&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'a25ddcc0-3693-4fae-b2e0-5e5c80502236\', \'multiverseId\': 133162}, \'multiverseid\': 133162}, {\'name\': \'天使の嗜み\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nこのターン、あなたはこのゲームに敗北することはできず、このターン、あなたの対戦相手はこのゲームに勝利することはできない。 ターン終了時まで、あなたのライフの総量を１点未満に減少させるダメージは、代わりにあなたのライフの総量が１点になるまで減少させる。\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133463&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'883c40c9-f69e-407e-a469-d84414706aed\', \'multiverseId\': 133463}, \'multiverseid\': 133463}, {\'name\': \'Graça do Anjo\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nVocê não pode perder o jogo neste turno e seus oponentes não podem vencer o jogo neste turno. Até o final do turno, o dano que reduziria seu total de pontos de vida para menos de 1, em vez disso, o reduz para 1.\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133764&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2f7ac06d-9f90-44cc-9dc3-6d6a4d451042\', \'multiverseId\': 133764}, \'multiverseid\': 133764}, {\'name\': \'Благоволение Ангела\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nВы не можете проиграть, а ваши оппоненты не могут выиграть игру на этом ходу. До конца хода повреждения, уменьшающие ваше количество жизни до значения меньше 1, вместо этого уменьшают его до 1.\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134065&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4822dfef-2925-4ab3-8ed2-d0a6b3c08438\', \'multiverseId\': 134065}, \'multiverseid\': 134065}, {\'name\': \'天使恩典\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n本回合中，你这盘游戏不会输，对手也不会赢。 直到回合结束，将使你的总生命减少至1以下的伤害，改为将它减少至1。\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132259&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'49de172b-a543-4d13-be60-02ca7d29769d\', \'multiverseId\': 132259}, \'multiverseid\': 132259}]', '[{\'name\': \'Goblin-Luftfechter\', \'text\': \'Opfere den Goblin-Luftfechter: Der Goblin-Luftfechter fügt einer fliegenden Kreatur deiner Wahl 2 Schadenspunkte zu. Diese Kreatur verliert Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Goblin, Krieger\', \'flavor\': \'Er lässt seine Höhenangst an allem aus, was sich über seinem Kopf befindet.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132955&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'71cb8fe0-b7b3-4f95-832c-3d2e154ef831\', \'multiverseId\': 132955}, \'multiverseid\': 132955}, {\'name\': \'Cortacielo trasgo\', \'text\': \'Sacrificar el Cortacielo trasgo: El Cortacielo trasgo hace 2 puntos de daño a la criatura objetivo con la habilidad de volar. Esa criatura pierde la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Guerrero trasgo\', \'flavor\': \'Quita su miedo a las alturas de cualquier cosa mayor que su cabeza.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134460&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'b2c7dda3-217b-4745-a6d8-f598d4b083ea\', \'multiverseId\': 134460}, \'multiverseid\': 134460}, {\'name\': \'Coupeciel gobelin\', \'text\': "Sacrifiez le Coupeciel gobelin : Le Coupeciel gobelin inflige 2 blessures à la créature avec le vol ciblée. Cette créature perd le vol jusqu\'à la fin du tour.", \'type\': \'Créature : gobelin et guerrier\', \'flavor\': "Il fait payer sa peur de l\'altitude à tous ceux qui lui passent au-dessus de la tête.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132654&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c0edfea6-5514-4d8a-a911-abf90f092cb7\', \'multiverseId\': 132654}, \'multiverseid\': 132654}, {\'name\': \'Goblin Fendicielo\', \'text\': \'Sacrifica il Goblin Fendicielo: Il Goblin Fendicielo infligge 2 danni a una creatura bersaglio con volare. Quella creatura perde volare fino alla fine del turno.\', \'type\': \'Creatura — Guerriero Goblin\', \'flavor\': "Sfoga la sua paura dell\'altezza su qualunque cosa sia sopra la sua testa.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133256&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f1fdafab-9fd0-4fcd-9198-82d5d2f32555\', \'multiverseId\': 133256}, \'multiverseid\': 133256}, {\'name\': \'ゴブリンの空切り\', \'text\': \'ゴブリンの空切りを生け贄に捧げる：飛行を持つクリーチャー１体を対象とする。ゴブリンの空切りはそれに２点のダメージを与える。 そのクリーチャーはターン終了時まで飛行を失う。\', \'type\': \'クリーチャー — ゴブリン・戦士\', \'flavor\': \'彼は自分の高所恐怖症を、頭上のあらゆる物に叩きつける。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133557&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'784d7cbe-f31d-46f1-aa23-7766795f1adf\', \'multiverseId\': 133557}, \'multiverseid\': 133557}, {\'name\': \'Goblin Corta-Céu\', \'text\': \'Sacrifique Goblin Corta-Céu: Goblin Corta-Céu causa 2 pontos de dano à criatura alvo com a habilidade de voar. Aquela criatura perde a habilidade de voar até o final do turno.\', \'type\': \'Criatura — Guerreiro Goblin\', \'flavor\': \'Ele vence seu medo de alturas através de qualquer coisa acima de sua cabeça.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133858&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'e7f175c1-2ee1-43f5-a756-98f9e97f35ca\', \'multiverseId\': 133858}, \'multiverseid\': 133858}, {\'name\': \'Гоблин Зенитчик\', \'text\': \'Пожертвуйте Гоблина Зенитчика: Гоблин Зенитчик наносит 2 повреждения целевому существу с полетом. Это существо теряет полет до конца хода.\', \'type\': \'Существо — Гоблин Воин\', \'flavor\': \'Он бросает свою боязнь высоты во все, что летит над его головой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134159&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e4ab6e04-2db0-421e-8faa-3877fd40d04b\', \'multiverseId\': 134159}, \'multiverseid\': 134159}, {\'name\': \'灭空精灵\', \'text\': \'牺牲灭空精灵：灭空精灵对目标具飞行异能的生物造成2点伤害。 该生物失去飞行异能直到回合结束。\', \'type\': \'生物～精灵／战士\', \'flavor\': \'他把自己的惧高症发泄在任何飞过头顶的东西。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132353&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5ca19f6e-4956-408c-a26d-7a7688694536\', \'multiverseId\': 132353}, \'multiverseid\': 132353}]', '[{\'name\': \'Grubenhüter\', \'text\': \'Wenn der Grubenhüter ins Spiel kommt, darfst du eine Kreaturenkarte deiner Wahl aus deinem Friedhof auf deine Hand zurückbringen, falls du vier oder mehr Kreaturenkarten in deinem Friedhof hast.\', \'type\': \'Kreatur — Mensch, Zauberer\', \'flavor\': \'„Die Untoten wurden nicht erweckt. Sie werden rausgeworfen, wenn in der Grube kein Platz mehr für neue Leichen ist."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133037&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dd2ca276-bf14-424c-9a20-9cbc3c171ccc\', \'multiverseId\': 133037}, \'multiverseid\': 133037}, {\'name\': \'Guardián del abismo\', \'text\': \'Cuando el Guardián del abismo entre en juego, si tienes cuatro o más criaturas en tu cementerio, puedes regresar una carta de criatura objetivo de tu cementerio a tu mano.\', \'type\': \'Criatura — Hechicero humano\', \'flavor\': \'"Los muertos vivientes no son \\\'despertados\\\'. Son desalojados cuando ya no hay más lugar en el abismo para más cuerpos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134542&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ee475bc-a2ac-4016-87b1-315d23dc091f\', \'multiverseId\': 134542}, \'multiverseid\': 134542}, {\'name\': \'Gardien de la fosse\', \'text\': \'Quand le Gardien de la fosse arrive en jeu, si vous avez au moins quatre cartes de créature dans votre cimetière, vous pouvez renvoyer une carte de créature ciblée depuis votre cimetière dans votre main.\', \'type\': \'Créature : humain et sorcier\', \'flavor\': "« Les morts-vivants ne sont pas \'ramenés à la vie.\' Ils sont expulsés de la fosse quand il n\'y a plus de place pour des cadavres. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132736&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'611c6e60-79aa-41c4-8513-5d0f31f7f50d\', \'multiverseId\': 132736}, \'multiverseid\': 132736}, {\'name\': "Custode dell\'Abisso", \'text\': "Quando il Custode dell\'Abisso entra in gioco, se hai quattro o più carte creatura nel tuo cimitero, puoi riprendere in mano una carta creatura bersaglio dal tuo cimitero.", \'type\': \'Creatura — Mago Umano\', \'flavor\': \'"I non morti non sono \\\'risvegliati.\\\' Vengono sfrattati quando non rimane più posto per altri corpi nell\\\'abisso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133338&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7ff67913-22ed-4e61-93f5-f5465cbb787b\', \'multiverseId\': 133338}, \'multiverseid\': 133338}, {\'name\': \'奈落の守り手\', \'text\': \'奈落の守り手が場に出たとき、あなたの墓地に４枚以上のクリーチャー・カードがある場合、あなたの墓地にあるクリーチャー・カード１枚を対象とし、それをあなたの手札に戻してもよい。\', \'type\': \'クリーチャー — 人間・ウィザード\', \'flavor\': \'アンデッドは「目覚めさせられた」わけではない。奈落に死体が増えすぎて、居場所が無くなり追い出されたのだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133639&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'72469fe0-12a7-4b75-b340-1ad26198c0ee\', \'multiverseId\': 133639}, \'multiverseid\': 133639}, {\'name\': \'Guardião de Sepultura\', \'text\': \'Quando Guardião de Sepultura entrar em jogo, se você tiver quatro ou mais cards de criatura em seu cemitério, poderá devolver o card de criatura alvo de seu cemitério para sua mão.\', \'type\': \'Criatura — Mago Humano\', \'flavor\': \'"Os morto-vivos não estão \\\'despertados\\\'. Eles são despejados quando não há mais lugar na sepultura para mais corpos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133940&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'cd8cc4a7-32e0-4368-aee7-a6e9c746be2a\', \'multiverseId\': 133940}, \'multiverseid\': 133940}, {\'name\': \'Хранитель Ямы\', \'text\': \'Когда Хранитель Ямы входит в игру, если в вашем кладбище есть четыре или более карт существ, вы можете вернуть целевую карту существа из вашего кладбища в вашу руку.\', \'type\': \'Существо — Человек Чародей\', \'flavor\': \'«Мертвецы не пробуждаются. Они выселяются, когда в Пите больше нет места для новых тел».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134241&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'971a53f1-4ec7-46fe-a164-aa8f8ea44351\', \'multiverseId\': 134241}, \'multiverseid\': 134241}, {\'name\': \'暗渊门卫\', \'text\': \'当暗渊门卫进场时，若你的坟墓场中有四张或更多生物牌，则你可以将目标生物牌从你的坟墓场移回你手上。\', \'type\': \'生物～人类／法术师\', \'flavor\': \'「不死生物并非给『唤醒』。它们是因暗渊挤不下新尸体而被赶出来的。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132435&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'1cf46461-38cf-43ae-a587-23bef67df256\', \'multiverseId\': 132435}, \'multiverseid\': 132435}]', "[{'name': 'Größeres Gargadon', 'text': 'Aussetzen 10 {R}\\nOpfere ein Artefakt, eine Kreatur oder ein Land: Entferne eine Zeitmarke vom Größeren Gargadon. Spiele diese Fähigkeit nur, falls das Größere Gargadon ausgesetzt ist.', 'type': 'Kreatur — Bestie', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132958&type=card', 'language': 'German', 'identifiers': {'scryfallId': '19cbcafa-8719-49fc-a692-1d9ab58157c9', 'multiverseId': 132958}, 'multiverseid': 132958}, {'name': 'Gigantodón superior', 'text': 'Suspender 10—{R}.\\nSacrificar un artefacto, criatura o tierra: Remueve un contador de tiempo del Gigantodón superior. Juega esta habilidad sólo si el Gigantodón superior está suspendido.', 'type': 'Criatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134463&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '040773dc-0b9d-4203-9f00-c5b5555152ce', 'multiverseId': 134463}, 'multiverseid': 134463}, {'name': 'Grand gargadon', 'text': 'Suspension 10 — {R}\\nSacrifiez un artefact, une créature ou un terrain : Retirez un marqueur « temps » du Grand gargadon. Ne jouez cette capacité que si le Grand gargadon est en suspension.', 'type': 'Créature : bête', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132657&type=card', 'language': 'French', 'identifiers': {'scryfallId': '287d5575-c29d-4e5d-a26f-1f0de4ad396d', 'multiverseId': 132657}, 'multiverseid': 132657}, {'name': 'Gargadonte Maggiore', 'text': 'Sospendere 10—{R}\\nSacrifica un artefatto, una creatura o una terra: Rimuovi un segnalino tempo dal Gargadonte Maggiore. Gioca questa abilità solo se il Gargadonte Maggiore è sospeso.', 'type': 'Creatura — Bestia', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133259&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': 'b0e21972-90c4-4542-b7af-d76526f17ac8', 'multiverseId': 133259}, 'multiverseid': 133259}, {'name': '大いなるガルガドン', 'text': '待機 10―{R}\\nアーティファクト１つかクリーチャー１体か土地１つを生け贄に捧げる：大いなるガルガドンから時間カウンターを１個取り除く。 この能力は、大いなるガルガドンが待機状態である場合にのみプレイできる。', 'type': 'クリーチャー — ビースト', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133560&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'c8543f68-43a3-4a18-af59-52bfacaf28ad', 'multiverseId': 133560}, 'multiverseid': 133560}, {'name': 'Gargadonte Maior', 'text': 'Suspender 10—{R}\\nSacrifique um artefato, uma criatura ou um terreno: Remova um marcador temporal de Gargadonte Maior. Use esta habilidade somente se Gargadonte Maior estiver suspenso.', 'type': 'Criatura — Besta', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133861&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8ae92dbd-8bd5-4e63-ae39-21617b7894ba', 'multiverseId': 133861}, 'multiverseid': 133861}, {'name': 'Великий Гаргадон', 'text': 'Отсрочка 10—{R}\\nПожертвуйте артефакт, существо или землю: Снимите временной жетон с Великого Гаргадона. Играйте эту способность только тогда, когда Великий Гаргадон отсрочен.', 'type': 'Существо — Зверь', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134162&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '5e05f983-36af-4c29-b135-51fdd0c6874d', 'multiverseId': 134162}, 'multiverseid': 134162}, {'name': '高大乳齿巨象', 'text': '延缓10～{R}\\n牺牲一个神器，生物或地：从高大乳齿巨象上移去一个计时指示物。 只可以于高大乳齿巨象已延缓时使用此异能。', 'type': '生物～野兽', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132356&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '9c42d4ac-706d-4d61-8cd4-38baf7c98db3', 'multiverseId': 132356}, 'multiverseid': 132356}]", '[{\'name\': \'Gründliches Überdenken\', \'text\': \'Ziehe eine Karte.\\nRückblende {2}{U} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Gute Bücher sollte man von vorne nach hinten und dann noch einmal rückwärts oder spiegelverkehrt lesen." —Ettovard, Tolarianischer Archivar\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133117&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'852a81f0-f88f-4153-810d-bb40c5efd0f3\', \'multiverseId\': 133117}, \'multiverseid\': 133117}, {\'name\': \'Pensar dos veces\', \'text\': \'Roba una carta.\\nRetrospectiva {2}{U} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¡Los grandes libros están para ser leídos, y luego releídos hacia atrás o de cabeza" —Éttovard, archivista tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134622&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d2b19433-284d-4a1b-9882-fc41e8ecc3b2\', \'multiverseId\': 134622}, \'multiverseid\': 134622}, {\'name\': \'Réfléchir à deux fois\', \'text\': \'Piochez une carte.\\nFlashback {2}{U} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)\', \'type\': \'Éphémère\', \'flavor\': "« Les grands livres doivent être lus, puis relus en commençant par la fin et à l\'envers » —Ettovard, archiviste tolarian", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132816&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'5fb5219a-2705-4894-92b3-75c35068212c\', \'multiverseId\': 132816}, \'multiverseid\': 132816}, {\'name\': \'Pensarci Due Volte\', \'text\': \'Pesca una carta.\\nFlashback {2}{U} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': \'"I grandi libri sono fatti per essere letti, poi riletti dal fondo o alla rovescia" —Ettovard, archivista di Tolaria\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133418&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f2cd1aed-e5b2-4922-852f-28f9b1c7b0c8\', \'multiverseId\': 133418}, \'multiverseid\': 133418}, {\'name\': \'熟慮\', \'text\': \'カードを１枚引く。\\nフラッシュバック {2}{U} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'インスタント\', \'flavor\': \'偉大なる書は読まれるため、そしてさらに逆からや逆さまに読まれるように作られているのだ！ ――トレイリアの文書管理人、エトヴァード\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133719&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'273cb948-083e-414a-a856-59b018284afc\', \'multiverseId\': 133719}, \'multiverseid\': 133719}, {\'name\': \'Pensar Duas Vezes\', \'text\': \'Compre um card.\\nRecapitular {2}{U} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"Grandes livros são feitos para serem lidos, e então lidos novamente de trás para frente e de cabeça para baixo" —Ettovard, arquivista tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134020&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'78e28eef-d5b8-4705-94c4-52ccb4794621\', \'multiverseId\': 134020}, \'multiverseid\': 134020}, {\'name\': \'Дважды Подумай\', \'text\': \'Возьмите карту.\\nВоспоминание {2}{U} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Великие книги нужны, чтобы их читать, затем читать снова задом наперед и наоборот», Эттовард, Толарианский архивариус\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134321&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1416c83d-8ccb-448b-a33c-0043e6e3fcdb\', \'multiverseId\': 134321}, \'multiverseid\': 134321}, {\'name\': \'再次考虑\', \'text\': \'抓一张牌。\\n返照{2}{U}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'瞬间\', \'flavor\': \'「好书就该读，然后不论倒着反着都要再读一遍！」 ～陶拉里亚书库辖员艾托瓦\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132515&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c53c8f16-e47c-42aa-8f2a-c3e91d250936\', \'multiverseId\': 132515}, \'multiverseid\': 132515}]', '[{\'name\': \'Göttliche Versammlung\', \'text\': \'Du erhältst 2 Lebenspunkte für jede Kreatur, die ein Spieler deiner Wahl kontrolliert, dazu.\\nAussetzen 5 {1}{W} (Statt diese Karte aus deiner Hand zu spielen, kannst du {1}{W} bezahlen, sie ganz aus dem Spiel entfernen und fünf Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132907&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'88bc410b-cd44-48a0-8ee7-b6429c833b10\', \'multiverseId\': 132907}, \'multiverseid\': 132907}, {\'name\': \'Congregación divina\', \'text\': \'Ganas 2 vidas por cada criatura que controla el jugador objetivo.\\nSuspender 5—{1}{W} (En lugar de jugar esta carta de tu mano, puedes pagar {1}{W} y removerla del juego con cinco contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134412&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'6972a6a1-2c26-42f1-af1f-e8cef7ce598a\', \'multiverseId\': 134412}, \'multiverseid\': 134412}, {\'name\': \'Assemblée divine\', \'text\': \'Vous gagnez 2 points de vie pour chaque créature que le joueur ciblé contrôle.\\nSuspension 5 — {1}{W} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {1}{W} et la retirer de la partie avec cinq marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132606&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bca4ae0c-df50-4958-8de0-75dcaa204f5e\', \'multiverseId\': 132606}, \'multiverseid\': 132606}, {\'name\': \'Adunanza Divina\', \'text\': "Guadagni 2 punti vita per ogni creatura controllata da un giocatore bersaglio.\\nSospendere 5—{1}{W} (Invece di giocare questa carta dalla tua mano, puoi pagare {1}{W} e rimuoverla dal gioco con cinque segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133208&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8bd847de-e071-4e3f-8d32-b3329d8018a3\', \'multiverseId\': 133208}, \'multiverseid\': 133208}, {\'name\': \'神聖なる集い\', \'text\': \'プレイヤー１人を対象とする。あなたはそのプレイヤーがコントロールするクリーチャー１体につき２点のライフを得る。\\n待機 ５―{1}{W} （これをあなたの手札からプレイするのではなく、{1}{W}を支払ってゲームから取り除き、その上に時間カウンターを５個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133509&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e59fcd74-803c-4a30-a25f-ac01201230bf\', \'multiverseId\': 133509}, \'multiverseid\': 133509}, {\'name\': \'Congregação Divina\', \'text\': \'Você ganha 2 pontos de vida para cada criatura que o jogador alvo controla.\\nSuspender 5—{1}{W} (Em vez de jogar este card da sua mão, você pode pagar {1}{W} e removê-lo do jogo com cinco marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133810&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7ffae782-f61a-4b58-b327-1f5e281dc4f4\', \'multiverseId\': 133810}, \'multiverseid\': 133810}, {\'name\': \'Божественная Встреча\', \'text\': \'Вы получаете 2 жизни за каждое существо под контролем целевого игрока.\\nОтсрочка 5—{1}{W} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {1}{W} и удалить ее из игры с пятью временными жетонами на ней. В начале вашего шага поддержки, удалите один временной жетон. Когда вы удалите последний, сыграйте эту карту без оплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134111&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'be230ad4-2894-4815-a01b-20bd411c65cf\', \'multiverseId\': 134111}, \'multiverseid\': 134111}, {\'name\': \'圣洁聚集\', \'text\': \'目标牌手每操控一个生物，你便获得2点生命。\\n延缓5～{1}{W}（除了从你手上使用此牌，你可以支付{1}{W}并将此牌移出对战，且上面有五个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132305&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b58710dc-307a-4143-a853-2ee2fc89b8d8\', \'multiverseId\': 132305}, \'multiverseid\': 132305}]', '[{\'name\': \'Haftzauber\', \'text\': \'Kreaturenverzauberung\\nDie aktivierten Fähigkeiten der verzauberten Kreatur können nicht gespielt werden.\\n{1}{W}: Lege den Haftzauber an eine Kreatur deiner Wahl an.\', \'type\': \'Verzauberung — Aura\', \'flavor\': \'Fessele lieber das Hirn als die Hand, dann stoppst du die Absicht, bevor es überhaupt zur Tat kommt.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132906&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'747d72ba-a603-4232-b83e-9ec414fb432e\', \'multiverseId\': 132906}, \'multiverseid\': 132906}, {\'name\': \'Hechizo de retención\', \'text\': \'Encantar criatura.\\nNo se pueden jugar las habilidades activadas de la criatura encantada.\\n{1}{W}: Anexa el Hechizo de retención a la criatura objetivo.\', \'type\': \'Encantamiento — Aura\', \'flavor\': \'Ata la mente en lugar de los brazos, y detendrás el intento de dañarte antes siquiera de que comience.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134411&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'72eb8b0b-7f69-480b-9529-7e6fee3a8910\', \'multiverseId\': 134411}, \'multiverseid\': 134411}, {\'name\': \'Sort de détention\', \'text\': \'Enchanter : créature\\nLes capacités activées de la créature enchantée ne peuvent pas être jouées.\\n{1}{W} : Attachez le Sort de détention à la créature ciblée.\', \'type\': \'Enchantement : aura\', \'flavor\': "Attachez l\'esprit plutôt que le poignet, et vous mettez fin à l\'intention de nuire avant qu\'elle ne germe.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132605&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'1fa14fd6-0a6a-4752-976a-dedbf10e1a47\', \'multiverseId\': 132605}, \'multiverseid\': 132605}, {\'name\': \'Magia di Detenzione\', \'text\': \'Incanta creatura\\nLe abilità attivate della creatura incantata non possono essere giocate.\\n{1}{W}: Assegna la Magia di Detenzione a una creatura bersaglio.\', \'type\': \'Incantesimo — Aura\', \'flavor\': "Lega la mente invece dei polsi, e blocchi l\'intenzione di ferire ancor prima che cominci.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133207&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'64490695-ab53-4723-a463-ce9728516ad0\', \'multiverseId\': 133207}, \'multiverseid\': 133207}, {\'name\': \'留置呪文\', \'text\': \'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーの起動型能力はプレイできない。\\n{1}{W}：クリーチャー１体を対象とし、留置呪文をそれにつける。\', \'type\': \'エンチャント — オーラ\', \'flavor\': \'手首ではなく思考を縛れば、傷つけようという意思が起こる前に止めることができる。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133508&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'093742f8-2022-4357-a336-0f334e70e2c0\', \'multiverseId\': 133508}, \'multiverseid\': 133508}, {\'name\': \'Mágica de Detenção\', \'text\': \'Encantar Criatura\\nAs habilidades ativadas da criatura encantada não podem ser utilizadas.\\n{1}{W}: Anexe Mágica de Detenção à criatura alvo.\', \'type\': \'Encantamento — Aura\', \'flavor\': \'Ate a mente em vez do pulso, e assim interrompa a intenção de fazer mal antes que esta tenha início.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133809&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'aa4304c4-aa6c-4fdd-8456-e0c38dc4314e\', \'multiverseId\': 133809}, \'multiverseid\': 133809}, {\'name\': \'Тюремное Заклятие\', \'text\': \'Зачаровать существо\\nАктивируемые способности зачарованного существа не могут быть сыграны.\\n{1}{W}: Присоедините Тюремное Заклятие к целевому существу.\', \'type\': \'Чары — Аура\', \'flavor\': \'Скуй разум вместо рук, и ты остановишь злые намерения еще до их появления.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134110&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e0e3faae-73a4-4900-b123-16e78ba77cf7\', \'multiverseId\': 134110}, \'multiverseid\': 134110}, {\'name\': \'拘留咒\', \'text\': \'生物结界\\n受此结界的生物之起动式异能都不能使用。\\n{1}{W}：将拘留咒结附在目标生物上。\', \'type\': \'结界～灵气\', \'flavor\': \'与其束缚拳头，不如束缚心灵，好让你不再有伤人念头。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132304&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'3301303f-23b0-4253-afd5-9578b1ff3db3\', \'multiverseId\': 132304}, \'multiverseid\': 132304}]', '[{\'name\': \'Halbschatten-Spinne\', \'text\': \'Die Halbschatten-Spinne kann blocken, als ob sie Flugfähigkeit hätte.\\nWenn die Halbschatten-Spinne aus dem Spiel auf den Friedhof gelegt wird, bringe einen 2/4 schwarzen Spinnenspielstein ins Spiel, der blocken kann, als ob er Flugfähigkeit hätte.\', \'type\': \'Kreatur — Spinne\', \'flavor\': \'Als sie einen vorbeihuschenden Wolpertinger in ihrem Netz fing, verdoppelte und verdunkelte ihre Seele.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133033&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'76a8c4e2-dfbd-4ea3-b7ec-cf146f0d6631\', \'multiverseId\': 133033}, \'multiverseid\': 133033}, {\'name\': \'Araña Penumbra\', \'text\': \'La Araña Penumbra puede bloquear como si tuviera la habilidad de volar.\\nCuando la Araña Penumbra vaya a un cementerio desde el juego, pon en juego una ficha de criatura Araña negra 2/4 que puede bloquear como si tuviera la habilidad de volar.\', \'type\': \'Criatura — Araña\', \'flavor\': \'Cuando atrapó una cocatriz pasajera, su propia alma oscura se duplicó.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134538&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1ccf8df9-67f6-432d-84f1-1637bfa256ee\', \'multiverseId\': 134538}, \'multiverseid\': 134538}, {\'name\': \'Araignée de la pénombre\', \'text\': "L\'Araignée de la pénombre peut bloquer comme si elle avait le vol.\\nQuand l\'Araignée de la pénombre est mise dans un cimetière depuis le jeu, mettez en jeu un jeton de créature 2/4 noire Araignée qui peut bloquer comme si elle avait le vol.", \'type\': \'Créature : araignée\', \'flavor\': \'Quand elle attrapait un cocatrix dans sa toile, son âme noire doublait de taille.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132732&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'d68e7f57-8260-4742-a0d9-df2fc4c26617\', \'multiverseId\': 132732}, \'multiverseid\': 132732}, {\'name\': \'Ragno della Penombra\', \'text\': \'Il Ragno della Penombra può bloccare come se avesse volare.\\nQuando il Ragno della Penombra viene messo in un cimitero dal gioco, metti in gioco una pedina creatura Ragno 2/4 nera che può bloccare come se avesse volare.\', \'type\': \'Creatura — Ragno\', \'flavor\': \'Quando intrappolò una coccatrice di passaggio, la sua stessa anima si raddoppiò tetramente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133334&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c3628369-3b38-493e-8cf0-041e9ce19bb2\', \'multiverseId\': 133334}, \'multiverseid\': 133334}, {\'name\': \'暗影の蜘蛛\', \'text\': \'暗影の蜘蛛は飛行を持っているかのようにブロックできる。\\n暗影の蜘蛛が場からいずれかの墓地に置かれたとき、飛行を持っているかのようにブロックに参加できる黒の２/４の蜘蛛クリーチャー・トークンを１体場に出す。\', \'type\': \'クリーチャー — 蜘蛛\', \'flavor\': \'通り過ぎるコカトリスを絡め取ったとき、その魂は暗い魂を産んだ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133635&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'50edd54d-5f6d-4cb7-adda-923b3cbf0c6b\', \'multiverseId\': 133635}, \'multiverseid\': 133635}, {\'name\': \'Aranha da Penumbra\', \'text\': \'Aranha da Penumbra pode bloquear como se tivesse a habilidade de voar.\\nQuando Aranha da Penumbra for colocada no cemitério vinda do jogo, coloque em jogo uma ficha de criatura preta 2/4 do tipo Aranha que pode bloquear como se tivesse a habilidade de voar.\', \'type\': \'Criatura — Aranha\', \'flavor\': \'Quando capturou uma cocatriz de passagem, sua própria alma duplicou-se sombriamente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133936&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ab11e1bb-3cfa-4612-a345-82d5cee67704\', \'multiverseId\': 133936}, \'multiverseid\': 133936}, {\'name\': \'Паук Пенумбра\', \'text\': \'Паук Пенумбра может блокировать как будто он имеет Полет.\\nКогда Паук Пенумбра попадает на кладбище из игры, положите фишку существа 2/4 черный Паук в игру, которая может блокировать как будто она имеет Полет.\', \'type\': \'Существо — Паук\', \'flavor\': \'Когда он ловит проходящих василисков, его собственная душа темнеет и удваивается.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134237&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d1de3bda-1fa0-4c3b-a878-c8709ff3026e\', \'multiverseId\': 134237}, \'multiverseid\': 134237}, {\'name\': \'罔两蜘蛛\', \'text\': \'罔两蜘蛛能视同具有飞行异能地进行阻挡。\\n当罔两蜘蛛从场上置入坟墓场时，将一个2/4黑色，能视同具有飞行异能地进行阻挡的蜘蛛衍生物放置进场。\', \'type\': \'生物～蜘蛛\', \'flavor\': \'当他瞪着飞过头顶的石化鸡蛇时，其另一个灵魂从暗地冒出。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132431&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b068f969-43eb-4342-86aa-62c5a5a3bb46\', \'multiverseId\': 132431}, \'multiverseid\': 132431}]', '[{\'name\': \'Handschuh der Kraft\', \'text\': \'Sowie der Handschuh der Kraft ins Spiel kommt, bestimme eine Farbe.\\nKreaturen der bestimmten Farbe erhalten +1/+1.\\nImmer wenn ein Standardland für Mana der bestimmten Farbe getappt wird, erhöht sein Beherrscher seinen Manavorrat um ein Mana dieser Farbe.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132948&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'78ff5e53-92c7-41e7-ac26-b50cf0079cd7\', \'multiverseId\': 132948}, \'multiverseid\': 132948}, {\'name\': \'Guantelete de poder\', \'text\': \'En cuanto el Guantelete de poder entre en juego, elige un color.\\nLas criaturas del color elegido obtienen +1/+1.\\nSiempre que se gira una tierra básica para obtener maná del color elegido, su controlador agrega un maná de ese color a su reserva de maná.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134453&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d5a0027c-ef51-4995-bec4-356b1b5f52f2\', \'multiverseId\': 134453}, \'multiverseid\': 134453}, {\'name\': \'Gantelet de pouvoir\', \'text\': "Au moment où le gantelet de pouvoir arrive en jeu, choisissez une couleur.\\nLes créatures de la couleur choisie gagnent +1/+1.\\nÀ chaque fois qu\'un terrain de base est engagé pour du mana de la couleur choisie, son contrôleur ajoute un mana de cette couleur à sa réserve.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132647&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'8065ad71-89e3-407d-91e9-c583fc9cf8d6\', \'multiverseId\': 132647}, \'multiverseid\': 132647}, {\'name\': \'Guanto del Potere\', \'text\': \'Mentre il Guanto del Potere entra in gioco, scegli un colore.\\nLe creature del colore scelto prendono +1/+1.\\nOgniqualvolta una terra base viene TAPpata per attingere mana del colore scelto, il suo controllore aggiunge un mana di quel colore alla propria riserva di mana.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133249&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'f7c0938c-9164-4ec2-8fc4-397786c13791\', \'multiverseId\': 133249}, \'multiverseid\': 133249}, {\'name\': \'魔力の篭手\', \'text\': \'魔力の篭手が場に出るに際し、色を１色選ぶ。\\n選ばれた色のクリーチャーは＋１/＋１の修整を受ける。\\nいずれかの基本土地が選ばれた色のマナを生み出す目的でタップされるたび、それのコントローラーはその色のマナ１点を自分のマナ・プールに加える。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133550&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'fe18f70b-a781-43ff-bea1-555e58714247\', \'multiverseId\': 133550}, \'multiverseid\': 133550}, {\'name\': \'Manoplas do Poder\', \'text\': \'Conforme Manoplas do Poder entra em jogo, escolha uma cor.\\nAs criaturas da cor escolhida recebem +1/+1.\\nToda vez que um terreno básico for virado para gerar mana da cor escolhida, seu controlador adicionará um mana daquela cor à sua própria reserva de mana.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133851&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6055537f-c0b3-4470-b3fc-29b65b4ef658\', \'multiverseId\': 133851}, \'multiverseid\': 133851}, {\'name\': \'Перчатка Силы\', \'text\': \'При входе Перчаток Силы в игру выберите цвет.\\nСущества выбранного цвета получают +1/+1.\\nКогда базовая земля поворачивается для получения маны выбранного цвета, контролирующий ее игрок добавляет одну ману этого же цвета в свое хранилище маны.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134152&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'1a6fa3e3-62ef-466c-ba96-64743d5a1eb4\', \'multiverseId\': 134152}, \'multiverseid\': 134152}, {\'name\': \'力量护手\', \'text\': \'于力量护手进场时，选择一种颜色。\\n该色的生物得+1/+1。\\n每当一个基本地横置以产生该色的法术力时，其操控者加一点该色的法术力到他的法术力池中。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132346&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'12af603d-1ca6-402b-9ac6-af9532e5d8cf\', \'multiverseId\': 132346}, \'multiverseid\': 132346}]', '[{\'name\': \'Harmonieremasuri\', \'text\': \'Alle Remasuris haben „Wenn diese Kreatur ins Spiel kommt, zerstöre ein Artefakt oder eine Verzauberung deiner Wahl."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Seitdem der neue Remasuri zum Schwarm dazugestoßen ist, zerfallen auch unsere mächtigsten Artefakte in Stücke, wenn wir sie gegen den Schwarm anwenden." —Llanach, Wolkenwaldläufer\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132963&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'d978d394-fcac-432d-b288-087916bbd5a5\', \'multiverseId\': 132963}, \'multiverseid\': 132963}, {\'name\': \'Fragmentado armónico\', \'text\': \'Todos los Fragmentados tienen "Cuando esta criatura entre en juego, destruye el artefacto o encantamiento objetivo".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Desde que llegó el último fragmentado, incluso nuestras más poderosas reliquias se rompen en pedazos tan pronto como las usamos contra la colmena." —Llánach, explorador de Veloceleste\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134468&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'95cca800-8ec8-4145-8ef9-c73c91daebb0\', \'multiverseId\': 134468}, \'multiverseid\': 134468}, {\'name\': \'Slivoïde harmonique\', \'text\': "Toutes les slivoïdes ont « Quand cette créature arrive en jeu, détruisez l\'artefact ou l\'enchantement ciblé. »", \'type\': \'Créature : slivoïde\', \'flavor\': "« Depuis l\'arrivée du dernier slivoïde, même nos reliques les plus puissantes éclatent dès qu\'on les approche de l\'essaim. » —Llanach, ranger de Linciel", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132662&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'dc57ccb9-efaf-48c0-8b92-529809c6804d\', \'multiverseId\': 132662}, \'multiverseid\': 132662}, {\'name\': \'Tramutante Armonico\', \'text\': \'Tutti i Tramutanti hanno "Quando questa creatura entra in gioco, distruggi un artefatto o un incantesimo bersaglio."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Da quando è arrivato l\\\'ultimo tramutante, anche i nostri cimeli più possenti si frantumano non appena li usiamo contro l\\\'alveare." —Llanach, Ranger di Cielsudario\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133264&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'c55a29f4-c261-42ac-9e93-722588ec995d\', \'multiverseId\': 133264}, \'multiverseid\': 133264}, {\'name\': \'調和スリヴァー\', \'text\': \'すべてのスリヴァーは「このクリーチャーが場に出たとき、アーティファクト１つかエンチャント１つを対象とし、それを破壊する。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'一番新しいスリヴァーが現れてから、どんな最強の遺物を巣にもっていっても、すぐに粉々に砕かれちまうんだ。 ――スカイシュラウドのレインジャー、ラナック\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133565&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1f2a3ee1-eb11-4f40-9f48-0792f9e22c37\', \'multiverseId\': 133565}, \'multiverseid\': 133565}, {\'name\': \'Fractius Harmônico\', \'text\': \'Todos os Fractius têm "Quando esta criatura entrar em jogo, destrua o artefato alvo ou o encantamento alvo."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Desde que o último fractius chegou, até mesmo nossas relíquias mais poderosas se estilhaçam em cacos assim que as trazemos à colônia." —Llanach, patrulheiro de Skyshroud\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133866&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c79e74c5-77ac-4ac4-9197-14ec91639c3a\', \'multiverseId\': 133866}, \'multiverseid\': 133866}, {\'name\': \'Гармоническая Щепка\', \'text\': \'Все Щепки обладают способностью "Когда это существо входит в игру, разрушьте целевой артефакт или чары."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«После прибытия последней щепки даже самые мощние наши реликты были разрушены в тот миг, когда мы повернули их против роя», Ланах, Скайшраудский егерь\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134167&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce151f57-0f6b-43dd-97f2-2d669c4d8b5d\', \'multiverseId\': 134167}, \'multiverseid\': 134167}, {\'name\': \'泛音裂片妖\', \'text\': \'所有裂片妖具有「当此生物进场时，消灭目标神器或结界。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「自从最后一种裂片妖加入战团后，我们用来对抗母巢的强力遗物才刚启用便应声碎裂。」 ～天帷护林兵拉纳可\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132361&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ec648060-c069-49d4-97bb-6d66782be47f\', \'multiverseId\': 132361}, \'multiverseid\': 132361}]', '[{\'name\': \'Hartholz-Beschwörung\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nEine Kreatur deiner Wahl erhält +5/+5 bis zum Ende des Zuges und kann in diesem Zug nicht das Ziel von Zaubersprüchen und Fähigkeiten sein.\', \'type\': \'Spontanzauber\', \'flavor\': \'„Die Kraft von altem Holz und Stein fahre in Geist, Fleisch und Gebein."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133089&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'241f52ec-49be-4158-b3d9-075430d7d55d\', \'multiverseId\': 133089}, \'multiverseid\': 133089}, {\'name\': \'Invocación de maderapiedra\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nLa criatura objetivo obtiene +5/+5 hasta el final del turno y no puede ser objetivo de hechizos o habilidades este turno.\', \'type\': \'Instantáneo\', \'flavor\': \'"Poder de la antigua madera y piedra, convertido en espíritu, carne y hueso."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134594&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'c45c7106-8b75-4837-bfc7-502c65529a71\', \'multiverseId\': 134594}, \'multiverseid\': 134594}, {\'name\': \'Invocation de pierrebois\', \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nLa créature ciblée gagne +5/+5 jusqu\'à la fin du tour et ne peut pas être la cible de sorts ou de capacités ce tour-ci.", \'type\': \'Éphémère\', \'flavor\': \'« Puissance vénérable du bois et de la pierre, Pénètre esprit, os et chair. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132788&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3ea81149-d85f-4f8b-a381-2fd5865c4df0\', \'multiverseId\': 132788}, \'multiverseid\': 132788}, {\'name\': \'Evocazione di Boscopietra\', \'text\': \'Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nUna creatura bersaglio prende +5/+5 fino alla fine del turno e non può essere bersaglio di magie o abilità in questo turno.\', \'type\': \'Istantaneo\', \'flavor\': \'"Di pietra e legno antico la potenza, Infusa nella carne, nelle ossa e nell\\\'essenza."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133390&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'dcbd5b85-17b5-402b-9450-f62a97191838\', \'multiverseId\': 133390}, \'multiverseid\': 133390}, {\'name\': \'岩石樹の祈り\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\nクリーチャー１体を対象とする。それはターン終了時まで＋５/＋５の修整を受けるとともに、このターン呪文や能力の対象にならない。\', \'type\': \'インスタント\', \'flavor\': \'古樹と古石との力よ来たれ、 心と肉と骨とに宿れ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133691&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'69f52e0b-5246-4e37-bb49-102acfc12f3e\', \'multiverseId\': 133691}, \'multiverseid\': 133691}, {\'name\': \'Invocação da Selva de Pedras\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nA criatura alvo recebe +5/+5 até o final do turno e não pode ser alvo de mágicas nem de habilidades neste turno.\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"O poder da madeira e da pedra primordiais, No espírito, na carne e nos ossos."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133992&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fe314dac-1cd4-40a6-8e73-67c8e43758be\', \'multiverseId\': 133992}, \'multiverseid\': 133992}, {\'name\': \'Стоунвудская Мольба\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nЦелевое существо получает +5/+5 до конца хода и не может быть целью заклинаний и способностей на этом ходу.\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Мощь древнего древа и камня, Войди в дух, плоть и кость».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134293&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fffefcf3-b116-41ad-806f-2e2b450c3ec0\', \'multiverseId\': 134293}, \'multiverseid\': 134293}, {\'name\': \'坚木祝愿\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n本回合中，目标生物得+5/+5且不能成为咒语或异能的目标。\', \'type\': \'瞬间\', \'flavor\': \'「古木巨岩瀚力， 尽入心身骨底。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132487&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f69667d9-660d-4483-8e85-116b85ae2965\', \'multiverseId\': 132487}, \'multiverseid\': 132487}]', '[{\'name\': \'Havenwood-Wurm\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nVerursacht Trampelschaden\', \'type\': \'Kreatur — Wurm\', \'flavor\': \'Durch Risse im Zeitgefüge geraten immer wieder grabende Bestien aus alten Zeiten in die harte und trockene Erde der Gegenwart. Die meisten bleiben stecken und sterben, aber einige arbeiten sich bis an die Oberfläche vor.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132965&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'e3142613-321b-4d2e-87a2-e8994ad688cc\', \'multiverseId\': 132965}, \'multiverseid\': 132965}, {\'name\': \'Sierpe de Havenwood\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nArrolla.\', \'type\': \'Criatura — Sierpe\', \'flavor\': \'Las brechas temporales trajeron bestias de túneles de antaño a la dura y seca tierra del presente. La mayoría murió allí, atrapada, pero las más poderosas se abrieron paso a la superficie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134470&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d7e22b93-6399-47eb-bc36-74a703b7742c\', \'multiverseId\': 134470}, \'multiverseid\': 134470}, {\'name\': "Guivre d\'Havrebois", \'text\': \'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nPiétinement\', \'type\': \'Créature : guivre\', \'flavor\': "Les failles temporelles déposent les créatures fouisseuses d\'hier dans la terre dure et desséchée du présent. La plupart y meurent, prises au piège, mais les plus puissantes jaillissent à la surface.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132664&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'b91a277c-a0a7-4b3e-8238-c94427a0291c\', \'multiverseId\': 132664}, \'multiverseid\': 132664}, {\'name\': \'Wurm di Havenwood\', \'text\': \'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nTravolgere\', \'type\': \'Creatura — Wurm\', \'flavor\': \'Gli squarci temporali portano bestie antiche a scavare tunnel nella dura terra riarsa del presente. Molti muoiono lì, intrappolati, ma i più potenti irrompono in superficie.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133266&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'081e1280-cb96-44c1-946a-f3cae2ccc11b\', \'multiverseId\': 133266}, \'multiverseid\': 133266}, {\'name\': \'ヘイヴンウッドのワーム\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\nトランプル\', \'type\': \'クリーチャー — ワーム\', \'flavor\': \'時の裂け目は、かつての穴掘りの猛獣を、現在の固く乾いた地へと導いた。 ほとんどはそこにはまって死んだが、最強のものは地表をぶち破っていった。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133567&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'4b32bcea-d20d-4525-bced-4bd0fcf46cdd\', \'multiverseId\': 133567}, \'multiverseid\': 133567}, {\'name\': \'Vorme de Havenwood\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nAtropelar\', \'type\': \'Criatura — Vorme\', \'flavor\': \'As fendas do tempo trazem bestas de túneis antigos para as terras áridas e rudes do presente. A maioria morre por lá, encurralada, mas os mais fortes atravessam a superfície.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133868&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'b39742b5-39ba-4747-a52b-79af394f1263\', \'multiverseId\': 133868}, \'multiverseid\': 133868}, {\'name\': \'Хейвенвудский Червь\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nПробивной Удар\', \'type\': \'Существо — Вурм\', \'flavor\': \'Временные разломы приводят роющих бестий прошлого в твердые и сухие земли настоящего. Большинство погибает, попадает в ловушки, но наисильнейшие прорываются через поверхность.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134169&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'aaef2a08-1da7-471a-a0fb-d1fda0c78fa5\', \'multiverseId\': 134169}, \'multiverseid\': 134169}, {\'name\': \'海温森亚龙\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n践踏\', \'type\': \'生物～亚龙\', \'flavor\': \'时间裂缝将古代野兽拉到现代的硬厚枯干土壤中。 大多数不是死掉便是受困其间，只有最强力的才得以破土而出。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132363&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b4044ab0-136a-47d6-bad9-01da9dd16380\', \'multiverseId\': 132363}, \'multiverseid\': 132363}]', '[{\'name\': \'Herden-Gnarr\', \'text\': \'Immer wenn eine andere Kreatur unter deiner Kontrolle ins Spiel kommt, erhält der Herden-Gnarr +2/+2 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Bestie\', \'flavor\': \'Vor langer Zeit galt es als gutes Omen, einen einzelnen Gnarr zu erblicken. Nun jagen sie in der Herde, und es ist ein Zeichen drohender Gefahr, einen zu sehen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132966&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'af918489-b7ea-48ca-9a33-d095689ba809\', \'multiverseId\': 132966}, \'multiverseid\': 132966}, {\'name\': \'Gnarr de manada\', \'text\': \'Siempre que otra criatura entre en juego bajo tu control, el Gnarr de manada obtiene +2/+2 hasta el final del turno.\', \'type\': \'Criatura — Bestia\', \'flavor\': \'Hace tiempo, encontrar un gnarr solitario era una señal de buena suerte. Ahora se convirtieron en una manada de cazadores salvajes, una señal de peligro inminente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134471&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d0b7f2fe-dc5c-40e0-b446-8ce04f04045e\', \'multiverseId\': 134471}, \'multiverseid\': 134471}, {\'name\': \'Gnarr de troupeau\', \'text\': "À chaque fois qu\'une autre créature arrive en jeu sous votre contrôle, le Gnarr de troupeau gagne +2/+2 jusqu\'à la fin du tour.", \'type\': \'Créature : bête\', \'flavor\': \'Jadis, un gnarr solitaire était signe de chance. De nos jours, ils sont devenus des chasseurs de meute, signe de danger imminent.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132665&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'be9768b1-e54e-406d-867b-c6eca15e93ce\', \'multiverseId\': 132665}, \'multiverseid\': 132665}, {\'name\': \'Gnarr del Branco\', \'text\': "Ogniqualvolta un\'altra creatura entra in gioco sotto il tuo controllo, lo Gnarr del Branco prende +2/+2 fino alla fine del turno.", \'type\': \'Creatura — Bestia\', \'flavor\': \'Tanto tempo fa, lo gnarr solitario era un segno di buona fortuna. Ora sono diventati selvaggi cacciatori in branco, un segno di pericolo imminente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133267&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'8ea788e4-d5f6-446b-88f8-94e318dc74fd\', \'multiverseId\': 133267}, \'multiverseid\': 133267}, {\'name\': \'獣群のナール\', \'text\': \'他のクリーチャーがあなたのコントロール下で場に出るたび、獣群のナールはターン終了時まで＋２/＋２の修整を受ける。\', \'type\': \'クリーチャー — ビースト\', \'flavor\': \'遥か昔、ナールを一匹見かけることは幸運のしるしだった。 今ではそれは駆り立てる野生の群れとなり、差し迫った危険のしるしとなっている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133568&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'17db6bdf-0cff-4553-a42f-80fcda7211cb\', \'multiverseId\': 133568}, \'multiverseid\': 133568}, {\'name\': \'Gnarr de Manada\', \'text\': \'Toda vez que outra criatura entrar em jogo sob seu controle, Gnarr de Manada receberá +2/+2 até o final do turno.\', \'type\': \'Criatura — Besta\', \'flavor\': \'Há tempos atrás, um gnarr solitário era considerado um sinal de boa sorte. Hoje em dia, eles se tornaram caçadores selvagens, um sinal de perigo iminente.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133869&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6ac4f8a0-da58-464d-b437-dce3d185a475\', \'multiverseId\': 133869}, \'multiverseid\': 133869}, {\'name\': \'Стадный Гнарр\', \'text\': \'Когда другое существо вступает в игру под вашим контролем, Стадный Гнарр получает +2/+2 до конца хода.\', \'type\': \'Существо — Зверь\', \'flavor\': \'Давным-давно одинокий нар был знаком удачи. Теперь они превратились в дикие стада охотников, знак неминуемой опасности.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134170&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ca1d13a1-d358-44d3-ba05-2b720b6e7653\', \'multiverseId\': 134170}, \'multiverseid\': 134170}, {\'name\': \'结群嚎龙\', \'text\': \'每当另一个生物在你的操控下进场时，结群嚎龙得+2/+2直到回合结束。\', \'type\': \'生物～野兽\', \'flavor\': \'很久以前，独行的嚎龙曾被看作祥兆。 现在他们已是成群行猎的野物，象征了危难将至。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132364&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'16d4ac82-b724-439a-bfa1-c101d0572c6b\', \'multiverseId\': 132364}, \'multiverseid\': 132364}]', '[{\'name\': \'Herumstreifender Ritter\', \'text\': \'Flankenangriff (Immer wenn eine Kreatur ohne Flankenangriff diese Kreatur blockt, erhält die blockende Kreatur -1/-1 bis zum Ende des Zuges.)\\nImmer wenn der Herumstreifende Ritter das Ziel eines Zauberspruchs oder einer Fähigkeit wird, opfere ihn.\', \'type\': \'Kreatur — Zombie, Ritter\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133074&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b0fdff8e-1672-46fc-a96c-299f6e28f41d\', \'multiverseId\': 133074}, \'multiverseid\': 133074}, {\'name\': \'Caballero furtivo\', \'text\': \'Flanquea (Siempre que una criatura sin la habilidad de flanquear bloquee a esta criatura, la criatura bloqueadora obtiene -1/-1 hasta el final del turno.)\\nCuando el Caballero furtivo sea objetivo de un hechizo o habilidad, sacrifícalo.\', \'type\': \'Criatura — Caballero zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134579&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'d1e1f0be-406c-4a51-94e5-d476667237e1\', \'multiverseId\': 134579}, \'multiverseid\': 134579}, {\'name\': \'Chevalier indolent\', \'text\': "Débordement (À chaque fois qu\'une créature sans le débordement bloque cette créature, la créature bloqueuse gagne -1/-1 jusqu\'à la fin du tour.)\\nQuand le Chevalier indolent devient la cible d\'un sort ou d\'une capacité, sacrifiez-le.", \'type\': \'Créature : zombie et chevalier\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132773&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'56a408e0-4f37-45f2-b014-957a9231bd53\', \'multiverseId\': 132773}, \'multiverseid\': 132773}, {\'name\': \'Cavaliere Furtivo\', \'text\': "Aggirare (Ogniqualvolta una creatura senza aggirare blocca questa creatura, la creatura bloccante prende -1/-1 fino alla fine del turno.)\\nQuando il Cavaliere Furtivo diventa bersaglio di una magia o di un\'abilità, sacrificalo.", \'type\': \'Creatura — Cavaliere Zombie\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133375&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1a635553-fc0d-4e7a-b8c8-f520b3165b32\', \'multiverseId\': 133375}, \'multiverseid\': 133375}, {\'name\': \'卑屈な騎士\', \'text\': \'側面攻撃 （側面攻撃を持たないいずれかのクリーチャーがこのクリーチャーをブロックするたび、そのブロックしているクリーチャーはターン終了時まで－１/－１の修整を受ける。）\\n卑屈な騎士が呪文や能力の対象となったとき、それを生け贄に捧げる。\', \'type\': \'クリーチャー — ゾンビ・騎士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133676&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1ae2b31f-c20c-41f6-8a43-fd4b84ec0d0b\', \'multiverseId\': 133676}, \'multiverseid\': 133676}, {\'name\': \'Cavaleiro Tocaieiro\', \'text\': \'Flanquear (Toda vez que uma criatura sem flanquear bloquear esta criatura, a criatura bloqueadora receberá -1/-1 até o final do turno.)\\nQuando Cavaleiro Tocaieiro se tornar o alvo de uma mágica ou habilidade, sacrifique-o.\', \'type\': \'Criatura — Cavaleiro Zumbi\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133977&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'901a98d3-049f-4181-b689-4bae661fd2c4\', \'multiverseId\': 133977}, \'multiverseid\': 133977}, {\'name\': \'Притаившийся Рыцарь\', \'text\': \'Обход (Когда существо без обхода блокирует это существо, это блокирующее существо получает -1/-1 до конца хода)\\nКогда Притаившийся Рыцарь становится целью заклинания или способности, пожертвуйте его.\', \'type\': \'Существо — Зомби Рыцарь\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134278&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'742fe090-3dda-49dd-877e-c16b8298a90e\', \'multiverseId\': 134278}, \'multiverseid\': 134278}, {\'name\': \'隐匿骑士\', \'text\': \'侧面攻击（每当一个不具侧面攻击之生物阻挡此生物时，该阻挡生物得-1/-1直到回合结束。）\\n当隐匿骑士成为咒语或异能的目标时，将它牺牲。\', \'type\': \'生物～灵俑／骑士\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132472&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'153aebb3-01ea-429d-bd9a-165957be2637\', \'multiverseId\': 132472}, \'multiverseid\': 132472}]', '[{\'name\': \'Herumziehender Schwarzseher\', \'text\': \'{T}: Tappe eine Kreatur deiner Wahl mit Widerstandskraft 2 oder weniger.\', \'type\': \'Kreatur — Mensch, Rebell\', \'flavor\': \'„Vergiss meine Worte nicht, Reisender. Seuchen, Krieg, Trostlosigkeit — das sind alles nur Vorzeichen davon, welche Schrecken auf Dominaria noch zukommen werden."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132920&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'6913b6fe-c980-4517-b553-8594e190f930\', \'multiverseId\': 132920}, \'multiverseid\': 132920}, {\'name\': \'Condenadores errantes\', \'text\': \'{T}: Gira la criatura objetivo con resistencia de 2 o menos.\', \'type\': \'Criatura — Rebelde humano\', \'flavor\': \'"Escúchame, viajero. Pestes, guerra, desolación. . . todo eso son sólo pistas de lo que todavía vendrá de la bóveda de los horrores de Dominaria."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134425&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'166b96e3-ac4a-4c99-b234-0306eb35d108\', \'multiverseId\': 134425}, \'multiverseid\': 134425}, {\'name\': \'Conte-destins errants\', \'text\': "{T} : Engagez la créature ciblée dont l\'endurance est de 2 ou moins.", \'type\': \'Créature : humain et rebelle\', \'flavor\': "« Écoute mes paroles, voyageur. Peste, guerre, désolation... Tout cela n\'est qu\'un faible aperçu de ce qui va sortir du caveau des horreurs de Dominaria. »", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132619&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'52360fd3-974b-486e-9919-94e2b5d04133\', \'multiverseId\': 132619}, \'multiverseid\': 132619}, {\'name\': \'Profeti di Sventure Erranti\', \'text\': \'{T}: TAPpa una creatura bersaglio con costituzione pari o inferiore a 2.\', \'type\': \'Creatura — Ribelle Umano\', \'flavor\': \'"Ascolta le mie parole, viaggiatore. Epidemie, guerre, desolazione . . . sono tutti chiari indizi di ciò che deve ancora uscire dalla cripta degli orrori di Dominaria."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133221&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'ce260fd8-d936-4649-9cc0-99a7380e3244\', \'multiverseId\': 133221}, \'multiverseid\': 133221}, {\'name\': \'遍歴の宿命語り\', \'text\': \'{T}：タフネスが２以下のクリーチャー１体を対象とし、それをタップする。\', \'type\': \'クリーチャー — 人間・レベル\', \'flavor\': \'旅人よ、我が言葉を心得るがよい。 疫病、戦争、荒廃 … … それはすべて、ドミナリアの邪霊の住処より来るものの単なる予兆に過ぎぬ。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133522&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'10cdbf14-d29c-4ace-bab6-2bb1745592fa\', \'multiverseId\': 133522}, \'multiverseid\': 133522}, {\'name\': \'Áugure do Infortúnio Errante\', \'text\': \'{T}: Vire a criatura alvo com resistência menor ou igual a 2.\', \'type\': \'Criatura — Humano Rebelde\', \'flavor\': \'"Atento às minhas palavras, viajante. Pragas, guerra, desolação. . . todas meras indicações do que ainda está por vir da câmara de horrores de Dominária."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133823&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7ac74aeb-2621-4577-a52f-2a01af6b0054\', \'multiverseId\': 133823}, \'multiverseid\': 133823}, {\'name\': \'Заблудшие Предвестники Гибели\', \'text\': \'{T}: Поверните целевое существо с защитой 2 или меньше.\', \'type\': \'Существо — Человек Повстанец\', \'flavor\': \'«Учти мои слова, путник. Чума, война, разорение . . . лишь только жалкие намеки на то, что грядет из катакомб ужасов Доминарии».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134124&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'311423bb-7dcc-4849-a9d6-5e7fd16f7fb1\', \'multiverseId\': 134124}, \'multiverseid\': 134124}, {\'name\': \'遍历劫难论者\', \'text\': \'{T}：横置目标防御力等于或小于2的生物。\', \'type\': \'生物～人类／反抗军\', \'flavor\': \'「旅人啊，听好了。 疫病，战争，荒芜. . . 这些只不过是多明纳里亚惊惧大观的预告而已。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132318&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f7908dc2-1d2b-45dc-96e3-aaa56a8bd817\', \'multiverseId\': 132318}, \'multiverseid\': 132318}]', '[{\'name\': \'Herumziehendes Ephemerid\', \'text\': \'Fliegend\\nAussetzen 4 {1}{U} (Statt diese Karte aus deiner Hand zu spielen, kannst du {1}{U} bezahlen, sie ganz aus dem Spiel entfernen und vier Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132921&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'dff13d95-bf7d-4b42-bf57-931098d8e394\', \'multiverseId\': 132921}, \'multiverseid\': 132921}, {\'name\': \'Efímero errante\', \'text\': \'Vuela.\\nSuspender 4—{1}{U} (En lugar de jugar esta carta de tu mano, puedes pagar {1}{U} y removerla del juego con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Ilusión\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134426&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4f2c359c-ec98-4a83-a0b9-44329115fc31\', \'multiverseId\': 134426}, \'multiverseid\': 134426}, {\'name\': \'Éphéméroptère errant\', \'text\': \'Vol\\nSuspension 4 — {1}{U} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {1}{U} et la retirer de la partie avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)\', \'type\': \'Créature : illusion\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132620&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c5a7ca2d-7f75-4bb0-baf6-c5f5666ab34e\', \'multiverseId\': 132620}, \'multiverseid\': 132620}, {\'name\': \'Effimero Errante\', \'text\': "Volare\\nSospendere 4—{1}{U} (Invece di giocare questa carta dalla tua mano, puoi pagare {1}{U} e rimuoverla dal gioco con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Illusione\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133222&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e1750f49-28b3-40bb-aa00-e790a522b0b1\', \'multiverseId\': 133222}, \'multiverseid\': 133222}, {\'name\': \'遍歴のカゲロウ獣\', \'text\': \'飛行\\n待機 ４―{1}{U} （これをあなたの手札からプレイするのではなく、{1}{U}を支払ってゲームから取り除き、その上に時間カウンターを４個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — イリュージョン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133523&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ee126586-8d0d-4f35-9160-850d39a0645a\', \'multiverseId\': 133523}, \'multiverseid\': 133523}, {\'name\': \'Efêmeron Errante\', \'text\': \'Voar\\nSuspender 4—{1}{U} (Em vez de jogar este card da sua mão, você pode pagar {1}{U} e removê-lo do jogo com quatro marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Ilusão\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133824&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6906bb43-98e0-4891-8be8-4d39b8027416\', \'multiverseId\': 133824}, \'multiverseid\': 133824}, {\'name\': \'Заблудший Эфимерон\', \'text\': \'Полет\\nОтсрочка 4—{1}{U} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {1}{U} и удалить ее из игры с четырмя временными жетонами на ней. В начале вашего шага поддержки, удалите один временной жетон. Когда вы удалите последний, сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Иллюзия\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134125&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'f4b1cf1f-05c0-4583-abe6-b877f4689e6b\', \'multiverseId\': 134125}, \'multiverseid\': 134125}, {\'name\': \'遍历蜉蝣\', \'text\': \'飞行\\n延缓4～{1}{U}（除了从你手上使用此牌，你可以支付{1}{U}并将此牌移出对战，且上面有四个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～虚影\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132319&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'ce561608-4294-4f9e-8591-636ff77f9eea\', \'multiverseId\': 132319}, \'multiverseid\': 132319}]', "[{'name': 'Himmlischer Kreuzritter', 'text': 'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nSekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nFliegend\\nAndere weiße Kreaturen erhalten +1/+1.', 'type': 'Kreatur — Geist', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132884&type=card', 'language': 'German', 'identifiers': {'scryfallId': '6a6814d6-2453-4bda-8db2-e178f9903071', 'multiverseId': 132884}, 'multiverseid': 132884}, {'name': 'Cruzado celestial', 'text': 'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nFracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nVuela.\\nLas otras criaturas blancas obtienen +1/+1.', 'type': 'Criatura — Espíritu', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134389&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'a56189d5-1c1e-4eb5-a15d-efdb079113b7', 'multiverseId': 134389}, 'multiverseid': 134389}, {'name': 'Croisé céleste', 'text': 'Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nFraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nVol\\nLes autres créatures blanches gagnent +1/+1.', 'type': 'Créature : esprit', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132583&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'b800067f-58f0-44b0-9bb0-d0290798a39c', 'multiverseId': 132583}, 'multiverseid': 132583}, {'name': 'Crociato Celestiale', 'text': 'Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nBattibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nVolare\\nLe altre creature bianche prendono +1/+1.', 'type': 'Creatura — Spirito', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133185&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '31037e56-9c71-4fee-be97-e396359adcb8', 'multiverseId': 133185}, 'multiverseid': 133185}, {'name': '天界の十字軍', 'text': '瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\n飛行\\n他の白のクリーチャーは＋１/＋１の修整を受ける。', 'type': 'クリーチャー — スピリット', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133486&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '37eaee20-3244-45e7-97ea-2f548368a931', 'multiverseId': 133486}, 'multiverseid': 133486}, {'name': 'Cruzado Celestial', 'text': 'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nFração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nVoar\\nAs outras criaturas brancas recebem +1/+1.', 'type': 'Criatura — Espírito', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133787&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5703b97c-a02c-44ba-ad40-5b616eaf8e15', 'multiverseId': 133787}, 'multiverseid': 133787}, {'name': 'Небесный Крестоносец', 'text': 'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nМгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nПолет\\nДругие белые существа получают +1/+1.', 'type': 'Существо — Дух', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134088&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': 'ff0555e8-1c52-4243-af69-98d4df8a94fe', 'multiverseId': 134088}, 'multiverseid': 134088}, {'name': '天界十字军', 'text': '闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n飞行\\n其它白色生物得+1/+1。', 'type': '生物～精怪', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132282&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f7a187d2-7504-48ea-a16a-d5c57fb533ef', 'multiverseId': 132282}, 'multiverseid': 132282}]", '[{\'name\': \'Hirnmartern\', \'text\': \'Ein Spieler deiner Wahl wirft drei Karten aus seiner Hand ab.\\nAussetzen 4 {B} (Statt diese Karte aus deiner Hand zu spielen, kannst du {B} bezahlen, sie ganz aus dem Spiel entfernen und vier Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133005&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c267f17d-26f6-4937-8160-b141958316a2\', \'multiverseId\': 133005}, \'multiverseid\': 133005}, {\'name\': \'Roecerebros\', \'text\': \'El jugador objetivo descarta tres cartas.\\nSuspender 4—{B} (En lugar de jugar esta carta de tu mano, puedes pagar {B} y removerla del juego con cuatro contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134510&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5973a79a-8930-4f51-99fb-17e1f691a857\', \'multiverseId\': 134510}, \'multiverseid\': 134510}, {\'name\': \'Percesprit\', \'text\': \'Le joueur ciblé se défausse de trois cartes.\\nSuspension 4 — {B} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {B} et la retirer de la partie avec quatre marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)\', \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132704&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f68a5ba-6bf7-4042-afa6-849120049a51\', \'multiverseId\': 132704}, \'multiverseid\': 132704}, {\'name\': \'Pungimente\', \'text\': "Un giocatore bersaglio scarta tre carte.\\nSospendere 4—{B} (Invece di giocare questa carta dalla tua mano, puoi pagare {B} e rimuoverla dal gioco con quattro segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133306&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'fd8dddfb-0829-4022-b503-9527a0b89014\', \'multiverseId\': 133306}, \'multiverseid\': 133306}, {\'name\': \'精神攪乱\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーはカードを３枚捨てる。\\n待機 ４―{B} （これをあなたの手札からプレイするのではなく、{B}を支払ってゲームから取り除き、その上に時間カウンターを４個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133607&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'429e7fd1-f01d-477c-b539-71df07c9b2c8\', \'multiverseId\': 133607}, \'multiverseid\': 133607}, {\'name\': \'Apunhala-Mentes\', \'text\': \'O jogador alvo descarta três cards.\\nSuspender 4—{B} (Em vez de jogar este card da sua mão, você pode pagar {B} e removê-lo do jogo com quatro marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133908&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54d91fcf-dcca-496a-9c6e-4ed9c95486d4\', \'multiverseId\': 133908}, \'multiverseid\': 133908}, {\'name\': \'Мысленный Удар\', \'text\': \'Целевой игрок сбрасывает три карты.\\nОтсрочка 4—{B} (Вместо того чтобы сыграть эту карту из вашей руки, вы можете заплатить {B} и удалить ее из игры с четырьмя временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134209&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'093dc6a2-d089-4555-80ef-7957ad59f236\', \'multiverseId\': 134209}, \'multiverseid\': 134209}, {\'name\': \'灵杀\', \'text\': \'目标牌手弃三张牌。\\n延缓4～{B}（除了从你手上使用此牌，你可以支付{B}并将此牌移出对战，且上面有四个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132403&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'c4e79798-eee0-4afb-a8df-9a17dfbc4d9b\', \'multiverseId\': 132403}, \'multiverseid\': 132403}]', '[{\'name\': \'Hypergenese\', \'text\': \'Hypergenese ist grün.\\nAussetzen 3 {1}{G}{G}\\nMit dir beginnend darf jeder Spieler ein Artefakt, eine Kreatur, eine Verzauberung oder ein Land aus seiner Hand ins Spiel bringen. Wiederhole diesen Vorgang, bis niemand mehr eine Karte ins Spiel bringt.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132968&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c8426a80-0141-4f27-9e96-e559fc0355f5\', \'multiverseId\': 132968}, \'multiverseid\': 132968}, {\'name\': \'Hipergénesis\', \'text\': \'La Hipergénesis es verde.\\nSuspender 3—{1}{G}{G}.\\nComenzando contigo, cada jugador puede poner en juego de su mano una carta de artefacto, criatura, encantamiento o tierra. Repite este proceso hasta que nadie ponga una carta en juego.\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134473&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'04cfcc3c-c880-42d3-9114-9f7e4e2e61a4\', \'multiverseId\': 134473}, \'multiverseid\': 134473}, {\'name\': \'Hypergenèse\', \'text\': "L\'Hypergenèse est verte.\\nSuspension 3 — {1}{G}{G}\\nEn commençant par vous, chaque joueur peut mettre en jeu une carte d\'artefact, de créature, d\'enchantement ou de terrain de sa main. Répétez ce processus jusqu\'à ce que personne ne mette de carte en jeu.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132667&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ec4d2c3a-d1e6-471e-be8a-52611a8456ea\', \'multiverseId\': 132667}, \'multiverseid\': 132667}, {\'name\': \'Ipergenesi\', \'text\': \'Ipergenesi è verde.\\nSospendere 3—{1}{G}{G}\\nA partire da te, ogni giocatore può mettere in gioco una carta artefatto, creatura, incantesimo o terra dalla propria mano. Ripeti questo procedimento finché nessuno mette in gioco una carta.\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133269&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e804473f-f935-41eb-b3e0-40613713ff82\', \'multiverseId\': 133269}, \'multiverseid\': 133269}, {\'name\': \'超起源\', \'text\': \'超起源は緑である。\\n待機 ３―{1}{G}{G}\\nあなたから始めて、各プレイヤーは自分の手札にあるアーティファクト・カード１枚かクリーチャー・カード１枚かエンチャント・カード１枚か土地カード１枚を場に出してもよい。 この手順を、誰もカードを場に出さなくなるまで繰り返す。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133570&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'79117235-4ee9-4f84-a787-380f23c3b458\', \'multiverseId\': 133570}, \'multiverseid\': 133570}, {\'name\': \'Hipergênese\', \'text\': \'Hipergênese é verde.\\nSuspender 3—{1}{G}{G}\\nComeçando por você, cada jogador pode colocar em jogo um card de artefato, criatura, encantamento ou terreno de sua própria mão. Repita este processo até que ninguém mais coloque cards em jogo.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133871&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ae02e92b-96f7-4488-aece-a56e2b359223\', \'multiverseId\': 133871}, \'multiverseid\': 133871}, {\'name\': \'Гипергенезия\', \'text\': \'Гипергенезия является зеленой.\\nОтсрочка 3—{1}{G}{G}\\nНачиная с вас, все игроки могут положить артефакт, существо, чары или землю из своей руки в игру. Повторяйте этот процесс до тех пор, пока никто не положит карт в игру.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134172&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d3568ebf-9284-4e40-b430-f70d3cadadb1\', \'multiverseId\': 134172}, \'multiverseid\': 134172}, {\'name\': \'多重创生\', \'text\': \'多重创生是绿色。\\n延缓3～{1}{G}{G}\\n由你开始，每位牌手可以将一张神器，生物，结界或地牌从其手牌放置进场。 重复此流程，直到没有人将牌放置进场为止。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132366&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'2e671c1a-c59c-4534-b75e-6203e69a51fc\', \'multiverseId\': 132366}, \'multiverseid\': 132366}]', '[{\'name\': \'Ib Halbherz, Goblin-Taktiker\', \'text\': \'Immer wenn ein anderer Goblin, den du kontrollierst, geblockt wird, opfere ihn. Falls du das tust, fügt er jeder Kreatur, die ihn blockt, 4 Schadenspunkte zu.\\nOpfere zwei Gebirge: Bringe zwei 1/1 rote Goblinspielsteine ins Spiel.\', \'type\': \'Legendäre Kreatur — Goblin, Berater\', \'flavor\': \'„Alle außer mir Sturmangriff"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132969&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1777d105-1e16-44e1-944e-6d37d081318e\', \'multiverseId\': 132969}, \'multiverseid\': 132969}, {\'name\': \'Ib Corazón de ratón, estratega trasgo\', \'text\': \'Siempre que otro trasgo que controles sea bloqueado, sacrifícalo. Si lo haces, le hace 4 puntos de daño a cada criatura que lo bloquea.\\nSacrificar dos montañas: Pon en juego dos fichas de criatura Trasgo rojas 1/1.\', \'type\': \'Criatura legendaria — Consejero trasgo\', \'flavor\': \'"Todos salvo yo—¡A LA CARGA"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134474&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'87f95870-310b-4067-a93c-1825724034c3\', \'multiverseId\': 134474}, \'multiverseid\': 134474}, {\'name\': \'Ib Micœur, tacticien gobelin\', \'text\': "À chaque fois qu\'un autre gobelin que vous contrôlez devient bloqué, sacrifiez-le. Si vous faites ainsi, il inflige 4 blessures à chaque créature qui le bloque.\\nSacrifiez deux montagnes : Mettez en jeu deux jetons de créature 1/1 rouge Gobelin.", \'type\': \'Créature légendaire : gobelin et conseiller\', \'flavor\': \'« Tout le monde excepté moi — CHARGEZ »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132668&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'24834ab4-7ed5-4ad8-a3e4-417e9416f77e\', \'multiverseId\': 132668}, \'multiverseid\': 132668}, {\'name\': \'Ib Mezzocuore, Stratega Goblin\', \'text\': \'Ogniqualvolta un altro Goblin che controlli viene bloccato, sacrificalo. Se lo fai, esso infligge 4 danni a ogni creatura che lo blocca.\\nSacrifica due Montagne: Metti in gioco due pedine creatura Goblin 1/1 rosse.\', \'type\': \'Creatura Leggendaria — Consigliere Goblin\', \'flavor\': \'"Tutti tranne me—CARICA"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133270&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'edb78027-552c-4209-8bb3-526f3ae25738\', \'multiverseId\': 133270}, \'multiverseid\': 133270}, {\'name\': \'ゴブリンの戦術家、半心臓のイッブ\', \'text\': \'あなたがコントロールする他のゴブリンがブロックされた状態になるたび、それを生け贄に捧げる。 そうした場合、それはそれをブロックしている各クリーチャーにそれぞれ４点のダメージを与える。\\n山を２つ生け贄に捧げる：赤の１/１のゴブリン・クリーチャー・トークンを２体場に出す。\', \'type\': \'伝説のクリーチャー — ゴブリン・アドバイザー\', \'flavor\': \'俺以外の全員――突撃！\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133571&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'710839b3-fc7a-4fbf-955b-f076de8c7fc1\', \'multiverseId\': 133571}, \'multiverseid\': 133571}, {\'name\': \'Ib Halfheart, Estrategista Goblin\', \'text\': \'Toda vez que outro Goblin que você controla for bloqueado, sacrifique-o. Se fizer isso, ele causará 4 pontos de dano a cada criatura que o estiver bloqueando.\\nSacrifique duas Montanhas: Coloque em jogo duas fichas de criatura vermelhas 1/1 do tipo Goblin.\', \'type\': \'Criatura Lendária — Conselheiro Goblin\', \'flavor\': \'"Todos menos eu ATACAR"\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133872&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'07b8d7c9-22c4-4991-ae8b-8151fbbb03bb\', \'multiverseId\': 133872}, \'multiverseid\': 133872}, {\'name\': \'Иб Хафхарт, Тактик гоблинов\', \'text\': \'Когда другой Гоблин под вашим контролем становится заблокированным, пожертвуйте это существо. Если вы сделали это, это существо наносит 4 повреждения каждому заблокировавшему его существу.\\nПожертвуйте две Горы: положите две фишки существ 1/1 красный Гоблин в игру.\', \'type\': \'Легендарное Существо — Гоблин Советник\', \'flavor\': \'«Все, кроме меня В АТАКУ»\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134173&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ce932264-e1cb-4052-9952-612624a058d2\', \'multiverseId\': 134173}, \'multiverseid\': 134173}, {\'name\': \'精灵战术家依部哈夫哈特\', \'text\': \'每当另一个由你操控的精灵被阻挡时，将它牺牲。 若你如此作，它对每个阻挡它的生物造成4点伤害。\\n牺牲两个山脉：将两个1/1红色精灵衍生物放置进场。\', \'type\': \'传奇生物～精灵／参谋\', \'flavor\': \'「全体听令，除我之外～冲锋！」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132367&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'faf1e060-a94b-454c-869f-54c4a6333719\', \'multiverseId\': 132367}, \'multiverseid\': 132367}]', '[{\'name\': \'Icatianische Ausruferin\', \'text\': \'{1}{W}, {T}, wirf eine Karte aus deiner Hand ab: Bringe zwei 1/1 weiße Bürgerspielsteine ins Spiel.\', \'type\': \'Kreatur — Mensch, Spruchwandler\', \'flavor\': \'Da sie tausend Jahre von ihrer Heimat entfernt war, verlor ihre Nachricht vom Krieg zwar den Zusammenhang, nicht aber die Dringlichkeit.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132970&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'f092327a-33dc-41ae-b7a5-0211b8987915\', \'multiverseId\': 132970}, \'multiverseid\': 132970}, {\'name\': \'Pregonera icatiana\', \'text\': \'Remueve del juego el artefacto o encantamiento objetivo. Si jugaste este hechizo durante tu fase principal, puedes remover del juego otro artefacto o encantamiento objetivo.\', \'type\': \'Criatura — Cambiahechizos humano\', \'flavor\': \'Desplazada mil años de su hogar, sus noticias de la guerra han perdido su contexto, pero no su relevancia.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134475&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'cabe78ba-556f-44c9-b7b5-a72141cda00f\', \'multiverseId\': 134475}, \'multiverseid\': 134475}, {\'name\': \'Crieuse icatiane\', \'text\': "{1}{W}, {T}, défaussez-vous d\'une carte : Mettez en jeu deux jetons de créature 1/1 blanche Citoyen.", \'type\': \'Créature : humain et sortisan\', \'flavor\': \'À mille ans de son foyer, ses nouvelles de guerre avaient perdu leur contexte, mais pas leur importance.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132669&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'9a2dde5a-40fb-411e-8cbb-2db163263916\', \'multiverseId\': 132669}, \'multiverseid\': 132669}, {\'name\': \'Banditrice di Icatia\', \'text\': \'{1}{W}, {T}, Scarta una carta: Metti in gioco due pedine creatura Cittadino 1/1 bianche.\', \'type\': \'Creatura — Mutamagia Umano\', \'flavor\': \'Dopo migliaia di anni lontano dalla patria, le sue notizie sulla guerra avevano perso il loro contesto, ma non la loro attualità.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133271&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'39c60ee0-2dae-4cbe-992a-b4796a105257\', \'multiverseId\': 133271}, \'multiverseid\': 133271}, {\'name\': \'アイケイシアの触れ役\', \'text\': \'{1}{W}, {T}, カードを１枚捨てる：白の１/１の市民クリーチャー・トークンを２体場に出す。\', \'type\': \'クリーチャー — 人間・スペルシェイパー\', \'flavor\': \'彼女の故郷から数千年が失われた今、彼女の戦争の知らせは理由を失ったが、無意味になったわけではない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133572&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'6665bf27-1ef0-432d-a73b-ffe55f4c74cd\', \'multiverseId\': 133572}, \'multiverseid\': 133572}, {\'name\': \'Estafeta Icatiana\', \'text\': \'{1}{W}, {T}, Descarte um card: Coloque em jogo duas fichas de criatura brancas 1/1 do tipo Cidadão.\', \'type\': \'Criatura — Magimodelador Humano\', \'flavor\': \'Após mil anos longe de casa, suas novidades sobre a guerra perderam o contexto, mas não a relevância.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133873&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d3aeea57-dfa1-419b-a460-d051aedf92bb\', \'multiverseId\': 133873}, \'multiverseid\': 133873}, {\'name\': \'Айкейшунская Плакальщица\', \'text\': \'{1}{W}, {T}, Сбросьте карту: Положите две фишки существ 1/1 белый Гражданин в игру.\', \'type\': \'Существо — Человек Заклинатель\', \'flavor\': \'Отдаленная от своего дома на тысячи лет, она несет важные новости о войне, хоть и прошедшей.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134174&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'7b0a0d1d-2051-4dbc-9dc2-8c93044700d6\', \'multiverseId\': 134174}, \'multiverseid\': 134174}, {\'name\': \'艾凯逊战呼人\', \'text\': \'{1}{W}，{T}，弃一张牌：将两个1/1白色市民衍生物放置进场。\', \'type\': \'生物～人类／塑法师\', \'flavor\': \'她已从家乡来到千年后，所传递的战事讯息已失去意义，但状况依旧适用。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132368&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'519b2094-eb55-490b-b2a8-61706b6e7476\', \'multiverseId\': 132368}, \'multiverseid\': 132368}]', '[{\'name\': \'Immerändernde Weite\', \'text\': \'{T}, opfere die Immerändernde Weite: Durchsuche deine Bibliothek nach einem Standardland und bringe es getappt ins Spiel. Mische danach deine Bibliothek.\', \'type\': \'Land\', \'flavor\': \'Zwei Schritte nach Norden führen dich in die ungewisse Zukunft, nach Süden in die unruhige Vergangenheit, nach Osten in den heutigen Tag und nach Westen in das große Durcheinander.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133111&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a963fbd4-0116-4bb2-b039-70e6bdf6fac9\', \'multiverseId\': 133111}, \'multiverseid\': 133111}, {\'name\': \'Expansión terramórfica\', \'text\': \'{T}, sacrificar la Expansión terramórfica: Busca en tu biblioteca una carta de tierra básica y ponla en juego girada. Luego baraja tu biblioteca.\', \'type\': \'Tierra\', \'flavor\': \'Haz dos pasos al norte hacia el futuro inestable, al sur hacia el pasado inquieto, al este hacia el presente o al oeste hacia lo desconocido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134616&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'00f4b5a1-687d-4744-8372-34ea14d1d8f0\', \'multiverseId\': 134616}, \'multiverseid\': 134616}, {\'name\': \'Immensité terramorphe\', \'text\': "{T}, sacrifiez l\'Immensité terramorphe : Cherchez dans votre bibliothèque une carte de terrain de base et mettez-la en jeu engagée. Mélangez ensuite votre bibliothèque.", \'type\': \'Terrain\', \'flavor\': "Faites deux pas au nord dans l\'avenir instable, au sud dans le passé agité, à l\'est dans le présent ou à l\'ouest dans le vaste inconnu.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132810&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'c41818d2-058f-4ace-abdd-a8282c3c71cd\', \'multiverseId\': 132810}, \'multiverseid\': 132810}, {\'name\': \'Distesa Terramorfica\', \'text\': \'{T}, Sacrifica la Distesa Terramorfica: Passa in rassegna il tuo grimorio per una carta terra base e mettila in gioco TAPpata. Poi rimescola il tuo grimorio.\', \'type\': \'Terra\', \'flavor\': \'Fai due passi a nord nel futuro incerto, a sud nel passato inquieto, a est nel giorno attuale o a ovest nel grande ignoto.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133412&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'4382cb30-c2cf-4ced-af03-2cb5ef98e10d\', \'multiverseId\': 133412}, \'multiverseid\': 133412}, {\'name\': \'広漠なる変幻地\', \'text\': \'{T}, 広漠なる変幻地を生け贄に捧げる：あなたのライブラリーから基本土地カードを１枚探し、それをタップ状態で場に出す。 その後あなたのライブラリーを切り直す。\', \'type\': \'土地\', \'flavor\': \'二歩北へ進めば不安定な未来、南へ進めば不穏な過去、東に進めば今日この日、西へ進めば偉大なる未知。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133713&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d25bda11-0ad8-4bcf-8f15-c2d0e65bb36a\', \'multiverseId\': 133713}, \'multiverseid\': 133713}, {\'name\': \'Vastidão Morfoterrena\', \'text\': \'{T}, Sacrifique Vastidão Morfoterrena: Procure em seu grimório por um card de terreno básico e coloque-o em jogo virado. Depois, embaralhe seu grimório.\', \'type\': \'Terreno\', \'flavor\': \'Dê dois passos ao norte para o futuro incerto, ao sul para o passado inquieto, ao leste para o presente, ou ao oeste para o grande desconhecido.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134014&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'1ae7166c-8d13-4229-8eba-3fcbac91fa59\', \'multiverseId\': 134014}, \'multiverseid\': 134014}, {\'name\': \'Просторы Преображенных Земель\', \'text\': \'{T}, Пожертвуйте Просторы Преображенных Земель: Поищите в вашей библиотеке карту базовой земли и положите ее в игру повернутой. Затем перетасуйте вашу библиотеку.\', \'type\': \'Земля\', \'flavor\': \'Сделай два шага на север в необитаемое будущее, на юг в неупокоенное прошлое, на восток в настоящее или на запад в великое неизвестное.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134315&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c3c39ef2-bfe5-4f20-a620-b2624c0e53cd\', \'multiverseId\': 134315}, \'multiverseid\': 134315}, {\'name\': \'地塑旷野\', \'text\': \'{T}，牺牲地塑旷野：从你的牌库中搜寻一张基本地牌，并将之横置进场。 然后将你的牌库洗牌。\', \'type\': \'地\', \'flavor\': \'迈开两步，向北迈进动荡将来，向南则为无宁过往，向东步回眼下此刻，或向西踏入未知境地。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132509&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'14cd4560-d6fd-45b8-bdb6-cbc981ac74e6\', \'multiverseId\': 132509}, \'multiverseid\': 132509}]', "[{'name': 'Insel', 'type': 'Standardland — Insel', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132973&type=card', 'language': 'German', 'identifiers': {'scryfallId': '1e1c3bfe-65af-4bc1-a284-16214f4f1f0d', 'multiverseId': 132973}, 'multiverseid': 132973}, {'name': 'Isla', 'type': 'Tierra básica — Isla', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134478&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1c272c92-f9ee-4bef-949f-f156a1d00b12', 'multiverseId': 134478}, 'multiverseid': 134478}, {'name': 'Île', 'type': 'Terrain de base : île', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132672&type=card', 'language': 'French', 'identifiers': {'scryfallId': '952abd08-1530-4ca3-b942-317383b3e5fc', 'multiverseId': 132672}, 'multiverseid': 132672}, {'name': 'Isola', 'type': 'Terra Base — Isola', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133274&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '5219c540-5448-4bf2-bee0-07ccb56ffa19', 'multiverseId': 133274}, 'multiverseid': 133274}, {'name': '島', 'type': '基本土地 — 島', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133575&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '3bcf1dfa-f9bf-47b1-828c-685705149ea6', 'multiverseId': 133575}, 'multiverseid': 133575}, {'name': 'Ilha', 'type': 'Terreno Básico — Ilha', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133876&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'c56e0239-31ec-44f7-9125-d826d3a9ff96', 'multiverseId': 133876}, 'multiverseid': 133876}, {'name': 'Остров', 'type': 'Базовая Земля — Остров', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134177&type=card', 'language': 'Russian', 'identifi