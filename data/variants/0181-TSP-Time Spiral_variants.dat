pe=card', 'language': 'French', 'identifiers': {'scryfallId': 'ef6d2b43-ddc7-4237-917a-940e1271d7ce', 'multiverseId': 132740}, 'multiverseid': 132740}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133342&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '702643f1-f25c-4af1-b531-48921079bf2c', 'multiverseId': 133342}, 'multiverseid': 133342}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133643&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '725e53c9-492d-44fc-af94-64ad3980cddc', 'multiverseId': 133643}, 'multiverseid': 133643}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133944&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '6b7f5ab4-f5cf-4080-a1d8-3ac84e66ca28', 'multiverseId': 133944}, 'multiverseid': 133944}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134245&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '37c0db0d-cf8f-47f5-b865-5b2951f05375', 'multiverseId': 134245}, 'multiverseid': 134245}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132439&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '111147cd-3ecf-4dc4-9e5e-b74e2e34f898', 'multiverseId': 132439}, 'multiverseid': 132439}]", "[{'name': 'Ebene', 'type': 'Standardland — Ebene', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133042&type=card', 'language': 'German', 'identifiers': {'scryfallId': '33afa740-e812-4512-85db-5e3cd52a4285', 'multiverseId': 133042}, 'multiverseid': 133042}, {'name': 'Llanura', 'type': 'Tierra básica — Llanura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134547&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '13f36aca-b154-4a82-9346-ed43df7dc984', 'multiverseId': 134547}, 'multiverseid': 134547}, {'name': 'Plaine', 'type': 'Terrain de base : plaine', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132741&type=card', 'language': 'French', 'identifiers': {'scryfallId': '735533f1-28bc-4c15-84db-df7533ab69ef', 'multiverseId': 132741}, 'multiverseid': 132741}, {'name': 'Pianura', 'type': 'Terra Base — Pianura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133343&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '76cb559a-c1bb-4015-b023-825359df5cc8', 'multiverseId': 133343}, 'multiverseid': 133343}, {'name': '平地', 'type': '基本土地 — 平地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133644&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'aa52bc25-6eb8-491e-8ab0-1f30d32c11ab', 'multiverseId': 133644}, 'multiverseid': 133644}, {'name': 'Planície', 'type': 'Terreno Básico — Planície', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133945&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '142950f7-f6ba-4ef7-b915-e1d4bf629979', 'multiverseId': 133945}, 'multiverseid': 133945}, {'name': 'Равнина', 'type': 'Базовая Земля — Равнина', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134246&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '87c50b2c-4a91-43ae-95bb-92782ebfec4b', 'multiverseId': 134246}, 'multiverseid': 134246}, {'name': '平原', 'type': '基本地～平原', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132440&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bd41f8de-e378-4ab3-af01-b21410a27738', 'multiverseId': 132440}, 'multiverseid': 132440}]", "[{'name': 'Edelsteinhöhlen', 'text': 'Falls die Edelsteinhöhlen auf deiner Anfangshand sind und du nicht als Erster an der Reihe bist, kannst du sie vor Spielbeginn mit einer Glücksmarke ins Spiel bringen. Falls du das tust, entferne eine Karte aus deiner Hand ganz aus dem Spiel.{T}: Erhöhe deinen Manavorrat um {1}.\\n Falls eine Glücksmarke auf den Edelsteinhöhlen liegt, erhöhe deinen Manavorrat stattdessen um ein Mana einer beliebigen Farbe.', 'type': 'Legendäres Land', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132951&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'a9766cc4-56a3-42a9-8702-50c7f792f466', 'multiverseId': 132951}, 'multiverseid': 132951}, {'name': 'Cavernas de gemas', 'text': 'Si las Cavernas de gemas están en tu mano inicial y no juegas primero, puedes comenzar el juego con las Cavernas de gemas en juego con un contador de suerte sobre ellas. Si lo haces, remueve del juego una carta de tu mano.\\n{T}: Agrega {1} a tu reserva de maná. Si las Cavernas de gemas tienen un contador de suerte sobre ellas, en vez de eso, agrega un maná de cualquier color a tu reserva de maná.', 'type': 'Tierra legendaria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134456&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'cad89e1d-fc2e-4619-a43b-f86780231e98', 'multiverseId': 134456}, 'multiverseid': 134456}, {'name': 'Cavernes aux gemmes', 'text': 'Si les Cavernes aux gemmes sont dans votre main de départ et que vous ne jouez pas en premier, vous pouvez commencer la partie avec les Cavernes aux gemmes en jeu avec, sur elles, un marqueur « chance ». Si vous faites ainsi, retirez de la partie une carte de votre main.\\n{T} : Ajoutez {1} à votre réserve. Si les Cavernes aux gemmes ont un marqueur « chance » sur elles, ajoutez un mana de la couleur de votre choix à votre réserve à la place.', 'type': 'Terrain légendaire', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132650&type=card', 'language': 'French', 'identifiers': {'scryfallId': '146c0ec2-2868-4792-92fb-a93c3235091b', 'multiverseId': 132650}, 'multiverseid': 132650}, {'name': 'Caverne di Gemme', 'text': 'Se le Caverne di Gemme sono nella tua mano iniziale e non stai giocando per primo, puoi iniziare la partita mettendo in gioco le Caverne di Gemme con un segnalino fortuna su di esse. Se lo fai, rimuovi dal gioco una carta dalla tua mano.\\n{T}: Aggiungi {1} alla tua riserva di mana. Se le Caverne di Gemme hanno su di esse un segnalino fortuna, aggiungi invece un mana di qualsiasi colore alla tua riserva di mana.', 'type': 'Terra Leggendaria', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133252&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '8e3499b7-3799-447e-b404-27b234b6875c', 'multiverseId': 133252}, 'multiverseid': 133252}, {'name': '宝石の洞窟', 'text': '宝石の洞窟があなたのゲーム開始時の手札にあり、かつあなたが先攻でない場合、あなたはそれが運勢カウンターを１個置いて場に出ている状態でゲームを開始してもよい。 そうした場合、あなたの手札にあるカードを１枚ゲームから取り除く。\\n{T}：あなたのマナ・プールに{1}を加える。 宝石の洞窟に運勢カウンターが置かれている場合、代わりにあなたのマナ・プールに好きな色１色のマナ１点を加える。', 'type': '伝説の土地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133553&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'cc3b016a-35e2-4658-afea-6f0caf6348d8', 'multiverseId': 133553}, 'multiverseid': 133553}, {'name': 'Carvernas de Pedras Preciosas', 'text': 'Se Carvernas de Pedras Preciosas estiver em sua mão de abertura e você não for o primeiro a jogar, você pode começar o jogo com Carvernas de Pedras Preciosas em jogo com um marcador de sorte sobre ela. Se fizer isso, remova do jogo um card de sua mão.\\n{T}: Adicione {1} à sua reserva de mana. Se Carvernas de Pedras Preciosas tiver um marcador de sorte sobre ela, em vez disso, adicione um mana de qualquer cor à sua reserva de mana.', 'type': 'Terreno Lendário', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133854&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '8de27cf3-c26e-4126-8930-fb6c2cee7271', 'multiverseId': 133854}, 'multiverseid': 133854}, {'name': 'Самоцветные Пещеры', 'text': 'Если Самоцветные Пещеры пришли к вам в начальную руку и вы не ходите первым, вы можете начать игру с Самоцветными Пещерами в игре с одним жетоном удачи на них. Если вы это сделали, уберите одну карту в вашей руке из игры.\\n{T}: Добавьте {1} в ваше хранилище маны. Если на Самоцветных Пещерах есть жетон удачи, добавьте вместо этого одну ману любого цвета в ваше хранилище маны.', 'type': 'Легендарная Земля', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134155&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '9a0e75e1-50af-4398-b85c-4cc62a3f01f8', 'multiverseId': 134155}, 'multiverseid': 134155}, {'name': '宝石洞穴', 'text': '若你起手的手牌包含了宝石洞穴，且你并非先手，你可以让它在场来开始游戏，且上面有一个运气指示物。 若你如此作，将你手上一张牌移出对战。\\n{T}：加{1}到你的法术力池中。 如果宝石洞穴上面有运气指示物，则改为加一点任意颜色的法术力到你的法术力池中。', 'type': '传奇地', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132349&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'c5dc8daf-9ad5-44df-9796-8129632230d2', 'multiverseId': 132349}, 'multiverseid': 132349}]", '[{\'name\': \'Edle Sylphide\', \'text\': \'Fliegend\\nAndere fliegende Kreaturen, die du kontrollierst, erhalten +0/+1.\\n{T}: Andere fliegende Kreaturen, die du kontrollierst, erhalten +1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Feenwesen\', \'flavor\': \'„Mit Dornen und Steinen werden wir darum kämpfen, den Tag noch zu erleben, an dem die Schönheit auf diese Welt zurückkehrt."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133085&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c1be8842-41f5-40ed-b434-b8c2c587ec16\', \'multiverseId\': 133085}, \'multiverseid\': 133085}, {\'name\': \'Noble hada\', \'text\': \'Vuela.\\nLas otras criaturas que controlas con la habilidad de volar obtienen +0/+1.\\n{T}: Las otras criaturas que controlas con la habilidad de volar obtienen +1/+0 hasta el final del turno.\', \'type\': \'Criatura — Hada\', \'flavor\': \'"Con la espina y con la piedra, lucharemos hasta ver el día en que la belleza regrese a este mundo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134590&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9f78ed5b-25d7-4349-b9e9-b14f6020c396\', \'multiverseId\': 134590}, \'multiverseid\': 134590}, {\'name\': \'Noble farfadette\', \'text\': "Vol\\nLes autres créatures avec le vol que vous contrôlez gagnent +0/+1.\\n{T} : Les autres créatures avec le vol que vous contrôlez gagnent +1/+0 jusqu\'à la fin du tour.", \'type\': \'Créature : peuple fée\', \'flavor\': \'« Par les épines et par la pierre, nous verrons le jour où la beauté revient sur ce monde. »\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132784&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'6f260876-5d90-404d-b8bb-37634e50c06f\', \'multiverseId\': 132784}, \'multiverseid\': 132784}, {\'name\': \'Folletta Nobile\', \'text\': \'Volare\\nLe altre creature con volare che controlli prendono +0/+1.\\n{T}: Le altre creature con volare che controlli prendono +1/+0 fino alla fine del turno.\', \'type\': \'Creatura — Spiritello\', \'flavor\': \'"Con le spine e con le pietre lotteremo, per vedere il giorno in cui la bellezza ritorna in questo mondo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133386&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'183cf0e2-539d-4b46-b4cc-ba353df39c25\', \'multiverseId\': 133386}, \'multiverseid\': 133386}, {\'name\': \'スプライトの貴族\', \'text\': \'飛行\\nあなたがコントロールする他の飛行を持つクリーチャーは＋０/＋１の修整を受ける。\\n{T}：あなたがコントロールする他の飛行を持つクリーチャーは、ターン終了時まで＋１/＋０の修整を受ける。\', \'type\': \'クリーチャー — フェアリー\', \'flavor\': \'私達はこの世界に美を取り戻す日まで、棘ででも石ででも戦います。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133687&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'d31652c5-2e39-421f-a022-9bb3c7effd02\', \'multiverseId\': 133687}, \'multiverseid\': 133687}, {\'name\': \'Nobre Sílfide\', \'text\': \'Voar\\nAs outras criaturas que você controla com voar recebem +0/+1.\\n{T}: As outras criaturas que você controla com a habilidade de voar recebem +1/+0 até o final do turno.\', \'type\': \'Criatura — Fada\', \'flavor\': \'"Com espinhos e pedras nós lutaremos para que um dia a beleza retorne a este mundo."\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133988&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'7aab08cd-5472-47a8-b0a3-3b08461e5949\', \'multiverseId\': 133988}, \'multiverseid\': 133988}, {\'name\': \'Дворянин Фей\', \'text\': \'Полет\\nДругие существа с полетом под вашим контролем получают +0/+1.\\n{T}: Другие существа с полетом под вашем контролем получают +1/+0 до конца хода.\', \'type\': \'Существо — Фея\', \'flavor\': \'«Громом и камнями мы будем бороться до конца, чтобы увидить день, когда красота вернется в этот мир».\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134289&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d7b1dfd8-a127-4f79-9eb3-6e7077774995\', \'multiverseId\': 134289}, \'multiverseid\': 134289}, {\'name\': \'贵族仙子\', \'text\': \'飞行\\n由你操控且具飞行异能的其它生物得+0/+1。\\n{T}：由你操控且具飞行异能的其它生物得+1/+0直到回合结束。\', \'type\': \'生物～仙灵\', \'flavor\': \'「以荆棘与坚石起誓，吾族将奋战不懈，令世界重归美好。」\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132483&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f93e5f8f-8b2e-41ad-8369-9b1095a5c66f\', \'multiverseId\': 132483}, \'multiverseid\': 132483}]', '[{\'name\': \'Eiferer il-Vec\', \'text\': \'Irrealität (Diese Kreatur kann nur Kreaturen mit Irrealität blocken und nur von solchen geblockt werden.)\\nImmer wenn der Eiferer il-Vec angreift und nicht geblockt wird, kannst du ihn einer Kreatur deiner Wahl 1 Schadenspunkt zufügen lassen. Falls du dies tust, verhindere allen Kampfschaden, den der Eiferer il-Vec in diesem Zug zufügen würde.\', \'type\': \'Kreatur — Mensch, Rebell\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133153&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'92c1116e-4f92-4222-a3a2-5f44aed5d9d1\', \'multiverseId\': 133153}, \'multiverseid\': 133153}, {\'name\': \'Fanático il-Vec\', \'text\': \'Se desvanece (Esta criatura sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\\nSiempre que el Fanático il-Vec ataque y no sea bloqueado, puedes hacer que le haga 1 punto de daño a la criatura objetivo. Si lo haces, prevén todo el daño de combate que el Fanático il-Vec fuera a hacer este turno.\', \'type\': \'Criatura — Rebelde humano\', \'flavor\': \'"Si vuelve en unos años, nuestro conocimiento de cómo combatirlo será mucho mayor." —Ándorel, centinela tolariano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134658&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'58791815-7052-4703-a145-969a8cfe7ae2\', \'multiverseId\': 134658}, \'multiverseid\': 134658}, {\'name\': \'Zélateur il-Vec\', \'text\': "Distorsion (Cette créature ne peut bloquer ou être bloquée que par des créatures avec la distorsion.)\\nÀ chaque fois que le Zélateur il-Vec attaque et qu\'il n\'est pas bloqué, vous pouvez faire qu\'il inflige 1 blessure à la créature ciblée. Si vous faites ainsi, prévenez toutes les blessures de combat que le Zélateur il-Vec infligerait ce tour-ci.", \'type\': \'Créature : humain et rebelle\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132852&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'966ca117-6c4c-4dfe-961e-79f6d3ff5d68\', \'multiverseId\': 132852}, \'multiverseid\': 132852}, {\'name\': \'Zelota il-Vec\', \'text\': \'Ombra (Questa creatura può bloccare o essere bloccata soltanto da creature con ombra.)\\nOgniqualvolta lo Zelota il-Vec attacca e non viene bloccato, puoi fargli infliggere 1 danno a una creatura bersaglio. Se lo fai, previeni tutto il danno da combattimento che lo Zelota il-Vec infliggerebbe in questo turno.\', \'type\': \'Creatura — Ribelle Umano\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133454&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'3a570eb4-9b2c-4803-a647-b8d8252cbb80\', \'multiverseId\': 133454}, \'multiverseid\': 133454}, {\'name\': \'ヴェク追われの盲信者\', \'text\': \'シャドー （このクリーチャーは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\\nヴェク追われの盲信者が攻撃してブロックされないたび、クリーチャー１体を対象とする。あなたは「ヴェク追われの盲信者はそれに１点のダメージを与える。」を選んでもよい。 そうした場合、このターン、ヴェク追われの盲信者が与える戦闘ダメージをすべて軽減し、０にする。\', \'type\': \'クリーチャー — 人間・レベル\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133755&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ca655839-9332-4c58-b22b-0007ca1f07a1\', \'multiverseId\': 133755}, \'multiverseid\': 133755}, {\'name\': \'Zelote il-Vec\', \'text\': \'Sombra (Esta criatura só pode bloquear ou ser bloqueada por criaturas com sombra.)\\nToda vez que Zelote il-Vec ataca e não é bloqueado, você pode fazer com que ele cause 1 ponto de dano à criatura alvo. Se fizer isso, previna todo o dano de combate que Zelote il-Vec causaria neste turno.\', \'type\': \'Criatura — Humano Rebelde\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134056&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'a355d18b-2837-46c3-9416-092feffe126e\', \'multiverseId\': 134056}, \'multiverseid\': 134056}, {\'name\': \'Фанатик ил-Век\', \'text\': \'Тень (Это существо можеть блокировать и быть заблокированным только существ(ами) с тенью.)\\nКогда Фанатик ил-Век атакует и не заблокирован, вы можете нанести им 1 повреждение целевому существу. Если вы это сделали, предотвратите все боевые повреждения, которые Фанатик ил-Век нанесет на этом ходу.\', \'type\': \'Существо — Человек Повстанец\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134357&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'b3475ac5-305a-436e-b3d3-f9e1fbcfc53a\', \'multiverseId\': 134357}, \'multiverseid\': 134357}, {\'name\': \'维克黜人狂信者\', \'text\': \'次元幽影（此生物只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\\n每当维克黜人狂信者进行攻击且未受阻挡时，你可以让它对目标生物造成1点伤害。 若你如此作，则防止维克黜人狂信者于本回合中将造成的所有战斗伤害。\', \'type\': \'生物～人类／反抗军\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132551&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'0343ae69-40c2-4a12-929b-bbd715b3bc9e\', \'multiverseId\': 132551}, \'multiverseid\': 132551}]', '[{\'name\': \'Eindringling il-Vec\', \'text\': \'Wirf eine Karte aus deiner Hand ab: Der Eindringling il-Vec erhält Irrealität bis zum Ende des Zuges. (Er kann nur Kreaturen mit Irrealität blocken und nur von ihnen geblockt werden.)\', \'type\': \'Kreatur — Mensch, Räuber\', \'flavor\': \'Auf dem Höhepunkt der Überlagerung von Rath war die Stadt der Verräter nicht mit Dominaria ausgerichtet. Viele ihrer Bewohner wurden zwischen den beiden Welten gefangen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133123&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'a197f064-0142-4a3b-ae19-40ad46348272\', \'multiverseId\': 133123}, \'multiverseid\': 133123}, {\'name\': \'Intruso il-Vec\', \'text\': \'Descartar una carta: El Intruso il-Vec gana la habilidad de desvanecerse hasta el final del turno. (Sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\', \'type\': \'Criatura — Bribón humano\', \'flavor\': \'En el epicentro de la sobreposición de Rath, la Ciudad de traidores no se alineó con Dominaria. Muchos de sus habitantes fueron atrapados entre los dos mundos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134628&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'548ea40b-e438-4464-8062-cff6a6e97409\', \'multiverseId\': 134628}, \'multiverseid\': 134628}, {\'name\': \'Intrus il-Vec\', \'text\': "Défaussez-vous d\'une carte : L\'Intrus il-Vec acquiert la distorsion jusqu\'à la fin du tour. (Il ne peut bloquer ou être bloqué que par des créatures avec la distorsion.)", \'type\': \'Créature : humain et gredin\', \'flavor\': "À l\'épicentre du recouvrement rajhi, la Cité des traîtres ne s\'alignait pas avec le reste de Dominaria. Beaucoup de ses habitants étaient coincés entre les deux mondes.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132822&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'72f1a8d8-f9ff-4c1d-81c2-ebd933019a64\', \'multiverseId\': 132822}, \'multiverseid\': 132822}, {\'name\': \'Intruso il-Vec\', \'text\': "Scarta una carta: L\'Intruso il-Vec ha ombra fino alla fine del turno. (Può bloccare o essere bloccato solo da creature con ombra.)", \'type\': \'Creatura — Farabutto Umano\', \'flavor\': "Nell\'epicentro della sovrapposizione di Rath, la Città dei Traditori non si allineò con Dominaria. Molti dei suoi abitanti vennero intrappolati tra i due mondi.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133424&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'24208fd2-d00c-4e3a-97a9-cbf436656740\', \'multiverseId\': 133424}, \'multiverseid\': 133424}, {\'name\': \'ヴェク追われの侵入者\', \'text\': \'カードを１枚捨てる：ヴェク追われの侵入者はターン終了時までシャドーを得る。 （それは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\', \'type\': \'クリーチャー — 人間・ならず者\', \'flavor\': \'ラースの被覆の震央で、裏切り者の都はドミナリアとは協調しなかった。 そこに住んでいた者の多くは二つの世界の間に捕らえられた。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133725&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'025e8049-af45-4c93-b910-991642b10bd8\', \'multiverseId\': 133725}, \'multiverseid\': 133725}, {\'name\': \'Transgressor il-Vec\', \'text\': \'Descarte um card: Transgressor il-Vec ganha sombra até o final do turno. (Ele só pode bloquear ou ser bloqueado por criaturas com sombra.)\', \'type\': \'Criatura — Ladino Humano\', \'flavor\': \'No epicentro da sobreposição dos Rathi, a Cidade dos Traidores não se aliou à Dominária. Muitos de seus habitantes ficaram presos entre os dois mundos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134026&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'079246ea-1b9a-452f-993e-a990133ac973\', \'multiverseId\': 134026}, \'multiverseid\': 134026}, {\'name\': \'Правонарушитель ил-Век\', \'text\': \'Сбросьте карту: Правонарушитель ил-Век получает тень до конца хода. (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\', \'type\': \'Существо — Человек Бродяга\', \'flavor\': \'В эпицентре накрытия Рата, Город Предателей не имел сообщения с Доминарией. Многие его жители были заточены между двумя мирами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134327&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'d12122f5-840a-42b5-8bda-6df252320175\', \'multiverseId\': 134327}, \'multiverseid\': 134327}, {\'name\': \'维克黜人入侵者\', \'text\': \'弃一张牌：维克黜人入侵者获得次元幽影异能直到回合结束。 （它只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\', \'type\': \'生物～人类／浪客\', \'flavor\': \'叛徒之都位于瑞斯时空覆盖的中点，并未融入多明纳里亚。 许多居民都被囚于世间夹缝。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132521&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'303158d6-57ab-4f56-88cb-cab535fa5237\', \'multiverseId\': 132521}, \'multiverseid\': 132521}]', "[{'name': 'Einsichtiger Seher', 'text': 'Morph Bringe zwei Inseln, die du kontrollierst, auf die Hand ihres Besitzes zurück. (Du kannst diese Karte verdeckt für {3} als eine 2/2 Kreatur spielen. Decke sie zu einem beliebigen Zeitpunkt für ihre Morph-Kosten auf.)\\nWenn der Einsichtige Seher aufgedeckt wird, ziehe zwei Karten.', 'type': 'Kreatur — Illusion', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132927&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'c7254983-14b6-4363-a42e-25c472307ac4', 'multiverseId': 132927}, 'multiverseid': 132927}, {'name': 'Vidente profundizadora', 'text': 'Metamorfosis—Regresar dos islas que controlas a la mano de su propietario. (Puedes jugar esta carta boca abajo como una criatura 2/2 pagando {3}. Ponla boca arriba en cualquier momento pagando su coste de metamorfosis.)\\nCuando la Vidente profundizadora se ponga boca arriba, roba dos cartas.', 'type': 'Criatura — Ilusión', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134432&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '7fdc2f0f-ca15-41a5-8694-5d5ec0de4c5d', 'multiverseId': 134432}, 'multiverseid': 134432}, {'name': 'Voyante des fonds marins', 'text': 'Mue — Renvoyez deux îles que vous contrôlez dans la main de leur propriétaire. (Vous pouvez jouer cette carte face cachée comme une créature 2/2 pour {3}. Retournez-la quand vous le désirez pour son coût de mue.)\\nQuand la Voyante des fonds marins est retournée face visible, piochez deux cartes.', 'type': 'Créature : illusion', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132626&type=card', 'language': 'French', 'identifiers': {'scryfallId': 'da1e5d2d-f683-47b0-911c-9bec4df26b6c', 'multiverseId': 132626}, 'multiverseid': 132626}, {'name': 'Veggente Profonda', 'text': 'Metamorfosi—Fai tornare due Isole che controlli in mano al loro proprietario. (Puoi giocare questa carta a faccia in giù come una creatura 2/2 pagando {3}. Girala a faccia in su in qualsiasi momento pagando il suo costo di metamorfosi.)\\nQuando la Veggente Profonda viene girata a faccia in su, pesca due carte.', 'type': 'Creatura — Illusione', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133228&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '992e4b89-406d-4b52-bd64-89924859356a', 'multiverseId': 133228}, 'multiverseid': 133228}, {'name': '水深の予見者', 'text': '変異 ― あなたがコントロールする島を２枚オーナーの手札に戻す。 （あなたはこれを、{3}を支払うことで、裏向きの２/２のクリーチャーとしてプレイしてもよい。 いつでも変異コストを支払ってそれを表向きにすることができる。）\\n水深の予見者が表向きになったとき、カードを２枚引く。', 'type': 'クリーチャー — イリュージョン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133529&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '8749f25f-9a2c-4ca9-8c37-df2fe4100fc5', 'multiverseId': 133529}, 'multiverseid': 133529}, {'name': 'Vidente de Braças', 'text': 'Metamorfose—Devolva duas Ilhas que você controla para a mão de seus donos. (Você pode baixar este card com a face voltada para baixo como uma criatura 2/2 por {3}. Vire sua face para cima a qualquer momento pagando seu custo de metamorfose.)\\nQuando Vidente de Braças for virada para cima, compre dois cards.', 'type': 'Criatura — Ilusão', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133830&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '25fa7ea9-aa45-4fea-98a6-3a607893f84a', 'multiverseId': 133830}, 'multiverseid': 133830}, {'name': 'Фантомный Провидец', 'text': 'Оборотень—Верните два Острова под вашим контролем в руку их владельцев. (Вы можете играть эту карту лицом вниз как 2/2 существо за {3}. Переверните ее лицом вверх в любой момент за ее стоимость оборотня.)\\nКогда Фантомный провидец поворачивается лицом вверх, возьмите две карты.', 'type': 'Существо — Иллюзия', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134131&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '33bd94f0-0331-4d33-9598-2d5b667a95b0', 'multiverseId': 134131}, 'multiverseid': 134131}, {'name': '深测预言师', 'text': '变身～将两个由你操控的海岛移回其拥有者手上。 （你可牌面朝下地使用此牌并支付{3}，将其当成2/2生物。 可随时支付其变身费用使其翻回正面。）\\n当深测预言师翻回正面时，抓两张牌。', 'type': '生物～虚影', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132325&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '2bf3a8dd-78ac-429e-9526-55d88b0eb641', 'multiverseId': 132325}, 'multiverseid': 132325}]", "[{'name': 'Einsiedler-Gorgo', 'text': 'Immer wenn die Einsiedler-Gorgo eine nichtschwarze Kreatur blockt oder von ihr geblockt wird, zerstöre diese Kreatur am Ende des Kampfes.\\nWahnsinn {B}{B} (Falls du diese Karte aus deiner Hand abwirfst, kannst du sie für ihre Wahnsinn-Kosten spielen, anstatt sie auf deinen Friedhof zu legen.)', 'type': 'Kreatur — Gorgo', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132956&type=card', 'language': 'German', 'identifiers': {'scryfallId': '09fe2bc6-164b-4e62-8c60-916f782e2aad', 'multiverseId': 132956}, 'multiverseid': 132956}, {'name': 'Gorgona reclusa', 'text': 'Siempre que la Gorgona reclusa bloquee o sea bloqueada por una criatura que no sea negra, destruye esa criatura al final del combate.\\nDemencia {B}{B} (Si descartas esta carta, puedes jugarla por su coste de demencia en vez de ponerla en tu cementerio.)', 'type': 'Criatura — Gorgona', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134461&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'b0c6b70f-e452-49a8-b42b-7884b0b86c24', 'multiverseId': 134461}, 'multiverseid': 134461}, {'name': 'Gorgone recluse', 'text': 'À chaque fois que la Gorgone recluse bloque ou devient bloquée par une créature non-noire, détruisez cette créature à la fin du combat.\\nFolie {B}{B} (Si vous vous défaussez de cette carte, vous pouvez la jouer pour son coût de folie à la place de la mettre dans votre cimetière.)', 'type': 'Créature : gorgonoïde', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132655&type=card', 'language': 'French', 'identifiers': {'scryfallId': '218081b1-10d4-4125-adb2-ebcc367a6e5f', 'multiverseId': 132655}, 'multiverseid': 132655}, {'name': 'Gorgone Eremita', 'text': 'Ogniqualvolta la Gorgone Eremita blocca o viene bloccata da una creatura non nera, distruggi quella creatura alla fine del combattimento.\\nFollia {B}{B} (Se scarti questa carta, puoi giocarla pagando il suo costo di follia invece di metterla nel tuo cimitero.)', 'type': 'Creatura — Gorgone', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133257&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '4773e8bc-bc12-46c5-81ea-73e70e9f713c', 'multiverseId': 133257}, 'multiverseid': 133257}, {'name': 'ゴルゴンの世捨て', 'text': 'ゴルゴンの世捨てがいずれかの黒でないクリーチャーをブロックするかブロックされた状態になるたび、戦闘終了時にそのクリーチャーを破壊する。\\nマッドネス {B}{B} （あなたがこのカードを捨てる場合、あなたはそれをあなたの墓地に置く代わりに、マッドネス・コストでそれをプレイしてもよい。）', 'type': 'クリーチャー — ゴルゴン', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133558&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': 'dd1996fe-1121-4fa0-ba46-a961473cc3cd', 'multiverseId': 133558}, 'multiverseid': 133558}, {'name': 'Eremita Górgona', 'text': 'Toda vez que Eremita Górgona bloquear ou for bloqueada por uma criatura que não seja preta, destrua aquela criatura no final do combate.\\nLoucura {B}{B} (Se você descartar este card, você poderá jogá-lo pagando seu custo de loucura, em vez de colocá-lo em seu cemitério.)', 'type': 'Criatura — Górgona', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133859&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': '5bb4f92e-a016-4ca9-8129-d98d41c70ce2', 'multiverseId': 133859}, 'multiverseid': 133859}, {'name': 'Гаргона Отшельница', 'text': 'Когда Горгона Отшельница блокирует или становится заблокированной не черным существом, уничтожьте это существо в конце боя.\\nБешенство {B}{B} (Если вы сбрасываете эту карту, вы можете сыграть ее за ее стоимость бешенства вместо того чтобы положить ее на ваше кладбище.)', 'type': 'Существо — Горгона', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134160&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '93ea5c91-3aad-4acd-a22f-ce0d445e8afa', 'multiverseId': 134160}, 'multiverseid': 134160}, {'name': '隐遁蛇发妖', 'text': '每当隐遁蛇发妖阻挡非黑色生物或被非黑色生物阻挡，在战斗结束时消灭该生物。\\n疯魔{B}{B}（如果你弃掉此牌，可以改为使用它并支付其疯魔费用，而非直接将它置入你的坟墓场。）', 'type': '生物～蛇发妖', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132354&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'f2fdf267-6d10-4dbb-8169-55317978f7d3', 'multiverseId': 132354}, 'multiverseid': 132354}]", '[{\'name\': \'Eisenklauen-Bussardreiter\', \'text\': \'Die Eisenklauen-Bussardreiter können Kreaturen mit Stärke 2 oder mehr nicht blocken.\\n{R}: Die Eisenklauen-Bussardreiter erhalten Flugfähigkeit bis zum Ende des Zuges.\', \'type\': \'Kreatur — Ork, Späher\', \'flavor\': \'Sie warnen die Armee vor drohender Gefahr, wenn sie im Rückzug über sie hinübergleiten.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132972&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'cd351cf2-c952-4a04-80db-e17d29f3e549\', \'multiverseId\': 132972}, \'multiverseid\': 132972}, {\'name\': \'Buitreros Zarpafierro\', \'text\': \'Los Buitreros Zarpafierro no pueden bloquear a una criatura con fuerza de 2 o más.\\n{R}: Los Buitreros Zarpafierro ganan la habilidad de volar hasta el final del turno.\', \'type\': \'Criatura — Explorador orco\', \'flavor\': \'Alertan al ejército del peligro mientras graznan volando en suave retirada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134477&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'200479d7-c508-4604-bc77-e1875b9dfb56\', \'multiverseId\': 134477}, \'multiverseid\': 134477}, {\'name\': \'Busardiers de la Griffe de fer\', \'text\': "Les Busardiers de la Griffe de fer ne peuvent pas bloquer les créatures de force supérieure ou égale à 2.\\n{R} : Les Busardiers de la Griffe de fer acquièrent le vol jusqu\'à la fin du tour.", \'type\': \'Créature : orque et éclaireur\', \'flavor\': "Ils préviennent l\'armée du danger quand ils battent en retraite en criant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132671&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bfe6519d-7302-478b-bc16-907d5ad6f9d7\', \'multiverseId\': 132671}, \'multiverseid\': 132671}, {\'name\': "Cavalcapoiane dell\'Artiglio di Ferro", \'text\': "I Cavalcapoiane dell\'Artiglio di Ferro non possono bloccare creature con forza pari o superiore a 2.\\n{R}: I Cavalcapoiane dell\'Artiglio di Ferro hanno volare fino alla fine del turno.", \'type\': \'Creatura — Esploratore Orco\', \'flavor\': "Avvertono l\'esercito del pericolo con strida rauche, mentre lo sorvolano per una ritirata rapida.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133273&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'d20b0b68-bebb-4533-9486-3eed546acb0a\', \'multiverseId\': 133273}, \'multiverseid\': 133273}, {\'name\': \'鉄爪のノスリ乗り\', \'text\': \'鉄爪のノスリ乗りは、パワーが２以上のクリーチャーをブロックできない。\\n{R}：鉄爪のノスリ乗りはターン終了時まで飛行を得る。\', \'type\': \'クリーチャー — オーク・スカウト\', \'flavor\': \'彼らは素早く撤退しつつ、その道すがらにけたたましい声で軍に危険を警告する。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133574&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'de182996-aa8b-42c8-a175-08336156a88c\', \'multiverseId\': 133574}, \'multiverseid\': 133574}, {\'name\': \'Busardeios Garra de Ferro\', \'text\': \'Busardeios Garra de Ferro não pode bloquear criaturas com poder maior ou igual a 2.\\n{R}: Busardeios Garra de Ferro ganha a habilidade de voar até o final do turno.\', \'type\': \'Criatura — Batedor Orc\', \'flavor\': \'Eles avisaram o exército sobre o perigo enquanto guinchavam em retirada.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133875&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'ba1467bf-5375-4725-a7e7-bd5f8a6bcb69\', \'multiverseId\': 133875}, \'multiverseid\': 133875}, {\'name\': \'Гриф с Железными Когтями\', \'text\': \'Гриф с Железными Когтями не может блокировать существ с силой 2 или меньше.\\n{R}: Жадюга с Железными Когтями получает полет до конца хода.\', \'type\': \'Существо — Орк Разведчик\', \'flavor\': \'Стремительно отступая, они предупреждали армию об опасности своим диким криком .\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134176&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'e2995cff-e480-4cef-911e-54c80a2f6430\', \'multiverseId\': 134176}, \'multiverseid\': 134176}, {\'name\': \'铁爪兀鹰骑兵\', \'text\': \'铁爪兀鹰骑兵不能阻挡力量大于或等于2的生物。\\n{R}：铁爪兀鹰骑兵获得飞行异能直到回合结束。\', \'type\': \'生物～半兽人／斥候\', \'flavor\': \'他们一面迅速撤退，一面大声叫嚷好提醒部队注意危险。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132370&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9303ed3d-b9d1-49ea-b256-498021056eab\', \'multiverseId\': 132370}, \'multiverseid\': 132370}]', '[{\'name\': \'Elfenbeinriese\', \'text\': \'Wenn der Elfenbeinriese ins Spiel kommt, tappe alle nichtweißen Kreaturen.\\nAussetzen 5 {W} (Statt diese Karte aus deiner Hand zu spielen, kannst du {W} bezahlen, sie ganz aus dem Spiel entfernen und fünf Zeitmarken auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen. Sie hat Eile.)\', \'type\': \'Kreatur — Riese\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132978&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1720732b-d979-4be2-a4bd-4537e912eea4\', \'multiverseId\': 132978}, \'multiverseid\': 132978}, {\'name\': \'Gigante de marfil\', \'text\': \'Cuando el Gigante de marfil entre en juego, gira todas las criaturas que no sean blancas.\\nSuspender 5—{W} (En lugar de jugar esta carta de tu mano, puedes pagar {W} y removerla del juego con cinco contadores de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná. Tiene la habilidad de prisa.)\', \'type\': \'Criatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134483&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'9ce01125-6f4b-4a46-a718-eccd2275ba06\', \'multiverseId\': 134483}, \'multiverseid\': 134483}, {\'name\': "Géant d\'ivoire", \'text\': "Quand le géant d\'ivoire arrive en jeu, engagez toutes les créatures non-blanches.\\nSuspension 5 — {W} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {W} et la retirer de la partie avec cinq marqueurs « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana. Elle a la célérité.)", \'type\': \'Créature : géant\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132677&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'bc940496-1057-4839-bf17-6d6b17381262\', \'multiverseId\': 132677}, \'multiverseid\': 132677}, {\'name\': "Gigante d\'Avorio", \'text\': "Quando il Gigante d\'Avorio entra in gioco, TAPpa tutte le creature non bianche.\\nSospendere 5—{W} (Invece di giocare questa carta dalla tua mano, puoi pagare {W} e rimuoverla dal gioco con cinque segnalini tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana. Ha rapidità.)", \'type\': \'Creatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133279&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'e081dd10-5f93-44bb-bb7a-5ec40ad83b8d\', \'multiverseId\': 133279}, \'multiverseid\': 133279}, {\'name\': \'象牙の巨人\', \'text\': \'象牙の巨人が場に出たとき、白でないクリーチャーをすべてタップする。\\n待機 ５―{W} （これをあなたの手札からプレイするのではなく、{W}を支払ってゲームから取り除き、その上に時間カウンターを５個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。 それは速攻を持つ。）\', \'type\': \'クリーチャー — 巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133580&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'12df05a1-1816-49f3-ac60-c4cf2d8101a6\', \'multiverseId\': 133580}, \'multiverseid\': 133580}, {\'name\': \'Gigante de Marfim\', \'text\': \'Quando Gigante de Marfim entrar em jogo, vire todas as criaturas que não sejam brancas.\\nSuspender 5—{W} (Em vez de jogar este card da sua mão, você pode pagar {W} e removê-lo do jogo com cinco marcadores temporais sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana. Ele tem ímpeto.)\', \'type\': \'Criatura — Gigante\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133881&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'736590a5-0d5d-4409-a51c-4012af9d6133\', \'multiverseId\': 133881}, \'multiverseid\': 133881}, {\'name\': \'Гигант Слоновой Кости\', \'text\': \'Когда Гигант Слоновой Кости входит в игру, поверните всех небелых существ.\\nОтсрочка 5—{W} (Вместо того чтобы сыграть эту карту из вашей руки, заплатите {W} и удалите ее из игры с пятью временными жетонами на ней. В начале вашего шага поддержки удалите один временной жетон. Когда вы удалите последний, сыграйте эту карту без оплаты ее мана-стоимости. Она получает ускорение.)\', \'type\': \'Существо — Гигант\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134182&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'bc36b6a1-2fce-4539-9943-42bdad2b5702\', \'multiverseId\': 134182}, \'multiverseid\': 134182}, {\'name\': \'象牙巨人\', \'text\': \'当象牙巨人进场时，横置所有非白色生物。\\n延缓5～{W}（除了从你手上使用此牌，你可以支付{W}并将此牌移出对战，且上面有五个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。 它具有敏捷。）\', \'type\': \'生物～巨人\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132376&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'8d231329-b081-4dcd-8822-a567f9dfcce9\', \'multiverseId\': 132376}, \'multiverseid\': 132376}]', "[{'name': 'Endrek Sahr, Meisterzüchter', 'text': 'Immer wenn du einen Kreaturenzauber spielst, bringe X 1/1 schwarze Thrullspielsteine ins Spiel, wobei X gleich den umgewandelten Manakosten des Zaubers ist.\\nWenn du sieben oder mehr Thrulls kontrollierst, opfere Endrek Sahr, Meisterzüchter.', 'type': 'Legendäre Kreatur — Mensch, Zauberer', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132919&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'd90da1a6-11bc-4820-b9f8-e67b40a4463c', 'multiverseId': 132919}, 'multiverseid': 132919}, {'name': 'Éndrek Sahr, criador experto', 'text': 'Siempre que juegues un hechizo de criatura, pon en juego X fichas de criatura Thrull negras 1/1, donde X es el coste de maná convertido de ese hechizo.\\nCuando controles siete o más Thrulls, sacrifica a Éndrek Sahr, criador experto.', 'type': 'Criatura legendaria — Hechicero humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134424&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '1e995749-cde9-4e99-a64e-4365140bc47c', 'multiverseId': 134424}, 'multiverseid': 134424}, {'name': 'Endrek Sahr, maître reproducteur', 'text': 'À chaque fois que vous jouez un sort de créature, mettez en jeu X jetons de créature 1/1 noire Srâne, X étant le coût converti de mana de ce sort.\\nQuand vous contrôlez au moins sept srânes, sacrifiez Endrek Sahr, maître reproducteur.', 'type': 'Créature légendaire : humain et sorcier', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132618&type=card', 'language': 'French', 'identifiers': {'scryfallId': '3dccc1c7-2313-4cda-9725-8c6df3d2a2c2', 'multiverseId': 132618}, 'multiverseid': 132618}, {'name': 'Endrek Sahr, Mastro Allevatore', 'text': 'Ogniqualvolta giochi una magia creatura, metti in gioco X pedine creatura Thrull 1/1 nere, dove X è pari al costo di mana convertito di quella magia.\\nQuando controlli sette o più Thrull, sacrifica Endrek Sahr, Mastro Allevatore.', 'type': 'Creatura Leggendaria — Mago Umano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133220&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '960e96cb-e090-4c09-974a-f03518059656', 'multiverseId': 133220}, 'multiverseid': 133220}, {'name': '繁殖の達人、エンドレク・サール', 'text': 'あなたがクリーチャー呪文をプレイするたび、黒の１/１のスラル・クリーチャー・トークンをＸ体場に出す。Ｘはその呪文の点数で見たマナ・コストに等しい。\\nあなたが７体以上のスラルをコントロールするとき、繁殖の達人、エンドレク・サールを生け贄に捧げる。', 'type': '伝説のクリーチャー — 人間・ウィザード', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133521&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '90981369-faee-4b4e-a516-433c96fc6194', 'multiverseId': 133521}, 'multiverseid': 133521}, {'name': 'Endrek Sahr, Criador Mestre', 'text': 'Toda vez que você jogar uma mágica de criatura, coloque em jogo X fichas de criatura pretas 1/1 do tipo Thrull, sendo X o custo de mana convertido daquela mágica.\\nQuando você controlar sete ou mais Thrulls, sacrifique Endrek Sahr, Criador Mestre.', 'type': 'Criatura Lendária — Mago Humano', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133822&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'bb4ed6c6-3dda-4980-9927-b47dc34f308c', 'multiverseId': 133822}, 'multiverseid': 133822}, {'name': 'Эндрек Сар, Мастер Труллевод', 'text': 'Когда вы играете заклинание существа, положите X фишек существ 1/1 черный Трулл в игру, где X конвертированная мана-стоимость этого заклинания.\\nКода вы контролируете семь или более Труллей, пожертвуйте Эндрека Сара, Мастера-труллевода.', 'type': 'Легендарное Существо — Человек Чародей', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134123&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '0fc60ecf-f211-423c-b839-f614f0116112', 'multiverseId': 134123}, 'multiverseid': 134123}, {'name': '培育师恩德瑞克萨尔', 'text': '每当你使用生物咒语时，将X个1/1黑色索尔兽衍生物放置进场，X为该咒语的总法术力费用。\\n当你操控七个或更多索尔兽时，牺牲培育师恩德瑞克萨尔。', 'type': '传奇生物～人类／法术师', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132317&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': 'bcf50a2d-a7f9-42c8-bbb1-9b5b634d366f', 'multiverseId': 132317}, 'multiverseid': 132317}]", '[{\'name\': \'Entladung aus dem Zeitriss\', \'text\': \'Die Entladung aus dem Zeitriss fügt einer Kreatur oder einem Spieler deiner Wahl 3 Schadenspunkte zu.\\nAussetzen 1 {R} (Statt diese Karte aus deiner Hand zu spielen, kannst du {R} bezahlen, sie ganz aus dem Spiel entfernen und eine Zeitmarke auf sie legen. Entferne zu Beginn deines Versorgungssegments eine Zeitmarke von ihr. Wenn du die letzte Zeitmarke entfernst, spiele die Karte, ohne ihre Manakosten zu bezahlen.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133056&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c0dae24d-e486-40fe-a1de-e217d88a2606\', \'multiverseId\': 133056}, \'multiverseid\': 133056}, {\'name\': \'Rayo de la grieta\', \'text\': \'El Rayo de la grieta hace 3 puntos de daño a la criatura o jugador objetivo.\\nSuspender 1—{R} (En lugar de jugar esta carta de tu mano, puedes pagar {R} y removerla del juego con un contador de tiempo sobre ella. Al comienzo de tu mantenimiento, remueve un contador de tiempo. Cuando remuevas el último, juégala sin pagar su coste de maná.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134561&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'85231429-9801-4c32-bee9-96457b5a4520\', \'multiverseId\': 134561}, \'multiverseid\': 134561}, {\'name\': \'Éclair de faille\', \'text\': "L\'Éclair de faille inflige 3 blessures à une cible, créature ou joueur.\\nSuspension 1 — {R} (Plutôt que jouer cette carte depuis votre main, vous pouvez payer {R} et la retirer de la partie avec un marqueur « temps » sur elle. Au début de votre entretien, retirez un marqueur « temps ». Quand vous retirez le dernier, jouez cette carte sans payer son coût de mana.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132755&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'eaa658b1-8d56-4c6d-a98a-66f696caff2a\', \'multiverseId\': 132755}, \'multiverseid\': 132755}, {\'name\': \'Saetta Squarciante\', \'text\': "La Saetta Squarciante infligge 3 danni a una creatura o a un giocatore bersaglio.\\nSospendere 1—{R} (Invece di giocare questa carta dalla tua mano, puoi pagare {R} e rimuoverla dal gioco con un segnalino tempo su di essa. All\'inizio del tuo mantenimento, rimuovi un segnalino tempo. Quando rimuovi l\'ultimo, gioca la carta senza pagare il suo costo di mana.)", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133357&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'aca50ff9-2ec1-461c-9a0c-02eef96b526a\', \'multiverseId\': 133357}, \'multiverseid\': 133357}, {\'name\': \'裂け目の稲妻\', \'text\': \'クリーチャー１体かプレイヤー１人を対象とする。裂け目の稲妻はそれに３点のダメージを与える。\\n待機 １―{R} （これをあなたの手札からプレイするのではなく、{R}を支払ってゲームから取り除き、その上に時間カウンターを１個置いてもよい。 あなたのアップキープの開始時に、時間カウンターを１個取り除く。 最後の１個を取り除いたとき、あなたはそれをマナ・コストを支払わずにプレイする。）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133658&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1af99236-aa1c-4852-b683-a31a2e9f3242\', \'multiverseId\': 133658}, \'multiverseid\': 133658}, {\'name\': \'Raio da Fenda\', \'text\': \'Raio da Fenda causa 3 pontos de dano à criatura alvo ou ao jogador alvo.\\nSuspender 1—{R} (Em vez de jogar este card da sua mão, você pode pagar {R} e removê-lo do jogo com um marcador temporal sobre ele. No início de sua manutenção, remova um marcador temporal. Quando remover o último, jogue-o sem pagar seu custo de mana.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133959&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'fa0c4daf-2328-4e3f-a395-7bb17ae762e0\', \'multiverseId\': 133959}, \'multiverseid\': 133959}, {\'name\': \'Удар Разлома\', \'text\': \'Удар Разлома наносит 3 повреждения целевому существу или игроку.\\nОтсрочка 1—{R} (Вместо того чтобы сыграть эту карту из вашей руки, заплатите {R} и удалите ее из игры с одним временным жетоном на ней. В начале вашего шага поддержки удалите один временной жетон. После удаления последнего жетона сыграйте эту карту без оплаты ее мана-стоимости.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134260&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5433fc82-8bbd-4805-a91c-73c54b8285fd\', \'multiverseId\': 134260}, \'multiverseid\': 134260}, {\'name\': \'时缝之雷\', \'text\': \'时缝之雷对目标生物或牌手造成3点伤害。\\n延缓1～{R}（除了从你手上使用此牌，你可以支付{R}并将此牌移出对战，且上面有一个计时指示物。 在你的维持开始时，从其上移去一个计时指示物。 当你移去最后一个时，则使用它且不需支付其法术力费用。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132454&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7f64f9a9-1163-44ab-9605-36859393cbe5\', \'multiverseId\': 132454}, \'multiverseid\': 132454}]', '[{\'name\': \'Erstickender Ruß\', \'text\': \'Zerstöre eine Kreatur deiner Wahl mit Widerstandskraft 3 oder weniger.\\nRückblende {5}{R} (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Spontanzauber\', \'flavor\': \'„Was nützt dir die beste Klinge, wenn du keine Puste mehr hast?" —Greht, Gathas Kriegsfürst\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133091&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'20fd0e37-0b2d-4581-99d4-3444011e4644\', \'multiverseId\': 133091}, \'multiverseid\': 133091}, {\'name\': \'Hollín estrangulador\', \'text\': \'Destruye la criatura atacante objetivo con fuerza de 3 o menos.\\nRetrospectiva {5}{R} (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Instantáneo\', \'flavor\': \'"¿De qué te sirve tu espada sin tu aliento?" —Greht, señor guerrero de Keldon\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134596&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5a6f9f5f-fec1-48b4-ac88-0df83c3a6bdf\', \'multiverseId\': 134596}, \'multiverseid\': 134596}, {\'name\': \'Suie étrangleuse\', \'text\': "Détruisez la créature ciblée dont l\'endurance est de 3 ou moins.\\nFlashback {5}{R} (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Éphémère\', \'flavor\': \'« Que vaut ta lame si tu perds ton souffle ? » —Greht, seigneur de guerre gathan\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132790&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'7cd4c40c-e838-4ab2-8879-d98fc6beb53a\', \'multiverseId\': 132790}, \'multiverseid\': 132790}, {\'name\': \'Fuliggine Soffocante\', \'text\': \'Distruggi una creatura bersaglio con costituzione pari o inferiore a 3.\\nFlashback {5}{R} (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Istantaneo\', \'flavor\': \'"Cosa serve la tua spada se non respiri?" —Greht, Signore della Guerra di Gatha\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133392&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'02d46e2e-264a-415c-86c1-c10e9f64fa00\', \'multiverseId\': 133392}, \'multiverseid\': 133392}, {\'name\': \'絞殺の煤\', \'text\': \'タフネスが３以下のクリーチャー１体を対象とし、それを破壊する。\\nフラッシュバック {5}{R} （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'インスタント\', \'flavor\': \'息の続かぬ者の刃など何の役に立つのだ？ ――ガーサの大将軍、グレット\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133693&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'aa08efa0-ad93-476e-88aa-ea9b51b7abf3\', \'multiverseId\': 133693}, \'multiverseid\': 133693}, {\'name\': \'Fuligem Estranguladora\', \'text\': \'Destrua a criatura alvo com resistência menor ou igual a 3.\\nRecapitular {5}{R} (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': \'"De que serve sua lâmina sem seu hálito?" —Greht, comandante gathaniano\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133994&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'61954937-c231-4981-80de-988dff19ee56\', \'multiverseId\': 133994}, \'multiverseid\': 133994}, {\'name\': \'Удушливая Сажа\', \'text\': \'Уничтожьте целевое существо с защитой 3 или меньше.\\nВоспоминание {5}{R} (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем уберите ее из игры.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': \'«Зачем тебе клинок, если ты уже не дышишь?», Грет, Гатанский полководец\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134295&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'55bcecf3-bf23-450f-8b9a-69d8fcaa9ca8\', \'multiverseId\': 134295}, \'multiverseid\': 134295}, {\'name\': \'窒息煤烟\', \'text\': \'消灭目标防御力等于或小于3的生物。\\n返照{5}{R}（你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'瞬间\', \'flavor\': \'「你若断了气，还斩得了谁？」 ～迦沙的军阀给特\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132489&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b3646cd9-f5da-4232-bd56-4e0ba19a6629\', \'multiverseId\': 132489}, \'multiverseid\': 132489}]', '[{\'name\': \'Ewigkeitsschlinge\', \'text\': \'Kreaturenverzauberung\\nWenn die Ewigkeitsschlinge ins Spiel kommt, ziehe eine Karte.\\nDie verzauberte Kreatur enttappt nicht während des Enttappsegments ihres Beherrschers.\', \'type\': \'Verzauberung — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132922&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'1610478a-fd70-4a58-814b-e1e710a12e90\', \'multiverseId\': 132922}, \'multiverseid\': 132922}, {\'name\': \'Trampa de eternidad\', \'text\': \'Encantar criatura.\\nCuando la Trampa de eternidad entre en juego, roba una carta.\\nLa criatura encantada no se endereza durante el paso de enderezar de su controlador.\', \'type\': \'Encantamiento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134427&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'0844ccda-7ce2-482e-80d0-bd3788ca20fd\', \'multiverseId\': 134427}, \'multiverseid\': 134427}, {\'name\': "Collet d\'éternité", \'text\': "Enchanter : créature\\nQuand le Collet d\'éternité arrive en jeu, piochez une carte.\\nLa créature enchantée ne se dégage pas pendant l\'étape de dégagement de son contrôleur.", \'type\': \'Enchantement : aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132621&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'87b810e1-d545-41af-be9e-bdc0df5182b8\', \'multiverseId\': 132621}, \'multiverseid\': 132621}, {\'name\': "Calappio d\'Eternità", \'text\': "Incanta creatura\\nQuando il Calappio d\'Eternità entra in gioco, pesca una carta.\\nLa creatura incantata non STAPpa durante lo STAP del proprio controllore.", \'type\': \'Incantesimo — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133223&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'586613fe-ff65-47b2-af3a-6714d0c4d1e8\', \'multiverseId\': 133223}, \'multiverseid\': 133223}, {\'name\': \'永遠の罠\', \'text\': \'エンチャント（クリーチャー）\\n永遠の罠が場に出たとき、カードを１枚引く。\\nエンチャントされているクリーチャーは、それのコントローラーのアンタップ・ステップにアンタップしない。\', \'type\': \'エンチャント — オーラ\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133524&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7584d3a9-6886-4c88-8de5-3f9771a4aeff\', \'multiverseId\': 133524}, \'multiverseid\': 133524}, {\'name\': \'Armadilha da Eternidade\', \'text\': \'Encantar Criatura\\nQuando Armadilha da Eternidade entrar em jogo, compre um card.\\nA criatura encantada não é desvirada durante a etapa de desvirar de seu controlador.\', \'type\': \'Encantamento — Aura\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133825&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'d80c34bb-e23b-495d-b8f6-3edc851a0065\', \'multiverseId\': 133825}, \'multiverseid\': 133825}, {\'name\': \'Западня Вечности\', \'text\': \'Зачаровать существо\\nКогда Западня Вечности входит в игру возьмите карту.\\nЗачарованное существо не разворачивается во время шага разворота контролирующего его игрока.\', \'type\': \'Чары — Аура\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134126&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'fadd7ef8-1ada-4410-bbc1-82cd2d7149b7\', \'multiverseId\': 134126}, \'multiverseid\': 134126}, {\'name\': \'恒久绊索\', \'text\': \'生物结界\\n当恒久绊索进场时，抓一张牌。\\n受此结界的生物于其操控者的重置步骤中不能重置。\', \'type\': \'结界～灵气\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132320&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'9677ed12-48b7-4a00-9e6f-1ec9cf008c53\', \'multiverseId\': 132320}, \'multiverseid\': 132320}]', '[{\'name\': \'Felsenburg-Aufpasser\', \'text\': \'FliegendIrrealität (Diese Kreatur kann nur Kreaturen mit Irrealität blocken und nur von solchen geblockt werden.)\\n{B}{B}: Kreaturen mit Irrealität erhalten +1/+0 bis zum Ende des Zuges und Kreaturen ohne Irrealität erhalten -1/+0 bis zum Ende des Zuges.\', \'type\': \'Kreatur — Dämon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133093&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3ce7a0cf-5e43-4bd7-b482-ebb3b0ddb5da\', \'multiverseId\': 133093}, \'multiverseid\': 133093}, {\'name\': \'Supervisor de la Fortaleza\', \'text\': \'Vuela.\\nSe desvanece (Esta criatura sólo puede bloquear o ser bloqueada por criaturas con la habilidad de desvanecerse.)\\n{B}{B}: Las criaturas con la habilidad de desvanecerse obtienen +1/+0 hasta el final del turno y las criaturas sin la habilidad de desvanecerse obtienen -1/-0 hasta el final del turno.\', \'type\': \'Criatura — Demonio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134598&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'840d18db-b6f6-43a9-8133-77d31a226de2\', \'multiverseId\': 134598}, \'multiverseid\': 134598}, {\'name\': \'Brigadier de la forteresse\', \'text\': "Vol\\nDistorsion (Cette créature ne peut bloquer ou être bloquée que par des créatures avec la distorsion.)\\n{B}{B} : Les créatures avec la distorsion gagnent +1/+0 jusqu\'à la fin du tour et les créatures sans la distorsion gagnent -1/-0 jusqu\'à la fin du tour.", \'type\': \'Créature : démon\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132792&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'fa8623be-7717-4b11-afb0-8db5409df5e5\', \'multiverseId\': 132792}, \'multiverseid\': 132792}, {\'name\': \'Custode della Fortezza\', \'text\': \'Volare\\nOmbra (Questa creatura può bloccare o essere bloccata soltanto da creature con ombra.)\\n{B}{B}: Le creature con ombra prendono +1/+0 fino alla fine del turno e le creature senza ombra prendono -1/-0 fino alla fine del turno.\', \'type\': \'Creatura — Demone\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133394&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'758d3d81-b4ea-44e2-a462-24d7b6229207\', \'multiverseId\': 133394}, \'multiverseid\': 133394}, {\'name\': \'要塞の監視者\', \'text\': \'飛行\\nシャドー （このクリーチャーは、シャドーを持つクリーチャーのみをブロックでき、ブロックされる。）\\n{B}{B}：シャドーを持つクリーチャーはターン終了時まで＋１/＋０の修整を受け、シャドーを持たないクリーチャーはターン終了時まで－１/－０の修整を受ける。\', \'type\': \'クリーチャー — デーモン\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133695&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'ace9304a-1318-42c8-a405-a88805edb4e3\', \'multiverseId\': 133695}, \'multiverseid\': 133695}, {\'name\': \'Supervisor da Fortaleza\', \'text\': \'Voar\\nSombra (Esta criatura só pode bloquear ou ser bloqueada por criaturas com sombra.)\\n{B}{B}: As criaturas com sombra recebem +1/+0 até o final do turno e as criaturas sem sombra recebem -1/-0 até o final do turno.\', \'type\': \'Criatura — Demônio\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133996&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'95c29ebb-da70-49c7-b905-e0e2b0602eb5\', \'multiverseId\': 133996}, \'multiverseid\': 133996}, {\'name\': \'Надсмотрщик из Стронгхолда\', \'text\': \'Полет\\nТень (Это существо может блокировать и быть заблокировано только существ(ами) с тенью.)\\n{B}{B}: Существа с тенью получают +1/+0 до конца хода и существа без тени получают -1/-0 до конца хода.\', \'type\': \'Существо — Демон\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134297&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ae34ca20-18c3-44da-9d73-e6e0609c918d\', \'multiverseId\': 134297}, \'multiverseid\': 134297}, {\'name\': \'城塞督军\', \'text\': \'飞行\\n次元幽影（此生物只能阻挡具次元幽影异能的生物，亦只能被具此异能的生物阻挡。）\\n{B}{B}：直到回合结束，具次元幽影异能的生物得+1/+0，不具次元幽影异能的生物得-1/-0。\', \'type\': \'生物～恶魔\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132491&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'318e5c31-0a27-4d0b-a16f-fc3943179c7e\', \'multiverseId\': 132491}, \'multiverseid\': 132491}]', '[{\'name\': \'Fesseltrick\', \'text\': \'Sekundenbruchteil (Solange dieser Zauberspruch sich auf dem Stapel befindet, können Spieler keine Zaubersprüche oder aktivierte Fähigkeiten spielen, die keine Manafähigkeiten sind.)\\nNeutralisiere eine aktivierte oder ausgelöste Fähigkeit deiner Wahl. Falls auf diese Weise die Fähigkeit einer bleibenden Karte neutralisiert wurde, können aktivierte Fähigkeiten dieser bleibenden Karte in diesem Zug nicht gespielt werden. (Manafähigkeiten können nicht als Ziel bestimmt werden.)\', \'type\': \'Spontanzauber\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133124&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'b367e6fd-c9e3-4d0f-af6c-f624bcb60c56\', \'multiverseId\': 133124}, \'multiverseid\': 133124}, {\'name\': \'Truco del lazo\', \'text\': \'Fracción de segundo (Mientras este hechizo esté en la pila, los jugadores no pueden jugar hechizos o habilidades activadas que no sean habilidades de maná.)\\nContrarresta la habilidad activada o disparada objetivo. Si la habilidad de un permanente es contrarrestada de esta manera, las habilidades activadas de ese permanente no pueden jugarse este turno. (Las habilidades de maná no pueden hacerse objetivo.)\', \'type\': \'Instantáneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134629&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'5c187604-3749-4166-9d75-baf8366f076e\', \'multiverseId\': 134629}, \'multiverseid\': 134629}, {\'name\': \'Trompentrave\', \'text\': "Fraction de seconde (Tant que ce sort est sur la pile, les joueurs ne peuvent pas jouer de sorts ou de capacités activées qui ne sont pas des capacités de mana.)\\nContrecarrez la capacité activée ou déclenchée ciblée. Si une capacité d\'un permanent est contrecarrée de cette manière, les capacités activées de ce permanent ne peuvent pas être jouées ce tour-ci. (Les capacités de mana ne peuvent pas être ciblées.)", \'type\': \'Éphémère\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132823&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'ad31998d-3b02-409a-bc0c-037f62f0c721\', \'multiverseId\': 132823}, \'multiverseid\': 132823}, {\'name\': \'Vincolo Ingannevole\', \'text\': "Battibaleno (Fintanto che questa magia è in pila, i giocatori non possono giocare magie o abilità attivate che non siano abilità di mana.)\\nNeutralizza un\'abilità attivata o innescata bersaglio. Se viene neutralizzata l\'abilità di un permanente in questo modo, le abilità attivate di quel permanente non possono essere giocate in questo turno. (Le abilità di mana non possono essere scelte come bersaglio.)", \'type\': \'Istantaneo\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133425&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'76220667-79b6-4218-929a-15e44842b6f4\', \'multiverseId\': 133425}, \'multiverseid\': 133425}, {\'name\': \'計略縛り\', \'text\': \'刹那 （この呪文がスタックにあるかぎり、プレイヤーは呪文やマナ能力でない起動型能力をプレイできない。）\\n起動型能力１つか誘発型能力１つを対象とし、それを打ち消す。 これによりパーマネントの能力が打ち消された場合、このターン、そのパーマネントの起動型能力はプレイできない。 （マナ能力は対象にできない。）\', \'type\': \'インスタント\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133726&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'866ac903-87a7-417a-a583-78ad358a4240\', \'multiverseId\': 133726}, \'multiverseid\': 133726}, {\'name\': \'Magiaprisionar\', \'text\': \'Fração de segundo (Enquanto esta mágica estiver na pilha, os jogadores não poderão jogar mágicas ou habilidades ativadas que não sejam habilidades de mana.)\\nAnule a habilidade ativada ou desencadeada alvo. Se a habilidade de uma permanente for anulada deste modo, as habilidades ativadas daquela permanente não poderão ser jogadas neste turno. (As habilidades de mana não podem ser alvo.)\', \'type\': \'Mágica Instantânea\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134027&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'9b79d596-c832-4a50-b96c-a5cc1a91e1d3\', \'multiverseId\': 134027}, \'multiverseid\': 134027}, {\'name\': \'Мысленный Трюк\', \'text\': \'Мгновение ока (До тех пор пока это заклинание находится в стеке, игроки не могут играть заклинания или активируемые способности, которые не являются мана-способностями.)\\nПрервите целевую активируемую или срабатывающую способность. Если способность перманента была прервана таким способом, то активируемые способности этого перманента не могут быть сыграны в этом ходу. (Нельзя прицелиться в мана-способности.)\', \'type\': \'Мгновенное заклинание\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134328&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'ab229267-8139-420e-bef2-857af7d92b2a\', \'multiverseId\': 134328}, \'multiverseid\': 134328}, {\'name\': \'诈缚\', \'text\': \'转瞬（只要此咒语在堆叠上，牌手便不能使用咒语或不是法术力异能的起动式异能。）\\n反击目标起动式或触发式异能。 如果某永久物的异能以此法被反击，则本回合中不能使用该永久物的起动式异能。 （其目标不能是法术力异能）\', \'type\': \'瞬间\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132522&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'f1102649-6428-4009-bcf8-8323583c5263\', \'multiverseId\': 132522}, \'multiverseid\': 132522}]', '[{\'name\': \'Feuermaul-Kavu\', \'text\': \'Echo {5}{R} (Opfere zu Beginn deines Versorgungssegments diese bleibende Karte, falls sie seit deinem letzten Versorgungssegment unter deine Kontrolle gekommen ist, falls du nicht ihre Echokosten bezahlst.)\\nWenn der Feuermaul-Kavu ins Spiel kommt, fügt er einer Kreatur deiner Wahl 2 Schadenspunkte zu.\\nWenn der Feuermaul-Kavu das Spiel verlässt, fügt er einer Kreatur deiner Wahl 4 Schadenspunkte zu.\', \'type\': \'Kreatur — Kavu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132929&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'65da3892-145e-4113-b7aa-b9ced59d9674\', \'multiverseId\': 132929}, \'multiverseid\': 132929}, {\'name\': \'Kavu garganta de fuego\', \'text\': \'Eco {5}{R} (Al comienzo de tu mantenimiento, si esto entró bajo tu control desde el comienzo de tu último mantenimiento, sacrifícalo a menos que pagues su coste de eco.)\\nCuando el Kavu garganta de fuego entre en juego, hace 2 puntos de daño a la criatura objetivo.\\nCuando el Kavu garganta de fuego deje el juego, hace 4 puntos de daño a la criatura objetivo.\', \'type\': \'Criatura — Kavu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134434&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'eac336ce-b111-4057-96fb-6008ced91391\', \'multiverseId\': 134434}, \'multiverseid\': 134434}, {\'name\': \'Kavru gueuldefeu\', \'text\': "Écho {5}{R} (Au début de votre entretien, si ce permanent est passé sous votre contrôle depuis le début de votre dernier entretien, sacrifiez-le à moins que vous ne payiez son coût d\'écho.)\\nQuand le Kavru gueuldefeu arrive en jeu, il inflige 2 blessures à la créature ciblée.\\nQuand le Kavru gueuldefeu quitte le jeu, il inflige 4 blessures à la créature ciblée.", \'type\': \'Créature : kavru\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132628&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'2816e2a6-91eb-45bc-896c-4927f4bbe9e9\', \'multiverseId\': 132628}, \'multiverseid\': 132628}, {\'name\': \'Kavu Fauce Infuocata\', \'text\': "Eco {5}{R} (All\'inizio del tuo mantenimento, se questo permanente è entrato sotto il tuo controllo dall\'inizio del tuo ultimo mantenimento, sacrificalo a meno che non paghi il suo costo di eco.)\\nQuando il Kavu Fauce Infuocata entra in gioco, infligge 2 danni a una creatura bersaglio.\\nQuando il Kavu Fauce Infuocata lascia il gioco, infligge 4 danni a una creatura bersaglio.", \'type\': \'Creatura — Kavu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133230&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'560cc2ae-0cec-4403-a9d4-56f2e713ef50\', \'multiverseId\': 133230}, \'multiverseid\': 133230}, {\'name\': \'大火口のカヴー\', \'text\': \'エコー {5}{R} （あなたのアップキープの開始時に、これが直前のあなたのアップキープの開始時よりも後にあなたのコントロール下になっていた場合、それのエコー・コストを支払わないかぎり、それを生け贄に捧げる。）\\n大火口のカヴーが場に出たとき、クリーチャー１体を対象とする。大火口のカヴーはそれに２点のダメージを与える。\\n大火口のカヴーが場を離れたとき、クリーチャー１体を対象とする。大火口のカヴーはそれに４点のダメージを与える。\', \'type\': \'クリーチャー — カヴー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133531&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'e0aad706-89de-444a-b74a-a653e7e0d08e\', \'multiverseId\': 133531}, \'multiverseid\': 133531}, {\'name\': \'Kavu Ignívomo\', \'text\': \'Eco {5}{R} (No início de sua manutenção, se esta permanente passou a estar sob o seu controle desde o início de sua última manutenção, sacrifique-a, a menos que você pague seu custo de eco.)\\nQuando Kavu Ignívomo entra em jogo, ele causa 2 pontos de dano à criatura alvo.\\nQuando Kavu Ignívomo deixa o jogo, ele causa 4 pontos de dano à criatura alvo.\', \'type\': \'Criatura — Kavu\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133832&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f86f2124-e853-4ae0-909c-7359f2ef5b23\', \'multiverseId\': 133832}, \'multiverseid\': 133832}, {\'name\': \'Огнедышащий Каву\', \'text\': \'Эхо {5}{R} (В начале вашего шага поддержки, если это существо попало под ваш контроль с момента начала вашего предыдущего шага поддержки, пожертвуйте его, если вы не заплатите его эхо-стоимость.)\\nКогда Огнедышащий Каву входит в игру, он наносит 2 повреждения целевому существу.\\nКогда Огнедышащий Каву покидает игру, он наносит 4 повреждения целевому существу.\', \'type\': \'Существо — Каву\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134133&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'a4023833-114d-4a8a-8a5c-4fe1c1b20b88\', \'multiverseId\': 134133}, \'multiverseid\': 134133}, {\'name\': \'焰喉卡甫\', \'text\': \'返响{5}{R}（在你的维持开始时，若你在你前一个维持开始后才操控它，则除非你支付其返响费用，否则牺牲之。）\\n当焰喉卡甫进场时，它对目标生物造成2点伤害。\\n当焰喉卡甫离场时，它对目标生物造成4点伤害。\', \'type\': \'生物～卡甫\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132327&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'cda9445d-034e-4ec7-9a68-caa7252cdf50\', \'multiverseId\': 132327}, \'multiverseid\': 132327}]', '[{\'name\': \'Feuerspurremasuri\', \'text\': \'Alle Remasuris haben Eile und „{1}, opfere diese Kreatur: Ein Remasuri deiner Wahl erhält +2/+2 bis zum Ende des Zuges."\', \'type\': \'Kreatur — Remasuri\', \'flavor\': \'„Sie sind da, und sie sind hungrig. Was sie nicht auffressen, verbrennen sie. Yavimaya ist verloren. Wir müssen versuchen, den Wolkenwald zu erreichen." —Edahlis, Pflanzensucher\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132930&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'83d8238b-12ba-4d5e-bec8-153a69e4f724\', \'multiverseId\': 132930}, \'multiverseid\': 132930}, {\'name\': \'Fragmentado estela de fuego\', \'text\': \'Todos los Fragmentados tienen la habilidad de prisa y "{1}, sacrificar esta criatura: El Fragmentado objetivo obtiene +2/+2 hasta el final del turno".\', \'type\': \'Criatura — Fragmentado\', \'flavor\': \'"Están aquí, y están hambrientos. Y lo que no comen, lo queman. Yavimaya está perdida. Debemos irnos hacia Veloceleste." —Édahlis, buscadora de verde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134435&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'4cd78abe-a80b-42a2-b1ad-7c5ea3cac79b\', \'multiverseId\': 134435}, \'multiverseid\': 134435}, {\'name\': \'Slivoïde houachefeu\', \'text\': "Tous les slivoïdes ont la célérité et « {1}, sacrifiez cette créature : Le slivoïde ciblé gagne +2/+2 jusqu\'à la fin du tour. »", \'type\': \'Créature : slivoïde\', \'flavor\': "« Ils sont là, et ils sont affamés. Et tout ce qu\'ils ne dévorent pas, ils le brûlent. La Yavimaya est perdue. Nous devons partir pour Linciel. » —Edahlis, chercheuse de verdure", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132629&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'daf08dea-2f35-41fb-b3ed-288f3acdd6b9\', \'multiverseId\': 132629}, \'multiverseid\': 132629}, {\'name\': \'Tramutante Scia Infuocata\', \'text\': \'Tutti i Tramutanti hanno rapidità e "{1}, Sacrifica questa creatura: Un Tramutante bersaglio prende +2/+2 fino alla fine del turno."\', \'type\': \'Creatura — Tramutante\', \'flavor\': \'"Sono qui e sono affamati. E quello che non mangiano, lo bruciano. Yavimaya è perduta. Dobbiamo partire subito per Cielsudario." —Edahlis, cercatrice verde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133231&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'7759cf82-1746-41a9-ba8f-93e7220eb3ab\', \'multiverseId\': 133231}, \'multiverseid\': 133231}, {\'name\': \'火跡スリヴァー\', \'text\': \'すべてのスリヴァーは、速攻と「{1}, このクリーチャーを生け贄に捧げる：スリヴァー１体を対象とする。それはターン終了時まで＋２/＋２の修整を受ける。」の能力を持つ。\', \'type\': \'クリーチャー — スリヴァー\', \'flavor\': \'ここにもいるわ。飢えたのがね。 食べられないものは燃やしてしまうのよ。 ヤヴィマヤはもう無いわ。 今からスカイシュラウドに向かわなくちゃ。 ――緑探しのエダリス\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133532&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'89e9fbb6-482d-4eec-834a-ca5dcac71905\', \'multiverseId\': 133532}, \'multiverseid\': 133532}, {\'name\': \'Fractius Trilha de Fogo\', \'text\': \'Todos os Fractius têm ímpeto e "{1}, Sacrifique esta criatura: O Fractius alvo recebe +2/+2 até o final do turno."\', \'type\': \'Criatura — Fractius\', \'flavor\': \'"Eles estão aqui e estão famintos. E o que não comem, eles queimam. Yavimaya está perdida. Precisamos partir para Skyshroud." —Edahlis, busca-verde\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133833&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'24458a34-d2c6-4e95-9880-9897b65e3183\', \'multiverseId\': 133833}, \'multiverseid\': 133833}, {\'name\': \'Щепка с Огненным Следом\', \'text\': \'Все Щепки обладают способностями Ускорение и "{1}, Пожертвуйте это существо: Целевая щепка получает +2/+2 до конца хода."\', \'type\': \'Существо — Щепка\', \'flavor\': \'«Они здесь, и они голодны. Все, что они не едят, они сжигают. Явимая потеряна. Мы должны уходить немедленно в Скайшрауд», Эдалис, искатель цветущих цемель\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134134&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'edd5c710-b4b9-44f3-aa23-4a14ce9b3543\', \'multiverseId\': 134134}, \'multiverseid\': 134134}, {\'name\': \'焰迹裂片妖\', \'text\': \'所有裂片妖具有敏捷异能与「{1}，牺牲此生物：目标裂片妖得+2/+2直到回合结束。」\', \'type\': \'生物～裂片妖\', \'flavor\': \'「他们饥肠辘辘地来到这里。 不能吃的东西就烧掉。 亚维马雅已经完了。 我们该立刻到天帷去。」 ～寻碧者艾达黎\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132328&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a58c530-078a-4e2d-8501-2d67cb41cb34\', \'multiverseId\': 132328}, \'multiverseid\': 132328}]', '[{\'name\': \'Flackernder Geist\', \'text\': \'Fliegend\\n{3}{W}: Entferne den Flackernden Geist ganz aus dem Spiel und bringe ihn dann unter der Kontrolle seines Besitzers ins Spiel zurück.\', \'type\': \'Kreatur — Geist\', \'flavor\': \'Jedes Mal, wenn er diese Welt verlässt, hofft er, in eine andere wiedergeboren zu werden.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132934&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c9a51d07-f881-4b1d-9fde-3cca20ede623\', \'multiverseId\': 132934}, \'multiverseid\': 132934}, {\'name\': \'Espíritu fluctuante\', \'text\': \'Vuela.\\n{3}{W}: Remueve del juego el Espíritu fluctuante, luego regrésalo al juego bajo el control de su propietario.\', \'type\': \'Criatura — Espíritu\', \'flavor\': \'Cada vez que desaparece lo hace con la esperanza de no volver a la misma desolación que deja atrás.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134439&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'db4b25e0-df8b-48a9-8e1b-a13400d1222c\', \'multiverseId\': 134439}, \'multiverseid\': 134439}, {\'name\': \'Esprit scintillant\', \'text\': "Vol\\n{3}{W} : Retirez l\'Esprit scintillant de la partie, puis renvoyez-le en jeu sous le contrôle de son propriétaire.", \'type\': \'Créature : esprit\', \'flavor\': "Il disparaît chaque fois avec l\'espoir de ne pas revoir lorsqu\'il réapparaîtra la désolation qu\'il a laissée derrière lui en partant.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132633&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3df4e0f2-336b-42d2-a5e0-55541c06d9c4\', \'multiverseId\': 132633}, \'multiverseid\': 132633}, {\'name\': \'Spirito Guizzante\', \'text\': \'Volare\\n{3}{W}: Rimuovi dal gioco lo Spirito Guizzante, poi rimettilo in gioco sotto il controllo del suo proprietario.\', \'type\': \'Creatura — Spirito\', \'flavor\': \'Ogni volta svanisce sperando di non ritornare nella stessa desolazione che si è lasciato dietro.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133235&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'9478d109-b04c-49c2-9712-abf958208e32\', \'multiverseId\': 133235}, \'multiverseid\': 133235}, {\'name\': \'ちらつくスピリット\', \'text\': \'飛行\\n{3}{W}：ちらつくスピリットをゲームから取り除き、その後それをオーナーのコントロール下で場に戻す。\', \'type\': \'クリーチャー — スピリット\', \'flavor\': \'それは自分が消えるとき、いつも自分が残した荒廃の地に戻らないことを願っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133536&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'87dcd9a6-1019-454f-859d-f7b074504199\', \'multiverseId\': 133536}, \'multiverseid\': 133536}, {\'name\': \'Espírito Flutuante\', \'text\': \'Voar\\n{3}{W}: Remova Espírito Flutuante do jogo e, em seguida, devolva-o ao jogo sob o controle de seu dono.\', \'type\': \'Criatura — Espírito\', \'flavor\': \'Ele desaparece a cada vez com a esperança de não voltar à mesma desolação que deixou para trás.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133837&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'bdf1b68c-1123-4235-b6b6-fc1cb67d4611\', \'multiverseId\': 133837}, \'multiverseid\': 133837}, {\'name\': \'Мерцающий Дух\', \'text\': \'Полет\\n{3}{W}: Удалите Мерцающего Духа из игры, затем верните его в игру под контролем его владельца.\', \'type\': \'Существо — Дух\', \'flavor\': \'Он всегда исчезает в надежде, что не вернется в ту же пустоту, которую оставил за собой.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134138&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'c1d38f9a-98dd-40eb-8b0b-e3351bc4f6c9\', \'multiverseId\': 134138}, \'multiverseid\': 134138}, {\'name\': \'明灭精怪\', \'text\': \'飞行\\n{3}{W}：将明灭精怪移出对战，然后将它在其拥有者的操控下返回场上。\', \'type\': \'生物～精怪\', \'flavor\': \'它每次消失时，都希望别再回到同样的荒境。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132332&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'aa3d2f20-aa89-4c45-a657-1c0e7b20b33d\', \'multiverseId\': 132332}, \'multiverseid\': 132332}]', '[{\'name\': \'Flammenbrunst\', \'text\': \'Flammenbrunst fügt X Schadenspunkte zu, deren Verteilung auf eine beliebige Anzahl an Kreaturen und/oder Spielern deiner Wahl du bestimmst.\\nRückblende—{R}{R}, wirf X Karten aus deiner Hand ab. (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132894&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'c2e33ee6-1745-48dc-b90c-8cb88769977b\', \'multiverseId\': 132894}, \'multiverseid\': 132894}, {\'name\': \'Conflagrar\', \'text\': \'Conflagrar hace X puntos de daño divididos como elijas entre cualquier número de criaturas y/o jugadores objetivo.\\nRetrospectiva—{R}{R}, descartar X cartas. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Conjuro\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134399&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'69e439e7-84ac-4c5c-8a8d-abdc66c88397\', \'multiverseId\': 134399}, \'multiverseid\': 134399}, {\'name\': \'Conflagration\', \'text\': "La Conflagration inflige X blessures réparties comme vous le désirez entre n\'importe quel nombre de cibles, créatures et/ou joueurs.\\nFlashback — {R}{R}, défaussez-vous de X cartes. (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132593&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'05abb4c1-dda5-4894-9fd8-d055f3f8664f\', \'multiverseId\': 132593}, \'multiverseid\': 132593}, {\'name\': \'Conflagrazione\', \'text\': \'La Conflagrazione infligge X danni suddivisi a tua scelta tra un qualsiasi numero di creature e/o giocatori bersaglio.\\nFlashback—{R}{R}, Scarta X carte. (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133195&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'95a7bd28-b1d3-4abb-9e26-86bf96347ec9\', \'multiverseId\': 133195}, \'multiverseid\': 133195}, {\'name\': \'燃焼\', \'text\': \'望む数のクリーチャーかプレイヤー（またはその組み合わせ）を対象とする。燃焼は、それらにＸ点のダメージを好きなように割り振って与える。\\nフラッシュバック ― {R}{R}, カードをＸ枚捨てる。 （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133496&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'80da4f48-9f5b-4a80-a155-b3ab4915fb11\', \'multiverseId\': 133496}, \'multiverseid\': 133496}, {\'name\': \'Conflagrar\', \'text\': \'Conflagrar causa X pontos de dano, distribuídos à sua escolha a qualquer número de criaturas alvo e/ou jogadores alvo.\\nRecapitular—{R}{R}, Descarte X cards. (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133797&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'535e3a9c-93a2-49c5-91a6-494f56524d41\', \'multiverseId\': 133797}, \'multiverseid\': 133797}, {\'name\': \'Поджог\', \'text\': \'Поджог наносит X повреждений, разделенных по вашему выбору между любым количеством целевых существ и/или игроков.\\nВоспоминание—{R}{R}, Сбросьте X карт. (Вы можете играть эту карту из своего кладбища за ее стоимость воспоминания. Затем удалите ее из игры.)\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134098&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'5bc0665c-bbb5-41ef-8aed-862f9e7d8bba\', \'multiverseId\': 134098}, \'multiverseid\': 134098}, {\'name\': \'暴燃\', \'text\': \'暴燃对任意数量的目标生物和／或牌手造成共X点伤害，你可以任意分配。\\n返照～{R}{R}，弃X张牌。 （你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132292&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'bb4589b3-357b-43d4-823b-35784c8b0753\', \'multiverseId\': 132292}, \'multiverseid\': 132292}]', '[{\'name\': \'Flammenkernelementar\', \'text\': \'Echo {2}{R}{R} (Opfere zu Beginn deines Versorgungssegments diese bleibende Karte, falls sie seit deinem letzten Versorgungssegment unter deine Kontrolle gekommen ist, falls du nicht ihre Echokosten bezahlst.)\', \'type\': \'Kreatur — Elementarwesen\', \'flavor\': \'Für ein Feuerelementar sind Narren und Nahrung identisch.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132932&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'df02c80a-e14e-4aa5-a758-e7dedbf0dd46\', \'multiverseId\': 132932}, \'multiverseid\': 132932}, {\'name\': \'Elemental núcleo de llama\', \'text\': \'Eco {2}{R}{R} (Al comienzo de tu mantenimiento, si esto entró bajo tu control desde el comienzo de tu último mantenimiento, sacrifícalo a menos que pagues su coste de eco.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Para un elemental de fuego, los tontos sirven de combustible.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134437&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'1cc944ba-c5fa-415f-a0d9-f21b7ac33149\', \'multiverseId\': 134437}, \'multiverseid\': 134437}, {\'name\': \'Élémental au cœur de feu\', \'text\': "Écho {2}{R}{R} (Au début de votre entretien, si ce permanent est passé sous votre contrôle depuis le début de votre dernier entretien, sacrifiez-le à moins que vous ne payiez son coût d\'écho.)", \'type\': \'Créature : élémental\', \'flavor\': "Pour un élémental de feu, même l\'imbécillité est une source d\'énergie.", \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132631&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f233cf23-2e50-4fdc-95d5-febea6b9103e\', \'multiverseId\': 132631}, \'multiverseid\': 132631}, {\'name\': \'Elementale Nucleo di Fiamme\', \'text\': "Eco {2}{R}{R} (All\'inizio del tuo mantenimento, se questo permanente è entrato sotto il tuo controllo dall\'inizio del tuo ultimo mantenimento, sacrificalo a meno che non paghi il suo costo di eco.)", \'type\': \'Creatura — Elementale\', \'flavor\': \'Per una elementale del fuoco, gli imprudenti e i carburanti sono la stessa identica cosa.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133233&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'650ae7e0-c61f-4fee-920d-6e22811b2993\', \'multiverseId\': 133233}, \'multiverseid\': 133233}, {\'name\': \'炎核の精霊\', \'text\': \'エコー {2}{R}{R} （あなたのアップキープの開始時に、これが直前のあなたのアップキープの開始時よりも後にあなたのコントロール下になっていた場合、それのエコー・コストを支払わないかぎり、それを生け贄に捧げる。）\', \'type\': \'クリーチャー — エレメンタル\', \'flavor\': \'炎の精霊にとって、愚鈍も炭団も同じものに過ぎない。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133534&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'1cb762e7-21ad-409b-8b44-25ca8baaef2e\', \'multiverseId\': 133534}, \'multiverseid\': 133534}, {\'name\': \'Elemental Âmago de Fogo\', \'text\': \'Eco {2}{R}{R} (No início de sua manutenção, se esta permanente passou a estar sob o seu controle desde o início de sua última manutenção, sacrifique-a, a menos que você pague seu custo de eco.)\', \'type\': \'Criatura — Elemental\', \'flavor\': \'Para um elemental do fogo, o tolo e o fogo formam um par perfeito.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133835&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'2983da04-5e85-42c5-9dd1-964f178ba841\', \'multiverseId\': 133835}, \'multiverseid\': 133835}, {\'name\': \'Элементаль из Огня\', \'text\': \'Эхо {2}{R}{R} (В начале вашего шага поддержки, если это существо попало под ваш контроль с момента начала вашего предыдущего шага поддержки, пожертвуйте его, если вы не заплатите его эхо-стоимость.)\', \'type\': \'Существо — Элементаль\', \'flavor\': \'Для огненных элементалей дураки и топливо суть одно и то же.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134136&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'8486d588-b9d7-43b7-9eb5-528495da1462\', \'multiverseId\': 134136}, \'multiverseid\': 134136}, {\'name\': \'焰核元素\', \'text\': \'返响{2}{R}{R}（在你的维持开始时，若你在你前一个维持开始后才操控它，则除非你支付其返响费用，否则牺牲之。）\', \'type\': \'生物～元素\', \'flavor\': \'对火元素来说，愚昧与燃煤是同一回事。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132330&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'b8e6823c-9f7f-406d-bdbf-8a6728a14d0d\', \'multiverseId\': 132330}, \'multiverseid\': 132330}]', '[{\'name\': \'Fluch der Kabbalisten\', \'text\': \'Ein Spieler deiner Wahl opfert die Hälfte der bleibenden Karten, die er kontrolliert (abgerundet).\\nAussetzen 2 {2}{B}{B}\\nZu Beginn des Versorgungssegments jedes Spielers kann dieser Spieler eine bleibende Karte opfern, falls der Fluch der Kabbalisten ausgesetzt ist. Falls er dies tut, lege zwei Zeitmarken auf den Fluch der Kabbalisten.\', \'type\': \'Hexerei\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132898&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0951e21f-3a52-47d1-9781-280b0981306a\', \'multiverseId\': 132898}, \'multiverseid\': 132898}, {\'name\': \'Maldición de la Cábala\', \'text\': \'El jugador objetivo sacrifica la mitad de los permanentes que controla, redondeado hacia abajo.\\nSuspender 2—{2}{B}{B}\\nAl comienzo del mantenimiento de cada jugador, si la Maldición de la Cábala está suspendida, ese jugador puede sacrificar un permanente. Si lo hace, pon dos contadores de tiempo sobre la Maldición de la Cábala.\', \'type\': \'Conjuro\', \'flavor\': \'Un ojo de tumba puede permanecer cerrado por siglos. Se abre cuando ve un mundo torcido y hueco como el engendro bajo su párpado.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134403&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'438c70a0-6996-4e38-8c67-f6334c9e300e\', \'multiverseId\': 134403}, \'multiverseid\': 134403}, {\'name\': \'Malédiction de la Coterie\', \'text\': "Le joueur ciblé sacrifie la moitié des permanents qu\'il contrôle, arrondie à l\'unité inférieure.\\nSuspension 2 — {2}{B}{B}\\nAu début de l\'entretien de chaque joueur, si la Malédiction de la Coterie est en suspension, ce joueur peut sacrifier un permanent. S\'il fait ainsi, mettez deux marqueurs « temps » sur la Malédiction de la Coterie.", \'type\': \'Rituel\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132597&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'83f0f9b0-a2f2-4ae6-b13e-422289566efa\', \'multiverseId\': 132597}, \'multiverseid\': 132597}, {\'name\': \'Maledizione della Cabala\', \'text\': "Un giocatore bersaglio sacrifica metà dei permanenti che controlla, arrotondati per difetto.\\nSospendere 2—{2}{B}{B}\\nAll\'inizio del mantenimento di ogni giocatore, se la Maledizione della Cabala è sospesa, quel giocatore può sacrificare un permanente. Se lo fa, metti due segnalini tempo sulla Maledizione della Cabala.", \'type\': \'Stregoneria\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133199&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'2ff63816-13bf-49a7-a0cf-facc855672e5\', \'multiverseId\': 133199}, \'multiverseid\': 133199}, {\'name\': \'陰謀団の呪い\', \'text\': \'プレイヤー１人を対象とする。そのプレイヤーは、自分がコントロールするパーマネントを半分生け贄に捧げる（端数切捨て）。\\n待機 ２―{2}{B}{B}\\n各プレイヤーのアップキープの開始時に、陰謀団の呪いが待機状態である場合、そのプレイヤーはパーマネントを１つ生け贄に捧げてもよい。 そうした場合、陰謀団の呪いの上に時間カウンターを２個置く。\', \'type\': \'ソーサリー\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133500&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'7f33b321-87a0-418a-8a85-1329ad4e72f8\', \'multiverseId\': 133500}, \'multiverseid\': 133500}, {\'name\': \'Maldição da Cabala\', \'text\': \'O jogador alvo sacrifica metade das permanentes que ele controla, arredondada para baixo.\\nSuspender 2—{2}{B}{B}\\nNo início da manutenção de cada jogador, se Maldição da Cabala estiver suspensa, aquele jogador poderá sacrificar uma permanente. Se ele o fizer, coloque dois marcadores temporais sobre Maldição da Cabala.\', \'type\': \'Feitiço\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133801&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'54d3323d-d4c7-4dfc-8d1d-a3432160c487\', \'multiverseId\': 133801}, \'multiverseid\': 133801}, {\'name\': \'Проклятье Кабала\', \'text\': \'Целевой игрок жертвует половину перманентов под его контролем, с округлением вниз.\\nОтсрочка 2—{2}{B}{B}\\nВ начале каждого шага поддержки игрока, если Проклятье Кабала отсрочено, этот игрок может пожертвовать перманент. Если он или она делает это, положите два временных жетона на Проклятье Кабала.\', \'type\': \'Волшебство\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134102&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'74ac5ea9-d7bf-4b3d-9195-d92a5537c7d0\', \'multiverseId\': 134102}, \'multiverseid\': 134102}, {\'name\': \'柯帮诅咒\', \'text\': \'目标牌手牺牲一半数量由他操控的永久物，小数点后舍去。\\n延缓2～{2}{B}{B}\\n在每位牌手的维持开始时，若柯帮诅咒已延缓，则该牌手可以牺牲一个永久物。 若他如此作，则在柯帮诅咒上放置两个计时指示物。\', \'type\': \'法术\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132296&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'5a7f79e4-f053-4e55-915e-bb06ca60e39a\', \'multiverseId\': 132296}, \'multiverseid\': 132296}]', '[{\'name\': \'Foriysischer Abfänger\', \'text\': \'Aufblitzen (Du kannst diesen Zauberspruch zu jedem Zeitpunkt spielen, zu dem du einen Spontanzauber spielen könntest.)\\nVerteidiger\\nDer Foriysische Abfänger kann eine zusätzliche Kreatur blocken.\', \'type\': \'Kreatur — Mensch, Soldat\', \'flavor\': \'Rund um Foriys tun sich immer neue Risse im Zeitgefüge auf, so dass sich das Land gleichzeitig alter und neuer Gegner erwehren muss.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132941&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'0ac44807-8d6e-4b90-8f28-41f934a8e355\', \'multiverseId\': 132941}, \'multiverseid\': 132941}, {\'name\': \'Interceptor foriysiano\', \'text\': \'Destello (Puedes jugar este hechizo en cualquier momento en que pudieras jugar un instantáneo.)\\nDefensor.\\nEl Interceptor foriysiano puede bloquear una criatura adicional.\', \'type\': \'Criatura — Soldado humano\', \'flavor\': \'Un punto focal para las brechas temporales, Foriys tiene que lidiar simultáneamente con enemigos nuevos y viejos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134446&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'8e2c5b7a-8754-4dbf-8b1c-6f0e099eaf70\', \'multiverseId\': 134446}, \'multiverseid\': 134446}, {\'name\': \'Intercepteur foriysian\', \'text\': "Flash (Vous pouvez jouer ce sort à tout moment où vous pourriez jouer un éphémère.)\\nDéfenseur\\nL\'Intercepteur foriysian peut bloquer une créature supplémentaire.", \'type\': \'Créature : humain et soldat\', \'flavor\': \'Foriys, point focal des failles temporelles, doit combattre des adversaires à la fois anciens et modernes.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132640&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'99197821-d431-49d4-ad0b-bc16248b0708\', \'multiverseId\': 132640}, \'multiverseid\': 132640}, {\'name\': \'Intercettatore di Foriys\', \'text\': "Lampo (Puoi giocare questa magia in ogni momento in cui potresti giocare un istantaneo.)\\nDifensore\\nL\'Intercettatore di Foriys può bloccare una creatura addizionale.", \'type\': \'Creatura — Soldato Umano\', \'flavor\': \'Un punto focale per gli squarci temporali, Foriys combatte contemporaneamente con nemici sia vecchi che nuovi.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133242&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'1b514d07-4c0a-4cdf-aa6c-f41370265606\', \'multiverseId\': 133242}, \'multiverseid\': 133242}, {\'name\': \'フォライアスの介入者\', \'text\': \'瞬速 （あなたはこの呪文を、あなたがインスタントをプレイできるときならいつでもプレイしてよい。）\\n防衛\\nフォライアスの介入者は、さらに１体のクリーチャーをブロックできる。\', \'type\': \'クリーチャー — 人間・兵士\', \'flavor\': \'時の裂け目の焦点となったフォライアスは、新たな敵と古い敵の両方と同時に戦っている。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133543&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'2f752437-bab1-4d82-9e25-0f9f04e8a52e\', \'multiverseId\': 133543}, \'multiverseid\': 133543}, {\'name\': \'Interceptador Foriysiano\', \'text\': \'Lampejo (Você poderá jogar esta mágica a qualquer momento em que puder jogar uma mágica instantânea.)\\nDefensor\\nInterceptador Foriysiano pode bloquear uma criatura adicional.\', \'type\': \'Criatura — Soldado Humano\', \'flavor\': \'Um ponto focal para as fendas do tempo, Foriys luta simultaneamente com inimigos novos e antigos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133844&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'6c60d5b6-8fe9-49cf-b918-9e818f8aaae1\', \'multiverseId\': 133844}, \'multiverseid\': 133844}, {\'name\': \'Форисиаский Перехватчик\', \'text\': \'Миг (Вы можете играть это заклинание в любое время, когда вы можете играть мгновенные заклинания.)\\nЗащитник\\nФорисианский Перехватчик может блокировать дополнительное существо.\', \'type\': \'Существо — Человек Солдат\', \'flavor\': \'В фокусе временного разлома Форисианцы столкнулись и с прежними, и с новыми врагами.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134145&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'4d8a0762-700f-4690-a9b7-8a1ba9c55094\', \'multiverseId\': 134145}, \'multiverseid\': 134145}, {\'name\': \'佛绿耶斯拦截者\', \'text\': \'闪现（你可以于你能够使用瞬间的时机下使用此咒语。）\\n守军\\n佛绿耶斯拦截者可以额外多阻挡一个生物。\', \'type\': \'生物～人类／士兵\', \'flavor\': \'佛绿耶斯正处时间裂缝的中心，必须同时对抗新仇与旧敌。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132339&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'02a067cd-1545-448a-85ef-2d61eba2c19c\', \'multiverseId\': 132339}, \'multiverseid\': 132339}]', '[{\'name\': \'Foriysisches Totem\', \'text\': \'{T}: Erhöhe deinen Manavorrat um {R}.\\n{4}{R}: Das Foriysische Totem wird bis zum Ende des Zuges zu einer 4/4 roten Riese-Artefaktkreatur, die Trampelschaden verursacht.\\nSolange das Foriysische Totem eine Kreatur ist, kann es eine zusätzliche Kreatur blocken.\', \'type\': \'Artefakt\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132942&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'3d93727f-e840-47c9-98ee-dc9aa39d4ea7\', \'multiverseId\': 132942}, \'multiverseid\': 132942}, {\'name\': \'Tótem foriysiano\', \'text\': \'{T}: Agrega {R} a tu reserva de maná.\\n{4}{R}: El Tótem foriysiano es una criatura artefacto Gigante roja 4/4 con la habilidad de arrollar hasta el final del turno.\\nMientras el Tótem foriysiano sea una criatura, puede bloquear una criatura adicional.\', \'type\': \'Artefacto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134447&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a9aaf6ee-e780-4673-b05c-eb4a54e3cf52\', \'multiverseId\': 134447}, \'multiverseid\': 134447}, {\'name\': \'Totem de Foriys\', \'text\': "{T} : Ajoutez {R} à votre réserve.\\n{4}{R} : Le Totem de Foriys devient une créature-artefact 4/4 rouge Géant avec le piétinement jusqu\'à la fin du tour.\\nTant que le Totem de Foriys est une créature, il peut bloquer une créature supplémentaire.", \'type\': \'Artefact\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132641&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'3b01bc96-657d-4d97-a55b-5ccd90189643\', \'multiverseId\': 132641}, \'multiverseid\': 132641}, {\'name\': \'Totem di Foriys\', \'text\': \'{T}: Aggiungi {R} alla tua riserva di mana.\\n{4}{R}: Il Totem di Foriys diventa una creatura artefatto Gigante 4/4 rossa con travolgere fino alla fine del turno.\\nFintanto che il Totem di Foriys è una creatura, può bloccare una creatura addizionale.\', \'type\': \'Artefatto\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133243&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'cbfe342c-e00b-4cac-9254-7a5cee95720a\', \'multiverseId\': 133243}, \'multiverseid\': 133243}, {\'name\': \'フォライアスのトーテム像\', \'text\': \'{T}：あなたのマナ・プールに{R}を加える。\\n{4}{R}：ターン終了時まで、フォライアスのトーテム像はトランプルを持つ赤の４/４の巨人アーティファクト・クリーチャーになる。\\nフォライアスのトーテム像がクリーチャーであるかぎり、それはさらに１体のクリーチャーをブロックできる。\', \'type\': \'アーティファクト\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133544&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'717d9cb4-9222-43dc-9562-7f20af79eb2c\', \'multiverseId\': 133544}, \'multiverseid\': 133544}, {\'name\': \'Totem Foriysiano\', \'text\': \'{T}: Adicione {R} à sua reserva de mana.\\n{4}{R}: Totem Foriysiano torna-se uma criatura artefato vermelha 4/4 do tipo Gigante com atropelar até o final do turno.\\nEnquanto Totem Foriysiano for uma criatura, ele poderá bloquear uma criatura adicional.\', \'type\': \'Artefato\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133845&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'f28e5428-393c-46ff-bcbb-a7574b31fabf\', \'multiverseId\': 133845}, \'multiverseid\': 133845}, {\'name\': \'Форисианский Тотем\', \'text\': \'{T}: Добавьте {R} в ваше хранилище маны.\\n{4}{R}: Форисианский Тотем становится артефактным существом 4/4 красный Гигант с Пробивным Ударом до конца хода.\\nДо тех пор пока Форисианский Тотем является существом, он может блокировать дополнительное существо.\', \'type\': \'Артефакт\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134146&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'28feb025-fe28-4674-be38-49eb97cb18f6\', \'multiverseId\': 134146}, \'multiverseid\': 134146}, {\'name\': \'佛绿耶斯图腾像\', \'text\': \'{T}：加{R}到你的法术力池中。\\n{4}{R}：佛绿耶斯图腾像成为4/4红色，具践踏异能的巨人神器生物直到回合结束。\\n只要佛绿耶斯图腾像是生物，它便可以额外多阻挡一个生物。\', \'type\': \'神器\', \'flavor\': None, \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132340&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'141e83ba-3f4e-4b53-859a-a8ed786bbc1a\', \'multiverseId\': 132340}, \'multiverseid\': 132340}]', '[{\'name\': \'Furchteinflößende Rückkehr\', \'text\': \'Bringe eine Kreaturenkarte deiner Wahl aus deinem Friedhof ins Spiel zurück.\\nRückblende Opfere drei Kreaturen. (Du kannst diese Karte aus deinem Friedhof für ihre Rückblendekosten spielen. Entferne sie dann ganz aus dem Spiel.)\', \'type\': \'Hexerei\', \'flavor\': \'Wer die Schrecken der Vergangenheit vergisst, ist verdammt, ihnen eines Tages wieder zu begegnen.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132910&type=card\', \'language\': \'German\', \'identifiers\': {\'scryfallId\': \'26a1a5a6-e482-431d-802b-0cfb2a889a1e\', \'multiverseId\': 132910}, \'multiverseid\': 132910}, {\'name\': \'Regreso pavoroso\', \'text\': \'Regresa la carta de criatura objetivo de tu cementerio al juego.\\nRetrospectiva—Sacrificar tres criaturas. (Puedes jugar esta carta desde tu cementerio pagando su coste de retrospectiva. Luego remuévela del juego.)\', \'type\': \'Conjuro\', \'flavor\': \'Aquellos que olvidan los horrores del pasado están condenados a reencontrarlos.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134415&type=card\', \'language\': \'Spanish\', \'identifiers\': {\'scryfallId\': \'a05e600d-2c0d-497f-b71a-478da343681d\', \'multiverseId\': 134415}, \'multiverseid\': 134415}, {\'name\': "Retour de l\'effroi", \'text\': \'Renvoyez en jeu la carte de créature ciblée de votre cimetière.\\nFlashback — Sacrifiez trois créatures. (Vous pouvez jouer cette carte depuis votre cimetière pour son coût de flashback. Retirez-la ensuite de la partie.)\', \'type\': \'Rituel\', \'flavor\': \'Ceux qui oublient les horreurs du passé sont condamnés à les rencontrer à nouveau.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132609&type=card\', \'language\': \'French\', \'identifiers\': {\'scryfallId\': \'f516cc29-806b-4a0e-b111-167e0a1f9857\', \'multiverseId\': 132609}, \'multiverseid\': 132609}, {\'name\': \'Ritorno Terrificante\', \'text\': \'Rimetti in gioco una carta creatura bersaglio dal tuo cimitero.\\nFlashback—Sacrifica tre creature. (Puoi giocare questa carta dal tuo cimitero pagando il suo costo di flashback. Poi rimuovila dal gioco).\', \'type\': \'Stregoneria\', \'flavor\': \'Coloro che dimenticano gli orrori del passato sono condannati a rincontrarli.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133211&type=card\', \'language\': \'Italian\', \'identifiers\': {\'scryfallId\': \'802bbb59-331f-4d83-971e-67a3a18dabf5\', \'multiverseId\': 133211}, \'multiverseid\': 133211}, {\'name\': \'戦慄の復活\', \'text\': \'あなたの墓地にあるクリーチャー・カード１枚を対象とし、それを場に出す。\\nフラッシュバック ― クリーチャーを３体生け贄に捧げる。 （あなたはフラッシュバック・コストで、このカードをあなたの墓地からプレイしてもよい。 その後それをゲームから取り除く）\', \'type\': \'ソーサリー\', \'flavor\': \'過去の邪霊を忘れた者は、それと再び出会う運命にある。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133512&type=card\', \'language\': \'Japanese\', \'identifiers\': {\'scryfallId\': \'f2db40c9-5f97-43ee-9e48-52a783690fd8\', \'multiverseId\': 133512}, \'multiverseid\': 133512}, {\'name\': \'Retorno Aterrorizante\', \'text\': \'Devolva o card alvo de criatura de seu cemitério para o jogo.\\nRecapitular—Sacrifique três criaturas. (Você pode jogar este card de seu cemitério pagando seu custo de recapitulação. Depois remova-o do jogo.)\', \'type\': \'Feitiço\', \'flavor\': \'Aqueles que esquecem os horrores do passado estão fadados a reencontrá-los.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133813&type=card\', \'language\': \'Portuguese (Brazil)\', \'identifiers\': {\'scryfallId\': \'c7546200-dba0-40c1-b12d-dc18a187ce51\', \'multiverseId\': 133813}, \'multiverseid\': 133813}, {\'name\': \'Ужасный Возврат\', \'text\': \'Верните целевую карту существа из вашего кладбища в игру.\\nВоспоминание—Пожертвуйте три существа. (Вы можете играть эту карту из вашего кладбища за ее стоимость воспоминания. Затем удалите ее из игры.)\', \'type\': \'Волшебство\', \'flavor\': \'Те, кто забыл ужасы прошлого, прокляты и вновь встретятся с ними.\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134114&type=card\', \'language\': \'Russian\', \'identifiers\': {\'scryfallId\': \'3d05ce3b-f65e-4491-b8f4-723888a5f9a5\', \'multiverseId\': 134114}, \'multiverseid\': 134114}, {\'name\': \'颤栗再现\', \'text\': \'将目标生物牌从你的坟墓场移回场上。\\n返照～牺牲三个生物。 （你可以从你的坟墓场使用此牌，并支付其返照费用， 然后将它移出对战。）\', \'type\': \'法术\', \'flavor\': \'忘却过往梦魇的人，注定倒霉要再度碰上。\', \'imageUrl\': \'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132308&type=card\', \'language\': \'Chinese Simplified\', \'identifiers\': {\'scryfallId\': \'7251d44c-eeb9-4c45-b8ec-adad8adc2a2e\', \'multiverseId\': 132308}, \'multiverseid\': 132308}]', "[{'name': 'Führung des Greifen', 'text': 'Kreaturenverzauberung\\nDie verzauberte Kreatur erhält +2/+2 und Flugfähigkeit.\\nWenn die verzauberte Kreatur auf einen Friedhof gelegt wird, bringe einen 2/2 weißen Greifenspielstein mit Flugfähigkeit ins Spiel.', 'type': 'Verzauberung — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132960&type=card', 'language': 'German', 'identifiers': {'scryfallId': 'de476dd5-b677-484c-aae2-c56df2844170', 'multiverseId': 132960}, 'multiverseid': 132960}, {'name': 'Guía de grifos', 'text': 'Encantar criatura.\\nLa criatura encantada obtiene +2/+2 y tiene la habilidad de volar.\\nCuando la criatura encantada vaya a un cementerio, pon en juego una ficha de criatura Grifo blanca 2/2 con la habilidad de volar.', 'type': 'Encantamiento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134465&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': 'ff953d48-dfec-4903-bc89-c65e2cbd15f8', 'multiverseId': 134465}, 'multiverseid': 134465}, {'name': 'Guide griffon', 'text': 'Enchanter : créature\\nLa créature enchantée gagne +2/+2 et a le vol.\\nQuand la créature enchantée est mise dans un cimetière, mettez en jeu un jeton de créature 2/2 blanche Griffon avec le vol.', 'type': 'Enchantement : aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132659&type=card', 'language': 'French', 'identifiers': {'scryfallId': '6c71f28b-d413-490a-abd4-1429f6db7623', 'multiverseId': 132659}, 'multiverseid': 132659}, {'name': 'Guida dei Grifoni', 'text': 'Incanta creatura\\nLa creatura incantata prende +2/+2 e ha volare.\\nQuando la creatura incantata viene messa in un cimitero, metti in gioco una pedina creatura Grifone 2/2 bianca con volare.', 'type': 'Incantesimo — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133261&type=card', 'language': 'Italian', 'identifiers': {'scryfallId': '7689f7b7-94c9-4aec-bdab-db3f67ab3736', 'multiverseId': 133261}, 'multiverseid': 133261}, {'name': 'グリフィンの導き', 'text': 'エンチャント（クリーチャー）\\nエンチャントされているクリーチャーは、＋２/＋２の修整を受けるとともに飛行を持つ。\\nエンチャントされているクリーチャーが場からいずれかの墓地に置かれたとき、飛行を持つ白の２/２のグリフィン・クリーチャー・トークンを１体場に出す。', 'type': 'エンチャント — オーラ', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133562&type=card', 'language': 'Japanese', 'identifiers': {'scryfallId': '90ee93b0-2cb9-46c2-9303-f148a8e33659', 'multiverseId': 133562}, 'multiverseid': 133562}, {'name': 'Guia Grifo', 'text': 'Encantar Criatura\\nA criatura encantada recebe +2/+2 e tem a habilidade de voar.\\nQuando a criatura encantada for colocada num cemitério, coloque em jogo uma ficha de criatura branca 2/2 do tipo Grifo com a habilidade de voar.', 'type': 'Encantamento — Aura', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133863&type=card', 'language': 'Portuguese (Brazil)', 'identifiers': {'scryfallId': 'a65b8d88-d630-476c-a4ed-b634ad05188b', 'multiverseId': 133863}, 'multiverseid': 133863}, {'name': 'Уздцы Грифина', 'text': 'Зачаровать существо\\nЗачарованное существо получает +2/+2 и Полет.\\nКогда зачарованное существо попадает на кладбище, положите фишку существа 2/2 белый Грифин с Полетом в игру.', 'type': 'Чары — Аура', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134164&type=card', 'language': 'Russian', 'identifiers': {'scryfallId': '66e5f3b9-df59-49a1-9f2d-d735a2429639', 'multiverseId': 134164}, 'multiverseid': 134164}, {'name': '狮鹫引领', 'text': '生物结界\\n受此结界的生物得+2/+2并具有飞行异能。\\n当受此结界的生物置入坟墓场时，将一个2/2白色，具飞行异能的狮鹫衍生物放置进场。', 'type': '结界～灵气', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132358&type=card', 'language': 'Chinese Simplified', 'identifiers': {'scryfallId': '43300b47-239b-41ed-a43f-b9c763ac42b7', 'multiverseId': 132358}, 'multiverseid': 132358}]", "[{'name': 'Gebirge', 'type': 'Standardland — Gebirge', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133012&type=card', 'language': 'German', 'identifiers': {'scryfallId': '2589eae6-28b0-4aab-bf4e-dfd39bc2244f', 'multiverseId': 133012}, 'multiverseid': 133012}, {'name': 'Montaña', 'type': 'Tierra básica — Montaña', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=134517&type=card', 'language': 'Spanish', 'identifiers': {'scryfallId': '5807d778-6c81-4600-b17c-e6d830653eeb', 'multiverseId': 134517}, 'multiverseid': 134517}, {'name': 'Montagne', 'type': 'Terrain de base : montagne', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=132711&type=card', 'language': 'French', 'identifiers': {'scryfallId': '42a87c52-17e7-472b-b9b7-7aafe9f0c19e', 'multiverseId': 132711}, 'multiverseid': 132711}, {'name': 'Montagna', 'type': 'Terra Base — Montagna', 'flavor': None, 'imageUrl': 'http://gatherer.wizards.com/Handlers/Image.ashx?multiverseid=133313&type=card', 'language': 'Italian', 'identifiers': {'scryfallId'